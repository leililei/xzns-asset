function ShowAwardWithButtonView:ShowStatisticsView()
    if self.waitTimer ~= nil then
        self.waitTimer:Stop()
        self.waitTimer = nil
    end

    if not self.statisticsData or self.fightArgTable and #self.fightArgTable ~= #self.statisticsData then
        if not self.fightArgTable then
            self.statisticsData = _G.BattleManager:GetInstance():GetStatistics()
        else
            --从fightArgTable中拉取战报
            self.statisticsData = self.statisticsData or { FighterInfo = {} }
            self.winTable = self.winTable or {}
            for i = 1, #self.fightArgTable do
                if not self.statisticsData.FighterInfo[i] then
                    local record = _G.BattleManager:GetInstance():GetStatisticsRecord(self.fightArgTable[i])
                    if record and record.FighterInfo and record.FighterInfo[1] then
                        record.FighterInfo[1].TeamIndex = i
                        self.statisticsData.FighterInfo[i] = record.FighterInfo[1]
                    end
                    if record and record.result then
                        self.winTable[i] = record.result.winner and record.result.winner[1]
                    end
                end
            end
        end
    end

    local damage = _G.BattleManager:GetInstance():ParseStatistics(self.statisticsData)
    local result = {}
    if _G.table.isEmptyOrNil(self.winTable) then
        result = self.myWin and { 0 } or { 1 }
    else
        for i = 1, #self.winTable do
            _G.table.insert(result, self.winTable[i] and 0 or 1)
        end
    end
    if damage == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("战斗统计参数为空")
        end
        return
    end
    _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name,
            damage,
            result,
            function()
                if self.Toggle and self.Toggle.isOn then
                    self.waitTimer = _G.TimerManager:GetInstance():GetTimer(1, self.ShowWaitTime, self)
                    self.waitTimer:Start()

                    if _G.AppSetting.DEBUG then
                        _G.Log("<color=red>" .. "自动推图倒计时继续" .. "</color>")
                    end
                end
            end,
            nil,
            self.otherInfo,
            nil,
            self.isReport,
            self.fightArgTable,
            nil,
            self.re_uid,
            self.reportType,
            nil,
            nil,
            self.afkPage,
            nil,
            nil,
            nil,
            self.hideCombBtn,
            self.hidePetBtn
    )
end

---关卡结算完  检测升级 检测任务完成
function ShowAwardWithButtonView:ShowAwardOverCheckOther(exp)
    self:OpenBtn()
    if self.showBtn then
        if self.Toggle then
            if self.Toggle.isOn then
                if _G.AppSetting.DEBUG then
                    _G.Log("<color=red>" .. "结算完成检测自动推图开" .. "</color>")
                end
                self.waitTime = _G.ConfigManager.discrete_cfg[AutoNextTimeID][1][1]
                self.waitTimer = _G.TimerManager:GetInstance():GetTimer(1, self.ShowWaitTime, self)
                self.waitTimer:Start()

                if _G.AppSetting.DEBUG then
                    _G.Log("<color=red>" .. "结算完成自动推图倒计时开始" .. "</color>")
                end
            end
        end
    end
end

