function ShowAwardWithButtonView:CreateVEff()
    if AppSetting.IsXzns then
        self.go_table.obj_shengli_bg:SetActiveE(1)
        self.go_table.obj_shibai_bg:SetActiveE(0)
    end
    _G.DelayFrameDo(function()
        LoadEffectByCfg(
                ui_effect_cfg.ShowAwardVBG1,
                self.go_table.obj_Eff,
                function(tran)
                    if _G.AppSetting.DEBUG then
                        _G.Log("生成结算胜利特效成功")
                    end
                    if self:IsNil() then
                        _G.DestroyObject(tran)
                        return
                    end
                    self.VEff = _G.GetAutoGoTable(tran)
                    -- if self.isLv then
                    --     self.VEff.aortext_LV.text = ""
                    -- else
                    --     self.VEff.aortext_LV.text = string.format("Lv.%d", self.PlayerLv)
                    -- end
                    -- self.VEff.slider_PlayerExp.value = self:CulrExpProgress(self.PlayerLv, self.nowExp)
                    -- self.VEff.slider_PlayerExp.interactable = false
                    _G.GameUtil.SetActiveByCondition(self.VEff.obj_shenglibutton, self.showBtn)
                    --新手关特殊打开返回按钮
                    if not _G.PlayerModel:GetInstance():CheckCreateRole() then
                        _G.GameUtil.SetActiveByCondition(self.VEff.obj_shenglibutton, true)
                        self.VEff.aortext_ContinueFight.text = _G.LangUtil.GetLangPackValue(back)
                        self.VEff = _G.GetAutoGoTable(tran, _G.handlerbind(self, self.OnWinClickBtn, 1))
                    end
                    if self.autonextDisplay then
                        self.Toggle = self.VEff.toggle_autoNext:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle))
                        self.isOn = _G.PlayerPrefsManager.GetInt("AutoNextToggleData")
                        self.Toggle.isOn = self.isOn == 1 and true or false
                        self.Toggle.onValueChanged:AddListener(_G.handler(self, self.OnToggleChanged))
                    end
                    if self.back then
                        self.VEff.aortext_ContinueFight.text = _G.LangUtil.GetLangPackValue(back)
                        self.VEff = _G.GetAutoGoTable(tran, _G.handlerbind(self, self.OnWinClickBtn, 1))
