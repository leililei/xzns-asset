    self.showStatisticsBtn = result.statistics or false
    self.back = result.back or false
    self.emptyNotBack = result.emptyNotBack or false
    self.myWin = result.iSWin or false
    self.winTable = result.winTable
    self.showBtn = result.btnDisplay or false
    self.AwardData = result.AwardData or nil
    ---奖励结果排序: 0.不排序(默认值), 1.排序
    ---@type number
