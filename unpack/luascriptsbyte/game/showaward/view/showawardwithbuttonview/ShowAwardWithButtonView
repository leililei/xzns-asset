---@param tCardData CardData
function ShowAwardWithButtonView:StartLoadRoleScene(tCardData)
    if tCardData == nil then
        return
    end
    local skin = nil
    if skin == nil then
        skin = tCardData.skin
    end
    self.tempSkin = skin

    self.ShowCfg = require("CardInfoManager").GetCardSkin_ShowCfg(tCardData.skin, tCardData.sid)
    self:LoadRoleScene(
            self.ShowCfg.ModelPathHi,
            function()
                self:SetScene(false)
                local uiModel = _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.ui_model_1)
                self.go_table.obj_mvpTitle:SetActiveE(uiModel and 0 or 1)
                self.go_table.obj_mvpTitle1:SetActiveE(uiModel and 1 or 0)
            end
    )
end

function ShowAwardWithButtonView:LoadRoleScene(rolepath, callback)
    self:RoleRecycle()
    ---@type ui_params_cfg
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.ShowAwardWithButtonView, self.go_table)
    self.spawn = require("CardInfoManager").GetRole(
            rolepath,
            _G.ePoolType.UIItem,
            self.go_table.obj_mvpRoot,
            _G.RoleEffTypeEnum.RoleShow,
            function(trans)
                if trans == nil then
                    if _G.AppSetting.DEBUG then
                        _G.LogError("角色无法加载 path:" .. rolepath .. "    CardInfoself LoadRoleScene")
                    end
                    return
                end
                if _G.IsNil(self.go_table) or self.CardData == nil or rolepath ~= self.ShowCfg.ModelPathHi then
                    self.spawn:DisposeItem()
                    return
                end
                if _G.AppSetting.IsXzns then
                    local spineCfg = _G.ConfigManager.card_show_cfg[self.CardData.sid] or _G.ConfigManager.skin_cfg[self.CardData.sid]
                    local idle = spineCfg.display_idle[1]
                    _G.GameUtil.SetCardUiSpineAnimation(trans, idle, true)
                    _G.GameUtil.SetUiHeXieMask(self.go_table, 3)
                end
                self.spawn = nil
                _G.GameUtil.SetActiveByCondition(trans, false)
                self.RoleTrans = trans
                local myCard_show_cfg = _G.ConfigManager.card_show_cfg[self.CardData.skin] or
                        _G.ConfigManager.card_show_cfg[self.CardData.sid]
                if myCard_show_cfg == nil then
                    if _G.AppSetting.DEBUG then
                        _G.LogError("card_show_cfg 未找到配置 sid:" .. self.CardData.sid)
                    end
                end
                self.myCard_show_cfg = myCard_show_cfg

                local cardCfg = _G.ConfigManager.card_cfg[self.CardData.skin] or
                        _G.ConfigManager.card_cfg[self.CardData.sid]
                -- --设置  缩放
                local scale = cardCfg and cardCfg.size4 or 1
                trans:SetLocalScale(scale, scale, scale)
                self:InitRotPos()
                if callback then
                    callback(trans)
                end
            end
    )
end

function ShowAwardWithButtonView:InitRotPos(isDel)
    if _G.IsNil(self.RoleTrans) then
        return
    end

    self.EfDic = {}
    self.IsAniPlaying = false
    self.RoleTrans:SetLocalEulerAngles(0, 0, 0)
    --播放一次 初始化 RoleAnimatorController.cs--> animationTime
    if _G.AppSetting.IsXzns then
        self.RoleTrans:SetActiveE(not _G.GameUtil.IsHeXieHide() and 1 or 0)
    else
        _G.GameUtil.SetActiveByCondition(self.RoleTrans, true)
    end

    self.Timer_InitCard = _G.TimerManager:GetInstance():GetTimer(1, self.GetTimerCallBackRotPos, self, true, true)
    self.Timer_InitCard:Start()
end

function ShowAwardWithButtonView:GetTimerCallBackRotPos()
    local pos = {}
    if self.myCard_show_cfg ~= nil then
        pos = self.myCard_show_cfg.pos
    end

    local x, y, z = pos[1] or 0, pos[2] or 0, pos[3] or 0
    if self.RoleTrans ~= nil then
        self.RoleTrans:SetLocalPosition(x, y, z)
    end
    self:PlaySound(self.myCard_show_cfg.audio_enter, self.myCard_show_cfg.sound_enter)
end

function ShowAwardWithButtonView:PlaySound(audioCfg, soundPath)
    self:ClearAudio()
    self.ActionAudioArr = {}
    if self.IsAniPlaying then
        if _G.string.IsNullOrEmpty(audioCfg) == false then
            local path = audioCfg
            if path ~= nil then
                self.ActionAudioArr[path] = true
                _G.AudioManager.Dialogue_PlayPath(path)
            end
        end
        if _G.string.IsNullOrEmpty(soundPath) == false then
            local path = soundPath
            if path ~= nil then
                self.LinesPath = path
                _G.AudioManager.PlayPathBackFun(path)
            end
        end
    end
end

function ShowAwardWithButtonView:ClearAudio()
    if self.ActionAudioArr ~= nil then
        for path, value in pairs(self.ActionAudioArr) do
            _G.AudioManager.StopSoundByPath(path)
            self.ActionAudioArr[path] = nil
        end
    end
    if self.LinesPath ~= nil then
        _G.AudioManager.Dialogue_StopPath(self.LinesPath)
    end
end

function ShowAwardWithButtonView:LoadActionEff(idArr)
    if idArr == nil or #idArr == 0 then
        return
    end

    local effcfg = _G.ConfigManager.card_effect_cfg

    for i = 1, #idArr do
        local id = idArr[i]
        local myEff = effcfg[id]
        if myEff == nil then
            if _G.AppSetting.DEBUG then
                _G.LogError(" card_effect_cfg 未找到id: " .. tostring(id))
            end
        else
            self:LoadFunc(myEff, self.sceneTrans)
        end
    end
end

---@param cfg card_effect_cfg
function ShowAwardWithButtonView:LoadFunc(cfg, parent)
    if self.RoleTrans == nil then
        return
    end

    local pos = cfg.pos or { 0, 0, 0 }
    local scale = cfg.scale > 0 and cfg.scale or 1
    --region --------------------------------------当前特效 要隐藏的其他特效--------
    if #cfg.ef_false > 0 then
        for i = #cfg.ef_false, 1, -1 do
            local tranPath = cfg.ef_false[i]
            local efobj = self.RoleTrans:FindE(tranPath)
            if efobj ~= nil then
                _G.GameUtil.SetActiveByCondition(efobj, false)
            end
        end
    end
    --endregion

    --region --------------------------------------如果加载过 或者本身有这特效--------
    -- _G.UIUtils.LoadEffectByPath(
    --     cfg.Ef_Path,
    --     parent,
    --     function(tran)
    --         _G.table.insert(self.ActionEffTempArr, tran)
    --     end,
    --     nil,
    --     0,
    --     pos,
    --     scale,
    --     0,
    --     true
    -- )
    local efTran = self.EfDic[cfg.id]
    if efTran ~= nil then
        ---  特效要隐藏在显示  确保动画重播
        _G.GameUtil.SetActiveByCondition(efTran, false)
        _G.GameUtil.SetActiveByCondition(efTran, true)
    else
        if string.IsNullOrEmpty(cfg.ef_point) == false then
            if cfg.ef_point == "1" then
                parent = self.RoleTrans
            else
                parent = self.RoleTrans:FindE(cfg.ef_point)
                if parent == nil then
                    if _G.AppSetting.DEBUG then
                        _G.LogError(cfg.id .. " 挂点路径未找到: " .. cfg.ef_point)
                    end
                    return
                end
            end
        end
        --- 否则 加载
        _G.UIUtils.LoadEffectByPath(
                cfg.Ef_Path,
                parent,
                function(tran)
                    table.insert(self.ActionEffTempArr, tran)
                    self.EfDic[cfg.id] = tran
                end,
                nil,
                0,
                pos,
                scale,
                1,
                true
        )
    end
end

function ShowAwardWithButtonView:RoleRecycle()
    if self.spawn then
        self.spawn:DisposeItem()
        self.spawn = nil
    end
    if not _G.IsNil(self.RoleTrans) then
        self:InitRotPos(true)
        if self.Timer_InitCard ~= nil then
            self.Timer_InitCard:Stop()
            self.Timer_InitCard = nil
        end

        if self.RoleTrans ~= nil then
            _G.PoolsManager:GetInstance():Despawn(self.RoleTrans, _G.ePoolType.UIItem)
        end
        self.EfCardSid = 0
        self.EfDic = {}
        self.RoleTrans = nil
        self.myCard_show_cfg = nil
    end
end

