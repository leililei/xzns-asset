                        self.VEff.aortext_ContinueFight.text = _G.LangUtil.GetLangPackValue(nextChapter)
                        self.VEff = _G.GetAutoGoTable(tran, _G.handlerbind(self, self.OnWinClickBtn, 2))
                    else
                        self.VEff = _G.GetAutoGoTable(tran, _G.handlerbind(self, self.OnWinClickBtn, 3))
                        if self.autonextDisplay and self.showTwoBtn then
                            self.VEff.aorbtn_sure:SetActiveE(1)
                        end
                    end
                    --加载role模型
                    self:StartLoadRoleScene(self.CardData)
                    --加载奖励信息
                    self:LoadAwardView()
                    self:ShowAward()
                    if self.onEffectViewOpenCall then
                        self.onEffectViewOpenCall(true)
                    end
                end)
    end
    )
    if AppSetting.IsXzns == false then
        LoadEffectByCfg(
                ui_effect_cfg.ShowAwardVBGShengLI,
                self.go_table.obj_Eff
        )
        LoadEffectByCfg(
                ui_effect_cfg.ShowAwardVBGLight,
