--自动推图倒计时
function ShowAwardWithButtonView:ShowWaitTime(elapsed)
    if _G.AppSetting.DEBUG then
        _G.Log(self.waitTime, "<color=red>" .. "开始推图倒计时" .. "</color>")
    end
    self.VEff.aortext_autoNext.text = string.format(_G.GetLangPackValue(AutoNextText), _G.Mathf.RoundToInt(self.waitTime))
    self.waitTime = self.waitTime - elapsed
    if self.waitTime < 0 then
        if _G.AppSetting.DEBUG then
            _G.Log("<color=red>" .. "开始推图" .. "</color>")
        end
        self:CloseCall(SettlementModel.FunctionEnum.Next)

        if _G.AppSetting.DEBUG then
            _G.Log("<color=red>" .. "推图成功" .. "</color>")
        end
    end
end

--自动推图toggle监听
function ShowAwardWithButtonView:OnToggleChanged(isOn)
    local time = _G.ConfigManager.discrete_cfg[AutoNextTimeID][1][1]
    if self.Toggle.isOn then
        if _G.AppSetting.DEBUG then
            _G.Log("<color=red>" .. "自动推图开" .. "</color>")
        end
        self.waitTime = time
        self.waitTimer = _G.TimerManager:GetInstance():GetTimer(1, self.ShowWaitTime, self)
        self.waitTimer:Start()
        _G.PlayerPrefsManager.SetInt("AutoNextToggleData", 1)
    else
        if self.waitTimer ~= nil then
            self.waitTimer:Stop()
            self.waitTimer = nil

            if _G.AppSetting.DEBUG then
                _G.Log("<color=red>" .. "自动推图关" .. "</color>")
            end
        end
        self.waitTime = time
        self.VEff.aortext_autoNext.text = _G.GetLangPackValue(TapAutoNextText)
        _G.PlayerPrefsManager.SetInt("AutoNextToggleData", 0)
    end
end

