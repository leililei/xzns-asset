---解析结算奖励
function ShowAwardWithButtonView:SetAwardCount()
    local count = 0
    local count1 = 0
    if self.AwardData and not _G.table.isEmptyOrNil(self.AwardData) then
        count = _G.table.count(self.AwardData)
    end
    if self.ExtraAward and not _G.table.isEmptyOrNil(self.ExtraAward) then
        count1 = _G.table.count(self.ExtraAward)
    end
    self.awardCount = count + count1
end

function ShowAwardWithButtonView:SortAttacker()
    if self.myWin then
        if self.Attacker ~= nil then
            _G.SortList(
                    self.Attacker,
                    function(a)
                        return a.DmgOut
                    end
            )
        end
    else
        if self.Attacker ~= nil then
            _G.SortList(
                    self.Attacker,
                    function(a)
                        return a.HpRecover, a.DmgIn
                    end
            )
        end
    end
    if self.Attacker then
        for _, cardData in ipairs(self.Attacker) do
            if not isBeastCard(cardData.Sid) then
                return cardData
            end
        end
        --return self.Attacker[1]
    end
    return nil
end

function ShowAwardWithButtonView:SortDefender()
    if self.myWin then
