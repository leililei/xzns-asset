---失败界面按钮点击
function ShowAwardWithButtonView:OnFailClickBtn(go)
    if go == self.VEff.aorbtn_yangchengicon then
        --角色养成
        self:CloseCall(SettlementModel.FunctionEnum.DevelopRole)
        TrackingPointModel:GetInstance():CloseActTrackingByLast()
        _G.Events:GetInstance():Broadcast(_G.eSettlementFail.DevelopRole)
    elseif go == self.VEff.aorbtn_Equipicon then
        --装备强化
        self:CloseCall(SettlementModel.FunctionEnum.DevelopEquip)
        TrackingPointModel:GetInstance():CloseActTrackingByLast()
        _G.Events:GetInstance():Broadcast(_G.eSettlementFail.DevelopEquip)
    elseif go == self.VEff.aorbtn_genghuanicon or go == self.VEff.aorbtn_FightAgain then
        --更换阵容
        self:CloseCall(SettlementModel.FunctionEnum.ReEmbattle)
        _G.Events:GetInstance():Broadcast(_G.eSettlementFail.ReEmbattle)
    elseif go == self.VEff.aorbtn_shibaitotal then
        self:ShowStatisticsView()
    elseif go == self.VEff.aorbtn_return then
        self:CloseCall(SettlementModel.FunctionEnum.Back)
    end
end

