function ShowAwardWithButtonView:OnWinClickBtn(go, ison, index)
    if go == self.VEff.aorbtn_ContinueFight then
        if index == 3 then
            self:CloseCall(SettlementModel.FunctionEnum.Next)
        elseif index == 1 then
            self:CloseCall(SettlementModel.FunctionEnum.Back)
        elseif index == 2 then
            self:ClickNextChapter()
        end
    elseif go == self.VEff.aorbtn_shenglitotal then
        self:ShowStatisticsView()
        _G.Events:GetInstance():Broadcast(_G.eHellGuardShowAwardEvents.ShowTotalView)
    elseif go == self.VEff.aorbtn_sure then
        self:CloseCall(SettlementModel.FunctionEnum.None)
    end
end

