    self.isCloseCall = true
end

function ShowAwardWithButtonView:GetMvp(statisticsData, statisticsIndex, mvpData)
    ---@type Card CardData
    local Card = _G.CardData.New()
    if mvpData then
        Card:Parse(mvpData)
        self.CardData = Card
        self.showStatisticsBtn = false
        return
    end
    --默认一个sid保证一定会有模型生成
    --ZHJH-6671【战斗】战斗完后结算界面卡死且报错: 原本默认的card_cfg配置已被删除
    Card:Parse({ sid = 111070000, uid = 111070000 })
    self.CardData = Card
    if not _G.PlayerModel:GetInstance():CheckCreateRole() then
        return
    end

    --没传战报数据
    local hasFightArgs = self.fightArgTable and #self.fightArgTable > 0
    if not self.statisticsData then
        if _G.BattleManager:GetInstance():HasStatisticsCached() then
            self.statisticsData = _G.BattleManager:GetInstance():GetStatistics() --直接返回缓存数据
        elseif not hasFightArgs then
            self.statisticsData = _G.BattleManager:GetInstance():GetStatistics() --走C#打一遍纯逻辑战斗
            if _G.AppSetting.DEBUG then
                _G.LogError("没有战报数据和统计数据, 默认执行C#战斗统计")
            end
        end
    end

    if self.mvpCardSid then
        Card:Parse({ sid = self.mvpCardSid, uid = self.mvpCardSid })
        self.CardData = Card
    elseif self.statisticsData then
        --通过统计数据获取mvp
        local lastTeamIndex = #self.statisticsData.FighterInfo
        if self.statisticsData.FighterInfo[lastTeamIndex].Attacker ~= nil then
            self.Attacker = self.statisticsData.FighterInfo[lastTeamIndex].Attacker
        end
        if self.statisticsData.FighterInfo[lastTeamIndex].Defender ~= nil then
            self.Defender = self.statisticsData.FighterInfo[lastTeamIndex].Defender
        end
        local cardData
        if self.defender == 1 then
            cardData = self:SortAttacker()
        else
            cardData = self:SortDefender()
        end
        if cardData then
            if string.len(tostring(cardData.Uid)) < 12 then
                if card_cfg[cardData.Sid] then
                    Card:Parse({ sid = cardData.Sid, uid = cardData.Uid })
                elseif monster_cfg[cardData.Sid] then
                    Card:Parse({ sid = monster_cfg[cardData.Sid].CardID, uid = cardData.Uid })
                end
                self.CardData = Card
            else
                self.CardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, cardData.Uid)
                --判断是不是空，如果是空 （去千机黑煞 卡牌库，拿数据）
                if self.CardData == nil then
                    Card:Parse({ sid = cardData.Sid, uid = cardData.Uid })
                    self.CardData = Card
                end
            end
        else
            self.showStatisticsBtn = false
            if _G.AppSetting.DEBUG then
                _G.LogError("没有进攻方数据")
            end
        end
    elseif hasFightArgs then
        --通过战报数据获取mvp
        ---@type fight.i_fight_arg
        local fightArg = self.fightArgTable[#self.fightArgTable]
        ---@type fight.i_fight_team[]
        local teamData = self.defender == 1 and fightArg.attacker_team or fightArg.defender_team
        if teamData and #teamData > 0 then
            ---@type fight.i_fight_fighter,number
            local cardArg, cardPower = nil, 0
            --计算卡牌属性战力
            ---@type AttributeClass
            local pc = _G.AttributeClass.New()
            pc:OnInit(nil, nil)
            for _, fight in pairs(teamData[1].fights) do
                if not isBeastCard(fight.sid) then
                    pc.attribute = fight.attrs
                    local power = pc:CalculatePower()
