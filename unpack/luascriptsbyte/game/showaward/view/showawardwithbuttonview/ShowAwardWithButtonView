    self.defender = defender or 1
    self.statisticsData = not _G.table.isEmptyOrNil(statisticsData) and statisticsData or nil

    if _G.AppSetting.DEBUG then
        _G.Log(result.AwardData, "result.AwardDataresult.AwardDataresult.AwardData")
    end
    self.otherInfo = result.otherInfo or nil
    self.itemTable = {}
    self.AllItemGoTable = {}
    self.waitTime = nil --自动推图等待时间
    self.addExp = 0
    self.nowExp = 0
    self.isUp = nil
    self.CardData = nil
    self.afktips = result.afktips or nil
    self.task = result.task or nil
    self.hideCombBtn = result.hideCombBtn
    self.hidePetBtn = result.hidePetBtn
    self.mvpCardSid = result.MvpCardSid
    self.hidePlayerInfo = result.hidePlayerInfo
    self.fightArgTable = curFightArgTable
    if AppSetting.IsXzns then
        if not self.myWin then
            self.showBtn = true
        end
        if result.forceHideBtn then
            self.forceHideBtn = result.forceHideBtn
        end
        self.hidePlayerInfo = true
    end
    self:SetAwardCount()
    self:GetMvp(statisticsData, statisticsIndex, mvpData)
    self:Init()
    self.go_table.obj_tips:SetActiveE(not self.emptyNotBack and 1 or 0)
    if self.emptyNotBack then
