---是否为圣兽
---@param sid number id
---@return boolean 是否为圣兽
local function isBeastCard(sid)
    local cfg = card_cfg[sid]
    if not cfg then
        local monsterCfg = monster_cfg[sid]
        if monsterCfg then
            cfg = card_cfg[monsterCfg.CardID]
        end
    end
    if cfg and cfg.UnitType == _G.HeroType.Beast then
        return true
    end
    return false
end

