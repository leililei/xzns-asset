---@class TestRebateView : UIBaseView	中文描述
---@field public go_table TestRebateView_GoTable GoTable
local TestRebateView = _G.BaseClass("TestRebateView", _G.UIBaseView)

function TestRebateView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function TestRebateView:OnCreate()
end

---界面的销毁函数
function TestRebateView:OnDestroy()
end

---按钮点击事件在这里派发
function TestRebateView:OnClickBtn(go)
    if go == self.go_table.aorbtn_go then
        _G.JumpManager:GetInstance():Jump(108001)
    elseif go == self.go_table.aorbtn_tan1 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 64)
    end
end

function TestRebateView:CloseView()
    self:Close()
end

return TestRebateView