function SpiritualDrawGiftPackView:OnClick_item(itemGoTable, isOn, data)
    if data.type_price == 1 then
        require("MallManager"):GetInstance():BuyActiveGift(data.price_id, nil, data.id)
        self.buyData = data
    elseif data.type_price == 2 then
        if data.price_id ~= 0 then
            -- 检测非免费礼包货币是否满足
            local ownNum = _G.StorageManager:GetInstance():GetItemCountBySid(_G.ResPropID.Diamond)
            local needNum = data.price_id
            if ownNum < needNum then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ResPropID.Diamond)
                return
            end
        end

        require("MallNet"):GetInstance():BuyItem(data.id, 1, function(msg)
            if msg.ack ~= 1 then
                return
            end
            -- 获取奖励
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            _G.StorageManager:GetInstance():ConsumeItem(_G.ResPropID.Diamond, 0, data.price_id)
            -- 更新礼包状态
            local count = MallManager:GetInstance():GetItemBuyTimes(data.id, data.type_reset)
            MallManager:GetInstance():SetItemBuyTimes(data.id, data.type_reset, count + 1)

            self:UpdateView(true)
            -- 刷新礼包红点
            if self.subType == _G.ActivitySubType.Spiritual then
                require("RedPointManager"):GetInstance():RefreshNode(
                    _G.ConfigManager.redpoint_cfg.SpiritualDrawGiftPack.id)
            elseif self.subType == _G.ActivitySubType.Pet then
                require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.PetDrawGift.id)
            elseif self.subType == _G.ActivitySubType.SpoilsGift then
                require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SpoilsGift.id)
            elseif self.subType == _G.ActivitySubType.Build then
                require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.DrawBuildGiftPack.id)
            elseif _G.AppSetting.IsXzns and self.subType == _G.ActivitySubType.Beast then
                require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BeastDrawGift.id)
            end
            -- 刷新抽奖次数
            if self.call then
                self.call()
            end
        end)
    end
end

function SpiritualDrawGiftPackView:OnClickBtn(go, isOn, viewName)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_close" then
        self:CloseView()
    elseif name == "@_aorbtn_guanbi" then
        self:CloseView()
    end
end

---@param cashMsg cash.i_cash_memory
---@param reconnect boolean 是否断线重连后请求
function SpiritualDrawGiftPackView:OnMallCashListener(cashMsg, reconnect)
    if not cashMsg or cashMsg.sid ~= self.buyData.id then
        return
    end
    if not reconnect then
        -- 更新礼包状态
        local count = MallManager:GetInstance():GetItemBuyTimes(self.buyData.id, self.buyData.type_reset)
        MallManager:GetInstance():SetItemBuyTimes(self.buyData.id, self.buyData.type_reset, count + 1)
    end
    self:UpdateView(true)
    -- 刷新抽奖次数
    if self.call then
        self.call()
    end
end

---函数功能注释
function SpiritualDrawGiftPackView:SortGiftData(call)
    _G.SortList(self.infocfgsDown, function(data)
        local buyCount = MallManager:GetInstance():GetItemBuyTimes(data.id, data.type_reset) or 0
        local state = buyCount >= data.count_limit and 0 or 1
        return state, -data.id
    end)
    if call then
        call()
    end
end

function SpiritualDrawGiftPackView:EscClose()
    self:CloseView()
end

function SpiritualDrawGiftPackView:CloseView()
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DrawGiftPackToggleView.Name)
    self:Close()
end

function SpiritualDrawGiftPackView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    self:CloseView()
end

return SpiritualDrawGiftPackView
