---@class SpiritualDrawGiftPackView : UIBaseView	中文描述
local SpiritualDrawGiftPackView = _G.BaseClass("SpiritualDrawGiftPackView", _G.UIBaseView)
local MallManager = require("MallManager")

function SpiritualDrawGiftPackView:Awake()
    if _G.AppSetting.IsXzns then
        textPos[_G.ActivitySubType.Beast] = {-112, 408}
        imagePos[_G.ActivitySubType.Beast] = {0, 268}
        imageNameT[_G.ActivitySubType.Beast] = {"ui_swck_hqms_js", "ui_swck_hqms_txt"}
        _G.GameUtil.SetUiHeXieMask(self.go_table)
    end
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

function SpiritualDrawGiftPackView:OnCreate(call, subType)
    if call == "" then
        call = nil
    end
    self.call = call
    self.subType = tonumber(subType)

    self.go_table.aortext_time.text = _G.GetLangPackValue(90000011174)
    self:UpdateView()

    -- 刷新礼包红点
    if self.subType == _G.ActivitySubType.Spiritual then
        -- 红点
        _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "SpiritualGiftLastRefreshTime",
            _G.TimeUtil.GetServerUnixTime())
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SpiritualDrawGiftPack.id)
    elseif self.subType == _G.ActivitySubType.Pet then
        _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "PetGiftLastRefreshTime",
            _G.TimeUtil.GetServerUnixTime())
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.PetDrawGift.id)
    elseif self.subType == _G.ActivitySubType.SpoilsGift then
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SpoilsGift.id)
    elseif self.subType == _G.ActivitySubType.Build then
        _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "BuildGiftLastRefreshTime",
            _G.TimeUtil.GetServerUnixTime())
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.DrawBuildGiftPack.id)
    elseif _G.AppSetting.IsXzns and self.subType == _G.ActivitySubType.Beast then
        _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "BeastGiftLastRefreshTime",
            _G.TimeUtil.GetServerUnixTime())
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BeastDrawGift.id)
    end
end

function SpiritualDrawGiftPackView:UpdateView(updateFlag)
    if self.subType == _G.ActivitySubType.Spiritual then
        self.infocfgs = _G.ConfigManager.discrete_cfg[114009][1]
    elseif self.subType == _G.ActivitySubType.Pet then
        self.infocfgs = _G.ConfigManager.discrete_cfg[114410][1]
    elseif self.subType == _G.ActivitySubType.Build then
        self.infocfgs = _G.ConfigManager.discrete_cfg[126608][1]
    elseif self.subType == _G.ActivitySubType.SpoilsGift then
        self.infocfgs = _G.ConfigManager.discrete_cfg[126614][1]
    elseif _G.AppSetting.IsXzns and self.subType == _G.ActivitySubType.Beast then
        self.infocfgs = _G.ConfigManager.discrete_cfg[200210][1]
    end
    for i = 1, 2 do
        self.go_table["aorrawimage_" .. i]:LoadImage("ImagesH5/hSpiritualDraw/" .. imageNameT[self.subType][i],
            function(tran)
                tran:SetNativeSize()
            end)
    end
    self.go_table.aorrawimage_1:SetLocalPosition(imagePos[self.subType][1], imagePos[self.subType][2], 0)
    self.go_table.aorrawimage_2:SetLocalPosition(textPos[self.subType][1], textPos[self.subType][2], 0)

    -- 策划说第一个礼包有特殊框体
    self.infocfgsTop = {self.infocfgs[1]}
    self.infocfgsDown = {}

    local FisrtItemCfg = store_extra_cfg[self.infocfgs[1]]
    local FisrtBuyCount = MallManager:GetInstance():GetItemBuyTimes(FisrtItemCfg.id, FisrtItemCfg.type_reset)
    if FisrtItemCfg.count_limit - FisrtBuyCount == 0 then
        for i = 1, #self.infocfgs do
            _G.table.insert(self.infocfgsDown, store_extra_cfg[self.infocfgs[i]])
        end
    else
        for i = 2, #self.infocfgs do
            _G.table.insert(self.infocfgsDown, store_extra_cfg[self.infocfgs[i]])
        end
    end

    local topHeight, itemHeight
    if FisrtBuyCount == FisrtItemCfg.count_limit then
        topHeight = 0
        itemHeight = 712
    else
        topHeight = 194
        itemHeight = 520
    end

    self:SortGiftData(function()
        if FisrtBuyCount ~= self.FisrtBuyCount then
            self.go_table.scrollloopvectical_top:UpdateScrollRectHeight(topHeight)
            self.go_table.scrollloopvectical_item:UpdateScrollRectHeight(itemHeight)
            self.FisrtBuyCount = FisrtBuyCount
        end
    end)

    if updateFlag then
        if #self.infocfgsDown ~= self.infoCount then
            self.go_table.scrollloopvectical_item:UpdateCount(#self.infocfgsDown)
        else
            self.go_table.scrollloopvectical_item:UpdateAllItem()
        end
        self.go_table.scrollloopvectical_top:UpdateAllItem()
    else
        self.go_table.scrollloopvectical_top:InitItemData(#self.infocfgsTop, _G.handler(self, self.RefreshListTop))
        self.go_table.scrollloopvectical_item:InitItemData(#self.infocfgsDown, _G.handler(self, self.RefreshList))
    end
    self.infoCount = #self.infocfgsDown
end

function SpiritualDrawGiftPackView:RefreshList(index, objGame)
    if index < 0 then
        return
    end
    local data = self.infocfgsDown[index + 1]
    local itemGoTable = _G.GetAutoGoTable(objGame, _G.handlerbind(self, self.OnClick_item, data))

    itemGoTable.obj_special:SetActiveE(0)

    local node = itemGoTable.obj_Root
    if node:GetChildCountE() > 0 then
        for i = 1, node:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(node:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    for i = 1, #data.goods do
        local award = data.goods[i]
        _G.StorageManager:GetInstance():GetItemBaseViewNew(award, node, function(item)
            item.gameObject:SetLocalScale(0.8, 0.8, 0.8)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            local cfg = item.cfg or item.data.cfg
            item:ShowEffectOrder(cfg.ef_item == 1 and true or false)
            if item.SetGradeNew then
                item:SetGradeNew(false)
            end
        end, function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, award[1])
        end)
    end

    ---@type number 付费礼包存储在Model中, 免费礼包存储在MallManager中, 需要单独处理
    local buyCount

    buyCount = MallManager:GetInstance():GetItemBuyTimes(data.id, data.type_reset)

    itemGoTable.aortext_name.text = _G.GetLangPackValue(data.name)
    local restCount = data.count_limit - buyCount
    itemGoTable.aortext_limit.text = _G.GetLangPackValue(utils.getLanguageId(data.type_reset, restCount <= 0),
        restCount, data.count_limit)

    _G.GameUtil.AddDouYinIcon(itemGoTable.aorbtn_btnBuy, true, itemGoTable.aortext_price)

    local finalPrice = require "MallManager":GetInstance():GetFinalPrice(data.price_id)

    if restCount <= 0 then
        itemGoTable.obj_sellOut:SetActiveE(1)
        itemGoTable.aorbtn_btnBuy:SetActiveE(0)
        itemGoTable.obj_free:SetActiveE(0)
        itemGoTable.obj_price:SetActiveE(0)
        itemGoTable.aortext_rmb:SetActiveE(0)
        itemGoTable.aorbtn_btnBuy:SetGray(true)
        itemGoTable.aorbtn_btnBuy.enabled = false
    else
        itemGoTable.obj_sellOut:SetActiveE(0)
        itemGoTable.aorbtn_btnBuy:SetActiveE(1)
        itemGoTable.obj_free:SetActiveE(finalPrice <= 0 and 1 or 0)
        itemGoTable.aorbtn_btnBuy:SetGray(false)
        itemGoTable.aorbtn_btnBuy.enabled = true
        itemGoTable.aortext_rmb:SetActiveE(data.type_price == 1 and 1 or 0)
        itemGoTable.obj_price:SetActiveE(data.type_price == 1 and 0 or 1)
        if data.type_price == 1 then
            _G.GameUtil.SetPriceByChannel(data.price_id, itemGoTable.aortext_rmb)
        elseif finalPrice > 0 then
            itemGoTable.aorrawimage_price:SetActiveE(1)
            itemGoTable.aorrawimage_price:LoadImage(_G.ConfigManager.currency_type_cfg[_G.ResPropID.Diamond].icon)
            itemGoTable.aortext_price.text = tostring(finalPrice)
        else
            itemGoTable.aorrawimage_price:SetActiveE(0)
            itemGoTable.aortext_price.text = _G.GetLangPackValue(90030800004)
        end

        itemGoTable.aorimage_discount:SetActiveE(data.original_id ~= 0 and 1 or 0)
        if data.original_id ~= 0 then
            local finalPriceOr = require "MallManager":GetInstance():GetFinalPrice(data.original_id)
            itemGoTable.aortext_discount.text = _G.GetLangPackValue(90028800006, string.format("%.1f", (finalPrice /
                finalPriceOr) * 10))
        end
    end
end

