function SpiritualFestivalGiftView:OnClick_item(itemGoTable, isOn, data)
    if data.price > 0 then
        require("MallManager"):GetInstance():BuyActiveGift(data.price, self.curActivityClass.activityID, data.sid)
        self.buyData = data
    else
        require "ActivitySynNet":GetInstance():GetAward(
            self.curActivityClass.activityID,
            { data.sid },
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                --获取奖励
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                _G.StorageManager:GetInstance():ConsumeItem(_G.ResPropID.Diamond, 0, data.price)
                --更新礼包状态
                local count = self.cashTimes[data.sid]
                self.cashTimes[data.sid] = count + 1
                --MallManager:GetInstance():SetItemBuyTimes(data.sid, data.type_reset, count + 1)
                self.typeClass.freeTimes = self.typeClass.freeTimes + 1
                self.typeClass:AddBuyTimes(data.sid)

                self:UpdateView(true)

                self.typeClass:RefreshRedPoint()
                self.typeClass:CheckClose()
            end
        )
    end
end

function SpiritualFestivalGiftView:OnClickBtn(go, isOn, viewName)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_close" then
        self:CloseView()
    elseif name == "@_aorbtn_guanbi" then
        self:CloseView()
    end
end

---@param cashMsg cash.i_cash_memory
---@param reconnect boolean 是否断线重连后请求
function SpiritualFestivalGiftView:OnMallCashListener(cashMsg, reconnect)
    if not cashMsg or cashMsg.sid ~= self.buyData.sid then
        return
    end
    if not reconnect then
        --更新礼包状态
        -- local count = MallManager:GetInstance():GetItemBuyTimes(self.buyData.id, self.buyData.type_reset)
        -- MallManager:GetInstance():SetItemBuyTimes(self.buyData.id, self.buyData.type_reset, count + 1)

        local count = self.cashTimes[self.buyData.sid]
        self.cashTimes[self.buyData.sid] = count + 1
        self.typeClass:AddBuyTimes(self.buyData.sid)
    end
    self:UpdateView(true)

    self.typeClass:RefreshRedPoint()
    self.typeClass:CheckClose()
end

---函数功能注释
function SpiritualFestivalGiftView:SortGiftData(call)
    _G.SortList(
        self.infocfgsDown,
        function(data)
            local buyCount = self.cashTimes[data.sid] or 0
            local state = buyCount >= data.count and 0 or 1
            return state, -data.sid
        end
    )
    if call then
        call()
    end
end

function SpiritualFestivalGiftView:TimeCutDown()
    self.Times = self.typeClass:GetActivityEndTime() - _G.TimeUtil.GetServerUnixTime()
    self.go_table.aortext_time.text = _G.GetLangPackValue(90000013002, _G.TimeUtil.TranslateSecondForDHMOrHMS(self.Times))
    self:Stop_CloseTimer()
    self.Timers = _G.TimerManager:GetInstance():GetTimer(1, self.ShowTime, self, false, false, true)
    self.Timers:Start()
end

function SpiritualFestivalGiftView:ShowTime(elapsed)
    self.Times = self.Times - elapsed
    self.go_table.aortext_time.text = _G.GetLangPackValue(90000013002, _G.TimeUtil.TranslateSecondForDHMOrHMS(self.Times))
    if self.Times <= 0 then
        self:CloseView()
    end
end

function SpiritualFestivalGiftView:Stop_CloseTimer()
    if self.Timers ~= nil then
        self.Timers:Stop()
        self.Timers = nil
    end
end

function SpiritualFestivalGiftView:EscClose()
    self:CloseView()
end

function SpiritualFestivalGiftView:CloseView()
    self:Stop_CloseTimer()
    self:Close()
end

function SpiritualFestivalGiftView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    self:CloseView()
end

return SpiritualFestivalGiftView
