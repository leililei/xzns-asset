---@class SpiritualFestivalGiftView : UIBaseView    中文描述
local SpiritualFestivalGiftView = _G.BaseClass("SpiritualFestivalGiftView", _G.UIBaseView)
local MallManager = require("MallManager")

function SpiritualFestivalGiftView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

function SpiritualFestivalGiftView:OnCreate(curClass)
    self.curActivityClass = curClass
    self.typeClass = curClass.typeClass
    --self.freeGiftData = self.typeClass.freeGiftData
    self.cashGiftData = self.typeClass.cashGiftData
    --self.freeTimes = self.typeClass.freeTimes
    self.cashTimes = self.typeClass.cashTimes

    self.go_table.aortext_time.text = _G.GetLangPackValue(90000011174)
    self:UpdateView()

    self:TimeCutDown()

    --刷新礼包红点
    _G.PlayerPrefsManager.SetInt(
        tostring(_G.PlayerModel:GetInstance().role_uid) .. "SpiritualGiftLastRefreshTime",
        _G.TimeUtil.GetServerUnixTime()
    )
    require("RedPointManager"):GetInstance():RefreshNode(
        _G.ConfigManager.redpoint_cfg.SpiritualDrawGiftPack.id
    )
end

function SpiritualFestivalGiftView:UpdateView(updateFlag)
    local tempcgd = table.toArray(self.cashGiftData)
    _G.SortList(tempcgd, function(item)
        return -item.sindex
    end)
    --策划说第一个礼包有特殊框体
    self.infocfgsTop = { tempcgd[1] }
    self.infocfgsDown = {}

    local FisrtItemCfg = tempcgd[1]
    local FisrtBuyCount = self.cashTimes[FisrtItemCfg.sid]
    if FisrtItemCfg.count - FisrtBuyCount == 0 then
        for i = 1, #tempcgd do
            _G.table.insert(self.infocfgsDown, tempcgd[i])
        end
    else
        for i = 2, #tempcgd do
            _G.table.insert(self.infocfgsDown, tempcgd[i])
        end
    end

    local topHeight, itemHeight
    if FisrtBuyCount == FisrtItemCfg.count then
        topHeight = 0
        itemHeight = 737
    else
        topHeight = 194
        itemHeight = 555.5
    end

    self:SortGiftData(function()
        if FisrtBuyCount ~= self.FisrtBuyCount then
            self.go_table.scrollloopvectical_top:UpdateScrollRectHeight(topHeight)
            self.go_table.scrollloopvectical_item:UpdateScrollRectHeight(itemHeight)
            self.FisrtBuyCount = FisrtBuyCount
        end
    end)

    if updateFlag then
        if #self.infocfgsDown ~= self.infoCount then
            self.go_table.scrollloopvectical_item:UpdateCount(#self.infocfgsDown)
        else
            self.go_table.scrollloopvectical_item:UpdateAllItem()
        end
        self.go_table.scrollloopvectical_top:UpdateAllItem()
    else
        self.go_table.scrollloopvectical_top:InitItemData(#self.infocfgsTop, _G.handler(self, self.RefreshListTop))
        self.go_table.scrollloopvectical_item:InitItemData(#self.infocfgsDown, _G.handler(self, self.RefreshList))
    end
    self.infoCount = #self.infocfgsDown
end

function SpiritualFestivalGiftView:RefreshList(index, objGame)
    if index < 0 then
        return
    end
    local data = self.infocfgsDown[index + 1]
    local itemGoTable = _G.GetAutoGoTable(objGame, _G.handlerbind(self, self.OnClick_item, data))

    itemGoTable.obj_special:SetActiveE(0)

    local node = itemGoTable.obj_Root
    if node:GetChildCountE() > 0 then
        for i = 1, node:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(node:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    for i = 1, #data.award do
        local award = data.award[i].type
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            award,
            node,
            function(item)
                item.gameObject:SetLocalScale(0.8, 0.8, 0.8)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                local cfg = item.cfg or item.data.cfg
                item:ShowEffectOrder(cfg.ef_item == 1 and true or false)
                if item.SetGradeNew then
                    item:SetGradeNew(false)
                end
            end,
            function(go, isOn)
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, award[1])
            end
        )
    end

    ---@type number 付费礼包存储在Model中, 免费礼包存储在MallManager中, 需要单独处理
    local buyCount

    buyCount = self.cashTimes[data.sid]

    itemGoTable.aortext_name.text = _G.GetLangPackValue(data.name)
    local restCount = data.count - buyCount
    --itemGoTable.aortext_limit.text =
    --_G.GetLangPackValue(90021600007, restCount, data.count)
    itemGoTable.aortext_limit.text = _G.GetLangPackValue(90000001107, restCount)

    local finalPrice = require "MallManager":GetInstance():GetFinalPrice(data.price)
    _G.GameUtil.AddDouYinIcon(itemGoTable.aorbtn_btnBuy, true, itemGoTable.aortext_price, nil, nil, finalPrice)

    if restCount <= 0 then
        itemGoTable.obj_sellOut:SetActiveE(1)
        itemGoTable.aorbtn_btnBuy:SetActiveE(0)
        itemGoTable.obj_free:SetActiveE(0)
        itemGoTable.obj_price:SetActiveE(0)
        itemGoTable.aortext_rmb:SetActiveE(0)
        itemGoTable.aorbtn_btnBuy:SetGray(true)
        itemGoTable.aorbtn_btnBuy.enabled = false
        itemGoTable.aortext_limit.text = ""
    else
        itemGoTable.obj_sellOut:SetActiveE(0)
        itemGoTable.aorbtn_btnBuy:SetActiveE(1)
        itemGoTable.obj_free:SetActiveE(finalPrice <= 0 and 1 or 0)
        itemGoTable.aorbtn_btnBuy:SetGray(false)
        itemGoTable.aorbtn_btnBuy.enabled = true
        itemGoTable.aortext_rmb:SetActiveE(1) --data.type_price == 1 and 1 or 0)
        itemGoTable.obj_price:SetActiveE(0)   --data.type_price == 1 and 0 or 1)
        if finalPrice > 0 then
            _G.GameUtil.SetPriceByChannel(data.price, itemGoTable.aortext_rmb)
        else
            itemGoTable.obj_price:SetActiveE(1)
            itemGoTable.aorrawimage_price:SetActiveE(0)
            itemGoTable.aortext_price.text = _G.GetLangPackValue(90030800004)
        end

        -- itemGoTable.aorimage_discount:SetActiveE(data.original_id ~= 0 and 1 or 0)
        -- if data.original_id ~= 0 then
        --     local finalPriceOr = require "MallManager":GetInstance():GetFinalPrice(data.original_id)
        --     itemGoTable.aortext_discount.text = _G.GetLangPackValue(90028800006,
        --         string.format("%.1f", (finalPrice / finalPriceOr) * 10))
        -- end
    end
end

