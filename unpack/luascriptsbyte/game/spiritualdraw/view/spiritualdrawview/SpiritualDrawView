    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_awards, bol)
    if bol then
        self:UpdateDrawGiftTip()
    end

    --local b = data[1].typeClass:CheckRedPointNum(id)
end

---更新累抽任务tip窗口
---@return void
function SpiritualDrawView:UpdateDrawGiftTip()
    local data = require "ActivitySynManager":GetInstance():GetChildAcitivity(10007, subType)
    if not data or not self.go_table then
        return
    end
    --是否有可领取的豪礼
    local hasAward = #data.typeClass:GetCankTaskList() > 0
    if hasAward then
        self.go_table.aorbtn_afkGiftTip:SetActiveE(1)
        self.go_table.aortext_afkGiftTip.text = _G.GetLangPackValue(90000001250) --当前可领奖
        self.afkGiftTick = nil
        if self.afkGiftTimer then
            self.afkGiftTimer:Stop()
            self.afkGiftTimer = nil
        end
        return
    end

    local intervalCfg = _G.ConfigManager.discrete_cfg[120011]
    local interval = intervalCfg[1][1] or 5 --默认间隔5秒, 0常驻显示, -1不显示
    local isShowTip = false
    if interval > 0 then
        --创建定时器
        if not self.afkGiftTimer then
            self.afkGiftTimer = _G.TimerManager:GetInstance():GetTimer(interval, self.UpdateDrawGiftTip, self, false,
                    false, true)
            self.afkGiftTimer:Start()
        end
        self.afkGiftTick = (self.afkGiftTick or 0) + 1
        isShowTip = self.afkGiftTick % 2 == 0
    else
        --销毁定时器
        if self.afkGiftTimer then
            self.afkGiftTimer:Stop()
            self.afkGiftTimer = nil
        end
        isShowTip = interval ~= -1
    end

    --是否需要显示tip
    self.go_table.aorbtn_afkGiftTip:SetActiveE(isShowTip and 1 or 0)
    if not isShowTip then
        return
    end
    --获取下一个可领取的关卡
    local nextAfk = data.typeClass:GetNextTarget()
    if nextAfk == 0 then
        --奖励已全部领取完成
        self.go_table.aorbtn_afkGiftTip:SetActiveE(0)
        if self.afkGiftTimer then
            self.afkGiftTimer:Stop()
            self.afkGiftTimer = nil
        end
        return
    end
    self.go_table.aortext_afkGiftTip.text = _G.LangUtil.GetLangPackValue(90020800054, nextAfk)
end

-- 玩家选择的心愿饰品图片显示
function SpiritualDrawView:ShowWantedSpiritualImage()
    self.wishSpiritualSid = SpiritualDrawModel:GetWantedSpiritualSid()
    local iconCfg = _G.ConfigManager.spiritual_cfg[self.wishSpiritualSid]
    UIUtils.SetUIModelText(self.go_table.aortext_iconName,self.go_table.aortext_iconName2,iconCfg and _G.GetLangPackValue(iconCfg.Name) or "")
    local path = ""
    if iconCfg then
        path = iconCfg.image_1
    end
    if path ~= nil and path ~= "" then
        self.go_table.aorrawimage_Spiritual:LoadImage(
                path,
                function(item)
                    if _G.IsNil(self.go_table.aorrawimage_Spiritual) then
                        return
                    end
                    item:SetNativeSize()
                end)
        self.go_table.obj_redpoint:SetActiveE(0)
    else
        self.go_table.obj_redpoint:SetActiveE(1)
    end
    if _G.AppSetting.IsXzns then
        self.go_table.obj_redpoint:SetActiveE(0) --星座隐藏未选择时的假红点
        if self.wishSpiritualSid ~= 0 then
            if self.SpineAni then
                self.SpineAni.color = _G.ColorTools.FormatColorByString("787878")
            end
            self.go_table.obj_ringIcon:SetActiveE(0)
            self.go_table.obj_changeIcon:SetActiveE(1)
        else
            self.go_table.obj_ringIcon:SetActiveE(1)
            self.go_table.obj_changeIcon:SetActiveE(0)
        end
    end
end

---招募次数变化
function SpiritualDrawView:SetSliderAndTimes()
    -- 已抽次数
    self.times = SpiritualDrawModel:GetDrawTimesExtracted()
    -- 保底数
    local guaranteedNum = SpiritualDrawModel:GetLocalCfg().wish_number
    -- 再抽几次
    self.go_table.aortext_num.text = self.times
    self.go_table.aortext_num2.text = self.times
    self.go_table.aortext_num3.text = self.times
    _G.GameUtil.ReBuildRTF(self.go_table.obj_imageTips)
    -- 进度条
    if (guaranteedNum - self.times) < 0 then
        self.go_table.slider_count.value = 0
    else
        self.go_table.slider_count.value = (guaranteedNum - self.times) / guaranteedNum
    end
    self.go_table.aortext_Slider.text = (guaranteedNum - self.times) .. "/" .. guaranteedNum
end

---加载招募消耗信息
function SpiritualDrawView:LoadConsumesInfos()
    local material = SpiritualDrawModel:GetLocalCfg().ticket
    local rmb = SpiritualDrawModel:GetLocalCfg().ticket_2
    --获取招募券数量
    local ownNum = _G.StorageManager:GetInstance():GetItemCountBySid(material[1])
    local itemcfg = _G.ConfigManager.item_cfg
    local Icon = ownNum > 0 and itemcfg[material[1]].Icon or _G.StorageManager:GetInstance():GetItemIcon(rmb[1])
    local needNum1, needNum10 = material[2], material[2] * rightDrawNumber

    local midNum = rightDrawNumber
    if ownNum > 0 then
        if ownNum >= needNum1 and ownNum < needNum10 then
            --道具数量 1 < n < 10 时, 动态显示剩余数量
            midNum = _G.Mathf.Floor(ownNum / needNum1)
            if midNum < 1 then
                midNum = 10
            end
            needNum10 = material[2] * midNum
        end
    else
        needNum1, needNum10 = rmb[2], rmb[2] * 10
        midNum = 10
    end

    self.go_table.aorrawimage_Prop1:LoadImage(Icon)
    self.go_table.aorrawimage_Prop2:LoadImage(Icon)

    self.go_table.aortext_Prop1Num.text = needNum1
    --10次消耗
    self.go_table.aortext_Prop2Num.text = needNum10
    self.go_table.aortext_Prop2NumDesc.text = _G.GetLangPackValue(90000011229, _G.GameUtil.NumberToWordByLanguage(midNum))

    self.param = { Icon, needNum10 }

    self:LoadLimitDrawNum()

    ---广告按钮
    if require("AdvertisementModel"):GetInstance():CheckADShow(_G.AdvertisementType.SpiritualDraw) then
        self.go_table.aorbtn_AD:SetActiveE(1)
        local nowTimes = require("AdvertisementModel"):GetInstance():GetADTimes(_G.AdvertisementType.SpiritualDraw)
        local maxTimes = require("AdvertisementModel"):GetInstance():GetAdMax(_G.AdvertisementType.SpiritualDraw)
        self.go_table.aortext_AD.text = nowTimes > 1 and _G.GetLangPackValue(90000011734, nowTimes, maxTimes) or
                _G.GetLangPackValue(90000011733)
    else
        self.go_table.aorbtn_AD:SetActiveE(0)
    end

    local freeCount = SpiritualDrawModel:GetDayFreeCount()
    if freeCount > 0 then
        self.go_table.aorrawimage_NumBg1:SetActiveE(0)
        self.go_table.obj_freeBG:SetActiveE(1)
        self.go_table.aortext_free1.text = _G.GetLangPackValue(92010089021, freeCount, _G.ConfigManager.item_roller_cfg[30100].free_day)
    else
        self.go_table.aorrawimage_NumBg1:SetActiveE(1)
        self.go_table.obj_freeBG:SetActiveE(0)
    end
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SpiritualFreeTimes.id)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.TimesofSpiritualDraw.id)

    -- 红点
    --self.go_table.obj_hongDian:SetActiveE(ownNum >= 10 and 1 or 0)
    --颜色
    --self.go_table.aortext_Prop2Num.color =
    --(isDiamond and rightNum > ownDiaNum) and langugageColor.numRed or langugageColor.num
end

