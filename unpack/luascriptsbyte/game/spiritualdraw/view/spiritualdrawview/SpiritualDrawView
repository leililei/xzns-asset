---按钮
function SpiritualDrawView:OnClickBtn(go, isOn)
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DrawAwardView.Name)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        -- 关闭
        self:Close()
    elseif name == "@_aorbtn_help" then
        -- 帮助提示
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 150)
    elseif name == "@_aorbtn_changeSpiritual" then
        self:ChangeBtnSO(true)
        -- 打开选择心愿界面
        _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.SpiritualChooseView.Name,
                _G.handler(self, self.ShowWantedSpiritualImage)
        )
    elseif name == "@_aorbtn_gift" then
        -- 礼包界面
        self:ChangeBtnSO(true)
        _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.SpiritualDrawGiftPackView.Name,
                _G.handler(self, self.BuyCall),
                _G.ActivitySubType.Spiritual
        )
    elseif name == "@_aorbtn_awards" then
        -- 累计招募领奖界面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DrawGiftPackToggleView.Name, nil, subType)
    elseif name == "@_aorbtn_autoLeft" then
        self:UpdateDrawPlayBtn(1 - self.playState)
    elseif name == "@_aorbtn_Draw1" then
        if self.isClick == nil or self.isClick == false then
            -- 招募一次
            self:DrawCard(_G.DrawType.once, not window)
            if window then
                window.View:Close()
            end
        end
    elseif name == "@_aorbtn_Draw2" then
        if self.isClick == nil or self.isClick == false then
            -- 招募十次
            self:DrawCard(_G.DrawType.TenTimes, not window)
            if window then
                window.View:Close()
            end
        end
    elseif name == "@_aorbtn_AD" then
        require "MonthlyModel":GetInstance():CheckShowADTips(function()
            require("AdvertisementModel"):GetInstance():VideoAD(_G.AdvertisementType.SpiritualDraw,
                _G.handler(self, self.LoadConsumesInfos))
        end)
    elseif go == self.go_table.aorbtn_probability then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpiritualProbabilityView.Name)
    elseif go == self.go_table.aorbtn_illustrate then
        _G.MainManager:GetInstance():OpenMainViewToggle("card", function()
            local window = _G.UIManager:GetInstance():GetWindowCtrl("MainView")
            if window then
                local panel = window.panelLua
                if panel.card then
                    --panel.card.go_table.obj_artifact:SetActiveE(1)
                    panel.card.selecttoggle = "spiritual"
                end
            end
        end)
        self:Close()
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArtifactDrawToggleGroupView.Name)
    end
end

---修改层级
function SpiritualDrawView:ChangeBtnSO(isShop)
    if isShop then
        self.go_table.obj_btn:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder = self.gameObject
                                                                                                    :GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder + 30
    else
        self.go_table.obj_btn:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder = self.gameObject
                                                                                                    :GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder + 100
    end
end

function SpiritualDrawView:RefreRedPoint()
end

---销毁对象时,析构函数
function SpiritualDrawView:OnDestroy()
    self.EffBg = nil
    self.Eff = nil
    if self.afkGiftTimer then
        self.afkGiftTimer:Stop()
        self.afkGiftTimer = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.eAdvertisement.Refresh, self.LoadConsumesInfos, self)
end

return SpiritualDrawView
