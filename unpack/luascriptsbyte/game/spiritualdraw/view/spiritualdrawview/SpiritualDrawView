---创建对象时,入口构造函数
function SpiritualDrawView:OnCreate(redCall)
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.SpiritualDrawView, self.go_table)
    -- 当前保底累积次数
    self.times = 0
    -- 每日抽奖次数
    self.day_times = 0
    -- 心愿饰品sid
    self.wishSpiritualSid = 0
    --传递参数
    self.param = {}
    self.go_table.aorbtn_gift:SetActiveE(_G.AppSetting.IsArraigned and 0 or 1)
    self.go_table.aorbtn_awards:SetActiveE(_G.AppSetting.IsArraigned and 0 or 1)
    --初始化图集显示
    self:InitAtlas()
    self:LoadSpine()
    -- 玩家选择的心愿饰品图片显示
    self:ShowWantedSpiritualImage()
    ---招募次数变化
    self:SetSliderAndTimes()
    ---招募按钮和招募消耗信息
    self:LoadConsumesInfos()
    --动画按钮
    self:UpdateDrawPlayBtn()
    self:SetCumulativeAwardsViewRedPoint()
    --动画背景
    self:PlayBgEffect()
    local resources = _G.ConfigManager.ui_cfg.SpiritualDrawView.resources
    self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, resources))
    self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))
    self:ChangeBtnSO(true)
    --self:AddListener(_G.eArena.RefreshSeniorView, self.RefreshView)
end

-- 设置图集为原图大小
function SpiritualDrawView:InitAtlas()
    local spriteNames = {
        "ui_spzh_zaichou",
        "ui_spzh_cibichu",
        "ui_spzh_txt_caise",
        "ui_spzh_shipin"
    }
    for i = 1, 4 do
        if self.go_table and self.go_table["aorimage_tips" .. i] then
            self.go_table["aorimage_tips" .. i]:LoadAtlasSprite(
                    "AtlasH5/hSpiritualDraw_Language/hSpiritualDraw_LanguageAtlas",
                    spriteNames[i],
                    1,
                    function(img)
                        img:SetNativeSize()
                    end
            )
        end
    end
end

function SpiritualDrawView:LoadSpine()
    if _G.AppSetting.IsXzns then
        _G.PoolsManager:GetInstance():Spawn(
                "WX_Role/Animation_UI/Shipinzhaohuan_UI/prf_Shipinzhaohuan_UI_ui",
                _G.ePoolType.Temporary,
                self.go_table.obj_role,
                function(role)
                    self.SpineAni = role:GetChildE(0):GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
                    GameUtil.SetCardUiSpineAnimation1(self.SpineAni, "idle", true)
                    self.SpineAniAsset = self.SpineAni.SkeletonDataAsset:GetSkeletonData(false)
                    local wish = SpiritualDrawModel:GetWantedSpiritualSid()
                    if wish ~= 0 then
                        self.SpineAni.color = _G.ColorTools.FormatColorByString("787878") ---星座选心愿之后spine置灰
                    end
                end
        )
    end
end

function SpiritualDrawView:PlaySpineAni(name)
    if not self.go_table or not self.SpineAni or _G.AppSetting.HeXieLevel > 0 then
        return
    end
    local animation = self.SpineAniAsset:FindAnimation(name)
    if not animation then
        return
    end
    self.SpineAni.startingAnimation = name
    self.SpineAni:Initialize(true)
    local default = "idle"
    if name ~= default then
        local duration = animation.Duration
        _G.DelayDo(duration, function()
            if self.go_table and self.SpineAni then
                self.SpineAni.startingAnimation = default
                self.SpineAni:Initialize(true)
            end
        end)
    end
end

-- 设置累计招募次数红点和按钮
function SpiritualDrawView:SetCumulativeAwardsViewRedPoint()
    local data = require "ActivitySynManager":GetInstance():GetChildAcitivity(10043, subType)
    local actEndTime = 0
    if data then
        local id = data.typeClass:GetRedpointIDByIndex(1)
        self.go_table.obj_awardsRedpoint:UpdateRedPointItemIDAndParam(id)
        actEndTime = data.cfg.time.start_time + data.cfg.time.run_time
        self.go_table.aortext_drawAName.text = data.cfg.info.title
