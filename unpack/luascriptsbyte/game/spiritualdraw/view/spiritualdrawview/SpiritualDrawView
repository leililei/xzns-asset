--- 招募
function SpiritualDrawView:DrawCard(type, isBtnDraw)
    if type == nil then
        self:ChangeBtnSO(true)
        return
    end
    self.isBtnDraw = isBtnDraw == nil and true or isBtnDraw
    if self.isClick then
        return
    end
    self.isClick = true

    local num = type == _G.DrawType.once and 1 or 10
    local freeBol
    if type == _G.DrawType.once and SpiritualDrawModel:GetInstance():GetDayFreeCount() > 0 then
        freeBol = true
    end
    --获取拥有的招募券数量
    local material = SpiritualDrawModel:GetLocalCfg().ticket
    local rmb = SpiritualDrawModel:GetLocalCfg().ticket_2
    local ownNum = _G.StorageManager:GetInstance():GetItemCountBySid(material[1])
    local needBase, needNum, materialType
    if freeBol then
        materialType = 3
    elseif ownNum > 0 then
        materialType = 1
        needBase, needNum = material[2], num * material[2]
        if needNum >= needBase and ownNum < needNum then
            --道具数量 1 < n < 10 时, 动态显示剩余数量
            num = math.floor(ownNum / needBase)
            if num < 1 then
                num = 10
            end
            needNum = needBase * num
        end

        --检查招募券数量，不足弹窗
        if ownNum < needNum then
            self.isClick = false
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, material[1])
            return
        end
    else
        materialType = 2
        needBase, needNum = rmb[2], num * rmb[2]
        if not _G.StorageManager:GetInstance():CheckItem(rmb[1], needNum) then
            self.isClick = false
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, rmb[1])
            return
        end
    end

    --检查仓库是否已满
    local WishSid = SpiritualDrawModel:GetWantedSpiritualSid()
    if WishSid ~= 0 and _G.StorageManager:GetInstance():CheckIsFullBySid(WishSid, num) then
        _G.PopWindowManager:GetInstance():ShowAllTips(330104) --90030900005
        self.isClick = false
        return
    end
    self:ChangeBtnSO(false)
    if materialType == 2 then
        _G.PopWindowManager:GetInstance():ShowBtnWindowByToggle(
                627,
                function()
                    SpiritualDrawModel:DrawSpiritualCard(
                            materialType,
                            num,
                            _G.handler(self, self.DrawCall),
                            function()
                                self.isClick = false
                            end
                    )
                end,
                function()
                    self.isClick = false
                end,
                nil,
                true,
                needNum,
                num,
                _G.GetLangPackValue(_G.ConfigManager.item_cfg[material[1]].Name),
                num
        )
    else
        SpiritualDrawModel:DrawSpiritualCard(
                materialType,
                num,
                _G.handler(self, self.DrawCall),
                function()
                    self.isClick = false
                end,
                freeBol
        )
    end
end

--- 招募回调
function SpiritualDrawView:DrawCall(data)
    if data.ack ~= 1 then
        return
    end
    --刷新按钮招募次数
    self:LoadConsumesInfos()

    if self.playState == DrawPlayState.Play and self.isBtnDraw then
        --todo 动画播放
        self:PlayEffect(data.award)
    else
        --动画关闭的
        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, { award = data.award }, nil, false)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DrawAwardView.Name, { award = data.award }, nil,
                true, nil, nil, nil, nil, nil, nil, nil, nil, nil, self.param)
    end

    --刷新进度
    self:SetSliderAndTimes()
    self:SetCumulativeAwardsViewRedPoint()
    --红点：可以领取GM奖励
    --RedPointManager:GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.ArtifactDraw.id)
    _G.DelayDo(0.5, function() --ZHJH-14839 两次抽取之间强制间隔0.5秒，防止玩家点击过快看不到结果
        self.isClick = false
    end)
end

--背景特效
function SpiritualDrawView:PlayBgEffect()
    if not self.EffBg then
        _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_shipinchangjing,
                self.go_table.obj_effBg,
                function(trans)
                    if self:IsNil() then
                        _G.DestroyObject(trans)
                        return
                    end
                    self.EffBg = trans
                end
        )
    end
end

--动画
function SpiritualDrawView:PlayEffect(award)
    if _G.ConfigManager.ui_effect_cfg.ef_shipinchouka then
        self.go_table.obj_eff:SetActiveE(1)
        self.go_table.aorbtn_Draw1.enabled = false
        self.go_table.aorbtn_Draw2.enabled = false
        local showResult = function()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DrawAwardView.Name, { award = award }, nil,
                    true, nil, nil, nil, nil, nil, nil, nil, nil, nil, self.param)
            if _G.AppSetting.IsXzns and self.SpineAni then
                _G.DelayDo(
                        0.2,
                        function()
                            local wish = SpiritualDrawModel:GetWantedSpiritualSid()
                            if wish ~= 0 then
                                self.SpineAni.color = _G.ColorTools.FormatColorByString("787878")
                            end
                        end
                )
            end
        end
        if self.SpineAni then
            self:PlaySpineAni("show")
        end
        if _G.AppSetting.IsXzns then
            local wish = SpiritualDrawModel:GetWantedSpiritualSid()
            if wish ~= 0 and self.SpineAni then
                self.SpineAni.color = _G.ColorTools.FormatColorByString("FFFFFF")
            end

            if wish ~= 0 then
                self.go_table.obj_ringIcon:SetActiveE(0)
            else
                self.go_table.obj_ringIcon:SetActiveE(1)
            end
            _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.ef_SpiritualDrawView_bgbao,
                    self.go_table.obj_eff,
                    function(trans)
                        if self:IsNil() then
                            _G.DestroyObject(trans)
                            return
                        end
                    end
            )
            _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.ef_SpiritualDrawView_juqi,
                    self.go_table.obj_eff,
                    function(trans)
                        if self:IsNil() then
                            _G.DestroyObject(trans)
                            showResult()
                            return
                        end
                        self.go_table.obj_ring2:SetActiveE(0)
                    end,
                    function()
                        if self:IsNil() then
                            showResult()
                            return
                        end
                        _G.UIUtils.LoadEffectByCfg(
                                _G.ConfigManager.ui_effect_cfg.ef_SpiritualDrawView_bao,
                                self.go_table.obj_eff,
                                function(eff)
                                    if self:IsNil() then
                                        _G.DestroyObject(eff)
                                        showResult()
                                        return
                                    end
                                end,
                                function()
                                    if self:IsNil() then
                                        showResult()
                                        return
                                    end
                                    showResult()
                                    self.go_table.obj_eff:SetActiveE(0)
                                    self.go_table.aorbtn_Draw1.enabled = true
                                    self.go_table.aorbtn_Draw2.enabled = true
                                    self.go_table.obj_ring2:SetActiveE(1)
                                end
                        )
                    end
            )
        else
            self.go_table.aorbtn_changeSpiritual:SetActiveE(0)
            if not self.Eff then
                _G.UIUtils.LoadEffectByCfg(
                        _G.ConfigManager.ui_effect_cfg.ef_shipinchouka,
                        self.go_table.obj_eff,
                        function(trans)
                            if self:IsNil() then
                                _G.DestroyObject(trans)
                                return
                            end
                            self.Eff = trans
                        end
                )
            end
            _G.DelayDo(
                    1.2,
                    function()
                        if self:IsNil() then
                            return
                        end
                        showResult()
                        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, { award = award }, nil, false)
                        self.go_table.obj_eff:SetActiveE(0)
                    end
            )
            _G.DelayDo(
                    1.3,
                    function()
                        self.go_table.aorbtn_Draw1.enabled = true
                        self.go_table.aorbtn_Draw2.enabled = true
                        self.go_table.aorbtn_changeSpiritual:SetActiveE(1)
                    end
            )
        end
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DrawAwardView.Name, { award = award }, nil, true,
                nil, nil, nil, nil, nil, nil, nil, nil, nil, self.param)
        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, { award = award }, nil, false)
    end
end

---更新动画播放按钮
function SpiritualDrawView:UpdateDrawPlayBtn(type)
    if type == nil then
        self.playState = _G.PlayerPrefsManager.GetInt("SpiritualPlaySkip")
        if self.playState == nil then
            self.playState = DrawPlayState.Play
        end
    else
        self.playState = type
    end
    _G.PlayerPrefsManager.SetInt("SpiritualPlaySkip", self.playState)

    local isPlay = self.playState == DrawPlayState.Play
    self.go_table.aorimage_auto.gameObject:SetLocalPosition(isPlay and 30 or -30, 0, 0)
    self.go_table.aortext_wenzi.text = _G.ConfigManager.language_package_cfg
    [isPlay and DrawPlayText.Open or DrawPlayText.Close]
    self.go_table.aorimage_skip:SetActiveE(isPlay and 1 or 0)
end

