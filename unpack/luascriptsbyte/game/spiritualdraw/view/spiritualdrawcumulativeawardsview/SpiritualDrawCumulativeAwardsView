---@class SpiritualDrawCumulativeAwardsView : UIBaseView    中文描述
---@field public go_table SpiritualDrawCumulativeAwardsView_GoTable GoTable
---@field activity ActivitySynBase
---@field activityCls DrawUpBattlePassTaskModel
local SpiritualDrawCumulativeAwardsView = _G.BaseClass("SpiritualDrawCumulativeAwardsView", _G.UIBaseView)
-- 累抽任务对应的招募界面，领取奖励时用来刷新对应界面的tips,key是活动的子类型
local drawViewName = {
    [_G.ActivitySubType.Spiritual] = _G.ConfigManager.ui_cfg.SpiritualDrawView.Name,
    [_G.ActivitySubType.Draw] = _G.ConfigManager.ui_cfg.DrawView.Name,
    [_G.ActivitySubType.Artifact] = _G.ConfigManager.ui_cfg.ArtifactDrawView.Name,
    [_G.ActivitySubType.Pet] = _G.ConfigManager.ui_cfg.PetDrawView.Name,
    [_G.ActivitySubType.Remains] = _G.ConfigManager.ui_cfg.RemainsDrawView.Name
}

local imageNameT = {
    [_G.ActivitySubType.Spiritual] = {"ui_swck_cktc_js", "ui_swck_cktc_txt"},
    [_G.ActivitySubType.Draw] = {"ui_cchd_tc_juese_1", "ui_cchd_tc_txt_1"},
    [_G.ActivitySubType.Artifact] = {"ui_cchd_tc_juese_2", "ui_cchd_tc_txt_3"},
    [_G.ActivitySubType.Pet] = {"ui_cchd_hqms_js", "ui_cchd_hqms_txt"},
    [_G.ActivitySubType.Remains] = {"ui_ywxt_img_dj_rw", "ui_ywxt_txt_rw"}
}
local imagePos = {
    [_G.ActivitySubType.Spiritual] = {-10, 303},
    [_G.ActivitySubType.Draw] = {-102, 303},
    [_G.ActivitySubType.Artifact] = {-135, 303},
    [_G.ActivitySubType.Pet] = {-10, 303},
    [_G.ActivitySubType.Remains] = {-21, 306}
}

function SpiritualDrawCumulativeAwardsView:Awake()
    if _G.AppSetting.IsXzns then
        drawViewName[_G.ActivitySubType.Beast] = _G.ConfigManager.ui_cfg.BeastMainView.Name
        -- 用于获取星座圣兽招募界面脚本
        self.drawViewParams = {
            [_G.ActivitySubType.Beast] = {"BeastDrawPanel"}
        }
        imageNameT[_G.ActivitySubType.Beast] = {"ui_ss_img_js_bft", "ui_ss_txt_hqss"}
        imagePos[_G.ActivitySubType.Beast] = {-143, 268}
        _G.GameUtil.SetUiHeXieMask(self.go_table)
    end
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eDrawUpBattlePass.DrawUpBattlePassRefeshTask, self.RefreshTask)
end

---界面的入口函数
function SpiritualDrawCumulativeAwardsView:OnCreate(activity)
    self.activity = activity
    self.activityCls = self.activity:GetActivityTypeCls()

    self.isInited = false
    self:UpdateView()
    self.isInited = true
    self.subType = self.activity:GetJumpType()

    -- 倒计时
    self.endTime = self.activity.cfg.time.start_time + self.activity.cfg.time.run_time
    if self.Timer == nil then
        self:UpdateTime()
        self.Timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.Timer:Start()
    end
    for i = 1, 2 do
        self.go_table["aorrawimage_" .. i]:LoadImage("ImagesH5/hSpiritualDraw/" .. imageNameT[self.subType][i],
            function(tran)
                tran:SetNativeSize()
            end)
    end
    self.go_table.aortext_des.text = activity.cfg.info.description
    self.go_table.aorrawimage_1:SetLocalPosition(imagePos[self.subType][1], imagePos[self.subType][2], 0)
    if self.subType == _G.ActivitySubType.Remains then
        self.go_table.aorrawimage_2:SetLocalPosition(153, 450, 0)
    end
end

---更新界面
function SpiritualDrawCumulativeAwardsView:UpdateView()
    local page = self.activityCls:GetNowPage()
    if self.nowPage and self.nowPage ~= page then
        self.isInited = false
    end
    self.nowPage = page
    self.go_table.aortext_page.text = _G.LangUtil.GetLangPackValue(90020800053, page, self.activityCls:GetAllPage())
    self:RefreshTask()
    local getTaskList = self.activityCls:GetCankTaskList()
end

---任务刷新
function SpiritualDrawCumulativeAwardsView:RefreshTask()
    self.taskDatas = self.activityCls:GetTaskListByPage(self.nowPage)
    self:SortTask()
    if not self.isInited then
        self.go_table.scrollloopvectical_Group:InitItemData(#self.taskDatas, _G.handler(self, self.RefreshTaskItem))
    else
        self.go_table.scrollloopvectical_Group:UpdateCount(#self.taskDatas)
    end
end

function SpiritualDrawCumulativeAwardsView:RefreshTaskItem(index, obj)
    ---@type SpiritualDrawCumulativeAwardsView._obj_item_GoTable
    local go_table = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickTask, index + 1))
    go_table.obj_items:ClearChildren()
    local data = self.taskDatas[index + 1]
    go_table.aortext_info.text = data.Cfg.name
    if data.i_task.state == _G.TaskEnum.ETaskState.Submited then
        go_table.aortext_jd.text = _G.string.format("<color=#3E6709>%s</color>/%s", data.Cfg.count, data.Cfg.count)
        local isGet = self.activityCls:CheckIsGet(data.Cfg.id)
        go_table.aorbtn_get:SetActiveE(isGet and 0 or 1)
        go_table.aorbtn_way:SetActiveE(0)
        go_table.aorimage_get:SetActiveE(1)
        go_table.aorimage_over:SetActiveE(isGet and 1 or 0)
        go_table.aortext_jd:SetActiveE(not isGet and 1 or 0)
    else
        go_table.aortext_jd.text = _G.string.format("<color=#AA3932>%s</color>/%s", data.i_task.target[1],
            data.Cfg.count)
        go_table.aorbtn_get:SetActiveE(0)
        go_table.aorimage_get:SetActiveE(1)
        go_table.aorbtn_way:SetActiveE(1)
        if data.Cfg.link and data.Cfg.link ~= 0 then
            go_table.aorbtn_way:SetGray(false)
            go_table.aortext_label.text = _G.LangUtil.GetLangPackValue(90022200010)
            go_table.aorbtn_way.interactable = true
        else
            go_table.aorbtn_way:SetGray(true)
            go_table.aortext_label.text = _G.LangUtil.GetLangPackValue(90020400086)
            go_table.aorbtn_way.interactable = false
        end
        go_table.aorimage_over:SetActiveE(0)
        go_table.aortext_jd:SetActiveE(1)
    end

    for i = 1, #data.Cfg.reward do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(data.Cfg.reward[i].type, go_table.obj_items, function(tran)
            tran.gameObject:SetLocalScaleXYZ(0.85)
            if data.Cfg.reward[i].type[2] > 1 then
                tran:ShowNumText(true, require"ItemViewBase".NumTextAnchor.RightDown)
            else
                tran:ShowNumText(false)
            end
            tran:SetGou(self.activityCls:CheckIsGet(data.Cfg.id))
            if tran.ShowEffectOrder and tran.cfg then
                tran:ShowEffectOrder(tran.cfg.ef_item == 1 and true or false)
            end
        end)
    end
end

---设置任务进度
function SpiritualDrawCumulativeAwardsView:SetTaskItemjd(aorimage, value, loopValue_Max)
    local w = value / loopValue_Max
    if w > 1 then
        w = 1
    end
    aorimage:SetRectTransformSize(value > 0 and w * (186) or 0, 14)
end

---活动结束时间
function SpiritualDrawCumulativeAwardsView:UpdateTime()
    local endTime = self.endTime
    if _G.TimeUtil.GetServerUnixTime() <= endTime then
        local timeStr = ""
        local t = _G.TimeUtil.TranslateSecond(endTime - _G.TimeUtil.GetServerUnixTime())
        if t.day > 0 then
            timeStr = _G.string.format(_G.LangUtil.GetLangPackValue(90022100001), t.day, t.hour)
        else
            timeStr = _G.string.format(_G.LangUtil.GetLangPackValue(90021800030), t.hour, t.min, t.sec)
        end

        self.go_table.aortext_time.text = _G.GetLangPackValue(90000010360,
            string.format("<color=#a5f37f>%s</color>", timeStr))
    else
        local view1 = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DrawGiftPackToggleView.Name)
        if view1 then
            view1:Close()
        end
    end
end

---点击任务
function SpiritualDrawCumulativeAwardsView:OnClickTask(go, isOn, index)
    local name = go:GetName()
    local data = self.taskDatas[index]
    if name == "@_aorbtn_get" then
        self.activityCls:GetAward(self.activityCls:GetCankTaskListByPage(), function()
            self:UpdateView()
            local view = _G.UIManager:GetInstance():GetWindowCtrl(drawViewName[self.activity:GetJumpType()])
            if _G.AppSetting.IsXzns then
                if view and self.drawViewParams[self.activity:GetJumpType()] then
                    view = view:GetPanelCtrl(_G.table.unpack(self.drawViewParams[self.activity:GetJumpType()]))
                end
            end
            if view then
                view:UpdateDrawGiftTip()
            end
            local mainView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SpiritualDrawView.Name)
            if mainView then
                mainView:BuyCall()
            end
        end)
    elseif name == "@_aorbtn_way" then
        ---策划需求（跳转到对应的界面
        local view = _G.UIManager:GetInstance():GetWindowCtrl(drawViewName[self.activity:GetJumpType()])
        if view then
            local view1 = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DrawGiftPackToggleView.Name)
            if view1 then
                view1:Close()
            end
        else
            _G.JumpManager:GetInstance():Jump(data.Cfg.link, nil)
        end
    end
end

function SpiritualDrawCumulativeAwardsView:SortTask()
    ---@param data DrawUpBattlePassTaskData
    _G.SortList(self.taskDatas, function(data)
        local index = 1
        if data.i_task.state == _G.TaskEnum.ETaskState.Submited then
            index = 2
            if self.activityCls:CheckIsGet(data.i_task.sid) then
                index = -1
            end
        end
        return index, -data.i_task.sid
    end)
end

---按钮点击事件在这里派发
function SpiritualDrawCumulativeAwardsView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_rili then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CalendarView.Name)
    end
    --[[    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close2 then
            self:Close()
        end]]
end

function SpiritualDrawCumulativeAwardsView:OnDestroy()
    if self.Timer then
        self.Timer:Stop()
        self.Timer = nil
    end
end

return SpiritualDrawCumulativeAwardsView
