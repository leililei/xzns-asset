---@class DrawGiftPackToggleView : UIBaseView    中文描述
---@field public go_table CycleBattlePassToggleView_GoTable GoTable
local DrawGiftPackToggleView = _G.BaseClass("DrawGiftPackToggleView", _G.UIBaseView)

local AState = {
    Close = 1,
    Notice = 2,
    Open = 3,
    Settlement = 4
}

local CheckToggleShowFunc = {
    [1] = function(subType)
        local actT = require "ActivitySynManager":GetInstance():GetChildAcitivity(10007, subType)
        return actT ~= nil
    end,
    [2] = function(subType)
        local actT = require "ActivitySynManager":GetInstance():GetChildAcitivity(10014, subType)
        return actT ~= nil
    end,
}

local ShowViewFunc = {
    [10014] = function(subType)
        local data = require "ActivitySynManager":GetInstance():GetChildAcitivity(10014, subType)
        if data == nil and (subType == _G.ActivitySubType.Spiritual or subType == _G.ActivitySubType.Pet or (_G.AppSetting.IsXzns and subType == _G.ActivitySubType.Beast)) then
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.SpiritualDrawGiftPackView.Name,
                nil,
                subType
            )
        else
            if data.curState == AState.Close or data.curState == AState.Settlement or data.curState == AState.Notice then
                data:CheckActivityInteractable()
                return
            end
            data:EnterActivity()
        end
    end,
    [10007] = function(subType)
        local data = require "ActivitySynManager":GetInstance():GetChildAcitivity(10007, subType)
        if data.curState == AState.Close or data.curState == AState.Settlement or data.curState == AState.Notice then
            data:CheckActivityInteractable()
            return
        end
        data:EnterActivity()
    end
}


function DrawGiftPackToggleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
end

---界面的入口函数
function DrawGiftPackToggleView:OnCreate(activityData, subType, index)
    self.subType = subType
    self.activityData = activityData
    self.index = index or 1
--[[    self.uiNameIndex = {
        [_G.ConfigManager.ui_cfg.NoviceGiftPackView.Name] = 1, 
        [_G.ConfigManager.ui_cfg.LimitTimeDropView.Name] = 2,
        [_G.ConfigManager.ui_cfg.SpiritualDrawCumulativeAwardsView.Name] = 3,
        }]]
    self.views = {}
    self:InitToggle()
end

function DrawGiftPackToggleView:InitView(actType)
    if ShowViewFunc[actType] then
        ShowViewFunc[actType](self.subType)
    else
        print("没有找到对应的活动显示函数: ", actType)
    end
end

function DrawGiftPackToggleView:InitRedPoint()
    self.redpointIds = {}
    -- NoviceGiftPackView 对应活动类型 1
    self.toggleName = {}
    local data14 = require "ActivitySynManager":GetInstance():GetChildAcitivity(10014, self.subType)
    if data14 then
        self.redpointIds[10014] = data14.typeClass:GetRedpointIDByIndex(1)
        self.toggleName[10014] = data14.cfg.info.title
    end
    if data14 == nil and self.subType == _G.ActivitySubType.Spiritual then
        self.redpointIds[10014] = 1234
        self.toggleName[10014] = _G.GetLangPackValue(90021000026)
    end
    if data14 == nil and self.subType == _G.ActivitySubType.Pet then
        self.redpointIds[10014] = _G.ConfigManager.redpoint_cfg.PetDrawGift.id
        self.toggleName[10014] = _G.GetLangPackValue(90010050340)
    end
    if _G.AppSetting.IsXzns then
        if data14 == nil and self.subType == _G.ActivitySubType.Beast then
            self.redpointIds[10014] = _G.ConfigManager.redpoint_cfg.BeastDrawGift.id
            self.toggleName[10014] = _G.GetLangPackValue(90010050340)
        end
    end
    local data07 = require "ActivitySynManager":GetInstance():GetChildAcitivity(10007, self.subType)
    if data07 then
        self.redpointIds[10007] = data07.typeClass:GetRedpointIDByIndex(1)
        self.toggleName[10007] = data07.cfg.info.title
    end
end

function DrawGiftPackToggleView:InitToggle()
    self:InitRedPoint()
    -- local seasonId = require("NoviceGiftPackModel"):GetInstance().seasonId
    -- local noviceGiftName = _G.ConfigManager.season_gift_cfg[seasonId].name

    local activityConfigs = {
        [10007] = { text = self.toggleName[10007], viewName = _G.ConfigManager.ui_cfg.SpiritualDrawCumulativeAwardsView.Name },
        [10014] = { text = self.toggleName[10014], viewName = _G.ConfigManager.ui_cfg.SpiritualDrawGMGiftPackView.Name },
    }

    local availableActivities = {}
    if CheckToggleShowFunc[1](self.subType) then
        table.insert(availableActivities, { actType = 10007, toggleName = "toggle_gift1", viewName = activityConfigs[10007].viewName })
    end
    if CheckToggleShowFunc[2](self.subType) then
        table.insert(availableActivities, { actType = 10014, toggleName = "toggle_gift2", viewName = activityConfigs[10014].viewName })
    end
    if self.subType == _G.ActivitySubType.Spiritual or self.subType == _G.ActivitySubType.Pet or (_G.AppSetting.IsXzns and self.subType == _G.ActivitySubType.Beast) then
        table.insert(availableActivities,
            {
                actType = 10014,
                toggleName = "toggle_gift2",
                viewName = _G.ConfigManager.ui_cfg.SpiritualDrawGiftPackView.Name
            })
    end

    -- 没有可用的活动，打开NoviceGiftPackView
    if #availableActivities == 0 then
        ShowViewFunc[1](self.subType)
        return
    end
    
    self.availableActivities = availableActivities
    self.toggles = {}
    
    

    -- 动态生成页签,回调 显示文本及红点更新
    for i, actInfo in ipairs(availableActivities) do
        self.toggles[i] = _G.GetAutoGoTable(
                self.go_table[actInfo.toggleName],
                _G.handlerbind(self, self.OnClickToggle, i, _G.handlerbind(self, self.InitView, actInfo.actType))
        )
        local actName = activityConfigs[actInfo.actType].text
        self.toggles[i].aortext_label1.text = actName
        self.toggles[i].aortext_label.text  = actName

        --红点
        if self.redpointIds[actInfo.actType] then
            self.toggles[i].obj_redpoint:UpdateRedPointItemIDAndParam(self.redpointIds[actInfo.actType])
        end

        --确保当前页签物体显示
        self.go_table[actInfo.toggleName]:SetActiveE(1)
    end

    -- 隐藏没加入availableActivities的页签物体
    local allToggleNames = {"toggle_gift1", "toggle_gift2", "toggle_gift3"}
    for _, tName in ipairs(allToggleNames) do
        local isAvailable = false
        for _, actInfo in ipairs(availableActivities) do
            if actInfo.toggleName == tName then
                isAvailable = true
                break
            end
        end
        if not isAvailable then
            self.go_table[tName]:SetActiveE(0)
        end
    end

    -- 根据传入的 self.index 选中默认页签（如果 index 超出范围，则选中第一个）
    local selectIndex = self.index
    if selectIndex > #availableActivities then
        selectIndex = 1
    end
    self.go_table[availableActivities[selectIndex].toggleName].isOn = false
    self.go_table[availableActivities[selectIndex].toggleName].isOn = true
    --self:OnClickToggle(self.go_table[availableActivities[selectIndex].toggleName], true, selectIndex, _G.handlerbind(self, self.InitView, availableActivities[selectIndex].actType))
end

function DrawGiftPackToggleView:OnClickToggle(go, isOn, key, call)
    -- 处理当前点击的页签
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    self.go_table["obj_view" .. key]:SetActiveE(isOn and 1 or 0)
    if isOn and call then
        call()
    end
end

function DrawGiftPackToggleView:OnUIOpened(name)
    for i, actInfo in ipairs(self.availableActivities or {}) do
        if actInfo.viewName == name then
            self.views = self.views or {}
            self.views[i] = _G.UIManager:GetInstance():GetWindowCtrl(name)
            if _G.AppSetting.IsXzns then
                local order = self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
                _G.UIManager:GetInstance():ChangeCanvasOrder(name, order + 5)
            end
            -- 将页面作为对应页签的子物体
            self.views[i].transform:SetParentE(self.go_table["obj_view" .. i])
            
            break
        end
    end
end

---按钮点击事件在这里派发
function DrawGiftPackToggleView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_shadow then
        self:CloseView()
    end
end

function DrawGiftPackToggleView:CloseView(...)
    self:Close()
end

function DrawGiftPackToggleView:Dispose()
    if self.availableActivities then
        for _, actInfo in ipairs(self.availableActivities) do
            _G.UIManager:GetInstance():CloseWindow(actInfo.viewName)
        end
    end
    self:RemoveAllListener()
end

return DrawGiftPackToggleView
