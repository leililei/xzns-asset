local SpiritualDrawModel = require("SpiritualDrawModel"):GetInstance()
---@class SpiritualChooseView : UIBaseView	中文描述
---@field go_table SpiritualChooseView_GoTable
local SpiritualChooseView = _G.BaseClass("SpiritualChooseView", _G.UIBaseView)
local CardInfoManager = require("CardInfoManager"):GetInstance()

---饰品品质背景
local QualityIcon = {
    "ui_js_txk_zi",
    "ui_js_txk_cheng",
    "ui_js_txk_hong",
    "ui_js_txk_cai"
}


local bgColorPath = {
    "ui_biaoqian_hong",
    "ui_biaoqian_cheng",
    "ui_biaoqian_lv",
    "ui_biaoqian_zi",
}


function SpiritualChooseView:Awake()
    self.chooseSid = SpiritualDrawModel:GetWantedSpiritualSid() or 0
    self.lastItemCount = 0
    self.SpiritualList = {}
    self.EmbattleModel = require "EmbattleModel":GetInstance()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建对象时,入口构造函数
function SpiritualChooseView:OnCreate(callback)
    self.callback = callback

    self.SpiritualList = SpiritualDrawModel:GetAllSpiritualInfo()
    self:Show(true)
end

function SpiritualChooseView:Show(isInit)
     -- 已抽次数
    local times = SpiritualDrawModel:GetDrawTimesExtracted()
    -- 保底数
    -- local guaranteedNum = SpiritualDrawModel:GetLocalCfg().wish_number
    self.go_table.aortext_toptips.text = _G.GetLangPackValue(90021000028, times)

    local itemCount = #self.SpiritualList
    if isInit then
        self.go_table.scrollloopvectical_SpiritualList:InitItemData(itemCount, _G.handler(self, self.RefreshItemList))
    else
        if itemCount == self.lastItemCount then
            self.go_table.scrollloopvectical_SpiritualList:UpdateAllItem()
        else
            self.go_table.scrollloopvectical_SpiritualList:UpdateCount(itemCount)
        end
    end
    self.lastItemCount = itemCount
end

function SpiritualChooseView:RefreshItemList(index, obj)
    local data = self.SpiritualList[index + 1]
    local tb = _G.GetAutoGoTable(obj)
    _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickItemBtn, data, index))
    if data then
        -- 背景
        tb.aorimage_rank.SpriteName = QualityIcon[data.order]
        --名字
        tb.aortext_name.text = _G.GetLangPackValue(data.cfg.Name)
        local pos = data.cfg.pos_portrait1
        local spiritual_cfg = _G.ConfigManager.spiritual_cfg[data.sid]

        tb.aorimage_cardIcon:SetActiveE(0)
        tb.aorimage_cardBg:SetActiveE(0)
        tb.aorimage_tipsBg.SpriteName = bgColorPath[spiritual_cfg.label[1]]
        tb.aortext_tipsname.text = _G.LangUtil.GetLangPackValue(spiritual_cfg.label[2])

        -- icon
        tb.aorrawimage_icon:LoadImage(
            data.image,
            function(item)
                if pos then
                    item:SetNativeSize()
                    item:SetLocalPosition(pos[1] or 0, pos[2] or 0, pos[3] or 0)
                    if pos[4] then
                        item:SetLocalScaleXYZ(pos[4])
                    end
                end
            end
        )
        -- 选中
        tb.aorbtn_choose:SetActiveE(data.sid == self.chooseSid and 1 or 0)
        if data.sid == self.chooseSid then
            self.index = index
        end
        obj:SetActiveE(1)

        local StorageManager = _G.StorageManager:GetInstance()
        local itemData = StorageManager:GetItemDataClassByCfg({data.sid})
        local datas = StorageManager:GetDatasBySid(_G.StorageID.Spiritual, itemData.sid)
        local cardList = {}
        if not _G.table.isEmptyOrNil(datas) then
            for _, v in pairs(datas) do
                -- if v.cardUid and v.cardUid > 0 and not v:IsMaxStar() then
                -- 镇魂街ZHJ-27879 Alpha_JT BUG合集ZHJ-34317 测试要求将未觉醒的神器加入快捷使用
                if v.cardUid and v.cardUid > 0 and not v:IsMaxStar() then
                    local cardData = StorageManager:GetDatasByUid(_G.StorageID.Card, v.cardUid)
                    if not _G.table.isEmptyOrNil(cardData) and self.EmbattleModel:CheckHeroEmbattle(v.cardUid) then
                        _G.table.insert(cardList, cardData)
                    end
                end
            end
        end

        if not _G.table.isEmptyOrNil(cardList) then
            tb.aorbtn_tip:SetActiveE(1)
            tb.aorbtn_tip.onClick:RemoveAllListeners()
            tb.aorbtn_tip.onClick:AddListener(
                _G.handlerbind(self, self.OnClickBtnTip, _G.StorageType.Spiritual, cardList, itemData)
            )
        else
            tb.aorbtn_tip:SetActiveE(0)
        end
    end
end

--点击饰品响应
function SpiritualChooseView:OnClickItemBtn(go, isOn, data, index)
    local name = go:GetName()
    if name == "@_aorbtn_choose" then
        -- 饰品详情
        require "CommonTipManager":GetInstance():OpenTip(go, data.sid, nil, nil, true)
    elseif name == "@_aorbtn_item" then
        -- 选中饰品 记录sid
        self.chooseSid = data.sid
        self.go_table.scrollloopvectical_SpiritualList:UpdateItemSingle(self.index)
        self.go_table.scrollloopvectical_SpiritualList:UpdateItemSingle(index)
        --self.index = index
    end
end

function SpiritualChooseView:OnClickBtnTip(storageType, cardList, itemData)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.CommonTipView.Name,
        _G.TipType.WearCardList,
        storageType,
        cardList,
        itemData
    )
end

function SpiritualChooseView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_close" or name == "@_aorbtn_guanbi" then
        --关闭
        self:Close()
    elseif name == "@_aorbtn_sure" then
        --选定心愿饰品
        SpiritualDrawModel:SetWantedSpiritual(
            self.chooseSid,
            function()
                if self.callback then
                    self.callback()
                end
                self:Close()
            end
        )
    end
end

---销毁对象时,析构函数
function SpiritualChooseView:OnDestroy()

end

return SpiritualChooseView
