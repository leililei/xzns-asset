function SpiritualDrawGMGiftPackView:UpdateView(activityClass, updateFlag)
    if activityClass == nil then
        self.curActivityClass = require "ActivitySynManager":GetInstance():GetChildAcitivity(10014)
    else
        self.curActivityClass = activityClass
    end
    self.subType = self.curActivityClass:GetJumpType()
    for i = 1, 2 do
        self.go_table["aorrawimage_" .. i]:LoadImage("ImagesH5/hSpiritualDraw/" .. imageNameT[self.subType][i],
            function(tran)
                tran:SetNativeSize()
            end)
    end
    local uiModel = _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.ui_model_1)
    if uiModel and self.subType == _G.ActivitySubType.Draw then
        self.go_table.aorrawimage_2:SetLocalPosition(-112, 400, 0)
    elseif  self.subType == _G.ActivitySubType.Remains then 
        self.go_table.aorrawimage_2:SetLocalPosition(0, 346, 0)
    end
    self.go_table.aorrawimage_1:SetLocalPosition(imagePos[self.subType][1], imagePos[self.subType][2], 0)
    self.infocfgs = self.curActivityClass.typeClass.infocfg
    _G.SortList(self.infocfgs, function(data)
        local buyCount = self.curActivityClass.typeClass:GetItemBuyTimes(data.sid)
        local checkNum = (data.count - buyCount) > 0 and 1 or 0
        return checkNum, -data.sid
    end)
    local endTime, _ = self.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    self.activityEndTime = endTime
    self:StopAllTimer()
    self:UpdateTime()
    self.endTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.endTimer:Start()
    -- --策划说第一个礼包有特殊框体
    -- self.infocfgsTop = { self.infocfgs[1] }
    -- self.infocfgsDown = {}
    -- for i = 2, #self.infocfgs do
    --     _G.table.insert(self.infocfgsDown, self.infocfgs[i])
    -- end

    -- if updateFlag then
    --     self.go_table.scrollloopvectical_item:UpdateAllItem()
    --     self.go_table.scrollloopvectical_top:UpdateAllItem()
    -- else
    --     self.go_table.scrollloopvectical_item:InitItemData(#self.infocfgsDown, _G.handler(self, self.RefreshList))
    --     self.go_table.scrollloopvectical_top:InitItemData(#self.infocfgsTop, _G.handler(self, self.RefreshListTop))
    -- end

    self:UpdateList(updateFlag)
    if _G.AppSetting.IsXzns then
        _G.GameUtil.SetUiHeXieMask(self.go_table)
    end
end

function SpiritualDrawGMGiftPackView:UpdateList(updateFlag)
    local topNum = 0
    self.infocfgsTop = {}
    self.infocfgsDown = {}
    for i = 1, #self.infocfgs do
        local data = self.infocfgs[i]
        if string.IsNullOrEmpty(data.name) or data.name == 0 then
            -- if self.model.buyList[data.id] then
            --     _G.table.insert(self.infocfgsDown, data)
            -- else
            --     topNum = topNum + 1
            --     _G.table.insert(self.infocfgsTop, data)
            -- end
            topNum = topNum + 1
            _G.table.insert(self.infocfgsTop, data)
        else
            _G.table.insert(self.infocfgsDown, data)
        end
    end
    if topNum > 0 then
        if topNum >= 2 then
            self.go_table.scrollloopvectical_top:UpdateScrollRectHeight(385)
            self.go_table.scrollloopvectical_top:SetRectTransformSize(684, 385)
            self.go_table.scrollloopvectical_item:UpdateScrollRectHeight(370)
            self.go_table.scrollloopvectical_item:SetRectTransformSize(684, 370)
        elseif topNum == 1 then
            self.go_table.scrollloopvectical_top:UpdateScrollRectHeight(194)
            self.go_table.scrollloopvectical_top:SetRectTransformSize(684, 194)
            self.go_table.scrollloopvectical_item:UpdateScrollRectHeight(520)
            self.go_table.scrollloopvectical_item:SetRectTransformSize(684, 520)
        end
        if updateFlag then
            self.go_table.scrollloopvectical_top:UpdateAllItem()
        else
            self.go_table.scrollloopvectical_top:InitItemData(topNum, _G.handler(self, self.RefreshListTop))
        end
    else
        self.go_table.scrollloopvectical_top:SetActiveE(0)
        self.go_table.scrollloopvectical_item:UpdateScrollRectHeight(712)
        self.go_table.scrollloopvectical_item:SetRectTransformSize(684, 712)
    end
    if updateFlag then
        self.go_table.scrollloopvectical_item:UpdateAllItem()
    else
        self.go_table.scrollloopvectical_item:InitItemData(#self.infocfgs - topNum, _G.handler(self, self.RefreshList))
    end
end

function SpiritualDrawGMGiftPackView:UpdateTime()
    local time = self.activityEndTime - _G.TimeUtil.GetServerUnixTime()
    if time <= 0 then
        local view1 = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DrawGiftPackToggleView.Name)
        if view1 then
            view1:Close()
        end
        return
    end
    local str = _G.TimeUtil.GodSpecialGiftForStr(time)
    self.go_table.aortext_time.text = _G.GetLangPackValue(90000010360, string.format("<color=#a5f37f>%s</color>", str))
end

function SpiritualDrawGMGiftPackView:RefreshList(index, objGame)
    if index < 0 then
        return
    end
    local data = self.infocfgsDown[index + 1]
    local itemGoTable = _G.GetAutoGoTable(objGame, _G.handlerbind(self, self.OnClick_item, data))

    itemGoTable.obj_special:SetActiveE(0)
    local node = itemGoTable.obj_Root
    if node:GetChildCountE() > 0 then
        for i = 1, node:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(node:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    for i = 1, #data.award do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(data.award[i].type, node, function(item)
            item.gameObject:SetLocalScale(0.8, 0.8, 0.8)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            item:ShowEffectOrder(item.cfg.ef_item == 1 and true or false)
        end, function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data.award[i].type[1])
        end)
    end

    -- if data.discount == 10000 then
    --     itemGoTable.aortext_desc.text = _G.GetLangPackValue(90000011042)
    -- else
    --     itemGoTable.aortext_desc.text = _G.GetLangPackValue(90000011043, math.modf(data.discount / 100))
    -- end

    local buyCount = self.curActivityClass.typeClass:GetItemBuyTimes(data.sid)
    itemGoTable.aortext_name.text = data.name
    local restCount = data.count - buyCount
    _G.GameUtil.AddDouYinIcon(itemGoTable.aorbtn_btnBuy, true, itemGoTable.aortext_price, nil, nil, data.price)

    if restCount > 0 then
        itemGoTable.aortext_limit.text = _G.GetLangPackValue(utils.getLanguageId(data.type_reset, false), restCount,
            data.count)
        itemGoTable.obj_free:SetActiveE(data.price <= 0 and 1 or 0)
    else
        itemGoTable.aortext_limit.text = _G.GetLangPackValue(utils.getLanguageId(data.type_reset, true), restCount,
            data.count)
        itemGoTable.obj_free:SetActiveE(0)
    end
    if buyCount >= data.count then
        itemGoTable.obj_sellOut:SetActiveE(1)
        itemGoTable.aorbtn_btnBuy:SetActiveE(0)
        itemGoTable.obj_price:SetActiveE(0)
        itemGoTable.aortext_rmb:SetActiveE(0)
        itemGoTable.aorbtn_btnBuy:SetGray(true)
        itemGoTable.aorbtn_btnBuy.enabled = false
    else
        itemGoTable.obj_sellOut:SetActiveE(0)
        itemGoTable.aorbtn_btnBuy:SetActiveE(1)
        itemGoTable.aorbtn_btnBuy:SetGray(false)
        itemGoTable.aorbtn_btnBuy.enabled = true

        if data.consume_type == 0 then
            itemGoTable.obj_price:SetActiveE(0)
            itemGoTable.aortext_rmb:SetActiveE(1)
            ---如果是海外版本用多语言美元符号，反之国服使用元作为单位
            if data.price == 0 then
                itemGoTable.aortext_rmb.text = _G.GetLangPackValue(90030800004)
            else
                _G.GameUtil.SetPriceByChannel(data.price, itemGoTable.aortext_rmb)
            end
        else
            itemGoTable.obj_price:SetActiveE(1)
            itemGoTable.aortext_rmb:SetActiveE(0)
            itemGoTable.aorrawimage_price:SetActiveE(1)
            itemGoTable.aorrawimage_price:LoadImage(_G.ConfigManager.currency_type_cfg[data.consume_type].icon)
            if data.price == 0 then
                itemGoTable.aortext_price.text = _G.GetLangPackValue(90030800004)
            else
                itemGoTable.aortext_price.text = tostring(data.price)
            end
        end
    end
end

function SpiritualDrawGMGiftPackView:RefreshListTop(index, objGame)
    if index < 0 then
        return
    end
    local data = self.infocfgsTop[index + 1]
    local itemGoTable = _G.GetAutoGoTable(objGame, _G.handlerbind(self, self.OnClick_item, data))

    itemGoTable.obj_special:SetActiveE(1)
    _G.GameUtil.AddDouYinIcon(itemGoTable.aorbtn_btnBuy, true, nil, nil, nil, data.price)

    local node = itemGoTable.obj_Root
    if node:GetChildCountE() > 0 then
        for i = 1, node:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(node:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    for i = 1, #data.goods do
        local award = data.goods[i]
        _G.StorageManager:GetInstance():GetItemBaseViewNew(award, node, function(item)
            item.gameObject:SetLocalScale(0.8, 0.8, 0.8)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            local cfg = item.cfg or item.data.cfg
            item:ShowEffectOrder(cfg.ef_item == 1 and true or false)
        end, function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, award[1])
        end)
    end

    -- if data.discount == 10000 then
    --    itemGoTable.aortext_desc.text = _G.GetLangPackValue(90000011042)
    -- else
    --    itemGoTable.aortext_desc.text = _G.GetLangPackValue(90000011043, math.modf(data.discount / 100))
    -- end

    ---@type number 付费礼包存储在DrawModel中, 免费礼包存储在MallManager中, 需要单独处理
    local buyCount
    buyCount = self.curActivityClass.typeClass:GetItemBuyTimes(data.sid)
    itemGoTable.aortext_name.text = _G.GetLangPackValue(data.name)
    local restCount = data.count - buyCount
    itemGoTable.aortext_limit.text = _G.GetLangPackValue(utils.getLanguageId(data.type_reset, restCount <= 0),
        restCount, data.count)

    if restCount <= 0 then
        itemGoTable.obj_sellOut:SetActiveE(1)
        itemGoTable.aorbtn_btnBuy:SetActiveE(0)
        itemGoTable.obj_free:SetActiveE(0)
        itemGoTable.obj_price:SetActiveE(0)
        itemGoTable.aortext_rmb:SetActiveE(0)
        itemGoTable.aorbtn_btnBuy:SetGray(true)
        itemGoTable.aorbtn_btnBuy.enabled = false
    else
        itemGoTable.obj_sellOut:SetActiveE(0)
        itemGoTable.aorbtn_btnBuy:SetActiveE(1)
        itemGoTable.obj_free:SetActiveE(data.price <= 0 and 1 or 0)
        itemGoTable.aorbtn_btnBuy:SetGray(false)
        itemGoTable.aorbtn_btnBuy.enabled = true
        itemGoTable.aortext_rmb:SetActiveE(data.type_price == 1 and 1 or 0)
        itemGoTable.obj_price:SetActiveE(data.type_price == 1 and 0 or 1)
        if data.consume_type == 0 then
            itemGoTable.obj_price:SetActiveE(0)
            itemGoTable.aortext_rmb:SetActiveE(1)
            ---如果是海外版本用多语言美元符号，反之国服使用元作为单位
            if data.price == 0 then
                itemGoTable.aortext_price.text = _G.GetLangPackValue(90030800004)
            else
                -- if _G.GameUtil.IsNotPlatformSpecial() then
                --     ---如果是海外版本用多语言美元符号，反之国服使用元作为单位
                --     if _G.AppSetting.IsOverseas then
                --         itemGoTable.aortext_rmb.text = _G.GetLangPackValue(90000010807) ..
                --             _G.GameUtil.RatioControl(data.price)
                --     else
                --         itemGoTable.aortext_rmb.text = _G.GetLangPackValue(90000010819,
                --             _G.GameUtil.RatioControl(data.price))
                --     end
                -- else
                --     itemGoTable.aortext_rmb.text = _G.GameUtil.PlatformPrice(data.price)
                -- end
                _G.GameUtil.SetPriceByChannel(data.price, itemGoTable.aortext_rmb)
            end
        else
            itemGoTable.obj_price:SetActiveE(1)
            itemGoTable.aortext_rmb:SetActiveE(0)
            itemGoTable.aorrawimage_price:SetActiveE(1)
            itemGoTable.aorrawimage_price:LoadImage(_G.ConfigManager.currency_type_cfg[data.consume_type].icon)
            if data.price == 0 then
                itemGoTable.aortext_price.text = _G.GetLangPackValue(90030800004)
            else
                itemGoTable.aortext_price.text = tostring(data.price)
            end
        end
    end
end

function SpiritualDrawGMGiftPackView:OnClick_item(itemGoTable, isOn, data)
    self.curActivityClass.typeClass:Chongzhi(data, function()
        if self:IsNil() then
            return
        end
        self:UpdateView(self.curActivityClass, 2)
    end)
end

function SpiritualDrawGMGiftPackView:OnClickBtn(go, isOn, viewName)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:CloseView()
    elseif name == "@_aorbtn_zhaomu" then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DrawView.Name)
        if not view then
            self:CloseView()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DrawView.Name, 1, nil, 4)
        end
    elseif name == "@_aorbtn_guanbi" then
        self:CloseView()
    end
end

function SpiritualDrawGMGiftPackView:StopAllTimer()
    if self.endTimer then
        self.endTimer:Stop()
        self.endTimer = nil
    end
end

function SpiritualDrawGMGiftPackView:EscClose()
    self:CloseView()
end

function SpiritualDrawGMGiftPackView:CloseView()
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DrawGiftPackToggleView.Name)
    self:StopAllTimer()
    self:Close()
end

function SpiritualDrawGMGiftPackView:OnDestroy()
    self:CloseView()
end

return SpiritualDrawGMGiftPackView
