---@class SpiritualDrawTaskInfoData	限时累抽次数
local SpiritualDrawTaskInfoData = _G.BaseClass("SpiritualDrawTaskInfoData", _G.LogicClass)

function SpiritualDrawTaskInfoData:__init(activity)
    self.activity = activity
    self.curActivityClass = self.activity.curActivityClass
end
---进入活动
function SpiritualDrawTaskInfoData:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpiritualDrawCumulativeAwardsView.Name, self.curActivityClass)
end
---领取奖励
function SpiritualDrawTaskInfoData:GetAward(ids,call)
    require "DrawUpBattlePassTaskNet":GetInstance():GetAward(
        {activity_id = self.curActivityClass:GetActivityID(), task_sid = ids, finish_type = 2},
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)

            for _, v in pairs(ids) do
                local task = self.activity:GetTaskData(v)
                if not msg.award or not msg.award.item then
                    msg.award = {item = {}}
                end
                
                self.activity.finishTask[v] = true
            end
            require "CommonTipManager".OpenCommonAwardView(msg)
            self.activity:RefreshRedPoint()
            
            if call then
                call()
            end
        end
    )
end

return SpiritualDrawTaskInfoData
