---时间6刷新
function SpiritualDrawModel:Update()
    self:GetSpiritualDrawCardInfo(
        function()
            local SpiritualDrawView = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.SpiritualDrawView.Name)
            if SpiritualDrawView ~= nil then
                --更新今日剩余招募次数
                SpiritualDrawView.View:LoadLimitDrawNum()
            end
            --刷新礼包红点
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SpiritualDrawGiftPack.id)
        end
    )

    local week = _G.TimeUtil.GetDateTime(_G.TimeUtil.GetServerUnixTime()).week
    if week == 1 then
        _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "SpiritualGiftLastRefreshTime", 0)
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SpiritualDrawGiftPack.id)
    end
end

