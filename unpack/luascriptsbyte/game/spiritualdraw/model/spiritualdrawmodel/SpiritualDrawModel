end

---抽卡
---@param num number @召唤次数
function SpiritualDrawModel:DrawSpiritualCard(type, num, call, cancelCall, freeBol)
    --没选饰品
    if self.wish_spiritual == 0 then
        --飘字
        _G.PopWindowManager:GetInstance():ShowAllTips(130304)
        if cancelCall then
            cancelCall()
        end
        return
    end

    --抽卡上限
    if self.day_times + num > self.LocalCfg.limit_daily then
        _G.PopWindowManager:GetInstance():ShowAllTips(130303)
        if cancelCall then
            cancelCall()
        end
        return
    end

    local msg = {}
    msg.draw_times = num
    msg.type = type
    SpiritualDrawNet:GetInstance():DrawSpiritual(msg,
        function(data)
            if data.ack ~= 1 then
                return
            end

            --消耗招募券
            local material = self.LocalCfg.ticket
            if type == 1 then
                _G.StorageManager:GetInstance():ConsumeItem(material[1], nil, material[2] * num)
            elseif type == 2 then
                material = self.LocalCfg.ticket_2
                _G.StorageManager:GetInstance():ConsumeItem(material[1], nil, material[2] * num)
            elseif type == 3 then
                if freeBol then
                    self.free_count = self.free_count + 1
                else
                    _G.StorageManager:GetInstance():ConsumeItem(material[1], nil, material[2] * num)
                end
            end
            --解析奖励
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            if data.award.overflow then 
                _G.PopWindowManager:GetInstance():ShowAllTips(380104)
            end
            --招募次数更新
            if data.need_count then
                self.times = data.need_count
            end
            self.day_times = self.day_times + num

            --[[    --红点
                require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GodDraw.id)
                --事件
                _G.Events:GetInstance():Broadcast(_G.eSeasonTask.Action, {_G.SeasonTaskID.Draw, 4}, num)]]

            if call then
                call(data)
            end
        end)
end

---选择心愿饰品
function SpiritualDrawModel:SetWantedSpiritual(sid, call)
    if sid ~= 0 and sid ~= nil then
        local msg = {}
        msg.wish_sid = sid

        SpiritualDrawNet:GetInstance():SetSpiritualWish(
            msg,
            function(data)
                if data.ack == 1 then
                    self.wish_spiritual = sid
                    if call then
                        call()
                    end
                end
            end)
    end
end

