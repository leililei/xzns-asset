    if not self.LocalCfg or _G.TableIsEmpty(self.LocalCfg) then
        --local poolCfg = _G.ConfigManager.discrete_cfg[104314]        --看起来像是给池子的id
        --if not poolCfg then
        --    return nil
        --end
        self.LocalCfg = _G.ConfigManager.item_roller_cfg[30100]--poolCfg[1][1]]
    end
    return self.LocalCfg
end

---主界面中的按钮关闭
function SpiritualDrawModel:SetBtnCloseCountdown()
    if not _G.AppSetting.IsXzns then
        local success = pcall(SpiritualDrawModel.CheckFirstRround)
        if not success then
            _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.SpiritualDraw)
        else
            _G.FunctionManager:GetInstance():OpenFunById(_G.MainFunctionItems.SpiritualDraw)
        end
    end
end

---检测主界面中显示，饰品召唤活动入口需与gm活动饰品探寻同步，gm活动开启时，活动入口开启，gm活动结束时入口关闭
function SpiritualDrawModel.CheckFirstRround()
    local data = require "ActivitySynManager":GetInstance():GetChildAcitivity(10043, 100314)
    if data and data.curState == AState.Open then
        return true
    end
    return false
end

