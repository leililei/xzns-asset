---创建对象时,入口构造函数
function SpiritualDrawModel:__init()
    self.LocalCfg = {}
    --饰品表
    self.SpiritualCfg = {}
    local wishItem = self:GetLocalCfg().wish_item
    for _, v in pairs(wishItem) do
        local data = {}
        local cfg = spiritual_cfg[v]
        data.sid = cfg.id
        data.image = cfg.image_1
        data.name = cfg.Name
        data.cfg = cfg
        data.order = cfg.Order
        _G.table.insert(self.SpiritualCfg, data)
    end
    self.isOpenFunction = false
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.RefreshRedPoint, self)
    --_G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

