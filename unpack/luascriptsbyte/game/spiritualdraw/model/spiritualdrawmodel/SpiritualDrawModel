---获取抽奖信息（getinfo
function SpiritualDrawModel:GetSpiritualDrawCardInfoSuc(data, call)
    self.isOpenFunction = true
    --每日抽奖次数
    self.day_times = data.day_count and data.day_count or 0
    --当前保底累积次数
    self.times = data.need_count and data.need_count or 0
    --心愿灵契sid
    self.wish_spiritual = data.wish_spiritual and data.wish_spiritual or 0
    if data.free_count then
        self.free_count = data.free_count
    end
    self.free_count = self.free_count or 0
    if call ~= nil then
        call()
    end
    self.super.ParseData(self)
end

--endregion -------------------------------------------------- 网络回调 end --------------------------------------------------

