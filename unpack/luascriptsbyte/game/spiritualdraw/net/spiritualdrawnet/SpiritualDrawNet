---@class SpiritualDrawNet : BaseGameNet	通信协议
local SpiritualDrawNet = _G.BaseClass("SpiritualDrawNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return SpiritualDrawNet SpiritualDrawNet
function SpiritualDrawNet:GetInstance()
    return base.GetInstance(self)
end

---获取灵契抽奖信息
---@param callback function 完成回调
function SpiritualDrawNet:GetSpiritualDrawInfo(callback)
    local item = _G.ConfigManager.net_map.game_spiritual_draw_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---点击抽卡，发送draw_times = 抽几张
function SpiritualDrawNet:DrawSpiritual(pbData, callback)
    local item = _G.ConfigManager.net_map.game_spiritual_draw_execute
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---设置心愿灵契。发送卡牌sid wish_sid
---@param pbData table PB数据
---@param callback function 完成回调
function SpiritualDrawNet:SetSpiritualWish(pbData, callback)
    local item = _G.ConfigManager.net_map.game_spiritual_draw_set_wish
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

