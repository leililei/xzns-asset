local base = require("ProYangMiniGameMainView")
---@class EasterMiniGameMainView : UIBaseView	中文描述
---@field public go_table EasterMiniGameMainView_GoTable GoTable
local EasterMiniGameMainView = _G.BaseClass("EasterMiniGameMainView", base)

---按钮点击事件在这里派发
function EasterMiniGameMainView:OnClickBtn(go)
    if go == self.go_table.aorbtn_startGame then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.EasterMiniGameView.Name,
            nil,
            _G.handler(self, self.UpdateView),
            {{20203, 2, self.activity}}
        )
    elseif go == self.go_table.aorbtn_tips then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 201)
    else
        base.OnClickBtn(self,go)
    end
end

function EasterMiniGameMainView:TimerFunc(elapsed)
    if _G.AppSetting.IsXzns then
        self.lastTime = self.lastTime - elapsed
        if self.lastTime < 0 then
            self:CloseView()
        else
            local time = _G.TimeUtil.GiftPackGroupTime(self.lastTime)
            self.go_table.aortext_time.text = time
        end
    else
        base.TimerFunc(self,elapsed)
    end
end

return EasterMiniGameMainView