local base = require("SpringFestivalGloryAssemblyView")
---@class EasterGloryAssemblyView : SpringFestivalGloryAssemblyView	中文描述
---@field public go_table EasterGloryAssemblyView_GoTable GoTable
local EasterGloryAssemblyView = _G.BaseClass("EasterGloryAssemblyView", base)

function EasterGloryAssemblyView:OnCreate(activity)
    self.playEffect = {
        {
            _G.ConfigManager.ui_effect_cfg.ef_tuowei_1_1,
            _G.ConfigManager.ui_effect_cfg.ef_tuowei_1_2,
            _G.ConfigManager.ui_effect_cfg.ef_tuowei_1_3,
        },
        {
            _G.ConfigManager.ui_effect_cfg.ef_tuowei_20_1,
            _G.ConfigManager.ui_effect_cfg.ef_tuowei_20_2,
            _G.ConfigManager.ui_effect_cfg.ef_tuowei_20_3,
            _G.ConfigManager.ui_effect_cfg.ef_tuowei_20_4,
        },
        {
            _G.ConfigManager.ui_effect_cfg.ef_tuowei_50_1,
            _G.ConfigManager.ui_effect_cfg.ef_tuowei_50_2,
            _G.ConfigManager.ui_effect_cfg.ef_tuowei_50_3,
            _G.ConfigManager.ui_effect_cfg.ef_tuowei_50_4,
        }

    }
    self.selectIndex = 1
    self.notOpenConditions = _G.ConfigManager.discrete_cfg[201008]
    if not _G.GlobalConditionManager.CheckConditionArrays(self.notOpenConditions) then
        self.go_table.aorbtn_activityNotOpen:SetActiveE(1)
    else
        self.go_table.aorbtn_activityNotOpen:SetActiveE(0)
    end
    base.OnCreate(self, activity)
    self.selectBg = true
    self:UpdateSelect()
end

function EasterGloryAssemblyView:InitData()
    self.skinId = _G.ConfigManager.discrete_cfg[201013][1][1]
end

function EasterGloryAssemblyView:GetPeriodCfg(index)
    if index ~= 2 then
        return base.GetPeriodCfg(self, index)
    else
        return _G.ConfigManager.discrete_cfg[201014][self.selectIndex][1]
    end
end

function EasterGloryAssemblyView:GetPlayEffect()
    local effIndex = _G.math.random(1, self:GetPeriodCfg(3))--特效的随机范围
    return self.playEffect[self.donatePeriod][effIndex]
end

function EasterGloryAssemblyView:LoadSpineCall(trans)
    base.LoadSpineCall(trans)
    _G.GameUtil.SetCardUiSpineAnimation(trans,"idle", true)
end

function EasterGloryAssemblyView:UpdateCoinView()
    base.UpdateCoinView(self)
    local coinNum = self.model:GetCoinNumber()
    local nowNum = _G.math.max(0, coinNum - self.donateNum)
    self.go_table.aortext_consume.text = _G.string.format(coinNum == 0 and "<color=red>%s</color>" or "%s", nowNum)
end

function EasterGloryAssemblyView:UpdateInfo()
    if not _G.GlobalConditionManager.CheckConditionArrays(self.notOpenConditions) then
        self.go_table.aortext_TaskText.text = _G.GetLangPackValue(_G.ConfigManager.discrete_cfg[201015][1][1])
        return
    end
    local isGetBigAward = self.model:CheckAward(self.type, self.awardDatas[#self.awardDatas].sid)
    if isGetBigAward then
        self.go_table.aorimage_Info:SetActiveE(0)
        return
    end
    self.go_table.aorimage_Info:SetActiveE((self.isShowInfo or self.isMaxValue) and 1 or 0)
    local langId = self.isMaxValue and 201012 or 201011
    self.go_table.aortext_TaskText.text = _G.GetLangPackValue(_G.ConfigManager.discrete_cfg[langId][1][1])
end

function EasterGloryAssemblyView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_activityNotOpen then
        local isPass, tipTxt = _G.GlobalConditionManager.GetTipsText(self.notOpenConditions[1][1],self.notOpenConditions[1][2])
        if isPass then
            self.go_table.aorbtn_activityNotOpen:SetActiveE(0)
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(250159, tipTxt)
        end
    elseif go == self.go_table.aorbtn_change then
        self.go_table.obj_select:SetActiveE(self.selectBg and 0 or 1)
        self.selectBg = not self.selectBg
    elseif go == self.go_table.aorbtn_select1 then
        self.selectIndex = 1
        self:UpdateSelect()
    elseif go == self.go_table.aorbtn_select2 then
        self.selectIndex = 2
        self:UpdateSelect()
    elseif go == self.go_table.aorbtn_select3 then
        self.selectIndex = 3
        self:UpdateSelect()
    elseif go == self.go_table.aorbtn_donate then--单次点击捐献按钮
        if self.isPlaying or self.isAttacking then
            return
        end
        if self.model:GetCoinNumber() < 1 then
            self.donateNum = 1
            self.isPressing = true
            self:OnUp()
            return
        end
        self:PlayEffect()
        if not self.isPressing then
            local coinNum = self.model:GetCoinNumber()
            self.donateNum = _G.math.min(coinNum, self:GetPeriodCfg(2))
            self.isPressing = true
            self:ChangeBtn()
            self:OnUp()
        end
    else
        base.OnClickBtn(self, go, isOn)
    end
end

function EasterGloryAssemblyView:UpdateSelect()
    for i = 1, 3 do
        self.go_table["aorimage_select" .. i]:SetActiveE(i == self.selectIndex and 1 or 0)
    end
end

---更新活动倒计时
---@param elapsed number
function EasterGloryAssemblyView:UpdateTimeView(elapsed)
    if elapsed then
        self.remainTime = self.remainTime - elapsed
    end
    local t = _G.TimeUtil.TranslateSecond(self.remainTime)
    local tStr
    if t.day > 0 then
        tStr = _G.GetLangPackValue(90022100001, t.day, t.hour)
    else
        tStr = _G.GetLangPackValue(90022100002, t.hour, t.min)
    end
    self.go_table.aortext_time.text = tStr
end

return EasterGloryAssemblyView
