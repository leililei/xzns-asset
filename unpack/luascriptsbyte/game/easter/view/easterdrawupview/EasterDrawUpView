local MTFestivalThreeDrawUpView = require("MTFestivalThreeDrawUpView")
---@class EasterDrawUpView : MTFestivalThreeDrawUpView 窗口
---@field private go_table EasterDrawUpView_GoTable GoTable
local EasterDrawUpView = BaseClass("EasterDrawUpView",MTFestivalThreeDrawUpView)

---界面的入口函数
function EasterDrawUpView:LoadStateBgEff()
    if not _G.AppSetting.IsXzns then
        _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_fhjck,
                self.go_table.obj_effect,
                function(tran)
                    if _G.IsNil(self.go_table) then
                        tran:DestroyObject()
                        return
                    end
                end
        )
    end
end


---@return EasterDrawUpView
return EasterDrawUpView