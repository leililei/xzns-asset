function EasterMainView:InitEffect(parent,cfg)
    _G.UIUtils.LoadEffectByCfg(
            cfg,
            parent,
            function(obj)
                if _G.IsNil(self.go_table) then
                    _G.UIUtils.RemoveEffect(obj)
                    return
                end
            end
    )
end

---界面的销毁函数
function EasterMainView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer=nil
    end
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
function EasterMainView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 155)
    end
end

return EasterMainView