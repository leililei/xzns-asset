local base = require "BaseGameNet"
---@class QuestionAnswerNet : BaseGameNet	通信协议
local QuestionAnswerNet = _G.BaseClass("QuestionAnswerNet", base)

---@return QuestionAnswerNet QuestionAnswerNet
function QuestionAnswerNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---添加所有后端主动推的网络消息监听接口
function QuestionAnswerNet:AddMessageListeners()
    ---请手动添加后端主动推送的消息监听代码
    self:AddMessageListener(_G.ConfigManager.net_map.question_answer_award.Cmd, self.SendChengJiuCollectorCall)
end

---请求
---@param pbData table PB数据
---@param callback function 完成回调
function QuestionAnswerNet:GetInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_question_answer_get_info
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---完成任务
function QuestionAnswerNet:FinishTask(pbData, callback)
    local item = _G.ConfigManager.net_map.game_question_answer_get_access_credential
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---领取解锁功能奖励
function QuestionAnswerNet:OpenAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_function_open_award
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

