function MainView:OnAfk(isOn, callback, notShowTips)
    ---@type AfkBattleManager
    local afkManager = require("AfkBattleManager"):GetInstance()
    local isFighting = afkManager:IsFighting()
    local isShowFighting = afkManager:IsShowFighting()
    if isFighting then
        local mId = require("AfkModel"):GetInstance():GetCurMonsterID()
        local mCfg = _G.ConfigManager.monster_group_cfg[mId]
        if mCfg then
            _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, mCfg.audio)
        end
        afkManager:SetFightView(isOn and isShowFighting)
    end

    if _G.AppSetting.IsXzns and not isFighting and not notShowTips then
        --星座在放置界面重复点击入口时弹tips
        if isOn then
            if self.isAfk then
                _G.PopWindowManager:GetInstance():ShowAllTips(1, _G.GetLangPackValue(90049200101))
            else
                self.isAfk = true
            end
        else
            self.isAfk = false
        end
    end
    self.go_table.obj_afk:SetActiveE(isOn and 1 or 0)
    if not isOn then
        --切换bgm
        local scene = _G.WorldManager:GetInstance().CurrentWorld
        if scene then
            _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, scene.Cfg.audio)
        end
        if callback then
            callback()
        end
        return
    end
    if self.panelInit.afk then
        if self.panelLua.afk then
            --afk面板已加载并初始化
            self.panelLua.afk.gameObject:SetActiveE(isFighting and isShowFighting and 0 or 1)
            if not isFighting or not isShowFighting then
                self.panelLua.afk:UpdateView()
            end
        end
        if callback then
            callback()
        end
        return
    end
    self.panelInit.afk = 0
    _G.PoolsManager:GetInstance():Spawn(
            PanelPrefabs.afk,
            _G.ePoolType.UIItem,
            self.go_table.obj_afk,
            function(trans)
                if not trans or trans:GetctiveInHierarchy() ~= 1 then
                    self.panelInit.afk = nil
                    _G.DestroyObject(trans)
                    if callback then
                        callback()
                    end
                    return
                end
                ---@type MainAfkPanel   AFK场景
                self.panelLua.afk = self:AddComponent(trans, require(PanelLuaFile.afk).New(trans))
                self.panelInit.afk = true
                if afkManager:IsFighting() and afkManager:IsShowFighting() then
                    self.panelLua.afk.gameObject:SetActiveE(0)
                end
                if callback then
                    callback()
                end
            end
    )
end

