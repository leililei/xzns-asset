--afk待机检查(点击事件监听)
---@type boolean,function
local clickRegisted, originalHandler = false, nil
local function registeClickEvent()
    if clickRegisted then
        return
    end
    clickRegisted = true

    ---@type function
    originalHandler = _G.CS.Main.GlobalClickHandler
    _G.CS.Main.GlobalClickHandler = function(...)
        if originalHandler then
            originalHandler(...)
        end
        ---@type MainView
        local mainView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name)
        if not mainView then
            return
        end
        mainView:UpdateAfkIdel(false)
    end
end
local function unregisteClickEvent()
    if not clickRegisted then
        return
    end
    clickRegisted = false
    _G.CS.Main.GlobalClickHandler = originalHandler
end

