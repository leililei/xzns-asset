---界面的入口函数
function MainView:OnCreate()
    self:InitToggle()
    self.panelInit = {}
    self.panelLua = {}
    self.panelLeaveTime = {}
    self.toggleItem = {
        fort = self.go_table.toggle_fort,
        wild = self.go_table.toggle_wild,
        afk = self.go_table.toggle_afk,
        card = self.go_table.toggle_card,
        sociaty = self.go_table.toggle_sociaty,
        benefit = self.go_table.toggle_benefit
    }
    --ZHJH-1430
    --【客户端】进入游戏后默认停留界面调整
    --ZHJH-2123 又要改回去,但读离散表（条件与解锁不一致）
    -- if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(unlockID["fort"]) then
    if _G.GlobalConditionManager.CheckConditionArrays(_G.ConfigManager.discrete_cfg[119007]) and not require("DouyinModel"):GetInstance():DouyinFeedScene() then
        self.go_table.toggle_fort.isOn = false
        self.go_table.toggle_fort.isOn = true
    else
        self.go_table.toggle_afk.isOn = false
        self.go_table.toggle_afk.isOn = true
    end
    self.defaultPanel = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(unlockID["fort"]) and "fort" or "afk"
    self.leaveTimer = _G.TimerManager:GetInstance():GetTimer(1, self.CheckPanelLeave, self, false, false)
    self.leaveTimer:Start()

    _G.GameMain:ReportGamePlay()
    if _G.tonumber(_G.SDKManager:GetInstance():GetChannelId()) == require("PlatformDef").RusChannel.IOS
            and _G.TimeUtil.GetInterValDayByGame(_G.PlayerModel:GetInstance().create_time, _G.TimeUtil.GetServerUnixTime()) > 0
            and _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.RusIOSNextDayLogin, 0) == 0
    then
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.RusIOSNextDayLogin, 1)
        _G.SDKManager:GetInstance():AttTip(require("SDKDef").ATTEvents.NextDayLogin)
    end
end

function MainView:OnEnable()
    self:InitAfkIdel()
    self:UpdateFloatMessages(true)

    --如果上一次切换页签且面板实例未加载(或加载时因MainView隐藏销毁), 重新执行加载逻辑
    if self.curTogKey and not self.panelInit[self.curTogKey] and self.curTogCall then
        self.curTogCall(true)
    end
end

function MainView:OnDisable()
    if self.afkIdelTimer then
        self.afkIdelTimer:Stop()
        self.afkIdelTimer = nil
    end

    if self.animatorStopTimer then
        self.animatorStopTimer:Stop()
        self.animatorStopTimer = nil
        self:StopAnimation()
    elseif self.animatorInit then
        self:StopAnimation()
    end
end

---获取当前选中的页签，此变量一定要和当前使用的变量同步，否则会影响引导
function MainView:GetTogKey()
    return self.curTogKey
end

function MainView:CheckPanelLeave()
    for key, time in pairs(self.panelLeaveTime) do
        if key ~= "fort" then
            if time > 10 and self.panelInit[key] == true then
                self.go_table["obj_" .. key]:ClearChildren()
                self.panelLua[key] = nil
                self.panelLeaveTime[key] = nil
                self.panelInit[key] = nil
            else
                self.panelLeaveTime[key] = time + 1
            end
        end
    end
end

