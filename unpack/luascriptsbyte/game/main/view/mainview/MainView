    _G.Events:GetInstance():AddListener(_G.eSociatyEvent.BeKicked, self.CloseSociatyIcon, self)
    _G.Events:GetInstance():AddListener(_G.eSociatyBattle.SociatyBattleBattle, self.UpdateSociatyIcon, self)
    _G.Events:GetInstance():AddListener(_G.eAfkEvents.Pass, self.UpdateView, self)
    _G.Events:GetInstance():AddListener(_G.ePlayerStatus.PlayerUpLevel, self.UpdateAfkIdelEffect, self)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnDeadsoulViewOpen, self)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnDeadsoulViewClosed, self)
    _G.Events:GetInstance():AddListener(_G.DungeonChallengeBattleViewShow.Open, self.UpdateNewFunctionIcon, self)
    _G.Events:GetInstance():AddListener(_G.CardHallViewShow.Open, self.UpdateSPNewFunctionIcon, self)
    _G.Events:GetInstance():AddListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.OnFunctionOpenCall, self)
end

