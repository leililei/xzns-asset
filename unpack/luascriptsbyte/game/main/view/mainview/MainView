---初始化AFK待机状态
function MainView:InitAfkIdel()
    local isShowIdelEffect = false
    if _G.PlayerModel:GetInstance():CheckCreateRole() then
        --n关卡后不再展示待机特效
        local cfg = _G.ConfigManager.discrete_cfg[120007]
        if cfg then
            isShowIdelEffect = require("AfkModel"):GetInstance():GetCurSection() <= cfg[1][1]
        end
    end
    --注册全局监听
    if isShowIdelEffect then
        registeClickEvent()
    else
        unregisteClickEvent()
    end
    self:UpdateAfkIdel(false)
end

---更新Afk待机状态
---@param newState boolean
function MainView:UpdateAfkIdel(newState)
    if not newState then
        if self.afkIdelTimer then
            self.afkIdelTimer:Stop()
            self.afkIdelTimer = nil
        end
        ---检查是否展示特效(n关卡之前), 并获取延迟时间
        local cfg1, cfg2 = _G.ConfigManager.discrete_cfg[120006], _G.ConfigManager.discrete_cfg[120007]
        if cfg1 and cfg2 and require("AfkModel"):GetInstance():GetCurSection() <= cfg2[1][1] then
            if not self.updateAfkIdelTrue then
                self.updateAfkIdelTrue = function()
                    self:UpdateAfkIdel(true)
                end
            end
            --等待n秒后显示待机特效
            local duration = cfg1[1][1]
            self.afkIdelTimer = _G.TimerManager:GetInstance():GetTimer(duration, self.updateAfkIdelTrue, self, true,
                    false, true)
            self.afkIdelTimer:Start()
        else
            unregisteClickEvent()
        end
    end
    if self.afkIdel == newState then
        return
    end
    self.afkIdel = newState
    self:UpdateAfkIdelEffect()
end

---更新AFK战斗特效
function MainView:UpdateAfkFightingEffect()
    if self.afkFightingEff == 0 then
        --特效正在加载中
        return
    end
    --获取afk战斗状态
    local model = require("AfkBattleManager"):GetInstance()
    if not model:IsFighting() then
        if self.afkFightingEff then
            self.afkFightingEff:SetActiveE(0)
        end
        if not _G.AppSetting.IsXzns then
            self.toggles.afk.obj_icon:SetActiveE(1)
        end
        return
    end

    --显示特效
    if self.afkFightingEff then
        self.afkFightingEff:SetActiveE(1)
        if not _G.AppSetting.IsXzns then
            self.toggles.afk.obj_icon:SetActiveE(0)
        end
    else
        self.afkFightingEff = 0
        _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_maoxianbtn,
                self.go_table.toggle_afk,
                function(trans)
                    if self:IsNil() then
                        _G.DestroyObject(trans)
                        return
                    end
                    local isShow = model:IsFighting()
                    self.afkFightingEff = trans
                    self.afkFightingEff:SetActiveE(isShow and 1 or 0)
                    if not _G.AppSetting.IsXzns then
                        self.toggles.afk.obj_icon:SetActiveE(isShow and 0 or 1)
                    end
                end
        )
    end
end

---更新Afk待机特效
function MainView:UpdateAfkIdelEffect()
    if self.afkIdelEff == 0 then
        --特效正在加载中
        return
    end
    --获取待机状态(未选中afk选项卡且未处于战斗中)
    local model = require("AfkBattleManager"):GetInstance()
    local isFighting = model:IsFighting() == true
    if _G.AppSetting.IsXzns then
        if _G.GuideManager:GetInstance().IsGuideing == true then
            --在引导中不显示
            return
        end
        --星座在爬塔时也不显示
        isFighting = isFighting or
                _G.DeadsoulTowerManager:GetInstance():IsFighting() or
                require("SecretRealmModel"):GetInstance():IsFighting()
    end
    local isShow = self.afkIdel and not self:IsToggled("afk") and not isFighting
    if not isShow then
        if self.afkIdelEff then
            self.afkIdelEff:SetActiveE(0)
        end
        return
    end

    local pass = require("AfkModel"):GetInstance():CheckNextSectionCondition()
    if not pass then
        if self.afkIdelEff then
            self.afkIdelEff:SetActiveE(0)
        end
        return
    end

    --显示特效
    if self.afkIdelEff then
        self.afkIdelEff:SetActiveE(1)
    else
        local cfg = _G.ConfigManager.ui_effect_cfg.ef_maoxiankonxian
        if AppSetting.IsXzns then
            cfg = _G.ConfigManager.ui_effect_cfg.Ef_yindaoshoushi_6
        end
        self.afkIdelEff = 0
        _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_maoxiankonxian,
                self.go_table.toggle_afk,
                function(trans)
                    if self:IsNil() then
                        _G.DestroyObject(trans)
                        return
                    end
                    local isShow = self.afkIdel and not self:IsToggled("afk") and not model:IsFighting()
                    self.afkIdelEff = trans
                    self.afkIdelEff:SetActiveE(isShow and 1 or 0)
                end
        )
    end
end

