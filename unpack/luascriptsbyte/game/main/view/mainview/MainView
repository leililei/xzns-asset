function MainView:OnClickToggle(go, isOn, key, call)
    local tb = self.toggles[key]
    if not isOn then
        --上一次切换标签还未来得及改变显示状态(call未调用), 直接清理并切换选中状态
        if self.befTog and self.befTog ~= tb then
            self:RefreshToggle(self.befTog, self.befTogCall, false)
            self:RefreshToggle(tb, nil, true)
        end
        if key == "sociaty" then
            local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SociatyJoinView.Name)
            if view then
                view:Close()
            end
        end

        if self.panelLeaveTime[key] == nil then
            self.panelLeaveTime[key] = 0 --开始关闭计时
        end
        self.befTog = tb
        self.befTogKey = key
        self.befTogCall = call
    else
        if unlockID[key] then
            if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(unlockID[key]) then
                local lockStr, tipsId = _G.FunctionManager:GetInstance():GetTipsStr(unlockID[key])
                _G.PopWindowManager:GetInstance():ShowAllTips(tipsId, lockStr)
                self:CancelToggled()
                return
            end
        end
        if key ~= "afk" and require("AfkBattleManager"):GetInstance():IsFighting() then
            --检查afk冒险后台战斗是否解锁
            if not self.unlockAfkBackground then
                self.unlockAfkBackground = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID
                                                                                                    .AfkBattleBackground)
                if not self.unlockAfkBackground then
                    local lockStr
                    local funopenCfg = _G.ConfigManager.function_open_cfg[_G.FunctionID.AfkBattleBackground]
                    local sectCfg = _G.ConfigManager.afk_cfg[funopenCfg.condition_type[1][2]]
                    if sectCfg then
                        lockStr = _G.LangUtil.GetLangPackValue(90028010139, sectCfg.chapter, sectCfg.section)
                    end
                    _G.PopWindowManager:GetInstance():ShowAllTips(45, lockStr)
                    self:CancelToggled()
                    return
                end
            end
            --检查是否处于特定关卡(关卡中战斗不允许切出)
            ---@type number[][]
            local afkLockCfg = _G.ConfigManager.discrete_cfg[119008]
            if afkLockCfg then
                local curSection = require("AfkModel"):GetInstance():GetCurSection()
                if _G.table.indexof(afkLockCfg[1], curSection) then
                    local afkCfg = _G.ConfigManager.afk_cfg[curSection]
                    _G.PopWindowManager:GetInstance():ShowAllTips(47)
                    self:CancelToggled()
                    return
                end
            end
        end
        if _G.AppSetting.IsXzns then
            if key ~= "wild" and require("SecretRealmModel"):GetInstance():IsFighting() then
                --检查大秘境后台战斗是否解锁
                if not self.unlockSecretRealmBackground then
                    local maxId = require("SecretRealmModel"):GetInstance():GetMaxSid()
                    local cfg = _G.ConfigManager.discrete_cfg[116134]
                    self.unlockSecretRealmBackground = cfg and maxId >= cfg[1][1]
                    if not self.unlockSecretRealmBackground then
                        local secretRealmCfg = cfg and _G.ConfigManager.secret_realm_cfg[cfg[1][1]]
                        local lockTipStr = _G.GetLangPackValue(90032800163, secretRealmCfg and secretRealmCfg.numb or 0)
                        _G.PopWindowManager:GetInstance():ShowAllTips(1020014, lockTipStr)
                        self:CancelToggled()
                        return
                    end
                end
            end
            if key == "sociaty" then
                _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, _G.ConfigManager.ui_cfg.SociatyMainView.audio)
            elseif key == "fort" then
                local musicid = _G.ConfigManager.season_cfg[require("SeasonModel"):GetInstance():GetCurSeasonId()].Audio
                if musicid == nil or musicid == 0 then
                    musicid = _G.ConfigManager.ui_cfg.MainView.audio
                end
                _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, musicid)
            else
                _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, _G.ConfigManager.ui_cfg.MainView.audio)
            end
            local color = self.diBgColors[key]
            if key == "sociaty" then
                local sociatySelf = require("SociatyModel"):GetInstance().SociatyRoleSelf
                if sociatySelf.uid == 0 then
                    color = self.diBgColors["sociaty_no"]
                end
            end
            if color then
                self.go_table.aorimage_diBg.color = _G.ColorTools.FormatColorByString(color)
            end
        end
        self:ShowAfkBox(key)

        self.curTog = tb
        self.curTogKey = key
        self.curTogCall = call
        self.panelLeaveTime[key] = nil --清理关闭计时

        if not self.panelInit[key] and call then
            call(
                    true,
                    function()
                        if self.curTogKey == key then
                            self:RefreshToggleGroup()
                            self:UpdateFloatMessages(false)
                        end
                    end
            )
        else
            if call then
                call(true)
            end
            self:RefreshToggleGroup()
            self:UpdateFloatMessages(false)
        end
    end
end

function MainView:ShowAfkBox(key)
    key = key or self.curTogKey
    local showAfkBox = require("AfkModel"):GetInstance():GetAfkAwardBoxStatus()
    local AfkBoxInPanelShow = key ~= "afk"
    if key == "wild" and self.inTower then
        AfkBoxInPanelShow = not self.inTower
    end
    if not self.afkAwardBoxEff then
        _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_fangzhibaoxiangqipao,
                self.go_table.obj_afkAwardBox,
                function(obj)
                    if self:IsNil() then
                        _G.UIUtils.RemoveEffect(obj)
                        return
                    end
                    obj:SetSiblingIndexE(0)
                    self.afkAwardBoxEff = obj
                    self.go_table.obj_afkAwardBox:SetActiveE(key ~= "afk" and showAfkBox and 1 or 0)
                end
        )
    else
        self.go_table.obj_afkAwardBox:SetActiveE(AfkBoxInPanelShow and showAfkBox and 1 or 0)
    end
end

---刷新表现层状态(切换toggleGroup选中状态显示)
function MainView:RefreshToggleGroup()
    if self.befTog and self.befTog ~= self.curTog then
        self:RefreshToggle(self.befTog, self.befTogCall, false)
        self.befTog = nil
        self.befKey = nil
        self.befTogCall = nil
    end

    self.curTog.aorimage_isOn:SetActiveE(1)
    self.curTog.aorimage_isOff:SetActiveE(0)
    self.panelLeaveTime[self.curTogKey] = nil

    if not _G.GuideManager:GetInstance().IsGuideing then
        _G.Events:GetInstance():Broadcast(_G.MianViewState.MainViewChangeTab)
    end
end

---刷新toggle选中状态显示
---@param callback function 回调函数
function MainView:RefreshToggle(tog, callback, isOn)
    tog.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tog.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if callback then
        callback(isOn)
    end
end

---判断当前是否选中目标页签
---@param key string 页签名
---@return boolean
function MainView:IsToggled(key)
    if _G.AppSetting.DEBUG and not self.toggleItem[key] then
        _G.LogError("MainView.IsToggled = 传参无效的页签: " .. key)
    end
    return self.curTogKey == key
end

---切换到目标页签
---@param key string 页签名
---@return void
function MainView:GotoToggle(key)
    ---@type UnityEngine.UI.Toggle
    local tog = self.toggleItem[key]
    if not tog then
        if _G.AppSetting.DEBUG then
            _G.LogError("MainView.GotoToggle = 传参无效的页签: " .. key)
        end
        return
    end

    --如果MainView被隐藏, 此时切换页签行为不一样: 需手动关闭之前的页签
    if self.curTogKey and self.curTogKey ~= key and self.gameObject:GetctiveInHierarchy() ~= 1 then
        local bTog = self.toggleItem[self.curTogKey]
        if bTog then
            bTog:SetIsOnWithoutNotify(false)
            bTog.onValueChanged:Invoke(false)
        end
    end

    --强制走当前toggle.isOn逻辑
    --tog:SetIsOnWithoutNotify(true)
    --tog.onValueChanged:Invoke(true)
    tog:SetIsOnWithoutNotify(false)
    tog.isOn = true
end

---获取窗口实例(如果未初始化或正在初始化, 返回nil)
---@param key string? 页签名(不传表示获取当前选择页签)
---@return Component|nil
function MainView:GetToggledWindow(key)
    if not key then
        key = self.curTogKey
    end
    if self.panelInit[key] ~= true then
        return nil
    end
    local panelLua = self.panelLua[key]
    if not panelLua or _G.IsNil(panelLua.gameObject) then
        return nil
    end
    return panelLua
end

---返回上一个选中的标签
---@return void
function MainView:BackBeforeToggle()
    if not self.befTogKey then
        return
    end
    self:GotoToggle(self.befTogKey)
end

---取消当前点击逻辑并返回上一个选项卡
---@private
---@return void
function MainView:CancelToggled()
    if not self.befTog then
        return
    end
    self.befTog.aorimage_isOn:SetActiveE(1)
    self.befTog.aorimage_isOff:SetActiveE(0)
    self.toggleItem[self.befTogKey]:SetIsOnWithoutNotify(true)
    self.curTogKey = self.befTogKey
    self.panelLeaveTime[self.befTogKey] = nil
    self.befTog = nil
end

function MainView:OnFort(isOn, callback)
    self.go_table.obj_fort:SetActiveE(isOn and 1 or 0)
    if not isOn then
        if callback then
            callback()
        end
        return
    else
        require("MallManager"):GetInstance():ReqMallData()
    end
    _G.Events:GetInstance():Broadcast(_G.eMainViewShow.Fort)
    if not self.panelInit.fort then
        self.panelInit.fort = 0
        _G.PoolsManager:GetInstance():Spawn(
                PanelPrefabs.fort,
                _G.ePoolType.UIItem,
                self.go_table.obj_fort,
                function(trans)
                    if not trans or trans:GetctiveInHierarchy() ~= 1 then
                        self.panelInit.fort = nil
                        _G.DestroyObject(trans)
                        if callback then
                            callback()
                        end
                        return
                    end
                    self.panelLua.fort = self:AddComponent(trans, require(PanelLuaFile.fort).New(trans))
                    self.panelInit.fort = true
                    if callback then
                        callback()
                    end
                end
        )
    end
end

function MainView:OnSociaty(isOn, callback)
    self.go_table.obj_sociaty:SetActiveE(isOn and 1 or 0)
    if self.panelLua.sociaty then
        self.panelLua.sociaty:ShowOrHideScene(isOn)
    end
    if not isOn then
        return
    end
    if callback then
        callback()
    end
    SociatyManager:GetInstance():SetParent(self.go_table.obj_sociaty)
    SociatyManager:GetInstance():EnterSociaty()
end

function MainView:OpenSociaty(childView)
    if AppSetting.IsXzns then
        PanelPrefabs.sociaty = ConfigManager.ui_cfg.SociatyMainView.PrefabPath
    end
    if not self.panelInit.sociaty then
        self.panelInit.sociaty = 0
        _G.PoolsManager:GetInstance():Spawn(
                PanelPrefabs.sociaty,
                _G.ePoolType.UIItem,
                self.go_table.obj_sociaty,
                function(trans)
                    if not trans or trans:GetctiveInHierarchy() ~= 1 then
                        self.panelInit.sociaty = nil
                        _G.DestroyObject(trans)
                        return
                    end
                    self.panelLua.sociaty = self:AddComponent(trans, require(PanelLuaFile.sociaty).New(trans))
                    self.panelInit.sociaty = true
                    if childView then
                        self:DoOpenWindow(childView)
                    end
                end
        )
    elseif childView then
        self:DoOpenWindow(childView)
    end
end

function MainView:OnWild(isOn, callback)
    ---@type DeadsoulTowerManager
    local towerManager = _G.DeadsoulTowerManager:GetInstance()
    local secretRealmModel = require("SecretRealmModel"):GetInstance()
    if towerManager:IsFighting() then
        towerManager:SetFightView(isOn and towerManager:IsShowFighting())
    elseif secretRealmModel:IsFighting() then
        secretRealmModel:SetFightView(isOn)
    end

    self.go_table.obj_wild:SetActiveE(isOn and 1 or 0)
    if not isOn then
        if callback then
            callback()
        end
        return
    end

    if self.panelInit.wild then
        if self.panelLua.wild then
            --面板已加载并初始化
            local isFighting = towerManager:IsFighting() and towerManager:IsShowFighting() or
                    secretRealmModel:IsFighting()
            self.panelLua.wild.gameObject:SetActiveE(isFighting and 0 or 1)
        end
        if callback then
            callback()
        end
        return
    end

    self.panelInit.wild = 0
    _G.PoolsManager:GetInstance():Spawn(
            PanelPrefabs.wild,
            _G.ePoolType.UIItem,
            self.go_table.obj_wild,
            function(trans)
                if not trans or trans:GetctiveInHierarchy() ~= 1 then
                    self.panelInit.wild = nil
                    _G.DestroyObject(trans)
                    if callback then
                        callback()
                    end
                    return
                end
                self.panelLua.wild = self:AddComponent(trans, require(PanelLuaFile.wild).New(trans))
                self.panelInit.wild = true

                if _G.AppSetting.IsXzns then
                    local isFighting = towerManager:IsFighting() and towerManager:IsShowFighting() or
                            secretRealmModel:IsFighting()
                    if isFighting then
                        self.panelLua.wild.gameObject:SetActiveE(0)
                    end
                else
                    if towerManager:IsFighting() and towerManager:IsShowFighting() then
                        self.panelLua.wild.gameObject:SetActiveE(0)
                    end
                end

                if callback then
                    callback()
                end
            end
    )
end

function MainView:OnCard(isOn, callback)
    self.go_table.obj_card:SetActiveE(isOn and 1 or 0)
    if not isOn then
        if callback then
            callback()
        end
        return
    end
    if not self.panelInit.card then
        self.panelInit.card = 0
        _G.PoolsManager:GetInstance():Spawn(
                PanelPrefabs.card,
                _G.ePoolType.UIItem,
                self.go_table.obj_card,
                function(trans)
                    if not trans or trans:GetctiveInHierarchy() ~= 1 then
                        self.panelInit.card = nil
                        _G.DestroyObject(trans)
                        if callback then
                            callback()
                        end
                        return
                    end
                    self.panelLua.card = self:AddComponent(trans, require(PanelLuaFile.card).New(trans))
                    self.panelInit.card = true
                    if self.clickToggleCall then
                        self.clickToggleCall()
                        self.clickToggleCall = nil
                    end
                    if callback then
                        callback()
                    end
                end
