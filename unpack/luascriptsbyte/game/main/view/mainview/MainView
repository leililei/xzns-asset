---刷新公会战图标
function MainView:UpdateSociatyIcon()
    self.toggles.sociaty.obj_drawIcon:SetActiveE(0)
    self.toggles.sociaty.obj_guessIcon:SetActiveE(0)

    --- 判断玩家是否加入公会
    if require("SociatyManager"):GetInstance():HasSociaty() then
        local SociatyModel = require "SociatyModel":GetInstance()
        local SociatyBattleModel = require "SociatyBattleModel":GetInstance()
        local SociatyBattleLeagueModel = require "SociatyBattleLeagueModel":GetInstance()
        local state = SociatyBattleModel:GetState()
        if not SociatyBattleLeagueModel.MainViewUpdate then
            SociatyBattleLeagueModel.MainViewUpdate = _G.handler(self, self.UpdateSociatyIcon)
        end
        local isShow = false
        if SociatyBattleModel.enemySociatyBattleData and SociatyBattleModel.mySociatyBattleData then
            if state == _G.SociatyBattleState.Battle then
                if SociatyModel:GetTargetActivityTimes(_G.ScoaityActivityType.SociatyBattle) > 0 then
                    isShow = require "SociatyBattleManager":GetInstance():CheckTime12()
                end
            end
        end

        local isShowLeague = false
        if SociatyBattleLeagueModel.IsLeagueOpen then
            if not self.LeagueModel then
                self.LeagueModel = SociatyBattleLeagueModel
            end
            if not self.LeagueGuessItem then
                self.LeagueGuessItem = _G.ConfigManager.guild_league_guess_cfg[1].gear[1][1]
            end
            state = self.LeagueModel:GetState()
            if self.LeagueModel.enemySociatyBattleData and self.LeagueModel.mySociatyBattleData then
                if state == _G.SociatyBattleLeagueState.Battle then
                    if SociatyModel:GetTargetActivityTimes(_G.ScoaityActivityType.SociatyBattleLeague) > 0 then
                        isShowLeague = require "SociatyBattleLeagueManager":GetInstance():CheckTime12()
                    end
                end
            end
            if state == _G.SociatyBattleLeagueState.Guess then
                local canGuess = self.LeagueModel:CheckCanGuess(0) or self.LeagueModel:CheckCanGuess(1)
                self.toggles.sociaty.obj_guessIcon:SetActiveE(canGuess and 1 or 0)
            end
        end

        local isJoin = SociatyBattleLeagueModel.IsJoin

        self.toggles.sociaty.obj_drawIcon:SetActiveE((isShow or (isShowLeague and isJoin)) and 1 or 0)
    end
end

