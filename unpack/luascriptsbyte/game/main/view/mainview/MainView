---刷新十连招募图标
function MainView:UpdateDrawIcon(data)
    if _G.IsNil(data) then
        local drawNormalCount = _G.StorageManager:GetInstance():GetItemCountBySid(203020100)
        local drawProCount = _G.StorageManager:GetInstance():GetItemCountBySid(203020200)
        self.toggles.fort.obj_drawIcon:SetActiveE((drawNormalCount >= 10 or drawProCount >= 10) and 1 or 0)
        if _G.PlayerPrefsManager.HasKey("PetDrawRedPoint") then
            local count = _G.PlayerPrefsManager.GetInt("PetDrawRedPoint") // 10
            local hasCount = _G.StorageManager:GetInstance():GetItemCountBySid(203120100) // 10
            if hasCount > count then
                _G.PlayerPrefsManager.DeleteKey("PetDrawRedPoint")
                require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.PetDraw.id)
            end
        end
    else
        for _, value in pairs(data) do
            local sid = value.type[1]
            if sid == 203020100 or sid == 203020200 then
                local drawNormalCount = _G.StorageManager:GetInstance():GetItemCountBySid(203020100)
                local drawProCount = _G.StorageManager:GetInstance():GetItemCountBySid(203020200)
                self.toggles.fort.obj_drawIcon:SetActiveE((drawNormalCount >= 10 or drawProCount >= 10) and 1 or 0)
            elseif sid == 203120100 then
                if _G.PlayerPrefsManager.HasKey("PetDrawRedPoint") then
                    local count = _G.PlayerPrefsManager.GetInt("PetDrawRedPoint") // 10
                    local hasCount = _G.StorageManager:GetInstance():GetItemCountBySid(203120100) // 10
                    if hasCount > count then
                        _G.PlayerPrefsManager.DeleteKey("PetDrawRedPoint")
                        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.PetDraw.id)
                    end
                end
            elseif self.LeagueGuessItem and sid == self.LeagueGuessItem and self.LeagueModel then
                if self.LeagueModel:GetState() == _G.SociatyBattleLeagueState.Guess then
                    local canGuess = self.LeagueModel:CheckCanGuess(0) or self.LeagueModel:CheckCanGuess(1)
                    self.toggles.sociaty.obj_guessIcon:SetActiveE(canGuess and 1 or 0)
                end
            end
        end
    end
end
