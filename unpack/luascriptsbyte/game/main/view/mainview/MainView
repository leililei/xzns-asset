    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.UpdateDrawIcon, self)
    _G.Events:GetInstance():AddListener(_G.eSociatyBattle.ScoiatyBattleChallengeNum, self.UpdateSociatyIcon, self)
