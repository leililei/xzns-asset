--region 关卡详情界面奖励
local SectionMapAwardItemClass = _G.BaseClass("SectionMapAwardItemClass")
function SectionMapAwardItemClass:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj)
end

---@class ChpaterTaskView : UIBaseView	中文描述
---@field public go_table ChpaterTaskView_GoTable GoTable
local ChpaterTaskView = _G.BaseClass("ChpaterTaskView", _G.UIBaseView)

local CS = _G.CS
local typeof = _G.typeof

local TaskCfg = _G.ConfigManager.task_cfg
function ChpaterTaskView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
local TaskState = {
    lock = 1,
    canExcute = 2,
    isClamiedButCantExcute = 3,
    completed = 4
}
---界面的入口函数
---@param sectioninfo MainManager.CurSectionTaskInfo 关卡信息
function ChpaterTaskView:OnCreate(sectioninfo)
    if not sectioninfo then
        self:Close()
    end
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.Close,
        ["@_aorbtn_BG"] = self.Close,
        ["@_aorbtn_DiaoCha"] = function(self, go, ison, tb)
            local task = _G.TaskModule:GetInstance():GetTaskWithID(tb.cfg.ID)
            _G.TaskModule:GetInstance():ExecuteTask(task)
            self:Close()
        end,
        ["@_aorbtn_Click"] = function(self, go)
            _G.PopWindowManager:GetInstance():ShowAllTips(110123)
        end,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    self.go_table.aortext_SectionName.text = _G.LangUtil.GetLangPackValue(sectioninfo.cfg.Name)
    self.curTaskDoingId = sectioninfo.curTaskDoingId
    self.SectionTaskList = sectioninfo.taskIds
    self.curIndex = sectioninfo.curTaskIndex
    self:ShowTask()
end
---显示奖励
function ChpaterTaskView:ShowTask()
    self.go_table.scrollloopvectical_TaskList:InitItemData(#self.SectionTaskList, _G.handler(self, self.FreshList))
    _G.DelayFrameDo(
        function()
            self.go_table.scrollloopvectical_TaskList:ScrollToIndex(self.curIndex)
        end
    )
end
function ChpaterTaskView:FreshList(index, obj)
    if index < 0 then
        return
    end
    local tb = _G.GetAutoGoTable(obj)
    _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickBtn, tb))
    local x = index + 1
    local cfg = TaskCfg[self.SectionTaskList[x]]
    local result = _G.TaskModule:GetInstance():IsCompletedTask(self.SectionTaskList[x])
    tb.result = result
    tb.cfg = cfg
    self:SetTask(tb)
end
function ChpaterTaskView:SetTask(tb)
    tb.aortext_Desc.text = _G.LangUtil.GetLangPackValue(tb.cfg.describe)
    self:SetTaskType(tb)
    _G.GameUtil.SetActiveByCondition(tb.aorbtn_DiaoCha, tb._type == TaskState.canExcute)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_TaskCompleted, tb._type == TaskState.completed)
    _G.GameUtil.SetActiveByCondition(tb.aortext_Tasking, tb._type == TaskState.isClamiedButCantExcute)
    _G.GameUtil.SetActiveByCondition(tb.obj_Mask, tb._type == TaskState.lock)
end
function ChpaterTaskView:SetTaskType(tb)
    local _type
    if tb.result then
        _type = TaskState.completed
    else
        local info = _G.TaskModule:GetInstance():GetTaskInfoWithID(tb.cfg.ID)
        if info then
            if info.state == _G.TaskEnum.ETaskState.Claimed or info.state == _G.TaskEnum.ETaskState.Completed then
                _type = self:CheckClaimedTaskIdisCurRoomTask(tb.cfg)
            end
        else
            _type = TaskState.lock
        end
    end
    tb._type = _type
end
---检测接取任务是否是在当前房间
---@param cfg table 任务cfg
function ChpaterTaskView:CheckClaimedTaskIdisCurRoomTask(cfg)
    local curWorldId = _G.WorldManager:GetInstance():GetCurWorldSid()
    if _G.table.isEmptyOrNil(cfg.TaskTracking[1]) then
        return TaskState.isClamiedButCantExcute
    else
        if cfg.TaskTracking[1][2] == curWorldId then
            return TaskState.canExcute
        else
            return TaskState.isClamiedButCantExcute
        end
    end
end
---按钮点击事件在这里派发
function ChpaterTaskView:OnClickBtn(go, isOn, tb)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, tb)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

return ChpaterTaskView
