---@class Mainview_Acquisition : Component	中文描述
local Mainview_Acquisition = _G.BaseClass("Mainview_Acquisition", _G.Component)

local CS = _G.CS
local typeof = _G.typeof

function Mainview_Acquisition:Awake()
    --- item实例
    self.itemList = {}
    --- 是否在创建中 防止未创建完就关闭界面 导致item异常生成
    self.isCreateIng = false

    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end
---创建对象时,入口构造函数
function Mainview_Acquisition:OnCreate()
    self:SetItemList()
end

function Mainview_Acquisition:Dispose()
    self.go_table = nil
    self.itemList = nil
end

function Mainview_Acquisition:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:ShowView(false)
    end
end

--region --------------------------------------按钮事件--------

--endregion

--region --------------------------------------逻辑函数--------
function Mainview_Acquisition:SetItemList()
    local award = _G.ChapterRoomManager:GetInstance():GetSectionAward()
    if not table.isEmptyOrNil(award) then
        local awardList = table.values(award)
        self:ShowAward(awardList)
    end
end

---显示奖励
function Mainview_Acquisition:ShowAward(awardList)
    self.itemList = {}

    self.isCreateIng = true

    local len = #awardList
    local count = 0
    for i = 1, len do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            awardList[i],
            self.go_table.obj_Content,
            function(item, data)
                if _G.StorageManager:GetInstance():CheckItemIsNew(awardList[i][1]) then
                    if item.ShowNew ~= nil then
                        item:ShowNew(true)
                    end
                    _G.StorageManager:GetInstance():SetItemIsNewState(awardList[i][1], false)
                end
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                table.insert(self.itemList, item)
                count = count + 1
                if count >= len then
                    self.isCreateIng = false
                end
            end
        )
    end
    self:StartTimer()
end

function Mainview_Acquisition:ShowView(isShow)
    --- item 生成中不允许开关
    if self.isCreateIng == true then
        return
    end
    self.gameObject:SetActiveE(isShow and 1 or 0)

    for i = #self.itemList, 1, -1 do
        require("ItemViewBase").Despawn(self.itemList[i])
    end
    self.itemList = {}
end

--endregion

---销毁对象时,析构函数
function Mainview_Acquisition:OnDestroy()
    self:StopTimer()
end

---防止创建失败,无法关闭界面  保底
function Mainview_Acquisition:StartTimer()
    self:StopTimer()
    self.timerr =
        _G.DelayDo(
        3,
        function()
            self.isCreateIng = false
        end
    )
end

function Mainview_Acquisition:StopTimer()
    if self.timerr ~= nil then
        _G.coroutine.stopwaiting(self.timerr)
        self.timerr = nil
    end
end

return Mainview_Acquisition
