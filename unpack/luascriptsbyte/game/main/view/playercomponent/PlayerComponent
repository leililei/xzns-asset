---@class PlayerComponent : Component
---@field public go_table PlayerComponent_GoTable 中文描述
local PlayerComponent = _G.BaseClass("PlayerComponent", _G.Component)

function PlayerComponent:Awake()
end

-- 启动
---@param parent Transform 对应父节点 起始位置
---@param ignoreClick boolean 是否忽略点击事件
function PlayerComponent:OnCreate(parent, ignoreClick)
    if _G.IsNil(parent) then
        if _G.AppSetting.DEBUG then
            _G.LogError(" PlayerComponent:OnCreate(  parent 参数有误")
        end
        return
    end
    self.parent = parent
    self.ignoreClick = ignoreClick
    self:CreatePlayer()
end

function PlayerComponent:CreatePlayer()
    local path = "UIH5/Common/$_obj_playerHead"
    if _G.AppSetting.IsXzns then
        path = "UIH5_xzns/Common/$_obj_playerHead"
    end
    _G.PoolsManager:GetInstance():Spawn(
            path,
            _G.ePoolType.Temporary,
            self.parent,
            function(tran)
                if self.parent == nil then
                    _G.PoolsManager:GetInstance():Despawn(tran, _G.ePoolType.Temporary)
                    return
                end
                self.headTrans = tran
                self.go_table = _G.GetAutoGoTable(tran, _G.handler(self, self.OnClickBtn))
                self:UpdatePlayerInfo()
                self:AddEvent()
                local canvas = self.go_table.gameObject:GetComponentE(_G.typeof(_G.Canvas))
                local item = self.go_table.gameObject:FindE("head"):FindE("levelBg")
                local canvas1 = item:GetComponentE(_G.typeof(_G.Canvas))
                canvas1.sortingOrder = canvas.sortingOrder + 10
            end
    )
end

function PlayerComponent:UpdatePlayerInfo()
    if self.go_table == nil then
        return
    end
    local offz = _G.TimeUtil.GetTimeZoneOff()
    --ZHJH5ZHJH-9457 【buglist】zhjh5多语言buglistZHJH-10705
    --【通用】{多语言}服务器时区为UTC-0时，比UTC-0快的时区前台不会显示时间
    if offz ~= 0 then
        self.go_table.aortext_utc:SetActiveE(1)
        self.go_table.aortext_utc.text = "UTC" .. _G.TimeUtil.GetRawServerTimeZone() .. " "
        if self.UTCTimer then
            self.UTCTimer:Stop()
            self.UTCTimer = nil
        end
        self.UTCTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.UTCTimer:Start()
        self:UpdateTime()
    else
        self.go_table.aortext_utc:SetActiveE(0)
    end
    self:UpdateName()
    self:UpdateVipLv()
    self:UpdateLevel()
    self:UpdatePower()
    self:UpdateStyle()
end

function PlayerComponent:UpdateTime()
    self.go_table.aortext_utctime.text = _G.TimeUtil.TransTimeUTC(_G.TimeUtil.GetServerUnixTime())
end

function PlayerComponent:UpdateName()
    self.go_table.aortext_name.text = _G.PlayerModel:GetInstance():GetName()
end

function PlayerComponent:UpdateVipLv()
    self.go_table.aortext_vipLv.text = require "VIPPrivilegeModel":GetInstance().currentVipLevel
end

function PlayerComponent:UpdateLevel()
    local nowLV = _G.PlayerModel:GetInstance():GetLevel()
    local nowExp = _G.PlayerModel:GetInstance().exp or 0
    local nowLvCfg = _G.ConfigManager.player_level_cfg[nowLV]
    local upExp = not _G.IsNil(nowLvCfg) and nowLvCfg.exp or nowExp
    if _G.AppSetting.IsXzns then
        nowLV = _G.LangUtil.GetLangPackValue(90033800028, nowLV)
    end
    self.go_table.aortext_level.text = nowLV
    self.go_table.slider_exp.value = nowExp / upExp
end

function PlayerComponent:UpdatePower()
    local power = _G.PlayerModel:GetInstance():GetCorePower()
    if power == nil or power == 0 then
        power = _G.StorageManager:GetInstance():GetPlayerPower()
    end
    local powerText = _G.UIUtils.NumberToUnitStr_CardFightNum(power, true)
    if _G.AppSetting.IsXzns then
        powerText = _G.UIUtils.NumberToUnitStr_CardFightNum(power, false)
    end
    self.go_table.aortext_power.text = powerText
end

function PlayerComponent:UpdateRole()
    local roleStyle = _G.PlayerModel:GetInstance().role_style
    if roleStyle then
        local cfg = _G.ConfigManager.player_portrait_cfg[roleStyle]
        if cfg then
            local index = self.go_table.aorrawimage_frame:GetSiblingIndexE()
            local index1 = self.go_table.aorimage_head:GetSiblingIndexE()
            local aorImage = self.go_table.aorimage_head:GetComponentE(_G.typeof(_G.CS.AorImage))
            if cfg.type_portrait == 2 then
                if index1 < index then
                    self.go_table.aorimage_head:SetSiblingIndexE(index)
                end
                aorImage.enabled = false
                if self.go_table.portrait ~= cfg.effect_portrait then
                    self.go_table.aorimage_head:ClearChildren()
                    self.go_table.portrait = cfg.effect_portrait
                    _G.UIUtils.LoadEffectTitleOrFrame(
                            cfg.effect_portrait,
                            self.go_table.aorimage_head,
                            function(trans)
                                if self.go_table.portrait ~= cfg.effect_portrait then
                                    trans:DestroyObject()
                                    return
                                end
                                local parClip = trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                                parClip.NeedCheck = true
                                parClip.CheckCount = 10
                                parClip.CheckOne = 3
                            end
                    )
                end
            else
                if index1 > index then
                    self.go_table.aorimage_head:SetSiblingIndexE(index)
                end
                self.go_table.aorimage_head:ClearChildren()
                aorImage.enabled = true
                self.go_table.aorimage_head.SpriteName = cfg.portrait1
            end
        end
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("role_style is nil")
        end
    end
end

function PlayerComponent:UpdateStyle()
    self:UpdateRole()
    self:UpdateFrame()
    self:UpdateTitle()
end

function PlayerComponent:UpdateFrame()
    local frame = _G.PlayerModel:GetInstance():GetCurFrame()
    if frame > 0 then
        local cfg = _G.ConfigManager.player_frame_cfg[frame]
        if not _G.IsNil(cfg) then
            _G.UIUtils.RemoveChildren(self.go_table.aorrawimage_frame)
            if cfg.type_title ~= 2 then
                self.go_table.aorrawimage_frame:LoadImage(cfg.frame)
            else
                self.go_table.aorrawimage_frame.color = _G.Color.New(1, 1, 1, 0)
                _G.UIUtils.LoadEffectTitleOrFrame(
                        cfg.frame,
                        self.go_table.aorrawimage_frame,
                        function(item)
                            item:SetLocalScale(0.85, 0.85, 1)
                        end
                )
            end
        end
    end
end

function PlayerComponent:SetCorePower(power)
    self.go_table.aortext_power.text = _G.UIUtils.NumberToUnitStr_CardFightNum(power, not _G.AppSetting.IsXzns)
end

function PlayerComponent:UpdateTitle()
    local titleData = _G.PlayerModel:GetInstance().title
    if titleData and titleData.sid > 0 then
        local player_title = _G.ConfigManager.player_title_effect_cfg[titleData.sid]
        local titleScale = 0.9
        if player_title.type_title == 1 then
            self.go_table.aorrawimage_title:LoadImage(player_title.title)
            self.go_table.aorrawimage_title:SetActiveE(1)
            self.go_table.aorrawimage_title:SetLocalScaleXYZ(0.29 * titleScale)
            self.go_table.obj_titleEffect:RemoveAllChildren()
            self.go_table.title = nil
        elseif player_title.type_title == 2 then
            if self.go_table.title ~= player_title.title then
                self.go_table.obj_titleEffect:RemoveAllChildren()
                self.go_table.title = player_title.title
                UIUtils.LoadEffectTitleOrFrame(
                        player_title.title,
                        self.go_table.obj_titleEffect,
                        function(trans)
                            if self.go_table.title ~= player_title.title then
                                trans:DestroyObject()
                                return
                            end
                            local parClip = trans:AddComponentE(typeof(CS.ParticleClipRect))
                            parClip.NeedCheck = true
                            parClip.CheckCount = 10
                            parClip.CheckOne = 3
                            trans:SetLocalScaleXYZ(titleScale)
                        end
                )
            end
            self.go_table.aorrawimage_title:SetActiveE(0)
        end
    else
        self.go_table.obj_titleEffect:RemoveAllChildren()
        self.go_table.aorrawimage_title:SetActiveE(0)
    end
end


