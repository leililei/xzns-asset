function PlayerComponent:AddEvent()
    -- self:AddListener(_G.GlobalEvents.PlayerPowerChange, self.UpdatePower)
    -- self:AddListener(_G.GlobalEvents.DelayUpdateAllCardProp, self.UpdatePower)
    -- self:AddListener(_G.eShenshiEvents.UpDataShenSHiBag, self.UpdatePower)
    self:AddListener(_G.ePlayerStatus.PlayerChangeExp, self.UpdateLevel)
    self:AddListener(_G.ePlayerStatus.PlayerUpLevel, self.UpdateLevel)
    self:AddListener(_G.ePlayerStatus.PlayerChangeIcon, self.UpdateRole)
    self:AddListener(_G.ePlayerStatus.PlayerUpVipLevel, self.UpdateVipLv)
    self:AddListener(_G.ePlayerStatus.PlayerChangeName, self.UpdateName)
    self:AddListener(_G.ePlayerStatus.PlayerChangeFrame, self.UpdateFrame)
    self:AddListener(_G.GlobalEvents.PlayerCorePowerSyn, self.SetCorePower)
    self:AddListener(_G.ePlayerStatus.PlayerChangeTitle, self.UpdateTitle)
end

function PlayerComponent:RemoveEvent()
    -- self:RemoveListener(_G.GlobalEvents.PlayerPowerChange, self.UpdatePower)
    -- self:RemoveListener(_G.GlobalEvents.DelayUpdateAllCardProp, self.UpdatePower)
    -- self:RemoveListener(_G.eShenshiEvents.UpDataShenSHiBag, self.UpdatePower)
    self:RemoveListener(_G.ePlayerStatus.PlayerChangeExp, self.UpdateLevel)
    self:RemoveListener(_G.ePlayerStatus.PlayerUpLevel, self.UpdateLevel)
    self:RemoveListener(_G.ePlayerStatus.PlayerChangeIcon, self.UpdateRole)
    self:RemoveListener(_G.ePlayerStatus.PlayerUpVipLevel, self.UpdateVipLv)
    self:RemoveListener(_G.ePlayerStatus.PlayerChangeName, self.UpdateName)
    self:RemoveListener(_G.ePlayerStatus.PlayerChangeFrame, self.UpdateFrame)
    self:RemoveListener(_G.GlobalEvents.PlayerCorePowerSyn, self.SetCorePower)
    self:RemoveListener(_G.ePlayerStatus.PlayerChangeTitle, self.UpdateTitle)
end

function PlayerComponent:OnClickBtn(go, isOn)
    if self.ignoreClick then
        return
    end
    if go == self.go_table.aorbtn_playerInfo then
        _G.SystemSettingManager:GetInstance():OpenView(_G.PlayerModel:GetInstance():GetPlayerUid())
    end
end

function PlayerComponent:Dispose()
    if self.UTCTimer then
        self.UTCTimer:Stop()
        self.UTCTimer = nil
    end
    self:RemoveEvent()
    _G.PoolsManager:GetInstance():Despawn(self.headTrans, _G.ePoolType.Temporary)
end

return PlayerComponent
