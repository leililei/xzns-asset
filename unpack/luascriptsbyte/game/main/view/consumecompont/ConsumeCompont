---@class ConsumeCompont : Component
---@field public go_table ResourceCompont_GoTable 中文描述
local ConsumeCompont = _G.BaseClass("ConsumeCompont", _G.Component)
local StorageManager = _G.StorageManager:GetInstance()

---  copy ResourceCompont   用于角色信息界面 显示资源消耗  (固定资源栏宽度 资源不足消耗 消耗数量显示红色)

function ConsumeCompont:Awake()
    ---资源item引用 复用 RsItem  默认isConsume类型不变
    self.transArr = {}

    --- 刷新后的资源
    self.NextRs = nil
    ---  当前正在加载创建资源
    self.NowLoadRs = nil

    ---@type DG.Tweening.Sequence
    self.mScoreSequence = _G.DOTween:Sequence()
    self.mScoreSequence:SetAutoKill(false)
    self:AddEvent()
end

---@field showNow boolean 默认false不显示当前资源数量  true(当前/消耗)
---@field textColorType number 文字颜色 _1黑字_44455C 2白字_D0D4EF
---@field lackRedNum boolean 星座中使用，用来标注缺少资源时，数字是否显示红色
---@class Params_ConsumeCompont

-- 启动
---@param parent Transform 对应父节点 起始位置
---@param rs ResPropID[] 要创建的资源类型 （从左往右） [[ResPropID,false(隐藏+号)],ResPropID,ResPropID  ]
---@param lyType number 是否是自行布局 1自行布局 2 只创建所有单个资源item
---@param pos UnityEngine.Vector3 坐标（选填）
---@param isConsume boolean 是否是消耗资源资源栏
---@param Data Params_ConsumeCompont 扩展参数
---@param call function 在资源框创建完成后回调
function ConsumeCompont:OnCreate(parent, rs, lyType, pos, isConsume, Data, call)
    --region --------------------------------------扩展参数--------

    self.textColor = _G.Color.New(81 / 255, 82 / 255, 104 / 255, 1)
    self.showNow = false
    if Data ~= nil then
        if Data.textColorType == 1 then
        elseif Data.textColorType == 2 then
            self.textColor = _G.Color.New(208 / 255, 212 / 255, 239 / 255, 1)
        elseif Data.textColorType == 3 then
            self.textColor = _G.Color.New(211 / 255, 215 / 255, 242 / 255, 1)
            self.fontSize = 18
        elseif Data.textColorType == 4 then
            self.textColor = _G.Color.New(1, 1, 1, 1)
        end
        if _G.AppSetting.IsXzns then
            self.textColor = _G.ColorTools.FormatColorByString("4d4f57")
        end
        if Data.showNow ~= nil then
            self.showNow = Data.showNow
        end
        if Data.GroupParam then
            self.GroupParam=Data.GroupParam
        end
        if Data.lackRedNum then
            self.lackRedNum = Data.lackRedNum
        end
    end

    --endregion------------------------------------扩展参数--------

    self.lyType = lyType or 1
    self.pos = pos or _G.Vector3.New(0, 0, 0)
    if _G.IsNil(parent) then
        if _G.AppSetting.DEBUG then
            _G.LogError(" ConsumeCompont:OnCreate(  parent 参数有误")
        end
        return
    end
    self.isConsume = isConsume
    self.parent = parent
    self.call = call
    self.AllRcConsume = {}
    self.AllRc = {}
    self:CreateItem(rs)
end

-- 解析参数
---@return table<table<StorageID,ResPropID,boolean>>  or nil
function ConsumeCompont:Pars_rs(rs)
    local rsDic = nil
    for key, rs_v in pairs(rs) do
        local respropid = nil
        local isShowAdd = true
        --- 消耗数量
        local Consume = 0
        --- 客户端 资源的 总量  客户端自己计算 ，不进入仓库
        local client_total = 0

        if type(rs_v) == "number" then
            respropid = rs_v
        elseif type(rs_v) == "table" and rs_v[1] > 0 then
            respropid = rs_v[1]
            isShowAdd = rs_v[2]
            Consume = rs_v[3]
            client_total = rs_v[4]
        else
            break
        end

        local _, StorageID = _G.StorageManager:GetInstance():CheckSidType(respropid)
        if StorageID ~= nil then
            if rsDic == nil then
                rsDic = {}
            end
            table.insert(rsDic, {StorageID, respropid, isShowAdd, Consume, client_total})
        end
    end
    return rsDic
end

function ConsumeCompont:CreateItem(rs)
    if _G.IsNil(rs) then
        rs = {
            _G.ResPropID.Coin,
            -- {_G.ResPropID.Coin, false},     -- 不显示 + 号
            _G.ResPropID.Diamond,
            _G.ResPropID.Stamina
        }
    end
    local rsDic = {}
    rsDic = self:Pars_rs(rs)
    if rsDic == nil then
        return
    end

    self.NowLoadRs = rs

    rsDic = table.reverseTable(rsDic)
    self.AllRcConsume = {}
    self.AllRc = {}

    if self.lyType == 1 then
        if _G.IsNil(self.CommonResource) then
            self:CreateItem_CommonResource(
                function(tran)
                    self:CreateItem_CommonRsItem(rsDic, self.RsCompont)
                    if self.call then
                        self.call(self.RsCompont)
                        self.call = nil
                    end
                end
            )
        else
            self:CreateItem_CommonRsItem(rsDic, self.RsCompont)
        end
    else
        self.CommonResource = self.parent
        self:CreateItem_CommonRsItem(rsDic, self.parent)
    end
end

function ConsumeCompont:CreateItem_CommonResource(call)
    local path = "UIH5/Common/CommonResource"

    if self.isConsume == true then
        if _G.AppSetting.IsXzns then
            path = "UIH5_xzns/Common/CommonResourceConsume"
        else
            path = "UIH5/Common/CommonResourceConsume"
        end
    end
    _G.PoolsManager:GetInstance():Spawn(
        path,
        _G.ePoolType.Temporary,
        self.parent,
        function(tran)
            if tran == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("ConsumeCompont:CreateItem_CommonResource  创建失败")
                end
                return
            end

            if self.transArr == nil then
                _G.PoolsManager:GetInstance():Despawn(tran, _G.ePoolType.Temporary)
                return
            end
            self.CommonResource = tran
            self.RsCompont = tran:GetChildE(0)
            if self.GroupParam  then
                local group=self.RsCompont:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.GridLayoutGroup))
                group.constraint=_G.CS.UnityEngine.UI.GridLayoutGroup.Constraint.FixedColumnCount
                group.constraintCount=self.GroupParam
            end
            if call ~= nil then
                call(tran)
            end
        end
    )
end

function ConsumeCompont:CreateItem_CommonRsItem(rsDic, Parent)
    local loadCount = 0
    local loadMaxCount = #rsDic

    local loadFun = function()
        loadCount = loadCount + 1
        if loadCount == loadMaxCount then
            self:LoadOver()
            return
        end
    end
    local path = "UIH5/Common/CommonRsItem"
    if self.isConsume == true then
        if _G.AppSetting.IsXzns then
            path = "UIH5_xzns/Common/CommonRsConsumeItemWidth"
        else
            path = "UIH5/Common/CommonRsConsumeItemWidth"
        end
    end

    --- 隐藏多余item  默认isConsume类型不变
    for i = #self.transArr, #rsDic + 1, -1 do
        local tran = self.transArr[i]
        if tran ~= nil then
            _G.GameUtil.SetActiveByCondition(tran.gameObject, false)
        end
    end
    local index = 1
    for _, v in _G.ipairs(rsDic) do
        local tran = self.transArr[index]
        if tran ~= nil then
            _G.GameUtil.SetActiveByCondition(tran.gameObject, true)
            self:SetRsItem(v, tran, loadFun)
        else
            _G.PoolsManager:GetInstance():Spawn(
                path,
                _G.ePoolType.Temporary,
                Parent,
                function(tran)
                    if tran == nil then
                        if _G.AppSetting.DEBUG then
                            _G.LogError("ConsumeCompont:CreateItem_CommonResource  创建失败")
                        end
                        return
                    end
                    if self.transArr == nil then
                        _G.PoolsManager:GetInstance():Despawn(tran, _G.ePoolType.Temporary)
                        return
                    end
                    table.insert(self.transArr, tran)
                    self:SetRsItem(v, tran, loadFun)
                end
            )
        end
        index = index + 1
    end
end

function ConsumeCompont:SetRsItem(v, tran, loadFun)
    if tran == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("ConsumeCompont:CreateItem_CommonRsItem  创建失败")
        end
    else
        local go_table = _G.GetAutoGoTable(tran, _G.handlerbind(self, self.OnClickBtn, v[1], v[2]))
        if table.isEmptyOrNil(self.AllRc[v[1]]) then
            self.AllRc[v[1]] = {}
        end
        if self.fontSize then
            go_table.aortext_num.fontSize = self.fontSize
        end
        go_table.aortext_num.color = self.textColor
        self.AllRc[v[1]][v[2]] = go_table
        local icon = _G.StorageManager:GetInstance():GetItemIcon(v[2])
        go_table.aorrawimage_icon:LoadImage(
            icon,
            function(image)
                if image ~= nil then
                    _G.GameUtil.SetActiveByCondition(image.gameObject, true)
                end
            end
        )

        _G.GameUtil.SetActiveByCondition(go_table.aorbtn_add.gameObject, true)
        self:UpdateRsNum(v)
    end
    loadFun()
end

---用于更新资源数量
---@param data  table
---@param isRoll  boolean true滚动数字 默认false
function ConsumeCompont:UpdateRsNum(data, isRoll)
    local StorageID = data[1]
    local sidOrUid = data[2]
    if _G.IsNil(self.AllRc[StorageID]) or _G.IsNil(self.AllRc[StorageID][sidOrUid]) then
        return
    end
    --TODO 资源齐后改为对应数据字段
    local itemValue = _G.StorageManager:GetInstance():GetItemCountByID(StorageID, sidOrUid)
    if data[5] ~= nil and data[5] ~= 0 then
        itemValue = data[5]
    else
        itemValue = _G.StorageManager:GetInstance():GetItemCountByID(StorageID, sidOrUid)
    end
    if isRoll then
        local mOldScore = _G.tonumber(self.AllRc[StorageID][sidOrUid].aortext_num.text) or 0
        local newScore = itemValue
        self:DigitalAnimation(data, mOldScore, newScore)
    else
        local tcountStr = self:NumberFormat(itemValue, sidOrUid)

        if self.isConsume then
            ---消耗
            local consumeValue = data[4]
            if consumeValue ~= nil then
                self.AllRcConsume[sidOrUid] = consumeValue
            elseif self.AllRcConsume[sidOrUid] ~= nil then
                consumeValue = self.AllRcConsume[sidOrUid]
            end

            if consumeValue ~= nil then
                if self.showNow == true then
                    if itemValue < consumeValue then
                        tcountStr = self:NumberFormat(itemValue, sidOrUid)
                        tcountStr = "<color=#E33F3f>" .. tcountStr .. "</color>"
                    else
                        tcountStr = self:NumberFormat(itemValue, sidOrUid)
                        if _G.AppSetting.IsXzns then
                            tcountStr = "<color=#3D3D4D>" .. tcountStr .. "</color>"
                        else
                            tcountStr = "<color=#519400>" .. tcountStr .. "</color>"
                        end
                    end
                    --- 消耗 （不足为红）  /  拥有
                    tcountStr = tcountStr .. "/" .. _G.GameUtil.NumberToUnitStr(consumeValue)
                else
                    if itemValue < consumeValue then
                        tcountStr = self:NumberFormat(consumeValue, sidOrUid)
                        tcountStr = "<color=#E33F3f>" .. tcountStr .. "</color>"
                    else
                        tcountStr = self:NumberFormat(consumeValue, sidOrUid)
                        if _G.AppSetting.IsXzns then
                            tcountStr = "<color=#3C3D4D>" .. tcountStr .. "</color>"
                        else
                            tcountStr = "<color=#519400>" .. tcountStr .. "</color>"
                        end
                    end
                    --- 拥有 （不足为红）
                    tcountStr = tcountStr
                end
            end
        end
        self.AllRc[StorageID][sidOrUid].aortext_num.text = tcountStr
    end
end

function ConsumeCompont:DigitalAnimation(data, mOldScore, newScore)
    if self.mScoreSequence == nil then
        return
    end
    self.mScoreSequence:Append(
        _G.DOTween.To(
            function(value)
                local str = _G.Mathf.Floor(value)
                str = self:NumberFormat(str, data[2])
                if self.AllRc[data[1]][data[2]] == nil then
                    return
                end
                self.AllRc[data[1]][data[2]].aortext_num.text = str
            end,
            mOldScore,
            newScore,
            0.4
        )
    )
end

---格式化最终文本   体力 0/200
function ConsumeCompont:NumberFormat(nowValue, key)
    local str = nowValue
    if key == _G.ResPropID.Stamina then
        str = nowValue .. "/200"
    else
        str = _G.GameUtil.NumberToUnitStr(nowValue)
    end
    return str
end

