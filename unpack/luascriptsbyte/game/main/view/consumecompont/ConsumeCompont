function ConsumeCompont:AddEvent()
    self:AddListener(_G.eItemUpdata.Updata, self.ResUpdata)
end

---@param data award.i_award_item[]
function ConsumeCompont:ResUpdata(data)
    for key, value in pairs(data) do
        -- body
        local type, storageId = _G.StorageManager:GetInstance():CheckSidType(value.type[1])

        self:UpdateRsNum({storageId, value.type[1]})
    end
end

function ConsumeCompont:RemoveEvent()
    self:RemoveListener(_G.eItemUpdata.Updata, self.ResUpdata)
end

