function ConsumeCompont:OnDestroy()
    self:RemoveEvent()
    for _, tran in _G.pairs(self.transArr) do
        _G.PoolsManager:GetInstance():Despawn(tran, _G.ePoolType.Temporary)
    end
    self.transArr = nil
    self.AllRcConsume = nil
    self.AllRc = nil
    if self.RsCompont then
        _G.PoolsManager:GetInstance():Despawn(self.RsCompont.gameObject, _G.ePoolType.Temporary)
    end
    self.RsCompont = nil
end

--- 加载完成 再换资源 防止因异步,对象多次创建
function ConsumeCompont:LoadOver()
    self.NowLoadRs = nil

    if self.NextRs == nil then
        if self.isConsume == true then
            self:UpdateContentSize()
        end
        return
    end

    local rs = _G.DeepCopy(self.NextRs)
    self.NextRs = nil
    self:CreateItem(rs)
end

--- 刷新资源显示
function ConsumeCompont:RestRs(rs)
    self.NextRs = rs
    if self.AllRc == nil or table.count(self.AllRc) == 0 then
        return
    end
    if self.NowLoadRs == nil then
        self:LoadOver()
    end
end

function ConsumeCompont:UpdateContentSize()
    self.AllObj = {}
    self.AllContentF = self.CommonResource:GetComponentsInChildren(typeof(CS.UnityEngine.UI.ContentSizeFitter))
    for i = 0, self.AllContentF.Length do
        if i < self.AllContentF.Length then
            local obj = self.AllContentF[i]
            _G.table.insert(self.AllObj, obj)
        end
    end
    local maxLength = 0
    for i = #self.AllObj, 1, -1 do
        GameUtil.ReBuildRTF(self.AllObj[i])
        local x, _ = self.AllObj[i]:GetRectTransformSize()
        if string.contains(tostring(self.AllObj[i]), "CommonRsConsumeItemWidth") then
            maxLength = math.max(maxLength, x)
        end
    end
    if maxLength > 300 then
        maxLength = 300
    end
    local content = self.AllObj[1]
    --ZHJH-11025 把水平布局组改为网格布局组，2个资源一行，以最长的资源为格子长度
    local gridLayout = content:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.GridLayoutGroup))
    gridLayout.enabled = true
    local size = gridLayout.cellSize
    size.x = maxLength
    gridLayout.cellSize = size
    CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(
            self.CommonResource:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    )
end

function ConsumeCompont:Dispose()
end

return ConsumeCompont
