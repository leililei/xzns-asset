        self.go_table.aorbtn_StartAdventure:SetActiveE(0)
        self.go_table.aorbtn_StopAdventure:SetActiveE(0)
    else
        self.go_table.aorbtn_StartAdventure:SetActiveE(1)
        if require("ChapterModel"):GetInstance():GetCurExploringSection() == self.sid then --当前正在探索的关卡
            self.go_table.aorbtn_StopAdventure:SetActiveE(1)
            --继续冒险
