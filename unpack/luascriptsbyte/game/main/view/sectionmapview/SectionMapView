---显示奖励
function SectionMapView:ShowAward()
    self.awardExploreList, self.awardBattleList =
        require("ChapterModel"):GetInstance():GetExploreAndBattleAward(self.sid)
    if self.awardExploreList == nil and self.awardBattleList == nil then
        return
    end
    self.itemDic = {}
    local function sortFunc(a, b)
        local dataA = _G.StorageManager:GetInstance():GetItemQuality(a[1])
        local dataB = _G.StorageManager:GetInstance():GetItemQuality(b[1])
        if dataA == dataB then
            return a[1] > b[1]
        else
            return dataA > dataB
        end
    end
    _G.table.sort(self.awardExploreList.award, sortFunc)
    _G.table.sort(self.awardExploreList.got, sortFunc)
    _G.table.sort(self.awardBattleList.award, sortFunc)
    _G.table.sort(self.awardBattleList.got, sortFunc)
end

function SectionMapView:CheckRoomProgress()
    if _G.table.isEmptyOrNil(self.Sections) or self.IsSection == false then
        return
    end
    local cur = 0
    local all = 0
    for i, v in pairs(self.Sections) do
        if not _G.IsNil(v) then
            if self:CheckRoomDone(i) then
                cur = cur + 1
            end
        end
        all = all + 1
    end
    self.CurProgress = cur
    self.AllProgress = all
end

function SectionMapView:CheckRoomDone(id)
    local cfg = _G.ConfigManager.main_room_cfg[id]
    for i = 1, #cfg.battle_serial do
        if not require("ChapterModel"):GetInstance():CheckMonsterGroupFight(cfg.battle_serial[i]) then
            return false
        end
    end

    for i = 1, #cfg.task_id do
        if not _G.TaskModule:GetInstance().RoomFinishTask[cfg.task_id[i]] then
            return false
        end
    end

    local objectCfg
    for i = 1, #cfg.BoxID do
        objectCfg = _G.ConfigManager.object_world_cfg[cfg.BoxID[i]]
        if _G.tonumber(objectCfg.Type2) == 1 then --普通宝箱
            if not _G.WorldItemManager:GetInstance():GetInteractionBySid(cfg.BoxID[i]) then
                return false
            end
        end
    end
    return true
end

---显示当前奖励
function SectionMapView:ShowCurAwardItems()
    _G.UIUtils.RemoveChildren(self.go_table.obj_ItemContent)
    local NowItems = _G.DeepCopyCfgTable(self.cfg.reward_section)
    local objnornum = {
        self.go_table.aortext_Active_num1,
        self.go_table.aortext_Active_num2,
        self.go_table.aortext_Active_num3,
        self.go_table.aortext_Active_num4
    }
    local objnorbg = {
        self.go_table.aorimage_bg1,
        self.go_table.aorimage_bg2,
        self.go_table.aorimage_bg3,
        self.go_table.aorimage_bg4
    }
    local canGetNum = 0
    for i = 1, #NowItems do
        local info = NowItems[i]
        local num = info[2]
        -- for j = 1, #self.cfg.rooms do
        --     if j / #self.cfg.rooms >= i / #NowItems then
        --         objnornum[i].text = self.cfg.Section_order .. "-" .. j
        --         break
        --     end
        -- end
        objnornum[i].text = string.format("%.0f", i / 4 * 100) .. "%"
        _G.StorageManager:GetInstance():GetItemBaseView(
            info[1],
            num,
            self.go_table.obj_ItemContent,
            function(item)
                local isGet = ChapterModel:GetInstance():CheckIsGetSectionAward(self.cfg.id, i)
                item:SetGou(isGet)
                item.gameObject:SetLocalScaleXYZ(0.8)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)

                if isGet then
                    objnorbg[i].SpriteName = "ui_qrmb_jf_jdt_jd_02"
                    objnornum[i].text = ""
                end
                if not isGet then
                    if self.CurProgress / self.AllProgress >= i / 4 then
                        objnorbg[i].SpriteName = "ui_qrmb_jf_jdt_jd_01"
                        item:ShowEffectOrder(true)
                        canGetNum = i
                    else
                        objnorbg[i].SpriteName = "ui_qrmb_jf_jdt_jd_03"
                    end
                end
            end,
            function()
                --LogError("副本地图展示界面点击奖励")
                if canGetNum > 0 then
                    ChapterModel:GetInstance():GetSectionAward(
                        self.cfg.id,
                        canGetNum,
                        function()
                            self:CheckRoomProgress()
                            self:ShowCurAwardItems()
                        end
                    )
                end
            end
        )
    end

    self.go_table.slider_awardprogress.value = self.CurProgress / self.AllProgress
end

