function SectionMapView:SetArrowPos()
    if not self.ArrowEff then
        return
    end
    local targetRoomSid = require("SectionMiniMapManager"):GetInstance():GetTaskRoomID()
    if not targetRoomSid or targetRoomSid == 0 then
        self.ArrowEff:SetActiveE(0)
        return
    end
    if not self.Sections[targetRoomSid] then
        return
    end
    local line = _G.CS.Medvedya.GeometryMath.Line
    local x, y, x1, y1
    local a1, a2, b1, b2, b3, b4
    local targetPos = (self.Sections[targetRoomSid])
    x, y = targetPos:GetAnchorPosition()
    x1, y1 = targetPos:GetRectTransformSizeDelta()
    targetPos = {x = x + x1 * 0.5, y = y - y1 * 0.5}
    x, y = self.content:GetAnchorPosition()
    local tmpPos = {x = x + targetPos.x, y = y + targetPos.y}
    x, y = self.ShowRect:GetRectTransformSizeDelta()
    if (tmpPos.x > 0 and tmpPos.x < x) and (tmpPos.y < 0 and tmpPos.y > -y) then
        self.ArrowEff:SetActiveE(0)
        return
    end

    ---房间坐标 + 自身size（+x,-y） + content坐标 = 房间中心在显示区域的坐标
    a1 = (self.Sections[self.CurRoomSid])
    x, y = a1:GetAnchorPosition()
    x1, y1 = a1:GetRectTransformSizeDelta()
    a1 = {x = x + x1 * 0.5, y = y - y1 * 0.5}
    x, y = self.content:GetAnchorPosition()
    a1 = {x = a1.x + x, y = a1.y + y}
    a2 = (self.Sections[targetRoomSid])
    x, y = a2:GetAnchorPosition()
    x1, y1 = a2:GetRectTransformSizeDelta()
    a2 = {x = x + x1 * 0.5, y = y - y1 * 0.5}
    x, y = self.content:GetAnchorPosition()
    a2 = {x = a2.x + x, y = a2.y + y}
    ---以左上角为0,0点记录四个角的坐标
    b1 = {x = 0, y = 0} ---左上
    x = self.ShowRect:GetRectTransformSizeDelta()
    b2 = {x = x, y = 0} ---右上
    x, y = self.ShowRect:GetRectTransformSizeDelta()
    b3 = {x = x, y = y} ---右下
    b4 = {x = 0, y = -y} ---左下
    local pointx, pointy
    local bl = false
    ---判断是否有交点
    bl, pointx, pointy = line.intersection(a1.x, a1.y, a2.x, a2.y, b1.x, b1.y, b2.x, b2.y)
    if not bl then
        bl, pointx, pointy = line.intersection(a1.x, a1.y, a2.x, a2.y, b2.x, b2.y, b3.x, b3.y)
        if not bl then
            bl, pointx, pointy = line.intersection(a1.x, a1.y, a2.x, a2.y, b3.x, b3.y, b4.x, b4.y)
            if not bl then
                bl, pointx, pointy = line.intersection(a1.x, a1.y, a2.x, a2.y, b4.x, b4.y, b1.x, b1.y)
            end
        end
    end

    if bl then
        self.ArrowEff:SetActiveE(1)
        x, y = self.ShowRect:GetRectTransformSizeDelta()
        self.ArrowEff:SetAnchorPosition(pointx - x * 0.5, pointy + y * 0.5)
        local a3 = a2 - a1
        local euler = _G.math.atan(a3.y / a3.x) / _G.math.pi * 180
        if a3.x > 0 then
            euler = euler + 90
        else
            euler = euler - 90
        end

        self.ArrowEff:SetLocalEulerAngles(0, 0, euler)
    else
        self.ArrowEff:SetActiveE(0)
    end
end

---当去激活时
function SectionMapView:OnDisable()
    if self.Scroll then
        self.Scroll.onValueChanged:RemoveListener(_G.handler(self, self.SetArrowPos))
    end
end

---按钮点击事件在这里派发
function SectionMapView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_BG then
        self.go_table.obj_MiniMap:SetActiveE(0)
        if self.Anim then
            self.Anim:Play("a_SectionMapView_guanbi")
        end
        _G.DelayDo(
            0.5,
            function()
                self:Close()
            end
        )
    elseif go == self.go_table.aorbtn_StartAdventure then
        local curexploreid = require("ChapterModel"):GetInstance():GetCurExploringSection()
        if curexploreid ~= 0 and self.sid ~= curexploreid then --开启新的冒险
            _G.PopWindowManager:GetInstance():ShowAllTips(110110, nil, _G.handler(self, self.EnterSection))
        else --继续冒险
            self:EnterSection()
        end
    elseif go == self.go_table.aorbtn_StopAdventure then
        _G.PopWindowManager:GetInstance():ShowAllTips(110109, nil, _G.handler(self, self.ResetSection))
    elseif go == self.go_table.aorbtn_Explore then
        _G.PopWindowManager:GetInstance():ShowTableList(110121, nil, self.awardExploreList)
    elseif go == self.go_table.aorbtn_Battle then
        _G.PopWindowManager:GetInstance():ShowTableList(110122, nil, self.awardBattleList)
    end
end
---重置关卡
function SectionMapView:ResetSection()
    require("ChapterModel"):GetInstance():ResetSection(self.sid, _G.handler(self, self.InitBtns))
end
---进入关卡
function SectionMapView:EnterSection()
    local ChapterModel = require("ChapterModel"):GetInstance()
    ChapterModel:SetChooseSection(self.sid)
    ChapterModel:EnterSection(
        function(join)
            if join then
                self:Close()
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SelectSectionMapNewView.Name)
                _G.ChapterRoomManager:GetInstance():JoinSection(self.sid)
            end
        end
    )
end

return SectionMapView
