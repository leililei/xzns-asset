        self.go_table.aorimage_BattleGindu.fillAmount = 0
    else
        if BattleNum < BattleCount then
            str = "<color=#b23939>%d</color>/%d"
            self.go_table.aortext_BttleText.text = string.format(str, BattleNum, BattleCount)
            self.go_table.aorimage_BattleGindu.fillAmount = BattleNum / BattleCount
        else
