---居中整体房间
function SectionMapView:SetMidAllRoom()
    --修正地图与content相对位置
    local offPos = {
        x = 0 - self.OffX,
        y = 0 - self.OffY
    }
    local x, y
    for _, v in pairs(self.Sections) do
        x, y = v.rectTrans:GetAnchorPosition()
        v.rectTrans:SetAnchorPosition(x + offPos.x, y + offPos.y)
    end
    local CurX, CurY = self.Sections[self.CurRoomSid].rectTrans:GetAnchorPosition()
    self:SetMidAllRoomByCurPos(CurX, CurY)
end

---居中整体房间
function SectionMapView:SetMidAllRoomByCurPos(x, y)
    --修正地图与content相对位置
    local offPos = {
        x = 0 - x,
        y = 0 - y
    }
    local ContentX, ContentY = self.go_table.obj_MapContent:GetAnchorPosition()
    self.go_table.obj_MapContent:SetAnchorPosition(ContentX + offPos.x, ContentY + offPos.y)
end

--递归创建所有的关卡
function SectionMapView:CreateAllSection(RoomCfg)
    if RoomCfg == nil then
        return
    end
    local Section = self.Sections[RoomCfg.id]
    local Rect = self.Sections[RoomCfg.id].rectTrans
    local x, y = Rect:GetAnchorPosition()
    local CurPos = {x = x, y = y}
    x, y = Rect:GetRectTransformSizeDelta()
    local CurView = {x = x, y = y}
    _G.GameUtil.SetActiveByCondition(Section.aorimage_FindRoom, not self.isRoom and self.isPass)
    if RoomCfg.LeftRoom ~= 0 then
        self:SetFindRoomByPass(Section.aorimage_Left)
        if self.Sections[RoomCfg.LeftRoom] == nil then
            self:SetSection(RoomCfg.LeftRoom, {x = CurPos.x - CurView.x + self.LeftRightOff, y = CurPos.y})
        end
    end
    if RoomCfg.RightRoom ~= 0 then
        self:SetFindRoomByPass(Section.aorimage_Right)
        if self.Sections[RoomCfg.RightRoom] == nil then
            self:SetSection(RoomCfg.RightRoom, {x = CurPos.x + CurView.x - self.LeftRightOff, y = CurPos.y})
        end
    end
    if RoomCfg.UpRoom ~= 0 then
        self:SetFindRoomByPass(Section.aorimage_Top)
        if self.Sections[RoomCfg.UpRoom] == nil then
            self:SetSection(RoomCfg.UpRoom, {x = CurPos.x, y = CurPos.y + CurView.y - self.UPDownOff})
        end
    end
    if RoomCfg.DownRoom ~= 0 then
        self:SetFindRoomByPass(Section.aorimage_Down)
        if self.Sections[RoomCfg.DownRoom] == nil then
            self:SetSection(RoomCfg.DownRoom, {x = CurPos.x, y = CurPos.y - CurView.y + self.UPDownOff})
        end
    end
end
function SectionMapView:SetFindRoomByPass(tb)
    tb:SetActiveE(1)
    if self.isRoom then
        return
    end
    if not self.isPass then
        return
    end
    tb.SpriteName = yidaIcon
end
---创建设置初始化关卡
function SectionMapView:SetSection(sid, pos)
    _G.PoolsManager:GetInstance():Spawn(
        SectionPerfab,
        _G.ePoolType.UIItem,
        self.content,
        function(tran)
            if tran then
                self:SetSectionInfo(tran, pos, sid)
                self:CreateAllSection(_G.ConfigManager.main_room_cfg[sid])
            end
        end
    )
end

function SectionMapView:SetSectionInfo(tran, pos, sid)
    local rectTrans = tran:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    rectTrans:SetAnchorPosition(pos.x, pos.y)
    local tb = _G.GetAutoGoTable(tran)
    local cfg = _G.ConfigManager.main_room_cfg[sid]
    self.Sections[sid] = tb
    self.Sections[sid].rectTrans = rectTrans
    tb.aortext_RoomName.text = GetLangPackValue(cfg.Name)
    tb.aortext_RoomName.color = _G.ColorTools.FormatColorByString(cfg.Type1 == 3 and "c4c4dd" or "515268")

    if self.isRoom then
        _G.GameUtil.SetActiveByCondition(tb.aorimage_CurGuang, sid == self.CurRoomSid)
        _G.GameUtil.SetActiveByCondition(tb.aorimage_CurRoom, sid == self.CurRoomSid)
        _G.GameUtil.SetActiveByCondition(tb.obj_CurEff, sid == self.CurRoomSid)
        if not self.go_table.obj_ScrollView:GetComponentE(_G.typeof(_G.CS.ParticleClipRect)) then
            self.go_table.obj_ScrollView:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
        end
    end
    _G.GameUtil.SetActiveByCondition(tb.obj_normal, cfg.Type1 ~= 3)
    _G.GameUtil.SetActiveByCondition(tb.obj_boss, cfg.Type1 == 3)
end

---场景交换的更新
function SectionMapView:OnUpdate()
    self:CheckRoomProgress()
    self:ShowCurAwardItems()
    local world = _G.WorldManager:GetInstance():GetCurWorld()
    if world.Cfg.Scene_Type ~= _G.SceneType.Section then
        return
    end
    self.CurRoomSid = _G.ChapterRoomManager:GetInstance():GetCurRoomID()
    if self.Sections[self.CurRoomSid] ~= nil then
        self:SetMidCurRoom()
    end
    self:UpdateInfo()
end

---更新小地图显示信息
function SectionMapView:UpdateInfo(PassRoomCount)
    if table.isEmptyOrNil(self.Sections) or self.IsSection == false then
        return
    end
    local cfg = _G.ConfigManager.main_room_cfg
    local info
    local states
    if self.isRoom then
        for i, v in pairs(self.Sections) do
            if not _G.IsNil(v) then
                if _G.ChapterRoomManager:GetInstance():CheckEmptyRoomEnter(i) then
                    v.aorimage_FindRoom:SetActiveE(1)
                    _G.GameUtil.SetActiveByCondition(v.aorimage_CurGuang, self.CurRoomSid == i)
                    _G.GameUtil.SetActiveByCondition(v.aorimage_CurRoom, self.CurRoomSid == i)
                    _G.GameUtil.SetActiveByCondition(v.obj_CurEff, self.CurRoomSid == i)
                    if not self.go_table.obj_ScrollView:GetComponentE(_G.typeof(_G.CS.ParticleClipRect)) then
                        self.go_table.obj_ScrollView:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                    end
                else
                    v.aorimage_FindRoom:SetActiveE(0)
                end
                if cfg[i].UpRoom ~= 0 and _G.ChapterRoomManager:GetInstance():CheckRoomEnter(cfg[i].UpRoom) then
                    v.aorimage_Top:SetActiveE(1)
                    v.aorimage_Top.SpriteName = yidaIcon
                end
                if cfg[i].DownRoom ~= 0 and _G.ChapterRoomManager:GetInstance():CheckRoomEnter(cfg[i].DownRoom) then
                    v.aorimage_Down:SetActiveE(1)
                    v.aorimage_Down.SpriteName = yidaIcon
                end
                if cfg[i].LeftRoom ~= 0 and _G.ChapterRoomManager:GetInstance():CheckRoomEnter(cfg[i].LeftRoom) then
                    v.aorimage_Left:SetActiveE(1)
                    v.aorimage_Left.SpriteName = yidaIcon
                end
                if cfg[i].RightRoom ~= 0 and _G.ChapterRoomManager:GetInstance():CheckRoomEnter(cfg[i].RightRoom) then
                    v.aorimage_Right:SetActiveE(1)
                    v.aorimage_Right.SpriteName = yidaIcon
                end
            end
        end
    end
end

