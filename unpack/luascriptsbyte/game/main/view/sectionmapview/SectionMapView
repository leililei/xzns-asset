local SectionPerfab = "UI/MainView/MiniSection"

---创建关卡
function SectionMapView:CreateSection()
    self.content = self.go_table.obj_MapContent:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    self.Sections = {}
    self.CurRoomSid = self.cfg.rooms[1]
    self.ShowRect = self.go_table.obj_MiniMap:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    self.PassRoom = {}
    table.insert(self.PassRoom, self.CurRoomSid)
    self.Scroll = self.go_table.obj_ScrollView:GetComponentE(typeof(_G.CS.UnityEngine.UI.ScrollRect))
    _G.PoolsManager:GetInstance():Spawn(
        SectionPerfab,
        _G.ePoolType.UIItem,
        self.content,
        _G.handler(self, self.InnerCreate)
    )
end

---设置一些属性
function SectionMapView:InnerCreate(tran)
    if tran == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("Path is error : " .. SectionPerfab)
        end
        return
    end
    self.Sections[self.CurRoomSid] = _G.GetAutoGoTable(tran)
    local rectTrans = tran:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    rectTrans:SetAnchorPosition(0, 0)
    local x, y = rectTrans:GetAnchorPosition()
    self:SetSectionInfo(tran, {x = x, y = y}, self.CurRoomSid)
    self.Sections[self.CurRoomSid].rectTrans = rectTrans
    if self.isRoom == 1 then
        self.Sections[self.CurRoomSid].aoriamge_CurRoom:SetActiveE(1)
        self.Sections[self.CurRoomSid].aoriamge_CurGuang:SetActiveE(1)
    end
    local tmp = self.Sections[self.CurRoomSid].aorimage_Left:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    local tmp2 = self.Sections[self.CurRoomSid].aorimage_Top:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    x, self.LeftRightOff = tmp:GetRectTransformSizeDelta()
    x, self.UPDownOff = tmp2:GetRectTransformSizeDelta()

    --递归创建所有的关卡
    self:CreateAllSection(_G.ConfigManager.main_room_cfg[self.CurRoomSid])
    --结束后设置大小
    local x, y = self.Sections[self.CurRoomSid].rectTrans:GetAnchorPosition()
    local maxX = x
    local maxY = y
    local miniX = x
    local miniY = y
    for _, v in pairs(self.Sections) do
        if v ~= nil then
            x, y = v.rectTrans:GetAnchorPosition()
            if x > maxX then
                maxX = x
            end
            if y > maxY then
                maxY = y
            end
            if x < miniX then
                miniX = x
            end
            if y < miniY then
                miniY = y
            end
        end
    end
    --以上定下content宽高
    --更改后大小记录下来
    if maxX + miniX > 0 then
        self.OffX = maxX - (maxX - miniX) * 0.5
    elseif maxX + miniX == 0 then
        self.OffX = 0
    else
        self.OffX = miniX + (maxX - miniX) * 0.5
    end
    if maxY + miniY > 0 then
        self.OffY = maxY - (maxY - miniY) * 0.5
    elseif maxY + miniY == 0 then
        self.OffY = 0
    else
        self.OffY = miniY + (maxY - miniY) * 0.5
    end
    self.roomSizeX, self.roomSizeY = self.Sections[self.CurRoomSid].rectTrans:GetRectTransformSizeDelta()
    self.contentSizeX = self.roomSizeX + maxX - miniX
    self.contentSizeY = self.roomSizeY + maxY - miniY
    self.content:SetRectTransformSize(self.contentSizeX, self.contentSizeY)
    self:SetMidAllRoom()
    self:OnUpdate()
    self.Scroll.onValueChanged:AddListener(_G.handler(self, self.SetArrowPos))
end

