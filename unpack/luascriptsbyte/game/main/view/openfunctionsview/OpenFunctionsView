---@class OpenFunctionsView : UIBaseView
---@field public go_table OpenFunctionsView_GoTable 中文描述
local OpenFunctionsView = _G.BaseClass("OpenFunctionsView", _G.UIBaseView)
local PlayStory = 11 --主线剧情前往特殊处理
local StoryId = 800010842 --剧情id
function OpenFunctionsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.aorimage_icon.Alpha = 0
    _G.AudioManager.PlayAudioByAudioCfgID(2048)
end

-- 启动
function OpenFunctionsView:OnCreate(functionData)
    if _G.IsNil(functionData) then
        self:CloseView()
        return
    end
    self.functionData = functionData
    self.items = {}
    self:InitView()
end

---初始界面
function OpenFunctionsView:InitView()
    local function_open_cfg = _G.ConfigManager.function_open_cfg
    --- 排序显示
    _G.SortList(
        self.functionData.functions,
        function(a)
            local id = a
            return -id
        end
    )
    local id = self.functionData.functions[1]
    local cfg = function_open_cfg[tonumber(id)]

    self.go_table.aorimage_icon.Alpha = 0
    if cfg ~= nil or _G.string.IsNullOrEmpty(cfg.icon) == false then
        self.go_table.aorimage_icon.SpriteName = cfg.icon
        self.go_table.aorimage_icon:SetNativeSize()
        self.go_table.aorimage_icon.Alpha = 1
        self.go_table.aortext_descb.text = _G.LangUtil.GetLangPackValue(cfg.name)

        -- if cfg.Id == PlayStory then
        --     self.link = cfg.Id
        -- else
        --     if cfg.link == 0 then
        --         self.go_table.aorbtn_btn_go:SetActiveE(0)
        --     else
        --         self.link = cfg.link
        --     end
        -- end
    end
    local mainvctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name)
    if mainvctrl ~= nil then
        mainvctrl:InitFunctions()
    end
end

--自动关闭界面
function OpenFunctionsView:coroutineClose()
    _G.coroutine.waitforseconds(3)
    self:CloseView()
end

--关闭界面
function OpenFunctionsView:CloseView()
    if self.StopcoroutineClose ~= nil then
        _G.coroutine.stopwaiting(self.StopcoroutineClose)
        self.StopcoroutineClose = nil
    end
    self:Close()
end

-- 按钮单击事件--
