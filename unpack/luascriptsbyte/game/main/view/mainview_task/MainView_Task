---销毁对象时,析构函数
function MainView_Task:OnDestroy()
    _G.TaskModule:GetInstance():RemoveListener(
        _G.TaskModuleEvent,
        _G.TaskModuleEvent.EnumValueTable.TaskInfoUpdate,
        self.OnTaskInfoUpdate,
        self
    )
    _G.TaskModule:GetInstance():RemoveListener(
        _G.TaskModuleEvent,
        _G.TaskModuleEvent.EnumValueTable.TaskNumberUpdate,
        self.OnTaskNumberUpdate,
        self
    )
    _G.Events:GetInstance():RemoveListener(_G.eAfkEvents.Pass, self.InitChapterRaward, self)
    self:StopRefreshTaskView()
end

