function MainView_Task:InitChapterRaward()
    if self:IsDel() then
        return
    end
    local AfkTaskModel = require("AfkTaskModel"):GetInstance()
    local isShow = false
    self.canTakeSid = AfkTaskModel:GetCurSection()

    if _G.AppSetting.DEBUG then
        _G.Log(self.canTakeSid, "当前可领取的章节奖励id")
    end
    local sid
    if self.canTakeSid > 0 then
        sid = self.canTakeSid
        if not self.LoadAwardEffect then
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_ItemCardAllView,
                self.go_table.trans_effectRoot,
                function(trans)
                    self.effect = trans
                    trans:SetAnchorPosition(0, 0, 0)
                end
            )
            self.LoadAwardEffect = true
        end
    else
        sid = AfkTaskModel:GetNextAwardSection()
    end
    if self.effect then
        _G.GameUtil.SetActiveByCondition(self.effect, self.canTakeSid > 0)
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_Click, self.canTakeSid > 0)
    _G.GameUtil.SetActiveByCondition(self.go_table.trans_effectRoot, self.canTakeSid > 0)
    local cfg = _G.ConfigManager.afk_stage_cfg[sid]
    if cfg then
        if self.canTakeSid > 0 then
            self.go_table.aortext_NextRewards.text = _G.LangUtil.GetLangPackValue(90000000122)
        else
            local num = AfkTaskModel:GetNextAwardSectionNum()
            self.go_table.aortext_NextRewards.text = _G.string.format(_G.LangUtil.GetLangPackValue(90000000123), num)
        end

        if not self.LoadItem then
            self.ShowRewardView =
                require "BaseAwardNewItem".New(
                self.go_table.obj_Root,
                _G.handler(self, self.OnClickBtn_ChapterRewards1),
                88
            )
            self.ShowRewardView:ShowWithID(cfg.reward_show[1])
            self.LoadItem = true
        else
            if self.ShowRewardView then
                self.ShowRewardView:ShowWithID(cfg.reward_show[1])
            end
        end

        isShow = true
    end
    if not self.light then
        if not self.isSpawn then
            self.isSpawn = true
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_hutouliuguang,
                self.go_table.aorbtn_ChapterRewards1,
                function(trans)
                    self.light = trans
                end
            )
        end
    end

    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_ChapterRewards1, isShow and not self.isSection)
end

