-- ---刷新任务数据显示
function MainView_Task:RefreshTaskView()
    self:StopRefreshTaskView()
    --- 防止界面未显示  无法读取某些组件状态
    self.coroutine_RefreshTaskView = _G.DelayDo(0.2, _G.handler(self, self.RefreshTaskViewFun))
end

function MainView_Task:RefreshTaskViewFun()
    if self:ChecksIsNil(self.go_table, self.go_table.looplist2_TaskView, self.go_table.obj_TagShrinkBG) then
        return
    end
    ---是否 有任务 显示任务面板
    local isHavetask = false

    self.go_table.looplist2_TaskView.ScrollRect.vertical = true
    self.nowShowTasklist = {}

    if self.isSection == false then
        local mCurrentMainTask = _G.TaskModule:GetInstance().CurrentMainTask
        if mCurrentMainTask ~= nil then
            -- local taskinfo = mCurrentMainTask:GetTaskInfo()
            if _G.TaskUtilities.GetIsShowWaitClaimTask(mCurrentMainTask) then
                self:inititem(self.go_table.obj_TaskEntryCell, mCurrentMainTask)
                isHavetask = true
            end
        end
    end

    ---任务栏标题背景图
    if self.isSection == false then
        --require("CardInfoManager").LoadRawImage(self.go_table.aorrawimage_titlebg, "Images/Map/ui_zjm_btn_1renwu")
    else
        local sectionCfg = _G.ConfigManager.main_section_cfg[require("ChapterModel"):GetInstance():GetChooseSectionID()]
        if sectionCfg ~= nil then
            local chapterbg = _G.ConfigManager.main_chapter_cfg[sectionCfg.Chapter]
            if chapterbg ~= nil then
                require("CardInfoManager").LoadRawImage(self.go_table.aorrawimage_titlebg, chapterbg.image_4)
            end
        end
    end

    _G.GameUtil.SetActiveByCondition(self.go_table.obj_StoryEntryCell, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_TaskEntryCell, self.isSection == false)
    local mRootBranchTasks = _G.TaskModule:GetInstance().RootBranchTasks

    local startSort = {
        [_G.TaskEnum.ETaskState.Completed] = 1,
        [_G.TaskEnum.ETaskState.WaitClaim] = 2,
        [_G.TaskEnum.ETaskState.Executing] = 3
    }

    ---  nil  无需显示  false 没有正在进行的当前关卡任务  true 有当前关卡的关卡任务
    local isSectionTask = nil
    --- 如果再关卡里面  要有关卡任务 即便已完成也要显示
    if self.isSection then
        isSectionTask = false
    end
    local ChapterModel = require("ChapterModel"):GetInstance()
    if #mRootBranchTasks > 0 then
        ---@param value BaseTask
        for key, value in pairs(mRootBranchTasks) do
            if _G.TaskModule:GetInstance():IsCompletedTask(value.TaskID) == false then
                local roomid = value:GetScetionRoomId()
                local Sectionid = value:GetScetionId()
                local nowSectionid = ChapterModel:GetChooseSectionID()

                --- 可领取任务只在当前场景显示
                if _G.TaskUtilities.GetIsShowWaitClaimTask(value) then
                    --- 如果是关卡房间任务
                    if roomid > 0 then
                        --- 只有在对应的关卡内才显示
                        if self.isSection == true and nowSectionid == Sectionid then
                            _G.table.insert(self.nowShowTasklist, value)
                        end
                    else
                        ---如果是 关卡任务

                        if self.isSection == true then
                            if nowSectionid == Sectionid then
                                isSectionTask = true
                                --关卡里 只显示对应关卡的
                                _G.table.insert(self.nowShowTasklist, value)
                            end
                        else --  在主城里全显示
                            _G.table.insert(self.nowShowTasklist, value)
                        end
                    end
                end
            end
        end
    end
    if isSectionTask == false then
        local nowSection = ChapterModel:GetChooseSectionID()
        local taskid = _G.TaskModule:GetInstance():GetTaskIdBySectionId(nowSection)
        if taskid ~= nil then
            local task = _G.TaskModule:GetInstance():GetTaskWithID(taskid)
            if task ~= nil then
                _G.table.insert(self.nowShowTasklist, task)
            end
        end
    end

    ---@param a BaseTask
    _G.SortList(
        self.nowShowTasklist,
        function(a)
            ---确保 关卡任务 始终显示在关卡房间任务上面
            local ScetionRoomId = a:GetScetionRoomId()
            local state = a:GetTaskState()

            local contsub = a.AllTaskContents[1].TaskContentProgress - a.AllTaskContents[1].TaskContentTotalProgress

            local taskid = a.TaskID

            return -ScetionRoomId, -state, contsub, -taskid
        end
    )
    if self.go_table.NoviceAward ~= nil then
        _G.PoolsManager:GetInstance():Despawn(self.go_table.NoviceAward.gameObject, _G.ePoolType.UIItem)
        self.go_table.NoviceAward = nil

        self.go_table.obj_NoviceAwardEff_idle:SetActiveE(0)
    end

    --- 是否有显示新手奖励
    local isShowNoviceTaskItem = false
    if self.isSection then
        --- 策划要 主城红色主线  副本 红色关卡任务....
        local SectionTask = table.remove(self.nowShowTasklist, 1)
        if SectionTask ~= nil then
            self:inititem(self.go_table.obj_TaskEntryCell, SectionTask)
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_TaskEntryCell, true)
            isHavetask = true
        end
    else
        local mCurrentNoviceTask = _G.TaskModule:GetInstance().CurrentNoviceTask
        if mCurrentNoviceTask ~= nil and self.InitShowTask then
            local task = _G.TaskModule:GetInstance():GetTaskWithID(mCurrentNoviceTask.TaskID)
            if task ~= nil and _G.TaskModule:GetInstance():IsCompletedTask(mCurrentNoviceTask.TaskID) == false then
                _G.table.insert(self.nowShowTasklist, 1, task)
                local award = task.TaskCfg.show_award
                if award ~= nil then
                    isShowNoviceTaskItem = true
                    _G.StorageManager:GetInstance():GetItemBaseViewNew(
                        award,
                        self.go_table.obj_NoviceAward,
                        function(item)
                            item.gameObject:SetAnchorPosition(0, 0)
                            item.gameObject:SetLocalScaleXYZ(0.7)
                            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                            self.go_table.NoviceAward = item
                        end,
                        function()
                            if _G.TaskModule:GetInstance():IsTaskIdSubmited(task.TaskID) then
                                _G.TaskModule:GetInstance():ExecuteTask(task)
                            else
                                require("CommonTipManager"):GetInstance():OpenTip(
                                    self.go_table.NoviceAward.gameObject,
                                    self.go_table.NoviceAward.sid
                                )
                            end
                        end
                    )
                end
            end
        end
    end
    self.go_table.obj_NoviceAward:SetActiveE(isShowNoviceTaskItem and 1 or 0)

    ---可滑动
    local isSlide = false
    --- 可显示区域设置
    local heightcount = 0
    if #self.nowShowTasklist > 2 then
        heightcount = 2.3
        isSlide = true
        isHavetask = true
    elseif #self.nowShowTasklist > 1 then
        heightcount = 2
        isHavetask = true
    elseif #self.nowShowTasklist > 0 then
        heightcount = 1
        isHavetask = true
    end
    self.go_table.obj_LoopListView2Group:SetRectTransformSize(230, 62 * heightcount)

    if self.TaskViewCount == nil or self.TaskViewCount ~= #self.nowShowTasklist then
        self.TaskViewCount = #self.nowShowTasklist
        self.go_table.looplist2_TaskView:SetListItemCount(#self.nowShowTasklist, true)
    else
        self.go_table.looplist2_TaskView:RefreshAllShownItem()
    end

    -- if isHavetask == false then
    --     -- 如果没有任务 把任务面板收起
    --     self:ShowTakeShrinkView(nil, nil, false, true)
    -- end
    self:ShowTagShrink(isHavetask == true)

    self.coroutine_RefreshTaskView =
        _G.DelayDo(
        1,
        function()
            self.go_table.looplist2_TaskView.ScrollRect.vertical = isSlide
            self.coroutine_RefreshTaskView = nil
        end
    )
end

function MainView_Task:StopRefreshTaskView()
    if self.coroutine_RefreshTaskView ~= nil then
        _G.coroutine.stopwaiting(self.coroutine_RefreshTaskView)
        self.coroutine_RefreshTaskView = nil
    end
end

