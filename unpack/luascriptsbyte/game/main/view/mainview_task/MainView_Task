--- 显示隐藏左侧任务队伍栏
---@param isSkip boolean true不要移动 不记录状态(没任务默认收起/状态：AFK主界面状态同步)
function MainView_Task:ShowTakeShrinkView(go, isOn, isShow, isSkip)
    if self.isTagShrinkOn == true then
        return
    end
    local isShowTakeShrink
    if isShow ~= nil then
        local x, y, z = self.go_table.obj_TaskPanel:GetLocalPosition()
        if isShow and x > -100 then
            return
        elseif not isShow and x < -224 then
            return
        end
    end

    if not _G.IsNil(self.go_table.obj_TaskPanel) then
        local dotweening = nil

        local obj_TaskPanelV3
        --local obj_ChapterReward

        local x, y, z = self.go_table.obj_TaskPanel:GetLocalPosition()
        if x > -224 then
            --obj_ChapterReward = {-2000, 147, 0}
            isShowTakeShrink = false
            obj_TaskPanelV3 = {-500, 0, 0}
        else
            --obj_ChapterReward = {0, 147, 0}
            isShowTakeShrink = true
            obj_TaskPanelV3 = {0, 0, 0}
        end

        if isSkip == true then
            self.go_table.obj_TaskPanel:SetLocalPosition(obj_TaskPanelV3[1], obj_TaskPanelV3[2], obj_TaskPanelV3[3])
        else
            self.isTagShrinkOn = true
            dotweening =
                self.go_table.obj_TaskPanel:DOLocalMove(obj_TaskPanelV3[1], obj_TaskPanelV3[2], obj_TaskPanelV3[3], 0.5)
            ---蹭车
            -- self.go_table.obj_ChapterReward:DOLocalMove(
            --     obj_ChapterReward[1],
            --     obj_ChapterReward[2],
            --     obj_ChapterReward[3],
            --     0.5
            -- )
            if not _G.IsNil(dotweening) then
                dotweening.onComplete = function()
                    self.isTagShrinkOn = false
                end
            end
        end
        if isSkip ~= true then
            self.IsShowTakeShrink.is = isShowTakeShrink
        end
        self.TagShrink_AorImage:SetLocalEulerAngles(0, 0, isShowTakeShrink == false and 180 or 0)
    end
end

