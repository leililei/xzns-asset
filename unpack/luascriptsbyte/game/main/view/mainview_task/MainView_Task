end

function MainView_Task:GetIsInItShowTask()
    local parameters = _G.ConfigManager.discrete_cfg[103602]
    local InitShowTask = true
    if parameters then
        parameters = parameters
        InitShowTask = _G.GlobalConditionManager.CheckCondition(parameters[1][1], parameters[1][2])
    end
    return InitShowTask
end

