---设置主界面 taskitem特效
---goTable taskitem goTable
---@param task BaseTask
function MainView_Task:SetTaskItemEff(goTable, task, isUpdata)
    local curworld = _G.WorldManager:GetInstance():GetCurWorld()
    if curworld == nil or _G.IsNil(goTable.Eff_Taskitem_show) or _G.IsNil(goTable.Eff_Taskitem_updata) then
        return
    end
    if goTable.isPlayEff_updata == true then
        return
    end
    ---@type UnityEngine.GameObject
    local curScenceId = curworld.Cfg.Sid
    local isNoviceTask = task.type == _G.TaskEnum.ETaskType.NoviceTask

    local function CheckNowScence()
        local isNowScence
        isNowScence = task:IsDone() --  TaskUtilities.GetTaskStateScence(task) == 0 and
        -- if isNowScence == false then
        --     isNowScence = _G.TaskUtilities.IsTaskStateScence(task, curScenceId)
        -- end
        --- 如果在当前场景
        if isNowScence == true then
            goTable.Eff_Taskitem_show:SetActiveE(1)
            goTable.Eff_Taskitem_updata:SetActiveE(0)

            if isNoviceTask then
                self.go_table.obj_NoviceAwardEff:SetActiveE(1)
                self.go_table.obj_NoviceAwardEff_idle:SetActiveE(0)
            end
        else
            goTable.Eff_Taskitem_show:SetActiveE(0)
            goTable.Eff_Taskitem_updata:SetActiveE(0)
            if isNoviceTask then
                self.go_table.obj_NoviceAwardEff:SetActiveE(0)
                if self.go_table.NoviceAward then
                    self.go_table.obj_NoviceAwardEff_idle:SetActiveE(1)
                end
            end
        end
    end

    if isUpdata == true then
        goTable.isPlayEff_updata = true
        goTable.Eff_Taskitem_show:SetActiveE(0)
        goTable.Eff_Taskitem_updata:SetActiveE(1)
        _G.DelayDo(
            0.4,
            function()
                goTable.isPlayEff_updata = false
                goTable.Eff_Taskitem_updata:SetActiveE(0)
                CheckNowScence()
            end
        )
    else
        CheckNowScence()
    end
end

--初始化聊天iitem
---@param nowitemTransDic BaseTask @当前任务信息
function MainView_Task:inititem(item, nowitemTransDic)
    if nowitemTransDic == nil then
        return
    end
    local goTable = _G.GetAutoGoTable(item)
    --主线任务区域显示
    local isOne = item:GetName() == "$_obj_TaskEntryCell"
    local objid = item:GetInstanceIDE()
    local objididata = self.TaskViewItems[objid]
    --标记 该item 已添加过事件
    local taskShowDic = {}

    if self.TaskViewShowDic[nowitemTransDic.TaskID] == nil then
        self.TaskViewShowDic[nowitemTransDic.TaskID] = taskShowDic
    else
        taskShowDic = self.TaskViewShowDic[nowitemTransDic.TaskID]
    end

    local isUpdata = self.UpdataTaskId == nowitemTransDic.TaskID

    --- 新任务 第一次显示特效
    if taskShowDic.OneShow == nil then
        isUpdata = true
        taskShowDic.OneShow = true
    end

    if goTable.Click == nil then
        goTable.Click = true
        --超链接监听 防止重复
        goTable.aorbtn_BtnBG.onClick:AddListener(_G.handlerbind(self, self.taskOnclick, objid))
        local zhuEff = _G.ConfigManager.ui_effect_cfg.Main_Taskitem_show1
        local zhiEff = _G.ConfigManager.ui_effect_cfg.Main_Taskitem_updata1

        local checkCount = 2
        local checkEff = function()
            checkCount = checkCount - 1
            if checkCount >= 1 or _G.IsNil(self.gameObject) then
                return
            end
            self:SetTaskItemEff(goTable, nowitemTransDic, isUpdata)
        end
        _G.UIUtils.LoadEffectByCfg(
            zhuEff,
            item,
            function(tran)
                if tran ~= nil then
                    goTable.Eff_Taskitem_show = tran
                    tran:SetActiveE(0)
                    checkEff()
                end
            end
        )
        _G.UIUtils.LoadEffectByCfg(
            zhiEff,
            item,
            function(tran)
                if tran ~= nil then
                    goTable.Eff_Taskitem_updata = tran
                    tran:SetActiveE(0)
                    checkEff()
                end
            end
        )
    else
        self:SetTaskItemEff(goTable, nowitemTransDic, isUpdata)
    end

    --刷新点击数据
    self.TaskViewItems[objid] = nowitemTransDic
    local tasktypetitle = _G.TaskUtilities.GetTaskTypeTitle(nowitemTransDic.type)
    goTable.aortext_TaskTitle.text =
        tasktypetitle ..
        (_G.LangUtil.GetLangPackValue(nowitemTransDic.TaskCfg.name) or tostring(nowitemTransDic.TaskCfg.ID))

    local aortext_TaskDes, aortmp_ProgressStr

    local state = nowitemTransDic:GetTaskState()

    if TaskUtilities.GetTaskProgressIsAllOver(nowitemTransDic) then
        aortext_TaskDes = LangUtil.GetLangPackValue(90000000035)
    else
        if state ~= _G.TaskEnum.ETaskState.Completed then
            aortmp_ProgressStr = _G.TaskUtilities.GetTaskProgress(nowitemTransDic)
            aortext_TaskDes = _G.TaskUtilities.GetTaskStateNowDes(nowitemTransDic)
        end
    end

    goTable.aortext_Progress.text = aortmp_ProgressStr

    goTable.aortext_TaskDes.text = aortext_TaskDes
    return item
end

