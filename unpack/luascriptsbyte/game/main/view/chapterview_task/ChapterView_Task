---@class ChapterView_Task : Component	中文描述
local ChapterView_Task = _G.BaseClass("ChapterView_Task", _G.Component)

function ChapterView_Task:__init(obj)
    self.super.__init(self)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickChapterTaskBtn))
    self.TaskViewItems = {}
    --按钮点击对应的方法
    _G.TaskModule:GetInstance():AddListener(
        _G.TaskModuleEvent,
        _G.TaskModuleEvent.EnumValueTable.TaskInfoUpdate,
        self.OnTaskInfoUpdate,
        self
    )
end

---入口函数
function ChapterView_Task:OnCreate()
    self:InitView()
end
function ChapterView_Task:InitView()
    if not _G.table.isEmptyOrNil(self.CurSectionTaskInfo) then
        self.CurSectionTaskInfo = nil
    end
    local cfg = require("ChapterModel"):GetInstance():GetCurChooseSectionCfg()
    local taskIds = _G.TaskModule:GetInstance():GetRoomTaskIdArrBySectionId(cfg.id)
    local taskCfg = _G.ConfigManager.task_cfg
    local taskCount = #taskIds
    local completedTask = 0
    for i = 1, #taskIds do
        local result = _G.TaskModule:GetInstance():IsCompletedTask(taskIds[i])
        if result then
            completedTask = completedTask + 1
        end
    end
    if _G.table.isEmptyOrNil(taskIds) then
        self.go_table.gameObject:SetActiveE(0)
        return
    else
        self.go_table.gameObject:SetActiveE(1)
    end
    local curTaskDoingId = taskIds[completedTask + 1] or taskIds[completedTask]
    self.go_table.aortext_ChapterName.text = _G.LangUtil.GetLangPackValue(cfg.Name)
    self.go_table.aortext_ChapterDecs.text = _G.LangUtil.GetLangPackValue(taskCfg[curTaskDoingId].targetdes[1])
    self.go_table.aortext_ChapterJindu.text = string.format("%d/%d", completedTask, taskCount)
    if _G.table.isEmptyOrNil(self.CurSectionTaskInfo) then
        self.CurSectionTaskInfo = {}
        self.CurSectionTaskInfo.cfg = cfg
        self.CurSectionTaskInfo.taskIds = taskIds
        self.CurSectionTaskInfo.curTaskDoingId = curTaskDoingId
        if completedTask > 0 then
            self.CurSectionTaskInfo.curTaskIndex = completedTask
        elseif completedTask == #taskIds or completedTask == 0 then
            self.CurSectionTaskInfo.curTaskIndex = 0
        end
    end
end
function ChapterView_Task:OnClickChapterTaskBtn(go, ref, CurSectionTaskInfo)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ChpaterTaskView.Name, self.CurSectionTaskInfo)
end
function ChapterView_Task:UpdateView()
    self:InitView()
end
function ChapterView_Task:OnTaskInfoUpdate()
    self:InitView()
end
---销毁对象时,析构函数
function ChapterView_Task:OnDestroy()
    _G.TaskModule:GetInstance():RemoveListener(
        _G.TaskModuleEvent,
        _G.TaskModuleEvent.EnumValueTable.TaskInfoUpdate,
        self.OnTaskInfoUpdate,
        self
    )
    _G.TaskModule:GetInstance():RemoveListener(
        _G.TaskModuleEvent,
        _G.TaskModuleEvent.EnumValueTable.TaskNumberUpdate,
        self.OnTaskNumberUpdate,
        self
    )
end

return ChapterView_Task
