---获取一个 可执行函数
---@param 变量名 boolean true仅检测是否有可执行函数 (true 返回可执行函数 不删除)
function MainManager:PopMainFunQueue(isCheck)
    local fun = nil
    local id = 0
    local count = _G.MainViewShowOrder.End

    local checkFun, DelFun
    ---要删除的索引 (open的 及 del的)
    local delIndexArr = {}
    local insert = _G.table.insert
    local remove = _G.table.remove
    for i = 1, count do
        if self.MainOpenViewFunQueue[i] then
            for index, value in pairs(self.MainOpenViewFunQueue[i]) do
                if value.DelFun and value.DelFun() == true then
                    insert(delIndexArr, index)
                else
                    checkFun = value.checkFun
                    if checkFun == nil or checkFun() then
                        fun = value.OpenViewFun
                        id = i
                        if isCheck == true then
                            --不处理 仅返回函数
                        else
                            insert(delIndexArr, index)
                        end
                    end
                end
                for k = #delIndexArr, 1, -1 do
                    remove(self.MainOpenViewFunQueue[i], delIndexArr[k])
                end
                --赋空 防止IsMainQueueFun误判
                if #self.MainOpenViewFunQueue[i] == 0 then
                    self.MainOpenViewFunQueue[i] = nil
                end
                if fun then
                    return fun, id
                end
            end
        end
    end

    return fun, id
end

