---检测是否需要显示关卡提示
function MainManager:CheckSectioninfo()
    local tChapterRoomManager = _G.ChapterRoomManager:GetInstance()
    if tChapterRoomManager:GetisShowSectioninfo() == true then
        return
    end
    local ChapterModel = require("ChapterModel"):GetInstance()
    local sectionCfg = ChapterModel:GetCurChooseSectionCfg()
    if not sectionCfg then
        return
    end
    local sectionName = ""
    if sectionCfg ~= nil then
        --打开关卡banner描述
        sectionName = sectionCfg.Openbanner
    end

    local curRoomCfg = tChapterRoomManager:GetCurRoomCfg()
    if curRoomCfg == nil then
        return
    end
    --如果 当前房间不是关卡 第一个房间
    if _G.ConfigManager.main_room_cfg[sectionCfg.rooms[1]].id ~= curRoomCfg.id then
        return
    end

    local chapterData = ChapterModel:GetCurChapterData()
    if chapterData == nil then
        return
    end
    local chapterDataName = ""
    if chapterData ~= nil then
        chapterDataName = chapterData.Name
    end
    tChapterRoomManager:SetisShowSectioninfo(true)
    self.mainView:ShowChapterTips(chapterDataName, sectionName)
end

