---有新聊天信息
---@param data chat.i_chat PB数据
function MainManager:OnAddMinChatItem(data)
    if data.type == _G.ChatInfoType.time then
        return
    end

    local isshow = require("ChatManager"):GetInstance():GetMainHasPindao(data.channel)
    local isUnlock = require("ChatManager"):GetInstance():IsUnLock(data.channel)
    if isshow and isUnlock then
        ---拉黑后不显示消息
        if require("FriendManager"):GetInstance():CheckInBlackList(data.role_info.uid) then
            return
        end

        local pindao = data.channel
        local content = ""

        if data.type == 3 then
            local datafx = _G.Json2Table(data.n_Maincontent)
            if datafx.shareType == 1 then
                ---公会
                content = self:NameAddColor(data.role_info.name) .. _G.GetLangPackValue(90000001051)
            elseif datafx.shareType == 2 then
                --战报
                content = self:NameAddColor(data.role_info.name) .. _G.GetLangPackValue(90000001054)
            elseif datafx.shareType == 3 then
                --卡片
                content = self:NameAddColor(data.role_info.name) .. _G.GetLangPackValue(90000001053)
            elseif datafx.shareType == 4 then
                --阵容
                content = self:NameAddColor(data.role_info.name) .. _G.GetLangPackValue(90000001052)
            end
        elseif data.type == _G.ChatInfoType.Push then
            --分享
            content = _G.GetLangPackValue(9002060029)
            pindao = 5
        elseif data.type == _G.ChatInfoType.ShowCultivationPride then
            content = self:NameAddColor(data.role_info.name) .. _G.GetLangPackValue(9002060025)
        elseif data.type == _G.ChatInfoType.PlayerEmoji then
            local str = _G.ConfigManager.expression_cfg[_G.tonumber(data.n_content)]
            if str then
                content = self:NameAddColor(data.role_info.name) .. str.key
            else
                content = self:NameAddColor(data.role_info.name) .. _G.string.removeRichTextSpecal(data.n_content)
            end
        elseif data.type == _G.ChatInfoType.StrategyStation then
            content = _G.GetLangPackValue(90000011768)
        elseif data.type == _G.ChatInfoType.MaidAcademy then
            content = "女仆分享信息，需要加语言表"
        elseif data.type == _G.ChatInfoType.ActivityDispatch then

            content = _G.GetLangPackValue(90033400121)
        elseif data.type == _G.ChatInfoType.GuildImpeach then
            local tpchdata = _G.Json2Table(data.n_content)
            content = _G.GetLangPackValue(90021800544, tpchdata.curImpeachNum, tpchdata.needImpeachNum)
        elseif data.type == _G.ChatInfoType.GuildMoba then
            content = _G.GetLangPackValue(90031700306)
        elseif data.type == _G.ChatInfoType.RelicTeam then
            content = data.role_info.name .. ":" .. _G.GetLangPackValue(90033500229)
        elseif data.type == _G.ChatInfoType.system then
            if data.channel == _G.ChatType.activityTournament then
                content = data.n_content
            else
                content = self:NameAddColor(data.role_info.name) .. data.n_content
            end
        else
            content = self:NameAddColor(data.role_info.name) .. _G.string.removeRichTextSpecal(data.n_content)
        end
        self.ChatTypeId = pindao
        self.lastChat[1] = pindao
        self.lastChat[2] = content
        self.lastChat[3] = data
        if pindao == _G.ChatType.union then
            self.lastSociatyChat[1] = pindao
            self.lastSociatyChat[2] = content
            self.lastSociatyChat[3] = data
        end
        if data.time == nil then
            self.mainTime = _G.TimeUtil.GetServerUnixTime()
            self.mainType = pindao
        elseif self.mainTime == nil then
            self.mainTime = data.time
            self.mainType = pindao
        elseif self.mainTime < data.time then
            self.mainTime = data.time
            self.mainType = pindao
        else
            return
        end

        if self.mainView then
            ---是否显示该频道消息
            self.mainView:AddMinChatItem(pindao, content, data.channel)
        end
        if self.afkView then
            self.afkView:AddMinChatItem(pindao, content, data.channel)
        end
        local mainView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name)
        if mainView and mainView.panelInit.sociaty and pindao == _G.ChatType.union then
            if mainView.panelLua.sociaty then
                mainView.panelLua.sociaty:AddMinChatItem(pindao, content, data.channel)
            end
        end
    end
end

