end

function MainManager:MainQueueFun_Check()
    if self.TimerCheckOpen or self.isInMainView == false or self.CurPop ~= nil then
        return
    end
    if _G.AppSetting.DEBUG then
        _G.Log("<color=blue><size=20>" .. "当前队列检测，检测开始" .. "</size></color>")
    end
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
    --self.mainView:HideMask(true)
    ---延迟帧 防止队列中 跳转新界面（close界面（此时只剩主界面） 再open新界面） 之间错误弹出
    self.TimerCheckOpen = _G.TimerManager:GetInstance():GetTimer(3, self.TimerFunc, self, true, true, true)
    --_G.DelayDo(0.1, _G.handler(self,self.TimerFunc))
    self.TimerCheckOpen:Start()
end

function MainManager:TimerFunc()
    if _G.AppSetting.DEBUG then
        _G.Log("<color=blue><size=20>" .. "当前队列检测，延迟检测开始" .. "</size></color>")
    end
    self:MainQueueFun_Check2()
    self:ChapterTaskSubmitCheck()
    self:StopTimerCheckOpen()
    --self.TimerCheckOpen = false
end

function MainManager:StopTimerCheckOpen()
    if self.TimerCheckOpen then
        self.TimerCheckOpen:Stop()
        self.TimerCheckOpen = nil
    end
end

function MainManager:ChapterTaskSubmitCheck()
    ---在剧本时 检测是否有提交任务后剧情
    local fun
    if self.mainView.isSection then
        if self:IsMainQueueFun() then
            if self.MainOpenViewFunQueue[_G.MainViewShowOrder.mainOthen] then
                for k, value in pairs(self.MainOpenViewFunQueue[_G.MainViewShowOrder.mainOthen]) do
                    fun = value.OpenViewFun
                    break
                end
                self.MainOpenViewFunQueue[_G.MainViewShowOrder.mainOthen] = nil
                if fun then
                    self.HasMainDisplayQueue = true
                    fun()
                    return
                end
                self.HasMainDisplayQueue = false
            end
        end
    end
end

function MainManager:MainQueueFun_Check2()
    ---在剧本时 主界面打开 但不检测队列
    if self.isInMainView and not self.mainView.isSection then
        if self:IsMainQueueFun() then
            local fun, id = self:PopMainFunQueue(true)
            if fun then
                ---强制引导中或者失败引导中
                if
                _G.GuideManager:GetInstance().IsGuideing and
                        (_G.GuideManager:GetInstance().CurGuideModelCfg.not_force == false or
                                _G.GuideManager:GetInstance().CurGuideModelCfg.id ==
                                        _G.ConfigManager.discrete_cfg[102103][1][1])
                then
                    if id < _G.MainViewShowOrder.SelectSectionViewOpen then
                        fun, id = self:PopMainFunQueue()
                        self.HasMainDisplayQueue = true
                        self.CurPop = id
                        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
                        fun()
                        return
                    else
                        if _G.AppSetting.DEBUG then
                            _G.Log("<color=blue><size=20>" .. "当前队列检测，引导优化插队" .. "</size></color>")
                        end
                    end
                else
                    fun, id = self:PopMainFunQueue()
                    self.HasMainDisplayQueue = true
                    self.CurPop = id
                    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
                    fun()
                    return
                end
            else
                if _G.AppSetting.DEBUG then
                    _G.Log("<color=blue><size=20>" .. "当前队列检测，队列id为" .. id .. "的队列函数为空" .. "</size></color>")
                end
            end
        else
            if _G.AppSetting.DEBUG then
                _G.Log("<color=blue><size=20>" .. "当前队列检测，队列为空" .. "</size></color>")
            end
        end
        self.HasMainDisplayQueue = false
    else
        if _G.AppSetting.DEBUG then
            _G.Log("<color=blue><size=20>" .. "当前队列检测不在主界面，不能触发队列" .. "</size></color>")
            for i = 1, #self.fullUINameList do
                _G.Log(
                        "<color=blue><size=20>" .. "当前队列检测不在主界面，" .. tostring(self.fullUINameList[i]) .. "</size></color>"
                )
            end
            _G.Log(
                    "<color=blue><size=20>" ..
                            "当前队列检测不在主界面，" .. tostring(self.mainView.gameObject:GetctiveInHierarchy()) .. "</size></color>"
            )
        end
    end
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
end

