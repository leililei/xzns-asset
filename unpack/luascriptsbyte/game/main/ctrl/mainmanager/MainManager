function MainManager:InitMainPrompt()
    for k, v in pairs(_G.ConfigManager.main_prompt_cfg) do
        if not self.MainQuickFuncCfg[v.id] then
            self.MainQuickFuncCfg[v.order] = {}
            self.MainQuickFuncCfg[v.order].id = v.id
            self.MainQuickFuncCfg[v.order].funcOpen = v.function_id
            self.MainQuickFuncCfg[v.order].checkFunc = v.method_call
            self.MainQuickFuncCfg[v.order].icon = v.icon
            self.MainQuickFuncCfg[v.order].openFunc = v.openfunc
            self.MainQuickFuncCfg[v.order].order = v.orders
        end
    end
end

function MainManager:GetQuickBtn()
    self.MainFloatFuncBtn = {}
    if _G.table.isEmptyOrNil(self.MainQuickFuncCfg) then
        return nil
    end
    local checkfunc, openfunc, lua
    for i = 1, #self.MainQuickFuncCfg do
        checkfunc = self.MainQuickFuncCfg[i].checkFunc
        openfunc = self.MainQuickFuncCfg[i].openFunc
        if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.MainQuickFuncCfg[i].funcOpen) then
            if not _G.table.isEmptyOrNil(checkfunc) then
                lua = _G[checkfunc[1]]
                if lua == nil then
                    lua = require(checkfunc[1])
                end
                if #checkfunc == 2 then
                    if lua[checkfunc[2]]() then
                        _G.table.insert(
                                self.MainFloatFuncBtn,
                                {
                                    id = self.MainQuickFuncCfg[i].id,
                                    icon = self.MainQuickFuncCfg[i].icon,
                                    openFunc = openfunc
                                }
                        )
                    end
                elseif #checkfunc == 3 then
                    if lua[checkfunc[2]](tonumber(checkfunc[3])) then
                        _G.table.insert(
                                self.MainFloatFuncBtn,
                                {
                                    id = self.MainQuickFuncCfg[i].id,
                                    sicon = self.MainQuickFuncCfg[i].icon,
                                    openFunc = openfunc
                                }
                        )
                    end
                end
            end
        end
    end
    return self.MainFloatFuncBtn
end

function MainManager:Dispose()
    if self.OpenAwardTimer then
        self.OpenAwardTimer:Stop()
        self.OpenAwardTimer = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.StartOpenUI, self.OnUIOpened, self)
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.StartCloseUI, self.StartCloseUI, self)
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
    _G.Events:GetInstance():RemoveListener(_G.eFunctionsStatus.NewFunction, self.FunOpen, self)
    _G.Events:GetInstance():RemoveListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.FunctionOpen, self)
    _G.Events:GetInstance():RemoveListener(_G.eFunctionsStatus.FunctionForbidden, self.FunctionForbidden, self)
    -- _G.Events:GetInstance():RemoveListener(_G.eChatStatus.MainNewChat, self.OnAddMinChatItem, self)
    _G.Events:GetInstance():RemoveListener(_G.eChatStatus.DelChat, self.OnClearMinChatItem, self)
    _G.Events:GetInstance():RemoveListener(_G.eChatStatus.SociatyBattleLog, self.OnAddUnionBattleChatItem, self)
    _G.Events:GetInstance():RemoveListener(
            _G.eSociatyBattleLeague.SociatyBattleLogLeague,
            self.OnAddUnionBattleLeagueChatItem,
            self
    )
    _G.Events:GetInstance():RemoveListener(_G.eCardStorage.AddCardData, self.OnNewCard, self)
    self.MainOpenViewFunQueue = {}
    self.isInMainView = false
    self.InitInitial = nil
    self.addNewCardMainFunQueue = false
    self.douyinFeedSubscribe = false
    self.isShowGmBigView = nil
    self:RemoveListener()
    self:StopTimerCheckOpen()
end

