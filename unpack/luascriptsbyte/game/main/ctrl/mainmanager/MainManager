---@private 获得新卡牌时, 添加检测弹窗队列
function MainManager:OnNewCardAddMainFunQueue()
    if self.addNewCardMainFunQueue then
        return
    end

    --检查背包容量是否充足
    local function checkSize()
        local cfg = _G.ConfigManager.discrete_cfg[119010]
        local minSize = cfg and cfg[1][1] or 10
        if minSize < 0 then
            return true --禁用此功能
        end
        return _G.StorageManager:GetInstance():CheckSize(_G.StorageID.Card, minSize)
    end
    if checkSize() then
        return
    end
    self.addNewCardMainFunQueue = true

    ---@type MainOpenViewFunItem
    local MainOpenViewFunItem = {}
    MainOpenViewFunItem.OpenViewFun = function(callback)
        self.addNewCardMainFunQueue = false
        local function nextPopWindow()
            if callback then
                _G.DelayFrameDo(callback)
            end
        end
        --检查背包容量是否小于x个
        if checkSize() then
            nextPopWindow()
            return
        end

        local cardManager = require("CardInfoManager"):GetInstance()
        --检测是否开启自动升星
        -- if cardManager:CheckAutoCardDevelopToggle() and cardManager:CheckAutoCardDevelop() then
        --     nextPopWindow()
        --     return
        -- end

        --弹窗卡牌: 自动升星
        if not cardManager:CheckAutoCardDevelopToggle() and cardManager:CheckAutoCardDevelop() then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                    1006,
                    nil,
                    function(isChoose)
                        cardManager:SetAutoCardDevelopToggle(isChoose)
                        cardManager:AutoCardDevelopRecursive(function(ok, msg)
                            nextPopWindow()
                            if ok and msg then
                                _G.UIUtils.ShowCommonAward(msg)
                            end
                        end)
                    end,
                    function(isChoose)
                        cardManager:SetAutoCardDevelopToggle(isChoose)
                        nextPopWindow()
                    end,
                    cardManager:CheckAutoCardDevelopToggle()
            )
            return
        end

        --弹窗提示: 扩容
        local maxCapacityTimes = _G.ConfigManager.storage_cfg[_G.StorageID.Card].extension_limit
        local capacityTimes = _G.StorageManager:GetInstance():GetStorageCapacityTimes(_G.StorageID.Card) or 0
        if capacityTimes < maxCapacityTimes then
            if _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.ResProp, _G.ResPropID.Diamond) >=
                    _G.ConfigManager.storage_cfg[_G.StorageID.Card].extension_consumption then
                _G.StorageUtils.CardBagAdd(nextPopWindow)
                return
            end
        end

        --弹窗提示: 升星界面
        _G.PopWindowManager:GetInstance():ShowAllTips(
                1007,
                nil,
                function()
                    _G.JumpManager:GetInstance():Jump(129002)
                end,
                nextPopWindow
        )
    end
    --self:AddMainFunQueue(MainOpenViewFunItem, _G.MainViewShowOrder.OnePay)
    _G.PopWindowManager:GetInstance():AddPopWindowQuene(MainOpenViewFunItem, _G.PopViewShowOrder.AutoCardDevelop)
end

