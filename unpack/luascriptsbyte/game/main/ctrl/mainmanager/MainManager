---功能开放事件处理
function MainManager:FunctionOpen(openFunid)
    if openFunid == nil then
        return
    end
    self:DelayUpdateMainView()

    if type(openFunid) ~= "number" then
        openFunid = tonumber(openFunid)
    end
    --神器解锁, 刷新神器红点
    if openFunid == 145 then
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.Artifact.id)
    elseif openFunid == 272 then
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SpiritualDrawGiftPack.id)
    end
    require("StrengthGuideModel"):GetInstance():FunOpen(openFunid)
    local fp = _G.ConfigManager.function_open_cfg[openFunid]
    if nil == fp then
        if _G.AppSetting.DEBUG then
            _G.LogError(openFunid, "打开的功能id必须是function_open_cfg表的id，错误id是")
        end
        return
    end

    if #fp.reward <= 0 then
        if _G.AppSetting.DEBUG then
            _G.Log(openFunid, "当前开放功能没有奖励可拿")
        end
        return
    end

    if _G.AppSetting.DEBUG then
        if not _G.GlobalConditionManager.CheckConditionByArray(fp.condition_type) then
            _G.LogError(openFunid, "功能未开放触发开放奖励错误id")
            return
        end
    end

    if nil == self.OpenAwardTimer then
        self.OpenAwardTimer = _G.TimerManager:GetInstance():GetTimer(0.1, self.OpenAwardTimerFunc, self, true, false,
                true)
        self.OpenAwardTimer:Start()
        self.OpenAwardMsg = {}
        self.OpenAwardMsg.function_ids = {}
    end
    table.insert(self.OpenAwardMsg.function_ids, openFunid)
end

