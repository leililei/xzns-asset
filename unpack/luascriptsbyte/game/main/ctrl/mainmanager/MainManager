---新增一个活动按钮
---@param tag string 按钮标签
---@param icon string 按钮icon名字
---@param click function 按钮点击方法
---@param pos number 展示位置
---@param index number 排序
---@param name string 按钮显示名称
---@param eff ui_effect_cfg 按钮特效
---@param redpointID number 按钮红点ID
---@param redpointParam number 按钮红点参数
function MainManager:AddActivitySynBtn(
        tag,
        icon,
        click,
        pos,
        index,
        name,
        eff,
        redpointID,
        redpointParam,
        isBanner,
        ftype,
        typeid)
    if ftype and ftype < 0 then
        ---类型小于0的不应该在主界面
        return
    end
    if not self.activitySynBtnsInfoTab then
        self.activitySynBtnsInfoTab = {}
    end
    local item = {
        tag = tag,
        icon = icon,
        click = click,
        pos = pos,
        index = index,
        name = name,
        eff = eff,
        redpointID = redpointID,
        redpointParam = redpointParam,
        isBanner = isBanner,
        ftype = ftype,
        typeid = typeid
    }
    if #self.activitySynBtnsInfoTab > 0 then
        local btn
        local insert = _G.table.insert
        for i = 1, #self.activitySynBtnsInfoTab do
            btn = self.activitySynBtnsInfoTab[i]
            if index <= btn.pos and index < btn.index then
                insert(self.activitySynBtnsInfoTab, i, item)
                break
            end
            if i == #self.activitySynBtnsInfoTab then
                insert(self.activitySynBtnsInfoTab, i + 1, item)
            end
        end
    else
        self.activitySynBtnsInfoTab[1] = item
    end
    if self.mainView then
        --TODO:计算展示位置
        local tab, sortV
        sortV = 0
        for i = 1, #self.activitySynBtnsInfoTab do
            tab = self.activitySynBtnsInfoTab[i]
            if tab.pos == pos then
                if tab.tag == tag then
                    break
                else
                    sortV = sortV + 1
                end
            end
        end
        self.mainView:AddActivitySynBtn(item, tab.index)
    end
end

---移除一个活动按钮
---@param tag number 活动按钮ID
function MainManager:RemoveActivitySynBtn(tag, type1, sorting, isBanner, ftype)
    if self.activitySynBtnsInfoTab == nil then
        self.activitySynBtnsInfoTab = {}
    end
    for i = 1, #self.activitySynBtnsInfoTab do
        if self.activitySynBtnsInfoTab[i].tag == tag then
            if self.mainView then
                self.mainView:RemoveActivitySynBtn(tag, type1, sorting, ftype)
            end
            _G.table.remove(self.activitySynBtnsInfoTab, i)
            break
        end
    end
end

---按钮点击
---@param 变量名 变量类型 中文描述
function MainManager:OnActivityBtnClick(tag)
    for i = 1, #self.activitySynBtnsInfoTab do
        if self.activitySynBtnsInfoTab[i].tag == tag then
            self.activitySynBtnsInfoTab[i].click(tag)
            break
        end
    end
end

