--检查条件返回满足条件的功能
---@param id MainFunctionItems 功能id
---@param isInitMain boolean 是否仅显示判断
function FunctionManager:CheckLimit(id, isInitMain)
    ---@type MainFunction_Item itemData
    local itemData = _G.ConfigManager.main_function_cfg[id]
    if itemData == nil then
        return false
    end
    if not itemData.ShowInMainView then
        return false
    end

    if isInitMain == true then
        --功能开启条件未满足时是否可见
        if itemData.is_display then
            return true
        end
    end

    ---功能开启id（无配置则默认开启）
    if itemData.function_open == 0 then
        self:CheckCloseMainFun(id, true)
        if itemData.function_close[1] and self.FunctionIdCloseDic[id] == false then
            return false
        end
        return true
    end

    --检查显示条件
    if not _G.table.isEmptyOrNil(itemData.Display_condition) and
        not _G.GlobalConditionManager.CheckConditionArrays({itemData.Display_condition}) then
        return false
    end

    --检查功能开启条件
    if itemData.function_open >= ACTIVITY_INFO_ID then
        --配置activity_info_cfg表解锁
        local activityCfg = _G.ConfigManager.activity_info_cfg[itemData.function_open]
        if not activityCfg then
            return false
        end
        if #activityCfg.condition_display == 1 then
            local functionOpenCfg = _G.ConfigManager.function_open_cfg[activityCfg.condition_display[1]]
            if not functionOpenCfg or not self:CheckCondition(functionOpenCfg.condition_type, activityCfg.condition_display[1]) then
                return false
            end
        else
            for i = 1, #activityCfg.condition_display, 2 do
                if not _G.GlobalConditionManager.CheckCondition(activityCfg.condition_display[i], activityCfg.condition_display[i + 1]) then
                    return false
                end
            end
        end
    else
        --配置function_open_cfg表解锁
        --开启条件类型（1-等级；2-主线副本；4-主线放置）
        local functionOpenCfg = _G.ConfigManager.function_open_cfg[itemData.function_open]
        if not functionOpenCfg or not self:CheckCondition(functionOpenCfg.condition_type, itemData.function_open) then
            return false
        end
    end

    if itemData.Id == _G.MainFunctionItems.MaterialCard then
        return require "MaterialGiftModel":GetInstance():CheckIsOpen(1)
    elseif itemData.Id == _G.MainFunctionItems.MaterialLM then
        return require "MaterialGiftModel":GetInstance():CheckIsOpen(2)
    end
    self:CheckCloseMainFun(id, true)
    if self.FunctionIdCloseDic[id] == false then
        return false
    end
    return true
end

