---开启 一个主界面功能
function FunctionManager:OpenFunById(mainFunId, isForce)
    local value = _G.ConfigManager.main_function_cfg[mainFunId]
    if not value then
        return
    end
    if string.IsNullOrEmpty(value.function_close[1]) == false then
        local model = require(value.function_close[1])
        local tFun = value.function_close[2]
        if model and model[tFun] then
            self.FunctionIdCloseDic[mainFunId] = true
            self.FunctionIdCloseFunDic[mainFunId] = model[tFun]
        end
    elseif isForce then
        --强制开启功能, 在下一步CheckCloseMainFun中将会更改状态
        self.FunctionIdCloseDic[mainFunId] = true
    end
    self.showFunid[mainFunId] = self:CheckCloseMainFun(mainFunId, isForce)
    _G.MainManager:GetInstance():InitFunctions()
end

