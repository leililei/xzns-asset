--- 检测  内部方法
function FunctionManager:CheckCondition(type1, id)
    --开启条件类型（1-等级；2-主线副本；4-主线放置）
    if self.isInit then
        if self:CheckFunctionForbidden(id) then
            return false
        end
        if not self.FunctionOpenDic[id] then
            if id == 96 then
                local resoult, fun_id = require "PrivilegeManager":GetInstance():GetPrivilegeBoolen(_G.PrivilegeType.VIP.fightJump)
                return resoult and id == fun_id[1]
            elseif id == 301 then
                return _G.GlobalConditionManager.CheckConditionByArray(type1)
            elseif id == 26 then
                return _G.GlobalConditionManager.CheckConditionByArray(type1)
            end
            return false
        else
            return self.FunctionOpenDic[id] == true
        end
    else
        --region 临时填写 VIP 特权 功能解锁
        ---检测有vip  将神召唤,放置推图功能
        local data = require "PrivilegeManager":GetInstance():GetPrivilegeData({ _G.PrivilegeType.VIP.unlockFunction })
        if data and data[1] then
            local count = 1
            local check_type = type(data[1])
            if check_type == "number" then
                -- 检测是不是数值类型
                count = 1
            else
                count = 2
            end
            for i = 1, #data do
                if count < 2 then
                    if data[i] == id then
                        return true
                    end
                else
                    if data[i][2] == id then
                        return true
                    end
                end
            end
        end
        ---战斗跳过
        local resoult, fun_id = require "PrivilegeManager":GetInstance():GetPrivilegeBoolen(_G.PrivilegeType.VIP.fightJump)
        if resoult and id == fun_id[1] then
            return true
        end
        --endregin
        return _G.GlobalConditionManager.CheckConditionByArray(type1)
    end
end

