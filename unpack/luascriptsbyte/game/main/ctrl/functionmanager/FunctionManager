function FunctionManager:CheckCloseMainFun(mainFunId, isForce)
    local state = self.FunctionIdCloseDic[mainFunId]
    if (state == nil or state == false) and not isForce then
        return false
    end

    ---@type main_function_cfg
    local item = _G.ConfigManager.main_function_cfg[mainFunId]
    if item and item.function_open > 0 then
        if item.function_open >= ACTIVITY_INFO_ID then
            --配置activity_info_cfg表解锁
            local activityCfg = _G.ConfigManager.activity_info_cfg[item.function_open]
            if not activityCfg then
                self.FunctionIdCloseDic[mainFunId] = false
                return false
            end
            if #activityCfg.condition_display == 1 then
                local functionOpenCfg = _G.ConfigManager.function_open_cfg[activityCfg.condition_display[1]]
                if not functionOpenCfg or not self:CheckCondition(functionOpenCfg.condition_type, activityCfg.condition_display[1]) then
                    self.FunctionIdCloseDic[mainFunId] = false
                    return false
                end
            else
                for i = 1, #activityCfg.condition_display, 2 do
                    if not _G.GlobalConditionManager.CheckCondition(activityCfg.condition_display[i], activityCfg.condition_display[i + 1]) then
                        self.FunctionIdCloseDic[mainFunId] = false
                        return false
                    end
                end
            end
        else
            --配置function_open_cfg表解锁
            if not self:CheckFunctionIsUnlock(item.function_open) then
                self.FunctionIdCloseDic[mainFunId] = false
                return false
            end
        end
    end
    if self.FunctionIdCloseFunDic[mainFunId] then
        self.FunctionIdCloseDic[mainFunId] = self.FunctionIdCloseFunDic[mainFunId]()
    end
    return self.FunctionIdCloseDic[mainFunId]
end

