    self.isInit = false
    ---所有功能开放表解锁的id {id=true}
    self.FunctionOpenDic = {}
    ---@field updataNumFun function 更新当前进度
    ---@field CheckFun function 解锁判断 true 解锁
    ---@field lockDic table 待解锁的id {id=num,}
    ---@field num number 当前值 比大小
    ---@class FunctionOpenDicTypeFunctionTouchType
    self.FunctionOpenDicType = {
        [_G.FunctionTouchType.PlayerLevel] = {
            --- 当前值 比大小    当前等级
            num = 0,
            --- 待解锁的id {id=num,}
            lockDic = {},
            --- 解锁判断 true 解锁
            CheckFun = function(value)
                return value <= self.FunctionOpenDicType[_G.FunctionTouchType.PlayerLevel].num
            end,
            updataNumFun = function()
                self.FunctionOpenDicType[_G.FunctionTouchType.PlayerLevel].num = _G.PlayerModel:GetInstance():GetLevel()
            end
        },
        [_G.FunctionTouchType.Section] = {
            ---当前应挑战id
            num = 0,
            lockDic = {},
            CheckFun = function(value)
                return value < self.FunctionOpenDicType[_G.FunctionTouchType.Section].num
            end,
            updataNumFun = function()
                self.FunctionOpenDicType[_G.FunctionTouchType.Section].num = require("ChapterModel"):GetInstance():GetCurSectionSID()
            end
        },
        [_G.FunctionTouchType.Afk] = {
            --- 当前挑战关卡
            num = 0,
            lockDic = {},
            CheckFun = function(value)
                return value < self.FunctionOpenDicType[_G.FunctionTouchType.Afk].num
            end,
            updataNumFun = function()
                self.FunctionOpenDicType[_G.FunctionTouchType.Afk].num = require("AfkModel"):GetInstance():GetCurSection()
            end
        },
        [_G.FunctionTouchType.Afk] = {
            --- 当前挑战关卡
            num = 0,
            lockDic = {},
            CheckFun = function(value)
                return value < self.FunctionOpenDicType[_G.FunctionTouchType.Afk].num
            end,
            updataNumFun = function()
                self.FunctionOpenDicType[_G.FunctionTouchType.Afk].num = require("AfkModel"):GetInstance():GetCurSection()
            end
        },
        [_G.FunctionTouchType.ServerTime] = {
            --- 当前挑战关卡
            num = 0,
            lockDic = {},
            CheckFun = function(value)
                return _G.TimeUtil.GetServerUnixTime() - _G.PlayerModel:GetInstance().open_time >= (value - 1) * 86400
            end,
            updataNumFun = function()
            end
        },
        [_G.FunctionTouchType.PlayerCreateTime] = {
            --- 玩家创号天数
            num = 0,
            lockDic = {},
            CheckFun = function(value)
                local day = value or 0
                local ct = _G.PlayerModel:GetInstance():GetCreateRoleTime()
                if _G.TimeUtil.GetInterValDayByGame(ct, _G.TimeUtil.GetServerUnixTime()) + 1 < value then
                    return false
                end
                return true
            end,
            updataNumFun = function()
            end
        },
        [_G.FunctionTouchType.BattleAreaServerTime] = {
            --- 当前挑战关卡
            num = 0,
            lockDic = {},
            CheckFun = function(value)
                return _G.TimeUtil.GetServerUnixTime() - _G.PlayerModel:GetInstance():GetBattleOpenTime() >=
                        (value - 1) * 86400
            end,
            updataNumFun = function()
            end
        },
        [_G.FunctionTouchType.VipLevel] = {
            ---VIP等级
            num = 0,
            lockDic = {},
            CheckFun = function(value)
                return require("VIPPrivilegeModel"):GetInstance().realVipLevel >= value
            end,
            updataNumFun = function()
                self.FunctionOpenDicType[_G.FunctionTouchType.VipLevel].num = require("VIPPrivilegeModel"):GetInstance().realVipLevel
            end
        },
        [_G.FunctionTouchType.TotalCash] = {
            ---累计充值
            num = 0,
            lockDic = {},
            CheckFun = function(value)
                local curCashNum = require("MallManager"):GetInstance():GetCashRmb() or 0
                return curCashNum >= value
            end,
            updataNumFun = function()
                self.FunctionOpenDicType[_G.FunctionTouchType.TotalCash].num = require("MallManager"):GetInstance():GetCashRmb() or 0
            end
        },
        [_G.FunctionTouchType.ArraignedMod] = {
            ---提审模式
            num = 0,
            lockDic = {},
            CheckFun = function(params)
                local value = params and params[1] or 0
                local bool = value ~= 1 or not _G.AppSetting.IsArraigned
                if not bool and #params > 1 then
                    for i = 2, #params do
                        local platform = params[i]
                        if platform == 0 or platform == _G.GameUtil.GetPlatform() then
                            return false
                        end
                    end
                    bool = true
                end
                return bool
            end,
            updataNumFun = function()
            end
        },
        [FunctionTouchType.MaxStar] = {
            ---历史最高星级
            num = 0,
            lockDic = {},
            CheckFun = function(value)
                return _G.GlobalConditionManager.CheckCondition(FunctionTouchType.MaxStar, value)
            end,
            updataNumFun = function()
            end
        },
        [_G.FunctionTouchType.DailyActive] = {
            ---日常活跃度
            num = 0,
            lockDic = {},
            CheckFun = function(value)
                return require("ActiveTaskManager"):GetInstance().ActiveValue >= value
            end,
            updataNumFun = function()
                self.FunctionOpenDicType[_G.FunctionTouchType.DailyActive].num = require("ActiveTaskManager"):GetInstance().ActiveValue or 0
            end
        },
        [_G.FunctionTouchType.GuildTrain] = {
            ---公会试炼
            num = 0,
            lockDic = {},
            CheckFun = function(value)
                return require("SociatyModel"):GetInstance():GetChallenge_times() >= value
            end,
            updataNumFun = function()
                self.FunctionOpenDicType[_G.FunctionTouchType.VipLevel].num = require("SociatyModel"):GetInstance():GetChallenge_times()
            end
        },
        [_G.FunctionTouchType.Platform] = {
            ---当前平台
            num = 0,
            lockDic = {},
            CheckFun = function(value)
            end,
            updataNumFun = function()
            end
        },
    }
    ---功能开放id 对应需要解锁的类型映射map {funcId ={type=state}}
    self.ConditionTypeWithId = {}
    ---所有主界面待解锁的功能  {解锁类型={cfg,cfg,cfg},}
    self.FunctionCfgDic = {}
    ---所有主界面待解锁的功能 会关闭的功能  Fun() false功能关闭
    self.FunctionIdCloseFunDic = {}
    ---所有主界面待解锁的功能 会关闭的功能  {id= false功能关闭}
    self.FunctionIdCloseDic = {}

    for key, value in pairs(_G.ConfigManager.main_function_cfg) do
        ---@type function_open_cfg
        local functionOpenCfg
        if value.function_open >= ACTIVITY_INFO_ID then
            --配置activity_info_cfg表解锁
            local activityCfg = _G.ConfigManager.activity_info_cfg[value.function_open]
            if activityCfg and not _G.table.isEmptyOrNil(activityCfg.condition_display) then
                if #activityCfg.condition_display == 1 then
                    functionOpenCfg = _G.ConfigManager.function_open_cfg[activityCfg.condition_display[1]]
                else
                    for i = 1, #activityCfg.condition_display, 2 do
                        if self.FunctionCfgDic[activityCfg.condition_display[i]] == nil then
                            self.FunctionCfgDic[activityCfg.condition_display[i]] = {}
                        end
                        table.insert(self.FunctionCfgDic[activityCfg.condition_display[i]], value)
                    end
                end
            end
        elseif value.function_open > 0 then
            --配置function_open_cfg表解锁
            functionOpenCfg = _G.ConfigManager.function_open_cfg[value.function_open]
        end
        if functionOpenCfg and not _G.table.isEmptyOrNil(functionOpenCfg.condition_type) then
            for i = 1, #functionOpenCfg.condition_type do
                if self.FunctionCfgDic[functionOpenCfg.condition_type[i][1]] == nil then
                    self.FunctionCfgDic[functionOpenCfg.condition_type[i][1]] = {}
                end
                table.insert(self.FunctionCfgDic[functionOpenCfg.condition_type[i][1]], value)
            end
        end
        if not _G.table.isEmptyOrNil(value.Display_condition) then
            if self.FunctionCfgDic[value.Display_condition[1]] == nil then
                self.FunctionCfgDic[value.Display_condition[1]] = {}
            end
            _G.table.insert(self.FunctionCfgDic[value.Display_condition[1]], value)
        end
        ---功能关闭 相关
        if string.IsNullOrEmpty(value.function_close[1]) == false then
            local model = require(value.function_close[1])
            local tFun = value.function_close[2]
            if model and model[tFun] then
                self.FunctionIdCloseDic[key] = true
                self.FunctionIdCloseFunDic[key] = model[tFun]
            end
        end
    end
    --- 当前已解锁功能   [funid]=true
    self.nowOpenFunid = {}
    --- 显示用的功能id    有些功能  未解锁可显示  或 需要解锁但始终不显示
    ---[funid]=true
    self.showFunid = {}
    --功能开放队列
    self.functionQueue = {}
    --- 本次新功能开放显示 (累计  防止打开两次界面)
    self.ShowNewfunctionData = {}
    self.tipsId = {
        [1] = 280101,
        [2] = 280102,
        ---填充
        [3] = 0,
        [4] = 280103,
        [9] = 280105,
        [50] = 110124,
        [54] = 110124,
        [55] = 280107
    }
    self.languageId = {
        ---团队等级达到%s级时开启该功能
        [1] = 90028010101,
        ---通关主线剧情%s时开启该功能
        [2] = 90028010102,
        ---填充
        [3] = 0,
        ---通关灵域巡查%s时开启该功能
        [4] = 90028010103,
        ---创号%d天开启
        [9] = 90028300082,
        ---开服第%s天开放
        [50] = 90028300082,
        [54] = 90028300082,
