function FunctionManager:InitOpenFunid()
    self.FunctionOpenDicType[_G.FunctionTouchType.PlayerLevel].updataNumFun()
    self.FunctionOpenDicType[_G.FunctionTouchType.Section].updataNumFun()
    self.FunctionOpenDicType[_G.FunctionTouchType.Afk].updataNumFun()
    self.FunctionOpenDicType[_G.FunctionTouchType.VipLevel].updataNumFun()
    self.FunctionOpenDicType[_G.FunctionTouchType.TotalCash].updataNumFun()
    self.FunctionOpenDicType[_G.FunctionTouchType.DailyActive].updataNumFun()
    self.FunctionOpenDicType[_G.FunctionTouchType.GuildTrain].updataNumFun()

    local maincfg = _G.ConfigManager.main_function_cfg
    self.nowOpenFunid = {}
    for mainId, _ in pairs(maincfg) do
        if mainId == 5048 or mainId == "5048" then
            local isopen = self:CheckLimit(mainId)
        end
        local isopen = self:CheckLimit(mainId)
        if isopen == true then
            self.nowOpenFunid[mainId] = true
            self:RemoveWaitFunOpen(mainId)
        else
            isopen = self:CheckLimit(mainId, true)
        end
        self:CheckCloseMainFun(mainId)
        ---观影台需要根据渠道id屏蔽
        if mainId == _G.MainFunctionItems.ViewingAD then
            if not require("AdvertisementModel"):GetInstance().isADOpen then
                isopen = false
            end
        end
        --- 解锁  且不是已关闭功能
        if isopen == true and self.FunctionIdCloseDic[mainId] ~= false then
            self.showFunid[mainId] = true
        elseif self:CheckMallCondition(mainId) then
            self.showFunid[mainId] = true
        end
    end
    ---初始化完成后在监听
    self:AddListener()
end

