---是否满足 function_open_cfg 功能开放等级
function FunctionManager:CheckFunctionCfgOpen(FunctionTouchType)
    local functions = {}

    if self.FunctionOpenDicType[FunctionTouchType] ~= nil then
        self.FunctionOpenDicType[FunctionTouchType].updataNumFun()

        local dic = self.FunctionOpenDicType[FunctionTouchType].lockDic
        ---@param Value function_open_cfg_Item
        for id, Value in _G.pairs(dic) do
            local islock = self.FunctionOpenDicType[FunctionTouchType].CheckFun(Value)
            local otherlock = self:CheckOtherCondition(id, FunctionTouchType)
            if islock == true then
                self.FunctionOpenDicType[FunctionTouchType].lockDic[id] = nil
                if otherlock == true then
                    self.FunctionOpenDic[id] = true
                    _G.Events:GetInstance():Broadcast(_G.eFunctionsStatus.OpenCfgFunctionId, id)
                    table.insert(functions, id)
                else
                    self:SetConditionTypeState(id, FunctionTouchType, true)
                end
            end
        end
        --return functions
    end
    --region 临时 检测vip
    ---该功能会导致后面的功能无法正常解锁 现注释掉
    local data = require "PrivilegeManager":GetInstance():GetPrivilegeData({ _G.PrivilegeType.VIP.unlockFunction })
    if data and data[1] then
        local count = 1
        local check_type = type(data[1])
        if check_type == "number" then
            -- 检测是不是数值类型
            count = 1
        else
            count = 2
        end
        ---vip特权解锁条件特权id和功能id对应配置
        local extraCondition = _G.ConfigManager.discrete_cfg[104315]
        ---判断一下main_function_cfg里面是否配置了主界面不显示
        local bol = _G.ConfigManager.main_function_cfg[extraCondition[1][1]].ShowInMainView
        extraCondition = bol and extraCondition or {}
        for i = 1, #data do
            local fun_id = nil
            if count < 2 then
                fun_id = data[1]
            else
                fun_id = data[i][2]
            end
            if fun_id then
                if self.FunctionOpenDic[fun_id] then
                    --已经存在不管
                    --return functions
                else
                    --return functions
                    self.FunctionOpenDic[fun_id] = true
                    for _, v in pairs(extraCondition) do
                        ---vip特权解锁的功能直接开启
                        if fun_id == v[3] then
                            self:AddNewFunId(v[1])
                            break
                        end
                    end
                    _G.Events:GetInstance():Broadcast(_G.eFunctionsStatus.OpenCfgFunctionId, fun_id)
                end
            end
        end
    end
    local resoult, fun_id1 = require "PrivilegeManager":GetInstance():GetPrivilegeBoolen(_G.PrivilegeType.VIP.fightJump)
    if resoult then
        if self.FunctionOpenDic[fun_id1[1]] then
            --已经存在不管
            --return functions
        else
            --return functions
            self.FunctionOpenDic[fun_id1[1]] = true
            _G.Events:GetInstance():Broadcast(_G.eFunctionsStatus.OpenCfgFunctionId, fun_id1[1])
        end
    end
    --endregion
    return functions
end

