end

function FunctionManager:Dispose()
    self:RemoveListener()
    self.isInit = nil
    self.ShowNewfunctionData = nil
    self.functionQueue = nil
    self.showFunid = nil
    self.nowOpenFunid = nil
    self.FunctionCfgDic = nil
    self.AfkFuncArr = nil
    if self.WaitGetAwardTimer then
        self.WaitGetAwardTimer:Stop()
        self.WaitGetAwardTimer = nil
    end
end

---从服务器拉取数据
function FunctionManager:GetDataFormServer()
    require("UserNet"):GetInstance():SetFunctionManagerInstance(self)
    require("UserNet"):GetInstance():GetOpenFunction(_G.handler(self, self.ParseData))
end

---解析数据
---@param data role.s2c_function_open_info 服务器返回数据
function FunctionManager:ParseData(data)
    self:InitFunctionForbidden(data.close_ids)
    self:InitServerFunctionOpen(data.ids, data.award or {})
    self:InitDefaultFunctionOpen()
    self.isInit = true
    base.ParseData(self)
end

---内部方法 设置条件状态
function FunctionManager:SetConditionTypeState(funcId, conditionType, state)
    if not _G.table.isEmptyOrNil(self.ConditionTypeWithId[funcId]) then
        if self.ConditionTypeWithId[funcId] ~= nil then
            if self.ConditionTypeWithId[funcId][conditionType] then
                self.ConditionTypeWithId[funcId][conditionType].state = state
            else
                self.ConditionTypeWithId[funcId][conditionType] = {
                    type = conditionType,
                    state = state
                }
            end
        end
    else
        self.ConditionTypeWithId[funcId] = {}
        self.ConditionTypeWithId[funcId][conditionType] = {
            type = conditionType,
            state = state
        }
    end
end

---初始化功能逻辑
function FunctionManager:InitFunction()
    for key, value in pairs(_G.ConfigManager.function_open_cfg) do
        ---将功能开放id和自身所需条件做映射
        if not self.ConditionTypeWithId[key] then
            self.ConditionTypeWithId[key] = {}
        end
        if not self.FunctionOpenDic[key] then
            --endregin
            -- 支付宝测试版本调整赛季相关功能开放条件
            local condition = value.condition_type
            if _G.AppSetting.IsAlipay then
                local cfg = _G.ConfigManager.discrete_cfg[126103]
                local openIds = cfg[1]
                if _G.table.ContainsValue(openIds, key) then
                    local temp = {}
                    for i = 1, #cfg[2], 2 do
                        _G.table.insert(temp, { cfg[2][i * 2 - 1], cfg[2][i * 2] })
                    end
                    condition = temp
                end
            end

            local Open = _G.GlobalConditionManager.CheckConditionByArray(condition)
            self.FunctionOpenDic[key] = Open
            ---设置map(功能id和条件检测映射)的状态
            local _open = false ---每一个条件是否开启
            if not _G.table.isEmptyOrNil(value.condition_type) then
                for i = 1, #value.condition_type do
                    if Open then
                        self.ConditionTypeWithId[key][value.condition_type[i][1]] = {
                            type = value.condition_type[i][1],
                            state = true
                        }
                        self.FunctionOpenDicType[value.condition_type[i][1]].lockDic[key] = nil
                    else
                        _open = _G.GlobalConditionManager.CheckCondition(
                                value.condition_type[i][1],
                                value.condition_type[i][2]
                        )
                        if _open then
                            self.FunctionOpenDicType[value.condition_type[i][1]].lockDic[key] = nil
                        end
                        self.ConditionTypeWithId[key][value.condition_type[i][1]] = {
                            type = value.condition_type[i][1],
                            state = _open
                        }
                    end
                end
            end
            if Open then
                --领取礼物的回调在MainManager里注册到_G.eFunctionsStatus.OpenCfgFunctionId了
                --self:GetAward(key)
                _G.Events:GetInstance():Broadcast(_G.eFunctionsStatus.OpenCfgFunctionId, key)
            end
            --region 临时填写 VIP 特权 功能解锁
            ---检测有vip  将神召唤,放置推图功能
            local data = require "PrivilegeManager":GetInstance():GetPrivilegeData({ _G.PrivilegeType.VIP.unlockFunction })
            if data and data[1] then
                local count = 1
                local check_type = type(data[1])
                if check_type == "number" then
                    -- 检测是不是数值类型
                    count = 1
                else
                    count = 2
                end
                for i = 1, #data do
                    local fun_id = 0
                    if count < 2 then
                        fun_id = data[i]
                    else
                        fun_id = data[i][2]
                    end
                    if fun_id == key then
                        --("降神召唤： init 初始化")
                        self.FunctionOpenDic[key] = true
                        for type, param in pairs(value.condition_type) do
                            self.FunctionOpenDicType[param[1]].lockDic[key] = nil
                            self:SetConditionTypeState(key, param[1], true)
                        end
                        --领取礼物的回调在MainManager里注册到_G.eFunctionsStatus.OpenCfgFunctionId了
                        --self:GetAward(key)
                        _G.Events:GetInstance():Broadcast(_G.eFunctionsStatus.OpenCfgFunctionId, key)
                    end
                end
            end
            ---战斗跳过
            local resoult, value = require "PrivilegeManager":GetInstance():GetPrivilegeBoolen(_G.PrivilegeType.VIP.fightJump)
            if resoult and key == value[1] then
                self.FunctionOpenDic[key] = true
                if not _G.table.isEmptyOrNil(self.ConditionTypeWithId[key]) then
                    ---将该功能的所有限制条件状态全部设置为true
                    for k, v in pairs(self.ConditionTypeWithId[key]) do
                        v.state = true
                    end
                end
                self.FunctionOpenDicType[_G.FunctionTouchType.PlayerLevel].lockDic[key] = nil
                --领取礼物的回调在MainManager里注册到_G.eFunctionsStatus.OpenCfgFunctionId了
                --self:GetAward(key)
                _G.Events:GetInstance():Broadcast(_G.eFunctionsStatus.OpenCfgFunctionId, key)
            end
        else
            for type, param in pairs(value.condition_type) do
                self:SetConditionTypeState(key, param[1], true)
            end
        end
    end
    self:CacheAfkFuncOpenArr()
    if self.sixClockInitCall then
        self.sixClockInitCall()
        self.sixClockInitCall = nil
    end
end

function FunctionManager:CacheAfkFuncOpenArr()
    self.AfkFuncArr = {}
    for _, v in pairs(_G.ConfigManager.function_open_cfg) do
        if not _G.table.isEmptyOrNil(v.condition_type) then
            for k, type in pairs(v.condition_type) do
                if type[1] == 4 then
                    _G.table.insert(self.AfkFuncArr, { type[2], v.function_preview, v.Id })
                end
            end
        end
    end
    if not _G.table.isEmptyOrNil(self.AfkFuncArr) then
        _G.SortList(
                self.AfkFuncArr,
                function(a)
                    return -a[1]
                end
        )
    end
end

function FunctionManager:GetAfkFuncOpenArr()
    if _G.table.isEmptyOrNil(self.AfkFuncArr) then
        return nil
    else
        return self.AfkFuncArr
    end
end

---初始化默认开启的功能(配置中 type = 1 params = 1 即等级为1)
function FunctionManager:InitDefaultFunctionOpen()
    for key, v in pairs(_G.ConfigManager.function_open_cfg) do
        if not self.FunctionOpenDic[key] then
            local value = v.condition_type
            -- 支付宝测试版本调整赛季相关功能开放条件
            if _G.AppSetting.IsAlipay then
                local cfg = _G.ConfigManager.discrete_cfg[126103]
                local openIds = cfg[1]
                if _G.table.ContainsValue(openIds, key) then
                    local temp = {}
                    for i = 1, #cfg[2], 2 do
                        _G.table.insert(temp, { cfg[2][i * 2 - 1], cfg[2][i * 2] })
                    end
                    value = temp
                end
            end
            if not _G.table.isEmptyOrNil(value) then
                if #value == 1 then
                    for _, type in pairs(value) do
                        if type[1] == _G.FunctionTouchType.PlayerLevel then
                            if type[2] <= 1 then
                                self.FunctionOpenDic[key] = true
                            else
                                self.FunctionOpenDicType[type[1]].lockDic[key] = type[2]
                            end
                        elseif type[1] == _G.FunctionTouchType.ServerTime then
                            if type[2] <= 1 then
                                self.FunctionOpenDic[key] = true
                            else
                                self.FunctionOpenDicType[type[1]].lockDic[key] = type[2]
                            end
                        elseif type[1] == _G.FunctionTouchType.BattleAreaServerTime then
                            if type[2] <= 1 then
                                self.FunctionOpenDic[key] = true
                            else
                                self.FunctionOpenDicType[type[1]].lockDic[key] = type[2]
                            end
                        elseif type[1] == _G.FunctionTouchType.VipLevel then
                            if type[2] <= 1 then
                                self.FunctionOpenDic[key] = true
                            else
                                self.FunctionOpenDicType[type[1]].lockDic[key] = type[2]
                            end
                        else
                            self.FunctionOpenDicType[type[1]].lockDic[key] = type[2]
                        end
                    end
                else
                    for _, type in pairs(value) do
                        self.FunctionOpenDicType[type[1]].lockDic[key] = type[2]
                    end
                end
            end
        end
    end
end

---初始化服务器功能开启列表
---@param ids table 功能开启id组
function FunctionManager:InitServerFunctionOpen(ids, award)
    if not ids or #ids == 0 then
        return
    end
    local condition = {}
    ---服务器标记了但是没有发奖
    for i = 1, #ids do
        if ids[i] ~= 299 then
            -- 299 功能直接关闭 后台不修数据，只能前台改，以后的人不要骂前端
            self.FunctionOpenDic[ids[i]] = true
            local is = true

            for _, value in pairs(award) do
                if value == ids[i] then
                    is = false
                    break
                end
            end
            if is and not self:CheckFunctionForbidden(ids[i]) then
                if #_G.ConfigManager.function_open_cfg[ids[i]].reward > 0 then
                    _G.table.insert(condition, ids[i])
                end
            end
        end
    end
    if #condition > 0 then
        local msg = {}
        msg.function_ids = condition

        require "QuestionAnswerNet":GetInstance():OpenAward(
                msg,
                function(data)
                    _G.StorageManager:GetInstance():ReceiveAwardData(data)
                end
        )
    end

    local cfgTrueList = {}
    ---服务器没有标记并且没有发奖
    for id, info in pairs(_G.ConfigManager.function_open_cfg) do
        if not self.FunctionOpenDic[id] then
            local is = true
            for _, value in pairs(award) do
                if value == id then
                    is = false
                end
            end
            local condition = info.condition_type
            local cfg = _G.ConfigManager.discrete_cfg[126103]
            local openIds = cfg[1]
            if _G.table.ContainsValue(openIds, id) then
                local temp = {}
                for i = 1, #cfg[2], 2 do
                    _G.table.insert(temp, { cfg[2][i * 2 - 1], cfg[2][i * 2] })
                end
                condition = temp
            end
            if is and _G.GlobalConditionManager.CheckConditionByArray(condition) then
                self.FunctionOpenDic[id] = true
                if #info.reward > 0 and not self:CheckFunctionForbidden(id) then
                    _G.table.insert(cfgTrueList, id)
                end
            end
        end
    end

    if #cfgTrueList > 0 then
        local msg = {}
        msg.function_ids = cfgTrueList

        require "QuestionAnswerNet":GetInstance():OpenAward(
                msg,
                function(data)
                    _G.StorageManager:GetInstance():ReceiveAwardData(data)
                end
        )
    end
end

---初始化功能禁用列表
---@param ids number[]
function FunctionManager:InitFunctionForbidden(ids)
    if not ids then
        return
    end
    self.functionForbidden = {}
    for i = 1, #ids do
        self.functionForbidden[ids[i]] = true
    end
end

---更新功能禁用列表
---@param ids number[]
function FunctionManager:UpdateFunctionForbidden(ids)
    if not self.isInit then
        return
    end

    ---@type table<number,boolean>, table<number,boolean>
    local oldForbidden, newForbidden = self.functionForbidden, {}
    if ids then
        for i = 1, #ids do
            newForbidden[ids[i]] = true
        end
    end
    self.functionForbidden = newForbidden

    local main_function_cfg = _G.ConfigManager.main_function_cfg
    --功能禁用事件:
    for functionId, _ in pairs(newForbidden) do
        if self.FunctionOpenDic[functionId] and (not oldForbidden or not oldForbidden[functionId]) then
            _G.Events:GetInstance():Broadcast(_G.eFunctionsStatus.FunctionForbidden, functionId)
            --关闭主页面功能
            for _, cfg in pairs(main_function_cfg) do
                if cfg.function_open == functionId then
                    self:CloseFunById(cfg.Id, true)
                    --break
                end
            end
        end
    end
    --功能解除事件:
