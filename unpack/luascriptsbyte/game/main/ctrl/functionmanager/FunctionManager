                --_G.Events:GetInstance():Broadcast(_G.eFunctionsStatus.FunctionForbidden, functionId)
                --_G.Events:GetInstance():Broadcast(_G.eFunctionsStatus.NewFunction, functionId)
                _G.Events:GetInstance():Broadcast(_G.eFunctionsStatus.OpenCfgFunctionId, functionId)
                --开启主页面功能
                for _, cfg in pairs(main_function_cfg) do
                    if cfg.function_open == functionId then
                        self:OpenFunById(cfg.Id, true)
                        --break
                    end
