---TODO:http://log.youkia.com:8084/browse/ZHJH-9573 和策划确认，在ios提审模式下商场直接解锁
function FunctionManager:CheckMallCondition(mainId)
    if mainId == _G.MainFunctionItems.Mall and _G.AppSetting.IsArraigned and not _G.AppSetting.IsWebGl and _G.AppSetting.IsIos then
        return true
    end
    return false
end

--判断这个按钮的使用限制
---@param functionId MainFunctionItem 功能id
function FunctionManager:CheckCanUse(functionId)
    if self:CheckMallCondition(functionId) then
        return true
    end
    local canUse = false

    local itemData = _G.ConfigManager.main_function_cfg[functionId]
    if itemData.function_open == 0 then
        canUse = true
    else
        canUse = self:CheckLimit(functionId)
    end
    return canUse
end

--获取主界面 显示用的功能id
function FunctionManager:GetNowOpenFunctionID()
    local tb = {}
    local insert = _G.table.insert
    for k, v in pairs(self.showFunid) do
        if v then
            insert(tb, k)
        end
    end
    return tb
end

--新解锁一个功能id
function FunctionManager:AddNewFunId(Funid)
    self.showFunid[Funid] = true

    ---已解锁功能忽略
    if self.nowOpenFunid[Funid] == true then
        return
    end
    self.nowOpenFunid[Funid] = true

    _G.Events:GetInstance():Broadcast(_G.eFunctionsStatus.NewFunction, Funid)

    self:RemoveWaitFunOpen(Funid)

    if Funid == 5036 then
        require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.MacheIcon.id)
    elseif Funid == 44 then
        require("CampsiteModel"):GetInstance():RefredPointAllCamp()
    end
end

--删除已解锁的功能
function FunctionManager:RemoveWaitFunOpen(Funid)
    --- 删除已解锁功能
    ---@param funlist function_open_cfg_Item[]
    for opentype, funlist in pairs(self.FunctionCfgDic) do
        for i, value in pairs(funlist) do
            if value.Id == Funid then
                table.remove(self.FunctionCfgDic[opentype], i)
                return
            end
        end
    end
end

--移动一个新功能
---@param item Transform 要移动的显示对象
---@param id number 功能id
---@param delayTime number 移动速度
function FunctionManager:ItemMove(item, id, delayTime)
    self:GetMainView()
    if self.mainView then
        self.mainView:ItemMove(item, id, delayTime)
    end
end

---判断功能是否解锁
---@param sid number function_open_cfg 表Id
function FunctionManager:CheckFunctionIsUnlock(sid)
    if sid == 0 then
        return true
    end
    local cfg = _G.ConfigManager.function_open_cfg[sid]
    if cfg == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(" function_open_cfg 未找到  " .. tostring(sid))
        end
        return true
    end
    -- --endregin
    return self:CheckCondition(cfg.condition_type, sid)
end

---显示功能未开启提示
---@param sid number function_open_cfg 表Id
function FunctionManager:ShowFuncitonOpenTips(sid)
    local str, mTipsid
    if sid == 156 then
        --冒险关卡跳过功能显示固定提示语句
        mTipsid = _G.AppSetting.IsArraigned and 3706 or 3704
        if mTipsid == 3704 then
            str = _G.GetLangPackValue(_G.GameUtil.GetVoucherArg(90020800026, 90036300034))
        end
    else
        str, mTipsid = self:GetTipsStr(sid)
    end
    _G.PopWindowManager:GetInstance():ShowAllTips(mTipsid, str)
end

function FunctionManager:GetTipsStr(sid)
    local funopenCfg = _G.ConfigManager.function_open_cfg[sid]
    if funopenCfg == nil then
        return
    end
    local _, lockType = _G.GlobalConditionManager.CheckConditionByArray(funopenCfg.condition_type)
    if lockType then
        return self:GetStrWithType(lockType[1], lockType[2], nil, sid)
    else
        ---按以前的逻辑给默认
        if not _G.table.isEmptyOrNil(funopenCfg.condition_type) then
            return self:GetStrWithType(funopenCfg.condition_type[1][1], funopenCfg.condition_type[1][2])
        end
    end

    if _G.AppSetting.DEBUG then
        _G.Log("检测条件FunctionManager,无condition_type")
    end
    return
end

---@return table 返回所有未通过condition的提示
function FunctionManager:GetAllTipsStr(sid)
    local funopenCfg = _G.ConfigManager.function_open_cfg[sid]
    if funopenCfg == nil then
        return
    end
    local _, lockType = _G.GlobalConditionManager.CheckConditionByArray(funopenCfg.condition_type, true)
    local str, mTipsid
    local strT = {}
    local mTipsidT = {}
    if not _G.table.isEmptyOrNil(lockType) then
        for i = 1, #lockType do
            str, mTipsid = self:GetStrWithType(lockType[i][1], lockType[i][2], nil, sid)
            table.insert(strT, str)
            table.insert(mTipsidT, mTipsid)
        end
        return strT, mTipsidT
    else
        ---按以前的逻辑给默认
        if not _G.table.isEmptyOrNil(funopenCfg.condition_type) then
            str, mTipsid = self:GetStrWithType(funopenCfg.condition_type[1][1], funopenCfg.condition_type[1][2])
            table.insert(strT, str)
            table.insert(mTipsidT, mTipsid)
            return strT, mTipsidT
        end
    end

    if _G.AppSetting.DEBUG then
        _G.Log("检测条件FunctionManager,无condition_type")
    end
    return strT, mTipsidT
end

---获取提示
---@param type number 开启条件类型
---@param params number 参数
---@param isDark boolean 是不是暗底文字
---@param sid number 需要特殊处理的function_open_cfg表id 可不传入
function FunctionManager:GetStrWithType(type, params, isDark, sid)
    ---开启条件类型（1-等级；2-主线副本；4-主线放置）
    local condition_type = type

    local mTipsid = self.tipsId[condition_type]
    --如果是暗底需要改文本ID(文字颜色由浅色改为深色)
    local mLanguageId = (isDark and condition_type == 4) and 90020600071 or self.languageId[condition_type]

    local str = ""
    if condition_type == 1 then
        if params > 10000 then
            str = _G.LangUtil.GetLangPackValue(90100000165)
        else
            str = _G.LangUtil.GetLangPackValue(mLanguageId, params)
        end
    elseif condition_type == 2 then
        local sectCfg = _G.ConfigManager.main_section_cfg[params]
        str = _G.LangUtil.GetLangPackValue(mLanguageId, _G.LangUtil.GetLangPackValue(sectCfg.Name))
    elseif condition_type == 4 then
        local sectCfg = _G.ConfigManager.afk_cfg[params]
        if sectCfg then
            str = _G.LangUtil.GetLangPackValue(mLanguageId, sectCfg.chapter, sectCfg.section)
        end
    elseif condition_type == 50 then
        str = _G.TimeUtil.TranslateDayForStr(
                (params - 1) * 86400 + _G.PlayerModel:GetInstance():GetServerOpenTime() - _G.TimeUtil.GetServerUnixTime()
        )
    elseif condition_type == 54 then
        str = _G.TimeUtil.TranslateDayForStr(
                (params - 1) * 86400 + _G.PlayerModel:GetInstance():GetBattleOpenTime() - _G.TimeUtil.GetServerUnixTime()
        )
    elseif condition_type == 9 then
        if sid and self.specialTip[sid] ~= nil then
            str = _G.LangUtil.GetLangPackValue(self.specialTip[sid][1], params)
            mTipsid = self.specialTip[sid][2]
        else
            str = _G.TimeUtil.TranslateDayForStrSix(
                    (params - 1) * 86400 + _G.PlayerModel:GetInstance():GetCreateRoleTime() -
                            _G.TimeUtil.GetServerUnixTime()
            )
        end
    elseif condition_type == 55 then
        local name = _G.GetLangPackValue(_G.ConfigManager.hell_title_cfg[params].name)
        str = _G.LangUtil.GetLangPackValue(mLanguageId, name)
    end
    return str, mTipsid
end

---检测功能是否要进行显示 (主要用来给页签功能显示锁)
---@param sid number function_open sid
---@param node UnityEngine.Transform| UnityEngine.GameObject
---@param IsHideBtn boolean true 根据配置is_display 控制按钮显示
function FunctionManager:CheckIsDisplay(sid, node, IsHideBtn)
    if not self.ShowLock then
        self.ShowLock = {}
    end

    local isUnLock = self:CheckFunctionIsUnlock(sid)
    if isUnLock then
        if IsHideBtn then
            _G.GameUtil.SetActiveByCondition(node, true)
        end
        return true
    else
        local cfg = _G.ConfigManager.function_open_cfg[sid]
        if cfg.is_display then
            if node:GetChildE(node:GetChildCountE() - 1):GetName() ~= "@_aorbtn_Lock" and not self.ShowLock[sid] then
                self.ShowLock[sid] = true
                _G.PoolsManager:GetInstance():Spawn(
                        LockPath,
                        _G.ePoolType.Temporary,
                        node,
                        function(trans)
                            local grayComp = node:GetComponentsInChildren(_G.typeof(_G.CS.IGrayMember))
                            if grayComp then
                                local count = grayComp.Length
                                for i = 1, count do
                                    grayComp[i - 1]:SetGray(true)
                                end
                            end
                            local text = node:GetComponentInChildrenE(_G.typeof(_G.CS.AorText))
                            if text then
                                text.color = _G.Color.gray
                            end
                            trans:SetAnchorPosition(0, 0)
                            --trans:SetRectOffSetToZero()
                            trans:GetComponentE(_G.typeof(_G.CS.AorButton)).onClick:AddListener(
                                    function()
                                        self:ShowFuncitonOpenTips(sid)
                                    end
                            )
                            self.ShowLock[sid] = nil
                        end
                )
            end
            if IsHideBtn then
                _G.GameUtil.SetActiveByCondition(node, true)
            end
            return true
        end
        if IsHideBtn then
            _G.GameUtil.SetActiveByCondition(node, false)
        end

        return false
    end
end

function FunctionManager:OnSixClockUpdate(endcall)
    ---ZHJ-33628会走在InitFunction前面，无法领取奖励
    self.sixClockInitCall = function()
        self:DoFunctionAction(_G.FunctionTouchType.ServerTime)
        self:DoFunctionAction(_G.FunctionTouchType.BattleAreaServerTime)
        self:DoFunctionAction(_G.FunctionTouchType.PlayerCreateTime)
    end
    self.super.OnSixClockUpdate(self, endcall)
end
