    end

    local minFunIDArr = self:CheckMainFunctionOpen(touchType)
    for key, value in pairs(minFunIDArr) do
        self:AddNewFunId(value)
    end

    _G.Events:GetInstance():Broadcast(_G.eFunctionsStatus.OpenFunctionNewEvent)
