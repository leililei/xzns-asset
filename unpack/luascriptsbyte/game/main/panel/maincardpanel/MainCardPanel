local illustratedPrefabs = {
    card = "UIH5/MainView/Panel/illustrated/$_obj_cardIllustrated",
    artifact = "UIH5/MainView/Panel/illustrated/ArtifactIllustrationView",
    spiritual = "UIH5/Spiritual/SpiritualIllustrationView"
}
local illustratedViews = {
    card = "IllustrationView",
    artifact = "ArtifactIllustrationView",
    spiritual = "SpiritualIllustrationView",
}

if _G.AppSetting.IsXzns then
    illustratedPrefabs.card = "UIH5_xzns/MainView/Panel/illustrated/$_obj_cardIllustrated"
    illustratedPrefabs.artifact = "UIH5_xzns/MainView/Panel/illustrated/ArtifactIllustrationView"
    illustratedPrefabs.spiritual = "UIH5_xzns/Spiritual/SpiritualIllustrationView"
end

---@class MainCardPanel : UIBaseView 英雄面板
---@field go_table _obj_cardPanel_GoTable
---@field cardView CardShowView_CardBag                     @卡牌视图
---@field cardIllustration IllustrationView                 @卡牌图鉴
---@field artifactView ArtifactIllustrationView             @神器图鉴
---@field spiritualView SpiritualIllustrationView           @灵契图鉴
local MainCardPanel = _G.BaseClass("MainCardPanel", _G.UIBaseView)

function MainCardPanel:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj)

    --初始化CardView
    self.go_table.obj_card:SetActiveE(1)
    self.cardView = self:AddComponent(self.go_table.obj_card, require("CardShowView_CardBag").New(self.go_table.obj_card))

    self.go_table.obj_card:SetActiveE(0)
    self.go_table.obj_cardIllustration:SetActiveE(0)
    self.go_table.obj_spiritual:SetActiveE(0)
    self.go_table.obj_artifact:SetActiveE(0)
end

function MainCardPanel:OnCreate()
    --local resources = _G.ConfigManager.ui_cfg.CardShowView.resources
    --self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, resources))
    --self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))

    self:InitToggle()
    self.selecttoggle="card"
    self.go_table.toggle_card.isOn = false
    --self.go_table.toggle_card.isOn = true
    self:InitSelectToggle()
    self:UpdateView()
end

function MainCardPanel:OnEnable()
    --调用IllustrationView:UpdateView()时布局尚未重绘, LoopListView2渲染将出现问题, 延迟一帧刷新
    _G.DelayFrameDo(function()
        if self:IsNil() then
            return
        end
        if self.go_table.obj_cardIllustration:GetActiveSelf() == 1 then
            if self.cardIllustration then
                self.cardIllustration:UpdateView()
            end
        elseif self.go_table.obj_spiritual:GetActiveSelf() == 1 then
            if self.spiritualView then
                self.spiritualView:UpdateView()
            end
        elseif self.go_table.obj_artifact:GetActiveSelf() == 1 then
            if self.artifactView then
                self.artifactView:UpdateView()
            end
        end
        self.go_table.toggle_card.isOn = false
        --self.go_table.toggle_card.isOn = true
        self:InitSelectToggle()
    end)
end

---更新视图显示
---@return void
function MainCardPanel:UpdateView()
    self:UpdateIllustratedToggles()
end

---更新图鉴toggle显示
---@return void
function MainCardPanel:UpdateIllustratedToggles()
    --卡牌图鉴是否已解锁(常驻显示)
    self.go_table.toggle_cardIllustration:SetActiveE(1)

    --神器图鉴是否已解锁
    local isUnlock1 = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.ArtifactDraw)
    self.go_table.toggle_artifact:SetActiveE(isUnlock1 and 1 or 0)
    --宝物图鉴是否已解锁
    local isUnlock2 = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Spiritual)
    self.go_table.toggle_spiritual:SetActiveE(isUnlock2 and 1 or 0)
end

---刷新卡牌列表信息
---@return void
function MainCardPanel:RefreshCardList()
    if not self.cardView then
        return
    end
    self.cardView:RefreshCardList()
end

function MainCardPanel:InitToggle()
    self.toggles = {
        card = _G.GetAutoGoTable(
            self.go_table.toggle_card,
            _G.handlerbind(self, self.OnClickToggle, "card", _G.handler(self, self.OnCard))
        ),
        card1 = _G.GetAutoGoTable(
            self.go_table.toggle_cardIllustration,
            _G.handlerbind(self, self.OnClickToggle, "card1", _G.handler(self, self.OnCardIllustration))
        ),
        spiritual = _G.GetAutoGoTable(
            self.go_table.toggle_spiritual,
            _G.handlerbind(self, self.OnClickToggle, "spiritual", _G.handler(self, self.OnSpiritual))
        ),
        artifact = _G.GetAutoGoTable(
            self.go_table.toggle_artifact,
            _G.handlerbind(self, self.OnClickToggle, "artifact", _G.handler(self, self.OnArtifact))
        )
    }
end

---点击选项卡
---@return void
function MainCardPanel:OnClickToggle(_, isOn, key, call)
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if call then
        call(isOn)
    end
end

function MainCardPanel:OnCard(isOn)
    self.go_table.obj_card:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    self.cardView:InitCard()
end

function MainCardPanel:OnCardIllustration(isOn)
    if self.cardIllustration then
        if isOn then
            self.cardIllustration:Show()
        else
            self.cardIllustration:Hide()
        end
    end
    self.go_table.obj_cardIllustration:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    if not self.cardIllustration then
        self.cardIllustration = true
        _G.PoolsManager:GetInstance():Spawn(
            illustratedPrefabs.card,
            _G.ePoolType.UIItem,
            self.go_table.obj_cardIllustration,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                --如果父节点activeSelf为false，此时不能创建Component实例(销毁)
                if trans and trans:GetctiveInHierarchy() ~= 1 then
                    _G.DestroyObject(trans)
                    return
                end
                local view = self:AddComponent(trans, require(illustratedViews.card).New(trans))
                self.cardIllustration = view
                self.cardIllustration:Show()
            end
        )
    elseif self.cardIllustration ~= true then
        self.cardIllustration:UpdateView()
    end
end

function MainCardPanel:OnSpiritual(isOn)
    self.go_table.obj_spiritual:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    if not self.spiritualView then
        _G.PoolsManager:GetInstance():Spawn(
            illustratedPrefabs.spiritual,
            _G.ePoolType.UIItem,
            self.go_table.obj_spiritual,
            function(trans)
                if self:IsNil() or self.spiritualView then
                    _G.DestroyObject(trans)
                    return
                end
                --如果父节点activeSelf为false，此时不能创建Component实例(销毁)
                if trans and trans:GetctiveInHierarchy() ~= 1 then
                    _G.DestroyObject(trans)
                    return
                end
                local view = self:AddComponent(trans, require(illustratedViews.spiritual).New(trans))
                self.spiritualView = view
                view:UpdateView()
            end
        )
    else
        self.spiritualView:UpdateView()
    end
end

function MainCardPanel:OnArtifact(isOn)
    self.go_table.obj_artifact:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    if not self.artifactView then
        _G.PoolsManager:GetInstance():Spawn(
            illustratedPrefabs.artifact,
            _G.ePoolType.UIItem,
            self.go_table.obj_artifact,
            function(trans)
                if self:IsNil() or self.artifactView then
                    _G.DestroyObject(trans)
                    return
                end
                --如果父节点activeSelf为false，此时不能创建Component实例(销毁)
                if trans and trans:GetctiveInHierarchy() ~= 1 then
                    _G.DestroyObject(trans)
                    return
                end
                local view = self:AddComponent(trans, require(illustratedViews.artifact).New(trans))
                self.artifactView = view
                view:UpdateView()
            end
        )
    else
        self.artifactView:UpdateView()
    end
end
function MainCardPanel:InitSelectToggle()
    if self.selecttoggle=="card" then
        self.go_table.toggle_card.isOn=true
    elseif self.selecttoggle=="card1" then
        self.go_table.toggle_cardIllustration.isOn=true
    elseif self.selecttoggle=="spiritual" then
        self.go_table.toggle_spiritual.isOn=true
    elseif self.selecttoggle=="artifact" then
        self.go_table.toggle_artifact.isOn=true
    end
    self.selecttoggle="card"
end

return MainCardPanel
