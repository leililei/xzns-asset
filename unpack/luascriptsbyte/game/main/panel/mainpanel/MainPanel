function MainPanel:UpdateCommunity()
    local curCashNum = require("MallManager"):GetInstance():GetCashRmb() or 0
    local version = _G.ConfigManager.discrete_cfg[100108][1][1]
    local condition = 0
    if version == 1 then
        local storeGearId = _G.ConfigManager.discrete_cfg[106205][1][1]
        local finalPrice = require "MallManager":GetInstance():GetFinalPrice(storeGearId)
        condition = finalPrice
    elseif version == 2 then
        condition = _G.ConfigManager.discrete_cfg[106205][1][2]
    end

    if curCashNum < condition then
        return
    end

    ---ZHJH-7844【客户端】贵宾邀请功能移植（妙悦单独）
    local Isshow = _G.GameUtil.GetFunctionData(_G.FunctionBlock.VIPInvitation)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(285) then
        return
    end

    local isMain = _G.MainManager:GetInstance().isInMainView
    if not isMain or _G.JumpManager:GetInstance().IsJumping then
        return
    end
    if require "MallManager":GetInstance():GetCashRmb() >= condition then
        local isShowVip = _G.PlayerPrefsManager.GetInt(_G.tostring(_G.PlayerModel:GetInstance().role_uid) .. "ShowVip") or 0
        if isShowVip == 0 and Isshow > 0 then
            if Isshow==1 then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.VipView.Name)
                _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "ShowVip", 1)
            else
                local nowtime = TimeUtil.GetServerUnixTime()
                local jilu = _G.PlayerPrefsManager.GetString(_G.tostring(_G.PlayerModel:GetInstance().role_uid) .. "VIPStart")
                local jilutime = string.IsNullOrEmpty(jilu) and 0 or tonumber(jilu)
                local isCanShow = jilutime > 0 and (jilutime <= nowtime - _G.ConfigManager.discrete_cfg[201501][1][1])
                if isCanShow then
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.VipView.Name)
                    _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "ShowVip", 1)
                elseif jilutime > 0 and (jilutime > nowtime - _G.ConfigManager.discrete_cfg[201501][1][1]) then
                    _G.DelayDo(jilutime + _G.ConfigManager.discrete_cfg[201501][1][1] - nowtime, function()
                        if table.isEmptyOrNil(self.go_table) then
                            return
                        end
                        self:UpdateCommunity()
                    end)
                end
            end
        end
    end
end

