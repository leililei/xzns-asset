---左上按钮列表
function MainPanel:OnClickTLArrow(isInit)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(286) or
            not self.functionTypeCfgs or #self.functionTypeCfgs[_G.MainFunctionType.TopLeft] <= 1
    then
        self.go_table.aorbtn_tlUpArrow:SetActiveE(0)
        self.go_table.aorbtn_tlDownArrow:SetActiveE(0)
        return
    end
    self.go_table.aorbtn_tlUpArrow:SetActiveE(self.unfoldTLArrow and 1 or 0)
    self.go_table.aorbtn_tlDownArrow:SetActiveE(self.unfoldTLArrow and 0 or 1)
    if not self.tlListRect then
        self.tlListRect = self.scrolls[_G.MainFunctionType.TopLeft]:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI
                                                                                              .ScrollRect))
    end
    local count = 0
    if self.functionTypeCfgs[_G.MainFunctionType.TopLeft] then
        count = #self.functionTypeCfgs[_G.MainFunctionType.TopLeft]
    end
    if self.activityTypeData and self.activityTypeData[_G.MainFunctionType.TopLeft] then
        count = count + #self.activityTypeData[_G.MainFunctionType.TopLeft]
    end
    if self.unfoldTLArrow then
        if not isInit then
            self.scrolls[_G.MainFunctionType.TopLeft]:UpdateCount(count)
        end

        ---设置箭头位置
        local showMaxNum = 5
        if _G.AppSetting.IsXzns then
            local startY = 322
            if count < showMaxNum then
                y = startY - (math.min(count, showMaxNum) - 1) * 104
            else
                y = -34
            end
            self.go_table.aorbtn_tlUpArrow:SetAnchorPosition(-14, y)
        else
            local _, height = self.go_table.scrollloopvectical_topLeftBtn:GetRectTransformSize()
            if count >= showMaxNum then
                self.go_table.aorbtn_tlUpArrow:SetAnchorPosition(0, -45)
            else
                ---111是item的高度和滑动列表item间的间距之和
                self.go_table.aorbtn_tlUpArrow:SetAnchorPosition(0,
                        (showMaxNum - count - 1) * (height - 35) / (showMaxNum - 1))
            end
        end
    else
        self.scrolls[_G.MainFunctionType.TopLeft]:UpdateCount(_G.Mathf.Min(1, count))
    end
    self.tlListRect.enabled = self.unfoldTLArrow
end

---右上按钮列表
function MainPanel:OnClickTRArrow(isInit)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(286) or
            not self.functionTypeCfgs or _G.table.isEmptyOrNil(self.functionTypeCfgs[_G.MainFunctionType.TopRight])
    then
        self.go_table.aorbtn_trUpArrow:SetActiveE(0)
        self.go_table.aorbtn_trDownArrow:SetActiveE(0)
        return
    end
    local count = 0
    if self.functionTypeCfgs[_G.MainFunctionType.TopRight] then
        count = #self.functionTypeCfgs[_G.MainFunctionType.TopRight]
    end
    if self.activityTypeData and self.activityTypeData[_G.MainFunctionType.TopRight] then
        count = count + #self.activityTypeData[_G.MainFunctionType.TopRight]
    end
    if _G.AppSetting.IsXzns then
        self.go_table.aorbtn_trUpArrow:SetActiveE(self.unfoldTRArrow and 1 or 0)
        self.go_table.aorbtn_trDownArrow:SetActiveE(self.unfoldTRArrow and 0 or 1)
        local showMaxNum = 5
        if self.unfoldTRArrow then
            if not isInit then
                self.scrolls[_G.MainFunctionType.TopRight]:UpdateCount(count)
            end
            local startY = 328
            if count < showMaxNum then
                y = startY - (math.min(count, showMaxNum) - 1) * 104
            else
                y = -46
            end
            self.go_table.aorbtn_trUpArrow:SetAnchorPosition(-57, y)
        else
            if not isInit then
                self.scrolls[_G.MainFunctionType.TopRight]:UpdateCount(_G.Mathf.Min(1, count))
            end
        end
    else
        self.go_table.aorbtn_trUpArrow:SetActiveE(self.unfoldTRArrow and 1 or 0)
        self.go_table.aorbtn_trDownArrow:SetActiveE(self.unfoldTRArrow and 0 or 1)

        if self.unfoldTRArrow then
            if not isInit then
                self.scrolls[_G.MainFunctionType.TopRight]:UpdateCount(count)
            end

            local _, height = self.go_table.scrollloopvectical_topLeftBtn:GetRectTransformSize()
            ---设置箭头位置
            local showMaxNum = 5
            if count >= showMaxNum then
                self.go_table.aorbtn_trUpArrow:SetAnchorPosition(0, -25)
            else
                ---19是因为最后一个item显示了1/3的原因，111是item的高度和滑动列表item间的间距之和
                self.go_table.aorbtn_trUpArrow:SetAnchorPosition(0,
                        (showMaxNum - count - 1) * ((height - 50) / (showMaxNum - 1)) + 20)
            end
        else
            if not isInit then
                self.scrolls[_G.MainFunctionType.TopRight]:UpdateCount(0)
            end
        end
    end
end

--endregion

function MainPanel:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_enterBanner1 then
        local data = self.bannerData[1]
        if data then
            local isActivity = data.tag ~= nil
            if isActivity and data.tag == -1 then
                return
            end
            self:OnClickBtnItem(nil, nil, isActivity, data)
        end
    elseif go == self.go_table.aorbtn_enterBanner2 then
        local data = self.bannerData[2]
        if data then
            local isActivity = data.tag ~= nil
            if isActivity and data.tag == -1 then
                return
            end
            self:OnClickBtnItem(nil, nil, isActivity, data)
        end
    elseif go == self.go_table.aorbtn_chatView then
        self.go_table.obj_minChatView:SetActiveE(0)
        _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.ChatView.Name,
                self.mMainManager.mainType or _G.ChatType.world
        )
    elseif go == self.go_table.aorbtn_hellRoad or go == self.go_table.aorbtn_hellRoad2 then
        _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.MilitaryRankView.Name,
                _G.handler(self, self.UpdateHell)
        )
    elseif go == self.go_table.aorbtn_tlUpArrow or go == self.go_table.aorbtn_tlDownArrow then
        self.unfoldTLArrow = not self.unfoldTLArrow
        self:OnClickTLArrow()
    elseif go == self.go_table.aorbtn_trUpArrow or go == self.go_table.aorbtn_trDownArrow or go == self.go_table.aorbtn_trBg then
        self.unfoldTRArrow = not self.unfoldTRArrow
        self:OnClickTRArrow()
    elseif go == self.go_table.aorbtn_fold then
        self.foldBtnState = not self.foldBtnState
        self:ShowBtnFoldZone()
    elseif go == self.go_table.aorbtn_usmt then
        ---mt联动入口
        local data = self.activityTypeData[self.ldFunType]
        if data and data[1] then
            self.mMainManager:OnActivityBtnClick(data[1].tag)
        end
    end
end

function MainPanel:ShowBtnFoldZone()
    local visible = self.foldBtnState == false and 1 or 0
    self.go_table.scrollloopvectical_bottomLeftBtn:SetActiveE(visible)
    self.go_table.scrollloopvectical_bottomRightBtn:SetActiveE(visible)
    self.go_table.scrollloopvectical_bottomLeftBtn2:SetActiveE(visible)
end

function MainPanel:OnDestroy()
    self:RemoveAllListener()
    if self.Timers then
        self.Timers:Stop()
        self.Timers = nil
    end
    if self.bannerTimer then
        self.bannerTimer:Stop()
        self.bannerTimer = nil
    end
    if self.bannaerActivityTimer then
        self.bannaerActivityTimer:Stop()
        self.bannaerActivityTimer = nil
    end
    if self.initActivityBtnTimer then
        self.initActivityBtnTimer:Stop()
        self.initActivityBtnTimer = nil
    end
    if self.tweer1 then
        self.tweer1:Kill()
        self.tweer1 = nil
    end
    if self.tweer2 then
        self.tweer2:Kill()
        self.tweer2 = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.UpdateDrawIcon, self)
    _G.Events:GetInstance():RemoveListener(_G.CardHallViewShow.Open, self.UpdateSPNewFunctionIcon, self)
    _G.Events:GetInstance():RemoveListener(_G.GemstoneViewShow.Open, self.UpdateSPNewFunctionIcon, self)
    self.effectFlag = nil
    self.go_table = nil
    if self.npc then
        for _, v in pairs(self.npc) do
            _G.DOTween.Kill(v)
        end
        self.npc = nil
    end
end

return MainPanel
