function MainPanel:PlayAnimation()
    local animator = self.go_table.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    local first = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.MainPanelFirstEnter, 1)
    if first == 1 then
        animator:Play("show")
        self.PlayedAnimation = true
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.MainPanelFirstEnter, 0)
        _G.GuideManager:GetInstance():HideGuide()
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ShadowTopView.Name)
        _G.AudioManager.RefreshCurMusicVolume()
        _G.AudioManager.SetMusicVolume(0)
        _G.AudioManager.PlayAudioByAudioCfgID(1015)
        _G.DelayDo(8, function()
            _G.GuideManager:GetInstance():DisPlayGuide()
            _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ShadowTopView.Name)
            _G.AudioManager.RestoreBackgroundMusic()
        end)
    else
        animator:Play("idle")
    end
end

function MainPanel:CheckMTActivityIsOpen()
    local ldNum = 0
    if self.activityTypeData and self.activityTypeData[self.ldFunType] then
        ldNum = ldNum + #self.activityTypeData[self.ldFunType]
    end
    if self.functionTypeCfgs and self.functionTypeCfgs[self.ldFunType] then
        ldNum = ldNum + #self.functionTypeCfgs[self.ldFunType]
    end

    local isopen = false

    local act = require "ActivitySynManager":GetInstance():GetActivityWithTypeId(10067)
    if act then
        local actID = act:GetActivityID()
        isopen = require "ActivitySynManager":GetInstance():CheckActivityOpened(actID)
    end
    ---活动开了并且联动布局配了
    if isopen and ldNum > 0 then
        return true
    end
    return false
end

