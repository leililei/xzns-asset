function MainPanel:InitBanner()
    self:CheckBannerData()
    if not self.curBannerIdx then
        self.curBannerDataIdx = 1
        self.curBannerIdx = 1
    end
    local delay = _G.ConfigManager.discrete_cfg[100142][1][1]
    self.bannerSpeed = _G.ConfigManager.discrete_cfg[100142][1][2]
    self:InitBannerDrag()
    self:InitBannerActivityTimer()
    if not self.bannerTimer then
        self:UpdateBannerShow()
        self.bannerTimer = _G.TimerManager:GetInstance():GetTimer(delay, self.UpdateBanner, self, false, false)
        self.bannerTimer:Start()
    else
        self:UpdateBannerShow()
    end
end

