    return { tag = -1, index = 0, icon = "ImagesH5/hMain/ui_zjm_banner_pic" }
end

function MainPanel:CheckBannerData()
    if self.activityTypeData == nil then
        self.activityTypeData = { [self.bannerFunType] = {} }
    end
    local bannerNum = #self.activityTypeData[self.bannerFunType] + #self.functionTypeCfgs[self.bannerFunType]
    if bannerNum == 0 then
        -- _G.table.insert(self.activityTypeData[self.bannerFunType], self:CreateEmptyBannerData())
    elseif bannerNum > 1 then
        for i, v in pairs(self.activityTypeData[self.bannerFunType]) do
            if v.tag == -1 then
                _G.table.remove(self.activityTypeData[self.bannerFunType], i)
                break
            end
        end
    end
    --检查TopRightHorizontal列表是否存在配置
    local fixedNum = #self.functionTypeCfgs[_G.MainFunctionType.Fixed]
    local fixedData = self.activityTypeData[_G.MainFunctionType.Fixed]
    if fixedData then
        fixedNum = fixedNum + #fixedData
    end
    local topRightNum = #self.functionTypeCfgs[_G.MainFunctionType.TopRightHorizontal]
    local topRightData = self.activityTypeData[_G.MainFunctionType.TopRightHorizontal]
    if topRightData then
        topRightNum = topRightNum + #topRightData
    end
    self.go_table.obj_bannerScreen:SetActiveE(bannerNum > 0 and 1 or 0)
    self.go_table.scrollloopvectical_topRight2Btn:SetActiveE(topRightNum > 0 and 1 or 0)
    self.rightLimit = (bannerNum > 0 or fixedNum > 0) and 4 or 5
    if not _G.AppSetting.IsXzns then
        self.go_table.scrollloopvectical_topRightBtn:SetAnchorPosition(
                -67.5,
                (bannerNum > 0 or fixedNum > 0) and -225 or -140
        )
        self.go_table.scrollloopvectical_topRightBtn:SetRectTransformSize(
                120,
                (bannerNum > 0 or fixedNum > 0) and 484 or 591
        )
    end
    local fType = _G.MainFunctionType.TopRight
    local fNum = self.functionTypeCfgs[fType] and #self.functionTypeCfgs[fType] or 0
    local count = #self.activityTypeData[fType] + fNum
    self:UpdateScrollRectVertical(fType, count)
end

function MainPanel:UpdateBanner(reverse)
    local nextIdx = 3 - self.curBannerIdx
    if #self.activityTypeData[self.bannerFunType] + #self.functionTypeCfgs[self.bannerFunType] < 2 then
        self:UpdateBannerShow()
        return
    end
    local imgStr = "aorrawimage_banner"
    self.bannerMoving = true
    if reverse then
        self.tweer1 = self.go_table[imgStr .. nextIdx]:DOLocalMoveX(0, self.bannerSpeed):SetEase(_G.CS.DG.Tweening.Ease
                                                                                                   .Linear)
        self.tweer2 = self.go_table[imgStr .. self.curBannerIdx]:DOLocalMoveX(-336, self.bannerSpeed):SetEase(
                _G.CS.DG.Tweening.Ease.Linear
        )                 :OnComplete(
                function()
                    self.go_table[imgStr .. self.curBannerIdx]:SetLocalPosition(336, 0, 0)
                    self.curBannerIdx = nextIdx
                    self.curBannerDataIdx = self.curBannerDataIdx + 1
                    if
                    self.curBannerDataIdx >
                            #self.activityTypeData[self.bannerFunType] + #self.functionTypeCfgs[self.bannerFunType]
                    then
                        self.curBannerDataIdx = 1
                    end
                    self:UpdateBannerShow()
                    self.bannerMoving = false
                end
        )
    else
        self.go_table[imgStr .. nextIdx]:SetLocalPosition(-336, 0, 0)
        self:UpdateBannerShow(reverse)
        self.tweer1 = self.go_table[imgStr .. nextIdx]:DOLocalMoveX(0, self.bannerSpeed):SetEase(_G.CS.DG.Tweening.Ease
                                                                                                   .Linear)
        self.tweer2 = self.go_table[imgStr .. self.curBannerIdx]:DOLocalMoveX(336, self.bannerSpeed):SetEase(
                _G.CS.DG.Tweening.Ease.Linear
        )                 :OnComplete(
                function()
                    self.curBannerIdx = nextIdx
                    self.curBannerDataIdx = self.curBannerDataIdx - 1
                    if self.curBannerDataIdx < 1 then
                        self.curBannerDataIdx = #self.activityTypeData[self.bannerFunType] +
                                #self.functionTypeCfgs[self.bannerFunType]
                    end
                    self:UpdateBannerShow()
                    self.bannerMoving = false
                end
        )
    end
end

function MainPanel:UpdateBannerShow(reverse)
    local num = #self.functionTypeCfgs[self.bannerFunType] + #self.activityTypeData[self.bannerFunType]
    if num == 0 then
        return
    end
    if self.curBannerDataIdx > num then
        self.curBannerDataIdx = 1
    end
    local nextId
    if reverse then
        nextId = self.curBannerDataIdx - 1
        if nextId < 1 then
            nextId = num
        end
    else
        nextId = self.curBannerDataIdx + 1
        if nextId > num then
            nextId = 1
        end
    end
    local curIsAct, curData = self:GetBannerData(self.curBannerDataIdx)
    local nextIsAct, nextData = self:GetBannerData(nextId)
    local nextIdx = 3 - self.curBannerIdx
    self.go_table["aorrawimage_banner" .. self.curBannerIdx]:LoadImage(curIsAct and curData.icon or curData.Icon)
    self.go_table["aorrawimage_banner" .. nextIdx]:LoadImage(nextIsAct and nextData.icon or nextData.Icon)

    local time = self:GetBannerTime(curData)
    self.go_table["obj_bannerTime" .. self.curBannerIdx]:SetActiveE(time ~= nil and 1 or 0)
    time = self:GetBannerTime(nextData)
    self.go_table["obj_bannerTime" .. nextIdx]:SetActiveE(time ~= nil and 1 or 0)

    local curParam = curIsAct and (curData.redpointParam or -1) or -1
    local nextParam = nextIsAct and (nextData.redpointParam or -1) or -1
    if not curIsAct and curData.Id == _G.MainFunctionItems.MaterialCard then
        curParam = curData.Id
    end
    if not nextIsAct and nextData.Id == _G.MainFunctionItems.MaterialCard then
        nextParam = nextData.Id
    end
    self.go_table["obj_bannerRedpoint" .. self.curBannerIdx]:UpdateRedPointItemIDAndParam(
            curIsAct and (curData.redpointID or 0) or curData.RedPointId,
            curParam
    )
    self.go_table["obj_bannerRedpoint" .. nextIdx]:UpdateRedPointItemIDAndParam(
            nextIsAct and (nextData.redpointID or 0) or nextData.RedPointId,
            nextParam
    )
    self.bannerData[self.curBannerIdx] = curData
    self.bannerData[nextIdx] = nextData

    if not self.scrollInits[self.bannerFunType] then
        self.scrolls[self.bannerFunType]:InitItemData(num, _G.handler(self, self.RefreshBannerPoint))
        self.scrollInits[self.bannerFunType] = true
    else
        self.scrolls[self.bannerFunType]:UpdateCount(num)
    end
end

function MainPanel:GetBannerData(index)
    local data
    local isActivity = false
    local funNum = #self.functionTypeCfgs[self.bannerFunType]
    if index > funNum then
        data = self.activityTypeData[self.bannerFunType][index - funNum]
        isActivity = true
    else
        data = self.functionTypeCfgs[self.bannerFunType][index]
    end
    return isActivity, data
end

function MainPanel:OnBannerDragBegin(go, ed)
    self.bannerDragX = ed.position.x
end

function MainPanel:OnBannerDrag(go, ed)
end

function MainPanel:OnBannerDragEnd(go, ed)
    if self.bannerMoving then
        return
    end
    if #self.activityTypeData[self.bannerFunType] + #self.functionTypeCfgs[self.bannerFunType] < 2 then
        return
    end
    local reverse = ed.position.x - self.bannerDragX < 0
    if self.bannerTimer then
        self.bannerTimer:Reset()
    end
