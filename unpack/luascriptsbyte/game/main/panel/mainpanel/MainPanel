function MainPanel:AddActivitySynBtn(data, index)
    local function sortFunc(a, b)
        return a.index < b.index
    end
    local fType = data.ftype or _G.MainFunctionType.TopRight
    if fType < 0 then
        ---类型小于0的不应该在主界面
        return
    end
    if fType == _G.MainFunctionType.LD then
        if not self.activityTypeData[fType] then
            self.activityTypeData[fType] = {}
            _G.table.insert(self.activityTypeData[fType], data)
        end
        self:CheckMTActivity()
        return
    end
    if not data.isBanner or data.isBanner == 0 then
        ---是否是滚屏显示
        self.activityTypeData[fType] = self.activityTypeData[fType] or {}
        _G.table.insert(self.activityTypeData[fType], data)
        _G.table.sort(self.activityTypeData[fType], sortFunc)
        local num = self.functionTypeCfgs[fType] and #self.functionTypeCfgs[fType] or 0
        num = #self.activityTypeData[fType] + num
        num = self:GetTopRightShowNum(fType, num)
        if not self.scrollInits[fType] then
            self.scrolls[fType]:InitItemData(num, _G.handler(self, self.RefreshBtnList, fType))
            self.scrollInits[fType] = true
        else
            self.scrolls[fType]:UpdateCount(num)
        end
        self:UpdateScrollRectVertical(fType, num)
        if fType and data.redpointID and data.redpointID > 0 then
            if fType == _G.MainFunctionType.TopRight then
                require("RedPointManager"):GetInstance():AddRedPointChild(
                        _G.ConfigManager.redpoint_cfg.mainRightBtn.id,
                        data.redpointID or 0
                )
            elseif fType == _G.MainFunctionType.TopLeft then
                require("RedPointManager"):GetInstance():AddRedPointChild(
                        _G.ConfigManager.redpoint_cfg.mainLeftBtn.id,
                        data.redpointID or 0
                )
            end
        end
    else
        _G.table.insert(self.activityTypeData[self.bannerFunType], data)
        _G.table.sort(self.activityTypeData[self.bannerFunType], sortFunc)
        local closeState = require("ActivitySynManager"):GetInstance().State.Close
        local curActivityClass = require "ActivitySynManager":GetInstance():GetActivityClass(_G.tonumber(data.tag))
        local endTime = curActivityClass.typeClass.curActivityClass:GetActivityDeadLineByCondition(closeState)
        self.bannerCountDown[data.tag] = endTime - _G.TimeUtil.GetServerUnixTime()
        self:CheckBannerData()
        self:UpdateBannerShow()
    end

    -- self:CheckMTActivity()
end

---移除一个活动按
---@param tag string 按钮标签
function MainPanel:RemoveActivitySynBtn(tag, type1, sorting, ftype)
    local fType = ftype or _G.MainFunctionType.TopRight
    local isBanner, data, index
    for i, v in pairs(self.activityTypeData[fType]) do
        if v.tag == tag then
            index = i
            isBanner = false
            break
        end
    end
    if index then
        data = _G.table.remove(self.activityTypeData[fType], index)
    else
        for i, v in pairs(self.activityTypeData[self.bannerFunType]) do
            if v.tag == tag then
                index = i
                isBanner = true
                break
            end
        end
        if index then
            data = _G.table.remove(self.activityTypeData[self.bannerFunType], index)
        end
    end
    if data == nil then
        return
    end
    if ftype == _G.MainFunctionType.LD then
        self:CheckMTActivity()
    end
    if isBanner then
        self:CheckBannerData()
        self:UpdateBannerShow()
        self.bannerCountDown[data.tag] = nil
    else
        local num = self.functionTypeCfgs[fType] and #self.functionTypeCfgs[fType] or 0
        num = #self.activityTypeData[fType] + num
        num = self:GetTopRightShowNum(fType, num)
        if not self.scrollInits[fType] then
            self.scrolls[fType]:InitItemData(num, _G.handler(self, self.RefreshBtnList, fType))
            self.scrollInits[fType] = true
        else
            self.scrolls[fType]:UpdateCount(num)
        end
        self:UpdateScrollRectVertical(fType, num)
    end
    if fType then
        if fType == _G.MainFunctionType.TopRight then
            require("RedPointManager"):GetInstance():RemoveRedPointChild(
                    _G.ConfigManager.redpoint_cfg.mainRightBtn.id,
                    data.redpointID or 0
            )
        elseif fType == _G.MainFunctionType.TopLeft then
            require("RedPointManager"):GetInstance():RemoveRedPointChild(
                    _G.ConfigManager.redpoint_cfg.mainLeftBtn.id,
                    data.redpointID or 0
            )
        end
    end
end

