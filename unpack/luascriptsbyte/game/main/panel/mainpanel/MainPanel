function MainPanel:UpdateHell()
    local isShow
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Hell) then
        isShow = true
        self.go_table.obj_hellRoad:SetActiveE(1)
        RedPointManager:GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.MainNaraka.id)
        if not _G.AppSetting.IsXzns then
            self.go_table.scrollloopvectical_bottomRightBtn:SetLocalPosition(-60.5, 392.5, 0)
        end
    else
        isShow = _G.ConfigManager.function_open_cfg[_G.FunctionID.Hell].is_display
        self.go_table.obj_hellRoad:SetActiveE(isShow and 1 or 0)
        if not _G.AppSetting.IsXzns then
            self.go_table.scrollloopvectical_bottomRightBtn:SetLocalPosition(-60.5, isShow and 392.5 or 268, 0)
        end
    end
    local HellRoadModel = require "HellRoadModel":GetInstance()
    local maxCount = #_G.ConfigManager.hell_title_cfg
    local HellData = HellRoadModel.hellData
    local HellId = 1
    local isCompleted = 0
    if HellData ~= nil then
        HellId = HellData.h_id
        isCompleted = HellRoadModel:CheckIsFinishAll(HellId)
    end
    local isMax = HellId == maxCount
    isCompleted = isMax and 0 or isCompleted

    self.go_table.obj_hellRoadMaxTip:SetActiveE(isMax and 1 or 0)
    self.go_table.obj_hellRoadFinTip:SetActiveE((not isMax and isCompleted) and 1 or 0)
    self.go_table.obj_hellRoadTip:SetActiveE((isMax or isCompleted) and 0 or 1)
    local showEff = HellRoadModel:CheckAwardCanGet()
    if _G.AppSetting.IsXzns then
        showEff = showEff or (isCompleted and not isMax)
    end
    if showEff and isShow then
        self.go_table.obj_hellEff:SetActiveE(1)
        if not self.hellEffInit then
            self.hellEffInit = true
            _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.ef_junxianlingqu,
                    self.go_table.obj_hellEff,
                    function(obj)
                        if not self.go_table then
                            self.hellEffInit = false
                            _G.DestroyObject(obj)
                            return
                        end
                    end
            )
        end
    else
        self.go_table.obj_hellEff:SetActiveE(0)
    end
    if not (isMax or isCompleted) then
        local TaskName, isCompleted = HellRoadModel:GetCurShowTaskName(HellId)
        if TaskName then
            local color = {
                "72C946",
                "FFFFFF",
                "FFC800"
            }
            if _G.AppSetting.IsXzns then
                color[1] = "A7EFBC"
                color[3] = "F7EDC9"
            end
            self.go_table.aortext_hellRoadOrder.text = TaskName
            self.go_table.aortext_hellRoadOrder.color = _G.ColorTools.FormatColorByString(color[3])
            self.go_table.aortext_hellRoadOrderState.text = _G.GetLangPackValue(isCompleted and 90023900016 or
                    90023900002)
            self.go_table.aortext_hellRoadOrderState.color = _G.ColorTools.FormatColorByString(isCompleted and color[1] or
                    color[2])
        else
            self.go_table.obj_hellRoadFinTip:SetActiveE(1)
            self.go_table.obj_hellRoadTip:SetActiveE(0)
        end
    end
    if _G.AppSetting.IsXzns then
        if self.go_table.obj_hellRoadFinTip:GetActiveSelf() then
            GameUtil.ReBuildRTF(self.go_table.obj_hellRoadFinTipBg)
        end
        if self.go_table.obj_hellRoadTip:GetActiveSelf() then
            GameUtil.ReBuildRTF(self.go_table.obj_hellRoadTipBg)
        end
    end
end

function MainPanel:InitFunctions()
    ---@type main_function_cfg[]
    self.functionTypeCfgs = {}
    local nowOpenFunctionID = _G.FunctionManager:GetInstance():GetNowOpenFunctionID()
    local main_function_cfg = _G.ConfigManager.main_function_cfg
    ---@type main_function_cfg
    local cfg
    for _, funid in _G.pairs(nowOpenFunctionID) do
        cfg = main_function_cfg[funid]
        if cfg then
            if not self.functionTypeCfgs[cfg.Type1] then
                self.functionTypeCfgs[cfg.Type1] = {}
            end
            ---ZHJH-7844【客户端】贵宾邀请功能移植（妙悦单独）
            if funid == _G.MainFunctionItems.VIP then
                local curCashNum = require("MallManager"):GetInstance():GetCashRmb() or 0
                local version = _G.ConfigManager.discrete_cfg[100108][1][1]
                local condition = 0
                if version == 1 then
                    local storeGearId = _G.ConfigManager.discrete_cfg[106205][1][1]
                    if _G.AppSetting.IsXzns then
                        local value = _G.GameUtil.GetFunctionData(_G.FunctionBlock.VIPparameters)
                        storeGearId = value and value[1][1] or storeGearId
                    else
                        local value = _G.GameUtil.GetFunctionData(_G.FunctionBlock.VIPInvitation_amount)
                        storeGearId = value and value or storeGearId
                    end
                    local finalPrice = require "MallManager":GetInstance():GetFinalPrice(storeGearId)
                    condition = finalPrice
                elseif version == 2 then
                    condition = _G.ConfigManager.discrete_cfg[106205][1][2]
                    if _G.AppSetting.IsXzns then
                        local value = _G.GameUtil.GetFunctionData(_G.FunctionBlock.VIPparameters)
                        condition = value and value[1][2] or condition
                    else
                        local value = _G.GameUtil.GetFunctionData(_G.FunctionBlock.VIPInvitation_amount)
                        condition = value and value or condition
                    end
                end
                local VIPInvitation=_G.GameUtil.GetFunctionData(_G.FunctionBlock.VIPInvitation)
                if curCashNum >= condition and VIPInvitation > 0 then
                    if VIPInvitation==1 then
                        _G.table.insert(self.functionTypeCfgs[cfg.Type1], cfg)
                    elseif VIPInvitation==2 then
                        local nowtime = TimeUtil.GetServerUnixTime()
                        local jilu = _G.PlayerPrefsManager.GetString(_G.tostring(_G.PlayerModel:GetInstance().role_uid) .. "VIPStart")
                        local jilutime = string.IsNullOrEmpty(jilu) and 0 or tonumber(jilu)
                        if jilutime == 0 then
                            _G.PlayerPrefsManager.SetString(_G.tostring(_G.PlayerModel:GetInstance().role_uid) .. "VIPStart", tostring(nowtime))
                            _G.DelayDo(_G.ConfigManager.discrete_cfg[201501][1][1], function()
                                if table.isEmptyOrNil(self.go_table) then
                                    return
                                end
                                self:InitFunctions()
                            end)
                            self.isinitVIPInvitation = true
                        elseif jilutime > nowtime - _G.ConfigManager.discrete_cfg[201501][1][1] then
                            if not self.isinitVIPInvitation then
                                _G.DelayDo(jilutime + _G.ConfigManager.discrete_cfg[201501][1][1] - nowtime, function()
                                    if table.isEmptyOrNil(self.go_table) then
                                        return
                                    end
                                    self:InitFunctions()
                                end)
                                self.isinitVIPInvitation = true
                            end
                        elseif jilutime <= nowtime - _G.ConfigManager.discrete_cfg[201501][1][1] then
                            _G.table.insert(self.functionTypeCfgs[cfg.Type1], cfg)
                        end
                    end
                end
            else
                _G.table.insert(self.functionTypeCfgs[cfg.Type1], cfg)
            end
        end
    end
    for _, fType in pairs(_G.MainFunctionType) do
        if not self.functionTypeCfgs[fType] then
            self.functionTypeCfgs[fType] = {}
        end
    end
    local function sortFunc(a, b)
        return a.Sorting < b.Sorting
    end
    local function sortReverseFunc(a, b)
        return a.Sorting > b.Sorting
    end
    for t, cfgs in pairs(self.functionTypeCfgs) do
        if t == _G.MainFunctionType.TopLeft or t == _G.MainFunctionType.TopRight or t == _G.MainFunctionType.TopRightHorizontal then
            _G.table.sort(cfgs, sortFunc)
        else
            --左下右下倒序（滑动列表从下往上）
            _G.table.sort(cfgs, sortReverseFunc)
        end
    end

    for fType, cfgs in pairs(self.functionTypeCfgs) do
        if fType ~= self.bannerFunType then
            local num = #cfgs
            num = self:GetTopRightShowNum(fType, num)
            if self.scrolls[fType] ~= nil then
                if not self.scrollInits[fType] then
                    self.scrolls[fType]:InitItemData(num, _G.handlerbind(self, self.RefreshBtnList, fType))
                    self.scrollInits[fType] = true
                else
                    self.scrolls[fType]:UpdateCount(num)
                end
                self:UpdateScrollRectVertical(fType, num)
            else
                if _G.AppSetting.DEBUG and fType ~= _G.MainFunctionType.LD and num > 0 then
                    _G.LogError("请检查配置, main_function_cfg错误的Type1类型:" .. fType)
                end
            end
        end
    end

    if self.initActivityBtnTimer then
        self:InitListArrow()
        return
    end
    self.initActivityBtnTimer = _G.TimerManager:GetInstance():GetTimer(1, self.InitActivitySynBtns, self, true, true)
    self.initActivityBtnTimer:Start()
end

function MainPanel:GetTopRightShowNum(fType, num)
    if _G.MainFunctionType.TopRightHorizontal == fType and num >= self.topRightLimit then
        ---策划需求最多只显示8个Item
        num = self.topRightLimit + 1
    end

    return num
end

function MainPanel:UpdateScrollRectVertical(fType, num)
    if (fType == _G.MainFunctionType.TopLeft or fType == _G.MainFunctionType.TopRight) and not _G.AppSetting.IsXzns then
        local rect = self.scrolls[fType]:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect))
        rect.vertical = num > self.rightLimit
    end
