                    pushGiftActivity[1].typeClass.endTime
            )
        elseif djqActivity[1] and djqActivity[1].activityID and curActivityId == djqActivity[1].activityID then
            --代金券礼包倒计时
            if djqActivity[1].typeClass.endTime - _G.TimeUtil.GetServerUnixTime() <= 86400 then
                self:InitCountDown(
                        tb,
                        djqActivity[1].activityID,
                        djqActivity[1].typeClass.endTime
                )
            else
                tb.aortext_time.text = ""
                tb.aortext_time:SetActiveE(0)
            end
        elseif showCountDown and showEndTime and showEndTime > 0 then
            --显示活动倒计时信息
            self:InitCountDown(
                    tb,
                    curActivityId,
                    showEndTime
            )
        else
            tb.aortext_time.text = ""
            tb.aortext_time:SetActiveE(0)
        end
    end

    --tip
    if tb.obj_tips then
        if isActivity and data.typeid == 10085 then
            local curActivityClass = require "ActivitySynManager":GetInstance():GetActivityClass(tonumber(data.tag))
            curActivityClass.typeClass:SetTipTb(tb)
        end
    end
end

