function MainPanel:UpdateDrawIcon(data)
    if _G.IsNil(data) then
        local drawNormalCount = _G.StorageManager:GetInstance():GetItemCountBySid(203020100)
        local drawProCount = _G.StorageManager:GetInstance():GetItemCountBySid(203020200)
        self.buildData[8].tb.obj_drawIcon:SetActiveE((drawNormalCount >= 10 or drawProCount >= 10) and 1 or 0)
    else
        for _, value in pairs(data) do
            local sid = value.type[1]
            if sid == 203020100 or sid == 203020200 then
                local drawNormalCount = _G.StorageManager:GetInstance():GetItemCountBySid(203020100)
                local drawProCount = _G.StorageManager:GetInstance():GetItemCountBySid(203020200)
                self.buildData[8].tb.obj_drawIcon:SetActiveE((drawNormalCount >= 10 or drawProCount >= 10) and 1 or 0)
            end
        end
    end
end

function MainPanel:UpdateSPNewFunctionIcon()
    local isShow = false
    local param = {
        {_G.FunctionID.CardHall, _G.PlayerPrefsKey.CardHallOpen},
        {_G.FunctionID.Gemstone, _G.PlayerPrefsKey.GemstoneOpen}
    }
    for _, v in pairs(param) do
        if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(v[1]) then
            if _G.PlayerPrefsManager.GetInt(v[2]) == 0 then
                isShow = true
                break
            end
        end
    end

    self.buildData[4].tb.obj_newFunctionIcon:SetActiveE(isShow == true and 1 or 0)
end

---刷新建筑状态
function MainPanel:UpdateBuild()
    local funUnlock
    local FunctionManagerIns = _G.FunctionManager:GetInstance()
    for _, data in pairs(self.buildData) do
        local funcId
        ---目前配置多个功能id控制一个入口时，满足其一就解锁入口
        for _, functionId in ipairs(data.id) do
            funUnlock = FunctionManagerIns:CheckFunctionIsUnlock(functionId)
            if funUnlock then
                break
            else
                funcId = functionId
            end
        end

        data.tb.aorimage_lock:SetActiveE(funUnlock and 0 or 1)
        if not funUnlock then
            data.tb.aortext_lockStr.text = FunctionManagerIns:GetTipsStr(funcId)
        end
    end
end

