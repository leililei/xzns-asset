    --     local rect = self.scrolls[fType]:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect))
    --     rect.horizontal = num > 3
    -- end
end

--region 活动按钮
---初始化活动按钮
function MainPanel:InitActivitySynBtns()
    --TODO：拉取活动按钮数据，初始化活动按钮
    local fType = _G.MainFunctionType.TopRight
    self.activityTypeData = { [fType] = {}, [self.bannerFunType] = {} }
    local btns = self.mMainManager:GetAllActivitySynBtnsInfo()
    if _G.table.isEmptyOrNil(btns) then
        self:InitBanner()
        self.initActivityBtnTimer = nil
        self:CheckMTActivity()
        return
    end
    for _, data in pairs(btns) do
        if data.isBanner and (data.isBanner == 1 or data.isBanner == true) then
            ---是否是滚屏显示
            _G.table.insert(self.activityTypeData[self.bannerFunType], data)
        else
            --ZHJH-953 屏蔽福利按钮
            fType = data.ftype or _G.MainFunctionType.TopRight
            if data.tag ~= _G.ConfigManager.activity_position_cfg[105].views then
                self.activityTypeData[fType] = self.activityTypeData[fType] or {}
                _G.table.insert(self.activityTypeData[fType], data)
            end
        end
    end

    local function sortFunc(a, b)
        return a.index < b.index
    end
    for _, data in pairs(self.activityTypeData) do
        _G.table.sort(data, sortFunc)
    end

    for fType, v in pairs(self.activityTypeData) do
        if fType ~= self.bannerFunType and fType ~= self.ldFunType and fType ~= -1 then
            local fNum = self.functionTypeCfgs[fType] and #self.functionTypeCfgs[fType] or 0
            local count = #self.activityTypeData[fType] + fNum
            count = self:GetTopRightShowNum(fType, count)
            if not self.scrollInits[fType] then
                self.scrolls[fType]:InitItemData(count, _G.handlerbind(self, self.RefreshBtnList, fType))
                self.scrollInits[fType] = true
            else
                self.scrolls[fType]:UpdateCount(count)
            end
            self:UpdateScrollRectVertical(fType, count)
        end
    end

    self:InitBanner()
    self:InitListArrow()
    self.initActivityBtnTimer = nil

    self:CheckMTActivity()
end

function MainPanel:InitBannerActivityTimer()
    if self.bannaerActivityTimer then
        self.bannaerActivityTimer:Stop()
        self.bannaerActivityTimer = nil
    end
    local closeState = require("ActivitySynManager"):GetInstance().State.Close
    local now = _G.TimeUtil.GetServerUnixTime()
    self.bannerCountDown = {}
    local curActivityClass, endTime
    for _, data in pairs(self.activityTypeData[self.bannerFunType]) do
        if data.tag ~= -1 then
            curActivityClass = require "ActivitySynManager":GetInstance():GetActivityClass(_G.tonumber(data.tag))
            endTime = curActivityClass.typeClass.curActivityClass:GetActivityDeadLineByCondition(closeState)
            self.bannerCountDown[data.tag] = endTime - now
        end
    end
    for _, data in pairs(self.functionTypeCfgs[self.bannerFunType]) do
        endTime = self:GetMainFunEndTime(data.Id, now)
        self.bannerCountDown[data.Id] = endTime and endTime - now or nil
    end
    self.bannaerActivityTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateBannerTime, self, false, false)
    self.bannaerActivityTimer:Start()
end

function MainPanel:UpdateBannerTime(elapsed)
    for k, v in pairs(self.bannerCountDown) do
        self.bannerCountDown[k] = self.bannerCountDown[k] - elapsed
    end
    local data, time
    for i = 1, 2 do
        data = self.bannerData[i]
        if data then
            time = self:GetBannerTime(data)
            if time == nil then
                self.go_table["aortext_bannerTime" .. i].text = ""
            else
                if time < 0 then
                    time = 0
                end
                self.go_table["aortext_bannerTime" .. i].text = _G.TimeUtil.TranslateSecondForStr(_G.Mathf.RoundToInt(
                        time))
            end
        end
    end
end

function MainPanel:GetBannerTime(data)
    local time
    if data.tag then
        if data.tag ~= -1 then
            time = self.bannerCountDown[data.tag]
        end
    else
        time = self.bannerCountDown[data.Id]
    end
    return time
end

function MainPanel:GetMainFunEndTime(id, now)
    if id == _G.MainFunctionItems.MaterialCard then
        local activityData = require("MaterialGiftModel"):GetInstance():GetGiftData(1)
        if not activityData then
            return now
        end
        return require("MaterialGiftModel"):GetInstance().giftTimes[activityData.id] + now
    end
    return nil
end

function MainPanel:RefreshBtnList(index, obj, fType)
    index = index + 1
    if fType == _G.MainFunctionType.TopRightHorizontal then
        if index == self.topRightLimit then
            obj:SetActiveE(index == self.topRightLimit and 0 or 1)
            return
        elseif index == self.topRightLimit + 1 then
            index = self.topRightLimit
        end
    end
    obj:SetActiveE(1)
    local isActivity = false
    local data
    if _G.AppSetting.IsXzns and (fType == _G.MainFunctionType.TopRight or fType == _G.MainFunctionType.TopLeft) then
        local hasActivity = self.activityTypeData and self.activityTypeData[fType]
        local fNum = hasActivity and #self.activityTypeData[fType] or 0
        if index <= fNum and hasActivity then
            data = self.activityTypeData[fType][index]
            isActivity = true
        else
            data = self.functionTypeCfgs[fType][index - fNum]
        end
    else
        local fNum = #self.functionTypeCfgs[fType]
        if index > fNum then
            data = self.activityTypeData[fType][index - fNum]
            isActivity = true
        else
            data = self.functionTypeCfgs[fType][index]
        end
    end
    ---@type _obj_mainPanel._obj_btnItem1_GoTable|_obj_mainPanel._obj_btnItem2_GoTable
