function MainPanel:GetNextValidCountdown(list)
    -- endtime最早结束的排在最前面
    table.sort(
            list,
            function(a, b)
                return a.end_time < b.end_time
            end
    )
    local now = _G.TimeUtil.GetServerUnixTime()
    for _, item in ipairs(list) do
        if item.end_time > now then
            return item
        end
    end
    return nil
end

function MainPanel:InitTanChuLiBaoTimer(tb, activityID)
    local curPop = require "PopUpGiftBagModel":GetInstance().CurPop
    if not curPop or #curPop == 0 then
        return
    end

    local nextItem = self:GetNextValidCountdown(curPop)
    if nextItem then
        self:InitCountDown(
                tb,
                activityID,
                nextItem.end_time,
                function()
                    self:InitTanChuLiBaoTimer(tb, activityID)
                end
        )
    end
end

function MainPanel:InitCountDown(tb, activityID, endTime, call, showTimeType, color)
    showTimeType = showTimeType or 0
    if not endTime or endTime <= _G.TimeUtil.GetServerUnixTime() then
        return
    end
    if self.timerParams == nil then
        self.timerParams = {}
    end
    tb.aortext_time:SetActiveE(1)
    self.timerParams[activityID] = {
        go_table = tb,
        countDown = endTime - _G.TimeUtil.GetServerUnixTime(),
        call = call,
        showTimeType = showTimeType
    }
    self:UpdateCountdown(self.timerParams[activityID])
    -- 初始化 Timers 表来存储不同活动的倒计时
    if not self.Timers then
        self.Timers = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateAllCountdown, self, false, false, true)
        self.Timers:Start()
    end
end

function MainPanel:UpdateAllCountdown(elapsed)
    for activityID, param in pairs(self.timerParams) do
        param.countDown = param.countDown - elapsed
        self:UpdateCountdown(param)
    end
end

function MainPanel:UpdateCountdown(param)
    if param.countDown > 0 then
        local str
        if param.showTimeType == 0 then
            str = _G.TimeUtil.TimeToString(_G.Mathf.RoundToInt(param.countDown), 1)
        elseif param.showTimeType == 1 then
            str = _G.TimeUtil.TranslateSecondForStrMiaoHui(param.countDown)
        end
        if _G.AppSetting.IsXzns and param.color then
            param.go_table.aortext_time.color = param.color
        end
        param.go_table.aortext_time.text = str
    else
        param.countDown = 0
        param.go_table.aortext_time.text = ""
        if param.call then
            param.call()
        end
    end
end

function MainPanel:InitNpc()
    self.npc = {
        self.go_table.obj_npc1,
        self.go_table.obj_npc2,
        self.go_table.obj_npc3
    }
    self.npcCfg = {}
    for i = 1, 3 do
        if not _G.UIUtils.IsHaveChange(_G.IsNeedChangeUI.MainPanel, "obj_npc" .. i) then
            self.npcCfg[i] = _G.ConfigManager.npc_move_cfg[i]
            _G.PoolsManager:GetInstance():Spawn(
                    self.npcCfg[i].path,
                    _G.ePoolType.Temporary,
                    self.npc[i],
                    function(trans)
                        if self.go_table == nil then
                            _G.DestroyObject(trans)
                            return
                        end
                        -- local skeleton = trans:Find("SkeletonGraphic")
                        -- local SA = skeleton:GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
                        -- SA.AnimationState:SetAnimation(0, "move", true);
                        trans:SetLocalScaleXYZ(0.2)
                        if self.npcCfg[i].delay > 0 then
                            self.npc[i]:SetActiveE(0)
