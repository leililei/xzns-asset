            end
            if timeData then
                time = timeData.settlementTime
            end
            self:InitCountDown(tb, curActivityId, time, null, 1, color)
        elseif pushGiftActivity[1] and pushGiftActivity[1].activityID and curActivityId == pushGiftActivity[1].activityID then
            --推送礼包倒计时
            self:InitCountDown(
                    tb,
