---@param cardata CardData
function MainAfkPanel:SkinChange(cardata)
    local uid = cardata.uid
    for i = 1, 5 do
        local key = "obj_pos" .. i
        ---@type UnityEngine.GameObject
        local parent = self.go_table[key]
        --如果模型未加载或sid不一致, 则重新进行加载
        if parent:GetName() == _G.tostring(uid) then
            parent:SetName(key)
        end
    end
end

---更新军衔信息
function MainAfkPanel:UpdateHell()
    local isShow = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Hell)
    if isShow then
        require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.MainNaraka.id)
    else
        local cfg = _G.ConfigManager.function_open_cfg[_G.FunctionID.Hell]
        isShow = cfg and cfg.is_display
    end
    self.go_table.obj_hell:SetActiveE(isShow and 1 or 0)
    if not _G.AppSetting.IsXzns then
        self.go_table.obj_bottleRight:SetLocalPosition(-60.5, isShow and 392.5 or 268, 0)
    end
    if not isShow then
        return
    end

    local model = require "HellRoadModel":GetInstance()
    local HellData = model.hellData
    local hellId = 1
    local isCompleted = 0
    if HellData ~= nil then
        hellId = HellData.h_id
        isCompleted = model:CheckIsFinishAll(hellId)
    end
    local maxCount = #_G.ConfigManager.hell_title_cfg
    local isMax = hellId == maxCount --军衔是否已最大等级
    isCompleted = isMax and 0 or isCompleted

    self.go_table.obj_hellRoadMaxTip:SetActiveE(isMax and 1 or 0)
    self.go_table.obj_hellRoadFinTip:SetActiveE((not isMax and isCompleted) and 1 or 0)
    self.go_table.obj_hellRoadTip:SetActiveE((isMax or isCompleted) and 0 or 1)

    if not (isMax or isCompleted) then
        local TaskName, isCompleted = model:GetCurShowTaskName(hellId)
        if TaskName then
            local color = {
                "72C946",
                "FFFFFF",
                "FFC800"
            }
            if _G.AppSetting.IsXzns then
                color[1] = "A7EFBC"
                color[3] = "F7EDC9"
            end
            self.go_table.aortext_hellRoadOrder.text = TaskName
            self.go_table.aortext_hellRoadOrder.color = _G.ColorTools.FormatColorByString(color[3])
            self.go_table.aortext_hellRoadOrderState.text = _G.GetLangPackValue(isCompleted and 90023900016 or
                90023900002)
            self.go_table.aortext_hellRoadOrderState.color = _G.ColorTools.FormatColorByString(isCompleted and color[1] or
                color[2])
        else
            self.go_table.obj_hellRoadFinTip:SetActiveE(1)
            self.go_table.obj_hellRoadTip:SetActiveE(0)
        end
    end

    local showEff = model:CheckAwardCanGet()
    if _G.AppSetting.IsXzns then
        showEff = showEff or (isCompleted and not isMax)
    end
    if showEff and isShow then
        self.go_table.obj_hellEff:SetActiveE(1)
        if not self.hellEffInit then
            self.hellEffInit = true
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_junxianlingqu,
                self.go_table.obj_hellEff,
                function(obj)
                    if not self.go_table then
                        self.hellEffInit = false
                        _G.DestroyObject(obj)
                        return
                    end
                end
            )
        end
    else
        self.go_table.obj_hellEff:SetActiveE(0)
    end
    if _G.AppSetting.IsXzns then
        if self.go_table.obj_hellRoadFinTip:GetActiveSelf() then
            GameUtil.ReBuildRTF(self.go_table.obj_hellRoadFinTipBg)
        end
        if self.go_table.obj_hellRoadTip:GetActiveSelf() then
            GameUtil.ReBuildRTF(self.go_table.obj_hellRoadTipBg)
        end
    end
end

---初始化afk关卡数据
function MainAfkPanel:InitChapters()
    --检查是否创建角色
    if not _G.PlayerModel:GetInstance():CheckCreateRole() then
        return
    end
    --初始化afk数据
    local afkTaskModel = require("AfkTaskModel"):GetInstance()
    if afkTaskModel.Data then
        self:UpdateChapters()
        self:UpdateAfkGift()
        self:UpdateAfkGiftTip()
    else
        self.go_table.obj_afkGift:SetActiveE(0)
        self.go_table.aorbtn_afkGiftTip:SetActiveE(0)
        afkTaskModel:GetAfkData(
            function()
                self:UpdateChapters()
                self:UpdateAfkGift()
                self:UpdateAfkGiftTip()
            end
        )
    end
end

---更新afk关卡显示
---@return void
function MainAfkPanel:UpdateChapters()
    --检查是否创建角色
    if not _G.PlayerModel:GetInstance():CheckCreateRole() then
        self.go_table.obj_chapter:SetActiveE(0)
        return
    end
    self.go_table.obj_chapter:SetActiveE(1)

    --初始化节点
    local afkModel = AfkModel:GetInstance()
    local afkTaskModel = require("AfkTaskModel"):GetInstance()

    --更新当前进度标题
    self.curSecCfg = _G.ConfigManager.afk_cfg[afkModel:GetCurSection()]
    self.go_table.aortext_stageNum.text = string.format("%s-%s", self.curSecCfg.chapter, self.curSecCfg.section)
    local nameT = afkModel:GetCurChapterName()
    if nameT then
        self.go_table.aortext_stageName.text = LangUtil.GetLangPackValue(nameT[1])
    end
    self.awardDatas = afkTaskModel.AwardDatas
    local index = self:FindJumpIndex()
    if not self.sectionListInit then
        self.go_table.scrollloophorizontal_section:InitItemData(
            #self.awardDatas,
            _G.handler(self, self.RefreshSecItem),
            index
        )
        self.sectionListInit = true
    else
        self.go_table.scrollloophorizontal_section:UpdateAllItem()
        self.go_table.scrollloophorizontal_section:ScrollToIndex(index)
    end
end

function MainAfkPanel:RefreshSecItem(index, obj)
    index = index + 1
    ---@type _obj_afkPanel._obj_sectionItem_GoTable
    local tb = _G.GetAutoGoTable(obj)
    local data = self.awardDatas[index]
    if not tb.reward then
        tb.reward = {}
    end
    tb.gameObject:SetName(index)
    tb.data = data
    tb.aortext_name.text = _G.string.format("%d-%d", data.afkCfg.chapter, data.afkCfg.section)
    tb.aorimage_bg1:SetActiveE((not data.CanTake or data.isGet) and 1 or 0)
    tb.obj_eff:SetActiveE(data.CanTake and not data.isGet and 1 or 0)
    tb.aorimage_fill:SetActiveE((data.CanTake or data.isGet) and 1 or 0)
    --是否特殊关卡
    local isSpecific = not _G.string.IsNullOrEmpty(data.cfg.image)
    local itemType = _G.StorageManager:GetInstance():CheckSidType(data.realReward[1]) == _G.StorageType.Card and 1 or 2
    tb.itemType = itemType
    tb.obj_reward:SetLocalScaleXYZ(isSpecific and 1 or 0.7)
    for k, v in pairs(tb.reward) do
        if k ~= itemType then
            v.gameObject:SetActiveE(0)
        else
            v.gameObject:SetActiveE(1)
        end
    end
    --加载奖励图标
    if not tb.reward[itemType] then
        if itemType == 1 then
            _G.ItemCardFactory:GetInstance():GetItemCard(
