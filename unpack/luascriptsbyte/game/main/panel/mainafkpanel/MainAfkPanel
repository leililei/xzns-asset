function MainAfkPanel:FindJumpIndex()
    local index, index1, target
    for i, data in pairs(self.awardDatas) do
        if data.isGet then
            index1 = i
        elseif data.CanTake then
            index = i
            break
        end
    end
    target = index or (index1 and index1 + 1 or 0)
    if target > 0 then
        local sum = #self.awardDatas - 4
        if target > sum then
            target = sum
        else
            target = target - 1
        end
        target = target - 1
        target = target < 0 and 0 or target
        return target --C#从0开始
    end
    target = target < 0 and 0 or target
    return target
end

