---检查挂机奖励
function MainAfkPanel:CheckAfkAward()
    local function checkOpenQuickAward()
        if not self.go_table or _G.IsNil(self.go_table.gameObject) then
            return false
        end
        --如果afk界面已经隐藏
        if self.go_table.gameObject:GetctiveInHierarchy() ~= 1 then
            return false
        end
        if require("DouyinModel"):GetInstance():DouyinFeedScene() then
           return true 
        end
        --如果mainview不是在最顶层(打开了其他页面)
        local existWindow = _G.UIManager:GetInstance():GetTopWindowByLayer(_G.UILayers.TopLayer.Name) or
            _G.UIManager:GetInstance():GetTopWindowByLayer(_G.UILayers.NormalLayer.Name) or
            _G.UIManager:GetInstance():GetTopWindowByLayer(_G.UILayers.SceneLayer.Name)
        if existWindow and existWindow.Name ~= _G.ConfigManager.ui_cfg.MainView.Name then
            return false
        end

        return true
    end
    if not checkOpenQuickAward() then
        return
    end
    AfkModel:GetInstance():CheckAfkAward(
        function(time, data)
            if not checkOpenQuickAward() then
                return
            end
            self:UpdateAfkBox()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetawardView.Name, time, data)
            require("DouyinModel"):GetInstance():ReportAndStoreFeed()
        end
    )
end

