---更新右上角按钮状态
function MainAfkPanel:UpdateTRButton()
    if require("OnlineAwardModel").CheckShowMainFunction() then
        if not self.OnlineAward then
            local obj = _G.InstantiateObject(self.go_table.obj_item, self.go_table.obj_TRbutton)
            local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnRTBtn, "OnlineAward"))
            local cfg = _G.ConfigManager.main_function_cfg[5012]
            self.OnlineAward = obj
            self.OnlineAward:SetActiveE(1)
            tb.aortext_name.text = _G.GetLangPackValue(cfg.Name)
            tb.aorimage_icon.SpriteName = cfg.Icon
            tb.obj_redpoint:UpdateRedPointItemIDAndParam(cfg.RedPointId or 0)
            tb.aortext_time.text = ""
        else
            self.OnlineAward:SetActiveE(1)
        end
    else
        if self.OnlineAward then
            self.OnlineAward:SetActiveE(0)
        end
    end
end

function MainAfkPanel:UpdateView(isInit)
    self:UpdateEffect()
    self:UpdatePlayerInfo()
    if isInit then
        self:InitChapters()
    else
        self:UpdateChapters()
        self:UpdateAfkGift()
        self:UpdateAfkGiftTip()
    end
    self:UpdateAfkBox()
    self:UpdateTRButton()
    local createRole = _G.PlayerModel:GetInstance():CheckCreateRole()
    self.go_table.obj_minChatView:SetActiveE(createRole and 1 or 0)

    --战斗状态
    self:UpdateFightState()
    self:UpdateStorePass()
    self:UpdateSubGameBtn()
end

---更新战斗状态
---@return void
function MainAfkPanel:UpdateFightState()
    if not self.go_table or _G.IsNil(self.go_table.gameObject) then
        --停止定时器
        if self.fightTimer then
            self.fightTimer:Stop()
            self.fightTimer = nil
        end
        return
    end

    if not self:ShowAfkCondtion() then
        self.go_table.aorbtn_fight:SetActiveE(0)
        self.go_table.aorbtn_fightBack:SetActiveE(0)
        return
    end
    ---@type AfkBattleManager
    local afkManager = require("AfkBattleManager"):GetInstance()
    if not afkManager:IsFighting() then
        --停止定时器
        if self.fightTimer then
            self.fightTimer:Stop()
            self.fightTimer = nil
        end
        self.go_table.aorbtn_fight:SetActiveE(1)
        self.go_table.aorbtn_fightBack:SetActiveE(0)
    else
        if not self.fightTimer then
            self.fightTimer = _G.TimerManager:GetInstance():GetTimer(0.5, self.UpdateFightState, self, false, false)
            self.fightTimer:Start()

            --切换按钮状态
            self.go_table.aorbtn_fight:SetActiveE(0)
            self.go_table.aorbtn_fightBack:SetActiveE(1)
            local order = self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
            local canvas = self.go_table.aorbtn_fightBack.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine
                .Canvas))
            canvas.sortingOrder = canvas.sortingOrder + order
            -- if not self.fightEff then
            --     _G.UIUtils.LoadEffectByCfg(
            --         _G.ConfigManager.ui_effect_cfg.ef_aorbtnhuoyan,
            --         self.go_table.aorbtn_fightBack,
            --         function(obj)
            --             if not self.go_table.aorbtn_fightBack then
            --                 _G.DestroyObject(obj)
            --                 return
            --             end
            --             self.fightEff = obj
            --             obj:SetLocalPosition(0, 100, 0)
            --         end
            --     )
            -- end
        end
        --更新文本信息
        self.fightCount = (self.fightCount or 0) + 1
        if self.fightCount > 3 then
            self.fightCount = 0
        end
        local str = _G.GetLangPackValue(90031700069)
        for i = 1, self.fightCount do
            str = str .. "."
        end
        self.go_table.aortext_fightBack.text = str
    end
end

function MainAfkPanel:UpdateSubGameBtn()
    local gameType, cfg = require("MiniGameJumpManager"):GetInstance():GetGameType()
    local isShowBtn = false
    if gameType ~= 0 then--开启副玩法且需要放置界面的入口才显示
        self.subGameCfg = cfg
        if cfg.mainFunction then--不需要放置界面入口不显示
            isShowBtn = not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(264)
            if isShowBtn then
                local mainFunctionCfg = _G.ConfigManager.main_function_cfg[cfg.mainFunction]--复用主界面的入口配置
                self.go_table.aorimage_SubGameIcon.SpriteName = mainFunctionCfg.Icon
                self.go_table.aortext_SubGameName.text = _G.GetLangPackValue(mainFunctionCfg.Name)
                self.go_table.obj_SubGameRedpoint:UpdateRedPointItemIDAndParam(mainFunctionCfg.RedPointId)
            end
        end
    end
    self.go_table.aorbtn_SubGameBtn:SetActiveE(isShowBtn and 1 or 0)
end

function MainAfkPanel:ShowAfkCondtion()
    local pass, content = AfkModel:GetInstance():CheckNextSectionCondition()
    self.go_table.obj_afkCond:SetActiveE(pass and 0 or 1)
    self.go_table.aorbtn_commendPlay:SetActiveE(pass and 0 or 1)
    if not pass then
        self.go_table.aortext_battleCond.text = _G.GetLangPackValue(90029400098, content)
        local afkModel = AfkModel:GetInstance()
        local maxAfkTime = self:GetMaxAfkTime()
        local time = _G.TimeUtil.GetServerUnixTime() - afkModel:GetAfkTime()
        if time > maxAfkTime then
            time = maxAfkTime
        end
        if not self.condExtendText then
            self.condExtendText = self.go_table.obj_getAfkAward:GetComponentE(_G.typeof(_G.CS.ExtendText))
        end
        self.afkTime = afkModel:GetCanBattleAfkTime()
        self:StopCondTimer()
        if time < self:GetMaxAfkTime() and time < self.afkTime then
            self.afkCondTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateCondTimer, self, false, false, false)
            self.afkCondTimer:Start()
        end
        self:UpdateCondTimer()
        self.condExtendText.OnHrefClick:AddListener(_G.handler(self, self.OnHrefClick))
    end
    return pass
end

function MainAfkPanel:UpdateCondTimer()
    local time = _G.TimeUtil.GetServerUnixTime() - AfkModel:GetInstance():GetAfkTime()
    if time >= self:GetMaxAfkTime() or time >= self.afkTime then
        self.condExtendText.text = _G.GetLangPackValue(90020800040)
        self:StopCondTimer()
    else
        self.condExtendText.text = _G.GetLangPackValue(90020800044, self:FormateTime(self.afkTime - time))
    end
end

function MainAfkPanel:StopCondTimer()
    if self.afkCondTimer then
        self.afkCondTimer:Stop()
        self.afkCondTimer = nil
    end
end

function MainAfkPanel:FormateTime(time)
    local timeStr
    local t = _G.TimeUtil.TranslateSecond(time)
    if t.day > 0 then
        timeStr = _G.GetLangPackValue(90022100001, t.day, t.hour)
    else
        timeStr = _G.string.format("%02d:%02d:%02d", t.hour, t.min, t.sec)
    end
    return timeStr
end

function MainAfkPanel:OnHrefClick(id)
    if id == _G.ConfigManager.ui_cfg.GetawardView.Name then
        AfkModel:GetInstance():CheckAfkAward(
            function(time, data)
                self:UpdateAfkBox()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetawardView.Name, time, data)
            end
        )
    end
end

