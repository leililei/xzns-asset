    elseif pindao == _G.ChatType.selfWorld then
        tb.aortext_pindao.text = "<color=#c27ef6>{" .. _G.GetLangPackValue(9002060003) .. "}</color>"
    elseif pindao == _G.ChatType.union then
        tb.aortext_pindao.text = "<color=#c73c34>{" .. _G.GetLangPackValue(90010050081) .. "}</color>"
    elseif pindao == _G.ChatType.team then
        tb.aortext_pindao.text = "<color=#68a0f4>{" .. _G.GetLangPackValue(9002060005) .. "}</color>"
    elseif pindao == _G.ChatType.privateChat then
        tb.aortext_pindao.text = "<color=#68a0f4>{" .. _G.GetLangPackValue(90020600025) .. "}</color>"
    elseif pindao == _G.ChatType.unionbattle then
        tb.aortext_pindao.text = "<color=#68a0f4>{" .. _G.GetLangPackValue(90010050081) .. "}</color>"
    end
    tb.aortext_info.text = content

    _G.table.insert(self.nowMinChatAll, item)
    item:SetActiveE(1)
end

function MainAfkPanel:RefreshMineChatItem()
    if not self.initLoadCompleted then
        local channel, content = _G.MainManager:GetInstance():GetLastChat()
        if channel and content then
            self:AddMinChatItem(channel, content)
        end
    end
end

function MainAfkPanel:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_fight then
        if AfkModel:GetInstance():CheckPassAll() then
            _G.PopWindowManager:GetInstance():ShowAllTips(210108)
            return
        end
        if _G.DeadsoulTowerManager:GetInstance():IsFighting() or
            require("SecretRealmModel"):GetInstance():IsFighting() then
            _G.PopWindowManager:GetInstance():ShowAllTips(46)
            return
        end
        if require "ActivityDispatchModel":GetInstance():GetBattleIng() then
            _G.PopWindowManager:GetInstance():ShowAllTips(46)
            return
        end
        --如果正在战斗中, 直接返回战斗
        local afkManager = require("AfkBattleManager"):GetInstance()
        if afkManager:IsFighting() then
            afkManager:SetFightView(true)
            self.gameObject:SetActiveE(false)
            return
        end

        if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Afk) then
            _G.FunctionManager:GetInstance():ShowFuncitonOpenTips(_G.FunctionID.Afk)
            return
        end
        if not AfkModel:GetInstance():CheckNextSectionCondition() then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LevelUpGuideView.Name)
            return
        end
        require "EmbattleModel":GetInstance():ClearLastAssist()
        --第一关特殊处理直接进战斗
        if self.curSecCfg.chapter == 1 and self.curSecCfg.section == 1 then
            require("AfkBattleManager"):GetInstance():FirstFight()
        else
            require("AfkBattleManager"):GetInstance():EnterEmbattle()
        end
    elseif go == self.go_table.aorbtn_fightBack then
        ---@type AfkBattleManager
        local afkManager = require("AfkBattleManager"):GetInstance()
        if not afkManager:IsFighting() then
            self:UpdateFightState()
            return
        end
        --切换bgm
        local mId = AfkModel:GetInstance():GetCurMonsterID()
        local mcfg = _G.ConfigManager.monster_group_cfg[mId]
        _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, mcfg.audio)
        afkManager:SetFightView(true)
        self.gameObject:SetActiveE(false)
    elseif go == self.go_table.aorbtn_playerInfo then
        _G.SystemSettingManager:GetInstance():OpenView(_G.PlayerModel:GetInstance():GetPlayerUid())
    elseif go == self.go_table.aorbtn_bag then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BagNewView.Name)
    elseif go == self.go_table.aorbtn_task then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActiveTaskView.Name)
    elseif go == self.go_table.aorbtn_hell or go == self.go_table.aorbtn_hell2 then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.MilitaryRankView.Name,
            _G.handler(self, self.UpdateHell)
        )
    elseif go == self.go_table.aorbtn_box then
        require "RequestSubscribeModel":GetInstance():DoRS(1)
        AfkModel:GetInstance():CheckAfkAward(
            function(time, data)
                self:UpdateAfkBox()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetawardView.Name, time, data)
            end
        )
    elseif go == self.go_table.aorbtn_chatView then
        self.go_table.obj_minChatView:SetActiveE(0)
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ChatView.Name,
            _G.MainManager:GetInstance().mainType or _G.ChatType.world
        )
    elseif go == self.go_table.aorbtn_commendPlay then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LevelUpGuideView.Name)
    elseif go == self.go_table.aorbtn_afkGiftBtn or go == self.go_table.aorbtn_afkGiftTip then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.AfkGiftView.Name)
    elseif go == self.go_table.aorbtn_storePass then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.StorePassView.Name)
    elseif go == self.go_table.aorbtn_SubGameBtn then
        if self.subGameCfg and self.subGameCfg.enterFun then
            self.subGameCfg.enterFun(false)
        end
    end
end

function MainAfkPanel:OnDestroy()
    self:RemoveListener(_G.eCardShow.CardChangeSkin, self.SkinChange)
    self:RemoveListener(_G.eGodHalo.GodHaloRefresh, self.UpDateGodHalo)
    _G.MainManager:GetInstance().afkView = nil
    if self.fireEffect then
        _G.DestroyObject(self.fireEffect)
    end
    if self.bgEffect then
        _G.DestroyObject(self.bgEffect)
    end
    for i, v in pairs(self.boxEffect) do
        _G.DestroyObject(v)
    end
end

return MainAfkPanel
