function MainAfkPanel:ShowTalkPop(loadingId)
    local uid
    local emData = self.emData

    -- 左侧气泡
    self.go_table.aorimage_pos1:SetActiveE(0)
    self.go_table.aorimage_pos4:SetActiveE(0)

    -- 右侧气泡
    self.go_table.aorimage_pos2:SetActiveE(0)
    self.go_table.aorimage_pos5:SetActiveE(0)

    -- 左右气泡交叉出现
    if self.randomLeftRight == 1 then
        self.randomLeftRight = 2
    else
        self.randomLeftRight = 1
    end

    local randomLeftRight = self.randomLeftRight
    -- 上下
    local randomDeepTop = math.random(1, 2)

    local txt
    local image
    if randomLeftRight == 1 then
        if randomDeepTop == 1 then
            txt = self.go_table.aortext_pos1
            image = self.go_table.aorimage_pos1
            uid = emData[1]
        else
            txt = self.go_table.aortext_pos4
            image = self.go_table.aorimage_pos4
            uid = emData[4]
        end
    else
        if randomDeepTop == 1 then
            txt = self.go_table.aortext_pos2
            image = self.go_table.aorimage_pos2
            uid = emData[2]
        else
            self.go_table.aorimage_pos5:SetActiveE(1)
            txt = self.go_table.aortext_pos5
            image = self.go_table.aorimage_pos5
            uid = emData[5]
        end
    end
    local cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
    local afktalk
    local randomTalk12 = math.random(1, 2)
    if (not cardData) or (not cardData.cfg) then
        return
    end
    -- 最后的参数是容错处理 按理说不要有空的
    local afktalk1 = #cardData.cfg.afktalk > 0 and cardData.cfg.afktalk[math.random(1, #cardData.cfg.afktalk)] or
        91307420805
    if #_G.ConfigManager.discrete_cfg[120018] > 0 and #_G.ConfigManager.discrete_cfg[120018][1] > 0 then
        local afktalk2 = _G.ConfigManager.discrete_cfg[120018][1]
            [math.random(1, #_G.ConfigManager.discrete_cfg[120018][1])]

        if randomTalk12 == 1 then
            afktalk = afktalk1
        else
            afktalk = afktalk2
        end
    else
        afktalk = afktalk1
    end

    txt.text = _G.GetLangPackValue(afktalk)
    image:SetActiveE(1)
    -- 展示对话完4s后 关闭对话 间隔2s后再次执行此逻辑
    _G.DelayDo(
        TalkShowTime,
        function()
            if _G.IsNil(self.go_table.gameObject) then
                return
            end
            image:SetActiveE(0)
            _G.DelayDo(
                TalkCdTime,
                function()
                    if _G.IsNil(self.go_table.gameObject) then
                        return
                    end
                    if self.roleLoadingId ~= loadingId then
                        return
                    end
                    self:ShowTalkPop(loadingId)
                end
            )
        end
    )
end

