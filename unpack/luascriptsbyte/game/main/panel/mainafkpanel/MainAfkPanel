---更新afk宝箱状态
---@return void
function MainAfkPanel:UpdateAfkBox()
    local show, index = false, 1
    if _G.PlayerModel:GetInstance():CheckCreateRole() then
        local afkModel = AfkModel:GetInstance()
        local cfg = _G.ConfigManager.afk_cfg[afkModel:GetCurSection()]
        local time = _G.TimeUtil.GetServerUnixTime() - afkModel:GetAfkTime()
        if cfg and cfg.pre_section > 0 then
            show = true
            local discreteID = {
                HalfAfkTime = 101110,
                ResultIntervalTime = 101109
            }
            local halfAfkTime = _G.ConfigManager.discrete_cfg[discreteID.HalfAfkTime][1][1]
            local interval = _G.ConfigManager.discrete_cfg[discreteID.ResultIntervalTime][1][1]
            if time < interval then
                index = 1
            elseif time < halfAfkTime then
                index = 2
            else
                index = 3
            end
        end

        local maxAfkTime = self:GetMaxAfkTime()
        if time < self:GetMaxAfkTime() then
            self.go_table.aortext_Slider.text = _G.TimeUtil.TransDayHourMineMiao(time)
            self.go_table.slider_bossProgress.value = time / maxAfkTime
        else
            self.go_table.aortext_Slider.text = _G.TimeUtil.TransDayHourMineMiao(maxAfkTime)
            self.go_table.slider_bossProgress.value = 1
        end
    end
    for i = 1, 3 do
        if i == index then
            self.go_table["obj_box" .. i]:SetActiveE(1)
        else
            self.go_table["obj_box" .. i]:SetActiveE(0)
        end
    end
    self:UpdateAfkBoxEffect(index)
end

---更新afk编队人员显示
---@return void
function MainAfkPanel:UpdateEmbattleRoles()
    --检查是否创建角色
    if not _G.PlayerModel:GetInstance():CheckCreateRole() then
        return
    end
    --获取布阵数据
    ---@type number[]
    local emData
    local embattleIds = require("AfkBattleManager"):GetInstance():GetCurEmbattleID()
    for _, embattleId in pairs(embattleIds) do
        emData = require("EmbattleModel"):GetInstance():GetEmbattleData(embattleId)
        if emData then
            for i = #emData, 1, -1 do
                if not emData[i] or emData[i] <= 0 then
                    table.remove(emData, i)
                end
            end
        end
        if not _G.table.isEmptyOrNil(emData) then
            break
        end
    end

    if not self.roleModels then
        self.roleModels = {}
    end
    --没有任何数据, 清空模型
    if _G.table.isEmptyOrNil(emData) then
        for i = 1, 5 do
            local model = self.roleModels[i]
            if model then
                self.roleModels[i] = nil
                _G.PoolsManager:GetInstance():Despawn(model, _G.ePoolType.Temporary)
            end
            ---@type UnityEngine.GameObject
            local parent = self.go_table["obj_pos" .. i]
            parent:SetActiveE(0)
            parent:SetName("0")
        end
        return
    end

    --开始加载模型
    local loadingId = "loadid_" .. math.random()
    self.roleLoadingId = loadingId --异步加载限制
    -- 是否展示对话气泡（需要五个角色上满）
    local IsShowPop = true
    for i = 1, 5 do
        ---@type UnityEngine.GameObject
        local parent = self.go_table["obj_pos" .. i]
        local uid = emData[i] or 0
        if uid == 0 then
            IsShowPop = false
        end
        ---@type CardData
        local cardData = uid > 0 and _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid) or nil
        local loadSid = "0" --加载的模型的sid(card_cfg或skin_cfg)
        if cardData then
            local isWearSkin, skinId = require("CardCommentManager"):GetInstance():CardWearSkin(cardData.cfg.id)
            if isWearSkin and skinId and skinId > 0 then
                loadSid = tostring(skinId)
            else
                loadSid = tostring(cardData.cfg.id)
            end
        end

        --如果模型未加载或sid不一致, 则重新进行加载
        if parent:GetName() ~= loadSid or _G.AppSetting.IsXzns then
            local model = self.roleModels[i]
            if model then
                self.roleModels[i] = nil
                _G.PoolsManager:GetInstance():Despawn(model, _G.ePoolType.Temporary)
            end
            parent:SetActiveE(0)

            if cardData then
                parent:SetActiveE(1)
                local isWearSkin, skinId = require("CardCommentManager"):GetInstance():CardWearSkin(cardData.cfg.id)
                local path = isWearSkin and _G.ConfigManager.skin_cfg[skinId].ModelPathHi or cardData.cfg.ModelPathHi
                if _G.UIUtils.IsUseBattleSpine(_G.UseBattleSpine.MainAfkView) then
                    path = _G.UIUtils.GetBattleSpine(cardData.cfg)
                end
                local filpX = (i == 2 or i == 5) and -1 or 1 --是否需要翻转x轴
                local scale = cardData.cfg.size4
                _G.PoolsManager:GetInstance():Spawn(
                    path,
                    _G.ePoolType.Temporary,
                    parent,
                    function(trans)
                        if trans == nil then
                            if _G.AppSetting.DEBUG then
                                _G.LogError("角色模型加载失败, 角色sid=" .. uid .. ", 路径=" .. cardData.cfg.ModelPathHi)
                            end
                            return
                        end
                        if _G.IsNil(self.gameObject) or self.roleLoadingId ~= loadingId then
                            _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.Temporary)
                            return
                        end
                        trans:SetLocalScale(filpX * scale, scale, scale)
                        trans:SetLocalPositionToZero()
                        parent:SetName(loadSid)
                        parent:SetActiveE(1)
                        self.roleModels[i] = trans

                        --- 只有星座女神有神环
                        if _G.AppSetting.IsXzns then
                            local godHaloID = _G.PlayerModel:GetInstance():IsCardWearGodHalo(cardData.cfg.id)
                            if godHaloID ~= 0 then
                                local effCfg = _G.ConfigManager.god_halo_cfg[godHaloID].ui_effect_cfg
                                --- 神环路径，父级路径(加载角色的下面)
                                _G.UIUtils.LoadGodHalo(effCfg, trans, godHaloID)
                            end
                            _G.UIUtils.LoadArtifacteffect(trans,cardData.cfg.id ,nil,nil)
                        end
                    end
                )
            else
                IsShowPop = false
                parent:SetName("0")
            end
        end
    end
    self.emData = emData

    if IsShowPop then
        -- 左右
        self.randomLeftRight = math.random(1, 2)
        _G.DelayDo(
            TalkInitTime,
            function()
                if _G.IsNil(self.go_table.gameObject) then
                    return
                end
                if self.roleLoadingId ~= loadingId then
                    return
                end
                self:ShowTalkPop(self.roleLoadingId)
            end
        )
    end
end

