---更新通关豪礼tip窗口
---@return void
function MainAfkPanel:UpdateAfkGiftTip()
    if self.go_table.obj_afkGift:GetActiveSelf() ~= 1 then
        return
    end
    local model = require("AfkTaskModel"):GetInstance()
    --是否有可领取的豪礼
    local hasAward = model:CheckSectionAward2()
    if hasAward then
        self.go_table.aorbtn_afkGiftTip:SetActiveE(1)
        self.go_table.aortext_afkGiftTip.text = _G.GetLangPackValue(90000001250) --当前可领奖
        self.afkGiftTick = nil
        if self.afkGiftTimer then
            self.afkGiftTimer:Stop()
            self.afkGiftTimer = nil
        end
        return
    end

    local intervalCfg = _G.ConfigManager.discrete_cfg[120011]
    local interval = intervalCfg[1][1] or 5 --默认间隔5秒, 0常驻显示, -1不显示
    local isShowTip = false
    if interval > 0 then
        --创建定时器
        if not self.afkGiftTimer then
            self.afkGiftTimer = _G.TimerManager:GetInstance():GetTimer(interval, self.UpdateAfkGiftTip, self, false,
                false, true)
            self.afkGiftTimer:Start()
        end
        self.afkGiftTick = (self.afkGiftTick or 0) + 1
        isShowTip = self.afkGiftTick % 2 == 0
    else
        --销毁定时器
        if self.afkGiftTimer then
            self.afkGiftTimer:Stop()
            self.afkGiftTimer = nil
        end
        isShowTip = interval ~= -1
    end

    --是否需要显示tip
    self.go_table.aorbtn_afkGiftTip:SetActiveE(isShowTip and 1 or 0)
    if not isShowTip then
        return
    end
    --获取下一个可领取的关卡
    local nextAfk = model:GetNextSectionAward2()
    if not nextAfk then
        --奖励已全部领取完成
        self.go_table.aorbtn_afkGiftTip:SetActiveE(0)
        if self.afkGiftTimer then
            self.afkGiftTimer:Stop()
            self.afkGiftTimer = nil
        end
        return
    end
    local curAfkId = AfkModel:GetInstance():GetCurSection()
    local afk = _G.ConfigManager.afk_cfg[curAfkId]
    self.go_table.aortext_afkGiftTip.text = _G.GetLangPackValue(90000001249,
        afk and (nextAfk.number - afk.number + 1) or nextAfk.number)
end

