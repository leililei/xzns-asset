---更新宝箱特效
function MainAfkPanel:UpdateAfkBoxEffect(index)
    for i, v in pairs(self.boxEffect) do
        v:SetActiveE(0)
    end
    if not self.boxEffect[index] then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[boxEffect[index]],
            self.go_table["obj_box" .. index],
            function(tran)
                self.boxEffect[index] = tran
            end
        )
    else
        self.boxEffect[index]:SetActiveE(1)
    end
end

