---@class MainAfkPanel : Component AFK场景
---@field go_table _obj_afkPanel_GoTable
---@field sectionItems _obj_afkPanel._obj_sectionItem_GoTable[] 冒险关卡节点
---@field afkTimer Timer
---@field checkAwakrTimer Timer
---@field playerHead PlayerComponent
---@field roleModels table<number,UnityEngine.Transform>        @加载的人物模型
---@field fightTimer Timer                                      @战斗状态定时器
---@field afkGiftTimer Timer                                    @关卡豪礼定时器
---@field afkGiftTick number                                    @关卡豪礼定时器tick
local MainAfkPanel = _G.BaseClass("MainAfkPanel", _G.Component)

local AfkModel = require("AfkModel")
---宝箱特效
local boxEffect = {
    [1] = "ef_box1",
    [2] = "ef_box2",
    [3] = "ef_box3"
}

---气泡初始化时间
local TalkInitTime = 3

---气泡展示时间
local TalkShowTime = 4

---气泡Cd时间
local TalkCdTime = 2

function MainAfkPanel:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.go_table.obj_sectionItem:SetActiveE(0)
    self.boxEffect = {}
    self.TRButton = {}
    self.go_table.obj_bagRedpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.MainBackpack.id, -1)
    self.go_table.obj_taskRedpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.MainDailyTask.id, -1)
end

function MainAfkPanel:OnCreate()
    self:AddListener(_G.eCardShow.CardChangeSkin, self.SkinChange)
    self:AddListener(_G.eGodHalo.GodHaloRefresh, self.UpDateGodHalo)

    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.MainAfkPanel, self.go_table)
    local resources = _G.ConfigManager.ui_cfg.MainView.resources
    self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, resources))
    self.playerHead = self:AddComponent(self.go_table.obj_playerInfo,
        require("PlayerComponent").New(self.go_table.obj_playerInfo))
    self:InitFunctionOpen()
    self:UpdateView(true)
    self:RefreshMineChatItem()
    _G.MainManager:GetInstance().afkView = self

    if require("MonthlyModel"):GetInstance():IsOutTimePopUp(405005) then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LimitedTimePrivilegeView.Name, 405005)
        _G.PopWindowManager:GetInstance():ShowAllTips(240310)
    end
end

function MainAfkPanel:OnEnable()
    self:AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed)
    self:AddListener(_G.GlobalEvents.PlayerPowerChange, self.UpdatePower)
    self:AddListener(_G.GlobalEvents.DelayUpdateAllCardProp, self.UpdatePower)
    self:AddListener(_G.eShenshiEvents.UpDataShenSHiBag, self.UpdatePower)
    self:AddListener(_G.eUIManagerStatus.StartOpenUI, self.StartOpenUI)
    self:AddListener(_G.ePlayerStatus.PlayerUpLevel, self.UpdateFightState)
    self:AddListener(_G.eAfkEvents.GetAfkAward, self.UpdateFightState)
    self:AddListener(_G.eLimitePrivilege.LimitePrivilegeChange, self.UpdateFightState)
    self:AddListener(_G.eRedPoint.RedPointRefresh, self.OnRedPointRefresh)
    self:AddListener(_G.eHellRoad.FinishTask, self.UpdateHell)
    self:AddListener(_G.DungeonChallengeBattleViewShow.Open, self.UpdateNitpick)
    self:InitFunctionOpen()

    self.afkTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateAfkBox, self, false, false, true)
    self.afkTimer:Start()
    self:UpdateHell()
    self:UpdateEmbattleRoles()

    --主动弹出快速挂机面板
    if AfkModel:GetInstance():GetAfkAwardBoxStatus() then
        self.checkAwakrTimer = _G.TimerManager:GetInstance():GetTimer(0.1, self.CheckAfkAward, self, true, false, true)
        self.checkAwakrTimer:Start()
    else
        if _G.AppSetting.IsDouYin then
            local channel = require("DouyinModel"):GetInstance():GetFeedGameChannel()
            if _G.AppSetting.DEBUG then
               _G.LogError(tostring(channel), "抖音直流, channel=") 
            end
            if channel and tonumber(channel) == 2 then
                require("DouyinModel"):GetInstance():ReportScene()
            end
        end
    end
end

function MainAfkPanel:OnDisable()
    --self:RemoveAllListener()
    self:RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed)
    self:RemoveListener(_G.GlobalEvents.PlayerPowerChange, self.UpdatePower)
    self:RemoveListener(_G.GlobalEvents.DelayUpdateAllCardProp, self.UpdatePower)
    self:RemoveListener(_G.eShenshiEvents.UpDataShenSHiBag, self.UpdatePower)
    self:RemoveListener(_G.eUIManagerStatus.StartOpenUI, self.StartOpenUI)
    self:RemoveListener(_G.ePlayerStatus.PlayerUpLevel, self.UpdateFightState)
    self:RemoveListener(_G.eAfkEvents.GetAfkAward, self.UpdateFightState)
    self:RemoveListener(_G.eLimitePrivilege.LimitePrivilegeChange, self.UpdateFightState)
    self:RemoveListener(_G.eRedPoint.RedPointRefresh, self.OnRedPointRefresh)
    self:RemoveListener(_G.eHellRoad.FinishTask, self.UpdateHell)
    self:RemoveListener(_G.DungeonChallengeBattleViewShow.Open, self.UpdateNitpick)
    if self.afkTimer then
        self.afkTimer:Stop()
        self.afkTimer = nil
    end
    if self.afkGiftTimer then
        self.afkGiftTimer:Stop()
        self.afkGiftTimer = nil
    end
    if self.checkAwakrTimer then
        self.checkAwakrTimer:Stop()
        self.checkAwakrTimer = nil
    end

    if self.fightTimer then
        self.fightTimer:Stop()
        self.fightTimer = nil
    end
    self:StopCondTimer()

    --防止意外打开GetawardView页面
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.GetawardView.Name)
end

function MainAfkPanel:StartOpenUI(name)
    if require("DouyinModel"):GetInstance():DouyinFeedScene() then
       return 
    end
    if name ~= _G.ConfigManager.ui_cfg.MainView.Name then
        if self.checkAwakrTimer then
            self.checkAwakrTimer:Stop()
            self.checkAwakrTimer = nil
        end
    end
end

