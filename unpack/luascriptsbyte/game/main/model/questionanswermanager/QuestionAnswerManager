---@class QuestionAnswerManager : GameDataModelBase    中文描述
---@field GetInstance fun():QuestionAnswerManager
local QuestionAnswerManager = _G.BaseClass("QuestionAnswerManager", _G.GameDataModelBase)

---@return QuestionAnswerManager QuestionAnswerManager
function QuestionAnswerManager:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function QuestionAnswerManager:__init()
    --self.curFunctionOpenID = 141
    --获取当前进度
    self.Idslist = {}
    self.ListCount = _G.ConfigManager.discrete_cfg[100112]
    self.IdList = {}
end
--region 子类重写
---从服务器拉取数据
function QuestionAnswerManager:GetDataFormServer()
    require("QuestionAnswerNet"):GetInstance():GetInfo(_G.handler(self, self.GetInfoCall))
end

---获取info回调

function QuestionAnswerManager:GetInfoCall(msg)
    self.Idslist = msg.ids or {}
    self:GetId()
    self:ParseData()
end
---获取当前显示id
function QuestionAnswerManager:GetId()
    for i = 1, _G.table.count(self.ListCount) do
        if not self:ListIdBool(self.ListCount[i][1]) then
            if self.Idlist == nil or #self.Idlist <= 0 then
                self.IdList = self.ListCount[i]
            end
            --return
            local list = _G.ConfigManager.discrete_cfg[self.ListCount[i][1]]

            local checkCount, lockType, tipsid, content = _G.GlobalConditionManager.CheckConditionByArray(list)

            -- for key, value in pairs(list) do
            --     local checkCount, lockType, tipsid, content = _G.GlobalConditionManager.CheckConditionByArray(list)

            --     if not checkCount then
            --         return checkCount
            --     end
            -- end
            if lockType == nil and checkCount then
                self.IdList = self.ListCount[i]

                return
            end
        end
    end
    self.IdList = {}
end

---添加已完成的进度表
function QuestionAnswerManager:IdsAdd(id)
    local Is = not self:ListIdBool(id)

    if Is then
        _G.table.insert(self.Idslist, id)
        self:GetId()
        if not self:BoolIdIs() then
            _G.FunctionManager:GetInstance():CloseFunById(5048)
        end
    end
end

---查询对应id是否完成
function QuestionAnswerManager:ListIdBool(id)
    for _, value in pairs(self.Idslist) do
        if value == id then
            return true
        end
    end
    return false
end

---查询当前id是否可以显示
function QuestionAnswerManager:BoolIdIs()
    if _G.AppSetting.IsArraigned then
        return false
    end
    if _G.table.count(self.IdList) <= 0 then
        return false
    end
    local list = _G.ConfigManager.discrete_cfg[self.IdList[1]]
    if list then
        local checkCount, lockType, tipsid, content = _G.GlobalConditionManager.CheckConditionByArray(list)

        -- for key, value in pairs(list) do
        --     local checkCount, lockType, tipsid, content = _G.GlobalConditionManager.CheckConditionByArray(list)

        --     if not checkCount then
        --         return checkCount
        --     end
        -- end
        if lockType ~= nil then
            return false
        end
        require "RedPointManager":GetInstance():RefreshNodeByAllParams(
            _G.ConfigManager.redpoint_cfg.QuestionnaireButton.id
        )
        return checkCount
    end
    return false
end
---点击
function QuestionAnswerManager:FinishTask(call)
    if _G.table.count(self.IdList) >= 0 then
        local data = {id = self.IdList[1]}
        require("QuestionAnswerNet"):GetInstance():FinishTask(
            data,
            function(msg)
                if msg.ack == 1 then
                    call(msg)
                -- self:IdsAdd(self.IdList[1])
                -- self:GetId()
                end
            end
        )
    end
end

---销毁对象时,析构函数
function QuestionAnswerManager:Dispose()
    if self.timer ~= nil then
        self.timer:Stop()
    end
end

function QuestionAnswerManager.CheckBoolIdIs()
    QuestionAnswerManager:GetInstance():GetId()
    return QuestionAnswerManager:GetInstance():BoolIdIs()
end
return QuestionAnswerManager
