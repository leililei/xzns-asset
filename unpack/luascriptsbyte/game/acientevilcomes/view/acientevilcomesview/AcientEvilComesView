function AcientEvilComesView:UpdateTask()
    self.TaskInfos = AcientEvilComesModel:GetInstance():GetTaskDatas(self.curTitleIndex)
    local count = #self.missionCfg[self.curTitleIndex].missions
    if not self.TaskListCount then
        self.go_table.scrollloopvectical_taskList:UpdateCount(count)
        self.TitleListCount = count
    else
        if self.TaskListCount ~= count then
            self.go_table.scrollloopvectical_taskList:UpdateCount(count)
            self.TaskListCount = count
        else
            self.go_table.scrollloopvectical_taskList:UpdateAllItem()
        end
    end
end

