        self.Timer:Stop()
        self.Timer = nil
    end
    self.EffTranDic = nil
    self.itemTable = nil
    self.TitleItemList = nil
    self.TaskItemList = nil
    self.GoalItemList = nil
    self.ClickCard = nil
end

return AcientEvilComesView
