end

function AcientEvilComesView:CheckClick()
    if not AcientEvilComesModel:GetInstance():CheckIsOpen() then
        return false
    end
    return true
end

function AcientEvilComesView:OnClickTask(go, isOn, index)
    local name = go:GetName()
    local taskInfo = self.TaskInfos[index]
    if not self:CheckClick() then
        return
    end
    if self.clickTask then
        return
    end
    if name == "@_aorbtn_get" then
        self.clickTask = true
        AcientEvilComesModel:GetInstance():FinishTask(
            taskInfo.id,
            _G.handler(self, self.OnFinishTaskSuccess),
            self.missionCfg[self.curTitleIndex].id
        )
    elseif name == "@_aorbtn_go" then
        local link = taskInfo.Cfg.link
        if link then
            if link ~= 0 then
                if _G.ConfigManager.item_way_cfg[link] then
                    _G.JumpManager:GetInstance():Jump(link)
                end
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(690102)
            end
        end
    end
end

function AcientEvilComesView:OnFinishTaskSuccess(msg)
    ---如果当前页签没有可领取 找到可以领取的页签 跳转 没有找到则不变
    if not AcientEvilComesModel:GetInstance():CheckHaveGetTask(self.missionCfg[self.curTitleIndex].id) then
        local index = AcientEvilComesModel:GetInstance():GetTitleIndex()
        if index then
            self.curTitleIndex = index
        end
    end
    self:InitView()
    require "CommonTipManager".OpenCommonAwardView(
        msg,
        function()
            self.clickTask = false
        end
    )
end

function AcientEvilComesView:OnClickTitle(go, isOn, index)
    if self.curTitleIndex == index then
        return
    end
    if index > self.unlockCount then
        local sid = _G.ConfigManager.mission_extra_cfg[self.missionCfg[index].missions[1]].function_open
        _G.FunctionManager:GetInstance():ShowFuncitonOpenTips(sid)
        return
    end
    self.TitleItemList[self.curTitleIndex].aorimage_On:SetActiveE(0)
    self.curTitleIndex = index
    self.TitleItemList[index].aorimage_On:SetActiveE(1)
    self:UpdateTask()
end

function AcientEvilComesView:InitProgress()
    local item
    local tb
    local maxLineSizeX = 555
    for k, v in pairs(self.goalCfg) do
        if not self.GoalItemList[k] then
            item = _G.InstantiateObject(self.go_table.obj_card, self.go_table.obj_line)
            local location = (v.value / self.maxGoal)
            item:SetName(v.value)
            item:SetAnchorPosition(location * 600 + 16, 0)
            tb = _G.GetAutoGoTable(item, _G.handlerbind(self, self.OnClickCard, v))
            local awardItem = require "BaseAwardNewItem".New(tb.obj_Root, nil, 73)
            awardItem:ShowWithID(v.reward[1])
            tb.obj_uieffect:ClearChildren()
            _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
                    tb.obj_uieffect
            )
            tb.aortext_cardProgress.text = v.value
            self.GoalItemList[k] = tb
        end
        tb = self.GoalItemList[k]
        tb.obj_uieffect:SetActiveE(v.state == 2 and 1 or 0)
        _G.GameUtil.SetActiveByCondition(tb.obj_mask, v.state == 1)
        --_G.GameUtil.SetActiveByCondition(tb.obj_eff, v.state == 2)
        --_G.GameUtil.SetActiveByCondition(tb.aorbtn_Get, v.state == 2)
    end
    local x = AcientEvilComesModel:GetInstance().CurActiveGoal
    self.go_table.aortext_nowActive.text = x
    -- if x == 0 or x < ((self.maxGoal * minSizeX) / maxSizeX) then
    --     self.go_table.aorimage_activeSchedule:SetRectTransformSize(minSizeX, 69)
    -- else
    if x >= self.maxGoal then
        self.go_table.aorimage_activeSchedule:SetRectTransformSize(maxLineSizeX, 10)
    else
        self.go_table.aorimage_activeSchedule:SetRectTransformSize(((x / self.maxGoal) * maxLineSizeX), 10)
    end
    --end
end

function AcientEvilComesView:OpenCard()
    local OnUIOpened
    OnUIOpened = function(name)
        if name == _G.ConfigManager.ui_cfg.AcientEvilComesView.Name then
            self:Hide()
            _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, OnUIOpened, self)
        end
    end
    if not self:CheckClick() then
        return
    end
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, OnUIOpened, self)
    require "CommonTipManager":GetInstance():OpenCardTip(
        cardId,
        nil,
        nil,
        function()
            self:Show()
        end
    )
end

function AcientEvilComesView:Help()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 54)
end

function AcientEvilComesView:SortTitleCfg()
    self.unlockCount = 0
    _G.SortList(
            self.missionCfg,
            function(cfg)
                local mission = cfg.missions[1]
                local funOpen = _G.ConfigManager.mission_extra_cfg[mission].function_open
                local order = 0
                if funOpen ~= 0 then
                    local conditions = _G.ConfigManager.function_open_cfg[funOpen].condition_type
                    for _, v in pairs(conditions) do
                        if not _G.GlobalConditionManager.CheckCondition(v[1], v[2]) then
                            order = 1
                            break
                        end
                    end
                end

                if order == 0 then
                    self.unlockCount = self.unlockCount + 1
                end

                return -order, -cfg.display_priority
            end
    )
end

function AcientEvilComesView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

function AcientEvilComesView:OnClickCard(go, isOn, data)
    local name = go:GetName()
    if not self:CheckClick() then
        return
    end
    if self.clickTask or self.ClickCard then
        return
    end
    if name == "@_aorbtn_Get" then
        if data.state == 2 then
            self.ClickCard = true
            AcientEvilComesModel:GetInstance():GetAward(data.id, _G.handlerbind(self, self.OnGetGoalSuccess, data.id))
        else
            self:OpenCard()
        end
    end
end

function AcientEvilComesView:ShowItems(go, data)
    for i, v in pairs(self.EffTranDic) do
        _G.DestroyObject(v.gameObject)
    end
    for key, value in pairs(self.itemTable) do
        _G.DestroyObject(value.gameObject)
    end
    self.EffTranDic = {}
    self.itemTable = {}
    local x, y, z = go:GetPosition()
    self.go_table.obj_ItemTips:SetPosition(x, y + 0.7, z)
    local NowItems = data.reward
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_TipsView, true)
    for i = 1, #NowItems do
        self:CareatItem(NowItems[i], self.go_table.obj_Parent, self.itemTable, data.state)
    end
end

function AcientEvilComesView:CareatItem(reward, Parent, itemTable, state)
    if _G.IsNil(Parent) or Parent:GetctiveInHierarchy() == 0 then
        return
    end
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        reward,
        Parent,
        function(item)
            item:SetGou(state == 1)
            item.gameObject:SetLocalScaleXYZ(0.7)
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            if state == 2 then
                local effCfg, key = _G.StorageManager:GetInstance():GetCommonLightEffect(reward[1])
                self:TeXiaoShengCheng(item, effCfg)
            end
            table.insert(itemTable, item)
        end,
        function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, reward[1])
        end
    )
end

function AcientEvilComesView:TeXiaoShengCheng(obj, effCfg)
    _G.UIUtils.LoadEffectByCfg(
        effCfg,
        obj.gameObject,
        function(trans)
            _G.table.insert(self.EffTranDic, trans)
        end
    )
end

function AcientEvilComesView:HideAward()
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_TipsView, false)
end

function AcientEvilComesView:OnGetGoalSuccess(msg, id)
    local tb = self.GoalItemList[id]
    tb.obj_mask:SetActiveE(1)
    -- tb.obj_eff:SetActiveE(0)
    --tb.aorbtn_Get:SetActiveE(0)
    self:InitProgress()
    require "CommonTipManager".OpenCommonAwardView(
        msg,
        function()
            self.ClickCard = false
        end
    )
end

---一键领取所有奖励
