function AcientEvilComesView:UpdateTime(elapsed)
    self.CountDown = self.CountDown - elapsed
    self.go_table.aortext_countDown.text =
        GetLangPackValue(
        90000010360,
        string.format(
            "<color=#f1df89>%s</color>",
            _G.TimeUtil.TranslateSecondForStrAcientEvil(Mathf.RoundToInt(self.CountDown))
        )
    )
    if self.CountDown <= 0 then
        self.go_table.aortext_countDown.text = GetLangPackValue(90026500028)
        if self.Timer then
            self.Timer:Stop()
            self.Timer = nil
        end
    end
end

