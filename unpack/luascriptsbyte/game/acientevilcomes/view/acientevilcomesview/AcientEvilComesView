function AcientEvilComesView:RefreshTask(index, obj)
    local x = index + 1
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickTask, x))
    self.TaskItemList[x] = tb
    local taskInfo = self.TaskInfos[x]
    if taskInfo == nil then
        return
    end
    local getItem = function(_data, _tb, isgou, isCanTake)
        local p = _tb.obj_items
        for i = 1, p:GetChildCountE() do
            p:GetChildE(i - 1):DestroyObject()
        end
        for i = 1, #_data do
            if _data[i][1] ~= 47 then
                _G.StorageManager:GetInstance():GetItemBaseViewNew(
                    _data[i],
                    p,
                    function(tran)
                        _tb.item = tran
                        tran.sid = _data[i][1]
                        tran.gameObject:SetLocalPosition(0, 0, 0)
                        tran.gameObject:SetLocalScaleXYZ(0.85)
                        tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                        if tran.SetGou then
                            tran:SetGou(isgou)
                        end
                        if tran.SetGradeNew then
                            tran:SetGradeNew(false)
                        end
                        if isCanTake then
                            --self:LoadEff(tran.go_table, _data[i][1])
                        end
                    end,
                    function(gameObject)
                        if gameObject.sid or (gameObject[1] and gameObject[1].sid) then
                            require "CommonTipManager":GetInstance():OpenTip(p, gameObject.sid or gameObject[1].sid)
                        else
                            self:OpenCard()
                        end
                    end
                )
            end
        end
    end

    local reward = taskInfo.Cfg.reward
    local CheckIsGet = taskInfo:CheckIsGet()
    local CheckIsCanTake = taskInfo:CheckIsCanTake()
    local now, total = taskInfo:GetCount()
    local info = GetLangPackValue(taskInfo.Cfg.desc) .. "(" .. now .. "/" .. total .. ")"
    tb.aortext_info.text = info
    getItem(reward, tb, CheckIsGet, CheckIsCanTake)
    _G.GameUtil.SetActiveByCondition(tb.aorbtn_get, CheckIsCanTake)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_complete, CheckIsGet)
    _G.GameUtil.SetActiveByCondition(tb.aorbtn_go, not CheckIsGet and not CheckIsCanTake)
end

