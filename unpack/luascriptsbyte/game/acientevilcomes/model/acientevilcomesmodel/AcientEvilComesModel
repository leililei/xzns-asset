                view:Close()
            end
        )
    end
    -- if mainview then
    --     mainview:ShowAcientEvilComesBtn()
    -- end
end
---预完成添加
function AcientEvilComesModel:Addaward_task(sid)
    local Is = true
    for _, value in pairs(self.starsGoals.award_task) do
        if value == sid then
            Is = false
        end
    end
    if Is then
        _G.table.insert(self.starsGoals.award_task, sid)
    end
    return Is
end
---预完成删除
function AcientEvilComesModel:Disaward_task(sid)
    local Is = false
    local num = 0
    for key, value in pairs(self.starsGoals.award_task) do
        if value == sid then
            Is = true
            num = key
        end
    end
    if Is then
        _G.table.remove(self.starsGoals.award_task, num)
    end
    return Is
end

function AcientEvilComesModel:CountFinishTask(call)
    local tb = {}
    for key, value in pairs(self.starsGoals.award_task) do
        _G.table.insert(tb, value)
    end
    require "AcientEvilNet":GetInstance():FinishTask(
        {sid = tb, type = 1},
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            for key, value in pairs(tb) do
                self.taskModel:FinishTask(value)
                _G.table.insert(self.starsGoals.finish_task, value)
                self:Disaward_task(value)
            end
            for key, value in pairs(self.MissionCfg) do
                require "RedPointManager":GetInstance():RefreshNode(
                    _G.ConfigManager.redpoint_cfg.StarsGoalTask.id,
                    value.id
                )
            end
            if call then
                call(msg)
            end
        end
    )
end

---完成任务
function AcientEvilComesModel:FinishTask(sid, call, titleId)
    require "AcientEvilNet":GetInstance():FinishTask(
        {sid = {sid}, type = 1},
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            self.taskModel:FinishTask(sid)
            _G.table.insert(self.starsGoals.finish_task, sid)

            self:Disaward_task(sid)
            require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.StarsGoalTask.id, titleId)
            if call then
                call(msg)
            end
        end
    )
end
---返回预完成列表
function AcientEvilComesModel:GetAward_task()
    if self.starsGoals.award_task == nil then
        self.starsGoals.award_task = {}
    end
    return self.starsGoals.award_task
end

---领取满星计划进度奖励
function AcientEvilComesModel:GetAward(sid, call)
    require "AcientEvilNet":GetInstance():GetGoalAward(
        sid,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            self.GoalCfg[sid].state = 1
            require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.StarsGoalReward.id)
            if call then
                call(msg)
            end
        end
    )
end
