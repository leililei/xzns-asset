--region 任务

---获取任务数据
---@param stars_mission_cfg.id
function AcientEvilComesModel:GetTaskDatas(index)
    local task
    if not self.MissionCfg[index] then
        return nil
    end
    self.taskArray = {}
    for _, v in pairs(self.MissionCfg[index].missions) do
        task = self.taskModel.taskDatas[v]
        _G.table.insert(self.taskArray, task)
    end
    self:SortTask()
    return self.taskArray
end
---任务排序
function AcientEvilComesModel:SortTask()
    if not self.taskArray then
        return
    end
    _G.SortList(
        self.taskArray,
        function(v)
            local type = 0
            if v:CheckIsCanTake() then
                type = 99
            elseif v:CheckIsGet() then
                type = -99
            end
            return type, -v.id
        end
    )
end
---检测是否完成
function AcientEvilComesModel:CheckIsFinish(sid)
    return self.taskModel:CheckIsFinish(sid)
end
---检测是否有可领取的任务
---@param sid number stars_mission_cfg.id
function AcientEvilComesModel:CheckHaveGetTask(sid)
    local Is = false
    if self.taskModel:CheckHaveGetTask(sid) then
        if not Is then
            Is = true
        end
    end
    return Is
end
---检测是否有可领取的活跃奖励
function AcientEvilComesModel:CheckHaveGetGoal()
    for k, v in pairs(self.GoalCfg) do
        if v.state == 2 then
            return true
        end
    end
    return false
end
function AcientEvilComesModel:UpdataTask(task, num)
    self.taskModel:UpdataTask(task, num)
end
--endregion
function AcientEvilComesModel:Gettarget(id)
    local k = {}
    for i = 1, _G.table.count(id) - 1 do
        _G.table.insert(k, id[i])
    end
    local num = 0
    for key, value in pairs(self.starsGoals.collectors) do
        if table.sameByCount(k, value.key) then
            num = value.value
        end
        -- body
    end

    return {[1] = num}
end
---判断当前完成状态
function AcientEvilComesModel:Getstate(id)
    local tsak = _G.TaskEnum.ETaskState.Claimed

    for key, value in pairs(self.starsGoals.award_task) do
        if value == id then
            tsak = _G.TaskEnum.ETaskState.Submited
        end
    end

    for key, value in pairs(self.starsGoals.finish_task) do
        if value == id then
            tsak = _G.TaskEnum.ETaskState.Completed
        end
    end

    return tsak
end

function AcientEvilComesModel.CheckAcientIsOpen()
    return AcientEvilComesModel:GetInstance():CheckIsOpen()
end
function AcientEvilComesModel:AddRed(sid)
    for key, value in pairs(_G.ConfigManager.stars_mission_cfg) do
        for _, s in pairs(value.mission_group) do
            if sid == s then
                require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.StarsGoalTask.id, key)
                if self.taskModel.TaskList == nil then
                    self.taskModel.TaskList = {}
                elseif self.taskModel.TaskList[key] == nil then
                    self.taskModel.TaskList[key] = {}
                end
                if false == _G.table.indexof(self.taskModel.TaskList[key], s) then
                    _G.table.insert(self.taskModel.TaskList[key], s)
                end
                break
            end
        end
    end
end
return AcientEvilComesModel
