---@class AcientEvilTaskModel	中文描述
---@field finishTasks table<boolean>
---@field taskDatas HellGuardTaskData[]
local AcientEvilTaskModel = _G.BaseClass("AcientEvilTaskModel")
local mission_extra_cfg = _G.ConfigManager.mission_extra_cfg

---类的析构函数
function AcientEvilTaskModel:Dispose()
    self.TaskList = nil
    self.taskDatas = nil
    self.finishTasks = nil
    if self.FreshTimer ~= nil then
        self.FreshTimer:Stop()
        self.FreshTimer = nil
    end
end
function AcientEvilTaskModel:__init()
    require("AcientEvilComesModel"):GetInstance().starsGoals = {}

    self.taskDatas = {}

    self.TaskList = {}
end
---解析数据
---@param msg guard.s2c_guard_info
function AcientEvilTaskModel:Parse(msg)
    ---初始化已完成的任务
    self:InitFinishTask(msg)
    self:InitTaskDatas(msg)
end
function AcientEvilTaskModel:InitTaskDatas(msg)
    require("AcientEvilComesModel"):GetInstance().starsGoals = msg.info
    if require("AcientEvilComesModel"):GetInstance().starsGoals.award_task == nil then
        require("AcientEvilComesModel"):GetInstance().starsGoals.award_task = {}
    end
    if require("AcientEvilComesModel"):GetInstance().starsGoals.finish_task == nil then
        require("AcientEvilComesModel"):GetInstance().starsGoals.finish_task = {}
    end

    if not _G.table.isEmptyOrNil(self.taskDatas) then
        for k, v in pairs(self.taskDatas) do
            v:Dispose()
        end
    end
    self.taskDatas = {}
    self.TaskList = {}

    for key, value in pairs(_G.ConfigManager.stars_mission_cfg) do
        self.TaskList[key] = {}
        for _, s in pairs(value.mission_group) do
            if mission_extra_cfg[s] == nil or mission_extra_cfg[s].condition[1] == nil then
                _G.Log(s)
            else
                local state = require("AcientEvilComesModel"):GetInstance():Getstate(s)

                local target =
                    require("AcientEvilComesModel"):GetInstance():Gettarget(mission_extra_cfg[s].condition[1])
                self.taskDatas[s] =
                    require "AcientEvilTaskData".New(
                    {sid = s, target = target, state = state, cfg = mission_extra_cfg[s]},
                    function(taskid)
                        require "RedPointManager":GetInstance():RefreshNode(
                            _G.ConfigManager.redpoint_cfg.StarsGoalTask.id,
                            require "AcientEvilComesModel":GetInstance():GetMissionIdByTask(taskid)
                        )
                    end
                )

                if not self:CheckIsFinish(s) then
                    if state == _G.TaskEnum.ETaskState.Completed or state == _G.TaskEnum.ETaskState.Submited then
                        require "AcientEvilComesModel":GetInstance():Addaward_task(s)
                        table.insert(self.TaskList[key], s)
                    end
                end
            end
        end
    end

    if self.finishTasks then
        for k, v in pairs(self.finishTasks) do
            self.taskDatas[k] =
                require "AcientEvilTaskData".New(
                {
                    sid = k,
                    target = {mission_extra_cfg[k].count},
                    state = _G.TaskEnum.ETaskState.Submited,
                    cfg = mission_extra_cfg[k]
                }
            )
        end
    end
end

function AcientEvilTaskModel:GetTaskDatas()
    return self.taskDatas
end

---更新任务数据
function AcientEvilTaskModel:UpdataTask(task, num)
    if not self.taskDatas then
        return
    end
    local isUpdata = false
    if task == nil or task.sid == nil then
        return isUpdata
    end
    local mTask = self:GetTaskByTaskid(task.sid)
    if mTask == nil then
        return isUpdata
    end
    mTask:UpdataData(task)

    if mTask:CheckIsCanTake() then
        local isOk = false
        for key, value in pairs(_G.ConfigManager.stars_mission_cfg) do
            for _, s in pairs(value.mission_group) do
                if task.sid == s then
                    require "AcientEvilComesModel":GetInstance():Addaward_task(s)
                    if false == _G.table.indexof(self.TaskList[key], s) then
                        _G.table.insert(self.TaskList[key], s)
                    end
                    isOk = true
                    break
                end
            end
            if isOk then
                break
            end
        end
    else
        for key, value in pairs(self.TaskList) do
            if false ~= _G.table.indexof(value, task.sid) then
                _G.table.removebyvalue(self.TaskList[key], task.sid)
                break
            end
        end
    end
    self:CoFreshView()
    self:RefreshRedPoint(task.id.id)
    return true
end
function AcientEvilTaskModel:CoFreshView()
    if self.FreshTimer then 
        return 
    end
    self.FreshTimer = _G.TimerManager:GetInstance():GetTimer(0.5, self.FreshView, self, true)
    self.FreshTimer:Start()
end
function AcientEvilTaskModel:FreshView()
    local window = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.AcientEvilComesView.Name)
    if window then
        window:UpdateTask()
    end
    if self.FreshTimer ~= nil then
        self.FreshTimer:Stop()
        self.FreshTimer = nil
    end
end
function AcientEvilTaskModel:RefreshRedPoint(taskId)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.StarsGoalTask.id, taskId)
end
function AcientEvilTaskModel:GetTaskByTaskid(taskid)
    for _, v in pairs(self.taskDatas) do
        if v.id == taskid then
            return v
        end
    end
    return nil
end
--region 完成任务
---初始化任务完成
---@param msg guard.proto.s2c_guard_info
function AcientEvilTaskModel:InitFinishTask(msg)
    self.finishTasks = {}
    if msg.info.finish_task then
        for _, v in pairs(msg.info.finish_task) do
            self.finishTasks[v] = true
        end
    end
end

---检测是否完成
function AcientEvilTaskModel:CheckIsFinish(sid)
    return self.finishTasks[sid]
end

---完成任务
---@param data HellGuardTaskData
function AcientEvilTaskModel:FinishTask(sid)
    self.finishTasks[sid] = true
    self.taskDatas[sid]:CheckTaskState()
    for key, value in pairs(self.TaskList) do
        if false ~= _G.table.indexof(value, sid) then
            _G.table.removebyvalue(self.TaskList[key], sid)
            break
        end
    end
end
---检测是否有可领取的任务
function AcientEvilTaskModel:CheckHaveGetTask(sid)
    if self.TaskList[sid] then
        if #self.TaskList[sid] > 0 then
            return true
        end
    end
    return false
end
--endregion

return AcientEvilTaskModel
