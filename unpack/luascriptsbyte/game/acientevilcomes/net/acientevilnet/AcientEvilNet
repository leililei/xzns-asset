local base = require "BaseGameNet"
---@class AcientEvilNet : BaseGameNet	通信协议
local AcientEvilNet = _G.BaseClass("AcientEvilNet", base)

---@return AcientEvilNet AcientEvilNet
function AcientEvilNet:GetInstance()
    return self.super.super.GetInstance(self)
end
---添加所有后端主动推的网络消息监听接口
function AcientEvilNet:AddMessageListeners()
    ---请手动添加后端主动推送的消息监听代码
    self:AddMessageListener(_G.ConfigManager.net_map.game_stars_goal_collector.Cmd, self.SendChengJiuCollectorCall)
end
---请求
---@param pbData table PB数据
---@param callback function 完成回调
function AcientEvilNet:GetInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_stars_goal_info
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---完成任务
function AcientEvilNet:FinishTask(pbData, callback)
    local item = _G.ConfigManager.net_map.game_stars_goal_finish
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---获取奖励
function AcientEvilNet:GetGoalAward(sid, callback)
    local item = _G.ConfigManager.net_map.game_stars_goal_award
    local port = base.Access(self, item, {sid = sid}, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---后端主动推送的消息数据开始
---发送成就收集消息
---@param data stars_goal.p2c_stars_goal_collector
