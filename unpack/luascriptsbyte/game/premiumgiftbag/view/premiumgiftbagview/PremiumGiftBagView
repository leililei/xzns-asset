local PremiumGiftBagModel = require "PremiumGiftBagModel"
---@class PremiumGiftBagView : UIBaseView	超值礼包
---@field public go_table PremiumGiftBagView_GoTable GoTable
local PremiumGiftBagView = _G.BaseClass("PremiumGiftBagView", _G.UIBaseView)

function PremiumGiftBagView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面入口
function PremiumGiftBagView:OnCreate()
end

function PremiumGiftBagView:OnEnable()
    self:InitAward(_G.ConfigManager.store_active_cfg[300001].id, 1)
end

---初始化界面
function PremiumGiftBagView:InitView()
    self:RefreshAward(PremiumGiftBagModel.AwardID.list1, 1)
end

---刷新奖励
function PremiumGiftBagView:RefreshAward()
    --清空
    for i = 1, self.go_table.obj_list1:GetChildCountE() do
        _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_awards6:GetChildE(0), _G.ePoolType.UIItem)
    end
    for i = 1, self.go_table.obj_list2:GetChildCountE() do
        _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_awards30:GetChildE(0), _G.ePoolType.UIItem)
    end
    for i = 1, self.go_table.obj_list3:GetChildCountE() do
        _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_awards6:GetChildE(0), _G.ePoolType.UIItem)
    end
    for i = 1, self.go_table.obj_list4:GetChildCountE() do
        _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_awards30:GetChildE(0), _G.ePoolType.UIItem)
    end
end

---初始化奖励
function PremiumGiftBagView:InitAward(id, type)
    if type ~= nil then
        if type == 1 then
            local parent1 =
                id == PremiumGiftBagModel.AwardID.list1 and self.go_table.obj_list1 or
                PremiumGiftBagModel.AwardID.list2 and self.go_table.obj_list2
            self:ShowAward(parent1, id)
        elseif type == 2 then
            local parent2 =
                id == PremiumGiftBagModel.AwardID.list3 and self.go_table.obj_list3 or
                PremiumGiftBagModel.AwardID.list4 and self.go_table.obj_list4
            self:ShowAward(parent2, id)
        end
    end
end

---显示礼包内容
function PremiumGiftBagView:ShowAward(parent, id)
    local awards = _G.ConfigManager.store_active_cfg[id].goods
    for i = 1, #awards do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            awards[i],
            parent,
            function(tran)
                tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.None)
                tran.gameObject:SetLocalScaleXYZ(0.8)
                local got = GetAutoGoTable(tran.gameObject)
                got.aortext_Number.color = Color.New(255 / 255, 255 / 255, 255 / 255, 1)
            end
        )
    end
end

--按钮点击事件派发
function PremiumGiftBagView:OnClickBtn(go, isOn)
    local name = go:GetName()
end

return PremiumGiftBagView
