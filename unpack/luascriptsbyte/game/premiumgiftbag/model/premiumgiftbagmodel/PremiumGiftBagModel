local PremiumGiftBagNet = require "PremiumGiftBagNet"
---@class PremiumGiftBagModel
local PremiumGiftBagModel = _G.BaseClass("PremiumGiftBagModel", _G.GameDataModelBase)
---@return PremiumGiftBagModel PremiumGiftBagModel

PremiumGiftBagModel.AwardID = {
    list1 = _G.ConfigManager.store_active_cfg[300001].id,
    list2 = _G.ConfigManager.store_active_cfg[300002].id
    -- list1=300001,
    -- list2=300002
}

function PremiumGiftBagModel:GetInstance()
    return self.super.GetInstance(self)
end
function PremiumGiftBagModel:GetDataFormServer()
    PremiumGiftBagNet:GetInstance():GetPopAwardInfos(_G.handler(self, self.ParseData))
end
function PremiumGiftBagModel:GetInfo()
    PremiumGiftBagNet:GetInstance():GetPopAwardInfos(_G.handler(self, self.ParseData))
end
function PremiumGiftBagModel:ParseData(msg)
    self.msg = msg
    self.super.ParseData(self)
end

---领取奖励
---@param id number DailyDeliveryModel.AwardID
function PremiumGiftBagModel:GetReward(id, callback)
    PremiumGiftBagNet:GetInstance():GetAward(
        {sid = id},
        function(data)
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            require "CommonTipManager".OpenCommonAwardView(data)
            if not self.sids then
                self.sids = {}
            end
            _G.table.insert(self.sids, id)
            if callback then
                callback()
            end
        end
    )
end

return PremiumGiftBagModel
