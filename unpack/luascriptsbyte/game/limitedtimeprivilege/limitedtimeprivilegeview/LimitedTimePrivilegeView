local base = require "EventViewBase"
---@class LimitedTimePrivilegeView : UIBaseView	限时特权
---@field public go_table LimitedTimePrivilegeView_GoTable GoTable
local LimitedTimePrivilegeView = _G.BaseClass("LimitedTimePrivilegeView", base)

local imgPath = {
    [405001] = "Images/nLimitedTimePrivilege/ui_tq_jstq_txt",
    [405002] = "Images/nLimitedTimePrivilege/ui_tq_dztq_txt",
    [405003] = "Images/nLimitedTimePrivilege/ui_tq_zmtq_txt",
    [405004] = "Images/nLimitedTimePrivilege/ui_ls_zhtq_txt",
    [405005] = "Images/nBenedictionView/ui_sc_zf_xctq_txt"
}

function LimitedTimePrivilegeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnCashListener, self)
end

---界面的入口函数
function LimitedTimePrivilegeView:OnCreate(sid, privilegeData)
    self.sid = sid
    if sid and require "MonthlyModel":GetInstance():IsHavePrivi(sid) then
        self.hasPrivilege = true
    else
        self.hasPrivilege = false
    end

    --if privilegeData and privilegeData[1] ~= nil then
    --     self.hasPrivilege = true
    -- else
    --     self.hasPrivilege = false
    -- end
    self.cfg = _G.ConfigManager.store_month_cfg[sid]
    self:InitView()
    if _G.AppSetting.IsXzns then
        _G.GameUtil.SetUiHeXieMask(self.go_table)
    end
end

---函数功能注释
function LimitedTimePrivilegeView:InitView()
    --self.go_table.aorrawimage_title:LoadImage(
    --    imgPath[self.cfg.id],
    --        function(trans)
    --            if not trans then
    --                return
    --            end
    --            trans:SetNativeSize()
    --        end
    --    )
    local desArr = _G.string.split(_G.GetLangPackValue(self.cfg.describe_2), "\n")
    for i = 1, #desArr do
        _G.PoolsManager:GetInstance():Spawn(
            "UIH5/LimitedTimePrivilege/$_obj_des",
            _G.ePoolType.Temporary,
            self.go_table.trans_Content,
            function(obj)
                local tb = _G.GetAutoGoTable(obj)
                tb.aortext_des.text = desArr[i]
            end
        )
    end
    --self.go_table.aortext_des.text = _G.GetLangPackValue(self.cfg.describe_2)
    if string.len(self.cfg.title_path) == 0 then
        self.go_table.obj_title:SetActiveE(1)
        self.go_table.aorrawimage_Title:SetActiveE(0)
        self.go_table.aortext_title.text = _G.GetLangPackValue(self.cfg.name)
    else
        self.go_table.obj_title:SetActiveE(0)
        self.go_table.aorrawimage_Title:SetActiveE(1)
        self.go_table.aorrawimage_Title:LoadImage(self.cfg.title_path)
        self.go_table.aorrawimage_Bg1:LoadImage(self.cfg.background_1)
        self.go_table.aorrawimage_Bg2:LoadImage(self.cfg.background_2)
        local spine = self.cfg.spine_coefficient
        _G.PoolsManager:GetInstance():Spawn(
            self.cfg.spine_path,
            _G.ePoolType.Temporary,
            self.go_table.aorrawimage_Role,
            function(trans)
                if trans == nil then
                    if _G.AppSetting.DEBUG then
                        _G.LogError("角色无法加载 path:" .. self.cfg.spine_path .. "    LimitedTimePrivilegeView LoadRoleScene")
                    end
                    return
                end
                if self.go_table == nil then
                    _G.DestroyObject(trans)
                    return
                end
                GameUtil.SetCardUiSpineAnimation(trans, "idle", true)
                trans:SetLocalPosition(spine[1], spine[2], spine[3])
                trans:SetLocalScaleXYZ(spine[4])
                trans:SetLocalRotation(0, spine[5], 0)
            end
        )
        _G.DelayFrameDo(function()
            self.go_table.aorrawimage_Title:SetNativeSize()
            self.go_table.aorrawimage_Bg1:SetNativeSize()
            self.go_table.aorrawimage_Bg2:SetNativeSize()
        end)
    end
    if self.cfg.color then
        self.go_table.aortext_title:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor =
            _G.ColorTools.FormatColorByString(self.cfg.color)
    end
    if self.cfg.type_2 == 1 then
        _G.GameUtil.SetPriceByChannel(self.cfg.price_id, self.go_table.aortext_price)
        _G.GameUtil.AddDouYinIcon(self.go_table.aorbtn_buy, true)
        self.go_table.obj_zuan:SetActiveE(0)
    elseif self.cfg.type_2 == 2 then
        self.go_table.obj_zuan:SetActiveE(1)
        self.go_table.aortext_price:SetActiveE(0)
        local finalPrice = require "MallManager":GetInstance():GetFinalPrice(self.cfg.price_id)
        self.go_table.aortext_zuan.text = finalPrice
    end
    self:ShowAward()
    self:UpdatePrivilegeState()
end

function LimitedTimePrivilegeView:UpdatePrivilegeState()
    if self.hasPrivilege then
        self.go_table.aorbtn_buy:SetActiveE(0)
        self.go_table.aortext_time:SetActiveE(1)
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        local _, time = require("MonthlyModel"):GetInstance():IsHavePrivi(self.sid)
        self.PrivilegEnd = time
        if self.cfg.day_extra > 0 then
            self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.TimeUpdate, self, false, false, true)
            self.timer:Start()
        end
        self:TimeUpdate(0)
    else
        self.go_table.aorbtn_buy:SetActiveE(1)
        self.go_table.aortext_time:SetActiveE(0)
    end
end

function LimitedTimePrivilegeView:TimeUpdate(fix)
    local time = self.PrivilegEnd - fix
    if time <= 0 and self.cfg.day_extra > 0 then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        self.PrivilegEnd = nil
        self.hasPrivilege = false
        self.go_table.aorbtn_buy:SetActiveE(1)
        self.go_table.aortext_time:SetActiveE(0)
        return
    end
    if self.cfg.day_extra > 0 then
        local t = _G.TimeUtil.TranslateSecond(time)
        self.go_table.aortext_time.text = _G.GetLangPackValue(90021600065, t.day)
    else
        self.go_table.aortext_time.text = _G.GetLangPackValue(90000001066)
    end
end

---显示礼包内容
---@param id number 传入礼包id
function LimitedTimePrivilegeView:ShowAward()
    local awards = self.cfg.goods1
    for i = 1, #awards do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            awards[i],
            self.go_table.obj_awardRoot,
            function(tran)
                tran:ShowName(false)
                tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                tran:ShowEffect(tran.cfg.ef_item and tran.cfg.ef_item == 1)
            end
        )
    end
end

---按钮点击事件在这里派发
function LimitedTimePrivilegeView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeView or go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_buy then
        if self.cfg.type_2 == 1 then
            require("MallManager"):GetInstance():BuyActiveGift(self.cfg.price_id, nil, self.cfg.id)
        elseif self.cfg.type_2 == 2 then
            local Diamond = _G.StorageManager:GetInstance():GetItemCountBySid(12)
            local finalPrice = require "MallManager":GetInstance():GetFinalPrice(self.cfg.price_id)
            if Diamond >= finalPrice then
                require("MonthlyModel"):GetInstance():BuyByDiamond(self.cfg.id, function(msg)
                    self:Close()
                end)
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(230303)
            end
        end
    elseif go == self.go_table.aorbtn_go then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MallView.Name, _G.MallViewPage.Privilege)
        _G.DelayFrameDo(function()
            self:Close()
        end)
    end
end

---充值回调
function LimitedTimePrivilegeView:OnCashListener(data)
    if data.sid == self.cfg.id then
        local window = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.GodDrawView.Name)
        if window then
            window:LoadGodConsumesInfos()
        end
        local window = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.GetawardView.Name)
        if window then
            window:FreshQuickImage()
        end
        self:Close()
    end
end

function LimitedTimePrivilegeView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return LimitedTimePrivilegeView
