local base = require("GameDataModelBase")
local PlayerPrefsManager = _G.PlayerPrefsManager
local RechargeRankingNet = require("RechargeRankingNet")
local RechargeRankingModel = _G.BaseClass("RechargeRankingModel", base)


---@return RechargeRankingModel RechargeRankingModel
function RechargeRankingModel:GetInstance()
    return self.super.GetInstance(self)
end

---入口构造函数
function RechargeRankingModel:__init(activity)
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.OnSixClockUpdateCallback, self)

    -- 红点初始不显示
    self.showRedDot = false
    -- 监听充值事件
    _G.Events:GetInstance():AddListener(_G.eRechargeEvent.TotalCash, self.OnRechargeTotalCash, self)
end

--- 当玩家点击进入活动页面时调用该方法
function RechargeRankingModel:OpenWindowSetRedPoint()
    -- 标记红点已读
    self.showRedDot = false
    local playerUID = tostring(_G.PlayerModel:GetInstance().role_uid)
    local redBol = require "RedPointManager":GetInstance():GetNodeNum(_G.ConfigManager.redpoint_cfg.RechargeRank.id)
    if redBol > 0 then
        PlayerPrefsManager.SetInt(playerUID .. "RechargeHasReadRedDot", 1)
    end
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RechargeRank.id)

    -- base.OnEnterActivity(self)
end

---初始化时解析数据
function RechargeRankingModel:GetDataFormServer()
     if not  _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.ConfigManager.main_function_cfg[_G.MainFunctionItems.RechargeRank].function_open) then

        _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.RechargeRank)
        self.super.ParseData(self)
        return
    end
    self:GetInfo()
end

function RechargeRankingModel:GetInfo(call)
    self.infoCall = call
    RechargeRankingNet:GetInstance():AccessAfk(_G.handler(self, self.ParseData))
    RechargeRankingNet:GetInstance():GetPlayerRank(_G.handler(self, self.ParseDataRank))
end

function RechargeRankingModel:ParseData(msg)
    self:SetSelfData(msg)
    self.List = msg
    self.super.ParseData(self)
end

function RechargeRankingModel:ParseDataRank(msg)
    --自己匿名情况
    self.anonymous = msg.anonymous
    self.myNum = msg.cash_num or 0
    if self.infoCall then
        self.infoCall(msg)
        self.infoCall = nil
    end
    self:CheckRed()
    self.super.ParseData(self)
end

---活动本身数据处理
function RechargeRankingModel:SetSelfData(info)
    ---排行奖励信息
    self.rank_list = {}

    for i, v in pairs(_G.ConfigManager.activity_rmbrank_cfg) do
        local new_entry = {}
        new_entry.min_rank = v.min_rank
        new_entry.max_rank = v.max_rank
        new_entry.reward_daily = {}
        for key, value in pairs(v.reward_daily) do
            local list = {}
            list.type = value
            table.insert(new_entry.reward_daily, list)
        end
        
        new_entry.value_rank = _G.GameUtil.RatioControlNumber(v.value_rank)--math.floor(v.value_rank / 100)
        table.insert(self.rank_list, new_entry)
    end

    -- self:RefreshServerAnonymous()
end

---View从Net获取排行榜数据
function RechargeRankingModel:AccessAfkList(call)
    call(self.List)
end

---获取玩家在排行榜上的名次
function RechargeRankingModel:GetPlayerRank(call)
    call()
end

---获取排行奖励信息
function RechargeRankingModel:GetGiftsList()
    return self.rank_list
end

---获取玩家自己是否匿名  是(1|0)否
function RechargeRankingModel:GetPlayerAnonymous()
    return self.anonymous
end

---获取玩家自己充值金额
function RechargeRankingModel:GetPlayerCash_num()
    return self.myNum
end

---设置是否玩家自己匿名 是(1|0)否
function RechargeRankingModel:SaveAnonymousCondition(call)
    require("RechargeRankingNet"):GetInstance():SetPlayerAnonymous(
        1 - self.anonymous,
        function()
            self.anonymous = 1 - self.anonymous
            if call then
                call()
            end
            self:CachingAnonymous()
        end
    )
end

function RechargeRankingModel:CachingAnonymous()
    _G.PlayerPrefsManager.SetInt("AnonymousRankState", self.anonymous)
end

function RechargeRankingModel:GetCachingAnonymous()
    return _G.PlayerPrefsManager.GetInt("AnonymousRankState", self.anonymous)
end

function RechargeRankingModel:RefreshServerAnonymous()
    local CachingActiveID = self:GetCachingActiveID()
    local isRefresh = false
    if CachingActiveID ~= tostring(self.ActivitySid) then
        isRefresh = true
        self:CachingActiveID()
    end
    if isRefresh and self:GetCachingAnonymous() ~= self.anonymous then
        self:SaveAnonymousCondition()
    end
end

---获取活动时间倒计时
function RechargeRankingModel:GetEndTime()
    return self.curActivityClass.cfg.time.start_time + self.curActivityClass.cfg.time.run_time
end

---六点刷新更新红点
function RechargeRankingModel:OnSixClockUpdateCallback()
    local playerUID = tostring(_G.PlayerModel:GetInstance().role_uid)
    PlayerPrefsManager.SetInt(playerUID .. "RechargeHasReadRedDot", 0)
end

--- 监听充值事件的回调
function RechargeRankingModel:OnRechargeTotalCash()
     if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.ConfigManager.main_function_cfg[_G.MainFunctionItems.RechargeRank].function_open) then
        return
     end
    self:GetInfo(_G.handler(self, self.CheckRed))
end

function RechargeRankingModel:CheckRed()
    local PlayerMoney = math.floor(self.myNum / 100)
    local playerUID = tostring(_G.PlayerModel:GetInstance().role_uid)

    -- 玩家是否已经点击进入页面过（读取后本轮不再激活红点）
    local hasReadRedDot = PlayerPrefsManager.GetInt(playerUID .. "RechargeHasReadRedDot", 0) == 1


    if PlayerMoney == 0 then
        PlayerPrefsManager.SetInt(playerUID .. "RechargeHasReadRedDot", 0)
    end
    if PlayerMoney >= self.rank_list[#self.rank_list].value_rank and not hasReadRedDot then
        self.showRedDot = true
    else
        self.showRedDot = false
    end
    -- 刷新红点状态
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RechargeRank.id)
end

-- 清理资源
function RechargeRankingModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eRechargeEvent.TotalCash, self.OnRechargeTotalCash, self)
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.OnSixClockUpdateCallback, self)
    base.Dispose(self)
end

return RechargeRankingModel
