---@class DailyRechargeRankingNet : BaseGameNet 通信协议
local base = require("BaseGameNet")
local DailyRechargeRankingNet = _G.BaseClass("DailyRechargeRankingNet", base)

---@return DailyRechargeRankingNet DailyRechargeRankingNet
function DailyRechargeRankingNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---前100名上榜排行榜数据
---@param callback function 回调方法
function DailyRechargeRankingNet:AccessAfk(activityId, callback)
    local item = _G.ConfigManager.net_map.game_rank_store_day
    local port = base.Access(self, item, { page = 1, id = activityId }, _G.handler(self, self.AccessCall))
    self.Call[port] = callback
end

---获取个人排名
function DailyRechargeRankingNet:GetPlayerRank(activityId, callback)
    local item = _G.ConfigManager.net_map.game_rank_get_rank_num
    local port = base.Access(self, item, { type = activityId }, _G.handler(self, self.AccessCall))
    self.Call[port] = callback
end

---发送玩家匿名情况
function DailyRechargeRankingNet:SetPlayerAnonymous(activityId, callback)
    local item = _G.ConfigManager.net_map.game_activity_module_port_store_day_anonymous
    local port = base.Access(self, item, { activity_id = activityId }, _G.handler(self, self.AccessCall))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function DailyRechargeRankingNet:AccessCall(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return DailyRechargeRankingNet
