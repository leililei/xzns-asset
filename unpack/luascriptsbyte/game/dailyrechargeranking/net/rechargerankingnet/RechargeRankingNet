local base = require("BaseGameNet")
---@class RechargeRankingNet : BaseGameNet 通信协议
local RechargeRankingNet = _G.BaseClass("RechargeRankingNet", base)

---@return RechargeRankingNet RechargeRankingNet
function RechargeRankingNet:GetInstance()
    return base.GetInstance(self)
end

---前100名上榜排行榜数据
---@param callback function 回调方法
function RechargeRankingNet:AccessAfk(callback)
    local item = _G.ConfigManager.net_map.game_rank_store_day_rank
    local pbData = { page = 1 }
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---获取个人排名
function RechargeRankingNet:GetPlayerRank( callback)
    local item = _G.ConfigManager.net_map.game_store_day_rank_info
    local pbData = self:GetEmptyPB()
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---发送玩家匿名情况
function RechargeRankingNet:SetPlayerAnonymous( type,callback)
    local item = _G.ConfigManager.net_map.game_store_day_rank_anonymous
       local pbData = {
        type = type,
 
    }
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function RechargeRankingNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return RechargeRankingNet
