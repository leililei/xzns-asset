---当前人物排名信息显示1 - 获取信息
function DailyRechargeRankingView:RefreshPlayerData()
    local tb = self.go_table

    local insId = tb.obj_Item:GetInstanceIDE()
    if self.TaskRewardInfo[insId] == nil then
        self.TaskRewardInfo[insId] = {}
    end

    --获取玩家排行的名次
    self.typeClass:GetPlayerRank(
        function(list)
            --玩家充值金额
            self.nowMoney = self.typeClass:GetPlayerCash_num()
            self.nowMoney = math.floor(self.nowMoney / 100)
            --获取玩家排名
            self.RealSelfRank = self:GetPlayerRankFromList()
            --当前人物名字和排名
            self:DisplaySelfNameAndRank(tb, self.RealSelfRank, insId, self.nowMoney)
            --匿名按钮显示
            self.AnonymityToggle = self.typeClass:GetPlayerAnonymous() or 0
            self.go_table.toggle_Anonymity.isOn = self.AnonymityToggle == 1
        end
    )
end

---当前人物排名信息显示2 - 名字和排名和充值金额
function DailyRechargeRankingView:DisplaySelfNameAndRank(tb, x, insId, nowMoney)
    local state = x ~= nil and x ~= 0
    tb.obj_inList:SetActiveE((state) and 1 or 0)
    tb.aortext_outList:SetActiveE((not state) and 1 or 0)
    tb.aorimage_paiming:SetActiveE(0)
    tb.aortext_PaiMing:SetActiveE(0)
    local vouId = _G.GameUtil.GetVoucherArg(90011770006, 90036300033)
    --排名显示
    if x == nil then
        tb.aortext_PaiMing:SetActiveE(1)
        tb.aortext_PaiMing.text = _G.LangUtil.GetLangPackValue(90022900040)
        tb.aortext_outList.text = _G.GetLangPackValue(vouId, _G.GameUtil.GetPriceContentByNum(nowMoney, true))
        if not _G.GameUtil.IsNotPlatformSpecial() then
            tb.aortext_outList.text = _G.GetLangPackValue(90011770010, _G.GameUtil.PlatformPrice(nowMoney, true))

            if _G.AppSetting.IsAlipayIos then
                tb.aortext_outList.text = _G.GetLangPackValue(90011770013, _G.GameUtil.PlatformPrice(nowMoney, true))
            end
        end
    elseif x == 0 or x > 1000 then
        tb.aortext_PaiMing:SetActiveE(1)
        tb.aortext_RankNum:SetActiveE(0)
        tb.aortext_PaiMing.text = _G.LangUtil.GetLangPackValue(90022900040)
        tb.aortext_outList.text = _G.GetLangPackValue(vouId, _G.GameUtil.GetPriceContentByNum(nowMoney, true))
        if not _G.GameUtil.IsNotPlatformSpecial() then
            tb.aortext_outList.text = _G.GetLangPackValue(90011770010, _G.GameUtil.PlatformPrice(nowMoney, true))
         if _G.AppSetting.IsAlipayIos then
                tb.aortext_outList.text = _G.GetLangPackValue(90011770013, _G.GameUtil.PlatformPrice(nowMoney, true))
            end
        end
    elseif x <= 3 then
        tb.aorimage_paiming:SetActiveE(1)
        tb.aorimage_paiming.SpriteName = IconName[x]
        tb.aortext_RankNum:SetActiveE(1)
        tb.aortext_RankNum.text = x
        self:SetGradient(tb.aortext_RankNum, x)
    else
        tb.aortext_PaiMing:SetActiveE(1)
        tb.aortext_PaiMing.text = x
    end
    if state then
        tb.aortext_inList.text = _G.GetLangPackValue(vouId, _G.GameUtil.GetPriceContentByNum(nowMoney, true))
    end
    tb.aortext_inList:SetActiveE(1)
    self:DisplaySelfAwards(x, tb, insId)
end

---当前人物排名信息显示3 - 奖励
function DailyRechargeRankingView:DisplaySelfAwards(x, tb, insId)
    local itemWuPing = self:IntervalAwards(x)

    for i = 1, 3 do
        local key = i
        local value
        if itemWuPing ~= nil then
            value = itemWuPing[i]
        else
            value = nil
        end
        if value ~= nil then
            tb["obj_Item" .. i]:SetActiveE(1)
            value = value.type
            self:CareatItem(value, false, tb["obj_Item" .. i], insId, key)
        else
            tb["obj_Item" .. i]:SetActiveE(0)
        end
    end
end

---生成奖励排行榜单的Item
function DailyRechargeRankingView:RefreshAwardsList(index, listView2)
    if index < 0 then
        return
    end

    local item = listView2
    local x = index + 1
    item:SetName(x)
    local tb = _G.GetAutoGoTable(item)
    local data = self.listAwards[x]

    if data == nil then
        tb.gameObject:SetActiveE(0)
    else
        tb.gameObject:SetActiveE(1)

        local insId = listView2:GetInstanceIDE()
        if self.TaskRewardInfo[insId] == nil then
            self.TaskRewardInfo[insId] = {}
        end
        --奖励item
        local itemWuPing = data.reward_daily
        for _, value in pairs(self.TaskRewardInfo[insId]) do
            value.gameObject:SetActiveE(0)
        end
        for i = 1, 3 do
            local key = i
            local value
            if itemWuPing ~= nil then
                value = itemWuPing[i]
            else
                value = nil
            end
            if value ~= nil then
                tb["obj_Item" .. i]:SetActiveE(1)
                value = value.type
                self:CareatItem(value, false, tb["obj_Item" .. i], insId, key)
            else
                tb["obj_Item" .. i]:SetActiveE(0)
            end
        end

        tb.aortext_PaiMing:SetActiveE(0)
        tb.aorimage_paiming:SetActiveE(0)

        local dataNew = self.listAwards[x + 1]
        local Is = ""
        local isFour = false
        if dataNew == nil then
            tb.aortext_PaiMing:SetActiveE(1)
            tb.aortext_RankNum:SetActiveE(0)
            tb.aortext_four:SetActiveE(0)
            Is = data.min_rank .. "+"
        elseif data.min_rank > 3 then
            tb.aortext_PaiMing:SetActiveE(0)
            tb.aortext_RankNum:SetActiveE(0)
            tb.aortext_four:SetActiveE(1)
            isFour = true
            Is = data.min_rank .. "-" .. data.max_rank
        else
            self:SetGradient(tb.aortext_RankNum, x)
            tb.aorimage_paiming:SetActiveE(1)
            tb.aorimage_paiming.SpriteName = IconName[x]
            tb.aortext_RankNum:SetActiveE(1)
            tb.aortext_RankNum.text = x
            tb.aortext_four:SetActiveE(0)
            Is = data.min_rank
        end
        if not isFour then
            tb.aortext_PaiMing.text = Is
        else
            tb.aortext_four.text = Is
        end
        if data.min_rank <= 3 then
            tb.aorimage_paiming:SetActiveE(1)
            tb.aortext_RankNum:SetActiveE(1)
            tb.aorimage_Bg_nor1:SetActiveE(1)
            tb.aorimage_Bg_nor2:SetActiveE(0)
            tb.aorimage_Bg_nor1.SpriteName = "ui_diban" .. x
            --tb.aorimage_Bg_nor1:SetRectTransformSize(702, 140)
            tb.aortext_RankNum.text = x
            self:SetGradient(tb.aortext_RankNum, x)
            tb.aorimage_paiming.SpriteName = IconName[x]
        else
            tb.aorimage_Bg_nor1:SetActiveE(0)
            tb.aorimage_Bg_nor2:SetActiveE(1)
            tb.aortext_RankNum:SetActiveE(0)
        end

        -- ZHJH-14815存疑标记
        -- local content, price, isVoucher = _G.GameUtil.SetPriceByChannel(data.value_rank)

        --LogError(data.value_rank, "原来的")
        ---理论上这里已经是最终值了，无须转换
        local finalPrice = require "MallManager":GetInstance():GetFinalPrice(data.value_rank)
        --LogError(finalPrice)

        --上榜金额条件
        local lanId = _G.GameUtil.GetVoucherArg(90011770008, 90036300003)
        tb.aortext_tips.text = _G.GetLangPackValue(lanId, finalPrice)

        if not _G.GameUtil.IsNotPlatformSpecial() then
            if _G.AppSetting.IsDouYinIos then
                tb.aortext_tips.text = _G.GetLangPackValue(90011770011, _G.GameUtil.PlatformPrice(finalPrice, true))
            elseif _G.AppSetting.IsAlipayIos then
                tb.aortext_tips.text = _G.GetLangPackValue(90011770012, _G.GameUtil.PlatformPrice(finalPrice, true))
            end
        end
    end
end

