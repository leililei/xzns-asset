function DailyRechargeRankingView:RefreshRankList(index, listView2)
    if index < 0 then
        return
    end
    local item = listView2
    local x = index + 1
    item:SetName(x)
    local tb = _G.GetAutoGoTable(item)
    local data, money, isAnonymity

    if self.list[x] then
        data = self.list[x].role_info
        money = math.floor(self.list[x].value[1] / 100)
        isAnonymity = self.list[x].value[2]
    end

    if data == nil then
        tb.obj_text:SetActiveE(0)
        tb.aortext_noName:SetActiveE(1)
        tb.obj_noHead:SetActiveE(1)
        tb.aorimage_hide:SetActiveE(0)
        local _, money = self:IntervalAwards(x)
        if money then
            local lanId = _G.GameUtil.GetVoucherArg(90011770008, 90036300003)
            tb.aortext_rmbTips.text = _G.GetLangPackValue(lanId, money)
            if not _G.GameUtil.IsNotPlatformSpecial() then
                if _G.AppSetting.IsDouYinIos then
                    tb.aortext_rmbTips.text = _G.GetLangPackValue(90011770011, _G.GameUtil.PlatformPrice(money, true))
                elseif _G.AppSetting.IsAlipayIos then
                    tb.aortext_rmbTips.text = _G.GetLangPackValue(90011770012, _G.GameUtil.PlatformPrice(money, true))
                end
            end
            tb.aortext_rmb.text = ""
        end
    else
        -- 判断是否是自己
        local isSelf = (data.uid == _G.PlayerModel:GetInstance():GetPlayerUid())

        -- 只有自己时，匿名状态取 self.AnonymityToggle，否则取 isAnonymity
        local isAno
        if isSelf then
            isAno = self.AnonymityToggle == 1
        else
            isAno = isAnonymity == 1
        end

        if isAno then
            -- 匿名玩家
            tb.obj_noHead:SetActiveE(1)
            tb.aorimage_hide:SetActiveE(1)
            tb.obj_head:SetActiveE(0)
            tb.aortext_name.text = _G.GetLangPackValue(90011770004)
        else
            -- 非匿名玩家
            tb.obj_noHead:SetActiveE(0)
            tb.obj_head:SetActiveE(1)
            tb.aortext_name.text = data.name

            -- 设置头像
            local Params_PlayerHeadItem = {
                frame = data.frame,
                lv = data.level,
                style = data.style,
                uid = data.uid,
                title = data.title
            }
            if isSelf then
                Params_PlayerHeadItem = {
                    frame = _G.PlayerModel:GetInstance():GetCurFrame(),
                    lv = _G.PlayerModel:GetInstance():GetLevel(),
                    style = _G.PlayerModel:GetInstance():GetRoleStyle(),
                    uid = _G.PlayerModel:GetInstance():GetPlayerUid(),
                    title = _G.PlayerModel:GetInstance().title
                }
            end

            UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, Params_PlayerHeadItem, 1, true, true, true)
        end
        --名字颜色
        tb.aortext_name.color = require("CardInfoManager").GetColorFromRGB(isAno and "076B2F" or "331E15")

        tb.aortext_rmb.text = money
        if not _G.GameUtil.IsNotPlatformSpecial() then
            tb.aortext_rmb.text = _G.GameUtil.PlatformPrice(money, true)
        end
        tb.aortext_rmbTips.text = ""
        tb.obj_text:SetActiveE(1)
        tb.aortext_noName:SetActiveE(0)

        --[[        if data.uid == self.PlayerUid then
            data.K = x
            self.PlayerUidList = data
        end]]
    end

    self.indexJiLu = index

    tb.aortext_PaiMing:SetActiveE(0)
    tb.aorimage_paiming:SetActiveE(0)
    if x <= 3 then
        tb.aorimage_paiming:SetActiveE(1)
        tb.aortext_RankNum:SetActiveE(1)
        tb.aorimage_Bg_nor1:SetActiveE(1)
        tb.aorimage_Bg_nor2:SetActiveE(0)
        tb.aorimage_Bg_nor1.SpriteName = "ui_diban" .. x
        tb.aortext_RankNum.text = x
        self:SetGradient(tb.aortext_RankNum, x)
        tb.aorimage_paiming.SpriteName = IconName[x]
    else
        tb.aorimage_Bg_nor1:SetActiveE(0)
        tb.aorimage_Bg_nor2:SetActiveE(1)
        tb.aortext_RankNum:SetActiveE(0)
        tb.aortext_PaiMing:SetActiveE(1)
        tb.aortext_PaiMing.text = x
    end
    return tb
end

