function DailyRechargeRankingView:DisplaySelfNameAndRankinPopupView()
    local tb = _G.GetAutoGoTable(self.go_table.obj_SelfInfoInPopup)
    local x = self.RealSelfRank --self.PlayerUidList.K
    local nowMoney = self.nowMoney

    --名字
    tb.aortext_name.text = _G.PlayerModel:GetInstance():GetName()
    tb.aortext_hideName:SetActiveE(self.AnonymityToggle)

    tb.aortext_PaiMing:SetActiveE(1)
    --排名显示
    if x == nil or x == 0 or x > 1000 then
        tb.aortext_PaiMing.text = _G.LangUtil.GetLangPackValue(90022900040)
    else
        tb.aortext_PaiMing.text = x
    end

    tb.aortext_rmb.text = nowMoney or 0
    if not _G.GameUtil.IsNotPlatformSpecial() and nowMoney then
        tb.aortext_rmb.text = _G.GameUtil.PlatformPrice(nowMoney, true)
    end
    --头像
    ---@type Params_PlayerHeadItem
    local Params_PlayerHeadItem = {}
    Params_PlayerHeadItem.frame = _G.PlayerModel:GetInstance():GetCurFrame()
    Params_PlayerHeadItem.lv = _G.PlayerModel:GetInstance():GetLevel()
    Params_PlayerHeadItem.style = _G.PlayerModel:GetInstance():GetRoleStyle()
    Params_PlayerHeadItem.uid = _G.PlayerModel:GetInstance():GetPlayerUid()
    Params_PlayerHeadItem.title = _G.PlayerModel:GetInstance().title
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, Params_PlayerHeadItem, 1, true, true, true)
end

