---判断名次区间该显示什么奖励item
function DailyRechargeRankingView:IntervalAwards(num)
    local awards_cfg = self.typeClass:GetGiftsList()

    for _, value in pairs(awards_cfg) do
        if value.min_rank <= num and value.max_rank >= num then
            return value.reward_daily, value.value_rank
        end
    end

    return nil, nil
end

function DailyRechargeRankingView:CareatItem(data, isGou, Parent, insId, key)
    if self.TaskRewardInfo[insId] ~= nil and self.TaskRewardInfo[insId][key] ~= nil then
        self.TaskRewardInfo[insId][key].gameObject:SetActiveE(1)
        self.TaskRewardInfo[insId][key]:ShowWithID(data)
    else
        Parent:ClearChildren()
        self.TaskRewardInfo[insId][key] = require "BaseAwardNewItem".New(Parent, nil, nil, Parent)
        self.TaskRewardInfo[insId][key].gameObject:SetName(key)
        self.TaskRewardInfo[insId][key]:ShowWithID(data)
    end
end

---排名按照金额区间重新排序
function DailyRechargeRankingView:SortPlayerRanking(call)
    local sortedList = {}  -- 存放最终排序后的玩家
    local usedPlayers = {} -- 记录已分配的玩家

    -- 遍历限制表格 self.listAwards，确保每个排名区间的限制生效
    for _, award in ipairs(self.listAwards) do
        local minRank = award.min_rank
        local maxRank = award.max_rank
        local valueRank = award.value_rank
        local tempPlayers = {}

        -- 在 self.list 中挑选符合当前区间限制的玩家
        for i = 1, #self.list do
            local player = self.list[i]
            if math.floor(player.value[1] / 100) >= valueRank and not usedPlayers[player] then
                table.insert(tempPlayers, player)
            end
        end

        -- 确保当前区间内排名从 minRank ~ maxRank
        local currentRank = minRank
        for i = 1, #tempPlayers do
            if currentRank > maxRank then
                break -- 超出区间
            end
            sortedList[currentRank] = tempPlayers[i]
            usedPlayers[tempPlayers[i]] = true -- 标记该玩家已被分配
            currentRank = currentRank + 1
        end
    end

    -- 更新排行榜
    self.list = sortedList

    if call then
        call()
    end
end

---寻找玩家的排名（玩家信息的那个是顺序排名用不了）
function DailyRechargeRankingView:GetPlayerRankFromList()
    local playerUid = _G.PlayerModel:GetInstance():GetPlayerUid()
    for rank, v in pairs(self.list) do
        if v.role_info.uid == playerUid then
            return rank
        end
    end
    return 0 -- 不在榜上
end

---设置排名前三变色字体
function DailyRechargeRankingView:SetGradient(obj, index)
    local gradient = obj:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient))
    local c1 = _G.ColorTools.FormatColorByString(Gradient[index][1])
    local c2 = _G.ColorTools.FormatColorByString(Gradient[index][2])
    local color1 = _G.CS.UnityEngine.GradientColorKey()
    local color2 = _G.CS.UnityEngine.GradientColorKey()
    color1.color = c1
    color1.time = 1
    color2.color = c2
    color2.time = 0

    local alpha1 = _G.CS.UnityEngine.GradientAlphaKey()
    local alpha2 = _G.CS.UnityEngine.GradientAlphaKey()

    alpha1.alpha = 255
    alpha1.time = 1
    alpha2.alpha = 255
    alpha2.time = 0

    gradient:GetGradient():SetKeys({ color1, color2 }, { alpha1, alpha2 })
end

---按钮点击事件派发
function DailyRechargeRankingView:OnClickBtn(go, isOn)
    if go == nil then
        return
    end
    local name = go:GetName()
    if name == "@_aorbtn_previewAward" then
        --打开排行榜
        self.go_table.obj_PaiHangBang:SetActiveE(1)

        if self.PhBDi == nil then
            self.go_table.scrollloopvectical_listPHB:InitItemData(0, _G.handler(self, self.RefreshRankList))
            self.PhBDi = false
        end

        --排行榜列表
        self:PowerNew()
    elseif (name == "@_aorbtn_PhBClose" or name == "@_aorbtn_PhBBack") and isOn then
        --关闭排行榜
        self.go_table.obj_PaiHangBang:SetActiveE(0)
    elseif name == "@_toggle_Anonymity" then
        --勾选和取消勾选匿名
        local Ano = self.AnonymityToggle == 1 and true or false
        if Ano ~= isOn then
            self.typeClass:SaveAnonymousCondition(
                function()
                    self.AnonymityToggle = self.typeClass:GetPlayerAnonymous() or 0
                    if self.HaveMyself then
                        --如果模型里有自己就刷新模型
                        self:DisplayTheTopThreeModels()
                    end
                end
            )
        end
    elseif name == "@_aorbtn_Back" and isOn then
        self:CloseView()
    elseif go == self.go_table.aorbtn_way then
        --打开页面说明
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 148)
    end
end

function DailyRechargeRankingView:CloseView()
    self:Close()
end

return DailyRechargeRankingView
