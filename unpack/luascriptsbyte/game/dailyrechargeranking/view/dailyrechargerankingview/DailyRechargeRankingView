---获取排行榜->排行榜前三模型展示
function DailyRechargeRankingView:GetRankList()
    self.typeClass:AccessAfkList(
        function(list)
            self.list = list and list.ranks or {}
            --排名排序->模型展示
            self:SortPlayerRanking(
                function()
                    --排行榜模型生成
                    self:DisplayTheTopThreeModels()
                    --显示个人排行情况
                    self:RefreshPlayerData()
                end
            )
        end
    )
end

---排行榜前三模型展示
function DailyRechargeRankingView:DisplayTheTopThreeModels()
    local data, isAnonymity
    local index
    for i = 1, 3 do
        data = (self.list and self.list[i]) and self.list[i].role_info or nil
        isAnonymity = (self.list and self.list[i]) and self.list[i].value[2] or 0
        if data then
            data.isAnonymity = isAnonymity
        end
        index = i
        local tb = _G.GetAutoGoTable(self.go_table["trans_rank" .. index], _G.handlerbind(self, self.BtnLookInfo, data))
        _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.DailyRechargeRankingViewItem .. i, tb)

        if data == nil then
            --虚位以待
            tb.aortext_name.text = _G.GetLangPackValue(90000010159)
            tb.trans_role:ClearChildren()
            tb.aorrawimage_norole:SetActiveE(1)
            tb.aorrawimage_shenmiren:SetActiveE(0)
        else
            local isSelf = (data.uid == _G.PlayerModel:GetInstance():GetPlayerUid())

            -- 只有自己时，匿名状态取 self.AnonymityToggle，否则取 isAnonymity
            local isAno
            if isSelf then
                isAno = (self.AnonymityToggle or self.typeClass:GetPlayerAnonymous()) == 1
                -- 标记模型里是否有自己
                self.HaveMyself = true
            else
                isAno = isAnonymity == 1
            end

            if isAno then
                -- 匿名玩家
                tb.trans_role:ClearChildren()
                tb.aorrawimage_norole:SetActiveE(0)
                tb.aorrawimage_shenmiren:SetActiveE(1)
                tb.aortext_name.text = _G.GetLangPackValue(90011770004)
                tb.obj_title:SetActiveE(0)
            else
                -- 非匿名玩家
                self:SetModel(tb, data, i)
            end
        end
    end
end

---生成模型
function DailyRechargeRankingView:SetModel(tb, data, index)
    --不匿名
    tb.aorrawimage_norole:SetActiveE(0)
    tb.aorrawimage_shenmiren:SetActiveE(0)
    tb.obj_title:SetActiveE(1)
    tb.aortext_name.text = data.name
    local playerUid = data.uid
    local role
    require("SystemSettingNet"):GetInstance():GetPlayerInfo(
        { uid = playerUid },
        function(msg)
            if not msg.info then
                return
            end
            local cfg = require "CardCommentManager":GetInstance():CardData(msg.info.city_style_id, false)
            local scale = cfg.size2
            local pos = cfg.pos_portrait
            tb.trans_role:ClearChildren()
            local path = _G.UIUtils.GetBattleSpine(cfg, _G.UseBattleSpine.RankView)
            if _G.UIUtils.IsUseBattleSpine(_G.UseBattleSpine.RankView) then
                scale = cfg.size4
                pos = { 0, 0, 0 }
            end
            _G.PoolsManager:GetInstance():Spawn(
                path,
                _G.ePoolType.Temporary,
                nil,
                function(trans)
                    if trans == nil then
                        if _G.AppSetting.DEBUG then
                            _G.LogError("角色无法加载 path:" .. cfg.ModelPathHi .. "    CardInfoView LoadRoleScene")
                        end
                        return
                    end
                    if self:IsNil() then
                        _G.DestroyObject(trans)
                        return
                    end
                    trans:SetParentE(tb.trans_role)
                    trans:SetLocalPosition(pos[1], pos[2], pos[3])
                    trans:SetLocalScaleXYZ(scale)
                    local rolePoint = trans:GetComponentE(_G.typeof(_G.CS.RolePoint))
                    if rolePoint == nil then
                        rolePoint = trans:AddComponentE(_G.typeof(_G.CS.RolePoint))
                    end

                    --- 只有星座女神有神环
                    if _G.AppSetting.IsXzns then
                        local godHaloID = msg.info.god_halo
                        if godHaloID ~= 0 then
                            local effCfg = _G.ConfigManager.god_halo_cfg[godHaloID].ui_effect_cfg
                            --- 神环路径，父级路径(加载角色的下面)
                            _G.UIUtils.LoadGodHalo(effCfg, trans,godHaloID)
                        end
                        if not table.isEmptyOrNil(msg.info.artifact_skin) then
                            _G.UIUtils.LoadArtifacteffect(trans,nil,msg.info.artifact_skin[1],msg.info.artifact_skin[2])
                        end
                    end
                end
            )
            self:UpdateTop3Title(tb, msg.info.title, index)
            role = msg.info
        end
    )
end

---生成称号
---@param item table
function DailyRechargeRankingView:UpdateTop3Title(tb, data, index)
    if data.sid == 0 then
        return
    end
    if self.curShowEffTitle == nil then
        self.curShowEffTitle = {}
    end
    local titleScale = _G.ConfigManager.discrete_cfg[100111] and _G.ConfigManager.discrete_cfg[100111][1][1] or 1
    local player_title = _G.ConfigManager.player_title_effect_cfg[data.sid]
    if player_title.type_title == 1 then
        tb.aorrawimage_title:LoadImage(player_title.title)
        tb.aorrawimage_title:SetActiveE(1)
        tb.aorrawimage_title:SetLocalScaleXYZ(0.29 * titleScale)
        tb.obj_titleEffect:RemoveAllChildren()
        self.curShowEffTitle[index] = nil
    elseif player_title.type_title == 2 then
        if self.curShowEffTitle[index] == nil or (self.curShowEffTitle[index] ~= nil and self.curShowEffTitle[index] ~= player_title.title) then
            tb.obj_titleEffect:RemoveAllChildren()
            self.curShowEffTitle[index] = player_title.title
            _G.UIUtils.LoadEffectTitleOrFrame(
                player_title.title,
                tb.obj_titleEffect,
                function(trans)
                    if self.curShowEffTitle[index] ~= player_title.title then
                        trans:DestroyObject()
                        return
                    end
                    local parClip = trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                    parClip.NeedCheck = true
                    parClip.CheckCount = 10
                    parClip.CheckOne = 3
                    trans:SetLocalScaleXYZ(titleScale)
                end
            )
        end
        tb.aorrawimage_title:SetActiveE(0)
    end
end

---点击模型弹出他人信息
function DailyRechargeRankingView:BtnLookInfo(go, _, data)
    local GetRole_info = data
    if GetRole_info ~= nil and GetRole_info.isAnonymity ~= 1 then
        --不匿名显示他人信息
        if GetRole_info.type ~= 1 then
            if GetRole_info.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.PopWindowManager:GetInstance():ShowAllTips(620109)
            else
                _G.SystemSettingManager:GetInstance():OpenView(GetRole_info.uid)
            end
        else
            _G.SystemSettingManager:GetInstance():OpenRobotPlayInfo(GetRole_info.uid, nil, _G.RobotType.Arena)
        end
    end
end

