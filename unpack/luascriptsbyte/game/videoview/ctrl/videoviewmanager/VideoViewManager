---@class VideoViewManager : Singleton    中文描述
---@field GetInstance fun():VideoViewManager
local VideoViewManager = _G.BaseClass("VideoViewManager", _G.Singleton)

---创建对象时,入口构造函数
function VideoViewManager:__init()
end

---初始化VideoManager
---@param callback fun(ok:boolean) 加载回调
---@param isHorizontal boolean 是否转为横屏
---@return void
local function ready(callback, isHorizontal)
    if _G.CS.VideoManager.Instance:IsReady() then
        if callback then
            callback(true)
        end
        return
    end

    if _G.AppSetting.DEBUG then
        _G.Log("VideoManager开始初始化")
    end
    _G.CS.VideoManager.Instance:LoadPrefab(function()
        if not _G.CS.VideoManager.Instance:IsReady() then
            if _G.AppSetting.DEBUG then
                _G.LogError("VideoManager初始化失败")
            end
            if callback then
                callback(false)
            end
            return
        end
        if _G.AppSetting.DEBUG then
            _G.Log("VideoManager初始化成功, 开始播放视频")
        end
        if isHorizontal then
            local videoLayer = _G.FindObject("UIRoot/VideoLayer")
            local ctrl = videoLayer:GetChildE(0)
            local playGround = ctrl:FindE("DisplayUGUI")
            local rotation = _G.Quaternion.Euler(0, 0, -90)
            playGround:SetRectTransformSize(1280, 720)
            playGround:SetLocalRotation(rotation.x, rotation.y, rotation.z, rotation.w)
        end
        if callback then
            callback(true)
        end
    end)
end

---通过配置加载动画
function VideoViewManager:PlayVideoByCfg(cfg, startAction, endAction, isHorizontal)
    if not cfg then
        if startAction then
            startAction(true)
        end
        if endAction then
            endAction(true)
        end
        _G.Events:GetInstance():Broadcast(_G.VideoPlayState.PlayEnd)
        return
    end
    self:PlayVideo(cfg.VideoPath, startAction, endAction, isHorizontal, cfg)
end

---通过路径加载动画
function VideoViewManager:PlayVideo(path, startAction, endAction, isHorizontal, cfg)
    if not path then
        if startAction then
            startAction(true)
        end
        if endAction then
            endAction(true)
        end
        _G.Events:GetInstance():Broadcast(_G.VideoPlayState.PlayEnd)
        return
    end
    ready(
    function(ok)
            if not ok then
                if startAction then
                    startAction(true)
                end
                if endAction then
                    endAction(true)
                end
                return
            end
            if _G.AppSetting.DEBUG then
                _G.Log("VideoManager播放视频: " .. path)
            end
            self.endAction = endAction
            _G.CS.VideoManager.Instance:PlayRemote(
                path,
                function()
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.VideoSkipView.Name, cfg, isHorizontal)
                    if startAction then
                        startAction(true)
                    end
                end,
                function()
                    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.VideoSkipView.Name)
                    if endAction then
                        endAction(true)
                    end
                    self.endAction = nil
                end,
                cfg and cfg.isShowSkipBtn or false,
                cfg and cfg.IsLoop or false,
                true,
                true
            )
        end,
        isHorizontal
    )
end

---跳过动画
function VideoViewManager:Skip()
    _G.CS.VideoManager.Instance:Stop()
    _G.CS.VideoManager.Instance:Dispose()
    if self.endAction then
        _G.Events:GetInstance():Broadcast(_G.VideoPlayState.PlayEnd)
        self.endAction()
        self.endAction = nil
    end
end

---播放赛季动画
function VideoViewManager:PlaySeasonVideo(isFirst)
    local seasonCfg = require("SeasonModel"):GetInstance():GetCfg()
    local cfg = _G.ConfigManager.video_cfg[seasonCfg.Key]
    local isFirstOpen = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.SeasonFirstOpen .. seasonCfg.id, 1) == 1
    local isShowVideo = self:CheckSeasonVideo()
    if isFirst and isFirstOpen == false then
        return
    end
    if isShowVideo == true then
        self:PlayVideoByCfg(
            cfg,
            function()
                _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.SeasonFirstOpen .. seasonCfg.id, 0)
            end,
            nil, 
            true
        )
    end
end

---检查是否可以播放赛季视频
function VideoViewManager:CheckSeasonVideo()
    local haveCfg = false
    local seasonCfg = require("SeasonModel"):GetInstance():GetCfg()
    if seasonCfg.Key and seasonCfg.Key ~= "" then
        if _G.ConfigManager.video_cfg[seasonCfg.Key] then
            haveCfg = true
        end
    end
    return haveCfg and (_G.AppSetting.IsAndriod or _G.AppSetting.IsIos) and not _G.AppSetting.IsH5
end

---销毁对象时,析构函数
function VideoViewManager:Dispose()
end


return VideoViewManager
