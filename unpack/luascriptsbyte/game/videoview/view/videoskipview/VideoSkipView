---@class VideoSkipView : UIBaseView	观影台
---@field go_table VideoSkipView_GoTable
local VideoSkipView = _G.BaseClass("VideoSkipView", _G.UIBaseView)

local skipPosition = {
    [1] = { -2, -48, 1, 1, 1, 1, 0 },
    [2] = { -48, 2, 1, 0, 1, 0, -90 }
}

function VideoSkipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function VideoSkipView:OnCreate(cfg, isHorizontal)
    self.cfg = cfg or {}
    self:InitView(isHorizontal)
end

---初始化界面
function VideoSkipView:InitView(isHorizontal)
    local cfg = skipPosition[isHorizontal == true and 2 or 1]
    self.go_table.obj_Skip:SetRectTransformAnchor(cfg[3], cfg[4], cfg[5], cfg[6])
    local rotation = _G.Quaternion.Euler(0, 0, cfg[7])
    self.go_table.obj_Skip:SetLocalRotation(rotation.x, rotation.y, rotation.z, rotation.w)
    self.go_table.obj_Skip:SetAnchorPosition(cfg[1], cfg[2])
    self.isShowSkip = true
    self:ChangeSkipState()
end

function VideoSkipView:ChangeSkipState()
    self.isShowSkip = not self.isShowSkip
    if self.cfg.isShowSkipBtn == false then
        self.isShowSkip = false
    end
    self.go_table.obj_Skip:SetActiveE(self.isShowSkip == true and 1 or 0)
end

---按钮点击事件
function VideoSkipView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_SkipBtn" then
        require("VideoViewManager"):GetInstance():Skip()
        self:Close()
    elseif name == "@_aorbtn_Click" then
        self:ChangeSkipState()
    end
end

return VideoSkipView
