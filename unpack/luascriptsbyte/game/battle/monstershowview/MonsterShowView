---@class MonsterShowView : UIBaseView	中文描述
---@field public go_table MonsterShowView_GoTable GoTable
local MonsterShowView = _G.BaseClass("MonsterShowView", _G.UIBaseView)

function MonsterShowView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.obj_node:SetActiveE(0)
    self.ViewOne_gotable = _G.GetAutoGoTable(self.go_table.obj_one)
    self.ViewOne_gotable.gameObject:SetActiveE(0)
    self.ViewOne_gotable.aorrawimage_Role1.Alpha = 0

    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CreateStratBattleEff,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
end

---@field monsterGroupID number
---@field closeCall function 关闭触发回调
---@class params_MonsterShowView Data

---界面的入口函数
---@param  Data params_MonsterShowView
function MonsterShowView:OnCreate(Data)
    if Data == nil then
        self:CreateStratBattleEff()
        return
    end
    self.Data = Data
    self:SetData()
end

function MonsterShowView:OnDestroy()
    self:RemoveAllListener()
end

function MonsterShowView:SetData()
    ---@type monster_group_cfg
    self.monster_group_cfg_Item = _G.ConfigManager.monster_group_cfg[self.Data.monsterGroupID]
    if
        self.monster_group_cfg_Item == nil or self.monster_group_cfg_Item.BossCome == nil or
        self.monster_group_cfg_Item.BossCome[1] == nil
    then
        self:CreateStratBattleEff()
        return
    end
    -- _G.DelayDo(
    --     1.3,
    --     function()
    self:InitView()
    -- end
    -- )
end

function MonsterShowView:InitView()
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.MonsterShowView, self.ViewOne_gotable)
    local count = 0
    if self.monster_group_cfg_Item.BossCome[2] ~= nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(" pyb:不会配置两个boss")
        end
    end
    if self.monster_group_cfg_Item.BossCome[1] ~= nil then
        count = 1
        self.ViewOne_gotable.gameObject:SetActiveE(1)
        self:SetViewOne()
    else
        self:CreateStratBattleEff()
        return
    end
    self:SetCloseTime()
    self:PlayAnim()
    _G.AudioManager.PlayAudioByAudioCfgID(2022)

    self.go_table.obj_node:SetActiveE(1)
end

function MonsterShowView:PlayAnim()
    -- self.go_table.aortext_tips:DOFade(0, 1):SetLoops(-1, _G.CS.DG.Tweening.LoopType.Yoyo)
end

function MonsterShowView:SetCloseTime()
    self:DelCloseTime()
    local s = _G.ConfigManager.discrete_cfg[100218]
    if s ~= nil then
        s = s[1][1]
    end
    if s == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(" discrete_cfg[100218] 参数无效")
        end
        s = 5
    end

    self.go_table.aortext_tips.text = _G.LangUtil.GetLangPackValue(90021300087, s)
    self.RTS = s
    self.closeTimer = _G.TimerManager:GetInstance():GetTimer(1, self.CloseTImerFunc, self, false, false, false)
    self.closeTimer:Start()
end

function MonsterShowView:CloseTImerFunc(elapsed)
    if self.go_table == nil then
        return
    end
    self.RTS = self.RTS - (elapsed or 1)
    if self.RTS < 0 then
        self:CreateStratBattleEff()
        return
    end
    self.go_table.aortext_tips.text = _G.LangUtil.GetLangPackValue(90021300087, Mathf.RoundToInt(self.RTS))
end

function MonsterShowView:DelCloseTime()
    if self.closeTimer ~= nil then
        self.closeTimer:Stop()
        self.closeTimer = nil
    end
end

function MonsterShowView:SetViewOne()
    -- self.ViewOne_gotable self.monster_group_cfg_Item
    self.monsterID1 = self.monster_group_cfg_Item.BossCome[1]
    ---@type monster_cfg
    self.monsterCfgItem1 = _G.ConfigManager.monster_cfg[self.monsterID1]
    if self.monsterCfgItem1 == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("未找到该 怪物数据 monsterID: " .. tostring(self.monsterID1))
        end
        self:CreateStratBattleEff()
        return
    end
    local cardCfgItem = require "CardCommentManager":GetInstance():CardData(self.monsterCfgItem1.CardID)

    -- 113150000
    if cardCfgItem == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(
                string.format(
                    " 怪物表id:%s 配置的cardId:%s 在Card_cf未找到",
                    tostring(self.monsterID1),
                    tostring(self.monsterCfgItem1.CardID)
                )
            )
        end
        self:Close()
        return
    end
    local soundPath
    if _G.ConfigManager.card_show_cfg[self.monsterCfgItem1.CardID] == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(
                string.format(
                    "怪物表id:%s 配置的cardId:%s 在card_show_cfg未找到",
                    (self.monsterID1),
                    tostring(self.monsterCfgItem1.CardID)
                )
            )
        end
    else
        soundPath = _G.ConfigManager.card_show_cfg[self.monsterCfgItem1.CardID].sound_enter
    end
    if _G.string.IsNullOrEmpty(soundPath) == false then
        local path = soundPath
        if path ~= nil then
            ---当前是否在播放
            --self.LinesPath = path
            _G.AudioManager.PlayPathBackFun(path)
        end
    end
    if _G.AppSetting.IsXzns then
        _G.PoolsManager:GetInstance():Spawn(
                cardCfgItem.ModelPathHi,
                _G.ePoolType.Temporary,
                self.ViewOne_gotable.aorrawimage_Role1,
                function(role)
                    if not self.go_table then
                        _G.DestroyObject(role)
                        return
                    end
                    role:SetLocalScaleXYZ(cardCfgItem.size5)
                    local pos = cardCfgItem.pos_portrait6
                    role:SetLocalPosition(pos[1], pos[2], pos[3])
                    if _G.AppSetting.IsXzns then
                        local spineCfg = _G.ConfigManager.card_show_cfg[cardCfgItem.id] or _G.ConfigManager.skin_cfg[cardCfgItem.id]
                        local idle = spineCfg.display_idle[1]
                        _G.GameUtil.SetCardUiSpineAnimation(role, idle, true)
                        _G.GameUtil.SetUiHeXieMask(self.ViewOne_gotable)
                    end
                end
        )
    else
        self:LoadRawImage(
                self.ViewOne_gotable.aorrawimage_Role1,
                cardCfgItem.SkillPortrait,
                function(image)
                    local pos = cardCfgItem.pos_portrait6
                    if pos then
                        local x = pos[1] or 0
                        local y = pos[2] or 0
                        local z = pos[3] or 0
                        local angle = pos[4] or 0

                        --获取父节点pivot
                        -- local parent = image:GetParent()
                        -- local px, py = parent:GetPivotPosition()
                        -- local pw, ph = parent:GetRectTransformSizeDelta()
                        -- y = y + (0.5 - py) * ph

                        image:SetLocalPosition(x, y, z)
                        image:SetLocalEulerAngles(0, 0, angle)
                    end

                    local size = cardCfgItem.size5 or 1
                    if size then
                        image:SetLocalScale(-size, size, size)
                    end
                end
        )
    end
    self:SetSkill(self.ViewOne_gotable.obj_skill_1, self.monsterCfgItem1.MonsterSkills, 1)
    self:SetSkill(self.ViewOne_gotable.obj_skill_2, self.monsterCfgItem1.MonsterSkills, 2)
    self:SetSkill(self.ViewOne_gotable.obj_skill_3, self.monsterCfgItem1.MonsterSkills, 3)
    self:SetSkill(self.ViewOne_gotable.obj_skill_4, self.monsterCfgItem1.MonsterSkills, 4)

    self.ViewOne_gotable.aortext_name1.text = _G.LangUtil.GetLangPackValue(cardCfgItem.Name)
end

function MonsterShowView:SetRoleIamge(roleimage, nameText, monsterCfgItem, cardCfgItem, index)
    self:LoadRawImage(
        roleimage,
        cardCfgItem.Portrait,
        function(image)
            local pos = cardCfgItem.pos_portrait1
            if pos ~= nil then
                local x = pos[1]
                if index == 1 then
                    x = x - 300
                else
                    x = x + 263
                end
                image:SetLocalPosition(x, pos[2], pos[3])

                local rotY = pos[4] or 0
                image:SetLocalEulerAngles(0, rotY, 0)
            end

            local size = cardCfgItem.size3
            if size ~= nil then
                image:SetLocalScale(size, size, size)
            end
        end
    )

    nameText.text = _G.LangUtil.GetLangPackValue(cardCfgItem.Name)
    return monsterCfgItem.CardID
end

function MonsterShowView:SetSkill(item, MonsterSkills, index)
    local card_skills_cfg
    local skillId
    if MonsterSkills ~= nil then
        skillId = MonsterSkills[index]
        card_skills_cfg = _G.ConfigManager.card_skills_cfg[skillId]
    end
    if card_skills_cfg == nil then
        item:SetActiveE(0)
        return
    end
    item:SetActiveE(1)
    local go_table = _G.GetAutoGoTable(item)
    go_table.aorbtn_Skill.onClick:AddListener(
        function()
            require("CommonTipManager"):GetInstance():OpenSkillTip(skillId)
        end
    )
    self:LoadRawImage(go_table.aorrawimage_SkillIcon, card_skills_cfg.icon)
    self:LoadRawImage(go_table.aorrawimage_SkillType, card_skills_cfg.skill_type)
    _G.GameUtil.SetActiveByCondition(go_table.aorimage_nuqi, card_skills_cfg.skill_pos == 1)
end

---@param rCardId number  人id
---@param lCardId number  灵id
function MonsterShowView:SetCombSkill(item, skillId, rCardId, lCardId)
    local card_skills_cfg = _G.ConfigManager.card_skills_cfg[skillId]
    if card_skills_cfg == nil then
        item:SetActiveE(0)
        return
    end
    item:SetActiveE(1)
    local go_table = _G.GetAutoGoTable(item)
    go_table.aorbtn_Skill.onClick:AddListener(
        function()
            local rdata = {
                sid = self.cardCfgItem1.id,
                star = self.monsterCfgItem1.Stars,
                level = self.monsterCfgItem1.Level,
                uid = self.cardCfgItem1.id
            }
            local ldata = {
                sid = self.cardCfgItem2.id,
                star = self.monsterCfgItem2.Stars,
                level = self.monsterCfgItem2.Level,
                uid = self.cardCfgItem2.id
            }
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CombSkillTipsView.Name,
                rdata,
                ldata,
                nil,
                { 0, 0, 0 }
            )
        end
    )
    self:LoadRawImage(go_table.aorrawimage_SkillIcon, card_skills_cfg.icon)
    self:LoadRawImage(go_table.aorrawimage_SkillType, card_skills_cfg.skill_type)
end

function MonsterShowView:OnStartClose()
    self:DelCloseTime()

    if self.Data ~= nil then
        if self.Data.closeCall ~= nil then
            self.Data.closeCall()
            self.Data.closeCall = nil
        end
    end

    self.Data = nil
end

---RawImage加载icon
---@param rawimage AorRawImage
---@param carddata CardData
function MonsterShowView:LoadRawImage(rawimage, path, call)
    if rawimage == nil then
        return
    end
    rawimage.Alpha = 0
    if not string.IsNullOrEmpty(path) then
        rawimage:LoadImage(
            path,
            function(image)
                if image == nil then
                    return
                end
                rawimage.Alpha = 1
                image:SetActiveE(1)
                rawimage:SetNativeSize()
                if call ~= nil then
                    call(image)
                end
            end
        )
    end
end

---按钮点击事件在这里派发
function MonsterShowView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

function MonsterShowView:CreateStratBattleEff()
    self:DelCloseTime()
    --("CreateStratBattleEff")
    if self.Data and self.Data.index then
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnStratBattleEffViewOpened)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SociatyBattleStartView.Name)
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.SociatyBattleStartView.Name,
            self.Data.index,
            _G.handler(self, self.Close))
    else
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.BattleStartEffect,
            _G.UIManager:GetInstance():GetUILayerTrans("TopLayer"),
            function()
                --("Hide")
                self:Hide()
            end,
            function()
                --("Close")
                self:Close()
            end
        )
    end
end

function MonsterShowView:OnStratBattleEffViewOpened(name)
    if name ~= _G.ConfigManager.ui_cfg.SociatyBattleStartView.Name then
        return
    end
    self:RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnStratBattleEffViewOpened)
    self:Hide()
end

return MonsterShowView
