--- 退出关卡
function BattleControllerJointAfk:EndFight()
    _G.BattleManager:GetInstance():PauseBattle(true)
    self:OnFightResult(nil, _G.handlerbind(self, self.OnSettlement, _G.handler(self, self.StartSettlement)), true)
end

function BattleControllerJointAfk:OnReEmbattle()
    _G.BattleManager:GetInstance():DestroyBattle()
    require("JointAfkManager"):GetInstance():Fight()
end
function BattleControllerJointAfk:OnLoadRecordFight()
    _G.BattleManager:GetInstance():initAttackSids(nil, self.embattleType, true, 1)
end
---获取怪物组ID
---@return number 怪物组ID
function BattleControllerJointAfk:GetMonsterGroupID()
    return self.mgCfg.id
end

function BattleControllerJointAfk:CheckShowRecordBattle()
    return true
end

---销毁对象时,析构函数
function BattleControllerJointAfk:Dispose()
end

return BattleControllerJointAfk
