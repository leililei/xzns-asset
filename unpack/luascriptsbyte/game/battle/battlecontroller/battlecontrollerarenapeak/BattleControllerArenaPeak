end

---重开战斗
function BattleControllerArenaPeak:ReFight()
    _G.BattleManager:GetInstance():DestroyBattle()
    require "ArenaPeakModel":GetInstance():ReEnterFight()
end

--- 退出关卡
function BattleControllerArenaPeak:EndFight()
    -- _G.SettlementModel:GetInstance():Settlement(
    --     _G.SettlementModel.SettlementType.SeasonBoss,
    --     function()
    --         _G.BattleManager:GetInstance():DestroyBattle()
    --         require "SeasonBossModel":GetInstance():ReturnPanel()
    --     end,
    --     nil,
    --     false
    -- )
    _G.BattleManager:GetInstance():PauseBattle(true)
    self:OnFightResult(nil, _G.handlerbind(self, self.OnSettlement, _G.handler(self, self.StartSettlement)), true)
end

function BattleControllerArenaPeak:QuitToMainWorld(call)
    _G.BattleControllerBase.FightExit(self)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    if call then
        call()
    end
end

function BattleControllerArenaPeak:OnReEmbattle()
    _G.BattleManager:GetInstance():DestroyBattle()
    --require "ArenaPeakModel":GetInstance():ReEnterFight()
end

---加载战斗(协程加载)
function BattleControllerArenaPeak:OnLoadRecordFight(index, notInBattle)
    local recordType = notInBattle and 2 or 1
    _G.BattleManager:GetInstance():initAttackSids(nil, nil, true, recordType, 0)
    if notInBattle then
        while _G.BattleManager:GetInstance().Progress < 1 do
            _G.coroutine.waitforendofframe()
        end
    end
    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, 1009)
end
----检测数据统计是否显示回放战斗
function BattleControllerArenaPeak:CheckShowRecordBattle()
    return true
end

return BattleControllerArenaPeak
