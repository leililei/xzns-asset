local ArenaPeakModel = require("ArenaPeakModel")
local base = require "BattleControllerBase"
---@class BattleControllerArenaPeak	中文描述
local BattleControllerArenaPeak = _G.BaseClass("BattleControllerArenaPeak", base)

---类的构造函数
function BattleControllerArenaPeak:__init()
end

---类的析构函数
function BattleControllerArenaPeak:Dispose()
end

function BattleControllerArenaPeak:CheckFight(call)
    self.checkCall = call
    local port = require("ArenaPeakNet"):GetInstance():Fight(_G.handler(self, self.OnFightMsgCall))
    _G.BattleManager:GetInstance():AddLuaNetEvent(port)
end

---@param msg arena_peak.s2c_arena_peak_fight
function BattleControllerArenaPeak:OnFightMsgCall(msg)
    self.result = msg
    if msg.ack == 1 then
        ArenaPeakModel:GetInstance():FightHandler(msg)
        self.mgCfg = _G.ConfigManager.monster_group_cfg[msg.fight_arg.sid]
        self.checkCall(true)
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("巅峰演武战斗异常, ack=" .. msg.ack)
        end
        self.checkCall(false, msg.ack)
    end
    self.checkCall = nil
end

---加载战斗(协程加载)
function BattleControllerArenaPeak:OnLoadFight()
    local uiManager = _G.UIManager:GetInstance()
    local view = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.LoadingView.Name).View
    while (_G.IsNil(view.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    --uiManager:CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    -- local showStartView = true
    -- _G.UIUtils.ProloadMaskVideo(
    --     "OpenDoor01",
    --     "OpenDoor01_mask",
    --     "Images/Bg/battlestartbg",
    --     function()
    --         showStartView = false
    --     end
    -- )
    -- while showStartView do
    --     _G.coroutine.waitforendofframe()
    -- end

    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    battleView.View:SetSettingBtnActive(false)
    _G.BaseBattleManager:GetInstance():ClearView(false)
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(false)
    local battleManager = _G.BattleManager:GetInstance()
    local fighterSids
    fighterSids = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.ArenaPeak)
    battleManager:initAttackSids(fighterSids, _G.EBattleType.ArenaPeak, true, 0, 0)
    --battleManager:SetExSpeedIndex(0, true)
    --battleManager:SetSpeed(0)
    local cfg = _G.ConfigManager.discrete_cfg[108129]
    if cfg then
        battleManager:SetExSpeedIndex(cfg[1][1] >= 4 and 1 or 0, true)
        _G.BattleManager:GetInstance():SetSpeedByValue(cfg[1][1])
    else
        battleManager:SetExSpeedIndex(0, true)
    end
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    while (not _G.IsNil(view.gameObject)) do
        _G.coroutine.waitforendofframe()
    end

    battleView.View:SetCanvasGroupTrue()
end

---战斗开始
function BattleControllerArenaPeak:OnStart()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    --_G.BattleManager:GetInstance():SetPauseBtnState(0, 1, 1)
    -- self.super.OnStart(self)
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()
    _G.BattleManager:GetInstance():ShowBattleTeam()
    _G.BattleManager:GetInstance():ShowSpeedBattleBtn(false)
end

---战斗结束
---@param tab table 战斗数据
function BattleControllerArenaPeak:OnFightResult(tab, call, isNotWin)
    self.FightResult = tab
    self.isNotWin = isNotWin
    call()
    -- self:Settlement(tab)
end
---结算
function BattleControllerArenaPeak:OnSettlement(call)
    call(_G.SettlementModel.SettlementType.ArenaPeak, self.FightResult, self.isNotWin, self.result)
end

