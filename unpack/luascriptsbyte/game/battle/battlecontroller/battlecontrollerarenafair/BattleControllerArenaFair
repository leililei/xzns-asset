local ArenaNet = require "ArenaNet"
local base = require "BattleControllerBase"
---@class BattleControllerArenaFair	中文描述
local BattleControllerArenaFair = _G.BaseClass("BattleControllerArenaFair", base)

---类的构造函数
function BattleControllerArenaFair:__init()
end

---类的析构函数
function BattleControllerArenaFair:Dispose()
    self.enemy = nil
    self.resultMsg = nil
end

--region 子类重写
---处理参数
---@param msg number 战斗结果数据
---@param enemy table 地方数据
function BattleControllerArenaFair:OnHandleParams(msg, enemy)
    self.enemy = enemy
    self.resultMsg = msg
end
-----检测是否可以进入战斗
function BattleControllerArenaFair:CheckFight(callback)
    callback(true)
end
---加载战斗
function BattleControllerArenaFair:LoadFight()
    local world = _G.ePoolType.World
    _G.BattleManager:GetInstance():SetPoolName(world, world, world, world, world)
    --延时一帧的目的是为了保证布阵场景和战斗角色都放入传递到战斗的节点下
    _G.coroutine.waitforendofframe()
    self:OnLoadFight()
    self:StartFightNew()
end
---加载战斗(协程加载)
function BattleControllerArenaFair:OnLoadFight()
    local uiManager = _G.UIManager:GetInstance()
    uiManager:CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    local ui_cfg = _G.ConfigManager.ui_cfg
    local onStartViewCloseTag = true
    local view =
        _G.UIManager:GetInstance():OpenWindow(
        ui_cfg.ArenaFairBattleStartView.Name,
        function()
            onStartViewCloseTag = nil
            self.isMonsherShow = false
            _G.GlobalInterface.OpenMonsterShow(_G.handler(self, self.StartFightNew), self:GetMonsterGroupID())
        end,
        self.enemy
    )
    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(view.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    local battleView = uiManager:OpenWindow(ui_cfg.BattleView.Name)
    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    battleView.View:SetSettingBtnActive(false)
    uiManager:HideWindow(ui_cfg.BattleView.Name)
    while onStartViewCloseTag do
        _G.coroutine.waitforendofframe()
    end
    local battleManager = _G.BattleManager:GetInstance()
    battleManager:initAttackSids(nil, _G.EBattleType.OneTeamArena, true)
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    -- _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, self.mgCfg.audio)
    battleView.View:SetCanvasGroupTrue()
end
---战斗开始
function BattleControllerArenaFair:OnStart()
    local uiManager = _G.UIManager:GetInstance()
    uiManager:ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    local view = uiManager:GetWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    if view then
        view.View:SetAutoBtnActive(false)
        view.View.AtActive = false
    end
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()
    _G.BattleManager:GetInstance():ShowBattleTeam()
end
---结算
---@param callback function 结算回调(参数 结算脚本名,其他动态参数
function BattleControllerArenaFair:OnSettlement(callback)
    local ArenaManager = require "ArenaManager"
    local arenaClass = ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.fair)
    arenaClass:ClearReport()
    if not self.resultMsg.score then --切磋
        self.resultMsg.score = arenaClass:GetScore()
        self.resultMsg.tar_score = self.enemy.score
        callback(_G.SettlementModel.SettlementType.arenaFair, self.resultMsg, self.enemy)
    else
        arenaClass:InitInfo(
            function()
                callback(_G.SettlementModel.SettlementType.arenaFair, self.resultMsg, self.enemy)
            end,
            true
        )
    end
end
---结算退出
---@param win boolean 是否胜利
function BattleControllerArenaFair:OnSettlementEnd(win)
    if win == nil then --异常
        _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    else
        --TODO:如果是从切磋邀请界面进来的，看是否需要打开邀请界面
        --TODO:返回公平竞技场界面
        local UIManagerIns = _G.UIManager:GetInstance()
        local ui_cfg = _G.ConfigManager.ui_cfg
        UIManagerIns:OpenWindow(ui_cfg.ArenaFairMainView.Name)
    end
end
--endregion

---加载战斗(协程加载)
function BattleControllerArenaFair:OnLoadRecordFight(index, notInBattle)
    local recordType = notInBattle and 2 or 1
    _G.BattleManager:GetInstance():initAttackSids(nil, _G.EBattleType.OneTeamArena, true, recordType, 0)
    if notInBattle then
        while _G.BattleManager:GetInstance().Progress < 1 do
            _G.coroutine.waitforendofframe()
        end
    end
    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, 1009)
end
----检测数据统计是否显示回放战斗
function BattleControllerArenaFair:CheckShowRecordBattle()
    return true
end

function BattleControllerArenaFair:EndFight()
    self:OnSettlementEnd(false)
end

return BattleControllerArenaFair
