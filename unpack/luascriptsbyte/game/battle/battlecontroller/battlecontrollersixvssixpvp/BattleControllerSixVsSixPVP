---@class BattleControllerSixVsSixPVP	中文描述
local base = require "BattleControllerBase"
local BattleControllerSixVsSixPVP = _G.BaseClass("BattleControllerSixVsSixPVP", base)

---类的构造函数
function BattleControllerSixVsSixPVP:__init()
end

---类的析构函数
function BattleControllerSixVsSixPVP:Dispose()
end

---处理传参
---@param towerId number 爬塔id
---@param atkUid table 布阵数据(传入 则替换掉当前 不传则采用当前数据)
function BattleControllerSixVsSixPVP:OnHandleParams()
end
-----检测是否可以进入战斗
function BattleControllerSixVsSixPVP:CheckFight(call)
    self.checkCall = call
    local port = require("SixVsSixPVPModel"):GetInstance():Fight(_G.handler(self, self.OnFightMsgCall))
    _G.BattleManager:GetInstance():AddLuaNetEvent(port)
end

function BattleControllerSixVsSixPVP:OnFightMsgCall(msg)
    if msg.ack == 1 then
        self.mgCfg = _G.ConfigManager.monster_group_cfg[msg.fight_arg.sid]

        --_G.CS.BattleManager.Inst:StrReceiveMsg(msg.fight_arg)
        self.checkCall(true)
    else
        self.checkCall(false, msg.ack)
    end
    self.checkCall = nil
end

---加载战斗(协程加载)
function BattleControllerSixVsSixPVP:OnLoadFight()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    self.Loaded = false
    self.ShowEnd = false
    self.State = nil
    local uiManager = _G.UIManager:GetInstance()
    --uiManager:CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)
    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)

    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    battleView.View:SetSettingBtnActive(false)
    _G.BaseBattleManager:GetInstance():ClearView(false)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    -- 获取布阵信息
    local battleManager = _G.BattleManager:GetInstance()

    battleManager:initAttackSids(
        require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.SixVsSixPVPAttack),
        _G.EmbattleType.SixVsSixPVPAttack,
        true,
        0,
        0
    )
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    _G.coroutine.waitforendofframe()

    battleView.View:SetCanvasGroupTrue()

    --灵弈对决-隐藏宠物技节点(需等待SkillView加载)
    _G.BattleManager:GetInstance():SetPetSkillActive(false)
end

---战斗开始
function BattleControllerSixVsSixPVP:OnStart()
    -- self.super.OnStart(self)
    local uiManager = _G.UIManager:GetInstance()
    uiManager:ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()
    _G.BattleManager:GetInstance():ShowBattleTeam()
end

---战斗结束
---@param tab table 战斗数据
function BattleControllerSixVsSixPVP:OnFightResult(tab, call, isNotWin)
    self.FightResult = tab
    self.isNotWin = isNotWin
    -- self:Settlement(tab)
    -- _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    call()
end

---结算
---@param msg table 结算数据
function BattleControllerSixVsSixPVP:OnSettlement(call)
    call(_G.SettlementModel.SettlementType.SixVsSix, self.FightResult, self.isNotWin)
end

---战斗退出
function BattleControllerSixVsSixPVP:OnSettlementEnd()
    _G.BaseBattleManager:GetInstance():ClearView(true)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
    _G.WorldManager:GetInstance():DespawnRoleParent()
    self.curSettlementMsg = nil
end

---手动停止战斗
function BattleControllerSixVsSixPVP:EndFight()
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.CS.UnityEngine.Time.timeScale = 1
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    _G.WorldManager:GetInstance():DespawnRoleParent()
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
        function()
            _G.BaseBattleManager:GetInstance():ClearView(true)
            self:FightExit()
            self:OnSettlementEnd()
            require "SixVsSixPVPModel":GetInstance():ExitEmbattle()
        end
    )
    -- _G.BattleManager:GetInstance():PauseBattle(true)
    -- self:OnFightResult(nil, _G.handlerbind(self, self.OnSettlement, _G.handler(self, self.StartSettlement)),true)
end

---重新开始战斗
function BattleControllerSixVsSixPVP:ReFight()
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.CS.UnityEngine.Time.timeScale = 1
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    _G.WorldManager:GetInstance():DespawnRoleParent()
    _G.BaseBattleManager:GetInstance():ClearView(false)
    self:FightExit()
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, false)
    require("SixVsSixPVPModel"):GetInstance():Fight()
end

---退出到主城 (失败,)
---@param call function 退出到主城时的回调
function BattleControllerSixVsSixPVP:QuitToMainWorld(call)
    if call then
        call()
    end
end

function BattleControllerSixVsSixPVP:OnLoadRecordFight(index, notInBattle)
    local recordType = notInBattle and 2 or 1
    _G.BattleManager:GetInstance():initAttackSids(
        require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.SixVsSixPVPAttack),
        _G.EmbattleType.SixVsSixPVPAttack,
        true,
        recordType,
        0
    )
    if notInBattle then
        while _G.BattleManager:GetInstance().Progress < 1 do
            _G.coroutine.waitforendofframe()
        end
    end
    --灵弈对决-隐藏宠物技节点(需等待SkillView加载)
    _G.BattleManager:GetInstance():SetPetSkillActive(false)
end

---获取怪物组ID
---@return number 怪物组ID
function BattleControllerSixVsSixPVP:GetMonsterGroupID()
    return 1034
end

----检测数据统计是否显示回放战斗
function BattleControllerSixVsSixPVP:CheckShowRecordBattle()
    return true
end

return BattleControllerSixVsSixPVP
