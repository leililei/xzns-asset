---@class BattleControllerTest:BattleControllerBase	中文描述
local BattleControllerTest = _G.BaseClass("BattleControllerTest", _G.BattleControllerBase)

local CS = _G.CS
local typeof = _G.typeof

local ShowType = {
    Loaded = 1,
    ShowEnd = 2
}

---类的构造函数
function BattleControllerTest:__init()
end

---类的析构函数
function BattleControllerTest:Dispose()
end

--region 子类重写方法
---处理传参
---@param sid number 房间sid
function BattleControllerTest:OnHandleParams(
    type,
    AttackUids,
    DefenceSids,
    scene,
    testSelfCombSkill,
    testEnemyCombSkill,
    testSelfPetSkill,
    testEnemyPetSkill)
    self.curBattleType = type
    self.attackUids = AttackUids
    self.defenceSids = DefenceSids
    self.scene = scene
    self.testSelfCombSkill = testSelfCombSkill
    self.testEnemyCombSkill = testEnemyCombSkill
    self.testSelfPetSkill = testSelfPetSkill
    self.testEnemyPetSkill = testEnemyPetSkill
    -- self.super.HandleParams(self)
end

-----检测是否可以进入战斗
---@param callback function 检测后的回调(参数bool)
function BattleControllerTest:CheckFight(call)
    if
        self.curBattleType == _G.EBattleType.TestAlone or self.curBattleType == _G.EBattleType.NormalAlone or
            self.curBattleType == _G.EBattleType.TestLastLocal or --本地测试战斗
            self.curBattleType == _G.EBattleType.TestRecord
     then --导入的战报战斗
        ---设置战报
        call(true)
    elseif self.curBattleType == _G.EBattleType.TestOnline then
        -- 测试带数据的战斗
        call(false)
    end
end

---战斗验证不通过
---@param msg string 错误信息
function BattleControllerTest:OnCheckFail(msg)
    self.super.OnCheckFail(self)
end

---加载战斗(协程加载)
function BattleControllerTest:OnLoadFight()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    self.Loaded = false
    self.ShowEnd = false
    self.BossShow = nil
    self.BossShowTime = 0
    self.State = nil
    local uiManager = _G.UIManager:GetInstance()
    uiManager:CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)

    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    local showStartView = false

    if self.type == _G.EBattleType.NormalAlone then
    -- showStartView = true
    -- _G.UIUtils.ProloadMaskVideo(
    --     "OpenDoor01",
    --     "OpenDoor01_mask",
    --     "Images/Bg/battlestartbg",
    --     function()
    --         showStartView = false
    --     end
    -- )
    -- while showStartView do
    --     _G.coroutine.waitforendofframe()
    -- end
    end
    if self.type == _G.EBattleType.NormalAlone then
        _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(false)
    end
    --
    -- 获取布阵信息
    -- local fighterSids = require("EmbattleModel"):GetInstance():GetEmbattleSidsData()
    local battleManager = _G.BattleManager:GetInstance()

    local testGhostCardSkills = {0, 0, 0}
    local k = 1
    local combine_cfgs = _G.ConfigManager.combine_cfg
    for i, v in pairs(self.testSelfCombSkill) do
        if v > 0 then
            local cardSkillSid = combine_cfgs[v].skills[#combine_cfgs[v].skills]
            testGhostCardSkills[k] = cardSkillSid
        else
            testGhostCardSkills[k] = 0
        end
        k = k + 1
    end

    _G.BattleManager:GetInstance():BeginTestBattle(
        self.scene,
        true,
        self.attackUids,
        self.defenceSids,
        self.curBattleType,
        testGhostCardSkills,
        self.testSelfPetSkill or { 0, 0, 0 }
    )
    self.mgCfg = _G.ConfigManager.monster_group_cfg[self.scene]

    -- battleManager:SetRoleParent(_G.WorldManager:GetInstance():GetItemParent())
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    if self.type == _G.EBattleType.NormalAlone then
        battleView.View:SetCanvasGroupTrue()
    else
        battleView.View:SetCanvasGroupTrue()
    end
end

---战斗开始
function BattleControllerTest:OnStart()
    -- self.super.OnStart(self)
    self.Loaded = true
    ---保存数据
    _G.TestBattleManager:GetInstance():SaveEmbattleData(self.attackUids, self.defenceSids)
    self.State = ShowType.Loaded
    self:OnBossShowEndDurationTimeEnd(self.State)
end

---战斗结束
---@param tab table 战斗数据
function BattleControllerTest:OnFightResult(tab, call)
    if self.curBattleType == _G.EBattleType.TestAlone or self.curBattleType == _G.EBattleType.TestRecord then
        self:OnSettlementEndCall()
    elseif self.curBattleType == _G.EBattleType.NormalAlone then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
            true,
            nil,
            _G.handler(self, self.OnSettlementEndCall),
            false
        )
    end
end

---战斗退出
function BattleControllerTest:OnSettlementEnd()
    -- self.super.FightExit(self)
    _G.TestBattleManager:GetInstance():EnterEmbattle(self.curBattleType)

    -- _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(true)
    -- _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
end

--endregion

--BOSS出场表演结束，开始战斗
function BattleControllerTest:OnBossShowEndDurationTimeEnd(state)
    if not self.Loaded then
        return
    end
    if state == ShowType.Loaded then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    end
    self.BossShow = nil
    self.BossShowTime = nil
    self.State = nil
    ---跳过战前剧情
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()
    _G.BattleManager:GetInstance():ShowBattleTeam()
end

---手动停止战斗
function BattleControllerTest:EndFight()
    self:OnSettlementEndCall()
end

---重新开始战斗
function BattleControllerTest:ReFight()
    _G.BattleManager:GetInstance():ReFight()
end

---获取怪物组ID
---@return number 怪物组ID
function BattleControllerTest:GetMonsterGroupID()
    return self.scene
end

---多场次战斗每场开始调用
---@param index number 场次
function BattleControllerTest:BattleBoutStart()
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.DelayDo(2, function()
        _G.BattleManager:GetInstance():SetBattlePause(false)
        _G.BattleManager:GetInstance():OnStartNextFight()
    end)
end

---多场次战斗每场开始调用
---@param index number 场次
function BattleControllerTest:RecordBattleBoutStart()
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.DelayDo(2, function()
        _G.BattleManager:GetInstance():SetBattlePause(false)
        _G.BattleManager:GetInstance():OnStartNextFight()
    end)
end

return BattleControllerTest
