local base = _G.BattleControllerBase
---@class BattleControllerArenaGlobal	中文描述
local BattleControllerArenaGlobal = _G.BaseClass("BattleControllerArenaGlobal", base)

---@param id number boss id  或者log_id
---@param IsRecord boolean 是否为回放
function BattleControllerArenaGlobal:OnHandleParams(msg, fightData, isFirst)
    self.fightArgs = msg
    self.fightData = fightData
    self.isFirst = isFirst
    self.mgCfg = _G.ConfigManager.monster_group_cfg[msg.sid]
end

function BattleControllerArenaGlobal:CheckFight(call)
    call(true)
end

---加载战斗(协程加载)
function BattleControllerArenaGlobal:OnLoadFight()
    local uiManager = _G.UIManager:GetInstance()
    if self.isFirst then
        local battleStartView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
        while (_G.IsNil(battleStartView.View.gameObject)) do
            _G.coroutine.waitforendofframe()
        end
    end
    _G.coroutine.waitforendofframe()
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    battleView.View:SetSettingBtnActive(false)
    -- battleView.View:HideSkipBtn()
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    local battleManager = _G.BattleManager:GetInstance()
    battleManager:initAttackSids(
        nil,
        _G.EBattleType.NormalBattle,
        true,
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        self.fightData.name
    )
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    local mcfg = _G.ConfigManager.monster_group_cfg[_G.ConfigManager.arena_info_cfg[2].battle_sences]
    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, mcfg.audio)
    uiManager:GetWindowCtrl(_G.ConfigManager.ui_cfg.BattleView.Name):SetCanvasGroupTrue()
end

---战斗开始
function BattleControllerArenaGlobal:OnStart()
    local uiManager = _G.UIManager:GetInstance()
    uiManager:CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    uiManager:ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    -- _G.BattleManager:GetInstance():SetBattlePause(true)
    if self.curFightState == 4 then
        return
    end
    _G.BattleManager:GetInstance():SetBattleStart()
    _G.BattleManager:GetInstance():ShowBattleTeam()
    -- _G.BattleManager:GetInstance():ShowSkipBattleBtn(not self.noSkip)
    self.isStart = true
end

---战斗结束
---@param tab table 战斗数据
function BattleControllerArenaGlobal:OnFightResult(tab, call)
    if self.co then
        _G.coroutine.stopwaiting(self.co)
        self.co = nil
    end
    self.FightResult = tab
    call()
end

---结算
function BattleControllerArenaGlobal:OnSettlement(call)
    if not self.FightResult.skip and require("ArenaGlobalModel"):GetInstance():CheckFightNext() then
        local fightMsg = require("ArenaGlobalModel"):GetInstance().fightMsg
        require("ArenaGlobalModel"):GetInstance():FightNext(
            self.fightData,
            function(msg)
                if msg.ack == 1 then
                    self:OnSettlementEndCall(fightMsg.report.a_win, _G.SettlementModel.FunctionEnum.None)
                else
                    call(
                        _G.SettlementModel.SettlementType.ArenaGlobal,
                        self.FightResult,
                        self.IsRecord,
                        self.fightArgs,
                        self.fightData
                    )
                end
            end
        )
        return
    end
    call(_G.SettlementModel.SettlementType.ArenaGlobal, self.FightResult, self.IsRecord, self.fightArgs, self.fightData)
end

---战斗退出
function BattleControllerArenaGlobal:OnSettlementEnd()
    -- self.super.FightExit(self)
    -- _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    if self.FightResult.skip or not require("ArenaGlobalModel"):GetInstance():CheckFightNext() then
        _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    end
    _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
    _G.WorldManager:GetInstance():DespawnRoleParent()
end

function BattleControllerArenaGlobal:FightExit()
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    _G.BattleControllerBase.FightExit(self)
    if self.FightResult.skip or not require "ArenaGlobalModel":GetInstance():CheckFightNext() then
        require "ArenaGlobalModel":GetInstance():ExitEmbattle()
    end
    if self.co then
        _G.coroutine.stopwaiting(self.co)
        self.co = nil
    end
end

function BattleControllerArenaGlobal:OnBeKicked(uid)
    if uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
        _G.BattleManager:GetInstance():SetBattlePause(true)
        self:FightExit()
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
        _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
        _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(true)
        _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
        _G.WorldManager:GetInstance():DespawnRoleParent()
    end
end

---多场次战斗每场开始调用
---@param index number 场次
function BattleControllerArenaGlobal:BattleBoutStart()
    if not self.isStart then
        return
    end
    -- _G.BattleManager:GetInstance():SetBattlePause(true)
    -- _G.BattleManager:GetInstance():SetBattlePause(false)
    _G.BattleManager:GetInstance():OnStartNextFight()
end

function BattleControllerArenaGlobal:StartLoading()
    self.curFightState = 2
    local BattleManagerIns = _G.BattleManager:GetInstance()
    BattleManagerIns:SetInBattle(true)
    BattleManagerIns:SetRoleParent(_G.WorldManager:GetInstance():GetRoleParent())
    self.stopCoProgress = _G.coroutine.start(_G.handler(self, self.LoadFight))
    self:DoStartGC()
end

