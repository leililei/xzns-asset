local WorldBossManager = require "WorldBossManager"
---@class BattleControllerWorldBoss : Singleton	中文描述
local BattleControllerWorldBoss = _G.BaseClass("BattleControllerWorldBoss", _G.BattleControllerBase)

---@return BattleControllerWorldBoss BattleControllerWorldBoss
function BattleControllerWorldBoss:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function BattleControllerWorldBoss:__init()
end

function BattleControllerWorldBoss:CheckFight(call)
    self.checkCall = call
    local port = require("WorldBossNet"):GetInstance():FightBoss(_G.handler(self, self.OnFightMsgCall))
    _G.BattleManager:GetInstance():AddLuaNetEvent(port)
end

function BattleControllerWorldBoss:OnFightMsgCall(msg)
    if msg.ack == 1 then
        self.mgCfg = _G.ConfigManager.monster_group_cfg[msg.fight_arg.sid]
        --_G.CS.BattleManager.Inst:StrReceiveMsg(msg.fight_arg)
        self.checkCall(true)
    else
        self.checkCall(false, msg.ack)
    end
    self.checkCall = nil
end

---加载战斗(协程加载)
function BattleControllerWorldBoss:OnLoadFight()
    local uiManager = _G.UIManager:GetInstance()
    local view = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.LoadingView.Name).View
    while (_G.IsNil(view.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    uiManager:CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)

    -- local showStartView = true
    -- _G.UIUtils.ProloadMaskVideo(
    --     "OpenDoor01",
    --     "OpenDoor01_mask",
    --     "Images/Bg/battlestartbg",
    --     function()
    --         showStartView = false
    --     end
    -- )
    -- while showStartView do
    --     _G.coroutine.waitforendofframe()
    -- end

    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    --battleView.View:SetSettingBtnActive(false)
    _G.BaseBattleManager:GetInstance():ClearView(false)
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(false)
    local battleManager = _G.BattleManager:GetInstance()
    local fighterSids
    fighterSids = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.worldBoss)
    battleManager:initAttackSids(fighterSids, _G.EBattleType.WorldBossChallenge, true, 0, 0)
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    _G.coroutine.waitforendofframe()

    battleView.View:SetCanvasGroupTrue()
end

---战斗开始
function BattleControllerWorldBoss:OnStart()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    -- self.super.OnStart(self)
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()
    _G.BattleManager:GetInstance():ShowBattleTeam()
end

---战斗结束
---@param tab table 战斗数据
function BattleControllerWorldBoss:OnFightResult(tab, call)
    self.FightResult = tab
    call()
    -- self:Settlement(tab)
end

---结算
function BattleControllerWorldBoss:OnSettlement(call)
    call(_G.SettlementModel.SettlementType.worldBoss, self.FightResult)
end

---战斗退出
function BattleControllerWorldBoss:OnSettlementEnd()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(true)
    _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
    _G.WorldManager:GetInstance():DespawnRoleParent()
    WorldBossManager:GetInstance():ReturnPanel()
end

---重开战斗
function BattleControllerWorldBoss:ReFight()
    _G.BattleManager:GetInstance():DestroyBattle()
    WorldBossManager:GetInstance():ReEnterFight()
end

--- 退出关卡
function BattleControllerWorldBoss:EndFight()
    _G.BattleManager:GetInstance():DestroyBattle()
    WorldBossManager:GetInstance():FightLose()
end

function BattleControllerWorldBoss:QuitToMainWorld(call)
    _G.UIManager:GetInstance():CloseWindowsByLayer(_G.UILayers.NormalLayer)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    call()
end

function BattleControllerWorldBoss:OnReEmbattle()
    _G.BattleManager:GetInstance():DestroyBattle()
    WorldBossManager:GetInstance():ReEnterFight()
end

---获取怪物组ID
---@return number 怪物组ID
function BattleControllerWorldBoss:GetMonsterGroupID()
    return self.mgCfg.id
end

---销毁对象时,析构函数
function BattleControllerWorldBoss:Dispose()
end

return BattleControllerWorldBoss
