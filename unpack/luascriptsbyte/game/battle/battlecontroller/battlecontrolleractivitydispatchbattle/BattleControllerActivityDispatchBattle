---@class BattleControllerActivityDispatchBattle    中文描述
local BattleControllerActivityDispatchBattle = _G.BaseClass("BattleControllerActivityDispatchBattle", _G.BattleControllerBase)

---@param id number boss id  或者log_id
---@param IsRecord boolean 是否为回放
function BattleControllerActivityDispatchBattle:OnHandleParams(msg, fightData)
    self.fightArgs = msg.fight_arg
    self.fightData = fightData
    self.result = msg
    self.mgCfg = _G.ConfigManager.monster_group_cfg[msg.fight_arg.sid]
end

function BattleControllerActivityDispatchBattle:CheckFight(call)
    call(true)
end

---加载战斗(协程加载)
function BattleControllerActivityDispatchBattle:OnLoadFight()
    local uiManager = _G.UIManager:GetInstance()
    local battleStartView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    while (_G.IsNil(battleStartView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    _G.coroutine.waitforendofframe()
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    battleView.View:SetSettingBtnActive(false)
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleStartView.Name)
    self.battleView = battleView.View
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    _G.coroutine.waitforendofframe()
    local battleManager = _G.BattleManager:GetInstance()
    battleManager:initAttackSids(
        nil,
        _G.EBattleType.SoicayBattleFight,
        true,
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        self.fightData.role_info.name
    )
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    local mcfg = _G.ConfigManager.monster_group_cfg[_G.ConfigManager.arena_info_cfg[2].battle_sences]
    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, mcfg.audio)
    uiManager:GetWindowCtrl(_G.ConfigManager.ui_cfg.BattleView.Name):SetCanvasGroupTrue()
end

---战斗开始
function BattleControllerActivityDispatchBattle:OnStart()
    local uiManager = _G.UIManager:GetInstance()
    uiManager:CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    uiManager:ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    uiManager:ShowWindow(_G.ConfigManager.ui_cfg.SociatyBattleStartView.Name)
    -- _G.BattleManager:GetInstance():SetBattlePause(true)
    self.co1 = _G.DelayDo(
        2,
        function()
            self.battleView:OnBattleBegin(
                function()
                    _G.BattleManager:GetInstance():SetBattleStart()
                    _G.BattleManager:GetInstance():ShowBattleTeam()
                    self.isStart = true
                end
            )
        end
    )
    --local battleView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.BattleView.Name)
    --if battleView then
    --    battleView:HideSkipBtn()
    --end
end

---结算
function BattleControllerActivityDispatchBattle:OnSettlement(call)
    call(
        _G.SettlementModel.SettlementType.ActivityDispatch,
        self.result
    )
end

---战斗退出
function BattleControllerActivityDispatchBattle:OnSettlementEnd()
    -- self.super.FightExit(self)
    -- _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SociatyBattleStartView.Name)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
    _G.WorldManager:GetInstance():DespawnRoleParent()
    require("ActivityDispatchModel"):GetInstance():CheckEndPanel()
end

---多场次战斗每场开始调用
---@param index number 场次
function BattleControllerActivityDispatchBattle:BattleBoutStart()
    if not self.isStart then
        return
    end
    _G.BattleManager:GetInstance():SetBattlePause(true)
    self.battleView:OnBattleBegin(
        function()
            _G.BattleManager:GetInstance():SetBattlePause(false)
            _G.BattleManager:GetInstance():OnStartNextFight()
        end
    )
end

function BattleControllerActivityDispatchBattle:StartLoading()
    self.curFightState = 2
    local BattleManagerIns = _G.BattleManager:GetInstance()
    BattleManagerIns:SetInBattle(true)
    BattleManagerIns:SetRoleParent(_G.WorldManager:GetInstance():GetRoleParent())
    self.stopCoProgress = _G.coroutine.start(_G.handler(self, self.LoadFight))
    self:DoStartGC()
end

---协程加载
function BattleControllerActivityDispatchBattle:StartLoadingRecordFight(index, notInBattle)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SociatyBattleStartView.Name)
    _G.BattleManager:GetInstance():SetInRecordBattle(true)
    self.stopCoProgress = _G.coroutine.start(_G.handlerbind(self, self.LoadRecordFight, index, notInBattle))
    --self:StartRecordFight()
end

---多场次战斗每场结束调用
---@param index number 场次
function BattleControllerActivityDispatchBattle:BattleBoutEnd(index)
    self.battleView:OnBattleEnd()
end

--- 退出关卡
function BattleControllerActivityDispatchBattle:EndFight()
    _G.BattleManager:GetInstance():DestroyBattle()
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(true)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
end

---获取怪物组ID
---@return number 怪物组ID
function BattleControllerActivityDispatchBattle:GetMonsterGroupID()
    return self.mgCfg.id
end

---加载战斗(协程加载)
function BattleControllerActivityDispatchBattle:OnLoadRecordFight()
    _G.BattleManager:GetInstance():initAttackSids(nil, _G.EBattleType.WorldBossDamageTest, true, 1)
    local mcfg = _G.ConfigManager.monster_group_cfg[_G.ConfigManager.arena_info_cfg[2].battle_sences]
    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, mcfg.audio)
end

---加载回放战斗
function BattleControllerActivityDispatchBattle:LoadRecordFight(index, notInBattle)
    local CreateStartEff
    local co = function()
        if notInBattle then
            while (_G.BattleManager:GetInstance().Progress ~= 1) do
                _G.coroutine.waitforendofframe()
            end
        end
        if self.co then
            _G.coroutine.stopwaiting(self.co)
            self.co = nil
        end
        self:StartRecordFight(notInBattle)
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, CreateStartEff, self)
    end

    CreateStartEff = function(_, name)
        if name == _G.ConfigManager.ui_cfg.LoadingView.Name then
            self.co = _G.coroutine.start(co)
        end
    end

    local uiManager = _G.UIManager:GetInstance()
    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name).View
    if notInBattle then
        local world = _G.ePoolType.World
        _G.BattleManager:GetInstance():SetPoolName(world, world, world, world, world)
        _G.coroutine.waitforendofframe()
        local battleStartView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.LoadingView.Name).View
        while (_G.IsNil(battleStartView.gameObject)) do
            _G.coroutine.waitforendofframe()
        end
        _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
        battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name).View
        -- 等待 战斗窗口 加载完成
        while (_G.IsNil(battleView.gameObject)) do
            _G.coroutine.waitforendofframe()
        end
        battleView:Hide()
        if _G.AppSetting.IsAlipay then
            local conditions = _G.ConfigManager.discrete_cfg[126101]
            battleView:SetSpeedBtnActive(_G.GlobalConditionManager.CheckCondition(conditions[1][2], conditions[1][3]))
        else
            battleView:SetSpeedBtnActive(_G.FunctionManager:GetInstance():CheckFunctionIsUnlock(30))
        end
        battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleStartView.Name)
        self.battleView = battleView.View
        while (_G.IsNil(battleView.View.gameObject)) do
            _G.coroutine.waitforendofframe()
        end
        self:OnLoadRecordFight()
        _G.coroutine.waitforendofframe()
        uiManager:GetWindowCtrl(_G.ConfigManager.ui_cfg.BattleView.Name):SetCanvasGroupTrue()
        _G.BattleManager:GetInstance():SetBattlePause(true)
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, CreateStartEff, self)
        battleStartView:Close()
    else
        -- 等待 战斗窗口 加载完成
        while (_G.IsNil(battleView.gameObject)) do
            _G.coroutine.waitforendofframe()
        end
        battleView:Hide()
        if _G.AppSetting.IsAlipay then
            local conditions = _G.ConfigManager.discrete_cfg[126101]
            battleView:SetSpeedBtnActive(_G.GlobalConditionManager.CheckCondition(conditions[1][2], conditions[1][3]))
        else
            battleView:SetSpeedBtnActive(_G.FunctionManager:GetInstance():CheckFunctionIsUnlock(30))
        end
        battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleStartView.Name)
        self.battleView = battleView.View
        while (_G.IsNil(battleView.View.gameObject)) do
            _G.coroutine.waitforendofframe()
        end
        self:OnLoadRecordFight()
        _G.coroutine.waitforendofframe()
        uiManager:GetWindowCtrl(_G.ConfigManager.ui_cfg.BattleView.Name):SetCanvasGroupTrue()
        _G.BattleManager:GetInstance():SetBattlePause(true)
        self:StartRecordFight()
    end
end

----检测数据统计是否显示回放战斗
function BattleControllerActivityDispatchBattle:CheckShowRecordBattle()
    return true
end

local function Switch3DUICamClearFlags(clearFlags)
    local Cam3DUI = _G.GraphicsManager.Instance:GetSubCamera("3DUICam")
    if not _G.IsNil(Cam3DUI) then
        Cam3DUI.clearFlags = clearFlags
    end
end
---开始回放战斗
function BattleControllerActivityDispatchBattle:StartRecordFight(notInBattle)
    self.notInBattle = notInBattle
    if notInBattle then
        Switch3DUICamClearFlags(_G.CS.UnityEngine.CameraClearFlags.Depth)
    end
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ActivityDispatchBattleView.Name)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ActivityDispatchView.Name)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    _G.BattleManager:GetInstance():SetBattleStart()
    _G.BattleManager:GetInstance():ShowBattleTeam()
    _G.BattleManager:GetInstance():SetPauseBtnState(0, 1, 1)
    _G.BattleManager:GetInstance():SetBattlePause(true)
end

---多场次战斗每场开始调用
---@param index number 场次
function BattleControllerActivityDispatchBattle:RecordBattleBoutStart()
    _G.BattleManager:GetInstance():SetBattlePause(true)
    self.battleView:OnBattleBegin(
        function()
            _G.BattleManager:GetInstance():SetBattlePause(false)
            _G.BattleManager:GetInstance():OnStartNextFight()
        end
    )
end

---多场次战斗每场结束调用
---@param index number 场次
function BattleControllerActivityDispatchBattle:RecordBattleBoutEnd(index)
    self.battleView:OnBattleEnd()
end

function BattleControllerActivityDispatchBattle:FightRecordExit()
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SociatyBattleStartView.Name)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ActivityDispatchBattleView.Name)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ActivityDispatchView.Name)
    self.super.FightRecordExit(self)
end

return BattleControllerActivityDispatchBattle
