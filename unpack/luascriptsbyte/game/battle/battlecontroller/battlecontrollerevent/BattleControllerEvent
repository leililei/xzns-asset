local BattleControllerChapterBase = require "BattleControllerChapterBase"

---@class BattleControllerEvent	中文描述
local BattleControllerEvent = _G.BaseClass("BattleControllerEvent", BattleControllerChapterBase)

---类的构造函数
function BattleControllerEvent:__init()
end

---类的析构函数
function BattleControllerEvent:Dispose()
end

--region 子类重写方法
---处理传参
---@param sid number 房间sid
function BattleControllerEvent:OnHandleParams(sid, endCall)
    self.curEventSid = sid
    self.monsterGroupID = _G.tonumber(_G.ConfigManager.main_event_cfg[self.curEventSid].complete_params[1][1])
    BattleControllerChapterBase.OnHandleParams(self, endCall)
end
---获取是否保留池里面的资源
---@return boolean 是否保留
function BattleControllerEvent:GetRetainpool()
    return false
end
--endregion

function BattleControllerEvent:OnSettlement(call)
    if self.resultData.winner then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
        _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
        self:FightExit()
        self:OnSettlementEnd(true)
    else
        BattleControllerChapterBase.OnSettlement(self, call)
    end
end

function BattleControllerEvent:GetMsgData()
    return {sid = self.curEventSid, type = 2}
end
return BattleControllerEvent
