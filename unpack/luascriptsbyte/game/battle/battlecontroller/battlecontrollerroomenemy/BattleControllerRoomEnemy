local BattleControllerChapterBase = require "BattleControllerChapterBase"

---@class BattleControllerRoomEnemy	中文描述
---@field private objectCfg object_world_cfg 物件配置
local BattleControllerRoomEnemy = _G.BaseClass("BattleControllerRoomEnemy", BattleControllerChapterBase)
---类的构造函数
function BattleControllerRoomEnemy:__init()
    self.objectCfg = nil
end

---类的析构函数
function BattleControllerRoomEnemy:Dispose()
    self.objectCfg = nil
end

---处理参数
---@param mgpID number 房间战斗组ID
---@param callback function 战斗返回
---@param sid number 物件表ID
function BattleControllerRoomEnemy:OnHandleParams(mgpID, callback, sid)
    self.objectCfg = _G.ConfigManager.object_world_cfg[sid]
    self.monsterGroupID = mgpID
    self.objectWorldSid = sid
    if not _G.PlayerModel:GetInstance():CheckCreateRole() then
        BattleControllerChapterBase.OnBattleCall(self)
    else
        BattleControllerChapterBase.OnHandleParams(self, callback)
    end
end
---战斗开始
function BattleControllerRoomEnemy:OnStart()
    if #self.objectCfg.ClickParams >= 2 then --需要展示boss出场特效
        self:OnBossShow()
    else
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
        self:OnBossShowEndDurationTimeEnd()
    end

    --剧情战斗-隐藏宠物技节点(需等待SkillView加载)
    _G.BattleManager:GetInstance():SetPetSkillActive(false)
end

local afterBattleStoryIndex = 4
---结算
---@param 变量名 变量类型 中文描述
function BattleControllerRoomEnemy:OnSettlement(call)
    local ChapterRoomManagerIns = _G.ChapterRoomManager:GetInstance()
    if self.resultData.winner then
        require("ChapterModel"):GetInstance():SetRoomBattleDone(self.monsterGroupID)
        if not _G.PlayerModel:GetInstance():CheckCreateRole() then
            local cfg = _G.ConfigManager.monster_group_cfg[self.monsterGroupID]
            local dropCfg
            if cfg.Drop[1] then
                dropCfg = _G.ConfigManager.drop_cfg[cfg.Drop[1]]
                if dropCfg then
                    self.resultData.award = {item = {}}
                    for i = 1, #dropCfg.fixed_drop do
                        _G.table.insert(self.resultData.award.item, {type = dropCfg.fixed_drop[i]})
                    end
                    ChapterRoomManagerIns:SaveSettlementAward(
                        _G.StorageManager:GetInstance():MergeAward(self.resultData)
                    )
                end
            end
            if cfg.Drop[2] then
                dropCfg = _G.ConfigManager.drop_cfg[cfg.Drop[2]]
                if dropCfg then
                    self.resultData.other_award = {item = {}}
                    for i = 1, #dropCfg.fixed_drop do
                        _G.table.insert(self.resultData.other_award.item, {type = dropCfg.fixed_drop[i]})
                    end
                    ChapterRoomManagerIns:SetCurEnemyBoxAward(self.resultData.other_award)
                end
            end
        end

        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name)
        if view then
            view:UpdateRoomAward()
        end
    end
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    self:CreateResultEff(_G.handlerbind(self, self.SettlementRoomEnemy, call))
end

function BattleControllerRoomEnemy:StartSettlement(lua, ...)
    if not _G.PlayerModel:GetInstance():CheckCreateRole() then
        self:FightExit()
        _G.ChapterRoomManager:GetInstance():ExitSectionSelf(
            function(call)
                ---@type MainOpenViewFunItem
                local MainOpenViewFunItem = {}
                MainOpenViewFunItem.OpenViewFun = function()
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SelectSectionMapNewView.Name)
                end
                _G.MainManager:GetInstance():AddMainFunQueue(
                    MainOpenViewFunItem,
                    _G.MainViewShowOrder.SelectSectionViewOpen
                )
                if call ~= nil then
                    call()
                end
            end
        )
    else
        _G.BattleControllerBase.StartSettlement(self, lua, ...)
    end
end

function BattleControllerRoomEnemy:SettlementRoomEnemy(call)
    --- 只有胜利 才播放战后剧情
    if self.resultData.winner == true then
        _G.ChapterRoomManager:GetInstance():SetRoomEnemyBattle(self.monsterGroupID)
        if
            #self.objectCfg.default_interaction_plot >= afterBattleStoryIndex and
                self.objectCfg.default_interaction_plot[afterBattleStoryIndex] > 0
         then
            self.onSettlementStoryCall = call
            _G.AutomaticPlayStory.PlayStoryByID(
                self.objectCfg.default_interaction_plot[afterBattleStoryIndex],
                _G.handler(self, self.OnRoomEnemySettlement)
            )
        else
            self:OnRoomEnemySettlement(call)
        end
    else
        self:OnRoomEnemySettlement(call)
    end
end

function BattleControllerRoomEnemy:OnRoomEnemySettlement(call)
    call = self.onSettlementStoryCall or call
    BattleControllerChapterBase.OnSettlement(self, call)
    self.onSettlementStoryCall = nil
    if self.resultData.winner then
        if self.objectCfg.Params[1] == _G.HeroType.Boss then
            local chapterModelInstance = require("ChapterModel"):GetInstance()
            chapterModelInstance:SetSectionStar(chapterModelInstance:GetChooseSectionID())
        end
    end
end
---加载其他资源(协程)
function BattleControllerRoomEnemy:LoadOther()
    local showStartView = false
    if #self.objectCfg.ClickParams >= 2 then
        if _G.tonumber(self.objectCfg.ClickParams[1]) == 1 then
            _G.UIUtils.CacheEffectByCfg(
                _G.ConfigManager.ui_effect_cfg[self.objectCfg.ClickParams[2]],
                function()
                    showStartView = true
                end
            )
        else
            showStartView = true
        end
    else
        showStartView = true
    end
    while not showStartView do
        _G.coroutine.waitforendofframe()
    end
end
---获取战斗消息协议内容
---@return 变量类型 中文描述
function BattleControllerRoomEnemy:GetMsgData()
    return {sid = self.monsterGroupID, type = self.objectCfg.Params[1] == _G.HeroType.Boss and 3 or 1}
end

--region BOSS出场相关
function BattleControllerRoomEnemy:OnBossShow()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    if _G.tonumber(self.objectCfg.ClickParams[1]) == 1 then
        --Boss出场动画
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[self.objectCfg.ClickParams[2]],
            nil,
            function(trans)
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
                local worldmanager = _G.WorldManager:GetInstance()
                local world = worldmanager:GetCurWorld()
                local MainCamera = world.WorldSetting.SceneCamera.UniCam
                MainCamera:SetActiveE(0)
                worldmanager:SetCurrentWorldVisible(false)
                for i = 0, trans:GetChildCountE() - 1, 1 do
                    if trans:GetChildE(i).tag == "Timeline" then
                        trans:GetChildE(i):SetActiveE(0)
                        trans:GetChildE(i):SetActiveE(1)
                        break
                    end
                end
            end,
            function()
                _G.WorldManager:GetInstance():SetCurrentWorldVisible(true)
                _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
                self.ShowEnd = true
                self:OnBossShowEndDurationTimeEnd()
            end
        )
    else
        _G.UIUtils.PlayVideo(
            _G.ConfigManager.video_cfg[self.objectCfg.ClickParams[2]],
            function()
                _G.WorldManager:GetInstance():SetCurrentWorldVisible(true)
                _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
                local MainCamera = _G.WorldManager:GetInstance():GetCurWorld().WorldSetting.SceneCamera.UniCam
                MainCamera:SetActiveE(1)
                self:OnBossShowEndDurationTimeEnd()
            end,
            function()
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
                local worldmanager = _G.WorldManager:GetInstance()
                local world = worldmanager:GetCurWorld()
                local MainCamera = world.WorldSetting.SceneCamera.UniCam
                MainCamera:SetActiveE(0)
                worldmanager:SetCurrentWorldVisible(false)
            end
        )
    end
end
local battleFrontStoryIndex = 3
--BOSS出场表演结束，开始战斗
function BattleControllerRoomEnemy:OnBossShowEndDurationTimeEnd()
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()
    ---战前剧情
    if
        #self.objectCfg.default_interaction_plot >= battleFrontStoryIndex and
            self.objectCfg.default_interaction_plot[battleFrontStoryIndex] > 0
     then
        _G.AutomaticPlayStory.PlayStoryByID(
            self.objectCfg.default_interaction_plot[battleFrontStoryIndex],
            _G.handler(self, self.OnPlayBattleFrontStoryEnd)
        )
    else
        self:OnPlayBattleFrontStoryEnd()
    end
end

---战前剧情
function BattleControllerRoomEnemy:OnPlayBattleFrontStoryEnd()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    _G.BattleManager:GetInstance():ShowBattleTeam()
    if self:CheckSceneLoad() then
        _G.WorldManager:GetInstance():SetCurrentWorldVisible(false)
    end
end
--endregion

return BattleControllerRoomEnemy
