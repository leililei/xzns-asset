---@class BattleControllerActivityTrial : BattleControllerBase	雪域欢歌-雪域试炼
---@field model ActivityTrialSynModel
---@field activity ActivityTrialData
---@field monsterGroupId number
local BattleControllerActivityTrial = _G.BaseClass("BattleControllerActivityTrial", _G.BattleControllerBase)

---@return BattleControllerActivityTrial BattleControllerActivityTrial
function BattleControllerActivityTrial:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function BattleControllerActivityTrial:OnHandleParams(activity, monsterGroupId)
    self.model = activity:GetActivityTypeCls()
    self.activity = activity
    self.monsterGroupId = monsterGroupId
end

function BattleControllerActivityTrial:CheckFight(call)
    self.checkCall = call
    if not self.activity:GetFunctionOpen() then
        _G.PopWindowManager:GetInstance():ShowAllTips(620105)
        self:QuitToMainWorld()
        return
    end
    local port = require("ActivityTrialNet"):GetInstance():Fight(
        { activity_id = self.activity:GetActivityID() },
        _G.handler(self, self.OnFightMsgCall)
    )
    _G.BattleManager:GetInstance():AddLuaNetEvent(port)
end

function BattleControllerActivityTrial:OnFightMsgCall(msg)
    if msg.ack == 1 then
        self.mgCfg = _G.ConfigManager.monster_group_cfg[msg.fight_arg.sid]
        self.checkCall(true)
    else
        self.checkCall(false, msg.ack)
    end
    self.checkCall = nil
end

---加载战斗(协程加载)
function BattleControllerActivityTrial:OnLoadFight()
    local uiManager = _G.UIManager:GetInstance()
    -- uiManager:CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)

    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    --battleView.View:SetSettingBtnActive(false)
    _G.BaseBattleManager:GetInstance():ClearView(false)
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(false)
    local battleManager = _G.BattleManager:GetInstance()
    local fighterSids = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.ActivityTrial)
    battleManager:initAttackSids(fighterSids, _G.EBattleType.ActivityTrial, true, nil, nil, nil, nil,
        self.model:GetDamage())
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    battleView.View:SetCanvasGroupTrue()
end

---战斗开始
function BattleControllerActivityTrial:OnStart()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    -- self.super.OnStart(self)
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()
    _G.BattleManager:GetInstance():ShowBattleTeam()
end

---战斗结束
---@param tab table 战斗数据
function BattleControllerActivityTrial:OnFightResult(tab, call, isNotWin)
    self.FightResult = tab
    self.isNotWin = isNotWin
    call()
    -- self:Settlement(tab)
end

---结算
function BattleControllerActivityTrial:OnSettlement(call)
    call(_G.SettlementModel.SettlementType.ActivityTrial,
        self.FightResult, self.isNotWin, self.activity, self.monsterGroupId
    )
end

---战斗退出
function BattleControllerActivityTrial:OnSettlementEnd()
    -- _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(true)
    _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
    _G.WorldManager:GetInstance():DespawnRoleParent()
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    self.model:ReturnPanel()
end

---重开战斗
function BattleControllerActivityTrial:ReFight()
    _G.BattleManager:GetInstance():DestroyBattle()
    self.model:Fight()
end

--- 退出关卡
function BattleControllerActivityTrial:EndFight()
    -- _G.SettlementModel:GetInstance():Settlement(
    --     _G.SettlementModel.SettlementType.SeasonBoss,
    --     function()
    --         _G.BattleManager:GetInstance():DestroyBattle()
    --         require "SeasonBossModel":GetInstance():ReturnPanel()
    --     end,
    --     nil,
    --     false
    -- )
    _G.BattleManager:GetInstance():PauseBattle(true)
    self:OnFightResult(nil, _G.handlerbind(self, self.OnSettlement, _G.handler(self, self.StartSettlement)), true)
end

function BattleControllerActivityTrial:QuitToMainWorld(call)
    _G.BattleControllerBase.FightExit(self)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    if call then
        call()
    end
end

function BattleControllerActivityTrial:OnReEmbattle()
    _G.BattleManager:GetInstance():DestroyBattle()
    self.model:Fight()
end

function BattleControllerActivityTrial:OnLoadRecordFight()
    _G.BattleManager:GetInstance():initAttackSids(nil, _G.EBattleType.ActivityTrial, true, 1)
end

---获取怪物组ID
---@return number 怪物组ID
function BattleControllerActivityTrial:GetMonsterGroupID()
    return self.mgCfg.id
end

function BattleControllerActivityTrial:CheckShowRecordBattle()
    return true
end

---销毁对象时,析构函数
function BattleControllerActivityTrial:Dispose()
end

return BattleControllerActivityTrial
