local ArenaNet = require "ArenaNet"
local base = require("BattleControllerBase")
---@class BattleControllerArena : BattleControllerBase  中文描述
local BattleControllerArena = _G.BaseClass("BattleControllerArena", base)

---类的构造函数
function BattleControllerArena:__init()
end

---类的析构函数
function BattleControllerArena:Dispose()
    self.onCheckCall = nil
    self.mgCfg = nil
end

--region 子类重写
---处理参数
---@param rank number 当前排名
---@param enemy table 地方数据
function BattleControllerArena:OnHandleParams(rank, enemy, leftName, rightName)
    self.lastRank = rank
    self.curWinNum = require("ArenaManager"):GetInstance():GetArenaClass(1):GetWinNum()
    self.enemy = enemy
    self.leftName = leftName
    self.rightName = rightName
end

function BattleControllerArena:EnterRecordFight(...)
    local args = { ... }
    self.leftName = args[4] or self.leftName
    self.rightName = args[5] or self.rightName
    base.EnterRecordFight(self, ...)
end

-----检测是否可以进入战斗
function BattleControllerArena:CheckFight(callback)
    self.onCheckCall = callback
    local controller = require("ArenaController"):GetInstance()
    local data = controller:GetEnemyDataByUid(controller.curChallengeUid)
    local port =
        ArenaNet:GetInstance():Fight(
        controller.curChooseArenaSid,
        controller.curChallengeUid,
        data.mType,
        _G.handler(self, self.OnFightMsgCall)
    )
    _G.BattleManager:GetInstance():AddLuaNetEvent(port)
end

---加载战斗(协程加载)
function BattleControllerArena:OnLoadFight()
    local uiManager = _G.UIManager:GetInstance()
    uiManager:CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    battleView.View:SetSettingBtnActive(false)
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    local battleManager = _G.BattleManager:GetInstance()
    battleManager:initAttackSids(
        nil,
        _G.EBattleType.OneTeamArena,
        true,
        nil,
        nil,
        nil,
        nil,
        nil,
        self.leftName,
        self.rightName
    )
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, self.mgCfg.audio)

    battleView.View:SetCanvasGroupTrue()
end

---战斗开始
function BattleControllerArena:OnStart()
    local uiManager = _G.UIManager:GetInstance()
    uiManager:ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    local view = uiManager:GetWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    if view then
        view.View:SetAutoBtnActive(false)
        view.View.AtActive = false
    end
    local battleManagerIns = _G.BattleManager:GetInstance()
    battleManagerIns:SetBattlePause(true)
    battleManagerIns:SetBattleStart()
    battleManagerIns:ShowBattleTeam()
    --TODO:竞技场 跳过功能开放判定
    battleManagerIns:ShowSkipBattleBtn(_G.FunctionManager:GetInstance():CheckFunctionIsUnlock(96))
end

---战斗结束
--[[
  required uint32 ack = 1;
  optional bool winner = 2;//进攻方是否胜利
  optional award.i_award award = 3;//战斗奖励
  repeated uint32 info = 4;//消息，竞技场:变化积分,总积分,新排名
]]
---@param tab table 战斗数据
function BattleControllerArena:OnFightResult(tab, call)
    ArenaNet:GetInstance():FightResult(
        nil,
        function(_data)
            if _data.ack == 1 then
                --CommonTipManager:GetInstance().OpenCommonAwardView(_data)
                _G.StorageManager:GetInstance():ReceiveAwardData(_data)
                local result = _data.winner or false
                self.params = {
                    score = _data.info[1],
                    sumscore = _data.info[2],
                    lastRank = self.lastRank,
                    win = result,
                    enemy = self.enemy,
                    re_uid = _data.re_uid,
                    reportType = 2,
                    data = _data
                }
                if _data.info[4] and _data.info[5] then
                    self.params.enemyCurScore = _data.info[4]
                    self.params.enemyAddScore = _data.info[5] - _data.info[4]
                end
                if result then
                    _G.Events:GetInstance():Broadcast(_G.eSeasonTask.Action, {_G.SeasonTaskID.Arena, 1}, 1)
                else
                    require "PopUpGiftBagModel":GetInstance():IsArenaFailure()
                end
                self.curResultView = self.params.view
                self:RefreshView(call)
            else
                self:OnSettlementEndCall(false)
            end
            _G.Events:GetInstance():Broadcast(_G.eSeasonTask.Action, {_G.SeasonTaskID.Arena, 2}, 1)
        end
    )
end

---结算
---@param callback function 结算回调(参数 结算脚本名,其他动态参数
function BattleControllerArena:OnSettlement(callback)
    callback(_G.SettlementModel.SettlementType.arena, self.params)
end

---结算退出
---@param win boolean 是否胜利
function BattleControllerArena:OnSettlementEnd(win)
    if win == nil then
        --异常
        _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    else
        local ArenaController = require("ArenaController"):GetInstance()
        if ArenaController:GetArenaState() == 1 then
            ArenaController:RefreshBoxRedPoint()
            ArenaController:RefreshRePort(
                function()
                    ArenaController:GetEnemyArray(
                        function()
                            local ctrl =
                                _G.UIManager:GetInstance():GetWindowCtrl(
                                _G.ConfigManager.ui_cfg.ArenaMainPanelView.Name
                            )
                            if ctrl then
                                ctrl:Show()
                                local ctrl1 =
                                    _G.UIManager:GetInstance():GetWindowCtrl(
                                    _G.ConfigManager.ui_cfg.ArenaChanllengeView.Name
                                )
                                if ctrl1 then
                                    _G.UIManager:GetInstance():ShowWindow(
                                        _G.ConfigManager.ui_cfg.ArenaChanllengeView.Name
                                    )
                                else
                                    ArenaController:OnChallengeBtn()
                                end
                            else
                                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaMainPanelView.Name)
                                ArenaController:OnChallengeBtn()
                            end
                        end,
                        true
                    )
                end
            )
        else
            _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
        end
    end
end

---获取怪物组ID
---@return number 怪物组ID
function BattleControllerArena:GetMonsterGroupID()
    return self.mgCfg.id
end

---重新布阵
function BattleControllerArena:OnReEmbattle()
    self:OnSettlementEnd(false)
end

--endregion

--region 内部方法
---检测回调
---@param 变量名 变量类型 中文描述
function BattleControllerArena:OnFightMsgCall(msg)
    if msg.ack == 1 then
        self.mgCfg = _G.ConfigManager.monster_group_cfg[msg.fight_arg.sid]
        require("ArenaController"):GetInstance():ChangesChallengeTimes()
        local isSkip =
            _G.PlayerPrefsManager.GetInt(
            (_G.PlayerModel:GetInstance().role_uid) .. "SkipBattle" .. _G.EmbattleType.arenaAttack
        ) or 0 == 1
        if isSkip then
        end
        self.onCheckCall(true)
    else
        self.onCheckCall(false, msg.ack)
    end
end

function BattleControllerArena:RefreshView(call)
    local arenaClass = require("ArenaManager"):GetInstance():GetArenaClass(1)
    if arenaClass:GetCurArenaState() == 1 then
        arenaClass:InitInfo(
            function()
                self.params.curRank = arenaClass:GetRank()
                --self.params.winNum = arenaClass:GetWinNum() - self.curWinNum
                --self.params.curWinNum = arenaClass:GetWinNum()
                --self.params.maxWinNum = arenaClass:GetMaxWinNum()
                local ArenaController = require("ArenaController"):GetInstance()
                ArenaController:RefreshBoxRedPoint()
                ArenaController:RefreshRePort(
                    function()
                        ArenaController:GetEnemyArray(call, true)
                    end
                )
            end,
            true
        )
    else
        --_G.PopWindowManager:GetInstance():ShowAllTips(300301)
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnSureCall, self)
    end
end

function BattleControllerArena:OnSureCall()
    require("ArenaController"):GetInstance():SetRefreshCall()
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnSureCall, self)
    _G.UIManager:GetInstance():CloseWindow(self.curResultView)
    self:OnSettlementEndCall(false)
end

--endregion

---加载战斗(协程加载)
function BattleControllerArena:OnLoadRecordFight(index, notInBattle)
    local recordType = notInBattle and 2 or 1
    _G.BattleManager:GetInstance():initAttackSids(
        nil,
        _G.EBattleType.OneTeamArena,
        true,
        recordType,
        0,
        nil,
        nil,
        nil,
        self.leftName,
        self.rightName
    )
    if notInBattle then
        while _G.BattleManager:GetInstance().Progress < 1 do
            _G.coroutine.waitforendofframe()
        end
    end
    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, 1009)
end

----检测数据统计是否显示回放战斗
function BattleControllerArena:CheckShowRecordBattle()
    return true
end

function BattleControllerArena:EndFight()
    self:OnSettlementEnd(false)
end

return BattleControllerArena
