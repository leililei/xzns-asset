local TrainingModel = require "TrainingModel"
---@class BattleControllerTrain : Singleton	中文描述
local BattleControllerTrain = _G.BaseClass("BattleControllerTrain", _G.BattleControllerBase)

---@return BattleControllerTrain BattleControllerTrain
function BattleControllerTrain:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function BattleControllerTrain:__init()
end

-- region 子类重写方法
---处理传参
---@param sid number 房间sid
function BattleControllerTrain:OnHandleParams(SectionID)
    self.SectionID = SectionID
    -- self.super.HandleParams(self)
end

function BattleControllerTrain:CheckFight(call)
    self.checkCall = call

    ---@type special_training.c2s_special_training_fight
    local pbdata = {}
    pbdata.id = self.SectionID.id
    pbdata.garray = {}
    pbdata.garray.id = self.SectionID.id

    pbdata.garray.sits = self.SectionID.sits
    pbdata.garray.skill_index = self.SectionID.skill_index
    pbdata.garray.pet = { 0, 0, 0 } --TODO: 合击技暂时默认写0
    pbdata.activity_id = self.SectionID.activityId
    local port = require("TrainingNet"):GetInstance():FightBoss(pbdata, _G.handler(self, self.OnFightMsgCall))
    _G.BattleManager:GetInstance():AddLuaNetEvent(port)
end

function BattleControllerTrain:OnFightMsgCall(msg)
    if msg.ack == 1 then
        self.mgCfg = _G.ConfigManager.monster_group_cfg[msg.fight_arg.sid]
        -- _G.CS.BattleManager.Inst:StrReceiveMsg(msg.fight_arg)
        self.checkCall(true)
    else
        self.checkCall(false, msg.ack)
        _G.BattleManager:GetInstance():DestroyBattle()
    end
    self.checkCall = nil
end

---加载战斗(协程加载)
function BattleControllerTrain:OnLoadFight()
    local uiManager = _G.UIManager:GetInstance()
    -- local view = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    -- while (_G.IsNil(view.View.gameObject)) do
    --     _G.coroutine.waitforendofframe()
    -- end
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)

    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    -- 获取布阵信息
    local fighterSids = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.trainBattle)
    require("TrainingModel"):GetInstance():SetIsTrainBattle(true)

    local battleManager = _G.BattleManager:GetInstance()
    --region 检测是否 自动战斗，是否 是自动释放 合击技
    local scetionid = require("TrainingModel"):GetInstance():GetTrainScetionID()
    local autoFight = _G.ConfigManager.train_section_cfg[scetionid].autofight -- 0 自动 -- 1 手动
    local automatic_skills = _G.ConfigManager.train_section_cfg[scetionid].automatic_skills -- 0 自动 -- 1 手动
    -- 不用于竞技场 0是非镇魂特训战斗 1 全手动，2自动怒气技 3 自动合击技 4 自动怒气 和 合击技
    local forceAutoSkillType = 1
    if autoFight[1] == 0 and automatic_skills[1] == 0 then
        forceAutoSkillType = 4
    elseif autoFight[1] == 1 and automatic_skills[1] == 1 then
        forceAutoSkillType = 1
    elseif autoFight[1] == 0 and automatic_skills[1] == 1 then
        forceAutoSkillType = 2
    elseif autoFight[1] == 1 and automatic_skills[1] == 0 then
        forceAutoSkillType = 3
    end
    --endregion
    battleView.View:SetAutoBtnActive(autoFight[2] == 0)
    if autoFight[2] ~= 0 then
        battleView.View.AtActive = false
    end
    if automatic_skills[1] == 1 then
        battleView.View:SetCombineBtnActive()
    end

    battleManager:initAttackSids(fighterSids, _G.EBattleType.Train, true, 0, 0, forceAutoSkillType)
    --   _G.CS.BattleManager.Inst:SetAutoJointSkillOpen(automatic_skills[2] == 1)
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end

    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    _G.coroutine.waitforendofframe()
    battleView.View:SetCanvasGroupTrue()
end

---战斗开始
function BattleControllerTrain:OnStart()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()
    _G.BattleManager:GetInstance():ShowBattleTeam()

    --镇魂特训-隐藏宠物技节点(需等待SkillView加载)
    _G.BattleManager:GetInstance():SetPetSkillActive(false)
end

---战斗结束
---@param tab table 战斗数据
function BattleControllerTrain:OnFightResult(tab, call)
    require("TrainingModel"):GetInstance():SetIsTrainBattle(false)

    self.FightResult = tab
    call()
    -- self:Settlement(tab)
end

---结算
function BattleControllerTrain:OnSettlement(call)
    call(_G.SettlementModel.SettlementType.train, self.FightResult)
end

---战斗退出
function BattleControllerTrain:OnSettlementEnd()
    -- _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
    TrainingModel:GetInstance():ExitEmbattle()
end

---重开战斗
function BattleControllerTrain:ReFight()
    _G.BattleManager:GetInstance():DestroyBattle()
    TrainingModel:GetInstance():ReEnterFight()
end

--- 退出关卡
function BattleControllerTrain:EndFight()
    require("TrainingModel"):GetInstance():SetIsTrainBattle(false)
    _G.BattleManager:GetInstance():DestroyBattle()
    TrainingModel:GetInstance():ExitEmbattle()
end

function BattleControllerTrain:QuitToMainWorld(call)
    _G.UIManager:GetInstance():CloseWindowsByLayer(_G.UILayers.NormalLayer)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    call()
end

---获取怪物组ID
---@return number 怪物组ID
function BattleControllerTrain:GetMonsterGroupID()
    return self.mgCfg.id
end

---销毁对象时,析构函数
function BattleControllerTrain:Dispose()
end

return BattleControllerTrain
