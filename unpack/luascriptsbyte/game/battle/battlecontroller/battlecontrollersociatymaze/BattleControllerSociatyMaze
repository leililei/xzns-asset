---@class BattleControllerSociatyMaze : Singleton	公会-暗影迷宫
local BattleControllerSociatyMaze = _G.BaseClass("BattleControllerSociatyMaze", _G.BattleControllerBase)

---@return BattleControllerSociatyMaze
function BattleControllerSociatyMaze:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function BattleControllerSociatyMaze:__init()
end

function BattleControllerSociatyMaze:OnHandleParams(results, id, grade, monsterId)
    self.id = id
    self.grade = grade
    self.monsterId = monsterId
    self.embattleType = _G.EmbattleType.sociatyMaze

    self.results = results
    self.mgCfg = _G.ConfigManager.monster_group_cfg[results.data.sid]
end

function BattleControllerSociatyMaze:CheckFight(callback)
    if callback then
        callback(true)
    end
end

---加载战斗(协程加载)
function BattleControllerSociatyMaze:OnLoadFight()
    local uiManager = _G.UIManager:GetInstance()
    -- uiManager:CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)

    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    --battleView.View:SetSettingBtnActive(false)
    _G.BaseBattleManager:GetInstance():ClearView(false)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SystemFairylandEmbattleView.Name)
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(false)
    local battleManager = _G.BattleManager:GetInstance()
    local fighterSids = require("EmbattleModel"):GetInstance():GetEmbattleData(self.embattleType)
    battleManager:initAttackSids(
        fighterSids,
        self.embattleType,
        true,
        0,
        0,
        0,
        nil,
        nil,
        _G.PlayerModel:GetInstance():GetName(),
        require("SociatyMazeBattleModel"):GetInstance():GetMonsterName(self.id, self.grade)
    )
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    battleView.View:SetCanvasGroupTrue()
    --不允许放弃战斗
    battleView.View:SetSettingBtnActive(false)
end

---战斗开始
function BattleControllerSociatyMaze:OnStart()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    -- self.super.OnStart(self)
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()
    _G.BattleManager:GetInstance():ShowBattleTeam()
end

---战斗结束
---@param tab table 战斗数据
function BattleControllerSociatyMaze:OnFightResult(tab, call)
    call()
end

---结算
function BattleControllerSociatyMaze:OnSettlement(call)
    call(_G.SettlementModel.SettlementType.SociatyMaze, self.results, self.id, self.grade, self.monsterId)
end

---战斗退出
function BattleControllerSociatyMaze:OnSettlementEnd()
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(true)
    _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
    _G.WorldManager:GetInstance():DespawnRoleParent()

    require("SociatyMazeBattleModel"):GetInstance():ShowWindows()
end

---重开战斗
function BattleControllerSociatyMaze:ReFight()
    _G.BattleManager:GetInstance():DestroyBattle()
    require("SociatyMazeBattleModel"):GetInstance():Fight(self.id, self.grade)
end

--- 退出关卡
function BattleControllerSociatyMaze:EndFight()
    _G.BattleManager:GetInstance():PauseBattle(true)
    self:OnFightResult(nil, _G.handlerbind(self, self.OnSettlement, _G.handler(self, self.StartSettlement)), true)
end

function BattleControllerSociatyMaze:OnReEmbattle()
    self:OnSettlementEnd()
    require("SociatyMazeBattleModel"):GetInstance():Fight(self.id, self.grade)
end

function BattleControllerSociatyMaze:OnLoadRecordFight()
    _G.BattleManager:GetInstance():initAttackSids(
        nil,
        self.embattleType,
        true,
        1,
        nil,
        nil,
        nil,
        nil,
        _G.PlayerModel:GetInstance():GetName(),
        require("SociatyMazeBattleModel"):GetInstance():GetMonsterName(self.id, self.grade)
    )
end

---获取怪物组ID
---@return number 怪物组ID
function BattleControllerSociatyMaze:GetMonsterGroupID()
    return self.mgCfg.id
end

---是否显示回放
---@return boolean
function BattleControllerSociatyMaze:CheckShowRecordBattle()
    return false
end

---退出到主城
---@param call function 退出到主城时的回调
function BattleControllerSociatyMaze:QuitToMainWorld(...)
    _G.BattleControllerBase.QuitToMainWorld(self, ...)

    _G.BattleManager:GetInstance():DestroyBattle()
    _G.WorldManager:GetInstance():DespawnRoleParent()
end

---销毁对象时,析构函数
function BattleControllerSociatyMaze:Dispose()
end

return BattleControllerSociatyMaze
