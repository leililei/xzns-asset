---@class BattleControllerReedCatkins	中文描述
local BattleControllerReedCatkins = _G.BaseClass("BattleControllerReedCatkins", _G.BattleControllerBase)

local ShowType = {
    Loaded = 1,
    ShowEnd = 2
}

---类的构造函数
function BattleControllerReedCatkins:__init()
end

---类的析构函数
function BattleControllerReedCatkins:Dispose()
end

--region 子类重写方法
---处理传参
---@param sid number 芦花幻境sid
function BattleControllerReedCatkins:OnHandleParams(sid)
    self.sectionID = sid
    -- self.super.HandleParams(self)
end

-----检测是否可以进入战斗
---@param callback function 检测后的回调(参数bool)
function BattleControllerReedCatkins:CheckFight(call)
    local port =
        require("ReedCatkinsNet"):GetInstance():ChallengeReedCatkins(
        {sid = self.sectionID},
        function(msg)
            if msg.ack ~= 1 then
                call(false, msg.ack)
                return
            end
            self.mgCfg = _G.ConfigManager.monster_group_cfg[msg.fight_arg.sid]
            call(true)
        end
    )
    _G.BattleManager:GetInstance():AddLuaNetEvent(port)
end

---战斗验证不通过
---@param msg string 错误信息
function BattleControllerReedCatkins:OnCheckFail(msg)
    self.super.OnCheckFail(self)
end

---加载战斗(协程加载)
function BattleControllerReedCatkins:OnLoadFight()
    local visualCam =
        _G.WorldManager:GetInstance():GetCurWorld().WorldSetting.SceneCamera:GetComponentE(
        _G.typeof(_G.CS.FrameWork.Graphic.VisualCamera)
    )
    self.curLerpTime = visualCam.Interpolation
    visualCam.Interpolation = 0
    local uiManager = _G.UIManager:GetInstance()
    --uiManager:OpenWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    self.Loaded = false
    self.ShowEnd = false

    self.State = nil

    --uiManager:CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)
    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)

    -- local showStartView = true
    -- _G.UIUtils.ProloadMaskVideo(
    --     "OpenDoor01",
    --     "OpenDoor01_mask",
    --     "Images/Bg/battlestartbg",
    --     function()
    --         showStartView = false
    --     end
    -- )
    -- while showStartView do
    --     _G.coroutine.waitforendofframe()
    -- end

    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)

    _G.BaseBattleManager:GetInstance():ClearView(false)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    -- 获取布阵信息
    local fighterSids = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.ReedCatkins)
    local battleManager = _G.BattleManager:GetInstance()
    battleManager:initAttackSids(fighterSids, _G.EBattleType.Abyss, true, 0, 0)
    -- battleManager:SetRoleParent(_G.WorldManager:GetInstance():GetRoleParent())
    -- 协程等待

    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    uiManager:ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    battleView.View:SetCanvasGroupTrue()
end

---战斗开始
function BattleControllerReedCatkins:OnStart()
    -- self.super.OnStart(self)
    self.Loaded = true
    self.State = ShowType.Loaded
    self:OnBossShowEndDurationTimeEnd(self.State)
end

---战斗结束
---@param tab table 战斗数据
function BattleControllerReedCatkins:OnFightResult(tab, call)
    if _G.AppSetting.DEBUG then
        _G.Log(tab, "战斗结束")
    end
    self.FightResult = tab
    call()
    -- self:Settlement(tab)
    -- _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
end

---结算
---@param 变量名 变量类型 中文描述
---@return 变量类型 中文描述
function BattleControllerReedCatkins:OnSettlement(call)
    call(_G.SettlementModel.SettlementType.reedCatkins, self.FightResult)
end

function BattleControllerReedCatkins:QuitToMainWorld(call)
    if call then
        call()
    end
end

---战斗退出
function BattleControllerReedCatkins:OnSettlementEnd(win)
    -- self.super.FightExit(self)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(true)
    _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
    _G.WorldManager:GetInstance():DespawnRoleParent()
end
--endregion

---当死亡动画播完或者奖励播放完
function BattleControllerReedCatkins:OnDeathAniEndOrAwardEnd()
    if not self.deathOrAwardEnd then
        self.deathOrAwardEnd = true
        return
    end
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    local visualCam =
        _G.WorldManager:GetInstance():GetCurWorld().WorldSetting.SceneCamera:GetComponentE(
        _G.typeof(_G.CS.FrameWork.Graphic.VisualCamera)
    )
    visualCam.Interpolation = self.curLerpTime or 0
    self:Settlement({roomSid = self.curEventSid, result = self.resultData})
end

--BOSS出场表演结束，开始战斗
function BattleControllerReedCatkins:OnBossShowEndDurationTimeEnd(state)
    if not self.Loaded then
        return
    end
    if state == ShowType.Loaded then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    end
    self.BossShow = nil
    self.BossShowTime = nil
    self.State = nil
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()
    ---跳过战前剧情
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    _G.BattleManager:GetInstance():ShowBattleTeam()
end

---重开战斗
function BattleControllerReedCatkins:ReFight()
    _G.BattleManager:GetInstance():DestroyBattle()
    require("ReedCatkinsModel"):GetInstance():ReplayCurSection()
end

--- 退出关卡
function BattleControllerReedCatkins:EndFight()
    _G.BattleManager:GetInstance():DestroyBattle()
    require("ReedCatkinsModel"):GetInstance():ExitSectionSelf()
end
function BattleControllerReedCatkins:OnReEmbattle()
    self:ReFight()
end

---获取怪物组ID
---@return number 怪物组ID
function BattleControllerReedCatkins:GetMonsterGroupID()
    return self.mgCfg.id
end
----检测数据统计是否显示回放战斗
function BattleControllerReedCatkins:CheckShowRecordBattle()
    return true
end
---加载战斗(协程加载)
function BattleControllerReedCatkins:OnLoadRecordFight()
    -- 获取布阵信息
    local fighterSids = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.ReedCatkins)
    local battleManager = _G.BattleManager:GetInstance()
    battleManager:initAttackSids(fighterSids, _G.EBattleType.Abyss, true, 1, 0)
end
return BattleControllerReedCatkins
