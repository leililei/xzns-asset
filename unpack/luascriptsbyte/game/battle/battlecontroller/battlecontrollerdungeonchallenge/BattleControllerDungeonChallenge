---@class BattleControllerDungeonChallenge : BattleControllerBase	装备合成闯关_战斗控制器
local BattleControllerDungeonChallenge = _G.BaseClass("BattleControllerDungeonChallenge", _G.BattleControllerBase)
local DungeonChallengeBattleModel = require("DungeonChallengeBattleModel")

---创建对象时,入口构造函数
function BattleControllerDungeonChallenge:__init()
end

function BattleControllerDungeonChallenge:OnHandleParams(monsterGroupId, fightArg)
    self.monsterGroupId = monsterGroupId
    self.fightArg = fightArg
end

function BattleControllerDungeonChallenge:CheckFight(callback)
    _G.BattleManager:GetInstance():SetArgData(self.fightArg)
    if callback then
        callback(not not self.fightArg)
    end
end

---加载战斗(协程加载)
function BattleControllerDungeonChallenge:OnLoadFight()
    local uiManager = _G.UIManager:GetInstance()
    -- uiManager:CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)

    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)

    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(false)
    local battleManager = _G.BattleManager:GetInstance()
    battleManager:initAttackSids(
        nil,
        1,
        true,
        0,
        0,
        0
    )
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    battleView.View:SetCanvasGroupTrue()
    --隐藏BattleView面板
    --battleView.View.gameObject:SetLocalScaleXYZ(0)
    self:SetChildrenActive(
        battleView.View.gameObject,
        false,
        {
            ["UIRoot"] = true
        }
    )
    self:SetChildrenActive(
        battleView.View.gameObject:FindE("UIRoot"),
        false,
        {
            ["CommRoots"] = true
        }
    )
    self:SetChildrenActive(
        battleView.View.gameObject:FindE("UIRoot/CommRoots"),
        false,
        {
            ["time"] = true
        }
    )
end

function BattleControllerDungeonChallenge:StartFightNew()
    if not self.isMonsherShow then
        self.isMonsherShow = true
        return
    end
    self:StartFight()
    if not _G.BattleManager:GetInstance():GetInRecordBattle() and _G.PlayerModel:GetInstance():CheckCreateRole() then
        _G.GameUtil.ChangeDefulfRootSize()
        _G.GameUtil.ChangeChatDefultLayer()
        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ChatDefultRootView.Name, { x = 45, y = 108 })
        -- _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ChatDefultRootView.Name)
    end
end

---战斗开始
function BattleControllerDungeonChallenge:OnStart()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ChatDefultRootView.Name)
    -- self.super.OnStart(self)
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()
    _G.BattleManager:GetInstance():ShowBattleTeam()

    local model = DungeonChallengeBattleModel:GetInstance()
    local speedNum = 1
    local disCfg = _G.ConfigManager.discrete_cfg[136002]

    for i = 1, #disCfg do
        if model:GetChallengingMonsterIndex() >= disCfg[i][1] then
            speedNum = disCfg[i][2]
        end
    end
    _G.CS.UnityEngine.Time.timeScale = speedNum
    --_G.BattleManager:GetInstance():SetSpeedByValue(speedNum) --默认1倍速

    --强制开启飘字
    local battleManagerInst = _G.CS.BattleManager.Inst
    if battleManagerInst and battleManagerInst.View and battleManagerInst.View.TipsView then
        battleManagerInst.View.TipsView:SetHideFloat(false)
    end
end

---战斗结束
---@param tab table 战斗数据
function BattleControllerDungeonChallenge:OnFightResult(tab, call)
    self.FightResult = tab
    call()
end

---结算
function BattleControllerDungeonChallenge:OnSettlement(call)
    call(_G.SettlementModel.SettlementType.DungeonChallenge, self.FightResult, self.monsterGroupId, self.fightArg)
end

---战斗退出
function BattleControllerDungeonChallenge:OnSettlementEnd()
    --_G.LogError("OnSettlementEnd")
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(true)
    _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
    _G.WorldManager:GetInstance():DespawnRoleParent()

    require("DungeonChallengeBattleModel"):GetInstance():ReturnPanel()
end

---重开战斗
function BattleControllerDungeonChallenge:ReFight()
    _G.BattleManager:GetInstance():DestroyBattle()
    --_G.LogError("ReFight")
end

---挑战下一关
function BattleControllerDungeonChallenge:OnChallengeNext()
    --_G.LogError("OnChallengeNext")
end

--- 退出关卡
function BattleControllerDungeonChallenge:EndFight()
    _G.BattleManager:GetInstance():PauseBattle(true)
    self:OnFightResult(nil, _G.handlerbind(self, self.OnSettlement, _G.handler(self, self.StartSettlement)), true)
end

---获取怪物组ID
---@return number 怪物组ID
function BattleControllerDungeonChallenge:GetMonsterGroupID()
    return self.monsterGroupId
end

function BattleControllerDungeonChallenge:CheckShowRecordBattle()
    return false
end

---设置直接子节点是否激活
---@private
---@param root UnityEngine.GameObject 根节点
---@param active boolean 是否激活
---@param ignores? table<string,boolean> 忽略的子节点名称
function BattleControllerDungeonChallenge:SetChildrenActive(root, active, ignores)
    if _G.IsNil(root) then
        return
    end
    local count = root:GetChildCountE()
    for i = 0, count - 1 do
        local child = root:GetChildE(i)
        if not ignores or not ignores[child:GetName()] then
            child:SetLocalScaleXYZ(active and 1 or 0)
        end
    end
end

return BattleControllerDungeonChallenge
