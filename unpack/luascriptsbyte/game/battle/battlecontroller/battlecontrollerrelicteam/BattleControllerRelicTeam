function BattleControllerRelicTeam:OnLoadRecordFight()
    _G.BattleManager:GetInstance():initAttackSids(nil, self.embattleType, true, 1)
end

---获取怪物组ID
---@return number 怪物组ID
function BattleControllerRelicTeam:GetMonsterGroupID()
    return self.mgCfg.id
end

function BattleControllerRelicTeam:CheckShowRecordBattle()
    return true
end

---销毁对象时,析构函数
function BattleControllerRelicTeam:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eSettlementFail.ReEmbattle, self.OnSettlementEnd, self)
end

return BattleControllerRelicTeam
