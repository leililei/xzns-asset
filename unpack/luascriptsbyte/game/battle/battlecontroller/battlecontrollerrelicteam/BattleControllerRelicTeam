---@class BattleControllerRelicTeam : Singleton	灵域巡查战斗控制器
local BattleControllerRelicTeam = _G.BaseClass("BattleControllerRelicTeam", _G.BattleControllerBase)

---@return BattleControllerRelicTeam
function BattleControllerRelicTeam:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function BattleControllerRelicTeam:__init()
    _G.Events:GetInstance():AddListener(_G.eSettlementFail.ReEmbattle, self.OnSettlementEnd, self)
end

function BattleControllerRelicTeam:OnHandleParams()
    self.embattleType = _G.EmbattleType.RelicTeam
end

function BattleControllerRelicTeam:CheckFight(call)
    self.checkCall = call
    -- local port = require("RelicTeamModel"):GetInstance():FinishEvent(self.args, _G.handler(self, self.OnFightMsgCall))
    -- _G.BattleManager:GetInstance():AddLuaNetEvent(port)
    local args = require("RelicTeamModel"):GetInstance():GetEventArgs()
    _G.BattleManager:GetInstance():SetArgData(args.fight_arg)
    self:OnFightMsgCall(args)
    --require("RelicTeamModel"):GetInstance():FinishEvent(self.args, _G.handler(self, self.OnFightMsgCall))
end

function BattleControllerRelicTeam:OnFightMsgCall(msg)
    local i = 1
    if msg.ack == 1 then
        self.mgCfg = _G.ConfigManager.monster_group_cfg[msg.fight_arg.sid]
        self.fightArg = msg.fight_arg
        self.checkCall(true)
    else
        self.checkCall(false, msg.ack)
    end
    self.checkCall = nil
end

---加载战斗(协程加载)
function BattleControllerRelicTeam:OnLoadFight()
    local uiManager = _G.UIManager:GetInstance()
    -- uiManager:CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)

    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    battleView.View:SetSettingBtnActive(false)
    _G.BaseBattleManager:GetInstance():ClearView(false)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SystemFairylandEmbattleView.Name)
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(false)
    local battleManager = _G.BattleManager:GetInstance()
    local fighterSids = require("EmbattleModel"):GetInstance():GetEmbattleData(self.embattleType)
    local id = _G.EBattleType.QJHS
    -- if require("RelicTeamModel"):GetInstance():NowIsBoss() then
    --     id = _G.EBattleType.QJHSBoss
    -- end
    self.rightName = require("RelicTeamModel"):GetInstance():GetFightName()
    battleManager:initAttackSids(fighterSids, id, true, 0, 0, 0, nil, nil, nil, self.rightName)
    require("RelicTeamModel"):GetInstance():SetFightName()
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    battleView.View:SetCanvasGroupTrue()
end

---战斗开始
function BattleControllerRelicTeam:OnStart()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    -- self.super.OnStart(self)
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()
    _G.BattleManager:GetInstance():ShowBattleTeam()
end

---战斗结束
---@param tab table 战斗数据
function BattleControllerRelicTeam:OnFightResult(tab, call)
    self.FightResult = tab
    call()
end

---结算
function BattleControllerRelicTeam:OnSettlement(call)
    call(_G.SettlementModel.SettlementType.RelicTeam, self.FightResult, nil, nil, self.fightArg)
end

---战斗退出
function BattleControllerRelicTeam:OnSettlementEnd()
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(true)
    _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
    _G.WorldManager:GetInstance():DespawnRoleParent()
    local args = require("RelicTeamModel"):GetInstance():GetEventArgs()
    require("RelicTeamModel"):GetInstance():ShowWindows()
    local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.RelicView.Name)
    if ctrl then 
        if not _G.table.isEmptyOrNil(args.award) then
            _G.DelayDo(0.5, function()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, args, function(data)
                    ctrl:ShowBuffEffect(data)
                end,
                nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, { relicTeamSortBol = true })
            end)
        else 
            ctrl:CheckUpLayerWindow()
            require("RelicTeamModel"):GetInstance():CheckSelfRank(require("RankUtils").RankType.AncientGodPersonalPoints)
            require("RelicTeamModel"):GetInstance():CheckSelfRank(require("RankUtils").RankType.AncientGodAllianceTeam)
        end
        ctrl:ShowEventView()
    else 
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, args, nil,
        nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, { relicTeamSortBol = true })
    end
end

