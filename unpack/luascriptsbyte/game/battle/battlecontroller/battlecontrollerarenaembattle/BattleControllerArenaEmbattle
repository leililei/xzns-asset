---类的构造函数
function BattleControllerArenaEmbattle:__init()
end

---类的析构函数
function BattleControllerArenaEmbattle:Dispose()
    self.enemy = nil
    self.resultMsg = nil
end

--region 子类重写
---处理参数
---@param msg number 战斗结果数据
---@param enemy table 地方数据
function BattleControllerArenaEmbattle:OnHandleParams(msg, enemy)
    self.enemy = enemy
    self.resultMsg = msg
end
-----检测是否可以进入战斗
function BattleControllerArenaEmbattle:CheckFight(callback)
    callback(true)
end
