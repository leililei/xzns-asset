local base = require "BattleControllerBase"
---@class BattleControllerArenaSenior :BattleControllerBase	中文描述
local BattleControllerArenaSenior = _G.BaseClass("BattleControllerArenaSenior", base)

---类的构造函数
function BattleControllerArenaSenior:__init()
end

---类的析构函数
function BattleControllerArenaSenior:Dispose()
    self.result = nil
    self.enemy = nil
    self.battleView = nil
    self.curRank = nil
end
---处理传参
---@param result table 战斗结果{boolean,boolean,boolean}
---@param enemy table 敌方信息
function BattleControllerArenaSenior:OnHandleParams(result, enemy, curRank, re_uid)
    self.result = result
    self.enemy = _G.DeepCopy(enemy)
    self.curRank = curRank
    self.re_uid = re_uid
end

-----检测是否可以进入战斗
function BattleControllerArenaSenior:CheckFight(callback)
    callback(true)
end

---加载战斗(协程加载)
function BattleControllerArenaSenior:OnLoadFight()
    local uiManager = _G.UIManager:GetInstance()
    uiManager:CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)
    local battleStartView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    while (not battleStartView.View.gameObject) do
        _G.coroutine.waitforendofframe()
    end
    _G.coroutine.waitforendofframe()
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    battleView.View:SetSettingBtnActive(false)
    battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.ArenaBattleSeniorView.Name, self.enemy)
    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.ArenaBattleSeniorView.Name)
    self.battleView = battleView.View
    --self:CacheBattleRes()
    _G.coroutine.waitforendofframe()
    local battleManager = _G.BattleManager:GetInstance()
    battleManager:initAttackSids(nil, _G.EBattleType.OneTeamArena, true)
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    local mcfg = _G.ConfigManager.monster_group_cfg[_G.ConfigManager.arena_info_cfg[2].battle_sences]
    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, mcfg.audio)
    uiManager:GetWindowCtrl(_G.ConfigManager.ui_cfg.BattleView.Name):SetCanvasGroupTrue()
end

---战斗开始
function BattleControllerArenaSenior:OnStart()
    local uiManager = _G.UIManager:GetInstance()
    uiManager:CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    uiManager:ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    uiManager:ShowWindow(_G.ConfigManager.ui_cfg.ArenaBattleSeniorView.Name)
    local view = uiManager:GetWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    if view then
        view.View:SetAutoBtnActive(false)
        view.View.AtActive = false
    end
    local battleManagerIns = _G.BattleManager:GetInstance()
    battleManagerIns:SetBattlePause(true)
    if not uiManager:IsExitWindow(_G.ConfigManager.ui_cfg.GroupBattlePanelView.Name ) then
        _G.DelayDo(
            1.5,
            function()
                self.battleView:OnBattleBegin(
                    function()
                        _G.BattleManager:GetInstance():SetBattleStart()
                        _G.BattleManager:GetInstance():ShowBattleTeam()
                        self.isStart = true
                    end
                )
            end
        )
    end
    --TODO:高阶竞技场 跳过功能开放判定
    battleManagerIns:ShowSkipBattleBtn(_G.FunctionManager:GetInstance():CheckFunctionIsUnlock(95))
    battleManagerIns:SetTimeTxtPos(-56)
end

---战斗结束
---@param tab table 战斗数据
function BattleControllerArenaSenior:OnFightResult(tab, call)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArenaBattleSeniorView.Name)
    call()
end
---结算
---@param callback function 结算回调(参数 结算脚本名,其他动态参数
function BattleControllerArenaSenior:OnSettlement(callback)
    local info = {}
    info.rank = self.curRank
    local PlayerModel = _G.PlayerModel:GetInstance()
    info.frame = PlayerModel:GetCurFrame()
    info.name = PlayerModel:GetName()
    info.style = PlayerModel:GetRoleStyle()
    info.level = PlayerModel:GetLevel()
    info.re_uid = self.re_uid
    local winNum = 0
    for i = 1, #self.result do
        if self.result[i] then
            winNum = winNum + 1
        end
    end
    if winNum > #self.result - winNum and info.rank > self.enemy.rank then
        local rank = info.rank
        info.rank = self.enemy.rank
        self.enemy.rank = rank
    end
    callback(_G.SettlementModel.SettlementType.arenaSenior, self.result, self.enemy, info)
end
---结算退出
---@param win boolean 是否胜利
function BattleControllerArenaSenior:OnSettlementEnd(win)
    if win == nil then --异常
        _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    else
        local arenaClass = require("ArenaManager"):GetInstance():GetArenaClass(2)
        if arenaClass:GetCurArenaState() == 1 then
            arenaClass:ClearReport()
            arenaClass:InitInfo(
                function()
                    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
                        _G.ConfigManager.redpoint_cfg.ArenaAwardSenior.id
                    )
                    local UIManagerIns = _G.UIManager:GetInstance()
                    UIManagerIns:OpenWindow(_G.ConfigManager.ui_cfg.ArenaMainPanelSeniorView.Name)
                    UIManagerIns:OpenWindow(_G.ConfigManager.ui_cfg.ArenaChallengeSeniorView.Name)
                end,
                true
            )
        end
    end
end

---多场次战斗每场开始调用
---@param index number 场次
function BattleControllerArenaSenior:BattleBoutStart(index)
    if not self.isStart then
        return
    end
    _G.BattleManager:GetInstance():SetBattlePause(true)
    self.battleView:OnBattleBegin(
        function()
            _G.BattleManager:GetInstance():SetBattlePause(false)
            _G.BattleManager:GetInstance():OnStartNextFight()
        end
    )
end
---多场次战斗每场结束调用
---@param index number 场次
function BattleControllerArenaSenior:BattleBoutEnd(index)
    self.battleView:OnBattleEnd(self.result[index])
end

---手动停止战斗(跳过)
function BattleControllerArenaSenior:OnEndFight()
    --调用两次的目的是因为正常结算的流程会调用两次
    self:Settlement()
    self:Settlement()
end

---获取怪物组ID
---@return number 怪物组ID
function BattleControllerArenaSenior:GetMonsterGroupID()
    return _G.ConfigManager.arena_info_cfg[2].battle_sences
end

