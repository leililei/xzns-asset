---加载战斗(协程加载)
function BattleControllerArenaSenior:OnLoadRecordFight(index, notInBattle)
    local recordType = notInBattle and 2 or 1
    _G.BattleManager:GetInstance():initAttackSids(nil, _G.EBattleType.OneTeamArena, true, recordType, index)
    if notInBattle then
        while _G.BattleManager:GetInstance().Progress < 1 do
            _G.coroutine.waitforendofframe()
        end
    end
    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, 1009)
end
----检测数据统计是否显示回放战斗
function BattleControllerArenaSenior:CheckShowRecordBattle()
    local groupPanelView =  _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.GroupBattleStartView.Name)
    return not groupPanelView
end

local function Switch3DUICamClearFlags(clearFlags)
    local Cam3DUI = _G.GraphicsManager.Instance:GetSubCamera("3DUICam")
    if not _G.IsNil(Cam3DUI) then
        Cam3DUI.clearFlags = clearFlags
    end
end

---开始回放战斗
function BattleControllerArenaSenior:StartRecordFight(notInBattle)
    if notInBattle then
        Switch3DUICamClearFlags(_G.CS.UnityEngine.CameraClearFlags.Depth)
    end
    local groupPanelView = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.GroupBattleStartView.Name)
    if groupPanelView then
        self.OnStartRecordFight()
    else
        _G.BattleManager:GetInstance():SetPauseBtnState(0, 1, 1)
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
        _G.BattleManager:GetInstance():SetBattlePause(true)
        _G.BattleManager:GetInstance():SetBattleStart()
        _G.BattleManager:GetInstance():ShowBattleTeam()
    end
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
    _G.Events:GetInstance():Broadcast(_G.FightPlayState.FightStart)
end

---回放战斗开始
function BattleControllerArenaSenior:OnStartRecordFight()
    local uimanager = _G.UIManager:GetInstance()
    uimanager:ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    local view = uimanager:GetWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    if view then
        view.View:SetAutoBtnActive(false)
        view.View.AtActive = false
    end
    _G.BattleManager:GetInstance():SetBattleStart()
    _G.BattleManager:GetInstance():ShowBattleTeam()
    _G.BattleManager:GetInstance():SetPauseBtnState(0, 1, 1)
    _G.BattleManager:GetInstance():SetBattlePause(true)
end

function BattleControllerArenaSenior:IsShowEffect()
    local groupPanelView =  _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.GroupBattleStartView.Name)
    return not groupPanelView
end

return BattleControllerArenaSenior