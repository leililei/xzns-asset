local base = require "BattleControllerBase"
---@class BattleControllerGuessGame	中文描述
local BattleControllerGuessGame = _G.BaseClass("BattleControllerGuessGame", base)

---类的构造函数
function BattleControllerGuessGame:__init()
end

---类的析构函数
function BattleControllerGuessGame:Dispose()
end

---加载战斗(协程加载)
function BattleControllerGuessGame:OnLoadRecordFight(index, notInBattle)
    local recordType = notInBattle and 2 or 1
    _G.BattleManager:GetInstance():initAttackSids(nil, nil, true, recordType, 0)
    if notInBattle then
        while _G.BattleManager:GetInstance().Progress < 1 do
            _G.coroutine.waitforendofframe()
        end
    end
    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, 1009)
end
----检测数据统计是否显示回放战斗
function BattleControllerGuessGame:CheckShowRecordBattle()
    return true
end

return BattleControllerGuessGame
