---@param id number boss id  或者log_id
---@param IsRecord boolean 是否为回放
function BattleControllerSociatyBoss:OnHandleParams(id, IsRecord, leftName, rightName, isTest)
    self.id = id
    self.IsRecord = IsRecord
    self.leftName = leftName
    self.rightName = rightName
    self.isTest = isTest
    -- self.super.HandleParams(self)
end

---进入回放战斗
---@param index number 回放场次索引
---@param notInBattle boolean 当前是否在战斗场景
function BattleControllerSociatyBoss:EnterRecordFight(index, notInBattle, sid, leftName, rightName)
    self.curSid = sid
    self.leftName = leftName or self.leftName
    self.rightName = rightName or self.rightName
    base.EnterRecordFight(self, index, notInBattle)
end

function BattleControllerSociatyBoss:CheckFight(call)
    self.checkCall = call
    if not self.IsRecord then
        local port = require("SociatyNet"):GetInstance():ChangllengeBossFight(
            { boss_id = self.id },
            _G.handler(self, self.OnFightMsgCall)
        )
        _G.BattleManager:GetInstance():AddLuaNetEvent(port)
    else
        _G.BattleManager:GetInstance():AddLuaNetEvent(_G.ConfigManager.net_map.game_guild_feast_review.PBCmd)
        require("SociatyBossNet"):GetInstance():Review({ log_id = self.id }, _G.handler(self, self.OnFightMsgCall))
    end
end

function BattleControllerSociatyBoss:OnFightMsgCall(msg)
    if msg.ack == 1 then
        self.mgCfg = _G.ConfigManager.monster_group_cfg[msg.fight_arg.sid]
        self.fightArg = msg.fight_arg
        --_G.CS.BattleManager.Inst:StrReceiveMsg(msg.fight_arg)
        self.checkCall(true)
        self.data = msg
    else
        self.checkCall(false, msg.ack)
    end
    self.checkCall = nil
end

---加载战斗(协程加载)
function BattleControllerSociatyBoss:OnLoadFight()
    local uiManager = _G.UIManager:GetInstance()
    --local loading= uiManager:OpenWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    --while (_G.IsNil(loading.View.gameObject)) do
    --    _G.coroutine.waitforendofframe()
    --end
    uiManager:CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)

    -- local showStartView = true
    -- _G.UIUtils.ProloadMaskVideo(
    --     "OpenDoor01",
    --     "OpenDoor01_mask",
    --     "Images/Bg/battlestartbg",
    --     function()
    --         showStartView = false
    --     end
    -- )
    -- while showStartView do
    --     _G.coroutine.waitforendofframe()
    -- end

    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    battleView.View:SetSettingBtnActive(true)
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)

    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SociatyMainView.Name)
    _G.BaseBattleManager:GetInstance():ClearView(false)
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(false)
    local battleManager = _G.BattleManager:GetInstance()
    local fighterSids
    if not self.IsRecord then
        fighterSids = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.sociatyBoss)
        battleManager:initAttackSids(
            fighterSids,
            _G.EBattleType.UnionBoss,
            true,
            0,
            0,
            nil,
            nil,
            nil,
            self.leftName,
            self.rightName
        )
    else
        battleManager:initAttackSids(
            self:GetFighterSids(),
            _G.EBattleType.UnionBoss,
            true,
            1,
            nil,
            nil,
            nil,
            nil,
            self.leftName,
            self.rightName
        )
    end
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    --_G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    battleView.View:SetCanvasGroupTrue()
    _G.coroutine.waitforendofframe()
end

