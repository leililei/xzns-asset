---重开战斗
function BattleControllerSociatyBoss:ReFight()
    _G.BattleManager:GetInstance():DestroyBattle()
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(true)
    local SociatyModel = require "SociatyModel"
    SociatyModel:GetInstance():ReEnterFight()
end

--- 退出关卡
function BattleControllerSociatyBoss:EndFight()
    _G.BattleManager:GetInstance():DestroyBattle()
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(true)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    local SociatyModel = require "SociatyModel"
    SociatyModel:GetInstance():ReturnPanel()
end

---获取怪物组ID
---@return number 怪物组ID
function BattleControllerSociatyBoss:GetMonsterGroupID()
