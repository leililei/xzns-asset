function BattleControllerSociatyBoss:GetFighterSids()
    local fighterSids = { 0, 0, 0, 0, 0 }
    local data = self.data.fight_arg.attacker_team[1].fights
    for i = 1, #data do
        fighterSids[data[i].index] = data[i].uid
    end
    return fighterSids
end

