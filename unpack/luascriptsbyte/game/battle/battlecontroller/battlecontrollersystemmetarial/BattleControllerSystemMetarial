---加载战斗(协程加载)
function BattleControllerSystemMetarial:OnLoadFight()
    local uiManager = _G.UIManager:GetInstance()
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    -- local view = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.LoadingView.Name).View
    -- while (_G.IsNil(view.gameObject)) or view.gameObject:GetActiveSelf() == 0 do
    --     _G.coroutine.waitforendofframe()
    -- end
    uiManager:HideWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    local view = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name).View
    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(view.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    -- 获取布阵信息
    local ebt = require("SystemMaterialController"):GetInstance():GetEBattleTypeWithSystemId(self.curSystem)
    local fighterSids = require("EmbattleModel"):GetInstance():GetEmbattleData(ebt)
    local battleManager = _G.BattleManager:GetInstance()
    battleManager:initAttackSids(
        fighterSids,
        ebt,
        true,
        0,
        0,
        nil,
        nil,
        nil,
        self.leftName,
        self.rightName
    )
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    uiManager:CloseWindow(_G.ConfigManager.ui_cfg.SystemMateriaEmbattleView.Name)
    _G.coroutine.waitforseconds(1)
    -- _G.BattleControllerBase.LoadFight(self)
    uiManager:ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    uiManager:CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, self.mgCfg.audio)

    view:SetCanvasGroupTrue()
end

