-----检测是否可以进入战斗
---@param callback function 检测后的回调(参数bool)
function BattleControllerSystemMetarial:CheckFight(call)
    self.curSystem = require "SystemMaterialController":GetInstance().curChooseMaterialID
    local cfg = _G.ConfigManager.system_material_cfg[self.curMetarialID]
    if self.curSystem == 105 then
        cfg = _G.ConfigManager.system_prof_cfg[self.curMetarialID]
    end

    if not cfg then
        call(false, "配置表未找到")
        return
    end
    self.checkCall = call
    --region --------------------------------------方便战斗结束广播任务信息--------

    self.curDifficulty = cfg.difficulty
    --endregion------------------------------------方便战斗结束广播任务信息--------
    local port = fightMsg[self.curSystem](self.curMetarialID, _G.handler(self, self.OnFightMsgCall))
    _G.BattleManager:GetInstance():AddLuaNetEvent(port)
end

function BattleControllerSystemMetarial:OnFightMsgCall(msg)
    if msg.ack == 1 then
        self.mgCfg = _G.ConfigManager.monster_group_cfg[msg.fight_arg.sid]
        self.fightArg = msg.fight_arg
        --_G.CS.BattleManager.Inst:StrReceiveMsg(msg.fight_arg)
        self.checkCall(true)
    else
        self.checkCall(false, msg.ack)
    end
    self.checkCall = nil
end

