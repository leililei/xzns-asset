---@class BattleControllerSystemMetarial:BattleControllerBase	中文描述
local BattleControllerSystemMetarial = _G.BaseClass("BattleControllerSystemMetarial", _G.BattleControllerBase)

local fightMsg = {
    [101] = function(id, callback)
        return require("SystemMaterialNet"):GetInstance():GoldFight(id, callback)
    end,
    [102] = function(id, callback)
        return require("SystemMaterialNet"):GetInstance():UpgradeFight(id, callback)
    end,
    [103] = function(id, callback)
        return require("SystemMaterialNet"):GetInstance():EquipmentMaterailFight(id, callback)
    end,
    [105] = function(id, callback)
        return require("StarSoulNet"):GetInstance():FightBoss({sid = id}, callback)
    end,
    [106] = function(id, callback)
        return require("SystemMaterialNet"):GetInstance():GemFight(id, callback)
    end
}

---类的构造函数
function BattleControllerSystemMetarial:__init()
    self.cmd = {
        [101] = _G.ConfigManager.net_map.game_instance_gold_fight.PBCmd,
        [102] = _G.ConfigManager.net_map.game_instance_upgrade_fight.PBCmd,
        [103] = _G.ConfigManager.net_map.game_instance_equipment_material_fight.PBCmd,
        [105] = _G.ConfigManager.net_map.game_system_prof_fight.PBCmd,
        [106] = _G.ConfigManager.net_map.game_instance_gem_fight.PBCmd,
    }
end

