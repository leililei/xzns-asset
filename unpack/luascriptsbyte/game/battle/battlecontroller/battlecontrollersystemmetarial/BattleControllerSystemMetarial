---战斗结束
---@param tab table 战斗数据
function BattleControllerSystemMetarial:OnFightResult(tab, call)
    require("BattleNet"):GetInstance():NpcPVEFightResult(
        tab,
        function(data, error)
            if _G.string.IsNullOrEmpty(error) and data.ack == 1 then
                if data.md5_error == "1" then
                    _G.PopWindowManager:GetInstance():ShowAllTips(44)
                    _G.BattleManager:GetInstance():SaveLogNew()
                elseif data.md5_error == "2" then
                    _G.BattleManager:GetInstance():SaveLogNew()
                end
                local result = data.winner[1]
                self.curSettlementMsg = {result = result, data = data}
                call()

                --region --------------------------------------任务广播 不同类型的材料副本通关指定层数--------

                if result then
                    _G.Events:GetInstance():Broadcast(
                        _G.ePlayAactionEvent.PlayAaction,
                        {
                            _G.ActiveTaskEnum.ConditionEnum.Section.materialDifficulty,
                            self.curSystem,
                            self.curDifficulty
                        },
                        1,
                        false,
                        true
                    )
                end

            --endregion------------------------------------任务广播 不同类型的材料副本通关指定层数--------

            -- self:Settlement({result = data.winner, data = data})
            end
        end
    )
end

---结算
---@param 变量名 变量类型 中文描述
---@return 变量类型 中文描述
function BattleControllerSystemMetarial:OnSettlement(call)
    local fbTypeID = self.curMetarialID
    if self.curSettlementMsg.result == true then
        _G.Events:GetInstance():Broadcast(
            _G.ePlayAactionEvent.PlayAaction,
            {_G.ActiveTaskEnum.ConditionEnum.Section.materialAssignLayer, self.curSystem, self.curDifficulty},
            1
        )
    end
    call(_G.SettlementModel.SettlementType.systemMetarial, self.curSettlementMsg, self.fightArg)
end

---战斗退出
function BattleControllerSystemMetarial:OnSettlementEnd()
    -- _G.BattleControllerBase.FightExit(self)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    self.curSettlementMsg = nil
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    if self.curBattleEndCall then
        self.curBattleEndCall()
    end
    self.curBattleEndCall = nil
    require("SystemMaterialController"):GetInstance():OnFightEnd()
end

---退出到主城
---@param call function 退出到主城时的回调
function BattleControllerSystemMetarial:QuitToMainWorld(call)
    _G.BattleControllerBase.FightExit(self)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    call()
end

