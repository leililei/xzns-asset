--endregion
---加载战斗(协程加载)
function BattleControllerSystemMetarial:OnLoadRecordFight()
    -- 获取布阵信息
    local SystemMaterialController = require "SystemMaterialController":GetInstance()
    if self.curSystem == nil then
        self.curSystem = SystemMaterialController.curChooseMaterialID
    end
    local ebt = SystemMaterialController:GetEBattleTypeWithSystemId(self.curSystem)
    local fighterSids = require("EmbattleModel"):GetInstance():GetEmbattleData(ebt)
    _G.BattleManager:GetInstance():initAttackSids(
        fighterSids,
        ebt,
        true,
        1,
        0,
        nil,
        nil,
        nil,
        self.leftName,
        self.rightName
    )
    if self.mgCfg == nil then
        local systemMaterialModel = SystemMaterialController:GetCurModel()
        local sid = SystemMaterialController:GetCurChallengeSid()
        self.mgCfg = _G.ConfigManager.monster_group_cfg[systemMaterialModel:GetMonster(sid)]
    end
    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, self.mgCfg.audio)
end

---子类重写是否显示战斗回放按钮
function BattleControllerSystemMetarial:CheckShowRecordBattle()
    if self.curSystem == 105 then
        return true
    end
    return false
end

