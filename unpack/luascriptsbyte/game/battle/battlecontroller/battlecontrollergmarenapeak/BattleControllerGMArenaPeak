local GMArenaPeakModel = require("GMArenaPeakModel")
local base = require "BattleControllerBase"
---@class BattleControllerGMArenaPeak:BattleControllerBase	中文描述
local BattleControllerGMArenaPeak = _G.BaseClass("BattleControllerGMArenaPeak", base)

---类的构造函数
function BattleControllerGMArenaPeak:__init()
    self.testBack = false 
end

---类的析构函数
function BattleControllerGMArenaPeak:Dispose()
end

function BattleControllerGMArenaPeak:CheckFight(call)
    self.checkCall = call
    local port = require("GMArenaPeakNet"):GetInstance():Fight(_G.handler(self, self.OnFightMsgCall))
    _G.BattleManager:GetInstance():AddLuaNetEvent(port)
end

---@param msg arena_peak.s2c_arena_peak_fight
function BattleControllerGMArenaPeak:OnFightMsgCall(msg)
    self.result = msg
    if msg.ack == 1 then
        GMArenaPeakModel:GetInstance():FightHandler(msg)
        self.mgCfg = _G.ConfigManager.monster_group_cfg[msg.fight_arg.sid]
        self.checkCall(true)
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("巅峰演武战斗异常, ack=" .. msg.ack)
        end
        self.checkCall(false, msg.ack)
    end
    self.checkCall = nil
end

---加载战斗
function BattleControllerGMArenaPeak:LoadFight()
    self.testBack = require("GMArenaPeakModel"):GetInstance():GetBackIng()
    local world = _G.ePoolType.World
    _G.BattleManager:GetInstance():SetPoolName(world, world, world, world, world)
    self.isMonsherShow = false
    if self.testBack then 
        self.isMonsherShow = true
    else 
        _G.GlobalInterface.OpenMonsterShow(_G.handler(self, self.StartFightNew), self:GetMonsterGroupID())
    end
    --_G.GlobalInterface.OpenMonsterShow(_G.handler(self, self.StartFightNew), self:GetMonsterGroupID())
    --延时一帧的目的是为了保证布阵场景和战斗角色都放入传递到战斗的节点下
    _G.coroutine.waitforendofframe()
    --调用init方法c#战斗开始加载资源了
    self:OnLoadFight()
    self:StartFightNew()
end

