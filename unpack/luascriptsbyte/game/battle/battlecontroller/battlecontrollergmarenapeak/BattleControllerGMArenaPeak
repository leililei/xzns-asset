---加载战斗(协程加载)
function BattleControllerGMArenaPeak:OnLoadRecordFight(index, notInBattle, leftName, rightName)
    self.leftName = leftName or self.leftName
    self.rightName = rightName or self.rightName
    local recordType = notInBattle and 2 or 1
    _G.BattleManager:GetInstance():initAttackSids(nil, nil, true, recordType, 0, nil, nil, nil, self.leftName, self.rightName)
    if notInBattle then
        while _G.BattleManager:GetInstance().Progress < 1 do
            _G.coroutine.waitforendofframe()
        end
    end
    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, 1009)
end
----检测数据统计是否显示回放战斗
function BattleControllerGMArenaPeak:CheckShowRecordBattle()
    return true
end

function BattleControllerGMArenaPeak:EnterRecordFight(index, notInBattle, sid, leftName, rightName)
    self.leftName = leftName or self.leftName
    self.rightName = rightName or self.rightName
    self.notInBattle = notInBattle
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
    self:StartLoadingRecordFight(index, false)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ChatDefultRootView.Name)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.GMArenaPeakSettlementView.Name)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
end

