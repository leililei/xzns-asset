---回放战斗退出
function BattleControllerBase:FightRecordExit()
    local BattleManagerIns = _G.BattleManager:GetInstance()
    BattleManagerIns:SetInRecordBattle(false)
    BattleManagerIns:SetInBattle(false)
    if self.notInBattle then
        local scene = _G.WorldManager:GetInstance().CurrentWorld
        if scene then
            _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, scene.Cfg.audio)
        end
        BattleManagerIns:DestroyBattle()
        Switch3DUICamClearFlags(_G.CS.UnityEngine.CameraClearFlags.Nothing)
        local window = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name)
        if window then
            window:ShowSelfAndShowAwardView(true)
        end
        _G.Events:GetInstance():Broadcast(_G.eBattleState.RecordEnd)
    else
        BattleManagerIns:SetBattlePause(true)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
        local window = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name)
        if window then
            window:ShowSelfAndShowAwardView(true)
        end
    end
    -- _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ChatDefultRootView.Name)
end

--region战斗流程
---处理传参
---@param ... table 动态参数
function BattleControllerBase:HandleParams(...)
    self:OnHandleParams(...)
    self:CheckFight(_G.handler(self, self.CheckEndCall))
end

---检测战斗结果返回
---@param fight boolean 是否可以战斗
---@param msg string 如不能进入战斗，返回的错误信息
function BattleControllerBase:CheckEndCall(fight, msg)
    if fight then
        local world = _G.WorldManager:GetInstance():GetCurWorld()
        if world then
            world:ResetObjectAlphaEffect()
        end
        self:StartLoading()
    else
        self.curFightState = fightState.none
        _G.WorldManager:GetInstance():DespawnRoleParent()
        self:OnCheckFail(msg)
        _G.BattleManager:GetInstance():SetBattleController(nil)
    end
end

---协程加载
function BattleControllerBase:StartLoading()
    self.curFightState = fightState.load
    local BattleManagerIns = _G.BattleManager:GetInstance()
    BattleManagerIns:SetInBattle(true)
    BattleManagerIns:SetRoleParent(_G.WorldManager:GetInstance():GetRoleParent())
    self.stopCoProgress = _G.coroutine.start(_G.handler(self, self.LoadFight))
    self:DoStartGC()
end

---调用GC（没有loading的战斗可重写不走gc，保证流畅度）
function BattleControllerBase:DoStartGC()
    _G.CollectGarbageLua()
end

---调用GC（没有loading的战斗可重写不走gc，保证流畅度）
function BattleControllerBase:DoEndGC()
    _G.CollectGarbageLua()
end

---加载战斗
function BattleControllerBase:LoadFight()
    local world = _G.ePoolType.World
    _G.BattleManager:GetInstance():SetPoolName(world, world, world, world, world)
    self.isMonsherShow = false
    _G.GlobalInterface.OpenMonsterShow(_G.handler(self, self.StartFightNew), self:GetMonsterGroupID())
    --延时一帧的目的是为了保证布阵场景和战斗角色都放入传递到战斗的节点下
    _G.coroutine.waitforendofframe()
    --调用init方法c#战斗开始加载资源了
    self:OnLoadFight()
    self:StartFightNew()
end

---开始战斗
function BattleControllerBase:StartFight()
    self.curFightState = fightState.start
    Switch3DUICamClearFlags(_G.CS.UnityEngine.CameraClearFlags.Depth)
    require("EmbattleController"):GetInstance():ClearEmbattleEffect()
    self:OnStart()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
    _G.Events:GetInstance():Broadcast(_G.FightPlayState.FightStart)
end

---战斗开始(不需重写)
function BattleControllerBase:StartFightNew()
    if not self.isMonsherShow then
        self.isMonsherShow = true
        return
    end
    self:StartFight()
    if not _G.BattleManager:GetInstance():GetInRecordBattle() and _G.PlayerModel:GetInstance():CheckCreateRole() then
        _G.GameUtil.ChangeDefulfRootSize()
        _G.GameUtil.ChangeChatDefultLayer()
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ChatDefultRootView.Name, { x = 45, y = 108 })
        -- _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ChatDefultRootView.Name)
    end
end

---结算
function BattleControllerBase:Settlement()
    if self.curFightState < fightState.over then
        self.curFightState = fightState.over
        return
    end
    self:OnSettlement(_G.handler(self, self.StartSettlement))
end

---开始结算
---@param lua string 结算脚本名
---@param ... any 其他参数
function BattleControllerBase:StartSettlement(lua, ...)
    _G.SettlementModel:GetInstance():Settlement(lua, _G.handler(self, self.OnSettlementEndCall), ...)
end

---结算界面关闭回调
---@param result boolean 是否胜利
---@param id SettlementModel.FunctionEnum 关闭回调参数
function BattleControllerBase:OnSettlementEndCall(result, id)
    self:FightExit()
    local funid = require("SettlementModel").FunctionEnum
    id = id or funid.None
    if id == funid.None then
        self:OnSettlementEnd(result)
    elseif id == funid.Continue then
        self:OnChallengeContinue()
    elseif id == funid.Next then
        self:OnChallengeNext()
    elseif id == funid.DevelopRole or id == funid.DevelopEquip then
        self:QuitToMainWorld(_G.handler(self, self.OpenCardBagView))
    elseif id == funid.ReEmbattle then
        self:OnReEmbattle()
    elseif id == funid.Back then
        self:OnSettlementEnd(result)
        self:OnSettlementBack()
    end
end

