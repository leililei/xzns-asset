---加载回放战斗
function BattleControllerBase:LoadRecordFight(index, notInBattle)
    local CreateStartEff
    CreateStartEff = function(_, name)
        if name == _G.ConfigManager.ui_cfg.LoadingView.Name then
            if self:IsShowEffect() then
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.BattleStartEffect,
                    _G.UIManager:GetInstance():GetUILayerTrans("TopLayer"),
                    function()
                    end,
                    function()
                        if notInBattle then
                            while (_G.BattleManager:GetInstance().Progress ~= 1) do
                                _G.coroutine.waitforendofframe()
                            end
                        end
                        self:StartRecordFight(notInBattle)
                    end
                )
            else
                if notInBattle then
                    while (_G.BattleManager:GetInstance().Progress ~= 1) do
                        _G.coroutine.waitforendofframe()
                    end
                end
                self:StartRecordFight(notInBattle)
            end
            _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, CreateStartEff, self)
        end
    end
    local uiManager = _G.UIManager:GetInstance()
    local battleView
    if notInBattle then
        local world = _G.ePoolType.World
        _G.BattleManager:GetInstance():SetPoolName(world, world, world, world, world)
        _G.coroutine.waitforendofframe()
        local battleStartView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.LoadingView.Name).View
        while (_G.IsNil(battleStartView.gameObject)) do
            _G.coroutine.waitforendofframe()
        end

        battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name).View
        -- 等待 战斗窗口 加载完成
        while (_G.IsNil(battleView.gameObject)) do
            _G.coroutine.waitforendofframe()
        end
        battleView:Hide()
        self:OnLoadRecordFight(index, notInBattle)
        battleView:SetSettingBtnActive(true)
        _G.coroutine.waitforendofframe()
        battleView:SetCanvasGroupTrue()
        _G.BattleManager:GetInstance():SetBattlePause(true)
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, CreateStartEff, self)
        battleStartView:Close()
    else
        battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name).View
        -- 等待 战斗窗口 加载完成
        while (_G.IsNil(battleView.gameObject)) do
            _G.coroutine.waitforendofframe()
        end
        battleView:Hide()
        self:OnLoadRecordFight(index)
        if _G.AppSetting.IsAlipay then
            local conditions = _G.ConfigManager.discrete_cfg[126101]
            battleView:SetSpeedBtnActive(_G.GlobalConditionManager.CheckCondition(conditions[1][2],conditions[1][3]))
        else
            battleView:SetSpeedBtnActive(_G.FunctionManager:GetInstance():CheckFunctionIsUnlock(30))
        end
        _G.coroutine.waitforendofframe()
        battleView:SetCanvasGroupTrue()
        _G.BattleManager:GetInstance():SetBattlePause(true)
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.BattleStartEffect,
            _G.UIManager:GetInstance():GetUILayerTrans("TopLayer"),
            function()
            end,
            function()
                self:StartRecordFight()
            end
        )
    end
end

---开始回放战斗
function BattleControllerBase:StartRecordFight(notInBattle)
    if notInBattle then
        Switch3DUICamClearFlags(_G.CS.UnityEngine.CameraClearFlags.Depth)
        self.OnStartRecordFight()
    else
        _G.BattleManager:GetInstance():SetPauseBtnState(0, 1, 1)
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
        _G.BattleManager:GetInstance():SetBattlePause(true)
        _G.BattleManager:GetInstance():SetBattleStart()
        _G.BattleManager:GetInstance():ShowBattleTeam()
    end
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
    _G.Events:GetInstance():Broadcast(_G.FightPlayState.FightStart)
end

---回放战斗开始
function BattleControllerBase:OnStartRecordFight()
    local uimanager = _G.UIManager:GetInstance()
    uimanager:ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    local view = uimanager:GetWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    if view then
        view.View:SetAutoBtnActive(false)
        view.View.AtActive = false
    end
    _G.BattleManager:GetInstance():SetPauseBtnState(0, 1, 1)
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()
    _G.BattleManager:GetInstance():ShowBattleTeam()
end

