---回放战斗结束
function BattleControllerBase:OnFightRecordResult()
    _G.BattleManager:GetInstance():HideBattleViewExceptTips()
    --_G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    if self._fightResult == true then
        self:CreateRecordFightEff(_G.ConfigManager.ui_effect_cfg.BattleVictory)
    elseif self._fightResult == false then
        self:CreateRecordFightEff(_G.ConfigManager.ui_effect_cfg.BattleFail)
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("战斗控制器未在结算保存战斗结果")
        end
    end
end

