---加载战斗(协程加载)
function BattleControllerBagAlone:OnLoadFight()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    self.Loaded = false
    self.ShowEnd = false
    self.State = nil
    local uiManager = _G.UIManager:GetInstance()
    uiManager:CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)

    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)

    -- local showStartView = true
    -- _G.UIUtils.ProloadMaskVideo(
    --     "OpenDoor01",
    --     "OpenDoor01_mask",
    --     "Images/Bg/battlestartbg",
    --     function()
    --         showStartView = false
    --     end
    -- )
    -- while showStartView do
    --     _G.coroutine.waitforendofframe()
    -- end

    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)

    _G.BaseBattleManager:GetInstance():ClearView(false)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    -- 获取布阵信息
    local battleManager = _G.BattleManager:GetInstance()
    if self.isStoryBattle then
        battleManager:BeginTestBattle(self.scene, true, self.attackUids, self.defenceSids, self.curBattleType)
    else
        if not self.isAllBag then
            battleManager:SetArgData(self.data.arg)
        end
        battleManager:initAttackSids(self:GetFighterSids(), 0, true, 0, 0, 0, "")
    end

    self.mgCfg = _G.ConfigManager.monster_group_cfg[self.scene]
    if self.Setting then
        if self.Setting.AllSkill == 1 then
            battleManager:SetAutoMasterSkill(0, false)
            battleManager:SetAutoMasterSkill(1, false)
        else
            battleManager:SetAutoMasterSkill(0, self.Setting.MySkill ~= 1)
            battleManager:SetAutoMasterSkill(1, self.Setting.OtherSkill ~= 1)
        end
    end
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    battleView.View:SetCanvasGroupTrue()
end

---获取战斗参数
function BattleControllerBagAlone:GetFightArg(id, AttackUids, DefenceSids)
    local comb = require "CombineModel":GetInstance():GetUnLockCombine()
    local cardSkill = {0, 0, 0}
    for i = 1, #self.testSelfCombSkill do
        if self.testSelfCombSkill[i] > 0 then
            local lv = comb[self.testSelfCombSkill[i]]
            cardSkill[i] = _G.ConfigManager.combine_cfg[self.testSelfCombSkill[i]].skills[lv]
        else
            cardSkill[i] = 0
        end
    end
    local tb = {
        ["sid"] = id,
        ["fight_type"] = _G.EBattleType.TestAlone,
        fight_cmd = {},
        ["seed"] = _G.TimeUtil.GetServerUnixTime() + _G.math.random(0, 100),
        ["auto"] = true,
        ["attacker_team"] = {
            [1] = {
                ["fighter_type"] = 0,
                ["fights"] = self:GetFights(AttackUids),
                ["lv"] = _G.PlayerModel:GetInstance():GetLevel(),
                ["name"] = _G.PlayerModel:GetInstance().role_name,
                ["power"] = _G.StorageManager:GetInstance():GetPlayerPower(),
                ["team_num"] = 1,
                ["combine_skill"] = cardSkill
            }
        }
    }
    return tb
end
function BattleControllerBagAlone:GetFights(cards)
    local index = 1
    local posIndex = 1
    local tb = {}

    for i = 1, 5 do
        if cards[i] > 10 then
            ---@type CardData
            local data
            local prop
            if self.isStoryBattle then
                data = _G.StorageManager:GetInstance():GetItemDataClass(cards[i])
                prop = _G.ConfigManager.monster_cfg[self.cfg.DefaultAttackerSids[i]]
            else
                data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, cards[i])
                prop = data
            end

            tb[index] = {
                ["attrs"] = {
                    ["air_d_r"] = self:GetValueByName(prop, "air_d_r") * 10000,
                    ["air_dmg"] = self:GetValueByName(prop, "air_dmg") * 10000,
                    ["atk"] = self:GetValueByName(prop, "atk"),
                    ["avd_rate"] = self:GetValueByName(prop, "avd_rate") * 10000,
                    ["bre"] = self:GetValueByName(prop, "bre"),
                    ["cri_dmg"] = self:GetValueByName(prop, "cri_dmg") * 10000,
                    ["cri_dmg_r"] = self:GetValueByName(prop, "cri_dmg_r") * 10000,
                    ["cri_r_rate"] = self:GetValueByName(prop, "cri_r_rate") * 10000,
                    ["cri_rate"] = self:GetValueByName(prop, "cri_rate") * 10000,
                    ["def"] = self:GetValueByName(prop, "def"),
                    ["dmg_inc"] = self:GetValueByName(prop, "dmg_inc") * 10000,
                    ["earth_d_r"] = self:GetValueByName(prop, "earth_d_r") * 10000,
                    ["earth_dmg"] = self:GetValueByName(prop, "earth_dmg") * 10000,
                    ["fire_d_r"] = self:GetValueByName(prop, "fire_d_r") * 10000,
                    ["fire_dmg"] = self:GetValueByName(prop, "fire_dmg") * 10000,
                    ["hit_rate"] = self:GetValueByName(prop, "hit_rate") * 10000,
                    ["mag_d_r"] = self:GetValueByName(prop, "mag_d_r") * 10000,
                    ["max_hp"] = self:GetValueByName(prop, "max_hp"),
                    ["power"] = self:GetValueByName(prop, "power"),
                    ["psy_d_r"] = self:GetValueByName(prop, "psy_d_r") * 10000,
                    ["speed"] = 4,
                    ["pvp_dmg"] = self:GetValueByName(prop, "pvp_dmg") * 10000,
                    ["pvp_dmg_r"] = self:GetValueByName(prop, "pvp_dmg_r") * 10000,
                    ["recover_rate"] = self:GetValueByName(prop, "recover_rate") * 10000,
                    ["recover_suffer"] = self:GetValueByName(prop, "recover_suffer") * 10000,
                    ["all_speed"] = self:GetValueByName(prop, "all_speed") * 10000,
                    ["control_dec"] = self:GetValueByName(prop, "control_dec") * 10000,
                    ["thd_d_r"] = self:GetValueByName(prop, "thd_d_r") * 10000,
                    ["thd_dmg"] = self:GetValueByName(prop, "thd_dmg") * 10000,
                    ["water_d_r"] = self:GetValueByName(prop, "water_d_r") * 10000,
                    ["water_dmg"] = self:GetValueByName(prop, "water_dmg") * 10000
                },
                ["index"] = posIndex,
                ["lv"] = data.lv,
                ["order"] = data.Grade,
                ["sid"] = data.sid,
                ["skills"] = self:GetSkill(data),
                ["soul_chain_lv"] = data.soulLink_lv,
                ["soul_state"] = data.soulLink_IsActivate,
                ["star"] = data.star,
                ["uid"] = data.uid and "" .. data.uid .. i or "" .. data.sid .. i,
                ["fighter_type"] = 0
            }
            index = index + 1
        end
        posIndex = posIndex + 1
    end
    return tb
end

function BattleControllerBagAlone:GetValueByName(data, key)
    if self.isStoryBattle then
        return data[key] or 0
    else
        return data.NowSumProp:GetValueByName(key)
    end
end

---@param data CardData
function BattleControllerBagAlone:GetSkill(data)
    local tb = {}
    for i = 1, 4 do
        local SkillId = data.sid + i * 100 + 1
        local skillcfg = _G.ConfigManager.card_skills_cfg[SkillId]
        if skillcfg ~= nil then
            --SkillId = skillcfg.skills[1]
            tb[i] = SkillId
        end
    end
    return tb
end

---战斗开始
function BattleControllerBagAlone:OnStart()
    local uiManager = _G.UIManager:GetInstance()
    uiManager:ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    _G.NormalBagAloneManager:GetInstance():SaveEmbattleData(self.attackUids, self.defenceSids, self.scene)
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()
    _G.BattleManager:GetInstance():ShowBattleTeam()
end

---战斗结束
---@param tab table 战斗数据
function BattleControllerBagAlone:OnFightResult(tab, call)
    if _G.AppSetting.DEBUG then
        _G.Log(tab, "爬塔战斗结束")
    end
    self.FightResult = tab
    if call then
        call()
    end
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
end

---结算
---@param msg table 结算数据
function BattleControllerBagAlone:OnSettlement(call)
    call(_G.SettlementModel.SettlementType.bagAlone, self.FightResult)
end

---战斗退出
function BattleControllerBagAlone:OnSettlementEnd()
    _G.BaseBattleManager:GetInstance():ClearView(true)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, false)
    _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
    self.curSettlementMsg = nil

    _G.NormalBagAloneManager:GetInstance():EnterEmbattle(_G.EBattleType.NormalBagAlone)
end

---手动停止战斗
function BattleControllerBagAlone:EndFight()
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.CS.UnityEngine.Time.timeScale = 1
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
        function()
            _G.BaseBattleManager:GetInstance():ClearView(true)
            self:FightExit()
            self:OnSettlementEnd()
        end,
        false,
        nil,
        false
    )
end

---重新开始战斗
function BattleControllerBagAlone:ReFight()
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.CS.UnityEngine.Time.timeScale = 1
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    _G.BaseBattleManager:GetInstance():ClearView(false)
    self:FightExit()
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, false)

    _G.NormalBagAloneManager:GetInstance():EnterEmbattle(_G.EBattleType.NormalBagAlone)
end

return BattleControllerBagAlone
