---处理传参
---@param towerId number 爬塔id
---@param atkUid table 布阵数据(传入 则替换掉当前 不传则采用当前数据)
---@param Setting BattleEmbattleSetting 战斗设置
function BattleControllerBagAlone:HandleParams(
    type,
    AttackUids,
    DefenceSids,
    scene,
    Setting,
    testSelfCombSkill,
    testEnemyCombSkill,
    testSelfPetSkill,
    testEnemyPetSkill)
    self.curBattleType = type
    self.attackUids = AttackUids
    self.defenceSids = DefenceSids
    self.scene = scene
    self.Setting = Setting
    self.testSelfCombSkill = testSelfCombSkill
    self.testEnemyCombSkill = testEnemyCombSkill
    self.testSelfPetSkill = testSelfPetSkill
    self.testEnemyPetSkill = testEnemyPetSkill
    self.isAllBag = self:CheckUids()
    self.cfg = _G.ConfigManager.monster_group_cfg[scene]
    self.isStoryBattle = self.cfg.battle_type == 1
    self.super.HandleParams(self)
end

-----检测是否可以进入战斗
function BattleControllerBagAlone:CheckFight(call)
    if self.isAllBag then
        self.checkCall = call
        self.defenceSids = self.defenceSids[1]
        local msg = {}
        msg.sid = self.scene
        local atks = {
            self.attackUids[1],
            self.attackUids[2],
            self.attackUids[3],
            self.attackUids[4],
            self.attackUids[5]
        }
        local defs = {
            self.defenceSids[1],
            self.defenceSids[2],
            self.defenceSids[3],
            self.defenceSids[4],
            self.defenceSids[5]
        }
        local atkCombineSkill = self.testSelfCombSkill
        local defCombineSkill = self.testEnemyCombSkill
        --TODO: 合击技暂时默认写0
        msg.atk_team = {
            {["id"] = 1, ["sits"] = atks, ["skill_index"] = atkCombineSkill, pet = self.testSelfPetSkill or { 0, 0, 0 }}
        }
        msg.def_team = {
            {["id"] = 1, ["sits"] = defs, ["skill_index"] = defCombineSkill, pet = self.testEnemyPetSkill or { 0, 0, 0 }}
        }
        --msg.atk_team = {
        --    self.attackUids[1],
        --    self.attackUids[2],
        --    self.attackUids[3],
        --    self.attackUids[4],
        --    self.attackUids[5],
        --}
        --msg.def_team = {
        --    self.defenceSids[1],
        --    self.defenceSids[2],
        --    self.defenceSids[3],
        --    self.defenceSids[4],
        --    self.defenceSids[5],
        --}
        local port = require("BattleNet"):GetInstance():TestFightRole(msg, _G.handler(self, self.OnFightMsgCall))
        _G.BattleManager:GetInstance():AddLuaNetEvent(port)
    else
        self.data = {}
        self.data.arg = self:GetFightArg(self.scene, self.attackUids, self.defenceSids[1])
        call(true)
    end
end

function BattleControllerBagAlone:CheckUids()
    for _, v in pairs(self.defenceSids[1]) do
        if v > 0 and _G.string.len(tostring(v)) > 11 then
            return true
        end
    end
    return false
end

function BattleControllerBagAlone:OnFightMsgCall(msg)
    if msg.ack == 1 then
        --_G.CS.BattleManager.Inst:StrReceiveMsg(msg.arg)
        self.data = msg
        self.checkCall(true)
    else
        self.checkCall(false, msg.ack)
    end
    self.checkCall = nil
end

