---@class BattleControllerMonsterSiege : Singleton	中文描述
local BattleControllerMonsterSiege = _G.BaseClass("BattleControllerMonsterSiege", _G.BattleControllerBase)

---@return BattleControllerMonsterSiege BattleControllerMonsterSiege
function BattleControllerMonsterSiege:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function BattleControllerMonsterSiege:__init()
end

---销毁对象时,析构函数
function BattleControllerMonsterSiege:Dispose()
end
---获取怪物组ID
function BattleControllerMonsterSiege:GetMonsterGroupID()
    return self.mgCfg.id
end

-----------------------------  开始 进入 战斗 检测 ------------------------
---处理传参
---@param towerId number 爬塔id
---@param atkUid table 布阵数据(传入 则替换掉当前 不传则采用当前数据)
function BattleControllerMonsterSiege:OnHandleParams(damage, callback)
    self.damage = damage
    self.showFlag = false
    self.isShowAudience = false
end
---进入战斗 (检测是否进入战斗)
function BattleControllerMonsterSiege:CheckFight(call)
    self.checkCall = call

    if _G.AppSetting.DEBUG then
        _G.Log("怪物攻城", "战斗事件id>>>>>>")
    end
    require "MonsterSiegeManager":GetInstance():SiegeFight(_G.handler(self, self.OnFightMsgCall))
end

function BattleControllerMonsterSiege:OnFightMsgCall(msg)
    if msg.ack == 1 then
        self.mgCfg = _G.ConfigManager.monster_group_cfg[msg.fight_arg.sid]
        self.isShowAudience = _G.BattleManager:GetInstance():IsBossType(msg.fight_arg.sid)
        -- if self.isShowAudience then
        --     require "BattleDamageRankManager":GetInstance():InitData(msg.siege)
        --     require "BattleAudienceManager":GetInstance():InitData(msg.siege)
        if self.showFlag then
            --         require "BattleAudienceManager":GetInstance():ShowAudience()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BattleDamageRankView.Name)
        end
        -- end
        self.checkCall(true)
    else
        if _G.AppSetting.DEBUG then
            _G.Log("怪物攻城ack == 0")
        end
        self.checkCall(false, msg.ack)
    end
    self.checkCall = nil
end

---战斗验证不通过
function BattleControllerMonsterSiege:OnCheckFail(msg)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.MainSiegeEmbattleView.Name)
    self.super.OnCheckFail(self)
end

---加载战斗(协程加载)
function BattleControllerMonsterSiege:OnLoadFight()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainSiegeView.Name)
    -- local loading = _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    -- while (_G.IsNil(loading.View.gameObject)) do
    --     _G.coroutine.waitforendofframe()
    -- end
    self.Loaded = false
    self.ShowEnd = false
    self.State = nil
    local uiManager = _G.UIManager:GetInstance()
    --uiManager:CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)
    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)

    _G.BaseBattleManager:GetInstance():ClearView(false)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    -- 获取布阵信息
    local battleManager = _G.BattleManager:GetInstance()

    local id = _G.EBattleType.MonsterSiegeCacodemon
    battleManager:initAttackSids(
        require("EmbattleModel"):GetInstance():GetEmbattleData(id),
        _G.EmbattleType.MonsterSiege,
        true,
        0,
        0,
        nil,
        nil,
        self.damage
    )
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.MainSiegeEmbattleView.Name)
    --_G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    _G.coroutine.waitforendofframe()
    battleView.View:SetCanvasGroupTrue()
end
---战斗开始
function BattleControllerMonsterSiege:OnStart()
    -- self.super.OnStart(self)
    local uiManager = _G.UIManager:GetInstance()
    uiManager:ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()
    _G.BattleManager:GetInstance():ShowBattleTeam()
end
---战斗结束
---@param tab table 战斗数据
function BattleControllerMonsterSiege:OnFightResult(tab, call)
    self.FightResult = tab
    -- self:Settlement(tab)
    -- _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    call()
end
---结算
---@param msg table 结算数据
function BattleControllerMonsterSiege:OnSettlement(call)
    call(_G.SettlementModel.SettlementType.MonsterSiege, self.FightResult, self.mgCfg, self.isShowAudience)
end
---战斗退出
function BattleControllerMonsterSiege:OnSettlementEnd(win)
    _G.BaseBattleManager:GetInstance():ClearView(true)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
    _G.WorldManager:GetInstance():DespawnRoleParent()
    require "BattleAudienceManager":GetInstance():ClearAudiences()
    --断线重连会打开主界面
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    if window then
        window.View:Hide()
    end
    local model_monsterid = require "MonsterSiegeManager":GetInstance().monsterid_model
    _G.Events:GetInstance():Broadcast(_G.WorldItemManager.ItemEvent.enemyBattleDone, win, model_monsterid)
    self.curSettlementMsg = nil
end

---手动停止战斗
function BattleControllerMonsterSiege:EndFight()
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.CS.UnityEngine.Time.timeScale = 1
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    _G.WorldManager:GetInstance():DespawnRoleParent()
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleDamageRankView.Name)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
        function()
            _G.BaseBattleManager:GetInstance():ClearView(true)
            self:FightExit()
            self:OnSettlementEnd()
            require("MonsterSiegeManager"):GetInstance():ExitEmbattle()
        end
    )
end
---重新开始战斗
function BattleControllerMonsterSiege:ReFight()
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.CS.UnityEngine.Time.timeScale = 1
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    _G.WorldManager:GetInstance():DespawnRoleParent()
    _G.BaseBattleManager:GetInstance():ClearView(false)
    self:FightExit()
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, false)
    require("MonsterSiegeManager"):GetInstance():EnterEmbattle()
end
---加载观众
function BattleControllerMonsterSiege:ShowAudience()
    if self.isShowAudience then
        -- require "BattleAudienceManager":GetInstance():ShowAudience()
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BattleDamageRankView.Name)
    else
        self.showFlag = true
    end
end
---退出到主城 (失败,)
---@param call function 退出到主城时的回调
function BattleControllerMonsterSiege:QuitToMainWorld(call)
    if call then
        call()
    end
end
