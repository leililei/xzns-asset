local SystemFairylandModel = require("SystemFairylandModel")

---@class BattleControllerSystemFairyland : Singleton	中文描述
local BattleControllerSystemFairyland = _G.BaseClass("BattleControllerSystemFairyland", _G.BattleControllerBase)

---@return BattleControllerSystemFairyland BattleControllerSystemFairyland
function BattleControllerSystemFairyland:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function BattleControllerSystemFairyland:__init()
end

function BattleControllerSystemFairyland:OnHandleParams(bossID, sid)
    self.bossID = bossID
    self.sid = sid
    self.embattleType = _G.EmbattleType["SystemFairyland" .. self.bossID]
end

function BattleControllerSystemFairyland:CheckFight(call)
    self.checkCall = call
    local pbData = {sid = self.sid}
    local port = require("SystemFairylandNet"):GetInstance():Fight(pbData, _G.handler(self, self.OnFightMsgCall))
    _G.BattleManager:GetInstance():AddLuaNetEvent(port)
end

function BattleControllerSystemFairyland:OnFightMsgCall(msg)
    if msg.ack == 1 then
        self.mgCfg = _G.ConfigManager.monster_group_cfg[msg.fight_arg.sid]
        self.fightArg = msg.fight_arg
        self.checkCall(true)
    else
        self.checkCall(false, msg.ack)
    end
    self.checkCall = nil
end

---加载战斗(协程加载)
function BattleControllerSystemFairyland:OnLoadFight()
    local uiManager = _G.UIManager:GetInstance()
    -- uiManager:CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)

    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    --battleView.View:SetSettingBtnActive(false)
    _G.BaseBattleManager:GetInstance():ClearView(false)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SystemFairylandEmbattleView.Name)
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(false)
    local battleManager = _G.BattleManager:GetInstance()
    local fighterSids = require("EmbattleModel"):GetInstance():GetEmbattleData(self.embattleType)
    -- local sid, cfg = SystemFairylandModel:GetInstance():GetNextLayer(self.bossID)
    local cfg = _G.ConfigManager.system_fairyland_cfg[self.sid]
    local str = _G.LangUtil.GetLangPackValue(90023200002, cfg.difficulty)
    battleManager:initAttackSids(fighterSids, self.embattleType, true, 0, 0, 0, str)
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    battleView.View:SetCanvasGroupTrue()
end

---战斗开始
function BattleControllerSystemFairyland:OnStart()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    -- self.super.OnStart(self)
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()
    _G.BattleManager:GetInstance():ShowBattleTeam()
end

---战斗结束
---@param tab table 战斗数据
function BattleControllerSystemFairyland:OnFightResult(tab, call)
    self.FightResult = tab
    call()
end

---结算
function BattleControllerSystemFairyland:OnSettlement(call)
    call(_G.SettlementModel.SettlementType.SystemFairyland, self.FightResult, self.bossID, self.sid, self.fightArg)
end

---战斗退出
function BattleControllerSystemFairyland:OnSettlementEnd()
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(true)
    _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
    _G.WorldManager:GetInstance():DespawnRoleParent()
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    -- require "SystemFairylandModel":GetInstance():ReturnPanel(self.bossID)
end

---重开战斗
function BattleControllerSystemFairyland:ReFight()
    _G.BattleManager:GetInstance():DestroyBattle()
    SystemFairylandModel:GetInstance():ReEnterFight()
end

---挑战下一关
function BattleControllerSystemFairyland:OnChallengeNext()
    if SystemFairylandModel:GetInstance():CheckPassMaxLayer(self.bossID) then
        SystemFairylandModel:GetInstance():ShowWindows()
        return
    end
    local sid, nextCfg = SystemFairylandModel:GetInstance():GetNextLayer(self.bossID)
    SystemFairylandModel:GetInstance():OnChallenge(self.bossID, nextCfg.difficulty, true)
end

--- 退出关卡
function BattleControllerSystemFairyland:EndFight()
    _G.BattleManager:GetInstance():PauseBattle(true)
    self:OnFightResult(nil, _G.handlerbind(self, self.OnSettlement, _G.handler(self, self.StartSettlement)), true)
end

function BattleControllerSystemFairyland:OnReEmbattle()
    _G.BattleManager:GetInstance():DestroyBattle()
    require "SystemFairylandModel":GetInstance():ReEnterFight()
end

function BattleControllerSystemFairyland:OnLoadRecordFight()
    _G.BattleManager:GetInstance():initAttackSids(nil, self.embattleType, true, 1)
end

---获取怪物组ID
---@return number 怪物组ID
function BattleControllerSystemFairyland:GetMonsterGroupID()
    return self.mgCfg.id
end

function BattleControllerSystemFairyland:CheckShowRecordBattle()
    return true
end

---销毁对象时,析构函数
function BattleControllerSystemFairyland:Dispose()
end

return BattleControllerSystemFairyland
