local MatchBattleNet = require "MatchBattleNet"
---@class BattleControllerMatchBattle	中文描述
local BattleControllerMatchBattle = _G.BaseClass("BattleControllerMatchBattle", _G.BattleControllerBase)

---类的构造函数
function BattleControllerMatchBattle:__init()
end

---类的析构函数
function BattleControllerMatchBattle:Dispose()
end

function BattleControllerMatchBattle:CheckFight(call)
    self.checkCall = call
    local port = MatchBattleNet:GetInstance():Fight(_G.handler(self, self.OnFightMsgCall))
    _G.BattleManager:GetInstance():AddLuaNetEvent(port)
end

function BattleControllerMatchBattle:OnFightMsgCall(msg)
    if msg.ack == 1 then
        self.mgCfg = _G.ConfigManager.monster_group_cfg[msg.fight_arg.sid]
        self.checkCall(true)
    else
        self.checkCall(false, msg.ack)
    end
    self.checkCall = nil
end

---加载战斗(协程加载)
function BattleControllerMatchBattle:OnLoadFight()
    local uiManager = _G.UIManager:GetInstance()
    uiManager:OpenWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    _G.coroutine.waitforseconds(1)
    uiManager:CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    battleView.View:SetSettingBtnActive(false)
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    local battleManager = _G.BattleManager:GetInstance()
    battleManager:initAttackSids(nil, 8, true)
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, self.mgCfg.audio)

    battleView.View:SetCanvasGroupTrue()
end

---战斗开始
function BattleControllerMatchBattle:OnStart()
    local uiManager = _G.UIManager:GetInstance()
    _G.PlayerPrefsManager.SetInt("IsAutoBattle", 1)
    uiManager:ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    local view = uiManager:GetWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    if view then
        view.View:SetAutoBtnActive(false)
        view.View.AtActive = false
    end
    uiManager:CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()
    _G.BattleManager:GetInstance():ShowBattleTeam()
end

---战斗结束
---@param tab table 战斗数据
function BattleControllerMatchBattle:OnFightResult(tab, call)
    MatchBattleNet:GetInstance():Result(
        function(_data)
            if _data.ack == 1 then
                self.result = _data.winner or false
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
                call()
            else
                self:FightExit()
            end
        end
    )
end
function BattleControllerMatchBattle:OnSettlement(call)
    call(_G.SettlementModel.SettlementType.matchBattle, self.result)
end

function BattleControllerMatchBattle:OnSettlementEnd()
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
end

---退出到主城
---@param call function 退出到主城时的回调
function BattleControllerMatchBattle:QuitToMainWorld(call)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    call()
end

return BattleControllerMatchBattle
