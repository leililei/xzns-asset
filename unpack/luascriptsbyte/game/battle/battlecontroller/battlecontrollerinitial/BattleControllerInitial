---@class BattleControllerInitial	中文描述
local BattleControllerInitial = _G.BaseClass("BattleControllerInitial", _G.BattleControllerBase)

local CS = _G.CS
local typeof = _G.typeof

local ShowType = {
    Loaded = 1,
    ShowEnd = 2
}

---类的构造函数
function BattleControllerInitial:__init()
end

---类的析构函数
function BattleControllerInitial:Dispose()
end

--region 子类重写方法
---处理传参
---@param sid number 房间sid
function BattleControllerInitial:OnHandleParams(type, AttackUids, DefenceSids, scene)
    self.curBattleType = type
    self.attackUids = AttackUids
    self.defenceSids = DefenceSids
    self.scene = scene
    -- self.super.HandleParams(self)
end
-----检测是否可以进入战斗
---@param callback function 检测后的回调(参数bool)
function BattleControllerInitial:CheckFight(call)
    if
        self.curBattleType == _G.EBattleType.TestAlone or self.curBattleType == _G.EBattleType.NormalAlone or
            self.curBattleType == _G.EBattleType.TestLastLocal or --本地测试战斗
            self.curBattleType == _G.EBattleType.TestRecord
     then --导入的战报战斗
        ---设置战报
        call(true)
    elseif self.curBattleType == _G.EBattleType.TestOnline then
        -- 测试带数据的战斗
        call(false)
    end
end
---战斗验证不通过
---@param msg string 错误信息
function BattleControllerInitial:OnCheckFail(msg)
    self.super.OnCheckFail(self)
end
---加载战斗(协程加载)
function BattleControllerInitial:OnLoadFight()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    self.Loaded = false
    self.ShowEnd = false
    self.BossShow = nil
    self.BossShowTime = 0
    self.State = nil
    local uiManager = _G.UIManager:GetInstance()
    uiManager:CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)

    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    local showStartView = false

    if self.type == _G.EBattleType.NormalAlone then
    -- showStartView = true
    -- _G.UIUtils.ProloadMaskVideo(
    --     "OpenDoor01",
    --     "OpenDoor01_mask",
    --     "Images/Bg/battlestartbg",
    --     function()
    --         showStartView = false
    --     end
    -- )
    -- while showStartView do
    --     _G.coroutine.waitforendofframe()
    -- end
    end
    if self.type == _G.EBattleType.NormalAlone then
        _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(false)
    end
    --
    -- 获取布阵信息
    -- local fighterSids = require("EmbattleModel"):GetInstance():GetEmbattleSidsData()
    local battleManager = _G.BattleManager:GetInstance()

    _G.BattleManager:GetInstance():BeginTestBattle(
        self.scene,
        true,
        self.attackUids,
        self.defenceSids,
        self.curBattleType
    )
    self.mgCfg = _G.ConfigManager.monster_group_cfg[self.scene]

    -- battleManager:SetRoleParent(_G.WorldManager:GetInstance():GetItemParent())
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    if self.type == _G.EBattleType.NormalAlone then
        battleView.View:SetCanvasGroupTrue()
    else
        -- self.super.LoadFight(self)
        battleView.View:SetCanvasGroupTrue()
    end
end
---战斗开始
function BattleControllerInitial:OnStart()
    -- self.super.OnStart(self)
    self.Loaded = true
    ---保存数据
    _G.TestBattleManager:GetInstance():SaveEmbattleData(self.attackUids, self.defenceSids)
    self.State = ShowType.Loaded
    _G.BattleManager:GetInstance():SetPauseBtnState(0, 1, 1)
    local uiManager = _G.UIManager:GetInstance()
    uiManager:ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    local view = uiManager:GetWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    if view then
        view.View:SetAutoBtnActive(false)
        view.View.AtActive = false
    end
    _G.BattleManager:GetInstance():SetAutoMasterSkill(0, true)
    self:OnBossShowEndDurationTimeEnd(self.State)
end
---结算
---@param callback function 结算回调(参数 结算脚本名,其他动态参数
function BattleControllerInitial:OnSettlement(callback)
    self.resultMsg = {}
    self.resultMsg = _G.BattleManager:GetInstance():GetTestBattleStatistics()

    -- _G.table.insert(self.resultMsg, data)
    self.resultMsg.winner = {true}
    callback(_G.SettlementModel.SettlementType.Inital, self.resultMsg)
end
---结算退出
---@param win boolean 是否胜利
function BattleControllerInitial:OnSettlementEnd(win)
    if win == nil then --异常
        _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    else
        _G.BaseBattleManager:GetInstance():ClearView(true)
        _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
        _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
        _G.WorldManager:GetInstance():DespawnRoleParent()

        local UIManagerIns = _G.UIManager:GetInstance()
        local ui_cfg = _G.ConfigManager.ui_cfg
        --  UIManagerIns:ShowWindow(ui_cfg.FriendsView.Name)
        UIManagerIns:ShowWindow(_G.ConfigManager.ui_cfg.InitialView.Name)
    end
end
--endregion

--BOSS出场表演结束，开始战斗
function BattleControllerInitial:OnBossShowEndDurationTimeEnd(state)
    if not self.Loaded then
        return
    end
    if state == ShowType.Loaded then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    end
    self.BossShow = nil
    self.BossShowTime = nil
    self.State = nil
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()
    ---跳过战前剧情
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    _G.BattleManager:GetInstance():ShowBattleTeam()
end

---手动停止战斗
function BattleControllerInitial:EndFight()
    self:OnSettlementEndCall()
end
---重新开始战斗
function BattleControllerInitial:ReFight()
    _G.BattleManager:GetInstance():ReFight()
end

---获取怪物组ID
---@return number 怪物组ID
function BattleControllerInitial:GetMonsterGroupID()
    return self.scene
end

return BattleControllerInitial
