local ShowType = {
    Loaded = 1,
    ShowEnd = 2
}

---类的构造函数
function BattleControllerAfkDemo:__init()
end

---类的析构函数
function BattleControllerAfkDemo:Dispose()
end

--region 子类重写方法
---处理传参
---@param sid number 房间sid
function BattleControllerAfkDemo:OnHandleParams(startCall, scene, ackSids)
    self.scene = scene
    self.ackSids = ackSids
    self.arg = self:GetFightArg()
    self.onBattleStartCall = startCall
end
-----检测是否可以进入战斗
---@param callback function 检测后的回调(参数bool)
function BattleControllerAfkDemo:CheckFight(call)
    if table.isEmptyOrNil(self.arg) and (table.isEmptyOrNil(self.ackSids) or self.scene == nil) then
        call(false, "")
        return
    end
    call(true)
end

--GC
function BattleControllerAfkDemo:DoStartGC()
    if _G.AppSetting.DEBUG then
        _G.Log("放置demo要求无缝切换不处理GC，保证流畅度")
    end
end

---战斗验证不通过
---@param msg string 错误信息
function BattleControllerAfkDemo:OnCheckFail(msg)
    _G.BattleControllerBase.OnCheckFail(self)
end
---加载战斗(协程加载)
function BattleControllerAfkDemo:OnLoadFight()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    self.Loaded = false
    self.ShowEnd = false
    self.State = nil
    local mgCfg
    -- 获取布阵信息
    if self.arg then
        _G.BattleManager:GetInstance():SetArgData(self.arg)
        mgCfg = _G.ConfigManager.monster_group_cfg[self.arg.sid]
    else
        _G.BattleManager:GetInstance():AddLuaNetMsg(self.scene)
    end
    _G.BattleManager:GetInstance():initAttackSids(self.ackSids, _G.EBattleType.AfkDemo, true)
    local view = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager)
    local battleManager = _G.BattleManager:GetInstance()
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    if mgCfg then
        _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, mgCfg.audio)
    end

    view:SetCanvasGroupTrue()
end
---战斗开始
function BattleControllerAfkDemo:OnStart()
    self.Loaded = true
    ---保存数据
    self.State = ShowType.Loaded
    self:OnBossShowEndDurationTimeEnd(self.State)
end
---战斗结束
---@param tab table 战斗数据
function BattleControllerAfkDemo:OnFightResult(tab)
    self:FightExit()
end
---获取怪物组ID
---@return number 怪物组ID
function BattleControllerAfkDemo:GetMonsterGroupID()
    return self.scene
end
--endregion

--BOSS出场表演结束，开始战斗
function BattleControllerAfkDemo:OnBossShowEndDurationTimeEnd(state)
    if not self.Loaded then
        return
    end
    if state == ShowType.Loaded then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    end
    self.BossShow = nil
    self.BossShowTime = nil
    self.State = nil
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()

    ---设置相机
    local camera = _G.GraphicsManager.Instance.CurrentVisualCamera
    if camera ~= nil then
        camera:SetPosition(20.9, 7.9, 0)
        camera:SetPosition(-0.1185317, 0.6971014, -0.1185317, -0.6971014)
    end
    ---跳过战前剧情
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    _G.BattleManager:GetInstance():ShowBattleTeam()
    if self.onBattleStartCall then
        self.onBattleStartCall()
    end
    self.onBattleStartCall = nil
end

