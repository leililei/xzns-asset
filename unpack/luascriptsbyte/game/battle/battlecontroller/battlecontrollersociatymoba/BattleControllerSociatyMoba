local base = require "BattleControllerBase"
---@class BattleControllerSociatyMoba	中文描述
local BattleControllerSociatyMoba = _G.BaseClass("BattleControllerSociatyMoba", base)

---类的构造函数
function BattleControllerSociatyMoba:__init()
end

---类的析构函数
function BattleControllerSociatyMoba:Dispose()
end

function BattleControllerSociatyMoba:EnterRecordFight(...)
    local args = { ... }
    self.leftName = args[4]
    self.rightName = args[5]
    base.EnterRecordFight(self, ...)
end

---加载战斗(协程加载)
function BattleControllerSociatyMoba:OnLoadRecordFight(index, notInBattle)
    local recordType = notInBattle and 2 or 1
    _G.BattleManager:GetInstance():initAttackSids(
        nil,
        nil,
        true,
        recordType,
        0,
        nil,
        nil,
        nil,
        self.leftName,
        self.rightName
    )
    if notInBattle then
        while _G.BattleManager:GetInstance().Progress < 1 do
            _G.coroutine.waitforendofframe()
        end
    end
    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, 1009)
end
----检测数据统计是否显示回放战斗
function BattleControllerSociatyMoba:CheckShowRecordBattle()
    return true
end


return BattleControllerSociatyMoba
