--region 子类重写

function BattleControllerSecretRealm:OnHandleParams(mgpId, leftName, rightName)
    self.mgCfg = _G.ConfigManager.monster_group_cfg[mgpId]
    self.leftName = leftName
    self.rightName = rightName
end

-----检测是否可以进入战斗
function BattleControllerSecretRealm:CheckFight(callback)
    local port = require("SecretRealmModel"):GetInstance():GetFightArgs(function(msg)
        if msg.ack ~= 1 then
            self:ExitLoading()
            callback(false, msg.ack)
        else
            self.fightArg = msg.fight_arg
            self.mgCfg = _G.ConfigManager.monster_group_cfg[msg.fight_arg.sid] or self.mgCfg
            callback(true)
        end
    end)
    _G.BattleManager:GetInstance():AddLuaNetEvent(port)
end

---加载战斗(协程加载)
function BattleControllerSecretRealm:OnLoadFight()
    --local uiManager = _G.UIManager:GetInstance()
    --uiManager:CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)
    --_G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)

    ---@type {View:BattleView}
    local battleView = _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    battleView.View:Hide()
    battleView.View:SetSettingBtnActive(false)
    local battleManager = _G.BattleManager:GetInstance()
    battleManager:initAttackSids(
        nil,
        _G.EBattleType.BigDungeon,
        true,
        nil,
        nil,
        nil,
        nil,
        nil,
        self.leftName,
        self.rightName
    )
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, self.mgCfg.audio)
    local runeList = require("SecretRealmModel"):GetInstance():GetRuneAwardData()

    if _G.AppSetting.IsAlipay then
        local conditions = _G.ConfigManager.discrete_cfg[126101]
        battleView.View:SetSpeedBtnActive(_G.GlobalConditionManager.CheckCondition(conditions[1][2], conditions[1][3]))
    else
        battleView.View:SetSpeedBtnActive(_G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Speed2))
    end
    battleView.View:SetSettingBtnActive(true)
    battleView.View:HideSkipBtn()                                             --隐藏"跳过战斗"按钮
    battleView.View:SetAutoBtnShow(true, nil, SaveAutoBtnKey)                 --显示"自动"按钮
    battleView.View:SetBagBtnShow(true, _G.handler(self, self.OnClickBagBtn)) --显示"背包"按钮
    battleView.View:SetBagTextShow(#runeList)                                 --显示"背包"奖励数量
    battleView.View:SetCanvasGroupTrue()
    if AppSetting.IsXzns then
        battleView.View:HideTimerNode()
    end

    --禁用"重新开始"战斗按钮
    _G.BattleManager:GetInstance():SetPauseBtnState(0, 1, 1)
end

---加载战斗
function BattleControllerSecretRealm:LoadFight()
    local world = _G.ePoolType.World
    _G.BattleManager:GetInstance():SetPoolName(world, world, world, world, world)
    self.isMonsherShow = false

    _G.CS.BattleManager.Inst:LuaCallCsCacheRes()
    --直接开始调用StartFightNew
    self.isMonsherShow = true
    --延时一帧的目的是为了保证布阵场景和战斗角色都放入传递到战斗的节点下
    _G.coroutine.waitforendofframe()
    --调用init方法c#战斗开始加载资源了
    self:OnLoadFight()
    self:StartFightNew()
end

---战斗开始
function BattleControllerSecretRealm:OnStart()
    if _G.MainManager:GetInstance():IsToggledWildWindow(true) then
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)

        ---@type SecretRealmBattleTransforView
        local transforView = _G.UIManager:GetInstance():GetWindowCtrl(
            _G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name
        )
        if transforView then
            local prevTimeScale = _G.Time.timeScale
            --_G.Time:SetTimeScale(1) --暂停时间倍速效果
            transforView:SetAction("zoom_in", function()
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name)
                --_G.Time:SetTimeScale(prevTimeScale) --还原倍速
                self:OpenMonsterShow()
            end)
        else
            self:OpenMonsterShow()
        end
    else
        self:OpenMonsterShow()
    end
end

---
---@protected
function BattleControllerSecretRealm:OpenMonsterShow()
    if _G.MainManager:GetInstance():IsToggledWildWindow(true) then
        if require "SecretRealmModel":GetInstance().challengeIndex == 1 then
            _G.GlobalInterface.OpenMonsterShow(function()
                _G.BattleManager:GetInstance():SetBattlePause(true)
                _G.BattleManager:GetInstance():SetBattleStart()
                _G.BattleManager:GetInstance():ShowBattleTeam()
            end, self:GetMonsterGroupID())
        elseif require "SecretRealmModel":GetInstance():IsBossRoom() then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SecretRealmBossRoomTipView.Name, function()
                _G.BattleManager:GetInstance():SetBattlePause(true)
                _G.BattleManager:GetInstance():SetBattleStart()
                _G.BattleManager:GetInstance():ShowBattleTeam()
            end)
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SecretRealmRoomTipView.Name, function()
                _G.BattleManager:GetInstance():SetBattlePause(true)
                _G.BattleManager:GetInstance():SetBattleStart()
                _G.BattleManager:GetInstance():ShowBattleTeam()
            end)
        end
    else
        _G.BattleManager:GetInstance():SetBattlePause(true)
        _G.BattleManager:GetInstance():SetBattleStart()
        _G.BattleManager:GetInstance():ShowBattleTeam()
    end
end

function BattleControllerSecretRealm:FightOverBeforePlayDeathAni(tab, showEffect)
    ---@type BattleView
    local battleView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.BattleView.Name)
    if battleView then
        if _G.MainManager:GetInstance():IsToggledWildWindow(true) then
            battleView:Show()
        end
        battleView:HideSkipBtn()
        battleView:SetSpeedBtnActive(false)
        battleView:SetSpeedBtnShow(false)
        battleView:SetSettingBtnActive(false)
        battleView:SetAutoBtnShow(false, nil, nil)
    end
    self:CloseView()
    self:OnFightOverBeforePlayDeathAni(tab, _G.handler(self, self.Settlement))
end

---战斗结束
---@param tab table 战斗数据
function BattleControllerSecretRealm:OnFightResult(tab, call)
    ---@param msg fight.s2c_fight_result
    require("BattleNet"):GetInstance():NpcPVEFightResult(tab, function(msg)
        if msg.md5_error == "1" then
            _G.PopWindowManager:GetInstance():ShowAllTips(44)
            _G.BattleManager:GetInstance():SaveLogNew()
        elseif msg.md5_error == "2" then
            _G.BattleManager:GetInstance():SaveLogNew()
        end
        local isWin = msg and msg.winner and msg.winner[1]
        msg.isWin = isWin
        self.data = msg

        --还原倍速丶暂停战斗
        if _G.MainManager:GetInstance():IsToggledWildWindow(true) then
            _G.Time:SetTimeScale(1)
            _G.BattleManager:GetInstance():SetBattlePause(true)
        end

        if isWin then
            local model = require("SecretRealmModel"):GetInstance()
            model:ReceiveAwardData(msg) --缓存奖励数据

            --获取奖励掉落信息
            ---@type number[]
            local awardSids = {}
            if msg and msg.other_award and msg.other_award.item then
                for _, v in ipairs(msg.other_award.item) do
                    local sid = v.type[1]
                    local _, storageId = _G.StorageManager:GetInstance():CheckSidType(sid)
                    if storageId == _G.StorageID.Decoration then
                        table.insert(awardSids, sid)
                    end
                end
            end

            if model:IsBossRoom() then
                --实际获取奖励(包含前面小房间内的所有奖励)
                msg.other_award = nil
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            end

            local effectCfg = _G.ConfigManager.ui_effect_cfg.ef_baoxiangbaokai
            if effectCfg and #awardSids > 0 and _G.MainManager:GetInstance():IsToggledWildWindow(true) then
                --播放宝箱动画, 播放完成后再结算(先加载蒙版信息)
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.SecretRealmSettlementMaskView.Name,
                    awardSids,
                    function()
                        self:UpdateBagText(true)
                        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SecretRealmSettlementMaskView.Name)

                        _G.DelayDo(1.2, function()
                            _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
                            self:CloseView()
                            call()
                        end)
                    end
                )
            else
                --没有奖励数据或未配置动画, 直接结算
                if _G.AppSetting.DEBUG and not effectCfg and #awardSids > 0 then
                    _G.LogError("大秘境: 结算未配置宝箱动画")
                end
                _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
                self:CloseView()
                call()
            end
        else
            --失败, 直接结算
            _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
            self:CloseView()
            call()
        end
    end)
end

---结算
---@param callback function 结算回调(参数 结算脚本名,其他动态参数
function BattleControllerSecretRealm:OnSettlement(callback)
    local auto = _G.PlayerPrefsManager.GetInt(SaveAutoBtnKey, 0) == 1
    callback(_G.SettlementModel.SettlementType.SecretRealm, self.data, self.fightArg, auto)
end

---结算退出
---@param win boolean 是否胜利
function BattleControllerSecretRealm:OnSettlementEnd(win)
    --清理战斗资源
    _G.WorldManager:GetInstance():DespawnRoleParent()
    --_G.BattleManager:GetInstance():DestroyBattle(false)
    --存储后台战斗状态
    local isToggledWild = _G.MainManager:GetInstance():IsToggledWildWindow(false)
    _G.BattleManager:GetInstance():DestroyBattle(false)
    _G.BattleManager:GetInstance():SetRendererActiveState(isToggledWild)

    require("SecretRealmModel"):GetInstance():SetFighting(false)
end

---战斗退出
function BattleControllerSecretRealm:FightExit()
    base.FightExit(self)

    require("SecretRealmModel"):GetInstance():SetFighting(false)
end

---获取怪物组ID
---@return number 怪物组ID
function BattleControllerSecretRealm:GetMonsterGroupID()
    return self.mgCfg.id
end

----检测数据统计是否显示回放战斗
function BattleControllerSecretRealm:CheckShowRecordBattle()
    return false
end

---手动停止战斗
function BattleControllerSecretRealm:EndFight()
    self:OnSettlementEnd(false)
    require("SecretRealmModel"):GetInstance():ExitChallenge()
end

---挑战下一关
function BattleControllerSecretRealm:OnChallengeNext()
    _G.LogError("OnChallengeNext")

    local model = require("SecretRealmModel"):GetInstance()
    model:ExitChallenge()
    local curCfg = _G.ConfigManager.secret_realm_cfg[model:GetCurrentChallengeSid()]
    if curCfg then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SecretRealmBuffTipView.Name)
        --_G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
        --_G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.SecretRealmView.Name)
 
        local nextSid = curCfg.next_section > 0 and curCfg.next_section or curCfg.id
        local curBattleIndex = require("SecretRealmModel"):GetInstance():GetCurBattleIndex()
        local curMultiple = model:GetCurMultiple(curBattleIndex)
        model:Battle(nextSid, curMultiple, curBattleIndex)
    else
        model:ExitChallenge()
    end
end

--endregion

function BattleControllerSecretRealm:CloseView()
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SecretRealmSettlementMaskView.Name)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SecretRealmBuffTipView.Name)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SecretRealmBagView.Name)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.RuneTipView.Name)
end

---更新背包按钮点击事件
function BattleControllerSecretRealm:OnClickBagBtn()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SecretRealmBagView.Name)
end

---更新背包按钮文本
---@param animation boolean 是否播放动画
function BattleControllerSecretRealm:UpdateBagText(animation)
    ---@type BattleView
    local battleView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.BattleView.Name)
    if battleView then
        local runeList = require("SecretRealmModel"):GetInstance():GetRuneAwardData()
        if animation then
            battleView:PlayBagTextShow(#runeList)
        else
            battleView:SetBagTextShow(#runeList)
        end
    end
end

return BattleControllerSecretRealm
