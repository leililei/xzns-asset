-----检测是否可以进入战斗
function BattleControllerCoreTrial:CheckFight(call)
    self.checkCall = call
    local port = self.typeClass:ChanllengeLevel(_G.handler(self, self.OnFightMsgCall))
    _G.BattleManager:GetInstance():AddLuaNetEvent(port)
end

function BattleControllerCoreTrial:OnFightMsgCall(msg)
    if msg.ack == 1 then
        self.mgCfg = _G.ConfigManager.monster_group_cfg[msg.fight_arg.sid]

        --_G.CS.BattleManager.Inst:StrReceiveMsg(msg.fight_arg)
        self.checkCall(true)
    else
        self.checkCall(false, msg.ack)
    end
    self.checkCall = nil
end

