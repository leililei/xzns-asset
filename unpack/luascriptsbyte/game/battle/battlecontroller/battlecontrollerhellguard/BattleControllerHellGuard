---@class BattleControllerHellGuard : BattleControllerBase	中文描述
local BattleControllerHellGuard = _G.BaseClass("BattleControllerHellGuard", _G.BattleControllerBase)

---@return BattleControllerHellGuard BattleControllerHellGuard
function BattleControllerHellGuard:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function BattleControllerHellGuard:__init()
end

function BattleControllerHellGuard:CheckFight(call)
    local model = require("HellGuardModel"):GetInstance()
    if model:IsSettlementTime() then
        --结算期中无法发起挑战
        call(false, 827)
        return
    end

    self.checkCall = call
    local port = require("HellGuardNet"):GetInstance():Fight(
        { sid = model:GetCuDifficulty() },
        _G.handler(self, self.OnFightMsgCall)
    )
    _G.BattleManager:GetInstance():AddLuaNetEvent(port)
end

function BattleControllerHellGuard:OnFightMsgCall(msg)
    if msg.ack == 1 then
        self.mgCfg = _G.ConfigManager.monster_group_cfg[msg.fight_arg.sid]
        self.fightArg = msg.fight_arg
        --_G.CS.BattleManager.Inst:StrReceiveMsg(msg.fight_arg)
        self.checkCall(true)
    else
        self.checkCall(false, msg.ack)
    end
    self.checkCall = nil
end

---加载战斗(协程加载)
function BattleControllerHellGuard:OnLoadFight()
    local uiManager = _G.UIManager:GetInstance()
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)

    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    --battleView.View:SetSettingBtnActive(false)
    _G.BaseBattleManager:GetInstance():ClearView(false)
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(false)
    local battleManager = _G.BattleManager:GetInstance()
    local fighterSids
    fighterSids = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.SeasonBoss)
    battleManager:initAttackSids(
        fighterSids,
        _G.EBattleType.HellGuard,
        true,
        0,
        0,
        nil,
        _G.LangUtil.GetLangPackValue(90026000001) .. "{0}"
    )
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    _G.coroutine.waitforendofframe()

    battleView.View:SetCanvasGroupTrue()
end

---战斗开始
function BattleControllerHellGuard:OnStart()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    -- self.super.OnStart(self)
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()
    _G.BattleManager:GetInstance():ShowBattleTeam()
end

---战斗结束
---@param tab table 战斗数据
function BattleControllerHellGuard:OnFightResult(tab, call, isNotWin)
    self.FightResult = tab
    self.isNotWin = isNotWin
    call()
    -- self:Settlement(tab)
end

---结算
function BattleControllerHellGuard:OnSettlement(call)
    call(_G.SettlementModel.SettlementType.HellGuard, self.FightResult, self.isNotWin, self.fightArg)
end

---战斗退出
function BattleControllerHellGuard:OnSettlementEnd()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(true)
    _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
    _G.WorldManager:GetInstance():DespawnRoleParent()
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    require "HellGuardModel":GetInstance():ExitFitght()
end

---重开战斗
function BattleControllerHellGuard:ReFight()
    _G.BattleManager:GetInstance():DestroyBattle()
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(true)
    require "HellGuardModel":GetInstance():ReEnterFight()
end

--- 退出关卡
function BattleControllerHellGuard:EndFight()
    _G.BattleManager:GetInstance():PauseBattle(true)
    self:OnFightResult(nil, _G.handlerbind(self, self.OnSettlement, _G.handler(self, self.StartSettlement)), true)
    --  require "HellGuardModel":GetInstance():ExitFitght()
end

function BattleControllerHellGuard:QuitToMainWorld(call)
    _G.BattleControllerBase.FightExit(self)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    call()
end

function BattleControllerHellGuard:OnReEmbattle()
    _G.BattleManager:GetInstance():DestroyBattle()
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(true)
    require "HellGuardModel":GetInstance():ReEnterFight()
end

---获取怪物组ID
---@return number 怪物组ID
function BattleControllerHellGuard:GetMonsterGroupID()
    return self.mgCfg.id
end

---销毁对象时,析构函数
function BattleControllerHellGuard:Dispose()
end

return BattleControllerHellGuard
