    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    _G.WorldManager:GetInstance():DespawnRoleParent()
    -- _G.UIManager:GetInstance():OpenWindow(
    --     _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
    --     false,
    --     nil,
    --     function()
    _G.BaseBattleManager:GetInstance():ClearView(false)
    self:FightExit()
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, false)
    require("DungonesManager"):GetInstance():EnterEmbattle()
    --end
    --,false
    --)
end

---退出到主城 (失败,)
---@param call function 退出到主城时的回调
function BattleControllerDungones:QuitToMainWorld(call)
    if call then
        call()
    end
end

---获取怪物组ID
---@return number 怪物组ID
function BattleControllerDungones:GetMonsterGroupID()
    return self.mgCfg.id
end

---加载战斗(协程加载)
function BattleControllerDungones:OnLoadRecordFight()
    local id = _G.EBattleType.QJHS
    if require("DungonesModel"):GetInstance().CurIsBoss then
        id = _G.EBattleType.QJHSBoss
    end
    _G.BattleManager:GetInstance():initAttackSids(
        require("EmbattleModel"):GetInstance():GetEmbattleData(id),
        _G.EmbattleType.dungones,
        true,
        1,
        0,
        nil,
        nil,
        nil,
        self.leftName,
        self.rightName
    )
end

----检测数据统计是否显示回放战斗
function BattleControllerDungones:CheckShowRecordBattle()
    return true
end

function BattleControllerDungones:EnterRecordFight(...)
    local args = { ... }
    self.leftName = args[4] or self.leftName
    self.rightName = args[5] or self.rightName
    base.EnterRecordFight(self, ...)
end

return BattleControllerDungones
