---加载战斗(协程加载)
function BattleControllerDungones:OnLoadFight()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    self.Loaded = false
    self.ShowEnd = false
    self.State = nil
    local uiManager = _G.UIManager:GetInstance()
    --uiManager:CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)
    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)

    -- local showStartView = true
    -- _G.UIUtils.ProloadMaskVideo(
    --     "OpenDoor01",
    --     "OpenDoor01_mask",
    --     "Images/Bg/battlestartbg",
    --     function()
    --         showStartView = false
    --     end
    -- )
    -- while showStartView do
    --     _G.coroutine.waitforendofframe()
    -- end

    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)

    _G.BaseBattleManager:GetInstance():ClearView(false)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    -- 获取布阵信息
    local battleManager = _G.BattleManager:GetInstance()

    local id = _G.EBattleType.QJHS
    if require("DungonesModel"):GetInstance().CurIsBoss then
        id = _G.EBattleType.QJHSBoss
    end
    local damage = require("DungonesModel"):GetInstance():GetPlayerDamage()
    battleManager:initAttackSids(
        require("EmbattleModel"):GetInstance():GetEmbattleData(id),
        _G.EmbattleType.dungones,
        true,
        0,
        0,
        nil,
        nil,
        damage,
        self.leftName,
        self.rightName
    )
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    _G.coroutine.waitforendofframe()

    battleView.View:SetCanvasGroupTrue()
end

---战斗开始
function BattleControllerDungones:OnStart()
    -- self.super.OnStart(self)
    local uiManager = _G.UIManager:GetInstance()
    uiManager:ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()
    _G.BattleManager:GetInstance():ShowBattleTeam()
    local battleView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.BattleView.Name)
    if battleView then
        if require("DungonesModel"):GetInstance().CurIsBoss then
            if not require("DungonesModel"):GetInstance():CheckEndBossCanSkip() then
                battleView:HideSkipBtn()
            end
        end
    end
end

---战斗结束
---@param tab table 战斗数据
function BattleControllerDungones:OnFightResult(tab, call)
    if _G.AppSetting.DEBUG then
        _G.Log(tab, "爬塔战斗结束")
    end
    self.FightResult = tab
    -- self:Settlement(tab)
    -- _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    call()
end

---结算
---@param msg table 结算数据
function BattleControllerDungones:OnSettlement(call)
    call(_G.SettlementModel.SettlementType.dungones, self.FightResult, self.mgCfg, self.fightArg)
end

---战斗退出
function BattleControllerDungones:OnSettlementEnd()
    _G.BaseBattleManager:GetInstance():ClearView(true)
    _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
    _G.WorldManager:GetInstance():DespawnRoleParent()
    self.curSettlementMsg = nil
end

---手动停止战斗
function BattleControllerDungones:EndFight()
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.CS.UnityEngine.Time.timeScale = 1
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    _G.WorldManager:GetInstance():DespawnRoleParent()
    local isBoss = require("DungonesModel"):GetInstance().CurIsBoss
    if isBoss then
        _G.BaseBattleManager:GetInstance():ClearView(true)
        self:FightExit()
        self:OnSettlementEnd()
        require("DungonesManager"):GetInstance():ExitEmbattle()
    else
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
            function()
                _G.BaseBattleManager:GetInstance():ClearView(true)
                self:FightExit()
                self:OnSettlementEnd()
                require("DungonesManager"):GetInstance():ExitEmbattle()
            end
        )
    end
    self:OnFightResult(nil, _G.handlerbind(self, self.OnSettlement, _G.handler(self, self.StartSettlement)), true)
end

