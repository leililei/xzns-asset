---处理传参
---@param towerId number 爬塔id
---@param atkUid table 布阵数据(传入 则替换掉当前 不传则采用当前数据)
function BattleControllerDungones:OnHandleParams(leftName, rightName)
    self.leftName = leftName
    self.rightName = rightName
end

-----检测是否可以进入战斗
function BattleControllerDungones:CheckFight(call)
    self.checkCall = call

    if _G.AppSetting.DEBUG then
        _G.Log(require("DungonesModel"):GetInstance().CurEventId, "战斗事件id>>>>>>")
    end
    local port =
        require("DungonesNet"):GetInstance():Fight(
        {sid = require("DungonesModel"):GetInstance().CurEventId},
        _G.handler(self, self.OnFightMsgCall)
    )
    _G.BattleManager:GetInstance():AddLuaNetEvent(port)
end

function BattleControllerDungones:OnFightMsgCall(msg)
    if msg.ack == 1 then
        self.mgCfg = _G.ConfigManager.monster_group_cfg[msg.fight_arg.sid]
        self.fightArg = msg.fight_arg
        --_G.CS.BattleManager.Inst:StrReceiveMsg(msg.fight_arg)
        self.checkCall(true)
    else
        self.checkCall(false, msg.ack)
    end
    self.checkCall = nil
end

