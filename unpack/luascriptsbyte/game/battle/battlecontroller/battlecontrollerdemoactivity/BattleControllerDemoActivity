---@class BattleControllerDemoActivity : Singleton	中文描述
local BattleControllerDemoActivity = _G.BaseClass("BattleControllerDemoActivity", _G.BattleControllerBase)

---@return BattleControllerDemoActivity BattleControllerDemoActivity
function BattleControllerDemoActivity:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function BattleControllerDemoActivity:__init()
end

-- region 子类重写方法
---处理传参
---@param activity DemoActivityModel 房间sid
function BattleControllerDemoActivity:OnHandleParams(activity)
    self.activity = activity
    -- self.super.HandleParams(self)
end

function BattleControllerDemoActivity:CheckFight(call)
    self.checkCall = call
    local pbdata = {}
    pbdata.sids = self.activity.garray
    pbdata.trail = self.activity:GetCurFightSectionId()
    pbdata.activity_id = self.activity.curActivityClass:GetActivityID()
    local port = require("DemoNet"):GetInstance():ActivityFight(pbdata, _G.handler(self, self.OnFightMsgCall))
    _G.BattleManager:GetInstance():AddLuaNetEvent(port)
end

function BattleControllerDemoActivity:OnFightMsgCall(msg)
    if msg.ack == 1 then
        self.mgCfg = _G.ConfigManager.monster_group_cfg[msg.fight_arg.sid]
        -- _G.CS.BattleManager.Inst:StrReceiveMsg(msg.fight_arg)
        self.checkCall(true)
    else
        self.checkCall(false, msg.ack)
        _G.BattleManager:GetInstance():DestroyBattle()
    end
    self.checkCall = nil
end

---加载战斗(协程加载)
function BattleControllerDemoActivity:OnLoadFight()
    local uiManager = _G.UIManager:GetInstance()
    -- local view = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    -- while (_G.IsNil(view.View.gameObject)) do
    --     _G.coroutine.waitforendofframe()
    -- end
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)

    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    -- 获取布阵信息
    local fighterSids = self.activity.garray

    local battleManager = _G.BattleManager:GetInstance()

    battleManager:initAttackSids(fighterSids, _G.EBattleType.NormalBattle, true)
    --   _G.CS.BattleManager.Inst:SetAutoJointSkillOpen(automatic_skills[2] == 1)
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end

    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    _G.coroutine.waitforendofframe()
    battleView.View:SetCanvasGroupTrue()
end

---战斗开始
function BattleControllerDemoActivity:OnStart()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()
    _G.BattleManager:GetInstance():ShowBattleTeam()
end

---战斗结束
---@param tab table 战斗数据
function BattleControllerDemoActivity:OnFightResult(tab, call)
    require("TrainingModel"):GetInstance():SetIsTrainBattle(false)

    self.FightResult = tab
    call()
    -- self:Settlement(tab)
end

---结算
function BattleControllerDemoActivity:OnSettlement(call)
    call(_G.SettlementModel.SettlementType.DemoActivity, self.FightResult, self.activity)
end

---战斗退出
function BattleControllerDemoActivity:OnSettlementEnd()
    -- _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
    self.activity:ExitEmbattle()
end

---重开战斗
function BattleControllerDemoActivity:ReFight()
    _G.BattleManager:GetInstance():DestroyBattle()
    self.activity:ReEnterFight()
end

--- 退出关卡
function BattleControllerDemoActivity:EndFight()
    _G.BattleManager:GetInstance():DestroyBattle()
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    self.activity:ExitEmbattle()
end

function BattleControllerDemoActivity:QuitToMainWorld(call)
    _G.UIManager:GetInstance():CloseWindowsByLayer(_G.UILayers.NormalLayer)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    if call then
        call()
    end
end

---获取怪物组ID
---@return number 怪物组ID
function BattleControllerDemoActivity:GetMonsterGroupID()
    return self.mgCfg.id
end

---销毁对象时,析构函数
function BattleControllerDemoActivity:Dispose()
end
---战斗退出
function BattleControllerDemoActivity:FightExit()
    self.super.FightExit(self)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
end

return BattleControllerDemoActivity
