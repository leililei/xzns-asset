local base = _G.BattleControllerBase
---@class BattleControllerFirstTestBoss : BattleControllerBase	中文描述
local BattleControllerFirstTestBoss = _G.BaseClass("BattleControllerFirstTestBoss", base)

---@return BattleControllerFirstTestBoss BattleControllerFirstTestBoss
function BattleControllerFirstTestBoss:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function BattleControllerFirstTestBoss:__init()
end

function BattleControllerFirstTestBoss:CheckFight(call)
    self.checkCall = call
    if not require "SeasonManager".CheckSeasonIsOpen() then
        _G.PopWindowManager:GetInstance():ShowAllTips(620105)
        self:QuitToMainWorld()
        return
    end
    local port = require("FirstTestNet"):GetInstance():FightBoss(_G.handler(self, self.OnFightMsgCall))
    _G.BattleManager:GetInstance():AddLuaNetEvent(port)
end

function BattleControllerFirstTestBoss:OnFightMsgCall(msg)
    if msg.ack == 1 then
        -- _G.Events:GetInstance():Broadcast(
        --     _G.ePlayAactionEvent.PlayAaction,
        --     {_G.ActiveTaskEnum.ConditionEnum.Season.BossNum},
        --     1
        -- )
        self.mgCfg = _G.ConfigManager.monster_group_cfg[msg.args.sid]
        self.fightArg = msg.args
        --_G.CS.BattleManager.Inst:StrReceiveMsg(msg.fight_arg)
        if self.checkCall then
            self.checkCall(true)
        end
    else
        if self.checkCall then
            self.checkCall(false, msg.ack)
        end
    end
    self.checkCall = nil
end

---加载战斗(协程加载)
function BattleControllerFirstTestBoss:OnLoadFight()
    local uiManager = _G.UIManager:GetInstance()
    -- uiManager:CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)

    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    --battleView.View:SetSettingBtnActive(false)
    _G.BaseBattleManager:GetInstance():ClearView(false)
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(false)
    local battleManager = _G.BattleManager:GetInstance()
    local fighterSids
    fighterSids = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.SeasonBoss)
    local damage = require("FirstTestBossModel"):GetInstance():GetDayDamage()

    battleManager:initAttackSids(
        fighterSids,
        _G.EBattleType.WorldBossChallenge,
        true,
        0,
        0,
        nil,
        nil,
        damage,
        self.leftName,
        self.rightName
    )
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    _G.coroutine.waitforendofframe()

    battleView.View:SetCanvasGroupTrue()
end

---战斗开始
function BattleControllerFirstTestBoss:OnStart()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    -- self.super.OnStart(self)
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()
    _G.BattleManager:GetInstance():ShowBattleTeam()
end

---战斗结束
---@param tab table 战斗数据
function BattleControllerFirstTestBoss:OnFightResult(tab, call, isNotWin)
    self.FightResult = tab
    self.isNotWin = isNotWin
    call()
    -- self:Settlement(tab)
end

---结算
function BattleControllerFirstTestBoss:OnSettlement(call)
    call(_G.SettlementModel.SettlementType.FirstTestBoss, self.FightResult, self.isNotWin, self.mgCfg, self.fightArg)
end

---战斗退出
function BattleControllerFirstTestBoss:OnSettlementEnd()
    -- _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(true)
    _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
    _G.WorldManager:GetInstance():DespawnRoleParent()
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    require "FirstTestBossModel":GetInstance():ReturnPanel()
end

---重开战斗
function BattleControllerFirstTestBoss:ReFight()
    _G.BattleManager:GetInstance():DestroyBattle()
    require "FirstTestBossModel":GetInstance():ReEnterFight()
end

--- 退出关卡
function BattleControllerFirstTestBoss:EndFight()
    -- _G.SettlementModel:GetInstance():Settlement(
    --     _G.SettlementModel.SettlementType.SeasonBoss,
    --     function()
    --         _G.BattleManager:GetInstance():DestroyBattle()
    --         require "SeasonBossModel":GetInstance():ReturnPanel()
    --     end,
    --     nil,
    --     false
    -- )
    _G.BattleManager:GetInstance():PauseBattle(true)
    self:OnFightResult(nil, _G.handlerbind(self, self.OnSettlement, _G.handler(self, self.StartSettlement)), true)
end

function BattleControllerFirstTestBoss:QuitToMainWorld(call)
    _G.BattleControllerBase.FightExit(self)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    if call then
        call()
    end
end

function BattleControllerFirstTestBoss:OnReEmbattle()
    _G.BattleManager:GetInstance():DestroyBattle()
    require "FirstTestBossModel":GetInstance():ReEnterFight()
end

function BattleControllerFirstTestBoss:OnLoadRecordFight()
    _G.BattleManager:GetInstance():initAttackSids(
        nil,
        _G.EBattleType.WorldBossDamageTest,
        true,
        1,
        nil,
        nil,
        nil,
        nil,
        self.leftName,
        self.rightName
    )
end

---获取怪物组ID
---@return number 怪物组ID
function BattleControllerFirstTestBoss:GetMonsterGroupID()
    return self.mgCfg.id
end

function BattleControllerFirstTestBoss:FightRecordExit()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(true)
    if not _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.CommonRankView.Name) then
        _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    end
    _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
    _G.WorldManager:GetInstance():DespawnRoleParent()
    self.super.FightRecordExit(self)
end

---销毁对象时,析构函数
function BattleControllerFirstTestBoss:Dispose()
end

function BattleControllerFirstTestBoss:OnHandleParams(leftName, rightName)
    self.leftName = leftName
    self.rightName = rightName
end

function BattleControllerFirstTestBoss:EnterRecordFight(...)
    local args = { ... }
    self.leftName = args[4] or self.leftName
    self.rightName = args[5] or self.rightName
    base.EnterRecordFight(self, ...)
end

return BattleControllerFirstTestBoss
