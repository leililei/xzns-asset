local StarSoulModel = require "StarSoulModel"
---@class BattleControllerStarSoul : Singleton	中文描述
local BattleControllerStarSoul = _G.BaseClass("BattleControllerStarSoul", _G.BattleControllerBase)

---@return BattleControllerStarSoul BattleControllerStarSoul
function BattleControllerStarSoul:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function BattleControllerStarSoul:__init()
end

function BattleControllerStarSoul:CheckFight(call)
    self.checkCall = call
    _G.BattleManager:GetInstance():AddLuaNetEvent(_G.ConfigManager.net_map.game_system_prof_fight.PBCmd)
    local bossid = {}
    bossid.bid = require("StarSoulModel"):GetInstance():Getboss_id()
    require("StarSoulNet"):GetInstance():FightBoss(bossid, _G.handler(self, self.OnFightMsgCall))
end

function BattleControllerStarSoul:OnFightMsgCall(msg)
    if msg.ack == 1 then
        self.mgCfg = _G.ConfigManager.monster_group_cfg[msg.fight_arg.sid]
        --_G.CS.BattleManager.Inst:StrReceiveMsg(msg.fight_arg)
        self.checkCall(true)
    else
        self.checkCall(false, msg.ack)
    end
    self.checkCall = nil
end

---加载战斗(协程加载)
function BattleControllerStarSoul:OnLoadFight()
    local uiManager = _G.UIManager:GetInstance()
    local view = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.LoadingView.Name).View
    while (_G.IsNil(view.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    --uiManager:CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)

    -- local showStartView = true
    -- _G.UIUtils.ProloadMaskVideo(
    --     "OpenDoor01",
    --     "OpenDoor01_mask",
    --     "Images/Bg/battlestartbg",
    --     function()
    --         showStartView = false
    --     end
    -- )
    -- while showStartView do
    --     _G.coroutine.waitforendofframe()
    -- end

    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    --battleView.View:SetSettingBtnActive(false)
    _G.BaseBattleManager:GetInstance():ClearView(false)
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(false)
    local battleManager = _G.BattleManager:GetInstance()
    local fighterSids
    fighterSids = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.StarSoul)
    battleManager:initAttackSids(fighterSids, _G.EBattleType.StarSoul, true, 0, 0)
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    battleView.View:SetCanvasGroupTrue()
    _G.coroutine.waitforendofframe()
end

---战斗开始
function BattleControllerStarSoul:OnStart()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    -- self.super.OnStart(self)
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()
    _G.BattleManager:GetInstance():ShowBattleTeam()
end

---战斗结束
---@param tab table 战斗数据
function BattleControllerStarSoul:OnFightResult(tab, call)
    self.FightResult = tab
    call()
    -- self:Settlement(tab)
end

---结算
function BattleControllerStarSoul:OnSettlement(call)
    call(_G.SettlementModel.SettlementType.StarSoul, self.FightResult)
end

---战斗退出
function BattleControllerStarSoul:OnSettlementEnd()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(true)
    _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
    _G.WorldManager:GetInstance():DespawnRoleParent()
    StarSoulModel:GetInstance():ExitEmbattle()
end

---重开战斗
function BattleControllerStarSoul:ReFight()
    _G.BattleManager:GetInstance():DestroyBattle()
    StarSoulModel:GetInstance():ReEnterFight()
end

--- 退出关卡
function BattleControllerStarSoul:EndFight()
    _G.BattleManager:GetInstance():DestroyBattle()
    StarSoulModel:GetInstance():FightLose()
end

function BattleControllerStarSoul:QuitToMainWorld(call)
    _G.UIManager:GetInstance():CloseWindowsByLayer(_G.UILayers.NormalLayer)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    call()
end

function BattleControllerStarSoul:OnReEmbattle()
    _G.BattleManager:GetInstance():DestroyBattle()
    StarSoulModel:GetInstance():ReEnterFight()
end

---获取怪物组ID
---@return number 怪物组ID
function BattleControllerStarSoul:GetMonsterGroupID()
    return self.mgCfg.id
end

---销毁对象时,析构函数
function BattleControllerStarSoul:Dispose()
end

return BattleControllerStarSoul
