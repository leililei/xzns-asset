---@class BattleControllerSystemEquip	中文描述
local BattleControllerSystemEquip = _G.BaseClass("BattleControllerSystemEquip", _G.BattleControllerBase)

local ShowType = {
    Loaded = 1,
    ShowEnd = 2
}

---类的构造函数
function BattleControllerSystemEquip:__init()
end

---类的析构函数
function BattleControllerSystemEquip:Dispose()
end

--region 子类重写方法
---处理传参
---@param sid number 房间sid
function BattleControllerSystemEquip:OnHandleParams(monsterSid, SectionID)
    self.curSid = monsterSid
    self.SectionID = SectionID
    -- self.super.HandleParams(self)
end
-----检测是否可以进入战斗
---@param callback function 检测后的回调(参数bool)
function BattleControllerSystemEquip:CheckFight(call)
    local port =
        require("EquipSystemNet"):GetInstance():EnterFight(
        {sid = self.SectionID, monster = self.curSid},
        function(msg, error)
            if not _G.string.IsNullOrEmpty(error) or msg.ack ~= 1 then
                self:ExitLoading()
                call(false, msg.ack)
            else
                self.mgCfg = _G.ConfigManager.monster_group_cfg[msg.fight_arg.sid]

                --_G.CS.BattleManager.Inst:StrReceiveMsg(msg.fight_arg)
                call(true)
            end
        end
    )
    _G.BattleManager:GetInstance():AddLuaNetEvent(port)
end
---战斗验证不通过
---@param msg string 错误信息
function BattleControllerSystemEquip:OnCheckFail(msg)
    _G.SystemEquipBattleManager:GetInstance():EnterEmbattle()
end
---加载战斗(协程加载)
function BattleControllerSystemEquip:OnLoadFight()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    self.Loaded = false
    self.ShowEnd = false
    self.State = nil
    local uiManager = _G.UIManager:GetInstance()
    uiManager:CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)
    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)

    _G.BaseBattleManager:GetInstance():ClearView(false)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    -- 获取布阵信息
    local battleManager = _G.BattleManager:GetInstance()
    battleManager:initAttackSids(
        require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.SystemEquipment),
        _G.EBattleType.Abyss,
        true,
        0,
        0
    )
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    battleView.View:SetCanvasGroupTrue()
    _G.coroutine.waitforendofframe()
end
---战斗开始
function BattleControllerSystemEquip:OnStart()
    -- self.super.OnStart(self)
    self.Loaded = true
    self.BossShow = nil
    self.BossShowTime = 0
    self.State = ShowType.Loaded
    self:OnBossShowEndDurationTimeEnd(self.State)
end
---战斗结束
---@param tab table 战斗数据
function BattleControllerSystemEquip:OnFightResult(tab, call)
    self.FightResult = tab
    call()
end
---结算
---@param 变量名 变量类型 中文描述
---@return 变量类型 中文描述
function BattleControllerSystemEquip:OnSettlement(call)
    call(_G.SettlementModel.SettlementType.systemEquipment, self.FightResult)
end
---战斗退出
function BattleControllerSystemEquip:OnSettlementEnd()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, false)
    _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
    self.curSettlementMsg = nil
end
--endregion

--BOSS出场表演结束，开始战斗
function BattleControllerSystemEquip:OnBossShowEndDurationTimeEnd(state)
    if not self.Loaded then
        return
    end
    if state == ShowType.ShowEnd and (not self.ShowEnd or not (self.BossShow ~= nil and #self.BossShow > 1)) then
        return
    end
    if state == ShowType.ShowEnd then
        local MainCamera = _G.WorldManager:GetInstance():GetCurWorld().WorldSetting.SceneCamera.UniCam
        MainCamera:SetActiveE(1)
    elseif state == ShowType.Loaded then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    end
    self.BossShow = nil
    self.BossShowTime = nil
    self.State = nil
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()
    ---战前剧情
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    _G.BattleManager:GetInstance():ShowBattleTeam()
end

---手动停止战斗
function BattleControllerSystemEquip:EndFight()
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.CS.UnityEngine.Time.timeScale = 1
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)

    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
        false,
        nil,
        function()
            self:FightExit()
            self:OnSettlementEndCall()
            _G.SystemEquipBattleManager:GetInstance():ExitEmbattle()
        end,
        false
    )
end
---重新开始战斗
function BattleControllerSystemEquip:ReFight()
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.CS.UnityEngine.Time.timeScale = 1
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
        false,
        nil,
        function()
            self:FightExit()
            _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, false)
            _G.SystemEquipBattleManager:GetInstance():EnterEmbattle()
        end,
        false
    )
end

---获取怪物组ID
---@return number 怪物组ID
function BattleControllerSystemEquip:GetMonsterGroupID()
    return self.mgCfg.id
end

return BattleControllerSystemEquip
