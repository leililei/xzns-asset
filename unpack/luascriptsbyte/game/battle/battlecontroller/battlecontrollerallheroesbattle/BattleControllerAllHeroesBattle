local AllHeroesBattleNet = require "AllHeroesBattleNet"
local base = require("BattleControllerBase")
---@class BattleControllerAllHeroesBattle:BattleControllerBase	中文描述
local BattleControllerAllHeroesBattle = _G.BaseClass("BattleControllerAllHeroesBattle", base)

---类的构造函数
function BattleControllerAllHeroesBattle:__init()
end

---类的析构函数
function BattleControllerAllHeroesBattle:Dispose()
end

--region 子类重写
---处理参数
---@param rank number 当前排名
---@param enemy table 地方数据
---@param fightCallback fun(msg:any):void 战斗消息回调
function BattleControllerAllHeroesBattle:OnHandleParams(id, uid, callback, fightCallback, leftName, rightName)
    self.challengePosID = id
    self.ChallengePlayerID = uid
    self.onChallengeCall = callback
    self.onFightCallback = fightCallback
    self.leftName = leftName
    self.rightName = rightName
end

function BattleControllerAllHeroesBattle:EnterRecordFight(...)
    local args = { ... }
    self.leftName = args[4] or self.leftName
    self.rightName = args[5] or self.rightName
    base.EnterRecordFight(self, ...)
end

-----检测是否可以进入战斗
function BattleControllerAllHeroesBattle:CheckFight(callback)
    self.onCheckCall = callback
    local port =
        AllHeroesBattleNet:GetInstance():Challenge(
        self.challengePosID,
        self.ChallengePlayerID,
        _G.handler(self, self.OnFightMsgCall)
    )
    _G.BattleManager:GetInstance():AddLuaNetEvent(port)
end

---战斗验证不通过
---@param msg string 错误信息
function BattleControllerAllHeroesBattle:OnCheckFail(msg)
    self.onChallengeCall(false)
    _G.BattleManager:GetInstance():DestroyBattle()
end

---加载战斗(协程加载)
function BattleControllerAllHeroesBattle:OnLoadFight()
    self.onChallengeCall(true)
    local uiManager = _G.UIManager:GetInstance()
    uiManager:CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    battleView.View:SetSettingBtnActive(false)
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    local battleManager = _G.BattleManager:GetInstance()
    battleManager:initAttackSids(
        nil,
        nil,
        true,
        nil,
        nil,
        nil,
        nil,
        nil,
        self.leftName,
        self.rightName
    )
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, self.mgCfg.audio)

    battleView.View:SetCanvasGroupTrue()
end

---战斗开始
function BattleControllerAllHeroesBattle:OnStart()
    local uiManager = _G.UIManager:GetInstance()
    local BattleViewName = _G.ConfigManager.ui_cfg.BattleView.Name
    uiManager:ShowWindow(BattleViewName)
    local view = uiManager:GetWindow(BattleViewName)
    if view then
        view.View:SetAutoBtnActive(false)
        view.View.AtActive = false
    end
    local BattleManagerIns = _G.BattleManager:GetInstance()
    BattleManagerIns:SetBattlePause(true)
    BattleManagerIns:SetBattleStart()
    BattleManagerIns:ShowBattleTeam()
    BattleManagerIns:ShowSkipBattleBtn(_G.FunctionManager:GetInstance():CheckFunctionIsUnlock(72))
end

---战斗结束
---@param tab table 战斗数据
---@param call function 完成回调
function BattleControllerAllHeroesBattle:OnFightResult(tab, call)
    require("AllHeroesBattleManager"):GetInstance():UpdateInitData(call)
end

---结算
---@param callback function 结算回调(参数 结算脚本名,其他动态参数
function BattleControllerAllHeroesBattle:OnSettlement(callback)
    callback(
        _G.SettlementModel.SettlementType.AllHeroesBattle,
        self.result,
        nil,
        nil,
        nil,
        self.fightArg,
        self.report_uid,
        self.curChallengePlayer
    )
end

---结算退出
---@param win boolean 是否胜利
function BattleControllerAllHeroesBattle:OnSettlementEnd(win)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    local AllHeroesBattleManagerIns = require("AllHeroesBattleManager"):GetInstance()
    if AllHeroesBattleManagerIns:GetFunctionOpened() then
        if _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.AllHeroesBattleRoomView.Name) then
            _G.UIManager:GetInstance():ShowWindow(
                _G.ConfigManager.ui_cfg.AllHeroesBattleRoomView.Name,
                AllHeroesBattleManagerIns:GetCurChooseRoomID()
            )
        else
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.AllHeroesBattleRoomView.Name,
                AllHeroesBattleManagerIns:GetCurChooseRoomID()
            )
        end
    end
    --base.OnSettlementEnd(self)
end

---重新布阵
function BattleControllerAllHeroesBattle:OnReEmbattle()
    self:OnSettlementEnd(false)
end

--endregion

--region 内部方法
---检测回调
---@param 变量名 变量类型 中文描述
function BattleControllerAllHeroesBattle:OnFightMsgCall(msg)
    if self.onFightCallback then
        self.onFightCallback(msg)
    end
    if msg.ack == 1 then
        self.mgCfg = _G.ConfigManager.monster_group_cfg[msg.fight_arg.sid]
        self.result = msg.winner
        self.report_uid = msg.report_uid
        self.curChallengePlayer = require("AllHeroesBattleManager"):GetInstance().curChallengePlayer
        self.fightArg = msg.fight_arg

        _G.Events:GetInstance():Broadcast(_G.eSeasonTask.Action, {_G.SeasonTaskID.AllHeroesBattle_Fight}, 1)
        self.onCheckCall(true)
    else
        self.onCheckCall(false, msg.ack)
    end
end

--endregion
---加载战斗(协程加载)
function BattleControllerAllHeroesBattle:OnLoadRecordFight(index, notInBattle)
    local recordType = notInBattle and 2 or 1
    _G.BattleManager:GetInstance():initAttackSids(
        nil,
        nil,
        true,
        recordType,
        0,
        nil,
        nil,
        nil,
        self.leftName,
        self.rightName
    )
    if notInBattle then
        while _G.BattleManager:GetInstance().Progress < 1 do
            _G.coroutine.waitforendofframe()
        end
    end
    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, 1009)
end

----检测数据统计是否显示回放战斗
function BattleControllerAllHeroesBattle:CheckShowRecordBattle()
    return true
end

return BattleControllerAllHeroesBattle
