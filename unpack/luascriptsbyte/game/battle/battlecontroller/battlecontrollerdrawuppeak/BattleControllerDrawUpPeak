---@class BattleControllerDrawUpPeak : BattleControllerBase	中文描述
local BattleControllerDrawUpPeak = _G.BaseClass("BattleControllerDrawUpPeak", _G.BattleControllerBase)

---@return BattleControllerDrawUpPeak BattleControllerDrawUpPeak
function BattleControllerDrawUpPeak:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function BattleControllerDrawUpPeak:__init()
end

function BattleControllerDrawUpPeak:OnHandleParams(fight, ActivityID)
    self.fight = fight
    self.ActivityID = ActivityID
end

function BattleControllerDrawUpPeak:CheckFight(call)
    self.checkCall = call

    local port = require("DrawUpPeakNet"):GetInstance():GetHeroTrial(self.fight, _G.handler(self, self.OnFightMsgCall))
    _G.BattleManager:GetInstance():AddLuaNetEvent(port)
end

function BattleControllerDrawUpPeak:OnFightMsgCall(msg)
    if msg.ack == 1 then
        -- _G.Events:GetInstance():Broadcast(
        --     _G.ePlayAactionEvent.PlayAaction,
        --     {_G.ActiveTaskEnum.ConditionEnum.Season.BossNum},
        --     1
        -- )
        self.mgCfg = _G.ConfigManager.monster_group_cfg[msg.fight_arg.sid]
        --_G.CS.BattleManager.Inst:StrReceiveMsg(msg.fight_arg)
        self.checkCall(true)
    else
        self.checkCall(false, msg.ack)
    end
    self.checkCall = nil
end

---加载战斗(协程加载)
function BattleControllerDrawUpPeak:OnLoadFight()
    local uiManager = _G.UIManager:GetInstance()
    -- uiManager:CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)
    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)

    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    --battleView.View:SetSettingBtnActive(false)
    _G.BaseBattleManager:GetInstance():ClearView(false)

    local battleManager = _G.BattleManager:GetInstance()
    local fighterSids
    fighterSids = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.DrawUpPeak)
    local score = 0
    battleManager:initAttackSids(fighterSids, _G.EBattleType.ArenaPeak, true, 0, 0, nil, nil, score)
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(false)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    _G.coroutine.waitforendofframe()

    battleView.View:SetCanvasGroupTrue()
end

---战斗开始
function BattleControllerDrawUpPeak:OnStart()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    -- self.super.OnStart(self)
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()
    _G.BattleManager:GetInstance():ShowBattleTeam()
end

---战斗结束
---@param tab table 战斗数据
function BattleControllerDrawUpPeak:OnFightResult(tab, call, isNotWin)
    self.FightResult = tab
    self.isNotWin = isNotWin
    call()
    -- self:Settlement(tab)
end

---结算
function BattleControllerDrawUpPeak:OnSettlement(call)
    call(_G.SettlementModel.SettlementType.DrawUpPeak, self.FightResult, self.isNotWin, self.ActivityID)
end

---战斗退出
function BattleControllerDrawUpPeak:OnSettlementEnd()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    -- _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(true)
    _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
    _G.WorldManager:GetInstance():DespawnRoleParent()

    -- require "BlackSourceModel":GetInstance():ReturnPanel()
end

---重开战斗
function BattleControllerDrawUpPeak:ReFight()
    _G.BattleManager:GetInstance():DestroyBattle()
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(true)
    require "DrawUpMainModel":GetInstance():ReEnterFight()
end

--- 退出关卡
function BattleControllerDrawUpPeak:EndFight()
    -- _G.SettlementModel:GetInstance():Settlement(
    --     _G.SettlementModel.SettlementType.SeasonBoss,
    --     function()
    --         _G.BattleManager:GetInstance():DestroyBattle()
    --         require "SeasonBossModel":GetInstance():ReturnPanel()
    --     end,
    --     nil,
    --     false
    -- )
    _G.BattleManager:GetInstance():PauseBattle(true)
    self:OnFightResult(nil, _G.handlerbind(self, self.OnSettlement, _G.handler(self, self.StartSettlement)), true)
end

function BattleControllerDrawUpPeak:QuitToMainWorld(call)
    _G.BattleControllerBase.FightExit(self)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    call()
end

function BattleControllerDrawUpPeak:OnReEmbattle()
    _G.BattleManager:GetInstance():DestroyBattle()
    -- require "BlackSourceModel":GetInstance():ReEnterFight()
end

function BattleControllerDrawUpPeak:OnLoadRecordFight()
    _G.BattleManager:GetInstance():initAttackSids(nil, _G.EBattleType.WorldBossDamageTest, true, 1)
end

---获取怪物组ID
---@return number 怪物组ID
function BattleControllerDrawUpPeak:GetMonsterGroupID()
    return self.mgCfg.id
end

---销毁对象时,析构函数
function BattleControllerDrawUpPeak:Dispose()
end

return BattleControllerDrawUpPeak
