-----检测是否可以进入战斗
function BattleControllerTower:CheckFight(call)
    self.checkCall = call

    local towerType = DeadsoulTowerModel:GetInstance().CurTowerType
    ---如果种族塔已关闭
    if towerType ~= 9 and self:OnSixClockUpdateFighting() then
        self.checkCall(false, 390101) --日期不符合种族塔试炼开放条件
        return
    end

    local et = _G.EmbattleType.Tower
    if towerType ~= 9 then
        if #_G.DeadsoulTowerManager:GetInstance():GetSceneID() > 1 then
            et = _G.EmbattleType["Tower" .. towerType] * 1000 + self.index
        else
            et = _G.EmbattleType["Tower" .. towerType]
        end
    else
        if #_G.DeadsoulTowerManager:GetInstance():GetSceneID() > 1 then
            et = _G.EmbattleType["Tower"] * 1000 + self.index
        end
    end
    local sits = require "EmbattleModel":GetInstance():GetEmbattleData(et)
    local skills = require "EmbattleModel":GetInstance():GetSkillIndex(et)
    local port =
        require("DeadsoulTowerNet"):GetInstance():DeadSoulFight(
        {fid = self.TowerId, monster_id = self.monsterId},
        _G.handler(self, self.OnFightMsgCall)
    )
    _G.BattleManager:GetInstance():AddLuaNetEvent(port)
end

function BattleControllerTower:OnFightMsgCall(msg)
    if msg.ack == 1 then
        self.mgCfg = _G.ConfigManager.monster_group_cfg[msg.fight_arg.sid]
        self.fight_arg = msg.fight_arg
        _G.DeadsoulTowerManager:GetInstance():SetCurFightArg(msg.fight_arg, msg.fight_arg.sid)
        _G.DeadsoulTowerManager:GetInstance():SetBattleFirst(false)
        --_G.CS.BattleManager.Inst:StrReceiveMsg(msg.fight_arg)
        self.checkCall(true)
        _G.Events:GetInstance():Broadcast(_G.eSeasonTask.Action, {_G.SeasonTaskID.Deadsoul}, 1)
    else
        self.checkCall(false, msg.ack)
    end
    self.checkCall = nil
end

---战斗验证不通过
---@param msg number 错误信息
function BattleControllerTower:OnCheckFail(msg)
    if msg and msg > 1 then
        _G.PopWindowManager:GetInstance():ShowAllTips(msg)
    end
    --关闭布阵页面
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DeadSoulEmbattleView.Name)
    --关闭遮罩层
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
    --退出战斗并返回死魂塔页面
    _G.DeadsoulTowerManager:GetInstance():ExitFight()
    if _G.MainManager:GetInstance():IsToggledWildWindow(false) then
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
        --移除MainView动画(从下往上滑出)
        ---@type MainView
        local mainView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name)
        if mainView then
            mainView:StopAnimation(true)
        end

        _G.DeadsoulTowerManager:GetInstance():ReturnUIPage(false)
    end
    --_G.DeadsoulTowerManager:GetInstance():EnterEmbattle(false, self.index)
    --清除布阵资源(布阵相关资源会延后回收)
    _G.DelayFrameDo(function()
        _G.WorldManager:GetInstance():DespawnRoleParent()
        _G.BattleManager:GetInstance():DestroyBattle(false)
    end)
end

---加载战斗(协程加载)
function BattleControllerTower:OnLoadFight()
    --_G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    self.Loaded = false
    self.ShowEnd = false
    self.State = nil
    local uiManager = _G.UIManager:GetInstance()

    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name, true).View
    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    battleView:Hide()

    --_G.BaseBattleManager:GetInstance():ClearView(false)
    -- 获取布阵信息
    local battleManager = _G.BattleManager:GetInstance()
    local et = _G.EmbattleType.Tower
    if DeadsoulTowerModel:GetInstance().CurTowerType ~= 9 then
        et = _G.EmbattleType["Tower" .. DeadsoulTowerModel:GetInstance().CurTowerType]
    end

    local id = 0
    if DeadsoulTowerModel:GetInstance().CurTowerType == DeadsoulTowerModel:GetInstance().MianTower then
        id = _G.EBattleType.Tower
    elseif DeadsoulTowerModel:GetInstance().CurTowerType == 1 then
        id = _G.EBattleType.TowerThunder
    elseif DeadsoulTowerModel:GetInstance().CurTowerType == 2 then
        id = _G.EBattleType.TowerWind
    elseif DeadsoulTowerModel:GetInstance().CurTowerType == 3 then
        id = _G.EBattleType.TowerWater
    elseif DeadsoulTowerModel:GetInstance().CurTowerType == 4 then
        id = _G.EBattleType.TowerFire
    elseif DeadsoulTowerModel:GetInstance().CurTowerType == 5 then
        id = _G.EBattleType.TowerEarth
    end
    local cfg = _G.ConfigManager.tower_cfg[DeadsoulTowerModel:GetInstance().CurTowerSid]
    local isid = cfg.layer
    local str = _G.LangUtil.GetLangPackValue(90023200002, tostring(isid))
    battleManager:initAttackSids(
        require("EmbattleModel"):GetInstance():GetEmbattleData(id),
        et,
        true,
        0,
        0,
        0,
        str,
        0,
        self.leftName,
        self.rightName
    )
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DeadSoulEmbattleView.Name)
    --_G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    _G.coroutine.waitforendofframe()
    battleView:SetCanvasGroupTrue()
end

---战斗开始
function BattleControllerTower:OnStart()
    if _G.MainManager:GetInstance():IsToggledWildWindow(true) then
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    end
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()
    _G.BattleManager:GetInstance():ShowBattleTeam()

    --是否显示跳过战斗按钮
    ---@type BattleView
    local battleView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.BattleView.Name)
    if battleView then
        local unlockCfg
        if _G.AppSetting.IsAlipay then
            unlockCfg = _G.ConfigManager.discrete_cfg[126102]
        else
            -- 达到VIP7 或者 通关第八章后解锁
            unlockCfg = _G.ConfigManager.discrete_cfg[120008]
        end
        local isUnlock = false
        if unlockCfg then
            for i = 1, #unlockCfg do
                isUnlock = _G.GlobalConditionManager.CheckCondition(_G.table.unpack(unlockCfg[i]))
                if isUnlock then
                    break
                end
            end
        end
        battleView:SetLockSkipBtnShow(isUnlock)
        if not isUnlock then
            if _G.AppSetting.IsAlipay then
                battleView:SetLockSkipBtnSystemTip(3709)
            else
                if _G.AppSetting.IsArraigned then
                    battleView:SetLockSkipBtnSystemTip(3706)
                else
                    battleView:SetLockSkipBtnSystemTip(3704)
                end
            end
        end
    end
end

