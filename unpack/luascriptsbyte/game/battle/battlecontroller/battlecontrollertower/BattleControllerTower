---战斗结束，死亡动画播放之前
---@param tab table 战斗数据
---@param call function 完成回调
function BattleControllerTower:OnFightOverBeforePlayDeathAni(tab, call)
    self.FightResultData = {}
    self.FightResultData.statistics = true
    self.FightResultData.iSWin = tab.winner[1] or tab.skip
    ---ZHJ-20803 自动推图规则与放置副本一致
    self.FightResultData.autonextDisplay = AfkModelIns:CheckAutoNextDisplay()
    self.tab = tab
    self.fight_arg.fight_cmd = tab.cmd
    if not _G.DeadsoulTowerManager:GetInstance():CheckBattleEnd() then
        if tab.winner[1] or tab.skip then
            self:GetFightResult(tab, call)
        else
            require "FriendHelpModel":GetInstance():OpenNpc(nil, nil, 2)
            self.FightResultData.btnDisplay = true
            call()
        end
    else
        -- if tab.skip then
        --     self:GetFightResult(tab, call)
        -- else
        if self.FightResultData.iSWin then
            if _G.BattleManager:GetInstance():HasStatisticsCached() and #_G.DeadsoulTowerManager:GetInstance():GetSceneID() > 1 then
                _G.DeadsoulTowerManager:GetInstance():SetCurStatisticsData(
                    _G.BattleManager:GetInstance():GetStatistics(),
                    self.monsterId
                )
            end
            self.FightResultData.pass = true
            call()
        else
            require "FriendHelpModel":GetInstance():OpenNpc(nil, nil, 2)
            call()
        end
        -- end
    end
end

function BattleControllerTower:GetFightResult(tab, call)
    require("BattleNet"):GetInstance():NpcPVEFightResult(
        tab,
        function(_data)
            if _data.md5_error == "1" then
                _G.PopWindowManager:GetInstance():ShowAllTips(44)
                _G.BattleManager:GetInstance():SaveLogNew()
            elseif _data.md5_error == "2" then
                _G.BattleManager:GetInstance():SaveLogNew()
            end
            self.FightResultData.iSWin = _data.winner[1]
            if self.FightResultData.iSWin then
                self:HandleFightWin(call, _data)
            else
                self.FightResultData.btnDisplay = true
                call()
            end
        end
    )
end

function BattleControllerTower:HandleFightWin(call, _data)
    local DeadsoulTowerManager = _G.DeadsoulTowerManager:GetInstance()
    if _data.ack == 1 then
        self.FightResultData.iSWin = _data.winner[1]
        if _data.winner then
            if _G.BattleManager:GetInstance():HasStatisticsCached() and #_G.DeadsoulTowerManager:GetInstance():GetSceneID() > 1 then
                _G.DeadsoulTowerManager:GetInstance():SetCurStatisticsData(
                    _G.BattleManager:GetInstance():GetStatistics(),
                    self.monsterId
                )
            end
            DeadsoulTowerManager:SetMonsterPass(self.monsterId)
            if DeadsoulTowerManager:CheckCurChallengeIsPass() then
                self.FightResultData.pass = true
                call()
            else
                self.FightResultData.btnDisplay = false
                call()
            end
        end
    else
        self.FightResultData.iSWin = false
        self.FightResultData.btnDisplay = false
        call()
    end
end

