---战斗退出
function BattleControllerTower:OnSettlementEnd(isWin)
    local towerManager = _G.DeadsoulTowerManager:GetInstance()
    if self.FightResultData and not self.FightResultData.pass then
        if _G.MainManager:GetInstance():IsToggledWildWindow(false) then
            --当前选中野外选项卡, 走原始的布阵相关逻辑
            towerManager:SetFighting(false)
            if isWin then
                self:HandleFightV()
            else
                self:HandleFightFail()
            end
        elseif isWin and towerManager:CheckCurrentEmbattleValid() then
            --战斗胜利且满足布阵要求, 直接进入下一场战斗
            towerManager:UpdateNextEmbattle(function(ok, index)
                if ok then
                    towerManager:SetFighting(false)
                    towerManager:EnterFight(nil, index, false)
                else
                    towerManager:ExitFight()
                end
            end)
        else
            --战斗失败或不满足要求, 直接退出战斗
            towerManager:ExitFight()
        end
        return
    end

    _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
    self.curSettlementMsg = nil
    --刷新界面数据
    -- local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DeadsoulTowerView.Name)
    -- local window2 = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DeadsoulView.Name)
    -- if nil == window then
    --     _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DeadsoulTowerView.Name)
    -- end
    -- if nil == window2 then
    --     _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DeadsoulView.Name)
    -- end

    towerManager:ExitFight()
end

