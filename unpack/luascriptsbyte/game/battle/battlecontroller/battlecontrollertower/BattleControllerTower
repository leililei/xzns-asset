---重新布阵
function BattleControllerTower:OnReEmbattle()
    if self.FightResultData and not self.FightResultData.iSWin then
        --战斗失败, 停止自动开始战斗
        _G.DeadsoulTowerManager:GetInstance():ReEmbattle(false, self.index)
    else
        --战斗胜利, 沿用之前的自动战斗设置
        _G.DeadsoulTowerManager:GetInstance():ReEmbattle(true) --ZHJ-33909 多队自动进行下一场
    end
end

---重新开始战斗
function BattleControllerTower:ReFight()
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.CS.UnityEngine.Time.timeScale = 1
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    self:FightExit()
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, false)
    _G.DeadsoulTowerManager:GetInstance():ReEmbattle(false, self.index)
end

---挑战下一关
function BattleControllerTower:OnChallengeNext()
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DeadsoulView.Name)
    if require "DeadsoulTowerModel":GetInstance().CurTowerType == 9 then
        ---获取主塔信息
        ---@param msg dead_soul.s2c_dead_soul_island
        DeadsoulTowerNet:GetInstance():DeadSoulIsland(
            nil,
            function(msg)
                require "DeadsoulTowerModel":GetInstance().LandFloor = msg.high_floor
                require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.DeadsoulPack.id)
                require("RedPointManager"):GetInstance():RefreshNode(
                    _G.ConfigManager.redpoint_cfg.DeadSoulDailyReward.id
                )
                require "DeadsoulTowerModel":GetInstance().target_list = msg.target_list or {}
                require "DeadsoulTowerModel":GetInstance().award_list = msg.award_list or {}
                ---主塔层级达到开试炼的条件
                local isFinishFloor = msg.high_floor
                if isFinishFloor > 0 then
                    isFinishFloor = _G.ConfigManager.tower_cfg[isFinishFloor].layer
                end

                if _G.AppSetting.DEBUG then
                    _G.Log(isFinishFloor, "当前塔层数")
                end
                _G.Events:GetInstance():Broadcast(
                    _G.ePlayAactionEvent.PlayAaction,
                    {
                        _G.ActiveTaskEnum.ConditionEnum.Section.DeadsoulFoor
                    },
                    1
                )
                --首通奖励
                require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                    _G.ConfigManager.redpoint_cfg.DeadsoulFirst.id
                )
                local towerifno =
                    require "DeadsoulTowerModel":GetInstance():InitTowerInfo(
                    require "DeadsoulTowerModel":GetInstance().CurTowerType
                )
                if isFinishFloor >= #towerifno then
                    isFinishFloor = #towerifno
                    require "DeadsoulTowerModel":GetInstance().CurTowerSid = towerifno[isFinishFloor].id
                    require "DeadsoulTowerModel":GetInstance().CurTowerType = towerifno[isFinishFloor].tower
                    local window1 = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DeadsoulView.Name)
                    if window1 then
                        window1.View:UpdateFightFloor()
                    else
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DeadsoulView.Name)
                    end
                    return
                end
                local CurTowerSid = towerifno[isFinishFloor + 1].id

                if _G.AppSetting.DEBUG then
                    _G.Log(CurTowerSid, "下一关层数")
                end
                -- --更新下界面
                if window then
                    window.View:UpdateNextFightFloor()
                end
                _G.DeadsoulTowerManager:GetInstance():SetBattleFirst(true)
                require "DeadsoulTowerModel":GetInstance().CurTowerSid = CurTowerSid
                require "DeadsoulTowerModel":GetInstance().CurTowerType = towerifno[isFinishFloor + 1].tower
                --点下一关直接进入战斗, 不要打开布阵
                --_G.DeadsoulTowerManager:GetInstance():EnterEmbattle(true, 1)
                _G.DeadsoulTowerManager:GetInstance():EnterNextFight(true)
            end
        )
    else
        ---战斗时,点击过了 6点 退出到 死魂选择界面
        if self:OnSixClockUpdateFighting() then
            local win = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name)
            if win then
                win.View:CloseCall(0)
            end
            --选中"野外"选项卡时, 才返回死魂塔页面
            if _G.MainManager:GetInstance():IsToggledWildWindow(false) then
                --刷新界面数据
                local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DeadsoulTowerView.Name)
                if window then
                    window.View:UpdateFightFloor()
                    window.View:Show()
                end
            end
            return
        end
        _G.DeadsoulTowerManager:GetInstance():GetPractice(
            function()
                local type1 = require "DeadsoulTowerModel":GetInstance().CurTowerType
                local PracticeFloor = require "DeadsoulTowerModel":GetInstance().PracticeFloor[type1]
                local dayFightFloor = _G.ConfigManager.discrete_cfg[101801][1][1]

                if _G.AppSetting.DEBUG then
                    _G.Log("福塔的类型：" .. type1)
                end
                --首通奖励
                require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                    _G.ConfigManager.redpoint_cfg.DeadsoulFirst.id
                )
                --目标点奖励
                require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                    _G.ConfigManager.redpoint_cfg.DeadsoulTarget.id
                )
                local isFightFloor = PracticeFloor.pass_num
                if dayFightFloor <= isFightFloor then --今日挑战次数达上限
                    --选中"野外"选项卡时, 才返回死魂塔页面
                    if _G.MainManager:GetInstance():IsToggledWildWindow(false) then
                        if window then
                            _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.DeadsoulView.Name)
                            window.View:UpdateNextFightFloor()
                        else
                            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DeadsoulView.Name, type1)
                        end
                        --五行塔 , 达到次数没有打开 主城
                        --_G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
                    end
                    _G.PopWindowManager:GetInstance():ShowAllTips(390102)
                    return
                end
                --_G.DeadsoulTowerManager:GetInstance():EnterEmbattle()
                local isFinishFloor = PracticeFloor.high_floor
                if isFinishFloor > 0 then
                    isFinishFloor = _G.ConfigManager.tower_cfg[isFinishFloor].layer
                end
                local towerifno = DeadsoulTowerModel:GetInstance():InitTowerInfo(type1)
                if isFinishFloor >= #towerifno then
                    isFinishFloor = #towerifno
                    require "DeadsoulTowerModel":GetInstance().CurTowerSid = towerifno[isFinishFloor].id
                    require "DeadsoulTowerModel":GetInstance().CurTowerType = towerifno[isFinishFloor].tower

                    if window then
                        window.View:UpdateFightFloor()
                    else
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DeadsoulView.Name, type1)
                    end
                    return
                end
                _G.DeadsoulTowerManager:GetInstance():SetBattleFirst(true)
                local CurTowerSid = towerifno[isFinishFloor + 1].id

                if _G.AppSetting.DEBUG then
                    _G.Log("福塔的类型2：" .. towerifno[isFinishFloor + 1].tower)
                end
                require "DeadsoulTowerModel":GetInstance().CurTowerSid = CurTowerSid
                require "DeadsoulTowerModel":GetInstance().CurTowerType = towerifno[isFinishFloor + 1].tower
                if window then
                    window.View:UpdateNextFightFloor()
                end
                --_G.DeadsoulTowerManager:GetInstance():EnterEmbattle(true, 1)
                _G.DeadsoulTowerManager:GetInstance():EnterNextFight(true)
            end
        )
    end
end

---在战斗的时候 跨天刷新六点(点击结算界面)
function BattleControllerTower:OnSixClockUpdateFighting()
    local type1 = require "DeadsoulTowerModel":GetInstance().CurTowerType
    local now = _G.TimeUtil.GetServerUnixTime() - _G.TimeUtil.GAME_DAY_TIME
    local tb = _G.TimeUtil.GetDateTime(now)
    DeadsoulTowerModel:GetInstance().CurWeek = tb.week == 0 and 7 or tb.week
    return not DeadsoulTowerModel:GetInstance():CheckWeek(type1)
end

---加载战斗(协程加载)
function BattleControllerTower:OnLoadRecordFight()
    local et = _G.EmbattleType.Tower
    if DeadsoulTowerModel:GetInstance().CurTowerType ~= 9 then
        et = _G.EmbattleType["Tower" .. DeadsoulTowerModel:GetInstance().CurTowerType]
    end

    local id = 0
    if DeadsoulTowerModel:GetInstance().CurTowerType == DeadsoulTowerModel:GetInstance().MianTower then
        id = _G.EBattleType.Tower
    elseif DeadsoulTowerModel:GetInstance().CurTowerType == 1 then
        id = _G.EBattleType.TowerThunder
    elseif DeadsoulTowerModel:GetInstance().CurTowerType == 2 then
        id = _G.EBattleType.TowerWind
    elseif DeadsoulTowerModel:GetInstance().CurTowerType == 3 then
        id = _G.EBattleType.TowerWater
    elseif DeadsoulTowerModel:GetInstance().CurTowerType == 4 then
        id = _G.EBattleType.TowerFire
    elseif DeadsoulTowerModel:GetInstance().CurTowerType == 5 then
        id = _G.EBattleType.TowerEarth
    end
    _G.BattleManager:initAttackSids(
        require("EmbattleModel"):GetInstance():GetEmbattleData(id),
        et,
        true,
        1,
        0,
        nil,
        nil,
        nil,
        self.leftName,
        self.rightName
    )
end

----检测数据统计是否显示回放战斗
function BattleControllerTower:CheckShowRecordBattle()
    return true
end

---获取怪物组ID
---@return number 怪物组ID
function BattleControllerTower:GetMonsterGroupID()
    return self.mgCfg.id
end

function BattleControllerTower:OnEndFight()
    base.OnEndFight(self)
    _G.DeadsoulTowerManager:GetInstance():ExitFight()
end

function BattleControllerTower:FightOverBeforePlayDeathAni(tab)
    local showEffect = self:IsShowFighting()
    base.FightOverBeforePlayDeathAni(self, tab, showEffect)
end

function BattleControllerTower:LoadFight()
    local world = _G.ePoolType.World
    _G.BattleManager:GetInstance():SetPoolName(world, world, world, world, world)
    self.isMonsherShow = false

    --判断是否显示战斗界面
    if self:IsShowFighting() then
        local towerManager = _G.DeadsoulTowerManager:GetInstance()
        local mgIds = towerManager:GetSceneID()
        local index = nil
        if #mgIds > 1 then
            index = 1
            for _, mgId in pairs(mgIds) do
                if towerManager:CheckMonsterIsPass(mgId) then
                    index = index + 1
                end
            end
        end
        _G.GlobalInterface.OpenMonsterShow(_G.handler(self, self.StartFightNew), self:GetMonsterGroupID(), index)
    else
        --直接开始调用StartFightNew
        self.isMonsherShow = true
    end

    --延时一帧的目的是为了保证布阵场景和战斗角色都放入传递到战斗的节点下
    _G.coroutine.waitforendofframe()
    --调用init方法c#战斗开始加载资源了
    self:OnLoadFight()
    self:StartFightNew()
end

function BattleControllerTower:IsShowFighting()
    if not _G.MainManager:GetInstance():IsToggledWildWindow(true) or
        not _G.DeadsoulTowerManager:GetInstance():IsShowFighting() then
        return false
    end
    return true
end

return BattleControllerTower
