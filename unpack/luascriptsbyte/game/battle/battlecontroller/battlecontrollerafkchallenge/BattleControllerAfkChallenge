---结算完直接退出
---@param result boolean 是否胜利
function BattleControllerAfkChallenge:OnSettlementEnd(result)
    local afkModel = require "AfkModel":GetInstance()
    local afkManager = require("AfkBattleManager"):GetInstance()

    if not self.FightResultData.pass then
        if _G.MainManager:GetInstance():IsToggledAfkWindow(true) then
            --当前选中冒险选项卡, 走原始的布阵相关逻辑
            afkModel:SetCurPage()
            afkManager:SetFighting(false)
            if result then
                self:HandleFightV()
            else
                self:HandleFightFail()
            end
        elseif result and afkManager:CheckCurrentEmbattleValid() then
            --战斗胜利且满足布阵要求, 直接进入下一场战斗
            afkModel:SetCurPage() --设置当前小关卡通关
            --更新布阵数据(多场战斗)
            afkManager:UpdateNextEmbattle(function(ok)
                if ok then
                    afkManager:SetFighting(false)
                    afkManager:NextFight()
                else
                    afkManager:ExitFight()
                end
            end)
        else
            --战斗失败或不满足布阵要求, 直接退出战斗
            afkManager:ExitFight()
        end
        return
    end
    afkManager:ExitFight()
    if result then
        local storyId = _G.WorldManager:GetInstance():CheckAfkAfterAwardStoryID()
        local isHaveFunOpenView = _G.FunctionManager:GetInstance():IsHaveFunOpenView()
        local ShowViewCall
        ShowViewCall = function()
            if not (storyId or isHaveFunOpenView) and afkModel:GetCurSection() > 101003 then
                _G.MainManager:GetInstance():ShowEfficientChanged()
                afkModel:SetHasShowTips(false)
            end
            _G.MainManager:GetInstance():RefreshAfkBoxTip()
        end
