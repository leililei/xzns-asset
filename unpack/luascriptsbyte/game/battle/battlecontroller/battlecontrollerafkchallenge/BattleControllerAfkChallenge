---处理战斗胜利
---@param 变量名 变量类型 中文描述
function BattleControllerAfkChallenge:HandleFightWin(call, _data)
    local AfkModelIns = require("AfkModel"):GetInstance()
    local AfkBattleManagerIns = require("AfkBattleManager"):GetInstance()
    if _data.ack == 1 then
        local isWin = _data.winner and _data.winner[1]
        self.FightResultData.iSWin = isWin
        if isWin then
            --以服务器战斗结果为准
            if #AfkModelIns:GetSceneID() > 1 then
                AfkBattleManagerIns:SetCurStatisticsData(_G.BattleManager:GetInstance():GetStatistics(), self.scene)
            end
            AfkModelIns:SetMonsterPass()
            if AfkModelIns:CheckCurChallengeIsPass() then
                --通关
                self.FightResultData.pass = true
                if 101001 == AfkModelIns:GetCurSection() then
                    _G.SDKManager:GetInstance():GameStepInfo(-70004)
                    _G.SDKManager:GetInstance():MiniGameTrack(require("SDKDef").DotMsg.ShuShu.first_level_pass)
                end
                require("AfkNet"):GetInstance():ChallengeSuc(
                    { sid = AfkModelIns:GetCurSection() },
                    function(data)
                        if data.ack == 1 then
                            AfkModelIns:SetAfkTime(data.time)
                            AfkModelIns:SetCurFailTime(0)
                            _G.PlayerPrefsManager.DeleteKey("MonsterShowiView")
                            local autonextDisplay = false
                            --region VIP 特权 自动推图
                            local f_flag = false
                            local data1 = require "PrivilegeManager":GetInstance():GetPrivilegeData(
                                { _G.PrivilegeType.VIP.unlockFunction }
                            )
                            if data1 and data1[1] then
                                local count = 1
                                local check_type = type(data1[1])
                                if check_type == "number" then
                                    -- 检测是不是数值类型
                                    count = 1
                                else
                                    count = 2
                                end
                                for i = 1, #data1 do
                                    local fun_id = 0
                                    if count < 2 then
                                        fun_id = data1[i]
                                    else
                                        fun_id = data1[i][2]
                                    end
                                    if fun_id == 69 then
                                        f_flag = true
                                    end
                                end
                            end
                            --endregion
                            if AfkModelIns:CheckAutoNextDisplay() or f_flag then
                                autonextDisplay = true
                            end
                            if not autonextDisplay then
                                if _G.AppSetting.IsArraigned then
                                    self.FightResultData.bottomTip = _G.GetLangPackValue(90000001253)
                                else
                                    self.FightResultData.bottomTip = _G.GetLangPackValue(90000000911)
                                end
                            end
                            self.FightResultData.funcForecast = self:GetAfkForecast()
                            AfkModelIns:SetLastSection(AfkModelIns:GetCurSection())
                            AfkModelIns:SetCurPage()
                            AfkModelIns:SetHasShowTips(true)
                            local curafkchapterid = AfkModelIns:GetCurAfkChapter()
                            self.FightResultData.lastChapterID = curafkchapterid
                            AfkModelIns:UnlockSection()
                            _G.Events:GetInstance():Broadcast(
                                _G.ePlayAactionEvent.PlayAaction,
                                {
                                    _G.ActiveTaskEnum.ConditionEnum.AFK.IsPass,
                                    AfkModelIns:GetLastSection()
                                },
                                1
                            )
                            ---当前大章节结束判断红点宝箱
                            self:JinDuBaoXiangPanDuan()
                            require("RedPointManager"):GetInstance():RefreshNode(
                                _G.ConfigManager.redpoint_cfg.FirstGather.id
                            )
                            _G.Events:GetInstance():Broadcast(_G.eAFKAactionEnum.AfkSectionPass)
                            self.FightResultData.task = self:GetBattleTask()
                            local ChapterAwardBoxGet = AfkModelIns:CheckNewChapterAwardIsGet()
                            self.FightResultData.afktips = AfkModelIns:ComputeTarget()
                            _G.Events:GetInstance():Broadcast(_G.eAfkEvents.Pass)
                            _G.StorageManager:GetInstance():ReceiveAwardData(data)
                            local storyid = _G.WorldManager:GetInstance():CheckAfkAfterAwardStoryID()
                            --检查下一关布阵是否存在空阵容(仅当MainView afk未选中时)
                            local nextEmbattleOk = true
                            if not self:IsShowFighting() then
                                ---@type EmbattleModel
                                local embattleModel = require("EmbattleModel"):GetInstance()
                                local embattleIds = require("AfkBattleManager"):GetInstance():GetCurEmbattleID()
                                for _, embattleId in pairs(embattleIds) do
                                    if not embattleModel:CheckEmbattleData(embattleId) then
                                        nextEmbattleOk = false
                                        autonextDisplay = false
                                        break
                                    end
                                end
                            end
                            if
                            autonextDisplay ~= false and storyid == nil and
                                _G.FunctionManager:GetInstance():AfkIsBack() == false and
                                not ChapterAwardBoxGet
                            then
                                self.FightResultData.autonextDisplay = autonextDisplay
                            end
                            self.FightResultData.showTwoBtn = true
                            self.FightResultData.btnDisplay = true
                            local preCfg = AfkModelIns:GetPreviousSectionCfg()
                            if
                            _G.FunctionManager:GetInstance():AfkIsBack() or not nextEmbattleOk or
                                (preCfg and preCfg.AfterBattleButton == 1) or
                                not AfkModelIns:CheckNextSectionCondition()
                            then
                                --显示"返回"而不显示"下一关"
                                self.FightResultData.back = true
                                ---显示返回按钮时，不再显示自动挑战
                                self.FightResultData.autonextDisplay = false
                                self.FightResultData.emptyNotBack = true
                            end
                            self.FightResultData.AwardData = _G.StorageManager:GetInstance():MergeAward(data)
                            local cfg = _G.ConfigManager.discrete_cfg[100143]
                            if cfg and cfg[1][1] == AfkModelIns.LastSid then
                                self.FightResultData.MvpCardSid = cfg[1][2]
                            end
                            require("AfkBattleManager"):GetInstance():InitCurEmbattleSids()
                            _G.PopWindowManager:GetInstance():CardAwardTipView()
                            _G.PopWindowManager:GetInstance():AddInitialPopQuene()

                            _G.Events:GetInstance():Broadcast(_G.eEscapeRoomChallenge.AfkPass)
                        else
                            self.FightResultData.pass = false
                            self.FightResultData.iSWin = false
                            AfkModelIns:ResetPass()
                            --通关数据异常, 清除一下记录数据防止卡死
                            AfkBattleManagerIns:ClearStatisticsData()
                        end
                        call()
                    end
                )
            else
                --下一组怪
                -- self:HandleFightFail()
                self.FightResultData.btnDisplay = false
                call()
            end
        else
            -- self:HandleFightFail()
            if #AfkModelIns:GetSceneID() == 1 then
                self.FightResultData.btnDisplay = true
            else
                self.FightResultData.btnDisplay = false
            end
            call()
        end
    else
        --服务器返回错误 按失败处理
        -- self:HandleFightFail()
        self.FightResultData.iSWin = false
        self.FightResultData.btnDisplay = false
        call()
    end
end

--判断当前ID是否满足进度宝箱
function BattleControllerAfkChallenge:JinDuBaoXiangPanDuan()
    local id = 253010001
    local itemData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, id)
    if itemData ~= nil then
        local NowGetNum = itemData.progress or 0
        if NowGetNum > 0 then
            ---红点显示 道具
            require("RedPointManager"):GetInstance():RefreshNode(
                _G.ConfigManager.redpoint_cfg.BackpackItem.id,
                253010001
            )
        end
    end
end

---函数功能注释
---@param call function 结算回调(SettlementItemBase子对象,结算参数)
function BattleControllerAfkChallenge:OnSettlement(call)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    --- 只有胜利 才播放战后剧情
    if self.FightResultData.iSWin == true then
        self:CreateResultEff(
            function()
                local cfg = require("AfkModel"):GetInstance():GetPreviousSectionCfg()
                if
                cfg and cfg.AfterBattleStoryID > 0 and
                    _G.StoryUtilities.HasStoryIDSavedUID(cfg.AfterBattleStoryID) == false
                then
                    _G.AutomaticPlayStory.PlayStoryByID(
                        cfg.AfterBattleStoryID,
                        function()
                            call(_G.SettlementModel.SettlementType.afkChallenge, self.FightResultData)
                            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
                        end
                    )
                else
                    call(_G.SettlementModel.SettlementType.afkChallenge, self.FightResultData)
                    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
                end
            end
        )
    else
        self:CreateResultEff(
            function()
                call(_G.SettlementModel.SettlementType.afkChallenge, self.FightResultData)
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
            end
        )
    end
end

---@return task i_task
function BattleControllerAfkChallenge:GetBattleTask()
    local task = {}
    if
    _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.ActiveTask) or
        _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Achievement)
    then
        local taskid = require "AfkModel":GetInstance():GetSidTaskCom()
        local _i_task
        if taskid then
            _i_task = require "ActiveTaskManager":GetInstance():GetTaskByTaskid(taskid)
        end
        if _i_task then
            task.desc = _G.LangUtil.GetLangPackValue(_G.ConfigManager.mission_cfg[_i_task.i_task.sid].desc)
            task.finish = _i_task.i_task.state == 5
            task.progress = _i_task.i_task.state == 5 and "(1/1)" or "(0/1)"
        end
        return task
    end
end

function BattleControllerAfkChallenge:GetAfkForecast()
    local forecast = {}
    local sid = require "AfkModel":GetInstance():GetCurSection()
    local afkOpenArr = _G.FunctionManager:GetInstance():GetAfkFuncOpenArr()
    if afkOpenArr then
        for k, v in pairs(afkOpenArr) do
            if
            sid <= v[1] and #v[2] > 0 and --- ZHJ-17634【客户端】功能预告提前解锁优化VIP提前解锁功能后，对应的功能预告不再提示，返回按钮若已提前开放则不再显示；
                not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(v[3])
            then
                forecast.finish = sid == v[1]
                forecast.desc = _G.LangUtil.GetLangPackValue(v[2][1])
                if #v[2] > 1 then
                    forecast.item = v[2][2]
                end
                forecast.progress = "(" .. afk_cfg[sid].number .. "/" .. afk_cfg[v[1]].number .. ")"
                break
            end
        end
    end

    return forecast
end

