---挑战下一关
function BattleControllerAfkChallenge:OnChallengeNext()
    local afkModel = require("AfkModel"):GetInstance()
    local sectionID = afkModel:GetSceneID()
    local curSid = afkModel:GetCurSection()
    if #sectionID > 0 then
        if afk_cfg[curSid].next_section > 0 then
            if afkModel:CheckNextSectionCondition(true) then
                self.retainPool = true
                local afkManager = require("AfkBattleManager"):GetInstance()
                local nextE = afkModel:GetSceneID()
                if nextE and #nextE > 1 then
                    --更新布阵数据(多场战斗)
                    afkManager:UpdateNextEmbattle(function(ok)
                        if ok then
                            afkManager:NextFight()
                        elseif _G.MainManager:GetInstance():IsToggledAfkWindow(true) then
                            afkManager:EnterEmbattle(true)
                        else
                            afkManager:ExitFight()    
                        end
                    end)
                elseif afkManager:CheckCurrentEmbattleValid() then
                    afkManager:NextFight()
                else
                    afkManager:EnterEmbattle(false)
                end
            else
                _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
            end
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(210108)
            _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
        end
    end
    _G.FunctionManager:GetInstance():DoFunctionAction(_G.FunctionTouchType.Afk)
end

