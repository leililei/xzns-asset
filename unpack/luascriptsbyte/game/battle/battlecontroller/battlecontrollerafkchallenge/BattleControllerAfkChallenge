-----检测是否可以进入战斗
---@param callback function 检测后的回调(参数bool)
function BattleControllerAfkChallenge:CheckFight(call)
    local AfkModelIns = require("AfkModel"):GetInstance()
    local port = AfkModelIns:FightBegin(
        self.scene,
        function(data)
            if data.ack ~= 1 then
                self:ExitLoading()
                call(false, data.ack)
            else
                self.mgCfg = _G.ConfigManager.monster_group_cfg[data.fight_arg.sid]
                require "AfkBattleManager":GetInstance():SetCurFightArg(data.fight_arg, data.fight_arg.sid)
                call(true)
            end
        end
    )
    _G.BattleManager:GetInstance():AddLuaNetEvent(port)
end

---战斗验证不通过
---@param msg string 错误信息
function BattleControllerAfkChallenge:OnCheckFail(msg)
