---战斗退出
function BattleControllerAfkChallenge:FightExit()
    base.FightExit(self)
    --战斗结束, 销毁RoleParent缓存(缓存布阵丶战斗相关节点)
    _G.WorldManager:GetInstance():DespawnRoleParent()
    --战斗逻辑处理
    _G.BattleManager:GetInstance():SetCineAndVisualCam(false)
    _G.BattleManager:GetInstance():SetSceneObjActive(false)

    require("AfkBattleManager"):GetInstance():SetFighting(false)
    _G.MainManager:GetInstance():RefreshAfkWindow()
    _G.MainManager:GetInstance():RefreshAfkToggleEffect()
    _G.PopWindowManager:GetInstance():CheckPopQunue()
end

