---加载战斗
function BattleControllerAfkChallenge:LoadFight()
    _G.Log("协程结束  LoadFight     " .. self.__cname)
    local world = _G.ePoolType.World
    _G.BattleManager:GetInstance():SetPoolName(world, world, world, world, world)
    self.isMonsherShow = false
    local monsterGroupId = self:GetMonsterGroupID()
    local value = _G.PlayerPrefsManager.GetTable("MonsterShowiView")
    local notShow = false
    if value then
        for i = 1, #value do
            if value[i] == monsterGroupId then
                notShow = true
            end
        end
    end
    --判断是否显示战斗界面
    if self:IsShowFighting() then
        local afkModel = require("AfkModel"):GetInstance()
        --ZHJH-758【客户端】视频添加(首次进入游戏丶首次进入1-6)
        local next
        if not notShow and afkModel:GetCurSection() == 101006 then
            if _G.AppSetting.IsXzns then
                next = _G.handler(self, self.StartFightNew)
            else
                next = function()
                    _G.UIUtils.PlayVideo(_G.ConfigManager.video_cfg.hlnfln, _G.handler(self, self.StartFightNew))
                end
            end
        else
            next = _G.handler(self, self.StartFightNew)
        end
        --展示"战斗开始"特效和"MonsterShow"效果
        local mgIds = afkModel:GetSceneID()
        local index = nil
        if #mgIds > 1 then
            index = 1
            for _, mgId in pairs(mgIds) do
                if afkModel:CheckMonsterIsPass(mgId) then
                    index = index + 1
                end
            end
        end
        _G.GlobalInterface.OpenMonsterShow(next, self:GetMonsterGroupID(), notShow, index)
    else
        --直接开始调用StartFightNew
        self.isMonsherShow = true
    end
    --延时一帧的目的是为了保证布阵场景和战斗角色都放入传递到战斗的节点下
    _G.coroutine.waitforendofframe()
    --调用init方法c#战斗开始加载资源了
    self:OnLoadFight()
    self:StartFightNew()
    local mcfg = _G.ConfigManager.monster_group_cfg[monsterGroupId]
    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, mcfg.audio)
end

---战前剧情完成后 开始战斗
function BattleControllerAfkChallenge:OnPlayBattleFrontStoryEnd()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    _G.BattleManager:GetInstance():ShowBattleTeam()

    if _G.ConfigManager.discrete_cfg[discreteID.SkipBattle][1][1] == 1 then
        local showSkip = false
        local curSid = require("AfkModel"):GetInstance():GetCurSection()
        local cfg = afk_cfg[curSid]
        if
        cfg.type_section == 1 and cfg.FrontBuzhenStoryID == 0 and cfg.FrontBattleStoryID == 0 and
            cfg.AfterBattleStoryID == 0 and
            cfg.AfterAwardStoryID == 0
        then
            local teachMonsterGroups = _G.ConfigManager.discrete_cfg[discreteID.SkipBattle][1]
            local isTeach = false
            for k, v in pairs(teachMonsterGroups) do
                if v == self.mgCfg.id then
                    isTeach = true
                    break
                end
            end
            if not isTeach then
                -- local isUnlock = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(SkipBattleFunctionOpenID)
                -- if not isUnlock then

                --     local cfg = _G.ConfigManager.function_open_cfg[SkipBattleFunctionOpenID]
                --     if cfg then
                --         local battleView =
                --             _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.BattleView.Name)
                --         if battleView then
                --             battleView:SetLockSkipBtnShow(cfg.is_display)
                --         end
                --         showSkip = true
                --     end
                -- else
                --     local skipDisableTime = _G.ConfigManager.discrete_cfg[discreteID.SkipBattleTime][1][1]
                --     _G.BattleManager:GetInstance():ShowSkipBattleBtn(true, skipDisableTime)
                --     showSkip = true
                -- end
                local battleView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.BattleView.Name)
                if battleView then
                    local unlockCfg
                    if _G.AppSetting.IsAlipay then
                        -- 达到VIP4 或者 通关第5章后解锁
                        unlockCfg = _G.ConfigManager.discrete_cfg[126102]
                    else
                        -- 达到VIP7 或者 通关第八章后解锁
                        unlockCfg = _G.ConfigManager.discrete_cfg[120008]
                    end
                    local isUnlock = false
                    if unlockCfg then
                        for i = 1, #unlockCfg do
                            isUnlock = _G.GlobalConditionManager.CheckCondition(_G.table.unpack(unlockCfg[i]))
                            if isUnlock then
                                break
                            end
                        end
                    end
                    battleView:SetLockSkipBtnShow(isUnlock)
                    if not isUnlock then
                        if _G.AppSetting.IsAlipay then
                            battleView:SetLockSkipBtnSystemTip(3709)
                        else
                            if _G.AppSetting.IsArraigned then
                                battleView:SetLockSkipBtnSystemTip(3706)
                            else
                                battleView:SetLockSkipBtnSystemTip(3704)
                            end
                        end
                    else
                        local skipDisableTime = _G.ConfigManager.discrete_cfg[discreteID.SkipBattleTime][1][1]
                        _G.BattleManager:GetInstance():ShowSkipBattleBtn(true, skipDisableTime)
                    end
                    showSkip = true
                end
            end
        end
        if not showSkip then
            local battleView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.BattleView.Name)
            if battleView then
                --(策划)只要未解锁, 则固定显示解锁条件, 否则才显示"需要亲历亲为"
                local unlockCfg = _G.ConfigManager.discrete_cfg[120008]
                local isUnlock = false
                if unlockCfg then
                    for i = 1, #unlockCfg do
                        isUnlock = _G.GlobalConditionManager.CheckCondition(_G.table.unpack(unlockCfg[i]))
                        if isUnlock then
                            break
                        end
                    end
                end
                battleView:SetLockSkipBtnShow(false)
                local tipId
                if _G.AppSetting.IsAlipay then
                    tipId = 3709
                else
                    if _G.AppSetting.IsArraigned then
                        tipId = 3706
                    else
                        tipId = 3704
                    end
                end
                battleView:SetLockSkipBtnSystemTip(isUnlock and 220104 or tipId)
            end
        end
    end
end

