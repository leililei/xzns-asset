---战斗结束，死亡动画播放之前
---@param tab table 战斗数据
---@param call function 完成回调
function BattleControllerAfkChallenge:OnFightOverBeforePlayDeathAni(tab, call)
    self.FightResultData = {}
    self.FightResultData.statistics = true
    self.FightResultData.iSWin = tab.winner[1] or tab.skip
    local AfkModelIns = require("AfkModel"):GetInstance()
    if #AfkModelIns:GetSceneID() > 1 then
        require "AfkBattleManager":GetInstance():SetLastFightCmd(tab.cmd)
    end
    if tab.winner[1] or tab.skip then
        require("BattleNet"):GetInstance():NpcPVEFightResult(
            tab,
            function(_data)
                if _data.md5_error == "1" then
                    _G.PopWindowManager:GetInstance():ShowAllTips(44)
                    _G.BattleManager:GetInstance():SaveLogNew()
                elseif _data.md5_error == "2" then
                    _G.BattleManager:GetInstance():SaveLogNew()
                end
                self.FightResultData.iSWin = _data and _data.winner and _data.winner[1]
                AfkModelIns:SetCurFailTime(_data.fail_time or 0)
                if #AfkModelIns:GetSceneID() == 1 then
                    --ZHJH-1604【放置推图】失败时，低概率弹出旧版的弹窗
                    --ZHJH-2891【战斗】战斗服异常时，失败界面是旧的UI界面
                    --单队关卡失败时, 直接弹出结算面板而非小结算面板
                    self.FightResultData.pass = true
                end
                self:HandleFightWin(call, _data)
                _G.Events:GetInstance():Broadcast(_G.eSeasonTask.Action, { _G.SeasonTaskID.Akf }, 1)
            end
        )
    else
        ---发送失败结算显示敌方阵容详情
        require("BattleNet"):GetInstance():NpcPVEFightResult(
            tab,
            function(_data)
                if _data.md5_error == "1" then
                    _G.PopWindowManager:GetInstance():ShowAllTips(44)
                    _G.BattleManager:GetInstance():SaveLogNew()
                elseif _data.md5_error == "2" then
                    _G.BattleManager:GetInstance():SaveLogNew()
                end
                AfkModelIns:SetCurFailTime(_data.fail_time or 0)
                self.FightResultData.btnDisplay = true
                if #AfkModelIns:GetSceneID() == 1 then
                    self.FightResultData.pass = true
                end
                call()
                _G.Events:GetInstance():Broadcast(_G.eSeasonTask.Action, { _G.SeasonTaskID.Akf }, 1)

                if _data.winner[1] == false then
                    --local AfkModel = require("AfkModel"):GetInstance()
                    --local curSid = AfkModel:GetCurSection()

                    require "PopUpGiftBagModel":GetInstance():IsPlaceFailed()
                    --curSid)
                end
            end
        )
    end
end

