    require("AfkBattleManager"):GetInstance():SetFighting(false)
    require("AfkBattleManager"):GetInstance():EnterEmbattle()
end

---加载战斗(协程加载)
function BattleControllerAfkChallenge:OnLoadFight()
    local ePoolType = _G.ePoolType
    local BattleManagerIns = _G.BattleManager:GetInstance()
    BattleManagerIns:SetPoolName(
        ePoolType.Static,
        ePoolType.World,
        ePoolType.World,
        ePoolType.Default,
        ePoolType.Default
    )
    self.State = nil
    local uiManager = _G.UIManager:GetInstance()
    local ui_cfg = _G.ConfigManager.ui_cfg
    local battleView = uiManager:OpenWindow(ui_cfg.BattleView.Name).View
    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    battleView:Hide()
    local AfkModel = require("AfkModel"):GetInstance()
    local curSid = AfkModel:GetCurSection()
    local cfg = afk_cfg[curSid]
    local str = string.format("%d-%d", cfg.chapter, cfg.section)
    BattleManagerIns:initAttackSids(
        nil,
        _G.EBattleType.AfkChallenge,
        true,
        0,
        0,
        nil,
        str,
        nil,
        self.leftName,
        self.rightName
    )
    while BattleManagerIns.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    local FunctionManagerIns = _G.FunctionManager:GetInstance()
    if _G.AppSetting.IsAlipay then
        local conditions = _G.ConfigManager.discrete_cfg[126101]
        battleView:SetSpeedBtnActive(_G.GlobalConditionManager.CheckCondition(conditions[1][2],conditions[1][3]))
    else
        battleView:SetSpeedBtnActive(FunctionManagerIns:CheckFunctionIsUnlock(SpeedFunctionOpenID))
    end
    battleView:SetAutoBtnActive(FunctionManagerIns:CheckFunctionIsUnlock(AutoFightFunctionOpenID))
    battleView:SetSettingBtnActive(true)
    uiManager:CloseWindow(ui_cfg.EmbattleView.Name)
    uiManager:CloseWindow(ui_cfg.AfkEmbattleView.Name)
    --_G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    _G.coroutine.waitforendofframe()
    battleView:SetCanvasGroupTrue()
end

---战斗开始
function BattleControllerAfkChallenge:OnStart()
    local model = require("AfkModel"):GetInstance()
    self.State = ShowType.Loaded
    model:SetCurMonsterID(self.scene)
    --对于1-6关卡, 启用特殊剧情
    if model:GetCurSection() == 101006 then
        _G.BattleManager:GetInstance():CreateStory(101006)
    end

    if self:DisplayStopSettingsBtns() then
        _G.BattleManager:GetInstance():SetPauseBtnState(1, 1, 1)
    else
        _G.BattleManager:GetInstance():SetPauseBtnState(0, 0, 1)
    end
    self:OnBossShowEndDurationTimeEnd(self.State)
end

