---@class BattleControllerTryPlay	中文描述
local BattleControllerTryPlay = _G.BaseClass("BattleControllerTryPlay", _G.BattleControllerBase)

local CS = _G.CS
local typeof = _G.typeof

local ShowType = {
    Loaded = 1,
    ShowEnd = 2
}

---类的构造函数
function BattleControllerTryPlay:__init()
end

---类的析构函数
function BattleControllerTryPlay:Dispose()
end

--region 子类重写方法
---处理传参
---@param sid number 房间sid
function BattleControllerTryPlay:OnHandleParams(scene, bool, AttackUids, DefenceSids, data, type)
    self.scene = scene
    self.bool = bool

    self.attackUids = AttackUids
    self.defenceSids = DefenceSids

    self.data = data
    self.curBattleType = type
    -- self.super.HandleParams(self)
end
-----检测是否可以进入战斗
---@param callback function 检测后的回调(参数bool)
function BattleControllerTryPlay:CheckFight(call)
    if self.curBattleType == _G.EBattleType.TryPlay then --导入的战报战斗
        ---设置战报
        call(true)
    elseif self.curBattleType == _G.EBattleType.TestOnline then
        -- 测试带数据的战斗
        call(false)
    end
end
---战斗验证不通过
---@param msg string 错误信息
function BattleControllerTryPlay:OnCheckFail(msg)
    self.super.OnCheckFail(self)
end
---加载战斗(协程加载)
function BattleControllerTryPlay:OnLoadFight()
    -- _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.CommonIllustrationsH5View.Name)
    self.Loaded = false
    self.ShowEnd = false
    self.BossShow = nil
    self.BossShowTime = 0
    self.State = nil
    local uiManager = _G.UIManager:GetInstance()
    uiManager:HideWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)

    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        local dc = {}
        dc.HideWorld = false
        _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)

        _G.coroutine.waitforendofframe()
    end
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    local showStartView = false

    if self.type == _G.EBattleType.NormalAlone then
    -- showStartView = true
    -- _G.UIUtils.ProloadMaskVideo(
    --     "OpenDoor01",
    --     "OpenDoor01_mask",
    --     "Images/Bg/battlestartbg",
    --     function()
    --         showStartView = false
    --     end
    -- )
    -- while showStartView do
    --     _G.coroutine.waitforendofframe()
    -- end
    end
    if self.type == _G.EBattleType.NormalAlone then
        _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(false)
    end
    --
    -- 获取布阵信息
    -- local fighterSids = require("EmbattleModel"):GetInstance():GetEmbattleSidsData()
    local battleManager = _G.BattleManager:GetInstance()

    _G.BattleManager:GetInstance():BeginTryPlayBattle(
        self.scene,
        true,
        self.attackUids,
        self.defenceSids,
        self.data,
        self.curBattleType,
        nil
    )
    self.mgCfg = _G.ConfigManager.monster_group_cfg[self.scene]

    -- battleManager:SetRoleParent(_G.WorldManager:GetInstance():GetItemParent())
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    if self.type == _G.EBattleType.NormalAlone then
        battleView.View:SetCanvasGroupTrue()
    else
        -- self.super.LoadFight(self)
        battleView.View:SetCanvasGroupTrue()
    end
end
---战斗开始
function BattleControllerTryPlay:OnStart()
    -- self.super.OnStart(self)
    self.Loaded = true
    ---保存数据
    _G.TestBattleManager:GetInstance():SaveEmbattleData(self.attackUids, self.defenceSids)
    self.State = ShowType.Loaded
    _G.BattleManager:GetInstance():SetPauseBtnState(0, 1, 1)
    local uiManager = _G.UIManager:GetInstance()
    uiManager:ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    local view = uiManager:GetWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    if view then
        view.View:SetAutoBtnActive(false)
        view.View.AtActive = false
    end
    _G.BattleManager:GetInstance():SetAutoMasterSkill(0, true)
    self:OnBossShowEndDurationTimeEnd(self.State)
end
---战斗结束
---@param tab table 战斗数据
function BattleControllerTryPlay:OnFightResult(tab, call)
    _G.BattleManager:GetInstance():DestroyBattle(self:GetRetainpool())
    --self:OnSettlement(tab)
    self:OnSettlementEnd()
end
---打开结算界面
---@param name string 结算界面名称
---@param result table 结算参数
function BattleControllerTryPlay:OnSettlement(result, call)
    result.statistics = true
    result.iSWin = true
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
        _G.handler(self, self.OnSettlementEnd),
        result
    )
end
---战斗退出
function BattleControllerTryPlay:OnSettlementEnd()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.CommonIllustrationsH5View.Name)
end
--endregion

--BOSS出场表演结束，开始战斗
function BattleControllerTryPlay:OnBossShowEndDurationTimeEnd(state)
    if not self.Loaded then
        return
    end
    if state == ShowType.Loaded then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    end
    self.BossShow = nil
    self.BossShowTime = nil
    self.State = nil
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()
    ---跳过战前剧情
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    _G.BattleManager:GetInstance():ShowBattleTeam()

    --图鉴试玩-隐藏宠物技节点(需等待SkillView加载)
    _G.BattleManager:GetInstance():SetPetSkillActive(false)
end

---手动停止战斗
function BattleControllerTryPlay:EndFight()
    self:OnSettlementEndCall()
end
---重新开始战斗
function BattleControllerTryPlay:ReFight()
    _G.BattleManager:GetInstance():ReFight()
end

---获取怪物组ID
---@return number 怪物组ID
function BattleControllerTryPlay:GetMonsterGroupID()
    return self.scene
end

return BattleControllerTryPlay
