---@class BattleControllerAfk2 : Singleton	灵域巡查战斗控制器
local BattleControllerAfk2 = _G.BaseClass("BattleControllerAfk2", _G.BattleControllerBase)

---@return BattleControllerAfk2
function BattleControllerAfk2:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function BattleControllerAfk2:__init()
end

function BattleControllerAfk2:OnHandleParams(sid, monsterId)
    self.sid = sid
    self.monsterId = monsterId
    self.embattleType = _G.EmbattleType.afk2
end

function BattleControllerAfk2:CheckFight(call)
    self.checkCall = call
    local pbData = {sid = self.sid, monster_sid = self.monsterId}
    local port = require("Afk2Net"):GetInstance():SatrtFight(pbData, _G.handler(self, self.OnFightMsgCall))
    _G.BattleManager:GetInstance():AddLuaNetEvent(port)
end

function BattleControllerAfk2:OnFightMsgCall(msg)
    if msg.ack == 1 then
        self.mgCfg = _G.ConfigManager.monster_group_cfg[msg.fight_arg.sid]
        self.checkCall(true)
    else
        self.checkCall(false, msg.ack)
    end
    self.checkCall = nil
end

---加载战斗(协程加载)
function BattleControllerAfk2:OnLoadFight()
    local uiManager = _G.UIManager:GetInstance()
    -- uiManager:CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)

    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    --battleView.View:SetSettingBtnActive(false)
    _G.BaseBattleManager:GetInstance():ClearView(false)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SystemFairylandEmbattleView.Name)
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(false)
    local battleManager = _G.BattleManager:GetInstance()
    local fighterSids = require("EmbattleModel"):GetInstance():GetEmbattleData(self.embattleType)
    battleManager:initAttackSids(fighterSids, self.embattleType, true, 0, 0, 0)
    -- 协程等待
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    battleView.View:SetCanvasGroupTrue()
end

---战斗开始
function BattleControllerAfk2:OnStart()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    -- self.super.OnStart(self)
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.BattleManager:GetInstance():SetBattleStart()
    _G.BattleManager:GetInstance():ShowBattleTeam()
end

---战斗结束
---@param tab table 战斗数据
function BattleControllerAfk2:OnFightResult(tab, call)
    self.FightResult = tab
    call()
end

---结算
function BattleControllerAfk2:OnSettlement(call)
    call(_G.SettlementModel.SettlementType.afk2, self.FightResult, self.sid, self.monsterId)
end

---战斗退出
function BattleControllerAfk2:OnSettlementEnd()
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(true)
    _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
    _G.WorldManager:GetInstance():DespawnRoleParent()

    require("Afk2Model"):GetInstance():ShowWindows()
end

---重开战斗
function BattleControllerAfk2:ReFight()
    _G.BattleManager:GetInstance():DestroyBattle()
    require("Afk2Model"):GetInstance():ReFight()
end

---挑战下一关
function BattleControllerAfk2:OnChallengeNext()
    require("Afk2Model"):GetInstance():Fight(true)
end

--- 退出关卡
function BattleControllerAfk2:EndFight()
    _G.BattleManager:GetInstance():PauseBattle(true)
    self:OnFightResult(nil, _G.handlerbind(self, self.OnSettlement, _G.handler(self, self.StartSettlement)), true)
end

function BattleControllerAfk2:OnReEmbattle()
    _G.BattleManager:GetInstance():DestroyBattle()
    require("Afk2Model"):GetInstance():ReFight()
end
function BattleControllerAfk2:OnLoadRecordFight()
    _G.BattleManager:GetInstance():initAttackSids(nil, self.embattleType, true, 1)
end
---获取怪物组ID
---@return number 怪物组ID
function BattleControllerAfk2:GetMonsterGroupID()
    return self.mgCfg.id
end

function BattleControllerAfk2:CheckShowRecordBattle()
    return true
end

---销毁对象时,析构函数
function BattleControllerAfk2:Dispose()
end

return BattleControllerAfk2
