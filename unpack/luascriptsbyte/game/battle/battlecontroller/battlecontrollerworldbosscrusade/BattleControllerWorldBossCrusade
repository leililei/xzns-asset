function BattleControllerWorldBossCrusade:StartLoadingRecordFight(index, notInBattle)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.WorldBossBattleView.Name)
    _G.BattleManager:GetInstance():SetInRecordBattle(true)
    self.stopCoProgress = _G.coroutine.start(_G.handlerbind(self, self.LoadRecordFight, index, notInBattle))
    --self:StartRecordFight()
end

