local BattleControllerWorldBossCrusade = _G.BaseClass("BattleControllerWorldBossCrusade", _G.BattleControllerBase)

---类的构造函数
function BattleControllerWorldBossCrusade:__init()
end

---类的析构函数
function BattleControllerWorldBossCrusade:Dispose()
end

--region 子类重写方法
---处理传参
---@param bossNames string[]
function BattleControllerWorldBossCrusade:OnHandleParams(id, leftName, bossNames)
    self.id = id
    self.index = 1
    self.leftName = leftName
    self.bossNames = bossNames or {}
    self.cfg = _G.ConfigManager.boss_cfg[id]
end

---进入回放战斗
---@param index number 回放场次索引
---@param notInBattle boolean 当前是否在战斗场景
function BattleControllerWorldBossCrusade:EnterRecordFight(...)
    local args = { ... }
    self.index = 1
    self.leftName = args[4] or self.leftName
    self.bossNames = args[5] or self.bossNames
    self.super.EnterRecordFight(self, ...)
end

-----检测是否可以进入战斗
---@param callback function 检测后的回调(参数bool)
function BattleControllerWorldBossCrusade:CheckFight(call)
    call(true)
end

---战斗验证不通过
---@param msg string 错误信息
function BattleControllerWorldBossCrusade:OnCheckFail(msg)
    self.super.OnCheckFail(self)
end

---加载战斗(协程加载)
function BattleControllerWorldBossCrusade:OnLoadFight()
    local uiManager = _G.UIManager:GetInstance()
    --uiManager:CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)
    local battleStartView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    while (_G.IsNil(battleStartView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    _G.coroutine.waitforendofframe()
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    local battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    battleView.View:SetSettingBtnActive(false)
    uiManager:HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    battleView = uiManager:OpenWindow(_G.ConfigManager.ui_cfg.WorldBossBattleView.Name)
    self.battleView = battleView.View
    while (_G.IsNil(battleView.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    --self:CacheBattleRes()
    _G.coroutine.waitforendofframe()
    _G.BattleManager:GetInstance():SetArgData()
    local score = require("WorldBossModel"):GetInstance():GetMaxScore()
    _G.BattleManager:GetInstance():SetDescriptionGroup(nil, self.bossNames)
    _G.BattleManager:GetInstance():initAttackSids(
        nil,
        _G.EBattleType.WorldBossDamageTest,
        true,
        nil,
        nil,
        nil,
        nil,
        score,
        self.leftName,
        self.bossNames[self.index]
    )

    local battleManager = _G.BattleManager:GetInstance()
    while battleManager.Progress < 1 do
        _G.coroutine.waitforendofframe()
    end
    local mcfg = _G.ConfigManager.monster_group_cfg[_G.ConfigManager.arena_info_cfg[2].battle_sences]
    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, mcfg.audio)
    uiManager:GetWindowCtrl(_G.ConfigManager.ui_cfg.BattleView.Name):SetCanvasGroupTrue()
end

---战斗开始
function BattleControllerWorldBossCrusade:OnStart()
    local uiManager = _G.UIManager:GetInstance()
    uiManager:CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    uiManager:ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    uiManager:ShowWindow(_G.ConfigManager.ui_cfg.WorldBossBattleView.Name)
    _G.BattleManager:GetInstance():SetBattlePause(true)
    _G.DelayDo(
        2,
        function()
            self.battleView:OnBattleBegin(
                function()
                    _G.BattleManager:GetInstance():SetBattleStart()
                    _G.BattleManager:GetInstance():ShowBattleTeam()
                    self.isStart = true
                end
            )
        end
    )
end

---战斗结束
---@param tab table 战斗数据
function BattleControllerWorldBossCrusade:OnFightResult(tab, call)
    self.FightResult = tab
    call()
end

function BattleControllerWorldBossCrusade:OnSettlement(callback)
    callback(_G.SettlementModel.SettlementType.worldBoss, self.FightResult, self.id)
end

