---@class MonsterTipView : UIBaseView	中文描述
---@field go_table MonsterTipView_GoTable GoTable
local MonsterTipView = _G.BaseClass("MonsterTipView", _G.UIBaseView)

function MonsterTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function MonsterTipView:OnCreate(Data)
    self:LoadBackgroundEffect()

    _G.DelayDo(3, function()
        if self:IsNil() then
            return
        end
        self:Close()
    end)
end

---加载背景特效
function MonsterTipView:LoadBackgroundEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_qiangdilaixi,
        self.go_table.obj_effect,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
        end
    )
end

function MonsterTipView:OnClickBtn(go, isOn)
end

return MonsterTipView
