---@class BattleDamageRankManager:Singleton	战斗内显示伤害排名数据管理类
local BattleDamageRankManager = _G.BaseClass("BattleDamageRankManager", _G.Singleton)

---类的构造函数
function BattleDamageRankManager:__init()
end

---类的析构函数
function BattleDamageRankManager:Dispose()
end

function BattleDamageRankManager:InitData(msg)
    local PlayerModel = _G.PlayerModel:GetInstance()
    local playerLv = PlayerModel:GetLevel()
    self.Data = {
        [1] = {
            ["uid"] = 1,
            ["name"] = PlayerModel:GetName(),
            ["style"] = PlayerModel:GetRoleStyle(),
            ["curMaxNum"] = 0,
            ["allNum"] = 0,
            ["num"] = 0,
            ["frame"] = PlayerModel:GetCurFrame(),
            ["type"] = 0,
            ["sliderValue"] = 0,
            ["lv"] = playerLv
        }
    }
    local otherPlayerCount = 0
    if msg ~= nil then
        for _, v in ipairs(msg) do
            otherPlayerCount = otherPlayerCount + 1
            local other = {
                ["uid"] = otherPlayerCount + 1,
                ["name"] = v.name,
                ["style"] = v.style,
                ["curMaxNum"] = 0,
                ["allNum"] = v.num,
                ["num"] = 0,
                ["frame"] = v.frame,
                ["type"] = -1,
                ["sliderValue"] = 0,
                ["lv"] = v.lv
            }
            table.insert(self.Data, other)
        end
    end
    self.robotDamagePercent = {
        [1] = 0.9,
        [2] = 0.7,
        [3] = 0.5
    }
    if otherPlayerCount < 3 then
        local sceneRobotCfgs = _G.ConfigManager.scene_robot_cfg
        local robotCfgCount = _G.table.count(sceneRobotCfgs)
        if robotCfgCount < 3 - otherPlayerCount then
            if _G.AppSetting.DEBUG then
                _G.LogError("机器人配置数量不足")
            end
            return
        end
        local randomTable = {}
        for i = otherPlayerCount, 2 do
            local random = math.random(1, robotCfgCount)
            while table.ContainsValue(randomTable, random) do
                random = math.random(1, robotCfgCount)
            end
            table.insert(randomTable, random)
        end
        local robotIndex = 1
        local randomAllCount = #randomTable
        for _, v in pairs(sceneRobotCfgs) do
            if randomAllCount == 0 then
                break
            end
            if table.ContainsValue(randomTable, robotIndex) then
                local robotData = {
                    ["uid"] = #self.Data + 1,
                    ["name"] = _G.GetLangPackValue(v.name),
                    ["style"] = v.portrait,
                    ["curMaxNum"] = 0,
                    ["allNum"] = 0,
                    ["num"] = 0,
                    ["frame"] = v.frame,
                    ["type"] = v.id,
                    ["sliderValue"] = 0,
                    ["lv"] = playerLv
                }
                table.insert(self.Data, robotData)
                randomAllCount = randomAllCount - 1
            end
            robotIndex = robotIndex + 1
        end
    end
end

function BattleDamageRankManager:GetData()
    return self.Data
end

function BattleDamageRankManager:RefreshData(cur_time, total_time, callback)
    local timePercent = cur_time / total_time
    local robotCount = 0
    local allDps = _G.BattleManager:GetInstance():GetAllDps()
    for _, v in ipairs(self.Data) do
        if v.type == 0 then
            v.num = allDps
        elseif v.type == -1 then
            v.num = math.floor(timePercent * v.allNum)
        elseif v.type > 0 then
            robotCount = robotCount + 1
            v.num = math.floor(self.robotDamagePercent[robotCount] * allDps)
        end
    end
    _G.table.sort(self.Data, _G.handler(self, self.Sort))
    local sliderMaxValue = self.Data[1].num
    for _, v in ipairs(self.Data) do
        v.sliderValue = v.num / sliderMaxValue
        v.curMaxNum = sliderMaxValue
    end
    callback(self.Data)
end

function BattleDamageRankManager:Sort(data1, data2)
    return data1.num > data2.num
end

