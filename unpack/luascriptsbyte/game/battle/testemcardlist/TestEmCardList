---@class TestEmCardList : UIBaseView	中文描述
---@field public go_table TestEmCardList_GoTable GoTable
local TestEmCardList = _G.BaseClass("TestEmCardList", _G.UIBaseView)
--_G.TestEmCardList = TestEmCardList

local CS = _G.CS
local typeof = _G.typeof

---bg图片名字
local BgImageName = {
    [0] = "ui_cz_ty_kpk6",
    [1] = "ui_cz_ty_kpk1",
    [2] = "ui_cz_ty_kpk2",
    [3] = "ui_cz_ty_kpk3",
    [4] = "ui_cz_ty_kpk4",
    [5] = "ui_cz_ty_kpk5"
}

function TestEmCardList:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function TestEmCardList:OnCreate(index, selectUid, CardList, call)
    self.index = index
    if index % 2 == 1 then
        self.type = _G.HeroType.Hero
    else
        self.type = _G.HeroType.Guardian
    end
    self.selectUid = selectUid
    self.call = call
    self.CardList = CardList
    self.select = CardList[selectUid[index]] and CardList[selectUid[index]] or nil
    self.IsFrist = true
    self:ShowCardList()
    self:ShowSelectCard()
end

---展示选中卡牌
function TestEmCardList:ShowSelectCard()
    if self.select == nil then
        return
    end
    self.ChooseCard =
        _G.GetAutoGoTable(self.go_table.obj_CardChooseItem, _G.handlerbind(self, self.OnClickItem, {uid = 0}))
    self.ChooseCard.obj_Card:SetActiveE(1)
    self.ChooseCard.aorimage_Color.SpriteName = BgImageName[self.select.cfg.Order]
    self.ChooseCard.aorrawimage_Card:LoadImage(self.select.cfg.Photo)
    local star
    for i = 1, 7 do
        star = self.ChooseCard.obj_Card:FindE(string.format("@_aorimage_Star%d", i))
        if self.select.star >= i then
            star:SetActiveE(1)
        else
            star:SetActiveE(0)
        end
    end
    local IsSelect = false
    for _, v in pairs(self.selectUid) do
        if self.ChooseCard.uid == v then
            IsSelect = true
        end
    end
    self.ChooseCard.obj_BattleIcon:SetActiveE(IsSelect and 1 or 0)
    self.ChooseCard.aortext_Name.text = _G.LangUtil.GetLangPackValue(self.select.cfg.Name)
    self.ChooseCard.aortext_Level.text = "Lv." .. self.select.lv
end

---创建卡牌列表
function TestEmCardList:ShowCardList()
    local isRefresh = true

    self.CardUidList = {}
    for i, _ in pairs(self.CardList) do
        table.insert(self.CardUidList, i)
    end
    if self.IsFrist then
        self.go_table.looplist2_CardList:InitListView(0, _G.handlerbind(self, self.RefreshList))
        self.IsFrist = false
    end
    self.go_table.looplist2_CardList:SetListItemCount(#self.CardUidList, true)
    if isRefresh then
        self.go_table.looplist2_CardList:RefreshAllShownItem()
    end
end

function TestEmCardList:RefreshList(listView2, index)
    if index < 0 then
        return
    end
    local list = self.CardList
    local item = listView2:NewListViewItem("$_obj_CardItem")
    local x = index + 1
    item:SetName(x)
    local tb_i = {}
    local data = {}
    data = list[self.CardUidList[x]]
    tb_i = _G.GetAutoGoTable(item, _G.handlerbind(self, self.OnClickItem, data))

    if data == nil then
        tb_i:SetActiveE(0)
    else
        tb_i:SetActiveE(1)
        tb_i.aorimage_Color.SpriteName = BgImageName[data.cfg.Order]
        tb_i.aorrawimage_Card:LoadImage(data.cfg.Photo)
        local star
        for i = 1, 7 do
            star = tb_i.obj_Card:FindE(string.format("@_aorimage_Star%d", i))
            if data.star >= i then
                star:SetActiveE(1)
            else
                star:SetActiveE(0)
            end
        end
        local IsSelect = false
        for _, v in pairs(self.selectUid) do
            if data.uid == v then
                IsSelect = true
            end
        end
        tb_i.obj_BattleIcon:SetActiveE(IsSelect and 1 or 0)
        tb_i.aortext_Name.text = _G.LangUtil.GetLangPackValue(data.cfg.Name)
        tb_i.aortext_Level.text = "Lv." .. data.lv
    end

    return item
end

---点击物品，放入选择列表
function TestEmCardList:OnClickItem(go, IsOn, data)
    if self.call ~= nil then
        self.call(data.uid, self.index)
        self:Close()
    end
end

---按钮点击事件在这里派发
function TestEmCardList:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_Exit" then
        self:Close()
    end
end

return TestEmCardList
