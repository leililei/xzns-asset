--region 排位item
local BattleDamageRankItem = _G.BaseClass("BattleDamageRankItem")
local ITEMOFFSET = -92
local UIUtils = _G.UIUtils
function BattleDamageRankItem:__init(obj, ty, sortingOrder)
    self.obj = obj
    self.ty = ty
    self.lastNum = 0
    self.preNum = 0
    self.go_table = _G.GetAutoGoTable(obj)
    self.go_table.obj_rankContent:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder = sortingOrder + 5
end
function BattleDamageRankItem:Dispose()
    if self.doTween ~= nil then
        self.doTween:Kill()
        self.doTween = nil
    end
    if self.moveDoTween ~= nil then
        self.moveDoTween:Kill()
        self.moveDoTween = nil
    end
    if self.coChangeNum ~= nil then
        _G.coroutine.stopwaiting(self.coChangeNum)
        self.coChangeNum = nil
    end
    self.go_table = nil
    self.data = nil
end

function BattleDamageRankItem:CoOnNumberChange()
    local time = 0
    local timeDelta = 0.1
    local totalTime = 0.8
    while time < totalTime do
        time = time + timeDelta
        self.go_table.aortext_score.text =
            _G.GameUtil.NumberToUnitWord(math.ceil(self.lastNum + time / totalTime * (self.data.num - self.lastNum)))
        _G.coroutine.waitforseconds(timeDelta)
    end
    self.go_table.aortext_score.text = _G.GameUtil.NumberToUnitWord(self.data.num)
end
---显示
---@param data table 排行榜单个数据
--[[
   string name = 1;//名字
   number style = 2;//头像
   number num = 3;//伤害
   number frame = 4;//头像框
   number type = 5;//0是自己.-1是其他玩家.其他id是机器人scene_robot_cfg的id
   ]]
function BattleDamageRankItem:Show(data, index)
    if self.index ~= index then
        self.index = index
        local targetY = self.ty + ITEMOFFSET * (index - 1)
        if self.moveDoTween ~= nil then
            self.moveDoTween:Kill()
        end
        self.moveDoTween = self.obj:DOLocalMoveY(targetY, 0.5):SetEase(CS.DG.Tweening.Ease.OutExpo)
    end
    self.lastNum = self.preNum
    self.preNum = data.num
    self.data = data
    if self.coChangeNum ~= nil then
        _G.coroutine.stopwaiting(self.coChangeNum)
        self.coChangeNum = nil
    end
    self.coChangeNum = _G.coroutine.start(_G.handler(self, self.CoOnNumberChange))

    if self.doTween ~= nil then
        self.doTween:Kill()
        self.doTween = nil
    end

    if data.type == 0 then
        self.go_table.aorimage_bg:SetActiveE(1)
        self.go_table.aorimage_dmg_bar.SpriteName = "UI_elrq_jdtl_bar"
    else
        self.go_table.aorimage_bg:SetActiveE(0)
        self.go_table.aorimage_dmg_bar.SpriteName = "UI_elrq_jdt_bar"
    end

    self.doTween =
        _G.DOTween.To(
        function()
            return self.go_table.slider_dmg.value
        end,
        function(x)
            self.go_table.slider_dmg.value = x
        end,
        data.sliderValue,
        0.8
    )

    self.go_table.aortext_name.text = data.name
    self.go_table.aortext_rank.text = index
    UIUtils.SetPlayerHeadItemNew(self.go_table.obj_HeadItemBase,data,
    1,
    true,
    false,
    true,
    function()
    end)
end
--endregion

local BattleDamageRankManager = require "BattleDamageRankManager"
---@class BattleDamageRankView : UIBaseView	中文描述
---@field public go_table BattleDamageRank_GoTable GoTable
local BattleDamageRankView = _G.BaseClass("BattleDamageRankView", _G.UIBaseView)

function BattleDamageRankView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function BattleDamageRankView:OnCreate()
    self.SortingOrder = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
    local y, z
    self.leftPosX, y, z = self.go_table.obj_left:GetLocalPosition()
    self.totalTime = _G.BattleManager:GetInstance():GetTotalTime()
    self.lastRefreshTime = 0
    self.timer =
        _G.TimerManager:GetInstance():GetTimer(
        1,
        self.TimerFunc,
        self,
        false,
        false
    )
    self.timer:Start()
    self:InitRank()
    self:ShowRank()
    self:InitView()
end

function BattleDamageRankView:TimerFunc()
    local curSceneTime = _G.BattleManager:GetInstance():GetCurSceneTime()
    if curSceneTime - self.lastRefreshTime >= 1 then
        self.lastRefreshTime = curSceneTime
        BattleDamageRankManager:GetInstance():RefreshData(
            curSceneTime,
            self.totalTime,
            function(list)
                self:OnRankRefresh(list)
            end
        )
    end
end

---界面的销毁函数
function BattleDamageRankView:OnDestroy()
    self:DelTimer()
    if self.doTween then
        self.doTween:Kill()
        self.doTween = nil
    end
    if self.rankList ~= nil then
        for i = 1, #self.rankList do
            self.itemTransDic[self.rankList[i].uid]:Dispose()
        end
    end
end

function BattleDamageRankView:DelTimer()
    if self.timer ~= nil then
        self.timer:Stop()
        self.timer = nil
    end
end

---按钮点击事件在这里派发
function BattleDamageRankView:OnClickBtn(go)
    if go == self.go_table.aorbtn_in then
        self:HideRank()
    elseif go == self.go_table.aorbtn_out then
        self:ShowRank()
    end
end

function BattleDamageRankView:ShowRank()
    if self.doTween then
        return
    end
    self.go_table.obj_rank_parent:SetActiveE(1)
    self.doTween =
        self.go_table.obj_left:DOLocalMoveX(self.leftPosX + 323, 0.3):SetEase(CS.DG.Tweening.Ease.OutExpo):OnComplete(
        function()
            self.go_table.aorbtn_in:SetActiveE(1)
            self.go_table.aorbtn_out:SetActiveE(0)
            self.doTween = nil
            self.go_table.obj_left:SetActiveE(0)
            self.go_table.obj_left:SetActiveE(1)
        end
    )
end

function BattleDamageRankView:HideRank()
    if self.doTween then
        return
    end
    self.doTween =
        self.go_table.obj_left:DOLocalMoveX(self.leftPosX, 0.3):SetEase(CS.DG.Tweening.Ease.OutExpo):OnComplete(
        function()
            self.go_table.aorbtn_in:SetActiveE(0)
            self.go_table.aorbtn_out:SetActiveE(1)
            self.go_table.obj_rank_parent:SetActiveE(0)
            self.doTween = nil
        end
    )
end

function BattleDamageRankView:RefreshView()
    local curSceneTime = _G.BattleManager:GetInstance():GetCurSceneTime()
    self.lastRefreshTime = curSceneTime
    BattleDamageRankManager:GetInstance():RefreshData(
        curSceneTime,
        self.totalTime,
        function(list)
            self:OnRankRefresh(list)
        end
    )
end

function BattleDamageRankView:InitView()
end
--region 排行榜
function BattleDamageRankView:InitRank()
    self.itemTransDic = {}
    self:OnRankListCall(BattleDamageRankManager:GetInstance():GetData())
end
function BattleDamageRankView:OnRankListCall(list)
    self.rankList = list
    local orignRank = self.go_table.obj_rank
    local tx, ty, tz = orignRank:GetLocalPosition()
    for i = 1, #self.rankList do
        if i == 1 then
            self.itemTransDic[list[i].uid] = BattleDamageRankItem.New(orignRank, ty, self.SortingOrder)
            orignRank:SetActiveE(1)
        else
            local obj = _G.InstantiateObject(self.go_table.obj_rank, self.go_table.obj_rank_parent)
            obj:SetLocalPosition(tx, ty + ITEMOFFSET * (i - 1), tz)
            self.itemTransDic[list[i].uid] = BattleDamageRankItem.New(obj, ty, self.SortingOrder)
            obj:SetActiveE(1)
        end
    end
    self:OnRankRefresh(list)
end
function BattleDamageRankView:OnRankRefresh(list)
    self.rankList = list
    for i = 1, #self.rankList do
        self.itemTransDic[list[i].uid]:Show(self.rankList[i], i)
    end
end
--endregion

return BattleDamageRankView
