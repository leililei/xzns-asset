---设置进攻方的阵容
---@param sids table 卡牌SID数组
---@param forceAutoSkillType 用于镇魂特训，不用于竞技场：0是非镇魂特训战斗 1 全手动，2自动怒气技 3 自动合击技 4 自动怒气 和 合击技
--- recordTyp:0.正常战斗；1.战斗结束时的回放战斗；2.服务器存储的战报
--- recordTeamNum:高阶竞技场回放三场战斗中其中一场战斗
function BattleManager:initAttackSids(
    sids,
    type1,
    IsLoadScene,
    recordType,
    recordTeamNum,
    forceAutoSkillType,
    describe,
    recordDamage,
    leftDescribe,
    rightDescribe)
    if recordType == nil then
        recordType = 0
    end
    if recordTeamNum == nil then
        recordTeamNum = 0
    end
    if not forceAutoSkillType then
        forceAutoSkillType = 0
    end
    if not recordDamage then
        recordDamage = 0
    end
    if not describe then
        describe = ""
    end
    leftDescribe = leftDescribe or _G.PlayerModel:GetInstance():GetName()
    rightDescribe = rightDescribe or ""
    local fourSpeed = false
    local twoSpeed = true
    if _G.AppSetting.IsAlipay then
        local conditions = _G.ConfigManager.discrete_cfg[126101]
        if _G.GlobalConditionManager.CheckCondition(conditions[1][2], conditions[1][3]) then
            twoSpeed = true
            if _G.GlobalConditionManager.CheckCondition(conditions[2][2], conditions[2][3]) then
                fourSpeed = true
            end
        else
            twoSpeed = false
        end
    else
        --VIP 功能开启战斗 4倍 加速 判断
        fourSpeed = fourSpeed or require "AfkModel":GetInstance():CheckVipSpeed4()
        --4倍数功能开放条件
        fourSpeed = fourSpeed or _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(81)
    end
    if twoSpeed then
        if fourSpeed then
            self:SetExSpeedIndex(1)
        else
            self:SetExSpeedIndex(0)
        end
    else
        self:SetExSpeedIndex(0, false, true)
    end
    self:Reset()
    CS.BattleManager.Inst:Init(
        sids,
        type1 or 1,
        IsLoadScene,
        recordType,
        recordTeamNum,
        forceAutoSkillType,
        describe,
        recordDamage,
        leftDescribe,
        rightDescribe
    )
end

---初始化战斗倍速
---@return void
function BattleManager:InitExSpeedIndex()
    --倍速开放
    local fourSpeed = not _G.PlayerModel:GetInstance():CheckCreateRole()
    local twoSpeed = true
    if not fourSpeed then
        if _G.AppSetting.IsAlipay then
            local conditions = _G.ConfigManager.discrete_cfg[126101]
            if _G.GlobalConditionManager.CheckCondition(conditions[1][2], conditions[1][3]) then
                twoSpeed = true
                if _G.GlobalConditionManager.CheckCondition(conditions[2][2], conditions[2][3]) then
                    fourSpeed = true
                end
            else
                twoSpeed = false
            end
        else
            --VIP 功能开启战斗 4倍 加速 判断
            fourSpeed = fourSpeed or require "AfkModel":GetInstance():CheckVipSpeed4()
            --4倍数功能开放条件
            fourSpeed = fourSpeed or _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(81)
        end
    end
    if twoSpeed then
        if fourSpeed then
            self:SetExSpeedIndex(1)
        else
            self:SetExSpeedIndex(0)
        end
    else
        self:SetExSpeedIndex(0, false, true)
    end
end

