-----获取配置进攻方的数据
---@param id number monsterGroupId
---@return table cardsids
function BattleManager:GetDefaultAttackSids(id)
    local sids = CS.BattleResManager.Inst:GetAttackSids(id)
    local tSids = {}
    for i = 0, sids.Length - 1 do
        if sids[i] > 0 then
            tSids[#tSids + 1] = sids[i] or 0
        else
            tSids[#tSids + 1] = 0
        end
    end
    return tSids
end

-----获取配置敌方的数据
---@param id number monsterGroupId
---@return table cardsids
function BattleManager:GetDefaultDefenserSids(id)
    local sids = CS.BattleResManager.Inst:GetDefenserSids(id)
    local tSids = {}
    if sids ~= nil then
        for i = 0, sids.Length - 1 do
            for j = 0, sids[i].Length - 1 do
                if sids[i][j] > 0 then
                    tSids[#tSids + 1] = sids[i][j]
                end
            end
        end
    end
    return tSids
end

