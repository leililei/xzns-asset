---直接创建测试战斗
function BattleManager:BeginTestBattle(
    scene,
    isTest,
    attackUids,
    defenceSids,
    battleType,
    testGhostSkills,
    testPetSkills)
    --testPetSkills传递的是宠物id, 需要转为card_skill_id
    if testPetSkills then
        for i = 1, #testPetSkills do
            if testPetSkills[i] > 1 then
                local cfg = _G.ConfigManager.pet_cfg[testPetSkills[i]]
                if cfg then
                    testPetSkills[i] = cfg.skill_id[#cfg.skill_id]
                else
                    testPetSkills[i] = 0
                end
            end
        end
    end
    --attackSids丶defenceSids可能是皮肤id, 需要处理转化
    local attackSkin, defenceSkin = {}, {}
    if attackUids then
        for i, skinId in pairs(attackUids) do
            local cfg = _G.ConfigManager.skin_cfg[skinId]
            if cfg then
                attackSkin[i] = skinId
                attackUids[i] = cfg.card
            else
                attackSkin[i] =0
            end
        end
    end
    if defenceSids and defenceSids[1] then
        for i, skinId in pairs(defenceSids[1]) do
            local cfg = _G.ConfigManager.skin_cfg[skinId]
            if cfg then
                defenceSkin[i] = skinId
                defenceSids[1][i] = cfg.card
            else
                defenceSkin[i] = 0
            end
        end
    end

    self:Reset()
    self:InitExSpeedIndex()

    CS.BattleManager.Inst:BeginTestBattle(
        scene,
        isTest,
        attackUids,
        defenceSids,
        nil,
        battleType,
        testGhostSkills,
        testPetSkills,
        attackSkin,
        defenceSkin
    )
end

