--region 发起战斗

---进入战斗
---@param bct BattleControllerType 战斗类型
---@param ... any 战斗参数
function BattleManager:EnterFight(bct, ...)
    if self.curBattleController then
        _G.PopWindowManager:GetInstance():ShowAllTips(710101)
        return
    end
    self.Progress = 0
    self.curBattleController = _G.require(bct).New()
    self.curBattleController:EnterFight(...)
end

---进入回放战斗
---@param index number 回放场次
---@param notInBattle boolean 当前是否在战斗场景
---@param bct _G.BattleControllerType 战斗控制器类型
---@param win boolean 战斗结果
function BattleManager:EnterRecordFight(index, notInBattle, bct, win, ...)
    if self.curBattleController then
        self.curBattleController._fightResult = win
        self.curBattleController:EnterRecordFight(index, notInBattle, ...)
    else
        self.Progress = 0
        self.curBattleController = _G.require(bct).New()
        self.curBattleController._fightResult = win
        self.curBattleController:EnterRecordFight(index, notInBattle, ...)
    end
    if notInBattle then
        _G.Events:GetInstance():Broadcast(_G.eBattleState.RecordStart)
    end
end

