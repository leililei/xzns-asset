---@param sid monster_group_cfg_Item
---@param type number 1.单机。 2.网络
---@param tab table 敌我方布阵数据
function BattleManager:StartTestFight(sid, AttackSid, DefenceSid, tab, type, call)
    _G.coroutine.start(
        function()
            local view = _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
            while _G.IsNil(view.gameObject) do
                _G.coroutine.waitforendofframe()
            end
            view = nil
            local LoginView = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.LoginView.Name)
            if LoginView then
                LoginView.gameObject:SetActiveE(0)
            end
            local MainView = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.MainView.Name)
            if MainView then
                _G.WorldManager:GetInstance():SetCurrentWorldVisible(false)
            end
            self:Reset()
            _G.CS.BattleManager.Inst:BeginTestBattle(sid, true, AttackSid, DefenceSid, nil, type)
            if call then
                call()
            end
            return
        end
    )
end

