---设置自动使用技能和合击技(进攻方数据)
---@param arg any
function BattleManager:SetArgDataAutoCmd(arg)
    if table.isEmptyOrNil(arg) then
        return
    end
    local allCmd = _G.CS.fightcmd.BattleAllCommand()
    --自动使用技能
    allCmd.AutoSkillCmd:Add(
        (function()
            local cmd = _G.CS.fightcmd.WebSetAutoSkillCmd()
            local command = _G.CS.fightcmd.WebBattleCommand()
            command.Frame = 1
            cmd.Frame = command
            cmd.AiSkillState = 0x1
            cmd.TeamType = 0 --进攻方
            return cmd
        end)()
    )
    --自动使用合击技
    if arg.attacker_team and #arg.attacker_team > 0 then
        local team = arg.attacker_team[1]
        if team.combine_skill and #team.combine_skill > 0 then
            ---@param ghostIndex number
            local function createAutoSkillCmd(ghostIndex)
                local cmd = _G.CS.fightcmd.WebSetAutoGhostSkillCmd()
                local command = _G.CS.fightcmd.WebBattleCommand()
                command.Frame = 1
                cmd.Frame = command
                cmd.GhostIndex = ghostIndex
                cmd.IsInit = true --是否初始化操作
                cmd.IsAuto = 1    --1表示自动, 2表示手动
                cmd.Order = 0
                cmd.TeamType = 0  --进攻方
                return cmd
            end
            for i = 1, #team.combine_skill do
                allCmd.AutoGhostSkillCmd:Add(createAutoSkillCmd(i - 1))
            end
        end
    end

    arg.customFightCmd = true
    arg.fight_cmd = _G.CS.ProtoUtils.Serialize(allCmd)
end

