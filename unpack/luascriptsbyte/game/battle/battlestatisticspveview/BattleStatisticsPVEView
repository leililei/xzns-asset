            [ui_cfg.ShowAwardWithButtonView.Name] = true,
            [ui_cfg.DeadSoulSettlementPassView.Name] = true,
            [ui_cfg.AfkSettlementPassView.Name] = true,
            [ui_cfg.MainView.Name] = true,
        }
        if bct == _G.BattleControllerType.Tower then
            --死魂塔回放, 保留主界面窗口
            excludeWindows[ui_cfg.DeadsoulTowerView.Name] = true
            excludeWindows[ui_cfg.DeadsoulTowerView.Name] = true
        end
        _G.UIManager:GetInstance():SwitchSceneCloseWindows(excludeWindows)
        --切换至目标页签
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
        if bct == _G.BattleControllerType.Tower then
            _G.MainManager:GetInstance():ShowWildWindow()
        elseif bct == _G.BattleControllerType.afkChallenge then
            _G.MainManager:GetInstance():ShowAfkWindow()
        end
    end

    ---如果在死魂塔丶放置冒险后台战斗时查看战报等回放
    if bct ~= _G.BattleControllerType.Tower and _G.DeadsoulTowerManager:GetInstance():IsFighting() or
        bct ~= _G.BattleControllerType.SecretRealm and require("SecretRealmModel"):GetInstance():IsFighting() or
        bct ~= _G.BattleControllerType.afkChallenge and require("AfkBattleManager"):GetInstance():IsFighting() then
        _G.PopWindowManager:GetInstance():ShowAllTips(46)
        return nil
    end

    --创建控制方法
    local function show()
        if self.isChat == 1 then
            if isShow then
                self:Show()
                local chatView = _G.UIManager:GetInstance():GetWindowCtrl(ui_cfg.ChatView.Name)
                if chatView then
                    chatView:Show()
                end
                _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
            else
                self:Hide()
                local chatView = _G.UIManager:GetInstance():GetWindowCtrl(ui_cfg.ChatView.Name)
                if chatView then
                    chatView:Hide()
                end
                --_G.WorldManager:GetInstance():SetCurrentWorldVisible(false, false)
            end
        end

        if view then
            if isShow then
                -- if viewStates[ui_cfg.ShowAwardWithButtonView.Name] then
                --     ---@type ShowAwardWithButtonView
                --     local v = viewStates[ui_cfg.ShowAwardWithButtonView.Name].view
                --     v:SetSettleSceneShow(true)
                --     v:SetRecordScene(false)
                -- end
                if viewStates[ui_cfg.MonsterSiegeRankView.Name] then
                    viewStates[ui_cfg.MonsterSiegeRankView.Name].view:Show()
                    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
                    viewStates[ui_cfg.MainSiegeView.Name].view:Show()
                end
                if viewStates[ui_cfg.CommonRankTopView.Name] then
                    --还原CommonRankView相机depth值
                    self:ChangeCameraDepth(0, false)
                end
                for _, state in ipairs(viewStates) do
                    if state.control then
                        --还原HideWorld计数
                        if state.cfg.HideWorld and self.controlWorldTimes then
                            _G.UIManager:GetInstance():SetWorldSceneHideTimes(-10)
                        end
                        state.view:Show()
                    end
                end
                --清除WorldTimes状态
                self.controlWorldTimes = false

                view:Show()
                self:Show()
            else
                self.timer = _G.DelayFrameDo(
                    function()
                        if self:IsNil() then
                            return
                        end

                        -- if viewStates[ui_cfg.ShowAwardWithButtonView.Name] then
                        --     ---@type ShowAwardWithButtonView
                        --     local v = viewStates[ui_cfg.ShowAwardWithButtonView.Name].view
                        --     v:SetSettleSceneShow(false)
                        --     v:SetRecordScene(true)
                        -- end
                        if viewStates[ui_cfg.MonsterSiegeRankView.Name] then
                            viewStates[ui_cfg.MonsterSiegeRankView.Name].view:Hide()
                            viewStates[ui_cfg.MainSiegeView.Name].view:Hide()
                        end
                        for _, state in ipairs(viewStates) do
                            if state.control then
                                --如果HideWorld=true, 在Hide时将会显示主城场景
                                --此处需要进入战斗, 先临时将HideWorld计数+10, 在Show中还原
                                if state.cfg.HideWorld and not self.controlWorldTimes then
                                    _G.UIManager:GetInstance():SetWorldSceneHideTimes(10)
                                end
                                state.view:Hide()
                            end
                        end
                        --记录WorldTimes已被临时增加
                        --Show或者Hide方法可能被多次调用, 此处限制只做一次增加一次还原
                        self.controlWorldTimes = true

                        if viewStates[ui_cfg.CommonRankTopView.Name] then
                            --CommonRankView中相机depth值太大将导致战斗UI不显示, 临时减去10, 在Show中进行还原
                            self:ChangeCameraDepth(-10, true)
                        end
                        self:Hide()
                        view:Hide()
                    end
                )
            end
        end
    end
    if not isWait then
        show()
        show = nil
    end
    return show
end

function BattleStatisticsPVEView:CheckCanNotPlayInSociaty()
    if require("SociatyManager"):GetInstance():HasSociaty() and _G.MainManager:GetInstance():IsToggledSociatyWindow(true) then
        if not self.sociatyBctLis then
            self.sociatyBctLis = {
                [_G.BattleControllerType.SociatyBattle] = true,
                [_G.BattleControllerType.SociatyBattleLeague] = true,
                [_G.BattleControllerType.SociatyBoss] = true,
                [_G.BattleControllerType.SociatyMaze] = true,
                [_G.BattleControllerType.SociatyMoba] = true
            }
        end
        if not self.sociatyBctLis[self.bct] then
            --公会场景不能回放其它功能，需求如此
            _G.PopWindowManager:GetInstance():ShowAllTips(250160)
            return true
        end
    end
    return false
end

