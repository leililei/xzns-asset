function BattleStatisticsPVEView:CallSendChat(param, msg)
    if param.ack == 1 then
        _G.PopWindowManager:GetInstance():ShowAllTips(411)
        --- 以服务器返回的内容为准  (违禁字 处理后)
        if not _G.IsNil(param.content) and not string.IsNullOrEmpty(param.content) then
            msg.chat.n_content = param.content
        end
        if not _G.IsNil(param.time) then
            msg.chat.time = param.time
        end
        require("ChatManager"):GetInstance():P2C_NewChat(msg)
    end
end

---按钮点击事件在这里派发
function BattleStatisticsPVEView:OnClickBtn(go)
    if go == self.go_table.aorbtn_Reply then
        -- elseif go == self.go_table.aorbtn_left then
        --     self.index = self.index - 1
        --     self:InitView(self.index)
        -- elseif go == self.go_table.aorbtn_right then
        --     self.index = self.index + 1
        --     self:InitView(self.index)
        if self.replyTimer then
            return
        end

        local open = function()
            local wait = self:ShowSelfAndShowAwardView(false, true)
            if not wait then
                return
            end
            if self:CheckCanNotPlayInSociaty() then
                return
            end
            local arg = self:GetFightArg(self.index)
            if arg then
                _G.BattleManager:GetInstance():SetArgData(arg)
            end
            if self.isReport then
                if self.isChat == 1 then
                    self.bct = self.chatBct
                end
                if self.reportParams then
                    _G.BattleManager:GetInstance():EnterRecordFight(self.index, true, self.bct, self.win, self.fzsid,
                        table.unpack(self.reportParams))
                else
                    _G.BattleManager:GetInstance():EnterRecordFight(self.index, true, self.bct, self.win, self.fzsid)
                end
            else
                _G.BattleManager:GetInstance():EnterRecordFight(self.index)
                _G.BattleManager:GetInstance().curBattleController._fightResult = self.win
            end

            if _G.CS.Launcher.Inst.IsSDK then
                local json = _G.Table2Json(
                    {
                        role_uid = _G.PlayerModel:GetInstance().role_uid,
                        role_level = _G.PlayerModel:GetInstance():GetLevel(),
                        role_vip = _G.PlayerModel:GetInstance().vipLv,
                        server_id = tostring(_G.ServerManager:GetInstance().CurServer.ServerID),
                        channel_id = _G.ServerManager:GetInstance().AppInfo.Platform,
                        phone_device = tostring(_G.ServerManager:GetInstance().AppInfo.DeviceID),
                        user_type = 1,
                        record_time = _G.TimeUtil.GetServerUnixTime()
                    }
                )
                if _G.AppSetting.DEBUG then
                    _G.Log(json, "点击战斗回放按钮打点")
                end
                _G.SDKManager:GetInstance():DoShushuData_track("click_battle_repaly_button", json)
            end
            self.replyTimer = _G.TimerManager:GetInstance():GetTimer(0.01, self.ReplayTimerFunc, self, true, true, true, wait)
            self.replyTimer:Start()
        end
        if self.replyHandler then
            self.replyHandler(
                function()
                    open()
                end
            )
        else
            open()
        end
    elseif go == self.go_table.aorbtn_Detail then
        self:OnBtnChanged(ShowType.Card)
        self:InitView(self.index)
    elseif go == self.go_table.aorbtn_Comb then
        self:OnBtnChanged(ShowType.Comb)
        self:InitView(self.index)
    elseif go == self.go_table.aorbtn_Pet then
        self:OnBtnChanged(ShowType.Pet)
        self:InitView(self.index)
    elseif go == self.go_table.aorbtn_Share then
        ---战报分享

        if _G.AppSetting.DEBUG then
            _G.Log("点击分享一条战报")
        end

        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ChooseChannelView.Name,
            function(channelargs, firendIdargs)
                local channel = channelargs
                local firendId = firendIdargs or 0

                ---@type share.c2s_share_save
                local msgfx = {}
                msgfx.type = 3
                if self.reportType > 0 then
                    msgfx.re_uid = self.playback_uid
                    msgfx.sys = self.reportType
                end

                --1,放置 2，普通竞技场 3，高阶竞技场 4，五行竞技场 5，公平竞技场 6,心魔幻境 7,巅峰演武 8,灵弈对决 9.英雄试炼 10,问鼎灵域
                --11.死魂塔 12.死魂塔试炼(五行) 13.芦花幻境 14.千机黑煞对阵炼狱童子 15.雪王来袭
                --16.黑暗本源 17.祸乱之源 18.群英会武 19.争霸天下(公会战) 20.街机乱斗 21.恶灵入侵 23.gm巅峰演武
                local bct
                if msgfx.sys == 1 then
                    bct = _G.BattleControllerType.afkChallenge
                elseif msgfx.sys == 2 then
                    bct = _G.BattleControllerType.arena
                elseif msgfx.sys == 3 then
                    bct = _G.BattleControllerType.arenaSenior
                elseif msgfx.sys == 4 then
                    bct = _G.BattleControllerType.arenaElement
                elseif msgfx.sys == 5 then
                    bct = _G.BattleControllerType.arenaFair
                elseif msgfx.sys == 6 then
                    bct = _G.BattleControllerType.seasonTower
                elseif msgfx.sys == 7 then
                    bct = _G.BattleControllerType.ArenaPeak
                elseif msgfx.sys == 8 then
                    bct = _G.BattleControllerType.SixVsSixPVP
                elseif msgfx.sys == 10 then
                    bct = _G.BattleControllerType.SpiritualRealm
                elseif msgfx.sys == 11 then
                    bct = _G.BattleControllerType.Tower
                elseif msgfx.sys == 12 then
                    bct = _G.BattleControllerType.seasonTower
                elseif msgfx.sys == 13 then
                    bct = _G.BattleControllerType.SystemFairyland
                elseif msgfx.sys == 14 then
                    bct = _G.BattleControllerType.Dungones
                elseif msgfx.sys == 15 then
                    bct = _G.BattleControllerType.worldBossCrusade
                elseif msgfx.sys == 16 then
                    bct = _G.BattleControllerType.BlackSource
                elseif msgfx.sys == 17 then
                    bct = _G.BattleControllerType.FirstTestBoss
                elseif msgfx.sys == 18 then
                    bct = _G.BattleControllerType.AllHeroesBattle
                elseif msgfx.sys == 19 then
                    bct = _G.BattleControllerType.SociatyBattle
                elseif msgfx.sys == 20 then
                    bct = _G.BattleControllerType.BattleControllerArenaEmbattle
                elseif msgfx.sys == 21 then
                    bct = _G.BattleControllerType.MonsterSiege
                elseif msgfx.sys == 22 then
                    bct = _G.BattleControllerType.SociatyBattleLeague
                elseif msgfx.sys == 23 then
                    bct = _G.BattleControllerType.GMArenaPeak
                end

                require("ChatViewNet"):GetInstance():SaveShareInfo(
                    msgfx,
                    function(datafx)
                        if datafx.ack == 1 then
                            ---分享卡片
                            local data = {}
                            data.shareType = 2
                            data.myname = _G.PlayerModel:GetInstance().role_name
                            data.myframe = _G.PlayerModel:GetInstance().frame
                            data.mystyle = _G.PlayerModel:GetInstance().role_style

                            data.sys = msgfx.sys
                            if msgfx.sys == 1 then
                                local afkSid = require("AfkModel"):GetInstance():GetCurSection()

                                ---@type afk_cfg
                                local cfg
                                if self.win then
                                    data.fzsid = _G.ConfigManager.afk_cfg[afkSid].pre_section
                                    cfg = _G.ConfigManager.afk_cfg[_G.ConfigManager.afk_cfg[afkSid].pre_section]
                                else
                                    data.fzsid = afkSid
                                    cfg = _G.ConfigManager.afk_cfg[afkSid]
                                end
                                if cfg.type_section == 1 then
                                    ---@type monster_group_cfg
                                    local mgc = _G.ConfigManager.monster_group_cfg[cfg.monster_group[1]]
                                    ---@type monster_cfg
                                    local ms = _G.ConfigManager.monster_cfg[mgc.DefaultDefenserSids[1][1]]

                                    local cd = require "CardCommentManager":GetInstance():CardData(ms.CardID)

                                    data.dfname = string.format("%s-%s", cfg.chapter, cfg.section)
                                    data.dfframe = cd.Icon
                                    data.dfstyle = cd.Star
                                elseif cfg.type_section == 2 then
                                    ---@type monster_group_cfg
                                    local mgc = _G.ConfigManager.monster_group_cfg[cfg.monster_group[1]]
                                    ---@type monster_cfg
                                    local ms
                                    for i = 1, #mgc.DefaultDefenserSids[1] do
                                        ms = _G.ConfigManager.monster_cfg[mgc.DefaultDefenserSids[1][i]]
                                        if ms.MonsterType == 4 then
                                            break
                                        end
                                    end
                                    local cd = require "CardCommentManager":GetInstance():CardData(ms.CardID)

                                    data.dfname = string.format("%s-%s", cfg.chapter, cfg.section)
                                    data.dfframe = cd.Icon
                                    data.dfstyle = cd.Star
                                elseif cfg.type_section == 3 then
                                    if _G.AppSetting.DEBUG then
                                        _G.Log(self.afkPage, "当前boss关页码")
                                    end
                                    ---@type monster_group_cfg
                                    local mgc = _G.ConfigManager.monster_group_cfg[cfg.monster_group[1]]
                                    ---@type monster_cfg
                                    local ms
                                    for i = 1, #mgc.DefaultDefenserSids[1] do
                                        local df = mgc.DefaultDefenserSids[self.afkPage]
                                        if nil == df then
                                            df = mgc.DefaultDefenserSids[1]
                                        end
                                        ms = _G.ConfigManager.monster_cfg[df[i]]
                                        if ms.MonsterType == 5 then
                                            break
                                        end
                                    end
                                    local cd = require "CardCommentManager":GetInstance():CardData(ms.CardID)

                                    data.dfname = string.format("%s-%s", cfg.chapter, cfg.section)
                                    data.dfframe = cd.Icon
                                    data.dfstyle = cd.Star
                                end
                            else
                                if self.otherinfo then
                                    data.dfname = self.otherinfo.name
                                    data.dfframe = self.otherinfo.frame or self.otherinfo.frameID
                                    data.dfstyle = self.otherinfo.style or self.otherinfo.headID
                                    data.dfsid = self.otherinfo.sid
                                else
                                    data.dfname = "分享信息异常"
                                    data.dfframe = 100
                                    data.dfstyle = 100
                                end
                            end
                            data.share_id = datafx.share_id
                            data.winnertable = self.winnertable
                            data.bct = bct

                            local dataStr = _G.Table2Json(data)

                            ---@type chat.c2s_chat dsd
                            local param = {}
                            param.channel = channel
                            param.content = dataStr
                            param.f_uid = firendId
                            param.type = 3
                            param.voice = 0
                            param.share_id = datafx.share_id

                            ---@type ClintSendChatInfo ---本地自己的消息 先显示 忽略服务器广播 防止延迟
                            local msg = {}
                            msg.channel = channel
                            msg.n_content = dataStr
                            msg.f_uid = firendId
                            msg.type = 3
                            msg.voice = 0
                            msg.share_id = datafx.share_id
                            msg, _ = require("ChatManager"):GetInstance():GetNewChatInfo(msg)
                            require("ChatViewNet"):GetInstance():SendCHAT(
                                param,
                                _G.handlerbind(self, self.CallSendChat, msg)
                            )
                        end
                    end
                )
            end
        )
    else
        if self.call then
            self.call()
        end
        self:Close()
    end
end

function BattleStatisticsPVEView:ReplayTimerFunc(wait)
    self.replyTimer = nil
    if wait then
        wait()
    end
end

function BattleStatisticsPVEView:EscClose(go)
    if self.call then
        self.call()
    end
    self:Close()
end

---更改相机深度
---@param offset number     依据初始depth的偏移值
---@param find boolean      如果相机不存在, 是否寻找
function BattleStatisticsPVEView:ChangeCameraDepth(offset, find)
    ---@type UnityEngine.Camera
    local cameraMain, camera3DUI

    cameraMain = self.cameraMain
    if find and _G.IsNil(cameraMain) then
        cameraMain = _G.Camera.main
        self.cameraMain = cameraMain
        self.cameraMainDepth = cameraMain and cameraMain.depth or 0
    end

    camera3DUI = self.camera3DUI
    if find and _G.IsNil(camera3DUI) then
        local cameraGO = _G.FindObject("3DUICam")
        if not _G.IsNil(cameraGO) then
            camera3DUI = cameraGO:GetComponentE(_G.typeof(_G.CS.UnityEngine.Camera))
            self.camera3DUI = camera3DUI
            self.camera3DUIDepth = camera3DUI and camera3DUI.depth or 0
        end
    end

    if not _G.IsNil(cameraMain) then
        cameraMain.depth = self.cameraMainDepth + offset
    end
    if not _G.IsNil(camera3DUI) then
        camera3DUI.depth = self.camera3DUIDepth + offset
    end
end

