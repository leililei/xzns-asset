function BattleStatisticsPVEView:InitView(index)
    self.go_table.aortext_tips:DOFade(0.2, 1):SetLoops(-1, CS.DG.Tweening.LoopType.Yoyo)
    if not _G.table.isEmptyOrNil(self.garraytable) then
        self.garray = self.garraytable[index]
    else
        self.garray = nil
    end
    self.win = self.winnertable[index] == 0
    if self.hideResultFlag then 
        self.go_table.obj_resultV:SetActiveE(0)
        self.go_table.obj_resultF:SetActiveE(0)
    else 
        if self.win then
            self.go_table.obj_resultV:SetActiveE(1)
            self.go_table.obj_resultF:SetActiveE(0)
            self:LoadVictoryEffect()
        else
            self.go_table.obj_resultV:SetActiveE(0)
            self.go_table.obj_resultF:SetActiveE(1)
        end
    end
    self.statisticsData = self.data[index].statisticsData
    self.statisticsMax = self.data[index].statisticsMax
    self.CombMax = self.data[index].CombMax
    self.PetMax = self.data[index].PetMax
    self.AtkUid = self.data[index].AtkUid
    self.DefUid = self.data[index].DefUid
    local playerUid = _G.PlayerModel:GetInstance():GetPlayerUid()
    self.isObserverAtk = true
    if self.DefUid ~= nil and playerUid == self.DefUid then
        self.isObserverAtk = false
    end
    self:ShowPlayerInfo(self.myItem)
    self:ShowPlayerInfo(self.enemyItem)
    self:InitButton()
    if self.isObserverAtk and not self.exchange then
        self.myItem.aortext_name.text = _G.GetLangPackValue(90000010071)
        self.enemyItem.aortext_name.text = _G.GetLangPackValue(90000010072)
        self.myItem.aorimage_Bg.SpriteName = "ui_zdsj_jinggong_diban"
        self.enemyItem.aorimage_Bg.SpriteName = "ui_zdsj_fangshou_diban"
    else
        self.myItem.aortext_name.text = _G.GetLangPackValue(90000010072)
        self.enemyItem.aortext_name.text = _G.GetLangPackValue(90000010071)
        self.myItem.aorimage_Bg.SpriteName = "ui_zdsj_fangshou_diban"
        self.enemyItem.aorimage_Bg.SpriteName = "ui_zdsj_jinggong_diban"
    end

    -- if self.isReport and #self.winnertable > 1 then
    --     self.go_table.aortext_type:SetActiveE(1)
