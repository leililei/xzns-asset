---获取激活大天赋数量
---@param sid number 卡牌sid
---@param skills table fight_arg中的卡牌技能组
---@return number 激活的大天赋数量
function BattleStatisticsPVEView:GetTalentsNum(sid, skills)
    local cfg = _G.ConfigManager.card_cfg[sid]
    if cfg == nil then
        return 0
    end
    local attrCfg = _G.ConfigManager.attribute_cfg
    local tCfg
    local num = 0
    for i, node in pairs(cfg.talent) do
        for j, talent in pairs(node) do
            tCfg = attrCfg[talent]
            if tCfg.skill > 0 and _G.table.ContainsValue(skills, tCfg.skill) then
                num = num + 1
            end
        end
    end
    return num
end

