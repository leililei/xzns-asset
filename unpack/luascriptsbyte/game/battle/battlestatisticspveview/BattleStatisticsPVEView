        local card = require "CardCommentManager":GetInstance():CardData(data[x].Sid)

        local cfg = card or _G.ConfigManager.monster_cfg[data[x].Sid]
        if cfg then
            if cfg.Name then
                name = cfg.Name
            else
                local card = require "CardCommentManager":GetInstance():CardData(cfg.CardID)

                name = card.Name
            end
        else
            local _cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, data[x].Uid)
            if _cardData then
                name = _cardData.cfg.Name
            end
        end
        tb.aortext_CardName.text = _G.LangUtil.GetLangPackValue(name)
    else
        dotweenToFunc(tb, "DmgOut", tb.aorimage_attack.gameObject, 0)
        dotweenToFunc(tb, "HpRecover", tb.aorimage_cure.gameObject, 0)
        dotweenToFunc(tb, "DmgIn", tb.aorimage_defence.gameObject, 0)
        dotweenToFunc(tb, "CreateGuard", tb.aorimage_hudun.gameObject, 0)
