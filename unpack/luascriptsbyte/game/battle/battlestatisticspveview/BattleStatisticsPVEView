function BattleStatisticsPVEView:CheckCardIsAssist(sid)
    if self.StoryList then
        for i, v in pairs(self.StoryList) do
            if v.sid == sid then
                return true
            end
        end
    end
    return false
end

local CheckInGarry = function(Garry, sid)
    if not Garry then
        return false
    end
    for i, v in pairs(Garry) do
        if v.sid == sid and sid > 0 then
            return true, i
        end
    end
    return false
end

---@param tran ItemCardAllView  CardViewBase
