local function dotweenToFunc(tb, index, aorimage, endvalue)
    aorimage:SetActiveE(0)
    if tb.tbDotweenList[index] then
        aorimage:SetRectTransformSize(0, 13.5)
        tb.tbDotweenList[index]:Kill()
        tb.tbDotweenList[index] = nil
    end
    if endvalue > 0 then
        tb.tbDotweenList[index] = DOTween.To(
            function(x)
                aorimage:SetActiveE(1)
                aorimage:SetRectTransformSize(x, 13.5)
            end,
            0,
            endvalue,
            1
        )
        tb.tbDotweenList[index].onComplete = function()
            -- if aorimage then
            --     aorimage:SetActiveE(0)
            -- end
            tb.tbDotweenList[index]:Kill()
            --tb.tbDotweenList[index] = nil
        end
    else
        aorimage:SetRectTransformSize(0, 13.5)
    end
end
function BattleStatisticsPVEView:ShowCard(tb, data, max, x)
    if not tb.tbDotweenList then
        tb.tbDotweenList = {}
    end
    if data and data[x] then
        tb.gameObject:SetActiveE(1)
        if tb.lua_Prop == nil then
            ---开始生成对象 并标记
            ---@type ItemCardAllView
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.CardAllItem,
                tb.trans_card,
