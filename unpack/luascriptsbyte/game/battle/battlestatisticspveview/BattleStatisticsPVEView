function BattleStatisticsPVEView:RefreshList(index, obj)
    if index < 0 then
        return
    end
    local data
    local max
    local x = index + 1
    obj:SetName(x)
    local tb = {}
    tb = _G.GetAutoGoTable(obj)
    tb.gameObject:SetActiveE(0)
    if self.CurShowType == ShowType.Card then
        if self.isObserverAtk then
            data = self.statisticsData.Attacker
        else
            data = self.statisticsData.Defender
        end
        max = self.statisticsMax
    elseif self.CurShowType == ShowType.Comb then
        if self.isObserverAtk then
            data = self.statisticsData.AtkCombineSkills[1]
        else
            data = self.statisticsData.DefCombineSkills[1]
        end
        max = self.CombMax
    else
        if self.isObserverAtk then
            data = self.statisticsData.AtkPetSkills[1]
        else
            data = self.statisticsData.DefPetSkills[1]
        end
        max = self.PetMax
    end
    _G.GameUtil.SetActiveByCondition(tb.obj_Card, self.CurShowType == ShowType.Card and data[x])
    _G.GameUtil.SetActiveByCondition(tb.obj_Comb, self.CurShowType == ShowType.Comb or self.CurShowType == ShowType.Pet)
    if self.CurShowType == ShowType.Card then
        self:ShowCard(tb, data, max, x)
    elseif self.CurShowType == ShowType.Comb then
        self:ShowComb(tb, data, max, x)
    else
        self:ShowPet(tb, data, max, x)
    end
end

