function BattleStatisticsPVEView:InitButton()
    if self.totalPage > 1 then
        for i = 1, self.totalPage do
            self.Choose["aorbtn_choose" .. i]:SetActiveE(1)
        end
        self.Choose["aorimage_choose" .. self.index]:SetActiveE(1)
        --self.go_table.aorimage_choose:SetParentE(self.Choose["aorbtn_choose" .. self.index])
        --self.go_table.aorimage_choose:SetLocalPositionToZero()
    end
    if self.isChat == 1 then
        self.go_table.aorbtn_Share:SetActiveE(0)
        if self.chatBct == _G.BattleControllerType.SociatyBattleLeague then
            self.go_table.aorbtn_Reply:SetActiveE(0)
        end
    else
        if self.reportType > 0 then
            self.go_table.aorbtn_Share:SetActiveE(1)
        else
            self.go_table.aorbtn_Share:SetActiveE(0)
        end
    end
    if self.hideCombBtn then
        self.go_table.aorbtn_Comb:SetActiveE(0)
    end
    if self.hidePetBtn then
        self.go_table.aorbtn_Pet:SetActiveE(0)
    end
end

