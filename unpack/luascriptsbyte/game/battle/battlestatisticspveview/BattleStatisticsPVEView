function BattleStatisticsPVEView:OnCreate(data, win, call, playerInfo, otherInfo, ...)
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.BattleStatisticsPVEView, self.go_table)
    local args = { ... }
    self.CurShowType = ShowType.Card
    self.index = args[1] or 1
    self.isReport = args[2] or false      -- 是否是从战报里使用
    self.fight_arg = args[3] or nil       -- 战报里回放使用
    self.GetFightArgCall = args[4] or nil -- 战报里回放使用
    self.playback_uid = args[5] or {}     -- 战报UID,分享功能使用
    self.reportType = args[6] or 0        --战报类型
    self.isChat = args[7] or 0            --是否是聊天打开
    self.chatBct = args[8] or ""          --聊天对应战斗类型
    self.afkPage = args[9] or 1           --放置页
    self.fzsid = args[10] or nil          --放置id
    self.exchange = args[11] or false     --攻守方标题是否互换
    self.replyHandler = args[12] or nil
    self.hideCombBtn = args[13] or nil
    self.hidePetBtn = args[14] or nil   --隐藏宠物面板
    self.reportParams = args[15] or nil --战报回放参数
    ---ZHJ-17606【世界boss】战报界面点击回放没有响应
    self.playerinfo = playerInfo or {}
    self.hideResultFlag = self.playerinfo.hideResultFlag
    self.otherinfo = otherInfo or nil
    self.totalPage = #win
    self.garraytable = (otherInfo or {}).garray or {}
    self.winnertable = win
    self.StoryList = nil
    self.data = data
    self.myItem.scrollloopvectical_mCard:InitItemData(0, _G.handlerbind(self, self.RefreshList))
    self.enemyItem.scrollloopvectical_eCard:InitItemData(0, _G.handlerbind(self, self.RefreshList2))

    ---@type EmbattleModel
    local embattleModel = require("EmbattleModel"):GetInstance()
    --检查合击技是否开放
    if not self.hideCombBtn and not embattleModel:CheckSkillPosUnLock(1) then
        self.hideCombBtn = true
    end
    --检查宠物技是否开发
    if not self.hidePetBtn and not embattleModel:CheckPetSkillPosUnLock(1) then
        self.hidePetBtn = true
    end

    self:ShowText()
    self:InitView(self.index)
    self.call = call
end

function BattleStatisticsPVEView:GetFightArg(index)
    if not _G.table.isEmptyOrNil(self.fight_arg) then
        if #self.fight_arg > 0 then
            return self.fight_arg[index]
        else
            return self.fight_arg
        end
    else
        return nil
    end
end

