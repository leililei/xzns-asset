---打开地图选择界面
function TestBattleEmView:OpenChooseView()
    self.go_table.obj_ChooseMapView:SetActiveE(1)
    local isRefresh = true

    self.MapSid = {}
    for i, _ in pairs(self.Maps) do
        table.insert(self.MapSid, i)
    end
    if self.IsFirst then
        self.ChooseView.looplist2_MapList:InitListView(0, _G.handlerbind(self, self.RefreshList))
        self.IsFirst = false
    end
    self.ChooseView.looplist2_MapList:SetListItemCount(_G.math.ceil(#self.MapSid / 3), true)
    if isRefresh then
        self.ChooseView.looplist2_MapList:RefreshAllShownItem()
    end
end

function TestBattleEmView:RefreshList(listView2, index)
    if index < 0 then
        return
    end
    local list = self.Maps
    local item = listView2:NewListViewItem("$_obj_ListItem")
    local x = index * 3 + 1
    item:SetName(x)
    local tb_i = {}
    local data = {}
    for i = 1, 3 do
        tb_i =
            _G.GetAutoGoTable(
            item:FindE(string.format("$_obj_Item%d", i)),
            _G.handlerbind(self, self.OnClickItem, x + i - 1)
        )
        data = list[self.MapSid[x + i - 1]]
        if data == nil then
            tb_i:SetActiveE(0)
        else
            tb_i:SetActiveE(1)
            tb_i.aorimage_Icon.SpriteName = data.note
            tb_i.aortext_Name.text = data.describe
        end
    end
    return item
end

---点击物品，放入选择列表
function TestBattleEmView:OnClickItem(go, IsOn, index)
    self.SelectMapSid = self.Maps[self.MapSid[index]].id
    self.go_table.aortext_MapName.text = _G.ConfigManager.monster_group_cfg[self.SelectMapSid].describe
    self.ChooseView:SetActiveE(0)
end

---按钮点击事件在这里派发
function TestBattleEmView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_Exit" then
        self:Exit()
    elseif name == "@_aorbtn_Battle" then
        self:Battle()
    elseif name == "@_aorbtn_ChooseMap" then
        self:OpenChooseView()
    elseif name == "@_aorbtn_Last" then
        self:ChangePage(-1)
    elseif name == "@_aorbtn_Next" then
        self:ChangePage(1)
    elseif name == "@_aorbtn_ClearEmBtn" then
        self:ClearEmData()
    end
end

---清空布阵
function TestBattleEmView:ClearEmData()
    self.TeamSid.Attack = {0, 0, 0, 0, 0, 0}
    self.TeamSid.Defence = {{0, 0, 0, 0, 0, 0}}
    self.CurPage = 1
    self.go_table.aortext_Page.text = self.CurPage
    self:RefreshEmenyPanel()
    if self.IsTest then
        self:RefreshPanel()
    else
        self:OfficialRefreshPanel()
    end
end

function TestBattleEmView:ChangePage(num)
    if self.CurPage + num <= 0 then
        return
    end
    self.CurPage = self.CurPage + num
    if self.TeamSid.Defence[self.CurPage] == nil then
        self.TeamSid.Defence[self.CurPage] = {0, 0, 0, 0, 0, 0}
    end
    self.go_table.aortext_Page.text = self.CurPage
    self:RefreshEmenyPanel()
end

function TestBattleEmView:Exit()
    _G.PoolsManager:GetInstance():Despawn(self.sceneTrans, _G.ePoolType.Temporary)
    _G.TestBattleManager:GetInstance():ClearView(true)

    for i = 1, #self.heroes do
        self.heroes[i]:dispose()
    end
    self:Close()
end

