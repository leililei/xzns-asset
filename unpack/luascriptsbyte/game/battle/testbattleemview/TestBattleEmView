local EmbattleRolePointPath = "Dynamics/Role/"
local EmbattleRolePointName = {"01", "04", "02", "05", "03", "06"}

local EmbattleSceneEffectPath = "Effect/Battle/UI/xinbuzhenjiemian_effect/prefab/ef_buzhenjiemian_01_bj"
local EmbattleSHLShowEffectPath = "Effect/Battle/UI/xinbuzhenjiemian_effect/prefab/ef_buzhenjiemian_01_shlchux"
local EmbattleJLRShowEffectPath = "Effect/Battle/UI/xinbuzhenjiemian_effect/prefab/ef_buzhenjiemian_01_jlrchux"

