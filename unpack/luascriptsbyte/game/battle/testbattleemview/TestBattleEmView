function TestBattleEmView:Battle()
    if self.SelectMapSid == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("cfg does not have this MapSid ")
        end
        return
    end
    local TeamSid = _G.DeepCopy(self.TeamSid)

    local isNil = true
    for _, v in pairs(TeamSid.Attack) do
        if v > 0 then
            isNil = false
            break
        end
    end
    if isNil then
        if _G.AppSetting.DEBUG then
            _G.LogError("Not role in Team")
        end
        return
    end

    -- self.sceneTrans:SetActiveE(0)
    local tmp = {}
    for key, value in pairs(TeamSid.Defence) do
        isNil = true
        for _, v in pairs(value) do
            if v > 0 then
                isNil = false
                break
            end
        end
        if not isNil then
            table.insert(tmp, value)
        end
    end
    if table.isEmptyOrNil(tmp) then
        if _G.AppSetting.DEBUG then
            _G.LogError("Not role in Team")
        end
        return
    end
    TeamSid.Defence = tmp
    local AttackData = {}
    local cardData = {}
    if not table.isEmptyOrNil(TeamSid.Attack) then
        for _, v in pairs(TeamSid.Attack) do
            cardData = self.TeamData.Attack[v]
            if cardData ~= nil then
                cardData:CalcNowSumProp()
                cardData = cardData.NowSumProp
            else
                cardData = {}
                for _, v in pairs(_G.AttrType) do
                    cardData[v.key] = 0
                end
            end
            table.insert(AttackData, cardData)
        end
    end
    for i = 1, #self.heroes do
        if self.heroes[i].roleTrans ~= nil then
            self.heroes[i]:dispose()
        end
    end
    --TODO 待流程开发完毕删掉
    if not table.isEmptyOrNil(TeamSid.Attack) then
        for i, v in pairs(TeamSid.Attack) do
            TeamSid.Attack[i] = self.TeamData.Attack[v] and self.TeamData.Attack[v].sid or 0
        end
    end
    if self.IsTest then
        _G.PlayerPrefsManager.SetTable("EmBattleData", TeamSid)
    else
        _G.PlayerPrefsManager.SetTable("OfficialEmBattleData", TeamSid)
    end

    _G.PoolsManager:GetInstance():Despawn(self.sceneTrans, _G.ePoolType.Temporary)
    _G.BattleManager:GetInstance():StartTestFight(self.SelectMapSid, TeamSid, AttackData, self.type + 2)

    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.TestBattleEmView.Name)
end

return TestBattleEmView
