local EmbattleViewCardItem = _G.BaseClass("EmbattleViewCardItem")

local function GetTypeByIndex(index)
    return index % 2 == 1 and _G.HeroType.Hero or _G.HeroType.Guardian
end

function EmbattleViewCardItem:__init(obj, index, click)
    self.index = index
    self.clickFunction = click
    self.go_table = _G.GetAutoGoTable(obj)
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.stars = {}
    for i = 1, MaxStar do
        table.insert(self.stars, self.go_table["aorimage_Star" .. i])
    end
    self.initRoleTrans = false
    if not _G.IsNil(self.go_table.obj_effectRoot) then
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.EmbattleLink, self.go_table.obj_effectRoot)
    end
end
function EmbattleViewCardItem:SetRolePoint(rolePoint)
    self.rolePoint = rolePoint
    self:CreateRoleTrans()
end
function EmbattleViewCardItem:InitData(data, bl)
    if self.data ~= nil and data.uid ~= 0 and self.data.uid == data.uid then
        return
    end
    self:DestroyRoleTrans()
    self.data = data
    if not data.uid or data.uid <= 0 then
        if bl then
            self.go_table.obj_choose:SetActiveE(1)
            self.go_table.obj_Hero:SetActiveE(0)
        else
            self.go_table.obj_choose:SetActiveE(0)
            self.go_table.obj_Hero:SetActiveE(0)
        end

        self.go_table.obj_choose:GetChildE(1):SetActiveE(data.uid == 0 and 1 or 0)
        self.go_table.obj_choose:GetChildE(2):SetActiveE(data.uid == 0 and 1 or 0)
        return
    end
    self.go_table.obj_choose:SetActiveE(0)
    self.go_table.obj_Hero:SetActiveE(1)
    self.modelPath = data.cfg.ModelPathLow
    --设置星级
    for i = 1, data.star do
        self.stars[i].SpriteName = StarImageName.active
    end
    for i = data.star + 1, MaxStar do
        self.stars[i].SpriteName = StarImageName.deactive
    end
    self.go_table.aortext_level.text = data.lv
    self.go_table.aorimage_Color.SpriteName = EmbattleCardColorIconName[data.cfg.Order]
    self.go_table.aorimage_Icon.SpriteName = data.cfg.Icon

    self.isShowEffect = true
    self:CreateRoleTrans()
    self.isShowEffect = false
end
function EmbattleViewCardItem:CreateRoleTrans()
    if self.initRoleTrans then
        return
    end
    if _G.IsNil(self.rolePoint) then
        return
    end
    if self.data.uid <= 0 then
        return
    end
    self.initRoleTrans = true
    local effectObj
    if self.isShowEffect then
        if GetTypeByIndex(self.index) == _G.HeroType.Hero then
            effectObj = heroShowEffectObj
        else
            effectObj = guardianShowEffectObj
        end
        effectObj:SetParentE(self.rolePoint)
        effectObj:SetLocalPosition(0, 0, 0)
        effectObj:SetActiveE(0)
        effectObj:SetActiveE(1)
    end
    effectObj = nil
    _G.PoolsManager:GetInstance():Spawn(
        self.modelPath,
        _G.ePoolType.World,
        self.rolePoint,
        function(trans)
            self.roleTrans = trans
            if trans then
                trans:SetLocalPosition(0, 0, 0)
            end
            if self.data.uid <= 0 then
                self:DestroyRoleTrans()
            end
        end
    )
end
function EmbattleViewCardItem:DestroyRoleTrans()
    if _G.IsNil(self.roleTrans) then
        return
    end
    _G.PoolsManager:GetInstance():Despawn(self.roleTrans, _G.ePoolType.World)
    self.roleTrans = nil
    self.initRoleTrans = false
end
function EmbattleViewCardItem:OnClickBtn(btn)
    if self.data.uid < 0 then
        return
    end
    if self.clickFunction then
        self.clickFunction(self.index)
    end
end

function EmbattleViewCardItem:dispose()
    self:DestroyRoleTrans()
    self:Dispose()
end
--endregion

-----加载场景特效
local function LoadSceneEffect(root)
    if _G.IsNil(sceneBackgroundEffectObj) then
        _G.PoolsManager:GetInstance():Spawn(
            EmbattleSceneEffectPath,
            _G.ePoolType.Temporary,
            root,
            function(trans)
                sceneBackgroundEffectObj = trans
            end
        )
    end
    if _G.IsNil(guardianShowEffectObj) then
        _G.PoolsManager:GetInstance():Spawn(
            EmbattleSHLShowEffectPath,
            _G.ePoolType.Temporary,
            root,
            function(trans)
                guardianShowEffectObj = trans
                guardianShowEffectObj:SetActiveE(0)
            end
        )
    else
        guardianShowEffectObj:SetActiveE(0)
    end
    if _G.IsNil(heroShowEffectObj) then
        _G.PoolsManager:GetInstance():Spawn(
            EmbattleJLRShowEffectPath,
            _G.ePoolType.Temporary,
            root,
            function(trans)
                heroShowEffectObj = trans
                heroShowEffectObj:SetActiveE(0)
            end
        )
    else
        heroShowEffectObj:SetActiveE(0)
    end
end

-----加载布阵场景
---@param  view EmbattleView 界面对象
---@field camera _G.Camera
local function LoadEmbattleScene(view, callback)
    _G.PoolsManager:GetInstance():Spawn(
        EmbattleScenePrefabPath,
        _G.ePoolType.Temporary,
        nil,
        function(trans)
            _G.TestBattleManager:GetInstance():ClearView(false)
            trans:SetLocalPosition(0, 0, 0)
            view.sceneTrans = trans
            view.rolePointTrans = {}
            for i = 1, #EmbattleRolePointName do
                table.insert(view.rolePointTrans, trans:FindE(EmbattleRolePointPath .. EmbattleRolePointName[i]))
            end
            view.go_table.obj_bg:SetActiveE(0)
            -- _G.GraphicsManager.Instance.MainCamera.targetTexture = view.go_table.aorrawimage_cameraTex.texture
            -- view.go_table.aorrawimage_cameraTex:SetActiveE(1)

            if callback then
                callback()
            end
            LoadSceneEffect(trans)
        end
    )
end

function TestBattleEmView:Awake()
    _G.TestBattleManager:GetInstance():ClearView(false)
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.ChooseView = _G.GetAutoGoTable(self.go_table.obj_ChooseMapView, _G.handler(self, self.OnClickChooseViewBtn))
    self.posEffectRoot = {
        self.go_table.aorbtn_pos1,
        self.go_table.aorbtn_pos2,
        self.go_table.aorbtn_pos3,
        self.go_table.aorbtn_pos4,
        self.go_table.aorbtn_pos5,
        self.go_table.aorbtn_pos6
    }
    self.CurPage = 1
    self.Maps = {}
    for i, v in pairs(_G.ConfigManager.monster_group_cfg) do
        if i >= 1000 and i < 2000 then
            table.insert(self.Maps, v)
        end
    end
    table.sort(
        self.Maps,
        function(a, b)
            return a.id < b.id
        end
    )
    for _, v in pairs(self.Maps) do
        if v.id >= 1000 and v.id < 2000 then
            self.SelectMapSid = v.id
            self.go_table.aortext_MapName.text = _G.ConfigManager.monster_group_cfg[self.SelectMapSid].describe
            break
        end
    end

    self.IsFirst = true
end

---界面的入口函数
function TestBattleEmView:OnCreate(type, IsTest)
    _G.TestBattleManager:GetInstance():SetBattleType(3)
    self.IsTest = IsTest
    if self.IsTest then
        self.TeamSid = _G.PlayerPrefsManager.GetTable("EmBattleData")
    else
        self.TeamSid = _G.PlayerPrefsManager.GetTable("OfficialEmBattleData")
    end

    if self.TeamSid == nil then
        self.TeamSid = {Attack = {0, 0, 0, 0, 0, 0}, Defence = {{0, 0, 0, 0, 0, 0}}}
    end
    self.type = type
    local function callback(index)
        self:ItemClickCallback(index)
    end
    local function callback2(i, v, go, index)
        self:ItemClickCallback2(index)
    end
    self.heroes = {}
    table.insert(self.heroes, EmbattleViewCardItem.New(self.go_table.obj_Hero1, 1, callback))
    table.insert(self.heroes, EmbattleViewCardItem.New(self.go_table.obj_Guardian1, 2, callback))
    table.insert(self.heroes, EmbattleViewCardItem.New(self.go_table.obj_Hero2, 3, callback))
    table.insert(self.heroes, EmbattleViewCardItem.New(self.go_table.obj_Guardian2, 4, callback))
    table.insert(self.heroes, EmbattleViewCardItem.New(self.go_table.obj_Hero3, 5, callback))
    table.insert(self.heroes, EmbattleViewCardItem.New(self.go_table.obj_Guardian3, 6, callback))
    self.EnemyHeroes = {}
    table.insert(self.EnemyHeroes, _G.GetAutoGoTable(self.go_table.obj_EnemyHero1, _G.handlerbind(self, callback2, 1)))
    table.insert(
        self.EnemyHeroes,
        _G.GetAutoGoTable(self.go_table.obj_EnemyGuardian1, _G.handlerbind(self, callback2, 2))
    )
    table.insert(self.EnemyHeroes, _G.GetAutoGoTable(self.go_table.obj_EnemyHero2, _G.handlerbind(self, callback2, 3)))
    table.insert(
        self.EnemyHeroes,
        _G.GetAutoGoTable(self.go_table.obj_EnemyGuardian2, _G.handlerbind(self, callback2, 4))
    )
    table.insert(self.EnemyHeroes, _G.GetAutoGoTable(self.go_table.obj_EnemyHero3, _G.handlerbind(self, callback2, 5)))
    table.insert(
        self.EnemyHeroes,
        _G.GetAutoGoTable(self.go_table.obj_EnemyGuardian3, _G.handlerbind(self, callback2, 6))
    )

    self.TeamData = {}
    self:InitTeamData()
    if self.IsTest then
        self:RefreshPanel()
    else
        self:OfficialRefreshPanel()
    end
    self:RefreshEmenyPanel()
    LoadEmbattleScene(
        self,
        function()
            self.effectTable = {}
            local index = 1
            for i = 1, #self.heroes do
                -- local pos = _G.UIUtils.Get3DTo2DPos(self.go_table.rect_pos, self.rolePointTrans[i].position)
                -- self.posEffectRoot[i]:SetLocalPosition(pos.x, 0, 0)
                self.heroes[i]:SetRolePoint(self.rolePointTrans[i])
            end
            self:LoadPosEffect()
        end
    )
end

function TestBattleEmView:InitTeamData()
    self.TeamData.Attack = {}
    self.TeamData.Defence = {}
    local card = {}
    if self.type == 1 then
        for _, v in pairs(_G.ConfigManager.card_cfg) do
            card = _G.CardData.New()
            card:Parse({sid = v.id, uid = v.id})
            self.TeamData.Attack[v.id] = card
        end
    elseif self.type == 2 then
        local list = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card)
        if list ~= nil then
            for _, v in pairs(list) do
                card = {}
                table.insert(card, v)
                self.TeamData.Attack[v.uid] = card[1]
            end
        end
    end
    for _, v in pairs(_G.ConfigManager.card_cfg) do
        card = _G.CardData.New()
        card:Parse({sid = v.id, uid = v.id})
        self.TeamData.Defence[v.id] = card
    end
end

function TestBattleEmView:LoadPosEffect()
    self.effectTable = {}
    local index = 1
    local function loadEffect()
        local effItem
        if GetTypeByIndex(index) == _G.HeroType.Hero then
            effItem = _G.ConfigManager.ui_effect_cfg.EmbattleChoose_red
        else
            effItem = _G.ConfigManager.ui_effect_cfg.EmbattleChoose_blue
        end
        _G.UIUtils.LoadEffectByCfg(
            effItem,
            self.go_table.rect_pos,
            function(trans)
                trans:SetActiveE(self.posEffectRoot[index]:GetActiveSelf() == 1)
                self.effectTable[index] = trans
                local x, y, z = self.posEffectRoot[index]:GetLocalPosition()
                trans:SetLocalPosition(x, y, z)
                index = index + 1
                if index <= #self.posEffectRoot then
                    loadEffect()
                end
            end
        )
    end
    loadEffect()
end

function TestBattleEmView:ItemClickCallback(index)
    local Card
    if index % 2 == 0 then
        Card = self.TeamData.Attack[self.TeamSid.Attack[index - 1]]
    end
    local CardList = self.TeamData.Attack
    if not self.IsTest then
        CardList = {}
        for i, v in pairs(self.TeamData.Attack) do
            if index % 2 == 0 then
                if v.cfg.UnitType == _G.HeroType.Guardian and require "CardInfoManager":GetInstance():CheckMultiMatch(v.cfg.Elements_new, Card.cfg.Elements_new) then
                    CardList[i] = v
                end
            else
                if v.cfg.UnitType == _G.HeroType.Hero then
                    CardList[i] = v
                end
            end
        end
    end
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.TestEmCardList.Name,
        index,
        self.TeamSid.Attack,
        CardList,
        function(uid, _index)
            if uid == 0 or _index == 0 then
                return
            end
            if not self.IsTest and index % 2 == 1 then
                local Pos1 = index
                local Pos2 = nil
                for i, v in pairs(self.TeamSid.Attack) do
                    if v == uid then
                        Pos2 = i
                    end
                end
                if Pos2 ~= nil then
                    local GhostUid = self.TeamSid.Attack[Pos2 + 1]
                    self.TeamSid.Attack[Pos2] = self.TeamSid.Attack[index]
                    self.TeamSid.Attack[Pos2 + 1] = self.TeamSid.Attack[index + 1]
                    self.TeamSid.Attack[index] = uid
                    self.TeamSid.Attack[index + 1] = GhostUid
                else
                    self.TeamSid.Attack[index] = uid
                    local MasterData = self.TeamData.Attack[self.TeamSid.Attack[index]]
                    local GhostData = self.TeamData.Attack[self.TeamSid.Attack[index + 1]]
                    if GhostData ~= nil and not require "CardInfoManager":GetInstance():CheckMultiMatch(MasterData.cfg.Elements_new, GhostData.cfg.Elements_new) then
                        self.TeamSid.Attack[index + 1] = 0
                    end
                end

                self:OfficialRefreshPanel()
            else
                self.TeamSid.Attack[index] = uid
                self:RefreshPanel()
            end
        end
    )
end

function TestBattleEmView:ItemClickCallback2(index)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.TestEmCardList.Name,
        index,
        self.TeamSid.Defence[self.CurPage],
        self.TeamData.Defence,
        function(uid, _index)
            if uid == 0 or _index == 0 then
                return
            end
            self.TeamSid.Defence[self.CurPage][index] = uid
            self:RefreshEmenyPanel()
        end
    )
end

function TestBattleEmView:RefreshPanel()
    local data = self.TeamSid
    if data.Attack ~= nil then
        for i = 1, #data.Attack do
            local tmp = self.TeamData.Attack[data.Attack[i]]
            self.heroes[i]:InitData(tmp and tmp or {uid = 0}, true)
            self.posEffectRoot[i]:SetActiveE(data.Attack[i] == 0 and 1 or 0)
            if self.effectTable and not _G.IsNil(self.effectTable[i]) then
                self.effectTable[i]:SetActiveE(data.Attack[i] == 0 and 1 or 0)
            end
        end
    end
end

function TestBattleEmView:RefreshEmenyPanel()
    local data = self.TeamSid
    if data.Defence ~= nil then
        local go
        local CardData
        for i, v in pairs(data.Defence[self.CurPage]) do
            go = self.EnemyHeroes[i]
            CardData = self.TeamData.Defence[v]
            if v <= 0 then
                go.obj_choose:SetActiveE(1)
                go.obj_Hero:SetActiveE(0)
            else
                go.obj_choose:SetActiveE(0)
                go.obj_Hero:SetActiveE(1)
                go.aorimage_Color.SpriteName = EmbattleCardColorIconName[CardData.cfg.Order]

                go.aorimage_Icon.SpriteName = data.cfg.Icon
                local star
                for i = 1, 7 do
                    star = go.obj_Hero:FindE(string.format("@_aorimage_Star%d", i))
                    if CardData.star >= i then
                        star:SetActiveE(1)
                    else
                        star:SetActiveE(0)
                    end
                end
                go.aortext_level.text = CardData.lv
            end
        end
    end
end

---正式刷新
function TestBattleEmView:OfficialRefreshPanel()
    local data = self.TeamSid
    if data.Attack ~= nil then
        for i = 1, #data.Attack do
            local tmp = self.TeamData.Attack[data.Attack[i]]
            if i % 2 == 0 and data.Attack[i - 1] == 0 then
                self.heroes[i]:InitData(tmp and tmp or {uid = 0}, false)
                self.posEffectRoot[i]:SetActiveE(0)
                if self.effectTable and not _G.IsNil(self.effectTable[i]) then
                    self.effectTable[i]:SetActiveE(0)
                end
            else
                self.heroes[i]:InitData(tmp and tmp or {uid = 0}, true)
                self.posEffectRoot[i]:SetActiveE(data.Attack[i] == 0 and 1 or 0)
                if self.effectTable and not _G.IsNil(self.effectTable[i]) then
                    self.effectTable[i]:SetActiveE(data.Attack[i] == 0 and 1 or 0)
                end
            end
        end
    end
end

