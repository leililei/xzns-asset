    if SpeedBtn then
        SpeedBtn:SetActiveE(bl and 1 or 0)
    end
end

---设置自动按钮状态
---@param active boolean 是否激活
---@param selected? boolean 是否被选中
---@param saveAutoKey? string 状态存储key
function BattleView:SetAutoBtnShow(active, selected, saveAutoKey)
    self.AutoBtn:SetActiveE(active and 1 or 0)
    if not active then
        return
    end
    local isOpen = require("SecretRealmModel"):GetInstance():IsBattleAutoOpen()
    self.AutoBtnLock:SetActiveE(isOpen and 0 or 1)
    if isOpen == false then
        self.AutoBtnSelected:SetActiveE(0)
        return
    end
    self.saveAutoKey = saveAutoKey or SaveAutoKeyDefault
    if selected == nil then
        selected = _G.PlayerPrefsManager.GetInt(self.saveAutoKey, 0) == 1
    end
    self.AutoBtnSelected:SetActiveE(selected and 1 or 0)
end

