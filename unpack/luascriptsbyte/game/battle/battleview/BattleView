function BattleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.FightPlayState.FightStart, self.StartFight, self)
end

function BattleView:StartFight()
    local speedValue = _G.ConfigManager.discrete_cfg[discreteID.Speed]
    if speedValue[1] and speedValue[1][1] and speedValue[1][1] == require("AfkModel"):GetInstance():GetCurSection() then
        self:SetGuideEff(EffType.Speed)
    end

    if AppSetting.IsXzns then
        self:InitSpeedIndex()
        if self.index == 1 then
            self.speedEffect:SetActiveE(0)
            self:RefreshXZNSEffNode(false,self.index)
        else
            self.speedEffect:SetActiveE(1)
            self:RefreshXZNSEffNode(true,self.index)
        end
    else
        local curSpeed = _G.BattleManager:GetInstance():GetCurSpeed()
        if curSpeed > 1 then
            self.speedEffect:SetActiveE(1)
        else
            self.speedEffect:SetActiveE(0)
        end
    end
end

---界面的入口函数
function BattleView:OnCreate(inacitve)
    self.BmInst = _G.CS.BattleManager.Inst
    self.SpeedIsGuide = _G.PlayerPrefsManager.GetInt("BattleGuideSp")
    self.AutoIsGuide = _G.PlayerPrefsManager.GetInt("BattleGuideAt")
    self.Speedbtn = self.transform:FindE("UIRoot/CommRoots/Content/SpeedBtn")
    self.SkipBtn = self.transform:FindE("UIRoot/CommRoots/Content/SkipBtn")
    self.LockSkipBtn = self.transform:FindE("UIRoot/CommRoots/Content/LockSkipBtn")
    self.Combinebtn = self.transform:FindE("UIRoot/SkillsRoots/JointSkillGroup/0/Drag")
    self.AutoBtn = self.transform:FindE("UIRoot/CommRoots/Content/AutoBtn")
    self.AutoBtnSelected = self.transform:FindE("UIRoot/CommRoots/Content/AutoBtn/Selected")
    self.AutoBtnLock = self.transform:FindE("UIRoot/CommRoots/Content/AutoBtn/Lock")
    self.BagBtn = self.transform:FindE("UIRoot/CommRoots/BagBtn")
    self.BagBtnText = self.transform:FindE("UIRoot/CommRoots/BagBtn/Text"):GetComponentE(_G.typeof(_G.CS.AorText))
    self.speedEffect = self.transform:FindE("UIRoot/CommRoots/Content/SpeedBtn/Effect")
    self.StatisticsView = self.transform:FindE("UIRoot/CommRoots/Statistics_xzns")
    self.updateStatisticsTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateStatistics, self, false, false, true)
    self.updateStatisticsTimer:Start()
    if _G.AppSetting.IsXzns then
        -- self.AutoBtn = self.transform:FindE("UIRoot/CommRoots/Content/SkipBtn/AutoBtn")
        -- self.AutoBtnSelected = self.transform:FindE("UIRoot/CommRoots/Content/SkipBtn/AutoBtn/Selected")
        -- self.AutoBtnLock = self.transform:FindE("UIRoot/CommRoots/Content/SkipBtn/AutoBtn/Lock")
        self.timeNode = self.transform:FindE("UIRoot/CommRoots/time")

        ---@type table<BattleView.BtnType,BattleView.btnData>
        self.btnItemDict = {
            [BtnType.Speed] = {
                UseIng = self.Speedbtn:FindE("Use"),
                NoUseIng = self.Speedbtn:FindE("NoUse")
            }
        }
        self.SpeedText_NoUse = self.btnItemDict[BtnType.Speed].NoUseIng:FindE("Text"):GetComponentE(_G.typeof(_G.CS
            .AorText))
        self.SpeedText_Use = self.Speedbtn:FindE("Text"):GetComponentE(_G.typeof(_G.CS.AorText))
    end
    if self.Speedbtn then
        self.Speedbtn:GetComponentE(_G.typeof(_G.CS.AorButton)).onClick:AddListener(
            _G.handlerbind(self, self.OnClickActiveBtn, "SpeedBtn")
        )
    end
    if self.LockSkipBtn then
        self.LockSkipBtn:GetComponentE(_G.typeof(_G.CS.AorButton)).onClick:AddListener(
            _G.handlerbind(self, self.OnClickActiveBtn, "LockSkipBtn")
        )
    end
    if self.AutoBtn then
        self.AutoBtn:GetComponentE(_G.typeof(_G.CS.AorButton)).onClick:AddListener(
            _G.handlerbind(self, self.OnClickActiveBtn, "AutoBtn")
        )
        --self.AutoBtnSelected:DOFadeLoop(0, 1, -1, 1)
        self.AutoBtn:SetActiveE(0)
    end
    if self.BagBtn then
        self.BagBtn:GetComponentE(_G.typeof(_G.CS.AorButton)).onClick:AddListener(
            _G.handlerbind(self, self.OnClickActiveBtn, "BagBtn")
        )
        self.BagBtn:SetActiveE(0)
    end
    self.AtActive = true
    self.LockSkipBtn:SetActiveE(0)

    --ZHJH-3814【爬塔】在要塞界面等待战斗结束，点下一关后会闪一下战斗界面中的顶部栏位
    if inacitve then
        self:Hide()
    end

    self.Delaydpstext = _G.DelayFrameDo(function()
        --LogError(self.BmInst.HideFloat)
        if _G.AppSetting.IsEditor or _G.AppSetting.IsAndriod or _G.AppSetting.IsIos then
            self.go_table.toggle_hidedpstext:SetActiveE(1)
            self.go_table.toggle_hidedpstext.isOn = self.BmInst.HideFloat
        end
    end)

    self:LoadEff()
end

function BattleView:OnEnable()
    self:InitAnimation()
    self:PlayAnimation()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ChatDefultRootView.Name)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.FloatMessagesView.Name)
end

function BattleView:OnDisable()
    if self.animatorStopTimer then
        self.animatorStopTimer:Stop()
        self.animatorStopTimer = nil
        self:StopAnimation()
    end
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ChatDefultRootView.Name)
end

function BattleView:OnDestroy()
    if self.updateStatisticsTimer then
        self.updateStatisticsTimer:Stop()
        self.updateStatisticsTimer = nil
    end
end

---按钮点击事件在这里派发
---@param go gameObject
function BattleView:OnClickBtn(go, isOn)
    local name = go:GetName()
    --LogError(name)
    if name == "@_aorbtn_AtBtn" then
        if self.AtActive then
            _G.FunctionManager:GetInstance():ShowFuncitonOpenTips(31)
        else
            self:TrainBattle()
        end
    elseif name == "@_aorbtn_SpBtn" or name == "@_aorbtn_SetBtn" then
        _G.FunctionManager:GetInstance():ShowFuncitonOpenTips(30)
    elseif name == "$_toggle_hidedpstext" then
        if self.BmInst.View and self.BmInst.View.TipsView then
            --LogError(isOn)
            self.BmInst.HideFloat = isOn
            self.BmInst.View.TipsView:SetHideFloat(isOn)
        end
    end
end

--region 镇魂特训 临时
function BattleView:TrainBattle()
    local flag = false
    flag = require("TrainingModel"):GetInstance():GetIsTrainBattle()
    if not flag then
        return
    end
    local scetionid = require("TrainingModel"):GetInstance():GetTrainScetionID()
    local autoFight = _G.ConfigManager.train_section_cfg[scetionid].autofight -- 0 自动 -- 1 手动
    if autoFight ~= 1 then
        _G.FloatTipsModel:GetInstance():Show(_G.LangUtil.GetLangPackValue(90024300057))
    end
end

--endregion

function BattleView:InitSpeedIndex()
    self.index = 0
    local curSpeed
    curSpeed, self.maxSpeed = _G.BattleManager:GetInstance():GetCurSpeed()
    -- 新号登录时返回的speed为0
    if curSpeed == 0 then
        curSpeed = 1
    end
    local speedData = _G.ConfigManager.discrete_cfg[100122]
    for k, v in pairs(speedData) do
        if curSpeed == v[1] then
            self.index = k
        end
    end
end

---按钮点击事件在这里派发
---@param name string
function BattleView:OnClickActiveBtn(name)
    if name == "SpeedBtn" then
        if self.SpeedIsGuide then
            -- 关闭特效及界面
            if self.SpEff then
                _G.PoolsManager:GetInstance():Despawn(self.SpEff, _G.ePoolType.UIItem)
                self.SpEff = nil
            end
            if self.TipsS then
                _G.PoolsManager:GetInstance():Despawn(self.TipsS, _G.ePoolType.UIItem)
                self.TipsS = nil
            end
            self.SpeedIsGuide = nil
        end
        if not self.maxSpeed then
            self:InitSpeedIndex()
        end
        self.index = self.index + 1
        if self.index > self.maxSpeed then
            self.index = 1
            if self.maxSpeed < 3 and not _G.BattleManager:GetInstance().noSpTip then
                if _G.AppSetting.IsAlipay then
                    _G.PopWindowManager:GetInstance():ShowAllTips(3708)
                else
                    if _G.AppSetting.IsArraigned then
                        _G.PopWindowManager:GetInstance():ShowAllTips(3707)
                    else
                        _G.PopWindowManager:GetInstance():ShowAllTips(220103)
                    end
                end
            end
        end
        if self.index == 1 then
            self.speedEffect:SetActiveE(0)
            self:RefreshXZNSEffNode(false,self.index)
        else
            self.speedEffect:SetActiveE(1)
            self:RefreshXZNSEffNode(true,self.index)
        end
    elseif name == "LockSkipBtn" then
        if self.lockSkipTip then
            local str
            if self.lockSkipTip == 3704 then
                str = _G.GetLangPackValue(_G.GameUtil.GetVoucherArg(90020800026, 90036300034))
            end
            _G.PopWindowManager:GetInstance():ShowAllTips(self.lockSkipTip, str)
            return
        end
        if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(skipBattleFuncOpenConfigSid) then
            _G.FunctionManager:GetInstance():ShowFuncitonOpenTips(skipBattleFuncOpenConfigSid)
        end
    elseif name == "AutoBtn" then
        local isOpen = require("SecretRealmModel"):GetInstance():IsBattleAutoOpen()
        if isOpen == false then
            _G.PopWindowManager:GetInstance():ShowAllTips(1020009)
            return
        end
        local key = self.saveAutoKey or SaveAutoKeyDefault
        local selected = _G.PlayerPrefsManager.GetInt(key, 0) == 1 --之前存储的状态
        selected = not selected
        self.AutoBtnSelected:SetActiveE(selected and 1 or 0)
        _G.PlayerPrefsManager.SetInt(key, selected and 1 or 0)
    elseif name == "BagBtn" then
        if self.bagCallback then
            self.bagCallback()
        end
    end
end

function BattleView:RefreshXZNSEffNode(isShow,speedmodel)
    if _G.AppSetting.IsXzns then
        self.btnItemDict[BtnType.Speed].UseIng:SetActiveE(isShow and 1 or 0)
        self.btnItemDict[BtnType.Speed].NoUseIng:SetActiveE(isShow and 0 or 1)
        self.SpeedText_Use.transform:SetActiveE(isShow and 1 or 0)
        if speedmodel then
            if speedmodel == 3 then
                self.SpeedText_Use.text = "x4"
            else
                self.SpeedText_Use.text = "x" .. speedmodel
            end
        end
    end
end

function BattleView:UpdateStatistics()
    if not self.go_table then
        if self.updateStatisticsTimer then
            self.updateStatisticsTimer:Stop()
            self.updateStatisticsTimer = nil
        end
        return
    end
    _G.GameUtil.ReBuildRTF(self.StatisticsView:FindE("Show"))
end

---加载特效
function BattleView:LoadEff()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_zidongzhandou,
        self.AutoBtnSelected,
        function(tran)
            if self:IsNil() then
                _G.UIUtils.RemoveEffect(tran)
                return
            end
            tran:SetLocalScaleXYZ(0.8)
        end
    )
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_zidongzhandou,
        self.speedEffect,
        function(tran)
            if self:IsNil() then
                _G.UIUtils.RemoveEffect(tran)
                return
            end
            tran:SetLocalScaleXYZ(0.8)
        end
    )
end

---设置引导的特效
---@param type EffType 类型
function BattleView:SetGuideEff(type)
    if type == EffType.Speed and self.SpeedIsGuide ~= 1 then
        ---打开特效及界面
        self.SpeedIsGuide = true
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.Ef_yindaodianji,
            self.Speedbtn,
            function(tran)
                if tran then
                    self.SpEff = tran
                end
            end
        )
        _G.PoolsManager:GetInstance():Spawn(
            TipsPrefabPath,
            _G.ePoolType.UIItem,
            self.Speedbtn,
            function(tran)
                if tran then
                    self.TipsS = tran
                    local tips = tran:FindE("@_aortext_tipsContent"):GetComponentE(_G.typeof(_G.CS.AorText))
                    if tips then
                        tips.text = _G.LangUtil.GetLangPackValue(language.Speed)
                    end
                end
            end
        )
        _G.PlayerPrefsManager.SetInt("BattleGuideSp", 1)
    end
end

