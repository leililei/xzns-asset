---设置设置按钮是否激活
---@param bl boolean 是否激活
function BattleView:SetSettingBtnActive(bl)
    local SettingBtn = self.transform:FindE("UIRoot/CommRoots/Content/Setting")
    if SettingBtn then
        SettingBtn:SetActiveE(bl and 1 or 0)
        ---上锁
        if bl then
            local lock = SettingBtn:FindE("Lock")
            if lock then
                local sid = require("AfkModel"):GetInstance():GetCurSection()
                lock:SetActiveE(sid <= 101006 and 1 or 0)
            end
        end
    end
end

