---初始化淡入动画
---@return void
function BattleView:InitAnimation()
    if not self.animator then
        self.animator = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    end
    if _G.IsNil(self.animator) then
        return
    end
    self:StopAnimation(false)

    -- self.animator.enabled = true
    self.animator:Play("ani_buzhengqieyeshang", true)
    self.animator:Update(0)
    self.animator.enabled = false
end

---播放淡入动画
---@return void
function BattleView:PlayAnimation()
    if not self.animator then
        self.animator = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    end
    if _G.IsNil(self.animator) then
        return
    end
    self.animator.enabled = false
    self.animator.enabled = true
    --延迟停止动画组件
    self.animatorStopTimer = _G.TimerManager:GetInstance():GetTimer(1, self.StopAnimation, self, true, false)
    self.animatorStopTimer:Start()
end

---停止播放动画
---@param changeAnimation? boolean 改变animation状态, 默认为true
---@return void
function BattleView:StopAnimation(changeAnimation)
    if self.animatorStopTimer then
        self.animatorStopTimer:Stop()
        self.animatorStopTimer = nil
    end

    if self:IsNil() or changeAnimation == false then
        return
    end
    if not self.animator then
        self.animator = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    end
    if _G.IsNil(self.animator) then
        return
    end

    self.animator:Play("ani_buzhengqieyeshang", true)
    self.animator:Update(1)
    self.animator.enabled = false
end

function BattleView:OnStartClose()
    if self.Delaydpstext then
        _G.coroutine.stopwaiting(self.Delaydpstext)
        self.Delaydpstext = nil
    end
end

return BattleView
