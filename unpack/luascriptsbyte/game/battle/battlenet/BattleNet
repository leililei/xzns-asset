local base = require("BaseGameNet")
---@class BattleNet : BaseGameNet	中文描述
local BattleNet = _G.BaseClass("BattleNet", base)

function BattleNet:Callback(port, data, error)
    if self.Call[port] then
        self.Call[port](data, error)
        self.Call[port] = nil
    end
end

---@param pbData table PB数据
---@param callback fun() 完成回调
function BattleNet:NpcPVEFight(pbData, callback)
    local item = _G.ConfigManager.net_map.game_instance_fight
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

