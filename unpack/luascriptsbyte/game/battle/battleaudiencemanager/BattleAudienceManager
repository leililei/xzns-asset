local BattleBasePlayer = require "BattleBasePlayer"
---@class BattleAudienceManager:Singleton	战斗内显示观众
local BattleAudienceManager = _G.BaseClass("BattleAudienceManager", _G.Singleton)

local MAXAUDIENCE = 4

---类的构造函数
function BattleAudienceManager:__init()
end

---类的析构函数
function BattleAudienceManager:Dispose()
end

---创建观众
---@param model_Path string 模型路径
---@param name string 玩家名
---@param halo_Effect string 光环路径
---@param callback function 初始化完成回调
---@param data table 展示额外数据
function BattleAudienceManager:CreateAudience(model_Path, name, halo_effect, title_effect, x, y, z, callback, data)
    if _G.IsNil(self.modelRoot) then
        self.modelRoot = _G.BattleManager:GetInstance():GetAudienceModelRoot()
    end
    if _G.IsNil(self.haloRoot) then
        self.haloRoot = _G.BattleManager:GetInstance():GetAudienceHaloRoot()
    end
    local robot =
        BattleBasePlayer.New(
        {
            modelPath = model_Path,
            name = name,
            haloEffect = halo_effect,
            titleEffect = title_effect,
            x = x,
            y = y,
            z = z,
            callback = callback
        },
        data,
        _G.WorldManager:GetInstance().CurrentWorld
    )
    _G.table.insert(self.AudiencesRoot, robot)
    robot:Init()
end
---退出布阵清理模型
function BattleAudienceManager:ClearAudiences()
    if self.AudiencesRoot and #self.AudiencesRoot > 0 then
        for _, v in pairs(self.AudiencesRoot) do
            v:Dispose()
            v:ClearObjectModel()
            if not _G.IsNil(v.gameObject) then
                _G.DestroyObject(v.gameObject)
            end
        end
        self.AudiencesRoot = {}
    end
end
---初始化
function BattleAudienceManager:InitData(msg)
    self.Data = {}
    local otherPlayerCount = 0
    if msg ~= nil then
        for _, v in ipairs(msg) do
            otherPlayerCount = otherPlayerCount + 1
            local card = require "CardCommentManager":GetInstance():CardData(v.city_style, false)
            local other = {
                ["modelPath"] = card.ModelPathLow,
                ["name"] = v.name,
                ["haloEffect"] = v.halo,
                ["titleEffect"] = v.title
            }
            table.insert(self.Data, other)
        end
    end

    if otherPlayerCount < 4 then
        local sceneRobotCfgs = _G.ConfigManager.scene_robot_cfg
        local robotCfgCount = _G.table.count(sceneRobotCfgs)
        if robotCfgCount < 3 - otherPlayerCount then
            if _G.AppSetting.DEBUG then
                _G.LogError("机器人配置数量不足")
            end
            return
        end
        local randomTable = {}
        for i = otherPlayerCount, 3 do
            local random = math.random(1, robotCfgCount)
            while table.ContainsValue(randomTable, random) do
                random = math.random(1, robotCfgCount)
            end
            table.insert(randomTable, random)
        end
        local robotIndex = 1
        local randomAllCount = #randomTable
        for _, v in pairs(sceneRobotCfgs) do
            if randomAllCount == 0 then
                break
            end
            if table.ContainsValue(randomTable, robotIndex) then
                local robotData = {
                    ["modelPath"] = v.model_path,
                    ["name"] = _G.GetLangPackValue(v.name),
                    ["haloEffect"] = v.halo_effect,
                    ["titleEffect"] = v.title_effect
                }
                table.insert(self.Data, robotData)
                randomAllCount = randomAllCount - 1
            end
            robotIndex = robotIndex + 1
        end
    end
    self.PosData = {
        [1] = {x = -7.5, y = 0, z = -9},
        [2] = {x = -7.5, y = 0, z = -2.5},
        [3] = {x = -7.5, y = 0, z = 4},
        [4] = {x = -7.5, y = 0, z = 6}
    }
end

function BattleAudienceManager:ShowAudience()
    self.AudiencesRoot = {}
    local count = 0
    for _, v in pairs(self.Data) do
        count = count + 1
        local posData = self.PosData[count]
        self:CreateAudience(v.modelPath, v.name, v.haloEffect, v.titleEffect, posData.x, posData.y, posData.z)
    end
end

function BattleAudienceManager:GetModelRoot()
    return self.modelRoot
end

function BattleAudienceManager:GetHaloRoot()
    return self.haloRoot
end

