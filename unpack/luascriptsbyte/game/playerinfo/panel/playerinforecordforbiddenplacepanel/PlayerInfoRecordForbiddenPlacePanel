end

---@private
function PlayerInfoRecordForbiddenPlacePanel:FindDarkDataIndex(monsterId)
    for i= 1, #self.msgDark do
        if self.msgDark[i].boss_id == monsterId then
            return i
        end
    end
    return 0
end

---@private
function PlayerInfoRecordForbiddenPlacePanel:GetFirstMonster(group)
    for i = 1, #group do
        if group[i] ~= 0 then
            return group[i]
        end
    end
    return 0
end

