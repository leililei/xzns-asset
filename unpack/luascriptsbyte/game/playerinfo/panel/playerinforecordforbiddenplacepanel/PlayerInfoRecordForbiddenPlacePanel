local PlayerInfoNet = require("PlayerInfoNet"):GetInstance()
local PlayerInfoRecordBossAndCardsItem = require("PlayerInfoRecordBossAndCardsItem")
local base=require "PlayerInfoRecordBasePanel"

---@class PlayerInfoRecordForbiddenPlacePanel : PlayerInfoRecordBasePanel  中文描述
---@field public go_table PlayerInfoRecordView._obj_forbiddenPlace_GoTable
local PlayerInfoRecordForbiddenPlacePanel = _G.BaseClass("PlayerInfoRecordForbiddenPlacePanel", base)

local GetAutoGoTable = _G.GetAutoGoTable
local GetLangPackValue = _G.GetLangPackValue
local handler = _G.handler
local ConfigManager = _G.ConfigManager

---类的构造函数
function PlayerInfoRecordForbiddenPlacePanel:__init(obj, uid, isBot)
    self.go_table = GetAutoGoTable(obj, handler(self, self.OnClickBtn))
    self.uid = uid
    self.isBot = isBot
end

---@private
function PlayerInfoRecordForbiddenPlacePanel:Show()
    if not self.msg then
        self.go_table.aortext_itemTitleWorldBoss.text = GetLangPackValue(90027300014)
        self.go_table.aortext_itemTitleHellGuard.text = GetLangPackValue(90027300015)
        self.go_table.aortext_itemTitleBlackSource.text = GetLangPackValue(90027300016)
        if self.isBot then
            self:InitView({})
        else
            local pbData = { role_uid = self.uid, page_id = {100401} }
            PlayerInfoNet:GetRoleFightRecord(pbData, handler(self, self.InitView))
        end
    end
end

---初始化雪王来袭，灵域守卫，黑暗本源
function PlayerInfoRecordForbiddenPlacePanel:InitView(msg)
    self.msg = msg
    ---@type role.i_world_boss
    self.msgWorldBoss = msg.world_boss_info or {}
    ---@type role.i_guard_info
    self.msgGuard = msg.guard_info or {}
    ---@type role.i_dark_info
    self.msgDark = msg.dark_info and msg.dark_info.dark_list or {}

    local default = GetLangPackValue(90027300017)

    local bossList = {143020000, 153100000, 153110000}
    ---@type PlayerInfoRecordBossAndCardsItemData
    local itemData
    local item, bossData
    for i = 1, 3 do
        bossData = self.msgWorldBoss[i] or {}
        itemData = {}
        itemData.title = nil
        -- itemData.name = GetLangPackValue(ConfigManager.card_cfg[bossList[i]].Name)
        itemData.des = bossData.dps and GetLangPackValue(90027300030, _G.GameUtil.NumberToUnitStr(bossData.dps)) or default
        itemData.bossId = bossList[i]
        itemData.cards = bossData.array or {}
        item = self:AddComponent(self.go_table["obj_cardsItem" .. i], PlayerInfoRecordBossAndCardsItem.New(self.go_table["obj_cardsItem" .. i]))
        item:Show(itemData)
    end

    itemData = {}
    itemData.title = nil
    itemData.name = self.msgGuard.sid and GetLangPackValue(90027300007, self.msgGuard.sid) or default
    itemData.des = self.msgGuard.kill_num and GetLangPackValue(90027300031, self.msgGuard.kill_num) or default
    itemData.bossId = self.msgGuard.sid and ConfigManager.monster_cfg[self:GetFirstMonster(ConfigManager.monster_group_cfg[ConfigManager.hell_guard_diff_cfg[self.msgGuard.sid].monster_group].DefaultDefenserSids[1])].CardID or nil
    itemData.cards = self.msgGuard.cards or {}
    item = self:AddComponent(self.go_table.obj_cardsItem4, PlayerInfoRecordBossAndCardsItem.New(self.go_table.obj_cardsItem4))
    item:Show(itemData)

