local PlayerInfoNet = require("PlayerInfoNet"):GetInstance()
local PlayerInfoRecordBossAndCardsItem = require("PlayerInfoRecordBossAndCardsItem")
local base = require "PlayerInfoRecordBasePanel"
---@class PlayerInfoRecordSystemMaterialPanel :PlayerInfoRecordBasePanel   中文描述
---@field public go_table PlayerInfoRecordView._obj_systemMaterial_GoTable
local PlayerInfoRecordSystemMaterialPanel = _G.BaseClass("PlayerInfoRecordSystemMaterialPanel",base)

local GetAutoGoTable = _G.GetAutoGoTable
local GetLangPackValue = _G.GetLangPackValue
local handler = _G.handler
local ConfigManager = _G.ConfigManager
local Mathf = _G.Mathf

---类的构造函数
function PlayerInfoRecordSystemMaterialPanel:__init(obj, uid, isBot)
    self.go_table = GetAutoGoTable(obj, handler(self, self.OnClickBtn))
    self.uid = uid
    self.isBot = isBot
end

---@private
function PlayerInfoRecordSystemMaterialPanel:Show()
    if not self.msg then
        self.go_table.aortext_itemTitleHJXX.text = GetLangPackValue(90027300010)
        self.go_table.aortext_itemTitleLJKC.text = GetLangPackValue(90027300011)
        self.go_table.aortext_itemTitleBBYW.text = GetLangPackValue(90027300012)
        self.go_table.aortext_itemTitleXHSL.text = GetLangPackValue(90027300013)
        if self.isBot then
            self:InitView({})
        else
            local pbData = {role_uid = self.uid, page_id = {100201}}
            PlayerInfoNet:GetRoleFightRecord(pbData, handler(self, self.InitView))
        end
    end
end

---初始化材料副本
function PlayerInfoRecordSystemMaterialPanel:InitView(msg)
    self.msg = msg
    ---@type role.i_instance
    self.msgIns = msg.instance_info or {}
    ---@type role.i_system_prof
    self.msgSys = msg.prof_info or {}

    local default = GetLangPackValue(90027300017)

    local indexList = {102, 101, 103}

    ---@type PlayerInfoRecordBossAndCardsItemData
    local itemData
    local item, ins
    local matCfg = ConfigManager.system_material_cfg
    for i = 1, 3 do
        ins = self.msgIns[self:FindInsDataIndex(indexList[i])] or {}
        itemData = {}
        itemData.title = nil
        itemData.name = ins.s_id and GetLangPackValue(90027300002, matCfg[ins.s_id].difficulty) or default
        itemData.des =
            ins.pass_time and GetLangPackValue(90027300003, Mathf.Max(Mathf.Floor(ins.pass_time / 1000), 1)) or default
        itemData.bossId =
            ins.s_id and
            ConfigManager.monster_cfg[
                self:GetFirstMonster(ConfigManager.monster_group_cfg[matCfg[ins.s_id].monster].DefaultDefenserSids[1])
            ].CardID or
            nil
        itemData.cards = ins.cards or {}
        item =
            self:AddComponent(
            self.go_table["obj_cardsItem" .. i],
            PlayerInfoRecordBossAndCardsItem.New(self.go_table["obj_cardsItem" .. i])
        )
        item:Show(itemData)
    end

    local profIndexList = {1, 2, 5, 3, 4} --坦 战 游 法 辅
    local profTitleList = {90027300025, 90027300026, 90027300027, 90027300028, 90027300029}
    local prof
    local profCfg = ConfigManager.system_prof_cfg
    for i = 1, 5 do
        prof = self.msgSys[self:FindProfDataIndex(profIndexList[i])] or {}
        itemData = {}
        itemData.title = GetLangPackValue(profTitleList[i])
        itemData.name = prof.s_id and GetLangPackValue(90027300002, profCfg[prof.s_id].difficulty) or default
        itemData.des =
            prof.pass_time and GetLangPackValue(90027300003, Mathf.Max(Mathf.Floor(prof.pass_time / 1000), 1)) or
            default
        itemData.bossId =
            prof.s_id and
            ConfigManager.monster_cfg[
                self:GetFirstMonster(ConfigManager.monster_group_cfg[profCfg[prof.s_id].monster].DefaultDefenserSids[1])
            ].CardID or
            nil
        itemData.cards = prof.cards or {}
        item =
            self:AddComponent(
            self.go_table["obj_cardsItem" .. i + 3],
            PlayerInfoRecordBossAndCardsItem.New(self.go_table["obj_cardsItem" .. i + 3])
        )
        item:Show(itemData)
    end
end

---@private
function PlayerInfoRecordSystemMaterialPanel:FindInsDataIndex(insId)
    for i = 1, #self.msgIns do
        if self.msgIns[i].f_id == insId then
            return i
        end
    end
    return 0
end

---@private
function PlayerInfoRecordSystemMaterialPanel:FindProfDataIndex(profId)
    local profCfg = ConfigManager.system_prof_cfg
    for i = 1, #self.msgSys do
        if profCfg[self.msgSys[i].s_id].professional == profId then
            return i
        end
    end
    return 0
end

---@private
function PlayerInfoRecordSystemMaterialPanel:GetFirstMonster(group)
    for i = 1, #group do
        if group[i] ~= 0 then
            return group[i]
        end
    end
    return 0
end

---@private
function PlayerInfoRecordSystemMaterialPanel:OnClickBtn(go, isOn)
end

---类的析构函数
function PlayerInfoRecordSystemMaterialPanel:Dispose()
end

return PlayerInfoRecordSystemMaterialPanel
