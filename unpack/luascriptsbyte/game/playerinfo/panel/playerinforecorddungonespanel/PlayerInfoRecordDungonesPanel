local PlayerInfoNet = require("PlayerInfoNet"):GetInstance()
local ItemCardBodyBaseView = require("ItemCardBodyBaseView")
local base = require "PlayerInfoRecordBasePanel"

---@class PlayerInfoRecordDungonesPanel :PlayerInfoRecordBasePanel
---@field public go_table PlayerInfoRecordView._obj_dungones_GoTable
local PlayerInfoRecordDungonesPanel = _G.BaseClass("PlayerInfoRecordDungonesPanel", base)

local CS = _G.CS
local typeof = _G.typeof
local GetAutoGoTable = _G.GetAutoGoTable
local GetLangPackValue = _G.GetLangPackValue
local handler = _G.handler
local CardData = _G.CardData

---类的构造函数
function PlayerInfoRecordDungonesPanel:__init(obj, uid, isBot)
    self.go_table = GetAutoGoTable(obj, handler(self, self.OnClickBtn))
    self.uid = uid
    self.isBot = isBot
end

---@private
function PlayerInfoRecordDungonesPanel:Show()
    if not self.msg then
        self.go_table.aortext_itemTitleMaxDmg.text = GetLangPackValue(90027300004, "")
        self.go_table.aortext_itemTitleCards.text = GetLangPackValue(90027300005)
        self.go_table.aortext_itemTitleRelic.text = GetLangPackValue(90027300006)
        if self.isBot then
            self:InitView({})
        else
            local pbData = {role_uid = self.uid, page_id = {100301}}
            PlayerInfoNet:GetRoleFightRecord(pbData, handler(self, self.InitView))
        end
    end
end

---@private
function PlayerInfoRecordDungonesPanel:InitView(msg)
    ---@type role.i_roguelike_info
    self.msg = msg.roguelike_info or {mementos = {}, cards = {}}
    self.relics = self.msg.mementos

    local default = GetLangPackValue(90027300017)

    local dmg = self.msg.dps and _G.GameUtil.NumberToUnitStr(self.msg.dps) or GetLangPackValue(90027300017)
    self.go_table.aortext_itemTitleMaxDmg.text = GetLangPackValue(90027300004, dmg)

    ---@type ItemCardBodyBaseView
    local bodyItem
    ---@type CardData
    local cardData
    ---@type role.card_info
    local cardInfo
    for i = 1, 5 do
        cardInfo = self.msg.cards[i]
        if cardInfo then
            self.go_table["obj_cardBody" .. i]:SetActiveE(1)
            self.go_table["obj_emptyItem" .. i]:SetActiveE(0)
            bodyItem = ItemCardBodyBaseView.New(self.go_table["obj_cardBody" .. i])
            cardData = CardData.New()
            cardData:Parse({awaken_lv=cardInfo.awaken_lv,sid = cardInfo.sid, lv = cardInfo.level, star = cardInfo.star, soul_state = cardInfo.soul_state, soul_chain_lv = cardInfo.soul_lv, open_inborn = cardInfo.born_skill_num})
            CardData.skinIs = false
            bodyItem:ShowCardData(cardData, nil, true)
        else
            self.go_table["obj_cardBody" .. i]:SetActiveE(0)
            self.go_table["obj_emptyItem" .. i]:SetActiveE(1)
        end
    end
    if #self.msg.cards == 0 then
        self.go_table.obj_cards:SetActiveE(0)
        self.go_table.aortext_noCards.text = default
        self.go_table.aortext_noCards:SetActiveE(1)
        self.go_table.aortext_noRelic.text = default
        self.go_table.aortext_noRelic:SetActiveE(1)
        for i = 1, 5 do
            self.go_table["obj_emptyItem" .. i]:SetActiveE(0)
        end
    end

    self.go_table.scrollloopvectical_relic:InitItemData(#self.relics, handler(self, self.RefreshItem))
end

---@private
function PlayerInfoRecordDungonesPanel:RefreshItem(index, obj)
    index = index + 1
    ---@type mementos_cfg
    local cfg = _G.ConfigManager.mementos_cfg[self.relics[index]]
    local tb = _G.GetAutoGoTable(obj)
    tb.aortext_name.text = _G.GetLangPackValue(cfg.name)
    tb.aortext_desc.text = _G.GetLangPackValue(cfg.desc)
    tb.aorrawimage_icon:LoadImage(cfg.icon)
end

---@private
function PlayerInfoRecordDungonesPanel:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_relic then
        if not _G.table.isEmptyOrNil(self.msg.mementos) then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DungonesRelicView.Name, self.msg.mementos)
        end
    end
end

---类的析构函数
function PlayerInfoRecordDungonesPanel:Dispose()
end

return PlayerInfoRecordDungonesPanel
