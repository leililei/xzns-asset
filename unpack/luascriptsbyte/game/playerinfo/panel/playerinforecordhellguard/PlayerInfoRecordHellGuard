local base = require "PlayerInfoRecordBasePanel"
---@class PlayerInfoRecordHellGuard : Component	中文描述
local PlayerInfoRecordHellGuard = _G.BaseClass("PlayerInfoRecordHellGuard", base)

---创建对象时,入口构造函数
function PlayerInfoRecordHellGuard:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    if not self.skillItems then
        self.skillItems = {
            _G.GetAutoGoTable(self.go_table.aorbtn_1),
            _G.GetAutoGoTable(self.go_table.aorbtn_2),
            _G.GetAutoGoTable(self.go_table.aorbtn_3)
        }
    end
end

function PlayerInfoRecordHellGuard:CheckShowScene()
    return true
end

function PlayerInfoRecordHellGuard:Show()
    if not self.embattleDatas then
        if self.isBot then
            self:InitView({})
        else
            local pbData = { role_uid = self.uid, page_id = { self.id } }
            require "PlayerInfoNet":GetInstance():GetRoleFightRecord(pbData, _G.handler(self, self.InitView))
        end
    end
end

function PlayerInfoRecordHellGuard:InitView(msg)
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.PlayerInfoRecordPanel, self.go_table)
    self.msg = msg.guard_info or {}
    self.embattleDatas = self.msg.array or {}
    self.embatteArray = self.embattleDatas.cards or {}
    self:ShowCombSkill()
    if _G.AppSetting.IsXzns then
        self.go_table.obj_combSkill:SetActiveE(0)
        self.go_table.obj_beast:SetActiveE(1)
        self:ShowBeastSkill()
    end
    self:UpdateCards()

    if self.msg.sid and self.msg.sid > 0 then
        self.go_table.aortext_lanuage.text = _G.GetLangPackValue(90027300007, self.msg.sid)
    else
        self.go_table.aortext_lanuage.text = ""
    end
end

function PlayerInfoRecordHellGuard:ShowCombSkill()
    local data = self.embattleDatas.pet or { 0, 0, 0 }
    local cfgs = _G.ConfigManager.pet_cfg
    for i = 1, #data do
        local tb = self.skillItems[i]
        if data[i] > 0 then
            tb.obj_combGO:SetActiveE(1)
            tb.aorrawimage_icon:LoadImage(
                cfgs[data[i]].Icon,
                function(rawimage)
                    if not self.go_table then 
                        return
                    end
                    rawimage:SetNativeSize()
                end
            )
        else
            tb.obj_combGO:SetActiveE(0)
        end
        tb.aortext_type.text = _G.LangUtil.GetLangPackValue(_G.ConfigManager.discrete_cfg[105003][1][i])
    end
end

function PlayerInfoRecordHellGuard:ShowBeastSkill()
    local go, data
    for i = 1, 3 do
        go = _G.GetAutoGoTable(self.go_table["obj_beast" .. i])
        if not _G.TableIsEmpty(self.embattleDatas) and self.embattleDatas.beast then
            data = self.embattleDatas.beast[i]
        else
            data = { sid = 0 }
        end
        if data.sid == 1 or data.sid == 0 then
            go.aorimage_ColorBG.SpriteName = "TY_Background_kuang_bai"
            go.obj_stars:SetActiveE(0)
        else
            go.aorimage_ColorBG.SpriteName = _G.PetItemIconName[_G.ConfigManager.pet_xzns_cfg[data.sid].order]
            go.aorrawimage_Icon:LoadImage(_G.ConfigManager.pet_xzns_cfg[data.sid].icon)
            go.obj_stars:SetActiveE(1)
            for i = 1, 5 do
                go["aorimage_star" .. i]:SetActiveE(data.star >= i and 1 or 0)
            end
        end
    end
end

---更新卡牌显示
function PlayerInfoRecordHellGuard:UpdateCards()
    if not self.cardItems then
        self.cardItems = {}
    end
    for i = 1, 5 do
        local data = self.embatteArray[i]
        if data and data.sid and data.sid > 0 then
            local cardSid = data.sid
            local cfg = _G.ConfigManager.skin_cfg[data.sid]
            if cfg then
                cardSid = cfg.card
            end
            local skin = data.sid or 0
            if not self.cardItems[i] then
                self.cardItems[i] = require "ItemCardBodyBaseView".New(self.go_table["obj_cardBody" .. i])
            end
            self.cardItems[i]:Show(
                {
                    sid = cardSid,
                    lv = data.level,
                    star = data.star,
                    skin = skin,
                    potential = data.awaken_lv,
                    showSoulTalent = true,
                    soulState = data.soul_state,
                    soulLink_lv = data.soul_lv,
                    talents = data.born_skill_num
                }
            )
            self.go_table["obj_cardBody" .. i]:SetActiveE(1)
            self.go_table["obj_emptyItem" .. i]:SetActiveE(0)
            local cfgs = _G.ConfigManager.card_cfg[cardSid]
            local path = cfgs.ModelPathHi
            local scale = cfgs.size2
            local pos = cfgs.pos_portrait
            if _G.UIUtils.IsUseBattleSpine(_G.UseBattleSpine.PlayerInfoRecordPanel) then
                path = _G.UIUtils.GetBattleSpine(cfgs)
                scale = cfgs.size4
                pos = { 0, 0, 0 }
            end
            _G.PoolsManager:GetInstance():Spawn(
                path,
                _G.ePoolType.UIItem,
                self.go_table["obj_spine" .. i],
                function(obj)
                    if not self.go_table then
                        _G.DestroyObject(obj)
                        return
                    end
                    obj:SetLocalScaleXYZ(scale)
                    obj:SetLocalPosition(_G.table.unpack(pos))
                end
            )
        else
            self.go_table["obj_cardBody" .. i]:SetActiveE(0)
            self.go_table["obj_emptyItem" .. i]:SetActiveE(1)
        end
    end
end

---销毁对象时,析构函数
function PlayerInfoRecordHellGuard:OnDestroy()
end

return PlayerInfoRecordHellGuard
