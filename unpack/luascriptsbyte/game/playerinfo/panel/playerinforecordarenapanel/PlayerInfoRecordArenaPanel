local PlayerInfoNet = require "PlayerInfoNet"
local base = require "PlayerInfoRecordBasePanel"
---@class PlayerInfoRecordArenaPanel : PlayerInfoRecordBasePanel	中文描述
local PlayerInfoRecordArenaPanel = _G.BaseClass("PlayerInfoRecordArenaPanel", base)
local GetLangPackValue = _G.GetLangPackValue
local type = {
    Arena = 1,
    SeniorArena = 2,
    ElementArena = 3
}
local nameId = {
    [type.Arena] = 33236010101,
    [type.SeniorArena] = 90013012501,
    [type.ElementArena] = 90013012601
}
function PlayerInfoRecordArenaPanel:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self.embattleIndex = 1
    self.maxPage = _G.AppSetting.IsOverseas and 3 or 1
    self.sys = type.Arena
end

function PlayerInfoRecordArenaPanel:Show()
    self.embattleIndex = 1
    self.sys = type.Arena
    if not self.msg then
        if self.isBot then
            self:InitView({})
        else
            local pbData = { role_uid = self.uid, page_id = { 100601 } }
            PlayerInfoNet:GetInstance():GetRoleFightRecord(pbData, _G.handler(self, self.InitView))
        end
    end
end

---更新界面显示
function PlayerInfoRecordArenaPanel:InitView(msg)
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.PlayerInfoRecordPanel, self.go_table)
    ---@type role.afk_info
    self.msg = msg.arena_info or {}

    if _G.AppSetting.IsXzns then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.PlayerInfoRecordView.Name)
        local canvas = view.gameObject:GetComponentE(_G.typeof(_G.Canvas))
        local layersorting = canvas.sortingOrder

        for i = 1, 5 do
            local spine = self.go_table["obj_spine" .. i]
            local canvasSpine = spine:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
            if _G.IsNil(canvasSpine) or _G.IsNil(canvasSpine.sortingOrder) then
                canvasSpine = spine:AddComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
            end
            canvasSpine.overrideSorting = true
            canvasSpine.sortingOrder = canvas.sortingOrder + 10
        end
    end

    self:InitData()
    self:InitGrounp()
    if _G.AppSetting.IsXzns then
        self.go_table.obj_combSkill:SetActiveE(0)
        self.go_table.obj_beast:SetActiveE(1)

        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.PlayerInfoRecordView.Name)
        local canvas = view.gameObject:GetComponentE(_G.typeof(_G.Canvas))
        local layersorting = canvas.sortingOrder

        for i = 1, 5 do
            local spine = self.go_table["obj_spine" .. i]
            local canvasSpine = spine:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
            if _G.IsNil(canvasSpine) or _G.IsNil(canvasSpine.sortingOrder) then
                canvasSpine = spine:AddComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
            end
            canvasSpine.overrideSorting = true
            canvasSpine.sortingOrder = canvas.sortingOrder + 10
        end

        self:UpdateBeast()
    else
        self:UpdateCombines()
    end
    self:UpdateCards()
    self.go_table.aorbtn_left:SetActiveE(self.sys == 1 and 0 or 1)
    self.go_table.aorbtn_right:SetActiveE(self.sys >= self.maxPage and 0 or 1)
    self.go_table.aortext_name.text = GetLangPackValue(nameId[self.sys])
    if not self.isInited then
        self.recordView:UpdateAllModel(self:GetAllEmbattleData())
    end
end

function PlayerInfoRecordArenaPanel:InitData()
    self.AllEmbattleDatas = {}
    self.AllEmbatteArray = {}
    if not _G.table.isEmptyOrNil(self.msg) then
        for _, v in pairs(self.msg) do
            self.AllEmbatteArray[v.sys] = {}
            self.AllEmbattleDatas[v.sys] = v
            if not _G.table.isEmptyOrNil(v.arrays) then
                for i = 1, #v.arrays do
                    self.AllEmbatteArray[v.sys][i] = v.arrays[i].cards or {}
                end
            end
        end
        if self.go_table.aortext_tips then
            self.go_table.aortext_tips:SetActiveE(0)
        end
    else
        if self.go_table.aortext_tips then
            self.go_table.aortext_tips:SetActiveE(1)
        end
    end
    self.embattleDatas = self.AllEmbattleDatas[self.sys] or {}
    self.embatteArray = self.AllEmbatteArray[self.sys] or {}
end

