    if not self.grounpGb then
        self.grounpGb = _G.GetAutoGoTable(self.go_table.obj_group, _G.handler(self, self.OnClickGrounp))
    end
    local count = #(self.embattleDatas.arrays or {})
    -- 暂时屏蔽多队
    -- if count <= 1 then
    --     self.go_table.obj_group:SetActiveE(0)
    -- else
