function PlayerInfoRecordArenaPanel:UpdateBeast()
    local go, data
    for i = 1, 3 do
        go = _G.GetAutoGoTable(self.go_table["obj_beast" .. i])
        if self.embattleDatas.arrays and not _G.TableIsEmpty(self.embattleDatas.arrays[1]) and self.embattleDatas.arrays[1].beast then
            data = self.embattleDatas.arrays[1].beast[i]
        else
            data = { sid = 0 }
        end
        if data.sid == 1 or data.sid == 0 then
            go.aorimage_ColorBG.SpriteName = "TY_Background_kuang_bai"
            go.obj_stars:SetActiveE(0)
        else
            go.aorimage_ColorBG.SpriteName = _G.PetItemIconName[_G.ConfigManager.pet_xzns_cfg[data.sid].order]
            go.aorrawimage_Icon:LoadImage(_G.ConfigManager.pet_xzns_cfg[data.sid].icon)
            go.obj_stars:SetActiveE(1)
            for i = 1, 5 do
                go["aorimage_star" .. i]:SetActiveE(data.star >= i and 1 or 0)
            end
        end
    end
end

function PlayerInfoRecordArenaPanel:ShowCombSkill()
    local cfg, lv, id
    local ConfigManager = _G.ConfigManager
    local data
    if self.embattleDatas.arrays and self.embattleDatas.arrays[self.embattleIndex] then
        data = self.embattleDatas.arrays[self.embattleIndex].pet or { 0, 0, 0 }
    else
        data = { 0, 0, 0 }
    end
    local cfgs = _G.ConfigManager.pet_cfg
    for i = 1, #data do
        self.skillItems[i].lock:SetActiveE(0)
        self.skillItems[i].typeObj:SetActiveE(1)
        if data[i] > 0 then
            -- local cskillID = cfgs[data[i]].skills[1]
            self.skillItems[i].go:SetActiveE(1)
            self.skillItems[i].icon:LoadImage(
                cfgs[data[i]].Icon,
                function(rawimage)
                    rawimage:SetNativeSize()
                end
            )
        else
            self.skillItems[i].go:SetActiveE(0)
        end
        self.skillItems[i].redpoint:SetActiveE(0)
        self.skillItems[i].typeText.text = _G.LangUtil.GetLangPackValue(_G.ConfigManager.discrete_cfg[105003][1][i])
    end
end

---更新卡牌显示
function PlayerInfoRecordArenaPanel:UpdateCards()
    local datas
    if self.embattleDatas and self.embattleDatas.arrays then
        datas = self.embattleDatas.arrays[self.embattleIndex].cards or {}
    else
        datas = {}
    end
    local cfg
    local cardSid
    local data
    local skin
    local skinCfgs = _G.ConfigManager.skin_cfg
    if not self.cardItems then
        self.cardItems = {}
    end
    for i = 1, 5 do
        if datas[i] and datas[i].sid and datas[i].sid > 0 then
            data = datas[i]
            cardSid = data.sid
            skin = 0
            if skinCfgs then
                cfg = skinCfgs[data.sid]
                if cfg then
                    cardSid = cfg.card
                end
                skin = data.sid
            end
            if not self.cardItems[i] then
                self.cardItems[i] = require "ItemCardBodyBaseView".New(self.go_table["obj_cardBody" .. i])
            end
            self.cardItems[i]:Show(
                {
                    sid = cardSid,
                    lv = data.level,
                    star = data.star,
                    skin = skin,
                    potential = data.awaken_lv,
                    showSoulTalent = true,
                    soulState = data.soul_state,
                    soulLink_lv = data.soul_lv,
                    talents = data.born_skill_num
                },
                _G.handlerbind(self, self.OnClickCard, data)
            )
            self.go_table["obj_cardBody" .. i]:SetActiveE(1)
            self.go_table["obj_emptyItem" .. i]:SetActiveE(0)
            local cfgs = _G.ConfigManager.card_cfg[cardSid]
            local path = cfgs.ModelPathHi
            local scale = cfgs.size2
            local pos = cfgs.pos_portrait
            if _G.UIUtils.IsUseBattleSpine(_G.UseBattleSpine.PlayerInfoRecordPanel) then
                path = _G.UIUtils.GetBattleSpine(cfgs)
                scale = cfgs.size4
                pos = { 0, 0, 0 }
            end
            _G.PoolsManager:GetInstance():Spawn(
                path,
                _G.ePoolType.UIItem,
                self.go_table["obj_spine" .. i],
                function(obj)
                    if not self.go_table then
                        _G.DestroyObject(obj)
                        return
                    end
                    obj:SetLocalPosition(_G.table.unpack(pos))
                    --- 只有星座女神有神环
                    if _G.AppSetting.IsXzns then
                        local godHaloID = _G.PlayerModel:GetInstance():IsCardWearGodHalo(cfgs.id)
                        if godHaloID ~= 0 then
                            local effCfg = _G.ConfigManager.god_halo_cfg[godHaloID].ui_effect_cfg
                            --- 神环路径，父级路径(加载角色的下面)
                            _G.UIUtils.LoadGodHalo(effCfg, obj, godHaloID)
                        end
                        _G.UIUtils.LoadArtifacteffect(obj,cfgs.id,nil,nil)
                    else
                        obj:SetLocalScaleXYZ(scale)
                    end
                end
            )
        else
            self.go_table["obj_cardBody" .. i]:SetActiveE(0)
            self.go_table["obj_emptyItem" .. i]:SetActiveE(1)
        end
    end
    if #datas == 0 then
        ---暂无阵容
        self.go_table.aortext_zanwuzhenrong:SetActiveE(1)
        for i = 1, 5 do
            self.go_table["obj_emptyItem" .. i]:SetActiveE(0)
        end
    else
        self.go_table.aortext_zanwuzhenrong:SetActiveE(0)
    end
end

function PlayerInfoRecordArenaPanel:CheckShowScene()
    return true
end

function PlayerInfoRecordArenaPanel:OnClickBtn(go)
    if go == self.go_table.aorbtn_left then
        self:ChangeArray(-1)
    elseif go == self.go_table.aorbtn_right then
        self:ChangeArray(1)
    end
end

---更改阵容
function PlayerInfoRecordArenaPanel:ChangeArray(num)
    self.sys = self.sys + num
    self.embattleDatas = self.AllEmbattleDatas[self.sys] or {}
    self.embatteArray = self.AllEmbatteArray[self.sys] or {}
    self.embattleIndex = 1
    self.recordView:UpdateAllModel(self:GetAllEmbattleData())
    self:UpdateCards()
    self:UpdateCombines()
    self:InitGrounp()
    self.go_table.aorbtn_left:SetActiveE(self.sys == 1 and 0 or 1)
    self.go_table.aorbtn_right:SetActiveE(self.sys >= self.maxPage and 0 or 1)
    self.go_table.aortext_name.text = GetLangPackValue(nameId[self.sys])
end

function PlayerInfoRecordArenaPanel:OnClickCard(go, data)
    self:ShowCardInfo(data)
end

return PlayerInfoRecordArenaPanel
