        self:ChangeEmbattle(1)
    elseif go == self.grounpGb.aorbtn_2 then
        self:ChangeEmbattle(2)
    elseif go == self.grounpGb.aorbtn_3 then
        self:ChangeEmbattle(3)
    elseif go == self.grounpGb.aorbtn_4 then
        self:ChangeEmbattle(4)
    elseif go == self.grounpGb.aorbtn_5 then
        self:ChangeEmbattle(5)
    elseif go == self.grounpGb.aorbtn_6 then
        self:ChangeEmbattle(6)
    elseif go == self.grounpGb.aorbtn_7 then
        self:ChangeEmbattle(7)
    elseif go == self.grounpGb.aorbtn_8 then
        self:ChangeEmbattle(8)
    elseif go == self.grounpGb.aorbtn_9 then
        self:ChangeEmbattle(9)
    elseif go == self.grounpGb.aorbtn_10 then
        self:ChangeEmbattle(10)
    end
end

function PlayerInfoRecordArenaPanel:ChangeEmbattle(index)
    self.embattleIndex = index
    self.recordView:UpdateAllModel(self:GetAllEmbattleData())
    self:UpdateCombines()
    self:UpdateCards()
    self.grounpGb.trans_choose:SetParentE(self.grounpGb["aorbtn_" .. index])
end

function PlayerInfoRecordArenaPanel:GetAllEmbattleData()
    if self.embatteArray and not self.isInited then
        self.isInited = true
    end
    return self.embatteArray and self.embatteArray[self.embattleIndex] or {}
end

