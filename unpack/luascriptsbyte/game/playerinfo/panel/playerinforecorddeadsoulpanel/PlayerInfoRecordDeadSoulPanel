local PlayerInfoNet = require("PlayerInfoNet"):GetInstance()
local PlayerInfoRecordBossAndCardsItem = require("PlayerInfoRecordBossAndCardsItem")
local base=require "PlayerInfoRecordBasePanel"

---@class PlayerInfoRecordDeadSoulPanel :PlayerInfoRecordBasePanel
---@field public go_table PlayerInfoRecordView._obj_deadSoulTower_GoTable
local PlayerInfoRecordDeadSoulPanel = _G.BaseClass("PlayerInfoRecordDeadSoulPanel",base)
_G.PlayerInfoRecordDeadSoulPanel = PlayerInfoRecordDeadSoulPanel

local CS = _G.CS
local typeof = _G.typeof
local GetAutoGoTable = _G.GetAutoGoTable
local GetLangPackValue = _G.GetLangPackValue
local handler = _G.handler
local ConfigManager = _G.ConfigManager
local Mathf = _G.Mathf

---类的构造函数
function PlayerInfoRecordDeadSoulPanel:__init(obj, uid, isBot)
    self.go_table = GetAutoGoTable(obj, handler(self, self.OnClickBtn))
    self.uid = uid
    self.isBot = isBot
end

---@private
function PlayerInfoRecordDeadSoulPanel:Show()
    if not self.msg then
        self.go_table.aortext_itemTitleMainTower.text = GetLangPackValue(90027300008)
        self.go_table.aortext_itemTitleElementTower.text = GetLangPackValue(90027300009)
        if self.isBot then
            self:InitView({})
        else
            local pbData = { role_uid = self.uid, page_id = {100101} }
            PlayerInfoNet:GetRoleFightRecord(pbData, handler(self, self.InitView))
        end
    end
end

---@private
function PlayerInfoRecordDeadSoulPanel:InitView(msg)
    ---@type role.i_tower_info
    self.msg = msg.tower_info or {}

    local default = GetLangPackValue(90027300017)
    self.go_table.aortext_eThunder.text = GetLangPackValue(90027300020)
    self.go_table.aortext_eThunderLayer.text = default
    self.go_table.aortext_eWind.text = GetLangPackValue(90027300021)
    self.go_table.aortext_eWindLayer.text = default
    self.go_table.aortext_eWater.text = GetLangPackValue(90027300022)
    self.go_table.aortext_eWaterLayer.text = default
    self.go_table.aortext_eFire.text = GetLangPackValue(90027300023)
    self.go_table.aortext_eFireLayer.text = default
    local mainLayer = default
    local bossId = nil
    if self.msg.towers then
        local tower_cfg = ConfigManager.tower_cfg
        for i = 1, #self.msg.towers do
            local tower = self.msg.towers[i]
            if tower.t_id == 1 then
                self.go_table.aortext_eThunderLayer.text = GetLangPackValue(90027300002, tower_cfg[tower.s_id].layer)
            elseif tower.t_id == 2 then
                self.go_table.aortext_eWindLayer.text = GetLangPackValue(90027300002, tower_cfg[tower.s_id].layer)
            elseif tower.t_id == 3 then
                self.go_table.aortext_eWaterLayer.text = GetLangPackValue(90027300002, tower_cfg[tower.s_id].layer)
            elseif tower.t_id == 4 then
                self.go_table.aortext_eFireLayer.text = GetLangPackValue(90027300002, tower_cfg[tower.s_id].layer)
            elseif tower.t_id == 9 then
                mainLayer = GetLangPackValue(90027300002, tower_cfg[tower.s_id].layer)
                bossId = ConfigManager.monster_cfg[ConfigManager.monster_group_cfg[ConfigManager.tower_cfg[tower.s_id].monster[1][1]].DefaultDefenserSids[1][1]].CardID
            end
        end
    end

    ---@type PlayerInfoRecordBossAndCardsItemData
    local itemData = {}
    itemData.title = nil
    itemData.name = mainLayer
    itemData.des = self.msg.pass_time and GetLangPackValue(90027300003, Mathf.Floor(self.msg.pass_time/1000)) or default
    itemData.bossId = bossId
    itemData.cards = self.msg.cards or {}
    local item = self:AddComponent(self.go_table.obj_cardsItem, PlayerInfoRecordBossAndCardsItem.New(self.go_table.obj_cardsItem))
    item:Show(itemData)
end

---@private
function PlayerInfoRecordDeadSoulPanel:OnClickBtn(go, isOn)

end

---类的析构函数
function PlayerInfoRecordDeadSoulPanel:Dispose()
end

return PlayerInfoRecordDeadSoulPanel