local base = require("BaseGameNet")

---@class PlayerInfoNet : BaseGameNet	通信协议
local PlayerInfoNet = _G.BaseClass("PlayerInfoNet", base)
---@return PlayerInfoNet PlayerInfoNet
function PlayerInfoNet:GetInstance()
    return  base.GetInstance(self)
end

---获取玩家记录
function PlayerInfoNet:GetRoleFightRecord(pbData, callback)
    local item = _G.ConfigManager.net_map.game_role_fight_record
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

function PlayerInfoNet:GetCardInfo(pbData, callback)
    local item = _G.ConfigManager.net_map.game_role_fight_record_card
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

function PlayerInfoNet:GetFuncPreview(pbData, callback)
    local item = _G.ConfigManager.net_map.game_role_function_preview_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

function PlayerInfoNet:GetLevelAward(callback)
    local item = _G.ConfigManager.net_map.game_role_get_up_level_award
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function PlayerInfoNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end


return PlayerInfoNet