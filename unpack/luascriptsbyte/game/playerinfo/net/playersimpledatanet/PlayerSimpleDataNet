local base = require("BaseGameNet")

---@class PlayerSimpleDataNet : BaseGameNet	通信协议
---@field GetInstance fun(self:PlayerSimpleDataNet):PlayerSimpleDataNet
local PlayerSimpleDataNet = _G.BaseClass("PlayerSimpleDataNet", base)

---拉取用户存储的数据
function PlayerSimpleDataNet:GetData(callback)
    local item = _G.ConfigManager.net_map.game_role_client_data_get
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---设置用户存储的数据
---@param pbData role.c2s_client_data_save 数据
function PlayerSimpleDataNet:SetData(pbData, callback)
    local item = _G.ConfigManager.net_map.game_role_client_data_save
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function PlayerSimpleDataNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return PlayerSimpleDataNet
