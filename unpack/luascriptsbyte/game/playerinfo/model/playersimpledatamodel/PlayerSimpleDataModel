local base = require "GameDataModelBase"
local PlayerSimpleDataNet = require("PlayerSimpleDataNet")

---@class PlayerSimpleDataModel : GameDataModelBase     --玩家数据存储
---@field GetInstance fun(self:PlayerSimpleDataModel):PlayerSimpleDataModel
---@field numberData table<number,number>         存储的数据(数值)
local PlayerSimpleDataModel = _G.BaseClass("PlayerSimpleDataModel", base)

---@private
function PlayerSimpleDataModel:GetDataFormServer()
    PlayerSimpleDataNet:GetInstance():GetData(_G.handler(self, self.ParseData))
end

---@private
---@param msg role.s2c_client_data_get
function PlayerSimpleDataModel:ParseData(msg)
    self.numberData = {}
    if msg and msg.ack == 1 and msg.data then
        for _, info in pairs(msg.data) do
            self.numberData[info.key] = info.value
        end
    end
    base.ParseData(self)
end

---更改存储的值(基于当前值的偏移值)
---@param key number
---@param offset number
function PlayerSimpleDataModel:ChangeValue(key, offset)
    self:SetValue(key, self:GetValue(key) + offset)
end

---设定存储的值
---@param key number
---@param value number
function PlayerSimpleDataModel:SetValue(key, value)
    if not self.numberData then
        self.numberData = {}
    end
    self.numberData[key] = value
    PlayerSimpleDataNet:GetInstance():SetData({
        save_data = {
            { key = key, value = value }
        }
    })
end

---获取存储的值
---@param key number
---@return number
function PlayerSimpleDataModel:GetValue(key)
    if not self.numberData then
        return 0
    end
    return self.numberData[key] or 0
end

---删除存储值
---@param keys number|number[]   允许传单数字/数字数组
function PlayerSimpleDataModel:Delete(keys)
    if type(keys) == "number" then
        keys = { keys }
    end
    if self.numberData then
        for _, k in ipairs(keys) do
            self.numberData[k] = nil
        end
    end
    PlayerSimpleDataNet:GetInstance():SetData({
        delete_key = keys
    })
end

--region =====================游戏行为存储==========================

---游戏行为数值处理
---@param action SDKDef.GameAction|string|number
function PlayerSimpleDataModel:GetGameAction(action)
    assert(type(action) == "number")
    return self:GetValue(action + 10000)
end

---游戏行为数值处理
---@param action SDKDef.GameAction|string|number
---@param value number
function PlayerSimpleDataModel:SetGameAction(action, value)
    assert(type(action) == "number")
    return self:SetValue(action + 10000, value)
end

--endregion

return PlayerSimpleDataModel
