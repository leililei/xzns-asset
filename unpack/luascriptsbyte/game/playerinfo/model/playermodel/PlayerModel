---初始化光环/称号角色绑定关系
function PlayerModel:InitEffectState(effectPut)
    effectPut = effectPut or {}
    self.titleUse = {}
    self.haloUse = {}
    self.roleEffect = {}
    for _, v in pairs(effectPut) do
        if v.title_sid and v.title_sid > 0 then
            self.titleUse[v.title_sid] = v.sid
        end
        if v.halo_sid and v.halo_sid > 0 then
            self.haloUse[v.halo_sid] = v.sid
        end
        self.roleEffect[v.sid] = v
    end
end

