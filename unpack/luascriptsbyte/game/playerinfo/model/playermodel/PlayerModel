function PlayerModel:UnLockSettingTheme(id)
    if not self.settingThemeList then
        self.settingThemeList = {}
    end
    if self.settingThemeList[id] then
        return
    end
    self.settingThemeList[id] = true
    if not _G.PlayerPrefsManager.HasKey("SettingTheme" .. id) then
        _G.PlayerPrefsManager.SetInt("SettingTheme" .. id, 1)
    end
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.PlaySence.id, id)
end

