function PlayerModel:GetGodHaloAttribute()
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local attribute = AttributeClassManager:GetAttribtueClass()

    local un_god_halo = self.un_god_halo
    for i = 1, #un_god_halo do
        local cfg = _G.ConfigManager.god_halo_cfg[un_god_halo[i].k]

        attribute = self:UpdateAttribute(AttributeClassManager, attribute, cfg.base_att)
    end

    local changeAttrTypes = AttributeClassManager:GetChangeAttrTypes(attribute)

    return attribute, changeAttrTypes
end

function PlayerModel:UpdateAttribute(attributeManager, attribute, attData)
    for _, v in pairs(attData) do
        local type = v[2] == "2" and _G.AttCountType.basePercent or _G.AttCountType.other
        attribute:AddValueByName(
            v[1],
            attributeManager:GetValueWithName(v[1], v[3], v[2]),
            false,
            type
        )
    end
    return attribute
end

---获取神环属性
---@return table 属性
function PlayerModel:GetGodHaloAttributeDict()
    local atk   = 0
    local bre   = 0
    local def   = 0
    local maxHp = 0
    for i = 1, #self.un_god_halo do
        local cfg = _G.ConfigManager.god_halo_cfg[self.un_god_halo[i].k]
        for key, value in pairs(cfg.base_att) do
            if value[1] == "atk" then
                atk = atk + value[3]
            elseif value[1] == "bre" then
                bre = bre + value[3]
            elseif value[1] == "def" then
                def = def + value[3]
            elseif value[1] == "max_hp" then
                maxHp = maxHp + value[3]
            end
        end
    end

    return { atk, maxHp, bre, def }
end

