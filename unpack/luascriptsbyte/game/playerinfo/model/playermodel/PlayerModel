            name = not unName and self:GetName() or nil,
            style = not unStyle and self:GetRoleStyle() or nil,
            level = not unLevel and self:GetLevel() or nil,
            power = not unPower and self:GetPower() or nil,
            frame = not unFrame and self:GetCurFrame() or nil,
            city_style_id = not unCityStyle and self:GetCurCitySid() or nil,
            title = not unTitle and
                {
                    sid = self.title.sid,
                    end_time = self.title.end_time,
                    type = 2
                } or
                nil,
            afk = not unAfk and require("AfkModel"):GetInstance():GetLastSection() or nil,
            hell_id = not unHell and require("HellRoadModel"):GetInstance():GetLastHell() or nil,
            guild_name = not unGuild and require("SociatyManager"):GetInstance():GetGuildName() or nil
        }
    else
        if not self.iRoleTable then
            self.iRoleTable = {
                uid = self:GetPlayerUid(),
                name = not unName and self:GetName() or nil,
                style = not unStyle and self:GetRoleStyle() or nil,
                level = not unLevel and self:GetLevel() or nil,
                power = not unPower and self:GetPower() or nil,
                frame = not unFrame and self:GetCurFrame() or nil,
                city_style_id = not unCityStyle and self:GetCurCitySid() or nil,
                title = not unTitle and
                    {
                        sid = self.title.sid,
                        end_time = self.title.end_time,
                        type = 2
                    } or
                    nil,
                afk = not unAfk and require("AfkModel"):GetInstance():GetLastSection() or nil,
                hell_id = not unHell and 1,
                guild_name = not unGuild and require("SociatyManager"):GetInstance():GetGuildName() or nil
            }
        else
            self.iRoleTable.name = not unName and self:GetName() or nil
            self.iRoleTable.style = not unStyle and self:GetRoleStyle() or nil
            self.iRoleTable.level = not unLevel and self:GetLevel() or nil
            self.iRoleTable.power = not unPower and self:GetPower() or nil
            self.iRoleTable.frame = not unFrame and self:GetCurFrame() or nil
            self.iRoleTable.city_style_id = not unCityStyle and self:GetCurCitySid() or nil
            self.iRoleTable.title = not unTitle and
                {
                    sid = self.title.sid,
                    end_time = self.title.end_time,
                    type = 2
                } or
                nil
            self.iRoleTable.afk = not unAfk and require("AfkModel"):GetInstance():GetLastSection() or nil
            self.iRoleTable.hell_id = not unHell and 1
            self.iRoleTable.guild_name = not unGuild and require("SociatyManager"):GetInstance():GetGuildName() or nil
        end
        return self.iRoleTable
    end
end

