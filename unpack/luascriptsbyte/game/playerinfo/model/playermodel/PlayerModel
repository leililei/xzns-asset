---更新角色累计登录天数
---
function PlayerModel:CumulativeLogin()
    if self.day_countTime == nil then
        self.day_countTime = _G.TimeUtil.GetServerUnixTime()
    else
        local day = _G.TimeUtil.GetIntervalDayBySix1(self.day_countTime, _G.TimeUtil.GetServerUnixTime())
        if day > 0 then
            self.day_countTime = _G.TimeUtil.GetServerUnixTime()
            self.day_count = self.day_count + day
            require "SDKDotManager":GetInstance():OnEvent(_G.SDKDotType.SDKDot_LoginSign, self.day_count)
        end
    end

    _G.Events:GetInstance():Broadcast(
        _G.ePlayAactionEvent.PlayAaction,
        { _G.ActiveTaskEnum.ConditionEnum.CumulativeLogin.day },
        self.day_count
    )
end

