--- 神环装备卡牌 替换卡牌
function PlayerModel:SetUnlockGodHalo(cardID, GodHaloID, SkillID)
    local isHave = false
    for i = 1, #self.card_god_halo do
        -- 传入的神环ID已经被装备了
        if self.card_god_halo[i].halo_id == GodHaloID then
            --- 替换为当前卡牌
            self.card_god_halo[i].card_sid = cardID
            self.card_god_halo[i].halo_id_skill = SkillID
            isHave = true
        end
    end

    local list = {}
    for i = 1, #self.card_god_halo do
        -- 传入的卡牌ID已经存在 但神环不等于传入ID 说明是被替换的
        if self.card_god_halo[i].card_sid == cardID and self.card_god_halo[i].halo_id ~= GodHaloID then

        else
            table.insert(list, self.card_god_halo[i])
        end
    end
    self.card_god_halo = list

    if not isHave then
        local args = { card_sid = cardID, halo_id = GodHaloID, halo_id_skill = SkillID }
        table.insert(self.card_god_halo, args)
    end
    _G.Events:GetInstance():Broadcast(_G.eGodHalo.GodHaloRefresh)
end

--- 神环装备技能
function PlayerModel:SetUnGodHaloList(GodHaloID, SkillID)
    --  把原神环取出
    local list = {}
    for i = 1, #self.un_god_halo do
        if self.un_god_halo[i].k == GodHaloID then
        elseif self.un_god_halo[i].v == SkillID then
            table.insert(list, { k = self.un_god_halo[i].k, v = 0 })
        else
            table.insert(list, self.un_god_halo[i])
        end
    end

    local godhalo = { k = GodHaloID, v = SkillID }
    table.insert(list, godhalo)

    self.un_god_halo = list
end

--- 初始化时候调用 把未装备卡牌的神环加入红点判断里（self.isNewGodHaloList）
function PlayerModel:SetRedPointGodHalo()
    local card_god_halo = self.card_god_halo
    local un_god_halo = self.un_god_halo

    --- 去循环判断每个神环 在不在卡牌神环里
    for i = 1, #un_god_halo do
        local isHaveCard = false
        for j = 1, #card_god_halo do
            if card_god_halo[j].halo_id == un_god_halo[i].k then
                isHaveCard = true
            end
        end

        if not isHaveCard then
            table.insert(self.isNewGodHaloList, un_god_halo[i].k)
        end
    end
end

--- 神环特权
function PlayerModel:SetGodHaloPrivilege()
    --- 清理全部神环特权
    for i = 1, #_G.ConfigManager.god_halo_cfg do
        local halo_effect = _G.ConfigManager.god_halo_cfg[i].halo_effect
        for j = 1, #halo_effect do
            local effectCfg = _G.ConfigManager.god_halo_effect_cfg[halo_effect[j]]
            if #effectCfg.privilege_id > 0 then
                for index = 1, #effectCfg.privilege_id do
                    require "PrivilegeManager":GetInstance():RemovePrivilege(effectCfg.privilege_id[index])
                end
            end
        end
    end

    local un_god_halo = self.un_god_halo

    for i = 1, #un_god_halo do
        local halo_effect = _G.ConfigManager.god_halo_cfg[un_god_halo[i].k].halo_effect
        for j = 1, #halo_effect do
            local effectCfg = _G.ConfigManager.god_halo_effect_cfg[halo_effect[j]]
            if #effectCfg.privilege_id > 0 then
                for index = 1, #effectCfg.privilege_id do
                    require "PrivilegeManager":GetInstance():AddPrivilege(effectCfg.privilege_id[index], false, true)
                end
            end
        end
    end
end

