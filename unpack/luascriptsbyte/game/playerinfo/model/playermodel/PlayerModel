---获取等级奖励成功回调
function PlayerModel:GetLevelAwardSuc(msg, mergeAward)
    if msg.ack == 1 and msg.award then
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)

        if not mergeAward then
            self.Show_awardData = msg
            ---@type  MainOpenViewFunItem
            local FunItem = {}
            FunItem.checkFun = function()
                return self.Show_OldLv ~= nil
            end
            FunItem.OpenViewFun = function(callback)
                ---@type  params_RoleLevelUpView
                local Roledata = {}
                Roledata.awardDic = self.Show_awardData.award
                Roledata.nowlv = self.Show_nowlv or self:GetLevel()
                Roledata.oldlv = self.Show_OldLv or self.last_up_award_lv
                self.Show_OldLv = nil
                self.last_up_award_lv = self:GetLevel()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RoleLevelUpView.Name, Roledata, callback)
            end
            _G.PopWindowManager:GetInstance():AddPopWindowQuene(FunItem, _G.PopViewShowOrder.PlayerLevelUp)
        else
            _G.table.insertto(self.Show_awardData.award.item, msg.award.item)
        end
    end
end

