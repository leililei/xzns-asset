function PlayerModel:GetUserInfoCall(message)
    --初始化服务器时区
    if message.utc_time then
        local serverTimeZone = tonumber(message.utc_time)
        _G.TimeUtil.InitTimeZone(serverTimeZone)
    end

    self:ResolvPlayerData(message)
    if self.getRoleInfoCallback then
        self.getRoleInfoCallback()
        self.getRoleInfoCallback = nil
    end
    if self.CreateAndGetCallBack then
        self.CreateAndGetCallBack()
        self.CreateAndGetCallBack = nil
    end
end

------解析服务器的玩家数据
---@param message role.s2c_get_user 数据table
function PlayerModel:ResolvPlayerData(message)
    if not self.isInit then
        self.isSetServerPos = true
    end
    if type(message) == "table" then
        for key, value in pairs(message) do
            ---断线重连服务器经验等级不在解析进玩家信息 前端计算
            if key == "exp" or key == "role_lv" then
                if not _G.LoginManager:GetInstance().isReLogin then
                    self[key] = value
                end
            else
                self[key] = value
            end
        end
    end

    local curEndTime = self.frame and self.frame[2] or 0
    self.frame = self.frame and self.frame[1] or DefaultFrameSid

    self.day_countTime = _G.TimeUtil.GetServerUnixTime()
    if _G.table.isEmptyOrNil(self.title) then
        self.title = { sid = 0, end_time = 0 }
    end
    if _G.table.isEmptyOrNil(self.halo) then
        self.halo = { sid = 0, end_time = 0 }
    end
    if _G.table.isEmptyOrNil(self.chat_frame) then
        self.chat_frame = { sid = 0, end_time = 0 }
    end
    if self.chat_frame.sid == 0 then
        self.chat_frame.sid = DefaultChatFrameSid
    end

    if _G.table.isEmptyOrNil(self.role_frame) then
        self.role_frame = { sid = 0, end_time = 0 }
    end
    if self.role_frame.sid == 0 then
        self.role_frame.sid = DefaultRoleFrameSid
    end

    if AppSetting.IsXzns then
        self.isNewGodHaloList = {}
        if _G.table.isEmptyOrNil(self.un_god_halo) then
            self.un_god_halo = {}
        end
        if _G.table.isEmptyOrNil(self.card_god_halo) then
            self.card_god_halo = {}
        end
        self:SetRedPointGodHalo()
        self:SetGodHaloPrivilege()
    end
    self:SetCurCitySid(message.scene_sid or 300)
    self.city_style = message.city_style or 114200000
    ---防止断线重连后战力变成0
    if not self.power then
        self.power = 0
    end
    self.corePower = message.core_power or 0
    _G.Events:GetInstance():Broadcast(_G.GlobalEvents.PlayerCorePowerSyn, self.corePower)
    if self.last_up_award_lv < self:GetLevel() then
        self:GetLevelAward()
    end

    self.vipLv = 0
    self:UpdateVipExp(self.vip_exp or 0)

    --region --------------------------------------解锁的--------
    ---光环/称号穿戴角色
    self:InitEffectState()

    if self.frame_db == nil or not _G.table.ContainsValue(self.frame_db, self.frame) then
        self:SetUnlockFrame({ sid = self.frame, end_time = curEndTime })
    end
    if self.frame_db then
        --永久头像框
        for i = 1, #self.frame_db do
            self:SetUnlockFrame({ sid = self.frame_db[i], end_time = 0 })
        end
        self.frame_db = nil
    end
    if self.frame_time then
        --限时头像框
        for k, v in pairs(self.frame_time) do
            self:SetUnlockFrame({ sid = v.key, end_time = v.value })
        end
        self.frame_time = nil
    end
    if self.title_db then
        for i = 1, #self.title_db do
            self:SetUnlockTitle(self.title_db[i])
        end
        self.title_db = nil
    end
    if self.halo_db then
        for i = 1, #self.halo_db do
            self:SetUnlockHalo(self.halo_db[i])
        end
        self.halo_db = nil
    end
    ---主题背景
    if self.backgrounds then
        for i = 1, #self.backgrounds do
            self:UnLockSettingTheme(self.backgrounds[i])
        end
        self.backgrounds = nil
    end
    if self.chat_frame_db then
        for i = 1, #self.chat_frame_db do
            self:SetUnlockChatFrame(self.chat_frame_db[i])
        end
        self.chat_frame_db = nil
    end

    if self.role_frame_db then
        for i = 1, #self.role_frame_db do
            self:SetUnlockRoleFrame(self.role_frame_db[i])
        end
        self.role_frame_db = nil
    end
    --endregion------------------------------------解锁的--------

    --- {皮肤id=true}  拥有的皮肤
    self.skin = {}
    if message.skin ~= nil then
        for _, skinId in pairs(message.skin) do
            self.skin[skinId] = true
        end
    end

    if self.is_first_login then
        require "SDKDotManager":GetInstance():OnEvent(_G.SDKDotType.SDKDot_LoginSign, message.day_count)
        self.is_first_login = false
    end
    self.isInit = true
    if _G.AppSetting.IS_EDITOR then
        --region --------------------------------------若服务器 清档 清除账号缓存--------
        self.PrefsKeyDic = self:GetPrefsTable()
        local uid = message.role_uid
        local createTime = message.create_time
        local saveTime = _G.PlayerPrefsManager.GetInt("create_time", 999)
        ---如果上次该角色创建时间 与本次登录不同
        if saveTime ~= 999 and saveTime ~= message.create_time then
            for key, value in pairs(self.PrefsKeyDic) do
                _G.PlayerPrefsManager.DeleteKey(key, true)
            end
            _G.PlayerPrefsManager.SetInt("create_time", message.create_time)
        elseif saveTime == 999 then
            ---如果该账号没记录创建时间
            _G.PlayerPrefsManager.SetInt("create_time", message.create_time)
        end

        --endregion------------------------------------若服务器 清档 清除账号缓存--------
    end
    -- self:CheckGongDan()
    --region --------------------------------------镇魂街ZHJ-9972--------
    if _G.PlayerPrefsManager.GetInt("IsAutoBattle", 999) == 999 then
        _G.PlayerPrefsManager.SetInt("IsAutoBattle", 1)
    end
    --endregion------------------------------------【客户端】自动战斗开启后默认勾选为自动--------

    ---  头像 ---
    self.un_style = {}
    if AppSetting.IsXzns then
        if message.un_style then
            local count = #message.un_style
            self.un_style = {}
            for i = 1, count do
                self.un_style[message.un_style[i]] = true
            end
        end
    end

    ---绑定奖励
    require("BindAccountModel"):GetInstance():GetAwardInLogin()

    if _G.AppSetting.DEBUG then
        if self.main_open_time == 0 then
            _G.LogError("当前服务器还未分配赛区(本条日志为打印)")
        end
    end
end

