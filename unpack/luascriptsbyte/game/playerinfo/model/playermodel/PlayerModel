--通过当前经验得到当前等级
local ChangeLvByExp = function(self, exp, call)
    if not IsNumber(exp) then
        return
    end
    local nowLv = self.role_lv
    local nowExp = self.exp
    local sumExp = nowExp + exp
    local isUp = false
    local upLv = nowLv
    local expList = _G.ConfigManager.player_level_cfg
    for i = nowLv, #expList do
        local lvCfg = expList[i]
        if _G.IsNil(lvCfg) then
            break
        end
        if sumExp < lvCfg.exp or lvCfg.exp == 0 then
            break
        end
        if sumExp >= lvCfg.exp then
            isUp = true
        end
        sumExp = sumExp - lvCfg.exp
        upLv = i + 1
    end
    self.role_lv = upLv
    self:RuTrackEvent(nowLv, upLv)
    self.exp = sumExp
    if isUp then
        _G.Events:GetInstance():Broadcast(_G.ePlayerStatus.PlayerUpLevel, nowLv, upLv)
        _G.Events:GetInstance():Broadcast(
            _G.ePlayAactionEvent.PlayAaction,
            { _G.ActiveTaskEnum.ConditionEnum.CharacterLevel.Level },
            self.role_lv
        )
        if _G.CS.Launcher.Inst.IsSDK then
            _G.SDKManager:GetInstance():SendLevelUp(tostring(self.role_lv))
            require "SDKDotManager":GetInstance():OnEvent(_G.SDKDotType.SDKDot_Level, self.role_lv)
        end
        --营地检测
        require("CampsiteModel"):GetInstance():UnLockCaowei(self.role_lv)
        --红点 等级礼包
        require "LevelActivityModel":GetInstance():RefreshRedPoint()
        --require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.LevelActivity.id)

        require "PopUpGiftBagModel":GetInstance():IsPlayerLevel(nowLv, upLv)

        _G.SDKManager:GetInstance():GameAction(SDKDef.GameAction.EveryLevelUp, upLv)
    else
        _G.Events:GetInstance():Broadcast(_G.ePlayerStatus.PlayerChangeExp, sumExp)
        if call ~= nil then
            call()
        end
    end
end
--通过当前经验得到当前VIP等级
local ChangeVipLvByExp = function(self)
    local lv = 0
    local expList = _G.ConfigManager.player_vip_cfg
    for l = 1, #expList do
        if self.vip_exp >= expList[l].exp then
            lv = l
        end
    end
    local isUp = false
    if self.isInit then
        if self.vipLv < lv then
            if _G.AppSetting.DEBUG then
                _G.Log("玩家VIP等级提升了")
            end
            isUp = true
        end
    end
    self.vipLv = lv
    -- if isUp then
