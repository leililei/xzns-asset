    -- else
    --     _G.Events:GetInstance():Broadcast(_G.ePlayerStatus.PlayerChangeVipExp)
    -- end
end

---下一级还差的经验
function PlayerModel:GetNextLevelNeedExp(level)
    if level and self.role_lv >= level then
        return 0
    end

    local expList = _G.ConfigManager.player_level_cfg
    local curLevelExp = expList[self.role_lv] and expList[self.role_lv].exp or 0
    if curLevelExp == 0 then
        ---已达到最大等级
        return 0
    end

    if not level then
        return expList[self.role_lv].exp - (self.exp or 0)
    end

    local totalExp = 0
    for i = self.role_lv, level - 1 do
        totalExp = totalExp + (expList[i].exp or 0)
    end
    return totalExp - (self.exp or 0)
end

