    end
    for _, v in pairs(msg.effect_list) do
        if v.type == 13 then
            self:SetUnlockTitle({ sid = v.sid, end_time = v.end_time })
        elseif v.type == 14 then
            self:SetUnlockHalo({ sid = v.sid, end_time = v.end_time })
        end
    end
    _G.SystemSettingManager:GetInstance():RefreshTitleAndHaloAttribute()
    _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.TitleAndHalo)
end

