---初始化光环倒计时
function PlayerModel:InitTitleAndHaloTimer()
    local endTime = -1
    local time = _G.TimeUtil.GetServerUnixTime()
    ---@type player_frame_cfg|player_halo_effect_cfg|player_title_effect_cfg
    local cfg
    for _, v in pairs(self.frameDic) do
        cfg = _G.ConfigManager.player_frame_cfg[v.sid]
        if cfg and cfg.time_duration > 0 then
            if v.end_time > time then
                if endTime > 0 then
                    if endTime > v.end_time - time then
                        endTime = v.end_time - time
                    end
                else
                    endTime = v.end_time - time
                end
            end
        end
    end
    for _, v in pairs(self.haloDic) do
        cfg = _G.ConfigManager.player_halo_effect_cfg[v.sid]
        if cfg and cfg.time_duration > 0 then
            if v.end_time > time then
                if endTime > 0 then
                    if endTime > v.end_time - time then
                        endTime = v.end_time - time
                    end
                else
                    endTime = v.end_time - time
                end
            end
        end
    end
    for _, v in pairs(self.titleDic) do
        cfg = _G.ConfigManager.player_title_effect_cfg[v.sid]
        if cfg and cfg.time_duration > 0 then
            if v.end_time > time then
                if endTime > 0 then
                    if endTime > v.end_time - time then
                        endTime = v.end_time - time
                    end
                else
                    endTime = v.end_time - time
                end
            end
        end
    end
    for _, v in pairs(self.chatFrameDic) do
        cfg = _G.ConfigManager.player_bubble_cfg[v.sid]
        if cfg and cfg.time_duration > 0 then
            if v.end_time > time then
                if endTime > 0 then
                    if endTime > v.end_time - time then
                        endTime = v.end_time - time
                    end
                else
                    endTime = v.end_time - time
                end
            end
        end
    end
    if self.titleAndHaloTimer then
        self.titleAndHaloTimer:Stop()
        self.titleAndHaloTimer = nil
    end
    if endTime > 0 then
        self.titleAndHaloTimer = _G.TimerManager:GetInstance():GetTimer(endTime, self.TitleAndHaloTimerOver, self, true,
            false, true)
        self.titleAndHaloTimer:Start()
    end
end

function PlayerModel:TitleAndHaloTimerOver()
    self.titleAndHaloTimer = nil
    local time = _G.TimeUtil.GetServerUnixTime()
    local changeTitle = false
    local changeHalo = false
    ---@type player_frame_cfg|player_halo_effect_cfg|player_title_effect_cfg
    local cfg
    local cardSid
    for k, v in pairs(self.frameDic) do
        cfg = _G.ConfigManager.player_frame_cfg[v.sid]
        if cfg and cfg.time_duration > 0 then
            if v.end_time <= time then
                self.frameDic[k] = nil
                if v.sid == self.frame then
                    _G.SystemSettingManager:GetInstance():UpdateFrame(
                        DefaultFrameSid,
                        function(msg)
                            self:UpdateCurFrame(DefaultFrameSid)
                        end
                    )
                end
            end
        end
    end
    for k, v in pairs(self.haloDic) do
        cfg = _G.ConfigManager.player_halo_effect_cfg[v.sid]
        if cfg and cfg.time_duration > 0 then
            if v.end_time <= time then
                self.haloDic[k] = nil
                if v.sid == self.halo.sid then
                    changeHalo = true
                    cardSid = self:GetEffectUser(1, v.sid)
                    _G.SystemSettingManager:GetInstance():UpdateHaloAndTitle(
                        0,
                        1,
                        function()
                            self:UpdateHalo({ sid = 0, end_time = 0 }, cardSid)
                        end,
                        cardSid
                    )
                end
            end
        end
    end

    for k, v in pairs(self.titleDic) do
        cfg = _G.ConfigManager.player_title_effect_cfg[v.sid]
        if cfg and cfg.time_duration > 0 then
            if v.end_time <= time then
                self.titleDic[k] = nil
                -- if v.sid == self.title.sid then
                changeTitle = true
                --cardSid = self:GetEffectUser(2, v.sid)
                _G.SystemSettingManager:GetInstance():UpdateHaloAndTitle(
                    0,
                    2,
                    function()
                        self:UpdateTitle({ sid = 0, end_time = 0 })
                    end
                )
                -- end
            end
        end
    end
    for k, v in pairs(self.chatFrameDic) do
        cfg = _G.ConfigManager.player_bubble_cfg[v.sid]
        if cfg and cfg.time_duration > 0 then
            if v.end_time <= time then
                self.chatFrameDic[k] = nil
                _G.SystemSettingManager:GetInstance():UpdateHaloAndTitle(
                    DefaultChatFrameSid,
                    3,
                    function()
                        self:UpdateChatFrame({ sid = DefaultChatFrameSid, end_time = 0 })
                    end
                )
            end
        end
    end
    if changeHalo then
        _G.Events:GetInstance():Broadcast(_G.ePlayerStatus.PlayerChangeHalo, self.halo)
    end
    if changeTitle then
        _G.Events:GetInstance():Broadcast(_G.ePlayerStatus.PlayerChangeTitle, self.title)
    end
    _G.SystemSettingManager:GetInstance().Attribute = nil
    _G.SystemSettingManager:GetInstance():GetTitleAndHaloAttribute()
    _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.TitleAndHalo)
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.Frame.id)
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.PlayerTitle.id)
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.PlayerHalo.id)
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.PlayerChatFrame.id)
    self:InitTitleAndHaloTimer()
end

