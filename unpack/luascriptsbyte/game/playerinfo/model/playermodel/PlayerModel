---更新角色光环
---@param data role.i_effect
function PlayerModel:UpdateHalo(data, sid)
    if self.roleEffect[sid] == nil then
        self.roleEffect[sid] = { sid = sid, title_sid = 0, halo_sid = 0 }
    end
    if data then
        local preHalo = self.roleEffect[sid].halo_sid
        if self.haloUse[data.sid] then
            self.roleEffect[self.haloUse[data.sid]].halo_sid = 0
        end
        if data.sid == 0 or preHalo ~= 0 then
            --卸下/替换
            self.haloUse[preHalo] = nil
        end
        if data.sid > 0 then
            --穿上
            self.haloUse[data.sid] = sid
        end
        self.roleEffect[sid].halo_sid = data.sid
    end
    local player = _G.WorldManager:GetInstance():GetCurWorldPlayer()
