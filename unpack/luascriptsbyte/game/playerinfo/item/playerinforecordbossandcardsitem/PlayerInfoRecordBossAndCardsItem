local ItemCardAllView = require("ItemCardAllView")

---@class PlayerInfoRecordBossAndCardsItem    中文描述
---@field public go_table _obj_systemMaterial._obj_cardsItem4_GoTable
local PlayerInfoRecordBossAndCardsItem = _G.BaseClass("PlayerInfoRecordBossAndCardsItem", _G.Component)

local GetAutoGoTable = _G.GetAutoGoTable
local handler = _G.handler

---@class PlayerInfoRecordBossAndCardsItemData
---@field title string
---@field name string
---@field des string
---@field bossId number
---@field cards table<number, role.card_info>

---类的构造函数
function PlayerInfoRecordBossAndCardsItem:__init(obj)
    self.go_table = GetAutoGoTable(obj, handler(self, self.OnClickBtn))
end

---@param itemData PlayerInfoRecordBossAndCardsItemData
function PlayerInfoRecordBossAndCardsItem:Show(itemData)
    if itemData.title and self.go_table.aortext_minTitle then
        self.go_table.aortext_minTitle.text = itemData.title
    end
    self.go_table.aortext_name.text = itemData.name
    self.go_table.aortext_time.text = itemData.des

    if itemData.name == GetLangPackValue(90027300017) then
        self.go_table.aortext_name:SetActiveE(0)
        self.go_table.aortext_time:SetActiveE(0)
        if self.go_table.aortext_tips then
            self.go_table.aortext_tips:SetActiveE(1)
        end
    else
        self.go_table.aortext_name:SetActiveE(1)
        self.go_table.aortext_time:SetActiveE(1)
        if self.go_table.aortext_tips then
            self.go_table.aortext_tips:SetActiveE(0)
        end
    end

    ---@type ItemCardAllView
    local card
    ---@type role.card_info
    local cardInfo
    ---@type _obj_cardsItem._obj_card1_GoTable
    local tb
    -- tb = GetAutoGoTable(self.go_table.obj_cardBoss)
    -- if itemData.bossId then
    --     card = ItemCardAllView.New(self.go_table.obj_cardBoss)
    --     card:Show(itemData.bossId)
    --     card.go_table.obj_lvNode:SetActiveE(0)
    --     card.go_table.aorimage_ColorBg.SpriteName = "ui_ty_txdjkuangzi"
    --     card.go_table.obj_starParent:SetActiveE(0)
    --     card.go_table.aorimage_Elements:SetActiveE(0)
    -- else
    --     self:SetDefaultCard(tb)
    -- end

    for i = 1, 5 do
        cardInfo = itemData.cards[i]
        if cardInfo then
            card = ItemCardAllView.New(self.go_table["obj_card" .. i])
            card:Show(cardInfo.sid, nil, cardInfo.star, cardInfo.soul_lv, cardInfo.level, nil, nil, cardInfo.soul_state,
                cardInfo.born_skill_num)
            card.gameObject:SetActiveE(1)
        else
            tb = GetAutoGoTable(self.go_table["obj_card" .. i])
            tb.gameObject:SetActiveE(0)
            -- self:SetDefaultCard(tb)
        end
    end
end

---@private
function PlayerInfoRecordBossAndCardsItem:SetDefaultCard(tb)
    tb.obj_lvNode:SetActiveE(0)
    ---@type _obj_cardBoss._trans_Root_GoTable
    local tbTrans = GetAutoGoTable(tb.trans_Root)
    tbTrans.aorimage_ColorBg.SpriteName = "ui_ty_zbdjkuangmoren"
    tbTrans.aorimage_Icon:SetActiveE(0)
    tbTrans.obj_starParent:SetActiveE(0)
    tbTrans.aorimage_Elements:SetActiveE(0)
    tbTrans.obj_logo:SetActiveE(0)
end

---@private
function PlayerInfoRecordBossAndCardsItem:OnClickBtn(go, isOn)

end

---类的析构函数
function PlayerInfoRecordBossAndCardsItem:Dispose()
end

return PlayerInfoRecordBossAndCardsItem
