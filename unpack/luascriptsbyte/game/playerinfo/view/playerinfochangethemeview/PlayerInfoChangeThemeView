---@class PlayerInfoChangeThemeView : UIBaseView	中文描述
---@field public go_table PlayerInfoChangeThemeView_GoTable GoTable
---@field roleData role.i_role_info
local PlayerInfoChangeThemeView = _G.BaseClass("PlayerInfoChangeThemeView", _G.UIBaseView)
--_G.PlayerInfoChangeThemeView = PlayerInfoChangeThemeView

local CS = _G.CS
local typeof = _G.typeof

function PlayerInfoChangeThemeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param data role.i_role_info
function PlayerInfoChangeThemeView:OnCreate(data, chooseCall)
    self.roleData = data
    self.chooseCall = chooseCall
    self.go_table.scrollloopvectical_List:InitItemData(0, _G.handler(self, self.RefreshTheme))
    self:InitData()
    self:UpdateView()
end

function PlayerInfoChangeThemeView:InitData()
    self.datas = {}
    for _, v in pairs(_G.ConfigManager.player_scene_cfg) do
        if not v.reveal then
            _G.table.insert(
                self.datas,
                {
                    sid = v.ID,
                    cfg = v,
                    isUnLock = v.ID == 0 and true or _G.PlayerModel:GetInstance():CheckSettingThemeIsUnLock(v.ID)
                }
            )
        end
    end
    _G.SortList(
        self.datas,
        function(data)
            local order = 1
            if data.isUnLock then
                order = 99
                if self.roleData.background_id == data.sid then
                    order = 999
                end
            end
            return order, data.display_priority, -data.sid
        end
    )
    self.chooseIndex = 1
end
---更新界面
function PlayerInfoChangeThemeView:UpdateView()
    self:OnClickTheme(nil, nil, 1, true)
    self.go_table.scrollloopvectical_List:UpdateCount(#self.datas)
    self:UpdateBtns()
end

function PlayerInfoChangeThemeView:RefreshTheme(index, obj)
    ---@type PlayerInfoChangeThemeView._obj_item_GoTable
    local go_table = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickTheme, index + 1))
    local data = self.datas[index + 1]
    go_table.obj_choose:SetActiveE(self.chooseIndex == index + 1 and 1 or 0)
    go_table.obj_mask:SetActiveE(data.isUnLock and 0 or 1)
    go_table.obj_use:SetActiveE(data.sid == self.roleData.background_id and 1 or 0)
    go_table.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.PlaySence.id, data.sid)
    go_table.aortext_name.text = _G.GetLangPackValue(data.cfg.name)
    go_table.aorrawimage_icon:LoadImage(data.cfg.image)
end

function PlayerInfoChangeThemeView:OnClickTheme(_, _, index, isShow)
    local data = self.datas[index]
    self.curData = data
    self.chooseIndex = index
    if not isShow then
        self.go_table.scrollloopvectical_List:UpdateAllItem()
    end
    self:UpdateBtns()
    self:UpdateDesc()
    _G.PlayerPrefsManager.SetInt("SettingTheme" .. self.curData.sid, 0)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.PlaySence.id, self.curData.sid)
end

function PlayerInfoChangeThemeView:UpdateDesc()
    self.go_table.aortext_name.text = _G.GetLangPackValue(self.curData.cfg.name)
    self.go_table.aortext_content.text = _G.GetLangPackValue(self.curData.cfg.desc)
    if self.curData.cfg.unlock_prompt > 0 then
        self.go_table.aortext_lock.text = _G.GetLangPackValue(self.curData.cfg.unlock_prompt)
    else
        self.go_table.aortext_lock.text = ""
    end
end

function PlayerInfoChangeThemeView:UpdateBtns()
    if not self.curData then
        self.go_table.aorbtn_change:SetActiveE(0)
        return
    end
    self.go_table.aorbtn_change:SetActiveE(1)
    if self.curData.isUnLock then
        if self.curData.sid == self.roleData.background_id then
            self.go_table.aorbtn_change:SetGray(true)
            self.go_table.aortext_changeLabel.text = _G.GetLangPackValue(90021300066)
        else
            self.go_table.aorbtn_change:SetGray(false)
            self.go_table.aortext_changeLabel.text = _G.GetLangPackValue(90021300084)
        end
    else
        self.go_table.aorbtn_change:SetGray(true)
        self.go_table.aortext_changeLabel.text =_G.string.AddColor( _G.GetLangPackValue(90021300084),"414141")
    end
end
---更换主题
function PlayerInfoChangeThemeView:OnChange()
    if self.curData.sid == self.roleData.background_id or not self.curData.isUnLock then
        return
    end
    require "SystemSettingNet":GetInstance():ChangeSettingTheme(
        {b_id = self.curData.sid},
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self.roleData.background_id = self.curData.sid
            self.go_table.scrollloopvectical_List:UpdateAllItem()
            self:UpdateBtns()
            if self.chooseCall then
                self.chooseCall(self.curData.sid, true)
            end
        end
    )
end

---按钮点击事件在这里派发
function PlayerInfoChangeThemeView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif self.go_table.aorbtn_change then
        self:OnChange()
    end
end

return PlayerInfoChangeThemeView
