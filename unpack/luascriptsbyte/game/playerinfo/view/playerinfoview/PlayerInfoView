---更新卡牌显示
function PlayerInfoView:UpdateCards()
    local datas = {}
    if self.data.arrays and self.data.arrays[1] then
        datas = self.data.arrays[1].cards or {}
    end
    local cfg
    local skinCfgs = _G.ConfigManager.skin_cfg
    local cardCfgs = _G.ConfigManager.card_cfg
    local skin
    local cardSid
    local data
    local soulLinkLv
    if not self.cardItems then
        self.cardItems = {}
    end
    for i = 1, 5 do
        if not self.cardItems[i] then
            local go_table = _G.GetAutoGoTable(self.go_table["obj_cardItem" .. i])
            self.cardItems[i] = require "ItemCardBodyBaseView".New(go_table.obj_node)
            if _G.AppSetting.IsXzns then
                GameUtil.SetUiHeXieMask(go_table)
            end
        end
        if datas[i] and datas[i].sid and datas[i].sid > 0 then
            data = datas[i]
            cardSid = data.sid
            skin = 0
            if skinCfgs then
                cfg = skinCfgs[data.sid]
                if cfg then
                    cardSid = cfg.card
                end
                skin = data.sid
            end
            self.cardItems[i]:Show(
                {
                    sid = cardSid,
                    lv = data.level,
                    star = data.star,
                    skin = skin,
                    potential = data.awaken_lv,
                    showSoulTalent = true,
                    soulState = data.soul_state,
                    soulLink_lv = data.soul_lv,
                    talents = data.born_skill_num,
                    type = data.c_type == 5 and _G.CardType.Timer or _G.CardType.Normal
                },
                _G.handlerbind(self, self.ShowCardInfo, data)
            )
            self.go_table["obj_cardItem" .. i]:SetActiveE(1)
            self.go_table["obj_emptyItem" .. i]:SetActiveE(0)
        else
            self.go_table["obj_cardItem" .. i]:SetActiveE(0)
            self.go_table["obj_emptyItem" .. i]:SetActiveE(1)
        end
    end
end

function PlayerInfoView:ShowCardInfo(go, data)
    if data.c_type == 5 then
        _G.PopWindowManager:GetInstance():ShowAllTips(602, _G.GetLangPackValue(90100000206))
        return
    end
    local pbData = { role_uid = self.uid, card_uid = data.uid }
    require("PlayerInfoNet"):GetInstance():GetCardInfo(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                if _G.AppSetting.Debug then
                    _G.LogError("获取卡牌信息异常")
                end
                return
            end
            if self.alreadyTip == nil then
                self.alreadyTip = {}
            end
            if not self.alreadyTip[data.uid] then
                if msg.card.star ~= data.star or msg.card.lv ~= data.level then
                    self.alreadyTip[data.uid] = true
                    _G.PopWindowManager:GetInstance():ShowAllTips(915101)
                end
            end
            ---@type CardData
            local cardData = require("CardData").New()
            local card = msg.card
            cardData:Parse(card)
            cardData:SetSkin(msg.card.skin)
            --不使用玩家自身的皮肤数据
            cardData.skinIs = false
            cardData:SaveEquipmentData(card, true)
            cardData:SaveDecorationData(card, true)
            if not _G.AppSetting.IsOverseas then
                cardData:SaveArtifactData(card, true)
                cardData:SaveSpiritualData(card, true)
            end
            --local skin
            --if cardData.skin ~= 0 then
            --    skin = cardData.skin
            --end
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CommonIllustrationsH5View.Name,
                cardData.sid,
                function()
                end,
                nil,
                cardData,
                nil,
                nil,
                true
            )
        end
    )
    -- _G.UIManager:GetInstance():OpenWindow(
    --     _G.ConfigManager.ui_cfg.CommonIllustrationsH5View.Name,
    --     data.sid,
    --     data,
    --     true
    -- )
end

---更新宠物显示
function PlayerInfoView:UpdatePets()
    if _G.AppSetting.IsXzns then
        self.go_table.obj_PetShow:SetActiveE(0)
        self.go_table.obj_BeastShow:SetActiveE(1)
        local beastList
        if self.data.arrays and self.data.arrays[1] then
            beastList = self.data.arrays[1].beast or {}
        end
        -- beastList = {{sid=1},{sid=0},{sid = 263400100,star = 2,level = 1}}
        if beastList then
            local nameColor = {
                [4] = _G.ColorTools.FormatColorByString("7a4ab8"),
                [5] = _G.ColorTools.FormatColorByString("ff9b5e"),
                [6] = _G.ColorTools.FormatColorByString("d45d55"),
                [8] = _G.ColorTools.FormatColorByString("ffffff")
            }
            for k, info in pairs(beastList) do
                local go = _G.GetAutoGoTable(self.go_table["obj_beastItem" .. k])
                if info.sid == 1 or info.sid == 0 then
                    go.obj_stars:SetActiveE(0)
                else
                    go.obj_stars:SetActiveE(1)
                    for i = 1, 5 do
                        local showMask = ((info.star - 1) % 5 + 1) < i or info.star == 0
                        go["aorimage_starMask" .. i]:SetActiveE(showMask and 1 or 0)
                        go["aorimage_star" .. i].SpriteName = info.star >= i + 5 and "ui_ss_icon_xing_hong" or "ui_ss_icon_xing_normal"
                        go["aorimage_star" .. i].Alpha = showMask and 0 or 1
                    end
                    local cfg = _G.ConfigManager.pet_xzns_cfg[info.sid]
                    go.aortext_name.text = _G.GetLangPackValue(cfg.name)
                    go.aortext_name.color = nameColor[cfg.order]
                    if cfg.order == 8 then
                        go.aortext_name:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient)).enabled = true
                    end
                    _G.PoolsManager:GetInstance():Spawn(
                        cfg.spine_1,
                        _G.ePoolType.Temporary,
                        go.obj_root, function(trans)
                            if self:IsNil() then
                                _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.Temporary)
                                return
                            end
                        end
                    )
                end
            end
        end
    else
        local datas = self.petData or {}
        local data
        if not self.petItems then
            self.petItems = {}
        end
        for i = 1, 3 do
            if datas[i] and datas[i].sid and datas[i].sid > 0 then
                data = datas[i]
                if not self.petItems[i] then
                    local go_table = _G.GetAutoGoTable(self.go_table["obj_petItem" .. i])
                    self.petItems[i] = require "ItemPetBase".New(go_table.obj_node)
                end
                self.petItems[i]:Show(data.sid, data.star, _G.handlerbind(self, self.OnClickCard, data))
                self.go_table["obj_petItem" .. i]:SetActiveE(1)
            else
                self.go_table["obj_petItem" .. i]:SetActiveE(0)
            end
        end
    end
end

