        _G.PopWindowManager:GetInstance():ShowAllTips(100104)
        return
    end
    if self.playerType == PlayerType.Player then
        _G.FloatTipsModel:GetInstance():Show(_G.LangUtil.TryGetLangValue(90110010802))
        return
    end
    if self.playerType == PlayerType.Robot then
        local falg = false
        for i = 1, #self.RobotListe do
