local PlayerInfoView = _G.BaseClass("PlayerInfoView", _G.UIBaseView)
local IsNil = _G.IsNil
local PlayerType = {
    Player = "1",
    OtherPlayer = "2",
    Robot = "3"
}
local NoHideView = {
    [_G.ConfigManager.ui_cfg.SettingGiftView.Name] = true
}

function PlayerInfoView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.titleScale = _G.ConfigManager.discrete_cfg[103902][1][1] * 0.0035
    self:HideAllView()
    self.RobotListe = {}
    self:AddListener(_G.ConfigManager.net_map.delete_friend.Cmd, self.DeleteFriend)
    self:AddListener(_G.ConfigManager.net_map.friend.Cmd, self.AddFriendSec)
    self:AddListener(_G.eSetting.ImageQualityChange, self.UpdateImage)
    --self:AddListener(_G.eUIManagerStatus.StartOpenUI, self.OnStartOpenUI)
end

function PlayerInfoView:DeleteFriend(data)
    if data.role_uid == self.uid then
        self.go_table.aorbtn_addFriend:SetActiveE(1)
        self.go_table.aorbtn_delFriend:SetActiveE(0)
        self.go_table.aorbtn_Add:SetActiveE(1)
    end
end

function PlayerInfoView:AddFriendSec(data)
    if IsNil(data) then
        return
    end
    if data.type == 2 and self.uid == data.f_uid then
        self.go_table.aorbtn_addFriend:SetActiveE(0)
        self.go_table.aorbtn_Add:SetActiveE(0)
        self.go_table.aorbtn_delFriend:SetActiveE(1)
    end
end

---界面的入口函数
---@param data role.i_role_info
function PlayerInfoView:OnCreate(data, isCurPlayer, uid, Frend)
    self.uid = uid
    self.isCurPlayer = isCurPlayer
    self.Title = {}
    self.Halo = {}
    self.RolePoint = {}
    self:InitData(data)
    self:UpdateView()
    -- self:AddListener(_G.ePlayerStatus.PlayerChangeTitle, self.UpdateTitle)
    -- self:AddListener(_G.ePlayerStatus.PlayerChangeHalo, self.UpdateHalo)
    self:AddListener(_G.eUIManagerStatus.OnUIClosed, self.UpdateHaloAndTitle)

    _G.SDKManager:GetInstance():AddListener(SDKDef.GetMsg.bind_success, self.Bind_Success, self)
    _G.SDKManager:GetInstance():AddListener(SDKDef.GetMsg.bind_failed, self.Bind_Failed, self)

    self.closeBtn = {}
    _G.table.insert(self.closeBtn, self.go_table.aorbtn_close:GetComponentE(_G.typeof(_G.CS.AorButton)))
    _G.table.insert(self.closeBtn, self.go_table.aorbtn_close2:GetComponentE(_G.typeof(_G.CS.AorButton)))
    self.go_table.aorbtn_dh:SetActiveE(_G.AppSetting.IsArraigned and 0 or 1)
    self:ShowExchange(Frend)
    self:ShowTourist()
    if self.isCurPlayer then
        self.go_table.obj_baseInfo:SetActiveE(0)
        self.go_table.obj_baseInfos:SetActiveE(1)
    else
        self.go_table.obj_baseInfo:SetActiveE(1)
        self.go_table.obj_baseInfos:SetActiveE(0)
    end
    self.go_table.aorbtn_copyId:SetActiveE(1)--not _G.AppSetting.IsEditor and _G.AppSetting.IsWebGl and 0 or 1)
end

function PlayerInfoView:ShowTourist()
    if _G.AppSetting.DEBUG then
        _G.Log(self.isCurPlayer, "login_successself.isCurPlayer")
        _G.Log(_G.LoginManager:GetInstance().isTourist, "login_success_G.LoginManager:GetInstance().isTourist")
    end
    --镇魂街ZHJ-25211 【0728】【主任务】涉及程序单号ZHJ-25239
    --【客户端】游客账号新增绑定账号功能
    if not _G.AppSetting.IsOverseas then
        self.go_table.aorbtn_Tourist:SetActiveE(0)
    else
        _G.GameUtil.SetActiveByCondition(
            self.go_table.aorbtn_Tourist,
            self.isCurPlayer and _G.LoginManager:GetInstance().isTourist == 1
        )
    end
end

function PlayerInfoView:ShowExchange(Friend)
    if Friend ~= nil and Friend == 1 then
        self.go_table.aorbtn_Exchange:SetActiveE(1)
    elseif _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.ChatView.Name) then
        -- body
        if
        _G.BattleManager:GetInstance():CheckInBattle() or
            _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.EmbattleView.Name) or
            _G.WorldManager:GetInstance():GetCurWorldSid() == 801 or
            _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.ChapterObjectTagView.Name) or
            _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.SixVsSixEmbattleView.Name)
        then
            self.go_table.aorbtn_Exchange:SetActiveE(0)
        else
            self.go_table.aorbtn_Exchange:SetActiveE(1)
        end
    else
        self.go_table.aorbtn_Exchange:SetActiveE(0)
    end
end

function PlayerInfoView:Bind_Success()
    _G.LoginManager:GetInstance().isTourist = 0
    self:ShowTourist()
end

function PlayerInfoView:Bind_Failed()
    if _G.AppSetting.DEBUG then
        _G.LogError("绑定失败，纯提示")
    end
end

---初始化数据
---@param data role.i_role_info
function PlayerInfoView:InitData(data)
    self.data = data
    if self.isCurPlayer then
        self.playerType = PlayerType.Player
    else
        if self.data.isComment then
            self.playerType = PlayerType.Robot
        else
            if string.len(tostring(self.data.uid)) == 6 then
                self.playerType = PlayerType.Robot
                self.RobotCfg = _G.ConfigManager.arena_robot_cfg[self.data.uid]
                if self.RobotCfg then
                    self.data.model_path = self.RobotCfg.model_path
                end
            else
                self.playerType = PlayerType.OtherPlayer
            end
        end
    end
end

