function PlayerInfoView:OnStartClose()
    self:RemoveEvent()
    _G.SDKManager:GetInstance():RemoveListener(SDKDef.GetMsg.bind_success, self.Bind_Success, self)
    _G.SDKManager:GetInstance():RemoveListener(SDKDef.GetMsg.bind_failed, self.Bind_Failed, self)
    if self.camera then
        self:ResetCameraPos(true)
        self.camera.targetTexture = nil
        self.CPostProcessLayer.enabled = false
        self.mainCPostProcessLayer.enabled = self.CPostProcessLayerState
        _G.DestroyObject(self.camera.gameObject)
    end
    if self.roleTrans then
        _G.DestroyObject(self.roleTrans)
    end
    if self.posTb then
        for _, v in pairs(self.posTb) do
            if v.cancel then
                v.cancel:Dispose()
            end
            if not IsNil(v.gameObj) then
                _G.DestroyObject(v.gameObj)
            end
        end
    end
    if self.scene then
        _G.DestroyObject(self.scene)
    end
    if self.effectTb then
        for _, v in pairs(self.effectTb) do
            _G.DestroyObject(v)
        end
    end
    if self.texture then
        _G.CS.FrameWork.Graphic.Utility.RenderTextureUtility.Release(self.texture)
        self.texture = nil
    end
    _G.GraphicsManager.Instance.MainCamera.enabled = true
    self:ShowAllView()
end

