---战斗开始
function PlayerInfoView:DealAllApplySuc(msg, datas)
    self.Deal = true

    if msg.ack == 1 then
        local data = { false, false, false, false, false }
        local emptyTag = true
        local sids = msg.card[1].fights
        for i = 1, #sids do
            data[i] = {
                uid = sids[i].sid,
                sid = sids[i].sid,
                level = sids[i].lv or 0,
                star = sids[i].star or 0,
                skin = sids[i].skin_id or 0,
                soulLink_IsActivate = sids[i].soul_state or 0,
                soulLink_lv = sids[i].soul_chain_lv or 0,
                open_inborn = require("CardInfoManager"):GetInstance():GetTalentsNum(sids[i].sid, sids[i].skills)
            }
            if emptyTag then
                emptyTag = false
            end
        end
        data.power = msg.card[1].power
        data.uid = self.uid
        data.pet = msg.card[1].pet_skill
        --data.winner = msg.winner

        if emptyTag then
            _G.PopWindowManager:GetInstance():ShowAllTips(300101)
        else
            local function OnEmbattleViewOpen(self, name)
                _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, OnEmbattleViewOpen, self)
                local UIManagerIns = _G.UIManager:GetInstance()
                UIManagerIns:CloseWindow(_G.ConfigManager.ui_cfg.PlayerInfoView.Name)
                UIManagerIns:HideWindow(_G.ConfigManager.ui_cfg.FriendsView.Name)
                UIManagerIns:HideWindow(_G.ConfigManager.ui_cfg.ChatView.Name)
                _G.WorldManager:GetInstance():SetBaseViewVisible(false)
                --_G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
                --_G.WorldManager:GetInstance():SetBaseViewVisible(false)
                --_G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
                -- UIManagerIns:CloseWindow(_G.ConfigManager.ui_cfg.ArenaMainPanelView.Name)
            end
            _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, OnEmbattleViewOpen, self)
            self.openEmbattleState = true
            --_G.BaseBattleManager:GetInstance():ClearView(true)

            require("EmbattleController"):GetInstance():OpenEmbattle(
                _G.EmbattleType.FightDuel,
                _G.EmbattleSaveType.server,
                nil,
                _G.EmbattleControllerItemType.EmbattleItemFriendDuel,
                _G.handler(self, self.OnEmbattleQuit),
                _G.handler(self, self.OnBattle),
                _G.ConfigManager.arena_info_cfg[1].battle_sences,
                data,
                datas
            )
        end
    end
