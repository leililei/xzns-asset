---更新称号
function PlayerInfoView:UpdateTitle(pos, title, choosing)
    title = _G.table.isEmptyOrNil(title) and 0 or title.sid
    local parent = pos == 0 and self.roleTrans or self.posTb[pos].gameObj
    local isEmpty = self:CheckPosEmpty(pos)
    if choosing then
        isEmpty = false
    end
    if not isEmpty and (not self.Title[pos] or IsNil(self.Title[pos].gameObject)) then
        -- if self.isCurPlayer and _G.PlayerModel:GetInstance():GetEffectUser(2, title) ~= _G.WorldManager:GetInstance():GetCurWorldPlayer().Sid then
        --     return
        -- end
        _G.PoolsManager:GetInstance():Spawn(
            "CommonPrefab/World/Common_TitleWithDesignation",
            _G.ePoolType.Temporary,
            parent,
            function(trans)
                if (_G.IsNil(parent)) then
                    _G.DestroyObject(trans)
                    return
                end
                local go_table = _G.GetAutoGoTable(trans)
                trans:AddComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
                self.Title[pos] = go_table
                --self:SetTitlePos(pos)
                go_table.aortext_TextName.text = pos == 0 and string.AddColor(self.data.name, "ffee9c") or ""
                if not title or title <= 0 then
                    if self.Title[pos] then
                        if self.Title[pos].item then
                            _G.DestroyObject(self.Title[pos].item)
                        else
                            _G.GameUtil.SetActiveByCondition(self.Title[pos].aorrawimage_Title, false)
                        end
                    end
                    return
                end

                ---@type player_title_effect_cfg
                local cfg = _G.ConfigManager.player_title_effect_cfg[title]
                if cfg then
                    if cfg.type_title == 1 then
                        go_table.aorrawimage_Title:LoadImage(
                            cfg.icon,
                            function()
                                go_table.aorrawimage_Title:SetNativeSize()
                                go_table.aorrawimage_Title:SetLocalScaleXYZ(
                                    pos == 0 and self.titleScale or self.titleScale * self.posTb[pos].scale
                                )
                            end
                        )
                        if self.Title[pos].item then
                            _G.DestroyObject(self.Title[pos].item)
                            self.Title[pos].item = nil
                        end
                        _G.GameUtil.SetActiveByCondition(self.Title[pos].aorrawimage_Title, true)
                    else
                        _G.GameUtil.SetActiveByCondition(self.Title[pos].aorrawimage_Title, false)
                        if self.Title[pos].item then
                            _G.DestroyObject(self.Title[pos].item)
                            self.Title[pos].item = nil
                        end
                        _G.UIUtils.LoadEffectTitleOrFrame(
                            cfg.title,
                            self.Title[pos].gameObject,
                            function(trans)
                                if self:IsNil() then
                                    _G.DestroyObject(trans)
                                    return
                                end
                                trans:SetLayerAndChild(30)
                                self.Title[pos].item = trans
                                local x, y, z = self.Title[pos].aorrawimage_Title:GetPosition()
                                trans:SetPosition(x, y + 0.2, z)
                                self.Title[pos].item:SetLocalScaleXYZ(
                                    pos == 0 and self.titleScale or self.titleScale * self.posTb[pos].scale
                                )
                                _G.GameUtil.SetActiveByCondition(trans, true)
                            end
                        )
                    end
                end
            end
        )
    elseif self.Title[pos] then
        if self.Title[pos].item then
            _G.DestroyObject(self.Title[pos].item)
            self.Title[pos].item = nil
        end
        if not title or title <= 0 then
            _G.GameUtil.SetActiveByCondition(self.Title[pos].aorrawimage_Title, false)
            return
        end
        -- if self.isCurPlayer and _G.PlayerModel:GetInstance():GetEffectUser(2, title) ~= _G.WorldManager:GetInstance():GetCurWorldPlayer().Sid then
        --     return
        -- end
        ---@type player_title_effect_cfg
        local cfg = _G.ConfigManager.player_title_effect_cfg[title]
        if cfg.type_title == 1 then
            self.Title[pos].aorrawimage_Title:LoadImage(
                cfg.icon,
                function()
                    self.Title[pos].aorrawimage_Title:SetNativeSize()
                    self.Title[pos].aorrawimage_Title:SetLocalScaleXYZ(
                        pos == 0 and self.titleScale or self.titleScale * self.posTb[pos].scale
                    )
                end
            )
            _G.GameUtil.SetActiveByCondition(self.Title[pos].aorrawimage_Title, true)
        else
            _G.UIUtils.LoadEffectTitleOrFrame(
                cfg.title,
                self.Title[pos].gameObject,
                function(trans)
                    if self:IsNil() then
                        _G.DestroyObject(trans)
                        return
                    end
                    trans:SetLayerAndChild(30)
                    self.Title[pos].item = trans
                    local x, y, z = self.Title[pos].aorrawimage_Title:GetPosition()
                    trans:SetPosition(x, y + 0.2, z)
                    self.Title[pos].item:SetLocalScaleXYZ(
                        pos == 0 and self.titleScale or self.titleScale * self.posTb[pos].scale
                    )
                    _G.GameUtil.SetActiveByCondition(trans, true)
                end
            )
            _G.GameUtil.SetActiveByCondition(self.Title[pos].aorrawimage_Title, false)
        end
    end
end

---更新光环
function PlayerInfoView:UpdateHalo(pos, halo)
    if not IsNil(self.Halo[pos]) then
        _G.PoolsManager:GetInstance():Despawn(self.Halo[pos], _G.ePoolType.Temporary)
        self.Halo[pos] = nil
    end
    halo = _G.table.isEmptyOrNil(halo) and 0 or halo.sid
    if not halo or halo <= 0 then
        return
    end
    -- if self.isCurPlayer and _G.PlayerModel:GetInstance():GetEffectUser(1, halo) ~= _G.WorldManager:GetInstance():GetCurWorldPlayer().Sid then
    --     return
    -- end
    local parent = pos == 0 and self.roleTrans or self.posTb[pos].gameObj
    ---@type player_halo_effect_cfg
    local cfg = _G.ConfigManager.player_halo_effect_cfg[halo]
    _G.PoolsManager:GetInstance():Spawn(
        cfg.halo,
        _G.ePoolType.Temporary,
        parent,
        function(trans)
            if IsNil(parent) then
                _G.DestroyObject(trans)
                return
            end
            self.Halo[pos] = trans
            self:SetHaloPos(pos, cfg.type_halo)
        end
    )
end

---设置光环位置
function PlayerInfoView:SetHaloPos(pos, type)
    if not IsNil(self.Halo[pos].gameObject) then
        if type == 2 then
            self.Halo[pos]:SetParentE(self.RolePoint[pos].Point_Chest)
        else
            local scale = self.Halo[pos]:GetParent():GetLocalScale()
            local rate = pos == 0 and 1 or self.posTb[pos].scale
            self.Halo[pos]:SetLocalScaleXYZ(rate * _G.ConfigManager.discrete_cfg[103901][1][1] / scale)
        end
        self.Halo[pos]:GetChildE(0):SetActiveE(1)
        self.Halo[pos]:SetEulerAngles(0, 0, 0)
        self.Halo[pos]:SetLocalPositionToZero()
    end
end

