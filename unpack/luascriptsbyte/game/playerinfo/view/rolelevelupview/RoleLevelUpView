---@class RoleLevelUpView : UIBaseView    玩家升级
---@field public go_table RoleLevelUpView_GoTable GoTable
local RoleLevelUpView = _G.BaseClass("RoleLevelUpView", _G.UIBaseView)
--_G.RoleLevelUpView = RoleLevelUpView

local CS = _G.CS
local typeof = _G.typeof
local RoleLevle = 90000010036
function RoleLevelUpView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
end

---@field oldlv number 之前等级
---@field nowlv number 提升后等级
---@field awardDic table 奖励
---@field call function
---@class params_RoleLevelUpView

---界面的入口函数
------@param Data params_RoleLevelUpView
function RoleLevelUpView:OnCreate(Data, callback)
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.RoleLevelUpView, self.go_table)
    if _G.AppSetting.IsXzns then
        if _G.GameUtil.IsHeXieHide() then
            self.go_table.obj_Spine:SetActiveE(0)
        end
        _G.GameUtil.SetUiHeXieMask(self.go_table)
    end
    --- 是否可以点击关闭了
    self.isClose = false
    self.callback = callback

    self.call = Data.call
    self.nowlv = Data.nowlv
    self.oldlv = Data.oldlv

    self.awardDic = Data.awardDic
    _G.AudioManager.PlayAudioByAudioCfgID(2056)
    self.go_table.aortext_lv_L.text = "Lv." .. tostring(self.oldlv)
    self.go_table.aortext_lv_R.text = "Lv." .. tostring(self.nowlv)
    self.go_table.aortext_tips:DOFade(0, 1):SetLoops(-1, CS.DG.Tweening.LoopType.Yoyo)

    local delay = _G.ConfigManager.discrete_cfg[_G.DiscreteCfg_Enum.viewCloseDelay]
    delay = tonumber(delay) or 1
    self:SetEff()
    self:SetItem()
    self:ShowLevel()
    self:ShowFunctionOpenPre()
    local time = _G.PopWindowManager:GetInstance():AutoCloseTime(_G.PopViewShowOrder.PlayerLevelUp)
    if time > 0 then
        self.closeTimer = _G.TimerManager:GetInstance():GetTimer(time, self.CloseView, self, true, false)
        self.closeTimer:Start()
    end
end

function RoleLevelUpView:GetTimerCallBack()
    self.isClose = true
end

function RoleLevelUpView:MaxPage()
    local frame = _G.PlayerModel:GetInstance():GetCurFrame()

    if frame ~= 0 and not _G.IsNil(self.go_table.aorrawimage_frame) then
        local tcfg = _G.ConfigManager.player_frame_cfg[frame]
        if not _G.IsNil(tcfg) then
            _G.UIUtils.RemoveChildren(self.go_table.aorrawimage_frame)
            if tcfg.type_title ~= 2 then
                self.go_table.aorrawimage_frame:LoadImage(tcfg.frame)
            else
                self.go_table.aorrawimage_frame.color = _G.Color.New(1, 1, 1, 0)
                _G.UIUtils.LoadEffectTitleOrFrame(
                        tcfg.frame,
                        self.go_table.aorrawimage_frame,
                        function(item)
                            if self:IsNil() then
                                _G.UIUtils.RemoveEffect(item)
                                return
                            end
                            item:SetLocalScale(0.85, 0.85, 1)
                        end
                )
            end
        end
    end

    local role_style = _G.PlayerModel:GetInstance().role_style

    if role_style and not _G.IsNil(self.go_table.aorimage_playerIcon) then
        local tcfg = _G.ConfigManager.player_portrait_cfg[role_style]
        if not _G.IsNil(tcfg) then
            --self.go_table.aorrawimage_playerIcon:LoadImage(tcfg.portrait1)
            self.go_table.aorimage_playerIcon.SpriteName = tcfg.portrait1
        end
    else
        ---角色头像与角色模型绑定

        if _G.AppSetting.DEBUG then
            _G.LogError("imageCfg nil")
        end
    end
end

---更新经验
function RoleLevelUpView:UpdateExp()
    local nowLV = _G.PlayerModel:GetInstance():GetLevel()
    local nowExp = _G.PlayerModel:GetInstance().exp or 0
    local nowLvCfg = _G.ConfigManager.player_level_cfg[nowLV]
    local upExp = not _G.IsNil(nowLvCfg) and nowLvCfg.exp or nowExp

    local sExp
    if upExp == 0 then
        sExp = "Max"
    else
        sExp = _G.GameUtil.NumberToUnitStr(nowExp) .. " / " .. _G.GameUtil.NumberToUnitStr(upExp)
    end
    -- 暂时不显示数字 hd 2021年11月29日
    self.go_table.aortext_exp.text = sExp
    self.go_table.aorimage_exp.fillAmount = nowExp / upExp
end

function RoleLevelUpView:SetEff()
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ShowAwardVBGLight,
            self.go_table.obj_eff,
            function(obj)
                if self:IsNil() then
                    _G.UIUtils.RemoveEffect(obj)
                    return
                end
                obj:SetLocalPositionToZero()
            end
    )
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ShowAwardVBGShengLI,
            self.go_table.obj_eff,
            function(obj)
                if self:IsNil() then
                    _G.UIUtils.RemoveEffect(obj)
                    return
                end
                obj:SetLocalPosition(0, 100, 0)
            end
    )
end

function RoleLevelUpView:SetItem()
    local itemDic = {}
    if self.awardDic and self.awardDic.item then
        for key, value in pairs(self.awardDic.item) do
            if itemDic[value.type[1]] == nil then
                itemDic[value.type[1]] = value.type
            else
                itemDic[value.type[1]][2] = itemDic[value.type[1]][2] + value.type[2]
            end
        end
        for _, v in pairs(itemDic) do
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                    v,
                    self.go_table.obj_item,
                    _G.handler(self, self.OnItemShow)
            )
        end
    end
end

function RoleLevelUpView:ShowLevel()
    local hun = self.nowlv // 100
    local ten = (self.nowlv // 10) % 10
    local one = self.nowlv % 10
    self.go_table.aorimage_one.SpriteName = "ui_djts_" .. one .. "_txt"
    self.go_table.aorimage_ten.SpriteName = "ui_djts_" .. ten .. "_txt"
    self.go_table.aorimage_hun.SpriteName = "ui_djts_" .. hun .. "_txt"
    self.go_table.aorimage_ten:SetActiveE(self.nowlv >= 10 and 1 or 0)
    self.go_table.aorimage_hun:SetActiveE(self.nowlv >= 100 and 1 or 0)
end

function RoleLevelUpView:OnItemShow(item)
    if self:IsNil() then
        return
    end
    item.transform:SetLocalPosition(0, 0, 0)
    -- if item.ShowName ~= nil then
    --     item:ShowName(true)
    -- end
    if item.ShowNumText ~= nil then
        item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
    end
end

function RoleLevelUpView:ShowFunctionOpenPre()
    local forecast = {}
    local sid = require "AfkModel":GetInstance():GetCurSection()
    local afkOpenArr = _G.FunctionManager:GetInstance():GetAfkFuncOpenArr()
    local count = 0
    if afkOpenArr then
        for k, v in pairs(afkOpenArr) do
            if sid < v[1] and #v[2] > 0 and not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(v[3]) then
                count = count + 1
                _G.table.insert(forecast, v) --{放置id, {语言表id}, funOpenId}
            end
            if count >= 3 then
                break
            end
        end
    end

    self.go_table.aorimage_di:SetRectTransformSize(619, count > 0 and 718 or 515)
    self.go_table.obj_preview:SetActiveE(count > 0 and 1 or 0)
    ---@type RoleLevelUpView._obj_funItem1_GoTable
    local tb, fCfg, sCfg
    for i = 1, 3 do
        self.go_table["obj_funItem" .. i]:SetActiveE(count >= i and 1 or 0)
        if count >= i then
            tb = _G.GetAutoGoTable(self.go_table["obj_funItem" .. i])
            fCfg = _G.ConfigManager.function_open_cfg[forecast[i][3]]
            tb.aorimage_icon.SpriteName = fCfg.icon
            tb.aortext_funName.text = _G.GetLangPackValue(fCfg.name)
            sCfg = _G.ConfigManager.afk_cfg[forecast[i][1]]
            tb.aortext_section.text = _G.GetLangPackValue(90029400059, sCfg.chapter, sCfg.section)
        end
    end
    return forecast
end

function RoleLevelUpView:OnDisable()
    if self.timer ~= nil then
        self.timer:Stop()
        self.timer = nil
    end
    if self.closeTimer then
        self.closeTimer:Stop()
    end
    if self.call ~= nil then
        self.call()
    end
    _G.PopWindowManager:GetInstance():SetNowPopping(false)
    _G.PopWindowManager:GetInstance():Next()
end

function RoleLevelUpView:OnDestroy()
    if self.callback then
        self.callback()
    end
end

function RoleLevelUpView:CloseView()
    self:Close()
end

---按钮点击事件在这里派发
function RoleLevelUpView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

return RoleLevelUpView
