local IllustrationModel = require("IllustrationModel")
local CardData = require("CardData")

---@class PlayerInfoChangeRoleView : UIBaseView    中文描述
---@field public go_table PlayerInfoChangeRoleView_GoTable GoTable
------@field curModel number 当前模式(1排位赛2友谊赛)
local PlayerInfoChangeRoleView = _G.BaseClass("PlayerInfoChangeRoleView", _G.UIBaseView)

local table = _G.table
local EleType = _G.CardElementType

function PlayerInfoChangeRoleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function PlayerInfoChangeRoleView:OnCreate(cardList, roleData, call)
    self.curRoleData = roleData
    self.cardList = cardList
    self.call = call
    self.nowCardIndex = 1
    self.chooseCardIndex = 0
    self.cardDataList = {}
    self.eleBtnLis = {
        [EleType.None] = self.go_table.aorbtn_all,
        [EleType.Thunder] = self.go_table.aorbtn_thunder,
        [EleType.Wind] = self.go_table.aorbtn_wind,
        [EleType.Water] = self.go_table.aorbtn_water,
        [EleType.Fire] = self.go_table.aorbtn_fire,
        [EleType.Earth] = self.go_table.aorbtn_earth,
        [EleType.God] = self.go_table.aorbtn_god
    }
    self:InitElementIndex()
    self.Params_LoopInit = false
    self.go_table.scrollloopvectical_card:InitItemData(0, _G.handler(self, self.RefreshList))
    self.Params_LoopInit = true
    self:ChangeElement(EleType.None)
end

function PlayerInfoChangeRoleView:InitElementIndex()
    self.elementIndexes = {}
    for k, v in pairs(EleType) do
        self.elementIndexes[v] = {}
    end
    for k, v in pairs(self.cardList) do
        table.insert(self.elementIndexes[v.cfg.Elements], k)
        table.insert(self.elementIndexes[EleType.None], k)
        if v == self.curRoleData then
            self.chooseCardIndex = k
        end
    end
end

function PlayerInfoChangeRoleView:RefreshList(index, obj)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj)
    tb.index = index
    if tb.Lua == nil then
        tb.Lua = true
        if self.Params_LoopInit == false then
            if self.Params_LoopTimers == nil then
                self.Params_LoopTimers = {}
            end
            local timer = _G.TimerManager:GetInstance():GetTimer(0.5 * index, self.InitFun, self, true, true, true, tb)
            table.insert(self.Params_LoopTimers, timer)
            timer:Start()
        else
            self:InitFun(tb)
        end
    else
        self:SetCardItem(tb)
    end
end

function PlayerInfoChangeRoleView:InitFun(tb)
    _G.ItemCardFactory:GetInstance():GetItemCard(
        _G.ItemCardFactory.itemCardType.BodyItem_select,
        tb.obj_node,
        function(itemLua)
            tb.Lua = itemLua
            self:SetCardItem(tb)
        end
    )
end

function PlayerInfoChangeRoleView:SetCardItem(itemGoTable)
    if itemGoTable == nil or self:IsNil() then
        return
    end
    local cardData = self:GetCardData(itemGoTable.index)
    ---@type ItemCardBodySelectView
    local lua = itemGoTable.Lua
    itemGoTable.gameObject:SetName(cardData.uid)
    -- itemGoTable.gameObject:SetLocalScale(0.9, 0.9, 0.9)
    local _, skinIs = require "CardCommentManager":GetInstance():CardWearSkin(cardData.sid)
    if skinIs ~= 0 then
        cardData.skinIs = skinIs
    end
    --直接从池子 中取出
    lua:ShowCardData(cardData, _G.handlerbind(self, self.OnCardBodyClick_bg, itemGoTable), true)
    lua:SetSelectGou(self.nowCardIndex == itemGoTable.index)
end

function PlayerInfoChangeRoleView:GetCardData(index)
    local allIndex = self.elementIndexes[self.curElement][index]
    local cardData = self.cardDataList[allIndex]
    if cardData == nil then
        local cardMsg = self.cardList[allIndex]
        local star = IllustrationModel:GetInstance():GetCardMaxStar(cardMsg.cfg.id)
        cardData = CardData.New()
        local msg = {
            sid = cardMsg.cfg.id,
            star = star
        }
        cardData:ParseInitMsg(msg)
        self.cardDataList[allIndex] = cardData
    end
    return cardData
end

function PlayerInfoChangeRoleView:OnCardBodyClick_bg(_, itemGoTable)
    local CardIndex = itemGoTable.index
    if CardIndex == nil or CardIndex == self.nowCardIndex then
        return
    end
    self.nowCardIndex = CardIndex
    self.chooseCardIndex = self.elementIndexes[self.curElement][CardIndex]
    self.go_table.scrollloopvectical_card:UpdateAllItem()
end

function PlayerInfoChangeRoleView:ChangeElement(element)
    if self.curElement == element then
        return
    end
    self.curElement = element
    self.go_table.aorimage_select:SetParentE(self.eleBtnLis[element])
    self.nowCardIndex = 0
    self.go_table.scrollloopvectical_card:UpdateCount(#self.elementIndexes[self.curElement])
end

---@private
function PlayerInfoChangeRoleView:OnDisable()
end

---界面的销毁函数
function PlayerInfoChangeRoleView:OnDestroy()
    if self.Params_LoopTimers then
        for i = 1, #self.Params_LoopTimers do
            self.Params_LoopTimers[i]:Stop()
        end
        self.Params_LoopTimers = nil
    end
end

---按钮点击事件在这里派发
function PlayerInfoChangeRoleView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeView then
        self:Close()
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_queding then
        if self.call then
            self.call(self.chooseCardIndex)
        end
        self:Close()
    elseif go == self.go_table.aorbtn_all then
        self:ChangeElement(EleType.None)
    elseif go == self.go_table.aorbtn_thunder then
        self:ChangeElement(EleType.Thunder)
    elseif go == self.go_table.aorbtn_wind then
        self:ChangeElement(EleType.Wind)
    elseif go == self.go_table.aorbtn_water then
        self:ChangeElement(EleType.Water)
    elseif go == self.go_table.aorbtn_fire then
        self:ChangeElement(EleType.Fire)
    elseif go == self.go_table.aorbtn_earth then
        self:ChangeElement(EleType.Earth)
    elseif go == self.go_table.aorbtn_god then
        self:ChangeElement(EleType.God)
    end
end

return PlayerInfoChangeRoleView
