---初始化模型站位
function PlayerInfoRecordView:InitModelPos()
    ---@type monster_group_cfg
    local cfg = _G.ConfigManager.monster_group_cfg[502010110]
    local centerPos = cfg.FightAreaPos
    cfg = _G.ConfigManager.pos_cfg[cfg.pos]
    self.posTb = _G.DeepCopyCfgTable(cfg.AttackerPos)
    for i = 1, #self.posTb do
        self.posTb[i][1] = self.posTb[i][1] + centerPos[1]
        self.posTb[i][2] = self.posTb[i][2] + centerPos[2]
        self.posTb[i][3] = self.posTb[i][3] + centerPos[3]
    end
end

return PlayerInfoRecordView
