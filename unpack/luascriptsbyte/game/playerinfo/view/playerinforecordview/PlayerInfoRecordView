    --    --[100501] = self.go_table.obj_deadSoulTower, --巅峰演武
    --}
    self.panelLua = {}
    self:InitView()
end

---@private
function PlayerInfoRecordView:InitTagList()
    local tags = {}
    for k, v in pairs(self.cfg) do
        if not v.reveal then
            table.insert(tags, {id = v.id, sort = v.display_priority})
        end
    end
    table.sort(
        tags,
        function(a, b)
            return a.sort < b.sort
        end
    )
    return tags
end

---初始化界面
function PlayerInfoRecordView:InitView()
    self.go_table.scrollloophorizontal_tag:InitItemData(#self.tags, _G.handler(self, self.RefreshTagItem))
    self:ShowPanel(self.curTag)
    self:InitModelPos()
end

---刷新页签
function PlayerInfoRecordView:RefreshTagItem(index, obj)
    index = index + 1
    local cfg = self.cfg[self.tags[index].id]
    ---@type PlayerInfoRecordView._obj_tagItem_GoTable
    local tb = GetAutoGoTable(obj, handlerbind(self, self.OnClickTag, cfg.id))
    self.tagItems[cfg.id] = tb
    tb.aortext_title.text = GetLangPackValue(cfg.title)
    tb.aortext_title.color = cfg.id == self.curTag and tagOnClick or tagNoClick
    if cfg.id == self.curTag then
        tb.aorimage_onClick:SetActiveE(1)
        tb.aorimage_noClick:SetActiveE(0)
    else
        tb.aorimage_onClick:SetActiveE(0)
        tb.aorimage_noClick:SetActiveE(1)
    end
    
end

---@private
function PlayerInfoRecordView:ShowPanel(id)
    -- SetActiveByCondition(self.go_table.obj_title, id ~= 100501)
    -- self.go_table.aortext_mainTitle.text = GetLangPackValue(self.cfg[id].title)
    if self.rightPanel[id] then
        self.rightPanel[id]:SetActiveE(1)
        self:ShowScene(self.panelLua[id]:CheckShowScene(), id)
    else
        _G.PoolsManager:GetInstance():Spawn(
            PanelPrefabs[id],
            _G.ePoolType.UIItem,
            self.go_table.obj_Right,
            function(trans)
                self.rightPanel[id] = trans
                self.panelLua[id] = self:AddComponent(trans, require(PanelLuaFile[id]).New(trans, self.uid, self.isBot, id))
                self.panelLua[id]:SetView(self)
                self.panelLua[id]:SetRenderTexture(self.texture)
                self.panelLua[id]:Show()
                self:ShowScene(self.panelLua[id]:CheckShowScene(), id)
            end
        )
    end
end

---@private
function PlayerInfoRecordView:OnClickTag(go, isOn, id)
    if id ~= self.curTag then
        self.tagItems[self.curTag].aortext_title.color = tagNoClick
        self.tagItems[self.curTag].aorimage_onClick:SetActiveE(0)
        self.tagItems[self.curTag].aorimage_noClick:SetActiveE(1)
        self.tagItems[id].aortext_title.color = tagOnClick
        self.tagItems[id].aorimage_onClick:SetActiveE(1)
        self.tagItems[id].aorimage_noClick:SetActiveE(0)
        self:ShowPanel(id)
        self.rightPanel[self.curTag]:SetActiveE(0)
        self.curTag = id
    end
end

---按钮点击事件在这里派发
function PlayerInfoRecordView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:Close()
    elseif name == "@_aorbtn_close" then
        self:Close()
    end
end

---@private
function PlayerInfoRecordView:Close()
    if self.callback then
        self.callback()
    end
    _G.UIBaseView.Close(self)
end
