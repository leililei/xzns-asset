        PanelPrefabs[100501] = "UIH5_xzns/PlayerInfo/$_obj_RecordAfk" -- 放置
        PanelPrefabs[100601] = "UIH5_xzns/PlayerInfo/$_obj_RecordArena" -- 竞技场
        PanelPrefabs[100801] = "UIH5_xzns/PlayerInfo/$_obj_RecordSecretRealm" -- 大秘境
        PanelPrefabs[100901] = "UIH5_xzns/PlayerInfo/$_obj_RecordHellGuard" -- 天灾之地
    end
    self.callback = callback
    self.uid = uid
    self.isBot = isBot
    ---@type player_files_cfg[]
    self.cfg = ConfigManager.player_files_cfg
    self.tags = self:InitTagList()
    self.tagItems = {}
    self.curTag = self.tags[1].id
    self.rightPanel = {}
    --self.rightPanel = {
    --    [100101] = self.go_table.obj_deadSoulTower, --死魂塔
