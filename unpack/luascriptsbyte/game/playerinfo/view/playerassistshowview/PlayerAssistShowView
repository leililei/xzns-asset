---@class PlayerAssistShowView : UIBaseView	中文描述
---@field public go_table PlayerAssistShowView_GoTable GoTable
local PlayerAssistShowView = _G.BaseClass("PlayerAssistShowView", _G.UIBaseView)
--_G.PlayerAssistShowView = PlayerAssistShowView

function PlayerAssistShowView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param data role.s2c_role_assist
function PlayerAssistShowView:OnCreate(data)
    self:UpdateCard(data)
end
---更新卡牌
---@param data role.s2c_role_assist
function PlayerAssistShowView:UpdateCard(data)
    local ItemCardBodyBaseView = require "ItemCardBodyBaseView"
    local tb = data.cards or {}
    self.go_table.obj_Nil:SetActiveE(_G.table.isEmptyOrNil(tb) and 1 or 0)
    for i = 1, 5 do
        local cardData = tb[i]
        if not cardData then
            self.go_table["obj_card" .. i]:SetActiveE(0)
        else
            self.go_table["obj_card" .. i]:SetActiveE(1)
            local lua = ItemCardBodyBaseView.New(self.go_table["obj_card" .. i])
            lua:Show({sid = cardData.sid, star = cardData.star, lv = cardData.level})
            lua:HideLevel()
        end
    end
end

---按钮点击事件在这里派发
function PlayerAssistShowView:OnClickBtn()
    self:Close()
end

return PlayerAssistShowView
