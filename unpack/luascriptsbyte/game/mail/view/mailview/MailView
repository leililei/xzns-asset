require "MailItem"
require "MailModel"
require "BaseAwardItem"
---@class MailView : UIBaseView
---@field go_table MailView_GoTable
---@field mails  mail.i_mail_brief[] 所有邮件的数据
---@field scrollViewRect UnityEngine.RectTransform 邮件正文所在的RectTransform
---@field AffixData award.i_award_item 当前选中邮件的附件数据
---@field AffixItems BaseAwardItem[] 所有附件的物体
---@field curItem MailItem 当前选中的邮件
---@field curMail mail.i_mail_brief 当前选中邮件的附件数据
---@field mailList MailItem[] 所有的邮件物体
local MailView = _G.BaseClass("MailView", _G.UIBaseView)
local GetLangPackValue = _G.GetLangPackValue
function MailView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.clickFunction = {
        ["@_aorbtn_btnClose"] = self.CloseView,
        ["@_aorbtn_btnGetAll"] = self.ReceiveAll,
        ["@_aorbtn_btnDeleteAll"] = self.DelAllReadMail
    }
    self:AddListener(_G.eMail.ExpireMail, self.RemoveMail)
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.openPanel)
    _G.GameUtil.SetActiveByCondition(self.gameObject, false)
end

---界面的入口函数

---@param mails mail.s2c_get_mails 邮件数据
function MailView:OnCreate(data)
    require "MailModel":GetInstance():GetMailsData(
        function(data)
            _G.GameUtil.SetActiveByCondition(self.gameObject, true)
            self.isInited = false
            self:InitData(data)
            self.isInited = true
            self:AddComponent(
                self.go_table.obj_playerInfo,
                require("PlayerComponent").New(self.go_table.obj_playerInfo)
            )
            self:AddComponent(
                self.go_table.obj_resource,
                require("ResourceCompont").New(
                    self.go_table.obj_resource,
                    _G.ConfigManager.ui_cfg.MailView.resources
                )
            )
        end
    )
end

---初始化邮件
function MailView:InitData(data)
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.MailList.id)
    self.mails = data
    self.mailList = {}

    self.isInitAward = false
    self.go_table.aorlooplist_MailList:StartUpdataDragInfo(0, _G.handler(self, self.RefreshItem))
    if self.mails == nil or #data == 0 then
        self:DisplayMail(false)
        return
    end
    self:RefreshAllMails(#data)
    self:DisplayMail(true)
    self:ShowGetAllBtn()
    self.inited = true
end

function MailView:Dispose()
    for _, value in pairs(self.mailList) do
        value:Dispose()
    end
    self.mailList = nil
end

---刷新邮件
---@param trans Transform 邮件的transform
---@param index tonumber 邮件的下标
function MailView:RefreshItem(trans, index)
    local tbIndex = index + 1
    local data = self.mails[tbIndex]
    local instance = trans:GetInstanceIDE()
    if self.mailList[instance] == nil then
        --TODO  判断有无附件 若有附件则产生附件的，若无附件则产生无附件的 
        self.mailList[instance] = require("MailItem").Create(
            trans,
            _G.handler(self, self.SetCurMail),
            _G.handler(self, self.ShowGetAllBtn),
            _G.handler(self, self.OnGetCallBack)
        )
    end
    self.mailList[instance]:UpdateData(data, self.curMail)
    if (not self.curMail and tbIndex == 1) or (self.curMail and self.curMail.uid == data.uid) then
        self.curItem = self.mailList[instance]
    end
end

function MailView:OnGetCallBack()
    require("MailModel"):GetInstance():GetMailDataAndSort()
    self:SetMailsRefresh()
end

