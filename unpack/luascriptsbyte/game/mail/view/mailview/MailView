---设置当前显示的邮件
---@param data mail.i_mail_brief 邮件的数据
---@param isRead boolean 当前有件是否为新的已读邮件
function MailView:SetCurMail(item, isRead)
    if item.data == nil or (self.curMail ~= nil and item.data.uid == self.curMail.uid) then
        return
    end
    self.curItem = item
    self.curMail = item.data
    require("MailModel"):GetInstance():SetCurMail(item.data)
    if isRead then
        require("MailModel"):GetInstance():GetMailDataAndSort()
        self:SetMailsRefresh()
    end
end

--一键领取
function MailView:ReceiveAll()
    if not self.canGet then
        _G.PopWindowManager:GetInstance():ShowAllTips(330101)
        return
    end
    local isHave = false
    for _, v in pairs(self.mails) do
        if v.annex and v.state < 2 then
            isHave = true
            break
        end
    end
    if isHave then
        local uids = self:GetAwardUids(self.mails)
        if #uids > 0 then
            require("MailModel"):GetInstance():GetAllAffix(uids, _G.handler(self, self.ReceiveAllCall))
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(380104) --背包满了
        end
    end
end

---获取可以领取的邮件uid
function MailView:GetAwardUids(datas)
    local uids = {}
    local awardData = {}
    local count = #datas
    for i = 1, count do
        if datas[i].annex and datas[i].state < 2 then
            local tb = {}
            for j = 1, #datas[i].annex do
                local data = datas[i].annex[j].type
                local sid, num = data[1], data[2]
                if sid == 0 and #data >= 5 then
                    sid = data[4]
                    num = data[5]
                end
                local _, ID = _G.StorageManager:GetInstance():CheckSidType(sid)
                if ID == _G.StorageID.Equipment then
                    if data[3] and not data[4] then
                        if
                            not _G.StorageManager:GetInstance():GetItemDataByID(
                                _G.StorageID.Equipment,
                                sid * 10 + data[3]
                            )
                        then
                            if awardData[sid] then
                                awardData[sid] = num + awardData[sid]
                            else
                                awardData[sid] = num
                            end
                        end
                    else
                        local cfg = _G.ConfigManager.equipment_cfg[sid]
                        if cfg and cfg.addition > 0 then
                            if awardData[sid] then
                                awardData[sid] = num + awardData[sid]
                            else
                                awardData[sid] = num
                            end
                        end
                    end
                else
                    if awardData[sid] then
                        awardData[sid] = num + awardData[sid]
                    else
                        awardData[sid] = num
                    end
                end
                if awardData[sid] then
                    tb[#tb + 1] = { sid, awardData[sid] }
                end
            end
            if _G.table.isEmptyOrNil(awardData) or _G.StorageManager:GetInstance():IsCheckAddGetItem(tb) then
                _G.table.insert(uids, datas[i].uid)
            else
                for j = 1, #tb do
                    if awardData[datas[i].annex[j].type[1]] then
                        awardData[datas[i].annex[j].type[1]] = awardData[datas[i].annex[j].type[1]] - tb[j][2]
                        if awardData[datas[i].annex[j].type[1]] == 0 then
                            awardData[datas[i].annex[j].type[1]] = nil
                        end
                    end
                end
            end
        end
    end
    return uids, awardData
end

