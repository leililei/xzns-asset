---刷新邮件显示
---@param count tonumber 刷新邮件的数量
function MailView:RefreshAllMails(count)
    if count == nil then
        self.go_table.aorlooplist_MailList:RefreshAllShowItem()
    else
        self.go_table.aorlooplist_MailList:RefreshAllShowItem(count)
    end
end

function MailView:RemoveMail(uid)
    for k, v in pairs(self.mails) do
        if type(v) == "table" then
            if v.uid == uid then
                _G.table.remove(self.mails, k)
                break
            end
        end
    end
    if #(self.mails) <= 0 then
        self:DisplayMail(false)
        self.curItem = nil
        self.curMail = nil
        self.go_table.aorlooplist_MailList:RefreshAllShowItem(0)
        return
    end
    if uid == self.curMail.uid then
        self.curItem = nil
        self.curMail = nil
    end
    self:RefreshAllMails(#(self.mails))
    self:ShowGetAllBtn()
end

-- 一键删除已读带附件的邮件
function MailView:DelAllReadMail()
    if not self.canDel then
        _G.PopWindowManager:GetInstance():ShowAllTips(330102) --当前没有可删除
        return
    end
    _G.PopWindowManager:GetInstance():ShowAllTips(
        330301,
        nil,
        function()
            require("MailModel"):GetInstance():DelAllMails(_G.handler(self, self.DelAllReadMailCall))
        end
    )
end

---一键删除邮件回调
---@param data mail.s2c_get_mails 删除所有已读邮件后的邮件数据
function MailView:DelAllReadMailCall(data)
    self.mails = data

    local isHave = false
    for _, v in pairs(self.mails) do
        if (not v.annex) or (v.annex and v.state < 2) then
            isHave = true
            break
        end
    end
    if isHave then
        self.curItem = nil
        self.curMail = nil
    else
        self:DisplayMail(false)
        self.curItem = nil
        self.curMail = nil
    end
    self.go_table.aorlooplist_MailList:RefreshAllShowItem(#self.mails)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.MailList.id)
    self:ShowGetAllBtn()
end

---更新邮件数据并刷新界面
---@param data s2c_get_mails 所有邮件的数据
function MailView:SetMailsRefresh()
    self.mails = require "MailModel":GetInstance().data
    if self.go_table.obj_NoMail:GetActiveSelf() == 1 then
        self:DisplayMail(true)
    end
    self:RefreshAllMails(#self.mails)
    self:ShowGetAllBtn()
end

---更新邮件数据
------@param data mail.s2c_get_mails 所有邮件的数据
function MailView:SetMailsData(data)
    self.mails = data
end

---按钮点击事件在这里派发
function MailView:OnClickBtn(go, isOn)
    local name = go:GetName()
    -- _G.AudioManager.PlayAudioByAudioCfgID(_G.AudioClipTypeEnum.clickAuido)
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn)
    else
        if _G.AppSetting.DEBUG then
            _G.Log("MailView", "<color=red>" .. "方法不存在" .. "</color>")
        end
    end
end

