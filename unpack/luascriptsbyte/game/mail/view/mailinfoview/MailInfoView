---@class MailInfoView : UIBaseView    中文描述
---@field public go_table MailInfoView_GoTable GoTable
local MailInfoView = _G.BaseClass("MailInfoView", _G.UIBaseView)

local tonumber = _G.tonumber
local string = _G.string

function MailInfoView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.AffixItems = {}
end

---界面的入口函数
function MailInfoView:OnCreate(mailData, closeCallBack)
    self.mailData = mailData
    self.closeCallBack = closeCallBack
    self:UpdateDealMailPanel()
end

function MailInfoView:UpdateDealMailPanel()
    if not self.mailData or not self.mailData.content or not self.mailData.content.mail then
        return
    end
    local data = self.mailData.content.mail
    if not self.scrollViewRect then
        self.scrollViewRect = self.go_table.obj_scrollView:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    end
    self.go_table.aortext_title.text = self:GetTitle()
    local text = self.go_table.obj_desc:GetComponentE(_G.typeof(_G.CS.ExtendText))
    text.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))
    text.text = self:GetDesc(data.content)
    self.go_table.aortext_time.text = string.format(
        _G.LangUtil.GetLangPackValue(90022400004),
        require("MailModel"):GetInstance():GetValidityTime(self.mailData.etime)
    )
    self.go_table.aortext_sendTime.text = _G.TimeUtil.date("%Y.%m.%d")
    if string.IsNullOrEmpty(self:GetSender()) then
        self.go_table.aortext_sender.text = ""
    else
        self.go_table.aortext_sender.text = string.format(_G.LangUtil.GetLangPackValue(90022400006), self:GetSender())
    end
    --显示附件
    local x = self.scrollViewRect:GetRectTransformSizeDelta()
    if self.mailData.annex then
        self.go_table.obj_Awards:SetActiveE(1)
        self:ParseAward(data.award)
        if not self.isInitAward then
            self.isInitAward = true
            self.go_table.scrollloophorizontal_AwardList:InitItemData(
                #self.AffixData,
                _G.handler(self, self.RefreshAffix)
            )
        else
            self.go_table.scrollloophorizontal_AwardList:UpdateCount(#self.AffixData)
        end
        self.go_table.aorbtn_btnGet:SetActiveE(self.mailData.state ~= 2 and 1 or 0)
        self.go_table.aorbtn_btnDelete:SetActiveE(self.mailData.state == 2 and 1 or 0)
        self.scrollViewRect:SetRectTransformSize(x, 308)
        self.go_table.aortext_sender:SetLocalPosition(137, -58, 0)
        self.go_table.aortext_time:SetLocalPosition(186, -100, 0)
    else
        self.go_table.obj_Awards:SetActiveE(0)
        self.go_table.aorbtn_btnGet:SetActiveE(0)
        self.go_table.aorbtn_btnDelete:SetActiveE(1)
        self.scrollViewRect:SetRectTransformSize(x, 405)
        self.go_table.aortext_sender:SetLocalPosition(137, -165, 0)
        self.go_table.aortext_time:SetLocalPosition(186, -220, 0)
    end
end

--获取标题
function MailInfoView:GetTitle()
    if self.mailData.theme[1] == "0" then
        return self.mailData.theme[2]
    else
        return _G.LangUtil.GetLangPackValue(_G.ConfigManager.mail_cfg[tonumber(self.mailData.theme[1])].name)
    end
end

---获取正文
---@param data mail.i_mail_content
---@return string 正文内容
function MailInfoView:GetDesc(data)
    if data[1] == "0" then
        -- return _G.CS.System.Text.RegularExpressions.Regex.Unescape(data[2])
        return _G.string.regexUnescape(data[2])
    elseif data[1] == "277" then
        return self:GetSociatyMobaGuessDesc(data)
        --elseif data[1] == "278" or data[1] == "279" then
        --    return self:GetActivityDispatchDesc(data)
        -- elseif data[1] == "310" then
        --     return self:GetArenaGlobalDesc(data)
    elseif data[1] == "314" then
        return self:GetGoldCardStr(data)
    elseif data[1] == "323" then
        return self:GetLimitedDropStr(data)
    elseif data[1] == "335" then
        return self:GetVoucherDiscountStr(data)
    elseif data[1] == "334" then
        return self:GetGMArenaPeakStr(data)
    elseif data[1] == "1050" then
        return self:GetTitleMail(data)
    elseif data[1] == "1051" then
        local cfg = _G.ConfigManager.mail_cfg[tonumber(data[1])]
        local str = _G.LangUtil.GetLangPackValue(cfg.desc, data[2] or "???")
        return str
    else
        local cfg = _G.ConfigManager.mail_cfg[tonumber(data[1])]
        local isEmptyOrNil = _G.string.IsNullOrEmpty
        local str = _G.LangUtil.GetLangPackValue(self:CheckVoucherDesc(cfg.desc))
        local tb
        local tempCfg
        for i = 2, #data do
            tb = cfg.table[i - 1] or {}
            if isEmptyOrNil(tb[1]) then
                str = string.gsub(str, "%%s", data[i], 1)
            else
                tempCfg = _G.ConfigManager[tb[1]][_G.tonumber(data[i])]
                if tempCfg then
                    str = string.gsub(str, "%%s", _G.GetLangPackValue(tempCfg[tb[2]]), 1)
                end
            end
        end
        return str
    end
end

function MailInfoView:GetGoldCardStr(data)
    local cfg = _G.ConfigManager.mail_cfg[tonumber(data[1])]
    local itemCfg = _G.ConfigManager.item_cfg[tonumber(data[2])]
    local num = tonumber(data[3])
    local money = num % 100 ~= 0 and (num / 100) or math.floor(num / 100)
    return _G.GetLangPackValue(self:CheckVoucherDesc(cfg.desc), _G.GetLangPackValue(itemCfg.Name), money, data[4])
end

function MailInfoView:GetLimitedDropStr(data)
    local cfg = _G.ConfigManager.mail_cfg[tonumber(data[1])]
    local name = _G.StorageManager:GetInstance():GetItemName(tonumber(data[2])) .. "X" .. tonumber(data[3])
    if data[4] then
        for i = 4, #data, 2 do
            name = name .. "、" .. _G.StorageManager:GetInstance():GetItemName(tonumber(data[i])) .. "X" .. tonumber(data[i + 1])
        end
    end
    return _G.GetLangPackValue(self:CheckVoucherDesc(cfg.desc), name)
end

function MailInfoView:GetGMArenaPeakStr(data)
    local cfg = _G.ConfigManager.mail_cfg[tonumber(data[1])]
    local name = _G.GetLangPackValue(_G.ConfigManager.arena_peak_league_cfg[tonumber(data[2])].name) 
    return _G.GetLangPackValue(self:CheckVoucherDesc(cfg.desc), name)
end

function MailInfoView:GetTitleMail(data)
    local cfg = _G.ConfigManager.mail_cfg[tonumber(data[1])]
    local name = _G.GetLangPackValue(_G.ConfigManager.player_title_effect_cfg[tonumber(data[2])].name)
    return _G.GetLangPackValue(cfg.desc, name)
end

function MailInfoView:GetVoucherDiscountStr(data)
    local cfg = _G.ConfigManager.mail_cfg[tonumber(data[1])]
    local name = _G.StorageManager:GetInstance():GetItemName(tonumber(data[2]))
    local time
    if data[3] then
        local t = _G.TimeUtil.GetDateTime(tonumber(data[3]))
        time = _G.TimeUtil.TransTimeYMD(tonumber(data[3])) .. "  " .. _G.string.format("%02d:%02d:%02d", t.hour, t.minute, t.second)
    end
    return _G.GetLangPackValue(self:CheckVoucherDesc(cfg.desc), name, time)
end

---@return string 发送者
function MailInfoView:GetSender()
    if self.mailData.sender[1] == "0" then
        return self.mailData.sender[2]
    else
        if _G.ConfigManager.mail_cfg[tonumber(self.mailData.sender[1])].sender == 0 then
            return ""
        end
        return _G.LangUtil.GetLangPackValue(_G.ConfigManager.mail_cfg[tonumber(self.mailData.sender[1])].sender)
    end
end

---刷新附件
---@param trans Transform 附件的tansfom
---@param index tonumber 附件的下标
function MailInfoView:RefreshAffix(index, obj)
    if index < 0 then
        return
    end
    index = index + 1
    local data = self.AffixData[index]
    local instance = obj:GetInstanceIDE()
    if self.AffixItems[instance] == nil then
        self.AffixItems[instance] = require("BaseAwardNewItem").New(obj, nil, 88)
    end
    self.AffixItems[instance]:Show(data, function(item)
        if item.item.SetGradeNew then
            item.item:SetGradeNew(false)
        end
    end)
    _G.GameUtil.SetActiveByCondition(self.AffixItems[instance].go_table.aorrawimage_gou, self.mailData.state == 2)
end

--解析奖励
---@param data award.i_award_item 奖励数据
function MailInfoView:ParseAward(data)
    self.AffixData = {}
    for i = 1, #data do
        local sid, count, extend = data[i].type[1], data[i].type[2], data[i].type[3]
        if sid == 0 and #data[i].type >= 5 then
            sid = data[i].type[4]
            count = data[i].type[5]
            extend = data[i].type
        end
        local data2 = { sid = sid, count = count, extend = extend }
        local type = _G.StorageManager:GetInstance():CheckSidType(data2.sid)
        if type == _G.StorageType.Card or type == _G.StorageType.Equipment or type == _G.StorageType.Decoration then
            for i = 1, data2.count do
                local itemData = _G.StorageManager:GetInstance():GetItemDataClass(data2.sid, 0, data2.extend)
                _G.table.insert(self.AffixData, itemData)
            end
        else
            local itemData = _G.StorageManager:GetInstance():GetItemDataClass(data2.sid, data2.count)
            _G.table.insert(self.AffixData, itemData)
        end
    end
end

---获取可以领取的邮件uid
function MailInfoView:GetAwardUids(datas)
    local uids = {}
    local awardData = {}
    local count = #datas
    for i = 1, count do
        if datas[i].annex and datas[i].state < 2 then
            local tb = {}
            for j = 1, #datas[i].annex do
                local data = datas[i].annex[j].type
                local sid, num = data[1], data[2]
                if sid == 0 and #data >= 5 then
                    sid = data[4]
                    num = data[5]
                end
                local _, ID = _G.StorageManager:GetInstance():CheckSidType(sid)
                if ID == _G.StorageID.Equipment then
                    if data[3] and not data[4] then
                        if
                        not _G.StorageManager:GetInstance():GetItemDataByID(
                            _G.StorageID.Equipment,
                            sid * 10 + data[3]
                        )
                        then
                            if awardData[sid] then
                                awardData[sid] = num + awardData[sid]
                            else
                                awardData[sid] = num
                            end
                        end
                    else
                        local cfg = _G.ConfigManager.equipment_cfg[sid]
                        if cfg and cfg.addition > 0 then
                            if awardData[sid] then
                                awardData[sid] = num + awardData[sid]
                            else
                                awardData[sid] = num
                            end
                        end
                    end
                else
                    if awardData[sid] then
                        awardData[sid] = num + awardData[sid]
                    else
                        awardData[sid] = num
                    end
                end
                if awardData[sid] then
                    tb[#tb + 1] = { sid, awardData[sid] }
                end
            end
            if _G.table.isEmptyOrNil(awardData) or _G.StorageManager:GetInstance():IsCheckAddGetItem(tb) then
                _G.table.insert(uids, datas[i].uid)
            else
                for j = 1, #tb do
                    if awardData[datas[i].annex[j].type[1]] then
                        awardData[datas[i].annex[j].type[1]] = awardData[datas[i].annex[j].type[1]] - tb[j][2]
                        if awardData[datas[i].annex[j].type[1]] == 0 then
                            awardData[datas[i].annex[j].type[1]] = nil
                        end
                    end
                end
            end
        end
    end
    return uids, awardData
end

--接收附件
function MailInfoView:ReceiveAward()
    local uids = self:GetAwardUids({ self.mailData })
    if #uids > 0 then
        require("MailModel"):GetInstance():GetAllAffix(uids, _G.handler(self, self.ReceiveAwardSuccess))
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(380104)
    end
end

--接收附件成功
---@param msg mail.s2c_mail 邮件的数据
function MailInfoView:ReceiveAwardSuccess(msg)
    if msg.ack ~= 1 then
        return
    end
    self.mailData.state = 2
    require "RedPointManager":GetInstance():RefreshNode(
        _G.ConfigManager.redpoint_cfg.MailList.id,
        tonumber(self.mailData.uid)
    )
    UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
    if self.closeCallBack then
        self.closeCallBack()
    end
    self:Close()
end

---删除邮件
function MailInfoView:DelMail()
    require("MailModel"):GetInstance():DelMail(self.mailData.uid, _G.handler(self, self.DelMailCall))
end

---删除邮件回调
---@param msg mail.mail.s2c_mail 删除邮件是否成功
function MailInfoView:DelMailCall(msg)
    if msg.ack ~= 1 then
        return
    end
    _G.Events:GetInstance():Broadcast(_G.eMail.ExpireMail, self.mailData.uid)
    self:Close()
end

function MailInfoView:GetSociatyMobaGuessDesc(data)
    local cfg, res, resLanId
    local num = #data
    local content = ""
    for i = 4, num do
        if i % 2 == 0 then
            cfg = _G.ConfigManager.guild_moba_guess_cfg[_G.tonumber(data[i])]
            res = data[i + 1]
            if res == "1" then
                resLanId = 90011870003
            elseif res == "2" then
                resLanId = 90011870004
            else
                resLanId = 90011870005
            end
            content = content .. _G.GetLangPackValue(resLanId, _G.GetLangPackValue(cfg.desc[1]) .. _G.GetLangPackValue(cfg.desc[2]))
            if i ~= num - 1 then
                content = content .. "\n"
            end
        end
    end
    local mailCfg = _G.ConfigManager.mail_cfg[tonumber(data[1])]
    return _G.GetLangPackValue(self:CheckVoucherDesc(mailCfg.desc), data[2], data[3], content)
end

function MailInfoView:GetActivityDispatchDesc(data)
    local cfg = _G.ConfigManager.mail_cfg[tonumber(data[1])]
    local str
    local ActivityDispatchModel = require "ActivityDispatchModel"
    if data[1] == "278" then
        str = _G.GetLangPackValue(self:CheckVoucherDesc(cfg.desc), ActivityDispatchModel:GetInstance():GetCampName(tonumber(data[2])), ActivityDispatchModel:GetInstance():GetWinName(tonumber(data[3])))
    elseif data[1] == "279" then
        str = _G.GetLangPackValue(self:CheckVoucherDesc(cfg.desc), ActivityDispatchModel:GetInstance():GetCampName(tonumber(data[2])), data[3])
    end
    return str
end

function MailInfoView:GetArenaGlobalDesc(data)
    local cfg = _G.ConfigManager.mail_cfg[tonumber(data[1])]
    local aCfg = _G.ConfigManager.arena_global_league_cfg[_G.tonumber(data[2])]
    if aCfg then
        return _G.GetLangPackValue(self:CheckVoucherDesc(cfg.desc), _G.GetLangPackValue(aCfg.name))
    end
    return _G.GetLangPackValue(self:CheckVoucherDesc(cfg.desc))
end

function MailInfoView:CheckVoucherDesc(desc)
    if desc == 90100000184 then
        return _G.GameUtil.GetVoucherArg(desc, 90036300039)
    elseif desc == 90034400002 then
        return _G.GameUtil.GetVoucherArg(desc, 90036300041)
    end
    return desc
end

function MailInfoView:OnHrefClick(url, text, _)
    _G.GameUtil.OpenUrl(url)
end

---界面的销毁函数
function MailInfoView:OnDestroy()
end

---按钮点击事件在这里派发
function MailInfoView:OnClickBtn(go)
    if self.go_table.aorbtn_CloseView == go or go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_btnGet then
        self:ReceiveAward()
    elseif go == self.go_table.aorbtn_btnDelete then
        self:DelMail()
    end
end

return MailInfoView
