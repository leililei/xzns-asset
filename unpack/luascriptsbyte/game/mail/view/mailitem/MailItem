---@class MailItem  邮件
---@field  toggle Toggle 自身的toggle
---@field data mail.i_mail_brief 邮件的数据
local MailItem = _G.BaseClass("MailItem")

function MailItem:Awake()
    _G.AddViewBtnClick(self.gameObject, _G.handler(self, self.OnClickBtn))
    self.toggle = self.gameObject:GetComponentE(typeof(CS.UnityEngine.UI.Toggle))
end

---类的构造函数
---@param go any
---@param callback any
function MailItem:__init()
end

---@param data mail.i_mail_brief 邮件的数据
function MailItem:UpdateData(data)
    if data == nil then
        if self.gameObject:GetActiveSelf() == 1 then
            self.gameObject:SetActiveE(0)
        end
        return
    end
    self.data = data
    self:UpdateShow()
end

--更新邮件的显示
function MailItem:UpdateShow()
    self.go_table.aortext_time.text = require("MailModel"):GetInstance():GetSendTime(self.data.stime)
    self.go_table.aortext_title.text = self:GetTitle()
    self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(
        _G.ConfigManager.redpoint_cfg.MailList.id,
        tonumber(self.data.uid)
    )
    self:ShowReadOrAffix()
end

function MailItem:ShowAward()
    if not _G.table.isEmptyOrNil(self.data.annex) then
        self.go_table.obj_award:SetActiveE(1)
        local data = self.data.annex[1].type
        if not self.arawdItem then
            self.arawdItem = require("BaseAwardNewItem").New(self.go_table.obj_root, nil, 88)
        end
        local itemData
        if data[1] == 0 then
            itemData = _G.StorageManager:GetInstance():GetItemDataClass(data[4], data[5])
        else
            itemData = _G.StorageManager:GetInstance():GetItemDataClass(data[1], data[2])
        end
        self.arawdItem:Show(itemData, function(item)
            if item.item.SetGradeNew then
                item.item:SetGradeNew(false)
            end
        end)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_gou, self.data.state == 2)
    else
        self.go_table.obj_award:SetActiveE(0)
    end
end

---获取邮件的标题
function MailItem:GetTitle()
    if self.data.theme[1] == "0" then
        return self:ChangeTitle(self.data.theme[2])
    else
        if _G.ConfigManager.mail_cfg[tonumber(self.data.theme[1])] then
            return self:ChangeTitle(
                _G.LangUtil.GetLangPackValue(_G.ConfigManager.mail_cfg[tonumber(self.data.theme[1])].name)
            )
        end
        return ""
    end
end

---是否显示省略号
function MailItem:ChangeTitle(title)
    local count = _G.string.getStringCharCount(title)
    if count > 6 then
        return _G.string.filterStringWithCharacterLimit(title, 12) .. "..."
    else
        return title
    end
end

--点击选中
---@param msg mail.s2c_mail 邮件的相关数据
function MailItem:ChooseSelf(msg)
    local read = false

    if msg ~= nil then
        if msg.ack ~= 1 then
            return
        end
        if self.data.annex == nil then
            self.data.state = 1
        end

        self:ShowReadOrAffix()
        self.data.content = {
            ["mail"] = msg.mail,
            ["award"] = msg.award
        }
        if self.data.annex == nil then
            read = true
        end
        require "RedPointManager":GetInstance():RefreshNode(
            _G.ConfigManager.redpoint_cfg.MailList.id,
            tonumber(self.data.uid)
        )
    end
    self:OpenMailDetailView()
    if self.clickFunction then
        self.clickFunction(self, read)
    end
end

---显示已读或者附件标志
function MailItem:ShowReadOrAffix()
    local isRead = nil
    if self.data.state == 0 then
        isRead = false
    elseif self.data.state == 1 then
        isRead = self.data.annex == nil
    else
        isRead = true
    end
    self.go_table.obj_isRead:SetActiveE(isRead and 1 or 0)
    self.go_table.obj_high:SetActiveE(isRead and 0 or 1)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_icon, not isRead)
    self:ShowAward()
    if self.GetFunction then
        self.GetFunction()
    end
end

---类的析构函数
function MailItem:Dispose()
end

function MailItem:OnClickBtn(go, isOn)
    _G.AudioManager.PlayAudioByAudioCfgID(_G.AudioClipTypeEnum.ListUnflodAuido)
    if not isOn then
        return
    end
    self:OnClick()
end

---点击
function MailItem:OnClick()
    if self.data.content == nil then
        require("MailModel"):GetInstance():ReadMail(self.data.uid, _G.handler(self, self.ChooseSelf))
    else
        self:ChooseSelf()
    end
end

---邮件详情弹窗界面
function MailItem:OpenMailDetailView()
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.MailInfoView.Name,
        self.data,
        function()
            self:ShowReadOrAffix()
            if self.OnGetCallBack then
               self.OnGetCallBack() 
            end
        end
    )
end

--创建实例
function MailItem.Create(trans, callback, getCallBack, OnGetCallBack)
    local item = MailItem.New()
    item.transform = trans
    item.gameObject = trans
    item.go_table = _G.GetAutoGoTable(item.gameObject)
    item.clickFunction = callback
    item.GetFunction = getCallBack
    item.OnGetCallBack = OnGetCallBack
    item:Awake()
    return item
end

return MailItem
