---@class MailNet : BaseGameNet	中文描述
local MailNet = _G.BaseClass("MailNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return MailNet MailNet
function MailNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---获取邮件数据
---@param callback function 完成回调
function MailNet:GetMails(callback)
    local item = _G.ConfigManager.net_map.game_mail_get_mails
    local pbData = self:GetEmptyPB()
    local port = base.Access(self, item, pbData, _G.handler(self, self.GetMailsCall))
    self.Call[port] = callback
end

---获取邮件回调
---@param port number 中文描述
---@param data mainl.mail.s2c_mail 返回PB数据
---@param error string 错误信息
function MailNet:GetMailsCall(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

