local base = require "BaseItemData"

---@class RemainsData:BaseItemData    中文描述
---@field cfg remains_cfg
---@field active boolean 是否激活
---@field star number 星级
local RemainsData = _G.BaseClass("RemainsData", base)

function RemainsData:ParseInitMsg(msg)
    self.sid = msg.sid
    self.level = msg.level
    self.cfg = _G.ConfigManager.remains_cfg[self.sid]
    self.LevelCfg = _G.ConfigManager.remains_level_cfg
    ---数据兼容
    self.Grade = self.cfg.grade or self.cfg.Grade
    self.active = false
    self.star = 0
    self.taskCur = msg.curr or 0
end

---类的构造函数
function RemainsData:__init()
    self.active = false
    self.star = 0
    self.level = 1
    self.taskCur = 0
end

function RemainsData:InitCfg(sid)
    self.sid = sid
    self.cfg = _G.ConfigManager.remains_cfg[self.sid]
    self.LevelCfg = _G.ConfigManager.remains_level_cfg
end

---数据解析
---@param msg spoils.i_spoils 数据
function RemainsData:Parse(msg)
    self.active = true
    self.star = msg.star or 0
    self.level = msg.level or 1
    self.sid = msg.sid
    self.cfg = _G.ConfigManager.remains_cfg[self.sid]
    self.LevelCfg = _G.ConfigManager.remains_level_cfg
    self.taskCur = msg.curr or 0
    -- self:UpdateAttribute()
end

---更新属性
function RemainsData:UpdateAttribute()
    self.attribute = _G.AttributeClassManager:GetInstance():GetAttribtueClass()
    self.attribute:OnInit(nil, _G.PowerType.equipment)
    self:GetAttribute(self.attribute)
    self:CalculatePower()
end

-----计算战力
---@param item EquipmentItem 装备item
function RemainsData:CalculatePower()
    self.power = self.attribute:CalculatePower()
end
function RemainsData:GetPower()
    if not self.power or self.power == 0 then
        self:UpdateAttribute()
        self.power = self.attribute:CalculatePower()
    end
    return self.power
end

