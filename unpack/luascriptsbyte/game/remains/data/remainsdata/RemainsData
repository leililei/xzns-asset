---获取基础属性
-- 遗物最终被动属性=遗物被动属性（remains_cfg表中att2字段）*遗物等级参数（remains_level_cfg表中rate字段（万进制））*遗物星级参数（remains_cfg表中rate字段（万进制））
-- 遗物最终基础属性=遗物基础属性（remains_cfg表中att1字段）*遗物星级参数（remains_cfg表中rate字段（万进制））
-- 遗物四维全属性=（遗物基础属性+遗物羁绊属性）*卡牌基础属性+遗物被动属性
-- 遗物非四维全属性=遗物基础属性+遗物羁绊属性
-- 基础属性和羁绊属性都是百分比属性，被动属性是四维具体值
---@return table 属性

---基础属性
function RemainsData:GetAttribute()
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local attribute = AttributeClassManager:GetAttribtueClass()
    local attr = self.cfg.att1

    local rateNum = self.cfg.rate[self:GetStar() ~= 0 and self:GetStar() + 1 or 1] or 10000
    local rate = rateNum / 10000
    if self:GetIsActive() then
        attribute = self:UpdateAttribute2(AttributeClassManager, attribute, attr, rate)
    end

    attr = self.cfg.att2
    rateNum = self.cfg.rate[self:GetStar() ~= 0 and self:GetStar() + 1 or 1] or 10000
    rate = rateNum / 10000
    local rate2 = self:GetLevelCfg().rate / 10000
    local rate3 = self:GetTaskCur()
    if self:GetIsActive() then
        attribute = self:UpdateAttribute2(AttributeClassManager, attribute, attr, rate * rate2 * rate3)
    end

    local changeAttrTypes = AttributeClassManager:GetChangeAttrTypes(attribute)
    self.attribute = attribute
    self.changeAttrTypes = changeAttrTypes
    return attribute, changeAttrTypes
end

--- 基础和被动属性参与星级和等级的万分比计算
function RemainsData:UpdateAttribute2(attributeManager, attribute, attData, rate)
    for _, v in pairs(attData) do
        local type = v[2] == "2" and _G.AttCountType.basePercent or _G.AttCountType.other
        attribute:AddValueByName(v[1], attributeManager:GetValueWithName(v[1], tonumber(v[3]) * rate, v[2]), false, type)
    end
    return attribute
end

