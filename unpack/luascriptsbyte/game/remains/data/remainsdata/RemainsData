---是否可激活
function RemainsData:IsCanActive()
    if self.active then
        return false
    end
    local hasNum = _G.StorageManager:GetInstance():GetItemCountBySid(self.cfg.materials[1][1])
    local needNum = self.cfg.materials[self.star + 1][2]

    ---没有激活并且材料够用
    if hasNum >= needNum then
        return true
    end
    return false
end

---是否可升星
function RemainsData:IsCanStarUp()
    if not self.active then
        return false
    end
    if not self:IsMaxStar() then
        local hasNum = _G.StorageManager:GetInstance():GetItemCountBySid(self.cfg.materials[self.star + 2][1])
        local needNum = self.cfg.materials[self.star + 2][2]

        ---激活了还没有满星并且材料也够用
        if not self:IsMaxStar() then
            if hasNum >= needNum then
                return true
            end
        end
    end
    return false
end

---是否可升级
function RemainsData:IsCanLevelUp()
    if not self.active then
        return false
    end
    if self:IsMaxLevel() then
        return false
    end

    local LevelCurCfg = {{0, 0}, {0, 0}}
    local LevelNextCfg

    if self.cfg.grade == _G.RemainsQuilty.zi then
        if self.level ~= 1 then
            LevelCurCfg = self.LevelCfg[self.level].material4
        end
        LevelNextCfg = self.LevelCfg[self.level + 1].material4
    elseif self.cfg.grade == _G.RemainsQuilty.cheng then
        if self.level ~= 1 then
            LevelCurCfg = self.LevelCfg[self.level].material5
        end
        LevelNextCfg = self.LevelCfg[self.level + 1].material5
    elseif self.cfg.grade == _G.RemainsQuilty.hong then
        if self.level ~= 1 then
            LevelCurCfg = self.LevelCfg[self.level].material6
        end
        LevelNextCfg = self.LevelCfg[self.level + 1].material6
    elseif self.cfg.grade == _G.RemainsQuilty.cai then
        if self.level ~= 1 then
            LevelCurCfg = self.LevelCfg[self.level].material8
        end
        LevelNextCfg = self.LevelCfg[self.level + 1].material8
    end
    -- local Check1 = _G.StorageManager:GetInstance():GetItemCountBySid(LevelNextCfg[1][1],
    --     LevelNextCfg[1][2] - LevelCurCfg[1][2])
    -- local Check2 = _G.StorageManager:GetInstance():CheckItem(LevelNextCfg[2][1], LevelNextCfg[2][2] - LevelCurCfg[2][2])

    local Check = true
    for k, v in pairs(LevelNextCfg) do
        if not _G.StorageManager:GetInstance():CheckItem(v[1], v[2] - LevelCurCfg[k][2]) then
            Check = false
        end
    end
    return Check
end

---升级消耗
function RemainsData:LevelUpMaterial(curLevel, nextLevel)
    local LevelCurCfg = {{0, 0}, {0, 0}}
    local LevelNextCfg

    local levelNum = curLevel or self.level
    local levelNum2 = nextLevel or (self.level + 1)
    if self.cfg.grade == _G.RemainsQuilty.zi then
        if levelNum ~= 1 then
            LevelCurCfg = self.LevelCfg[levelNum].material4
        end
        LevelNextCfg = self.LevelCfg[levelNum2].material4
    elseif self.cfg.grade == _G.RemainsQuilty.cheng then
        if levelNum ~= 1 then
            LevelCurCfg = self.LevelCfg[levelNum].material5
        end
        LevelNextCfg = self.LevelCfg[levelNum2].material5
    elseif self.cfg.grade == _G.RemainsQuilty.hong then
        if levelNum ~= 1 then
            LevelCurCfg = self.LevelCfg[levelNum].material6
        end
        LevelNextCfg = self.LevelCfg[levelNum2].material6
    elseif self.cfg.grade == _G.RemainsQuilty.cai then
        if levelNum ~= 1 then
            LevelCurCfg = self.LevelCfg[levelNum].material8
        end
        LevelNextCfg = self.LevelCfg[levelNum2].material8
    end
    return LevelNextCfg, LevelCurCfg
end

--- 找到下一个可以升到的最高等级阶段(方法只在可以升级的时候调用)
function RemainsData:GetCanLevelUpMax()
    --- 下一个阶段等级 就是当前等级到下一个十级区间（23级 下一个阶段就是30）
    local levelNext = math.floor(self.level / 10) * 10 + 10
    if levelNext > self:GetMaxLevel() then
        levelNext = self:GetMaxLevel()
    end
    local endLevel = self.level

    --- 从当前等级开始找 可不可以升级
    for i = 1, levelNext - self.level do
        local LevelNextCfg, LevelCurCfg = self:LevelUpMaterial(self.level, endLevel + 1)
        local Check = true
        for k, v in pairs(LevelNextCfg) do
            if not _G.StorageManager:GetInstance():CheckItem(v[1], v[2] - LevelCurCfg[k][2]) then
                Check = false
            end
        end
        if Check then
            endLevel = endLevel + 1
        end
    end
    return endLevel
end

---是否已满星
function RemainsData:IsMaxStar()
    return self:GetStar() == self.cfg.star
end

--- 当前升星材料数量
function RemainsData:GetStarUpCurHave()
    if self:GetIsActive() then
        return _G.StorageManager:GetInstance():GetItemCountBySid(self.cfg.materials[self:GetStar() + 2][1])

    else
        return _G.StorageManager:GetInstance():GetItemCountBySid(self.cfg.materials[self:GetStar() + 1][1])
    end
end

--- 当前升星材料需求数量
function RemainsData:GetStarUpCost()
    if self:GetIsActive() then
        return self.cfg.materials[self:GetStar() + 2][2]
    else
        return self.cfg.materials[self:GetStar() + 1][2]
    end
end

---获取等级属性描述
function RemainsData:GetLevelProp()
    local prop = self.cfg.att2[1]
    local str = _G.AttrType[prop[1]].des
    local number = tonumber(prop[3]) * self.cfg.rate[self:GetStar() + 1] / 10000 *
                       self.LevelCfg[self:GetLevel() + 1].rate / 10000
    -- if #self.cfg.mission > 0 then
    --     number = number * self.taskCur / self.cfg.mission[1][2]
    -- end
    return "+" .. _G.Mathf.RoundToInt(number)
end

---获取等级属性描述
function RemainsData:GetLevelProp2()
    local prop = self.cfg.att2[1]
    local str = _G.AttrType[prop[1]].des
    local number = tonumber(prop[3]) * self.cfg.rate[self:GetStar() + 1] / 10000 * self.LevelCfg[self:GetLevel()].rate /
                       10000
    if #self.cfg.mission > 0 then
        number = number * self:GetTaskCur()
    end
    return "+" .. _G.Mathf.RoundToInt(number)
end

---获取满级等级属性描述
function RemainsData:GetLevelMaxProp()
    local prop = self.cfg.att2[1]
    local str = _G.AttrType[prop[1]].des
    local number = tonumber(prop[3]) * self.cfg.rate[self:GetStar() + 1] / 10000 *
                       self.LevelCfg[self:GetMaxLevel()].rate / 10000
    return str .. "+" .. _G.Mathf.RoundToInt(number)
end

---获取等级属性左边描述
function RemainsData:GetLevelLeftDesc()
    local txt = self.cfg.language ~= 0 and _G.GetLangPackValue(self.cfg.language) or ""
    local prop = self.cfg.att2[1]
    local str = _G.AttrType[prop[1]].des
    local number = tonumber(prop[3]) * self.cfg.rate[self:GetStar() + 1] / 10000 * self.LevelCfg[self:GetLevel()].rate /
                       10000
    return txt .. str .. "+" .. _G.Mathf.RoundToInt(number)
end

---是否已满级
function RemainsData:IsMaxLevel()
    return self:GetLevel() == self:GetMaxLevel()
end

---levelCfg
function RemainsData:GetLevelCfg()
    return self.LevelCfg[self:GetLevel()]
end

---满级level
function RemainsData:GetMaxLevel()
    return table.count(self.LevelCfg)
end

---获取等级
---@return number 等级
function RemainsData:GetLevel()
    return self.level
end

