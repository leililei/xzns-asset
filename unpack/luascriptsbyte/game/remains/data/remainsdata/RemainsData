---获取属性字典
---@return table 属性
function RemainsData:GetAttributeDict()
    if not self.active then
        return {
            atk = 0,
            bre = 0,
            def = 0,
            max_hp = 0
        }
    end
    local growth = self.cfg.rate[self.star + 1] / 10000
    local prop = {}

    local growth = self.cfg.rate[self.star + 1] / 10000
    for i = 1, #self.cfg.att1 do
        if self.cfg.att1[i][1] == "atk" then
            prop.atk = _G.Mathf.RoundToInt(self.cfg.att1[i][3] * growth)
        elseif self.cfg.att1[i][1] == "bre" then
            prop.bre = _G.Mathf.RoundToInt(self.cfg.att1[i][3] * growth)
        elseif self.cfg.att1[i][1] == "def" then
            prop.def = _G.Mathf.RoundToInt(self.cfg.att1[i][3] * growth)
        elseif self.cfg.att1[i][1] == "max_hp" then
            prop.max_hp = _G.Mathf.RoundToInt(self.cfg.att1[i][3] * growth)
        end
    end
    return prop
end

