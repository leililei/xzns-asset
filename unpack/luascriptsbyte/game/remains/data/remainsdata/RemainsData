---获取任务进度描述
function RemainsData:GetTaskCurStr()
    return self.taskCur <= self.cfg.mission[1][3] and self.taskCur or self.cfg.mission[1][3]
end

function RemainsData:SetTaskCurStr(num)
    if num <= self.cfg.mission[1][3] then
        self.taskCur = num

    else
        self.taskCur = self.cfg.mission[1][3]
    end
end

