-- region ------------- 增删改 -------------

---合成激活
function RemainsData:DoActive()
    self.active = true
    self.star = 0
    self.level = 1
    self:UpdateAttribute()
end

---升星
function RemainsData:UpStar(star)
    if star then
        self.star = star
    else
        self.star = self.star + 1
    end
    if self.star > self.cfg.star then
        self.star = self.cfg.star
    end
    self:UpdateAttribute()
end

---升级
function RemainsData:UpLevel(level)
    if level then
        self.level = level
    else
        self.level = self.level + 1
    end

    self:UpdateAttribute()
end

