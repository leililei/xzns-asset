---获取所有固定值加成
function RemainsModel:GetAllOtherProp()
    local allProp = {
        atk = 0,
        bre = 0,
        def = 0,
        max_hp = 0
    }
    local prop
    for _, spData in pairs(self.RemainsDatas) do
        prop = spData:GetAttributeDict()
        for k, v in pairs(allProp) do
            allProp[k] = allProp[k] + prop[k]
        end
    end
    return allProp
end

---基础属性(不计算被动)
function RemainsModel:GetAllAttribute()
    if self.attribute ~= nil then
        return self.attribute, self.changeAttrTypes
    end
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local attribute = AttributeClassManager:GetAttribtueClass()
    for _, v in pairs(self.cfg) do
        if v.isdisplay == 1 then
            local attr = v.att1
            local data = self.RemainsDatas[v.id]
            local rateNum = v.rate[data:GetStar() ~= 0 and data:GetStar() + 1 or 1] or 10000
            local rate = rateNum / 10000
            if data:GetIsActive() then
                attribute = self:UpdateAttribute(AttributeClassManager, attribute, attr, rate)
            end
        end
    end
    local changeAttrTypes = AttributeClassManager:GetChangeAttrTypes(attribute)
    self.attribute = attribute
    self.changeAttrTypes = changeAttrTypes
    return attribute, changeAttrTypes
end

---被动属性(不计算基础属性)
function RemainsModel:GetAllAttribute2()
    if self.attribute2 ~= nil then
        return self.attribute2, self.changeAttrTypes2
    end
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local attribute = AttributeClassManager:GetAttribtueClass()
    for _, v in pairs(self.cfg) do
        if v.isdisplay == 1 then
            local attr = v.att2
            local data = self.RemainsDatas[v.id]
            local rateNum = v.rate[data:GetStar() ~= 0 and data:GetStar() + 1 or 1] or 10000
            local rate = rateNum / 10000
            local rate2 = data:GetLevelCfg().rate / 10000
            local rate3 = data:GetTaskCur()
            if data:GetIsActive() then
                attribute = self:UpdateAttribute(AttributeClassManager, attribute, attr, rate * rate2 * rate3)
            end
        end
    end
    local changeAttrTypes = AttributeClassManager:GetChangeAttrTypes(attribute)
    self.attribute2 = attribute
    self.changeAttrTypes2 = changeAttrTypes
    return attribute, changeAttrTypes
end

---图鉴的属性
function RemainsModel:GeFetterAttribute()
    if self.attribute3 ~= nil then
        return self.attribute3, self.changeAttrTypes3
    end
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local attribute = AttributeClassManager:GetAttribtueClass()
    for _, v in pairs(_G.ConfigManager.remains_fetter_cfg) do
        if v.isdisplay == 1 then
            local index = self.fetters[v.id]
            if index and index > 0 then
                local args = {{v.att[index][2], v.att[index][3], v.att[index][4]}}
                attribute = self:UpdateAttributeFetter(AttributeClassManager, attribute, args)
            end
        end
    end

    local changeAttrTypes = AttributeClassManager:GetChangeAttrTypes(attribute)
    self.attribute3 = attribute
    self.changeAttrTypes3 = changeAttrTypes
    return attribute, changeAttrTypes
end

--- 基础和被动属性参与星级和等级的万分比计算
function RemainsModel:UpdateAttribute(attributeManager, attribute, attData, rate)
    for _, v in pairs(attData) do
        local type = v[2] == "2" and _G.AttCountType.basePercent or _G.AttCountType.other
        attribute:AddValueByName(v[1], attributeManager:GetValueWithName(v[1], tonumber(v[3]) * rate, v[2]), false, type)
    end
    return attribute
end

--- 羁绊属性不参与星级和等级的万分比计算
function RemainsModel:UpdateAttributeFetter(attributeManager, attribute, attData, rate)
    for _, v in pairs(attData) do
        local type = v[2] == "2" and _G.AttCountType.basePercent or _G.AttCountType.other
        attribute:AddValueByName(v[1], attributeManager:GetValueWithName(v[1], tonumber(v[3]), v[2]), false, type)
    end
    return attribute
end

---销毁对象时,析构函数
function RemainsModel:Dispose()
    local EventsIns = _G.Events:GetInstance()
    local net_map = _G.ConfigManager.net_map
    EventsIns:RemoveListener(net_map.game_remains_task_curr.Cmd, self.OnTaskCurCall, self)

end

---通过碎片id获取当前id
function RemainsModel:GetIdByPropId(propId)
    return self.RelationShipList[propId]
end

---获取升星进度
function RemainsModel:GetUpStarByPropId(propId)
    local sid = self:GetIdByPropId(propId)
    local spData = self.RemainsDatas[sid]
    if spData:IsMaxStar() then
        return true, 0
    end

    return false, spData:GetUpCostNum()
end

--- 获取大于x品质y数量
function RemainsModel:GetNumByGrade(grade)
    local index = 0
    for k, v in pairs(self.RemainsDatas) do
        if v.cfg.grade >= grade then
            if v:GetIsActive() then
                index = index + 1
            end
        end
    end

    return index
end

return RemainsModel
