---获取羁绊所有属性的描述
function RemainsModel:GetFettersDic()
    local dic = {}
    for k, v in pairs(self.fetters) do
        local cfg = self.suitCfg[k].att[v]
        local isNotHave = true
        for i = 1, #dic do
            if dic[i].name == _G.AttrType[cfg[2]].des and dic[i].percentage == cfg[3] then
                dic[i].value = dic[i].value + cfg[4]
                isNotHave = false
                break
            end

        end
        if isNotHave then
            _G.table.insert(dic, {
                ID = _G.AttrType[cfg[2]].ID,
                name = _G.AttrType[cfg[2]].des,
                value = cfg[4],
                icon = _G.AttrTypeIcon[cfg[2]],
                percentage = cfg[3],
                proptype = _G.AttrType[cfg[2]].proptype
            })
        end
    end
    return dic
end

---获取当前羁绊内可激活的最高阶段
function RemainsModel:GetActiveMaxIndex(sid)
    local curIndex = self:GetFetterIndex(sid)
    if curIndex >= 5 then
        return
    end

    local fetterCfg = _G.ConfigManager.remains_fetter_cfg[sid]
    local maxIndex = nil
    for i = curIndex ~= 0 and curIndex or 1, 5 do
        if self:CanActiveFetter(fetterCfg.remains, tonumber(fetterCfg.att[i][1])) then
            maxIndex = i
        end
    end

    return maxIndex
end

--- 有没有可激活图鉴
function RemainsModel:CheckCanActiveFetter()
    self.fetterConfigs = {}
    local fetterCfg = _G.ConfigManager.remains_fetter_cfg
    for _, v in pairs(fetterCfg) do
        if v.isdisplay == 1 then
            table.insert(self.fetterConfigs, v)
        end
    end
    for _, v in pairs(self.fetterConfigs) do
        local nowIndex = self:GetFetterIndex(v.id)
        if nowIndex < 5 then
            if self:CanActiveFetter(v.remains, tonumber(v.att[nowIndex + 1][1])) then
                return 1
            end
        end
    end
    return 0
end

---当前羁绊是否可升级
function RemainsModel:CanActiveFetter(remains, star)
    for _, id in pairs(remains) do
        local data = self:GetData(id)
        if not data:GetIsActive() then
            return false
        end

        if data:GetStar() < star then
            return false
        end
    end
    return true
end

---当前羁绊激活数量
function RemainsModel:ActiveFetterNum(remains)
    local num = 0
    for _, id in pairs(remains) do
        local data = self:GetData(id)
        if data:GetIsActive() then
            num = num + 1
        end
    end
    return num
end

---激活羁绊
---@param sid number 羁绊sid
---@param index number 羁绊阶段
function RemainsModel:FetterActive(sid, index, call)
    local pbData = {
        suit_sid = sid,
        index = index
    }
    RemainsNet:GetInstance():FetterActive(pbData, function(msg)
        if msg.ack ~= 1 then
            return
        end
        self.attribute3 = nil
        self.fetters[sid] = index
        -- _G.Events:GetInstance():Broadcast(_G.eBuildUpFetter.BuildUpFetterRefresh)
        _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.RemainsFetter)
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.LegendaryRelicSetUp.id)
        if call then
            call()
        end
    end)
end

--- 升星
function RemainsModel:UpStar(sid, star, call)
    local pbData = {
        sid = sid,
        new_star = star
    }
    RemainsNet:GetInstance():UpStar(pbData, function(msg)
        if msg.ack ~= 1 then
            return
        end
        self.attribute = nil
        self.attribute2 = nil
        self.RemainsDatas[sid]:UpStar(star)

        local cfg = _G.ConfigManager.remains_cfg[sid]

        _G.StorageManager:GetInstance():ConsumeItem(cfg.materials[star + 1][1], 0, cfg.materials[star + 1][2] or 0)
        _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.Remains)
        _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.RemainsLevel)
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.LegendaryRelicLevelUp.id)
        _G.Events:GetInstance():Broadcast(_G.eRemainsUpdate.RemainsUpdate)
        if call then
            call()
        end
    end)
end

--- 升级
function RemainsModel:UpLevel(sid, level, call)
    local pbData = {
        sid = sid,
        new_level = level
    }
    RemainsNet:GetInstance():UpLevel(pbData, function(msg)
        if msg.ack ~= 1 then
            return
        end
        self.attribute2 = nil
        local cfg1, cfg2 = self.RemainsDatas[sid]:LevelUpMaterial(nil, level)
        for k, v in pairs(cfg1) do
            _G.StorageManager:GetInstance():ConsumeItem(v[1], 0, v[2] - cfg2[k][2] or 0)
        end
        self.RemainsDatas[sid]:UpLevel(level)
        self.attribute2 = nil
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.LegendaryRelicStarUp.id)
        _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.RemainsLevel)
        _G.Events:GetInstance():Broadcast(_G.eRemainsUpdate.RemainsUpdate)

        if call then
            call()
        end
    end)
end

--- 激活
function RemainsModel:ActiveSelf(sid, call)
    local cfg = _G.ConfigManager.remains_cfg[sid]
    local pbData = {
        sid = sid,
        consume_num = cfg.materials[1][2]
    }
    RemainsNet:GetInstance():ActiveSelf(pbData, function(msg)
        if msg.ack ~= 1 then
            return
        end
        self.attribute = nil
        self.attribute2 = nil
        self.RemainsDatas[sid]:DoActive()
        _G.StorageManager:GetInstance():ConsumeItem(cfg.materials[1][1], 0, cfg.materials[1][2] or 0)
        _G.Events:GetInstance():Broadcast(_G.eRemainsUpdate.RemainsUpdate)
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.LegendaryRelicLevelUp.id, sid)
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.LegendaryRelicStarUp.id)
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.LegendaryRelicSetUp.id)
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.LegendaryTenPull.id)
        _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.Remains)
        _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.RemainsLevel)
        if call then
            call()
        end
    end)
end

---获取数据
---@return RemainsData
function RemainsModel:GetData(sid)
    local sp = self.RemainsDatas[sid]
    if nil == sp then
        if _G.AppSetting.DEBUG then
            _G.LogError(sid, "不存在对应的遗物")
        end
        for sid, _ in pairs(_G.ConfigManager.remains_cfg) do
            sp = RemainsData.New()
            sp:InitCfg(sid)
            break
        end
    end
    return sp
end

