local RemainsNet = require("RemainsNet")
local RemainsData = require("RemainsData")

local base = _G.GameDataModelBase
---@class RemainsModel : GameDataModelBase
---@field RemainsDatas RemainsData[]
local RemainsModel = _G.BaseClass("RemainsModel", base)

---@return RemainsModel RemainsModel
function RemainsModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function RemainsModel:__init()
    local EventsIns = _G.Events:GetInstance()
    local net_map = _G.ConfigManager.net_map
    self.curFunctionOpenID = _G.FunctionID.Remains
    self.cfg = _G.ConfigManager.remains_cfg
    self.suitCfg = _G.ConfigManager.remains_fetter_cfg
    self.fetters = {}
    self.RemainsDatas = {}
    for sid, v in pairs(self.cfg) do
        if v.id > 0 and v.isdisplay == 1 then
            local sp = RemainsData.New()
            sp:InitCfg(v.id)
            self.RemainsDatas[v.id] = sp
        end
    end
    EventsIns:AddListener(net_map.game_remains_task_curr.Cmd, self.OnTaskCurCall, self)

    self.DebrisList = {}
    for _, v in pairs(_G.ConfigManager.item_cfg) do
        if v.Type1 == _G.ItemCfgType.Remains then
            self.DebrisList[v.ID] = v
        end
    end
end

---从服务器拉取数据
function RemainsModel:GetDataFormServer()
    RemainsNet:GetInstance():GetInfo(_G.handler(self, self.ParseData))
end

--- 接收推送
function RemainsModel:OnTaskCurCall(msg)
    for k, v in pairs(msg.task_curr) do
        local sid = v.key
        local taskcur = v.value
        local data = self:GetData(sid)
        data:SetTaskCurStr(taskcur)
        if k == table.count(msg.task_curr) then
            self.attribute = nil
            self.attribute2 = nil
            _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.Remains)
            _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.RemainsLevel)
            _G.Events:GetInstance():Broadcast(_G.eRemainsUpdate.RemainsUpdate)
        end
    end
end

function RemainsModel:ParseData(msg)
    local list = msg.remains_list or {}
    for i = 1, #list do
        ---@type RemainsData
        local sp = self.RemainsDatas[list[i].sid]
        if sp then
            sp:Parse(list[i])
        end
    end
    local suitList = msg.suit_list or {}
    -- for i = 1, #suitList do
    --     local spsuit = self.RemainsSuitDatas[suitList[i].suit_sid]
    --     if spsuit then
    --         spsuit.cards = suitList[i].cards or {}
    --     end
    -- end

    local fetters = msg.suit_list or {}
    self.fetters = {}
    for _, v in pairs(fetters) do
        self.fetters[v.suit_sid] = v.index
    end

    self.attribute = nil
    self.attribute2 = nil
    self.attribute3 = nil
    _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.Remains)
    _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.RemainsLevel)
    _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.RemainsFetter)

    _G.Events:GetInstance():Broadcast(_G.eRemainsUpdate.RemainsInit)

    self.super.ParseData(self)
end

---获取所有的碎片配置
function RemainsModel:GetDebrisCfgs()
    return self.DebrisList
end

---获取羁绊阶段
---@param sid number 羁绊sid
function RemainsModel:GetFetterIndex(sid)
