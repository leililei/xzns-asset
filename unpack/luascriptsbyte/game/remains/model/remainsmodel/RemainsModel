end

---@param sidNumLis table 碎片数组{{sid = 1, num = 1},..}
function RemainsModel:DebrisDecompose(sidNumLis, call)
    local pbData = {
        fragment_list = sidNumLis
    }
    RemainsNet:GetInstance():Decompose(pbData, function(msg)
        if msg.ack ~= 1 then
            return
        end
        for _, v in pairs(sidNumLis) do
            _G.StorageManager:GetInstance():ConsumeItem(v.key, nil, v.value)
        end
        _G.Events:GetInstance():Broadcast(_G.eBuildDecompose.BuildDecomposeRefresh)
        if call then
            call(msg)
        end
    end)
end

---调用立即自动分解
function RemainsModel:AutoDecompose(callback, msg)
    -- --只处理紫丶橙丶红三种品质
    -- local gradeList = _G.ConfigManager.discrete_cfg[126610]
    -- if not gradeList then
    --         callback(msg)
    --     end
    --     return
    -- end

    local DebrisList = {}
    for _, remainData in pairs(self:GetAllDatas()) do
        -- 已合成且满星的灵兽, 才进行分解
        if remainData:IsMaxStar() then
            local data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop,
                remainData.cfg.materials_item)
            if not table.isEmptyOrNil(data) then
                table.insert(DebrisList, {
                    sid = remainData.cfg.materials_item,
                    num = data.count
                })
            end
        end
    end

    if #DebrisList > 0 then
        self:DebrisDecompose(DebrisList, function(msg)
            if not msg or msg.ack ~= 1 then
                if callback then
                    callback(msg)
                end
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            -- 对应材料id
            local gradeCfg = _G.ConfigManager.discrete_cfg[306005]
            if gradeCfg and gradeCfg[1] then
                local firstGradeCfg = _G.ConfigManager.discrete_cfg[gradeCfg[1][2]]
                local itemId = firstGradeCfg[1][1]
                local itemNum = 0
                if msg.award and msg.award.item then
                    for _, v in ipairs(msg.award.item) do
                        if v.type[1] == itemId then
                            itemNum = itemNum + v.type[2]
                        end
                    end
                end
                if itemNum > 0 then
                    -- 显示分解tip
                    _G.PopWindowManager:GetInstance():ShowAllTips(1110201, nil, nil, nil, nil, nil, itemNum)
                end
            end
        end)
    else
        if callback then
            callback(msg)
        end
    end
end

