--- 获取品质总数量
function RemainsModel:GetAllDatasByGrade(grade, isActive)
    local index = 0
    for k, v in pairs(self.RemainsDatas) do
        if v.cfg.grade == grade then
            if isActive then
                if v:GetIsActive() then
                    index = index + 1
                end
            else
                index = index + 1
            end
        end
    end

    return index
end

---主界面列表所有展示数据【包含占位符】
---type == 2 可升星 type == 3 可升级
---@return RemainsData[]
function RemainsModel:GetAllDatasShowList(type)
    local data = self.RemainsDatas
    local SuitDatas = {}
    --- 先把标题栏都设为false 如果对应品质有数据再打开
    local titleArgs = {
        [4] = false,
        [5] = false,
        [6] = false,
        [8] = false
    }

    ---这里存的是该品质道具是否有数据，如果为false，后续要移除标题栏
    local ItemHave = {
        [4] = false,
        [5] = false,
        [6] = false,
        [8] = false
    }

    --- 可升星
    local isNeedCanStarUp = false
    --- 可升级
    local isNeedCanLevelUp = false

    if type == 2 then
        isNeedCanStarUp = true
    elseif type == 3 then
        isNeedCanLevelUp = true
    end

    local list = {}

    for k, v in pairs(data) do
        table.insert(list, v)
    end

    table.sort(list, function(a, b)
        if a.cfg.grade == b.cfg.grade then
            return a.cfg.order > b.cfg.order
        else
            return a.cfg.grade > b.cfg.grade

        end
    end)
    --- 每四个为一组 用来存储的临时数组
    local linshi = {}
    --- 总长度
    local index = 0
    local maxIndex = table.count(list)
    for _, v in pairs(list) do
        index = index + 1
        --- 当titleArgs为false时 说明此标题没有被放入数组
        if titleArgs[v.cfg.grade] == false then
            titleArgs[v.cfg.grade] = true
            --- 此时先判断linshi里面有没有东西 有就放进去
            if table.count(linshi) > 3 then
                table.insert(SuitDatas, linshi)
                linshi = {}
            end
            linshi.order = v.cfg.order
            linshi.type = 1
            linshi.grade = v.cfg.grade
            --- 把标题栏放进去占位
            table.insert(SuitDatas, linshi)
            linshi = {}

        end

        --- 如果临时里面有4个格子了，先放进去，再清空
        if table.count(linshi) >= 7 then
            table.insert(SuitDatas, linshi)
            linshi = {}
            linshi.order = v.cfg.order
            linshi.type = 2
            linshi.grade = v.cfg.grade
            if type == 1 or (isNeedCanStarUp and (v:IsCanStarUp() or v:IsCanActive())) or
                (isNeedCanLevelUp and v:IsCanLevelUp()) then
                table.insert(linshi, {
                    type = 2,
                    sid = v.cfg.id,
                    order = v.cfg.order,
                    grade = v.cfg.grade
                })
            end
            if index == maxIndex and table.count(linshi) >= 4 then
                table.insert(SuitDatas, linshi)
            end
        else
            linshi.order = v.cfg.order
            linshi.type = 2
            linshi.grade = v.cfg.grade
            if type == 1 or (isNeedCanStarUp and (v:IsCanStarUp() or v:IsCanActive())) or
                (isNeedCanLevelUp and v:IsCanLevelUp()) then
                table.insert(linshi, {
                    type = 2,
                    sid = v.cfg.id,
                    order = v.cfg.order,
                    grade = v.cfg.grade
                })
            end
            if index == maxIndex and table.count(linshi) >= 4 then
                table.insert(SuitDatas, linshi)
            end
        end
    end

    local endData = {}
    for i = 1, #SuitDatas do
        if SuitDatas[i].type == 2 then
            ItemHave[SuitDatas[i].grade] = true
        end
    end

    for i = 1, #SuitDatas do
        if SuitDatas[i].type == 1 and ItemHave[SuitDatas[i].grade] then
            table.insert(endData, SuitDatas[i])
        elseif SuitDatas[i].type == 2 then
            table.insert(endData, SuitDatas[i])
        end
    end

    return endData
end

