---抽卡
---@param num number 抽奖次数
---@param consume_type number 消耗类型（1:道具 2:魂玉）
function RemainsDrawModel:Draw(drawNum, consume_type, callback)
    local pbData = {
        draw_times = drawNum,
        consume_type = consume_type
    }
    RemainsNet:GetInstance():DrawExecute(pbData, function(msg)
        if msg.ack == 1 then
            _G.StorageManager:GetInstance():ReceiveAwardData({
                award = msg.award
            })
            if msg.award.overflow then
                _G.PopWindowManager:GetInstance():ShowAllTips(380104)
            end
            self.need_count = msg.need_count
            local sid
            local num
            if consume_type == 1 then
                sid = _G.ConfigManager.item_roller_cfg[self.cfgid].ticket[1]
                num = drawNum
            else
                self:AddDiamondTimes(drawNum)
                sid, num = self:GetDiamondCurrencyByType(drawNum)
            end
            _G.StorageManager:GetInstance():ConsumeItem(sid, 0, num)

            _G.PlayerPrefsManager.SetInt("RemainsFirstDraw", 1)
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.LegendaryRelicStarUp.id)
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.LegendaryRelicLevelUp.id)
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.LegendaryTenPull.id)
            -- require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.SpoilsCanUp.id)
            _G.Events:GetInstance():Broadcast(_G.eRemainsUpdate.RemainsUpdate)
            if callback then
                callback(msg)
            end
        end
    end)
end

---获取魂玉抽卡的sid和num
---@param drawNum number 抽奖次数
---@return number,number,number 消耗id，消耗值，折扣
function RemainsDrawModel:GetDiamondCurrencyByType(drawNum)
    local sid
    local num
    sid = _G.ConfigManager.item_roller_cfg[self.cfgid].ticket_2[1]
    local baseNum = _G.ConfigManager.item_roller_cfg[self.cfgid].ticket_2[2]
    num = drawNum * baseNum
    local data = require "PrivilegeManager":GetInstance():GetPrivilegeData(
        {_G.PrivilegeType.LimitedTimePrivilege.ConsumeReduce, self.cfgid})
    local discount = 1
    if data[1] then
        discount = data[1] * 0.0001
        num = num - num * discount
    end
    return sid, _G.math.ceil(num), 1 - discount
end

---@param score number
function RemainsDrawModel:GetAward(score, callback)
    local pbData = {
        index_list = {score}
    }
    RemainsNet:GetInstance():SpoilsDrawGetAward(pbData, function(msg)
        if msg.ack == 1 then
            _G.table.insert(self.awardState, score)
            if #self.awardState == 4 then
                self.awardState = {}
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            if callback then
                callback(msg)
            end
        end
    end)
end

---抽奖红点（包含道具和魂玉都满足时）
function RemainsDrawModel:CheckDrawPointRed()
    local activityClass = require("ActivitySynManager"):GetInstance():GetActivityClass(1014001)
    if activityClass then
        local typeClass = activityClass and activityClass.typeClass or nil
        if require "RedPointManager":GetInstance():GetNodeNum(typeClass:GetRedpointIDByIndex(1)) ~= 0 then
            return true
        end
    end

    local data = require "ActivitySynManager":GetInstance():GetChildAcitivity(10043, _G.ActivitySubType.Remains)
    local actEndTime = 0
    if data then
        local id = data.typeClass:GetRedpointIDByIndex(1)
        actEndTime = data.cfg.time.start_time + data.cfg.time.run_time
        local bol = actEndTime ~= 0 and _G.TimeUtil.GetServerUnixTime() <= actEndTime
        if bol then
            local idRed = data.typeClass:GetRedpointIDByIndex(1)
            if require "RedPointManager":GetInstance():GetNodeNum(idRed) ~= 0 then
                return true
            end
        end
    end

    local sid = _G.ConfigManager.item_roller_cfg[self.cfgid].ticket[1]
    local itemNum = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.Prop, sid)

    if itemNum ~= nil and itemNum > 0 then
        -- ZHJH-3174 有足够道具时，打开招募界面红点消失
        if _G.PlayerPrefsManager.HasKey("RemiansDrawRedPoint") then
            return false
        end
        return true
    end
    return false
end

---销毁对象时,析构函数
function RemainsDrawModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.OnUpData, self)
end

return RemainsDrawModel
