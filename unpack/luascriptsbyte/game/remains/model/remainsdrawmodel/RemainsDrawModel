local RemainsNet = require("RemainsNet")

local base = _G.GameDataModelBase
---@class RemainsDrawModel : GameDataModelBase
local RemainsDrawModel = _G.BaseClass("RemainsDrawModel", base)

---@return RemainsDrawModel RemainsDrawModel
