function RemainsSuitView:UpdateProp()
    self.go_table.scrollloopvectical_propList:UpdateCount(#self.Cfg.att)
end

function RemainsSuitView:RefreshPropItem(index, obj)
    local tb = GetAutoGoTable(obj)
    local value = self.Cfg.att[index + 1]
    tb.aortmp_propName.text = _G.GetLangPackValue(90020200027) .. _G.GetLangPackValue(90000010475, value[1])

    if value[1] == "0" then
        tb.aortmp_propName.text = _G.GetLangPackValue(90020200027) .. _G.GetLangPackValue(90022300041)
    end
    if value[3] == "2" or _G.AttrType[value[2]].proptype ~= 1 then
        tb.aortmp_curValue.text = _G.AttrType[value[2]].des .. "+" .. (tonumber(value[4]) / 100) .. "%"
    else
        tb.aortmp_curValue.text = _G.AttrType[value[2]].des .. "+" .. tonumber(value[4])
    end

end

---按钮点击事件在这里派发
function RemainsSuitView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if go == self.go_table.aorbtn_closeView then
        self:Close()
    end
end

