local RemainsModel = require("RemainsModel")

---@class RemainsSuitView : UIBaseView    中文描述
---@field public go_table RemainsSuitView_GoTable GoTable
---@field cfgList limit_broken_cfg[]
---@field sp RemainsData
local RemainsSuitView = _G.BaseClass("RemainsSuitView", _G.UIBaseView)

function RemainsSuitView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function RemainsSuitView:OnCreate(cfg)
    self.Cfg = cfg
    self:InitView()
end

---初始化页面
function RemainsSuitView:InitView()
    self.go_table.scrollloopvectical_propList:InitItemData(0, _G.handler(self, self.RefreshPropItem))

    local Count = #self.Cfg.remains
    self.go_table.scrollloophorizontal_PetList:InitItemData(Count, _G.handler(self, self.RefreshRemainsItem))
    self.go_table.scrollloophorizontal_PetList:UpdateCount(Count)
    local curNum = RemainsModel:GetInstance():ActiveFetterNum(self.Cfg.remains)
    self.go_table.aortmp_title.text = _G.GetLangPackValue(self.Cfg.name) .. "(" .. curNum .. "/" .. Count .. ")"

    self:UpdateProp()
end

function RemainsSuitView:RefreshRemainsItem(index, obj)
    local newIndex = index + 1
    local tb = _G.GetAutoGoTable(obj)
    local sid = self.Cfg.remains[newIndex]
    local remainsData = RemainsModel:GetInstance():GetData(sid)
    tb.data = remainsData
    if remainsData and not tb.spawning then
        if tb.remain then
            tb.remain:ShowData(remainsData, function()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonTipView.Name, _G.TipType.Remains,
                    tb.data)
            end)
            self:SetGrayAll(tb.remain.go_table, not tb.data:GetIsActive())
            -- tb.build.go_table.aorimage_mask:SetActiveE(tb.data:GetIsActive() and 0 or 1)
        else
            tb.spawning = true
            _G.PoolsManager:GetInstance():Spawn("UIH5/Common/ItemView/ItemRemainsBodyBaseView",
                _G.ePoolType.UIItem, tb.obj_RemainItem, _G.handlerbind(self, self.OnSpawnCall, tb))
        end
    end
end

function RemainsSuitView:OnSpawnCall(trans, path, tb)
    tb.spawning = false
    tb.remain = require"ItemRemainsBodyBaseView".New(trans.gameObject)
    if tb.data then
        tb.remain:ShowData(tb.data, function()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonTipView.Name, _G.TipType.Remains,
                tb.data)
        end)
        self:SetGrayAll(tb.remain.go_table, not tb.data:GetIsActive())
        -- self:SetColor(tb.remain.go_table, tb.data)
        -- tb.remain.go_table.aorimage_mask:SetActiveE(tb.data:GetIsActive() and 0 or 1)
    end
end

