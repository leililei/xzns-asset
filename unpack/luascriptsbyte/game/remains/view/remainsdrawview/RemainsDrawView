---按钮点击事件在这里派发
function RemainsDrawView:OnClickBtn(go)
    if self.DrawIng then
        return
    end
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DrawAwardView.Name)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 121)
    elseif go == self.go_table.aorbtn_Draw1 then
        self:ClickDrawBtn(DrawType.one, not window)
        if window then
            window.View:Close()
        end
    elseif go == self.go_table.aorbtn_Draw2 then
        self:ClickDrawBtn(DrawType.ten, not window)
        if window then
            window.View:Close()
        end
    elseif go == self.go_table.aorbtn_Draw3 then
        self:ClickDrawBtn(DrawType.rmb, not window)
        if window then
            window.View:Close()
        end
    elseif go == self.go_table.aorbtn_autoLeft then
        self:UpdateDrawPlayBtn(1 - self.playType)
    elseif go == self.go_table.aorbtn_TipsView then
        if self.NowShowIndex == nil then
            return
        end
        self:ShowItems(self.NowShowIndex, false)
    elseif go == self.go_table.aorbtn_AD then
        require("AdvertisementModel"):GetInstance():VideoAD(_G.AdvertisementType.SpoilsDraw,
            _G.handler(self, self.UpdateDrawBtn))
    elseif go == self.go_table.aorbtn_gift then -- 无按钮，GM
        -- _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpiritualDrawGiftPackView.Name, nil,
        --     _G.ActivitySubType.Remains)
    elseif go == self.go_table.aorbtn_awards then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DrawGiftPackToggleView.Name, nil,
            _G.ActivitySubType.Remains)
    elseif go == self.go_table.aorbtn_txyl then
        UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RemainsDrawInfoView.Name)
    elseif go == self.go_table.aorbtn_BattlePass then
        local ctrl = require("IntegrateBpFdModel"):GetInstance():GetController(1014001)
        if ctrl == nil then
            return
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.IntegrateBpFdView.Name, ctrl)
    end
end

