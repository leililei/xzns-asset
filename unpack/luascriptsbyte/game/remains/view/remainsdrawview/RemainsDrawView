---刷新抽卡按钮icon
function RemainsDrawView:UpdateDrawBtn()
    -- region 多次招募
    local isFirst = _G.PlayerPrefsManager.GetInt("RemainsFirstDraw", 0) == 0
    -- 招募道具数量
    local lastTimes = RemainsDrawModel:GetInstance():GetLastDiamondTimes()
    local sid, num, discount = RemainsDrawModel:GetInstance():GetDiamondCurrencyByType(1)
    local midNum = _G.StorageManager:GetInstance():GetItemCountBySid(self.itemSid)
    if isFirst and midNum > 1 then
        midNum = 1
    end
    self.midNum = midNum
    local mIcon = ItemCfg[self.itemSid].Icon
    local diamondIcon = _G.StorageManager:GetInstance():GetItemIcon(sid)
    local leftIsDiamond = lastTimes > 0 and midNum == 0
    self.leftIsDiamond = leftIsDiamond
    local rightIsDiamond = lastTimes >= 10 and midNum == 0
    self.rightIsDiamond = rightIsDiamond

    self.go_table.aortext_Prop1Num.text = leftIsDiamond and num or 1
    self.go_table.aortext_Prop2Num.text = rightIsDiamond and num * 10 or
                                              (midNum > 0 and (midNum <= 10 and midNum or 10) or 10)
    self.go_table.aortext_Prop2NumDesc.text = _G.GetLangPackValue(90050100065, GameUtil.NumberToWordByLanguage(
        rightIsDiamond and 10 or (midNum > 0 and (midNum <= 10 and midNum or 10) or 10)))
    self.drawNum = midNum > 0 and (midNum <= 10 and midNum or 10) or 10
    -- 红点
    self.go_table.obj_hongDian:SetActiveE(self.midNum >= 10 and 1 or 0)
    -- endregion

    -- region 图标加载
    self.go_table.aorrawimage_Prop1:LoadImage(leftIsDiamond and diamondIcon or mIcon, function(image)
        if image and self.isFree then
            image:SetActiveE(1)
        end
    end)
    self.go_table.aorrawimage_Prop2:LoadImage(rightIsDiamond and diamondIcon or mIcon, function(image)
        if image then
            image:SetActiveE(1)
        end
    end)
end

function RemainsDrawView:ShowItems(Index, isGou)
    if Index == self.NowShowIndex and self.go_table.aorbtn_TipsView:GetActiveSelf() == 1 then
        self.go_table.aorbtn_TipsView:SetActiveE(0)
        return
    end

    -- _G.CS.UnityEditor.EditorApplication.isPaused = true;
    ---@type AorButton
    local btn = self.go_table["obj_award" .. Index]
    if btn ~= nil then
        local x, y, z = btn:GetPosition()
        self.go_table.obj_ItemTips:SetPosition(x, y * 1.1, z)
    end

    local item = self.Rewards_item[Index]
    local NowItems = {}
    for i = 1, #item / 2 do
        _G.table.insert(NowItems, {item[i * 2 - 1], item[i * 2]})
    end

    self.NowShowIndex = Index

    if self.go_table.aorbtn_TipsView:GetActiveSelf() == 0 then
        self.go_table.aorbtn_TipsView:SetActiveE(1)
    end

    self.go_table.obj_Parent:ClearChildren()
    for i = 1, #NowItems do
        local info = NowItems[i]
        local num = info[2]
        self:CareatItem(info, isGou, self.go_table.obj_Parent, function(item)
        end)
    end
    self.go_table.obj_itemBg:SetRectTransformSize((#NowItems) * 75, 80)
    self.go_table.obj_ItemTips:SetRectTransformSize((#NowItems) * 75, 80)
    _G.UIUtils.SetOffScreenRectPosition(self.go_table.obj_ItemTips)
end

function RemainsDrawView:CareatItem(data, isGou, Parent, backCall)
    if _G.IsNil(Parent) or Parent:GetctiveInHierarchy() == 0 then
        return
    end
    local Sid = data[1]

    if Sid ~= _G.ResPropID.ActiveAch and Sid ~= _G.ResPropID.ActiveValue then
        -- body
        _G.StorageManager:GetInstance():GetItemBaseViewNew(data, Parent, function(item)
            if _G.IsNil(Parent) then
                _G.DestroyImmediate(item.gameObject)
                return
            end
            item.gameObject:SetLocalScaleXYZ(0.5)
            item.gameObject:SetActiveE(1)
            item:SetPri(data.isPri)
            item:SetGou(isGou)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            if item.SetGradeNew then
                item:SetGradeNew(false)
            end
            if backCall then
                backCall(item)
            end
        end, function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, Sid)
        end)
    end
    -- end
end

---抽！
function RemainsDrawView:Draw(type)
    local draw = function(counsumeType, drawNum)
        local preNeedCount = RemainsDrawModel:GetInstance():GetWishNeedCounts()
        RemainsDrawModel:GetInstance():Draw(drawNum, counsumeType, function(msg)
            if msg.ack ~= 1 then
                self:SetDrawBtnEnabled(true)
                return
            end
            self:UpdateDrawBtn()
            self:LoadDiamondTimes()
            self:SetNeedCount()

            if self.playType == DrawPlayType.Play and self.isBtnDraw then
                local isLegend = msg.need_count > preNeedCount - drawNum
                self:PlayDrawEffect({
                    award = msg.award
                }, isLegend)
            else
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DrawAwardView.Name, msg,
                    _G.handler(self, self.ClickDrawBtn), true, nil, nil, nil, nil, true, nil, nil, nil, nil,
                    {ItemCfg[self.itemSid].Icon, self.drawNum})
                self:SetDrawBtnEnabled(true)

            end
        end)
    end

    local counsumeType = type == DrawType.one and (self.leftIsDiamond and 2 or 1) or (self.rightIsDiamond and 2 or 1)
    local num = type == DrawType.one and 1 or self.rightIsDiamond and 10 or
                    (self.midNum > 0 and (self.midNum <= 10 and self.midNum or 10)) or 10
    if counsumeType == 1 then
        if not _G.StorageManager:GetInstance():CheckItem(self.itemSid, num) then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.itemSid)
            return
        end
        ---抽卡次数不足1次后重置打开界面的红点
        local remainNum = _G.StorageManager:GetInstance():GetItemCountBySid(self.itemSid) - num
        local recordNum = _G.PlayerPrefsManager.GetInt("RemiansDrawRedPoint")
        if remainNum == 0 then
            _G.PlayerPrefsManager.DeleteKey("RemiansDrawRedPoint")
        elseif recordNum > 0 then
            -- 如果剩余数量不为0且记录值也大于0则更新记录值
            _G.PlayerPrefsManager.SetInt("RemiansDrawRedPoint", remainNum)
        end
        draw(counsumeType, num)
    elseif counsumeType == 2 then
        if RemainsDrawModel:GetInstance():GetLastDiamondTimes() >= num then
            local rmbSid, numNeed = RemainsDrawModel:GetInstance():GetDiamondCurrencyByType(num)

            if not _G.StorageManager:GetInstance():CheckItem(rmbSid, numNeed) then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, rmbSid)
                return
            end

            _G.PopWindowManager:GetInstance():ShowDrawWindowByToggle(340605, _G.DrawRollerType.SpoilsDraw, self.cfgid,
                num, numNeed, function()
                    draw(counsumeType, num)
                end, function()
                end)
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(19)
        end
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("灵兽召唤收到未定义召唤类型")
            return
        end
    end
end

function RemainsDrawView:ShowAwardsBtn()
    local data = require "ActivitySynManager":GetInstance():GetChildAcitivity(10043, _G.ActivitySubType.Remains)
    local actEndTime = 0
    if data then
        local id = data.typeClass:GetRedpointIDByIndex(1)
        self.go_table.obj_redpointAwards:UpdateRedPointItemIDAndParam(id)
        actEndTime = data.cfg.time.start_time + data.cfg.time.run_time
        self.go_table.aortext_awardsName.text = data.cfg.info.title
        -- self.go_table.aorimage_awardsIcon.SpriteName = data.cfg.info.icon
    end
    local bol = actEndTime ~= 0 and _G.TimeUtil.GetServerUnixTime() <= actEndTime
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_awards, bol)
    if bol then
        self:UpdateDrawGiftTip()
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.LegendaryTenPull.id)
    end
end

---更新累抽任务tip窗口
---@return void
function RemainsDrawView:UpdateDrawGiftTip()
    local data = require "ActivitySynManager":GetInstance():GetChildAcitivity(10007, _G.ActivitySubType.Remains)
    if not data or not self.go_table then
        return
    end
    -- 是否有可领取的豪礼
    local hasAward = #data.typeClass:GetCankTaskList() > 0
    if hasAward then
        self.go_table.aorbtn_afkGiftTip:SetActiveE(1)
        self.go_table.aortext_afkGiftTip.text = _G.GetLangPackValue(90000001250) -- 当前可领奖
        self.afkGiftTick = nil
        if self.afkGiftTimer then
            self.afkGiftTimer:Stop()
            self.afkGiftTimer = nil
        end
        return
    end

    local intervalCfg = _G.ConfigManager.discrete_cfg[120011]
    local interval = intervalCfg[1][1] or 5 -- 默认间隔5秒, 0常驻显示, -1不显示
    local isShowTip = false
    if interval > 0 then
        -- 创建定时器
        if not self.afkGiftTimer then
            self.afkGiftTimer = _G.TimerManager:GetInstance():GetTimer(interval, self.UpdateDrawGiftTip, self, false,
                false, true)
            self.afkGiftTimer:Start()
        end
        self.afkGiftTick = (self.afkGiftTick or 0) + 1
        isShowTip = self.afkGiftTick % 2 == 0
    else
        -- 销毁定时器
        if self.afkGiftTimer then
            self.afkGiftTimer:Stop()
            self.afkGiftTimer = nil
        end
        isShowTip = interval ~= -1
    end

    -- 是否需要显示tip
    self.go_table.aorbtn_afkGiftTip:SetActiveE(isShowTip and 1 or 0)
    if not isShowTip then
        if self.afkGiftTimer then
            self.afkGiftTimer:Stop()
            self.afkGiftTimer = nil
        end
        return
    end
    -- 获取下一个可领取的关卡
    local nextAfk = data.typeClass:GetNextTarget()
    if nextAfk == 0 then
        -- 奖励已全部领取完成
        self.go_table.aorbtn_afkGiftTip:SetActiveE(0)
        if self.afkGiftTimer then
            self.afkGiftTimer:Stop()
            self.afkGiftTimer = nil
        end
        return
    end
    self.go_table.aortext_afkGiftTip.text = _G.GetLangPackValue(90020800054, nextAfk)
end

