---更新动画播放按钮
---@param type DrawPlayType
function RemainsDrawView:UpdateDrawPlayBtn(type)
    if type == nil then
        self.playType = _G.PlayerPrefsManager.GetInt("RemainsDrawSkip")
        if self.playType == nil then
            self.playType = DrawPlayType.Play
        end
    else
        self.playType = type
    end
    _G.PlayerPrefsManager.SetInt("RemainsDrawSkip", self.playType)
    local isPlay = self.playType == DrawPlayType.Play
    self.go_table.aorimage_auto.gameObject:SetLocalPosition(isPlay and 30 or -30, 0, 0)
    self.go_table.aortext_wenzi.text = _G.ConfigManager.language_package_cfg[isPlay and DrawPlayText.Open or
                                           DrawPlayText.Close]
    self.go_table.aorimage_skip:SetActiveE(isPlay and 1 or 0)
end

function RemainsDrawView:OnStartClose()
    if self.DelayAward then
        _G.coroutine.stopwaiting(self.DelayAward)
        self.DelayAward = nil
    end
    if self.DelayEffect then
        _G.coroutine.stopwaiting(self.DelayEffect)
        self.DelayEffect = nil
    end
end

---修改层级
function RemainsDrawView:ChangeBtnBack(isBack)
    if isBack then
        self.go_table.obj_btn:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder =
            self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder + 30
    else
        self.go_table.obj_btn:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder =
            self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder + 100
    end
end

function RemainsDrawView:Dispose()
    self:RemoveListener(_G.eLimitePrivilege.LimitePrivilegeChange, self.PrivilegeChange, self)
    -- self:RemoveListener(_G.eSpoilsDraw.SpoilsDrawWishRefresh, self.ShowWish, self)
    self:RemoveListener(_G.eSixUpdate.SixClockUpdate, self.PrivilegeChange, self)
    _G.Events:GetInstance():RemoveListener(_G.eAdvertisement.Refresh, self.UpdateDrawBtn, self)
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.UpdateDrawBtn, self)
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.ResRefresh, self.UpdateDrawBtn, self)
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)

end

return RemainsDrawView
