---加载魂玉召唤次数信息
function RemainsDrawView:LoadDiamondTimes()
    -- 获取魂玉召唤次数信息
    local usedTimes = RemainsDrawModel:GetInstance():GetDiamondTimes()
    local totalTimes = RemainsDrawModel:GetInstance():GetDiamondTotalTimes()
    self.go_table.obj_diamondTimes:SetActiveE(totalTimes > 0 and 1 or 0)
    if totalTimes <= 0 then
        return
    end

    local remain = totalTimes - usedTimes
    self.go_table.aortext_remainDiamondTimes.text = _G.GetLangPackValue(90000011298, remain .. "/" .. totalTimes)
end

