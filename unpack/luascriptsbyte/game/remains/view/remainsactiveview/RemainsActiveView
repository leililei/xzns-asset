local RemainsActiveView = _G.BaseClass("RemainsActiveView", _G.UIBaseView)

function RemainsActiveView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function RemainsActiveView:OnCreate(sp, type)
    --- 1:激活 2:升星 3:羁绊
    self.ToggleType = type or 1
    self.sp = sp

    -- -- --- 激活特效
    -- _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_Curio_activate, self.go_table.obj_effect1,
    --     function(trans)
    --         if self:IsNil() then
    --             _G.DestroyObject(trans)
    --         end
    --     end)
    self.go_table.aorrawimage_active:SetActiveE(self.ToggleType == 1 and 1 or 0)
    self.go_table.aorrawimage_upStar:SetActiveE(self.ToggleType == 2 and 1 or 0)

    self:InitView()
end

---初始化页面
function RemainsActiveView:InitView()
    -- self.go_table.aortext_name.text = _G.GetLangPackValue(self.sp.cfg.name)
    self.go_table.aorrawimage_remains:LoadImage(self.sp.cfg.icon)
    self.go_table.aorimage_IconBg.SpriteName = _G.ItemBaseIconName[self.sp.cfg.grade]

    self.go_table.scrollloopvectical_propList:InitItemData(0, _G.handler(self, self.RefreshPropItem))
    self:UpdateProp()
    if self.ToggleType == 1 then
        self:UpdateAll()
        self.go_table.aortext_title1.text = _G.GetLangPackValue(90050100072)
    elseif self.ToggleType == 2 then
        self.go_table.aorimage_LevelProp:SetActiveE(0)
        self.go_table.aortext_title1.text = _G.GetLangPackValue(90050100075)
    elseif self.ToggleType == 3 then
        self.go_table.aortext_title1.text = _G.GetLangPackValue(90050100078)

    end
end

function RemainsActiveView:UpdateProp()
    self.propList = {}
    local prop = self.sp.cfg
    for _, v in ipairs(prop.att1) do
        if _G.AttrType[v[1]] then
            local star
            local nextV
            if self.ToggleType == 1 then
                nextV = 1
                star = 1
            elseif self.ToggleType == 2 then
                nextV = self.sp:GetStar()
                star = self.sp:GetStar() + 1
            end
            _G.table.insert(self.propList, {
                name = _G.AttrType[v[1]].des,
                value = _G.Mathf.RoundToInt(self.sp.cfg.rate[star - 1 > 0 and star - 1 or 1] * v[3] / 10000),
                icon = _G.AttrTypeIcon[v[1]],
                nextValue = _G.Mathf.RoundToInt(self.sp.cfg.rate[star] * v[3] / 10000),
                percentage = v[2],
                proptype = _G.AttrType[v[1]].proptype
            })
        end
    end

    self.go_table.scrollloopvectical_propList:UpdateCount(#self.propList)
end

function RemainsActiveView:RefreshPropItem(index, obj)
    local tb = GetAutoGoTable(obj)
    local value = "+" .. self.propList[index + 1].value

    local nextValue = "+" .. self.propList[index + 1].nextValue
    if self.propList[index + 1].percentage == "2" or self.propList[index + 1].proptype ~= 1 then
        value = "+" .. value / 100 .. "%"
        nextValue = "+" .. nextValue / 100 .. "%"
    end

    tb.aorimage_icon.SpriteName = self.propList[index + 1].icon
    tb.aortext_propName.text = self.propList[index + 1].name .. value
    if self.ToggleType == 2 then
        tb.aortext_nextValue.text = nextValue
        tb.aorimage_arrow2:SetActiveE(1)
        tb.aortext_nextValue:SetActiveE(1)
    elseif self.ToggleType == 1 then
        tb.aorimage_arrow2:SetActiveE(0)
        tb.aortext_nextValue:SetActiveE(0)
    end
    -- tb.aortext_curValue.text = value
end

function RemainsActiveView:UpdateAll()
    self.go_table.aortext_Level.text = _G.GetLangPackValue(90031900006, 1)
    self.go_table.aortext_attrDesc.text = self.sp:GetLevelLeftDesc()
    -- self.go_table.aortext_attrDesc2.text = self.sp:GetLevelProp()

    self.go_table.obj_stars:SetActiveE(0)
    -- for i = 1, 5 do
    --     self.go_table["aorimage_Star" .. i]:SetActiveE(1)
    --     self.go_table["aorimage_Star" .. i].SpriteName = "Ui_img_xing_cai"
    -- end
end

