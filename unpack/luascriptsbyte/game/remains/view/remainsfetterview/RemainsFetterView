    end
    -- tb.aortext_title:SetLocalPosition(0, -128, 0)
    tb.aortext_title:SetActiveE(1)
end

---获取基础属性
function RemainsFetterView:GetBaseAttr(att)
    local attributeManager = _G.AttributeClassManager:GetInstance()
    local attributeList = {}
    -- for _, v in pairs(att) do
    table.insert(attributeList, {
        key = att[2],
        sortId = _G.AttrType[att[2]].sortid,
        type = _G.tonumber(att[3]),
        proptype = _G.AttrType[att[2]].proptype,
        num = attributeManager:GetValueWithName(att[2], att[4], att[3])
    })
    -- end
    _G.SortList(attributeList, function(a)
        return -a.sortId
    end)

    return attributeList
end

---羁绊Btn点击事件
function RemainsFetterView:OnClickFetterItem(obj, _, params)

    local name = obj:GetName()
    local tb = _G.GetAutoGoTable(params.obj)

    if name == "@_aorbtn_titleTip" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RemainsStarInfoView.Name,
            self.fetterConfigs[params.index])
    else
        if not self.canActive[params.index] then
        _G.PopWindowManager:GetInstance():ShowAllTips(9014001)

            return
        end
        if params.stage < 5 then
            local cfg = self.fetterConfigs[params.index]
            if not RemainsModel:GetInstance():CanActiveFetter(cfg.remains, tonumber(cfg.att[params.stage + 1][1])) then
                return
            end

            ---可以解锁，点击解锁
            local maxIndex = RemainsModel:GetInstance():GetActiveMaxIndex(cfg.id)
            if maxIndex then
                self:RecordPower()
                RemainsModel:GetInstance():FetterActive(cfg.id, maxIndex, function()
                    tb.obj_effectLevelUp:SetActiveE(1)
                    tb.obj_levelUpMask:SetActiveE(1)
                    self:ShowPowerUp()
                    _G.DelayDo(0.55, function()
                        if self:IsNil() then
                            return
                        end
                        self:InitFetterList()
                        tb.obj_effectLevelUp:SetActiveE(0)
                        tb.obj_levelUpMask:SetActiveE(0)
                    end)
                end)
            end
        end

    end
end

---界面的销毁函数
function RemainsFetterView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eRemainsUpdate.RemainsUpdate, self.InitFetterList, self)
    self:RemoveListener(_G.ePetUpStar.BuildDrawWishRefresh, self.remainDrawWishRefresh, self)
end

---按钮点击事件在这里派发
function RemainsFetterView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 122)
    end
end

return RemainsFetterView
