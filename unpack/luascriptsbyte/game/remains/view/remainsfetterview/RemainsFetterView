    if nowIndex ~= 5 then
        local str = _G.GetLangPackValue(90050100023, cfg.att[nowIndex ~= 0 and nowIndex + 1 or 2][1])

        local attributeList2 = self:GetBaseAttr(cfg.att[nowIndex ~= 0 and nowIndex + 1 or 2])
