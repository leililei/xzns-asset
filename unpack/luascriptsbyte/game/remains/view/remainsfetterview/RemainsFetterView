--- 底部全部属性展示
function RemainsFetterView:RefreshFetterDeep()
    local manager = require("TeamHallAttrManager")
    self.fetterAttr, self.hasFetter = manager.GetAttribute(
        require("RemainsModel"):GetInstance():GeFetterAttribute()
    )
    if not self.hasFetter then
        self.go_table.aortext_Tips:SetActiveE(1)
        return
    else
        self.go_table.aortext_Tips:SetActiveE(0)
    end
    self.go_table.scrollloopvectical_propList:InitItemData(0, _G.handler(self, self.RefreshPropItem))
    self.go_table.scrollloopvectical_propList:UpdateCount(#self.fetterAttr)

end

function RemainsFetterView:RefreshPropItem(index, obj)
    index = index + 1
    local attr = self.fetterAttr[index]
    local isPrecent = attr.percentage == 2
    local tb = self.attrList[index]
    if not tb then
        tb = self:AddComponent(
            obj,
            TeamHallAttrItem.New(
                attr.des,
                attr.num,
                attr.icon,
                isPrecent,
                isPrecent
            )
        )
        self.attrList[index] = tb
    else
        tb:OnCreate(
            attr.des,
            attr.num,
            attr.icon,
