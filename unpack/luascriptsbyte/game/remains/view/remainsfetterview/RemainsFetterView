function RemainsFetterView:InitFetterCfg()
    self.fetterConfigs = {}
    self.canActive = {}

    local fetterCfg = _G.ConfigManager.remains_fetter_cfg
    for _, v in pairs(fetterCfg) do
        if v.isdisplay == 1 then
            table.insert(self.fetterConfigs, v)
        end
    end
    _G.table.sort(self.fetterConfigs, function(a, b)
        --- 当前羁绊阶段
        local starA = RemainsModel:GetInstance():GetFetterIndex(a.id)
        local starB = RemainsModel:GetInstance():GetFetterIndex(b.id)
        --- 当前羁绊可升级 且未满级为999 否则为0
        local canActiveA = RemainsModel:GetInstance():CanActiveFetter(a.remains, tonumber(
            a.att[starA + 1 < 5 and starA + 1 or 5][1])) and starA ~= 5 and 999 or 0
        local canActiveB = RemainsModel:GetInstance():CanActiveFetter(b.remains, tonumber(
            b.att[starB + 1 < 5 and starB + 1 or 5][1])) and starB ~= 5 and 999 or 0

        --- 如果羁绊里可激活 或者可升级到下一阶段 权重加1
        local isAList = 0
        local starANext = starA ~= 5 and starA + 1 or 0
        if starANext ~= 0 then
            for i = 1, #a.remains do
                local data = RemainsModel:GetInstance():GetData(a.remains[i])
                if not data:GetIsActive() and data:IsCanActive() then
                    isAList = isAList + 1
                end
            end
        end
        if isAList == #a.remains then
            canActiveA = canActiveA + 1
        end

        --- 如果羁绊里可激活 或者可升级到下一阶段 权重加1
        local isBList = 0
        for i = 1, #b.remains do
            local data = RemainsModel:GetInstance():GetData(b.remains[i])
            if not data:GetIsActive() and data:IsCanActive() then
                isBList = isBList + 1
            end
        end
        if isBList == #b.remains then
            canActiveB = canActiveB + 1
        end

        if canActiveA == canActiveB then
            return a.id > b.id
        else
            return canActiveA > canActiveB
        end

    end)

    -- local playermodel = _G.PlayerModel:GetInstance()
    -- local serverStartTime = playermodel:GetServerOpenTime()
    -- local curTime = _G.TimeUtil.GetServerUnixTime()
    -- local today = math.ceil((curTime - serverStartTime) / 86400)
    -- local creatDay = math.ceil((playermodel.create_time - serverStartTime) / 86400)
    -- local nowAfk = require("AfkModel"):GetInstance():GetCurSection()
    -- local lv = playermodel:GetLevel()

    -- self.fetterConfigs = fetterCfg
end

