function RemainsFetterView:RecordPower()
    self.power = _G.StorageManager:GetInstance():GetPlayerPower()
end

function RemainsFetterView:ShowPowerUp()
    ---临时等级提升不显示战力变化
    local newPower = _G.StorageManager:GetInstance():GetPlayerPower()
    local offset = newPower - self.power
    if offset > 0 then
        require"CommonTipManager".OpenPowerUpView(self.power, offset)
    end
    self.power = newPower
end

function RemainsFetterView:RefreshRemainsItem(index, obj)
    local newIndex = index + 1
    local tb = _G.GetAutoGoTable(obj)
    local sid = self.remain[self.petIndex][newIndex]
    local remainsData = RemainsModel:GetInstance():GetData(sid)
    tb.data = remainsData
    if remainsData and not tb.spawning then
        if tb.remain then
            tb.remain:ShowData(remainsData, function()
                self:OpenInfo(remainsData.cfg)
            end)
            self:SetGrayAll(tb.remain.go_table, not tb.data:GetIsActive())
            -- tb.build.go_table.aorimage_mask:SetActiveE(tb.data:GetIsActive() and 0 or 1)
            tb.remain.go_table.aorimage_active:SetActiveE(0)
            tb.remain.go_table.aorimage_starUp:SetActiveE(0)
            if not tb.data:GetIsActive() and tb.data:IsCanActive() then
                tb.remain.go_table.aorimage_active:SetActiveE(1)
            end
            if tb.data:GetIsActive() and tb.data:IsCanStarUp() then
                tb.remain.go_table.aorimage_starUp:SetActiveE(1)
            end

            if tb.data:GetOrder() == _G.RemainsQuilty.cai then
                tb.remain:ShowEffectOrder(true)
            else
                tb.remain:ShowEffectOrder(false)
            end

        else
            tb.spawning = true
            _G.PoolsManager:GetInstance():Spawn("UIH5/Common/ItemView/ItemRemainsBodyBaseView", _G.ePoolType.UIItem,
                tb.obj_RemainItem, _G.handlerbind(self, self.OnSpawnCall, tb))
        end
    end
end

function RemainsFetterView:OnSpawnCall(trans, path, tb)
    tb.spawning = false
    tb.remain = require"ItemRemainsBodyBaseView".New(trans.gameObject)
    if tb.data then
        tb.remain:ShowData(tb.data, function()
            self:OpenInfo(tb.data.cfg)
        end)
        if tb.data:GetOrder() == _G.RemainsQuilty.cai then
            tb.remain:ShowEffectOrder(true)
        else
            tb.remain:ShowEffectOrder(false)
        end
        self:SetGrayAll(tb.remain.go_table, not tb.data:GetIsActive())
        -- self:SetColor(tb.remain.go_table, tb.data)
        -- tb.remain.go_table.aorimage_mask:SetActiveE(tb.data:GetIsActive() and 0 or 1)
        tb.remain.go_table.aorimage_active:SetActiveE(0)
        tb.remain.go_table.aorimage_starUp:SetActiveE(0)
        if not tb.data:GetIsActive() and tb.data:IsCanActive() then
            tb.remain.go_table.aorimage_active:SetActiveE(1)
        end
        if tb.data:GetIsActive() and tb.data:IsCanStarUp() then
            tb.remain.go_table.aorimage_starUp:SetActiveE(1)
        end
    end
end

