        -- tb.aortext_Operation.text = _G.GetLangPackValue(data.desc)
    else
        tb.aorbtn_click:SetActiveE(0)
        tb.aortext_Operation:SetActiveE(0)
        -- tb.obj_PropContent:SetActiveE(0)
        tb.aorimage_MaxLevel:SetActiveE(1)
        -- tb.aortext_title.fontSize = 40
