---刷新指定羁绊对应的属性
function RemainsFetterView:RefreshFetterAttribute(index)
    local cfg = self.fetterConfigs[index]
    ---当前羁绊激活的阶段
    -- self.curStage = RemainsModel:GetInstance():GetFetterIndex(cfg.id)

    if not self.attributeList then
        self.attributeList = {}
    end
    self.attributeList[index] = {}
    for i = 1, 5 do
        if cfg.att[i] then
            self.attributeList[index][i] = {
                condition_star = cfg.att[i][1],
                att = cfg["att" .. i],
                desc = cfg["desc" .. i]
            }
        end
    end
    -- self.fetterListView:UpdateCount(#self.fetterConfigs)
end

---刷新羁绊信息
function RemainsFetterView:RefreshFetterItem(index, obj)
    local params = {}
    local newIndex = index + 1
    local cfg = self.fetterConfigs[newIndex]
    local nowIndex = RemainsModel:GetInstance():GetFetterIndex(cfg.id)
    self.canActive[newIndex] = false
    params.index = newIndex
    params.stage = nowIndex
    params.obj = obj
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickFetterItem, params))
    local childCount = tb.obj_PropContent:GetChildCountE()
    if childCount > 0 then
        for i = 1, childCount do
            _G.PoolsManager:GetInstance():Despawn(tb.obj_PropContent:GetChildE(i - 1), _G.ePoolType.UIItem)
        end
    end
    tb.obj_effect:ClearChildren()
    tb.obj_effectLevelUp:ClearChildren()

    -- _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_Curio_permanent, tb.obj_effect, function(trans)
    --     if self:IsNil() then
    --         _G.DestroyObject(trans)
    --     end
    -- end)
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_RemainsFetterView_daojukuang, tb.obj_effectLevelUp,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
        end)

    tb.obj_effectLevelUp:SetActiveE(0)
    tb.obj_levelUpMask:SetActiveE(0)
    ---属性
    self:RefreshPetInfo(tb, newIndex)
    tb.aortext_suitName.text = _G.GetLangPackValue(cfg.name)

    local remainsID = cfg.remains[1]
    local remainData = RemainsModel:GetInstance():GetData(remainsID)

    tb.aorimage_Tips.SpriteName = self.QuilityTipsBG[remainData.cfg.grade]
    tb.aortext_TipsName:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor =
        _G.ColorTools.FormatColorByString(self.TipOutLineColor[remainData.cfg.grade])
    tb.aortext_TipsName.text = _G.LangUtil.GetLangPackValue(remainData.cfg.badge)

    tb.obj_PropContent:SetActiveE(1)
    tb.aorbtn_click:SetActiveE(1)
    tb.aorimage_MaxLevel:SetActiveE(0)
    tb.aortext_Operation:SetActiveE(1)
    -- tb.aortext_title.fontSize = 20
    -- tb.aortext_title:SetLocalPosition(0, -164, 0)
    tb.aortext_title.text = ""

    local attributeList = self:GetBaseAttr(cfg.att[nowIndex ~= 0 and nowIndex or 1])

    for _, v in pairs(attributeList) do
        local indexCur = nowIndex ~= 0 and nowIndex or nowIndex + 1
        local str = _G.GetLangPackValue(90050100023, cfg.att[indexCur][1])

        if cfg.att[indexCur][1] == "0" then
            str = _G.GetLangPackValue(90020200027) .. _G.GetLangPackValue(90022300041)
        end

        local tran = _G.InstantiateObject(tb.obj_BaseProp, tb.obj_PropContent)
        if tran then
            local tb = _G.GetAutoGoTable(tran)
            tb.aortext_Name.text = str .. ":" .. _G.AttrType[v.key].des
            tb.aorimage_icon.SpriteName = _G.AttrTypeIcon[v.key]
            -- tb.aorimage_icon:SetActiveE(1)
            tb.aorrawimage_icon:SetActiveE(0)
            tb.aorimage_lock:SetActiveE(nowIndex == 0 and 1 or 0)
            tb.aorimage_icon:SetActiveE(nowIndex == 0 and 0 or 1)

            if nowIndex == 0 then
                tb.aortext_Name.color = _G.ColorTools.FormatColorByString("FFFFFF")
                tb.aortext_Num.color = _G.ColorTools.FormatColorByString("FFFFFF")
            else
                tb.aortext_Name.color = _G.ColorTools.FormatColorByString("83e496")
                tb.aortext_Num.color = _G.ColorTools.FormatColorByString("83e496")

            end

            local numStr = v.num
            if v.type == 2 or v.proptype ~= 1 then
                numStr = _G.GameUtil.FormatNum(numStr) * 100 .. "%"
            else
                numStr = _G.GameUtil.NumberWY(_G.math.floor(numStr))
            end
