local RemainsInfoView = _G.BaseClass("RemainsInfoView", _G.UIBaseView)

function RemainsInfoView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

local LevelUpAutoType = {
    None = 0,
    Auto = 1
}

---界面的入口函数
function RemainsInfoView:OnCreate(sp, type)
    self.ToggleType = type or 1
    self.sp = sp

    -- self.QuilityTitle = {
    --     [_G.RemainsQuilty.zi] = "ui_bt_db_zi",
    --     [_G.RemainsQuilty.cheng] = "ui_bt_db_cheng",
    --     [_G.RemainsQuilty.hong] = "ui_bt_db_hong",
    --     [_G.RemainsQuilty.cai] = "ui_bt_db_cai"
    -- }

    self.QuilityBG = {
        [_G.RemainsQuilty.zi] = "ui_jhjm_bg_lv2",
        [_G.RemainsQuilty.cheng] = "ui_jhjm_bg_lan2",
        [_G.RemainsQuilty.hong] = "ui_jhjm_bg_zi2",
        [_G.RemainsQuilty.cai] = "ui_jhjm_bg_cheng2"
    }

    --- 升星特效
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_RemainsInfoView_saoguang, self.go_table.obj_effect2,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
        end)

    self.go_table.obj_effect2:SetActiveE(0)
    self.go_table.obj_effect3:SetActiveE(0)

    if self.ToggleType == 2 then
        self.go_table.toggle_Toggle2.isOn = true
    end
    self:InitView()
end

---初始化页面
function RemainsInfoView:InitView()
    -- self.go_table.aorimage_TitleBg.SpriteName = self.QuilityTitle[self.sp.cfg.grade]
    self.go_table.aorimage_guang.SpriteName = self.QuilityBG[self.sp.cfg.grade]
    self.go_table.aortext_name.text = _G.GetLangPackValue(self.sp.cfg.name)
    self.go_table.aorrawimage_remains:LoadImage(self.sp.cfg.icon, function(trans)
        trans:SetNativeSize()
        trans:SetLocalScaleXYZ(1.2)
        trans:SetLocalPosition(0, 240, 0)
    end)

    self.go_table.scrollloopvectical_propList:InitItemData(0, _G.handler(self, self.RefreshPropItem))
    self:UpdateProp()
    self:UpdateAll()
end

function RemainsInfoView:UpdateProp()
    self.propList = {}
    local prop = self.sp.cfg
    for _, v in ipairs(prop.att1) do
        if _G.AttrType[v[1]] then
            local star = self.sp:GetStar() + 1
            local nextV
            if self.sp:IsMaxStar() or not self.sp:GetIsActive() then
                nextV = 0
            else
                nextV = _G.Mathf.RoundToInt(self.sp.cfg.rate[star + 1] * v[3] / 10000)
            end
            _G.table.insert(self.propList, {
                name = _G.AttrType[v[1]].des,
                value = _G.Mathf.RoundToInt(self.sp.cfg.rate[star] * v[3] / 10000),
                icon = _G.AttrTypeIcon[v[1]],
                nextValue = nextV,
                percentage = v[2],
                proptype = _G.AttrType[v[1]].proptype
            })
        end
    end

    self.go_table.scrollloopvectical_propList:UpdateCount(#self.propList)
end

function RemainsInfoView:RefreshPropItem(index, obj)
    local tb = GetAutoGoTable(obj)
    local value = "+" .. self.propList[index + 1].value
    if self.sp:IsMaxStar() then
        self.propList[index + 1].nextValue = _G.GetLangPackValue(90022300065)
        if self.propList[index + 1].percentage == "2" or self.propList[index + 1].proptype ~= 1 then
            value = "+" .. _G.Mathf.RoundToInt(value) / 100 .. "%"
        end
        tb.aorimage_arrow2:SetActiveE(0)
        tb.aortext_nextValue:SetActiveE(0)
    else
        local nextValue = "+" .. self.propList[index + 1].nextValue
        if self.propList[index + 1].percentage == "2" or self.propList[index + 1].proptype ~= 1 then
            value = "+" .. _G.Mathf.RoundToInt(value) / 100 .. "%"
            nextValue = "+" .. _G.Mathf.RoundToInt(nextValue) / 100 .. "%"
        end
        if self.propList[index + 1].nextValue ~= 0 then
            tb.aortext_nextValue.text = nextValue
            tb.aorimage_arrow2:SetActiveE(1)
            tb.aortext_nextValue:SetActiveE(1)
        else
            tb.aorimage_arrow2:SetActiveE(0)
            tb.aortext_nextValue:SetActiveE(0)
        end
    end

    if self.ToggleType == 2 then
        tb.aorimage_arrow2:SetActiveE(0)
        tb.aortext_nextValue:SetActiveE(0)
    end

    tb.aorimage_icon.SpriteName = self.propList[index + 1].icon
    tb.aortext_propName.text = self.propList[index + 1].name
    tb.aortext_curValue.text = value
    _G.GameUtil.ReBuildRTF(tb.obj_propAll)

end

function RemainsInfoView:UpdateAll()
    self.go_table.aortext_Level.text = _G.GetLangPackValue(90031900006,
        "<color=#c06229>" .. self.sp:GetLevel() .. "</color>")
    self.go_table.aorimage_LevelProp:SetActiveE(1)
    self.go_table.aortext_attrDesc.text = self.sp:GetLevelLeftDesc()
    -- _G.GameUtil.ReBuildRTF(self.go_table.aorimage_LevelProp)
    if not self.sp:IsMaxLevel() then
        self.go_table.aortext_attrDesc2.text = self.sp:GetLevelProp()
    end
    self.go_table.aorimage_isHaveLevel:SetActiveE(not self.sp:IsMaxLevel() and 1 or 0)

    -- self.go_table.aorbtn_suitIcon:SetActiveE(self.sp.cfg.suit > 0 and 1 or 0)
    -- self.go_table.aortext_title2:SetActiveE(self.sp.cfg.suit > 0 and 1 or 0)
    if #self.sp.cfg.mission > 0 then
        self.go_table.aortext_conditionDesc.text = _G.GetLangPackValue(90050100040, self.sp:GetTaskCurStr(),
            self.sp.cfg.mission[1][3])
        self.go_table.obj_condition:SetActiveE(1)
        -- self.go_table.aorimage_conditionArr:SetActiveE(self.sp:GetTaskCurStr() < self.sp.cfg.mission[1][3] and 1 or 0)
        -- self.go_table.aortext_conditionDesc2:SetActiveE(self.sp:GetTaskCurStr() < self.sp.cfg.mission[1][3] and 1 or 0)
        self.go_table.aortext_conditionDesc2.text = self.sp:GetLevelProp2()
    else
        self.go_table.obj_condition:SetActiveE(0)

    end
    _G.GameUtil.ReBuildRTF(self.go_table.obj_condition)
    self.go_table.obj_stars:SetActiveE(1)
    _G.GameUtil.ReBuildRTF(self.go_table.obj_prop)

    for i = 1, 5 do
        if self.sp:GetStar() <= 5 then
            if self.sp:GetStar() >= i then
                self.go_table["aorimage_Star" .. i].SpriteName = "ui_img_xing"
            else
                self.go_table["aorimage_Star" .. i].SpriteName = "ui_ty_kapaipinjie_0"
            end
        elseif self.sp:GetStar() > 5 then
            if self.sp:GetStar() >= i + 5 then
                self.go_table["aorimage_Star" .. i].SpriteName = "ui_img_xing_hong"
            else
                self.go_table["aorimage_Star" .. i].SpriteName = "ui_img_xing"
            end
        end
    end
    if self.sp:GetIsActive() then
        -- self.go_table.aorimage_LevelProp:SetActiveE(1)
        self.go_table.obj_toggles:SetActiveE(1)
    else

        self.go_table.obj_toggles:SetActiveE(0)
    end
    self.go_table.aorimage_autobg:SetActiveE(self.ToggleType == 1 and 0 or 1)

    --- 升星
    if self.ToggleType == 1 then
        local star = self.sp:GetStar() + 2
        if not self.sp:GetIsActive() then
            star = self.sp:GetStar() + 1
            self.go_table.aortext_star.text = _G.GetLangPackValue(90050100017)
            self.go_table.aorbtn_star:SetGray(not self.sp:IsCanActive())
        else
            self.go_table.aortext_star.text = _G.GetLangPackValue(90022300042)
            self.go_table.aorbtn_star:SetGray(not self.sp:IsCanStarUp())
        end

        self.go_table.aorimage_maxstar.SpriteName = "ui_sbcd_yimanxing_txt"
        if self.sp:IsMaxStar() then
            self.go_table.aorimage_maxstar:SetActiveE(1)
            self.go_table.aorbtn_star:SetActiveE(0)
            self.go_table.obj_Matrial:SetActiveE(0)
            self.go_table.aorbtn_star:SetActiveE(0)
        else
            self.go_table.aorbtn_star:SetActiveE(1)
            self.go_table.aorimage_maxstar:SetActiveE(0)
            self.go_table.aorbtn_star:SetActiveE(1)
            self.go_table.obj_Matrial:SetActiveE(1)
            local datas = {{self.sp.cfg.materials[star][1], self.sp.cfg.materials[star][2] or 0}}
            local consumeResList = {}
            for _, v in ipairs(datas) do
                if v[2] > 0 then
                    _G.table.insert(consumeResList, {v[1], false, v[2]})
                end

            end
            if not self.resConsume then
                self.resConsume = self:AddComponent(self.go_table.obj_Matrial,
                    require("ConsumeCompont").New(self.go_table.obj_Matrial, consumeResList, nil, nil, true, {
                        textColorType = 4,
                        showNow = true
                    }))
            else
                self.resConsume:RestRs(consumeResList)
            end
        end

    else

        local level = self.sp:GetLevel()
        self.go_table.aorbtn_star:SetGray(not self.sp:IsCanLevelUp())
        self.go_table.aorimage_maxstar.SpriteName = "ui_sbcd_yimanji_txt"

        if self.sp:IsMaxLevel() then
            self.go_table.aorimage_maxstar:SetActiveE(1)
            self.go_table.aorbtn_star:SetActiveE(0)
            self.go_table.obj_Matrial:SetActiveE(0)
            self.go_table.aorbtn_star:SetActiveE(0)
            self.go_table.aorimage_autobg:SetActiveE(0)
        else
            self.go_table.aorbtn_star:SetActiveE(1)
            self.go_table.aorimage_maxstar:SetActiveE(0)
            self.go_table.aorbtn_star:SetActiveE(1)
            self.go_table.obj_Matrial:SetActiveE(1)
            self.go_table.aorimage_autobg:SetActiveE(1)
            --- 升级
            self:UpdateLevelUpAutoBtn()
        end
    end

end

---按钮点击事件在这里派发
function RemainsInfoView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if go == self.go_table.aorbtn_star then
        self:RecordPower()
        if self.ToggleType == 1 then
            if (not self.sp:GetIsActive() and not self.sp:IsCanActive()) or
                (self.sp:GetIsActive() and not self.sp:IsCanStarUp()) then
                local quickUseBox = _G.StorageManager:GetInstance():SpoilsFastCheckItem(self.sp.cfg.id, function()
                    self:UpdateAll()
                end)
                if quickUseBox then
                    return
                end
                -- _G.JumpManager:GetInstance():Jump(221002)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name,
                    self.sp.cfg.materials[self.sp:GetStar() + 2][1])
            else
                -- self.lastProp = RemainsModel:GetInstance():GetAllOtherProp()

                if self.sp:GetIsActive() then
                    self.go_table.obj_effect2:SetActiveE(1)
                    self.go_table.obj_mask:SetActiveE(1)
                    _G.DelayDo(1.5, function()
                        if self:IsNil() then
                            return
                        end
                        RemainsModel:GetInstance():UpStar(self.sp.cfg.id, self.sp:GetStar() + 1, function()
                            self:UpdateProp()
                            self:UpdateAll()
                            self:ShowPowerUp()
                            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RemainsActiveView.Name,
                                self.sp, 2)

                            -- local curProp = RemainsModel:GetInstance():GetAllOtherProp()
                            -- _G.UIUtils.ShowPropUp(nil, self.lastProp, nil, {
                            --     prop = curProp
                            -- })
                        end)

                        self.go_table.obj_mask:SetActiveE(0)
                        self.go_table.obj_effect2:SetActiveE(0)
                    end)

                else
                    RemainsModel:GetInstance():ActiveSelf(self.sp.cfg.id, function()
                        self:UpdateProp()
                        self:UpdateAll()
                        self:ShowPowerUp()
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RemainsActiveView.Name, self.sp)

                        -- local curProp = RemainsModel:GetInstance():GetAllOtherProp()
                        -- _G.UIUtils.ShowPropUp(nil, self.lastProp, nil, {
                        --     prop = curProp
                        -- })
                    end)
                end
            end
        else
            if self.sp:IsCanLevelUp() then
                local iAuto = self.playType == LevelUpAutoType.Auto
                local level = iAuto and self.sp:GetCanLevelUpMax() or self.sp:GetLevel() + 1

                RemainsModel:GetInstance():UpLevel(self.sp.cfg.id, level, function()
                    self:UpdateProp()
                    self:UpdateAll()
                    self:ShowPowerUp()

                end)
                self.go_table.obj_effect3:SetActiveE(0)
                self.go_table.obj_effect3:ClearChildren()
                --- 升级特效
                _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_RemainsInfoView_saoguang,
                    self.go_table.obj_effect3, function(trans)
                        if self:IsNil() then
                            _G.DestroyObject(trans)
                        end

                        self.EffectLevel = trans
                        _G.DelayDo(0.1, function()
                            if not self.EffectLevel or not self.go_table then
                                return
                            end
                            self.go_table.obj_effect3:SetActiveE(1)
                            _G.DelayDo(0.5, function()
                                if not self.EffectLevel or not self.go_table then
                                    return
                                end
                                self.go_table.obj_effect3:SetActiveE(0)
                            end)
                        end)
                    end)

            else
                _G.PopWindowManager:GetInstance():ShowAllTips(607)
            end

        end
    elseif name == "@_toggle_Toggle1" then
        self.ToggleType = 1
        self:InitView()
    elseif name == "@_toggle_Toggle2" then
        self.ToggleType = 2
        self:InitView()

        -- elseif go == self.go_table.aorbtn_titleTip then
        --     _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RemainsInfoMaxView.Name, self.sp)
    elseif go == self.go_table.aorbtn_titleTip2 then
        -- if not self.sp:GetIsActive() then
        --     _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RemainsInfoMaxView.Name, self.sp)
        -- else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonTipView.Name, _G.TipType.Remains, self.sp)
        -- end
        -- local fetterCfg = _G.ConfigManager.remains_fetter_cfg
        -- _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RemainsSuitView.Name, fetterCfg[self.sp.cfg.suit])
    elseif go == self.go_table.aorbtn_closeView then
        self:Close()
    elseif go == self.go_table.aorbtn_autoLeft then
        self:UpdateLevelUpAutoBtn(1 - self.playType)
    end
end

function RemainsInfoView:UpdateLevelUpAutoBtn(type)
    if type == nil then
        self.playType = _G.PlayerPrefsManager.GetInt("RedPointRemainsLevelUpAuto")
        if self.playType == nil then
            self.playType = LevelUpAutoType.None
        end
    else
        self.playType = type
    end
    _G.PlayerPrefsManager.SetInt("RedPointRemainsLevelUpAuto", self.playType)
    local iAuto = self.playType == LevelUpAutoType.Auto
    local endLevel = self.sp:GetCanLevelUpMax()

    self.go_table.aortext_star.text = iAuto and endLevel - self.sp:GetLevel() > 0 and
                                          _G.GetLangPackValue(90021800244, endLevel - self.sp:GetLevel()) or
                                          _G.GetLangPackValue(9002050015)
    self.go_table.aorimage_skip:SetActiveE(iAuto and 1 or 0)

    local consumeResList = {}
    local cfg1, cfg2 = self.sp:LevelUpMaterial()

    if iAuto then
        cfg1, cfg2 = self.sp:LevelUpMaterial(nil,
            endLevel - self.sp:GetLevel() > 0 and endLevel or self.sp:GetLevel() + 1)
    end

    for k, v in ipairs(cfg1) do
        if v[2] > 0 then
            _G.table.insert(consumeResList, {v[1], false, v[2] - cfg2[k][2]})
        end

    end
    if not self.resConsume then
        self.resConsume = self:AddComponent(self.go_table.obj_Matrial,
            require("ConsumeCompont").New(self.go_table.obj_Matrial, consumeResList, nil, nil, true, {
                textColorType = 4,
                showNow = true
            }))
    else
        self.resConsume:RestRs(consumeResList)
    end
end

function RemainsInfoView:RecordPower()
    self.power = _G.StorageManager:GetInstance():GetPlayerPower()
end

function RemainsInfoView:ShowPowerUp()
    ---临时等级提升不显示战力变化
    local newPower = _G.StorageManager:GetInstance():GetPlayerPower()
    local offset = newPower - self.power
    if offset > 0 then
        require"CommonTipManager".OpenPowerUpView(self.power, offset)
    end

    self.power = newPower
end

---@private
function RemainsInfoView:OnDestroy()
end

return RemainsInfoView
