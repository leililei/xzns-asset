local RemainsModel = require("RemainsModel")

---@class RemainsInfoMaxView : UIBaseView    中文描述
---@field public go_table RemainsInfoMaxView_GoTable GoTable
---@field cfgList limit_broken_cfg[]
---@field sp RemainsData
local RemainsInfoMaxView = _G.BaseClass("RemainsInfoMaxView", _G.UIBaseView)

function RemainsInfoMaxView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function RemainsInfoMaxView:OnCreate(sp, type)
    self.ToggleType = type or 1
    self.sp = sp
    self:InitView()
end

---初始化页面
function RemainsInfoMaxView:InitView()
    self.go_table.aortmp_name.text = _G.GetLangPackValue(self.sp.cfg.name)
    self.go_table.aorrawimage_remains:LoadImage(self.sp.cfg.icon)
    self.go_table.aorimage_IconBg.SpriteName = _G.ItemBaseIconName[self.sp.cfg.grade]

    self.go_table.scrollloopvectical_propList:InitItemData(0, _G.handler(self, self.RefreshPropItem))
    self:UpdateProp()
    self:UpdateAll()
end

function RemainsInfoMaxView:UpdateProp()
    self.propList = {}
    local prop = self.sp.cfg
    for _, v in ipairs(prop.att1) do
        if _G.AttrType[v[1]] then
            local star = self.sp:GetStar() + 1
            local nextV
            nextV = 0
            _G.table.insert(self.propList, {
                name = _G.AttrType[v[1]].des,
                value = _G.Mathf.RoundToInt(self.sp.cfg.rate[#self.sp.cfg.rate] * v[3] / 10000),
                icon = _G.AttrTypeIcon[v[1]],
                nextValue = nextV,
                percentage = v[2],
                proptype = _G.AttrType[v[1]].proptype,
            })
        end
    end

    self.go_table.scrollloopvectical_propList:UpdateCount(#self.propList)
end

function RemainsInfoMaxView:RefreshPropItem(index, obj)
    local tb = GetAutoGoTable(obj)
    local value = "+" .. self.propList[index + 1].value
    if self.sp:IsMaxStar() then
        self.propList[index + 1].nextValue = _G.GetLangPackValue(90022300065)
        if self.propList[index + 1].percentage == "2" or self.propList[index + 1].proptype ~= 1 then
            value = "+" .. _G.Mathf.RoundToInt(value / 100) .. "%"
        end
        tb.aorimage_arrow2:SetActiveE(0)
        tb.aortmp_nextValue:SetActiveE(0)
    else
        local nextValue = "+" .. self.propList[index + 1].nextValue
        if self.propList[index + 1].percentage == "2" or self.propList[index + 1].proptype ~= 1 then
            value = "+" .. _G.Mathf.RoundToInt(value / 100) .. "%"
            nextValue = "+" .. _G.Mathf.RoundToInt(nextValue / 100) .. "%"
        end
        if self.propList[index + 1].nextValue ~= 0 then
            tb.aortmp_nextValue.text = nextValue
            tb.aorimage_arrow2:SetActiveE(1)
            tb.aortmp_nextValue:SetActiveE(1)
        else
            tb.aorimage_arrow2:SetActiveE(0)
            tb.aortmp_nextValue:SetActiveE(0)
        end
    end
    tb.aorimage_icon.SpriteName = self.propList[index + 1].icon
    tb.aortmp_propName.text = self.propList[index + 1].name
    tb.aortmp_curValue.text = value
end

function RemainsInfoMaxView:UpdateAll()
    self.go_table.aortmp_Level.text = _G.GetLangPackValue(90031900006, self.sp:GetMaxLevel())
    local txt = self.sp.cfg.language ~= 0 and _G.GetLangPackValue(self.sp.cfg.language) or ""
    self.go_table.aortmp_attrDesc.text = txt..self.sp:GetLevelMaxProp()
    -- self.go_table.aortmp_attrDesc2.text = self.sp:GetLevelMaxProp()

    self.go_table.obj_stars:SetActiveE(1)
    for i = 1, 5 do
        self.go_table["aorimage_Star" .. i]:SetActiveE(1)
        self.go_table["aorimage_Star" .. i].SpriteName = "Ui_img_xing_cai"
    end
end

---按钮点击事件在这里派发
