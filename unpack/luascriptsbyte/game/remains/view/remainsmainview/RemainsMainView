---界面的入口函数
function RemainsMainView:OnCreate(name)
    -- _G.Events:GetInstance():Broadcast(_G.eNewFunctionOpen.Open)
    self:InitView()
    self.curView = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.RemainsMainView.Name)
    if name then
        self:ChangeView(name)
    else
        local icon = self.go_table[self.ToggleDic[self.WindowName.Main]]:FindE("Icon"):GetComponentE(_G.typeof(_G.CS
                                                                                                                   .AorImage))
        local bg = self.go_table[self.ToggleDic[self.WindowName.Main]]:FindE("bg"):GetComponentE(_G.typeof(_G.CS
                                                                                                               .AorImage))
        -- icon.SpriteName = self.IconDic[self.WindowName.Main] .. "_c_icon"
        bg:SetActiveE(1)
    end

    self:AddListener(_G.eRemainsUpdate.RemainsUpdate, self.InitView)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
end

function RemainsMainView:InitData()
    if self.ToggleOrder == 1 then
        self.SuitDatas = RemainsModel:GetInstance():GetAllDatasShowList(1)
    elseif self.ToggleOrder == 2 then
        self.SuitDatas = RemainsModel:GetInstance():GetAllDatasShowList(2)
        self.go_table.aortext_Tips.text = _G.GetLangPackValue(90050100069)
    elseif self.ToggleOrder == 3 then
        self.SuitDatas = RemainsModel:GetInstance():GetAllDatasShowList(3)
        self.go_table.aortext_Tips.text = _G.GetLangPackValue(90050100070)
    end
    table.sort(self.SuitDatas, function(a, b)
        if a.grade == b.grade then

            if a.type == b.type then
                return a.order > b.order

            end
            return a.type < b.type

        else
            return a.grade > b.grade

        end
    end)
    self.go_table.aortext_Tips:SetActiveE(#self.SuitDatas > 0 and 0 or 1)
end

---初始化页面
function RemainsMainView:InitView()
    self:InitData()
    self:UpdateAll()
end

function RemainsMainView:UpdateAll()
    if self.Init == nil then
        self.go_table.looplist2_item:InitListView(#self.SuitDatas, _G.handler(self, self.RefreshItem))
        self.Init = true
    else
        self.go_table.looplist2_item:SetListItemCount(#self.SuitDatas)
        -- self.go_table.looplist2_item:ResetListView()
        self.go_table.looplist2_item:RefreshAllShownItem()
    end
    self.go_table.aorbtn_decompose:SetActiveE(RemainsModel:GetInstance():IsDecomposeBtn())
end

function RemainsMainView:RefreshItem(listView2, index)
    local t_index = index + 1
    if not self.SuitDatas[t_index] then
        return
    end
    local type = self.SuitDatas[t_index].type
    local data = self.SuitDatas[t_index]

    local item
    if type > 1 then
        item = listView2:NewListViewItem("$_obj_item2")
        self:InitItem(item, data, true)
    else
        item = listView2:NewListViewItem("$_obj_item1")
        self:InitItem(item, data, false)
    end
    return item
end

function RemainsMainView:InitItem(objGame, data, isItem)
    local tb = _G.GetAutoGoTable(objGame)
    if not isItem then
        local all = RemainsModel:GetInstance():GetAllDatasByGrade(data.grade, false)
        local cur = RemainsModel:GetInstance():GetAllDatasByGrade(data.grade, true)
        if self.ToggleOrder == 3 then
            cur = RemainsModel:GetInstance():GetCanLevelUpAll(data.grade)
        elseif self.ToggleOrder == 2 then
            cur = RemainsModel:GetInstance():GetCanStarUpAll(data.grade)
        end
        tb.aortext_name.text = self.TitleName[data.grade] .. "(" .. cur .. "/" .. all .. ")"
    else
        for i = 1, 4 do
            if data[i] then
                tb["obj_ChildItem" .. i]:SetActiveE(1)
                local childtb = _G.GetAutoGoTable(tb["obj_ChildItem" .. i],
                    _G.handlerbind(self, self.OnClick_item, data[i]))
                -- childtb.aortext_name.text = self.NameColor[self.cfg[data[i].sid].grade] ..
                --                                 _G.GetLangPackValue(self.cfg[data[i].sid].name) .. "</color>"
                childtb.aortext_name.text = _G.GetLangPackValue(self.cfg[data[i].sid].name)
                local remainData = RemainsModel:GetInstance():GetData(data[i].sid)
                childtb.aorimage_nameBg.SpriteName = self.Quility[remainData.cfg.grade]
                childtb.aorimage_colorBg.SpriteName = self.QuilityBG[remainData.cfg.grade]
                childtb.aorimage_colorBg:SetNativeSize()
                childtb.obj_effect:ClearChildren()
                childtb.obj_effect:SetActiveE(0)
                if remainData:GetIsActive() and remainData:GetOrder() ~= _G.RemainsQuilty.cai then
                    childtb.obj_effect:SetActiveE(1)
                    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_RemainsMainView_loop,
                        childtb.obj_effect, function(trans)
                            if self:IsNil() then
                                _G.DestroyObject(trans)
                            end
                        end)
                end

                if remainData:GetIsActive() and remainData:GetOrder() == _G.RemainsQuilty.cai then
                    childtb.obj_effect:SetActiveE(1)
                    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_RemainsMainView_loopup,
                        childtb.obj_effect, function(trans)
                            if self:IsNil() then
                                _G.DestroyObject(trans)
                            end
                        end)
                elseif not remainData:GetIsActive() and remainData:GetOrder() == _G.RemainsQuilty.cai then
                    childtb.obj_effect:SetActiveE(1)
                    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_RemainsMainView_lizi,
                        childtb.obj_effect, function(trans)
                            if self:IsNil() then
                                _G.DestroyObject(trans)
                            end
                        end)
                end

                childtb.aorimage_active:SetActiveE(0)
                childtb.aorimage_Tips:SetActiveE(0)
                childtb.aorimage_starUp:SetActiveE(0)
                childtb.aorimage_levelUp:SetActiveE(0)

                -- 可升级界面特殊处理
                if self.ToggleOrder == 3 then

                    if not remainData:GetIsActive() and remainData:IsCanActive() then
                        childtb.aorimage_active:SetActiveE(1)
                        childtb.aorimage_levelUp:SetActiveE(0)
                    end
                    if remainData:GetIsActive() and remainData:IsCanStarUp() then
                        childtb.aorimage_starUp:SetActiveE(1)
                        childtb.aorimage_levelUp:SetActiveE(0)
                    end

                    if remainData:GetIsActive() and remainData:IsCanLevelUp() then
                        childtb.aorimage_levelUp:SetActiveE(1)
                        childtb.aorimage_starUp:SetActiveE(0)
                        childtb.aorimage_active:SetActiveE(0)
                    end
                else
                    if remainData:GetIsActive() and remainData:IsCanLevelUp() then
                        childtb.aorimage_levelUp:SetActiveE(1)
                    end
                    if not remainData:GetIsActive() and remainData:IsCanActive() then
                        childtb.aorimage_active:SetActiveE(1)
                        childtb.aorimage_levelUp:SetActiveE(0)
                    end
                    if remainData:GetIsActive() and remainData:IsCanStarUp() then
                        childtb.aorimage_starUp:SetActiveE(1)
                        childtb.aorimage_levelUp:SetActiveE(0)
                    end
                end

                childtb.aorrawimage_icon:LoadImage(self.cfg[data[i].sid].icon, function(tran)
                    tran:SetNativeSize()
                    tran:SetLocalScaleXYZ(0.53)
                end)

                if self.cfg[data[i].sid].suit ~= 0 then
                    childtb.aorimage_Tips:SetActiveE(1)
                    childtb.aorimage_Tips.SpriteName = self.QuilityTipsBG[remainData.cfg.grade]
                    childtb.aortext_TipsName:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = _G.ColorTools
                                                                                                            .FormatColorByString(
                        self.TipOutLineColor[remainData.cfg.grade])
                    childtb.aortext_TipsName.text = _G.LangUtil.GetLangPackValue(remainData.cfg.badge)
                end

                childtb.obj_stars:SetActiveE(remainData:GetIsActive() and 1 or 0)
                childtb.aorrawimage_icon:SetGray(not remainData:GetIsActive())
                for i = 1, 5 do
                    if remainData:GetStar() <= 5 then
                        if remainData:GetStar() >= i then
                            childtb["aorimage_star" .. i].SpriteName = "ui_img_xing"
                            -- childtb["aorimage_star" .. i]:SetActiveE(1)
                        else
                            -- childtb["aorimage_star" .. i]:SetActiveE(0)
                            childtb["aorimage_star" .. i].SpriteName = "ui_ty_kapaipinjie_0"
                            -- childtb["aorimage_star" .. i].SpriteName = "Ui_ty_kapaipinjie_zero_huang_heuse"
                        end
                    elseif remainData:GetStar() > 5 then
                        -- childtb["aorimage_star" .. i]:SetActiveE(1)
                        if remainData:GetStar() >= i + 5 then
                            childtb["aorimage_star" .. i].SpriteName = "ui_img_xing_hong"
                        else
                            childtb["aorimage_star" .. i].SpriteName = "ui_img_xing"
                        end
                    end
                end

                --- 进度条
                if not remainData:GetIsActive() then
                    childtb.aortext_Slider.text = remainData:GetStarUpCurHave() .. "/" .. remainData:GetStarUpCost()
                    childtb.slider_propress.value = remainData:GetStarUpCurHave() / remainData:GetStarUpCost()
                    childtb.slider_propress:SetActiveE(1)
                    childtb.aortext_Level:SetActiveE(0)
                    -- childtb.obj_stars:SetLocalPosition(0, -63, 0)
                    -- childtb.aortext_Level:SetLocalPosition(4, -32, 0)
                else
                    -- childtb.aortext_Level:SetLocalPosition(4, -60, 0)
                    -- childtb.obj_stars:SetLocalPosition(0, -95, 0)
                    childtb.slider_propress:SetActiveE(0)
                    childtb.aortext_Level:SetActiveE(1)
                    childtb.aortext_Level.text = _G.LangUtil.GetLangPackValue(9002010022, remainData:GetLevel())
                end

            else
                tb["obj_ChildItem" .. i]:SetActiveE(0)
            end
        end
    end

end

function RemainsMainView:OnClick_item(itemGoTable, isOn, data)

    local name = itemGoTable:GetName()
    local remainData = RemainsModel:GetInstance():GetData(data.sid)

    local type = 1
    if self.ToggleOrder == 3 then
        type = 2
    end

    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RemainsInfoView.Name, remainData, type)
end

function RemainsMainView:OnUIOpened(name)
    if name == _G.ConfigManager.ui_cfg.RemainsSuitView.Name then
        local canvas = self.go_table.obj_BottomBar:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
        _G.UIManager:GetInstance():ChangeCanvasOrder(name, canvas.sortingOrder - 5)
    elseif name == _G.ConfigManager.ui_cfg.RemainsDrawView.Name then
        local canvas = self.go_table.obj_BottomBar:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
        _G.UIManager:GetInstance():ChangeCanvasOrder(name, canvas.sortingOrder - 5)
    elseif name == _G.ConfigManager.ui_cfg.RemainsFetterView.Name then
        local canvas = self.go_table.obj_BottomBar:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
        _G.UIManager:GetInstance():ChangeCanvasOrder(name, canvas.sortingOrder - 5)
    end
end

function RemainsMainView:RecordPower()
    self.power = _G.StorageManager:GetInstance():GetPlayerPower()
end

function RemainsMainView:ShowPowerUp()
    ---临时等级提升不显示战力变化
    local newPower = _G.StorageManager:GetInstance():GetPlayerPower()
    local offset = newPower - self.power
    if offset > 0 then
        require"CommonTipManager".OpenPowerUpView(self.power, offset)
    end
    self.power = newPower
end

function RemainsMainView:ChangeView(name)
    if name == self.curView.Name then
        return
    end
    local UIManager = _G.UIManager:GetInstance()
    local canvas = self.go_table.obj_BottomBar:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))

    if name == self.WindowName.Treasury then
        local ctrl = require("IntegrateBpFdModel"):GetInstance():GetController(_G.Spoils.SpoilsBp)
        _G.UIManager:GetInstance():OpenWindow(ctrl:GetViewName(), ctrl)
    else
        local view = UIManager:OpenWindow(name)
        local bg = self.go_table[self.ToggleDic[name]]:FindE("bg"):GetComponentE(_G.typeof(_G.CS.AorImage))
        local nowBg = self.go_table[self.ToggleDic[self.curView.Name]]:FindE("bg"):GetComponentE(_G.typeof(_G.CS
                                                                                                               .AorImage))
        bg:SetActiveE(1)
        nowBg:SetActiveE(0)
        if self.curView.Name ~= self.WindowName.Main and name ~= self.WindowName.Treasury and name ~= self.curView.Name then
            UIManager:HideWindow(self.curView.Name)
        end
        self.curView = view
    end
end

---按钮点击事件在这里派发
function RemainsMainView:OnClickBtn(go, isOn)
    local UIManager = _G.UIManager:GetInstance()
    local name = go:GetName()
    if go == self.go_table.aorbtn_close then
        self:Close()
        for _, window in pairs(self.WindowName) do
            local view = UIManager:GetWindow(window)
            if view then
                UIManager:CloseWindow(window)
            end
        end
    elseif go == self.go_table.aorbtn_help then
        if self.go_table.obj_prop:GetActiveSelf() == 1 then
            self.go_table.obj_prop:SetActiveE(0)
        else
            self.go_table.obj_prop:SetActiveE(1)
        end
    elseif go == self.go_table.aorbtn_main then
        self:ChangeView(self.WindowName.Main)
    elseif go == self.go_table.aorbtn_suit then
        self:ChangeView(self.WindowName.Suit)
    elseif go == self.go_table.aorbtn_draw then
        self:ChangeView(self.WindowName.Draw)
    elseif go == self.go_table.aorbtn_treasury then
        self:ChangeView(self.WindowName.Treasury)
    elseif go == self.go_table.aorbtn_recycle then
        self:ChangeView(self.WindowName.Recycle)
    elseif go == self.go_table.aorbtn_closeProp then
        self.go_table.obj_prop:SetActiveE(0)
    elseif go == self.go_table.aorbtn_attribute then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TeamHallAttrRemainsPanel.Name)
    elseif go == self.go_table.aorbtn_helpTip then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 224)
    elseif name == "@_obj_Toggle1" then

        if self.ToggleOrder ~= 1 then
            -- self.Init = nil
            -- self.go_table.looplist2_item:InitListView(0, _G.handler(self, self.RefreshItem))
            self.ToggleOrder = 1
            self:InitView()
        end

    elseif name == "@_obj_Toggle2" then
        if self.ToggleOrder ~= 2 then
            -- self.Init = nil
            -- self.go_table.looplist2_item:InitListView(0, _G.handler(self, self.RefreshItem))
            self.ToggleOrder = 2
            self:InitView()
        end
    elseif name == "@_obj_Toggle3" then
        if self.ToggleOrder ~= 3 then
            -- self.Init = nil
            -- self.go_table.looplist2_item:InitListView(0, _G.handler(self, self.RefreshItem))
            self.ToggleOrder = 3
            self:InitView()
        end

    elseif go == self.go_table.aorbtn_decompose then
        self:OnClickEquipmentDecompose()
    end
end

function RemainsMainView:OnClickEquipmentDecompose()
    local params = {}
    params.titleText = 90050100061
    params.titleMidText = 90050100062
    params.DecomposeText = 90050100060
    params.DeComposeCall = function()

    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecomposeView.Name, _G.StorageID.Remains, params)
end

---@private
function RemainsMainView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    _G.Events:GetInstance():RemoveListener(_G.eRemainsUpdate.RemainsUpdate, self.InitView, self)
    if self.moveTween then
        for k, v in pairs(self.moveTween) do
            v:Kill()
        end
        self.moveTween = nil
    end
end

return RemainsMainView
