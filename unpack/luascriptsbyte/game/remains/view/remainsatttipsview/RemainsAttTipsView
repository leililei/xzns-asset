---@class RemainsAttTipsView : UIBaseView    中文描述
---@field public go_table RemainsAttTipsView_GoTable GoTable
local RemainsAttTipsView = _G.BaseClass("RemainsAttTipsView", _G.UIBaseView)
local RemainsModel = require("RemainsModel")

local ElementsName = {
    [1] = 90023200042,
    [2] = 90023200043,
    [3] = 90023200044,
    [4] = 90023200045
}

---构造函数
---@protected
function RemainsAttTipsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function RemainsAttTipsView:OnCreate()
    self:InitView()
end

---
---@protected
function RemainsAttTipsView:InitView()

    local list1 = RemainsModel:GetInstance():GetAllAttribute()
    local list2 = RemainsModel:GetInstance():GetAllAttribute2()

    local dic = {}

    for k, v in pairs(list1.attriOther) do
        local isNotHave = true
        for i = 1, #dic do
            if dic[i].name == k then
                dic[i].value = dic[i].value + v
                isNotHave = false
                break
            end

        end
        if isNotHave then
            _G.table.insert(dic, {
                name = _G.AttrType[k].des,
                value = v,
                icon = _G.AttrTypeIcon[k],
                percentage = "1",
                proptype = _G.AttrType[k].proptype
            })
        end

    end

    for k, v in pairs(list1.attributePercent) do
        local isNotHave = true
        for i = 1, #dic do
            if dic[i].name == k then
                dic[i].value = dic[i].value + v
                isNotHave = false
                break
            end

        end
        if isNotHave then
            _G.table.insert(dic, {
                name = _G.AttrType[k].des,
                value = v,
                icon = _G.AttrTypeIcon[k],
                percentage = "2",
                proptype = _G.AttrType[k].proptype
            })
        end

    end

    for k, v in pairs(list2.attriOther) do
        local isNotHave = true
        for i = 1, #dic do
            if dic[i].name == k then
                dic[i].value = dic[i].value + v
                isNotHave = false
                break
            end

        end
        if isNotHave then
            _G.table.insert(dic, {
                name = _G.AttrType[k].des,
                value = v,
                icon = _G.AttrTypeIcon[k],
                percentage = "1",
                proptype = _G.AttrType[k].proptype
            })
        end

    end

    for k, v in pairs(list2.attributePercent) do
        local isNotHave = true
        for i = 1, #dic do
            if dic[i].name == k then
                dic[i].value = dic[i].value + v
                isNotHave = false
                break
            end

        end
        if isNotHave then
            _G.table.insert(dic, {
                name = _G.AttrType[k].des,
                value = v,
                icon = _G.AttrTypeIcon[k],
                percentage = "2",
                proptype = _G.AttrType[k].proptype
            })
        end

    end

    self.dataDeepList = dic

    -- local attTableTotle = WarTechnologyModel:GetInstance():GetTotleAttribute2()
    self.go_table.obj_InfoScroll:SetActiveE(1)

    self.go_table.obj_title1:SetActiveE(#self.dataDeepList > 0 and 1 or 0)

    if self.dataDeepList ~= nil then
        local tb
        local obj, name, value
        for j = 1, #self.dataDeepList do
            obj = _G.InstantiateObject(self.go_table.obj_attrItem, self.go_table.obj_attribute1)
            obj:SetActiveE(1)
            tb = _G.GetAutoGoTable(obj)
            tb.aortext_name.text = self.dataDeepList[j].name
            -- tb.aortext_value.text = "+" .. self.dataDeepList[j].value
            if self.dataDeepList[j].percentage == "2" or self.dataDeepList[j].proptype ~= 1 then
                tb.aortext_value.text =
                    "+" .. _G.Mathf.RoundToInt((tonumber(self.dataDeepList[j].value)) * 10000) / 100 .. "%"
            else
                tb.aortext_value.text = "+" .. _G.Mathf.RoundToInt(tonumber(self.dataDeepList[j].value))
            end

            tb.aorimage_icon:SetActiveE(0)
        end
    end

    self.dataDeepList2 = RemainsModel:GetInstance():GetFettersDic()

    self.go_table.obj_title2:SetActiveE(#self.dataDeepList2 > 0 and 1 or 0)
    self.go_table.obj_attributeRoot2:SetActiveE(#self.dataDeepList2 > 0 and 1 or 0)

    if self.dataDeepList2 ~= nil then
        local tb
        local obj, name, value
        for j = 1, #self.dataDeepList2 do
            obj = _G.InstantiateObject(self.go_table.obj_attrItem, self.go_table.obj_attribute2)
            obj:SetActiveE(1)
            tb = _G.GetAutoGoTable(obj)
            tb.aortext_name.text = self.dataDeepList2[j].name
            -- tb.aortext_value.text = "+" .. self.dataDeepList[j].value
            if self.dataDeepList2[j].percentage == "2" or self.dataDeepList2[j].proptype ~= 1 then
                tb.aortext_value.text = "+" .. (tonumber(self.dataDeepList2[j].value)) / 100 .. "%"
            else
                tb.aortext_value.text = "+" .. _G.Mathf.RoundToInt(tonumber(self.dataDeepList2[j].value))
            end

            tb.aorimage_icon:SetActiveE(0)
        end
    end
    self.go_table.obj_nil:SetActiveE((#self.dataDeepList > 0 or #self.dataDeepList2 > 0) and 0 or 1)

end

---界面的销毁函数
function RemainsAttTipsView:OnDestroy()
end

---按钮点击事件在这里派发
function RemainsAttTipsView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

return RemainsAttTipsView
