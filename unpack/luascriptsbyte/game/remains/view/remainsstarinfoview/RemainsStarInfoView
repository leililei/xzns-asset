local RemainsModel = require("RemainsModel")

---@class RemainsStarInfoView : UIBaseView    中文描述
---@field public go_table RemainsStarInfoView_GoTable GoTable
---@field cfgList limit_broken_cfg[]
---@field sp RemainsData
local RemainsStarInfoView = _G.BaseClass("RemainsStarInfoView", _G.UIBaseView)

function RemainsStarInfoView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function RemainsStarInfoView:OnCreate(cfg)
    self.Cfg = cfg
    self:InitView()
end

---初始化页面
function RemainsStarInfoView:InitView()
    self.go_table.scrollloopvectical_propList:InitItemData(0, _G.handler(self, self.RefreshPropItem))
    self:UpdateProp()
end

function RemainsStarInfoView:UpdateProp()
    self.go_table.scrollloopvectical_propList:UpdateCount(#self.Cfg.att)
end

function RemainsStarInfoView:RefreshPropItem(index, obj)
    local tb = GetAutoGoTable(obj)
    local value = self.Cfg.att[index + 1]

    tb.aorimage_di:SetActiveE(index % 2 == 0 and 1 or 0)
    tb.aortext_propName.text = _G.GetLangPackValue(90020200027) .. _G.GetLangPackValue(90000010475, value[1])

    if value[1] == "0" then
        tb.aortext_propName.text = _G.GetLangPackValue(90020200027) .. _G.GetLangPackValue(90022300041)
    end
    tb.aortext_propName.text = tb.aortext_propName.text..":" .. _G.AttrType[value[2]].des
    if value[3] == "2" or _G.AttrType[value[2]].proptype ~= 1 then
        tb.aortext_curValue.text =
       "+" .. _G.Mathf.RoundToInt((tonumber(value[4]) / 100)) .. "%"
    else
        tb.aortext_curValue.text =  "+" .. tonumber(value[4])
    end

end

---按钮点击事件在这里派发
function RemainsStarInfoView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if go == self.go_table.aorbtn_star then

    elseif go == self.go_table.aorbtn_closeView then
        self:Close()
    end
end

---@private
function RemainsStarInfoView:OnDestroy()
end

return RemainsStarInfoView
