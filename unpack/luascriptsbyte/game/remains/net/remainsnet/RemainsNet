local base = require("BaseGameNet")

---@class RemainsNet : BaseGameNet	通信协议
local RemainsNet = _G.BaseClass("RemainsNet", base)
---@return RemainsNet RemainsNet
function RemainsNet:GetInstance()
    return base.GetInstance(self)
end

---获取信息
function RemainsNet:GetInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_remains_remains_info
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

