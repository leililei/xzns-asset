---@class RechargeAccumulateModel : GameDataModelBase 等级活到
local RechargeAccumulateModel = _G.BaseClass("RechargeAccumulateModel", _G.Singleton)

function RechargeAccumulateModel:__init()
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    self.itemCards = {}
end

---@return RechargeAccumulateModel RechargeAccumulateModel
function RechargeAccumulateModel:GetInstance()
    return self.super.GetInstance(self)
end

function RechargeAccumulateModel:AddItem(propData)
    self.itemCards[propData.sid] = propData
    if not self.timer0 then
        self.timer0 = _G.TimerManager:GetInstance():GetTimer(1, self.InitTimer, self, true, false, true)
        self.timer0:Start()
    end
end

function RechargeAccumulateModel:RemoveItem(sid)
    self.itemCards[sid] = nil
end

function RechargeAccumulateModel:GetAward(propData, call)
    local sid = propData.sid
    _G.StorageManager:GetInstance():UsePropToServer(
        sid,
        1,
        function()
            self:RemoveItem(sid)
            if call then
                call()
            end
        end
    )
end

function RechargeAccumulateModel:AddCashNum(price)
    if _G.table.count(self.itemCards) == 0 then
        return
    end
    local cards = _G.table.toArray(self.itemCards)
    _G.table.sort(
        cards,
        function(a, b)
            if a.args.time ~= b.args.time then
                return a:GetProgressChestArgs().time < b:GetProgressChestArgs().time
            end
            return a.sid < b.sid
        end
    )
    local delta
    for i = 1, #cards do
        if cards[i].progress < cards[i]:GetRechargeAccMaxProgress() then
            delta = cards[i]:GetRechargeAccMaxProgress() - cards[i].progress
            if price > delta then
                cards[i].progress = cards[i]:GetRechargeAccMaxProgress()
                price = price - delta
            else
                cards[i].progress = cards[i].progress + price
                break
            end
        end
    end
end

function RechargeAccumulateModel:OnMallCashListener(data)
    -- 判断是否为计入累计充值
    if not data.total_cash_bool then
        return
    end
    local cfg = _G.ConfigManager.store_piece_cfg[data.sid]
    if cfg ~= nil then
        local finalPrice = require "MallManager":GetInstance():GetFinalPrice(cfg.price_id)
        self:AddCashNum(finalPrice)
    else
        self:AddCashNum(data.cash_rmb)
    end
end

function RechargeAccumulateModel:InitTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.timer0 then
        self.timer0:Stop()
        self.timer0 = nil
    end
    local now = _G.TimeUtil.GetServerUnixTime()
    local time, et
    local removeLis = {}
    for _, v in pairs(self.itemCards) do
        et = v:GetRechargeAccEndTime()
        if now > et then
            _G.table.insert(removeLis, v.sid)
        else
            if time == nil or et < time then
                time = et
            end
        end
    end
    for _, sid in pairs(removeLis) do
        self:RemoveItem(sid)
        _G.StorageManager:GetInstance():ConsumeItem(sid, 0, 1)
    end
    if #removeLis > 0 then
        _G.Events:GetInstance():Broadcast(_G.eBag.BagRechargeAccOverdue)
    end
    if time then
        local endTime = time - _G.TimeUtil.GetServerUnixTime()
        if endTime > 0 then
            self.timer = _G.TimerManager:GetInstance():GetTimer(endTime, self.InitTimer, self, true, false, true)
            self.timer:Start()
        end
    end
end

function RechargeAccumulateModel:Dispose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.timer0 then
        self.timer0:Stop()
        self.timer0 = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

return RechargeAccumulateModel
