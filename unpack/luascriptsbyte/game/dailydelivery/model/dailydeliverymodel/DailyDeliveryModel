local DailyDeliveryNet = require "DailyDeliveryNet"
---@class DailyDeliveryModel
local DailyDeliveryModel = _G.BaseClass("DailyDeliveryModel", _G.GameDataModelBase)

DailyDeliveryModel.AwardID = {
    AM = 104002,
    PM = 104004
}

---@return DailyDeliveryModel DailyDeliveryModel
function DailyDeliveryModel:GetInstance()
    return self.super.GetInstance(self)
end

function DailyDeliveryModel:GetInfo(callback)
    DailyDeliveryNet:GetInstance():GetInfo(_G.handlerbind(self, self.GetInfoCall, callback))
end

---@param msg daily_delivery.s2c_daily_delivery_info
function DailyDeliveryModel:GetInfoCall(msg, callback)
    self.sids = msg.sids
    if callback then
        callback(self:CheckIsOver())
    end
    if not self.timer then
        self:StartTimer()
    end
end

function DailyDeliveryModel:StartTimer()
    self:RefreshRedPoint()
    if self:CheckIsOver() then
        return
    end
    local date = _G.TimeUtil.GetDateTime(_G.TimeUtil.GetServerUnixTime())
    local next = _G.ConfigManager.discrete_cfg[self.AwardID.PM][1][1]
    if date.hour > _G.ConfigManager.discrete_cfg[self.AwardID.PM][1][1] or date.hour < _G.TimeUtil.GAME_DAY_HOUR then
        next = _G.TimeUtil.GAME_DAY_HOUR
    elseif
        date.hour < _G.ConfigManager.discrete_cfg[self.AwardID.AM][1][1] or
            date.hour >= _G.ConfigManager.discrete_cfg[self.AwardID.PM][1][1]
     then
        next = _G.ConfigManager.discrete_cfg[self.AwardID.AM][1][1]
    end

    self.timer =
        _G.TimerManager:GetInstance():GetTimer(self:GetClockTimer(next), self.StartTimer, self, true, false, true)
    self.timer:Start()
end

function DailyDeliveryModel:GetClockTimer(hour)
    local curTime = _G.TimeUtil.GetServerUnixTime()
    local time = _G.TimeUtil.GetDateTime(_G.TimeUtil.GetServerUnixTime())
    local time2 = _G.TimeUtil.GetDayBegin(curTime)
    if time.hour > hour then
        return time2 + 86400 + hour * 3600 - curTime
    else
        return time2 + hour * 3600 - curTime
    end
end

function DailyDeliveryModel:Dispose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---检测奖励是否领取
---@param id number DailyDeliveryModel.AwardID
function DailyDeliveryModel:CheckIsGet(id)
    if not self.sids then
        return false
    end
    for _, v in pairs(self.sids) do
        if v == id then
            return true
        end
    end
    return false
end

---领取奖励
---@param id number DailyDeliveryModel.AwardID
function DailyDeliveryModel:GetReward(id, callback)
    DailyDeliveryNet:GetInstance():GetAward(
        id,
        function(data)
            if data.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            require "CommonTipManager".OpenCommonAwardView(data)
            self:RefreshRedPoint()
            if not self.sids then
                self.sids = {}
            end
            _G.table.insert(self.sids, id)
            if callback then
                callback()
            end
        end
    )
end
---设置红点刷新
function DailyDeliveryModel:SetFreshRedPoint(RefreshRedPointCall)
    self.RefreshRedPointCall = RefreshRedPointCall
end
function DailyDeliveryModel:RefreshRedPoint()
    if self.RefreshRedPointCall ~= nil then
        self.RefreshRedPointCall()
    end
end
---检测活动是否结束
function DailyDeliveryModel:CheckIsOver()
    return _G.TimeUtil.GetInterValDayByGame(_G.PlayerModel:GetInstance().create_time, _G.TimeUtil.GetServerUnixTime()) >=
        _G.ConfigManager.discrete_cfg[104001][1][1]
end

---获取活动天数
function DailyDeliveryModel:GetActiveTime()
    local str = ""
    local startime = _G.TimeUtil.GetDateTime(_G.PlayerModel:GetInstance().create_time)
    local endTime =
        _G.TimeUtil.GetDateTime(
        _G.TimeUtil.GetDayBegin(_G.PlayerModel:GetInstance().create_time) +
            (_G.ConfigManager.discrete_cfg[104001][1][1] - 1) * 24 * 3600
    )
    --str = startime.month .. "." .. startime.day .. "-" .. endTime.month .. "." .. endTime.day
    str = _G.LangUtil.GetLangPackValue(90023800033, startime.month, startime.day, endTime.month, endTime.day)
    return str
end

---检测奖励是否到时间领取
function DailyDeliveryModel:CheckRewardCanReward()
    if self:CheckIsOver() then
        return false
    end

    local date = _G.TimeUtil.GetDateTime(_G.TimeUtil.GetServerUnixTime())

    if date.hour < _G.TimeUtil.GAME_DAY_HOUR then
        for _, v in pairs(self.AwardID) do
            if not self:CheckIsGet(v) then
                return true
            end
        end
        return false
    else
        for _, v in pairs(self.AwardID) do
            if not self:CheckIsGet(v) and date.hour >= _G.ConfigManager.discrete_cfg[v][1][1] then
                return true
            end
        end
    end
    return false
end
---获取奖励数据
function DailyDeliveryModel:GetAwardData(id)
    local award = {}
    local cfg = _G.ConfigManager.discrete_cfg[id + 1]
    if cfg then
        for i = 1, #cfg do
            local data = _G.StorageManager:GetInstance():GetItemDataClassByCfg(cfg[i])
            award[i] = data
        end
    end
    return award
end

return DailyDeliveryModel
