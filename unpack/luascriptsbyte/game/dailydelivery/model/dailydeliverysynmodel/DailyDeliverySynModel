local base = require "ActivitySynTypeBase"
---@class DailyDeliverySynModel : ActivitySynTypeBase	中文描述
local DailyDeliverySynModel = _G.BaseClass("DailyDeliverySynModel", base)
-- _G.DailyDeliverySynModel = DailyDeliverySynModel

-- local CS = _G.CS
-- local typeof = _G.typeof

---创建对象时,入口构造函数
function DailyDeliverySynModel:__init()
    self.DailyDeliveryModel = require "DailyDeliveryModel":GetInstance()
    self.DailyDeliveryModel:SetFreshRedPoint(_G.handler(self, self.RefreshRedPoint))
end

--- 网络请求初始化
function DailyDeliverySynModel:GetDataFormServer()
    self.DailyDeliveryModel:GetInfo(_G.handler(self, self.ParseData))
end
---数据解析完成
function DailyDeliverySynModel:ParseData(isClose)
    if isClose then
        self.curActivityClass:ChangeState(require "ActivitySynManager".State.Close)
    end
    base.ParseData(self)
end
function DailyDeliverySynModel:InitFunction()
    self.DailyDeliveryModel:InitFunction()
end
---进入活动主体
function DailyDeliverySynModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DailyDeliveryView.Name)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end
function DailyDeliverySynModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.DailyDeliveryView.Name
end
---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function DailyDeliverySynModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end
function DailyDeliverySynModel:CheckRedPoint()
    return self.DailyDeliveryModel:CheckRewardCanReward() and 1 or 0
end
---刷新奖励红点
function DailyDeliverySynModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function DailyDeliverySynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end
--endregion

--endregion
---销毁对象时,析构函数
function DailyDeliverySynModel:Dispose()
end

return DailyDeliverySynModel
