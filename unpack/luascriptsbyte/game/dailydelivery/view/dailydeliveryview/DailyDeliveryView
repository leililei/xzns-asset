---初始化界面显示
function DailyDeliveryView:initView()
    if not self.AMTb then
        self.AMTb =
            _G.GetAutoGoTable(
            self.go_table.obj_left,
            _G.handlerbind(self, self.OnClickBtn, DailyDeliveryModel.AwardID.AM)
        )
    end

    if not self.PMTb then
        self.PMTb =
            _G.GetAutoGoTable(
            self.go_table.obj_right,
            _G.handlerbind(self, self.OnClickBtn, DailyDeliveryModel.AwardID.PM)
        )
    end
    self:InitTime()
    self:RefreshAward()
    self:CreatEf()
    --self:InitTitle()
end

