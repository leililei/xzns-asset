end

---初始化时间
function DailyDeliveryView:InitTime()
    local time = _G.TimeUtil.GetServerUnixTime()
    local day = _G.TimeUtil.GetIntervalDay(_G.PlayerModel:GetInstance().create_time, time)
    self.curDate = _G.TimeUtil.GetDateTime(time)
    self.isOver = DailyDeliveryModel:GetInstance():CheckIsOver()
    if not self.isOver then
        if self.curDate.hour < _G.TimeUtil.GAME_DAY_HOUR then
            self.timer =
                _G.TimerManager:GetInstance():GetTimer(
                _G.TimeUtil.GetSixClockTimer(),
                self.RefreshPanel,
                self,
                true,
                false,
                true
            )
        elseif self.curDate.hour < _G.ConfigManager.discrete_cfg[DailyDeliveryModel.AwardID.AM][1][1] then
            self.timer =
                _G.TimerManager:GetInstance():GetTimer(
                self:GetClockTimer(_G.ConfigManager.discrete_cfg[DailyDeliveryModel.AwardID.AM][1][1]),
                self.RefreshPanel,
                self,
                true,
                false,
                true
            )
        elseif self.curDate.hour < _G.ConfigManager.discrete_cfg[DailyDeliveryModel.AwardID.PM][1][1] then
            self.timer =
                _G.TimerManager:GetInstance():GetTimer(
                self:GetClockTimer(_G.ConfigManager.discrete_cfg[DailyDeliveryModel.AwardID.PM][1][1]),
                self.RefreshPanel,
                self,
                true,
                false,
                true
            )
        else
            self.timer =
                _G.TimerManager:GetInstance():GetTimer(
                _G.TimeUtil.GetSixClockTimer(),
                self.RefreshPanel,
                self,
                true,
                false,
                true
            )
        end
        self.timer:Start()
    end
    --活动天数
    --local activetime = require "DailyDeliveryModel":GetInstance():GetActiveTime()
    --self.go_table.aortext_ActiveTime.text = _G.LangUtil.GetLangPackValue(90023800032) .. activetime
end

function DailyDeliveryView:GetClockTimer(hour)
    local curTime = _G.TimeUtil.GetServerUnixTime()
    local time = _G.TimeUtil.GetDateTime(_G.TimeUtil.GetServerUnixTime())
    local time2 = _G.TimeUtil.GetDayBegin(curTime)
    if time.hour > hour then
        return time2 + 86400 + hour * 3600 - curTime
    else
        return time2 + hour * 3600 - curTime
    end
end

function DailyDeliveryView:OnEnable()
    self:RefreshPanel()
end

function DailyDeliveryView:OnDisable()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

