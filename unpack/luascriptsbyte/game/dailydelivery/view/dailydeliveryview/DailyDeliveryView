---初始化派送显示
function DailyDeliveryView:InitAward(id, tb)
    --tb.aorbtn_get:SetGray(true)
    --tb.aortext_label.text = _G.LangUtil.GetLangPackValue(90024200002)
    local show = function(isShow)
        _G.GameUtil.SetActiveByCondition(tb.aorbtn_kelingqu, isShow)
        _G.GameUtil.SetActiveByCondition(tb.aorbtn_off, not isShow)
    end
    if self.isOver then
        show(false)
    else
        local isGet = DailyDeliveryModel:GetInstance():CheckIsGet(id)
        if isGet then
            --show(false)
            _G.GameUtil.SetActiveByCondition(tb.aorbtn_kelingqu, false)
            _G.GameUtil.SetActiveByCondition(tb.aorbtn_off, false)
            _G.GameUtil.SetActiveByCondition(tb.aorbtn_yilingqu, true)
        else
            if self.curDate.hour >= 0 and self.curDate.hour < _G.TimeUtil.GAME_DAY_HOUR then
                --show(true)
                _G.GameUtil.SetActiveByCondition(tb.aorbtn_kelingqu, true)
                _G.GameUtil.SetActiveByCondition(tb.aorbtn_off, false)
                _G.GameUtil.SetActiveByCondition(tb.aorbtn_yilingqu, false)
            elseif self.curDate.hour < _G.ConfigManager.discrete_cfg[id][1][1] then
                --tb.aortext_label.text = "未开始"
                --show(false)
                _G.GameUtil.SetActiveByCondition(tb.aorbtn_kelingqu, false)
                _G.GameUtil.SetActiveByCondition(tb.aorbtn_off, true)
                tb.aorbtn_off:SetGray(true)
                _G.GameUtil.SetActiveByCondition(tb.aorbtn_yilingqu, false)
            else
                --show(true)
                _G.GameUtil.SetActiveByCondition(tb.aorbtn_kelingqu, true)
                _G.GameUtil.SetActiveByCondition(tb.aorbtn_off, false)
                _G.GameUtil.SetActiveByCondition(tb.aorbtn_yilingqu, false)
            end
        end
    end
    local parent = id == DailyDeliveryModel.AwardID.AM and self.go_table.obj_noon or self.go_table.obj_even
    local award = _G.ConfigManager.discrete_cfg[id + 1]
    for i = 1, #award do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            award[i],
            parent,
            function(tran)
                tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                if not self.IconEfAm or not self.IconEfPm then
                    _G.UIUtils.LoadEffectByCfg(
                        _G.ConfigManager.ui_effect_cfg.ef_DailyDeliveryView_icon,
                        tran.gameObject
                    )
                end
                tran.gameObject:SetLocalScaleXYZ(0.6)
            end
        )
    end
    if not self.IconEfAm and id == DailyDeliveryModel.AwardID.AM then
        self.IconEfAm = true
    elseif not self.IconEfPm and id == DailyDeliveryModel.AwardID.PM then
        self.IconEfPm = true
    end
end

function DailyDeliveryView:RefreshAward()
    --清空
    for i = 1, self.go_table.obj_noon:GetChildCountE() do
        _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_noon:GetChildE(0), _G.ePoolType.UIItem)
    end
    for j = 1, self.go_table.obj_even:GetChildCountE() do
        _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_even:GetChildE(0), _G.ePoolType.UIItem)
    end
    self:InitAward(DailyDeliveryModel.AwardID.AM, self.AMTb)
    self:InitAward(DailyDeliveryModel.AwardID.PM, self.PMTb)
end

---按钮点击事件在这里派发
function DailyDeliveryView:OnClickBtn(go, isOn, id)
    local name = go:GetName()
    if name == "@_aorbtn_kelingqu" then
        DailyDeliveryModel:GetInstance():GetReward(
            id,
            function()
                self:RefreshAward()
            end
        )
    elseif name == "@_aorbtn_get" then
        local tb
        if id == DailyDeliveryModel.AwardID.PM then
            tb = self.PMTb
        else
            tb = self.AMTb
        end
        if self.curDate.hour < _G.ConfigManager.discrete_cfg[id][1][1] then
            _G.PopWindowManager:GetInstance():ShowAllTips(470102)
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(17)
        end
    elseif name == "@_aorbtn_off" then
        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DailyPreAwardView.Name, id)
        _G.PopWindowManager:GetInstance():ShowAllTips(470102)
    elseif name == "@_aorbtn_yilingqu" then
        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DailyPreAwardView.Name, id)
        --_G.PopWindowManager:GetInstance():ShowAllTips(600101)
        _G.PopWindowManager:GetInstance():ShowAllTips(500101)
    end
end
function DailyDeliveryView:CloseView()
    self:Close()
end
return DailyDeliveryView
