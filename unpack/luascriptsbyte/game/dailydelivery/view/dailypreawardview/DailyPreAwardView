---@class DailyPreAwardView : UIBaseView	中文描述
---@field public go_table DailyPreAwardView_GoTable GoTable
---@field itemList BaseAwardNewItem[]
local DailyPreAwardView = _G.BaseClass("DailyPreAwardView", _G.UIBaseView)
--_G.DailyPreAwardView = DailyPreAwardView

function DailyPreAwardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function DailyPreAwardView:OnCreate(id)
    self.awardData = require "DailyDeliveryModel":GetInstance():GetAwardData(id)
    self.itemList = {}
    if self.awardData then
        self.go_table.scrollloophorizontal_AwardList:InitItemData(#self.awardData, _G.handler(self, self.RefreshList))
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_noon, id == require "DailyDeliveryModel".AwardID.AM)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_night, id == require "DailyDeliveryModel".AwardID.PM)
end

function DailyPreAwardView:RefreshList(index, obj)
    local instanceID = obj:GetInstanceIDE()
    local item = self.itemList[instanceID]
    if not item then
        item = require "BaseAwardNewItem".New(obj)
        self.itemList[instanceID] = item
    end
    item:Show(self.awardData[index + 1])
end

---按钮点击事件在这里派发
function DailyPreAwardView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_enter then
        self:Close()
    end
end

return DailyPreAwardView
