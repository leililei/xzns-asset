local base = require "SeasonBaseModel"
---@class SeasonTurntableModel : SeasonBaseModel
---@field GetInstance fun():SeasonTurntableModel
local SeasonTurntableModel = _G.BaseClass("SeasonTurntableModel", base)
---@return SeasonTurntableModel SeasonTurntableModel
local SeasonTurntableNet = require "SeasonTurntableNet"
local SeasonModel = require "SeasonModel"

---@return SeasonTurntableModel SeasonTurntableModel
function SeasonTurntableModel:GetInstance()
    return self.super.GetInstance(self)
end

function SeasonTurntableModel:__init()
    --奖励列表
    self.awardLog = {}
    --奖励可抽取次数列表
    self.awardTimesList = {}
    --所有奖励被抽完
    self.allAwardsOver = false
    --活动开启id
    self.curFunctionOpenID = 97
    --当前转盘的id
    self.tableId = 0
    --总计抽奖次数
    self.totalCount = 0
    --红点id
    self.redPointId = 30590212
end

function SeasonTurntableModel:GetDataFormServer()
    if SeasonModel:GetInstance():CheckFunctionIsOpen(self.curFunctionOpenID) then
        SeasonTurntableNet:GetInstance():GetTableInfo(_G.handler(self, self.GetInfo))
    else
        self:ParseData()
    end
end

---获取转盘信息
function SeasonTurntableModel:GetInfo(data)
    self.tableId = data.info.t_id
    self.cfg = _G.ConfigManager.season_turntable_out_cfg[self.tableId]
    local conCfg = _G.ConfigManager.season_turntable_outcon_cfg
    for k, v in ipairs(self.cfg.pool) do
        self.awardTimesList[k] = conCfg[v].count
    end
    ---后端发的记录是把大奖单独移动到最后一位，特殊处理一下大奖
    self.awardTimesList[#self.awardTimesList + 1] = conCfg[self.cfg.limited_item[1][1]].count
    if data.info.award_log ~= nil then
        for k, v in pairs(data.info.award_log) do
            self.awardLog[v.key] = v.value
        end
    end
    self.totalCount = data.info.total_count
    self:RefreshRedPoint()
    self:ParseData()
    self.isInited = true
end

function SeasonTurntableModel:GetTableInfo(callback)
    SeasonTurntableNet:GetInstance():GetTableInfo(
        function(data)
            if 1 == data.ack then
                self:GetInfo(data)
                if callback then
                    callback()
                end
            else
                self.super.ParseData(self)
            end
        end
    )
end

---抽取转盘奖励
function SeasonTurntableModel:SeasonTableDraw(times, Call)
    SeasonTurntableNet:GetInstance():SeasonTableDraw(
        { num = times },
        function(data)
            if data.ack == 1 then
                for k, v in pairs(data.award_log) do
                    self.awardLog[v.key] = v.value
                end
                self:CheckIsFinish()
                if Call ~= nil then
                    Call(data)
                end
                _G.Events:GetInstance():Broadcast(_G.eSeasonTask.Action, { _G.SeasonTaskID.LuckyWheel }, 1)
            end
        end
    )
end

---获取当前距离保底的抽数
function SeasonTurntableModel:GetGuaranteedTimes()
    return self.totalCount
end

---获取所有奖励可抽取次数总和
function SeasonTurntableModel:GetTotalTimes()
    if self.totalTimes then
        return self.totalTimes
    end
    self.totalTimes = 0
    for _, v in pairs(self.awardTimesList) do
        self.totalTimes = self.totalTimes + v
    end
    return self.totalTimes
end

---检测是否所有奖励都领取完
---@return boolean true所有奖励都领取完毕,false仍有奖励可以领取
function SeasonTurntableModel:CheckIsFinish()
    if self.allAwardsOver == true then
        return true
    end
    if _G.table.isEmptyOrNil(self.awardLog) then
        return false
    end
    for k, v in pairs(self.awardTimesList) do
        if not self.awardLog[k] or v > self.awardLog[k] then--只要有没达到上限的就返回false
            return self.allAwardsOver
        end
    end
    self.allAwardsOver = true
    return self.allAwardsOver
end

---是否显示红点
---@return boolean 红点显示与否
function SeasonTurntableModel:RedPointCheck()
    if self:CheckIsFinish() then
        return false
    end
    local cfg = self.cfg
    if not cfg then
        local seasonId = require("SeasonModel"):GetInstance():GetCurSeasonId()
        local tbId = _G.ConfigManager.season_cfg[seasonId].turntable
        cfg = _G.ConfigManager.season_turntable_out_cfg[tbId]
        self.cfg = cfg
    end
    --目前所拥有的抽奖卷数量
    local ticketsID = cfg.ticket[1]
    local itemNum = _G.StorageManager:GetInstance():GetItemCountBySid(ticketsID)
    if itemNum > cfg.ticket[2] then
        return true
    end
    return false
end

---赛季开始
function SeasonTurntableModel:OnSeasonStart()
end

---进入结算期（关闭界面）
function SeasonTurntableModel:OnSettlement()
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SeasonTurntableView.Name)
end

---赛季结束
function SeasonTurntableModel:OnSeasonEnd()
end

---刷新红点显示
function SeasonTurntableModel:RefreshRedPoint()
    if self.redPointId > 0 then
        require "RedPointManager":GetInstance():RefreshNode(self.redPointId)
    end
end

---打开界面
function SeasonTurntableModel:OpenView(hideFun, openFun, ...)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SeasonTurntableView.Name, hideFun, openFun)
end

return SeasonTurntableModel
