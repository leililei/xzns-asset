function SeasonTurntableView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    local resources = _G.ConfigManager.ui_cfg.SeasonTurntableView.resources
    self:AddComponent(self.go_table.obj_GoldInfo, require("ResourceCompont").New(self.go_table.obj_GoldInfo, resources))
    self.playerHead = self:AddComponent(
        self.go_table.obj_PlayerHead,
        require("PlayerComponent").New(self.go_table.obj_PlayerHead)
    )
end

---界面入口
function SeasonTurntableView:OnCreate(hideFun, openFun)
    if hideFun then
        hideFun()
    end
    if openFun then
        self.openFun = openFun
    end
    self:InitData()
end

function SeasonTurntableView:InitData()
    model = require("SeasonTurntableModel"):GetInstance()
    self.maxCount = 0
    model:GetTableInfo(
        function()
            self.tableId = model.tableId
            self.cfg = model.cfg
            self.totalCount = model.totalCount
            self.awardLog = model.awardLog
            self.isFinish = model:CheckIsFinish()
            self.conCfg = _G.ConfigManager.season_turntable_outcon_cfg
            self.bigAward = self.conCfg[self.cfg.limited_item[1][1]]
            self.ticket = self.cfg.ticket[1]
            self.consumeNum = self.cfg.ticket[2]
            self.awardList = {}
            self.itemTbList = {}
            self.tempCount = 0
            for k, v in ipairs(self.cfg.pool) do
                self.awardList[k] = self.conCfg[v]
            end
            self:InitView()
        end
    )
    self.isSkip = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.SeasonTurntableSkip, 0)
    self.go_table.aorimage_SkipOn:SetActiveE(self.isSkip == 1 and 0 or 1)
    self.go_table.aorimage_Skip:SetLocalPosition(self.isSkip == 1 and -30 or 30, 0)
end

---初始化界面
function SeasonTurntableView:InitView()
    self:UpdateTime()
    self:InitItem()
    self:LoadEffect()
end

---初始化转盘奖励
function SeasonTurntableView:InitItem()
    self.itemList = {}
    local itemId = self.bigAward.item[1]
    local cfg = _G.ConfigManager.item_cfg[itemId]
    if not cfg then
        cfg = _G.ConfigManager.god_halo_cfg[itemId]
        local pos = cfg.position_scaling
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[cfg.ui_effect_cfg],
            self.go_table.obj_BigAwardEffNode,
            function(trans)
                if not self.go_table then
                    _G.DestroyImmediate(trans)
                    return
                end
                self.go_table.aorrawimage_BigAward.Alpha = 0
                if pos then
                    self.go_table.obj_BigAwardEffNode:SetLocalPosition(pos[1], pos[2], 0)
                    self.go_table.obj_BigAwardEffNode:SetLocalScaleXYZ(pos[3])
                end
            end
        )
    else
        self.go_table.aorrawimage_BigAward:LoadImage(
                cfg.Icon or cfg.icon,
                function(img)
                    img:SetNativeSize()
                    img:SetLocalScaleXYZ(2)
                end
        )
        self.go_table.aorrawimage_BigAwardMask:LoadImage(
                cfg.Icon or cfg.icon,
                function(img)
                    img:SetNativeSize()
                end
        )
    end
    local loadItem
    local index = 1
    loadItem = function(i)
        if i > #self.cfg.pool then
            self:UpdateView()
            return
        end
        if self.cfg.pool[i] ~= self.bigAward.id then
            local id = self.cfg.pool[i]
            local item = _G.InstantiateObject(self.go_table.obj_Item, self.go_table.obj_ItemContent)
            local pos = itemPos[index]
            local itemCfg = self.awardList[i]
            local tb = _G.GetAutoGoTable(item)
            self.itemTbList[id] = tb
            item:SetLocalPosition(pos[1], pos[2], 0)
            item:SetName(itemCfg.id)
            tb.aortext_Num:SetLocalPosition(0, pos[4], 0)
            tb.obj_Root:RemoveAllChildren()
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                    itemCfg.item,
                    tb.obj_Root,
                    function(obj)
                        if not self.go_table or item:GetName() ~= tostring(itemCfg.id) then
                            _G.DestroyImmediate(obj)
                            return
                        end
                        obj.gameObject:SetLocalScaleXYZ(pos[3])
                        tb.obj_Effect:SetLocalScaleXYZ(pos[3])
                        self.itemList[id] = obj
                        local itemTb = _G.GetAutoGoTable(obj.gameObject)
                        if pos[3] > 1 then--特殊奖励加道具框特效
                            _G.UIUtils.LoadEffectByCfg(
                                _G.ConfigManager.ui_effect_cfg.ef_SeasonTurntableView_daojukuang,
                                tb.obj_Effect
                            )
                        end
                        itemTb.obj_ItemNum:SetActiveE(1)
                        index = index + 1
                        loadItem(i + 1)
                    end
            )
        else
            loadItem(i + 1)
        end
    end
    loadItem(index)
end

---加载特效
function SeasonTurntableView:LoadEffect()
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_SeasonTurntableView_title,
            self.go_table.obj_EffNode,
            function(trans)
                if not self.go_table then
                    _G.DestroyImmediate(trans)
                    return
                end
            end
    )
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_SeasonTurntableView_item,
            self.go_table.obj_EffNode,
            function(trans)
                if not self.go_table then
                    _G.DestroyImmediate(trans)
                    return
                end
            end
    )
end

---更新界面
function SeasonTurntableView:UpdateView()
    self:UpdateItem()
    self:UpdateBtn()
end

---更新转盘奖励状态
function SeasonTurntableView:UpdateItem()
    self.maxCount = self.bigAward.count
    for k, v in ipairs(self.awardList) do
        if v.id ~= self.bigAward.id then
            local nowCount = self.awardLog[k] or 0
            local maxCount = self.conCfg[v.id].count
            self.itemTbList[v.id].aortext_Num.text = 
            "(" .. nowCount .. "/" .. maxCount .. ")"
            self.maxCount = self.maxCount + maxCount
            if nowCount == maxCount then
                self.itemList[v.id]:SetGou(1)
            end
        end
    end
    self.lotteryCount = model:GetGuaranteedTimes() + self.tempCount
    local num = self.cfg.guaranteed - self.lotteryCount
    local id = self.bigAward.item[1]
    local name = _G.GetLangPackValue(
        _G.ConfigManager.item_cfg[id] and 
        _G.ConfigManager.item_cfg[id].Name or 
        _G.ConfigManager.god_halo_cfg[id].name
    )
    if self.awardLog[#self.cfg.pool + 1] == self.bigAward.count then
        self.go_table.aorrawimage_BigAwardMask:SetActiveE(1)
        self.go_table.aortext_Guaranteed:SetActiveE(0)
        self.go_table.aortext_AwardText.text = _G.GetLangPackValue(90049200086)
    else
        self.go_table.aorrawimage_BigAwardMask:SetActiveE(0)
        self.go_table.aortext_Guaranteed.text = num
    end
    self.go_table.aortext_BigAward.text = name
    _G.GameUtil.ReBuildRTF(self.go_table.obj_Guaranteed)
end

---更新按钮
function SeasonTurntableView:UpdateBtn()
    self.isFinish = model:CheckIsFinish()
    self.maxCanDrawTimes = model:GetTotalTimes() - (model.totalCount + self.tempCount)
    if self.maxCanDrawTimes <= 0 then
        self.isFinish = true
        model.allAwardsOver = self.isFinish
    end
    self.go_table.obj_Btn:SetActiveE(self.isFinish and 0 or 1)
    if not self.isFinish then
        local times = 10
        local ticketNum = _G.StorageManager:GetInstance():GetItemCountBySid(self.ticket)
        if ticketNum > 0 and ticketNum < 10 then
            times = ticketNum
        end
        if times > self.maxCanDrawTimes then
            times = self.maxCanDrawTimes
        end
        local icon = _G.ConfigManager.currency_type_cfg[self.ticket].icon
        self.go_table.aorrawimage_DrawOneIcon:LoadImage(icon)
        self.go_table.aorrawimage_DrawTenIcon:LoadImage(icon)
        self.go_table.aortext_DrawOneNum.text = 1
        self.go_table.aortext_DrawTenNum.text = times
        self.go_table.aortext_DrawOne.text = _G.GetLangPackValue(90049200021, 1)
        self.go_table.aortext_DrawTen.text = _G.GetLangPackValue(90049200021, times)
    end
end

---抽奖
function SeasonTurntableView:Draw(times)
    if self.isFinish or self.ShowResult or self.maxCanDrawTimes <= 0 then
        return
    end
    local ticketNum = _G.StorageManager:GetInstance():GetItemCountBySid(self.ticket)
    --点击多次抽奖时根据抽奖道具数量修改次数
    if times > 1 and ticketNum > 0 and ticketNum < times then
        times = ticketNum
    end
    times = _G.math.min(times, self.maxCount - self.tempCount)
    if times > self.maxCanDrawTimes then
        times = self.maxCanDrawTimes
    end
    local consume = self.consumeNum * times
    if ticketNum >= consume then
        local awardLog = {}
        for k, v in pairs(model.awardLog) do
            awardLog[k] = v
        end
        local getList = {}
        model:SeasonTableDraw(
                times,
                function(data)
                    if data.ack == 1 then
                        local path = _G.ConfigManager.ui_effect_cfg.ef_SeasonTurntableView_putong
                        for _, v in pairs(data.award.item) do
                            if v.type[1] == self.bigAward.item[1] then--抽到大奖的时候显示特殊特效
                                path = _G.ConfigManager.ui_effect_cfg.ef_SeasonTurntableView_cai
                            end
                        end
                        self.ShowResult = function()
                            _G.StorageManager:GetInstance():ReceiveAwardData(data)
                            _G.StorageManager:GetInstance():ConsumeItem(self.ticket, nil, consume)
                            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data, nil, true)--策划需求十连抽的时候奖励不堆叠
                            model:RefreshRedPoint()
                        end
                        if self.isSkip == 1 then
                            self.ShowResult()
                            self.tempCount = self.tempCount + times
                            self:UpdateView()
                            self.ShowResult = nil
                        else
                            _G.UIUtils.LoadEffectByCfg(
                                    _G.ConfigManager.ui_effect_cfg.ef_SeasonTurntableView_juqi,
                                    self.go_table.obj_EffNode,
                                    function(trans)
                                        if not self.go_table then
                                            _G.DestroyImmediate(trans)
                                            return
                                        end
                                    end,
                                    function()
                                        if not self.go_table then
                                            return
                                        end
                                        _G.UIUtils.LoadEffectByCfg(
                                                path,
                                                self.go_table.obj_EffNode,
                                                function(obj)
                                                    if not self.go_table then
                                                        _G.DestroyImmediate(obj)
                                                        return
                                                    end

                                                    for _, v in ipairs(data.award_log) do
                                                        if not awardLog[v.key] or v.value > awardLog[v.key] then
                                                            getList[v.key] = true
                                                        end
                                                    end
                                                    for i = 1, 12 do
                                                        _G.UIUtils.LoadEffectByCfg(--所有的物品显示框体特效
                                                                _G.ConfigManager.ui_effect_cfg.ef_SeasonTurntableView_kuang,
                                                                self.itemTbList[self.cfg.pool[i]].obj_Effect,
                                                                function(trans)
                                                                    if not self.go_table then
                                                                        _G.DestroyImmediate(trans)
                                                                        return
                                                                    end
                                                                end,
                                                                function()
                                                                    if getList[i] then
                                                                        _G.UIUtils.LoadEffectByCfg(--抽中的物品显示暴气框体特效
                                                                                _G.ConfigManager.ui_effect_cfg.ef_SeasonTurntableView_kuangbao,
                                                                                self.itemTbList[self.cfg.pool[i]].obj_Effect,
                                                                                function(trans2)
                                                                                    if not self.go_table then
                                                                                        _G.DestroyImmediate(trans2)
                                                                                        return
                                                                                    end
                                                                                end
                                                                        )
                                                                    end
                                                                end
                                                        )
                                                    end
                                                end,
                                                function()
                                                    if not self.go_table then
                                                        return
                                                    end
                                                    self.ShowResult()
                                                    self.tempCount = self.tempCount + times
                                                    self:UpdateView()
                                                    self.ShowResult = nil
                                                end
                                        )
                                    end
                            )
                        end
                        
                    end

                end
        )
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.ticket)
    end
    
end

---更新活动时间
function SeasonTurntableView:UpdateTime()
    self.countDown = SeasonModel:GetTime().settlementTime - _G.TimeUtil.GetServerUnixTime()
    self:RefreshTime(0)
    if self.timer == nil then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.RefreshTime, self, false, false, true)
        self.timer:Start()
    end
end

---刷新计时器
function SeasonTurntableView:RefreshTime(elapsed)
    self.countDown = self.countDown - elapsed
    local time = _G.TimeUtil.TranslateSecondForStrMiaoHui(_G.Mathf.RoundToInt(self.countDown))
    if self.go_table.aortext_Time then
        self.go_table.aortext_Time.text = _G.GetLangPackValue(90025800003, _G.string.AddColor(time, "77cd73"))
    end
end

---切换跳过动画状态
function SeasonTurntableView:ChangeSkip()
    self.isSkip = self.isSkip == 1 and 0 or 1
    _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.SeasonTurntableSkip, self.isSkip)
    _G.PopWindowManager:GetInstance():ShowAllTips(
            1, 
             _G.GetLangPackValue(self.isSkip == 1 and 90049200088 or 90049200087)
    )
    self.go_table.aorimage_SkipOn:SetActiveE(self.isSkip == 1 and 0 or 1)
    self.go_table.aorimage_Skip:SetLocalPosition(self.isSkip == 1 and -30 or 30, 0)
end

---按钮点击事件在这里派发
function SeasonTurntableView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Close" then
        if self.openFun then
            self.openFun()
        end
        if self.ShowResult then
            self.ShowResult()
        end
        self:Close()
    elseif name == "@_aorrawimage_BigAward" then
        local id = self.bigAward.item[1]
        if _G.ConfigManager.item_cfg[id] then
            require("CommonTipManager"):GetInstance():OpenTip(self.go_table.transform, self.bigAward.item[1])
        else
            local data = _G.ConfigManager.god_halo_cfg[id]
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GodHaloShowView.Name, data, nil, nil, nil, nil, true)
        end
    elseif name == "@_aorbtn_DrawOne" then
        self:Draw(1)
    elseif name == "@_aorbtn_DrawTen" then
        self:Draw(10)
    elseif name == "@_aorbtn_Skip" then
        self:ChangeSkip()
    end
end
---类的析构函数
function SeasonTurntableView:OnDestroy()
    if self.timer ~= nil then
        self.timer:Stop()
        self.timer = nil
    end
end

return SeasonTurntableView
