    [1] = { -64, 234, 0.7, -52 },
    [2] = { 60, 234, 0.7, -52 },
    [3] = { 192, 143, 1.1, -72 },
    [4] = { 279, 21, 0.7, -52 },
    [5] = { 279, -90, 0.7, -52 },
    [6] = { 205, -220, 1.1, -72 },
    [7] = { 61, -308, 0.7, -52 },
    [8] = { -64, -308, 0.7, -52 },
    [9] = { -197, -220, 1.1, -72 },
    [10] = { -280, -90, 0.7, -52 },
    [11] = { -280, 19, 0.7, -52 },
    [12] = { -190, 144, 1.1, -72 },
