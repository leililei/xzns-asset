---@class SeasonTurntableNet : BaseGameNet
---@field GetInstance fun():SeasonTurntableNet
local SeasonTurntableNet = _G.BaseClass("SeasonTurntableNet", require "BaseGameNet")
local base = require "BaseGameNet"
---@return SeasonTurntableNet SeasonTurntableNet

function SeasonTurntableNet:GetInstance()
    return base.GetInstance(self)
end

---请求 赛季转盘奖励信息
---@param callback function 完成回调
function SeasonTurntableNet:GetTableInfo(callback)
    local item = _G.ConfigManager.net_map.game_turntable_out_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.SuccessCall))
    self.Call[port] = callback
end

---请求 抽奖领取转盘奖励
---@param callback function 完成回调
function SeasonTurntableNet:SeasonTableDraw(pbData, callback)
    local item = _G.ConfigManager.net_map.game_turntable_out_draw
    local port = base.Access(self, item, pbData, _G.handler(self, self.SuccessCall))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function SeasonTurntableNet:SuccessCall(port, data, error)
    if error then
        return
    end
    --TODO 写通用数据解析，没有需要做的记得删除TODO
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return SeasonTurntableNet
