local base = require("BaseGameNet")

---@class SystemFairylandNet : BaseGameNet    通信协议
local SystemFairylandNet = _G.BaseClass("SystemFairylandNet", base)
---@return SystemFairylandNet SystemFairylandNet
function SystemFairylandNet:GetInstance()
    return base.GetInstance(self)
end

---获取信息
function SystemFairylandNet:GetInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_system_fairyland_info
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---战斗，爽！
function SystemFairylandNet:Fight(pbData, callback)
    local item = _G.ConfigManager.net_map.game_system_fairyland_fight
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

