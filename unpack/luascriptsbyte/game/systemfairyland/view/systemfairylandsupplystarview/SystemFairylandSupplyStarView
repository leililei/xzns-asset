---@type SystemFairylandModel
local SystemFairylandModel = require("SystemFairylandModel")

---@class SystemFairylandSupplyStarView : UIBaseView    中文描述
---@field public go_table SystemFairylandSupplyStarView_GoTable GoTable
---@field cfgList limit_broken_cfg[]
local SystemFairylandSupplyStarView = _G.BaseClass("SystemFairylandSupplyStarView", _G.UIBaseView)

local GetAutoGoTable = _G.GetAutoGoTable
local system_fairyland_cfg = _G.ConfigManager.system_fairyland_cfg

function SystemFairylandSupplyStarView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.starEnum = {
        "ui_ty_kapaipinjie_0",
        "ui_img_xing"
    }
end

---界面的入口函数
function SystemFairylandSupplyStarView:OnCreate(call)
    self.bossLis = {}
    self.sectionLis = {}
    self.curOpenSid = 0
    self.call = call
    self:InitView()

    local timestamp = _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
    _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "RedPointSupply", timestamp)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.ReedCatkinsOneBoss.id)
end

---初始化页面
function SystemFairylandSupplyStarView:InitView()
    local obj, tb, showNoBol
    for _, cfg in pairs(_G.ConfigManager.system_fairyland_chapter_cfg) do
        if self:CheckChapterShow(cfg.id) then
            obj = _G.InstantiateObject(self.go_table.obj_titleItem, self.go_table.obj_Content)
            obj:SetActiveE(1)
            tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickTitle, cfg.id))
            self.bossLis[cfg.id] = tb
            self:ShowTitle(tb, cfg)
            showNoBol = true
        end
    end
    self.go_table.aortext_null:SetActiveE(showNoBol and 0 or 1)
end

function SystemFairylandSupplyStarView:InitSection(bossID)
    self.sectionLis[bossID] = {}
    local layerCfgs = {}
    for _, v in pairs(system_fairyland_cfg) do
        if v.grade == bossID then
            _G.table.insert(layerCfgs, v)
        end
    end
    _G.table.sort(
        layerCfgs,
        function(a, b)
            return a.difficulty < b.difficulty
        end
    )
    local parent = self.bossLis[bossID].obj_sections
    local obj, tb
    for i = 1, #layerCfgs do
        local stars = {}
        local starsCount = 0
        for j = 1, 3 do
            stars[j] = SystemFairylandModel:GetInstance():GetSectionStarUnlock(layerCfgs[i].id, j)
            if stars[j] then
                starsCount = starsCount + 1
            end
        end
        if starsCount > 0 and starsCount < 3 then
            obj = _G.InstantiateObject(self.go_table.obj_sectionItem, parent)
            obj:SetActiveE(1)
            tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickSection, layerCfgs[i].id))
            tb.aorbtn_go:SetActiveE(
                SystemFairylandModel:GetInstance():CheckSectionCanChallenge(layerCfgs[i].id) and 1 or 0
            )
            self.sectionLis[bossID][layerCfgs[i].id] = tb
            self:ShowSection(tb, layerCfgs[i], stars)
        end
    end
end

function SystemFairylandSupplyStarView:CheckChapterShow(bossID)
    for _, v in pairs(system_fairyland_cfg) do
        if v.grade == bossID then
            local stars = {}
            local starsCount = 0
            for j = 1, 3 do
                stars[j] = SystemFairylandModel:GetInstance():GetSectionStarUnlock(v.id, j)
                if stars[j] then
                    starsCount = starsCount + 1
                end
            end
            if starsCount > 0 and starsCount < 3 then 
                return true
            end
        end
    end
    return false
end

---@param tb SystemFairylandSupplyStarView._obj_titleItem_GoTable
---@param cfg system_fairyland_chapter_cfg
function SystemFairylandSupplyStarView:ShowTitle(tb, cfg)
    local bossID = cfg.id
    local modelIns = SystemFairylandModel:GetInstance()
    local baseCfg, bossCfg = modelIns:GetBossCfg(bossID)
    local bossSid = _G.ConfigManager.monster_group_cfg[baseCfg.monster].DefaultDefenserSids[1][1]
    tb.aorimage_array:SetLocalScale(1, self.curOpenSid == bossID and 1 or -1, 1)
    tb.aortext_name.text = _G.GetLangPackValue(_G.ConfigManager.system_fairyland_chapter_cfg[bossID].name)
    tb.aortext_star.text =
        "<color=#1A7E06>" .. modelIns:GetBossStarCount(bossID) .. "</color>/" .. modelIns:GetMaxStarByBoss(bossID)
end

---@param tb SystemFairylandSupplyStarView._obj_sectionItem_GoTable
---@param cfg system_fairyland_cfg
function SystemFairylandSupplyStarView:ShowSection(tb, cfg, stars)
    tb.aortext_name.text = _G.GetLangPackValue(90023200002, cfg.difficulty)
    tb.aorimage_star1.SpriteName = stars[1] and self.starEnum[2] or self.starEnum[1]
    tb.aorimage_star2.SpriteName = stars[2] and self.starEnum[2] or self.starEnum[1]
    tb.aorimage_star3.SpriteName = stars[3] and self.starEnum[2] or self.starEnum[1]
end

function SystemFairylandSupplyStarView:OnClickTitle(go, isOn, bossID)
    if self.curOpenSid == bossID then --合上
        self.bossLis[bossID].obj_sections:SetActiveE(0)
        self.bossLis[bossID].aorimage_array:SetLocalScale(1, -1, 1)
        self.curOpenSid = 0
    else
        self.curOpenSid = bossID
        for key, tb in pairs(self.bossLis) do
            tb.obj_sections:SetActiveE(self.curOpenSid == key and 1 or 0)
            tb.aorimage_array:SetLocalScale(1, self.curOpenSid == key and 1 or -1, 1)
        end
        if not self.sectionLis[bossID] then
            self:InitSection(bossID)
        end
    end
end

function SystemFairylandSupplyStarView:OnClickSection(go, isOn, sid)
    if self.call then
        self.call(self.curOpenSid, sid)
    end
    self:Close()
end

---按钮点击事件在这里派发
function SystemFairylandSupplyStarView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

---@private
function SystemFairylandSupplyStarView:OnDestroy()
end

return SystemFairylandSupplyStarView
