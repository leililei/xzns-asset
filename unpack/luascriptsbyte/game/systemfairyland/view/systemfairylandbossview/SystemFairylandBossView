local SystemFairylandBossView = _G.BaseClass("SystemFairylandBossView", _G.UIBaseView)

local system_fairyland_cfg = _G.ConfigManager.system_fairyland_cfg

function SystemFairylandBossView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.starEnum = {
        "ui_ty_kapaipinjie_0",
        "ui_img_xing"
    }
    self.colorEnum = {
        require("CardInfoManager").GetColorFromRGB("FFFFFF"),
        require("CardInfoManager").GetColorFromRGB("5CFF6F")
    }
    self.boxes = {
        _G.GetAutoGoTable(self.go_table.obj_box1, _G.handlerbind(self, self.OnClickBox, 1)),
        _G.GetAutoGoTable(self.go_table.obj_box2, _G.handlerbind(self, self.OnClickBox, 2)),
        _G.GetAutoGoTable(self.go_table.obj_box3, _G.handlerbind(self, self.OnClickBox, 3))
    }
end

---界面的入口函数
function SystemFairylandBossView:OnCreate(bossID, call)
    self.bossID = bossID
    self.curLayerCfg, self.curBossCfg = SystemFairylandModel:GetInstance():GetBossCfg(bossID)
    ---@type system_fairyland_cfg[]
    self.layerCfgs = {}
    for _, v in pairs(system_fairyland_cfg) do
        if v.grade == bossID then
            _G.table.insert(self.layerCfgs, v)
        end
    end
    if call then
        self.call = call
    end
    _G.table.sort(
        self.layerCfgs,
        function(a, b)
            return a.difficulty < b.difficulty
        end
    )
    self.boxredpoints = {
        self.go_table.obj_redpointbox1,
        self.go_table.obj_redpointbox2,
        self.go_table.obj_redpointbox3
    }
    self:InitView()

    --以六点作为刷新时刻
    local timestamp = _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
    _G.PlayerPrefsManager.SetInt(
        tostring(_G.PlayerModel:GetInstance().role_uid) .. "EnterSystemFairylandView" .. self.bossID,
        timestamp
    )
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.ReedCatkinsOneBoss.id)

    local typeLis = SystemFairylandModel:GetInstance():GetAllUnlockAwardType(self.bossID)
    -- for i = 1, #self.boxes do
    --     -- body
    --     if not _G.table.ContainsValue(typeLis, i) then --已领取或未解锁
    --         self.boxredpoints[i]:SetActiveE(0)
    --     else
    --         self.boxredpoints[i]:SetActiveE(1)
    --     end
    -- end

    if SystemFairylandModel:GetInstance():CheckNOFullStar() then
        --local timestamp = _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
        local enterView =
            _G.PlayerPrefsManager.GetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "RedPointSupply", 0)
        if enterView ~= timestamp then
            self.go_table.obj_redpointsupply:SetActiveE(1)
        else
            self.go_table.obj_redpointsupply:SetActiveE(0)
        end
    else
        self.go_table.obj_redpointsupply:SetActiveE(0)
    end

    if not _G.table.ContainsValue(typeLis, 1) then --已领取或未解锁
        return
    end

    local res = _G.ConfigManager.ui_cfg.SystemFairylandBossView.resources
    self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, res))
    self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))

    self.go_table.obj_redpointChallenge:UpdateRedPointItemIDAndParam(
        _G.ConfigManager.redpoint_cfg.ReedCatkinsChallengeBoss.id,
        bossID
    )
end

---初始化页面
function SystemFairylandBossView:InitView(jump)
    local spine = self.curBossCfg.image
    local x, y, z = self.go_table.trans_spineRoot:GetLocalPosition()
    local bossSid = _G.ConfigManager.monster_group_cfg[self.curLayerCfg.monster].DefaultDefenserSids[1][1]
    local newScale = spine[5] + 0.15
    _G.PoolsManager:GetInstance():Spawn(
        spine[1],
        _G.ePoolType.Temporary,
        self.go_table.trans_spineRoot,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
            trans:SetLocalPosition(spine[2], spine[3], spine[4])
            trans:SetLocalScale(-newScale, newScale, newScale)
        end
    )
    self.go_table.aortext_bossName.text =
        _G.GetLangPackValue(_G.ConfigManager.system_fairyland_chapter_cfg[self.bossID].name)
    self.go_table.aortext_bossinfo.text = self.curBossCfg.desc > 0 and _G.GetLangPackValue(self.curBossCfg.desc) or ""
    self:UpdateView(jump)
end

---刷新全部界面（初始化 与 战斗胜利返回）
function SystemFairylandBossView:UpdateView(layer)
    self.isMaxLayer = SystemFairylandModel:GetInstance():CheckPassMaxLayer(self.bossID)
    local sid, cfg
    if self.isMaxLayer then
        cfg = SystemFairylandModel:GetInstance():GetCurLayerCfg(self.bossID)
    else
        sid, cfg = SystemFairylandModel:GetInstance():GetNextLayer(self.bossID)
    end
    self.curLayerCfg = cfg
    self:UpdateLayer(layer)
    local index = cfg.difficulty
    self.curSelectLayer = layer or index
    local maxStar = SystemFairylandModel:GetInstance():GetMaxStarByBoss(self.bossID)
    local starCount = SystemFairylandModel:GetInstance():GetBossStarCount(self.bossID)
    self.go_table.slider_star.value = starCount / maxStar
    self:UpdateBox()
    local jump = layer and layer - 1 or self.curSelectLayer - 1
    if not self.scrollInit then
        self.scrollInit = true
        self.go_table.scrollloopvectical_itemlist:InitItemData(
            #self.layerCfgs,
            _G.handler(self, self.RefreshItem),
            jump
        )
    else
        self.go_table.scrollloopvectical_itemlist:UpdateCount(#self.layerCfgs, jump)
    end
end

function SystemFairylandBossView:UpdateBox()
    local typeLis = SystemFairylandModel:GetInstance():GetAllUnlockAwardType(self.bossID)
    for i = 1, 3 do
        local isGet = SystemFairylandModel:GetInstance():CheckStarAwardIsGet(self.bossID, i)
        local canGet = _G.table.ContainsValue(typeLis, i)
        self.boxes[i].aortext_num.text = self.curBossCfg["star" .. i]
        self.boxes[i].aorbtn_box:SetGray(isGet)
        self.boxes[i].ani = self.boxes[i].aorbtn_box:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
        self.boxes[i].ani.enabled = not isGet and canGet
    end
    if self.curSelectBox then
        self:ShowItems()
    end
    for i = 1, #self.boxes do
        -- body
        if not _G.table.ContainsValue(typeLis, i) then --已领取或未解锁
            self.boxredpoints[i]:SetActiveE(0)
        else
            self.boxredpoints[i]:SetActiveE(1)
        end
    end
end

---刷新层级信息
function SystemFairylandBossView:UpdateLayer(layer)
    local ModelIns = SystemFairylandModel:GetInstance()
    ---@type system_fairyland_cfg
    local cfg = layer and ModelIns:GetCfgByBossAndLayer(self.bossID, layer) or self.curLayerCfg
    --已通关最高层
    -- if self.isMaxLayer then
    --     self.go_table.aorbtn_battle:SetGray(true)
    -- end
    self.go_table.aorbtn_battle:SetActiveE((cfg.id <= self.curLayerCfg.id) and 1 or 0)
    local conCfg = _G.ConfigManager.system_trial_star_cfg
    self.go_table.aortext_starCon1.text = ModelIns:GetStarConditionStr(conCfg[cfg.star_condition[1][1]].condition[1])
    self.go_table.aortext_starCon2.text = ModelIns:GetStarConditionStr(conCfg[cfg.star_condition[2][1]].condition[1])
    self.go_table.aortext_starCon3.text = ModelIns:GetStarConditionStr(conCfg[cfg.star_condition[3][1]].condition[1])
    _G.GameUtil.ReBuildRTF(self.go_table.obj_Content)
    local starCount = 0
    for i = 1, 3 do
        local star = ModelIns:GetSectionStarUnlock(cfg.id, i)
        self.go_table["aortext_starCon" .. i].color = self.colorEnum[star and 2 or 1]
        if star then
            starCount = starCount + 1
        end
    end
    self.isClear = starCount == 3
    self.go_table.aorbtn_battle:SetGray(self.isClear and true or false)
    self.go_table.aorbtn_battle:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
        _G.ColorTools.FormatColorByString(self.isClear and "A9A9A9" or "FFFFFF")
    local showColor = "8C2D14"
    if _G.AppSetting.IsXzns then
        showColor = "50351e"
    end
    self.go_table.aortext_battle.color = _G.ColorTools.FormatColorByString(self.isClear and "434343" or showColor)
    self.go_table.aortext_battle.text =
        self.isClear and _G.GetLangPackValue(90000000118) or _G.GetLangPackValue(25400000106)
    self.go_table.scrollloopvectical_itemlist:UpdateAllItem()
end

function SystemFairylandBossView:RefreshItem(index, obj)
    index = index + 1

    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickLayer, index))
    local cfg = self.layerCfgs[index]
    tb.aortext_title.text = _G.GetLangPackValue(90023200002, cfg.difficulty)
    local curDiff = self.curLayerCfg.difficulty
    tb.aortext_over:SetActiveE((curDiff > cfg.difficulty or self.isMaxLayer) and 1 or 0)
    tb.aortext_notOpen:SetActiveE(curDiff < cfg.difficulty and 1 or 0)
    tb.obj_level:SetActiveE((curDiff == cfg.difficulty and not self.isMaxLayer) and 1 or 0)

    if self.curSelectLayer == index then
        tb.aorimage_select:SetActiveE(1)
    else
        tb.aorimage_select:SetActiveE(0)
    end

    tb.aorimage_star1.SpriteName =
        SystemFairylandModel:GetInstance():GetSectionStarUnlock(cfg.id, 1) and self.starEnum[2] or self.starEnum[1]
    tb.aorimage_star2.SpriteName =
        SystemFairylandModel:GetInstance():GetSectionStarUnlock(cfg.id, 2) and self.starEnum[2] or self.starEnum[1]
    tb.aorimage_star3.SpriteName =
        SystemFairylandModel:GetInstance():GetSectionStarUnlock(cfg.id, 3) and self.starEnum[2] or self.starEnum[1]

    tb.aortext_level.text = cfg.suggest

    tb.obj_awards:ClearChildren()
    for _, v in pairs(cfg.reward) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            v,
            tb.obj_awards,
            function(item)
                if self:IsNil() then
                    _G.DestroyObject(item.gameObject)
                    return
                end
                item:SetGou(self.curLayerCfg.id > cfg.id or self.isMaxLayer)
                if item.ShowNumText then
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
                item.gameObject:SetRectTransformSize(60, 60)
                item.gameObject:SetLocalScaleXYZ(0.8)
            end
        )
    end
end

function SystemFairylandBossView:OnClickLayer(go, isOn, index)
    if index ~= self.curSelectLayer then
        self.curSelectLayer = index
        self:UpdateLayer(index)
    end
end

function SystemFairylandBossView:OnClickSkill(go, isOn, skillid)
    require "CommonTipManager":GetInstance():OpenSkillTip(skillid, nil, nil, false, go)
end

function SystemFairylandBossView:ShowRecommend(index, call)
    require "SystemFairylandModel":GetInstance():GetReport(
        self.curLayerCfg.id,
        self.recommendData[index].uid,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self:AddListener(_G.eBattleState.RecordStart, self.OnRecordStart)
            _G.BattleManager:GetInstance():SetArgData(msg.fight_arg)
            _G.BattleManager:GetInstance():EnterRecordFight(1, true, _G.BattleControllerType.SystemFairyland, true)
            if call then
                call()
            end
        end
    )
end

function SystemFairylandBossView:OnRecordStart()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SystemFairylandView.Name)
    self:Hide()
    self:RemoveListener(_G.eBattleState.RecordStart, self.OnRecordStart)
    self:AddListener(_G.eBattleState.RecordEnd, self.OnRecordEnd)
end

function SystemFairylandBossView:OnRecordEnd()
    self:Show()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.SystemFairylandView.Name)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
    self:RemoveListener(_G.eBattleState.RecordEnd, self.OnRecordEnd)
end

function SystemFairylandBossView:ChangeBoss(bossID, sid)
    self.bossID = bossID
    self.curLayerCfg, self.curBossCfg = SystemFairylandModel:GetInstance():GetBossCfg(bossID)
    self.layerCfgs = {}
    for _, v in pairs(system_fairyland_cfg) do
        if v.grade == bossID then
            _G.table.insert(self.layerCfgs, v)
        end
    end
    _G.table.sort(
        self.layerCfgs,
        function(a, b)
            return a.difficulty < b.difficulty
        end
    )
    self.go_table.trans_spineRoot:ClearChildren()
    local jump = 1
    for i = 1, #self.layerCfgs do
        if self.layerCfgs[i].id == sid then
            jump = i
        end
    end
    self:InitView(jump)
end

function SystemFairylandBossView:ShowItems(index, isGou)
    if index == nil or index == self.curSelectBox then
        self.go_table.aorbtn_TipsView:SetActiveE(0)
        self.curSelectBox = nil
        return
    end
    self.go_table.aorbtn_TipsView:SetActiveE(1)
    self.curSelectBox = index
    local x, y, z = self.boxes[index].gameObject:GetPosition()
    self.go_table.obj_ItemTips:SetPosition(x, y + 1, z)

    self.go_table.obj_Parent:ClearChildren()
    local rewards = self.curBossCfg["reward" .. index]
    for i, data in pairs(rewards) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            data,
            self.go_table.obj_Parent,
            function(item)
                if self:IsNil() then
                    _G.DestroyImmediate(item.gameObject)
                    return
                end
                item.gameObject:SetLocalScaleXYZ(0.6)
                item.gameObject:SetActiveE(1)
                -- item:SetPri(data.isPri)
                item:SetGou(isGou)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                if item.SetGradeNew then
                    item:SetGradeNew(false)
                end
                item.gameObject:SetRectTransformSize(88, 88)
            end
        )
    end
    ---@type UnityEngine.RectTransform
    local rect = self.go_table.obj_itemBg:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    rect:SetRectTransformSize((#rewards) * 75, 80)
end

function SystemFairylandBossView:OnClickBox(go, isOn, index)
    local typeLis = SystemFairylandModel:GetInstance():GetAllUnlockAwardType(self.bossID)
    if not _G.table.ContainsValue(typeLis, index) then --已领取或未解锁
        self:ShowItems(index, SystemFairylandModel:GetInstance():CheckStarAwardIsGet(self.bossID, index))
        return
    end
    if #typeLis == 0 then
        return
    end
    SystemFairylandModel:GetInstance():GetStarAward(
        self.bossID,
        typeLis,
        function(msg)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            self:UpdateBox()
            self.boxredpoints[index]:SetActiveE(0)
            require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.ReedCatkinsOneBoss.id
            )
        end
    )
end

---按钮点击事件在这里派发
function SystemFairylandBossView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
        if self.call then
            self.call()
        end
    elseif go == self.go_table.aorbtn_battle then
        if _G.MainManager:GetInstance():IsFighting(true) or self.isClear then
            return
        end
        -- if self.isMaxLayer then
        --     _G.PopWindowManager:GetInstance():ShowAllTips(310113)
        --     return
        -- end
        SystemFairylandModel:GetInstance():OnChallenge(self.bossID, self.curSelectLayer)
    elseif go == self.go_table.aorbtn_supplyStar then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.SystemFairylandSupplyStarView.Name,
            _G.handler(self, self.ChangeBoss)
        )
        self.go_table.obj_redpointsupply:SetActiveE(0)
    elseif go == self.go_table.aorbtn_TipsView then
        self:ShowItems()
    end
end

---@private
function SystemFairylandBossView:OnDestroy()
end

return SystemFairylandBossView
