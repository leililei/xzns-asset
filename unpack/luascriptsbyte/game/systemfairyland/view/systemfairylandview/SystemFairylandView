local SystemFairylandModel = require("SystemFairylandModel")

---@class SystemFairylandView : UIBaseView    中文描述
---@field public go_table SystemFairylandView_GoTable GoTable
---@field cfgList limit_broken_cfg[]
local SystemFairylandView = _G.BaseClass("SystemFairylandView", _G.UIBaseView)

local GetAutoGoTable = _G.GetAutoGoTable
---副本类型（1-风；2-花；3-雪；4-月）
local bossEffect = {
    _G.ConfigManager.ui_effect_cfg.ef_SystemFairylandView_feng,
    _G.ConfigManager.ui_effect_cfg.ef_SystemFairylandView_hua,
    _G.ConfigManager.ui_effect_cfg.ef_SystemFairylandView_xue,
    _G.ConfigManager.ui_effect_cfg.ef_SystemFairylandView_yue
}

function SystemFairylandView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SystemFairylandView:OnCreate()
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.SystemFairylandView, self.go_table)
    self.bossList = {}
    self:InitData()
    self:InitView()

    --self:LoadEffect()
end

---初始化数据
function SystemFairylandView:InitData()
    self.MaxCount = SystemFairylandModel:GetInstance().bossCount
end

---初始化页面
function SystemFairylandView:InitView()
    local res = _G.ConfigManager.ui_cfg.SystemFairylandView.resources
    self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, res))
    self:AddComponent(self.go_table.trans_PlayerHead, require("PlayerComponent").New(self.go_table.trans_PlayerHead))
    self:ShowList()
end

function SystemFairylandView:ShowList()
    local itemCount = (self.MaxCount + 2) // 3
    if not self.ItemList then
        self.ItemList = true
        self.go_table.scrollloopvectical_ItemList:InitItemData(itemCount, _G.handler(self, self.RefreshList))
    else
        self.go_table.scrollloopvectical_ItemList:UpdateAllItem()
    end
    local curLayer = 0
    for i = 1, self.MaxCount do
        if SystemFairylandModel:GetInstance():CheckPassMaxLayer(i) then
            curLayer = i + 1
            curLayer = curLayer > self.MaxCount and self.MaxCount or curLayer
        end
    end
    curLayer = curLayer // 3
    if curLayer == 0 then
        self.go_table.scrollloopvectical_ItemList:ScrollToTop()
    else
        self.go_table.scrollloopvectical_ItemList:ScrollToIndex(curLayer - 1)
    end
end

function SystemFairylandView:ShowItem(bossID)
    local model = SystemFairylandModel:GetInstance()
    local cfg, bossCfg = model:GetBossCfg(bossID)
    local tb = self.bossList[bossID]
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.SystemFairylandViewItem, tb)
    local spine = bossCfg.image
    tb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.ReedCatkinsOneBoss.id, bossID)
    tb.trans_CardSpine:ClearChildren()
    _G.PoolsManager:GetInstance():Spawn(
        spine[1],
        _G.ePoolType.Temporary,
        tb.trans_CardSpine,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
            tb.trans_CardSpine:SetLocalPosition(
                _G.tonumber(spine[2]),
                -160 + _G.tonumber(spine[3]),
                _G.tonumber(spine[4])
            )
            tb.trans_CardSpine:SetLocalScale(spine[5], spine[5], spine[5])
        end
    )
    self:UpdateItem(bossID)
end

function SystemFairylandView:UpdateAllItem()
    self.go_table.scrollloopvectical_ItemList:UpdateAllItem()
end

function SystemFairylandView:UpdateItem(bossID)
    local model = SystemFairylandModel:GetInstance()
    local cfg, bossCfg = model:GetBossCfg(bossID)
    local tb = self.bossList[bossID]
    local pass, tipSid, content = _G.GlobalConditionManager.CheckConditionArrays(bossCfg.limit_condition)

    local nowLayer = model:GetCurLayer(bossID) % 100
    local maxLayer = model.layerCount[bossID]
    local isMax = nowLayer == maxLayer
    if not pass then
        tb.aortext_tip.text = content
        tb.obj_icon:SetActiveE(0)
    else
        local curStar = model:GetBossStarCount(bossID)
        local maxStar = model:GetMaxStarByBoss(bossID)
        isMax = isMax and curStar == maxStar
        tb.aortext_tip.text = model:GetBossStarCount(bossID) .. "/" .. model:GetMaxStarByBoss(bossID)
        tb.obj_icon:SetActiveE(1)
    end
    _G.GameUtil.ReBuildRTF(tb.obj_status)

    if bossID > 1 then
        local isLock = model:GetCurLayer(bossID - 1) ~= model.layerFinalID[bossID - 1]
        tb.obj_lock:SetActiveE((isLock and not pass) and 1 or 0)
        tb.aorrawimage_bossBlack:SetActiveE((isLock and not pass)  and 1 or 0)
        tb.obj_status:SetActiveE((isLock and not pass)  and 0 or 1)
        tb.unlock = (isLock or not pass) and 0 or 1
        if isLock then
            tb.aorrawimage_bossMask_2:SetActiveE(1)
        else
            tb.aorrawimage_bossMask_2:SetActiveE(isMax and 1 or 0)
        end
    else
        tb.unlock = pass and 1 or 0
        tb.obj_status:SetActiveE(1)
        tb.obj_lock:SetActiveE(0)
        tb.aorrawimage_bossBlack:SetActiveE(0)
        tb.aorrawimage_bossMask_2:SetActiveE(isMax and 1 or 0)
    end
    local bossSid = _G.ConfigManager.monster_group_cfg[cfg.monster].DefaultDefenserSids[1][1]
    tb.aortext_tip:SetActiveE(1)
    tb.aortext_pass:SetActiveE(0)
    -- tb.aortext_pass.text = _G.GetLangPackValue(90000000118)
    tb.aortext_level.text = bossID
    tb.aortext_name.text = _G.GetLangPackValue(bossCfg.name)
    tb.aorrawimage_bossPic:SetActiveE(pass and 1 or 0)
end

function SystemFairylandView:RefreshList(index, obj)
    local list = _G.GetAutoGoTable(obj)
    for i = 1, 3 do
        local newIndex = (index * 3) + i
        if newIndex <= self.MaxCount then
            list["obj_boss" .. i]:SetActiveE(1)
            self.bossList[newIndex] =
                GetAutoGoTable(list["obj_boss" .. i], _G.handlerbind(self, self.OnClickBoss, newIndex))
            self:ShowItem(newIndex)
        else
            list["obj_boss" .. i]:SetActiveE(0)
        end
    end
end

function SystemFairylandView:LoadEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_SystemFairylandView_bg_loop,
        self.go_table.aorrawimage_Bg,
        function(trans)
            if _G.IsNil(self.go_table.aorrawimage_Bg) then
                _G.DestroyObject(trans)
                return
            end
        end
    )
end

function SystemFairylandView:OnClickBoss(go, isOn, bossID)
    if self.bossList[bossID].unlock == 1 then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.SystemFairylandBossView.Name,
            bossID,
            _G.handler(self, self.UpdateAllItem)
        )
    else
        local cfg, bossCfg = SystemFairylandModel:GetInstance():GetBossCfg(bossID)
        local index = 310120
        local text = _G.ConfigManager.tips_system_cfg[index].content
        if bossCfg.limit_condition then
            local pass, tipSid, content = _G.GlobalConditionManager.CheckConditionArrays(bossCfg.limit_condition)
            text = content
        end
        _G.PopWindowManager:GetInstance():ShowAllTips(index, text, nil)
    end
end

---按钮点击事件在这里派发
function SystemFairylandView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 26)
    end
end

---@private
function SystemFairylandView:OnDestroy()
end

return SystemFairylandView
