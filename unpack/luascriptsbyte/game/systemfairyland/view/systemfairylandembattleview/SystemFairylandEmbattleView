local SystemFairylandModel = require("SystemFairylandModel")

---@class SystemFairylandEmbattleView : UIBaseView	中文描述
---@field public go_table SystemFairylandEmbattleView_GoTable GoTable
local SystemFairylandEmbattleView = _G.BaseClass("SystemFairylandEmbattleView", _G.UIBaseView)

function SystemFairylandEmbattleView:Awake()
end
---界面的入口函数
function SystemFairylandEmbattleView:OnCreate(embattleType, exitCall, battleCall, autoFight, bossID, cfg)
    self.onExitCall = exitCall
    self.embattleType = embattleType
    self.onBattleCall = battleCall
    self.autoFight = autoFight
    self.bossID = bossID
    self.cfg = cfg
    self.colorEnum = {
        require("CardInfoManager").GetColorFromRGB("FFFFFF"),
        require("CardInfoManager").GetColorFromRGB("5CFF6F")
    }
    self:OpenEmbattleView()
    self:ShowCurSectionTag()

    local timestamp = _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
    _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "RedPointReedCatkinsChallenge", timestamp)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.ReedCatkinsChallengeBoss.id)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.ReedCatkinsOneBoss.id)

end
function SystemFairylandEmbattleView:OnDestroy()
    self.onExitCall = nil
    self.onBattleCall = nil
end

function SystemFairylandEmbattleView:ShowCurSectionTag()
    local curSection = self.cfg.difficulty
    self.go_table.aortext_CurSection.text = _G.GetLangPackValue(90023200002, _G.tostring(curSection))
end

function SystemFairylandEmbattleView:UpdateStar(embattleData)
    local eleDic = {}
    local proDic = {}
    local sidDic = {}
    local starDic = {}
    local orderDic = {}
    local totalNum = 0
    ---@type CardData
    local cardData, ele, pro, eles
    for i, v in pairs(embattleData) do
        if v.uid > 0 then
            cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, v.uid)
            --ele = cardData:GetElement()
            eles = cardData:GetElement_new()
            pro = cardData:GetProfessional()
            for i = 1, #eles do
                ele = eles[i]
                eleDic[ele] = eleDic[ele] and eleDic[ele] + 1 or 1
            end
            proDic[pro] = proDic[pro] and proDic[pro] + 1 or 1
            starDic[cardData:GetStar()] = starDic[cardData:GetStar()] and starDic[cardData:GetStar()] + 1 or 1
            orderDic[cardData:GetGrade()] = orderDic[cardData:GetGrade()] and orderDic[cardData:GetGrade()] + 1 or 1
            sidDic[cardData.sid] = true
            totalNum = totalNum + 1
        end
    end

    local ModelIns = SystemFairylandModel:GetInstance()
    ---@type FightStarEnum
    local FSE = require("SystemFairylandModel"):GetInstance().fightStarEnum
    local conIds = self.cfg.star_condition[2]
    local flag, condition
    for i = 1, #conIds do
        condition = _G.ConfigManager.system_trial_star_cfg[conIds[i]].condition[1]
        flag = false
        if condition[1] == FSE.leastEle then
            if eleDic[condition[3]] ~= nil and eleDic[condition[3]] >= condition[2] then
                flag = true
            end
        elseif condition[1] == FSE.mostEle then
            if eleDic[condition[3]] == nil or eleDic[condition[3]] <= condition[2] then
                flag = true
            end
        elseif condition[1] == FSE.leastPro then
            if proDic[condition[3]] ~= nil and proDic[condition[3]] >= condition[2] then
                flag = true
            end
        elseif condition[1] == FSE.mostPro then
            if proDic[condition[3]] == nil or proDic[condition[3]] <= condition[2] then
                flag = true
            end
        elseif condition[1] == FSE.mulEle then
            flag = true
            for i = 3, 6 do
                if eleDic[condition[i]] == nil or eleDic[condition[i]] < 1 then
                    flag = false
                    break
                end
            end
        elseif condition[1] == FSE.appoint2 then
            if sidDic[condition[2]] or sidDic[condition[3]] then
                flag = true
            end
        elseif condition[1] == FSE.noPro then
            if proDic[condition[2]] ~= nil and proDic[condition[2]] > 0 then
                if proDic[condition[3]] ~= nil and proDic[condition[3]] > 0 then
                    flag = true
                end
            end
        elseif condition[1] == FSE.allPro then
            if proDic[condition[2]] ~= nil and proDic[condition[2]] == totalNum then
                flag = true
            end
        elseif condition[1] == FSE.diffEle then
            if _G.table.count(eleDic) >= condition[2] then
                flag = true
            end
        elseif condition[1] == FSE.leastStar then
            local num = 0
            for k, v in pairs(starDic) do
                if k >= condition[3] then
                    num = num + v
                    if num >= condition[2] then
                        flag = true
                        break
                    end
                end
            end
        elseif condition[1] == FSE.leastOrder then
            local num = 0
            for k, v in pairs(orderDic) do
                if k >= condition[3] then
                    num = num + v
                    if num >= condition[2] then
                        flag = true
                        break
                    end
                end
            end
        end
        if flag then --目前只有第二个星星与阵容相关，且只配单条件，若要配多条件开优化
            break
        end
    end
    for i = 1, 3 do
        condition = _G.ConfigManager.system_trial_star_cfg[self.cfg.star_condition[i][1]].condition[1]
        self.go_table["aortext_starCon" .. i].text = ModelIns:GetStarConditionStr(condition)
    end
    self.go_table.aortext_starCon2.color = self.colorEnum[flag and 2 or 1]
    self.go_table.aortext_starCon1.color = self.colorEnum[2]
    self.go_table.aortext_starCon3.color = self.colorEnum[2]
end

function SystemFairylandEmbattleView:OpenEmbattleView()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    require "EmbattleController":GetInstance():SetEmbattleChangeCall(_G.handler(self, self.UpdateStar))
    require "EmbattleController":GetInstance():OpenEmbattle(
        self.embattleType,
        _G.EmbattleSaveType.server,
        true,
        _G.EmbattleControllerItemType.SystemFairyland,
        _G.handlerbind(self, self.OnExitCall, self.bossID, self.cfg.id),
        _G.handlerbind(self, self.OnBattleCall, self.bossID, self.cfg.id),
        self.cfg.monster,
        self.cfg
    )
end

function SystemFairylandEmbattleView:OnExitCall()
    require "EmbattleController":GetInstance():SetEmbattleChangeCall(nil)
    self:Close()
    if self.onExitCall then
        self.onExitCall()
        self.onExitCall = nil
    end
end
function SystemFairylandEmbattleView:OnBattleCall(...)
    require "EmbattleController":GetInstance():SetEmbattleChangeCall(nil)
    if self.onBattleCall then
        self.onBattleCall(...)
        self.onBattleCall = nil
    end
end

---监听界面打开
---@param name string 界面名称
function SystemFairylandEmbattleView:OnEmbattleViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
        local embattleView = _G.UIManager:GetInstance():GetWindowCtrl(name)
        _G.UIManager:GetInstance():ChangeCanvasOrder(
            name,
            self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
        )
        if self.autoFight then
            embattleView:SetAutoBattle()
        end
        embattleView:SetQuitCallback(_G.handler(self, self.CheckQuitEmbattle))
        embattleView.transform:SetParentE(self.go_table.trans_view)
    end
end

function SystemFairylandEmbattleView:CheckQuitEmbattle(call)
    call(true)
end

return SystemFairylandEmbattleView
