---监听界面打开
---@param name string 界面名称
function SystemFairylandModel:OnEmbattleViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SystemFairylandView.Name)
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SystemFairylandBossView.Name)
    end
end

function SystemFairylandModel:SetLayerPass(bossID, sid, indexes)
    if self.fairylandLayer[bossID] == nil or self.fairylandLayer[bossID] == 0 then
        self.fairylandLayer[bossID] = sid
    else
        local curCfg = _G.ConfigManager.system_fairyland_cfg[self.fairylandLayer[bossID]]
        local cfg = _G.ConfigManager.system_fairyland_cfg[sid]
        if cfg.difficulty > curCfg.difficulty then
            self.fairylandLayer[bossID] = sid
        end
    end
    self:RefreshStarState(sid, indexes)
end

function SystemFairylandModel:ReturnPanel(isWin, id)
    if isWin then
        local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SystemFairylandBossView.Name)
        if ctrl then
            ctrl:UpdateView()
        end
    end
    if id == require("SettlementModel").FunctionEnum.Next then
        return
    end
    self:ShowWindows()
end

function SystemFairylandModel:ShowWindows()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.SystemFairylandBossView.Name)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.SystemFairylandView.Name)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
end

