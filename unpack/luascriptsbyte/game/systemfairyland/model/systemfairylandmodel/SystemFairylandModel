---获取boss已挑战最高层sid
---@param bossID number 风花雪月
---@return number 层数sid（未通关过则为0）
function SystemFairylandModel:GetCurLayer(bossID)
    return self.fairylandLayer[bossID]
end

---获取boss已挑战最高层cfg
---@param bossID number 风花雪月
---@return system_fairyland_cfg 层数cfg（未通关过则为nil）
function SystemFairylandModel:GetCurLayerCfg(bossID)
    if self.fairylandLayer[bossID] == 0 then
        return nil
    else
        return system_fairyland_cfg[self.fairylandLayer[bossID]]
    end
end

---获取boss当前挑战层的sid
---@param bossID number 风花雪月
---@return number, system_fairyland_cfg 层数sid, 配置（全通关则为nil）
function SystemFairylandModel:GetNextLayer(bossID)
    local cfg
    if self.fairylandLayer[bossID] == 0 then
        cfg = self.bossCfg[bossID][1]
        return cfg.id, cfg
    end
    local nextSid = self.fairylandLayer[bossID] + 1
    cfg = system_fairyland_cfg[nextSid]
    if cfg then
        return nextSid, cfg
    end
    return nil, nil
end

---某一关能否挑战
function SystemFairylandModel:CheckSectionCanChallenge(sectionId)
    local cfg = _G.ConfigManager.system_fairyland_cfg[sectionId]
    if cfg.pre_section > 0 then
        local preCfg = _G.ConfigManager.system_fairyland_cfg[cfg.pre_section]
        local curCfg = self:GetCurLayerCfg(preCfg.grade)
        if curCfg == nil then
            return false
        end
        if cfg.grade ~= preCfg.grade then
            local bossCfg = _G.ConfigManager.system_fairyland_chapter_cfg[cfg.grade]
            return _G.GlobalConditionManager.CheckConditionArrays(bossCfg.limit_condition)
        end
        return curCfg.difficulty >= preCfg.difficulty
    end
    local bossCfg = _G.ConfigManager.system_fairyland_chapter_cfg[cfg.grade]
    return _G.GlobalConditionManager.CheckConditionArrays(bossCfg.limit_condition)
end

---根据boss和层数获取配置
---@param bossID number 风花雪月
---@param layer number 层数
---@return system_fairyland_cfg 层数cfg（未通关过则为nil）
function SystemFairylandModel:GetCfgByBossAndLayer(bossID, layer)
    for _, v in pairs(self.bossCfg[bossID]) do
        if v.difficulty == layer then
            return v
        end
    end
    -- return system_fairyland_cfg[100000 + bossID * 100 + layer]
end

---是否通关最高层
---@param bossID number 风花雪月
function SystemFairylandModel:CheckPassMaxLayer(bossID)
