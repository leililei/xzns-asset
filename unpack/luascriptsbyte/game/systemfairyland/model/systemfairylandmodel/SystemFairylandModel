---创建对象时,入口构造函数
function SystemFairylandModel:__init()
    self.bossCfg = {}
    local bossGradeCount = {}
    self.bossCount = 0
    self.layerCount = {}
    self.layerFinalID = {}
    for _, v in pairs(system_fairyland_cfg) do
        if not bossGradeCount[v.grade] then
            bossGradeCount[v.grade] = true
            self.layerCount[v.grade] = 0
            self.bossCount = self.bossCount + 1
            self.bossCfg[v.grade] = {}
        end
        self.layerCount[v.grade] = self.layerCount[v.grade] + 1
        self.layerFinalID[v.grade] = self.layerFinalID[v.grade] or 0
        self.layerFinalID[v.grade] = v.id > self.layerFinalID[v.grade] and v.id or self.layerFinalID[v.grade]
        _G.table.insert(self.bossCfg[v.grade], v)
        table.sort(
            self.bossCfg[v.grade],
            function(a, b)
                return a.difficulty < b.difficulty
            end
        )
    end
    self.awardState = {} --奖励是否领取
    self.sectionStar = {} --关卡星级解锁状态
    self.fairylandLayer = {}
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.OnSixClockUpdateCallback, self)
end

---从服务器拉取数据
function SystemFairylandModel:GetDataFormServer()
    SystemFairylandNet:GetInstance():GetInfo(_G.handler(self, self.ParseData))
end

---@param msg system_fairyland.s2c_system_fairyland_info
function SystemFairylandModel:ParseData(msg)
    self.awardState = {} --奖励是否领取
    self.sectionStar = {} --关卡星级解锁状态
    self.fairylandLayer = {}
    for i = 1, self.bossCount do
        self.fairylandLayer[i] = 0
    end
    if msg.fairyland_info then
        local cfg
        for _, v in pairs(msg.fairyland_info) do
            self.sectionStar[v.sid] = {}
            for _, idx in pairs(v.index) do
                self.sectionStar[v.sid][idx] = true
            end
            cfg = system_fairyland_cfg[v.sid]
            if v.sid > self.fairylandLayer[cfg.grade] then
                self.fairylandLayer[cfg.grade] = v.sid
            end
        end
    end
    if msg.chapter_info then -- 奖励信息
        for _, v in pairs(msg.chapter_info) do
            self.awardState[v.sid] = {}
            if v.type then
                for _, t in pairs(v.type) do
                    self.awardState[v.sid][t] = true
                end
            end
        end
    end
    self.super.ParseData(self)
end

