---查看是否未满星
function SystemFairylandModel:CheckNOFullStar()
    local hasNoFull = false
    for _, cfg in pairs(_G.ConfigManager.system_fairyland_chapter_cfg) do
        if self:CheckNOFullStarCount(cfg.id) then
            hasNoFull = true
            break
        end
    end
    return hasNoFull
end

---判断星数
function SystemFairylandModel:CheckNOFullStarCount(bossID)
    for _, v in pairs(system_fairyland_cfg) do
        if v.grade == bossID then
            local stars = {}
            local starsCount = 0
            for j = 1, 3 do
                stars[j] = self:GetSectionStarUnlock(v.id, j)
                if stars[j] then
                    starsCount = starsCount + 1
                end
            end
            if starsCount > 0 and starsCount < 3 then
                return true
            end
        end
    end
    return false
end

