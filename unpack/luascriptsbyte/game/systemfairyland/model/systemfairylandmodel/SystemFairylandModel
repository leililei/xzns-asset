---x关第x个星是否点亮
function SystemFairylandModel:GetSectionStarUnlock(sid, index)
    return self.sectionStar[sid] and self.sectionStar[sid][index] or false
end

function SystemFairylandModel:GetBossStarCount(bossID)
    local num = 0
    for _, v in pairs(self.bossCfg[bossID]) do
        if self.sectionStar[v.id] then
            num = num + _G.table.count(self.sectionStar[v.id])
        end
    end
    return num
end

function SystemFairylandModel:RefreshStarState(sid, indexes)
    self.sectionStar[sid] = {}
    for _, idx in pairs(indexes) do
        self.sectionStar[sid][idx] = true
    end
end

function SystemFairylandModel:GetStarConditionStr(condition)
    local _type = condition[1]
    if _type == FSE.win then
        return _G.GetLangPackValue(starConLang[_type])
    elseif _type == FSE.sec or _type == FSE.dieNum or _type == FSE.killNum or _type == FSE.diffEle then
        return _G.GetLangPackValue(starConLang[_type], condition[2])
    elseif _type == FSE.leastEle or _type == FSE.mostEle then
        return _G.GetLangPackValue(
            starConLang[_type],
            condition[2],
            _G.GetLangPackValue(_G.ElementStrEnum[condition[3]])
        )
    elseif _type == FSE.leastPro or _type == FSE.mostPro then
        return _G.GetLangPackValue(
            starConLang[_type],
            condition[2],
            _G.GetLangPackValue(_G.ProfessionalStrEnum[condition[3]])
        )
    elseif _type == FSE.mulEle then
        return _G.GetLangPackValue(
            starConLang[_type],
            _G.GetLangPackValue(_G.ElementStrEnum[condition[3]]),
            _G.GetLangPackValue(_G.ElementStrEnum[condition[4]]),
            _G.GetLangPackValue(_G.ElementStrEnum[condition[5]]),
            _G.GetLangPackValue(_G.ElementStrEnum[condition[6]])
        )
    elseif _type == FSE.noPro then
        return _G.GetLangPackValue(
            starConLang[_type],
            _G.GetLangPackValue(_G.ProfessionalStrEnum[condition[2]]),
            _G.GetLangPackValue(_G.ProfessionalStrEnum[condition[3]])
        )
    elseif _type == FSE.allPro then
        return _G.GetLangPackValue(starConLang[_type], 5, _G.GetLangPackValue(_G.ProfessionalStrEnum[condition[3]]))
    elseif _type == FSE.appoint2 then
        local name1 = _G.GetLangPackValue(_G.ConfigManager.card_cfg[condition[2]].Name)
        local name2 = _G.GetLangPackValue(_G.ConfigManager.card_cfg[condition[3]].Name)
        return _G.GetLangPackValue(starConLang[_type], name1, name2)
    elseif _type == FSE.highHP then
        return _G.GetLangPackValue(starConLang[_type], _G.tostring(condition[2] / 100))
    elseif _type == FSE.leastStar then
        return _G.GetLangPackValue(starConLang[_type], condition[2], condition[3])
    elseif _type == FSE.leastOrder then
        return _G.GetLangPackValue(starConLang[_type], condition[2], _G.OrderStrEnum[condition[3]])
    end
    return _G.GetLangPackValue(starConLang[_type])
end

function SystemFairylandModel:CheckStarAwardIsGet(bossID, _type)
    if self.awardState[bossID] == nil then
        return false
    end
    return self.awardState[bossID][_type]
end

function SystemFairylandModel:GetAllUnlockAwardType(bossID)
    local count = self:GetBossStarCount(bossID)
    local cfg = _G.ConfigManager.system_fairyland_chapter_cfg[bossID]
    local typeLis = {}
    for i = 1, 3 do
        if count >= cfg["star" .. i] and not self:CheckStarAwardIsGet(bossID, i) then
            _G.table.insert(typeLis, i)
        end
    end
    return typeLis
end

function SystemFairylandModel:GetStarAward(bossID, typeLis, call)
    local pbData = {chapter_id = bossID, type = typeLis}
    SystemFairylandNet:GetInstance():GetStarAward(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            if self.awardState[bossID] == nil then
                self.awardState[bossID] = {}
            end
            for _, _type in pairs(typeLis) do
                self.awardState[bossID][_type] = true
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            if call then
                call(msg)
            end
        end
    )
end

