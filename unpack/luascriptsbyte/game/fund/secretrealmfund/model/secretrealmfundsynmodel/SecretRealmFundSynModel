local base = require "ActivitySynTypeBase"
---@class SecretRealmFundSynModel : ActivitySynTypeBase	中文描述
local SecretRealmFundSynModel = _G.BaseClass("SecretRealmFundSynModel", base)
-- _G.SecretRealmFundSynModel = SecretRealmFundSynModel

-- local CS = _G.CS
-- local typeof = _G.typeof

---创建对象时,入口构造函数
function SecretRealmFundSynModel:__init()
    self.SecretRealmFundModel = require "SecretRealmFundModel":GetInstance()
    self.SecretRealmFundModel:SetFreshRedPoint(_G.handler(self, self.RefreshRedPoint))
    local model = require("FundModel")
    model:GetInstance():AddFundAcivitySynType(model.FundTypeValue.SecretRealm, self)
end

--- 网络请求初始化
function SecretRealmFundSynModel:GetDataFormServer()
    self.SecretRealmFundModel:GetInfo(_G.handler(self, self.ParseData))
end

---数据解析完成
function SecretRealmFundSynModel:ParseData()
    base.ParseData(self)
end

function SecretRealmFundSynModel:InitFunction()
    self.SecretRealmFundModel:InitFunction()
end

---进入活动主体
function SecretRealmFundSynModel:OnEnterActivity()
    -- ZHJH-2064 成长基金和降临基金合并
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FundMainView.Name,self.SecretRealmFundModel.fundType)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function SecretRealmFundSynModel:OnGetMainViewName()
    -- ZHJH-2064 成长基金和降临基金合并
    return _G.ConfigManager.ui_cfg.FundMainView.Name
end

---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function SecretRealmFundSynModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end

function SecretRealmFundSynModel:GetRedPoint()
    return require("SecretRealmFundModel"):GetInstance():IsHaveGet() and 1 or 0
end

function SecretRealmFundSynModel:CheckRedPoint()
    local _type = require("FundModel"):GetInstance().FundTypeValue.SecretRealm
    return require("FundModel"):GetInstance():GetFundAcivityRedPoint(_type)
end

---刷新奖励红点
function SecretRealmFundSynModel:RefreshRedPoint()
    --local activity = self.fundModel:GetInstance():GetFundAcivitySynModel(self.fundModel.FundTypeValue.Login)
    --require("RedPointManager"):GetInstance():RefreshNode(activity:GetRedpointIDByIndex(1))
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function SecretRealmFundSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

--endregion

--endregion
---销毁对象时,析构函数
function SecretRealmFundSynModel:Dispose()
end

function SecretRealmFundSynModel:ReConnect(endcall)
    self.SecretRealmFundModel:ReConnect(endcall)
end

return SecretRealmFundSynModel
