local base = require "ActivitySynTypeBase"
---@class LoginFundSynModel : ActivitySynTypeBase	中文描述
local LoginFundSynModel = _G.BaseClass("LoginFundSynModel", base)
-- _G.LoginFundSynModel = LoginFundSynModel

-- local CS = _G.CS
-- local typeof = _G.typeof

---创建对象时,入口构造函数
function LoginFundSynModel:__init()
    self.LoginFundModel = require "LoginFundModel":GetInstance()
    self.LoginFundModel:SetFreshRedPoint(_G.handler(self, self.RefreshRedPoint))
    local model = require("FundModel")
    model:GetInstance():AddFundAcivitySynType(model.FundTypeValue.Login, self)
end

--- 网络请求初始化
function LoginFundSynModel:GetDataFormServer()
    self.LoginFundModel:GetInfo(_G.handler(self, self.ParseData))
end

---数据解析完成
function LoginFundSynModel:ParseData()
    base.ParseData(self)
end

function LoginFundSynModel:InitFunction()
    self.LoginFundModel:InitFunction()
end

---进入活动主体
function LoginFundSynModel:OnEnterActivity()
    -- ZHJH-2064 成长基金和降临基金合并
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FundMainView.Name,self.LoginFundModel.fundType)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function LoginFundSynModel:OnGetMainViewName()
    -- ZHJH-2064 成长基金和降临基金合并
    return _G.ConfigManager.ui_cfg.FundMainView.Name
end

---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function LoginFundSynModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end

function LoginFundSynModel:GetRedPoint()
    return require("LoginFundModel"):GetInstance():IsHaveGet() and 1 or 0
end

function LoginFundSynModel:CheckRedPoint()
    local _type = require("FundModel"):GetInstance().FundTypeValue.Login
    return require("FundModel"):GetInstance():GetFundAcivityRedPoint(_type)
end

---刷新奖励红点
function LoginFundSynModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function LoginFundSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

--endregion

--endregion
---销毁对象时,析构函数
function LoginFundSynModel:Dispose()
end

function LoginFundSynModel:ReConnect(endcall)
    self.LoginFundModel:ReConnect(endcall)
end

return LoginFundSynModel
