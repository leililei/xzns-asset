function LoginFundView:RefreshList(index, objGame)
    if index < 0 then
        return
    end
    local data = self.countCfgArr[index + 1]
    objGame.SetName(index)
    if not table.ContainsValue(self.itemList, objGame) then
        self.itemList[index] = objGame
    end
    --for i = 1, #self.itemList do
    --    _G.SortList(
    --            self.itemList,
    --            function(a)
    --                return -a.name
    --            end
    --    )
    --    self.itemList[i]:SetSiblingIndexE(i)
    --end
    local itemGoTable = _G.GetAutoGoTable(objGame)

    --if itemGoTable.addClick == nil then
    --    itemGoTable.aorbtn_get1.onClick:AddListener(_G.handlerbind(self, self.OnClick_item, itemGoTable, false))
    --    itemGoTable.aorbtn_get2.onClick:AddListener(_G.handlerbind(self, self.OnClick_item, itemGoTable, true))
    --    itemGoTable.addClick = true
    --end


    itemGoTable.data = data
    itemGoTable.ispass = _G.GlobalConditionManager.CheckCondition(data.conditions[1], data.conditions[2])
    itemGoTable.isGet1 = require("LoginFundModel"):GetInstance():IsAward(data.id, false)
    itemGoTable.isGet2 = require("LoginFundModel"):GetInstance():IsAward(data.id, true)

    ---设置可领取
    local isGet1 = false
    local isGet2 = false
    if itemGoTable.ispass then
        isGet1 = itemGoTable.isGet1 == false
        isGet2 = itemGoTable.isGet2 == false and self.isUp == true
    end

    -- 加载可领取特效
    local eff = _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang
    if itemGoTable.eff1 then
        itemGoTable.eff1:SetActiveE(isGet1 and 1 or 0)
    else
        _G.UIUtils.LoadEffectByCfg(
            eff,
            itemGoTable.obj_eff1,
            function(trans)
                if _G.IsNil(itemGoTable.obj_eff1) then
                    _G.DestroyObject(trans)
                    return
                end
                itemGoTable.eff1 = trans
                trans:SetLocalScaleXYZ(0.72)
                -- trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                itemGoTable.eff1:SetActiveE(isGet1 and 1 or 0)
            end
        )
    end
    if itemGoTable.eff2 then
        itemGoTable.eff2:SetActiveE(isGet2 and 1 or 0)
    else
        _G.UIUtils.LoadEffectByCfg(
            eff,
            itemGoTable.obj_eff2,
            function(trans)
                if _G.IsNil(itemGoTable.obj_eff2) then
                    _G.DestroyObject(trans)
                    return
                end
                itemGoTable.eff2 = trans
                trans:SetLocalScaleXYZ(0.72)
                -- trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                itemGoTable.eff2:SetActiveE(isGet2 and 1 or 0)
            end
        )
    end

    if itemGoTable.aorbtn_getaward then
        itemGoTable.aorbtn_getaward:SetActiveE(1)
        itemGoTable.aorimage_get:SetActiveE(0)
        itemGoTable.aorbtn_getaward.onClick:RemoveAllListeners()
        if (isGet2 or isGet1) then
            -- 可领取
            itemGoTable.aorimage_getaward.SpriteName = "ui_ty_kuang_00"
            itemGoTable.aorimage_getaward:SetGray(false)
            itemGoTable.aorimage_getaward.color = _G.ColorTools.FormatColorByString("FFFFFF")
            itemGoTable.aortext_text.text = _G.GetLangPackValue(90027500003)
            itemGoTable.aortext_text.color = _G.ColorTools.FormatColorByString("914801")
            itemGoTable.aorbtn_getaward.onClick:AddListener(_G.handler(self,self.OnClick_item))
        elseif itemGoTable.isGet1 and not itemGoTable.isGet2 then
            --  普通奖励领取，但是没有氪金
            itemGoTable.aorimage_getaward.SpriteName = "ui_ty_kuang_00"
            itemGoTable.aorimage_getaward:SetGray(false)
            itemGoTable.aorimage_getaward.color = _G.ColorTools.FormatColorByString("FFFFFF")
            itemGoTable.aortext_text.text = _G.GetLangPackValue(90025200011)
            itemGoTable.aortext_text.color = _G.ColorTools.FormatColorByString("914801")
            itemGoTable.aorbtn_getaward.onClick:AddListener(_G.handler(self,self.ShowBuyTips))
        elseif itemGoTable.isGet1 and itemGoTable.isGet2 then
            -- 奖励都被领取
            itemGoTable.aorbtn_getaward:SetActiveE(0)
            itemGoTable.aorimage_get:SetActiveE(1)
        elseif not itemGoTable.isGet1 and not itemGoTable.isGet2 then
            -- 都不能领取（没有达到条件）
            itemGoTable.aorimage_getaward.SpriteName = "ui_ty_kuang_00"
            itemGoTable.aorimage_getaward:SetGray(true)
            itemGoTable.aorimage_getaward.color = _G.ColorTools.FormatColorByString("A9A9A9")

            itemGoTable.aortext_text.text = _G.GetLangPackValue(90020400086)
            itemGoTable.aortext_text.color = _G.ColorTools.FormatColorByString("434343")
        end
    end

    local rewards = data.rewards_normal
    _G.StorageManager:GetInstance():GetItem(
            itemGoTable.obj_item1,
            rewards[1][1],
            rewards[1][2],
            _G.handlerbind(self, self.itemCall, itemGoTable, false)
    )


    local shoTipsFun = nil

    rewards = data.rewards_pay
    _G.StorageManager:GetInstance():GetItem(
            itemGoTable.obj_item2,
            rewards[1][1],
            rewards[1][2],
            _G.handlerbind(self, self.itemCall, itemGoTable, true),
            _G.handlerbind(self, self.ShowBuyTips, itemGoTable)
    )
    

    --_G.GameUtil.SetActiveByCondition(itemGoTable.aorbtn_get1, isGet1)
    --_G.GameUtil.SetActiveByCondition(itemGoTable.aorbtn_get2, isGet2)

    if self.Params_GetIndex == nil then
        if isGet1 or isGet2 then
            self.Params_GetIndex = index
        end
    end

    _G.GameUtil.SetActiveByCondition(itemGoTable.obj_gou1, itemGoTable.isGet1 == true)
    _G.GameUtil.SetActiveByCondition(itemGoTable.obj_gou2, itemGoTable.isGet2 == true)
    --_G.GameUtil.SetActiveByCondition(itemGoTable.obj_suo2, itemGoTable.isGet2 == false and isGet2 == false)

    local layer = 0
    if data.conditions[1] == _G.GlobalConditionManager.ConditionType.DeadsoulTower then
        layer = require("DeadsoulTowerModel"):GetInstance():Getlayer(data.conditions[2])
    else
        if _G.AppSetting.DEBUG then
            _G.LogError(" 配置的 任务目标 不是 死魂塔 需修改显示")
        end
    end
    --local str = _G.LangUtil.GetLangPackValue(self.UiDic.tgc, tostring(layer))
    --itemGoTable.aortext_1.text = str
    --itemGoTable.aortext_2.text = str

    ---true可领取豪华奖励 显示可领取标志 不显示领取章节
    local isShowGetTips = (itemGoTable.ispass and itemGoTable.isGet2 == false)
    --itemGoTable.aorimage_geticon.SpriteName = isShowGetTips and "UI_czjj_bt_02" or "UI_czjj_title_01"
    --itemGoTable.aorimage_geticon:SetNativeSize()
    --_G.GameUtil.SetActiveByCondition(itemGoTable.aortext_2, isShowGetTips == false)

    ---进度条
    itemGoTable.aortext_lv.text = _G.GetLangPackValue(90037010103, layer)
    itemGoTable.aorimage_progress:SetActiveE(BoolToNumber(index ~= 0))

    --itemGoTable.aorimage_lvBg:SetGray(not (layer - 1 <= self.curLayer))
    if layer - 1 <= self.curLayer then
        itemGoTable.aorimage_dayBar:SetLocalScale(1, 1, 1)
    elseif index > 0 then
        local lastLayer = require("DeadsoulTowerModel"):GetInstance():Getlayer(self.countCfgArr[index].conditions[2])
        local curValue = self.curLayer - lastLayer
        local totalValue = layer - lastLayer
        itemGoTable.aorimage_dayBar:SetLocalScale(1, curValue >= 0 and curValue / totalValue or 0, 1)
    end
    return objGame
end

---刷新底部显示逻辑
function LoginFundView:RefreshBottom()
    local index = require("LoginFundModel"):GetInstance():GetHaveGetIndex()

    local aidList = require("LoginFundModel"):GetInstance():GetAwardList(self.countCfgArr)
    if #aidList > 0 then
        --self.go_table.aorimage_lvBg:SetGray(false)
        for i = 1, #self.countCfgArr do
            local data = self.countCfgArr[i]
            if data.id == aidList[#aidList] then
                local rewards = data.rewards_normal
                _G.StorageManager:GetInstance():GetItem(
                        self.go_table.obj_item1,
                        rewards[1][1],
                        rewards[1][2],
                        _G.handlerbind(self, self.itemCall, self.go_table, false)
                )

                rewards = data.rewards_pay
                _G.StorageManager:GetInstance():GetItem(
                        self.go_table.obj_item2,
                        rewards[1][1],
                        rewards[1][2],
                        _G.handlerbind(self, self.itemCall, self.go_table, true),
                        _G.handlerbind(self, self.ShowBuyTips, self.go_table)
                )

                _G.GameUtil.SetActiveByCondition(self.go_table.obj_gou1, false)
                _G.GameUtil.SetActiveByCondition(self.go_table.obj_gou2, false)
                --_G.GameUtil.SetActiveByCondition(self.go_table.obj_suo2, self.isUp == false)
                self.go_table.aortext_lv.text = _G.GetLangPackValue(
                        90037010103,
                        require("DeadsoulTowerModel"):GetInstance():Getlayer(data.conditions[2])
                )
                break
            end
        end
    else
        local data = self.countCfgArr[index]
        for i = 1, #self.countCfgArr do
            local ispass = _G.GlobalConditionManager.CheckCondition(self.countCfgArr[i].conditions[1], self.countCfgArr[i].conditions[2])
            if ispass then
                data = self.countCfgArr[i + 1]
            end
        end
        -- 防止一轮基金领取完毕后，第二轮基金信息没有获取就刷新界面
        if not data then
            return
        end
        local rewards = data.rewards_normal
        _G.StorageManager:GetInstance():GetItem(
                self.go_table.obj_item1,
                rewards[1][1],
                rewards[1][2],
                _G.handlerbind(self, self.itemCall, self.go_table, false)
        )

        rewards = data.rewards_pay
        _G.StorageManager:GetInstance():GetItem(
                self.go_table.obj_item2,
                rewards[1][1],
                rewards[1][2],
                _G.handlerbind(self, self.itemCall, self.go_table, true),
                _G.handlerbind(self, self.ShowBuyTips, self.go_table)
        )

        local isGet1 = require("LoginFundModel"):GetInstance():IsAward(data.id, false)
        local isGet2 = require("LoginFundModel"):GetInstance():IsAward(data.id, true)

        _G.GameUtil.SetActiveByCondition(self.go_table.obj_gou1, isGet1 == true)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_gou2, isGet2 == true)
        --_G.GameUtil.SetActiveByCondition(self.go_table.obj_suo2, isGet2 == false and self.isUp == false)
        self.go_table.aortext_lv.text = _G.GetLangPackValue(
                90037010103,
                require("DeadsoulTowerModel"):GetInstance():Getlayer(data.conditions[2])
        )

        --self.go_table.aorimage_lvBg:SetGray(true)
    end
    --self.go_table.aorbtn_oneKey:SetGray(#aidList <= 0)
end

---@param isUp boolean true是豪华奖励
function LoginFundView:itemCall(itemLua, storageType, itemGoTable, isUp)
    if storageType == _G.StorageType.Material or storageType == _G.StorageType.ResProp then
        ---@type ItemViewBase
        local lua = itemLua
        lua:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        if lua.SetGradeNew then
            lua:SetGradeNew(false)
        end
        local isShowEffect = false
        if itemGoTable.ispass then
            if isUp then
                if self.isUp and itemGoTable.isGet2 == false then
                    isShowEffect = true
                end
            else
                if itemGoTable.isGet1 == false then
                    isShowEffect = true
                end
            end
        end
        lua:ShowEffect(isShowEffect)
    end
end

function LoginFundView:OnClick_item()
    local sid = self.id
    local aidList = require("LoginFundModel"):GetInstance():GetAwardList(self.countCfgArr)
    if #aidList <= 0 then
        return
    end
    require("FundModel"):GetInstance():GetAward(
        sid,
        2,
        aidList,
        function()
            if self:IsNil() then
                return
            end
            self:UpdataView()

            --更新父页面红点状态
            ---@type FundMainView
            local parentView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.FundMainView.Name)
            if parentView then
                parentView:UpdateRedpointView()
            end
        end
    )
end

function LoginFundView:BuyUp()
    local id = self.id
    require("FundModel"):GetInstance():BuyUp(
            id
    -- ,
    -- function()
    --     require("LoginFundModel"):GetInstance():SetIsUp(id)
    --     self:UpdataView()
    -- end
    )
end

function LoginFundView:OnMallCashListener(data)
    local cfg = _G.ConfigManager.store_battle_pass_cfg[data.sid]
    if cfg and cfg.display_priority == 2 then
        require("LoginFundModel"):GetInstance():SetIsUp(data.sid)
        require "SDKDotManager":GetInstance():OnEvent(_G.SDKDotType.SDKDot_Fund, self.cfg.price_id)

        --LoginFundModel和GrowthFundModel会检测对方的红点, 因此需要同时刷新
        --require("LoginFundModel"):GetInstance():RedCheck()
        require("GrowthFundModel"):GetInstance():RedCheck()

        self:UpdataView()
        --更新父页面红点状态
        ---@type FundMainView
        local parentView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.FundMainView.Name)
        if parentView then
            parentView:UpdateRedpointView()
        end
    end
end

function LoginFundView:OnDestroy()
    if self.Co then
        _G.coroutine.stopwaiting(self.Co)
        self.Co = nil
    end
    if self.effTimer then
        self.effTimer:Stop()
        self.effTimer = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

function LoginFundView:ShowBuyTips(itemlua, btnObj, isOn, itemGoTable)
    if itemGoTable == nil or itemGoTable.ispass and itemGoTable.isGet2 == false and self.isUp == false then
        self.Lua_buyTips:Show()
    else
        require("CommonTipManager"):GetInstance():OpenPropTip(itemlua.gameObject, itemlua.sid)
    end
end

function LoginFundView:Hide()
    self.go_table.gameObject:SetActiveE(0)
end

function LoginFundView:Show()
    self.go_table.gameObject:SetActiveE(1)
end

function LoginFundView:CloseView()
    self:Close()
end

---按钮点击事件在这里派发
function LoginFundView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

function LoginFundView:CloseView()
    self:Close()
end

return LoginFundView
