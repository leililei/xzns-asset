function LoginFundView:Awake()
    self.id = require "LoginFundModel":GetInstance().sid
    self.itemList = {}
    self.UiDic = {
        --通关第%s层
        tgc = 90025200002,
        --通关死魂塔可领取（已通关%s层）
        tgtklq = 90025200004,
        name = _G.LangUtil.GetLangPackValue(90025200008)
    }

    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.obj_item:SetActiveE(0)

    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        [self.go_table.aorbtn_btn:GetName()] = self.ShowBuyTips,
        [self.go_table.aorbtn_oneKey:GetName()] = self.OnClick_item,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    self:UpdateCfg()

    ---@type Params_FundBuyTips
    local Params_FundBuyTips = {}
    Params_FundBuyTips.okFun = function()
        self:BuyUp()
    end
    Params_FundBuyTips.contentIds = self.cfg.content
    Params_FundBuyTips.goods = self.cfg.goods
    Params_FundBuyTips.price_id = self.cfg.price_id
    Params_FundBuyTips.name = self.UiDic.name
    Params_FundBuyTips.id = self.id

    _G.PoolsManager:GetInstance():Spawn(
        "UIH5/GrowthFundView/$_obj_FundBuyTips",
        _G.ePoolType.UIItem,
        self.go_table.obj_buy,
        function (obj)
            local view = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.FundMainView.Name)
            local sort = view.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
            self.go_table.obj_buy:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder = sort + 160
            self.Lua_buyTips = require("FundBuyTips").New(obj, self, Params_FundBuyTips)
        end
    )

    local content = _G.GameUtil.SetPriceByChannel(self.cfg.price_id)
    self.go_table.aortext_rmb.text = _G.GetLangPackValue(90025500017, content)

    local cfg = _G.ConfigManager.currency_type_cfg[self.cfg.goods[1][1]]
    local icon = cfg.Icon and cfg.Icon or cfg.icon
    self.go_table.aorrawimage_baseAwardIcon:LoadImage(icon)
    self.go_table.aortext_baseAwardCount.text = "+" .. self.cfg.goods[1][2]
    self.go_table.aortext_nums.text = _G.GetLangPackValue(90031100031) .. "%"
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

