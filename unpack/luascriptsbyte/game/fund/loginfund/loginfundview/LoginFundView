function LoginFundView:ChangePos()
    self.go_table.obj_fakeBtns:SetActiveE(require "GrowthFundModel":GetInstance().store == nil and 0 or 1)
    if require "GrowthFundModel":GetInstance().store == nil then
        self.go_table.scrollloopvectical_items:SetRectTransformSize(684, -410)
    end
end

function LoginFundView:UpdataView()
    self.id = require "LoginFundModel":GetInstance().sid

    self:UpdateCfg()
    ---当前挑战章节
    self.nowLayer = require("DeadsoulTowerModel"):GetInstance():Getlayer() or 0
    ---当前通关层数
    self.curLayer = require("DeadsoulTowerModel"):GetInstance():GetCurLayer() or 0
    local title = "<color=#FFFFFF>" .. _G.GetLangPackValue(90029800019) .. "</color>"
    self.go_table.aortext_curLayer.text = title .. self.curLayer
    ---true 已购买豪华
    self.isUp = require("LoginFundModel"):GetInstance():GetIsUp()

    local aidList = require("LoginFundModel"):GetInstance():GetAwardList(self.countCfgArr)
    if #aidList <= 0 then
        self.go_table.aorbtn_oneKey:SetActiveE(0)
    else
        self.go_table.aorbtn_oneKey:SetActiveE(1)
    end

    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_btn, self.isUp == false)
    --self.go_table.aortext_tips.text = _G.LangUtil.GetLangPackValue(self.UiDic.tgtklq, tostring(self.nowLayer))

    ---可领取的index 方便跳转
    self.Params_GetIndex = require("LoginFundModel"):GetInstance():GetHaveGetIndex()
    if self.Params_GetIndex and self.Params_GetIndex >= 3 then
        self.Params_GetIndex = self.Params_GetIndex - 3
    else
        self.Params_GetIndex = 0
    end
    if self.Co then
        _G.coroutine.stopwaiting(self.Co)
        self.Co = nil
    end
    ---防止item同步产生 导致特效层级被减两次
    self.Co = _G.DelayFrameDo(
            function()
                if self.P_LoopInit == nil then
                    self.go_table.scrollloopvectical_items:InitItemData(
                            #self.countCfgArr,
                            _G.handler(self, self.RefreshList)
                    )
                    self.P_LoopInit = true
                else
                    self.go_table.scrollloopvectical_items:UpdateCount(#self.countCfgArr)
                end

                self:ScrollToIndex()
            end
    )
    self:RefreshBottom()
end

function LoginFundView:ScrollToIndex()
    _G.DelayFrameDo(
            function()
                self.go_table.scrollloopvectical_items:ScrollToIndex(self.Params_GetIndex)
            end
    )
end

