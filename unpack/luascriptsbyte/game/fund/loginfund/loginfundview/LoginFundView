function LoginFundView:UpdateCfg()
    ---@type store_battle_pass_cfg
    self.cfg = _G.ConfigManager.store_battle_pass_cfg[self.id]

    local store_battle_content_cfg = _G.ConfigManager.store_battle_content_cfg

    ---@type store_battle_content_cfg[]
    self.countCfgArr = {}

    local content = self.cfg.content
    ---@type store_battle_content_cfg
    local cfgItem
    local id
    for i = 1, #content do
        id = content[i]
        if id == nil or id == 0 then
            if _G.AppSetting.DEBUG then
                _G.LogError(" 配置id 无效  store_battle_content_cfg.content id:" .. tostring(id))
            end
            cfgItem = nil
        else
            cfgItem = store_battle_content_cfg[content[i]]
        end
        if cfgItem then
            table.insert(self.countCfgArr, cfgItem)
        end
    end
end

