---领取奖励
---@param sid number  基金id
---@param type number  奖励类型 （0,普通 1，豪华, 2全部奖励）
---@param aidList table  奖励的id列表
function FundModel:GetAward(sid, type, aidList, call)
    -- if call then
    --     call()
    -- end
    ---@type store_battle.c2s_store_battle_award
    local pb = {}
    pb.aid = aidList
    pb.type = type
    pb.sid = sid
    require("FundNet"):GetInstance():GetAward(pb, function(data)
        if data.ack ~= 1 then
            return
        end

        _G.StorageManager:GetInstance():ReceiveAwardData(data)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)

        ---回调后再检测
        local cfg = _G.ConfigManager.store_battle_pass_cfg[sid]
        for _, v in ipairs(aidList) do
            if cfg.display_priority == 1 then
                if type == 2 then
                    require("GrowthFundModel"):GetInstance():SetOneKeyAward(v)
                else
                    require("GrowthFundModel"):GetInstance():SetAward(v, type == 1)
                end
            elseif cfg.display_priority == 2 then
                if type == 2 then
                    require("LoginFundModel"):GetInstance():SetOneKeyAward(v)
                else
                    require("LoginFundModel"):GetInstance():SetAward(v, type == 1)
                end
            elseif cfg.display_priority == 4 then
                if type == 2 then
                    require("SecretRealmFundModel"):GetInstance():SetOneKeyAward(v)
                else
                    require("SecretRealmFundModel"):GetInstance():SetAward(v, type == 1)
                end
            elseif cfg.display_priority == 5 then
                if type == 2 then
                    require("RemainsFundModel"):GetInstance():SetOneKeyAward(v)
                else
                    require("RemainsFundModel"):GetInstance():SetAward(v, type == 1)
                end
            elseif cfg.display_priority == 6 then
                if type == 2 then
                    require("MaidFundModel"):GetInstance():SetOneKeyAward(v)
                else
                    require("MaidFundModel"):GetInstance():SetAward(v, type == 1)
                end
            end
        end
        -- LoginFundModel和GrowthFundModel会检测对方的红点, 因此需要同时刷新
        require("LoginFundModel"):GetInstance():RedCheck()
        require("GrowthFundModel"):GetInstance():RedCheck()
        require("SecretRealmFundModel"):GetInstance():RedCheck()
        require("MaidFundModel"):GetInstance():RedCheck()
        require("RemainsFundModel"):GetInstance():RedCheck()
        if cfg.display_priority == 1 then
            require("GrowthFundModel"):GetInstance():CheckNext(call)
        elseif cfg.display_priority == 2 then
            require("LoginFundModel"):GetInstance():CheckNext(call)
        elseif cfg.display_priority == 4 then
            require("SecretRealmFundModel"):GetInstance():CheckNext(call)
        elseif cfg.display_priority == 5 then
            require("RemainsFundModel"):GetInstance():CheckNext(call)
        elseif cfg.display_priority == 6 then
            require("MaidFundModel"):GetInstance():CheckNext(call)
        else
            if call then
                call()
            end
        end
    end)
end

function FundModel:OpenNextBattle(sid, callback)
    local msg = {
        sid = sid
    }
    require "FundNet":GetInstance():OpenNextBattle(msg, function(data)
        if data.ack ~= 1 then
            return
        end

        if callback() then
            callback()
        end
    end)
end

function FundModel:GetInfoPass(callback)
    require("FundNet"):GetInstance():GetInfoPass(function(data)
        if callback then
            callback(data)
        end
    end)
end

function FundModel:CheckRedPoint()
    local num = 0
    for k, v in pairs(self.fundAcivityList) do
        num = num + v:GetRedPoint()
    end
    return num >= 1 and 1 or 0
end

function FundModel:AddFundAcivitySynType(type, fundActivity)
    self.fundAcivityList[type] = fundActivity
end

function FundModel:GetFundAcivitySynModel(type)
    return self.fundAcivityList[type]
end

---获取对应活动的红点数量
---@param type number   目标活动类型
---@return number
function FundModel:GetFundAcivityRedPoint(type)
    local fundActivity = self.fundAcivityList[type]
    if fundActivity and fundActivity.GetRedPoint then
        return fundActivity:GetRedPoint()
    end
    return 0
end

---检查条件
function FundModel:CheckCondition(condition)
    if condition[1] == self.ConditionEnum.HellRoad then
        return _G.GlobalConditionManager.CheckCondition(_G.GlobalConditionManager.ConditionType.HellRoad, condition[2])
    end
    return false
end

