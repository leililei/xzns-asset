---@class FundBuyTips	中文描述
---@field closeFun function 取消
---@field okFun function 确认
---@field name number 名字
---@field num_diamond number 奖励钻石
---@field price_id number 价格
---@field contentIds number[] 包含内容 [ store_battle_content_cfg.id, store_battle_content_cfg.id,]
---@field LV number 当前战令等级
local FundBuyTips = _G.BaseClass("FundBuyTips")

local GetLangPackValue = _G.GetLangPackValue

---@class Params_FundBuyTips

---类的构造函数
---@param Params_FundBuyTips Params_FundBuyTips
function FundBuyTips:__init(obj, mParentView, Params_FundBuyTips)
    self.okFun = Params_FundBuyTips.okFun
    self.closeFun = Params_FundBuyTips.closeFun
    self.price_id = Params_FundBuyTips.price_id or 0
    self.goods = Params_FundBuyTips.goods
    self.storeContentCfg = Params_FundBuyTips.cfg or _G.ConfigManager.store_battle_content_cfg
    self.name = Params_FundBuyTips.name or ""
    ---@type number[] 包含内容 [ store_battle_content_cfg.id, store_battle_content_cfg.id,]
    self.contentIds = Params_FundBuyTips.contentIds
    self.id = Params_FundBuyTips.id
    self.customCond = Params_FundBuyTips.customCond

    self.gameObject = obj
    self.mParentView = mParentView
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self:Init()
    self:Hide()
    _G.GameUtil.AddDouYinIcon(self.go_table.aorbtn_btn, true)
end

function FundBuyTips:Parse(Params_FundBuyTips)
    self.okFun = Params_FundBuyTips.okFun
    self.closeFun = Params_FundBuyTips.closeFun
    self.price_id = Params_FundBuyTips.price_id or 0
    self.goods = Params_FundBuyTips.goods
    self.name = Params_FundBuyTips.name or ""
    self.customCond = Params_FundBuyTips.customCond
    self.storeContentCfg = Params_FundBuyTips.cfg or _G.ConfigManager.store_battle_content_cfg

    ---@type number[] 包含内容 [ store_battle_content_cfg.id, store_battle_content_cfg.id,]
    self.contentIds = Params_FundBuyTips.contentIds
    self:Init()
    self:Hide()
end

function FundBuyTips:Init()
    -- _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.FundBuyTips, self.go_table)
    local content = _G.GameUtil.SetPriceByChannel(self.price_id)
    self.go_table.aortext_rmb.text = GetLangPackValue(90025500017, content)

    self.go_table.aortext_name.text = self.name
    if self.contentIds == nil then
        if _G.AppSetting.DEBUG then
            _G.Log("", "<color=red>" .. "参数有误 奖励为空" .. "</color>")
        end
        return
    end

    ---总计获得
    ---{ sid=num, }
    local rewardsSumDic = {}
    ---立即获得
    local rewardsDic = {}
    ---购买立即奖励钻石
    rewardsDic[self.goods[1][1]] = self.goods[1][2]

    local sid, num, cfgid, isPass
    ---@type store_battle_content_cfg
    local cfgInfo
    for i = 1, #self.contentIds do
        ---奖励配置id
        cfgid = self.contentIds[i]
        ---奖励配置
        cfgInfo = self.storeContentCfg[cfgid]
        if cfgInfo then
            ---true可领取
            if self.customCond then
                isPass = require("FundModel"):GetInstance():CheckCondition(cfgInfo.conditions)
            else
                if cfgInfo.conditions[3] then
                    isPass = _G.GlobalConditionManager.CheckCondition(cfgInfo.conditions[1], cfgInfo.conditions[2],
                        cfgInfo.conditions[3])
                else
                    isPass = _G.GlobalConditionManager.CheckCondition(cfgInfo.conditions[1], cfgInfo.conditions[2])
                end
            end
            for j = 1, #cfgInfo.rewards_pay do
                sid = cfgInfo.rewards_pay[j][1]
                num = cfgInfo.rewards_pay[j][2]

                if rewardsSumDic[sid] == nil then
                    rewardsSumDic[sid] = num
                else
                    rewardsSumDic[sid] = rewardsSumDic[sid] + num
                end

                if isPass then
                    if rewardsDic[sid] == nil then
                        rewardsDic[sid] = num
                    else
                        rewardsDic[sid] = rewardsDic[sid] + num
                    end
                end
            end
        end
    end
    self.go_table.obj_item1:RemoveAllChildren()
    for awardSid, awardNum in pairs(rewardsDic) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew({
            [1] = awardSid,
            [2] = awardNum
        }, self.go_table.obj_item1, _G.handler(self, self.itemCall))
    end

    if _G.table.count(rewardsSumDic) >= 5 then
        self.go_table.obj_item2:SetPivotPosition(0, 0.5)
    end
    self.go_table.obj_item2:RemoveAllChildren()
    for awardSid, awardNum in pairs(rewardsSumDic) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew({
            [1] = awardSid,
            [2] = awardNum
        }, self.go_table.obj_item2, _G.handler(self, self.itemCall))
    end
    if not self.spine then
        self.go_table.trans_Spine:RemoveAllChildren()
        local cfg = _G.ConfigManager.card_cfg[116040000]
        self.go_table.trans_Spine:SetLocalScaleXYZ(0.5)
        self.go_table.trans_Spine:SetLocalPosition(0, 335, 0)
        _G.PoolsManager:GetInstance():Spawn(cfg.ModelPathHi, _G.ePoolType.UIItem, self.go_table.trans_Spine,
            function(trans)
                if not self.go_table then
                    _G.DestroyObject(trans)
                    return
                end
                GameUtil.SetCardUiSpineAnimation(trans, "idle", true)
                self.spine = trans
                trans:SetLocalScaleXYZ(0.8)
                trans:SetLocalPosition(_G.table.unpack(cfg.pos_portrait))
            end)
    end
end

function FundBuyTips:Show()
    _G.GameUtil.SetActiveByCondition(self.gameObject, true)
end

function FundBuyTips:Hide()
    _G.GameUtil.SetActiveByCondition(self.gameObject, false)
end

function FundBuyTips:itemCall(itemLua)
    ---@type ItemViewBase
    local lua = itemLua
    lua:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
    lua:ShowEffectOrder(true)
end

function FundBuyTips:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_btn then
        if self.okFun then
            self.okFun()
        end
        self:Hide()
    elseif go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close2 then
        if self.closeFun then
            self.closeFun()
        end
        self:Hide()
    end
end

---类的析构函数
function FundBuyTips:Dispose()
    self.spine = nil
end

return FundBuyTips
