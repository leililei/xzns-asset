---@class FundMainView : UIBaseView    中文描述
---@field public go_table FundMainView_GoTable GoTable
---@field redpointObjs table<number,number> 红点实例
local FundMainView = _G.BaseClass("FundMainView", _G.UIBaseView)

local viewPath = {
    Login = "LoginFundView",
    Growth = "GrowthFundView"
}
local viewPrefabs = {
    Login = _G.ConfigManager.ui_cfg.LoginFundView.PrefabPath,
    Growth = _G.ConfigManager.ui_cfg.GrowthFundView.PrefabPath
}
function FundMainView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject,_G.handler(self, self.OnClickBtn))
    self.FundModel = require("FundModel")
    self.FundView = {}
    self.btn = {
        Login = {img = self.go_table.aorimage_image1,text = self.go_table.aortext_text1},
        Growth = {img = self.go_table.aorimage_image2,text = self.go_table.aortext_text2}
    }
    self:UpdateRedpointView()
end

---@class params_FundMainView Data
