---更新红点状态(假红点, 需要手动更新)
---LoginFundModel和GrowthFundModel会检测对方的红点, 因此需要手动做假红点刷新
function FundMainView:UpdateRedpointView()
    if not self.redpointObjs then
        self.redpointObjs = {
            [self.FundModel.FundTypeValue.Login] = self.go_table.obj_redpoint1,
            [self.FundModel.FundTypeValue.Growth] = self.go_table.obj_redpoint2,
        }
    end
    for _, type in pairs(self.FundModel.FundTypeValue) do
        local obj = self.redpointObjs[type]
        if obj then
            local num = self.FundModel:GetInstance():GetFundAcivityRedPoint(type)
            obj:SetActiveE(num > 0 and 1 or 0)
        end
    end
end

--- 皇家补给是否开放修改ui位置
function FundMainView:ChangePos()
    if require "GrowthFundModel":GetInstance().store == nil then
        self.go_table.obj_btns:SetActiveE(0)
    end
end

function FundMainView:ChangeView(type)
    if self.fundType ~= type then
        local overFunc = function (type)
            if self.fundType then
                self.FundView[self.fundType]:Hide()
                self.btn[self.fundType].img.SpriteName = "ui_box_yeqian1"
                self.btn[self.fundType].text.color = _G.ColorTools.FormatColorByString("C6B69D")
            end
            self.FundView[type]:Show()
            self.btn[type].img.SpriteName = "ui_box_yeqian0"
            self.btn[type].text.color = _G.ColorTools.FormatColorByString("400E0E")
            self.fundType = type
        end

        if not self.FundView[type] then
            _G.PoolsManager:GetInstance():Spawn(
                viewPrefabs[type],
                _G.ePoolType.UIItem,
                self.go_table.obj_root,
                function (obj)
                    self.FundView[type] = self:AddComponent(obj,require(viewPath[type]).New(obj))
                    overFunc(type)
                end
            )
        else
            overFunc(type)
        end
    end
end

---按钮点击事件在这里派发
function FundMainView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_fund1 then
        self:ChangeView(self.FundModel.FundType.Login)
    elseif go == self.go_table.aorbtn_fund2 then
        self:ChangeView(self.FundModel.FundType.Growth)
    end
end

function FundMainView:CloseView()
    self:Close()
end

return FundMainView
