local CS = _G.CS
function GrowthFundView:Awake()
    self.id = require "GrowthFundModel":GetInstance().sid

    self.UiDic = {
        --第%s章
        chapter = 90022500370,
        --已通关
        passed = 90000000118,
        name = _G.LangUtil.GetLangPackValue(90025200007)
    }

    -- _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.obj_item:SetActiveE(0)

    --按钮点击对应的方法
    self.clickFunction = {
        [self.go_table.aorbtn_btn:GetName()] = self.ShowBuyTips,
        [self.go_table.aorbtn_oneKey:GetName()] = self.GetAward,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }

    self:UpdateCfg()

    ---@type Params_FundBuyTips
    local Params_FundBuyTips = {}
    Params_FundBuyTips.okFun = function()
        self:BuyUp()
    end
    Params_FundBuyTips.contentIds = self.cfg.content
    Params_FundBuyTips.goods = self.cfg.goods
    Params_FundBuyTips.price_id = self.cfg.price_id
    Params_FundBuyTips.name = self.UiDic.name
    Params_FundBuyTips.id = self.id

    _G.PoolsManager:GetInstance():Spawn(
        "UIH5/GrowthFundView/$_obj_FundBuyTips",
        _G.ePoolType.UIItem,
        self.go_table.obj_buy,
        function(obj)
            local view = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.FundMainView.Name)
            local sort = view.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
            self.go_table.obj_buy:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder = sort + 160
            self.Lua_buyTips = require("FundBuyTips").New(obj, self, Params_FundBuyTips)
        end
    )
    local content = _G.GameUtil.SetPriceByChannel(self.cfg.price_id)
    self.go_table.aortext_rmb.text = _G.GetLangPackValue(90025500017, content)

    local cfg = _G.ConfigManager.currency_type_cfg[self.cfg.goods[1][1]]
    local icon = cfg.Icon and cfg.Icon or cfg.icon
    self.go_table.aorrawimage_baseAwardIcon:LoadImage(icon)
    self.go_table.aortext_baseAwardCount.text = "+" .. self.cfg.goods[1][2]
    self.go_table.aortext_nums.text = _G.GetLangPackValue(90031100031) .. "%"
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

function GrowthFundView:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end

---@class params_GrowthFundView Data

---界面的入口函数
---@param  Data params_GrowthFundView
function GrowthFundView:OnCreate(Data)
    self:InitData()
    self:InitSpine()
    self:UpdataView()
    local res = _G.ConfigManager.ui_cfg.GrowthFundView.resources
    self:AddComponent(
        self.go_table.obj_GoldInfo,
        require("ResourceCompont").New(self.go_table.obj_GoldInfo, res)
    )
    self:AddComponent(
        self.go_table.obj_PlayerHead,
        require("PlayerComponent").New(self.go_table.obj_PlayerHead)
    )
end

function GrowthFundView:OnEnable()
    self:ScrollToIndex()
end

function GrowthFundView:InitData()
    self.itemData = {}
end

function GrowthFundView:InitSpine()
    _G.PoolsManager:GetInstance():Spawn(
        "WX_Role/Animation_UI/Lieyandeluyi_01_UI/prf_Lieyandeluyi_UI_ui",
        _G.ePoolType.UIItem,
        self.go_table.obj_spine,
        function (obj)
            if self:IsNil() then
                _G.DestroyObject(obj)
                return
            end
            obj:SetLocalScale(0.6,0.6,1)
        end
    )
end

function GrowthFundView:UpdateCfg()
    ---@type store_battle_pass_cfg
    self.cfg = _G.ConfigManager.store_battle_pass_cfg[self.id]

    local store_battle_content_cfg = _G.ConfigManager.store_battle_content_cfg

    ---@type store_battle_content_cfg[]
    self.countCfgArr = {}

    local content = self.cfg.content
    ---@type store_battle_content_cfg
    local cfgItem
    local id
    for i = 1, #content do
        id = content[i]
        if id == nil or id == 0 then
            if _G.AppSetting.DEBUG then
                _G.LogError(" 配置id 无效  store_battle_content_cfg.content id:" .. tostring(id))
            end
            cfgItem = nil
        else
            cfgItem = store_battle_content_cfg[content[i]]
        end
        if cfgItem then
            table.insert(self.countCfgArr, cfgItem)
        end
    end
end

function GrowthFundView:UpdataView()
    self.id = require "GrowthFundModel":GetInstance().sid
    self:UpdateCfg()
    ---当前挑战章节
    self.nowChpater = require("AfkModel"):GetInstance():GetCurAfkChapter() or 1
    ---true 已购买豪华
    self.isUp = require("GrowthFundModel"):GetInstance():GetIsUp()

    local aidList = require("GrowthFundModel"):GetInstance():GetAwardList(self.countCfgArr)
    if #aidList > 0 then
        self.go_table.aorbtn_oneKey:SetActiveE(1)
    else
        self.go_table.aorbtn_oneKey:SetActiveE(0)
    end

    ---可领取的index 方便跳转
    self.Params_GetIndex = require("GrowthFundModel"):GetInstance():GetHaveGetIndex()
    if self.Params_GetIndex and self.Params_GetIndex >= 3 then
        self.Params_GetIndex = self.Params_GetIndex - 3
    else
        self.Params_GetIndex = 0
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_btn, self.isUp == false)
    local str = _G.GetLangPackValue(self.UiDic.chapter,
        tostring("<color=#fac95f>" .. (self.nowChpater - 1) .. "</color>"))
    self.go_table.aortext_tips.text = _G.GetLangPackValue(self.UiDic.passed) .. ":" .. str
    if self.Co then
        _G.coroutine.stopwaiting(self.Co)
        self.Co = nil
    end
    ---防止item同步产生 导致特效层级被减两次
    self.Co =
        _G.DelayFrameDo(
            function()
                if self.P_LoopInit == nil then
                    self.go_table.scrollloopvectical_items:InitItemData(
                        #self.countCfgArr,
                        _G.handler(self, self.RefreshList)
                    )
                    self.P_LoopInit = true
                else
                    self.go_table.scrollloopvectical_items:UpdateCount(#self.countCfgArr)
                end
                self:ScrollToIndex()
                self:UpdateBottomItem()
            end
        )
end

function GrowthFundView:UpdateBottomItem()
    self.curItem = 3
    for i = 1, #self.itemData do
        if not _G.GlobalConditionManager.CheckCondition(self.itemData[i].conditions[1], self.itemData[i].conditions[2]) then
            self.curItem = i
            if self.itemData[i - 1] then
                self.canGet = require("GrowthFundModel"):GetInstance():IsAward(
                    self.itemData[i - 1].id,
                    false
                )
                self.canGet = require("GrowthFundModel"):GetInstance():IsAward(
                    self.itemData[i - 1].id,
                    true
                ) and self.canGet or false
                self.curItem = self.canGet and i - 1 or i
            end
            break
        end
    end
    --self.go_table.aorbtn_oneKey:SetGray(not self.canGet)
    self:RefreshList(self.curItem - 1, self.go_table.obj_bottomItem)
end

function GrowthFundView:ScrollToIndex()
    _G.DelayFrameDo(
        function()
            self.go_table.scrollloopvectical_items:ScrollToIndex(self.Params_GetIndex)
        end
    )
end

function GrowthFundView:UpdateDesc()
    self.go_table.scrollloopvectical_items:ScrollToIndex(self.Params_GetIndex)
end

function GrowthFundView:RefreshList(index, objGame)
    if index < 0 then
        return
    end
    local data = self.countCfgArr[index + 1]

    local itemGoTable = _G.GetAutoGoTable(objGame)
    if not self.itemData[index + 1] then
        self.itemData[index + 1] = data
    end

    itemGoTable.data = data
    itemGoTable.ispass = _G.GlobalConditionManager.CheckCondition(data.conditions[1], data.conditions[2])
    itemGoTable.isGet1 = require("GrowthFundModel"):GetInstance():IsAward(data.id, false)
    itemGoTable.isGet2 = require("GrowthFundModel"):GetInstance():IsAward(data.id, true)

    ---设置可领取
    local isGet1 = false
    local isGet2 = false

    if itemGoTable.ispass then
        isGet1 = itemGoTable.isGet1 == false
        isGet2 = itemGoTable.isGet2 == false and self.isUp == true
    end

    -- 加载可领取特效
    local eff = _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang
    if itemGoTable.eff1 then
        itemGoTable.eff1:SetActiveE(isGet1 and 1 or 0)
    else
        _G.UIUtils.LoadEffectByCfg(
            eff,
            itemGoTable.obj_eff1,
            function(trans)
                if _G.IsNil(itemGoTable.obj_eff1) then
                    _G.DestroyObject(trans)
                    return
                end
                itemGoTable.eff1 = trans
                trans:SetLocalScaleXYZ(0.72)
                -- trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                itemGoTable.eff1:SetActiveE(isGet1 and 1 or 0)
            end
        )
    end
    if itemGoTable.eff2 then
        itemGoTable.eff2:SetActiveE(isGet2 and 1 or 0)
    else
        _G.UIUtils.LoadEffectByCfg(
            eff,
            itemGoTable.obj_eff2,
            function(trans)
                if _G.IsNil(itemGoTable.obj_eff2) then
                    _G.DestroyObject(trans)
                    return
                end
                itemGoTable.eff2 = trans
                trans:SetLocalScaleXYZ(0.72)
                -- trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                itemGoTable.eff2:SetActiveE(isGet2 and 1 or 0)
            end
        )
    end

    if itemGoTable.aorbtn_getaward then
        itemGoTable.aorbtn_getaward:SetActiveE(1)
        itemGoTable.aorimage_get:SetActiveE(0)
        itemGoTable.aorbtn_getaward.onClick:RemoveAllListeners()
        if (isGet2 or isGet1) then
            -- 可领取
            itemGoTable.aorimage_getaward.SpriteName = "ui_ty_kuang_00"
            itemGoTable.aorimage_getaward:SetGray(false)
            itemGoTable.aorimage_getaward.color = _G.ColorTools.FormatColorByString("FFFFFF")
            itemGoTable.aortext_text.text = _G.GetLangPackValue(90027500003)
            itemGoTable.aortext_text.color = _G.ColorTools.FormatColorByString("914801")
            itemGoTable.aorbtn_getaward.onClick:AddListener(_G.handler(self, self.GetAward))
        elseif itemGoTable.isGet1 and not itemGoTable.isGet2 then
            --  普通奖励领取，但是没有氪金
            itemGoTable.aorimage_getaward.SpriteName = "ui_ty_kuang_00"
            itemGoTable.aorimage_getaward:SetGray(false)
            itemGoTable.aorimage_getaward.color = _G.ColorTools.FormatColorByString("FFFFFF")
            itemGoTable.aortext_text.text = _G.GetLangPackValue(90025200011)
            itemGoTable.aortext_text.color = _G.ColorTools.FormatColorByString("914801")
            itemGoTable.aorbtn_getaward.onClick:AddListener(_G.handler(self, self.ShowBuyTips))
        elseif itemGoTable.isGet1 and itemGoTable.isGet2 then
            -- 奖励都被领取
            itemGoTable.aorbtn_getaward:SetActiveE(0)
            itemGoTable.aorimage_get:SetActiveE(1)
        elseif not itemGoTable.isGet1 and not itemGoTable.isGet2 then
            -- 都不能领取（没有达到条件）
            itemGoTable.aorimage_getaward.SpriteName = "ui_ty_kuang_00"
            itemGoTable.aorimage_getaward:SetGray(true)
            itemGoTable.aorimage_getaward.color = _G.ColorTools.FormatColorByString("A9A9A9")

            itemGoTable.aortext_text.text = _G.GetLangPackValue(90020400086)
            itemGoTable.aortext_text.color = _G.ColorTools.FormatColorByString("434343")
        end
    end

    local rewards = data.rewards_normal
    _G.StorageManager:GetInstance():GetItem(
        itemGoTable.obj_item1,
        rewards[1][1],
        rewards[1][2],
        _G.handlerbind(self, self.itemCall, itemGoTable, false)
    )

    local shoTipsFun = nil

    rewards = data.rewards_pay
    _G.StorageManager:GetInstance():GetItem(
        itemGoTable.obj_item2,
        rewards[1][1],
        rewards[1][2],
        _G.handlerbind(self, self.itemCall, itemGoTable, true),
        _G.handlerbind(self, self.ShowBuyTips, itemGoTable)
    )

    _G.GameUtil.SetActiveByCondition(itemGoTable.obj_gou1, itemGoTable.isGet1 == true)
    _G.GameUtil.SetActiveByCondition(itemGoTable.obj_gou2, itemGoTable.isGet2 == true)
    --_G.GameUtil.SetActiveByCondition(itemGoTable.obj_suo2, itemGoTable.isGet2 == false and isGet2 == false)
    local chapter = 0
    if data.conditions[1] == _G.GlobalConditionManager.ConditionType.afk then
        chapter = require("AfkModel"):GetInstance():GetSectionChapter(data.conditions[2])
    else
        if _G.AppSetting.DEBUG then
            _G.LogError(" 配置的 任务目标 不是 放置 需修改显示")
        end
    end

    local str = _G.LangUtil.GetLangPackValue(self.UiDic.chapter, tostring(chapter))
    itemGoTable.aortext_chapter.text = str

    ---true可领取豪华奖励 显示可领取标志 不显示领取章节
    local isShowGetTips = (itemGoTable.ispass and itemGoTable.isGet2 == false)
    if itemGoTable.slider_Progress then
        itemGoTable.slider_Progress:SetActiveE(index == 0 and 0 or 1)
        if index > 0 then
            local lastChapter = require("AfkModel"):GetInstance():GetSectionChapter(
                self.countCfgArr[index].conditions[2]
            )
            local curChapter = require "AfkModel":GetInstance():GetCurSectionCfg().chapter - 1
            local totalValue = chapter - lastChapter
            local curValue = curChapter - lastChapter
            itemGoTable.slider_Progress.value = isShowGetTips and 1 or curValue / totalValue
        end
    end

    return objGame
end

---@param isUp boolean true是豪华奖励
function GrowthFundView:itemCall(itemLua, storageType, itemGoTable, isUp)
    if storageType == _G.StorageType.Material or storageType == _G.StorageType.ResProp then
        ---@type ItemViewBase
        local lua = itemLua
        lua:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)

        local isShowEffect = false
        if itemGoTable.ispass then
            if isUp then
                if self.isUp and itemGoTable.isGet2 == false then
                    isShowEffect = true
                end
            else
                if itemGoTable.isGet1 == false then
                    isShowEffect = true
                end
            end
        end
        lua:ShowEffect(isShowEffect)
    end
end

function GrowthFundView:GetAward()
    -- if not self.canGet then
    --     _G.PopWindowManager:GetInstance():ShowAllTips(25)
    --     return
    -- else
    local sid = self.id
    local aidList = require("GrowthFundModel"):GetInstance():GetAwardList(self.countCfgArr)
    if #aidList > 0 then
        require("FundModel"):GetInstance():GetAward(
            sid,
            2,
            aidList,
            function()
                if self:IsNil() then
                    return
                end
                self:UpdataView()

                --更新父页面红点状态
                ---@type FundMainView
                local parentView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.FundMainView.Name)
                if parentView then
                    parentView:UpdateRedpointView()
                end
            end
        )
    end
    -- end
end

function GrowthFundView:ShowBuyTips(itemlua, btnObj, isOn, itemGoTable)
    if itemGoTable == nil or itemGoTable.ispass and itemGoTable.isGet2 == false and self.isUp == false then
        self.Lua_buyTips:Show()
    else
        require "CommonTipManager":GetInstance():OpenTip(itemlua.gameObject, itemlua.sid)
    end
end

function GrowthFundView:BuyUp()
    local id = self.id
    require("FundModel"):GetInstance():BuyUp(
        id
    -- ,
    -- function()
    --     require("GrowthFundModel"):GetInstance():SetIsUp(id)
    --     self:UpdataView()
    -- end
    )
end

function GrowthFundView:OnMallCashListener(data)
    local cfg = _G.ConfigManager.store_battle_pass_cfg[data.sid]
    if cfg and cfg.display_priority == 1 then
        require("GrowthFundModel"):GetInstance():SetIsUp(data.sid)
        require "SDKDotManager":GetInstance():OnEvent(_G.SDKDotType.SDKDot_Fund, self.cfg.price_id)

        --LoginFundModel和GrowthFundModel会检测对方的红点, 因此需要同时刷新
        require("LoginFundModel"):GetInstance():RedCheck()
        --require("GrowthFundModel"):GetInstance():RedCheck()

        self:UpdataView()

        --更新父页面红点状态
        ---@type FundMainView
        local parentView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.FundMainView.Name)
        if parentView then
            parentView:UpdateRedpointView()
        end
    end
end

function GrowthFundView:OnDestroy()
    if self.Co then
        _G.coroutine.stopwaiting(self.Co)
        self.Co = nil
    end
    if self.effTimer then
        self.effTimer:Stop()
        self.effTimer = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

function GrowthFundView:Hide()
    self.go_table.gameObject:SetActiveE(0)
end

function GrowthFundView:Show()
    self.go_table.gameObject:SetActiveE(1)
end

function GrowthFundView:CloseView()
    self:Close()
end

---按钮点击事件在这里派发
function GrowthFundView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

function GrowthFundView:CloseView()
    self:Close()
end

return GrowthFundView
