local base = require "ActivitySynTypeBase"
---@class GrowthFundSynModel : ActivitySynTypeBase	中文描述
local GrowthFundSynModel = _G.BaseClass("GrowthFundSynModel", base)
-- _G.GrowthFundSynModel = GrowthFundSynModel

-- local CS = _G.CS
-- local typeof = _G.typeof

---创建对象时,入口构造函数
function GrowthFundSynModel:__init()
    self.GrowthFundModel = require "GrowthFundModel":GetInstance()
    self.GrowthFundModel:SetFreshRedPoint(_G.handler(self, self.RefreshRedPoint))
    self.fundModel = require("FundModel")
    self.fundModel:GetInstance():AddFundAcivitySynType(self.fundModel.FundTypeValue.Growth, self)
end

--- 网络请求初始化
function GrowthFundSynModel:GetDataFormServer()
    self.GrowthFundModel:GetInfo(_G.handler(self, self.ParseData))
end

---数据解析完成
function GrowthFundSynModel:ParseData()
    base.ParseData(self)
end

function GrowthFundSynModel:InitFunction()
    self.GrowthFundModel:InitFunction()
end

---进入活动主体
function GrowthFundSynModel:OnEnterActivity()
    -- ZHJH-2064 成长基金和降临基金合并
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FundMainView.Name,self.GrowthFundModel.fundType)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function GrowthFundSynModel:OnGetMainViewName()
    -- ZHJH-2064 成长基金和降临基金合并
    return _G.ConfigManager.ui_cfg.FundMainView.Name
end

---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function GrowthFundSynModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end

function GrowthFundSynModel:GetRedPoint()
    return require("GrowthFundModel"):GetInstance():IsHaveGet() and 1 or 0
end

function GrowthFundSynModel:CheckRedPoint()
    local _type = require("FundModel"):GetInstance().FundTypeValue.Growth
    return require("FundModel"):GetInstance():GetFundAcivityRedPoint(_type)
end

---刷新奖励红点
function GrowthFundSynModel:RefreshRedPoint()
    local activity = self.fundModel:GetInstance():GetFundAcivitySynModel(self.fundModel.FundTypeValue.Login)
    require("RedPointManager"):GetInstance():RefreshNode(activity:GetRedpointIDByIndex(1))
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function GrowthFundSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

--endregion

--endregion
---销毁对象时,析构函数
function GrowthFundSynModel:Dispose()
end

function GrowthFundSynModel:ReConnect(endcall)
    self.GrowthFundModel:ReConnect(endcall)
end

return GrowthFundSynModel
