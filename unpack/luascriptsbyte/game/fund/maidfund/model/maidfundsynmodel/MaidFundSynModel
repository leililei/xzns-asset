local base = require "ActivitySynTypeBase"
---@class MaidFundSynModel : ActivitySynTypeBase	中文描述
local MaidFundSynModel = _G.BaseClass("MaidFundSynModel", base)

---创建对象时,入口构造函数
function MaidFundSynModel:__init()
    self.MaidFundModel = require "MaidFundModel":GetInstance()
    self.MaidFundModel:SetFreshRedPoint(_G.handler(self, self.RefreshRedPoint))
    local model = require("FundModel")
    model:GetInstance():AddFundAcivitySynType(model.FundTypeValue.Maid, self)
end

--- 网络请求初始化
function MaidFundSynModel:GetDataFormServer()
    self.MaidFundModel:GetInfo(_G.handler(self, self.ParseData))
end

---数据解析完成
function MaidFundSynModel:ParseData()
    base.ParseData(self)
end

function MaidFundSynModel:InitFunction()
    self.MaidFundModel:InitFunction()
end

---进入活动主体
function MaidFundSynModel:OnEnterActivity()
    -- ZHJH-2064 成长基金和降临基金合并
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FundMainView.Name,self.MaidFundModel.fundType)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function MaidFundSynModel:OnGetMainViewName()
    -- ZHJH-2064 成长基金和降临基金合并
    return _G.ConfigManager.ui_cfg.FundMainView.Name
end

---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function MaidFundSynModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end

function MaidFundSynModel:GetRedPoint()
    return require("MaidFundModel"):GetInstance():IsHaveGet() and 1 or 0
end

function MaidFundSynModel:CheckRedPoint()
    local _type = require("FundModel"):GetInstance().FundTypeValue.Maid
    return require("FundModel"):GetInstance():GetFundAcivityRedPoint(_type)
end

---刷新奖励红点
function MaidFundSynModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function MaidFundSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

function MaidFundSynModel:IsShowInFuliView()
    return false
end

--endregion

--endregion
---销毁对象时,析构函数
function MaidFundSynModel:Dispose()
end

function MaidFundSynModel:ReConnect(endcall)
    self.MaidFundModel:ReConnect(endcall)
end

return MaidFundSynModel
