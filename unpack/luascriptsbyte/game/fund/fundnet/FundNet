local base = require("BaseGameNet")

---@class FundNet : BaseGameNet	通信协议
local FundNet = _G.BaseClass("FundNet", base)

---@return FundNet FundNet
function FundNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function FundNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

--获取基金的信息
---@param callback function 完成回调
function FundNet:GetInfo(pbData, callback)
    self:Access(_G.ConfigManager.net_map.game_store_battle_info, pbData, callback)
end

--获取已完成的信息
---@param callback function 完成回调
function FundNet:GetInfoPass(callback)
    self:Access(_G.ConfigManager.net_map.game_store_battle_finish, self:GetEmptyPB(), callback)
end
--开启下一轮
function FundNet:OpenNextBattle(pbData, callback)
    self:Access(_G.ConfigManager.net_map.game_store_battle_next_battle, pbData, callback)
end
---领取奖励
---@param pbData table PB数据
---@param callback function 完成回调
function FundNet:GetAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_store_battle_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function FundNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type FundNet
-- _G.FundNet = FundNet
return FundNet
