local base = require "ActivitySynTypeBase"
---@class RemainsFundSynModel : ActivitySynTypeBase	中文描述
local RemainsFundSynModel = _G.BaseClass("RemainsFundSynModel", base)

---创建对象时,入口构造函数
function RemainsFundSynModel:__init()
    self.RemainsFundModel = require "RemainsFundModel":GetInstance()
    self.RemainsFundModel:SetFreshRedPoint(_G.handler(self, self.RefreshRedPoint))
    local model = require("FundModel")
    model:GetInstance():AddFundAcivitySynType(model.FundTypeValue.Remains, self)
end

--- 网络请求初始化
function RemainsFundSynModel:GetDataFormServer()
    self.RemainsFundModel:GetInfo(_G.handler(self, self.ParseData))
end

---数据解析完成
function RemainsFundSynModel:ParseData()
    base.ParseData(self)
end

function RemainsFundSynModel:InitFunction()
    self.RemainsFundModel:InitFunction()
end

---进入活动主体
function RemainsFundSynModel:OnEnterActivity()
    -- ZHJH-2064 成长基金和降临基金合并
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FundMainView.Name,self.RemainsFundModel.fundType)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function RemainsFundSynModel:OnGetMainViewName()
    -- ZHJH-2064 成长基金和降临基金合并
    return _G.ConfigManager.ui_cfg.FundMainView.Name
end

---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function RemainsFundSynModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end

function RemainsFundSynModel:GetRedPoint()
    return require("RemainsFundModel"):GetInstance():IsHaveGet() and 1 or 0
end

function RemainsFundSynModel:CheckRedPoint()
    local _type = require("FundModel"):GetInstance().FundTypeValue.Remains
    return require("FundModel"):GetInstance():GetFundAcivityRedPoint(_type)
end

---刷新奖励红点
function RemainsFundSynModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function RemainsFundSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

--endregion

--endregion
---销毁对象时,析构函数
function RemainsFundSynModel:Dispose()
end

function RemainsFundSynModel:ReConnect(endcall)
    self.RemainsFundModel:ReConnect(endcall)
end

return RemainsFundSynModel
