function RemainsFundModel:InitDateStart()
    ---@type store_battle_pass_cfg
    local cfg = _G.ConfigManager.store_battle_pass_cfg[self.sid]
    if cfg == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(" store_battle_pass_cfg 未找到配置 id:" .. tostring(self.sid))
        end
    end
    self.curFunctionOpenID = cfg.function_open

    ---@type FundModel_storeinfo
    self.store = {
        ---基金的id
        sid = self.sid,
        ---是否是豪华 （0:不是 1：是）
        unlock_rmb = 0,
        ---已经领取的普通奖励id
        normal_award_list = {},
        ---已经领取的豪华奖励id
        up_award_list = {}
    }
end
function RemainsFundModel:InitStoreData(data)
    if self.store.sid ~= data.store.sid then
        if _G.AppSetting.DEBUG then
            _G.LogError("基金id 不一致")
        end
    end
    self.store.sid = data.store.sid
    self.store.unlock_rmb = data.store.unlock_rmb
    if data.store.normal_award_list ~= nil then
        for i = 1, #data.store.normal_award_list do
            self:SetAward(data.store.normal_award_list[i], false)
        end
    end

    if data.store.up_award_list ~= nil then
        for i = 1, #data.store.up_award_list do
            self:SetAward(data.store.up_award_list[i], true)
        end
    end
end
--region 重写父类方法
--- 网络请求初始化
function RemainsFundModel:GetInfo(callback)
    -- local data = {}
    require "FundModel":GetInstance():GetInfoPass(
        function(data)
            local pass_list = {}
            if data and data.pass then
                local cfg = _G.ConfigManager.store_battle_pass_cfg
                for i = 1, #data.pass do
                    local id = data.pass[i]
                    if cfg[id].display_priority == 5 then
                        _G.table.insert(pass_list, cfg[id])
                    end
                end
            end
            if not _G.table.isEmptyOrNil(pass_list) then
                _G.SortList(
                    pass_list,
                    function(list)
                        return list.id
                    end
                )
                if pass_list[1].re_sid > 0 then
                    self.sid = pass_list[1].re_sid
                else
                    self.sid = pass_list[1].id
                end
            end
            require("FundModel"):GetInstance():GetInfo(
                self.sid,
                function(data)
                    self:ParseData(data, callback)
                    self:CheckNext()
                end
            )
        end
    )
end
function RemainsFundModel:ReConnect(endcall)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.curFunctionOpenID) then
        if endcall then
            endcall()
        end
        return
    end
    require("FundModel"):GetInstance():GetInfo(
        self.sid,
        function(data)
            self:InitDateStart()
            self:InitStoreData(data)
            self:RedCheck()
            -- local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.LoginFundView.Name)
            -- if window then
            --     window.View:UpdataView()
            -- end
        end
    )
    if endcall then
        endcall()
    end
end
---数据解析完成
function RemainsFundModel:ParseData(data, callback)
    self:InitDateStart()
    if data.store then
        self:InitStoreData(data)
    end
    if callback then
        callback()
    end
end
---初始化功能逻辑
function RemainsFundModel:InitFunction()
    self:RedCheck()
    self:AddListener()
end

