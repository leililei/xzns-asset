--region --------------------------------------红点 奖励解锁--------
function RemainsFundModel:RedCheck()
    if  not self.store then
        return
    end
    ---@type store_battle_pass_cfg
    local cfg = _G.ConfigManager.store_battle_pass_cfg[self.sid]

    ---True有可领取
    self.isHaveGet = false
    ---可领取 索引 方便显示跳转  [0,]
    self.HaveGetIndex = nil

    local store_battle_content_cfg = _G.ConfigManager.store_battle_content_cfg

    ---@type store_battle_content_cfg
    local cfgitem
    local cType, cValue, id, cValue1
    local oIndex = 0
    local seType = true
    for i = 1, #cfg.content do
        ---奖励内容id
        id = cfg.content[i]
        cfgitem = store_battle_content_cfg[id]
        ---条件类型
        cType = cfgitem.conditions[1]
        ---条件参数
        cValue = cfgitem.conditions[2]
        cValue1 = cfgitem.conditions[3]
        if cType == _G.GlobalConditionManager.ConditionType.RemainsGradeNum then
            ----如果没解锁 就标记
            if _G.GlobalConditionManager.CheckCondition(cType, cValue, cValue1) == false then
                if seType then
                    seType = false
                    oIndex = i
                end
            else
                ---如果解锁了 就记录是否已领取
                if self.isHaveGet == false then
                    ---如果 有一个奖励没领 就标记
                    if not self:IsAward(id, false) then
                        self.isHaveGet = true
                        self.HaveGetIndex = i
                    elseif self:GetIsUp() and not self:IsAward(id, true) then
                        self.isHaveGet = true
                        self.HaveGetIndex = i
                    end
                end
            end
        else
            if _G.AppSetting.DEBUG then
                _G.Log("", "<color=red>" .. "不是设定的 通用检测类型" .. "</color>")
            end
            break
        end
    end
    if self.HaveGetIndex == nil then
        self.HaveGetIndex = oIndex > 1 and oIndex - 1 or 1
    end
    self:RefreshRedPoint()
end
---设置红点刷新
function RemainsFundModel:SetFreshRedPoint(RefreshRedPointCall)
    self.RefreshRedPointCall = RefreshRedPointCall
end
function RemainsFundModel:RefreshRedPoint()
    if self.RefreshRedPointCall ~= nil then
        self.RefreshRedPointCall()
    end
end
function RemainsFundModel:IsHaveGet()
    return self.isHaveGet == true
end

function RemainsFundModel:GetHaveGetIndex()
    --- or nil
    return self.HaveGetIndex
end

function RemainsFundModel:AddListener()
    _G.Events:GetInstance():AddListener(_G.eRemainsUpdate.RemainsUpdate, self.OnRemainsUpdate, self)
    _G.Events:GetInstance():AddListener(_G.eRemainsUpdate.RemainsInit, self.OnRemainsUpdate, self)
end

---监听玩家操作
function RemainsFundModel:OnRemainsUpdate()
    self:RedCheck()
end

function RemainsFundModel:RemoveListener()
    _G.Events:GetInstance():RemoveListener(_G.eRemainsUpdate.RemainsUpdate, self.OnRemainsUpdate, self)
    _G.Events:GetInstance():RemoveListener(_G.eRemainsUpdate.RemainsInit, self.OnRemainsUpdate, self)
end

--endregion------------------------------------红点 奖励解锁--------

---@return boolean true已购买豪华
function RemainsFundModel:GetIsUp()
    return self.store.unlock_rmb == 1
end

function RemainsFundModel:SetIsUp()
    self.store.unlock_rmb = 1
    self:RedCheck()
end

---是否领取奖励
function RemainsFundModel:IsAward(id, isUp)
    if isUp then
        return self.store.up_award_list[id] == true
    else
        return self.store.normal_award_list[id] == true
    end
end

---设置已领取
function RemainsFundModel:SetAward(id, isUp)
    if not id then
        if _G.AppSetting.DEBUG then
            _G.LogError("RemainsFundModel:SetAward id无效:" .. tostring(id))
        end
        return
    end
    if isUp then
        self.store.up_award_list[id] = true
    else
        self.store.normal_award_list[id] = true
    end
end

---设置一键领取奖励状态为已领取
function RemainsFundModel:SetOneKeyAward(id)
    if self:GetIsUp() and not self.store.up_award_list[id] then
        self.store.up_award_list[id] = true
    end

    if not self.store.normal_award_list[id] then
        self.store.normal_award_list[id] = true
    end
end

function RemainsFundModel:CheckUpArawd(id)
    if self:GetIsUp() and not self.store.up_award_list[id] then
       return true
    end

    return false
end

---获取未领取的奖励id列表
---@param countCfgArr store_battle_content_cfg 配置
---@return aidList 奖励id列表
function RemainsFundModel:GetAwardList(countCfgArr)
    local aidList = {}
    for _, v in ipairs(countCfgArr) do
        local isPass = _G.GlobalConditionManager.CheckCondition(v.conditions[1],v.conditions[2],v.conditions[3])
        if isPass and (not self:IsAward(v.id) or self:CheckUpArawd(v.id)) then
            _G.table.insert(aidList, v.id)
        end
    end
    return aidList
end

---@return boolean true奖励已全部领完
function RemainsFundModel:CheckIsOvers()
    local cfg = _G.ConfigManager.store_battle_pass_cfg[self.sid]
    local count = #cfg.content
    local c1 = table.count(self.store.normal_award_list)
    local c2 = table.count(self.store.up_award_list)
    return count == c1 and count == c2
end

function RemainsFundModel:CheckIsShow()
    return self:CheckIsOvers() == false
end
---是否开启下一轮
function RemainsFundModel:CheckNext(call)
    if self:CheckIsOvers() then
        local cfg = _G.ConfigManager.store_battle_pass_cfg[self.sid]
        if cfg.re_sid > 0 then
            require "FundModel":GetInstance():OpenNextBattle(
                self.sid,
                function()
                    self.sid = cfg.re_sid
                    require("FundModel"):GetInstance():GetInfo(
                        self.sid,
                        function(data)
                            self:InitDateStart()
                            self:InitStoreData(data)
                            self:RedCheck()
                            local window =
                                _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.FundMainView.Name)
                            if window then
                                window.View.FundView[require("FundModel").FundType.Login]:UpdataView()
                            end
                            if call then
                                call()
                            end
                        end
                    )
                end
            )
        else
            if call then
                call()
            end
        end
    else
        if call then
            call()
        end
    end
end

function RemainsFundModel:InitSidStage()
    self.sidStage = {}
    self.sbpCfgs = {}
    for _, cfg in pairs(_G.ConfigManager.store_battle_pass_cfg) do
        if cfg.display_priority == 5 then
            _G.table.insert(self.sbpCfgs, cfg)
        end
    end
    _G.table.sort(self.sbpCfgs,
        function(a, b)
            return a.id < b.id
        end
    )
    local stage = 1
    for _, cfg in pairs(self.sbpCfgs) do
        self.sidStage[cfg.id] = stage
        stage = stage + 1
    end
end

---获取当前是第几阶段
function RemainsFundModel:GetCurStage()
    if self.sidStage == nil then
        self:InitSidStage()
    end
    return self.sidStage[self.sid]
end

---销毁对象时,析构函数
function RemainsFundModel:Dispose()
end

return RemainsFundModel
