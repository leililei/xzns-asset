local JournalismItem = require "JournalismItem"
local JournalismModel = require "JournalismModel"
---@class JournalismView : UIBaseView	中文描述
---@field public go_table JournalismView_GoTable GoTable
---@field news JournalismView._toggle_news_GoTable GoTable
---@field my JournalismView._toggle_my_GoTable GoTable
---@field items JournalismItem[] 所有新闻物体
---@field datas table<number,JournalismItemData[]> 所有新闻数据
---@field curDatas JournalismItemData[] 当前新闻数据
local JournalismView = _G.BaseClass("JournalismView", _G.UIBaseView)
local LangUtil = _G.LangUtil
local JournalismType = _G.JournalismType
function JournalismView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function JournalismView:OnCreate()
    self.items = {}
    JournalismItem = require "JournalismItem"
    JournalismModel = require "JournalismModel"
    self.go_table.scrollloopvectical_ItemList:InitItemData(0, _G.handler(self, self.RefreshItem))
    self.gameObject:SetActiveE(0)
    self:AddListener(_G.eJournalism.Refresh, self.UpdateView)
    self:AddListener(_G.eJournalism.RefreshLike, self.RefreLike)
    self:InitEffect()
    JournalismModel:GetInstance():GetInfo()
    JournalismModel:GetInstance():ChangeIsFirst()
    JournalismModel:GetInstance().DengLuHongDian = false
end

function JournalismView:InitEffect()
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_News_titile,self.go_table.obj_effect)
end

---更新界面
function JournalismView:UpdateView()
    self.gameObject:SetActiveE(1)
    self.datas = JournalismModel:GetInstance():GetJournalismDatas()
    self:SortDatas()
    self:UpdateLikeNum()
    if not self.type or self.type == JournalismType.All then
        self:OnNews(true, true)
        self.go_table.toggle_news.isOn = true
    else
        self:OnNews(true, true)
        self.go_table.toggle_my.isOn = true
    end

    self.go_table.aortext_content.text =
        LangUtil.GetLangPackValue(
        90027000003,
        _G.PlayerModel:GetInstance():GetName(),
        _G.TimeUtil.GetInterValDayByGame(_G.PlayerModel:GetInstance().create_time, _G.TimeUtil.GetServerUnixTime()) + 1
    )
end

---排序
function JournalismView:SortDatas()
    for _, v in pairs(self.datas) do
        ---@param data JournalismItemData
        --_G.SortList(
        --    v,
        --    function(data)
        --        return -data.cfg.order, data.sortVal, data.data.time
        --    end
        --)
        _G.table.sort(
                v,
                function(a, b)
                    if (a.cfg.order ~= b.cfg.order) then
                        return a.cfg.order < b.cfg.order
                    end
                    if (a.cfg.id ~= b.cfg.id) then
                        return a.data.time < b.data.time
                    else
                        if a.sortVal == b.sortVal then
                            return a.data.time < b.data.time
                        end
                        return a.sortVal > b.sortVal
                    end
                    return false
                end
        )
    end
end

---更新点赞数
function JournalismView:UpdateLikeNum()
    self.go_table.aortext_num.text = LangUtil.GetLangPackValue(90027000004, JournalismModel:GetInstance():GetlikeNum())
end

---刷新点赞
function JournalismView:RefreLike()
    self:UpdateLikeNum()
    for _, v in pairs(self.items) do
        v:UpdateLikeNum()
        v:ChangeLike()
    end
end

---刷新物体显示
---@param obj UnityEngine.GameObject 物体
---@param index number 下标
function JournalismView:RefreshItem(index, obj)
    local id = obj:GetInstanceIDE()
    local item = self.items[id]
    if not item then
        item = self:AddComponent(obj, JournalismItem.New())
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_News_BgShow,item.gameObject)
        self.items[id] = item
    end
    item:Show(self.curDatas[index + 1])
end

---切换新闻
function JournalismView:OnNews(isOn, isForce)
    if not self.news then
        self.news = _G.GetAutoGoTable(self.go_table.toggle_news)
    end
    self.news.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    if not isOn or (self.type == JournalismType.All and not isForce) then
        return
    end
    self:SetType(JournalismType.All)
end

---设置当前显示类型
---@param type JournalismType 类型
function JournalismView:SetType(type)
    self.type = type
    self.curDatas = self.datas[self.type]
    local count = #self.curDatas
    self.go_table.scrollloopvectical_ItemList:UpdateCount(count)
    self.go_table.obj_Nil:SetActiveE(count == 0 and 1 or 0)
end

---切换我的
function JournalismView:OnMy(isOn, isForce)
    if not self.my then
        self.my = _G.GetAutoGoTable(self.go_table.toggle_my)
    end

    self.my.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    if not isOn or (self.type == JournalismType.My and not isForce) then
        return
    end
    self:SetType(JournalismType.My)
end

---按钮点击事件在这里派发
function JournalismView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.toggle_my then
        self:OnMy(isOn)
    elseif go == self.go_table.toggle_news then
        self:OnNews(isOn)
    end
end

return JournalismView
