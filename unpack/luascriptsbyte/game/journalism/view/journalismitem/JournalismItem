---@class JournalismItem : Component	中文描述
---@field go_table JournalismView._obj_item_GoTable
---@field data JournalismItemData 新闻数据
local JournalismItem = _G.BaseClass("JournalismItem", _G.Component)
local NotType = _G.JournalismType.My
local CommonTipManager = require "CommonTipManager"
local LangUtil = _G.LangUtil
local UIUtils = _G.UIUtils
function JournalismItem:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建对象时,入口构造函数
function JournalismItem:OnCreate()
end

---@param data JournalismItemData
function JournalismItem:Show(data)
    self.data = data
    if self.data.data.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
        self.go_table.aortext_name.text = _G.PlayerModel:GetInstance():GetName()
    else
        self.go_table.aortext_name.text = self.data.data.role_name
    end
    UIUtils.SetPlayerHeadItemNew(self.go_table.obj_HeadItemBase,self.data.data,0.75,true,false,false)
    self.go_table.obj_zan:SetActiveE(self.data.type == NotType and 0 or 1)
    self.go_table.aortext_content.text = self.data:GetDesc()
    self.go_table.aortext_time.text = self:GetSendTime(self.data.data.time)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_specialBg, self.data.cfg.number > 0)
    self:ChangeLike()
    self:UpdateLikeNum()
end

---获取发送时间距离现在的时间
---@param time number 结束时间
function JournalismItem:GetSendTime(time)
    local offetTime = _G.TimeUtil.GetServerUnixTime() - time
    offetTime = offetTime / 60
    if offetTime <= 10 then
        return LangUtil.GetLangPackValue(90027000005)
    end
    if offetTime > 10 and offetTime < 60 then
        return _G.string.format(
            LangUtil.GetLangPackValue(90022100083),
            (_G.math.floor(offetTime) - _G.math.floor(offetTime) % 10)
        )
    end
    offetTime = offetTime / 60
    if offetTime > 0 and offetTime < 24 then
        return _G.string.format(LangUtil.GetLangPackValue(90021800065), _G.math.floor(offetTime))
    end
    offetTime = offetTime / 24
    return _G.string.format(LangUtil.GetLangPackValue(90021800066), _G.math.floor(offetTime))
end
---更新点赞数
function JournalismItem:UpdateLikeNum()
    if self.data.point and self.data.point > 999 then
        self.go_table.aortext_num.text = "999+"
    else
        self.go_table.aortext_num.text = self.data.point
    end
end

function JournalismItem:ChangeLike()
    local isLike = self.data:CheckIsLike()
    self.go_table.aorbtn_zan:SetActiveE(isLike and 0 or 1)
    self.go_table.aorbtn_zan2:SetActiveE(isLike and 1 or 0)

    if require "JournalismModel":GetInstance():GetlikeNum() > 0 then
        self.go_table.obj_redpoint:SetActiveE(1)
    else
        self.go_table.obj_redpoint:SetActiveE(0)
    end
end

---销毁对象时,析构函数
function JournalismItem:OnDestroy()
end

function JournalismItem:OnClickBtn(go, _)
    if go == self.go_table.aorbtn_zan then
        require "JournalismModel":GetInstance():Like(
            self.data.data.uid,
            self.data.data.index,
            function(data)
                CommonTipManager.ShowSecretFloatTips(data)
                self:ChangeLike()
                self:UpdateLikeNum()
            end
        )
    end
end

return JournalismItem
