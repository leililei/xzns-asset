local base = require "BaseGameNet"
---@class JournalismNet : BaseGameNet	通信协议
local JournalismNet = _G.BaseClass("JournalismNet", base)

---@return JournalismNet JournalismNet
function JournalismNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求
---@param callback function 完成回调
function JournalismNet:GetInfo(callback)
    local item = _G.ConfigManager.net_map.game_mission_news_get_news
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end
---点赞
---@param pbData mission_news.c2s_news_point PB数据
---@param callback function 完成回调
function JournalismNet:Like(pbData, callback)
    local item = _G.ConfigManager.net_map.game_mission_news_news_point
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function JournalismNet:Callback(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type JournalismNet
_G.JournalismNet = JournalismNet
return JournalismNet
