---@class JournalismItemData 新闻数据
---@field cfg mission_new_cfg 新闻配置
---@field type JournalismType 个人|全部
---@field data  mission_news.i_mission_news
---@field point number 点赞数
---@field sortVal number 同类型下排序依据
local JournalismItemData = _G.BaseClass("JournalismItemData")
local LangUtil = _G.LangUtil
local tonumber = _G.tonumber
---类的构造函数
function JournalismItemData:__init(data, type)
    self:Parse(data, type)
end
---解析数据
---@param data mission_news.i_news_point
function JournalismItemData:Parse(data, type)
    self.data = data
    self.cfg = _G.ConfigManager.mission_new_cfg[data.type]
    self.type = type
    self.point = self.data.point
    self.isSelf = self.data.uid == _G.PlayerModel:GetInstance():GetPlayerUid()
    self.sortVal= self:GetSortVal()
end

---获取新闻描述
function JournalismItemData:GetDesc()
    if not self.sec then
        local prams = self.data.prams
        if self.data.type == 2 or self.data.type == 3 or self.data.type == 4 or self.data.type == 5 then
            _G.table.insert(prams, 1, self.data.role_name)
        end
        if self.data.type == 7 then
            prams[1] = LangUtil.GetLangPackValue(_G.ConfigManager.card_cfg[tonumber(self.data.prams[1])].Name)
            local color, star = require "CardInfoManager":GetInstance():GetCardColorName(tonumber(self.data.prams[2]))
            if star > 0 then
                prams[2] =
                    LangUtil.GetLangPackValue(90000010474, LangUtil.GetLangPackValue(color)) ..
                    LangUtil.GetLangPackValue(90000010475, star)
            else
                prams[2] = LangUtil.GetLangPackValue(90000010474, LangUtil.GetLangPackValue(color))
            end
        elseif self.data.type == 4 then
            prams[2] = LangUtil.GetLangPackValue(_G.ConfigManager.arena_senior_cfg[tonumber(self.data.prams[2])].name)
        elseif self.data.type == 5 then
            local index = tonumber(prams[2])
            if index == 1 then
                prams[2] = LangUtil.GetLangPackValue(90026100002)
            elseif index == 2 then
                prams[2] = LangUtil.GetLangPackValue(90026100003)
            elseif index == 3 then
                prams[2] = LangUtil.GetLangPackValue(90026100004)
            end
        elseif self.data.type == 6 then
            prams[1] = self.data.role_name
        end
        self.sec = LangUtil.GetLangPackValue(self.cfg.desc, _G.SafeUnpack(prams))
    end
    return self.sec
end

---获取排序依据
---@private
function JournalismItemData:GetSortVal()
    local type = self.data.type
    local params = self.data.prams
    if type == 1 then
        ---放置通关章节
        return tonumber(params[2])
    elseif type == 2 then
        ---死魂塔层数
        return tonumber(params[1])
    elseif type == 3 then
        ---竞技场排名
        return - tonumber(params[2])
    elseif type == 4 then
        ---高阶竞技场段位sid
        return - tonumber(params[1])
    elseif type == 5 then
        ---公平竞技场排名
        return - tonumber(params[1])
    elseif type == 6 then
        ---魂将对决排名
        return - tonumber(params[1])
    elseif type == 7 then
        ---升星星级
        return tonumber(params[2])
    elseif type == 8 then
        ---星河罗盘等级
        return tonumber(params[1])
    else
        return 0
    end
end

---获取头像
function JournalismItemData:GetPortraitIcon()
    local id = self.data.style
    if self.isSelf then
        id = _G.PlayerModel:GetInstance():GetRoleStyle()
    end
    return _G.ConfigManager.player_portrait_cfg[id].portrait1
end

---获取头像框
function JournalismItemData:GetFrame()
    local id = self.data.frame
    if self.isSelf then
        id = _G.PlayerModel:GetInstance():GetCurFrame()
    end
    return _G.ConfigManager.player_frame_cfg[id].frame
end

---增加点赞数
function JournalismItemData:AddPoint()
    self.point = self.point + 1
end

---检测是否被赞
function JournalismItemData:CheckIsLike()
    return require "JournalismModel":GetInstance():CheckIsLike(self.data.index)
end

---类的析构函数
function JournalismItemData:Dispose()
end

return JournalismItemData
