local ActivitySynManager = require "ActivitySynManager"

---@class SignInView : UIBaseView	中文描述
local SignInView = _G.BaseClass("SignInView", _G.UIBaseView)
local SignInModel = require "SignInModel":GetInstance()
local YiLingQu = require("CardInfoManager").GetColorFromRGB("543b0a")
local KeLingQu = require("CardInfoManager").GetColorFromRGB("ecc398")
local WeiDaCheng = require("CardInfoManager").GetColorFromRGB("a06530")
local CardInfoManager =  require("CardInfoManager")
local bgdic={
    [1]="ImagesH5/hSignIn/ui_xsqd_bg_renlei",
    [2]="ImagesH5/hSignIn/ui_xsqd_bg_shouren",
    [3]="ImagesH5/hSignIn/ui_xsqd_bg_jinling",
    [4]="ImagesH5/hSignIn/ui_xsqd_bg_wangling"
}
function SignInView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    if _G.AppSetting.IsXzns then
        YiLingQu = _G.ColorTools.FormatColorByString("47475F")
        KeLingQu = _G.ColorTools.FormatColorByString("FFFFFF")
        WeiDaCheng = _G.ColorTools.FormatColorByString("FFFFFF")
        _G.GameUtil.SetUiHeXieMask(self.go_table)
    end
    self.itemCard = {}
    self.itemCards = {}
    self.timer = nil
    self:ShuaXing()
end
function SignInView:OnCreate(activity)
    self.activity = activity
    self.typeCls = activity.typeClass
    self:XianShiTiem()
    self:LoadEff()
end

function SignInView:LoadEff()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_signinview_2,
        self.go_table.obj_eff,
        function (obj)
            if self:IsNil() then
                _G.UIUtils.RemoveEffect(obj)
                return
            end
        end
    )
end

---显示时间更新
function SignInView:XianShiTiem()
    --local KaiFu = self.activity.UICountDown.start_time
    --local ZuiDa = self.activity.UICountDown.run_time
    local t
    t, self.time = self.activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Settlement)
    self.go_table.aortext_HuoDongtime.text = _G.GetLangPackValue(90022600050, _G.TimeUtil.TransLateSMCH(self.time))
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()
    --local QD = _G.TimeUtil.GetInterValDayByGame(KaiFu + ZuiDa, _G.TimeUtil:GetServerUnixTime())
end

function SignInView:ShuaXing()
    ---获取当前登录天数
    self.DQKeXuanZho = SignInModel.login_days
    self.seven = SignInModel:HuoQu(7)
    for i = 1, 4 do
        local var = self.go_table["obj_F" .. i]
        self:KaPaiZhanShi(i, var)
    end

    for i = 1, 7 do
        local var = self.go_table["obj_Item" .. i]
        self:KaPaiaward(i, var)
    end
    -- self:HunJiangZhaoLingNum()
end

function SignInView:KaPaiaward(index, listView2)
    if index < 0 then
        return
    end
    local x = index

    self.itemCard[x] = {}
    self.itemCard[x] = _G.GetAutoGoTable(listView2, _G.handlerbind(self, self.AddDianJiaward, x))

    local data = SignInModel:HuoQu(x).award[1].type

    self:tanQuanDian(data, self.itemCard[x].obj_Item)

    self:XianshiNew(x)
end

function SignInView:AddDianJiaward(_, _, X)
    self.typeCls:GetAward(
        X,
        function(msg)
            if msg.ack == 1 then
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                _G.table.insert(SignInModel.g_sids, X)
                self:XianshiNew(X)
                self.typeCls:RefreshRedPoint()

                if _G.table.count(SignInModel.g_sids) >= 7 then
                    self.activity:ChangeState(require "ActivitySynManager":GetInstance().State.Close)
                end
            end
        end
    )
end

function SignInView:XianshiNew(index)
    self.itemCard[index].obj_gou:SetActiveE(0)
    self.itemCard[index].aorimage_XianShi:SetActiveE(0)
    self.itemCard[index].aorbtn_Dianji:SetActiveE(0)
    self.itemCard[index].obj_eff:SetActiveE(0)
    self.itemCard[index].aortext_Tian.text = _G.LangUtil.GetLangPackValue(90023800006, index)
    if index <= self.DQKeXuanZho then
        if SignInModel:HuoQuTian(index) then
            self.itemCard[index].obj_gou:SetActiveE(1)
            self.itemCard[index].aortext_Tian.color = YiLingQu
            self.itemCard[index].obj_eff:SetActiveE(0)
        else
            SignInModel.titleHD = SignInModel.titleHD + 1
            self.itemCard[index].aortext_Tian.color = KeLingQu
            self.itemCard[index].obj_eff:SetActiveE(1)
            self.itemCard[index].aorimage_XianShi:SetActiveE(1)
            self.itemCard[index].aorbtn_Dianji:SetActiveE(1)
        end
    else
        self.itemCard[index].aortext_Tian.color = WeiDaCheng
    end
end
---物品内容选中显示
function SignInView:tanQuanDian(data, Parent)
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        data,
        Parent,
        function(item)
            item.gameObject:SetLocalScaleXYZ(0.85)
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)

            item.gameObject:SetLocalPosition(0, 0, 0)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            item:ShowEffect()
        end,
        function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data[1])
        end
    )
end
function SignInView:KaPaiZhanShi(index, listView2)
    if index < 0 then
        return
    end
    local x = index

    self.itemCards[x] = {}
    self.itemCards[x] = _G.GetAutoGoTable(listView2)--, _G.handlerbind(self, self.AddDianJiBtn, x))

    local data =
        _G.ConfigManager.card_cfg[
        _G.tonumber(_G.ConfigManager.item_cfg[self.seven.award[1].type[1]].UseParameter[index][1])
    ]
    local datNum = SignInModel.title[x]
    
    if data ~= nil then
        self.itemCards[x].aorimage_Icon.SpriteName = CardInfoManager.Enum.ElementsBox[data.Elements]
        self.itemCards[x].aorrawimage_juesei:LoadImage(
            data.Portrait,
            function(image)
                if image then
                    image:SetActiveE(1)
                    image:SetNativeSize()
                end
            end
        )
        self.itemCards[x].aorrawimage_zzbg:LoadImage(
                bgdic[data.Elements],function(image)
                    image:SetActiveE(1)
                    image:SetNativeSize()
                end
        )
        local pos_lists = require "SignInModel":GetInstance().pos
        local pos_x, pos_y = 0, 0, 0
        pos_x = pos_lists[x][1] or 1
        pos_y = pos_lists[x][2] or 1
        self.itemCards[x].aorrawimage_juesei:SetLocalPosition(pos_x, pos_y, 0)
        self.itemCards[x].aorimage_Icon.SpriteName=require("CardInfoManager"):GetInstance().Enum.ElementsIcon[data.Elements]
        self.itemCards[x].aortext_LeiXing.text = _G.ConfigManager.language_package_cfg[datNum]
        self.itemCards[x].aortext_Name.text = _G.ConfigManager.language_package_cfg[data.Name]
    end
end

function SignInView:AddDianJiBtn(index)
end

function SignInView:EscClose()
    self:CloseView()
end

function SignInView:OnClickBtn(go, isOn, viewName)
    local name = go:GetName()

    if name == "@_aorbtn_close" or name == "@_aorbtn_closeView" then
        self:CloseView()
    elseif name == "@_aorbtn_help" then
        ---打开玩法说明页面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 97)
    end
end

function SignInView:CloseView()
    self:StopTime()
    self:Close()
end

function SignInView:UpdateTime(elapsed)
    self.time = self.time - elapsed
    if self.time <= 0 then
        self:CloseView()
    else
        self.go_table.aortext_HuoDongtime.text = _G.GetLangPackValue(90022600050, _G.TimeUtil.TransLateSMCH(Mathf.RoundToInt(self.time)))
    end
end

function SignInView:StopTime()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return SignInView
