---@class SignInModel
local SignInModel = _G.BaseClass("SignInModel", _G.GameDataModelBase)

---区分正负数 (最后一位 ， 0 是正数  1 是负数)
function SignInModel:QuFenNumber(num)
    local string_num = tostring(num)
    if #string_num <= 1 then
        return num
    end
    local count = string.len(string_num)
    local end_num = string.sub(string_num, count, count)
    local num_string = string.sub(string_num, 1, (#string_num - 1))
    num_string = tonumber(num_string)
    if end_num == "1" then
        return -num_string
    else
        return num_string
    end
end

---获取签到对应数据
---@param index activity_sign.i_activity_sign
function SignInModel:GetInfoCall(index, task)
    --立绘的偏移位置坐标
    if index.sign.pos then --暂时不卡流程
        self.pos = {}
        for i = 1, #index.sign.pos do
            local pos_value = index.sign.pos[i]
            --self.pos[]
            if self.pos[i] == nil then
                self.pos[i] = {}
            end
            self.pos[i] = {
                self:QuFenNumber(pos_value.param[1]), --x
                self:QuFenNumber(pos_value.param[2]), --y
                self:QuFenNumber(pos_value.param[3]) --z
            }
        end
    else
        self.pos = {{-16, 400, 0}, {0, 0, 0}, {0, 0, 0}, {-9, 360, 0}, {40, 370, 0}}
    end
    --已领取的奖励id
    self.g_sids = index.sign.g_sids or {}
    --奖励item信息
    self.item = index.sign.item or {}
    --标题
    self.title = index.sign.title or {}
    self.login_days = index.sign.login_days or 0
    self.titleHD = index.sign.login_days - _G.table.count(self.g_sids)
    if _G.table.count(self.g_sids) >= 7 then
        task:ChangeState(require "ActivitySynManager":GetInstance().State.Close)
    end
    if self.SignInModelItem == nil then
        if self:CheckIsOvers() and
        task:GetCurActivityState() ~= require "ActivitySynManager":GetInstance().State.Close  then
            local SignInModelItem = {}
            SignInModelItem.OpenViewFun = function()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SignInView.Name, task)
                --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.PopUpGiftBagView.Name)
            end
            _G.MainManager:GetInstance():AddMainFunQueue(SignInModelItem, _G.MainViewShowOrder.SigPay)
            --self:AddMainFunQueue(MainOpenViewFunItem, _G.MainViewShowOrder.PopUpGiftBag)
            self.SignInModelItem = true
        end
    end
    local win = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.SignInView.Name)
    if win then
        win.View:ShuaXing()
        win.View:XianShiTiem()
    else
        task.typeClass:RefreshRedPoint()
    end
end
---根据ID获取对应天数信息
function SignInModel:HuoQu(sid)
    for key, value in pairs(self.item) do
        if value.sid == sid then
            return value
        end
        -- body
    end
    return nil
end
---根据ID获取对应天数信息
function SignInModel:HuoQuTian(sid)
    for key, value in pairs(self.g_sids) do
        if value == sid then
            return true
        end
        -- body
    end
    return false
end

---检测红点是否结束
function SignInModel:CheckIsOvers()
    if self.g_sids == nil then
        self.g_sids = {}
    end
    if self.login_days > _G.table.count(self.g_sids) and _G.table.count(self.g_sids) < 8 then
        return true
    end
    return false
end

return SignInModel
