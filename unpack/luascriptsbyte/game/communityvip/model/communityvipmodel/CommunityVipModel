function CommunityVipModel:OnCash()
    self:RefreshRedPoint()
end

---销毁对象时,析构函数
function CommunityVipModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eRechargeEvent.TotalCash, self.OnCash, self)
end

return CommunityVipModel
