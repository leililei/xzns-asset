local base = require "ActivitySynTypeBase"
---@class CommunityVipModel : ActivitySynTypeBase	中文描述
local CommunityVipModel = _G.BaseClass("CommunityVipModel", base)
--local version = _G.ConfigManager.discrete_cfg[100108][1][1]
---创建对象时,入口构造函数
function CommunityVipModel:__init()
end

---进入活动主体
function CommunityVipModel:OnEnterActivity()
    _G.Events:GetInstance():AddListener(_G.eRechargeEvent.TotalCash, self.OnCash, self)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommunityVipView.Name)
    local nowtime = _G.TimeUtil.GetServerUnixTime()
    local key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "CommunityVipView_time"
    _G.CS.UnityEngine.PlayerPrefs.SetInt(key, nowtime)
    self:RefreshRedPoint()
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function CommunityVipModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.CommunityVipView.Name
end

---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function CommunityVipModel:InitRedPointTree()
    self.checkRedPointFunc = { self.CheckRedPoint }
    self.redpointTree = { false }
end

