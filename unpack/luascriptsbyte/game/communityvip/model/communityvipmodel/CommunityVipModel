---刷新奖励红点
function CommunityVipModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function CommunityVipModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---属于福利界面的活动是否在福利界面显示,不属于福利活动则不生效
function CommunityVipModel:IsShowInFuliView()
    --local condition = 0

    local amount = _G.GameUtil.GetFunctionData(_G.FunctionBlock.VIPInvitation_amount) or 0

    -- if version == 1 then
    --     local storeGearId = _G.ConfigManager.discrete_cfg[106205][1][1]
