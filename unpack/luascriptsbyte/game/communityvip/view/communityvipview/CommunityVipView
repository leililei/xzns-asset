---@class CommunityVipView : UIBaseView	中文描述
local CommunityVipView = _G.BaseClass("CommunityVipView", _G.UIBaseView)
local rewardCfgId = 100135

function CommunityVipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function CommunityVipView:OnCreate()
    --self:LoadQRImage()
    self:LoadRewardCfg()
end

---加载二维码图案
---@param serverId number 服务器ID
function CommunityVipView:LoadQRImage()
    if not _G.CS.Launcher.Inst.IsSDK then
        return
    end
    --判断是TapTap或B服才加载新的二维码, taptap:845, B站:352
    local channelId = tostring(_G.ServerManager:GetInstance().AppInfo.Platform)
    if channelId ~= "352" and channelId ~= "845" then
        return
    end

    self.go_table.aorrawimage_pic.color = _G.Color.New(1, 1, 1, 0)
    self.go_table.aorrawimage_pic:LoadImage(
        "Images/nCommunity/ui_community_vip_taptap",
        function()
            if self:IsNil() then
                return
            end
            --do anything
        end
    )
end
---加载奖励配置
function CommunityVipView:LoadRewardCfg()
    local rewards = _G.ConfigManager.discrete_cfg[rewardCfgId]
    if _G.table.isEmptyOrNil(rewards) then
        _G.LogError("没有在全局表中找到对应id的条目,请检查配置!")
        _G.LogError(rewardCfgId, "相关sid")
    else
        for _, v in pairs(rewards) do
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                v,
                self.go_table.obj_awardRoot,
                function(item)
                    if self:IsNil() then
                        _G.DestroyObject(item.gameObject)
                        return
                    end
                    if item.ShowNumText then
                        item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    end
                    if item.go_table then
                        item.go_table.obj_Root:SetLocalScale(0.85, 0.85, 0.85)
                    end
                end
            )
        end
    end
end

function CommunityVipView:OnClickBtn(go, isOn, viewName)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:CloseView()
    end
end

function CommunityVipView:CloseView()
    self:Close()
end

return CommunityVipView
