local base = require("BaseGameNet")

---@class SpiritualNet : BaseGameNet	通信协议
local SpiritualNet = _G.BaseClass("SpiritualNet", base)
---@return SpiritualNet SpiritualNet
function SpiritualNet:GetInstance()
    return base.GetInstance(self)
end

---一键卸下灵契
function SpiritualNet:OneKeyOffAccess(pbData, callback)
    local item = _G.ConfigManager.net_map.game_spiritual_port_one_key_off
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

