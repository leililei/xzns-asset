local SpiritualModel = require("SpiritualModel")
local CardInfoManager = require "CardInfoManager"
---@class SpiritualTipsItem
local SpiritualTipsItem = _G.BaseClass("SpiritualTipsItem")

local card_skills_cfg = _G.ConfigManager.card_skills_cfg
local CommonTipManager = require("CommonTipManager"):GetInstance()
local OrderCfg = {
    [1] = {"ImagesH5/hCommon/ui_img_zise", _G.ColorTools.FormatColorByString("e399ff")}, --紫
    [2] = {"ImagesH5/hCommon/ui_img_chengse", _G.ColorTools.FormatColorByString("ffdaac")}, --橙
    [3] = {"ImagesH5/hCommon/ui_img_hongse", _G.ColorTools.FormatColorByString("fcc0ae")}, --红
    [4] = {"ImagesH5/hCommon/ui_img_caise", _G.ColorTools.FormatColorByString("b381ff")} --彩
}

---类的构造函数
function SpiritualTipsItem:__init()
end

---设置参数
---@param dData SpiritualData 灵契数据类
---@param isSelf boolean 是否是当前穿戴(当此参数为true，则btn不生效，反之)
---@param btn table left = {name = string ,onclickFunc = function },right = {name = string ,onclickFunc = function }
---@param tran transform tran
function SpiritualTipsItem:SetData(dData, isSelf, btn, tran)
    if not dData then
        return
    end
    self.data = dData
    self.isSelf = isSelf
    self.btn = btn
    self.tran = tran
    self.go_table = _G.GetAutoGoTable(tran, _G.handler(self, self.OnClickBtn))
    self.rect = self.go_table.obj_SpiritualDescribe:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    self:InitView()
    self:InitTopSuit()
    self:ShowProp()
    self:ShowSkill()
    self:ShowBtn()
    self:ShowUnlockState()
    _G.GameUtil.ReBuildRTF(self.go_table.obj_Content)
end

---初始化锁定状态
function SpiritualTipsItem:ShowUnlockState()
    if self.data:GetOrder() >= 3 and not self.isSelf then
        self.go_table.aorbtn_unlock:SetActiveE(self.data.unlock == 0 and 1 or 0)
        self.go_table.aorbtn_lock:SetActiveE(self.data.unlock == 1 and 1 or 0)
    else
        self.go_table.aorbtn_unlock:SetActiveE(0)
        self.go_table.aorbtn_lock:SetActiveE(0)
    end
end

---初始化界面
function SpiritualTipsItem:InitView()
    local order = self.data:GetCfg().Order + 3
    if order == 7 then
        order = 8
    end
    local outlineColor = _G.ColorTools.FormatColorByString(CommonTipManager:GetTipTypeNameOutLineColorByGrade(order))
    self.go_table.aortext_name:SetActiveE(0)
    self.go_table.aortext_name.text = self.data:GetName()
    CommonTipManager:SetItemTextGradient(self.go_table.aortext_name, order)
    self.go_table.aortext_name:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor
    self.go_table.aortext_name:SetActiveE(1)
    self.go_table.aortext_level.text =
        _G.GetLangPackValue(90021800050) .. "<color=#ffd65b>" .. self.data:GetLevel() .. "</color>"
    self.go_table.aortext_level:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor
    self.go_table.aortext_power.text =
        _G.GetLangPackValue(90000000404,
        "<color=#ffd65b>" .. _G.GameUtil.NumberToUnitStrBag(self.data:GetPower()) .. "</color>")
    self.go_table.aortext_power:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor
    self.go_table.obj_item:RemoveAllChildren()
    _G.ItemFactory:GetInstance():GetItemCard(
        _G.ItemFactory.itemType.ItemSpiritualBase,
            self.go_table.obj_item,
            function(item)
                if _G.IsNil(self.go_table.obj_item) then
                    _G.ItemFactory:GetInstance():SetItemCard(item)
                    return 
                end
                item:ShowData(self.data, function() end)
                item:HideLevel()
                item:HideCount()
                item:SetSize(80)
                item:HideStar()
                item:HideCardBound()
                item:ShowEffectOrder(self.data:GetOrder()==4)
                --item.go_table.obj_uieffect:SetLocalScale(0.8,0.8)
            end
        )
    self.go_table.obj_EffNode:RemoveAllChildren()
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[CommonTipManager:GetItemBgEffectPathByGrade(order)],
            self.go_table.obj_EffNode
    )

    -- self.go_table.aortext_name.color = OrderCfg[order][2]
    -- self.go_table.aortext_level.color = OrderCfg[order][2]
    -- self.go_table.aortext_power.color = OrderCfg[order][2]
    self.go_table.aorrawimage_gradeBG:LoadImage(
        CommonTipManager:GetItemBgPathByGrade(order),
        function(trans)
            if self.go_table == nil then
                _G.DestroyObject(trans)
            end
        end
    )
    if self.data.cfg.Instruction then
        self.go_table.aortext_desc.text = _G.GetLangPackValue(self.data.cfg.Instruction)
    end

    --检查是否是上阵
    local uidLis = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.AFKOnly)
    if uidLis and not _G.table.ContainsValue(uidLis, self.data.cardUid) then
        self.go_table.obj_commonRedpoint:SetActiveE(0)
    else
        local canClickUp = require("SpiritualModel"):GetInstance():CanLevelUp(self.data)
        local isEnough = require("SpiritualModel"):GetInstance():IsEnoughStarUpMaterial(self.data)
        self.go_table.obj_commonRedpoint:SetActiveE(((canClickUp or isEnough) and CardInfoManager.IsShowEquipCultivate(self.data.cardUid)) and 1 or 0)
    end
    self:InitBtn()
end

---初始化切换按钮
function SpiritualTipsItem:InitBtn()
    local data = self.data
    local cur = -1
    self.SpiritualBar = {}
    for k, v in pairs(data.lua.CardData.SpiritualBar) do
        if v then
            local spiritual = v
            spiritual.index = k
            if #self.SpiritualBar > 0 then
                spiritual.pre = self.SpiritualBar[#self.SpiritualBar]
            end
            _G.table.insert(self.SpiritualBar, spiritual)
            if data.index == k then
                cur = #self.SpiritualBar
            end
        end
    end
    local amount = #self.SpiritualBar
    for i = 1, amount do
        if i + 1 <= amount then
            self.SpiritualBar[i].next = self.SpiritualBar[i + 1]
        end
    end
    self.SpiritualBar[1].pre = self.SpiritualBar[amount]
    self.SpiritualBar[amount].next = self.SpiritualBar[1]
    if cur > 0 and cur <= amount and self.SpiritualBar[cur] then
        self.CurSpiritual = self.SpiritualBar[cur]
    end
    self.go_table.aorbtn_pre:SetActiveE(amount > 1 and 1 or 0)
    self.go_table.aorbtn_next:SetActiveE(amount > 1 and 1 or 0)
end

---统计刷新
function SpiritualTipsItem:calcProp(prop)
    local showList = {}
    for i, v in pairs(prop) do
        if v > 0 then
            _G.table.insert(showList, {key = i, sortId = _G.AttrType[i].sortid, num = v})
        end
    end
    _G.SortList(
        showList,
        function(a)
            return -a.sortId
        end
    )
    local index = 1
    self.go_table.obj_PropContent:RemoveAllChildren()
    for _, v in pairs(showList) do
        index = index + 1
        local tran = _G.InstantiateObject(self.go_table.obj_BaseProp, self.go_table.obj_PropContent)
        if tran then
            local tb = _G.GetAutoGoTable(tran)
            if index % 4 == 0 then
                tb.aorimage_Bg:SetActiveE(1)
            end
            tb.aortext_Name.text = _G.AttrType[v.key].des .. " ："
            local numStr = v.num
            if _G.AttrType[v.key].percentage == 1 then
                numStr = _G.GameUtil.FormatNum(numStr * 100)
                -- numStr = "<color=#C0C0BA>" .. numStr .. "%</color>"
            else
                numStr = _G.GameUtil.NumberWY(_G.math.floor(numStr))
            end
            tb.aortext_Num.text = numStr
        end
    end
end

---设置属性
------@param data SpiritualData
function SpiritualTipsItem:ShowProp()
    local ChildCount = self.go_table.obj_PropContent:GetChildCountE()
    if ChildCount > 0 then
        for i = 1, ChildCount do
            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_PropContent:GetChildE(0), _G.ePoolType.UIItem)
        end
    end

    if self.data.attribute then
        local prop = self.data.attribute:GetAttrByName()
        self:calcProp(prop)
    end
end

---点击超链接
function SpiritualTipsItem:OnHrefClick(id, name, asa)
    local weight, height = self.rect:GetRectTransformWidthHeight()
    require("CommonTipManager"):GetInstance():OpenSkillHyper(_G.tonumber(id), nil, weight, height)
end

---显示技能
function SpiritualTipsItem:ShowSkill()
    local cfg = self.data:GetCfg()
    local skillDesExText = self.go_table.obj_baseSkill:GetComponentE(_G.typeof(_G.CS.ExtendText))
    skillDesExText.text = require("SpiritualModel").GetStarSkillDes(cfg.id, 0)
    skillDesExText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))

    self.go_table.trans_content:RemoveAllChildren()
    for i = 1, #cfg.skill_id - 1 do
        local obj = _G.InstantiateObject(self.go_table.obj_skillItem, self.go_table.trans_content)
        local tb = _G.GetAutoGoTable(obj)
        tb.DesExText = tb.obj_upDes:GetComponentE(_G.typeof(_G.CS.ExtendText))
        local color = self.data.star < i and "A9A9A37F" or "76DAF8FF"
        tb.DesExText.color = _G.ColorTools.FormatColorByString(color)
        tb.DesExText.text = _G.GetLangPackValue(90000010475, i) .. ":"..  require("SpiritualModel").GetStarSkillDes(cfg.id, i)
        tb.DesExText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))
    end

    if #cfg.skill_id <= 1 then
        self.go_table.obj_gap:SetActiveE(0)
        self.go_table.obj_skills:SetActiveE(0)
    end
end

---获取基本技能描述
function SpiritualTipsItem:GetSkillDesBase(id)
    if card_skills_cfg[id] then
        return _G.GetLangPackValue(card_skills_cfg[id].describe1)
    else
        return id
    end
end

---获取技能描述
function SpiritualTipsItem:GetSkillDes(index, id)
    if card_skills_cfg[id] then
        return _G.GetLangPackValue(90022300084, index, _G.GetLangPackValue(card_skills_cfg[id].describe1))
    else
        return _G.GetLangPackValue(90022300084, index, id)
    end
end

---显示按钮
function SpiritualTipsItem:ShowBtn()
    if self.btn == nil then
        self.go_table.obj_Btn:SetActiveE(0)
        return
    end
    if self.btn.left then
        self.go_table.aorbtn_left:SetActiveE(1)
        self.go_table.aortext_BtnLeftName.text = self.btn.left.name
    end
    if self.btn.middle then
        self.go_table.aorbtn_middle:SetActiveE(1)
        self.go_table.aortext_BtnMiddleName.text = self.btn.middle.name
    end
    if self.btn.right then
        self.go_table.aorbtn_right:SetActiveE(1)
        self.go_table.aortext_BtnRightName.text = self.btn.right.name
    end
end

function SpiritualTipsItem:InitTopSuit()
    if self.data.cfg.suit==0 then
        self.go_table.obj_SpiritualSuit:SetActiveE(0)
    else
        local suitcfg=_G.ConfigManager.spiritual_suit_cfg[self.data.cfg.suit]
        self.go_table.obj_SpiritualSuit:SetActiveE(1)
        local allSpiritual=self.data.lua.CardData.SpiritualBar
        local  activesuitItem={}
        for k,v in pairs(allSpiritual) do
            if table.ContainsValue(suitcfg.name2,v.sid) and not table.ContainsValue(activesuitItem,v.sid) then
                table.insert(activesuitItem,v.sid)
            end
        end
        local str=string.format("%s(%s/%s)",GetLangPackValue(suitcfg.name),#activesuitItem,#suitcfg.name2)
        local textcolor="fbfbec"
        for i = 1, #suitcfg.att_suit2 do
            if #activesuitItem>=suitcfg.att_suit2[i][1] then
                textcolor="60a93b"
            end
        end
        self.go_table.aortext_suitName.text=string.format("<color=#%s>%s</color>",textcolor,str)
        self.go_table.obj_skillitem:SetActiveE(1)
        self.go_table.obj_suitSkillContent:ClearChildren()
        for i = 1, #suitcfg.att_suit2 do
            textcolor="A9A9A3"
            if #activesuitItem>=suitcfg.att_suit2[i][1] then
                textcolor="76DAF8"
            end
            local skillitem=_G.InstantiateObject(self.go_table.obj_skillitem,self.go_table.obj_suitSkillContent)
            local tb=_G.GetAutoGoTable(skillitem)
            local skillcfg=_G.ConfigManager.card_skills_cfg[suitcfg.att_suit2[i][2]]
            tb.aortext_skillitem.text=string.format("<color=#%s>%s</color>",textcolor,GetLangPackValue(skillcfg.describe1))
            _G.GameUtil.ReBuildRTF(skillitem)
        end
        _G.GameUtil.ReBuildRTF(self.go_table.obj_suitSkillContent)
        self.go_table.obj_skillitem:SetActiveE(0)
        self.suitlist={}
        for i = 1, #suitcfg.name2 do
            table.insert(self.suitlist,{sid=suitcfg.name2[i],
                                        isactive=table.ContainsValue(activesuitItem,suitcfg.name2[i]) and 1 or 0 })
        end
        _G.SortList(self.suitlist,function(item)
            return item.isactive,item.sid
        end)
        if not self.suitinit then
            self.go_table.scrollloophorizontal_suitlist:InitItemData(#self.suitlist, _G.handler(self, self.RefreshskillItem))
            self.suitinit=true
        else
            self.go_table.scrollloophorizontal_suitlist:UpdateCount(#self.suitlist)
        end
    end
end
function SpiritualTipsItem:RefreshskillItem(index, obj)
    local _index=index+1
    local suititem=self.suitlist[_index]
    local tb=_G.GetAutoGoTable(obj)
    ---@type SpiritualData
    local itemdata=_G.StorageManager:GetInstance():GetItemDataClass(suititem.sid)
    tb.aortext_name.text=string.format("<color=%s>%s</color>",suititem.isactive==1 and "#fafaeb" or "#c1bed4",
            GetLangPackValue(itemdata.cfg.Name))
    tb.obj_lock:SetActiveE(suititem.isactive==1 and 0 or 1)
    _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemSpiritualBase,
            tb.obj_root,
            function(item)
                if _G.IsNil(tb.obj_root) then
                    _G.ItemFactory:GetInstance():SetItemCard(item)
                    return
                end
                item:ShowData(itemdata, function() end)
                item:HideLevel()
                item:HideCount()
                item:SetSize(80)
                item:HideStar()
                item:HideCardBound()
                --item:ShowEffectOrder(itemdata:GetOrder()==4)
                item.go_table.obj_uieffect:SetLocalScale(0.8,0.8)
            end
    )
end
---按钮点击事件
function SpiritualTipsItem:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_left" then
        self.btn.left.func()
        if self.btn.left.close then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DecorationTipsView.Name)
        end
    elseif name == "@_aorbtn_middle" then
        self.btn.middle.func()
        if self.btn.middle.close then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DecorationTipsView.Name)
        end
    elseif name == "@_aorbtn_right" then
        self.btn.right.func()
        if self.btn.right.close then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DecorationTipsView.Name)
        end
    elseif name == "@_aorbtn_lock" then
        SpiritualModel:GetInstance():Unlock(0, self.data.cardUid, self.data, function()
            self.go_table.aorbtn_lock:SetActiveE(0)
            self.go_table.aorbtn_unlock:SetActiveE(1)
            _G.PopWindowManager:GetInstance():ShowAllTips(920105)
        end)
    elseif name == "@_aorbtn_unlock" then
        SpiritualModel:GetInstance():Unlock(1, self.data.cardUid, self.data, function()
            self.go_table.aorbtn_lock:SetActiveE(1)
            self.go_table.aorbtn_unlock:SetActiveE(0)
            _G.PopWindowManager:GetInstance():ShowAllTips(920106)
        end)
    elseif name == "@_aorbtn_pre" then
        if self.CurSpiritual.pre then
            self.data.lua:OnClickItem(
                nil,
                nil,
                true,
                self.CurSpiritual.pre,
                self.CurSpiritual.pre.index,
                function(newData)
                    self:SetData(newData.data, newData.isSelf, newData.btn, self.tran)
            end)
        end
    elseif name == "@_aorbtn_next" then
        if self.CurSpiritual.next then
            self.data.lua:OnClickItem(
                nil,
                nil,
                true,
                self.CurSpiritual.next,
                self.CurSpiritual.next.index,
                function(newData)
                    self:SetData(newData.data, newData.isSelf, newData.btn, self.tran)
            end)
        end
    end
end

function SpiritualTipsItem:Dispose()
    self.go_table = nil
end

return SpiritualTipsItem
