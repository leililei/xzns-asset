---卡牌解锁无特效
function SpiritualIllustrationView:LoadUnlockEffect(effectParent, isAddExp)
    self:LoadTrailEffect(3, isAddExp)
end

---拖尾特效
function SpiritualIllustrationView:LoadTrailEffect(effectCount, isAddExp)
    if isAddExp then
        -- 无特效
        _G.coroutine.start(
                function()
                    for i = 1, effectCount do
                        _G.coroutine.waitforseconds(0.05)
                        -- 删除特效加载
                        local x, y, z = self.go_table.slider_exp:GetPosition()
                        -- 更新UI
                        self:UpdateExpSliderPosition(x, y, z)
                    end
                    -- 更新视图
                    self:UpdataView()
                    self:InitInfo()
                    self:PropShow()
                end)
    else
        -- 更新视图
        self:UpdataView()
        self:InitInfo()
    end
end

function SpiritualIllustrationView:PropShow()
    ---@type Params_View_PropUp
    local Params_View_PropUp = {}
    Params_View_PropUp.Posx = 0
    local level = SpiritualIllustrationModel:GetInstance():GetIllLevel()
    local data = SpiritualIllustrationModel:GetInstance():GetIllLevelAddition(level)
    local curdata = {
        [_G.AttrType.max_hp.key] = data.max_hp,
        [_G.AttrType.atk.key] = data.atk,
        [_G.AttrType.def.key] = data.def,
        [_G.AttrType.bre.key] = data.bre
    }
    _G.UIUtils.ShowPropUp(curdata, self.lastProp,
            function()
                self.lastProp = curdata
            end,
            Params_View_PropUp)
end

