---@class SpiritualIllustrationView : UIBaseView
local SpiritualIllustrationModel = require("SpiritualIllustrationModel")
---@field public go_table SpiritualIllustrationView_GoTable GoTable

local SpiritualIllustrationView = _G.BaseClass("SpiritualIllustrationView", _G.UIBaseView)

---灵契品质
local SpiritualQuality = {
    Purple = 1,
    Orange = 2,
    Red = 3,
    Colour = 4,
    All = 5
}

---灵契品质背景
local QualityIcon = {
    "TY_Background_kuang_zi",
    "TY_Background_kuang_cheng",
    "TY_Background_kuang_hong",
    "TY_Background_kuang_cai",
}

local OrderEffectCfg = _G.ConfigManager.ui_effect_cfg.ef_TY_Background_kuang_cai

function SpiritualIllustrationView:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end

function SpiritualIllustrationView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_Btns = _G.GetAutoGoTable(self.go_table.obj_btns)
end

---更新视图显示
function SpiritualIllustrationView:UpdateView()
    self.go_table.scrollloopvectical_spiritual:ScrollToTop()
end

function SpiritualIllustrationView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_RCloseView" or name == "@_aorrawimage_mask" then
        self:Close()
    elseif name == "$_obj_btn5" then
        self:SetBtnInfo(SpiritualQuality.All)
    elseif name == "$_obj_btn4" then
        self:SetBtnInfo(SpiritualQuality.Colour)
    elseif name == "$_obj_btn3" then
        self:SetBtnInfo(SpiritualQuality.Red)
    elseif name == "$_obj_btn2" then
        self:SetBtnInfo(SpiritualQuality.Orange)
    elseif name == "$_obj_btn1" then
        self:SetBtnInfo(SpiritualQuality.Purple)
    elseif name == "@_aorbtn_active" then
        self:OneKeyUpStar()
    elseif name == "@_aorbtn_help" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 111)
    end
end

