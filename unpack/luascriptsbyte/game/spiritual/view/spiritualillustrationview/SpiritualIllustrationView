---页签
function SpiritualIllustrationView:SetBtnInfo(index)
    if self.selectBtnIndex == index then
        return
    end
    self.selectBtnIndex = index
    if not self.BtnsDic then
        self.BtnsDic = {}
    end
    
    for _, i in pairs(SpiritualQuality) do
        if not self.BtnsDic[i] then
            self.BtnsDic[i] = _G.GetAutoGoTable(self.go_Btns[string.format("obj_btn%d", i)], _G.handler(self, self.OnClickBtn))
        end

        self.BtnsDic[i].aorimage_select:SetActiveE(self.selectBtnIndex == i and 1 or 0)
    end
    self:UpdataView()
    self.go_table.scrollloopvectical_spiritual:ScrollToTop()
end

---初始化图鉴信息
function SpiritualIllustrationView:InitInfo()
    self.illLevel = SpiritualIllustrationModel:GetInstance():GetIllLevel()
    self.go_table.aortext_level.text = _G.GetLangPackValue("90021800050") .. self.illLevel
    local curExp, needExp = SpiritualIllustrationModel:GetInstance():GetIllExp()
    self.go_table.slider_exp.value = curExp / needExp
    if not self.slider_exp then
        self.slider_exp = _G.GetAutoGoTable(self.go_table.slider_exp)
    end
    self.go_table.aortext_exp.text = curExp .. "/" .. needExp
    if not self.lastillLevel then
        self.lastillLevel = self.illLevel
    end

    self:RefreshProp()
    self.lastillLevel = self.illLevel
end

---刷新图鉴属性
function SpiritualIllustrationView:RefreshProp()
    local attribute = {}
    local config = _G.ConfigManager.illustrations_spiritual_lv_cfg[self.illLevel]
    if config then
        attribute["atk"] = config.atk
        attribute["bre"] = config.bre
        attribute["def"] = config.def
        attribute["max_hp"] = config.max_hp
    end
    self:InitPropAddition(attribute)
end

---属性加成
---@field attribute table 属性列表
function SpiritualIllustrationView:InitPropAddition(attribute)
    local ChildCount = self.go_table.obj_PropContent:GetChildCountE()
    if ChildCount > 0 then
        for i = 1, ChildCount do
            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_PropContent:GetChildE(i - 1), _G.ePoolType.UIItem)
        end
    end

    local showList = {}
    for i, v in pairs(attribute) do
        _G.table.insert(showList, {key = i, sortId = _G.AttrType[i].sortid, num = v})
    end
    _G.SortList(
        showList,
        function(a)
            return -a.sortId
        end
    )

    local numStr, tb, tran
    for i, v in pairs(showList) do
        tran = _G.InstantiateObject(self.go_table.obj_BaseProp, self.go_table.obj_PropContent)
        if tran then
            tb = _G.GetAutoGoTable(tran)
            tb.aortext_Name.text = _G.AttrType[v.key].des
            if _G.AttrType[v.key].percentage == 1 then
                numStr = _G.GameUtil.FormatNum(v.num * 100)
                numStr = "<color=#6effc6>" .. numStr .. "%" .. "</color>"
            else
                numStr = _G.GameUtil.NumberWY(v.num)
            end
            tb.aortext_Num.text = _G.GameUtil.NumberWY(v.num)

            if self.lastillLevel ~= self.illLevel then
--[[                local config = _G.ConfigManager.ui_effect_cfg.ef_ListLevUp
                _G.UIUtils.LoadEffectByCfg(
                    config,
                    tb.gameObject,
                    function(trans)
                        if _G.IsNil(tb.gameObject) then
                            _G.UIUtils:RemoveEffect(trans, config.DispoeType)
                            return
                        end
                    end,
                    function()
                    end
                ) ]]
            end
        end
    end
end

---获取可激活和升星的灵契
function SpiritualIllustrationView:GetUpStarList()
    local sids = {}
    for _, v in pairs(self.careerList[SpiritualQuality.All]) do
        if (not v.unLock and v.max_star >= 0) or (v.unLock and v.unlock_star < v.max_star) then
            _G.table.insert(sids, v.sid)
        end
    end

    return sids
end

function SpiritualIllustrationView:OneKeyUpStar()
    local sids = self:GetUpStarList()
    if not _G.table.isEmptyOrNil(sids) then
        SpiritualIllustrationModel:GetInstance():IllustrationUnlock(sids, function(isAddExp)
            self:LoadTrailEffect(6, isAddExp)
        end)
    end
end

function SpiritualIllustrationView:ShowOrderEffect(tb, isShow)
    self:RemoveEffect(tb)
    if isShow then
        local effect = OrderEffectCfg
        _G.UIUtils.LoadEffectByCfg(
                effect,
                tb.obj_uieffect,
                function(trans)
                    if tb.obj_uieffect:GetChildCountE() > 1 or tb.data.order < 4 then
                        _G.DestroyObject(trans)
                        return
                    end
                    --trans.gameObject:SetLocalScaleXYZ(0.77)
                    trans:AddComponentE(typeof(CS.ParticleClipRect))
                end
        )
    end
end

---清楚品质特效
function SpiritualIllustrationView:RemoveEffect(tb)
    if tb.obj_uieffect:GetChildCountE() > 0 then
        for i = 1, tb.obj_uieffect:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(tb.obj_uieffect:GetChildE(0), _G.ePoolType.UIEffect)
        end
    end
end

function SpiritualIllustrationView:Dispose()
    if self.effectCor then
        _G.coroutine.stopwaiting(self.effectCor)
        self.effectCor = nil
    end
end

return SpiritualIllustrationView