function SpiritualIllustrationView:OnEnable()
    self.careerList = SpiritualIllustrationModel:GetInstance():GetIllustrationList()
    self:UpdataView(self.isInit)
    self:SetBtnInfo(SpiritualQuality.All)
    if self.isInit then 
        self:InitInfo()
        self.illLevel = SpiritualIllustrationModel:GetInstance():GetIllLevel()
        local curdata = SpiritualIllustrationModel:GetInstance():GetIllLevelAddition(self.illLevel)
        self.lastProp = {
            [_G.AttrType.max_hp.key] = curdata.max_hp or 0,
            [_G.AttrType.atk.key] = curdata.atk or 0,
            [_G.AttrType.def.key] = curdata.def or 0,
            [_G.AttrType.bre.key] = curdata.bre or 0
        }
        self.isInit = false
    end
end

function SpiritualIllustrationView:UpdataView(isInit)
    if not self.selectBtnIndex then
        self.curList = self.careerList[SpiritualQuality.All]
    else
        self.curList = self.careerList[self.selectBtnIndex]
    end

    local sids = self:GetUpStarList()
    if not _G.table.isEmptyOrNil(sids) then
        local color = "8C2D14"
        if _G.AppSetting.IsXzns then
            color = "50351E"
        end
        self.go_table.aorimage_active:SetGray(false)
        self.go_table.aortext_active.color = _G.ColorTools.FormatColorByString(color)
        self.go_table.aorimage_active:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
        _G.ColorTools.FormatColorByString("FFFFFF")
    else
        self.go_table.aorimage_active:SetGray(true)
        self.go_table.aortext_active.color = _G.ColorTools.FormatColorByString("434343")
        self.go_table.aorimage_active:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
        _G.ColorTools.FormatColorByString("A9A9A9")
    end

    _G.SortList(
        self.curList,
        function(a)
            return a.sid
        end
    )
    local itemCount = #self.curList
    if isInit then
        self.go_table.scrollloopvectical_spiritual:InitItemData(itemCount, _G.handler(self, self.RefreshItemList))
        for index, v in pairs(self.curList) do
            if (not v.unLock and v.max_star >= 0) or (v.unLock and v.unlock_star < v.max_star) then
                _G.DelayFrameDo(
                    function()
                        self.go_table.scrollloopvectical_spiritual:ScrollToIndex(index - 1)
                    end
                )
                return
            end
        end
    else
        if itemCount == self.lastItemCount then 
            self.go_table.scrollloopvectical_spiritual:UpdateAllItem()
        else
            self.go_table.scrollloopvectical_spiritual:UpdateCount(itemCount)
        end
    end
    self.lastItemCount = itemCount
end

function SpiritualIllustrationView:RefreshItemList(index, obj)
    local data = self.curList[index + 1]
    local tb = _G.GetAutoGoTable(obj)
    tb.data = data
    _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickItemBtn, data, tb.obj_effect))
    local pos = data.cfg.pos_portrait1
    --没图片暂时屏蔽
    tb.aorrawimage_icon:LoadImage(
        data.image,
        function(item)
            if pos then
                item:SetNativeSize()
                item:SetLocalPosition(pos[1] or 0, pos[2] or 0, pos[3] or 0)
                if pos[4] then
                    item:SetLocalScaleXYZ(pos[4])
                end
            end
        end
    )
    for i = 1, 5 do
        if data.unLock and data.unlock_star >= i then
            tb["aorimage_starmask" .. i]:SetActiveE(1)
        else
            tb["aorimage_starmask" .. i]:SetActiveE(0)
        end
    end
    tb.aorimage_rank.SpriteName = QualityIcon[data.order]

    tb.aorimage_upstar:SetActiveE(0)
    tb.aorimage_active:SetActiveE(0)
    tb.obj_redpoint:SetActiveE(0)
    if data.unLock and data.unlock_star >= data.max_star then
        tb.aorimage_mask:SetActiveE(0)
    else
        tb.aorimage_mask:SetActiveE(1)
    end

    if not data.unLock then
        tb.aorimage_active:SetActiveE(data.max_star >= 0 and 1 or 0)
        tb.obj_redpoint:SetActiveE(data.max_star >= 0 and 1 or 0)
    elseif data.unlock_star < data.max_star then
        tb.aorimage_upstar:SetActiveE(1)
        tb.obj_redpoint:SetActiveE(1)
    end
    self:ShowOrderEffect(tb, data.order >= 4)
    obj:SetActiveE(1)
end

function SpiritualIllustrationView:OnClickItemBtn(go, isOn, data, effectParent)
    local name = go:GetName()
    if name == "@_aorimage_rank" then
        require "CommonTipManager":GetInstance():OpenTip(go, data.sid, data.uid, nil, true)
    elseif name == "@_aorimage_mask" then
        if not data.unLock then
            if data.max_star < 0 then
                require "CommonTipManager":GetInstance():OpenTip(go, data.sid, data.uid, nil, true)
            else
                SpiritualIllustrationModel:GetInstance():IllustrationUnlock({data.sid}, function(isAddExp)
                    self:LoadUnlockEffect(effectParent, isAddExp)
                end)
            end
        elseif data.unlock_star < data.max_star then
            SpiritualIllustrationModel:GetInstance():IllustrationUnlock({data.sid}, function(isAddExp)
                self:LoadUnlockEffect(effectParent, isAddExp)
            end)
        end
    end
end

