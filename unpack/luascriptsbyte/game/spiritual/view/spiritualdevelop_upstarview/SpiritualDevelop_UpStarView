---升星
function SpiritualDevelop_UpStarView:OnUp()
    if self.SpiritualData.star >= self.SpiritualData.cfg.Star then
        return
    end
    if #self.consumeItem < self.needCount then
        local quickUseBox = _G.StorageManager:GetInstance():FastCheckItem(self.SpiritualData.sid, function()
            self:InitSpiritualItem()
            return
        end)
        if not quickUseBox then
            _G.PopWindowManager:GetInstance():ShowAllTips(270901)
        end
        return
    end
    self:DoUp()
end

---执行升星
function SpiritualDevelop_UpStarView:DoUp()
    local tb = {}
    local cardUid = 0
    if self.SpiritualData.cardUid then
        cardUid = self.SpiritualData.cardUid
    end

    local starUp = function()
        local msg = self.SpiritualData:GetMsg()
        msg.cardUid = cardUid
        local data = _G.SpiritualData.New()
        data:ParseInitMsg(msg)
        require("SpiritualModel"):GetInstance():StarUp(
            self.SpiritualData,
            cardUid,
            tb,
            self.SpiritualData.uid ~= self.SpiritualData.sid,
            function(msgData)
                if msgData.ack ~= 1 then
                    return
                end
                for _, v in pairs(tb) do
                    _G.StorageManager:GetInstance():ConsumeSpiritual(v.uid, v.num)
                end
                --清空之前保存的材料信息
                require("SpiritualModel"):GetInstance().MaterialList = nil
                if msgData.uid then
                    self.SpiritualData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Spiritual,
                        msgData.uid)
                end
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.DecorationUpView.Name,
                    data,
                    self.SpiritualData,
                    3,
                    function()
                        if msgData.award then
                            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msgData)
                        end
                    end
                    , true
                )
                if self.cardData then
                    require "CardInfoManager":GetInstance():Updata_CardViewUpdataFun(self.cardData, true)
                    local curPower = self.cardData.power
                    if self.lastPower < curPower then
                        require "CommonTipManager".OpenPowerUpView(self.lastPower, curPower - self.lastPower)
                    end
                    self.lastPower = curPower
                end

                if self.callback then
                    if self.cardData then
                        self.callback(self.SpiritualData, self.cardData, self.lastPower)
                    else
                        self.callback(self.SpiritualData)
                    end
                end
                self:Init()
            end
        )
    end
    local needTakeList = {}
    for _, v in pairs(self.consumeItem) do
        if v.cardUid ~= 0 then
            --已装备的先脱再消耗
            _G.table.insert(needTakeList, v)
        end
        if not tb[v.uid] then
            tb[v.uid] = { uid = v.uid, num = 0 }
        end
        tb[v.uid].num = tb[v.uid].num + 1
    end
    tb = _G.table.toArray(tb)
    if #needTakeList > 0 then
        self:TakeOffSpiritual(needTakeList, starUp)
    else
        starUp()
    end
end

---更新属性
function SpiritualDevelop_UpStarView:UpdateProp()
    local arrribute = self.SpiritualData:GetAttribute()
    local star = _G.math.min(self.SpiritualData.star + 1, self.SpiritualData.cfg.Star)
    local nextAttribute = self.SpiritualData:GetBaseAttr(nil, nil, star)
    local prop = arrribute:GetAttrByName()
    self.propList = {}
    local GetValue = function(key, value, isPer)
        local num = value
        local numStr
        if _G.AttrType[key].percentage == 1 or isPer then
            num = num * 10000
            num = _G.GameUtil.FormatNum(_G.Mathf.RoundToInt(num) / 100)
            num = tostring(num) .. "%"
            numStr = num
        else
            num = _G.math.floor(num)
            num = _G.GameUtil.NumberWY(num)
            numStr = tostring(num)
        end
        return numStr
    end

    local showProp = function(type)
        prop = arrribute:GetAttrByName(type)
        local isPer = type == _G.AttCountType.basePercent
        for i, v in pairs(prop) do
            if _G.AttrType[i] then
                _G.table.insert(
                    self.propList,
                    {
                        name = _G.AttrType[i].des,
                        value = GetValue(i, v, isPer),
                        nextValue = GetValue(i, nextAttribute:GetValueByName(i, type), isPer),
                        sort = isPer and _G.AttrType[i].sortid + 10 or _G.AttrType[i].sortid
                    }
                )
            end
        end
    end
    for _, v in pairs(_G.AttCountType) do
        showProp(v)
    end
    _G.SortList(
        self.propList,
        function(a)
            return -a.sort
        end
    )
    --if self.SpiritualData.star >= self.SpiritualData.cfg.Star then
    --    self.go_table.scrollloopvectical_propList:SetActiveE(0)
    --    self.go_table.scrollloopvectical_maxPropList:SetActiveE(1)
    --    self.go_table.scrollloopvectical_maxPropList:UpdateCount(#self.propList)
    --else
    ---ZHJH-5791修改满星后属性显示
    self.go_table.scrollloopvectical_propList:SetActiveE(1)
    self.go_table.scrollloopvectical_maxPropList:SetActiveE(0)

    self.go_table.scrollloopvectical_propList:UpdateCount(#self.propList)
    --end
end

---刷新属性显示
function SpiritualDevelop_UpStarView:RefreshPropItem(index, obj)
    local tb = GetAutoGoTable(obj)
    if self.SpiritualData.star >= self.SpiritualData.cfg.Star then
        self.propList[index + 1].nextValue = _G.GetLangPackValue(90022300065)
    end
    tb.aortext_propName.text = self.propList[index + 1].name
    tb.aortext_curValue.text = self.propList[index + 1].value
    if tb.aortext_nextValue then
        tb.aortext_nextValue.text = self.propList[index + 1].nextValue
    end
end

---点击事件
function SpiritualDevelop_UpStarView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_up then
        self:OnUp()
    end
end

function SpiritualDevelop_UpStarView:PlayAni()
    local Tweening = _G.CS.DG.Tweening
    self.tweer = self.go_table.obj_ring2:DOLocalMoveY(90, 1):SetEase(Tweening.Ease.InOutSine):SetLoops(
        -1,
        Tweening.LoopType.Yoyo
    )
end

return SpiritualDevelop_UpStarView
