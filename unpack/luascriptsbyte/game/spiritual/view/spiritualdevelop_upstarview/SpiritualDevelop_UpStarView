---更新技能显示
function SpiritualDevelop_UpStarView:UpdateSkillDesc()
    if not self.skillExtendText then
        self.skillExtendText = self.go_table.obj_skillDesc1:GetComponentE(_G.typeof(_G.CS.ExtendText))
    end

    if self.SpiritualData.star >= self.SpiritualData.cfg.Star then
        self.skillExtendText.text = ""
        self.go_table.aortext_max.text = ""
        self.go_table.trans_skill:SetActiveE(0)
    else
        self.go_table.aortext_max.text = ""
        local str = require("SpiritualModel").GetStarSkillDes(self.SpiritualData.sid, self.SpiritualData.star + 1)
        if str ~= "" then
            self.skillExtendText.text = _G.string.gsub(str, "5bdf99", "15874B")
            self.skillExtendText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))
        else
            self.skillExtendText.text = ""
            self.go_table.aortext_max.text = _G.LangUtil.GetLangPackValue(LanguageID.NoUp)
        end
    end
end

function SpiritualDevelop_UpStarView:OnHrefClick(id, name, asa)
    require("CommonTipManager"):GetInstance():OpenSkillHyper(_G.tonumber(id), nil, 0, 720)
end

function SpiritualDevelop_UpStarView:UpdateMaterial(list)
    self.materialList = list and list or {}
    self.go_table.slider_progress.value = #self.materialList / self.needCount
    self.go_table.aortext_Slider.text = #self.materialList .. "/" .. self.needCount
    self:UpdateRedPoint()
    self:UpdateConsumeItem()
    --self.go_table.obj_redPoint2:SetActiveE(#self.materialList == self.needCount and 1 or 0)
    self.go_table.obj_add:SetActiveE(#self.materialList < self.needCount and 1 or 0)
end

function SpiritualDevelop_UpStarView:UpdateConsumeItem()
    self.consumeItem = {}
    for _, v in pairs(self.materialList) do
        _G.table.insert(self.consumeItem, v[3])
    end
end

function SpiritualDevelop_UpStarView:OpenSelectView()
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.SpiritualSelectView.Name,
        self.SpiritualData,
        self.cardData,
        self.needCount,
        self.list,
        _G.handler(self, self.UpdateMaterial)
    )
end

