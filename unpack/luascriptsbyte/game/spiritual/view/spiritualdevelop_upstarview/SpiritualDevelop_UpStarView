function SpiritualDevelop_UpStarView:Awake()
    self.go_table = GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.scrollloopvectical_propList:InitItemData(0, _G.handler(self, self.RefreshPropItem))
    self.go_table.scrollloopvectical_maxPropList:InitItemData(0, _G.handler(self, self.RefreshPropItem))
    ---@field SpiritualitemList ItemSpiritualBase[]
    self.spiritualitemList = {}
    self.consumeItem = {}
end

---显示界面
---@param data SpiritualData
function SpiritualDevelop_UpStarView:Init(data, callback, cardData, lastPower)
    if data then
        self.SpiritualData = data
        self.cardData = cardData
        self.lastPower = lastPower
    end
    self.materialList = {}
    if callback then
        self.callback = callback
    end
    local isMax = self.SpiritualData.cfg.Star == self.SpiritualData.star
    if not isMax then
        self.starCfg = _G.ConfigManager.spiritual_star_cfg[100 + self.SpiritualData.star + 1]
        self.lastStarCfg = _G.ConfigManager.spiritual_star_cfg[100 + self.SpiritualData.star]
    else
        self.starCfg = _G.ConfigManager.spiritual_star_cfg[100 + self.SpiritualData.star]
        self.lastStarCfg = _G.ConfigManager.spiritual_star_cfg[100 + self.SpiritualData.star - 1]
    end
    self.go_table.aorbtn_up:SetActiveE(isMax and 0 or 1)
    self.go_table.obj_max:SetActiveE(isMax and 1 or 0)
    self.go_table.trans_remainsRoot:SetActiveE(isMax and 0 or 1)
    self:UpdateSkillDesc()
    self:InitSpiritualItem()
    self:UpdateProp()
    self:UpdateRedPoint()
end

---按钮红点
function SpiritualDevelop_UpStarView:UpdateRedPoint()
    --检查是否是上阵
    local uidLis = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.AFKOnly)
    if not uidLis or not _G.table.ContainsValue(uidLis, self.SpiritualData.cardUid) then
        self.go_table.obj_redPoint:SetActiveE(0)
        self.go_table.obj_redPoint2:SetActiveE(0)
    else
        local canUse = 0
        for _, v in pairs(self.list.material) do
            if v.cardUid == 0 then
                canUse = canUse + 1
            end
        end
        local isEnough = #self.materialList == self.needCount
        local canUp = canUse >= self.needCount
        if canUp then
            self.go_table.obj_redPoint:SetActiveE(isEnough and 0 or 1)
        else
            self.go_table.obj_redPoint:SetActiveE(0)
        end
        self.go_table.obj_redPoint2:SetActiveE(isEnough and 1 or 0)
    end
end

