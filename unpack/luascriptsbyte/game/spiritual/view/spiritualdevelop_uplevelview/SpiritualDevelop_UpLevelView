---@class SpiritualDevelop_UpLevelView : UIBaseView
local SpiritualDevelop_UpLevelView = _G.BaseClass("SpiritualDevelop_UpLevelView", _G.UIBaseView)
local GetLangPackValue = _G.GetLangPackValue
local GetAutoGoTable = _G.GetAutoGoTable
local CardInfoManager = require "CardInfoManager"

---升10级
local LevelUpTen = 10

function SpiritualDevelop_UpLevelView:Awake()
    self.go_table = GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self.consumeResList = {}
    self:AddListener(_G.eItemUpdata.Updata, self.ShowInfo, self)
end

---初始化
---@param data SpiritualData
function SpiritualDevelop_UpLevelView:Init(data, call, cardData, lastPower)
    if data then
        self.SpiritualData = data
        self.cardData = cardData
        self.lastPower = lastPower
        self.call = call
    end
    self.maxLevel = _G.ConfigManager.spiritual_star_cfg[100 + self.SpiritualData.cfg.Star].level_limit
    self.curMaxLevel = self.SpiritualData:GetMaxLevel()
    self.upLevel = self.SpiritualData:GetLevel() == self.maxLevel and 0 or 1
    self.oldLoadCompleted = true
    self:ShowInfo()
    -- self.go_table.obj_redPointImage:SetActiveE(0)
    -- self.go_table.obj_redPointImage2:SetActiveE(0)
end

---显示信息
function SpiritualDevelop_UpLevelView:ShowInfo()
    self:ShowConsume()
    self:ShowBtn()
    self:UpdateRedPoint()
    self:ShowProp()
end

function SpiritualDevelop_UpLevelView:ShowConsumItem(datas)
    if datas then
        self.go_table.obj_Matrial:SetActiveE(1)
        local consumeList = {}
        for _, v in ipairs(datas) do
            if v[2] > 0 then
               _G.table.insert(consumeList, {v[1], false, v[2]}) 
            end
        end
        if not self.resConsume then
            self.resConsume = self:AddComponent(
                self.go_table.obj_Matrial,
                require("ConsumeCompont").New(self.go_table.obj_Matrial, consumeList, nil, nil, true, {textColorType = 4, showNow = true})
            )
        else
            self.resConsume:RestRs(consumeList)
        end
    else
        self.go_table.obj_Matrial:SetActiveE(0)
    end
end

---显示消耗
function SpiritualDevelop_UpLevelView:ShowConsume()
    local curLevel = self.SpiritualData:GetLevel()
    local upLevel = LevelUpTen
    if upLevel + curLevel > self.curMaxLevel and LevelUpTen + curLevel >= self.curMaxLevel then
        upLevel = self.curMaxLevel - curLevel
    end

    ---计算升级所需要的资源是否足够
    local consumeResList
    local lastConsumeResList
    local canUpLevel = 0
    local enoughRes = true
    local StorageManager = _G.StorageManager:GetInstance()
    for i = curLevel + 1, curLevel + upLevel do
        consumeResList = self:GetConsume(i - curLevel, curLevel, i)
        for _, v in pairs(consumeResList) do
            if v[2] > 0 and not StorageManager:CheckItem(v[1], v[2]) then
                enoughRes = false
                break
            end
        end
        if not enoughRes then
            if not lastConsumeResList then
                lastConsumeResList = consumeResList
            end
           break 
        else
            canUpLevel = canUpLevel + 1
            lastConsumeResList = consumeResList
        end
    end
    self.upLevel = canUpLevel > 0 and canUpLevel or 1
    self.consumeResList = lastConsumeResList
    self:ShowConsumItem(self.consumeResList)
end

---升10级的消耗
function SpiritualDevelop_UpLevelView:ShowTenLevelConsume(upLevel)
    local curLevel = self.SpiritualData:GetLevel()
    local nextLevel = curLevel + upLevel
    if nextLevel > self.maxLevel then
        nextLevel = self.maxLevel
    end
    return self:GetConsume(upLevel, curLevel, nextLevel)
end

---计算消耗
function SpiritualDevelop_UpLevelView:GetConsume(upLevel, curLevel, nextLevel)
    local order = self.SpiritualData:GetOrder()
    ---@field cfg artifact_level_cfg
    local cfg = _G.ConfigManager.spiritual_level_cfg[nextLevel]
    local curCfg = _G.ConfigManager.spiritual_level_cfg[curLevel]
    local consumeResList = _G.DeepCopyCfgTable(cfg["material_" .. order])
    if upLevel > 0 then
        for _, v in pairs(consumeResList) do
            for _, v2 in pairs(curCfg["material_" .. order]) do
                if v2[1] == v[1] then
                    v[2] = v[2] - v2[2]
                    break
                end
            end
        end
    end
    --计算公会金币减少消耗特权加成
    for _, v in ipairs(consumeResList) do
        if v[1] == _G.ResPropID.Coin then
            local num = v[2]
            local goldReduce = require("SociatyModel"):GetInstance():GetBuildSpiritualGoldReduce()
            if goldReduce > 0 then
                num = _G.math.floor(num * (1 - goldReduce))
                v[2] = num
                break
            end
        end
    end
    return consumeResList
end

---显示按钮
function SpiritualDevelop_UpLevelView:ShowBtn()
    if self.SpiritualData:GetLevel() == self.curMaxLevel then
        self.go_table.aorbtn_up:SetActiveE(0)
        self.go_table.aorbtn_onekeyUp:SetActiveE(0)
        if self.curMaxLevel >= self.maxLevel then
            self.go_table.aortext_tips.text = ""
            self.go_table.obj_max:SetActiveE(1)
        else
            self.go_table.obj_max:SetActiveE(0)
            self.go_table.aortext_tips.text = GetLangPackValue(90030900015)
        end
    else
        self.go_table.aorbtn_up:SetActiveE(0)
        --ZHJH-4692 只保留强化1次的按钮
        self.go_table.aorbtn_onekeyUp:SetActiveE(1)
        self:SetUpLevelButton()
        self.go_table.obj_max:SetActiveE(0)
        self.go_table.aortext_tips.text = ""
    end
end

---按钮红点
function SpiritualDevelop_UpLevelView:UpdateRedPoint()
    --检查是否是上阵
    local uidLis = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.AFKOnly)
    if not uidLis or not _G.table.ContainsValue(uidLis, self.SpiritualData.cardUid) then
        self.go_table.obj_redPointImage:SetActiveE(0)
        self.go_table.obj_redPointImage2:SetActiveE(0)
    else
        local canClickUp = require("SpiritualModel"):GetInstance():CanLevelUp(self.SpiritualData)
        self.go_table.obj_redPointImage:SetActiveE((canClickUp and CardInfoManager.IsShowEquipCultivate(self.SpiritualData.cardUid)) and 1 or 0)
        self.go_table.obj_redPointImage2:SetActiveE((canClickUp and CardInfoManager.IsShowEquipCultivate(self.SpiritualData.cardUid)) and 1 or 0)
    end
end

---升多级的显示
function SpiritualDevelop_UpLevelView:SetUpLevelButton()
    self.go_table.aortext_ten.text = _G.GetLangPackValue(91307420705, self.upLevel)
end

function SpiritualDevelop_UpLevelView:OnUpLevel()
    local StorageManager = _G.StorageManager:GetInstance()
    for _, v in pairs(self.consumeResList) do
        if v[2] > 0 and not StorageManager:CheckItemNew(v[1], v[2], function()
            self:ShowConsume()
        end)
        then
            return
        end
    end
    if self.SpiritualData:GetLevel() >= self.curMaxLevel then
        return
    end
    self:SendLevelUpMsg(self.upLevel)
end

---一键升级
function SpiritualDevelop_UpLevelView:OnKeyUpLevel()
    local StorageManager = _G.StorageManager:GetInstance()
    for _, v in pairs(self.consumeResList) do
        if not StorageManager:CheckItemNew(v[1], v[2]) then
            return
        end
    end
    self:SendLevelUpMsg(self.upLevel)
end

function SpiritualDevelop_UpLevelView:SendLevelUpMsg(upLevel)
    local StorageManager = _G.StorageManager:GetInstance()
    self.isUpLeveling = true
    local cardUid = 0
    if self.SpiritualData.cardUid then
        cardUid = self.SpiritualData.cardUid
    end
    local msgData = self.SpiritualData:GetMsg()
    msgData.cardUid = self.SpiritualData.cardUid
    local data = _G.SpiritualData.New()
    data:ParseInitMsg(msgData)
    --如果此灵契是最后一件且未强化, 强化时SpiritualStorage:ChangeCount(-1)将会销毁并删除此SpiritualData实例, 导致SpiritualData状态清空, 所以提前拷贝
    local isUnstack = self.SpiritualData.uid ~= self.SpiritualData.sid
    if not isUnstack then
        self.SpiritualData = data
    end
    require "SpiritualModel":GetInstance():LevelUp(
        self.SpiritualData,
        cardUid,
        upLevel,
        self.SpiritualData.uid ~= self.SpiritualData.sid,
        function(msg)
            local count = 0
            for _, v in ipairs(self.consumeResList) do
                if v[2] > 0 then
                    count = count + 1
                end
            end
            --ZHJH-7204【饰品】强化可堆叠饰品有报错，等级未刷新
            --堆叠的紫色饰品在升级时会拆分(不堆叠), 需先执行更新父页面SpiritualDevelopView的数据, 然后再进行ConsumeItem消耗材料(ConsumeItem消耗会通知父页面SpiritualDevelopView更新红点状态)
            if self.oldLoadCompleted and count > 1 then
                self.oldLoadCompleted = false
                if msg.uid then
                    self.SpiritualData = StorageManager:GetDatasByUid(_G.StorageID.Spiritual, msg.uid)
                end
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.DecorationUpView.Name,
                    data,
                    self.SpiritualData,
                    3,
                    function()
                        self.oldLoadCompleted = true
                    end,
                    true
                )
                if self.cardData then
                    require "CardInfoManager":GetInstance():Updata_CardViewUpdataFun(self.cardData, true)
                    local curPower = self.cardData.power
                    if self.lastPower < curPower then
                        require "CommonTipManager".OpenPowerUpView(self.lastPower, curPower - self.lastPower)
                    end
                    self.lastPower = curPower
                end
                if self.call then
                    if self.cardData then
                        self.call(self.SpiritualData, self.cardData, self.lastPower)
                    else
                        self.call(self.SpiritualData)
                    end
                end
            end
            --消耗材料
            for _, v in ipairs(self.consumeResList) do
                if v[2] > 0 then
                    StorageManager:ConsumeItem(v[1], nil, v[2])
                end
            end

            self.playEff = true
            self:Init()
            self.isUpLeveling = false
        end
    )
end

---显示属性
function SpiritualDevelop_UpLevelView:ShowProp()
    if not self.propList then
        self.lvTb = GetAutoGoTable(self.go_table.obj_Prop)
        self.lvTb.aorimage_arrow1:SetActiveE(1)
        self.lvTb.aorimage_arrow2:SetActiveE(0)
        self.propList = {}
        for _, v in pairs(_G.AttrType) do
            if v.proptype == 1 then
                _G.table.insert(self.propList, { type = v })
            end
        end
        _G.table.sort(
                self.propList,
                function(a, b)
                    return a.type.sortid < b.type.sortid
                end
        )
        local parent = self.go_table.obj_Prop:GetParent()
        for i = 1, #self.propList do
            local obj = _G.InstantiateObject(self.go_table.obj_Prop, parent)
            self.propList[i].tb = GetAutoGoTable(obj)
            --if i % 2 == 0 then
            --    self.propList[i].tb.aorimage_di:SetActiveE(0)
            --else
            --    self.propList[i].tb.aorimage_di:SetActiveE(1)
            --end
            self.propList[i].tb.aorimage_arrow1:SetActiveE(0)
            self.propList[i].tb.aorimage_arrow2:SetActiveE(1)
            self.propList[i].tb.aortext_propName.text = self.propList[i].type.des
        end
    end
    local lv = self.SpiritualData:GetLevel()
    local isMax = lv == self.maxLevel
    local next = isMax and lv or self.upLevel + self.SpiritualData:GetLevel()
    local Attribute = self.SpiritualData:GetAttribute()
    local NextAttribute = self.SpiritualData:GetBaseAttr(nil, next)
    self.lvTb.aortext_curValue.text = lv
    self.lvTb.aortext_nextValue.text = isMax and _G.GetLangPackValue(9002050021) or next
    self.PropEff = {}
    for i = 1, #self.propList do
        local data = self.propList[i]
        local tb = data.tb
        tb.aortext_curValue.text = _G.GameUtil.FormatNum(_G.Mathf.RoundToInt(Attribute:GetValueByName(data.type.key)))
        tb.aortext_nextValue.text = isMax and _G.GetLangPackValue(9002050021) or
                _G.GameUtil.FormatNum(_G.Mathf.RoundToInt(NextAttribute:GetValueByName(data.type.key)))
        if self.playEff then
            if self.PropEff[i] then
                _G.PoolsManager:GetInstance():Despawn(self.PropEff[i].gameObject, _G.ePoolType.UIEffect)
            end
            --ZHJH-4478 取消调用指定特效
            --_G.UIUtils.LoadEffectByCfg(
            --        _G.ConfigManager.ui_effect_cfg.ef_ListLevUp,
            --        tb.gameObject,
            --        function(tran)
            --            self.PropEff[i] = tran
            --        end,
            --        function()
            --        end
            --)
        end
    end
    self.playEff = false
end

function SpiritualDevelop_UpLevelView:OnDisPose()
    self:RemoveListener(_G.eItemUpdata.Updata, self.ShowConsume, self)
end

---按钮点击事件在这里派发
function SpiritualDevelop_UpLevelView:OnClickBtn(go)
    if go == self.go_table.aorbtn_up then
        if not self.isUpLeveling then
            self:OnUpLevel()
        end
    elseif go == self.go_table.aorbtn_onekeyUp then
        if not self.isUpLeveling then
            self:OnKeyUpLevel()
        end
    end
end

return SpiritualDevelop_UpLevelView
