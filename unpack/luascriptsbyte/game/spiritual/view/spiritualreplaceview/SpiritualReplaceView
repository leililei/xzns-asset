local ItemSpiritualBase = require("ItemSpiritualBase")
local SpiritualModel = require("SpiritualModel"):GetInstance()

---@class SpiritualReplaceView : UIBaseView
local SpiritualReplaceView = _G.BaseClass("SpiritualReplaceView", _G.UIBaseView)
local StorageManager = _G.StorageManager:GetInstance()

---新增按品质分类
local SpiritualQuality = {
    Purple = 1,
    Orange = 2,
    Red = 3,
    Colour = 4,
    All = 5
}

---标题颜色
local TitleColor = {
    "<color=#5D329D>%s</color>",
    "<color=#C95F00>%s</color>",
    "<color=#B23939>%s</color>",
    "<color=#b381ff>%s</color>"
}

function SpiritualReplaceView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.scrollloopvectical_item:InitItemData(0, _G.handler(self, self.OnItemRenderer))
    self.go_Btns = _G.GetAutoGoTable(self.go_table.obj_btns)
end

function SpiritualReplaceView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_anyclose then
        self:Close()
        return
    end

    local name = go:GetName()
    if name == "$_obj_btn5" then
        self:SetBtnInfo(SpiritualQuality.All)
    elseif name == "$_obj_btn4" then
        self:SetBtnInfo(SpiritualQuality.Colour)
    elseif name == "$_obj_btn3" then
        self:SetBtnInfo(SpiritualQuality.Red)
    elseif name == "$_obj_btn2" then
        self:SetBtnInfo(SpiritualQuality.Orange)
    elseif name == "$_obj_btn1" then
        self:SetBtnInfo(SpiritualQuality.Purple)
    end
end

---@field spiritualData SpiritualData 当前替换的灵契数据类
---@field index number 展示位索引
---@field callback function 回调函数
---@field cardData CardData 卡牌数据
function SpiritualReplaceView:OnCreate(index, spiritualData, callback, cardData)
    self.index = index
    self.spiritualData = spiritualData
    self.callback = callback
    self.cardData = cardData
    self.selectIndex = 1
    self.SpiritualDataList = StorageManager:GetDataByID(_G.StorageID.Spiritual)
    if _G.table.isEmptyOrNil(self.SpiritualDataList) then
        self.go_table.obj_null:SetActiveE(1)
        self.go_table.obj_info:SetActiveE(0)
        return
    end
    self.go_table.obj_info:SetActiveE(1)
    self.go_table.obj_null:SetActiveE(0)
    self:GetCurSpiritualProp()
    self:InitData()
    self:RefreshView()
    self:SetBtnInfo(5)
end

---灵契属性
function SpiritualReplaceView:GetCurSpiritualProp()
    self.curSpiritualProp = {
        ["atk"] = 0,
        ["bre"] = 0,
        ["def"] = 0,
        ["max_hp"] = 0
    }
    if not self.spiritualData then
        return
    end

    if self.spiritualData.attribute then
        local prop = self.spiritualData.attribute:GetAttrByName()
        for key, v in pairs(prop) do
            self.curSpiritualProp[key] = v
        end
    end
end

---初始化数据
function SpiritualReplaceView:InitData(selectUid)
    if _G.table.isEmptyOrNil(self.SpiritualDataList) then
        return
    end
    ---替换界面不堆叠灵契
    self.allSpiritualData = {}
    local index = 1
    for _, v in pairs(self.SpiritualDataList) do
        if v.count > 1 then
            for i = 1, v.count do
                _G.table.insert(self.allSpiritualData, { index = index, data = v })
                index = index + 1
            end
        else
            _G.table.insert(self.allSpiritualData, { index = index, data = v })
            if selectUid then
                if v.uid == selectUid then
                    self.selectIndex = index
                end
            elseif self.spiritualData and v.cardUid > 0 and self.spiritualData.uid == v.uid then
                self.selectIndex = index
            end
            index = index + 1
        end
    end

    if self.cachedCareerList then
        return
    end
    -- 不同quelity品质物品分类
    self.careerList = {
        [SpiritualQuality.Purple] = {},
        [SpiritualQuality.Orange] = {},
        [SpiritualQuality.Red] = {},
        [SpiritualQuality.Colour] = {},
        [SpiritualQuality.All] = {},
    }
    for _, v in pairs(self.allSpiritualData) do
        _G.table.insert(self.careerList[v.data.cfg.Order], v)
    end
    self.careerList[SpiritualQuality.All] = self.allSpiritualData
    self.cachedCareerList = true
end

--- 切换品质按钮
function SpiritualReplaceView:SetBtnInfo(index)
    if self.selectBtnIndex == index then
        return
    end
    self.selectBtnIndex = index

    if not self.BtnsDic then
        self.BtnsDic = {}
    end
    -- 更新按钮的选中状态
    for _, i in pairs(SpiritualQuality) do
        if not self.BtnsDic[i] then
            self.BtnsDic[i] = _G.GetAutoGoTable(self.go_Btns[string.format("obj_btn%d", i)],
                _G.handler(self, self.OnClickBtn))
        end

        self.BtnsDic[i].aorimage_select:SetActiveE(self.selectBtnIndex == i and 1 or 0)
    end

    if self.selectBtnIndex ~= self.lastSelectBtnIndex then
        self.lastSelectBtnIndex = self.selectBtnIndex
        -- 分类切换时进行过滤和排序
        self.curList = self.careerList[self.selectBtnIndex] or {}
        _G.SortList(
            self.curList,
            function(a)
                local order = 2
                local data = a.data
                if data.cardUid and data.cardUid > 0 then
                    if data.cardUid == self.cardData.uid then
                        order = 1
                    else
                        order = 0
                    end
                end
                return order, data:GetPower(), data:GetOrder(), data:GetStar(), data:GetLevel(), data.sid
            end
        )
        self:CheckData()
        local itemCount = #self.curList
        self.go_table.scrollloopvectical_item:UpdateCount(itemCount)
    end
end

---刷新界面
function SpiritualReplaceView:RefreshView()
    self:RefreshLSpiritualInfo()
end

---刷新展示信息,左边被替换灵契
function SpiritualReplaceView:RefreshLSpiritualInfo()
    if not self.spiritualData then
        self.go_table.obj_leftPropContent:SetActiveE(0)
        self.go_table.aortext_leftNotSelect.gameObject:SetActiveE(1)
    else
        self.go_table.aortext_lname.text = _G.string.format(TitleColor[self.spiritualData:GetOrder()],
            self.spiritualData:GetName())
        self.go_table.aortext_lpower.text = self.spiritualData:GetPower() --_G.LangUtil.GetLangPackValue(90000000404, self.spiritualData:GetPower())
        local maxLevel = _G.ConfigManager.spiritual_star_cfg[self.spiritualData.star + 100].level_limit
        self.go_table.aortext_llevel.text = _G.GetLangPackValue(90000011072, self.spiritualData:GetLevel(), maxLevel)

        if self.go_table.obj_Spiritual:GetChildCountE() == 0 then
            _G.ItemFactory:GetInstance():GetItemCard(
                _G.ItemFactory.itemType.ItemSpiritualBase,
                self.go_table.obj_Spiritual,
                function(item)
                    if self:IsNil() then
                        _G.ItemFactory:GetInstance():SetItemCard(item)
                        return
                    end
                    self.spiritualItem = item
                    item:ShowData(self.spiritualData)
                    item:SetSize(100)
                end
            )
        else
            if self.spiritualItem then
                self.spiritualItem:ShowData(self.spiritualData)
            end
        end
    end
end

---获取基本技能描述
function SpiritualReplaceView:GetSkillDes(index, id)
    local card_skills_cfg = _G.ConfigManager.card_skills_cfg
    if card_skills_cfg[id] then
        return _G.GetLangPackValue(90022300084, index, _G.GetLangPackValue(card_skills_cfg[id].describe1))
    else
        return _G.GetLangPackValue(90022300084, index, id)
    end
end

---检测当前选中的灵契是否是自己的
function SpiritualReplaceView:CheckIsOwn(spiritualData)
    local spiritualBar = self.cardData.SpiritualBar or {}
    for _, v in pairs(spiritualBar) do
        if v.sid == spiritualData.sid and spiritualData.cardUid > 0 and spiritualData.cardUid == self.cardData.uid then
            return true
        end
    end

    return false
end

---同一个英雄已经穿戴了的饰品，在其他槽位中不显示该饰品
---@protected
function SpiritualReplaceView:CheckData()
    local list = {}
    for i, v in ipairs(self.curList) do
        local add = true
        local spiritualData = v.data
        local cardUid = spiritualData.cardUid
        if cardUid and cardUid == 0 then
            -- 同一个sid的圣物只能穿一件
            if self.cardData.SpiritualBar then
                for _, v in pairs(self.cardData.SpiritualBar) do
                    if v.sid == spiritualData.sid and self.index ~= v.index then
                        add = false
                        break
                    end
                end
            end
        end
        if add == true then
            _G.table.insert(list, v)
        end
    end
    self.curList = list
end

---渲染item
function SpiritualReplaceView:OnItemRenderer(index, obj)
    local data = self.curList[index + 1]
    local spiritualData = data.data
    local tb = _G.GetAutoGoTable(obj)
    tb.aortext_name.text = _G.GetLangPackValue(_G.ConfigManager.spiritual_cfg[spiritualData.sid].Name)
    tb.aortext_power.text = _G.GetLangPackValue(90025700007, spiritualData:GetPower())
    local carduid = spiritualData.cardUid
    --已被穿戴
    tb.obj_Role:RemoveAllChildren()
    local isCard = carduid ~= 0
    if isCard then
        local carddata = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, carduid)
        if carddata ~= nil then
            carddata.isHave = true
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.HeadItem_Select,
                tb.obj_Role,
                function(view)
                    if self:IsNil() then
                        return
                    end
                    view.gameObject:SetLocalScaleXYZ(0.82)
                    view.transform:SetLocalPositionToZero()
                    view:ShowCardData(carddata)
                end
            )
        end
        if self:CheckIsOwn(spiritualData) then
            tb.aortext_replace.text = _G.LangUtil.GetLangPackValue(90030900050)
        else
            tb.aortext_replace.text = _G.LangUtil.GetLangPackValue(90020400047)
        end
    else
        tb.aortext_replace.text = _G.LangUtil.GetLangPackValue(90023400020)
    end

    tb.aortext_wear:SetActiveE(isCard and 1 or 0)
    tb.aorbtn_replace.onClick:RemoveAllListeners()
    tb.aorbtn_replace.onClick:AddListener(_G.handlerbind(self, self.OnClick_Replace, spiritualData))

    if tb.obj_Spiritual:GetChildCountE() == 0 then
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemSpiritualBase,
            tb.obj_Spiritual,
            function(item)
                item:ShowData(spiritualData)
                item:SetSize(79)
            end
        )
    else
        if tb.lua == nil then
            tb.lua = ItemSpiritualBase.New(tb.obj_Spiritual:GetChildE())
        end
        tb.lua:ShowData(spiritualData)
        tb.lua:SetSize(79)
    end
    local showSelect = self.selectIndex == data.index
    if showSelect then
        self.selectRealIndex = index
    end
end

---新的更换物品的处理
function SpiritualReplaceView:OnClick_Replace(spiritualData)
    -- 执行替换操作
    local cardUid = spiritualData.cardUid
    if cardUid and cardUid > 0 and self.cardData.uid == cardUid then
        SpiritualModel:TakeOffSpiritual(self.cardData, spiritualData, spiritualData.index,
            function()
                self:Close()
            end)
    else
        -- 同一个sid的圣物只能穿一件
        if self.cardData.SpiritualBar then
            for _, v in pairs(self.cardData.SpiritualBar) do
                if v.sid == spiritualData.sid and self.index ~= v.index then
                    _G.PopWindowManager:GetInstance():ShowAllTips(920112) -- 错误提示：不能穿相同的灵契
                    return
                end
            end
        end

        if cardUid and cardUid > 0 then
            -- 先脱再穿
            local spiritualUid = spiritualData.uid
            local cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, cardUid)
            SpiritualModel:TakeOffSpiritual(cardData, spiritualData, spiritualData.index,
                function()
                    spiritualData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Spiritual,
                        spiritualUid)
                    self:PutOnSpiritual(spiritualData)
                end)
        else
            self:PutOnSpiritual(spiritualData)
        end
    end
end

---穿戴灵契
function SpiritualReplaceView:PutOnSpiritual(spiritualData)
    local msg = {
        {
            index = self.index,
            uid = spiritualData.uid
        }
    }
    SpiritualModel:PutOnSpiritual(self.cardData, msg, self.index, spiritualData, function()
        self:Close()
    end)
end

function SpiritualReplaceView:OnStartClose()
    if self.callback then
        self.callback()
    end
end

function SpiritualReplaceView:Dispose()
end

return SpiritualReplaceView
