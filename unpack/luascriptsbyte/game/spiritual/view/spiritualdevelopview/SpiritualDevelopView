local CardInfoManager = require "CardInfoManager"

---@class SpiritualDevelopView : UIBaseView    中文描述
---@field public go_table SpiritualDevelopView_GoTable GoTable
local SpiritualDevelopView = _G.BaseClass("SpiritualDevelopView", _G.UIBaseView)

local PrefabPath = {
    upLevel = "UIH5/Spiritual/SpiritualDevelop_UpLevelView",
    upStar = "UIH5/Spiritual/SpiritualDevelop_UpStarView"
}

---品质特效
---品阶（1-紫；2-橙；2-红；3-彩）
local bakEffectPath = {
    [1] = "UI/UI_effect/ArtifactDevelopView_effect/ef_ArtifactDevelopView_zi",
    [2] = "UI/UI_effect/ArtifactDevelopView_effect/ef_ArtifactDevelopView_cheng",
    [3] = "UI/UI_effect/ArtifactDevelopView_effect/ef_ArtifactDevelopView_hong",
    [4] = "UI/UI_effect/ArtifactDevelopView_effect/ef_ArtifactDevelopView_cai"
}

---页签类型
local ToggleType = {
    UpLevel = 1,
    UpStar = 2
}

function SpiritualDevelopView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function SpiritualDevelopView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_anyClose then
        self:Close()
    elseif go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_reset then
        if self.SpiritualData:GetLevel() <= 1 and self.SpiritualData:GetStar() <= 0 then
            ---未升级或升星不可重置
            _G.PopWindowManager:GetInstance():ShowAllTips(280110)
        else
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.ResetLevelView.Name,
                self.SpiritualData,
                function()
                    if self:IsNil() then
                        return
                    end
                    if self.curToggle == ToggleType.UpLevel then
                        self:OnUpLevel(true)
                    elseif self.curToggle == ToggleType.UpStar then
                        self:OnUpStar(true)
                    end
                end
            )
        end
    elseif go == self.go_table.aorbtn_pre then
        if self.CurSpiritual.pre then
            self.SpiritualData = self.CurSpiritual.pre
            self:ChangeSpiritual()
        end
    elseif go == self.go_table.aorbtn_next then
        if self.CurSpiritual.next then
            self.SpiritualData = self.CurSpiritual.next
            self:ChangeSpiritual()
        end
    elseif go == self.go_table.aorbtn_bag then
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnOpenUI, self)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BagNewView.Name, 3)
    end
end

---@field SpiritualData SpiritualData 灵契数据
---@field callback function 回调函数
function SpiritualDevelopView:OnCreate(SpiritualData, callback, cardData, lastPower, lua)
    self.SpiritualData = SpiritualData
    self.callback = callback
    self.cardData = cardData
    self.lastPower = lastPower
    self.lua = lua
    self.curToggle = ToggleType.UpLevel
    self:InitToggle()
    self.go_table.toggle_upLevel.isOn = false
    self.go_table.toggle_upLevel.isOn = true
    self:RefreshView()
    self:UpdateSpiritualRedPoint()
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.UpdateSpiritualRedPoint, self)
    self:InitBtn()
end

function SpiritualDevelopView:OnOpenUI(name)
    if name == _G.ConfigManager.ui_cfg.BagNewView.Name then
        self:RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnOpenUI, self)
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.BagNewView.Name)
        view:OnClickToggle(nil, true, 3)
        _G.DelayDo(0.1, function()
            view.go_table.toggle_spiritual.isOn = true
            view:OnClickEquipToggle(nil, true, 5)
        end)
        view.go_table.toggle_equipment.isOn = true
    end
end

function SpiritualDevelopView:OnDestroy()
    self:RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnOpenUI, self)
end

---显示界面
function SpiritualDevelopView:RefreshView()
    self.go_table.aorrawimage_icon:LoadImage(
            self.SpiritualData.cfg.image_1,
            function(raw)
                if raw then
                    raw:SetActiveE(1)
                end
            end
    )
    if self.SpiritualData.cfg.Order + 3 >= 7 then
        self.go_table.aortext_name:SetActiveE(0)
        self.go_table.aortext_ChromaName:SetActiveE(1)
        self.go_table.aortext_ChromaName.text = _G.ConfigManager.language_package_cfg[self.SpiritualData.cfg.Name]
    else
        self.go_table.aortext_name:SetActiveE(1)
        self.go_table.aortext_ChromaName:SetActiveE(0)
        local color = _G.GameUtil.GetColorByQuality(self.SpiritualData.cfg.Order + 3)
        self.go_table.aortext_name.text = _G.ConfigManager.language_package_cfg[self.SpiritualData.cfg.Name]
        self.go_table.aortext_name.color = color
    end
    --self:PlayAnim()
    --self:InitEffect()
end

---播放动画
function SpiritualDevelopView:PlayAnim()
    local Tweening = _G.CS.DG.Tweening
    self.tweer = self.go_table.trans_icon:DOLocalMoveY(20, 2):SetEase(Tweening.Ease.InOutSine):SetLoops(
            -1,
            Tweening.LoopType.Yoyo
    )
end

---初始化特效
function SpiritualDevelopView:InitEffect()
    for _, v in pairs(self.SpiritualData.cfg.effect) do
        _G.UIUtils.LoadEffectByPath(
                v[2],
                self.go_table["trans_effect" .. v[1]],
                function(obj)
                    if _G.IsNil(self.go_table) then
                        _G.DestroyObject(obj)
                        return
                    end
                    obj:SetLocalPosition(v[3], v[4], v[5])
                    obj:SetLocalScaleXYZ(v[6])
                end,
                nil,
                nil,
                nil,
                nil,
                nil,
                true
        )
    end

    ---品质特效
    local quality = self.SpiritualData.cfg.Order
    _G.UIUtils.LoadEffectByPath(
            bakEffectPath[quality],
            self.go_table["obj_effect_bak"],
            function(obj)
                if _G.IsNil(self.go_table) then
                    _G.DestroyObject(obj)
                    return
                end
            end,
            nil,
            nil,
            nil,
            nil,
            nil,
            true
    )
end

function SpiritualDevelopView:InitBtn()
    local data = self.cardData
    local cur = -1
    self.SpiritualBar = {}
    for k, v in pairs(data.SpiritualBar) do
        if v then
            local spiritual = v
            spiritual.index = k
            if #self.SpiritualBar > 0 then
                spiritual.pre = self.SpiritualBar[#self.SpiritualBar]
            end
            _G.table.insert(self.SpiritualBar, spiritual)
            if v.cfg.Name == self.SpiritualData.cfg.Name then
                cur = #self.SpiritualBar
            end
        end
    end
    local amount = #self.SpiritualBar
    for i = 1, amount do
        if i + 1 <= amount then
            self.SpiritualBar[i].next = self.SpiritualBar[i + 1]
        end
    end
    self.SpiritualBar[1].pre = self.SpiritualBar[amount]
    self.SpiritualBar[amount].next = self.SpiritualBar[1]
    if cur > 0 and cur <= amount and self.SpiritualBar[cur] then
        self.CurSpiritual = self.SpiritualBar[cur]
    end
    self.go_table.aorbtn_pre:SetActiveE(amount > 1 and 1 or 0)
    self.go_table.aorbtn_next:SetActiveE(amount > 1 and 1 or 0)
end

---升级
function SpiritualDevelopView:OnUpLevel(isOn)
    if self.upLevelView then
        self.upLevelView.gameObject:SetActiveE(isOn and 1 or 0)
    end
    if not isOn then
        return
    end
    self.curToggle = ToggleType.UpLevel
    if not self.upLevelView then
        _G.PoolsManager:GetInstance():Spawn(
                PrefabPath.upLevel,
                _G.ePoolType.Temporary,
                self.go_table.trans_view,
                function(obj)
                    self.upLevelView = self:AddComponent(obj, require "SpiritualDevelop_UpLevelView".New())
                    self.upLevelView:Init(
                            self.SpiritualData,
                            _G.handler(self, self.UpdateSpiritualData),
                            self.cardData,
                            self.lastPower
                    )
                end
        )
    else
        self.upLevelView:Init(
                self.SpiritualData,
                _G.handler(self, self.UpdateSpiritualData),
                self.cardData,
                self.lastPower
        )
    end
end

function SpiritualDevelopView:ChangeSpiritual()
    self:RefreshView()
    if self.curToggle == ToggleType.UpLevel then
        self:OnUpLevel(true)
    else
        self:OnUpStar(true)
    end
    self:InitBtn()
end

---升星
function SpiritualDevelopView:OnUpStar(isOn)
    if self.upStarView then
        self.upStarView.gameObject:SetActiveE(isOn and 1 or 0)
    end
    if not isOn then
        return
    end
    self.curToggle = ToggleType.UpStar
    if not self.upStarView then
        _G.PoolsManager:GetInstance():Spawn(
                PrefabPath.upStar,
                _G.ePoolType.Temporary,
                self.go_table.trans_view,
                function(obj)
                    self.upStarView = self:AddComponent(obj, require "SpiritualDevelop_UpStarView".New())
                    self.upStarView:Init(
                            self.SpiritualData,
                            _G.handler(self, self.UpdateSpiritualData),
                            self.cardData,
                            self.lastPower
                    )
                end
        )
    else
        self.upStarView:Init(
                self.SpiritualData,
                _G.handler(self, self.UpdateSpiritualData),
                self.cardData,
                self.lastPower
        )
    end
end

---刷新主界面的灵契对象
---@param SpiritualData SpiritualData
function SpiritualDevelopView:UpdateSpiritualData(SpiritualData, cardData, lastPower)
    self.SpiritualData = SpiritualData
    self.cardData = cardData
    self.lastPower = lastPower
    self:UpdateSpiritualRedPoint()
    if self.upLevelView then
        self.upLevelView.SpiritualData = SpiritualData
    end
    if self.upStarView then
        self.upStarView.SpiritualData = SpiritualData
    end
end

---刷新页签红点
function SpiritualDevelopView:UpdateSpiritualRedPoint()
    --检查是否是上阵
    local uidLis = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.AFKOnly)
    if not uidLis or not _G.table.ContainsValue(uidLis, self.SpiritualData.cardUid) then
        self.go_table.obj_redPointImage1:SetActiveE(0)
        self.go_table.obj_redPointImage2:SetActiveE(0)
    else
        local canClickUp = require("SpiritualModel"):GetInstance():CanLevelUp(self.SpiritualData)
        self.go_table.obj_redPointImage1:SetActiveE((canClickUp and CardInfoManager.IsShowEquipCultivate(self.SpiritualData.cardUid)) and 1 or 0)
        local isEnough = require("SpiritualModel"):GetInstance():IsEnoughStarUpMaterial(self.SpiritualData)
        self.go_table.obj_redPointImage2:SetActiveE((isEnough and CardInfoManager.IsShowEquipCultivate(self.SpiritualData.cardUid)) and 1 or 0)
    end
end

function SpiritualDevelopView:InitToggle()
    self.toggles = {
        upLevel = _G.GetAutoGoTable(
                self.go_table.toggle_upLevel,
                _G.handlerbind(self, self.OnClickToggle, "upLevel", _G.handler(self, self.OnUpLevel))
        ),
        upStar = _G.GetAutoGoTable(
                self.go_table.toggle_upStar,
                _G.handlerbind(self, self.OnClickToggle, "upStar", _G.handler(self, self.OnUpStar))
        )
    }
end

---点击选项卡
---@return void
function SpiritualDevelopView:OnClickToggle(_, isOn, key, call)
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if call then
        call(isOn)
    end
end

function SpiritualDevelopView:OnStartClose()
    if self.callback then
        self.callback(self.cardData, self.lastPower)
    end
    if self.tweer then
        self.tweer:Kill()
        self.tweer = nil
    end
end

function SpiritualDevelopView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.UpdateSpiritualRedPoint, self)
end

return SpiritualDevelopView