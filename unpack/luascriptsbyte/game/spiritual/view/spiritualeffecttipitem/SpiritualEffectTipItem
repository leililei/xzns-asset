---@class SpiritualEffectTipItem	中文描述
local SpiritualEffectTipItem = _G.BaseClass("SpiritualEffectTipItem")

local card_skills_cfg = _G.ConfigManager.card_skills_cfg

---类的构造函数
function SpiritualEffectTipItem:__init()
end

---设置参数
---@param dData table
---@param tran transform tran
function SpiritualEffectTipItem:SetData(dData, isSelf, btn, tran)
    if not dData then
        return
    end
    self.data = dData
    self.go_table = _G.GetAutoGoTable(tran)
    self.rect = self.go_table.obj_RemainsDescribe:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    self:InitBaseData()
end

---初始化基础数据
function SpiritualEffectTipItem:InitBaseData()
    local attribute = {}
    local skillList = {}
    local table = _G.table
    for _, data in pairs(self.data) do
        ---@field data SpiritualData
        if data.attribute then
            local prop = data.attribute:GetAttrByName()
            for key, value in pairs(prop) do
                if not attribute[key] then
                    attribute[key] = value
                else
                    attribute[key] = attribute[key] + value
                end
            end
        end

        local cfg = data:GetCfg()
        if cfg.skill_id then
            local skillId = cfg.skill_id[data:GetStar() + 1]
            local skillDesc = data:GetName() .. "：" .. self:GetSkillDesBase(skillId)
            table.insert(skillList, skillDesc)
        end
    end
    self:InitBaseProp(attribute)
    self:InitSkill(skillList)
end

---基础属性
---@field attribute table 属性列表
function SpiritualEffectTipItem:InitBaseProp(attribute)
    local ChildCount = self.go_table.obj_PropContent:GetChildCountE()
    if ChildCount > 0 then
        for i = 1, ChildCount do
            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_PropContent:GetChildE(i), _G.ePoolType.UIItem)
        end
    end

    local numStr, num, tb, tran, key, showList
    showList = {}
    for i, v in pairs(attribute) do
        if v > 0 then
            _G.table.insert(showList, {key = i, sortId = _G.AttrType[i].sortid})
        end
    end
    _G.SortList(
        showList,
        function(a)
            return -a.sortId
        end
    )
    for _, v in pairs(showList) do
        key = v.key
        tran = _G.InstantiateObject(self.go_table.obj_BaseProp, self.go_table.obj_PropContent)
        if tran then
            tb = _G.GetAutoGoTable(tran)
            tb.aortext_Name.text = _G.AttrType[key].des
            num = attribute[key]
            if _G.AttrType[key].percentage == 1 then
                num = num * 100
                num = _G.GameUtil.FormatNum(num)
                numStr = "<color=#6effc6>" .. num .. "%</color>"
            else
                num = _G.math.floor(num)
                num = _G.GameUtil.NumberWY(num)
                numStr = "<color=#5BDF99>" .. num .. "</color>"
            end
            tb.aortext_Num.text = numStr
        end
    end
end

---显示技能
function SpiritualEffectTipItem:InitSkill(skillList)
    local skillAmount = #skillList
    for i = 1, skillAmount do
        local obj = _G.InstantiateObject(self.go_table.obj_skillItem, self.go_table.trans_content)
        local tb = _G.GetAutoGoTable(obj)
        tb.DesExText = tb.obj_upDes:GetComponentE(_G.typeof(_G.CS.ExtendText))
        if i == skillAmount then
            tb.DesExText.text = skillList[i]
        else
            tb.DesExText.text = skillList[i] .. "\n"
        end
        tb.DesExText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))
    end
end

---点击超链接
function SpiritualEffectTipItem:OnHrefClick(id, name, asa)
    local weight, height = self.rect:GetRectTransformWidthHeight()
    require("CommonTipManager"):GetInstance():OpenSkillHyper(_G.tonumber(id), nil, weight, height)
end

---获取技能描述
function SpiritualEffectTipItem:GetSkillDesBase(id)
    if card_skills_cfg[id] then
        return _G.GetLangPackValue(card_skills_cfg[id].describe1)
    else
        return id
    end
end

return SpiritualEffectTipItem
