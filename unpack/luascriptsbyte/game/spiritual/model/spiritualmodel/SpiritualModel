---灵契升级
---@param spiritualData SpiritualData 灵契
---@param cardUid number 穿戴的卡牌uid,没有穿戴发灵契sid
---@param level number 提升等级
---@param isUnstack boolean 是否独立（不堆叠）
function SpiritualModel:LevelUp(spiritualData, cardUid, level, isUnstack, callback)
    if not isUnstack and not _G.StorageManager:GetInstance():CheckSize(_G.StorageID.Spiritual, 1) then
        _G.PopWindowManager:GetInstance():ShowAllTips(130303)
        return
    end
    local pbData = { equip = { c_uid = cardUid, s_uid = spiritualData.uid }, up_lv = level }
    SpiritualNet:GetInstance():LevelUp(pbData, function(msg)
        if msg.ack ~= 1 then
            return
        end
        if isUnstack then
            spiritualData:UpLevel(spiritualData:GetLevel() + level)
            if spiritualData.cardUid ~= 0 then
                ---@type CardData
                local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, spiritualData.cardUid)
                if not table.isEmptyOrNil(cardData) then
                    cardData:CalcNowSumProp()
                end
            end
        else
            local newMsg = spiritualData.GetMsg(spiritualData)
            newMsg.uid = msg.uid
            newMsg.cardUid = spiritualData.cardUid
            local newData = _G.SpiritualData.New()
            newData:Parse(newMsg)
            newData:UpLevel(newData:GetLevel() + level)
            _G.StorageManager:GetInstance():AddItemBySpiritualData(newData)
            _G.StorageManager:GetInstance():ConsumeSpiritual(spiritualData.uid, 1, spiritualData)
            -- if spiritualData.cardUid > 0 then
            --     _G.StorageManager:GetInstance():TakeOffSpiritual(spiritualData)
            -- end
            if newMsg.cardUid ~= 0 then
                local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, newMsg.cardUid)
                cardData:PutOnSpiritual(newData)
            end
        end
        if callback then
            callback(msg)
        end
    end)
end

function SpiritualModel:GetSameSid(data)
    local num = 0
    local SpiritualDic = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Spiritual)
    for _, v in pairs(SpiritualDic) do
        if v.cfg.id == data.cfg.id then
            num = num + 1
        end
    end
    return num
end

---获取可用于升星的材料
---@param data SpiritualData 升星饰品data
---@param list table[] 已选择饰品
---@param needCount number 需要的材料数量
function SpiritualModel:GetStarUpMaterial(data, list, needCount)
    local SpiritualDic = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Spiritual)
    local SpiritualList = {}
    local SelectList = {}
    local selectedList = {}
    local stackList = {}
    for _, v in pairs(list) do
        --检测堆叠的饰品
        local select = v[3]
        if select and select.sid == select.uid then
            if not stackList[select.uid] then
                stackList[select.uid] = true --记录已经计算的堆叠饰品
                selectedList[v[2]] = true
                for _ = 1, select.count do
                    _G.table.insert(SelectList, v)
                    if #SelectList >= needCount then
                        break
                    end
                end
            end
        else
            _G.table.insert(SelectList, v)
            selectedList[v[2]] = true
        end
    end
    local isNotWear = data.cardUid == 0
    local isUnstack = data.uid ~= data.sid
    local excludeSelf = false
    for _, v in pairs(SpiritualDic) do
        if v.cfg.id == data.cfg.id and not selectedList[v.uid] then
            if v.star == 0 then
                if (v.cardUid ~= 0 and v.cardUid == data.cardUid) or
                        (isNotWear and not excludeSelf and isUnstack and data.uid == v.uid) or
                        (isNotWear and not excludeSelf and not isUnstack and v.uid == v.sid)
                then
                    if isNotWear then
                        excludeSelf = true
                        if not isUnstack then
                            for i = 1, v.count - 1 do
                                _G.table.insert(SpiritualList, v)
                            end
                        end
                    end
                else
                    for i = 1, v.count do
                        _G.table.insert(SpiritualList, v)
                    end
                end
            end
        end
    end
    _G.SortList(
            SpiritualList,
            function(a)
                return -a.cardUid, a.star, a.lv
            end
    )
    for k, v in pairs(SpiritualList) do
        if v.cardUid == 0 then
            if #SelectList < needCount then
                _G.table.insert(SelectList, { k, SpiritualList[k].uid, SpiritualList[k] })
            end
        end
    end
    return {
        material = SpiritualList,
        select = SelectList
    }
end

---灵契升星
---@param spiritualData SpiritualData 灵契
---@param cardUid number 穿戴的卡牌uid
---@param items spiritual.i_cs_spiritual 消耗的本体材料
---@param isUnstack boolean 是否独立（不堆叠）
function SpiritualModel:StarUp(spiritualData, cardUid, items, isUnstack, callback)
    if not isUnstack and not _G.StorageManager:GetInstance():CheckSize(_G.StorageID.Spiritual, 1) then
        _G.PopWindowManager:GetInstance():ShowAllTips(130303)
        return
    end

    local pbData = { equip = { c_uid = cardUid, s_uid = spiritualData.uid }, cs_sp = items }
    SpiritualNet:GetInstance():StarUp(pbData, function(msg)
        if msg.ack ~= 1 then
            return
        end
        local order, star
        if isUnstack then
            spiritualData:UpStar()
            if spiritualData.cardUid ~= 0 then
                ---@type CardData
                local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, spiritualData.cardUid)
                if not table.isEmptyOrNil(cardData) then
                    cardData:CalcNowSumProp()
                end
            end
            SpiritualIllustrationModel:GetInstance():ChangeMaxStar(spiritualData.sid, spiritualData:GetStar())
            order = spiritualData.cfg.Order
            star = spiritualData:GetStar()
        else
            local newMsg = spiritualData.GetMsg(spiritualData)
            newMsg.uid = msg.uid
            newMsg.cardUid = spiritualData.cardUid
            local newData = _G.SpiritualData.New()
            newData:Parse(newMsg)
            newData:UpStar()
            _G.StorageManager:GetInstance():AddItemBySpiritualData(newData)
            _G.StorageManager:GetInstance():ConsumeSpiritual(spiritualData.uid, 1, spiritualData)
            if spiritualData.cardUid > 0 then
                _G.StorageManager:GetInstance():TakeOffSpiritual(spiritualData)
            end
            if newMsg.cardUid ~= 0 then
                local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, newMsg.cardUid)
                cardData:PutOnSpiritual(newData)
            end
            SpiritualIllustrationModel:GetInstance():ChangeMaxStar(newData.sid, newData:GetStar())
            order = newData.cfg.Order
            star = newData:GetStar()
        end

        ---同时拥有x个y星的彩色品质的饰品
        if order == 4 then
            _G.Events:GetInstance():Broadcast(
                    _G.ePlayAactionEvent.PlayAaction,
                    {
                        _G.ActiveTaskEnum.ConditionEnum.Spiritual.LevelNum,
                        order,
                        star
                    },
                    1
            )
        end

        if msg.award then
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
        end
        if callback then
            callback(msg)
        end
        RedPointManager:RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.SpiritualPage.id
        )
    end)
end

---灵契分解
---@param uids siritual.i_cs_siritual[] 要分解的灵契列表
function SpiritualModel:Decompose(uids, callback)
    local pbData = { uids = uids }
    SpiritualNet:GetInstance():Decompose(
            pbData,
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                local StorageManager = _G.StorageManager:GetInstance()
                for _, v in pairs(uids) do
                    StorageManager:ConsumeSpiritual(v.uid, v.num)
                end
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                RedPointManager:RefreshNodeByAllParams(
                        _G.ConfigManager.redpoint_cfg.SpiritualPage.id
                )
                if callback then
                    callback(msg)
                end
            end
    )
end

