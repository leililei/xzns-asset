local SpiritualNet = require("SpiritualNet")

---@class SpiritualIllustrationModel: GameDataModelBase
local SpiritualIllustrationModel = _G.BaseClass("SpiritualIllustrationModel", _G.GameDataModelBase)

---@return SpiritualIllustrationModel SpiritualIllustrationModel
function SpiritualIllustrationModel:GetInstance()
    return self.super.GetInstance(self)
end

---灵契品质
---@field Purple number 紫
---@field Orange number 橙
---@field Red number 红
---@field Colour number 彩
local SpiritualQuality = {
    Purple = 1,
    Orange = 2,
    Red = 3,
    Colour = 4,
    All = 5
}

---配置表
local illustration_cfg = _G.ConfigManager.illustrations_spiritual_lv_cfg
local spiritual_cfg = _G.ConfigManager.spiritual_cfg

function SpiritualIllustrationModel:__init()
    self.illLevel = 0
    self.illExp = 0
    self.illAllList = {}
    self.repointID = _G.ConfigManager.redpoint_cfg.SpiritualAtlas.id
end

---@param msg illustrations.s2c_illustrations_info
function SpiritualIllustrationModel:ParseData(msg)
    self.illLevel = msg.level
    self.illExp = msg.exp
    self.needExp = 0
    if illustration_cfg[self.illLevel + 1] then
        self.needExp = illustration_cfg[self.illLevel + 1].exp - illustration_cfg[self.illLevel].exp
    end
    self.obtainedList = {}
    self.careerList = {
        [SpiritualQuality.Purple] = {},
        [SpiritualQuality.Orange] = {},
        [SpiritualQuality.Red] = {},
        [SpiritualQuality.Colour] = {},
        [SpiritualQuality.All] = {},
    }
    local condition
    for _, v in pairs(spiritual_cfg) do
        condition = v.condition_type
        if v.is_show and v.is_show == 1 and (condition == nil or #condition == 0 or _G.GlobalConditionManager.CheckConditionByArray(condition)) then
            local data = {}
            data.sid = v.id
            data.image = v.image_1
            data.name = v.Name
            data.exp = v.exp
            data.max_star = -1
            data.unlock_star = -1
            data.unLock = false
            data.cfg = v
            data.order = v.Order
            data.own = false
            self.illAllList[v.id] = data
        end
    end
    if msg and msg.ill then
        for _, v in pairs(msg.ill) do
            if self.illAllList[v.sid] then
                self.illAllList[v.sid].unLock = v.is_unlock
                self.illAllList[v.sid].max_star = v.max_star
                self.illAllList[v.sid].unlock_star = v.unlock_star
                if v.is_unlock then
                    self.obtainedList[v.sid] = self.illAllList[v.sid]
                end
            end
        end
    end

    for _, v in pairs(self.illAllList) do
        _G.table.insert(self.careerList[v.order], v)
        _G.table.insert(self.careerList[SpiritualQuality.All], v)
    end
    self:RefreshAttr()
end

---获取所有已解锁灵契
function SpiritualIllustrationModel:GetAllUnlockSpiritual()
    return self.obtainedList
end

---所有灵契
function SpiritualIllustrationModel:GetIllustrationList()
    return self.careerList
end

---获取图鉴等级
function SpiritualIllustrationModel:GetIllLevel()
    return self.illLevel
end

---获取图鉴的经验
function SpiritualIllustrationModel:GetIllExp()
    if illustration_cfg[self.illLevel + 1] then
        local needExp = illustration_cfg[self.illLevel + 1].exp - illustration_cfg[self.illLevel].exp
        return self.illExp, needExp
    end

    return 0, 1
end

---获取目标图鉴等级信息
function SpiritualIllustrationModel:GetIllLevelAddition(level)
    return _G.DeepCopy(illustration_cfg[level])
end

---更新属性加成
function SpiritualIllustrationModel:RefreshAttr(upPower)
    local data = illustration_cfg[self.illLevel]
    local attributeManager = _G.AttributeClassManager:GetInstance()
    self.attribute = attributeManager:GetAttribtueClass()
    self.attribute:AddValueByName("atk", data.atk, nil, _G.AttCountType.other)
    self.attribute:AddValueByName("bre", data.bre, nil, _G.AttCountType.other)
    self.attribute:AddValueByName("def", data.def, nil, _G.AttCountType.other)
    self.attribute:AddValueByName("max_hp", data.max_hp, nil, _G.AttCountType.other)
    self.attributeChangeType = attributeManager:GetChangeAttrTypes(self.attribute)
    if upPower then
        local mypower = _G.StorageManager:GetInstance():GetPlayerPower()
        _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.SpiritualIll)
        local offset = _G.StorageManager:GetInstance():GetPlayerPower() - mypower
        if offset > 0 then
            require "CommonTipManager".OpenPowerUpView(mypower, offset)
        end
    end
end

---获取图鉴属性
function SpiritualIllustrationModel:GetillAttr()
    if not self.attribute then
        self:RefreshAttr()
    end
    return self.attribute, self.attributeChangeType
end

---改变灵契最大星级
---@param sid number 灵契sid
---@param newStar number 新的星级
function SpiritualIllustrationModel:ChangeMaxStar(sid, newStar)
    if self.illAllList[sid] then
        local data = self.illAllList[sid]
        data.max_star = data.max_star > newStar and data.max_star or newStar
        self.illAllList[data.sid] = data
        for _, v in pairs(self.careerList[data.order]) do
            if v.sid == data.sid then
                v = data
                break
            end
        end
        require("RedPointManager"):GetInstance():RefreshNode(self.repointID)
    end
end

---解锁灵契图鉴
---@param sids number[] 灵契id列表
function SpiritualIllustrationModel:IllustrationUnlock(sids, callBack)
    local pbData = {sids = sids}
    SpiritualNet:GetInstance():IllustrationUnlock(pbData, function(msg)
        if msg.ack ~= 1 then
            return
        end
        local isAddExp = false
        local exp = 0
        for _, sid in pairs(sids) do
            local data = self.illAllList[sid]
            if not data.unLock then
                data.unLock = true
                exp = exp + (data.exp[data.unlock_star + 1] or 0)
            end
            for i= data.unlock_star + 1, data.max_star do
                local addExp = data.exp[i + 1]
                if addExp and addExp > 0 then
                    exp = exp + addExp
                end
            end
            data.unlock_star = data.max_star
            self.illAllList[sid] = data
        end
        if exp > 0 then
            isAddExp = true
            self:ChangeExp(exp)
        end
        if callBack then
            callBack(isAddExp)
        end
        require("RedPointManager"):GetInstance():RefreshNode(self.repointID)
    end)
end

---更新图鉴经验
function SpiritualIllustrationModel:ChangeExp(exp)
    self.illExp = self.illExp + exp
    local upPower = false
    while(self.illExp >= self.needExp) do
        self.illLevel = self.illLevel + 1
        self.illExp = self.illExp - self.needExp
        self.needExp = illustration_cfg[self.illLevel + 1].exp - illustration_cfg[self.illLevel].exp
        upPower = true
    end
    self:RefreshAttr(upPower)
    return upPower
end

---检测红点
function SpiritualIllustrationModel:RedPointCheck()
    if _G.AppSetting.IsOverseas then
        return 0
    end

    for _, v in pairs(self.illAllList) do
        if (not v.unLock and v.max_star >= 0) or (v.unLock and v.unlock_star < v.max_star) then
            return 1
        end
    end
    return 0
end

---获得灵契
function SpiritualIllustrationModel:GainSpiritual(sid)
    if not self.illAllList then
        self.illAllList = {}
    end
    local data = self.illAllList[sid]
    if data and not data.own then
        data.own = true
        data.max_star = 0
        self.illAllList[data.sid] = data
        for _, v in pairs(self.careerList[data.order]) do
            if v.sid == data.sid then
                v = data
                break
            end
        end
        require("RedPointManager"):GetInstance():RefreshNode(self.repointID)
    end
end

---销毁对象时,析构函数
function SpiritualIllustrationModel:Dispose()
end

return SpiritualIllustrationModel