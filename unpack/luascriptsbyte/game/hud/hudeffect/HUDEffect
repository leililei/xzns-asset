realRequire "BaseHUD"

--region HUDEffect 正文

---@class HUDEffect : BaseHUD 2D特效
local HUDEffect = _G.BaseClass("HUDEffect", _G.BaseHUD)
local typeof = _G.typeof
local base = _G.BaseHUD

---HUDEffect构造函数
---@param data HUDEffectData @HUD特效数据
function HUDEffect:__init(Data)
end

---HUDBubble资源加载完成
---@param obj UnityEngine.Trasnform @实例对象Transform
function HUDEffect:OnHUDLoadedComplete(obj)
    base.OnHUDLoadedComplete(self, obj)
    if self.Data.HUDInfo.SizeDelta then
        ---@type UnityEngine.RectTransform
        local rect = self.HUDGo:GetComponentE(typeof(_G.CS.UnityEngine.RectTransform))
        rect:SetRectTransformSize(self.Data.HUDInfo.SizeDelta.x, self.Data.HUDInfo.SizeDelta.y)
    end
    self:CacheComponents()
    self:InitView()
end

---缓存组件
function HUDEffect:CacheComponents()
    self.AorTextDialogueContent =
        self.HUDGo:FindE("@_aorimage_BG/@_aortext_DialogueContent"):GetComponentE(_G.typeof(_G.CS.AorText))
end

---初始化显示
function HUDEffect:InitView()
    self.AorTextDialogueContent.text = _G.LangUtil.GetLangPackValue(tonumber(self.Data.HUDInfo.HudCfg.Content))
end

---@type HUDEffect
_G.HUDEffect = HUDEffect
--endregion

---@type HUDEffect
return HUDEffect
