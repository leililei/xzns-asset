realRequire "BaseHUD"

---@class HUDBubble : BaseHUD @2D气泡对话抽象
---@field Data HUDBubbleData @HUD气泡对话数据
---@field HUDResPath UnityEngine.GameObject @HUD实体对象
---@field Duration number @持续时长
---@field AorTextDialogueContent AorText @气泡对话文本
local HUDBubble = _G.BaseClass("HUDBubble", _G.BaseHUD)

local base = _G.BaseHUD

---HUDBubble构造函数
---@param data HUDBubbleData @HUD气泡对话数据
function HUDBubble:__init(Data)
end

---HUDBubble资源加载完成
---@param obj UnityEngine.Trasnform @实例对象Transform
function HUDBubble:OnHUDLoadedComplete(obj)
    base.OnHUDLoadedComplete(self, obj)
    self:CacheComponents()
    self:InitView()
end

---缓存组件
function HUDBubble:CacheComponents()
    self.AorTextDialogueContent =
        self.HUDGo:FindE("@_aorimage_BG/@_aortext_DialogueContent"):GetComponentE(_G.typeof(_G.CS.AorText))
end

---初始化显示
function HUDBubble:InitView()
    self.AorTextDialogueContent.text = _G.LangUtil.GetLangPackValue(tonumber(self.Data.HUDInfo.HudCfg.Content))
end

---@type HUDBubble
_G.HUDBubble = HUDBubble
---@type HUDBubble
return HUDBubble
