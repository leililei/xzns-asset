---销毁指定HUDuID对象
---@param hudinfo HudInfo @Hud信息
---@return HUDBubble @HUD对话对象
function HUDUtilities.DestroyHUDByUid(hudid)
    if _G.IsNil(hudid) then
        return
    end
    _G.Events:GetInstance():Broadcast(_G.HUDEvent.EnumValue.HUDDestroy, false, hudid)
end

---获取指定uidNPC是否当前有气泡
---@param npcUID number @npcUID
---@return HUDBubble false 没有
function HUDUtilities.GetTagetIsHud(npcUID)
    if _G.IsNil(npcUID) then
        return false
    end
    local hudwindow = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.HUDView.Name)
    if _G.IsNil(hudwindow) or hudwindow.Active == false or hudwindow.View or hudwindow.View.go_table then
        return false
    end
    local trans = hudwindow.View.go_table.obj_HUDParent:FindE(npcUID)
    return not _G.IsNil(trans)
end

