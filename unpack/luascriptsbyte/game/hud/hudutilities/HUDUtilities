---@class HUDUtilities @HUD静态工具类
local HUDUtilities = {}

---创建一个默认HudInfo(Note:默认3D。WorldPosition用的是HudInfo里的而非HudCfg里)
---@return HudInfo @Hud信息
function HUDUtilities.CreateDefaultHudInfo()
    ---@type HudInfo
    local hudinfo = {}
    ---@type HudConfig_Item
    hudinfo.HudCfg = {}
    hudinfo.HudCfg.HudType = _G.HUDData.EHudType.Bubble
    hudinfo.HudCfg.ViewType = _G.HUDData.EHudViewType.ThreeD
    hudinfo.HudCfg.AnchorType = _G.EAnchorType.Middle
    hudinfo.HudCfg.UIOffset = {0, 0}
    ---BindTargetUID为cfg配置字段   此为当前绑定对象uid
    hudinfo.NowBindUID = 0
    return hudinfo
end

---HUDView显示指定HUD Dialogue ID(用于配置驱动)
---@param hudid number @HUD ID
---@param delaytimeoutcb function @延时延时超时时回调(仅延时时间正常超时时回调)
---@param BindTargetUID number @目标Uid 优先于配置
---@return HUDBubble @HUD对话对象
function HUDUtilities.ShowHudID(hudid, delaytimeoutcb, BindTargetUID)
    --("HUDUtilities.ShowHudID()")
    delaytimeoutcb = delaytimeoutcb or nil
    ---@type hud_cfg_Item
    local hudcfg = _G.ConfigManager.hud_cfg[hudid]
    if hudcfg ~= nil then
        ---@type HUDView
        local hudinfo = HUDUtilities.CreateDefaultHudInfo()
        hudinfo.HudCfg = _G.ConfigManager.hud_cfg[hudid]
        hudinfo.DelayTimeOutCB = delaytimeoutcb
        if hudinfo.HudCfg.ViewType == _G.HUDData.EHudViewType.TwoD then
            local HUDBubble = HUDUtilities.ShowHUDWith2DPos(hudinfo)
            return HUDBubble
        elseif hudcfg.ViewType == _G.HUDData.EHudViewType.ThreeD then
            local bindtargettransform = nil
            if #hudcfg.WorldPosition == 0 then
                --目标Uid 优先于配置
                if BindTargetUID == nil then
                    BindTargetUID = hudcfg.BindTargetUID
                end
                --默认0表示主玩家
                if BindTargetUID == 0 then
                    local curPlayer = _G.WorldManager:GetInstance():GetCurWorldPlayer()
                    if curPlayer ~= nil then
                        --暂时默认3D人物的HUD都是以Common_Title节点为绑定节点
                        bindtargettransform = curPlayer.TitleTransform
                        ---防止主角不加载显示Common_Title
                        if bindtargettransform == nil and not _G.IsNil(curPlayer.RolePoint) then
                            bindtargettransform = _G.WorldManager:GetInstance():GetCurWorldPlayer().RolePoint.Point_Hp
                        end
                        BindTargetUID = _G.PlayerModel:GetInstance().role_uid
                    end
                else
                    local role = _G.WorldManager:GetInstance():GetCurWorld():GetItemInfo(BindTargetUID)
                    if _G.IsNil(role) then
                        if _G.AppSetting.DEBUG then
                            _G.LogError(BindTargetUID .. " BindTargetUID 未找到   HUDUtilities.ShowHudID()")
                        end
                        return
                    end
                    bindtargettransform = role.TitleTransform
                end
            else
                hudinfo.WorldPosition = {}
                hudinfo.WorldPosition[1] = hudcfg.WorldPosition[1] or 0
                hudinfo.WorldPosition[2] = hudcfg.WorldPosition[2] or 0
                hudinfo.WorldPosition[3] = hudcfg.WorldPosition[3] or 0
            end

            hudinfo.NowBindUID = BindTargetUID
            hudinfo.BindTransform = bindtargettransform
            ---清空当前角色的气泡  气泡同时只存在一个
            _G.Events:GetInstance():Broadcast(_G.HUDEvent.EnumValue.HUDDestroy, false, BindTargetUID)
            local HUDBubble = HUDUtilities.ShowHUDWith3DPos(hudinfo)
            return HUDBubble
        elseif hudcfg.ViewType == _G.HUDData.EHudViewType.ScenesThreeD then
            local bindtargettransform = nil
            if #hudcfg.WorldPosition == 0 then
                --目标Uid 优先于配置
                if BindTargetUID == nil then
                    BindTargetUID = hudcfg.BindTargetUID
                end
                --默认0表示主玩家
                if BindTargetUID == 0 then
                    local curPlayer = _G.WorldManager:GetInstance():GetCurWorldPlayer()
                    if curPlayer ~= nil then
                        --暂时默认3D人物的HUD都是以Common_Title节点为绑定节点
                        bindtargettransform = curPlayer.TitleTransform
                        ---防止主角不加载显示Common_Title
                        if bindtargettransform == nil and not _G.IsNil(curPlayer.RolePoint) then
                            bindtargettransform = _G.WorldManager:GetInstance():GetCurWorldPlayer().RolePoint.Point_Hp
                        end
                        BindTargetUID = _G.PlayerModel:GetInstance().role_uid
                    end
                else
                    local role = _G.WorldManager:GetInstance():GetCurWorld():GetItemInfo(BindTargetUID)
                    if _G.IsNil(role) then
                        if _G.AppSetting.DEBUG then
                            _G.LogError(BindTargetUID .. " BindTargetUID 未找到   HUDUtilities.ShowHudID()")
                        end
                        return
                    end
                    bindtargettransform = role.TitleTransform
                end
            else
                hudinfo.WorldPosition = {}
                hudinfo.WorldPosition[1] = hudcfg.WorldPosition[1] or 0
                hudinfo.WorldPosition[2] = hudcfg.WorldPosition[2] or 0
                hudinfo.WorldPosition[3] = hudcfg.WorldPosition[3] or 0
            end

            hudinfo.NowBindUID = BindTargetUID
            hudinfo.BindTransform = bindtargettransform
            ---清空当前角色的气泡  气泡同时只存在一个
            _G.Events:GetInstance():Broadcast(_G.HUDEvent.EnumValue.HUDDestroy, false, BindTargetUID)
            local HUDBubble = HUDUtilities.ShowHUDWithScene3DPos(hudinfo)
            return HUDBubble
        else
            if _G.AppSetting.DEBUG then
                _G.LogError(string.format("不支持的HUD ViewType类型:%d", hudcfg.ViewType))
            end
            return nil
        end
    else
        if _G.AppSetting.DEBUG then
            _G.LogError(string.format("未配置的HUD ID:%d", hudid))
        end
        return nil
    end
end

