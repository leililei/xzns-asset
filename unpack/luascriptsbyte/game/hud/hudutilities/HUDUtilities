                _G.LogError(string.format("不支持的HUD ViewType类型:%d", hudcfg.ViewType))
            end
            return nil
        end
    else
        if _G.AppSetting.DEBUG then
            _G.LogError(string.format("未配置的HUD ID:%d", hudid))
        end
        return nil
    end
end

---HUDView显示指定3D世界坐标的气泡喊话到指定UI节点下(用于手动传入相关数据接口调用)
---@param hudinfo HudInfo @Hud信息
---@return HUDBubble @HUD对话对象
function HUDUtilities.ShowHUDWithScene3DPos(hudinfo)
    _G.LogUtilities.Log(_G.EModuleName.HudModule, "HUDUtilities.ShowBubbleWith3DPos()")
    ---@type HUDBubbleData
    local huddatascriptname = _G.HUDData.ConstHudDataScriptData[hudinfo.HudCfg.HudType]
    local huddatascript = require(huddatascriptname)
    ---@type HUDData
    local huddata = _G.ObjectPool:GetInstance():Pop(huddatascript, hudinfo)
    local hudscriptname = _G.HUDData.ConstHudScriptData[hudinfo.HudCfg.HudType]
    local hudscript = require(hudscriptname)
    local hubbubble = _G.New(hudscript, huddata)
    hubbubble:Display()
    return hubbubble
end

