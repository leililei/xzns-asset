realRequire "BaseHUD3D"

---@class HUDBubbleScene3D : BaseHUD3D @2D气泡对话抽象
---@field Data HUDBubbleScene3DData @HUD气泡对话数据
---@field HUDResPath UnityEngine.GameObject @HUD实体对象
---@field Duration number @持续时长
---@field AorTextDialogueContent AorText @气泡对话文本
local HUDBubbleScene3D = _G.BaseClass("HUDBubbleScene3D", _G.BaseHUD3D)

local base = _G.BaseHUD3D

---HUDBubbleScene3D构造函数
---@param data HUDBubbleScene3DData @HUD气泡对话数据
function HUDBubbleScene3D:__init(Data)
end

---HUDBubbleScene3D资源加载完成
---@param obj UnityEngine.Trasnform @实例对象Transform
function HUDBubbleScene3D:OnHUDLoadedComplete(obj)
    base.OnHUDLoadedComplete(self, obj)
    self:CacheComponents()
    self:InitView()
end

---缓存组件
function HUDBubbleScene3D:CacheComponents()
    self.AorTextDialogueContent =
        self.HUDGo:FindE("@_aorimage_BG/@_aortext_DialogueContent"):GetComponentE(_G.typeof(_G.CS.AorText))
end

---初始化显示
function HUDBubbleScene3D:InitView()
    self.AorTextDialogueContent.text = _G.LangUtil.GetLangPackValue(tonumber(self.Data.HUDInfo.HudCfg.Content))
end

---@type HUDBubbleScene3D
_G.HUDBubbleScene3D = HUDBubbleScene3D
---@type HUDBubbleScene3D
return HUDBubbleScene3D
