realRequire "BaseHUDData"

---@class BaseHUD3D : BaseEvent @HUD基类抽象
---@field Data BaseHUDData @HUD数据
---@field HUDGo UnityEngine.GameObject @HUD实体对象
---@field HasInit boolean @是否已经初始化
---@field UpdateFunc function @HUD Update Timer
---@field DelayDestroyTimer Timer @HUD延迟销毁Timer
---@field CoDelayDestroy coroutine @HUD延迟销毁携程
local BaseHUD3D = _G.BaseClass("BaseHUD3D", _G.BaseEvent)
BaseHUD3D.Data = nil
BaseHUD3D.HUDGo = nil
BaseHUD3D.HasInit = nil
BaseHUD3D.UpdateFunc = nil
BaseHUD3D.DelayDestroyTimer = nil
BaseHUD3D.CoDelayDestroy = nil

---BaseHUD构造函数
---@param data BaseHUDData @HUD数据
function BaseHUD3D:__init(data)
    self.Data = data
    self.HUDGo = nil
    self.HasInit = false
    self.UpdateFunc = nil
    self.CoDelayDestroy = nil
end

---显示HUD
function BaseHUD3D:Display()
    if self.HasInit == false then
        self.HasInit = true
        -- self.HUDGo:RequireComponentE(_G.typeof(_G.CS.UnityEngine.UI.Image))
        if not self.Data.HUDInfo.UIRect then
            ---@type HUDView
            local hudview = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.HUDView.Name)
            if not hudview or hudview.gameObject == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogWarning("HUDView窗口未打开")
                end
                return
            end

            self.Data.HUDInfo.UIRect =
                hudview.go_table.obj_HUDParent:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
        end
        _G.PoolsManager:GetInstance():Spawn(
            self.Data.HUDInfo.HudCfg.ResPath,
            _G.ePoolType.Default,
            self.Data.HUDInfo.UIRect,
            _G.handler(self, self.OnHUDLoadedComplete)
        )
    else
        if self.HUDGo ~= nil then
            self.HUDGo:SetActiveE(1)
        else
            _G.LogUtilities.Log(
                _G.EModuleName.HudModule,
                string.format("HUD ResPath:%s等待加载完成!", self.Data.HUDInfo.ResPath)
            )
        end
    end
    _G.LogUtilities.Log(
        _G.EModuleName.HudModule,
        string.format(
            "self.Data.HUDInfo.HudCfg.UIOffset = [%s , %s]",
            self.Data.HUDInfo.HudCfg.UIOffset[1],
            self.Data.HUDInfo.HudCfg.UIOffset[2]
        )
    )
end

---设置UI节点的偏移量
function BaseHUD3D:SetAnchorPositionByOffset()
    assert(self.HUDGo, "self.HUDGo is nil")
    if #self.Data.HUDInfo.HudCfg.UIOffset == 2 then
        ---@type UnityEngine.RectTransform
        local recttransform = self.HUDGo:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
        local posx, poy = recttransform:GetAnchorPosition()
        local x = posx + self.Data.HUDInfo.HudCfg.UIOffset[1]
        local y = poy + self.Data.HUDInfo.HudCfg.UIOffset[2]
        recttransform:SetAnchorPosition(x, y)
    end
end

---HUD资源加载完成
---@param obj UnityEngine.Transform @实例对象Transform
function BaseHUD3D:OnHUDLoadedComplete(obj)
    obj:SetActiveE(0)
    _G.LogUtilities.Log(
        _G.EModuleName.HudModule,
        string.format("HUD ResPath:%s加载完成!", self.Data.HUDInfo.HudCfg.ResPath)
    )
    self.HUDGo = obj
    self.HUDGo:SetName(self.Data.HUDInfo.NowBindUID)
    local uipos = _G.Vector3.zero

    if self.Data.HUDInfo.HudCfg.Duration ~= nil and self.Data.HUDInfo.HudCfg.Duration ~= 0 then
        _G.LogUtilities.Log(
            _G.EModuleName.HudModule,
            self.Data.HUDInfo.HudCfg.Duration,
            "<color=red>" .. ">>>" .. "</color>"
        )
        self.CoDelayDestroy = _G.coroutine.start(_G.handler(self, self.OnDelayDestroy))
    end
    ---设定了uipos的话以UI坐标为准(不考虑3D坐标和3D节点绑定)
    if #self.Data.HUDInfo.HudCfg.UIPosition > 0 then
        uipos = self.Data.HUDInfo.HudCfg.UIPosition

        self.HUDGo:SetAnchorPosition(uipos, uipos.y)
    else
        self.HUDGo:SetParentE(self.Data.HUDInfo.BindTransform)
        self.UpdateFunc = _G.handler(self, self.OnUpdate)
        _G.UpdateManager:GetInstance():AddLateUpdate(self.UpdateFunc)

        self:SetAnchorPositionByOffset()
        local curworld = _G.WorldManager:GetInstance():GetCurWorld()
        if not _G.IsNil(curworld) then
            curworld.WorldSetting:TranLookAtCamera(self.HUDGo)
        end
    end

    obj:SetActiveE(1)
    _G.Events:GetInstance():AddListener(_G.HUDEvent.EnumValue.HUDDestroy, self.OnListener_Destroy, self)
end

---隐藏HUD
function BaseHUD3D:Hide()
    if self.HasInit == true then
        if _G.IsNil(self.HUDGo) == false then
            self.HUDGo:SetActiveE(0)
        else
            if _G.AppSetting.DEBUG then
                _G.LogUtilities.LogError(
                    _G.EModuleName.HudModule,
                    string.format("HUD ResPath:%s未加载完成,无法隐藏!", self.Data.HUDInfo.HudCfg.ResPath)
                )
            end
        end
    else
        if _G.AppSetting.DEBUG then
            _G.LogUtilities.LogError(
                _G.EModuleName.HudModule,
                string.format("HUD ResPath:%s未加载，无法隐藏!", self.Data.HUDInfo.HudCfg.ResPath)
            )
        end
    end
end

function BaseHUD3D:OnListener_Destroy(isDestroyAll, npcUid)
    if isDestroyAll or npcUid == self.Data.HUDInfo.NowBindUID then
        self:Destroy()
    end
end

---销毁HUD
function BaseHUD3D:Destroy()
    if self.UpdateFunc ~= nil then
        _G.UpdateManager:GetInstance():RemoveLateUpdate(self.UpdateFunc)
    end
    _G.Events:GetInstance():RemoveListener(_G.HUDEvent.EnumValue.HUDDestroy, self.OnListener_Destroy, self)
    if self.CoDelayDestroy ~= nil then
        _G.coroutine.stopwaiting(self.CoDelayDestroy)
        self.CoDelayDestroy = nil
    end
    if _G.IsNil(self.HUDGo) == false then
        --self.HUDGo:DestroyObject()
        --self.HUDGo = nil
        _G.PoolsManager:GetInstance():Despawn(self.HUDGo, _G.ePoolType.Default)
        self.HUDGo = nil
    else
        if _G.AppSetting.DEBUG then
            _G.LogUtilities.LogError(
                _G.EModuleName.HudModule,
                string.format("HUD ResPath:%s未加载，无法销毁!", self.Data.HUDInfo.HudCfg.ResPath)
            )
        end
    end
    self.HasInit = false
    _G.ObjectPool:GetInstance():Push(self.Data)
end

---HUD更新方法(仅在设定了绑定对象时起作用)
function BaseHUD3D:OnUpdate()
    if _G.IsNil(self.Data.HUDInfo.BindTransform) == false and _G.IsNil(self.HUDGo) == false then
    else
        -- 绑定的实体对象不存在的话，强制销毁自身避免上层没有做管理导致报错
        --_G.LogUtilities.Log("绑定对象不存在，强制销毁HUD!")
        self:Destroy()
    end
end

---HUD延时销毁方法(仅在设定Duration不为nil和0时起作用)
function BaseHUD3D:OnDelayDestroy()
    _G.coroutine.waitforseconds(self.Data.HUDInfo.HudCfg.Duration)
    _G.LogUtilities.Log(
        _G.EModuleName.HudModule,
        string.format(
            "HUD ResPath: %s 延时时长： %d完毕，销毁HUD!",
            self.Data.HUDInfo.HudCfg.ResPath,
            self.Data.HUDInfo.HudCfg.Duration
        )
    )
    if self.Data.HUDInfo.DelayTimeOutCB ~= nil then
        _G.LogUtilities.Log(_G.EModuleName.HudModule, "延时回调触发!")
        self.Data.HUDInfo.DelayTimeOutCB()
    end
    self:Destroy()
end

---@type BaseHUD3D
_G.BaseHUD3D = BaseHUD3D
---@type BaseHUD3D
return BaseHUD3D
