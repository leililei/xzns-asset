realRequire "BaseHUDData"

--- 定义HUD特效数据信息结构(避免2D和3D参数混到一起后导致参数过多)
---@class HUDEffectInfo : HUDInfo @气泡信息
---@field SizeDelta UnityEngine.Vector2 @UI SizeDelta(可传可不传)

---@class HUDEffectData : BaseHUDData @气泡对话HUD数据
---@field HUDInfo HUDEffectInfo @气泡对话内容
local HUDEffectData = _G.BaseClass("HUDEffectData", _G.BaseHUDData)

local base = _G.BaseHUDData

---HUDEffectData构造函数
---@param hudinfo HUDEffectInfo @特效HUD信息
function HUDEffectData:__init(hudinfo) --, respath, uirect, duration, uipos, anchortype, bindtransform, flowbindtarget, worldpos, delaytimeoutcb, dialoguecontent)]]--
end

---HUDEffectData出池构造函数
---@param hudinfo HUDEffectInfo @特效HUD信息
function HUDEffectData:OnInit(
    hudinfo,
    respath,
    uirect,
    duration,
    uipos,
    anchortype,
    bindtransform,
    flowbindtarget,
    worldpos,
    delaytimeoutcb,
    dialoguecontent)
    _G.LogUtilities.Log(_G.EModuleName.HudModule, "HUDEffectData:OnInit()")
    base.OnInit(
        self,
        hudinfo,
        respath,
        uirect,
        duration,
        uipos,
        anchortype,
        bindtransform,
        flowbindtarget,
        worldpos,
        delaytimeoutcb
    )
end

---HUDEffectData进池析构函数
function HUDEffectData:OnDispose()
    _G.LogUtilities.Log(_G.EModuleName.HudModule, "HUDEffectData:OnDispose()")
    base.OnDispose(self)
end

---@type HUDEffectData
_G.HUDEffectData = HUDEffectData
---@type HUDEffectData
return HUDEffectData
