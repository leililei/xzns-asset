realRequire "BaseHUDData"

--- 定义HUD气泡数据信息结构(避免2D和3D参数混到一起后导致参数过多)
---@class HUDBubbleInfo : HudInfo @气泡信息

---@class HUDBubbleData : BaseHUDData @气泡对话HUD数据
---@field HUDInfo HUDBubbleInfo @气泡对话内容
local HUDBubbleData = _G.BaseClass("HUDBubbleData", _G.BaseHUDData)

---HUDBubbleData构造函数
---@param hudinfo HUDBubbleInfo @气泡HUD信息
function HUDBubbleData:__init(hudinfo)
end

---HUDBubbleData出池构造函数
---@param hudinfo HUDBubbleInfo @HUD信息
---@field dialoguecontent string @气泡对话内容
function HUDBubbleData:OnInit(hudinfo)
    _G.LogUtilities.Log(_G.EModuleName.HudModule, "HUDBubbleData:OnInit()")
    _G.BaseHUDData.OnInit(self, hudinfo)
end

---HUDBubbleData进池析构函数
function HUDBubbleData:OnDispose()
    _G.LogUtilities.Log(_G.EModuleName.HudModule, "HUDBubbleData:OnDispose()")
    _G.BaseHUDData.OnDispose(self)
end

---@type HUDBubbleData
_G.HUDBubbleData = HUDBubbleData
---@type HUDBubbleData
return HUDBubbleData
