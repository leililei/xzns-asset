realRequire "BaseHUDData"

---@class BaseHUD : BaseEvent @HUD基类抽象
---@field Data BaseHUDData @HUD数据
---@field HUDGo UnityEngine.GameObject @HUD实体对象
---@field HasInit boolean @是否已经初始化
---@field UpdateFunc function @HUD Update Timer
---@field DelayDestroyTimer Timer @HUD延迟销毁Timer
---@field CoDelayDestroy coroutine @HUD延迟销毁携程
local BaseHUD = _G.BaseClass("BaseHUD", _G.BaseEvent)
BaseHUD.Data = nil
BaseHUD.HUDGo = nil
BaseHUD.HasInit = nil
BaseHUD.UpdateFunc = nil
BaseHUD.DelayDestroyTimer = nil
BaseHUD.CoDelayDestroy = nil

---BaseHUD构造函数
---@param data BaseHUDData @HUD数据
function BaseHUD:__init(data)
    self.Data = data
    self.HUDGo = nil
    self.HasInit = false
    self.UpdateFunc = nil
    self.CoDelayDestroy = nil
end

---显示HUD
function BaseHUD:Display()
    if self.HasInit == false then
        self.HasInit = true
        if not self.Data.HUDInfo.UIRect then
            local hudwindow = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.HUDView.Name)
            assert(hudwindow, "HUDView窗口未打开!")
            assert(hudwindow.Active, "HUDView窗口未打开!")
            ---@type HUDView
            local hudview = hudwindow.View
            self.Data.HUDInfo.UIRect =
                hudview.go_table.obj_HUDParent:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
        end
        _G.PoolsManager:GetInstance():Spawn(
            self.Data.HUDInfo.HudCfg.ResPath,
            _G.ePoolType.UIItem,
            self.Data.HUDInfo.UIRect,
            _G.handler(self, self.OnHUDLoadedComplete)
        )
    else
        if self.HUDGo ~= nil then
            self.HUDGo:SetActiveE(1)
        else
            _G.LogUtilities.Log(
                _G.EModuleName.HudModule,
                string.format("HUD ResPath:%s等待加载完成!", self.Data.HUDInfo.ResPath)
            )
        end
    end
    _G.LogUtilities.Log(
        _G.EModuleName.HudModule,
        string.format(
            "self.Data.HUDInfo.HudCfg.UIOffset = [%s , %s]",
            self.Data.HUDInfo.HudCfg.UIOffset[1],
            self.Data.HUDInfo.HudCfg.UIOffset[2]
        )
    )
end

---设置UI节点的偏移量
function BaseHUD:SetAnchorPositionByOffset()
    assert(self.HUDGo, "self.HUDGo is nil")
    if #self.Data.HUDInfo.HudCfg.UIOffset > 0 then
        ---@type UnityEngine.RectTransform
        local recttransform = self.HUDGo:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))

        local tx, ty = recttransform:GetAnchorPosition()
        local orgin = _G.Vector2.New(tx, ty)
        local x = orgin.x + self.Data.HUDInfo.HudCfg.UIOffset[1]
        local y = orgin.y + self.Data.HUDInfo.HudCfg.UIOffset[2]
        recttransform:SetAnchorPosition(x, y)
    end
end

---HUD资源加载完成
---@param obj UnityEngine.Transform @实例对象Transform
function BaseHUD:OnHUDLoadedComplete(obj)
    _G.LogUtilities.Log(
        _G.EModuleName.HudModule,
        string.format("HUD ResPath:%s加载完成!", self.Data.HUDInfo.HudCfg.ResPath)
    )
    self.HUDGo = obj
    self.HUDGo:SetName(self.Data.HUDInfo.NowBindUID)
    local uipos = _G.Vector3.zero

    self:UpdateAnchorAndPivot(obj, self.Data.HUDInfo.HudCfg.UIAnchorType)

    ---设定了uipos的话以UI坐标为准(不考虑3D坐标和3D节点绑定)
    if self.Data.HUDInfo.HudCfg.UIPosition ~= nil then
        uipos = self.Data.HUDInfo.HudCfg.UIPosition

        obj:SetAnchorPosition(uipos.x, uipos.y)
    else
        ---设定了绑定对象的话，以绑定对象的坐标为准
        local bindworldpos = self.Data.HUDInfo.WorldPosition
        if _G.IsNil(self.Data.HUDInfo.BindTransform) == false then
            local tx, ty, tz = self.Data.HUDInfo.BindTransform:GetPosition()
            bindworldpos = _G.Vector3.New(tx, ty, tz)
        end
        if bindworldpos ~= nil then
            _G.LogUtilities.Log(
                _G.EModuleName.HudModule,
                string.format("bindworldpos = [%s, %s, %s]", bindworldpos.x, bindworldpos.y, bindworldpos.z)
            )
            uipos = _G.UIUtils.Get3DTo2DPos(self.Data.HUDInfo.UIRect, bindworldpos)
            obj:SetLocalPosition(uipos.x, uipos.y, uipos.z)
        end
    end
    _G.LogUtilities.Log(_G.EModuleName.HudModule, string.format("uipos = %s", uipos))
    if _G.IsNil(self.Data.HUDInfo.BindTransform) == false then
        self.UpdateFunc = _G.handler(self, self.OnUpdate)
        _G.UpdateManager:GetInstance():AddLateUpdate(self.UpdateFunc)
    end
    if self.Data.HUDInfo.HudCfg.Duration ~= nil and self.Data.HUDInfo.HudCfg.Duration ~= 0 then
        _G.LogUtilities.Log(
            _G.EModuleName.HudModule,
            self.Data.HUDInfo.HudCfg.Duration,
            "<color=red>" .. ">>>" .. "</color>"
        )
        self.CoDelayDestroy = _G.coroutine.start(_G.handler(self, self.OnDelayDestroy))
    end
    self:SetAnchorPositionByOffset()

    _G.Events:GetInstance():AddListener(_G.HUDEvent.EnumValue.HUDDestroy, self.OnListener_Destroy, self)
end

---更新Anchor和Pivot
function BaseHUD:UpdateAnchorAndPivot(obj, anchortype)
    assert(obj or anchortype, "obj和anchortype都不允许传nil")
    ---@type UnityEngine.RectTransform
    local recttransform = obj:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    local pivot = _G.Vector2.New(0.5, 0.5)
    local anchormin = _G.Vector2.New(0.5, 0.5)
    local anchormax = _G.Vector2.New(0.5, 0.5)
    if self.Data.HUDInfo.HudCfg.AnchorType == _G.EAnchorType.Middle then
        ---
    elseif self.Data.HUDInfo.HudCfg.AnchorType == _G.EAnchorType.MiddleTop then
        pivot.y = 1
        anchormin.y = 1
        anchormax.y = 1
    elseif self.Data.HUDInfo.HudCfg.AnchorType == _G.EAnchorType.MiddleBottle then
        pivot.y = 0
        anchormin.y = 0
        anchormax.y = 0
    elseif self.Data.HUDInfo.HudCfg.AnchorType == _G.EAnchorType.TopLeft then
        pivot.x = 0
        pivot.y = 1
        anchormin.x = 0
        anchormin.y = 1
        anchormax.x = 0
        anchormax.y = 1
    elseif self.Data.HUDInfo.HudCfg.AnchorType == _G.EAnchorType.MiddleLeft then
        pivot.x = 0
        anchormin.x = 0
        anchormax.x = 0
    elseif self.Data.HUDInfo.HudCfg.AnchorType == _G.EAnchorType.BottleLeft then
        pivot = _G.Vector2.zero
        anchormin = _G.Vector2.zero
        anchormax = _G.Vector2.zero
    elseif self.Data.HUDInfo.HudCfg.AnchorType == _G.EAnchorType.TopRight then
        pivot = _G.Vector2.one
        anchormin = _G.Vector2.one
        anchormax = _G.Vector2.one
    elseif self.Data.HUDInfo.HudCfg.AnchorType == _G.EAnchorType.MiddleRight then
        pivot.x = 1
        anchormin.x = 1
        anchormax.x = 1
    elseif self.Data.HUDInfo.HudCfg.AnchorType == _G.EAnchorType.BottleRight then
        pivot.x = 1
        pivot.y = 0
        anchormin.x = 1
        anchormin.y = 0
        anchormax.x = 1
        anchormax.y = 0
    else
        if _G.AppSetting.DEBUG then
            _G.LogUtilities.LogError(
                _G.EModuleName.HudModule,
                string.format("不支持的EAnchorType:%s", self.Data.HUDInfo.HudCfg.AnchorType)
            )
        end
    end
    ---@type UnityEngine.RectTransform
    local recttransform = obj:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    recttransform:SetPivotPosition(pivot.x, pivot.y)
    recttransform:SetRectTransformAnchorMin(anchormin.x, anchormin.y)
    recttransform:SetRectTransformAnchorMax(anchormax.x, anchormax.y)
end

---隐藏HUD
function BaseHUD:Hide()
    if self.HasInit == true then
        if _G.IsNil(self.HUDGo) == false then
            self.HUDGo:SetActiveE(0)
        else
            if _G.AppSetting.DEBUG then
                _G.LogUtilities.LogError(
                    _G.EModuleName.HudModule,
                    string.format("HUD ResPath:%s未加载完成,无法隐藏!", self.Data.HUDInfo.HudCfg.ResPath)
                )
            end
        end
    else
        if _G.AppSetting.DEBUG then
            _G.LogUtilities.LogError(
                _G.EModuleName.HudModule,
                string.format("HUD ResPath:%s未加载，无法隐藏!", self.Data.HUDInfo.HudCfg.ResPath)
            )
        end
    end
end

function BaseHUD:OnListener_Destroy(isDestroyAll, npcUid)
    if isDestroyAll or npcUid == self.Data.HUDInfo.NowBindUID then
        self:Destroy()
    end
end

---销毁HUD
function BaseHUD:Destroy()
    if self.UpdateFunc ~= nil then
        _G.UpdateManager:GetInstance():RemoveLateUpdate(self.UpdateFunc)
    end
    _G.Events:GetInstance():RemoveListener(_G.HUDEvent.EnumValue.HUDDestroy, self.OnListener_Destroy, self)
    if self.CoDelayDestroy ~= nil then
        _G.coroutine.stopwaiting(self.CoDelayDestroy)
        self.CoDelayDestroy = nil
    end
    if _G.IsNil(self.HUDGo) == false then
        self.HUDGo:DestroyObject()
        self.HUDGo = nil
    else
        if _G.AppSetting.DEBUG then
            _G.LogUtilities.LogError(
                _G.EModuleName.HudModule,
                string.format("HUD ResPath:%s未加载，无法销毁!", self.Data.HUDInfo.HudCfg.ResPath)
            )
        end
    end
    self.HasInit = false
    _G.ObjectPool:GetInstance():Push(self.Data)
end

---HUD更新方法(仅在设定了绑定对象时起作用)
function BaseHUD:OnUpdate()
    if _G.IsNil(self.Data.HUDInfo.BindTransform) == false and _G.IsNil(self.HUDGo) == false then
        local tagerTran = self.Data.HUDInfo.BindHeadTransform or self.Data.HUDInfo.BindTransform
        local tx, ty, tz = tagerTran:GetPosition()
        local uipos = _G.UIUtils.Get3DTo2DPos(self.Data.HUDInfo.UIRect, _G.Vector3.New(tx, ty, tz))
        ---保留两位小数 防止一直刷新导致UI细微偏移
        uipos.x = tonumber(string.format("%.2f", uipos.x))
        uipos.y = tonumber(string.format("%.2f", uipos.y))

        local offsetx = 0
        local offsety = 0
        if #self.Data.HUDInfo.HudCfg.UIOffset > 0 then
            offsetx = self.Data.HUDInfo.HudCfg.UIOffset[1]
            offsety = self.Data.HUDInfo.HudCfg.UIOffset[2]
        end

        self.HUDGo:SetLocalPosition(uipos.x + offsetx, uipos.y + offsety, 0)
    else
        -- 绑定的实体对象不存在的话，强制销毁自身避免上层没有做管理导致报错
        --_G.LogUtilities.Log("绑定对象不存在，强制销毁HUD!")
        self:Destroy()
    end
end

---HUD延时销毁方法(仅在设定Duration不为nil和0时起作用)
function BaseHUD:OnDelayDestroy()
    _G.coroutine.waitforseconds(self.Data.HUDInfo.HudCfg.Duration)
    _G.LogUtilities.Log(
        _G.EModuleName.HudModule,
        string.format(
            "HUD ResPath: %s 延时时长： %d完毕，销毁HUD!",
            self.Data.HUDInfo.HudCfg.ResPath,
            self.Data.HUDInfo.HudCfg.Duration
        )
    )
    if self.Data.HUDInfo.DelayTimeOutCB ~= nil then
        _G.LogUtilities.Log(_G.EModuleName.HudModule, "延时回调触发!")
        self.Data.HUDInfo.DelayTimeOutCB()
    end
    self:Destroy()
end

---@type BaseHUD
_G.BaseHUD = BaseHUD
---@type BaseHUD
return BaseHUD
