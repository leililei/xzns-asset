---@class BeastIllustratedPanel : Component	宠物列表界面
---@field go_table BeastIllustratedPanel_GoTable
local BeastIllustratedPanel = _G.BaseClass("BeastIllustratedPanel", _G.Component)
local BeastModel = require("BeastModel")

local orderEnum = {
    [0] = 1,
    [4] = 2,
    [5] = 3,
    [6] = 4,
    [8] = 5
}

function BeastIllustratedPanel:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eItemUpdata.Updata,self.UpdateData)
    self:AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnCloseDecompose)
end

function BeastIllustratedPanel:OnCreate()
    self:InitData()
    self:InitView()
end

function BeastIllustratedPanel:InitData()
    self.percent = _G.ConfigManager.discrete_cfg[200212][1][1] / 10000
    self.itemList = {}
    self.curOrder = 0
    self.lastPower = _G.StorageManager:GetInstance():GetPlayerPower()
    self:UpdateData()
    BeastModel:GetInstance():SetIllustratedFun(_G.handler(self, self.UpdateData))
end

---初始化界面
function BeastIllustratedPanel:InitView()
    self.go_table.aortext_Tip.text = _G.GetLangPackValue(90049300006, _G.math.floor((self.percent) * 100) .. "%")
    self.go_table.scrollloopvectical_pet:InitItemData(#self.beastDataList[orderEnum[self.curOrder]], _G.handler(self, self.RefreshList))
    self.listInit = true
end

---更新数据
function BeastIllustratedPanel:UpdateData()
    self.beastDataList = {}
    for _, v in pairs(orderEnum) do
        self.beastDataList[v] = {}--每个品质的数据
    end
    self.showColorful = false
    for _, v in pairs(BeastModel:GetInstance():GetAllBeastsBySort()) do
        local isSuit = false
        if v:GetOrder() == 8 then
            self.showColorful = true
        end
        if self.curOrder == 0 then
            isSuit = true
        else
            isSuit = v:GetOrder() == self.curOrder
        end
        if isSuit then
            _G.table.insert(self.beastDataList[orderEnum[self.curOrder]], v.sid)
        end
    end
    self.attrList = BeastModel:GetInstance():GetAllAttribute()
    self:UpdateView()
end

---更新页面
function BeastIllustratedPanel:UpdateView()
    self.go_table.aorbtn_Order8:SetActiveE(self.showColorful and 1 or 0)
    self:SelectOrder(self.curOrder)
    self:UpdateAttr()
    if self.listInit then
        self.go_table.scrollloopvectical_pet:UpdateCount(#self.beastDataList[orderEnum[self.curOrder]])
    end
end

---更新属性
function BeastIllustratedPanel:UpdateAttr()
    self.go_table.trans_AttContent:RemoveAllChildren()
    for _, v in ipairs(self.attrList) do
        local attrItem = _G.InstantiateObject(self.go_table.obj_Attr, self.go_table.trans_AttContent)
        local tb = _G.GetAutoGoTable(attrItem)
        tb.aortext_Name.text = _G.GetLangPackValue(v.name)
        local value = _G.math.floor(v.curValue * self.percent)
        tb.aortext_Num.text = _G.GameUtil.NumberWY(value)
    end
    _G.GameUtil.ReBuildRTF(self.go_table.trans_AttContent)
end

---刷新Item
function BeastIllustratedPanel:RefreshList(index, obj)
    index = index + 1
    local id = self.beastDataList[orderEnum[self.curOrder]][index]
    obj:SetName(id)

    local tb = _G.GetAutoGoTable(obj)
    self:SetItem(tb, id)
end

---设置显示信息
function BeastIllustratedPanel:SetItem(tb, id)
    self:PlayLoadAni(tb)
    if not tb.beast then
        tb.beast = require("BeastCardItem").New(tb.obj_Beast)
    end
    local beast = tb.beast
    beast:Show(id, _G.handler(self, self.OnClickItem), tb)
    beast:ShowState()
    beast:ShowEffect()
    tb.obj_Effect:RemoveAllChildren()
    if beast.data:IsCanGet() then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_jihuotishi,
            tb.obj_Effect,
                function(trans)
                    if not self.go_table then
                        _G.DestroyImmediate(trans)
                        return
                    end
                    trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                end
        )
    end
    tb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.BeastList.id, id)
    if beast.data:IsMaxStar() then
        tb.obj_Chip:SetActiveE(0)
        tb.slider_Progress:SetActiveE(0)
        return
    end
    tb.obj_Chip:SetActiveE(1)
    tb.slider_Progress:SetActiveE(1)
    if not tb.chip then
        tb.chip = require("ItemViewNew").New(tb.obj_Chip)
    end
    tb.chip:Show(beast.data:GetCostItem())
    local count, need, str = beast.data:GetCost()
    tb.aortext_Slider.text = str
    local value = count / need
    if value >= 1 then
        value = 1
    end
    tb.slider_Progress.value = value
end

---播放加载动效
function BeastIllustratedPanel:PlayLoadAni(tb)
    if not tb.canvasGroup then
        tb.canvasGroup = tb.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup))
    end
    local x, y, _ = tb.gameObject:GetLocalPosition()
    local time = 0.2
    tb.gameObject:SetLocalPosition(x - 50, y, 0)
    tb.gameObject:DOLocalMoveX(x, time):SetEase(_G.CS.DG.Tweening.Ease.OutExpo)
    tb.canvasGroup.alpha = 0
    tb.canvasGroup:DOFade(1, time):SetEase(_G.CS.DG.Tweening.Ease.Linear)
end

---圣兽点击事件
function BeastIllustratedPanel:OnClickItem(params)
    local tb = params[1]
    if tb.beast.isCanGet == true then
        BeastModel:GetInstance():UpStar(tb.beast.data.sid, 0, function()
            self:UpdateData()
            self:PopPowerUp()
        end)
    else
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.BeastDevelopView.Name,
            tb.beast.data,
            self.beastDataList[orderEnum[self.curOrder]],
            function()
                self:UpdateData()
                self.lastPower = _G.StorageManager:GetInstance():GetPlayerPower()
            end
        )
    end
end

function BeastIllustratedPanel:SelectOrder(order)
    local btn = "aorbtn_All"
    if order ~= 0 then
        btn = "aorbtn_Order" .. order
    end
    _G.DelayFrameDo(function()
        local x, y = self.go_table[btn]:GetAnchorPosition()
        self.go_table.aorimage_Select:SetAnchorPosition(x, y)
    end)
    if order == self.curOrder then
        return
    end
    self.curOrder = order
    self:UpdateData()
end

function BeastIllustratedPanel:OpenDecomposeView()
    local params = {}
    params.titleText = 91118100101
    params.ToggleCall = function(isOn)
        _G.PopWindowManager:GetInstance():ShowAllTips(isOn and 914104 or 914105)
        if isOn then
            ---@type DecomposeView
            local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DecomposeView.Name)
            if view then
                view:UpdateView(true)
            end
        end
    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecomposeView.Name, 22, params)
    
end

function BeastIllustratedPanel:PopPowerUp()
    ---战力变化提示
    _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.Beast)
    local newPower = _G.StorageManager:GetInstance():GetPlayerPower()
    local offset = newPower - self.lastPower
    if offset > 0 then
        require "CommonTipManager".OpenPowerUpView(self.lastPower, offset)
        self.lastPower = newPower
    end
end

---按钮点击事件
function BeastIllustratedPanel:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_All" then
        self:SelectOrder(0)
    elseif name == "@_aorbtn_Order8" then
        self:SelectOrder(8)
    elseif name == "@_aorbtn_Order6" then
        self:SelectOrder(6)
    elseif name == "@_aorbtn_Order5" then
        self:SelectOrder(5)
    elseif name == "@_aorbtn_Order4" then
        self:SelectOrder(4)
    elseif name == "@_aorbtn_Decompose" then
        self:OpenDecomposeView()    
    elseif name == "@_aorbtn_Help" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 1002)
    elseif name == "@_aorbtn_AttrDetail" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TeamHallAttrBeastPanel.Name)
    end
end

function BeastIllustratedPanel:OnCloseDecompose(name)
    if name == _G.ConfigManager.ui_cfg.DecomposeView.Name then
        self:UpdateData()
    end
end

---重新打开界面时刷新
function BeastIllustratedPanel:OnEnable()
    self.lastPower = _G.StorageManager:GetInstance():GetPlayerPower()
    self:UpdateData()
end

---界面销毁
function BeastIllustratedPanel:OnDestroy()
    self.go_table = nil
    BeastModel:GetInstance():DisposeIllustratedFun()
    self:RemoveAllListener()
end

return BeastIllustratedPanel