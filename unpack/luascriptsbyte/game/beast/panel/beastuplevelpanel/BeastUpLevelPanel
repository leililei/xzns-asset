---@class BeastUpLevelPanel : Component	宠物列表界面
---@field go_table BeastUpLevelPanel_GoTable
local BeastUpLevelPanel = _G.BaseClass("BeastUpLevelPanel", _G.Component)
local BeastModel = require("BeastModel")

function BeastUpLevelPanel:__init(obj, data)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    ---@type BeastData
    self.data = data
    self.upLevel = 1
    self.oldLevel = self.data.level
    self.lastPower = _G.StorageManager:GetInstance():GetPlayerPower()
    self.fakeConsume = {}
    self:AddListener(_G.eItemUpdata.Updata, self.UpdateBtn, self)
end

function BeastUpLevelPanel:OnCreate()
    _G.SetEventTrigger(self.go_table.aorbtn_UpLevel, "onLongPress", _G.handlerbind(self, self.OnLongPress))
    _G.SetEventTrigger(self.go_table.aorbtn_UpLevel, "onUp", _G.handlerbind(self, self.OnUp))
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.BeastDevelopView.Name)
    if view then
        view:SetUpdateFun(_G.ConfigManager.ui_cfg.BeastUpLevelPanel.Name, _G.handler(self, self.UpdateData))
    end
    self:UpdateView()
end

function BeastUpLevelPanel:OnEnable()
    self.lastPower = _G.StorageManager:GetInstance():GetPlayerPower()
end

---更新数据
function BeastUpLevelPanel:UpdateData(data, notUpdatePower)
    self.data = data
    self.endPress = false
    self.star = self.data:GetStar()
    self:UpdateView()
    if notUpdatePower then
        return
    end
    self.upLevel = 1
    self.oldLevel = self.data.level
    self.data:UpdateAttribute()
end

---更新页面
function BeastUpLevelPanel:UpdateView()
    self:UpdateBtn()
end

---更新升级按钮
function BeastUpLevelPanel:UpdateBtn()
    local btnImg = self.go_table.aorbtn_UpLevel:GetComponentE(_G.typeof(_G.CS.AorImage))
    if self.data:IsMaxLevel() then
        btnImg.SpriteName = "ui_ty_kuang_02"
        self.go_table.obj_UpLevel:SetActiveE(0)
        self.go_table.aortext_IsMax:SetActiveE(1)
        self.go_table.aortext_UpLevel:SetActiveE(0)
        self.go_table.aorbtn_Reset:SetActiveE(1)
        return
    else
        btnImg.SpriteName = "ui_ty_kuang_00"
        self.go_table.obj_UpLevel:SetActiveE(1)
        self.go_table.aortext_IsMax:SetActiveE(0)
        self.go_table.aortext_UpLevel:SetActiveE(1)
    end
    self.go_table.aorbtn_Reset:SetActiveE(self.data.level > 1 and 1 or 0)
    local consume = self.data:GetUpLevelConsume()
    for k, v in ipairs(consume) do
        local tb = _G.GetAutoGoTable(self.go_table["obj_Res" .. k], _G.handlerbind(self, self.OnClickRes, v.id))
        tb.aorrawimage_Icon:LoadImage(
                _G.StorageManager:GetInstance():GetItemIcon(v.id),
                function(img)
                    img:SetNativeSize()
                end
        )
        local _, storageId = _G.StorageManager:GetInstance():CheckSidType(v.id)
        local num = _G.StorageManager:GetInstance():GetItemCountByID(storageId, v.id)
        if self.fakeConsume[v.id] then
            num = num - self.fakeConsume[v.id]
        end
        local color = num >= v.num and "65CE69" or "FF7272"
        tb.aortext_Num.text = _G.GameUtil.NumberWY(num) .. "<color=#FFFFFF>/" .. _G.GameUtil.NumberWY(v.num) .. "</color>"
        tb.aortext_Num.color = _G.ColorTools.FormatColorByString(color)
    end
    --切换界面的时候延迟一帧刷新，防止宽度更新不及时
    _G.DelayFrameDo(function()
        _G.GameUtil.ReBuildRTF(self.go_table.trans_ResRoot)
    end)
end

---刷新培养界面
function BeastUpLevelPanel:RefreshDevelopView(data, notUpdatePower)
    if not notUpdatePower then
        self:PopPowerUp()
    end
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.BeastDevelopView.Name)
    if view then
        view:UpdateData(data and data.cfg.id or self.data.cfg.id, true, notUpdatePower)
    end
end

---用于实时更新消耗的假消耗
function BeastUpLevelPanel:FakeConsumeItem(id, num)
    if not self.fakeConsume[id] then
        self.fakeConsume[id] = 0
    end
    self.fakeConsume[id] = self.fakeConsume[id] + num
end

---点击材料事件
function BeastUpLevelPanel:OnClickRes(go, isOn, id)
    require("CommonTipManager"):GetInstance():OpenTip(self.go_table.gameObject, id)
end

---按钮点击事件
function BeastUpLevelPanel:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Reset" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BeastResetLevelView.Name, self.data, _G.handler(self, self.RefreshDevelopView))
    end
end

---结束长按升级按钮事件
function BeastUpLevelPanel:OnUp(go, isOn)
    if self.isUpping then--没有返回数据前点击按钮不处理
        return
    end
    local maxLevel = self.data:GetMaxLevel()
    if self.upLevel == 0 or self.data:GetLevel() == maxLevel then
        return
    end
    local newLevel = self.oldLevel + self.upLevel
    if newLevel >= maxLevel then
        newLevel = maxLevel
    end
    local canUp = self.data:IsCanLevelUp(newLevel, true)
    if canUp then
        self.isUpping = true
        BeastModel:GetInstance():UpLevel(
            self.data.sid,
                newLevel,
            function(data)
                local consume = data:GetUpLevelConsume(newLevel)
                for _, v in pairs(consume) do
                    local num = v.num
                    if self.fakeConsume[v.id] then
                        num = num + self.fakeConsume[v.id]
                    end
                    _G.StorageManager:GetInstance():ConsumeItem(v.id, 0, num)
                end
                self.fakeConsume = {}
                data:UpLevel(newLevel)
                self.oldLevel = newLevel
                self.endPress = false
                self.isUpping = nil
                self:PopPowerUp()
                self:RefreshDevelopView(data)
                self.go_table.obj_BgEff:RemoveAllChildren()
                _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_shengshoushengji,self.go_table.obj_BgEff)
            end
        )
    else
        self.endPress = false
        self.upLevel = 1
    end
    if self.endPress then
        self.longPress = false
    end
end

---长按升级按钮事件
function BeastUpLevelPanel:OnLongPress(go, isOn)
    if not self.data or self.endPress then
        return
    end
    if self.upLevel >= self.data:GetMaxLevel() then
        self.upLevel = self.data:GetMaxLevel()
        return
    end
    local canUp = self.data:IsCanLevelUp(self.data:GetLevel() + 1, false, self.fakeConsume)
    if not canUp or self.data:GetLevel() + 1 == self.data:GetMaxLevel() then
        self.upLevel = _G.math.max(self.upLevel - 1, 1)
        self.endPress = true
        self:OnUp()
        return
    end
    if not self.longPress then
        self.longPress = true
    end
    self.upLevel = self.upLevel + 1--策划需求长按时更新等级数据，长按的时候假升级，结束再发升级数据
    local consume = self.data:GetUpLevelConsume()
    for _, v in pairs(consume) do
        self:FakeConsumeItem(v.id, v.num)--假消耗
    end
    self.data:UpLevel()
    self:RefreshDevelopView(self.data,true)
    self.go_table.obj_BgEff:RemoveAllChildren()
    --_G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_shengshoushengji,self.go_table.obj_BgEff)
end

function BeastUpLevelPanel:PopPowerUp()
    ---战力变化提示
    _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.Beast)
    local newPower = _G.StorageManager:GetInstance():GetPlayerPower()
    local offset = newPower - self.lastPower
    if offset ~= 0 then
        require "CommonTipManager".OpenPowerUpView(self.lastPower, offset)
        self.lastPower = newPower
    end
end

---界面销毁
function BeastUpLevelPanel:OnDestroy()
    self.go_table = nil
    self:RemoveListener(_G.eItemUpdata.Updata, self.UpdateBtn, self)
end

return BeastUpLevelPanel