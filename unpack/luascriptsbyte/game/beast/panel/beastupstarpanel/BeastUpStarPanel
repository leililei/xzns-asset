---@class BeastUpStarPanel : Component	宠物列表界面
---@field go_table BeastUpStarPanel_GoTable
local BeastUpStarPanel = _G.BaseClass("BeastUpStarPanel", _G.Component)
local BeastModel = require("BeastModel")

function BeastUpStarPanel:__init(obj, data)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    ---@type BeastData
    self.data = data
    self.lastPower = _G.StorageManager:GetInstance():GetPlayerPower()
    self:AddListener(_G.eItemUpdata.Updata, self.UpdateBtn, self)
end

function BeastUpStarPanel:OnCreate()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.BeastDevelopView.Name)
    if view then
        view:SetUpdateFun(_G.ConfigManager.ui_cfg.BeastUpStarPanel.Name, _G.handler(self, self.UpdateData))
    end
    self:UpdateView()
end

function BeastUpStarPanel:OnEnable()
    self.lastPower = _G.StorageManager:GetInstance():GetPlayerPower()
end

---更新数据
function BeastUpStarPanel:UpdateData(data)
    self.data = data
    self:UpdateView()
end

---更新页面
function BeastUpStarPanel:UpdateView()
    self:UpdateSkill()
    self:UpdateBtn()
end

---更新潜能信息
function BeastUpStarPanel:UpdateSkill()
    if self.data:IsMaxStar() then
        return
    end
    local nextCfg = self.data.cfg.skill_id[self.data:GetStar() + 2]
    local curCfg = self.data.cfg.skill_id[self.data:GetStar() + 1]
    local type = 0
    if curCfg[1] ~= nextCfg[1] then
        type = 1
    elseif curCfg[2] ~= nextCfg[2] then
        type = 2
    end
    local skillCfg = _G.ConfigManager.attribute_cfg[nextCfg[3]]
    self.go_table.aorrawimage_Skill:LoadImage(skillCfg.icon)
    local skillText = self.go_table.obj_SkillText:GetComponentE(_G.typeof(_G.CS.ExtendText))
    if type == 1 then
        skillText.text = _G.GetLangPackValue(_G.ConfigManager.card_skills_cfg[nextCfg[1]].describe1)
    elseif type == 2 then
        skillText.text = _G.GetLangPackValue(_G.ConfigManager.card_skills_cfg[nextCfg[2]].describe1)
    elseif type == 0 then
        skillText.text = _G.GetLangPackValue(_G.ConfigManager.attribute_cfg[nextCfg[3]].describe)
    end
end

---更新升星按钮
function BeastUpStarPanel:UpdateBtn()
    if self.data:IsMaxStar() then
        self.go_table.obj_UpStar:SetActiveE(0)
        self.go_table.obj_IsMax:SetActiveE(1)
        return
    else
        self.go_table.obj_UpStar:SetActiveE(1)
        self.go_table.obj_IsMax:SetActiveE(0)
    end
    local costItem = self.data:GetCostItem()
    local count, need, _ = self.data:GetCost()
    local resItem = require("ItemViewNew").New(self.go_table.obj_Chip)
    resItem:Show(costItem)
    local color = count >= need and "1ACC55" or "FF7272"
    self.go_table.aortext_Num.text = count .. "<color=#FFFFFF>/" .. need .. "</color>"
    self.go_table.aortext_Num.color = _G.ColorTools.FormatColorByString(color)
    _G.GameUtil.ReBuildRTF(self.go_table.trans_ResRoot)
    self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.BeastList.id, self.data.sid)
end

---刷新培养界面
function BeastUpStarPanel:RefreshDevelopView(data)
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.BeastDevelopView.Name)
    if view then
        view:UpdateData(data and data.cfg.id or self.data.cfg.id, true)
    end
end

---点击材料事件
function BeastUpStarPanel:OnClickRes(go, isOn, id)
    require("CommonTipManager"):GetInstance():OpenTip(self.go_table.gameObject, id)
end

function BeastUpStarPanel:PopPowerUp()
    ---战力变化提示
    _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.Beast)
    local newPower = _G.StorageManager:GetInstance():GetPlayerPower()
    local offset = newPower - self.lastPower
    if offset > 0 then
        require "CommonTipManager".OpenPowerUpView(self.lastPower, offset)
        self.lastPower = newPower
    end
end

---按钮点击事件
function BeastUpStarPanel:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_UpStar" then
        if self.data:IsMaxStar() then
            return
        end
        local canUp = self.data:IsCanStarUp()
        if canUp then
            BeastModel:GetInstance():UpStar(
                    self.data.sid,
                    self.data:GetStar() + 1,
                    function(data)
                        self:RefreshDevelopView(data)
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BeastStarUpView.Name, self.data)
                        self:PopPowerUp()
                    end
            )
        else
            local quickUse = self.data.cfg.quick_use
            local useItem = nil
            for _, v in ipairs(quickUse) do
                local _, storageId = _G.StorageManager:GetInstance():CheckSidType(v)
                if _G.StorageManager:GetInstance():GetItemCountByID(storageId, v) > 0 then
                    useItem = _G.StorageManager:GetInstance():GetItemDataByID(storageId, v)
                end
            end
            if useItem then--有可快速使用的道具时使用
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.BagChoosePropTipView.Name,
                    useItem,
                    _G.handler(self, self.UpdateBtn)
                )
            else
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.data.cfg.materials_item)
            end
            
        end
    end
end

---界面销毁
function BeastUpStarPanel:OnDestroy()
    self.go_table = nil
    self:RemoveListener(_G.eItemUpdata.Updata, self.UpdateBtn, self)
end

return BeastUpStarPanel