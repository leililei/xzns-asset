        end
    end
    if hasNoWish then
        _G.PopWindowManager:GetInstance():ShowAllTips(
                271501,
                nil,
                function()
                    self:OnClickWishBtn()
                end
        )
    else
        self:Draw(type)
    end
end

---按钮点击事件在这里派发
function BeastDrawPanel:OnClickBtn(go)
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DrawAwardView.Name)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 121)
    elseif go == self.go_table.aorbtn_Draw1 then
        self:ClickDrawBtn(DrawType.one, not window)
        if window then
            window.View:Close()
        end
    elseif go == self.go_table.aorbtn_Draw2 then
        self:ClickDrawBtn(DrawType.ten, not window)
        if window then
            window.View:Close()
        end
    elseif go == self.go_table.aorbtn_Draw3 then
        self:ClickDrawBtn(DrawType.rmb, not window)
        if window then
            window.View:Close()
        end
    elseif go == self.go_table.aorbtn_autoLeft then
        self:UpdateDrawPlayBtn(1 - self.playType)
    elseif go == self.go_table.aorbtn_Privilege then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LimitedTimePrivilegeView.Name, 405101)
    elseif go == self.go_table.aorbtn_TipsView then
        if self.NowShowIndex == nil then
            return
        end
        self:ShowItems(self.NowShowIndex, false)
    elseif go == self.go_table.aorbtn_AD then
        require("AdvertisementModel"):GetInstance():VideoAD(_G.AdvertisementType.PetDraw, _G.handler(self, self.UpdateDrawBtn))
    elseif go == self.go_table.aorbtn_gift then
        self:ChangeBtnSO(true)
        _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.SpiritualDrawGiftPackView.Name,
                nil,
                _G.ActivitySubType.Beast
        )
    elseif go == self.go_table.aorbtn_awards then
        -- 累计招募领奖界面
        self:ChangeBtnSO(true)
        _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.DrawGiftPackToggleView.Name,
                nil,
                _G.ActivitySubType.Beast
        )
    end
end

