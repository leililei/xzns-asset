end

---刷新抽卡按钮icon
function BeastDrawPanel:UpdateDrawBtn()
    --region 多次招募
    local isFirst = _G.PlayerPrefsManager.GetInt("BeastFirstDraw", 0) == 0
    -- 招募道具数量
    local lastTimes = BeastModel:GetInstance():GetLastDiamondTimes()
    local sid, num, discount = BeastModel:GetInstance():GetDiamondCurrencyByType(1)
    local midNum = _G.StorageManager:GetInstance():GetItemCountBySid(self.itemSid)
    if isFirst and midNum > 1 then
        midNum = 1
    end
    local freeCount = BeastModel:GetInstance():GetDayFreeCount()
    self.midNum = midNum
    local mIcon = ItemCfg[self.itemSid].Icon
    local diamondIcon = _G.StorageManager:GetInstance():GetItemIcon(sid)
    local leftIsDiamond = lastTimes > 0 and (midNum == 0 and freeCount == 0)
    self.leftIsDiamond = leftIsDiamond
    local rightIsDiamond = lastTimes >= 10 and midNum == 0
    self.rightIsDiamond = rightIsDiamond

    self.go_table.aortext_Prop1Num.text = leftIsDiamond and num or 1
    self.go_table.aortext_Prop2Num.text = rightIsDiamond and num * 10 or
            (midNum > 0 and (midNum <= 10 and midNum or 10) or 10)
    self.go_table.aortext_Prop2NumDesc.text = _G.GetLangPackValue(90031300043,
            GameUtil.NumberToWordByLanguage(rightIsDiamond and 10 or
                    (midNum > 0 and (midNum <= 10 and midNum or 10) or 10)))
    self.drawNum = midNum > 0 and (midNum <= 10 and midNum or 10) or 10
    -- 红点
    self.go_table.obj_hongDian:SetActiveE(self.midNum >= 10 and 1 or 0)
    --endregion

    --region 图标加载
    self.go_table.aorrawimage_Prop1:LoadImage(
            leftIsDiamond and diamondIcon or mIcon,
            function(image)
                if image and self.isFree then
                    image:SetActiveE(1)
                end
            end
    )
    self.go_table.aorrawimage_Prop2:LoadImage(
            rightIsDiamond and diamondIcon or mIcon,
            function(image)
                if image then
                    image:SetActiveE(1)
                end
            end
    )
    ---广告按钮
    -- if require("AdvertisementModel"):GetInstance():CheckADShow(_G.AdvertisementType.PetDraw) then
    --     self.go_table.aorbtn_AD:SetActiveE(1)
    --     local nowTimes = require("AdvertisementModel"):GetInstance():GetADTimes(_G.AdvertisementType.PetDraw)
    --     local maxTimes = require("AdvertisementModel"):GetInstance():GetAdMax(_G.AdvertisementType.PetDraw)
    --     self.go_table.aortext_AD.text = nowTimes > 1 and _G.GetLangPackValue(90000011734, nowTimes, maxTimes) or _G.GetLangPackValue(90000011733)
    -- else
    --     self.go_table.aorbtn_AD:SetActiveE(0)
    -- end
    if freeCount > 0 then
        self.go_table.aortext_Prop1Num:SetActiveE(0)
        self.go_table.aorrawimage_Prop1:SetActiveE(0)
        self.go_table.obj_freeBG:SetActiveE(1)
        self.go_table.aortext_free1.text = _G.GetLangPackValue(92010089021, freeCount, _G.ConfigManager.item_roller_cfg[200100].free_day)
    else
        self.go_table.aortext_Prop1Num:SetActiveE(1)
        self.go_table.aorrawimage_Prop1:SetActiveE(1)
        self.go_table.obj_freeBG:SetActiveE(0)
    end
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BeastFreeTimes.id)
end

---设置积分
function BeastDrawPanel:SetScoreView()
    self.score = BeastModel:GetInstance():GetDrawScore()
    self.go_table.aortext_nowActive.text = self.score
    local curIndex = 0
    for i = 1, 4 do
        self:SetScoreAwardItem(i)
        if self.score >= self.rewardsCount[i] then
            curIndex = i
        end
    end
    ---0 528
    local width = 132 * curIndex
    self.go_table.aorimage_activeSchedule:SetRectTransformSize(width, 12)
end

function BeastDrawPanel:SetScoreAwardItem(index)
    if not self.AwardList[index] then
        self.AwardList[index] = _G.GetAutoGoTable(self.go_table["obj_award" .. index], _G.handlerbind(self, self.OnClickAwardBtn, index))
    end
    local goTable = self.AwardList[index]
    local score = self.rewardsCount[index]
    goTable.aortext_num.text = score
    local isGet = BeastModel:GetInstance():IsGetAwardByIndex(index)
    goTable.obj_mask:SetActiveE(isGet and 1 or 0)
    local canGet = not isGet and self.score >= score
    goTable.obj_Eff:SetActiveE(canGet and 1 or 0)
    goTable.obj_Light:SetActiveE(canGet and 1 or 0)
    --local isOpen = isGet or canGet
    --goTable.aorimage_icon:SetActiveE(isOpen and 1 or 0)
    --goTable.aorimage_iconClose:SetActiveE(isOpen and 0 or 1)
end

