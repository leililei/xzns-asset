function BeastDrawPanel:__init(gameObject)
    self.go_table = _G.GetAutoGoTable(gameObject)
end

function BeastDrawPanel:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.cfgid = 200100
    self.itemSid = _G.ConfigManager.item_roller_cfg[self.cfgid].ticket[1]
    self.wishObj = {}
    self.AwardList = {}
    self.Rewards_item = _G.ConfigManager.item_roller_cfg[self.cfgid].rewards_item
    self.rewardsCount = _G.ConfigManager.item_roller_cfg[self.cfgid].rewards_count
    self.isXzns = _G.AppSetting.IsXzns
    _G.Events:GetInstance():AddListener(_G.eAdvertisement.Refresh, self.UpdateDrawBtn, self)
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.UpdateDrawBtn, self)
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.ResRefresh, self.UpdateDrawBtn, self)
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.ShowWithItem, self)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
end

---界面的入口函数
function BeastDrawPanel:OnCreate(doneCall, closeCall)
    _G.GameUtil.SetUiHeXieMask(self.go_table)
    base.OnCreate(self, doneCall, closeCall)
    --显示货币信息
    if not _G.IsNil(self.go_table.obj_goldInfo) and self.go_table.obj_goldInfo:GetctiveInHierarchy() == 1 then
        local currencySid = _G.ConfigManager.ui_cfg.BeastDrawPanel.resources
        self:AddComponent(
                self.go_table.obj_goldInfo,
                require("ResourceCompont").New(self.go_table.obj_goldInfo, currencySid)
        )
    end
    self.playerHead = self:AddComponent(
            self.go_table.obj_PlayerHead,
            require("PlayerComponent").New(self.go_table.obj_PlayerHead)
    )
    if require("MonthlyModel"):GetInstance():IsOutTimePopUp(405101) then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LimitedTimePrivilegeView.Name, 405101)
        _G.PopWindowManager:GetInstance():ShowAllTips(240310)
    end
    self.NowShowIndex = 99
    local cfg = _G.ConfigManager.store_month_cfg[405101]
    if not cfg or (cfg.review == 1 and _G.AppSetting.IsArraigned) then
        self.go_table.aorbtn_Privilege:SetActiveE(0)
    else
        self.go_table.aorbtn_Privilege:SetActiveE(1)
    end

    self.go_table.aorbtn_gift:SetActiveE(_G.AppSetting.IsArraigned and 0 or 1)
    self.go_table.aorbtn_awards:SetActiveE(_G.AppSetting.IsArraigned and 0 or 1)

    self:LoadSpine()
    self:LoadDiamondTimes()
    self:UpdateDrawBtn()
    self:ShowWish()
    -- self:SetScoreView()
    self:UpdateDrawPlayBtn()
    self:PlayAni()
    self:SetNeedCount()
    self:AddListener(_G.eLimitePrivilege.LimitePrivilegeChange, self.PrivilegeChange, self)
    self:AddListener(_G.eBeastDraw.BeastDrawWishRefresh, self.ShowWish, self)
    self:AddListener(_G.eSixUpdate.SixClockUpdate, self.PrivilegeChange, self)

    self:SetCumulativeAwardsViewRedPoint()
    --self:LoadEffect()
    _G.DelayFrameDo(
            function()
                self:ChangeBtnSO(true)
            end
    )
end

function BeastDrawPanel:OnUIClosed(name)
    if name == _G.ConfigManager.ui_cfg.DrawAwardView.Name then
        self:ChangeBtnSO(true)
    end
end

function BeastDrawPanel:OnUIOpened(name)
    if name == _G.ConfigManager.ui_cfg.DrawAwardView.Name then
        self.go_table.obj_ClickMask:SetActiveE(0)
        self:ChangeBtnSO(false)
    end
    if name == _G.ConfigManager.ui_cfg.LimitedTimePrivilegeView.Name then--打开特权界面还原按钮层级
        self:ChangeBtnSO(true)
    end
end

function BeastDrawPanel:LoadSpine()
    if self.isXzns then
        _G.PoolsManager:GetInstance():Spawn(
                "WX_Role/Animation_UI/Shengshouzhaohuan_UI/prf_Shengshouzhaohuan_UI_ui",
                _G.ePoolType.Temporary,
                self.go_table.obj_role,
                function(role)
                    self.SpineAni = role:GetChildE(0):GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
                    GameUtil.SetCardUiSpineAnimation1(self.SpineAni, "idle", true)
                    self.SpineAniAsset = self.SpineAni.SkeletonDataAsset:GetSkeletonData(false)
                end
        )
    end
end

function BeastDrawPanel:PlaySpineAni(name)
    if not self.go_table or not self.SpineAni or _G.AppSetting.HeXieLevel > 0 then
        return
    end
    local animation = self.SpineAniAsset:FindAnimation(name)
    if not animation then
        return
    end
    self.SpineAni.startingAnimation = name
    self.SpineAni:Initialize(true)
    local default = "idle"
    if name ~= default then
        local duration = animation.Duration
        _G.DelayDo(duration, function()
            if self.go_table and self.SpineAni then
                self.SpineAni.startingAnimation = default
                self.SpineAni:Initialize(true)
            end
        end)
    end
end

function BeastDrawPanel:LoadEffect()
    local check = function(trans)
