function BeastDrawPanel:Dispose()
    self:RemoveAllListener()
    _G.Events:GetInstance():RemoveListener(_G.eAdvertisement.Refresh, self.UpdateDrawBtn, self)
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.UpdateDrawBtn, self)
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.ResRefresh, self.UpdateDrawBtn, self)
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.ShowWithItem, self)
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    self.isClose = true
end

return BeastDrawPanel
