---加载魂玉召唤次数信息
function BeastDrawPanel:LoadDiamondTimes()
    --获取魂玉召唤次数信息
    local usedTimes = BeastModel:GetInstance():GetDailyTimes()
    local totalTimes = BeastModel:GetInstance():GetDailyMaxTimes()
    self.go_table.obj_diamondTimes:SetActiveE(totalTimes > 0 and 1 or 0)
    if totalTimes <= 0 then
        return
    end

    local remain = totalTimes - usedTimes
    self.go_table.aortext_remainDiamondTimes.text = _G.GetLangPackValue(90000011298, remain .. "/" .. totalTimes)
end

function BeastDrawPanel:PrivilegeChange()
    self:LoadDiamondTimes()
    self:ShowWish()
    self:UpdateDrawBtn()
end

function BeastDrawPanel:ShowWish()
    local data = require "PrivilegeManager":GetInstance():GetPrivilegeData({ _G.PrivilegeType.LimitedTimePrivilege.BeastDrawWish })
    self.go_table.obj_Privilege:SetActiveE(data[1] and 1 or 0)
    self.go_table.obj_ring1:SetActiveE(data[1] and 1 or 0)
    --self.go_table.aorrawimage_noPrivilege:SetActiveE(data[1] and 0 or 1)
    if not data[1] then
        return
    end
    local wishs = BeastModel:GetInstance():GetWishsids()
    --ZHJH-3048 心愿单数量改为1
    local k = 1
    local v = wishs[k]
    if not self.wishObj[k] then
        self.wishObj[k] = _G.GetAutoGoTable(self.go_table["obj_ring" .. k], _G.handlerbind(self, self.OnClickWishBtn, k))
        --self.wishObj[k].obj_hongDian:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.BeastDrawWish.id, k)
    end
    if v ~= 0 then
        self.cfg = _G.ConfigManager.pet_xzns_cfg[v]
        local path = ""
        if self.cfg then
            path = self.cfg.image_1
        end
        self.wishObj[k].aorrawimage_role:LoadImage(
                path,
                function(role)
                    role:SetNativeSize()
                    local width, height = role.transform:GetRectTransformWidthHeight()
                    local max = _G.math.max(width, height)
                    role:SetLocalScaleXYZ(200 / max)
                end)
        self.wishObj[k].aorrawimage_role:SetActiveE(1)
        self.wishObj[k].obj_no:SetActiveE(0)
    else
        self.wishObj[k].aorrawimage_role:SetActiveE(0)
        self.wishObj[k].obj_no:SetActiveE(1)
    end
    self.wishObj[k].obj_hongDian:SetActiveE(0)
    if not self.InitEffectObj then
        --self:InitEffect()
        self.InitEffectObj = true
    end
    if _G.AppSetting.IsXzns then
        self:ShowWithItem()
    end
end

function BeastDrawPanel:ShowWithItem()
    local data = require "PrivilegeManager":GetInstance():GetPrivilegeData({ _G.PrivilegeType.LimitedTimePrivilege.BeastDrawWish })
    if not data[1] then
        self.go_table.obj_beast:SetActiveE(0)
        return
    end
    local beastData = require("BeastModel"):GetInstance():GetBeast(BeastModel:GetInstance():GetWishsids()[1])
    if not beastData then
        self.go_table.obj_beast:SetActiveE(0)
        return
    end
    self.go_table.obj_beast:SetActiveE(1)
    if not self.withItem then
        self.wishItem = require("ItemBeastBase").New(self.go_table.obj_item)
        self.wishItemSliderTb = _G.GetAutoGoTable(self.go_table.slider_jindu)
    end
    self.wishItem:Show(beastData:GetID(), beastData:GetStar())
    local count, need = beastData:GetCost()
    self.wishItemSliderTb.aortext_Slider.text = _G.GetLangPackValue(90033900019, count, need)
    self.go_table.slider_jindu.value = count / need
end

function BeastDrawPanel:SetNeedCount()
    self.go_table.aortext_num.text = _G.GetLangPackValue(90031300063, BeastModel:GetInstance():GetWishNeedCounts())
    if self.isXzns then
        self.go_table.aortext_num2.text = BeastModel:GetInstance():GetWishNeedCounts()
        _G.GameUtil.ReBuildRTF(self.go_table.obj_Tips2)
        self:ShowWithItem()
