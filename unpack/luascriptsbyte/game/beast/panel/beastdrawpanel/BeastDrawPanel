end

function BeastDrawPanel:InitEffect()
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_GodDrawView_big,
            self.wishObj[1].obj_ring,
            function(obj)
