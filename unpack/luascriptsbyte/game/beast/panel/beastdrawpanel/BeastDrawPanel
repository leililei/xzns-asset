---更新动画播放按钮
---@param type DrawPlayType
function BeastDrawPanel:UpdateDrawPlayBtn(type)
    if type == nil then
        self.playType = _G.PlayerPrefsManager.GetInt("BeastDrawSkip")
        if self.playType == nil then
            self.playType = DrawPlayType.Play
        end
    else
        self.playType = type
    end
    _G.PlayerPrefsManager.SetInt("BeastDrawSkip", self.playType)
    local isPlay = self.playType == DrawPlayType.Play
    self.go_table.aorimage_auto.gameObject:SetLocalPosition(isPlay and 30 or -30, 0, 0)
    self.go_table.aortext_wenzi.text = _G.ConfigManager.language_package_cfg[isPlay and DrawPlayText.Open or DrawPlayText.Close]
    self.go_table.aorimage_skip:SetActiveE(isPlay and 1 or 0)
end

