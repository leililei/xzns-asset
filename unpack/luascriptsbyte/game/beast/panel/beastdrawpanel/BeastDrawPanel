function BeastDrawPanel:ShowItems(Index, isGou)
    if Index == self.NowShowIndex and self.go_table.aorbtn_TipsView:GetActiveSelf() == 1 then
        self.go_table.aorbtn_TipsView:SetActiveE(0)
        return
    end

    -- _G.CS.UnityEditor.EditorApplication.isPaused = true;
    ---@type AorButton
    local btn = self.go_table["obj_award" .. Index]
    if btn ~= nil then
        local x, y, z = btn:GetPosition()
        if self.isXzns then
            self.go_table.obj_ItemTips:SetPosition(x, y + 0.5, z)
        else
            self.go_table.obj_ItemTips:SetPosition(x, y * 1.1, z)
        end
    end

    local item = self.Rewards_item[Index]
    local NowItems = {}
    for i = 1, #item / 2 do
        _G.table.insert(NowItems, { item[i * 2 - 1], item[i * 2] })
    end

    self.NowShowIndex = Index

    if self.go_table.aorbtn_TipsView:GetActiveSelf() == 0 then
        self.go_table.aorbtn_TipsView:SetActiveE(1)
    end

    self.go_table.obj_Parent:ClearChildren()
    for i = 1, #NowItems do
        local info = NowItems[i]
        local num = info[2]
        self:CareatItem(info, isGou, self.go_table.obj_Parent, function(item)
        end)
    end
    ---@type UnityEngine.RectTransform
    -- local rect =  self.go_table.obj_itemBg:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    self.go_table.obj_itemBg:SetRectTransformSize((#NowItems) * 75, 80)
    self.go_table.obj_ItemTips:SetRectTransformSize((#NowItems) * 75, 80)
    _G.UIUtils.SetOffScreenRectPosition(self.go_table.obj_ItemTips)
end

function BeastDrawPanel:CareatItem(data, isGou, Parent, backCall)
    if _G.IsNil(Parent) or Parent:GetctiveInHierarchy() == 0 then
        return
    end
    local Sid = data[1]

    if Sid ~= _G.ResPropID.ActiveAch and Sid ~= _G.ResPropID.ActiveValue then
        -- body
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
                data,
                Parent,
                function(item)
                    if _G.IsNil(Parent) then
                        _G.DestroyImmediate(item.gameObject)
                        return
                    end
                    item.gameObject:SetLocalScaleXYZ(0.5)
                    item.gameObject:SetActiveE(1)
                    item:SetPri(data.isPri)
                    item:SetGou(isGou)
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    if item.SetGradeNew then
                        item:SetGradeNew(false)
                    end
                    if backCall then
                        backCall(item)
                    end
                end,
                function(go, isOn)
                    require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, Sid)
                end
        )
    end
    --end
end

---抽！
function BeastDrawPanel:Draw(type)
    local draw = function(counsumeType, drawNum, freeBol)
        self.go_table.obj_ClickMask:SetActiveE(1)
        local preNeedCount = BeastModel:GetInstance():GetWishNeedCounts()
        self.isClick = true
        BeastModel:GetInstance():Draw(
                drawNum,
                counsumeType,
                function(msg)
                    if msg.ack ~= 1 then
                        return
                    end

                    self:UpdateDrawBtn()
                    self:LoadDiamondTimes()
                    self:SetNeedCount()
                    -- self:SetScoreView()
                    self:SetCumulativeAwardsViewRedPoint()
                    if msg.award.item then
                        -- _G.table.sort(
                        --     msg.award.item,
                        --     function(a, b)
                        --         local cfgA = ConfigManager.item_cfg[a.type[1]]
                        --         local cfgB = ConfigManager.item_cfg[b.type[1]]
                        --         if cfgA.Quality ~= cfgB.Quality then
                        --             return cfgA.Quality > cfgB.Quality
                        --         elseif a.type[2] ~= b.type[2] then
                        --             return a.type[2] > b.type[2]
                        --         else
                        --             return a.type[1] > b.type[1]
                        --         end
                        --     end
                        -- )
                    end
                    if msg.award.overflow then
                        -- _G.table.sort(
                        --     msg.award.overflow,
                        --     function(a, b)
                        --         local cfgA = ConfigManager.item_cfg[a.type[1]]
                        --         local cfgB = ConfigManager.item_cfg[b.type[1]]
                        --         if cfgA.Quality ~= cfgB.Quality then
                        --             return cfgA.Quality > cfgB.Quality
                        --         elseif a.type[2] ~= b.type[2] then
                        --             return a.type[2] > b.type[2]
                        --         else
                        --             return a.type[1] > b.type[1]
                        --         end
                        --     end
                        -- )
                    end
                    if self.playType == DrawPlayType.Play and self.isBtnDraw then
                        local isLegend = msg.need_count > preNeedCount - drawNum
                        self:PlayDrawEffect({ award = msg.award }, isLegend)
                    else
                        --[[                    _G.UIManager:GetInstance():OpenWindow(
                            _G.ConfigManager.ui_cfg.CommonAwardView.Name,
                            {award = msg.award},
                            nil,
                            true,
                            nil,
                            nil,
                            nil,
                            nil,
                            true
                        )]]
                        _G.UIManager:GetInstance():OpenWindow(
                                _G.ConfigManager.ui_cfg.DrawAwardView.Name,
                                msg,
                                _G.handler(self, self.ClickDrawBtn),
                                true,
                                nil,
                                nil,
                                nil,
                                nil,
                                true,
                                nil,
                                nil,
                                nil,
                                nil,
                                { ItemCfg[self.itemSid].Icon, self.drawNum }
                        )
                    end
                    _G.DelayDo(0.5, function()
                        self.isClick = false
                    end)
                end,
                freeBol
        )
    end

    local counsumeType = type == DrawType.one and (self.leftIsDiamond and 2 or 1) or (self.rightIsDiamond and 2 or 1)
    local num = type == DrawType.one and 1 or
            self.rightIsDiamond and 10 or (self.midNum > 0 and (self.midNum <= 10 and self.midNum or 10)) or 10
    if counsumeType == 1 then
        if type == DrawType.one and BeastModel:GetInstance():GetDayFreeCount() > 0 then
            draw(3, 1, true)
            return
        end
        if not _G.StorageManager:GetInstance():CheckItem(self.itemSid, num) then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.itemSid)
            return
        end
        ---抽卡次数不足1次后重置打开界面的红点
        local remainNum = _G.StorageManager:GetInstance():GetItemCountBySid(self.itemSid) - num
        local recordNum = _G.PlayerPrefsManager.GetInt("BeastDrawRedPoint")
        if remainNum == 0 then
            _G.PlayerPrefsManager.DeleteKey("BeastDrawRedPoint")
        elseif recordNum > 0 then
            --如果剩余数量不为0且记录值也大于0则更新记录值
            _G.PlayerPrefsManager.SetInt("BeastDrawRedPoint", remainNum)
        end
        draw(counsumeType, num)
    elseif counsumeType == 2 then
        if BeastModel:GetInstance():GetLastDiamondTimes() >= num then
            local rmbSid, numNeed = BeastModel:GetInstance():GetDiamondCurrencyByType(num)

            if not _G.StorageManager:GetInstance():CheckItem(rmbSid, numNeed) then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, rmbSid)
                return
            end

            _G.PopWindowManager:GetInstance():ShowBtnWindowByToggle(
                    632,
                    function()
                        draw(counsumeType, num)
                    end,
                    function()
                    end,
                    nil,
                    true,
                    numNeed,
                    num,
                    _G.GetLangPackValue(_G.ConfigManager.item_cfg[self.itemSid].Name),
                    num
            )
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(19)
        end
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("灵兽召唤收到未定义召唤类型")
            return
        end
    end
end

---点击召唤按钮
---@param type DrawType 召唤类型
function BeastDrawPanel:ClickDrawBtn(type, isBtnDraw)
    if self.isClick == true then
        return
    end
    if type == nil then
        self:ChangeBtnSO(true)
        return
    end
    self:ChangeBtnSO(false)
    self.isBtnDraw = isBtnDraw == nil and true or isBtnDraw
    local wishs = BeastModel:GetInstance():GetWishsids()
    local hasNoWish = false
    local data = require "PrivilegeManager":GetInstance():GetPrivilegeData(
