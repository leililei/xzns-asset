-- 刷新列表
-- @param index 索引
-- @param listView2 列表视图
-- @return gotable 列表项
function BeastDrawPanel:RefreshList(index, listView2)
    -- 如果索引小于0，则返回
    if index < 0 then
        return
    end
    index = index + 1
    -- 获取列表项的自动化对象
    local gotable = _G.GetAutoGoTable(listView2, _G.handlerbind(self, self.Diane, index))

    -- 如果索引大于等于奖励数量加1，则设置空对象不可见
    if index >= _G.table.count(self.Rewards_count) + 1 then
        gotable.obj_Nil:SetActiveE(0)
    else
        gotable.obj_Nil:SetActiveE(1)
        local num = self.Rewards_count[index]
        gotable.aortext_num.text = num

        local nuts = 0
        -- 获取限定奖池配置
        local artifact_pools_cfg = require "ArtifactDrawUpMainModel":GetInstance():Getartifact_pools_cfg(self.ActivityID)
        -- 根据奖励数量查找对应的奖池索引
        for key, value in pairs(artifact_pools_cfg.rewards_count) do
            if num == value then
                nuts = key
            end
        end
        -- 获取领取状态
        local LingQu = require "ArtifactDrawUpMainModel":GetInstance():GetLingQu(self.ActivityID, nuts)

        if not LingQu then
            gotable.obj_mask:SetActiveE(0)
        else
            gotable.obj_mask:SetActiveE(1)
        end

        -- 获取总次数配置数据
        local GetCfgData = require "ArtifactDrawUpMainModel":GetInstance():GetTotalTimes(self.ActivityID)

        -- 如果未领取且达到领取条件，则显示特效，隐藏图标
        if GetCfgData >= num and not LingQu then
            gotable.obj_Eff:SetActiveE(1)
            gotable.aorrawimage_icon:SetActiveE(0)
            self.CountMax = index - 1
        else
            gotable.aorrawimage_icon:SetActiveE(1)
            gotable.obj_Eff:SetActiveE(0)
        end
    end

    return gotable
end

-- Diane函数用于处理抽奖界面的点击事件
-- 参数: _ (any) - 未使用的参数
-- 参数: _ (any) - 未使用的参数
-- 参数: index (number) - 抽奖索引
function BeastDrawPanel:Diane(_, _, index)
    local num = self.Rewards_count[index] -- 获取奖励数量
    local item = self.Rewards_item[index] -- 获取奖励物品
    -- 奖励对应的关键字
    local nuts
    -- 获取抽奖配置
    local artifact_pools_cfg = require "ArtifactDrawUpMainModel":GetInstance():Getartifact_pools_cfg(self.ActivityID)
    for key, value in pairs(artifact_pools_cfg.rewards_count) do
        if num == value then
            nuts = key -- 根据奖励数量获取关键字
        end
    end
    -- 判断是否已领取
    local LingQu = require "ArtifactDrawUpMainModel":GetInstance():GetLingQu(self.ActivityID, nuts)
    local GetCfgData = require "ArtifactDrawUpMainModel":GetInstance():GetTotalTimes(self.ActivityID) -- 获取总次数
    -- 判断是否满足领取条件
    if GetCfgData >= num and not LingQu then
        require "ArtifactDrawUpMainModel":GetInstance():GetAwarddata(
                self.ActivityID,
                nuts,
                function()
                    self:Sharing() -- 领取奖励并分享
                end
        )
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardPreView.Name, { { item[1], item[2] } }) -- 打开奖励预览窗口
    end
end

