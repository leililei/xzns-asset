---@class BeastFetterPanel : Component	中文描述
---@field public go_table BeastFetterPanel_GoTable GoTable
local BeastFetterPanel = _G.BaseClass("BeastFetterPanel", _G.Component)
local TeamHallAttrItem = require("TeamHallAttrItem")

local nameColor = {
    [4] = _G.ColorTools.FormatColorByString("bf9af7"),
    [5] = _G.ColorTools.FormatColorByString("ff9b5e"),
    [6] = _G.ColorTools.FormatColorByString("ff655b"),
    [8] = _G.ColorTools.FormatColorByString("c8beff")
}

function BeastFetterPanel:__init(gameObject)
    self.go_table = _G.GetAutoGoTable(gameObject,_G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function BeastFetterPanel:OnCreate()
    self.cfgs = _G.table.toArray(_G.ConfigManager.pet_fetter_xzns_cfg)
    self.power = _G.StorageManager:GetInstance():GetPlayerPower()
    self.go_table.scrollloopvectical_fetterList:InitItemData(0,
        _G.handler(self, self.RefreshList))
end

function BeastFetterPanel:OnEnable()
    self.go_table.obj_tip:SetActiveE(0)
    self.power = _G.StorageManager:GetInstance():GetPlayerPower()
    self:UpdatePanel()
end

function BeastFetterPanel:UpdatePanel()
    self:SortData()
    self.go_table.scrollloopvectical_fetterList:UpdateCount(_G.table.count(self.cfgs))
    self:UpdateAttribute()
end

function BeastFetterPanel:UpdateAttribute()
    local manager = require("TeamHallAttrManager")
    self.fetterAttr, self.hasFetter = manager.GetAttribute(
        require("BeastFetterModel"):GetInstance():GetBeastFetterAttribute()
    )
    if not self.hasFetter then
        self.go_table.obj_Empty:SetActiveE(1)
        return
    end
    self.go_table.obj_Empty:SetActiveE(0)
    if not self.initAttr then
        self.attrList = {}
        self.go_table.scrollloopvectical_propList:InitItemData(#self.fetterAttr, _G.handler(self, self.RefreshAttr))
        self.initAttr = true
    else
        self.go_table.scrollloopvectical_propList:UpdateCount(#self.fetterAttr)
    end
end

function BeastFetterPanel:SortData()
    local allList = require("BeastModel"):GetInstance():GetAllBeastsBySort()
    self.cfgs =  _G.table.chooseToArray(self.cfgs,function(k,v)
        for _, id in pairs(v.pets) do
            local out = true
            for _, data in pairs(allList) do
                if data.sid == id then
                    out = false
                    break
                end
            end
            if out then
                return false
            end
        end
        return true
    end)
    _G.SortList(
        self.cfgs,
        function(cfg)
            local isCanGet = require("BeastFetterModel"):GetInstance():CheckCanActiveFetter(cfg.id)
            return isCanGet , -cfg.id
        end
    )
end

function BeastFetterPanel:RefreshList(index, obj)
    if index < 0 then
        return
    end
    index = index + 1 
    local go = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.FetterClick, index))
    go.cfg = self.cfgs[index]
    go.index = require("BeastFetterModel"):GetInstance():GetFetterIndex(go.cfg.id)
    local minStar = 9999
    local item
    go.obj_beastList:RemoveAllChildren()
    for _, v in pairs(go.cfg.pets) do
        local data = require("BeastModel"):GetInstance():GetBeast(v)
        minStar = _G.math.min(minStar, data:GetIsActive() and data:GetStar() or -1)
        item = _G.InstantiateObject(go.obj_beast, go.obj_beastList)
        local itemGoTable = _G.GetAutoGoTable(item,_G.handlerbind(self,self.OnClickBeast,data))
        itemGoTable.aortext_name.text = data:GetName()
        itemGoTable.aortext_name.color = nameColor[data:GetOrder()]
        if data:GetStar() <= 5 then
            for i = 1, 5 do
                itemGoTable["aorimage_star" .. i]:SetActiveE(i <= data:GetStar() and 1 or 0)
            end
        else
            for i = 6, 10 do
                itemGoTable["aorimage_star" .. i - 5].SpriteName = i <= data:GetStar() and "ui_ss_icon_xing_hong" or "ui_ss_icon_xing_normal"
                itemGoTable["aorimage_star" .. i - 5]:SetActiveE(i <= data:GetStar() and 1 or 0)
            end
        end
        _G.PoolsManager:GetInstance():Spawn(
            _G.ConfigManager.card_cfg[data:GetID()].spine[1],
            _G.ePoolType.Temporary,
            itemGoTable.obj_root,
            function(trans)
                if not self.go_table then
                    _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.Temporary)
                    return
                end
                trans:GetChildE(0):SetPivotPosition(0.5,0)
                --trans:GetChildE(0):SetRectTransformSize(100,500)
                if not data:GetIsActive() then
                    local sg = trans:GetChildE(0):GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
                    sg.color = _G.ColorTools.FormatColorByString("7f7f7f")
                end
            end
        )
    end

    if go.index <= 0 then
        go.aortext_title.text = _G.GetLangPackValue(go.cfg.name)
    else
        -- XXXX LV.1
        go.aortext_title.text = _G.GetLangPackValue(go.cfg.name) .. " " .. _G.GetLangPackValue(90033800028, go.index)
    end
    go.obj_items:RemoveAllChildren()
    if go.index == -1 then
        if #go.cfg.reward1 ~= 0 then        
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                go.cfg.reward1[1],
                go.obj_items,
                function(obj)
                    if not self.go_table then
                        _G.DestroyObject(obj)
                        return
                    end
                    obj:ShowNumText(true,require("ItemViewBase").NumTextAnchor.RightDown)
                end
            )
            go.obj_items:SetActiveE(1)
        else
            go.obj_items:SetActiveE(0)
        end
        local finish, count1, count2 = require("BeastFetterModel"):GetInstance():GetProgressText(1, go.cfg.id)
        local str = _G.string.format("(<color=#%s>%s</color>/%s)",(count1 < count2 and "f1644b" or "5c6069"),count1,count2)
        if #go.cfg.att1 ~= 0 then
            for _, v in pairs(go.cfg.att1) do
                str = str .. '\n'
                str = str .. _G.AttrType[v[1]].des .. " "
                if _G.tonumber(v[2]) == 2 then
                    str = str .. (v[3] / 100) .. "%"
                else
                    str = str .. (_G.AttrType[v[1]].percentage == 0 and v[3] or ((v[3] / 100) .. "%"))
                end
            end
        end
        go.aortext_content:SetActiveE(1)
        go.aortext_content.text = _G.GetLangPackValue(go.cfg["desc" .. 1]) .. str
        go.aorbtn_click:SetActiveE(1)
        go.aortext_Operation:SetActiveE(1)
        if minStar < go.cfg["condition_star" .. 1] then
            go.aorbtn_click:SetGray(true)
            go.aorbtn_click.interactable = false
        else
            go.aorbtn_click:SetGray(false)
            go.aorbtn_click.interactable = true
        end
    elseif go.cfg["condition_star" .. go.index + 1] then
        if #go.cfg["reward"..go.index + 1] ~= 0 then
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                go.cfg["reward"..go.index + 1][1],
                go.obj_items,
                function(obj)
                    if not self.go_table then
                        _G.DestroyObject(obj)
                        return
                    end
                    obj:ShowNumText(true,require("ItemViewBase").NumTextAnchor.RightDown)
                end
            )
            go.obj_items:SetActiveE(1)
        else
            go.obj_items:SetActiveE(0)
        end
        local finish, count1, count2 = require("BeastFetterModel"):GetInstance():GetProgressText(go.index + 1, go.cfg.id)
        local str = _G.string.format("(<color=#%s>%s</color>/%s)",count1 < count2 and "f1644b" or "5c6069",count1,count2)
        if #go.cfg["att"..go.index + 1] ~= 0 then
            for _, v in pairs(go.cfg["att"..go.index + 1]) do
                str = str .. '\n'
                str = str .. _G.AttrType[v[1]].des .. " "
                if _G.tonumber(v[2]) == 2 then
                    str = str .. (v[3] / 100) .. "%"
                else
                    str = str .. (_G.AttrType[v[1]].percentage == 0 and v[3] or ((v[3] / 100) .. "%"))
                end
            end
        end
        go.aortext_content:SetActiveE(1)
        go.aortext_content.text = _G.GetLangPackValue(go.cfg["desc" .. go.index + 1]) .. str
        go.aorbtn_click:SetActiveE(1)
        go.aortext_Operation:SetActiveE(1)
        if minStar < go.cfg["condition_star" .. go.index + 1] then
            go.aorbtn_click:SetGray(true)
            go.aorbtn_click.interactable = false
        else
            go.aorbtn_click:SetGray(false)
            go.aorbtn_click.interactable = true
        end
    else
        go.aortext_content:SetActiveE(0)
        go.aorbtn_click:SetActiveE(0)
        go.aortext_Operation:SetActiveE(0)
    end
end

function BeastFetterPanel:RefreshAttr(index, obj)
    index = index + 1
    local attr = self.fetterAttr[index]
    local isPrecent = attr.percentage == 2
    local tb = self.attrList[index]
    if not tb then
        tb = self:AddComponent(
            obj,
            TeamHallAttrItem.New(
                attr.des,
                attr.num,
                attr.icon,
                isPrecent,
                isPrecent
            )
        )
        self.attrList[index] = tb
    else
        tb:OnCreate(
            attr.des,
            attr.num,
            attr.icon,
            isPrecent,
            isPrecent
        )
    end
end

function BeastFetterPanel:FetterClick(obj, _, index)
    local cfg = self.cfgs[index]
    local name = obj:GetName()
    if name == "@_aorbtn_click" then
        ---可以解锁，点击解锁
        local maxIndex = require("BeastFetterModel"):GetInstance():GetActiveMaxIndex(cfg.id)
        require("BeastFetterModel"):GetInstance():FetterActive(cfg.id, maxIndex,
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BeastFetterPage.id)
                self:UpdatePanel()
                ---战力变化提示
                _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.BeastFetter)
                local newPower = _G.StorageManager:GetInstance():GetPlayerPower()
                local offset = newPower - self.power
                if offset > 0 then
                    require "CommonTipManager".OpenPowerUpView(self.power, offset)
                    self.power = newPower
                end
            end
        )
    elseif name == "@_aorbtn_info" then
        self:OpenTip(index)
    end
end

function BeastFetterPanel:OnClickBeast(_,_,data)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.BeastDevelopView.Name,
        data,
        {data:GetID()},
        _G.handler(self,self.UpdatePanel)
    )
end

---按钮点击事件在这里派发
function BeastFetterPanel:OnClickBtn(go)
    if go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 122)
    end
end

--region 羁绊详情信息tip

function BeastFetterPanel:OpenTip(index)
    local cfg = self.cfgs[index]
    self.go_table.obj_tip:SetActiveE(1)
    if not self.tipTb then
        self.tipTb = _G.GetAutoGoTable(self.go_table.obj_tip, _G.handler(self, self.CloseTip))
        self.tipTb.itemList = {}
    end
    self.tipTb.aortext_title.text = _G.GetLangPackValue(cfg.name)
    for i = 1, 6 do
        if cfg["condition_star" .. i] then
            if not self.tipTb.itemList[i] then
                self.tipTb.itemList[i] = _G.GetAutoGoTable(_G.InstantiateObject(self.tipTb.obj_item,
                    self.tipTb.obj_content))
                self.tipTb.itemList[i].gameObject:SetName(i)
            end
            self.tipTb.itemList[i].gameObject:SetActiveE(1)
            local finish, count1, count2 = require("BeastFetterModel"):GetInstance():GetProgressText(i, cfg.id)
            local str
            if finish then
                self.tipTb.itemList[i].aortext_lv.color = _G.ColorTools.FormatColorByString("ffffff")
                self.tipTb.itemList[i].aortext_award.color = _G.ColorTools.FormatColorByString("c7c2c2")
                self.tipTb.itemList[i].aortext_lv.text =
                    _G.GetLangPackValue(90020600039, i) ..
                    " " ..
                    _G.GetLangPackValue(cfg["desc" .. i])
            else
                self.tipTb.itemList[i].aortext_lv.color = _G.ColorTools.FormatColorByString("aeb0b8")
                self.tipTb.itemList[i].aortext_award.color = _G.ColorTools.FormatColorByString("87888f")
                if count1 == count2 then
                    str = _G.string.format("(%s/%s)", count1, count2)
                else
                    str = _G.string.format("<color=#f1674b>(%s/%s)</color>", count1, count2)
                end
                self.tipTb.itemList[i].aortext_lv.text =
                    _G.GetLangPackValue(90020600039, i) ..
                    " " ..
                    _G.GetLangPackValue(cfg["desc" .. i]) ..
                    str
            end
            str = ""
            if #cfg["att" .. i] > 0 then
                for _, v in pairs(cfg["att" .. i]) do
                    str = str .. _G.AttrType[v[1]].des .. "+"
                    if _G.tonumber(v[2]) == 2 then
                        str = str .. (v[3] / 100) .. "%" .. " "
                    else
                        str = str .. (_G.AttrType[v[1]].percentage == 0 and v[3] or ((v[3] / 100) .. "%")) .. " "
                    end
                end
                if not _G.string.IsNullOrEmpty(str) then
                    if finish then
                        str = "<color=#e18e00>" .. str
                    else
                        str = "<color=#9c722a>" .. str
                    end
                    str = str .. "</color>"
                end
                self.tipTb.itemList[i].aortext_award.text = str
            elseif #cfg["reward"..i] > 0 then
                for _, v in pairs(cfg["reward"..i]) do
                    str = str .. _G.StorageManager:GetInstance():GetItemName(v[1]) .. "*" .. v[2]
                end
                if not _G.string.IsNullOrEmpty(str) then
                    if finish then
                        str = "<color=#e18e00>" .. str
                    else
                        str = "<color=#9c722a>" .. str
                    end
                    str = str .. "</color>"
                end
                self.tipTb.itemList[i].aortext_award.text = str
            else
                self.tipTb.itemList[i].aortext_award.text = ""
            end
        else
            if self.tipTb.itemList[i] then
                self.tipTb.itemList[i]:SetActiveE(0)
            end
        end
    end
end

function BeastFetterPanel:CloseTip()
    self.go_table.obj_tip:SetActiveE(0)
end

--endregion

return BeastFetterPanel
