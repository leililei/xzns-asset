local base = require("BaseGameNet")

---@class BeastNet : BaseGameNet	通信协议
local BeastNet = _G.BaseClass("BeastNet", base)
---@return BeastNet BeastNet
function BeastNet:GetInstance()
    return base.GetInstance(self)
end

--region ------------- 圣兽 -------------

---获取圣兽信息
function BeastNet:GetBeastInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_beast_beast_info
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

