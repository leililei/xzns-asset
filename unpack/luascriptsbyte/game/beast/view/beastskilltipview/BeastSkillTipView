---@class BeastSkillTipView : Component	中文描述
local BeastSkillTipView = _G.BaseClass("BeastSkillTipView", _G.Component)

function BeastSkillTipView:__init(trans, view)
    self.go_table = _G.GetAutoGoTable(trans, _G.handler(self, self.OnClickBtn))
    self.view = view
end

function BeastSkillTipView:Init(data, skillId)
    self.data = data
    self.skillId = skillId
    self:ShowSkill()
end

function BeastSkillTipView:ShowSkill()
    local skillCfg = _G.ConfigManager.card_skills_cfg[self.skillId]
    local skillList, type = self:GetSkillList()
    self.go_table.aortext_beastSkillName.text = _G.GetLangPackValue(skillCfg.name1)
    if type == 1 then
        self.go_table.aortext_beastSkillContent.text = _G.GetLangPackValue(90049300002)
    elseif type == 2 then
        self.go_table.aortext_beastSkillContent.text = _G.GetLangPackValue(90049300003)
    end
    self.go_table.aorrawimage_skill:LoadImage(skillCfg.icon,function(trans)
        if not self.go_table then
            return
        end
        trans:SetNativeSize()
    end)
    self:BindExtendText(self.go_table.obj_skillText, _G.GetLangPackValue(_G.ConfigManager.card_skills_cfg[skillList[1]].describe1))
    self.go_table.obj_skill:SetActiveE(1)
    local isShow = false
    local skillSet = {}
    for k, v in pairs(skillList) do
        if k ~= 1 and not skillSet[v] then
            k = k - 1
            isShow = true
            local item = _G.InstantiateObject(self.go_table.obj_starSkill,self.go_table.obj_starRoot)
            local go = _G.GetAutoGoTable(item)
            if k <= 5 then
                for i = 1, 5 do
                    go["aorimage_star" .. i]:SetActiveE(i <= k and 1 or 0)
                end
            else
                for i = 6, 10 do
                    go["aorimage_star" .. i - 5].SpriteName = i <= k and "ui_ss_icon_xing_hong" or "ui_ss_icon_xing_normal"
                    go["aorimage_star" .. i - 5]:SetActiveE(i <= k and 1 or 0)
                end
            end
            self:BindExtendText(go.obj_starSkillText,_G.GetLangPackValue(_G.ConfigManager.card_skills_cfg[v].describe1))
            item:SetActiveE(1)
        end
        skillSet[v] = v
        if v == self.skillId then
            break
        end
    end
    self.go_table.obj_skill:SetActiveE(isShow and 1 or 0)
end

function BeastSkillTipView:BindExtendText(ExtendText, text)
    local skillDesExText = ExtendText:GetComponentE(_G.typeof(_G.CS.ExtendText))
    skillDesExText.text = text
    skillDesExText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))
end

---点击超链接
function BeastSkillTipView:OnHrefClick(id, name, asa)
    local rect = self.go_table.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    local posX, posY = rect:GetRectTransformWidthHeight()
    require("CommonTipManager"):GetInstance():OpenSkillHyper(_G.tonumber(id), nil, posX, posY)
end

function BeastSkillTipView:GetSkillList()
    local skill_1 = self.data:GetSkill_1()
    local skill_2 = self.data:GetSkill_2()
    if _G.table.ContainsValue(skill_1, self.skillId) then
        return skill_1, 1
    elseif _G.table.ContainsValue(skill_2, self.skillId) then
        return skill_2, 2
    else
        return {}, 0
    end
end

function BeastSkillTipView:OnClickBtn()
    self:CloseTips()
end

function BeastSkillTipView:CloseTips()
    self.gameObject:SetActiveE(0)
    self.view:CloseTip(_G.TipType.EquipmentCommendOnly)
end

return BeastSkillTipView
