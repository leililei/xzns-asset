---@class BeastCardItem	中文描述
---@field go_table BeastCardItem_GoTable
local BeastCardItem = _G.BaseClass("BeastCardItem")


local OrderBgEnum = {
    [4] = "ImagesH5/hBeast/ui_sslb_card_zi",
    [5] = "ImagesH5/hBeast/ui_sslb_card_cheng",
    [6] = "ImagesH5/hBeast/ui_sslb_card_hong",
    [8] = "ImagesH5/hBeast/ui_sslb_card_cai"
}

local EffectEnum = {
    [6] = _G.ConfigManager.ui_effect_cfg.ef_kapailiuguang_red,
    [8] = _G.ConfigManager.ui_effect_cfg.ef_sskapailiuguang_cai,
}

---类的构造函数
function BeastCardItem:__init(obj)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.isGou = false
end

---类的析构函数
function BeastCardItem:Dispose()
    self.isGou = nil
end

function BeastCardItem:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_Click" then
        if self.click then
            self.click(self.clickParams)
        end
    end
end

---参数显示
---@param sid number 圣兽sid
---@param click function 点击回调
function BeastCardItem:Show(sid, click, ...)
    self.sid = sid
    self.click = click
    self.clickParams = {...}
    self:SetData()
end

---设置或更新数据
function BeastCardItem:SetData(sid)
    ---@type BeastData
    self.data = require("BeastModel"):GetInstance():GetBeast(sid or self.sid)
    self.star = self.data:GetStar() or 0
    self.level = self.data:GetLevel() or 1
    self.order = self.data:GetOrder()
    self.isActive = self.data:GetIsActive()
    self.isCanGet = self.data:IsCanGet()
    self.isCanStarUp = self.data:IsCanStarUp()
    self:ShowInfo()
end

---设置显示信息
function BeastCardItem:ShowInfo()
    self.go_table.aortext_Level.text = self.level
    require("BeastModel"):GetInstance():ShowStar(self.go_table, self.star)
    self.go_table.aorimage_Type.SpriteName = require("BeastModel"):GetInstance().BeastProfessional[self.data.cfg.professional]
    self.go_table.aortext_Name.text = self.data:GetName()
    self.go_table.aorrawimage_bg:LoadImage(
        OrderBgEnum[self.order],
        function(img)
            img:SetNativeSize()
        end
    )
    self.go_table.aorrawimage_Img:LoadImage(
        self.data:GetImage(),
        function(img)
            local pos = self.data:GetImageShift()
            img:SetNativeSize()
            img:SetLocalScaleXYZ(pos[4])
            img:SetLocalPosition(pos[1], pos[2], pos[3])
        end
    )
end

---显示品质边框特效
function BeastCardItem:ShowEffect()
    self.go_table.obj_uieffect:RemoveAllChildren()
    local effect = EffectEnum[self.order]
    if effect then
        _G.UIUtils.LoadEffectByCfg(
            effect,
            self.go_table.obj_uieffect,
            function(trans)
                if not self.go_table then
                    _G.DestroyImmediate(trans)
                    return
                end
                trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
            end
        )
    end
end

function BeastCardItem:ShowBlackStar()
    for i = 1, 5 do
        if self.star < i then
            self.go_table["aorimage_blackStar"..i]:SetActiveE(1)
        else
            self.go_table["aorimage_blackStar"..i]:SetActiveE(0)
        end
    end
end

---显示未激活、可激活、可升星等状态（列表内使用）
function BeastCardItem:ShowState()
    self.go_table.aorrawimage_Mask:SetActiveE((not self.isActive or self.isCanGet) and 1 or 0)--未激活和可激活时都要显示黑色遮罩
    self.go_table.aorimage_LevelBg:SetActiveE(self.isActive and 1 or 0)--未激活时不显示等级
    self.go_table.aorimage_StarBg:SetActiveE(self.isActive and 1 or 0)--未激活时不显示星级
    self.go_table.aorimage_StarBg:SetActiveE(self.star > 0 and 1 or 0)--0星时不显示星级
    self.go_table.aorimage_IsCanGet:SetActiveE(self.isCanGet and 1 or 0)--可激活时显示
    self.go_table.aorimage_IsCanStarUp:SetActiveE((self.isCanStarUp and self.isActive) and 1 or 0)--激活后可升星时显示
end

return BeastCardItem
