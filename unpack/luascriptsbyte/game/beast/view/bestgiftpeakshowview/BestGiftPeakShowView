---@class BestGiftPeakShowView : UIBaseView	中文描述
---@field public go_table BeastDevelopView_GoTable GoTable
local BestGiftPeakShowView = _G.BaseClass("BestGiftPeakShowView", _G.UIBaseView)
local BeastModel = require("BeastModel"):GetInstance()

function BestGiftPeakShowView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function BestGiftPeakShowView:OnCreate(activity)
    self.activity= activity
    local expend=activity.cfg.info.front.expend
    self.activityExpend={}
    for i = 1, #expend do
        self.activityExpend[expend[i].name]=expend[i].value
    end
    self.data=BeastModel:GetBeast(tonumber(self.activityExpend["petid"]))
    self.go_table.aorrawimage_bg:LoadImage(self.activityExpend["bg"],function(img) 
        img:SetNativeSize()
    end)
    self.go_table.aorrawimage_title:LoadImage(self.activityExpend["title"],function(img)
        img:SetNativeSize()
    end)
    
    self:InitView()
end

---初始化界面
function BestGiftPeakShowView:InitView()
    self:UpdateSpine()
    self:UpdateInfo()
    self:UpdateSkill()
end
---更新spine
function BestGiftPeakShowView:UpdateSpine()
    local spinestr=self.activityExpend["spine"]
    local spinelist=string.split(spinestr,"#")
    self.go_table.obj_role:RemoveAllChildren()
    _G.PoolsManager:GetInstance():Spawn(
            spinelist[1],
            _G.ePoolType.UIItem,
            self.go_table.obj_role,
            function(trans)
                if not self.go_table then
                    _G.DestroyObject()
                    return
                end
                trans:SetLocalPosition(tonumber(spinelist[2]),tonumber(spinelist[3]),tonumber(spinelist[4]))
                trans:SetLocalScaleXYZ(tonumber(spinelist[5]))
            end
    )
end

---更新圣兽信息
function BestGiftPeakShowView:UpdateInfo()
    local professional = BeastModel.BeastProfessional[self.data.cfg.professional]
    self.go_table.aorimage_Type.SpriteName = professional
    self.go_table.aortext_name.text = self.data:GetName()
    local position=0
    for i = 1, 3 do
        if self.data.cfg["pet_position" .. i]>0 then
            position = self.data.cfg["pet_position" .. i]
        end
    end
    if position > 0 then
        self.go_table.aortext_Position.text = _G.GetLangPackValue(position)
    end
end


---更新技能信息
function BestGiftPeakShowView:UpdateSkill()
    self.skillList = self.data.cfg.skill_id[self.data:GetMaxStar() + 1]
    for i = 1, 3 do
        if self.skillList[i] == 0 then--配0的技能不显示
            self.go_table["obj_Skill" .. i]:SetActiveE(0)
        else
            self.go_table["obj_Skill" .. i]:SetActiveE(1)
            --local tb = _G.GetAutoGoTable(self.go_table["obj_Skill" .. i], _G.handlerbind(self, self.OnClickSkill, i))
            local tb = _G.GetAutoGoTable(self.go_table["obj_Skill" .. i])
            local skillCfg = i == 3 and
                    _G.ConfigManager.attribute_cfg[self.skillList[i]] or
                    _G.ConfigManager.card_skills_cfg[self.skillList[i]]
            if skillCfg then
                tb.aorrawimage_skill:LoadImage(skillCfg.icon)
            elseif _G.AppSetting.DEBUG then
                _G.LogError(self.skillList[i] .. "找不到技能配置，需要检查pet_xzns_cfg表")
            end
        end
    end
end
---按钮点击事件在这里派发
function BestGiftPeakShowView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeView then
        self:SaveIsReturn()
        self:Close()
    elseif go == self.go_table.aorbtn_skip then--跳转到招募
        self:SaveIsReturn()
        self:Close()
        _G.JumpManager:GetInstance():Jump(tonumber(self.activityExpend["jumpid"]))
    end
end
function BestGiftPeakShowView:SaveIsReturn()
    if self.go_table.toggle_eject.isOn then
        _G.PlayerPrefsManager.SetString(tostring(self.activity.activityID),tostring(_G.TimeUtil.GetServerUnixTime()))
    end
end

---点击技能事件
function BestGiftPeakShowView:OnClickSkill(go, isOn, index)
    if index == 3 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.PotencyTipView.Name, self.data)--宠物潜能Tips
    else
        require("CommonTipManager"):GetInstance():OpenBeastSkillTip(self.sid, self.skillList[index])--宠物技能Tips
    end
end


---界面的销毁函数
function BestGiftPeakShowView:OnDestroy()
end

return BestGiftPeakShowView