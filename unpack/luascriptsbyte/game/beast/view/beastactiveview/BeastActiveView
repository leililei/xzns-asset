---@class BeastActiveView : UIBaseView	中文描述
---@field public go_table BeastActiveView_GoTable GoTable
local BeastActiveView = _G.BaseClass("BeastActiveView", _G.UIBaseView)


function BeastActiveView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function BeastActiveView:OnCreate(data)
    self.sid = data.sid
    ---@type BeastData 
    self.data = data
    ---解锁时显示0星技能
    self.skillList = self.data.cfg.skill_id[1]
    self:InitView()
    self:InitSkill()
end

---初始化界面
function BeastActiveView:InitView()
    self.go_table.aortext_Name.text = self.data:GetName()
    _G.PoolsManager:GetInstance():Spawn(
        self.data:GetSpinePath(),
        _G.ePoolType.UIItem,
        self.go_table.obj_Spine,
        function(trans)
            if not self.go_table then
                _G.DestroyObject()
                return
            end
            local pos = self.data.cfg.spine_portrait2
            trans:SetLocalPosition(pos[1], pos[2], pos[3])
            trans:SetLocalScaleXYZ(pos[4])
        end
    )
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_jihuochenggong,
            self.go_table.obj_Eff
    )
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_shengchongzhanshi_blue,
            self.go_table.obj_Eff
    )
end

---初始化技能
function BeastActiveView:InitSkill()
    for i = 1, 3 do
        if self.skillList[i] == 0 then--配0的技能不显示
            self.go_table["obj_Skill" .. i]:SetActiveE(0)
        else
            self.go_table["obj_Skill" .. i]:SetActiveE(1)
            local tb = _G.GetAutoGoTable(self.go_table["obj_Skill" .. i], _G.handlerbind(self, self.OnClickSkill, i))
            local skillCfg = i == 3 and
                    _G.ConfigManager.attribute_cfg[self.skillList[i]] or
                    _G.ConfigManager.card_skills_cfg[self.skillList[i]]
            if skillCfg then
                tb.aorrawimage_skill:LoadImage(skillCfg.icon)
            elseif _G.AppSetting.DEBUG then
                _G.LogError(self.skillList[i] .. "找不到技能配置，需要检查pet_xzns_cfg表")
            end
        end
    end
end

---点击技能事件
function BeastActiveView:OnClickSkill(go, isOn, index)
    if index == 3 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.PotencyTipView.Name, self.data)--宠物潜能Tips
    else
        require("CommonTipManager"):GetInstance():OpenBeastSkillTip(self.sid, self.skillList[index])--宠物技能Tips
    end
end

---按钮点击事件在这里派发
function BeastActiveView:OnClickBtn(go)
    if go == self.go_table.aorbtn_Close then
        self:Close()
    end
end

---界面的销毁函数
function BeastActiveView:OnDestroy()
end

return BeastActiveView