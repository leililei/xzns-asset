---@class BeastMainView : UIBaseView	中文描述
---@field public go_table BeastMainView_GoTable GoTable
local BeastMainView = _G.BaseClass("BeastMainView", _G.UIBaseView)

local cfgDic = {
    [1] = {
        cfg = _G.ConfigManager.ui_cfg.BeastIllustratedPanel,
        iconName = "ui_ss_liebiao_",
        name = 9002090006,
        redpoint = _G.ConfigManager.redpoint_cfg.BeastList.id
    },
    [2] = {
       cfg = _G.ConfigManager.ui_cfg.BeastDrawPanel,
       iconName = "ui_ss_zhaomu_",
       name = 90049300030,
       redpoint = _G.ConfigManager.redpoint_cfg.BeastDrawButton.id
       },
    [3] = {
        cfg = _G.ConfigManager.ui_cfg.BeastFetterPanel,
        iconName = "ui_ss_tujian_",
        name = 90049300029,
        redpoint = _G.ConfigManager.redpoint_cfg.BeastFetter.id

    }
}

function BeastMainView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function BeastMainView:OnCreate(toggle, isOpenDecompose)
    self:InitView()
    self:InitToggle(toggle)
    if isOpenDecompose then
        local params = {}
        params.titleText = 91118100101
        params.ToggleCall = function(isOn)
            _G.PopWindowManager:GetInstance():ShowAllTips(isOn and 914104 or 914105)
            if isOn then
                ---@type DecomposeView
                local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DecomposeView.Name)
                if view then
                    view:UpdateView(true)
                end
            end
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecomposeView.Name, 22, params)
    end
end

function BeastMainView:InitView()
    self.panels = {}
    self.panelLuaList = {}
    self.curPanel = nil
    self.LayerSorting = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.BeastMainView.Name).LayerSorting
end

function BeastMainView:InitToggle(toggle)
    self.toggles = {}
    self.curToggle = nil
    if not toggle then
        toggle = 1
    end
    for k, v in ipairs(cfgDic) do
        local tb = _G.GetAutoGoTable(
                _G.InstantiateObject(self.go_table.toggle_Page, self.go_table.obj_ToggleContent),
                _G.handlerbind(self, self.OnClickToggle, v.cfg.Name)
        )
        tb.gameObject:SetName(tostring(k))
        tb.cfg = v.cfg
        tb.name = v.cfg.Name--页面名
        local name = _G.GetLangPackValue(v.name)--显示名
        tb.aorimage_isOffIcon.SpriteName = v.iconName .. "n_icon"
        tb.aorimage_isOnIcon.SpriteName = v.iconName .. "c_icon"
        tb.aortext_isOffName.text = name
        tb.aortext_isOnName.text = name
        if v.redpoint then
            tb.obj_redpoint:UpdateRedPointItemIDAndParam(v.redpoint)
        end
        _G.table.insert(self.toggles, tb)
        if toggle == k then
            tb.toggle_Page.isOn = true
            self:OnClickToggle(nil,nil,v.cfg.Name)
        end
    end
end

function BeastMainView:ChangeToggle(name)
    for _, v in pairs(self.toggles) do
        v.aorimage_isOffIcon:SetActiveE(name == v.name and 0 or 1)
        v.aorimage_isOnIcon:SetActiveE(name == v.name and 1 or 0)
        v.aortext_isOffName:SetActiveE(name == v.name and 0 or 1)
        v.aortext_isOnName:SetActiveE(name == v.name and 1 or 0)
        if name == v.name then
            self.curToggle = v--更新当前选中页签
        end
    end
    self:ChangePanel(self.curToggle)--根据当前选中页签切换界面
end

function BeastMainView:ChangePanel(toggle)
    local cfg = toggle.cfg
    if self.curPanel and self.curPanel.name == cfg.Name then--如果已经是目标界面则不处理
        return
    end
    if not self.panels[cfg.Name] then
        _G.PoolsManager:GetInstance():Spawn(
                cfg.PrefabPath,
                _G.ePoolType.UIItem,
                self.go_table.obj_PanelContent,
                function(panel)
                    if not panel or not self.go_table then
                        _G.DestroyObject(panel)
                        return
                    end
                    self.panelLuaList[cfg.Name] = self:AddComponent(panel, require(cfg.View).New(panel))
                    local tb = _G.GetAutoGoTable(self.panelLuaList[cfg.Name].gameObject)
                    self.panels[cfg.Name] = tb
                    tb.gameObject:GetComponentE(_G.typeof(_G.Canvas)).sortingOrder = self.LayerSorting--修改页面背景层级
                    tb.obj_Root:GetComponentE(_G.typeof(_G.Canvas)).sortingOrder = self.LayerSorting + 10--修改页面显示层级
                    if tb.obj_ClickMask then
                        tb.obj_ClickMask:GetComponentE(_G.typeof(_G.Canvas)).sortingOrder = self.LayerSorting + 200--修改页面遮罩层级
                    end
                    self:ShowPanel(cfg.Name)
                    self.curPanel = cfg.Name--更新当前显示页面
                end
        )
    else
        self:ShowPanel(cfg.Name)--已经加载过页面直接显示
        self.curPanel = cfg.Name--更新当前显示页面
    end
end

function BeastMainView:ShowPanel(name)
    for k, v in pairs(self.panels) do
        v.gameObject:SetActiveE(k == name and 1 or 0)
    end
end

function BeastMainView:GetPanelCtrl(name)
    for k, v in pairs(self.panelLuaList) do
        if k == name and not _G.IsNil(v) then
            return v
        end
    end
end

---按钮点击事件在这里派发
function BeastMainView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end

function BeastMainView:OnClickToggle(go, isOn, name)
    if self.curToggle and name == self.curToggle.name then
        return
    end
    self:ChangeToggle(name)
end

---界面的销毁函数
function BeastMainView:OnDestroy()
end

return BeastMainView