local ItemBeastBase = require("ItemBeastBase")
local base = require "EventViewBase"
---@class BeastWishListView : UIBaseView	灵兽心愿单
---@field public go_table BeastWishListView_GoTable GoTable
local BeastWishListView = _G.BaseClass("BeastWishListView", base)
local BeastDrawModel = require("BeastDrawModel")
local BeastModel = require("BeastModel")
local GetAutoGoTable = _G.GetAutoGoTable
local handlerbind = _G.handlerbind

function BeastWishListView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    ---可选中的数量
    self.selectPetNum = 1
    self.cfgid = 200100
    ---已选中Item
    self.selectPetItem = {}
    self.petItemList = {}
    self.petType = {
        [1] = "ui_zy_attack_icon",
        [2] = "ui_zy_defense_icon",
        [3] = "ui_zy_heal_icon"
    }
end

---界面的入口函数
function BeastWishListView:OnCreate(doneCall, closeCall)
    base.OnCreate(self, doneCall, closeCall)
    ---已选中的数据,0是未选择
    self.selectPetData = BeastDrawModel:GetInstance():GetWishsids()
    self.selecID = self.selectPetData[1]
    self:InitPetData()

    self:RefreshSelectPet()
end

---初始化数据
function BeastWishListView:InitPetData()
    self.wishItemData = _G.ConfigManager.item_roller_cfg[self.cfgid].wish_item
    self.go_table.scrollloopvectical_BeastList:InitItemData(#self.wishItemData,_G.handler(self,self.ShowItem))
end

function BeastWishListView:ShowItem(index, obj)
    local petSid = self.wishItemData[index + 1]
    ---@type BeastWishListView._obj_Item_GoTable
    local tb = GetAutoGoTable(obj, handlerbind(self, self.OnClickPet, petSid))
    if not self.petItemList[petSid] then
        self.petItemList[petSid] = tb
    end
    local data = BeastModel:GetInstance():GetBeast(petSid)

    if tb.obj_Root:GetChildCountE() == 0 then
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemBeastBase,
            tb.obj_Root,
            function(item)
                if _G.IsNil(tb.obj_Root) then
                    return
                end
                tb.lua = item
                item:Show(petSid, data.star)
                item:SetSize(95)
                item:HideLevel()
                item:ShowOrHideProfessional(false)
                if self.selecID == petSid then
                    tb.aorimage_choose:SetActiveE(1)
                else
                    tb.aorimage_choose:SetActiveE(0)
                end
                tb.lua:ShowStar(data:GetIsActive())
                tb.lua.go_table.aorrawimage_Icon:SetGray(not data:GetIsActive())
                tb.lua.go_table.aorimage_ColorBG:SetGray(not data:GetIsActive())
            end
        )
    else
        if tb.lua == nil then
            tb.lua = ItemBeastBase.New(tb.obj_Root:GetChildE())
        end
        tb.lua:Show(petSid, data.star)
        tb.lua:ShowStar(data:GetIsActive())
        tb.lua:SetSize(95)

        tb.lua.go_table.aorrawimage_Icon:SetGray(not data:GetIsActive())
        tb.lua.go_table.aorimage_ColorBG:SetGray(not data:GetIsActive())
        tb.lua:ShowOrHideProfessional(false)
    end
    if self.selecID == petSid then
        tb.aorimage_choose:SetActiveE(1)
    else
        tb.aorimage_choose:SetActiveE(0)
    end

    ---名字
    local pet_cfg = _G.ConfigManager.pet_xzns_cfg[petSid]
    tb.aortext_name.text = _G.LangUtil.GetLangPackValue(pet_cfg.name)
    tb.aorimage_typebg.SpriteName = self.petType[pet_cfg.professional]
    tb.aortext_tagName.text = _G.GetLangPackValue(pet_cfg.pet_position1)
    ---@type UnityEngine.UI.ScrollRect
    local scroll = self.go_table.scrollloopvectical_BeastList:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect))
    ---设置升级按钮 长按事件
    _G.SetEventTrigger(tb.aorbtn_clickObj, "onDown", _G.handler(self, self.OnDownEvent))
    _G.SetEventTrigger(tb.aorbtn_clickObj, "onDrag", function(s, event) scroll:OnDrag(event) end)
    _G.SetEventTrigger(tb.aorbtn_clickObj, "onDragEnd", function(s, event) scroll:OnEndDrag(event) end)
    _G.SetEventTrigger(tb.aorbtn_clickObj, "onDragBegin", function(s, event) scroll:OnBeginDrag(event) end)
    tb.aorbtn_clickObj.LongPress = true
    tb.aorbtn_clickObj.onLongPress = _G.handlerbind(self, self.OnLongPressEvent, petSid)
end

--按下事件
function BeastWishListView:OnDownEvent()
    if self.isLongPress then
        return
    end
    self.isLongPress = true
end

---长按事件
function BeastWishListView:OnLongPressEvent(petSid)
    if self.isLongPress then
        self.isLongPress = false
        require("CommonTipManager"):GetInstance():OpenTip(self.gameObject, petSid, nil, nil, true, true)
    end
end

---刷新
function BeastWishListView:ChangeProfession(petSid, isShow)
    if self.petItemList[petSid] then
        self.petItemList[petSid].aorimage_choose:SetActiveE(isShow and 1 or 0)
    end
end

---刷新选中的item
function BeastWishListView:RefreshSelectPet(index)
    if index then
        ---如果点击已选择的神器，则取消选择
        self.selectPetData[1] = 0
        local parentObj = self.go_table["aorbtn_select" .. 1]
        self.selectPetItem[parentObj:GetInstanceIDE()] = nil
        parentObj:ClearChildren()
        self:OnSend()
        return
    end

    for i = 1, self.selectPetNum do
        local parentObj = self.go_table["aorbtn_select" .. i]
        if self.selectPetData[i] > 0 and not self.selectPetItem[parentObj:GetInstanceIDE()] then
            local sid = self.selectPetData[i]
            self.go_table["obj_gou_" .. i]:SetActiveE(0)
        end
    end
end

---Item点击事件
---@param artifactSid number 神器sid
function BeastWishListView:OnClickPet(obj, isOn, petSid)
    if self.selecID == petSid then
        local data = _G.BeastData.New(petSid)
        data:Parse({star = 10,level = 200})
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BeastEmbattleTipView.Name,data,nil,nil,true)
    else
        self:ChangeProfession(self.selecID, false)
        self:ChangeProfession(petSid, true)
        self.selecID = petSid
    end
end

---按钮点击事件在这里派发
function BeastWishListView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_closeX then
        ---遮罩或者关闭按钮
        self:Close()
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 125)
    elseif go == self.go_table.aorbtn_sure then
        self:OnSend()
        self:Close()
    end
end

---发送消息
function BeastWishListView:OnSend()
    BeastDrawModel:GetInstance():SetWish({ self.selecID, 0, 0 })
end

return BeastWishListView
