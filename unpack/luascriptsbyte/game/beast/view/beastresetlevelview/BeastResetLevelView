---@class BeastResetLevelView : UIBaseView	中文描述
---@field public go_table BeastResetLevelView_GoTable GoTable
local BeastResetLevelView = _G.BaseClass("BeastResetLevelView", _G.UIBaseView)

function BeastResetLevelView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param data BeastData
function BeastResetLevelView:OnCreate(data, callback)
    ---@type BeastData
    self.data = data
    self.callback = callback
    self:InitView()
end

function BeastResetLevelView:InitView()
    local color = "<color=#AC490C>"
    self.go_table.aortext_tips.text = _G.GetLangPackValue(90020300092, 
         color .. _G.GetLangPackValue(self.data.cfg.name) .. "</color>"
    )
    local cfg = _G.ConfigManager.pet_level_xzns_cfg[self.data.level]["material" .. self.data.cfg.order]
    local ItemViewBase = require("ItemViewBase")
    for _, v in ipairs(cfg) do
        _G.StorageManager:GetInstance():GetItemBaseView(
            v[1],
            v[2],
            self.go_table.obj_item,
            function(item)
                item:ShowNumText(true, ItemViewBase.NumTextAnchor.RightDown)
            end
        )
    end
end

---按钮点击事件在这里派发
function BeastResetLevelView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Done then
        self:OnClickSure()
    elseif go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_CloseView2 then
        self:Close()
    end
end

function BeastResetLevelView:OnClickSure()
    if self.data == nil then
        return
    end
    self:StarSure()
end

function BeastResetLevelView:StarSure()
    require("BeastModel"):GetInstance():ResetLevel(
        self.data.cfg.id,
        function(data)
            if self.callback then
                self.callback(data)
            end
            self:Close()
        end
    )
end


return BeastResetLevelView
