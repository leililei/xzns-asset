---@class BeastDevelopView : UIBaseView	中文描述
---@field public go_table BeastDevelopView_GoTable GoTable
local BeastDevelopView = _G.BaseClass("BeastDevelopView", _G.UIBaseView)
local BeastModel = require("BeastModel"):GetInstance()

local cfgDic = {
    [1] = {
        cfg = _G.ConfigManager.ui_cfg.BeastUpLevelPanel,
        iconName = "ui_ss_shengji_",
        name = 90049300017
    },
    [2] = {
        cfg = _G.ConfigManager.ui_cfg.BeastUpStarPanel,
        iconName = "ui_ss_shengxing_",
        name = 90049300018,
        redpoint = _G.ConfigManager.redpoint_cfg.BeastList.id
    }
}

function BeastDevelopView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function BeastDevelopView:OnCreate(data, list, callback)
    self.updateFun = {}
    self.callback = callback
    self:InitData(data, list)
    self:UpdateData(self.sid)
    self:InitView()
    self:InitToggle()
end

---初始化数据
function BeastDevelopView:InitData(data, list)
    self.data = data
    self.sid = self.data.sid
    self.dataList = list
end

---初始化界面
function BeastDevelopView:InitView()
    self.panels = {}
    self.curPanel = nil
    self.LayerSorting = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.BeastDevelopView.Name).LayerSorting
end

---初始化页签
function BeastDevelopView:InitToggle()
    self.toggles = {}
    self.curToggle = nil
    for k, v in ipairs(cfgDic) do
        local tb = _G.GetAutoGoTable(
                _G.InstantiateObject(self.go_table.toggle_Page, self.go_table.obj_ToggleContent),
                _G.handlerbind(self, self.OnClickToggle, v.cfg.Name)
        )
        tb.cfg = v.cfg
        tb.name = v.cfg.Name--页面名
        local name = _G.GetLangPackValue(v.name)--显示名
        tb.aorimage_isOffIcon.SpriteName = v.iconName .. "n_icon"
        tb.aorimage_isOnIcon.SpriteName = v.iconName .. "c_icon"
        tb.aortext_isOffName.text = name
        tb.aortext_isOnName.text = name
        if v.redpoint then
            tb.obj_redpoint:UpdateRedPointItemIDAndParam(v.redpoint, self.sid)
        end
        _G.table.insert(self.toggles, tb)
    end
    ---默认选中第一个页签
    self:ChangeToggle(self.toggles[1].name)
    self.go_table.obj_ToggleContent:SetActiveE(self.isPreview and 0 or 1)
end

---更新数据
function BeastDevelopView:UpdateData(sid, notUpdateSpine, notUpdatePower)
    local listDic = {}
    self.curIndex = 0
    for k, v in ipairs(self.dataList) do
        listDic[v] = k
        if v == sid then
            self.curIndex = k
        end
    end
    self.sid = sid
    self.data = require("BeastModel"):GetInstance():GetBeast(sid)
    self.isPreview = not self.data:GetIsActive()
    local count = self.go_table.obj_PanelContent:GetChildCountE()
    if not self.isPreview then
        if count == 0 and self.toggles then--如果是从未激活点入后切换到已激活需要加载升级Panel
            self:ChangeToggle(self.toggles[1].name)
        end
        if not _G.table.isEmptyOrNil(self.toggles) then--切换圣兽时如果已经初始化了页签就修改页签的红点
            for k, v in pairs(self.toggles) do
                if cfgDic[k].redpoint then
                    v.obj_redpoint:UpdateRedPointItemIDAndParam(cfgDic[k].redpoint, self.sid)
                end
            end
        end
            
        for _, v in pairs(self.updateFun) do
            v(self.data, notUpdatePower)
        end
    end
    self:UpdateView(notUpdateSpine)
end

---更新页面
function BeastDevelopView:UpdateView(notUpdateSpine)
    self:UpdateState()
    self:UpdateAttr()
    self:UpdateBtn()
    if not notUpdateSpine then
        self:UpdateSpine()
    end
    self:UpdateInfo()
    self:UpdateSkill()
end

---更新激活状态
function BeastDevelopView:UpdateState()
    self.go_table.obj_PanelContent:SetActiveE(self.isPreview and 0 or 1)
    if self.curToggle then--防止没加载页签就隐藏掉，特殊处理一下
        self.go_table.obj_ToggleContent:SetActiveE(self.isPreview and 0 or 1)
    end
    self.go_table.aorbtn_Go:SetActiveE(self.isPreview and 1 or 0)
    self.go_table.aortext_GoText:SetActiveE(self.isPreview and 1 or 0)
    if self.data:IsCanGet() then
        self.go_table.aortext_Go.text = _G.GetLangPackValue(18900000013)
        self.go_table.aortext_GoText:SetActiveE(0)
    end
end

---更新属性信息
function BeastDevelopView:UpdateAttr()
    self.go_table.trans_AttContent:RemoveAllChildren()
    local attrList = self.data:GetAttributeList(self.isPreview)
    for _, v in ipairs(attrList) do
        local attrItem = _G.InstantiateObject(self.go_table.obj_Attr, self.go_table.trans_AttContent)
        local tb = _G.GetAutoGoTable(attrItem)
        tb.aortext_Name.text = _G.GetLangPackValue(v.name)
        tb.aortext_Num.text = v.curValue
    end
    local showAttr = (self.curPanel == cfgDic[2].cfg.Name and not self.isPreview) and 0 or 1
    self.go_table.trans_AttContent:SetActiveE(showAttr)
    _G.GameUtil.ReBuildRTF(self.go_table.trans_AttContent)
end

---更新切换按钮
function BeastDevelopView:UpdateBtn()
    self.go_table.aorbtn_Left:SetActiveE(self.curIndex > 1 and 1 or 0)
    self.go_table.aorbtn_Right:SetActiveE(self.curIndex < #self.dataList and 1 or 0)
end

---更新spine
function BeastDevelopView:UpdateSpine()
    self.go_table.obj_Spine:RemoveAllChildren()
    _G.PoolsManager:GetInstance():Spawn(
        self.data:GetSpinePath(),
        _G.ePoolType.UIItem,
        self.go_table.obj_Spine,
        function(trans)
            if not self.go_table then
                _G.DestroyObject()
                return
            end
            local pos = self.data.cfg.spine_portrait1
            trans:SetLocalPosition(pos[1], pos[2], pos[3])
            trans:SetLocalScaleXYZ(pos[4])
        end
    )
end

---更新圣兽信息
function BeastDevelopView:UpdateInfo()
    local order = self.data:GetOrder()
    self.star = self.data:GetStar()
    local professional = BeastModel.BeastProfessional[self.data.cfg.professional]
    local nameBg = BeastModel.BeastNameBg[order]
    local lvBg = BeastModel.BeastLvBg[order]
    local gradient = BeastModel.BeastGradient[order]
    self.go_table.aorimage_Type.SpriteName = professional
    self.go_table.aorimage_NameBg.SpriteName = nameBg
    self.go_table.aortext_Name.text = self.data:GetName()
    self.go_table.aorimage_LvBg.SpriteName = lvBg
    local level = self.data.level
    if self.isPreview then
        BeastModel:ShowStar(self.go_table, self.data:GetMaxStar())
        level = self.data:GetMaxLevel()
    else
        BeastModel:ShowStar(self.go_table, self.star)
    end
    self.go_table.aortext_Lv.text = _G.GetLangPackValue(90021800050) .. level
    self.go_table.aortext_Name:SetActiveE(0)--防止切换的时候描边渲染没刷新到，手动隐藏再显示刷新一下
    --修改渐变
    _G.UIUtils.ChangeUIMethod({"4", gradient[1], gradient[2]}, self.go_table.aortext_Name)
    if gradient[3] then--修改描边
        _G.UIUtils.ChangeUIMethod({"4", 2, gradient[3]}, self.go_table.aortext_Name)
    else
        _G.UIUtils.ChangeUIMethod({"4", 0, "FFFFFF"}, self.go_table.aortext_Name)
    end
    self.go_table.aortext_Name:SetActiveE(1)
    for i = 1, 3 do
        local position = self.data.cfg["pet_position" .. i]
        if position > 0 then
            self.go_table["aorimage_Position" .. i]:SetActiveE(1)
            self.go_table["aortext_Position" .. i].text = _G.GetLangPackValue(position)
        end
    end
    _G.GameUtil.ReBuildRTF(self.go_table.obj_PetPosition)
end


---更新技能信息
function BeastDevelopView:UpdateSkill()
    if self.data:GetIsActive() then
        self.skillList = self.data.cfg.skill_id[self.star + 1]
    else
        self.skillList = self.data.cfg.skill_id[self.data:GetMaxStar() + 1]
    end
    for i = 1, 3 do
        if self.skillList[i] == 0 then--配0的技能不显示
            self.go_table["obj_Skill" .. i]:SetActiveE(0)
        else
            self.go_table["obj_Skill" .. i]:SetActiveE(1)
            local tb = _G.GetAutoGoTable(self.go_table["obj_Skill" .. i], _G.handlerbind(self, self.OnClickSkill, i))
            local skillCfg = i == 3 and
                    _G.ConfigManager.attribute_cfg[self.skillList[i]] or
                    _G.ConfigManager.card_skills_cfg[self.skillList[i]]
            if skillCfg then
                tb.aorrawimage_skill:LoadImage(skillCfg.icon)
            elseif _G.AppSetting.DEBUG then
                _G.LogError(self.skillList[i] .. "找不到技能配置，需要检查pet_xzns_cfg表")
            end
        end
    end
end

function BeastDevelopView:SetUpdateFun(name, callback)
    self.updateFun[name] = callback
end

---切换页签
function BeastDevelopView:ChangeToggle(name)
    for _, v in pairs(self.toggles) do
        v.aorimage_isOffIcon:SetActiveE(name == v.name and 0 or 1)
        v.aorimage_isOnIcon:SetActiveE(name == v.name and 1 or 0)
        v.aortext_isOffName:SetActiveE(name == v.name and 0 or 1)
        v.aortext_isOnName:SetActiveE(name == v.name and 1 or 0)
        if name == v.name then
            self.curToggle = v--更新当前选中页签
        end
    end
    self:ChangePanel(self.curToggle)--根据当前选中页签切换界面
end

---切换页面
function BeastDevelopView:ChangePanel(toggle)
    local cfg = toggle.cfg
    if self.curPanel and self.curPanel.name == cfg.Name then--如果已经是目标界面则不处理
        return
    end
    if not self.panels[cfg.Name] and not self.isPreview then
        _G.PoolsManager:GetInstance():Spawn(
                cfg.PrefabPath,
                _G.ePoolType.UIItem,
                self.go_table.obj_PanelContent,
                function(panel)
                    if not panel or not self.go_table then
                        _G.DestroyObject(panel)
                        return
                    end
                    local tb = _G.GetAutoGoTable(self:AddComponent(panel, require(cfg.View).New(panel, self.data)).gameObject)
                    self.panels[cfg.Name] = tb
                    tb.gameObject:GetComponentE(_G.typeof(_G.Canvas)).sortingOrder = self.LayerSorting--修改页面背景层级
                    tb.obj_Root:GetComponentE(_G.typeof(_G.Canvas)).sortingOrder = self.LayerSorting + 10--修改页面显示层级
                    self:ShowPanel(cfg.Name)
                    self.curPanel = cfg.Name--更新当前显示页面
                end
        )
    else
        self:ShowPanel(cfg.Name)--已经加载过页面直接显示
        self.curPanel = cfg.Name--更新当前显示页面
    end
end

---显示页面
function BeastDevelopView:ShowPanel(name)
    local showAttr = (name == cfgDic[2].cfg.Name and not self.isPreview) and 0 or 1
    self.go_table.trans_AttContent:SetActiveE(showAttr)
    if showAttr then
        _G.GameUtil.ReBuildRTF(self.go_table.trans_AttContent)
    end
    for k, v in pairs(self.panels) do
        v.gameObject:SetActiveE(k == name and 1 or 0)
    end
end

---激活成功回调
function BeastDevelopView:ActiveCall(data)
    self:UpdateData(data.sid, true)
end

---按钮点击事件在这里派发
function BeastDevelopView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        if self.callback then
            self.callback()
        end
        self:Close()
    elseif go == self.go_table.aorbtn_Left then
        if self.curIndex > 1 then
            self:UpdateData(self.dataList[self.curIndex - 1])
        end
    elseif go == self.go_table.aorbtn_Right then
        if self.curIndex < #self.dataList then
            self:UpdateData(self.dataList[self.curIndex + 1])
        end
    elseif go == self.go_table.aorbtn_Go then--跳转到招募
        if self.data:IsCanGet() then--如果是可激活状态则点击激活
            BeastModel:GetInstance():UpStar(self.data.sid, 0, _G.handler(self, self.ActiveCall))
        else
            local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.BeastMainView.Name)
            if view then
                for _, v in pairs(view.toggles) do
                    if v.name == _G.ConfigManager.ui_cfg.BeastDrawPanel.Name then
                        v.toggle_Page.isOn = true
                    end
                end
            end
            self:Close()
        end
    elseif go == self.go_table.aorbtn_AttrDetail then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TeamHallAttrBeastPanel.Name)
    end
end

---点击技能事件
function BeastDevelopView:OnClickSkill(go, isOn, index)
    if index == 3 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.PotencyTipView.Name, self.data)--宠物潜能Tips
    else
        require("CommonTipManager"):GetInstance():OpenBeastSkillTip(self.sid, self.skillList[index])--宠物技能Tips
    end
end


function BeastDevelopView:OnClickToggle(go, isOn, name)
    if self.curToggle and name == self.curToggle.name then
        return
    end
    self:ChangeToggle(name)
end

---界面的销毁函数
function BeastDevelopView:OnDestroy()
end

return BeastDevelopView