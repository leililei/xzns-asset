---@class BeastStarUpView : UIBaseView	中文描述
---@field public go_table BeastStarUpView_GoTable GoTable
local BeastStarUpView = _G.BaseClass("BeastStarUpView", _G.UIBaseView)


function BeastStarUpView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function BeastStarUpView:OnCreate(data)
    self.sid = data.sid
    ---@type BeastData
    self.data = data
    self.cfg = self.data.cfg
    self.star = self.data.star
    self.skillList = self.data.cfg.skill_id[self.star + 1]
    self:InitView()
end

---初始化界面
function BeastStarUpView:InitView()
    _G.PoolsManager:GetInstance():Spawn(
            self.data:GetSpinePath(),
            _G.ePoolType.UIItem,
            self.go_table.obj_Spine,
            function(trans)
                if not self.go_table then
                    _G.DestroyObject()
                    return
                end
                local pos = self.data.cfg.spine_portrait2
                trans:SetLocalPosition(pos[1], pos[2], pos[3])
                trans:SetLocalScaleXYZ(pos[4])
            end
    )
    require("BeastModel"):GetInstance():ShowStar(self.go_table, self.star)
    self:InitAttr()
    self:InitSkill()
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_shengxingchenggong,
            self.go_table.obj_Eff
    )
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_shengchongzhanshi_cheng,
            self.go_table.obj_Eff
    )
    local starIndex = self.star > 5 and self.star - 5 or self.star
    local star = self.go_table["aorimage_Star" .. starIndex]
    _G.DelayDo(0.9, function()
        if not self.go_table then
            return
        end
        _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_xingxingdianliang,
                star.gameObject,
                function(trans)
                    if not self.go_table then
                        _G.DestroyImmediate(trans)
                        return
                    end
                end,
                function(trans)
                    if not self.go_table then
                        _G.DestroyImmediate(trans)
                        return
                    end
                end
        )
    end)
    
    
end

---初始化属性信息
function BeastStarUpView:InitAttr()
    local attrList = self.data:GetAttributeList()
    self.go_table.trans_AttrContent:RemoveAllChildren()
    for _, v in ipairs(attrList) do
        local attrItem = _G.InstantiateObject(self.go_table.obj_AttrItem, self.go_table.trans_AttrContent)
        local tb = _G.GetAutoGoTable(attrItem)
        tb.aortext_Name.text = _G.GetLangPackValue(v.name)
        tb.aortext_Value.text = v.preValue 
        tb.aortext_NewValue.text = v.curValue
    end
end

---初始化潜能信息
function BeastStarUpView:InitSkill()
    local preCfg = self.data.cfg.skill_id[self.data:GetStar()]
    local curCfg = self.data.cfg.skill_id[self.data:GetStar() + 1]
    local type = 0
    if curCfg[1] ~= preCfg[1] then
        type = 1
    elseif curCfg[2] ~= preCfg[2] then
        type = 2
    end
    local skillText = self.go_table.obj_UnlockText:GetComponentE(_G.typeof(_G.CS.ExtendText))
    if type == 1 then
        skillText.text = _G.GetLangPackValue(_G.ConfigManager.card_skills_cfg[curCfg[1]].describe1)
    elseif type == 2 then
        skillText.text = _G.GetLangPackValue(_G.ConfigManager.card_skills_cfg[curCfg[2]].describe1)
    elseif type == 0 then
        skillText.text = _G.GetLangPackValue(_G.ConfigManager.attribute_cfg[curCfg[3]].describe)
    end
end

---超链接点击事件
function BeastStarUpView:OnHrefClick(id)
    local rect = self.go_base.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    local posX, posY = rect:GetRectTransformWidthHeight()
    require("CommonTipManager"):GetInstance():OpenSkillHyper(_G.tonumber(id), nil, posX, posY)
end

---按钮点击事件在这里派发
function BeastStarUpView:OnClickBtn(go)
    if go == self.go_table.aorbtn_Close then
        self:Close()
    end
end

---界面的销毁函数
function BeastStarUpView:OnDestroy()
end

return BeastStarUpView