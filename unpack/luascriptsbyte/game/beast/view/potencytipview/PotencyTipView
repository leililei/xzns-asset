---@class PotencyTipView : UIBaseView	中文描述
---@field public go_table PotencyTipView_GoTable GoTable
local PotencyTipView = _G.BaseClass("PotencyTipView", _G.UIBaseView)

function PotencyTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function PotencyTipView:OnCreate(data)
    self.data = data
    self.cfg = self.data:GetSkill()
    
    local item, go
    for k, v in pairs(self.cfg) do
        k = k - 1
        item = _G.InstantiateObject(self.go_table.obj_item, self.go_table.obj_content)
        item:SetActiveE(1)
        go = _G.GetAutoGoTable(item)
        local type = 0
        if k ~= 0 then
            if self.cfg[k][1] ~= self.cfg[k + 1][1] then
                type = 1
            elseif self.cfg[k][2] ~= self.cfg[k + 1][2] then
                type = 2
            end
        else
            type = -1
        end
        local exTendText = go.obj_potency:GetComponentE(_G.typeof(_G.CS.ExtendText))
        exTendText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))
        if data:GetStar() < k then
            exTendText.color = _G.ColorTools.FormatColorByString("828388")
        end
        if type == 1 then
            go.obj_tip:SetActiveE(1)
            go.aortext_tip.text = _G.GetLangPackValue(90049300026)
            exTendText.text = _G.GetLangPackValue(90033900038, "<color=#00000000>xxxxxxxxx</color><color=#ffd426>" .. k,
                "</color>" .. _G.GetLangPackValue(_G.ConfigManager.card_skills_cfg[v[1]].describe1))
        elseif type == 2 then
            go.obj_tip:SetActiveE(1)
            go.aortext_tip.text = _G.GetLangPackValue(90049300027)
            exTendText.text = _G.GetLangPackValue(90033900038, "<color=#00000000>xxxxxxxxx</color><color=#ffd426>" .. k,
                "</color>" .. _G.GetLangPackValue(_G.ConfigManager.card_skills_cfg[v[2]].describe1))
        elseif type == 0 then
            go.obj_tip:SetActiveE(0)
            exTendText.text = _G.GetLangPackValue(90033900038, "<color=#ffdc21>".. k,
                "</color>" .. _G.GetLangPackValue(_G.ConfigManager.attribute_cfg[v[3]].describe))
        else
            _G.DestroyObject(item)
        end
    end
end

---点击超链接
function PotencyTipView:OnHrefClick(id, name, asa)
    local rect = self.go_table.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    local posX, posY = rect:GetRectTransformWidthHeight()
    require("CommonTipManager"):GetInstance():OpenSkillHyper(_G.tonumber(id), nil, posX, posY)
end

---按钮点击事件在这里派发
function PotencyTipView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end

return PotencyTipView
