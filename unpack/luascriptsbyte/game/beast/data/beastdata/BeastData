---类的构造函数
function BeastData:__init(sid)
    self.sid = sid
    self.cfg = ConfigManager.pet_xzns_cfg[sid]
    self.active = false
    self.star = 0
    self.level = 1
    self.curLevelCfg = ConfigManager.pet_level_xzns_cfg[self.level]
    self.nextLevelCfg = ConfigManager.pet_level_xzns_cfg[self.level + 1]
    self.isMaxLevel = false
end

---数据解析
---@param msg beast.i_beast 数据
function BeastData:Parse(msg)
    self.active = true
    self.star = msg.star
    self.level = msg.level
    self.curLevelCfg = ConfigManager.pet_level_xzns_cfg[self.level]
    self.nextLevelCfg = ConfigManager.pet_level_xzns_cfg[self.level + 1]
    self.isMaxLevel = self.level >= #ConfigManager.pet_level_xzns_cfg and true or false
    self:UpdateAttribute()
end

---更新属性
function BeastData:UpdateAttribute()
    self.attribute = _G.AttributeClassManager:GetInstance():GetAttribtueClass()
    self.attribute:OnInit(nil, _G.PowerType.equipment)
    self:GetAttribute(self.attribute)
    self:CalculatePower()
end

-----计算战力
function BeastData:CalculatePower()
    self.power = self.attribute:CalculatePower()
end

--region ------------- 访问数据 -------------

---获取基础属性
function BeastData:GetAttribute(attribute)
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    if attribute == nil then
        attribute = AttributeClassManager:GetAttribtueClass()
    end
    if not self.active then
        return attribute
    end
    local growth = self.cfg.att_growth[self.star + 1] / 10000
    if self.curLevelCfg.growth > 0 then
        growth = growth * (self.curLevelCfg.growth / 10000)
    end
    local cfg = self.cfg
    local atk = cfg.atk * growth
    local bre = cfg.bre * growth
    local def = cfg.def * growth
    local maxHp = cfg.max_hp * growth

    attribute:AddValueByName("atk", _G.Mathf.RoundToInt(atk), false)
    attribute:AddValueByName("bre", _G.Mathf.RoundToInt(bre), false)
    attribute:AddValueByName("def", _G.Mathf.RoundToInt(def), false)
    attribute:AddValueByName("max_hp", _G.Mathf.RoundToInt(maxHp), false)
    return attribute
end

---获取属性字典
---@return table 属性
function BeastData:GetAttributeDict()
    if not self.active then
        return {atk = 0, bre = 0, def = 0, max_hp = 0}
    end
    local growth = self.cfg.att_growth[self.star + 1] / 10000
    if self.curLevelCfg.growth > 0 then
        growth = growth + (self.curLevelCfg.growth / 10000)
    end
    local prop = {}
    prop.atk = _G.Mathf.RoundToInt(self.cfg.atk * growth)
    prop.bre = _G.Mathf.RoundToInt(self.cfg.bre * growth)
    prop.def = _G.Mathf.RoundToInt(self.cfg.def * growth)
    prop.max_hp = _G.Mathf.RoundToInt(self.cfg.max_hp * growth)
    return prop
end

---获取基础属性字典
---@return table 属性
function BeastData:GetAttributeBaseDict()
    if not self.active then
        return {atk = 0, bre = 0, def = 0, max_hp = 0}
    end
    local prop = {}
    prop.atk = _G.Mathf.RoundToInt(self.cfg.atk)
    prop.bre = _G.Mathf.RoundToInt(self.cfg.bre)
    prop.def = _G.Mathf.RoundToInt(self.cfg.def)
    prop.max_hp = _G.Mathf.RoundToInt(self.cfg.max_hp)
    return prop
end

---获取当前属性和前一星级属性的名称和值
---@param isPreview boolean 是否是预览，默认为否
---@param isNumber boolean 是否为数值，默认为否
---@return table 属性列表
function BeastData:GetAttributeList(isPreview, isNumber)
    local list = {}
    local attr = { "atk", "max_hp", "bre", "def" }

    local getNum = function(keyType, curValue)
        if _G.AttrType[keyType].percentage == 1 then
            curValue = curValue * 100
            curValue = _G.GameUtil.FormatNum(curValue)
            curValue = isNumber and curValue or curValue .. "%"
        else
            curValue = _G.math.floor(curValue)
            curValue = isNumber and curValue or _G.GameUtil.NumberWY(curValue)
        end
        return curValue
    end
    for k, v in ipairs(attr) do
        local id = _G.AttrType[v].ID
        local baseValue = self.cfg[v]
        local levelGrowth = self.curLevelCfg.growth / 10000
        local preGrowth = self.star > 0 and self.cfg.att_growth[self.star] / 10000 or 0
        local curGrowth = self.cfg.att_growth[self.star + 1] / 10000
        if isPreview then
            local levelCfg = _G.ConfigManager.pet_level_xzns_cfg
            levelGrowth = levelCfg[self:GetMaxLevel()].growth / 10000
            curGrowth = self.cfg.att_growth[self:GetMaxStar() + 1] / 10000
        end
        if levelGrowth > 0 then
            preGrowth = preGrowth * levelGrowth
            curGrowth = curGrowth * levelGrowth
        end
        list[k] = {}
        list[k].name = _G.ConfigManager.type_attribute_cfg[id].name
        list[k].preValue = getNum(v,baseValue * preGrowth)
        list[k].curValue = getNum(v,baseValue * curGrowth)
    end
    return list
end

