    return CardBGPath[self:GetOrder()]
end

function BeastData:GetProfessionalSpriteName()
    return CardProfessionalSpriteName[self.cfg.professional]
end

function BeastData:GetCostItem()
    return self.cfg.materials_item
end

function BeastData:GetCost()
    local itemData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, self:GetCostItem())
    local count = itemData and itemData:GetCount() or 0
    local need = self:GetUpCostNum()
    local colorType = 2
    if count >= need then
        colorType = 3
    end
    return count, need, "<color=#" .. color[colorType] .. ">" .. count .. "</color>/" .. need
end

---获取升星消耗数量
function BeastData:GetUpCostNum()
    return self:GetIsActive() and self.cfg.materials_item_number[self.star + 2] or self.cfg.materials_item_number[self.star + 1]
end

---是否已满星
function BeastData:IsMaxStar()
    return self:GetStar() == self:GetCfg().star
end

function BeastData:IsMaxLevel()
    return self.isMaxLevel
end


