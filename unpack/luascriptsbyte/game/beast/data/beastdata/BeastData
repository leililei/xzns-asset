---是否可合成
function BeastData:IsCanGet()
    if self.active then
        return false
    end
    local num = 0
    local itemData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, self.cfg.materials_item, true)
    if itemData then
        num = itemData:GetCount()
    end
    local maxNum = self.cfg.materials_item_number[self.star + 1]
    return num >= maxNum
end

---是否可升星
function BeastData:IsCanStarUp()
    if self:IsMaxStar() then
        return false
    end
    local needNum = self:GetUpCostNum()
    local num = 0
    local itemData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, self.cfg.materials_item)
    if itemData then
        num = itemData:GetCount()
    end
    if num >= needNum then
        return true
    end
    return false
end

---是否可升级
function BeastData:IsCanLevelUp(level, isShowWay, fakeConsume)
    local list = self:GetUpLevelConsume(level)
    for _, v in pairs(list) do
        local _, storageId = _G.StorageManager:GetInstance():CheckSidType(v.id)
        local num = _G.StorageManager:GetInstance():GetItemCountByID(storageId, v.id)
        if fakeConsume and fakeConsume[v.id] then
            num = num - fakeConsume[v.id]
        end
        if num < v.num then
            if isShowWay then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, v.id)
            end
            return false
        end
    end
    return true
end

