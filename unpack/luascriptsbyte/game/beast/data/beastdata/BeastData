---获取升级需要的材料
---@return table 升级需要的消耗材料
function BeastData:GetUpLevelConsume(level)
    if self.isMaxLevel then
        return {}
    end
    local consume = {}
    local consumed = {}
    local cfg = _G.ConfigManager.pet_level_xzns_cfg
    local newLevel = level or self.level + 1
    local material = "material" .. self.cfg.order
    for i = 1, #cfg[newLevel][material] do
        local need = cfg[newLevel][material][i]
        consume[i] = { id = need[1], num = need[2] }
        if self.level > 1 then
            local cur = cfg[self.level][material][i]
            consumed[i] = { id = cur[1], num = cur[2] }
        end
    end
    for k, v in ipairs(consumed) do
        if v and v.num > 0 then
            consume[k].num = consume[k].num - v.num
        end
    end
    return consume
end

