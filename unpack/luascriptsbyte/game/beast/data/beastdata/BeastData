--region ------------- 增删改 -------------

---合成激活
function BeastData:DoActive()
    self.active = true
    self.star = 0
    self.isCanStarUp = nil
    self:UpdateAttribute()
end

---升星
function BeastData:UpStar(star)
    if star then
        self.star = star
    else
        self.star = self.star + 1
    end
    if self.star > self.cfg.star then
        self.star = self.cfg.star
    end
    self.isCanStarUp = nil
    self:UpdateAttribute()
end

---升级
function BeastData:UpLevel(level)
    if level then
        self.level = level    
    else
        self.level = self.level + 1
    end
    if self.level >= #ConfigManager.pet_level_xzns_cfg then
        self.level = #ConfigManager.pet_level_xzns_cfg
        self.isMaxLevel = true
    else
        self.isMaxLevel = false    
    end
    self.curLevelCfg = ConfigManager.pet_level_xzns_cfg[self.level]
    self.nextLevelCfg = ConfigManager.pet_level_xzns_cfg[self.level + 1]
end

