local base = _G.GameDataModelBase
---@class BeastFetterModel : GameDataModelBase	中文描述
local BeastFetterModel = _G.BaseClass("BeastFetterModel",base)

---类的构造函数
function BeastFetterModel:__init()
    self.curFunctionOpenID = 1001
    self.fetters = {}
end

function BeastFetterModel:GetDataFormServer()
    require("BeastNet"):GetInstance():GetBeastFetterInfo(_G.handler(self,self.ParseData))
end

function BeastFetterModel:ParseData(data)
    self.fetters = {}
    for _, v in pairs(_G.ConfigManager.pet_fetter_xzns_cfg) do
        self.fetters[v.id] = -1
    end
    if data.fetter_list then
       for _, v in pairs(data.fetter_list) do
        self.fetters[v.fetter_sid] = v.index
        end
    end
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BeastFetter.id)
    base.ParseData(self)
end

---获取羁绊阶段
---@param sid number 羁绊sid
function BeastFetterModel:GetFetterIndex(id)
    return self.fetters[id] or 0
end

function BeastFetterModel:GetActiveMaxIndex(id)
    local index = 0
    local minStar = 999
    local cfg = _G.ConfigManager.pet_fetter_xzns_cfg
    for _, v in pairs(cfg[id].pets) do
        local data = require("BeastModel"):GetInstance():GetBeast(v)
        minStar = _G.math.min(minStar, data:GetIsActive() and data:GetStar() or -1)
    end
    for i = 1, 6 do
        if cfg[id]["condition_star" .. i] then
            if cfg[id]["condition_star" .. i] <= minStar then
                index = i
            else
                break
            end
        else
            break
        end
    end
    return index
end

---@return boolean 进度是否完成,number 当前进度,number 目标进度
function BeastFetterModel:GetProgressText(index, id)
    local nowIndex = self:GetFetterIndex(id)
    if nowIndex >= index then
        return true, 0, 0
    end
    local cfg = _G.ConfigManager.pet_fetter_xzns_cfg
    local target = cfg[id]["condition_star" .. index]
    if not target then
        if _G.AppSetting.DEBUG then
            _G.LogError("圣兽羁绊等级传入错误")
        end
        return
    end
    local count = 0
    for _, v in pairs(cfg[id].pets) do
        local data = require("BeastModel"):GetInstance():GetBeast(v)
        if data:GetIsActive() and target <=  data:GetStar() then
            count = count + 1
        end
    end
    return false, count, #cfg[id].pets
end

---激活灵兽羁绊
---@param sid number 羁绊sid
---@param index number 羁绊阶段
function BeastFetterModel:FetterActive(sid, index, call)
    local pbData = {fetter_sid = sid, index = index}
    require("BeastNet"):GetInstance():BeastFetterActive(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self.fetters[sid] = index
            if call then
                call(msg)
            end
        end
    )
end

---灵兽图鉴的属性
function BeastFetterModel:GetBeastFetterAttribute()
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local attribute = AttributeClassManager:GetAttribtueClass()
    for _, v in pairs(_G.ConfigManager.pet_fetter_xzns_cfg) do
        local index = self.fetters[v.id]
        if index and index > 0 then
            attribute = self:UpdateAttribute(AttributeClassManager, attribute, v["att" .. index])
        end
    end

    local changeAttrTypes = AttributeClassManager:GetChangeAttrTypes(attribute)
    return attribute, changeAttrTypes
end

function BeastFetterModel:UpdateAttribute(attributeManager, attribute, attData)
    for _, v in pairs(attData) do
        local type = v[2] == "2" and _G.AttCountType.basePercent or _G.AttCountType.other
        attribute:AddValueByName(
            v[1],
            attributeManager:GetValueWithName(v[1], v[3], v[2]),
            false,
            type
        )
    end
    return attribute
end

---是否有可激活的羁绊
function BeastFetterModel:CheckCanActiveFetter(param)
    local allCfg = _G.ConfigManager.pet_fetter_xzns_cfg
    if param and allCfg[param] then
        local cfg = allCfg[param]
        for i = 1, 5 do
            if self:GetFetterIndex(cfg.id) < i and self:CanActiveFetter(cfg.pets, cfg["condition_star" .. i]) then
                return 1
            end
        end

        return 0
    end

    for _, v in pairs(allCfg) do
        for i = 1, 5 do
            if self:GetFetterIndex(v.id) < i and self:CanActiveFetter(v.pets, v["condition_star" .. i]) then
                return 1
            end
        end
    end
    return 0
end

---当前羁绊对应的灵兽总星级
---@param pets table 羁绊对应的宠物
---@param condition_star number 解锁星级
function BeastFetterModel:CanActiveFetter(pets, condition_star)
    for _, v in pairs(pets) do
        local petData = require("BeastModel"):GetInstance():GetBeast(v)
        if _G.table.isEmptyOrNil(petData) or not petData:GetIsActive() then
            return false
        end

        if petData:GetStar() < condition_star then
            return false
        end
    end
    return true
end

return BeastFetterModel