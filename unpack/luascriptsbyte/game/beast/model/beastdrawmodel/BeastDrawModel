local BeastNet = require("BeastNet")

local base = _G.GameDataModelBase
---@class BeastDrawModel : GameDataModelBase
local BeastDrawModel = _G.BaseClass("BeastDrawModel", base)

---@return BeastDrawModel BeastDrawModel
function BeastDrawModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function BeastDrawModel:__init()
    self.curFunctionOpenID = _G.FunctionID.Beast
    self.cfgid = 200100
    self.awardState = {}
    self.free_count = 0
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.OnUpData, self)
end

---从服务器拉取数据
function BeastDrawModel:GetDataFormServer()
    BeastNet:GetInstance():GetBeastDrawInfo(_G.handler(self, self.ParseData))
end

function BeastDrawModel:OnUpData(data)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BeastDraw.id)
end

---@param msg
function BeastDrawModel:ParseData(msg)
    self.day_count = msg.day_count or 0
    self.total_times = msg.total_count or 0
    self.diamond_times = msg.diamond_times or 0
    self.need_count = msg.need_count or 0
    self.wish_sids = msg.wish_sids or { 0, 0, 0 }
    self.drawScore = msg.score or 0
    self.awardState = msg.award or {}
    self.free_count = msg.free_count or 0
    self.super.ParseData(self)
end
---获取本日剩余免费召唤次数
---@return number
function BeastDrawModel:GetDayFreeCount()
    return _G.ConfigManager.item_roller_cfg[200100].free_day - self.free_count
end

function BeastDrawModel:GetTotalTimes()
    return self.total_times
end

---获取心愿单
function BeastDrawModel:GetWishsids()
    return self.wish_sids or { 0, 0, 0 }
end

---获取心愿剩余次数
function BeastDrawModel:GetWishNeedCounts()
    return self.need_count
end

---获取召唤积分
function BeastDrawModel:GetDrawScore()
    return self.drawScore
end

---获取召唤积分
function BeastDrawModel:IsGetAwardByIndex(index)
    return _G.table.ContainsValue(self.awardState, index)
end

---增加已使用魂玉召唤次数
---@param num number 次数
---@return number   当前次数
function BeastDrawModel:AddDiamondTimes(num)
    self.diamond_times = (self.diamond_times or 0) + num
    return self.diamond_times
end

---获取已使用魂玉召唤次数
---@return number
function BeastDrawModel:GetDiamondTimes()
    return self.diamond_times or 0
end

---获取魂玉召唤次数上限
---@return number
function BeastDrawModel:GetDiamondTotalTimes()
    self.diamond_total_times = self.diamond_total_times or _G.ConfigManager.item_roller_cfg[self.cfgid].count_diamond
    local num = self.diamond_total_times
    local data = require "PrivilegeManager":GetInstance():GetPrivilegeData({ _G.PrivilegeType.LimitedTimePrivilege.ShopNumAdd, 4 })
    if data[1] then
        num = data[1] + num
    end
    return num
end
---获取每日召唤次数上限
function BeastDrawModel:GetDailyMaxTimes()
    self.DailyMax_times = self.DailyMax_times or _G.ConfigManager.item_roller_cfg[self.cfgid].limit_daily
    return self.DailyMax_times
end

---增加已召唤次数
---@return number   当前次数
function BeastDrawModel:AddDailyTimes(num)
    self.day_count = (self.day_count or 0) + num
    return self.day_count
end

---获取已召唤次数
---@return number
function BeastDrawModel:GetDailyTimes()
    return self.day_count or 0
end

---获取剩余魂玉召唤次数
function BeastDrawModel:GetLastDiamondTimes()
    return self:GetDiamondTotalTimes() - self:GetDiamondTimes()
end

---@param data number[]
function BeastDrawModel:SetWish(data, callback)
    local pbData = { wish_list = data }
    BeastNet:GetInstance():BeastDrawSetWish(pbData, function(msg)
        if msg.ack == 1 then
            self.wish_sids = data
            _G.Events:GetInstance():Broadcast(_G.eBeastDraw.BeastDrawWishRefresh)
            require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.BeastDrawWish.id)
            if callback then
                callback(msg)
            end
        end
    end)
end

---抽卡
---@param num number 抽奖次数
---@param consume_type number 消耗类型（1:道具 2:魂玉）
function BeastDrawModel:Draw(drawNum, consume_type, callback, freeBol)
    local pbData = { draw_times = drawNum, consume_type = consume_type }
    BeastNet:GetInstance():BeastDrawExecute(pbData, function(msg)
        if msg.ack == 1 then
            _G.StorageManager:GetInstance():ReceiveAwardData({ award = msg.award })
            if msg.award.overflow then 
                _G.PopWindowManager:GetInstance():ShowAllTips(380104)
            end
            self.need_count = msg.need_count
            if msg.score then
                self.drawScore = msg.score
            end
            local sid
            local num
            self:AddDailyTimes(drawNum)
            if consume_type == 1 then
                sid = _G.ConfigManager.item_roller_cfg[self.cfgid].ticket[1]
                num = drawNum
            else
                self:AddDiamondTimes(drawNum)
                sid, num = self:GetDiamondCurrencyByType(drawNum)
            end
            if freeBol then
                self.free_count = self.free_count + 1
            else
                _G.StorageManager:GetInstance():ConsumeItem(sid, 0, num)
            end

            -- _G.Events:GetInstance():Broadcast(
            --     _G.ePlayAactionEvent.PlayAaction,
            --     { _G.ActiveTaskEnum.ConditionEnum.Pet.DrawNum },
            --     drawNum
            -- )
            _G.PlayerPrefsManager.SetInt("BeastFirstDraw", 1)
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BeastDraw.id)
            if require("BeastModel"):GetInstance():IsAutoDecompose() then
                require("BeastModel"):GetInstance():AutoDecompose()
            end
	    if callback then
                callback(msg)
            end
        end
    end)
end

---获取魂玉抽卡的sid和num
---@param drawNum number 抽奖次数
---@return number,number,number 消耗id，消耗值，折扣
function BeastDrawModel:GetDiamondCurrencyByType(drawNum)
    local sid
    local num
    sid = _G.ConfigManager.item_roller_cfg[self.cfgid].ticket_2[1]
    local baseNum = _G.ConfigManager.item_roller_cfg[self.cfgid].ticket_2[2]
    num = drawNum * baseNum
    local data = require "PrivilegeManager":GetInstance():GetPrivilegeData({ _G.PrivilegeType.LimitedTimePrivilege.ConsumeReduce, self.cfgid })
    local discount = 1
    if data[1] then
        discount = data[1] * 0.0001
        num = num - num * discount
    end
    return sid, _G.math.ceil(num), 1 - discount
end

---@param score number
function BeastDrawModel:GetAward(score, callback)
    local pbData = { index_list = { score } }
    BeastNet:GetInstance():BeastDrawGetAward(pbData, function(msg)
        if msg.ack == 1 then
            _G.table.insert(self.awardState, score)
            if #self.awardState == 4 then
                self.awardState = {}
                local maxScore = _G.ConfigManager.item_roller_cfg[self.cfgid].rewards_count[#_G.ConfigManager.item_roller_cfg[self.cfgid].rewards_count]
                self.drawScore = self.drawScore - maxScore
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.BeastDrawAward.id)
            if callback then
                callback(msg)
            end
        end
    end)
end

---圣兽抽奖红点（道具满足时）
function BeastDrawModel:CheckDrawPointRed()
    local sid = _G.ConfigManager.item_roller_cfg[self.cfgid].ticket[1]
    local itemNum = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.Prop, sid)
    if itemNum ~= nil and itemNum > 0 then
        if _G.PlayerPrefsManager.HasKey("BeastDrawRedPoint") then
            return false
        end
        return true
    end
    return false
end

---灵兽抽奖奖励红点
function BeastDrawModel:CheckDrawAwardPointRed(index)
    local isGet = self:IsGetAwardByIndex(index)
    if isGet then
        return false
    else
        local score = _G.ConfigManager.item_roller_cfg[self.cfgid].rewards_count[index]
        return self.drawScore >= score
    end
end

---灵兽抽奖心愿单红点
function BeastDrawModel:CheckDrawWishPointRed(index)
    local data = require "PrivilegeManager":GetInstance():GetPrivilegeData({ _G.PrivilegeType.LimitedTimePrivilege.BeastDrawWish })
    if not data[1] then
        return false
    end
    return self.wish_sids and self.wish_sids[index] == 0 or false
end

---销毁对象时,析构函数
function BeastDrawModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.OnUpData, self)
end

return BeastDrawModel
