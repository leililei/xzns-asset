---圣兽碎片分解
function BeastModel:BeastDebrisDecompose(sidNumLis, call)
    local pbData = { beast_debris = sidNumLis }
    BeastNet:GetInstance():BeastDebrisDecompose(
            pbData,
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                for _, v in pairs(sidNumLis) do
                    _G.StorageManager:GetInstance():ConsumeItem(v.sid, nil, v.num)
                end
                require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BeastList.id)
                if call then
                    call(msg)
                end
                if self.illustratedFun then
                    self.illustratedFun()
                end
            end
    )
end

