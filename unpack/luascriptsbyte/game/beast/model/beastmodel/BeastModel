---调用立即自动分解
---@param callback fun(ok:boolean):void
function BeastModel:AutoDecompose(callback)
    --只处理紫丶橙丶红三种品质
    local gradeList = _G.ConfigManager.discrete_cfg[114411]
    if not gradeList then
        if callback then
            callback(false)
        end
        return
    end

    local beastDebrisList = {}
    for _, beastData in pairs(self:GetAllPets()) do
        --已合成且满星的灵兽, 才进行分解
        if beastData:IsMaxStar() and _G.table.ContainsValue(gradeList[1], beastData.cfg.Order) then
            local data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, beastData.cfg.materials_item)
            if not table.isEmptyOrNil(data) then
                table.insert(beastDebrisList, { sid = beastData.cfg.materials_item, num = data.count })
            end
        end
    end

    if #beastDebrisList > 0 then
        self:DebrisDecompose(beastDebrisList, function(msg)
            if not msg or msg.ack ~= 1 then
                if callback then
                    callback(false)
                end
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            --对应材料id
            local gradeCfg = _G.ConfigManager.discrete_cfg[200207]
            if gradeCfg and gradeCfg[1] then
                local firstGradeCfg = _G.ConfigManager.discrete_cfg[gradeCfg[1][2]]
                local itemId = firstGradeCfg[1][1]
                local itemNum = 0
                if msg.award and msg.award.item then
                    for _, v in ipairs(msg.award.item) do
                        if v.type[1] == itemId then
                            itemNum = itemNum + v.type[2]
                        end
                    end
                end
                if itemNum > 0 then
                    --显示分解tip
                    _G.PopWindowManager:GetInstance():ShowAllTips(914106, nil, nil, nil, nil, nil, itemNum)
                end
            end

            if callback then
                callback(true)
            end
        end)
    else
        if callback then
            callback(false)
        end
    end
end

---销毁对象时,析构函数
function BeastModel:Dispose()
    for _, v in pairs(self.beasts) do
        v:Dispose()
    end
    self.beasts = nil
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.UpdateChip, self)
end

