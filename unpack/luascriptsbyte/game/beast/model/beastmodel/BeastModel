---创建对象时,入口构造函数
function BeastModel:__init()
    self.curFunctionOpenID = _G.FunctionID.Beast
    self.tasks = {}
    self:InitBeastData()
end

---初始化全部圣兽数据
function BeastModel:InitBeastData()
    self.beasts = {}
    self.beastGetStates = {}
    for _, v in pairs(_G.ConfigManager.pet_xzns_cfg) do
        self.beasts[v.id] = BeastData.New(v.id)
    end

    ---提前缓存所有的圣兽碎片配置，通过配置数据去道具仓库找碎片效果比遍历所有的道具仓库要快点
    self.beastDebrisList = {}
    for _, v in pairs(_G.ConfigManager.item_cfg) do
        if v.Type1 == 22 then
            self.beastDebrisList[v.ID] = v
        end
    end

    ---圣兽关系列表，list<圣兽碎片id， 圣兽id>
    self.beastRelationShipList = {}
    for _, v in pairs(_G.ConfigManager.pet_xzns_cfg) do
        self.beastRelationShipList[v.materials_item] = v.id
    end
end

---从服务器拉取数据
function BeastModel:GetDataFormServer()
    BeastNet:GetInstance():GetBeastInfo(_G.handler(self, self.ParseData))
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.UpdateChip, self)
end

---@param msg beast.s2c_beast_info
function BeastModel:ParseData(msg)
    local beasts = msg.beasts or {}
    for _, v in pairs(beasts) do
        if self.beasts[v.sid] then
            self.beasts[v.sid]:Parse(v)
        end
    end
    self.super.ParseData(self)

    local taskTypeDic = {}
    local taskSidDic = {}
    for _, type in pairs(_G.ActiveTaskEnum.ConditionEnum.Beast) do
        taskTypeDic[type] = true
    end
    local taskManager = require("ActiveTaskManager"):GetInstance()
    for _, v in pairs(taskManager.tasks) do--正在进行的任务
        if taskTypeDic[v.taskEnumType] then
            local CjTaskData = require("BeastTaskData").New(
                v.i_task,
                nil,
                _G.MarkTaskType.Achieve
            )
            table.insert(self.tasks, CjTaskData)
            table.insert(taskSidDic, v.Cfg.sid)
        end
    end
    for _, v in pairs(_G.ConfigManager.mission_cfg) do--不是正在进行中的任务
        if taskTypeDic[v.condition[1][1]] and not taskSidDic[v.id] then
            local CjTaskData = require("BeastTaskData").New({
                    sid = v.id, 
                    state = _G.TaskEnum.ETaskState.Claimed, 
                    target = { 
                      [1] = 0
                    }
                }, 
                nil,
                _G.MarkTaskType.Achieve)
            table.insert(self.tasks, CjTaskData)
        end
    end
    self.starDic = {}
    self.orderStarDic = {}
    for _, v in pairs(self.tasks) do
        local condition = v.Cfg.condition[1]
        if condition[1] == _G.ActiveTaskEnum.ConditionEnum.Beast.BeastStar then
            self.starDic[v.Cfg.id] = condition
        elseif condition[1] == _G.ActiveTaskEnum.ConditionEnum.Beast.BeastQualityStarNum then
            self.orderStarDic[v.Cfg.id] = condition
        end
    end
end

---显示星级
function BeastModel:ShowStar(tb, star)
    if star <= 5 then
        for i = 1, 5 do
            tb["aorimage_Star" .. i].SpriteName = "ui_ss_icon_xing_normal"
            tb["aorimage_Star" .. i]:SetActiveE(star >= i and 1 or 0)
        end
    else
        for i = 1, 5 do
            tb["aorimage_Star" .. i].SpriteName = "ui_ss_icon_xing_hong"
            tb["aorimage_Star" .. i]:SetActiveE(star >= i + 5 and 1 or 0)
        end
    end
end

---获取全部圣兽加成属性
function BeastModel:GetAllAttribute()
    local attrList = { }
    local attr = { "atk", "max_hp", "bre", "def" }

    for k, v in ipairs(attr) do
        local id = _G.AttrType[v].ID
        local value = {}
        value.name = _G.ConfigManager.type_attribute_cfg[id].name
        value.curValue = 0
        attrList[k] = value
    end
    for _, v in pairs(self.beasts) do
        if v:GetIsActive() then
            local list = v:GetAttributeList(false, true)
            for k, value in pairs(list) do
                attrList[k].curValue = attrList[k].curValue + tonumber(value.curValue)
            end
        end
    end
    return attrList
end

---圣兽重生
function BeastModel:ResetLevel(sid, callback)
    local pbData = { sid = sid }
    BeastNet:GetInstance():BeastReset(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            if msg.award then
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            end
            self.beasts[sid]:UpLevel(1)
            if callback then
                callback(self.beasts[sid])
            end
        end
    )
end

---圣兽升级
function BeastModel:UpLevel(sid, level, callback)
    local pbData = { sid = sid, new_level = level }
    BeastNet:GetInstance():BeastUpLevel(
            pbData,
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                if callback then
                    callback(self.beasts[sid])
                end
            end
    )
end

---圣兽升星、激活
function BeastModel:UpStar(sid, star, callback)
    local pbData = { sid = sid, new_star = star } 
    BeastNet:GetInstance():BeastUpStar(
            pbData,
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                if star == 0 then
                    self.beasts[sid]:DoActive()
                    self.beastGetStates[sid] = false
                else
                    self.beasts[sid]:UpStar(star)
                end

                _G.StorageManager:GetInstance():ConsumeItem(self.beasts[sid].cfg.materials_item, 0,
                        self.beasts[sid].cfg.materials_item_number[star + 1])
                if star == 0 then
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BeastActiveView.Name, self.beasts[sid])
                else
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BeastStarUpView.Name, self.beasts[sid])
                end
                require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BeastList.id, sid)
                require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BeastFetterPage.id)
                if callback then
                    callback(self.beasts[sid])
                end
                _G.Events:GetInstance():Broadcast(_G.ePetUpStar.PetUpStarRefresh, sid)
                _G.Events:GetInstance():Broadcast(
                        _G.ePlayAactionEvent.PlayAaction,
                        {
                            _G.ActiveTaskEnum.ConditionEnum.Pet.PetStar,
                            sid,
                            self.beasts[sid]:GetStar()
                        },
                        1
                )
                _G.Events:GetInstance():Broadcast(
                        _G.ePlayAactionEvent.PlayAaction,
                        {
                            _G.ActiveTaskEnum.ConditionEnum.Pet.PetStarNum,
                            self.beasts[sid]:GetOrder(),
                            self.beasts[sid]:GetStar()
                        },
                        1
                )
                ---0：所有品质
                _G.Events:GetInstance():Broadcast(
                        _G.ePlayAactionEvent.PlayAaction,
                        {
                            _G.ActiveTaskEnum.ConditionEnum.Pet.PetStarNum,
                            0,
                            self.beasts[sid]:GetStar()
                        },
                        1
                )
                for _, v in pairs(self.starDic) do
                    self:CheckStar(v[2], v[3])
                end
                for _, v in pairs(self.orderStarDic) do
                    self:CheckQualityStar(v[2], v[3], v[4])
                end
                require("RedPointManager"):GetInstance():RefreshNode(
                    _G.ConfigManager.redpoint_cfg.BeastFetter.id
                )
            end
    )
end

