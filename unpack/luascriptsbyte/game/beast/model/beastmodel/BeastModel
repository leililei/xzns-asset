function BeastModel:UpdateChip(data)
    if not _G.table.isEmptyOrNil(data) then
        for _, v in pairs(data) do
            local sid = v.type[1]
            if self.beastRelationShipList[sid] then
                 require("RedPointManager"):GetInstance():RefreshNode(
                     _G.ConfigManager.redpoint_cfg.BeastList.id,
                     self.beastRelationShipList[sid]
                 )
            end
        end
    end
end

---指定圣兽达到X星
function BeastModel:CheckStar(sid, star)
    local beastStar = self:GetBeast(sid):GetStar()
    beastStar = beastStar > star and star or beastStar
    _G.Events:GetInstance():Broadcast(
        _G.ePlayAactionEvent.PlayAactionCj,
        {_G.ActiveTaskEnum.ConditionEnum.Beast.BeastStar, sid, star},
        beastStar,
        nil,
        true
    )
end

--X品阶Y星级圣兽达到Z个
function BeastModel:CheckQualityStar(order, star, count)
    local beastCount = 0
    for _, v in pairs(self:GetAllActiveBeasts()) do
        if v:GetOrder() == order then
            if v:GetStar() >= star then
                beastCount = beastCount + 1
            end
        end
    end
    beastCount = beastCount > count and count or beastCount
    _G.Events:GetInstance():Broadcast(
        _G.ePlayAactionEvent.PlayAactionCj,
        {_G.ActiveTaskEnum.ConditionEnum.Beast.BeastQualityStarNum, order, star, count},
        beastCount,
        nil,
        true
    )
end

