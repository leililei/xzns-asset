---获取所有灵兽数据(灵兽界面排序 可激活>已激活>未激活 品质高的在前，品质相同时星级高的在前,星级相同时等级高的在前，等级相同时SID大的在前)
function BeastModel:GetAllBeastsBySort()
    local beastList = {}
    local condition
    for _, v in pairs(self.beasts) do
        condition = v.cfg.condition_type
        if condition == nil or #condition == 0 or _G.GlobalConditionManager.CheckConditionByArray(condition) then
            if not self.beastGetStates[v.sid] then
                self.beastGetStates[v.sid] = v:IsCanGet()
            end
            table.insert(beastList, v)
        end
    end

    _G.SortList(
        beastList, 
        function(item)
            local activeState = 1--可激活置顶，未激活置底
            if self.beastGetStates[item.sid] == true then
                activeState = 2
            elseif item.active == false then
                activeState = 0
            end
            return activeState, item:GetOrder(), item:GetStar(), item:GetLevel(), -item.sid
        end
    )
    return beastList
end

---获取圣兽加成属性
function BeastModel:GetBeastAttribute()
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local attribute = AttributeClassManager:GetAttribtueClass()
    local attributes = { atk = 0, bre = 0, def = 0, max_hp = 0 }
    local precent = _G.ConfigManager.discrete_cfg[200212][1][1] / 10000
    local skillAttrList = {}
    for _, v in pairs(self.beasts) do
        if v:GetIsActive() then
            local attr = v:GetAttribute()
            local skill = v:GetSkill_3()
            local cfg = _G.ConfigManager.attribute_cfg[skill[v:GetStar() + 1]]
            if cfg and cfg.attribute then
                _G.table.insert(skillAttrList, cfg.attribute)
            end
            for name, _ in pairs(attributes) do
                attributes[name] = attributes[name] + _G.Mathf.RoundToInt(attr:GetValueByName(name, _G.AttCountType.base) * precent)
            end
        end
    end
    for name, value in pairs(attributes) do---圣兽基础属性按百分比直接加成
        attribute:AddValueByName(
                name,
                AttributeClassManager:GetValueWithName(name, value, _G.AttCountType.other),
                false,
                _G.AttCountType.other
        )
    end
    for _, v in pairs(skillAttrList) do---圣兽潜能属性加成
        if not _G.table.isEmptyOrNil(v) then
            for i = 1, #v do
                local type = v[i][2] == "1" and _G.AttCountType.other or _G.AttCountType.basePercent
                attribute:AddValueByName(
                        v[i][1],
                        AttributeClassManager:GetValueWithName(v[i][1], v[i][3], type),
                        false,
                        type
                )
            end
        end
    end
    return attribute
end

