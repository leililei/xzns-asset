local base = _G.GameDataModelBase
---@class BeastEmbattleModel : GameDataModelBase
local BeastEmbattleModel = _G.BaseClass("BeastEmbattleModel", base)

---@return BeastEmbattleModel BeastEmbattleModel
function BeastEmbattleModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function BeastEmbattleModel:__init()
    self.curFunctionOpenID = _G.FunctionID.Beast
end

---获取当前打开的布阵界面的Controller
function BeastEmbattleModel:GetController()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.EmbattleView.Name)
    if view then
        return view.curEmbattleItem, view.curEmbattleIndex, view.isEdit
    end
    return nil
end

---检测布阵红点
function BeastEmbattleModel:CheckRedpoint(params)
    local controller, index, isEdit = self:GetController()
    if controller == nil then
        return 0
    end
    local unlock = controller:GetBeastSkillState()
    if unlock[params] == false then--当前栏位未解锁
        return 0
    end
    local curBeastSkills = controller:GetBeastSkillData(index) or { 0, 0, 0 }
    if curBeastSkills[params] ~= 0 then--当前栏位已上阵
        return 0
    end
    local disableBeasts = isEdit and {} or controller:GetOtherGroupBeastSkillData(index)
    local allBeasts = require("BeastModel"):GetInstance():GetAllActiveBeasts()
    local canSelectBeasts = _G.table.chooseToArray(
        allBeasts,
        function(_, beast)
            local sid = beast.sid
            if _G.table.ContainsValue(disableBeasts, sid) then--其他队已使用
                return false
            end
            for i = 1, 3 do
                if params ~= i and curBeastSkills[i] == sid then
                    return false
                end
            end
            if params ~= 1 then
                return beast:GetSkill()[1][2] ~= 0--协战位没有协战技能排除
            end
            return true
        end
    )
    return #canSelectBeasts > 0 and 1 or 0
end

---销毁对象时,析构函数
function BeastEmbattleModel:Dispose()
end

return BeastEmbattleModel
