require "ItemViewBase"

---@class ItemUseView : UIBaseView	中文描述
---@field public go_table ItemUseView_GoTable GoTable
local ItemUseView = _G.BaseClass("ItemUseView", _G.UIBaseView)
--_G.ItemUseView = ItemUseView

local CS = _G.CS
local typeof = _G.typeof
local tipsID = {
    NotSelect = 380101,
    OverMaxCount = 380102
}
local GetMaterialPath = "UI/ItemUseView/GetMaterial"

function ItemUseView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param sid number 道具id
---@param call function 使用成功回调
function ItemUseView:OnCreate(sid, call)
    if sid == 0 or sid == nil then
        self:Close()
        return
    end
    self.sid = sid
    self.call = call
    self.cfg = _G.ConfigManager.item_cfg[sid]
    self.itemData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, sid)
    if self.cfg.UseType == _G.ItemUseType.CompoundCard or self.cfg.UseType == _G.ItemUseType.DrawCard then
        self.BaseCount = tonumber(self.cfg.UseParameter[1][1])
        self.CurNumber = 0
    else
        self.CurNumber = 1
        self.BaseCount = 1
    end
    -- self.BaseCount = self.CurNumber
    self.go_table.aortext_ItemNum.text = self.itemData.count
    -- self.go_table.aorimage_ItemBG.SpriteName = _G.itemColorIconName[self.itemData.Grade]
    -- self.go_table.aorrawimage_ItemIcon:LoadImage(self.itemData.Icon)
    self.go_table.aortext_ItemName.text = self.itemData:GetName()
    self.go_table.aortext_Number.text = self.CurNumber
    _G.StorageManager:GetInstance():GetItemBaseView(
        sid,
        nil,
        self.go_table.aorimage_ItemBG,
        function(item)
            if self:IsNil() then
                _G.DestroyObject(item.go_table.gameObject)
            end
        end
    )
    if self.cfg.UseType == _G.ItemUseType.GetXHourAfkAward then
        self:CreateMaterial()
    end
end

---创建获取材料预览
function ItemUseView:CreateMaterial()
    self.Material = {}
    for i = 1, #self.cfg.UseParameter do
        _G.PoolsManager:GetInstance():Spawn(
            GetMaterialPath,
            _G.ePoolType.UIItem,
            self.go_table.obj_MaterialContent,
            function(tran)
                if tran then
                    self.Material[self.cfg.UseParameter[i][1]] = {}
                    self.Material[self.cfg.UseParameter[i][1]].item =
                        _G.GetAutoGoTable(
                        tran,
                        function(go)
                            require("CommonTipManager"):GetInstance():OpenTip(go, tonumber(self.cfg.UseParameter[i][1]))
                        end
                    )
                    self.Material[self.cfg.UseParameter[i][1]].value = tonumber(self.cfg.UseParameter[i][2])
                    if i == #self.cfg.UseParameter then
                        self:UpdateMaterial()
                    end
                end
            end
        )
    end
end

---刷新获取材料预览
function ItemUseView:UpdateMaterial()
    local AfkEff, itemData
    if self.Material then
        for i, v in pairs(self.Material) do
            AfkEff = require("AfkModel"):GetInstance():GetCurEfficiency({tonumber(i), v.value})
            itemData = _G.StorageManager:GetInstance():GetItemDataClass(tonumber(i), 1)
            v.item.aorrawimage_Icon:LoadImage(itemData.Icon)
            v.item.aortext_Have.text = _G.GameUtil.NumberToUnitStr(AfkEff * self.CurNumber)
        end
    end
end

---修改选择数量
---@param num number 增减数量
function ItemUseView:ModifyNumber(num)
    local count = self.CurNumber + num * self.BaseCount
    if count <= 0 then
        return
    end
    if count > self.itemData.count then
        _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.OverMaxCount)
        return
    end

    local hcCount = math.floor(count / self.BaseCount)
    if hcCount > 99 then
        count = 99 * self.BaseCount
        hcCount = 99
    end

    self.CurNumber = count
    self.go_table.aortext_Number.text = tostring(hcCount)
    if self.cfg.UseType == _G.ItemUseType.GetXHourAfkAward then
        self:UpdateMaterial()
    end
end

---确认购买
function ItemUseView:UsedItemDone()
    if self.CurNumber <= 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.NotSelect)
        return
    end
    if self.cfg.UseType == _G.ItemUseType.GetXHourAfkAward then
        if require("AfkModel"):GetInstance():GetCurEfficiency(self.cfg.UseParameter[1]) == 0 then
            return
        end
    end

    _G.StorageManager:GetInstance():UsePropToServer(
        self.sid,
        self.CurNumber / self.BaseCount,
        function()
            if self.call then
                self.call()
            end
            self:Close()
        end
    )
end

---按钮点击事件在这里派发
function ItemUseView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_Cancel" then
        self:Close()
    elseif name == "@_aorbtn_Max" then
        self:ModifyNumber(_G.math.floor(self.itemData.count / self.BaseCount - self.CurNumber / self.BaseCount))
    elseif name == "@_aorbtn_Sub10" then
        self:ModifyNumber(-10)
    elseif name == "@_aorbtn_Add10" then
        self:ModifyNumber(10)
    elseif name == "@_aorbtn_Sub1" then
        self:ModifyNumber(-1)
    elseif name == "@_aorbtn_Add1" then
        self:ModifyNumber(1)
    elseif name == "@_aorbtn_Done" then
        self:UsedItemDone()
    end
end

return ItemUseView
