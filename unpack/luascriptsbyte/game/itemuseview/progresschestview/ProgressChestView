---@class ProgressChestView : UIBaseView	中文描述
---@field public go_table ProgressChestView_GoTable GoTable
---@field itemData PropData
local ProgressChestView = _G.BaseClass("ProgressChestView", _G.UIBaseView)
--_G.ProgressChestView = ProgressChestView

local SelectItem = "UI/ItemUseView/ProgressChestItem"
local tipsID = {
    NotSelect = 380106,
    OverMaxCount = 380102
}
function ProgressChestView:Awake()
    self.UiDic = {
        itembg = {
            [1] = "bb_kuang_01",
            [2] = "bb_kuang_02"
        },
        lang = {
            ---一键领取
            yjlq = 90020400087,
            ---第%d章
            type4 = 90020400088,
            ---第%d层
            type8 = 90020400089,
            ---第%d天
            type9 = 90020400090
        },
        down = {
            text = {
                ---达成
                [1] = 90020400085,
                ---未达成
                [2] = 90020400086
            },
            color = {
                ---达成
                [1] = require("CardInfoManager").GetColorFromRGB("14874a"),
                ---未达成
                [2] = require("CardInfoManager").GetColorFromRGB("808199")
            }
        },
        top = {
            color = {
                ---达成
                [1] = require("CardInfoManager").GetColorFromRGB("c95f00"),
                ---未达成
                [2] = require("CardInfoManager").GetColorFromRGB("4e5278")
            }
        }
    }

    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param sid number 道具id
---@param call function 使用成功回调
function ProgressChestView:OnCreate(sid, call)
    if sid == 0 or sid == nil then
        self:Close()
        return
    end
    self.sid = sid
    self.call = call
    self.cfg = _G.ConfigManager.item_cfg[sid]
    local item_box_con_cfgID = tonumber(self.cfg.UseParameter[1][1])
    ---@type item_box_con_cfg
    self.item_box_con_cfg = _G.ConfigManager.item_box_con_cfg[item_box_con_cfgID]

    self.itemData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, sid)

    self.go_table.aortext_ItemName.text = self.itemData:GetName()
    self.CurSelect = {}
    self.SelectItems = {}

    self.go_table.aortext_ItemNum.text = string.format("%d/%d ", 1, self.itemData.count)

    self.go_table.aortext_des.text = self.itemData:GetDescribe()

    ---@param itemLua itemViewNewWithCount
    _G.ItemFactory:GetInstance():GetItemCard(
        _G.ItemFactory.itemType.ItemBaseWithCount,
        self.go_table.obj_item,
        function(itemLua)
            self.go_table.item = itemLua
            itemLua:Show(self.sid)
        end
    )

    ---当前已领取索引
    self.NowGetNum = self.itemData.progress or 0
    ---可领取索引 1->  nil不能领取
    self.CurSelectNum = nil
    local ispass
    for i, v in pairs(self.item_box_con_cfg.rewards) do
        local condition_params = self.item_box_con_cfg.condition_params[i]
        if condition_params ~= nil then
            if self.item_box_con_cfg.condition_type == 0 then
                ispass = _G.GlobalConditionManager.CheckCondition(_G.GlobalConditionManager.ConditionType.createRoleDay,
                    condition_params, self.itemData:GetProgressChestArgs().time)
            else
                ispass = _G.GlobalConditionManager.CheckCondition(self.item_box_con_cfg.condition_type, condition_params)
            end
            if ispass then
                self.CurSelectNum = i
            else
                break
            end
        end
    end

    if self.CurSelectNum ~= nil then
        if self.CurSelectNum > self.itemData.progress then
            ---有新的进度可领取
        else
            ---没有可领取
            self.CurSelectNum = nil
        end
    end

    self:CreateItem()
end

---创建可选择的道具
function ProgressChestView:CreateItem()
    ---生成item数量
    self.ItemCount = #self.item_box_con_cfg.rewards

    local sid, num

    ----道具数量 小于4 居中
    local objNum = 0

    for i, v in pairs(self.item_box_con_cfg.rewards) do
        objNum = objNum + 1
        _G.PoolsManager:GetInstance():Spawn(
            SelectItem,
            _G.ePoolType.UIItem,
            self.go_table.obj_Content,
            function(tran)
                if not self.go_table then
                    _G.DestroyImmediate(tran)
                    return
                end
                if tran then
                    self:SetItem(tran, v, tonumber(i))
                end
            end
        )
    end

    ---true可以左右滑动
    local isH = true
    local x = 24
    if objNum < 4 then
        objNum = objNum - 1
        x = 310 - 10 * objNum - objNum * 70
        isH = false
    end

    self.go_table.obj_View:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect)).horizontal = isH
    self.go_table.obj_View:SetAnchorPosition(x, -95)
end

function ProgressChestView:UpdataItem()
    ---当前已领取索引
    self.NowGetNum = self.itemData.progress or 0
    ---可领取索引 1->  nil不能领取
    self.CurSelectNum = nil
    local ispass
    for i, v in pairs(self.item_box_con_cfg.rewards) do
        local condition_params = self.item_box_con_cfg.condition_params[i]
        if condition_params ~= nil then
            if self.item_box_con_cfg.condition_type == 0 then
                ispass = _G.GlobalConditionManager.CheckCondition(_G.GlobalConditionManager.ConditionType.createRoleDay,
                    condition_params, self.itemData:GetProgressChestArgs().time)
            else
                ispass = _G.GlobalConditionManager.CheckCondition(self.item_box_con_cfg.condition_type, condition_params)
            end
            if ispass then
                self.CurSelectNum = i
            else
                break
            end
        end
    end

    if self.CurSelectNum ~= nil then
        if self.CurSelectNum > self.itemData.progress then
            ---有新的进度可领取
        else
            ---没有可领取
            self.CurSelectNum = nil
        end
    end

    local sid, num
    for i, v in pairs(self.item_box_con_cfg.rewards) do
        self:SetItem(nil, v, tonumber(i))
        self.SelectItems[i].gameObject:SetSiblingIndexE(i - 1)
    end

    ---把领取了的 挪到后面
    if self.itemData.progress ~= nil then
        for i = 1, self.itemData.progress do
            self.SelectItems[i].gameObject:SetSiblingIndexE(99)
        end
    end
end
---创建可选择的道具
function ProgressChestView:SetItem(tran, data, i)
    local go_table, itemData

    itemData = _G.StorageManager:GetInstance():GetItemDataClassByCfg(data)

    if self.SelectItems[i] == nil then
        self.SelectItems[i] = _G.GetAutoGoTable(tran, _G.handlerbind(self, self.ClickSelectItem, i, data[1]))
    end
    go_table = self.SelectItems[i]
    ---true条件达成
    local ispass = false
    ---true条件达成
    local isGet = self.NowGetNum >= i
    ---条件描述
    local str = ""

    local condition_params = self.item_box_con_cfg.condition_params[i]
    if condition_params == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("condition_params 解锁参数未配置全  " .. self.item_box_con_cfg.id)
        end
    else
        local tispass = 0
        local tstr = 0
        if self.item_box_con_cfg.condition_type == 0 then
            tispass, tstr = _G.GlobalConditionManager.GetTipsText(_G.GlobalConditionManager.ConditionType.createRoleDay,
                condition_params, itemData:GetProgressChestArgs().time)
        else
            tispass, tstr = _G.GlobalConditionManager.GetTipsText(self.item_box_con_cfg.condition_type,
                condition_params)
        end
        ispass = tispass
        str = tstr

        ---特殊显示 描述        ---第%d章        ---第%d层        ---第%d天
        if self.item_box_con_cfg.condition_type == 4 then
            ---@type afk_cfg
            local afk_cfg = _G.ConfigManager.afk_cfg[condition_params]
            str = _G.LangUtil.GetLangPackValue(self.UiDic.lang.type4, afk_cfg.chapter)
        elseif self.item_box_con_cfg.condition_type == 8 then
            ---@type tower_cfg
            local tower_cfg = _G.ConfigManager.tower_cfg[condition_params]
            str = _G.LangUtil.GetLangPackValue(self.UiDic.lang.type8, tower_cfg.layer)
        elseif self.item_box_con_cfg.condition_type == 9 or self.item_box_con_cfg.condition_type == 0 then
            str = _G.LangUtil.GetLangPackValue(self.UiDic.lang.type9, condition_params)
        end
    end
    go_table.aortext_top.text = str
    go_table.aortext_down.text = _G.LangUtil.GetLangPackValue(self.UiDic.down.text[ispass and 1 or 2])
    go_table.aortext_top.color = self.UiDic.top.color[ispass and 1 or 2]
    go_table.aortext_down.color = self.UiDic.down.color[ispass and 1 or 2]
    go_table.aorimage_bg.SpriteName = self.UiDic.itembg[ispass and 1 or 2]

    _G.GameUtil.SetActiveByCondition(go_table.aorimage_Mask, isGet)
    _G.GameUtil.SetActiveByCondition(go_table.aortext_down, isGet == false)
    _G.GameUtil.SetActiveByCondition(go_table.aorimage_get, isGet)

    if not go_table.item then
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            data,
            go_table.obj_item,
            function(itemLua)
                itemLua:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                go_table.item = itemLua
            end
        )
    end
    self:SetItemCountOver()
end

---列表item创建完成
function ProgressChestView:SetItemCountOver()
    self.ItemCount = self.ItemCount - 1
    if self.ItemCount ~= 0 then
        return
    end
    ---把领取了的 挪到后面
    if self.itemData.progress ~= nil then
        for i = 1, self.itemData.progress do
            self.go_table.obj_Content:GetChildE(0):SetSiblingIndexE(99)
        end
    end
end

---选择完毕确认使用
function ProgressChestView:Done()
    if self.CurSelectNum == nil then
        _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.NotSelect)
        return
    else
        _G.StorageManager:GetInstance():UsePropToServer(
            self.sid,
            self.CurSelectNum,
            function()
                self.itemData.progress = self.CurSelectNum
                ---领取完就关闭
                if self.itemData.progress == #self.item_box_con_cfg.rewards then
                    if self.call then
                        self.call()
                    end
                    self:Close()
                else
                    ---没领取完就刷新
                    self:UpdataItem()
                end
                ---红点显示 道具
                require("RedPointManager"):GetInstance():RefreshNode(
                    _G.ConfigManager.redpoint_cfg.BackpackItem.id,
                    self.sid
                )
            end
        )
    end
end

---按钮点击事件在这里派发
function ProgressChestView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_BG" or name == "@_aorbtn_Cancel" then
        self:Close()
    elseif name == "@_aorbtn_get" then
        self:Done()
    end
end

return ProgressChestView
