---获取真实的索引
function BoxUseView:GetRealIndex(index)
    local data = self.itemCfgList[index]

    local count = table.count(self.cfg.UseParameter)
    for i, v in ipairs(self.cfg.UseParameter) do
        if data[1] == v[1] then
            --- 装备第三个参数判断种族
            if #data >= 3 then
                if data[3] == v[3] then
                    return i
                end
            else
                return i
            end
        end
    end

    for i, v in ipairs(self.cfg.UseParameter2) do
        if data[1] == v[1] then
            --- 装备第三个参数判断种族
            if #data >= 3 then
                if data[3] == v[3] then
                    return i + count
                end
            else
                return i + count
            end
        end
    end
    return index
end

---选择完毕确认使用
function BoxUseView:Done()
    local list = {}
    for i, v in pairs(self.CurSelect) do
        if v ~= 0 then
            list[self:GetRealIndex(i)] = v
        end
    end
    if _G.table.count(list) < 1 then
        _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.NotSelect)
        return
    else
        local item = {}
        item[self.Index] = self.CurSelectNum
        _G.StorageManager:GetInstance():UsePropToServer(self.sid, self.CurSelectNum, function()
            if self.call then
                self.call()
            end
            self:Close()
        end, list)
    end
end

---选择完毕确认使用
function BoxUseView:DoneUseTape()
    if self.Index == 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.NotSelect)
        return
    else
        _G.StorageManager:GetInstance():UsePropToServer(self.sid, self.CurSelectNum, function()
            if self.call then
                self.call()
            end
            self:Close()
        end, {1}, self.Index)
    end
end

---判断英雄是否在上阵队伍中
function BoxUseView:CardIsInEmbattle(uid, Embattle)
    if not Embattle or table.isEmptyOrNil(Embattle) then
        return false
    end
    for i = 1, #Embattle do
        if uid == Embattle[i] then
            return true
        end
    end
    return false
end

---按钮点击事件在这里派发
function BoxUseView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_close" then
        self:Close()
    elseif name == "@_aorbtn_Done" then
        self:Done()
    elseif name == "@_aorbtn_propSub" then
        self:SetSelect(-1)
    elseif name == "@_aorbtn_propAdd" then
        self:SetSelect(1)
    elseif name == "@_aorbtn_propMax" then
        self.CurSelectNum = self.itemData.count > 9999 and 9999 or self.itemData.count
        self.go_table.aortext_useNum.text = _G.GetLangPackValue(90020200043, self.CurSelectNum, self.itemData.count)
        _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(self.go_table.aorimage_numdi.rectTransform)
        self.go_table.input_userNum.text = self.CurSelectNum
    end
end

