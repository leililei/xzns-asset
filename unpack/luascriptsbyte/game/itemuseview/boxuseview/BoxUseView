---点击选择道具增减
---@param index number 下标
function BoxUseView:ClickSelectItem(go, isOn, index, id, sid, param)
    local name = go:GetName()
    if name == "@_aorbtn_Sub" then
        self:SetSelectOne(index, id, -1)
    elseif name == "@_aorbtn_Add" then
        self:SetSelectOne(index, id, 1)
    elseif name == "@_aorbtn_ShowTips" then
        if self.cfg.UseType == _G.ItemUseType.SelectProp then
            require("CommonTipManager"):GetInstance():OpenTip(go, tonumber(sid), nil, nil, _G.tonumber(param))
        else
            self.Index = index
            if self.CurSelectNum == nil then
                self.CurSelectNum = 1
            else
                if self.itemData.count <= self.CurSelectNum then
                    self.CurSelectNum = self.itemData.count
                end
            end
            self.go_table.input_userNum.text = self.CurSelectNum
            self:KuangXianShi()
        end
    elseif name == "@_aorbtn_DianJi" then
        if self.UseType == _G.ItemUseType.GetProp then
            self.Index = index
            if self.CurSelectNum == nil then
                self.CurSelectNum = 1
            end
            self.go_table.aortext_useNum.text = _G.GetLangPackValue(90020200043, self.CurSelectNum, self.itemData.count)
            self:KuangXianShi()
        end
    elseif name == "@_aorbtn_Max" then
        local otherCount = 0
        local curCount = 0
        for k, v in pairs(self.CurSelect) do
            if k ~= index then
                otherCount = otherCount + v
            else
                curCount = v
            end
        end
        local maxLimit = _G.math.min(self.itemData.count, self.itemData.cfg.limit_num)
        self:SetSelectOne(index, id, maxLimit - otherCount - curCount)
    end
end

