    [1] = "FFFFFF",
    [2] = "076b2f",
    [3] = "1461a8",
    [4] = "612b8b",
    [5] = "d2510b",
    [6] = "c62121",
    [7] = "ce9c07",
    [8] = "B381FF"
}
