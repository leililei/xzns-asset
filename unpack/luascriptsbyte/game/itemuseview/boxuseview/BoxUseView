}
function BoxUseView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param sid number 道具id
---@param call function 使用成功回调
function BoxUseView:OnCreate(itemData, call)
    if itemData == 0 or itemData == nil then
        self:Close()
        return
    end
    self.sid = itemData.sid
    self.call = call
    self.cfg = _G.ConfigManager.item_cfg[self.sid]
    -- self.itemData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, self.sid)
    self.itemData = itemData
    -- self.go_table.obj_useCount:SetActiveE(0)
    if self.itemData.Grade > 7 then
        self.go_table.aortext_ItemName:SetActiveE(0)
        self.go_table.aortext_ChromaName:SetActiveE(1)
        self.go_table.aortext_ChromaName.text = self.itemData:GetName()
    else
        self.go_table.aortext_ItemName:SetActiveE(1)
        self.go_table.aortext_ChromaName:SetActiveE(0)
        self.go_table.aortext_ItemName.text = self.itemData:GetName()
        self.go_table.aortext_ItemName.color = _G.ColorTools.FormatColorByString(
            NameColor[self.itemData.Grade] or "FFFFFF")
    end
    self.CurSelect = {}
    self.CurSelectNum = 0
    self.Index = 0
    self.SelectItems = {}

    self.UseType = self.cfg.UseType or 0
    self.go_table.aortext_useNum.text = _G.GetLangPackValue(90020200043, self.CurSelectNum, self.itemData.count)
    self.go_table.aortext_haveNum.text = _G.GetLangPackValue(90000010363, self.itemData.count)

    self.go_table.aortext_des.text = self.itemData:GetDescribe()

    self.itemType = 1

    -- if self.cfg.UseType == _G.ItemUseType.GetProp then
    --     self.CurSelectNum = 1
    --     self.go_table.obj_useCount:SetActiveE(1)
    -- elseif self.cfg.UseType == _G.ItemUseType.SelectProp then
    --     self.CurSelectNum = 0
    --     self.go_table.obj_useCount:SetActiveE(0)
    -- end
    self.go_table.input_userNum.onEndEdit:RemoveAllListeners()
    self.go_table.input_userNum.onEndEdit:AddListener(_G.handlerbind(self, self.OnEndEditorDeclaration))

    self.go_table.input_userNum.text = self.CurSelectNum
    ---@param itemLua itemViewNewWithCount
    _G.ItemFactory:GetInstance():GetItemCard(_G.ItemFactory.itemType.ItemBaseWithCount, self.go_table.obj_item,
        function(itemLua)
            self.go_table.item = itemLua
            itemLua:Show(self.sid)
        end)

    self:CreateItem()
end

---创建可选择的道具
function BoxUseView:CreateItem()
    self.itemCfgList = {}
    _G.table.insertto(self.itemCfgList, self.cfg.UseParameter)
    for i, v in pairs(self.cfg.UseParameter2) do
        if _G.GlobalConditionManager.CheckConditionByArray({self.cfg.use_parameter2_con[i]}) then
            _G.table.insert(self.itemCfgList, v)
        end
    end

    local v = _G.StorageManager:GetInstance():GetItemDataClassByCfg(self.itemCfgList[1])
    local type, id = _G.StorageManager:GetInstance():CheckSidType(v.sid)

    if type == _G.StorageType.Artifact or type == _G.StorageType.Remains or type == _G.StorageType.Equipment or
        (type == _G.StorageType.Prop and v.cfg.Type1 == _G.ItemCfgType.BuildChip) or
        (type == _G.StorageType.Prop and v.cfg.Type1 == _G.ItemCfgType.SpoilsChip) then
        self.itemType = 1
        local EmbattleModel = require "EmbattleModel":GetInstance()
        self.afkCardIds = EmbattleModel:GetEmbattleData(_G.EmbattleType.AFK)
        self.afkOnlyIds = EmbattleModel:GetEmbattleData(_G.EmbattleType.AFKOnly)
        self.afkGroupIds1 = EmbattleModel:GetEmbattleData(_G.EmbattleType.AFKGroup1)
        self.afkGroupIds2 = EmbattleModel:GetEmbattleData(_G.EmbattleType.AFKGroup2)
        self.afkGroupIds3 = EmbattleModel:GetEmbattleData(_G.EmbattleType.AFKGroup3)
        self.afkGroupIds4 = EmbattleModel:GetEmbattleData(_G.EmbattleType.AFKGroup4)
        self.afkGroupIds5 = EmbattleModel:GetEmbattleData(_G.EmbattleType.AFKGroup5)
        self.arenaAtkCardIds = EmbattleModel:GetEmbattleData(_G.EmbattleType.arenaAttack)
        self.arenaDefCardIds = EmbattleModel:GetEmbattleData(_G.EmbattleType.arenaDefence)
        self.go_table.scrollloopvectical_View1:InitItemData(_G.table.count(self.itemCfgList),
            _G.handler(self, self.RefreshItem))
        self.go_table.scrollloopvectical_View:SetActiveE(0)
    else
        self.itemType = 2
        self.go_table.scrollloopvectical_View:InitItemData(_G.table.count(self.itemCfgList),
            _G.handler(self, self.RefreshItem))
        self.go_table.scrollloopvectical_View1:SetActiveE(0)
    end
end

function BoxUseView:RefreshItem(index, obj)
    index = index + 1
    local data = self.itemCfgList[index]
    self:SetItem(obj, data, index)
end

---创建可选择的道具
function BoxUseView:SetItem(tran, data, i)
    local go_table, itemData
    local _data = {}
    local id = tran:GetInstanceIDE()
    itemData = _G.StorageManager:GetInstance():GetItemDataClassByCfg(data)

    go_table = _G.GetAutoGoTable(tran, _G.handlerbind(self, self.ClickSelectItem, i, id, data[1], data[3]))
    go_table.aorbtn_Add.LongPress = true
    go_table.aorbtn_Add.onLongPress = _G.handlerbind(self, self.ClickSelectItem,go_table.aorbtn_Add,true, i, id, data[1], data[3])
    self.SelectItems[id] = go_table

    if self.UseType == _G.ItemUseType.GetProp then
        -- body
        go_table.obj_LeiXing:SetActiveE(0)

        local itemName = _G.StorageManager:GetInstance():GetItemName(_G.tonumber(data[1]))
        go_table.aortext_Name.text = itemName
    end
    if i == self.Index and self.cfg.UseType == _G.ItemUseType.GetProp then
        go_table.aorimage_Kuang:SetActiveE(1)
    else
        go_table.aorimage_Kuang:SetActiveE(0)
    end
    if self.cfg.UseType == _G.ItemUseType.SelectProp then
        go_table.obj_LeiXing:SetActiveE(1)
        -- ZHJH-8498 只有资源箱显示最大按钮
        local showMaxBtn = false
        for _, v in pairs(resBox) do
            if v == self.sid then
                showMaxBtn = true
                break
            end
        end
        if go_table.aorbtn_Max then
            go_table.aorbtn_Max:SetActiveE(showMaxBtn and 1 or 0)
        end
    else
        go_table.obj_LeiXing:SetActiveE(0)
    end
    -- local _,id = _G.StorageManager:GetInstance():CheckSidType(itemData.sid)
    go_table.aortext_Name.text = _G.GetLangPackValue(itemData.cfg.Name or itemData.cfg.name)

    go_table.input_Name.onEndEdit:RemoveAllListeners()
    go_table.input_Name.onEndEdit:AddListener(_G.handlerbind(self, self.OnEndEditorDeclarationOen, i, id, data[1]))
    go_table.input_Name.text = self.CurSelect[i] or 0
    local StorageManager = _G.StorageManager:GetInstance()
    go_table.aorbtn_tip:SetActiveE(0)
    if self.itemType == 1 then
        go_table.obj_progress:SetActiveE(0)
        go_table.obj_maxStar:SetActiveE(0)
    end
    --- 道具类型为 灵兽碎片
    if itemData.cfg.Type1 == _G.ItemCfgType.PetChip then
        local petModel = require("PetModel"):GetInstance()
        local isMaxStar, nextProgress = petModel:GetUpStarByPropId(itemData.sid)
        if isMaxStar then
            go_table.aorimage_maxStar:SetActiveE(1)
        else
            go_table.slider_progress:SetActiveE(1)
            local haveNum = StorageManager:GetItemCountBySid(itemData.sid)
            go_table.slider_progress.value = haveNum / nextProgress
            go_table.aortext_Slider.text = haveNum .. "/" .. nextProgress
        end

        --- 获取灵兽星级，并设置
        local petId = petModel:GetPetIdByPropId(itemData.sid)
        local petData = petModel:GetPet(petId)
        -- 是否已经激活
        if petData:GetIsActive() then
            -- 判断是否满星
            if not petData:IsMaxStar() then
                --- 在灵兽碎片进度条左侧放置 灵兽星级
                local starNum = petData:GetStar()
                go_table.aortext_starNum.text = _G.GetLangPackValue(90000010475, starNum + 1)
            else
                go_table.aortext_starNum.text = ""
            end
        else
            -- 文字设置为 激活
            go_table.aortext_starNum.text = _G.GetLangPackValue(90000011073)
        end
        go_table.aorimage_star:SetActiveE(1)
    elseif itemData.cfg.Type1 == _G.ItemCfgType.BuildChip then
        go_table.aorimage_tipsBg:SetActiveE(0)
        go_table.obj_progress:SetActiveE(1)
        go_table.aortext_Name:SetLocalPosition(0, 30, 0)

        local buildSid = itemData.cfg.UseParameter2[1][1]
        local buildData = require("BuildDrawModel"):GetInstance():GetBuild(buildSid)
        if not buildData:GetIsActive() then
            -- 没有激活
            go_table.obj_jindu:SetActiveE(1)
            go_table.aortext_star:SetActiveE(1)
            go_table.obj_maxStar:SetActiveE(0)
            go_table.aortext_star.text = _G.GetLangPackValue(90000010475, 0)
            go_table.aortext_progress.text = 0 .. "/" .. 0
            go_table.aorimage_activeSchedule:SetLocalScale(0, 1, 1)
        elseif not buildData:IsMaxStar() then
            -- 没有满星
            go_table.obj_jindu:SetActiveE(1)
            go_table.aortext_star:SetActiveE(1)
            go_table.obj_maxStar:SetActiveE(0)
            go_table.aortext_star.text = _G.GetLangPackValue(90000010475, buildData:GetStar())
            local count = buildData:GetItemCount()
            local needCount = buildData:GetUpCostNum()
            go_table.aortext_progress.text = count .. "/" .. needCount
            if needCount <= count then
                go_table.aorimage_activeSchedule:SetLocalScale(1, 1, 1)
            else
                go_table.aorimage_activeSchedule:SetLocalScale(count / needCount, 1, 1)
            end
        else
            -- 满星
            go_table.obj_jindu:SetActiveE(0)
            go_table.aortext_star:SetActiveE(0)
            go_table.obj_maxStar:SetActiveE(1)
        end
    elseif itemData.cfg.Type1 == _G.ItemCfgType.Remains then
        go_table.aorimage_tipsBg:SetActiveE(0)
        go_table.obj_progress:SetActiveE(1)
        go_table.aortext_Name:SetLocalPosition(0, 30, 0)
        go_table.aortext_Name:SetActiveE(1)
        go_table.aorimage_noHave:SetActiveE(0)
        go_table.aorimage_Have:SetActiveE(1)
        -- go_table.aorimage_tipsBg.SpriteName = bgColorPath[4]
        -- go_table.aortext_tipsname.text = _G.GetLangPackValue(itemData.cfg.Name or itemData.cfg.name)
        local remainsSid = itemData.cfg.UseParameter2[1][1]
        local remainsData = require("RemainsModel"):GetInstance():GetData(remainsSid)
        if not remainsData:GetIsActive() then
            -- 没有激活
            go_table.obj_jindu:SetActiveE(1)
            go_table.aorimage_noHave:SetActiveE(1)
            go_table.aorimage_Have:SetActiveE(0)
            go_table.aortext_star:SetActiveE(1)
            go_table.obj_maxStar:SetActiveE(0)
            go_table.aortext_star.text = _G.GetLangPackValue(90000010475, 0)
            go_table.aortext_progress.text = 0 .. "/" .. 0
            go_table.aorimage_activeSchedule:SetLocalScale(0, 1, 1)
        elseif not remainsData:IsMaxStar() then
            -- 没有满星
            go_table.obj_jindu:SetActiveE(1)
            go_table.aortext_star:SetActiveE(1)
            go_table.obj_maxStar:SetActiveE(0)
            go_table.aortext_star.text = _G.GetLangPackValue(90000010475, remainsData:GetStar())
            local count = remainsData:GetStarUpCurHave()
            local needCount = remainsData:GetStarUpCost()
            go_table.aortext_progress.text = count .. "/" .. needCount
            if needCount <= count then
                go_table.aorimage_activeSchedule:SetLocalScale(1, 1, 1)
            else
                go_table.aorimage_activeSchedule:SetLocalScale(count / needCount, 1, 1)
            end
        else
            -- 满星
            go_table.obj_jindu:SetActiveE(0)
            go_table.aortext_star:SetActiveE(0)
            go_table.obj_maxStar:SetActiveE(1)
        end
    elseif itemData.cfg.Type1 == _G.ItemCfgType.SpoilsChip then
        go_table.aorimage_tipsBg:SetActiveE(0)
        go_table.obj_progress:SetActiveE(1)
        go_table.aortext_Name:SetLocalPosition(0, 30, 0)

        local spoilsSid = itemData.cfg.UseParameter2[1][1]

        local spoilsData = require("SpoilsModel"):GetInstance():GetData(spoilsSid)
        if not spoilsData:GetIsActive() then
            -- 没有激活
            go_table.obj_jindu:SetActiveE(1)
            go_table.aortext_star:SetActiveE(1)
            go_table.obj_maxStar:SetActiveE(0)
            go_table.aortext_star.text = _G.GetLangPackValue(90000010475, 0)
            go_table.aortext_progress.text = 0 .. "/" .. 0
            go_table.aorimage_activeSchedule:SetLocalScale(0, 1, 1)
        elseif not spoilsData:IsMaxStar() then
            -- 没有满星
            go_table.obj_jindu:SetActiveE(1)
            go_table.aortext_star:SetActiveE(1)
            go_table.obj_maxStar:SetActiveE(0)
            go_table.aortext_star.text = _G.GetLangPackValue(90000010475, spoilsData:GetStar())
            local count = _G.StorageManager:GetInstance():GetItemCountBySid(spoilsData.cfg.materials_item)
            local needCount = not spoilsData:IsMaxStar() and spoilsData.cfg.material_1[spoilsData:GetStar() + 2] or 0
            go_table.aortext_progress.text = count .. "/" .. needCount
            if needCount <= count then
                go_table.aorimage_activeSchedule:SetLocalScale(1, 1, 1)
            else
                go_table.aorimage_activeSchedule:SetLocalScale(count / needCount, 1, 1)
            end
        else
            -- 满星
            go_table.obj_jindu:SetActiveE(0)
            go_table.aortext_star:SetActiveE(0)
            go_table.obj_maxStar:SetActiveE(1)
        end
    end
    local storageType = StorageManager:CheckSidType(itemData.sid)
    if storageType == _G.StorageType.Spiritual or storageType == _G.StorageType.Artifact then
        local datas = {}
        if storageType == _G.StorageType.Spiritual then
            datas = StorageManager:GetDatasBySid(_G.StorageID.Spiritual, itemData.sid)
        elseif storageType == _G.StorageType.Artifact then
            datas = StorageManager:GetDatasBySid(_G.StorageID.Artifact, itemData.sid)
            local cardId = itemData.cfg.card_id
            if cardId and cardId > 0 then
                local cardCfg = _G.ConfigManager.card_cfg[cardId]
                local icon = cardCfg.Icon
                if _G.string.contains(icon, "/") then
                    icon = _G.string.split2tbl(icon, "/")
                    icon = icon[#icon]
                end
                go_table.aorimage_cardBg:SetActiveE(1)
                go_table.aorimage_cardIcon.SpriteName = icon
                go_table.aorimage_cardBg.SpriteName = "ui_js_txk_cai"
            else
                go_table.aorimage_cardBg:SetActiveE(0)
            end
            self:SetArtifactItem(go_table, itemData.sid, itemData.cfg)
        end
        if go_table.aorimage_tipsBg then
            go_table.aorimage_tipsBg.SpriteName = bgColorPath[itemData.cfg.label[1]]
            go_table.aortext_tipsname.text = _G.LangUtil.GetLangPackValue(itemData.cfg.label[2])
            go_table.aorimage_tipsBg:SetActiveE(1)
        end
        --go_table.aortext_Name:SetLocalPositionToZero()
        local cardList = {}
        if not _G.table.isEmptyOrNil(datas) then
            for _, v in pairs(datas) do
                -- if v.cardUid and v.cardUid > 0 and not v:IsMaxStar() then
                -- 镇魂街ZHJ-27879 Alpha_JT BUG合集ZHJ-34317 测试要求将未觉醒的神器加入快捷使用
                if v.cardUid and v.cardUid > 0 and
                    (not v:IsMaxStar() or storageType == _G.StorageType.Artifact and not v:GetIsAwaken()) then
                    local cardData = StorageManager:GetDatasByUid(_G.StorageID.Card, v.cardUid)
                    if not _G.table.isEmptyOrNil(cardData) and
                        (self:CardIsInEmbattle(v.cardUid, self.afkCardIds) or
                            self:CardIsInEmbattle(v.cardUid, self.afkOnlyIds) or
                            self:CardIsInEmbattle(v.cardUid, self.afkGroupIds1) or
                            self:CardIsInEmbattle(v.cardUid, self.afkGroupIds2) or
                            self:CardIsInEmbattle(v.cardUid, self.afkGroupIds3) or
                            self:CardIsInEmbattle(v.cardUid, self.afkGroupIds4) or
                            self:CardIsInEmbattle(v.cardUid, self.afkGroupIds5) or
                            self:CardIsInEmbattle(v.cardUid, self.arenaAtkCardIds) or
                            self:CardIsInEmbattle(v.cardUid, self.arenaDefCardIds)) then
                        _G.table.insert(cardList, cardData)
                    end
                end
            end
        end

        if not _G.table.isEmptyOrNil(cardList) then
            go_table.aorbtn_tip:SetActiveE(1)
            go_table.aorbtn_tip.onClick:RemoveAllListeners()
            go_table.aorbtn_tip.onClick:AddListener(_G.handlerbind(self, self.OnClickBtnTip, storageType, cardList,
                itemData))
        end
    elseif storageType == _G.StorageType.Equipment then
        local cardList = {}
        self.InBattleCardList = {}
        self:AddCardUid(self.afkCardIds)
        self:AddCardUid(self.afkOnlyIds)
        self:AddCardUid(self.afkGroupIds1)
        self:AddCardUid(self.afkGroupIds2)
        self:AddCardUid(self.afkGroupIds3)
        self:AddCardUid(self.afkGroupIds4)
        self:AddCardUid(self.afkGroupIds5)
        self:AddCardUid(self.arenaAtkCardIds)
        self:AddCardUid(self.arenaDefCardIds)

        go_table.aorimage_tipsBg:SetActiveE(0)
        go_table.aortext_Name:SetLocalPosition(0, 20, 0)

        -- Log(self.InBattleCardList)

        for i = 1, #self.InBattleCardList do
            ---@type CardData
            local cardData = StorageManager:GetDatasByUid(_G.StorageID.Card, self.InBattleCardList[i])

            if not _G.table.isEmptyOrNil(cardData) then
                ---判断装备类型是否对得上
                if cardData.cfg.EquipmentType == itemData.cfg.professional then
                    ---判断卡牌对应部位是否穿戴了装备(有装备看品质是否大于当前，没装备直接标记角色可用)
                    ---@type EquipmentItem
                    local equip = cardData:GetEquipByPart(itemData.cfg.parts)
                    if equip then
                        if itemData.cfg.grade > equip.cfg.grade then
                            table.insert(cardList, cardData)
                        end
                    else
                        table.insert(cardList, cardData)
                    end
                end
            end
        end

        if not _G.table.isEmptyOrNil(cardList) then
            go_table.aorbtn_tip:SetActiveE(1)
            go_table.aorbtn_tip.onClick:RemoveAllListeners()
            go_table.aorbtn_tip.onClick:AddListener(_G.handlerbind(self, self.OnClickBtnTip, storageType, cardList,
                itemData))
        end
    end
    if not go_table.item then
        for k, v in pairs(data) do
            _G.table.insert(_data, _G.tonumber(v))
        end
        local sid = table.remove(_data, 1)
        local num = table.remove(_data, 1)
        StorageManager:GetItemBaseView(sid, num, go_table.obj_item, function(itemLua)
            go_table.item = itemLua
            if itemLua.ShowNumText then
                itemLua:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
        end, nil, _data)
    else
        _G.GameUtil.SetActiveByCondition(go_table.item.go_table.gameObject, true)
        if go_table.item.mItemCardAllView then
            go_table.item.mItemCardAllView:Show(itemData.sid)
        else
            if go_table.item.ShowData then
                go_table.item:ShowData(itemData)
            elseif go_table.item.UpdateData then
                go_table.item:UpdateData(go_table.item.go_table.transform, itemData)
            end
        end
        go_table.item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
    end

    local sid = itemData.sid
    local icfg = _G.ConfigManager.heroic_icons_cfg[sid]
    if icfg then
        local data = require "HeroicIconModel":GetInstance():GetHeroicIconBySid(sid)
        if data and go_table.obj_has then
            go_table.obj_has:SetActiveE(1)
            go_table.obj_inputdi:SetActiveE(0)
            go_table.aorbtn_Sub:SetActiveE(0)
            go_table.aorbtn_Add:SetActiveE(0)
        end
    end
end

function BoxUseView:SetArtifactItem(go_table, artifactSid, artifact_cfg)
    local showArtifact = require("ArtifactModel"):GetInstance():GetMaxStarArtifactBySid(artifactSid)
    local cfg = _G.ConfigManager.artifact_star_cfg
    if artifact_cfg.card_id and artifact_cfg.card_id > 0 then
        -- 有专属角色
        go_table.obj_progress:SetActiveE(1)
        go_table.aortext_Name:SetActiveE(0)
        if not showArtifact then
            -- 没有穿戴角色
            go_table.obj_jindu:SetActiveE(1)
            go_table.aortext_star:SetActiveE(1)
            go_table.obj_maxStar:SetActiveE(0)
            go_table.aortext_star.text = _G.GetLangPackValue(90000010475, 0)
            go_table.aortext_progress.text = 0 .. "/" .. 0
            go_table.aorimage_activeSchedule:SetLocalScale(0, 1, 1)
        elseif not showArtifact:IsMaxStar() then
            -- 没有满星
            go_table.obj_jindu:SetActiveE(1)
            go_table.aortext_star:SetActiveE(1)
            go_table.obj_maxStar:SetActiveE(0)
            go_table.aortext_star.text = _G.GetLangPackValue(90000010475, showArtifact:GetStar() + 1)
            local count = showArtifact:SameCount()
            local needCount = cfg[100 + showArtifact:GetStar()].materials_oneself
            go_table.aortext_progress.text = count .. "/" .. needCount
            if needCount <= count then
                go_table.aorimage_activeSchedule:SetLocalScale(1, 1, 1)
            else
                go_table.aorimage_activeSchedule:SetLocalScale(count / needCount, 1, 1)
            end
        else
            -- 满星
            go_table.obj_jindu:SetActiveE(0)
            go_table.aortext_star:SetActiveE(0)
            go_table.obj_maxStar:SetActiveE(1)
        end
    else
        -- 没有专属角色
        go_table.obj_progress:SetActiveE(0)
        go_table.aortext_Name:SetActiveE(1)
        go_table.obj_maxStar:SetActiveE(0)
        go_table.aortext_Name.text = _G.LangUtil.GetLangPackValue(artifact_cfg.Name)
    end
end

