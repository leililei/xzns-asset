---界面的入口函数
---@param sid number 道具id
---@param call function 使用成功回调
function RuneItemUseView:OnCreate(itemData, call)
    if itemData == 0 or itemData == nil then
        self:Close()
        return
    end
    self.sid = itemData.sid
    self.call = call
    self.cfg = _G.ConfigManager.item_cfg[self.sid]
    -- self.itemData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, self.sid)
    self.itemData = itemData
    --self.go_table.obj_useCount:SetActiveE(0)
    if self.itemData.Grade > 7 then
        self.go_table.aortext_ItemName:SetActiveE(0)
        self.go_table.aortext_ChromaName:SetActiveE(1)
        self.go_table.aortext_ChromaName.text = self.itemData:GetName()
    else
        self.go_table.aortext_ItemName:SetActiveE(1)
        self.go_table.aortext_ChromaName:SetActiveE(0)
        self.go_table.aortext_ItemName.text = self.itemData:GetName()
        self.go_table.aortext_ItemName.color =
            _G.ColorTools.FormatColorByString(NameColor[self.itemData.Grade] or "FFFFFF")
    end
    self.CurSelect = {}
    self.CurSelectNum = 1
    --self.Index = 1
    self.SelectItems = {}

    self.UseType = self.cfg.UseType or 0
    --self.go_table.aortext_useNum.text = _G.GetLangPackValue(90020200043, self.CurSelectNum, self.itemData.count)
    self.go_table.aortext_haveNum.text = _G.GetLangPackValue(90000010363, self.itemData.count)

    self.go_table.aortext_des.text = self.itemData:GetDescribe()

    self.itemType = 1

    -- if self.cfg.UseType == _G.ItemUseType.GetProp then
    --     self.CurSelectNum = 1
    --     self.go_table.obj_useCount:SetActiveE(1)
    -- elseif self.cfg.UseType == _G.ItemUseType.SelectProp then
    --     self.CurSelectNum = 0
    --     self.go_table.obj_useCount:SetActiveE(0)
    -- end
    ---@param itemLua itemViewNewWithCount
    _G.ItemFactory:GetInstance():GetItemCard(
        _G.ItemFactory.itemType.ItemBaseWithCount,
        self.go_table.obj_item,
        function(itemLua)
            self.go_table.item = itemLua
            itemLua:Show(self.sid)
        end
    )
    self.cardList = _G.StorageManager:GetInstance():GetCardDataSortByTotalDecorationLv(4)
    self.go_table.scrollloopvectical_View:InitItemData(_G.table.count(self.cardList), _G.handler(self, self.RefreshItem))
end

function RuneItemUseView:RefreshItem(index, obj)
    index = index + 1
    local data = self.cardList[index]
    self:SetItem(obj, data, index)
end

---创建可选择的道具
function RuneItemUseView:SetItem(tran, data, i)
    local go_table
    local id = tran:GetInstanceIDE()

    go_table = _G.GetAutoGoTable(tran, _G.handlerbind(self, self.ClickSelectItem, i))
    self.SelectItems[id] = go_table
    -- if not _G.table.isEmptyOrNil(cardList) then
    --     go_table.aorbtn_tip:SetActiveE(1)
    --     go_table.aorbtn_tip.onClick:RemoveAllListeners()
    --     go_table.aorbtn_tip.onClick:AddListener(
    --         _G.handlerbind(self, self.OnClickBtnTip, storageType, cardList, itemData)
    --     )
    -- end
    if not go_table.item then
        StorageManager:GetItemBaseView(
            data.sid,
            1,
            go_table.obj_item,
            function(itemLua)
                go_table.item = itemLua
                itemLua.mItemCardAllView:ShowCardData(data)
            end
        )
    else
        _G.GameUtil.SetActiveByCondition(go_table.item.go_table.gameObject, true)
        if go_table.item.mItemCardAllView then
            go_table.item.mItemCardAllView:ShowCardData(data)
        else
            go_table.item:ShowCardData(data)
        end
    end
    local totalDecorationLv = data:GetTotalDecorationLv()
    go_table.index = i
    go_table.aorbtn_DianJi:SetActiveE(totalDecorationLv ~= 400 and 1 or 0)
    go_table.obj_gray:SetActiveE((totalDecorationLv ~= 400 and self.Index ~= i) and 0 or 1)
    go_table.aorimage_Kuang:SetActiveE((totalDecorationLv ~= 400 and self.Index == i) and 1 or 0)
    if totalDecorationLv >= 400 then 
        go_table.aortext_lv.text = string.format("<color=green>%s</color>", _G.GetLangPackValue(90020600059))
    else 
        go_table.aortext_lv.text = _G.GetLangPackValue(2148006034, math.floor(totalDecorationLv / 4)) 
    end
end

function RuneItemUseView:ClickSelectItem(go, isOn, index, id, sid, param)
    local name = go:GetName()
    if name == "@_aorbtn_DianJi" then
        self.Index = index
        --self.go_table.aortext_useNum.text = _G.GetLangPackValue(90020200043, self.CurSelectNum, self.itemData.count)
        self:KuangXianShi()
    end
end

function RuneItemUseView:OnClickBtnTip(storageType, cardList, itemData)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.CommonTipView.Name,
        _G.TipType.WearCardList,
        storageType,
        cardList,
        itemData
    )
end
---亮框显示
function RuneItemUseView:KuangXianShi()
    for key, value in pairs(self.SelectItems) do
        if value.index == self.Index then
            value.aorimage_Kuang:SetActiveE(1)
            value.obj_gray:SetActiveE(1)
        else
            value.aorimage_Kuang:SetActiveE(0)
            value.obj_gray:SetActiveE(self.cardList[value.index]:GetTotalDecorationLv() >= 400 and 1 or 0)
        end
    end
    -- self.go_table.obj_useCount:SetActiveE(1)
end

---选择完毕确认使用
function RuneItemUseView:Done()
    if not self.Index or self.cardList[self.Index]:GetTotalDecorationLv() >= 400 then
        _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.NotSelect)
        return
    else
        if self.cardList[self.Index]:GetDecorationCount() < 4 then 
            _G.PopWindowManager:GetInstance():ShowAllTips(516) 
            return 
        end 
        local sure = function()
            local item = {}
            item[self.Index] = self.CurSelectNum
            self.lastCardRuneProp = _G.GameUtil.GetPropUpData(self.cardList[self.Index])
            self.lastCardData = self.cardList[self.Index]
            self.lastRuneAttData = self.cardList[self.Index]:GetDecorationProp()
            _G.StorageManager:GetInstance():UsePropToServer(
                self.sid,
                self.CurSelectNum,
                function(data)
                    if self.call then
                        self.call()
                    end
                    self:Close()
                    _G.DelayDo(0.3, function()
                        self.cardList[self.Index]:MaxDecorationLv()
                        self:ShowPropUpEffect()
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RuneDecorationUpView.Name, self.cardList[self.Index], self.lastRuneAttData, function()
                            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
                        end)
                    end)
                end,
                nil,
                self.cardList[self.Index].uid,
                true
            )
        end
        local langSid = _G.ConfigManager.tips_system_cfg[515].content
        _G.PopWindowManager:GetInstance():ShowAllTips(515, _G.GetLangPackValue(langSid, _G.GetLangPackValue(self.cardList[self.Index].cfg.Name)), sure)
    end
end

---属性变化飘字
function RuneItemUseView:ShowPropUpEffect()
    if self.lastCardRuneProp and self.lastCardData.uid == self.cardList[self.Index].uid then
        _G.Events:GetInstance():Broadcast(_G.eCardShow.CardChangeProp, self.lastCardRuneProp)
    end
    self.lastCardRuneProp = _G.GameUtil.GetPropUpData(self.cardList[self.Index])
    self.lastCardData = self.cardList[self.Index]
end

function RuneItemUseView:PropShow(LastCardData, call)
    ---@type Params_View_PropUp
    local Params_View_PropUp = {}
    Params_View_PropUp.Posx = 0
    _G.UIUtils.ShowPropUp(self.cardList[self.Index], LastCardData, call, Params_View_PropUp)
end

---按钮点击事件在这里派发
function RuneItemUseView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_close" then
        self:Close()
    elseif name == "@_aorbtn_Done" then
        self:Done()
    end
end

---销毁对象时,析构函数
function RuneItemUseView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eCardShow.CardChangeProp, self.PropShow, self)
end

return RuneItemUseView
