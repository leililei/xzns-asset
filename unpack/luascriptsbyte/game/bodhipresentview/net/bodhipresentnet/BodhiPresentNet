---@class BodhiPresentNet : BaseGameNet
---@field GetInstance fun():BodhiPresentNet
local BodhiPresentNet = _G.BaseClass("BodhiPresentNet", require "BaseGameNet")
local base = require "BaseGameNet"
---@return BodhiPresentNet BodhiPresentNet

function BodhiPresentNet:GetInstance()
    return base.GetInstance(self)
end

---请求 获取奖励信息
---@param callback function 完成回调
---@field s2c_weekend_turntable_info 返回的信息数组
function BodhiPresentNet:BodhiAwards(callback)
    local item = _G.ConfigManager.net_map.game_weekend_turntable_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.SuccessCall))
    self.Call[port] = callback
end

---请求 抽取奖励
---@param callback function 完成回调
---@field s2c_weekend_turntable_draw 返回的信息数组
function BodhiPresentNet:DrawBodhiAwards(callback)
    local item = _G.ConfigManager.net_map.game_weekend_turntable_draw
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.SuccessCall))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function BodhiPresentNet:SuccessCall(port, data, error)
    if error then
        return
    end
    --TODO 写通用数据解析，没有需要做的记得删除TODO
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return BodhiPresentNet
