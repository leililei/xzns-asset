---@class BodhiPresentViw BaseClass 菩提馈赠
---@field public go_table BodhiPresentViw_GoTable GoTable
local BodhiPresentViw = _G.BaseClass("BodhiPresentViw", _G.UIBaseView)
local BodhiPresentModel
function BodhiPresentViw:Awake()
    BodhiPresentModel = require "BodhiPresentModel"
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    --已经获取的奖励列表
    self.GetList = {}
    --当前剩余的时间
    self.TimeLast = 0
    --当前获得的奖励的id
    self.CurAwardID = 0
    --当前周的奖励轮换id
    self.TableId = 0
    --离散数据奖励id集合
    self.TableList = {}
    --奖励列表
    self.AwardList = {}
    --当前活跃度
    self.Liveness = 0
    --红点刷新
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.WeekendTurntableButton.id)
    --背景特效生成
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_yinghuochong, self.go_table.obj_EfBg)
end

---界面入口
function BodhiPresentViw:OnCreate()
    self:InitView()
end

---析构函数
function BodhiPresentViw:Dispose()
end

---初始化界面
function BodhiPresentViw:InitView()
    BodhiPresentModel:GetInstance():BodhiAwardsInfo(
        function(data)
            self.GetList = BodhiPresentModel:GetInstance().GetList
            local tableLen = #_G.ConfigManager.discrete_cfg[106602]
            self.Liveness = data.pray_num
            self.TableId = BodhiPresentModel:GetInstance().TableId % tableLen + 1
            --当前祈愿次数
            local needPray = _G.ConfigManager.discrete_cfg[106601][1][1]
            self.WishNum = math.floor((self.Liveness / needPray))
            if(self.GetList ~= nil)then
                local mcount = 7 - #self.GetList -- 策划现在不配叫我写死为7
                self.WishNum = math.min(mcount,self.WishNum)
            else
                self.WishNum = math.min(7,self.WishNum)
            end
            if self.WishNum ~= 0 then
                self.go_table.aorbtn_Wish:SetActiveE(1)
                self.go_table.aorbtn_Go:SetActiveE(0)
            else
                self.go_table.aorbtn_Wish:SetActiveE(0)
                self.go_table.aorbtn_Go:SetActiveE(1)
            end
            self.go_table.aortext_Cost.text = _G.ConfigManager.discrete_cfg[106601][1][1]
            self.go_table.aortext_Curcount.text = _G.GetLangPackValue(90026400003, self.WishNum)
            --self.go_table.aortext_Curvalue.text = _G.GetLangPackValue(90026400005, self.Liveness)
            self.TableList = _G.ConfigManager.discrete_cfg[106602][self.TableId]
            for i = 1, 7 do
                _G.table.insert(self.AwardList, _G.ConfigManager.weekend_turntable_cfg[self.TableList[i]].item)
            end
            self:RemainTime()
            self:CreatItem()
            --self:BubbleShow(self.Liveness)
        end
    )
end

---水泡特效显示处理
---@param num number 当前活跃度
function BodhiPresentViw:BubbleShow(num)
    --特效生成
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_qiyuanzhi, self.go_table.obj_EfBubble)
    --水泡y轴固定长度，x决定特效缩放，y轴决定特效位置
    local bubbleLenY = 80
    local curPary = num
    local needPray = _G.ConfigManager.discrete_cfg[106601][1][1]
    if curPary >= needPray then
        self.go_table.aorimage_Fill.fillAmount = 1
        self.go_table.obj_EfBubble:SetLocalScaleXYZ(0)
    elseif curPary == 0 then
        self.go_table.aorimage_Fill.fillAmount = 0
        self.go_table.obj_EfBubble:SetLocalScaleXYZ(0)
    else
        --圆形形状，位置计算进行了手动校准
        local _, fillValue = math.modf(curPary / needPray)
        self.go_table.aorimage_Fill.fillAmount = fillValue
        local efLocation = bubbleLenY * (fillValue + 0.09)
        self.go_table.obj_EfBubble:SetLocalPosition(-1, efLocation, 0)
        --根据活跃度缩放特效
        if fillValue < 0.4 then
            local _, correctValue = math.modf(fillValue / 0.4)
            self.go_table.obj_EfBubble:SetLocalScaleXYZ(correctValue + 0.2)
        elseif fillValue > 0.6 then
            local _, correctValue = math.modf((1 - fillValue) / 0.4)
            self.go_table.obj_EfBubble:SetLocalScaleXYZ(correctValue + 0.2)
        end
    end
end

---奖励物品生成
function BodhiPresentViw:CreatItem()
    local name = "obj_award"
    for i = 1, 7 do
        local item = self.go_table[name .. i]
        local tb = _G.GetAutoGoTable(item, _G.handlerbind(self, i))
        local iconImage = _G.StorageManager:GetItemIcon(self.AwardList[i][1])
        tb.aorrawimage_Item:LoadImage(
            iconImage,
            function(tran)
                tran:SetNativeSize()
            end
        )
        tb.aortext_Num.text = self.AwardList[i][2]
        if i == 4 then
            _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_paomogaoji, tb.obj_EfFrame)
        else
            _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_paomoputong, tb.obj_EfFrame)
        end
    end
    if self.GetList ~= nil then
        for i = 1, #self.GetList do
            local locationID = self.GetList[i] % 100
            local itemG = self.go_table[name .. locationID]
            local tbG = _G.GetAutoGoTable(itemG, _G.handlerbind(self, locationID))
            tbG.obj_gou:SetActiveE(1)
        end
        if #self.GetList == 7 then
            self.go_table.aorbtn_Wish:SetActiveE(1)
            self.go_table.aorbtn_Go:SetActiveE(0)
            self.go_table.aorbtn_Wish:SetGray(true)
            self.go_table.aortext_wish.color = _G.Color.New(41 / 255, 41 / 255, 41 / 255, 1)
            self.Liveness = 0
            --self.go_table.aortext_Curvalue.text = _G.GetLangPackValue(90026400005, self.Liveness)
            self.go_table.aortext_Curcount.text = _G.GetLangPackValue(90026400003, 0)
        end
    end
end

---活动剩余时间统计
function BodhiPresentViw:RemainTime()
    local curTime = _G.TimeUtil.GetServerUnixTime()
    local curTimeTb = _G.TimeUtil.GetDateTime(curTime)
    local timeDuration = _G.ConfigManager.system_cfg[210].time_duration
    local needTimeTb = _G.ConfigManager.system_cfg[210].time_open
    local neddWeedk = needTimeTb[1][1]
    local needHour = needTimeTb[1][2]
    local needMinute = needTimeTb[1][3]
    local needSec = needTimeTb[1][4]
    if curTimeTb.week == 0 then
        curTimeTb.week = 7
    end
    if curTimeTb.week < needTimeTb[1][1] then
        curTimeTb.week = curTimeTb.week + 7
    end
    self.TimeLast =
        timeDuration - (curTimeTb.week - neddWeedk) * 86400 - (curTimeTb.hour - needHour) * 3600 -
        (curTimeTb.minute - needMinute) * 60 -
        (curTimeTb.second - needSec)
    local RemainTimeTb = _G.TimeUtil.TranslateSecond(self.TimeLast)
    if RemainTimeTb.day ~= 0 then
        self.go_table.aortext_Timedown.text = _G.GetLangPackValue(90026400004, RemainTimeTb.day, RemainTimeTb.hour)
    elseif RemainTimeTb.hour ~= 0 then
        self.go_table.aortext_Timedown.text = _G.GetLangPackValue(90026400006, RemainTimeTb.hour, RemainTimeTb.min)
    elseif RemainTimeTb.min ~= 0 then
        self.go_table.aortext_Timedown.text = _G.GetLangPackValue(90026400007, RemainTimeTb.min)
    else
        self.go_table.aortext_Timedown.text = _G.GetLangPackValue(90026400007, 1)
    end
end

---抽奖后更新
function BodhiPresentViw:UpdateList()
    local reduce = _G.ConfigManager.discrete_cfg[106601][1][1]
    self.Liveness = self.Liveness - reduce
    self.WishNum = self.WishNum - 1
    --self.go_table.aortext_Curvalue.text = _G.GetLangPackValue(90026400005, self.Liveness)
    self.go_table.aortext_Curcount.text = _G.GetLangPackValue(90026400003, self.WishNum)
    --根据配置奖励ID更改
    local curAwardID = BodhiPresentModel:GetInstance().CurAwardID
    self.CurAwardID = curAwardID % 100
    local name = "obj_award"
    local item = self.go_table[name .. self.CurAwardID]
    local tb = _G.GetAutoGoTable(item, _G.handlerbind(self))
    tb.obj_gou:SetActiveE(1)
    --添加入已经得到的奖励表
    self.GetList = BodhiPresentModel:GetInstance().GetList
    if self.WishNum ~= 0 then
        self.go_table.aorbtn_Wish:SetActiveE(1)
        self.go_table.aorbtn_Go:SetActiveE(0)
    else
        self.go_table.aorbtn_Wish:SetActiveE(0)
        self.go_table.aorbtn_Go:SetActiveE(1)
    end
    if self.GetList ~= nil and #self.GetList == 7 then
        self.go_table.aorbtn_Wish:SetActiveE(1)
        self.go_table.aorbtn_Go:SetActiveE(0)
        self.go_table.aorbtn_Wish:SetGray(true)
        self.go_table.aortext_wish.color = _G.Color.New(41 / 255, 41 / 255, 41 / 255, 1)
        self.Liveness = 0
        self.go_table.aortext_Curcount.text = _G.GetLangPackValue(90026400003, 0)
    --self.go_table.aortext_Curvalue.text = _G.GetLangPackValue(90026400005, self.Liveness)
    end
    --水泡填充特效更新
    --self:BubbleShow(self.Liveness)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.WeekendTurntableButton.id)
end

---抽取奖励
function BodhiPresentViw:Draw()
    BodhiPresentModel:GetInstance():GetBodhiAward(
        function(data)
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
            self:UpdateList()
        end
    )
end

---点击事件在此触发
function BodhiPresentViw:OnClickBtn(go)
    if nil == go then
        return
    end
    local name = go:GetName()
    if "@_aorbtn_Wish" == name then
        self:Draw()
    end
    if "@_aorbtn_Close" == name then
        self:Close()
        local flag = BodhiPresentModel:GetInstance().IsOpenTime()
        if flag == false then
            _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.BodhiPresent)
        end
    end
    if "@_aorbtn_Way" == name then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 46)
    end
    if "@_aorbtn_Go" == name then
        _G.JumpManager:GetInstance():Jump(104001)
    end
    if "@_aorbtn_tip1" == name then
        require("CommonTipManager"):GetInstance():OpenTip(self.go_table.aorbtn_tip1.gameObject, self.AwardList[1][1])
    end
    if "@_aorbtn_tip2" == name then
