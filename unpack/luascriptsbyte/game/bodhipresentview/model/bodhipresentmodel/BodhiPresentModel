local base = require "GameDataModelBase"
---@class BodhiPresentModel : GameDataModelBase
---@field GetInstance fun():BodhiPresentModel
local BodhiPresentModel = _G.BaseClass("BodhiPresentModel", base)
---@return BodhiPresentModel BodhiPresentModel
local BodhiPresentNet = require "BodhiPresentNet"

---@return BodhiPresentModel BodhiPresentModel
function BodhiPresentModel:GetInstance()
    return self.super.GetInstance(self)
end

function BodhiPresentModel:__init()
    --已抽取的奖励列表
    self.GetList = {}
    --当前轮换奖励列表id
    self.TableId = 0
    --当前拥有的祈愿值
    self.PrayNumb = 0
    --当前抽中的奖励id
    self.CurAwardID = 0
    --红点状态
    self.IsOpen = false
    --功能开启id
    self.curFunctionOpenID = 103
end

function BodhiPresentModel:Dispose()
end

function BodhiPresentModel:GetDataFormServer()
    if BodhiPresentModel.IsOpenTime() then
        BodhiPresentNet:GetInstance():BodhiAwards(_G.handler(self, self.GetInfo))
    else
        _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.BodhiPresent)
        self:ParseData()
    end
end

function BodhiPresentModel:GetInfo(data)
    self.PrayNumb = data.pray_num
    self.GetList = data.get_list
    self.TableId = data.week
    self:ParseData()
    _G.FunctionManager:GetInstance():OpenFunById(_G.MainFunctionItems.BodhiPresent)
end

---获取奖励信息
function BodhiPresentModel:BodhiAwardsInfo(callback)
    BodhiPresentNet:GetInstance():BodhiAwards(
        function(data)
            self.PrayNumb = data.pray_num
            self.GetList = data.get_list
            self.TableId = data.week
            if callback then
                callback(data)
            end
        end
    )
end

---抽取奖励
function BodhiPresentModel:GetBodhiAward(callback)
    BodhiPresentNet:GetInstance():DrawBodhiAwards(
        function(data)
            if 1 == data.ack then
                local reducePray = _G.ConfigManager.discrete_cfg[106601][1][1]
                self.CurAwardID = data.id
                self.PrayNumb = self.PrayNumb - reducePray
                if self.GetList ~= nil then
                    _G.table.insert(self.GetList, {data.id})
                else
                    self.GetList = {data.id}
                end
                if callback then
                    callback(data)
                end
            end
        end
    )
end

---region 对外接口 （main_function,检测函数）
---是否显示.false是关闭,true是显示
function BodhiPresentModel.IsOpenTime()
    if
        _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(BodhiPresentModel:GetInstance().curFunctionOpenID) and
            BodhiPresentModel:GetInstance():CheckTime()
     then
        return true
    else
        return false
    end
end

---是否处于开放时间
---@return boolean
function BodhiPresentModel:CheckTime()
    local curTime = _G.TimeUtil.GetServerUnixTime()
    local curTimeTb = _G.TimeUtil.GetDateTime(curTime)
    local needTimeTb = _G.ConfigManager.system_cfg[210].time_open
    local needWeek = needTimeTb[1][1]
    local needHour = needTimeTb[1][2]
    local timeDuration = _G.ConfigManager.system_cfg[210].time_duration
    local endTimeTb = _G.TimeUtil.TranslateSecond(timeDuration)
    local endDay = endTimeTb.day
    endTimeTb.day = endDay + needWeek
    --周日0改为7
    if endTimeTb.day < 2 then
        endTimeTb.day = endTimeTb.day + 7
    elseif endTimeTb.day > 7 then
        endTimeTb.day = endTimeTb.day - 7
    end

    if curTimeTb.week < 2 then
        curTimeTb.week = 7 + curTimeTb.week
    end
    --周五开启
    if curTimeTb.week == needWeek then
        if curTimeTb.hour >= needHour then
            return true
        else
            return false
        end
    end
    --周六周日
    if curTimeTb.week > needWeek and (curTimeTb.week - needWeek) <= endDay then
        return true
    end
    --周一关闭
    if curTimeTb.week == endTimeTb.day then
        if curTimeTb.hour < needHour then
            return true
        else
            return false
        end
    end
    return false
end

---检测红点
---@return boolean
function BodhiPresentModel:CheckRedPoint()
    local needPray = _G.ConfigManager.discrete_cfg[106601][1][1]
    if self.GetList ~= nil then
        self.GetNum = #self.GetList
    else
        self.GetNum = 0
    end
    if self.PrayNumb >= needPray and self.GetNum ~= 7 then
        return not self.IsOpen
    else
        return self.IsOpen
    end
end

return BodhiPresentModel
