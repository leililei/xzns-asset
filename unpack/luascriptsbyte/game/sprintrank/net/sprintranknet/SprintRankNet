---@class SprintRankNet : BaseGameNet	通信协议
local SprintRankNet = _G.BaseClass("SprintRankNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return SprintRankNet SprintRankNet
function SprintRankNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---获取排行榜数据
---@param callback function 完成回调
function SprintRankNet:GetRank(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activiti_rank
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function SprintRankNet:CallBack(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return SprintRankNet
