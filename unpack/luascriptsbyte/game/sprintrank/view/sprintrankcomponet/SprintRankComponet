---刷新item
---@param index number
---@param go UnityEngine.GameObject
function SprintRankComponet:RefreshItem(index, go)
    if not self.listItems then
        self.listItems = {}
    end
    ---@type _obj_Rank._obj_listItem_GoTable
    local item = self.listItems[go:GetInstanceIDE()]
    if not item then
        ---@type _obj_Rank._obj_listItem_GoTable
        item = _G.GetAutoGoTable(go)
        _G.AddViewBtnClick(go, _G.handlerbind(self, self.OnItemClickBtn, item))
        self.listItems[go:GetInstanceIDE()] = item
    end

    local rank = index + 4
    local data = self.ranks[rank]
    item.data = data
    self:UpdateItem(rank, item, data)
end

---设定item显示状态
---@param rank number   排名
---@param item _obj_Rank._obj_listItem_GoTable|SprintRankComponet._obj_selfRank_GoTable
---@param data rank.i_role_pub
function SprintRankComponet:UpdateItem(rank, item, data, isself)
    if not isself then
        item.aorimage_Bg.SpriteName = RankBg[rank] or RankBg[#RankBg]
    end

    if self.curSelectTag == SprintRankUtils.TagType.Personal then
        item.obj_RoleNode:SetActiveE(1)
        item.obj_LegionItem:SetActiveE(0)
        if item.obj_rank then
            --自己的排名信息
            item.obj_rank:SetActiveE(rank >= 1 and 1 or 0)
            item.aortext_noRank:SetActiveE(rank < 1 and 1 or 0)
            if rank >= 1 then
                item.aortext_rank.text = tostring(rank)
            end
        else
            --列表排名信息
            local rankIcon = RankIcon[rank]
            item.aorimage_rank:SetActiveE(rankIcon and 1 or 0)
            item.aortext_rank2:SetActiveE(rankIcon and 0 or 1)
            if rankIcon then
                item.aorimage_rank.SpriteName = rankIcon
                item.aortext_rank.text = tostring(rank)
            else
                item.aortext_rank2.text = tostring(rank)
            end
        end
        if item.aortext_no then
            item.aortext_no:SetActiveE(data and 0 or 1)
        end

        --头像丶名称信息
        item.aortext_name.text = data and data.role_info.name or ""
        if data then
            _G.UIUtils.SetPlayerHeadItemNew(item.obj_HeadItemBase, data.role_info, 0.7, true, true, true)
            local headGoTable = item.headGoTable
            if not headGoTable then
                headGoTable = _G.GetAutoGoTable(item.obj_HeadItemBase)
                item.headGoTable = headGoTable
            end
            headGoTable.obj_titleEffect:SetActiveE(1)
        else
            ---@type _obj_listItem._obj_HeadItemBase_GoTable
            local headGoTable = item.headGoTable
            if not headGoTable then
                headGoTable = _G.GetAutoGoTable(item.obj_HeadItemBase)
                item.headGoTable = headGoTable
            end
            --headGoTable.aorimage_iconBg.SpriteName = "ui_zjm_touxiang_frame"
            headGoTable.aorimage_portrait.SpriteName = "0ui_jsxt_sx_icon5"
            headGoTable.aorrawimage_frame:SetActiveE(0)
            headGoTable.aorimage_levelBg:SetActiveE(0)
            headGoTable.obj_lvNode:SetActiveE(0)
            headGoTable.obj_frameEffect:RemoveAllChildren()
            headGoTable.obj_titleEffect:SetActiveE(0)
        end
        --分数丶伤害数据信息
        self:ShowScore(item,data and data.value[1] or 0)
    else
        item.obj_RoleNode:SetActiveE(0)
        item.obj_LegionItem:SetActiveE(1)
        ---@type _obj_listItem._obj_LegionItem_GoTable
        local LegionItem = _G.GetAutoGoTable(item.obj_LegionItem)

        LegionItem.aortext_rank.text =  rank
        if data and data.guild_info then
            LegionItem.obj_iconbg:SetActiveE(1)
            --LegionItem.aortext_rank:SetActiveE(1)
            LegionItem.aortext_no:SetActiveE(0)
            LegionItem.aortext_name:SetActiveE(1)
            LegionItem.aortext_score:SetActiveE(1)
            LegionItem.aortext_serverName:SetActiveE(1)
            LegionItem.aorrawimage_leginIcon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.guild_info.banner].portrait)
            LegionItem.aortext_name.text =  data and data.guild_info.name or ""
            LegionItem.aortext_serverName.text =  _G.ServerManager:GetInstance():GetServerNameByServerID( data.guild_info.server_id)
            self:ShowScore(LegionItem,data and data.value[1] or 0)
            SprintRankUtils.SetRankNode2(LegionItem,rank)
            LegionItem.aortext_rank2:SetActiveE(0)
        else
            LegionItem.obj_iconbg:SetActiveE(0)
            --LegionItem.aortext_rank:SetActiveE(0)
            LegionItem.aortext_rank.text = rank
            LegionItem.aortext_no:SetActiveE(1)
            LegionItem.aortext_name:SetActiveE(0)
            LegionItem.aortext_score:SetActiveE(0)
            LegionItem.aortext_serverName:SetActiveE(0)
            LegionItem.aorimage_rank:SetActiveE(0)
            LegionItem.aortext_rank2:SetActiveE(0)
        end
    end
end

