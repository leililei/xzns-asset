function SprintRankComponet:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_notes then
        if self.curSelectTag == SprintRankUtils.TagType.Personal then
            self.go_table.aortext_tipDes.text = GetLangPackValue(90120200118)
            self.go_table.obj_tipNode:SetActiveE(1)
        else
            self.go_table.aortext_tipDes.text = GetLangPackValue(90120200119)
            self.go_table.obj_tipNode:SetActiveE(1)
        end
    elseif go == self.go_table.aorbtn_activitytipclose then
        self.go_table.obj_tipNode:SetActiveE(0)
    end
end

