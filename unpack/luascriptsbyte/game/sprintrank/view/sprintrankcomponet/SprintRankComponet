---@class SprintRankComponet : Component	中文描述
---@field public go_table SprintRankView._obj_Rank_GoTable GoTable
---@field listItems  排行榜列表节点
---@field ranks      rank.i_role_pub[] 排行榜数据
---@field selfRank   自己的数据
---@field topRanks   前三玩家的数据
---@field topItems SprintRankView._obj_info1_GoTable[]       前三玩家的节点
local SprintRankComponet = _G.BaseClass("SprintRankComponet", _G.Component)
local SprintRankUtils = require("SprintRankUtils")

function SprintRankComponet:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    ---@type SprintRankUtils.TagType
    self.curSelectTag = SprintRankUtils.TagType.Personal

    ---@type table<SprintRankUtils.TagType,_obj_Rank._obj_ListItem1_GoTable>
    self.tagItem = {}
    self.tagItem[SprintRankUtils.TagType.Personal] = GetAutoGoTable(self.go_table.obj_ListItem1,handlerbind(self,self.SetTag,SprintRankUtils.TagType.Personal))
    self.tagItem[SprintRankUtils.TagType.Alliance] = GetAutoGoTable(self.go_table.obj_ListItem2,handlerbind(self,self.SetTag,SprintRankUtils.TagType.Alliance))

    ---@type table<SprintRankUtils.TagType,rank.s2c_rank_pub_info>
    self.ShowData = {}

    if not self.topItems then
        ---@type _obj_Rank._obj_info1_GoTable[]
        self.topItems = {}
        for i = 1, TOP_PLAYER_COUNT do
            self.topItems[i] = _G.GetAutoGoTable(self.go_table["obj_info" .. i])
            self.topItems[i].rank = i
        end
    end
end

function SprintRankComponet:SetTag(go,ison,tag)
    self.curSelectTag = tag
    self:RefreshTag()
    if self.ShowData[self.curSelectTag] == nil then
        local msg = {}
        msg.page = 1
        local curActivityClass = self.activity.curActivityClass
        local data = require("ActivitySynManager"):GetInstance():GetChildAcitivity(curActivityClass.cfg.info.type, curActivityClass:GetJumpType(),self.curSelectTag)
        msg.id = data.activityID
        require("SprintRankNet"):GetInstance():GetRank(msg,function(data)
            self.ShowData[self.curSelectTag] = data
            self:UpdateView(self.ShowData[self.curSelectTag],self.activity)
        end)
    else
        self:UpdateView(self.ShowData[self.curSelectTag],self.activity)
    end
end

function SprintRankComponet:RefreshTag()
    for i, v in pairs(self.tagItem) do
        if i == self.curSelectTag then
            v.obj_Select:SetActiveE(1)
        else
            v.obj_Select:SetActiveE(0)
        end
    end
end

---界面的入口函数
function SprintRankComponet:OnCreate()
end

function SprintRankComponet:OnDisable()
    self.curSelectTag = SprintRankUtils.TagType.Personal
end

function SprintRankComponet:UpdateView(data,activity)
    self.ShowData[self.curSelectTag] = data
    ---@type SprintRankSynModel
    self.activity = activity
    self.ranks = self.ShowData[self.curSelectTag].ranks or {}

    self.selfRank = nil
    if self.curSelectTag == SprintRankUtils.TagType.Personal then
        for i = 1,#self.ranks do
            if self.ranks[i].role_info.uid == _G.PlayerModel:GetInstance().role_uid then
                self.selfRank = self.ranks[i]
                self.selfRankNum = i
                break
            end
        end
    else
        local IsAddLegion,uid = SprintRankUtils.GetIsAddLegion()
        if IsAddLegion then
            for i = 1,#self.ranks do
                if self.ranks[i].guild_info and self.ranks[i].guild_info.uid == uid then
                    self.selfRank = self.ranks[i]
                    self.selfRankNum = i
                    break
                end
            end
        end
    end

    self:UpdateSelfRank()
    self:InitTopRanks()

    local count = #self.ranks
    if count <= 10 then
        count = 10
    else
        count = count - 3
    end
    self.go_table.scrollloopvectical_list:InitItemData(count, _G.handler(self, self.RefreshItem))

    --if #self.ranks > 0 then
    --    self.go_table.obj_no:SetActiveE(0)
    --else
    --    self.go_table.obj_no:SetActiveE(1)
    --end

    self.go_table.obj_roleTipBg:SetActiveE(self.curSelectTag == SprintRankUtils.TagType.Personal and 1 or 0)
    self.go_table.obj_legionTipBg:SetActiveE(self.curSelectTag == SprintRankUtils.TagType.Alliance and 1 or 0)
    self:RefreshTag()
end

---更新自己的排名信息
---@return void
function SprintRankComponet:UpdateSelfRank()
    self.go_table.obj_selfRank:SetActiveE(1)
    self.go_table.scrollloopvectical_list:UpdateScrollRectHeight(true) --更新滑动列表大小

    ---@type _obj_Rank._obj_selfRank_GoTable
    local item = _G.GetAutoGoTable(self.go_table.obj_selfRank)
    item.aortext_score.text = ""
    item.aortext_rank.text = ""
    if self.curSelectTag == SprintRankUtils.TagType.Personal then
        item.aortext_label.text = GetLangPackValue(90022500482)
    else
        if SprintRankUtils.GetIsAddLegion() then
            item.aortext_label.text = GetLangPackValue(90120200096)
        else
            item.aortext_label.text = GetLangPackValue(90027300040)
        end
        item.aortext_rank.text = GetLangPackValue(90120200138)
        item.aortext_score.text = ""
    end
    if self.selfRank then
        --self:UpdateItem(
        --    self.selfRankNum,
        --    item,
        --    self.selfRank, true
        --)
        self:ShowScore(item,self.selfRank.value[1] or 0)
        item.aortext_rank.text = self.selfRankNum
        item.aortext_noRank.text = ""
    else
        if self.curSelectTag == SprintRankUtils.TagType.Personal then
            item.aortext_rank.text = GetLangPackValue(90120200138)
            item.aortext_score.text = GetLangPackValue(90022100272,self.activity.data.role_p)
        else
            if SprintRankUtils.GetIsAddLegion() then
                item.aortext_rank.text = GetLangPackValue(90120200138)
                item.aortext_score.text = GetLangPackValue(90022100272,self.activity.data.guild_p)
            else
                item.aortext_rank.text = ""
                item.aortext_score.text = ""
            end
        end
        item.aortext_noRank.text = _G.GetLangPackValue(90026500029)
    end
end

--region =============================前三玩家加载逻辑=============================


---初始化前三玩家数据
---@return void
function SprintRankComponet:InitTopRanks()
    self.topRanks = {}
    for i = 1, TOP_PLAYER_COUNT do
        if self.ranks[i] then
            table.insert(self.topRanks, { data = self.ranks[i] })
            _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.CommonRankDefaultItem .. i,
                _G.GetAutoGoTable(self.go_table["obj_info" .. i]))
        else
            break
        end
    end
    self:GetTopRankInfos()
end

---获取前三玩家角色形象信息(全部完成后执行模型加载逻辑)
---@return void
function SprintRankComponet:GetTopRankInfos()
    if not self.topRanks or nil == self.go_table then
        return
    end

    local isPersonal = false
    if self.curSelectTag == SprintRankUtils.TagType.Personal then
        isPersonal = true
    end
    for i = 1, TOP_PLAYER_COUNT do
        local gotable = self.topItems[i]
        gotable.obj_RoleNode:SetActiveE(isPersonal and 1 or 0)
        gotable.obj_Legion:SetActiveE(isPersonal and 0 or 1)
    end

    local topRanks = self.topRanks
    if self.curSelectTag == SprintRankUtils.TagType.Personal then
        for i = 1, TOP_PLAYER_COUNT do
            local topRank = topRanks[i]
            if topRank and topRank.data and not topRank.role then
                require("SystemSettingNet"):GetInstance():GetPlayerInfo(
                        { uid = topRank.data.role_info.uid },
                        function(msg)
                            if topRanks ~= self.topRanks then
                                --加载逻辑已被中断
                                return
                            end
                            if not msg.info then
                                return
                            end
                            topRank.role = msg.info
                            self:GetTopRankInfos() --拉取下一个玩家的信息
                        end
                )
                return
            end
        end
        --所有角色数据已加载完毕
        self:ClearAllRoleModel()
        self:UpdateAllRoleModel()
        self:UpdateTopRankInfos()
    else
        for i = 1, TOP_PLAYER_COUNT do
            ---@type _obj_info1._obj_Legion_GoTable
            local item = GetAutoGoTable(self.topItems[i].obj_Legion)
            if self.topRanks[i] and self.topRanks[i].data and self.topRanks[i].data.guild_info then
                ---@type guild.i_guild
                local data = self.topRanks[i].data.guild_info
                local banner = data.banner
                item.aorrawimage_leginIcon:SetActiveE(1)
                item.aorrawimage_leginIcon:LoadImage(_G.ConfigManager.guild_portrait_cfg[banner].portrait)
                item.aortext_name.text = data.name
                item.aortext_serverName.text = _G.ServerManager:GetInstance():GetServerNameByServerID(data.server_id)
                item.aortext_score.text = self.topRanks[i].data.value[1] or 0
            else
                item.aorrawimage_leginIcon:SetActiveE(0)
                item.aortext_name.text = ""
                item.aortext_serverName.text = ""
                item.aortext_score.text = ""
            end
        end
    end
end

function SprintRankComponet:ClearAllRoleModel()
    for i = 1, TOP_PLAYER_COUNT do
        --回收角色模型
        ---@type SprintRankComponet._obj_info1_GoTable
        local temp = _G.GetAutoGoTable(self.go_table["obj_info" .. i])
        local tempCount = temp.trans_role:GetChildCountE()
        if tempCount > 0 then
            _G.PoolsManager:GetInstance():Despawn(temp.trans_role:GetChildE(0), _G.ePoolType.Temporary)
        end
    end
end

---刷新所有角色
function SprintRankComponet:UpdateAllRoleModel()
    if not self.roleTrans then
        self.roleTrans = {}
    end
    for i = 1, TOP_PLAYER_COUNT do
        local data = self.topRanks[i]
        if data and data.role then
            local cfg = require "CardCommentManager":GetInstance():CardData(data.role.city_style_id, false)
            local path = _G.UIUtils.GetBattleSpine(cfg, _G.UseBattleSpine.RankView)
            self:LoadRoleModel(path, i, cfg.size4,cfg,data)
            self:UpdateTop3Title(i, data.role.title)
        end
    end
end

---加载单个角色
---@param view table 视图
---@param rolepath string 模型路径
---@param posType number 摆放的位置
function SprintRankComponet:LoadRoleModel(rolepath, posIndex, scale,cfg,data)
    ---@type SprintRankComponet._obj_info1_GoTable
    local info = _G.GetAutoGoTable(self.go_table["obj_info" .. posIndex])

    _G.PoolsManager:GetInstance():Spawn(
        rolepath,
        _G.ePoolType.Temporary,
        nil,
        function(trans)
            if trans == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("角色无法加载 path:" .. rolepath)
                end
                return
            end
            if nil == self.go_table then
                _G.DestroyObject(trans)
                return
            end
            trans:SetParentE(info.trans_role)
            trans:SetLocalPosition(0, 0, 0)
            trans:SetLocalScaleXYZ(scale)
            self.roleTrans[posIndex] = trans
            SprintRankUtils.LoadOtherRoleInfo(trans,data.role)
        end
    )
end

---生成称号
---@param item table
function SprintRankComponet:UpdateTop3Title(index, data)
    if data.sid == 0 then
        return
    end
    local tb = _G.GetAutoGoTable(self.go_table["obj_info" .. index])
    if self.curShowEffTitle == nil then
        self.curShowEffTitle = {}
    end
    local titleScale = _G.ConfigManager.discrete_cfg[100111] and _G.ConfigManager.discrete_cfg[100111][1][1] or 1
    local player_title = _G.ConfigManager.player_title_effect_cfg[data.sid]
    if player_title.type_title == 1 then
        tb.aorrawimage_title:LoadImage(player_title.title)
        tb.aorrawimage_title:SetActiveE(1)
        tb.aorrawimage_title:SetLocalScaleXYZ(0.29 * titleScale)
        tb.obj_titleEffect:RemoveAllChildren()
        self.curShowEffTitle[index] = nil
    elseif player_title.type_title == 2 then
        if self.curShowEffTitle[index] == nil or (self.curShowEffTitle[index] ~= nil and self.curShowEffTitle[index] ~= player_title.title) then
            tb.obj_titleEffect:RemoveAllChildren()
            self.curShowEffTitle[index] = player_title.title
            _G.UIUtils.LoadEffectTitleOrFrame(
                player_title.title,
                tb.obj_titleEffect,
                function(trans)
                    if self.curShowEffTitle[index] ~= player_title.title then
                        trans:DestroyObject()
                        return
                    end
                    local parClip = trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                    parClip.NeedCheck = true
                    parClip.CheckCount = 10
                    parClip.CheckOne = 3
                    trans:SetLocalScaleXYZ(titleScale)
                end
            )
        end
        tb.aorrawimage_title:SetActiveE(0)
    end
end

---更新前三玩家UI信息
---@return void
function SprintRankComponet:UpdateTopRankInfos()
    if not self.topItems then
        self.topItems = {}
        for i = 1, TOP_PLAYER_COUNT do
            self.topItems[i] = _G.GetAutoGoTable(self.go_table["obj_info" .. i])
            self.topItems[i].rank = i
        end
    end

    for i = 1, TOP_PLAYER_COUNT do
        local tb = self.topItems[i]
        local topRank = self.topRanks[i]
        if topRank and topRank.data then
            tb.data = topRank.data
            tb.aorrawimage_noRole:SetActiveE(0)
            tb.aortext_name.text = topRank.data.role_info.name
            self:ShowScore(tb,topRank.data.value[1])
        else
            tb.data = nil
            tb.aortext_name.text = _G.GetLangPackValue(90000010159)
            tb.aortext_score.text = ""
            tb.aorrawimage_noRole:SetActiveE(1)
        end
    end
end

---积分表现可能变化，可继承重写
function SprintRankComponet:ShowScore(tb, value)
    if value and value > 0 then
        --tb.aortext_score.text = require "SecretRealmModel":GetInstance():GetName(value)
        tb.aortext_score.text = GetLangPackValue(90022100272,value)
    else
        tb.aortext_score.text = ""
    end
end

