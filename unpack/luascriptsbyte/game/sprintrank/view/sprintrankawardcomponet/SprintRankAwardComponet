---@class SprintRankAwardComponet : Component	中文描述
---@field public go_table SprintRankView._obj_Award_GoTable GoTable
local SprintRankAwardComponet = _G.BaseClass("SprintRankAwardComponet", _G.Component)
local SprintRankUtils = require("SprintRankUtils")

function SprintRankAwardComponet:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.itemList = {}

    ---@type SprintRankUtils.TagType
    self.curSelectTag = SprintRankUtils.TagType.Personal

    ---@type table<SprintRankUtils.TagType,_obj_Rank._obj_ListItem1_GoTable>
    self.tagItem = {}
    self.tagItem[SprintRankUtils.TagType.Personal] = GetAutoGoTable(self.go_table.obj_ListItem1,handlerbind(self,self.SetTag,SprintRankUtils.TagType.Personal))
    self.tagItem[SprintRankUtils.TagType.Alliance] = GetAutoGoTable(self.go_table.obj_ListItem2,handlerbind(self,self.SetTag,SprintRankUtils.TagType.Alliance))

    ---@type table<SprintRankUtils.TagType,data>
    self.ShowData = {}
end

function SprintRankAwardComponet:SetTag(go,ison,tag)
    self.curSelectTag = tag
    self:RefreshTag()
    if self.ShowData[self.curSelectTag] == nil then
        local msg = {}
        msg.page = 1
        local curActivityClass = self.activity.curActivityClass
        local data = require("ActivitySynManager"):GetInstance():GetChildAcitivity(curActivityClass.cfg.info.type, self.activity.curActivityClass:GetJumpType(),self.curSelectTag)
        msg.id = data.activityID
        require("SprintRankNet"):GetInstance():GetRank(msg,function(rankdata)
            self.ShowData[self.curSelectTag] = {
                Award = data.typeClass.rank_awards,
                data = rankdata,
            }
            self:UpdateView(data.typeClass.rank_awards,rankdata,self.activity)
        end)
    else
        local data = self.ShowData[self.curSelectTag]
        self:UpdateView(data.Award,data.data,self.activity)
    end
end

function SprintRankAwardComponet:RefreshTag()
    for i, v in pairs(self.tagItem) do
        if i == self.curSelectTag then
            v.obj_Select:SetActiveE(1)
        else
            v.obj_Select:SetActiveE(0)
        end
    end
end

---界面的入口函数
function SprintRankAwardComponet:OnCreate()

end

function SprintRankAwardComponet:OnDisable()
    self.curSelectTag = SprintRankUtils.TagType.Personal
end

function SprintRankAwardComponet:UpdateView(award, data,activity)
    self.Award = award
    ---@type SprintRankSynModel
    self.activity = activity
    self.ShowData[self.curSelectTag] = {
        Award = award,
        data = data
    }

    if data then
        self.ranks = data.ranks or {}

        if self.curSelectTag == SprintRankUtils.TagType.Personal  then
            for i = 1,#self.ranks do
                if self.ranks[i].role_info.uid == _G.PlayerModel:GetInstance().role_uid then
                    self.selfRank = self.ranks[i]
                    self.selfRankNum = i
                    break
                end
            end
        else
            local IsAddLegion,uid = SprintRankUtils.GetIsAddLegion()
            if IsAddLegion then
                for i = 1,#self.ranks do
                    if self.ranks[i].guild_info and self.ranks[i].guild_info.uid == uid then
                        self.selfRank = self.ranks[i]
                        self.selfRankNum = i
                        break
                    end
                end
            end
        end
    end

    local count = #award
    self.go_table.scrollloopvectical_itemList:InitItemData(count, _G.handler(self, self.RefreshList))

    self:UpdateSelfRank()
end

---更新自己的排名信息
---@return void
function SprintRankAwardComponet:UpdateSelfRank()
    self.go_table.obj_selfRank:SetActiveE(self.selfRank and 1 or 0)

    local item = _G.GetAutoGoTable(self.go_table.obj_selfRank)
    if self.selfRank then
        self:UpdateItem(
            self.selfRankNum,
            item,
            self.selfRank
        )
        item.aortext_noRank.text = ""
    else
        item.aortext_rank.text = GetLangPackValue(90120200138)
        item.aortext_noRank.text = _G.GetLangPackValue(90026500029)
        item.aortext_score.text = self.curSelectTag == SprintRankUtils.TagType.Personal and self.activity.data.role_p or self.activity.data.guild_p
    end
end

---设定item显示状态
---@param rank number   排名
---@param item SprintRankAwardComponet._obj_listItem_GoTable|SprintRankAwardComponet._obj_selfRank_GoTable
---@param data 
function SprintRankAwardComponet:UpdateItem(rank, item, data)
    if item.obj_rank then
        --自己的排名信息
        item.obj_rank:SetActiveE(rank >= 1 and 1 or 0)
        item.aortext_noRank:SetActiveE(rank < 1 and 1 or 0)
        if rank >= 1 then
            item.aortext_rank.text = tostring(rank)
        end
    else
        --列表排名信息
        local rankIcon = RankIcon[rank]
        if rankIcon then
            item.aortext_rank.text = tostring(rank)
        end
    end

    --分数丶伤害数据信息
    self:ShowScore(item,data and data.value[1] or 0)
    self:RefreshTag()
end

---积分表现可能变化，可继承重写
function SprintRankAwardComponet:ShowScore(tb, value)
    if value and value > 0 then
        --tb.aortext_score.text = require "SecretRealmModel":GetInstance():GetName(value)
        tb.aortext_score.text = GetLangPackValue(90022100272,value)
    else
        tb.aortext_score.text = ""
    end
end

function SprintRankAwardComponet:RefreshList(index, obj)
    index = index + 1
    ---@type DragonLingView._obj_item_GoTable
    local tb = _G.GetAutoGoTable(obj)
    local data = self.Award[index]

    tb.rank_award = data.rank_award

    if data.min_rank == data.max_rank then
        tb.aortext_rank.text = _G.GetLangPackValue(90029400144, data.min_rank)
    else
        if data.max_rank >= 9999 then
            tb.aortext_rank.text = _G.GetLangPackValue(90033404108)
        else
            tb.aortext_rank.text = _G.GetLangPackValue(90029400145, data.min_rank, data.max_rank)
        end
    end

    if data.min_rank <= 3 then
        tb.aortext_rank:SetActiveE(0)
        tb.aorimage_rank:SetActiveE(1)
        tb.aorimage_bg.SpriteName = "ui_diban" .. data.min_rank
        tb.aorimage_rank.SpriteName = SprintRankUtils.rankIcon1[data.min_rank]
    else
        tb.aortext_rank:SetActiveE(1)
        tb.aorimage_rank:SetActiveE(0)
        tb.aorimage_bg.SpriteName = "TY_img_kuang"
    end

    local titleScale = _G.ConfigManager.discrete_cfg[100111] and _G.ConfigManager.discrete_cfg[100111][1][1] or 1
    if data.title_award then
        local player_title = _G.ConfigManager.player_title_effect_cfg[data.title_award[1].value]
        if player_title.type_title == 1 then
            tb.aorrawimage_title:SetActiveE(1)
            tb.aorrawimage_title:LoadImage(player_title.title)
            tb.aorrawimage_title:SetActiveE(1)
            tb.aorrawimage_title:SetLocalScaleXYZ(0.29 * titleScale)
            tb.obj_titleEffect:RemoveAllChildren()
        elseif player_title.type_title == 2 then
            tb.obj_titleEffect:RemoveAllChildren()
            _G.UIUtils.LoadEffectTitleOrFrame(
                player_title.title,
                tb.obj_titleEffect,
                function(trans)
                    if nil == self.go_table then
                        trans:DestroyObject()
                        return
                    end
                    local parClip = trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                    parClip.NeedCheck = true
                    parClip.CheckCount = 10
                    parClip.CheckOne = 3
                    trans:SetLocalScaleXYZ(titleScale)
                end
            )
            tb.aorrawimage_title:SetActiveE(0)
        end
    else
        tb.obj_titleEffect:RemoveAllChildren()
        tb.aorrawimage_title:SetActiveE(0)
    end

    tb.obj_Root:RemoveAllChildren()
    for _, v in pairs(tb.rank_award) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            v.type,
            tb.obj_Root,
            function(item)
            if not tb.obj_Root then
                _G.DestoryObject(item)
                return
            end
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            item.gameObject:SetLocalScaleXYZ(0.8)
        end)
    end
end

function SprintRankAwardComponet:OnClickBtn(go, isOn)

end

return SprintRankAwardComponet