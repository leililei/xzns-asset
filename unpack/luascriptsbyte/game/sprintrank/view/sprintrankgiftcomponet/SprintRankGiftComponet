---@param obj SuperScrollView.LoopListViewItem2
---@param data activity_cash_gift.i_cash_gift
function SprintRankGiftComponet:UpdateCommonItem(obj, data, index)
    obj:SetName(index)
    ---@type _obj_Gift._obj_itemlist_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.itemOnClickBtn, data))
    local limit = data.count
    local buy_num = self.curActivityClass:GetItemBuyTimes(data.id or data.sid, data.type_reset)
    local soldOut = limit == buy_num
    --_G.GameUtil.AddDouYinIcon(tb.aorbtn_star, true, nil, nil, nil, data.consume_type == 0 and data.price or 0)

    if limit - buy_num > self.limitTimesCond or soldOut then
        tb.aortext_limited:SetActiveE(0)
    else
        tb.aortext_limited:SetActiveE(1)
        local lang = data.type_reset == 1 and 90031400013 or 90021600042
        tb.aortext_limited.text = _G.LangUtil.TryGetLangValue(lang, limit - buy_num)
    end
    tb.aorbtn_get:SetActiveE(soldOut and 0 or 1)
    tb.aorimage_got:SetActiveE(soldOut and 1 or 0)
    tb.aortext_taskDes.text = data.name
    tb.aortext_get.text = math.floor(data.discount * 0.01) .. "%"
    if data.price == 0 then
        tb.aortext_get.text = ""
        tb.aortext_get.text = _G.LangUtil.TryGetLangValue(90023900001)
    elseif data.consume_type == 0 then
        _G.GameUtil.SetPriceByChannel(data.price, tb.aortext_get)
    else
        tb.aortext_get.text = data.price
        local item = _G.StorageManager:GetInstance():GetItemDataClassByCfg({ data.consume_type, data.price })
        --if item then
        --    tb.aorrawimage_icon:LoadImage(item.Icon)
        --end
    end
    --tb.aorrawimage_icon:SetActiveE(data.consume_type == 0 and 0 or 1)
    local awrad = data.goods
    for i = 1, tb.obj_awards:GetChildCountE() do
        _G.DestroyImmediate(tb.obj_awards:GetChildE(0).gameObject)
    end
    for j = 1, #awrad do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
                awrad[j],
                tb.obj_awards,
                function(item)
                    if not self.go_table or obj:GetName() ~= tostring(index) or tb.obj_awards:GetChildCountE() > #awrad then
                        _G.DestroyImmediate(item.gameObject)
                        return
                    end
                    item.gameObject:SetLocalScaleXYZ(0.7)
                    item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                    item:SetGou(soldOut)
                    if item.cfg then
                        item:ShowEffectOrder(item.cfg.ef_item == 1 and true or false)
                    end
                end
        )
    end
end

function SprintRankGiftComponet:itemOnClickBtn(go, isOn, giftinfo)
    if not self.curActivityClass.curActivityClass:CheckActivityInteractable() then
        return
    end
    self.cashData = giftinfo
    self.curActivityClass:Chongzhi(
        giftinfo,
        function()
            if self.go_table == nil then
                return
            end
            self.mlistView1 = nil
            self.mlistView2 = nil
            --这里保留一个回调处理领奖
            self:RefreshData({
                typeClass = self.curActivityClass
            })
            if not self.curActivityClass:CheckOtherConditionExtra() then
                self.curActivityClass.curActivityClass:ChangeState(1) -- 改变状态 关闭
            end
        end
    )
end

function SprintRankGiftComponet:OnClickBtn(go,ison)
    if go == self.go_table.aorbtn_freeReward then
        local isAddLegion = SprintRankUtils.GetIsAddLegion()
        if isAddLegion == false then
            _G.PopWindowManager:GetInstance():ShowAllTips(802)
            return
        end
        require("ActivitySynManager"):GetInstance():JumpActivityByType(10102, self.curActivityClass.curActivityClass:GetJumpType())
    end
end

function SprintRankGiftComponet:OnMallCashListener()
    self.mlistView1 = nil
    self.mlistView2 = nil
    --这里保留一个回调处理领奖
    self:RefreshData({
        typeClass = self.curActivityClass
    })
    if not self.curActivityClass:CheckOtherConditionExtra() then
        self.curActivityClass.curActivityClass:ChangeState(1) -- 改变状态 关闭
    end
end


return SprintRankGiftComponet