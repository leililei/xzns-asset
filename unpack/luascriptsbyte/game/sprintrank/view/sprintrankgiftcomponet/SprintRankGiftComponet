---界面的入口函数
function SprintRankGiftComponet:OnCreate()
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    SprintRankUtils.AddTimer(self,self.UpdateTimer)
end

function SprintRankGiftComponet:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    SprintRankUtils.StopTime(self)
end

function SprintRankGiftComponet:UpdateTimer(elapsed)
    if self.curActivityClass then
        local left = SprintRankUtils.GetActiveTimer(self.curActivityClass.curActivityClass)
        if left > 0 then
            self.go_table.aortext_time:SetActiveE(1)
            self.go_table.aortext_time.text = GetLangPackValue(90120200102,TimeUtil.TransLateSMCH(left))
        else
            self.go_table.aortext_time:SetActiveE(0)
        end
    end
end

function SprintRankGiftComponet:RefreshData(curActivityClass)
    ---@type TrainSuperValuModelGM
    self.curActivityClass = curActivityClass.typeClass
    --self.activityCls = self.curActivityClass:GetActivityTypeCls()
    self.GetJumpType = require "ActivitySynManager":GetInstance():GetChildAcitivity(10014, self.curActivityClass.curActivityClass:GetJumpType())
    self.ActivityID = self.GetJumpType.activityID
    self.curActivityClass:UpdateDynamicData(self.ActivityID)
    self.model_data = self.curActivityClass:GetModelCfgByCondition(self.ActivityID)

    _G.SortList(
        self.model_data,
        function(data)
            local num = 10
            local buy_num = self.curActivityClass:GetItemBuyTimes(data.id or data.sid, data.type_reset)
            local limit = data.count_limit or data.count
            --local paixu = data.display_priority or data.price
            if buy_num == limit then
                num = 9
            end
            return num, -data.sid
        end
    )

    local data = require "ActivitySynManager":GetInstance():GetChildAcitivity(10102, self.curActivityClass.curActivityClass:GetJumpType())
    local activity = data.typeClass
    self.go_table.obj_rewardRed:UpdateRedPointItemIDAndParam(activity:GetRedpointIDByIndex(1))

    self:UpdateTimer()
    self:InitView()
    self:RefreshView()
end

