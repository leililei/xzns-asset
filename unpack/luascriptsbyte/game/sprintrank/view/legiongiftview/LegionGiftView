---@class LegionGiftView:UIBaseView 盟友赠礼
---@field go_table  LegionGiftView_GoTable
local LegionGiftView = BaseClass("LegionGiftView",UIBaseView)
local SprintRankUtils = require("SprintRankUtils")

function LegionGiftView:OnCreate(msg)
    self.go_table = _G.GetAutoGoTable(self.gameObject,handler(self,self.onClick))
    self:InitData(msg)
    self:RefreshData()
    self:InitUI()
    self:RefreshUI()
    self:AddListener(SprintRankUtils.Event_AddLegionGift,handler(self,self.AddLegionGift))
end

function LegionGiftView:OnDestroy()
    self:RemoveListener(SprintRankUtils.Event_AddLegionGift,handler(self,self.AddLegionGift))
end

function LegionGiftView:AddLegionGift()
    self:RefreshData()
    self:RefreshUI()
end

function LegionGiftView:InitData(data)
    ---@type LegionGiftSynModel
    self.data = data
    if self.data.data and self.data.data.guild_welfare and #self.data.data.guild_welfare > 0 then
        self.isNotData = false
    else
        self.isNotData = true
    end
    ---@type LegionGiftView._obj_item_GoTable[]
    self.itemList = {}
    self.model = {}
    ---@type activity_guild_welfare.i_guild_welfare[]
    self.rewardList = {}
    ---@type LegionGiftSynModel.playData[]
    self.rankData = {}
end

function LegionGiftView:RefreshData()
    self.rewardList = self.data:GetGuild_welfareList()
    ---@type LegionGiftSynModel.playData[]
    self.rankData = self.data.playList
end

function LegionGiftView:InitUI()
    self.go_table.scrollloopvectical_Group:InitItemData(0, _G.handler(self, self.RefreshItem))
end

function LegionGiftView:RefreshItem(index,obj)
    local newIndex = index + 1
    local data = self.rewardList[newIndex]
    local id = obj:GetInstanceIDE()
    ---@type LegionGiftView._obj_item_GoTable
    local item = GetAutoGoTable(obj,handlerbind(self,self.GetReward,data))
    local playName = data.role_info.name
    local isGetReward = self.data:GetisGetReward(data.uid)
    item.obj_items:RemoveAllChildren()
    SprintRankUtils.LoadItemBase(self,id,data.award[1],item.obj_items,function(item)
        item.transform:SetLocalScaleXYZ(0.8)
        item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
    end)
    item.aortext_des1.text = GetLangPackValue(90120200109,playName)
    item.aorbtn_get:SetActiveE(isGetReward and 0 or 1)
    item.aorimage_over:SetActiveE(isGetReward and 1 or 0)
end

---@param data activity_guild_welfare.i_guild_welfare
function LegionGiftView:GetReward(go,ison,data)
    self.data:GetReward(data,function()
        self:RefreshData()
        self:RefreshUI()
    end)
end

function LegionGiftView:RefreshUI()
    if self.isNotData then
        self.go_table.obj_noReward:SetActiveE(1)
    else
        self.go_table.obj_noReward:SetActiveE(0)
    end
    if self.isNotData then
        self.go_table.obj_showNode:SetActiveE(0)
        self.go_table.obj_HeadItemBase:SetActiveE(0)
        self.go_table.aortext_name:SetActiveE(0)
    else
        self.go_table.obj_showNode:SetActiveE(1)
        self.go_table.obj_HeadItemBase:SetActiveE(1)
        self.go_table.aortext_name:SetActiveE(1)
        local count = #self.rankData
        if count > 3 then
            count = 3
        end
        local data = self.rewardList[1].award[1]
        local itemdta = StorageManager:GetInstance():GetStorageItemData(data.type[1])
        local icon = itemdta.Icon
        GameUtil.SetChildCount(self.go_table.obj_showNode,count,function(trans,index)
            ---@type LegionGiftView._obj_entryNode_GoTable
            local goTable = GetAutoGoTable(trans)
            local data = self.rankData[index]
            local num = self:GetPlayGiftItemNum(data.play.uid)
            --SprintRankUtils.SetEntryNode(goTable,data.play.name,data.num,icon)
            SprintRankUtils.SetEntryNode(goTable,data.play.name,num,icon)
        end)
        self.go_table.aortext_name.text = self.rankData[1].play.name
        UIUtils.SetPlayerHeadItemNew(self.go_table.obj_HeadItemBase, self.rankData[1].play, 1, true, true, true)
        self.go_table.scrollloopvectical_Group:UpdateCount(#self.rewardList)
        self.go_table.scrollloopvectical_Group:UpdateAllItem()
    end
end

function LegionGiftView:GetPlayGiftItemNum(uid)
    local num = 0
    for i = 1, #self.rewardList do
        if self.rewardList[i].role_info.uid == uid then
            num = num + self.rewardList[i].award[1].type[2]
        end
    end
    return num
end

function LegionGiftView:onClick(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_buy then
        self:Close()
    elseif go == self.go_table.aorbtn_sear then
        ---@type ListGiftsView
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ListGiftsView.Name,self.data)
    end
end

return LegionGiftView