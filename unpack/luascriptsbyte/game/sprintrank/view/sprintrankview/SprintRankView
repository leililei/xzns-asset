---@class SprintRankView : UIBaseView   活动冲榜
---@field go_table SprintRankView_GoTable GoTable
local SprintRankView = _G.BaseClass("SprintRankView", _G.UIBaseView)


function SprintRankView:Awake()
    ---脚本后续多类型可继承扩展
    self.RankLua = "SprintRankComponet"
    self.RankAwardLua = "SprintRankAwardComponet"
    self.RankTaskLua = "SprintRankTaskComponet"
    self.RankGiftLua = "SprintRankGiftComponet"

    ---目前大部分相似，预制基本不变，如有大变化需要重新定义
    self.RankObj = "obj_Rank"
    self.RankAwardObj = "obj_Award"
    self.RankTaskObj = "obj_Task"
    self.RankGiftObj = "obj_Gift"

    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function SprintRankView:OnCreate(activity)
    ---@type SprintRankSynModel
    self.activity = activity
    self.curActivityClass = activity.curActivityClass
    -- if activity.rank_type == 94 then
    --     ---脚本后续多类型可继承扩展
    --     self.RankLua = "SprintRankComponet"
    --     self.RankAwardLua = "SprintRankAwardComponet"
    --     self.RankTaskLua = "SprintRankTaskComponet"

    --     ---目前大部分相似，预制基本不变，如有大变化需要重新定义
    --     self.RankObj = "obj_Rank"
    --     self.RankAwardObj = "obj_Award"
    --     self.RankTaskObj = "obj_Task"
    -- end
    self.go_table.obj_Rank:SetActiveE(1)
    self:ShowRank()

    self.activity.ShowRedPoint = false
    self.activity:RefreshRedPoint()
    self.time = self.activity:GetEndTime() - _G.TimeUtil.GetServerUnixTime()
    self.go_table.aortext_time.text = _G.GetLangPackValue(90000000988) .. _G.TimeUtil.TransLateSMCH(self.time) --剩余时间
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)          --用于更新剩余时间
    self.timer:Start()
    self:UpdateTime(0)

    local taskActivity = require "ActivitySynManager":GetInstance():GetChildAcitivity(10007, self.curActivityClass:GetJumpType())
    if taskActivity then 
        self.go_table.obj_redpointTask:UpdateRedPointItemIDAndParam(
            taskActivity:GetActivityTypeCls():GetRedpointIDByIndex(1)
        )
    end
    local Activity = require "ActivitySynManager":GetInstance():GetChildAcitivity(10014, self.curActivityClass:GetJumpType())
    if Activity then
        self.go_table.toggle_gift:SetActiveE(1)
        self.go_table.obj_redpointGift:UpdateRedPointItemIDAndParam(
            Activity:GetActivityTypeCls():GetRedpointIDByIndex(1)
        )
    else
        self.go_table.toggle_gift:SetActiveE(0)
    end
end

function SprintRankView:UpdateTime(elapsed)
    if not self.go_table or self.time <= 0 then
        self:StopTimer()
        if self.time <= 0 then
            self:Close()
        end
        return
    end
    self.time = self.time - elapsed
    local time = _G.TimeUtil.TransLateSMCH(_G.Mathf.RoundToInt(self.time))
    self.go_table.aortext_time.text = _G.GetLangPackValue(90120200121, time)
end

---停止计时器
function SprintRankView:StopTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

function SprintRankView:ShowRank()
    --self.go_table.aortext_time:SetLocalPosition(0, -392, 0)
    if nil == self.RankCpt then
        ---@type SprintRankComponet
        self.RankCpt = self:AddComponent(
                self.go_table[self.RankObj],
                require(self.RankLua).New(
                    self.go_table[self.RankObj]
                )
            )
    end
    local msg = {}
    msg.page = 1
    msg.id = self.curActivityClass.activityID
    require("SprintRankNet"):GetInstance():GetRank(msg, function(data)
        self.RankData = data
        self.RankCpt:UpdateView(data,self.activity)
    end
    )
    self.go_table.aortext_time:SetActiveE(1)
end

function SprintRankView:ShowAward()
    --self.go_table.aortext_time:SetLocalPosition(0, -392, 0)
    if nil == self.RankAwardCpt then
        ---@type SprintRankAwardComponet
        self.RankAwardCpt = self:AddComponent(
                self.go_table[self.RankAwardObj],
                require(self.RankAwardLua).New(
                    self.go_table[self.RankAwardObj]
                )
            )
    end
    self.RankAwardCpt:UpdateView(self.activity.rank_awards, self.RankData,self.activity)
    self.go_table.aortext_time:SetActiveE(1)
end

function SprintRankView:ShowTask()
    --self.go_table.aortext_time:SetLocalPosition(116, 322, 0)
    if nil == self.RankTaskCpt then
        ---@type SprintRankTaskComponet
        self.RankTaskCpt = self:AddComponent(
                self.go_table[self.RankTaskObj],
                require(self.RankTaskLua).New(
                    self.go_table[self.RankTaskObj]
                )
            )
    end

    local taskActivity = require "ActivitySynManager":GetInstance():GetChildAcitivity(10007, self.curActivityClass:GetJumpType())
    if taskActivity then 
        self.RankTaskCpt:UpdateView(taskActivity)
    end
    self.go_table.aortext_time:SetActiveE(0)
end

function SprintRankView:ShowGift()
    if nil == self.RankGiftCpt then
        ---@type SprintRankGiftComponet
        self.RankGiftCpt = self:AddComponent(
            self.go_table[self.RankGiftObj],
            require(self.RankGiftLua).New(
                    self.go_table[self.RankGiftObj]
            )
        )
    end

    ---@type ActivitySynGMActivity
    local taskActivity = require "ActivitySynManager":GetInstance():GetChildAcitivity(10014, self.curActivityClass:GetJumpType())
    if taskActivity then
        self.RankGiftCpt:RefreshData(taskActivity)
    end
    self.go_table.aortext_time:SetActiveE(0)
end

function SprintRankView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.toggle_rank then
        local toggle = _G.GetAutoGoTable(self.go_table.toggle_rank)
        _G.GameUtil.SetActiveByCondition(toggle.aortext_ontxt, isOn)
        _G.GameUtil.SetActiveByCondition(toggle.aortext_offtxt, not isOn)
        if isOn then
            self.go_table.obj_Rank:SetActiveE(1)
            
            self:ShowRank()
        else
            self.go_table.obj_Rank:SetActiveE(0)
        end
    elseif go == self.go_table.toggle_award then
        local toggle = _G.GetAutoGoTable(self.go_table.toggle_award)
        _G.GameUtil.SetActiveByCondition(toggle.aortext_ontxt, isOn)
        _G.GameUtil.SetActiveByCondition(toggle.aortext_offtxt, not isOn)
        if isOn then
            self.go_table.obj_Award:SetActiveE(1)
            self:ShowAward()
        else
            self.go_table.obj_Award:SetActiveE(0)
        end
    elseif go == self.go_table.toggle_task then
        local toggle = _G.GetAutoGoTable(self.go_table.toggle_task)
        _G.GameUtil.SetActiveByCondition(toggle.aortext_ontxt, isOn)
        _G.GameUtil.SetActiveByCondition(toggle.aortext_offtxt, not isOn)
        if isOn then
            self.go_table.obj_Task:SetActiveE(1)
            self:ShowTask()
        else
            self.go_table.obj_Task:SetActiveE(0)
        end
    elseif go == self.go_table.toggle_gift then
        local toggle = _G.GetAutoGoTable(self.go_table.toggle_gift)
        _G.GameUtil.SetActiveByCondition(toggle.aortext_ontxt, isOn)
        _G.GameUtil.SetActiveByCondition(toggle.aortext_offtxt, not isOn)
        if isOn then
            self.go_table.obj_Gift:SetActiveE(1)
            self:ShowGift()
        else
            self.go_table.obj_Gift:SetActiveE(0)
        end
    end
end

return SprintRankView
