---@class SprintRankTaskComponet : Component	中文描述
---@field public go_table SprintRankView._obj_Task_GoTable GoTable
local SprintRankTaskComponet = _G.BaseClass("SprintRankTaskComponet", _G.Component)
local SprintRankUtils = require("SprintRankUtils")

function SprintRankTaskComponet:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SprintRankTaskComponet:OnCreate()
    SprintRankUtils.AddTimer(self,self.UpdateTimer)
end

function SprintRankTaskComponet:UpdateView(curActivityClass)
    self.curActivityClass = curActivityClass
    ---@type DrawUpBattlePassTaskModel
    self.activityCls = self.curActivityClass:GetActivityTypeCls()
    self.taskData = self.activityCls:GetTaskDatasByType(2)
    self:UpdateTimer()
    self:InitView()
    self:UpdateViewTwo()
end

function SprintRankTaskComponet:UpdateTimer(elapsed)
    if self.curActivityClass and self.go_table and self.go_table.aortext_time then
        local left = SprintRankUtils.GetActiveTimer(self.activityCls.curActivityClass)
        if left > 0 then
            self.go_table.aortext_time:SetActiveE(1)
            self.go_table.aortext_time.text = GetLangPackValue(90120200102,TimeUtil.TransLateSMCH(left))
        else
            self.go_table.aortext_time:SetActiveE(0)
        end
    end
end

function SprintRankTaskComponet:InitView()
    local role = self.activityCls:GetRolePath()
    if not _G.string.IsNullOrEmpty(role) then
        self.go_table.aorrawimage_role:LoadImage(role,function(image)
            if self:IsNil() then
                return
            end
            image:SetNativeSize()
        end)
    end
    local title = self.activityCls:GetTitlePath()
    if not _G.string.IsNullOrEmpty(title) then
        self.go_table.aorrawimage_title:LoadImage(title,function(image)
            if self:IsNil() then
                return
            end
            image:SetNativeSize()
        end)
    end
end

function SprintRankTaskComponet:UpdateViewTwo()
    _G.SortList(self.taskData,function (item)
        -- 已领取
        if self.activityCls:CheckIsGet(item.i_task.sid) then
            return 0,-item.i_task.sid
        end
        -- 可领取
        if item.i_task.state == _G.TaskEnum.ETaskState.Submited then
            return 9,-item.i_task.sid
        end
        -- 没完成
        return 1,-item.i_task.sid
    end)
    if not self.initScroll then
        self.initScroll = true
        self.go_table.scrollloopvectical_itemList:InitItemData(#self.taskData,_G.handler(self,self.RefreshItem))
    else
        self.go_table.scrollloopvectical_itemList:UpdateAllItem()
    end
end

function SprintRankTaskComponet:RefreshItem(index, obj)
    index = index + 1
    local data = self.taskData[index]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnItemClick, index))

    tb.aortext_title.text = data.Cfg.desc

    local IsGet = self.activityCls:CheckIsGet(data.Cfg.id)
    local iscantake = data.i_task.state == _G.TaskEnum.ETaskState.Submited

    if IsGet then
        -- 已经领取
        tb.aorbtn_get:SetActiveE(0)
        tb.aorbtn_go:SetActiveE(0)
        tb.aorimage_got:SetActiveE(1)
        tb.aorimage_jd.fillAmount = 1
        tb.aortext_limit.text = string.format("(%d/%d)", data.Cfg.count, data.Cfg.count)
    elseif iscantake then
        -- 能够领取
        tb.aorbtn_get:SetActiveE(1)
        tb.aorbtn_go:SetActiveE(0)
        tb.aorimage_got:SetActiveE(0)
        tb.aorimage_jd.fillAmount = 1
        tb.aortext_limit.text = string.format("(%d/%d)", data.Cfg.count, data.Cfg.count)
    else
        -- 没有完成
        tb.aorbtn_get:SetActiveE(0)
        tb.aorbtn_go:SetActiveE(1)
        tb.aorimage_got:SetActiveE(0)
        tb.aortext_limit.text = string.format("(%d/%d)", data.i_task.target[1], data.Cfg.count)
        tb.aorimage_jd.fillAmount = data.i_task.target[1]/data.Cfg.count
    end
    tb.obj_awards:RemoveAllChildren()
    for _, v in pairs(data.Cfg.reward) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            v.type,
            tb.obj_awards,
            function(item)
            if not tb.obj_awards then
                _G.DestoryObject(item)
                return
            end
            item:SetGou(IsGet)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            item.gameObject:SetLocalScaleXYZ(0.8)
        end)
    end
end

function SprintRankTaskComponet:OnItemClick(go,_,index)
    local name = go:GetName()
    local data = self.taskData[index]
    if name == "@_aorbtn_get" then
        self.activityCls:GetAward(
            self.activityCls:GetCankTaskList(),
            function()
                self:UpdateViewTwo()
            end
        )
    elseif name == "@_aorbtn_go" then
        ---策划需求（跳转到对应的界面（专门针对跳当前页面设置（黄东要求，紫薯提议！）
        -- if 162001 == data.Cfg.link then
        --     self:Close()
        --     return
        -- end

        _G.JumpManager:GetInstance():Jump(data.Cfg.link, nil)
    end
end

---界面的销毁函数
function SprintRankTaskComponet:OnDestroy()
    SprintRankUtils.StopTime(self)
end

---按钮点击事件在这里派发
function SprintRankTaskComponet:OnClickBtn(go)
    if go == self.go_table.aorbtn_Back then
        self:Close()
    end
end

return SprintRankTaskComponet