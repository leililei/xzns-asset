function SprintRankUtils.ShowTitle(self,tb, data)
    tb.obj_titleEffect:RemoveAllChildren()
    if data == nil or data.sid == 0 then
        tb.aorrawimage_title:SetActiveE(0)
        return
    end
    local titleScale = _G.ConfigManager.discrete_cfg[100111][1][1]
    local player_title = _G.ConfigManager.player_title_effect_cfg[data.sid]
    if player_title.type_title == 1 then
        tb.aorrawimage_title:LoadImage(player_title.title)
        tb.aorrawimage_title:SetActiveE(1)
        tb.aorrawimage_title:SetLocalScaleXYZ(0.29 * titleScale)
    elseif player_title.type_title == 2 then
        _G.UIUtils.LoadEffectTitleOrFrame(
                player_title.title,
                tb.obj_titleEffect,
                function(trans)
                    if self.go_table == nil then
                        _G.DestroyObject(trans)
                        return
                    end
                    local parClip = trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                    parClip.NeedCheck = true
                    parClip.CheckCount = 10
                    parClip.CheckOne = 3
                    trans:SetLocalScaleXYZ(titleScale)
                end
        )
        tb.aorrawimage_title:SetActiveE(0)
    end
end

---@param data ActivitySynTypeBase   获取活动的时间戳显示范围 格式 xx/xx xx:xx:xx-xx/xx xx:xx:xx
function SprintRankUtils.GetShowActiveTime(data)
    local startTime = data.curActivityClass.cfg.time.start_time
    local runTime = data.curActivityClass.cfg.time.run_time
    local endTime = startTime + runTime
    local times1 = _G.TimeUtil.GetDateTime(startTime)
    local times2 = _G.TimeUtil.GetDateTime(endTime)

    local str1 = string.format("%02d/%02d %02d:%02d:%02d", times1.month, times1.day, times1.hour, times1.minute,times1.second)
    local str2 = string.format("%02d/%02d %02d:%02d:%02d", times2.month, times2.day, times2.hour, times2.minute,times2.second)
    local showtxt = string.format("%s-%s",str1,str2)
    return showtxt
end

function SprintRankUtils.GetIsShowPopover(key)
    local nowTime = TimeUtil.GetDayBegin(TimeUtil.GetServerUnixTime())
    local timestring = PlayerPrefsManager.GetString(key)
    local lasttime= string.IsNullOrEmpty(timestring) and 0 or tonumber(timestring)
    local lastDay= TimeUtil.GetDayBegin(lasttime)
    return nowTime >= lastDay
end

function SprintRankUtils.SetIsShowPopover(key,isPop)
    local nowTime = TimeUtil.GetDayBegin(TimeUtil.GetServerUnixTime())
    if isPop then
        PlayerPrefsManager.SetString(key,tostring(nowTime + 86400))
    else
        PlayerPrefsManager.SetString(key,tostring(nowTime))
    end
end


