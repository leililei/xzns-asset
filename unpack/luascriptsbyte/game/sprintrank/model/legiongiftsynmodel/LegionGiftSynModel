---初始化红点树
function LegionGiftSynModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end

function LegionGiftSynModel:CheckRedPoint()
    if self:GetIsAddLegion() == false then
        return 0
    end
    if self.data and self.data.guild_welfare then
        local addTime = self:GetUserAddSociatyTime()
        for i = 1, #self.data.guild_welfare do
            local data = self.data.guild_welfare[i]
            if data.create_time > addTime and self:GetisGetReward(data.uid) == false then
                return 1
            end
        end
    end
    return 0
end

---检测红点
---@param index number 红点类型序列号
---@return number 红点数量
function LegionGiftSynModel:CheckRedPointNumChild(index)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end


function LegionGiftSynModel:GetisGetReward(rewardId)
    if self.getRewardIdDict[rewardId] then
        return true
    end
    return  false
end

---@return activity_guild_welfare.i_guild_welfare[] 获取排序后的奖励列表
function LegionGiftSynModel:GetGuild_welfareList()
    if self:GetIsAddLegion() == false or self.data == nil or self.data.guild_welfare == nil then
        return {}
    end
    local addTime = self:GetUserAddSociatyTime()

    local canGetList = {}
    local notGetList = {}
    for i = 1, #self.data.guild_welfare do
        local data = self.data.guild_welfare[i]
        if data and data.create_time > addTime then
            if self:GetisGetReward(data.uid) then
                table.insert(notGetList,data)
            else
                table.insert(canGetList,data)
            end
        end
    end
    local newList = {}
    for i = 1, #canGetList do
        table.insert(newList,canGetList[i])
    end
    for i = 1, #notGetList do
        table.insert(newList,notGetList[i])
    end
    return newList
end

---@param data activity_guild_welfare.i_guild_welfare
function LegionGiftSynModel:GetReward(data,back)
    self:GetActivityAward({data.uid},function(msg)
        self.getRewardIdDict[data.uid] = true
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
        require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
        if back then
            back()
        end
    end)
end

function LegionGiftSynModel:GetUserRankData()
    local userUid = _G.PlayerModel:GetInstance():GetPlayerUid()
    for i = 1, #self.playList do
        if self.playList[i].play.uid == userUid then
            return self.playList[i],i
        end
    end
    return nil
end

function LegionGiftSynModel:GetIsAddLegion()
    local model = require("SociatyModel"):GetInstance()
    --检查是否已加入公会
    if not model.SociatyRoleSelf or model.SociatyRoleSelf.uid == 0 then
        return false
    end
    return true
end

function LegionGiftSynModel:GetUserAddSociatyTime()
    if self:GetIsAddLegion() then
        local model = require("SociatyModel"):GetInstance()
        return model.SociatyRoleSelf.enter_time
    end
    return nil
end

return LegionGiftSynModel