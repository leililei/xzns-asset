local base = require("ActivitySynTypeBase")

---@class LegionGiftSynModel:ActivitySynTypeBase
local LegionGiftSynModel = BaseClass("LegionGiftSynModel",base)
local SprintRankUtils = require("SprintRankUtils")

---类的构造函数
function LegionGiftSynModel:__init()
    self.ShowRedPoint = true

    --已领取字典
    self.getRewardIdDict = {}

    ---@type LegionGiftSynModel.playData[] 玩家列表
    self.playList = {}
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.send_guild_welfare.Cmd,self.AddLegionGift, self)
end

function LegionGiftSynModel:Dispose()
    base.Dispose(self)
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.send_guild_welfare.Cmd, self.AddLegionGift, self)
end

---@class LegionGiftSynModel.playData
---@field play role.i_role
---@field num number 购买礼包数量

function LegionGiftSynModel:OnHandleGMData(data)
    self:ParseData(data)
end

---@param data activity.i_activity_self_info
function LegionGiftSynModel:ParseData(data)
    self.data = data.guild_welfare
    if self.data then
        if self.data.uids then
            self.getRewardIdDict = {}
            for i = 1, #self.data.uids do
                self.getRewardIdDict[self.data.uids[i]] = true
            end
        end
        self:RefreshPlayList()
    end

    base.ParseData(self)
end

function LegionGiftSynModel:RefreshPlayList()
    if self.data.guild_welfare then
        self.playList = {}
        ---@type table<number,LegionGiftSynModel.playData>
        local uidDict = {}
        local index = 1
        for i = 1, #self.data.guild_welfare do
            local play = self.data.guild_welfare[i].role_info
            if uidDict[play.uid] then
                uidDict[play.uid].num = uidDict[play.uid].num + 1
            else
                uidDict[play.uid] = {
                    play = play,
                    num = 1
                }
                self.playList[index] = uidDict[play.uid]
                index = index  + 1
            end
        end

        table.sort(self.playList,function(a, b)
            if a.num == b.num then
                return a.play.uid > b.play.uid
            end
            return a.num > b.num
        end)
    end
end

function LegionGiftSynModel:AddLegionGift(msg)
    if msg.guild_welfare then
        if self.data then
            if self.data.guild_welfare == nil then
                self.data.guild_welfare = {}
            end
        else
            self.data = {}
            self.data.guild_welfare = {}
        end
        for i = 1, #msg.guild_welfare do
            if msg.guild_welfare[i] then
                table.insert(self.data.guild_welfare,msg.guild_welfare[i])
            end
        end
        self:RefreshPlayList()
        require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
        _G.Events:GetInstance():Broadcast(SprintRankUtils.Event_AddLegionGift)
    end
end

