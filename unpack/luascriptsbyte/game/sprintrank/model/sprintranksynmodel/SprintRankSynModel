local base = require("ActivitySynTypeBase")

---@class SprintRankSynModel : ActivitySynTypeBase	中文描述
local SprintRankSynModel = _G.BaseClass("SprintRankSynModel", base)

---类的构造函数
function SprintRankSynModel:__init()
    self.ShowRedPoint = true
    --self.rankData = {}
end

function SprintRankSynModel:OnHandleGMData(data)
    self:ParseData(data)
end

function SprintRankSynModel:ParseData(data)
    data = data.rank_info
    if data then
        self.rank_type = data.rank_type
        ---@type activity_rank.i_rank_award[]
        self.rank_awards = data.rank_awards
        ---@type activity_rank.i_activity_rank
        self.data = data
        --self.rankData[data.rank_type] = data.rank_info
    end
    
    base.ParseData(self)
end

---进入活动主体
function SprintRankSynModel:OnEnterActivity()
    if self.isGetDataIng then
        return
    end
    self.isGetDataIng = true
    require("ActivitySynNet"):GetInstance():InitActivity(self.curActivityClass.activityID, function(msg)
        if msg and msg.ack == 1 then
            self:ParseData(msg.activity[1].self_info)
            local nowTime = TimeUtil.GetServerUnixTime()
            local endTime = self:GetEndTime()
            if endTime > nowTime then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SprintRankView.Name,self)
            end
        end
        self.isGetDataIng = false
    end)
end

function SprintRankSynModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.SprintRankView.Name
end

function SprintRankSynModel:GetOtherActivityRedPointIds()
    ---@type DrawUpBattlePassTaskModel
    return {10007}
end

---初始化红点树
function SprintRankSynModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function SprintRankSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

function SprintRankSynModel:GetEndTime()
    return self.curActivityClass.cfg.time.start_time + self.curActivityClass.cfg.time.run_time
end

---检查红点
function SprintRankSynModel:CheckRedPoint()
    if self.ShowRedPoint then
        return 1
    end
    return 0
end

---刷新奖励红点
function SprintRankSynModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

---类的析构函数
function SprintRankSynModel:Dispose()
end

return SprintRankSynModel