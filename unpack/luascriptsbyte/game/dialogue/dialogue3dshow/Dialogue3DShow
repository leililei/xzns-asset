--- 播放角色默认动画
function Dialogue3DShow:MovePos(PosIndex, callback)
    local tagerPos_x = 0
    local movetime = _G.DialogueEnum.DoMoveTime
    --- 两边角色 滑动
    if PosIndex == _G.DialogueEnum.PosIndex.left then
        tagerPos_x = _G.DialogueEnum.RotIndexV3_x.left
    elseif PosIndex == _G.DialogueEnum.PosIndex.right then
        tagerPos_x = _G.DialogueEnum.RotIndexV3_x.right
    else
        tagerPos_x = _G.DialogueEnum.RotIndexV3_x.mid
        -- 中间直接
        movetime = 0.01
    end

    self.totween_DelROleMove =
        DOTween.To(
        function()
            return self.RoleTargetCamera.InScreenRate
        end,
        function(x)
            self.RoleTargetCamera.InScreenRate = x
        end,
        tagerPos_x,
        movetime
    )
    self.totween_DelROleMove.onComplete = callback
end

--- 播放角色动画
---@param state DialogueEnum.PhizType 角色表情动作动画
function Dialogue3DShow:PlayRolePhiz(PhizType)
    if _G.IsNil(self.Common_Title) then
        return
    end
    local PhizCfg = _G.DialogueEnum.PhizPrePath[PhizType]
    if PhizCfg == nil then
        return
    end

    local pos = _G.UIUtils.Get3DTo2DPos(self.phziCanvasRect, self.Common_Title.position)
    pos = pos + _G.Vector3(PhizCfg.Pos[1] or 0, PhizCfg.Pos[2] or 0, PhizCfg.Pos[3] or 0)
    _G.UIUtils.LoadEffectByCfg(
        PhizCfg,
        self.Common_Title,
        -- self.gameObject,
        function(tran)
            self:DelPhiz()
            self.PhizTran = tran
            tran:SetParentE(self.gameObject:GetParent())
            tran:SetLocalPosition(pos.x, pos.y, pos.z)
        end,
        nil,
        3
    )
end

function Dialogue3DShow:DelPhiz()
    if not _G.IsNil(self.PhizTran) then
        _G.GameObject.Destroy(self.PhizTran)
        self.PhizTran = nil
    end
end

--- 播放角色默认动画
function Dialogue3DShow:PlayAnim(animName)
    if string.IsNullOrEmpty(animName) then
        return
    end
    if _G.IsNil(self.AnimComponent) == false then
        local ishave = self.AnimComponent:isHaveAni(animName)
        if ishave == true then
            self.AnimComponent:Play(animName)
            self.AnimComponent:Queue(animName, "idle_1")
        else
            if _G.AppSetting.DEBUG then
                _G.LogError(string.format("没有该动作:%s  该模型:%s ", animName, self.scriptCfg.Model))
            end
        end
    end
end

--- 播放角色默认动画
function Dialogue3DShow:PlayShake()
    if not _G.IsNil(self.RoleTargetCamera) then
        self.RoleTargetCamera:ActionShake(0.1)
    end
end

---通过角色预制体路径 获取剧情配置路径
---@type string path 角色预制体路径
---@return string dataCfgPath
function Dialogue3DShow:GetDataCfgPath(path)
    --- 角色预制体路径 Roles/sr/caoyanbing/caoyanbing_01/prf_caoyanbing_01
    --- 角色剧情配置路径 Story/Roles/sr/caoyanbing/caoyanbing_01/caoyanbing_01_story_cfg
    local str = path
    if string.IsNullOrEmpty(path) then
        return ""
    end
    local strArr = string.split(str, "/")
    strArr[#strArr] = string.sub(strArr[#strArr], 5)

    local dataCfgPath = "Story"
    for i = 1, #strArr do
        dataCfgPath = dataCfgPath .. "/" .. strArr[i]
    end
    dataCfgPath = dataCfgPath .. "_story_cfg"

    return dataCfgPath
end

