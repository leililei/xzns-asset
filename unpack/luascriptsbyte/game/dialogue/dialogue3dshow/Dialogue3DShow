---当前脚本是否还存在  true不存在
function Dialogue3DShow:IsDes()
    return self.Roleindex == nil
end
function Dialogue3DShow:SetNil()
    self.phziCanvasRect = nil
    self.Common_Title = nil
    self.RoleTargetCamera = nil
    self.scriptCfg = nil
    self.RolePoint = nil
    self.Roleindex = nil
    self.AnimComponent = nil
    self.RoledataCfg = nil
    if self.LoadRoleTimer ~= nil then
        self.LoadRoleTimer:Stop()
        self.LoadRoleTimer = nil
    end
    if self.totween_DelROleMove ~= nil then
        self.totween_DelROleMove:Kill()
        self.totween_DelROleMove = nil
    end

    if self.RoleTransf ~= nil then
        _G.PoolsManager:GetInstance():Despawn(self.RoleTransf, _G.ePoolType.Temporary)
        self.RoleTransf = nil
        self.RoleGameObject = nil
    end

    if self.RoledataResRef ~= nil then
        self.RoledataResRef:Release()
        self.RoledataResRef = nil
    end

    if not _G.IsNil(self.PhizTran) then
        _G.GameObject.Destroy(self.PhizTran)
        self.PhizTran = nil
    end
end

return Dialogue3DShow
