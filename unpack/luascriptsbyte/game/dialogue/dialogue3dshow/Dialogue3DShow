---创建对象时,入口构造函数
---@param index number 角色站位编号
function Dialogue3DShow:OnCreate(go_table, index)
    self:SetNil()
    self.Roleindex = index
    self.Common_Title = nil
    self.RoleTargetCamera = nil
    -- 当前表情
    self.PhizTran = nil

    local DialogueView = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DialogueView.Name)
    self.phziCanvasRect = nil
    if not _G.IsNil(DialogueView) then
        local NormalLayerRect = DialogueView.View.gameObject:GetComponentE(typeof(CS.UnityEngine.RectTransform))
        if not _G.IsNil(NormalLayerRect) then
            self.phziCanvasRect = NormalLayerRect
        end
    end

    if self.Common_Title == nil then
        ---@type DialogueRootTranDic

        local StoryManager = _G.StoryManager:GetInstance()
        if StoryManager.isDialogueRootTranDicInit then
            local DialogueRootTranDic = StoryManager.DialogueRootTranDic
            ---@type DialoguePosDic
            local PosTranDic = DialogueRootTranDic[self.Roleindex]

            self.Common_Title = PosTranDic.Common_Title
            ---@type RoleTargetCamera
            self.RoleTargetCamera = PosTranDic.RoleTargetCamera
        end
    end
end

---销毁对象时,析构函数
function Dialogue3DShow:OnDestroy()
    self:delRole(_G.DialogueEnum.RoleShowType.direct)
    --self:SetNil()
end
---在dialogueView的ondisable之前先执行 确保计时器置空
function Dialogue3DShow:OnDisable()
    self:SetNil()
end
---开始加载角色
---@param path string 角色模型名称
---@param scriptCfg dialogue_script_cfg_Item 角色模型名称
---@param callback fun() 初始化完成回调
function Dialogue3DShow:Init(path, scriptCfg, callback)
    local RoleShowType = scriptCfg.ShowType
    if not (RoleShowType >= _G.DialogueEnum.RoleShowType.direct) then
        RoleShowType = _G.DialogueEnum.RoleShowType.direct
    end
    self:delRole(
        RoleShowType,
        function()
            ---@type dialogue_script_cfg
            self.scriptCfg = scriptCfg

            self:LoadRole(
                path,
                RoleShowType,
                function()
                    callback()
                end
            )
        end
    )
end

---销毁角色
---@param RoleShowType number 消失方式 1闪现 2滑动
---@param callback fun() 初始化完成回调
function Dialogue3DShow:delRole(RoleShowType, callback)
    local function callFun()
        if callback ~= nil then
            callback()
        end
    end

    if _G.IsNil(self.RoleTransf) then
        callFun()
        return
    end

    local function runFun()
        self.totween_DelROleMove = nil
        if _G.IsNil(self.RoleTransf) == false then
            local TalkRoleTopRender = self.RoleTransf:GetComponentE(_G.typeof(_G.CS.TalkRoleTopRender))
            if TalkRoleTopRender ~= nil then
                _G.DestroyObject(TalkRoleTopRender)
            end
        end
        if self.RoledataResRef ~= nil then
            self.RoledataResRef:Release()
            self.RoledataResRef = nil
        end
        _G.PoolsManager:GetInstance():Despawn(self.RoleTransf, _G.ePoolType.Temporary)
        self:DelPhiz()
        self.RoleTransf = nil
        self.RoleGameObject = nil
        callFun()
    end

    --- 直接
    if RoleShowType == _G.DialogueEnum.RoleShowType.direct then
        runFun()
    elseif RoleShowType == _G.DialogueEnum.RoleShowType.slide then
        -- 滑动

        local tagerPos_x = 0
        local movetime = _G.DialogueEnum.DoMoveTime
        --- 两边角色 滑动
        if self.Roleindex == _G.DialogueEnum.PosIndex.left then
            tagerPos_x = _G.DialogueEnum.PosIndexV3_init_x.left
        elseif self.Roleindex == _G.DialogueEnum.PosIndex.right then
            tagerPos_x = _G.DialogueEnum.PosIndexV3_init_x.right
        else
            tagerPos_x = _G.DialogueEnum.PosIndexV3_init_x.mid
            -- 中间直接
            movetime = 0.01
        end

        self.totween_DelROleMove =
            DOTween.To(
            function()
                return self.RoleTargetCamera.InScreenRate
            end,
            function(x)
                self.RoleTargetCamera.InScreenRate = x
            end,
            tagerPos_x,
            movetime
        )
        self.totween_DelROleMove.onComplete = _G.handler(self, runFun)
    end
end

function Dialogue3DShow:LoadRole(path, RoleShowType, callback)
    if _G.IsNil(self.RoleTargetCamera) or string.IsNullOrEmpty(path) then
        if callback ~= nil then
            callback()
        end
        return
    end
    local function callFun()
        ---延迟几帧 确保  self.RoleTargetCamera:Init 初始化后 移动到了配置位置
        self.LoadRoleTimer =
            _G.TimerManager:GetInstance():GetTimer(2, self.LoadRoleTimerFunc, self, true, true, false, callback)
        self.LoadRoleTimer:Start()
    end

    local function runFun(trans)
        if _G.IsNil(trans) or _G.IsNil(self.RoleTargetCamera) then
            if _G.AppSetting.DEBUG then
                _G.LogError("模型加载路径有误 path:" .. path)
            end
            return
        end
        local posx = 0

        -- - 直接
        if RoleShowType == _G.DialogueEnum.RoleShowType.direct then
            if self.scriptCfg.DialogueShowType == _G.DialogueEnum.DialogueShowType.fight then
                posx = _G.DialogueEnum.RotIndexV3_x.fightleft
            elseif self.Roleindex == _G.DialogueEnum.PosIndex.left then
                posx = _G.DialogueEnum.RotIndexV3_x.left
            elseif self.Roleindex == _G.DialogueEnum.PosIndex.right then
                posx = _G.DialogueEnum.RotIndexV3_x.right
            else
                posx = _G.DialogueEnum.RotIndexV3_x.mid
            end
            self.RoleTargetCamera:Init(self.RoleGameObject, posx, self.RoledataCfg)
            callFun()
        else
            -- 滑动

            local posx = 0
            --- 两边角色 滑动
            if self.Roleindex == _G.DialogueEnum.PosIndex.left then
                self.RoleTargetCamera:Init(
                    self.RoleGameObject,
                    _G.DialogueEnum.PosIndexV3_init_x.left,
                    self.RoledataCfg
                )
                posx = _G.DialogueEnum.RotIndexV3_x.left
            elseif self.Roleindex == _G.DialogueEnum.PosIndex.right then
                self.RoleTargetCamera:Init(
                    self.RoleGameObject,
                    _G.DialogueEnum.PosIndexV3_init_x.right,
                    self.RoledataCfg
                )
                posx = _G.DialogueEnum.RotIndexV3_x.right
            else
                self.RoleTargetCamera:Init(self.RoleGameObject, _G.DialogueEnum.RotIndexV3_x.mid, self.RoledataCfg)
                ---中间角色直接
                callFun()
                return
            end

            ---战斗单人对话  位置要不一样
            if self.scriptCfg.DialogueShowType == _G.DialogueEnum.DialogueShowType.fight then
                posx = _G.DialogueEnum.RotIndexV3_x.fightleft
            end
            self.totween_DelROleMove =
                DOTween.To(
                function()
                    return self.RoleTargetCamera.InScreenRate
                end,
                function(x)
                    self.RoleTargetCamera.InScreenRate = x
                end,
                posx,
                _G.DialogueEnum.DoMoveTime
            )
            self.totween_DelROleMove:SetEase(_G.CS.DG.Tweening.Ease.OutExpo)
            self.totween_DelROleMove.onComplete = _G.handler(self, callFun)
        end
    end

    self.totween_DelROleMove = nil

    local cfgPath = self:GetDataCfgPath(path)
    _G.ResourcesManager:GetInstance():LoadScriptableObject(
        cfgPath,
        _G.handlerbind(self, self.LoadScriptableObjectCall, path, runFun),
        self
    )
end

function Dialogue3DShow:LoadRoleTimerFunc(callback)
    if not _G.IsNil(self.RoleTransf) then
        self.RolePoint = self.RoleTransf:GetComponentE(_G.typeof(_G.CS.RolePoint))

        if self.Common_Title then
            if self.RolePoint and not _G.IsNil(self.RolePoint.Point_Head) then
                local x, y, z = self.RolePoint.Point_Head:GetPosition()
                self.Common_Title:SetPosition(x, y, z)
            end
        end
    end

    if callback ~= nil then
        callback()
    end
end

function Dialogue3DShow:LoadScriptableObjectCall(dataCfg, resRef, path, runFun)
    if self:IsDes() then
        if resRef ~= nil then
            resRef:Release()
        end
        return
    end
    ---@type dialogue_script_cfg
    self.RoledataCfg = dataCfg
    self.RoledataResRef = resRef

    require("CardInfoManager").GetRole(
        path,
        _G.ePoolType.Temporary,
        _G.StoryManager:GetInstance().InitPosRoot,
        _G.RoleEffTypeEnum.Dialogue,
        _G.handlerbind(self, self.SpawnRoleCall, runFun)
    )
end

function Dialogue3DShow:SpawnRoleCall(tran, _, runFun)
    if _G.IsNil(self.RoleTargetCamera) then
        if _G.AppSetting.DEBUG then
            _G.LogError(" 界面已销毁 ")
        end
        if self.RoledataResRef ~= nil then
            self.RoledataResRef:Release()
            self.RoledataResRef = nil
        end
        _G.DestroyObject(tran)
        return
    end
    self:OnRoleLoaded(tran)
    runFun(tran)
end
