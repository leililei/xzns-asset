local DialogueOptionAction = {}

--- 播放一段对话
---@param optionData OptionData 对话选项数据
---@param callback fun() 行为完成之后的回调
function DialogueOptionAction.ShowDialogueScript(optionData, callback)
    local function ActionFinishCallback()
        if callback then
            callback()
        end
    end

    local isExist, view = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.DialogueView.Name)
    if not isExist then
        if _G.AppSetting.DEBUG then
            _G.LogError(_G.ConfigManager.ui_cfg.DialogueView.Name .. " not exist. ")
        end
        ActionFinishCallback()
    else
        view.View:ShowScript(_G.tonumber(optionData.Params[1]), ActionFinishCallback)
    end
end

--- 播放一段对话之后关闭对话UI DialogueView
---@param optionData OptionData 对话选项数据
---@param callback fun() 行为完成之后的回调
function DialogueOptionAction.ShowDialogueScriptThenClose(optionData, callback)
    local isExist, view = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.DialogueView.Name)
    local function ActionFinishCallback()
        if callback then
            callback()
        end
        if view.View then
            --- 关闭对话UI DialogueView
            view.View:CloseView()
        end
        --_G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DialogueView.Name)
    end

    if not isExist then
        if _G.AppSetting.DEBUG then
            _G.LogError(_G.ConfigManager.ui_cfg.DialogueView.Name .. " not exist. ")
        end
        ActionFinishCallback()
    else
        view.View:ShowScript(_G.tonumber(optionData.Params[1]), ActionFinishCallback)
    end
end

--- 点击任务选项按钮
---@param optionData OptionData 对话选项数据
---@param callback fun() 行为完成之后的回调
function DialogueOptionAction.SelectTaskOption(optionData, callback)
    --- 调用任务相关接口 进行 接取/提交 操作
    if callback then
        callback()
    end
    --- 关闭对话UI DialogueView
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DialogueView.Name)
end

---播放一段对话 关闭窗口 不处理任务
---@param optionData OptionData 对话选项数据
---@param callback fun() 行为完成之后的回调
function DialogueOptionAction.CloseWindow(optionData, callback)
    local isExist, view = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.DialogueView.Name)

    ---将回调赋空 不处理任务
    view.View.FinishCallback = nil

    local function ActionFinishCallback()
        --- 关闭对话UI DialogueView
        if _G.IsNil(view) or _G.IsNil(view.View) then
            return
        end
        ---有可能 直接跳过退出了
        if view.View then
            --- 关闭对话UI DialogueView
            view.View:CloseView(true)
        end
        --_G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DialogueView.Name)
    end

    if not isExist then
        if _G.AppSetting.DEBUG then
            _G.LogError(_G.ConfigManager.ui_cfg.DialogueView.Name .. " not exist. ")
        end
        ActionFinishCallback()
    else
        view.View:ShowScript(_G.tonumber(optionData.Params[1]), ActionFinishCallback)
    end
end

---播放一段对话序列 完成任务
---@param optionData OptionData 对话选项数据
---@param callback fun() 行为完成之后的回调
function DialogueOptionAction.ShowDialogueCfg(optionData, callback)
    local isExist, view = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.DialogueView.Name)

    local t_fun = function()
        --- 关闭对话UI DialogueView
        if _G.IsNil(view) or _G.IsNil(view.View) then
            return
        end
        view.View:OnCreate(_G.tonumber(optionData.Params[1]), view.View.FinishCallback)
    end

    local parmaType = tonumber(optionData.Params[2])

    ---播放特效  { 对话id，1类型，ui_ef特效名，延迟时间}
    if parmaType == 1 then
        local delaytime = tonumber(optionData.Params[4])
        view.View:ShowItemImage({1, 2, optionData.Params[3]})
        if delaytime > 0 then
            _G.DelayDo(
                delaytime,
                function()
                    t_fun()
                end
            )
        else
            t_fun()
        end
    else
        t_fun()
    end
end

---播放一段对话序列 不完成任务
---@param optionData OptionData 对话选项数据
---@param callback fun() 行为完成之后的回调
function DialogueOptionAction.ShowDialogueCfgClose(optionData, callback)
    local isExist, view = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.DialogueView.Name)

    ---将回调赋空  不完成任务
    local nowFinishCallback = view.View.FinishCallback
    --- 关闭对话UI DialogueView
    view.View:OnCreate(_G.tonumber(optionData.Params[1]), nowFinishCallback)
end

---进入 Npc PVE 战斗
------@param optionData OptionData 对话选项数据
---@param callback fun() 行为完成之后的回调
function DialogueOptionAction.NpcPVEFight(optionData, callback)
    local View = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DialogueView.Name)
    if View ~= nil then
        View:CloseView(true)
    end
    if optionData.Params and #optionData.Params > 0 then
        _G.EventManager:GetInstance():StartEvent(_G.tonumber(optionData.Params[1]))
    end
end

------@param optionData OptionData 对话选项数据
---@param callback fun() 行为完成之后的回调
function DialogueOptionAction.PlayStory(optionData, callback)
    local nowStory = _G.StoryManager:GetInstance():GetNowStory()
    --- 先把当前剧情完成回调保存  并清除
    local storyCall = nil
    if nowStory ~= nil then
        if nowStory.IsStoryPlaying and nowStory.StoryPlayCompleteCB ~= nil then
            storyCall = nowStory.StoryPlayCompleteCB
            nowStory.StoryPlayCompleteCB = nil
        end
    end

    local isExist, view = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.DialogueView.Name)
    local function CloseView()
        if callback then
            callback()
        end
        if view.View then
            --- 关闭对话UI DialogueView
            view.View:CloseView()
        end
        --_G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DialogueView.Name)
    end
    --- 关闭对话UI DialogueView

    CloseView()
    _G.StoryManager:GetInstance():OnDialogueComplete(
        function()
            if nowStory ~= nil then
                if nowStory.IsStoryPlaying then
                    nowStory:Skip()
                end
            end
            --- 开始新剧情  并 设置之前的剧情回调
            _G.AutomaticPlayStory.PlayStoryByID(tonumber(optionData.Params[1]), storyCall)
        end
    )
end

---直接播放 最后的选项
---@param optionData OptionData 对话选项数据
---@param callback fun() 行为完成之后的回调
function DialogueOptionAction.PlayFinalOptions()
    local isExist, view = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.DialogueView.Name)

    ---保留当前对话的回调事件
    local Callfun = view.View.FinishCallback
    local dialogueCfgSid = view.View.DialogueCfgSid
    local TaskOptionData = view.View.TaskOptionData
    view.View.FinishCallback = nil
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DialogueView.Name)

    local function ActionFinishCallback()
        --完成本次对话中的对话的回调
        if Callfun ~= nil then
            Callfun()
        end
    end

    if not isExist then
    else
        ---@type Params_DialogueView
        local Params_DialogueView = {}
        Params_DialogueView.taskOptionData = TaskOptionData
        Params_DialogueView.isPlayFinalOptions = true

        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.DialogueView.Name,
            dialogueCfgSid,
            ActionFinishCallback,
            Params_DialogueView
        )
    end
end

---播放一段对话 然后开始战斗
---@param optionData OptionData 对话选项数据
---@param callback fun() 行为完成之后的回调
function DialogueOptionAction.DialogueCfgNpcPVEFight(optionData, callback)
    local isExist, view = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.DialogueView.Name)

    ---保留当前对话的回调事件
    local Callfun = view.View.FinishCallback

    local function ActionFinishCallback()
        if optionData.Params and #optionData.Params > 1 then
            _G.EventManager:GetInstance():StartEvent(_G.tonumber(optionData.Params[2]))
        end
        --完成本次对话中的对话的回调
        if Callfun ~= nil then
            Callfun()
        end
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DialogueView.Name)
    end

    if not isExist then
        if _G.AppSetting.DEBUG then
            _G.LogError(_G.ConfigManager.ui_cfg.DialogueView.Name .. " not exist. ")
        end
        ActionFinishCallback()
    else
        view.View:OnCreate(_G.tonumber(optionData.Params[1]), ActionFinishCallback)
    end
end
