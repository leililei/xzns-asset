    if lines[2] then
        local str = _G.LangUtil.GetLangPackValue(lines[2])
        local _ary = string.split(str, "#")
        local firstCount
        for i = 1, #_ary do
            local count = math.ceil(string.len(_ary[i]) / 30)
            firstCount = i > 1 and 30 or 27
            for j = 1, count do
                if count == 1 then
                    table.insert(line2, string.sub(_ary[i], 1, -1))
                else
                    if j == 1 then
                        table.insert(line2, string.sub(_ary[i], 1, firstCount))
                    elseif j == count then
                        table.insert(line2, string.sub(_ary[i], (firstCount + 1) + (j - 2) * 30, -1))
                    else
