--- 显示对话内容
---@param currentScript dialogue_script_cfg
---@param callback fun() 整段台词说完之后的回调
function DialogueView:CoShowContent(currentScript, callback)
    _G.coroutine.waitforendofframe()
    if self.isSkipDialogue == true and currentScript.Sid ~= self.ScriptSids[#self.ScriptSids] then
        ---如果开始跳过到最后一句了  忽略其他对话(玩家自动播放 且一段里有两句以上对话期间 点跳过  容易播放上次对话 (模型加载等其他延迟的原因))
        --("isSkipDialogue-----------------1")
        return
    end
    --("DialogueView:CoShowContent-->------- " .. currentScript.Sid)
    if currentScript.Lines == nil then
        if callback then
            callback()
        end

        if _G.AppSetting.DEBUG then
            _G.LogError("ShowContent lines nil.")
        end
    else
        -- 目前对话段落里面的第几句话
        local lineIndex = 1

        while lineIndex <= #currentScript.Lines and not self.SkippingAll do
            if self.isSkipDialogue == true and currentScript.Sid ~= self.ScriptSids[#self.ScriptSids] then
                ---如果开始跳过到最后一句了  忽略其他对话(玩家自动播放 且一段里有两句以上对话期间 点跳过  容易播放上次对话 (模型加载等其他延迟的原因))
                --("isSkipDialogue-----------------2")
                return
            end
            --("DialogueView:CoShowContent-->------- " .. currentScript.Sid .. " ---" .. lineIndex)

            ---对话音效  单个
            local acoustics = currentScript.acoustics[lineIndex]
            ---对话台词 单个
            local voice = currentScript.voice[lineIndex]

            if string.IsNullOrEmpty(acoustics) == false or string.IsNullOrEmpty(voice) == false then
                self:Audio_Stop_dialogue()
            end

            self.Audio.acoustics = acoustics
            self.Audio.voice = voice

            self.StopShowLine = nil

            --(" DialogueView:CoShowContent Sid:" .. currentScript.Sid)
            ---显示一行的对白
            self.StopShowLine = coroutine.start(
                    _G.handler(self, self.CoShowLineMgr),
                    currentScript,
                    lineIndex,
                    _G.handler(self, self.CallStopShowLine)
            )
            self:Audio_Play_dialogue()

            -- 最后一句
            if lineIndex == #currentScript.Lines then
                -- 如果是功能选项对话  有任务数据(必须有 #self.Options不准)  且没设置选项参数  则打开任务信息界面
                self:SetTaskInfo(
                        currentScript.Type1 == _G.DialogueEnum.DialogueType.btn and self.TaskOptionData ~= nil and
                                not (#self.Options > 0)
                )
            end

            --文字滚动和语音都结束了才进入下一段，语音判定有帧延迟，所以在前面和文字连起来做判定
            while (self.StopShowLine or self:Audio_CheckIsPlay_dialogue()) and not self.SkippingAll do
                if self.isSkipDialogue == true and currentScript.Sid ~= self.ScriptSids[#self.ScriptSids] then
                    ---如果开始跳过到最后一句了  忽略其他对话(玩家自动播放 且一段里有两句以上对话期间 点跳过  容易播放上次对话 (模型加载等其他延迟的原因))
                    --("isSkipDialogue-----------------3")
                    return
                end
                coroutine.yield()
            end

            lineIndex = lineIndex + 1
        end
    end
    self:ShowItemOptions(currentScript)
    if callback then
        callback()
    end
    --("ShowContent mCurScriptLinesFinished. ")
end

---@param currentScript dialogue_script_cfg_Item
function DialogueView:CoShowLineMgr(currentScript, lineIndex, callback)
    _G.coroutine.waitforendofframe()
    self:StopTextDoTween()

    local currentScriptType1 = currentScript.Type1
    if currentScriptType1 == _G.DialogueEnum.DialogueType.black then
        self:SetScriptRootGoTable(currentScript, 1)
        self:CoFadeShowLine(currentScript, lineIndex, callback)
    elseif currentScriptType1 == _G.DialogueEnum.DialogueType.letter then
        self:SetScriptRootGoTable(currentScript, 2)
        self:CoShowLine_letter(currentScript, lineIndex, callback)
    elseif currentScriptType1 == _G.DialogueEnum.DialogueType.nullShow then
        self:SetScriptRootGoTable(currentScript, 1)
        self:CoNullLine(currentScript, lineIndex, callback)
    else
        self:SetScriptRootGoTable(currentScript, 1)
        self:CoShowLine(currentScript, lineIndex, callback)
    end
end

---物品展示
---@param params dialogue_script_cfg_Item.imagePath
---@param  callback function 只有ui_ef才会回调
function DialogueView:ShowItemImage(params, callback)
    --  params= dialogue_script_cfg_Item.imagePath                                                                   UI_eff不填  默认用配置表生存时间
    --- {  是否显示0不显示/1显示） ，  类型（1image/2ui_ef）  ， image路径/ui_ef名字 ， 缩放（1） ，    坐标x（0）  ， 坐标y（0），延时（Image存在时间）  }
    local delImage = function()
        if _G.IsNil(self.obj_itemShowAnimator) then
            return
        end
        self.obj_itemShowAnimator:Play("a_DialogueItemShow_xiaoshi")

        self.go_table.aorrawimage_item.Alpha = 0
        self.Timer_DelImage = _G.TimerManager:GetInstance():GetTimer(
                0.31,
                self.Timer_DelImageFunc,
                self,
                true,
                false
        )
        self.Timer_DelImage:Start()
    end
    local delPrf = function()
        if not _G.IsNil(self.itemShow_Item) then
            _G.DestroyObject(self.itemShow_Item)
            self.itemShow_Item = nil
        end
    end

    if _G.IsNil(self.gameObject) then
        return
    end

    if params == nil then
        delImage()
        delPrf()
        return
    end

    local imagePath = params
    -- 是否显示
    local mIsShow = tonumber(imagePath[1]) == 1 and true or false
    -- 类型
    local type = tonumber(imagePath[2])

    local scale = tonumber(imagePath[4])
    if scale == nil then
        scale = 1
    end

    local x = tonumber(imagePath[5])
    if x == nil then
        x = 0
    end

    local y = tonumber(imagePath[6])
    if y == nil then
        y = 0
    end

    local delaytime = tonumber(imagePath[7])

    if type == 1 or type == 3 then
        -- 如果是image 或者是需要物品框的image
        local path = imagePath[3]
        if _G.string.IsNullOrEmpty(path) then
            if _G.AppSetting.DEBUG then
                _G.LogError(string.format("对话系统 dialogue_script sid:%s imagePath字段 [3]配置有误"))
            end
            return
        end

        if mIsShow then
            self.go_table.aorrawimage_item:LoadImage(
                    imagePath[3],
                    function(image)
                        if not _G.IsNil(image) then
                            self.go_table.obj_itemShow:SetActiveE(1)

                            image:SetNativeSize()

                            self.go_table.aorrawimage_item:SetLocalScale(scale, scale, scale)
                            image:SetAnchorPosition(x, y)
                            -- _G.DelayDo(
                            --     delaytime or 1,
                            --     function()
                            --         delImage()
                            --     end
                            -- )
                        end
                    end
            )
        else
            delImage()
        end
    elseif type == 2 then
        -- 如果是ui_effect
        delPrf()

        if mIsShow then
            local ui_eCfg = _G.ConfigManager.ui_effect_cfg[imagePath[3]]
            if _G.IsNil(ui_eCfg) then
                return
            end
            --- 防止跳过对话过快 界面已关闭
            if not _G.IsNil(self.go_table) then
                _G.UIUtils.LoadEffectByCfg(
                        ui_eCfg,
                        self.go_table.gameObject,
                        function(tran)
                            if not _G.IsNil(tran) then
                                self.itemShow_Item = tran
                                if x > 0 or y > 0 then
                                    tran:SetLocalPosition(x, y, 0)
                                end
                                self.itemShow_Item:SetLocalScale(scale, scale, scale)
                            end
                        end,
                        function()
                            delPrf()
                            if callback ~= nil then
                                callback()
                            end
                        end
                )
            end
        end
    end
end

function DialogueView:Timer_DelImageFunc()
    if not _G.IsNil(self.go_table) then
        self.go_table.aorrawimage_item:SetLocalScaleToOne()
        self.go_table.aorrawimage_item:SetAnchorPosition(0, 0)
        self.go_table.obj_itemShow:SetActiveE(0)
    end
