--- 打字显示单句台词
---@param currentScript dialogue_script_cfg
---@param lineIndex number 台词下标索引
---@param callback fun()
function DialogueView:CoShowLine(currentScript, lineIndex, callback)
    local function CallBackFun()
        if callback then
            callback()
            callback = nil
        end
    end

    --(" DialogueView:CoShowLine Sid:" .. currentScript.Sid)
    if self:IsDes() then
        return
    end
    local lines = currentScript.Lines[lineIndex]
    ---@type number 动画播放延迟
    local delayTime = currentScript.DelayTime[lineIndex]
    ---@type number[]
    local pauseTimes = currentScript.PauseTime[lineIndex]
    local posindex = currentScript.Position
    if posindex <= 0 then
        posindex = 1
    end
    if lines == nil then
        CallBackFun()
        return
    end
    self.ScriptRootGoTable.aortext_Content.text = ""

    --- 播放说话动作动画
    if delayTime == nil or delayTime <= 0 then
        delayTime = 0
    end

    local text = ""
    if currentScript.Type1 == _G.DialogueEnum.DialogueType.movie then
        text = _G.LangUtil.GetLangPackValue(currentScript.Name) .. ": "
    end
    local i = 1
    local pauseTime = (pauseTimes ~= nil and pauseTimes[i] ~= nil) and pauseTimes[i] or 0

    while i <= #lines do
        if self:IsDes() then
            return
        end
        local line = _G.LangUtil.GetLangPackValue(lines[i])

        --(" DialogueView:CoShowLine line:" .. line)
        self.clickStop = true
        self.ratio = self.ratio_speed1
        if self.SkippingAuto then
            self.ratio = self.ratio_speed2
        end

        local duration = self.ratio * _G.string.len(line)
        --- 可以尝试限制最短的打字时间 1.5 防止 字打完了 过渡动画还没播完
        duration = (duration < 0.01) and 0.01 or duration
        --("ShowContent duration " .. duration)
        text = text .. line
        --("duration", "<color=red>" .. duration .. "</color>")

        -- 防止不识别 \n换行  csv转义string \n
        text = string.gsub(
                text,
                "\\n",
                function(s)
                    return " \n"
                end
        )

        self.ContentTweener = self.ScriptRootGoTable.aortext_Content:DOText(text, duration)
        self.ContentTweener:SetEase(_G.CS.DG.Tweening.Ease.Linear)
        if self.ContentTweener then
            self.ContentTweener.onComplete = _G.handler(self, self.OnContentTweenerComplete)
        end
        --- 收到 Tweener 完成的回调时 会将 mContentTweener 置为 nil
        --- 根据 mContentTweener 是否为 nil 来表示 Tweener 是否在运行中
        local function tweenerPlaying()
            if self.ContentTweener then
                return true -- self.mContentTweener:IsPlaying()
            else
                return false
            end
        end
        -- _G.coroutine.waitwhile(tweenerPlaying)
        while tweenerPlaying() do
            coroutine.yield()
        end

        if self:IsDes() then
            return
        end
        -- self.mWaitForSeconds = _G.coroutine.waitforseconds(1.2)
        -- 台词说完过后的停顿
        pauseTime = (pauseTimes ~= nil and pauseTimes[i] ~= nil) and pauseTimes[i] or 1000

        -- 如果是自动播放状态 则设置停顿间隔
        if self.SkippingAuto then
            pauseTime = 1500
        end

        pauseTime = pauseTime / 1000
        ---本段对话的最后一句的最后一小节 换行的时候 需要播放默认动作动画
        -- pauseTime = (lineIndex == #currentScript.Lines and i == #lines) and 1.0 or pauseTime

        --("pauseTime", "<color=red>" .. pauseTime .. "</color>" .. text)

        --(" DialogueView:CoShowLine pauseTime:" .. pauseTime)
        if pauseTime > 0 then
            self.StopPauseBetweenLines = nil

            -- if _G.IsNil(self.ScriptRootGoTable.obj_anchor) == false and self.ScriptRootGoTable.isAnchorShow == true then
            --     _G.GameUtil.SetActiveByCondition(self.ScriptRootGoTable.obj_anchor, true)
            -- end
            self.StopPauseBetweenLines = coroutine.start(
                    _G.handler(self, self.CoDelay),
                    pauseTime,
                    _G.handler(self, self.CallStopPauseBetweenLines)
            )

            while (self.StopPauseBetweenLines and self.clickStop == true) and (not self.SkippingAll) do
                coroutine.yield()
            end
        end

        i = i + 1
    end
    --(" DialogueView:CoShowLine self:IsDes()  Sid:" .. currentScript.Sid)
    if self:IsDes() then
        return
    end
    local delCount = 0

    if delCount == 0 then
        self:ShowItemImage(currentScript.imagePath)
    end
