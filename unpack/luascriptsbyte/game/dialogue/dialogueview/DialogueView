---@param lineIndex number 台词下标索引
---@param callback fun()
function DialogueView:CoNullLine(currentScript, lineIndex, callback)
    local lines = currentScript.Lines[lineIndex]
    lines = _G.LangUtil.GetLangPackValue(lines)
    ---@type number[]
    local pauseTimes = currentScript.PauseTime[lineIndex]
    if lines == nil then
        if callback then
            callback()
        end
        return
    end

    self.clickStop = true

    -- self.mWaitForSeconds = _G.coroutine.waitforseconds(1.2)
    -- 台词说完过后的停顿
    local pauseTime = (pauseTimes ~= nil and pauseTimes[1] ~= nil) and pauseTimes[1] or 1000

    -- 如果是自动播放状态 则设置停顿间隔
    if self.SkippingAuto then
        pauseTime = 800
    end

    pauseTime = pauseTime / 1000
    ---本段对话的最后一句的最后一小节 换行的时候 需要播放默认动作动画
    -- pauseTime = (lineIndex == #currentScript.Lines and i == #lines) and 1.0 or pauseTime

    --("pauseTime", "<color=red>" .. pauseTime .. "</color>" .. text)

    if pauseTime > 0 then
        self.StopPauseBetweenLinesT = nil
        self.StopPauseBetweenLinesT = coroutine.start(
                _G.handler(self, self.CoDelay),
                pauseTime,
                function()
                    self.StopPauseBetweenLinesT = nil
                end
        )

        while (self.StopPauseBetweenLinesT) and (not self.SkippingAll) do
            --  and self.clickStop == true
            coroutine.yield()
        end
    end

    if callback then
        callback()
    end
end

--- 渐隐渐显 打印单句台词
---@param currentScript dialogue_script_cfg_Item
---@param lineIndex number 台词下标索引
---@param callback fun()
function DialogueView:CoFadeShowLine(currentScript, lineIndex, callback)
    if _G.IsNil(self.ScriptRootGoTable) or _G.IsNil(self.ScriptRootGoTable.aortext_Content) then
        return
    end
    local lines = currentScript.Lines[lineIndex]
    ---@type number[]
    local pauseTimes = currentScript.PauseTime[lineIndex]
    if lines == nil then
        if callback then
            callback()
        end
    end

    -- self.ScriptRootGoTable.aortext_Content.color = CS.UnityEngine.Color.gray

    local text = ""
    local i = 1

    local pauseTime = (pauseTimes ~= nil and pauseTimes[i] ~= nil) and pauseTimes[i] or 0

    while i <= #lines do
        ---防止界面关闭 仍再循环
        if self.ScriptRootGoTable == nil then
            return
        end

        local line = _G.LangUtil.GetLangPackValue(lines[i])
        self.clickStop = true
        self.ratio = self.ratio_speed1
        if self.SkippingAuto then
            self.ratio = self.ratio_speed2
        end

        local duration = self.ratio * _G.string.len(line)
        --- 可以尝试限制最短的打字时间 1.5 防止 字打完了 过渡动画还没播完
        duration = (duration < 0.01) and 0.01 or duration
        --("ShowContent duration " .. duration)
        text = text .. line
        --("duration", "<color=red>" .. duration .. "</color>")

        -- 防止不识别 \n换行  csv转义string \n
        text = string.gsub(
                text,
                "\\n",
                function(s)
                    return " \n"
                end
        )
        -- if i == 1 then
        -- self.ScriptRootGoTable.aortext_Content.color = Color.New(0, 0, 0, 0)
        -- else
        self.ContentTweenerFade = self.ScriptRootGoTable.aortext_Content:DOColor(Color.New(0, 0, 0, 0), 1)
        self.ContentTweenerFade:SetEase(_G.CS.DG.Tweening.Ease.Linear)
        if self.ContentTweenerFade then
            self.ContentTweenerFade.onComplete = _G.handler(self, self.OnContentTweenerCompleteFade)
        end
        --- 收到 Tweener 完成的回调时 会将 mContentTweener 置为 nil
        --- 根据 mContentTweener 是否为 nil 来表示 Tweener 是否在运行中
        local function tweenerPlayingFade()
            if self.ContentTweenerFade then
                return true -- self.mContentTweener:IsPlaying()
            else
                return false
            end
        end
        -- _G.coroutine.waitwhile(tweenerPlayingFade)
        while tweenerPlayingFade() do
            coroutine.yield()
        end

        if self:IsDes() then
            return
        end
        self.ScriptRootGoTable.aortext_Content.text = text
        self.ContentTweener = self.ScriptRootGoTable.aortext_Content:DOColor(Color.New(214 / 255, 214 / 255, 214 / 255, 214 / 255), 1)
        if self.ContentTweener then
            self.ContentTweener.onComplete = _G.handler(self, self.OnContentTweenerComplete)
        end
        local function tweenerPlaying()
            if self.ContentTweener then
                return true -- self.mContentTweener:IsPlaying()
            else
                return false
            end
        end
        -- _G.coroutine.waitwhile(tweenerPlaying)
        while tweenerPlaying() do
            coroutine.yield()
        end

        if self:IsDes() then
            return
        end
        -- self.mWaitForSeconds = _G.coroutine.waitforseconds(1.2)
        -- 台词说完过后的停顿
        pauseTime = (pauseTimes ~= nil and pauseTimes[i] ~= nil) and pauseTimes[i] or 1000

        -- 如果是自动播放状态 则设置停顿间隔
        if self.SkippingAuto then
            pauseTime = 800
        end

        pauseTime = pauseTime / 1000
        ---本段对话的最后一句的最后一小节 换行的时候 需要播放默认动作动画
        -- pauseTime = (lineIndex == #currentScript.Lines and i == #lines) and 1.0 or pauseTime

        --("pauseTime", "<color=red>" .. pauseTime .. "</color>" .. text)

        if pauseTime > 0 then
            self.StopPauseBetweenLines = nil

            self.StopPauseBetweenLines = coroutine.start(
                    _G.handler(self, self.CoDelay),
                    pauseTime,
                    _G.handler(self, self.CallStopPauseBetweenLines)
            )

            while (self.StopPauseBetweenLines and self.clickStop == true) and (not self.SkippingAll) do
                coroutine.yield()
            end
        end
        if self:IsDes() then
            return
        end
        ---如果最后一句话  则再 淡入消失
        if lineIndex == #currentScript.Lines then
            self.ContentTweenerFade = self.ScriptRootGoTable.aortext_Content:DOColor(Color.New(0, 0, 0, 0), 1)
            self.ContentTweenerFade:SetEase(_G.CS.DG.Tweening.Ease.Linear)
            if self.ContentTweenerFade then
                self.ContentTweenerFade.onComplete = _G.handler(self, self.OnContentTweenerCompleteFade)
            end

            -- _G.coroutine.waitwhile(tweenerPlayingFade)
            while tweenerPlayingFade() do
                coroutine.yield()
            end

            if self:IsDes() then
                return
            end
        end

        i = i + 1
    end

    if callback then
        callback()
    end
end

