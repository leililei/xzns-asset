                            self.ScriptRootGoTable_letter.aortext_name.text = _G.LangUtil.GetLangPackValue(lines[3])

                            local pauseTime = (pauseTimes ~= nil and pauseTimes[1] ~= nil) and pauseTimes[1] or 0
                            -- self.mWaitForSeconds = _G.coroutine.waitforseconds(1.2)
                            -- 台词说完过后的停顿
                            pauseTime = (pauseTimes ~= nil and pauseTimes[1] ~= nil) and pauseTimes[1] or 1000

                            -- 如果是自动播放状态 则设置停顿间隔
                            if self.SkippingAuto then
