--- 启动
---@param dialogueCfgSid number dialogue_cfg 配表里的 Sid
---@param finishCallback fun(dialogueCfgSid:string) 对话完成回调
---@param Data Params_DialogueView
function DialogueView:OnCreate(dialogueCfgSid, finishCallback, Data)
    self.isPlayFinalOptions = nil
    self.DialogueCfgSid = dialogueCfgSid
    self.TaskOptionData = nil
    self.FinishCallback = finishCallback
    self.isShowBtn = true

    if Data then
        self.isShowBtn = Data.isShowBtn
        self.TaskOptionData = Data.taskOptionData
        self.isPlayFinalOptions = Data.isPlayFinalOptions
    end

    --- 初始化成员变量 可能会多次初始
    self:InitData()
    self:CacheComponent()

    --- 当前是否有显示主界面  防止对话完毕 擅自打开
    if self.isStartShowMain == nil then
        local isActive = _G.UIManager:GetInstance():IsActiveWindow(_G.ConfigManager.ui_cfg.MainView.Name)
        if isActive == true then
            _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
            self.isStartShowMain = true
        end
    end

    -- local cam_3d = _G.GraphicsManager.Instance:GetSubCamera("3DUICam")
    -- if not _G.IsNil(cam_3d) then
    --     --- 对话中不显示血条  免得层级错误
    --     cam_3d:SetActiveE(0)
    -- end

    ---@type dialogue_cfg_Item
    local dialogue = _G.ConfigManager.dialogue_cfg[dialogueCfgSid]

    if (not dialogue) and (not self.TaskOptionData) then
        --("dialogue_cfg Not Found. and TaskOptionData nil. " .. dialogueCfgSid)
        self:CloseView()
        return
    end

    self.ScriptSids = dialogue.Scripts
    if self.isPlayFinalOptions == true then
        if #self.ScriptSids > 0 then
            self.ScriptSids = { self.ScriptSids[#self.ScriptSids] }
        else
            if _G.AppSetting.DEBUG then
                _G.LogError(" 对话 序列有误 dialogueCfgSid:" .. tostring(dialogueCfgSid))
            end
            self:Close()
            return
        end
    end

    self:SetIsEnterWorld()
    self:ShowOptions(-1)
    -- self:SetAtuto(true)
    self.StopAction = nil
    self.StopAction = coroutine.start(_G.handler(self, self.CoAction), self.ScriptSids, _G.handler(self, self.CallStopAction))

    self.go_table.aorbtn_close_mask:SetActiveE(1)
end

--- 按钮单击事件
---@param go CS.UnityEngine.GameObject
function DialogueView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_close_mask" then
        --- 玩家主动点击对话 就取消 自动播放
        -- self:SetAtuto(false)
        self:SkipCurrentScriptLine()
    elseif name == "@_aorbtn_SkipDialogue" then
        -- if self.isSkipDialogue == true then
        --     ---防止 界面加载慢了 按钮未隐藏
        --     self:ShowAorbtn(false)
        --     return
        -- end
        -- if self:GetIsOptionDialogue() == false then
        --     self:SkipAllScripts()
        --     return
        -- end
        -- self:ShowAorbtn(false)
        -- self:SetAtuto(false, true)
        -- self:CallStopPauseBetweenLines()
        -- self:StopAllCoroutine(true)
        -- self.SkippingAuto = true
        --- 如果跳到了最后一句  不能再操作

        if self.isPlayFinalOptions == true then
            return
        end
        self:ShowOptions(-1)
        self.isPlayFinalOptions = true

        local finalid = self.ScriptSids[#self.ScriptSids]
        local finalcfg = _G.ConfigManager.dialogue_script_cfg[finalid]
        if _G.IsNil(finalcfg) then
            if finalid ~= nil and finalid > 100 then
                _G.LogError(
                        "DialogueView aorbtn_SkipDialogue " .. tostring(self.ScriptSids) .. " " .. tostring(finalid)
                )
            end
            self.CloseType = 1
            self:Close()
            return
        end
        local isOptions = finalcfg.Type1 == _G.DialogueEnum.DialogueType.btn
        if isOptions == false then
            self.CloseType = 1
            self:Close()
            return
        end

        DialogueOptionAction["PlayFinalOptions"]()
    elseif name == "@_aorbtn_AutoDialogue" then
        -- self:StopAllCoroutine()
        self:SetAtuto()
        self:SkipCurrentScriptLine()
    elseif name == "@_aorbtn_task" then
        if self.isClicktask then
            return
        end
        self.isClicktask = true

        local taskoFun = function()
            self.FinishCallback = self.taskTempCall
            self.taskTempCall = nil
            self:SkipAllScripts()
        end

        if self.TaskOptionData.state == _G.TaskEnum.ETaskState.Completed then
            _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.fx_c_renwu_cao,
                    self.transform,
                    nil,
                    function()
                        taskoFun()
                    end
            )
        else
            taskoFun()
        end
    end
end

---@param 变量名 boolean nil 当前状态取反
---@param isNotPlayer boolean true程序操作 false玩家操作 (用于判断是否要保存状态)
function DialogueView:SetAtuto(isAuto, isNotPlayer)
    if _G.IsNil(self.go_table) then
        return
    end
    local isAuto = isAuto
    if isAuto == nil then
        isAuto = not self.SkippingAuto
    end
    if self.Type == _G.DialogueEnum.DialogueType.movie then
        isNotPlayer = true
        isAuto = true
    end

    if isAuto == false then
        -- 镇魂街ZHJ-4854 【主任务】剧情系统ZHJ-5809
        -- 【客户端】修改自动播放图标
        -- 去掉灰色的自动播放按钮
        -- on和off都用白色的自动播放按钮
        -- "ui_ty_btn_zidongbof_off"

        -- self.go_table.aortext_AutoDialogue.text = "自动播放"
        if self.effAutoAni ~= nil then
            self.effAutoAni.speed = 0
        end
        self.SkippingAuto = false
    else
        -- self.go_table.aortext_AutoDialogue.text = "自动播放中"
        if self.effAutoAni ~= nil then
            self.effAutoAni.speed = 1
        end
        self.SkippingAuto = true
    end
    if not isNotPlayer then
        self:SetPlayerPrefsIsAuto(isAuto)
    end
end

function DialogueView:SetPlayerPrefsIsAuto(isAuto)
    _G.PlayerPrefsManager.SetInt(self.Key_isAuto, isAuto and 1 or 0)
end

