    self.taskItemList = {}

    local len = #task.TaskCfg.award
    for i = 1, len do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
                task.TaskCfg.award[i],
                self.go_table.obj_Node,
                function(item)
                    if item ~= nil then
                        item.transform:SetParentE(go_taskTable.obj_Content)
                        item.transform:SetLocalScaleXYZ(0.8)
                        item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                        table.insert(self.taskItemList, item)
                    end
                end
        )
    end
    self.taskTempCall = self.FinishCallback
    self.FinishCallback = nil

    _G.Events:GetInstance():Broadcast(_G.eDialogueEvent.ShowTaskinfo, task.TaskID)

    self.go_table.aorbtn_close_mask:SetActiveE(0)
end

-- endregion

function DialogueView:GetIsOptionDialogue()
    if self.isOptionDialogue == nil then
        local sid = self.ScriptSids[#self.ScriptSids]

        local scriptCfg = _G.ConfigManager.dialogue_script_cfg[sid]
        if _G.IsNil(scriptCfg) == false and scriptCfg.Type1 == 1 then
            ---只要最后 是选项 就不能跳过
            --  and self.TaskOptionData ~= nil
            self.isOptionDialogue = true
        else
            self.isOptionDialogue = false
        end
    end

    return self.isOptionDialogue
end

---当前脚本是否还存在  true不存在
function DialogueView:IsDes()
    return _G.IsNil(self.ScriptRootGoTable)
end

function DialogueView:Audio_Play_dialogue()
    if self.Audio.acoustics ~= nil then
        _G.AudioManager.Dialogue_PlayPath(self.Audio.acoustics)
    end
    if self.Audio.voice ~= nil then
        _G.AudioManager.Dialogue_PlayPath(self.Audio.voice)
    end
end

function DialogueView:Audio_Stop_dialogue()
    if self.Audio.acoustics ~= nil then
        _G.AudioManager.Dialogue_StopPath(self.Audio.acoustics)
        self.Audio.acoustics = nil
    end
    if self.Audio.voice ~= nil then
        _G.AudioManager.Dialogue_StopPath(self.Audio.voice)
        self.Audio.voice = nil
    end
end

function DialogueView:Audio_CheckIsPlay_dialogue()
    return _G.AudioManager.CheckIsPlay(self.Audio.voice)
end

function DialogueView:SetIsEnterWorld()
    if self.isEnterWorld == nil then
        ---是否在世界场景里面  afk放置对战场景是临时场景(不能通过World操控显示隐藏)
        self.isEnterWorld = _G.StoryManager:GetInstance():IsDialogueEnterWorld()
    end
end

function DialogueView:SetNil()
    self.effAutoAni = nil
    self.CloseType = nil
    self.obj_itemShowAnimator = nil
    self.DialogueCfgSid = nil
    self.TaskOptionData = nil
    self.ScriptSids = nil
    self.StopAction = nil
    self.FinishCallback = nil
    self.taskTempCall = nil
    self.Role3DShowsLua = nil
    self.FightDic = nil
    self.BgDic = nil
    self.ScriptRootGoTable = nil
    self.ScriptRootGoTable_letter = nil
    self.currentScript = nil
    self.RoleRes = nil
    self.Options = nil
    self.isPlayFinalOptions = nil
    if self.timerr_Auto ~= nil then
        self.timerr_Auto:Stop()
        self.timerr_Auto = nil
    end

    if not _G.IsNil(self.itemShow_Item) then
        _G.DestroyObject(self.itemShow_Item)
        self.itemShow_Item = nil
    end
    if table.isEmptyOrNil(self.taskItemList) == false then
        for i = #self.taskItemList, 1, -1 do
            local item = self.taskItemList[i]
            item.transform:SetLocalScaleXYZ(1)
            require("ItemViewBase").Despawn(item)
        end

        self.taskItemList = nil
    end

    if self.Timer_DelImage then
        self.Timer_DelImage:Stop()
        self.Timer_DelImage = nil
    end

    self:Audio_Stop_dialogue()
end

return DialogueView

