--- 缓存需要使用到的组件
function DialogueView:CacheComponent()
    if not table.isEmptyOrNil(self.ScriptRootGoTable) then
        return
    end
    --- ScriptRoot go_table
    ---@type DialogueView._obj_ScriptRoot_GoTable
    self.ScriptRootGoTable = {}

    ---@type DialogueView._obj_ScriptRoot_letter_GoTable
    self.ScriptRootGoTable_letter = {}

    self.ScriptRootGoTable = _G.GetAutoGoTable(self.go_table.obj_ScriptRoot)
    --- 左右两个位置显示的模型对应的位置
    self.roleModelList = {
        [_G.DialogueEnum.PosIndex.left] = self.ScriptRootGoTable.obj_modelLeft,
        [_G.DialogueEnum.PosIndex.mid] = self.ScriptRootGoTable.obj_modelMiddle,
        [_G.DialogueEnum.PosIndex.right] = self.ScriptRootGoTable.obj_modelRight
    }
    self.ScriptRootGoTable_letter = _G.GetAutoGoTable(self.go_table.obj_ScriptRoot_letter)
    if self.ScriptRootGoTable == nil then
        self.ScriptRootGoTable = -1

        if _G.AppSetting.DEBUG then
            _G.LogError("ScriptRootGoTable nil. ")
        end
    end
end

--- 切换为 当前要用的组件 1默认  2 _letter
---@param currentScript dialogue_script_cfg_Item
function DialogueView:SetScriptRootGoTable(currentScript, index)
    if self:IsDes() then
        return
    end

    if currentScript.Type1 == _G.DialogueEnum.DialogueType.nullShow then
        _G.GameUtil.SetActiveByCondition(self.ScriptRootGoTable.gameObject, false)
    else
        _G.GameUtil.SetActiveByCondition(self.ScriptRootGoTable.gameObject, index == 1)
    end

    _G.GameUtil.SetActiveByCondition(self.ScriptRootGoTable_letter.gameObject, index == 2)
end

--- 开始表演
---@param scriptSids number[] dialogue_script_cfg 配表里面 Sid 的数组
---@param callback fun() 完成回调
function DialogueView:CoAction(scriptSids, callback)
    _G.coroutine.waitforendofframe()
    ---防止还未获取到组件 就开始播放
    while self.ScriptRootGoTable == nil do
        if self.ScriptRootGoTable == -1 then
            return
        end
        coroutine.yield()
    end

    -- self.StopPreLoadRoleModels = nil
    --("preload begin " .. tostring(Time.unity_time.time))
    -- if scriptSids.Model ~= nil then
    --     self.StopPreLoadRoleModels =
    --         coroutine.start(
    --             _G.handler(self, self.CoPreLoadRoleModels),
    --             scriptSids,
    --             _G.handler(self, self.CallStopPreLoadRoleModels)
    --         )

    --     while self.PreLoadModelNum <= 0 and not self.SkippingAll do
    --         coroutine.yield()
    --     end
    -- end
    --("preload end " .. tostring(Time.unity_time.time))

    self.StopShowAllScripts = nil
    self.StopShowAllScripts = coroutine.start(
            _G.handler(self, self.CoShowAllScripts),
            scriptSids,
            _G.handler(self, self.CallStopShowAllScripts)
    )

    while self.StopShowAllScripts and not self.SkippingAll do
        coroutine.yield()
    end

    _G.StoryManager:GetInstance():SetPlayerPrefs_PlayDialogueid(self.DialogueCfgSid)
    if callback then
        callback()
    end

    --- 有可能已经被关闭 只是等待后
    if self:IsDes() then
        return
    else
        -- 普通对话完成之后 非跳过对话的情况下  没有任务信息 直接关闭对话
        if not (#self.Options > 0) and not self.SkippingAll and self:GetIsOptionDialogue() == false then
            self:CloseView()
        end
    end
end

--- 所有角色依次表演
---@param scriptSids number[] dialogue_script_cfg 配表里面 Sid 的数组
---@param callback fun() 所有角色表演完成的回调
function DialogueView:CoShowAllScripts(scriptSids, callback)
    _G.coroutine.waitforendofframe()
    -- 目前对话进行到第几个段落
    local scriptIndex = 1
    while scriptIndex <= #scriptSids and not self.SkippingAll do
        local scriptSid = scriptSids[scriptIndex]
        self.StopShowScript = nil
        if self.model then
            require("CardInfoManager").DelRole(self.model, _G.ePoolType.Temporary)
            self.model = nil
        end

        -- 黑幕 过度时间 10以内
        local blacktypeid = _G.Mathf.Abs(scriptSid)
        local showTime = 0
        if scriptSid <= 20 then
            showTime = blacktypeid % 10
        end
        -- 黑屏过度 10以内
        if blacktypeid <= 10 and blacktypeid ~= 0 then
            local mcolor = _G.Color.black
            if scriptSid > 0 then
                self.StopShowScript = function()
                    -- body
                end
                self.StopShowScript = self:ShowBlackCurtain(1, showTime, mcolor, _G.handler(self, self.CallStopShowScript))
            else
                self:ShowBlackCurtain(0, showTime, mcolor)
            end
        elseif blacktypeid <= 20 and blacktypeid ~= 0 then
            -- 白屏过度 20以内
            local mcolor = _G.Color.white

            if scriptSid > 0 then
                self.StopShowScript = function()
                    -- body
                end
                self.StopShowScript = self:ShowBlackCurtain(1, showTime, mcolor, _G.handler(self, self.CallStopShowScript))
            else
                self:ShowBlackCurtain(0, showTime, mcolor)
            end
        else
            -- 各个角色依次进行对话表演
            self.StopShowScript = self:ShowScript(scriptSid, _G.handler(self, self.CallStopShowScript))
        end

        while self.StopShowScript and not self.SkippingAll do
            coroutine.yield()
        end

        scriptIndex = scriptIndex + 1
        if self.isSkipDialogue == true and scriptIndex < #scriptSids then
            scriptIndex = #scriptSids
        elseif self.isSkipDialogue == true then
            self.isSkipDialogue = false
        end
    end
    --("ShowAllScripts end.")

    if callback then
        callback()
    end
end

