                                    coroutine.yield()
                                end
                            end

                            if callback then
                                callback()
                            end
                        end
                )
            end
    )
end

--- 本 View 公用的延时执行 Callback 的接口 注意时序 两次使用的时间有交叉的话 会出现问题
--- TODO 需要抽离出来 并支持打断
---@param delayTime number 延时时间
---@param callback fun() 完成回调
function DialogueView:CoDelay(delayTime, callback)
    --("DelayCoroutine delayTime ", "<color=red>" .. ">>>" .. _G.tostring(delayTime) .. "</color>")
    --- 停顿时间的计时器
    ---@type number
    local delayTimmer = 0
    while delayTimmer < delayTime and not self.SkippingAll do
        coroutine.yield()
        delayTimmer = delayTimmer + _G.Time.unity_time.deltaTime
    end
    if callback then
        callback()
    end
end

