--- 从配置中解析组装对话选项数据
---@param script dialogue_script_cfg_Item
function DialogueView:ParseOption(script)
    self.Options = {}

    if not script or script.type == 0 then
    else
        local len = #table.keys(script.Option_Desc)
        for i = 1, len, 1 do
            --- 正常显示该选项
            local isAdd = true
            --- 是否是隐藏选项
            local ishide = false

            local conditionType = tonumber(script.Option_Desc[i][2])
            local conditionParams = tonumber(script.Option_Desc[i][3])
            --- 如果有解锁条件
            if conditionType ~= nil then
                ishide = true
                -- 不满足  则不显示
                if not _G.GlobalConditionManager.CheckCondition(conditionType, conditionParams) then
                    isAdd = false
                else
                    ---  满足
                end
            end

            if isAdd == true then
                ---@type OptionData
                local option = {}
                option.Icon = script.Option_Icon[i]
                option.Desc = _G.LangUtil.GetLangPackValue(script.Option_Desc[i][1])
                option.Action = script.Option_Action[i][1]
                option.Params = script.Option_Action_Params[i]
                option.ishide = ishide or false

                _G.table.insert(self.Options, option)
            end
        end
    end
end

