--- 播放一段配置在 dialogue_script_cfg 表里面的对话 协程
---@param scriptSid number DialogueScriptCfg配表里的 Sid
---@param callback fun() 对话播放完成之后的回调
function DialogueView:CoShowScript(scriptSid, callback)
    _G.coroutine.waitforendofframe()
    --("CurrentScriptId " .. scriptSid)
    ---@type dialogue_script_cfg
    local currentScript = _G.ConfigManager.dialogue_script_cfg[scriptSid]
    if currentScript == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("currentScript nil. scriptSid " .. scriptSid)
        end
        if callback then
            callback()
        end
        return
    end
    ---@type dialogue_script_cfg_Item
    self.currentScript = currentScript

    --("DialogueView:CoShowScript--------- " .. scriptSid)
    local name = _G.LangUtil.GetLangPackValue(currentScript.Name)
    local type = currentScript.Type1
    self.StopShowRolesDelay = nil

    -- 防止 角色展示延迟事件
    self.StopShowRolesDelay = function()
        -- body
    end

    self:ShowRoles(currentScript)

    while self.StopShowRolesDelay and not self.SkippingAll do
        coroutine.yield()
        if self.isSkipDialogue == true then
            break
        end
    end

    self:ShowIconAndName(currentScript, name)
    self:ParseOption(currentScript)
    local pngPath = currentScript.Option_Icon[1]
    if pngPath then
        _G.ResourcesManager:GetInstance():LoadTexture(
                pngPath,
                function(texture, resRef)
                    if self:IsDes() then
                        if resRef ~= nil then
                            resRef:Release()
                        end
                        return
                    end
                    self.PlayPngResRef = resRef
                    -- local StoryManager = _G.StoryManager:GetInstance()
                    -- if StoryManager.isDialogueRootTranDicInit then
                    --     StoryManager:RestorCameraFov()
                    --     _G.GameUtil.SetActiveByCondition(StoryManager.DialogueRootTranDic.BgDic.FullScreen, true)
                    --     StoryManager.DialogueRootTranDic.BgDic.StoryFullScreenBG:Init(texture)
                    --     StoryManager:ShowDialoguseCamera()
                    -- end
                end,
                self
        )
    end

    self.StopShowContent = nil
    self.StopShowContent = coroutine.start(_G.handler(self, self.CoShowContent), currentScript, _G.handler(self, self.CallStopShowContent))
    self:ShowOptions(type)

    while self.StopShowContent and not self.SkippingAll do
        coroutine.yield()
    end

    if callback then
        callback()
    end
    --("Showcript end.")
end

--- 显示角色 3D 模型
---@param scriptCfg dialogue_script_cfg_Item
function DialogueView:ShowRoles(scriptCfg)
    if self:IsDes() or _G.string.IsNullOrEmpty(scriptCfg.Model) then
        self:CallStopShowRolesDelay()
        return
    end
    local isLoad = true
    if _G.AppSetting.IsXzns then
        isLoad = not GameUtil.IsHeXieHide()
    end
    if isLoad then
        require("CardInfoManager").GetRole(
                scriptCfg.Model,
                _G.ePoolType.Temporary,
                self.roleModelList[scriptCfg.Position],
                _G.RoleEffTypeEnum.Dialogue,
                function(trans, path)
                    if trans then
                        self.model = trans
                    end
                    local argument = scriptCfg.argument or {}
                    if argument[1] then
                        local x, y = table.unpack(argument[1])
                        x = x or 1
                        y = y or x
                        trans:SetLocalScale(x, y, 1)
                    end
                    if argument[2] then
                        trans:SetLocalPosition(argument[2][1] or 0, argument[2][2] or 0, argument[2][3] or 0)
                    end
                    self:CallStopShowRolesDelay()
                    if _G.AppSetting.IsXzns then
                        local cardCfg = _G.ConfigManager.card_cfg
                        local id = 0
                        for _, v in pairs(cardCfg) do
                            if v.ModelPathHi == scriptCfg.Model then
                                id = v.id
                            end
                        end
                        if id ~= 0 then
                            local spineCfg = _G.ConfigManager.card_show_cfg[id] or _G.ConfigManager.skin_cfg[id]
                            local idle = spineCfg.display_idle[1]
                            _G.GameUtil.SetCardUiSpineAnimation(trans, idle, true)
                        else
                            _G.GameUtil.SetCardUiSpineAnimation(trans, "idle", true)
                        end
                        _G.GameUtil.SetUiHeXieMask(self.ScriptRootGoTable)
                    end
                end
        )
    else
        self:CallStopShowRolesDelay()
    end
end

--- 更新角色站位
--- 第一个出场的角色默认站中央，第二个出场的角色位置根据自身配置的站位决定
--- 第二个角色出场时，已经在场上的角色需要移动到自身配置的站位位置
---@param scriptCfg dialogue_script_cfg_Item
---@return  boolean 是否需要 DOLocalMoveX
function DialogueView:UpdateRolePosition(scriptCfg)
    if self:IsDes() then
        return
    end
    if scriptCfg.Position == 0 then
        if self.RoleRes[0] == "" and self.RoleRes[1] ~= "" then
            self.go_table.obj_Dialogue3DShow_0:SetLocalPosition(-480, 0, 0)

            self.go_table.obj_Dialogue3DShow_1:DOLocalMoveX(480, COMMON_TIME)
            return true
        end
    else
        if self.RoleRes[1] == "" and self.RoleRes[0] ~= "" then
            self.go_table.obj_Dialogue3DShow_1:SetLocalPosition(480, 0, 0)

            self.go_table.obj_Dialogue3DShow_0:DOLocalMoveX(-480, COMMON_TIME)
            return true
        end
    end
    return false
end

