---@class DialogueSummary : Component	中文描述
local DialogueSummary = _G.BaseClass("DialogueSummary", _G.Component)

-- local CS = _G.CS
-- local typeof = _G.typeof

---创建对象时,入口构造函数
---@param summary string 对话概要
---@param callback fun() 跳过按钮点击后的回调
function DialogueSummary:OnCreate(go_table, summary, callback)
    self.go_table = go_table
    self.Summary = summary
    self.Callback = callback

    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    self:ShowSummary()
end

function DialogueSummary:Dispose()
    self.go_table = nil
end

---销毁对象时,析构函数
function DialogueSummary:OnDestroy()
end

function DialogueSummary:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_Skip" or name == "@_aorbtn_btnClose" then
        if self.Callback then
            self.Callback()
        end
    end
end

function DialogueSummary:ShowSummary()
    if not string.IsNullOrEmpty(self.Summary) then
        self.go_table.aortext_Dialogue_Summary.text = self.Summary
    end
end

return DialogueSummary
