---@class WorldMapView : UIBaseView	中文描述
---@field public go_table WorldMapView_GoTable GoTable
local WorldMapView = _G.BaseClass("WorldMapView", _G.UIBaseView)
--_G.WorldMapView = WorldMapView

local CS = _G.CS
local typeof = _G.typeof

function WorldMapView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function WorldMapView:OnCreate()
    self.chooseObj = {
        self.go_table.obj_choose1,
        self.go_table.obj_choose2,
        self.go_table.obj_choose3,
        self.go_table.obj_choose4,
        self.go_table.obj_choose5,
        self.go_table.obj_choose6
    }
    self.itemTrans = {
        self.go_table.trans_1,
        self.go_table.trans_2,
        self.go_table.trans_3,
        self.go_table.trans_4,
        self.go_table.trans_5,
        self.go_table.trans_6
    }
    self:Show()
end
local btnFunc = {
    ["@_aorbtn_guild"] = function(self)
    end,
    ["@_aorbtn_CloseView"] = function(self)
        self:Close()
    end,
    ["@_aorbtn_1"] = function(self)
        self:ChangeWorld(1)
    end,
    ["@_aorbtn_2"] = function(self)
        self:ChangeWorld(2)
    end,
    ["@_aorbtn_3"] = function(self)
        self:ChangeWorld(3)
    end,
    ["@_aorbtn_4"] = function(self)
        self:ChangeWorld(4)
    end,
    ["@_aorbtn_5"] = function(self)
        self:ChangeWorld(5)
    end,
    ["@_aorbtn_6"] = function(self)
        self:ChangeWorld(6)
    end
}
---按钮点击事件在这里派发
function WorldMapView:OnClickBtn(go)
    local name = go:GetName()
    if btnFunc[name] then
        btnFunc[name](self)
    end
end
function WorldMapView:ChangeWorld(index)
    require("WorldMapController"):GetInstance():ChangeWorld(index)
end
function WorldMapView:Show()
    self.go_table.scrollrect_scroll:StopMovement()
    local curIndex = require("WorldMapController"):GetInstance():GetCurIndex()
    self.chooseObj[curIndex]:SetActiveE(1)
    -- self:CalculatePos(curIndex)
end
function WorldMapView:CalculatePos(index)
    local x, y = self.itemTrans[index]:GetAnchorPosition()
    local itempos = {x = x, y = y}
    x, y = self.go_table.trans_Content:GetAnchorPosition()
    local pos = {x = x, y = y}
    x, y = self.go_table.trans_Content:GetRectTransformSizeDelta()
    local width = {x = x, y = y}
    pos.x = -(width / 2 + itempos.x)
    self.go_table.trans_Content:SetAnchorPosition(pos.x, pos.y)
end

return WorldMapView
