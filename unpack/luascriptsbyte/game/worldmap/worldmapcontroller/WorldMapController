---@class WorldMapController : Singleton	中文描述
local WorldMapController = _G.BaseClass("WorldMapController", _G.Singleton)

---@return WorldMapController WorldMapController
function WorldMapController:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function WorldMapController:__init()
    self.sceneSidIndex = {}
    for key, value in pairs(_G.ConfigManager.scene_world_cfg) do
        self.sceneSidIndex[value.rank] = key
    end
end

---销毁对象时,析构函数
function WorldMapController:Dispose()
end

--region对外接口
---获取当前所在场景序列号
---@return number 场景序列号
function WorldMapController:GetCurIndex()
    local sceneid = _G.PlayerModel:GetInstance():GetCurCitySid()
    local cfg = _G.ConfigManager.scene_world_cfg[sceneid]
    return cfg and cfg.rank or 1
end
---切换场景
---@param index number 场景序列号
---@return boolean 是否切换成功
function WorldMapController:ChangeWorld(index)
    if not self.sceneSidIndex[index] then
        return false
    end
    if self.sceneSidIndex[index] == _G.PlayerModel:GetInstance():GetCurCitySid() then
        return false
    end
    if self.sceneSidIndex[index] == 0 then
        return false
    end
    local cfg = _G.ConfigManager.scene_world_cfg[self.sceneSidIndex[index]]
    local param = nil
    for i = 1, #cfg.condition do
        param = _G.DeepCopyCfgTable(cfg.condition[i])
        _G.table.remove(param, 1)
        local result, tipsid, content = _G.GlobalConditionManager.CheckMainEventCondition(cfg.condition[i][1], param)
        if not result then
            _G.PopWindowManager:GetInstance():ShowAllTips(tipsid, content)
            return false
        end
    end
    _G.WorldManager:GetInstance():SwitchScene(cfg.id)
    return true
end
---获取是否在公会
---@return boolean 是否在公会
function WorldMapController:GetGuild()
    return require("SociatyManager"):GetInstance():HasSociaty()
end
---获取当前所在世界配置
---@return 变量类型 中文描述
function WorldMapController:GetCurWorldCfg()
    return _G.ConfigManager.scene_world_cfg[self:GetCurIndex()]
end
---去公会
function WorldMapController:GotoGuild()
end
--endregion

return WorldMapController
