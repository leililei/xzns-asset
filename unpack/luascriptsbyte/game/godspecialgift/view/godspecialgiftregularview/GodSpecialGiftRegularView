function GodSpecialGiftRegularView:OnClick_item(itemGoTable, isOn, data)
    if data.price_id > 0 then
        require("MallManager"):GetInstance():BuyActiveGift(data.price_id, nil, data.id)
    else
        require("MallNet"):GetInstance():BuyItem(
            data.id,
            1,
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                --获取奖励
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)

                --更新礼包状态
                local count = MallManager:GetInstance():GetItemBuyTimes(data.id, data.type_reset)
                MallManager:GetInstance():SetItemBuyTimes(data.id, data.type_reset, count + 1)

                self:UpdateView(true)
                --刷新降神特惠礼包红点
                require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GiftofGod.id)
            end
        )
    end
end

function GodSpecialGiftRegularView:OnClickBtn(go, isOn, viewName)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:CloseView()
    elseif name == "@_aorbtn_zhaomu" then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DrawView.Name)
        if not view then
            self:CloseView()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DrawView.Name, 1, nil, 4)
        end
    elseif name == "@_aorbtn_guanbi" then
        self:CloseView()
    end
end

function GodSpecialGiftRegularView:OnMallCashListener()
    self:UpdateView(true)
end

function GodSpecialGiftRegularView:EscClose()
    self:CloseView()
end

function GodSpecialGiftRegularView:CloseView()
    self:Close()
end

function GodSpecialGiftRegularView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    self:CloseView()
end

return GodSpecialGiftRegularView
