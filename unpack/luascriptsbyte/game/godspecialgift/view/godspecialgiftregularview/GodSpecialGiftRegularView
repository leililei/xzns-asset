---@class GodSpecialGiftRegularView : UIBaseView	中文描述
local GodSpecialGiftRegularView = _G.BaseClass("GodSpecialGiftRegularView", _G.UIBaseView)
local DrawModel = require("DrawModel")
local MallManager = require("MallManager")
function GodSpecialGiftRegularView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "GodSpecialGiftRegular", _G.TimeUtil.GetServerUnixTime())
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GiftofGod.id)
end

function GodSpecialGiftRegularView:OnCreate()
    --_G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_GodSpecialGiftView_title, self.go_table.obj_Title)
    self.go_table.aortext_time.text = _G.GetLangPackValue(90000011174)
    self.go_table.aorbtn_zhaomu:SetActiveE(0)
    self:UpdateView()
end

function GodSpecialGiftRegularView:UpdateView(updateFlag)
    self.infocfgs = _G.ConfigManager.discrete_cfg[104313][1]
    --策划说第一个礼包有特殊框体
    self.infocfgsTop = { self.infocfgs[1] }
    self.infocfgsDown = {}
    for i = 2, #self.infocfgs do
        _G.table.insert(self.infocfgsDown, self.infocfgs[i])
    end

    if updateFlag then
        self.go_table.scrollloopvectical_items:UpdateAllItem()
        self.go_table.scrollloopvectical_top:UpdateAllItem()
    else
        self.go_table.scrollloopvectical_items:InitItemData(#self.infocfgsDown, _G.handler(self, self.RefreshList))
        self.go_table.scrollloopvectical_top:InitItemData(#self.infocfgsTop, _G.handler(self, self.RefreshListTop))
    end
    if _G.AppSetting.IsXzns then
        _G.GameUtil.SetUiHeXieMask(self.go_table)
    end
end

function GodSpecialGiftRegularView:RefreshList(index, objGame)
    if index < 0 then
        return
    end
    local data = _G.ConfigManager.store_extra_cfg[self.infocfgsDown[index + 1]]
    local itemGoTable = _G.GetAutoGoTable(objGame, _G.handlerbind(self, self.OnClick_item, data))

    itemGoTable.obj_special:SetActiveE(0)

    local node = itemGoTable.obj_Root
    if node:GetChildCountE() > 0 then
        for i = 1, node:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(node:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    for i = 1, #data.goods do
        local award = data.goods[i]
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            award,
            node,
            function(item)
                item.gameObject:SetLocalScale(0.8, 0.8, 0.8)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                local cfg=item.cfg or item.data.cfg
                item:ShowEffectOrder(cfg.ef_item == 1 and true or false)
                if item.SetGradeNew then
                    item:SetGradeNew(false)
                end
            end,
            function(go, isOn)
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, award[1])
            end
        )
    end

    local finalPrice = require "MallManager":GetInstance():GetFinalPrice(data.price_id)

    ---@type number 付费礼包存储在DrawModel中, 免费礼包存储在MallManager中, 需要单独处理
    local buyCount
    if finalPrice > 0 then
        buyCount = DrawModel:GetInstance():GetGiftBuyCount(data.id)
    else
        buyCount = MallManager:GetInstance():GetItemBuyTimes(data.id, data.type_reset)
    end
    itemGoTable.aortext_name.text = _G.GetLangPackValue(data.name)
    local restCount = data.count_limit - buyCount
    itemGoTable.aortext_limit.text =
        _G.GetLangPackValue(utils.getLanguageId(data.type_reset, restCount <= 0), restCount, data.count_limit)

    if restCount <= 0 then
        itemGoTable.obj_sellOut:SetActiveE(1)
        itemGoTable.aorbtn_btnBuy:SetActiveE(0)
        itemGoTable.obj_free:SetActiveE(0)
        itemGoTable.obj_price:SetActiveE(0)
        itemGoTable.aortext_rmb:SetActiveE(0)
        itemGoTable.aorbtn_btnBuy:SetGray(true)
        itemGoTable.aorbtn_btnBuy.enabled = false
    else
        itemGoTable.obj_sellOut:SetActiveE(0)
        itemGoTable.aorbtn_btnBuy:SetActiveE(1)
        itemGoTable.obj_free:SetActiveE(finalPrice <= 0 and 1 or 0)
        itemGoTable.aorbtn_btnBuy:SetGray(false)
        itemGoTable.aorbtn_btnBuy.enabled = true
        itemGoTable.aortext_rmb:SetActiveE(data.type_price == 1 and 1 or 0)
        itemGoTable.obj_price:SetActiveE(data.type_price == 1 and 0 or 1)
        if data.type_price == 1 then
            _G.GameUtil.SetPriceByChannel(data.price_id, itemGoTable.aortext_rmb)
            _G.GameUtil.AddDouYinIcon(itemGoTable.aorbtn_btnBuy, true, nil, nil, nil, data.price_id)
        elseif finalPrice > 0 then
            itemGoTable.aorrawimage_price:SetActiveE(1)
            itemGoTable.aorrawimage_price:LoadImage(_G.ConfigManager.currency_type_cfg[12].icon)
            itemGoTable.aortext_price.text = tostring(finalPrice)
        else
            itemGoTable.aorrawimage_price:SetActiveE(0)
            itemGoTable.aortext_price.text = _G.GetLangPackValue(90030800004)
        end
    end
end

