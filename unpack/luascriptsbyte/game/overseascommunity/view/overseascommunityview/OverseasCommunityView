local OverseasCommunityPanel = require "OverseasCommunityPanel"

---@class OverseasCommunityView : UIBaseView
---@field model ActiveSeverMergeModel
---@field go_table OverseasCommunityView_GoTable
---@field cfgs community_global_cfg[]                       @配置数据
local OverseasCommunityView = _G.BaseClass("OverseasCommunityView", _G.UIBaseView)

function OverseasCommunityView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function OverseasCommunityView:OnCreate(communityGlobalIds)
    self.cfgs = {}
    if communityGlobalIds then
        for _, v in ipairs(communityGlobalIds) do
            local cfg = _G.ConfigManager.community_global_cfg[v]
            if cfg then
                table.insert(self.cfgs, cfg)
            end
        end
    end
    self:InitToggle()
    if self.initKey and self.initKey > 0 then
        self.toggles[self.initKey].isOn=false
        self.toggles[self.initKey].isOn=true
    end
end

function OverseasCommunityView:InitToggle()
    self.toggles = {}
    self.initKey = 0
    for k, v in ipairs(  self.cfgs) do
        local toggle = _G.InstantiateObject(self.go_table.toggle_Item, self.go_table.obj_Toggles)
        toggle:SetActiveE(1)
        self.toggles[k]= _G.GetAutoGoTable(
                toggle,
                _G.handlerbind(self, self.OnClickToggle, k, _G.handler(self, self.OnTaskSelect))
        )
        if self.initKey==0 then
            self.initKey=k
        end
        self.toggles[k].aortext_off.text = _G.GetLangPackValue(v.title)
        self.toggles[k].aortext_on.text = _G.GetLangPackValue(v.title)
    end
end

function OverseasCommunityView:OnClickToggle(go, isOn, key, call)
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if call then
        call(key)
    end
end

function OverseasCommunityView:OnTaskSelect(Key)
    if not self.TaskPanel then
        self.TaskPanel = self:AddComponent(
            self.go_table.obj_tagObj1,
            OverseasCommunityPanel.New(self.go_table.obj_tagObj1, self.cfgs[Key])
        )
    else
        self.TaskPanel:RefreshPanel(self.cfgs[Key])
    end
end

function OverseasCommunityView:OnClickBtn(go,isOn)
    local name = go:GetName()
    if name == "@_aorbtn_close" then
        self:Close()
    end
end

return OverseasCommunityView
