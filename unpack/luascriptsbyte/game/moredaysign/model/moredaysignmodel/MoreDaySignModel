local ActivitySynManager = require "ActivitySynManager"
local MoreDaySignNet = require("MoreDaySignNet")

local base = require "ActivitySynTypeBase"
---@class MoreDaySignModel :ActivitySynTypeBase 30日签到
---@field info activity_thirty_sign.i_activity_thirty_sign 签到数据
local MoreDaySignModel = _G.BaseClass("MoreDaySignModel", base)
local MoreDaySignType = _G.MoreDaySignType

---获取GM数据
---@param info activity.i_activity_self_info
--function MoreDaySignModel:OnHandleGMData(info)
--    self:ParseData(info)
--end

---@private
function MoreDaySignModel:GetDataFormServer()
    MoreDaySignNet:GetInstance():GetInfo(_G.handler(self, self.ParseData))
end

---解析数据
function MoreDaySignModel:ParseData(info)
    self:SetSelfData(info)
    base.ParseData(self)
end

---初始化数据
---@param info thirty_sign.i_thirty_sign_info
function MoreDaySignModel:SetSelfData(info)
    self.battlePassID = 201004
    ---@type store_battle_pass_cfg
    local passCfg = _G.ConfigManager.store_battle_pass_cfg[self.battlePassID]
    self.sids = passCfg.content
    local contentCfg = _G.ConfigManager.store_battle_content_cfg
    self.info = info.info
    self.info.pos_portrait = {"-240#-10#0|-330#0#0"}
    self.info.image = "Images/Roles/LH/guojia|Images/Roles/LH/ganjiangmoye"
    self.info.background = "Images/nMoreDaySign/UI_hd_30tian_bj"
    self.info.price_id = passCfg.price_id
    self.info.sid = 101
    self.info.base_award = { {type = passCfg.goods[1]} }
    self.info.free_award = {}
    self.info.pay_award = {}
    for i = 1, #self.sids do
        _G.table.insert(self.info.free_award, {type = contentCfg[self.sids[i]].rewards_normal[1]})
        _G.table.insert(self.info.pay_award, {type = contentCfg[self.sids[i]].rewards_pay[1]})
    end
    self:InitAwrdData()
    self:InitGetAward()
    local startTime = self.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Open)
    local time = _G.TimeUtil.GetServerUnixTime()
    self.curDay = _G.TimeUtil.GetInterValDayByGame(startTime, time) + 1
    self:UpdateRedPoint()
    _G.Events:GetInstance():Broadcast(_G.eMoreDaySign.RefreshMoreDaySign)
end

---初始化奖励数据
function MoreDaySignModel:InitAwrdData()
    self.awawrdDatas = {}
    self.awawrdDatas[MoreDaySignType.Free] = self:ParseAward(self.info.free_award)
    self.awawrdDatas[MoreDaySignType.Cash] = self:ParseAward(self.info.pay_award)
end

---解析奖励数据
---@param data award.i_award_item[] 奖励数据
function MoreDaySignModel:ParseAward(data)
    local StorageManager = _G.StorageManager:GetInstance()
    local tb = {}
    local type
    local Type = _G.StorageType
    local sid
    for i = 1, #data do
        sid = data[i].type[1]
        type = StorageManager:CheckSidType(sid)
        if type == Type.Card or type == Type.Decoration or type == Type.Equipment then
            tb[i] = {sid, 1}
        else
            tb[i] = {sid, data[i].type[2]}
        end
    end
    return tb
end

---初始化以获取奖励
function MoreDaySignModel:InitGetAward()
    self.GetDatas = {}
    self.GetDatas[MoreDaySignType.Free] = {}
    if self.info.free_sign then
        for i = 1, #self.info.free_sign do
            self.GetDatas[MoreDaySignType.Free][self.info.free_sign[i]] = true
        end
    end
    self.GetDatas[MoreDaySignType.Cash] = {}
    if self.info.pay_sign then
        for i = 1, #self.info.pay_sign do
            self.GetDatas[MoreDaySignType.Cash][self.info.pay_sign[i]] = true
        end
    end
end

---检测是否已付费
function MoreDaySignModel:CheckIsBuy()
    return self.info.is_buy == 1
end

---获取单个奖励
---@param type MoreDaySignType number 奖励类型
---@param index number 奖励下标
function MoreDaySignModel:GetSigleAwardData(type, index)
    return self.awawrdDatas[type][index]
end

---获取奖励
---@param type MoreDaySignType number 奖励类型
function MoreDaySignModel:GetAwardDatas(type)
    return self.awawrdDatas[type]
end

---检测奖励是否已领取
---@param type MoreDaySignType number 奖励类型
---@param index number 奖励下标
function MoreDaySignModel:CheckAwardIsGet(type, index)
    return self.GetDatas[type][self.sids[index]]
end

---检测奖励是否可以领取
function MoreDaySignModel:CheckAwardCanGet(type, index)
    if self.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Close then
        return false
    end
    if type == MoreDaySignType.Cash then
        if not self:CheckIsBuy() then
            return false
        end
    end
    return self.curDay >= index and not self:CheckAwardIsGet(type, index)
end

---购买监听
---@param data store.p2c_store_cash
function MoreDaySignModel:OnMallCashListener(data)
    --if data.activity_id == self.curActivityClass:GetActivityID() then
    if data.sid == self.battlePassID then
        self.info.is_buy = 1
        self:UpdateRedPoint()
        --require "CommonTipManager".OpenCommonAwardView(data)
        if self.mallCall then
            self.mallCall()
            self.mallCall = nil
        end
        _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    end
end

---获取立绘
---@param type number MoreDaySignType
function MoreDaySignModel:GetImage(type)
    if not self.image then
        self.image = {}
    end
    if not self.image[type] then
        local arr = _G.string.split(self.info.image, "|")
        self.image[type] = arr[type]
    end
    return self.image[type]
end

---获取立绘坐标
---@param type number MoreDaySignType
function MoreDaySignModel:GetImagePos(type)
    if not self.imagePos then
        self.imagePos = {}
    end
    if not self.imagePos[type] then
        if self.info.pos_portrait then
            local arr = _G.string.split(self.info.pos_portrait[1], "|")
            arr = _G.string.split(arr[type], "#")
            self.imagePos[type] = {_G.tonumber(arr[1]), _G.tonumber(arr[2]), _G.tonumber(arr[3])}
        else
            self.imagePos[type] = {0, 0, 0}
        end
    end
    return self.imagePos[type]
end

---获取背景
function MoreDaySignModel:GetBg()
    return self.info.background
end

---获取界面名字
function MoreDaySignModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.MoreDaySignView.Name
end

---进入活动
function MoreDaySignModel:OnEnterActivity()
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.MoreDaySignView.Name)
    if window then
        window.View:UpdateView(self.curActivityClass)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MoreDaySignView.Name, self.curActivityClass)
    end
    base.OnEnterActivity(self)
end

---领取奖励
function MoreDaySignModel:GetAward(type, index, call, notShowAward)
    if self.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Close then
        return
    end
    local data = {}
    if not index then
        --data = {type - 1}
        --_G.table.insertto(data, self:GetCanGetIndex(type))
        data = {type = type - 1, sids = self:GetCanGetSid(type)}
    else
        --data = {type - 1, index}
        data = {type = type - 1, sids = {self.sids[index]}}
    end
    MoreDaySignNet:GetInstance():GetAward(
        data,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            --for i = 2, #data do
            --    self.GetDatas[type][data[i]] = true
            --end
            for i = 1, #data.sids do
                self.GetDatas[type][data.sids[i]] = true
            end
            if not notShowAward then
                require "CommonTipManager".OpenCommonAwardView(msg)
            end
            if call then
                call(msg)
            end
            self:UpdateRedPoint()
        end
    )
end

---购买
function MoreDaySignModel:OnMall(call)
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    self.mallCall = call
    require "MallManager":GetInstance():BuyActiveGift(
        self.info.price_id,
        --self.curActivityClass:GetActivityID(),
        nil,
        --self.info.sid
        self.battlePassID
    )
end

---获取可领取奖励下标
function MoreDaySignModel:GetCanGetIndex(type)
    local tb = {}
    for k, v in pairs(self.awawrdDatas[type]) do
        if k <= self.curDay and not self:CheckAwardIsGet(type, k) then
            _G.table.insert(tb, k)
        end
    end
    return tb
end

---获取可领取奖励Sid
function MoreDaySignModel:GetCanGetSid(type)
    local tb = {}
    for k, v in pairs(self.awawrdDatas[type]) do
        if k <= self.curDay and not self:CheckAwardIsGet(type, k) then
            _G.table.insert(tb, self.sids[k])
        end
    end
    return tb
end

---检测是否有可领取的奖励
function MoreDaySignModel:CheckHasGet(type)
    if self.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Close then
        return false
    end
    if type == MoreDaySignType.Cash and not self:CheckIsBuy() then
        return false
    end
    local tb = {}
    for k, v in pairs(self.awawrdDatas[type]) do
        if k <= self.curDay and not self:CheckAwardIsGet(type, k) then
            return true
        end
    end
    return false
end

---初始化红点
function MoreDaySignModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {{2}, false}
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function MoreDaySignModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---刷新红点
function MoreDaySignModel:UpdateRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

---检测红点
function MoreDaySignModel:CheckRedPoint()
    if self.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Close then
        return 0
    end
    if self:CheckHasGet(MoreDaySignType.Free) or (self:CheckIsBuy() and self:CheckHasGet(MoreDaySignType.Cash)) then
        return 1
    end
    return 0
end

return MoreDaySignModel
