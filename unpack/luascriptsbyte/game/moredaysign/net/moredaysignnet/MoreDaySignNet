local base = require("BaseGameNet")

---@class MoreDaySignNet : BaseGameNet    通信协议
local MoreDaySignNet = _G.BaseClass("MoreDaySignNet", base)
---@return MoreDaySignNet MoreDaySignNet
function MoreDaySignNet:GetInstance()
    return base.GetInstance(self)
end

---获取信息
function MoreDaySignNet:GetInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_thirty_sign_info
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---领取奖励
function MoreDaySignNet:GetAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_thirty_sign_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function MoreDaySignNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return MoreDaySignNet