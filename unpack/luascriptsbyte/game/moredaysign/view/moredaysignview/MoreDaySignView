---更新按钮显示
function MoreDaySignView:UpdateBtnShow()
    local noAward = _G.table.isEmptyOrNil(self.activityTypeCls:GetCanGetIndex(self.type))
    self.go_table.aorbtn_getAll:SetGray(noAward)
    self.go_table.aorbtn_getAll:GetComponentE(_G.typeof(_G.CS.AorImage)).color = _G.ColorTools.FormatColorByString(noAward and colorTpe[3] or colorTpe[4])
    self.go_table.aortext_getAll.color = _G.ColorTools.FormatColorByString(noAward and colorTpe[2] or colorTpe[1])
    -- local img = self.go_table.aorbtn_getAll:GetComponentE(_G.typeof(_G.CS.AorImage))
    -- img.SpriteName = noAward and "ui_ty_kuang_02" or "ui_ty_kuang_00"
    -- _G.UIUtils.SetBtnDark(self.go_table.aorbtn_getAll, noAward and "808080" or "FFFFFF")
    if self.type == MoreDaySignType.Cash and not self.activityTypeCls:CheckIsBuy() then
        self.go_table.aorbtn_getAll:SetActiveE(0)
        self.go_table.aorbtn_cash:SetActiveE(1)
        self.go_table.trans_tips:SetActiveE(1)
    else
        self.go_table.aorbtn_getAll:SetActiveE(1)
        self.go_table.aorbtn_cash:SetActiveE(0)
        self.go_table.trans_tips:SetActiveE(0)
    end
end

---获取所有奖励
function MoreDaySignView:OnGetAll()
    if _G.table.isEmptyOrNil(self.activityTypeCls:GetCanGetIndex(self.type)) then
        _G.LogError("没奖励")
        return
    end

    self.activityTypeCls:GetAward(
            self.type,
            nil,
            function()
                for _, v in pairs(self.items) do
                    v:UpdateState(self.activityTypeCls:CheckAwardCanGet(self.type, v.index))
                    self:UpdateBtnShow()
                    self:UpdeteRedPoint()
                end
            end
    )
end

function MoreDaySignView:OnBtnCash()
    if self.RTS <= 0 then
        return
    end
    self.activityTypeCls:OnMall(
            function()
                self:RefreshPanel()
                self:UpdeteRedPoint()
            end
    )
end

---更新红点
function MoreDaySignView:UpdeteRedPoint()
    self.go_table.obj_cashRedpoint:SetActiveE(self.activityTypeCls:CheckHasGet(MoreDaySignType.Cash) and 1 or 0)
    self.go_table.obj_freeRedpoint:SetActiveE(self.activityTypeCls:CheckHasGet(MoreDaySignType.Free) and 1 or 0)
end

---按钮点击事件在这里派发
function MoreDaySignView:OnClickBtn(go, isOn)
    if go == self.go_table.toggle_free then
        self.toggles.free.aorimage_isOn:SetActiveE(isOn and 1 or 0)
        self.toggles.free.aorimage_isOff:SetActiveE(isOn and 0 or 1)
        self.curType = ShowType.free
        self:UpdateBg()
        self:OnFree(isOn)
    elseif go == self.go_table.toggle_cash then
        self.toggles.cash.aorimage_isOn:SetActiveE(isOn and 1 or 0)
        self.toggles.cash.aorimage_isOff:SetActiveE(isOn and 0 or 1)
        self.curType = ShowType.cash
        self:UpdateBg()
        self:OnCash(isOn)
    elseif go == self.go_table.aorbtn_getAll then
        self:OnGetAll()
    elseif go == self.go_table.aorbtn_cash then
        self:OnBtnCash()
    end
end

---跨天刷新
function MoreDaySignView:RefreshShow()
    self.go_table.scrollloopvectical_itemList:UpdateAllItem()
    self:UpdateBtnShow()
    self:UpdeteRedPoint()
end

---关闭界面
function MoreDaySignView:CloseView()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:Close()
end

function MoreDaySignView:OnDestroy()
    self:RemoveAllListener()
end

return MoreDaySignView
