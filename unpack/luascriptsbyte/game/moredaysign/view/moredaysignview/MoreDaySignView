---界面的入口函数
---@param activity ActivitySynGMActivity 活动数据
function MoreDaySignView:OnCreate(activity)
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.MoreDaySignView, self.go_table)
    if _G.AppSetting.IsXzns then
        colorTpe[1] = "50351e"
        _G.GameUtil.SetUiHeXieMask(self.go_table)
    end
    self.minIndex = 9999
    MoreDaySignItem = require "MoreDaySignItem"
    self.items = {}
    self.go_table.scrollloopvectical_itemList:InitItemData(0, _G.handler(self, self.RefreshItem))
    self:InitToggles()
    self:UpdateView(activity)
    self:InitEffect()
    self.go_table.toggle_free.isOn = false
    self.go_table.toggle_free.isOn = true
    self:AddListener(_G.eMoreDaySign.RefreshMoreDaySign, self.RefreshShow)
end

function MoreDaySignView:InitToggles()
    self.toggles = {
        free = _G.GetAutoGoTable(self.go_table.toggle_free),
        cash = _G.GetAutoGoTable(self.go_table.toggle_cash)
    }
end

