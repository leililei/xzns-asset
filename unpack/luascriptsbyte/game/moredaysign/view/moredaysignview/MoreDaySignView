end

---更新界面
function MoreDaySignView:UpdateView(activity)
    self.activity = activity
    self.activityTypeCls = activity:GetActivityTypeCls()
    if self.type then
        --self.go_table.scrollloopvectical_itemList:ScrollToIndex()
    else
        self.go_table.toggle_free.isOn = true
        self:OnFree(true)
    end
    self:UpdateTimer()

    local finalPrice = _G.GameUtil.SetPriceByChannel(self.activityTypeCls.info.price_id or self.activityTypeCls.info.price)
    self.go_table.aortext_cash.text = finalPrice
    _G.GameUtil.AddDouYinIcon(self.go_table.aorbtn_cash, true, self.go_table.aortext_cash)
    self.go_table.aortext_discre.text = GetLangPackValue(90023800075)
    if self.activityTypeCls.info.base_award[1] then
        self.go_table.aortext_nums.text = GetLangPackValue(90031100021) .. "%"
    end
    self:UpdeteRedPoint()
end

---更新计时器
function MoreDaySignView:UpdateTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    local _, RTS = self.activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    self.RTS = RTS
    self:UpdateTimeShow(true)
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimeShow, self, false, false, true, false)
    self.timer:Start()
end

---更新时间
function MoreDaySignView:UpdateTimeShow(isNotRefresh, elapsed)
    if not isNotRefresh then
        self.RTS = self.RTS - elapsed
    end

    if self.RTS <= 0 then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        self.go_table.aortext_time.text = ""
        self.go_table.aorbtn_cash:SetActiveE(0)
        self.go_table.trans_tips:SetActiveE(0)

        local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.FuliView.Name)
        if window then
            _G.PopWindowManager:GetInstance():ShowAllTips(930101)
            window.View:Close()
        end
        return
    end
    local time = TimeUtil.TranslateSecond(Mathf.RoundToInt(self.RTS))
    local str
    if time.day > 0 then
        str = _G.string.format(LangUtil.GetLangPackValue(90022100001), time.day, time.hour)
    elseif time.hour > 1 then
        str = LangUtil.GetLangPackValue(90022100002, time.hour, time.min)
    elseif time.min > 1 then
        str = LangUtil.GetLangPackValue(90000010394, time.min)
    else
        str = LangUtil.GetLangPackValue(90000010394, 1)
    end
    self.go_table.aortext_time.text = LangUtil.GetLangPackValue(90026900001, string.format("<color=#96CE51>%s</color>", str))
end

---刷新物体
---@param index number 下标
---@param obj UnityEngine.GameObject 物体
function MoreDaySignView:RefreshItem(index, obj)
    local id = obj:GetInstanceIDE()
    local item = self.items[id]
    if not item then
        item = self:AddComponent(obj, MoreDaySignItem.New(_G.handler(self, self.OnClickItem), self.activityTypeCls))
        self.items[id] = item
    end
    local isCanTask = item:Show(self.type, index + 1)
    if isCanTask then
        self.minIndex = self.minIndex > index + 1 and index + 1 or self.minIndex
    end
end

---点击物体
---@param item MoreDaySignItem 物体
function MoreDaySignView:OnClickItem(item)
    if self.activityTypeCls:CheckAwardCanGet(self.type, item.index) then
        self.activityTypeCls:GetAward(
                self.type,
                item.index,
                function()
                    item:UpdateState()
                    self:UpdateBtnShow()
                    self:UpdeteRedPoint()
                end
        )
    else
        require "CommonTipManager":GetInstance():OpenTip(item.go_table.aorbtn_click, item.data[1])
    end
end

---切换免费
function MoreDaySignView:OnFree(isOn)
    self.go_table.obj_font:SetActiveE(isOn and 1 or 0)
    if not isOn or self.type == MoreDaySignType.Free then
        return
    end

    self.type = MoreDaySignType.Free
    self:RefreshPanel()
end

--切换付费
function MoreDaySignView:OnCash(isOn)
    self.go_table.obj_font2:SetActiveE(isOn and 1 or 0)
    if not isOn or self.type == MoreDaySignType.Cash then
        return
    end
    self.type = MoreDaySignType.Cash
    self:RefreshPanel()
end

