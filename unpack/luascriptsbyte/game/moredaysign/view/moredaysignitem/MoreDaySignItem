---@class MoreDaySignItem : Component	中文描述
---@field go_table MoreDaySignView._obj_item_GoTable
---@field item BaseAwardNewItem
---@field effect UnityEngine.GameObject 特效
---@field typeClass MoreDaySignModel
local MoreDaySignItem = _G.BaseClass("MoreDaySignItem", _G.Component)

function MoreDaySignItem:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建对象时,入口构造函数
---@param typeClass MoreDaySignModel 类型数据
function MoreDaySignItem:OnCreate(call, typeClass)
    self.call = call
    self.typeClass = typeClass
    ---@type MoreDaySignType 奖励类型
    self.type = _G.MoreDaySignType.Free
end
---显示物体
---@param index number 物体下标
---@param type MoreDaySignType 类型
function MoreDaySignItem:Show(type, index)
    self.type = type
    self.data = self.typeClass:GetSigleAwardData(type, index)
    self.index = index
    self.CanTake = false
    if not self.item then
        self.item = require "BaseAwardNewItem".New(self.go_table.obj_Root, _G.handler(self, self.OnClickBtn), 88)
    end
    self.item:ShowWithID(self.data)
    self:UpdateState()
    return self.CanTake
end

function MoreDaySignItem:UpdateState()
    if self.typeClass:CheckAwardCanGet(self.type, self.index) then
        if not self.effect then
            self.effect = true
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_BaseItemWithCount_jin,
                self.go_table.obj_Root,
                function(tras)
                    self.effect = tras
                    self.effect:SetActiveE(self.typeClass:CheckAwardCanGet(self.type, self.index) and 1 or 0)
                end
            )
        elseif self.effect ~= true then
            self.effect:SetActiveE(1)
        end
        self.CanTake = true
    elseif self.effect and self.effect ~= true then
        self.effect:SetActiveE(0)
    end
    local langKey = self.type == _G.MoreDaySignType.Free and 90028500021 or 90028500020
    self.go_table.aortext_day.text = _G.LangUtil.GetLangPackValue(langKey, self.index)
    if self.typeClass:CheckAwardIsGet(self.type, self.index) then
        --self.go_table.obj_get:SetActiveE(1)
        self.go_table.obj_mask:SetActiveE(1)
    else
        --self.go_table.obj_get:SetActiveE(0)
        self.go_table.obj_mask:SetActiveE(0)
    end
end

---销毁对象时,析构函数
function MoreDaySignItem:OnDestroy()
end

function MoreDaySignItem:OnClickBtn(go, isOn)
    if self.call then
        self.call(self, go)
    end
end

return MoreDaySignItem
