local base = require("BaseGameNet")

---@class FanLiNet : BaseGameNet	通信协议
local FanLiNet = _G.BaseClass("FanLiNet", base)

---@return FanLiNet FanLiNet
function FanLiNet:GetInstance()
    return  self.super.super.GetInstance(self)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function FanLiNet:SendAccess(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.SuccessCall))
    self.Call[port] = callback
    return port
end

---获取充值金额信息
---@param callback function 回调方法
function FanLiNet:GetAmountInfo(callback)
    local pd = self:GetEmptyPB()
    self:SendAccess(_G.ConfigManager.net_map.game_cash_rebate_port_info,pd,callback)

end

--- 获得返利奖励
---@param callback function 回调方法
function FanLiNet:GetAward(callback)
    local pd = self:GetEmptyPB()
    self:SendAccess(_G.ConfigManager.net_map.game_cash_rebate_port_choose,pd,callback)
end


---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function FanLiNet:SuccessCall(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end


return FanLiNet