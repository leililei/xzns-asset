local base = require("ActivitySynTypeBase")
---@class FanLiSynModel    中文描述
local FanLiSynModel = _G.BaseClass("FanLiSynModel", base)

local ids = _G.ConfigManager.discrete_cfg[110002][1]

---类的构造函数
function FanLiSynModel:__init()
    self.FanLiModel = require "FanLiModel":GetInstance()
    -- self.FanLiModel:Init()
end

function FanLiSynModel:GetDataFormServer()
    if _G.CS.Launcher.Inst.IsSDK then
        local channelId = tonumber(_G.SDKManager:GetInstance():GetChannelId())
        if _G.table.ContainsValue(ids, channelId) then
            if _G.AppSetting.DEBUG then
                _G.Log(channelId, "当前渠道id是>>>>>>")
                _G.Log("当前渠道id开启此功能")
            end
            self.FanLiModel:Init()
        else
            self.curActivityClass:ChangeState(require("ActivitySynManager"):GetInstance().State.Close)
        end
    end
    self:ParseData()
end

---数据解析完成
function FanLiSynModel:ParseData()
    base.ParseData(self)
end

---进入活动主体
function FanLiSynModel:OnEnterActivity()
    self.FanLiModel:OpenView(self.curActivityClass)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function FanLiSynModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.FanLiView.Name
end
---类的析构函数
function FanLiSynModel:Dispose()
end

return FanLiSynModel