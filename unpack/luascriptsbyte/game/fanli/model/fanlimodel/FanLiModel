---@type FanLiNet
local FanLiNet = require("FanLiNet")
---@class FanLiModel	中文描述
---@field amount number 充值的金额(分)
---@field choose_uid number 领取返利的角色uid，(为0则还没有领取)
---@field isOver boolean 活动是否结束
local FanLiModel = _G.BaseClass("FanLiModel", _G.GameDataModelBase)

---@return FanLiModel
function FanLiModel:GetInstance()
    return self.super.GetInstance(self)
end


--- 初始化
function FanLiModel:Init()

    self.amount = nil
    self.choose_uid = 0
    self.isOver = false
    self.endTime = 0
    self:GetAmountInfo()
end

---获得充值金额信息
function FanLiModel:GetAmountInfo()
    FanLiNet:GetInstance():GetAmountInfo(_G.handlerbind(self, self.GetAmountInfoCall))
end

--- 获取充值金额信息回调
---@param msg cash_rebate.s2c_info
function FanLiModel:GetAmountInfoCall(msg)
    if not msg then
        return
    end
    self.amount = msg.cash_num
    self.choose_uid = msg.choose_uid
end

---获取返利
---@param callback function 回调方法
function FanLiModel:GetAmount(callback)
    FanLiNet:GetInstance():GetAward(function (data)
        -- 检查服务器通讯是否成功
        if data.ack ~= 1 then
            return
        end
        -- 奖励通过邮箱发放
        if callback then
            callback()
        end
    end)
end

function FanLiModel:SetEndTime(activity)
    self.typeClass = activity
    self.endTime = self.typeClass:GetActivityDeadLineByCondition(require"ActivitySynManager":GetInstance().State.Close)
end

--- 确认活动是否结束
---@return boolean true:活动结束;false:活动进行中
function FanLiModel:ClickIsOver()
    if self.isOver then
        -- true
        return self.isOver
    end
    -- 时间获取失败
    if not self.typeClass then
        return true
    end
    local nowTime = _G.GetNowUnixTime()

    return self.endTime <= nowTime
end

---类的析构函数
function FanLiModel:Dispose()
    self.amount = nil
    self.choose_uid = nil
end

function FanLiModel:OpenView(data)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FanLiView.Name,data)
end

return FanLiModel
