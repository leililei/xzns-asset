---@type FanLiModel
local FanLiModel = require "FanLiModel"
---@class FanLiView : UIBaseView    中文描述
---@field public go_table FanLiView_GoTable GoTable
---@field playerUid number 当前角色uid
local FanLiView = _G.BaseClass("FanLiView", _G.UIBaseView)

function FanLiView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function FanLiView:OnCreate(activity)
    FanLiModel:GetInstance():SetEndTime(activity)
    self.playerUid = _G.GetPlayerUid()
    local chooseUid = FanLiModel:GetInstance().choose_uid
    if chooseUid and self.playerUid == chooseUid then
        local amount = _G.math.floor(FanLiModel:GetInstance().amount / 100)
        self:OpenLingQuView(amount)
        self.go_table.aorbtn_lingQu:SetActiveE(0)
    end
end

---界面的销毁函数
function FanLiView:OnDestroy()
end

--- 查询充值
function FanLiView:ChaXun()
    -- 判断是否在活动时间
    if self:ClickOver() then
        return
    end
    local model = FanLiModel:GetInstance()
    -- 充值金额为零
    if not model.amount or model.amount <= 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(3608)
        return
    end

    local choose_uid = model.choose_uid
    -- 单位为分，转化为元
    local amount = _G.math.floor(model.amount / 100)
    -- 已经领取过返利
    if choose_uid ~= 0 then
        if choose_uid ~= self.playerUid then
            -- 被其他服务器角色领取
            _G.PopWindowManager:GetInstance():ShowAllTips(3611)
        else
            -- 被当前角色领取
            self:GetAmountTip()
        end
        return
    end
    -- 充值金额不为零则切换领取窗口
    if amount and amount > 0 then
        self:OpenLingQuView(amount)
    else
        -- 充值金额为零
        _G.PopWindowManager:GetInstance():ShowAllTips(3608)
    end
end

--- 打开领取界面
---@param amount number 充值的金额
function FanLiView:OpenLingQuView(amount)
    self.go_table.obj_selectedView:SetActiveE(1)
    self.go_table.obj_noSelectView:SetActiveE(0)
    -- 设置返利金额
    self.go_table.aortext_chongZhi.text = _G.LangUtil.GetLangPackValue(90000011254, amount)
    self.go_table.aortext_fanLi.text = _G.LangUtil.GetLangPackValue(90000011255, _G.math.ceil(amount * 1.2))
    self.go_table.aortext_js.text = _G.LangUtil.GetLangPackValue(90000011320, _G.PlayerModel:GetInstance():GetName())
end

--- 领取返利
function FanLiView:GetFanLiAmount()
    -- 判断活动是否结束
    if self:ClickOver() then
        return
    end
    local model = FanLiModel:GetInstance()
    -- 已经领取过返利
    if model.choose_uid == self.playerUid then
        self:GetAmountTip()
        return
    end

    -- 弹出二次确认窗口
    _G.PopWindowManager:GetInstance():ShowAllTips(3607,
        nil,
        function()
            -- 确定按钮的回调方法
            if self:ClickOver() then
                return
            end
            model:GetAmount(function()
                model.choose_uid = self.playerUid
                self.go_table.aorbtn_lingQu:SetActiveE(0)
            end)
            self:GetAmountTip()
        end,
        nil,
        nil,
        false,
        _G.ServerManager:GetInstance().CurServer.ServerName
    )
end

---获得返利时的弹窗
function FanLiView:GetAmountTip()
    _G.PopWindowManager:GetInstance():ShowAllTips(3610)
end

--- 检测活动是否结束
---@return boolean true:活动结束;false:活动进行中
function FanLiView:ClickOver()
    if FanLiModel:GetInstance():ClickIsOver() then
        _G.PopWindowManager:GetInstance():ShowAllTips(3609)
        return true
    else
        return false
    end
end

---按钮点击事件在这里派发
function FanLiView:OnClickBtn(go)
    local name = go:GetName()
    -- _G.LogError(name)
    if name == "@_aorbtn_chaXun" then
        self:ChaXun()
    elseif name == "@_aorbtn_lingQu" then
        self:GetFanLiAmount()
    elseif name == "@_aorbtn_Close" then
        self:Close()
    end
end

function FanLiView:CloseView()
    self:Close()
end

return FanLiView
