---@class RedPaperModel : 数据类 红包小游戏
local RedPaperModel = _G.BaseClass("RedPaperModel", _G.Singleton)
---创建对象时,入口构造函数
---@field time number 时间
---@field score number 分数
---@field stage number 阶段 1 = 前期 2=中期 3 = 后期
local desecond = _G.ConfigManager.min_descend_cfg[3010101]
local tracks = {
    [1] = {-290,365,0},
    [2] = {-194,365,0},
    [3] = {-97,365,0},
    [4] = {1,365,0},
    [5] = {97,365,0},
    [6] = {194,365,0},
    [7] = {290,365,0},
}

local used = {}
local canUse = {}
local table =  _G.table

---@return RedPaperModel RedPaperModel
function RedPaperModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function RedPaperModel:__init()
    --canUse = tracks
end

function RedPaperModel:InitData()
    self.items = {
        [1] = {
            index = 1,
            ["icon"] = "ui_jhb_bx03_img",
            ["speed"] = desecond.reward_speed[1],
            ["score"] = desecond.reward[1],
            ["type"] = "yellow"
        },
        [2] = {
            index = 2,
            ["icon"] = "ui_jhb_bx02_img",
            ["speed"] = desecond.reward_speed[2],
            ["score"] = desecond.reward[2],
            ["type"] = "yellow"
        },
        [3] = {
            index = 3,
            ["icon"] = "ui_jhb_bx01_img",
            ["speed"] = desecond.reward_speed[3],
            ["score"] = desecond.reward[3],
            ["type"] = "yellow"
        },
        [4] = {
            index = 4,
            ["icon"] = "",
            ["speed"] = desecond.bomb_speed,
            ["time"] = desecond.bomb,
            ["type"] = "red"
        },
        [5] = {
            index = 5,
            ["icon"] = "shizhishalou",
            ["speed"] = desecond.bell_speed,
            ["time"] = desecond.bell,
            ["type"] = "green"
        },
        [6] = {
            index = 6,
            ["icon"] = "",
            ["speed"] = desecond.sbomb_speed,
            ["time"] = desecond.bomb,
            ["type"] = "red"
        },
    }
    canUse = {
    [1] = {-290,765,0},
    [2] = {-194,765,0},
    [3] = {-97,765,0},
    [4] = {1,765,0},
    [5] = {97,765,0},
    [6] = {194,765,0},
    [7] = {290,765,0}}
    used = {}
    self.Speed = 1
    self.times = 0
    self.level = 1
    self.score = 0
    self.weight = {}
    for k,v in pairs(desecond.probability[1]) do
        local value = self.weight[k-1] and v*10 + self.weight[k-1] or v*10
        table.insert(self.weight,value)
    end
end

---销毁对象时,析构函数
function RedPaperModel:Dispose()
end

function RedPaperModel:RandomItem()
    local num = math.random(100)
    local itemId = 1
    if num <= self.weight[1] then
        itemId = 1
    elseif num <= self.weight[2] then
        itemId = 2
    elseif num <= self.weight[3] then
        itemId = 3
    elseif num <= self.weight[4] then
        itemId = 4
    elseif num <= self.weight[5] then
        itemId = 5
    end
    return self.items[itemId]
    --local icon =
end

function RedPaperModel:RandomTrack()
    local num = math.random(#canUse)
    local pos = canUse[num]
    table.insert(used,canUse[num])
    table.remove(canUse,num)
    self.times = self.times + 1
    if self.times > desecond.down_time then
        table.insert(canUse,used[1])
        table.remove(used,1)
    end
    return pos
end

function RedPaperModel:RandomBomb()
    local num = math.random(#tracks)
    local pos = tracks[num]
    return pos,self.items[6]
end

function RedPaperModel:ChangeSpeed(level)
    local add = desecond.time_coefficient[level-1] + 1
    for i=1,5 do
        self.items[i].speed = self.items[i].speed*add
    end
end

function RedPaperModel:GetGrade()
    local grade_lists = _G.ConfigManager.discrete_cfg[105604][1]
    local num = 1
    local gra_b, gra_a, gra_s, gra_sss = grade_lists[1], grade_lists[2], grade_lists[3], grade_lists[4]
    if self.score > gra_sss then
        num = 4
    elseif self.score <= gra_sss and self.score > gra_s then
        num = 3
    elseif self.score <= gra_s and self.score > gra_a then
        num = 2
    elseif self.score <= gra_a and self.score > gra_b then
        num = 1
    else
        num = 1
    end
    return num
end

---改变分数
function RedPaperModel:ChanageScore(num)
    self.score = self.score + num
end

---获取分数
function RedPaperModel:GetScore()
    return self.score
end

function RedPaperModel:ChangeWeight(level)
    self.weight = {}
    for k,v in pairs(desecond.probability[level]) do
        local value = self.weight[k-1] and v*10 + self.weight[k-1] or v*10
        table.insert(self.weight,value)
    end
    self:ChangeSpeed(level)
end

return RedPaperModel
