---@class TrackingPointModel : Singleton    中文描述
local TrackingPointModel = _G.BaseClass("TrackingPointModel", _G.Singleton)
_G.TrackingPointModel = TrackingPointModel

local CS = _G.CS
local typeof = _G.typeof

---@return TrackingPointModel TrackingPointModel
function TrackingPointModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
---@field WindowOpenTime table<string, number> 窗口名，打开时间
---@field
function TrackingPointModel:__init()
    self.WindowOpenTime = {}
    self.LastWindowName = nil
end

---设置窗口打开时间
---@param windowName string 窗口名
---@param setLast boolean 是否记录为上次打开
function TrackingPointModel:SetWindowStartTime(windowName, setLast)
    self.WindowOpenTime[windowName] = _G.TimeUtil.GetServerUnixTime()
    if setLast then
        self.LastWindowName = windowName
    end
end

---获取窗口打开持续时间
---@param windowName string 窗口名
---@return number 持续时间
function TrackingPointModel:GetWindowOpenedTime(windowName)
    if self.WindowOpenTime[windowName] then
        return _G.TimeUtil.GetServerUnixTime() - self.WindowOpenTime[windowName]
    else
        return 0
    end
end

---获取窗口打开总时间，并销毁打开时间
---@param windowName string 窗口名
---@return number 持续时间
function TrackingPointModel:GetWindowClosedTime(windowName)
    local time = self:GetWindowOpenedTime(windowName)
    self.WindowOpenTime[windowName] = nil
    if windowName == self.LastWindowName then
        self.LastWindowName = nil
    end
    return time
end

---退出界面打点
---@param windowName string 窗口名
function TrackingPointModel:CloseActTracking(windowName)
    if _G.CS.Launcher.Inst.IsSDK then
        local json = _G.Table2Json(
                {
                    interface = windowName,
                    stay_seconds = self:GetWindowClosedTime(windowName)
                }
        )
        if _G.AppSetting.DEBUG then
            _G.Log(json, "退出界面打点")
        end
        _G.SDKManager:GetInstance():DoShushuData_track("interface_close_act", json)
    end
end

---退出最近打开页面打点
function TrackingPointModel:CloseActTrackingByLast()
    if self.LastWindowName then
        self:CloseActTracking(self.LastWindowName)
        --_G.DelayDo(0.1,
        --        function()
        --            _G.UIManager:GetInstance():CloseWindow(self.LastWindowName)
        --        end
        --)
    end
end


function TrackingPointModel:CloseAFKEmBattleViewTracking()
    local windowName = _G.ConfigManager.ui_cfg.AfkEmbattleView.Name
    if self.WindowOpenTime[windowName] then
        self:CloseActTracking(windowName)
    end
end

---销毁对象时,析构函数
function TrackingPointModel:Dispose()
    self.WindowOpenTime = nil
    self.LastWindowName = nil
end

return TrackingPointModel