---@return ScrollerManager ScrollerManager
function ScrollerManager:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function ScrollerManager:__init()
    self.scrollerMsgs = {}
    self.isShowScrollerView = false
    _G.Events:GetInstance():AddListener(_G.eScene.EnterWorldOver, self.OnEnterWorldOver, self)
    _G.Events:GetInstance():AddListener(_G.eScene.EnterWorldStart, self.OnEnterWorldStart, self)
end

---销毁对象时,析构函数
function ScrollerManager:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eScene.EnterWorldOver, self.OnEnterWorldOver, self)
    _G.Events:GetInstance():RemoveListener(_G.eScene.EnterWorldStart, self.OnEnterWorldStart, self)
    self.ScrollerView = nil
end

function ScrollerManager:OnEnterWorldOver()
    self:UpdateShowScrollerState()
    if #self.scrollerMsgs <= 0 then
        return
    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ScrollerView.Name)
end

function ScrollerManager:OnEnterWorldStart()
    self.isShowScrollerView = false
end

--region 对外接口

---设置跑马灯UI实例
---@param component ScrollerComponent
function ScrollerManager:SetComponent(component)
    self.ScrollerView = component
end

---获取一条跑马灯消息
---@return string 跑马灯消息
function ScrollerManager:GetScollerOne()
    if #self.scrollerMsgs <= 0 then
        return nil
    end
    local content = self.scrollerMsgs[1]
    table.remove(self.scrollerMsgs, 1)
    return content
end

-----增加一条本地的跑马灯显示
---@param 变量名 变量类型 中文描述
---@return 变量类型 中文描述
function ScrollerManager:AddLocalScroller(content)
    if not self.isShowScrollerView then
        return
    end
    ---镇魂街ZHJ-26533 【待办任务】程序待办任务ZHJ-26278
    ---【客户端】聊天内系统文字和跑马灯使用文字ID分离,和策划沟通后不用id改，直接改颜色
    content = string.gsub(content, "14874a", "5bdf99")
    content = string.gsub(content, "C95F00", "ffae45")

    table.insert(self.scrollerMsgs, content)

    if self.ScrollerView then
        self.ScrollerView:Show()
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ScrollerView.Name)
    end
end

---更新是否显示跑马灯状态
function ScrollerManager:UpdateShowScrollerState()
    if not _G.PlayerPrefsManager.HasKey("SettingPaoMaDeng", true) then
        self.isShowScrollerView = true
    else
        self.isShowScrollerView = _G.CS.WechatGameCore.PlayerPrefs.GetFloat("SettingPaoMaDeng") == 1
    end
    if not self.isShowScrollerView then
        self.scrollerMsgs = {}
        if _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.ScrollerView.Name) then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ScrollerView.Name)
        end
    end
end

--endregion
---@return ScrollerManager ScrollerManager
return ScrollerManager

