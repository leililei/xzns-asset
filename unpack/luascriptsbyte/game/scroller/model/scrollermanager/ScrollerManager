---@class ScrollerManager : Singleton 接收处理跑马灯消息
---@field GetInstance fun():ScrollerManager
local ScrollerManager = _G.BaseClass("ScrollerManager", _G.Singleton)
_G.ScrollerManager = ScrollerManager

