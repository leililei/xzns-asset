---@class ScrollerComponent : UIBaseView	中文描述
---@field public go_table ScrollerComponent_GoTable GoTable
local ScrollerComponent = _G.BaseClass("ScrollerComponent", _G.UIBaseView)

local contentMoveSpeed = 150

function ScrollerComponent:Awake()
    self.content = self.go_table.aortext_content
    self.contentTrans = self.content:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    self.moveSpeed = _G.Vector3.New(-contentMoveSpeed, 0, 0)
end

---界面的入口函数
function ScrollerComponent:OnCreate()
    _G.ScrollerManager:GetInstance():SetComponent(self)
    self.contentInitPos = Vector3.New(self.contentTrans:GetLocalPosition())
end

function ScrollerComponent:OnEnable()
    self:ShowContent()
end

function ScrollerComponent:OnDisable()
    if self.showTimer then
        self.showTimer:Stop()
        self.showTimer = nil
    end
end

function ScrollerComponent:OnDestroy()
    _G.ScrollerManager:GetInstance():SetComponent(nil)
    if self.showTimer then
        self.showTimer:Stop()
        self.showTimer = nil
    end
end

function ScrollerComponent:ShowContent()
    local text = _G.ScrollerManager:GetInstance():GetScollerOne()
    if _G.string.IsNullOrEmpty(text) then
        self.gameObject:SetActiveE(0)
        return
    end
    self.content.text = text
    self:ShowOne(text)
end

function ScrollerComponent:ShowOne(text)
    if self.showTimer then
        self.showTimer:Resume()
        return
    end
    self.showTimer = _G.TimerManager:GetInstance():GetTimer(1, self.ShowUpdate, self, false, true)
    self.showTimer:Start()
end

function ScrollerComponent:ShowOneEnd()
    if self.showTimer then
        self.showTimer:Pause()
    end
    self.contentTrans:SetLocalPosition(self.contentInitPos.x, self.contentInitPos.y, self.contentInitPos.z)
    self:ShowContent()
end

function ScrollerComponent:ShowUpdate()
    local x, y, z = self.contentTrans:GetLocalPosition()
    self.contentTrans:SetLocalPosition(
        x + self.moveSpeed.x * _G.Time.deltaTime,
        y + self.moveSpeed.y * _G.Time.deltaTime,
        z + self.moveSpeed.z * _G.Time.deltaTime
    )
    self:Show()
    local contentX = self.contentTrans:GetRectTransformSizeDelta()
    if x <= (-self.contentInitPos.x - contentX) then
        self:ShowOneEnd()
    end
end

