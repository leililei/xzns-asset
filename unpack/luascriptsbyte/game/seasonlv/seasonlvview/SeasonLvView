end

---按钮点击事件在这里派发
function SeasonLvView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

function SeasonLvView:OnStartClose()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    if self.Tiemr_end ~= nil then
        self.Tiemr_end:Stop()
        self.Tiemr_end = nil
    end
end

return SeasonLvView
