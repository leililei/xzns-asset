function SeasonLvView:RefreshList(index, objGame)
    if index < 0 then
        return
    end
    index = index + 1
    local data = self.countCfgArr[index]

    local itemGoTable = _G.GetAutoGoTable(objGame)

    if itemGoTable.addClick == nil then
    --     itemGoTable.aorbtn_get1.onClick:AddListener(
    --         _G.handlerbind(self, self.OnClick_GetItem, itemGoTable, false, index)
    --     )
    --     itemGoTable.aorbtn_get2.onClick:AddListener(
    --         _G.handlerbind(self, self.OnClick_GetItem, itemGoTable, true, index)
    --     )
        itemGoTable.aorbtn_get.onClick:AddListener(
            _G.handlerbind(self, self.OnClick_GetItem, itemGoTable)
        )
        itemGoTable.addClick = true
    end

    itemGoTable.data = data

    itemGoTable.ispass = self.lv >= data.level

    itemGoTable.isGet1 = require("SeasonLvModel"):GetInstance():IsAward(data.id, false)
    itemGoTable.isGet2 = require("SeasonLvModel"):GetInstance():IsAward(data.id, true)

    if not itemGoTable.btnImage then
        itemGoTable.btnImage = itemGoTable.aorbtn_get:GetComponentE(_G.typeof(_G.CS.AorImage))
    end
    ---设置可领取
    local isGet1 = false
    local isGet2 = false

    if itemGoTable.ispass then
        isGet1 = itemGoTable.isGet1 == false
        isGet2 = itemGoTable.isGet2 == false and self.isUp == true
    end
    itemGoTable.aorbtn_get:SetActiveE(1)
    itemGoTable.aorimage_got:SetActiveE(0)
    if not itemGoTable.ispass then
        -- 未达到
        itemGoTable.aorbtn_get:SetGray(true)
        itemGoTable.aortext_get.text = _G.GetLangPackValue(90020400086)
        itemGoTable.aortext_get.color = _G.ColorTools.FormatColorByString("dde2e6")
        itemGoTable.btnImage.SpriteName = "ui_zssd_lan_btn"
    elseif isGet1 or isGet2 then
        -- 领取奖励
        itemGoTable.aorbtn_get:SetGray(false)
        itemGoTable.aortext_get.text = _G.GetLangPackValue(90021600021)
        itemGoTable.aortext_get.color = _G.ColorTools.FormatColorByString("91522E")
        itemGoTable.btnImage.SpriteName = "ui_zssd_cheng_btn"
    elseif self.isUp == false then
        -- 再次领取
        itemGoTable.aorbtn_get:SetGray(false)
        itemGoTable.aortext_get.text = _G.GetLangPackValue(90025200011)
        itemGoTable.aortext_get.color = _G.ColorTools.FormatColorByString("91522E")
        itemGoTable.btnImage.SpriteName = "ui_zssd_cheng_btn"
    else
        -- 奖励领完了
        itemGoTable.aorbtn_get:SetActiveE(0)
        itemGoTable.aorimage_got:SetActiveE(1)
    end

    if index == 1 then
        itemGoTable.obj_rect:SetActiveE(0)
    else
        itemGoTable.obj_rect:SetActiveE(1)
        itemGoTable.aorimage_jindu:SetActiveE(itemGoTable.ispass and 1 or 0)
    end
    itemGoTable.aorimage_point.SpriteName = itemGoTable.ispass and "ui_sjtxzjl_jindutiao_jd" or "ui_sjtxzjl_jindutiao_jdh"

    local rewards = data.rewards_normal
    if not itemGoTable.item1 then
        itemGoTable.item1 = BaseAwardNewItem.New(itemGoTable.obj_item1, nil, 88, itemGoTable.obj_item1)
    end
    if itemGoTable.item1 then
        itemGoTable.item1:ShowWithID(rewards[1], nil, _G.handlerbind(self, self.itemCall, itemGoTable, false))
    end

    rewards = data.rewards_pay
    rewards = rewards[1]
    if not itemGoTable.item2 then
        itemGoTable.item2 =
            BaseAwardNewItem.New(
                itemGoTable.obj_item21,
                _G.handlerbind(self, self.ShowBuyTips, itemGoTable),
                88,
                itemGoTable.obj_item21
            )
    end
    if itemGoTable.item2 then
        itemGoTable.item2:ShowWithID(rewards, nil, _G.handlerbind(self, self.itemCall, itemGoTable, true))
    end

    rewards = data.rewards_pay
    rewards = rewards[2]

    local ishave2 = rewards ~= nil
    _G.GameUtil.SetActiveByCondition(itemGoTable.obj_item22, ishave2)
    if ishave2 then
        if not itemGoTable.item3 then
            itemGoTable.item3 =
                BaseAwardNewItem.New(
                    itemGoTable.obj_item22,
                    _G.handlerbind(self, self.ShowBuyTips, itemGoTable),
                    88,
                    itemGoTable.obj_item22
                )
        end
        if itemGoTable.item3 then
            itemGoTable.item3:ShowWithID(rewards, nil, _G.handlerbind(self, self.itemCall, itemGoTable, true))
        end
    end

    ---是否显示第二个
    _G.GameUtil.SetActiveByCondition(itemGoTable.obj_gou22, rewards ~= nil)
    _G.GameUtil.SetActiveByCondition(itemGoTable.obj_suo22, rewards ~= nil)

    ---是否显示 锁 勾
    _G.GameUtil.SetActiveByCondition(itemGoTable.obj_gou1, itemGoTable.isGet1 == true)
    _G.GameUtil.SetActiveByCondition(itemGoTable.obj_gou2, itemGoTable.isGet2 == true)

    _G.GameUtil.SetActiveByCondition(itemGoTable.obj_suo1, itemGoTable.isGet1 == false and isGet1 == false)
    _G.GameUtil.SetActiveByCondition(itemGoTable.obj_suo2, itemGoTable.isGet2 == false and isGet2 == false)

    itemGoTable.aortext_lv.text = _G.LangUtil.GetLangPackValue(self.UiDic.zldj, data.level)
    if self.showDelay then
        -- objGame:SetActiveE(0)
        _G.DelayDo(
            self:GetDelayTime(index),
            function()
                objGame:SetActiveE(1)
            end
        )
    end
    if index > 8 then
        self.showDelay = false
    end
    return objGame
end

