function SeasonLvView:Awake()
    self.UiDic = {
        --- %s天%s
        day = 90025500011,
        exp = "%d/%d",
        --- %s级
        zldj = 90025500012
    }

    local parameters = _G.ConfigManager.discrete_cfg[105103][1]
    --- 5    (105103,5,赛季战令购买经验倒计时（天）)
    self.AddBtnTime = parameters[1] or 0
    ----赛季战令购买经验 按钮开启 时间戳   store.time为6点
    self.AddBtnTime = require("SeasonModel"):GetInstance():GetEndTime() - self.AddBtnTime * 86400

    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["@_aorbtn_getExp"] = self.OnClick_GetExp,
        ["@_aorbtn_add"] = self.OnClick_AddExp,
        ["@_aorbtn_buy"] = self.OnClick_BuyUp,
        ["@_aorbtn_yjlq"] = self.OnClick_yjlq,
        ["@_aorbtn_help"] = self.OnClick_help,
        ["@_aorbtn_task"] = self.OnClick_task,
        -- [self.go_table.aorbtn_btn:GetName()] = self.ShowBuyTips,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    ---本赛季战令id
    self.id = require("SeasonLvModel"):GetInstance().store.sid

    ---@type store_season_battle_cfg
    self.cfg = _G.ConfigManager.store_season_battle_cfg[self.id]
    self.haveDiscount = _G.StorageManager:GetInstance():CheckItem(discountItemId, 1)
    self.price_id = self.cfg.price_id
    if self.haveDiscount then
        -- self.price = _G.ConfigManager.discrete_cfg[105111][1][1]
        self.price_id = self.cfg.price_discount_id
    end

    if self.haveDiscount then
        _G.GameUtil.SetPriceByChannel(self.price_id, self.go_table.aortext_prePrice, 90028800008)
    end
    _G.GameUtil.SetPriceByChannel(self.price_id, self.go_table.aortext_rmb)

    if self.endTime == nil then
        self.endTime = require("SeasonLvModel"):GetInstance().EndTime
    end

    self:SetTimeEnd()
    self.Tiemr_end = _G.TimerManager:GetInstance():GetTimer(1, self.SetTimeEnd, self, false, false)
    self.Tiemr_end:Start()
    ---暂时隐藏
    -- _G.GameUtil.SetActiveByCondition(self.go_table.obj_shijiandi, false)

    local content = table.values(self.cfg.content)
    ---根据配置顺序，不再根据id大小
    ---table.sort(content)
    self.conIds = content

    local store_season_battlecon_cfg = _G.ConfigManager.store_season_battlecon_cfg
    ---@type store_season_battlecon_cfg[]
    self.countCfgArr = {}
    ---@type store_season_battlecon_cfg
    local cfgItem
    local id
    for i = 1, #self.conIds do
        id = self.conIds[i]
        if id == nil or id == 0 then
            if _G.AppSetting.DEBUG then
                _G.LogError(" 配置id 无效  store_season_battlecon_cfg.content id:" .. tostring(id))
            end
            cfgItem = nil
        else
            cfgItem = store_season_battlecon_cfg[self.conIds[i]]
        end
        if cfgItem then
            table.insert(self.countCfgArr, cfgItem)
        end
    end

    _G.GameUtil.SetActiveByCondition(self.go_table.obj_item, false)

    self:ShowBuyItemAll()

    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

