---@return  number,number,number  等级, 当前经验, 最大经验
function SeasonLvView:GetLvExp(sumexp)
    local lv = 0
    local max = 0
    local exp = 0
    local sumexp = sumexp
    local cfginfo
    for i = 1, #self.countCfgArr do
        cfginfo = self.countCfgArr[i]
        local subexp = cfginfo.conditions[2]
        if subexp == nil then
            if _G.AppSetting.DEBUG then
                _G.LogError("未配置经验 store_season_battlecon_cfg." .. cfginfo.id)
            end
            subexp = 0
            sumexp = 0
        end
        if sumexp >= subexp then
            sumexp = sumexp - subexp
            lv = cfginfo.level
        else
            exp = sumexp
            max = subexp
            break
        end
    end

    return lv, exp, max
end

