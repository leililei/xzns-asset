function SeasonLvView:ShowBuyItemAll()
    local count = self.go_table.obj_itemAll:GetChildCountE()
    for i = count, 1, -1 do
        local obj = self.go_table.obj_itemAll:GetChildE(i)
        if obj then
            _G.PoolsManager:GetInstance():Despawn(obj, _G.ePoolType.UIItem)
        end
    end
    local ItemDic = {}
    for i = 1, #self.countCfgArr do
        for j = 1, #self.countCfgArr[i].rewards_pay do
            if ItemDic[self.countCfgArr[i].rewards_pay[j][1]] == nil then
                ItemDic[self.countCfgArr[i].rewards_pay[j][1]] = _G.DeepCopyCfgTable(self.countCfgArr[i].rewards_pay[j])
            else
                ItemDic[self.countCfgArr[i].rewards_pay[j][1]][2] =
                    ItemDic[self.countCfgArr[i].rewards_pay[j][1]][2] + self.countCfgArr[i].rewards_pay[j][2]
            end
        end
    end

    local grid = self.go_table.obj_itemAll:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.HorizontalLayoutGroup))

    if _G.table.count(ItemDic) > 2 then
        grid.padding.left = 47
        grid.padding.right = 47
        grid.childAlignment = _G.CS.UnityEngine.TextAnchor.MiddleLeft
        self.go_table.obj_itemAll:SetPivotPosition(0, 1)
    else
        grid.padding.left = 0
        grid.padding.right = 0
        grid.childAlignment = _G.CS.UnityEngine.TextAnchor.MiddleCenter
        self.go_table.obj_itemAll:SetPivotPosition(0.5, 1)
    end

    _G.DelayFrameDo(
        function()
            for _, v in pairs(ItemDic) do
                _G.StorageManager:GetInstance():GetItemBaseViewNew(
                    v,
                    self.go_table.obj_itemAll,
                    function(item)
                        item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                        item:ShowEffect(true, true)
                    end
                )
            end
        end
    )
end

function SeasonLvView:ShowBuyItemNow()
    local count = self.go_table.obj_itemNow:GetChildCountE()
    for i = count, 1, -1 do
        local obj = self.go_table.obj_itemNow:GetChildE(i - 1)
        if obj then
            _G.PoolsManager:GetInstance():Despawn(obj, _G.ePoolType.UIItem)
        end
    end
    local ItemDic = {}
    local sid, num, oldNum, rewards, rLen
    if self.lv > 0 then
        for j = 1, self.lv do
            rewards = self.countCfgArr[j].rewards_pay
            rLen = #rewards
            for k = 1, rLen do
                sid = rewards[k][1]
                num = rewards[k][2]
                oldNum = ItemDic[sid]
                if oldNum == nil then
                    oldNum = 0
                end
                ItemDic[sid] = oldNum + num
            end
        end
    end
    local goods
    if self.haveDiscount then
        goods = _G.ConfigManager.store_season_battle_cfg[self.id].goods_discount
    else
        goods = _G.ConfigManager.store_season_battle_cfg[self.id].goods
    end
    if #goods > 0 then
        local id
        for _, v in pairs(goods) do
            id = v[1]
            ---加上购买获得
            if ItemDic[id] == nil then
                ItemDic[id] = 0
            end
            ItemDic[id] = ItemDic[id] + v[2]
        end
    end
    local grid = self.go_table.obj_itemNow:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.HorizontalLayoutGroup))

    if _G.table.count(ItemDic) > 2 then
        grid.padding.left = 47
        grid.padding.right = 47
        grid.childAlignment = _G.CS.UnityEngine.TextAnchor.MiddleLeft
        self.go_table.obj_itemNow:SetPivotPosition(0, 1)
    else
        grid.padding.left = 0
        grid.padding.right = 0
        grid.childAlignment = _G.CS.UnityEngine.TextAnchor.MiddleCenter
        self.go_table.obj_itemNow:SetPivotPosition(0.5, 1)
    end

    for _, value in ipairs(goods) do
        if value[1] == discountItemId then --固定判断是否有折扣券  如果有 放在第一个  ZHJ-31775
            _G.StorageManager:GetInstance():GetItemBaseView(
                value[1],
                value[2],
                self.go_table.obj_itemNow,
                function(item)
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    item:ShowEffect()
                end
            )
        end
    end

    for itemSid, itemNum in pairs(ItemDic) do
        _G.StorageManager:GetInstance():GetItemBaseView(
            itemSid,
            itemNum,
            self.go_table.obj_itemNow,
            function(item)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                item:ShowEffect()
            end
        )
    end
end

