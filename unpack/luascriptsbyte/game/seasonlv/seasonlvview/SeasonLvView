    if not itemGoTable.ispass then
        -- 等级没达到
    elseif itemGoTable.isGet1 == false or (itemGoTable.isGet2 == false and self.isUp == true) then
        --领取
        self:OnClick_yjlq()
    elseif self.isUp == false then
        -- 免费奖励已领取，没有购买付费
        self:OnClick_BuyUp()
    end
