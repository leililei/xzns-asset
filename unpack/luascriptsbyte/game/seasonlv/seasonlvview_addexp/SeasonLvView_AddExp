---类的构造函数
---@param mParentView SeasonLvView
function SeasonLvView_AddExp:__init(obj, mParentView)
    local parameters = _G.ConfigManager.discrete_cfg[105102][1]
    --- 2 (105102 2#1 赛季战令经验购买（魂玉#赛季战令经验）)
    self.moneybl = parameters[1] / parameters[2]

    self.gameObject = obj
    self.mParentView = mParentView
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    ---中间 所有item
    self.go_table.scrollloophorizontal_item:InitItemData(0, _G.handler(self, self.RefreshList))
    self.ItemDataType = {
        ---物品数据 所属类型
        PropData = 1,
        EquipmentItem = 2,
        DecorationData = 3,
        Card = 4
    }
    self.ItemDataTypeDic = {
        ---判断物品数据 所属类型
        ["PropData"] = self.ItemDataType.PropData,
        ["EquipmentItem"] = self.ItemDataType.EquipmentItem,
        ["DecorationData"] = self.ItemDataType.DecorationData,
        ["CardData"] = self.ItemDataType.Card
    }
    --if self.grid == nil then
    --    self.grid = self.go_table.obj_itemContent:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.GridLayoutGroup))
    --    self.grid.enabled = true
    --end
end

function SeasonLvView_AddExp:Show(lv, max)
    self.lv = lv
    self.max = max
    self.lvCount = 1
    self:ShowLvNum(self.lvCount)

    _G.GameUtil.SetActiveByCondition(self.gameObject, true)
end
function SeasonLvView_AddExp:Hide()
    _G.GameUtil.SetActiveByCondition(self.gameObject, false)
end

function SeasonLvView_AddExp:SumMoney()
    local itemDic = {}

    local sumLv = self.lv + self.lvCount
    local countCfgArr = self.mParentView.countCfgArr

    local sum = 0
    local exp, info, sid, num
    for i = self.lv + 1, sumLv do
        info = countCfgArr[i]
        exp = info.conditions[2]
        sum = sum + exp * self.moneybl

        for j = 1, #info.rewards_normal do
            sid = info.rewards_normal[j][1]
            num = info.rewards_normal[j][2]
            if itemDic[sid] == nil then
                itemDic[sid] = 0
            end
            itemDic[sid] = itemDic[sid] + num
        end
        for j = 1, #info.rewards_pay do
            sid = info.rewards_pay[j][1]
            num = info.rewards_pay[j][2]
            if itemDic[sid] == nil then
                itemDic[sid] = 0
            end
            itemDic[sid] = itemDic[sid] + num
        end
    end
    sum = _G.GameUtil.FormatNum(sum)

    self.Money = sum
    self.go_table.aortext_count.text = sum

    self.ItemDataAllList = {}
    for sid, num in pairs(itemDic) do
        table.insert(self.ItemDataAllList, _G.StorageManager:GetInstance():GetItemDataClass(sid, num))
    end
    self:ShowItem()
end

function SeasonLvView_AddExp:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self:Hide()
    elseif go == self.go_table.aorbtn_add then
        self:OnClick_Add()
    elseif go == self.go_table.aorbtn_sub then
        self:OnClick_Sub()
    elseif go == self.go_table.aorbtn_max then
        self:OnClick_Max()
    elseif go == self.go_table.aorbtn_Done then
        self:OnClick_BuyExp()
    end
end

--region --------------------------------------lvCount--------

function SeasonLvView_AddExp:ShowLvNum()
    self.go_table.aortext_num.text = self.lvCount
    self.go_table.aortext_lv1.text = self.lv
    self.go_table.aortext_lv2.text = self.lv + self.lvCount
    self:SumMoney()
end

function SeasonLvView_AddExp:OnClick_Add()
    local sub = self.max - self.lv
    if self.lvCount == sub then
        return
    end
    self.lvCount = self.lvCount + 1
    self:ShowLvNum()
end
function SeasonLvView_AddExp:OnClick_Sub()
    if self.lvCount == 1 then
        return
    end
    self.lvCount = self.lvCount - 1
    self:ShowLvNum()
end
function SeasonLvView_AddExp:OnClick_Max()
    local sub = self.max - self.lv
    if self.lvCount == sub then
        return
    end
    self.lvCount = sub
    self:ShowLvNum()
end

--endregion------------------------------------lvCount--------

--region --------------------------------------Item--------

function SeasonLvView_AddExp:ShowItem()
    local nowCount = #self.ItemDataAllList
    if nowCount > 0 then
        local weight = 80 * nowCount + 15.5* (nowCount-1)
        self.go_table.scrollloophorizontal_item:SetRectTransformSize(_G.Mathf.Min(weight, 745), 105.52)
    end
    --if nowCount > 7 then
    --    self.grid.padding.left = 10
    --    self.grid.padding.right = 10
    --    self.grid.childAlignment = _G.CS.UnityEngine.TextAnchor.MiddleLeft
    --    self.go_table.obj_itemContent:SetPivotPosition(0, 1)
    --else
    --    self.grid.padding.left = 0
    --    self.grid.padding.right = 0
    --    self.grid.childAlignment = _G.CS.UnityEngine.TextAnchor.MiddleCenter
    --    self.go_table.obj_itemContent:SetPivotPosition(0.5, 1)
    --end
    if self.OldCount ~= nowCount then
        self.go_table.scrollloophorizontal_item:UpdateCount(nowCount)
        self.OldCount = nowCount
    else
        self.go_table.scrollloophorizontal_item:UpdateAllItem()
    end
end

function SeasonLvView_AddExp:RefreshList(index, objGame)
    --if index < 0 then
    --    return
    --end
    --local itemData = self.ItemDataAllList[index + 1]
    --local itemGoTable = _G.GetAutoGoTable(objGame)
    --itemGoTable.itemData = itemData
    --itemGoTable.DataIndex = index + 1
    --self:SetLoopItem(itemGoTable)
    index = index + 1
    local itemData = self.ItemDataAllList[index]
    local itemGoTable = _G.GetAutoGoTable(objGame)
    itemGoTable.itemData = itemData
    itemGoTable.DataIndex = index
    itemGoTable.obj_item:ClearChildren()
    local item = require "BaseAwardNewItem".New(itemGoTable.obj_item, nil, 100, itemGoTable.obj_item)
    local data = { itemData.sid, itemData.count }
    item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))

    return objGame
end
function SeasonLvView_AddExp:GetItemDataType(itemData)
    if itemData == nil then
        return 0
    end
    return self.ItemDataTypeDic[itemData.__cname] or 0
end

function SeasonLvView_AddExp:SetLoopItem(itemGoTable)
    --region --------------------------------------生成对应item--------
    ------@type PropData
    local itemData = itemGoTable.itemData
    local itemDataType = self:GetItemDataType(itemData)

    local redSid_BackpackItem = 0

    _G.StorageManager:GetInstance():GetItem(
        itemGoTable.obj_item,
        itemData.sid,
        itemData.count,
        function(itemLua, storageType)
            if storageType == _G.StorageType.ResProp or _G.StorageType.Material then
                itemGoTable.lua_Prop = itemLua
                itemLua.gameObject:SetLocalScaleXYZ(1.08)
                self:SetPropItem(itemGoTable)
            elseif storageType == _G.StorageType.Equipment then
                itemGoTable.lua_Equip = itemLua
                itemLua.gameObject:SetLocalScaleXYZ(1.06)
                self:SetEquipItem(itemGoTable)
            elseif storageType == _G.StorageType.Decoration then
                itemGoTable.lua_Decorat = itemLua
                itemLua.gameObject:SetLocalScaleXYZ(0.79)
                self:SetDecoratItem(itemGoTable)
            elseif storageType == _G.StorageType.Card then
                itemGoTable.lua_Card = itemLua
                itemLua.gameObject:SetLocalScaleXYZ(0.73)
                self:SetCardItem(itemGoTable)
            end
        end
    )
    --endregion------------------------------------生成对应item--------
end

--region --------------------------------------设置item信息--------

function SeasonLvView_AddExp:SetPropItem(itemGoTable)
    if itemGoTable == nil then
        return
    end
    ---@type ItemViewBase
    local lua = itemGoTable.lua_Prop
    ---@type PropData
    local itemData = itemGoTable.itemData
    lua:SetImage(itemData.sid)
    lua:ShowCount(itemData.count)
    lua:ShowNumText(true, lua.NumTextAnchor.RightDown)
    lua.gameObject:SetName(itemData.sid)
    lua.gameObject:SetActiveE(1)
end
function SeasonLvView_AddExp:SetEquipItem(itemGoTable)
    if itemGoTable == nil then
        return
    end
    ---@type ItemEquipmentBase
    local lua = itemGoTable.lua_Equip
    ---@type EquipmentItem
    local itemData = itemGoTable.itemData

    lua:ShowData(itemData)
    lua:ShowCount()
    lua.gameObject:SetName(itemData.uid)
    lua.gameObject:SetActiveE(1)
end
function SeasonLvView_AddExp:SetDecoratItem(itemGoTable)
    if itemGoTable == nil then
        return
    end
    ---@type ItemDecorationBase
    local lua = itemGoTable.lua_Decorat
    ---@type DecorationData
    local itemData = itemGoTable.itemData

    lua.gameObject:SetName(itemData.uid)
    lua:ShowData(itemData)
    lua.gameObject:SetActiveE(1)
end

function SeasonLvView_AddExp:SetCardItem(itemGoTable)
    if itemGoTable == nil then
        return
    end
    ---@type ItemCardAllView
    local lua = itemGoTable.lua_Card
    ---@type CardData
    local itemData = itemGoTable.itemData
    lua:ShowCardData(itemData)
    lua:HideOrShowLevel()

    lua.gameObject:SetName(itemData.uid)
    lua.gameObject:SetActiveE(1)
end

--endregion------------------------------------设置item信息--------

--endregion------------------------------------Item--------

function SeasonLvView_AddExp:OnClick_BuyExp()
    if _G.StorageManager:GetInstance():CheckItem(_G.ResPropID.Diamond, self.Money) == false then
        _G.PopWindowManager:GetInstance():ShowAllTips(230303)
        return
    end
    require("SeasonLvModel"):GetInstance():GetBuyExp(self.lvCount, self.Money)
end
