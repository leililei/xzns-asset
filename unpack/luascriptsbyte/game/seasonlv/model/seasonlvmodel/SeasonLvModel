    _G.PlayerPrefsManager.SetInt("SeasonLvStart", 0)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SeasonLvView.Name)
end

function SeasonLvModel:OnSeasonEnd()
    _G.PlayerPrefsManager.SetInt("SeasonLvStart", 0)
end

---初始化功能逻辑
function SeasonLvModel:InitFunction()
    self.OldActivenum = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.ResProp, _G.ResPropID.ActiveValue)
    self:UpdataView()
end

function SeasonLvModel:UpdataView()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SeasonLvView.Name)
    if view then
        view:UpdataView()
    end
end

---打开界面
function SeasonLvModel:OpenView()
    _G.PlayerPrefsManager.SetInt("SeasonLv" .. self.store.sid, 1)

    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.FirstStore.id)

    if self.isOpen ~= true then
        _G.PopWindowManager:GetInstance():ShowAllTips(400101)
        return
    end
    if self.EndTime <= _G.TimeUtil.GetServerUnixTime() then
        _G.PopWindowManager:GetInstance():ShowAllTips(620101)
        return
    end

    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SeasonLvView.Name)
end

---@return boolean true已购买豪华
function SeasonLvModel:GetIsUp()
    return self.store.is_buy == 1
end

function SeasonLvModel:SetIsUp()
    self.store.is_buy = 1
    self:RedCheck()
end


---是否领取奖励
function SeasonLvModel:IsAward(id, isUp)
    if isUp then
        return self.store.up_award_list[id] == true
    else
        return self.store.normal_award_list[id] == true
    end
end
---设置已领取
function SeasonLvModel:SetAward(id, isUp)
    if not id then
        if _G.AppSetting.DEBUG then
            _G.LogError("SeasonLvModel:SetAward id无效:" .. tostring(id))
        end
        return
    end
    if isUp then
        self.store.up_award_list[id] = true
    else
        self.store.normal_award_list[id] = true
    end
end

---设置所有满足条件的奖励为已购买
function SeasonLvModel:SetAllAward()
    local lv = self:GetLvExp()
    local id = self.store.sid
    ---@type store_season_battle_cfg
    local cfg = _G.ConfigManager.store_season_battle_cfg[id]
    local content = cfg.content
    for i = 1, #content do
        local info = _G.ConfigManager.store_season_battlecon_cfg[content[i]]
        if lv >= info.level then
            self:SetAward(info.id, false)
            if self:GetIsUp() then
                self:SetAward(info.id, true)
            end
        end
    end
end

function SeasonLvModel:OnMallCashListener(data)
    local cfg = _G.ConfigManager.store_season_battle_cfg[data.sid]
    if cfg ~= nil and cfg.type == 1 then
        self:SetIsUp()
        if _G.StorageManager:GetInstance():CheckItem(self.discountItemId, 1) then
            _G.StorageManager:GetInstance():ConsumeItem(self.discountItemId, nil , 1)
        end
        require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.FirstStore.id)
    end
end

