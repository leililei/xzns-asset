---数据解析完成
---@param data SeasonLvModel_storeinfo
function SeasonLvModel:ParseData(data)
    self.isOpen = data ~= nil

    data = data or {}

    local parameters = _G.ConfigManager.season_cfg[require("SeasonModel"):GetInstance():GetCurSeasonId()]
    --- 战令id
    self.store.sid = parameters.store_battle_pass[1]

    self.store.time = data.time or 0
    self.store.is_buy = data.is_buy or 0

    ---当前玩家累计经验
    self.store.exp = data.exp or 0

    if data.normal_award_list ~= nil then
        for i = 1, #data.normal_award_list do
            self:SetAward(data.normal_award_list[i], false)
        end
    end

    if data.up_award_list ~= nil then
        for i = 1, #data.up_award_list do
            self:SetAward(data.up_award_list[i], true)
        end
    end

    local seasonCfg = require("SeasonModel"):GetInstance():GetCfg()
    self.EndTime = self.store.time + 86400 * seasonCfg.duration

    if _G.PlayerPrefsManager.GetInt("SeasonLvStart", 0) == 0 then
        if self.isOpen then
            _G.PlayerPrefsManager.SetInt("SeasonLv" .. self.store.sid, 0)
        else
            _G.PlayerPrefsManager.SetInt("SeasonLv" .. self.store.sid, 1)
        end
        _G.PlayerPrefsManager.SetInt("SeasonLvStart", 1)

        require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.FirstStore.id)
    end
    self.super.ParseData(self)
end

function SeasonLvModel:OnSeasonStart()
    _G.PlayerPrefsManager.SetInt("SeasonLvStart", 0)
    self:GetDataFormServer()
end

