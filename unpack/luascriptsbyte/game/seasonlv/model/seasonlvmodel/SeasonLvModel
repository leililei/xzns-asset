---购买经验
function SeasonLvModel:GetBuyExp(lv, consume)
    ---@type store_season_battle.c2s_store_season_battle_buy_exp
    local pbdata = {}
    pbdata.lv = lv
    require("SeasonLvNet"):GetInstance():GetBuyExp(
        pbdata,
        function(data)
            if data.ack == 1 then
                _G.StorageManager:GetInstance():ConsumeItem(_G.ResPropID.Diamond, 0, consume)
                self:OnSixClockUpdate(_G.handler(self, self.OnInitFunction))

                require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                    _G.ConfigManager.redpoint_cfg.FirstStore.id
                )
            end
        end
    )
end

---领奖
---@param id number 奖励id
---@param isUp boolean 奖励类型 true，豪华
function SeasonLvModel:GetAward(id, isUp)
    ---@type store_season_battle.c2s_store_season_battle_award
    local pbdata = {}
    pbdata.id = id
    pbdata.type = isUp and 1 or 0
    require("SeasonLvNet"):GetInstance():GetAward(
        pbdata,
        function(data)
            if data.ack == 1 then
                self:SetAward(id, isUp)
                _G.StorageManager:GetInstance():ReceiveAwardData(data)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
                self:UpdataView()

                require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                    _G.ConfigManager.redpoint_cfg.FirstStore.id
                )
            end
        end
    )
end

---一键领奖
---@param id number 奖励id
---@param isUp boolean 奖励类型 true，豪华
function SeasonLvModel:GetAwardAll()
    require("SeasonLvNet"):GetInstance():GetAwardAll(
        function(data)
            if data.ack == 1 then
                self:SetAllAward()
                _G.StorageManager:GetInstance():ReceiveAwardData(data)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
                self:OnSixClockUpdate(_G.handler(self, self.OnInitFunction))
                local lv = self:GetLvExp()
                _G.Events:GetInstance():Broadcast(_G.eSeasonTask.Action, {_G.SeasonTaskID.SeasonLv}, lv, true)

                require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                    _G.ConfigManager.redpoint_cfg.FirstStore.id
                )
            end
        end
    )
end
---获取等级
---@return  number,number,number  等级, 当前经验, 最大经验
function SeasonLvModel:GetLvExp(sumexp)
    if not self.countCfgArr then
        ---@type store_season_battle_cfg
        local cfg = _G.ConfigManager.store_season_battle_cfg[self.store.sid]
        local content = table.values(cfg.content)
        --table.sort(content)
        local conIds = content

        local store_season_battlecon_cfg = _G.ConfigManager.store_season_battlecon_cfg
        ---@type store_season_battlecon_cfg[]
        self.countCfgArr = {}
        ---@type store_season_battlecon_cfg
        local cfgItem
        local id
        for i = 1, #conIds do
            id = conIds[i]
            if id == nil or id == 0 then
                if _G.AppSetting.DEBUG then
                    _G.LogError(" 配置id 无效  store_season_battlecon_cfg.content id:" .. tostring(id))
                end
                cfgItem = nil
            else
                cfgItem = store_season_battlecon_cfg[conIds[i]]
            end
            if cfgItem then
                table.insert(self.countCfgArr, cfgItem)
            end
        end
    end

    local lv = 0
    local max = 0
    local exp = 0
    local sumexp = sumexp or self.store.exp
    local cfginfo
    for i = 1, #self.countCfgArr do
        cfginfo = self.countCfgArr[i]
        local subexp = cfginfo.conditions[2]
        if subexp == nil then
            if _G.AppSetting.DEBUG then
                _G.LogError("未配置经验 store_season_battlecon_cfg." .. cfginfo.id)
            end
            subexp = 0
            sumexp = 0
        end
        if sumexp >= subexp then
            sumexp = sumexp - subexp
            lv = cfginfo.level
        else
            exp = sumexp
            max = subexp
            break
        end
    end

    return lv, exp, max
end

