    self.expBl = parameters[2] / parameters[1]

    self.EndTime = 0
    ---true功能已初始
    self.isOpen = false
    ---@type SeasonLvModel_storeinfo
    self.store = {
        ---战令的id
        sid = 0,
        ---本轮赛季战令开启时间
        time = 0,
        ---赛季经验 累计
        exp = 0,
        ---是否是豪华 （0:不是 1：是）
        is_buy = 0,
        ---已经领取的普通奖励id
        normal_award_list = {},
        ---已经领取的豪华奖励id
        up_award_list = {}
    }
    ---当前活跃值 用于计算活跃度增量
    self.OldActivenum = 0
    self.discountItemId = 203030801

    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

