local base = require("BaseGameNet")
---@class SeasonLvNet : BaseGameNet	通信协议
local SeasonLvNet = _G.BaseClass("SeasonLvNet", base)
---@return SeasonLvNet SeasonLvNet
function SeasonLvNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---获取
---@param pbData table PB数据
---@param callback function 完成回调
function SeasonLvNet:GetInfo(callback)
    local item = _G.ConfigManager.net_map.game_store_season_battle_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---加速
---@param pbData table PB数据
---@param callback function 完成回调
function SeasonLvNet:GetBuyExp(pbdata, callback)
    local item = _G.ConfigManager.net_map.game_store_season_battle_buy_exp
    local port = base.Access(self, item, pbdata, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

