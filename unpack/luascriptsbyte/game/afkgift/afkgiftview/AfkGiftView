---@class AfkGiftView : UIBaseView	中文描述
---@field public go_table AfkGiftView_GoTable GoTable
---@field awardList table 奖励列表
---@field bigAwardIndex table 大奖列表
local AfkGiftView = _G.BaseClass("AfkGiftView", _G.UIBaseView)

function AfkGiftView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function AfkGiftView:OnCreate()
    -- _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.AfkGiftView,self.go_table)
    ---@type AfkTaskModel 
    self.afkModel =  require("AfkTaskModel"):GetInstance()
    self.awardList = self.afkModel.AwardDatas2
    self.bigAwardList = {}
    for i = 1, #self.awardList do
        local data = self.awardList[i]
        if not _G.string.IsNullOrEmpty(data.cfg.image) then
            _G.table.insert(self.bigAwardList,data)
        end
    end
    local section = require("AfkModel"):GetInstance():GetCurSection()
    self.go_table.aortext_jindu.text = _G.GetLangPackValue(90020800037,section // 1000 % 100,section % 1000)

    local index = self:FindJumpIndex()
    self.go_table.scrollloopvectical_awardlist:InitItemData(
        #self.awardList,
        _G.handler(self,self.RefreshList),
        index)
    --self.go_table.scrollloophorizontal_section:InitItemData(
    --    #self.bigAwardList,
    --    _G.handler(self, self.RefreshSecItem),
    --    index
    --)
    if _G.AppSetting.IsXzns then
        _G.GameUtil.SetUiHeXieMask(self.go_table)
    end
end

function AfkGiftView:RefreshList(index,go)
    if index < 0 then
        return
    end
    index = index + 1
    local tb = _G.GetAutoGoTable(go,_G.handlerbind(self,self.ItemOnClick,index))
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.AfkGiftViewItem,tb)
    local data = self.awardList[index]
    -- 是否为特殊关卡
    local isSpecific = not _G.string.IsNullOrEmpty(data.cfg.image)
    tb.data = data

    self:SetItem(tb, data,isSpecific)
end

---设置item
---@param tb table item的go_table
---@param data table item数据
---@param isSpecific bool 是否为特殊关卡
function AfkGiftView:SetItem(tb, data, isSpecific)
    if data and data.afkCfg then
        local languageKey = isSpecific and 90020800039 or 90020800038
        tb.aortext_title.text = _G.GetLangPackValue(languageKey, data.afkCfg.chapter, data.afkCfg.section)
    else
        tb.aortext_title.text = ""
    end
    if not data.CanTake and not data.isGet then
        -- 不能领取 （关卡没有达到）
        tb.aorbtn_get:SetActiveE(0)
        tb.aorbtn_go:SetActiveE(1)
        tb.aorimage_got:SetActiveE(0)
    elseif not data.isGet then
        -- 能够领取 （还没有领取）
        tb.aorbtn_get:SetActiveE(1)
        tb.aorbtn_go:SetActiveE(0)
        tb.aorimage_got:SetActiveE(0)
    else
        -- 已经领取
        tb.aorbtn_get:SetActiveE(0)
        tb.aorbtn_go:SetActiveE(0)
        tb.aorimage_got:SetActiveE(1)
    end
    if tb.award then
        tb.award:Show(data.realReward[1], _G.handlerbind(self, self.OnClickSectionBtn, tb),
        data.realReward[2])
        tb.award:SetGou(data.isGet)
        self:ShowEffect(tb.award.go_table, data.CanTake and not data.isGet)
    else
        _G.ItemFactory:GetInstance():GetItemCard(
        _G.ItemFactory.itemType.ItemBaseWithCount,
        tb.obj_award,
        function(item)
        if tb.reward then
            _G.DestroyObject(item.gameObject)
            return
        end
        tb.award = item
        tb.award:Show(
            data.realReward[1], 
            function()
                require "CommonTipManager":GetInstance():OpenTip(self.gameObject, data.realReward[1])
            end,
            data.realReward[2])
            tb.award.gameObject:SetLocalScaleXYZ(0.8)
            tb.award:SetGou(data.isGet)
            self:ShowEffect(tb.award.go_table, data.CanTake and not data.isGet)
        end
        )
    end
end

function AfkGiftView:ShowEffect(tb, isShow)
    tb.aorimage_Color:ClearChildren()
    if not isShow then
        return
    end
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
            tb.aorimage_Color,
            function(trans)
                if not self.go_table then
                    _G.DestroyObject(trans)
                    return
                end
                trans:SetLocalScaleXYZ(1.15)
            end
    )
end

function AfkGiftView:RefreshSecItem(index, obj)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj)
    local data = self.bigAwardList[index]
    tb.gameObject:SetName(index)
    tb.data = data
    tb.aortext_name.text = _G.string.format("%d-%d", data.afkCfg.chapter, data.afkCfg.section)
    tb.aorimage_bg1:SetActiveE((not data.CanTake or data.isGet) and 1 or 0)
    tb.obj_eff:SetActiveE(data.CanTake and not data.isGet and 1 or 0)
    tb.aorimage_fill:SetActiveE((data.CanTake or data.isGet) and 1 or 0)
    --是否特殊关卡
    local isSpecific = not _G.string.IsNullOrEmpty(data.cfg.image)
    tb.obj_reward:SetLocalScaleXYZ(isSpecific and 1 or 0.7)
    --加载奖励图标
    if not tb.reward then
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemBaseWithCount,
            tb.obj_rewardRoot,
            function(item)
                if tb.reward then
                    _G.DestroyObject(item.gameObject)
                    return
                end
                tb.reward = item
                tb.reward:Show(data.realReward[1], _G.handlerbind(self, self.OnClickSectionBtn, tb),
                    data.realReward[2])
                tb.reward.gameObject:SetLocalScaleXYZ(0.6)
                -- tb.reward:SetGradeNew(data.CanTake and not data.isGet)
                tb.reward:SetGou(data.isGet)

                tb.rewardEff = 1
                -- tb.reward[isCard]:ShowFrameEffect(data.realReward[1], data.CanTake)
                if data.CanTake then
                    self:SetItemEff(tb)
                end
            end
        )
    else
        tb.reward:Show(data.realReward[1], _G.handlerbind(self, self.OnClickSectionBtn, tb),
            data.realReward[2])
        tb.reward:SetGou(data.isGet)
        if data.CanTake then
            self:SetItemEff(tb)
        end
    end
end

---下方的按钮点击回调
function AfkGiftView:OnClickSectionBtn(item)
    if not item.data then
        return
    end
    if not item.data.CanTake or item.data.isGet then
        --展示奖励tip
        require("CommonTipManager"):GetInstance():OpenTip(item.gameObject, item.data.realReward[1])
    else
        require "AfkTaskModel":GetInstance():GetAllAward2(function(msg, sids)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            self:UpdateView()
            require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedPointAfkStage2.id)
        end)
    end
end

---item的按钮点击回调
function AfkGiftView:ItemOnClick(go,isOn,index)
    local name = go:GetName()
    if name == "@_aorbtn_get" then
        require "AfkTaskModel":GetInstance():GetAllAward2(function(msg, sids)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedPointAfkStage2.id)
            if self:IsNil() then
                return
            end
            self:UpdateView()
        end)
    elseif name == "@_aorbtn_go" then
        self:Close()
    end
end

-- 在领取奖励后，刷新数据和页面
function AfkGiftView:UpdateView()
    self.awardList = self.afkModel.AwardDatas2
    local index = self:FindJumpIndex()

    self.go_table.scrollloopvectical_awardlist:UpdateAllItem()
    self.go_table.scrollloopvectical_awardlist:ScrollToIndex(index)

    --self.go_table.scrollloophorizontal_section:UpdateAllItem()
    --self.go_table.scrollloophorizontal_section:ScrollToIndex(index)
end

---获取可领取奖励的上一个索引
function AfkGiftView:FindJumpIndex()
    local index, index1, target
    for i, data in pairs(self.awardList) do
        if data.isGet then
            index1 = i
        elseif data.CanTake then
            index = i
            break
        end
    end
    target = index or (index1 and index1 + 1 or 0)
    if target > 0 then
        local sum = #self.awardList - 5
        if target > sum then
            target = sum
        else
            target = target - 1
        end
        target = target - 1
        target = target < 0 and 0 or target
        return target --C#从0开始
    end
    target = target < 0 and 0 or target
    return target
end

function AfkGiftView:SetItemEff(go)
    local eff = _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang
    _G.UIUtils.RemoveChildren(go.obj_eff)
    _G.UIUtils.LoadEffectByCfg(
        eff,
        go.obj_eff,
        function(trans)
            if _G.IsNil(go) then
                _G.DestroyObject(trans)
                return
            end
            go.frameEffect = trans
            go.eff = eff
        end
    )
end

---界面的销毁函数
function AfkGiftView:OnDestroy()
end

---按钮点击事件在这里派发
function AfkGiftView:OnClickBtn(go)
    if go == self.go_table.aorbtn_colseView or go == self.go_table.aorbtn_colse then
        self:Close()
    end
end

return AfkGiftView
