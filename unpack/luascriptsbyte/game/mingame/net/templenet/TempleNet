---@class TempleNet : BaseGameNet	通信协议
local TempleNet = _G.BaseClass("TempleNet", require "BaseGameNet")
local base = require "BaseGameNet"

---@return TempleNet TempleNet
function TempleNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求
---@param pbData table PB数据
---@param callback function 完成回调
function TempleNet:SendAccess(pbData, item, callback)
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.SuccessCall))
    self.Call[port] = callback
end

---庙会增加积分
function TempleNet:SubmitScore(Score, Id, callback)
    self:SendAccess({score = Score, id = Id}, _G.ConfigManager.net_map.game_activity_port_miaohui_score, callback)
end
---排行榜 放置 积分
function TempleNet:AccessRankBanDan(pbdata, callback)
    local pb = {}
    if _G.table.isEmptyOrNil(pbdata) then
        pb = self:GetEmptyPB()
    else
        pb = pbdata
    end
    local item = _G.ConfigManager.net_map.game_rank_min_game_miaohui
    local port = base.Access(self, item, pb, _G.handler(self, self.SuccessCall))
    self.Call[port] = callback
end
---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function TempleNet:SuccessCall(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type TempleNet
return TempleNet
