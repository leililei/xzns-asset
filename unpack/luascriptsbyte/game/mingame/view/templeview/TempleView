local textColor = {
    open = _G.Color.New(145 / 255, 72 / 255, 1 / 255, 1),
    disable = _G.Color.New(67 / 255, 64 / 255, 73 / 255, 1)
}
local ActivitySynManager = require "ActivitySynManager"
---@class TempleView : UIBaseView 关卡奖励
---@field public go_table TempleView_GoTable GoTable
local TempleView = _G.BaseClass("TempleView", _G.UIBaseView)
local UIUtils = _G.UIUtils
function TempleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
local GameNameIcon = {"mh_img_01", "mh_img_02", "mh_img_03"}
local GameImagePath = {"Images/EventCure/mh_di_02", "Images/EventCure/mh_di_03", "Images/EventCure/mh_di_10"}

---界面的入口函数
function TempleView:OnCreate(activity)
    self.activity = activity
    self.TypeCls = self.activity.typeClass
    self.OpenType = self.TypeCls.OpenType
    self.Data = self.TypeCls:GetCurActivitySelfData()
    self:LoadEffect()
    ---只要有未到达的积分奖励时 每天提醒一次红点
    local now = _G.TimeUtil.GetServerUnixTime()
    local sixClockTime = _G.TimeUtil.GetSixClockTimer()
    _G.PlayerPrefsManager.SetInt(
        _G.PlayerModel:GetInstance():GetPlayerUid() .. "TempleGame" .. self.TypeCls.ActivityId,
        now + sixClockTime - 86400
    )
    self.TypeCls:RefreshRedPointTemple()
    self.TypeCls:GetTempleRankInfo(_G.handler(self, self.SetData))
    self.go_table.aorimage_GameName.SpriteName = GameNameIcon[self.OpenType]
    self.go_table.aorimage_GameName.Alpha = 1
    self.go_table.aorrawimage_GameImage:LoadImage(GameImagePath[self.OpenType])
end

function TempleView:LoadEffect()
    for i = 1, 3 do
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_ItemCardAllView,
            self.go_table["obj_eff" .. i],
            function(trans)
                trans:SetAnchorPosition(5, -13, 0)
                trans:SetLocalScaleXYZ(1.25)
            end
        )
    end
end

function TempleView:GetTempleState()
    return self.activity:GetCurActivityState()
end

function TempleView:SetData()
    local endtime
    self.GoalInfo = self.Data.ScoreInfo
    endtime, self.EndTime = self.activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Settlement)
    self.State = self:GetTempleState()
    self.Progress = self.TypeCls:GetProgress()
    self.MScore = self.TypeCls.Mscore
    self.rankAllPlayers = self.TypeCls.rank_all_palers
    self.MyRankData = self.TypeCls.MyRankData
    self.MIndex = self.TypeCls:GetCurListIndex()
    self.RankInfo = self.Data.RankInfo
    self.GameId = self.TypeCls.GameId > 0 and self.TypeCls.GameId or 0
    self:InitView()
end

function TempleView:OnDestroy()
    if self.Timer ~= nil then
        self.Timer:Stop()
        self.Timer = nil
    end
    self.EndTime = nil
end
function TempleView:InitView()
    self.go_table.aorbtn_Challenge:SetGray(self.State ~= ActivitySynManager.State.Open)
    self.go_table.aortext_challenge.color =
        self.State == ActivitySynManager.State.Open and textColor.open or textColor.disable
    self.go_table.aortext_Score.text = self.MScore
    self.go_table.aorimage_jindutiao.fillAmount = self.Progress
    self.go_table.aortext_des.text = _G.GetLangPackValue(_G.ConfigManager.instruction_cfg[37].describe)
    self:SetItem()
    -- self:SetRankList()
    -- self:SetCurrentTiaoRank()
    if self.EndTime > 0 then
        self.go_table.aortext_GameName.text =
            _G.LangUtil.GetLangPackValue(90000010106, _G.TimeUtil.TranslateSecondForStrMiaoHui(self.EndTime))
        if self.EndTime >= 3660 then
            self.Timer = _G.TimerManager:GetInstance():GetTimer(60, self.OnTimeUpdateCall, self, false, false, true, 60)
        else
            self.Timer = _G.TimerManager:GetInstance():GetTimer(1, self.OnTimeUpdateCall, self, false, false, true, 1)
        end
        self.Timer:Start()
    else
        self.go_table.aortext_GameName.text = _G.LangUtil.GetLangPackValue(90000010091)
    end
end
function TempleView:OnTimeUpdateCall(_timeDelta,elapsed)
    if self.go_table == nil then
        return
    end
    self.EndTime = self.EndTime - elapsed
    self.go_table.aortext_GameName.text =
        _G.LangUtil.GetLangPackValue(90000010106, _G.TimeUtil.TranslateSecondForStrMiaoHui(Mathf.RoundToInt(self.EndTime)))
    if self.EndTime <= 3660 and _timeDelta ~= 1 then
        if self.Timer ~= nil then
            self.Timer:Stop()
            self.Timer = nil
        end
        self.Timer = _G.TimerManager:GetInstance():GetTimer(1, self.OnTimeUpdateCall, self, false, false, true, 1)
        self.Timer:Start()
    end
end

function TempleView:SetItem()
    local index = 0
    self.ItemList = {}
    for k, v in pairs(self.GoalInfo) do
        index = index + 1
        _G.GameUtil.SetActiveByCondition(self.go_table["aorbtn_" .. index], v.State == 2)
        self.go_table["aortext_score" .. index].text = _G.LangUtil.GetLangPackValue(90022100274, v.target)
        for i = 1, self.go_table["obj_root" .. index]:GetChildCountE() do
            self.go_table["obj_root" .. index]:GetChildE(0):DestroyObject()
        end
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            v.award[1].type,
            self.go_table["obj_root" .. index],
            function(tran)
                _G.table.insert(self.ItemList, tran)
                tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                tran:SetGou(v.State == 1)
            end
        )
        if v.State == 2 then
            self.go_table["obj_eff" .. index]:SetActiveE(1)
        end
    end
end
function TempleView:SetNothing(flag)
    -- _G.GameUtil.SetActiveByCondition(self.go_table.obj_nothing, flag)
end
--- 设置 listView
function TempleView:SetRankList()
    local index = (self.MIndex > 0 and self.MIndex <= 50) and self.MIndex - 1 or 0
    local count = #self.rankAllPlayers <= 50 and #self.rankAllPlayers or 50
    self:SetNothing(count == 0)
    if not self.isFirst then
        self.isFirst = true
        self.go_table.scrollloopvectical_rankList:InitItemData(count, _G.handler(self, self.RefreshItem), index)
        self.ListCount = count
    else
        if self.ListCount ~= count then
            self.go_table.scrollloopvectical_rankList:UpdateCount(count)
            self.ListCount = count
        else
            self.go_table.scrollloopvectical_rankList:UpdateAllItem()
        end
    end
end
function TempleView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    local x = index + 1
    local item = obj
    item:SetName(index + 1)
    local data = self.rankAllPlayers[x] or {}
    self:SetRankTiaoOne(obj, data, 1, x)
    return item
end
--region 更新
function TempleView:SetCurrentTiaoRank()
    local node = self.go_table.obj_currentRank
    self:SetRankTiaoOne(node, self.MyRankData, 2, self.MyRankData.mingci)
end
function TempleView:HeadClick(go, ref, data)
    local name = go:GetName()
    if name == "@_aorbtn_HeadClick" then
        if data.uid and data.uid > 0 then
            if data.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.PopWindowManager:GetInstance():ShowAllTips(620109)
            else
                _G.SystemSettingManager:GetInstance():OpenView(data.uid)
            end
        end
    end
end
---设置
function TempleView:SetRankTiaoOne(go, data, type, mingci)
    if _G.table.isEmptyOrNil(data) then
        return
    end
    local tb = _G.GetAutoGoTable(go, _G.handlerbind(self, self.HeadClick, data))
    if _G.table.isEmptyOrNil(data) then
        _G.GameUtil.SetActiveByCondition(tb.gameObject, false)
        return
    end
    _G.GameUtil.SetActiveByCondition(tb.aortext_myRank, data.isMy and type == 2)
    tb.aortext_name.text = data.name
    tb.aortext_score.text = data.value
    local flag = false
    if mingci == 0 or mingci > 50 then
        flag = false
        tb.aortext_rank_paiming.text = _G.ConfigManager.language_package_cfg[90022900040]
    elseif mingci > 0 then
        if mingci <= 3 then
            flag = true
            _G.GameUtil.SetActiveByCondition(tb.aorimage_paiming, true)
            if mingci == 1 then
                tb.aorimage_paiming.SpriteName = "tz_qjhs_phb_mingci_01"
                tb.aorimage_bg.SpriteName = "tz_qjhs_di_02"
            elseif mingci == 2 then
                tb.aorimage_paiming.SpriteName = "tz_qjhs_phb_mingci_02"
                tb.aorimage_bg.SpriteName = "tz_qjhs_di_03"
            elseif mingci == 3 then
                tb.aorimage_bg.SpriteName = "tz_qjhs_di_04"
                tb.aorimage_paiming.SpriteName = "tz_qjhs_phb_mingci_03"
            end
            tb.aortext_rank_paiming.text = ""
        else
            flag = false
            tb.aortext_rank_paiming.text = mingci
        end
    end

    _G.GameUtil.SetActiveByCondition(tb.obj_mingci, not flag)
    _G.GameUtil.SetActiveByCondition(tb.obj_rankBiaozhi, flag)
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data, 1, true)
end
--endregion
function TempleView:DisposeBox(i)
    self.ItemList[i]:SetGou(true)
end
--region 点击
---按钮点击事件在这里派发
function TempleView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_close" then
        self:CloseView()
    elseif name == "@_aorbtn_anyClose" then
        self:CloseView()
    elseif name == "@_aorbtn_Award" then
        self:ShowRankAward(true)
    elseif name == "@_aorbtn_CloseRankAward" then
        self:ShowRankAward(false)
    elseif name == "@_aorbtn_anyCloseRank" then
        self:ShowRankAward(false)
    elseif name == "@_aorbtn_help" then
        self:HelpOnClick()
    end
    if not self.activity:CheckActivityInteractable() then
        return
    end
    if name == "@_aorbtn_1" then
        self.TypeCls:GetAward(
            {1, self.GoalInfo[1].index},
            function()
                self:DisposeBox(1)
                self.go_table.obj_eff1:SetActiveE(0)
                self.go_table.aorbtn_1:SetActiveE(0)
            end
        )
    elseif name == "@_aorbtn_2" then
        self.TypeCls:GetAward(
            {2, self.GoalInfo[2].index},
            function()
                self:DisposeBox(2)
                self.go_table.obj_eff2:SetActiveE(0)
                self.go_table.aorbtn_2:SetActiveE(0)
            end
        )
    elseif name == "@_aorbtn_3" then
        self.TypeCls:GetAward(
            {3, self.GoalInfo[3].index},
            function()
                self:DisposeBox(3)
                self.go_table.obj_eff3:SetActiveE(0)
                self.go_table.aorbtn_3:SetActiveE(0)
            end
        )
    elseif name == "@_aorbtn_Challenge" then
        self:OpenView()
    end
end

function TempleView:OpenView()
    --1为音游，2为外卖小游戏，策划说固定死。
    --3为红包
    local TempleSynTypemManager = require "TempleSynTypemManager"
    if self.OpenType == TempleSynTypemManager.OpenType.EventCureView then
        _G.UIManager:GetInstance():OpenWindow(
            TempleSynTypemManager.OpenView[self.OpenType],
            nil,
            nil,
            {{self.GameId, 2, self.TypeCls}}
        )
    elseif self.OpenType == TempleSynTypemManager.OpenType.TakeOutGameView then
        _G.UIManager:GetInstance():OpenWindow(TempleSynTypemManager.OpenView[self.OpenType], self.TypeCls)
    elseif self.OpenType == TempleSynTypemManager.OpenType.RedPaperView then
        _G.UIManager:GetInstance():OpenWindow(TempleSynTypemManager.OpenView[self.OpenType], self.TypeCls)
    end
end

function TempleView:HelpOnClick()
    local TempleSynTypemManager = require "TempleSynTypemManager"
    if self.OpenType == TempleSynTypemManager.OpenType.EventCureView then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 37)
    elseif self.OpenType == TempleSynTypemManager.OpenType.TakeOutGameView then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 42)
    elseif self.OpenType == TempleSynTypemManager.OpenType.RedPaperView then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 61)
    end
end

function TempleView:ShowRankAward(isShow)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_RankAward, isShow)
    if isShow then
        if not self.isFirstRankAward then
            self.isFirstRankAward = true
            self.go_table.scrollloopvectical_rankAwardList:InitItemData(
                #self.RankInfo,
                _G.handler(self, self.RefreshItemRankAward)
            )
            self.RankAwardListCount = #self.RankInfo
        else
            if self.RankAwardListCount ~= #self.RankInfo then
                self.go_table.scrollloopvectical_rankAwardList:UpdateCount(#self.RankInfo)
                self.RankAwardListCount = #self.RankInfo
            else
                self.go_table.scrollloopvectical_rankAwardList:UpdateAllItem()
            end
        end
    end
end

function TempleView:RefreshItemRankAward(index, obj)
    if index < 0 then
        return
    end
    local x = index + 1
    local item = obj
    item:SetName(index + 1)
    local data = self.RankInfo[x] or {}
    self:SetRankTiao(obj, data, x)
    return item
end

---设置
function TempleView:SetRankTiao(go, data, x)
    if not data then
        _G.GameUtil.SetActiveByCondition(go, false)
        return
    end
    local tb = _G.GetAutoGoTable(go)
    local flag = false
    if x > 0 then
        if x <= 3 then
            flag = true
            _G.GameUtil.SetActiveByCondition(tb.aorimage_paiming, true)
            if x == 1 then
                tb.aorimage_paiming.SpriteName = "tz_qjhs_phb_mingci_01"
                tb.aorimage_bg.SpriteName = "tz_qjhs_di_02"
            elseif x == 2 then
                tb.aorimage_paiming.SpriteName = "tz_qjhs_phb_mingci_02"
                tb.aorimage_bg.SpriteName = "tz_qjhs_di_03"
            elseif x == 3 then
                tb.aorimage_bg.SpriteName = "tz_qjhs_di_04"
                tb.aorimage_paiming.SpriteName = "tz_qjhs_phb_mingci_03"
            end
            tb.aortext_rank_paiming.text = ""
        else
            flag = false
            tb.aortext_rank_paiming.text = data.min_rank .. "~" .. data.max_rank
        end
    end
    for i = 1, tb.obj_root:GetChildCountE() do
        _G.PoolsManager:GetInstance():Despawn(tb.obj_root:GetChildE(0), _G.ePoolType.UIItem)
    end
    for k, v in pairs(data.rewards) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            v.type,
            tb.obj_root,
            function(tran)
                tran.gameObject:SetLocalScaleXYZ(0.82)
                tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
        )
    end
    _G.GameUtil.SetActiveByCondition(tb.obj_mingci, not flag)
    _G.GameUtil.SetActiveByCondition(tb.obj_rankBiaozhi, flag)
end
--endregion

function TempleView:CloseView()
    self:Close()
end
--endregion

return TempleView
