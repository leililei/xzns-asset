    self.Caches = {}
    self.openingEmbattle = false
    --放置挂机（冒险 刷新 装备红点) 暂时存放
    _G.Events:GetInstance():AddListener(_G.eRedPointAFKEquip.RedPointRefreshAFkEquip, self.ChangAfkZhenRongData, self)
end

---销毁对象时,析构函数
function AfkBattleManager:Dispose()
    _G.Events:GetInstance():RemoveListener(
        _G.eRedPointAFKEquip.RedPointRefreshAFkEquip,
        self.ChangAfkZhenRongData,
        self
    )
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleOpened, self)
end

