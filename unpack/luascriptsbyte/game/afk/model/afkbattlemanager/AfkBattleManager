---获取当前挑战的布阵ID组
---@return number id
function AfkBattleManager:GetCurEmbattleID()
    local sceneids = self:GetMap()
    local ids
    local embattleType = _G.EmbattleType
    if #sceneids == 1 then
        ids = { embattleType.AFKOnly }
    else
        ids = { embattleType.AFKGroup1 }
        for i = 2, #sceneids do
            ids[i] = ids[i - 1] + 1
        end
    end
    return ids
end

---根据布阵数量 获取布阵ID组
---@param count number 数量
---@return table ID组
function AfkBattleManager:GetEmbattleIDS(count)
    local ids = {}
    for i = 1, count do
        ids[i] = 100000 + count * 100 + i
    end
    return ids
end

