--region 刷新红点 阵容数据 发生改变
function AfkBattleManager:ChangAfkZhenRongData(data, changeUids)
    if _G.table.isEmptyOrNil(changeUids.down) and _G.table.isEmptyOrNil(changeUids.up) then
        return
    end
    local RedPointManagerIns = require "RedPointManager":GetInstance()
    if not _G.table.isEmptyOrNil(changeUids.down) then
        for _, v in pairs(changeUids.down) do
            for _, v2 in pairs(_G.EquipmentPart) do
                if v2 ~= _G.EquipmentPart.Trousers then
                    RedPointManagerIns:RefreshNode(_G.ConfigManager.redpoint_cfg.RoleEquipment.id, v * 10 + v2)
                end
            end
            RedPointManagerIns:RefreshNode(_G.ConfigManager.redpoint_cfg.SpiritualPage.id, v)
            for i = 1, 4 do
                require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.DecorationSlot.id, v * 10 + i)
            end
            --_G.StorageManager:GetInstance().SelectCardUid = v
            --RedPointManagerIns:RefreshNode(_G.ConfigManager.redpoint_cfg.SpiritualPage.id, v)
        end
        RedPointManagerIns:RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.Spiritual.id) --需要刷新self.num参数
        RedPointManagerIns:RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.SpiritualLevelUp.id)

        RedPointManagerIns:RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.MineCardList.id)
    end
    RedPointManagerIns:RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.DecorationSlot.id)
    RedPointManagerIns:RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.EngraveSoulPage.id)
    --刷新红点 (放置挂机) --临时(装备，魂链，刻魂)
    RedPointManagerIns:RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RoleEquipment.id)
    --刷新 死魂塔的 快速挑战红点
    RedPointManagerIns:RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.DeadsoulFast.id)
    RedPointManagerIns:RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RoleArtifact.id)
    RedPointManagerIns:RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RoleArtifactUpgrade.id)
    RedPointManagerIns:RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.SpiritualPage.id)
    RedPointManagerIns:RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RedPointCardUpStar.id)
end

