-----计算战斗角色资源
function AfkBattleManager:CalculateBattleRole(cfg)
    local playerSids = {}
    local cacheFunc = function(sids)
        for i = 1, #sids do
            if sids[i] > 0 then
                if not playerSids[sids[i]] then
                    playerSids[sids[i]] = 1
                else
                    playerSids[sids[i]] = playerSids[sids[i]] + 1
                end
            end
        end
    end
    if #cfg.monster_group > 0 then
        --实际战斗
        -- for i = 1, #cfg.monster_group do
        local sids = _G.BattleManager:GetInstance():GetDefaultDefenserSids(cfg.monster_group[1])
        cacheFunc(sids)
        sids = _G.BattleManager:GetInstance():GetDefaultAttackSids(cfg.monster_group[1])
        cacheFunc(sids)
        -- end
    end
    return playerSids
end

