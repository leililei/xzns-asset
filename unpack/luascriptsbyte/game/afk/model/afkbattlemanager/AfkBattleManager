---检查布阵角色是否全部满足
---@param sid number    @关卡sid
---@return boolean
function AfkBattleManager:CheckEmbattleValid(sid)
    local cfg = _G.ConfigManager.afk_cfg[sid]
    if not cfg then
        return false
    end

    --获取布阵id
    ---@type number[]
    local embattleIds = {}
    if #cfg.monster_group == 1 then
        table.insert(embattleIds, _G.EmbattleType.AFKOnly)
    else
        for i = 1, #cfg.monster_group do
            if i == 1 then
                table.insert(embattleIds, _G.EmbattleType.AFKGroup1)
            else
                table.insert(embattleIds, embattleIds[i - 1] + 1)
            end
        end
    end

    --布阵id是否都是有效的
    ---@type EmbattleModel
    local embattleModel = require("EmbattleModel"):GetInstance()
    for _, embattleId in pairs(embattleIds) do
        if not embattleModel:CheckEmbattleData(embattleId) then
            return false
        end
    end
    return true
end

---检查当前关卡布阵是否满足
---@return boolean
function AfkBattleManager:CheckCurrentEmbattleValid()
    return self:CheckEmbattleValid(require("AfkModel"):GetInstance():GetCurSection())
end

