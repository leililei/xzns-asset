---更新下一场战斗的布阵(多场战斗)
---@param callback fun(ok:boolean):void
function AfkBattleManager:UpdateNextEmbattle(callback)
    local monsterGroupIds = self:GetMap()
    if #monsterGroupIds == 1 then
        if callback then
            callback(true)
        end
        return
    end
    ---@type EmbattleModel
    local embattleModel = require("EmbattleModel"):GetInstance()
    ---获取当前挑战中的布阵id, 并且校验布阵数据
    local curEmbattleId = _G.EmbattleType.AFKGroup1 + self:GetPage() - 1
    if not embattleModel:CheckEmbattleData(curEmbattleId) then
        if callback then
            callback(false)
        end
        return
    end
    --更新布阵数据
    embattleModel:SaveEmbattleDataNew(
        curEmbattleId,
        function(ret)
            if callback then
                callback(ret == 0)
            end
        end,
        _G.EmbattleSaveType.localfile,
        false
    )
end

