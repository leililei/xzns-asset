---初始化布阵sid组
function AfkBattleManager:InitCurEmbattleSids()
    self.curEmbattleSids = {}
    local cfgs = _G.ConfigManager.monster_cfg
    local monsterGroupID = require("AfkModel"):GetInstance():GetSceneID()[1]
    local groupCfg = _G.ConfigManager.monster_group_cfg[monsterGroupID]
    local storyEmbattle = _G.DeepCopyCfgTable(groupCfg.DefaultAttackerSids)
    for i = 1, 5 do
        if storyEmbattle[i] > 1 then
            storyEmbattle[i] = cfgs[storyEmbattle[i]].CardID
            self.curEmbattleSids[storyEmbattle[i]] = 1
        end
    end
    local data = require("EmbattleModel"):GetInstance():GetEmbattleSidsData(_G.EmbattleType.AFKOnly)
    for i = 1, 5 do
        if data[i] > 0 and not self.curEmbattleSids[data[i]] then
            if storyEmbattle[i] == 0 then
                self.curEmbattleSids[data[i]] = 1
            end
        end
    end
    storyEmbattle = _G.DeepCopyCfgTable(groupCfg.DefaultDefenserSids[1])
    for i = 1, 5 do
        if storyEmbattle[i] > 1 then
            storyEmbattle[i] = cfgs[storyEmbattle[i]].CardID
            if self.curEmbattleSids[storyEmbattle[i]] then
                self.curEmbattleSids[storyEmbattle[i]] = self.curEmbattleSids[storyEmbattle[i]] + 1
            else
                self.curEmbattleSids[storyEmbattle[i]] = 1
            end
        end
    end
end

---缓存资源
---@param callback function 完成回调
function AfkBattleManager:CoCacheAfkRes(callback)
    local afkCfgId = require("AfkModel"):GetInstance():GetCurSection()
    if afkCfgId == nil or afkCfgId <= 0 then
        if callback then
            callback()
        end
        return
    end
    self:InitCurEmbattleSids()
    local playerRes = {}
    for id, num in pairs(self.curEmbattleSids) do
        for i = 1, num do
            playerRes[#playerRes + 1] = require "CardInfoManager".GetBattleModelPath(id)
        end
    end
    local count = #playerRes
    local index = 0
    local loadDone = false
    local loadCallback = function()
        count = count - 1
        if count <= 0 then
            --场景
            if callback then
                callback()
            end
        end
    end
    --角色
    if count > 0 then
        local PoolsManagerIns = _G.PoolsManager:GetInstance()
        local statictype = _G.ePoolType.Static
        for i = 1, count do
            PoolsManagerIns:Preload(playerRes[i], loadCallback, statictype)
        end
    else
        loadCallback()
    end
end

