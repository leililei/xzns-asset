---进入布阵界面，准备战斗
---@param autofight boolean 是否自动进入战斗
function AfkBattleManager:EnterEmbattle(autofight)
    self:SetAutoFight(autofight)
    local openFun = function()
        --ZHJ-35204【放置关卡】下一关的倒计时1s时快速点击聊天，再快速点击玩家头像，会出现场景穿透
        --此变量指示是否正在加载布阵中
        self.openingEmbattle = true

        _G.CS.BattleManager.Inst:Destroy()
        _G.BattleManager:GetInstance():SetRendererActiveState(true)

        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleOpened, self)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ShadowTopView.Name)
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.AfkEmbattleView.Name,
            _G.handler(self, self.ExitEmbattle),
            function(scene)
                self:EnterFight(scene, true)
            end,
            autofight
        )
    end
    local cfg = require("AfkModel"):GetInstance():GetCurSectionCfg()
    if cfg and cfg.FrontBuzhenStoryID > 0 and _G.StoryUtilities.HasStoryIDSavedUID(cfg.FrontBuzhenStoryID) == false then
        self.isFrontEmbattleStory = true
        _G.AutomaticPlayStory.PlayStoryByID(
            cfg.FrontBuzhenStoryID,
            function()
                openFun()
            end
        )
    else
        openFun()
    end
end

