---进入战斗
---@param scene monster_group_cfg  ID
---@param showFightView boolean 是否显示战斗页面(默认true)
function AfkBattleManager:EnterFight(scene, showFightView)
    self.openingEmbattle = false
    --存储战斗状态
    self.fighting = true
    self.fightingView = showFightView == nil and true or showFightView

    --对战双方名称
    local afkModel = require("AfkModel"):GetInstance()
    local cfg = _G.ConfigManager.afk_cfg[afkModel:GetCurSection()]
    local nameT = afkModel:GetCurChapterName()
    local leftName, rightName =
        _G.PlayerModel:GetInstance():GetName(),
        string.format("%s  %d-%d", _G.GetLangPackValue(nameT[1]), cfg.chapter, cfg.section)

    _G.Events:GetInstance():AddListener(_G.FightPlayState.FightStart, self.OnFightStartInBackground, self)
    _G.BattleManager:GetInstance():EnterFight(_G.BattleControllerType.afkChallenge, scene, leftName, rightName)

    --显示主页面下边栏
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    _G.MainManager:GetInstance():RefreshAfkWindow()
    _G.MainManager:GetInstance():RefreshAfkToggleEffect()

    --初始化下边栏动画
    ---@type MainView
    local mainView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name)
    if mainView then
        mainView:InitAnimation()
    end
end

---监听战斗界面打开后后, 隐藏战斗界面
---@return void
function AfkBattleManager:OnBattleViewOpenedInBackground(name)
    if name ~= _G.ConfigManager.ui_cfg.BattleView.Name then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnBattleViewOpenedInBackground, self)
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.BattleView.Name)
    if view then
        view:Hide()
    end
end

---监听进入战斗界面后, 隐藏战斗界面
---@return void
function AfkBattleManager:OnFightStartInBackground(name)
    _G.Events:GetInstance():RemoveListener(_G.FightPlayState.FightStart, self.OnFightStartInBackground, self)

    --设置是否显示战斗页面
    local isToggledAfk = _G.MainManager:GetInstance():IsToggledAfkWindow(true)
    local isShowFighting = isToggledAfk and self:IsShowFighting()
    ---@type BattleView
    local battleView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.BattleView.Name)
    if battleView then
        if isShowFighting then
            battleView:Show()
        else
            battleView:Hide()
        end
    end
    self:SetFightView(isShowFighting)

    --播放下边栏动画
    if isToggledAfk then
        ---@type MainView
        local mainView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name)
        if mainView then
            mainView:PlayAnimation()
        end
    end
end

