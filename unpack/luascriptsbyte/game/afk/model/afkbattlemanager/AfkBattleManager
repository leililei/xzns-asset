---获取所有场次的统计数据
---@param cfg afk_cfg
---@return table 统计数据
function AfkBattleManager:GetStatisticsData(cfg)
    if _G.table.isEmptyOrNil(self.statisticsTab) then
        return nil
    end
    cfg = cfg or require("AfkModel"):GetInstance():GetPreviousSectionCfg()
    local data = cfg.monster_group
    local statistics = { FighterInfo = {} }
    for i = 1, #data do
        statistics.FighterInfo[i] = self.statisticsTab[data[i]].FighterInfo[1]
        statistics.FighterInfo[i].TeamIndex = i
    end
    return statistics
end

