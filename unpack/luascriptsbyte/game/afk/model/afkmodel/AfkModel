--镇魂街ZHJ-34446 Beta_1.0.0公测BuglistZHJ-34967
--【快速挂机】VIP等级到达9级买完快速挂机次数后重登，显示购买次数-1
--重新计算一下self.FreeRewardTimeNum，因为刚进游戏算出来缓存的可能不是实时完整的
--重新计算一下self.RewardConsume,避免消耗显示不一致
function AfkModel:UpdateFreeRewardTimeNum()
    self.FreeRewardTimeNum = 0
    --重置self.RewardConsume，按照最新的免费次数在消耗里面添加0的个数
    self.RewardConsume = _G.DeepCopyCfgTable(_G.ConfigManager.discrete_cfg[discreteID.RewardConsume][1])
    if require "MonthlyModel":GetInstance():IsUnlockMonthCard(401003, 1) then
        self.MonthlyModelIs = true

        local store_month_cfg = _G.ConfigManager.store_month_cfg[401003]
        local num = _G.ConfigManager.privilege_cfg[store_month_cfg.extra_first[1]]
        self.FreeRewardTimeNum = num.privilege[1][2]
        _G.table.insert(self.RewardConsume, 1, 0)
    end

    ---VIP特权增加的次数
    local count = require "HellRoadModel":GetInstance():GetNumber({ _G.PrivilegeType.QuickGetReward.Privileged })
    self.FreeRewardTimeNum = self.FreeRewardTimeNum + count
    for i = 1, count do
        _G.table.insert(self.RewardConsume, 1, 0)
    end
end

local CheckPrivilege = function()
    local datas = require "PrivilegeManager":GetInstance():GetPrivilegeDataNew({ _G.PrivilegeType.Afk.ItemPer })
    local tb = {}
    for _, v in pairs(datas) do
        tb[v[2]] = v[3]
    end
    return { _G.table.count(tb) > 0, tb }
end

