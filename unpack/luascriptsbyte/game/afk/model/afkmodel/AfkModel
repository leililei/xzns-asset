function AfkModel:CheckZengyi()
    self.ZengyiAward = {}
    if not self.CurAfkCfgAward then
        return
    end
    local PriRes = CheckPrivilege()
    if PriRes[1] and _G.table.count(PriRes[2]) > 0 then
        local tb = PriRes[2]
        local num
        local time = _G.ConfigManager.discrete_cfg[discreteID.QuickGetPlace][1][1]
        ---@type afk_cfg
        local Afkcfg = _G.ConfigManager.afk_cfg[self.LastSid]
        if not Afkcfg then
            return
        end
        for _, v in pairs(Afkcfg.eff_item) do
            if tb[v[1]] then
                num = math.floor(time / v[2] * (tb[v[1]] * 0.0001))
                insertAfkQuickAward(self.ZengyiAward, v[1], num, true)
            end
        end
        if tb[11] then
            num = math.floor(time / 30 * Afkcfg.eff_coin * (tb[11] * 0.0001))
            insertAfkQuickAward(self.ZengyiAward, 11, num, true)
        end
        if tb[22] then
            num = math.floor(time / 30 * Afkcfg.eff_exp_hero * (tb[22] * 0.0001))
            insertAfkQuickAward(self.ZengyiAward, 22, num, true)
        end
    end
end

function AfkModel:SetCurAfkQuickAward()
    self.CurAfkCfgAward = {}
    local lastSid = self.LastSid
    if lastSid == 0 then
        return
    end

    if self.quickAfkSid ~= lastSid then
        local DropPreciousCfg = {}
        local DropCfg
        local Afkcfg = _G.ConfigManager.afk_cfg[lastSid]
        if #Afkcfg.eff_precious > 0 then
            for i = 1, #Afkcfg.eff_precious do
                _G.table.insert(DropPreciousCfg, _G.ConfigManager.afk_drop_cfg[Afkcfg.eff_precious[i][1]])
            end
        end
        if Afkcfg.eff_equip[1] then
            DropCfg = _G.ConfigManager.afk_drop_cfg[Afkcfg.eff_equip[#Afkcfg.eff_equip][1]]
        end
        local num
        local time = _G.ConfigManager.discrete_cfg[discreteID.QuickGetPlace][1][1]
        num = math.floor(time / 30) * Afkcfg.eff_exp_team
        insertAfkQuickAward(self.CurAfkCfgAward, 21, num)
        num = math.floor(time / 30) * Afkcfg.eff_exp_hero
        insertAfkQuickAward(self.CurAfkCfgAward, 22, num)
        num = math.floor(time / 30) * Afkcfg.eff_coin
        insertAfkQuickAward(self.CurAfkCfgAward, 11, num)
        for i = 1, #Afkcfg.eff_item do
            num = math.floor(time / Afkcfg.eff_item[i][2])
            if num > 0 then
                insertAfkQuickAward(self.CurAfkCfgAward, Afkcfg.eff_item[i][1], num)
            end
        end
        if not _G.table.isEmptyOrNil(DropPreciousCfg) then
            for k, v in pairs(DropPreciousCfg) do
                for i = 1, #v.equip do
                    insertAfkQuickAward(self.CurAfkCfgAward, v.equip[i], 1)
                end
            end
        end
        if DropCfg then
            for i = 1, #DropCfg.equip do
                insertAfkQuickAward(self.CurAfkCfgAward, DropCfg.equip[i], 1)
            end
        end
        if #self.CurAfkCfgAward > 0 then
            _G.SortList(
                    self.CurAfkCfgAward,
                    function(a)
                        local grade = 0
                        local Id = 0
                        if a[2] == 21 then
                            Id = 999
                        end
                        if a[2] == 22 then
                            Id = 998
                        end
                        if a[2] == 11 then
                            Id = 997
                        end
                        local typeA = _G.StorageManager:GetInstance():CheckSidType(a[2])
                        local CurrencyCfg = _G.ConfigManager.currency_type_cfg --货币资源
                        local ItemCfg = _G.ConfigManager.item_cfg --道具资源
                        local EquipmentCfg = _G.ConfigManager.equipment_cfg --装备资源
                        if CurrencyCfg[a[2]] then
                            grade = CurrencyCfg[a[2]].Quality
                        elseif ItemCfg[a[2]] then
                            grade = ItemCfg[a[2]].Quality
                        elseif EquipmentCfg[a[2]] then
                            grade = EquipmentCfg[a[2]].grade
                        else
                            grade = 0
                        end
                        return Id, -typeA, grade, -a[2]
                    end
            )
        end
    end
end

