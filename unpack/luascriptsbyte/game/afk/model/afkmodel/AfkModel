function AfkModel:ParseData(data)
    self.FreeRewardTimeNum = 0
    self.FreeRewardTime = 0
    self.RewardConsume = _G.ConfigManager.discrete_cfg[discreteID.RewardConsume][1]
    if data ~= nil then
        self.LastSid = data.sid
        self.RewardTime = data.num
        self.AfkStartTime = data.time
        if _G.AppSetting.IsDouYin then
            require("DouyinModel"):GetInstance():StoreFeedData(self.AfkStartTime)
        end
        self:SetCurFailTime(data.fail_time or 0)
        self:CheckAfkAwardBox()
        self.checkTime = data.check_time
    end
    for i = 1, #self.RewardConsume do
        if self.RewardConsume[i] > 0 then
            break
        end
        self.FreeRewardTime = self.FreeRewardTime + 1
    end
    self.BaseFreeTime = self.FreeRewardTime
    self.FreeRewardTime = self.FreeRewardTime - self.RewardTime
    -- if self.FreeRewardTime < 0 then
    --     self.FreeRewardTime = 0
    -- end
    self.MonthlyModelIs = false
    self:UnlockSection()
    self.ticketNum = _G.StorageManager:GetInstance():GetItemCountBySid(ticketId)
    base.ParseData(self)
    require "AfkTaskModel":GetInstance():GetAfkDataCallback(data)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.AfkQuick.id)
end

