    return _G.GlobalConditionManager.CheckConditionArrays({ con[2] })
end

---检测快速挂机奖励里还有没有限时掉落的货币
function AfkModel:CheckQuickLimitDrop()
    local dataT = require "ActivitySynManager":GetInstance():GetActivityByType(10052) or {}
    for k, data in pairs(dataT) do
        if data.typeClass:CheckOpenCondition() then
            return true
        end
    end
    return false
end

---获取玩家到可战斗等级所需要的挂机时间
function AfkModel:GetCanBattleAfkTime(nextLevel)
    local sectionCfg = self:GetCurSectionCfg()
    if not sectionCfg then
        return 0
    end
    local cfg = _G.ConfigManager.afk_cfg[sectionCfg.id]
    local exp = cfg and cfg.eff_exp_team or 0
    local privilege = require "PrivilegeManager":GetInstance():GetPrivilegeDataNew({ _G.PrivilegeType.Afk.ItemPer, 22 })
    if privilege and privilege[1] then
        exp = (1 + privilege[1][3] / 10000) * exp
    end
    ---配置上是配置的30秒的效率
    exp = exp / 30
    local level
    if not nextLevel then
        level = sectionCfg.limit_condition and sectionCfg.limit_condition[2]
    end
    local needExp = _G.PlayerModel:GetInstance():GetNextLevelNeedExp(level)
    return _G.Mathf.Floor(needExp / exp)
end

---@return AfkModel
return AfkModel
