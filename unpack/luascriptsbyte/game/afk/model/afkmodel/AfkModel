---放置挂机宝箱是否可以弹出
function AfkModel:CheckAfkAwardBox()
    local time = _G.TimeUtil.GetServerUnixTime() - self.AfkStartTime
    local popTime = _G.ConfigManager.discrete_cfg[120005][1][1]
    self.canShowAfkBox = time >= popTime
    self:StopAfkAwardBox()
    if time < popTime then
        self.afkAwardTimer = _G.TimerManager:GetInstance():GetTimer(
                popTime - time,
                function()
                    self.canShowAfkBox = true
                    self:StopAfkAwardBox()
                end,
                self,
                true,
                false,
                false
        )
        self.afkAwardTimer:Start()
    else
        if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(267) then
            return
        end
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name)
        if view then
            view:ShowAfkBox()
        end
    end
end

