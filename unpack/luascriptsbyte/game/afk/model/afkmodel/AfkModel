function AfkModel:GetCurAfkQuickAwawrd()
    self.CurAfkQuickAward = {}
    self.CurAfkQuickAward[1] = {}
    self.CurAfkQuickAward[2] = {}
    if self.ZengyiAward then
        for i, v in pairs(self.ZengyiAward) do
            if v[2] == 11 or v[2] == 21 or v[2] == 22 then
                _G.table.insert(self.CurAfkQuickAward[1], v)
            else
                _G.table.insert(self.CurAfkQuickAward[2], v)
            end
        end
    end
    if self.CurAfkCfgAward then
        for i, v in pairs(self.CurAfkCfgAward) do
            if v[2] == 11 or v[2] == 21 or v[2] == 22 then
                _G.table.insert(self.CurAfkQuickAward[1], v)
            else
                _G.table.insert(self.CurAfkQuickAward[2], v)
            end
        end
    end
    if self:CheckQuickLimitDrop() then
        local data = require "ActivitySynManager":GetInstance():GetActivityByType(10052) or {}
        for k, v in pairs(data) do
            local totalTime = _G.ConfigManager.discrete_cfg[discreteID.QuickGetPlace][1][1]
            local intervalTime = _G.ConfigManager.discrete_cfg[101104][1][1]
            local times = math.floor(totalTime / intervalTime)
            for key, value in pairs(v.typeClass.info.award_cfg.award or {}) do
                if value.type[1] ~= 0 then
                    insertAfkQuickAward(self.CurAfkQuickAward[1], value.type[1], value.type[2] * times)
                else
                    insertAfkQuickAward(self.CurAfkQuickAward[1], value.type[4], value.type[5] * times)
                end
            end
            for key, value in pairs(v.typeClass.info.award_cfg.rand_award or {}) do
                if value.type[1] ~= 0 then
                    insertAfkQuickAward(self.CurAfkQuickAward[2], value.type[1], value.type[2])
                else
                    insertAfkQuickAward(self.CurAfkQuickAward[2], value.type[4], value.type[5])
                end
            end
        end
    end
    return _G.DeepCopy(self.CurAfkQuickAward)
end

