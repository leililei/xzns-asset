---检测消耗
function AfkModel:CheckRewardConsume()
    if self.FreeRewardTime + self.FreeRewardTimeNum > 0 then
        return true
    end
    self.ticketNum = _G.StorageManager:GetInstance():GetItemCountBySid(ticketId)
    if self.ticketNum > 0 then
        return true
    end
    if self.RewardTime >= self.MaxRewardTime + self.FreeRewardTimeNum then
        _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.MaxReward)
        return false
    end
    local time = self.RewardTime + 1
    if time > #self.RewardConsume then
        time = #self.RewardConsume
    end
    if not _G.StorageManager:GetInstance():CheckItem(_G.ResPropID.Diamond, self.RewardConsume[time]) then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ResPropID.Diamond)
        return false
    end
    return true
end

