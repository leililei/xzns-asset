---红点是否显示
---@return boolean 是否显示红点
function AfkModel:IsShowRedPoint()
    if self.CurFailTime == 0 then
        return 0
    else
        ---@type number 总共阶段数量
        local maxStateCount = 3
        ---@type number 开阶段间隔天数
        local stateOffsetDay = 1
        local time = _G.TimeUtil.GetServerUnixTime()
        local day = _G.TimeUtil.GetInterValDayByGame(self.CurFailTime, time)
        local curState = math.floor(day / stateOffsetDay) + 1
        curState = math.min(maxStateCount, curState)
        if curState > self.ClickDefDetailStage then
            return true
        else
            return false
        end
    end
end

