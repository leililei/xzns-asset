---获取快速挂机奖励
function AfkModel:GetQuickAfkAwardSuc(data, call)
    if data.ack ~= 1 then
        return
    end
    local Coin = 0
    _G.StorageManager:GetInstance():ReceiveAwardData(data)
    if self.type == 1 then
        self.RewardTime = self.RewardTime + 1
        if self.FreeRewardTime + self.FreeRewardTimeNum > 0 then
            self.FreeRewardTime = self.FreeRewardTime - 1
        else
            local haveD = false
            if data.award and data.award.item then
                for k, v in pairs(data.award.item) do
                    if v.type[1] == _G.ResPropID.Diamond then
                        haveD = true
                        break
                    end
                end
            else
                haveD = true
            end
            if not haveD then
                _G.StorageManager:GetInstance():ConsumeItem(
                        _G.ResPropID.Diamond,
                        0,
                        self.RewardConsume[self.RewardTime]
                )
            end
        end
    elseif self.type == 2 then
        _G.StorageManager:GetInstance():ConsumeItem(ticketId, 0, 1)
    end
    self.type = 0
    for k, v in pairs(data.award.item) do
        if v.type[1] == _G.ResPropID.Coin then
            Coin = v.type[2]
        end
    end

    if call ~= nil then
        call(data)
    end
    _G.Events:GetInstance():Broadcast(_G.eAfkEvents.GetAfkAward)
    -- _G.Events:GetInstance():Broadcast(_G.eSeasonTask.Action, {_G.SeasonTaskID.AfkBox}, 1)
end

---@param noUITip boolean 不展示UI奖励
function AfkModel:GetAfkAward(callback, noUITip)
    local msg = {}
    local time = _G.TimeUtil.GetServerUnixTime()
    msg.time = time
    require "AfkNet":GetInstance():GetAfkAward(
            msg,
            function(data)
                local OldTime = self.AfkStartTime
                local maxtime = _G.ConfigManager.discrete_cfg[discreteID.ResultIntervalTime][1][1]
                local extra = 0
                if (time - OldTime) < self.MaxTimer then
                    --- 每六十秒一次奖励 保留当前秒  1:26秒领取   领取后 0;26秒开始计时
                    extra = (time - OldTime) % maxtime
                else
                    --- 达到最大挂机时间  不用考虑当前秒
                end
                self.checkTime = time
                self.AfkStartTime = time - extra
                self:CheckAfkAwardBox()
                _G.StorageManager:GetInstance():ReceiveAwardData(data)
                if noUITip then
                    if callback then
                        callback(data)
                    end
                else
                    _G.PopWindowManager:GetInstance():AddAwardPopQuene(
                            data,
                            callback,
                            { nil, nil, nil, nil, nil, nil, nil, nil, nil, true }
                    )
                end
                self.data = {}
                if _G.AppSetting.IsDouYin then
                    require("DouyinModel"):GetInstance():StoreFeedData(self.AfkStartTime)
                end

                _G.Events:GetInstance():Broadcast(_G.eSeasonTask.Action, { _G.SeasonTaskID.AfkBox }, 1)
                _G.Events:GetInstance():Broadcast(_G.eAfkEvents.GetAfkAward)
            end
    )
end

function AfkModel:CheckAfkAward(call)
    local msg = {}
    local time = _G.TimeUtil.GetServerUnixTime()
    if self.data and time - self.checkTime < _G.ConfigManager.discrete_cfg[discreteID.ResultIntervalTime][1][1] then
        if call then
            if _G.table.isEmptyOrNil(self.data) then
                call(self.AfkStartTime, {})
            else
                call(self.AfkStartTime, self.data)
            end
        end
        return
    end
    msg.check_time = time
    require "AfkNet":GetInstance():CheckAfkAward(msg, _G.handlerbind(self, self.CheckAfkAwardSuc, time, call))
end

