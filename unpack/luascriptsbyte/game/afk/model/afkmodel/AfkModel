function AfkModel:GetSectionDefendersBySid(sid)
    local isShow = true
    local monster_group_cfg = _G.ConfigManager.monster_group_cfg
    if sid <= 0 then
        return nil
    end
    local groupId = _G.DeepCopyCfgTable(self.cfg[sid].monster_group)
    local DefaultDefenserSids
    local group
    if #groupId > 0 then
        DefaultDefenserSids = _G.DeepCopyCfgTable(monster_group_cfg[groupId[1]].DefaultDefenserSids)
        if #DefaultDefenserSids > 0 then
            group = DefaultDefenserSids[1]
        end
    end
    if group then
        _G.SortList(
                group,
                function(a)
                    if a == 0 then
                        isShow = false
                    end
                    return a
                end
        )
