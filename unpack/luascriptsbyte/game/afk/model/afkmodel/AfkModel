function AfkModel:GetAllActiveGoal()
    self.AfkTask = {}
    for k, v in pairs(mission_cfg) do
        if v.condition[1][1] == 53 then
            self.ActiveTaskChapterEndAward[v.id] = v.condition[1][2]
            _G.table.insert(self.AfkTask, { v.id, v.condition[1][2] })
        end
    end
    if self.AfkTask then
        _G.SortList(
                self.AfkTask,
                function(a)
                    return -a[2]
                end
        )
    end
end

