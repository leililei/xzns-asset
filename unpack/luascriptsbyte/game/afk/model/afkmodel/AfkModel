---解锁关卡
function AfkModel:UnlockSection()
    if not self.LastSid then
        return
    end
    local tmp, lastTmp
    ---@param v afk_cfg
    for _, v in pairs(self.cfg) do
        if v.pre_section == self.LastSid then
            tmp = v
            break
        else
            if lastTmp == nil and v.id == self.LastSid then
                lastTmp = v
            end
        end
    end
    if tmp ~= nil then
        -- if not self.OnSixUpdateTag then
        --     require "DungonesModel":GetInstance():AfkPassLockCollecion()
        -- end
        self.CurSid = tmp.id
        self.pass = _G.DeepCopyCfgTable(self.cfg[self.CurSid].monster_group)
        self.passCardSids = {}
        self.CurAfkChapter = tmp.chapter
        require "CampsiteModel":GetInstance():UnLockCaowei()
    else
        ---- 如果未找到可挑战的下一关 用之前的id 防止报错异常
        self.CurSid = self.LastSid
        self.pass = _G.DeepCopyCfgTable(self.cfg[self.CurSid].monster_group)
        self.passCardSids = {}
        self.CurAfkChapter = lastTmp.chapter

        if _G.AppSetting.DEBUG then
            _G.LogWarning("AFK 未找到配置的 下一关!!!!!!  当前通关" .. self.LastSid)
        end
    end
    self.CurMonsterID = self.pass[1]
    --region --------------------------------------镇魂街ZHJ-10348【客户端】二倍速开放时为默认开启状态--------
    ---标记是否设置过默认2倍速
    if _G.PlayerPrefsManager.GetInt("IsInitFightSpeed", 999) == 999 then
        if self.LastSid then
            ---获取2倍速功能解锁关卡
            ---@type function_open_cfg
            local function_open_cfg = _G.ConfigManager.function_open_cfg[_G.FunctionID.Speed2]
            if function_open_cfg.condition_type[1][1] == 4 and self.LastSid == function_open_cfg.condition_type[1][2] then
                _G.CS.BattleManager.Inst:LuaCallCsSetSpeed(1)
                _G.PlayerPrefsManager.SetInt("IsInitFightSpeed", 1)
            end
        end
    end
    --endregion------------------------------------镇魂街ZHJ-10348【客户端】二倍速开放时为默认开启状态--------

    ---镇魂街ZHJ-25224 【0722】【双版本】需进热更任务ZHJ-26226【客户端】战斗4倍速开启优化
    ---解锁四倍速时默认设置为四倍速
    if (_G.PlayerPrefsManager.GetInt("IsInitFightSpeed4", 999) == 999) then
        if self.LastSid then
            ---获取4倍速功能解锁关卡
            ---@type function_open_cfg
            local function_open_cfg = _G.ConfigManager.function_open_cfg[_G.FunctionID.Speed4]
            if
            ((function_open_cfg.condition_type[1][1] == 4) and
                    (self.LastSid == function_open_cfg.condition_type[1][2]))
            then
                _G.CS.BattleManager.Inst:SetExSpeedIndex(1)
                _G.CS.BattleManager.Inst:LuaCallCsSetSpeed(2)
                _G.PlayerPrefsManager.SetInt("IsInitFightSpeed4", 1)
            end
        end
    end
end

---获取当前效率  配置的是 每30s   分钟显示时注意！！！
---@param params table<number,number> 效率ID,时间参数
function AfkModel:GetCurEfficiency(UseParameter)
    local params = { _G.tonumber(UseParameter[1]), _G.tonumber(UseParameter[2]) }
    local data = {}
    local cfg = self.cfg[self.cfg[self.CurSid].pre_section]
    local ResPropID = _G.ResPropID
    data[ResPropID.HoreExp] = cfg and _G.Mathf.RoundToInt(params[2] / 30 * cfg.eff_exp_team) or 0
    data[ResPropID.CardExp] = cfg and _G.Mathf.RoundToInt(params[2] / 30 * cfg.eff_exp_hero) or 0
    data[ResPropID.Coin] = cfg and _G.Mathf.RoundToInt(params[2] / 30 * cfg.eff_coin) or 0
    if data[params[1]] then
        return data[params[1]]
    end
    if cfg then
        for _, v in pairs(cfg.eff_item) do
            if v[1] == params[1] then
                return _G.Mathf.RoundToInt(params[2] / v[2])
            end
        end
    end
    return 0
end

