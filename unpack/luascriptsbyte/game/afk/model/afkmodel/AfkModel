---判断vip是否开启了4倍速特权
function AfkModel:CheckVipSpeed4()
    local flag = false
    local data1 = require "PrivilegeManager":GetInstance():GetPrivilegeData({ _G.PrivilegeType.VIP.unlockFunction })
    if data1 and data1[1] then
        local check_type = type(data1[1])
        local count = 1
        if check_type == "number" then
            -- 检测是不是数值类型
            count = 1
        else
            count = 2
        end
        for i = 1, #data1 do
            if count < 2 then
                if data1[i] == _G.FunctionID.Speed4 then
                    flag = true
                end
            else
                if data1[i][2] == _G.FunctionID.Speed4 then
                    flag = true
                end
            end
        end
    end
    return flag
end

