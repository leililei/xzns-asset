local base = require("BaseGameNet")
---@class AfkNet : BaseGameNet	通信协议
local AfkNet = _G.BaseClass("AfkNet", base)

---@return AfkNet AfkNet
function AfkNet:GetInstance()
    return base.GetInstance(self)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function AfkNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function AfkNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---获取挂机信息
---@param callback function 完成回调
function AfkNet:GetAfkInfo(callback)
    self:Access(_G.ConfigManager.net_map.game_afk_info, self:GetEmptyPB(), callback)
end

---查看挂机奖励
---@param callback function
function AfkNet:CheckAfkAward(pbData, callback)
    self:Access(_G.ConfigManager.net_map.game_afk_check_award, pbData, callback)
end

---获取快速挂机奖励
---@param callback function 完成回调
