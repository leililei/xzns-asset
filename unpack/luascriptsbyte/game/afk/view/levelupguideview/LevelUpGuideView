local HellRoadModel = require("HellRoadModel")
local AfkModel = require("AfkModel")

---@class LevelUpGuideView : UIBaseView    中文描述
---@field public go_table LevelUpGuideView_GoTable GoTable
---@field cfgList limit_broken_cfg[]
local LevelUpGuideView = _G.BaseClass("LevelUpGuideView", _G.UIBaseView)

local GetLangPackValue = _G.GetLangPackValue
---玩法列表
local PlayList = {
    "AfkAward",      -- 快速挂机
    "QuickAfkAward", ---快速挂机
    "Privilege"      ---挂机特权
}

---玩法数据
local PlayData = {
    [PlayList[1]] = {
        title = GetLangPackValue(90000011021),
        icon = "ImagesH5/nAFK/ui_box2",
        OpenView = function()
            AfkModel:GetInstance():CheckAfkAward(
                function(time, data)
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetawardView.Name, time, data)
                end
            )
        end
    },
    [PlayList[2]] = {
        title = GetLangPackValue(91112100101),
        icon = "ImagesH5/nAFK/kuaisuguaji",
        OpenView = function()
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.QuickGetRewardView.Name
            )
        end
    },
    [PlayList[3]] = {
        title = GetLangPackValue(90000001138),
        icon = "ImagesH5/nAFK/guajitequan",
        OpenView = function()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LimitedTimePrivilegeView.Name, 405005)
        end
    }
}

local discreteID = {
    MaxafkTime = 101103
}

function LevelUpGuideView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    self:AddListener(_G.eAfkEvents.GetAfkAward, self.InitView)
    self:AddListener(_G.eLimitePrivilege.LimitePrivilegeChange, self.InitView)
    self:AddListener(_G.eSixUpdate.SixClockUpdate, self.InitView)
end

---界面的入口函数
function LevelUpGuideView:OnCreate()
    local privilegetime = HellRoadModel:GetInstance():GetNumber({ _G.PrivilegeType.Afk.Time }) or 0
    self.maxTime = _G.ConfigManager.discrete_cfg[discreteID.MaxafkTime][1][1] + privilegetime
    self.afkTime = 0
    self.itemList = {}
    AfkModel:GetInstance():CheckAfkAward(
        function(time, data)
            self.afkTime = _G.TimeUtil.GetServerUnixTime() - time
            self:UpdateTime()
        end
    )

    self:InitView()
end

function LevelUpGuideView:UpdateCondTimer()
    local time = _G.TimeUtil.GetServerUnixTime() - AfkModel:GetInstance():GetAfkTime()
    if self.itemList[PlayList[1]] then
        self:GetBubbleIcon(time, self.itemList[PlayList[1]])
    end
    if time >= self.maxAfkTime or time >= self.nextLevelAfkTime then
        local sectionCfg = AfkModel:GetInstance():GetCurSectionCfg()
        local level = sectionCfg.limit_condition and sectionCfg.limit_condition[2]
        self.go_table.aortext_tip.text = _G.GetLangPackValue(90020800051, level)
        self:StopCondTimer()
    else
        self.go_table.aortext_tip.text = _G.GetLangPackValue(90020800041, self:FormateTime(self.nextLevelAfkTime - time))
    end
end

function LevelUpGuideView:StopCondTimer()
    if self.afkCondTimer then
        self.afkCondTimer:Stop()
        self.afkCondTimer = nil
    end
end

function LevelUpGuideView:FormateTime(time)
    local timeStr
    local t = _G.TimeUtil.TranslateSecond(time)
    if t.day > 0 then
        timeStr = _G.GetLangPackValue(90022100001, t.day, t.hour)
    else
        timeStr = _G.string.format("%02d:%02d:%02d", t.hour, t.min, t.sec)
    end
    return timeStr
end

---初始化页面
function LevelUpGuideView:InitView()
    if AfkModel:GetInstance():CheckNextSectionCondition() then
       self:Close()
       return 
    end

    self.maxAfkTime = self:GetMaxAfkTime()
    local time = _G.TimeUtil.GetServerUnixTime() - AfkModel:GetInstance():GetAfkTime()
    if time > self.maxAfkTime then
       time = self.maxAfkTime 
    end
    self.nextLevelAfkTime = AfkModel:GetInstance():GetCanBattleAfkTime()
    self:StopCondTimer()
    if time < self.maxAfkTime and time < self.nextLevelAfkTime then
        self.afkCondTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateCondTimer, self, false, false, false)
        self.afkCondTimer:Start()
    end
    self:UpdateCondTimer()

    self.privilege = require "MonthlyModel":GetInstance():IsHavePrivi(405005)
    if not self.listView then
        self.go_table.scrollloophorizontal_item:InitItemData(#PlayList, _G.handler(self, self.RefreshListItem))
        self.listView = self.go_table.scrollloophorizontal_item
    else
        self.listView:UpdateAllItem()
    end
end

function LevelUpGuideView:RefreshListItem(index, obj)
    local nIndex = index + 1
    local type = PlayList[nIndex]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, PlayData[type]))

    tb.aortext_title.text = PlayData[type].title
    local desc = self:GetItemDesc(type)
    if desc then
        tb.aortext_desc.text = desc
    end
    tb.aorrawimage_icon:LoadImage(
        PlayData[type].icon,
        function(image)
            if self:IsNil() then
               return 
            end
            image:SetNativeSize()
            image:SetLocalScaleXYZ(type == PlayList[1] and 0.35 or 1)
        end
    )
    tb.aorbtn_enter:SetActiveE(type == PlayList[3] and self.privilege and 0 or 1)
    tb.obj_active:SetActiveE(type == PlayList[3] and self.privilege and 1 or 0)

    if type == PlayList[1] then
        local time = _G.TimeUtil.GetServerUnixTime() - AfkModel:GetInstance():GetAfkTime()
        self:GetBubbleIcon(time, tb)
    else
        tb.aorimage_bubble:SetActiveE(0)
    end
    self.itemList[type] = tb
end

function LevelUpGuideView:GetBubbleIcon(time, tb)
    local bubbleIcon
    local roleLv = _G.PlayerModel:GetInstance().role_lv
    local roleLvExp = _G.PlayerModel:GetInstance().exp
    if not self.levelUpTime or not self.roleLv or not self.roleLvExp or self.roleLv ~= roleLv or self.roleLvExp ~= roleLvExp then
        self.roleLv  = roleLv
        self.roleLvExp  = roleLvExp
        self.levelUpTime = AfkModel:GetInstance():GetCanBattleAfkTime(true)
    end
    if time >= self.levelUpTime or time >= self.nextLevelAfkTime then
        bubbleIcon = "ui_wftc_keshengji"
    elseif time >= self:GetMaxAfkTime() then
        bubbleIcon = "ui_wftc_yiman"
    end
    if bubbleIcon then
        tb.aorimage_bubble.SpriteName = bubbleIcon
    end
    tb.aorimage_bubble:SetActiveE(bubbleIcon and 1 or 0)
end

function LevelUpGuideView:OnClickItem(_, _, playData)
    if playData.OpenView then
        playData.OpenView()
    end
end

---最大挂机时间
function LevelUpGuideView:GetMaxAfkTime()
    local vipTime = require "PrivilegeManager":GetInstance():GetPrivilegeDataNew({ _G.PrivilegeType.Afk.Time })
    local Time = 0
    if not _G.table.isEmptyOrNil(vipTime) then
        Time = vipTime[1][2]
    end
    return _G.ConfigManager.discrete_cfg[101103][1][1] + Time
end

---获取描述
function LevelUpGuideView:GetItemDesc(type)
    local AfkModelIns = AfkModel:GetInstance()
    if type == PlayList[1] then
        ---挂机收益
        local time = _G.TimeUtil.GetServerUnixTime() - AfkModelIns:GetAfkTime()
        local maxAfkTime = self:GetMaxAfkTime()
        if time < maxAfkTime then
            self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
            self.timer:Start()
            return _G.TimeUtil.TransDayHourMineMiao(time)
        else
            return _G.TimeUtil.TransDayHourMineMiao(maxAfkTime)
        end
    elseif type == PlayList[2] then
        ---快速挂机
        local freeTimes = AfkModelIns:GetFreeRewardTime()
        if freeTimes > 0 then
            return GetLangPackValue(90020800042, freeTimes)
        else
            local rewardTimeStr = AfkModelIns:GetRewardTime()
            if rewardTimeStr == 0 then
                rewardTimeStr = "<color=#b23939>" .. rewardTimeStr .. "</color>"
            end
            --.. "/" .. AfkModelIns.MaxRewardTime - AfkModelIns.BaseFreeTime
            return GetLangPackValue(90020800043, rewardTimeStr)
        end
    elseif type == PlayList[3] then
        ---挂机特权
        return self.privilege and GetLangPackValue(90020800052) or GetLangPackValue(90000011070)
    end
end

function LevelUpGuideView:UpdateTime()
    if self:IsNil() then
        return
    end
    if not self.itemList[PlayList[1]] then
        return
    end
    local afkTime = _G.TimeUtil.GetServerUnixTime() - AfkModel:GetInstance():GetAfkTime()
    local day = math.floor(afkTime / 86400)
    local str
    if day >= 1 then
        str = _G.TimeUtil.TimeToString(afkTime, 2)
        str =
            _G.LangUtil.GetLangPackValue(90022010703, math.floor(afkTime / 86400)) ..
            (math.floor(afkTime / 3600) - day * 24) .. ":" .. str
    else
        str = _G.TimeUtil.TimeToString(afkTime, 1)
    end
    self.itemList[PlayList[1]].aortext_desc.text = str
    if afkTime >= self:GetMaxAfkTime() then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
    end
end

---按钮点击事件在这里派发
function LevelUpGuideView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_closeView then
        self:Close()
    end
end

---@private
function LevelUpGuideView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:StopCondTimer()
    self:RemoveAllListener()
end

return LevelUpGuideView
