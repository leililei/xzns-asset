function GetawardView:GetData(time, data)
    self.AfkAward = data
    self.AwardData = {}
    self.PrivilegeAward = {}

    self.OldTime = time
    --重置挂机时长
    self.AfkTime = _G.TimeUtil.GetServerUnixTime() - time
    if self.Timer then
        self.Timer:Stop()
    end
    self.Timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdataShowAfkTime, self, false, false, true)
    self.Timer:Start()

    if data.award and data.award.item then
        for i, v in pairs(data.award.item) do
            if v.type[1] == 0 then
                v.type = { v.type[4], v.type[5], v.type[1], v.type[2], v.type[3] }
            end
            if self.AwardData[v.type[1]] then
                if self.MaxZengyiCount == 1 then
                    self:SetPrivilegeAward(v)
                elseif self.MaxZengyiCount == 2 then
                    if self.checkZengyiCount == 0 then
                        self:SetPrivilegeAward(v)
                        self.checkZengyiCount = self.checkZengyiCount + 1
                    elseif self.checkZengyiCount == 1 then
                        ---TODO 其他增益
                        self.checkZengyiCount = self.checkZengyiCount + 1
                    end
                else
                    self.AwardData[v.type[1]] = self.AwardData[v.type[1]] + v.type[2]
                end
            else
                self.AwardData[v.type[1]] = v.type[2]
            end
        end
    end
    if data.award and data.award.overflow then
        for i, v in pairs(data.award.overflow) do
            if v.type[1] == 0 then
                v.type = { v.type[4], v.type[5], v.type[1], v.type[2], v.type[3] }
            end
            if self.AwardData[v.type[1]] and self.AwardData[v.type[1]] ~= nil then
                self.AwardData[v.type[1]] = self.AwardData[v.type[1]]
            else
                self.AwardData[v.type[1]] = v.type[2]
            end
        end
    end
    if self.refresh then
        self:ShowItemList()
    end
    self.TimerFinish = true
end

function GetawardView:ShowAfkTime()
    if _G.IsNil(self.go_table) then
        return
    end
    local isMax = false
    local privilegetime = require "HellRoadModel":GetInstance():GetNumber({ _G.PrivilegeType.Afk.Time }) or 0
    local time = _G.ConfigManager.discrete_cfg[discreteID.MaxAfkTime][1][1] + privilegetime
    if self.AfkTime > time then
        self.AfkTime = time
        isMax = true
    end
    local day = math.floor(self.AfkTime / 86400)
    local str = _G.TimeUtil.TimeToString(self.AfkTime, 2)
    if day >= 1 then
        str = _G.TimeUtil.TimeToString(self.AfkTime, 2)
        str =
            _G.LangUtil.GetLangPackValue(Des.day, math.floor(self.AfkTime / 86400)) ..
            (math.floor(self.AfkTime / 3600) - day * 24) .. ":" .. str
    else
        str = _G.TimeUtil.TimeToString(self.AfkTime, 1)
    end
    self.go_table.aortext_AfkTime.text = str
    if AppSetting.IsXzns then
        local maxAfkTime = self:GetMaxAfkTime()
        if self.AfkTime < maxAfkTime then
            self.go_table.slider_bossProgress.value = self.AfkTime / maxAfkTime
        else
            self.go_table.slider_bossProgress.value = 1
        end
    end
end

function GetawardView:insertAward(award, zengyi)
