function GetawardView:ShowItemList()
    self.ItemSid = {}
    if self.MaxZengyiCount > 2 then
        ---TODO 其他增益
    elseif self.MaxZengyiCount > 0 then
        self:insertAward(self.PrivilegeAward, true)
    end
    self:insertAward(self.AwardData, false)
    if #self.ItemSid > 0 then
        _G.SortList(
            self.ItemSid,
            function(a)
                local zengyi = a.Zengyi and 1 or 0
                local grade = 0
                local Id = 0
                if a.sid == 21 then
                    Id = 999
                end
                if a.sid == 22 then
                    Id = 998
                end
                if a.sid == 11 then
                    Id = 997
                end
                local typeA = _G.StorageManager:GetInstance():CheckSidType(a.sid)
                if not typeA then
                    local a = 1
                end
                local CurrencyCfg = _G.ConfigManager.currency_type_cfg --货币资源
                local ItemCfg = _G.ConfigManager.item_cfg              --道具资源
                local EquipmentCfg = _G.ConfigManager.equipment_cfg    --装备资源
                if CurrencyCfg[a.sid] then
                    grade = CurrencyCfg[a.sid].Quality
                elseif ItemCfg[a.sid] then
                    grade = ItemCfg[a.sid].Quality
                elseif EquipmentCfg[a.sid] then
                    grade = EquipmentCfg[a.sid].grade
                else
                    grade = 0
                end
                return zengyi, Id, -typeA, grade, -a.sid
            end
        )
        self.go_table.obj_BG33:SetActiveE(0)
        self.canTake = true
    else
        self.go_table.obj_BG33:SetActiveE(1)
        self.canTake = false
    end
    if self.IsFirst then
        self.go_table.looplist2_ItemList:InitListView(0, _G.handler(self, self.RefreshMaterialList))
        self.go_table.looplist2_ItemListStage:InitListView(0, _G.handler(self, self.RefreshMaterialList2))
        self.IsFirst = false
        self.refresh = false
    end
    if self.refresh then
        self.go_table.looplist2_ItemList:RefreshAllShownItem()
    end
    self.go_table.looplist2_ItemList:SetListItemCount(_G.math.ceil(#self.ItemSid / 5), true)
end

function GetawardView:RefreshMaterialList(listView2, index)
    if index < 0 then
        return
    end
    local AwardData = self.ItemSid
    local item = listView2:NewListViewItem("$_obj_Item")
    local goTable = _G.GetAutoGoTable(item)
    local x = index * 5 + 1
    item:SetName(x)
    local parent
    for i = 1, 5 do
        local data = AwardData[x - 1 + i]
        if data ~= nil then
            parent = goTable["obj_root" .. i]
            goTable["aorimage_zengyi" .. i]:SetActiveE(data.Zengyi and 1 or 0)
            self:CreateItem(x, data, parent, i)
        else
            parent = goTable["obj_root" .. i]
            goTable["aorimage_zengyi" .. i]:SetActiveE(0)
            self:CreateItem(x, nil, parent, i)
        end
    end
    return item
end

function GetawardView:CreateItem(x, data, p, i)
    local tb
    if p then
        local childCount = p:GetChildCountE()
        for i = 1, childCount do
            _G.PoolsManager:GetInstance():Despawn(p:GetChildE(0), _G.ePoolType.UIItem)
        end
        -- local item = p:GetComponentInChildrenE(_G.typeof(_G.CS.UnityEngine.RectTransform))
        -- if item then
        --     _G.PoolsManager:GetInstance():Despawn(item, _G.ePoolType.UIItem)
        -- end
    end
    if data == nil then
        return
    end
    _G.StorageManager:GetInstance():GetItemBaseView(
        data.sid,
        data.count,
        p,
        function(tran)
            tran.gameObject:SetLocalPosition(0, 0, 0)
            tran.gameObject:SetLocalScaleXYZ(0.9)
            if AppSetting.IsXzns then
                tran.gameObject:SetLocalScaleXYZ(1)
            end
            tb = tran.go_table
            if self.ItemSid[x - 1 + i] == 0 then
                self:SetGrade(tb)
                tb.gameObject:SetActiveE(0)
            elseif data == nil then
                self:SetGrade(tb)
                tb.gameObject:SetActiveE(0)
            else
                self:SetGrade(tb, data.cfg)
                tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
            --self.awardList[(x-1)*5+i] = tran
        end,
        function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data.sid, nil, nil, data.Zengyi)
        end
    )
end

