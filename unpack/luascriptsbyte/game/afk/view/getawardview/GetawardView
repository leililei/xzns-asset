function GetawardView:UpdataShowAfkTime(elapsed)
    self.AfkTime = _G.TimeUtil.GetServerUnixTime() - self.OldTime
    self.UpdatePage = math.floor(self.UpdatePage + elapsed)
    if self.UpdatePage >= 30 and not self.PreViewAward and self.TimerFinish then
        self.TimerFinish = false
        self.UpdatePage = 0
        local Msg = {}
        Msg.check_time = _G.TimeUtil.GetServerUnixTime()
        -- for _,v in pairs(self.awardList) do
        --     _G.DestroyObject(v.gameObject)
        -- end
        self.refresh = true
        require "AfkModel":GetInstance():CheckAfkAward(_G.handlerbind(self, self.GetData))
    end
    self:ShowAfkTime()
end
function GetawardView:GetMaxAfkTime()
    local vipTime = require "PrivilegeManager":GetInstance():GetPrivilegeDataNew({ 1 })
    local Time = 0
    if not _G.table.isEmptyOrNil(vipTime) then
        Time = vipTime[1][2]
    end
    return _G.ConfigManager.discrete_cfg[101103][1][1] + Time
end

