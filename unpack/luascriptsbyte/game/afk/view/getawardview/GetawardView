    local RewardTime = require("AfkModel"):GetInstance():GetRewardTime()
    if RewardTime > 0 and _G.GlobalConditionManager.CheckConditionArrays(_G.ConfigManager.discrete_cfg[120016]) then
        self.go_table.aorimage_quickNum:SetActiveE(1)
        self.go_table.aortext_quickNum.text = _G.GetLangPackValue(90021400009)
    else
        self.go_table.aorimage_quickNum:SetActiveE(0)
    end
end

function GetawardView:SetPreStageAward()
    if self.PreStageAward then
        return
    end
    local list = _G.ConfigManager.discrete_cfg[101114][1]
    local index = 3
    if not _G.table.isEmptyOrNil(list) then
        local cursid = require "AfkModel":GetInstance():GetLastSection()
        for i, v in pairs(list) do
            if cursid < v then
                index = index - 1
                if not self.PreStageAward then
                    self.PreStageAward = {}
                end
                _G.table.insert(self.PreStageAward, { v, _G.ConfigManager.afk_cfg[v].precious_preview })
                if index <= 0 then
                    break
                end
            end
        end
        if not self.PreStageAward then
            self.PreStageAward = {}

            local v = list[#list]
            _G.table.insert(self.PreStageAward, { v, _G.ConfigManager.afk_cfg[v].precious_preview })
        end
    end
end

function GetawardView:ShowPreStage()
    local list = {}
    if not self.PreStageAward then
        return
    end
    local cfg = _G.ConfigManager.afk_cfg[self.PreStageAward[self.PreStageIndex][1]]
    self:SetEffText(self.PreStageAward[self.PreStageIndex][1])
    self.CurPreStageAward = self.PreStageAward[self.PreStageIndex][2]
    if not self.CurPreStageAward then
        return
    end
    if self.PreStageIndex > 0 and self.PreStageIndex <= #self.PreStageAward then
        if not _G.table.isEmptyOrNil(self.CurPreStageAward[1]) then
            for i, v in pairs(self.CurPreStageAward[1]) do
                _G.table.insert(list, { v, true })
            end
        end
        if not _G.table.isEmptyOrNil(self.CurPreStageAward[2]) then
            for i, v in pairs(self.CurPreStageAward[2]) do
                _G.table.insert(list, { v, false })
            end
        end
        self.CurPreStageAward = list
        local count = _G.math.ceil((_G.table.count(self.CurPreStageAward)) / 5)
        if count == self.CurPreStageAwardCount then
            self.go_table.looplist2_ItemListStage:RefreshAllShownItem()
        else
            self.go_table.looplist2_ItemListStage:SetListItemCount(count, true)
        end
        self.CurPreStageAwardCount = count
    end
    if self.PreViewAward then
        self.go_table.aortext_PreTips.text = _G.LangUtil.GetLangPackValue(90028010108, cfg.chapter, cfg.section)
    end
end

local imagePre = { new = "ui_dl_pic_xinfu", up = "ui_gj_icon_lvjiantou" }
function GetawardView:RefreshMaterialList2(listView2, index)
    if index < 0 then
        return
    end
    local AwardData = self.CurPreStageAward
    local item = listView2:NewListViewItem("$_obj_Item_stage")
    local goTable = _G.GetAutoGoTable(item)
    local x = index * 5 + 1
    item:SetName(x)
    local data
    local parent
    for i = 1, 5 do
        data = AwardData[x - 1 + i]
        parent = goTable["obj_root" .. i]
        if data ~= nil then
            goTable["aorimage_stage" .. i]:SetActiveE(1)
            goTable["aorimage_stage" .. i].SpriteName = data[2] and imagePre.new or imagePre.up
            goTable["aorimage_stage" .. i]:SetNativeSize()
            self:CreateItem2(x, data[1], parent, i)
        else
            goTable["aorimage_stage" .. i]:SetActiveE(0)
            local childCount = parent:GetChildCountE()
            for i = 1, childCount do
                _G.PoolsManager:GetInstance():Despawn(parent:GetChildE(0), _G.ePoolType.UIItem)
            end
        end
    end
    return item
end

function GetawardView:CreateItem2(x, data, p, i)
    local childCount = p:GetChildCountE()
    for i = 1, childCount do
        _G.PoolsManager:GetInstance():Despawn(p:GetChildE(0), _G.ePoolType.UIItem)
    end
    _G.StorageManager:GetInstance():GetItemBaseView(
        data,
        1,
        p,
        function(tran)
            tran.gameObject:SetLocalPosition(0, 0, 0)
            tran.gameObject:SetLocalScaleXYZ(0.9)
        end,
        function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data, nil, nil)
        end
    )
end

---获取奖励的item的transform
function GetawardView:GetAwardItemList()
    local childCount = self.go_table.obj_Content:GetChildCountE()
    local ContentRect = self.go_table.obj_Content:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    local itemList, tmpItem, rect, tb = {}
    for i = 1, childCount do
        tmpItem = self.go_table.obj_Content:GetChildE(i - 1)
        rect = tmpItem:GetComponentE(typeof(CS.UnityEngine.RectTransform))

        local rx, ry = rect:GetAnchorPosition()
        local crx, cry = ContentRect:GetAnchorPosition()

        if ry + cry - 95 < 0 and ry + cry + 95 > -380 then
            tb = _G.GetAutoGoTable(tmpItem)
            for j = 1, 5 do
                if tonumber(tmpItem:GetName()) and self.ItemSid[tonumber(tmpItem:GetName()) + j - 1] then
                    table.insert(
                        itemList,
                        {
                            Pos = _G.Vector3.New(tb[string.format("obj_Item%d", j)]:GetPosition()),
                            data = self.ItemSid[tonumber(tmpItem:GetName()) + j - 1]
                        }
                    )
                end
            end
        end
    end
    return itemList
end

