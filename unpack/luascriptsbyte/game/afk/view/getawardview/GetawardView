---按钮点击事件在这里派发
function GetawardView:OnClickBtn(go)
    local name = go:GetName()
    -- 镇魂街ZHJ-34446 Beta_1.0.0公测BuglistZHJ-34981
    -- 挂机收益】模拟器点击esc响应领取，真机使用返回键同样效果
    -- 修改了预制体中的点击空白界面返回的按钮的名称
    -- 避免 模拟器esc/手机返回键 领取奖励
    if name == "@_aorbtn_Done" then
        -- _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, self.AfkAward)
        if self.OpenBoxTimer then
            self.OpenBoxTimer:Stop()
        end
        if self.canTake then
            self.TimerFinish = false
            self:GetAfkAward(
                function()
                    if self:IsNil() then
                        return
                    end
                    require "AfkModel":GetInstance():CheckAfkAward(function(time, data)
                        self:GetData(time, data) -- 更新数据
                        self:ShowItemList()      -- 刷新列表显示
                        self:ShowAfkTime()       -- 刷新时间显示
                    end)
                    local itemList = self:GetAwardItemList()
                    if itemList and #itemList > 0 then
                        self:PlayCloseAnim(0)
                        if self.GetCall ~= nil then
                            self.GetCall(
                                itemList,
                                function()
                                    -- self:Close()
                                end
                            )
                            self:Close()
                        else
                            self:PlayCloseAnim(1)
                        end
                    else
                        self:PlayCloseAnim(1)
                    end
                end
            )
        else
            self:PlayCloseAnim(1)
        end
    elseif name == "@_aorbtn_Close" or name == "@_aorbtn_CloseBtn" or name == "@_aorbtn_CloseViewAndGetAward" then
        if self.Timer ~= nil then
            self.Timer:Stop()
        end
        self:Close()
    elseif name == "@_aorbtn_Pre" then
        if self.PreViewAward then
            -- self.go_table.aorimage_PreviewMask.Alpha = 0
            --self.fanPaiAnim:Play("a_kapaifanzhuan_fan")
            self.PreViewAward = false
            self:SetEffText()
        else
            --self.fanPaiAnim:Play("a_kapianfanzhuan_zheng")
            self.PreViewAward = true
            --self.go_table.aorimage_PreviewMask.Alpha = 1
            self:SetPreStageAward()
            self.PreStageIndex = 1
            self:ShowPreStage()
        end
        _G.GameUtil.SetActiveByCondition(self.go_table.aortext_pre, not self.PreViewAward)
        _G.GameUtil.SetActiveByCondition(self.go_table.aortext_Exitpre, self.PreViewAward)
        _G.GameUtil.SetActiveByCondition(self.go_table.looplist2_ItemList, not self.PreViewAward)
        _G.GameUtil.SetActiveByCondition(self.go_table.looplist2_ItemListStage, self.PreViewAward)
        _G.GameUtil.SetActiveByCondition(self.go_table.aortext_afkTime, not self.PreViewAward)
        _G.GameUtil.SetActiveByCondition(self.go_table.aortext_PreTips, self.PreViewAward)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_Done, not self.PreViewAward)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_CloseBtn, not self.PreViewAward)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_BG33, not self.PreViewAward and #self.ItemSid <= 0)
    elseif name == "@_aorbtn_left" then
        self.PreStageIndex = self.PreStageIndex - 1
        self:ShowPreStage()
    elseif name == "@_aorbtn_right" then
        self.PreStageIndex = self.PreStageIndex + 1
        self:ShowPreStage()
    elseif name == "@_aorbtn_quick" then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.QuickGetRewardView.Name,
            _G.handler(self, self.FreshQuickImage)
        )
    elseif name == "@_aorbtn_tequan" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LimitedTimePrivilegeView.Name, 405005)
        self:Close()
    end
    _G.GameUtil.SetActiveByCondition(
        self.go_table.aorbtn_left,
        self.PreViewAward and self.PreStageAward and self.PreStageIndex and self.PreStageIndex - 1 > 0
    )
    _G.GameUtil.SetActiveByCondition(
        self.go_table.aorbtn_right,
        self.PreViewAward and self.PreStageAward and self.PreStageIndex and self.PreStageIndex < #self.PreStageAward
    )
end

