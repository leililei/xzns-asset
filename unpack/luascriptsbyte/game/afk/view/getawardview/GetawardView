        self.Timer:Stop()
    end
    self.Timer = nil
    if self.timer then
        self.timer:Stop()
    end
    self.timer=nil
end

function GetawardView:CheckZengyi()
    if self:CheckPrivilege() then
        self.MaxZengyiCount = self.MaxZengyiCount + 1
    end
    local isAtivePrivi,countDown=require "MonthlyModel":GetInstance():IsHavePrivi(405005)
    if isAtivePrivi then
        self.go_table.aorbtn_tequan:SetActiveE(0)
        self.cfg=_G.ConfigManager.store_month_cfg[405005]
        self.PrivilegEnd = countDown
        if self.cfg.day_extra > 0 then
            self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.TimeUpdate, self, false, false, true)
            self.timer:Start()
        end
        self:TimeUpdate(0)
    end
    ---TODO 其他增益
end

function GetawardView:TimeUpdate(fix)
    local time = self.PrivilegEnd - fix
    if time <= 0 and self.cfg.day_extra > 0 then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        self.PrivilegEnd = nil
        self.hasPrivilege = false
        self.go_table.aorbtn_tequan:SetActiveE(1)
        self.go_table.aortext_time:SetActiveE(0)
        return
    end
    if self.cfg.day_extra > 0 then
        local t = _G.TimeUtil.TranslateSecond(time)
        self.go_table.aortext_time.text = _G.GetLangPackValue(90021600065,t.day)
    else
        self.go_table.aortext_time.text = _G.GetLangPackValue(90000001066)
    end
end

function GetawardView:SetPrivilegeAward(data)
    self.PrivilegeAward[data.type[1]] = data.type[2]
end

function GetawardView:CheckPrivilege()
    local PrivilegeManager = require "PrivilegeManager":GetInstance()
    local coinPri = PrivilegeManager:GetPrivilegeData({ 2, 11 })
    local diamondPri = PrivilegeManager:GetPrivilegeData({ 2, 22 })
    return _G.table.count(coinPri) > 0 or _G.table.count(diamondPri) > 0
end

function GetawardView:InitView(OldTime, data)
    self.go_table.gameObject:SetActiveE(1)
    self.go_table.aorbtn_Done:SetActiveE(not self.PreViewAward and 1 or 0)
    self.go_table.aortext_pre:SetActiveE(not self.PreViewAward and 1 or 0)
    self.go_table.aortext_Exitpre:SetActiveE(self.PreViewAward and 1 or 0)
    _G.GameUtil.AddDouYinIcon(self.go_table.aorimage_Done, true)

    self:FreshQuickImage()
    self:GetData(OldTime, data)
    local time =
        _G.ConfigManager.discrete_cfg[discreteID.MaxAfkTime][1][1] +
        require "HellRoadModel":GetInstance():GetNumber({ _G.PrivilegeType.Afk.Time })
    self.go_table.aortext_MaxAfkTime.text =
        string.format(_G.LangUtil.GetLangPackValue(Des.MaxAfkTime), math.floor(time / 3600))

    local priceId = _G.ConfigManager.store_month_cfg[405005].price_id
    _G.GameUtil.SetPriceByChannel(priceId, self.go_table.aortext_price)

    time = _G.ConfigManager.discrete_cfg[discreteID.ResultIntervalTime][1][1]
    -- if OldTime == 0 then
    --     self.AfkTime = 0
    -- else
    --     self.AfkTime = _G.TimeUtil.GetServerUnixTime() - OldTime
    -- end
    self.AfkTime = _G.TimeUtil.GetServerUnixTime() - OldTime
    self:SetEffText()
    if self.Timer ~= nil then
        self.Timer:Stop()
    end
    self:ShowAfkTime()
    self.Timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdataShowAfkTime, self, false, false, true)
    self.Timer:Start()
    self:ShowItemList()
    self:ShowTeQuanAward()
end

