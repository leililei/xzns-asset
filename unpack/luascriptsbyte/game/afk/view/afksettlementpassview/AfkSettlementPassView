local base = require "UIBaseView"

---@class AfkSettlementPassView : UIBaseView    中文描述
---@field go_table AfkSettlementPassView_GoTable GoTable
local AfkSettlementPassView = _G.BaseClass("AfkSettlementPassView", base)

---界面的入口函数
function AfkSettlementPassView:OnCreate(settlementEndCall, data, ...)
    self.settlementEndCall = settlementEndCall
    self.data = data
    self.args = { ... }
    self:InitView()
    self:OpenChildView()
    require("PowerToTheTopModel"):GetInstance():CheckSelfRank(_G.PowerToTheTopType.afk, require("AfkModel"):GetInstance().LastSid)
    require "RecordRankModel":GetInstance():CheckAfkList()

end

---打开结算界面
function AfkSettlementPassView:OpenChildView()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
            self.settlementEndCall,
            self.data,
            table.unpack(self.args)
    )
end

function AfkSettlementPassView:InitView()
    --[[    if not _G.PlayerModel:GetInstance():CheckCreateRole() then
            self.go_table.obj_title:SetActiveE(0)
            self.go_table.obj_info:SetActiveE(0)
            return
        end]]
    --关卡进度
    ---@type AfkModel
    local afkModel = require("AfkModel"):GetInstance()
    local cfg = _G.ConfigManager.afk_cfg[afkModel:GetCurSection()];
    local lastCfg = self.data and self.data.iSWin and _G.ConfigManager.afk_cfg[cfg.pre_section]
    --self.go_table.aortext_title.text = string.format("%s-%s", (lastCfg or cfg).chapter, (lastCfg or cfg).section)

    --更新当前进度标题
    self.go_table.aortext_stageNum.text = string.format("%s-%s", (lastCfg or cfg).chapter, (lastCfg or cfg).section)
    local nameT = afkModel:GetCurChapterName()
    if nameT then
        self.go_table.aortext_stageName.text = LangUtil.GetLangPackValue(nameT[1])
    end
    --关卡加成
    local infos = {
        { _G.ResPropID.HoreExp, math.floor(cfg.eff_exp_team * 2), lastCfg and math.floor(lastCfg.eff_exp_team * 2) or 0 },
        { _G.ResPropID.CardExp, math.floor(cfg.eff_exp_hero * 2), lastCfg and math.floor(lastCfg.eff_exp_hero * 2) or 0 },
        { _G.ResPropID.Coin, math.floor(cfg.eff_coin * 2), lastCfg and math.floor(lastCfg.eff_coin * 2) or 0 },
    }
    self.go_table.obj_item:SetActiveE(0)
    if AppSetting.IsXzns then
        if self.data.iSWin then
            self.go_table.aorimage_addbg1.SpriteName="ui_diban_shouyi_shengli"
            self.go_table.aorimage_addbg2.SpriteName="ui_diban_shouyi_shengli"
        else
            self.go_table.aorimage_addbg1.SpriteName="ui_diban_shouyi_shibai"
            self.go_table.aorimage_addbg2.SpriteName="ui_diban_shouyi_shibai"
        end
    end
    local rawardCount = 0
    for _, info in ipairs(infos) do
        local sid, nowValue, lastValue = table.unpack(info)
        if AppSetting.IsXzns and nowValue == 0 then
            goto continue
        end
        local obj = _G.InstantiateObject(self.go_table.obj_item, self.go_table.obj_parent)
        obj:SetActiveE(1)
        ---@type AfkSettlementPassView._obj_item_GoTable
        local objTable = _G.GetAutoGoTable(obj)
        local icon = _G.StorageManager:GetInstance():GetItemIcon(sid)
        if not _G.string.IsNullOrEmpty(icon) then
            objTable.aorrawimage_icon:LoadImage(icon)
        end
        if lastValue > 0 and nowValue > lastValue then
            local showtxt = string.format(
                    "%s/m <color=#3ec930>+%s/m</color>",
                    _G.UIUtils.NumberToUnitStr(lastValue),
                    _G.UIUtils.NumberToUnitStr(nowValue - lastValue))
            if AppSetting.IsXzns then
                showtxt = string.format(
                        "%s/m +<color=#83e497>%s/m</color>",
                        _G.UIUtils.NumberToUnitStr(lastValue),
                        _G.UIUtils.NumberToUnitStr(nowValue - lastValue))
                        objTable.aorimage_arrows:SetActiveE((nowValue - lastValue>0) and 1 or 0)
            end
            objTable.aortext_value.text = showtxt
        else
            objTable.aortext_value.text = string.format("%s/m", _G.UIUtils.NumberToUnitStr(nowValue))
        end
        rawardCount = rawardCount + 1
        ::continue::
    end
    if AppSetting.IsXzns then
        self.go_table.aorimage_addbg2:SetActiveE(rawardCount > 2 and 1 or 0)
    end

    local awardStr = ""
    if self.data.iSWin and _G.GlobalConditionManager.CheckConditionArrays(_G.ConfigManager.discrete_cfg[100249]) then
        local awardData = require("AfkTaskModel"):GetInstance().AwardDatas
        for _, data in pairs(awardData) do
            if data.CanTake and not data.isGet then
                awardStr = _G.GetLangPackValue(90000001246)
                break
            end
        end
    end
    self.go_table.aortext_award.text = awardStr
    --[[    --角色信息
        local playerModel                = _G.PlayerModel:GetInstance()
        local lvCfg                      = _G.ConfigManager.player_level_cfg[playerModel:GetLevel()]
        local exp                        = playerModel.exp or 0
        local upExp                      = lvCfg and lvCfg.exp or exp
        self.go_table.aortext_level.text = _G.GetLangPackValue(90000011081, playerModel:GetLevel())
        self.go_table.aortext_exp.text   = string.format("%s/%s", exp, upExp)
        self.go_table.aorimage_exp:SetLocalScale(upExp > 0 and exp / upExp or 1, 1, 1)
        --角色头像丶头像框
        local headStyle = playerModel:GetRoleStyle()
        local headCfg = headStyle and _G.ConfigManager.player_portrait_cfg[headStyle]
        if headCfg then
            self.go_table.aorimage_head.SpriteName = headCfg.portrait1
        end
        local frame = playerModel:GetCurFrame()
        local frameCfg = frame and _G.ConfigManager.player_frame_cfg[frame]
        if frameCfg then
            _G.UIUtils.RemoveChildren(self.go_table.aorrawimage_frame)
            if cfg.type_title ~= 2 then
                self.go_table.aorrawimage_frame:LoadImage(cfg.frame)
            else
                self.go_table.aorrawimage_frame.color = _G.Color.New(1, 1, 1, 0)
                _G.UIUtils.LoadEffectTitleOrFrame(
                    cfg.frame,
                    self.go_table.aorrawimage_frame,
                    function(item)
                        item:SetLocalScale(0.85, 0.85, 1)
                    end
                )
            end
        end]]
end

---监听界面
---@param name string 界面名称
function AfkSettlementPassView:OnUIOpened(name)
    if name ~= _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)

    local view = _G.UIManager:GetInstance():GetWindowCtrl(name)
    view.transform:SetParentE(self.go_table.trans_view)
    view:RegiestEffectViewOpen(function(isWin)
        local cfg = _G.ConfigManager.afk_cfg[require("AfkModel"):GetInstance():GetCurSection()]
        if isWin == false and (view.showBtn or view.back) and require("DemoModel"):GetInstance():CheckFailShow(_G.EmbattleType.AFKOnly, cfg.id) then
            local goTable = view.VEff
            goTable.aorbtn_yangchengicon:SetActiveE(0)
            goTable.aorbtn_Equipicon:SetActiveE(0)
            goTable.aorbtn_genghuanicon:SetActiveE(0)
            goTable.obj_cardTrial:SetActiveE(1)
            local demoDatas = require("DemoModel"):GetInstance():GetAllCards()
            local cardData = table.toArray(demoDatas)[1]
            local cfg = _G.ConfigManager.card_cfg[cardData.sid]
            local order, starCount = require("CardInfoManager"):GetInstance():GetOrderStarCount(cfg.Star)
            goTable.aorimage_ColorBg.SpriteName = require("CardInfoManager"):GetInstance():GetHeadBgSpriteName(nil, order)
            goTable.aorimage_Icon.SpriteName = cfg.Icon
            local name = _G.GetLangPackValue(cfg.Name)
            goTable.aortext_name.text = name
            goTable.aortext_des.text = _G.GetLangPackValue(90020300208, name)
            goTable.aortext_des2.text = _G.GetLangPackValue(90020300209, name, _G.ConfigManager.discrete_cfg[114501][1][1])
        end
    end)
    _G.PopWindowManager:GetInstance():SetNowPopping(true)
    _G.UIManager:GetInstance():ChangeCanvasOrder(
            name,
            self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 1
    )
end

---监听界面
---@param name string 界面名称
function AfkSettlementPassView:OnUIClosed(name)
    if name ~= _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
    _G.PopWindowManager:GetInstance():SetNowPopping(false)
    _G.PopWindowManager:GetInstance():Next()
    self:Close()
end

function AfkSettlementPassView:EscClose()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name)
    if view then
        view:CloseCall(_G.SettlementModel.FunctionEnum.None)
    end
end

return AfkSettlementPassView
