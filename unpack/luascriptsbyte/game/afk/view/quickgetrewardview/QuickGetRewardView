---界面的入口函数
function QuickGetRewardView:OnCreate(GetCall)
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.OnItemUpdate, self)
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.OnItemUpdate, self)
