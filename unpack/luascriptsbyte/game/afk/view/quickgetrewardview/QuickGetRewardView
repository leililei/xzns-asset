function QuickGetRewardView:kaiguanbut()
    local text
    local weizhi
    if self.kaiguan then
        _G.PlayerPrefsManager.SetInt("Quick", self.kaiguan)
    end

    if self.kaiguan == 1 then
        text = guan
        weizhi = -20
        self.kaiguan = 0
        if (self.firstOpen == false) then
            _G.PopWindowManager:GetInstance():ShowAllTips(340601)
        end
    else
        text = kai
        weizhi = 20
        self.kaiguan = 1
        if (self.firstOpen == false) then
            _G.PopWindowManager:GetInstance():ShowAllTips(340602)
        end
    end
    self.go_table.aorimage_auto.gameObject:SetLocalPosition(weizhi, 0, 0)
    self.go_table.aortext_wenzi.text = _G.ConfigManager.language_package_cfg[text]
    self.firstOpen = false
    if (self.kaiguan == 1) then
        self.go_table.aorrawimage_skip:SetActiveE(1)
    else
        self.go_table.aorrawimage_skip:SetActiveE(0)
    end
end

