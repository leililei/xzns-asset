        _G.GameUtil.SetUiHeXieMask(self.go_table)
    end
end

function QuickGetRewardView:OnItemUpdate()
    self:PrivilegedNew()
    self:InitGetRewardView()
end

function QuickGetRewardView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.OnItemUpdate, self)
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.OnItemUpdate, self)
    self.GetCall = nil
end

function QuickGetRewardView:InitGetRewardView()
    self.quickAfkSid = AfkModel:GetInstance().LastSid
    self.quickAwardData = AfkModel:GetInstance():GetCurAfkQuickAwawrd()
    self.FreeNum = AfkModel:GetInstance():GetFreeRewardTime()
    local DiamondNum = AfkModel:GetInstance():GetDiamondNum()
    local isShowDiamond = true
    self.type = 1
    if self.FreeNum > 0 then
        self.go_table.aortext_FreeTime.text = string.format(GetLangPackValue(Des.FreeNum), self.FreeNum)
        self.go_table.aortext_Done.text = GetLangPackValue(Des.FreeBtnTXT)
        self.go_table.aortext_FreeTime:SetActiveE(1)
        self.go_table.aorrawimage_martiralImg:SetActiveE(0)
        self.go_table.aortext_consume:SetActiveE(0)
        isShowDiamond = false
        --self.go_table.aorimage_huangseanniiu:SetGray(false)
        self.go_table.aorimage_huangseanniiu.SpriteName = "ui_ty_kuang_00"
        self.go_table.aortext_consume:GetComponentE(_G.typeof(_G.CS.TextOutline)).enabled = false
                self.go_table.aortext_Done:GetComponentE(_G.typeof(_G.CS.TextOutline)).enabled = false
        self.go_table.aortext_consume.color = _G.Color.New(140 / 255, 45 / 255, 20 / 255, 1)
        self.go_table.aortext_Done.color = _G.Color.New(140 / 255, 45 / 255, 20 / 255, 1)
    else
        self.ticketNum = _G.StorageManager:GetInstance():GetItemCountBySid(ticketId)
        if self.ticketNum > 0 then
            self.type = 2
            self.go_table.aortext_FreeTime:SetActiveE(0)
            local data = _G.StorageManager:GetInstance():GetStorageItemData(ticketId)
            local num = self.ticketNum > 99 and "99+" or self.ticketNum
            self.go_table.aortext_Done:SetActiveE(0)
            self.go_table.aortext_ticket.text = GetLangPackValue(90021400004, num)
            self.go_table.aortext_ticket:SetActiveE(1)
            self.go_table.aorrawimage_martiralImg:SetActiveE(1)
            self.go_table.aorrawimage_martiralImg:LoadImage(data.Icon)
        else
            self.go_table.aortext_FreeTime:SetActiveE(1)
            local data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.ResProp, _G.ResPropID.Diamond)
            local rewardTime = AfkModel:GetInstance():GetRewardTime()
            self.go_table.aortext_FreeTime.text = string.format(GetLangPackValue(Des.RewardNum), rewardTime)
            local isActivePrivileged = require "MonthlyModel":GetInstance():IsHavePrivi(405005)
            if rewardTime == 0 then
                if not isActivePrivileged then
                    --如果还没购买特权
                    self.go_table.aorimage_huangseanniiu.SpriteName = "ui_ty_kuang_00"
                    self.go_table.aortext_consume:GetComponentE(_G.typeof(_G.CS.TextOutline)).enabled = false
                    self.go_table.aortext_Done:GetComponentE(_G.typeof(_G.CS.TextOutline)).enabled = false
                    self.go_table.aortext_consume.color = _G.Color.New(140 / 255, 45 / 255, 20 / 255, 1)
                    self.go_table.aortext_Done.color = _G.Color.New(140 / 255, 45 / 255, 20 / 255, 1)
                    isShowDiamond = false
                else
                    --self.go_table.aorimage_huangseanniiu:SetGray(true)
                    self.go_table.aorimage_huangseanniiu.SpriteName = "ui_ty_kuang_02"
                    self.go_table.aortext_consume.color = _G.Color.New(235 / 255, 235 / 255, 235 / 255, 1)
                    self.go_table.aortext_consume:GetComponentE(_G.typeof(_G.CS.TextOutline)).enabled = true
                    self.go_table.aortext_Done:GetComponentE(_G.typeof(_G.CS.TextOutline)).enabled = true
                    self.go_table.aortext_Done.color = _G.Color.New(235 / 255, 235 / 255, 235 / 255, 1)
                end
            else
                --self.go_table.aorimage_huangseanniiu:SetGray(false)
                self.go_table.aorimage_huangseanniiu.SpriteName = "ui_ty_kuang_00"
                self.go_table.aortext_consume:GetComponentE(_G.typeof(_G.CS.TextOutline)).enabled = false
                self.go_table.aortext_Done:GetComponentE(_G.typeof(_G.CS.TextOutline)).enabled = false
                self.go_table.aortext_consume.color = _G.Color.New(140 / 255, 45 / 255, 20 / 255, 1)
                self.go_table.aortext_Done.color = _G.Color.New(140 / 255, 45 / 255, 20 / 255, 1)
            end
            self.go_table.aortext_Done.text = isShowDiamond == true and GetLangPackValue(90000010016) or GetLangPackValue(90020600073)
            local isOver = AfkModel:GetInstance():GetRewardTime() == 0 and (isActivePrivileged or _G.AppSetting.IsArraigned)
            self.go_table.aorbtn_Done:SetActiveE(isOver and 0 or 1)
            self.go_table.aorrawimage_martiralImg:SetActiveE(1)
            self.go_table.aorrawimage_martiralImg:LoadImage(
                data.cfg.icon or data.cfg.Icon,
                function(image)
                    image:SetActiveE(isShowDiamond == true and 1 or 0)
                end
            )
            self.go_table.aortext_consume.text = DiamondNum
            self.go_table.aortext_consume:SetActiveE(isShowDiamond == true and 1 or 0)
        end
    end
    self.go_table.aortext_ConsumeDes.text =
        string.format(
        GetLangPackValue(Des.GetRewardTime),
        _G.ConfigManager.discrete_cfg[discreteID.QuickGetPlace][1][1] / 60
    )
    _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(self.go_table.aortext_consume.rectTransform)
    _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(self.go_table.aortext_Done.rectTransform)
    _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(self.go_table.aortext_ticket.rectTransform)
    if self.isFirst then
        self.go_table.scrollloophorizontal_itemList:InitItemData(0, _G.handler(self, self.RefreshMaterialList))
        self.go_table.scrollloopvectical_itemList1:InitItemData(0, _G.handler(self, self.RefreshMaterialList1))
        self.isFirst = false
    end
    self.go_table.scrollloophorizontal_itemList:UpdateCount(#self.quickAwardData[1])
    self.go_table.scrollloopvectical_itemList1:UpdateCount(#self.quickAwardData[2])
    --self:SetMotorAttackView()
end

function QuickGetRewardView:SetMotorAttackView()
    self.MotorRoot.aortext_motorDesc.text = GetLangPackValue(91112100101) .. "..."
    local group = AfkModel:GetInstance():GetLastAfkSectionGroupHeads()
    if group then
        local eHeads = group.eHeads
        for i = 1, 5 do
            if i <= 4 then
                self.MotorRoot["obj_micon" .. i]:SetActiveE(1)
                self.MotorRoot["aorimage_mrole" .. i].SpriteName = eHeads[i]
            else
                self.MotorRoot["obj_eicon" .. 1]:SetActiveE(0)
                self.MotorRoot["aorimage_erole" .. 1].SpriteName = eHeads[i]
            end
        end
    end
end

function QuickGetRewardView:RefreshMaterialList(index, obj)
    if index < 0 then
        return
    end
    local x = index + 1
    obj:SetName(x)
    local goTable = _G.GetAutoGoTable(obj)
    local award = self.quickAwardData[1][x]
    if award ~= nil then
        _G.GameUtil.SetActiveByCondition(goTable.aorimage_zengyi, award[1])
        self:CreateAward(award, goTable.obj_root)
    end
end

function QuickGetRewardView:RefreshMaterialList1(index, obj)
    if index < 0 then
        return
    end
    local x = index + 1
    obj:SetName(x)
    local goTable = _G.GetAutoGoTable(obj)
    local award = self.quickAwardData[2][x]
    if award ~= nil then
        _G.GameUtil.SetActiveByCondition(goTable.aorimage_zengyi, award[1])
        self:CreateAward(award, goTable.obj_root)
    end
end

function QuickGetRewardView:CreateAward(award, p)
    local childCount = p:GetChildCountE()
    for i = 1, childCount do
        _G.PoolsManager:GetInstance():Despawn(p:GetChildE(0), _G.ePoolType.UIItem)
    end
    local _data = {}
    for i = 1, #award do
        if i > 3 then
            table.insert(_data, award[i])
        end
    end
    _G.StorageManager:GetInstance():GetItemBaseView(
        award[2],
        award[3],
        p,
        function(tran)
            tran.gameObject:SetActiveE(1)
            tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            tran.gameObject:SetLocalPosition(0, 0, 0)
            tran.gameObject:SetLocalScaleXYZ(0.8)
        end,
        function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, award[2], nil, nil, award[1])
        end,
        _data
    )
end

function QuickGetRewardView:OnGetRewardClickBtn(go)
    local closeFunc = function(data)
        _G.PopWindowManager:GetInstance():AddAwardPopQuene(data, _G.handlerbind(self, self.ReOpen, data), {nil, nil, nil, nil, nil, nil, nil, nil, nil, true})
    end
    if go == self.go_table.aorbtn_Close or go == self.go_table.aorbtn_CloseBtn then
        if self.GetReawardAnim ~= nil then
            self.GetReawardAnim:Play("a_GetawardView_close")
        end
        _G.DelayDo(
            0.2,
            function()
                self:Close()
            end
        )
    elseif go == self.go_table.aorbtn_Done then
        local isActivePrivileged = require "MonthlyModel":GetInstance():IsHavePrivi(405005)
        if AfkModel:GetInstance():GetRewardTime() == 0 and not isActivePrivileged then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LimitedTimePrivilegeView.Name, 405005)
            self:Close()
            return
        end
        if not AfkModel:GetInstance():CheckRewardConsume() then
            return
        else
            AfkModel:GetInstance():GetQuickAfkAward(
                self.type,
                function(data)
                    --self.ticketNum = _G.StorageManager:GetInstance():GetStorageItemData(ticketId)
                    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
                        _G.ConfigManager.redpoint_cfg.AfkQuick.id
                    )
                    self:OnItemUpdate()
                    if self.GetReawardAnim ~= nil then
                        self.GetReawardAnim:Play("a_GetawardView_close")
                        --self.go_table.aorbtn_BG1:SetActiveE(0)
                        self.go_table.aorimage_shadow:SetActiveE(1)
                        _G.DelayDo(
                            0.2,
                            function()
                                if self.kaiguan == 1 then
                                    self.MotorRoot.gameObject:SetActiveE(1)
                                    _G.DelayDo(
                                        2.2,
                                        function()
                                            self.MotorRoot.gameObject:SetActiveE(0)
                                            closeFunc(data)
                                        end
                                    )
                                end
                            end
                        )
                    else
                        closeFunc(data)
                    end
                    _G.MainManager:GetInstance():RefreshAfkBoxTip()
                end
            )
        end
    elseif go == self.go_table.aorbtn_autoLeft then
        self:kaiguanbut()
    end
end

