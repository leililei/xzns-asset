    -- if self.kaiguan == nil or self.kaiguan == 0 then
    --     self.kaiguan = 0
    --     _G.PlayerPrefsManager.SetInt("Quick", self.kaiguan)
    -- end
    self.kaiguan = 0
    _G.PlayerPrefsManager.SetInt("Quick", self.kaiguan)
    self:kaiguanbut()
    self.GetCall = GetCall
    self:InitGetRewardView()
    -- _G.UIUtils.LoadEffectByCfg(
    --     _G.ConfigManager.ui_effect_cfg.ef_obj_GetRewardView,
    --     self.go_table.obj_GetawardView,
    --     function(obj)
    --         obj:SetLocalPosition(-316, -91, 0)
    --     end
    -- )
