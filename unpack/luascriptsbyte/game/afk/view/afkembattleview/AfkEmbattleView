local TrackingPointModel = require("TrackingPointModel")

local sectionType = {
    normal = 1,
    Elite = 2,
    Boss = 3,
    curState = 4
}
local afkcfg = _G.ConfigManager.afk_cfg
local SectionProgressItem = _G.BaseClass("SectionProgressItem")

function SectionProgressItem:__init(obj, sid)
    obj:SetName(sid)
    self.sid = sid
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj)
    self:Show()
end

function SectionProgressItem:Show()
    local curSid = require "AfkModel":GetInstance():GetCurSection()
    if self.sid == curSid then
        self.go_table.obj_curPos:SetActiveE(1)
        local cfg = afkcfg[curSid]
        self.go_table.aortext_section.text = string.format("%d-%d", cfg.chapter, cfg.section)
    elseif afkcfg[self.sid].type_section == sectionType.Elite and self.sid > curSid then
        self.go_table.obj_smallboss:SetActiveE(1)
    elseif afkcfg[self.sid].type_section == sectionType.Boss and self.sid > curSid then
        self.go_table.obj_bigboss:SetActiveE(1)
    elseif afkcfg[self.sid].section == 1 and self.sid > curSid then
        self.go_table.obj_firstSection:SetActiveE(1)
    else
        self.go_table.obj_BG:SetActiveE(1)
        if self.sid < curSid then
            self.go_table.obj_Pass:SetActiveE(1)
        end
    end
    self.gameObject:SetActiveE(1)
end

local EmbattleController = require "EmbattleController"
---@class AfkEmbattleView : UIBaseView    中文描述
---@field public go_table AfkEmbattleView_GoTable GoTable
local AfkEmbattleView = _G.BaseClass("AfkEmbattleView", _G.UIBaseView)

function AfkEmbattleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function AfkEmbattleView:OnCreate(exitCall, battleCall, autofight)
    self.onExitCall = exitCall
    self.onBattleCall = battleCall
    self.autoFight = autofight
    self:OpenEmbattleView()
    self:ShowCurSectionProgress()
    self:AddListener(_G.eBattleState.RecordStart, self.Hide)
    self:AddListener(_G.eBattleState.RecordEnd, self.Show)
    TrackingPointModel:GetInstance():SetWindowStartTime(self.viewName, true)

    --如果是最后一个关卡, 显示tip
    local model = require("AfkModel"):GetInstance()
    if model:CheckSectionIsEnd(model:GetCurSection()) and _G.PopWindowManager:GetInstance():CheckToggleWindow(210109) then
        _G.PopWindowManager:GetInstance():ShowBtnWindowByToggle(
                210109,
                function()
                end,
                nil,
                nil
        )
    end
end

function AfkEmbattleView:OnDestroy()
    self.maxsid = nil
    self.onExitCall = nil
    self.onBattleCall = nil
end

function AfkEmbattleView:OnClickBtn(go)
end

function AfkEmbattleView:ShowCurSectionProgress()
    local AfkModel = require("AfkModel"):GetInstance()
    local groups = AfkModel:GetSceneID()
    local cfg = _G.ConfigManager.monster_group_cfg[groups[1]]
    for i = 1, #cfg.DefaultAttackerSids do
        if cfg.DefaultAttackerSids[i] > 0 then
            self.go_table.obj_story:SetActiveE(1)
            return
        end
    end
    self.go_table.obj_story:SetActiveE(0)
    local ProgressInfo = self:GetProgressInfo()
    for id = 1, #ProgressInfo do
        SectionProgressItem.New(
                _G.InstantiateObject(self.go_table.obj_pointDetail, self.go_table.obj_Root),
                ProgressInfo[id]
        )
    end
end

function AfkEmbattleView:GetProgressInfo()
    local AfkModel = require("AfkModel"):GetInstance()
    local list = {}
    local Cursid = AfkModel:GetCurSection()
    local _cursid = Cursid
    if _cursid < 101004 then
        _cursid = 101004
    end
    for i = 1, 3 do
        if afkcfg[_cursid].next_section == 0 then
            self.maxsid = _cursid
            break
        end
        _cursid = afkcfg[_cursid].next_section
    end
    if self.maxsid then
        _cursid = self.maxsid
    end
    _G.table.insert(list, _cursid)
    for i = 1, 6 do
        _G.table.insert(list, afkcfg[_cursid].pre_section)
        _cursid = afkcfg[_cursid].pre_section
    end
    _G.SortList(
            list,
            function(a)
                return -a
            end
    )
    local index = _G.table.indexof(list, Cursid)
    if index > 1 then
        self.go_table.aorimage_progress:SetRectTransformSize(100 + (index - 1) * 80, 4)
    else
        self.go_table.aorimage_progress:SetRectTransformSize(100, 4)
    end
    return list
end

function AfkEmbattleView:OpenEmbattleView()
    local afkbattlemanagerins = require("AfkBattleManager"):GetInstance()
    local embattleids = afkbattlemanagerins:GetCurEmbattleID()
    if self.autoFight then
        --TODO:判定第一队是否有布阵角色，如果没有则不会自动进入战斗
        if not require("EmbattleModel"):GetInstance():CheckBattle(embattleids[1]) then
            self.autoFight = nil
        end
    end
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    EmbattleController:GetInstance():OpenEmbattle(
            embattleids,
            _G.EmbattleSaveType.localfile,
            true,
            _G.EmbattleControllerItemType.afk,
            _G.handler(self, self.OnExitCall),
            _G.handler(self, self.OnBattleCall),
            afkbattlemanagerins:GetMap(),
            afkbattlemanagerins:GetPage()
    )
end

function AfkEmbattleView:OnExitCall()
    TrackingPointModel:GetInstance():CloseActTracking(self.viewName)
    self:Close()
    require("DemoModel"):GetInstance():ClearTempEmbattleData()
    if self.onExitCall then
        self.onExitCall()
        self.onExitCall = nil
    end
end

function AfkEmbattleView:OnBattleCall(haveAssist, ...)
    if self.onBattleCall then
        self.onBattleCall(...)
        self.onBattleCall = nil
    end
end

---监听界面打开
---@param name string 界面名称
function AfkEmbattleView:OnEmbattleViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
        ---@type EmbattleNewView
        self.embattleView = _G.UIManager:GetInstance():GetWindowCtrl(name)
        --设置对阵信息
        local cfg = afkcfg[require("AfkModel"):GetInstance():GetCurSection()]
        local nameT = require("AfkModel"):GetInstance():GetCurChapterName()
        self.embattleView:SetVsDescription(
                _G.PlayerModel:GetInstance():GetName(),
                string.format("%s  %s-%s", LangUtil.GetLangPackValue(nameT[1]), cfg.chapter, cfg.section)
        )
        _G.UIManager:GetInstance():ChangeCanvasOrder(
                name,
                self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
        )
        self.embattleView.transform:SetParentE(self.go_table.trans_view)
        if self.autoFight then
            self.embattleView:SetAutoBattle()
        end
        self.embattleView:SetInitDoneCall(
                function()
                    self:InitDefDetailView()
                    self.go_table.obj_SectionProgress:SetActiveE(1)
                end
        )
        self.embattleView:SetEffLoadCall(
                function()
                    self.go_table.obj_SectionProgress:SetActiveE(0)
                end
        )
        self.embattleView:SetQuitCallback(_G.handler(self, self.CheckQuitEmbattle))
        -- self.embattleView:HideExitBtn()
        local groups = require("AfkModel"):GetInstance():GetSceneID()
        groups = #groups
        self.embattleView:ShowGroupTips(groups > 1, groups > 1 and _G.GetLangPackValue(90024900058, groups) or nil)
        self.embattleView:RegiestChooseViewOpen(_G.handler(self, self.OnCardListOpenCall))
        self.embattleView = self.embattleView
    end
end

function AfkEmbattleView:OnCardListOpenCall(show)
    self.showCardListTag = show
end

function AfkEmbattleView:CheckQuitEmbattle(call)
    local afkmodelins = require("AfkModel"):GetInstance()
    local groups = afkmodelins:GetSceneID()
    for i = 1, #groups do
        if afkmodelins:CheckMonsterIsPass(groups[i]) then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                    3309,
                    nil,
                    function()
                        --移除临时助战使用次数
                        require("FriendHelpModel"):GetInstance():RemoveTempCount()

                        call(true)
                        afkmodelins:ResetPass()
                    end,
                    function()
                        call(false)
                    end
            )
            return
        end
    end
    afkmodelins:ResetPass()
    call(true)
end

function AfkEmbattleView:InitDefDetailView()
    local AfkModel = require("AfkModel"):GetInstance()
    if AfkModel.CurFailTime > 0 then
        self.go_table.obj_right:SetActiveE(1)
        local monsterGroupId = AfkModel:GetCurMonsterID()
        if self.defDetailView == nil then
            ---@type EmbattleDefDetailView defDetailView
            self.defDetailView = self:AddComponent(
                    self.go_table.obj_right_root,
                    require("EmbattleDefDetailView").New(self.go_table.obj_right_root)
            )
            self.defDetailView:InitData(monsterGroupId)
        end
    else
        self.go_table.obj_right:SetActiveE(0)
    end
end

return AfkEmbattleView
