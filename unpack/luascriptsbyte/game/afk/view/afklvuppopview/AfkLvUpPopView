---@class AfkLvUpPopView : UIBaseView	中文描述
---@field public go_table AfkLvUpPopView_GoTable GoTable
local AfkLvUpPopView = _G.BaseClass("AfkLvUpPopView", _G.UIBaseView)

function AfkLvUpPopView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.AffixItems = {}
end

---界面的入口函数
function AfkLvUpPopView:OnCreate(sid, callback)
    self.cfg = _G.ConfigManager.afk_cfg[sid]
    self.call = callback
    --self:UILoopUIEffect()
    self:SetGiftPreview()
    self:FreshUp()
    self:LoadEffect()
    local time = _G.PopWindowManager:GetInstance():AutoCloseTime(_G.PopViewShowOrder.AfkLevelUp)
    if time > 0 then
        self.closeTimer = _G.TimerManager:GetInstance():GetTimer(time, self.CloseView, self, true, false)
        self.closeTimer:Start()
     end
    _G.AudioManager.PlayAudioByAudioCfgID(2057)
end

---按钮点击事件在这里派发
function AfkLvUpPopView:OnClickBtn(go)
    if go == self.go_table.aorbtn_anyClose then
        self:CloseView()
    end
end

function AfkLvUpPopView:CloseView()
    self:Close()
end

function AfkLvUpPopView:LoadEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ShowAwardVBGShengLI,
        self.go_table.obj_eff,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
        end
    )
end

function AfkLvUpPopView:FreshUp()
    self.go_table.aortext_after1.text = self.cfg.eff_exp_team * 120 .. LangUtil.GetLangPackValue(90021800504)
    self.go_table.aortext_after2.text = self.cfg.eff_exp_hero * 120 .. LangUtil.GetLangPackValue(90021800504)
    self.go_table.aortext_after3.text = self.cfg.eff_coin * 120 .. LangUtil.GetLangPackValue(90021800504)
    if self.cfg.pre_section ~= 0 then
        local lastCfg = _G.ConfigManager.afk_cfg[self.cfg.pre_section]
        local up1 = self.cfg.eff_exp_team - lastCfg.eff_exp_team
        self.go_table.obj_upItem1:SetActiveE(up1 > 0 and 1 or 0)
        self.go_table.aortext_before1.text = lastCfg.eff_exp_team * 120 .. LangUtil.GetLangPackValue(90021800504)
        local up2 = self.cfg.eff_exp_hero - lastCfg.eff_exp_hero
        self.go_table.obj_upItem2:SetActiveE(up2 > 0 and 1 or 0)
        self.go_table.aortext_before2.text = lastCfg.eff_exp_hero * 120 .. LangUtil.GetLangPackValue(90021800504)
        local up3 = self.cfg.eff_coin - lastCfg.eff_coin
        self.go_table.obj_upItem3:SetActiveE(up3 > 0 and 1 or 0)
        self.go_table.aortext_before3.text = lastCfg.eff_coin * 120 .. LangUtil.GetLangPackValue(90021800504)
    else
        self.go_table.obj_upItem1:SetActiveE(1)
        self.go_table.obj_upItem2:SetActiveE(1)
        self.go_table.obj_upItem3:SetActiveE(1)
        self.go_table.aortext_before1.text = 0 .. LangUtil.GetLangPackValue(90021800504)
        self.go_table.aortext_before2.text = 0 .. LangUtil.GetLangPackValue(90021800504)
        self.go_table.aortext_before3.text = 0 .. LangUtil.GetLangPackValue(90021800504)
    end
end

-- 解锁礼包显示
function AfkLvUpPopView:SetGiftPreview()
    self.awardList = self.cfg.Unlock_item or {}
    self:ParseAward(self.awardList)
    self.go_table.aorrawimage_r2:SetActiveE(#self.AffixData > 0 and 1 or 0)
    --self.go_table.scrollloophorizontal_AwardList:InitItemData(#self.AffixData, _G.handler(self, self.RefreshItem))
    self.go_table.obj_Content:ClearChildren()
    for i = 1, #self.AffixData do
        local obj = _G.InstantiateObject(self.go_table.obj_AwardItem, self.go_table.obj_Content)
        local data = self.AffixData[i]
        local instance = obj:GetInstanceIDE()
        if self.AffixItems[instance] == nil then
            self.AffixItems[instance] = require("BaseAwardNewItem").New(obj, nil, 75)
        end
        self.AffixItems[instance]:Show(
            data,
            function(item)
                _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_kelingqukuang, item.item.go_table.obj_uieffect)
            end
        )

    end
end

--解析奖励
---@param data award.i_award_item 奖励数据
function AfkLvUpPopView:ParseAward(data)
    self.AffixData = {}
    for i = 1, #data do
        local data2 = {sid = data[i], count = 0}
        local type = _G.StorageManager:GetInstance():CheckSidType(data2.sid)
        if type == _G.StorageType.Card or type == _G.StorageType.Equipment or type == _G.StorageType.Decoration then
            for i = 1, data2.count do
                local itemData = _G.StorageManager:GetInstance():GetItemDataClass(data2.sid, 0)
                 --, data2.extend)
                _G.table.insert(self.AffixData, itemData)
            end
        else
            local itemData = _G.StorageManager:GetInstance():GetItemDataClass(data2.sid, data2.count)
            _G.table.insert(self.AffixData, itemData)
        end
    end
end

---刷新附件
function AfkLvUpPopView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    index = index + 1
    local data = self.AffixData[index]
    local instance = obj:GetInstanceIDE()
    if self.AffixItems[instance] == nil then
        self.AffixItems[instance] = require("BaseAwardNewItem").New(obj, nil, 75)
    end
    self.AffixItems[instance]:Show(data)
end

function AfkLvUpPopView:OnDestroy()
    if self.call then
        self.call()
    end
    if self.closeTimer then
        self.closeTimer:Stop()
    end
    _G.PopWindowManager:GetInstance():SetNowPopping(false)
    _G.PopWindowManager:GetInstance():Next()
end

return AfkLvUpPopView
