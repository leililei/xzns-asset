---更新单个奖励显示
function ActiveSeverMergeLoginPanel:UpdateAward(index)
    local tb = _G.GetAutoGoTable(self.go_table["obj_Award_" .. index], _G.handlerbind(self, self.GetAllAward))
    local isGet = self.model:CheckIsGetLoginAward(index)
    local canGet = not isGet and self.curDay >= index
    tb.aorbtn_Click:SetActiveE(canGet and 1 or 0)
    tb.obj_isGet:SetActiveE(isGet and 1 or 0)
    tb.obj_AwardRoot:ClearChildren()
    local item = require("BaseAwardNewItem").New(tb.obj_AwardRoot)
    item:ShowWithID(self.cfg[index].rewards[1])
    local languageid
    local color
    local daycolor
    if isGet then
        languageid=90000010221
        color="#6A6764"
        daycolor="#817767"
        tb.aorimage_Bg.SpriteName="ui_qrqd_dk3"
    elseif canGet then
        languageid=90028500022
        color="#423C89"
        daycolor="#605A77"
        tb.aorimage_Bg.SpriteName="ui_qrqd_dk2"
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_kelingqukuang, item.gameObject)
        self.hasAward = true
    else
        languageid=90022100030
        color="#423C89"
        daycolor="#605A77"
        tb.aorimage_Bg.SpriteName="ui_qrqd_dk2"
    end
    tb.aortext_tips.text=string.format("<color=%s>%s</color>",color,_G.GetLangPackValue(languageid))
    tb.aortext_Day.text =string.format("<color=%s>%s</color>",daycolor,_G.GetLangPackValue(90023800006, index)) 
end

---合并奖励
function ActiveSeverMergeLoginPanel:AddAward(source, new)
    local result = source
    local ItemDic = {}
    for k, v in pairs(source.award.item) do
        local type = v.type[1]
        if not ItemDic[type] then
            ItemDic[type] = k
        end
    end
    for _, v in pairs(new.award.item) do
        local type = v.type[1]
        if ItemDic[v.type[1]] then
            local Dic = ItemDic[type]
            local Item = result.award.item[Dic]
            result.award.item[Dic].type[2] = Item.type[2] + v.type[2]
            result.award.item[Dic].type[3] = Item.type[3] + v.type[2]
        else
            local count = #result.award.item + 1
            result.award.item[count] = { type = {} }
            for i = 1,  #self.cfg do
                table.insert(result.award.item[count].type, v.type[i])
            end
            ItemDic[type] = #result.award.item
        end
    end

    return result
end

---检测指定期数是否有可领取奖励
function ActiveSeverMergeLoginPanel:GetAwardState()
    for i = 1,  #self.cfg do
        if self.model:CheckCanTakeLoginAward(i) then
            return true
        end
    end
    return false
end

---一键领取
function ActiveSeverMergeLoginPanel:GetAllAward()
    if not self.hasAward then
        return
    end
    local canGet = {}
    local indexT = {}
    for i = 1, #self.cfg do
        if self.model:CheckCanTakeLoginAward(i) then
            _G.table.insert(canGet, self.cfg[i].day)
            _G.table.insert(indexT, i)
        end
    end
    self.model:GetSignReward(
            canGet,
            function (msg)
                if msg.ack == 1 then
                    for k, _index in ipairs(canGet) do
                        self:UpdateAward(indexT[k])
                    end
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                    self:UpdateBtn()
                    self:InitView()
                end
            end
    )
end

---切换期数
function ActiveSeverMergeLoginPanel:FreshView()
    self.hasAward = false
    for i = 1, table.count(self.model.merge_login_cfg) do
        self:UpdateAward(i)
    end
    self.go_table.aorbtn_Get:SetActiveE(1)
    self:UpdateBtn()
end

function ActiveSeverMergeLoginPanel:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_Get" then
        if not self.hasAward then
            _G.PopWindowManager:GetInstance():ShowAllTips(25)
            return
        else
            self:GetAllAward()
        end
    end
end

function ActiveSeverMergeLoginPanel:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.eTeamUnite.Refresh, self.InitView, self)
end


return ActiveSeverMergeLoginPanel