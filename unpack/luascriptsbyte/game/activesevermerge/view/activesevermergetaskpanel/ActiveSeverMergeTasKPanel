        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 84)
    elseif name == "$_aorbtn_day_1" then
        if self.curOnclick_num ~= 1 then
            self:DayButtonClick(1)
        end
    elseif name == "$_aorbtn_day_2" then
        if self.curOnclick_num ~= 2 then
            self:DayButtonClick(2)
        end
    elseif name == "$_aorbtn_day_3" then
        if self.curOnclick_num ~= 3 then
            self:DayButtonClick(3)
        end
    elseif name == "$_aorbtn_day_4" then
        if self.curOnclick_num ~= 4 then
            self:DayButtonClick(4)
        end
    elseif name == "$_aorbtn_day_5" then
        if self.curOnclick_num ~= 5 then
            self:DayButtonClick(5)
        end
    elseif name == "$_aorbtn_day_6" then
        if self.curOnclick_num ~= 6 then
            self:DayButtonClick(6)
        end
    elseif name == "$_aorbtn_day_7" then
        if self.curOnclick_num ~= 7 then
            self:DayButtonClick(7)
        end
    elseif name == "@_aorbtn_AllPallLingqu" then
        self:AllPassRewardBtnOnClick()
    elseif name == "$_aorbtn_dailyGift" then
        if self.TypeMission == 1 then
            self:ChooseType(2)
        end
    elseif name == "$_aorbtn_dailyTask" then
        if self.TypeMission == 2 then
            self:ChooseType(1)
        end
    end
