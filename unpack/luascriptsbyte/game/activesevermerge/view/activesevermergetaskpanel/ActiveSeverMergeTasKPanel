---更新 目标点数奖励(7日,和14日)
function ActiveSeverMergeTasKPanel:UpDateGoalsAward()
    local cfg = {}
    cfg = self.model.activeCfgs
    local goalcoin = self.model.goalsNum

    for i = 1, #cfg do
        if cfg[i] then
            local it=nil
            if #self.goals_lists<i then
                it =_G.InstantiateObject(self.go_table.obj_rewardNode,self.go_table.trans_ActiveRewardNode)
                table.insert(self.goals_lists,it)
            else
                it=self.goals_lists[i]
            end
            it:SetActiveE(1)
            local tb = _G.GetAutoGoTable(it)
            local id = cfg[i].id
            tb.aorimage_max:SetActiveE(i==#cfg and 1 or 0)
            tb.obj_item:SetLocalScaleXYZ(i==#cfg and 0.7 or 0.56)
            tb.aortext_Active_num.text = cfg[i].value_active[2]
            local isGoals = false
            if goalcoin >= cfg[i].value_active[2] then
                --tb.aorimage_bg.SpriteName = "ui_qrmb_jf_jdt_jd_01"
                isGoals = true
            else
                --tb.aorimage_bg.SpriteName = "ui_qrmb_jf_jdt_jd_03"
                isGoals = false
            end
            local isLingqu = false
            if _G.table.isEmptyOrNil(self.model.goals_award) then
                isLingqu = false
            else
                for _, value in pairs(self.model.goals_award) do
                    if id == value then
                        isLingqu = true
                        break
                    end
                end
            end
            --tb.obj_lingqu:SetActiveE(isLingqu and 1 or 0)
            tb.obj_normal:SetActiveE(not isLingqu and 1 or 0)
            local reward = cfg[i].reward
            if self.all_mubiaodian and self.all_mubiaodian[i] then
                _G.DestroyObject(self.all_mubiaodian[i].gameObject)
                --require("ItemViewBase").Despawn(self.all_mubiaodian[i])
            end
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                    reward,
                    tb.obj_item,
                    function(item)
                        if self.all_mubiaodian[i] == nil then
                            self.all_mubiaodian[i] = {}
                        end
                        self.all_mubiaodian[i] = item
                        item.gameObject:SetRectTransformAnchorMin(0.5, 0.5)
                        item.gameObject:SetRectTransformAnchorMax(0.5, 0.5)
                        item.gameObject:SetLocalPosition(0, 0, 0)
                        item:SetGouScroll(isLingqu)
                        item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                        if isGoals then
                            item:ShowEffectOrder(not isLingqu)
                        end
                    end,
                    function(go, isOn)
                        self:GoalsNumberBtn(go, id, cfg[i].value_active[2], reward[1])
                    end
            )

            ---动态设置目标点红点 参数
            tb.obj_redpoint_down:UpdateRedPointItemIDAndParam(self.active:GetActivityTypeCls():GetRedpointIDByIndex(5),id)
        end
    end
end

---目标点数 点击事件
function ActiveSeverMergeTasKPanel:GoalsNumberBtn(go, sid, goalsNumber, itemid)
    if not _G.table.isEmptyOrNil(self.model.goals_award) then
        for i = 1, #self.model.goals_award do
            if sid == self.model.goals_award[i] then
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, itemid)
                return
            end
        end
    end
    local goalcoin = self.model.goalsNum
    if goalsNumber > goalcoin then
        --local _, storageID = _G.StorageManager:GetInstance():CheckSidType(self.itemData.sid)
        require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, itemid)
        return
    else
        self.model:GoalsReward(
                sid,
                function()
                    self:UpDateGoalsActiveNum()
                    self:UpDateGoalsAward()
                end
        )
    end
end

