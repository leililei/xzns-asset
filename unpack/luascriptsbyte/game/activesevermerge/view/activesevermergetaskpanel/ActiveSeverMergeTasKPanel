function ActiveSeverMergeTasKPanel:LoadSeceneAndRole()
    local cardid = require "ActiveSeverMergeModel":GetInstance():GetCurrentModelCardid()
    if cardid==0 then
        return
    end
    local cfg = require "CardCommentManager":GetInstance():CardData(cardid[1], true)
    if self.sceneTrans == nil then
        self.sceneTrans = self.ResList["sceneTrans"]
        self:LoadRoleScene(
                cfg.ModelPathHi,
                function(roleTrans)
                    if _G.IsNil(self.go_table) then
                        _G.DestroyObject(roleTrans)
                        return
                    end
                    self.current_cardid = cardid
                    self.roleTrans = roleTrans
                    roleTrans:SetParentE(self.sceneTrans)
                    roleTrans:SetLocalScaleXYZ(cardid[2])
                    self:InitRotPos()
                end
        )
    else
        if cardid ~= self.current_cardid then
            self.current_cardid = cardid
            self:LoadRoleScene(
                    cfg.ModelPathHi,
                    function(roleTrans)
                        if _G.IsNil(self.go_table) then
                            _G.DestroyObject(roleTrans)
                            return
                        end
                        if cardid ~= self.current_cardid then
                            _G.DestroyObject(roleTrans)
                            return
                        end
                        self.roleTrans = roleTrans
                        roleTrans:SetParentE(self.sceneTrans)
                        roleTrans:SetLocalScaleXYZ(cardid[2])
                        self:InitRotPos()
                    end
            )
        end
    end
end

function ActiveSeverMergeTasKPanel:InitRotPos()
    if _G.IsNil(self.roleTrans) then
        return
    end
    if self.co2 then
        self.entr = false
        _G.coroutine.stopwaiting(self.co2)
        self.co2 = nil
    end
    self.roleTrans:SetLocalEulerAngles(0, 0, 0)
    --播放一次 初始化 RoleAnimatorController.cs--> animationTime
    self.AnimComponent = _G.RoleAnimatorController.GetOrCreateAnimatorController(self.roleTrans)
    local card = require "CardCommentManager":GetInstance():CardData(114200000)
    local display_entr = card.display_entr
    if not string.IsNullOrEmpty(display_entr) then
        if self.AnimComponent:isHaveAni(display_entr) and (display_entr ~= "idle_1" or display_entr ~= "stand_1") then
            self.entr = true
            self.co2 = _G.coroutine.start(_G.handlerbind(self, self.CoTitleAndHolePosition, display_entr))
            _G.AnimatorPlayEndCallback.AddCallback(
                    self.AnimComponent:GetInstanceIDE(),
                    _G.handler(self, self.PlayAniCallBack)
            )
        else
            self.AnimComponent:Play(display_entr, true)
        end
    else
        --- 否则默认播放 idle配置
        self.AnimComponent:Play("idle_1", true)
        self:PlayAniCallBack()
    end
end

function ActiveSeverMergeTasKPanel:CoTitleAndHolePosition(display_entr)
    self.AnimComponent:Play(display_entr, true)
    while self.entr do
        --local x, y, z = self.bip:GetPosition()
        _G.coroutine.waitforendofframe()
    end
end

---播放动画的回调
function ActiveSeverMergeTasKPanel:PlayAniCallBack(isShow)
    if _G.IsNil(self.roleTrans) or _G.IsNil(self.AnimComponent) then
        return
    end
    if self.co2 then
        _G.coroutine.stopwaiting(self.co2)
        self.entr = false
    end
    --播放一次 初始化 RoleAnimatorController.cs--> animationTime
    local card = require "CardCommentManager":GetInstance():CardData(114200000)
    local display_idle = card.display_idle
    if not string.IsNullOrEmpty(display_idle) then
        self.AnimComponent:Play(display_idle, true)
    end
    _G.AnimatorPlayEndCallback.RemoveCallback(self.AnimComponent:GetInstanceIDE())
end

