function ActiveSeverMergeTasKPanel:RefreshScroll(index, obj)
    local item = obj
    if self.TypeMission == 1 then
        local task = self.oneAlltask[index + 1]
        --item:SetName(index + 1 .. " task_id: " .. task.task.i_task.sid .. " state：" .. task.task.i_task.state)
        local tb_i = self:GetComponent(item, ActiveSeverMergeTaskInfo)
        if tb_i == nil then
            item:SetActiveE(1)
            self:AddComponent(
                    item,
                    ActiveSeverMergeTaskInfo.New(
                            item,
                            task,
                            _G.handler(self, self.CallBackBtn),
                            _G.handler(self, self.CloseView),
                            self.TypeMission
                    )
            )
        else
            tb_i:ShowDes(task, _G.handler(self, self.CallBackBtn), _G.handler(self, self.CloseView))
        end
    elseif self.TypeMission == 2 then
        local task = {}
        if index == 0 then
            task.id = 3
            task.dayid = self.DailyAlltasks.id
            task.diamond = self.DailyAlltasks.diamond
        elseif index > 0 then
            task.id = 2
            task.dayid = self.DailyAlltasks.id
            task.rmb = self.DailyAlltasks.rmb[index]
        end

        local tb_i = self:GetComponent(item, ActiveSeverMergeTaskInfo)
        if tb_i == nil then
            item:SetActiveE(1)
            self:AddComponent(
                    item,
                    ActiveSeverMergeTaskInfo.New(
                            item,
                            task,
                            _G.handler(self, self.CallBackBtn),
                            _G.handler(self, self.CloseView),
                            self.TypeMission
                    )
            )
        else
            tb_i:ShowDes(task, _G.handler(self, self.CallBackBtn), _G.handler(self, self.CloseView))
        end
    end
end

