---设置进度条
function ActiveSeverMergeTasKPanel:SetJinduTiao()
    local value=0
    local stagecount=611/#self.model.activeCfgs
    for i = 1, #self.model.activeCfgs do
        if i==1 and  self.model.goalsNum <= self.model.activeCfgs[i].value_active[2] then
            value=stagecount*(self.model.goalsNum/self.model.activeCfgs[i].value_active[2])
            break
        elseif i>1 and  self.model.goalsNum <= self.model.activeCfgs[i].value_active[2] then
            local float=(self.model.goalsNum-self.model.activeCfgs[i-1].value_active[2])/(self.model.activeCfgs[i].value_active[2]-self.model.activeCfgs[i-1].value_active[2])
            value=stagecount*( float+ i-1)
            break
        end
    end
    self.go_table.aorimage_bar:SetRectTransformSize(value > 0 and value or 0, 10)
end

