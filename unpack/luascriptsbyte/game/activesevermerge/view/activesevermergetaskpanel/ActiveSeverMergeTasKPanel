---更新 每天的 具体任务
function ActiveSeverMergeTasKPanel:UpDataShowOneDayAllTasks()
    self.redid2 = 0
    self.go_table.aorimage_quangtongbg:SetActiveE(0)
    self.go_table.scrollloopvectical_oneTaskInfo:SetActiveE(0)

    local day = self.curOnclick_num or 1

    if self.TypeMission == 1 then
        self.go_table.aorimage_quangtongbg:SetActiveE(1)
        self.go_table.scrollloopvectical_dayTaskInfo:SetActiveE(1)
        -- body
        local allTask = self.model:GetAllDayTasks()

        self.oneAlltask = allTask[self.model.currenDay]
        _G.table.sort(
                self.oneAlltask,
                function(a, b)
                    --- 不同任务状态优先级
                    local function sortState(task)
                        if task.i_task.state == _G.TaskEnum.ETaskState.Submited then
                            return 10
                        elseif task.i_task.state == _G.TaskEnum.ETaskState.Executing then
                            return 9
                        elseif task.i_task.state == _G.TaskEnum.ETaskState.Claimed and task.i_task.target[1] > 0 then
                            if task.taskEnumType == _G.ActiveTaskEnum.ConditionEnum.Arena.Rank then
                                return 7
                            else
                                return 8
                            end
                        elseif task.isUnlock == false then
                            return 5
                        elseif task.i_task.state == _G.TaskEnum.ETaskState.Claimed then
                            return 6
                        elseif task.i_task.state == _G.TaskEnum.ETaskState.Completed then
                            return 4
                        end
                        return 0
                    end

                    local aState = sortState(a.task)
                    local bState = sortState(b.task)
                    if aState ~= bState then
                        return aState > bState
                    end
                    --a.task.i_task.target[1] > b.task.i_task.target[1]
                    return a.task.i_task.sid < b.task.i_task.sid
                end
        )

        if day <= self.model:GetCurrentDay() then
            --每天具体任务
            --设置 神石背包 格子的数量
            if self.mlist1 == nil then
                self.go_table.scrollloopvectical_dayTaskInfo:InitItemData(
                        #self.oneAlltask,
                        _G.handler(self, self.RefreshTask)
                )
                self.mlist1 = self.go_table.scrollloopvectical_dayTaskInfo
            else
                self.go_table.scrollloopvectical_dayTaskInfo:UpdateCount(#self.oneAlltask)
            end
        end
    elseif self.TypeMission == 2 then
        -- body
        self:Redpoint()
        local allTask = self.model:GetDailyAlltasks()
        self.go_table.scrollloopvectical_oneTaskInfo:SetActiveE(1)
        self.DailyAlltasks = allTask[self.model.currenDay]
        if day <= self.model:GetCurrentDay() then
            --每天具体任务
            --设置 神石背包 格子的数量
            if self.mlist2 == nil then
                self.go_table.scrollloopvectical_oneTaskInfo:InitItemData(#self.DailyAlltasks.rmb+1, _G.handler(self, self.RefreshTask))
                self.mlist2 = self.go_table.scrollloopvectical_oneTaskInfo
            else
                self.go_table.scrollloopvectical_oneTaskInfo:UpdateCount(#self.DailyAlltasks.rmb+1)
            end
        end
    end
end

