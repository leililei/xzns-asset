function ActiveSeverMergeTasKPanel:UpdateTime(elapsed)
    if self.time == nil then
        self.time = require "ActiveSeverMergeModel":GetInstance():GetCurrentTime()
    else
        self.time = self.time - elapsed
    end
    local str = Mathf.RoundToInt(self.time)
    if self.time <= 0 then
        str = _G.LangUtil.TryGetLangValue(90023800055)
        self.go_table.aortext_time.text = str
    else
        str = _G.TimeUtil.TransDayHourMineMiao(math.ceil(self.time))
        --self.go_table.aortext_time.text = _G.LangUtil.TryGetLangValue(90026100001, str)
        self.go_table.aortext_time.text = str
    end
    if not self.showpftime then
        self.showpftime=0
        self.showpfindex=1
        self:ShowpfItem(self.showpfindex)
    else
        self.showpftime= self.showpftime+elapsed
        if self.showpftime>=3 then
            self.showpftime=0
            self.showpfindex= self.showpfindex>= #self.dajiangdata.cfg.UseParameter and 1 or (self.showpfindex+1)
            self:ShowpfItem(self.showpfindex)
        end
    end
end
