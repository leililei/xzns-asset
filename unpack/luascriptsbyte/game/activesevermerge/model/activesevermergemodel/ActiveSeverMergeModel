---单条 任务（完成)
function ActiveSeverMergeModel:SendTaskOneFinish(da, taskList, Call)
    local T = {}
    for i = 1, #taskList do
        T[i] = taskList[i].task.i_task.sid
    end
    local pbData = {
        task = { { day = taskList[1].task.dayid, sid = T } },
        finish_type = 2,
        activity_id = self.activity.activityID
    }
    local d = taskList[1].task.dayid
    require("ActiveSeverMergeNet"):GetInstance():SendTaskOneFinish(
        pbData,
        function(data)
            if data.ack ~= 1 then
                return
            end
            if data.award then
                _G.StorageManager:GetInstance():ReceiveAwardData(data)
                for k, v in pairs(data.award.item) do
                    if v.type[1] == _G.ResPropID.ServerMergeActivePoint then
                        self.goalsNum = self.goalsNum + v.type[2]
                    end
                end
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.CommonAwardView.Name,
                    data,
                    function()
                        _G.PlayerModel:GetInstance():ShowRoleLvUpAward()
                    end
                )
            end
            local alltasks = self:GetAllDayTasks()
            local onetaskData = alltasks[self.currenDay]
            for k, v in pairs(data.new_task) do
                for i = 1, #onetaskData do
                    if v.sid == onetaskData[i].task.i_task.sid then
                        onetaskData[i].task.i_task.state = v.state
                        break
                    end
                end
            end
            require("RedPointManager"):GetInstance():RefreshNodeByAllParams(self.activity:GetActivityTypeCls()
                :GetRedpointIDByIndex(4))
            require("RedPointManager"):GetInstance():RefreshNodeByAllParams(self.activity:GetActivityTypeCls()
                :GetRedpointIDByIndex(5))
            if Call then
                Call()
            end
        end
    )
end

function ActiveSeverMergeModel:ParseScoreAward(day, data)
    local awardDatas = {
        award = {
            item = {},
            overflow = data.award.overflow
        }
    }
    for i = 1, #data.award.item do
        local sid = data.award.item[i].type[1]
        if sid == _G.ResPropID.ServerMergeActivePoint then
            self.goalsNum = self.goalsNum + data.award.item[i].type[2]
        else
            local temp = data.award.item[i]
            _G.table.insert(awardDatas.award.item, temp)
        end
    end
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(self.activity:GetActivityTypeCls()
        :GetRedpointIDByIndex(5))
    return awardDatas
end

