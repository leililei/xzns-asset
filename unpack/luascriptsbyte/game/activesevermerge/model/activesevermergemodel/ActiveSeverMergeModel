                    _G.PlayerModel:GetInstance():ShowRoleLvUpAward()
                end
            )
            ---添加 累计点数数领取标记
            --刷新红点 GoalTarget
            require("RedPointManager"):GetInstance():RefreshNodeByAllParams(self.activity:GetActivityTypeCls()
                :GetRedpointIDByIndex(5))
            if Call then
                Call()
            end
        end
    )
end

---领取签到奖励
---@param days {number}
function ActiveSeverMergeModel:GetSignReward(days, Call)
    local pbData = {
        day = days,
        activity_id = self.activity.activityID
    }
    require("ActiveSeverMergeNet"):GetInstance():SendLoginAward(
        pbData,
        function(data)
            if data.ack ~= 1 then
                return
            end
            ---加入已经领取的 标记
            for i = 1, #days do
                _G.table.insert(self.logins_award, days[i])
            end
            --刷新红点 GoalTarget
            require("RedPointManager"):GetInstance():RefreshNodeByAllParams(self.activity:GetActivityTypeCls()
                :GetRedpointIDByIndex(3))
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            for k, v in pairs(data.award.item) do
                if v.type[1] == _G.ResPropID.ServerMergeActivePoint then
                    self.goalsNum = self.goalsNum + v.type[2]
                end
            end
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CommonAwardView.Name,
                data,
                function()
                    _G.PlayerModel:GetInstance():ShowRoleLvUpAward()
                end
            )
            ---添加 累计点数数领取标记
            if Call then
                Call(data)
            end
        end

    )
end

