--region 其他检测
---检测 其他天数是否接取了任务
function ActiveSeverMergeModel:CheckOtherDayTask()
    local alltask = self:GetAllDayTasks()
    local temp = {}
    temp.accept = {}
    for day = 1, self.currenDay do
        local count1 = #self.merge_mission_cfg[day].mission_extra1
        local count2 = #self.merge_mission_cfg[day].mission_extra2
        local count3 = alltask[day] and #alltask[day] or 0
        if count3 < (count1 + count2) then
            local data = {
                day = day,
                sids = {}
            }
            local task = self:GetCurrentDayTask(day)
            local t = {}
            for i = 1, #task do
                _G.table.insert(t, task[i])
            end
            data.sids = t
            _G.table.insert(temp.accept, data)
        end
    end
    return temp
end

function ActiveSeverMergeModel:CheckCanTakeLoginAward(index)
    local cfg = self.merge_login_cfg[index]
    if cfg and self.logins >= cfg.day and not table.ContainsValue(self.logins_award, cfg.day) then
        return true
    end
    return false
end

function ActiveSeverMergeModel:CheckIsGetLoginAward(index)
    local cfg = self.merge_login_cfg[index]
    if cfg and table.ContainsValue(self.logins_award, cfg.day) then
        return true
    end
    return false
end

