function ActiveSeverMergeModel:UpdataTask(task)
    ---检测功能有没有开启
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(42) then
    else
        return
    end
    local isUpdata = false
    if task == nil or task.sid == nil then
        return isUpdata
    end
    local mTask = self:GetTaskByTaskid(task.sid)
    if mTask == nil then
        return isUpdata
    end
    mTask.task:UpdataData(task)

    return true
end

function ActiveSeverMergeModel:GetTaskByTaskid(taskid)
    for i = 1, #self.AllDayTasks do
        local tasksAll = self.AllDayTasks[i]
        for j = 1, #tasksAll do
            if tasksAll[j].task.i_task.sid == taskid then
                return tasksAll[j]
            end
        end
    end
    return nil
end

