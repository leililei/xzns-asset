---获得天数页签上红点
---@param param number 天数
function ActiveSeverMergeModel:GetRedPointActionDayNum(param)
    ---检测天数是否开启
    local day = self:GetCurrentDay()
    if param and param > day then
        return 0
    end
    local allTask = self:GetAllDayTasks()
    if not param then
        for k, v in pairs(allTask) do
            if k <= day and self:ReturnShowRedPointInOneDay(v, k) == 1 then
                return 1
            end
        end
        return 0
    else
        local onePassTask = allTask[param]
        return self:ReturnShowRedPointInOneDay(onePassTask, param)
    end
end

function ActiveSeverMergeModel:ReturnShowRedPointInOneDay(onePassTask, day)
    if onePassTask == nil then
        return 0
    end
    local flag = true
    for key, value in pairs(onePassTask) do
        if value.task.i_task.state == _G.TaskEnum.ETaskState.Submited then
            return 1
        elseif value.task.i_task.state ~= _G.TaskEnum.ETaskState.Completed then
            flag = false
        end
    end
    --检测 全通奖励
    if not _G.table.isEmptyOrNil(self.day_award) then
        for key, value in pairs(self.day_award) do
            if value == day then
                return 0
            end
        end
    end

    if flag then
        return 1
    end
    return 0
end

---获得进度目标点奖励红点
function ActiveSeverMergeModel:GetRedPointGoalsRedpoint(param)
    local num = self.goalsNum
    if num == nil then
        return 0
    end
    if param then
        local cfg = table.find(self.activeCfgs, function(a) return a.id == param end)
        if cfg then
            --检测目标点数
            if num < cfg.value_active[2] then
                return 0
            end
        else
            return 0
        end
        for i = 1, #self.goals_award do
            if self.goals_award[i] == param then
                return 0
            end
        end
        return 1
    else
        for k, v in pairs(self.activeCfgs) do
            if num >= v.value_active[2] then
                local isget = false
                for i = 1, #self.goals_award do
                    if self.goals_award[i] == v.id then
                        isget = true
                    end
                end
                if not isget then
                    return 1
                end
            end
        end
        return 0
    end
end

function ActiveSeverMergeModel:GetRedPointLoginAwardRedPoint(param)
    local isGet = false
    if param then
        isGet = table.ContainsValue(self.logins_award, param)
        local cfg = table.find(self.merge_login_cfg, function(a) return a.id == param end)
        return (isGet or cfg.day > self.logins) and 0 or 1
    else
        isGet = true
        for k, v in pairs(self.merge_login_cfg) do
            isGet = table.ContainsValue(self.logins_award, v.day)
            if not isGet and v.day <= self.logins then
                return 1
            end
        end
    end
    return 0
end

