---@class RecordTotalZhaomuNet : BaseGameNet	通信协议
local RecordTotalZhaomuNet = _G.BaseClass("RecordTotalZhaomuNet", require "BaseGameNet")
local base = require "BaseGameNet"

---@return RecordTotalZhaomuNet RecordTotalZhaomuNet
function RecordTotalZhaomuNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求
---@param pbData table PB数据
---@param callback function 完成回调
function RecordTotalZhaomuNet:SendAccess(pbData, item, callback)
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.SuccessCall))
    self.Call[port] = callback
end

---获取累计招募的信息
function RecordTotalZhaomuNet:GetInfo(callback)
    local pbData = self:GetEmptyPB()
    self:SendAccess(pbData, _G.ConfigManager.net_map.game_activity_recruiting_info, callback)
end

---领取奖励
function RecordTotalZhaomuNet:GetAward(taskIds, callback)
    self:SendAccess({t_ids = taskIds}, _G.ConfigManager.net_map.game_activity_recruiting_finish, callback)
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function RecordTotalZhaomuNet:SuccessCall(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type RecordTotalZhaomuNet
return RecordTotalZhaomuNet
