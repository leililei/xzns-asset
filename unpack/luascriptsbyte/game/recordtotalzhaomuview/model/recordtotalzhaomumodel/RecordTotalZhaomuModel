local RecordTotalZhaomuNet = require "RecordTotalZhaomuNet"
---@class RecordTotalZhaomuModel
local RecordTotalZhaomuModel = _G.BaseClass("RecordTotalZhaomuModel", _G.GameDataModelBase)
---创建对象时,入口构造函数
function RecordTotalZhaomuModel:__init()
    self.endCallback = nil
    self.isShow = 0
    self.OpenTime = 0
    self.Complete = false --任务完成是否显示页面 （特殊情况 任务完成，还有剩余时间）
end

local TimeLimit = 104504
local activity_recruiting_cfg = _G.ConfigManager.activity_recruiting_cfg

---@return RecordTotalZhaomuModel RecordTotalZhaomuModel
function RecordTotalZhaomuModel:GetInstance()
    return self.super.GetInstance(self)
end

function RecordTotalZhaomuModel:GetInfo(callback)
    ---@class AwardInfo 累计招募奖励信息
    ---@field id number 任务id
    ---@field desc number 任务描述
    ---@field condition number 任务完成条件
    ---@field reward table 任务奖励
    ---@field link number 任务跳转界面ID
    ---@field note string 备注
    self.RecordTotalZhaomuAwardList = {}
    self.ZhaomuInfo = {}
    RecordTotalZhaomuNet:GetInstance():GetInfo(_G.handlerbind(self, self.GetInfoCall, callback))
end

---@param msg s2c_activity_recruiting_info
function RecordTotalZhaomuModel:GetInfoCall(msg, callback)
    local maxTaskCompleteIndex = 0
    --任务状态 1 进度不够 2 可领取 0 已领取u
    if msg.ack == 1 then
        self.ZhaomuInfo.target = msg.info.total_num
        self.isShow = 1
        self.OpenTime = msg.info.time or 0
        if msg.info.finish_task then
            for _, v in pairs(msg.info.finish_task) do
                maxTaskCompleteIndex = maxTaskCompleteIndex + 1
                self.ZhaomuInfo[v] = {}
                self.ZhaomuInfo[v].id = v
                self.ZhaomuInfo[v].state = 0
            end
        end
        if maxTaskCompleteIndex == #activity_recruiting_cfg then
            self.Complete = true
        else
            for i = 1, #activity_recruiting_cfg do
                if self.ZhaomuInfo[i] == nil then
                    self.ZhaomuInfo[i] = {}
                    self.ZhaomuInfo[i].id = activity_recruiting_cfg[i].id
                    if activity_recruiting_cfg[i].condition > msg.info.total_num then
                        self.ZhaomuInfo[i].state = 1
                    else
                        self.ZhaomuInfo[i].state = 2
                    end
                end
            end
        end
    end
    for _, v in pairs(activity_recruiting_cfg) do
        self.RecordTotalZhaomuAwardList[v.id] = {}
        self.RecordTotalZhaomuAwardList[v.id].AwardInfo = {}
        self.RecordTotalZhaomuAwardList[v.id].AwardInfo.id = v.id
        self.RecordTotalZhaomuAwardList[v.id].AwardInfo.desc = v.desc
        self.RecordTotalZhaomuAwardList[v.id].AwardInfo.condition = v.condition
        self.RecordTotalZhaomuAwardList[v.id].AwardInfo.reward = v.reward
        self.RecordTotalZhaomuAwardList[v.id].AwardInfo.link = v.link
    end
    _G.Events:GetInstance():Broadcast(_G.LeijiDengduEnum.LeijiDengduXianShi)
    if callback then
        callback(not self:IsShow())
    end
end

function RecordTotalZhaomuModel:Dispose()
end

---检测奖励是否可以领取
function RecordTotalZhaomuModel:CheckRewardCanReward()
    if self:CheckIsOver() then
        return false
    end
    for _, v in pairs(activity_recruiting_cfg) do
        if self:CheckAwardGet(v.id) then
            return true
        end
    end
    return false
end
---检测奖励是否领取
---@param id number RecordTotalZhaomuModel.AwardID
function RecordTotalZhaomuModel:CheckIsGet(id)
    if not _G.table.isEmptyOrNil(self.ZhaomuInfo) then
        if self.ZhaomuInfo[id].state == 0 then
            return true
        end
    end
    return false
end
---检测奖励是否可领取
---@param id number RecordTotalZhaomuModel.AwardID
function RecordTotalZhaomuModel:CheckAwardGet(id)
    if not _G.table.isEmptyOrNil(self.ZhaomuInfo) then
        if self.ZhaomuInfo[id].state == 2 then
            return true
        end
    end
    return false
end
--任务完成是否继续显示页面
function RecordTotalZhaomuModel:IsShow()
    if self.isShow ~= 1 then
        return false
    end
    if not self:CheckIsOver() then
        if self.Complete then
            if #_G.ConfigManager.discrete_cfg[TimeLimit] > 0 and _G.ConfigManager.discrete_cfg[TimeLimit][1][1] > 0 then
                return true
            else
                return false
            end
        else
            return true
        end
    else
        return false
    end
end
---领取奖励
---@param taskIds table RecordTotalZhaomuModel.AwardID
function RecordTotalZhaomuModel:GetReward(taskIds, callback)
    RecordTotalZhaomuNet:GetInstance():GetAward(
        taskIds,
        function(data)
            if data.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            require "CommonTipManager".OpenCommonAwardView(data)
            self:RefreshRedPoint()
            if callback then
                callback()
            end
        end
    )
end
---设置红点刷新
function RecordTotalZhaomuModel:SetFreshRedPoint(RefreshRedPointCall)
    self.RefreshRedPointCall = RefreshRedPointCall
end
function RecordTotalZhaomuModel:RefreshRedPoint()
    if self.RefreshRedPointCall ~= nil then
        self.RefreshRedPointCall()
    end
end
---检测活动是否结束
function RecordTotalZhaomuModel:CheckIsOver()
    if #_G.ConfigManager.discrete_cfg[TimeLimit] > 0 then
        if _G.ConfigManager.discrete_cfg[TimeLimit][1][1] > 0 then
            local nowtime = _G.TimeUtil.GetServerUnixTime()
            local endTime = self.OpenTime + (_G.ConfigManager.discrete_cfg[TimeLimit][1][1]) * 24 * 3600
            return endTime - nowtime < 0
        else
            return false
        end
    else
        return false
    end
end

---获取活动天数剩余是否大于1天，大于一天返回天 否则 时
---@return number  Hour 剩余小时数
---@return boolean 是否打开计时器
---@return string 展示字符串
function RecordTotalZhaomuModel:GetActiveTime()
    local nowtime = _G.TimeUtil.GetServerUnixTime()
    local endTime = self.OpenTime + (_G.ConfigManager.discrete_cfg[TimeLimit][1][1]) * 24 * 3600
    return _G.TimeUtil.LeiJiZhaomuForStr(endTime - nowtime)
end
function RecordTotalZhaomuModel:JumpFunction()
    require "DrawModel":GetInstance():OpenViewEndTOBack(
        function()
            _G.GlobalInterface.JumpActivityByCfg(1010801)
        end
    )
end
---获取奖励数据
function RecordTotalZhaomuModel:GetAwardData(id)
    local award = {}
    local cfg = activity_recruiting_cfg[id]
    if cfg then
        for i = 1, #cfg.reward do
            local data = _G.StorageManager:GetInstance():GetItemDataClassByCfg(cfg.reward[i])
            award[i] = data
        end
    end
    return award
end

return RecordTotalZhaomuModel
