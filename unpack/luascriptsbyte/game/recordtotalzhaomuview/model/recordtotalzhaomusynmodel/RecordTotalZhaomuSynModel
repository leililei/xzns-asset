local base = require "ActivitySynTypeBase"
---@class RecordTotalZhaomuSynModel : ActivitySynTypeBase	中文描述
local RecordTotalZhaomuSynModel = _G.BaseClass("RecordTotalZhaomuSynModel", base)
-- _G.RecordTotalZhaomuSynModel = RecordTotalZhaomuSynModel

-- local CS = _G.CS
-- local typeof = _G.typeof

---创建对象时,入口构造函数
function RecordTotalZhaomuSynModel:__init()
    self.RecordTotalZhaomuModel = require "RecordTotalZhaomuModel":GetInstance()
    self.RecordTotalZhaomuModel:SetFreshRedPoint(_G.handler(self, self.RefreshRedPoint))
end

--- 网络请求初始化
function RecordTotalZhaomuSynModel:GetDataFormServer()
    self.RecordTotalZhaomuModel:GetInfo(_G.handler(self, self.ParseData))
end
---数据解析完成
function RecordTotalZhaomuSynModel:ParseData(isClose)
    if isClose then
        self.curActivityClass:ChangeState(require "ActivitySynManager".State.Close)
    end
    base.ParseData(self)
end
function RecordTotalZhaomuSynModel:InitFunction()
    self.RecordTotalZhaomuModel:InitFunction()
end
---进入活动主体
function RecordTotalZhaomuSynModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RecordTotalZhaomuView.Name)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end
function RecordTotalZhaomuSynModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.RecordTotalZhaomuView.Name
end
---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function RecordTotalZhaomuSynModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end
function RecordTotalZhaomuSynModel:CheckRedPoint()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(56) then
        return 0
    end
    return self.RecordTotalZhaomuModel:CheckRewardCanReward() and 1 or 0
end
---刷新奖励红点
function RecordTotalZhaomuSynModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end
---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function RecordTotalZhaomuSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end
--endregion

--endregion
---销毁对象时,析构函数
function RecordTotalZhaomuSynModel:Dispose()
end

return RecordTotalZhaomuSynModel
