function RecordTotalZhaomuView:CareatItem(Sid, isGou, number, Parent, itemTable, state)
    if _G.IsNil(Parent) or Parent:GetctiveInHierarchy() == 0 then
        return
    end
    local data = {}
    data.sid = Sid
    _G.StorageManager:GetInstance():GetItemBaseView(
        Sid,
        number,
        Parent,
        function(item)
            --item.gameObject:SetLocalScaleXYZ(0.66)
            local insId = Parent:GetInstanceIDE()
            if self.TaskRewardInfo[insId] and self.TaskRewardInfo[insId][item.sid] then
                _G.GameUtil.SetActiveByCondition(item.gameObject, true)
                item:SetGou(isGou)
                if item.ShowNumText ~= nil then
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
                local effCfg, key = _G.StorageManager:GetInstance():GetCommonLightEffect(Sid)
                if self.EffTranDic[insId] == nil then
                    self.EffTranDic[insId] = {}
                else
                    for k, v in pairs(self.EffTranDic[insId]) do
                        _G.DestroyObject(v)
                    end
                    self.EffTranDic[insId] = {}
                end
                self:TeXiaoShengCheng(item.gameObject, insId, effCfg, key, state)
                table.insert(itemTable, item)
                if item.SetGradeNew then
                    item:SetGradeNew(false)
                end
            else
                item.Despawn(item)
            end
        end,
        function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data.sid)
        end
    )
    --end
end
function RecordTotalZhaomuView:TeXiaoShengCheng(obj, insId, effCfg, key, state)
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
        obj,
        function(trans)
            table.insert(self.EffTranDic[insId], trans)
            if state ~= 2 then
                trans:SetActiveE(0)
            else
                trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
            end
        end
    )
end
---按钮点击事件在这里派发
function RecordTotalZhaomuView:OnClickBtn(go, isOn, id)
    local name = go:GetName()
    if name == "@_aorbtn_get" then
        if not self.Manager:CheckIsOver() then
            if self.ZhaomuInfo[id].state == 2 then
                self.Manager:GetReward(
                    {self.ZhaomuInfo[id].id},
                    function()
                        self.ZhaomuInfo[id].state = 0
                        self.Manager.ZhaomuInfo[id].state = 0
                        if not self.Manager:CheckIsOver() then
                            self:RefreshPanel()
                        else
                            _G.Events:GetInstance():RemoveListener(
                                _G.LeijiDengduEnum.LeijiDengduXianShi,
                                self.Init,
                                self
                            )
                        end
                    end
                )
            elseif self.ZhaomuInfo[id].state == 1 then
                _G.JumpManager:GetInstance():Jump(self.Manager.RecordTotalZhaomuAwardList[id].AwardInfo.link)
            end
        end
    elseif name == "@_aorbtn_CloseView" then
        self:Close()
    end
end
function RecordTotalZhaomuView:CloseView()
    self:Close()
end
return RecordTotalZhaomuView
