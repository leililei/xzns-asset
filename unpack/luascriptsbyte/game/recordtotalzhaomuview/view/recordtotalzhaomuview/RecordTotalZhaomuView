function RecordTotalZhaomuView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.RewardItemList = {}
    self.EffTranDic = {}
    self.TaskRewardInfo = {}
    self.langIdDic = {
        lingqu = 90000010016,
        ---任务item  按钮 前往
        qianwang = 90022600038,
        deadLine = 104504
    }
    self.FirstAwardItem = true
    self.UIinfoCfg = {
        hydColor = {
            --前往
            {Color(238 / 255, 195 / 255, 152 / 255), "ui_ty_kuang_01"},
            --领取
            {Color(140 / 255, 45 / 255, 20 / 255), "ui_ty_kuang_00"}
        }
    }
    self.Manager = require("RecordTotalZhaomuModel"):GetInstance()
end

---界面的入口函数
function RecordTotalZhaomuView:OnCreate()
    self.Manager:GetInfo()
    _G.Events:GetInstance():AddListener(_G.LeijiDengduEnum.LeijiDengduXianShi, self.Init, self)
    if not self.playerHead then
        self.playerHead = self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))
    end
end
---初始化界面显示
function RecordTotalZhaomuView:Init()
    self:InitTime()
    self.ZhaomuInfo = self.Manager.ZhaomuInfo
    table.sort(
        self.ZhaomuInfo,
        function(a, b)
            if a.state ~= b.state then
                return a.state > b.state
            end
            return a.id < b.id
        end
    )
    if self.IsFirst == nil or self.IsFirst == true then
        self.go_table.looplist2_ShowItem:InitListView(0, _G.handler(self, self.RefreshList))
        self.IsFirst = false
    end
    if #self.ZhaomuInfo == self.count then
        self.go_table.looplist2_ShowItem:RefreshAllShownItem()
    else
        self.go_table.looplist2_ShowItem:SetListItemCount(#self.ZhaomuInfo)
    end
    self.count = #self.ZhaomuInfo
end

function RecordTotalZhaomuView:RefreshList(obj, index)
    if index < 0 then
        return
    end
    local item = obj:NewListViewItem("$_obj_ListItem")
    local x = index + 1
    local goTable = _G.GetAutoGoTable(item, _G.handlerbind(self, self.OnClickBtn, x))
    item:SetName(x)
    local isGet = self.Manager:CheckIsGet(x)
    _G.GameUtil.SetActiveByCondition(goTable.aorbtn_get, not isGet)
    _G.GameUtil.SetActiveByCondition(goTable.aortext_get, not isGet)
    _G.GameUtil.SetActiveByCondition(goTable.aorimage_complete, isGet)
    if self.ZhaomuInfo[x].state > 0 then
        local str = self.ZhaomuInfo[x].state == 1 and self.langIdDic.qianwang or self.langIdDic.lingqu
        goTable.aortext_get.text = _G.LangUtil.GetLangPackValue(str)
        goTable.aortext_get.color = self.UIinfoCfg.hydColor[self.ZhaomuInfo[x].state][1]
        goTable.aorimage_get.SpriteName = self.UIinfoCfg.hydColor[self.ZhaomuInfo[x].state][2]
    end
    _G.GameUtil.SetActiveByCondition(goTable.obj_getEff, self.ZhaomuInfo[x].state == 2)
    local str = " ( " .. self.ZhaomuInfo.target .. "/" ..
            self.Manager.RecordTotalZhaomuAwardList[self.ZhaomuInfo[x].id].AwardInfo.condition .. " )"
    goTable.aortext_info.text =
        _G.LangUtil.GetLangPackValue(self.Manager.RecordTotalZhaomuAwardList[self.ZhaomuInfo[x].id].AwardInfo.desc) .. str
    if self.ZhaomuInfo[x].state == 1 then
        --goTable.aortext_jd.text = "<color=red>" .. str .. "</color>".."/" .. self.Manager.RecordTotalZhaomuAwardList[self.ZhaomuInfo[x].id].AwardInfo.condition
        goTable.obj_free:SetActiveE(0)
    else
        --goTable.aortext_jd.text = "<color=#400E0E>" .. str .. "</color>".."/" .. self.Manager.RecordTotalZhaomuAwardList[self.ZhaomuInfo[x].id].AwardInfo.condition
        goTable.obj_free:SetActiveE(1)
    end

    --[[goTable.aorimage_jd.fillAmount =
        self.ZhaomuInfo.target / self.Manager.RecordTotalZhaomuAwardList[self.ZhaomuInfo[x].id].AwardInfo.condition]]
    -- if self.RewardItemList[x] and #self.RewardItemList[x] > 0 then
    --     for i = 1, #self.RewardItemList[x] do
    --         _G.DestroyObject(self.RewardItemList[x][i].gameObject)
    --     end
    -- end
    local reward = self.Manager:GetAwardData(self.ZhaomuInfo[x].id)
    local insid = goTable.obj_items:GetInstanceIDE()
    local taskRewardItems = self.RewardItemList[insid]
    if taskRewardItems == nil then
        self.RewardItemList[insid] = {}
    else
        for key, tItem in pairs(taskRewardItems) do
            if not _G.IsNil(tItem) then
                tItem.Despawn(tItem)
                taskRewardItems[key] = nil
            end
        end
    end
    self.TaskRewardInfo[insid] = {}
    for i = 1, #reward do
        self.TaskRewardInfo[insid][reward[i].sid] = reward[i].count
        self:CareatItem(
            reward[i].sid,
            isGet,
            reward[i].count,
            goTable.obj_items,
            self.RewardItemList[insid],
            self.ZhaomuInfo[x].state
        )
    end
    return item
end
---初始化时间
function RecordTotalZhaomuView:InitTime()
    local time = _G.TimeUtil.GetServerUnixTime()
    self.curDate = _G.TimeUtil.GetDateTime(time)
    self.isOver = self.Manager:CheckIsOver()
    if not self.isOver then
        if _G.ConfigManager.discrete_cfg[self.langIdDic.deadLine][1][1] == 0 then
            self.go_table.aorimage_activeTime:SetActiveE(0)
        else
            self.go_table.aorimage_activeTime:SetActiveE(1)
            local Hour, openTimer, textStr = self.Manager:GetActiveTime()
            self.go_table.aortext_activeTime.text = textStr
            if openTimer then
                self.timer =
                    _G.TimerManager:GetInstance():GetTimer(
                    self:GetClockTimer(Hour),
                    self.RefreshPanel,
                    self,
                    true,
                    false,
                    true
                )
                self.timer:Start()
            end
        end
    else
        self.go_table.aortext_activeTime.text =
            _G.string.format(_G.LangUtil.GetLangPackValue(90023800013), "   " .. "0小时")
    end
end

function RecordTotalZhaomuView:GetClockTimer(hour)
    if hour > 0 then
        return 3600
    else
        return 60
    end
end

