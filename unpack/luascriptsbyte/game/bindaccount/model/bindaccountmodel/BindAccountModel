local base = _G.GameDataModelBase
---@class BindAccountModel : GameDataModelBase	中文描述
---@field isOpenBindFunc boolean 是否开启绑定功能
---@return BindAccountModel BindAccountModel
local BindAccountModel = _G.BaseClass("BindAccountModel", base)

---绑定状态
local BindStatus = {
    --默认状态
    DEFAULT = 0,
    --标记绑定
    MARK = 1,
    --领取奖励
    AWARD = 2
}

---创建对象时,入口构造函数
function BindAccountModel:__init()
    ---奖励的离散表id
    self.awardId = 132001

    if not _G.AppSetting.IsArraigned then
        _G.Events:GetInstance():AddListener(_G.eRechargeEvent.TotalCash, self.RefreshFunc, self)
        _G.Events:GetInstance():AddListener(_G.ePlayerStatus.PlayerUpLevel, self.PlayerLvChanged, self)
        _G.Events:GetInstance():AddListener(_G.eYKNetEvent.ReconnectSuccess, self.OnReconnectSuccess, self)
    end
end

function BindAccountModel:OnReconnectSuccess()
    if self.bindAccount and self:GetAwardInLogin() then
        self:GetAward()
    end
end

function BindAccountModel:GetDataFormServer()
    if self.bindAccount == nil and not _G.table.isEmptyOrNil(self:GetChannelList()) then
        self:QueryBindStatus()
    end
    self:RefreshRedPoint()
    base.ParseData(self)
end

function BindAccountModel:PlayerLvChanged(oldlv, nowlv)
    if (not oldlv or oldlv < 7) and nowlv >= 7 and not self.isOpenBindFunc and self:CheckOpen() then
        self:AddMainViewQuene()
    end
end

function BindAccountModel:AddMainViewQuene()
    _G.FunctionManager:GetInstance():OpenFunById(_G.MainFunctionItems.BindAccount)

    if not _G.SDKManager:GetInstance():CheckRusChannel() then
        local MainOpenViewFunItem = {}
        MainOpenViewFunItem.OpenViewFun = function()
            self:OpenView()
        end
        _G.MainManager:GetInstance():AddMainFunQueue(MainOpenViewFunItem, _G.MainViewShowOrder.BindAccountView)
    end
end

function BindAccountModel:DoAddMainViewQuene()
    if not self.bindAccount then
        local MainOpenViewFunItem = {}
        MainOpenViewFunItem.OpenViewFun = function()
            self:OpenView()
        end
        _G.MainManager:GetInstance():AddMainFunQueue(MainOpenViewFunItem, _G.MainViewShowOrder.BindAccountView)
    end
end

---获取渠道列表
---@return table
function BindAccountModel:GetChannelList()
    local data = _G.GameUtil.GetFunctionData(_G.FunctionBlock.account_binding)
    return data
end

---检测是否可以领取奖励
function BindAccountModel:CanGetAward()
    local bindAward = _G.PlayerModel:GetInstance().bind_award or BindStatus.DEFAULT
    return bindAward == BindStatus.MARK
end

---刷新功能
function BindAccountModel:RefreshFunc(data)
    if not self.isOpenBindFunc and self:CheckOpen() then
        if data and data.is_all_first and data.is_first_cash and data.is_all_first ~= 0 and data.is_first_cash ~= 0 then
            self:AddMainViewQuene()
        end
        self:RefreshRedPoint()
    end
end

function BindAccountModel:CheckOpenCond()
    if _G.AppSetting.DEBUG and _G.SDKManager:GetInstance():CheckRusChannel() then
        _G.Log(_G.AppSetting.IsArraigned, "是否开提审")
        _G.Log(self:GetChannelList(), "渠道信息")
        _G.Log(_G.SDKManager:GetInstance():CheckRusChannel(), "是否为俄语")
        _G.Log(_G.SDKManager:GetInstance().mLoginType, "登录类型")
        _G.Log(self.bindAccount, "是否绑定")
        _G.Log(_G.PlayerModel:GetInstance().bind_award, "绑定奖励状态")
    end
    if _G.AppSetting.IsArraigned then
        return false
    end
    if self.isOpenBindFunc then
        return true
    end
    if _G.table.isEmptyOrNil(self:GetChannelList()) then
        return false
    end

    if _G.SDKManager:GetInstance():CheckRusChannel() then
        if _G.SDKManager:GetInstance().mLoginType ~= "mac" then
            return false
        end
        if self.bindAccount then
            return false
        end
    end

    local bindAward = _G.PlayerModel:GetInstance().bind_award or BindStatus.DEFAULT
    if bindAward == BindStatus.AWARD then
        return false
    end

    if self.bindAccount and bindAward == BindStatus.DEFAULT then
        ---非游客账号不显示入口
        return false
    end

    --ZHJH5ZHJH-16819 【主任务】魔兽海外俄语1月3周主任务ZHJH-18497
    --【客户端】俄语-账号绑定功能显示条件调整为创角后即显示
    --俄语版本不需要多余的条件判断
    if not _G.SDKManager:GetInstance():CheckRusChannel() then
        local cashNum = require("MallManager"):GetInstance():GetCashRmb()
        local level = _G.PlayerModel:GetInstance():GetLevel()
        if (not cashNum or cashNum <= 0) and level < 7 then
            return false
        end
    end

    if _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.BindAccount, 0) == 0 then
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.BindAccount, _G.TimeUtil.GetServerUnixTime())
    end

    self.isOpenBindFunc = true
    return true
end

---检查功能是否开启
function BindAccountModel:CheckOpen()
    return require("BindAccountModel"):GetInstance():CheckOpenCond()
end

---打开界面
function BindAccountModel:OpenView()
    if self.bindAccount == nil then
        self:QueryBindStatus(function()
            if self:CheckOpen() then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BindAccountAwardView.Name)
            end
        end)
    else
        if self:CheckOpen() then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BindAccountAwardView.Name)
        end
    end
end

---检查功能红点
function BindAccountModel:CheckRedpoint()
    if self:CheckOpen() then
        if _G.SDKManager:GetInstance():CheckRusChannel() then
            if not self.bindAccount then
                return 1
            end
        else
            local time = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.BindAccount, 0)
            if time == 0 then
                _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.BindAccount, _G.TimeUtil.GetServerUnixTime())
                return 1
            end
            return _G.TimeUtil.GetInterValDayByGame(time, _G.TimeUtil.GetServerUnixTime()) > 0 and 0 or 1
        end
    end

    return 0
end

function BindAccountModel:RefreshRedPoint()
    if _G.ConfigManager.redpoint_cfg.BindAccount then
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BindAccount.id)
    end
end

---查询是否绑定账号
function BindAccountModel:QueryBindStatus(callBack)
    _G.SDKManager:GetInstance():QueryAccountBindStatus(_G.handlerbind(self, self.QueryBindStatusCallBack, callBack))
end

---查询是否绑定账号回调
---@param bol boolean 是否成功
---@param data table 返回数据 is_bind_account:是否绑定Mover账号,is_bind_phone:是否绑定手机号,is_bind_email:是否绑定邮箱,is_bind_third_platform:是否绑定第三方平台
function BindAccountModel:QueryBindStatusCallBack(bol, data, callBack)
    if _G.AppSetting.DEBUG then
        _G.LogError(data, "QueryBindStatusCallBack Data: ")
    end

    if bol and data then
        if data.is_bind_account or data.is_bind_phone or data.is_bind_email or data.is_bind_third_platform then
            self.bindAccount = true

            ---重登查询状态如果是已绑定且未领奖就领取一次奖励
            self:GetAwardInLogin()

            if callBack then
                callBack()
            end
        else
            self.bindAccount = false
            if self.isOpenBindFunc then
                self.isOpenBindFunc = nil
                _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.BindAccount)
            end
            if callBack then
                callBack()
            end
        end
    end
end

---绑定账号
function BindAccountModel:Bind(type, callBack)
    _G.SDKManager:GetInstance():Bind(_G.tonumber(type), _G.handlerbind(self, self.BindCallBack, callBack))
end

---绑定账号回调
---@param bol boolean 是否成功
---@param data table 返回数据 is_bind_account:是否绑定Mover账号,is_bind_phone:是否绑定手机号,is_bind_email:是否绑定邮箱,is_bind_third_platform:是否绑定第三方平台
function BindAccountModel:BindCallBack(bol, data, callBack)
    if _G.AppSetting.DEBUG then
        _G.LogError(bol, "BindCallBack bol: ")
        _G.LogError(data, "BindCallBack Data: ")
    end

    if bol and data then
        self:QueryBindStatus(function()
            if self.bindAccount then
                _G.SDKManager:GetInstance().mLoginType = nil
                if _G.SDKManager:GetInstance():CheckRusChannel() then
                    self.isOpenBindFunc = false
                    _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.BindAccount)
                end

                local bindAward = _G.PlayerModel:GetInstance().bind_award or BindStatus.DEFAULT
                if _G.AppSetting.DEBUG then
                    _G.Log(bindAward, "奖励状态")
                end
                if bindAward == BindStatus.DEFAULT then
                    ---改变奖励状态
                    self:ChangeAwardStatus(BindStatus.MARK, function()
                        _G.PlayerModel:GetInstance().bind_award = BindStatus.MARK
                        self:GetAward()
                        if callBack then
                            callBack(true, self.bindAccount)
                        end
                        if self.bindAccount then
                            local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg
                                .BindAccountAwardView.Name)
                            if view then
                                view:Close()
                            end
                        end
                    end)
                    return
                end
            end
            if callBack then
                callBack(bol, self.bindAccount)
            end
        end)
    else
        if callBack then
            callBack(bol, false)
        end
    end
end

function BindAccountModel:GetAwardInLogin()
    if self.bindAccount and self:CheckOpenCond() and self:CheckOpen() then
        self:GetAward()
    end
end

---领取奖励
function BindAccountModel:GetAward(callBack)
    self:ChangeAwardStatus(BindStatus.AWARD, callBack)
end

---领取奖励/改变奖励状态
function BindAccountModel:ChangeAwardStatus(type, callBack)
    require("BindAccountNet"):GetInstance():GetAward({ type = type },
        _G.handlerbind(self, self.GetAwardCallBack, type, callBack))
end

---领取奖励回调
function BindAccountModel:GetAwardCallBack(msg, type, callBack)
    if msg.ack ~= 1 then
        return
    end

    ---修改奖励状态
    _G.PlayerModel:GetInstance().bind_award = type
    if type == BindStatus.AWARD then
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)

        ---领完奖后关闭功能
        self.isOpenBindFunc = false
        self:RefreshRedPoint()
        _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.BindAccount)
        self:RemoveEvents()
    end
    if callBack then
        callBack()
    end
end

function BindAccountModel:RemoveEvents()
    if not _G.AppSetting.IsArraigned then
        _G.Events:GetInstance():RemoveListener(_G.eRechargeEvent.TotalCash, self.RefreshFunc, self)
        _G.Events:GetInstance():RemoveListener(_G.eYKNetEvent.ReconnectSuccess, self.OnReconnectSuccess, self)
        _G.Events:GetInstance():RemoveListener(_G.ePlayerStatus.PlayerUpLevel, self.PlayerLvChanged, self)
    end
end

---销毁对象时,析构函数
function BindAccountModel:Dispose()
    self.bindAccount = nil
    self.isOpenBindFunc = nil
    self:RemoveEvents()
end

return BindAccountModel
