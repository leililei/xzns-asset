---@class BindAccountAwardView : UIBaseView	中文描述
---@field public go_table BindAccountAwardView_GoTable GoTable
local BindAccountAwardView = _G.BaseClass("BindAccountAwardView", _G.UIBaseView)

function BindAccountAwardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function BindAccountAwardView:OnCreate()
    self.data = _G.ConfigManager.discrete_cfg[131002]
    local count = #self.data
    self.go_table.scrollloophorizontal_item:InitItemData(count, _G.handler(self, self.RefreshItem))
    if count < 4 then
        ---item数量小于4个时需要自适应滑动列表的宽度
        self.go_table.scrollloophorizontal_item:UpdateScrollRectWeight(count * 129)
    end

    self:RefreshBtn()
end

---刷新按钮状态
function BindAccountAwardView:RefreshBtn()
    local canGetAward = require("BindAccountModel"):GetInstance():CanGetAward()
    self.go_table.aorbtn_go:SetActiveE(canGetAward and 0 or 1)
    self.go_table.aorbtn_award:SetActiveE(canGetAward and 1 or 0)
end

function BindAccountAwardView:RefreshItem(index, obj)
    local tb = _G.GetAutoGoTable(obj)
    _G.UIUtils.RemoveChildren(tb.obj_root)
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        self.data[index + 1],
        tb.obj_root,
        function(item)
            if self:IsNil() then
                _G.DestroyObject(item.gameObject)
                return
            end

            if item.ShowNumText then
                item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
            end
        end
    )
end

---界面的销毁函数
function BindAccountAwardView:OnDestroy()
end

---按钮点击事件在这里派发
function BindAccountAwardView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_closeView then
        --_G.PopWindowManager:GetInstance():ShowBtnWindowByToggle(1170001, function()
            self:Close()
        --end, nil, nil, true)
    elseif go == self.go_table.aorbtn_go then
        ---跳转到绑定界面(俄语直接调sdk)
        if not _G.SDKManager:GetInstance():CheckRusChannel() then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BindAccountChannelView.Name)
        else
            local channelList = require("BindAccountModel"):GetInstance():GetChannelList()
            local id = channelList[1]
            local cfg = _G.ConfigManager.account_binding_cfg[_G.tonumber(id)]
            require("BindAccountModel"):GetInstance():Bind(_G.tonumber(cfg.ob), _G.handler(self, self.BindCallBack))
        end
    elseif go == self.go_table.aorbtn_award then
        ---领取奖励
        require("BindAccountModel"):GetInstance():GetAward(_G.handler(self, self.Close))
    end
end

function BindAccountAwardView:BindCallBack(bol, isBindSuc)
    if bol and isBindSuc then
        require("BindAccountModel"):GetInstance():GetAward()
    end
end

return BindAccountAwardView
