---@class BindAccountChannelView : UIBaseView	中文描述
---@field public go_table BindAccountChannelView_GoTable GoTable
local BindAccountChannelView = _G.BaseClass("BindAccountChannelView", _G.UIBaseView)

function BindAccountChannelView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function BindAccountChannelView:OnCreate()
    self.channelList = require("BindAccountModel"):GetInstance():GetChannelList()
    self.go_table.scrollloopvectical_list:InitItemData(#self.channelList, _G.handler(self, self.RefreshItem))
end

function BindAccountChannelView:RefreshItem(index, obj)
    local id = self.channelList[index + 1]
    local cfg = _G.ConfigManager.account_binding_cfg[_G.tonumber(id)]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, cfg))
    tb.aorrawimage_bg:LoadImage(cfg.picture)
    tb.aorimage_icon.SpriteName = cfg.icon
    tb.aortext_name.text = _G.GetLangPackValue(cfg.desc)
end

function BindAccountChannelView:OnClickItem(go, isOn, cfg)
    require("BindAccountModel"):GetInstance():Bind(_G.tonumber(cfg.ob), _G.handler(self, self.BindCallBack))
end

function BindAccountChannelView:BindCallBack(bol, isBindSuc)
    if bol and isBindSuc then
        require("BindAccountModel"):GetInstance():GetAward()
        self:Close()
    end
end

---界面的销毁函数
function BindAccountChannelView:OnDestroy()
end

---按钮点击事件在这里派发
function BindAccountChannelView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end

return BindAccountChannelView
