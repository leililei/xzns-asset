    if id and self.info[id].state == 1 then
        local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SnowBallRedBoundMainView.Name)
        local pb = {}
        pb.score = self.score or 0
        pb.id = id
        self:FinishGame(pb, function(msg)
            local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SnowBallRedBoundMainView.Name)
            if ctrl then
                if msg.award then
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                end
                ctrl:UpdateView()
            end
        end)
    end
end

