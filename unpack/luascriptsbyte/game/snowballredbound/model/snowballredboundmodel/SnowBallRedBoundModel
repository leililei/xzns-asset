---关卡是否已解锁(按天数)
---@param sid number 关卡
---@return boolean
function SnowBallRedBoundModel:IsLock(sid)
    local stage 
    for i = 1, #self.stages do
        if self.stages[i].sid == sid then
            stage = self.stages[i]
            break
        end
    end
    if not stage then
        return false
    end
    return stage.lock_day > self.open
end

---获取关卡解锁剩余时长(秒)
---@param sid number 关卡
---@return number
function SnowBallRedBoundModel:GetUnlockTime(sid)
    local stage
    for i = 1, #self.stages do
        if self.stages[i].sid == sid then
            stage = self.stages[i]
            break
        end
    end
    if not stage or stage.lock_day <= self.open then
        return 0
    end
    --关卡开放时间
    local openDuration = _G.TimeUtil.GetServerUnixTime() - self.curActivityClass.cfg.time.start_time
    local time = (stage.lock_day - 1) * 86400 - openDuration
    return math.max(0, time)
end

