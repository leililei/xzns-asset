--开始游戏
function SnowBallRedBoundModel:StartGame(pbData, callback)
    SnowBallRedBoundNet:GetInstance():StartGame(pbData, function(msg)
        if msg.ack == 1 then
            self.info[pbData.id].state = 1
            local consume = 0
            if self:CheckPassSid(pbData.id, self.info[pbData.id].curr_sid) then
                consume = self.info[pbData.id].base_cfg.consume[1].item[5]
            end
            if consume > 0 then
                self:AddExtraAward(pbData.id, self.info[pbData.id].curr_sid)
            end
            self:AddCoin(-consume, pbData.id)
            if callback then
                callback(msg)
            end
        end
    end)
end

--游戏完成
function SnowBallRedBoundModel:FinishGame(pbData, callback)
    SnowBallRedBoundNet:GetInstance():FinishGame(pbData, function(msg)
        if msg.ack == 1 then
            local activityID = pbData.id
            self.info[activityID].state = 0
            local passScore = 0
            local nextSid
            for k, v in ipairs(self.info[activityID].fb_cfg) do
                if v.sid == self.info[activityID].curr_sid then
                    passScore = v.pass
                    nextSid = v.next_sid
                end
            end
            if pbData.score > 0 and passScore > 0 and pbData.score >= passScore then
                table.insert(self.info[activityID].history_score,
                    { k = self.info[activityID].curr_sid, v = pbData.score })
                self.info[activityID].sd_sid = self.info[activityID].curr_sid
                if nextSid and nextSid ~= 0 then
                    self.info[activityID].max_sid = nextSid
                    self.info[activityID].curr_sid = nextSid
                end
            end
            if msg.award then
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            end
            if callback then
                callback(msg)
            end
        end
    end)
end

function SnowBallRedBoundModel:AddExtraAward(activityID, sectionSid, count)
    local a
    for k, v in ipairs(self.info[activityID].fb_cfg) do
        if v.sid == sectionSid then
            a = k
        end
    end
    if not count then
        count = 1
    end
    for k, v in ipairs(self.info[activityID].fb_cfg[a].extra_award) do
        local index = #v.type
        local addBol
        for key, value in pairs(self.info[activityID].extra_award_state) do
            if index == #value.type then
                if index == 5 then
                    if v.type[4] == value.type[4] then
                        value.type[5] = value.type[5] + v.type[5] * count
                        addBol = true
                    end
                else
                    if v.type[1] == value.type[1] then
                        value.type[2] = value.type[2] + v.type[2] * count
                        addBol = true
                    end
                end
            end
        end
        if not addBol then
            local data = { type = {} }
            for i = 1, #v.type do
                table.insert(data.type, v.type[i])
            end
            if #data.type == 5 then
                data.type[5] = v.type[5] * count
            else
                data.type[2] = v.type[2] * count
            end
            table.insert(self.info[activityID].extra_award_state, data)
        end
    end
end

