function SnowBallRedBoundModel:CheckCanGetTicket(activityID)
    local nowTime = _G.TimeUtil.GetServerUnixTime()
    if self.info[activityID] and self.info[activityID].count < self.info[activityID].base_cfg.ticket.max_num then
        local nextTime = self.info[activityID].time + self.info[activityID].base_cfg.ticket.time
        if nowTime > nextTime then
            return true
        end
        return false, nextTime - nowTime
    end
    return false
end

function SnowBallRedBoundModel:FinishGameCall(activityID)
