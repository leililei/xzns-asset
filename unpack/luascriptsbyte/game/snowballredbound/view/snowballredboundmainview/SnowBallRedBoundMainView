---@class SnowBallRedBoundMainView : UIBaseView	中文描述
---@field public go_table SnowBallRedBoundMainView_GoTable GoTable
local SnowBallRedBoundMainView = _G.BaseClass("SnowBallRedBoundMainView", _G.UIBaseView)
local SnowBallRedBoundModel
---宝箱特效
local boxEffect = {
    [1] = "ef_box1",
    [2] = "ef_box2",
    [3] = "ef_box3"
}

local Util = {
    ---扫荡次数 1次
    SweepOne = 1,
    ---扫荡次数 10次
    SweepTen = 10,
    ---扫荡次数 50次
    SweepFifty = 50,
}

function SnowBallRedBoundMainView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    SnowBallRedBoundModel = require "SnowBallRedBoundModel":GetInstance()
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.ResUpdata, self)
end

function SnowBallRedBoundMainView:ResUpdata(data)
    for _, value in pairs(data) do
        local sid = value.type[1]

        if sid == SnowBallRedBoundModel:GetCoinId(self.activityID) then
            self:UpdateBtn()
        end
    end
end

---界面的入口函数
