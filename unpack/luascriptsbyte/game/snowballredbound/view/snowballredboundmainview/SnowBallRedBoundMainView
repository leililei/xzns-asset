    )
    local icon = _G.StorageManager:GetInstance():GetItemIcon(SnowBallRedBoundModel:GetCoinId(self.activityID))
    self.go_table.aorrawimage_PropLeft:LoadImage(
        icon,
        function(image)
            if self:IsNil() then
                image:DestroyObject()
                return
            end
            if image then
                image:SetActiveE(1)
            end
        end
    )
    self.go_table.aorrawimage_PropRight:LoadImage(
        icon,
        function(image)
            if self:IsNil() then
                image:DestroyObject()
                return
            end
            if image then
                image:SetActiveE(1)
            end
        end
    )
    self.go_table.aorrawimage_getTicket:LoadImage(
        icon,
        function(image)
            if self:IsNil() then
                image:DestroyObject()
                return
            end
            if image then
                image:SetActiveE(1)
            end
        end
    )
    local cardCfg = _G.ConfigManager.card_cfg[112060000]
    _G.PoolsManager:GetInstance():Spawn(
            "WX_Role/Animation_UI/Mengjingshuyao_UI/prf_Mengjingshuyao_UI_ui",
            _G.ePoolType.Temporary,
            self.go_table.obj_dragon,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
            end
    )
    _G.PoolsManager:GetInstance():Spawn(
            --cardCfg.ModelPathHi,
            "WX_Role/Animation_UI/Guangmingzhiyi_UI/prf_Guangmingzhiyi_UI_ui",
            _G.ePoolType.Temporary,
            self.go_table.obj_spine,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                --self:DoGameStart()
            end
    )
    local battleActivitys =
        require "ActivitySynManager":GetInstance():GetChildAcitivity(10027, self.info.activity:GetJumpType())
    if battleActivitys then 
        self.go_table.obj_bagRedpoint:UpdateRedPointItemIDAndParam(battleActivitys:GetActivityTypeCls():GetRedpointIDByIndex(1)) 
    end
