end

function SnowBallRedBoundMainView:UpdateView()
    self:UpdateChapters()
    self:UpdateBtn()
    self:UpdateAfkBox()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.lastTime = self.activity.cfg.time.start_time + self.activity.cfg.time.run_time - _G.TimeUtil.GetServerUnixTime()
    self:FreshTicketBtn()
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.TimerFunc, self, false)
    self:TimerFunc(0)
    self.timer:Start()
    self.activity.typeClass:RefreshRedPoint()
end

function SnowBallRedBoundMainView:FreshTicketBtn()
    self.getTicketBol, self.nextTime = SnowBallRedBoundModel:CheckCanGetTicket(self.activityID)
    self.go_table.obj_ticketRedpoint:SetActiveE(self.getTicketBol and 1 or 0)
    self.go_table.aortext_getTecket:SetActiveE((not self.getTicketBol and self.nextTime) and 1 or 0)
end

function SnowBallRedBoundMainView:TimerFunc(elapsed)
    self.lastTime = self.lastTime - elapsed
    if self.nextTime then 
        self.nextTime = self.nextTime - elapsed
        if self.nextTime < 0 then 
            self.go_table.aortext_getTecket:SetActiveE(0)
        else 
            self.go_table.aortext_getTecket:SetActiveE(1)
            self.go_table.aortext_getTecket.text = _G.TimeUtil.TimeToString(self.nextTime, 1)
        end
    end
    if self.lastTime < 0 then
        self:CloseView()
    else
        local time = _G.TimeUtil.TranslateSecondForDHMOrHMS(self.lastTime)
        self.go_table.aortext_time.text = GetLangPackValue(90028500004, time)
    end
end

function SnowBallRedBoundMainView:GetSweepTimes()
    local num = SnowBallRedBoundModel:GetCoin(self.activityID)
    if num <= 0 then --or not SnowBallRedBoundModel:GetInstance():CheckPassAllSection(self.activityID) then
        return 1
    end

    if num < Util.SweepTen then
        return num
    elseif num < Util.SweepFifty then
       return Util.SweepTen
    else
        return Util.SweepFifty
    end

    return num
end

function SnowBallRedBoundMainView:SweepMultiTxt(num, consume)
    if num <= 0 then --or not SnowBallRedBoundModel:GetInstance():CheckPassAllSection(self.activityID) then
        self.go_table.aortext_free.text = _G.GetLangPackValue(90000013309, 1)
        return
    end

    if num < Util.SweepTen * consume then
        self.go_table.aortext_free.text = _G.GetLangPackValue(90000013309, num)
    elseif num < Util.SweepFifty * consume then
        self.go_table.aortext_free.text = _G.GetLangPackValue(90000013310)
    else
        self.go_table.aortext_free.text = _G.GetLangPackValue(90000013311)
    end
end

function SnowBallRedBoundMainView:UpdateBtn()
    local num = SnowBallRedBoundModel:GetCoin(self.activityID)
    local consume = self.info.base_cfg.consume[1].item[5]
    local times = self:GetSweepTimes()
    if num >= consume then 
        self.go_table.aortext_PropRightNum.text = string.format("<color=green>%s</color>/%s", num, consume)
        self.go_table.aortext_PropLeftNum.text = string.format("<color=green>%s</color>/%s", num, consume * times)
    else 
        self.go_table.aortext_PropRightNum.text = string.format("<color=red>%s</color>/%s", num, consume)
        self.go_table.aortext_PropLeftNum.text = string.format("<color=red>%s</color>/%s", num, consume * times)
    end
    self:SweepMultiTxt(num, consume)
end

function SnowBallRedBoundMainView:FindJumpIndex()
    for k, v in pairs(self.info.fb_cfg) do
        local CanTake = SnowBallRedBoundModel:CheckSectionAwardCanGet(self.activityID, v.sid)
        local isGet = SnowBallRedBoundModel:CheckSectionAwardGot(self.activityID, v.sid) 
        if CanTake and not isGet then 
            return k - 1
        end
        if v.sid == self.info.curr_sid then 
            return k - 1
        end
    end
    return 0
end

---更新关卡显示
---@return void
function SnowBallRedBoundMainView:UpdateChapters()
    self.go_table.obj_chapter:SetActiveE(1)
    --更新当前进度标题
    self.go_table.aortext_stageName.text = string.format(_G.GetLangPackValue(90000013302), SnowBallRedBoundModel:GetSectionBySid(self.activityID, self.info.curr_sid))
    local index = self:FindJumpIndex()
    if not self.sectionListInit then
        self.go_table.scrollloophorizontal_section:InitItemData(
            #self.info.fb_cfg,
            _G.handler(self, self.RefreshSecItem),
            index
        )
        self.sectionListInit = true
    else
        self.go_table.scrollloophorizontal_section:UpdateAllItem()
        self.go_table.scrollloophorizontal_section:ScrollToIndex(index)
    end
end

function SnowBallRedBoundMainView:RefreshSecItem(index, obj)
    index = index + 1
    ---@type _obj_afkPanel._obj_sectionItem_GoTable
    local tb = _G.GetAutoGoTable(obj)
    local data = self.info.fb_cfg[index]
    if not tb.reward then
        tb.reward = {}
    end
    tb.gameObject:SetName(index)
    tb.data = data
    data.CanTake = SnowBallRedBoundModel:CheckSectionAwardCanGet(self.activityID, data.sid)
    data.isGet = SnowBallRedBoundModel:CheckSectionAwardGot(self.activityID, data.sid)
    tb.aortext_name.text = _G.string.format(_G.GetLangPackValue(90000013302), index)
    tb.aorimage_bg1:SetActiveE((not data.CanTake or data.isGet) and 1 or 0)
    tb.aorimage_bg2:SetActiveE((data.CanTake and not data.isGet) and 1 or 0)
    tb.obj_eff:SetActiveE(data.CanTake and not data.isGet and 1 or 0)
    tb.aorimage_fill:SetActiveE((data.CanTake or data.isGet) and 1 or 0)
    --是否特殊关卡
    local isSpecific = false 
    local tempSid = data.qualify_award[1].type[1] == 0 and data.qualify_award[1].type[4] or data.qualify_award[1].type[1]
    local itemType = _G.StorageManager:GetInstance():CheckSidType(tempSid) == _G.StorageType.Card and 1 or 2
    tb.itemType = itemType
    tb.obj_reward:SetLocalScaleXYZ(isSpecific and 1 or 0.7)
    for k, v in pairs(tb.reward) do
        if k ~= itemType then
            v.gameObject:SetActiveE(0)
        else
            v.gameObject:SetActiveE(1)
        end
    end
    --加载奖励图标
    if not tb.reward[itemType] then
        if itemType == 1 then
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.HeadItem_Select,
                tb.obj_rewardRoot,
                function(item)
                    if tb.reward[itemType] then
                        _G.DestroyObject(item.gameObject)
                        return
                    end
                    if tb.itemType ~= itemType then
                        item.gameObject:SetActiveE(0)
                    elseif tb.data ~= data then
                        data = tb.data
                    end
                    local awardT 
                    if data.qualify_award[1].type[1] == 0 then 
                        awardT = {data.qualify_award[1].type[4], data.qualify_award[1].type[5]}
                    else 
                        awardT = data.qualify_award[1].type
                    end
                    item.gameObject:SetLocalPositionToZero()
                    tb.reward[itemType] = item
                    tb.reward[itemType]:Show(
                        awardT[1],
                        _G.handlerbind(self, self.OnClickSectionBtn, tb),
                        nil,
                        nil,
                        nil,
                        nil,
                        nil,
                        true
                    )
                    tb.reward[itemType].gameObject:SetLocalScaleXYZ(0.6)
                    -- tb.reward:SetGradeNew(data.CanTake and not data.isGet)
                    tb.reward[itemType]:SetSelectGou(data.isGet)
                end
            )
        elseif itemType == 2 then
            _G.ItemFactory:GetInstance():GetItemCard(
                _G.ItemFactory.itemType.ItemBaseWithCount,
                tb.obj_rewardRoot,
                function(item)
                    if tb.reward[itemType] then
                        _G.DestroyObject(item.gameObject)
                        return
                    end
                    if tb.itemType ~= itemType then
                        item.gameObject:SetActiveE(0)
                    elseif tb.data ~= data then
                        data = tb.data
                    end
                    local awardT 
                    if data.qualify_award[1].type[1] == 0 then 
                        awardT = {data.qualify_award[1].type[4], data.qualify_award[1].type[5]}
                    else 
                        awardT = data.qualify_award[1].type
                    end
                    tb.reward[itemType] = item
                    tb.reward[itemType]:Show(
                        awardT[1],
                        _G.handlerbind(self, self.OnClickSectionBtn, tb),
                        awardT[2]
                    )
                    tb.reward[itemType].gameObject:SetLocalScaleXYZ(0.6)
                    -- tb.reward:SetGradeNew(data.CanTake and not data.isGet)
                    tb.reward[itemType]:SetGou(data.isGet)

                    tb.rewardEff = 1
                    -- tb.reward[isCard]:ShowFrameEffect(data.qualify_award[1], data.CanTake)
                    if data.CanTake then
                        self:SetItemEff(tb)
                    end
                end
            )
        end
    else
        -- tb.reward:SetGradeNew(data.CanTake and not data.isGet)
        local awardT 
        if data.qualify_award[1].type[1] == 0 then 
            awardT = {data.qualify_award[1].type[4], data.qualify_award[1].type[5]}
        else 
            awardT = data.qualify_award[1].type
        end
        if itemType == 1 then
            tb.reward[itemType]:Show(
                awardT[1],
                _G.handlerbind(self, self.OnClickSectionBtn, tb),
                nil,
                nil,
                nil,
                nil,
                nil,
                true
            )
            tb.reward[itemType]:SetSelectGou(data.isGet)
        elseif itemType == 2 then
            tb.reward[itemType]:Show(
                awardT[1],
                _G.handlerbind(self, self.OnClickSectionBtn, tb),
                awardT[2]
            )
            tb.reward[itemType]:SetGou(data.isGet)
            if data.CanTake then
                self:SetItemEff(tb)
            end
        end
    end
end

function SnowBallRedBoundMainView:OnClickSectionBtn(item)
    if not item.data then
        return
    end
    if not item.data.CanTake or item.data.isGet then
        --展示奖励tip
        require("CommonTipManager"):GetInstance():OpenTip(item.gameObject, item.data.qualify_award[1].type[1] == 0 and item.data.qualify_award[1].type[4] or item.data.qualify_award[1].type[1])
    else
        local pb = {}
        pb.sid = SnowBallRedBoundModel:GetCanGetSectionAwardList(self.activityID)
        pb.id = self.activityID
        SnowBallRedBoundModel:GetQualifyAward(
            pb,
            function(msg)
                --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                self:UpdateChapters()
                self.activity.typeClass:RefreshRedPoint()
                --require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedPointAfk.id)
            end
        )
    end
end

---设置奖励item特效
function SnowBallRedBoundMainView:SetItemEff(go)
    local eff = _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang
    _G.UIUtils.RemoveChildren(go.obj_eff)
    _G.UIUtils.LoadEffectByCfg(
        eff,
        go.obj_eff,
        function(trans)
            if _G.IsNil(go) then
                _G.DestroyObject(trans)
                return
            end
            go.frameEffect = trans
            go.eff = eff
        end
    )
end

function SnowBallRedBoundMainView:CloseView()
    self:Close()
end

---按钮点击事件在这里派发
function SnowBallRedBoundMainView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:CloseView()
    elseif go == self.go_table.aorbtn_sweep then
        if SnowBallRedBoundModel:CheckTicketEnough(self.activityID) then 
            if not SnowBallRedBoundModel:CheckPassOneSection(self.activityID) then 
                _G.PopWindowManager:GetInstance():ShowAllTips(1070029, _G.GetLangPackValue(90000013707))
                return 
            end
            SnowBallRedBoundModel:Sweep({id = self.activityID, count = self:GetSweepTimes(), sid = self.info.sd_sid})
        else 
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, SnowBallRedBoundModel:GetCoinId(self.activityID)) 
        end
    elseif go == self.go_table.aorbtn_startGame then
        if SnowBallRedBoundModel:IsLock(self.info.curr_sid) then
            local time = _G.TimeUtil.TranslateSecond(SnowBallRedBoundModel:GetUnlockTime(self.info.curr_sid))
            local timeStr
            if time.day > 0 then
                timeStr = _G.GetLangPackValue(90022100001, time.day, time.hour) --%s天%s小时
            else
                timeStr = _G.GetLangPackValue(90022100002, time.hour, time.min) --%s小时%s分钟
            end
            _G.PopWindowManager:GetInstance():ShowAllTips(1001, _G.GetLangPackValue(90034511012, timeStr))
            return
        end
        if SnowBallRedBoundModel:CheckTicketEnough(self.activityID) then 
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SnowBallRedBoundView.Name, self.activityID)
        else 
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, SnowBallRedBoundModel:GetCoinId(self.activityID)) 
        end
    elseif go == self.go_table.aorbtn_box then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SnowBallRedBoundBattlePassGiftView.Name, self.activity)
    elseif go == self.go_table.aorbtn_enter then
        if SnowBallRedBoundModel:CheckCanGetTicket(self.activityID) then 
            SnowBallRedBoundModel:GetTicket({id = self.activityID}, function(msg)
                if msg.ack == 1 then 
                    self:FreshTicketBtn()
                    self:UpdateBtn()
                    self.activity.typeClass:RefreshRedPoint()
                end
            end)
        else 
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, SnowBallRedBoundModel:GetCoinId(self.activityID)) 
        end
    elseif go == self.go_table.aorbtn_battleGift then
        self:OpenBattlePass()
    elseif go == self.go_table.aorbtn_tips then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 216)
    end
end

function SnowBallRedBoundMainView:OpenBattlePass()
    local battleActivitys =
        require "ActivitySynManager":GetInstance():GetChildAcitivity(10027, self.info.activity:GetJumpType())
    if battleActivitys then 
        battleActivitys:GetActivityTypeCls():OnEnterActivity()
    end
end

---更新宝箱状态
---@return void
function SnowBallRedBoundMainView:UpdateAfkBox()
    local show, index = false, 1
    if #SnowBallRedBoundModel:GetBattleGift(self.activityID) > 0 then 
        index = 3
    end
    for i = 1, 3 do
        if i == index then
            self.go_table["obj_box" .. i]:SetActiveE(1)
        else
            self.go_table["obj_box" .. i]:SetActiveE(0)
        end
    end
    self:UpdateAfkBoxEffect(index)
end

---更新宝箱特效
function SnowBallRedBoundMainView:UpdateAfkBoxEffect(index)
    self.boxEffect = self.boxEffect or {}
    for i, v in pairs(self.boxEffect) do
        v:SetActiveE(0)
    end
    if not self.boxEffect[index] then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[boxEffect[index]],
            self.go_table["obj_box" .. index],
            function(tran)
                self.boxEffect[index] = tran
            end
        )
    else
        self.boxEffect[index]:SetActiveE(1)
    end
end

function SnowBallRedBoundMainView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.ResUpdata, self)
end

return SnowBallRedBoundMainView