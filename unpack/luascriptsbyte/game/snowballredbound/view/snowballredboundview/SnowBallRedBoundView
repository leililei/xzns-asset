function SnowBallRedBoundView:FixPpdateGameItem()
    local X1, Y1, Z1 = self.go_table.obj_leftup:GetPosition()
    local X2, Y2, Z2 = self.go_table.obj_rightdown:GetPosition()
    local removeList = {}
    for i = 1, #self.itemList do
        self.itemList[i].rect.transform:Translate(0, -self.itemList[i].data.speed * _G.Time.deltaTime, 0)
        local x1, y1, z1 = self.itemList[i].obj_leftup:GetPosition()
        local x2, y2, z2 = self.itemList[i].obj_rightdown:GetPosition()
        if (Y1 - y2) * (Y2 - y1) < 0 and (X1 - x2) * (X2 - x1) < 0 then
            if self.itemList[i].data.score then
                SnowBallRedBoundModel:ChanageScore(self.itemList[i].data.score)
                self.go_table.aortext_score.text = SnowBallRedBoundModel:GetScore()
                self.go_table.obj_ScoreEffect:SetActiveE(0)
                self.go_table.obj_ScoreEffect:SetActiveE(1)
            elseif self.itemList[i].data.time then
                if self.itemList[i].data.type == "green" then
                    self.Time = self.Time + self.itemList[i].data.time
                else
                    self.Time = self.Time - self.itemList[i].data.time
                    self.go_table.obj_BobmEffect:SetActiveE(0)
                    self.go_table.obj_BobmEffect:SetActiveE(1)
                    if self.Time <= 0 then
                        self:SetGameEnd()
                    end
                end
                self.go_table.aortext_time.text = _G.Mathf.RoundToInt(self.Time)
            end
            if self.itemList[i].data.type then
                self.itemList[i]["aortext_" .. self.itemList[i].data.type]:SetActiveE(0)
            end
            self.itemList[i].obj_item:SetActiveE(0)
            table.insert(removeList, i)
        elseif y1 <= -10 then
            if self.itemList[i].data.type then
                self.itemList[i]["aortext_" .. self.itemList[i].data.type]:SetActiveE(0)
            end
            self.itemList[i].obj_item:SetActiveE(0)
            table.insert(removeList, i)
        end
    end
    for k, v in pairs(removeList) do
        PoolsManager:Despawn(self.items[v - k +1], UIItem)
        table.remove(self.itemList, v - k +1)
        table.remove(self.items, v - k +1)
    end
end

