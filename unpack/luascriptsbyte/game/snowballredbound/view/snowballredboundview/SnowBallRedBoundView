function SnowBallRedBoundView:ShowTime(elapsed)
    self.Time = self.Time - elapsed
    self.go_table.aortext_time.text = _G.Mathf.RoundToInt(self.Time)
    if self.level < 2 and self.Time < time * 0.67 then
        SnowBallRedBoundModel:ChangeWeight(2)
        self.level = 2
    elseif self.level < 3 and self.Time < time * 0.33 then
        SnowBallRedBoundModel:ChangeWeight(3)
        self.level = 3
    end
    if self.Time <= 0 then
        self:SetGameEnd()
    end
end

function SnowBallRedBoundView:ShowItem(elapsed)
    self.Times = self.Times + elapsed
    local itemPos = SnowBallRedBoundModel:RandomTrack()
    local item = SnowBallRedBoundModel:RandomItem()
    self:SpawnObj(item, itemPos)
    if math.ceil(self.Times) == self.sbombTimes then
        self.Times = 0
        local bombPos, item = SnowBallRedBoundModel:RandomBomb()
        self:SpawnObj(item, bombPos)
    end
end

