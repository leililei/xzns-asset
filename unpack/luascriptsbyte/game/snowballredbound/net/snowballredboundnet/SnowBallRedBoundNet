local base = require("BaseGameNet")

---@class SnowBallRedBoundNet : BaseGameNet    通信协议
local SnowBallRedBoundNet = _G.BaseClass("SnowBallRedBoundNet", base)
---@return SnowBallRedBoundNet SnowBallRedBoundNet
function SnowBallRedBoundNet:GetInstance()
    return base.GetInstance(self)
end

---开始游戏
function SnowBallRedBoundNet:StartGame(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_mini_game_start_game
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---游戏完成
function SnowBallRedBoundNet:FinishGame(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_mini_game_finish_game
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---游戏扫荡
function SnowBallRedBoundNet:Sweep(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_mini_game_sweep
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---领取达标奖励
function SnowBallRedBoundNet:GetQualifyAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_mini_game_qualify_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---领取战令累计奖励
function SnowBallRedBoundNet:GetExtraAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_mini_game_extra_award
