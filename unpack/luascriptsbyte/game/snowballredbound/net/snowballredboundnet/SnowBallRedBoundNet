---领取门票奖励
function SnowBallRedBoundNet:GetTicket(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_mini_game_ticket
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end




---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function SnowBallRedBoundNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return SnowBallRedBoundNet