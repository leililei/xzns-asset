---@class GuideBookTaskView : UIBaseView	中文描述
---@field public go_table GuideBookTaskView_GoTable GoTable
local GuideBookTaskView = _G.BaseClass("GuideBookTaskView", _G.UIBaseView)

function GuideBookTaskView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.Close,
        ["@_aorbtn_help"] = _G.handler(self, self.Help),
        ["@_aorbtn_TipsView"] = self.HideAward,
        ["@_aorbtn_getOneKey"] = _G.handler(self, self.CountFinishTask),
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
end

---界面的入口函数
function GuideBookTaskView:OnCreate(curActivityClass)
    self.curActivityClass = curActivityClass
    self.typeClass = curActivityClass:GetActivityTypeCls()
    self.activityEndTime = curActivityClass:GetActivityDeadLineByCondition(require("ActivitySynManager").State.Close)
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.GuideBookTaskView, self.go_table)

    self.playerHead = self:AddComponent(
        self.go_table.obj_PlayerHead,
        require("PlayerComponent").New(self.go_table.obj_PlayerHead)
    )
    self.resource =
        self:AddComponent(
            self.go_table.obj_GoldInfo,
            require("ResourceCompont").New(self.go_table.obj_GoldInfo, { 11, 12 })
        )

    ---@field table 活跃度Item
    self.goalItemList = {}
    ---@field table 任务分组页签
    self.titleItemList = {}
    ---@field table 任务Item
    self.taskItemList = {}

    self.openDay = self.typeClass:OpenDay()
    self.allTaskData = self.typeClass:GetAllTaskData()
    self:InitView()
    self:InitUIResouce()
    self:InitTimer()
    self:AddListener(_G.eSixUpdate.SixClockUpdate, self.SixClockUpdate)
end

function GuideBookTaskView:SixClockUpdate()
    self.openDay = self.typeClass:OpenDay()
    self:InitView()
end

function GuideBookTaskView:StopTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

function GuideBookTaskView:InitTimer()
    self:StopTimer()
    local timerInterval = 60
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    if self.activityEndTime > serverTime then
        self.go_table.aortext_countDown.text =
            _G.GetLangPackValue(
                90000010360,
                _G.string.format("<color=#f1df89>%s</color>",
                    _G.TimeUtil.TranslateSecondForStrAcientEvil(self.activityEndTime - serverTime))
            )
        self.timer = _G.TimerManager:GetInstance():GetTimer(timerInterval, self.UpdateTime, self, false, false, true)
        self.timer:Start()
    else
        self:Close()
    end
end

function GuideBookTaskView:UpdateTime()
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    if self.activityEndTime > serverTime then
        self.go_table.aortext_countDown.text =
            _G.GetLangPackValue(
                90000010360,
                _G.string.format("<color=#f1df89>%s</color>",
                    _G.TimeUtil.TranslateSecondForStrAcientEvil(self.activityEndTime - serverTime))
            )
    else
        self:Close()
    end
end

function GuideBookTaskView:InitView()
    self.activeCfg = self.typeClass.activeCfg

    self:InitProgress()
    if not self.curTitleIndex then
        self.curTitleIndex = 1
    end
    ---当前任务页签索引
    if not self.titleListCount then
        self:SortTitleCfg()
        self.go_table.scrollloopvectical_taskTitleList:InitItemData(self.unlockCount, _G.handler(self, self.RefreshTitle))
        self.go_table.scrollloopvectical_taskList:InitItemData(0, _G.handler(self, self.RefreshTask))
        self.titleListCount = #self.typeClass.missionCfg
    else
        self.go_table.scrollloopvectical_taskTitleList:UpdateAllItem()
    end
    self:UpdateTask()
    self:ShowOneKeyBtn()
end

function GuideBookTaskView:InitUIResouce()
    local spineTb = self.typeClass.spineTb
    if not _G.table.isEmptyOrNil(spineTb) then
        require("CardInfoManager"):GetInstance().GetRole(
            spineTb[1],
            _G.ePoolType.Temporary,
            self.go_table.obj_role,
            nil,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end

                trans:SetLocalScaleXYZ(spineTb[2] or 1)
                trans:SetLocalPosition(spineTb[3] or 0, spineTb[4] or 0, spineTb[5] or 0)
            end
        )
    end

    self.go_table.aorrawimage_title:SetActiveE(0)
    if not _G.string.IsNullOrEmpty(self.typeClass.txtImgPath) then
        self.go_table.aorrawimage_title:LoadImage(
            self.typeClass.txtImgPath,
            function(img)
                if self:IsNil() then
                    return
                end

                self.go_table.aorrawimage_title:SetActiveE(1)
                img:SetNativeSize()
            end
        )
    end

    if not _G.string.IsNullOrEmpty(self.typeClass.bgPath) then
        self.go_table.aorrawimage_bg:LoadImage(
            self.typeClass.bgPath,
            function(img)
                if self:IsNil() then
                    return
                end

                img:SetNativeSize()
            end
        )
    end
    if not _G.string.IsNullOrEmpty(self.typeClass.titleKey) then
        self.go_table.aortext_title.text = _G.GetLangPackValue(self.typeClass.titleKey)
    end
end

function GuideBookTaskView:InitProgress()
    local item
    local tb
    local maxLineSizeX = 555
    for k, v in pairs(self.activeCfg) do
        if not self.goalItemList[v.sid] then
            item = _G.InstantiateObject(self.go_table.obj_card, self.go_table.obj_line)
            local location = (v.value_active / self.typeClass.maxActiveGoal)
            item:SetName(v.value_active)
            item:SetAnchorPosition(location * 600 + 16, 0)
            tb = _G.GetAutoGoTable(item, _G.handlerbind(self, self.OnClickGoalItem, v))
            local awardItem = require "BaseAwardNewItem".New(tb.obj_Root, nil, 73)
            awardItem:ShowWithID(v.reward[1].type)
            awardItem:ShowEffect(true, 0.9)
            tb.obj_uieffect:ClearChildren()
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
                tb.obj_uieffect,
                function(trans)
                    if self:IsNil() then
                        _G.DestroyObject(trans)
                        return
                    end
                end
            )
            tb.aortext_cardProgress.text = v.value_active
            self.goalItemList[v.sid] = tb
        end
        tb = self.goalItemList[v.sid]
        tb.obj_uieffect:SetActiveE(self.typeClass:CanGetActiveAward(v.sid) and 1 or 0)
        _G.GameUtil.SetActiveByCondition(tb.obj_mask, self.typeClass:GotActiveAward(v.sid))
    end
    self.go_table.aortext_nowActive.text = self.typeClass.curActiveGoal
    if self.typeClass.curActiveGoal >= self.typeClass.maxActiveGoal then
        self.go_table.aorimage_activeSchedule:SetRectTransformSize(maxLineSizeX, 10)
    else
        self.go_table.aorimage_activeSchedule:SetRectTransformSize(
            ((self.typeClass.curActiveGoal / self.typeClass.maxActiveGoal) * maxLineSizeX), 10)
    end
end

function GuideBookTaskView:SortTitleCfg()
    self.unlockCount = 0
    _G.SortList(
        self.typeClass.missionCfg,
        function(cfg)
            local mission = cfg.mission_group[1]
            local funOpen = _G.ConfigManager.mission_extra_cfg[mission].function_open
            local order = 0
            local lock = 0
            if funOpen ~= 0 then
                local conditions = _G.ConfigManager.function_open_cfg[funOpen].condition_type
                for _, v in pairs(conditions) do
                    if not _G.GlobalConditionManager.CheckCondition(v[1], v[2]) then
                        order = 1
                        break
                    end
                end
            end

            if order == 0 then
                self.unlockCount = self.unlockCount + 1
            end

            if self.openDay >= (self.typeClass.conDay[cfg.id] or 0) then
                lock = 1
            end

            return lock, -order, -cfg.display_priority
        end
    )
end

function GuideBookTaskView:RefreshTitle(index, obj)
    local x = index + 1
    local cfg = self.typeClass.missionCfg[x]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickTitle, x, cfg))
    self.titleItemList[x] = tb
    tb.aortext_label.text = _G.GetLangPackValue(cfg.name)
    tb.aortext_label2.text = _G.GetLangPackValue(cfg.name)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_On, self.curTitleIndex == x)
    if x <= self.unlockCount then
        tb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.StarsGoalTask.id, cfg.id)
        local txtColor = "C6B69D"
        if _G.AppSetting.IsXzns then
            txtColor = "DBDBDB"
        end
        tb.aortext_label.color = _G.ColorTools.FormatColorByString(txtColor)
        tb.aorimage_off:SetGray(false)
        tb.obj_redpoint:SetActiveE(1)
    else
        tb.aortext_label.color = _G.ColorTools.FormatColorByString("444444")
        tb.aorimage_off:SetGray(true)
        tb.obj_redpoint:SetActiveE(0)
    end
    tb.obj_redpoint:SetActiveE(self.typeClass:ChenckTitleRedPoint(cfg.id))
    local day = self.typeClass.conDay[cfg.id] or 0
    tb.obj_lock:SetActiveE(self.openDay >= day and 0 or 1)
end

function GuideBookTaskView:RefreshTask(index, obj)
    local x = index + 1
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickTask, x))
    self.taskItemList[x] = tb
    local taskInfo = self.allTaskData[self.taskGroupList[x]]
    if taskInfo == nil then
        return
    end
    local getItem = function(_data, _tb, isgou, isCanTake)
        local p = _tb.obj_items
        for i = 1, p:GetChildCountE() do
            p:GetChildE(i - 1):DestroyObject()
        end
        for i = 1, #_data do
            if _data[i][1] ~= 47 then
                _G.StorageManager:GetInstance():GetItemBaseViewNew(
                    _data[i],
                    p,
                    function(tran)
                        _tb.item = tran
                        if _data[i][1] == 0 then
                            tran.sid = _data[i][4]
                        else
                            tran.sid = _data[i][1]
                        end
                        tran.gameObject:SetLocalPosition(0, 0, 0)
                        tran.gameObject:SetLocalScaleXYZ(0.85)
                        tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                        if tran.SetGou then
                            tran:SetGou(isgou)
                        end
                        if tran.SetGradeNew then
                            tran:SetGradeNew(false)
                        end
                    end,
                    function(gameObject)
                        if gameObject.sid or (gameObject[1] and gameObject[1].sid) then
                            require "CommonTipManager":GetInstance():OpenTip(p, gameObject.sid or gameObject[1].sid)
                        else
                            self:OpenCard()
                        end
                    end
                )
            end
        end
    end

    local reward = taskInfo.Cfg.reward
    local CheckIsGet = taskInfo:CheckIsGet()
    local CheckIsCanTake = taskInfo:CheckIsCanTake()
    local now, total = taskInfo:GetCount()
    local info = _G.GetLangPackValue(taskInfo.Cfg.desc) .. "(" .. now .. "/" .. total .. ")"
    tb.aortext_info.text = info
    getItem(reward, tb, CheckIsGet, CheckIsCanTake)
    _G.GameUtil.SetActiveByCondition(tb.aorbtn_get, CheckIsCanTake)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_complete, CheckIsGet)
    _G.GameUtil.SetActiveByCondition(tb.aorbtn_go, not CheckIsGet and not CheckIsCanTake)
end

function GuideBookTaskView:OnClickTask(go, isOn, index)
    local name = go:GetName()
    local taskInfo = self.allTaskData[self.taskGroupList[index]]
    if self.clickTask then
        return
    end
    if name == "@_aorbtn_get" then
        self.clickTask = true
        self.typeClass:FinishTask(
            { taskInfo.id },
            _G.handler(self, self.OnFinishTaskSuccess)
        )
    elseif name == "@_aorbtn_go" then
        local link = taskInfo.Cfg.link
        if link then
            if link ~= 0 then
                if _G.ConfigManager.item_way_cfg[link] then
                    _G.JumpManager:GetInstance():Jump(link)
                end
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(690102)
            end
        end
    end
end

function GuideBookTaskView:OnClickTitle(go, isOn, index, cfg)
    if self.curTitleIndex == index then
        return
    end
    local day = self.typeClass.conDay[cfg.id] or 0
    if self.openDay < day then
        _G.PopWindowManager:GetInstance():ShowAllTips(1515, nil, nil, nil, nil, nil, day - self.openDay)
        return
    end
    if index > self.unlockCount then
        local sid = _G.ConfigManager.mission_extra_cfg[self.missionCfg[index].missions[1]].function_open
        _G.FunctionManager:GetInstance():ShowFuncitonOpenTips(sid)
        return
    end
    self.titleItemList[self.curTitleIndex].aorimage_On:SetActiveE(0)
    self.curTitleIndex = index
    self.titleItemList[index].aorimage_On:SetActiveE(1)
    self.titleItemList[index].obj_redpoint:SetActiveE(self.typeClass:ChenckTitleRedPoint(cfg.id))
    self:UpdateTask()
end

function GuideBookTaskView:UpdateTask()
    local cfg = self.typeClass.missionCfg[self.curTitleIndex]
    self.taskGroupList = cfg and cfg.mission_group or {}
    local count = #self.taskGroupList
    if not self.TaskListCount then
        self.go_table.scrollloopvectical_taskList:UpdateCount(count)
        self.titleListCount = count
    else
        if self.TaskLititleListCountstCount ~= count then
            self.go_table.scrollloopvectical_taskList:UpdateCount(count)
            self.titleListCount = count
        else
            self.go_table.scrollloopvectical_taskList:UpdateAllItem()
        end
    end
end

function GuideBookTaskView:OnClickGoalItem(go, isOn, data)
    local name = go:GetName()
    if self.clickTask or self.ClickCard then
        return
    end
    if name == "@_aorbtn_Get" then
        if data.value_active <= self.typeClass.curActiveGoal and not self.typeClass:GotActiveAward(data.sid) then
            self.ClickCard = true
            self.typeClass:GetAward(_G.handlerbind(self, self.OnGetGoalSuccess, data.sid))
        else
            local itemData = data.reward and data.reward[1].type
            require "CommonTipManager":GetInstance():OpenTip(go, itemData[1])
        end
    end
end

function GuideBookTaskView:OnGetGoalSuccess(id)
    local tb = self.goalItemList[id]
    tb.obj_mask:SetActiveE(1)
    self:InitProgress()
    self.ClickCard = false
end

---判断是否显示一键领取
function GuideBookTaskView:ShowOneKeyBtn()
    local CheckHaveGetGoal = self.typeClass.awardTask
    if _G.table.count(CheckHaveGetGoal) > 0 then
        self.go_table.aorbtn_getOneKey:SetGray(false)
        self.go_table.obj_oneGetEff:SetActiveE(1)
        local color = "8C2D14"
        if _G.AppSetting.IsXzns then
            color = "50351e"
        end
        self.go_table.aorbtn_getOneKey:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
            require("CardInfoManager").GetColorFromRGB("FFFFFF")
        self.go_table.aortext_getOneKey.color = require("CardInfoManager").GetColorFromRGB(color)
    else
        self.go_table.aorbtn_getOneKey:SetGray(true)
        self.go_table.aorbtn_getOneKey:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
            require("CardInfoManager").GetColorFromRGB("A9A9A9")
        self.go_table.obj_oneGetEff:SetActiveE(0)
        self.go_table.aortext_getOneKey.color = require("CardInfoManager").GetColorFromRGB("434343")
    end
end

---一键领取所有奖励
function GuideBookTaskView:CountFinishTask()
    local awardTask = self.typeClass.awardTask
    if _G.table.count(awardTask) > 0 then
        local tb = {}
        for _, id in pairs(awardTask) do
            _G.table.insert(tb, id)
        end
        self.typeClass:FinishTask(tb, _G.handler(self, self.OnFinishTaskSuccess))
    end
end

function GuideBookTaskView:OnFinishTaskSuccess(msg)
    --如果当前页签没有可领取 找到可以领取的页签 跳转 没有找到则不变
    if not self.typeClass:CheckHaveGetTask(self.typeClass.missionCfg[self.curTitleIndex].id) then
        local index = self.typeClass:GetTitleIndex(self.curTitleIndex)
        if index then
            self.curTitleIndex = index
        end
    end
    self:InitView()
    require "CommonTipManager".OpenCommonAwardView(
        msg,
        function()
            self.clickTask = false
        end
    )
end

