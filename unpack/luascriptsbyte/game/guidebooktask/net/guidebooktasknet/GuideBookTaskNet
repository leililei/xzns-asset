local base = require("BaseGameNet")

---@class GuideBookTaskNet : BaseGameNet	通信协议
local GuideBookTaskNet = _G.BaseClass("GuideBookTaskNet", base)
---@return GuideBookTaskNet GuideBookTaskNet

function GuideBookTaskNet:InitListeners()
    self:AddMessageListener(_G.ConfigManager.net_map.activity_stars_goal_collector.Cmd, self.ActivityCollector)
end

---领取奖励
function GuideBookTaskNet:GetAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_stars_goal_award
    self:Access(item, pbData, callback)
end

---完成任务
function GuideBookTaskNet:FinishTask(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_stars_goal_finish
    self:Access(item, pbData, callback)
end

function GuideBookTaskNet:ActivityCollector(msg)
    ---处理后端主动推送的任务数据更新
    _G.Events:GetInstance():Broadcast(_G.eGuideBook.ActivityCollector, msg)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function GuideBookTaskNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function GuideBookTaskNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end


return GuideBookTaskNet