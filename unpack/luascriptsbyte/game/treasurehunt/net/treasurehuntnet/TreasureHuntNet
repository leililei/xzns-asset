local base = require("BaseGameNet")

---@class TreasureHuntNet : BaseGameNet	通信协议
local TreasureHuntNet = _G.BaseClass("TreasureHuntNet", base)
---@return TreasureHuntNet TreasureHuntNet
function TreasureHuntNet:GetInstance()
    return  base.GetInstance(self)
end

function TreasureHuntNet:TaskFinish(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_module_theme_treasure_finish
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

function TreasureHuntNet:GetAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_module_theme_treasure_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function TreasureHuntNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end


return TreasureHuntNet