local ThemeActivityManager = require("ThemeActivityManager"):GetInstance()
local TreasureHuntModel = require("TreasureHuntModel"):GetInstance()
local TreasureHuntBoxItem = require("TreasureHuntBoxItem")
local TreasureHuntJigsawItem = require("TreasureHuntJigsawItem")

local TreasureBoxIDs = {101, 102, 103, 104, 201, 202, 203, 204, 205}

---@class TreasureHuntView : UIBaseView    中文描述
---@field public go_table TreasureHuntView_GoTable GoTable
local TreasureHuntView = _G.BaseClass("TreasureHuntView", _G.UIBaseView)

function TreasureHuntView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function TreasureHuntView:OnCreate()
    self.boxList = {}
    self.fragmentList = {}
    self.scrollInit = true
    self.lastIndex = 1
    self.lastBoxId = 0
    self.prizeProgress = TreasureHuntModel.JigsawProgress
    self.sid = ThemeActivityManager:GetActivityID()
    self.itemTable = {}
    self:InitView()
end

---初始化显示
---@private
function TreasureHuntView:InitView()
    self.go_table.aorrawimage_Bg:LoadImage(TreasureHuntModel.BackgroundPath)
    self.go_table.aorrawimage_Jigsaw:LoadImage(TreasureHuntModel.JigsawPath)
    self:UpdateTime()
    self:InitBoxesShow()
    self.go_table.aortext_Owned.text = _G.GetLangPackValue(90033010102, self.prizeProgress)
    local array = {TreasureHuntModel.UltimatePrize[1].sid, TreasureHuntModel.UltimatePrize[1].num}
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        array,
        self.go_table.obj_PrizeItem,
        function(tran)
            self.prize = tran
            tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            if self.prizeProgress == 20 then
                if TreasureHuntModel.BoxesInfo[1].received then
                    tran:SetGou(true)
                else
                    _G.UIUtils.LoadEffectByCfg(
                        _G.ConfigManager.ui_effect_cfg.ef_TreasureHuntView_icon,
                        tran.go_table.obj_uieffect,
                        function()
                            if self:IsNil() then
                                _G.UIUtils.RemoveEffect(tran)
                            end
                        end
                    )
                end
            end
        end,
        function(tran)
            if self.prizeProgress == 20 and not TreasureHuntModel.BoxesInfo[1].received then
                TreasureHuntModel:GetAward(
                    self.sid,
                    1,
                    function()
                        tran.go_table.obj_uieffect:SetActiveE(0)
                        tran:SetGou(true)
                    end
                )
            else
                require("CommonTipManager"):GetInstance():OpenTip(
                    self.go_table.obj_PrizeItem,
                    TreasureHuntModel.UltimatePrize[1].sid
                )
            end
        end
    )
    if self.scrollInit then
        self.go_table.scrollloopvectical_Jigsaw:InitItemData(20, _G.handler(self, self.RefreshScrollItem))
        self.scrollInit = false
    else
        self.go_table.scrollloopvectical_Jigsaw:UpdateAllItem()
    end
end

---刷新拼图item
---@private
function TreasureHuntView:RefreshScrollItem(index, obj)
    index = index + 1
    if not self.fragmentList[index] then
        self.fragmentList[index] =
            self:AddComponent(
            obj,
            TreasureHuntJigsawItem.New(
                obj,
                index,
                _G.handler(self, self.GetOrSetLastIndex),
                _G.handler(self, self.RefreshBoxAndPrize)
            )
        )
    end
    self.fragmentList[index]:Show()
    if self.scrollInit and index == 1 then
        self.fragmentList[index]:RefreshChoose(true)
        self:RefreshTask(index)
    end
end

---获取或改变选中拼图index
function TreasureHuntView:GetOrSetLastIndex(index)
    if index then
        if index ~= self.lastIndex then
            self.fragmentList[self.lastIndex]:RefreshChoose(false)
            self.fragmentList[index]:RefreshChoose(true)
            self.lastIndex = index
            self:RefreshTask(index)
        end
    end
    return self.lastIndex
end

---刷新右上任务信息
function TreasureHuntView:RefreshTask(index)
    local missionList = TreasureHuntModel.MissionList
    self.go_table.aortext_TaskTarget.text = _G.GetLangPackValue(missionList[index].cfg.desc)
    local missionNeed, missionProgress = missionList[index].data:GetCount()
    self.go_table.slider_Progress.value = missionProgress / missionNeed
    local slider = _G.GetAutoGoTable(self.go_table.slider_Progress)
    slider.aortext_Slider.text = missionProgress .. "/" .. missionNeed
    self.go_table.obj_AwardItem:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        missionList[index].cfg.reward[1],
        self.go_table.obj_AwardItem,
        function(tran)
            self.currJigsawAwardTrans = tran
            self.currJigsawAwardIndex = index
            tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            if missionList[index].received then
                tran:SetGou(true)
            end
        end
    )
    local canReceived = missionList[index].data:GetProgress() == 1
    _G.GameUtil.SetActiveByCondition(
        self.go_table.aorbtn_Jump,
        not canReceived and TreasureHuntModel.MissionList[self.lastIndex].cfg.link ~= 0
    )
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_Finished, canReceived)
end

---刷新宝箱和大奖显示
function TreasureHuntView:RefreshBoxAndPrize(index)
    if self.currJigsawAwardIndex == index then
        self.currJigsawAwardTrans:SetGou(true)
    end
    for _, v in pairs(self.boxList) do
        v:Show()
    end
    self.prizeProgress = TreasureHuntModel.JigsawProgress
    self.go_table.aortext_Owned.text = _G.GetLangPackValue(90033010102, self.prizeProgress)

    if self.prizeProgress == 20 then
        for _, fragment in pairs(self.fragmentList) do
            fragment:FinishShow()
        end
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_TreasureHuntView_saoguang,
            self.go_table.obj_eff,
            function()
                if self:IsNil() then
                    _G.UIUtils.RemoveEffect(self.go_table.obj_eff)
                end
            end
        )
        if self.prize and not TreasureHuntModel.BoxesInfo[1].received then
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_TreasureHuntView_icon,
                self.prize.go_table.obj_uieffect,
                function()
                    if self:IsNil() then
                        _G.UIUtils.RemoveEffect(self.prize)
                    end
                end
            )
        end
    end
end

---初始化宝箱显示
function TreasureHuntView:InitBoxesShow()
    for _, id in pairs(TreasureBoxIDs) do
        self.boxList[id] =
            self:AddComponent(
            self.go_table["obj_BoxItem" .. id],
            TreasureHuntBoxItem.New(self.go_table["obj_BoxItem" .. id], id, _G.handler(self, self.ShowBoxAward))
        )
        self.boxList[id]:Show()
    end
end

---点击显示宝箱奖励
function TreasureHuntView:ShowBoxAward(id, isGou)
    if id ~= self.lastBoxId then
        self.lastBoxId = id
        for key, value in pairs(self.itemTable) do
            _G.DestroyObject(value.gameObject)
        end
        local x, y, z = self.go_table["obj_BoxItem" .. id]:GetPosition()
        self.go_table.obj_ItemTips:SetPosition(x, y + 1.5, z)
        self.itemTable = {}
        if self.go_table.aorbtn_TipsView:GetActiveSelf() == 0 then
            local tf = self.go_table.obj_ItemTips:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
            if not _G.IsNil(tf) then
                tf:SetSizeWithCurrentAnchors(
                    _G.CS.UnityEngine.RectTransform.Axis.Horizontal,
                    #TreasureHuntModel.BoxesInfo[id].award * 68
                )
            end
        end
        self.go_table.aorbtn_TipsView:SetActiveE(1)
        for _, v in pairs(TreasureHuntModel.BoxesInfo[id].award) do
            local info = {v.sid, v.num}
            self:CreateItem(info, isGou, self.go_table.obj_Parent, self.itemTable)
        end
    else
        self.go_table.aorbtn_TipsView:SetActiveE(1 - self.go_table.aorbtn_TipsView:GetActiveSelf())
    end
end

---创建宝箱奖励显示item
function TreasureHuntView:CreateItem(data, isGou, Parent, itemTable)
    if _G.IsNil(Parent) or Parent:GetctiveInHierarchy() == 0 then
        return
    end
    local Sid = data[1]
    if Sid ~= _G.ResPropID.ActiveAch and Sid ~= _G.ResPropID.ActiveValue then
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            data,
            Parent,
            function(item)
                item.gameObject:SetLocalScaleXYZ(0.7)
                item.gameObject:SetActiveE(1)
                item:SetGou(isGou)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                table.insert(itemTable, item)
            end,
            function(go, isOn)
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, Sid)
            end
        )
    end
end

---更新时间
function TreasureHuntView:UpdateTime()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.RTS = require "ThemeActivityManager":GetInstance():GetRTS()
    local time = {}
    if self.RTS <= 0 then
        time.day = 0
        self.go_table.aortext_CountDown.text =
            _G.LangUtil.GetLangPackValue(90028500004, _G.LangUtil.GetLangPackValue(90025500011, time.day, ""))
        self:Close()
        return
    else
        time = _G.TimeUtil.TranslateSecond(self.RTS)
        if time.hour > 0 or time.min > 0 or time.sec > 0 then
            time.day = time.day + 1
        end
        self.go_table.aortext_CountDown.text =
            _G.LangUtil.GetLangPackValue(90028500004, _G.LangUtil.GetLangPackValue(90025500011, time.day, ""))
    end

    self.timer =
        _G.TimerManager:GetInstance():GetTimer(_G.TimeUtil.GetSixClockTimer(), self.UpdateTime, self, true, false, true)
    self.timer:Start()
end

---界面的销毁函数
function TreasureHuntView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---按钮点击事件在这里派发
function TreasureHuntView:OnClickBtn(go)
    if go == self.go_table.aorbtn_Jump then
        _G.JumpManager:GetInstance():Jump(TreasureHuntModel.MissionList[self.lastIndex].cfg.link)
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_TipsView then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_TipsView, false)
    elseif go == self.go_table.aorbtn_help then
        ---打开玩法说明页面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 92)
    end
end

return TreasureHuntView
