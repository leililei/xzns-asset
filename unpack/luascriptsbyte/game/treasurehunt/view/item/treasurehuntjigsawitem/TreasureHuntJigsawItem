local ThemeActivityManager = require("ThemeActivityManager"):GetInstance()
local TreasureHuntModel = require("TreasureHuntModel"):GetInstance()

---@class TreasureHuntJigsawItem    中文描述
---@field public go_table TreasureHuntView._obj_FragmentItem_GoTable
local TreasureHuntJigsawItem = _G.BaseClass("TreasureHuntJigsawItem", _G.Component)
_G.TreasureHuntJigsawItem = TreasureHuntJigsawItem

local CS = _G.CS
local typeof = _G.typeof

---类的构造函数
---@param data TreasureHuntJigsawFragmentData
function TreasureHuntJigsawItem:__init(obj, index, callback, callOK)
    self.index = index
    self.callback = callback
    self.callOK = callOK
    self.go_table = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickBtn, index))
    self.sid = ThemeActivityManager:GetActivityID()
end

---@private
function TreasureHuntJigsawItem:Show()
    local data = TreasureHuntModel.MissionList[self.index]
    local canReceived = data.data:GetProgress() == 1
    local received = data.received
    self:RefreshShow(canReceived, received)
    if canReceived and not received then
        ---显示任务奖励
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
                data.cfg.reward[1],
                self.go_table.obj_Award,
                function(tran)
                    tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end,
                function()
                    TreasureHuntModel:GetJigsawAward(self.sid, self.index, function()
                        self:RefreshShow(true, true)
                        if self.callOK then
                            self.callOK(self.index)
                        end
                    end)
                end)
    end
end

---@private
function TreasureHuntJigsawItem:RefreshShow(canReceived, received)
    if TreasureHuntModel.JigsawProgress == 20 then
        self:FinishShow()
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_IsLock, not canReceived)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_GetAward, canReceived and not received)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_Unlocked, received)
        if canReceived and not received then
            self.go_table.obj_effGet:SetActiveE(1)
            if self.go_table.obj_effGet:GetChildCountE() == 0 then
                _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_TreasureHuntView_biankuang, self.go_table.obj_effGet, function()
                    if _G.IsNil(self) then
                        _G.UIUtils.RemoveEffect(self.go_table.obj_effGet)
                    end
                end)
            end
        else
            self.go_table.obj_effGet:SetActiveE(0)
        end
    end
end

---@private
function TreasureHuntJigsawItem:RefreshChoose(isChoose)
    if isChoose and TreasureHuntModel.JigsawProgress < 20 then
        self.go_table.obj_effChoose:SetActiveE(1)
        if self.go_table.obj_effChoose:GetChildCountE() == 0 then
            _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_TreasureHuntView_xuanzhong, self.go_table.obj_effChoose, function()
                if _G.IsNil(self) then
                    _G.UIUtils.RemoveEffect(self.go_table.obj_effChoose)
                end
            end)
        end
    else
        self.go_table.obj_effChoose:SetActiveE(0)
    end
end

---@private
function TreasureHuntJigsawItem:FinishShow()
    self.go_table.obj_IsLock:SetActiveE(0)
    self.go_table.obj_GetAward:SetActiveE(0)
    self.go_table.obj_Unlocked:SetActiveE(0)
    self.go_table.obj_BlackLine:SetActiveE(0)
    self.go_table.obj_effGet:SetActiveE(0)
    self.go_table.obj_effChoose:SetActiveE(0)
    self.go_table.aorbtn_Choose:SetActiveE(0)
end

---@private
function TreasureHuntJigsawItem:OnClickBtn(go, isOn, index)
    if self.callback then
        self.callback(index)
    end
end

---类的析构函数
function TreasureHuntJigsawItem:Dispose()
end

return TreasureHuntJigsawItem