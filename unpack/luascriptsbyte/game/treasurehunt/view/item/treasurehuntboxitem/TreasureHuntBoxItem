local ThemeActivityManager = require("ThemeActivityManager"):GetInstance()
local TreasureHuntModel = require("TreasureHuntModel"):GetInstance()

---@class TreasureHuntBoxItem    中文描述
---@field public go_table TreasureHuntView._obj_BoxItem201_GoTable
local TreasureHuntBoxItem = _G.BaseClass("TreasureHuntBoxItem", _G.Component)
_G.TreasureHuntBoxItem = TreasureHuntBoxItem

local CS = _G.CS
local typeof = _G.typeof

---类的构造函数
---@field data TreasureHuntBoxData
function TreasureHuntBoxItem:__init(obj, id, callback)
    self.id = id
    self.callback = callback
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.sid = ThemeActivityManager:GetActivityID()
end

function TreasureHuntBoxItem:Show()
    local data = TreasureHuntModel.BoxesInfo[self.id]
    self.progress = TreasureHuntModel:CheckBoxProgress(self.id)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_CloseBox, not data.received)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_OpenBox, data.received)
    if self.progress == 1 and not data.received then
        if self.go_table.obj_eff:GetChildCountE() == 0 then
            _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_TreasureHuntView_baoxiang, self.go_table.obj_eff, function()
                if _G.IsNil(self) then
                    _G.UIUtils.RemoveEffect(self.go_table.obj_eff)
                end
            end)
        end
    end
end

---@private
function TreasureHuntBoxItem:OnClickBtn(go)
    if go == self.go_table.aorbtn_Open then
        local data = TreasureHuntModel.BoxesInfo[self.id]
        if self.progress == 1 and not data.received then
            TreasureHuntModel:GetAward(self.sid, self.id, _G.handler(self, self.Show))
        elseif self.progress < 1 or data.received then
            if self.callback then
                self.callback(self.id, data.received)
            end
        end
    end
end

---类的析构函数
function TreasureHuntBoxItem:Dispose()
end

return TreasureHuntBoxItem