local VIPDrawModel = require "VIPDrawModel"
local RedPointManager = require("RedPointManager")

local base = require "EventViewBase"
---@class VIPDrawGoodsInfoView : UIBaseView	中文描述
---@field public go_table VIPDrawGoodsInfoView_GoTable GoTable
local VIPDrawGoodsInfoView = _G.BaseClass("VIPDrawGoodsInfoView", base)

function VIPDrawGoodsInfoView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function VIPDrawGoodsInfoView:OnCreate(tabid, goodids, descs, offset, shopid)
    self.tabId = tabid
    self.goodids = goodids
    self.descs = descs
    self.offset = offset

    self.goodOff = {}
    self.goodDescs = {}
    self.goodIds = {}
    for i = 1, #goodids do
        local buyTimes = VIPDrawModel:GetInstance():GetGoodsTimesByGoodId(self.tabId, goodids[i])
        local sscfg = _G.ConfigManager.season_shop_cfg[goodids[i]]
        if buyTimes < sscfg.count_limit then
            table.insert(self.goodIds, goodids[i])
            table.insert(self.goodDescs, descs[i])
            table.insert(self.goodOff, offset[i])
        end
    end

    self.goodIndex = 1
    self.shopId = shopid

    local value = _G.PlayerPrefsManager.GetInt("VIPDrawCanExchange" .. self.goodIds[self.goodIndex], 1)
    if value == 0 then
        self.go_table.toggle_showred.isOn = false
    end

    self:UpdateView()
end

function VIPDrawGoodsInfoView:UpdateView()
    ---@type season_shop_cfg
    local sscfg = _G.ConfigManager.season_shop_cfg[self.goodIds[self.goodIndex]]
    local id = sscfg.get_item[1]
    ---@type item_cfg
    local itemcfg = _G.ConfigManager.item_cfg[id]
    --10-皮肤激活；12-头像框激活；13-称号激活；26-聊天框
    if itemcfg.UseType == 10 then
        self.skinId = tonumber(itemcfg.UseParameter[1][1])
    elseif itemcfg.UseType == 12 then
        self.frameId = tonumber(itemcfg.UseParameter[1][1])
    elseif itemcfg.UseType == 13 then
        self.titleId = tonumber(itemcfg.UseParameter[1][1])
    elseif itemcfg.UseType == 26 then
        self.chatId = tonumber(itemcfg.UseParameter[1][1])
    else
        if _G.AppSetting.DEBUG then
            _G.LogError(self.goodIds[self.goodIndex], "未匹配到VIP限定商品对应的使用类型")
        end
    end

    local itemiconbtns = { self.go_table.aorbtn_good1, self.go_table.aorbtn_good2, self.go_table
        .aorbtn_good3, self.go_table.aorbtn_good4 }

    local itemicondis = { self.go_table.aorimage_gooddi1, self.go_table.aorimage_gooddi2, self.go_table
        .aorimage_gooddi3, self.go_table.aorimage_gooddi4 }
    local itemicons = { self.go_table.aorrawimage_good1, self.go_table.aorrawimage_good2, self.go_table
        .aorrawimage_good3, self.go_table.aorrawimage_good4 }

    self.itemchoose = { self.go_table.aorimage_goodchoose1, self.go_table.aorimage_goodchoose2, self.go_table
        .aorimage_goodchoose3, self.go_table.aorimage_goodchoose4 }

    for i = 1, #itemiconbtns do
        itemiconbtns[i]:SetActiveE(0)
    end

    for i = 1, #self.goodIds do
        ---@type season_shop_cfg
        local sscfg = _G.ConfigManager.season_shop_cfg[self.goodIds[i]]
        local id = sscfg.get_item[1]
        ---@type item_cfg
        local itemcfg = _G.ConfigManager.item_cfg[id]

        itemiconbtns[i]:SetActiveE(1)

        itemicondis[i].SpriteName = _G.ItemBaseIconName_Decoration[itemcfg.Quality]

        itemicons[i]:LoadImage(itemcfg.Icon)

        if self.goodIndex == i then
            self.itemchoose[i]:SetActiveE(1)
        else
            self.itemchoose[i]:SetActiveE(0)
        end
    end

    local icon = _G.StorageManager:GetInstance():GetItemIcon(sscfg.need_item[1])
    if not _G.string.IsNullOrEmpty(icon) then
        self.go_table.aorrawimage_itemicon:LoadImage(icon)
    end

    local needid = sscfg.need_item[1]
    local neednum = sscfg.need_item[2]

    local hasNum = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.Prop, needid)
    self.go_table.aortext_PropNum.text = neednum

    if hasNum >= neednum then
        self.go_table.aortext_PropNum.color = require "CardInfoManager".GetColorFromRGB("FFFFFF")
    else
        self.go_table.aortext_PropNum.color = require "CardInfoManager".GetColorFromRGB("FF0000")
    end

    self.go_table.aortext_title.text = _G.GetLangPackValue(self.goodDescs[self.goodIndex])

    local buyTimes = VIPDrawModel:GetInstance():GetGoodsTimesByGoodId(self.tabId, self.goodIds[self.goodIndex])
    if buyTimes < sscfg.count_limit then
        self.go_table.aorbtn_df:SetGray(false)
        self.go_table.aortext_df.text = _G.GetLangPackValue(90000000961)
        self.go_table.aortext_df.color = require "CardInfoManager".GetColorFromRGB("8C2D14")

        local isFinish = VIPDrawModel:GetInstance():CheckTagFinish(self.shopId)

        if isFinish and hasNum >= neednum then
            self.go_table.obj_redpoint:SetActiveE(1)
        else
            self.go_table.obj_redpoint:SetActiveE(0)
        end
    else
        ----已兑换
        self.go_table.aorbtn_df:SetGray(true)
        self.go_table.aortext_df.text = _G.GetLangPackValue(90000000961)
        self.go_table.aortext_df.color = require "CardInfoManager".GetColorFromRGB("494949")
    end

    self.proNames = { self.go_table.aortext_nameProp1, self.go_table.aortext_nameProp2, self.go_table.aortext_nameProp3,
        self.go_table.aortext_nameProp4 }
    self.proValues = { self.go_table.aortext_sumProp1, self.go_table.aortext_sumProp2, self.go_table.aortext_sumProp3,
        self.go_table.aortext_sumProp4 }

    self:SapwnTitle()
    self:CreateSpine()
    self:UpdateTopShow()
    self:UpdateChatShow()
end

---生成称号
---@param item table
function VIPDrawGoodsInfoView:SapwnTitle()
    if not self.titleId then
        return
    end
    self.go_table.obj_ch:SetActiveE(1)
    self.go_table.obj_ch:SetLocalPosition(0 + self.goodOff[self.goodIndex][1], 195 + self.goodOff[self.goodIndex][2], 0)
    local titleScale = _G.ConfigManager.discrete_cfg[100111] and _G.ConfigManager.discrete_cfg[100111][1][1] or 1
    local player_title = _G.ConfigManager.player_title_effect_cfg[self.titleId]
    if player_title.type_title == 1 then
        self.go_table.aorrawimage_title:LoadImage(player_title.title)
        self.go_table.aorrawimage_title:SetActiveE(1)
        self.go_table.aorrawimage_title:SetLocalScaleXYZ(0.29 * titleScale)
        self.go_table.obj_titleEffect:RemoveAllChildren()
        self.curShowEffTitle = nil
    elseif player_title.type_title == 2 then
        if self.curShowEffTitle ~= player_title.title then
            self.go_table.obj_titleEffect:RemoveAllChildren()
            self.curShowEffTitle = player_title.title
            UIUtils.LoadEffectTitleOrFrame(
                player_title.title,
                self.go_table.obj_titleEffect,
                function(trans)
                    if self.curShowEffTitle ~= player_title.title then
                        trans:DestroyObject()
                        return
                    end
                    local parClip = trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                    parClip.NeedCheck = true
                    parClip.CheckCount = 10
                    parClip.CheckOne = 3
                    trans:SetLocalScaleXYZ(titleScale)
                end
            )
        end
        self.go_table.aorrawimage_title:SetActiveE(0)
    end

    self.go_table.obj_allprop:SetActiveE(1)
    self.go_table.aortext_propnil:SetActiveE(0)

    self.go_table.aortext_descProp1.text = _G.GetLangPackValue(90020800030)

    local attr = player_title.base_att
    for i, v in pairs(attr) do
        local num = _G.tonumber(v[3])
        local aType = v[2] == "1" and _G.AttCountType.other or _G.tonumber(v[2])
        num = _G.AttributeClassManager:GetInstance():GetValueWithName(v[1], num, aType)
        local numStr
        if _G.AttrType[v[1]].percentage == 1 or v[2] == "2" then
            num = num * 100
            num = _G.GameUtil.FormatNum(num)
            numStr = _G.tostring(num) .. "%"
        else
            num = _G.math.floor(num)
            num = _G.GameUtil.NumberWY(num)
            numStr = _G.tostring(num)
        end
        numStr = "+" .. numStr
        self.proNames[i].text = _G.AttrType[v[1]].des
        self.proValues[i].text = numStr
    end

    self.go_table.aortext_descProp2.text = ""
    for i = 3, 4 do
        self.proNames[i].text = ""
        self.proValues[i].text = ""
    end
end

function VIPDrawGoodsInfoView:CreateSpine()
    if not self.skinId then
        return
    end
    self.go_table.obj_role:SetActiveE(1)
    self.go_table.obj_role:SetLocalPosition(0 + self.goodOff[self.goodIndex][1], 0 + self.goodOff[self.goodIndex][2], 0)
    local trans = self.go_table.obj_role
    trans:ClearChildren()
    local scfg = _G.ConfigManager.skin_cfg[self.skinId]
    local path = scfg.ModelPathHi

    _G.PoolsManager:GetInstance():Spawn(
        path,
        _G.ePoolType.Temporary,
        trans,
        function(obj)
            if self:IsNil() then
                _G.DestroyObject(obj)
            end
            trans:SetLocalScaleXYZ(0.4)
            trans:SetLocalPosition(0, -155, 0)
        end
    )

    self.go_table.aortext_descProp1.text = _G.GetLangPackValue(90020800029)
    self.go_table.aortext_descProp2.text = _G.GetLangPackValue(90020800030)
    self.go_table.obj_allprop:SetActiveE(1)
    self.go_table.aortext_propnil:SetActiveE(0)
    local attr = scfg.base_att
    for i, v in pairs(attr) do
        local num = _G.tonumber(v[3])
        local aType = v[2] == "1" and _G.AttCountType.other or _G.tonumber(v[2])
        num = _G.AttributeClassManager:GetInstance():GetValueWithName(v[1], num, aType)
        local numStr
        if _G.AttrType[v[1]].percentage == 1 or v[2] == "2" then
            num = num * 100
            num = _G.GameUtil.FormatNum(num)
            numStr = _G.tostring(num) .. "%"
        else
            num = _G.math.floor(num)
            num = _G.GameUtil.NumberWY(num)
            numStr = _G.tostring(num)
        end
        numStr = "+" .. numStr
        self.proNames[i].text = _G.AttrType[v[1]].des
        self.proValues[i].text = numStr
    end
    local attr = scfg.team_base_att
    for i, v in pairs(attr) do
        local num = _G.tonumber(v[3])
        local aType = v[2] == "1" and _G.AttCountType.other or _G.tonumber(v[2])
        num = _G.AttributeClassManager:GetInstance():GetValueWithName(v[1], num, aType)
        local numStr
        if _G.AttrType[v[1]].percentage == 1 or v[2] == "2" then
            num = num * 100
            num = _G.GameUtil.FormatNum(num)
            numStr = _G.tostring(num) .. "%"
        else
            num = _G.math.floor(num)
            num = _G.GameUtil.NumberWY(num)
            numStr = _G.tostring(num)
        end
        numStr = "+" .. numStr
        self.proNames[i + 2].text = _G.AttrType[v[1]].des
        self.proValues[i + 2].text = numStr
    end
end

---头像框的显示
---@param data ChangeIconData
function VIPDrawGoodsInfoView:UpdateTopShow()
    if not self.frameId then
        return
    end
    self.go_table.obj_tx:SetActiveE(1)
    self.go_table.obj_tx:SetLocalPosition(0 + self.goodOff[self.goodIndex][1], 242 + self.goodOff[self.goodIndex][2], 0)
    local cfg = _G.ConfigManager.player_frame_cfg[self.frameId]
    local loadPath, Type = cfg.frame, cfg.type_title
    UIUtils.RemoveChildren(self.go_table.aorrawimage_frame)
    if Type ~= 2 then
        self.go_table.aorrawimage_frame:LoadImage(loadPath)
    else
        self.go_table.aorrawimage_frame.color = _G.Color.New(1, 1, 1, 0)
        UIUtils.LoadEffectTitleOrFrame(
            loadPath,
            self.go_table.aorrawimage_frame,
            function(item)
                if item then
                    item:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                    item:SetLocalScaleXYZ(1.2)
                end
            end
        )
    end

    self.go_table.obj_allprop:SetActiveE(0)
    self.go_table.aortext_propnil:SetActiveE(1)
end

---聊天框显示
function VIPDrawGoodsInfoView:UpdateChatShow()
    if not self.chatId then
        return
    end
    self.go_table.obj_lt:SetActiveE(1)
    self.go_table.obj_lt:SetLocalPosition(0 + self.goodOff[self.goodIndex][1], 195 + self.goodOff[self.goodIndex][2], 0)
    local cfg = _G.ConfigManager.player_bubble_cfg[self.chatId]
    self.go_table.aorimage_chatFrame.SpriteName = cfg.bubble
    self.go_table.obj_chatFrameEff:ClearChildren()
    if not _G.table.isEmptyOrNil(cfg.bubble_effect) then
        _G.UIUtils.LoadEffectByPath(
            cfg.bubble_effect[1][1],
            self.go_table.obj_chatFrameEff,
            function(trans)
                if self:IsNil() then
                    _G.UIUtils.RemoveEffect(trans)
                    return
                end
            end,
            nil,
            nil,
            nil,
            nil,
            nil,
            true
        )
    end
    self.go_table.obj_allprop:SetActiveE(0)
    self.go_table.aortext_propnil:SetActiveE(1)
end

---按钮点击事件在这里派发
function VIPDrawGoodsInfoView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        ---关闭按钮
        self:Close()
    elseif go == self.go_table.aorbtn_good1 then
        self.goodIndex = 1
        self:ResetAndUpdate()
    elseif go == self.go_table.aorbtn_good2 then
        self.goodIndex = 2
        self:ResetAndUpdate()
    elseif go == self.go_table.aorbtn_good3 then
        self.goodIndex = 3
        self:ResetAndUpdate()
    elseif go == self.go_table.aorbtn_good4 then
        self.goodIndex = 4
        self:ResetAndUpdate()
    elseif go == self.go_table.aorbtn_df then
        ---@type season_shop_cfg
        local cfg = _G.ConfigManager.season_shop_cfg[self.goodIds[self.goodIndex]]
        local id = cfg.need_item[1]
        local num = cfg.need_item[2]
        local hasNum = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.Prop, id)

        local buyTimes = VIPDrawModel:GetInstance():GetGoodsTimesByGoodId(self.tabId, self.goodIds[self.goodIndex])

        ---上期已兑换完
        local isFinish = VIPDrawModel:GetInstance():CheckTagFinish(self.shopId)
        if isFinish then
            if buyTimes < cfg.count_limit then
                if hasNum >= num then
                    VIPDrawModel:GetInstance():Exchange(self.tabId, self.goodIds[self.goodIndex], 1, function(msg)
                        RedPointManager:GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg
                            .LotteryExchange
                            .id)

                        self.goodOff = {}
                        self.goodDescs = {}
                        self.goodIds = {}
                        for i = 1, #self.goodids do
                            local buyTimes = VIPDrawModel:GetInstance():GetGoodsTimesByGoodId(self.tabId, self.goodids
                                [i])
                            local sscfg = _G.ConfigManager.season_shop_cfg[self.goodids[i]]
                            if buyTimes < sscfg.count_limit then
                                table.insert(self.goodIds, self.goodids[i])
                                table.insert(self.goodDescs, self.descs[i])
                                table.insert(self.goodOff, self.offset[i])
                            end
                        end
                        if #self.goodIds > 0 then
                            self.goodIndex = 1
                            self:ResetAndUpdate()
                        else
                            _G.PopWindowManager:GetInstance():ShowAllTips(1080101)
                            self:Close()
                        end
                    end)
                else
                    _G.PopWindowManager:GetInstance():ShowAllTips(1080105)
                end
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(1080101)
            end
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(1080103)
        end
    elseif go == self.go_table.toggle_showred then
        if isOn then
            _G.PlayerPrefsManager.SetInt("VIPDrawCanExchange" .. self.goodIds[self.goodIndex], 1)
        else
            _G.PlayerPrefsManager.SetInt("VIPDrawCanExchange" .. self.goodIds[self.goodIndex], 0)
        end
        RedPointManager:GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg
            .LotteryExchange
            .id)
    end
end

function VIPDrawGoodsInfoView:ResetAndUpdate()
    for i = 1, #self.itemchoose do
        self.itemchoose[i]:SetActiveE(0)
    end
    self.skinId = nil
    self.frameId = nil
    self.titleId = nil
    self.chatId = nil
    self.go_table.obj_allprop:SetActiveE(0)
    self.go_table.aortext_propnil:SetActiveE(0)
    self.go_table.obj_ch:SetActiveE(0)
    self.go_table.obj_role:SetActiveE(0)
    self.go_table.obj_tx:SetActiveE(0)
    self.go_table.obj_lt:SetActiveE(0)

    local value = _G.PlayerPrefsManager.GetInt("VIPDrawCanExchange" .. self.goodIds[self.goodIndex], 1)
    if value == 0 then
        self.go_table.toggle_showred.isOn = false
    else
        self.go_table.toggle_showred.isOn = true
    end

    self:UpdateView()
end

