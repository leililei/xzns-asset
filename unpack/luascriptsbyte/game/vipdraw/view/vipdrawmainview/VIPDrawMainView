local VIPDrawModel = require("VIPDrawModel")
local VIPPrivilegeModel = require("VIPPrivilegeModel")
local RedPointManager = require("RedPointManager")

---@class VIPDrawMainView : UIBaseView    中文描述
---@field public go_table SpoilsMainView_GoTable GoTable
local VIPDrawMainView = _G.BaseClass("VIPDrawMainView", _G.UIBaseView)

function VIPDrawMainView:Awake()
    self.WindowName = {
        Main = _G.ConfigManager.ui_cfg.VIPDrawMainView.Name,
        Limit = _G.ConfigManager.ui_cfg.VIPDrawLimitView.Name,
        Exchange = _G.ConfigManager.ui_cfg.VIPDrawShopView.Name
    }

    self.ToggleDic = {
        [self.WindowName.Main] = "aorbtn_main",
        [self.WindowName.Limit] = "aorbtn_limit",
        [self.WindowName.Exchange] = "aorbtn_exchange",
    }

    self.IconDic = {
        [self.WindowName.Main] = "ui_gh_qiyuan",
        [self.WindowName.Limit] = "ui_gh_xianding",
        [self.WindowName.Exchange] = "ui_icon",
    }

    self.Drawing = false
    self.ChangeNumIndex = 1
    self.ChangeNums = { 1, 10, 50, 100 }
    self:ShowTimes()
    self:ShowNeedCount()

    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function VIPDrawMainView:OnCreate(name)
    self:InitView()
    self.curView = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.VIPDrawMainView.Name)
    if name then
        self:ChangeView(name)
    end

    --显示货币信息
    if not _G.IsNil(self.go_table.obj_goldInfo) and self.go_table.obj_goldInfo:GetctiveInHierarchy() == 1 then
        --local currencySid = _G.ConfigManager.ui_cfg.VIPDrawLimitView.resources
        local ids = {}
        --for i = 1, #currencySid do
        --    table.insert(ids, currencySid[i])
        --end
        table.insert(ids, 80)
        table.insert(ids, 203031301)
        table.insert(ids, 79)
        self:AddComponent(
            self.go_table.obj_goldInfo,
            require("ResourceCompont").New(self.go_table.obj_goldInfo, ids)
        )
    end
    self.playerHead = self:AddComponent(
        self.go_table.obj_PlayerHead,
        require("PlayerComponent").New(self.go_table.obj_PlayerHead)
    )

    self:AddListener(_G.eVIPDraw.DrawFail, self.OnDrawFail)
    self:AddListener(_G.eVIPDraw.DrawFinish, self.OnDrawFinish)

    local icon = _G.StorageManager:GetInstance():GetItemIcon(79)

    self.go_table.aorrawimage_itemicon:LoadImage(icon)

    self.AnimComponent = self.go_table.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
end

function VIPDrawMainView:ShowBigAwardLock(pVRInfo)
    local len = self.go_table.obj_items:GetChildCountE()

    local r = Mathf.Sqrt(Mathf.Pow(57, 2) + Mathf.Pow(189, 2))

    for i = 1, len do
        local cos = Mathf.Cos(math.rad((len - (i - 1)) * 36 + 72))
        local sin = Mathf.Sin(math.rad((len - (i - 1)) * 36 + 72))

        local x = r * cos
        local y = r * sin

        local parent = self.go_table.obj_items:GetChildE(i - 1)
        parent:SetLocalPosition(x, y, 0)

        self:CreatItem(pVRInfo[i].data, parent, i)

        local bigsige = self.go_table.obj_bigjls:GetChildE(i - 1)
        _G.GameUtil.SetActiveByCondition(bigsige, pVRInfo[i].isbig)
    end
end

function VIPDrawMainView:InitView()
    self.PVRInfo = VIPDrawModel:GetInstance().PVRInfo
    local len = self.go_table.obj_items:GetChildCountE()

    local r = Mathf.Sqrt(Mathf.Pow(57, 2) + Mathf.Pow(189, 2))

    for i = 1, len do
        local cos = Mathf.Cos(math.rad((len - (i - 1)) * 36 + 72))
        local sin = Mathf.Sin(math.rad((len - (i - 1)) * 36 + 72))

        local x = r * cos
        local y = r * sin

        local parent = self.go_table.obj_items:GetChildE(i - 1)
        parent:SetLocalPosition(x, y, 0)

        self:CreatItem(self.PVRInfo[i].data, parent, i)

        local bigsige = self.go_table.obj_bigjls:GetChildE(i - 1)
        _G.GameUtil.SetActiveByCondition(bigsige, self.PVRInfo[i].isbig)
    end
end

function VIPDrawMainView:ShowTimes()
    local times = self.ChangeNums[self.ChangeNumIndex]
    self.go_table.aortext_changenum.text = "x" .. times
    local id, num = VIPDrawModel:GetInstance():GetDrawNeedNum()
    local hasNum = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.ResProp, id)
    self.go_table.aortext_PropNum.text = num * times
    if hasNum >= num * times then
        self.go_table.aortext_PropNum.color = require "CardInfoManager".GetColorFromRGB("FFFFFF")
    else
        self.go_table.aortext_PropNum.color = require "CardInfoManager".GetColorFromRGB("FF0000")
    end
end

function VIPDrawMainView:ShowNeedCount()
    self.go_table.aortext_needdrawtimes.text = _G.GetLangPackValue(90033403002,
        VIPPrivilegeModel:GetInstance().need_count)
end

---创建奖励物品
function VIPDrawMainView:CreatItem(data, Parent, key)
    if _G.IsNil(Parent) or Parent:GetctiveInHierarchy() == 0 then
        return
    end
    if not self.awarditem then
        self.awarditem = {}
    end
    if not self.awarditem[key] then
        self.awarditem[key] = require "BaseAwardNewItem".New(Parent, nil, 88)
    end
    self.awarditem[key]:ShowWithID(
        data,
        nil,
        function()
            self.awarditem[key].item.gameObject:SetActiveE(1)
            self.awarditem[key].item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            if self.awarditem[key].item.SetGradeNew then
                self.awarditem[key].item:SetGradeNew(true)
            end
            self.awarditem[key].item.hideColor = true
            self.awarditem[key].item:HideColor()
        end
    )
end

function VIPDrawMainView:OnDrawFail()
    self.Drawing = false
end

function VIPDrawMainView:OnDrawFinish()

end

function VIPDrawMainView:OnUIOpened(name)
    if name == _G.ConfigManager.ui_cfg.VIPDrawLimitView.Name then
        local canvas = self.go_table.obj_BottomBar:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
        _G.UIManager:GetInstance():ChangeCanvasOrder(name, canvas.sortingOrder - 5)
    elseif name == _G.ConfigManager.ui_cfg.VIPDrawShopView.Name then
        local canvas = self.go_table.obj_BottomBar:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
        _G.UIManager:GetInstance():ChangeCanvasOrder(name, canvas.sortingOrder - 5)
    end
end

function VIPDrawMainView:ChangeView(name)
    if name == self.curView.Name then
        return
    end
    local UIManager = _G.UIManager:GetInstance()
    local canvas = self.go_table.obj_BottomBar:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))

    local view = UIManager:OpenWindow(name)
    local icon = self.go_table[self.ToggleDic[name]]:FindE("Icon"):GetComponentE(_G.typeof(_G.CS.AorImage))
    local nowIcon =
        self.go_table[self.ToggleDic[self.curView.Name]]:FindE("Icon"):GetComponentE(_G.typeof(_G.CS.AorImage))
    local bg = self.go_table[self.ToggleDic[name]]:GetComponentE(_G.typeof(_G.CS.AorImage))
    local nowBg = self.go_table[self.ToggleDic[self.curView.Name]]:GetComponentE(_G.typeof(_G.CS.AorImage))
    bg.SpriteName = "ui_ty_gn_c_frame"
    nowBg.SpriteName = "ui_ty_gn_frame"
    icon.SpriteName = self.IconDic[name] .. "_c_icon"
    nowIcon.SpriteName = self.IconDic[self.curView.Name] .. "_n_icon"
    -- if view.LayerSorting >= canvas.sortingOrder then
    --     view.LayerSorting = canvas.sortingOrder - 5
    -- end

    if self.curView.Name ~= self.WindowName.Main and name ~= self.curView.Name then
        UIManager:HideWindow(self.curView.Name)
    end
    self.curView = view
end

---按钮点击事件在这里派发
function VIPDrawMainView:OnClickBtn(go, isOn)
    local UIManager = _G.UIManager:GetInstance()
    local name = go:GetName()
    if go == self.go_table.aorbtn_close then
        self:Close()
        for _, window in pairs(self.WindowName) do
            local view = UIManager:GetWindow(window)
            if view then
                UIManager:CloseWindow(window)
            end
        end
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 178)
    elseif go == self.go_table.aorbtn_main then
        self:ChangeView(self.WindowName.Main)
    elseif go == self.go_table.aorbtn_limit then
        self:ChangeView(self.WindowName.Limit)
    elseif go == self.go_table.aorbtn_exchange then
        self:ChangeView(self.WindowName.Exchange)
    elseif go == self.go_table.aorbtn_changenum then
        ---更换抽奖次数
        self.ChangeNumIndex = self.ChangeNumIndex + 1
        if self.ChangeNumIndex > 4 then
            self.ChangeNumIndex = 1
        end
        self:ShowTimes()
    elseif go == self.go_table.aorbtn_cj then
        if self.Drawing then
            return
        end

        if not VIPPrivilegeModel:GetInstance().IsMaxExp then
            _G.PopWindowManager:GetInstance():ShowAllTips(1080104)
            return
        end

        local times = self.ChangeNums[self.ChangeNumIndex]
        local id, num = VIPDrawModel:GetInstance():GetDrawNeedNum()
        local hasNum = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.ResProp, id)


        if hasNum < num * times then
            _G.PopWindowManager:GetInstance():ShowAllTips(1080102)
            return
        end

        self.Drawing = true

        ---抽奖
        VIPDrawModel:GetInstance():Draw(times, function(msg)
            self.AnimComponent.enabled = false
            self.AnimComponent.enabled = true
            self.AnimComponent:Play("ani_VIPDrawMainView_bao")

            local bigids = {}
            for i = 1, #self.PVRInfo do
                if self.PVRInfo[i].isbig then
                    table.insert(bigids, self.PVRInfo[i].data)
                end
            end

            local goldEffect = _G.ConfigManager.ui_effect_cfg.ef_VipDraw_purple
            local goldBoomEffect = _G.ConfigManager.ui_effect_cfg.ef_VipDraw_purpleboom

            local itemBigIndex = 0

            for i = 1, #msg.award.item do
                for j = 1, #bigids do
                    if bigids[j][1] == msg.award.item[i].type[1] and bigids[j][2] == msg.award.item[i].type[2] then
                        goldEffect = _G.ConfigManager.ui_effect_cfg.ef_VipDraw_gold
                        goldBoomEffect = _G.ConfigManager.ui_effect_cfg.ef_VipDraw_goldboom
                        break
                    end
                end
                for j = 1, #self.PVRInfo do
                    if self.PVRInfo[j].data[1] == msg.award.item[i].type[1] and self.PVRInfo[j].data[2] == msg.award.item[i].type[2] and self.PVRInfo[j].isbig then
                        itemBigIndex = j
                        break
                    end
                end
            end

            local tempitems = {}
            local itemIndex = 0
            local iteminfo = msg.award.item[#msg.award.item]
            for j = 1, #self.PVRInfo do
                if self.PVRInfo[j].data[1] == iteminfo.type[1] and self.PVRInfo[j].data[2] == iteminfo.type[2] then
                    itemIndex = j
                    break
                end
            end

            if itemBigIndex > 0 then
                itemIndex = itemBigIndex
            end
            for k = itemIndex, #self.PVRInfo do
                table.insert(tempitems, self.PVRInfo[k])
            end
            for l = 1, itemIndex do
                table.insert(tempitems, self.PVRInfo[l])
            end

            self:ShowBigAwardLock(tempitems)

            _G.UIUtils.LoadEffectByCfg(
                goldEffect,
                self.go_table.obj_items,
                function(obj)
                    if _G.IsNil(self.go_table) then
                        _G.UIUtils.RemoveEffect(obj)
                        return
                    end
                end
            )

            self.boomEffCor = _G.DelayDo(2, function()
                _G.UIUtils.LoadEffectByCfg(
                    goldBoomEffect,
                    self.go_table.obj_items,
                    function(obj)
                        if _G.IsNil(self.go_table) then
                            _G.UIUtils.RemoveEffect(obj)
                            return
                        end
                    end, function()
                        self:ShowNeedCount()
                        _G.UIManager:GetInstance():OpenWindow(
                            _G.ConfigManager.ui_cfg.CommonAwardView.Name,
                            msg,
                            function()
                            end
                        )

                        _G.StorageManager:GetInstance():ConsumeItem(id, nil, num * times)
                        self:ShowTimes()

                        RedPointManager:GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg
                            .LotteryExchange.id)
                        --if isTen then
                        _G.PlayerPrefsManager.SetInt("VIPDrawTenTimes", 1)
                        --end
                        RedPointManager:GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.LotteryPremium.id)

                        self.Drawing = false
                    end
                )
            end)
        end)
    end
end

function VIPDrawMainView:OnStartClose()
    if self.boomEffCor then
        _G.coroutine.stopwaiting(self.boomEffCor)
        self.boomEffCor = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
end

---@private
function VIPDrawMainView:OnDestroy()
end

return VIPDrawMainView
