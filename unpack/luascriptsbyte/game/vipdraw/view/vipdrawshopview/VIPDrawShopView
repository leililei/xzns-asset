    if self.bubbleTimer ~= nil then
        self.bubbleTimer:Stop()
    end
    if self.Timer ~= nil then
        self.Timer:Stop()
    end
    if self.SPTimer ~= nil then
        self.SPTimer:Stop()
    end
    self.SPTimer = nil
    self.bubbleTimer = nil
    self.timer = nil
    self.Timer = nil
