---初始化界面
function VIPDrawShopView:InitView()
    local RedPointManager = require("RedPointManager"):GetInstance()
    self.CurShopTime = 0
    self.Shop = self.model:GetShop()
    self.go_table.aortext_limit.text = _G.GetLangPackValue(90021600070,
        self.Shop[self.CurShopID].count_refresh - self.Shop[self.CurShopID].RefreshCount)
    ---如果停留在赛季商店 并且赛季正在结算中 等待六点刷新 如果六点刷新赛季未开  则默认第一个商店
    if self.Shop[self.CurShopID].type == 2 then
        if not require "SeasonModel":GetInstance():CheckSeasonIsOpen() then
            self.init = nil
            self.CurShopID = 1
        end
    elseif self.Shop[self.CurShopID].type == 3 then
        if require "ArenaPeakModel":GetInstance():GetSettlementTime() > 0 then
            self.init = nil
            self.CurShopID = 1
            _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.ArenaPeak)
        end
    elseif self.Shop[self.CurShopID].type == 4 then
        if _G.TimeUtil.GetServerUnixTime() - require "SpiritualRealmModel":GetInstance():GetEndTime() > 0 then
            self.init = nil
            self.CurShopID = 1
            _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.SpiritualRealm)
        end
    end
    local ShopFirstUnlock = _G.PlayerPrefsManager.GetInt("ShopFirstUnlock" .. self.CurShopID)
    if ShopFirstUnlock == 0 then
        _G.PlayerPrefsManager.SetInt("ShopFirstUnlock" .. self.CurShopID, 1)
    end

    --未激活的标签页, 不加入列表
    self.pageList = {}
    for _, page in ipairs(self.model:GetShopList() or {}) do
        local list = {}
        for _, order in ipairs(page.list) do
            if order.show then
                table.insert(list, order)
            end
        end
        if #list > 0 then
            local newPage = _G.GlobalInterface.GetNewTable(page) --浅复制
            newPage.list = list
            newPage.oldTab = newPage.tab
            newPage.tab = #self.pageList + 1
            table.insert(self.pageList, newPage)
        end
    end

    -- if self.CurShopID == 3 then
    --     RedPointManager:RefreshNode(_G.ConfigManager.redpoint_cfg.ArenaSeniorShop.id)
    -- end
    -- if self.timer ~= nil then
    --     self.timer:Stop()
    --     self.timer = nil
    -- end
    -- local resource = self.ShopCfg[self.CurShopID].currency_bar
    -- if self.CurShopID == 9 then
    --     if not self.curSubTab then
    --         self.curSubTab = 1
    --     end
    --     resource = { 60 + self.curSubTab }
    -- end
    -- self.resource:RestRs(resource)
    if self.Shop[self.CurShopID].type == 2 then
        local time = require "SeasonModel":GetInstance():GetTime()
        self.CurShopTime = time.settlementTime - _G.TimeUtil.GetServerUnixTime()
    elseif self.Shop[self.CurShopID].type == 3 then
        local time = require "ArenaPeakModel":GetInstance():GetSettlementStartTime()
        self.CurShopTime = time - _G.TimeUtil.GetServerUnixTime()
    elseif self.Shop[self.CurShopID].type == 4 then
        local time = require "SpiritualRealmModel":GetInstance():GetEndTime()
        self.CurShopTime = time - _G.TimeUtil.GetServerUnixTime()
    else
        self.CurShopTime =
            (self.Shop[self.CurShopID].time + self.Shop[self.CurShopID].interval_time) - _G.TimeUtil.GetServerUnixTime()
    end
    --  _G.GameUtil.SetActiveByCondition(self.go_table.aortext_Timer, self.CurShopTime > 0)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_refresh, self.ShopCfg[self.CurShopID].count_refresh > 0)
    if self.CurShopTime > 0 then
        self:TimerUpdata(0)
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.TimerUpdata, self, false, false, true)
        self.timer:Start()
    end

    if not self.init then
        self:SetPage()
    end
    self.commendLis = {}
    self:SetGoods()

    self.go_table.scrollloophorizontal_Page:SetActiveE(0)
    self.go_table.aorrawimage_bubble:SetActiveE(0)
    --self:ShwoBubble()

    --软更新红点状态
    self.model:UpdateRedPointStates(self.CurShopID, false, true)

    if self.CurShopID == 2 then
        -- 公会商店
        -- 公会sp商品下方增加刷新倒计时，将除sp商品以外的向下移动，@_obj_ListContent高度同时增加
        local _, heigth = self.go_table.obj_ListContent:GetRectTransformSize()
        self.go_table.obj_ListContent:SetRectTransformSize(0, heigth + GuildSPItemTipInterval)
        local _, itemHeigth = self.go_table.obj_ListItem:GetRectTransformSize()
        local y = _G.math.ceil(#self.Shop[self.CurShopID].SPitem / 2) * itemHeigth
        self.go_table.obj_guildSPTip:SetLocalPosition(0, -y - GuildSPItemTipInterval - 18, 0)
        self.go_table.obj_guildSPTip:SetActiveE(1)
        self:GuildSPTipUpdate()
        if self.SPTimer then
            self.SPTimer:Stop()
            self.SPTimer = nil
        end
        self.SPTimer = _G.TimerManager:GetInstance():GetTimer(1, self.GuildSPTipUpdate, self)
        self.SPTimer:Start()
    else
        if self.SPTimer then
            self.SPTimer:Stop()
            self.SPTimer = nil
        end
        self.go_table.obj_guildSPTip:SetActiveE(0)
    end
end

function VIPDrawShopView:ShwoBubble()
    if self.bubbleTimer ~= nil then
        self.bubbleTimer:Stop()
    end
    if self.Timer ~= nil then
        self.Timer:Stop()
    end
    self.bubbleTimer = nil
    self.Timer = nil
    self.go_table.aorrawimage_bubble:SetActiveE(1)
    self.curBubbles = _G.DeepCopyCfgTable(self.Shop[self.CurShopID].bubble_chat)
    self:PlayBubbleDialog(true)
    self.bubbleTimer =
        _G.TimerManager:GetInstance():GetTimer(
            self.Shop[self.CurShopID].bubble_continuous + self.Shop[self.CurShopID].bubble_hidden,
            self.PlayBubbleDialog,
            self
        )
    self.bubbleTimer:Start()
end

function VIPDrawShopView:PlayBubbleDialog(isFirst)
    local afk_cfg = _G.ConfigManager.afk_cfg
    if self.Timer then
        self.Timer:Stop()
        self.Timer = nil
    end
    local languageStr
    self.BubbleRect:SetLocalScaleXYZ(0)
    self.BubbleRect:DOScale(1, 1, 1, 0.4)
    local curAfkSid = AfkModelIns:GetLastSection()
    if isFirst then
        if self.Shop[self.CurShopID].curLevel and self.Shop[self.CurShopID].curLevel > curAfkSid then
            local section = afk_cfg[self.Shop[self.CurShopID].curLevel].section
            local chapter = afk_cfg[self.Shop[self.CurShopID].curLevel].chapter
            languageStr = GetLangPackValue(self.Shop[self.CurShopID].bubble_upgrade, chapter, section)
        else
            languageStr = GetLangPackValue(self.Shop[self.CurShopID].bubble_end)
        end
    else
        if #self.curBubbles == 0 then
            self.curBubbles = _G.DeepCopyCfgTable(self.Shop[self.CurShopID].bubble_chat)
        end
        local random = math.random(1, #self.curBubbles)
        languageStr = GetLangPackValue(_G.table.remove(self.curBubbles, random))
    end
    self.go_table.aortext_bubble.text = languageStr
    self.Timer =
        _G.TimerManager:GetInstance():GetTimer(self.Shop[self.CurShopID].bubble_continuous, self.GetTimerCallBack, self)
    self.Timer:Start()
end

function VIPDrawShopView:GetTimerCallBack()
    self.BubbleRect:DOScale(0, 0, 0, 0.4)
end

---自动刷新 == 刷新当前页面
function VIPDrawShopView:TimerUpdata(elapsed)
    if not self.go_table then
        return
    end
    self.CurShopTime = self.CurShopTime - elapsed
    if self.CurShopTime > 86400 then
        self.go_table.aortext_Timer.text =
            GetLangPackValue(90000000988) ..
            GetLangPackValue(
                90022100001,
                _G.math.floor(_G.Mathf.RoundToInt(self.CurShopTime) / 86400),
                _G.math.floor((_G.Mathf.RoundToInt(self.CurShopTime) % 86400) / 3600)
            )
    elseif self.CurShopTime <= 0 then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        if self.Shop[self.CurShopID].type == 2 then
            self.go_table.aortext_Timer.text = GetLangPackValue(90000000988) .. GetLangPackValue(90000010091)
        else
            self.go_table.aortext_Timer.text = GetLangPackValue(90000000988) .. GetLangPackValue(90021800086, 0, 0)
        end
    else
        local t = _G.TimeUtil.TranslateSecond(_G.Mathf.RoundToInt(self.CurShopTime))
        if t.hour > 0 then
            self.go_table.aortext_Timer.text = GetLangPackValue(90000000988) .. _G.GetLangPackValue(90021600072, t.hour, t.min)
        else
            self.go_table.aortext_Timer.text = GetLangPackValue(90000000988) .. _G.GetLangPackValue(90000011449, t.min)
        end
    end
end

