function VIPDrawShopView:SetGoods()
    self.GoodsList = self.Shop[self.CurShopID].item
    ---联赛商店根据货币类型显示商品
    if self.CurShopID == 9 then
        if not self.curSubTab then
            self.curSubTab = 1
        end
        local type = 60 + self.curSubTab
        local goods = self.GoodsList
        self.GoodsList = _G.table.chooseToArray(goods, function(_, v)
            return v.cfg.currency_type == type
        end)
    end
    if self.CurShopID ~= 6 then
        ---不要对五行商店进行sid排序(_G.SortList使用table.sort快速排序, 比较值相同时不能按照输入顺序输出)
        _G.SortList(
            self.GoodsList,
            function(a)
                --是否售罄
                local soldout = a.BuyTime > 0 and a.BuyTime >= a.limit and 0 or 1
                --是否sp
                -- local sp = a.sp and 1 or 0
                local index = a.index
                --是否锁定
                local lock = (a.condition and self:IsUnlock(a.condition)) and 0 or 1
                -- 策划要求sp商品置顶，且不随售罄与否改变位置
                if a.sp then
                    return 1, 0, lock, -index
                else
                    return 0, soldout, lock, -index
                end
            end
        )
        -- elseif self.CurShopID ~= 2 and self.CurShopID ~= 6 then
        --     -- -不确定为啥要加这个排序，但是现在策划说去掉(现在)
        --     _G.SortList(
        --         self.GoodsList,
        --         function(a)
        --             if a.condition then
        --                 local con = self:IsUnlock(a.condition) and 1 or 0
        --                 local res = a.BuyTime >= a.limit and 0 or 1
        --                 if a.limit < 0 then
        --                     res = -1
        --                 end
        --                 return res, -con, -a.sid
        --             else
        --                 local res = a.BuyTime > 0 and 0 or 1
        --                 return res, -a.sid
        --             end
        --         end
        --     )
    end

    local function Refresh()
        if self:IsNil() then
            return
        end
        if not self.shopCount then
            self.go_table.scrollloopvectical_ItemList:InitItemData(
                #self.GoodsList,
                _G.handler(self, self.RefreshGoodsListChoose)
            )
            self.shopCount = #self.GoodsList
        else
            self.go_table.scrollloopvectical_ItemList:UpdateCount(#self.GoodsList)
            self.shopCount = #self.GoodsList
        end
        self.go_table.scrollloopvectical_ItemList:ScrollToTop()
        if self.shopCount > 12 then
            self.go_table.scrollloopvectical_ItemList:DetectingSlippage(_G.handler(self, self.onValueChanged))
        else
            self.go_table.scrollloopvectical_ItemList:DetectingSlippage()
        end
        if self.CurShopID == 9 and not self.spiritualRealmInit then
            local index = require("SpiritualRealmModel"):GetInstance():GetShopJumpIndex()
            self.go_table.scrollloopvectical_ItemList:ScrollToIndex(index - 1)
            self.spiritualRealmInit = true
        end
    end
    if self.CurShopID == 7 and not self.peakInit then
        require("ArenaPeakModel"):GetInstance():RefreshRankNum(Refresh)
        self.peakInit = true
    else
        Refresh()
    end
end

