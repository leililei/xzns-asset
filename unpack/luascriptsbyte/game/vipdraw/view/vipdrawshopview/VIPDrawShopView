---刷新单个货物
function VIPDrawShopView:RefreshGoodsList(index, obj)
    if index < 0 then
        return
    end
    local x = index + 1
    ---@type VIPDrawShopView._obj_ListItem_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnGoodsClick, x))
    local data = self.GoodsList[x]
    obj:SetName(x)
    tb.data = data

    if not data then
        return
    end
    local CreateItem = function(item, parent)
        local type
        local cfg
        local sid
        local count
        local element
        if item then
            sid = item[1]
            count = item[2]
            element = item[3]
            local array = { [1] = sid, [2] = count, [3] = element }
            type = _G.StorageManager:GetInstance():CheckSidType(sid)
            cfg = _G.ConfigManager.item_cfg[sid]
            if
                type == _G.StorageType.Prop and cfg and cfg.Type1 and cfg.Type1 == 6 and
                _G.ConfigManager.card_cfg[_G.tonumber(cfg.UseParameter[1][2])]
            then
                _G.ItemFactory:GetInstance():GetItemCard(
                    _G.ItemFactory.itemType.ItemDebrisBase,
                    parent,
                    function(trans)
                        if not cfg then
                            _G.DestroyObject(trans.go_table.gameObject)
                            return
                        end
                        trans:Show(sid, nil, count)
                        local HideEffect = false
                        if self.CurShopID == 6 and data.Restrict[1] and data.Restrict[1][1] == 1 then
                            local delta = data.Restrict[1][3] - require("SeasonModel"):GetInstance():GetTotalCoin()
                            HideEffect = delta > 0
                        end
                        if trans.SetGradeNew then
                            trans:SetGradeNew(HideEffect)
                        end
                    end
                )
            else
                _G.StorageManager:GetInstance():GetItemBaseViewNew(
                    array,
                    parent,
                    function(trans)
                        trans.sid = sid
                        trans.gameObject:SetLocalPosition(0, 0, 0)
                        if array[2] then
                            trans:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                        end
                        local HideEffect = false
                        if self.CurShopID == 6 and data.Restrict[1] and data.Restrict[1][1] == 1 then
                            local delta = data.Restrict[1][3] - require("SeasonModel"):GetInstance():GetTotalCoin()
                            HideEffect = delta > 0
                        end
                        if type == _G.StorageType.Debris then
                            HideEffect = true
                        end
                        if trans.SetGradeNew then
                            trans:SetGradeNew(HideEffect)
                        end
                        if type == _G.StorageType.Equipment then
                            local haveRedPoint = false
                            if self.model:IsItemRedPoint(self.CurShopID, tb.data.index) then
                                if self.commendCards == nil then
                                    self.commendCards = require("CardResonanceModel"):GetInstance():GetAllPosCards()
                                end
                                local list = self.commendLis
                                list[x] = require("EquipmentModel"):GetInstance():GetCommendCardsBySidAndEle(
                                    sid,
                                    element,
                                    self.commendCards
                                )
                                haveRedPoint = #list[x] > 0
                            end
                            trans:RefreshRedPoint(haveRedPoint)
                        end
                    end,
                    function(go)
                        require("CommonTipManager"):GetInstance():OpenTip(parent, go.sid or go[1].sid)
                    end
                )
            end
        end
    end
    tb.aortext_MaterialNum.text = _G.GameUtil.NumberToShopPrice(data.price)
    tb.aortext_itemname.text = data.name
    tb.obj_sp:SetActiveE(data.sp and 1 or 0)
    local grade = data.Grade
    local itemType
    local sid = 0
    if data.cfg.item then
        sid = data.cfg.item[1]
    else
        sid = data.ItemCfg.ID or data.ItemCfg.id
    end
    itemType = _G.StorageManager:GetInstance():CheckSidType(sid)

    -- if data.ItemCfg and data.ItemCfg.ID  then
    --     itemType = _G.StorageManager:GetInstance():CheckSidType(data.ItemCfg.ID)

    -- elseif data.ItemCfg and data.ItemCfg.sid  then
    --     itemType = _G.StorageManager:GetInstance():CheckSidType(data.ItemCfg.sid)

    -- end
    tb.aortext_itemname.color = _G.GameUtil.GetColorByQualityNewH5(itemType, grade)
    if data.currencyIcon then
        tb.aorrawimage_Material.Alpha = 0
        tb.aorrawimage_Material:LoadImage(data.currencyIcon)
    end
    tb.obj_ArenaPeak:SetActiveE(0)
    tb.obj_Limit:SetActiveE(1)

    tb.aortext_limitTip.text = _G.GetLangPackValue(self.itemLimitTip[self.CurShopID] or 90021800098)
    tb.obj_Lock:SetActiveE(0)
    tb.obj_seasonTip:SetActiveE(0)
    tb.aortext_spCon:SetActiveE(0)

    if not _G.table.isEmptyOrNil(data.conditions) then
        local lockBol, tipsID, content = _G.GlobalConditionManager.CheckConditionArrays(data.conditions)
        if data.conditions[1][1] == 58 then
            content = _G.GetLangPackValue(90021600068,
                _G.GetLangPackValue(_G.ConfigManager.guild_unit_cfg[_G.math.modf(data.conditions[1][2] / 10000)].name),
                data.conditions[1][2] % 10000)
        elseif data.conditions[1][1] == 50 then
            content = _G.GetLangPackValue(90021600083, data.conditions[1][2])
        end
        if data.sp then
            tb.aortext_spCon.text = content
            tb.aortext_spCon:SetActiveE(lockBol and 0 or 1)
            tb.obj_Lock:SetActiveE(lockBol and 0 or 1)
            tb.obj_Limit:SetActiveE(lockBol and 1 or 0)
        end
    end

    --神器显示专属角色角标
    local exclusiveCardCfg = nil
    if itemType == _G.StorageType.Artifact then
        local artifactCfg = _G.ConfigManager.artifact_cfg[data.cfg.item[1]]
        local CardCfg = _G.ConfigManager.card_cfg
        if artifactCfg then
            exclusiveCardCfg = CardCfg[artifactCfg.card_id] and CardCfg[artifactCfg.card_id] or nil
            if exclusiveCardCfg ~= nil then
                tb.aorimage_exclusiveIcon.SpriteName = exclusiveCardCfg.Icon
            end
        end
    end
    tb.aorimage_exclusiveRole:SetActiveE((itemType == _G.StorageType.Artifact and exclusiveCardCfg ~= nil) and 1 or 0)

    if data.cfg.item ~= nil then
        tb.obj_itemRoot:ClearChildren()
        CreateItem({ data.cfg.item[1], data.count, data.cfg.item[3] }, tb.obj_itemRoot)
        _G.GameUtil.SetActiveByCondition(tb.obj_SellOut, data.BuyTime > 0)
        local limitBol = 0
        if data.limit > 0 then
            if data.limit <= data.BuyTime then
                limitBol = 1
            end
            tb.aortext_num.text = data.limit - data.BuyTime
        end
        tb.obj_Limit:SetActiveE(data.limit > 0 and 1 or 0)
        if not _G.table.isEmptyOrNil(data.conditions) then
            local lockBol, tipsID, content = _G.GlobalConditionManager.CheckConditionArrays(data.conditions)
            if data.conditions[1][1] == 58 then
                content = _G.GetLangPackValue(90021600068,
                    _G.GetLangPackValue(_G.ConfigManager.guild_unit_cfg[_G.math.modf(data.conditions[1][2] / 10000)]
                        .name), data.conditions[1][2] % 10000)
            end
        end
        tb.obj_SellOut:SetActiveE(limitBol)
    else
        tb.obj_itemRoot:ClearChildren()
        local itemId = data.ItemCfg.ID or data.ItemCfg.id
        CreateItem({ itemId, data.count }, tb.obj_itemRoot)
        if data.limit > 0 then
            tb.obj_Limit:SetActiveE(data.limit > data.BuyTime and 1 or 0)
            tb.aortext_num.text = data.limit - data.BuyTime
            tb.obj_SellOut:SetActiveE(data.limit <= data.BuyTime and 1 or 0)
        end


        -- body
        if self.CurShopID == 7 or self.CurShopID == 9 then
            if data.tag and data.tag == 1 then
                tb.aorimage_tag:SetActiveE(1)
            end

            local guo = true
            if data.condition and data.condition[1] then
                if data.condition[1] == 4 then
                    local Cfg = _G.ConfigManager.item_cfg[data.ItemCfg.ID]
                    local cfg = tonumber(Cfg.UseParameter[1][1])
                    local ID = _G.ConfigManager.skin_cfg[cfg]
                    if require "CardCommentManager":GetInstance():CradSid(ID.card, cfg) then
                        tb.obj_SellOut:SetActiveE(1)
                        guo = false
                    end
                end
            end
            if guo and data.Restrict[1] ~= nil then
                local unlock, tip = require("ShopModel"):GetInstance():CheckShopItemUnlock(self.CurShopID, data, true)
                if not unlock then
                    tb.aortext_name.text = tip
                    tb.obj_ArenaPeak:SetActiveE(1)
                    tb.obj_Limit:SetActiveE(0)
                    _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnSkinClick, x))
                end
            end
        elseif self.CurShopID == 6 then
            ---赛季商店
            if data.Restrict[1] ~= nil then
                if data.Restrict[1][1] == 1 then
                    local delta = data.Restrict[1][3] - require("SeasonModel"):GetInstance():GetTotalCoin()
                    if delta > 0 then
                        tb.obj_Lock:SetActiveE(1)
                        if x % 2 == 0 then
                            tb.aortext_seasonCoinNum.text = delta
                            tb.aorrawimage_seasonIcon:LoadImage(
                                _G.StorageManager:GetInstance():GetItemIcon(data.Restrict[1][2])
                            )
                            tb.obj_seasonTip:SetActiveE(1)
                            obj:SetSiblingIndexE(self.go_table.obj_ListContent:GetChildCountE() - 1)
                        end
                    end
                end
            end
        end
    end

    if self.CurShopID == 2 then
        -- 公会商店
        -- 公会sp商品下方增加刷新倒计时，将除sp商品以外的向下移动，@_obj_ListContent高度同时增加
        if not data.sp then
            local x, y, z = obj:GetLocalPosition()
            obj:SetLocalPosition(x, y - GuildSPItemTipInterval, z)
        end
    end
    _G.GameUtil.SetActiveByCondition(tb.aorimage_discount,
        data.discount and data.discount > 0 and data.BuyTime < data.limit)
    if data.discount then
        if _G.GameUtil.GetIsUseChinese() then
            tb.aortext_discount.text = math.floor(data.discount) .. _G.GetLangPackValue(90022500788)
        else
            tb.aortext_discount.text = "-" .. (100 - (math.floor(data.discount) * 10)) .. "%"
        end
        _G.GameUtil.ReBuildRTF(tb.aorimage_discount)
    end
end

function VIPDrawShopView:IsUnlock(condition)
    if condition then
        if condition[1] == 1 then
            return _G.PlayerModel:GetInstance():IsUnlockFrame(condition[2])
        elseif condition[1] == 2 then
            return _G.PlayerModel:GetInstance():IsUnlockTitle(condition[2])
        else
            return _G.PlayerModel:GetInstance():IsUnlockHalo(condition[2])
        end
    else
        return false
    end
end

