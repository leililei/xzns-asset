---点击页签
function VIPDrawShopView:SetPage()
    local data = {}
    ---通过商店id查找显示的tab索引
    for _, v in pairs(self.pageList) do
        for order, shop in pairs(v.list) do
            if shop.shopID == self.CurShopID then
                self.order = order
                self.curPageIndex = v.tab
                data = v
                break
            end
        end
    end
    self.showData = {}
    for k, v in pairs(self.pageList) do
        if v.show then
            _G.table.insert(self.showData, v)
        end
    end
    local pageListLen = #(data.list or {})
    if not self.pageInit then
        -- self.go_table.scrollloophorizontal_Page:InitItemData(#self.showData, _G.handler(self, self.RefreshPageList))
        self:InitPageItem(#self.showData)
        self.go_table.scrollloophorizontal_YeQian:InitItemData(pageListLen, _G.handler(self, self.RefreshSubPageList))
        self.pageInit = true
    else
        self:UpdatePageItem()
        self.go_table.scrollloophorizontal_YeQian:UpdateAllItem()
    end
    if not self.InitItemList then
        -- itemlist初始大小为有副页签的大小
        self.itemListSize[1], self.itemListSize[2] = self.go_table.scrollloopvectical_ItemList:GetRectTransformSizeDelta()
        self.InitItemList = true
    end

    if pageListLen > 1 then
        self.go_table.scrollloophorizontal_YeQian:SetActiveE(1)
        self.go_table.scrollloopvectical_ItemList:SetRectTransformSize(self.itemListSize[1], self.itemListSize[2])
    else
        self.go_table.scrollloophorizontal_YeQian:SetActiveE(0)
        self.go_table.scrollloopvectical_ItemList:SetRectTransformSize(self.itemListSize[1], self.itemListSize[2] + 132)
    end

    self.init = true
end

function VIPDrawShopView:InitPageItem(count)
    self.go_table.obj_content:ClearChildren()
    self.pageItemList = {}
    for i = 1, count do
        self.pageItemList[i] = _G.InstantiateObject(self.go_table.aorbtn_Page, self.go_table.obj_content)
        self:RefreshPageList(i, self.pageItemList[i])
    end
end

function VIPDrawShopView:UpdatePageItem()
    for k, v in pairs(self.pageItemList) do
        self:RefreshPageList(k, v)
    end
end

---刷新主页签
function VIPDrawShopView:RefreshPageList(index, obj)
    if index < 0 then
        return
    end
    local newindex = index
    local tb = _G.GetAutoGoTable(obj)
    local data = self.showData[newindex]
    tb.obj_redpoint:UpdateRedPointItemIDAndParam(
        _G.ConfigManager.redpoint_cfg.Shop.id,
        self.model:GetShopFirstRedPointParam(data.list[1].shopID)
    )
    if not data.show then
        tb.gameObject:SetActiveE(0)
        return
    end
    _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnPageClick, data.tab, tb))
    --TODO 大页签图标
    -- _G.LogError("商店page图标配置")
    tb.aorimage_normal.SpriteName = data.spriteName[1]
    tb.aorimage_select.SpriteName = data.spriteName[2]
    tb.aortext_desc.text = _G.GetLangPackValue(tonumber(data.name))
    if self.curPageIndex == data.tab then
        tb.obj_select:SetActiveE(1)
        tb.obj_normal:SetActiveE(0)
        self.oldPage = tb
    else
        tb.obj_normal:SetActiveE(1)
        tb.obj_select:SetActiveE(0)
    end
end

