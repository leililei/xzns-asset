function VIPDrawShopView:OnPageClick(go, isOn, index, tb)
    local tab = self.pageList[index].tab
    if tab == self.curPageIndex then
        return
    end
    local curpage = self.pageList[index].list
    local shopId = curpage[1].shopID
    if self.Shop[shopId].type == 2 then
        if not require "SeasonModel":GetInstance():CheckSeasonIsOpen() then
            _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.SeasonNotOpen)
            return
        end
    elseif self.Shop[shopId].type == 3 then
        if require "ArenaPeakModel":GetInstance():GetSettlementTime() > 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.ArenaPeak)
            return
        end
    elseif self.Shop[shopId].type == 4 then
        if _G.TimeUtil.GetServerUnixTime() - require "SpiritualRealmModel":GetInstance():GetEndTime() > 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.SpiritualRealm)
            return
        end
    end
    self.curPageIndex = tab
    self.order = 1
    self.curSubTab = 1
    self.oldPage.obj_select:SetActiveE(0)
    self.oldPage.obj_normal:SetActiveE(1)
    tb.obj_select:SetActiveE(1)
    tb.obj_normal:SetActiveE(0)
    self.oldPage = tb
    if #curpage > 1 then
        self.go_table.scrollloophorizontal_YeQian:SetActiveE(1)
        self.go_table.scrollloopvectical_ItemList:SetRectTransformSize(self.itemListSize[1], self.itemListSize[2])
        self.go_table.scrollloophorizontal_YeQian:UpdateCount(#curpage)
    else
        self.go_table.scrollloophorizontal_YeQian:SetActiveE(0)
        self.go_table.scrollloopvectical_ItemList:SetRectTransformSize(self.itemListSize[1], self.itemListSize[2] + 132)
    end
    self.CurShopID = shopId
    self:InitView()
end

---页签点击后回调
function VIPDrawShopView:OnSubPageClick(go, isOn, index, tb, subTab)
    local isSub = false
    if index == _G.ShopID.SpiritualRealm then
        if not self.curSubTab then
            self.curSubTab = 1
        end
        if subTab == self.curSubTab then
            return
        end
        self.curSubTab = subTab
        self.order = subTab
        isSub = true
    elseif index == self.CurShopID then
        return
    end
    if self.Shop[index].type == 2 then
        if not require "SeasonModel":GetInstance():CheckSeasonIsOpen() then
            _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.SeasonNotOpen)
            return
        end
    elseif self.Shop[index].type == 3 then
        if require "ArenaPeakModel":GetInstance():GetSettlementTime() > 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.ArenaPeak)
            return
        end
    elseif self.Shop[index].type == 4 then
        if _G.TimeUtil.GetServerUnixTime() - require "SpiritualRealmModel":GetInstance():GetEndTime() > 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.SpiritualRealm)
            return
        end
    end
    self.CurShopID = index
    if index ~= _G.ShopID.SpiritualRealm then
        ---通过商店id查找显示的tab索引
        for _, v in pairs(self.pageList) do
            for order, shop in pairs(v.list) do
                if shop.shopID == self.CurShopID then
                    self.order = order
                    break
                end
            end
