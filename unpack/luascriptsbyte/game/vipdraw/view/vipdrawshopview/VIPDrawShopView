---点击货品的消息
function VIPDrawShopView:OnGoodsClick(go, isOn, index)
    local name = go:GetName()
    local item = self.GoodsList[index]
    ---赛季当前状态 不为open弹出提示
    local isSeason = require "SeasonModel":GetInstance():GetSeasonState()
    local GetSettlementTime = require "ArenaPeakModel":GetInstance():GetSettlementTime()
    if name == "@_aorbtn_Btn" then
        if not _G.table.isEmptyOrNil(item.conditions) then
            local lockBol, tipsID, content = _G.GlobalConditionManager.CheckConditionArrays(item.conditions)
            if item.sp and not lockBol then
                _G.PopWindowManager:GetInstance():ShowAllTips(tipsID, content)
                return
            end
        end
        local sid = 0
        local count = 0
        if item.cfg.item then
            sid = item.cfg.item[1]
            count = item.cfg.item[2]
        else
            sid = item.ItemCfg.ID or item.ItemCfg.id
            count = item.count
        end
        local type = self:CheckType(sid)
        local data
        if type == _G.TipType.Equipment then
            --移除红点状态
            self.model:RemoveItemRedPoint(self.CurShopID, item.index, true, true)
            --self.go_table.scrollloopvectical_ItemList:UpdateAllItem()
            -- self.go_table.scrollloopvectical_ItemList:UpdateItemSingle(index - 1)

            data = require "EquipmentTipModel".New()
            data:Init(sid)
            -- 向 data 中添加当前点击装备item 的五行数据
            data.equip.element = item.cfg.item[3]
        elseif type == _G.TipType.Decoration then
            data = _G.StorageManager:GetInstance():GetItemDataClass(sid, 1)
        elseif type == _G.TipType.Prop or type == _G.TipType.ResProp then
            data = require "TipBaseModel".New()
            data:Init(sid, go)
            if data.cfg.Type1 then
                if GiftID[data.cfg.Type1] or giftUseType[data.cfg.UseType] then
                    type = _G.TipType.Gift
                end
            end
        elseif type == _G.TipType.Artifact then
            data = require "ArtifactTipModel".New()
            data:Init(sid, nil, go)
        elseif type == _G.TipType.Spiritual then
            data = require "SpiritualTipModel".New()
            data:Init(sid, nil, go)
        end
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ShopItemTipsView.Name,
            type,
            item,
            data,
            function(count, call)
                if self.Shop[self.CurShopID].function_open == 158 and not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(158) then
                    _G.PopWindowManager:GetInstance():ShowAllTips(4104)
                    return
                end

                if self.Shop[self.CurShopID].type == 2 then
                    if isSeason ~= _G.SeasonState.Open then
                        if call then
                            call(false)
                        end
                        _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.SeasonNotOpen)
                        return
                    end
                elseif self.Shop[self.CurShopID].type == 3 then
                    if item.BuyTime >= item.limit then
                        if call then
                            call(false)
                        end
                        _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.NotItem)
                        return
                    elseif GetSettlementTime > 0 then
                        if call then
                            call(false)
                        end
                        _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.ArenaPeak)
                        return
                    end
                elseif self.Shop[self.CurShopID].type == 4 then
                    if item.BuyTime >= item.limit then
                        if call then
                            call(false)
                        end
                        _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.NotItem)
                        return
                    end
                elseif item.limit then
                    if item.BuyTime >= item.limit then
                        if call then
                            call(false)
                        end
                        _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.NotItem)
                        return
                    end
                elseif item.BuyTime > 0 then
                    if call then
                        call(false)
                    end
                    _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.NotItem)
                    return
                end
                if not _G.StorageManager:GetInstance():CheckIsFullBySid(sid, count) then
                    require("ShopModel"):GetInstance():BuyItem(
                        self.CurShopID,
                        item,
                        count,
                        function()
                            if call then
                                call(true)
                            end
                            _G.AudioManager.PlayAudioByAudioCfgID(2013)
                            self:InitView()
                        end
                    )
                else
                    if call then
                        call(false)
                    end
                    _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.BagMax)
                    return
                end
            end,nil,
            self.commendLis[index]
        )
    elseif name == "@_aorbtn_mask" then
        local sid = 0
        if item.cfg.item then
            sid = item.cfg.item[1]
        else
            sid = item.ItemCfg.ID or item.ItemCfg.id
        end
        require "CommonTipManager":GetInstance():OpenTip(go, sid)
    end
end

