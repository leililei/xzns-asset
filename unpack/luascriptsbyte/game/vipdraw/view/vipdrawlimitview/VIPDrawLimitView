---初始化页面
function VIPDrawLimitView:UpdateView()
    ---@type player_vip_shop_cfg
    local cfg = self.CurVIPInfo.cfg
    local name = ""
    for i = 1, #cfg.goods do
        ---@type season_shop_cfg
        local sscfg = _G.ConfigManager.season_shop_cfg[cfg.goods[i]]
        local id = sscfg.get_item[1]
        local num = sscfg.get_item[2]
        ---@type item_cfg
        local itemcfg = _G.ConfigManager.item_cfg[id]
        --10-皮肤激活；12-头像框激活；13-称号激活；26-聊天框
        if itemcfg.UseType == 10 then
            self.skinId     = tonumber(itemcfg.UseParameter[1][1])
            self.skinGoodId = cfg.goods[i]
            self.skinDesc   = cfg.description[i]
            self.skinOff    = cfg.offset[i]
            --self.go_table.obj_redpointrole:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.LotteryExchange.id, self.skinGoodId)
        elseif itemcfg.UseType == 12 then
            self.frameId     = tonumber(itemcfg.UseParameter[1][1])
            self.frameGoodId = cfg.goods[i]
            self.frameDesc   = cfg.description[i]
            self.frameOff    = cfg.offset[i]
            --self.go_table.obj_redpointtx:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.LotteryExchange.id, self.frameGoodId)
        elseif itemcfg.UseType == 13 then
            self.titleId     = tonumber(itemcfg.UseParameter[1][1])
            self.titleGoodId = cfg.goods[i]
            self.titleDesc   = cfg.description[i]
            self.titleOff    = cfg.offset[i]
            --self.go_table.obj_redpointch:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.LotteryExchange.id, self.titleGoodId)
        elseif itemcfg.UseType == 26 then
            self.chatId     = tonumber(itemcfg.UseParameter[1][1])
            self.chatGoodId = cfg.goods[i]
            self.chatDesc   = cfg.description[i]
            self.chatOff    = cfg.offset[i]
            --self.go_table.obj_redpointlt:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.LotteryExchange.id, self.chatGoodId)
        else
            if _G.AppSetting.DEBUG then
                _G.LogError(cfg.goods[i], "未匹配到VIP限定商品对应的使用类型")
            end
        end
        name = _G.StorageManager:GetInstance():GetItemName(sscfg.need_item[1])
    end

    self.go_table.aortext_tips.text = _G.GetLangPackValue(90033403007, name)

    self:SapwnTitle()
    self:CreateSpine()
    self:UpdateTopShow()
    self:UpdateChatShow()
end

---生成称号
---@param item table
function VIPDrawLimitView:SapwnTitle()
    if not self.titleId then
        return
    end
    local titleScale = _G.ConfigManager.discrete_cfg[100111] and _G.ConfigManager.discrete_cfg[100111][1][1] or 1
    local player_title = _G.ConfigManager.player_title_effect_cfg[self.titleId]
    if player_title.type_title == 1 then
        self.go_table.aorrawimage_title:LoadImage(player_title.title)
        self.go_table.aorrawimage_title:SetActiveE(1)
        self.go_table.aorrawimage_title:SetLocalScaleXYZ(0.29 * titleScale)
        self.go_table.obj_titleEffect:RemoveAllChildren()
        self.curShowEffTitle = nil
    elseif player_title.type_title == 2 then
        if self.curShowEffTitle ~= player_title.title then
            self.go_table.obj_titleEffect:RemoveAllChildren()
            self.curShowEffTitle = player_title.title
            UIUtils.LoadEffectTitleOrFrame(
                player_title.title,
                self.go_table.obj_titleEffect,
                function(trans)
                    if self.curShowEffTitle ~= player_title.title then
                        trans:DestroyObject()
                        return
                    end
                    local parClip = trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                    parClip.NeedCheck = true
                    parClip.CheckCount = 10
                    parClip.CheckOne = 3
                    trans:SetLocalScaleXYZ(titleScale)
                end
            )
        end
        self.go_table.aorrawimage_title:SetActiveE(0)
    end
end

function VIPDrawLimitView:CreateSpine()
    if not self.skinId then
        return
    end
    local trans = self.go_table.obj_role
    trans:ClearChildren()
    local path = _G.ConfigManager.skin_cfg[self.skinId].ModelPathHi

    _G.PoolsManager:GetInstance():Spawn(
        path,
        _G.ePoolType.Temporary,
        trans,
        function(obj)
            if self:IsNil() then
                _G.DestroyObject(obj)
            end
            trans:SetLocalScaleXYZ(0.4)
            trans:SetLocalPosition(0, -215, 0)
        end
    )
end

---头像框的显示
---@param data ChangeIconData
function VIPDrawLimitView:UpdateTopShow()
    if not self.frameId then
        return
    end
    local cfg = _G.ConfigManager.player_frame_cfg[self.frameId]
    local loadPath, Type = cfg.frame, cfg.type_title
    UIUtils.RemoveChildren(self.go_table.aorrawimage_frame)
    if Type ~= 2 then
        self.go_table.aorrawimage_frame:LoadImage(loadPath)
    else
        self.go_table.aorrawimage_frame.color = _G.Color.New(1, 1, 1, 0)
        UIUtils.LoadEffectTitleOrFrame(
            loadPath,
            self.go_table.aorrawimage_frame,
            function(item)
                if item then
                    item:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                    item:SetLocalScaleXYZ(1.2)
                end
            end
        )
    end
end

---聊天框显示
function VIPDrawLimitView:UpdateChatShow()
    if not self.chatId then
        return
    end
    local cfg = _G.ConfigManager.player_bubble_cfg[self.chatId]
    self.go_table.aorimage_chatFrame.SpriteName = cfg.bubble
    self.go_table.obj_chatFrameEff:ClearChildren()
    if not _G.table.isEmptyOrNil(cfg.bubble_effect) then
        _G.UIUtils.LoadEffectByPath(
            cfg.bubble_effect[1][1],
            self.go_table.obj_chatFrameEff,
            function(trans)
                if self:IsNil() then
                    _G.UIUtils.RemoveEffect(trans)
                    return
                end
            end,
            nil,
            nil,
            nil,
            nil,
            nil,
            true
        )
    end
end

---按钮点击事件在这里派发
function VIPDrawLimitView:OnClickBtn(go)
    ---@type player_vip_shop_cfg
    local cfg = self.CurVIPInfo.cfg
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_zunxiang then
        local hasnum = 0
        local goodids = { self.skinGoodId, self.frameGoodId, self.titleGoodId, self.chatGoodId }
        for i = 1, #goodids do
            local buyTimes = VIPDrawModel:GetInstance():GetGoodsTimesByGoodId(cfg.id, goodids[i])
            local sscfg = _G.ConfigManager.season_shop_cfg[goodids[i]]
            if buyTimes < sscfg.count_limit then
                hasnum = hasnum + 1
            end
        end
        if hasnum > 0 then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.VIPDrawGoodsInfoView.Name, self.CurPage,
                { self.skinGoodId, self.frameGoodId, self.titleGoodId, self.chatGoodId },
                { self.skinDesc, self.frameDesc, self.titleDesc, self.chatDesc },
                { self.skinOff, self.frameOff, self.titleOff, self.chatOff }, cfg.shop_id)
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(1080101)
        end
    elseif go == self.go_table.aorbtn_left then
        self.CurPage = self.CurPage - 1
        if self.CurPage < 1 then
            self.CurPage = 1
        end
        self:UpdateButton()
        self.CurVIPInfo = VIPDrawModel:GetInstance().VIPExchangeInfo[self.CurPage]
        self:UpdateView()
    elseif go == self.go_table.aorbtn_right then
        self.CurPage = self.CurPage + 1
        if self.CurPage > self.MaxPage then
            self.CurPage = self.MaxPage
        end
        self:UpdateButton()
        self.CurVIPInfo = VIPDrawModel:GetInstance().VIPExchangeInfo[self.CurPage]
        self:UpdateView()
    end
end

function VIPDrawLimitView:UpdateButton()
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_left, self.CurPage > 1)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_right, self.CurPage < self.MaxPage)
end

function VIPDrawLimitView:Dispose()
end

return VIPDrawLimitView
