local VIPDrawNet = require("VIPDrawNet")

local base = _G.GameDataModelBase
---@class VIPDrawModel : GameDataModelBase
local VIPDrawModel = _G.BaseClass("VIPDrawModel", base)

---@return VIPDrawModel VIPDrawModel
function VIPDrawModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function VIPDrawModel:__init()
    self.curFunctionOpenID = _G.FunctionID.VIPDraw
    self.cfg = _G.ConfigManager.player_vip_shop_cfg
    self.ssCfg = _G.ConfigManager.season_shop_cfg
    self.pvrCfg = _G.ConfigManager.player_vip_roller_cfg[10001]

    self.VIPExchangeInfo = {}
    for i = 1, #self.cfg do
        local info = {}
        info.cfg = self.cfg[i]
        info.times = {}
        for j = 1, #info.cfg.goods do
            info.times[info.cfg.goods[j]] = 0
        end
        self.VIPExchangeInfo[info.cfg.id] = info
    end

    self.PVRInfo = {}

    local pos = self.pvrCfg.top_prize_1[1]
    local id = self.pvrCfg.top_prize_1[3]
    local num = self.pvrCfg.top_prize_1[4]
    local info = {}
    info.data = {}
    info.data[1] = id
    info.data[2] = num
    info.isbig = true
    self.PVRInfo[pos] = info

    pos = self.pvrCfg.top_prize_2[1]
    id = self.pvrCfg.top_prize_2[3]
    num = self.pvrCfg.top_prize_2[4]
    info = {}
    info.data = {}
    info.data[1] = id
    info.data[2] = num
    info.isbig = true
    self.PVRInfo[pos] = info

    for i = 1, #self.pvrCfg.pool do
        info = {}
        info.data = {}
        info.data[1] = self.pvrCfg.pool[i][1]
        info.data[2] = self.pvrCfg.pool[i][2]
        info.isbig = false
        for j = 1, 10 do
            if not self.PVRInfo[j] then
                self.PVRInfo[j] = info
                break
            end
        end
    end
end

---从服务器拉取数据
function VIPDrawModel:GetDataFormServer()
    VIPDrawNet:GetInstance():GetInfo(_G.handler(self, self.ParseData))
end

---@param msg vip.s2c_vip_get_exchange_info
function VIPDrawModel:ParseData(msg)
    if msg.ack == 1 then
        self.exchangeInfo = msg.exchange_info or {}
        for i = 1, #self.exchangeInfo do
            local tag = self.exchangeInfo[i].tab_id
            local value = self.exchangeInfo[i].exchanges or {}
            local info = self.VIPExchangeInfo[tag]
            for j = 1, #value do
                local exchange = value[j]
                info.times[exchange.id] = exchange.exchange_times
            end
        end
    end
    self.super.ParseData(self)
end

---判断页签是否全部够满完成
function VIPDrawModel:CheckTagFinish(tag)
    local isFinish = true
    if tag > 0 then
        local info = self.VIPExchangeInfo[tag]
        for id, times in pairs(info.times) do
            local cfg = self.ssCfg[id]
            if times < cfg.count_limit then
                isFinish = false
            end
        end
    end
    return isFinish
end

---获取对应页签所有道具兑换次数 return [id] = times
function VIPDrawModel:GetGoodsTimesByTab(tag)
    local times = {}
    local info = self.VIPExchangeInfo[tag]
    times = info.times
    return times
end

---获取对应页签单一商品道具兑换次数 return times
function VIPDrawModel:GetGoodsTimesByGoodId(tag, goodid)
    local times = 0
    local info = self.VIPExchangeInfo[tag]
    times = info.times[goodid]
    return times
end

---获取对应页签单一商品道具兑换次数 return times
function VIPDrawModel:GetGoodsTimesOnlyByGoodId(goodid)
    local times
    for i = 1, #self.VIPExchangeInfo do
        local info = self.VIPExchangeInfo[i]
        times = info.times[goodid]
        if times then
            return times
        end
    end
    return 0
end

---获取对应页签
function VIPDrawModel:AddGoodsTimes(tag, id, num)
    if nil == num then
        num = 1
    end
    local info = self.VIPExchangeInfo[tag]
    info.times[id] = info.times[id] + num
end

---获取抽奖id以及所需数量基数
function VIPDrawModel:GetDrawNeedNum()
    return self.pvrCfg.ticket[1], self.pvrCfg.ticket[2]
end

---判断是不是有10抽
function VIPDrawModel:CheckTenTimes()
    local times = 10
    local id, num = self:GetDrawNeedNum()
    local hasNum = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.ResProp, id)
    if hasNum >= num * times then
        return true
    end
    return false
end

---抽奖
function VIPDrawModel:Draw(times, call)
    local pbData = { draw_times = times }
    VIPDrawNet:GetInstance():Draw(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                _G.Events:GetInstance():Broadcast(_G.eVIPDraw.DrawFail)
                return
            end

            require("VIPPrivilegeModel"):GetInstance().need_count = msg.need_count

            _G.StorageManager:GetInstance():ReceiveAwardData(msg)

            _G.Events:GetInstance():Broadcast(_G.eVIPDraw.DrawFinish)

            if call then
                call(msg)
            end
        end
    )
end

---兑换
function VIPDrawModel:Exchange(tab_id, good_id, num, call)
    local pbData = { tab_id = tab_id, id = good_id, exchange_num = num }
    VIPDrawNet:GetInstance():Exchange(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end

            self:AddGoodsTimes(tab_id, good_id, num)

            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CommonAwardView.Name,
                msg,
                function()
                end
            )

            local cfg = _G.ConfigManager.season_shop_cfg[good_id]
            local id = cfg.need_item[1]
            local num = cfg.need_item[2]

            _G.StorageManager:GetInstance():ConsumeItem(id, nil, num)

            _G.Events:GetInstance():Broadcast(_G.eVIPDraw.ExchangeFinish)

            if call then
                call()
            end
        end
    )
end

---销毁对象时,析构函数
function VIPDrawModel:Dispose()
end

return VIPDrawModel
