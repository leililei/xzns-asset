local base = require("BaseGameNet")

---@class VIPDrawNet : BaseGameNet	通信协议
local VIPDrawNet = _G.BaseClass("VIPDrawNet", base)
---@return VIPDrawNet VIPDrawNet
function VIPDrawNet:GetInstance()
    return base.GetInstance(self)
end

---获取信息
function VIPDrawNet:GetInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_vip_get_exchange_info
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---抽奖
function VIPDrawNet:Draw(pbData, callback)
    local item = _G.ConfigManager.net_map.game_vip_execute
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---vip奖励兑换
function VIPDrawNet:Exchange(pbData, callback)
    local item = _G.ConfigManager.net_map.game_vip_exchange
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function VIPDrawNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return VIPDrawNet
