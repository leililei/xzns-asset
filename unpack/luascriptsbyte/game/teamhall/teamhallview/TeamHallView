---item点击事件
function TeamHallView:OnClick_item(itemGoTable, isOn, data)
    local isOpen = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(
        data.function_open
    )

    if not isOpen then
        return
    end

    if data.Item_name ~= "" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg[data.Item_name].Name)
    end
end

---按钮点击事件在这里派发
function TeamHallView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_help then
        ---打开玩法说明页面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 172)
    end
end

---界面的销毁函数
function TeamHallView:OnDestroy()
    self:RemoveAllListener()
    _G.Events:GetInstance():RemoveListener(_G.CardHallViewShow.Open, self.UpdateSPNewFunctionIcon, self)
    _G.Events:GetInstance():RemoveListener(_G.GemstoneViewShow.Open, self.UpdateGemstoneNewFunctionIcon, self)
    _G.Events:GetInstance():RemoveListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.OnFunctionOpenCall, self)
end

return TeamHallView
