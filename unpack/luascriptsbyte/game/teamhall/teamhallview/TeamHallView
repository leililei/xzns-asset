local base = require "EventViewBase"
---@class TeamHallView : UIBaseView	建筑升级
---@field public go_table TeamHallView_GoTable GoTable
local TeamHallView = _G.BaseClass("TeamHallView", base)

function TeamHallView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eSixUpdate.SixClockUpdate, self.OnSixClockUpdate)
    _G.Events:GetInstance():AddListener(_G.CardHallViewShow.Open, self.UpdateSPNewFunctionIcon, self)
    _G.Events:GetInstance():AddListener(_G.GemstoneViewShow.Open, self.UpdateGemstoneNewFunctionIcon, self)
    _G.Events:GetInstance():AddListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.OnFunctionOpenCall, self)
end

---界面的入口函数
function TeamHallView:OnCreate(sid)
    self.cfg = _G.ConfigManager.team_hall_cfg

    local res = _G.ConfigManager.ui_cfg.TeamHallView.resources
    self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, res))

    self.OpenIndexs = {}

    self:Show()
end

function TeamHallView:OnSixClockUpdate()
    self:Show()
end

function TeamHallView:Show(sid)
    local isShow = false
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.CardHall) then
        if _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.CardHallOpen) == 0 then
            isShow = true
        end
    end
    if self.Init == nil then
        self.go_table.scrollloopvectical_item:InitItemData(#self.cfg,
            _G.handler(self, self.RefreshList))
        self.Init = true
    else
        self.go_table.scrollloopvectical_item:UpdateAllItem()
    end
    if isShow then 
        self.go_table.scrollloopvectical_item:ScrollToIndex(4)
    end 
end

function TeamHallView:OnFunctionOpenCall(id)
    if id == _G.FunctionID.CardHall then 
        _G.Events:GetInstance():Broadcast(_G.CardHallViewShow.Open)
    elseif id == _G.FunctionID.Gemstone then
        _G.Events:GetInstance():Broadcast(_G.GemstoneViewShow.Open)
    end
end

function TeamHallView:UpdateSPNewFunctionIcon()
    local isShow = false
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.CardHall) then
        if _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.CardHallOpen) == 0 then
            isShow = true
        end
    end
    if self.newFunctionFlag then 
        self.newFunctionFlag.obj_newFunctionIcon:SetActiveE(isShow == true and 1 or 0)
    end
end

function TeamHallView:UpdateGemstoneNewFunctionIcon()
    local isShow = false
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Gemstone) then
        if _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.GemstoneOpen) == 0 then
            isShow = true
        end
    end
    if self.GemstoneFlag then
        self.GemstoneFlag.obj_newFunctionIcon:SetActiveE(isShow == true and 1 or 0)
    end
end

