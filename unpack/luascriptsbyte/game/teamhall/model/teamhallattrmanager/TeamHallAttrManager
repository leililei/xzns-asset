---@class TeamHallAttrManager : Component	
local TeamHallAttrManager = _G.BaseClass("TeamHallAttrManager", _G.Singleton)

local normalList = {
    "atk",
    "bre",
    "def",
    "max_hp"
}
local keyList = { 
    "attriOther", 
    "attribute", 
    "attributePercent" 
}

---属性相加
function TeamHallAttrManager.AddAttribute(left, right)
    local newAttribute = {
        attriOther = {},
        attribute = {},
        attributePercent = {}
    }
    local addFunction = function(key, attribute)
        if attribute then
            for attr, value in pairs(attribute) do
                if not newAttribute[key][attr] then
                    newAttribute[key][attr] = value
                else
                    newAttribute[key][attr] = newAttribute[key][attr] + value
                end
            end
        end
    end
    local isLeftSimple = false
    local isRightSimple = false
    for _, key in pairs(keyList) do
        if left[key] then
            addFunction(key, left[key])
        else
            isLeftSimple = true
        end
        if right[key] then
            addFunction(key, right[key])
        else
            isRightSimple = true
        end
    end
    if isLeftSimple then
        addFunction("attriOther", left)
    end
    if isRightSimple then
        addFunction("attriOther", right)
    end
    return newAttribute
end

---检测attriOther属性是否为百分比
function TeamHallAttrManager.CheckPrecent(key)
    return not _G.table.ContainsValue(normalList, key)
end

---检测是否有属性
function TeamHallAttrManager.CheckHasAttribute(attribute)
    local hasAttribute = false
    for _, key in pairs(keyList) do
        if not _G.table.isEmptyOrNil(attribute[key]) then
            local hasValue = false
            for _, value in pairs(attribute[key]) do
                if value > 0 then
                    hasValue = true
                    break
                end
            end
            if hasValue then
                hasAttribute = true
                break
            end
        end
    end
    return hasAttribute
end

---获取属性列表
function TeamHallAttrManager.GetAttribute(attribute)
    local attrList = {}
    local isSimple = false
    for _, key in pairs(keyList) do
        if attribute[key] then
            TeamHallAttrManager.TransAttribute(attrList, attribute[key], key)
        else
            isSimple = true
        end
    end
    if isSimple then
        TeamHallAttrManager.TransAttribute(attrList, attribute)
    end
    _G.SortList(
        attrList,
        function(a)
            return not TeamHallAttrManager.CheckPrecent(a.key) and 99 or 0, -a.percentage, -a.sortid
        end
    )
    return attrList, TeamHallAttrManager.CheckHasAttribute(attribute)
end

function TeamHallAttrManager.GetPrivilegeDic(privilegeList)
    local privilegeDic = {}
    for _, v in pairs(privilegeList) do
        local cfg = _G.ConfigManager.privilege_cfg[v]
        local isThree = #cfg.privilege[1] == 3
        local key = isThree and cfg.privilege[1][2] or cfg.privilege[1][1]
        local value = isThree and cfg.privilege[1][3] or cfg.privilege[1][2]
        local name = cfg.name
        if not privilegeDic[key] then
            privilegeDic[key] = {
                value = value,
                name = name
            }
        else
            privilegeDic[key].value = privilegeDic[key].value + value
        end
    end
    return privilegeDic
end

function TeamHallAttrManager.TransAttribute(attrList, list, key)
    for attr, value in pairs(list) do
        local precent = 1
        attr = tonumber(attr) and normalList[attr] or attr
        if (key and key == "attributePercent") or TeamHallAttrManager.CheckPrecent(attr) then
            precent = 2
        end
        if value > 0 then
            _G.table.insert(attrList, {
                key = attr,
                ID = _G.AttrType[attr].ID,
                sortid = _G.AttrType[attr].sortid,
                proptype = _G.AttrType[attr].proptype,
                icon = _G.AttrTypeIcon[attr],
                des = _G.AttrType[attr].des,
                percentage = precent,
                num = precent == 1 and value or (value * 10000)
            })
        end
    end
end

return TeamHallAttrManager
