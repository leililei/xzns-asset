---@class TeamHallAttrContent : UIBaseView	
---@field public go_table TeamHallAttrPanel._obj_AttrContent1_GoTable GoTable
local TeamHallAttrContent = _G.BaseClass("TeamHallAttrContent", _G.Component)

function TeamHallAttrContent:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function TeamHallAttrContent:OnCreate(name, rowCount, helpCall)
    self.name = name
    self.helpCall = helpCall
    self.rowCount = rowCount or 2
    self:InitView()
end

function TeamHallAttrContent:InitView()
    self.go_table.obj_Help:SetActiveE(self.helpCall and 1 or 0)
    self.go_table.aortext_Title.text = tonumber(self.name) and _G.GetLangPackValue(self.name) or self.name
    local grid = self.go_table.obj_Content:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.GridLayoutGroup))
    grid.constraintCount = self.rowCount
    _G.GameUtil.ReBuildRTF(self.go_table.aortext_Title)
end

---按钮点击事件在这里派发
function TeamHallAttrContent:OnClickBtn(go)
    if go == self.go_table.aorbtn_Help then
        if self.helpCall then
            self.helpCall()
        end
    end
end

return TeamHallAttrContent
