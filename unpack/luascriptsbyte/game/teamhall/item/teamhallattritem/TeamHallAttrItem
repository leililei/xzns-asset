---@class TeamHallAttrItem : UIBaseView	
---@field public go_table TeamHallAttrPanel._obj_Attr1_GoTable GoTable
local TeamHallAttrItem = _G.BaseClass("TeamHallAttrItem", _G.Component)

local textColor = { 
    _G.ColorTools.FormatColorByString("343A48"),
    _G.ColorTools.FormatColorByString("ED8408") 
}
local textColor2 = {
    _G.ColorTools.FormatColorByString("24A11F"),
    _G.ColorTools.FormatColorByString("ED8408")
}

local specialList = {
    _G.AttrTypeIcon["max_hp"], 
    _G.AttrTypeIcon["atk"], 
    _G.AttrTypeIcon["def"], 
    _G.AttrTypeIcon["bre"]
}

function TeamHallAttrItem:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function TeamHallAttrItem:OnCreate(name, num, icon, isPercent, isSpecial, isShowAdd)
    self.num = num
    isSpecial = isSpecial and _G.table.ContainsValue(specialList, icon)
    self.icon = isSpecial and icon .. "_2" or icon
    self.isPercent = isPercent
    self.isSpecial = isSpecial
    self.isShowAdd = isShowAdd
    self.name = tonumber(name) and _G.GetLangPackValue(name) or name
    self:InitView()
end

function TeamHallAttrItem:InitView()
    self.go_table.aorimage_Icon:SetActiveE(self.icon and 1 or 0)
    if self.icon then
        self.go_table.aorimage_Icon.SpriteName = self.icon
    end
    self.go_table.aortext_Name.color = textColor[self.isSpecial and 2 or 1]
    self.go_table.aortext_Name.text = self.name
    self.go_table.aortext_Num.color = textColor2[self.isSpecial and 2 or 1]
    self.go_table.aortext_Num.text = self:GetShowText()
end

function TeamHallAttrItem:UpdateNum(num)
    self.num = num
    self.go_table.aortext_Num.text = self:GetShowText()
end

function TeamHallAttrItem:GetShowText()
    local number = tonumber(self.num)
    if not number then
        return self.num
    end
    local text = self.isShowAdd and "+" or ""
    if self.isPercent then
        return string.format("%s%.1f%%", text, self.num / 100)
    else
        return string.format("%s%d", text, _G.math.floor(self.num))--防止纯数值有小数导致报错，加个向下取整的容错
    end
end

---按钮点击事件在这里派发
function TeamHallAttrItem:OnClickBtn(go)
    if go == self.go_table.aorbtn_Help then
        if self.helpCall then
            self.helpCall()
        end
    end
end

return TeamHallAttrItem
