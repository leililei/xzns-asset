local base = require("TeamHallAttrBasePanel")
---@class TeamHallAttrBeastPanel : TeamHallAttrBasePanel
---@field public go_table TeamHallAttrPanel_GoTable GoTable
local TeamHallAttrBeastPanel = _G.BaseClass("TeamHallAttrBeastPanel", base)

---初始化数据，子类重写
function TeamHallAttrBeastPanel:InitData()
    self.model = require("BeastModel"):GetInstance()
    self.fetterModel = require("BeastFetterModel"):GetInstance()
    local beastAttr = self.model:GetBeastAttribute()
    local fetterAttr = self.fetterModel:GetBeastFetterAttribute()
    self.beastAttr, self.hasBeast = self:GetAttribute(beastAttr)
    self.fetterAttr, self.hasFetter = self:GetAttribute(fetterAttr)
    self.totalAttr, self.hasTotal = self:GetAttribute(self:AddAttribute(beastAttr, fetterAttr))
end

---初始化主体Content，子类重写
function TeamHallAttrBeastPanel:InitContent()
    if not self.hasTotal then
        self.go_table.obj_Empty:SetActiveE(1)
        return
    end
    local content = self.go_table.obj_Content
    if self.hasTotal then
        local allAttrList = self:CreateContent(content, 1, 90049200038)
        for _, v in pairs(self.totalAttr) do
            self:CreateItem(
                allAttrList.go_table.obj_Content,
                1,
                v.des,
                v.num,
                v.icon,
                v.percentage == 2,
                v.percentage == 2
            )
        end
        _G.GameUtil.ReBuildRTF(content)
    end
    if self.hasBeast then
        local beastAttrList = self:CreateContent(content, 1, 22290001019)
        for _, v in pairs(self.beastAttr) do
            self:CreateItem(
                    beastAttrList.go_table.obj_Content,
                    1,
                    v.des,
                    v.num,
                    v.icon,
                    v.percentage == 2,
                    v.percentage == 2
            )
        end
        _G.GameUtil.ReBuildRTF(content)
    end
    if self.hasFetter then
        local fetterAttrList = self:CreateContent(content, 1, 22290001005)
        for _, v in pairs(self.fetterAttr) do
            self:CreateItem(
                    fetterAttrList.go_table.obj_Content,
                    1,
                    v.des,
                    v.num,
                    v.icon,
                    v.percentage == 2,
                    v.percentage == 2
            )
        end
        _G.GameUtil.ReBuildRTF(content)
    end
end

---初始化底部Content，子类重写
function TeamHallAttrBeastPanel:InitBottomPanel()
end


return TeamHallAttrBeastPanel
