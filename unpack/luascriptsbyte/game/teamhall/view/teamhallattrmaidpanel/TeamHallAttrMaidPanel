local base = require("TeamHallAttrBasePanel")
---@class TeamHallAttrMaidPanel : TeamHallAttrBasePanel
---@field public go_table TeamHallAttrPanel_GoTable GoTable
local TeamHallAttrMaidPanel = _G.BaseClass("TeamHallAttrMaidPanel", base)

---初始化数据，子类重写
function TeamHallAttrMaidPanel:InitData()
    self.model = require("MaidAcademyModel"):GetInstance()
    local cultivationAttr = self:AddAttribute(self.model:GetCultivateBasePropAttr(), self.model.attr)
    local appiotAttr = self.model:GetAllAppiotAttr()
    self.cultivationAttr, self.hasCultivate = self:GetAttribute(cultivationAttr)
    self.appiotAttr, self.hasAppiot = self:GetAttribute(appiotAttr)
    self.totalAttr, self.hasTotal = self:GetAttribute(self:AddAttribute(cultivationAttr, appiotAttr))
    self.studyInfo = self.model.study_info
end

---初始化主体Content，子类重写
function TeamHallAttrMaidPanel:InitContent()
    local content = self.go_table.obj_Content
    if not self.hasTotal then
        self.go_table.obj_Empty:SetActiveE(1)
        return
    end
    if self.hasTotal then
        local allAttrList = self:CreateContent(content, 1, 90049200038)
        for _, v in pairs(self.totalAttr) do
            self:CreateItem(
                allAttrList.go_table.obj_Content,
                1,
                v.des,
                v.num,
                v.icon,
                v.percentage == 2,
                v.percentage == 2
            )
        end
        _G.GameUtil.ReBuildRTF(content)
    end
    if self.hasCultivate then
        local cultivateAttrList = self:CreateContent(content, 1, 22290001006)
        for _, v in pairs(self.cultivationAttr) do
            self:CreateItem(
                cultivateAttrList.go_table.obj_Content,
                1,
                v.des,
                v.num,
                v.icon,
                v.percentage == 2,
                v.percentage == 2
            )
        end
        _G.GameUtil.ReBuildRTF(content)
    end
    if self.hasAppiot then
        local appiotAttrList = self:CreateContent(
                content, 
                1,
                22290001008,
                2,
                function()
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MaidChamAttrMaxView.Name)
                end
        )
        for _, v in pairs(self.appiotAttr) do
            self:CreateItem(
                appiotAttrList.go_table.obj_Content,
                1,
                v.des,
                v.num,
                v.icon,
                v.percentage == 2,
                v.percentage == 2
            )
        end
        _G.GameUtil.ReBuildRTF(content)
    end
end

---初始化底部Content，子类重写
function TeamHallAttrMaidPanel:InitBottomPanel()
    local content = self.go_table.obj_BottomPanel
    local studyList = self:CreateContent(content, 2, 90120200033)
    local infonames = { _G.GetLangPackValue(90120200034), _G.GetLangPackValue(90120200035), _G.GetLangPackValue(90120200036) }
    for i = 1, 3 do
        local attrName = infonames[i]
        local attrValue = self.studyInfo[i] or 0
        self:CreateItem(
            studyList.go_table.obj_Content,
            2,
            attrName,
            attrValue
        )
    end
    _G.GameUtil.ReBuildRTF(content)
end


return TeamHallAttrMaidPanel
