local base = require("TeamHallAttrBasePanel")
---@class TeamHallAttrTechPanel : TeamHallAttrBasePanel
---@field public go_table TeamHallAttrPanel_GoTable GoTable
local TeamHallAttrTechPanel = _G.BaseClass("TeamHallAttrTechPanel", base)

---初始化数据，子类重写
function TeamHallAttrTechPanel:InitData()
    self.model = require("WarTechnologyModel"):GetInstance()
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local elementAttr = {}
    self.elementAttr = {}
    self.hasElementAttr = {}
    for i = 1, 4 do
        elementAttr[i] = self.model:GetAllAttribute(i)
        self.elementAttr[i], self.hasElementAttr[i] = self:GetAttribute(elementAttr[i])
    end
    local globalAttr = AttributeClassManager:GetAttribtueClass()
    local globalAttrList = self.model:GetTotleAttributeGlobal()
    for _, v in pairs(globalAttrList) do
        local value = tonumber(v[3])
        local name = v[1]
        local aType = v[2] == "1" and _G.AttCountType.other or tonumber(v[2])
        globalAttr:AddValueByName(name, AttributeClassManager:GetValueWithName(name, value, aType), false, aType)
    end
    self.globalAttr, self.hasGlobalAttr = self:GetAttribute(globalAttr)
    for i = 1, 4 do
        if self.hasElementAttr[i] then
            self.hasTotal = true
            break
        end
    end
    self.hasTotal = self.hasTotal or self.hasGlobalAttr
end

---初始化主体Content，子类重写
function TeamHallAttrTechPanel:InitContent()
    local content = self.go_table.obj_Content
    if not self.hasTotal then
        self.go_table.obj_Empty:SetActiveE(1)
        return
    end
    if self.hasGlobalAttr then
        local globalAttrList = self:CreateContent(content, 1, 90033405046)
        for _, v in pairs(self.globalAttr) do
            self:CreateItem(
                globalAttrList.go_table.obj_Content,
                1,
                v.des,
                v.num,
                v.icon,
                v.percentage == 2,
                v.percentage == 2
            )
        end
        _G.GameUtil.ReBuildRTF(content)
    end
    for i = 1, 4 do
        if self.hasElementAttr[i] then
            local elementAttrList = self:CreateContent(content, 1, 22290001008 + i)
            for _, v in pairs(self.elementAttr[i]) do
                self:CreateItem(
                    elementAttrList.go_table.obj_Content,
                    1,
                    v.des,
                    v.num,
                    v.icon,
                    v.percentage == 2,
                    v.percentage == 2
                )
            end
            _G.GameUtil.ReBuildRTF(content)
        end
    end
end

---初始化底部Content，子类重写
function TeamHallAttrTechPanel:InitBottomPanel()
end


return TeamHallAttrTechPanel
