local base = require("TeamHallAttrBasePanel")
---@class TeamHallAttrBuildPanel : TeamHallAttrBasePanel
---@field public go_table TeamHallAttrPanel_GoTable GoTable
local TeamHallAttrBuildPanel = _G.BaseClass("TeamHallAttrBuildPanel", base)

---初始化数据，子类重写
function TeamHallAttrBuildPanel:InitData()
    self.model = require("BuildDrawModel"):GetInstance()
    self.fetterModel = require("BuildFetterModel"):GetInstance()
    local starAttr = self.model:GetBuildStarAttribute()
    local levelAttr = self.model:GetBuildLevelExtraAttribute()
    local fetterAttr = self.fetterModel:GetBuildFetterAttribute()
    self.starAttr, self.hasStar = self:GetAttribute(starAttr)
    self.levelAttr, self.hasLevel = self:GetAttribute(levelAttr)
    self.fetterAttr, self.hasFetter = self:GetAttribute(fetterAttr)
    self.totalAttr, self.hasTotal = self:GetAttribute(self:AddAttribute(starAttr, self:AddAttribute(levelAttr, fetterAttr)))
end

---初始化主体Content，子类重写
function TeamHallAttrBuildPanel:InitContent()
    local content = self.go_table.obj_Content
    if not self.hasTotal then
        self.go_table.obj_Empty:SetActiveE(1)
        return
    end
    if self.hasTotal then
        local allAttrList = self:CreateContent(content, 1, 90049200038)
        for _, v in pairs(self.totalAttr) do
            self:CreateItem(
                allAttrList.go_table.obj_Content,
                1,
                v.des,
                v.num,
                v.icon,
                v.percentage == 2,
                v.percentage == 2
            )
        end
        _G.GameUtil.ReBuildRTF(content)
    end
    if self.hasLevel then
        local levelAttrList = self:CreateContent(content, 1, 22290001003)
        for _, v in pairs(self.levelAttr) do
            self:CreateItem(
                levelAttrList.go_table.obj_Content,
                1,
                v.des,
                v.num,
                v.icon,
                v.percentage == 2,
                v.percentage == 2
            )
        end
        _G.GameUtil.ReBuildRTF(content)
    end
    if self.hasStar then
        local starAttrList = self:CreateContent(content, 1, 22290001004)
        for _, v in pairs(self.starAttr) do
            self:CreateItem(
                starAttrList.go_table.obj_Content,
                1,
                v.des,
                v.num,
                v.icon,
                v.percentage == 2,
                v.percentage == 2
            )
        end
        _G.GameUtil.ReBuildRTF(content)
    end
    if self.hasFetter then
        local fetterAttrList = self:CreateContent(content, 1, 22290001005)
        for _, v in pairs(self.fetterAttr) do
            self:CreateItem(
                fetterAttrList.go_table.obj_Content,
                1,
                v.des,
                v.num,
                v.icon,
                v.percentage == 2,
                v.percentage == 2
            )
        end
        _G.GameUtil.ReBuildRTF(content)
    end
end

---初始化底部Content，子类重写
function TeamHallAttrBuildPanel:InitBottomPanel()
end


return TeamHallAttrBuildPanel
