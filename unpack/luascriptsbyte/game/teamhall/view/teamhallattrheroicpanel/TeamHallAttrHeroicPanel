local base = require("TeamHallAttrBasePanel")
---@class TeamHallAttrHeroicPanel : TeamHallAttrBasePanel
---@field public go_table TeamHallAttrPanel_GoTable GoTable
local TeamHallAttrHeroicPanel = _G.BaseClass("TeamHallAttrHeroicPanel", base)

---初始化数据，子类重写
function TeamHallAttrHeroicPanel:InitData()
    self.model = require("HeroicIconModel"):GetInstance()
    self:InitPrivilege()
    local allAttr = self.model:GetAllAttribute()
    self.allAttr, self.hasAttr = self:GetAttribute(allAttr)
    self.hasTotal = self.hasAttr or self.hasPrivilege
end

---初始化主体Content，子类重写
function TeamHallAttrHeroicPanel:InitContent()
    local content = self.go_table.obj_Content
    if not self.hasTotal then
        self.go_table.obj_Empty:SetActiveE(1)
        return
    end
    if self.hasAttr then
        local allAttrList = self:CreateContent(content, 1, 90049200038)
        for _, v in pairs(self.allAttr) do
            self:CreateItem(
                allAttrList.go_table.obj_Content,
                1,
                v.des,
                v.num,
                v.icon,
                v.percentage == 2,
                v.percentage == 2
            )
        end
        _G.GameUtil.ReBuildRTF(content)
    end
    if self.hasPrivilege then
        local privilegeList = self:CreateContent(content, 1, 22290001002, 1)
        for _, privilege in pairs(self.privilegeDic) do
            self:CreateItem(
                privilegeList.go_table.obj_Content,
                2,
                privilege.name,
                privilege.value,
                false,
                false,
                true,
                true
            )
        end
        _G.GameUtil.ReBuildRTF(content)
    end
end

---初始化底部Content，子类重写
function TeamHallAttrHeroicPanel:InitBottomPanel()
end

function TeamHallAttrHeroicPanel:InitPrivilege()
    local list = {}
    for _, v in pairs(self.model.heroic_icons) do
        if v.privilegeCfg then
            _G.table.insert(list, v.privilegeCfg.id)
        end
    end
    self:GetPrivilegeDic(list)
    self.hasPrivilege = not _G.table.isEmptyOrNil(self.privilegeDic)
end

return TeamHallAttrHeroicPanel
