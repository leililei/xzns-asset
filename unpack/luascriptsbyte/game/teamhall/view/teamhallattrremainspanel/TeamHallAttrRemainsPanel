local base = require("TeamHallAttrBasePanel")
---@class TeamHallAttrRemainsPanel : TeamHallAttrBasePanel
---@field public go_table TeamHallAttrPanel_GoTable GoTable
local TeamHallAttrRemainsPanel = _G.BaseClass("TeamHallAttrRemainsPanel", base)

---初始化数据，子类重写
function TeamHallAttrRemainsPanel:InitData()
    self.model = require("RemainsModel"):GetInstance()
    local baseAttr = self.model:GetAllAttribute()
    local passiveAttr = self.model:GetAllAttribute2()
    local fetterAttr = self.model:GeFetterAttribute()
    local remainsAttr = self:AddAttribute(baseAttr, passiveAttr)
    local allAttr = self:AddAttribute(remainsAttr, fetterAttr)
    self.remainsAttr, self.hasRemains = self:GetAttribute(remainsAttr)
    self.fetterAttr, self.hasFetter = self:GetAttribute(fetterAttr)
    self.totalAttr, self.hasTotal = self:GetAttribute(allAttr)
end

---初始化主体Content，子类重写
function TeamHallAttrRemainsPanel:InitContent()
    local content = self.go_table.obj_Content
    if not self.hasTotal then
        self.go_table.obj_Empty:SetActiveE(1)
        return
    end
    if self.hasTotal then
        local allAttrList = self:CreateContent(content, 1, 90049200038)
        for _, v in pairs(self.totalAttr) do
            self:CreateItem(
                allAttrList.go_table.obj_Content,
                1,
                v.des,
                v.num,
                v.icon,
                v.percentage == 2,
                v.percentage == 2
            )
        end
        _G.GameUtil.ReBuildRTF(content)
    end
    if self.hasRemains then
        local remainsAttrList = self:CreateContent(content, 1, 22290001019)
        for _, v in pairs(self.remainsAttr) do
            self:CreateItem(
                remainsAttrList.go_table.obj_Content,
                1,
                v.des,
                v.num,
                v.icon,
                v.percentage == 2,
                v.percentage == 2
            )
        end
        _G.GameUtil.ReBuildRTF(content)
    end
    if self.hasFetter then
        local fetterAttrList = self:CreateContent(content, 1, 22290001013)
        for _, v in pairs(self.fetterAttr) do
            self:CreateItem(
                fetterAttrList.go_table.obj_Content,
                1,
                v.des,
                v.num,
                v.icon,
                v.percentage == 2,
                v.percentage == 2
            )
        end
        _G.GameUtil.ReBuildRTF(content)
    end
end

---初始化底部Content，子类重写
function TeamHallAttrRemainsPanel:InitBottomPanel()
end


return TeamHallAttrRemainsPanel
