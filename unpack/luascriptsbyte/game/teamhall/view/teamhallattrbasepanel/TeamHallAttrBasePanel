---@class TeamHallAttrBasePanel : UIBaseView	
---@field public go_table TeamHallAttrPanel_GoTable GoTable
local TeamHallAttrBasePanel = _G.BaseClass("TeamHallAttrBasePanel", _G.UIBaseView)
local TeamHallAttrContent = require("TeamHallAttrContent")
local TeamHallAttrItem = require("TeamHallAttrItem")
local TeamHallAttrManager = require("TeamHallAttrManager")

local rectHeight = { 898, 730 }

function TeamHallAttrBasePanel:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function TeamHallAttrBasePanel:OnCreate(type)
    self.type = type or 1
    self:InitData()
    self:InitView()
end

---初始化数据，子类重写
function TeamHallAttrBasePanel:InitData()
end

function TeamHallAttrBasePanel:InitView()
    self.go_table.obj_BottomPanel:SetActiveE(self.type == 2 and 1 or 0)
    local x = self.go_table.obj_ScrollRect:GetRectTransformSize()
    self.go_table.obj_ScrollRect:SetRectTransformSize(x, rectHeight[self.type])
    self:InitContent()
    if self.type == 2 then
        self:InitBottomPanel()
    end
    _G.GameUtil.ReBuildRTF(self.go_table.obj_Content)
end

---初始化主体Content，子类重写
function TeamHallAttrBasePanel:InitContent()
end

---初始化底部Content，子类重写
function TeamHallAttrBasePanel:InitBottomPanel()
end

---增加一个属性列表
function TeamHallAttrBasePanel:CreateContent(parent, type, name, rowCount, helpCall)
    local content = _G.InstantiateObject(self.go_table["obj_AttrContent" .. type], parent)
    return self:AddComponent(
        content,
        TeamHallAttrContent.New(
            name,
            rowCount,
            helpCall
        )
    )
end

---增加一条属性
function TeamHallAttrBasePanel:CreateItem(parent, type, name, num, icon, isSpecial, isPrecent, isShowAdd)
    local item = _G.InstantiateObject(self.go_table["obj_Attr" .. type], parent)
    return self:AddComponent(
        item,
        TeamHallAttrItem.New(
            name,
            num, 
            icon,
            isPrecent,
            isSpecial,
            isShowAdd
        )
    )
end

---属性相加
function TeamHallAttrBasePanel:AddAttribute(left, right)
    return TeamHallAttrManager.AddAttribute(left, right)
end


---检测attriOther属性是否为百分比
function TeamHallAttrBasePanel:CheckPrecent(key)
    return TeamHallAttrManager.CheckPrecent(key)
end

---检测是否有属性
function TeamHallAttrBasePanel:CheckHasAttribute(attribute)
    return TeamHallAttrManager.CheckHasAttribute(attribute)
end

---获取属性列表
function TeamHallAttrBasePanel:GetAttribute(attribute)
    return TeamHallAttrManager.GetAttribute(attribute)
end

function TeamHallAttrBasePanel:GetPrivilegeDic(privilegeList)
    self.privilegeDic = TeamHallAttrManager.GetPrivilegeDic(privilegeList)
    return self.privilegeDic
end

function TeamHallAttrBasePanel:TransAttribute(attrList, list, key)
    TeamHallAttrManager.TransAttribute(attrList, list, key)
end

---按钮点击事件在这里派发
function TeamHallAttrBasePanel:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

---界面的销毁函数
function TeamHallAttrBasePanel:OnDestroy()
end

return TeamHallAttrBasePanel
