local base = require("TeamHallAttrBasePanel")
---@class TeamHallAttrGodHaloPanel : TeamHallAttrBasePanel
---@field public go_table TeamHallAttrPanel_GoTable GoTable
local TeamHallAttrGodHaloPanel = _G.BaseClass("TeamHallAttrGodHaloPanel", base)

---初始化数据，子类重写
function TeamHallAttrGodHaloPanel:InitData()
    self.cfg = _G.ConfigManager.god_halo_cfg
    self.unlockList = _G.PlayerModel:GetInstance().un_god_halo
    self.attrList = {}
    self.privilegeDic = {}
    self:InitProp()
    self:InitPrivilege()
end

---初始化主体Content，子类重写
function TeamHallAttrGodHaloPanel:InitContent()
    local hasAttr = not _G.table.isEmptyOrNil(self.attrList)
    local hasPrivilege = not _G.table.isEmptyOrNil(self.privilegeDic)
    if not hasAttr and not hasPrivilege then
        self.go_table.obj_Empty:SetActiveE(1)
        return
    end
    local content = self.go_table.obj_Content
    if hasAttr then--总属性加成
        local allAttrList = self:CreateContent(content, 1, 90049200038)
        for _, v in pairs(self.attrList) do
            self:CreateItem(
                    allAttrList.go_table.obj_Content,
                    1,
                    v.des,
                    v.num,
                    v.icon,
                    v.percentage == 2,
                    v.percentage == 2
            )
        end
        _G.GameUtil.ReBuildRTF(content)
    end
    if hasPrivilege then--产出加成
        local privilegeList = self:CreateContent(content, 1, 22290001002, 1)
        for _, privilege in pairs(self.privilegeDic) do
            self:CreateItem(
                privilegeList.go_table.obj_Content,
                2,
                privilege.name,
                privilege.value,
                false,
                false,
                true,
                true
            )
        end
        _G.GameUtil.ReBuildRTF(content)
    end
    
end

---初始化底部Content，子类重写
function TeamHallAttrGodHaloPanel:InitBottomPanel()
end

function TeamHallAttrGodHaloPanel:InitProp()
    local prop = {}
    for i = 1, #self.unlockList do
        local cfg = self.cfg[self.unlockList[i].k]
        if cfg.base_att then
            for j = 1, #cfg.base_att do
                local attr = cfg.base_att[j]
                if not prop[attr[1]] then
                    prop[attr[1]] = {}
                    prop[attr[1]][1] = 0
                    prop[attr[1]][2] = 0
                end

                prop[attr[1]][tonumber(attr[2])] = prop[attr[1]][tonumber(attr[2])] + attr[3]
            end
        end
    end

    for i, v in pairs(prop) do
        if _G.AttrType[i] then
            local per = _G.ConfigManager.type_attribute_cfg[_G.AttrType[i].ID].value_type

            for j = 1, #v do
                if v[j] > 0 then
                    if i == "atk" or i == "max_hp" or i == "bre" or i == "def" then
                        per = j
                    end
                    table.insert(
                        self.attrList,
                        {
                            key = i,
                            ID = _G.AttrType[i].ID,
                            sortid = _G.AttrType[i].sortid,
                            proptype = _G.AttrType[i].proptype,
                            icon = _G.AttrTypeIcon[i],
                            des = _G.AttrType[i].des,
                            percentage = per,
                            num = v[j]
                        }
                    )
                end
            end
        end
    end
    _G.SortList(
        self.attrList,
        function(a)
            return not self:CheckPrecent(a.key) and 99 or 0, -a.percentage, -a.sortid
        end
    )
end

function TeamHallAttrGodHaloPanel:InitPrivilege()
    local effect = {}
    for i = 1, #self.unlockList do
        for _, v in pairs(self.cfg[self.unlockList[i].k].halo_effect) do
            _G.table.insert(effect, v)
        end
    end
    local privilegeList = {}
    for _, v in pairs(effect) do
        local cfg = _G.ConfigManager.god_halo_effect_cfg[v]
        if #cfg.privilege_id > 0 then
            for _, privilege in pairs(cfg.privilege_id) do
                _G.table.insert(privilegeList, privilege)
            end
        end
    end
    self:GetPrivilegeDic(privilegeList)
end

return TeamHallAttrGodHaloPanel
