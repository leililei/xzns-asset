local base = require("TeamHallAttrBasePanel")
---@class TeamHallAttrSpoilsPanel : TeamHallAttrBasePanel
---@field public go_table TeamHallAttrPanel_GoTable GoTable
local TeamHallAttrSpoilsPanel = _G.BaseClass("TeamHallAttrSpoilsPanel", base)

---初始化数据，子类重写
function TeamHallAttrSpoilsPanel:InitData()
    self.model = require("SpoilsModel"):GetInstance()
    local allAttr = self.model:GetAllAttribute()
    self.totalAttr, self.hasTotal = self:GetAttribute(allAttr)
end

---初始化主体Content，子类重写
function TeamHallAttrSpoilsPanel:InitContent()
    local content = self.go_table.obj_Content
    if not self.hasTotal then
        self.go_table.obj_Empty:SetActiveE(1)
        return
    end
    if self.hasTotal then
        local allAttrList = self:CreateContent(content, 1, 90049200038)
        for _, v in pairs(self.totalAttr) do
            self:CreateItem(
                allAttrList.go_table.obj_Content,
                1,
                v.des,
                v.num,
                v.icon,
                v.percentage == 2,
                v.percentage == 2
            )
        end
        _G.GameUtil.ReBuildRTF(content)
    end
end

---初始化底部Content，子类重写
function TeamHallAttrSpoilsPanel:InitBottomPanel()
end


return TeamHallAttrSpoilsPanel
