local base = require "EventViewBase"
---@class TeamHallViewXZNS : UIBaseView	
---@field public go_table TeamHallViewXZNS_GoTable GoTable
local TeamHallViewXZNS = _G.BaseClass("TeamHallViewXZNS", base)

function TeamHallViewXZNS:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eSixUpdate.SixClockUpdate, self.OnSixClockUpdate)
end

---界面的入口函数
function TeamHallViewXZNS:OnCreate(sid)
    self.cfg = _G.ConfigManager.team_hall_cfg

    -- local res = _G.ConfigManager.ui_cfg.TeamHallView.resources
    -- self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, res))

    self:Show()
end

function TeamHallViewXZNS:OnSixClockUpdate()
    self:Show()
end

function TeamHallViewXZNS:Show()
    local cfg = _G.ConfigManager.team_hall_cfg
      local isOpen = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(
        cfg[2].function_open
    )
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.PointGodHaloFirst.id)
    for k,v in pairs(cfg) do
        local Mask = self.go_table["aorrawimage_TeamIconMask" .. k]
        local Name = self.go_table["aorrawimage_nameBg" .. k]
        local NameTips = self.go_table["aortext_Name" .. k]
        local Desc = self.go_table["aortext_Desc" .. k]
        local obj_redpoint = self.go_table["obj_redpoint" .. k]

        if not self.cfg[k] or self.cfg[k].function_open==0 then
            LogError(k)
        end
        local isOpen = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(
                tonumber(v.function_open)
        )
        local str, tipsid = _G.FunctionManager:GetInstance():GetTipsStr(tonumber(v.function_open))
        obj_redpoint:UpdateRedPointItemIDAndParam(v.redPointID)

        Mask:SetActiveE(isOpen and 0 or 1)
        Name:SetActiveE(isOpen and 0 or 1)
        Desc:SetActiveE(isOpen and 0 or 1)
        NameTips.text = str
        Desc.text = _G.GetLangPackValue(v.Describe)
    end
end

---按钮点击事件在这里派发
function TeamHallViewXZNS:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_help then
        ---打开玩法说明页面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 172)
    end

    for k,v in pairs(self.cfg) do
        if go == self.go_table["aorbtn_Obj" .. k] then
            local isOpen = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(
                    v.function_open
            )

            if not isOpen then
                return
            end

            if v.id == 9 and not require("TradingCardsModel"):GetInstance():CheckOpen() then
                return
            end

            if v.Item_name ~= "" then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg[v.Item_name].Name)
            end
        end
    end
end

---界面的销毁函数
function TeamHallViewXZNS:OnDestroy()
    self:RemoveAllListener()
end

return TeamHallViewXZNS
