---@class TheSoulWillDecreeView : UIBaseView	中文描述
local TheSoulWillDecreeView = _G.BaseClass("TheSoulWillDecreeView", _G.UIBaseView)
local TheSoulWillDecreeModel = require "TheSoulWillDecreeModel":GetInstance()
local JinDu = {
    [101] = 100,
    [102] = 250,
    [103] = 400,
    [104] = 550,
    [105] = 700,
    [106] = 850
}
function TheSoulWillDecreeView:Awake()
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(78) == false then
        return
    end
    self.itemCard = {}
    self.itemCards = {}
    self.mission_extra_cfg = _G.ConfigManager.mission_extra_cfg
    self:ShuaXing()
end
function TheSoulWillDecreeView:OnEnable()
    self:ShuaXing()
end
function TheSoulWillDecreeView:OnCreate(activity)
    self.activity = activity
    self.typeCls = activity.typeClass
end
function TheSoulWillDecreeView:ShuaXing()
    for i = 1, 3 do
        local var = self.go_table["aorimage_frame" .. i]
        self.itemCard[i] = {}
        self.itemCard[i] = _G.GetAutoGoTable(var, _G.handlerbind(self, self.AddDianJiBtn, i))
        self:KaPaiZhanShi(i)
    end

    self.awardList = {}
    for i = 1, 6 do
        self.awardList[i] =
            _G.GetAutoGoTable(self.go_table["obj_award" .. i], _G.handlerbind(self, self.OnClickAward, i))
        self:UpdateAwardShow(i)
    end
    self:HunJiangZhaoLingNum()
end
---更新奖励显示
function TheSoulWillDecreeView:UpdateAwardShow(index)
    local tb = self.awardList[index]

    ---@type break_goal_cfg
    local cfg = _G.ConfigManager.break_goal_cfg[1 * 100 + index]
    _G.GameUtil.SetActiveByCondition(tb.obj_gou, false)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_on, false)

    if index < 6 then
        if TheSoulWillDecreeModel:CheckGetLoginAward(cfg.id) then
            _G.GameUtil.SetActiveByCondition(tb.obj_gou, true)
        elseif TheSoulWillDecreeModel:CheckCanTakeLoginAward(cfg.id) then
            _G.GameUtil.SetActiveByCondition(tb.aorimage_on, true)
        end
    else
        if TheSoulWillDecreeModel:CheckGetLoginAward(cfg.id) then
            _G.GameUtil.SetActiveByCondition(tb.obj_gou, true)
        elseif TheSoulWillDecreeModel:CheckCanTakeLoginAward(cfg.id) then
            _G.GameUtil.SetActiveByCondition(tb.aorimage_on, true)
        end
    end
    _G.UIUtils.SetItemNum(tb, cfg.reward[2], "X")
    -- tb.aortext_num.text = "x" .. cfg.rewards[1][2]
    tb.aorrawimage_icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(cfg.reward[1]))
    tb.aortext_day.text = cfg.value_active
    -- if not tb.effect then
    --     _G.UIUtils.LoadEffectByCfg(
    --         _G.ConfigManager.ui_effect_cfg.ef_FirstTestView_loop,
    --         tb.trans_effect,
    --         function(trans)
    --             tb.effect = trans
    --         end
    --     )
    -- end
end

---点击奖励
function TheSoulWillDecreeView:OnClickAward(go, isOn, index)
    local cfg = _G.ConfigManager.break_goal_cfg[1 * 100 + index]
    if TheSoulWillDecreeModel:CheckCanTakeLoginAward(cfg.id) then
        TheSoulWillDecreeModel:GetSignReward(
            cfg.id,
            function()
                self:UpdateAwardShow(index)
                self.typeCls:RefreshRedPoint()
            end
        )
    else
        require "CommonTipManager":GetInstance():OpenTip(go, cfg.reward[1])
    end
end

function TheSoulWillDecreeView:HunJiangZhaoLingNum()
    self.go_table.aortext_day.text = TheSoulWillDecreeModel.curr
    local xianShi = 100
    local w
    for i = 101, 106 do
        if _G.ConfigManager.break_goal_cfg[i].value_active < TheSoulWillDecreeModel.curr then
            xianShi = i
        end
    end
    if xianShi ~= 106 then
        xianShi = xianShi + 1
    end
    if xianShi == 101 then
        w = TheSoulWillDecreeModel.curr / _G.ConfigManager.break_goal_cfg[xianShi].value_active
    else
        w =
            ((TheSoulWillDecreeModel.curr - _G.ConfigManager.break_goal_cfg[xianShi - 1].value_active) /
            (_G.ConfigManager.break_goal_cfg[xianShi].value_active -
                _G.ConfigManager.break_goal_cfg[xianShi - 1].value_active))
    end

    if w > 1 then
        w = 1
    end
    if xianShi == 101 then
        self.go_table.aorimage_Fill:SetRectTransformSize(TheSoulWillDecreeModel.curr > 0 and w * 100 + 10 or 0, 9)
    else
        self.go_table.aorimage_Fill:SetRectTransformSize(
            TheSoulWillDecreeModel.curr > 0 and w * 150 + JinDu[xianShi - 1] or 0,
            9
        )
    end
end

function TheSoulWillDecreeView:KaPaiZhanShi(index)
    if index < 0 then
        return
    end
    local x = index

    local data
    local dataMax = false
    if TheSoulWillDecreeModel.RengWuSan[index] == 0 then
        dataMax = true
        data =
            self.mission_extra_cfg[
            TheSoulWillDecreeModel.RengWuList[index][_G.table.count(TheSoulWillDecreeModel.RengWuList[index])]
        ]
    else
        data = self.mission_extra_cfg[TheSoulWillDecreeModel.RengWuSan[index]]
    end

    if data ~= nil then
        self.itemCard[x].aortext_num.text = data.reward[1][2]
        self.itemCard[x].aortext_miaoshu.text = _G.ConfigManager.language_package_cfg[data.desc]
        local name, icon
        if _G.ConfigManager.item_cfg[data.reward[2][1]] ~= nil then
            name = _G.ConfigManager.item_cfg[data.reward[2][1]].Name
            icon = _G.ConfigManager.item_cfg[data.reward[2][1]].Icon
        else
            name = _G.ConfigManager.currency_type_cfg[data.reward[2][1]].name
            icon = _G.ConfigManager.currency_type_cfg[data.reward[2][1]].icon
        end
        self.itemCard[x].aortext_NameNum.text = _G.ConfigManager.language_package_cfg[name] .. "X" .. data.reward[2][2]

        self.itemCard[x].aorrawimage_icon:LoadImage(
            icon,
            function(image)
                if image then
                    image:SetActiveE(1)
                    image:SetNativeSize()
                end
            end
        )
        self.itemCard[x].aorbtn_gaoliang:SetActiveE(0)
        self.itemCard[x].aorimage_Hei:SetActiveE(0)
        local task, num
        if x == 1 then
            task = {data.id, data.condition[1][2], data.condition[1][2]}
        else
            task = {data.id, data.condition[1][2], data.condition[1][3]}
        end
        num = task[3]
        if dataMax then
            self.itemCard[x].aorimage_Hei:SetActiveE(1)
        else
            if TheSoulWillDecreeModel:GetInfoCall(x, task) >= task[3] then
                self.itemCard[x].aorbtn_gaoliang:SetActiveE(1)
            else
                num = TheSoulWillDecreeModel:GetInfoCall(x, task)
            end
        end

        -- if x == 1 then
        --     local datas
        --     if self.mission_extra_cfg[data.id - 1] == nil then
        --         datas = 0
        --     else
        --         datas = self.mission_extra_cfg[data.id - 1].count
        --     end
        --     self.itemCard[x].aortext_press.text = "<color=#FF0000>" .. num - datas .. "</color>/" .. data.count - datas
        --     self:CjSetLefJljd(self.itemCard[x].aorimage_cjjd, num - datas, data.count - datas)
        -- else
        self.itemCard[x].aortext_press.text = num .. "/" .. task[3]
        self:CjSetLefJljd(self.itemCard[x].aorimage_cjjd, num, task[3])
    -- end

    -- self.itemCard[x].aorimage_cjjd.fillAmount = num / task[3]
    end
end
---成就进度条显示
function TheSoulWillDecreeView:CjSetLefJljd(aorimage_cjjd, value, loopValue_Max)
    local w = value / loopValue_Max
    if w > 1 then
        w = 1
    end
    aorimage_cjjd:SetRectTransformSize(value > 0 and w * (210) or 0, 17)
end

function TheSoulWillDecreeView:AddDianJiBtn(go, _, index)
    local data
    if TheSoulWillDecreeModel.RengWuSan[index] == 0 then
        data =
            self.mission_extra_cfg[
            TheSoulWillDecreeModel.RengWuList[index][_G.table.count(TheSoulWillDecreeModel.RengWuList[index])]
        ]
        require "CommonTipManager":GetInstance():OpenTip(go, data.reward[2][1])
    else
        data = self.mission_extra_cfg[TheSoulWillDecreeModel.RengWuSan[index]]
        local task, num, curr
        if index == 1 then
            task = {data.id, data.condition[1][2], data.condition[1][2]}
        else
            task = {data.id, data.condition[1][2], data.condition[1][3]}
        end
        curr = data.reward[1][2]
        num = task[3]

        if TheSoulWillDecreeModel:GetInfoCall(index, task) >= task[3] then
            TheSoulWillDecreeModel:AccessFinish(
                task[1],
                0,
                function()
                    self:KaPaiZhanShi(index)
                    for i = 1, 6 do
                        self:UpdateAwardShow(i)
                    end
                    self:HunJiangZhaoLingNum()
                    self.typeCls:RefreshRedPoint()
                end,
                curr
            )
        end
    end
end

function TheSoulWillDecreeView:CloseView()
    self:Close()
end

function TheSoulWillDecreeView:OnClickBtn(go, isOn, viewName)
    local name = go:GetName()

    if name == self.curView then
        return
    end
    if name == "@_aorbtn_QianWang" then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.FuliView.Name)
    end
end

return TheSoulWillDecreeView
