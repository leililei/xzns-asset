require "BaseGameNet"

---@class TheSoulWillDecreeNet : BaseGameNet	通信协议
local TheSoulWillDecreeNet = _G.BaseClass("TheSoulWillDecreeNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return TheSoulWillDecreeNet TheSoulWillDecreeNet
function TheSoulWillDecreeNet:GetInstance()
    return self.super.super.GetInstance(self)
end

--获取魂将召令信息
---@param callback function 回调方法
function TheSoulWillDecreeNet:AccessToMap(callback)
    local item = _G.ConfigManager.net_map.game_break_goal_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.AccessCall))
    self.Call[port] = callback
end

--领取进度奖励
---@param callback function 回调方法
function TheSoulWillDecreeNet:AccessAward(pB, callback)
    local item = _G.ConfigManager.net_map.game_break_goal_award
    local port = base.Access(self, item, pB, _G.handler(self, self.AccessCall))
    self.Call[port] = callback
end

--提交突破之力任务
---@param callback function 回调方法
function TheSoulWillDecreeNet:AccessFinish(pB, callback)
    local item = _G.ConfigManager.net_map.game_break_goal_finish
    local port = base.Access(self, item, pB, _G.handler(self, self.AccessCall))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function TheSoulWillDecreeNet:AccessCall(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end
return TheSoulWillDecreeNet
