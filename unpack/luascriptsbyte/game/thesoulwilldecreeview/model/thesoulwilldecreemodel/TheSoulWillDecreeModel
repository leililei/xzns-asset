---@class TheSoulWillDecreeModel
local TheSoulWillDecreeModel = _G.BaseClass("TheSoulWillDecreeModel", _G.GameDataModelBase)
local TheSoulWillDecreeNet = require "TheSoulWillDecreeNet"
---创建对象时,入口构造函数
function TheSoulWillDecreeModel:__init()
    self.curFunctionOpenID = 78
end
--离散表中任务ID
local RengWu = 107001
---@return TheSoulWillDecreeModel TheSoulWillDecreeModel
function TheSoulWillDecreeModel:GetInstance()
    return self.super.GetInstance(self)
end

function TheSoulWillDecreeModel:GetDataFormServer(mag, activity, call)
    self.call = call
    self.activity = activity
    self.typeCls = activity.typeClass
    self.RengWuList = _G.ConfigManager.discrete_cfg[RengWu]
    ---当前三个展示任务
    self.RengWuSan = {[1] = 0, [2] = 0, [3] = 0}
    --    self:SetTimer()
    TheSoulWillDecreeNet:GetInstance():AccessToMap(_G.handler(self, self.GetInfoSuc))
end
function TheSoulWillDecreeModel:GetInfoSuc(mag, activity)
    if mag.ack ~= 1 then
        if _G.AppSetting.DEBUG then
            _G.Log("数据异常")
        end
        return
    end

    --已领取的奖励id
    self.a_list = mag.info.a_list or {}
    --需求进度值
    self.curr = mag.info.curr or 0
    -- 已完成的任务
    self.info = mag.info.finish_task or {}
    --预完成 未领奖的任务
    self.not_award_task = mag.info.not_award_task or {}
    --抽卡进度
    self.draw_num = mag.info.draw_num or 0

    self:HuoQuDQ()
    if self.call ~= nil then
        self.call()
    end
end
---当前展示任务获取
function TheSoulWillDecreeModel:HuoQuDQ()
    for i = 1, 3 do
        local bool = true
        for key, value in pairs(self.RengWuList[i]) do
            if self:FanHui(value, self.info) == false and bool then
                self.RengWuSan[i] = value
                bool = false
            elseif key == _G.table.count(self.RengWuList[i]) and bool then
                self.RengWuSan[i] = 0
            end
            self:JingDuNew(i)
        end
    end
end
---当前展示任务获取
function TheSoulWillDecreeModel:JingDuNew(index, count)
    if index == 1 then
        if self.draw_num ~= nil and count ~= nil then
            self.draw_num = self.draw_num + count
        end
    end
    if self.activity == nil then
        return
    end
    if self.RengWuSan == nil or self.RengWuSan[index] == 0 then
        return
    end

    if self:FanHui(self.RengWuSan[index], self.not_award_task) then
        return
    end
    local mission_extra_cfg = _G.ConfigManager.mission_extra_cfg
    for key, value in pairs(self.RengWuList[index]) do
        if self:FanHui(value, self.info) == false then
            if self:FanHui(value, self.not_award_task) == false then
                if index == 1 then
                    if mission_extra_cfg[value].condition[1][2] <= self.draw_num then
                        self:AccessFinish(value, 1)
                        _G.table.insert(self.not_award_task, value)
                    end
                elseif index == 2 then
                    local num =
                        _G.StorageManager:GetInstance():CheckCardStarCount(
                        mission_extra_cfg[value].condition[1][2],
                        mission_extra_cfg[value].condition[1][3]
                    )
                    if num >= mission_extra_cfg[value].count then
                        self:AccessFinish(value, 1)
                        _G.table.insert(self.not_award_task, value)
                    end
                elseif index == 3 then
                    local num =
                        _G.StorageManager:GetInstance():CheckCardLvCount(
                        {lv = mission_extra_cfg[value].condition[1][2]}
                    )
                    if num >= mission_extra_cfg[value].count then
                        self:AccessFinish(value, 1)
                        _G.table.insert(self.not_award_task, value)
                    end
                end
            end
        end
    end
end

function TheSoulWillDecreeModel:HongDianNew()
    if self.curr == nil then
        return false
    end
    if self.not_award_task ~= nil and self.RengWuSan ~= nil then
        for key, value in pairs(self.RengWuSan) do
            for keys, values in pairs(self.not_award_task) do
                if value == values then
                    return true
                end
            end
        end
    end
    for i = 101, 106 do
        if self:CheckGetLoginAward(i) then
        elseif self:CheckCanTakeLoginAward(i) then
            return true
        end
    end
    return false
end

--判断列表中是否存在
function TheSoulWillDecreeModel:FanHui(id, tip)
    if tip ~= nil then
        for key, value in pairs(tip) do
            if value == id then
                return true
            end
        end
    end
    return false
end
---检测奖励是否领取
function TheSoulWillDecreeModel:CheckGetLoginAward(id)
    return self:FanHui(id, self.a_list)
end
---检测是否能领取登录奖励
function TheSoulWillDecreeModel:CheckCanTakeLoginAward(id)
    local cfg = _G.ConfigManager.break_goal_cfg[id]
    return self.curr >= cfg.value_active and not self:CheckGetLoginAward(id)
end
---检测条件是否满足
function TheSoulWillDecreeModel:GetInfoCall(index, task)
    local star = task[2]
    local num = task[3]
    if self:FanHui(task[1], self.not_award_task) then
        return task[3]
    end

    if index == 1 then
        return self.draw_num
    elseif index == 2 then
        return _G.StorageManager:GetInstance():CheckCardStarCount(star, num)
    elseif index == 3 then
        return _G.StorageManager:GetInstance():CheckCardLvCount({lv = star})
    end
end
function TheSoulWillDecreeModel:GetSignReward(id, callback)
    local magw = {}
    magw.a_id = id
    TheSoulWillDecreeNet:GetInstance():AccessAward(
        magw,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.table.insert(self.a_list, id)
            require "CommonTipManager".OpenCommonAwardView(msg)
            if callback then
                callback()
            end
            -- require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FirstTest.id, 0)
        end
    )
end

function TheSoulWillDecreeModel:AccessFinish(id, num, callback, curr)
    local mags = {}
    mags.t_id = id
    mags.type = num
    TheSoulWillDecreeNet:GetInstance():AccessFinish(
        mags,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            if num == 1 then
                self.typeCls:RefreshRedPoint()
            elseif num == 0 then
                self.curr = self.curr + curr
                _G.table.insert(self.info, id)
                for key, value in pairs(self.not_award_task) do
                    if value == id then
                        _G.table.remove(self.not_award_task, key)
                    end
                end
                self:HuoQuDQ()
            end
            require "CommonTipManager".OpenCommonAwardView(msg)
            if callback then
                callback()
            end
            -- require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FirstTest.id, 0)
        end
    )
end

---检测活动是否结束
function TheSoulWillDecreeModel:CheckIsOvers()
end

return TheSoulWillDecreeModel
