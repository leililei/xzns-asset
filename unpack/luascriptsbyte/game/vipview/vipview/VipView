---@class VipView : UIBaseView	
---@field go_table VipView_GoTable
local VipView = _G.BaseClass("VipView", _G.UIBaseView)

function VipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    local day=_G.PlayerPrefsManager.GetInt("VIPRedTime",0,false)
    if day==0 then
        _G.PlayerPrefsManager.SetInt("VIPRedTime",_G.TimeUtil.GetServerUnixTime(),false)
        require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.MainRedPointVip.id)
    end
    day=_G.TimeUtil.GetInterValDayByGame(day,_G.TimeUtil.GetServerUnixTime())
    if day>=7 then
        _G.PlayerPrefsManager.SetInt("VIPRedTime",_G.TimeUtil.GetServerUnixTime(),false)
        require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.MainRedPointVip.id)
    end
end

function VipView:OnDestroy()
    self:RemoveAllListener()
end

function VipView:OnCreate()
    self:InitView()
end

---初始化视图
function VipView:InitView()
    local img = _G.GameUtil.GetFunctionData(_G.FunctionBlock.VipQRcode)
    local value=_G.GameUtil.GetFunctionData(_G.FunctionBlock.VIPtitleID)
    self.go_table.aortext_title.text=GetLangPackValue(value[1])
    self.go_table.aortext_vip.text=GetLangPackValue(value[2])
    if not string.IsNullOrEmpty(img) then
        self.go_table.aorrawimage_ma:LoadImage(img)
    end
end

---处理按钮事件
function VipView:OnClickBtn(go, isOn)
     if go == self.go_table.aorbtn_closeView then
        self:CloseView()
    elseif go == self.go_table.aorbtn_close then
        self:CloseView()
    end
end

function VipView:CloseView()
    self:Close()
end

return VipView
