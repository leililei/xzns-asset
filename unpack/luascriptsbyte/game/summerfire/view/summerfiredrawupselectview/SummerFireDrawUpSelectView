local JointActivityDrawUpModel = require("JointActivityDrawUpModel")
local BaseAwardNewItem = require("BaseAwardNewItem")

---@class SummerFireDrawUpSelectView : UIBaseView	中文描述
---@field public go_table SummerFireDrawUpSelectView_GoTable GoTable
---@field itemList SummerFireDrawUpSelectView._obj_Item_GoTable[]
local SummerFireDrawUpSelectView = _G.BaseClass("SummerFireDrawUpSelectView", _G.UIBaseView)
--_G.SummerFireDrawUpSelectView = SummerFireDrawUpSelectView

function SummerFireDrawUpSelectView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SummerFireDrawUpSelectView:OnCreate(ActivityID, call)
    self.ActivityID = ActivityID
    self.call = call
    self.AwardDatas = JointActivityDrawUpModel:GetInstance():Getlimited_itemId(self.ActivityID)
    self.coinId = JointActivityDrawUpModel:GetInstance():GetItemId(self.ActivityID)

    ---页面选中
    self.index = self.AwardDatas[1][1]
    self.indexqz = self.AwardDatas[1][2]
    if self.coinId ~= 0 then
        self.index = self.coinId
    end
    self.itemList = {}
    self.go_table.scrollloopvectical_AwardList:InitItemData(#self.AwardDatas, _G.handler(self, self.RefreshList))
end

function SummerFireDrawUpSelectView:RefreshList(index, obj)
    index = index + 1
    local instanceID = obj:GetInstanceIDE()
    local tb = self.itemList[instanceID]
    local data = self.AwardDatas[index]

    if not tb then
        tb = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj,_G.handlerbind(self, self.OnClickItem, index,tb,data[1]))
        self.itemList[instanceID] = tb
        tb.item = BaseAwardNewItem.New(tb.obj_Root, nil, 88, tb.obj_Root)
        tb.item:ShowWithID(data, nil, _G.handlerbind(self, self.ItemLoadedCall, tb))
        -- _G.ItemFactory:GetInstance():GetItemCard(
        --     _G.ItemFactory.itemType.ItemArtifactBase,
        --     tb.obj_Root, function(item)
        --         if not item then
        --             return
        --         end
        --         self.itemList[instanceID].item = item
        --         item:Show(data)
        --         item:HideLevel()
        --     end
        -- )
        --  _G.SetEventTrigger(tb.aorbtn_dianji, "onDown", _G.handler(self, self.onDown_Uplv))
        -- tb.aorbtn_dianji.LongPress = true
    else
        tb.item:ShowWithID(data, nil, _G.handlerbind(self, self.ItemLoadedCall, tb))
    end
    if self.index == self.AwardDatas[index][1] then
        tb.obj_eff:SetActiveE(1)
    else
        tb.obj_eff:SetActiveE(0)
    end


    -- local name = artifact_cfg.Name
    -- tb.aortext_name.text = _G.LangUtil.GetLangPackValue(name)
    --tb.aortext_probNum.text = (data.per * 100) .. "%"
end

function SummerFireDrawUpSelectView:ItemLoadedCall(itemLua, tb)
    tb.aortext_name.text = _G.GetLangPackValue(itemLua.item.cfg.Name or itemLua.item.cfg.name)
end

---点击切换
function SummerFireDrawUpSelectView:OnClickItem(_, _, index,item,data)
    if self.AwardDatas[index][1] == self.index then
        require "CommonTipManager":GetInstance():OpenTip(item.gameObject, data)
        return
    end
    self.index = self.AwardDatas[index][1]
    self.indexqz = self.AwardDatas[index][2]
    self.go_table.scrollloopvectical_AwardList:UpdateCount(#self.AwardDatas)
end

---点击奖励
function SummerFireDrawUpSelectView.OnClickonDown_Uplv(item, self)
    require "CommonTipManager":GetInstance():OpenTip(self.gameObject, item)
end

---按钮点击事件在这里派发
function SummerFireDrawUpSelectView:OnClickBtn(go, _)
    local name = go:GetName()
    if name == "@_aorbtn_shadow" or name == "@_aorbtn_close" or name == "@_aorbtn_quXiao" then
        self:Close()
    elseif name == "@_aorbtn_queding" then
        -- body
        if self.coinId == self.index then
            self:Close()
            return
        end

        JointActivityDrawUpModel:GetInstance():SetWish(
            self.ActivityID,
            self.index,
            self.indexqz,
            function()
                if self.call then
                    self.call(self.index)
                end
                self:Close()
            end
        )
    end
end

return SummerFireDrawUpSelectView
