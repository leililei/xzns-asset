local GuideNet = require("GuideNet")
---@class GuideModel : GameDataModelBase    引导
---@field GuideDot number 引导点
---@field GuideModelInfo teach_model_cfg_Item[]
---@field super GameDataModelBase
local GuideModel = _G.BaseClass("GuideModel", _G.GameDataModelBase)

---@return GuideModel GuideModel
function GuideModel:GetInstance()
    return self.super.GetInstance(self)
end

---公会数据类构造函数
function GuideModel:__init()
    self.GetDataFinish = false
    self.GuideDot = 0
    self.GuideModelInfo = {}
    self.GuideSkipId = 999999
    self.OtherDotList = {}
end

---拿数据
function GuideModel:GetDataFormServer()
    ---引导没开启不用拿数据
    if _G.AppSetting.IsShowTeach then
        self:GetSociatyInfo()
    else
        self.super.ParseData(self)
    end
end

---拿引导数据
function GuideModel:GetSociatyInfo()
    GuideNet:GetInstance():GetGuide(_G.handler(self, self.ParseData))
end

---数据回调
---@param msg guide.s2c_guide_info 引导打点相关数据
function GuideModel:ParseData(msg)
    if msg.ack == 1 then
        local ccr = _G.PlayerModel:GetInstance():CheckCreateRole()
        if ccr then
            self.GuideDot = msg.guide_id
            if msg.other_guides then
                self.OtherDotList = msg.other_guides
            end
        else
            self.GuideDot = 0
            self.OtherDotList = {}
        end
    end
    self.GetDataFinish = true
    self.super.ParseData(self)
end

---是否存在打点
function GuideModel:CheckOtherDot(groupId)
    if false == table.indexof(self.OtherDotList, groupId) then
        return false
    else
        return true
    end
end

---添加一个引导组ID
function GuideModel:AddOtherDot(groupId)
    if not self:CheckOtherDot(groupId) then
        table.insert(self.OtherDotList, groupId)
    end
end

---移除一个引导组ID
function GuideModel:RemoveOtherDot(groupId)
    if false ~= table.indexof(self.OtherDotList, groupId) then
        table.removebyvalue(self.OtherDotList, groupId)
    end
end

function GuideModel:Dispose()
    if _G.AppSetting.DEBUG then
        _G.Log("GuideModel:Dispose")
    end
    GuideModel = nil
end

---@return GuideModel
return GuideModel
