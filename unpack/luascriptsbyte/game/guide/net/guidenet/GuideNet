local SDKDef = require "SDKDef"
local base = require("BaseGameNet")
---@class GuideNet : BaseGameNet
---@field GetInstance fun():GuideNet
local GuideNet = BaseClass("GuideNet", base)

--region -------------静态变量-------------

--endregion

function GuideNet:__init()
end

---监听推送
function GuideNet:AddMessageListeners()
end

---获取引导数据
---@param callback function 完成回调
function GuideNet:GetGuide(callBack)
    local item = _G.ConfigManager.net_map.game_guide_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.GuildCall))
    self.Call[port] = callBack
end

---引导记录
---@param pbData guide.c2s_guide_dot PB数据
---@param callback function 完成回调
function GuideNet:InstanceDot(pbData, callBack)
    if pbData and pbData.guide_id == 101403 then
        _G.Log(pbData, "引导打点SDKDot_Tutorial")
        require("SDKDotManager"):GetInstance():SDKDot_Tutorial()
        _G.SDKManager:GetInstance():ReportExtraEvent(2)
        _G.SDKManager:GetInstance():ReportData(SDKDef.DotMsg.OverseasFT.tutorial_complete)
        _G.SDKManager:GetInstance():AttTip(SDKDef.ATTEvents.FinishGuide)
        _G.SDKManager:GetInstance():TrackEvent(SDKDef.DotMsg.Ru.finishguide)
    end

    if _G.AppSetting.IsDebugTeach then
        _G.LogError(pbData.guide_id, "主线引导打点")
    end
    local item = _G.ConfigManager.net_map.game_guide_dot
    local port = base.Access(self, item, pbData, _G.handler(self, self.GuildCall))
    self.Call[port] = callBack
end

---引导记录bi,为数据中心同步数据而加
---@param pbData guide.c2s_guide_bi PB数据
---@param callback function 完成回调
function GuideNet:DoBI(pbData, callBack)
    if _G.AppSetting.IsDebugTeach then
        _G.LogError(pbData.guide_id, "引导bi打点")
    end
    local item = _G.ConfigManager.net_map.game_guide_bi
    local port = base.Access(self, item, pbData, _G.handler(self, self.GuildCall))
    self.Call[port] = callBack
end

---触发引导记录
---@param pbData guide.c2s_guide_other PB数据
---@param callback function 完成回调
function GuideNet:OtherDot(pbData, callBack)
    if _G.AppSetting.IsDebugTeach then
        _G.LogError(pbData.guide_id, "触发引导打点")
    end
    local item = _G.ConfigManager.net_map.game_guide_other_guide
    local port = base.Access(self, item, pbData, _G.handler(self, self.GuildCall))
    self.Call[port] = callBack
end

--删除触发引导记录
---@param pbData guide.c2s_guide_other_del PB数据
---@param callback function 完成回调
function GuideNet:OtherDotDel(pbData, callBack)
    if _G.AppSetting.IsDebugTeach then
        _G.LogError(pbData.guide_id, "删除触发引导打点")
    end
    local item = _G.ConfigManager.net_map.game_guide_other_guide_del
    local port = base.Access(self, item, pbData, _G.handler(self, self.GuildCall))
    self.Call[port] = callBack
end

---请求回调 通用 返回 ack 字符Call
---@param port number 流水号Card
---@param data table 返回PB数据
---@param error string 错误信息
function GuideNet:GuildCall(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

function GuideNet:Dispose()
end

---@return GuideNet
return GuideNet
