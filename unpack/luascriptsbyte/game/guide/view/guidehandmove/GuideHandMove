---@class GuideHandMove : Component	中文描述
local GuideHandMove = _G.BaseClass("GuideHandMove", _G.Component)

---创建对象时,入口构造函数
function GuideHandMove:OnCreate(trans)
    self.transform = trans
    -- self.transform:GetChildE(0):GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator)).enabled = false
    self.parentTrans = self.transform:GetParent()
    self.speed = _G.ConfigManager.discrete_cfg[102105][1][1]
end

---销毁对象时,析构函数
function GuideHandMove:OnDestroy()
end

function GuideHandMove:Show(screenPos)
    local sX, sY = self:SwitchLocalPosition(screenPos.FromX, screenPos.FromY)
    self.transform:SetLocalPosition(sX, sY, 0)
    local eX, eY = self:SwitchLocalPosition(screenPos.ToX, screenPos.ToY)
    self.tweer =
        self.transform:DOLocalMove(
        eX,
        eY,
        0,
        _G.Vector2.Distance(_G.Vector2.New(sX, sY), _G.Vector2.New(eX, eY)) / self.speed,
        function()
        end
    ):SetLoops(-1):SetUpdate(true):SetEase(_G.CS.DG.Tweening.Ease.Linear)
end

function GuideHandMove:OnDisable()
    if self.tweer then
        self.tweer:Kill()
        self.tweer = nil
    end
end

function GuideHandMove:SwitchLocalPosition(x, y)
    return _G.CS.UnityObjectExtends.ScreenPointToLocalPointInRectangle(
        self.parentTrans,
        x,
        y,
        _G.UIManager:GetInstance().UICameraTop
    )
end

return GuideHandMove
