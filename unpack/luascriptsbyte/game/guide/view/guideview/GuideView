---@class GuideView : UIBaseView
---@field go_table GuideView_GoTable go_table节点
---@field CurGuideCfg teach_info_cfg 引导配置
---@field CurGuideModelCfg boolean 引导组强制配置
---@field CurGuideTxtCfg teach_text_cfg 文本框配置
---@field AddEffectList UnityEngine.Transform[] 动态显示特效
---@field AddPrefabList table[] 动态界面节点
local GuideView = _G.BaseClass("GuideView", _G.UIBaseView)
local GuideModel

function GuideView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    GuideModel = require("GuideModel")
end

--- 启动
function GuideView:OnCreate()
    self.AddEffectList = {}
    self.AddPrefabList = {}
    self.PivotVec = _G.Vector2.New(0, 0)
    self.V2 = _G.Vector2.New(0, 0)
    self.camera3d = _G.GameObject.Find("GraphicsManager/MainCamera/3DUICam"):GetComponentE(_G.typeof(_G.CS.UnityEngine.Camera))
    self.cameramain = _G.GameObject.Find("GraphicsManager/MainCamera"):GetComponentE(_G.typeof(_G.CS.UnityEngine.Camera))
    self.TopLayerT = _G.UIManager:GetInstance().TopLayer:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    self.camera = _G.UIManager:GetInstance().UICamera
    self.rtfuy = _G.CS.UnityEngine.RectTransformUtility
    self:ResetView()
end

---显示隐藏
---@param parent UnityEngine.GameObject 挂接对象
---@param show boolean 显示与否
---@param effectId string 特效节点
---@param callback function 加载特效完成回调
function GuideView:ShowObject(parent, show, effectId)
    if show then
        local len = parent:GetChildCountE()
        if len > 0 then
            for i = 1, len do
                _G.GameUtil.SetActiveByCondition(parent:GetChildE(i - 1), false)
            end
        end

        if effectId == "" then
            effectId = "Ef_yindaoshoushi"
        end

        if _G.AppSetting.IsDebugTeach then
            _G.Log(effectId, "手示特效路径>>>>>>>>>>>>>>>")
        end

        local cfg = _G.ConfigManager.ui_effect_cfg[effectId]

        if _G.AppSetting.IsDebugTeach then
            _G.Log(cfg, "手示特效配置>>>>>>>>>>>>>>>")
        end

        if nil == self.AddEffectList[cfg.Path] then
            self.AddEffectList[cfg.Path] = 1
            _G.UIUtils.LoadEffectByCfg(
                    cfg,
                    parent,
                    function(tran)
                        self.AddEffectList[cfg.Path] = tran
                        _G.GameUtil.SetActiveByCondition(tran, true)
                    end
            )
        else
            if 1 ~= self.AddEffectList[cfg.Path] then
                _G.GameUtil.SetActiveByCondition(self.AddEffectList[cfg.Path], true)
            end
        end
    end
    _G.GameUtil.SetActiveByCondition(parent, show)
end

---添加一个预制
---@param parent UnityEngine.Transform 节点添加到
---@param path string 节点路径
---@param back function 回调
function GuideView:AddPrefab(parent, path, back)
    if nil == self.AddPrefabList[path] then
        self.AddPrefabList[path] = {}
        self.AddPrefabList[path].back = back
        _G.PoolsManager:GetInstance():Spawn(
                path,
                _G.ePoolType.UIItem,
                parent,
                function(tran)
                    self.AddPrefabList[path].goTable = _G.GetAutoGoTable(tran, _G.handler(self, self.OnClickInllustrationBtn))
                    if self.AddPrefabList[path].back then
                        self.AddPrefabList[path].back()
                    end
                end
        )
    else
        self.AddPrefabList[path].back = back
        if self.AddPrefabList[path].goTable then
            if self.AddPrefabList[path].back then
                self.AddPrefabList[path].back()
            end
        end
    end
end

---插画界面点击
function GuideView:OnClickInllustrationBtn(go)
    local name = go:GetName()

    if _G.AppSetting.IsDebugTeach then
        _G.Log(name, "插画界面点击按钮>>>>>")
    end
    if name == "@_aorbtn_x" then
        ---插画关闭
        self:GotoNextStep()
    elseif name == "@_aorbtn_CloseView" then
        ---插画关闭
        if self.CanClickText then
            self:GotoNextStep()
        end
    elseif name == "@_aorbtn_IllLeft" then
        self.IllPage = self.IllPage - 1
        self:UpdateIllBtn()
        self.IlluAnim:Play("a_guideview_Illustration_nor")
        self.IlluAnim:Update(0)
        self.IlluAnim:Play("a_guideview_Illustration_fanye")
        self.IllurContent.enabled = true
        self.IllurContent:Play("a_guideview_contentqiehuan_left")
    elseif name == "@_aorbtn_IllRight" then
        self.IllPage = self.IllPage + 1
        self:UpdateIllBtn()
        self.IlluAnim:Play("a_guideview_Illustration_nor")
        self.IlluAnim:Update(0)
        self.IlluAnim:Play("a_guideview_Illustration_fanye")
        self.IllurContent.enabled = true
        self.IllurContent:Play("a_guideview_contentqiehuan_right")
    end
end

---QTE的特效
function GuideView:QTEEffect(back)
    self.obj_QTElongtime = _G.InstantiateObject(self.go_table.obj_QTElongtime, self.go_table.obj_GuideCommon)
    self.obj_QTElongtime:SetAnchorPosition(0, 0)
    local open, release, click = false
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_QTEOpen,
            self.obj_QTElongtime,
            function(trans)
                _G.GameUtil.SetActiveByCondition(trans, false)
                self.QTETranOpen = trans
                self.QTETranOpen:SetAnchorPosition(0, -168)
                open = true
                if open and release and click then
                    if back then
                        back()
                    end
                end
            end
    )
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_QTERelease,
            self.obj_QTElongtime,
            function(trans)
                _G.GameUtil.SetActiveByCondition(trans, false)
                self.QTETranRelease = trans
                self.QTETranRelease:SetAnchorPosition(0, -168)
                release = true
                if open and release and click then
                    if back then
                        back()
                    end
                end
            end
    )

    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_QTEClick,
            self.obj_QTElongtime,
            function(trans)
                _G.GameUtil.SetActiveByCondition(trans, false)
                self.QTETranClick = trans
                self.QTETranClick:SetAnchorPosition(0, -168)
                click = true
                if open and release and click then
                    if back then
                        back()
                    end
                end
            end
    )
end

---拖拽
function GuideView:OnDragMove(_, data)
    if self.CurGuideCfg.function_id == "AfkEmbattleView" or self.CurGuideCfg.function_id == "EmbattleCombineSkillView" then
        self.YDarg:OnDrag(data)
    else
        self.YDarg:OnDrag(data)
    end
end

---拖拽开始
function GuideView:OnDragBegin(_, data)
    self.IsDoDrag = true
    if self.CurGuideCfg.function_id == "AfkEmbattleView" or self.CurGuideCfg.function_id == "EmbattleCombineSkillView" then
        self.YDarg:OnBeginDrag(data)
    else
        self.YDarg:OnBeginDrag(data)
        self:StopUpdate()
    end
end

---拖拽结束
function GuideView:OnDragEnd(_, data)
    if self.CurGuideCfg.function_id == "AfkEmbattleView" or self.CurGuideCfg.function_id == "EmbattleCombineSkillView" then
        self.YDarg:OnEndDrag(data)
        if self.IsDoDrag then
            self:GotoNextStep()
            self.IsDoDrag = false
        end
    else
        if self.CurGuideCfg.teach_type == _G.GuideTeachType.Fight and _G.CS.BattleManager.Inst.battleGuideManager ~= nil then
            _G.CS.BattleManager.Inst.battleGuideManager:DoCustomGuide(self.CurGuideCfg.id)
        end
        self.YDarg:OnDragEnd(data)
        if self.IsDoDrag then
            self:GotoNextStep()
            self.IsDoDrag = false
        end
    end
end

---手指松开
function GuideView:OnPointerUp(_, data)
    if self.CurGuideCfg.function_id == "AfkEmbattleView" then
        self.YDarg:OnPointerUp(data)
        if self.IsDoDrag then
            self:GotoNextStep()
            self.IsDoDrag = false
        end
    end
end

---开启更新（处理高亮和按钮等相关位置）
function GuideView:StartUpdate()
    ---如果本步骤需要刷新时
    if self.CurGuideCfg.refresh then
        ---如果有点击或者高亮对象时开启同步位置计时器
        if self.CurGuideCfg.click_tag ~= "" or #self.CurGuideCfg.highlight_tag > 0 then
            if nil == self.UpdateTimer then
                self.UpdateTimer = _G.TimerManager:GetInstance():GetTimer(0.1, self.UpdateTimerBack, self, false, false)
                self.UpdateTimer:Start()
            end
        end
    end
end

---关闭更新
function GuideView:StopUpdate()
    if self.UpdateTimer then
        self.UpdateTimer:Stop()
        self.UpdateTimer = nil
    end
end

---更新按钮和高亮
function GuideView:UpdateTimerBack()
    self:UpdateBtnInfo()
    self:UpdateHighLightInfo()
end

---检测界面进度
function GuideView:CoOnProgress()
    if _G.AppSetting.IsDebugTeach then
        _G.Log("引导界面协程校验开始")
    end
    ---如果当步有延迟处理(只有处理动效的时候需要添加精准延迟)
    if self.CurGuideCfg.delay_time > 0 then
        local frame = 0

        if _G.AppSetting.IsDebugTeach then
            _G.Log(self.CurGuideCfg.delay_time, "延迟时间")
        end
        while frame < self.CurGuideCfg.delay_time do
            frame = frame + 1
            _G.coroutine.yield()
        end
    end
    _G.coroutine.yield()
    local name = self.CurGuideCfg.function_id
    ---如果是常规界面需要挂起等界面加载完成
    if self.CurGuideCfg.teach_type == _G.GuideTeachType.Function then
        if name == _G.ConfigManager.ui_cfg.MainView.Name then
            ---如果没有在主界面了就不执行
            if self.CurGuideModelCfg.not_force == true then
                while not _G.GuideManager:GetInstance():CheckMainViewTab(self.CurGuideCfg) do
                    _G.coroutine.yield()
                    _G.GuideManager:GetInstance():DoBreak()
                end
            end
            local queue = _G.MainManager:GetInstance().HasMainDisplayQueue
            local popWindow = _G.PopWindowManager:GetInstance():IsPopQueueFun()
            ---有队列的话，就不打开蒙版
            if queue or popWindow then
                _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_szsGuideFull, false)

                if _G.AppSetting.IsDebugTeach then
                    _G.Log("主界面存在队列未播放>>>>>>>>>>>>>")
                end
            end
            while queue or popWindow do
                --引导会等待队列
                if _G.AppSetting.IsDebugTeach then
                    _G.LogWarning("主界面存在队列未播放，请检查是否存在异常, 如是正常队列执行过程，请忽略")
                end
                queue = _G.MainManager:GetInstance().HasMainDisplayQueue
                popWindow = _G.PopWindowManager:GetInstance():IsPopQueueFun()
                _G.coroutine.yield()
            end

            if _G.AppSetting.IsDebugTeach then
                _G.Log(name, "0.<color=red>主界面验证队列播放完成</color>")
            end
        end
        local uimgr = _G.UIManager:GetInstance()
        local nowWindow = uimgr:GetWindow(name)

        if _G.AppSetting.IsDebugTeach then
            _G.Log(name, "1.<color=red>校验窗口对象是否存在</color>")
        end
        local lastTime = _G.TimeUtil:GetServerUnixTime()
        while _G.IsNil(nowWindow) do
            nowWindow = uimgr:GetWindow(name)
            _G.coroutine.yield()

            self:EndGuideGroup(lastTime)
        end

        if _G.AppSetting.IsDebugTeach then
            _G.Log(name, "2.<color=yellow>校验显示对象是否存在</color>")
        end
        while _G.IsNil(nowWindow.View.gameObject) do
            _G.coroutine.yield()

            self:EndGuideGroup(lastTime)
        end

        if _G.AppSetting.IsDebugTeach then
            _G.Log(name, "3.<color=yellow>校验显示对象是否显示中</color>")
        end
        while nowWindow.View and 0 == nowWindow.View.gameObject:GetActiveSelf() do
            _G.coroutine.yield()

            self:EndGuideGroup(lastTime)
        end
        if name == _G.ConfigManager.ui_cfg.MainView.Name then
            -- nowWindow.View:SetFunctionShow(true)
        end

        if _G.AppSetting.IsDebugTeach then
            _G.Log(name, "4.<color=green><size=20>功能类型校验完成></size></color>")
        end
    else
        if _G.AppSetting.IsDebugTeach then
            _G.Log(name, "<color=green><size=20>战斗类型校验完成></size></color>")
        end
    end

    self.HasClickAction = self.CurGuideCfg.click_tag ~= ""

    ---有路径并且配的点击就找按钮
    if self.HasClickAction then
        local errorTipsFrame = 0
        local btnTrans
        local path = self.CurGuideCfg.click_tag

        if _G.AppSetting.IsDebugTeach then
            _G.Log(path, "点击按钮路径")
        end
        while _G.IsNil(btnTrans) do
            btnTrans = _G.FindObject(path)
            _G.coroutine.yield()

            errorTipsFrame = errorTipsFrame + 1
            if errorTipsFrame > 150 then
                self:DotCurrentAndOver()
            end
        end

        while btnTrans:GetActiveSelf() == 0 do
            _G.coroutine.yield()

            errorTipsFrame = errorTipsFrame + 1
            if errorTipsFrame > 300 then
                self:DotCurrentAndOver()
            end
        end

        _G.coroutine.yield()
    end

    if self.GuideWiatCoroutine ~= nil then
        _G.coroutine.stopwaiting(self.GuideWiatCoroutine)
        self.GuideWiatCoroutine = nil
    end
    self:AllFinish()
end

function GuideView:EndGuideGroup(lastTime)
    local time = _G.ConfigManager.discrete_cfg[120009][1][1]
    if _G.TimeUtil:GetServerUnixTime() - lastTime >= time then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.CommonAwardView.Name)
        if view then
            return
        end
        self:DotCurrentAndOver()
    end
end

---打点当前引导组并且结束引导组逻辑
function GuideView:DotCurrentAndOver()
    local endnode = self.CurGuideModelCfg.end_node
    local GuideNet = require("GuideNet")
    ---@type guide.c2s_guide_dot
    local msg = {}
    msg.guide_id = endnode
    local info = {}
    info.guideId = endnode
    info.guideDot = GuideModel:GetInstance().GuideDot
    GuideNet:GetInstance():InstanceDot(msg, _G.handlerbind(self, self.BackInstanceDot, info))
    GuideModel:GetInstance().GuideDot = endnode

    if _G.AppSetting.IsDebugTeach then
        _G.LogError(self.CurGuideCfg.click_tag, "引导点击按钮路径异常>>>>>>>>>>>>>>>")
    end

    _G.GuideManager:GetInstance():DoBreak()
end

---准备就绪布置界面
function GuideView:AllFinish()
    if _G.AppSetting.IsDebugTeach then
        _G.Log(self.CurGuideCfg.id, "引导界面准备就绪===id>>>>>>")
    end
    self.CanClickText = false
    local clickCd = _G.ConfigManager.discrete_cfg[102101] and _G.ConfigManager.discrete_cfg[102101][1][1] or 0
    if clickCd > 0 then
        _G.DelayDo(
                clickCd,
                function()
                    self.CanClickText = true
                end
        )
    else
        self.CanClickText = true
    end

    ---引导语音
    if self.CurGuideCfg.audio > 0 then
        if _G.AppSetting.IsDebugTeach then
            _G.Log(self.CurGuideCfg.id, "播放引导语音>>>>>>" .. self.CurGuideCfg.audio .. ">>>>>>>")
        end
        if _G.GuideManager:GetInstance().CurAudio then
            _G.AudioManager.StopSound(_G.GuideManager:GetInstance().CurAudio)
        end
        _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, self.CurGuideCfg.audio)
        _G.GuideManager:GetInstance().CurAudio = self.CurGuideCfg.audio
    end

    ---更新界面显示信息
    self:UpdateShowInfo()
    ---开启位置更新
    self:StartUpdate()
    ---超时后强制进入下一步引导
    self:ForceNextGuide()
    self:CheckEmbattleCard()
    if self.CurGuideCfg and self.CurGuideCfg.id == 100101 then
        _G.SDKManager:GetInstance():ReportData(require("SDKDef").DotMsg.OverseasFT.tutorial_begin)
    end
end

---检测放置关卡是否上阵某张卡
function GuideView:CheckEmbattleCard()
    if self.CurGuideCfg then
        local cardId = self.CurGuideCfg.embattle_check
        if not cardId or cardId == 0 then
            return
        end

        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.EmbattleView.Name)
        if view and view.curEmbattleItem and view.curEmbattleItem.curEmbattleData then
            for _, v in ipairs(view.curEmbattleItem.curEmbattleData) do
                if v.sid == cardId then
                    return
                end
            end

            --未在布阵上找到对应卡牌，自动上阵
            view:OnClickBtn(view.go_table.aorbtn_auto, true)
        end
    end
end

function GuideView:StopForceTimer()
    if self.forceTimer then
        self.forceTimer:Stop()
        self.forceTimer = nil
    end
end

function GuideView:ForceNextGuide()
    local nextCd = self.CurGuideCfg.next_cd
    if nextCd and nextCd > 0 then
        self.forceTimer = _G.TimerManager:GetInstance():GetTimer(
                self.CurGuideCfg.next_cd,
                function()
                    self:StopForceTimer()
                    if _G.GuideManager:GetInstance().CurGuideCfg then
                        self:GotoNextStep(self.HasClickAction)
                    end
                end,
                self,
                true,
                false
        )
        self.forceTimer:Start()
    end
end

---更新显示
function GuideView:UpdateView(curGuideCfg, curGuideModelCfg)
    if _G.AppSetting.IsDebugTeach then
        _G.Log(curGuideCfg.id, "引导界面启动===id>>>>>>")
    end
    self.CurGuideCfg = curGuideCfg
    self.CurGuideModelCfg = curGuideModelCfg
    self:StopForceTimer()
    if require("DouyinModel"):GetInstance():DouyinFeedScene() then
        ---通过抖音直接进入游戏的时候打断引导
       _G.GuideManager:GetInstance():DotCurrentAndOver() 
    end

    ---寻路的节点锁屏等待
    if self.CurGuideCfg.node == _G.GuideNodeType.WaitNav then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_szsGuideFull, true)

        self:ShowObject(self.go_table.obj_naving, true, _G.ConfigManager.ui_effect_cfg.Ef_yindaoxunlu)
        return
    end
    ---没有操作的结束结点，打点去到下一步
    if
    (self.CurGuideCfg.node == _G.GuideNodeType.End and self.CurGuideCfg.click_tag == "" and
            self.CurGuideCfg.text_type == 0) or
            (self.CurGuideCfg.node == _G.GuideNodeType.Irreversible and self.CurGuideCfg.click_tag == "" and
                    self.CurGuideCfg.text_type == 0)
    then
        if _G.AppSetting.IsDebugTeach then
            _G.Log(self.CurGuideCfg.id, "没有操作的结束结点，打点去到下一步>>>>>>>>>>>>>>")
        end
        if _G.GuideManager:GetInstance().LoseGuideId > 0 then
            ---如果是失败特殊节点，不参与打点

            if _G.AppSetting.IsDebugTeach then
                _G.Log(_G.GuideManager:GetInstance().LoseGuideId, "不打点，失败节点>>>")
            end
        elseif self.CurGuideModelCfg.make_type then
            if _G.AppSetting.IsDebugTeach then
                _G.Log(_G.GuideManager:GetInstance().LoseGuideId, "不打点，触发式节点>>>")
            end
        else
            local GuideNet = require("GuideNet")
            ---@type guide.c2s_guide_dot
            local msg = {}
            msg.guide_id = self.CurGuideCfg.id
            local info = {}
            info.guideId = self.CurGuideCfg.id
            info.guideDot = GuideModel:GetInstance().GuideDot
            GuideNet:GetInstance():InstanceDot(msg, _G.handlerbind(self, self.BackInstanceDot, info))
            GuideModel:GetInstance().GuideDot = self.CurGuideCfg.id
        end

        _G.GuideManager:GetInstance():DoNext()
        return
    end

    if _G.AppSetting.IsDebugTeach then
        _G.Log(curGuideCfg.id, "引导界面节点可用===id>>>>>>")
    end

    if self.GuideWiatCoroutine == nil then
        if _G.AppSetting.IsDebugTeach then
            _G.Log("引导界面协程开启")
        end
        self.GuideWiatCoroutine = _G.coroutine.start(_G.handler(self, self.CoOnProgress))
    end
    ---默认0开启预设遮挡
    if self.CurGuideCfg.set_obstacle == false then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_szsGuideFull, true)
    end
end

---更新蒙版
function GuideView:UpdateShowAorBtnFull(isStory)
    if isStory then
        ---引导类型（0=强制 1=非强制）
        if self.CurGuideModelCfg.not_force == false then
            local queue = _G.MainManager:GetInstance().HasMainDisplayQueue
            local popWindow = _G.PopWindowManager:GetInstance():CheckPopWindowAndQuene()
            ---有队列的话，就不打开蒙版
            if queue or popWindow then
                if _G.AppSetting.IsDebugTeach then
                    _G.LogError("剧情结束存在队列")
                end
                _G.GuideManager:GetInstance():DoRePlay(self.CurGuideCfg.id)
            else
                _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_szsGuideFull, true)
            end
        else
            _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_szsGuideFull, false)
        end
    else
        ---引导类型（0=强制 1=非强制）
        if self.CurGuideModelCfg.not_force == false then
            _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_szsGuideFull, true)
        else
            _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_szsGuideFull, false)
        end
    end
end

---更新界面显示信息
function GuideView:UpdateShowInfo()
    if _G.AppSetting.IsDebugTeach then
        _G.Log(self.CurGuideCfg, "引导界面节点信息")
    end

    self.HasClickAction = self.CurGuideCfg.click_tag ~= "" and self.CurGuideCfg.click_type[1] == _G.GuideClickType.Click

    self:InitBtnInfo()
    ---如果配了按钮没有对就跳过了
    if _G.IsNil(self.ClickBtnTrans) and self.HasClickAction then
        return
    end

    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_szsGuideClick, self.HasClickAction)
    local hasArrow = self.CurGuideCfg.arrow_image > 0
    if hasArrow then
        if self.CurGuideCfg.click_type[1] == _G.GuideClickType.Drag then
            self:ShowObject(self.go_table.obj_arrow, false)
            self:ShowObject(self.go_table.obj_arrowDrag, true, self.CurGuideCfg.arrow_effect)
        else
            self:ShowObject(self.go_table.obj_arrow, true, self.CurGuideCfg.arrow_effect)
            self:ShowObject(self.go_table.obj_arrowDrag, false)
        end
    else
        self:ShowObject(self.go_table.obj_arrow, false)
        self:ShowObject(self.go_table.obj_arrowDrag, false)
    end

    ---引导类型（0=强制 1=非强制）
    if self.CurGuideModelCfg.not_force == false then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_szsGuideFull, true)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_szsGuideFull, false)
    end

    local alpha = self.CurGuideCfg.mask_type and 0.8 or 0
    self.go_table.aorimage_maskdi.Alpha = alpha

    self:InitHighLightInfo()

    ---拖拽
    self.Drag = self.go_table.aorimage_szsGuideDrag:GetComponentE(_G.typeof(_G.CS.EventTriggerListener))

    if self.CurGuideCfg.click_type[1] == _G.GuideClickType.Drag then
        local path = self.CurGuideCfg.click_tag

        if _G.AppSetting.IsDebugTeach then
            _G.Log(path, "拖拽路径")
        end
        if
        self.CurGuideCfg.function_id == "AfkEmbattleView" or
                self.CurGuideCfg.function_id == "EmbattleCombineSkillView"
        then
            self.YDarg = _G.GetEventTrigger(_G.FindObject(path))
        else
            ---有路径就找按钮
            if "" ~= path then
                self.YDarg = _G.FindObject(path):GetComponentE(_G.typeof(_G.CS.AorDrag))
            end
        end

        self.Drag.onDrag = _G.handler(self, self.OnDragMove)
        self.Drag.onDragBegin = _G.handler(self, self.OnDragBegin)
        self.Drag.onDragEnd = _G.handler(self, self.OnDragEnd)
        self.Drag.onUp = _G.handler(self, self.OnPointerUp)

        local btnRect = _G.UIUtils.GetRectTrans(self.YDarg)
        local maskRect = _G.UIUtils.GetRectTrans(self.Drag)
        self:PosTransformtion(self.YDarg, self.Drag, btnRect, maskRect)
        local x, y, z = self.Drag:GetLocalPosition()
        self.go_table.obj_arrowDrag:SetAnchorPosition(
                x + (self.CurGuideCfg.arrow_deviation[1] or 0),
                y + (self.CurGuideCfg.arrow_deviation[2] or 0),
                0
        )
        local xscale = 1
        if self.CurGuideCfg.arrow_image == 1 then
            xscale = -1
        end
        self.go_table.obj_arrowDrag:SetLocalScale(xscale, 1, 1)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_szsGuideDrag, true)
    else
        self.Drag.onDrag = nil
        self.Drag.onDragBegin = nil
        self.Drag.onDragEnd = nil
        self.Drag.onUp = nil
    end

    ---连点双击
    if self.CurGuideCfg.click_type[1] == _G.GuideClickType.ClickMore then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_szsGuideDoubleClick, true)
        local path = self.CurGuideCfg.click_tag

        if _G.AppSetting.IsDebugTeach then
            _G.Log(path, "连点双击路径")
        end
        ---有路径就找按钮
        if "" ~= path then
            self.DoubleClick = _G.FindObject(path):GetComponentE(_G.typeof(_G.CS.EventTriggerListener))
        end
        local btnRect = _G.UIUtils.GetRectTrans(self.DoubleClick)
        local maskRect = _G.UIUtils.GetRectTrans(self.go_table.obj_szsGuideDoubleClick)
        self:PosTransformtion(self.DoubleClick, self.go_table.obj_szsGuideDoubleClick, btnRect, maskRect)
        local x, y, z = self.go_table.obj_szsGuideDoubleClick:GetLocalPosition()

        self.go_table.obj_arrow:SetAnchorPosition(
                x + (self.CurGuideCfg.arrow_deviation[1] or 0),
                y + (self.CurGuideCfg.arrow_deviation[2] or 0)
        )
        _G.SetEventTrigger(
                self.go_table.obj_szsGuideDoubleClick,
                "onDoubleClick",
                function()
                    self.DoubleClick.onDoubleClick:Invoke()
                    self:GotoNextStep()
                end
        )
    end

    ---如果有文本类型就显示对应文本框否则不显示
    if self.CurGuideCfg.text_type > 0 then
        self.CurGuideTxtCfg = _G.ConfigManager.teach_text_cfg[self.CurGuideCfg.text_type]

        if _G.AppSetting.IsDebugTeach then
            _G.Log(tostring(_G.table.keyof(_G.GuideTextBox, self.CurGuideTxtCfg.txt_type)), "文本框类型")
        end
        if self.CurGuideTxtCfg.txt_type == _G.GuideTextBox.Full then
            ---全屏文本框
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_full, true)
            if not _G.IsNil(self.model) then
                require("CardInfoManager").DelRole(self.model, _G.ePoolType.Temporary)
                self.model = nil
            end
            local rolePath = self.CurGuideTxtCfg.photo_route[1]
            if _G.AppSetting.IsArraigned then
                rolePath = self.CurGuideTxtCfg.photo_route_tishen[1]
            end
            local isLoad = true
            if _G.AppSetting.IsXzns then
                isLoad = not GameUtil.IsHeXieHide()
            end
            if isLoad then
                require("CardInfoManager").GetRole(
                        rolePath,
                        _G.ePoolType.Temporary,
                        self.go_table.obj_spine,
                        _G.RoleEffTypeEnum.Dialogue,
                        function(trans)
                            if _G.IsNil(self.go_table.obj_spine) then
                                _G.DestroyObject(trans)
                                return
                            end
                            if not self.CurGuideTxtCfg then
                                require("CardInfoManager").DelRole(trans, _G.ePoolType.Temporary)
                                return
                            end
                            if trans then
                                self.model = trans
                            end
                            local size = self.CurGuideTxtCfg.size or 1
                            trans:SetLocalScaleXYZ(size)
                            local pos = self.CurGuideTxtCfg.pos_portrait or { 0, 0, 0 }
                            trans:SetLocalPosition(pos[1], pos[2], pos[3])
                            if _G.AppSetting.IsXzns then
                                local cardCfg = _G.table.find(_G.ConfigManager.card_cfg, function(card)
                                    if card.ModelPathHi == rolePath then
                                        return card
                                    end
                                end)
                                if cardCfg then
                                    local spineCfg = _G.ConfigManager.card_show_cfg[cardCfg.id]
                                    local idle = spineCfg.display_idle[1]
                                    GameUtil.SetCardUiSpineAnimation(trans, idle, true)
                                end
                            end
                        end
                )
            end
            self.go_table.aortext_fullContent.text = _G.LangUtil.GetLangPackValue(self.CurGuideCfg.text)
        elseif self.CurGuideTxtCfg.txt_type == _G.GuideTextBox.Tips then
            ---提示性小文本框
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_tips, true)
            local imgPath = self.CurGuideTxtCfg.photo_route[1]
            if _G.AppSetting.IsArraigned then
                imgPath = self.CurGuideTxtCfg.photo_route_tishen[1]
            end
            self.go_table.aorrawimage_tipslh:LoadImage(imgPath)
            self.go_table.aortext_tipsContent.text = _G.LangUtil.GetLangPackValue(self.CurGuideCfg.text)
        elseif self.CurGuideTxtCfg.txt_type == _G.GuideTextBox.Inllustration then
            ---全屏插画
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_Illustration, true)
            self:AddPrefab(
                    self.go_table.obj_Illustration,
                    "UI/Guide/$_obj_Illustration",
                    function()
                        self.IlluAnim = self.go_table.obj_Illustration:GetChildE(0):GetComponentE(_G.typeof(CS.UnityEngine.Animator))

                        _G.AudioManager.PlayAudioByAudioCfgID(2030)
                        self.IllPage = 1
                        self.IllMaxPage = 1

                        local count = 0
                        if _G.AppSetting.IsArraigned then
                            count = #self.CurGuideTxtCfg.photo_route_tishen
                        else
                            count = #self.CurGuideTxtCfg.photo_route
                        end
                        if count > 1 then
                            self.IllMaxPage = count
                        end

                        self:UpdateIllBtn()
                    end
            )
        elseif self.CurGuideTxtCfg.txt_type == _G.GuideTextBox.Vedio then
            ---@type video_cfg_Item
            local cfg = _G.ConfigManager.video_cfg[self.CurGuideTxtCfg.video]
            if cfg then
                ---播放视频
                _G.GuideManager:GetInstance():PlayGuideVideo(cfg, _G.handler(self, self.OnVideoPlayComplete))

                ---视频预处理
                if self.CurGuideTxtCfg.video_load ~= "" then
                    _G.UIUtils.Preload(_G.ConfigManager.video_cfg[self.CurGuideTxtCfg.video_load])
                end

                if self.CurGuideCfg.click_type[1] == _G.GuideClickType.LongTime then
                    self:QTEEffect(
                            function()
                                local animator = self.QTETranOpen:FindE("effect"):GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))

                                _G.GameUtil.SetActiveByCondition(self.QTETranOpen, true)
                                animator:Play("a_ef_QTE_Open")
                                _G.GameUtil.SetActiveByCondition(self.obj_QTElongtime, true)

                                local function doHide()
                                    self.obj_QTElongtime:GetComponentE(_G.typeof(_G.CS.AorEmptyGraphic)).enabled = false
                                    self.obj_QTElongtime:GetComponentE(_G.typeof(_G.CS.EventTriggerListener)).enabled = false
                                    _G.GameUtil.SetActiveByCondition(self.QTETranOpen, true)
                                    _G.GameUtil.SetActiveByCondition(self.QTETranClick, true)
                                    _G.DelayDo(
                                            0.5,
                                            function()
                                                _G.GameUtil.SetActiveByCondition(self.QTETranOpen, true)
                                                _G.GameUtil.SetActiveByCondition(self.QTETranClick, false)
                                                animator:Play("a_ef_QTE_Relase")
                                                _G.DelayDo(
                                                        0.5,
                                                        function()
                                                            _G.GameUtil.SetActiveByCondition(self.QTETranOpen, true)
                                                            _G.GameUtil.SetActiveByCondition(self.QTETranClick, false)
                                                            _G.GameUtil.SetActiveByCondition(self.QTETranRelease, true)
                                                            animator:Play("a_ef_QTE_Loop")
                                                            _G.DelayDo(
                                                                    1.2,
                                                                    function()
                                                                        _G.UIUtils.RemoveEffect(self.QTETranOpen)
                                                                        _G.UIUtils.RemoveEffect(self.QTETranRelease)
                                                                        _G.UIUtils.RemoveEffect(self.QTETranClick)
                                                                        _G.DestroyObject(self.obj_QTElongtime)
                                                                        self.obj_QTElongtime = nil
                                                                        _G.UIUtils.CloseVideo()
                                                                        self:OnVideoPlayComplete()
                                                                    end
                                                            )
                                                        end
                                                )
                                            end
                                    )
                                end

                                _G.DelayDo(
                                        0.46,
                                        function()
                                            animator:Play("a_ef_QTE_Loop")
                                            _G.SetEventTrigger(
                                                    self.obj_QTElongtime,
                                                    "onDown",
                                                    function()
                                                        _G.AudioManager.PlayAudioByAudioCfgID(2037)
                                                        doHide()
                                                    end
                                            )
                                        end
                                )
                            end
                    )
                end
            else
                self:OnVideoPlayComplete()
            end
        elseif self.CurGuideTxtCfg.txt_type == _G.GuideTextBox.Spine then
            local cfg = _G.ConfigManager.video_cfg[self.CurGuideTxtCfg.video]
            if cfg then
                if cfg.Key == "elingbianshen_effect" then
                    _G.AudioManager.PlayAudioByAudioCfgID(2034)
                end
                _G.GuideManager:GetInstance():PlayGuideVideo(cfg, _G.handler(self, self.OnVideoPlayComplete))
            end
        elseif self.CurGuideTxtCfg.txt_type == _G.GuideTextBox.SmallSpine then
            ---提示性小文本框
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_tips, true)
            if not _G.IsNil(self.model) then
                require("CardInfoManager").DelRole(self.model, _G.ePoolType.Temporary)
                self.model = nil
            end
            local rolePath = self.CurGuideTxtCfg.photo_route[1]
            if _G.AppSetting.IsArraigned then
                rolePath = self.CurGuideTxtCfg.photo_route_tishen[1]
            end
            local isLoad = true
            if _G.AppSetting.IsXzns then
                isLoad = not GameUtil.IsHeXieHide()
            end
            if isLoad then
                require("CardInfoManager").GetRole(
                        rolePath,
                        _G.ePoolType.Temporary,
                        self.go_table.aorrawimage_tipslh,
                        _G.RoleEffTypeEnum.Dialogue,
                        function(trans)
                            if _G.IsNil(self.go_table.aorrawimage_tipslh) then
                                _G.DestroyObject(trans)
                                return
                            end
                            if not self.CurGuideTxtCfg then
                                require("CardInfoManager").DelRole(trans, _G.ePoolType.Temporary)
                                return
                            end
                            if trans then
                                self.model = trans
                            end
                            local size = self.CurGuideTxtCfg.size or 1
                            trans:SetLocalScaleXYZ(size)
                            local pos = self.CurGuideTxtCfg.pos_portrait or { 0, 0, 0 }
                            trans:SetLocalPosition(pos[1], pos[2], pos[3])
                            if _G.AppSetting.IsXzns then
                                local cardCfg = _G.table.find(_G.ConfigManager.card_cfg, function(card)
                                    if card.ModelPathHi == rolePath then
                                        return card
                                    end
                                end)
                                if cardCfg then
                                    local spineCfg = _G.ConfigManager.card_show_cfg[cardCfg.id]
                                    local idle = spineCfg.display_idle[1]
                                    GameUtil.SetCardUiSpineAnimation(trans, idle, true)
                                end
                            end
                        end
                )
            end
            self.go_table.aortext_tipsContent.text = _G.LangUtil.GetLangPackValue(self.CurGuideCfg.text)
        end
    else
        self.CurGuideTxtCfg = nil
    end
end

