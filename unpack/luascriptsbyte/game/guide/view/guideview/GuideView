---动画结束
function GuideView:OnVideoPlayComplete()
    if _G.AppSetting.IsDebugTeach then
        _G.Log("引导视频播放完成")
    end
    if self.obj_QTElongtime then
        _G.UIUtils.RemoveEffect(self.QTETranOpen)
        _G.UIUtils.RemoveEffect(self.QTETranRelease)
        _G.UIUtils.RemoveEffect(self.QTETranClick)
        _G.DestroyObject(self.obj_QTElongtime)
        self.obj_QTElongtime = nil
    end
    if self.GuideNextCoroutine == nil then
        self.GuideNextCoroutine = _G.coroutine.start(_G.handler(self, self.CoOnNextVedio))
    end
end

---延迟处理下一个视频，连续播放视频会出现无法播放的情况
function GuideView:CoOnNextVedio()
    _G.coroutine.waitforendofframe()
    self:GotoNextStep()
    if self.GuideNextCoroutine ~= nil then
        _G.coroutine.stopwaiting(self.GuideNextCoroutine)
        self.GuideNextCoroutine = nil
    end
end

