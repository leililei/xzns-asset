                local type = self.HighTransList[i][2]
                local highObj = self.HighMaskList[i][1]
                local xpos = self.HighTransList[i][6]
                local ypos = self.HighTransList[i][7]
                local btnRect = self.HighMaskList[i][2]
                local highObjRect = self.HighMaskList[i][3]
                self:PosTransformtion(btnTrans, highObj, btnRect, highObjRect, type, xpos, ypos)
            end
        end
    end
end

---将引导中点击或者高亮的坐标转换到引导面板mask上
---@param btnTrans UnityEngine.Transform 原场景中的按钮或者对象
---@param maskTrans UnityEngine.Transform 反向遮罩对象(包括点击按钮在内)
---@param btnRect UnityEngine.RectTransform 原场景中的按钮或者对象
---@param maskRect UnityEngine.RectTransform 反向遮罩对象(包括点击按钮在内)
---@param type number 相机类型1.ui相机2.3dUI相机3.3d主相机
---@param xpos number 相对X轴偏移量
---@param ypos number 相对Y轴偏移量
function GuideView:PosTransformtion(btnTrans, maskTrans, btnRect, maskRect, type, xpos, ypos)
    if nil == type then
        type = 1
    end
    if nil == xpos then
        xpos = 0
    end
    if nil == ypos then
        ypos = 0
    end
    ---位置信息等提取
    local x, y, z = btnTrans:GetPosition()
    if type ~= 3 then
        local btnTransRect = btnRect
        local px, py = btnTransRect:GetPivotPosition()
        local sizetx, sizety = btnTransRect:GetRectTransformSize()
        ---锚点匹配
        self.PivotVec:Set(px, py)
        maskRect:SetPivotPosition(self.PivotVec.x, self.PivotVec.y)
        ---设置大小
        maskTrans:SetRectTransformSize(sizetx, sizety)
    else
        maskTrans:SetRectTransformSize(100, 100)
    end
    ---定位
    self.camera = _G.UIManager:GetInstance().UICamera
    local nx, ny = self.camera:WorldToScreenPointE(x, y, z)
    if type == 2 then
        self.camera = self.camera3d
        nx, ny = self.camera:WorldToScreenPointE(x, y, z)
    elseif type == 3 then
        self.camera = self.cameramain
        nx, ny = self.camera:WorldToScreenPointE(x, y, z)
    end

    self.V2:Set(nx, ny)

    local _, outPos = self.rtfuy.ScreenPointToLocalPointInRectangle(self.TopLayerT, self.V2, _G.UIManager:GetInstance().UICameraTop)
    -- (outPos, "按钮最终位置")
    maskTrans:SetLocalPosition(outPos.x + xpos, outPos.y + ypos, 0)
end

---点击按钮通用
---@param clickBtn UnityEngine.Transform 点击对象
function GuideView:ClickTheButton(clickBtn)
    if _G.AppSetting.IsDebugTeach then
        _G.Log("点击按钮")
    end
    if clickBtn then
        local btnTrans = clickBtn
        local btn = btnTrans:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Button))
        if btn then
            if _G.AppSetting.IsDebugTeach then
                _G.Log("辅助触发点击按钮")
            end
            btn.onClick:Invoke()
        else
            ---@type UnityEngine.UI.Toggle
            local toggle = btnTrans:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle))
            if toggle then
                if _G.AppSetting.IsDebugTeach then
                    _G.Log("Toggle触发点击按钮")
                end
                toggle.isOn = true
            else
                ---@type EventTriggerListener
                local evtTrigger = btnTrans:GetComponentE(_G.typeof(_G.CS.EventTriggerListener))
                if evtTrigger then
                    if _G.AppSetting.IsDebugTeach then
                        _G.Log("EventTriggerListener触发点击按钮")
                    end
                    evtTrigger:OnPointerClick()
                end
            end
        end
    else
        if _G.AppSetting.IsDebugTeach then
            _G.Log("没有设置点击按钮")
        end
    end
end

--- 按钮单击事件--
function GuideView:OnClickBtn(go)
    local name = go:GetName()

    if _G.AppSetting.IsDebugTeach then
        _G.Log(self.CurGuideCfg.id, "当前引导步骤>>>>>>>>>")
    end
    if nil ~= self.GuideWiatCoroutine then
        local functionName = self.CurGuideCfg.function_id

        if _G.AppSetting.IsDebugTeach then
            _G.Log(functionName, "等待界面完成>>>>>>>>>>>")
        end
        return
    end
    if self.CurGuideCfg.node == _G.GuideNodeType.WaitNav then
        if _G.AppSetting.IsDebugTeach then
            _G.Log("寻路中>>>>>>>>>>>")
        end
        return
    end
    if name == "@_aorbtn_szsGuideFull" then
        ---等待类型，直接触发界面按钮并跳到下一步
        if
        self.CurGuideTxtCfg and
                (self.CurGuideTxtCfg.txt_type == _G.GuideTextBox.Full or
                        self.CurGuideTxtCfg.txt_type == _G.GuideTextBox.Tips)
        then
            ---没有按钮拖拽等操作就可以做为全屏响应
            if self.CurGuideCfg.click_tag == "" and #self.CurGuideCfg.click_type <= 0 then
                if self.CanClickText then
                    self:GotoNextStep()
                    local isFCG = _G.PlayerPrefsManager.GetInt("FirstClickGuide", 0)
                    if isFCG == 0 then
                        _G.SDKManager:GetInstance():GameStepInfo(-70002)
                        _G.SDKManager:GetInstance():MiniGameTrack(require("SDKDef").DotMsg.ShuShu.first_guide_click)
                        _G.PlayerPrefsManager.SetInt("FirstClickGuide", 1)
                    end
                    return
                end
            end
        end
    elseif name == "@_aorbtn_szsGuideClick" then
        ---点击锁定位置
        self:GotoNextStep(true)
        local isFCG = _G.PlayerPrefsManager.GetInt("FirstClickGuide", 0)
        if isFCG == 0 then
            _G.SDKManager:GetInstance():GameStepInfo(-70002)
            _G.SDKManager:GetInstance():MiniGameTrack(require("SDKDef").DotMsg.ShuShu.first_guide_click)
            _G.PlayerPrefsManager.SetInt("FirstClickGuide", 1)
        end
    end
end

---引导打断，界面重设
function GuideView:StopView()
    if _G.AppSetting.IsDebugTeach then
        _G.Log("引导界面重设StopView>>>>>>")
    end
    self:StopForceTimer()
    self:StopUpdate()
    if self.GuideWiatCoroutine ~= nil then
        _G.coroutine.stopwaiting(self.GuideWiatCoroutine)
        self.GuideWiatCoroutine = nil
    end
    _G.UIUtils.RemoveChildren(self.go_table.obj_allmasks)
    self:ResetView()
end

---去到下步
---@param needClick boolean 是否有点击操作
function GuideView:GotoNextStep(needClick)
    if nil == needClick then
        needClick = false
    end
    if self.CurGuideCfg.ButtonResponseType == _G.ButtonResponseType.BattleStart then
        local win = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.EmbattleView.Name)
        if nil == win then
            return
        end
        if _G.AppSetting.IsDebugTeach then
            _G.Log(win.Name, "布阵界面特殊化处理战斗开始按钮响应1")
        end
        if nil == win.View then
            return
        end
        if _G.AppSetting.IsDebugTeach then
            _G.Log(win.View.onBtnFuncRun, "布阵界面特殊化处理战斗开始按钮响应2")
        end
        if win.View.onBtnFuncRun then
            return
        end
    elseif self.CurGuideCfg.ButtonResponseType == _G.ButtonResponseType.BattleChooseRole then
        local win = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.EmbattleView.Name)
        if nil == win then
            return
        end
        if _G.AppSetting.IsDebugTeach then
            _G.Log(win.Name, "布阵界面特殊化处理点击选人响应1")
        end
        if nil == win.View then
            return
        end
        if _G.AppSetting.IsDebugTeach then
            _G.Log(win.View.onBtnFuncRun, "布阵界面特殊化处理点击选人响应2")
            _G.Log(win.View.onCardDragBeginTag, "布阵界面特殊化处理点击选人响应3")
            _G.Log(win.View.createRoleModelTag, "布阵界面特殊化处理点击选人响应4")
        end
        if win.View.onBtnFuncRun then
            return
        end
        if win.View.onCardDragBeginTag then
            return
        end
        if win.View.createRoleModelTag then
            return
        end
    elseif self.CurGuideCfg.ButtonResponseType == _G.ButtonResponseType.BattleChooseBtn then
        local win = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.EmbattleView.Name)
        if nil == win then
            return
        end
        if _G.AppSetting.IsDebugTeach then
            _G.Log(win.Name, "布阵界面特殊化处理战斗布阵按钮响应1")
        end
        if nil == win.View then
            return
        end
        if _G.AppSetting.IsDebugTeach then
            _G.Log(win.View.onBtnFuncRun, "布阵界面特殊化处理战斗布阵按钮响应2")
        end
        if win.View.onBtnFuncRun then
            return
        end
    elseif self.CurGuideCfg.ButtonResponseType == _G.ButtonResponseType.BattleCombSkillBtn then
        local win = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.EmbattleView.Name)
        if nil == win then
            return
        end
        if _G.AppSetting.IsDebugTeach then
            _G.Log(win.Name, "布阵界面特殊化处理点击合技击响应1")
        end
        if nil == win.View then
            return
        end
        if _G.AppSetting.IsDebugTeach then
            _G.Log(win.View.onBtnFuncRun, "布阵界面特殊化处理点击合技击响应2")
            _G.Log(not win.View.curEmbattleItem:GetCombSkillBtnClick(), "布阵界面特殊化处理点击合技击响应3")
        end
        if win.View.onBtnFuncRun then
            return
        end
        if not win.View.curEmbattleItem:GetCombSkillBtnClick() then
            return
        end
    end

    ---目的是为了确保主界面页签切换后预制体加载完成再执行点击事件
    if self.CurGuideCfg.teach_type == _G.GuideTeachType.Function and self.CurGuideCfg.function_id == _G.ConfigManager.ui_cfg.MainView.Name then
        local win = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.MainView.Name)
        if not win or not win.View then
            return
        end

        if _G.AppSetting.IsDebugTeach then
            _G.Log(win.Name, "主界面MainView页签切换点击事件响应")
        end

        if not win.View.panelInit[win.View:GetTogKey()] then
            return
        end
    end

    if self.CurGuideCfg.rec_pause == 1 then
        _G.CS.BattleManager.Inst:ResumeBattle()
    end
    self:StopView()
    ---如果是结束点或者不可逆的点，到一步时先记录一下
    if self.CurGuideCfg.node == _G.GuideNodeType.End or self.CurGuideCfg.node == _G.GuideNodeType.Irreversible then
        if _G.GuideManager:GetInstance().LoseGuideId > 0 then
            ---如果是失败特殊节点，不参与打点

            if _G.AppSetting.IsDebugTeach then
                _G.Log(_G.GuideManager:GetInstance().LoseGuideId, "不打点，失败节点>>>")
            end
        elseif self.CurGuideModelCfg.make_type then
            if _G.AppSetting.IsDebugTeach then
                _G.Log(_G.GuideManager:GetInstance().LoseGuideId, "不打点，触发式节点>>>")
            end
        else
            local GuideNet = require("GuideNet")
            ---@type guide.c2s_guide_dot
            local msg = {}
            msg.guide_id = self.CurGuideCfg.id
            local info = {}
            info.guideId = self.CurGuideCfg.id
            info.guideDot = GuideModel:GetInstance().GuideDot
            GuideNet:GetInstance():InstanceDot(msg, _G.handlerbind(self, self.BackInstanceDot, info))
            GuideModel:GetInstance().GuideDot = self.CurGuideCfg.id
        end
    end
    local clickBtn
    if needClick then
        clickBtn = self:GetBtnTrans()
    end
    if clickBtn then
        self:ClickTheButton(clickBtn)
    end
    _G.GuideManager:GetInstance():DoNext()
end

---打点数据回来
---@param msg public.s2c_common_ack
---@param info table 打点引导记录信息
function GuideView:BackInstanceDot(msg, info)
    if msg.ack == 1 then
        GuideModel:GetInstance().GuideDot = info.guideId
    else
        GuideModel:GetInstance().GuideDot = info.guideDot
    end

    if _G.AppSetting.IsDebugTeach then
        _G.Log(GuideModel:GetInstance().GuideDot, "打点结果")
    end
end

---移除
function GuideView:OnDestroy()
    if _G.AppSetting.IsDebugTeach then
        _G.Log("引导界面启动OnDestroy>>>>>>")
    end
    if self.GuideWiatCoroutine then
        _G.coroutine.stopwaiting(self.GuideWiatCoroutine)
        self.GuideWiatCoroutine = nil
    end
    if self.GuideNextCoroutine then
        _G.coroutine.stopwaiting(self.GuideNextCoroutine)
        self.GuideNextCoroutine = nil
    end
    _G.GuideManager:GetInstance():ClearGuide()

    self:StopUpdate()
    self:StopForceTimer()
    if not _G.IsNil(self.model) then
        require("CardInfoManager").DelRole(self.model, _G.ePoolType.Temporary)
        self.model = nil
    end

    GuideView = nil
    GuideModel = nil
end

return GuideView
