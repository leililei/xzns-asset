---获取点击按钮对象
function GuideView:GetBtnTrans()
    local btnTrans
    local path = self.CurGuideCfg.click_tag

    if _G.AppSetting.IsDebugTeach then
        _G.Log(path, "点击按钮路径")
    end
    ---有路径并且配的点击就找按钮
    if self.HasClickAction then
        btnTrans = _G.FindObject(path)
        if _G.IsNil(btnTrans) then
            if _G.AppSetting.IsDebugTeach then
                _G.LogError("引导点击节点异常，请检查配置是否正常，引导已跳出，修复后再进入游戏完成引导")
            end
            _G.GuideManager:GetInstance():DoBreak()
        end
    end
    return btnTrans
end

---获取高亮对象
function GuideView:GetHighTrans()
    local btnTrans = {}
    for i = 1, #self.CurGuideCfg.highlight_tag do
        ---{ 类型, 路径, 特效,方圆（01）,缩放,y轴偏移, 宽, 高 }
        local type = tonumber(self.CurGuideCfg.highlight_tag[i][1])
        local lpath = self.CurGuideCfg.highlight_tag[i][2]
        local effect = self.CurGuideCfg.highlight_tag[i][3]
        local fy = tonumber(self.CurGuideCfg.highlight_tag[i][4])
        local scale = tonumber(self.CurGuideCfg.highlight_tag[i][5])
        local xpos = tonumber(self.CurGuideCfg.highlight_tag[i][6])
        local ypos = tonumber(self.CurGuideCfg.highlight_tag[i][7])
        local width = tonumber(self.CurGuideCfg.highlight_tag[i][8])
        local height = tonumber(self.CurGuideCfg.highlight_tag[i][9])
        local path = lpath ~= "" and lpath or ""

        if _G.AppSetting.IsDebugTeach then
            _G.Log(path, "高亮对象路径")
        end
        ---有路径就找按钮
        if "" ~= path then
            local trans = _G.FindObject(path)
            if _G.IsNil(trans) then
                if _G.AppSetting.IsDebugTeach then
                    _G.LogError("引导高亮节点异常，请检查配置是否正常")
                end
            else
                table.insert(btnTrans, { trans, type, effect, fy, scale, xpos, ypos, width, height })
            end
        end
    end
    return btnTrans
end

