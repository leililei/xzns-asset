---显示高亮对象
function GuideView:InitHighLightInfo()
    self.HighTransList = self:GetHighTrans()

    if _G.AppSetting.IsDebugTeach then
        _G.Log(self.HighTransList, "高亮对象")
    end
    self.HighMaskList = {}
    if #self.HighTransList > 0 then
        _G.UIUtils.RemoveChildren(self.go_table.obj_allmasks)
        for i = 1, #self.HighTransList do
            ---{ 类型, 路径, 特效,方圆（01），缩放，y轴偏移 }
            local btnTrans = self.HighTransList[i][1]
            local type = self.HighTransList[i][2]
            local effect = self.HighTransList[i][3]
            local fy = self.HighTransList[i][4]
            local scale = self.HighTransList[i][5]
            local xpos = self.HighTransList[i][6]
            local ypos = self.HighTransList[i][7]
            local width = self.HighTransList[i][8]
            local height = self.HighTransList[i][9]
            local highObj = _G.InstantiateObject(self.go_table.obj_highMask, self.go_table.obj_allmasks)
            local image = highObj:GetComponentE(_G.typeof(_G.CS.AorImage))
            if fy == 0 then
                -- image.SpriteName = "ui_baifangkuai"
                image.EffectType = _G.CS.AorImage.EType.Normal
            else
                -- image.SpriteName = "ui_baiyuan"
                image.EffectType = _G.CS.AorImage.EType.Circle
            end
            local ho = highObj
            local btnRect
            local maskRect
            if type ~= 3 then
                btnRect = _G.UIUtils.GetRectTrans(btnTrans)
                maskRect = _G.UIUtils.GetRectTrans(ho)
            end

            _G.table.insert(self.HighMaskList, { ho, btnRect, maskRect })
            self:PosTransformtion(btnTrans, ho, btnRect, maskRect, type, xpos, ypos)

            if fy ~= 0 then
                self.PivotVec:Set(0.5, 0.5)
                ho:SetPivotPosition(self.PivotVec.x, self.PivotVec.y)
            end

            if width > 0 and height > 0 then
                highObj:SetRectTransformSize(width, height)
            end

            local addEffect = function()
                if effect and effect ~= "0" then
                    _G.UIUtils.LoadEffectByCfg(
                            _G.ConfigManager.ui_effect_cfg[effect],
                            ho,
                            function(tran)
                                tran:SetAnchorPosition(0, 0)
                            end
                    )
                end
            end

            if self.CurGuideCfg.zoom_type then
                local sl = _G.ConfigManager.discrete_cfg[102104][1][1]
                ho:SetLocalScale(scale * 10, scale * 10, 1)
                image:DOScale(
                        scale,
                        scale,
                        1,
                        sl,
                        function()
                            addEffect()
                        end
                )    :SetEase(_G.CS.DG.Tweening.Ease.InQuart)
            else
                addEffect()
            end
        end
    end
end

