---战斗开始
function GuideManager:FightStart()
    if _G.AppSetting.IsDebugTeach then
        _G.Log("引导调用战斗开始")
    end
    self.GotoBattleIng = false

    if _G.BattleManager:GetInstance().IsRecordFight then
        if _G.AppSetting.IsDebugTeach then
            _G.Log("战斗回放中，不参与引导>>>>>>>>>>>")
        end
        return
    end

    if not self.IsGuideing then
        self:UpdateGuide(_G.GuideTeachType.Fight)
        if self.CurGuideId <= 0 then
            ---强制引导如果没了就考虑非强制
            self.CurGuideId = self:GetNFGuide(_G.GuideTeachType.Fight)
        end

        if _G.AppSetting.IsDebugTeach then
            _G.Log(self.CurGuideId, "战斗刷新出id")
        end
        self:DoPlay(self.CurGuideId)
    else
        if self.CurGuideCfg.teach_type == 1 then
            self:DoBreak()
        end
        self:UpdateGuide(_G.GuideTeachType.Fight)
        if self.CurGuideId <= 0 then
            ---强制引导如果没了就考虑非强制
            self.CurGuideId = self:GetNFGuide(_G.GuideTeachType.Fight)
        end

        if _G.AppSetting.IsDebugTeach then
            _G.Log(self.CurGuideId, "继续战斗已刷新出id")
        end
        self:DoPlay(self.CurGuideId)
    end
end

---战斗结束
---@param win boolean 是否胜利
function GuideManager:FightEnd(win)
    if _G.AppSetting.IsDebugTeach then
        _G.Log("引导调用战斗结束>>>>>>>>>>")
    end
    local monsterGroupId = _G.BattleManager:GetInstance():GetMonsterGroupId()
    local chapter = require "AfkModel":GetInstance():GetCurAfkChapter()

    if _G.AppSetting.IsDebugTeach then
        _G.Log(chapter, "获取到的当前是那一个章节>>>>>")
    end

    if _G.AppSetting.IsDebugTeach then
        _G.Log(monsterGroupId, "获取到的当前GroupId>>>>>")
    end

    if win then
        if _G.AppSetting.IsDebugTeach then
            _G.Log(win, "战斗胜利>>>>>")
        end
        if self.IsGuideing then
            if _G.AppSetting.IsDebugTeach then
                _G.Log(tostring(_G.table.keyof(_G.GuideNodeType, self.CurGuideCfg.node)), "引导中>>>当前引导节点类型")
            end
            self.LoseGuideId = 0
            if self.CurGuideCfg.node == _G.GuideNodeType.WaitFightEnd then
                if _G.AppSetting.IsDebugTeach then
                    _G.Log(self.CurGuideCfg.function_id, "引导要求房间id>>>>>")
                end
                if monsterGroupId == tonumber(self.CurGuideCfg.function_id) then
                    self:DoNext()
                else
                    if _G.AppSetting.IsDebugTeach then
                        _G.Log("等待战斗结束，房间号不匹配")
                    end
                end
            else
                if _G.PlayerModel:GetInstance():CheckCreateRole() then
                    if _G.AppSetting.IsDebugTeach then
                        _G.LogError(self.CurGuideCfg.id, "战斗内引导执行异常，请检查战斗节奏或者配置步骤是否有异常")
                    end
                    self:DoBreak()
                end
            end
        else
            ---循环非强制引导
            if self.NotForceGroupId > 0 then
                local model = _G.ConfigManager.teach_model_cfg[self.NotForceGroupId]

                if _G.AppSetting.IsDebugTeach then
                    _G.Log(self.NotForceGroupId, "非强制引导记录id>>>>>")
                end
                self.LoseGuideId = 0
                if monsterGroupId == model.relation_group then
                    --local GuideNet = require("GuideNet")
                    --local GuideModel = require("GuideModel")
                    ---@type guide.c2s_guide_dot
                    local msg = {}
                    msg.guide_id = model.end_node
                    local info = {}
                    info.guideId = model.end_node
                    info.guideDot = GuideModel:GetInstance().GuideDot
                    GuideNet:GetInstance():InstanceDot(msg, _G.handlerbind(self, self.BackInstanceDot, info))
                    GuideModel:GetInstance().GuideDot = model.end_node
                end
            end
        end
        local times = _G.ConfigManager.discrete_cfg[102102][1][2]
        local curTimes = _G.PlayerPrefsManager.GetInt("LoseGuideTimes", times)
        curTimes = curTimes + 1
        _G.PlayerPrefsManager.SetInt("LoseGuideTimes", curTimes)
    else
        if _G.AppSetting.IsDebugTeach then
            _G.Log("战斗失败>>>>>>")
        end
        self.LoseGuideId = 0
        local controller = _G.BattleManager:GetInstance().curBattleController
        if _G.AppSetting.IsDebugTeach then
            _G.Log(nil ~= controller, "当前战斗控制器是否存在")
            if nil ~= controller then
                _G.Log(controller._class_type.__cname, "当前战斗控制器是名称是")
            end
        end
        if nil ~= controller and controller._class_type.__cname == _G.BattleControllerType.afkChallenge then
            local id = _G.ConfigManager.discrete_cfg[102102][1][1]
            local times = _G.ConfigManager.discrete_cfg[102102][1][2]
            local curTimes = _G.PlayerPrefsManager.GetInt("LoseGuideTimes", times)

            if _G.AppSetting.IsDebugTeach then
                _G.Log("配置章节id>>>>>" .. id)
            end

            if _G.AppSetting.IsDebugTeach then
                _G.Log("配置失败次数>>>>>" .. times)
            end

            if _G.AppSetting.IsDebugTeach then
                _G.Log("当前失败次数>>>>>" .. curTimes)
            end
            if curTimes >= times then
                if chapter <= id then
                    self.LoseGuideId =
                        _G.ConfigManager.teach_model_cfg[_G.ConfigManager.discrete_cfg[102103][1][1]].start_node[1]

                    if _G.AppSetting.IsDebugTeach then
                        _G.Log(self.LoseGuideId, "失败引导id")
                    end
                end
                curTimes = 0
                _G.PlayerPrefsManager.SetInt("LoseGuideTimes", curTimes)
            end

            local sid = require("AfkModel"):GetInstance():GetLastSection()
            if sid and sid <= 101006 then
                --战斗失败后防止出现死循环直接中止当前的整个引导组
                self:DotBreakGuide()
            end
            -- self:DoBreak()
        end
    end
end

