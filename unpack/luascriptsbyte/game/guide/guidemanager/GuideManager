---检测界面进度
function GuideManager:CoOnProgress()
    _G.coroutine.waitforendofframe()
    local uimgr = _G.UIManager:GetInstance()
    local name = self.CurGuideCfg.open_oneview
    local nowWindow = uimgr:GetWindow(name)
    while _G.IsNil(nowWindow) do
        nowWindow = uimgr:GetWindow(name)
        _G.coroutine.waitforendofframe()
    end
    if self.GuideWiatCoroutine ~= nil then
        _G.coroutine.stopwaiting(self.GuideWiatCoroutine)
        self.GuideWiatCoroutine = nil
    end

    if _G.WorldManager:GetInstance().CurrentWorld.Cfg.Scene_Type == _G.SceneType.Section then
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    end
    _G.StoryManager:GetInstance():PlayDialogueView(
        self.CurGuideCfg.text_type,
        _G.handler(self, self.OnClaimPreDialogueCompleted)
    )
end

---计时检测功能条件是否成立
function GuideManager:UpdateCheckFunConditon()
    local conditionType = 1
    if self.CurGuideCfg.node == _G.GuideNodeType.Pause then
        conditionType = self:DoCheckFunConditon(self.CurGuideCfg)
        if conditionType == 0 then
            self:DoNext()
        end
    end
    return conditionType
end

---功能条件检测
---@param guideCfg teach_info_cfg
function GuideManager:DoCheckFunConditon(guideCfg)
    if _G.AppSetting.IsDebugTeach then
        _G.Log(guideCfg.id, "条件检测id>>>>>")
    end
    if guideCfg.function_id == _G.ConfigManager.ui_cfg.MainView.Name and not self:CheckMainViewTab(guideCfg) then
        return -1
    end
    ---条件类型 0 条件成立 1 条件不成立
    local conditionType = 0
    if #guideCfg.open_condition > 0 then
        for k = 1, #guideCfg.open_condition do
            local param = {}
            for i = 2, #guideCfg.open_condition[k] do
                table.insert(param, guideCfg.open_condition[k][i])
            end
            if CheckCondition[guideCfg.open_condition[k][1]] then
                local istrue = CheckCondition[guideCfg.open_condition[k][1]](param)
                if not istrue then
                    conditionType = 1
                    if _G.AppSetting.IsDebugTeach then
                        _G.LogError(
                            guideCfg.id .. ">>>>" .. guideCfg.open_condition[k][1],
                            "<color=red><size=20>引导匹配条件不成立>>>>>>>>></size></color>"
                        )
                    end
                    break
                end
            else
                if _G.AppSetting.IsDebugTeach then
                    _G.LogError(
                        guideCfg.id .. ">>>>" .. guideCfg.open_condition[k][1],
                        "<color=red><size=20>功能引导未找到匹配条件的类型>>>>>>>>></size></color>"
                    )
                end
                conditionType = 1
            end
        end
    end

    ---条件类型 0 条件成立 1 条件不成立
    local conditionType1 = 0
    if #guideCfg.open_condition1 > 0 then
        for k = 1, #guideCfg.open_condition1 do
            local param = {}
            for i = 2, #guideCfg.open_condition1[k] do
                table.insert(param, guideCfg.open_condition1[k][i])
            end
            if CheckCondition[guideCfg.open_condition1[k][1]] then
                local istrue = CheckCondition[guideCfg.open_condition1[k][1]](param)
                if not istrue then
                    conditionType1 = 1
                    if _G.AppSetting.IsDebugTeach then
                        _G.LogError(
                            guideCfg.id .. ">>>>" .. guideCfg.open_condition1[k][1],
                            "<color=red><size=20>引导匹配条件不成立>>>>>>>>></size></color>"
                        )
                    end
                    break
                end
            else
                if _G.AppSetting.IsDebugTeach then
                    _G.LogError(
                        guideCfg.id .. ">>>>" .. guideCfg.open_condition1[k][1],
                        "<color=red><size=20>功能引导未找到匹配条件的类型>>>>>>>>></size></color>"
                    )
                end
                conditionType1 = 1
            end
        end
    else
        return conditionType
    end

    if conditionType == 1 and conditionType1 == 1 then
        return 1
    else
        return 0
    end
end

