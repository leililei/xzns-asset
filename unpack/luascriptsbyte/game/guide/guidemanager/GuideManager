--- 完成执行下一步
function GuideManager:DoNext()
    if not self.CurGuideCfg then
        if _G.AppSetting.IsDebugTeach then
            _G.LogWarning("引导提示：GuideManager.DoNext：CurGuideCfg是nil")
        end
        return
    end
    local guideId = self.CurGuideCfg.next_id
    ---检测下一部引导，如果没有，就退出引导组

    if _G.AppSetting.IsDebugTeach then
        _G.Log(guideId, "下一步引导")
    end

    if self.CheckFunConditonTimer ~= nil then
        self.CheckFunConditonTimer:Stop()
        self.CheckFunConditonTimer = nil
    end

    if self.WaitNodeTimer then
        self.WaitNodeTimer:Stop()
        self.WaitNodeTimer = nil
    end

    local curFunctionId = self.CurGuideCfg.function_id

    -- 移除战斗引导特效
    if self.handEffect then
        _G.UIUtils.RemoveEffect(self.handEffect, 0)
        self.handEffect = nil
    end

    if guideId == 0 then
        self.LoseGuideId = 0

        ---清理掉界面，打开主界面
        local special = self.CurGuideCfg.special
        local combatType = self.CurGuideCfg.combat_type

        self:DoBreak()

        _G.Events:GetInstance():Broadcast(_G.eGuideEvent.GuideEnd)

        ---自动返回（0=无处理；1=直接返回主场景）
        if special then
            if _G.AppSetting.IsDebugTeach then
                _G.Log("自动返回主场景")
            end
            _G.UIManager:GetInstance():CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)
            _G.WorldManager:GetInstance():SetCurrentWorldVisible(true)
        end

        ---是否进入副本（0=否；1=是；）

        if _G.AppSetting.IsDebugTeach then
            _G.Log(combatType, "是否进入副本")
        end
        self.GotoBattleIng = combatType
        ---如果是进副本了或者本来就是从主界面操作的，就不再刷新主界面的
        if combatType == false and curFunctionId ~= _G.ConfigManager.ui_cfg.MainView.Name then
            if _G.AppSetting.IsDebugTeach then
                _G.Log(_G.WorldManager:GetInstance().CurrentWorld.Cfg.Scene_Type, "当前场景类型")
            end

            if _G.AppSetting.IsDebugTeach then
                _G.Log(_G.MainManager:GetInstance().isInMainView, "是否在主界面")
            end
            if _G.MainManager:GetInstance().ExistMainView() then
                self:CheckFunctionGuide(_G.ConfigManager.ui_cfg.MainView.Name)
            end
        end
    else
        self:DoPlay(guideId)
    end
end

