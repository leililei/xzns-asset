end

---ui关闭
---@param name string UI名称
function GuideManager:OnUIClosed(name)
    ---如果是当前界面，并且是等待的

    if _G.AppSetting.IsDebugTeach then
        _G.Log(name, "引导监听关闭界面>>>>>>")
    end

    if self.IsGuideing then
        if self.CurGuideCfg.function_id == name and self.CurGuideCfg.node == _G.GuideNodeType.WaitUIClose then
            self:DoNext()
            return
        end
    end

    if self.IsSpOpening[2] then
        if name == _G.ConfigManager.ui_cfg.DialogueView.Name then
            self.IsSpOpening[2] = false
            self:DisPlayGuide()
        end
    end

    if self.IsSpOpening[3] then
        if
            name == _G.ConfigManager.ui_cfg.RoleLevelUpView.Name or
            name == _G.ConfigManager.ui_cfg.MapIllustrationView.Name or
            name == _G.ConfigManager.ui_cfg.OpenFunctionsView.Name or
            name == _G.ConfigManager.ui_cfg.CommonAwardView.Name
        then
            self.IsSpOpening[3] = false
            self:DisPlayGuide()
        end
    end

    ---主界面只隐藏不关，所以在关闭时检测是否退到了主界面
    if self:CheckMainViewTab(self.CurGuideCfg) then
        self:CheckFunctionGuide(_G.ConfigManager.ui_cfg.MainView.Name)
    else
        --特殊处理一些返回触发式引导
        if name == _G.ConfigManager.ui_cfg.DrawResultView.Name then
            self:CheckFunctionGuide(_G.ConfigManager.ui_cfg.DrawView.Name)
            return
        end

        ---@type UIWindow
        local topui = _G.UIManager:GetInstance():GetTopWindowByLayer(_G.UILayers.TopLayer.Name)
        if nil == topui then
            topui = _G.UIManager:GetInstance():GetTopWindowByLayer(_G.UILayers.NormalLayer.Name)
        end
        if topui then
            self:CheckFunctionGuide(topui.Name)
        end
    end
end

