--- 开始引导
---@param guideId number 新手引导id
function GuideManager:DoPlay(guideId)
    if _G.AppSetting.IsDebugTeach then
        _G.Log(guideId, "启动引导===id>>>>>>")
    end
    if _G.AppSetting.IsShowTeach == false then
        if _G.AppSetting.IsDebugTeach then
            _G.LogError("新手引导IsShowTeach已关，不开始引导")
        end
        return
    end

    if guideId <= 0 then
        if _G.AppSetting.IsDebugTeach then
            _G.LogError(guideId, "引导id不存在，不开始引导")
        end
        return
    end

    --local GuideModel = require("GuideModel")
    if GuideModel:GetInstance().GuideSkipId == GuideModel:GetInstance().GuideDot then
        if _G.AppSetting.IsDebugTeach then
            _G.LogError(GuideModel:GetInstance().GuideDot, "新手引导GM跳过，不开始引导")
        end
        return
    end

    self.CurGuideId = guideId
    self.CurGuideCfg = _G.ConfigManager.teach_info_cfg[guideId]

    if nil == self.CurGuideCfg then
        if _G.AppSetting.IsDebugTeach then
            _G.LogError(guideId, "错误的新手引导id>>>>>>>>>>")
        end
        self:DoBreak()
        return
    end

    ---引导记录bi
    if
        self.CurGuideCfg.node ~= _G.GuideNodeType.Nomal and self.CurGuideCfg.node ~= _G.GuideNodeType.End and
        self.CurGuideCfg.node ~= _G.GuideNodeType.Irreversible
    then
        if _G.AppSetting.IsDebugTeach then
            _G.Log(guideId, "<color=yellow><size=20>引导点发送BI信息id>>>></size></color>")
        end
        --local GuideNet = require("GuideNet")
        --@type guide.c2s_guide_bi
        local msg = {}
        msg.guide_id = self.CurGuideCfg.id
        GuideNet:GetInstance():DoBI(msg, nil)
    end

    self.CurGuideModelCfg = _G.ConfigManager.teach_model_cfg[self.CurGuideCfg.group_id]

    if self.CurGuideModelCfg.not_force then
        self.NotForceGroupId = self.CurGuideModelCfg.id
    else
        self.NotForceGroupId = 0
    end

    self:CallCSDoCustomGuide()

    ---如果这一步废弃，就去下一步
    if self.CurGuideCfg.discard then
        if _G.AppSetting.IsDebugTeach then
            _G.Log(guideId, "废弃引导id>>>>>>>>>>>>>>>>>")
        end
        self:DoNext()
        return
    end

    _G.Log("设置IsGuideing引导为开启状态")

    self.IsGuideing = true

    if _G.AppSetting.IsDebugTeach then
        _G.Log(guideId, "开始引导===id>>>>>>")
    end

    if _G.AppSetting.IsDebugTeach then
        _G.Log(self.CurGuideCfg.group_id, "开始引导组===id>>>>>>")
    end
    if self.CurGuideCfg.teach_type == _G.GuideTeachType.Fight then
        _G.SDKManager:GetInstance():GameStepInfo(-70003)
        _G.SDKManager:GetInstance():MiniGameTrack(require("SDKDef").DotMsg.ShuShu.guide_battle)
    end

    local globalInfo = function()
        ---辅助打开界面
        if self.CurGuideCfg.open_oneview ~= "" then
            if _G.AppSetting.IsDebugTeach then
                _G.Log(guideId, "辅助打开界面>>>>>>" .. self.CurGuideCfg.open_oneview .. ">>>>>>>>>")
            end
            local param
            if #self.CurGuideCfg.oneview_param > 0 then
                param = self.CurGuideCfg.oneview_param
            end
            if param then
                _G.UIManager:GetInstance():OpenWindow(self.CurGuideCfg.open_oneview, _G.SafeUnpack(param))
            end
        end

        ---调用全局接口
        if self.CurGuideCfg.global_function ~= "" then
            if _G.AppSetting.IsDebugTeach then
                _G.Log(guideId, "调用全局接口>>>>>>" .. self.CurGuideCfg.global_function .. ">>>>>>>")
            end
            local gfs = _G.string.split(self.CurGuideCfg.global_function, ".")
            local model = _G.table.remove(gfs, 1)
            local fun = _G.table.remove(gfs, 1)

            if _G[model] and _G[model][fun] then
                _G[model][fun](_G.table.unpack(gfs))
            end
        end
    end

    ---不是等待暂停节点
    if
        self.CurGuideCfg.node ~= _G.GuideNodeType.Pause and self.CurGuideCfg.node ~= _G.GuideNodeType.WaitFightEnd and
        self.CurGuideCfg.node ~= _G.GuideNodeType.WaitUIClose and
        self.CurGuideCfg.node ~= _G.GuideNodeType.WaitForDo and
        self.CurGuideCfg.node ~= _G.GuideNodeType.WaitUIOpen and
        self.CurGuideCfg.node ~= _G.GuideNodeType.WaitVideoEnd
    then
        ---判断条件
        local conditionType = self:DoCheckFunConditon(self.CurGuideCfg)
        if conditionType == 1 then
            if _G.AppSetting.IsDebugTeach then
                _G.LogError(
                    self.CurGuideCfg.open_condition,
                    "新手引导[" .. self.CurGuideCfg.id .. "]条件不满足，不开始引导，要求条件>>>>>>>>>>>"
                )
            end
            self:DoBreak()
            return
        end
    elseif self.CurGuideCfg.node == _G.GuideNodeType.Pause then
        if _G.AppSetting.IsDebugTeach then
            _G.Log(guideId, "暂停节点挂起>>>>>>>>")
        end
        if self.CurGuideCfg.teach_type == _G.GuideTeachType.Function then
            if _G.AppSetting.IsDebugTeach then
                _G.Log(guideId, "功能暂停节点挂起>>>>>>>>")
            end
            local conditionType = self:UpdateCheckFunConditon()
            ---条件不成立就挂起来等否则就不用挂起了
            if conditionType == 1 then
                if _G.AppSetting.IsDebugTeach then
                    _G.LogError("功能条件不成立不开始引导，条件判断已挂起，请检查以下条件是否有异常")
                    _G.LogError(self.CurGuideCfg.open_condition)
                end
                ---条件判断挂起
                if self.CheckFunConditonTimer == nil then
                    self.CheckFunConditonTimer =
                        _G.TimerManager:GetInstance():GetTimer(1, self.UpdateCheckFunConditon, self, false)
                    self.CheckFunConditonTimer:Start()
                end
            end
        else
            if _G.AppSetting.IsDebugTeach then
                _G.Log(guideId, "战斗暂停节点挂起>>>>>>>>")
            end
        end
        return
    elseif self.CurGuideCfg.node == _G.GuideNodeType.WaitVideoEnd then
        if self.CurGuideCfg.video == "sihundao" then
            local firstOpen = _G.PlayerPrefsManager.GetTable("sihunta", false)
            if firstOpen then
                self:DoNext()
                return
            end
        elseif self.CurGuideCfg.video == "zhaomu" then
            local kaihuan
            if self.CurGuideCfg.function_id == "DrawView" then
                kaihuan = _G.PlayerPrefsManager.GetInt("kaiguan")
            elseif self.CurGuideCfg.function_id == "DrawUpMainView" then
                kaihuan = _G.PlayerPrefsManager.GetInt("DrawUpMainViewkaiguan")
            elseif self.CurGuideCfg.function_id == "ArtifactDrawUpMainView" then
                kaihuan = _G.PlayerPrefsManager.GetInt("DrawUpMainViewkaiguan")
            end
            if kaihuan == 1 then
                self:DoNext()
                return
            end
        end
    else
        ---等待或者暂停节点挂起无操作

        if _G.AppSetting.IsDebugTeach then
            _G.Log(guideId, "等待节点挂起>>>>>>>")
        end
        if self.CurGuideCfg.node == _G.GuideNodeType.WaitUIOpen and self.CurGuideCfg.set_obstacle == false then
            self:ShowMask(true)
        elseif self.CurGuideCfg.node == _G.GuideNodeType.WaitForDo and self.CurGuideCfg.set_obstacle == false then
            self:ShowMask(true)
        elseif self.CurGuideCfg.node == _G.GuideNodeType.WaitUIClose and self.CurGuideCfg.set_obstacle == false then
            local win = _G.UIManager:GetInstance():GetWindowCtrl(self.CurGuideCfg.function_id)
            if nil == win or nil == win.gameObject then
                self:ShowMask(true)
            end
        end
        globalInfo()

        ---如果不是等待战斗结束，设定超时机制
        if self.CurGuideCfg.node ~= _G.GuideNodeType.WaitFightEnd then
            if self.CurGuideCfg.wait_timeout and self.CurGuideCfg.wait_timeout > 0 then
                if self.WaitNodeTimer then
                    self.WaitNodeTimer:Stop()
                    self.WaitNodeTimer = nil
                end

                self.WaitNodeTimer =
                    _G.TimerManager:GetInstance():GetTimer(
                        self.CurGuideCfg.wait_timeout,
                        self.DoWaitOutTimer,
                        self,
                        true,
                        false,
                        true
                    )
                self.WaitNodeTimer:Start()
            end
        end
        return
    end

    if _G.AppSetting.IsDebugTeach then
        _G.Log(guideId, "引导条件通过===id>>>>>>")
    end

    globalInfo()

    -- 触发式引导保存到本地
    if self.CurGuideModelCfg.make_type and self.CurGuideCfg.node == _G.GuideNodeType.Start then
        self:SaveDot(self.CurGuideModelCfg.id)
    end

    ---如果配了暂停游戏就暂停
    if self.CurGuideCfg.rec_pause == 2 then
        _G.CS.BattleManager.Inst:PauseBattle(false)
    end

    ---链接外部剧情对话内容
    if self.CurGuideCfg.node == _G.GuideNodeType.Dialogue then
        if _G.AppSetting.IsDebugTeach then
            _G.Log(guideId, "外接对话框>>>>>>>")
        end
        if self.CurGuideCfg.open_oneview ~= "" then
            if self.GuideWiatCoroutine == nil then
                self.GuideWiatCoroutine = _G.coroutine.start(_G.handler(self, self.CoOnProgress))
            end
        else
            if _G.WorldManager:GetInstance().CurrentWorld.Cfg.Scene_Type == _G.SceneType.Section then
                _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
            elseif _G.MainManager:GetInstance():ExistMainView() then
                _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
            end
            _G.StoryManager:GetInstance():PlayDialogueView(
                self.CurGuideCfg.text_type,
                _G.handler(self, self.OnClaimPreDialogueCompleted)
            )
        end
        return
    end

    if self.CurGuideCfg.node == _G.GuideNodeType.HUD then
        if _G.AppSetting.IsDebugTeach then
            _G.Log(guideId, "外接人物HUD>>>>>>>")
        end

        if self.CurGuideCfg.teach_type == 1 then
            _G.HUDUtilities.ShowHudID(
                self.CurGuideCfg.text_type,
                function()
                    self:DoNext()
                end,
                self.CurGuideCfg.text
            )
        elseif self.CurGuideCfg.teach_type == 2 then
            _G.HUDUtilities.ShowHudIDFight(
                self.CurGuideCfg.text_type,
                function()
                    self:DoNext()
                end,
                self.CurGuideCfg.text
            )
            if self.CurGuideCfg.rec_pause == 1 then
                _G.CS.BattleManager.Inst:ResumeBattle()
            end
        end

        return
    end

    ---一个没有操作的开始节点或者普通节点条件成立去下一步
    if
        (self.CurGuideCfg.node == _G.GuideNodeType.Start or self.CurGuideCfg.node == _G.GuideNodeType.Nomal) and
        self.CurGuideCfg.click_tag == "" and
        self.CurGuideCfg.text_type == 0
    then
        if _G.AppSetting.IsDebugTeach then
            _G.Log(guideId, "空节点跳转到下一步>>>>>")
        end
        self:DoNext()
        return
    end

    if _G.AppSetting.IsDebugTeach then
        _G.Log(guideId, "引导条件通过===id>>>>>>")
    end

    self:ShowGuide()
end

