---开启功能引导检测（非战斗的）
function GuideManager:CheckFunctionGuide(name)
    if _G.AppSetting.IsDebugTeach then
        _G.Log(name, "检测功能面板引导")
    end
    --local GuideModel = require("GuideModel")
    if not GuideModel:GetInstance().GetDataFinish then
        if _G.AppSetting.IsDebugTeach then
            _G.Log("数据还没有准备好")
        end
        return
    end

    if _G.JumpManager:GetInstance().IsJumping then
        if _G.AppSetting.IsDebugTeach then
            _G.Log("如果是跳转中，就不做检测>>>>")
        end
        return
    end

    if self.GotoBattleIng then
        if _G.AppSetting.IsDebugTeach then
            _G.Log("正在进入战斗，不做引导检测")
        end
        return
    end

    if not self.IsGuideing then
        if _G.AppSetting.IsDebugTeach then
            _G.Log(self.LoseGuideId, "失败引导id")
        end
        ---失败了需要引导的
        if self.LoseGuideId > 0 then
            if _G.AppSetting.IsDebugTeach then
                _G.Log("执行失败引导组")
            end
            self.CurGuideId = self.LoseGuideId
            self.CurGuideCfg = _G.ConfigManager.teach_info_cfg[self.CurGuideId]
            self.CurGuideModelCfg = _G.ConfigManager.teach_model_cfg[self.CurGuideCfg.group_id]
        else
            self:UpdateGuide(_G.GuideTeachType.Function, name)
            if self.CurGuideId <= 0 then
                self.CurGuideId = self:GetNFGuide(_G.GuideTeachType.Function, name)
                if self.CurGuideId > 0 then
                    self.CurGuideCfg = _G.ConfigManager.teach_info_cfg[self.CurGuideId]
                    self.CurGuideModelCfg = _G.ConfigManager.teach_model_cfg[self.CurGuideCfg.group_id]
                end
            end
        end

        if _G.AppSetting.IsDebugTeach then
            _G.Log(self.CurGuideId, "功能刷新出id")
        end
        if self.CurGuideId > 0 and self.CurGuideCfg then
            if name == _G.ConfigManager.ui_cfg.MainView.Name and not self:CheckMainViewTab(self.CurGuideCfg) then
                return
            end
            self:DoPlay(self.CurGuideId)
        else
            if _G.AppSetting.IsDebugTeach then
                _G.Log("未查询到" .. name .. "对应的引导组开始节点，确实没配请忽略！")
            end
        end
    end
end

---获取符合条件的触发式引导
---@param teachType number 引导类型（1=功能引导；2=战斗引导；）
function GuideManager:GetNFGuide(teachType, name)
    local guideId = 0
    for i = 1, #self.GuideMTModelCfgList do
        local item = self.GuideMTModelCfgList[i]
        if item.discard == false then
            if not self:GetDot(item.id) then
                local cfginfo = _G.ConfigManager.teach_info_cfg[item.start_node[1]]
                local conditionType = self:DoCheckFunConditon(cfginfo)
                if conditionType ~= 1 then
                    if cfginfo.teach_type == teachType then
                        if teachType == 1 and cfginfo.function_id == name then
                            guideId = cfginfo.id
                        else
                            if require("ChapterModel"):GetInstance():GetCurSectionSID() == cfginfo.function_id then
                                guideId = cfginfo.id
                            end
                        end
                        if guideId > 0 then
                            break
                        end
                    end
                end
            end
        end
    end
    return guideId
end

