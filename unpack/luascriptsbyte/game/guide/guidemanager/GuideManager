---@param parent UnityEngine.GameObject 父节点
function GuideManager:AddInitMask(parent)
    self.GuideMask = _G.GameObject("guidemask")
    self.GuideMask.layer = _G.LayerMask.NameToLayer("UI")
    self.GuideMask:SetParentE(parent)

    local rt = self.GuideMask:AddComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    rt:SetRectTransformAnchor(0, 0, 1, 1)
    rt:SetRectTransformOffset(0, 0, 0, 0)
    self.GuideMask:AddComponentE(_G.typeof(_G.CS.UnityEngine.CanvasRenderer))
    local canvas = self.GuideMask:AddComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
    canvas.overrideSorting = true
    canvas.sortingOrder = 4500
    self.GuideMask:AddComponentE(_G.typeof(_G.CS.AorEmptyGraphic))
    self.GuideMask:AddComponentE(_G.typeof(_G.CS.AorGraphicRaycaster))
