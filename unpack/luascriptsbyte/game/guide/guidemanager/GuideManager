---显示引导
function GuideManager:DisPlayGuide(isStory)
    if nil == isStory then
        isStory = false
    end

    if self.Guide then
        if _G.AppSetting.IsDebugTeach then
            _G.Log("显示引导")
        end
        if self.IsGuideing and self.CurGuideCfg then
            if
                self.CurGuideCfg.global_function ~= "" and
                _G.string.contains(self.CurGuideCfg.global_function, "GlobalInterface.PlayStory")
            then
                isStory = false
            end
            if
                self.CurGuideCfg.node ~= _G.GuideNodeType.WaitFightEnd and
                self.CurGuideCfg.node ~= _G.GuideNodeType.WaitUIClose and
                self.CurGuideCfg.node ~= _G.GuideNodeType.WaitForDo and
                self.CurGuideCfg.node ~= _G.GuideNodeType.WaitUIOpen
            then
                if self.CurGuideCfg.click_tag == "" and self.CurGuideCfg.text_type == 0 then
                    if _G.AppSetting.IsDebugTeach then
                        _G.Log("空节点不处理显示引导处理逻辑")
                    end
                else
                    if _G.AppSetting.IsDebugTeach then
                        _G.Log("显示引导并处理引导遮挡更新操作>>>>>>>>>>>>>")
                    end
                    self.Guide:UpdateShowAorBtnFull(isStory)
                end
            end
        end
        _G.GameUtil.SetActiveByCondition(self.Guide.gameObject, true)
    end
end

