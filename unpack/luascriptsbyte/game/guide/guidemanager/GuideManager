---引导条件判断(因解析方式和条件复用性不高，暂时不放通用条件判断中去)
-- 0：无；1：进入房间(填id)；2：等级；3：副本已通关（填id）；4：已获得装备（填装备id）；5：已获得道具（填道具id）；6：已开启未通关（填id）；7：未穿戴；8：放置已通关（放置id）;9:已开启未通关（填放置id）
local CheckCondition = {
    [1] = function(params)
        local isPass = _G.ChapterRoomManager:GetInstance():CheckRoomPass(params[1])
        -- (isPass, "进入房间" .. params[1] .. ">>>>>>>>>>")
        return isPass
    end,
    [2] = function(params)
        -- 角色等级
        local lv = params and params[1] or 0
        -- (_G.PlayerModel:GetInstance():GetLevel() .. ">=" .. lv, "角色等级条件")
        return _G.PlayerModel:GetInstance():GetLevel() >= lv
    end,
    [3] = function(params)
        -- 关卡是否完成
        local id = params and params[1] or 0
        return require("ChapterModel"):GetInstance():CheckSectionPass(id)
    end,
    [4] = function(params)
        -- 已获得装备（填装备id）
        for i = 1, #params do
            if not _G.StorageManager:GetInstance():CheckItem(params[i], 1) then
                return false
            end
        end
        return true
    end,
    [5] = function(params)
        -- 持有道具
        for i = 1, #params do
            if not _G.StorageManager:GetInstance():CheckItem(params[i], 1) then
                return false
            end
        end
        return true
    end,
    [6] = function(params)
        -- 已开启未通关
        -- (require("ChapterModel"):GetInstance():GetCurSectionSID(), "已开启未通关条件" .. params[1] .. ">>>>>>>>>>获得SectionSID是")
        return require("ChapterModel"):GetInstance():GetCurSectionSID() == params[1]
    end,
    [7] = function(params)
        -- 此装备未穿戴
        ---@type EquipmentItem
        local item = _G.StorageManager:GetInstance():GetDatasBySidGuide(_G.StorageID.Equipment, params[1])
        if #item <= 0 then
            return false
        end
        for i = 1, #item do
            if item[i].cardUid <= 0 then
                return true
            end
        end
        return false
    end,
    [8] = function(params)
        -- 放置已通关（放置id）
        return require("AfkModel"):GetInstance():CheckSectionIsPass(params[1])
    end,
    [9] = function(params)
        -- 已开启未通关（放置id）
        return require("AfkModel"):GetInstance():IsCurSection(params[1])
    end,
    [10] = function(params)
        -- 指定ID角色未穿戴装备
        ---@type CardData[]
        local item = _G.StorageManager:GetInstance():GetDatasBySidGuide(_G.StorageID.Card, params[1])
        if #item <= 0 then
            return false
        end
        for i = 1, #item do
            if item[i]:GetEquipBarNumber() <= 0 then
                return true
            end
        end
        -- end
        return false
    end,
    [11] = function(params)
        -- 指定任务未完成
        if not _G.TaskModule:GetInstance():IsCompletedTask(params[1]) then
            return true
        end
        return false
    end,
    [12] = function(params)
        -- 是否有可升星的卡片
        local CardList = require("CardInfoManager"):GetInstance():GetSortUpStarAll(nil, true)
        if #CardList > 0 then
            return true
        end
        return false
    end,
    [13] = function(params)
        -- 布阵中是否是对应的战斗怪物组id
        local base = require("EmbattleController"):GetInstance():GetCurEmbattleItem()
        if base and base:GetMonsterGroupID() == params[1] then
            return true
        end
        return false
    end,
    [14] = function(params)
        -- 是否创建角色
        local ccr = _G.PlayerModel:GetInstance():CheckCreateRole()
        local ccrParams = ccr and 1 or 0
        return ccrParams == params[1]
    end,
    [15] = function(params)
        -- 玩家创号天数
        local ct = _G.PlayerModel:GetInstance():GetCreateRoleTime()

        local createToEndTime = _G.TimeUtil.GetInterValDayByGame(ct, _G.TimeUtil.GetServerUnixTime()) + 1
        if _G.AppSetting.IsDebugTeach then
            _G.Log(ct, "创建时间戳")
            _G.Log(_G.TimeUtil.GetServerUnixTime(), "创建时间戳")
            _G.Log(createToEndTime, "玩家建号总天数>>>>>")
        end

        if createToEndTime < params[1] then
            return false
        end
        return true
    end,
    [16] = function(params)
        -- 是否满足招募次数要求
        local curDrawNum = require("DrawModel"):GetInstance().XinYuanDanDrawNum
        if curDrawNum >= params[1] then
            return true
        end
        return false
    end,
    [17] = function(params)
        -- 是否满足VIP等级要求
        local vipLevel = require("VIPPrivilegeModel"):GetInstance().currentVipLevel
        if vipLevel >= params[1] then
            return true
        end
        return false
    end,
    [18] = function(params)
        -- 匹配序章进度
        local key = _G.LoginManager:GetInstance():GetCreatePlayerKey()
        local data = _G.PlayerPrefsManager.GetTable(key, true)
        if nil ~= data then
            if _G.AppSetting.IsDebugTeach then
                _G.Log(data.last_room, "本地记录房间号")
                _G.Log(params[1], "要求房间号")
            end
            if data.last_room == params[1] then
                return true
            end
        end
        return false
    end,
    [19] = function(params)
        -- 当前招募类型是否匹配
        local win = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DrawView.Name)
        if win and win.View then
            if win.View.CurView == params[1] then
                return true
            end
        end
        return false
    end,
    [20] = function(params)
        --镇魂街ZHJ-31230 【主任务】beta_0.2.0_jttw贪玩三测ZHJ-33073
        --【客户端】助战引导优化
        local embattleType = require("EmbattleController"):GetInstance():GetAssistID()
        if embattleType == _G.EmbattleType.AFKOnly then
            -- NPC助战可开启引导
            -- local showGuide = require("EmbattleController"):GetInstance():CheckCardAssist()
            -- local FriendHelpModel = require "FriendHelpModel":GetInstance()
            -- local isCountTrue =
            --     FriendHelpModel:GetUseCount(embattleType, false) > 0 or
            --     FriendHelpModel:GetUseCount(embattleType, true) > 0
            -- return showGuide or isCountTrue

            local FriendHelpModel = require "FriendHelpModel":GetInstance()
            local datas, npcDatas = FriendHelpModel:GetBorrowCardDatas(true, 1)
            return #datas > 0 or #npcDatas > 0
        else
            return false
        end
    end,
    [50] = function(params)
        -- 未通关放置关卡
        local isPass = require("AfkModel"):GetInstance():CheckSectionIsPass(params[1])
        return not isPass
    end,
    [51] = function(params)
        ---判断是否满足开服天数
        if not _G.PlayerModel:GetInstance().open_time then
            return false
        end
        local result =
            _G.TimeUtil.GetServerUnixTime() - _G.PlayerModel:GetInstance().open_time >= (params[1] - 1) * 86400
        return result
    end,
    [52] = function(params)
        ---千机黑刹阵亡≥1时
        local ishpz = require "DungonesModel":GetInstance():CheckHpZero()
        return ishpz
    end,
    [53] = function(params)
        ---竞技场未结算
        local ArenaManager = require "ArenaManager"
        local arenaClass = ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.normal)
        if nil == arenaClass then
            return false
        end
        return arenaClass:GetCurArenaState() == 1
    end,
    [54] = function(params)
        ---千机黑刹未结算
        local DungonesModel = require "DungonesModel":GetInstance()
        return not DungonesModel:IsSettle()
    end,
    [55] = function(params)
        ---Vip等级
        if _G.AppSetting.DEBUG then
            _G.LogWarning("当前vip等级是" .. require("VIPPrivilegeModel"):GetInstance().realVipLevel)
            _G.LogWarning("要求vip等级是" .. params[1])
        end
        return require("VIPPrivilegeModel"):GetInstance().realVipLevel >= params[1]
    end,
    [56] = function(params)
        ---判断招募资源打到N次
        local dmIns = require "DrawModel":GetInstance()
        local num = dmIns.Pools[101].total_count
        --普通招募+五行招募次数
        --_G.Log(num, "普通招募次数")
        for i = 301, 305 do
            num = num + dmIns.Pools[i].total_count
        end
        --_G.Log(num, "总招募次数")
        return num >= params[1]
    end,
    [57] = function(params)
        ---判断背包中是否有满足星级条件卡
        local storageCard = _G.StorageManager:GetInstance():GetCardDataSortList(false)
        for _, value in pairs(storageCard) do
            if value:GetStar() >= params[1] then
                return true
            end
        end
        return false
    end,
    [58] = function(params)
        ---判断当前是否开启对应副玩法
        local model = require("MiniGameJumpManager"):GetInstance()
        return model:GetGameType() == params[1]
    end
}

function GuideManager:__init()
    if _G.AppSetting.IsShowTeach then
        self.CurGuideId = 0
        self.IsGuideing = false
        self.GuideBlackList = {
            _G.ConfigManager.ui_cfg.HUDView.Name,
            _G.ConfigManager.ui_cfg.ShadowView.Name,
            _G.ConfigManager.ui_cfg.LoadingView.Name,
            _G.ConfigManager.ui_cfg.BattleView.Name,
            _G.ConfigManager.ui_cfg.GameNetTipsView.Name,
            _G.ConfigManager.ui_cfg.View_PropUp.Name,
            _G.ConfigManager.ui_cfg.PowerUpView.Name,
            _G.ConfigManager.ui_cfg.EmbattleView.Name,
            _G.ConfigManager.ui_cfg.BlackCurtainView.Name,
            _G.ConfigManager.ui_cfg.MainSceneView.Name,
            _G.ConfigManager.ui_cfg.LoginView.Name,
            _G.ConfigManager.ui_cfg.QuickUseTipView.Name,
            _G.ConfigManager.ui_cfg.FloatMessagesView.Name
        }
        self.AllGuideCfgList = {}
        self.GuideModelCfgList = {}
        self.GuideMTModelCfgList = {}
        if _G.AppSetting.IsEditor then
            for gid, v in pairs(_G.ConfigManager.teach_model_cfg) do
                if v.discard == false then --and v.id ~= 5000 then
                    local cfg
                    for i = 1, #v.start_node do
                        local id = v.start_node[i]
                        cfg = _G.ConfigManager.teach_info_cfg[id]
                        if cfg then
                            if cfg.group_id ~= gid then
                                if _G.AppSetting.IsDebugTeach then
                                    _G.LogError(gid, "引导组中的开始节点对应的组id不匹配，请修复当前组>>>>>>>>>>")
                                end
                            end
                            if cfg.node ~= _G.GuideNodeType.Start then
                                if _G.AppSetting.IsDebugTeach then
                                    _G.LogError(gid, "引导组中的结束节点对应的引导类型不匹配，它不是一个开始节点，请修复当前组>>>>>>>>>>")
                                end
                            end
                        else
                            if _G.AppSetting.IsDebugTeach then
                                _G.LogError(gid, "引导组中的开始节点找不到引导节点，请修复当前组>>>>>>>>>>")
                            end
                        end
                    end
                    cfg = _G.ConfigManager.teach_info_cfg[v.end_node]
                    if cfg then
                        if cfg.group_id ~= gid then
                            if _G.AppSetting.IsDebugTeach then
                                _G.LogError(gid, "引导组中的结束节点对应的组id不匹配，请修复当前组>>>>>>>>>>")
                            end
                        end
                        if cfg.node ~= _G.GuideNodeType.End then
                            if _G.AppSetting.IsDebugTeach then
                                _G.LogError(gid, "引导组中的结束节点对应的引导类型不匹配，它不是一个结束点，请修复当前组>>>>>>>>>>")
                            end
                        end
                    else
                        if _G.AppSetting.IsDebugTeach then
                            _G.LogError(gid, "引导组中的结束节点找不到引导节点，请修复当前组>>>>>>>>>>")
                        end
                    end
                end
            end
        end

        ---筛选强制和非强制
        for _, v in pairs(_G.ConfigManager.teach_info_cfg) do
            local group = _G.ConfigManager.teach_model_cfg[v.group_id]
            if group then
                ---组未废弃，(单个引导废弃在引导中处理)
                if group.discard == false and group.id ~= 5000 and group.make_type == false then
                    table.insert(self.AllGuideCfgList, v)
                end
            end
        end

        ---@param info teach_info_cfg
        _G.SortList(
            self.AllGuideCfgList,
            function(info)
                local cfg = _G.ConfigManager.teach_model_cfg[info.group_id]
                return -cfg.order, -info.id
            end
        )

        ---分别保存主线引导model和触发式model
        for _, v in pairs(_G.ConfigManager.teach_model_cfg) do
            if v.id ~= 5000 then
                if v.make_type == false then
                    table.insert(self.GuideModelCfgList, v)
                else
                    table.insert(self.GuideMTModelCfgList, v)
                end
            end
        end
        _G.SortList(
            self.GuideModelCfgList,
            function(item)
                return -item.order
            end
        )

        _G.SortList(
            self.GuideMTModelCfgList,
            function(item)
                return -item.order
            end
        )

        self.FirstTeachType = 2
        self.FirstFunctionId = _G.ConfigManager.ui_cfg.ChapterEmbattleView.Name

        self.IsGuideLoading = false
        self.GotoBattleIng = false
        self.LoseGuideId = 0
        self.NotForceGroupId = 0
        self.RuningStorys = {}
        self.RuningStorysDebug = {}

        self.IsSpOpening = { false, false, false }

        _G.Events:GetInstance():AddListener(_G.MianViewState.MainViewEnable, self.MainViewEnable, self)
        _G.Events:GetInstance():AddListener(_G.MianViewState.MainViewChangeTab, self.MainViewEnable, self)
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIShow, self.OnUIShow, self)
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
        _G.Events:GetInstance():AddListener(_G.eScene.EnterWorldOver, self.OnSceneChangeOver, self)
        _G.Events:GetInstance():AddListener(_G.eDialogueEvent.ShowTaskinfo, self.OnActionEvent, self)
        _G.Events:GetInstance():AddListener(_G.eNav.NavInterruptMove, self.OnNavInterruptMove, self)
        _G.Events:GetInstance():AddListener(_G.GuideStoryStart.StoryStart, self.OnStoryStart, self)
        _G.Events:GetInstance():AddListener(_G.GuideStoryStart.StoryEnd, self.OnStoryEnd, self)
        _G.Events:GetInstance():AddListener(_G.VideoPlayState.PlayStart, self.OnVideoPlayStart, self)
        _G.Events:GetInstance():AddListener(_G.VideoPlayState.PlayEnd, self.OnVideoPlayEnd, self)
        _G.Events:GetInstance():AddListener(_G.eGuideEvent.WaitFo, self.OnWaitFo, self)
        _G.Events:GetInstance():AddListener(_G.eGuideEvent.WorldObjRespond, self.OnWorldObjRespond, self)
        _G.TaskModule:GetInstance():AddListener(
            _G.TaskModuleEvent,
            _G.TaskModuleEvent.EnumValueTable.NavComplete,
            self.OnTaskInfoUpdate,
            self
        )
        _G.Events:GetInstance():AddListener(_G.eGuideEvent.TreasureMap, self.DoTreasureMap, self)
        _G.Events:GetInstance():AddListener(_G.eGuideEvent.SpecialTrigger, self.SpecialTrigger, self)

        self.CurAudio = nil
    end
end

---@param type GuideSpecialTrigger
function GuideManager:SpecialTrigger(type)
    if type == _G.GuideSpecialTrigger.DrawTypeChange then
        ---招募
        self:CheckFunctionGuide(_G.ConfigManager.ui_cfg.DrawView.Name)
    end
end

function GuideManager:DoTreasureMap(isStart)
    if isStart then
        if self.IsGuideing then
            if _G.AppSetting.IsDebugTeach then
                _G.Log("引导监听寻宝触发")
            end
            if self.CurGuideModelCfg.not_force then
                if self.CurGuideCfg.click_tag == "" and self.CurGuideCfg.text_type == 0 then
                    if _G.AppSetting.IsDebugTeach then
                        _G.Log("非强制引导非操作的节点不能打断>>>>>>>>")
                    end
                else
                    if _G.AppSetting.IsDebugTeach then
                        _G.Log("非强制引导打断操作节点>>>>>>>>>>")
                    end
                    self:DoBreak()
                    self.LoseGuideId = 0
                end
            end
        end
    end
end

---等待外部触发，不确定的逻辑，（如消息等）
function GuideManager:OnWaitFo(pbCmd)
    if self.IsGuideing then
        if self.CurGuideCfg.node == _G.GuideNodeType.WaitForDo then
            if _G.AppSetting.IsDebugTeach then
                _G.Log(self.CurGuideCfg.cmd, "引导cmd字段>>>>>>>>>>>")
            end
            if self.CurGuideCfg.cmd then
                if _G.AppSetting.IsDebugTeach then
                    _G.Log(pbCmd, "当前接收到的消息CMD>>>>>>>>>>>")
                end

                if _G.AppSetting.IsDebugTeach then
                    _G.Log(self.CurGuideCfg.cmd.PBCmd, "配置表对应消息CMD>>>>>>>>>>>")
                end
                if self.CurGuideCfg.cmd.PBCmd == pbCmd then
                    self:ShowMask(false)

                    if _G.AppSetting.IsDebugTeach then
                        _G.Log(self.CurGuideCfg.id, "引导cmd字段外部触发逻辑>>>>>>>>>>>")
                    end
                    self:DoNext()
                    return
                end
            end
        end
    end
end

---剧情开始
function GuideManager:OnStoryStart(key)
    if _G.AppSetting.IsDebugTeach then
        _G.Log(tostring(key) .. ">>>>>>" .. os.clock(), "新手引导中剧情<<<<<<< 开始 <<<<<<<<<<")
    end
    local tb = _G.debug.traceback()
    _G.table.insert(self.RuningStorys, key)
    _G.table.insert(self.RuningStorysDebug, tb)

    if not self.IsSpOpening[1] then
        self.IsSpOpening[1] = true
        self:HideGuide()
    end
end

---剧情结束
function GuideManager:OnStoryEnd(key)
    if _G.AppSetting.IsDebugTeach then
        _G.Log(tostring(key) .. ">>>>>>" .. os.clock(), "新手引导中剧情<<<<<<< 结束 <<<<<<<<<<")
    end
    local index = _G.table.indexof(self.RuningStorys, key)
    if _G.table.ContainsValue(self.RuningStorys, key) then
        _G.table.removebyvalue(self.RuningStorys, key)
    end
    if index ~= false then
        _G.table.remove(self.RuningStorysDebug, index)
    end

    if _G.AppSetting.IsDebugTeach then
        _G.Log(self.RuningStorys, "执行中的剧情>>>>>>>>>>>")
    end

    if _G.AppSetting.IsDebugTeach then
        _G.Log(self.RuningStorysDebug, "执行中的剧情堆栈>>>>>>>>>>>")
    end
    if self.IsSpOpening[1] and #self.RuningStorys <= 0 then
        self.IsSpOpening[1] = false
        self:DisPlayGuide(true)
    end
end

---视频播放开始
function GuideManager:OnVideoPlayStart()
    if self.IsGuideing then
        --镇魂街ZHJ-30707 Beta_0.1.9_jttw BUG合集ZHJ-30998
        --【新手引导】特殊操作下导致功能与新手引导不一致
        --多开几个界面的情况下，可能触发了上个界面的引导导致出现异常
        if self.CurGuideCfg.teach_type == _G.GuideTeachType.Function then
            if self.CurGuideCfg.node == 1 then
                if self.CurGuideModelCfg.make_type then
                    --local GuideModel = require("GuideModel")
                    self:DelDot(self.CurGuideModelCfg.id)
                end
                self:DoBreak()
                if _G.AppSetting.IsDebugTeach then
                    _G.Log("", "打开视频时，可能触发了上个界面的引导导致出现异常,>>>>>>")
                end
            end
        end
        return
    end
end

---视频播放结束
function GuideManager:OnVideoPlayEnd()
    if self.IsGuideing then
        if self.CurGuideCfg.node == _G.GuideNodeType.WaitVideoEnd then
            if _G.AppSetting.IsDebugTeach then
                _G.Log(self.CurGuideCfg.id, "引导视频播放结束>>>>>>>>>>>")
            end
            self:DoNext()
            return
        end
    end
end

---寻路中断
function GuideManager:OnNavInterruptMove()
    if self.IsGuideing then
        if _G.AppSetting.IsDebugTeach then
            _G.Log("<color=red><size=20>寻路中断事件>>>>>>></size></color>", "")
        end
        if self.CurGuideCfg.node == _G.GuideNodeType.WaitNav then
            self.Guide:StopView()
        end
    end
end

---任务接领事件
function GuideManager:OnActionEvent()
    if self.IsGuideing then
        if _G.AppSetting.IsDebugTeach then
            _G.Log("<color=red><size=20>任务接领事件>>>>>>></size></color>", "")
        end
        if self.CurGuideCfg.node == _G.GuideNodeType.WaitForDo then
            self:DoNext()
        end
    end
end

---寻路结束事件
function GuideManager:OnTaskInfoUpdate()
    if self.IsGuideing then
        if _G.AppSetting.IsDebugTeach then
            _G.Log("<color=red><size=20>寻路结束事件>>>>>>></size></color>", "")
        end
        if self.CurGuideCfg.node == _G.GuideNodeType.WaitNav then
            self:DoNext()
        end
    end
end

---场景切换完成
function GuideManager:OnSceneChangeOver()
    if _G.AppSetting.IsDebugTeach then
        _G.Log("引导切换场景完成场景类型>>>")
    end
    if self.IsGuideing then
        if self:CheckMainViewTab(self.CurGuideCfg) then
            if self.CurGuideCfg.teach_type == _G.GuideTeachType.Fight then
                if _G.AppSetting.IsDebugTeach then
                    _G.Log(self.CurGuideCfg.id, "<color=red><size=10>引导异常，当前引导和主城场景不匹配，非正常流程请忽略</size></color>")
                end

                if _G.AppSetting.IsDebugTeach then
                    _G.Log(_G.WorldManager:GetInstance().CurrentWorld.Cfg.WorldType, "引导切换场景完成世界类型>>>")
                end
                self:DoBreak()
                if self:CheckMainViewTab(self.CurGuideCfg) then
                    ---主界面检测
                    self:CheckFunctionGuide(_G.ConfigManager.ui_cfg.MainView.Name)
                else
                    if _G.AppSetting.IsDebugTeach then
                        _G.Log("<color=red>非主世界不刷新引导</color>")
                    end
                end
            end
        end
    else
        if self:CheckMainViewTab(self.CurGuideCfg) then
            ---主界面检测
            self:CheckFunctionGuide(_G.ConfigManager.ui_cfg.MainView.Name)
        end
    end
end

---刷新引导信息
---@param teachType GuideTeachType 是否是战斗功能
---@param name string 功能对应名称
function GuideManager:UpdateGuide(teachType, name)
    ---如果没有开始引导就找出引导
    if not self.IsGuideing then
        --local GuideModel = require("GuideModel")

        if _G.AppSetting.IsDebugTeach then
            _G.Log(GuideModel:GetInstance().GuideDot, "刷新引导时记录打点数据")
        end

        ---没有打点就视为新手引导起点(强制引导)
        if GuideModel:GetInstance().GuideDot == 0 then
            if teachType == _G.GuideTeachType.Function then --and name == self.FirstFunctionId then
                for i = 1, #self.AllGuideCfgList do
                    ---@type teach_info_cfg
                    local guideCfg = self.AllGuideCfgList[i]
                    if
                        guideCfg.teach_type == teachType and guideCfg.node == _G.GuideNodeType.Start and
                        --guideCfg.function_id == name and
                        0 == self:DoCheckFunConditon(guideCfg)
                    then
                        self.CurGuideId = self.AllGuideCfgList[i].id
                        break
                    end
                end
            else
                self.CurGuideId = 0
            end
        else
            ---如果打点不在配置范围内视为结束
            local item = _G.ConfigManager.teach_info_cfg[GuideModel:GetInstance().GuideDot]
            if item then
                ---如果不是结束点，就直接从这个组开始
                if item.node ~= _G.GuideNodeType.End then
                    local cfg = _G.ConfigManager.teach_model_cfg[item.group_id]
                    local itemTemp = _G.ConfigManager.teach_info_cfg[cfg.start_node[1]]
                    local conditionType = self:DoCheckFunConditon(itemTemp)
                    if conditionType == 1 then
                        if _G.AppSetting.IsDebugTeach then
                            _G.LogError(
                                item.open_condition,
                                "新手引导  关键点打点异常并且>>[" .. item.id .. "]条件不满足，检测后续引导，要求条件>>>>>>>>>>>"
                            )
                        end
                        self:GetNextGroupCondition(item.group_id, teachType, name)
                    else
                        for _, v in ipairs(cfg.start_node) do
                            local cfginfo = _G.ConfigManager.teach_info_cfg[v]
                            if teachType == 1 then
                                if cfginfo.teach_type == teachType and cfginfo.function_id == name then
                                    if cfginfo.function_id == _G.ConfigManager.ui_cfg.MainView.Name then
                                        if self:CheckMainViewTab(cfginfo) then
                                            if v > GuideModel:GetInstance().GuideDot then
                                                self.CurGuideId = v
                                                break
                                            end
                                        end
                                    else
                                        if v > GuideModel:GetInstance().GuideDot then
                                            self.CurGuideId = v
                                            break
                                        end
                                    end
                                end
                            else
                                if cfginfo.teach_type == teachType then
                                    if v > GuideModel:GetInstance().GuideDot then
                                        self.CurGuideId = v
                                        break
                                    end
                                end
                            end
                        end
                        if (not self.CurGuideId or self.CurGuideId == 0) and item.node == _G.GuideNodeType.Irreversible then
                            self:GetNextGroupCondition(item.group_id, teachType, name)
                        end
                    end
                else
                    self:GetNextGroupCondition(item.group_id, teachType, name)
                end
            else
                self.CurGuideId = 0
            end
        end

        if self.CurGuideId == 0 then
            self.CurGuideCfg = nil
            self.CurGuideModelCfg = nil
        else
            self.CurGuideCfg = _G.ConfigManager.teach_info_cfg[self.CurGuideId]
            self.CurGuideModelCfg = _G.ConfigManager.teach_model_cfg[self.CurGuideCfg.group_id]
        end
    end
end

---目标界面是否在最上层
function GuideManager:CheckTargetViewIsTop(name)
    ---@type UIWindow
    local topui = _G.UIManager:GetInstance():GetTopWindowByLayer(_G.UILayers.TopLayer.Name)
    if topui then
        return false
    end
    topui = _G.UIManager:GetInstance():GetTopWindowByLayer(_G.UILayers.NormalLayer.Name)
    if topui then
        return false
    end
    topui = _G.UIManager:GetInstance():GetTopWindowByLayer(_G.UILayers.SceneLayer.Name)
    return topui and topui.Name == name
end

---检查主界面页签
function GuideManager:CheckMainViewTab(guideCfg)
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name)
    if view and (not view.gameObject or view.gameObject:GetActiveSelf() == 0) then
        return false
    end

    if not self:CheckTargetViewIsTop(_G.ConfigManager.ui_cfg.MainView.Name) then
        return false
    end

    if guideCfg then
        if view and not _G.table.indexof(guideCfg.function_type, view:GetTogKey()) then
            return false
        end
    end

    return true
end

---是否已经过了验证关卡
function GuideManager:IsPassSection(cfg)
    local isPass = false
    local sectionId = 0
    for i = 1, #cfg.open_condition do
        if cfg.open_condition[i][1] == 9 then
            sectionId = cfg.open_condition[i][2]
            break
        end
    end

    if sectionId > 0 then
        isPass = require("AfkModel"):GetInstance():CheckSectionIsPass(sectionId)
    end

    return isPass
end

