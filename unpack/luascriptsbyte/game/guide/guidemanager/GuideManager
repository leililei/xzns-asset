---战斗条件检测接口
function GuideManager.CSTryDoGuide(tab)
    local battleGuideType = tab.battleGuideType
    if battleGuideType == _G.BattleGuideType.OnStartFight then
        GuideManager:GetInstance():CallCSSetRoomId()
        GuideManager:GetInstance():FightStart()
    elseif battleGuideType == _G.BattleGuideType.OnEndFight then
        if _G.AppSetting.IsDebugTeach then
            _G.Log(tab.arg1, "胜利失败标记")
        end
        local win = tonumber(tab.arg1) == 1 and true or false
        GuideManager:GetInstance():FightEnd(win)
        return
    end

    local curGuideCfg = GuideManager:GetInstance().CurGuideCfg
    local monsterGroupId = _G.BattleManager:GetInstance():GetMonsterGroupId()

    if
        curGuideCfg ~= nil and curGuideCfg.teach_type == _G.GuideTeachType.Fight and
        curGuideCfg.function_id == tostring(monsterGroupId)
    then
        local OpenCondition
        local OpenConditionType = -1
        if #curGuideCfg.open_condition > 0 then
            OpenCondition = curGuideCfg.open_condition[1]
            OpenConditionType = curGuideCfg.open_condition[1][1]
        end

        -- _G.CS.BattleManager.Inst:PauseBattle(true) -- 暂停战斗（参数为是否隐藏战斗UI）
        -- _G.CS.BattleManager.Inst:ResumeBattle()   -- 恢复战斗

        if battleGuideType == OpenConditionType then
            local function RealDoGuide()
                if curGuideCfg.node == _G.GuideNodeType.Pause then
                    if _G.AppSetting.IsDebugTeach then
                        _G.Log("curGuideCfg.node == _G.GuideNodeType.Pause")
                    end

                    if _G.AppSetting.IsDebugTeach then
                        _G.Log(battleGuideType, "条件触发一个节点")
                    end
                    _G.CS.BattleManager.Inst:PauseBattle(false)
                end

                if _G.AppSetting.IsDebugTeach then
                    _G.Log(curGuideCfg.id, "条件触发去下一个节点")
                end
                GuideManager:GetInstance():DoNext()
            end

            local function DoGuide()
                local OpenConditionFrame = curGuideCfg.open_condition[2]
                if OpenConditionFrame then
                    local OpenConditionFrameStart = OpenConditionFrame[2]
                    local OpenConditionFrameEnd = OpenConditionFrame[3]
                    local frame = tab.frame
                    if OpenConditionFrameStart <= frame and frame < OpenConditionFrameEnd then
                        RealDoGuide()
                    end
                else
                    RealDoGuide()
                end
            end

            if battleGuideType == _G.BattleGuideType.OnStartFight then
                local delayTime = OpenCondition[2]
                _G.DelayDo(
                    delayTime,
                    function()
                        DoGuide()
                    end
                )
            elseif battleGuideType == _G.BattleGuideType.OnMpChange then
                local monsterId = tab.arg1
                local cardId = tab.arg2
                local ratio = tab.arg3
                local conditionMonsterId = OpenCondition[2]
                local conditionRatio = OpenCondition[3]
                if (monsterId == conditionMonsterId or cardId == conditionMonsterId) and ratio >= conditionRatio then
                    DoGuide()
                end
            elseif battleGuideType == _G.BattleGuideType.OnHPChange then
                local monsterId = tab.arg1
                local cardId = tab.arg2
                local ratio = tab.arg3
                local conditionMonsterId = OpenCondition[2]
                local conditionRatio = OpenCondition[3]
                if (monsterId == conditionMonsterId or cardId == conditionMonsterId) and ratio <= conditionRatio then
                    DoGuide()
                end
            elseif battleGuideType == _G.BattleGuideType.OnSkillStart then
                local monsterId = tab.arg1
                local cardId = tab.arg2
                local skillId = tab.arg3
                local conditionMonsterId = OpenCondition[2]
                local conditionSkillId = OpenCondition[3]
                local delayTime = OpenCondition[4]
                if (monsterId == conditionMonsterId or cardId == conditionMonsterId) and skillId == conditionSkillId then
                    _G.DelayDo(
                        delayTime,
                        function()
                            DoGuide()
                        end
                    )
                end
            elseif battleGuideType == _G.BattleGuideType.OnAttackerSpChange then
                local jointSkillId = tab.arg1
                local conditionSkillId = OpenCondition[2]
                if jointSkillId == conditionSkillId then
                    DoGuide()
                end
            elseif battleGuideType == _G.BattleGuideType.OnDefenderSpChange then
                local jointSkillId = tab.arg1
                local conditionSkillId = OpenCondition[2]
                if jointSkillId == conditionSkillId then
                    DoGuide()
                end
            elseif battleGuideType == _G.BattleGuideType.OnGhostSkillEnd then
                local monsterId = tab.arg1
                local cardId = tab.arg2
                local skillId = tab.arg3
                local conditionMonsterId = OpenCondition[2]
                local conditionSkillId = OpenCondition[3]
                local delayTime = OpenCondition[4] + 1
                if (monsterId == conditionMonsterId or cardId == conditionMonsterId) and skillId == conditionSkillId then
                    _G.DelayDo(
                        delayTime,
                        function()
                            DoGuide()
                        end
                    )
                end
            end
        end
    end
end

