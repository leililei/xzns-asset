---获取引导id是否执行过
function GuideManager:IsDoed(guideId)
    if not _G.AppSetting.IsShowTeach then
        return false
    end
    --local GuideModel = require("GuideModel")
    local dot = GuideModel:GetInstance().GuideDot
    if dot > 0 and dot ~= GuideModel:GetInstance().GuideSkipId then
        local gid = _G.ConfigManager.teach_info_cfg[dot].group_id
        local order = _G.ConfigManager.teach_model_cfg[gid].order

        for i = 1, #self.AllGuideCfgList do
            local cfg = self.AllGuideCfgList[i]
            local ordertemp = _G.ConfigManager.teach_model_cfg[cfg.group_id].order
            if ordertemp <= order and guideId == cfg.id then
                return true
            end
        end

        return false
    else
        return false
    end
end

---非强制引导其它区域响应
function GuideManager:UpdateSystemCurrentName(systemCurrentName)
    ---如果是非强制引导，如果不操作出牌，就打断
    if self.IsGuideing then
        if _G.AppSetting.IsDebugTeach then
            _G.Log(systemCurrentName, "引导监听事件响应对象")
        end
