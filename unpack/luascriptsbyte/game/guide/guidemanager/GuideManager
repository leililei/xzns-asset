---UI打开
---@param name string UI名称
function GuideManager:OnUIOpened(name)
    if false ~= _G.table.indexof(self.GuideBlackList, name) then
        -- 黑名单界面，不会检测引导
        return
    end

    if _G.AppSetting.IsDebugTeach then
        _G.Log(name, "引导监听打开界面>>>>>>")
    end

    if self.IsGuideing then
        if self.CurGuideCfg.function_id == name and self.CurGuideCfg.node == _G.GuideNodeType.WaitUIOpen then
            self:ShowMask(false)
            self:DoNext()
            return
        end
        if self.CurGuideCfg.function_id == name and self.CurGuideCfg.node == _G.GuideNodeType.WaitUIClose then
            if self.WaitNodeTimer then
                self.WaitNodeTimer:Stop()
                self.WaitNodeTimer = nil
            end
            self:ShowMask(false)
            return
        end

        if self.Guide and self.Guide.gameObject and self.Guide.gameObject:GetActiveSelf() == 1 then
            ---特殊界面隐藏引导
            if
                name == _G.ConfigManager.ui_cfg.DialogueView.Name and self.CurGuideCfg.node ~= _G.GuideNodeType.Dialogue and
                self.CurGuideCfg.function_id ~= _G.ConfigManager.ui_cfg.DialogueView.Name
            then
                if not self.IsSpOpening[2] then
                    self.IsSpOpening[2] = true
                    self:HideGuide()
                end
                return
            end
            if
                name == _G.ConfigManager.ui_cfg.RoleLevelUpView.Name or
                name == _G.ConfigManager.ui_cfg.MapIllustrationView.Name or
                name == _G.ConfigManager.ui_cfg.OpenFunctionsView.Name or
                (name == _G.ConfigManager.ui_cfg.CommonAwardView.Name and
                    self.CurGuideCfg.function_id ~= _G.ConfigManager.ui_cfg.CommonAwardView.Name)
            then
                if not self.IsSpOpening[3] then
                    self.IsSpOpening[3] = true
                    self:HideGuide()
                end
                return
            end
        end
        --镇魂街ZHJ-30707 Beta_0.1.9_jttw BUG合集ZHJ-30998
        --【新手引导】特殊操作下导致功能与新手引导不一致
        --多开几个界面的情况下，可能触发了上个界面的引导导致出现异常
        if self.CurGuideCfg.teach_type == _G.GuideTeachType.Function then
            if self.CurGuideCfg.node == 1 then
                local curView = _G.UIManager:GetInstance():GetWindowCtrl(self.CurGuideCfg.function_id)
                if curView then
                    ---@type UIWindow
                    local topui = _G.UIManager:GetInstance():GetTopWindowByLayer(_G.UILayers.TopLayer.Name)
                    if nil == topui then
                        topui = _G.UIManager:GetInstance():GetTopWindowByLayer(_G.UILayers.NormalLayer.Name)
                    end
                    if topui and topui.Name == name then
                        if self.CurGuideCfg.function_id ~= name then
                            if self.CurGuideModelCfg.make_type then
                                --local GuideModel = require("GuideModel")
                                self:DelDot(self.CurGuideModelCfg.id)
                            end
                            self:DoBreak()
                            if _G.AppSetting.IsDebugTeach then
                                _G.Log(name, "多开几个界面的情况下，可能触发了上个界面的引导导致出现异常,当前多层界面是>>>>>>")
                            end
                        end
                    end
                end
            end
        end
        return
    end

    if _G.AppSetting.IsDebugTeach then
        _G.Log(name, "UI对应名称的界面引导检测>>>>>>")
    end

    ---UI对应名称的界面引导检测
    if name ~= _G.ConfigManager.ui_cfg.DialogueView.Name then
        self:CheckFunctionGuide(name)
    end
end

