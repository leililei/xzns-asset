---创建引导
---@param parent UnityEngine.GameObject 父节点
function GuideManager:CreateGuide(parent)
    _G.PoolsManager:GetInstance():Spawn(
        "UIH5/Guide/GuideView",
        _G.ePoolType.Static,
        parent,
        function(go)
            go:SetLocalPositionToZero()
            go:SetLocalScaleToOne()
            go:SetRectOffSetToZero()

            local guideSort = 4000

            local canvas = go:GetComponentE(_G.typeof(_G.Canvas))
            canvas.overrideSorting = true
            canvas.sortingOrder = guideSort

            go:SetName("guide")
            self.Guide = require("GuideView").New()
            self.Guide:SetBind(go)

            local allComponents = go:GetComponentsInChildren(_G.typeof(_G.Canvas), true)
            local len1 = allComponents.Length - 1
            for i = 1, len1 do
                local child = allComponents[i]
                local oneSort = child.sortingOrder
                child.sortingOrder = guideSort + oneSort
            end

            self:ShowMask(false)

            if self.NeedUpdateGuide and self.CurGuideCfg then
                self.Guide:UpdateView(self.CurGuideCfg, self.CurGuideModelCfg)
            end
        end
    )
end

