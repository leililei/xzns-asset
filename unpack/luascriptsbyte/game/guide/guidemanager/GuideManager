function GuideManager:GetNextGroupCondition(group_id, teachType, name)
    ---@type teach_info_cfg_Item
    local cfg = self:GetNextGroup(group_id, teachType, name)
    if cfg then
        local conditionType = self:DoCheckFunConditon(cfg)
        if conditionType == 1 then
            self.CurGuideId = 0
            if self:IsPassSection(cfg) then
                ---@type teach_model_cfg
                --local cfgModel = _G.ConfigManager.teach_model_cfg[cfg.group_id]
                --self:DotTheEndNode(cfgModel.end_node)
                --local GuideModel = require("GuideModel")
                --local itemTemp = _G.ConfigManager.teach_info_cfg[GuideModel:GetInstance().GuideDot]
                self:GetNextGroupCondition(cfg.group_id, teachType, name)
            end
            return
        end
        self.CurGuideId = cfg.id
    else
        self.CurGuideId = 0
    end
end

---获取对应完成组的下一组
---@param groupId number 组id
---@param teachType number 引导类型（1=功能引导；2=战斗引导；）
function GuideManager:GetNextGroup(groupId, teachType, name)
    local index = 0
    for i = 1, #self.GuideModelCfgList do
        if self.GuideModelCfgList[i].id == groupId then
            index = i
            break
        end
    end
    ---没找到组
    if index <= 0 then
        if _G.AppSetting.IsDebugTeach then
            _G.LogError(groupId, "<color=red><size=20>当前打点的组不存在，请检查配置是否正常</size></color>")
        end
        return nil
    end
    ---最后一组
    if index >= #self.GuideModelCfgList then
        return nil
    end
    for j = index + 1, #self.GuideModelCfgList do
        if self.GuideModelCfgList[j].discard == false then
            for k = 1, #self.GuideModelCfgList[j].start_node do
                local cfginfo = _G.ConfigManager.teach_info_cfg[self.GuideModelCfgList[j].start_node[k]]
                if teachType == 1 then
                    if cfginfo.teach_type == teachType and cfginfo.function_id == name then
                        return cfginfo
                    end
                else
                    if cfginfo.teach_type == teachType then
                        return cfginfo
                    end
                end
            end
        end
    end
    return nil
end

