local LimitBrokenModel = require("LimitBrokenModel")
local CommonTipManager = require("CommonTipManager")

---@class LimitBrokenView : UIBaseView    中文描述
---@field public go_table LimitBrokenView_GoTable GoTable
---@field cfgList limit_broken_cfg[]
local LimitBrokenView = _G.BaseClass("LimitBrokenView", _G.UIBaseView)

local GetAutoGoTable = _G.GetAutoGoTable
local GetLangPackValue = _G.GetLangPackValue
local ConfigManager = _G.ConfigManager
local table = _G.table
local handler = _G.handler
local handlerbind = _G.handlerbind
local FinishType = LimitBrokenModel.FinishType
local limit_broken_cfg = _G.ConfigManager.limit_broken_cfg
local mission_extra_cfg = _G.ConfigManager.mission_extra_cfg

function LimitBrokenView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function LimitBrokenView:OnCreate()
    self:InitView()
    local res = _G.ConfigManager.ui_cfg.LimitBrokenView.resources
    self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, res))
    self:LoadEffect()
end

function LimitBrokenView:LoadEffect()
    local check = function(trans)
        if self:IsNil() then
            _G.DestroyObject(trans)
        end
    end
    _G.UIUtils.LoadEffectByCfg(
        ConfigManager.ui_effect_cfg.ef_LimitBrokenView_title,
        self.go_table.aorrawimage_title,
        check
    )
end

---初始化页面
function LimitBrokenView:InitView()
    self.cfgList = {}
    -- local artifactUnlock = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.ArtifactDraw)
    for _, v in pairs(limit_broken_cfg) do
        if _G.GlobalConditionManager.CheckConditionArrays(v.func_open) or v.name == 90023300137 then
            table.insert(self.cfgList, v)
        end
    end
    table.sort(
        self.cfgList,
        function(a, b)
            return a.id < b.id
        end
    )
    self.curTag = 1
    for i = 1, #self.cfgList do
        if LimitBrokenModel:GetInstance():CheckGroupHasPreFinish(self.cfgList[i].id) then
            self.curTag = i
            break
        end
    end
    self.go_table.scrollloopvectical_tag:InitItemData(#self.cfgList, _G.handler(self, self.RefreshTag))
    self.scrollList = {
        [1] = self.go_table.scrollloophorizontal_taskList1,
        [2] = self.go_table.scrollloophorizontal_taskList2,
        [3] = self.go_table.scrollloophorizontal_taskList3
    }
    for i = 1, 3 do
        self.scrollList[i]:InitItemData(0, _G.handlerbind(self, self.RefreshTask, i))
    end
    self:UpdateView()
end

function LimitBrokenView:UpdateView()
    local LimitBrokenModelIns = LimitBrokenModel:GetInstance()
    local cfg = self.cfgList[self.curTag]
    self.go_table.aorrawimage_role:LoadImage(
        cfg.portrait,
        function()
            local pos = cfg.pos_portrait
            self.go_table.aorrawimage_role:SetNativeSize()
            self.go_table.aorrawimage_role:SetLocalPosition(pos[1], pos[2], pos[3])
        end
    )
    self.go_table.aorrawimage_role:ClearChildren()
    _G.UIUtils.LoadEffectByCfg(
        ConfigManager.ui_effect_cfg[cfg.eff_path[1]],
        self.go_table.aorrawimage_role,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
        end
    )
    self.go_table.aorrawimage_title:LoadImage(
        cfg.title,
        function()
            self.go_table.aorrawimage_title:SetNativeSize()
        end
    )
    self.go_table.aortext_subTitle.text = GetLangPackValue(cfg.sec_title)
    for i = 1, 3 do
        self.go_table["slider_task" .. i]:SetRectTransformSize(148 * (#cfg.mission[i] - 1), 8)
        self.go_table["slider_task" .. i].value = LimitBrokenModelIns:GetProgress(cfg.id, i)
        self.scrollList[i]:UpdateCount(#cfg.mission[i])
        self.scrollList[i]:ScrollToIndex(LimitBrokenModelIns:GetGroupFirstNotFinish(cfg.id, i) - 1)
    end
end

function LimitBrokenView:RefreshTag(index, obj)
    index = index + 1
    ---@type LimitBrokenView._obj_tagItem_GoTable
    local tb = GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickTag, index))
    local cfg = self.cfgList[index]
    tb.aortext_title.text = GetLangPackValue(cfg.name)
    local pass, tipSid, content = _G.GlobalConditionManager.CheckConditionArrays(cfg.func_open)
    tb.aortext_lock:SetActiveE(pass and 0 or 1)
    if content then
        tb.aortext_lock.text = content
    end
    local color = index == self.curTag and "70450e" or "d4d5ed"
    tb.aorimage_isOn:SetActiveE(index == self.curTag and 1 or 0)
    tb.aortext_title.color = _G.ColorTools.FormatColorByString(color)
    tb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.LimitBroken.id, cfg.id)
end

function LimitBrokenView:OnClickTag(go, isOn, index)
    if index == self.curTag then
        return
    end
    local openParam = self.cfgList[index].func_open
    local pass, tipSid, content = _G.GlobalConditionManager.CheckConditionArrays(openParam)
    if pass then
        self.curTag = index
        self:UpdateView()
        self.go_table.scrollloopvectical_tag:UpdateAllItem()
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(tipSid, content)
    end
end

function LimitBrokenView:RefreshTask(index, obj, taskIdx)
    index = index + 1
    local cfg = self.cfgList[self.curTag]
    local taskID = cfg.mission[taskIdx][index]
    local taskData = LimitBrokenModel:GetInstance():GetTaskData(cfg.id, taskID)
    ---@type LimitBrokenView._obj_taskItem_GoTable
    local tb = GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickTask, taskIdx, index, cfg.id, taskData))
    local reward = taskData:GetReward()[1]
    tb.aorrawimage_icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(reward[1]))
    tb.aortext_num.text = "x" .. reward[2]
    tb.aortext_taskDes.text = GetLangPackValue(taskData.cfg.desc)
    tb.aorimage_Mask:SetActiveE(taskData:GetState() == FinishType.Finish and 1 or 0)
    tb.aorimage_select:SetActiveE(taskData:GetState() == FinishType.PreFinish and 1 or 0)
    tb.aorimage_select:ClearChildren()
    if taskData:GetState() == FinishType.PreFinish then
        _G.UIUtils.LoadEffectByCfg(
            ConfigManager.ui_effect_cfg.ef_LimitBrokenView_xuanzhong,
            tb.aorimage_select,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                end
            end
        )
    end
end

function LimitBrokenView:OnClickTask(go, isOn, taskIdx, index, groupID, taskData)
    local taskState = taskData:GetState()
    if taskState == FinishType.InProgress then
        CommonTipManager:GetInstance():OpenTip(go, taskData:GetReward()[1][1])
    elseif taskState == FinishType.PreFinish then
        LimitBrokenModel:GetInstance():FinishTask(
            groupID,
            {taskData.id},
            FinishType.Finish,
            function()
                self.scrollList[taskIdx]:UpdateItemSingle(index - 1)
            end
        )
    end
end

---按钮点击事件在这里派发
function LimitBrokenView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 102)
    end
end

---@private
function LimitBrokenView:OnDestroy()
end

return LimitBrokenView
