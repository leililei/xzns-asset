    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.LimitBroken) then
        return
    end
    self:UpdateAllTask()
end

function LimitBrokenModel:UpdateArtifactLevel()
    self.ArtifactLevels = {}
    local lv
    local artifactList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Artifact)
    for _, v in pairs(artifactList) do
        lv = v.lv
        if self.ArtifactLevels[lv] == nil then
            self.ArtifactLevels[lv] = 1
        else
            self.ArtifactLevels[lv] = self.ArtifactLevels[lv] + 1
        end
        if self.appointArtifactLevel[v.sid] == nil or self.appointArtifactLevel[v.sid] < lv then
            self.appointArtifactLevel[v.sid] = lv
        end
    end
    _G.Events:GetInstance():Broadcast(
        _G.ePlayAactionEvent.PlayAaction,
        {_G.ActiveTaskEnum.ConditionEnum.Artifact.LevelNum},
        1
    )
    _G.Events:GetInstance():Broadcast(
        _G.ePlayAactionEvent.PlayAaction,
        {_G.ActiveTaskEnum.ConditionEnum.Artifact.SidLevel},
        1
    )
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.LimitBroken) then
        return
    end
    self:UpdateAllTask()
end

function LimitBrokenModel:UpdateArtifactStar()
    self.ArtifactStars = {}
    local star
    local artifactList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Artifact)
    for _, v in pairs(artifactList) do
        star = v.star
        if self.ArtifactStars[star] == nil then
            self.ArtifactStars[star] = 1
        else
            self.ArtifactStars[star] = self.ArtifactStars[star] + 1
        end
        if self.appointArtifactStar[v.sid] == nil or self.appointArtifactStar[v.sid] < star then
            self.appointArtifactStar[v.sid] = star
        end
    end
    _G.Events:GetInstance():Broadcast(
        _G.ePlayAactionEvent.PlayAaction,
        {_G.ActiveTaskEnum.ConditionEnum.Artifact.StarNum},
        1
    )
    _G.Events:GetInstance():Broadcast(
        _G.ePlayAactionEvent.PlayAaction,
        {_G.ActiveTaskEnum.ConditionEnum.Artifact.SidStar},
        1
    )
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.LimitBroken) then
        return
    end
    self:UpdateAllTask()
end

function LimitBrokenModel:UpdateArtifactAwaken()
    self.ArtifactAwakens = 0
    local awaken
    local artifactList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Artifact)
    for _, v in pairs(artifactList) do
        awaken = v:GetIsAwaken()
        if awaken then
            self.ArtifactAwakens = self.ArtifactAwakens + 1
            self.appointArtifactAwaken[v.sid] = true
        end
    end
    _G.Events:GetInstance():Broadcast(
        _G.ePlayAactionEvent.PlayAaction,
        {_G.ActiveTaskEnum.ConditionEnum.Artifact.AwakenNum},
        1
    )
    _G.Events:GetInstance():Broadcast(
        _G.ePlayAactionEvent.PlayAaction,
        {_G.ActiveTaskEnum.ConditionEnum.Artifact.SidAwaken},
        1
    )
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.LimitBroken) then
        return
    end
    self:UpdateAllTask()
end

function LimitBrokenModel:CheckCardTalentCount(num, level)
    for k, v in pairs(self.cardTalents) do
        if k >= level then
            num = num - v
        end
        if num <= 0 then
            return true
        end
    end
    return false
end

function LimitBrokenModel:GetCardTalentCount(level)
    local num = 0
    for k, v in pairs(self.cardTalents) do
        if k >= level then
            num = num + v
        end
    end
    return num
end

