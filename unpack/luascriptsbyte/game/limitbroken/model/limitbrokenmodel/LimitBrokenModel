function LimitBrokenModel:CheckRedPoint(param)
    if param == -1 then
        for gid, group in pairs(self.taskList) do
            if self:CheckGroupHasPreFinish(gid) then
                return true
            end
        end
    else
        if self:CheckGroupHasPreFinish(param) then
            return true
        end
    end
    return false
end

function LimitBrokenModel:RefreshRedPoint(param)
    if param then
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.LimitBroken.id, param)
    else
        require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.LimitBroken.id)
    end
end

function LimitBrokenModel.CheckMainViewBtn()
    return require("LimitBrokenModel"):GetInstance():CheckMainViewBtnInner()
end

function LimitBrokenModel:CheckMainViewBtnInner()
    for _, group in pairs(self.taskList) do
        for _, data in pairs(group) do
            if data:GetState() ~= self.FinishType.Finish then
                return true
            end
        end
    end
    return false
end

---销毁对象时,析构函数
function LimitBrokenModel:Dispose()
    self.taskList = nil
    _G.Events:GetInstance():RemoveListener(_G.ChatViewEvents.ChatViewLevel, self.UpdateAllTask, self)
    _G.Events:GetInstance():RemoveListener(_G.ChatViewEvents.ChatViewTianFv, self.UpdateCardTalent, self)
    _G.Events:GetInstance():RemoveListener(_G.ChatViewEvents.ChatViewHunLian, self.UpdateCardSoulLink, self)
    _G.Events:GetInstance():RemoveListener(_G.ArtifactShow.ArtifactLevel, self.UpdateArtifactLevel, self)
    _G.Events:GetInstance():RemoveListener(_G.ArtifactShow.ArtifactStar, self.UpdateArtifactStar, self)
    _G.Events:GetInstance():RemoveListener(_G.ArtifactShow.ArtifactAwaken, self.UpdateArtifactAwaken, self)
end

return LimitBrokenModel
