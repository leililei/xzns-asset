---@class LimitBrokenTaskData	中文描述
---@field cfg hell_guard_cfg
local LimitBrokenTaskData = _G.BaseClass("LimitBrokenTaskData")

---创建对象时,入口构造函数
---@param taskId number
---@param groupId number
function LimitBrokenTaskData:__init(taskId, groupId)
    self.id = taskId
    self.groupId = groupId
    local FinishType = require("LimitBrokenModel").FinishType
    self.state = FinishType.InProgress
    self.cfg = _G.ConfigManager.mission_extra_cfg[taskId]
    self.conditionType = self.cfg.condition[1][1]
end


function LimitBrokenTaskData:ChangeState(state)
    self.state = state
end

function LimitBrokenTaskData:GetState()
    return self.state
end

function LimitBrokenTaskData:GetReward()
    return self.cfg.reward
end

function LimitBrokenTaskData:CheckTarget()
    local LimitBrokenModel = require("LimitBrokenModel")
    local con = self.cfg.condition
    if self.conditionType == _G.ActiveTaskEnum.ConditionEnum.CardLevel.assignCountAssignStar then
        return _G.StorageManager:GetInstance():CheckCardStarCount(con[1][2], con[1][3]) >= con[1][3]
    elseif self.conditionType == _G.ActiveTaskEnum.ConditionEnum.Artifact.LevelNum then
        return LimitBrokenModel:GetInstance():CheckArtifactLevelCount(con[1][2], con[1][3])
    elseif self.conditionType == _G.ActiveTaskEnum.ConditionEnum.Artifact.StarNum then
        return LimitBrokenModel:GetInstance():CheckArtifactStarCount(con[1][2], con[1][3])
    elseif self.conditionType == _G.ActiveTaskEnum.ConditionEnum.Artifact.AwakenNum then
        return LimitBrokenModel:GetInstance():CheckArtifactAwakenCount(con[1][2])
    elseif self.conditionType == _G.ActiveTaskEnum.ConditionEnum.Artifact.SidLevel then
        return LimitBrokenModel:GetInstance():CheckAppointArtifactLevel(con[1][2], con[1][3])
    elseif self.conditionType == _G.ActiveTaskEnum.ConditionEnum.Artifact.SidStar then
        return LimitBrokenModel:GetInstance():CheckAppointArtifactStar(con[1][2], con[1][3])
    elseif self.conditionType == _G.ActiveTaskEnum.ConditionEnum.Artifact.SidAwaken then
        return LimitBrokenModel:GetInstance():CheckAppointArtifactAwaken(con[1][2])
    elseif self.conditionType == _G.ActiveTaskEnum.ConditionEnum.CardTalent.LevelNum then
        return LimitBrokenModel:GetInstance():CheckCardTalentCount(con[1][2], con[1][3])
    elseif self.conditionType == _G.ActiveTaskEnum.ConditionEnum.CardSoulLink.LevelNum then
        return LimitBrokenModel:GetInstance():CheckCardSoulLinkCount(con[1][2], con[1][3])
    end
    return false
end

function LimitBrokenTaskData:CheckTaskState()
    local FinishType = require("LimitBrokenModel").FinishType
    if self.state == FinishType.InProgress then
        if self:CheckTarget() then
            self.state = FinishType.PreFinish
            return self.id
        end
    end
end

---类的析构函数
function LimitBrokenTaskData:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.ePlayAactionEvent.PlayAaction, self.OnAactionEnent, self)
end


return LimitBrokenTaskData
