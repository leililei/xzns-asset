local base = require("BaseGameNet")

---@class LimitBrokenNet : BaseGameNet	通信协议
local LimitBrokenNet = _G.BaseClass("LimitBrokenNet", base)
---@return LimitBrokenNet LimitBrokenNet
function LimitBrokenNet:GetInstance()
    return base.GetInstance(self)
end

---获取信息
function LimitBrokenNet:GetInfo(pbData, callback)
    local item = _G.ConfigManager.net_map.game_limit_broken_info
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---完成任务/领奖
function LimitBrokenNet:Finish(pbData, callback)
    local item = _G.ConfigManager.net_map.game_limit_broken_finish
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function LimitBrokenNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return LimitBrokenNet
