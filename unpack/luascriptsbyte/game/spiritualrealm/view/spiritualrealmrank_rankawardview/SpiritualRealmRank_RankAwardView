local SpiritualRealmModel = require("SpiritualRealmModel")

local JoinType

---@field CanGet number 可领取
---@field Have number 已领取
---@field Going number 进行中
---@class GetAwardState 日报类型
local GetAwardState = {
    CanGet = 0,
    Have = 2,
    Going = 1,
}

--段位item
local SpiritualRealmRank_RankAwardItem = _G.BaseClass("SpiritualRealmRank_RankAwardItem")

function SpiritualRealmRank_RankAwardItem:__init(obj, getCall)
    self.gameObject = obj
    self.getAwardCallback = getCall
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.itemList = {}
end

function SpiritualRealmRank_RankAwardItem:Dispose()
    local ItemFactory = _G.ItemFactory
    for i = 1, #self.itemList do
        ItemFactory:GetInstance():SetItemCard(self.itemList[i])
    end
    self.itemList = nil
    self.curRankID = nil
    self.gameObject = nil
    self.getAwardCallback = nil
    self.go_table = nil
end

---按钮点击事件在这里派发
function SpiritualRealmRank_RankAwardItem:OnClickBtn(go)
    if go == self.go_table.aorbtn_get then
        local numbers = {}
        for k, v in pairs(_G.ConfigManager.arena_layer_league_cfg) do
            if SpiritualRealmModel:GetInstance():GetStageAwardState(k) == GetAwardState.CanGet then
                table.insert(numbers, k)
            end
        end
        SpiritualRealmModel:GetInstance():GetStageAward(numbers, _G.handler(self, self.OnAwardGetCall))
    end
end

function SpiritualRealmRank_RankAwardItem:OnAwardGetCall(msg)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
    self:ShowAward(self.curAward, self.curRankID)
    self:ShowAwardState()
    if self.getAwardCallback then
        self.getAwardCallback()
    end
end

---@param cfg arena_layer_league_cfg
function SpiritualRealmRank_RankAwardItem:Show(cfg, index)
    self.gameObject:SetActiveE(1)
    self.curRankID = cfg.id

    self.curAward = cfg["reward_season" .. JoinType]
    self.go_table.aortext_name.text = _G.GetLangPackValue(cfg.describe[2])
    self.go_table.aortext_desc.text = cfg.min_score .. "-" .. cfg.max_score
    self.go_table.aortext_rankName.text = _G.GetLangPackValue(cfg.art)
    if cfg.icon then
        self.go_table.aorrawimage_icon:LoadImage(
            cfg.icon,
            function()
                self.go_table.aorrawimage_icon:SetNativeSize()
            end
        )
    end
    self:ShowAward(self.curAward, self.curRankID)
    self:ShowAwardState()
end

---显示奖励
function SpiritualRealmRank_RankAwardItem:ShowAward(award, index)
    local ItemFactory = _G.ItemFactory
    for i = 1, #self.itemList do
        ItemFactory:GetInstance():SetItemCard(self.itemList[i])
    end
    self.itemList = {}
    local insert = _G.table.insert
    local state = SpiritualRealmModel:GetInstance():GetStageAwardState(self.curRankID)
    self.index = index
    self.go_table.trans_itemRoot:ClearChildren()
    for i = 1, #award do
        ItemFactory:GetInstance():GetItemCard(
            ItemFactory.itemType.ItemBaseWithCount,
            self.go_table.trans_itemRoot,
            function(item)
                if _G.IsNil(self) or index ~= self.index then
                    _G.DestroyObject(item.gameObject)
                    return
                end
                item:Show(award[i][1], nil, award[i][2])
                insert(self.itemList, item)
                if item.gameObject:GetChildCountE() > 1 then
                    _G.DestroyObject(item.gameObject:GetChildE(item.gameObject:GetChildCountE() - 1))
                end
                item:SetGou(state == 2)
                item.go_table.aorimage_Color:ClearChildren()
                if state == 0 then
                    _G.UIUtils.LoadEffectByCfg(
                        _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
                        item.go_table.aorimage_Color,
                        function(eff)
                            if not self.go_table then
                                _G.UIUtils.RemoveEffect(eff)
                                return
                            end
                            eff:SetLocalScaleXYZ(1.2)
                            item.eff = eff
                        end
                    )
                end
            end
        )
    end
end

---显示领取状态
function SpiritualRealmRank_RankAwardItem:ShowAwardState()
    local state = SpiritualRealmModel:GetInstance():GetStageAwardState(self.curRankID)
    for k, v in pairs(self.itemList) do
        v:SetGou(state == 2 and true or false)
        if v.eff then
            v.eff:SetActiveE(state == 0 and 1 or 0)
        end
    end
    self.go_table.aorbtn_get:SetActiveE(state == 0 and 1 or 0)

    --self.go_table.obj_alreadyGet:SetActiveE(state == 2 and 1 or 0)
end

--endregion

---@class SpiritualRealmRank_RankAwardView : UIBaseView	中文描述
---@field public go_table SpiritualRealmRank_RankAwardView_GoTable GoTable
local SpiritualRealmRank_RankAwardView = _G.BaseClass("SpiritualRealmRank_RankAwardView", _G.Component)

function SpiritualRealmRank_RankAwardView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self.itemTransDic = {}
end

function SpiritualRealmRank_RankAwardView:UpdateView()
    JoinType = SpiritualRealmModel:GetInstance():GetJoinType()
    self.go_table.scrollloopvectical_award:InitItemData(0, _G.handler(self, self.RefreshItem))
    self.cfgs = {}
    for id, value in pairs(_G.ConfigManager.arena_layer_league_cfg) do
        _G.table.insert(self.cfgs, value)
    end
    self:SortItem(true)
    local index = self:GetJumpToIndex()
    self.go_table.scrollloopvectical_award:ScrollToIndex(index - 1)
end

function SpiritualRealmRank_RankAwardView:OnDestroy()
    for _, item in pairs(self.itemTransDic) do
        item:Dispose()
    end
    self.itemTransDic = nil
end

function SpiritualRealmRank_RankAwardView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    index = index + 1
    local instanceID = obj:GetInstanceIDE()
    local item = self.itemTransDic[instanceID]

    if not item then
        item = SpiritualRealmRank_RankAwardItem.New(obj, _G.handler(self, function()
            for k, v in pairs(self.itemTransDic) do
                v:ShowAwardState()
            end
        end))
        self.itemTransDic[instanceID] = item
    end
    item:Show(self.cfgs[index], index)
end

function SpiritualRealmRank_RankAwardView:SortItem(init)
    _G.table.sort(
        self.cfgs,
        function(a, b)
            return a.max_score < b.max_score
        end
    )
    if init then
        self.go_table.scrollloopvectical_award:UpdateCount(#self.cfgs)
    else
        self.go_table.scrollloopvectical_award:UpdateAllItem()
    end
end

---获取列表滑动位置，首个可领取 > 当前段位
function SpiritualRealmRank_RankAwardView:GetJumpToIndex()
    local curId = SpiritualRealmModel:GetInstance():GetCurGradeCfg()
    local index = 1
    for i, v in pairs(self.cfgs) do
        if SpiritualRealmModel:GetInstance():GetStageAwardState(v.id) == 0 then
            return i
        end
        if curId == v.id then
            index = i
        end
    end
    return index
end

return SpiritualRealmRank_RankAwardView
