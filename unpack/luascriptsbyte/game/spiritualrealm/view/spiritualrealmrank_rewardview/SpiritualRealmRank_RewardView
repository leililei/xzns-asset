local SpiritualRealmModel = require("SpiritualRealmModel")
local SpiritualRealmNet = require("SpiritualRealmNet")

local descStr = _G.GetLangPackValue(90022100112)
local descStr2 = _G.GetLangPackValue(90022100121)
local descStr3 = _G.GetLangPackValue(90022100122)
--region 奖励item
local SpiritualRealmRank_RewardItem = _G.BaseClass("SpiritualRealmRank_RewardItem")

local rankBgName = {
    "tz_qjhs_di_02",
    "tz_qjhs_di_03",
    "tz_qjhs_di_04",
    "ui_jjc_pic_jinjijl"
}
local rankIconName = {
    "ui_icon_diyi",
    "ui_icon_dier",
    "ui_icon_disan"
}

local function AddEffectAward(cfg)
    local awards = {}
    local type, sid
    for _, a in pairs(cfg.reward_daily) do
        _G.table.insert(awards, a)
    end
    if not _G.table.isEmptyOrNil(cfg.reward_appearance) then
        for _, eff in pairs(cfg.reward_appearance) do
            type = eff[1]
            sid = _G.tostring(eff[2])
            for k, item in pairs(_G.ConfigManager.item_cfg) do
                if item.UseType == type and item.UseParameter[1][1] == sid then
                    _G.table.insert(awards, {item.ID, 1})
                    break
                end
            end
        end
    end
    return awards
end

function SpiritualRealmRank_RewardItem:__init(obj)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj)
    self.itemList = {}
end
function SpiritualRealmRank_RewardItem:Dispose()
    self.go_table = nil
    self.gameObject = nil
    local ItemFactoryIns = _G.ItemFactory:GetInstance()
    for i = 1, #self.itemList do
        ItemFactoryIns:SetItemCard(self.itemList[i])
    end
    self.itemList = nil
end
---显示
---@param id number 奖励id
---@param index number 排名序列号
---@return 变量类型 中文描述
function SpiritualRealmRank_RewardItem:Show(id, index)
    self.gameObject:SetActiveE(1)
    self:ShowDay(id, index)
end
function SpiritualRealmRank_RewardItem:ShowDay(id, index)
    local cfg = _G.ConfigManager.arena_rank_cfg[id]
    local str = ""
    self.go_table.obj_Line:SetActiveE(1)
    if cfg.min_rank == cfg.max_rank then
        str = cfg.min_rank
    else
        if cfg.max_rank >= 9999 then
            str = cfg.min_rank .. "+"
            self.go_table.obj_Line:SetActiveE(0)
        else
            str = cfg.min_rank .. "-" .. cfg.max_rank
        end
    end
    self.go_table.aortext_PaiMing.text = str
    if index <= 3 then
        self.go_table.aorimage_RankIcon.SpriteName = rankIconName[index]
        self.go_table.aorimage_RankIcon:SetNativeSize()
        self.go_table.aortext_RankNum.text = index
        --self.go_table.aorimage_rankbg.SpriteName = rankBgName[index]
        self.go_table.obj_rank:SetActiveE(1)
    else
        --self.go_table.aorimage_rankbg.SpriteName = rankBgName[4]
        self.go_table.obj_rank:SetActiveE(0)
    end
    local award = AddEffectAward(cfg)
    self:ShowAward(award)
end
function SpiritualRealmRank_RewardItem:ShowSeason(id)
    local cfg = _G.ConfigManager.arena_league_cfg[id]
    self.go_table.aorrawimage_duanwei:LoadImage(cfg.icon)
    self.go_table.aortext_level.text = _G.LangUtil.GetLangPackValue(cfg.name)
    if not _G.table.isEmptyOrNil(cfg.reward_season) then
        self:ShowAward(cfg.reward_season)
    end
end
---显示奖励
function SpiritualRealmRank_RewardItem:ShowAward(award)
    local ItemFactory = _G.ItemFactory
    for i = 1, #self.itemList do
        ItemFactory:GetInstance():SetItemCard(self.itemList[i])
    end
    self.itemList = {}
    local insert = _G.table.insert
    for i = 1, #award do
        local root = self.go_table["obj_Item" .. i]
        root:SetActiveE(1)
        ItemFactory:GetInstance():GetItemCard(
            ItemFactory.itemType.ItemBaseWithCount,
            root,
            function(item)
                item:Show(award[i][1], nil, award[i][2])
                insert(self.itemList, item)
            end
        )
    end
    for i = #award + 1, 3 do
        self.go_table["obj_Item" .. i]:SetActiveE(0)
    end
end
--endregion

---@class SpiritualRealmRank_RankView : Component	中文描述
---@field go_table SpiritualRealmRankView._obj_award_GoTable
local SpiritualRealmRank_RewardView = _G.BaseClass("SpiritualRealmRank_RewardView", _G.Component)

function SpiritualRealmRank_RewardView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self.itemList = {}
    self.itemTransDic = {}
    self.awardList = {}
end

---界面的入口函数
function SpiritualRealmRank_RewardView:OnCreate(parent)
    self.parent = parent
    -- self:Show()
end

function SpiritualRealmRank_RewardView:UpdateView()
    self.joinType = SpiritualRealmModel:GetInstance():GetJoinType()
    self:ShowList()
    --local selfType = {83, 84, 85}
    --SpiritualRealmNet:GetInstance():SelfRank(selfType[self.joinType], _G.handler(self, self.ShowMyRank))
end

function SpiritualRealmRank_RewardView:Close()
    local ItemFactory = _G.ItemFactory
    for i = 1, #self.itemList do
        ItemFactory:GetInstance():SetItemCard(self.itemList[i])
    end
    for _, item in pairs(self.itemTransDic) do
        item:Dispose()
    end
    self.itemTransDic = nil
    _G.UIBaseView.Close(self)
end

function SpiritualRealmRank_RewardView:ShowList()
    self.awardList = _G.DeepCopyCfgTable(_G.ConfigManager.arena_layer_up_cfg[self.joinType].rank_season)
    self.go_table.scrollloopvectical_award:InitItemData(#self.awardList, _G.handler(self, self.RefreshItem))
end

function SpiritualRealmRank_RewardView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    local instanceID = obj:GetInstanceIDE()
    if not self.itemTransDic[instanceID] then
        self.itemTransDic[instanceID] = SpiritualRealmRank_RewardItem.New(obj)
    end
    index = index + 1
    self.itemTransDic[instanceID]:Show(self.awardList[index], index)
end

function SpiritualRealmRank_RewardView:ShowMyRank(msg)
    local award = {}
    --我的排名
    local rank = msg.index or 0
    self.go_table.aortext_mNumber.text = rank == 0 and _G.GetLangPackValue(90022900040) or rank
    self.go_table.aortext_mScoreRank.text = _G.GetLangPackValue(90026500029)
    local arena_rank_cfg = _G.ConfigManager.arena_rank_cfg
    for i = 1, #self.awardList do
        local value = arena_rank_cfg[self.awardList[i]]
        if value.min_rank <= rank and value.max_rank >= rank then
            award = AddEffectAward(value)
            if value.min_rank == value.max_rank then
                self.go_table.aortext_mScoreRank.text = string.format(descStr, value.min_rank)
            else
                if value.max_rank >= 9999 then
                    self.go_table.aortext_mScoreRank.text = string.format(descStr3, value.min_rank)
                else
                    self.go_table.aortext_mScoreRank.text = string.format(descStr2, value.min_rank, value.max_rank)
                end
            end
            break
        end
    end
    local ItemFactory = _G.ItemFactory
    self.itemList = {}
    for i = 1, #award do
        ItemFactory:GetInstance():GetItemCard(
            ItemFactory.itemType.ItemBaseWithCount,
            self.go_table.trans_mItemRoot,
            function(item)
                item:Show(award[i][1], nil, award[i][2])
                _G.table.insert(self.itemList, item)
            end
        )
    end
end

function SpiritualRealmRank_RewardView:EscClose()
end

return SpiritualRealmRank_RewardView
