local CommonTipManager = require("CommonTipManager")
local SettlementBaseView = require "SettlementBaseView"
---@class SpiritualRealmFailPanelView : UIBaseView	中文描述
---@field public go_table SpiritualRealmFailPanelView_GoTable GoTable
local SpiritualRealmFailPanelView = _G.BaseClass("SpiritualRealmFailPanelView", SettlementBaseView)

---界面的入口函数
function SpiritualRealmFailPanelView:OnCreateChild(results, report, scores, mvpData)
    local roleName = report.target_role_name
    if report.target_type == 1 then
        roleName = _G.GetLangPackValue(roleName)
    end
    self.otherInfo = {
        style = report.target_style,
        frame = report.frame,
        name = roleName,
        sid = report.target_uid
    }
    self.re_uid = {report.uid}
    self.reportType = 10
    self.mvpData = mvpData
    self.hideCombBtn = false
    local roleName = report.target_role_name
    if report.target_type == 1 then
        roleName = _G.GetLangPackValue(roleName)
    end
    self:ShowData(scores, roleName)
    self:OpenEmbattleView()
    --self.award = data.data
end

function SpiritualRealmFailPanelView:OpenEmbattleView()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    local result = {}
    result.iSWin = false
    result.statistics = true
    result.btnDisplay = true
    result.otherInfo = self.otherInfo
    result.re_uid = self.re_uid
    result.reportType = self.reportType
    result.hideCombBtn = self.hideCombBtn
    result.hidePlayerInfo = true
    self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, self.callback, result)
    require("PowerToTheTopModel"):GetInstance():Top_Rank()
end

function SpiritualRealmFailPanelView:ShowData(data, enemyName)
    local PlayerModelIns = _G.PlayerModel:GetInstance()
    self.go_table.aortext_mName.text = PlayerModelIns:GetName()
    self.go_table.aortext_eName.text = enemyName
    self.go_table.aortext_mScore.text = data[1]
    self.go_table.aortext_mScoreAdd.text = string.format("-%d", data[1] - data[2])
    self.go_table.aortext_eScore.text = data[3]
    self.go_table.aortext_eScoreAdd.text = string.format("+%d", data[4] - data[3])

    self.go_table.aortext_box:SetActiveE(0)
    local style = PlayerModelIns:GetRoleStyle()
    local frame = PlayerModelIns:GetCurFrame()
    UIUtils.SetPlayerHeadItemNew(self.go_table.obj_mHeadItemBase, { style = style, frame = frame }, 1, true, false, false,
        function() end)
    style = self.otherInfo.style
    frame = self.otherInfo.frame
    UIUtils.SetPlayerHeadItemNew(self.go_table.obj_eHeadItemBase, { style = style, frame = frame }, 1, true, false, false,
        function() end)
    --self.otherInfo.garray = self:SetEnemyInfo(data.enemy.garray)
    self.go_table.aorimage_JingDu:SetActiveE(0)
end

---监听界面
---@param name string 界面名称
function SpiritualRealmFailPanelView:OnUIOpened(name)
    if name == _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
        local view = _G.UIManager:GetInstance():GetWindowCtrl(name)
        _G.UIManager:GetInstance():ChangeCanvasOrder(
            name,
            self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 1
        )
        view.transform:SetParentE(self.go_table.trans_view)
        view:SetTipsHide(true)
        view:SetFightBtnLabel(_G.GetLangPackValue(90030700075))
        self.go_table.obj_info:SetActiveE(1)
        --CommonTipManager:GetInstance().OpenCommonAwardView(self.award)
    end
end

---打开结算界面
---@param name string 结算界面名称
---@param result table 结算参数
function SpiritualRealmFailPanelView:OnShowView(name, OnSettlementEndCall, result)
    _G.UIManager:GetInstance():OpenWindow(name, OnSettlementEndCall, result, nil, nil, nil, nil, self.mvpData)
end

---监听界面
---@param name string 界面名称
function SpiritualRealmFailPanelView:OnUIClosed(name)
    if name == _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
        self:Close()
    end
end

function SpiritualRealmFailPanelView:EscClose()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name)
    if view then
        view:CloseCall(_G.SettlementModel.FunctionEnum.None)
    end
end

return SpiritualRealmFailPanelView
