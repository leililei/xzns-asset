local SpiritualRealmTaskModel = require("SpiritualRealmTaskModel")

---@class SpiritualRealmTaskView : UIBaseView    中文描述
---@field public go_table SpiritualRealmTaskView_GoTable GoTable
local SpiritualRealmTaskView = _G.BaseClass("SpiritualRealmTaskView", _G.UIBaseView)

local GetLangPackValue = _G.GetLangPackValue

function SpiritualRealmTaskView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    ---界面切换，1为每日任务，2为赛季任务
    self.index = 1
    self.task = {}
    self.go_table.scrollloopvectical_taskList:InitItemData(0, _G.handler(self, self.RefreshList))
    self:ItemNew()
end

---界面的入口函数
function SpiritualRealmTaskView:OnCreate()
end
---界面刷新逻辑
function SpiritualRealmTaskView:ItemNew()
    self.go_table.obj_NoFriend:SetActiveE(0)
    if self.index == 1 then
        self.task = SpiritualRealmTaskModel:GetInstance():DayID() or {}
    elseif self.index == 2 then
        self.task = SpiritualRealmTaskModel:GetInstance():TaskID() or {}
    end
    if #self.task <= 0 then
        self.go_table.obj_NoFriend:SetActiveE(0)
        --self.go_table.obj_Toggles:SetActiveE(0)
        if self.index == 1 then
            self.index = 2
            self.task = SpiritualRealmTaskModel:GetInstance():TaskID() or {}
        else
            self.index = 1

            self.task = SpiritualRealmTaskModel:GetInstance():DayID() or {}
        end
    end
    --- 按任务已完成奖励可领取>任务未完成>任务奖励已领取>配置表id（从小到大）的顺序进行排列
    table.sort(
        self.task,
        function(a, b)
            --- 不同任务状态优先级
            local function sortState(state)
                if state == _G.TaskEnum.ETaskState.Submited then
                    return 10
                elseif state == _G.TaskEnum.ETaskState.Claimed then
                    return 9
                elseif state == _G.TaskEnum.ETaskState.Completed then
                    return 8
                end
                return 0
            end

            local aState = sortState(a.i_task.state)
            local bState = sortState(b.i_task.state)
            if aState ~= bState then
                return aState > bState
            end
            return a.i_task.sid < b.i_task.sid
        end
    )
    local count = #self.task
    self.go_table.scrollloopvectical_taskList:UpdateCount(count)
    --self:YiJian()
end

function SpiritualRealmTaskView:YiJian()
    local num = SpiritualRealmTaskModel:GetInstance().taskPrefinish
    if #num > 1 then
        self.go_table.aorbtn_getAll:SetActiveE(1)
    else
        self.go_table.aorbtn_getAll:SetActiveE(0)
    end
end

function SpiritualRealmTaskView:RefreshList(index, listView2)
    if index < 0 then
        return
    end
    index = index + 1
    local gotable = _G.GetAutoGoTable(listView2, _G.handlerbind(self, self.IsZhi, index))

    local data = self.task[index]
    local is = data:CheckIsGet()

    gotable.aortext_name.text = GetLangPackValue(data.Cfg.desc)
    --local v1, v2 = data:GetCount()

    local MaxNum = data.i_task.target[1] / data.Cfg.count
    --gotable.slider_progress.value = MaxNum
    if MaxNum >= 1 then
        gotable.aortext_Slider.text = "(" .. data.Cfg.count .. "/" .. data.Cfg.count .. ")"
    else
        gotable.aortext_Slider.text = "(" .. data.i_task.target[1] .. "/" .. data.Cfg.count .. ")"
    end
    gotable.obj_AwardItem:ClearChildren()
    for key, value in pairs(data.Cfg.reward) do
        local obj = _G.InstantiateObject(self.go_table.obj_award, gotable.obj_AwardItem)
        local gotables = _G.GetAutoGoTable(obj)

        if is then
            gotables.obj_gou:SetActiveE(1)
        else
            gotables.obj_gou:SetActiveE(0)
        end
        self:RefreshAwardItem(value, gotables)
    end
    gotable.aorbtn_get:SetActiveE(0)
    -- gotable.aortext_label:SetActiveE(0)
    gotable.aortext_unGet:SetActiveE(0)
    gotable.aorimage_unGet:SetActiveE(0)
    gotable.aorimage_complete:SetActiveE(0)
    gotable.aorimage_get:SetActiveE(0)

    if is then
        gotable.aorimage_complete:SetActiveE(1)
    else
        if MaxNum >= 1 then
            -- gotable.aortext_label:SetActiveE(1)
            gotable.aorimage_get:SetActiveE(1)

            gotable.aorbtn_get:SetActiveE(1)
        else
            gotable.aortext_unGet:SetActiveE(1)
            gotable.aorimage_unGet:SetActiveE(1)
            gotable.aorimage_unGet:SetGray(true)
        end
    end
    return gotable
end
function SpiritualRealmTaskView:RefreshAwardItem(index, tb)
    --index = index
    --local tb = _G.GetAutoGoTable(obj)
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        index,
        tb.obj_Root,
        function(item)
            item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
            local rect = item.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
            rect:SetRectTransformSize(100, 100)
        end
    )
    tb.gameObject:SetActiveE(1)
end
---点击按钮响应
function SpiritualRealmTaskView:IsZhi(go, _, index)
    local name = go:GetName()

    if name == "@_aorbtn_get" then
        local data = {}
        for i, v in ipairs(self.task) do
            local is = v:CheckIsGet()
            if is == false then
                local MaxNum = v.i_task.target[1] / v.Cfg.count
                if MaxNum >= 1 then
                    _G.table.insert(data, v.id)
                end
            end
        end
        SpiritualRealmTaskModel:GetInstance():ChessAward(data, _G.handlerbind(self, self.ItemNew))
    end
end

