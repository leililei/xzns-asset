local SpiritualRealmMainView = _G.BaseClass("SpiritualRealmMainView", _G.UIBaseView)

function SpiritualRealmMainView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:RefreshView()
end

function SpiritualRealmMainView:OnCreate()
end

function SpiritualRealmMainView:RefreshView()

end

function SpiritualRealmMainView:OnClickBtn(go, isOn, viewName)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:CloseView()
    elseif name == "@_aorbtn_help" then
    end
end

function SpiritualRealmMainView:StopAllTimer()
    if self.applyEndTimer then
        self.applyEndTimer:Stop()
        self.applyEndTimer = nil
    end
end

function SpiritualRealmMainView:EscClose()
    self:CloseView()
end

function SpiritualRealmMainView:CloseView()
    self:StopAllTimer()
    self:Close()
end

function SpiritualRealmMainView:OnDestroy()
    self:CloseView()
end

return SpiritualRealmMainView
