---显示队伍卡牌
---@param team  fight.i_fight_team[] 队伍数据
function SpiritualRealmSettlementView:ShowTeamCard(team, obj, index)
    ---@type _obj_item._obj_my_GoTable
    local item = _G.GetAutoGoTable(obj)
    if not item.cardList then
        item.cardList = {}
    end
    if self.curType == 1 then
        --全都只有一个队伍
        local datas = team[1]
        item.aortext_array.text = _G.GetLangPackValue(90021800275, index + 1)
        item.aortext_array:SetActiveE(1)
        local count = datas.fights and #datas.fights or 0
        if count < #item.cardList then
            count = #item.cardList
        end
        local realIndex = 0
        if item.obj_CardContent:GetChildCountE() == 0 then
            for i = 1, count do
                if datas.fights and datas.fights[i] then
                    realIndex = realIndex + 1
                end
                self:SetCardShow(item.cardList, realIndex, datas.fights and datas.fights[i] or nil, item.obj_CardContent)
            end
        end
        item.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(datas.power)
    elseif self.curType == 2 then
        local datas = team
        item.aortext_array:SetActiveE(0)
        local count = 0
        if datas ~= nil then
            count = #datas
        end
        local power = 0
        for i = 1, count do
            self:SetCardShowAdjust(item.cardList, i, datas[i] and datas[i].sid > 0 and datas[i] or nil, item.obj_CardContent)
            if datas[i] and datas[i].power then
                power = power + datas[i].power
            end
        end
        if datas.power then
            power = datas.power
        end
        item.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(power)
    end
end

