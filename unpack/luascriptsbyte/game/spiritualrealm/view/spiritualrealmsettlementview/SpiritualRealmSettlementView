                    local ani = obj:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
                    ani:Play("a_SpiritualRealmSettlementView_open")
                end
            )
        end
        self:ShowTeamCard(self.myEmbattleDatas[index + 1], item.obj_my, index)
        self:ShowTeamCard(self.enemyEmbattleDatas[index + 1], item.obj_enemy, index)
