local SpiritualRealmNet = require("SpiritualRealmNet")
local SpiritualRealmModel = require("SpiritualRealmModel")

---@class SpiritualRealmRank_RankView : Component	中文描述
---@field go_table SpiritualRealmRankView._obj_Rank_GoTable
local SpiritualRealmRank_RankView = _G.BaseClass("SpiritualRealmRank_RankView", _G.Component)

local UIUtils = _G.UIUtils
local GetAutoGoTable = _G.GetAutoGoTable
local GetLangPackValue = _G.GetLangPackValue

local languageIds = {
    ---未上榜,
    UnRank = 90022900040,
}
function SpiritualRealmRank_RankView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---更新界面
function SpiritualRealmRank_RankView:UpdateView()
    local joinType = SpiritualRealmModel:GetInstance():GetJoinType()
    if joinType == 1 then
        SpiritualRealmNet:GetInstance():GetFirstRankList(1, _G.handler(self, self.OnGetRankCall))
        SpiritualRealmNet:GetInstance():SelfRank(83, _G.handler(self, self.InitPlayer))
    elseif joinType == 2 then
        SpiritualRealmNet:GetInstance():GetTwoRankList(1, _G.handler(self, self.OnGetRankCall))
        SpiritualRealmNet:GetInstance():SelfRank(84, _G.handler(self, self.InitPlayer))
    elseif joinType == 3 then
        SpiritualRealmNet:GetInstance():GetThirdRankList(1, _G.handler(self, self.OnGetRankCall))
        SpiritualRealmNet:GetInstance():SelfRank(85, _G.handler(self, self.InitPlayer))
    end
end

function SpiritualRealmRank_RankView:OnGetRankCall(msg)
    self.rankList = msg.ranks or {}
    self.go_table.obj_no:SetActiveE(#self.rankList <= 0 and 1 or 0)
    -- self.gameObject:SetActiveE(1)
    self.go_table.scrollloopvectical_rankList:InitItemData(
        #self.rankList,
        _G.handler(self, self.RefreshRankItem)
    )
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_no, #self.rankList <= 0)
end

---刷新排行榜
function SpiritualRealmRank_RankView:RefreshRankItem(index, obj)
    ---@type _obj_Rank._obj_rankItem_GoTable
    local tb = GetAutoGoTable(obj)
    index = index + 1
    tb.aorimage_rankBg:SetActiveE(index <= 3 and 1 or 0)
    tb.obj_rankBg2:SetActiveE(index <= 3 and 0 or 1)
    if index <= 3 then
        tb.aorimage_rankBg.SpriteName = "tz_qjhs_di_0" .. (index + 1)
        tb.aorimage_rank.SpriteName = "tz_qjhs_phb_mingci_0" .. index
    else
        tb.aortext_rankNum.text = index
    end
    local data = self.rankList[index]
    tb.aortext_name.text = data.role_info.name
    -- local severInfo = _G.ServerManager:GetInstance():GetServerBySid(data.role_info.server_id)
    tb.aortext_server.text = data.role_info.guild_name or ""
    tb.aortext_score.text = data.score
    local cfg = SpiritualRealmModel:GetInstance():GetGradeCfg(data.score)
    tb.aorrawimage_icon:LoadImage(cfg.icon)
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data.role_info, 1, true, true, false)
end

function SpiritualRealmRank_RankView:InitPlayer(msg)
    if msg.ack ~= 1 then
        return
    end
    ---@type _obj_Rank._obj_rankItem_GoTable
    local tb = GetAutoGoTable(self.go_table.obj_player)
    local index = msg.index or 0
    if index == 0 then
        tb.aortext_rankNum.text = GetLangPackValue(languageIds.UnRank)
    else
        tb.aortext_rankNum.text = index
    end
    local data = _G.PlayerModel:GetInstance():GetIRroleTable()
    tb.aortext_name.text = data.name
    -- local serverId = _G.ServerManager:GetInstance():GetServerSid()
    -- local severInfo = _G.ServerManager:GetInstance():GetServerBySid(serverId)
    tb.aortext_server.text = require("SociatyManager"):GetInstance():GetGuildName()
    local score = msg.value or SpiritualRealmModel:GetInstance():GetScore()
    tb.aortext_score.text = score
    local cfg = SpiritualRealmModel:GetInstance():GetGradeCfg(score)
    tb.aorrawimage_icon:LoadImage(cfg.icon)
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data, 1, true, true, false)
end

---销毁对象时,析构函数
function SpiritualRealmRank_RankView:OnDestroy()
end

function SpiritualRealmRank_RankView:OnClickBtn(go)
end

return SpiritualRealmRank_RankView
