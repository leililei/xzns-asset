function SpiritualRealmMatchView:CloseView()
    if self.refreshTimer ~= nil then
        self.refreshTimer:Stop()
        self.refreshTimer = nil
    end
    if self.showHeadTimer ~= nil then
        self.showHeadTimer:Stop()
        self.showHeadTimer = nil
    end
    if self.ShowPlayerTimer ~= nil then
        self.ShowPlayerTimer:Stop()
        self.ShowPlayerTimer = nil
    end
    if self.timer ~= nil then
        self.timer:Stop()
        self.timer = nil
    end
    self:Close()
end

