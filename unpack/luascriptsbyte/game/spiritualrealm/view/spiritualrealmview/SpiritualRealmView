function SpiritualRealmView:OnCreate()
    local resources = _G.ConfigManager.ui_cfg.SpiritualRealmView.resources
    if #resources > 0 then
        self.goldInfo = self:AddComponent(
            self.go_table.obj_GoldInfo,
            require("ResourceCompont").New(self.go_table.obj_GoldInfo, resources)
        )
    end
    self.goldInfo.AllRc[101][203030101]["_onclick"] = _G.handler(self, self.BuyTicket)
    self.playerHead = self:AddComponent(self.go_table.obj_playerInfo,
        require("PlayerComponent").New(self.go_table.obj_playerInfo))
    _G.Events:GetInstance():AddListener(_G.SpiritualRealmEvents.GradeChange, self.OnGradeChange, self)
    _G.Events:GetInstance():AddListener(_G.SpiritualRealmEvents.ScoreChange, self.OnScoreChange, self)
    _G.Events:GetInstance():AddListener(_G.SpiritualRealmEvents.Refresh, self.OnRefresh, self)
    _G.Events:GetInstance():AddListener(_G.SpiritualRealmEvents.FightTimeChange, self.OnFightTimeChange, self)
    self.rankItemDic = {}
    self:InitView()
    --刷新界面红点
    _G.PlayerPrefsManager.SetInt(
        tostring(_G.PlayerModel:GetInstance().role_uid) .. "SpiritualRealm",
        _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
    )
    RedPointManager:GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.ArenaLayer.id)
    self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.ArenaLayerFreeTime.id)
end

function SpiritualRealmView:InitView()
    self:RefreshView()
end

