function SpiritualRealmView:InitSignUpContentView()
    ---获取预览数据(神器/灵契满星满级显示)
    ---@param sid number
    ---@param num number
    local function getPreviewData(sid, num)
        ---@type number
        local lv, star
        local storageType = _G.StorageManager:GetInstance():CheckSidType(sid)
        if storageType == _G.StorageType.Spiritual then
            star = _G.ConfigManager.spiritual_cfg[sid].Star
            local cfg = _G.ConfigManager.spiritual_star_cfg[100 + star]
            lv = cfg and cfg.level_limit or 1
        elseif storageType == _G.StorageType.Artifact then
            star = _G.ConfigManager.artifact_cfg[sid].Star
            local cfg = _G.ConfigManager.artifact_star_cfg[100 + star]
            lv = cfg and cfg.level_limit or 1
        end
        return { sid, num, star = star, lv = lv }
    end

    self.go_table.aorbtn_task:SetActiveE(0)
    self.go_table.aorbtn_embattle:SetActiveE(0)
    self.go_table.aorbtn_report:SetActiveE(0)
    self.go_table.aorbtn_rank:SetActiveE(0)
    self.itemTable = {}
    for i = 1, 4 do
        local goTable = _G.GetAutoGoTable(self.go_table["obj_item" .. i], _G.handlerbind(self, self.OnClick_item, i))
        self.itemTable[i] = goTable
        local arena_layer_up_cfg = _G.ConfigManager.arena_layer_up_cfg[i]
        for m = 1, #arena_layer_up_cfg.condition do
            goTable["obj_condition" .. m]:SetActiveE(1)
        end
        for i = 1, #arena_layer_up_cfg.Preview do
            local sid, num = table.unpack(arena_layer_up_cfg.Preview[i])
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                getPreviewData(sid, num),
                goTable.trans_awardContent,
                function(item)
                    item.gameObject:SetLocalScale(0.7, 0.7, 0.7)
                end,
                function(go, isOn)
                    ---需要填充中间的参数(nil), 目标参数为showMaxLevel = true
                    require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, sid, nil, nil, true)
                end
            )
        end
        local number = arena_layer_up_cfg.number or 1
        goTable.aortext_teamNum.text = _G.GetLangPackValue(90031700126, _G.GameUtil.NumberToChinese(number))
    end
end

