---初始化排行榜自身数据
function SpiritualRealmView:InitSelfRank(msg)
    if self:IsNil() then
        return
    end
    if msg.ack ~= 1 then
        return
    end
    self.selfData = {
        score = msg.value,
        role_info = _G.PlayerModel:GetInstance():GetIRroleTable()
    }
    if self.rankList then
        self:InsertSelfToList(self.rankList, self.selfData)
        self.go_table.scrollloopvectical_rank:UpdateCount(#self.rankList)
    end
    local tb = _G.GetAutoGoTable(self.go_table.obj_player)
    tb.obj_Content:SetActiveE(1)
    local index = msg.index or 0
    if self.selfRank then
        index = self.selfRank
    end
    if index == 0 then
        tb.obj_noRank:SetActiveE(1)
        tb.aorimage_rank:SetActiveE(0)
        tb.aortext_rank:SetActiveE(0)
    elseif index <= 3 then
        tb.obj_noRank:SetActiveE(0)
        tb.aorimage_rank:SetActiveE(1)
        tb.aortext_rank:SetActiveE(0)
        tb.aorimage_rank.SpriteName = iconDic[index]
        tb.aortext_RankNum.text = index
        SpiritualRealmRankItem:SetGradient(tb.aortext_RankNum, index)
    else
        tb.obj_noRank:SetActiveE(0)
        tb.aorimage_rank:SetActiveE(0)
        tb.aortext_rank:SetActiveE(1)
        tb.aortext_rank.text = index
    end
    local data = _G.PlayerModel:GetInstance():GetIRroleTable()
    tb.aortext_name.text = data.name
    tb.aortext_sociatyName.text = require("SociatyManager"):GetInstance():GetGuildName()
    local score = msg.value or SpiritualRealmModel:GetInstance():GetScore()
    tb.aortext_score.text = score
    local cfg = SpiritualRealmModel:GetInstance():GetGradeCfg(score)
    tb.aortext_rankName.text = _G.GetLangPackValue(cfg.art)
    tb.aorrawimage_rankIcon:LoadImage(cfg.icon, function()
        tb.aorrawimage_rankIcon:SetNativeSize()
    end)
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data, 1.3, true, false, false) --称号不在头像上显示
    if data.title ~= nil then
        local titleCfg = _G.ConfigManager.player_title_effect_cfg[data.title.sid]
        if titleCfg ~= nil then
            tb.obj_title:SetActiveE(1)
            tb.aorrawimage_title:LoadImage(titleCfg.icon)
        else
            tb.obj_title:SetActiveE(0)
        end
    else
        tb.obj_title:SetActiveE(0)
    end
    if tb.obj_Award:GetChildCountE() == 0 then
        local rankList = _G.ConfigManager.arena_layer_up_cfg[SpiritualRealmModel:GetInstance():GetJoinType()]
            .rank_season
        local award
        for _, v in pairs(rankList) do
            local rankCfg = _G.ConfigManager.arena_rank_cfg[v]
            if index >= rankCfg.min_rank and index <= rankCfg.max_rank then
                award = rankCfg.reward_daily
                break
            end
        end
        if not award then
            return
        end
        for _, v in pairs(award) do
            ---@param item BaseAwardNewItem
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                { v[1], v[2] },
                tb.obj_Award,
                function(item)
                    if self:IsNil() then
                        _G.DestroyObject(item.gameObject)
                        return
                    end
                    item.go_table.obj_ItemNum:SetActiveE(1)
                end
            )
        end
    end
    _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(tb.trans_middleContent)
end

---初始化排位信息
function SpiritualRealmView:RefreshRankInfo(list)
    if self:IsNil() then
        return
    end
    self.rankList = list
    self:InsertSelfToList(self.rankList, self.selfData)
    if #self.rankList < 3 then
        for i = #self.rankList + 1, 3 do
            self.rankList[i] = {
                rank = i,
                nullFlag = true
            }
        end
    end
    if not self.initRank then
        self.go_table.scrollloopvectical_rank:InitItemData(0, _G.handler(self, self.UpdateRankItem))
    else
        self.go_table.scrollloopvectical_rank:UpdateCount(#list)
    end
    self.initRank = true
end

---将自己的数据插入排行榜中
---@param list any[]
---@param selfData any
function SpiritualRealmView:InsertSelfToList(list, selfData)
    if not list or not selfData then
        return
    end
    local count = #list
    if count < 3 then
        count = 3
    end

    local selfUid = selfData.role_info.uid
    local selfScore = selfData.score
    --从排行榜中移除自己的数据
    for i = 1, count do
        if list[i] and list[i].role_info and selfUid == list[i].role_info.uid then
            table.remove(list, i)
            break
        end
    end
    --将当前数据插入排行榜
    local rank = -1
    for i = 1, count do
        if not list[i] or not list[i].role_info or selfScore > list[i].score then
            rank = i
            table.insert(list, i, selfData)
            self.selfRank = i
            break
        end
    end
    for i = #list, 1, -1 do
        --如果移除第4位及以后的nullFlag(补位节点)
        if i > 3 and list[i] and list[i].nullFlag then
            table.remove(list, i)
        end
    end

    --之后的玩家重新进行排名
    if rank > 0 then
        for i = 1, #list do
            list[i].rank = i
        end
    end
end

---排行榜列表刷新回调
---@param index number 循环列表回调序列号0开始
---@param obj UnityEngine.GameObject 循环使用的对象
function SpiritualRealmView:UpdateRankItem(index, obj)
    local insID = obj:GetInstanceIDE()
    local item = self.rankItemDic[insID]
    if not item then
        item = SpiritualRealmRankItem.New(obj, self.go_table)
        self.rankItemDic[insID] = item
    end
    index = index + 1
    item:Show(self.rankList[index])
end

function SpiritualRealmView:StartTimer()
    self.seasonEndTime = SpiritualRealmModel:GetInstance():GetStopTime()
    self.seasonTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimer, self, false, false, true)
    self.seasonTimer:Start()
end

function SpiritualRealmView:UpdateTimer()
    local time = self.seasonEndTime - _G.TimeUtil.GetServerUnixTime()
    if time <= 0 then
        time = 0
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.EmbattleView.Name)
        if view ~= nil then
            require("EmbattleController"):GetInstance():CloseEmbattle()
        end
        self:CloseView()
        return
    end
    self.go_table.aortext_seasonTime.text = _G.GetLangPackValue(90030700024, _G.TimeUtil.TransLateSMCH(time))
end

