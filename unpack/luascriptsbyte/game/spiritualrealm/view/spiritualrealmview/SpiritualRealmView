function SpiritualRealmView:OnClickBtn(go, isOn, viewName)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:CloseView()
    elseif name == "@_aorbtn_embattle" then
        if _G.MainManager:GetInstance():IsFighting(true) then
            return
        end
        SpiritualRealmModel:GetInstance():OpenEmbattleDefence()
    elseif name == "@_aorbtn_battle" then
        if SpiritualRealmModel:GetInstance():GetAllRestFightTimes() > 0 then
            if _G.MainManager:GetInstance():IsFighting(true) then
                return
            end
            SpiritualRealmModel:GetInstance():Match(_G.handler(self, self.OnBattleClick))
        else
            self:BuyTicket()
        end
    elseif name == "@_aorbtn_rank" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpiritualRealmRankView.Name)
        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonRankView.Name, _G.CommonRankType.SpiritualRealm)
    elseif name == "@_aorbtn_report" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpiritualRealmReportView.Name)
    elseif name == "@_aorbtn_shop" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ShopView.Name, 9)
    elseif name == "@_aorbtn_task" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpiritualRealmTaskView.Name)
    elseif name == "@_aorbtn_help" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 116)
    elseif name == "@_aorbtn_buy" then
        ---时间不够，随便处理，有兴趣的话自己去改跳转代码或者在获取途径里面添加传入回调机制
        SpiritualRealmModel:GetInstance():BuyTicket()
    elseif name == "@_toggle_skip" then
        --存储跳过战斗配置
        _G.PlayerPrefsManager.SetInt("SpiritualRealmSkipBattle", self.go_table.toggle_skip.isOn and 1 or 0)
    end
end

---@param arena_layer_enemy_array arena_layer.s2c_arena_layer_enemy_array
---@param arena_layer_match arena_layer.s2c_arena_layer_match
function SpiritualRealmView:OnBattleClick(arena_layer_enemy_array, arena_layer_match)
    local enter, index = SpiritualRealmModel:GetInstance():CheckEnterMatch()
    if enter then
        --local skipBattle =
        --    self.go_table.obj_skipBg:GetActiveSelf() == 1 and self.go_table.toggle_skip:GetActiveSelf() == 1 and
        --    self.go_table.toggle_skip.isOn
        --指定次数后开启跳过战斗
        local needCfg = _G.ConfigManager.discrete_cfg[113006]
        local needCount = needCfg and needCfg[1][1] or -1
        local count = SpiritualRealmModel:GetInstance():GetFightTimes() or 0
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.SpiritualRealmMatchView.Name,
            arena_layer_enemy_array,
            arena_layer_match,
            count >= needCount
        )
    else
        SpiritualRealmModel:GetInstance():OpenEmbattleDefence(index)
    end
end

