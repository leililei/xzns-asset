---显示
---@param data table 排行榜单个数据
function SpiritualRealmRankItem:Show(data)
    self.data = data
    local topItem = data.rank <= 3 and _G.GetAutoGoTable(self.goTable["obj_rank" .. data.rank]) or nil
    if data.nullFlag then
        self.go_table.aorimage_rank:SetActiveE(1)
        self.go_table.aorimage_rank.SpriteName = iconDic[data.rank]
        topItem.aortext_name.text = _G.GetLangPackValue(90000010159)
        topItem.obj_Score:SetActiveE(0)
        topItem.aorrawimage_Empty:SetActiveE(1)
        self.go_table.aortext_RankNum.text = data.rank
        self:SetGradient(self.go_table.aortext_RankNum, data.rank)
        self.go_table.obj_Content:SetActiveE(0)
        self.go_table.obj_Nobody:SetActiveE(1)
    else
        if topItem then
            topItem.aorrawimage_Empty:SetActiveE(0)
            topItem.obj_Score:SetActiveE(1)
        end
        self.go_table.obj_Content:SetActiveE(1)
        self.go_table.obj_Nobody:SetActiveE(0)
        local arena_layer_league_cfg = SpiritualRealmModel:GetInstance():GetGradeCfg(data.score)
        self.go_table.aortext_rankName.text = _G.GetLangPackValue(arena_layer_league_cfg.art)
        self.go_table.aorrawimage_rankIcon:LoadImage(arena_layer_league_cfg.icon, function()
            self.go_table.aorrawimage_rankIcon:SetNativeSize()
        end)
        --self.go_table.aortext_rankname.text = _G.GetLangPackValue(arena_layer_league_cfg.name)
        _G.UIUtils.SetPlayerHeadItemNew(
            self.go_table.obj_HeadItemBase,
            data.role_info,
            1.3,
            true,
            nil,
            nil,
            nil
        )
        if data.rank <= 3 and data.rank ~= 0 then
            self.go_table.aorimage_rank:SetActiveE(1)
            self.go_table.aortext_rank:SetActiveE(0)
            self.go_table.aorimage_rank.SpriteName = iconDic[data.rank]
            self.go_table.aortext_RankNum.text = data.rank
            self:SetGradient(self.go_table.aortext_RankNum, data.rank)
            self:SetPlayerRole(data)
        else
            self.go_table.aorimage_rank:SetActiveE(0)
            self.go_table.aortext_rank:SetActiveE(1)
            self.go_table.aortext_rank.text = data.rank
        end
        self.go_table.aortext_name.text = data.role_info.name
        self.go_table.aortext_score.text = data.score
        --if not _G.string.IsNullOrEmpty(data.role_info.guild_name) then
        --    self.go_table.aortext_sociatyName:SetActiveE(1)
        --    self.go_table.aortext_sociatyName.text = data.role_info.guild_name
        --else
        --    self.go_table.aortext_sociatyName:SetActiveE(0)
        --end
        if data.role_info.title ~= nil then
            local titleCfg = _G.ConfigManager.player_title_effect_cfg[data.role_info.title.sid]
            if titleCfg ~= nil then
                self.go_table.obj_title:SetActiveE(1)
                self.go_table.aorrawimage_title:LoadImage(titleCfg.icon)
            else
                self.go_table.obj_title:SetActiveE(0)
            end
        else
            self.go_table.obj_title:SetActiveE(0)
        end
        if self.loadingNum == 0 then
            self.go_table.obj_Award:RemoveAllChildren()
            local rankList = _G.ConfigManager.arena_layer_up_cfg[SpiritualRealmModel:GetInstance():GetJoinType()]
                .rank_season
            local award
            for _, v in pairs(rankList) do
                local rankCfg = _G.ConfigManager.arena_rank_cfg[v]
                if data.rank >= rankCfg.min_rank and data.rank <= rankCfg.max_rank then
                    award = rankCfg.reward_daily
                    break
                end
            end
            if not award then
                return
            end
            for _, v in pairs(award) do
                self.loadingNum = self.loadingNum + 1
                ---@param item BaseAwardNewItem
                _G.StorageManager:GetInstance():GetItemBaseViewNew(
                    { v[1], v[2] },
                    self.go_table.obj_Award,
                    function(item)
                        if _G.IsNil(self) then
                            _G.DestroyObject(item.gameObject)
                            return
                        end
                        self.loadingNum = self.loadingNum - 1
                        item.go_table.obj_ItemNum:SetActiveE(1)
                    end
                )
            end
        end
        _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(self.go_table.trans_middleContent)
    end
end

function SpiritualRealmRankItem:SetGradient(obj, index)
    local Gradient = {
        [1] = { "ffcb28", "ffffff" },
        [2] = { "e930ff", "ffffff" },
        [3] = { "1f7296", "ffffff" }
    }
    local gradient = obj:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient))
    -- local gradient = go
    local c1 = _G.ColorTools.FormatColorByString(Gradient[index][1])
    local c2 = _G.ColorTools.FormatColorByString(Gradient[index][2])
    local color1 = _G.CS.UnityEngine.GradientColorKey()
    local color2 = _G.CS.UnityEngine.GradientColorKey()
    color1.color = c1
    color1.time = 1
    color2.color = c2
    color2.time = 0

    local alpha1 = _G.CS.UnityEngine.GradientAlphaKey()
    local alpha2 = _G.CS.UnityEngine.GradientAlphaKey()

    alpha1.alpha = 255
    alpha1.time = 1
    alpha2.alpha = 255
    alpha2.time = 0

    gradient:GetGradient():SetKeys({ color1, color2 }, { alpha1, alpha2 })
end

function SpiritualRealmRankItem:SetPlayerRole(data)
    local tb = _G.GetAutoGoTable(self.goTable["obj_rank" .. data.rank])
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.SpiritualRealmRankItem .. data.rank, tb)
    tb.aortext_Score.text = data.score
    tb.aortext_name.text = data.role_info.name
    require("SystemSettingNet"):GetInstance():GetPlayerInfo(
        { uid = data.role_info.uid },
        function(msg)
            if not msg.info then
                return
            end
            local cfg = require "CardCommentManager":GetInstance():CardData(msg.info.city_style_id, false)
            local scale = cfg.size2
            local pos = cfg.pos_portrait
            tb.trans_role:RemoveAllChildren()
            local path = _G.UIUtils.GetBattleSpine(cfg, _G.UseBattleSpine.RankView)
            if _G.UIUtils.IsUseBattleSpine(_G.UseBattleSpine.RankView) then
                scale = cfg.size4
                pos = { 0, 0, 0 }
            end
            _G.PoolsManager:GetInstance():Spawn(
                path,
                _G.ePoolType.Temporary,
                nil,
                function(trans)
                    if trans == nil then
                        if _G.AppSetting.DEBUG then
                            _G.LogError("角色无法加载 path:" .. cfg.ModelPathHi .. "    CardInfoView LoadRoleScene")
                        end
                        return
                    end
                    if _G.IsNil(self) then
                        _G.DestroyObject(trans)
                        return
                    end
                    trans:SetParentE(tb.trans_role)
                    trans:SetLocalPosition(pos[1], pos[2], pos[3])
                    trans:SetLocalScaleXYZ(scale * 0.9) --按配置乘上固定缩小倍数
                    local rolePoint = trans:GetComponentE(_G.typeof(_G.CS.RolePoint))
                    if rolePoint == nil then
                        rolePoint = trans:AddComponentE(_G.typeof(_G.CS.RolePoint))
                    end
                    --- 只有星座女神有神环
                    if _G.AppSetting.IsXzns then
                        local godHaloID = msg.info.god_halo
                        if godHaloID ~= 0 then
                            local effCfg = _G.ConfigManager.god_halo_cfg[godHaloID].ui_effect_cfg
                            --- 神环路径，父级路径(加载角色的下面)
                            _G.UIUtils.LoadGodHalo(effCfg, trans, godHaloID)
                        end
                        if not table.isEmptyOrNil(msg.info.artifact_skin) then
                            _G.UIUtils.LoadArtifacteffect(trans,nil,msg.info.artifact_skin[1],msg.info.artifact_skin[2])
                        end
                    end
                end
            )
            self:UpdateTop3Title(tb, msg.info.title, data.rank)
        end
    )
end

---生成称号
---@param item table
function SpiritualRealmRankItem:UpdateTop3Title(tb, data, index)
    if data.sid == 0 then
        return
    end
    if self.curShowEffTitle == nil then
        self.curShowEffTitle = {}
    end
    local titleScale = _G.ConfigManager.discrete_cfg[100111] and _G.ConfigManager.discrete_cfg[100111][1][1] or 1
    local player_title = _G.ConfigManager.player_title_effect_cfg[data.sid]
    if player_title.type_title == 1 then
        tb.aorrawimage_title:LoadImage(player_title.title)
        tb.aorrawimage_title:SetActiveE(1)
        tb.aorrawimage_title:SetLocalScaleXYZ(0.29 * titleScale)
        tb.obj_titleEffect:RemoveAllChildren()
        self.curShowEffTitle[index] = nil
    elseif player_title.type_title == 2 then
        if self.curShowEffTitle[index] == nil or (self.curShowEffTitle[index] ~= nil and self.curShowEffTitle[index] ~= player_title.title) then
            tb.obj_titleEffect:RemoveAllChildren()
            self.curShowEffTitle[index] = player_title.title
            _G.UIUtils.LoadEffectTitleOrFrame(
                player_title.title,
                tb.obj_titleEffect,
                function(trans)
                    if self.curShowEffTitle[index] ~= player_title.title then
                        trans:DestroyObject()
                        return
                    end
                    local parClip = trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                    parClip.NeedCheck = true
                    parClip.CheckCount = 10
                    parClip.CheckOne = 3
                    trans:SetLocalScaleXYZ(titleScale)
                end
            )
        end
        tb.aorrawimage_title:SetActiveE(0)
    end
end

function SpiritualRealmRankItem:OnClick(go)
    if go == self.go_table.aorbtn_click then
        if self.data.type ~= 1 then
            if self.data.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.PopWindowManager:GetInstance():ShowAllTips(620109)
            else
                _G.SystemSettingManager:GetInstance():OpenView(self.data.uid)
            end
        else
            _G.SystemSettingManager:GetInstance():OpenRobotPlayInfo(self.data.uid, nil, _G.RobotType.ArenaSenior)
        end
    end
end

