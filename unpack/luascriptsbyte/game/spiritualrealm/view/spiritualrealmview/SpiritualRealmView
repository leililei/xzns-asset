function SpiritualRealmView:RefreshView()
    self:StopAllTimer()
    self:StartTimer()
    self:UpdateTimer()

    self.go_table.aorbtn_task:SetActiveE(1)
    self.go_table.aorbtn_embattle:SetActiveE(1)
    self.go_table.aorbtn_report:SetActiveE(1)
    self.go_table.aorbtn_rank:SetActiveE(1)
    local joinType = SpiritualRealmModel:GetInstance():GetJoinType()
    if joinType ~= 0 then
        if not self.isInitMatch then
            self:InitMatchContentView()
            self.isInitMatch = true
        end
        self.go_table.obj_matchContent:SetActiveE(1)
        self.go_table.obj_signUpContent:SetActiveE(0)
        self:RefreshMatchContent()
        --self:RefreshSkipBattleState()
        local condition = _G.ConfigManager.discrete_cfg[137001]
        if joinType > 2 and _G.GlobalConditionManager.CheckConditionByArray(condition) then
            self.go_table.aortext_onekeytips:SetActiveE(1)
            self.go_table.toggle_onekeybattle:SetActiveE(1)
            local onekeyison = _G.PlayerPrefsManager.GetInt("SpiritualRealmDoOneKeyBattle", 0)
            if onekeyison == 1 then
                self.go_table.toggle_onekeybattle.isOn = true
                self.go_table.aorbtn_onekeybattle:SetActiveE(1)
                self.go_table.aorbtn_battle:SetActiveE(0)
            else
                self.go_table.aorbtn_onekeybattle:SetActiveE(0)
                self.go_table.aorbtn_battle:SetActiveE(1)
            end
        else
            self.go_table.aorbtn_onekeybattle:SetActiveE(0)
            self.go_table.aorbtn_battle:SetActiveE(1)

            self.go_table.aortext_onekeytips:SetActiveE(0)
            self.go_table.toggle_onekeybattle:SetActiveE(0)
        end
    else
        if not self.isInitSignUp then
            self:InitSignUpContentView()
            self.isInitSignUp = true
        end
        self.go_table.obj_matchContent:SetActiveE(0)
        self.go_table.obj_signUpContent:SetActiveE(1)
        self:RefreshSignUpContent()
    end
end

---刷新跳过战斗状态
function SpiritualRealmView:RefreshSkipBattleState()
    local model = SpiritualRealmModel:GetInstance()
    --跳过战斗显示状态
    local cfg = _G.ConfigManager.arena_layer_up_cfg[model:GetJoinType()]
    self.go_table.obj_skipBg:SetActiveE(cfg and cfg.number == 1 and 1 or 0)

    if cfg and cfg.number == 1 then
        --指定次数后开启跳过战斗
        local needCfg = _G.ConfigManager.discrete_cfg[113006]
        local needCount = needCfg and needCfg[1][1] or -1
        if needCount < 0 then
            self.go_table.obj_skipBg:SetActiveE(0)
            return
        end
        local count = model:GetFightTimes() or 0
        if count < needCount then
            self.go_table.aortext_skipTip.text = _G.GetLangPackValue(90030700079, needCount - count)
        else
            --读取跳过战斗配置
            self.go_table.toggle_skip.isOn = _G.PlayerPrefsManager.GetInt("SpiritualRealmSkipBattle", 1) == 1
        end
        self.go_table.toggle_skip:SetActiveE(count >= needCount and 1 or 0)
        self.go_table.aortext_skipTip:SetActiveE(count < needCount and 1 or 0)

        --不再展示外层跳过战斗
        if count >= needCount then
            self.go_table.obj_skipBg:SetActiveE(0)
        end
    end
end

function SpiritualRealmView:RefreshSignUpContent()
    self.maxCanJoinType = 0
    for i = 1, #self.itemTable do
        local goTable = self.itemTable[i]
        local arena_layer_up_cfg = _G.ConfigManager.arena_layer_up_cfg[i]
        local isReach = true
        for m = 1, #arena_layer_up_cfg.condition do
            local flag, count, maxCount = SpiritualRealmModel:GetInstance():CheckCondition(arena_layer_up_cfg.condition
                [m])
            if count > maxCount then
                count = maxCount
            end
            local strCount = _G.string.format("(%s/%s)", count, maxCount)
            goTable["aortext_condition" .. m].text = _G.GetLangPackValue(arena_layer_up_cfg.describe[m]) .. strCount
            if flag then
                goTable["obj_gou" .. m]:SetActiveE(1)
            else
                goTable["obj_gou" .. m]:SetActiveE(0)
                isReach = false
            end
            _G.GameUtil.ReBuildRTF(goTable["obj_condition" .. m])
        end
        if isReach then
            goTable.obj_notReach:SetActiveE(0)
            goTable.aorbtn_signUp:SetActiveE(1)
            goTable.aorrawimage_bg:SetGray(false)
            ---此处i对应了joinType，所以可以直接用i赋值，不用额外写严谨的函数s
            if i > self.maxCanJoinType then
                self.maxCanJoinType = i
            end
        else
            goTable.obj_notReach:SetActiveE(1)
            goTable.aorbtn_signUp:SetActiveE(0)
            goTable.aorrawimage_bg:SetGray(true)
        end
    end
end

function SpiritualRealmView:RefreshScore()
    local score = SpiritualRealmModel:GetInstance():GetScore()
    local arena_layer_league_cfg = SpiritualRealmModel:GetInstance():GetGradeCfg(score)
    if arena_layer_league_cfg.max_score == 99999 then
        self.go_table.aortext_score.text = _G.GetLangPackValue(90030700012, score)
    else
        self.go_table.aortext_score.text = _G.GetLangPackValue(90030700012,
            score .. "/" .. arena_layer_league_cfg.max_score)
    end
end

function SpiritualRealmView:RefreshMatchContent()
    local joinType = SpiritualRealmModel:GetInstance():GetJoinType()
    local cfg = _G.ConfigManager.arena_layer_up_cfg[joinType]
    local seasonName = _G.GetLangPackValue(cfg.name)
    local seasonNum = _G.GetLangPackValue(90029400052, SpiritualRealmModel:GetInstance():GetSeasonId())
    self.go_table.aortext_seasonName.text = seasonName .. ":" .. seasonNum
    self:RefreshScore()
    local score = SpiritualRealmModel:GetInstance():GetScore()
    local arena_layer_league_cfg = SpiritualRealmModel:GetInstance():GetGradeCfg(score)
    --self.go_table.aorrawimage_rank:LoadImage(arena_layer_league_cfg.icon)
    local node = self.go_table.obj_curAwardContent
    if node:GetChildCountE() > 0 then
        for i = 1, node:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(node:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    local rewards = {}
    if joinType == 1 then
        rewards = arena_layer_league_cfg.reward_season1
    elseif joinType == 2 then
        rewards = arena_layer_league_cfg.reward_season2
    elseif joinType == 3 then
        rewards = arena_layer_league_cfg.reward_season3
    elseif joinType == 4 then
        rewards = arena_layer_league_cfg.reward_season4
    end
    for i = 1, #rewards do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            rewards[i],
            node,
            function(item)
                item.gameObject:SetLocalScale(0.8, 0.8, 0.8)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end,
            function(go, isOn)
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, rewards[i][1])
            end
        )
    end
    self:ShowChallengeCount()
    self.go_table.aortext_curRank.text = _G.GetLangPackValue(arena_layer_league_cfg.name)
    local next_league_cfg = SpiritualRealmModel:GetInstance():GetGradeCfg(arena_layer_league_cfg.max_score + 1)
    if next_league_cfg == nil then
        --self.go_table.obj_nextRankContent:SetActiveE(0)
        --self.go_table.obj_maxRank:SetActiveE(1)
    else
