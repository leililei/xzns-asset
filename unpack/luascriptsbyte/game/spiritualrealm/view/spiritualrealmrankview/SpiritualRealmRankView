local RankView = require "SpiritualRealmRank_RankView"
local RewardView = require "SpiritualRealmRank_RewardView"
local RankAwardView = require "SpiritualRealmRank_RankAwardView"

---@class SpiritualRealmRankView : UIBaseView    中文描述
---@field public go_table SpiritualRealmRankView_GoTable GoTable
---@field curModel number 当前模式(1排位赛2友谊赛)
local SpiritualRealmRankView = _G.BaseClass("SpiritualRealmRankView", _G.UIBaseView)

local GetAutoGoTable = _G.GetAutoGoTable

function SpiritualRealmRankView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function SpiritualRealmRankView:OnCreate()
    self:OnRankAward(true)
end

---点击排行
function SpiritualRealmRankView:OnRank(isOn)
    self.go_table.obj_Rank:SetActiveE(isOn and 1 or 0)
    self:ChangeToggle(self.go_table.toggle_rank, isOn)
    if not isOn then
        return
    end
    if not self.RankView then
        self.RankView = self:AddComponent(self.go_table.obj_Rank, RankView.New())
        self.RankView:UpdateView()
    end
end

---点击排行奖励
function SpiritualRealmRankView:OnReward(isOn)
    self.go_table.obj_SeasonAward:SetActiveE(isOn and 1 or 0)
    self.go_table.obj_RankAward:SetActiveE(not isOn and 1 or 0)
    self:ChangeToggle(self.go_table.aorbtn_Season, isOn)
    self:ChangeToggle(self.go_table.aorbtn_Rank, not isOn)
    if not isOn then
        return
    end
    if not self.RewardView then
        self.RewardView = self:AddComponent(self.go_table.obj_SeasonAward, RewardView.New())
        self.RewardView:UpdateView()
    end
end

---点击段位奖励
function SpiritualRealmRankView:OnRankAward(isOn)
    self.go_table.obj_RankAward:SetActiveE(isOn and 1 or 0)
    self.go_table.obj_SeasonAward:SetActiveE(not isOn and 1 or 0)
    self:ChangeToggle(self.go_table.aorbtn_Rank, isOn)
    self:ChangeToggle(self.go_table.aorbtn_Season, not isOn)
    if not isOn then
        return
    end
    if not self.RankAward then
        self.RankAward = self:AddComponent(self.go_table.obj_RankAward, RankAwardView.New())
        self.RankAward:UpdateView()
    end
end

function SpiritualRealmRankView:ChangeToggle(toggle, isOn)
    local tb = GetAutoGoTable(toggle)
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
end

---按钮点击事件在这里派发
function SpiritualRealmRankView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.toggle_rank then
        self:OnRank(isOn)
    elseif go == self.go_table.aorbtn_Season then
        self:OnReward(isOn)
    elseif go == self.go_table.aorbtn_Rank then
        self:OnRankAward(isOn)
    end
end

return SpiritualRealmRankView
