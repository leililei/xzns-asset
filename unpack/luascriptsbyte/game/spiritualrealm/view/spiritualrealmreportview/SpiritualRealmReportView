--region 普通竞技场
local resultArrow = {
    win = "0ui_icon_shangsheng",
    lose = "0ui_icon_xiajiang"
}
local scoreStr = { win = "+%d", lose = "-%d", zero = "%d" }
function SpiritualRealmReportItem:OnShow(data)
    self.reportType = 10
    self.winnertable = data.winner
    local format = _G.string.format
    if self.winner then
        local lanId = 90022100040
        if data.strType ~= nil then
            if data.strType == 1 then
                lanId = 90033400152
            end
        end
        self.go_table.aortext_score.text = format(
            _G.LangUtil.GetLangPackValue(lanId),
            data.score == 0 and format(scoreStr.zero, data.score) or format(scoreStr.win, data.score)
        )
    else
        local lanId = 90022100090
        if data.strType ~= nil then
            if data.strType == 1 then
                lanId = 90033400153
            end
        end
        self.go_table.aortext_score.text = format(
            _G.LangUtil.GetLangPackValue(lanId),
            data.score == 0 and format(scoreStr.zero, data.score) or format(scoreStr.lose, data.score)
        )
    end
    self.go_table.aorimage_arrow.SpriteName = self.winner and resultArrow.win or resultArrow.lose
end

