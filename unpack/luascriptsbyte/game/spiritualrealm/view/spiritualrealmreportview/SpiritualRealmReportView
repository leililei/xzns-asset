---@class SpiritualRealmReportView : UIBaseView    中文描述
---@field public go_table SpiritualRealmReportPanelView_GoTable GoTable
local SpiritualRealmReportView = _G.BaseClass("SpiritualRealmReportView", _G.UIBaseView)

function SpiritualRealmReportView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
end

---界面的入口函数
function SpiritualRealmReportView:OnCreate(sid)
    self.itemTransDic = {}
    self.go_table.scrollloopvectical_report:InitItemData(0, _G.handler(self, self.RefreshItem))
    SpiritualRealmNet:GetInstance():GetReport(_G.handler(self, self.ShowReport))
end

function SpiritualRealmReportView:OnDestroy()
    if self.itemTransDic then
        for _, value in pairs(self.itemTransDic) do
            value:Dispose()
        end
    end
end

---按钮点击事件在这里派发
function SpiritualRealmReportView:OnClickBtn(go)
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
    self:Close()
end

---@param list arena_peak.s2c_arena_peak_report
function SpiritualRealmReportView:ShowReport(data)
    if data.ack == 1 then
        self.reportList = data.reports or {}
    else
        self.reportList = {}
    end
    local count = #self.reportList or 0
    self.go_table.obj_emptybg:SetActiveE(count == 0 and 1 or 0)
    self.go_table.scrollloopvectical_report:UpdateCount(count)
end

function SpiritualRealmReportView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    local instanceID = obj:GetInstanceIDE()
    if not self.itemTransDic[instanceID] then
        self.itemTransDic[instanceID] = SpiritualRealmReportItem.New(obj)
    end

    index = index + 1
    self.reportList[index].countMax = #self.reportList
    self.itemTransDic[instanceID]:Show(self.reportList[index])
end

return SpiritualRealmReportView
