local SpiritualRealmNet = require "SpiritualRealmNet"
--region战报item
--region 基类
local SpiritualRealmReportItem = _G.BaseClass("SpiritualRealmReportItem")
local resultTag = {
    win = "0ui_img_shengliqi",
    lose = "0ui_img_shibai",
    attackwin = "ui_jjc_font_tzchenggong",
    attacklose = "ui_jjc_font_tzshibai",
    defencewin = "ui_jjc_font_fschenggong",
    defencelose = "ui_jjc_font_fsshibai"
}
local UIUtils = _G.UIUtils
function SpiritualRealmReportItem:__init(obj)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnReplayBtnCall))
end

function SpiritualRealmReportItem:Dispose()
    self.gameObject = nil
    self.playback_uid = nil
    self.go_table = nil
end

local SetOtherPlayer = function(data)
    local otherPlayer = {}
    otherPlayer.frame = data.frame
    otherPlayer.name = data.target_type == 2 and data.target_role_name or _G.GetLangPackValue(data.target_role_name)
    otherPlayer.lv = data.target_level
    otherPlayer.style = data.target_style
    -- otherPlayer.title = data.title
    return otherPlayer
end
function SpiritualRealmReportItem:Show(data)
    self.data = data
    self.otherPlayer = SetOtherPlayer(data)
    self:GetResult(data.winner)
    self.reportID = data.uid
    self.playback_uid = data.playback_uid
    self.isAttack = data.report_type == 0
    self:ShowResult(data)
    self.needChangeTag = data.report_type ~= 0
    UIUtils.SetPlayerHeadItemNew(self.go_table.obj_HeadItemBase, self.otherPlayer, 1, true, true, true)
    self.go_table.aortext_name.text = data.target_type == 2 and data.target_role_name or
        _G.GetLangPackValue(data.target_role_name)
    self.go_table.aortext_power.text = _G.GameUtil.NumberToUnitWord(data.target_power)
    self.go_table.aortext_time.text = self:TranslateTime(data.time)
    self.go_table.aorbtn_report:SetActiveE(self.playback_uid == nil and 0 or 1)
    --战歌争锋要显示场次
    if self.go_table.aortext_num then
        self.go_table.aortext_num.text = _G.GetLangPackValue(90033400141, data.countMax - data.index + 1)
    end
    self:OnShow(data)
end

---@param winner table 战报结果数组
function SpiritualRealmReportItem:GetResult(winner)
    if winner == nil or #winner == 0 then
        if _G.AppSetting.DEBUG then
            _G.LogError("ArenaReportItem:winner 非有效数组")
        end
        return
    end
    local win_num = 0
    for i = 1, #winner do
        win_num = win_num + winner[i]
    end
    self.winner = win_num < (#winner / 2)
end

function SpiritualRealmReportItem:TranslateTime(time)
    local servertime = _G.TimeUtil.GetServerUnixTime()
    time = _G.TimeUtil.TranslateSecond(servertime - time)
    if time.day > 0 then
        time.day = time.day > 30 and 30 or time.day
        return _G.string.format(_G.LangUtil.GetLangPackValue(90022100085), time.day)
    end
    if time.hour > 0 then
        if time.min > 0 then
            return _G.string.format(_G.LangUtil.GetLangPackValue(90022100084), time.hour, time.min)
        else
            return _G.string.format(_G.LangUtil.GetLangPackValue(90022100086), time.hour)
        end
    end
    time.min = time.min > 0 and time.min or 1
    return _G.string.format(_G.LangUtil.GetLangPackValue(90022100083), time.min)
end

function SpiritualRealmReportItem:ShowResult()
    self.go_table.aorimage_resultbg.SpriteName = self.winner and resultTag.win or resultTag.lose
    --self.go_table.aorimage_resultTag.SpriteName =
    --    self.winner and (self.isAttack and resultTag.attackwin or resultTag.defencewin) or
    --    (self.isAttack and resultTag.attacklose or resultTag.defencelose)
end

function SpiritualRealmReportItem:OnReplayBtnCall(go)
    if self.playback_uid == 0 then
        if self.winner then
            _G.PopWindowManager:GetInstance():ShowAllTips(880119)
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(880120)
        end
    else
        ---@_aorbtn_report
        SpiritualRealmNet:GetInstance():Playback({ playback_uid = self.playback_uid },
            _G.handler(self, self.OnReplayReportCall))
    end
end

-- 战报空阵容判断
function SpiritualRealmReportItem:HaveBattleGroup(arg)
    if _G.table.isEmptyOrNil(arg) then
        return false
    end
    local checkGroup = function(t)
        if t and not _G.table.isEmptyOrNil(t) then
            for k, v in pairs(t) do
                if not v.fights then
                    return false
                end
            end
            return true
        else
            return false
        end
    end
    return checkGroup(arg.attacker_team) and checkGroup(arg.defender_team)
end

function SpiritualRealmReportItem:OnReplayReportCall(msg)
    if msg.ack ~= 1 then
        return
    end
    if #msg.data > 1 then
        local fightArgs = {}
        for k, v in pairs(msg.data) do
            _G.table.insert(fightArgs,
                { data = v, index = k, winner = v.winner[1] and 1 or 0, playbackUid = self.playback_uid })
        end
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.SpiritualRealmSettlementView.Name,
            nil,
            2,
            fightArgs,
            self.data
        )
    else
        self.fight_arg = msg.data[1]
        local battleInfo = self:HaveBattleGroup(msg.data[1]) and
            _G.BattleManager:GetInstance():GetStatisticsRecord(msg.data[1]) or nil
        self:UpdateData(battleInfo)
    end
end

---@param data table 伤害数据
function SpiritualRealmReportItem:UpdateData(data)
    if not data then
        _G.PopWindowManager:GetInstance():ShowAllTips(540302)
        return
    end
    self.maxCount = _G.table.count(data.FighterInfo)
    self.PveData = self:InitData(data)
    if self.reportType == 3 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GroupBattlePanelView.Name,
            self.PveData,
            self.winnertable,
            self.otherPlayer,
            nil,
            self.fight_arg,
            self.reportType,
            self.playback_uid)
        return
    end

    --获取对战双方的名称
    local leftName, rightName = _G.PlayerModel:GetInstance():GetName(),
    self.otherPlayer and self.otherPlayer.name or ""
    if self.fight_arg.def_uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
        --当前玩家为防守方(防守战报), 交换名称
        local tempName = leftName
        leftName = rightName
        rightName = tempName
    end
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name,
        self.PveData,
        self.winnertable,
        nil,
        nil,
        self.otherPlayer,
        1,
        true,
        self.fight_arg,
        nil,
        { self.playback_uid },
        self.reportType,
        nil,
        nil,
        nil,
        nil,
        self.needChangeTag,
        nil,
        nil,
        nil,
        { leftName, rightName } --reportParams
    )
end

function SpiritualRealmReportItem:InitData(data)
    local tb = {}
    for i = 1, self.maxCount do
        local tempData = data.FighterInfo[i]
        local temp = {}
        temp.AtkUid = data.AtkUid
        temp.DefUid = data.DefUid
        temp.statisticsMax = { DmgOut = 1, DmgIn = 1, HpRecover = 1, CreateGuard = 1 }
        temp.statisticsData = tempData
        for j = 1, #tempData.Attacker do
            if temp.statisticsMax.DmgOut < tempData.Attacker[j].DmgOut then
                temp.statisticsMax.DmgOut = tempData.Attacker[j].DmgOut
            end

            if temp.statisticsMax.DmgIn < tempData.Attacker[j].DmgIn then
                temp.statisticsMax.DmgIn = tempData.Attacker[j].DmgIn
            end

            if temp.statisticsMax.HpRecover < tempData.Attacker[j].HpRecover then
                temp.statisticsMax.HpRecover = tempData.Attacker[j].HpRecover
            end
            if temp.statisticsMax.CreateGuard < tempData.Attacker[j].CreateGuard then
                temp.statisticsMax.CreateGuard = tempData.Attacker[j].CreateGuard
            end
        end
        for j = 1, #tempData.Defender do
            if temp.statisticsMax.DmgOut < tempData.Defender[j].DmgOut then
                temp.statisticsMax.DmgOut = tempData.Defender[j].DmgOut
            end

            if temp.statisticsMax.DmgIn < tempData.Defender[j].DmgIn then
                temp.statisticsMax.DmgIn = tempData.Defender[j].DmgIn
            end

            if temp.statisticsMax.HpRecover < tempData.Defender[j].HpRecover then
                temp.statisticsMax.HpRecover = tempData.Defender[j].HpRecover
            end
            if temp.statisticsMax.CreateGuard < tempData.Defender[j].CreateGuard then
                temp.statisticsMax.CreateGuard = tempData.Defender[j].CreateGuard
            end
        end
        temp.CombMax = { DmgOut = 1, CreateGuard = 1, HpRecover = 1 }
        for j = 1, #tempData.AtkCombineSkills[1] do
            if temp.CombMax.DmgOut < tempData.AtkCombineSkills[1][j].DmgOut then
                temp.CombMax.DmgOut = tempData.AtkCombineSkills[1][j].DmgOut
            end

            if temp.CombMax.CreateGuard < tempData.AtkCombineSkills[1][j].CreateGuard then
                temp.CombMax.CreateGuard = tempData.AtkCombineSkills[1][j].CreateGuard
            end

            if temp.CombMax.HpRecover < tempData.AtkCombineSkills[1][j].HpRecover then
                temp.CombMax.HpRecover = tempData.AtkCombineSkills[1][j].HpRecover
            end
        end
        for j = 1, #tempData.DefCombineSkills[1] do
            if temp.CombMax.DmgOut < tempData.DefCombineSkills[1][j].DmgOut then
                temp.CombMax.DmgOut = tempData.DefCombineSkills[1][j].DmgOut
            end

            if temp.CombMax.CreateGuard < tempData.DefCombineSkills[1][j].CreateGuard then
                temp.CombMax.CreateGuard = tempData.DefCombineSkills[1][j].CreateGuard
            end

            if temp.CombMax.HpRecover < tempData.DefCombineSkills[1][j].HpRecover then
                temp.CombMax.HpRecover = tempData.DefCombineSkills[1][j].HpRecover
            end
        end
        temp.PetMax = { DmgOut = 1, CreateGuard = 1, HpRecover = 1 }
        for j = 1, #tempData.AtkPetSkills[1] do
            if temp.PetMax.DmgOut < tempData.AtkPetSkills[1][j].DmgOut then
                temp.PetMax.DmgOut = tempData.AtkPetSkills[1][j].DmgOut
            end

            if temp.PetMax.CreateGuard < tempData.AtkPetSkills[1][j].CreateGuard then
                temp.PetMax.CreateGuard = tempData.AtkPetSkills[1][j].CreateGuard
            end

            if temp.PetMax.HpRecover < tempData.AtkPetSkills[1][j].HpRecover then
                temp.PetMax.HpRecover = tempData.AtkPetSkills[1][j].HpRecover
            end
        end
        for j = 1, #tempData.DefPetSkills[1] do
            if temp.PetMax.DmgOut < tempData.DefPetSkills[1][j].DmgOut then
                temp.PetMax.DmgOut = tempData.DefPetSkills[1][j].DmgOut
            end

            if temp.PetMax.CreateGuard < tempData.DefPetSkills[1][j].CreateGuard then
                temp.PetMax.CreateGuard = tempData.DefPetSkills[1][j].CreateGuard
            end

            if temp.PetMax.HpRecover < tempData.DefPetSkills[1][j].HpRecover then
                temp.PetMax.HpRecover = tempData.DefPetSkills[1][j].HpRecover
            end
        end
        temp.TeamIndex = tempData.TeamIndex
        _G.table.insert(tb, temp)
    end
    return tb
end

