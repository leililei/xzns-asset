---获取每日任务采集值
function SpiritualRealmTaskModel:GetDayCurrValue(Id)
    if self.taskInfo == nil or self.taskInfo.day_curr == nil then
        return 0
    end

    for _, value in pairs(self.taskInfo.day_curr) do
        if _G.table.sameByCount(Id, value.type) then
            return value.curr
        end
    end
    return 0
end

---获取赛季任务采集值
function SpiritualRealmTaskModel:GetSeasonCurrValue(Id)
    if self.taskInfo == nil or self.taskInfo.season_curr == nil then
        return 0
    end

    for _, value in pairs(self.taskInfo.season_curr) do
        if _G.table.sameByCount(Id, value.type) then
            return value.curr
        end
    end
    return 0
end

---查询当前id是否已领取奖励
---@param id number 任务id
function SpiritualRealmTaskModel:CheckTaskIsFinish(id)
    if self.taskInfo == nil or self.taskInfo.finish_task == nil then
        return false
    end
    for key, value in pairs(self.taskInfo.finish_task) do
        if id == value then
            return true
        end
    end
    return false
end

---已完成任务添加
---@param id number 任务id
function SpiritualRealmTaskModel:IsFinishTask(id)
    if self.taskInfo == nil then
        self.taskInfo = {}
        self.taskInfo.finish_task = {}
    elseif self.taskInfo.finish_task == nil then
        self.taskInfo.finish_task = {}
    end

    _G.table.insert(self.taskInfo.finish_task, id)

    for key, value in pairs(self.taskOne) do
        if value.id == id then
            value.i_task.state = _G.TaskEnum.ETaskState.Completed
        end
    end
    for key, value in pairs(self.taskTwo) do
        if value.id == id then
            value.i_task.state = _G.TaskEnum.ETaskState.Completed
        end
    end
end

---预完成添加
---@param id number 任务id
function SpiritualRealmTaskModel:IsUidTask(id)
    for key, value in pairs(self.taskPrefinish) do
        if value == id then
            return
        end
    end
    if self.taskInfo and self.taskInfo.finish_task then
        for key, value in pairs(self.taskInfo.finish_task) do
            if value == id then
                return
            end
        end
    end

    _G.table.insert(self.taskPrefinish, id)
end

---完成任务
---@param id number 任务id
---@param call function 完成回调
function SpiritualRealmTaskModel:ChessAward(id, call)
    local data = {}
    data.task_sids = id
    if #id < 1 then
        if call ~= nil then
            call()
        end
        return
    end
    require "SpiritualRealmNet":GetInstance():FinishTask(
        data,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            if _G.table.count(id) > 1 then
                for key, value in pairs(id) do
                    self:IsFinishTask(value)
                end
                self.taskPrefinish = {}
            else
                for key, value in pairs(id) do
                    local num
                    for k, v in pairs(self.taskPrefinish) do
                        if v == value then
                            num = k
                        end
                    end
                    if num then
                        table.remove(self.taskPrefinish, num)
                    end
                    self:IsFinishTask(value)
                end
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            self:RefreshRedPoint()

            if call ~= nil then
                call()
            end
        end
    )
end

---获取任务红点状态
---@return boolean 红点状态
function SpiritualRealmTaskModel:CheckRedPointSpiritualRealmTask()
    if require("SpiritualRealmModel"):GetInstance():IsSettlementTime() then
        return false
    end
    local num = self.taskPrefinish
    if not _G.table.isEmptyOrNil(num) then
        return true
    end
    return false
end

---刷新任务红点
function SpiritualRealmTaskModel:RefreshRedPoint()
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.ArenaLayerTask.id)
end

function SpiritualRealmTaskModel:ClearTask()
    if self.taskOne ~= nil then
        for _, v in pairs(self.taskOne) do
            v:Dispose()
        end
        self.taskOne = nil
    end
    if self.taskTwo ~= nil then
        for _, v in pairs(self.taskTwo) do
            v:Dispose()
        end
        self.taskTwo = nil
    end
end

function SpiritualRealmTaskModel:Dispose()
    self:ClearTask()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.arena_layer_task_curr.Cmd, self.OnTaskCall, self)
end

return SpiritualRealmTaskModel
