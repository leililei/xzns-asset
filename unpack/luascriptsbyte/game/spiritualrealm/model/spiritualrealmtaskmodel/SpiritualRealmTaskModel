---@class SpiritualRealmTaskModel :Singleton
local SpiritualRealmTaskModel = _G.BaseClass("SpiritualRealmTaskModel", _G.Singleton)

---@return SpiritualRealmTaskModel SpiritualRealmTaskModel
function SpiritualRealmTaskModel:GetInstance()
    return self.super.GetInstance(self)
end

local table = _G.table
local arena_layer_task_cfg = _G.ConfigManager.arena_layer_task_cfg
local arena_layer_up_cfg = _G.ConfigManager.arena_layer_up_cfg

function SpiritualRealmTaskModel:__init()
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.arena_layer_task_curr.Cmd, self.OnTaskCall, self)
end

---初始化任务
function SpiritualRealmTaskModel:InitData(info)
    self.taskPrefinish = {}
    self:ClearTask()
    self.taskInfo = info.self_info or {}
    local finishTask = {}
    if self.taskInfo.day_finish then
        for _, v in pairs(self.taskInfo.day_finish) do
            table.insert(finishTask, v)
        end
    end
    if self.taskInfo.season_finish then
        for _, v in pairs(self.taskInfo.season_finish) do
            table.insert(finishTask, v)
        end
    end
    self.taskInfo.finish_task = finishTask
    self.taskOne = {}
    self.taskTwo = {}
    self:InitTask()
end

function SpiritualRealmTaskModel:InitTask()
    self.joinType = require("SpiritualRealmModel"):GetInstance():GetJoinType()
    if self.joinType == 0 then
        return
    end
    local taskLis = arena_layer_up_cfg[self.joinType].quest[1]
    local value
    for key, id in pairs(taskLis) do
        value = arena_layer_task_cfg[id]
        local states = _G.TaskEnum.ETaskState.Claimed
        local target
        if self:CheckTaskIsFinish(value.id) then
            states = _G.TaskEnum.ETaskState.Completed
        end

        if value.type_mission == 1 then
            local data = {}
            for k, v in pairs(value.condition[1]) do
                if k < _G.table.count(value.condition[1]) then
                    _G.table.insert(data, v)
                end
            end
            target = self:GetDayCurrValue(data)

            local taskDatas =
                require "SpiritualRealmTaskData".New(
                {
                    sid = value.id,
                    target = {target},
                    state = states,
                    cfg = value,
                    id = data,
                    Type = 1
                }
            )
            _G.table.insert(self.taskOne, taskDatas)
        elseif value.type_mission == 2 then
            local data = {}
            for k, v in pairs(value.condition[1]) do
                if k < _G.table.count(value.condition[1]) then
                    _G.table.insert(data, v)
                end
            end
            target = self:GetSeasonCurrValue(data)

            local taskDatas =
                require "SpiritualRealmTaskData".New(
                {
                    sid = value.id,
                    target = {target},
                    state = states,
                    cfg = value,
                    id = data,
                    Type = 2
                }
            )
            _G.table.insert(self.taskTwo, taskDatas)
        end
    end
end

function SpiritualRealmTaskModel:OnTaskCall(msg)
    if self.joinType == 0 then
        if _G.AppSetting.DEBUG then
            _G.LogError("【问鼎灵域】在没有报名的情况下收到了任务推送：")
            _G.LogError(msg)
        end
        return
    end
    if self.taskInfo.day_curr == nil then
        self.taskInfo.day_curr = {}
    end
    if self.taskInfo.season_curr == nil then
        self.taskInfo.season_curr = {}
    end
    if msg.ack ~= 1 then
        return
    end

    for _, task in pairs(msg.task_list) do
        local insertNew = true
        for _, v in pairs(self.taskInfo.day_curr) do
            if _G.table.sameByCount(task.type, v.type) then
                v.curr = v.curr + task.curr
                insertNew = false
            end
        end
        if insertNew then
            _G.table.insert(self.taskInfo.day_curr, {type = task.type, curr = task.curr})
        end
        self:OnDayCurr(task)
        insertNew = true
        for _, v in pairs(self.taskInfo.season_curr) do
            if _G.table.sameByCount(task.type, v.type) then
                v.curr = v.curr + task.curr
                insertNew = false
            end
        end
        if insertNew then
            _G.table.insert(self.taskInfo.season_curr, {type = task.type, curr = task.curr})
        end
        self:OnSeasonCurr(task)
    end
    self:RefreshRedPoint()
end
---每日任务刷新
function SpiritualRealmTaskModel:OnDayCurr(data)
    for key, value in pairs(self.taskOne) do
        if _G.table.sameByCount(data.type, value.idList) then
            value:CheckTaskTarget()
            value:CheckTaskState()
        end
    end
end

---赛季成就刷新
function SpiritualRealmTaskModel:OnSeasonCurr(data)
    for key, value in pairs(self.taskTwo) do
        if _G.table.sameByCount(data.type, value.idList) then
            value:CheckTaskTarget()
            value:CheckTaskState()
        end
    end
end
function SpiritualRealmTaskModel:ListTask(list, id)
    for key, value in pairs(list) do
        if _G.table.sameByCount(id, value.idList) then
            return key
        end
    end
    return false
end

