function SpiritualRealmModel:GetShopItemList()
    local cfg = self:GetCurrentShopCfg()
    if cfg == nil then
        return {}
    end
    local items = {}
    for i = 1, 3 do
        -- if self.historyScores[i] then
        if cfg.shop[i] ~= nil then
            for _, v in pairs(cfg.shop[i]) do
                _G.table.insert(items, v)
            end
        end
        -- end
    end
    return items
end

---获取商店跳转位置
function SpiritualRealmModel:GetShopJumpIndex()
    local cfg = self:GetCurrentShopCfg()
    if cfg == nil then
        return 1
    end
    local sum = 0
    for i = 1, self.joinType - 1 do
        sum = sum + #cfg.shop[i]
    end
    return sum + 1
end

---获取当前赛季商店配置(服务器ID顺序往后延, 但配置项可能没那么多, 此时取最后一个)
---@如果配置表为空, 仍然可能返回nil
---@private
---@return arena_layer_season_cfg
function SpiritualRealmModel:GetCurrentShopCfg()
    local cfg = _G.ConfigManager.arena_layer_season_cfg[self.seasonId]
    if cfg then
        return cfg
    end
    --取序号最大的配置项(与服务器逻辑一致)
    --下标不一定从1开始(非数组), 使用pairs遍历
    local maxIndex = 0
    for index, _cfg in pairs(_G.ConfigManager.arena_layer_season_cfg) do
        if not cfg or index > maxIndex then
            cfg = _cfg
            maxIndex = index
        end
    end
    return cfg
end

---检查历史最高段位是否满足
---@param condition table 类型(4~6)#段位id
function SpiritualRealmModel:CheckHistoryRank(condition)
    local type = condition[1] - 3
    local sid = condition[2]
    local cfg = _G.ConfigManager.arena_layer_league_cfg[sid]
    local achieve = self.historyScores[type] and self.historyScores[type] >= cfg.min_score
    return achieve, cfg
end

---检查段位奖励是否已领取
---@param sid number 段位sid
---@return number 状态0可领取1未达标2已领取
function SpiritualRealmModel:GetStageAwardState(sid)
    local xx = _G.ConfigManager.arena_layer_league_cfg[sid]
    if xx == nil then
        _G.LogError("红点报错,段位id:" .. sid)
    end
    if self.maxScore == nil then
        _G.LogError("红点报错maxScore为空,段位id:" .. sid)
        return 1
    end
    if _G.table.ContainsValue(self.stageAward, sid) then
        return 2
    elseif self.maxScore >= _G.ConfigManager.arena_layer_league_cfg[sid].min_score then
        return 0
    end
    return 1
end

---领取段位奖励
---@param sids number[] 段位sid集合
function SpiritualRealmModel:GetStageAward(sids, callback)
    local pbData = { stage_sid = sids }
    SpiritualRealmNet:GetInstance():GetStageAward(
        pbData,
        function(msg)
            for _, sid in pairs(sids) do
                _G.table.insert(self.stageAward, sid)
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.ArenaLayerRank.id)
            if callback then
                callback(msg)
            end
        end
    )
end

---排行奖励红点
function SpiritualRealmModel:CheckRedPointRankAward()
    if self.joinType == 0 then
        return false
    end
    if self:IsSettlementTime() then
        return false
    end
    for _, v in pairs(_G.ConfigManager.arena_layer_league_cfg) do
        if self:GetStageAwardState(v.id) == 0 then
            return true
        end
    end
    return false
end

