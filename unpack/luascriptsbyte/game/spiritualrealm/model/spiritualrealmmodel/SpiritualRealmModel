---检测能否进入匹配界面
function SpiritualRealmModel:CheckEnterMatch()
    ---@type EmbattleType[]
    local tb = {}
    local teamNum = self:GetCurTeamNum()
    for tnIndex = 1, teamNum do
        table.insert(tb, _G.EmbattleType["SpiritualRealm" .. tnIndex])
    end
    for i = 1, #tb do
        local data = require("EmbattleModel"):GetInstance():GetEmbattleData(tb[i])
        local canMatch = false
        for j = 1, #data do
            if data[j] > 0 then
                canMatch = true
                break
            end
        end
        if not canMatch then
            return false, i
        end
    end
    return true
end

function SpiritualRealmModel:ScoreChange(changeScore)
    if changeScore == 0 then
        return
    else
        local last_league_cfg = self:GetGradeCfg(self.score)
        self.score = self.score + changeScore
        if self.score > self.maxScore then
            self.maxScore = self.score
        end
        if self.score > self.historyScores[self.joinType] then
            self.historyScores[self.joinType] = self.score
        end
        local now_league_cfg = self:GetGradeCfg(self.score)
        if last_league_cfg.id ~= now_league_cfg.id then
            if changeScore > 0 then
                self.ShowScore = self.score
            end
            _G.Events:GetInstance():Broadcast(_G.SpiritualRealmEvents.GradeChange)
        end
        _G.Events:GetInstance():Broadcast(_G.SpiritualRealmEvents.ScoreChange)
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.ArenaLayerRank.id)
    end
end

function SpiritualRealmModel:TryShowGrade()
    if self.ShowScore ~= nil and self.ShowScore > 0 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpiritualRealmPromotionView.Name, self.ShowScore)
    end
    self.ShowScore = 0
end

---获取商店商品列表(历史报名过的类型才会出现在商店中)
