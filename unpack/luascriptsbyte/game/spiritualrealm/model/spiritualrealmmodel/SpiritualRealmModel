---销毁对象时,析构函数
function SpiritualRealmModel:Dispose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.defendTimer then
        self.defendTimer:Stop()
        self.defendTimer = nil
    end
    if self.settleTimer then
        self.settleTimer:Stop()
        self.settleTimer = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.eCard.CardUpStar, self.RefreshDefendRed, self)
    _G.Events:GetInstance():RemoveListener(_G.eCard.CardDelCard, self.RefreshDefendRed, self)
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.OnSixClockUpdateCallback, self)
end

