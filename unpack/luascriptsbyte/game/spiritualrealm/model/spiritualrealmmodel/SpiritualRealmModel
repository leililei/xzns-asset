---匹配完成后直接开始战斗返回结果展示列表
---@param arena_layer_enemy_array arena_layer.s2c_arena_layer_enemy_array
---@param arena_layer_match arena_layer.s2c_arena_layer_match
---@param skipBattle boolean 是否跳过战斗
function SpiritualRealmModel:FightOneKey(arena_layer_enemy_array, arena_layer_match, skipBattle)
    local tb, reserveEmbattleTypes = {}, {}
    local teamNum = self:GetCurTeamNum()
    --LogError(teamNum, "队伍数量")
    if teamNum == 1 then
        tb = {
            _G.EmbattleType.SpiritualRealm1
        }
        reserveEmbattleTypes = {
            _G.EmbattleType.SpiritualRealm2,
            _G.EmbattleType.SpiritualRealm3,
            _G.EmbattleType.SpiritualRealm4,
            _G.EmbattleType.SpiritualRealm5
        }

        local datas = {}
        local data = { false }
        datas[1] = data
        local emptyTag = true
        if arena_layer_enemy_array.team_list ~= nil then
            local teams = arena_layer_enemy_array.team_list[1]
            if teams.team ~= nil then
                for i = 1, #teams.team do
                    data[i] = {
                        uid = teams.team[i].sid,
                        sid = teams.team[i].sid,
                        level = teams.team[i].level or 0,
                        star = teams.team[i].star or 0,
                        power = teams.team[i].power,
                        soulLink_lv = teams.team[i].soul_lv or 0,
                        soulLink_IsActivate = teams.team[i].soul_state or 0,
                        artifact = teams.team[i].artifact or {},
                        open_inborn = teams.team[i].born_skill_num or 0
                    }
                    if emptyTag and teams.team[i].sid > 0 then
                        emptyTag = false
                    end
                end
            end
            data.power = teams.power
            data.combine = teams.combine
            data.pet = teams.pet
        else
            data.power = 0
        end

        local joinType = self:GetJoinType()

        if emptyTag then --挑战空阵容玩家
            require("EmbattleController"):GetInstance():SaveByEnemyEmpty(
                tb,
                _G.EmbattleSaveType.server,
                nil,
                _G.EmbattleControllerItemType.SpiritualRealmAttack,
                500000001,
                datas
            )
            local msg = {}
            msg.type = 2
            SpiritualRealmNet:GetInstance():Fight(msg, _G.handlerbind(self, self.OnOneKeyFightCall, joinType, true, false))
            return
        end

        self:EnterFightOneKey(joinType, skipBattle)
    else
        local joinType = self:GetJoinType()

        self:EnterFightOneKey(joinType, skipBattle)
    end
end

---进入战斗回调
---@param msg arena_layer.s2c_arena_layer_fight
---@param joinType number 加入的竞技场类型
---@param isEmptyEnemy boolean 单场的战斗敌方阵容是否为空
---@param skipBattle boolean 是否跳过战斗
function SpiritualRealmModel:OnOneKeyFightCall(msg, joinType, isEmptyEnemy, skipBattle)
    if msg.ack ~= 1 then
        self:ExitEmbattle2()
        return
    end
    local isWin = false

    if msg.fight_result ~= nil then
        _G.SortList(
            msg.fight_result,
            function(a)
                return -a.index
            end
        )
        local winnum = 0
        for i = 1, #msg.fight_result do
            if msg.fight_result[i].winner == 1 then
                winnum = winnum + 1
            end
        end
        if winnum > #msg.fight_result / 2 then
            isWin = true
        end
    end

    table.insert(self.OneKeyIsWinList, isWin)

    if self:GetRestFreeFightTimes() <= 0 then
        self:CastFightTicket()
    end
    self.fightTimes = self.fightTimes + 1
    _G.Events:GetInstance():Broadcast(_G.SpiritualRealmEvents.FightTimeChange)
    SpiritualRealmNet:GetInstance():FightResult(
        _G.handlerbind(self, self.OnOneKeyFightResultCall, msg, joinType, isEmptyEnemy, skipBattle)
    )
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.ArenaLayerFreeTime.id)
end

---进入战斗回调
---@param msg arena_layer.s2c_arena_layer_result
---@param arena_layer_fight arena_layer.s2c_arena_layer_fight
---@param joinType number 加入的竞技场类型
---@param isEmptyEnemy boolean 单场的战斗敌方阵容是否为空
---@param skipBattle boolean 是否跳过战斗
function SpiritualRealmModel:OnOneKeyFightResultCall(msg, arena_layer_fight, joinType, isEmptyEnemy, skipBattle)
    if msg.ack ~= 1 then
        self:ExitEmbattle2()
        return
    end
    self:ScoreChange(msg.args[2] - msg.args[1])

    table.insert(self.OneKeyChangeScoreList, msg.args[2] - msg.args[1])

    table.insert(self.OneKeyReportList, msg.report)

    _G.Events:GetInstance():Broadcast(_G.SpiritualRealmEvents.OneKeyFightEnd)
end

---匹配完成后进入进攻布阵或者调整界面
---@param arena_layer_enemy_array arena_layer.s2c_arena_layer_enemy_array
---@param arena_layer_match arena_layer.s2c_arena_layer_match
---@param skipBattle boolean 是否跳过战斗
function SpiritualRealmModel:Fight(arena_layer_enemy_array, arena_layer_match, skipBattle)
    local tb, reserveEmbattleTypes = {}, {}
    local teamNum = self:GetCurTeamNum()
    if teamNum == 1 then
        tb = {
            _G.EmbattleType.SpiritualRealm1
        }
        reserveEmbattleTypes = {
            _G.EmbattleType.SpiritualRealm2,
            _G.EmbattleType.SpiritualRealm3,
            _G.EmbattleType.SpiritualRealm4,
            _G.EmbattleType.SpiritualRealm5
        }

        local datas = {}
        local data = { false }
        datas[1] = data
        local emptyTag = true
        if arena_layer_enemy_array.team_list ~= nil then
            local teams = arena_layer_enemy_array.team_list[1]
            if teams.team ~= nil then
                for i = 1, #teams.team do
                    data[i] = {
                        uid = teams.team[i].sid,
                        sid = teams.team[i].sid,
                        level = teams.team[i].level or 0,
                        star = teams.team[i].star or 0,
                        power = teams.team[i].power,
                        soulLink_lv = teams.team[i].soul_lv or 0,
                        soulLink_IsActivate = teams.team[i].soul_state or 0,
                        artifact = teams.team[i].artifact or {},
                        open_inborn = teams.team[i].born_skill_num or 0
                    }
                    if emptyTag and teams.team[i].sid > 0 then
                        emptyTag = false
                    end
                end
            end
            data.power = teams.power
            data.combine = teams.combine
            data.pet = teams.pet
        else
            data.power = 0
        end

        local joinType = self:GetJoinType()

        if emptyTag then --挑战空阵容玩家
            require("EmbattleController"):GetInstance():SaveByEnemyEmpty(
                tb,
                _G.EmbattleSaveType.server,
                nil,
                _G.EmbattleControllerItemType.SpiritualRealmAttack,
                500000001,
                datas
            )
            local msg = {}
            msg.type = 1
            SpiritualRealmNet:GetInstance():Fight(msg,_G.handlerbind(self, self.OnFightCall, joinType, true, false))
            return
        end
        --跳过战斗(不进入布阵页面直接结算, 当前禁用)
        if skipBattle and false then
            local embattleItem =
                require(_G.EmbattleControllerItemType.SpiritualRealmAttack).New(
                    tb,
                    _G.EmbattleSaveType.server,
                    false,
                    500000001,
                    datas
                )
            embattleItem:SaveEmbattle(
                function(result)
                    if result ~= 0 then
                        return
                    end
                    self:EnterFight(joinType, true)
                end
            )
            return
        end

        --记录敌方信息, 用于布阵和战斗页面显示对方名称
        self.enemyInfo = arena_layer_match
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
        require("EmbattleController"):GetInstance():OpenEmbattle(
            tb,
            _G.EmbattleSaveType.server,
            false,
            _G.EmbattleControllerItemType.SpiritualRealmAttack,
            _G.handler(self, self.ExitEmbattle),
            --从布阵进入战斗(回调第一个参数为nil时, 无法正确传递参数, 因此此处无法使用_G.handlerbind)
            function(_, _skipBattle)
                self:EnterFight(joinType, _skipBattle)
            end,
            500000001,
            datas,
            nil,
            skipBattle,
            reserveEmbattleTypes
        )
    else
        --打开调整界面
        local embattleDatas = {}
        for tnIndex = 1, teamNum do
            ---@type EmbattleType
            local embattleType = _G.EmbattleType["SpiritualRealm" .. tnIndex]
            table.insert(embattleDatas, require("EmbattleModel"):GetInstance():GetEmbattleData(embattleType))
        end

        local attEquity = _G.ConfigManager.att_equity_cfg[8]
        for i = 1, #embattleDatas do
            for j = 1, #embattleDatas[i] do
                if embattleDatas[i][j] > 0 then
                    local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, embattleDatas[i][j])
                    if card then
                        local newCard = _G.CardData.New()
                        local msg =
                            require "CardInfoManager":GetInstance():GetNewCardDataByCfg(attEquity, card, newCard)
                        newCard:Parse(msg)
                        newCard:OnInitMutuallyData(true, nil, true)
                        embattleDatas[i][j] = {
                            uid = newCard.uid,
                            sid = newCard.sid,
                            star = newCard:GetStar(),
                            level = newCard:GetLevel(),
                            soulLink_lv = newCard.soulLink_lv,
                            power = newCard:GetPower(),
                            soulLink_IsActivate = newCard.soulLink_IsActivate,
                            open_inborn = newCard.open_inborn,
                            tag = 0,
                            skin = newCard.skin
                        }
                    else
                        embattleDatas[i][j] = {
                            uid = 0,
                            sid = 0,
                            star = 0,
                            level = 1,
                            soulLink_lv = 0,
                            power = 0,
                            soulLink_IsActivate = 0,
                            open_inborn = 0,
                            tag = 0
                        }
                    end
                else
                    embattleDatas[i][j] = {
                        uid = 0,
                        sid = 0,
                        star = 0,
                        level = 1,
                        soulLink_lv = 0,
                        power = 0,
                        soulLink_IsActivate = 0,
                        open_inborn = 0,
                        tag = 0
                    }
                end
            end
        end
        local datas = {}
        if arena_layer_enemy_array.team_list ~= nil then
            for m = 1, #arena_layer_enemy_array.team_list do
                local data = { false }
                datas[m] = data
                local emptyTag = true
                local teams = arena_layer_enemy_array.team_list[m]
                for i = 1, #teams.team do
                    data[i] = {
                        uid = teams.team[i].sid,
                        sid = teams.team[i].sid,
                        level = teams.team[i].level or 0,
                        star = teams.team[i].star or 0,
                        power = teams.team[i].power,
                        soulLink_lv = teams.team[i].soul_lv or 0,
                        soulLink_IsActivate = teams.team[i].soul_state or 0,
                        artifact = teams.team[i].artifact or {},
                        open_inborn = teams.team[i].born_skill_num or 0
                    }
                    if emptyTag and teams.team[i].sid > 0 then
                        emptyTag = false
                    end
                end
                if teams.power then
                    data.power = teams.power
                end
            end
        end
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.SpiritualRealmSettlementView.Name,
            _G.handlerbind(self, self.TryShowGrade),
            3,
            arena_layer_match,
            embattleDatas,
            datas
        )
    end
end

