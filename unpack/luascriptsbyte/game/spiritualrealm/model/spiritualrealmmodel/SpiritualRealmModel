---@return boolean 是否在结算期
function SpiritualRealmModel:IsSettlementTime()
    if self.seasonState == 2 then
        return true
    end
    if self:GetStopTime() == nil or self:GetEndTime() == nil then
        if _G.AppSetting.DEBUG then
            _G.LogWarning("问鼎灵域：调整GM时间或导致赛季未正常结算，部分相关功能可能无法正常使用")
        end
        return false
    end
    local nowTime = _G.TimeUtil.GetServerUnixTime()
    if nowTime >= self:GetStopTime() and nowTime <= self:GetEndTime() then
        return true
    end
    return false
end

