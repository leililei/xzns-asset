--region 赛季
function SpiritualRealmModel:InitSeason(msg)
    if self.seasonId and self.seasonId ~= msg.season_id and msg.state == 2 then
        _G.DelayDo(
            10,
            function()
                self:GetInfo(_G.handler(self, self.FreshViewCall))
            end
        )
    end
    self.seasonId = msg.season_id
    self.seasonStartTime = msg.start_time
    self.seasonEndTime = msg.end_time
    self.seasonStopTime = msg.stop_time
    self.seasonState = msg.state
    local now = _G.TimeUtil.GetServerUnixTime()
    if self.settleTimer then
        self.settleTimer:Stop()
        self.settleTimer = nil
    end
    if now < self.seasonStopTime then
        self.settleTimer =
            _G.TimerManager:GetInstance():GetTimer(
                self.seasonStopTime - now,
                self.OnSettleTimer,
                self,
                true,
                false,
                true
            )
        self.settleTimer:Start()
    end
end

---初始化玩家信息
function SpiritualRealmModel:InitRoleInfo(msg)
    if not msg then
        return
    end
    self.joinType = msg.join_type
    self.score = msg.score
    self.maxScore = msg.max_score
    self.historyScores = {}
    if msg.history_score then
        for k, v in pairs(msg.history_score) do
            self.historyScores[v.k] = v.v
        end
    end
    self.fightTimes = msg.fight_times
    self.stageAward = msg.stage_award or {}
end

