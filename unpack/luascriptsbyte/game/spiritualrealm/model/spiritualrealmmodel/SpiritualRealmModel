---@param join_type number 类型
---@return boolean 是否可以报名
function SpiritualRealmModel:CanApply(join_type)
    if self.joinType ~= 0 then
        return false
    end
    local arena_layer_up_cfg = _G.ConfigManager.arena_layer_up_cfg[join_type]
    for _, v in pairs(arena_layer_up_cfg.condition) do
        if not self:CheckCondition(v) then
            return false
        end
    end
    return true
end

---@param condition table 条件
---@return boolean, number, number 是否通过,当前进度,最大进度
function SpiritualRealmModel:CheckCondition(condition)
    if condition[1] == 1 then
        local count = require "IllustrationModel":GetInstance():GetCardMaxStarCount(condition[2])
        if count < condition[3] then
            return false, count, condition[3]
        else
            return true, count, condition[3]
        end
    elseif condition[1] == 2 then
        --把2转换成通关放置关卡4,再传入判断
        local tmpCondition = _G.DeepCopyCfgTable(condition)
        tmpCondition[1] = 4
        local pass, tipSid, content = _G.GlobalConditionManager.CheckConditionArrays({ tmpCondition })
        if not pass then
            return false, 0, 1
        else
            return true, 1, 1
        end
    elseif condition[1] == 3 then
        local historyScore = self.historyScores[1]
        if historyScore ~= nil then
            local arena_layer_league_cfg = _G.ConfigManager.arena_layer_league_cfg[condition[2]]
            if historyScore < arena_layer_league_cfg.min_score then
                return false, 0, 1
            else
                return true, 1, 1
            end
        else
            return false, 0, 1
        end
    elseif condition[1] == 4 then
        local historyScore = self.historyScores[2]
        if historyScore ~= nil then
            local arena_layer_league_cfg = _G.ConfigManager.arena_layer_league_cfg[condition[2]]
            if historyScore < arena_layer_league_cfg.min_score then
                return false, 0, 1
            else
                return true, 1, 1
            end
        else
            return false, 0, 1
        end
    elseif condition[1] == 5 then
        local historyScore = self.historyScores[3]
        if historyScore ~= nil then
            local arena_layer_league_cfg = _G.ConfigManager.arena_layer_league_cfg[condition[2]]
            if historyScore < arena_layer_league_cfg.min_score then
                return false, 0, 1
            else
                return true, 1, 1
            end
        else
            return false, 0, 1
        end
    end
    return false, 0, 1
end

---获取当前段位配置
function SpiritualRealmModel:GetCurGradeCfg()
    return self:GetGradeCfg(self.score)
end

---获取历史最高段位配置
---@param type number 报名类型
function SpiritualRealmModel:GetHistoryMaxGradeCfg(type)
    type = type or self.joinType
    if type == 0 then
        return nil
    end
    local score
    if type == self.joinType then
        score = self.maxScore
    else
        score = self.historyScores[type]
    end
    if score == nil then
        return nil
    end
    return self:GetGradeCfg(score)
end

---@param score number 积分
---@return arena_layer_league_cfg 段位表
function SpiritualRealmModel:GetGradeCfg(score)
    local arena_layer_league_cfg = _G.ConfigManager.arena_layer_league_cfg
    for _, v in pairs(arena_layer_league_cfg) do
        if score >= v.min_score and score <= v.max_score then
            return v
        end
    end
    return nil
end

