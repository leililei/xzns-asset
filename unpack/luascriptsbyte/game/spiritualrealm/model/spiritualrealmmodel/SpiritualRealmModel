---进入战斗回调
---@param msg arena_layer.s2c_arena_layer_fight
---@param joinType number 加入的竞技场类型
---@param isEmptyEnemy boolean 单场的战斗敌方阵容是否为空
---@param skipBattle boolean 是否跳过战斗
function SpiritualRealmModel:OnFightCall(msg, joinType, isEmptyEnemy, skipBattle)
    if msg.ack ~= 1 then
        self:ExitEmbattle2()
        return
    end
    if msg.fight_result ~= nil then
        _G.SortList(
            msg.fight_result,
            function(a)
                return -a.index
            end
        )
    end
    if self:GetRestFreeFightTimes() <= 0 then
        self:CastFightTicket()
    end
    self.fightTimes = self.fightTimes + 1
    _G.Events:GetInstance():Broadcast(_G.SpiritualRealmEvents.FightTimeChange)
    SpiritualRealmNet:GetInstance():FightResult(
        _G.handlerbind(self, self.OnFightResultCall, msg, joinType, isEmptyEnemy, skipBattle)
    )
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.ArenaLayerFreeTime.id)
end

