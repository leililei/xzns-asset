--region 推送

---被打
---@param msg arena_layer.p2c_arena_layer_curr
function SpiritualRealmNet:OnP2CAttacked(msg)
    if msg.ack ~= 1 then
        return
    end
    local SpiritualRealmModel = require "SpiritualRealmModel":GetInstance()
    SpiritualRealmModel:ScoreChange(msg.score - SpiritualRealmModel:GetScore())
end

--endregion

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function SpiritualRealmNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return SpiritualRealmNet
