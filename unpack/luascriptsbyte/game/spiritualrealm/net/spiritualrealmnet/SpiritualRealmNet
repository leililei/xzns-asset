local base = require "BaseGameNet"
---@class SpiritualRealmNet : BaseGameNet	通信协议
local SpiritualRealmNet = _G.BaseClass("SpiritualRealmNet", base)

---添加所有后端主动推的网络消息监听接口
function SpiritualRealmNet:AddMessageListeners()
    self:AddMessageListener(_G.ConfigManager.net_map.arena_layer_attacked.Cmd, self.OnP2CAttacked)
end

---@return SpiritualRealmNet SpiritualRealmNet
function SpiritualRealmNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---发送信息
function SpiritualRealmNet:SendMsg(pbData, item, callback)
    if not pbData then
        pbData = self:GetEmptyPB()
    end
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求
---@param callback function 完成回调
function SpiritualRealmNet:GetInfo(callback)
    self:SendMsg(nil, _G.ConfigManager.net_map.game_arena_layer_info, callback)
end

--region 报名

---报名
function SpiritualRealmNet:Apply(pbData, callback)
    self:SendMsg(pbData, _G.ConfigManager.net_map.game_arena_layer_join, callback)
end

--endregion

