    end
    return nil
end

---奖励
function ChieftainTreasuryView:SetRewardView()
    self.numTotle = JointActivityDrawUpModel:GetTotalTimes(self.activityID)
    if self.InitRewardList == nil then
        self.go_table.scrollloophorizontal_Award:InitItemData(#self.rewardsGoods,
            _G.handler(self, self.OnRefreshLoopListItem))
        self.InitRewardList = true
        self.go_table.scrollloophorizontal_Award:ScrollToIndex(#self.rewardsGoods - 1)
    else
        self.go_table.scrollloophorizontal_Award:UpdateAllItem()
    end
    local isGet
    for i = 1, #self.rewardsCount do
        isGet = JointActivityDrawUpModel:IsReceiveAward(self.activityID, i)
        if not isGet or self.totalTimes <= self.rewardsCount[i] then
            self.go_table.scrollloophorizontal_Award:ScrollToIndex(i - 1)
            break
        end
    end
end

function ChieftainTreasuryView:OnRefreshLoopListItem(i, item)
    if i < 0 then
        return
    end
    local eIndex = i + 1
    local side = eIndex % 2
    if side == 0 then
        side = 2
    end
    local id = item:GetInstanceIDE()
    local ctrl = self.rewardItemList[id]
    if not ctrl then
        ctrl = _G.GetAutoGoTable(item)
        _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnClickAwardBtn, ctrl))
        self.rewardItemList[id] = ctrl
    end
    ctrl.index = eIndex
    local go_table = ctrl
    local num = self.rewardsCount[eIndex]
    go_table.aortext_numDraw.text = _G.GetLangPackValue(90032200013, num)
    local isGet = JointActivityDrawUpModel:IsReceiveAward(self.activityID, eIndex)

    local score = self.rewardsCount[eIndex]
    local canGet = not isGet and self.numTotle >= score
    go_table.aorbtn_click:SetActiveE((not isGet) and 1 or 0)
    go_table.obj_redpoint:SetActiveE(canGet and 1 or 0)
    go_table.obj_itemRoot:RemoveAllChildren()

    local list = self.rewardsGoods[eIndex]
    if #list > 3 then
        local test = {}
        table.insert(test, list[4])
        table.insert(test, list[5])
        list = test
    end

    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        list,
        go_table.obj_itemRoot,
        function(tran)
            if self:IsNil() then
                _G.DestroyObject(tran)
                return
            end
            tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            tran:ShowEffect(canGet)
            tran:SetGou(isGet)
            tran.gameObject:SetLocalScaleXYZ(0.7)
        end
    )

    local slider
    local beforNum = self.rewardsCount[eIndex - 1] or 0
    if self.totalTimes <= beforNum then
        slider = 0
    elseif self.totalTimes >= num then
        slider = 1
    else
        slider = (self.totalTimes - beforNum) / (num - beforNum)
    end
    go_table.aorimage_jindu:SetLocalScale(slider, 1, 1)
    return item
end

---奖励点击
function ChieftainTreasuryView:OnClickAwardBtn(_, _, tb)
    local index = tb.index
    -- 判断是否满足领取条件
    local score = self.rewardsCount[index]
    local isGet = JointActivityDrawUpModel:IsReceiveAward(self.activityID, index)
    if self.numTotle >= score and not isGet then
        self.activityCls:GetAward(
            { index },
            function(msg)
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                JointActivityDrawUpModel:InAward(self.activityID, index)
                self:SetRewardView()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg, nil, true)
                self.activityCls:RefreshRedPoint(2)
            end
        )
    else
        local sid = self.rewardsGoods[index][1]
        if #self.rewardsGoods[index] > 3 then
            sid = self.rewardsGoods[index][4]
        end
        require "CommonTipManager":GetInstance():OpenTip(tb.gameObject, sid)
    end
end

---更新动画播放按钮
---@param type DrawPlayType
function ChieftainTreasuryView:UpdateDrawPlayBtn(type)
    if type == nil then
        self.playType = _G.PlayerPrefsManager.GetInt("JointActivityDrawSkip_ChieftainTreasury")
        if self.playType == nil then
            self.playType = DrawPlayType.Play
        end
    else
        self.playType = type
    end
    _G.PlayerPrefsManager.SetInt("JointActivityDrawSkip_ChieftainTreasury", self.playType)
    local isPlay = self.playType == DrawPlayType.Play
    self.go_table.aorimage_auto.gameObject:SetLocalPosition(isPlay and 20 or -20, 0, 0)
    self.go_table.aortext_wenzi.text =
        _G.ConfigManager.language_package_cfg[isPlay and DrawPlayText.Open or DrawPlayText.Close]
    self.go_table.aorimage_skip:SetActiveE(isPlay and 1 or 0)
end

function ChieftainTreasuryView:DrawCard(type)
    if JointActivityDrawUpModel.InDrawing then
        return
    end

    --获取拥有的代币数量
    local coinNum = JointActivityDrawUpModel:GetPropNum(self.activityID)
    local num = 0
    if self.drawConsumeType == _G.DrawConsumeType.diamond then
        num = type == _G.DrawType.once and 1 or 10
    else
        local ten = coinNum >= 10 and 10 or coinNum
        num = type == _G.DrawType.once and 1 or (ten > 0 and ten or 10)
    end

    --获取魂玉召唤总次数
    local totalTimes = JointActivityDrawUpModel:GetDiamondTotalTimes(self.activityID)
    local remainTimes = totalTimes - JointActivityDrawUpModel:GetDiamondTimes(self.activityID)

    ---@type number 消耗模式: 1活动代币 2魂玉
    local consumeType = nil
    local consumeNum = 0
    if coinNum >= num or totalTimes == 0 or remainTimes < num and self.IsUseCoin then
        --检查招募券数量
        if coinNum < num then
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.GetItemWayView.Name,
                JointActivityDrawUpModel:GetCoinId(self.activityID)
            )
            return
        end
        consumeType = _G.DrawConsumeType.token
    else
        --检查魂玉数量
        consumeNum = JointActivityDrawUpModel:GetDiamondConsume(self.activityID, num)
        if type == _G.DrawType.TenTimes then
            local limited_roller_cfg = JointActivityDrawUpModel:Getlimited_roller_cfg(self.activityID)
            local discount = limited_roller_cfg.ticket_discount[1]
            if discount then
                consumeNum = _G.Mathf.Floor(consumeNum * discount / 10000)
            end
        end
        local ownNum = _G.StorageManager:GetInstance():GetItemCountBySid(_G.ResPropID.Diamond)
        if ownNum < consumeNum then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ResPropID.Diamond)
            return
        end
        consumeType = _G.DrawConsumeType.diamond
    end
    if num > 0 then
        if consumeType == _G.DrawConsumeType.diamond then
            local totalTimes = JointActivityDrawUpModel:GetDiamondTotalTimes(self.activityID)
            local usedTimes = JointActivityDrawUpModel:GetDiamondTimes(self.activityID)
            local remainTimes = totalTimes - usedTimes

            if num > remainTimes then
                _G.PopWindowManager:GetInstance():ShowAllTips(310117)
                return
            end

            _G.PopWindowManager:GetInstance():ShowDrawWindowByToggle(
                340605,
                _G.DrawRollerType.JointActivity,
                JointActivityDrawUpModel:GetCfgId(self.activityID),
                num,
                consumeNum,
                function()
                    self.isPlayDrawAnim = true
                    JointActivityDrawUpModel:DrawCard(
                        self.activityID,
                        consumeType,
                        num,
                        _G.handler(self, self.RefreshView),
                        _G.handlerbind(self, self.IsEff)
                    )
                end,
                function()
                end
            )
        else
            self.isPlayDrawAnim = true
            JointActivityDrawUpModel:DrawCard(
                self.activityID,
                consumeType,
                num,
                _G.handler(self, self.RefreshView),
                _G.handlerbind(self, self.IsEff)
            )
        end
    end
end

---特效显示隐藏
function ChieftainTreasuryView:IsEff(num, call, award, bigBol)
    if self.playType == DrawPlayType.Play then
        if self.aniBg then
            self.aniBg.enabled = false
            self.aniBg.enabled = true
        end
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_ChieftainTreasuryView_effect,
            self.go_table.obj_effect,
            nil,
            function(tran)
                --- 防止 异步后
                if _G.IsNil(self.go_table.gameObject) then
                    tran:DestroyObject()
                    return
                end
                local eff = bigBol and _G.ConfigManager.ui_effect_cfg.ef_ChieftainTreasuryView_cai or _G.ConfigManager.ui_effect_cfg.ef_ChieftainTreasuryView_jing
                _G.UIUtils.LoadEffectByCfg(
                    eff,
                    self.go_table.obj_effect,
                    nil,
                    function(tran)
                        --- 防止 异步后
                        if _G.IsNil(self.go_table.gameObject) then
                            tran:DestroyObject()
                            return
                        end
                        self.isPlayDrawAnim = false
                        if call then
                            call()
                        end
                    end
                )
            end
        )
    else
        self.isPlayDrawAnim = false
        if call then
            call()
        end
    end
end

---界面的销毁函数
function ChieftainTreasuryView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer=nil
    end
    self:RemoveAllListener()
end

return ChieftainTreasuryView
