    Play = 0,
    Skip = 1
}
local DrawPlayText = {
    Open = 90021300078,
    Close = 90021300079
}

function ChieftainTreasuryView:Awake()
    --LogError(require "JointActivityDrawUpModel":GetInstance())
    --LogError(JointActivityDrawUpModel:GetInstance())
    JointActivityDrawUpModel = require "JointActivityDrawUpModel":GetInstance()
    JointActivityDrawUpModel.InDrawing = false
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---按钮点击事件在这里派发
function ChieftainTreasuryView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:Close()
    elseif name == "@_aorbtn_selectCard" then
        if JointActivityDrawUpModel.InDrawing then
            return
        end
        local sid = JointActivityDrawUpModel:GetItemId(self.activityID)
        local type = _G.StorageManager:GetInstance():CheckSidType(sid)
        local uiName
        if type == _G.StorageType.Card then
            uiName = _G.ConfigManager.ui_cfg.JoinActivityDrawUpMainSelectView.Name
        else
            uiName = _G.ConfigManager.ui_cfg.SummerFireDrawUpSelectView.Name
        end
        _G.UIManager:GetInstance():OpenWindow(
            uiName,
            self.activityID,
            function()
                self:SetWishAward()
            end
        )
    elseif name == "@_aorbtn_DrawOnce" then
        if self.isPlayDrawAnim then
            return
        end
        self:DrawCard(_G.DrawType.once)
    elseif name == "@_aorbtn_DrawTen" then
        if self.isPlayDrawAnim then
            return
        end
        self:DrawCard(_G.DrawType.TenTimes)
    elseif name == "@_aorbtn_autoLeft" then
        self:UpdateDrawPlayBtn(1 - self.playType)
    elseif name == "@_aorbtn_task" then
        if JointActivityDrawUpModel.InDrawing then
            return
        end
        local mainType = self.activity.cfg.info.front.main_type
        _G.GlobalInterface.JumpActivityByGM(10014, self.activity:GetJumpType(self.ActivityID), false, mainType)
    elseif name == "@_aorbtn_baodian" then
        if JointActivityDrawUpModel.InDrawing then
            return
        end
        local mainType = self.activity.cfg.info.front.main_type
        _G.GlobalInterface.JumpActivityByGM(10027, self.activity:GetJumpType(self.ActivityID), false, mainType)
    elseif name == "@_aorbtn_help" then
        local limitedRollerCfg = JointActivityDrawUpModel:Getlimited_roller_cfg(self.activityID)
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.DrawUpAwardPreView.Name,
            limitedRollerCfg.id,
            -1 --显示所有限时物品
        )
    end
end

---界面的入口函数
function ChieftainTreasuryView:OnCreate(activity)
    self.activity = activity
    self.activityID = activity.activityID
    self.activityCls = self.activity:GetActivityTypeCls()

    ---是否播放转圈动画
    self.isPlayDrawAnim = false

    --- 是否允许使用代币
    self.IsUseCoin = self.activityCls:GetIsUseCoin()
    self.coinId = JointActivityDrawUpModel:GetCoinId(self.activityID)

    ---进度奖励
    local cfg = JointActivityDrawUpModel:Getlimited_roller_cfg(self.activityID)
    self.rewardsGoods = cfg and cfg.rewards_item or {}
    self.rewardsCount = cfg and cfg.rewards_count or 0

    self.rewardItemList = {}
    self.awardSidList = {}

    self:InitResources()
    self:RefreshView()
    self:SetRewardPoolView(cfg)
    self:UpdateDrawPlayBtn()
    self:InitActivityTime()

    if activity.cfg.info.front.gift_group_show then
        ---@type activity.i_gift_group_show
        local show = activity.cfg.info.front.gift_group_show
        for _, v in pairs(show.images) do
            local imgTb, pos
            pos = _G.string.split(v.xyz, "#")
            if v.index == 1 then
                imgTb = self.go_table.aorrawimage_ItemGridBg
                imgTb:LoadImage(
                    v.path,
                    function()
                        if self:IsNil() then
                            return
                        end
                        imgTb:SetNativeSize()
                        imgTb:SetLocalScaleXYZ(v.size / 10000)
                        imgTb:SetLocalPosition(
                            _G.tonumber(pos[1]),
                            _G.tonumber(pos[2]),
                            _G.tonumber(pos[3])
                        )
                    end
                )
            elseif v.index == 2 then
                imgTb = self.go_table.aorimage_mt
                imgTb:SetLocalScaleXYZ(v.size / 10000)
                imgTb:SetLocalPosition(
                    _G.tonumber(pos[1]),
                    _G.tonumber(pos[2]),
                    _G.tonumber(pos[3])
                )
                imgTb.SpriteName = v.path
                imgTb:SetNativeSize()
            end
        end
    end

    self:AddListener(_G.eItemUpdata.Updata, self.LoadConsumesInfos, self)
    self:AddListener(_G.eItemUpdata.ResRefresh, self.LoadConsumesInfos, self)
end

---开始时间~结束时间  (日月)
function ChieftainTreasuryView:InitActivityTime()
    local t
    t, self.time = self.activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    self.go_table.aortext_time.text = _G.GetLangPackValue(90034501003, _G.TimeUtil.GiftPackGroupTime(self.time))
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()
end

function ChieftainTreasuryView:UpdateTime(elapsed)
    if not self.go_table then 
        return 
    end
    self.time = self.time - elapsed
    if self.time <= 0 then
        self:Close()
    else
        self.go_table.aortext_time.text = _G.GetLangPackValue(90034501003, _G.TimeUtil.GiftPackGroupTime(self.time))
    end
end

---初始化资源栏
function ChieftainTreasuryView:InitResources()
    if not _G.IsNil(self.go_table.obj_GoldInfo) and self.go_table.obj_GoldInfo:GetctiveInHierarchy() == 1 then
        ---添加要显示的货币或者资源
        local resources = _G.ConfigManager.ui_cfg.ChieftainTreasuryView.resources
        local newResource = {}
        if not self.IsUseCoin then
            resources = self.activityCls:GetResourceCoin()
        end
        for i = 1, #resources do
            if resources[i] == 128 then
                newResource[i] = JointActivityDrawUpModel:GetCoinId(self.activityID)
            else
                newResource[i] = resources[i]
            end
        end

        if #newResource > 0 then
            self:AddComponent(
                self.go_table.obj_GoldInfo,
                require("ResourceCompont").New(self.go_table.obj_GoldInfo, newResource)
            )
        end
    end
end

function ChieftainTreasuryView:RefreshBtnRedPoint()
    local mainType = self.activity.cfg.info.front.main_type
    local activity =
        require "ActivitySynManager":GetInstance():GetChildAcitivity(10014, self.activity:GetJumpType(self.activityID), mainType)
    if activity then
        self.go_table.obj_redpointask:UpdateRedPointItemIDAndParam(
            activity:GetActivityTypeCls():GetRedpointIDByIndex(1)
        )

        self.go_table.aorbtn_task:SetActiveE(activity and 1 or 0)
    else
        self.go_table.aorbtn_task:SetActiveE(0)
    end

    local activity1 =
        require "ActivitySynManager":GetInstance():GetChildAcitivity(10027, self.activity:GetJumpType(self.activityID), mainType)
    if activity1 then
        self.go_table.obj_redpointbaodian:UpdateRedPointItemIDAndParam(
            self.activity:GetActivityTypeCls():GetRedpointIDByIndex(4) --index=4, 用于挂载宝典和任务
        )

        self.go_table.aorbtn_baodian:SetActiveE(1)
    else
        self.go_table.aorbtn_baodian:SetActiveE(0)
    end
end

function ChieftainTreasuryView:RefreshView()
    self:SetTipInfo()
    self:LoadConsumesInfos()
    self:RefreshBtnRedPoint()
    self:SetRewardView()
end

---第一个自选奖励
function ChieftainTreasuryView:SetWishAward()
    if not self.firstItemTb then
        self.firstItemTb = _G.GetAutoGoTable(self.go_table["obj_item1"], _G.handler(self, self.OnClickBtn))
    end
    local wishData = JointActivityDrawUpModel:GetWishProp(self.activityID)
    self.firstItemTb.obj_root:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        wishData,
        self.firstItemTb.obj_root,
        function(item)
            if self:IsNil() then
                _G.DestroyObject(item.gameObject)
                return
            end
            if item.ShowNumText then
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
            if item.cfg and item.cfg.ef_item and _G.tonumber(item.cfg.ef_item) == 1 then
                item:ShowEffect(true)
            end
        end
    )
    self.awardSidList[1] = wishData[1]
end

function ChieftainTreasuryView:SetRewardPoolView(cfg)
    local pool = cfg and cfg.pool or {}

    ---第一个自选奖励
    self:SetWishAward()

    ---剩下的11个依次从配置中获取
    for i = 1, 11 do
        local data = pool[i]
        local dataReward = _G.StorageManager:GetInstance():GetItemDataClass(data[1], data[2])
        if #data > 3 then
            dataReward = _G.StorageManager:GetInstance():GetItemDataClass(data[4], data[5])
        end
        local tb = _G.GetAutoGoTable(self.go_table["obj_item" .. i + 1])
        tb.obj_root:ClearChildren()
        if dataReward then
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                { dataReward.sid, dataReward.count },
                tb.obj_root,
                function(item)
                    if self:IsNil() then
                        _G.DestroyObject(item.gameObject)
                        return
                    end
                    if item.ShowNumText then
                        item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    end
                    if item.cfg and item.cfg.ef_item and _G.tonumber(item.cfg.ef_item) == 1 then
                        item:ShowEffect(true)
                    end
                end
            )
            _G.table.insert(self.awardSidList, dataReward.sid)
        end
    end
end

