---加载招募消耗信息
function ChieftainTreasuryView:LoadConsumesInfos()
    ---获取代币数量
    local coinNum = JointActivityDrawUpModel:GetPropNum(self.activityID)
    ---获取魂玉召唤次数
    local totalTimes = JointActivityDrawUpModel:GetDiamondTotalTimes(self.activityID)
    local usedTimes = JointActivityDrawUpModel:GetDiamondTimes(self.activityID)
    local remainTimes = totalTimes - usedTimes
    if self.go_table.aortext_dimatime then
        self.go_table.aortext_dimatime.text = _G.GetLangPackValue(90000012029, remainTimes, totalTimes)
    end

    local isUseDiamode = false
    local leftIcon, leftNum, rightNum, rightIcon
    ---单抽
    if coinNum >= 1 or totalTimes == 0 or remainTimes < 1 then
        leftNum = 1
        leftIcon = self:getCurrencyTypeIcon(self.coinId)
    else
        leftNum = JointActivityDrawUpModel:GetDiamondConsume(self.activityID, 1)
        leftIcon = _G.StorageManager:GetInstance():GetItemIcon(_G.ResPropID.Diamond)

        isUseDiamode = true
    end

    ---多抽
    self.go_table.aortext_PropRightNum.text = ""
    if coinNum >= 1 or totalTimes == 0 or remainTimes < 10 then
        if coinNum >= 10 then
            rightNum = 10
        else
            rightNum = coinNum > 0 and coinNum or 10
        end
        rightIcon = self:getCurrencyTypeIcon(self.coinId)
    else
        rightNum = JointActivityDrawUpModel:GetDiamondConsume(self.activityID, 10)
        rightIcon = _G.StorageManager:GetInstance():GetItemIcon(_G.ResPropID.Diamond)
        isUseDiamode = true
    end

    --- 如果不允许使用代币 始终为钻石抽
    if not self.IsUseCoin then
        isUseDiamode = true
        leftIcon = _G.StorageManager:GetInstance():GetItemIcon(_G.ResPropID.Diamond)
        rightIcon = _G.StorageManager:GetInstance():GetItemIcon(_G.ResPropID.Diamond)
        leftNum = JointActivityDrawUpModel:GetDiamondConsume(self.activityID, 1)
        rightNum = JointActivityDrawUpModel:GetDiamondConsume(self.activityID, 10)
    end

    if isUseDiamode then
        self.drawConsumeType = _G.DrawConsumeType.diamond
        self.go_table.aortext_PropRight.text =
            _G.GetLangPackValue(90000011702, _G.GameUtil.NumberToWordByLanguage(10))
    else
        self.drawConsumeType = _G.DrawConsumeType.token
        self.go_table.aortext_PropRight.text =
            _G.GetLangPackValue(90000011702, _G.GameUtil.NumberToWordByLanguage(rightNum))
    end

    if isUseDiamode then
        local limited_roller_cfg = JointActivityDrawUpModel:Getlimited_roller_cfg(self.activityID)
        local discount = limited_roller_cfg.ticket_discount[1]
        if discount and remainTimes >= 10 then
            self.go_table.aortext_PropRightNum.text = _G.string.format("%.0f", rightNum * discount / 10000)
        else
            self.go_table.aortext_PropRightNum.text = rightNum
        end
    else
        self.go_table.aortext_PropRightNum.text = rightNum
    end
    self.go_table.aortext_PropLeftNum.text = leftNum
    self.go_table.aorrawimage_PropLeft:LoadImage(
        leftIcon,
        function(image)
            if image then
                image:SetActiveE(1)
            end
        end
    )
    self.go_table.aorrawimage_PropRight:LoadImage(
        rightIcon,
        function(image)
            if image then
                image:SetActiveE(1)
            end
        end
    )
end

