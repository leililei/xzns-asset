local base = require("BaseGameNet")

---@class ThemeTurntableNet : BaseGameNet	通信协议
local ThemeTurntableNet = _G.BaseClass("ThemeTurntableNet", base)
---@return ThemeTurntableNet ThemeTurntableNet
function ThemeTurntableNet:GetInstance()
    return  base.GetInstance(self)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function ThemeTurntableNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function ThemeTurntableNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

function ThemeTurntableNet:Draw(data,callBack)
    local item = _G.ConfigManager.net_map.game_activity_theme_port_draw
    local port = base.Access(self, item, data, _G.handler(self, self.Callback))
    self.Call[port] = callBack
end

function ThemeTurntableNet:GetAward(data,callBack)
    local item = _G.ConfigManager.net_map.game_activity_theme_port_award
    local port = base.Access(self, item, data, _G.handler(self, self.Callback))
    self.Call[port] = callBack
end

return ThemeTurntableNet