---@class ThemeTurntableAwardPreView : UIBaseView	中文描述
---@field public go_table ThemeTurntableAwardPreView_GoTable GoTable
local ThemeTurntableAwardPreView = _G.BaseClass("ThemeTurntableAwardPreView", _G.UIBaseView)
local GetAutoGoTable = _G.GetAutoGoTable
local StorageManager
function ThemeTurntableAwardPreView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ThemeTurntableAwardPreView:OnCreate(data)
    StorageManager = _G.StorageManager:GetInstance()
    local list = data
    _G.SortList(list,function(a)
        return -a.index
    end)
    self.turntabelList = list
    self.count = 0
    for k,v in pairs(self.turntabelList) do
        self.count = self.count + v.weight
    end
    self.go_table.scrollloopvectical_AwardList:InitItemData(#self.turntabelList,_G.handler(self, self.RefreshList))
end

function ThemeTurntableAwardPreView:RefreshList(index,obj)
    local newIndex = index + 1
    local data = self.turntabelList[newIndex]
    local tb = GetAutoGoTable(obj)
    tb.obj_Root:RemoveAllChildren()
    StorageManager:GetItemBaseViewNew(
        {data.sid,data.num},
        tb.obj_Root,
        function(trans)
            if _G.IsNil(tb.obj_Root) then
               return 
            end

            trans:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end
    )
    local weight = data.weight/self.count*100
    weight = string.format("%.2f", weight)
    tb.aortext_probNum.text = weight .. "%"
end

---界面的销毁函数
function ThemeTurntableAwardPreView:OnDestroy()
end

---按钮点击事件在这里派发
function ThemeTurntableAwardPreView:OnClickBtn(go)
    self:Close()
end

return ThemeTurntableAwardPreView