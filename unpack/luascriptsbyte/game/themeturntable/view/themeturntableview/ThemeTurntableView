local insert = _G.table.insert
function ThemeTurntableView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ThemeTurntableView:OnCreate()
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_ThemeTurntableVie_bg, self.go_table.obj_effect)
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_ThemeTurntableView_choose,
        self.go_table.obj_effectSelect
    )
    ThemeTurntableModel = require("ThemeTurntableModel"):GetInstance()
    StorageManager = _G.StorageManager:GetInstance()
    self.turntabelList = ThemeTurntableModel:GetTurntableList()
    self.awardList = ThemeTurntableModel:GetAwardList()
    self.point = ThemeTurntableModel:GetPoint()
    self.takenIndex = ThemeTurntableModel:GetTakenIndex()
    self.drawCost = ThemeTurntableModel:GetDrawCost()
    --self.nextScore = ThemeTurntableModel:GetNextTarget()
    self.playAnim = _G.PlayerPrefsManager.GetInt("ThemeTurntable", 1)
    self.animEnd = true
    self.go_table.obj_anim:SetLocalPosition(togglePosx[self.playAnim], -10.4, 0)
    self.go_table.aortext_anim.text = GetLangPackValue(toggleText[self.playAnim])
    self.curItem = self.go_table.aorrawimage_left
    self.nextItem = self.go_table.aorrawimage_right
    self.nextItem:SetLocalScaleXYZ(0.6)
    if not _G.table.isEmptyOrNil(_G.ConfigManager.ui_cfg.ThemeTurntableView.resources) then
        self:AddComponent(
            self.go_table.obj_gold,
            require("ResourceCompont").New(self.go_table.obj_gold, _G.ConfigManager.ui_cfg.ThemeTurntableView.resources)
        )
    end
    self.coinCount = require "DrawActivityModel":GetInstance():GetCoinNum()
    self:UpdateShowList()
    self.curIndex = 1
    self.coinSid = require("ThemeActivityManager"):GetInstance():GetCoinSid()
    self:InitView()
end

---界面的销毁函数
function ThemeTurntableView:OnDestroy()
    self:StopTimeCall()
    self:StopShowTimer()
    self:StopAnimTimer()
end

---按钮点击事件在这里派发
function ThemeTurntableView:OnClickBtn(go)
    if go == self.go_table.aorbtn_before then
        self:ChangeFinalAward(-1)
    elseif go == self.go_table.aorbtn_next then
        self:ChangeFinalAward(1)
    elseif go == self.go_table.aorbtn_DrawOnce then
        self:Draw(_G.DrawType.once)
    elseif go == self.go_table.aorbtn_DrawTen then
        self:Draw(_G.DrawType.TenTimes)
    elseif go == self.go_table.aorbtn_preview then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ThemeTurntableAwardPreView.Name,
            self.turntabelList
        )
    elseif go == self.go_table.aorbtn_pointer then
        self:ToggleAnim()
    elseif go == self.go_table.aorbtn_CloseView then
        self:CloseView()
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 108)
    end
end

---初始化界面
function ThemeTurntableView:InitView()
    self:InitItemList()
    self:InitTurntable()
    self:ShowFinalAward()
    self:InitDiamondTimes()
    self:InitConsumesInfos()
    self:SetTipInfo()
    self.showTimer = _G.TimerManager:GetInstance():GetTimer(delayTime, self.ShwoNext, self, true, false, true)
    self.showTimer:Start()
    str1 = GetLangPackValue(90022500595)
    self.times = require "ThemeActivityManager":GetInstance():GetRTS()
    local str = _G.TimeUtil.TranslateSecondForStr(self.times)
    self.go_table.aortext_time.text = str1 .. str
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.TimeCall, self, false, false, true)
    self.timer:Start()
end

---初始化按钮的消耗信息
function ThemeTurntableView:InitConsumesInfos()
    --获取魂玉召唤总次数
    local totalTimes = ThemeTurntableModel.rmb_draw_info[4] or 0
    ---魂玉剩余次数
    local remainTimes = totalTimes - ThemeTurntableModel.diamond_times
    local rmbDrawInfo = ThemeTurntableModel.rmb_draw_info
    ---按钮
    local leftIcon, leftNum, rightIcon, rightNum
    self.drawConsumeType = _G.DrawConsumeType.token
    if self.coinCount >= 1 or remainTimes < 1 then
        leftNum = self.drawCost
        leftIcon = _G.ConfigManager.currency_type_client_cfg[self.coinSid].icon
    else
        leftNum = rmbDrawInfo[1]
        leftIcon = _G.StorageManager:GetInstance():GetItemIcon(_G.ResPropID.Diamond)
        self.onceConsumeType = _G.DrawConsumeType.diamond
    end
    self.go_table.aortext_oneNum.text = leftNum
    self.go_table.aorrawimage_one:LoadImage(
        leftIcon,
        function(image)
            if image then
                image:SetActiveE(1)
            end
        end
    )

    ---右边按钮
    local rightShowNum = 10
    if self.coinCount >= 1 or remainTimes < 10 then
        rightIcon = _G.ConfigManager.currency_type_client_cfg[self.coinSid].icon
        if self.coinCount > 0 and self.coinCount < 10 * self.drawCost then
            rightShowNum = _G.Mathf.Floor(self.coinCount / self.drawCost)
        end
        rightNum = self.drawCost * rightShowNum
        local showTimes = self.coinCount
        if self.coinCount >= 10 or self.coinCount <= 0 then
            showTimes = 10
        end
        self.go_table.obj_discount:SetActiveE(0)
    else
        rightNum = rmbDrawInfo[2]
        rightIcon = _G.StorageManager:GetInstance():GetItemIcon(_G.ResPropID.Diamond)
        self.go_table.obj_discount:SetActiveE(1)
        self.go_table.aortext_discount.text =
            _G.GetLangPackValue(90028800006, _G.string.format("%.1f", rmbDrawInfo[3] / 10000 * 10))
        self.onceConsumeType = _G.DrawConsumeType.diamond
    end

    self.go_table.aortext_ten.text = _G.GetLangPackValue(90028900013, _G.GameUtil.NumberToWordByLanguage(rightShowNum))
    self.go_table.aortext_TenNum.text = rightNum
    self.go_table.aorrawimage_ten:LoadImage(
        rightIcon,
        function(image)
            if image then
                image:SetActiveE(1)
            end
        end
    )
end

---初始化魂玉次数
function ThemeTurntableView:InitDiamondTimes()
    local totalTimes = ThemeTurntableModel.rmb_draw_info[4] or 0
    self.go_table.obj_diamondTimes:SetActiveE(totalTimes > 0 and 1 or 0)
    if totalTimes <= 0 then
        return
    end

    self.go_table.aortext_remainDiamondTimes.text =
        _G.GetLangPackValue(90022300102, (totalTimes - ThemeTurntableModel.diamond_times) .. "/" .. totalTimes)
end

---设置概率提示
function ThemeTurntableView:SetTipInfo()
    local firstAward = ThemeTurntableModel.bigAward
    self.go_table.aortext_awardNum.text =
        _G.GetLangPackValue(
        "90029300005",
        ThemeTurntableModel:GetInitTimes() - ThemeTurntableModel.draw_num,
        _G.StorageManager:GetInstance():GetItemName(firstAward.sid)
    )
end

---初始化转盘
function ThemeTurntableView:InitTurntable()
    for k, v in pairs(self.turntabelList) do
        local item = InstantiateObject(self.go_table.obj_turntableItem, self.go_table.obj_turntable)
        local tb = GetAutoGoTable(item)
        tb.gameObject:SetLocalPositionToZero()
        StorageManager:GetItemBaseViewNew(
            {v.sid, v.num},
            tb.obj_item,
            function(tran)
                tran.gameObject:SetLocalScaleXYZ(0.7)
                tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                if k % 3 == 0 then
                    tran:ShowEffect(true)
                end
            end
        )
        local rotationz = -30 * v.index + 30
        local qt = Quaternion.Euler(0, 0, rotationz)
        tb.obj_panel:SetLocalRotation(qt.x, qt.y, qt.z, qt.w)
        tb.obj_item:SetLocalRotation(qt.x, qt.y, -qt.z, qt.w)
    end
end

---初始化累计奖励
function ThemeTurntableView:InitItemList()
    self.go_table.aortext_pointnum.text = self.point
    if not self.init then
        local index = self.takenIndex < #self.awardList and self.takenIndex or 0
        self.go_table.scrollloophorizontal_itemList:InitItemData(
            #self.awardList,
            _G.handler(self, self.RefreshList),
            index
        )
        self.init = true
    else
        self.go_table.scrollloophorizontal_itemList:UpdateAllItem()
    end
end

---刷新界面
function ThemeTurntableView:RefreshList(index, obj)
    local newIndex = index + 1
    local tb = GetAutoGoTable(obj)
    local data = self.awardList[newIndex]
    tb.obj_node:RemoveAllChildren()
    StorageManager:GetItemBaseViewNew(
        {data.sid, data.num},
        tb.obj_node,
        function(tran)
            tran.gameObject:SetLocalScaleXYZ(0.95)
            if data.index <= self.takenIndex then
                tran:SetGou(true)
            else
                if data.condition <= self.point then
                    tran:ShowEffect()
                    self.cantake = true
                end
            end
            tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end,
        _G.handler(
            self,
            function()
                self:GetAward(tb, data)
            end
        )
    )
    tb.aortext_condition.text = data.condition
end

---抽奖
function ThemeTurntableView:Draw(type)
    if not self.draw then
        local totalTimes = ThemeTurntableModel.rmb_draw_info[4] or 0
        local remainTimes = totalTimes - ThemeTurntableModel.diamond_times

        local num = 0
        if self.onceConsumeType == _G.DrawConsumeType.diamond then
            num = type == _G.DrawType.once and 1 or 10
        else
            local ten = self.coinCount >= self.drawCost * 10 and 10 or _G.Mathf.Floor(self.coinCount / self.drawCost)
            num = type == _G.DrawType.once and 1 or ten
        end
        local num1 = type == _G.DrawType.once and 1 or 10
        ---@field consumeType number 消耗模式: 1活动代币 2魂玉
        local consumeType = 1
        if self.coinCount >= self.drawCost or totalTimes == 0 or remainTimes < num1 then
            --代币数量
            if self.coinCount <= 0 or self.coinCount < self.drawCost * num then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.coinSid)
                return
            end
            consumeType = _G.DrawConsumeType.token
        else
            --检查魂玉数量
            local consumeNum = 0
            if type == _G.DrawType.once then
                consumeNum = ThemeTurntableModel.rmb_draw_info[1]
            else
                consumeNum = ThemeTurntableModel.rmb_draw_info[2]
            end
            local ownNum = _G.StorageManager:GetInstance():GetItemCountBySid(_G.ResPropID.Diamond)
            if ownNum < consumeNum then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ResPropID.Diamond)
                return
            end
            consumeType = _G.DrawConsumeType.diamond
        end
        self.draw = true
        ThemeTurntableModel:Draw(num, consumeType, _G.handler(self, self.DrawCall))
    end
end

---抽奖回调
function ThemeTurntableView:DrawCall(data)
    self.drawData = data
    if self.playAnim == 1 then
        self:PlayAnim()
    else
        local rotationz = -30 * (self.drawData.index - 1)
        local qt = Quaternion.Euler(0, 0, rotationz)
        self.go_table.obj_select:SetLocalRotation(qt.x, qt.y, qt.z, qt.w)
        self:ReceiveAward()
    end
end

