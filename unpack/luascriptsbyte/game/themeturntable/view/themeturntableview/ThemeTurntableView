---@class ThemeTurntableView : UIBaseView	中文描述
---@field public go_table ThemeTurntableView_GoTable GoTable
local ThemeTurntableView = _G.BaseClass("ThemeTurntableView", _G.UIBaseView)
local ThemeTurntableModel
local Quaternion = _G.Quaternion
local InstantiateObject = _G.InstantiateObject
local GetAutoGoTable = _G.GetAutoGoTable
local StorageManager
local GetLangPackValue = _G.GetLangPackValue
local str1
local delayTime = _G.ConfigManager.discrete_cfg[108206][1][1] + 0.5
local togglePosx = {
    [1] = -349.2,
    [0] = -320.8
}
