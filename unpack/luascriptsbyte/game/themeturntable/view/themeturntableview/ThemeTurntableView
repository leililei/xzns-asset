function ThemeTurntableView:ReceiveAward(data)
    self:UpdateView()
    local awardData = self.drawData or data
    _G.StorageManager:GetInstance():ReceiveAwardData(awardData)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, awardData, nil, true)
    self.drawData = nil
    self.draw = false
end

---开关动画
function ThemeTurntableView:ToggleAnim()
    self.playAnim = self.playAnim == 1 and 0 or 1
    _G.PlayerPrefsManager.SetInt("ThemeTurntable", self.playAnim)
    self.go_table.obj_anim:SetLocalPosition(togglePosx[self.playAnim], -10.4, 0)
    self.go_table.aortext_anim.text = GetLangPackValue(toggleText[self.playAnim])
    if self.playAnim == 1 then
        _G.PopWindowManager:GetInstance():ShowAllTips(340602)
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(340601)
    end
end

---更改大奖预览
function ThemeTurntableView:ChangeFinalAward(add)
    if #self.showList <= 0 then
        return
    end
    if not self.animEnd then
        return
    end
    self.curIndex = self.curIndex + add
    if self.curIndex > #self.showList then
        self.curIndex = 1
    elseif self.curIndex < 1 then
        self.curIndex = #self.showList
    end
    self:PlayFinalAward(add)
end

---更新大奖显示列表
function ThemeTurntableView:UpdateShowList()
    self.showList = {}
    for k, v in pairs(self.awardList) do
        if v.index > self.takenIndex then
            insert(self.showList, v)
        end
    end
end

function ThemeTurntableView:PlayFinalAward(add)
    local item = self.nextItem
    self.nextItem = self.curItem
    self.curItem = item
    self:ShowFinalAward()
    self.animEnd = false
    if add == -1 then
        self.curItem:SetLocalPosition(itemPos["left"], 0, 0)
        self.curItem:DOLocalMoveX(itemPos["middle"], 0.5)
        self.curItem:DOScale(1, 1, 1, 0.5)
        self.nextItem:DOLocalMoveX(itemPos["right"], 0.5)
        self.nextItem:DOScale(0.6, 0.6, 0.6, 0.5):OnComplete(
            function()
                self.animEnd = true
            end
        )
        self.oldAdd = -1
    elseif add == 1 then
        self.curItem:SetLocalPosition(itemPos["right"], 0, 0)
        self.curItem:DOLocalMoveX(itemPos["middle"], 0.5)
        self.curItem:DOScale(1, 1, 1, 0.5)
        self.nextItem:DOLocalMoveX(itemPos["left"], 0.5)
        self.nextItem:DOScale(0.6, 0.6, 0.6, 0.5):OnComplete(
            function()
                self.animEnd = true
            end
        )
        self.oldAdd = 1
    end
end

---显示最终大奖
function ThemeTurntableView:ShowFinalAward()
    if #self.showList <= 0 then
        self.curItem:SetActiveE(0)
        self.go_table.aorimage_soldOut:SetActiveE(1)
        return
    end
    local item = self.showList[self.curIndex]
    local data = StorageManager:GetItemDataClass(item.sid)
    self.curItem.gameObject:RemoveAllChildren()
    self.curItem:SetActiveE(0)
    if StorageManager:CheckSidType(item.sid) == _G.StorageType.Card then
        self.curItem:LoadImage(
            "",
            function()
                self.curItem:SetActiveE(1)
            end
        )
        StorageManager:GetItemBaseViewNew(
            {data.sid, data.num},
            self.curItem.transform,
            function(tran)
                tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
        )
    else
        self.curItem:LoadImage(
            data.Icon,
            function(trans)
                trans:SetNativeSize()
                self.curItem:SetActiveE(1)
            end
        )
    end
    self.go_table.aortext_itemName.text = GetLangPackValue(data.cfg.Name) .. " X " .. item.num
end

---领奖
function ThemeTurntableView:GetAward(tb, data)
    if not self.cantake then
        local type = _G.StorageManager:GetInstance():CheckSidType(data.sid)
        if type == _G.StorageType.Card then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonIllustrationsH5View.Name, data.sid)
        else
            require("CommonTipManager"):GetInstance():OpenPropTip(tb.transform, data.sid)
        end
        return
    end
    self.cantake = false
    ThemeTurntableModel:GetAward(_G.handler(self, self.ReceiveAward))
end

---刷新界面
function ThemeTurntableView:UpdateView()
    self.point = ThemeTurntableModel:GetPoint()
    self.takenIndex = ThemeTurntableModel:GetTakenIndex()
    self.coinCount = require "DrawActivityModel":GetInstance():GetCoinNum()
    self:UpdateShowList()
    self:InitItemList()
    self:InitDiamondTimes()
    self:InitConsumesInfos()
    self:SetTipInfo()
end

---显示下一个奖励
function ThemeTurntableView:ShwoNext()
    self:StopShowTimer()
    self:ChangeFinalAward(1)
    self.showTimer = _G.TimerManager:GetInstance():GetTimer(delayTime, self.ShwoNext, self, true, false, true)
    self.showTimer:Start()
end

---暂停滚动计时
function ThemeTurntableView:StopShowTimer()
    if self.showTimer then
        self.showTimer:Stop()
        self.showTimer = nil
    end
end

---时间倒计时
function ThemeTurntableView:TimeCall(elapsed)
    self.times = self.times - elapsed
    if self.times > 0 then
        local str = _G.TimeUtil.TranslateSecondForStr(Mathf.RoundToInt(self.times))
        self.go_table.aortext_time.text = str1 .. str
    else
        self:StopTimeCall()
    end
end

---暂停时间倒计时
function ThemeTurntableView:StopTimeCall()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---关闭界面
function ThemeTurntableView:CloseView()
    self:StopTimeCall()
    self:StopShowTimer()
    self:Close()
end

---动画timer
function ThemeTurntableView:AnimTimer(data)
    local rotationz = -30 * self.animIndex
    if self.animIndex >= self.finalIndex - starReduce + Count then
        Count = Count + 1
        return
    end
    Count = 0
    self.animIndex = self.animIndex + 1
    if self.animIndex >= self.finalIndex then
        self:StopAnimTimer()
        _G.DelayDo(0.2, _G.handler(self, self.ReceiveAward))
    elseif self.animIndex == 12 then
        self:StopAnimTimer()
        self.animTimer = _G.TimerManager:GetInstance():GetTimer(timeInterval[2], self.AnimTimer, self, false)
        self.animTimer:Start()
    elseif self.animIndex == 24 then
        self:StopAnimTimer()
        self.animTimer = _G.TimerManager:GetInstance():GetTimer(timeInterval[3], self.AnimTimer, self, false)
        self.animTimer:Start()
    end
    local qt = Quaternion.Euler(0, 0, rotationz)
    self.go_table.obj_select:SetLocalRotation(qt.x, qt.y, qt.z, qt.w)
end

function ThemeTurntableView:StopAnimTimer()
    if self.animTimer then
        self.animTimer:Stop()
        self.animTimer = nil
    end
end

return ThemeTurntableView
