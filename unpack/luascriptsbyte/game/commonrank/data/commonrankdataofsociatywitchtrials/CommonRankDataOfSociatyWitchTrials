local base = require("CommonRankData")

---@class CommonRankDataOfSociatyWitchTrials : CommonRankData	公会试炼排行榜
---@field data number                                  @伤害值
---@field dataDescript string
local CommonRankDataOfSociatyWitchTrials = _G.BaseClass("CommonRankDataOfSociatyWitchTrials", base)

---解析数据
---@param data {dps:number, role: SociatyMemberBase}
function CommonRankDataOfSociatyWitchTrials:Parse(data)
    self.dataDescript = nil
    self.data = data.dps
    ---@type role.i_role
    self.role = {
        uid = data.role.Uid,
        name = data.role.Name,
        frame = data.role.frame,
        title = data.role.title,
        style = data.role.style,
        level = data.role.lv,
        power = data.role.Power,
    }
end

---获取数据文本描述
function CommonRankDataOfSociatyWitchTrials:GetData()
    return self.data
end

---获取数据文本描述
function CommonRankDataOfSociatyWitchTrials:GetDataDescript()
    if self.dataDescript then
        return self.dataDescript
    end
    local cfg = _G.ConfigManager.rank_zone_cfg[_G.ZoneRankType.SociatyWitchTrials]
    if cfg and cfg.title and cfg.title[3] then
        self.dataDescript = _G.GetLangPackValue(cfg.title[3]) .. _G.GameUtil.NumberToUnitStr(self.data or 0)
    else
        self.dataDescript = _G.GameUtil.NumberToUnitStr(self.data or 0)
    end
    return self.dataDescript
end

---和另一条数据进行比较
---@param other CommonRankData
---@return number       @-1 小于 0 等于 1 大于
function CommonRankDataOfSociatyWitchTrials:CompareTo(other)
    if not other or self.data > other.data then
        return 1
    end
    if self.data < other.data then
        return -1
    end
    return 0
end

---解析公会成员列表
---@return CommonRankDataOfSociatyWitchTrials[]
function CommonRankDataOfSociatyWitchTrials.ParseRanks(data)
    local results = {}
    if data then
        for rank, d in ipairs(data) do
            ---@type CommonRankDataOfSociatyWitchTrials
            local v = CommonRankDataOfSociatyWitchTrials.New()
            v.rank = rank
            v:Parse(d)
            table.insert(results, v)
        end
    end
    return results
end

---解析自己的数据
---@param rank number
---@param data number
---@return CommonRankDataOfSociatyWitchTrials
function CommonRankDataOfSociatyWitchTrials.ParseSelfRank(rank, data)
    ---@type CommonRankDataOfSociatyWitchTrials
    local v = CommonRankDataOfSociatyWitchTrials.New()
    v.rank = rank
    v.data = data
    v.role = _G.PlayerModel:GetInstance():GetIRroleTable()
    return v
end

return CommonRankDataOfSociatyWitchTrials
