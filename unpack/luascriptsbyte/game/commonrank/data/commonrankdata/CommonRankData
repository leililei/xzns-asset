---@class CommonRankData	默认排行榜数据
---@field rank number                               @排名信息
---@field role role.i_role                          @角色信息
---@field data any                                  @数据信息
local CommonRankData = _G.BaseClass("CommonRankData")

---类的构造函数
function CommonRankData:__init()
    self.rank = 0
end

---类的析构函数
function CommonRankData:Dispose()
    self.rank = nil
    self.role = nil
    self.data = nil
end

---解析数据
---@param data any
---@return void
function CommonRankData:Parse(data)
end

---获取角色排名
---@retrun number
function CommonRankData:GetRank()
    return self.rank
end

---获取角色信息
---@return role.i_role
function CommonRankData:GetRoleInfo()
    return self.role
end

---获取数据文本描述
---@return any
function CommonRankData:GetData()
    return self.data
end

---获取数据文本描述
---@return string
function CommonRankData:GetDataDescript()
    return tostring(self.data)
end

---获取数据文本描述(前三时)
---@return string
function CommonRankData:GetTopDataDescript()
    return self:GetDataDescript()
end

---和另一条数据进行比较
---@param other CommonRankData
---@return number       @-1 小于 0 等于 1 大于
function CommonRankData:CompareTo(other)
    if not other then
        return 1
    end
    return 0
end

return CommonRankData
