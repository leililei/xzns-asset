local baseView = require("CommonRankBasePanel")

local table = _G.table
---@type string[] 前三排名图标
local RANK_ICON_IMAGES = {
    "tz_qjhs_phb_mingci_01",
    "tz_qjhs_phb_mingci_02",
    "tz_qjhs_phb_mingci_03"
}
---@type numebr 玩家模型展示数量
local TOP_PLAYER_COUNT = 3

---@class CommonRankHellGuardPanel : CommonRankBasePanel	中文描述
---@field public go_table CommonRankHellGuardPanel_GoTable GoTable
local CommonRankHellGuardPanel = _G.BaseClass("CommonRankHellGuardPanel", baseView)

function CommonRankHellGuardPanel:OnInitParams()
    self.itemPath = "UI/CommonRank/$_obj_CommonRankHellGuard"
    self.rankTgLis = {}
    ---7天前显示单榜，7天后显示单榜和总榜
    self.initRankParam = {
        type = 1,
        title = 90029400128,
        tip = nil,
        func = self.InitSingleRank,
        itemName = "obj_rank",
        selfName = "obj_rankSelf",
        rolse = {},
        hideSelf = false
    }
    self.rankTgLis = {self.initRankParam}
    if require("ZoneRankModel"):GetInstance():CheckIsOpen(_G.ZoneRankType.HellGuard) then
        self.sysType = _G.ZoneRankType.HellGuard
        local zoneRankParam = {
            type = 2,
            title = 90029400128,
            tip = nil,
            func = self.OnZoneRank,
            itemName = "",
            selfName = "",
            rolse = {},
            hideSelf = true
        }
        _G.table.insert(self.rankTgLis, zoneRankParam)
    end
    
    self.awardTgLis = {}
end

---拉取数据回调
---@param tb _obj_main._obj_scrollPrefab_GoTable
---@param data rank.s2c_rank_guard
function CommonRankHellGuardPanel:GetRankDataSucessCall(tb, data)
    for k, v in ipairs(data.guard_rank) do
        v.uid = v.role_info.uid
    end
    local rankList, index = self:CheckRankList(data.guard_rank or {}, self.MineRankInfo, "diff", "kill_num")
    self.rankList = rankList
    self.MineRankInfo.index = index
    local itemAmount = #self.rankList
    tb.scrollloopvectical_listBase:InitItemData(
        itemAmount, 
        _G.handler(self, self.RefreshRankItem)
    )

    local pbData = {roles = {}}
    ---@type RankTop3Role[]
    local roles = {}
    if itemAmount > 0 then
        for i = 1, TOP_PLAYER_COUNT do
            local info = self.rankList[i]
            if info then
                table.insert(pbData.roles, info.role_info.uid)
                table.insert(roles, {
                    sid = 0,
                    uid = info.role_info.uid,
                    name = info.role_info.name,
                    score = _G.GetLangPackValue(90029400148) .. info.diff .. "/" .. info.kill_num
                })
            else
                table.insert(roles, {sid = 0})
            end
        end
        self.initRankParam.roles = roles
        self:GetRoleStyle(pbData, roles)
    else
        for i = 1, TOP_PLAYER_COUNT do
            roles[i] = {sid = 0}
        end
        self.initRankParam.roles = roles
        self:OnInitRankEnd()
    end
end

---初始化单榜
---@param tb _obj_main._obj_scrollPrefab_GoTable
function CommonRankHellGuardPanel:InitSingleRank(tb)
    self.rankItemList = {}
    self.diff = require("HellGuardModel"):GetInstance().infoData.role_fight_sid
    self.kill_num = require("HellGuardModel"):GetInstance().infoData.role_kill_num

    require("HellGuardModel"):GetInstance():GetPlayerRank(
        function(msg)
            if msg.ack == 1 then
                local playerModel = _G.PlayerModel:GetInstance()
                local playerData = {}
                playerData.frame = playerModel:GetCurFrame()
                playerData.style = playerModel:GetRoleStyle()
                playerData.uid = playerModel:GetPlayerUid()
                playerData.lv = playerModel:GetLevel()
                playerData.title = playerModel:GetTitle()
                playerData.name = playerModel:GetName()

                self.MineRankInfo = {uid = playerModel:GetPlayerUid(), diff = msg.values[1], kill_num = msg.values[2], index = msg.index, role_info = playerData}
                self:CheckPlayerInfo(self.MineRankInfo, "diff", self.diff, "kill_num", self.kill_num)
                require("HellGuardModel"):GetInstance():GetRank(
                    function(data)
                        self:GetRankDataSucessCall(tb, data)
                        self:InitMineRankInfo(tb.obj_player)
                    end
                )
            end
        end
    )
end

---刷新排行榜
function CommonRankHellGuardPanel:RefreshRankItem(index, obj)
    local newIndex = index + 1
    local tb = self.rankItemList[obj:GetInstanceIDE()]
    if not tb then
        tb = _G.GetAutoGoTable(obj:GetChildE(obj:GetChildCountE() - 1))
        self.rankItemList[obj:GetInstanceIDE()] = tb
    end
    --排名
    if newIndex > 3 then
        tb.aortext_rank.text = newIndex
    elseif newIndex >= 1 then
        tb.aortext_rank.text = ""
        tb.aorimage_rank.SpriteName = RANK_ICON_IMAGES[newIndex]
    end
    tb.aorimage_rank:SetActiveE(newIndex <= 3 and 1 or 0)
    --头像
    local data = self.rankList[newIndex]
    tb.aortext_name.text = data.role_info.name
    tb.aortext_score.text = _G.GetLangPackValue(90029400148) .. data.diff .. "/" .. data.kill_num
    _G.UIUtils.SetPlayerHeadItemNew(
        tb.obj_HeadItemBase,
        data.role_info,
        0.45,
        true,
        true,
        false
    )
end

---初始化自己的排名
---@param obj obj_player
---@param data table {难度， 击杀数}
---@param index number 排名
function CommonRankHellGuardPanel:InitMineRankInfo(obj)
    local data = self.MineRankInfo
    local index = data.index or 0
    local obj1 = obj:GetChildE(obj:GetChildCountE() - 1)
    local tb = _G.GetAutoGoTable(obj1)
    tb.aortext_noRank:SetActiveE(index == 0 and 1 or 0)
    tb.obj_rank:SetActiveE(index == 0 and 0 or 1)
    tb.aortext_rank.text = _G.LangUtil.GetLangPackValue(index)
    local playerData = _G.PlayerModel:GetInstance():GetIRroleTable()
    tb.aortext_name.text = playerData.name
    tb.aortext_score.text = _G.GetLangPackValue(90029400148) .. data.diff .. "/" .. data.kill_num
    _G.UIUtils.SetPlayerHeadItemNew(
        tb.obj_HeadItemBase, 
        playerData, 
        0.45, 
        true, 
        true, 
        false
    )
end

return CommonRankHellGuardPanel