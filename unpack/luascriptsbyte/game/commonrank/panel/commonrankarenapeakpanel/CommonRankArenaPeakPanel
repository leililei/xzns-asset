local ArenaPeakModel = require("ArenaPeakModel")
local CommonRankNet = require("CommonRankNet")

---@class CommonRankArenaPeakPanel : CommonRankBasePanel	中文描述
---@field public go_table CommonRankView._obj_main_GoTable GoTable
local CommonRankArenaPeakPanel = _G.BaseClass("CommonRankArenaPeakPanel", require("CommonRankBasePanel"))

local GetAutoGoTable = _G.GetAutoGoTable

function CommonRankArenaPeakPanel:OnInitParams()
    self.itemPath = "UI/CommonRank/$_obj_CommonRankArenaPeak"
    self.rankTgLis = {
        {
            type = 1,
            title = 90029400109,
            tip = nil,
            func = self.OnRank,
            itemName = "obj_rank",
            selfName = "obj_rankSelf",
            roles = {},
            hideSelf = false
        }
    }
    self.awardTgLis = {
        {
            label = 90022100023,
            type = 1,
            title = 90029400106,
            tip = 90029400107,
            func = self.OnSeasonAward,
            itemName = "obj_seasonAward",
            selfName = "obj_seasonAwardSelf",
            hideSelf = false
        },
        {
            label = 90022100024,
            type = 1,
            title = 90029400106,
            tip = 90029400154,
            func = self.OnRankAward,
            itemName = "obj_rankAward",
            selfName = "obj_rankAwardSelf",
            hideSelf = false
        }
    }
    self.stageId = ArenaPeakModel:GetInstance().danID
end

---@param tb _obj_main._obj_scrollPrefab_GoTable
function CommonRankArenaPeakPanel:OnRank(tb)
    ---@param data arena_peak.s2c_arena_peak_rank
    require "ArenaPeakNet":GetInstance():GetRank(
        function(data)
            self.rankList = data.rank_list or {}
            -- for k, v in ipairs(self.rankList) do
            --     v.uid = v.role_info.uid
            -- end
            -- local playerInfo = {uid = _G.PlayerModel:GetInstance():GetPlayerUid(), score = require("ArenaPeakModel"):GetInstance():GetScore()}
            -- self.rankList, data.rank_num = self:CheckRankList(self.rankList, playerInfo, "score")
            tb.scrollloopvectical_listBase:InitItemData(#self.rankList, _G.handler(self, self.RefreshRankItem))
            self:InitRankPlayer(tb.obj_player, data.rank_num)
            local pbData = {roles = {}}
            local roles = {}
            local info
            for i = 1, 3 do
                info = self.rankList[i]
                if info then
                    _G.table.insert(pbData.roles, info.role_info.uid)
                    _G.table.insert(
                        roles,
                        {
                            sid = 0,
                            uid = info.role_info.uid,
                            name = info.role_info.name,
                            score = _G.GetLangPackValue(90030700030, info.score)
                        }
                    )
                else
                    _G.table.insert(roles, {sid = 0})
                end
            end
            self.rankTgLis[1].roles = roles
            self:GetRoleStyle(pbData, roles)
        end
    )
end

---刷新排行榜
function CommonRankArenaPeakPanel:RefreshRankItem(index, obj)
    local obj1 = obj:GetChildE(obj:GetChildCountE() - 1)
    ---@type _obj_CommonRankArenaPeak._obj_rank_GoTable
    local tb = GetAutoGoTable(obj1)
    index = index + 1
    tb.aorimage_rank:SetActiveE(index <= 3 and 1 or 0)
    tb.aortext_rank:SetActiveE(index <= 3 and 0 or 1)
    if index <= 3 then
        tb.aorimage_rank.SpriteName = "tz_qjhs_phb_mingci_0" .. index
    else
        tb.aortext_rank.text = index
    end
    local data = self.rankList[index]
    tb.aortext_name.text = data.role_info.name
    tb.aortext_score.text = _G.GetLangPackValue(90030700030, data.score)
    ArenaPeakModel:GetInstance():ShowDan(obj1, data.score, true, data.is_king)
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data.role_info, 0.45, true, false, false, function() end)
end

function CommonRankArenaPeakPanel:InitRankPlayer(obj, index)
    self.selfRank = index
    local obj1 = obj:GetChildE(obj:GetChildCountE() - 1)
    ---@type _obj_CommonRankArenaPeak._obj_rankSelf_GoTable
    local tb = GetAutoGoTable(obj1)
    tb.aortext_noRank:SetActiveE(index == 0 and 1 or 0)
    tb.obj_rank:SetActiveE(index == 0 and 0 or 1)
    tb.aortext_rank.text = _G.LangUtil.GetLangPackValue(index)
    local data = _G.PlayerModel:GetInstance():GetIRroleTable()
    tb.aortext_name.text = data.name
    local score = ArenaPeakModel:GetInstance():GetScore()
    tb.aortext_score.text = _G.GetLangPackValue(90030700030, score)
    ArenaPeakModel:GetInstance():ShowDan(obj1, score, true, ArenaPeakModel:GetInstance().isKing)
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data, 0.45, true, true, false, function() end)
end

---@param tb _obj_main._obj_scrollPrefab_GoTable
function CommonRankArenaPeakPanel:OnSeasonAward(tb)
    self.rewardList = _G.ConfigManager.arena_peak_league_cfg
    self.rewards = {}
    local seasonCfg = ArenaPeakModel:GetInstance():GetCfg()
    for _, v in pairs(seasonCfg.reward_season) do
        self.rewards[v[1]] = v[2]
    end
    self.count = #self.rewardList
    tb.scrollloopvectical_listBase:InitItemData(self.count, _G.handler(self, self.RefreshAwardItem))
    self:InitSeasonAwardPlayer(tb.obj_player)
end

function CommonRankArenaPeakPanel:RefreshAwardItem(index, obj)
    local obj1 = obj:GetChildE(obj:GetChildCountE() - 1)
    ---@type _obj_CommonRankArenaPeak._obj_seasonAward_GoTable
    local tb = GetAutoGoTable(obj1)
    local cfg = self.rewardList[self.count - index]
    tb.aortext_score.text = cfg.min_score
    if cfg.rank_con > 0 then
        tb.aortext_score.text = cfg.min_score .. "\n" .. _G.GetLangPackValue(90029400057, cfg.rank_con)
    end
    ArenaPeakModel:GetInstance():ShowDan(obj1, nil, true, nil, cfg.id)

    tb.rewards = _G.ConfigManager.arena_peak_tier_cfg[self.rewards[self.count - index]].reward_season
    if not tb.init then
        tb.scrollloophorizontal_award:InitItemData(#tb.rewards, _G.handlerbind(self, self.RefreshSingleAward, tb))
        tb.init = true
    else
        tb.scrollloophorizontal_award:UpdateCount(#tb.rewards)
    end
    -- tb.obj_cur:SetActiveE(self.stageId == cfg.id and 1 or 0)
end

function CommonRankArenaPeakPanel:RefreshSingleAward(index, obj, pTb)
    index = index + 1
    ---@type _obj_seasonAward._obj_awardItem_GoTable
    local tb = GetAutoGoTable(obj)
    local award = {} ---操作配置表有报错
    for _, v in pairs(pTb.rewards[index]) do
        _G.table.insert(award, v)
    end
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        award,
        tb.obj_award,
        function(item)
            if _G.IsNil(self.go_table) then
                _G.DestroyObject(item.gameObject)
                return
            end
            if item.ShowNumText then
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
        end
    )
end

function CommonRankArenaPeakPanel:InitSeasonAwardPlayer(obj)
    local obj1 = obj:GetChildE(obj:GetChildCountE() - 1)
    ---@type _obj_CommonRankArenaPeak._obj_seasonAwardSelf_GoTable
    local tb = GetAutoGoTable(obj1)
    local cfg = self.rewardList[self.stageId]
    tb.aortext_score.text = _G.GetLangPackValue(cfg.name)
    ArenaPeakModel:GetInstance():ShowDan(obj1, nil, true, nil, cfg.id)
    tb.rewards = _G.ConfigManager.arena_peak_tier_cfg[self.rewards[self.stageId]].reward_season
    if not tb.init then
        tb.scrollloophorizontal_award:InitItemData(#tb.rewards, _G.handlerbind(self, self.RefreshSingleAward, tb))
        tb.init = true
    else
        tb:UpdateCount(#tb.rewards)
    end
end

---排行奖励
function CommonRankArenaPeakPanel:OnRankAward(tb)
    local seasonID = ArenaPeakModel:GetInstance():GetCurSeasonID()
    self.rankRewardList = _G.ConfigManager.arena_peak_cfg[seasonID].reward_rank[1]
    tb.scrollloopvectical_listBase:InitItemData(#self.rankRewardList, _G.handler(self, self.RefreshRankReward))
    self:RefreshSelfRankReward(tb.obj_player, _G.ConfigManager.arena_peak_cfg[seasonID].reward_finish)
end

---刷新奖励
function CommonRankArenaPeakPanel:RefreshRankReward(index, obj)
    local newindex = index + 1
    local obj1 = obj:GetChildE(obj:GetChildCountE() - 1)
    local tb = _G.GetAutoGoTable(obj1)
    ---@type boss_rank_cfg
    local data = _G.ConfigManager.arena_rank_cfg[self.rankRewardList[newindex]]
    tb.data = data
    tb.aorimage_rank:SetActiveE((newindex <= 3 and data.max_rank == data.min_rank) and 1 or 0)
    local text
    if newindex <= 3 and data.max_rank == data.min_rank then
        tb.aorimage_rank.SpriteName = "tz_qjhs_phb_mingci_0" .. newindex
        text = ""
    elseif data.min_rank and data.min_rank == data.max_rank then
        text = newindex
    elseif data.ranks and data.ranks[1] and data.ranks[2] then
        text = _G.string.format("%s~%s", data.ranks[1], data.ranks[2])
    else
        text = _G.string.format("%s~%s", data.min_rank, data.max_rank)
    end
    tb.aortext_score.text = text ~= "" and _G.GetLangPackValue(90022100031, text) or ""
    if tb.data then
        self:ShowRankAward(tb, tb.obj_Award, tb.data.rewards or tb.data.reward_daily or tb.data.award)
    else
        self:ShowRankAward(tb, tb.obj_Award, {})
    end
end

function CommonRankArenaPeakPanel:ShowRankAward(tb, obj, award)
    if not tb.list then
        tb.list = {}
    end
    local count = #tb.list
    local count2 = #award
    for i = 1, count do
        if i <= count2 then
            tb.list[i]:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(award[i]))
            tb.list[i].gameObject:SetActiveE(1)
        else
            tb.list[i].gameObject:SetActiveE(0)
        end
    end
    if count < count2 then
        for i = count + 1, count2 do
            local obj2 = _G.InstantiateObject(obj)
            obj2:SetParentE(tb.trans_Content)
            local item = require "BaseAwardNewItem".New(obj2, nil, 58, obj2:GetChildE(0))
            tb.list[i] = item
            local data = award[i]
            if data.type then
                data = data.type
            end
            item:Show(
                _G.StorageManager:GetInstance():GetItemDataClassByCfg(data),
                function()
                    -- item.item:ShowEffectOrder(true)
                end
            )
            item.gameObject:SetActiveE(1)
        end
    end
end

function CommonRankArenaPeakPanel:RefreshSelfRankReward(obj, rewards)
    local index = self.selfRank or 0
    local obj1 = obj:GetChildE(obj:GetChildCountE() - 1)
    ---@type _obj_CommonRankArenaPeak._obj_seasonAwardSelf_GoTable
    local tb = GetAutoGoTable(obj1)
    tb.aortext_noRank:SetActiveE(index == 0 and 1 or 0)
    tb.obj_rank:SetActiveE(index == 0 and 0 or 1)
    tb.aortext_rank.text = _G.LangUtil.GetLangPackValue(index)

    local reward = rewards
    for _, v in ipairs(self.rankRewardList) do
        local cfg = _G.ConfigManager.arena_rank_cfg[v]
        if
            (cfg.min_rank == cfg.max_rank and index == cfg.min_rank) or
                (cfg.min_rank ~= cfg.max_rank and index <= cfg.max_rank and index >= cfg.min_rank)
         then
            reward = cfg.reward_daily
            break
        end
    end

    if reward then
        self:ShowRankAward(tb, tb.obj_Award, reward)
    else
        self:ShowRankAward(tb, tb.obj_Award, {})
    end
end

return CommonRankArenaPeakPanel
