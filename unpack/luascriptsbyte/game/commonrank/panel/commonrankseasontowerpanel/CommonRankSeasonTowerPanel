local CommonRankNet = require("CommonRankNet")
local ZoneRankModel = require("ZoneRankModel")
local SeasonTowerModel = require("SeasonTowerModel")

---@field public go_table CommonRankSeasonTowerPanel_GoTable GoTable
local CommonRankSeasonTowerPanel = _G.BaseClass("CommonRankSeasonTowerPanel", require("CommonRankBasePanel"))

local rankIcon = {
    [1] = "0ui_icon_diyi",
    [2] = "0ui_icon_dier",
    [3] = "0ui_icon_disan"
}

function CommonRankSeasonTowerPanel:OnInitParams()
    self.itemPath = "UIH5/CommonRank/$_obj_CommonRankSeasonTower"
    self.sysType = _G.ZoneRankType.SeasonTower
    self.rankTgLis = {
        -- {
        --     type = 2,
        --     title = 90029400124,
        --     tip = 90029400123,
        --     func = self.OnZoneRank,
        --     itemName = "",
        --     selfName = "",
        --     roles = {},
        --     hideSelf = false
        -- }
    }
    -- if ZoneRankModel:GetInstance():CheckIsShowSingle(_G.ZoneRankType.SeasonTower) then
    _G.table.insert(self.rankTgLis, {
        type = 1,
        title = 90029400124,
        func = self.OnRank,
        itemName = "obj_rank",
        selfName = "obj_rankSelf",
        roles = {},
        hideSelf = false
    })
    -- end
    self.awardTgLis = {}
end

---直接开启总榜
function CommonRankSeasonTowerPanel:CheckZoneIsOpen()
    return false
end

---@param tb _obj_main._obj_scrollPrefab_GoTable
function CommonRankSeasonTowerPanel:OnRank(tb)
    ---@param data season_tower.game_rank_season_tower
    require "SeasonTowerModel":GetInstance():GetRank(
        function(data)
            self.rankList = data.ranks or {}
            tb.scrollloopvectical_listBase:InitItemData(#self.rankList, _G.handler(self, self.RefreshRankItem))
            local pbData = {roles = {}}
            local roles = {}
            local info, floor, date
            for i = 1, 3 do
                info = self.rankList[i]
                if info then
                    _G.table.insert(pbData.roles, info.role_info.uid)
                    floor = _G.GetLangPackValue(90037010103,SeasonTowerModel:GetInstance():GetFloor(info.f_id))
                    date = self:ConvertDate(info.pass_time)
                    _G.table.insert(
                        roles,
                        {
                            sid = 0,
                            uid = info.role_info.uid,
                            name = info.role_info.name,
                            score = floor .. "\n" .. date
                        }
                    )

                else
                    _G.table.insert(roles, {sid = 0})
                end
            end
            self.rankTgLis[1].roles = roles
            self:GetRoleStyle(pbData, roles)
        end
    )

    require "SeasonTowerNet":GetInstance():GetSelfRank(
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self:InitRankPlayer(tb.obj_player, msg)
        end
    )
end

---刷新排行榜
function CommonRankSeasonTowerPanel:RefreshRankItem(index, obj)
    local obj1 = obj:GetChildE(obj:GetChildCountE() - 1)
    ---@type _obj_CommonRankArenaPeak._obj_rank_GoTable
    local tb = _G.GetAutoGoTable(obj1)
    index = index + 1
    obj1:SetLocalPosition(0, 0, 0)
    tb.aorimage_rank:SetActiveE(index <= 3 and 1 or 0)
    tb.aortext_rank:SetActiveE(index <= 3 and 0 or 1)
    if index <= 3 then
        tb.aorimage_rank.SpriteName = rankIcon[index]
        for i = 1, 3 do
            tb["aortext_rankNum" .. i]:SetActiveE(index == i and 1 or 0)
        end
    else
        tb.aortext_rank.text = index
    end
    local data = self.rankList[index]
    tb.aortext_name.text = data.role_info.name
    -- _G.LogError(SeasonTowerModel:GetInstance():GetFloor(data.f_id))
    tb.aortext_score.text = _G.GetLangPackValue(90037010103,SeasonTowerModel:GetInstance():GetFloor(data.f_id))
    tb.aortext_date.text = self:ConvertDate(data.pass_time)
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data.role_info, 0.7, true, true, false)
end

function CommonRankSeasonTowerPanel:InitRankPlayer(obj, rankData)
    local obj1 = obj:GetChildE(obj:GetChildCountE() - 1)
    -- ---@type _obj_CommonRankArenaPeak._obj_rankSelf_GoTable
    local tb = _G.GetAutoGoTable(obj1)
    local index = rankData.index
    tb.aortext_noRank:SetActiveE(index == 0 and 1 or 0)
    tb.obj_rank:SetActiveE(index == 0 and 0 or 1)
    tb.aortext_rank.text = index
    tb.aortext_name.text = _G.PlayerModel:GetInstance():GetName()
    tb.aortext_score.text = _G.GetLangPackValue(90037010103,SeasonTowerModel:GetInstance():GetFloor(rankData.values[1]))
    tb.aortext_date.text = rankData.values[1] > 0 and self:ConvertDate(rankData.values[2]) or ""
    local data = _G.PlayerModel:GetInstance():GetIRroleTable()
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data, 0.7, true, true, false)
end

function CommonRankSeasonTowerPanel:ConvertDate(time)
    local date = _G.TimeUtil.GetDateTime(time)
    return _G.GetLangPackValue(90037010153, _G.string.format("%s.%s-%02d:%02d", date.month, date.day, date.hour, date.minute))
end

return CommonRankSeasonTowerPanel