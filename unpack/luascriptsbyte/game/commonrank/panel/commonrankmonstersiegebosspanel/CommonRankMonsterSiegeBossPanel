local base = require "CommonRankBasePanel"
---@class CommonRankMonsterSiegeBossPanel : UIBaseView	中文描述
---@field public go_table CommonRankMonsterSiegeBossPanel_GoTable GoTable
local CommonRankMonsterSiegeBossPanel = _G.BaseClass("CommonRankMonsterSiegeBossPanel", base)

local GetAutoGoTable = _G.GetAutoGoTable

function CommonRankMonsterSiegeBossPanel:OnInitParams()
    self.itemPath = "UIH5/CommonRank/$_obj_CommonRankWorldBoss"
    self.activeData = require "MonsterSiegeManager":GetInstance():GetActivity()
    --self.zonePlayBackBol 总榜是否显示回放按钮
    self.zonePlayBackBol = true
    local rankParam = {
        type = 1,
        title = 90029400132,
        tip = nil,
        func = self.OnRank,
        itemName = "obj_rank",
        selfName = "obj_rankSelf",
        roles = {},
        hideSelf = false
    }
    self.rankTgLis = {rankParam}
    if require "ZoneRankModel":GetInstance():CheckIsOpen(_G.ZoneRankType.MonsterSiege) then
        local zoneRankParam  = {
            type = 2,
            title = 90029400132,
            tip = nil,
            func = self.OnZoneRank,
            itemName = "obj_rank",
            selfName = "obj_rankSelf",
            roles = {},
            hideSelf = false
        }
        _G.table.insert(self.rankTgLis,zoneRankParam)
    end
    self.awardTgLis = {
        {
            label = 90029400051,
            type = 2,
            title = 90029400133,
            tip = nil,
            func = self.OnZoneAward,
            itemName = "",
            selfName = "",
            hideSelf = true
        }
    }
    self.sysType = _G.ZoneRankType.MonsterSiege
end

---@param tb _obj_main._obj_scrollPrefab_GoTable
function CommonRankMonsterSiegeBossPanel:OnRank(tb)
    local title = _G.ConfigManager.rank_zone_cfg[self.sysType].title
    self.itemTitle = title[3] and _G.GetLangPackValue(title[3])
    self.rankList = self.activeData.typeClass.rank_all_player or {}
    self.playerRank = self.activeData.typeClass:GetPlayerSelf()
    local Damage = require "MonsterSiegeManager":GetInstance():GetDps()
    self:CheckPlayerInfo(self.playerRank, "Damage", Damage)

    local rankList, index = self:CheckRankList(self.rankList or {}, self.playerRank, "Damage")
    self.rankList = rankList
    if index then
        self.playerRank.player_mingci = index
    end

    self:InitRankPlayer(tb.obj_player, self.playerRank)
    tb.scrollloopvectical_listBase:InitItemData(#self.rankList, _G.handler(self, self.RefreshRankItem))

    local pbData = {roles = {}}
    local roles = {}
    local info
    local roleTitle = _G.GetLangPackValue(_G.ConfigManager.rank_zone_cfg[self.sysType].title1)
    for i = 1, 3 do
        info = self.rankList[i]
        if info then
            _G.table.insert(pbData.roles, info.uid)
            _G.table.insert(
                roles,
                {
                    sid = 0,
                    uid = info.uid,
                    name = info.playerName,
                    score =  roleTitle.. _G.GameUtil.NumberToUnitStr(info.Damage)
                }
            )
        else
            _G.table.insert(roles, {sid = 0})
        end
    end
    self.rankTgLis[1].roles = roles
    self:GetRoleStyle(pbData, roles)
end

---刷新排行榜
function CommonRankMonsterSiegeBossPanel:RefreshRankItem(index, obj)
    index = index + 1
    local data = self.rankList[index]
    local obj1 = obj:GetChildE(obj:GetChildCountE() - 1)
    ---@type _obj_CommonRankArenaPeak._obj_rank_GoTable
    local tb = GetAutoGoTable(obj1, _G.handlerbind(self, self.OnClickPlayback, data.uid))
    tb.aorimage_rank:SetActiveE(index <= 3 and 1 or 0)
    tb.aortext_rank:SetActiveE(index <= 3 and 0 or 1)
    if data.player_mingci <= 3 then
        tb.aorimage_rank.SpriteName = "tz_qjhs_phb_mingci_0" .. index
    else
        tb.aortext_rank.text = data.player_mingci
    end
    tb.aortext_name.text = data.playerName
    tb.aortext_score.text =  self.itemTitle.._G.GameUtil.NumberToUnitStr(data.Damage)
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data, 0.45, true, true, false)
end

function CommonRankMonsterSiegeBossPanel:OnClickPlayback(go, isOn, uid)
    require "DungonesModel":GetInstance():PlayRankHuiFang(70, uid)
end

function CommonRankMonsterSiegeBossPanel:InitRankPlayer(obj, playerRank)
    local obj1 = obj:GetChildE(obj:GetChildCountE() - 1)
    local index = playerRank.player_mingci
    ---@type _obj_CommonRankArenaPeak._obj_rankSelf_GoTable
    local tb = GetAutoGoTable(obj1)
    tb.aortext_noRank:SetActiveE(index == 0 and 1 or 0)
    tb.obj_rank:SetActiveE(index == 0 and 0 or 1)
    tb.aortext_rank.text = index
    local data = _G.PlayerModel:GetInstance():GetIRroleTable()
    tb.aortext_name.text = data.name
    tb.aortext_score.text = self.itemTitle.._G.GameUtil.NumberToUnitStr(playerRank.Damage)
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data, 0.45, true, true, false)
end

function CommonRankMonsterSiegeBossPanel:GetZoneAward()
    return self.activeData.typeClass:GetRankRewardPersonData()
end

return CommonRankMonsterSiegeBossPanel