local baseView = require("CommonRankBasePanel")
---@class CommonRankDecorationBossPanel : UIBaseView	终焉之末伤害排行榜
---@field public go_table CommonRankDecorationBossPanel_GoTable GoTable
local CommonRankDecorationBossPanel = _G.BaseClass("CommonRankDecorationBossPanel", baseView)

---@type string[] 前三排名图标
local RANK_ICON_IMAGES = {
    "tz_qjhs_phb_mingci_01",
    "tz_qjhs_phb_mingci_02",
    "tz_qjhs_phb_mingci_03"
}
---排行榜前三
local TOP_PLAYER_COUNT = 3

function CommonRankDecorationBossPanel:OnCreate(parent, params)
    self.params = params
    self.itemPath = "UI/CommonRank/$_obj_CommonRankDecorationBoss"
    self.rankTgLis = {}
    self.initRankParam = {
        type = 1,
        title = 90029400194,
        tip = nil,
        func = self.InitAwardRank,
        itemName = "obj_rank",
        selfName = "obj_rankSelf",
        rolse = {},
        hideSelf = false
    }
    if self.params.type == 2 then
        self.initRankParam.tip = 90029400195
    else
        self.initRankParam.title = 90029400201
    end
    self.rankTgLis = { self.initRankParam }
    self.awardTgLis = {}
    if self.params.type == 2 then
        ---排行榜奖励
        local initRankAwardParams = {
            label = 90029400194,
            title = 90029400194,
            tip = nil,
            func = self.InitRankAward,
            itemName = "obj_rankAward",
            selfName = "obj_rankAwardSelf",
            hideSelf = true
        }
        self:GetRankAward()
        self.awardTgLis[1] = initRankAwardParams
    end
    self.rankAwardItems = {}
    self.rankItemList = {}
    ---获取排行榜数据
    self:GetRankInfo()
    self.switchPanel = self.params.switchPanel
end

---获取排行榜数据
function CommonRankDecorationBossPanel:GetRankInfo()
    require("DecorationBossModel"):GetInstance():GetRankInfo(self.params.id, self.params.type, 1,
        function(msg)
            self.rankInfo = msg or {}
            ---@type RankTop3Role[]
            local roles = {}
            local pbData = { roles = {} }
            for i = 1, TOP_PLAYER_COUNT do
                local info = self.rankInfo[i]
                if not _G.table.isEmptyOrNil(info) then
                    _G.table.insert(pbData.roles, info.role_info.uid)
                    _G.table.insert(roles, {
                        sid = 0,
                        uid = info.role_info.uid,
                        name = info.role_info.name,
                        score = _G.GetLangPackValue(90029800007) .. _G.GameUtil.NumberToUnitStrFight(info.dps)
                    })
                else
                    _G.table.insert(roles, { sid = 0 })
                end
            end
            self.initRankParam.roles = roles
            self:GetRoleStyle(pbData, roles)
            baseView.OnCreate(self)
        end
    )
end

---奖励
function CommonRankDecorationBossPanel:InitRankAward(tb)
    --初始化列表显示
    tb.scrollloopvectical_listBase:InitItemData(#self.rankAwardList, _G.handler(self, self.RefreshRankAwardItem))
end

function CommonRankDecorationBossPanel:RefreshRankAwardItem(index, obj)
    local newIndex = index + 1
    local instanceID = obj:GetInstanceIDE()
    local tb = self.rankAwardItems[instanceID]
    if not tb then
        tb = _G.GetAutoGoTable(obj:GetChildE(obj:GetChildCountE() - 1))
        self.rankAwardItems[instanceID] = tb
    end
    tb.ins = instanceID
    --排名信息
    local rankData = self.rankAwardList[newIndex]
    tb.aorimage_rank:SetActiveE(newIndex <= 3 and 1 or 0)
    tb.aortext_rank.text = ""
    if newIndex <= 3 then
        tb.aorimage_rank.SpriteName = RANK_ICON_IMAGES[newIndex]
    else
        if rankData.max_rank >= 9999 then
            tb.aortext_rank.text = _G.GetLangPackValue(90029400146, rankData.min_rank)
        elseif rankData.min_rank == rankData.max_rank then
            tb.aortext_rank.text = _G.GetLangPackValue(90029400144, rankData.min_rank)
        else
            tb.aortext_rank.text = _G.GetLangPackValue(90029400145, rankData.min_rank, rankData.max_rank)
        end
    end

    --合并奖励
    local rewards = {}
    if rankData.rewards_remove then
        local id = rankData.rewards_remove[1]
        local config = _G.ConfigManager.decoration_box_cfg[id]
        _G.table.insert(rewards, { config.item, rankData.rewards_remove[2] })
    end
    if rankData.rewards then
        for _, v in ipairs(rankData.rewards) do
            _G.table.insert(rewards, v)
        end
    end
    self:SetRankAward(rewards, tb, obj)
end

---排行榜奖励
function CommonRankDecorationBossPanel:GetRankAward()
    self.rankAwardList = {}
    local difficulty = _G.ConfigManager.decoration_boss_cfg[self.params.id].difficulty
    local cfg = _G.ConfigManager.decoration_limit_cfg[difficulty]
    local rankConfig = _G.ConfigManager.decoration_rank_cfg
    for _, v in pairs(cfg.rank) do
        _G.table.insert(self.rankAwardList, rankConfig[v])
    end
    _G.SortList(self.rankAwardList, function(item)
        return -item.min_rank
    end)
end

function CommonRankDecorationBossPanel:InitAwardRank(tb)
    tb.scrollloopvectical_listBase:InitItemData(
        #self.rankInfo,
        _G.handler(self, self.RefreshRankItem)
    )
    self.scrollloopvectical_listBase = tb.scrollloopvectical_listBase
    local uid = _G.PlayerModel:GetInstance():GetPlayerUid()
    for i, v in ipairs(self.rankInfo) do
        if v.role_info.uid == uid then
            self:InitMineRank(tb.obj_player, i, v)
            return
        end
    end
    self:InitMineRank(tb.obj_player)
end

function CommonRankDecorationBossPanel:RefreshRankItem(index, obj)
    local newIndex = index + 1
    local ins = obj:GetInstanceIDE()
    local tb = self.rankItemList[ins]
    if not tb then
        tb = _G.GetAutoGoTable(obj:GetChildE(obj:GetChildCountE() - 1))
        self.rankItemList[ins] = tb
    end
    tb.ins = ins
    tb.aorbtn_play.onClick:RemoveAllListeners()
    --排名
    if newIndex > 3 then
        tb.aortext_rank.text = newIndex
    elseif newIndex >= 1 then
        tb.aortext_rank.text = ""
        tb.aorimage_rank.SpriteName = RANK_ICON_IMAGES[newIndex]
    end
    tb.aorimage_rank:SetActiveE(newIndex <= 3 and 1 or 0)
    --头像
    local data = self.rankInfo[newIndex]
    if not _G.table.isEmptyOrNil(data) then
        tb.aortext_name.text = data.role_info.name
        tb.aortext_score.text = _G.GetLangPackValue(90029800007) .. _G.GameUtil.NumberToUnitStrFight(data.dps)
        tb.obj_HeadItemBase:SetActiveE(1)
        _G.UIUtils.SetPlayerHeadItemNew(
            tb.obj_HeadItemBase,
            data.role_info,
            0.45,
            true,
            true,
            false
        )
        tb.aorbtn_play.onClick:AddListener(
            _G.handlerbind(self, self.OnClickPlay, data.role_info.uid)
        )
    else
        tb.aortext_name.text = _G.GetLangPackValue(90000010159)
        tb.obj_HeadItemBase:SetActiveE(0)
        tb.aortext_score.text = ""
    end
end

function CommonRankDecorationBossPanel:OnClickPlay(uid)
    require("DecorationBossModel"):GetInstance():GetPlayBack(uid, self.params.id, self.params.type, true)
end

function CommonRankDecorationBossPanel:InitMineRank(obj, mineRank, data)
    local tb = _G.GetAutoGoTable(obj:GetChildE(obj:GetChildCountE() - 1))
    tb.ins = obj:GetInstanceIDE()
    if not mineRank or mineRank == 0 then
        tb.aortext_noRank:SetActiveE(1)
        tb.obj_rank:SetActiveE(0)
    else
        tb.aortext_noRank:SetActiveE(0)
        tb.obj_rank:SetActiveE(1)
        tb.aortext_rank.text = mineRank
    end
    local playerData = _G.PlayerModel:GetInstance():GetIRroleTable()
    tb.aortext_name.text = playerData.name
    if data then
        tb.aortext_score.text = _G.GetLangPackValue(90029800007) .. _G.GameUtil.NumberToUnitStrFight(data.dps)
    else
        tb.aortext_score.text = 0
    end
    _G.UIUtils.SetPlayerHeadItemNew(
        tb.obj_HeadItemBase,
        playerData,
        0.45,
        true,
        true,
        false
    )
end

---设置排行榜信息和奖励
function CommonRankDecorationBossPanel:SetRankAward(rewards, tb, obj)
    if not _G.table.isEmptyOrNil(rewards) then
        if tb.lstAwardItems then
            for i = 1, #tb.lstAwardItems do
                tb.lstAwardItems[i].gameObject:SetLocalScaleXYZ(1)
                _G.ItemFactory:GetInstance():SetItemCard(tb.lstAwardItems[i])
            end
        end

        tb.lstAwardItems = {}
        for _, v in pairs(rewards) do
            _G.ItemFactory:GetInstance():GetItemCard(
                _G.ItemFactory.itemType.ItemBaseWithCount,
                tb.trans_awardRoot,
                function(awardItem)
                    if _G.IsNil(tb.trans_awardRoot) or tb.ins ~= obj:GetInstanceIDE() then
                        awardItem.gameObject:SetLocalScaleXYZ(1)
                        _G.ItemFactory:GetInstance():SetItemCard(awardItem)
                        return
                    end
                    table.insert(tb.lstAwardItems, awardItem)
                    awardItem.gameObject:SetLocalScaleXYZ(0.6)
                    awardItem:Show(v[1], nil, v[2])
                end)
        end
    end
end

function CommonRankDecorationBossPanel:Dispose()
    if self.params.OnCloseCall then
        self.params.OnCloseCall(true)
    end
end

return CommonRankDecorationBossPanel
