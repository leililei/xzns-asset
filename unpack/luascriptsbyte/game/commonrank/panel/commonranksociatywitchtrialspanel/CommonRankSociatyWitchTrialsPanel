---@param tb _obj_main._obj_scrollPrefab_GoTable
function CommonRankSociatyWitchTrialsPanel:OnRank(tb)
    local title = _G.ConfigManager.rank_zone_cfg[self.sysType].title
    self.itemTitle = title[3] and _G.GetLangPackValue(title[3])
    self.rankList = SociatyModel.SociatySelf.WitchTrialsRankList or {}
    tb.scrollloopvectical_listBase:InitItemData(_G.math.max(#self.rankList, 3), _G.handler(self, self.RefreshRankItem))
    self.go_table.aorbtn_award:SetActiveE(0)
    self:InitRankPlayer(tb.obj_player, SociatyModel.SociatySelf:GetMyRank())
    local pbData = {roles = {}}
    local roles = {}
    local info
    local roleTitle = _G.GetLangPackValue(_G.ConfigManager.rank_zone_cfg[self.sysType].title1)
    for i = 1, 3 do
        info = self.rankList[i]
        if info then
            _G.table.insert(pbData.roles, info.role.Uid)
            _G.table.insert(
                    roles,
                    {
                        sid = 0,
                        uid = info.role.Uid,
                        name = info.role.Name,
                        score = roleTitle .. _G.GameUtil.NumberToUnitStr(info.dps)
                    }
            )
        else
            _G.table.insert(roles, {sid = 0})
        end
    end
    self.rankTgLis[1].roles = roles
    self:GetRoleStyle(pbData, roles)
end

---刷新排行榜
function CommonRankSociatyWitchTrialsPanel:RefreshRankItem(index, obj)
    index = index + 1
    local data = self.rankList[index]
    local obj1 = obj:GetChildE(obj:GetChildCountE() - 1)
    ---@type _obj_CommonRankArenaPeak._obj_rank_GoTable
    local tb = GetAutoGoTable(obj1)
    tb.aorimage_Bg.SpriteName = rankBg[index <= 3 and index or 4]
    tb.aorimage_rank:SetActiveE(index <= 3 and 1 or 0)
    tb.aortext_rank:SetActiveE(index <= 3 and 0 or 1)
    if index <= 3 then
        tb.aorimage_rank.SpriteName = rankIcon[index]
    else
        tb.aortext_rank.text = index
    end
    for i = 1, 3 do
        tb["aortext_rankNum" .. i]:SetActiveE(i == index and 1 or 0)
    end
    if data then
        tb.aortext_name.text = data.role.Name
        tb.aortext_score.text = self.itemTitle.. _G.GameUtil.NumberToUnitStr(data.dps)
        _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data.role, 0.7, true, true, false)
        tb.aortext_no:SetActiveE(0)
    else
        tb.aortext_name.text = ""
        tb.aortext_score.text = ""
        tb.aortext_no:SetActiveE(1)
    end
end



function CommonRankSociatyWitchTrialsPanel:InitRankPlayer(obj, playerRank)
    local obj1 = obj:GetChildE(obj:GetChildCountE() - 1)
    local tb1 = GetAutoGoTable(obj)
    tb1.aorimage_Bg.SpriteName = rankBg[(playerRank >= 1 and playerRank <= 3) and playerRank or 4]
    local index = playerRank
    ---@type _obj_CommonRankArenaPeak._obj_rankSelf_GoTable
    local tb = GetAutoGoTable(obj1)
    tb.aortext_noRank:SetActiveE(index == 0 and 1 or 0)
    tb.obj_rank:SetActiveE(index == 0 and 0 or 1)
    tb.aortext_rank.text = index
    local data = _G.PlayerModel:GetInstance():GetIRroleTable()
    tb.aortext_name.text = data.name
    tb.aortext_score.text =self.itemTitle.._G.GameUtil.NumberToUnitStr(self.rankList[playerRank] and self.rankList[playerRank].dps or 0)
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data, 0.7, true, true, false)
end


