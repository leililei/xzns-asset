local CommonRankNet = require("CommonRankNet")
local base = require "CommonRankBasePanel"

---@class CommonRankDrawUpPanel : CommonRankBasePanel    中文描述
---@field public go_table CommonRankView._obj_main_GoTable GoTable
---@field ActivityID number 活动id
---@field cardSid number 抽卡英雄sid
---@field limited_roller_cfg limited_roller_cfg
---@field model DrawUpMainModel
---@field net DrawUpMainNet
---@field myScore number 玩家自己的抽卡次数
---@field rankList rank.i_role_activity_lucky_draw[]
local CommonRankDrawUpPanel = _G.BaseClass("CommonRankDrawUpPanel", base)

local GetAutoGoTable = _G.GetAutoGoTable

local rankIcon = {
    [1] = "0ui_icon_diyi",
    [2] = "0ui_icon_dier",
    [3] = "0ui_icon_disan"
}

function CommonRankDrawUpPanel:OnCreate(parent, activityId)
    self.showNoRole = true
    self.model = require("DrawUpMainModel"):GetInstance()
    self.net = require "DrawUpMainNet":GetInstance()
    self.ActivityID = activityId
    self.cardSid = self.model:GetItemId(self.ActivityID)
    self.limited_roller_cfg = self.model:Getlimited_roller_cfg(self.ActivityID)
    self.myScore = require "DrawUpMainModel":GetInstance():GetTotalTimes(self.ActivityID)

    self.itemPath = "UIH5/CommonRank/$_obj_CommonRankDrawUp"
    local GetCfgData = require "DrawUpMainModel":GetInstance():GetCfgData(self.ActivityID)
    local isBattleArea = GetCfgData.rank_type == 2
    self.rankTgLis = {
        {
            type = 1,
            title = isBattleArea and 90029300039 or 90029300038,
            tip = nil,
            func = self.OnRank,
            itemName = "obj_rank",
            selfName = "obj_rankSelf",
            roles = {},
            hideSelf = false
        }
    }
    self.awardTgLis = {
        {
            label = 90029400051,
            type = 1,
            title = 90029300040,
            tip = 90029300035,
            func = self.OnSeasonAward,
            itemName = "obj_seasonAward",
            selfName = "obj_seasonAwardSelf",
            hideSelf = true,
            popBol = true   --奖励改成弹窗形式
        }
    }
    self.myRank = 0
    base.OnCreate(self)
end

---子类重写
function CommonRankDrawUpPanel:UpdateTopInfo()
    base.UpdateTopInfo(self)
    self.go_table.obj_no:SetActiveE(_G.table.count(self.rankList) == 0 and 1 or 0)
end

---@param tb _obj_main._obj_scrollPrefab_GoTable
function CommonRankDrawUpPanel:OnRank(tb)
    ---@param data rank.s2c_rank_activity_lucky_draw
    self.net:GetRank(
        function(data, delayRanks)
            self.rankList = data.ranks or {}
            tb.scrollloopvectical_listBase:InitItemData(#self.rankList, _G.handler(self, self.RefreshRankItem))
            local pbData = { roles = {} }
            local roles = {}
            for i = 1, 3 do
                ---@type rank.i_role_activity_lucky_draw
                local info = self.rankList[i]
                if info and info.rank <= 3 then
                    _G.table.insert(pbData.roles, info.role_info.uid)
                    _G.table.insert(
                        roles,
                        {
                            sid = 0,
                            uid = info.role_info.uid,
                            name = info.role_info.name,
                            score = _G.GetLangPackValue(90029300037, info.draw_times)
                        }
                    )
                else
                    _G.table.insert(roles, { sid = 0 })
                end
            end
            if #pbData.roles > 0 then
                CommonRankNet:GetInstance():GetRoleStyle(
                    pbData,
                    function(msg)
                        local roleSkin = {}
                        for _, v in pairs(msg.roles) do
                            roleSkin[v.uid] = v
                        end
                        local data
                        for _, v in pairs(roles) do
                            data = roleSkin[v.uid]
                            if data then
                                v.sid = data.skin
                                v.halo = data.circle
                                v.title = data.title
                                v.god_halo = data.god_halo
                                v.artifact_skin=data.artifact_skin
                            end
                        end
                        self.rankTgLis[1].roles = roles
                        self:OnInitRankEnd()
                    end
                )
            else
                self.rankTgLis[1].roles = roles
                self:OnInitRankEnd()
            end
            ---@param msg rank.s2c_get_rank_num
            self.net:GetSelfRank(
                function(msg)
                    if msg.ack ~= 1 then
                        return
                    end
                    self.myRank = msg.index
                    self:InitRankPlayer(tb.obj_player, self.myRank, self.myScore)
                end, self.ActivityID, delayRanks
            )
        end, self.ActivityID
    )
end

---刷新排行榜
function CommonRankDrawUpPanel:RefreshRankItem(csIndex, obj)
    local obj1 = obj:GetChildE(obj:GetChildCountE() - 1)
    ---@type _obj_CommonRankArenaPeak._obj_rank_GoTable
    local tb = GetAutoGoTable(obj1)
    local luaIndex = csIndex + 1
    local data = self.rankList[luaIndex]
    local rank = data.rank
    tb.aorimage_rank:SetActiveE(rank <= 3 and 1 or 0)
    tb.aortext_rank:SetActiveE(rank <= 3 and 0 or 1)
    if rank <= 3 then
        tb.aorimage_rank.SpriteName = rankIcon[rank]
    else
        tb.aortext_rank.text = rank
    end
    for i = 1, 3 do
        tb["aortext_rankNum" .. i]:SetActiveE(i == rank and 1 or 0)
    end
    tb.aortext_name.text = data.role_info.name
    tb.aortext_score.text = _G.GetLangPackValue(90029300037, data.draw_times)
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data.role_info, 0.7, true, true, false)
end

function CommonRankDrawUpPanel:InitRankPlayer(obj, index, score)
    local obj1 = obj:GetChildE(obj:GetChildCountE() - 1)
    ---@type _obj_CommonRankArenaPeak._obj_rankSelf_GoTable
    local tb = GetAutoGoTable(obj1)
    tb.aortext_noRank:SetActiveE((index <= 0 and score <= 0) and 1 or 0)
    tb.obj_rank:SetActiveE((index <= 0 and score <= 0) and 0 or 1)
    if index > 0 then
        tb.aortext_rank.text = index
    else
        tb.aortext_rank.text = "1000+"
    end
    local data = _G.PlayerModel:GetInstance():GetIRroleTable()
    tb.aortext_name.text = data.name
    tb.aortext_score.text = _G.GetLangPackValue(90029300037, score)
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data, 0.7, true, true, false)
end

---@param tb _obj_main._obj_scrollPrefab_GoTable
function CommonRankDrawUpPanel:OnSeasonAward(tb, index)
    self.rewardList = self.limited_roller_cfg.draw_rank
    self.count = #self.rewardList
    --tb.scrollloopvectical_listBase:SetRectTransformSize(682, -600)
    --tb.scrollloopvectical_listBase:SetAnchorPosition(0, -320)
    --local _, y = tb.scrollloopvectical_listBase:GetRectTransformSize()
    --tb.scrollloopvectical_listBase:UpdateScrollRectHeight(y)
    tb.scrollloopvectical_listBase:InitItemData(self.count, _G.handler(self, self.RefreshAwardItem))
    self.net:GetRank(
        function(data, delayRanks)
            self.rankList = data.ranks or {}
            ---@param msg rank.s2c_get_rank_num
            self.net:GetSelfRank(
                function(msg)
                    if msg.ack ~= 1 then
                        self:InitSeasonAwardPlayer(tb.obj_player, index)
                        return
                    end
                    self.myRank = msg.index
                    self:InitSeasonAwardPlayer(tb.obj_player, index)
                end, self.ActivityID, delayRanks
            )
        end, self.ActivityID
    )
end

function CommonRankDrawUpPanel:RefreshAwardItem(csIndex, obj)
    local luaIndex = csIndex + 1
    local obj1 = obj:GetChildE(obj:GetChildCountE() - 1)
    ---@type _obj_CommonRankArenaPeak._obj_seasonAward_GoTable
    local tb = GetAutoGoTable(obj1)
    local rankCfg = _G.ConfigManager.system_rank_cfg[self.rewardList[luaIndex]]
    if not rankCfg then
        return
    end
    local rankStr
    if rankCfg.min_rank == rankCfg.max_rank then
        rankStr = string.format("%d", rankCfg.max_rank)
    elseif not rankCfg.min_rank or rankCfg.min_rank <= 0 then
        rankStr = string.format("%d", rankCfg.max_rank)
    elseif not rankCfg.max_rank or rankCfg.max_rank <= 0 then
        rankStr = string.format("%d", rankCfg.min_rank)
    else
        rankStr = string.format("%d-%d", rankCfg.min_rank, rankCfg.max_rank)
    end
    tb.aortext_score.text = _G.GetLangPackValue(90023300031, rankStr)

    tb.rewards = rankCfg.rewards
    self:ShowAward(tb, tb.obj_Award, rankCfg.rewards)
end

function CommonRankDrawUpPanel:RefreshSingleAward(csIndex, obj, pTb)
    local luaIndex = csIndex + 1
    ---@type _obj_seasonAward._obj_awardItem_GoTable
    local tb = GetAutoGoTable(obj)
    local award = {} ---操作配置表有报错
    for _, v in pairs(pTb.rewards[luaIndex]) do
        _G.table.insert(award, v)
    end
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        award,
        tb.obj_award,
        function(item)
            if _G.IsNil(self.go_table) then
                _G.DestroyObject(item.gameObject)
                return
            end
            if item.ShowNumText then
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
        end
    )
end

function CommonRankDrawUpPanel:ShowAward(tb, obj, award)
    if not tb.list then
        tb.list = {}
    end
    local count = #tb.list
    local count2 = #award
    for i = 1, count do
        if i <= count2 then
            tb.list[i]:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(award[i]), function()
                if tb.list[i].item.ShowEffectOrder then
                    tb.list[i].item:ShowEffectOrder(true)
                end
                if tb.list[i].type == _G.StorageType.Card then
                    tb.list[i].item.gameObject:SetLocalScaleXYZ(0.846)
                    tb.list[i].item:ShowCount(award[i][2])
                end
            end)
            tb.list[i].gameObject:SetActiveE(1)
        else
            tb.list[i].gameObject:SetActiveE(0)
        end
    end
    if count < count2 then
        for i = count + 1, count2 do
            local obj2 = _G.InstantiateObject(obj)
            obj2:SetParentE(tb.trans_Content)
            local item = require "BaseAwardNewItem".New(obj2, nil, 88, obj2:GetChildE(0))
            tb.list[i] = item
            local data = award[i]
            if data.type then
                data = data.type
            end
            item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data), function()
                if item.item.ShowEffectOrder then
                    item.item:ShowEffectOrder(true)
                end
                if item.type == _G.StorageType.Card then
                    item.item.gameObject:SetLocalScaleXYZ(0.846)
                    item.item:ShowCount(data[2])
                end
            end)
            item.gameObject:SetActiveE(1)
        end
    end
end

function CommonRankDrawUpPanel:InitSeasonAwardPlayer(obj, index)
    if self.awardTgLis[index].hideSelf then
        return
    end
    local obj1 = obj:GetChildE(obj:GetChildCountE() - 1)
    ---@type _obj_CommonRankArenaPeak._obj_seasonAwardSelf_GoTable
    local tb = GetAutoGoTable(obj1)
    local myRankIndex = 0
    local rankCfg
    for i = 1, #self.rewardList do
        local curRankCfg = _G.ConfigManager.system_rank_cfg[self.rewardList[i]]
        if (not curRankCfg.min_rank or curRankCfg.min_rank <= 0) and self.myRank <= curRankCfg.max_rank then
            myRankIndex = i
            break
        elseif (not curRankCfg.max_rank or curRankCfg.max_rank <= 0) and (self.myRank >= curRankCfg.min_rank or (self.myRank <= 0 and self.myScore > 0)) then
            myRankIndex = i
            break
        elseif self.myRank >= curRankCfg.min_rank and self.myRank <= curRankCfg.max_rank then
            myRankIndex = i
            break
        end
    end
    if myRankIndex == 0 then
        myRankIndex = #self.rewardList
    end
    local isShowAward = true
    if self.myRank <= 0 then
        if self.myScore > 0 then
            tb.obj_rank:SetActiveE(1)
            tb.aortext_noRank:SetActiveE(0)
            tb.aortext_score.text = "1000+"
        else
            tb.obj_rank:SetActiveE(0)
            tb.aortext_noRank:SetActiveE(1)
            isShowAward = false
        end
    else
        tb.obj_rank:SetActiveE(1)
        tb.aortext_noRank:SetActiveE(0)
        tb.aortext_score.text = _G.GetLangPackValue(90023300031, self.myRank)
    end
    rankCfg = _G.ConfigManager.system_rank_cfg[self.rewardList[myRankIndex]]
    tb.rewards = rankCfg.rewards
    if isShowAward then
        self:ShowAward(tb, tb.obj_Award, rankCfg.rewards)
    end
end

function CommonRankDrawUpPanel:UpdateTopInfo()
    local roles = self.rankTgLis[self.curRankIndex].roles
    self.go_table.obj_topInfo:SetActiveE(1)
    if roles then
        ---@type _obj_main._obj_info1_GoTable
        local tb
        for i = 1, 3 do
            tb = self.top3Tb[i]
            if roles[i] and roles[i].name then
                tb.aorimage_bg:SetActiveE(1)
                tb.aortext_name.text = roles[i].name
                tb.aortext_score.text = roles[i].score
                if roles[i].title ~= nil then
                    self:UpdateTop3Title(tb, roles[i].title, i)
                end
            else
                tb.aorimage_bg:SetActiveE(0)
                tb.aortext_score.text = _G.GetLangPackValue(90021800103)
            end
        end
    end
end
function CommonRankDrawUpPanel:InitZoneRank()
    self.supre:InitZoneRank()
    self.go_table.obj_no:SetActiveE(#self.ranks==0 and 0 or 1)
end

return CommonRankDrawUpPanel
