local baseView = require("CommonRankBasePanel")
---@class CommonRankActivityTrialPanel : CommonRankBasePanel	中文描述
local CommonRankActivityTrialPanel = _G.BaseClass("CommonRankActivityTrialPanel", baseView)

---@type string[] 前三排名图标
local RANK_ICON_IMAGES = {
    "0ui_icon_diyi",
    "0ui_icon_dier",
    "0ui_icon_disan"
}
---排行榜前三
local TOP_PLAYER_COUNT = 3

---创建对象时,入口构造函数
function CommonRankActivityTrialPanel:OnCreate(parent, activity)
    self.activity = activity
    self.model = activity:GetActivityTypeCls()
    self.itemPath = "UIH5/CommonRank/$_obj_CommonRankActivityTrial"
    self.initRankParam = {
        type = 1,
        title = 90000012002,
        tip = nil,
        func = self.InitRank,
        itemName = "obj_rank",
        selfName = "obj_rankSelf",
        rolse = {},
        hideSelf = false
    }
    self.rankTgLis = { self.initRankParam }
    ---排行榜奖励
    local initRankAwardParams = {
        label = 90000011729,
        title = 90000012002,
        tip = nil,
        func = self.InitRankAward,
        itemName = "obj_rankAward",
        selfName = "obj_rankAwardSelf",
        hideSelf = true,
        popBol = true   --奖励改成弹窗形式
    }
    self.awardTgLis = { initRankAwardParams }
    self.rankAwardItems = {}
    self.rankItemList = {}
    self.page = 1
    self.nextPageNumList = {}
    for i = 1, 9 do
        self.nextPageNumList[i * 100] = i + 1
    end
    ---获取排行榜数据
    self.rankInfo = {}
    self:GetRankInfo()
end

function CommonRankActivityTrialPanel:GetRankInfo()
    self.model:GetRankInfo(self.page, function(info)
        self.rankInfo = info and info.ranks or {}
        ---@type RankTop3Role[]
        local roles = {}
        local pbData = { roles = {} }
        for i = 1, TOP_PLAYER_COUNT do
            local info = self.rankInfo[i]
            if not _G.table.isEmptyOrNil(info) then
                _G.table.insert(pbData.roles, info.role_info.uid)
                _G.table.insert(roles, {
                    sid = 0,
                    uid = info.role_info.uid,
                    name = info.role_info.name,
                    score = _G.GetLangPackValue(90029800007) .. _G.GameUtil.NumberToUnitStrFight(info.dps)
                })
            else
                _G.table.insert(roles, { sid = 0 })
            end
        end
        self.initRankParam.roles = roles
        if #pbData.roles ~= 0 then
            self:GetRoleStyle(pbData, roles)
        end
        local uid = _G.PlayerModel:GetInstance():GetPlayerUid()
        for i, v in ipairs(self.rankInfo) do
            if v.role_info.uid == uid then
                self.mineRank = i
                self.mineRankData = v.dps
                break
            end
        end
        if not self.mineRank then
            self.model:GetSelfRank(function(data)
                self.mineRank = data.index
                self.mineRankData = data.value
                if self.objPlayer then
                    self:InitMineRank(self.objPlayer)
                end
            end)
        end
        baseView.OnCreate(self)
    end)
end

---初始化排行榜数据
function CommonRankActivityTrialPanel:InitRank(tb)
    local itemAmount = #self.rankInfo
    tb.scrollloopvectical_listBase:InitItemData(
        itemAmount,
        _G.handler(self, self.RefreshRankItem)
    )
    self.scrollloopvectical_listBase = tb.scrollloopvectical_listBase
    self.canNext = itemAmount >= 100
    self.objPlayer = tb.obj_player
    self:InitMineRank(tb.obj_player)
end

---刷新排行榜
function CommonRankActivityTrialPanel:RefreshRankItem(index, obj)
    local ins = obj:GetInstanceIDE()
    local tb = self.rankItemList[ins]
    if not tb then
        tb = _G.GetAutoGoTable(obj:GetChildE(obj:GetChildCountE() - 1))
        self.rankItemList[ins] = tb
    end
    tb.ins = ins
    local rank = index + 1
    local data = self.rankInfo[rank]
    tb.aorimage_rank:SetActiveE(rank <= 3 and 1 or 0)
    tb.aortext_rank:SetActiveE(rank <= 3 and 0 or 1)
    if rank <= 3 then
        tb.aorimage_rank.SpriteName = RANK_ICON_IMAGES[rank]
        tb.aorimage_rank:SetNativeSize()
        for i = 1, 3 do
            tb["aortext_rankNum" .. i]:SetActiveE(i == rank and 1 or 0)
        end
    else
        tb.aortext_rank.text = rank
    end
    tb.aorbtn_play.onClick:AddListener(
        _G.handlerbind(self, self.OnClickPlay, data.role_info.uid)
    )
    tb.aortext_name.text = data.role_info.name
    tb.aortext_score.text = _G.GetLangPackValue(90029800007) .. _G.GameUtil.NumberToUnitStrFight(data.dps)
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data.role_info, 0.6, true, false, false)
    if self.canNext and self.nextPageNumList[rank] then
        self:GetNextPageRankInfo(rank, self.nextPageNumList[rank])
    end
end

---获取下一页排行榜数据
function CommonRankActivityTrialPanel:GetNextPageRankInfo(newIndex, page)
    if page <= self.page then
        return
    end
    self.page = page
    self.model:GetRankInfo(
        self.page,
        function(msg)
            if not table.isEmptyOrNil(msg.ranks) then
                table.insertto(self.rankInfo, msg.ranks)
                if self.scrollloopvectical_listBase then
                    self.scrollloopvectical_listBase:SetCount(#self.rankInfo)
                    self.scrollloopvectical_listBase:ResetPosition()
                end
                self.canNext = true
            else
                self.canNext = false
            end
            self.nextPageNumList[newIndex] = false
        end
    )
end

function CommonRankActivityTrialPanel:OnClickPlay(uid)
    self.model:PlayBack(uid)
end

function CommonRankActivityTrialPanel:InitMineRank(obj)
    local tb = _G.GetAutoGoTable(obj:GetChildE(obj:GetChildCountE() - 1))
    tb.ins = obj:GetInstanceIDE()
    if not self.mineRank or self.mineRank == 0 then
        tb.aortext_noRank:SetActiveE(1)
        tb.obj_rank:SetActiveE(0)
    else
        tb.aortext_noRank:SetActiveE(0)
        tb.obj_rank:SetActiveE(1)
        tb.aortext_rank.text = self.mineRank
    end
    local playerData = _G.PlayerModel:GetInstance():GetIRroleTable()
    tb.aortext_name.text = playerData.name
    if self.mineRankData then
        tb.aortext_score.text = _G.GetLangPackValue(90029800007) .. _G.GameUtil.NumberToUnitStrFight(self.mineRankData)
    else
        tb.aortext_score.text = 0
    end
    _G.UIUtils.SetPlayerHeadItemNew(
        tb.obj_HeadItemBase,
        playerData,
        0.6,
        true,
        true,
        false
    )
end

function CommonRankActivityTrialPanel:InitRankAward(tb)
    local rankAward = self.model:GetRankAward()
    self.rankAwardList = {}
    local rankConfig = _G.ConfigManager.system_rank_cfg
    for _, v in pairs(rankAward) do
        if rankConfig[v] then
            _G.table.insert(self.rankAwardList, rankConfig[v])
        end
    end
    --进行排序(从高到底)
    _G.SortList(
        self.rankAwardList,
        function(v)
            return -v.min_rank
        end
    )
    --初始化列表显示
    tb.scrollloopvectical_listBase:InitItemData(#self.rankAwardList, _G.handler(self, self.RefreshRankAwardItem))
end

---初始化奖励
function CommonRankActivityTrialPanel:RefreshRankAwardItem(index, obj)
    local newIndex = index + 1
    local instanceID = obj:GetInstanceIDE()
    local tb = self.rankAwardItems[instanceID]
    if not tb then
        tb = _G.GetAutoGoTable(obj:GetChildE(obj:GetChildCountE() - 1))
        self.rankAwardItems[instanceID] = tb
    end
    tb.aorimage_rank:SetActiveE(newIndex <= 3 and 1 or 0)
    tb.aortext_rank:SetActiveE(newIndex <= 3 and 0 or 1)
    if newIndex <= 3 then
        tb.aorimage_rank.SpriteName = RANK_ICON_IMAGES[newIndex]
        tb.aorimage_rank:SetNativeSize()
        for i = 1, 3 do
            tb["aortext_rankNum" .. i]:SetActiveE(i == newIndex and 1 or 0)
        end
    else
        tb.aortext_rank.text = newIndex
    end
    tb.ins = instanceID
    --排名信息
    local rankData = self.rankAwardList[newIndex]
    if rankData.max_rank >= 9999 then
        tb.aortext_rank.text = _G.GetLangPackValue(90029400146, rankData.min_rank)
    elseif rankData.min_rank == rankData.max_rank then
        tb.aortext_rank.text = _G.GetLangPackValue(90029400144, rankData.min_rank)
    else
        tb.aortext_rank.text = _G.GetLangPackValue(90029400145, rankData.min_rank, rankData.max_rank)
    end

    --奖励
    local rewards = rankData.rewards
    self:SetRankAward(rewards, tb, obj)
end

---设置排行榜信息和奖励
function CommonRankActivityTrialPanel:SetRankAward(rewards, tb, obj)
    if not table.isEmptyOrNil(rewards) then
        if tb.lstAwardItems then
            for i = 1, #tb.lstAwardItems do
                tb.lstAwardItems[i].gameObject:SetLocalScaleXYZ(1)
                _G.ItemFactory:GetInstance():SetItemCard(tb.lstAwardItems[i])
            end
        end

        tb.lstAwardItems = {}
        for _, v in pairs(rewards) do
            _G.ItemFactory:GetInstance():GetItemCard(
                _G.ItemFactory.itemType.ItemBaseWithCount,
                tb.trans_awardRoot,
                function(awardItem)
                    if _G.IsNil(tb.trans_awardRoot) or tb.ins ~= obj:GetInstanceIDE() then
                        awardItem.gameObject:SetLocalScaleXYZ(0.65)
                        _G.ItemFactory:GetInstance():SetItemCard(awardItem)
                        return
                    end
                    _G.table.insert(tb.lstAwardItems, awardItem)
                    awardItem.gameObject:SetLocalScaleXYZ(0.8)
                    awardItem:Show(v[1], nil, v[2])
                    awardItem:ShowFrameEffect(v[1], true)
                end)
        end
    end
end

---初始化自己排名的奖励
function CommonRankActivityTrialPanel:ShowSelfRankAwardItem(tb, obj)
    local rankData = {}
    local isShowAward = true
    if not self.mineRank or self.mineRank == 0 then
        if self.model:GetDamage() > 0 then
            tb.aortext_rank.text = "1000+"
        else
            tb.aortext_rank.text = _G.GetLangPackValue(90022900040)
            tb.aortext_noRankDes:SetActiveE(1)
            isShowAward = false
        end
    else
        tb.aortext_rank.text = self.mineRank
    end
    tb.aortext_noRankDes:SetActiveE(isShowAward and 0 or 1)

    if not self.mineRank then
        rankData = self.rankAwardList[#self.rankAwardList]
    else
        for _, v in pairs(self.rankAwardList) do
            if self.mineRank >= v.min_rank and self.mineRank <= v.max_rank then
                rankData = v
                break
            end
        end
    end
    tb.ins = obj:GetInstanceIDE()
    if isShowAward then
        self:SetRankAward(rankData.rewards, tb, obj)
    end
end

return CommonRankActivityTrialPanel
