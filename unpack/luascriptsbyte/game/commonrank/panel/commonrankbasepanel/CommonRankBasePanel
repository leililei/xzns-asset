function CommonRankBasePanel:RefreshZoneRankItem(index, obj)
    index = index + 1
    local obj1 = obj:GetChildE(obj:GetChildCountE() - 1)
    local tb = GetAutoGoTable(obj1,
        _G.handlerbind(self, self.OnClick, self.ranks[index].role_info, self.ranks[index].p_id))
