function CommonRankBasePanel:LoadSceneComplete()
    --TODO:重定位节点坐标
    self.gameObject:SetActiveE(1)

    self.sceneTrans = nil
    self.rankTrans = {}
    for i = 1, 3 do
        local tb = self.top3Tb[i]
        table.insert(self.rankTrans, tb.trans_role)
    end
    self.camera = _G.Camera.main
    self.camera.depth = 55
    local camera = _G.FindObject("3DUICam")
    if not _G.IsNil(camera) then
        self.camera3D = camera:GetComponentE(_G.typeof(_G.CS.UnityEngine.Camera))
        self.camera3D.depth = 55
    end
    if not self.curRankIndex then
        self.curRankIndex = 1
    end
    if self.curRankIndex and not _G.table.isEmptyOrNil(self.rankTgLis[self.curRankIndex].roles) then
        self:UpdateTopInfo()
        self:CheckTopNoRole()
        self:UpdateAllRoleModel()
    end
end

---加载单个角色
---@param view table 视图
---@param rolepath string 模型路径
---@param posType number 摆放的位置
function CommonRankBasePanel:LoadRoleModel(rolepath, posIndex, scale, data)
    _G.PoolsManager:GetInstance():Spawn(
        rolepath,
        _G.ePoolType.Temporary,
        nil,
        function(trans)
            if trans == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("角色无法加载 path:" .. rolepath .. "    CommonRank LoadRoleModel")
                end
                return
            end
            if self:IsNil() or not self.rankTrans then
                _G.DestroyObject(trans)
                return
            end
            trans:SetParentE(self.rankTrans[posIndex])
            trans:SetLocalPositionToZero()
            trans:SetLocalScaleXYZ(scale)
            self.roleTrans[posIndex] = trans
            local rolePoint = trans:GetComponentE(_G.typeof(_G.CS.RolePoint))
            if rolePoint == nil then
                rolePoint = trans:AddComponentE(_G.typeof(_G.CS.RolePoint))
            end
            -- self:UpdateHalo(posIndex, rolePoint)
            -- self:UpdateTitle(posIndex, rolePoint)
            --- 只有星座女神有神环
            if _G.AppSetting.IsXzns then
                local godHaloID = data.god_halo
                local cfg = _G.ConfigManager.card_cfg[data.sid]
                -- if cfg == nil then
                --     cfg = _G.ConfigManager.card_cfg[_G.ConfigManager.skin_cfg[data.sid].card]
                -- end
                if godHaloID ~= 0 then
                    local effCfg = _G.ConfigManager.god_halo_cfg[godHaloID].ui_effect_cfg
                    --- 神环路径，父级路径(加载角色的下面)
                    _G.UIUtils.LoadGodHalo(effCfg, trans, godHaloID)
                end
                if not table.isEmptyOrNil(data.artifact_skin) then
                    _G.UIUtils.LoadArtifacteffect(trans,nil,data.artifact_skin[1],data.artifact_skin[2])
                end
            end
        end
    )
end

function CommonRankBasePanel:UpdateTitle(pos, rolePoint)
    local title = self.rankTgLis[self.curRankIndex].roles[pos].title
    local parent = self.roleTrans[pos]
    if not self.title[pos] or _G.IsNil(self.title[pos].gameObject) then
        if not title or title <= 0 then
            return
        end
        _G.PoolsManager:GetInstance():Spawn(
            "CommonPrefab/World/Common_TitleWithDesignation",
            _G.ePoolType.Temporary,
            parent,
            function(trans)
                if (_G.IsNil(parent)) then
                    _G.DestroyObject(trans)
                    return
                end
                local go_table = _G.GetAutoGoTable(trans)
                trans:AddComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
                self.title[pos] = go_table
                self:SetTitlePos(pos, rolePoint)
                go_table.aortext_TextName.text = ""

                ---@type player_title_effect_cfg
                local cfg = _G.ConfigManager.player_title_effect_cfg[title]
                if cfg then
                    if cfg.type_title == 1 then
                        go_table.aorrawimage_Title:LoadImage(
                            cfg.icon,
                            function()
                                go_table.aorrawimage_Title:SetNativeSize()
                                go_table.aorrawimage_Title:SetLocalScaleXYZ(
                                    self.titleScale * self.scale
                                )
                            end
                        )
                        if self.title[pos].item then
                            _G.DestroyObject(self.title[pos].item)
                            self.title[pos].item = nil
                        end
                        self.title[pos].aorrawimage_Title:SetActiveE(1)
                    else
                        self.title[pos].aorrawimage_Title:SetActiveE(0)
                        if self.title[pos].item then
                            _G.DestroyObject(self.title[pos].item)
                            self.title[pos].item = nil
                        end
                        _G.UIUtils.LoadEffectTitleOrFrame(
                            cfg.title,
                            self.title[pos].gameObject,
                            function(trans)
                                if self:IsNil() then
                                    _G.DestroyObject(trans)
                                    return
                                end
                                trans:SetLayerAndChild(30)
                                self.title[pos].item = trans
                                local x, y, z = self.title[pos].aorrawimage_Title:GetPosition()
                                trans:SetPosition(x, y + 0.2, z)
                                self.title[pos].item:SetLocalScaleXYZ(
                                    self.titleScale * self.scale
                                )
                                trans:SetActiveE(1)
                            end
                        )
                    end
                end
            end
        )
    elseif self.title[pos] then
        if self.title[pos].item then
            _G.DestroyObject(self.title[pos].item)
            self.title[pos].item = nil
        end
        if not title or title <= 0 then
            self.title[pos].aorrawimage_Title:SetActiveE(0)
            return
        end
        ---@type player_title_effect_cfg
        local cfg = _G.ConfigManager.player_title_effect_cfg[title]
        if cfg.type_title == 1 then
            self.title[pos].aorrawimage_Title:LoadImage(
                cfg.icon,
                function()
                    self.title[pos].aorrawimage_Title:SetNativeSize()
                    self.title[pos].aorrawimage_Title:SetLocalScaleXYZ(
                        self.titleScale * self.scale
                    )
                end
            )
            self.title[pos].aorrawimage_Title:SetActiveE(1)
        else
            _G.UIUtils.LoadEffectTitleOrFrame(
                cfg.title,
                self.title[pos].gameObject,
                function(trans)
                    if self:IsNil() then
                        _G.DestroyObject(trans)
                        return
                    end
                    trans:SetLayerAndChild(30)
                    self.title[pos].item = trans
                    local x, y, z = self.title[pos].aorrawimage_Title:GetPosition()
                    trans:SetPosition(x, y + 0.2, z)
                    self.title[pos].item:SetLocalScaleXYZ(
                        self.titleScale * self.scale
                    )
                    trans:SetActiveE(1)
                end
            )
            self.title[pos].aorrawimage_Title:SetActiveE(0)
        end
    end
end

---初始化头顶名称位置
---@param deltaY number Y轴便宜值
function CommonRankBasePanel:SetTitlePos(pos, rolePoint)
    _G.DelayFrameDo(
        function()
            if self:IsNil() then
                return
            end
            if self.title[pos] and not _G.IsNil(self.title[pos].gameObject) then
                local x, y, z = rolePoint.Point_Head:GetPosition()
                if x then
                    local parent = self.roleTrans[pos]
                    if parent == nil then
                        ---快速切换角色时gameObj可能被置位nil
                        return
                    end
                    local position = {}
                    position.x = x
                    position.z = z
                    position.y = y - 0.19
                    local scale = parent:GetLocalScale()
                    local rate = self.scale
                    self.title[pos].gameObject:SetLocalScaleXYZ(rate * 0.8 / scale)
                    self.title[pos].transform:SetLocalPositionToZero()
                    self.title[pos].transform:SetPosition(position.x, position.y, position.z)
                    local lookAt = self.title[pos].transform:GetComponentE(_G.typeof(_G.CS.LookAtTarget))
                    if _G.IsNil(lookAt) then
                        lookAt = self.title[pos].transform:AddComponentE(_G.typeof(_G.CS.LookAtTarget))
                    end
                    lookAt:SetData(self.camera.transform, parent)
                end
            end
        end
    )
end

function CommonRankBasePanel:UpdateHalo(pos, rolePoint)
    if self.halo[pos] then
        _G.PoolsManager:GetInstance():Despawn(self.halo[pos], _G.ePoolType.Temporary)
        self.halo[pos] = nil
    end
    local halo = self.rankTgLis[self.curRankIndex].roles[pos].halo
    if halo == nil or halo <= 0 then
        return
    end
    local parent = self.roleTrans[pos]
    ---@type player_halo_effect_cfg
    local cfg = _G.ConfigManager.player_halo_effect_cfg[halo]
    _G.PoolsManager:GetInstance():Spawn(
        cfg.halo,
        _G.ePoolType.Temporary,
        parent,
        function(trans)
            if _G.IsNil(parent) then
                _G.DestroyObject(trans)
                return
            end
            self.halo[pos] = trans
            if cfg.type_halo == 2 then
                self.halo[pos]:SetParentE(rolePoint.Point_Chest)
            else
                local scale = self.halo[pos]:GetParent():GetLocalScale()
                local rate = self.scale
                self.halo[pos]:SetLocalScaleXYZ(rate * _G.ConfigManager.discrete_cfg[103901][1][1] / scale)
            end
            self.halo[pos]:GetChildE(0):SetActiveE(1)
            self.halo[pos]:SetEulerAngles(0, 0, 0)
            self.halo[pos]:SetLocalPositionToZero()
        end
    )
end

---刷新所有角色
function CommonRankBasePanel:UpdateAllRoleModel()
    local roles = self.rankTgLis[self.curRankIndex].roles
    local data
    for i = 1, 3 do
        data = roles[i]
        if data then
            ---@type card_cfg
            local cfg = require "CardCommentManager":GetInstance():CardData(data.sid, false)
            if cfg then
                local path = _G.UIUtils.GetBattleSpine(cfg, _G.UseBattleSpine.RankView)
                self:LoadRoleModel(path, i, cfg.size4, data)
            end
            self.shadowNode[i]:SetActiveE(1)
            --self.top3Tb[i].aorimage_bg:SetActiveE(1)
        else
            self.shadowNode[i]:SetActiveE(0)
            self.top3Tb[i].aorimage_bg:SetActiveE(0)
        end
    end
end

