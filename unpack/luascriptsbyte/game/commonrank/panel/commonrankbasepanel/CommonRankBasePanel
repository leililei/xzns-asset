    local rankInfo = self.ranks[index].rank_info
    tb.aorimage_rank:SetActiveE(index <= 3 and 1 or 0)
    tb.aortext_rank:SetActiveE(index <= 3 and 0 or 1)
    if self.zonePlayBackBol then
        tb.aorbtn_playback:SetActiveE(1)
    else
