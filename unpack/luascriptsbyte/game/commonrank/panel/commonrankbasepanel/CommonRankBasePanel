function CommonRankBasePanel:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self.parent:Close()
    elseif go == self.go_table.aorbtn_award then
        self:SwitchRankOrAward()
    elseif go == self.go_table.aorbtn_rank or go == self.go_table.aorbtn_rank1 then
        self:SwitchRankOrAward()
    elseif go == self.go_table.aorbtn_danArrow then
        self:ShowDanSelect()
    elseif go == self.go_table.aorbtn_zoneTip then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 117)
    end
end

function CommonRankBasePanel:OnDisable()
    if self.sceneTrans then
        self.sceneTrans:SetActiveE(0)
    end
    if self.go_table.obj_isDanSelect:GetActiveSelf() == 1 then
        self:ShowDanSelect()
    end
end

function CommonRankBasePanel:OnEnable()
    if self.sceneTrans then
        self.sceneTrans:SetActiveE(1)
    end
end

function CommonRankBasePanel:OnDestroy()
    if self.camera ~= nil then
        self.camera.depth = 0
    end
    if self.camera3D then
        self.camera3D.depth = 1
    end
    self:ClearAllRoleModel()
    self.roleTrans = nil
    if self.sceneTrans ~= nil then
        _G.PoolsManager:GetInstance():Despawn(self.sceneTrans, _G.ePoolType.Temporary)
    end
    _G.PoolsManager:GetInstance():ClearPoolAll(_G.ePoolType.Temporary)
end

function CommonRankBasePanel:GetRoleStyle(pbData, roles)
    if #pbData.roles > 0 then
        require("CommonRankNet"):GetInstance():GetRoleStyle(
            pbData,
            function(msg)
                local roleSkin = {}
                for _, v in pairs(msg.roles) do
                    roleSkin[v.uid] = v
                end
                local data
                for _, v in pairs(roles) do
                    data = roleSkin[v.uid]
                    if data then
                        v.sid = data.skin
                        v.halo = data.circle
                        v.title = data.title
                        v.god_halo = data.god_halo
                        v.artifact_skin=data.artifact_skin or {}
                    end
                end
                self:OnInitRankEnd()
            end
        )
    else
        self:OnInitRankEnd()
    end
end

---初始化排行结束后，刷新模型和top3信息
function CommonRankBasePanel:OnInitRankEnd()
    if self.rankTgLis[self.curRankIndex].roles then
        self:UpdateTopInfo()
        self:CheckTopNoRole()
        self:ClearAllRoleModel()
        self:UpdateAllRoleModel()
    end
end

