function CommonRankBasePanel:CheckTopNoRole()
    local roles = self.rankTgLis[self.curRankIndex].roles
    if roles then
        local tb
        for i = 1, 3 do
            tb = self.top3Tb[i]
            if roles[i] and roles[i].name then
                tb.aorrawimage_noRole:SetActiveE(0)
            else
                tb.aorrawimage_noRole:SetActiveE(self.showNoRole and 1 or 0)
            end
        end
    end
end

function CommonRankBasePanel:UpdateTopInfo()
    local roles = self.rankTgLis[self.curRankIndex].roles
    self.go_table.obj_topInfo:SetActiveE(1)
    if roles then
        ---@type _obj_main._obj_info1_GoTable
        local tb
        for i = 1, 3 do
            tb = self.top3Tb[i]
            if roles[i] and roles[i].name then
                tb.aorimage_bg:SetActiveE(1)
                tb.aortext_name.text = roles[i].name
                tb.aortext_score.text = roles[i].score
                if roles[i].title ~= nil then
                    self:UpdateTop3Title(tb, roles[i].title, i)
                end
            else
                tb.aorimage_bg:SetActiveE(0)
                tb.aortext_score.text = _G.GetLangPackValue(90021800103)
            end
        end
        self.go_table.obj_no:SetActiveE(roles[1] and roles[1].name and 0 or 1)
    else
        self.go_table.obj_no:SetActiveE(1)
    end
end

---生成称号
---@param item table
function CommonRankBasePanel:UpdateTop3Title(tb, title, index)
    if title == 0 then
        return
    end
    if self.curShowEffTitle == nil then
        self.curShowEffTitle = {}
    end
    local titleScale = _G.ConfigManager.discrete_cfg[100111] and _G.ConfigManager.discrete_cfg[100111][1][1] or 1
    local player_title = _G.ConfigManager.player_title_effect_cfg[title]
    if player_title.type_title == 1 then
        tb.aorrawimage_title:LoadImage(player_title.title)
        tb.aorrawimage_title:SetActiveE(1)
        tb.aorrawimage_title:SetLocalScaleXYZ(0.29 * titleScale)
        tb.obj_titleEffect:RemoveAllChildren()
        self.curShowEffTitle[index] = nil
    elseif player_title.type_title == 2 then
        if self.curShowEffTitle[index] == nil or (self.curShowEffTitle[index] ~= nil and self.curShowEffTitle[index] ~= player_title.title) then
            tb.obj_titleEffect:RemoveAllChildren()
            self.curShowEffTitle[index] = player_title.title
            _G.UIUtils.LoadEffectTitleOrFrame(
                player_title.title,
                tb.obj_titleEffect,
                function(trans)
                    if self.curShowEffTitle[index] ~= player_title.title then
                        trans:DestroyObject()
                        return
                    end
                    local parClip = trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                    parClip.NeedCheck = true
                    parClip.CheckCount = 10
                    parClip.CheckOne = 3
                    trans:SetLocalScaleXYZ(titleScale)
                end
            )
        end
        tb.aorrawimage_title:SetActiveE(0)
    end
end

---初始化参数
function CommonRankBasePanel:InitParams()
    self.zoneTipId = 0
    self:OnInitParams()
end

function CommonRankBasePanel:InitView()
    local noAward = _G.table.isEmptyOrNil(self.awardTgLis)
    self.go_table.aorbtn_award:SetActiveE(noAward and 0 or 1)
    if not _G.table.isEmptyOrNil(self.awardRedPoint) then
        if #self.awardRedPoint == 1 then
            self.go_table.obj_redpointAward:UpdateRedPointItemIDAndParam(self.awardRedPoint[1])
        else
            self.go_table.obj_redpointAward:UpdateRedPointItemIDAndParam(self.awardRedPoint[1], self.awardRedPoint[2])
        end
    end
    self:InitRankToggle()
    if not noAward then
        self:InitAwardToggle()
    end
end

---初始化排行榜toggle
function CommonRankBasePanel:InitRankToggle()
    self.rankToggles = {}
    self.rankScrolls = {}
    local count = 0
    ---@type _obj_main._toggle_zone_GoTable|_obj_main._toggle_server_GoTable
    local obj, tb, type
    for i = 1, #self.rankTgLis do
        type = self.rankTgLis[i].type
        ---是单榜，或者总榜已开启
        if type ~= 2 or self:CheckZoneIsOpen() then
            count = count + 1
            obj = self.typeRankTg[type]
            tb = GetAutoGoTable(obj, handlerbind(self, self.OnRankToggle, i, handler(self, self.rankTgLis[i].func)))
            tb.aortext_label.text = type == 2 and _G.GetLangPackValue(90000010782) or _G.GetLangPackValue(90029800001)
            tb.aortext_label.fontSize = 22
            self.rankToggles[i] = tb
            if type == 2 then
                self.zoneIndex = i
            end
        end
    end
    self.go_table.obj_rankToggles:SetActiveE(0)
end

---初始化奖励toggle
function CommonRankBasePanel:InitAwardToggle()
    self.awardToggles = {}
    self.awardScrolls = {}
    local count = #self.awardTgLis
    ---@type _obj_main._toggle_item_GoTable
    local obj, tb, redPoint
    for i = 1, count do
        obj = _G.InstantiateObject(self.go_table.toggle_item, self.go_table.obj_awardToggles)
        obj:SetActiveE(1)
        tb = GetAutoGoTable(obj, handlerbind(self, self.OnAwardToggle, i, handler(self, self.awardTgLis[i].func)))
        tb.aortext_label.text = _G.GetLangPackValue(self.awardTgLis[i].label)
        redPoint = self.awardTgLis[i].redPoint
        if not _G.table.isEmptyOrNil(redPoint) then
            if #redPoint == 1 then
                tb.obj_redpoint:UpdateRedPointItemIDAndParam(redPoint[1])
            else
                tb.obj_redpoint:UpdateRedPointItemIDAndParam(redPoint[1], redPoint[2])
            end
        end
        self.awardToggles[i] = tb
    end
    if count == 1 then
        self.go_table.obj_awardToggles:SetActiveE(0)
    end
end

function CommonRankBasePanel:OnRankToggle(go, isOn, index, call)
    local tb = self.rankToggles[index]
    ---@type RankTgData
    local data = self.rankTgLis[index]
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    local color = isOn and "400e0e" or "c6b69d"
    tb.aortext_label.color = _G.ColorTools.FormatColorByString(color)
    if not isOn then
        return
    end
    self.go_table.aortext_title.text = _G.GetLangPackValue(data.title)
    if data.type == 2 then
        self.go_table.aorimage_tipBg:SetActiveE(0)
        self.go_table.obj_zone:SetActiveE(1)
        self.go_table.aortext_tip.text = ""
    elseif data.tip then
        self.go_table.aorimage_tipBg:SetActiveE(1)
        self.go_table.obj_zone:SetActiveE(0)
        self.go_table.aortext_tip.text = _G.GetLangPackValue(data.tip)
    else
        self.go_table.aorimage_tipBg:SetActiveE(0)
        self.go_table.obj_zone:SetActiveE(0)
        self.go_table.aortext_tip.text = ""
    end
    if not data.init then
        self.curRankIndex = index
        local scrollTb = self:InitNewScroll(data, true)
        self:UpdateScrollTransform(scrollTb, data.type == 2 or data.tip, not data.hideSelf)
        self.rankScrolls[index] = scrollTb
        self:ShowRankScroll(index)
        if call then
            call(scrollTb)
        end
        data.init = true
    else
        self:ShowRankScroll(index)
        if index ~= self.curRankIndex then
            self.curRankIndex = index
            self:OnInitRankEnd()
        end
    end
end

function CommonRankBasePanel:OnAwardToggle(go, isOn, index, call)
