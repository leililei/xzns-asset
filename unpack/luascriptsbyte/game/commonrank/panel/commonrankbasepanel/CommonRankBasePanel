---刷新奖励2
function CommonRankBasePanel:RefreshZoneReward(index, obj)
    local newindex = index + 1
    local obj1 = obj:GetChildE(obj:GetChildCountE() - 1)
    local tb = _G.GetAutoGoTable(obj1)
    ---@type boss_rank_cfg
    local data = self.nowZoneAward[newindex]
    tb.data = data
    tb.aorimage_rank:SetActiveE((newindex <= 3 and data.max_rank == data.min_rank) and 1 or 0)
    local text
    if newindex <= 3 and data.max_rank == data.min_rank then
        tb.aorimage_rank.SpriteName = rankIcon[newindex]
        text = ""
        for i = 1, 3 do
            tb["aortext_rankNum" .. i]:SetActiveE(i == newindex and 1 or 0)
        end
    elseif data.min_rank and data.min_rank == data.max_rank then
        text = newindex
    elseif data.ranks and data.ranks[1] and data.ranks[2] then
        text = _G.string.format("%s~%s", data.ranks[1], data.ranks[2])
    else
        text = _G.string.format("%s~%s", data.min_rank, data.max_rank)
    end
    tb.aortext_score.text = text ~= "" and _G.GetLangPackValue(90022100031, text) or ""
    if tb.data then
        self:ShowZoneAward(tb, tb.obj_Award, tb.data.rewards or tb.data.reward_daily or tb.data.award)
    else
        self:ShowZoneAward(tb, tb.obj_Award, {})
    end
end

function CommonRankBasePanel:ShowZoneAward(tb, obj, award)
    if not tb.list then
        tb.list = {}
    end
    local count = #tb.list
    local count2 = #award
    for i = 1, count do
        if i <= count2 then
            tb.list[i]:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(award[i]))
            tb.list[i].gameObject:SetActiveE(1)
        else
            tb.list[i].gameObject:SetActiveE(0)
        end
    end
    if count < count2 then
        for i = count + 1, count2 do
            local obj2 = _G.InstantiateObject(obj)
            obj2:SetParentE(tb.trans_Content)
            local item = require "BaseAwardNewItem".New(obj2, nil, 58, obj2:GetChildE(0))
            tb.list[i] = item
            local data = award[i]
            if data.type then
                data = data.type
            end
            item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data), function()
                -- item.item:ShowEffectOrder(true)
            end)
            item.gameObject:SetActiveE(1)
        end
    end
end

