---获取信息
function CommonRankBasePanel:GetZoneInfo()
    if not self.playerInfo then
        ---@param msg zone.s2c_zone_rank_index
        require("ZoneRankModel"):GetInstance():GetZoneSelfRankInfo(
            self.sysType,
            self.activityId,
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                self.playerInfo = msg.index_info or { dan = 0, index = 0 }
                self.selectDan = self.playerInfo.dan == 0 and 1 or self.playerInfo.dan
                self.selectZone = msg.index_info and msg.index_info.zone_id or -1
                if self.selectZone >= 0 then
                    ---@param msg2 zone.s2c_zone_rank_info
                    require("ZoneRankModel"):GetInstance():GetZoneRankInfo(
                        self.sysType,
                        self.curPage,
                        self.selectZone,
                        self.activityId,
                        self.selectDan,
                        function(msg2)
                            if msg2.ack ~= 1 then
                                return
                            end
                            self.info = msg2.rank_info
                            self:InitZoneRank()
                            self:InitZonePlayer(self.playerInfo)
                            if self.info and self.info.ranks and #self.info.ranks == 100 then
                                self.canNext = true
                            else
                                self.canNext = false
                            end
                        end
                    )
                else
                    self.info = {}
                    self:InitZoneRank()
                    self:InitZonePlayer(self.playerInfo)
                    if self.info and self.info.ranks and #self.info.ranks == 100 then
                        self.canNext = true
                    else
                        self.canNext = false
                    end
                end
            end
        )
    else
        if self.selectZone < 0 then
            return
        end
        ---@param msg2 zone.s2c_zone_rank_info
        require("ZoneRankModel"):GetInstance():GetZoneRankInfo(
            self.sysType,
            self.curPage,
            self.selectZone,
            self.activityId,
            self.selectDan,
            function(msg2)
                if msg2.ack ~= 1 then
                    return
                end
                self.info = msg2.rank_info
                self:InitZoneRank()
                if self.info and self.info.ranks and #self.info.ranks == 100 then
                    self.canNext = true
                else
                    self.canNext = false
                end
            end
        )
    end
end

---初始化排行榜
function CommonRankBasePanel:InitZoneRank()
    self.curZone = self.playerInfo.zone_id
    self.ranks = self.info.ranks or {}
    if self.selectZone == 0 then
        self.selectZone = self.curZone
    end

    -- self.go_table.aortext_curZone.text = _G.GetLangPackValue(90000010781, self.selectZone)
    self.go_table.aortext_curZone.text = ""
    local zone = require("ZoneRankModel"):GetInstance():GetDan(self.selectDan)
    self.go_table.aortext_curDanZone.text = _G.GetLangPackValue(zone[2])
    self.zoneTb.obj_player:SetActiveE(
        (self.selectZone == self.curZone and self.selectDan == self.playerInfo.dan) and 1 or 0
    )
    local showSelf = self.selectZone == self.curZone and self.selectDan == self.playerInfo.dan
    self:UpdateScrollTransform(self.zoneTb, true, showSelf)
    -- self.zoneTb.obj_no:SetActiveE(#self.ranks == 0 and 1 or 0)
    self.zoneTb.scrollloopvectical_listBase:SetActiveE(1)
    if not self.rankInit then
        self.zoneTb.scrollloopvectical_listBase:SetRectTransformSize(682, -692)
        self.zoneTb.scrollloopvectical_listBase:SetAnchorPosition(0, -560)
        local _, y = self.zoneTb.scrollloopvectical_listBase:GetRectTransformSize()
        self.zoneTb.scrollloopvectical_listBase:UpdateScrollRectHeight(y)
        self.zoneTb.scrollloopvectical_listBase:InitItemData(#self.ranks, _G.handler(self, self.RefreshZoneRankItem))
        self.rankInit = true
    else
        self.zoneTb.scrollloopvectical_listBase:UpdateCount(#self.ranks)
    end
    self:GetZoneRoleStyle()
end

function CommonRankBasePanel:GetZoneRoleStyle()
    local pbData = { roles = {} }
    local roles = {}
    local info, text
    for i = 1, 3 do
        info = self.ranks[i]
        if info then
            _G.table.insert(pbData.roles, info.role_info.uid)
            text = self:SpecialTextProcess(self.spCfg.text_type[2], info.rank_info[1], info.rank_info)
            _G.table.insert(
                roles,
                {
                    sid = 0,
                    uid = info.role_info.uid,
                    name = info.role_info.name,
                    score = self.zoneTitleTop and self.zoneTitleTop .. text or text,
                }
            )
        else
            _G.table.insert(roles, { sid = 0 })
        end
    end
    self.rankTgLis[self.zoneIndex].roles = roles
    self:GetRoleStyle(pbData, roles)
end

