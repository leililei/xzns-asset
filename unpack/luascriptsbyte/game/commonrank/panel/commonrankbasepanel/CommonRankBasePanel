                    end,
                    nil,
                    nil,
                    1,
                    true,
                    msg.fight_arg,
                    nil,
                    nil,
                    nil,
                    nil,
                    nil,
                    nil,
                    nil,
                    nil,
                    nil,
                    nil,
                    nil,
                    { leftName, rightName } --reportParams
                )
            end
        )
    end
end

function CommonRankBasePanel:GetNextPage()
    self.curPage = self.curPage + 1
    require("ZoneRankModel"):GetZoneRankInfo(
        self.sysType,
        self.curPage,
        self.selectZone,
        self.activityId,
        self.selectDan,
        function(msg2)
            if msg2.ack ~= 1 then
                return
            end
            if msg2.rank_info and msg2.rank_info.ranks then
                _G.table.insertto(self.ranks, msg2.rank_info.ranks)
                if #msg2.rank_info.ranks == 100 then
                    self.canNext = true
                else
                    self.canNext = false
                end
            else
                self.canNext = false
            end
            self.zoneTb.scrollloopvectical_listBase:UpdateCount(#self.ranks)
        end
    )
end

