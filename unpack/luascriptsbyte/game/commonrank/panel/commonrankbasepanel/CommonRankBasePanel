---界面的入口函数
function CommonRankBasePanel:OnCreate()
    self.shadowNode = {
        self.go_table.aorimage_yingzi1,
        self.go_table.aorimage_yingzi2,
        self.go_table.aorimage_yingzi3
    }
    self.typeRankTg = {
        self.go_table.toggle_server,
        self.go_table.toggle_zone
    }
    self.go_table.obj_topInfo:SetActiveE(0)
    self.top3Tb = {
        GetAutoGoTable(self.go_table.obj_info1),
        GetAutoGoTable(self.go_table.obj_info2),
        GetAutoGoTable(self.go_table.obj_info3)
    }
    for i = 1, 3 do
        _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.CommonRankItem .. i, self.top3Tb[i])
    end
    self.roleTrans = {}
    self.halo = {}
    self.title = {}
    --TODO:计算缩放比例
    self.scale = 0.2
    self.titleScale = _G.ConfigManager.discrete_cfg[103902][1][1] * 0.0035
    if _G.CS.Launcher.Inst.UIScaler.matchWidthOrHeight < 0.5 then
        --适配宽 分辨率比例小于 16：9
        local screenSize = _G.CS.Launcher.Inst.ScreenSize
        self.scale = self.scale * _G.AppSetting.CONFIG_SCREEN_HEIGHT / screenSize.y
    end
    --self.isRankPanel = true
    self:InitView()
    _G.PoolsManager:GetInstance():Spawn(
        self.itemPath,
        _G.ePoolType.Temporary,
        self.go_table.obj_temp,
        function(trans)
            if self:IsNil() then
                _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.Temporary)
                return
            end
            self.tempTable = GetAutoGoTable(trans)
            self.typeRankTg[self.rankTgLis[1].type].isOn = true
            self:SwitchRankOrAward()
        end
    )
    self:AddComponent(self.go_table.obj_PlayerHead, require("PlayerComponent").New(self.go_table.obj_PlayerHead))
    --self:LoadScene()
    self:LoadSceneComplete()
    --self:SwitchRankOrAward()
end

