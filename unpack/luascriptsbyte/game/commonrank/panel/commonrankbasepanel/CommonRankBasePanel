--region ----------- 排名数据实时刷新 -----------


--单榜
---检查排行榜个人数据最新值，如果跟最新值不一样，则替换
---@param playerInfo table 排行榜个人数据（必须与排行榜单挑数据格式一样）
---@param valua1 string 排序字段1
---@param valua2 string 排序字段2
---@param infoValua1 string 排行榜最新个人数据1
---@param infoValua2 string 排行榜最新个人数据2
function CommonRankBasePanel:CheckPlayerInfo(playerInfo, valua1, infoValua1, value2, infoValua2)
    if infoValua1 then
        if infoValua1 ~= playerInfo[valua1] then
            playerInfo[valua1] = infoValua1
        end
    end
    if infoValua2 then
        if infoValua2 ~= playerInfo[value2] then
            playerInfo[value2] = infoValua2
        end
    end
end

---排行榜数据排序
---@param rankList table[] 排行榜数据(必须包含uid字段，用于判断是否为自己)
---@param playerInfo table 排行榜个人数据（必须与排行榜单挑数据格式一样，并且是最新数据）
---@param valua1 string 排序字段1
---@param valua2 string 排序字段2
---@return table[],number 排行榜数据,个人排名
function CommonRankBasePanel:CheckRankList(rankList, playerInfo, valua1, valua2)
    local playerInfoIndex
    if playerInfo[valua1] or playerInfo[valua2] then
        local needCheck = false

        if playerInfo[valua1] and playerInfo[valua1] ~= 0 then
            needCheck = true
        end
        if playerInfo[valua2] and playerInfo[valua2] ~= 0 then
            needCheck = true
        end

        if needCheck then
            local needRank = false
            local haveSelf = false
            for k, v in ipairs(rankList) do
                if v.uid == _G.PlayerModel:GetInstance().role_uid then
                    playerInfoIndex = k
                    haveSelf = true
                    if v[valua1] ~= playerInfo[valua1] then
                        v[valua1] = playerInfo[valua1]
                        needRank = true
                    end
                    if valua2 then
                        if v[valua2] ~= playerInfo[valua2] then
                            v[valua2] = playerInfo[valua2]
                            needRank = true
                        end
                    end
                    break
                end
            end
            if haveSelf == false then
                _G.table.insert(rankList, playerInfo)
                needRank = true
            end
            if needRank then
                _G.table.sort(rankList, function(a, b)
                    if a[valua1] ~= b[valua1] then
                        return a[valua1] > b[valua1]
                    end
                    if a[valua2] then
                        if a[valua2] ~= b[valua2] then
                            return a[valua2] > b[valua2]
                        end
                    end
                end)
                for k, v in ipairs(rankList) do
                    v.index = k
                    if v.uid == _G.PlayerModel:GetInstance().role_uid then
                        playerInfoIndex = k
                    end
                end
            end
        end
    end
    return rankList, playerInfoIndex
end

