    end
    if index <= 3 then
        tb.aorimage_rank.SpriteName = rankIcon[index]
    else
        tb.aortext_rank.text = index
    end
    for i = 1, 3 do
        tb["aortext_rankNum" .. i]:SetActiveE(i == index and 1 or 0)
    end
    local text = self:SpecialTextProcess(self.spCfg.text_type[2], rankInfo[1], rankInfo)
    tb.aortext_score.text = self.zoneTitle and self.zoneTitle .. text or text
    tb.index = index
    tb.aortext_name.text = roleInfo.name
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, roleInfo, 0.7, true, true, true)
    if self.canNext and self.nextPageNumList[index + 1] then
        self:GetNextPage()
    end
