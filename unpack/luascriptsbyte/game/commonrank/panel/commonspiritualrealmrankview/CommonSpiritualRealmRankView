---展示节点数据
---@param item _obj_CommonRankSpiritualRealm._obj_scoreAward_GoTable | {data : any, award: any, state: number}
---@param data arena_layer_league_cfg
function CommonSpiritualRealmRankView:ShowScoreAwardItem(item, data)
    if not item or not data then
        return
    end
    --标题
    item.aortext_name.text = _G.GetLangPackValue(data.describe[2])
    --分数信息
    if data.min_score == data.max_score then
        item.aortext_score.text = tostring(data.min_score)
    else
        item.aortext_score.text = data.min_score .. "~" .. data.max_score
    end
    --徽章
    local badgeIcon = utils.getBadgeIcon(data.min_score)
    if badgeIcon then
        item.aorrawimage_badge:LoadImage(badgeIcon)
    end
    item.aorrawimage_badge:SetActiveE(badgeIcon and 1 or 0)

    --显示奖励
    local isInitAward = item.award
    local award = data["reward_season" .. self.joinType] or {}
    --获取奖励状态: 0可领取, 1不可领取(未达成目标), 2已领取
    local state =
        item ~= self.selfScoreAwardItem and require("SpiritualRealmModel"):GetInstance():GetStageAwardState(data.id) or
        -1
    item.aorbtn_getAward:SetActiveE(state == 0 and 1 or 0)

    --将数据缓存在item上, scrollloophorizontal回调时从item缓存上读取
    item.data = data
    item.award = award
    item.state = state
    if isInitAward then
        item.scrollloophorizontal_award:UpdateCount(#award)
    else
        ---注册刷新函数
        local itemViewMapping, gotableMapping = {}, {}
        item.scrollloophorizontal_award:InitItemData(
            #award,
            ---@param obj UnityEngine.GameObject
            function(index, obj)
                local instanceId = obj:GetInstanceIDE()
                ---获取奖励奖励
                ---@type itemViewNewWithCount
                local awardItem = itemViewMapping[instanceId]
                if not awardItem then
                    awardItem = require("itemViewNewWithCount").New(obj:GetChildE(0))
                    itemViewMapping[instanceId] = awardItem
                end
                local o, state = item.award[index + 1], item.state
                awardItem:Show(o[1], nil, o[2])
                ---奖励状态
                ---@type _obj_CommonRankSpiritualRealm._obj_scoreAwardItem_GoTable
                local gotable = gotableMapping[instanceId]
                if not gotable then
                    gotable = _G.GetAutoGoTable(obj) or {}
                    gotableMapping[instanceId] = gotable
                end
                gotable.obj_alreadyGet:SetActiveE(state == 2 and 1 or 0)
            end
        )
    end
end
---展示自己的节点数据
---@param item _obj_CommonRankSpiritualRealm._obj_scoreAward_GoTable
---@param score number
function CommonSpiritualRealmRankView:ShowSelfScoreAwardItem(item, score)
    if not item or not self.scoreAwardList then
        return
    end

    --查找自己的分数信息
    ---@type arena_layer_league_cfg
    local data
    for _, v in pairs(self.scoreAwardList) do
        if score >= v.min_score and score <= v.max_score then
            data = v
            break
        end
    end
    if not data then
        return
    end

    self:ShowScoreAwardItem(item, data)
    --我的信息
    item.aortext_name.text = _G.GetLangPackValue(data.describe[1])
    item.aortext_score.text = tostring(score)
end
---如果有可领取的奖励, 跳转到指定位置
---@param score number
function CommonSpiritualRealmRankView:JumpScoreAwardIndex(score)
    if not self.scoreAwardList or not self.scoreAwardScrollloopvectical then
        return
    end

    local len, lastIndex = #self.scoreAwardList, -1
    for i = 1, len do
        local index = len - i + 1 --倒序查找
        local d = self.scoreAwardList[index]
        if d.min_score <= score then
            local state = require("SpiritualRealmModel"):GetInstance():GetStageAwardState(d.id) or -1
            if state == 0 then
                lastIndex = index
                break
            elseif state == 2 then
                lastIndex = index - 1 --显示已领取奖励的顺序下一个(从高到底排序, 因此减1)
            end
        else
            break
        end
    end
    if lastIndex >= 1 then
        self.scoreAwardScrollloopvectical:ScrollToIndex(lastIndex - 1) --C#下标从0开始
    end
end
---领取所有奖励
function CommonSpiritualRealmRankView:GetAllScoreAwards()
    if not self.scoreAwardList then
        return
    end
    if not self.scoreAwardItems then
        return
    end
    ---@type number[]   可以领取奖励的项
    local lstAwardIds = {}
    for _, d in pairs(self.scoreAwardList) do
        local state = require("SpiritualRealmModel"):GetInstance():GetStageAwardState(d.id)
        if state == 0 then
            table.insert(lstAwardIds, d.id)
        end
    end
    if #lstAwardIds == 0 then
        return
    end

    require("SpiritualRealmModel"):GetInstance():GetStageAward(
        lstAwardIds,
        function(resp)
            if not resp or resp.ack ~= 1 then
                return
            end
            --刷新界面显示
            if self.scoreAwardList and self.scoreAwardScrollloopvectical then
                self.scoreAwardScrollloopvectical:UpdateCount(#self.scoreAwardList)
            end
            if self.selfData then
                self:JumpScoreAwardIndex(self.selfData.score)
            end
        end
    )
end
--endregion

--region 类型声明

---@class RankData 排行榜数据
---@field score number
---@field role_info.uid number
---@field role_info.level number
---@field role_info.power number
---@field role_info.style number
---@field role_info.name string
---@field role_info.frame string

--endregion

return CommonSpiritualRealmRankView
