---@type numebr 默认初始化节点数量
local DEFAULT_INIT_COUNT = 0
---@type numebr 顶级玩家展示数量
local TOP_PLAYER_COUNT = 3
---红点奖励ID
local AWARD_RED_POINT_ID = 206202

---@type string[] 前三排名图标
local RANK_ICON_IMAGES = {
    "tz_qjhs_phb_mingci_01",
    "tz_qjhs_phb_mingci_02",
    "tz_qjhs_phb_mingci_03"
}

--- 工具类方法
local utils = {
    ---获取段位徽章
    ---@param score number
    ---@return string
    getBadgeIcon = function(score)
        for _, v in pairs(_G.ConfigManager.arena_layer_league_cfg) do
            if score >= v.min_score and score <= v.max_score then
                return v.icon
            end
        end
        return nil
    end,
    ---创建空的顶级玩家数据
    ---@return RankTop3Role
    createTopEmptyData = function()
        return {sid = 0}
    end,
    ---添加一些数据
    ---@generic T
    ---@param target T[]
    ---@param source T[]
    insertMany = function(target, source)
        if not target or not source then
            return
        end
        for _, v in ipairs(source) do
            table.insert(target, v)
        end
    end
}

