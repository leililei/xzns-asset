---展示节点数据
---@param item _obj_CommonRankSpiritualRealm._obj_rankAward_GoTable
---@param data arena_rank_cfg
function CommonSpiritualRealmRankView:ShowRankAwardItem(item, data)
    if not item or not data then
        return
    end
    --排名信息
    if data.max_rank >= 9999 then
        item.aortext_rank.text = _G.GetLangPackValue(90029400146, data.min_rank)
    elseif data.min_rank == data.max_rank then
        item.aortext_rank.text = _G.GetLangPackValue(90029400144, data.min_rank)
    else
        item.aortext_rank.text = _G.GetLangPackValue(90029400145, data.min_rank, data.max_rank)
    end

    --显示奖励
    local lstAward = {}
    utils.insertMany(lstAward, data.reward_daily)
    utils.insertMany(lstAward, self:FindManyItemByType(data.reward_appearance))
    self:ShowRankAwardList(item, lstAward)
end
---展示自己的节点数据
---@param item _obj_CommonRankSpiritualRealm._obj_rankAward_GoTable
---@param data arena_rank_cfg
function CommonSpiritualRealmRankView:ShowSelfRankAwardItem(item, index)
    if not item then
        return
    end

    --查找自己的排名信息
    ---@type arena_rank_cfg
    local data
    for _, v in pairs(self.rankAwardList) do
        if index >= v.min_rank and index <= v.max_rank then
            data = v
            break
        end
    end
    if not data then
        return
    end

    self:ShowRankAwardItem(item, data)
    --我的信息
    item.aortext_rank.text = tostring(index)
end
