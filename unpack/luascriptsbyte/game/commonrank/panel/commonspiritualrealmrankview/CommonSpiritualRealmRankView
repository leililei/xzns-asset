---初始化排行奖励
---@param tb _obj_main._obj_scrollPrefab_GoTable
function CommonSpiritualRealmRankView:InitRankAward(tb)
    --初始化数据
    self.rankAwardList = {}
    local cfg = _G.ConfigManager.arena_layer_up_cfg[self.joinType]
    if cfg and cfg.rank_season then
        for _, id in pairs(cfg.rank_season) do
            local d = _G.ConfigManager.arena_rank_cfg[id]
            if d then
                table.insert(self.rankAwardList, d)
            end
        end
    end
    --进行排序(从高到底)
    _G.SortList(
        self.rankAwardList,
        function(v)
            return -v.min_rank
        end
    )
    --初始化列表显示
    tb.scrollloopvectical_listBase:InitItemData(#self.rankAwardList, _G.handler(self, self.RefreshRankAwardItem))

    --初始化自身Item状态
    self.selfRankAwardItem = _G.GetAutoGoTable(tb.obj_player:GetChildE(tb.obj_player:GetChildCountE() - 1))
    if self.selfData then
        self:ShowSelfRankAwardItem(self.selfRankAwardItem, self.selfData.index)
    end
end
