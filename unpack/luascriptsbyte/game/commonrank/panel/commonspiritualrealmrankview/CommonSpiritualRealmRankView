---通过类型查找物品
---@param list number[][]
---@return number[][]
function CommonSpiritualRealmRankView:FindManyItemByType(list)
    if not list or #list == 0 then
        return nil
    end
    --TODO: 循环查找效率太慢, 考虑字典缓存!!!
    local results = {}
    for _, v in pairs(list) do
        local type, sid = table.unpack(v)
        sid = tostring(sid)
        for _, item in pairs(_G.ConfigManager.item_cfg) do
            if item.UseType == type and item.UseParameter[1][1] == sid then
                _G.table.insert(results, {item.ID, 1})
                break
            end
        end
    end
    return results
end
---加载奖励列表(排名奖励)
---@param item _obj_CommonRankSpiritualRealm._obj_rankAward_GoTable
---@param lstAward number[][]
function CommonSpiritualRealmRankView:ShowRankAwardList(item, lstAward)
    ---@type any[] 存储奖励节点列表
    local lstAwardItems = item.lstAwardItems
    if lstAwardItems then
        --回收旧的节点
        for i = 1, #lstAwardItems do
            _G.ItemFactory:GetInstance():SetItemCard(lstAwardItems[i])
        end
    end
    if not lstAward or #lstAward == 0 then
        item.lstAwardItems = nil
        return
    end

    lstAwardItems = {}
    item.lstAwardItems = lstAwardItems
    --显示奖励
    for i = 1, #lstAward do
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemBaseWithCount,
            item.trans_awardRoot,
            function(awardItem)
                if _G.IsNil(self) or item.lstAwardItems ~= lstAwardItems then
                    _G.ItemFactory:GetInstance():SetItemCard(awardItem)
                    return
                end
                table.insert(lstAwardItems, awardItem)
                awardItem.gameObject:SetLocalScale(0.65, 0.65, 0.65)
                awardItem:Show(lstAward[i][1], nil, lstAward[i][2])
            end
        )
    end
end

--region 排行榜视图

---初始化排行榜
---@param tb _obj_main._obj_scrollPrefab_GoTable
function CommonSpiritualRealmRankView:InitRank(tb)
    --默认初始化n个空位
    tb.scrollloopvectical_listBase:InitItemData(DEFAULT_INIT_COUNT, _G.handler(self, self.RefreshRankItem))
    self.initRankParam.roles = {}
    for _ = 1, TOP_PLAYER_COUNT do
        table.insert(self.initRankParam.roles, utils.createTopEmptyData())
    end
    self:OnInitRankEnd()

    --玩家当前信息
    ---@type _obj_CommonRankSpiritualRealm._obj_rank_GoTable self
    local selfItem = _G.GetAutoGoTable(tb.obj_player:GetChildE(tb.obj_player:GetChildCountE() - 1))
    ---@type RankData
    local selfData = {score = 0, role_info = _G.PlayerModel:GetInstance():GetIRroleTable() or {}}
    self:ShowRankItem(selfItem, -1, selfData)

    ---将自己的数据插入排行榜中
    ---@param list RankData[]
    ---@param selfData RankData
    local function insertSelfToList(list, selfData)
        if not list or not selfData then
            return
        end
        local count = #list
        if count < 3 then
            count = 3
        end

        local selfUid = selfData.role_info.uid
        local selfScore = selfData.score
        --从排行榜中移除自己的数据
        for i = 1, count do
            if list[i] and selfUid == list[i].role_info.uid then
                table.remove(list, i)
                break
            end
        end
        --将当前数据插入排行榜
        local rank = -1
        for i = 1, count do
            if not list[i] or not list[i].role_info or selfScore > list[i].score then
                rank = i
                table.insert(list, i, selfData)
                break
            end
        end
        --之后的玩家重新进行排名
        if rank > 0 then
            for i = rank, #list do
                list[i].rank = i
            end
        end
    end

    ---展示排行榜列表和前三玩家形象
    local function showRankList()
        local count = #self.rankList
        if count < DEFAULT_INIT_COUNT then
            count = DEFAULT_INIT_COUNT
        end
        tb.scrollloopvectical_listBase:UpdateCount(count)

        ---@type RankTop3Role[]
        local roles = {}
        --拉取前三玩家角色形象
        ---@type number[]
        local pbData = {roles = {}}
        for i = 1, TOP_PLAYER_COUNT do
            local d = self.rankList[i]
            if d then
                table.insert(pbData.roles, d.role_info.uid)
                table.insert(
                    roles,
                    {
                        sid = 0,
                        uid = d.role_info.uid,
                        name = d.role_info.name,
                        score = _G.GetLangPackValue(90030700030, d.score)
                    }
                )
            else
                table.insert(roles, utils.createTopEmptyData())
            end
        end
        self.initRankParam.roles = roles
        self:GetRoleStyle(pbData, roles)
    end

    --拉取数据
    ---玩家形象回调
    local function onStyleResponse(data)
        ---@type table<number,number>
        local skins = {}
        if data and data.roles then
            for _, v in pairs(data.roles) do
                skins[v.uid] = v.skin
            end
        end

        ---@type RankTop3Role[]
        local roles = {}
        for i = 1, TOP_PLAYER_COUNT do
            local d = self.rankList and self.rankList[i]
            if d then
                table.insert(
                    roles,
                    {
                        sid = skins[d.role_info.uid] or 0,
                        uid = d.role_info.uid,
                        name = d.role_info.name,
                        score = _G.GetLangPackValue(90030700030, d.score)
                    }
                )
            else
                table.insert(roles, utils.createTopEmptyData())
            end
        end
        self.initRankParam.roles = roles
        self:OnInitRankEnd()
    end
    ---排行榜数据回调
    ---@param data any
    local function onRankListResponse(data)
        self.rankList = (data and data.ranks) or {}
        insertSelfToList(self.rankList, selfData)
        showRankList()
    end
    ---自身排行回调
    ---@param data any
    local function onSelfResponse(data)
        if not data or data.ack ~= 1 then
            if data then
                _G.PopWindowManager:GetInstance():ShowAllTips(data.ack)
            end
            return
        end
        local index, score = data.index, data.value
        selfData.score = score
        if self.rankList then
            insertSelfToList(self.rankList, selfData)
            showRankList()
            index = selfData.rank or index
        end

        self:ShowRankItem(selfItem, index, selfData)

        --自身奖励数据
        self.selfData = {score = score, index = index}
        self:ShowSelfRankAwardItem(self.selfRankAwardItem, index)
        self:ShowSelfScoreAwardItem(self.selfScoreAwardItem, score)
        self:JumpScoreAwardIndex(score)
    end

    local net = require("SpiritualRealmNet"):GetInstance()
    if self.joinType == 1 then
        net:GetFirstRankList(1, onRankListResponse)
        net:SelfRank(83, onSelfResponse)
    elseif self.joinType == 2 then
        net:GetTwoRankList(1, onRankListResponse)
        net:SelfRank(84, onSelfResponse)
    elseif self.joinType == 3 then
        net:GetThirdRankList(1, onRankListResponse)
        net:SelfRank(85, onSelfResponse)
    end
end
---刷新排行榜数据
---@param index number      数据序号(C#从0开始)
---@param obj UnityEngine.GameObject
function CommonSpiritualRealmRankView:RefreshRankItem(index, obj)
    if not self.rankItems then
        self.rankItems = {}
    end
    --初始化item节点
    local item = self.rankItems[obj:GetInstanceIDE()]
    if not item then
        item = _G.GetAutoGoTable(obj:GetChildE(obj:GetChildCountE() - 1))
        self.rankItems[obj:GetInstanceIDE()] = item
    end

    index = index + 1
    --设置节点属性
    self:ShowRankItem(item, index, self.rankList and self.rankList[index])
end
---展示节点数据
---@param item _obj_CommonRankSpiritualRealm._obj_rank_GoTable|_obj_CommonRankSpiritualRealm._obj_rankSelf_GoTable
---@param index number
---@param data RankData
function CommonSpiritualRealmRankView:ShowRankItem(item, index, data)
    --排名
    if index > 3 then
        item.aortext_rank.text = tostring(index)
    elseif index >= 1 then
        item.aorimage_rank.SpriteName = RANK_ICON_IMAGES[index]
    end
    item.aorimage_rank:SetActiveE(index >= 1 and index <= 3 and 1 or 0)
    item.obj_rankBg2:SetActiveE(index <= 3 and 0 or 1)
    if item.obj_noRank then
        item.obj_noRank:SetActiveE(index >= 1 and 0 or 1)
    end
    --人物数据
    if data then
        item.aortext_name.text = data.role_info.name or "???"
        item.aortext_score.text = _G.GetLangPackValue(90000010438, tostring(data.score))
        _G.UIUtils.SetPlayerHeadItemNew(
            item.obj_head,
            data.role_info,
            1,
            true,
            nil,
            nil,
            function()
                if not self.gameObject or self.gameObject:IsNull() then
                    return
                end
                if data.role_info.type == 1 then
                    _G.SystemSettingManager:GetInstance():OpenRobotPlayInfo(data.role_info.uid, nil, _G.RobotType.Arena)
                    return
                end
                if data.role_info.uid ~= _G.PlayerModel:GetInstance():GetPlayerUid() then
                    _G.SystemSettingManager:GetInstance():OpenView(data.role_info.uid)
                    return
                end
                _G.PopWindowManager:GetInstance():ShowAllTips(620109)
            end
        )
        --段位徽章
        local badgeIcon = utils.getBadgeIcon(data.score)
        if badgeIcon then
            item.aorrawimage_badge:LoadImage(badgeIcon)
        end
        item.aorrawimage_badge:SetActiveE(badgeIcon and 1 or 0)
    end
    item.obj_content:SetActiveE(data and 1 or 0)
    if item.obj_noBody then
        item.obj_noBody:SetActiveE(data and 0 or 1)
    end
end
