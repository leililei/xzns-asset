---@param tb _obj_main._obj_scrollPrefab_GoTable
function CommonSpiritualRealmRankView:InitScoreAward(tb)
    --初始化数据
    self.scoreAwardList = {}
    for _, v in pairs(_G.ConfigManager.arena_layer_league_cfg) do
        _G.table.insert(self.scoreAwardList, v)
    end
    --进行排序(从高到底)
    _G.SortList(
        self.scoreAwardList,
        function(v)
            return v.min_score
        end
    )
    --初始化列表显示
    tb.scrollloopvectical_listBase:InitItemData(#self.scoreAwardList, _G.handler(self, self.RefreshScoreAwardItem))
    self.scoreAwardScrollloopvectical = tb.scrollloopvectical_listBase

    --初始化自身Item状态
    self.selfScoreAwardItem = _G.GetAutoGoTable(tb.obj_player:GetChildE(tb.obj_player:GetChildCountE() - 1))
    if self.selfData then
        self:ShowSelfScoreAwardItem(self.selfScoreAwardItem, self.selfData.score)
        self:JumpScoreAwardIndex(self.selfData.score)
    end
end
