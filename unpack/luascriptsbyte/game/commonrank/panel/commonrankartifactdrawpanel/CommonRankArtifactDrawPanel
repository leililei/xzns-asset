local baseView = require("CommonRankBasePanel")
local table = _G.table

---@type string[] 前三排名图标
local RANK_ICON_IMAGES = {
    [1] = "0ui_icon_diyi",
    [2] = "0ui_icon_dier",
    [3] = "0ui_icon_disan"
}
---排行榜前三
local TOP_PLAYER_COUNT = 3

---@class CommonRankArtifactDrawPanel : CommonRankBasePanel	神器探寻排行榜
---@field public go_table CommonRankAerifactDrawSinglePanel_GoTable GoTable
local CommonRankArtifactDrawPanel = _G.BaseClass("CommonRankArtifactDrawPanel", baseView)

function CommonRankArtifactDrawPanel:OnCreate(parent, activityId)
    self.itemPath = "UIH5/CommonRank/$_obj_CommonRankArtifactDraw"
    self.activityId = activityId

    ---排行榜类型：1单榜 2战区总榜
    self.rankType = require("ArtifactDrawUpMainModel"):GetInstance():GetRankType(self.activityId)
    self.isSP = require("ArtifactDrawUpMainModel"):GetInstance():IsSP(self.activityId)
    ---排行榜页签
    local initRankParams = {
        type = 1,
        tip = nil,
        itemName = "",
        selfName = "",
        rolse = {},
        itemName = self.isSP and "obj_rankSP" or "obj_rank",
        selfName = "obj_rankSelf",
        func = self.OnRank,
        hideSelf = false
    }
    if self.rankType == 2 then
        initRankParams.title = 90022300116
    else
        initRankParams.title = 90022300115
    end
    self.rankTgLis = {initRankParams}

    ---排行榜奖励
    local initRankAwardParams = {
        label = 90022300117,
        title = 90022300117,
        tip = nil,
        func = self.InitRankAward,
        itemName = "obj_rankAward",
        selfName = "obj_rankAwardSelf",
        hideSelf = true,
        popBol = true   --奖励改成弹窗形式
    }
    self.awardTgLis = {initRankAwardParams}

    self.rankItemList = {}
    self.rankAwardItems = {}
    ---当前排行榜页数
    self.curRankPage = 1
    self.nextPageNumList = {}
    for i = 1, 9 do
        self.nextPageNumList[i * 100] = true
    end
    if not self.curRankIndex then
        self.curRankIndex = 1
    end
    baseView.OnCreate(self)
    ---获取排行榜数据
    self:GetRankInfo()
end

---子类重写
function CommonRankArtifactDrawPanel:UpdateTopInfo()
    baseView.UpdateTopInfo(self)
    self.go_table.obj_no:SetActiveE(table.count(self.allRankData) == 0 and 1 or 0)
end

---获取排行榜数据
function CommonRankArtifactDrawPanel:GetRankInfo(call)
    self.allRankData = {}
    require("ArtifactDrawUpRankModel"):GetInstance():RequestRankInfo(1, self.activityId, function(rankDatas, mineRank, mineValue)
        self.allRankData = rankDatas
        local pbData = {roles = {}}
        ---@type RankTop3Role[]
        local roles = {}
        for i = 1, TOP_PLAYER_COUNT do
            local info = self.allRankData[i]
            if not table.isEmptyOrNil(info) then
                table.insert(pbData.roles, info.role_info.uid)
                table.insert(roles, {
                    sid = 0,
                    uid = info.role_info.uid,
                    name = info.role_info.name,
                    score = _G.GetLangPackValue(90022501068) .. info.draw_times
                })
            else
                table.insert(roles, {sid = 0})
            end
        end
        self.rankTgLis[1].roles = roles
        self:GetRoleStyle(pbData, roles)
        self.mineRank = mineRank
        self.mineValue = mineValue
        if call then
            call()
        end
        ---@type RankTgData
        local data = self.rankTgLis[1]
        local scrollTb = self:InitNewScroll(data, true)
        self:OnRank(scrollTb)
    end)
end

---创建并初始化新的列表窗口
function CommonRankArtifactDrawPanel:InitNewScroll(data, isRank)
    local obj
    if data.popBol then
        obj = self.go_table.obj_Reward
        self.go_table.obj_Reward:SetActiveE(1)
        self.go_table.aorbtn_rank1:SetActiveE(1)
    else
        if self.looplist == nil then
            obj = _G.InstantiateObject(self.go_table.obj_scrollPrefab, self.go_table.obj_scrollLists)
            self.looplist = obj
        else
            obj = self.looplist
        end
    end
    obj:SetActiveE(1)
    ---@type _obj_main._obj_scrollPrefab_GoTable
    local scrollTb = GetAutoGoTable(obj)
    if data.type == 2 then
        --总榜
        if isRank then
            _G.InstantiateObject(self.go_table.obj_rankZone, scrollTb.obj_listItem)
            _G.InstantiateObject(self.go_table.obj_rankZoneSelf, scrollTb.obj_player)
        else
            _G.InstantiateObject(self.go_table.obj_rankZoneAward, scrollTb.obj_listItem)
        end
    else
        if #data.itemName > 0 and not data.popBol then
            if isRank then
                scrollTb.scrollloopvectical_listBase:SetRectTransformSize(682, -824)
                scrollTb.scrollloopvectical_listBase:SetAnchorPosition(0, -560)
            else
                scrollTb.scrollloopvectical_listBase:SetRectTransformSize(682, -600)
                scrollTb.scrollloopvectical_listBase:SetAnchorPosition(0, -320)
            end
            local _, y = scrollTb.scrollloopvectical_listBase:GetRectTransformSize()
            scrollTb.scrollloopvectical_listBase:UpdateScrollRectHeight(y)
        end
        local objItem
        if scrollTb.obj_listItem:GetChildCountE()>1 then
            objItem = scrollTb.obj_listItem:GetChildE(scrollTb.obj_listItem:GetChildCountE()-1)
        else
            objItem= _G.InstantiateObject(self.tempTable[data.itemName], scrollTb.obj_listItem)
        end 
        objItem:SetLocalPositionToZero()
        if not data.hideSelf then
            local objSelf
            if scrollTb.obj_player:GetChildCountE()>1 then
                objSelf = scrollTb.obj_player:GetChildE(scrollTb.obj_player:GetChildCountE()-1)
            else
                objSelf = _G.InstantiateObject(self.tempTable[data.selfName], scrollTb.obj_player)
            end
            objSelf:SetLocalPositionToZero()
        end
    end
    scrollTb.obj_player:SetActiveE(data.hideSelf and 0 or 1)
    self.scrollTb = scrollTb
    return scrollTb
end

function CommonRankArtifactDrawPanel:OnRank(tb)
    if self.allRankData == nil then
        self:GetRankInfo(_G.handlerbind(self, self.InitRankInfo, tb))
    else
        self:InitRankInfo(tb)
    end
end

---初始化排行榜
function CommonRankArtifactDrawPanel:InitRankInfo(tb)
  
    local itemAmount = #self.allRankData
    self.canNext = itemAmount > 100
    if itemAmount > 0 then
        tb.scrollloopvectical_listBase:InitItemData(
            itemAmount, 
            _G.handler(self, self.RefreshRankItem)
        )
        self.scrollloopvectical_listBase = tb.scrollloopvectical_listBase
    end

    self:InitMineRank(tb.obj_player)
end

---初始化自己的排行
function CommonRankArtifactDrawPanel:InitMineRank(obj)
    local tb = _G.GetAutoGoTable(obj:GetChildE(obj:GetChildCountE() - 1))
    if not self.mineRank or self.mineRank == 0 then
        if self:GetTotalTimes() > 0 then
            tb.aortext_noRank:SetActiveE(0)
            tb.obj_rank:SetActiveE(1)
            tb.aortext_rank.text = "1000+"
        else
            tb.aortext_noRank:SetActiveE(1)
            tb.obj_rank:SetActiveE(0)
        end
    else
        tb.aortext_noRank:SetActiveE(0)
        tb.obj_rank:SetActiveE(1)
        tb.aortext_rank.text = self.mineRank
    end
    local playerData = _G.PlayerModel:GetInstance():GetIRroleTable()
    tb.aortext_name.text = playerData.name
    if self.mineValue then
        tb.aortext_score.text = _G.GetLangPackValue(90022501068) .. self.mineValue
    else
        tb.aortext_score.text = _G.GetLangPackValue(90022501068) .. "0"
    end
    _G.UIUtils.SetPlayerHeadItemNew(
        tb.obj_HeadItemBase, 
        playerData, 
        0.7, 
        true, 
        true, 
        false
    )
end

---刷新单榜Item
function CommonRankArtifactDrawPanel:RefreshRankItem(index, obj)
    local newIndex = index + 1
    local tb = self.rankItemList[obj:GetInstanceIDE()]
    if not tb then
        tb = _G.GetAutoGoTable(obj:GetChildE(obj:GetChildCountE() - 1))
        self.rankItemList[obj:GetInstanceIDE()] = tb
    end
    --排名
    if newIndex > 3 then
        tb.aortext_rank.text = newIndex
    elseif newIndex >= 1 then
        tb.aortext_rank.text = ""
        tb.aorimage_rank.SpriteName = RANK_ICON_IMAGES[newIndex]
    end
    tb.aorimage_rank:SetActiveE(newIndex <= 3 and 1 or 0)
    for i = 1, 3 do
        tb["aortext_rankNum" .. i]:SetActiveE(i == newIndex and 1 or 0)
    end
    --头像
    local data = self.allRankData[newIndex]
    if not table.isEmptyOrNil(data) then
        tb.aortext_name.text = data.role_info.name
        if tb.aortext_server then 
            tb.aortext_server.text = _G.ServerManager:GetInstance():GetServerNameByServerID(data.role_info.server_id) 
        end
        tb.aortext_score.text = _G.GetLangPackValue(90022501068) .. data.draw_times
        tb.obj_HeadItemBase:SetActiveE(1)
        _G.UIUtils.SetPlayerHeadItemNew(
            tb.obj_HeadItemBase,
            data.role_info,
            0.7,
            true,
            true,
            false
        )
    else
        tb.aortext_name.text = _G.GetLangPackValue(90000010159)
        tb.obj_HeadItemBase:SetActiveE(0)
        tb.aortext_score.text = ""
        if tb.aortext_server then 
            tb.aortext_server.text = ""
        end
    end
    if self.canNext and self.nextPageNumList[newIndex] then
        self:GetNextPageRankInfo(newIndex)
    end
end

---获取下一页排行榜数据
function CommonRankArtifactDrawPanel:GetNextPageRankInfo(newIndex)
    self.curRankPage = self.curRankPage + 1
    require("ArtifactNet"):GetInstance():GetArtifactDrawUpRankInfo(
        {page = self.curRankPage, id = self.activityId},
        function(msg)
            if not table.isEmptyOrNil(msg.ranks) then
                table.insertto(self.allRankData, msg.ranks)
                if self.scrollloopvectical_listBase then
                    self.scrollloopvectical_listBase:UpdateCount(#self.allRankData)
                end
                self.canNext = true
            else
                self.canNext = false
            end
            self.nextPageNumList[newIndex] = false
        end
    )
end

---初始化排行榜奖励
---@param tb _obj_main._obj_scrollPrefab_GoTable
function CommonRankArtifactDrawPanel:InitRankAward(tb, index)
    ---所有的排行榜奖励
    self.rankAwardList = require("ArtifactDrawUpRankModel"):GetInstance():GetRankAwards(self.activityId)
    --初始化列表显示
    tb.scrollloopvectical_listBase:InitItemData(#self.rankAwardList, _G.handler(self, self.RefreshRankAwardItem))

    --初始化自身Item状态
    if not self.awardTgLis[index].hideSelf then 
        local obj = tb.obj_player:GetChildE(tb.obj_player:GetChildCountE() - 1)
        self.selfRankAwardItem = _G.GetAutoGoTable(obj)
        self:ShowSelfRankAwardItem(self.selfRankAwardItem, obj)
    end
end

---初始化自己排名的奖励
function CommonRankArtifactDrawPanel:ShowSelfRankAwardItem(tb, obj)
    local rankData = {}
    local isShowAward = true
    if not self.mineRank or self.mineRank == 0 then
        if self:GetTotalTimes() > 0 then
            tb.aortext_rank.text = "1000+"
        else
            tb.aortext_rank.text = _G.GetLangPackValue(90022900040)
            tb.aortext_noRankDes:SetActiveE(1)
            isShowAward = false
        end
    else
        tb.aortext_rank.text = self.mineRank
    end
    tb.aortext_noRankDes:SetActiveE(isShowAward and 0 or 1)

    if not self.mineRank then
        rankData = self.rankAwardList[#self.rankAwardList]
    else
        for _, v in pairs(self.rankAwardList) do
            if self.mineRank >= v.min_rank and self.mineRank <= v.max_rank then
                rankData = v
                break
            end
        end 
    end
    tb.ins = obj:GetInstanceIDE()
    if isShowAward then
        self:SetRankAward(rankData.rewards, tb, obj)
    end
end

function CommonRankArtifactDrawPanel:GetTotalTimes()
    return require("ArtifactDrawUpMainModel"):GetInstance():GetTotalTimes(self.activityId)
end

---初始化奖励
function CommonRankArtifactDrawPanel:RefreshRankAwardItem(index, obj)
    local newIndex = index + 1
    local instanceID = obj:GetInstanceIDE()
    local tb = self.rankAwardItems[instanceID]
    if not tb then
        tb = _G.GetAutoGoTable(obj:GetChildE(obj:GetChildCountE() - 1))
        self.rankAwardItems[instanceID] = tb
    end
    tb.ins = instanceID
    --排名信息
    local rankData = self.rankAwardList[newIndex]
    if rankData.max_rank >= 9999 then
        tb.aortext_rank.text = _G.GetLangPackValue(90029400146, rankData.min_rank)
    elseif rankData.min_rank == rankData.max_rank then
        tb.aortext_rank.text = _G.GetLangPackValue(90029400144, rankData.min_rank)
    else
        tb.aortext_rank.text = _G.GetLangPackValue(90029400145, rankData.min_rank, rankData.max_rank)
    end

    --奖励
    local rewards = rankData.rewards
    self:SetRankAward(rewards, tb, obj)
end

---设置排行榜信息和奖励
function CommonRankArtifactDrawPanel:SetRankAward(rewards, tb, obj)
    if not table.isEmptyOrNil(rewards) then
        if tb.lstAwardItems then
            for i = 1, #tb.lstAwardItems do
                tb.lstAwardItems[i].gameObject:SetLocalScaleXYZ(1)
                _G.ItemFactory:GetInstance():SetItemCard(tb.lstAwardItems[i])
            end
        end

        tb.lstAwardItems = {}
        for _, v in pairs(rewards) do
            _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemBaseWithCount,
            tb.trans_awardRoot,
            function(awardItem)
                if _G.IsNil(tb.trans_awardRoot) or tb.ins ~= obj:GetInstanceIDE() then
                    awardItem.gameObject:SetLocalScaleXYZ(0.85)
                    _G.ItemFactory:GetInstance():SetItemCard(awardItem)
                    return
                end
                table.insert(tb.lstAwardItems, awardItem)
                awardItem.gameObject:SetLocalScaleXYZ(0.85)
                local type = _G.StorageManager:GetInstance():CheckSidType(v[1])
                awardItem:Show(v[1],function()
                    require("CommonTipManager"):GetInstance():OpenTip(self.gameObject, v[1])
                end, v[2])
                awardItem:ShowFrameEffect(v[1], true)
            end)
        end
    end
end

---总榜默认是开启的
function CommonRankArtifactDrawPanel:CheckZoneIsOpen()
    return true
end

function CommonRankArtifactDrawPanel:Dispose()
    if baseView.Dispose then
        baseView.Dispose(self)
    end
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.ArtifactDrawUpMainView.Name)
    if window then
       window.View:GetRankInfo() 
    end
end

function CommonRankArtifactDrawPanel:OnRankToggle(go, isOn, index, call)
    local tb = self.rankToggles[index]
    ---@type RankTgData
    local data = self.rankTgLis[index]
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    local color = isOn and "400e0e" or "c6b69d"
    tb.aortext_label.color = _G.ColorTools.FormatColorByString(color)
    if not isOn then
        return
    end
    self.go_table.aortext_title.text = _G.GetLangPackValue(data.title)
    if data.type == 2 then
        self.go_table.aorimage_tipBg:SetActiveE(0)
        self.go_table.obj_zone:SetActiveE(1)
        self.go_table.aortext_tip.text = ""
    elseif data.tip then
        self.go_table.aorimage_tipBg:SetActiveE(1)
        self.go_table.obj_zone:SetActiveE(0)
        self.go_table.aortext_tip.text = _G.GetLangPackValue(data.tip)
    else
        self.go_table.aorimage_tipBg:SetActiveE(0)
        self.go_table.obj_zone:SetActiveE(0)
        self.go_table.aortext_tip.text = ""
    end
    if not data.init then
        self.curRankIndex = index
        local scrollTb = self:InitNewScroll(data, true)
        self:UpdateScrollTransform(scrollTb, data.type == 2 or data.tip, not data.hideSelf)
        self.rankScrolls[index] = scrollTb
        self:ShowRankScroll(index)
        if call then
            call(scrollTb)
        end
        data.init = true
    else
        self:ShowRankScroll(index)
        if index ~= self.curRankIndex then
            self.curRankIndex = index
            self:OnInitRankEnd()
        end
    end
end

return CommonRankArtifactDrawPanel