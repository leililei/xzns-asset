---@class CommonRankView : UIBaseView	中文描述
---@field public go_table CommonRankView_GoTable GoTable
---@field public inEmbattle boolean 是否在布阵页面
local CommonRankView = _G.BaseClass("CommonRankView", _G.UIBaseView)

function CommonRankView:__init()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnTopViewClosed, self)
end
function CommonRankView:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnTopViewClosed, self)
end

function CommonRankView:OnCreate(...)
    --检测是否在布阵页面
    self.inEmbattle = not (not _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.EmbattleView.Name))
    if self.inEmbattle then
        self:SetEmbattleActive(false)
    end

    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonRankTopView.Name, ...)
end

---设置布阵页面显隐
---@param active boolean    是否显示
function CommonRankView:SetEmbattleActive(active)
    local manager = _G.UIManager:GetInstance()

    ---显隐布阵场景root节点
    ---@type EmbattleNewView
    local embattleView = manager:GetWindowCtrl(_G.ConfigManager.ui_cfg.EmbattleView.Name)
    if embattleView and embattleView.sceneRoot then
        embattleView.sceneRoot:SetActiveE(active and 1 or 0)
    end

    ---显隐布阵UI,聊天UI
    ---@type string[]
    local lstUIWindows = {
        _G.ConfigManager.ui_cfg.EmbattleView.Name,
        _G.ConfigManager.ui_cfg.ChatDefultRootView.Name
    }
    for _, name in pairs(lstUIWindows) do
        if active then
            manager:ShowWindow(name)
        else
            manager:HideWindow(name)
        end
    end
end

function CommonRankView:OnTopViewClosed(name)
    if name ~= _G.ConfigManager.ui_cfg.CommonRankTopView.Name then
        return
    end

    self:Close()
    if self.inEmbattle then
        self:SetEmbattleActive(true)
    end
end

return CommonRankView
