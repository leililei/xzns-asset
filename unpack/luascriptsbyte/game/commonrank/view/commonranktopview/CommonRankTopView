---@class CommonRankTopView : UIBaseView	中文描述
---@field public go_table CommonRankTopView_GoTable GoTable
local CommonRankTopView = _G.BaseClass("CommonRankTopView", _G.UIBaseView)

local CRType = _G.CommonRankType
local PanelType = {
    [CRType.ArenaPeak] = "CommonRankArenaPeakPanel",
    [CRType.SpiritualRealm] = "CommonSpiritualRealmRankView",
    [CRType.SeasonTower] = "CommonRankSeasonTowerPanel",
    [CRType.HellGuard] = "CommonRankHellGuardPanel",
    [CRType.WorldBoss] = "CommonRankWorldBossPanel",
    [CRType.BlackSource] = "CommonRankBlackSourcePanel",
    [CRType.FirstTestBoss] = "CommonRankFirstTestBossPanel",
    [CRType.MonsterSiege] = "CommonRankMonsterSiegeBossPanel",
    [CRType.DrawUp] = "CommonRankDrawUpPanel",
    [CRType.ArtifactDrawUp] = "CommonRankArtifactDrawPanel",
    [CRType.PetDrawUp] = "CommonRankPetDrawUpPanel",
    [CRType.Tarot] = "CommonRankTarotPanel",
    [CRType.DecorationBoss] = "CommonRankDecorationBossPanel",
    [CRType.ActivityTrial] = "CommonRankActivityTrialPanel",
    [CRType.SociatyWitchTrials]="CommonRankSociatyWitchTrialsPanel"
}

function CommonRankTopView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function CommonRankTopView:OnCreate(type, args)
    self.type = type
    self.viewPanel = self:AddComponent(self.go_table.obj_main, require(PanelType[type]).New(self, args))
end

---按钮点击事件在这里派发
function CommonRankTopView:OnClickBtn(go, isOn)
end

function CommonRankTopView:OnDestroy()
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.CommonRankView.Name)
end

return CommonRankTopView
