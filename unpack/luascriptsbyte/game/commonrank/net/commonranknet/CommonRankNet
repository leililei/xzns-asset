local base = require("BaseGameNet")

---@class CommonRankNet : BaseGameNet	通信协议
local CommonRankNet = _G.BaseClass("CommonRankNet", base)
---@return CommonRankNet CommonRankNet
function CommonRankNet:GetInstance()
    return  base.GetInstance(self)
end

function CommonRankNet:GetRoleStyle(pbData, callback)
    local item = _G.ConfigManager.net_map.game_rank_role
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function CommonRankNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return CommonRankNet