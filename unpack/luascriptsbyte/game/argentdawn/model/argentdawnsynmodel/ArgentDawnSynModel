local base = require "ActivitySynTypeBase"
---@class ArgentDawnSynModel : ActivitySynTypeBase	中文描述
local ArgentDawnSynModel = _G.BaseClass("ArgentDawnSynModel", base)

function ArgentDawnSynModel:__init()
    if not AppSetting.IsXzns then
        ---客户端收到推送拉取服务器数据的事件
        self.getInfoTime = 0
        ---客户端拉取数据的间隔
        self.interval = 3
        _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.game_activity_argent_dawn_change.Cmd,
                self.ActArgentDawnChange, self)
    end
end

function ArgentDawnSynModel:ActArgentDawnChange(msg)
    if msg.ack == 1 then
        ---ser_code和official_account是从挂接推给服务器，服务器通知客户端有变更；为了避免繁拉推送和频繁拉取数据，每三秒拉取一次
        local serverTime = _G.TimeUtil.GetServerUnixTime()
        if serverTime - self.getInfoTime >= self.interval then
            self:GetActivityInfo()
        else
            if self.actTimer then
               return 
            end
            self.actTimer = _G.TimerManager:GetInstance():GetTimer(self.interval - (serverTime - self.getInfoTime), self.GetActivityInfo, self, true, false)
            self.actTimer:Start() 
        end
    end
end

function ArgentDawnSynModel:GetActivityInfo()
    if self.actTimer then
        self.actTimer:Stop()
        self.actTimer = nil
    end
    self.getInfoTime = _G.TimeUtil.GetServerUnixTime()

    if self.curActivityClass then
        require("ActivitySynNet"):GetInstance():InitActivity(
            self.curActivityClass:GetActivityID(),
            _G.handler(self, self.UpdateInitData)
        )
    end
end

function ArgentDawnSynModel:UpdateInitData(msg)
    if msg.ack == 1 then
        self:OnHandleGMData(msg.activity[1].self_info)
    end
end

function ArgentDawnSynModel:OnHandleGMData(msg)
    self:ParseData(msg)
end

---@param msg activity_argent_dawn.i_activity_argent_dawn
function ArgentDawnSynModel:ParseData(msg)
    msg = msg.argent_dawn or {}
    require("ArgentDawnModel"):GetInstance():SetActivity(self, self.curActivityClass.activityID)
    self.isJoin = msg.join == 1                 --bool(1参加 0没参加)
    self.todayIsAward = msg.is_award == 1       --bool(1今天已领奖 0未领奖)
    self.hasAwardLis = msg.award or {}          --已领sid
    self.officialAccount = msg.official_account --公众号名称
    self.spellCode = msg.user_code              --咒文
    self:InitAwardCfg(msg.award_cfg)
    if not AppSetting.IsXzns then
        self:CheckClose(true)
    end
    base.ParseData(self)
end

---@param awardCfg activity_argent_dawn.i_award_cfg[]
function ArgentDawnSynModel:InitAwardCfg(awardCfg)
    awardCfg = awardCfg or {}
    self.awardCfg = {}
    local num = #awardCfg
    local sid = 0
    for i = 1, num do
        for _, v in pairs(awardCfg) do
            if v.pre_sid == sid then
                sid = v.sid
                _G.table.insert(self.awardCfg, v)
                break
            end
        end
    end
end

function ArgentDawnSynModel:CheckClose(refreshView)
    if not self.isJoin or #self.hasAwardLis >= 3 then
        self.curActivityClass:ChangeState(require("ActivitySynManager").State.Close)
    elseif refreshView then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ArgentDawnLetterView.Name)
        if view then
           view:InitView() 
        end
    end
end

---进入活动主体
function ArgentDawnSynModel:OnEnterActivity()
    if AppSetting.IsXzns then
        self:EnterChildView()
    else
        if not self.isJoin then
            return
        end
        if not _G.AppSetting.IsWebGl and _G.AppSetting.IsAndriod then
            self:EnterChildView()
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArgentDawnLetterView.Name, self.curActivityClass)
        end
    end
end

function ArgentDawnSynModel:EnterChildView()
    if AppSetting.IsXzns then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArgentDawnDiaryView.Name, self.curActivityClass)
    else
        if not self.isJoin then
            return
        end
        if self:IsMiniGame() then --小程序
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArgentDawnDiaryView.Name, self.curActivityClass)
        else                      --APP和H5
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArgentDawnSignInView.Name, self.curActivityClass)
        end
    end
end

---小程序显示达里安日记
function ArgentDawnSynModel:IsMiniGame()
    return _G.AppSetting.IsDouYin or _G.AppSetting.IsWeiXin
end

function ArgentDawnSynModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.ArgentDawnLetterView.Name
end

---获取咒文
function ArgentDawnSynModel:GetSpell()
    return self.spellCode
end

function ArgentDawnSynModel:GetOfficialAccount()
   if not table.isEmptyOrNil(_G.PlayerModel:GetInstance().ZdConfig) then
        return _G.PlayerModel:GetInstance().ZdConfig.popDesc
    end
    return self.officialAccount
end

function ArgentDawnSynModel:GetAwardCfg()
    return self.awardCfg
end

---当前是第几天
function ArgentDawnSynModel:GetDayIndex()
    local index = #self.hasAwardLis
    if not self.todayIsAward then
        index = index + 1
    end
    if index > 3 then
        index = 3
    end
    return index
end

---领取奖励
---@param callback function 回调
function ArgentDawnSynModel:GetAward(day, callback)
    local day = day or self:GetDayIndex()
    local cfg = self.awardCfg[day]
    if cfg == nil then
        return
    end
    self:GetActivityAward(
        { cfg.sid },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            self.todayIsAward = true
            _G.table.insert(self.hasAwardLis, cfg.sid)
            self:CheckClose()
            if callback then
                callback(msg)
            end
            self:RefreshRedPoint()
        end
    )
end

---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function ArgentDawnSynModel:InitRedPointTree()
    self.checkRedPointFunc = { self.CheckRedPoint }
    self.redpointTree = { false }
end

function ArgentDawnSynModel:CheckRedPoint()
    if self.curActivityClass then
        if _G.PlayerPrefsManager.GetInt("ArgentDawnFirstEnter") ~= 1 then
            return 1
        end
        if self.isJoin and not self:IsMiniGame() then
            if not self.todayIsAward and #self.hasAwardLis < 3 then
                return 1
            end
        end
    end
    return 0
end

---刷新奖励红点
function ArgentDawnSynModel:RefreshRedPoint(param)
    param = param or 1
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(param))
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function ArgentDawnSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end
function ArgentDawnSynModel:IsShowBtn()
    if _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.mailactivity) 
    and  not table.isEmptyOrNil(_G.PlayerModel:GetInstance().ZdConfig) and _G.PlayerModel:GetInstance().ZdConfig.ifZd==1
     then
        return true
    end
end

---销毁对象时,析构函数
function ArgentDawnSynModel:Dispose()
    if self.actTimer then
        self.actTimer:Stop()
        self.actTimer = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.game_activity_argent_dawn_change.Cmd,
        self.ActArgentDawnChange, self)
end

return ArgentDawnSynModel
