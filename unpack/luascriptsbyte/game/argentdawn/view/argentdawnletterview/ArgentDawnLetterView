---@class ArgentDawnLetterView : UIBaseView    中文描述
---@field public go_table ArgentDawnLetterView_GoTable GoTable
local ArgentDawnLetterView = _G.BaseClass("ArgentDawnLetterView", _G.UIBaseView)

function ArgentDawnLetterView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArgentDawnLetterView:OnCreate(activityClass)
    self.activityClass = activityClass
    self.typeClass = activityClass.typeClass
    self:InitView()
    if _G.PlayerPrefsManager.GetInt("ArgentDawnFirstEnter") ~= 1 then
        _G.PlayerPrefsManager.SetInt("ArgentDawnFirstEnter", 1)
        self.typeClass:RefreshRedPoint()
    end
end

---初始化页面
function ArgentDawnLetterView:InitView()
    self.go_table.aortext_spell.text = self.typeClass:GetSpell()
end

---按钮点击事件在这里派发
function ArgentDawnLetterView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_open then
        self.typeClass:EnterChildView()
        self:Close()
    elseif go == self.go_table.aorbtn_copy then
        _G.GameUtil.CopyContent(self.typeClass:GetSpell())
    end
end

---@private
function ArgentDawnLetterView:OnDestroy()
end

return ArgentDawnLetterView
