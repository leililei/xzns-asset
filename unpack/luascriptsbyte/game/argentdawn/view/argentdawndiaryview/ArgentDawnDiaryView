---@class ArgentDawnDiaryView : UIBaseView    中文描述
---@field public go_table ArgentDawnDiaryView_GoTable GoTable
local ArgentDawnDiaryView = _G.BaseClass("ArgentDawnDiaryView", _G.UIBaseView)

function ArgentDawnDiaryView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArgentDawnDiaryView:OnCreate(activityClass)
    self.activityClass = activityClass
    self.typeClass = activityClass.typeClass
    self.spellCode = self.typeClass:GetOfficialAccount() or ""
    self.spellCode = _G.string.getStringCharArr(self.spellCode)
    self.maxLen = #self.spellCode
    self.isTurning = false
    self.curIndex = 0
    local data=_G.ConfigManager.discrete_cfg[201503]
    self.timeInterval=data[1][1]/1000
    ---  y\x -119|33|185
    ---  151  口  口  口
    ---  6  口  口  口
    --- -139  口  口  口
    self.wordPos = {
        [1] = {185, 6}, --6
        [2] = {-119, 151}, --1
        [3] = {33, -139}, --8
        [4] = {185, 151}, --3
        [5] = {33, 6}, --5
        [6] = {-119, 6}, --4
        [7] = {185, -139}, --9
        [8] = {33, 151}, --2
        [0] = {-119, -139} --7
    }
    self:InitView()
end

function ArgentDawnDiaryView:InitView()
    -- self:LoadEffect()
    self.go_table.obj_book:SetActiveE(0)
    self.go_table.obj_award:SetActiveE(0)
end

function ArgentDawnDiaryView:LoadEffect()
    local check = function(obj)
        if self:IsNil() then
            _G.UIUtils.RemoveEffect(obj)
            return false
        end
        return true
    end
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_fanshu, self.go_table.obj_eff, check)
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_shuye, self.go_table.obj_eff, check)
end

---初始化页面
function ArgentDawnDiaryView:OpenNext()
    if self.curIndex >= self.maxLen then
        self:Close()
        return
    end
    if self.isTurning then
        return
    end
    if self.timer then
        self.timer:Stop()
    end
    self.curIndex = self.curIndex + 1
    if self.curIndex < self.maxLen then
        self.timer = _G.TimerManager:GetInstance():GetTimer(self.timeInterval, self.OpenNext, self)
        self.timer:Start()
    end
    if self.curIndex == 1 then --翻开封面
        self:TurnCover()
        self.go_table.obj_award:SetActiveE(1)
        self:ShowAward()
    else --翻开书页
        self:TurnPage()
    end
    self.go_table.aortext_spell.text = self.spellCode[self.curIndex]
    local pos = self.wordPos[self.curIndex % 9]
    self.go_table.aortext_spell:SetLocalPosition(pos[1], pos[2], 0)
end

--播放翻开封面动画
function ArgentDawnDiaryView:TurnCover()
    self.isTurning = true
    --[[_G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_fanshu,
        self.go_table.obj_eff,
        function(trans)
            if self:IsNil() then
                _G.UIUtils.RemoveEffect(trans)
                return
            end
            self.go_table.obj_book:SetActiveE(0)
            self.go_table.aorrawimage_cover:SetActiveE(0)
            _G.DelayDo(0.7, function()
                if self:IsNil() then
                    _G.UIUtils.RemoveEffect(trans)
                    return
                end
                self.go_table.obj_book:SetActiveE(1)
                self.isTurning = false
                self.isFirst = true
            end)
        end
    )]]

    --self.go_table.obj_book:SetActiveE(0)
    self.go_table.aorrawimage_cover:SetActiveE(0)
    _G.DelayDo(0, function()
        self.go_table.obj_book:SetActiveE(1)
        self.isTurning = false
        self.isFirst = true
    end)
end

--播放翻页动画
function ArgentDawnDiaryView:TurnPage()
    --self.go_table.obj_book:SetActiveE(0)
    self.isTurning = true
    --[[_G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_shuye,
        self.go_table.obj_eff,
        function(trans)
            if self:IsNil() then
                _G.UIUtils.RemoveEffect(trans)
                return
            end
            _G.DelayDo(0.7, function()
                if self:IsNil() then
                    _G.UIUtils.RemoveEffect(trans)
                    return
                end
                self.go_table.obj_book:SetActiveE(1)
                self.isTurning = false
            end)
            _G.DelayDo(1.4, function()
                _G.UIUtils.RemoveEffect(trans)
            end)
        end
    )]]
    _G.DelayDo(0, function()
        --self.go_table.obj_book:SetActiveE(1)
        self.isTurning = false
    end)
end
function ArgentDawnDiaryView:ShowAward()
    self.award=_G.ConfigManager.discrete_cfg[201502]
    self.go_table.scrollloophorizontal_item:InitItemData(#self.award,
            _G.handler(self, self.RefreshAllLoginItem))
    
end
function ArgentDawnDiaryView:RefreshAllLoginItem(index, obj)
    local _index=index+1
    local tb = _G.GetAutoGoTable(obj)
    _G.StorageManager:GetInstance():GetItemBaseViewNew(self.award[_index], tb.obj_root, function(item)
        if self:IsNil() then
            _G.DestroyObject(item.gameObject)
            return
        end
        if item.ShowNumText then
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end
        if item.cfg and item.cfg.ef_item and _G.tonumber(item.cfg.ef_item) == 1 then
            item:ShowEffect(true)
        end
    end)
end

---按钮点击事件在这里派发
function ArgentDawnDiaryView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_next then
        self:OpenNext()
    end
end

---@private
function ArgentDawnDiaryView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer=nil
    end
end

return ArgentDawnDiaryView
