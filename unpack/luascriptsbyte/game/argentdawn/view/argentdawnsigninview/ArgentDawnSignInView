---@class ArgentDawnSignInView : UIBaseView    中文描述
---@field public go_table ArgentDawnSignInView_GoTable GoTable
local ArgentDawnSignInView = _G.BaseClass("ArgentDawnSignInView", _G.UIBaseView)

function ArgentDawnSignInView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArgentDawnSignInView:OnCreate(activityClass)
    self.activityClass = activityClass
    self.typeClass = activityClass.typeClass
    self.dayTb = {
        _G.GetAutoGoTable(self.go_table.obj_awardDay1),
        _G.GetAutoGoTable(self.go_table.obj_awardDay2),
        _G.GetAutoGoTable(self.go_table.obj_awardDay3)
    }
    self.boxImage = {
        "ImagesH5/hArgentDawn/ui_yslm_day1_img",
        "ImagesH5/hArgentDawn/ui_yslm_day2_img",
        "ImagesH5/hArgentDawn/ui_yslm_day3_img"
    }
    self.awardCfg = self.typeClass:GetAwardCfg()
    self:InitView()
    self:AddListener(_G.eSixUpdate.SixClockUpdate, self.UpdateView)
end

---初始化页面
function ArgentDawnSignInView:InitView()
    ---@type ArgentDawnSignInView._obj_awardDay1_GoTable
    local tb, _type, data, name
    for i = 1, 3 do
        tb = self.dayTb[i]
        tb.aortext_day.text = _G.GetLangPackValue(90033200001, i)
        _type = self.awardCfg[i].award[1].type
        data = _G.StorageManager:GetInstance():GetStorageItemData(_type[1])
        name = data.name or ""
        tb.aortext_award.text = name .. " x" .. _type[2]
    end
    self:UpdateView()
    self:LoadEffect()
end

function ArgentDawnSignInView:LoadEffect()
    local check = function(obj)
        if self:IsNil() then
            _G.UIUtils.RemoveEffect(obj)
            return false
        end
        return true
    end
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_shouchongbg, self.go_table.obj_effBG1, check)
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_shouchongbg2, self.go_table.obj_effBG2, check)
end

function ArgentDawnSignInView:UpdateView()
    self.curDay = self.typeClass:GetDayIndex()
    self.go_table.aorrawimage_box:LoadImage(self.boxImage[self.curDay])
    self.todayIsAward = self.typeClass.todayIsAward
    ---@type ArgentDawnSignInView._obj_awardDay1_GoTable
    local tb
    for i = 1, 3 do
        tb = self.dayTb[i]
        if i < self.curDay then
            tb.aorimage_mask:SetActiveE(1)
        elseif i == self.curDay then
            tb.aorimage_mask:SetActiveE(self.todayIsAward and 1 or 0)
        end
    end
    self.go_table.aorbtn_get:SetGray(self.todayIsAward)
    self.go_table.aortext_state.text =
        self.todayIsAward and _G.GetLangPackValue(90027500002) or _G.GetLangPackValue(90027500003)
end

---按钮点击事件在这里派发
function ArgentDawnSignInView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_get then
        if self.todayIsAward then
            return
        end
        self.typeClass:GetAward(
            self.curDay,
            function(msg)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                self:UpdateView()
            end
        )
    end
end

---@private
function ArgentDawnSignInView:OnDestroy()
    self:RemoveAllListener()
end

return ArgentDawnSignInView
