---@class AfkBuildingUnlockView : UIBaseView	中文描述
---@field public go_table AfkBuildingUnlockView_GoTable GoTable
local AfkBuildingUnlockView = _G.BaseClass("AfkBuildingUnlockView", _G.UIBaseView)

function AfkBuildingUnlockView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function AfkBuildingUnlockView:OnCreate(data, callBack)
    self.data = data
    self.callBack = callBack
    local config = data.config
    self:InitBuildInfo(config, data.level)
end

---@param config afk2_building_cfg 建筑配置
function AfkBuildingUnlockView:InitBuildInfo(config, level)
    self.go_table.aorrawimage_icon:LoadImage(config.icon,
        function(image)
            if self:IsNil() or not image then
                return
            end
            image:SetNativeSize()
        end)
    self.go_table.aortext_name.text = _G.GetLangPackValue(config.name) .. " Lv." .. level
    self.go_table.aortext_produce.text = _G.GetLangPackValue(90000011576)
    local iconPath = _G.StorageManager:GetInstance():GetItemIcon(config.drop_item[1])
    self.go_table.aorrawimage_resIcon:LoadImage(iconPath)
    self.go_table.aorrawimage_resIcon1:LoadImage(iconPath)
    ---每天产出的总资源
    local totalProduce = _G.Mathf.Floor(86400 / config.time[level] * config.drop_item[2])
    self.go_table.aortext_produceNum.text = totalProduce
    local maxTime = require("Afk2Model"):GetInstance():GetBuildMaxTime(config.id, level)
    local times = maxTime / config.time[level]
    local curProduce = _G.Mathf.RoundToInt(times) * config.drop_item[2]
    self.go_table.aortext_limitednum.text = curProduce
end

---界面的销毁函数
function AfkBuildingUnlockView:OnDestroy()
    if self.callBack then
        self.callBack()
    end
end

---按钮点击事件在这里派发
function AfkBuildingUnlockView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeView then
        _G.PlayerPrefsManager.DeleteKey("Afk2BuildUnlockId_" .. self.data.sid)
        self:Close()
    end
end

return AfkBuildingUnlockView
