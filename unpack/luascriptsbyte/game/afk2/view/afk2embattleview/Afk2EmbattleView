---@class Afk2EmbattleView : UIBaseView	灵域巡查战斗布阵页面
---@field go_table Afk2EmbattleView_GoTable
---@field onExitCall fun():void         @退出战斗回调
---@field onBattleCall fun():void       @开始战斗回调
---@field autoFight boolean             @是否自动开始战斗
local Afk2EmbattleView = _G.BaseClass("Afk2EmbattleView", _G.UIBaseView)

function Afk2EmbattleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.Anim = self.go_table.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
end

---界面的入口函数
function Afk2EmbattleView:OnCreate(exitCall, battleCall, autofight)
    self.onExitCall = exitCall
    self.onBattleCall = battleCall
    self.autoFight = autofight
    self:ShowStates()
    self:OpenEmbattleView()
    self:AddListener(_G.eBattleState.RecordStart, self.Hide)
    self:AddListener(_G.eBattleState.RecordEnd, self.Show)
    _G.TrackingPointModel:GetInstance():SetWindowStartTime(self.viewName, true)
end

function Afk2EmbattleView:OnDestroy()
    self.maxsid = nil
    self.onExitCall = nil
    self.onBattleCall = nil
end

function Afk2EmbattleView:ShowStates()
    local sid = require("Afk2Model"):GetInstance():GetAfkNextSid()
    local cfg = _G.ConfigManager.afk2_cfg[sid]

    self.go_table.obj_section:SetActiveE(0)
    self.go_table.aortext_section.text = _G.GetLangPackValue(90024300004, cfg.number)
end

---打开布阵页面
---@return void
function Afk2EmbattleView:OpenEmbattleView()
    --判定队伍是否有布阵角色，如果没有则不会自动进入战斗
    if self.autoFight then
        if not require("EmbattleModel"):GetInstance():CheckBattle(_G.EmbattleType.afk2) then
            self.autoFight = nil
        end
    end

    --进入战斗
    local sid = require("Afk2Model"):GetInstance():GetAfkNextSid()
    local cfg = _G.ConfigManager.afk2_cfg[sid]
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    require("EmbattleController"):GetInstance():OpenEmbattle(
        _G.EmbattleType.afk2,
        _G.EmbattleSaveType.server,
        false,
        _G.EmbattleControllerItemType.afk2,
        _G.handler(self, self.OnExitCall),
        _G.handler(self, self.OnBattleCall),
        cfg.monster_group
    )
end

---退出战斗回调
---@return void
function Afk2EmbattleView:OnExitCall()
    _G.TrackingPointModel:GetInstance():CloseActTracking(self.viewName)
    self:Close()
    if self.onExitCall then
        self.onExitCall()
        self.onExitCall = nil
    end
end

---进入战斗回调
---@return void
function Afk2EmbattleView:OnBattleCall(...)
    _G.TrackingPointModel:GetInstance():CloseActTracking(self.viewName)
    self:Close()
    if self.onBattleCall then
        self.onBattleCall(...)
        self.onBattleCall = nil
    end
end

---监听界面打开
---@param name string 界面名称
function Afk2EmbattleView:OnEmbattleViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
        self.embattleView = _G.UIManager:GetInstance():GetWindowCtrl(name)
        _G.UIManager:GetInstance():ChangeCanvasOrder(
            name,
            self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
        )
        self.embattleView.transform:SetParentE(self.go_table.trans_view)
        self.embattleView:SetInitDoneCall(
            function()
                self.go_table.obj_section:SetActiveE(1)
            end
        )
        self.embattleView:SetEffLoadCall(
            function()
                if self.Anim then
                    self.go_table.obj_section:SetActiveE(0)
                end
            end
        )
        --自动开始战斗
        if self.autoFight then
            self.embattleView:SetAutoBattle()
        end
    end
end

---UI交互事件回调
---@return void
function Afk2EmbattleView:OnClickBtn(go)
end

return Afk2EmbattleView
