---@class AfkBuildingLevelUpResultView : UIBaseView	中文描述
---@field public go_table AfkBuildingLevelUpResultView_GoTable GoTable
local AfkBuildingLevelUpResultView = _G.BaseClass("AfkBuildingLevelUpResultView", _G.UIBaseView)

function AfkBuildingLevelUpResultView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function AfkBuildingLevelUpResultView:OnCreate(id)
    self.id = id
    local buildData = require("Afk2Model"):GetInstance():GetBuildData(id)
    self.level = buildData and buildData.level or 1
    local config = _G.ConfigManager.afk2_building_cfg[id]
    local curProduce, totalProduce = self:InitBuildInfo(self.level - 1, config, self.go_table.obj_left)
    self:InitBuildInfo(self.level, config, self.go_table.obj_right, curProduce, totalProduce)
    self.go_table.aortext_tip:SetActiveE(self.level == 19 and 1 or 0)
end

---@param level number 建筑等级
---@param config afk2_building_cfg 建筑配置
---@param lastProduce number 上一级的效率
---@param obj userdata
function AfkBuildingLevelUpResultView:InitBuildInfo(level, config, obj, lastProduce, lastTotalProduce)
    local tb = _G.GetAutoGoTable(obj)
    tb.aorrawimage_icon:LoadImage(config.icon,
        function(image)
            if self:IsNil() or not image then
                return
            end
            image:SetNativeSize()
        end)
    tb.aortext_name.text = _G.GetLangPackValue(config.name) .. " Lv." .. level
    tb.aortext_produce.text = _G.GetLangPackValue(90000011576)
    local iconPath = _G.StorageManager:GetInstance():GetItemIcon(config.drop_item[1])
    tb.aorrawimage_resIcon:LoadImage(iconPath)
    tb.aorrawimage_resIcon1:LoadImage(iconPath)
    ---每天产出的总资源
    local totalProduce = _G.Mathf.Floor(86400 / config.time[level] *  config.drop_item[2])
    tb.aortext_produceNum.text = totalProduce
    local maxTime = require("Afk2Model"):GetInstance():GetBuildMaxTime(config.id, level)
    local times = maxTime / config.time[level]
    local curProduce = _G.Mathf.RoundToInt(times) * config.drop_item[2]
    tb.aortext_limitednum.text = curProduce
    if lastProduce and tb.obj_limitedarrow then
        tb.obj_limitedarrow:SetActiveE(curProduce > lastProduce and 1 or 0)
    end
    if lastTotalProduce and tb.obj_producearrow then
        tb.obj_producearrow:SetActiveE(totalProduce > lastTotalProduce and 1 or 0)
    end
    return curProduce, totalProduce
end

---按钮点击事件在这里派发
function AfkBuildingLevelUpResultView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeView then
        self:Close()
    end
end

return AfkBuildingLevelUpResultView
