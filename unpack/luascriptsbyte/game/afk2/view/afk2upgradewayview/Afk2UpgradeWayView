--region    =========================常量定义=========================

---特权ID
local PrivilegeId = 405005

--endregion

---@class Afk2UpgradeWayView : UIBaseView   灵域巡查-升级导航视图
---@field go_table Afk2UpgradeWayView_GoTable
---@field model Afk2Model
---@field quickItem Afk2UpgradeWayView._obj_quick_GoTable
---@field rewardItem Afk2UpgradeWayView._obj_reward_GoTable
---@field privilegeItem Afk2UpgradeWayView._obj_privilege_GoTable
---@field opeingView string                         @正在打开的页面
---@field rewardTimer Timer                         @奖励信息刷新定时器
local Afk2UpgradeWayView = _G.BaseClass("Afk2UpgradeWayView", _G.UIBaseView)

function Afk2UpgradeWayView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    --添加奖励刷新定时器
    self.rewardTimer = _G.TimerManager:GetInstance():GetTimer(1, self.RefreshRewardView, self, false, false)
    self.rewardTimer:Start()
end
function Afk2UpgradeWayView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)

    if self.rewardTimer then
        self.rewardTimer:Stop()
        self.rewardTimer = nil
    end
end
function Afk2UpgradeWayView:OnCreate()
    self.model = require("Afk2Model"):GetInstance()
    self:InitItems()

    self:RefreshStateView()
    self:RefreshRewardView()
    self:RefreshQuickView()
    self:RefreshPrivilegeView()
end

function Afk2UpgradeWayView:InitItems()
    self.quickItem = _G.GetAutoGoTable(self.go_table.obj_quick)
    self.rewardItem = _G.GetAutoGoTable(self.go_table.obj_reward)
    self.privilegeItem = _G.GetAutoGoTable(self.go_table.obj_privilege)

    for _, item in pairs({self.quickItem, self.rewardItem, self.privilegeItem}) do
        _G.AddViewBtnClick(item.gameObject, _G.handlerbind(self, self.OnItemClickBtn, item))
    end
end

---刷新基础状态
---@return void
function Afk2UpgradeWayView:RefreshStateView()
    local nextSid = self.model:GetAfkNextSid()
    if nextSid <= 0 then
        self.go_table.aortext_level.text = ""
        return
    end
    local needLevel = _G.ConfigManager.afk2_cfg[nextSid].afk2_lv
    self.go_table.aortext_level.text = _G.GetLangPackValue(90000011474, needLevel)
end
---刷新奖励信息状态
---@return void
function Afk2UpgradeWayView:RefreshRewardView()
    if not self.rewardItem then
        return
    end
    --尚未通过任何关卡
    if self.model:GetAfkSid() <= 0 then
        self.rewardItem.aortext_num.text = ""
        return
    end

    local maxTime = self.model:GetAfkMaxTime()
    local duration = _G.TimeUtil.GetServerUnixTime() - self.model:GetAfkTime()
    if duration > maxTime then
        duration = maxTime
    elseif duration < 0 then
        duration = 0
    end

    --进度条和时间
    self.rewardItem.aortext_num.text = _G.TimeUtil.TimeToString(duration, 1)
end
---刷新快速挂机视图
---@return void
function Afk2UpgradeWayView:RefreshQuickView()
    if not self.quickItem then
        return
    end
    local total = self.model:GetMaxAwardTimes() + self.model:GetMaxFreeAwardTimes()
    local remain = total - self.model:GetFreeTimes() - self.model:GetBuyTimes()
    self.quickItem.aortext_num.text =
        _G.GetLangPackValue(90000011472, remain <= 0 and "<color=#e55454>0</color>" or remain, total)
end
---刷新特权视图
---@return void
function Afk2UpgradeWayView:RefreshPrivilegeView()
    if not self.privilegeItem then
        return
    end
    local hasPrivilege = require "MonthlyModel":GetInstance():IsHavePrivi(PrivilegeId)
    self.privilegeItem.gameObject:SetActiveE(hasPrivilege and 0 or 1)
    self.privilegeItem.aortext_num.text = _G.GetLangPackValue(hasPrivilege and 90000001065 or 90000011070)
end

---跳转新页面后, 再关闭本页面
---@return void
function Afk2UpgradeWayView:OnUIOpened(name)
    if name ~= self.opeingView then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    self:Close()
end

---监听界面UI事件
---@return void
function Afk2UpgradeWayView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close1 then
        self:Close()
    end
end
---监听点击前往事件
---@return void
function Afk2UpgradeWayView:OnItemClickBtn(go, isOn, item)
    if item.gameObject == self.go_table.obj_quick then
        self.opeingView = _G.ConfigManager.ui_cfg.Afk2RewardView.Name
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
        _G.UIManager:GetInstance():OpenWindow(self.opeingView)
    elseif item.gameObject == self.go_table.obj_reward then
        self.opeingView = _G.ConfigManager.ui_cfg.Afk2RewardView.Name
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
        _G.UIManager:GetInstance():OpenWindow(self.opeingView)
    elseif item.gameObject == self.go_table.obj_privilege then
        self.opeingView = _G.ConfigManager.ui_cfg.LimitedTimePrivilegeView.Name
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
        _G.UIManager:GetInstance():OpenWindow(self.opeingView, PrivilegeId)
    end
end

return Afk2UpgradeWayView
