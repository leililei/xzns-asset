---@class Afk2LevelUpView : UIBaseView   灵域巡查-升级提示
---@field go_table Afk2LevelUpView_GoTable
local Afk2LevelUpView = _G.BaseClass("Afk2LevelUpView", _G.UIBaseView)

function Afk2LevelUpView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function Afk2LevelUpView:OnCreate(before, after)
    self:RefreshState(before, after)
end

---刷新页面状态
---@param before number
---@param after number
---@return void
function Afk2LevelUpView:RefreshState(before, after)
    self.go_table.aortext_beforeLevel.text = tostring(before)
    self.go_table.aortext_afterLevel.text = tostring(after)

    local model = require("Afk2Model"):GetInstance()
    local level = model:GetAfkLevel()
    local exp = model:GetAfkExp()
    local cfg = _G.ConfigManager.afk2_level_cfg[level]
    --本级拥有的经验和升级所需经验
    local needExp = cfg.afk2_exp[2]
    if level > 1 then
        local preCfg = _G.ConfigManager.afk2_level_cfg[level - 1]
        needExp = cfg.afk2_exp[2] - preCfg.afk2_exp[2]
        exp = math.max(exp - preCfg.afk2_exp[2], 0)
    end
    self.go_table.aortext_exp.text = needExp > 0 and (exp .. "/" .. needExp) or ""
    self.go_table.slider_exp.value = needExp > 0 and (exp / needExp) or 1
end

---监听界面UI事件
---@return void
function Afk2LevelUpView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

return Afk2LevelUpView
