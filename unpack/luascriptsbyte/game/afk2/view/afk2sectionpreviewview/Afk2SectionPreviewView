---@class Afk2SectionPreviewView : UIBaseView   灵域巡查-关卡预览视图
---@field go_table Afk2SectionPreviewView_GoTable
---@field model Afk2Model
---@field sectionItems table<any, Afk2SectionPreviewView._obj_sectionItem_GoTable> @关卡列表实例节点
---@field sections afk2_cfg[]                                               @关卡列表数据
---@field nextSection number                                                @当前挑战中的关卡id
---@field expIconPath string                                                @经验值图标路径
---@field expIconName string                                                @经验值名称
---@field reward1Multiple number                                            @奖励1产出数量倍率
---@field reward1Unit string                                                @奖励1产出单位
---@field reward2Multiple number                                            @奖励2产出数量倍率
---@field reward2Unit string                                                @奖励2产出单位
local Afk2SectionPreviewView = _G.BaseClass("Afk2SectionPreviewView", _G.UIBaseView)

function Afk2SectionPreviewView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function Afk2SectionPreviewView:OnCreate()
    self.model = require("Afk2Model"):GetInstance()

    --获取经验值图标
    local expId = _G.ConfigManager.afk2_level_cfg[1].afk2_exp[1]
    self.expIconPath = _G.StorageManager:GetInstance():GetItemIcon(expId)
    self.expIconName = _G.StorageManager:GetInstance():GetItemName(expId)

    self:InitSections()

    --计算产出倍率和单位(需要先初始化sections)
    ---@param value number  每分钟产出数量
    ---@return number,string
    local function conversion(value)
        if value > 1 then
            --每小时产出
            return 60, _G.GetLangPackValue(90022100095)
        end
        --每天产出
        return 1440, _G.GetLangPackValue(90000011484)
    end
    local first = self.sections[1]
    self.reward1Multiple, self.reward1Unit = conversion(first.afk2_exp)
    self.reward2Multiple, self.reward2Unit = conversion(60 / first.eff_item[2])

    self:RefreshSectionView()
    self:MoveCurrentSction()
    self:OnSctionContentPositionChange()
end

---初始化关卡列表数据
---@return void
function Afk2SectionPreviewView:InitSections()
    --获取当前进行中的关卡
    self.nextSection = self.model:GetAfkNextSid()

    --初始化关卡列表
    local afk2_cfg = _G.ConfigManager.afk2_cfg
    self.sections = {}
    --初始化关卡数据(显示之前20关和之后50关预览)
    local showPrevious, showNext = 10, 50
    local cfg = afk2_cfg[self.nextSection > 0 and self.nextSection or self.model:GetAfkSid()]
    local move = cfg
    for _ = 1, showPrevious do
        move = afk2_cfg[move.pre_section]
        if not move then
            break
        end
        table.insert(self.sections, 1, move)
    end
    table.insert(self.sections, cfg)
    move = cfg
    for _ = 1, showNext do
        move = afk2_cfg[move.next_section]
        if not move then
            break
        end
        table.insert(self.sections, move)
    end

    self.go_table.obj_sectionItem:SetActiveE(0)
    self.go_table.scrollloopvectical_section:InitItemData(0, _G.handler(self, self.RefreshSectionItem))
    self.go_table.scrollloopvectical_section:DetectingSlippage(_G.handler(self, self.OnSctionContentPositionChange))
end

---刷新关卡列表
---@return void
function Afk2SectionPreviewView:RefreshSectionView()
    self.go_table.scrollloopvectical_section:UpdateCount(#self.sections)
end

---移动到当前关卡位置
---@return void
function Afk2SectionPreviewView:MoveCurrentSction()
    local index = self:GetCurrentSectionIndex() - 2 --C#从0开始并额外显示前1个节点
    if index < 0 then
        index = 0
    end
    self.go_table.scrollloopvectical_section:ScrollToIndex(index)
    self:OnSctionContentPositionChange()
end

---监听关卡列表滑动事件
---@return void
function Afk2SectionPreviewView:OnSctionContentPositionChange()
    --获取节点宽度和间隔
    ---@type number,number
    local itemHeight, itemSpacing, viewCount = self.sectionItemHeight, self.sectionItemSpacing, self.sectionViewCount
    if not itemHeight then
        _, itemHeight = self.go_table.obj_sectionItem:GetRectTransformSizeDelta()
        itemSpacing = 0
        local viewWidth = self.go_table.scrollloopvectical_section:GetRectTransformSizeDelta()
        viewCount = math.floor(math.abs(viewWidth / (itemHeight + itemSpacing)))
        self.sectionItemHeight = itemHeight
        self.sectionItemSpacing = itemSpacing
        self.sectionViewCount = viewCount
    end

    --计算当前显示的节点的序号
    local _, y = self.go_table.obj_sectionContent:GetAnchorPosition()
    local index = math.floor(math.abs(y / (itemHeight + itemSpacing)))
    local offset = self:GetCurrentSectionIndex() - index

    --向上拖动7关或向下拖动7关, 显示复位按钮
    self.go_table.aorbtn_sectionReset1:SetActiveE(offset - viewCount <= -7 and 1 or 0)
    self.go_table.aorbtn_sectionReset2:SetActiveE(offset >= 7 and 1 or 0)
end

---获取当前关卡在列表中的序号(lua数组序号从1开始)
---@return number
function Afk2SectionPreviewView:GetCurrentSectionIndex()
    if self.nextSection <= 0 then
        return #self.sections
    end
    local index = 1
    for i, cfg in ipairs(self.sections) do
        if cfg.id == self.nextSection then
            index = i
            break
        end
    end
    return index
end

---刷新关卡列表节点
---@param index number
---@param obj UnityEngine.GameObject
---@return void
function Afk2SectionPreviewView:RefreshSectionItem(index, obj)
    if not self.sectionItems then
        self.sectionItems = {}
    end

    ---@type Afk2SectionPreviewView._obj_sectionItem_GoTable
    local item = self.sectionItems[obj:GetInstanceIDE()]
    if not item then
        item = _G.GetAutoGoTable(obj)
        self.sectionItems[obj:GetInstanceIDE()] = item
    end

    index = index + 1 --C#序号从0开始, lua序号从1开始

    local cfg, beforeCfg = self.sections[index], self.sections[index - 1]
    local isPass = self.nextSection <= 0 or (cfg.number < _G.ConfigManager.afk2_cfg[self.nextSection].number) --是否通关
    --是否为当前挑战关卡
    local isCurSection = cfg.id == self.nextSection

    item.data = cfg
    --显示基础信息
    local indexStr = _G.GetLangPackValue(90027300034) .. tostring(cfg.number)
    item.aortext_index1.text = indexStr
    item.aortext_index2.text = indexStr
    item.aortext_index3.text = _G.GetLangPackValue(90000011597, cfg.number)
    item.obj_pass:SetActiveE(isPass and 1 or 0)
    item.obj_nopass:SetActiveE(isPass and 0 or 1)

    item.obj_nextLight:SetActiveE(isPass and 1 or 0)
    item.obj_previousLight:SetActiveE((index == 1 or isCurSection or isPass) and 1 or 0)
    --挂机奖励信息
    item.aorrawimage_reward1:LoadImage(self.expIconPath)
    item.aortext_reward1.text =
        string.format(
            "%s: <color=#14874a>%s</color>",
            self.expIconName,
            string.format(self.reward1Unit, math.floor(cfg.afk2_exp * self.reward1Multiple))
        )
    item.obj_reward1Up:SetActiveE(beforeCfg and beforeCfg.afk2_exp < cfg.afk2_exp and 1 or 0)
    local reward2Icon, reward2Name =
        _G.StorageManager:GetInstance():GetItemIcon(cfg.eff_item[1]),
        _G.StorageManager:GetInstance():GetItemName(cfg.eff_item[1])
    item.aorrawimage_reward2:LoadImage(reward2Icon)
    item.aortext_reward2.text =
        string.format(
            "%s: <color=#14874a>%s</color>",
            reward2Name,
            string.format(self.reward2Unit, math.floor(60 / cfg.eff_item[2] * self.reward2Multiple))
        )
    item.obj_reward2Up:SetActiveE(beforeCfg and beforeCfg.eff_item[2] > cfg.eff_item[2] and 1 or 0)
    --关卡解锁建筑信息
    local buildId, level = self.model:GetSectionUnlock(cfg.id)
    if buildId > 0 then
        local buildName = _G.GetLangPackValue(_G.ConfigManager.afk2_building_cfg[buildId].name)
        item.aortext_open.text =
            level > 1 and _G.GetLangPackValue(90000011475, buildName, level) or
            _G.GetLangPackValue(90000011483, buildName)
    else
        item.aortext_open.text = ""
    end
end

---监听界面UI事件
---@return void
function Afk2SectionPreviewView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close1 then
        self:Close()
    elseif go == self.go_table.aorbtn_sectionReset1 or go == self.go_table.aorbtn_sectionReset2 then
        self:MoveCurrentSction()
    end
end

return Afk2SectionPreviewView
