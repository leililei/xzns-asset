---@class Afk2RewardView : UIBaseView   灵域巡查-挂机奖励领取视图
---@field go_table Afk2RewardView_GoTable
---@field model Afk2Model
---@field rewardTimer Timer                     @奖励信息刷新定时器
local Afk2RewardView = _G.BaseClass("Afk2RewardView", _G.UIBaseView)

function Afk2RewardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.prefix = _G.GetLangPackValue(90000011480)
end

function Afk2RewardView:OnDestroy()
    if self.rewardTimer then
        self.rewardTimer:Stop()
        self.rewardTimer = nil
    end
end

function Afk2RewardView:OnCreate()
    self.model = require("Afk2Model"):GetInstance()
    self:InitRes()

    self.lastAfkTime = self.model:GetAfkTime()
    self.maxAfkTime = _G.ConfigManager.discrete_cfg[115701][1][1]
    --添加奖励刷新定时器
    self.rewardTimer = _G.TimerManager:GetInstance():GetTimer(1, self.RefreshRewardView, self, false, false)
    self.rewardTimer:Start()
    self:RefreshRewardView()
    self:RefreshQuickReward()
    self.model:GetAfkAward(2, _G.handler(self, self.RefreshAward))
end

---初始化资源
function Afk2RewardView:InitRes()
    local sid = self.model:GetAfkSid()
    if not sid or sid <= 0 then
        self:Close()
        return
    end
    local config = _G.ConfigManager.afk2_cfg[sid]
    local exp = _G.ConfigManager.afk2_level_cfg[1].afk2_exp
    self.go_table.aorrawimage_reward1:LoadImage(
        _G.StorageManager:GetInstance():GetItemIcon(exp[1])
    )
    ---巡查经验
    local rewardName1 = _G.StorageManager:GetInstance():GetItemName(exp[1])
    self.go_table.aortext_reward1.text = rewardName1 .. "：" .. _G.GetLangPackValue(90022100095, config.afk2_exp * 60)
    self.go_table.aorrawimage_reward2:LoadImage(
        _G.StorageManager:GetInstance():GetItemIcon(config.eff_item[1])
    )
    ---建筑效益
    local rewardName2 = _G.StorageManager:GetInstance():GetItemName(config.eff_item[1])
    local num = _G.Mathf.Floor(3600 / config.eff_item[2])
    if num <= 0 then
        self.go_table.aortext_reward2.text = rewardName2 .. "：" .. _G.GetLangPackValue(90022100095, num)
    else
        num = _G.Mathf.Floor(86400 / config.eff_item[2])
        self.go_table.aortext_reward2.text = rewardName2 .. "：+" .. _G.GetLangPackValue(90000011484, num)
    end
end

function Afk2RewardView:RefreshAward(data)
    if data and data.award then
        local awardList = data.award.item or {}
        self.go_table.obj_award:RemoveAllChildren()
        if _G.table.isEmptyOrNil(awardList) then
            self.go_table.aortext_noAward:SetActiveE(1)
            self.go_table.obj_award:SetActiveE(0)
            return
        end

        self.go_table.aortext_noAward:SetActiveE(0)
        self.go_table.obj_award:SetActiveE(1)
        for _, v in ipairs(awardList) do
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                v.type,
                self.go_table.obj_award,
                function(item)
                    if _G.IsNil(self.go_table.obj_award) then
                        return
                    end
                    if item.ShowNumText then
                        item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    end
                    if item.cfg and item.cfg.ef_item and _G.tonumber(item.cfg.ef_item) == 1 then
                        item:ShowEffect(true)
                    end
                end
            )
        end
    else
        self.go_table.aortext_noAward:SetActiveE(1)
        self.go_table.obj_award:SetActiveE(0)
    end
end

---刷新奖励信息状态
---@return void
function Afk2RewardView:RefreshRewardView()
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    if self.lastAfkTime > 0 and serverTime - self.lastAfkTime < self.maxAfkTime then
        local leftTime = serverTime - self.lastAfkTime
        self.go_table.aortext_time.text = self.prefix .. _G.TimeUtil.TransDayHourMineMiao(leftTime)
    else
        self.go_table.aortext_time.text = self.prefix .. _G.GetLangPackValue(90000011479)
    end
end

---快速挂机奖励
function Afk2RewardView:RefreshQuickReward()
    local haveFreeTimes, leftFreeTimes = self.model:CheckHaveFreeTimes()
    self.go_table.aortext_ticket:SetActiveE(haveFreeTimes and 1 or 0)
    self.go_table.aorrawimage_martiralImg:SetActiveE(haveFreeTimes and 0 or 1)
    self.go_table.aortext_consume.text = ""
    self.go_table.aortext_Done:SetActiveE(haveFreeTimes and 0 or 1)
    if haveFreeTimes then
        self.go_table.aortext_ticket.text = _G.GetLangPackValue(91112100101)
        self.go_table.aortext_leftTimes.text = _G.GetLangPackValue(90022010502, leftFreeTimes)
    else
        local _, leftBuyTimes = self.model:CheckHaveBuyTimes()
        self.go_table.aorrawimage_martiralImg:LoadImage(
            _G.StorageManager:GetInstance():GetItemIcon(_G.ResPropID.Diamond)
        )
        local config = _G.ConfigManager.discrete_cfg[115705][1]
        local num = config[self.model:GetBuyTimes() + 1] or config[#config] or 0
        self.go_table.aortext_consume.text = num
        self.go_table.aortext_Done:SetActiveE(1)
        self.go_table.aortext_leftTimes.text = _G.GetLangPackValue(90021010402, leftBuyTimes)
        self.go_table.aorbtn_quick:SetGray(leftBuyTimes <= 0)
        if leftBuyTimes <= 0 then
            self.go_table.aortext_consume.color = _G.Color.New(67 / 255, 64 / 255, 73 / 255, 1)
            self.go_table.aortext_Done.color = _G.Color.New(67 / 255, 64 / 255, 73 / 255, 1)
        else
            self.go_table.aortext_consume.color = _G.Color.New(145 / 255, 72 / 255, 1 / 255, 1)
            self.go_table.aortext_Done.color = _G.Color.New(145 / 255, 72 / 255, 1 / 255, 1)
        end
        _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(self.go_table.aortext_consume.rectTransform)
        _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(self.go_table.aortext_Done.rectTransform)
        _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(self.go_table.aortext_ticket.rectTransform)
    end
end

---领取奖励回调
---@param msg public.s2c_common_ack
---@param beforeLevel number
---@param afterLevel number
---@return void
function Afk2RewardView:OnRewardCallback(msg, beforeLevel, afterLevel)
    if msg then
        _G.UIUtils.ShowCommonAward(msg, function()
            if self:IsNil() then
                return
            end
            if not beforeLevel or not afterLevel then
                return
            end
            if beforeLevel <= afterLevel then
                afterLevel = beforeLevel + 1
            end
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.Afk2LevelUpView.Name, beforeLevel, afterLevel)
        end)
    end

    --刷新界面状态
    self.lastAfkTime = self.model:GetAfkTime()
    self:RefreshRewardView()
    self:RefreshQuickReward()
    self:RefreshAward()

    --刷新主页面状态
    ---@type Afk2MainView
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.Afk2MainView.Name)
    if view then
        view:RefreshRewardView()
        view:RefreshStates()
    end
end

---领取奖励回调
---@param msg public.s2c_common_ack
---@param beforeLevel number
---@param afterLevel number
---@return void
function Afk2RewardView:OnQuickRewardCallback(msg, beforeLevel, afterLevel)
    if msg then
        _G.UIUtils.ShowCommonAward(msg, function()
            if self:IsNil() then
                return
            end
            if not beforeLevel or not afterLevel then
                return
            end
            if beforeLevel <= afterLevel then
                afterLevel = beforeLevel + 1
            end
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.Afk2LevelUpView.Name, beforeLevel, afterLevel)
        end)
    end
    self:RefreshQuickReward()

    --刷新主页面状态
    ---@type Afk2MainView
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.Afk2MainView.Name)
    if view then
        view:RefreshRewardView()
        view:RefreshStates()
    end
end

---监听界面UI事件
---@return void
function Afk2RewardView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close1 then
        self:Close()
    elseif go == self.go_table.aorbtn_confirm then
        --检测是否有奖励可领取
        if self.model:GetAfkTime() + self.model:GetAfkInterval() > _G.TimeUtil.GetServerUnixTime() then
            _G.PopWindowManager:GetInstance():ShowAllTips(970112)
            return
        end
        self.model:GetAfkAward(1, _G.handler(self, self.OnRewardCallback))
    elseif go == self.go_table.aorbtn_quick then
        if self.model:CheckHaveFreeTimes() then
            self.model:GetQucikAfkAward(1, 0, _G.handler(self, self.OnQuickRewardCallback))
        elseif self.model:CheckHaveBuyTimes() then
            local config = _G.ConfigManager.discrete_cfg[115705][1]
            local num = config[self.model:GetBuyTimes() + 1] or config[#config] or 0
            if num > 0 and not _G.StorageManager:GetInstance():CheckItemNew(_G.ResPropID.Diamond, num) then
                return
            end
            self.model:GetQucikAfkAward(1, num, _G.handler(self, self.OnQuickRewardCallback))
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(210101)
        end
    end
end

return Afk2RewardView
