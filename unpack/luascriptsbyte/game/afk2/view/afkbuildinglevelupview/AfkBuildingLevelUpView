local Afk2Model = require("Afk2Model")
---@class AfkBuildingLevelUpView : AfkBuildingLevelUpResultView	中文描述
---@field public go_table AfkBuildingLevelUpView_GoTable GoTable
local AfkBuildingLevelUpView = _G.BaseClass("AfkBuildingLevelUpView", require("AfkBuildingLevelUpResultView"))

---界面的入口函数
function AfkBuildingLevelUpView:OnCreate(id)
    self.id = id
    self:RefreshView()
end

function AfkBuildingLevelUpView:RefreshView()
    self.buildData = Afk2Model:GetInstance():GetBuildData(self.id)
    self.level = self.buildData and self.buildData.level or 1
    self.go_table.aortext_tip:SetActiveE(self.level == 19 and 1 or 0)
    local config = _G.ConfigManager.afk2_building_cfg[self.id]
    local curProduce, lastTotalProduce = self:InitBuildInfo(self.level, config, self.go_table.obj_left)
    if self.level >= self.buildData.maxLevel then
        ---满级后隐藏按钮和后面的建筑信息
        self.go_table.obj_right:SetActiveE(0)
        self.go_table.aorbtn_levelUp:SetActiveE(0)
        self.go_table.aorimage_maxLevel:SetActiveE(1)
        self.go_table.obj_left:SetLocalPositionToZero()
    else
        self:InitBuildInfo(self.level + 1, config, self.go_table.obj_right, curProduce, lastTotalProduce)
        self:RefreshLvUpRes()
    end
end

---刷新升级资源
function AfkBuildingLevelUpView:RefreshLvUpRes()
    ---@type afk2_building_cfg
    local config = _G.ConfigManager.afk2_building_cfg[self.id]
    local material = config.material[self.level]
    local haveCount = _G.StorageManager:GetInstance():GetItemCountBySid(material[1])
    if not _G.StorageManager:GetInstance():CheckItem(material[1], material[2]) then
        self.go_table.aortext_lvUpNum.text = "<color=#E33F3f>" .. haveCount .. "</color>/" .. material[2]
    else
        self.go_table.aortext_lvUpNum.text = haveCount .. "/" .. material[2]
    end
    self.go_table.aorrawimage_lvUpRes:LoadImage(
        _G.StorageManager:GetInstance():GetItemIcon(material[1])
    )
end

---按钮点击事件在这里派发
function AfkBuildingLevelUpView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeView or go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_levelUp then
        local config = _G.ConfigManager.afk2_building_cfg[self.id]
        if self.level >= self.buildData.maxLevel then
            return
        end
        if Afk2Model:GetInstance():GetAfkSid() < config.condition[self.level + 1] then
            local cfg = _G.ConfigManager.afk2_cfg[config.condition[self.level + 1]]
            _G.PopWindowManager:GetInstance():ShowAllTips(970104, nil, nil, nil, nil, nil,
                cfg.number)
            return
        end
        local material = config.material[self.level]
        if not _G.StorageManager:GetInstance():CheckItemNew(material[1], material[2]) then
            return
        end
        Afk2Model:GetInstance():BuildLevelUp(self.id, self.level, material, function()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.AfkBuildingLevelUpResultView.Name, self.id)
            self:RefreshView()
        end)
    end
end

return AfkBuildingLevelUpView
