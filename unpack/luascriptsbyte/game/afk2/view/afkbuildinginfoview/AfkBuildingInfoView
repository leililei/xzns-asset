local Afk2Model = require("Afk2Model")
---@class AfkBuildingInfoView : UIBaseView	中文描述
---@field public go_table AfkBuildingInfoView_GoTable GoTable
local AfkBuildingInfoView = _G.BaseClass("AfkBuildingInfoView", _G.UIBaseView)

function AfkBuildingInfoView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.toggle_showLvTips.onValueChanged:AddListener(_G.handler(self, self.OnValueChanged))
end

---界面的入口函数
---@param buildId number 建筑id
function AfkBuildingInfoView:OnCreate(buildId, initCallBack)
    self.selectBuildId = buildId
    ---缓存tab的item
    self.buildTabItemList = {}
    self:InitTab()
    self:RefreshBuildInfo()
    if initCallBack then
        initCallBack()
    end
    self:AddListener(_G.eAfk2Events.BuildLevelChange, _G.handler(self, self.OnBuildLevelChange))
end

---建筑等级变化监听事件
function AfkBuildingInfoView:OnBuildLevelChange()
    self:RefreshBuildInfo()
    if self.selectBuildId and self.buildConfig[self.selectBuildId] then
        local config = self.buildConfig[self.selectBuildId]
        local tb = self.buildTabItemList and self.buildTabItemList[config.id]
        if tb then
            local canGetBuildAward = Afk2Model:GetInstance():CheckBuildRedPoint(self.buildData) == 1
            local canLevelUp = Afk2Model:GetInstance():CheckBuildCanLevelUp(config.id, self.buildData) == 1
            tb.obj_redpoint:SetActiveE((canGetBuildAward or canLevelUp) and 1 or 0)
        end
    end
end

function AfkBuildingInfoView:InitTab()
    self.buildConfig = {}
    for _, v in pairs(_G.ConfigManager.afk2_building_cfg) do
        _G.table.insert(self.buildConfig, v)
    end
    _G.SortList(
        self.buildConfig,
        function(data)
            return -data.id
        end
    )
    if not self.selectBuildId then
        self.selectBuildId = self.buildConfig[1].id
    end
    self.go_table.scrollloopvectical_tab:InitItemData(#self.buildConfig, _G.handler(self, self.RefreshTabItem))
    local scorllIndex = 1
    for i, v in ipairs(self.buildConfig) do
        if v.id == self.selectBuildId then
            scorllIndex = i
            break
        end
    end
    self.go_table.scrollloopvectical_tab:ScrollToIndex(scorllIndex - 1)
end

---刷新页签item
function AfkBuildingInfoView:RefreshTabItem(index, obj)
    local config = self.buildConfig[index + 1]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.onClickTab, config))
    tb.aortext_label.text = _G.GetLangPackValue(config.name)
    tb.aortext_label1.text = _G.GetLangPackValue(config.name)
    tb.aorimage_isOn:SetActiveE(self.selectBuildId == config.id and 1 or 0)
    ---是否解锁
    local buildData = Afk2Model:GetInstance():GetBuildData(config.id)
    local condition = config.condition[1]
    local number = _G.ConfigManager.afk2_cfg[condition].number
    tb.aortext_lock.text = _G.GetLangPackValue(90000011460, number)
    tb.obj_lock:SetActiveE(buildData and buildData.level > 0 and 0 or 1)
    ---建筑奖励红点和建筑升级红点
    local canGetBuildAward = Afk2Model:GetInstance():CheckBuildRedPoint(buildData) == 1
    local canLevelUp = Afk2Model:GetInstance():CheckBuildCanLevelUp(config.id, buildData) == 1
    tb.obj_redpoint:SetActiveE((canGetBuildAward or canLevelUp) and 1 or 0)
    self.buildTabItemList[config.id] = tb
end

---点击页签item
function AfkBuildingInfoView:onClickTab(_, _, config)
    local buildData = Afk2Model:GetInstance():GetBuildData(config.id)
    if not buildData or buildData.level <= 0 then
        local cfg = _G.ConfigManager.afk2_cfg[config.condition[1]]
        _G.PopWindowManager:GetInstance():ShowAllTips(970101, nil, nil, nil, nil, nil, cfg.number)
        return
    end
    if self.selectBuildId == config.id then
        return
    end
    self.buildTabItemList[self.selectBuildId].aorimage_isOn:SetActiveE(0)
    self.buildTabItemList[config.id].aorimage_isOn:SetActiveE(1)
    self.selectBuildId = config.id
    self:RefreshBuildInfo()
end

---刷新建筑基础信息
function AfkBuildingInfoView:RefreshBuildInfo()
    if self.effeciencyTimer then
        self.effeciencyTimer:Stop()
        self.effeciencyTimer = nil
    end
    local config = self.buildConfig[self.selectBuildId]
    self.go_table.aorrawimage_buildIcon:LoadImage(
        config.icon,
        function(image)
            if not image then
                return
            end
            image:SetNativeSize()
        end
    )
    self.go_table.aortext_name.text = _G.GetLangPackValue(config.name)
    ---掉落资源
    self.go_table.obj_item:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        config.drop_item,
        self.go_table.obj_item,
        function(item)
            --如果父节点被销毁或异步加载被覆盖
            if _G.IsNil(self.go_table.obj_item) or config.id ~= self.selectBuildId then
                _G.DestroyObject(item)
                return
            end
            item:ShowEffect(true)
        end
    )

    local iconPath = _G.StorageManager:GetInstance():GetItemIcon(config.drop_item[1])
    self.buildData = Afk2Model:GetInstance():GetBuildData(config.id)
    self.level = self.buildData and self.buildData.level or 1
    self.go_table.aortext_level.text = _G.GetLangPackValue(90031900006, self.level)

    ---每x产出
    self.go_table.aortext_produce.text = _G.GetLangPackValue(90000011576)
    self.go_table.aorrawimage_resIcon1:LoadImage(iconPath)
    self.go_table.aortext_num1.text = _G.Mathf.Floor(86400 / config.time[self.level] * config.drop_item[2])

    ---最大存储上限
    self.go_table.aorrawimage_resIcon2:LoadImage(iconPath)
    local maxTime = require("Afk2Model"):GetInstance():GetBuildMaxTime(config.id, self.level)
    local times = maxTime / config.time[self.level]
    self.maxProduce = _G.Mathf.Floor(times) * config.drop_item[2]
    self.go_table.aortext_num2.text = self.maxProduce

    if self.buildData and self.buildData.level > 0 then
        local serverTime = _G.TimeUtil.GetServerUnixTime()
        local curTimes = 0
        if self.buildData.award_time + maxTime <= serverTime then
            self.go_table.aortext_maxProduce.text = _G.GetLangPackValue(90000011461)
            curTimes = maxTime / config.time[self.level]
            self.go_table.slider_produce.value = 1
        else
            self.go_table.slider_produce.value = (serverTime - self.buildData.award_time) / maxTime
            self.go_table.aortext_maxProduce.text = _G.GetLangPackValue(90000011599)
            curTimes = (serverTime - self.buildData.award_time) / config.time[self.level]
            self:SetTimer()
        end
        self.go_table.aortext_curProduce.text = _G.GetLangPackValue(90000011438,
            _G.Mathf.Floor(curTimes) * config.drop_item[2])
    else
        self.go_table.aortext_maxProduce.text = _G.GetLangPackValue(90000011599)
        self.go_table.aortext_curProduce.text = _G.GetLangPackValue(90000011438, 0)
        self.go_table.slider_produce.value = 0
        self.go_table.aortext_maxTip:SetActiveE(0)
    end

    ---升级提醒
    local isOn = _G.PlayerPrefsManager.GetInt("AfkBuildingYcTip_" .. config.id, 0) == 1
    self.go_table.toggle_showLvTips.isOn = isOn
    local maxLevel = self.buildData and self.level >= (self.buildData.maxLevel or #config.material + 1)
    self.go_table.obj_maxLevel:SetActiveE(maxLevel and 1 or 0)
    self.go_table.aorbtn_levelUp:SetActiveE(maxLevel and 0 or 1)
    self:RefreshLvUpRes(config, self.level, maxLevel)

    ---红点
    self.go_table.obj_receiveredpoint:SetActiveE(Afk2Model:GetInstance():CheckBuildRedPoint(self.buildData))
end

---升级资源
function AfkBuildingInfoView:RefreshLvUpRes(config, level, maxLevel)
    self.go_table.obj_levelUpRes:SetActiveE(maxLevel and 0 or 1)
    if maxLevel then
        ---已满级
        return
    end
    ---@type afk2_building_cfg
    local material = config.material[level]
    local haveCount = _G.StorageManager:GetInstance():GetItemCountBySid(material[1])
    if not _G.StorageManager:GetInstance():CheckItem(material[1], material[2]) then
        self.go_table.aortext_lvUpNum.text = "<color=#E33F3f>" .. haveCount .. "</color>/" .. material[2]
    else
        self.go_table.aortext_lvUpNum.text = haveCount .. "/" .. material[2]
    end
    self.go_table.aorrawimage_lvUpRes:LoadImage(
        _G.StorageManager:GetInstance():GetItemIcon(material[1])
    )
end

---计时器-刷新建筑效率
function AfkBuildingInfoView:SetTimer()
    self.effeciencyTimer = _G.TimerManager:GetInstance():GetTimer(
        1, self.UpdateBuildEfficiency, self, false, false, true)
    self.effeciencyTimer:Start()
end

function AfkBuildingInfoView:UpdateBuildEfficiency()
    local config = self.buildConfig[self.selectBuildId]
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    if self.buildData and (serverTime - self.buildData.award_time) % config.time[self.level] == 0 then
        local curTimes = (serverTime - self.buildData.award_time) / config.time[self.level]
        local curProduce = _G.Mathf.Floor(curTimes) * config.drop_item[2]
        self.go_table.aortext_curProduce.text = _G.GetLangPackValue(90000011438, curProduce)
        local maxTime = require("Afk2Model"):GetInstance():GetBuildMaxTime(config.id, self.level)
        self.go_table.slider_produce.value = (serverTime - self.buildData.award_time) / maxTime
        self:MoveEffect(config)
        ---达到最大时产出停止
        if curProduce >= self.maxProduce then
            if self.effeciencyTimer then
                self.effeciencyTimer:Stop()
                self.effeciencyTimer = nil
            end
            self.go_table.aortext_maxTip:SetActiveE(1)
        end
    end
end

function AfkBuildingInfoView:MoveEffect(config)
    _G.PoolsManager:GetInstance():Spawn(
        "UI/Afk2/EfficiencyTipItem",
        _G.ePoolType.Temporary,
        self.transform,
        function(trans)
            if _G.IsNil(self.transform) then
                _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.Temporary)
                return
            end
            self.item = _G.GetAutoGoTable(trans)
            local iconPath = _G.StorageManager:GetInstance():GetItemIcon(config.drop_item[1])
            self.item.aorrawimage_icon:LoadImage(iconPath)
            self.item.aortext_content.text = "+" .. config.drop_item[2]
            trans:SetAnchorPosition(-185, 160)

            local _obj = _G.GameObject()
            local canvasGrounp = _obj:AddComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup))
            _obj:SetParentE(self.transform)
            trans:SetParentE(_obj)
            self.upTween, self.fadeTween = _G.CommonUIEffect:GetInstance():UpAndFade(
                _obj,
                20,
                0.2,
                0.2,
                canvasGrounp,
                0.2,
                function()
                    if not _G.IsNil(_obj) then
                        _G.DestroyObject(_obj)
                    end
                    if self.upTween then
                        self.upTween:Kill()
                    end
                    if self.fadeTween then
                        self.fadeTween:Kill()
                    end
                end
            )
        end
    )
end

---界面的销毁函数
function AfkBuildingInfoView:OnDestroy()
    if self.effeciencyTimer then
        self.effeciencyTimer:Stop()
        self.effeciencyTimer = nil
    end
    if self.upTween then
        self.upTween:Kill()
    end
    if self.fadeTween then
        self.fadeTween:Kill()
    end
    self:RemoveAllListener()
end

function AfkBuildingInfoView:OnValueChanged(isOn)
    local config = self.buildConfig[self.selectBuildId]
    _G.PlayerPrefsManager.SetInt("AfkBuildingYcTip_" .. config.id, isOn and 1 or 0)
    local tb = self.buildTabItemList[config.id]
    if tb then
        local canGetBuildAward = Afk2Model:GetInstance():CheckBuildRedPoint(self.buildData) == 1
        if isOn then
            local canLevelUp = Afk2Model:GetInstance():CheckBuildCanLevelUp(config.id) == 1
            tb.obj_redpoint:SetActiveE((canLevelUp or canGetBuildAward) and 1 or 0)
        else
            tb.obj_redpoint:SetActiveE(canGetBuildAward and 1 or 0)
        end
    end
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.Afk2BuildLevelUp.id)
end

---按钮点击事件在这里派发
function AfkBuildingInfoView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeView or go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_receive then
        local config = self.buildConfig[self.selectBuildId]
        if not self.buildData then
            self.buildData = Afk2Model:GetInstance():GetBuildData(config.id)
        end
        if self.buildData then
            local curTimes = _G.Mathf.Floor((_G.TimeUtil.GetServerUnixTime() - self.buildData.award_time) /
                config.time[self.buildData.level])
            if curTimes < 1 then
                _G.PopWindowManager:GetInstance():ShowAllTips(970102)
            else
                Afk2Model:GetInstance():GetBuildAward({ self.selectBuildId }, function()
                    self:OnBuildLevelChange()
                end)
            end
        end
    elseif go == self.go_table.aorbtn_levelUp then
        local config = self.buildConfig[self.selectBuildId]
        if not self.buildData then
            self.buildData = Afk2Model:GetInstance():GetBuildData(config.id)
        end
        if self.buildData.level >= self.buildData.maxLevel then
            return
        end
        local material = config.material[self.buildData.level]
        if not _G.StorageManager:GetInstance():CheckItemNew(material[1], material[2]) then
            return
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.AfkBuildingLevelUpView.Name, self.selectBuildId)
    end
end

return AfkBuildingInfoView
