local Afk2Model = require("Afk2Model")
---@class AfkBuildingItem : Component	中文描述
---@field go_table AfkBuildingView._obj_building1_GoTable
local AfkBuildingItem = _G.BaseClass("AfkBuildingItem", _G.Component)

---创建对象时,入口构造函数
function AfkBuildingItem:__init(obj, parentView)
    self.gameObject = obj
    self.parentView = parentView
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.stopTimer = 0.2
end

---刷新item
---@param lock boolean @是否强制显示锁定状态
function AfkBuildingItem:RefreshItem(config, lock)
    self.config = config
    ---当前是否有收益产生
    self.haveEfficiency = false
    ---掉落的奖励
    self.dropItemSid = config.drop_item[1]
    self.dropItemNum = config.drop_item[2]
    self.buildData = not lock and Afk2Model:GetInstance():GetBuildData(config.id) or nil
    self.go_table.aorimage_lock:SetActiveE(self.buildData and 0 or 1)
    self.go_table.obj_build:SetActiveE(self.buildData and 1 or 0)
    if self.buildData then
        self.go_table.aortext_name.text = _G.GetLangPackValue(config.name) .. " Lv." .. self.buildData.level
        self.go_table.aorrawimage_icon:LoadImage(
            _G.StorageManager:GetInstance():GetItemIcon(self.dropItemSid),
            function(image)
                if _G.IsNil(self.go_table.aorrawimage_icon) then
                    return
                end
                image:SetActiveE(1)
                image:SetNativeSize()
                image:SetLocalScaleXYZ(config.Scale or 1)
                image:SetLocalPosition(config.pos_portrait[1] or 0, config.pos_portrait[2] or 0, 0)
            end
        )
        ---挂机进度
        self.maxTime = require("Afk2Model"):GetInstance():GetBuildMaxTime(config.id)
        local serverTime = _G.TimeUtil.GetServerUnixTime()
        if self.buildData.award_time + self.maxTime <= serverTime then
            self.go_table.slider_progress.value = 1
            self.go_table.aortext_Slider.text = _G.GetLangPackValue(90000011581, 100)
            self.go_table.aorimage_progress.fillAmount = 1
        else
            self.haveEfficiency = true
            local onceTime = self.config.time[self.buildData.level]
            local count = _G.Mathf.Floor((serverTime - self.buildData.award_time) / onceTime)
            local value = (count * onceTime) / self.maxTime
            self.go_table.slider_progress.value = value
            ---存储百分比
            self.go_table.aortext_Slider.text = _G.GetLangPackValue(90000011581, self:Getpercentage(value))
            self:PlayProgressAnim(onceTime)
        end
        self:RefreshRedPoint(serverTime)
    else
        self.go_table.aortext_name.text = _G.GetLangPackValue(config.name)
        self.go_table.aorrawimage_icon:SetActiveE(0)
        self.go_table.obj_redpoint:SetActiveE(0)
    end
end

---存储百分比
function AfkBuildingItem:Getpercentage(value)
    if value == 0 then
        return 0
    end
    local precent = _G.Mathf.Floor(value * 100)
    if precent < 1 then
        return 1
    end

    return precent
end

---刷新建筑红点
function AfkBuildingItem:RefreshRedPoint(serverTime)
    if self.buildData then
        if not self.maxTime then
            self.maxTime = require("Afk2Model"):GetInstance():GetBuildMaxTime(self.config.id)
        end
        self.go_table.obj_redpoint:SetActiveE(
            serverTime - self.buildData.award_time >= _G.Mathf.Floor(self.maxTime * 0.8) and 1 or 0
        )
    else
        self.go_table.obj_redpoint:SetActiveE(0)
    end
end

---循环动效
function AfkBuildingItem:PlayProgressAnim(onceTime)
    if self.doTween then
        return
    end
    self.doTween = _G.DOTween.To(
        function()
            return 0
        end,
        function(x)
            self.go_table.aorimage_progress.fillAmount = x
        end,
        1,
        self.config.rise * onceTime or 1
    )
    self.doTween:SetEase(_G.CS.DG.Tweening.Ease.Linear)
    self.doTween:SetLoops(-1, _G.CS.DG.Tweening.LoopType.Restart)
    self.doTween:OnStepComplete(
        function()
            self:MoveEffect()
            local serverTime = _G.TimeUtil.GetServerUnixTime()
            if self.buildData.award_time + self.maxTime <= serverTime then
                self.go_table.slider_progress.value = 1
                self.go_table.aortext_Slider.text = _G.GetLangPackValue(90000011581, 100)
                if self.doTween then
                    self.doTween:Kill()
                    self.doTween = nil
                end
                return
            end
            local value = (serverTime - self.buildData.award_time) / self.maxTime
            self.go_table.slider_progress.value = value
            self.go_table.aortext_Slider.text = _G.GetLangPackValue(90000011581, self:Getpercentage(value))
        end
    )
end

---检测挂机奖励
function AfkBuildingItem:CheckAfkAward(serverTime)
    if not self.haveEfficiency or not self.buildData then
        return
    end

    if self.buildData.award_time + self.maxTime < serverTime then
        return
    end

    local onceTime = self.config.time[self.buildData.level]
    if (serverTime - self.buildData.award_time) % onceTime == 0 then
        self.go_table.slider_progress.value = (serverTime - self.buildData.award_time) / self.maxTime
        self:MoveEffect()
    end
end

function AfkBuildingItem:MoveEffect()
    _G.PoolsManager:GetInstance():Spawn(
        "UI/Afk2/EfficiencyTipItem",
        _G.ePoolType.Temporary,
        self.transform,
        function(trans)
            if _G.IsNil(self.transform) then
                _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.Temporary)
                return
            end
            self.item = _G.GetAutoGoTable(trans)
            local iconPath = _G.StorageManager:GetInstance():GetItemIcon(self.dropItemSid)
            self.item.aorrawimage_icon:LoadImage(iconPath)
            self.item.aortext_content.text = "+" .. _G.Mathf.Ceil(self.dropItemNum * self.config.rise)
            trans:SetAnchorPosition(-6, 120)

            local _obj = _G.GameObject()
            local canvasGrounp = _obj:AddComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup))
            _obj:SetParentE(self.transform)
            trans:SetParentE(_obj)
            self.upTween, self.fadeTween = _G.CommonUIEffect:GetInstance():UpAndFade(
                _obj,
                15,
                0.2,
                self.stopTimer,
                canvasGrounp,
                0.2,
                function()
                    if not _G.IsNil(_obj) then
                        _G.DestroyObject(_obj)
                    end
                    if self.upTween then
                        self.upTween:Kill()
                    end
                    if self.fadeTween then
                        self.fadeTween:Kill()
                    end
                end
            )
        end
    )
end

---销毁对象时,析构函数
function AfkBuildingItem:Dispose()
    if self.upTween then
        self.upTween:Kill()
    end
    if self.fadeTween then
        self.fadeTween:Kill()
    end
    if self.doTween then
        self.doTween:Kill()
        self.doTween = nil
    end
end

function AfkBuildingItem:OnClickBtn(go, isOn)
    if not self.buildData or self.buildData.level <= 0 then
        local cfg = _G.ConfigManager.afk2_cfg[self.config.condition[1]]
        _G.PopWindowManager:GetInstance():ShowAllTips(970101, nil, nil, nil, nil, nil, cfg.number)
        return
    end

    local config = self.buildData.config
    local curTimes = _G.Mathf.Floor((_G.TimeUtil.GetServerUnixTime() - self.buildData.award_time) /
        config.time[self.buildData.level])
    if curTimes < 1 then
        _G.PopWindowManager:GetInstance():ShowAllTips(970102)
    else
        self.parentView:GetBuildAward(self.config.id)
    end
end

return AfkBuildingItem
