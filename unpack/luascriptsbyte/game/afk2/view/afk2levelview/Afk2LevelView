---@class Afk2LevelView : UIBaseView   灵域巡查-等级详情
---@field go_table Afk2LevelView_GoTable
---@field opeingView string                         @正在打开的页面
local Afk2LevelView = _G.BaseClass("Afk2LevelView", _G.UIBaseView)

function Afk2LevelView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function Afk2LevelView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
end

function Afk2LevelView:OnCreate()
    self:RefreshState()
end

---刷新页面状态
---@return void
function Afk2LevelView:RefreshState()
    local model = require("Afk2Model"):GetInstance()
    local level = model:GetAfkLevel()
    local exp = model:GetAfkExp()
    local cfg = _G.ConfigManager.afk2_level_cfg[level]
    --本级拥有的经验和升级所需经验
    local needExp = cfg.afk2_exp[2]
    if level > 1 then
        local preCfg = _G.ConfigManager.afk2_level_cfg[level - 1]
        needExp = cfg.afk2_exp[2] - preCfg.afk2_exp[2]
        exp = math.max(exp - preCfg.afk2_exp[2], 0)
    end

    self.go_table.aortext_level.text = _G.GetLangPackValue(90000011492, level)
    self.go_table.aortext_exp.text = needExp > 0 and (exp .. "/" .. needExp) or ""
    self.go_table.slider_level.value = needExp > 0 and (exp / needExp) or 1
end

---跳转新页面后, 再关闭本页面
---@return void
function Afk2LevelView:OnUIOpened(name)
    if name ~= self.opeingView then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    self:Close()
end

---监听界面UI事件
---@return void
function Afk2LevelView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close1 then
        self:Close()
    elseif go == self.go_table.aorbtn_reward then
        local model = require("Afk2Model"):GetInstance()
        if model:GetAfkSid() <= 0 then
            --未进行任何挑战
            _G.PopWindowManager:GetInstance():ShowAllTips(970112)
            return
        end
        self.opeingView = _G.ConfigManager.ui_cfg.Afk2RewardView.Name
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
        _G.UIManager:GetInstance():OpenWindow(self.opeingView)
    elseif go == self.go_table.aorbtn_challenge then
        local model = require("Afk2Model"):GetInstance()
        local nextSid = model:GetAfkNextSid()
        if nextSid <= 0 then
            --TODO: 已完成所有关卡
            return
        end
        --检查是否满足等级要求
        local needLevel = _G.ConfigManager.afk2_cfg[nextSid].afk2_lv
        if model:GetAfkLevel() < needLevel then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.Afk2UpgradeWayView.Name)
            return
        end
        self:Close()
        model:InitFight()
        model:Fight()
    end
end

return Afk2LevelView
