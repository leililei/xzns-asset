local base = require("BaseGameNet")

---@class Afk2Net : BaseGameNet	通信协议
local Afk2Net = _G.BaseClass("Afk2Net", base)
---@return Afk2Net Afk2Net
function Afk2Net:GetInstance()
    return base.GetInstance(self)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function Afk2Net:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function Afk2Net:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---获取关卡信息
function Afk2Net:GetAfkInfo(callBack)
    self:Access(_G.ConfigManager.net_map.game_afk2_get_info, self:GetEmptyPB(), callBack)
end

---领取挂机奖励
function Afk2Net:GetAfkAward(pbData, callBack)
    self:Access(_G.ConfigManager.net_map.game_afk2_award, pbData, callBack)
end

