---是否有订单解锁
function Afk2Model:CheckUnlockOrder()
    if _G.table.isEmptyOrNil(self.buildData) then
        return false
    end

    local config = _G.ConfigManager.afk2_building_cfg
    for _, v in pairs(self.buildData) do
        if v.level >= config[v.sid].open_level then
            return true
        end
    end

    return false
end

---获取建筑最大挂机时间
---@param id number 建筑id
---@param level number 建筑等级
function Afk2Model:GetBuildMaxTime(id, level)
    level = level or self.buildData and self.buildData[id].level or 1
    local maxTimeList = _G.ConfigManager.afk2_building_cfg[id].max_time
    if maxTimeList[level] then
        return maxTimeList[level] * 60
    end

    ---没有配置最大挂机时间就取最后一个
    return maxTimeList[#maxTimeList] * 60
end

---获取状态枚举
function Afk2Model:GetOrderStatusEnum()
    return self.OrderStatus
end

---订单是否解锁
---@param id number 建筑id
---@param config afk2_building_cfg
function Afk2Model:CheckOrderIsUnlock(id, config)
    if not config then
        config = _G.ConfigManager.afk2_building_cfg[id]
    end

    if self.buildData[id] and self.buildData[id].level >= config.open_level then
        return true
    end

    return false
end

---获取订单状态
---@param id number 建筑id
function Afk2Model:GetOrderStatus(id)
    local buildData = self.buildData[id]
    if not buildData then
        return self.OrderStatus.NotStart
    end

    if buildData.order_time > 0 then
        local serverTime = _G.TimeUtil.GetServerUnixTime()
        if buildData.order_time <= serverTime then
            return self.OrderStatus.Finished
        end

        return self.OrderStatus.Running
    end

    return self.OrderStatus.NotStart
end

---有奖励可领取的建筑列表
---@return ids table
function Afk2Model:GetBuildAwardList()
    local ids = {}
    if _G.table.isEmptyOrNil(self.buildData) then
        return ids
    end

    local serverTime = _G.TimeUtil.GetServerUnixTime()
    for _, v in pairs(self.buildData) do
        if serverTime - v.award_time >= v.config.time[v.level] then
            _G.table.insert(ids, v.sid)
        end
    end
    return ids
end

---快速挂机最大免费次数
function Afk2Model:GetMaxFreeAwardTimes()
    local initTimes = _G.ConfigManager.discrete_cfg[115703][1][1]
    if require("MonthlyModel"):GetInstance():IsHavePrivi(405005) then
        local data = PrivilegeManager:GetInstance():GetPrivilegeDataNew(
            { _G.PrivilegeType.LimitedTimePrivilege.Afk2AwardTimes }
        )
        for _, v in pairs(data) do
            initTimes = initTimes + v[2]
        end
    end
    return initTimes
end

---获取付费奖励次数
function Afk2Model:GetFreeTimes()
    return self.freeTimes
end

---是否有免费次数
function Afk2Model:CheckHaveFreeTimes()
    local maxTimes = self:GetMaxFreeAwardTimes()
    return self.freeTimes < maxTimes, maxTimes - self.freeTimes
end

---快速挂机最大免费次数
function Afk2Model:GetMaxAwardTimes()
    local initTimes = _G.ConfigManager.discrete_cfg[115704][1][1]
    if require("MonthlyModel"):GetInstance():IsHavePrivi(405005) then
        local data = PrivilegeManager:GetInstance():GetPrivilegeDataNew(
            { _G.PrivilegeType.LimitedTimePrivilege.Afk2BuildGetAward }
        )
        for _, v in pairs(data) do
