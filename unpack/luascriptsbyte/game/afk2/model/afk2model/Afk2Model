--region ===========================战斗逻辑===================================

---检查目标关卡是否已达最后一关
---@return boolean
function Afk2Model:CheckSectionIsEnd(sid)
    local cfg = _G.ConfigManager.afk2_cfg[sid]
    if not cfg or not _G.ConfigManager.afk2_cfg[cfg.next_section] then
        return true
    end
    return false
end

---初始化挑战信息
function Afk2Model:InitFight(autoFight)
    self.autoFight = autoFight or false
end

---挑战当前关卡
---@return void
function Afk2Model:Fight(autoFight)
    self:InitFight(autoFight)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.Afk2EmbattleView.Name,
        _G.handler(self, self.ExitEmbattle),
        function(_, _, skipBattle)
            if skipBattle then
                self:SkipFight()
            else
                self:EnterFight()
            end
        end,
        self.autoFight
    )
end

---重新进行挑战
---@return void
function Afk2Model:ReFight()
    self.autoFight = false
    self:Fight()
end

---进入战斗
---@return void
function Afk2Model:EnterFight()
    local sid = self:GetAfkNextSid()
    local cfg = _G.ConfigManager.afk2_cfg[sid]

    _G.BattleManager:GetInstance():EnterFight(_G.BattleControllerType.afk2, sid, cfg.monster_group)
end

---跳过战斗
---@return void
function Afk2Model:SkipFight()
    local sid = self:GetAfkNextSid()
    local cfg = _G.ConfigManager.afk2_cfg[sid]

    _G.BattleManager:GetInstance():SetInBattle(true)
    --发起战斗结算
    require("Afk2Net"):GetInstance():SatrtFight(
        { sid = sid, monster_sid = cfg.monster_group },
        function(msg)
            if not msg or msg.ack ~= 1 then
                _G.BattleManager:GetInstance():SetInBattle(false)
                return
            end
            --计算战斗结果
            _G.BattleManager:GetInstance():SetArgDataAutoCmd(msg.fight_arg)
            local record = _G.BattleManager:GetInstance():GetStatisticsRecord(msg.fight_arg)
            if not record or not record.result then
                _G.BattleManager:GetInstance():SetInBattle(false)
                return
            end

            ---@type BattleControllerAfk2
            local controller = _G.require(_G.BattleControllerType.afk2).New()
            controller.sid = sid
            controller.monsterId = cfg.monster_group
            controller.curFightState = 4 --设置战斗结束

            _G.BattleManager:GetInstance():SetArgData(msg.fight_arg)
            _G.BattleManager:GetInstance():SetStatisticsCached(record)
            _G.BattleManager:GetInstance():SetBattleController(controller)
            --显示结算界面
            controller:FightResultFunc(record.result)
        end
    )
end

---离开战斗
---@return void
function Afk2Model:ExitEmbattle()
    self:ShowWindows()
end

---返回主页面(刷新)
---@return void
function Afk2Model:ReturnPanel(isWin, id)
    if id == require("SettlementModel").FunctionEnum.Next then
        return
    end
    self:ShowWindows()
end

function Afk2Model:ShowWindows()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ZhenRongView.Name)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.Afk2MainView.Name)

    ---@type Afk2MainView
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.Afk2MainView.Name)
    if view then
        view:RefreshView()
        view:MoveCurrentSction()
    end
end

---监听界面打开
---@param name string 界面名称
function Afk2Model:OnEmbattleViewOpened(name)
    if name ~= _G.ConfigManager.ui_cfg.EmbattleView.Name then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ZhenRongView.Name)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.Afk2MainView.Name)
end

