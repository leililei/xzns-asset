end

---建筑解锁红点
function Afk2Model:CheckBuildUnlock(sid)
    local buildId = self:GetSectionUnlock(sid)
    if buildId and buildId > 0 and not self.buildData[buildId] then
        ---建筑解锁红点
        _G.PlayerPrefsManager.SetInt("Afk2BuildUnlockId_" .. buildId, 1)
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.Afk2BuildUnlock.id)
        self:GetBuildInfo({ buildId }, function()
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.Afk2BuildLevelUp.id)
            _G.Events:GetInstance():Broadcast(_G.eAfk2Events.BuildLevelChange, buildId)
        end)
        return
    end

    if self:CheckCanLevelUp() == 1 then
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.Afk2BuildLevelUp.id)
    end
end

---获取未弹解锁弹窗的建筑id列表
function Afk2Model:GetUnlockBuildList()
    local unlockList = _G.PlayerPrefsManager.GetTable("Afk2BuildUnlockIdList") or {}
    local list = {}
    if _G.table.isEmptyOrNil(self.buildData) then
        return list
    end
    for _, v in pairs(self.buildData) do
        if v.level == 1 and not unlockList[v.sid] then
            _G.table.insert(list, v)
            unlockList[v.sid] = 1
        end
    end
    if not _G.table.isEmptyOrNil(list) then
        _G.PlayerPrefsManager.SetTable("Afk2BuildUnlockIdList", unlockList)
    end
    return list
end

