---获取关卡对应开启的建筑
---@return number,number    @(对应建筑ID, 建筑等级)
function Afk2Model:GetSectionUnlock(id)
    if not self.sectionUnlocks then
        self.sectionUnlocks = {}
        for _, cfg in pairs(_G.ConfigManager.afk2_building_cfg) do
            local buildId = cfg.id
            for lv, id in pairs(cfg.condition) do
                self.sectionUnlocks[id] = { buildId = buildId, level = lv }
            end
        end
    end

    local state = self.sectionUnlocks[id]
    if not state then
        return 0, 0
    end
    return state.buildId, state.level
end

