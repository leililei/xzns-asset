local Afk2Model = _G.BaseClass("Afk2Model", _G.GameDataModelBase)

---@return Afk2Model Afk2Model
function Afk2Model:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function Afk2Model:__init()
    self.curFunctionOpenID = _G.FunctionID.Afk2
    ---订单状态
    self.OrderStatus = {
        NotStart = 1,
        Running = 2,
        Finished = 3
    }
    self.buildData = {}
    self.orderDataList = {}

    self.rewardTimer = _G.TimerManager:GetInstance():GetTimer(60, self.RefreshRewardView, self, false, false, true)
    self.rewardTimer:Start()
    _G.Events:GetInstance():AddListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.FunOpen, self)
end

---新功能解锁，刷新红点
function Afk2Model:FunOpen(mainFunid)
    if mainFunid == self.curFunctionOpenID then
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.Afk2Privilege.id)
    end
end

function Afk2Model:GetDataFormServer()
    Afk2Net:GetInstance():GetAfkInfo(_G.handler(self, self.ParseData))
end

---解析数据
---@param msg afk2.s2c_afk2_info
function Afk2Model:ParseData(msg)
    self.sid = msg.sid or 0
    self.time = msg.time
    self.num = msg.num or 0
    self.freeTimes = msg.free_times or 0
    self.times = msg.times or 0
    self:ParseExp(msg.exp)
    --关卡奖励
    self.afkRewards = {}
    if msg.g_sids then
        for _, sid in pairs(msg.g_sids) do
            self.afkRewards[sid] = true
        end
    end
    if msg.builds then
        local buildConfig = _G.ConfigManager.afk2_building_cfg
        for _, v in pairs(msg.builds) do
            ---最大等级
            local material = buildConfig[v.sid].material
            v.maxLevel = #material + 1
            v.config = buildConfig[v.sid]
            self.buildData[v.sid] = v
            if self:GetOrderStatus(v.sid) == self.OrderStatus.Running then
                self.orderDataList[v.sid] = 1
            end
        end
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.Afk2Order.id)
    end
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.Afk2RewardView.Name)
    if view then
        view:RefreshQuickReward()
    end
    self:SetOrderTimer()
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.Afk2BuildLevelUp.id)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.Afk2Build.id)
    self:RefreshSectionAwardRedPoint()
    self.super.ParseData(self)
end

---订单计时器
function Afk2Model:SetOrderTimer()
    if self.orderTimer then
        return
    end
    self.orderTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateOrderTimer, self, false, false, true)
    self.orderTimer:Start()
end

function Afk2Model:UpdateOrderTimer()
    local isDataChange = false
    for sid, _ in pairs(self.orderDataList) do
        if self:GetOrderStatus(sid) == self.OrderStatus.Finished then
            isDataChange = true
            self.orderDataList[sid] = nil
        end
    end
    if isDataChange then
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.Afk2Order.id)
    end
end

---解析经验值
---@param exp number
---@return void
function Afk2Model:ParseExp(exp)
    exp = exp or 0

    self.exp = exp
    self.level = 1
    --二分查找等级(数据源必需是有序排列)
    local afk2_level_cfg = _G.ConfigManager.afk2_level_cfg
    local low, high = 1, #afk2_level_cfg
    while low <= high do
        local mid = math.floor((low + high) / 2) --取中间位置

        local needExp = afk2_level_cfg[mid].afk2_exp[2]
        if exp >= needExp then
            low = mid + 1
        elseif exp < needExp then
            high = mid - 1
        end
    end

    local level = math.max(math.min(low, high), 1)
    local needExp = afk2_level_cfg[level].afk2_exp[2]
    if exp >= needExp and afk2_level_cfg[level + 1] then
        level = level + 1
    end
    self.level = level
end

---获取经验值奖励
---@param msg public.s2c_common_ack|any
---@return void
function Afk2Model:ReceiveExpData(msg)
    if not msg or not msg.award or not msg.award.item then
        return
    end
    --计算经验值更改
    local expId, expNum = _G.ConfigManager.afk2_level_cfg[1].afk2_exp[1], 0
    for _, item in pairs(msg.award.item) do
        if item.type[1] == expId then
            expNum = expNum + item.type[2]
        end
    end
    if expNum > 0 then
        self:ParseExp(self.exp + expNum)
    end
end

