---获取第一个关卡
---@return number
function Afk2Model:GetAfkFirstSid()
    if not self.firstSectionSid then
        self.firstSectionSid = 0
        for _, section in pairs(_G.ConfigManager.afk2_cfg) do
            if section.number == 1 then
                self.firstSectionSid = section.id
                break
            end
        end
    end
    return self.firstSectionSid
end

---获取下一个需要挑战的关卡
---@return void
function Afk2Model:GetAfkNextSid()
    local sid = self:GetAfkSid()
    if sid == 0 or not _G.ConfigManager.afk2_cfg[sid] then
        return self:GetAfkFirstSid()
    end

    local nextSid = _G.ConfigManager.afk2_cfg[sid].next_section
    if nextSid and _G.ConfigManager.afk2_cfg[nextSid] then
        return nextSid
    end
    return 0
end

