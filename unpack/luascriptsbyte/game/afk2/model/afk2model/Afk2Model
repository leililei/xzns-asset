--region ===========================通讯协议===================================
---获取建筑基础数据
function Afk2Model:GetBuildInfo(sids, callBack)
    Afk2Net:GetInstance():GetBuildInfo(
        { sids = sids },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            if msg.builds then
                local buildConfig = _G.ConfigManager.afk2_building_cfg
                for _, v in pairs(msg.builds) do
                    if not self.buildData[v.sid] then
                        ---最大等级
                        local material = buildConfig[v.sid].material
                        v.maxLevel = #material + 1
                        v.config = buildConfig[v.sid]
                    end
                    self.buildData[v.sid] = v
                end
            end
            if callBack then
                callBack()
            end
        end
    )
end

---获取建筑奖励
---@param sids table 领取奖励的建筑id列表
function Afk2Model:GetBuildAward(sids, callBack)
    local pbData = { sids = sids, time = _G.TimeUtil.GetServerUnixTime() }
    Afk2Net:GetInstance():GetBuildAward(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIUtils.ShowCommonAward(msg)
            ---更新数据
            if msg.builds then
                for _, v in pairs(msg.builds) do
                    v.config = self.buildData[v.sid].config
                    v.maxLevel = self.buildData[v.sid].maxLevel
                    self.buildData[v.sid] = v
                end
            end
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.Afk2Build.id)
            if callBack then
                callBack()
            end
            _G.Events:GetInstance():Broadcast(_G.eAfk2Events.RefreshBuildAward, sids)
        end
    )
end

---升级建筑
---@param sid number 建筑id
---@param level number 建筑当前的等级
function Afk2Model:BuildLevelUp(sid, level, material, callBack)
    Afk2Net:GetInstance():BuildLevelUp(
        { sid = sid },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self.buildData[sid].level = level + 1
            _G.StorageManager:GetInstance():ConsumeItem(material[1], material[1], material[2])
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.Afk2BuildLevelUp.id)
            _G.Events:GetInstance():Broadcast(_G.eAfk2Events.BuildLevelChange, sid)
            if callBack then
                callBack()
            end
        end
    )
end

---开始下单
---@param sid number 建筑id
function Afk2Model:StartOrder(sid, callBack)
    Afk2Net:GetInstance():StartOrder(
        { sid = sid },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            if self.buildData[sid] then
                local exchange_time = _G.ConfigManager.afk2_building_cfg[sid].exchange_time
                self.buildData[sid].order_time = _G.TimeUtil.GetServerUnixTime() + exchange_time * 60
            end
            self.orderDataList[sid] = 1
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.Afk2Order.id)
            if callBack then
                callBack()
            end
        end
    )
end

---领取订单奖励
---@param sid number 建筑id
---@param type number 领奖类型 1:加急 2:普通领奖
---@param callBack function 回调
function Afk2Model:GetOrderAward(sid, type, callBack)
    Afk2Net:GetInstance():GetOrderAward(
        { sid = sid, type = type },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            if self.buildData[sid] then
                self.buildData[sid].order_time = 0
            end
            if self.orderDataList[sid] then
                self.orderDataList[sid] = nil
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIUtils.ShowCommonAward(msg)
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.Afk2Order.id)
            if callBack then
                callBack()
            end
        end
    )
end

---领取挂机奖励
---@param type number 领奖类型 1:领奖 2:预览
---@param callbcak fun(msg:public.s2c_common_ack):void
function Afk2Model:GetAfkAward(type, callbcak)
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    ---@param msg public.s2c_common_ack
    Afk2Net:GetInstance():GetAfkAward(
        { time = serverTime, type = type },
        function(msg)
            if not msg or msg.ack ~= 1 then
                return
            end
            local lv = self.level
            if type == 1 then
                --获取奖励
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                --更新缓存信息
                self.time = msg.next_time or serverTime
                self:ReceiveExpData(msg)

                self:RefreshRewardView()
            end

            if callbcak then
                callbcak(msg, lv, self.level)
            end
        end
    )
end

---领取快速挂机奖励
---@param type number 类型，暂时默认都是1
---@param isFree boolean 是否是领取免费奖励
function Afk2Model:GetQucikAfkAward(type, num, callbcak)
    Afk2Net:GetInstance():GetAfkQucikAward(
        { type = type },
        function(msg)
            if not msg or msg.ack ~= 1 then
                return
            end
            local lv = self.level
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            self:ReceiveExpData(msg)

            if num and num > 0 then
                self.times = self.times + 1
                _G.StorageManager:GetInstance():ConsumeItem(_G.ResPropID.Diamond, _G.ResPropID.Diamond, num)
            else
                self.freeTimes = self.freeTimes + 1
            end
            if callbcak then
                callbcak(msg, lv, self.level)
            end
        end
    )
end

---领取关卡一次性奖励
---@param sids number[]     需要领取的关卡id列表
---@param callback fun(msg:public.s2c_common_ack):void
function Afk2Model:GetAfkSectionAward(sids, callbcak)
    Afk2Net:GetInstance():GetAfkSectionAward(
        { sids = sids },
        function(msg)
            if not msg or msg.ack ~= 1 then
                return
            end
            local lv = self.level
            --接收奖励
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            --缓存数据
            if not self.afkRewards then
                self.afkRewards = {}
            end
            for _, sid in pairs(sids) do
                self.afkRewards[sid] = true
            end
            self:ReceiveExpData(msg)

            --刷新红点
            self:RefreshSectionAwardRedPoint()

            if callbcak then
                callbcak(msg, lv, self.level)
            end
        end
    )
end

--endregion

--region 红点
---第一次解锁建筑的红点
function Afk2Model:CheckFirstUnlock()
    if _G.table.isEmptyOrNil(self.buildData) then
        return 0
    end

    for _, v in pairs(self.buildData) do
        if _G.PlayerPrefsManager.GetInt("Afk2BuildUnlockId_" .. v.sid, 0) == 1 then
            return 1
        end
    end

    return 0
end

function Afk2Model:BuildAwardTimer()
    ---每分钟检测一次
    if not self.buildAwardTimer then
        self.buildAwardTimer = _G.TimerManager:GetInstance():GetTimer(60, self.RefreshBuildRedPoint, self, false, false,
            true)
        self.buildAwardTimer:Start()
    end
end

function Afk2Model:RefreshBuildRedPoint()
    if self:CheckBuildRedPoint() == 1 then
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.Afk2Build.id)
        _G.Events:GetInstance():Broadcast(_G.eAfk2Events.RefreshBuildRedPoint)
    end
end

---建筑资源红点-资源大于80%显示红点
function Afk2Model:CheckAllBuildRedPoint()
    if _G.table.isEmptyOrNil(self.buildData) then
        return 0
    end

    local serverTime = _G.TimeUtil.GetServerUnixTime()
    for _, v in pairs(self.buildData) do
        if self:CheckBuildRedPoint(v, serverTime) == 1 then
            return 1
        end
    end

    return 0
end

---某个建筑的资源是否达到80%以上
function Afk2Model:CheckBuildRedPoint(buildData, serverTime)
    if _G.table.isEmptyOrNil(buildData) then
        return 0
    end

    if not serverTime then
        serverTime = _G.TimeUtil.GetServerUnixTime()
    end
    local maxTime = self:GetBuildMaxTime(buildData.sid)
    if serverTime - buildData.award_time >= _G.Mathf.Floor(maxTime * 0.8) then
        return 1
    end

    return 0
end

---订单红点
function Afk2Model:CheckOrderRedPoint()
    if _G.table.isEmptyOrNil(self.buildData) then
        return 0
    end

    for _, v in pairs(self.buildData) do
        if self:GetOrderStatus(v.sid) == self.OrderStatus.Finished then
            return 1
        end
    end

    return 0
end

---可升级提示红点
function Afk2Model:CheckCanLevelUp()
    if _G.table.isEmptyOrNil(self.buildData) then
        return 0
    end

    for _, v in pairs(self.buildData) do
        if self:CheckBuildCanLevelUp(v.sid, v) == 1 then
            return 1
        end
    end

    return 0
end

---某一个建筑是否可升级或第一次解锁
---@param data table 建筑数据
function Afk2Model:CheckBuildCanLevelUp(buildId, data)
    data = data or self.buildData[buildId]
    if _G.table.isEmptyOrNil(data) then
        return 0
    end

    local material = data.config.material[data.level]
    if _G.PlayerPrefsManager.GetInt("AfkBuildingYcTip_" .. data.sid, 0) == 1 and
        data.level + 1 <= data.maxLevel and
        self.sid >= data.config.condition[data.level + 1] and
        _G.StorageManager:GetInstance():CheckItem(material[1], material[2])
    then
        return 1
    end

    return 0
end

---特权红点
function Afk2Model:CheckPrivilegeRedPoint()
    if require("MonthlyModel"):GetInstance():IsHavePrivi(405005) then
        return 0
    end
    local privilege = _G.PlayerPrefsManager.GetInt("Afk2Privilege_RrfreshTime", 0)
    return privilege ~= _G.TimeUtil.GetMondaySixTime() and 1 or 0
end

function Afk2Model:RefreshPrivilegeRedPoint()
    local privilege = _G.PlayerPrefsManager.GetInt("Afk2Privilege_RrfreshTime", 0)
    if privilege ~= _G.TimeUtil.GetMondaySixTime() then
        _G.PlayerPrefsManager.SetInt("Afk2Privilege_RrfreshTime", _G.TimeUtil.GetMondaySixTime())
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.Afk2Privilege.id)
    end
end

---检测关卡奖励红点数量
---@return number
function Afk2Model:CheckSectionAwardRedPoint()
    if not self:CheckFunctionUnlock() then
        return 0
    end
    --未通关任何关卡
    if self:GetAfkSid() <= 0 then
        return 0
    end

    --检查未领取奖励的关卡
    local move = _G.ConfigManager.afk2_cfg[self:GetAfkSid()]
    while move do
        if move and move.reward and #move.reward > 0 and not self:CheckAfkSectionAward(move.id) then
            return 1
        end
        move = _G.ConfigManager.afk2_cfg[move.pre_section]
    end
    return 0
end

---刷新关卡奖励红点
---@return void
function Afk2Model:RefreshSectionAwardRedPoint()
    --刷新红点
    require("RedPointManager"):GetInstance():RefreshNode(
        _G.ConfigManager.redpoint_cfg.Afk2SectionAward.id
    )
end

--endregion

---奖励界面跳转
function Afk2Model:JumpAwawdView()
    local mainView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.Afk2MainView.Name)
    if not mainView then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.Afk2MainView.Name)
    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.Afk2RewardView.Name)
end

---销毁对象时,析构函数
function Afk2Model:Dispose()
    if self.buildAwardTimer then
        self.buildAwardTimer:Stop()
        self.buildAwardTimer = nil
    end
    if self.rewardTimer then
        self.rewardTimer:Stop()
        self.rewardTimer = nil
    end
    if self.orderTimer then
        self.orderTimer:Stop()
        self.orderTimer = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    _G.Events:GetInstance():RemoveListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.FunOpen, self)
end

return Afk2Model
