local ServerLineManager = require "ServerLineManager"

---@field public go_table ServerlineChooseView_GoTable
---@field public LineList ServerlineChooseView._obj_xianluListItem_GoTable[]
---@field public QujianList ServerlineChooseView._obj_qujianItem_GoTable[]
---@class ServerlineChooseView : UIBaseView	服务器选择界面
local ServerlineChooseView = _G.BaseClass("ServerlineChooseView", _G.UIBaseView)
local qujian = 10
local CS = _G.CS
local typeof = _G.typeof

function ServerlineChooseView:Awake()
    self.aorImage_keys = {
        ---流畅
        lc = "ui_dl_pic_lvse",
        ---爆满
        bm = "ui_dl_pic_hongshe",
        ---拥挤
        yj = "ui_dl_pic_chengse"
    }
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.curQuJianInfo = nil
    self.curLineList = nil
end
function ServerlineChooseView:OnDestroy()
    self.LineList = nil
    self.curLineList = nil
    self.curQuJianInfo = nil
    self.QujianList = nil
    self.QujianCfg = nil
end

---界面的入口函数
function ServerlineChooseView:OnCreate()
    self.curLine = nil --xianlu item 当前线路
    self.curQuJian = nil --qujian item  当前区间
    self.LineList = {}
    self.QujianList = {}
    self.QujianCfg = {}

    self.curServerNum = ServerLineManager:GetInstance():GetCurServerLine() --当前线路信息取
    self.totalServerLineCount = ServerLineManager:GetInstance():GetLineCount() --从服务器取

    self.qujianCount = math.ceil(self.totalServerLineCount / qujian) --区间数量
    self.curQuJianNum = math.ceil(self.curServerNum / qujian) --当前区间
    self:InitQujian()
    self:SetQujian(self.QujianCfg[self.curQuJianNum])
    self.go_table.scrollloopvectical_XianluXuanze:InitItemData(
        #self.curLineList,
        _G.handler(self, self.RefreshXianluItem)
    )
    self.go_table.scrollloopvectical_Qujianxuanze:InitItemData(
        #self.QujianCfg,
        _G.handler(self, self.RefreshQujianItem)
    )
    local curItemIndex = self.curServerNum % qujian == 0 and 9 or self.curServerNum % qujian - 1
    local index = curItemIndex < 5 and 0 or 6
    self.go_table.scrollloopvectical_XianluXuanze:ScrollToIndex(index)
    self.go_table.aortext_curxianlunuum.text = tostring(self.curServerNum)
end
function ServerlineChooseView:InitQujian()
    local tb = {}
    local count = self.qujianCount
    local extend = self.totalServerLineCount % qujian
    --总线路数量是否能与区间整除
    -- if self.totalServerLineCount % qujian ~= 0 then
    --     extend = self.totalServerLineCount % qujian
    -- end
    for i = 1, count do
        local index = i
        if not tb[index] then
            tb[index] = {index = i, LineList = {}}
        end
        if i <= count - 1 then
            for k = 1, qujian do
                tb[index].LineList[#tb[index].LineList + 1] = (i - 1) * qujian + k
            end
        end
    end
    if extend > 0 then
        for i = 1, extend do
            tb[count].LineList[i] = (count - 1) * qujian + i
        end
    else
        for k = 1, qujian do
            tb[count].LineList[#tb[count].LineList + 1] = (count - 1) * qujian + k
        end
    end
    table.insertto(self.QujianCfg, table.toArray(tb))
end
--刷新
function ServerlineChooseView:RefreshQujianItem(index, trans)
    local tblIndex = index + 1
    local cfg = self.QujianCfg[tblIndex]
    if cfg then
        local instanceID = trans:GetInstanceIDE()
        if not self.QujianList[instanceID] then
            trans:SetName(index)
            local go_table =
                _G.GetAutoGoTable(
                trans,
                function(btn, isOn)
                    self:OnClickQujian(btn, isOn)
                end
            )
            self.QujianList[instanceID] = go_table
            --定位
            if self.curQuJianNum == cfg.index then
                self.curQuJian = self.QujianList[instanceID]
                self.QujianList[instanceID].toggle_qujianxuanze.isOn = true
            end
        end
        local tb = self.QujianList[instanceID]
        tb.cfg = cfg
        --按照实际数量设置区间text
        tb.aortext_Desc.text =
            tostring((cfg.index - 1) * 10 + 1) ..
            (#cfg.LineList > 1 and "-" .. tostring((cfg.index - 1) * 10 + #cfg.LineList) or "")
        tb.aortext_DescOn.text =
            tostring((cfg.index - 1) * 10 + 1) ..
            (#cfg.LineList > 1 and "-" .. tostring((cfg.index - 1) * 10 + #cfg.LineList) or "")
        _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, self.curQuJianNum == cfg.index)
    end
end
--循环刷新单个区间
---@param trans Transform
---@param index number obj索引从零开始
function ServerlineChooseView:RefreshXianluItem(index, trans)
    local tblIndex = index + 1
    local cfg = self.curLineList[tblIndex]
    local instanceID = trans:GetInstanceIDE()
    if cfg then
        if not self.LineList[instanceID] then
            trans:SetName(index)
            local go_table =
                _G.GetAutoGoTable(
                trans,
                function(btn, isOn)
                    self:OnClickItemBtn(btn, isOn)
                end
            )
            self.LineList[instanceID] = go_table
        end
        local tb = self.LineList[instanceID]
        --不是当前item 将选中图隐藏
        if cfg == self.curServerNum then
            self.curLine = tb
            tb.aorimage_isOn:SetActiveE(1)
            tb.aorimage_me:SetActiveE(1)
        else
            tb.aorimage_isOn:SetActiveE(0)
            tb.aorimage_me:SetActiveE(0)
        end
        tb.aortext_xianlu.text = tostring(cfg)
        local stateSpName = self.aorImage_keys.lc
        tb.aorimage_xianlustate.SpriteName = stateSpName
        tb.aortext_state.text = _G.GetLangPackValue(90021100013)
    end
    _G.GameUtil.SetActiveByCondition(self.LineList[instanceID].gameObject, cfg ~= nil)
end
--点击区间回调
function ServerlineChooseView:OnClickQujian(go, isOn)
    local instanceID = go:GetParent():GetInstanceIDE()
    local tb = self.QujianList[instanceID]
    if isOn then
        if tb.cfg then
            if tb.cfg ~= self.curQuJianInfo then
                self.curQuJian.aorimage_isOn:SetActiveE(0)
                self.curQuJian.toggle_qujianxuanze.isOn = false
                tb.aorimage_isOn:SetActiveE(1)
                self.curQuJian = tb
                self:SetQujian(tb.cfg)
                self.go_table.scrollloopvectical_XianluXuanze:UpdateAllItem()
                self.go_table.scrollloopvectical_XianluXuanze:ScrollToTop()
            end
        end
    end
end
--设置区间
function ServerlineChooseView:SetQujian(qujian)
    self.curQuJianInfo = qujian
    self.curLineList = qujian.LineList
end
--设置选中的线路
function ServerlineChooseView:SetSelectLine(id)
    if self.curLineList then
        --local id =self.curServer.id
        if self.LineList[id] then
            self.curLine.toggle_Select.isOn = false
            self.curLine.aorimage_isOn:SetActiveE(0)
            self.LineList[id].toggle_Select.isOn = true
            self.LineList[id].aorimage_isOn:SetActiveE(1)
        else
            return
        end
    else
        return
    end
    self.curLine = self.LineList[id]
    self.go_table.aortext_curxianlunuum.text = tostring(self.curServerNum)
end
---toggle点击事件在这里派发
---@param _ UnityEngine.GameObject
---@param isOn boolean
---@param cfg table
---@param index number
function ServerlineChooseView:OnClickItemBtn(trans, isOn)
    if isOn then
        local instanceID = trans:GetParent():GetInstanceIDE()
        local tb = self.LineList[instanceID]
        local cfg = tonumber(tb.aortext_xianlu.text)
        if self.curServerNum ~= cfg then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                450301,
                string.format(_G.LangUtil.GetLangPackValue(_G.ConfigManager.tips_system_cfg[450301].content), cfg),
                function()
                    ServerLineManager:GetInstance():ChangeServerLine(
                        cfg,
                        function(success)
                            if success then
                                self.curServerNum = cfg
                                self:SetSelectLine(instanceID)
                                self:Close()
                            else
                            end
                        end
                    )
                end
            )
        end
    --点击后
    --self:Close()
    end
end
---按钮点击事件在这里派发
function ServerlineChooseView:OnClickBtn(btn)
    local name = btn:GetName()
    if name == "@_aorbtn_down" then
        _G.DelayDo(
            0.01,
            function()
                self.go_table.scrollloopvectical_XianluXuanze:ScrollToIndex(#self.curLineList - 1)
            end
        )
    elseif name == "@_aorbtn_Close" or name == "@_aorbtn_CloseView" then
        self:Close()
    end
end
return ServerlineChooseView
