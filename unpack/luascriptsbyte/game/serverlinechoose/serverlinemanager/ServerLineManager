---分线状态枚举
local lineState = {
    empty = 1,
    busy = 2,
    full = 3
}
---分线空闲状态配置ID
local lineStateEmptyDiscreteID = 103803
---分线忙碌状态配置ID
local lineStateBusyDiscreteID = 103804
---分线数量配置ID
local lineSumNumDiscreteID = 103805

local WorldNet = require "WorldNet"
local base = require "GameDataModelBase"
---@class ServerLineManager : Singleton	中文描述
local ServerLineManager = _G.BaseClass("ServerLineManager", base)
ServerLineManager.LineState = lineState
---创建对象时,入口构造函数
function ServerLineManager:__init()
    self.allLinesTab = {}
    self.curLine = 0
    self.lineStateCount = {}
end

---销毁对象时,析构函数
function ServerLineManager:Dispose()
    self.allLinesTab = nil
    self.curLine = nil
    self.lineStateCount = nil
end

---从服务器拉取数据
function ServerLineManager:GetDataFormServer()
    local cfg = _G.ConfigManager.discrete_cfg
    self.lineStateCount.empty = cfg[lineStateEmptyDiscreteID][1][1]
    self.lineStateCount.busy = cfg[lineStateBusyDiscreteID][1][1]
    WorldNet:GetInstance():GetAllLines(_G.handler(self, self.ParseData))
end
---解析数据
---@param data table 服务器返回数据
function ServerLineManager:ParseData(data)
    self.allLinesTab = data.num or {}
    if self.endCallback then
        self.endCallback(self.__cname)
    end
    self.endCallback = nil
end
--region 对外接口
---换线
---@param line number 线路ID
---@param call function 回调方法
function ServerLineManager:ChangeServerLine(line, call)
    self.changeLineCall = call
    local x, y, z = _G.WorldManager:GetInstance():GetCurWorldPlayer().Transform:GetPosition()
    y = _G.WorldUtils.PosToPointXZ(x, z)
    WorldNet:GetInstance():SwitchLine(line, y, _G.handler(self, self.OnChangeLineCall))
end
---获取当前所在分线
---@return number 分线ID
function ServerLineManager:GetCurServerLine()
    return _G.PlayerModel:GetInstance():GetServerLine()
end
---获取所有分线数据
---@return table 分线数据列表
function ServerLineManager:GetAllServerLine()
    return self.allLinesTab
end
function ServerLineManager:GetLineCount()
    return #self.allLinesTab
end
---获取分线状态
---@param id number 分线ID
---@return lineState 分线状态
function ServerLineManager:GetLineState(id)
    local num = self.allLinesTab[id] or 0
    if num <= self.lineStateCount.empty then
        return lineState.empty
    elseif num <= self.lineStateCount.busy then
        return lineState.busy
    else
        return lineState.full
    end
end
--endregion
function ServerLineManager:OnChangeLineCall(msg)
    if msg.ack == 1 then
        _G.PlayerModel:GetInstance():SetServerLine(msg.line)
        local WorldManager = _G.WorldManager:GetInstance()
        WorldManager:GetCurWorld():ClearOtherPlayer()
        WorldManager:GetCurWorld():InitOtherPlayer(
            function()
                if self.changeLineCall then
                    self.changeLineCall(true)
                    self.changeLineCall = nil
                end
                WorldManager:GetCurWorld():InstOtherPlayerItem()
            end,
            msg.users
        )
        _G.PopWindowManager:GetInstance():ShowAllTips(450101, nil, nil, nil, nil, nil, msg.line)
    else
        if self.changeLineCall then
            self.changeLineCall(false)
            self.changeLineCall = nil
        end
    end
end
return ServerLineManager
