---@class MiniMapMananger : Singleton	中文描述
---@field IsFirstOpen boolean 是否第一次打开
---@field BaseMiniView 当前场景的小地图
---@field SceneInfo table<Uid,pos> 当前场景的所有Item位置信息
---@field minimapInfo table 小地图对象
---@field SceneInfoLayer UIObj 小地图的场景图标层
---@field NormalInfoLayer UIObj 小地图的一般图标层
---@field NPCInfoLayer UIObj 小地图的NPC图标层
---@field RoleInfoLayer UIObj 小地图的Player图标层
---@field IconTable table<Uid,UIObj> 场景中所有能标识的对象
---@field MiniViewSizex number 小地图显示的大小
---@field MiniViewSizey number 小地图显示的大小
---@field MiniMapSizex number 小地图图片大小
---@field MiniMapSizey number 小地图图片大小
---@field mapRect table 右上角小地图rect组件
-----------------------------------------------------------------------
local MiniMapMananger = _G.BaseClass("MiniMapMananger", _G.Singleton)

local CS = _G.CS
local typeof = _G.typeof

local IconPerfabPath = "UI/MainView/MiniMapIcon"

---@return MiniMapMananger MiniMapMananger
function MiniMapMananger:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function MiniMapMananger:__init()
    -- _G.Events:GetInstance():AddListener(_G.ePlayerStatus.PlayerMoveing, self.OnUpdate, self)
    self.PlayerUid = _G.PlayerModel:GetInstance().role_uid
    self.IconTable = {}
end

--打开小地图
function MiniMapMananger:OpenMiniMap(minimapType)
    local MinimapType = minimapType

    if self.IsFirstOpen then
        if MinimapType == _G.MiniMapType.SectionMiniMap then
            self.CurMiniMapView = _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LevelMiniMapView.Name)
        elseif MinimapType == _G.MiniMapType.MainMiniMap then
            self.CurMiniMapView = _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MainMiniMapView.Name)
        else
            return
        end
        self.IsFirstOpen = false
        return
    end
    if self.CurMiniMapView ~= nil then
        self.CurMiniMapView.View:OpenMiniMap()
    end
end

---从mainview获取的minimap下表
function MiniMapMananger:SetMinimapInfo(Obj)
    self.minimapInfo = Obj

    self.SceneInfoLayer = nil
    self.NormalInfoLayer = nil
    self.NPCInfoLayer = nil
    self.RoleInfoLayer = nil
    self.IsFirstOpen = true

    if self.minimapInfo == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("MiniMapMananger:SetMinimapInfo >> self.minimapInfo == nil")
        end
        return
    end

    local tempLayer = self.minimapInfo.aorrawimage_SceneInfoLayer
    if tempLayer ~= nil then
        self.SceneInfoLayer = tempLayer
    end

    tempLayer = self.minimapInfo.aorrawimage_NormalInfoLayer
    if tempLayer ~= nil then
        self.NormalInfoLayer = tempLayer
    end

    tempLayer = self.minimapInfo.aorrawimage_NPCInfoLayer
    if tempLayer ~= nil then
        self.NPCInfoLayer = tempLayer
    end

    tempLayer = self.minimapInfo.aorrawimage_RoleInfoLayer
    if tempLayer ~= nil then
        self.RoleInfoLayer = tempLayer
    end

    local map = self.minimapInfo.aorrawimage_MiniMap
    if map ~= nil then
        self.mapRect = map:GetComponentE(typeof(CS.UnityEngine.RectTransform))
        if self.mapRect ~= nil then
            local x, y = self.mapRect:GetRectTransformSizeDelta()
            self.MiniViewSizex = x
            self.MiniViewSizey = y
        end
    end

    self:SetMiniMap()
end

---新场景的小地图
function MiniMapMananger:SetMiniMap()
    self.IsFirstOpen = true
    self.SceneInfo = {}

    self:InitSceneInfo()

    if self.minimapInfo == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("MiniMapMananger:SetMiniMap >> self.minimapInfo == nil")
        end
        return
    end
    if _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.MainView.Name) == nil then
        if _G.AppSetting.DEBUG then
            _G.LogWarning("Not MainView")
        end
        return
    end

    if _G.WorldManager:GetInstance():GetCurWorld() == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("CurrentWorld is nil")
        end
        return
    end

    if
        _G.ConfigManager.scene_cfg[_G.WorldManager:GetInstance():GetCurWorldSid()].MiniMapType ==
            _G.MiniMapType.NotMiniMap
     then
        return
    end

    --右上角小地图设置
    local minimap = self.minimapInfo.aorrawimage_MiniMap
    if minimap ~= nil then
        minimap:LoadImage(
            "UI/Test/ceshiditu",
            function()
                minimap:SetNativeSize()
                --获得当前地图的大小
                if self.mapRect ~= nil then
                    --缓存
                    self.MiniMapSizex, self.MiniMapSizey = self.mapRect:GetRectTransformSizeDelta()
                    --创建出角色小地图的图标
                    if self.SceneInfo ~= nil then
                        for i, v in pairs(self.SceneInfo) do
                            if v.Uid == self.PlayerUid then
                                if v.DataType == _G.WorldItemDataType.Player and self.RoleInfoLayer ~= nil then
                                    _G.PoolsManager:GetInstance():Spawn(
                                        IconPerfabPath,
                                        _G.ePoolType.UIItem,
                                        self.RoleInfoLayer,
                                        function(tran)
                                            self.IconTable[i] = tran
                                            --通过缓存池
                                            if self.IconTable[i]:GetComponentE(typeof(CS.AorImage)) ~= nil then
                                                self.IconTable[i]:GetComponentE(typeof(CS.AorImage)).SpriteName =
                                                    _G.ItemIcon.Player
                                            end
                                            self:OnUpdate()
                                        end
                                    )
                                end
                            end
                        end
                    end
                end
            end
        )
    end

    local NormalLayer = self.minimapInfo.aorrawimage_NormalInfoLayer
    if NormalLayer ~= nil then
        NormalLayer:LoadImage(
            "UI/Test/ceshiditu",
            function()
                NormalLayer:SetNativeSize()
                NormalLayer.Alpha = 0
            end
        )
    end

    local SceneLayer = self.minimapInfo.aorrawimage_SceneInfoLayer
    if SceneLayer ~= nil then
        SceneLayer:LoadImage(
            "UI/Test/ceshiditu",
            function()
                SceneLayer:SetNativeSize()
                SceneLayer.Alpha = 0
            end
        )
    end

    local RoleLayer = self.minimapInfo.aorrawimage_RoleInfoLayer
    if RoleLayer ~= nil then
        RoleLayer:LoadImage(
            "UI/Test/ceshiditu",
            function()
                RoleLayer:SetNativeSize()
                RoleLayer.Alpha = 0
            end
        )
    end

    local NPCLayer = self.minimapInfo.aorrawimage_NPCInfoLayer
    if NPCLayer ~= nil then
        NPCLayer:LoadImage(
            "UI/Test/ceshiditu",
            function()
                NPCLayer:SetNativeSize()
                NPCLayer.Alpha = 0
            end
        )
    end

    -- for _,v in pairs(self.SceneInfo) do
    --     if v.ItemType == _G.WorldItemType.NPC then
    --     end
    -- end
end

function MiniMapMananger:OnUpdate()
    --test 只对角色图标进行定位和控制
    if _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.MainView.Name) == nil then
        if _G.AppSetting.DEBUG then
            _G.LogWarning("Not MainView")
        end
        return
    end

    local ScenePos = _G.WorldManager:GetInstance():GetCurWorld().SceneObject.position
    if ScenePos ~= nil then
        for i, v in pairs(self.SceneInfo) do
            if self.IconTable[i] ~= nil and self.IconTable[i] ~= nil then
                local x, y, z = v.Transform:GetPosition()
                local posx = (x - (-28.01 + ScenePos.x)) * 10.5125523013
                local posy = 0
                local posz = (z - (-31.8 + ScenePos.z)) * 10.4878494427

                --通过缓存池
                local rect = self.IconTable[i]:GetComponentE(typeof(CS.UnityEngine.RectTransform))
                if rect ~= nil then
                    rect:SetAnchorPosition(posz, -posx)
                end
            end
        end
    end

    --小地图中心点
    local playerObj = self.SceneInfo[self.PlayerUid]
    if playerObj ~= nil then
        local x, y, z = playerObj.Transform:GetPosition()
        local rolePosx = (x - (-28.01 + ScenePos.x)) * 10.5125523013
        local rolePosy = 0
        local rolePosz = (z - (-31.8 + ScenePos.z)) * 10.4878494427

        --rolePos = _G.Vector3(rolePos.z, 0, rolePos.x)
        if rolePosz - self.MiniViewSizex * 0.5 < 0 then
            rolePosz = self.MiniViewSizex * 0.5
        elseif rolePosz > self.MiniMapSizex - self.MiniViewSizex * 0.5 then
            rolePosz = self.MiniMapSizex - self.MiniViewSizex * 0.5
        end

        if rolePosx - self.MiniViewSizey * 0.5 < 0 then
            rolePosx = self.MiniViewSizey * 0.5
        elseif rolePosx > self.MiniMapSizey - self.MiniViewSizey * 0.5 then
            rolePosx = self.MiniMapSizey - self.MiniViewSizey * 0.5
        end

        if
            self.minimapInfo.aorrawimage_MiniMap ~= nil and --缓存
                self.minimapInfo.aorrawimage_MiniMap:GetComponentE(typeof(CS.UnityEngine.RectTransform)) ~= nil
         then
            self.minimapInfo.aorrawimage_MiniMap:GetComponentE(typeof(CS.UnityEngine.RectTransform)):SetAnchorPosition(
                -rolePosz + self.MiniViewSizex * 0.5,
                rolePosx - self.MiniViewSizey * 0.5
            )
        end

        if self.minimapInfo.aortext_pos ~= nil then
            self.minimapInfo.aortext_pos.text =
                _G.tostring(
                "[" .. _G.tostring(_G.math.floor(rolePosx)) .. "-" .. _G.tostring(_G.math.floor(rolePosz)) .. "]"
            )
        end
    end
end

---初始化场景信息
function MiniMapMananger:InitSceneInfo()
    local world = _G.WorldManager:GetInstance():GetCurWorld()
    if world ~= nil then
        self.SceneInfo = world.AllWorldItems
    end
end

