---@class MainMiniMapView : UIBaseView	主城场景的小地图
---@field public go_table MainMiniMapView_GoTable GoTable
local MainMiniMapView = _G.BaseClass("MainMiniMapView", _G.UIBaseView)

function MainMiniMapView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MainMiniMapView:OnCreate()
end

---每次打开调用
function MainMiniMapView:OnEnable()
    self.UpdatePlane()
end

function MainMiniMapView:UpdatePlane()
end

function MainMiniMapView:OpenMiniMap()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainMiniMapView.Name)
end

function MainMiniMapView:CloseMiniMap()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainMiniMapView.Name)
end

---按钮点击事件在这里派发
function MainMiniMapView:OnClickBtn(go)
    local name = go:GetName()

    if _G.AppSetting.DEBUG then
        _G.Log("MainMiniMapView:OnClickBtn>>>" .. name)
    end
    if name == "@_aorbtn_MainMiniMapClose" then
        self.CloseMiniMap()
    end
end

return MainMiniMapView
