---设置一些属性
function SectionMiniMapManager:InnerCreate(tran)
    if tran == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("Path is error : " .. SectionPerfab)
        end
        return
    end
    self.Sections[self.CurRoomSectionSid] = _G.GetAutoGoTable(tran)
    local rectTrans = tran:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    local x, y = self.ShowRect:GetRectTransformSizeDelta()
    local x1, y1 = rectTrans:GetRectTransformSizeDelta()
    rectTrans:SetAnchorPosition(x * 0.5 - x1 * 0.5, -y * 0.5 + y1 * 0.5)
    x, y = rectTrans:GetAnchorPosition()
    self:SetSectionInfo(tran, {x = x, y = y}, self.CurRoomSectionSid)
    self.Sections[self.CurRoomSectionSid].rectTrans = rectTrans
    self.Sections[self.CurRoomSectionSid].obj_self:SetActiveE(1)
    local tmp = self.Sections[self.CurRoomSectionSid].aorimage_left:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    local tmp2 = self.Sections[self.CurRoomSectionSid].aorimage_top:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    self.LeftRightOff = tmp:GetRectTransformSizeDelta() * 0.4
    x, y = tmp2:GetRectTransformSizeDelta()
    self.UPDownOff = y * 0.4

    --递归创建所有的关卡
    self:CreateAllSection(_G.ConfigManager.main_room_cfg[self.CurRoomSectionSid])
end

--递归创建所有的关卡
function SectionMiniMapManager:CreateAllSection(RoomCfg)
    if RoomCfg == nil then
        return
    end
    local Section = self.Sections[RoomCfg.id]
    local Rect = Section.gameObject:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    local x, y = Rect:GetAnchorPosition()
    local CurPos = {x = x, y = y}
    local x, y = Rect:GetRectTransformSizeDelta()
    local CurView = {x = x, y = y}
    if RoomCfg.LeftRoom ~= 0 then
        Section.aorimage_left:SetActiveE(1)
        if self.Sections[RoomCfg.LeftRoom] == nil then
            self:SetSection(RoomCfg.LeftRoom, {x = CurPos.x - CurView.x + self.LeftRightOff, y = CurPos.y})
        end
    end
    if RoomCfg.RightRoom ~= 0 then
        Section.aorimage_right:SetActiveE(1)
        if self.Sections[RoomCfg.RightRoom] == nil then
            self:SetSection(RoomCfg.RightRoom, {x = CurPos.x + CurView.x - self.LeftRightOff, y = CurPos.y})
        end
    end
    if RoomCfg.UpRoom ~= 0 then
        Section.aorimage_top:SetActiveE(1)
        if self.Sections[RoomCfg.UpRoom] == nil then
            self:SetSection(RoomCfg.UpRoom, {x = CurPos.x, y = CurPos.y + CurView.y - self.UPDownOff})
        end
    end
    if RoomCfg.DownRoom ~= 0 then
        Section.aorimage_down:SetActiveE(1)
        if self.Sections[RoomCfg.DownRoom] == nil then
            self:SetSection(RoomCfg.DownRoom, {x = CurPos.x, y = CurPos.y - CurView.y + self.UPDownOff})
        end
    end
    self:UpdateInfo(_G.MainManager:GetInstance():GetCurPassRoomCount())
    self:OnUpdate()
end

---创建设置初始化关卡
function SectionMiniMapManager:SetSection(sid, pos)
    _G.PoolsManager:GetInstance():Spawn(
        SectionPerfab,
        _G.ePoolType.UIItem,
        self.content,
        function(tran)
            if tran then
                self:SetSectionInfo(tran, pos, sid)
                self:CreateAllSection(_G.ConfigManager.main_room_cfg[sid])
            end
        end
    )
end

function SectionMiniMapManager:SetSectionInfo(tran, pos, sid)
    local rectTrans = tran:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    rectTrans:SetAnchorPosition(pos.x, pos.y)
    local tb = _G.GetAutoGoTable(tran)
    local cfg = _G.ConfigManager.main_room_cfg[sid]
    if not table.isEmptyOrNil(cfg.Type2) then
        local info = {
            [1] = tb.aorimage_Info,
            [_G.MiniMapInfoType.npc] = tb.aorimage_Info1,
            [_G.MiniMapInfoType.event] = tb.aorimage_Info2,
            [_G.MiniMapInfoType.box] = tb.aorimage_Info3
        }
        for i, v in pairs(cfg.Type2) do
            if i == 1 then
                info[i]:SetActiveE(1)
                info[i].SpriteName = InfoIconName[v]
            else
                info[v]:SetActiveE(1)
                info[v].SpriteName = InfoIconName[v]
            end
            if v == 1 then
                tb.aorimage_room.SpriteName = "ui-dt-bg-boss"
            end
        end
    end
    self.Sections[sid] = tb
    self.Sections[sid].rectTrans = rectTrans
end

---场景交换的更新
function SectionMiniMapManager:OnUpdate()
    local world = _G.WorldManager:GetInstance():GetCurWorld()
    if world.Cfg.Scene_Type ~= _G.SceneType.Section or self.IsSection == false then
        return
    end
    self.CurRoomSid = _G.ChapterRoomManager:GetInstance():GetCurRoomID()
    if self.Sections[self.CurRoomSid] ~= nil then
        local x, y = self.Sections[self.CurRoomSid].rectTrans:GetAnchorPosition()
        local x1, y1 = self.Sections[self.CurRoomSid].rectTrans:GetRectTransformSizeDelta()
        local x2, y2 = self.content:GetRectTransformSizeDelta()
        local tmp = {x = x + x1 * 0.5 - x2 * 0.5, y = y - y1 * 0.5 + y2 * 0.5}
        self.content:SetAnchorPosition(-tmp.x, -tmp.y)
        self.contentbg:SetAnchorPosition(-tmp.x, -tmp.y)
    end
    for i, v in pairs(self.Sections) do
        if self.CurRoomSid == i then
            v.obj_self:SetActiveE(1)
            if self.CurRoomEff then
                self.CurRoomEff:SetActiveE(1)
                local x, y, z = v.transform:GetPosition()
                local x1, y1 = self.CurRoomEff:GetAnchorPosition()
                local x2, y2 = v.transform:GetRectTransformSizeDelta()
                self.CurRoomEff:SetPosition(x, y, z)
                self.CurRoomEff:SetAnchorPosition(x1 + x2 / 2, y1 - y2 / 2)
            end
            v.obj_Info:SetActiveE(0)
        else
            v.obj_self:SetActiveE(0)
            v.obj_Info:SetActiveE(1)
        end
    end
end

---更新小地图显示信息
function SectionMiniMapManager:UpdateInfo(PassRoomCount)
    if table.isEmptyOrNil(self.Sections) or self.IsSection == false then
        return
    end
    local cfg = _G.ConfigManager.main_room_cfg
    local info
    local states
    local ChapterRoomManager = _G.ChapterRoomManager:GetInstance()
    for i, v in pairs(self.Sections) do
        if not _G.IsNil(v) then
            if ChapterRoomManager:CheckEmptyRoomEnter(i) then
                info = {
                    [1] = v.aorimage_Info,
                    [_G.MiniMapInfoType.npc] = v.aorimage_Info1,
                    [_G.MiniMapInfoType.event] = v.aorimage_Info2,
                    [_G.MiniMapInfoType.box] = v.aorimage_Info3
                }
                states = ChapterRoomManager:GetRoomExploreState(i)
                for type, state in pairs(states) do
                    if state then
                        if cfg[i].Type2[1] == type then
                            info[1]:SetActiveE(1)
                            info[1].SpriteName = InfoIconName2[type]
                        else
                            info[type]:SetActiveE(1)
                            info[type].SpriteName = InfoIconName2[type]
                        end
                    end
                end
                if i == self.CurRoomSid then
                    v.aorimage_roombg:SetActiveE(1)
                    v.aorimage_roombg.SpriteName = "ui-dt-bg-di02"
                    v.aorimage_room.SpriteName = "ui-dt-bg-dangqian"
                else
                    v.aorimage_room.SpriteName = "ui-dt-bg-yida"
                    v.aorimage_roombg:SetActiveE(0)
                end
                if cfg[i].UpRoom ~= 0 and ChapterRoomManager:CheckRoomEnter(cfg[i].UpRoom) then
                    v.aorimage_top.SpriteName = "ui-dt-bg-yidatd"
                end
                if cfg[i].DownRoom ~= 0 and ChapterRoomManager:CheckRoomEnter(cfg[i].DownRoom) then
                    v.aorimage_down.SpriteName = "ui-dt-bg-yidatd"
                end
                if cfg[i].LeftRoom ~= 0 and ChapterRoomManager:CheckRoomEnter(cfg[i].LeftRoom) then
                    v.aorimage_left.SpriteName = "ui-dt-bg-yidatd"
                end
                if cfg[i].RightRoom ~= 0 and ChapterRoomManager:CheckRoomEnter(cfg[i].RightRoom) then
                    v.aorimage_right.SpriteName = "ui-dt-bg-yidatd"
                end
            end
        end
    end
end

