---设置参数
function SectionMiniMapManager:SetData(obj)
    if _G.IsNil(obj) then
        return
    end
    if self.IsSection ~= nil and self.IsSection then
        return
    end
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClick))
    self.SectionSid = require("ChapterModel"):GetInstance():GetChooseSectionID()
    self.SectionCfg = require("ChapterModel"):GetInstance():GetCurChooseSectionCfg()
    self.cfg = _G.ConfigManager.main_section_cfg[self.SectionSid]
    self.content = self.go_table.obj_content:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    self.contentbg = self.go_table.obj_bgcontent:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    self.Sections = {}
    self.Sectionsbg = {}
    self.CurRoomSid = self.cfg.rooms[1]
    self.CurRoomSectionSid = self.SectionCfg.rooms[1]
    self.ShowRect = self.go_table.obj_MiniMap:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    self.PassRoom = {}
    table.insert(self.PassRoom, self.CurRoomSid)

    --region

    --去除小地图波纹显示
    -- 镇魂街ZHJ-6369
    -- 【客户端】序章小地图信息显示异常

    -- self:CreateEff()

    --endregion
    self:CreateSection()
    self:CreateSectionBg()
end

---创建特效
function SectionMiniMapManager:CreateEff()
    if not self.CurRoomEff then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.MapEffect_04,
            self.content,
            function(tran)
                if tran then
                    self.CurRoomEff = tran:GetComponentE(typeof(_G.CS.UnityEngine.RectTransform))
                    tran:SetActiveE(0)
                end
            end
        )
    end
end

---设置是否在关卡内
function SectionMiniMapManager:SetIsSection(bl)
    self.IsSection = bl
end

--region ---创建关卡背景
--创建关卡背景图
function SectionMiniMapManager:CreateSectionBg()
    _G.PoolsManager:GetInstance():Spawn(
        SectionBgPrefab,
        _G.ePoolType.UIItem,
        self.go_table.obj_bgcontent,
        _G.handler(self, self.CreateBg)
    )
end
function SectionMiniMapManager:CreateBg(tran)
    if tran == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("Path is error : " .. SectionBgPrefab)
        end
        return
    end
    self.Sectionsbg[self.CurRoomSectionSid] = _G.GetAutoGoTable(tran)
    local rectTrans = tran:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    local x, y = self.ShowRect:GetRectTransformSizeDelta()
    local x1, y1 = rectTrans:GetRectTransformSizeDelta()
    rectTrans:SetAnchorPosition(x * 0.5 - x1 * 0.5, -y * 0.5 + y1 * 0.5)
    x, y = rectTrans:GetAnchorPosition()
    self:SetSectionBgPos(tran, {x = x, y = y})

    --递归创建所有的关卡背景
    self:CreateAllSectionBg(_G.ConfigManager.main_room_cfg[self.CurRoomSectionSid])
end
function SectionMiniMapManager:CreateAllSectionBg(RoomCfg)
    if RoomCfg == nil then
        return
    end
    if RoomCfg.LeftRoom ~= 0 then
        if self.Sections[RoomCfg.LeftRoom] ~= nil then
            if self.Sectionsbg[RoomCfg.LeftRoom] == nil then
                self:SetSectionBg(RoomCfg.LeftRoom, self:GetSectionPosition(RoomCfg.LeftRoom))
            end
        end
    end
    if RoomCfg.RightRoom ~= 0 then
        if self.Sections[RoomCfg.RightRoom] ~= nil then
            if self.Sectionsbg[RoomCfg.RightRoom] == nil then
                self:SetSectionBg(RoomCfg.RightRoom, self:GetSectionPosition(RoomCfg.RightRoom))
            end
        end
    end
    if RoomCfg.UpRoom ~= 0 then
        if self.Sections[RoomCfg.UpRoom] ~= nil then
            if self.Sectionsbg[RoomCfg.UpRoom] == nil then
                self:SetSectionBg(RoomCfg.UpRoom, self:GetSectionPosition(RoomCfg.UpRoom))
            end
        end
    end
    if RoomCfg.DownRoom ~= 0 then
        if self.Sections[RoomCfg.DownRoom] ~= nil then
            if self.Sectionsbg[RoomCfg.DownRoom] == nil then
                self:SetSectionBg(RoomCfg.DownRoom, self:GetSectionPosition(RoomCfg.DownRoom))
            end
        end
    end
end
--计算关卡位置
---@param sid number 房间sid
---@return pos table x,y位置
function SectionMiniMapManager:GetSectionPosition(sid)
    local Section = self.Sections[sid]
    local Rect = Section.gameObject:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    local x, y = Rect:GetAnchorPosition()
    return {x = x, y = y}
end
---创建设置初始化关卡背景
function SectionMiniMapManager:SetSectionBg(sid, pos)
    _G.PoolsManager:GetInstance():Spawn(
        SectionBgPrefab,
        _G.ePoolType.UIItem,
        self.go_table.obj_bgcontent,
        function(tran)
            if tran then
                self.Sectionsbg[sid] = _G.GetAutoGoTable(tran)
                self:SetSectionBgPos(tran, pos)
                self:CreateAllSectionBg(_G.ConfigManager.main_room_cfg[sid])
            end
        end
    )
end
function SectionMiniMapManager:SetSectionBgPos(tran, pos)
    local rectTrans = tran:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    rectTrans:SetAnchorPosition(pos.x, pos.y)
end
