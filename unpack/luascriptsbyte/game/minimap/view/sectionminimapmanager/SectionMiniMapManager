---清理
function SectionMiniMapManager:Clear()
    if self.Sections then
        for _, v in pairs(self.Sections) do
            _G.DestroyObject(v.gameObject)
        end
    end
    self.Sections = {}
    if self.content then
        self.content:SetAnchorPosition(0, 0)
    end

    if self.Sectionsbg then
        for _, v in pairs(self.Sectionsbg) do
            _G.DestroyObject(v.gameObject)
        end
    end
    self.Sectionsbg = {}
    if self.contentbg then
        self.contentbg:SetAnchorPosition(0, 0)
    end
end

---region 任务目标
---设置任务目标房间ID
---@param sid number main_room_cfg的id
function SectionMiniMapManager:SetTaskRoomID(sid)
    if not self.IsSection then
        return
    end
    self.CurTaskTarget = sid
    if sid == 0 then
        if self.TaskEff then
            _G.PoolsManager:GetInstance():Despawn(self.TaskEff, _G.ePoolType.UIItem)
            self.TaskEff = nil
        end
        if self.ArrowEff then
            _G.PoolsManager:GetInstance():Despawn(self.ArrowEff, _G.ePoolType.UIItem)
            self.ArrowEff = nil
        end
    else
        if self.Sections[sid] and sid ~= self.CurRoomSid then
            if not self.TaskEff then
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.MapEffect_03,
                    self.content,
                    function(tran)
                        if tran then
                            self.TaskEff = tran:GetComponentE(typeof(_G.CS.UnityEngine.RectTransform))
                            local x, y, z = self.Sections[sid]:GetPosition()
                            local x1, y1 = self.TaskEff:GetAnchorPosition()
                            local x2, y2 = self.Sections[sid]:GetRectTransformSizeDelta()
                            self.TaskEff:SetPosition(x, y, z)
                            self.TaskEff:SetAnchorPosition(x1 + x2 / 2, y1 - y2 / 2)
                        end
                    end,
                    function()
                        self.TaskEff = nil
                    end
                )
            end

            if not self.ArrowEff then
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.MapEffect_06,
                    self.go_table.obj_Eff2,
                    function(tran)
                        if tran then
                            self.ArrowEff = tran:GetComponentE(typeof(_G.CS.UnityEngine.RectTransform))
                        --self:ShowArrowEff()
                        end
                    end,
                    function()
                        self.ArrowEff = nil
                    end
                )
            end
        end
    end
end

---显示箭头提示
function SectionMiniMapManager:ShowArrowEff()
    if not self.ArrowEff or not self.Sections[self.CurTaskTarget] or not self.Sections[self.CurRoomSid] then
        return
    end
    local line = _G.CS.Medvedya.GeometryMath.Line
    local a1, a2, b1, b2, b3, b4
    local x, y, x1, y1
    ---房间坐标 + 自身size（+x,-y） + content坐标 = 房间中心在显示区域的坐标
    a1 = self.Sections[self.CurRoomSid]
    x, y = a1:GetAnchorPosition()
    x1, y1 = a1:GetRectTransformSizeDelta()
    a1 = {x = x + x1 * 0.5, y = y - y1 * 0.5}
    x, y = self.content:GetAnchorPosition()
    a1 = {x = a1.x + x, y = a1.y + y}
    a2 = (self.Sections[self.CurTaskTarget])
    x, y = a2:GetAnchorPosition()
    x1, y1 = a2:GetRectTransformSizeDelta()
    a2 = {x = x + x1 * 0.5, y = y - y1 * 0.5}
    x, y = self.content:GetAnchorPosition()
    a2 = {x = a2.x + x, y = a2.y + y}
    ---以左上角为0,0点记录四个角的坐标
    x, y = self.ShowRect:GetRectTransformSizeDelta()

    b1 = {x = 0, y = 0} ---左上
    b2 = {x = x, y = 0} ---右上
    b3 = {x = x, y = -y} ---右下
    b4 = {x = 0, y = -y} ---左下
    local pointx, pointy
    local bl = false
    ---判断是否有交点
    bl, pointx, pointy = line.intersection(a1.x, a1.y, a2.x, a2.y, b1.x, b1.y, b2.x, b2.y)
    if not bl then
        bl, pointx, pointy = line.intersection(a1.x, a1.y, a2.x, a2.y, b2.x, b2.y, b3.x, b3.y)
        if not bl then
            bl, pointx, pointy = line.intersection(a1.x, a1.y, a2.x, a2.y, b3.x, b3.y, b4.x, b4.y)
            if not bl then
                bl, pointx, pointy = line.intersection(a1.x, a1.y, a2.x, a2.y, b4.x, b4.y, b1.x, b1.y)
            end
        end
    end

    if bl then
        self.ArrowEff:SetActiveE(1)
        self.ArrowEff:SetAnchorPosition(pointx - x / 2, pointy + y / 2)

        local euler = _G.math.atan((pointy + y / 2) / (pointx - x / 2)) / _G.math.pi * 180
        if pointx - a1.x >= 0 then
            euler = euler + 90
        else
            euler = euler - 90
        end
        self.ArrowEff:SetLocalEulerAngles(0, 0, euler)
    else
        self.ArrowEff:SetActiveE(0)
    end
end

