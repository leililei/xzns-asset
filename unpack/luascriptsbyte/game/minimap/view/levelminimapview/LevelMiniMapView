local typeof = _G.typeof
local GetLangPackValue = _G.GetLangPackValue
local singRoomPath = "UI/MainView/@_obj_SingleRoom"
local TrophyIconPath = "UI/MainView/$_obj_TrophyIconPre"
local MonsterIconPath = "UI/MainView/$_obj_MonsterIconPre"
