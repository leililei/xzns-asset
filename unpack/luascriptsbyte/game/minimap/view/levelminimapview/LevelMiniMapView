    Box = 2,
    NPC = 3,
    Battle = 4,
    Boss = 5
}

local TestTaskZoom = {3, 8}
---按钮点击事件在这里派发
function LevelMiniMapView:OnClickBtn(go)
    local name = go:GetName()

    if _G.table:isEmptyOrNil(self.go_table) then
        return
    end

    if _G.AppSetting.DEBUG then
        _G.Log("LevelMiniMapView:OnClickBtn>>>" .. name)
    end
    if name == "@_aorbtn_CloseViewBtn" then
        self:CloseMiniMap()
    elseif name == "@_aorbtn_CloseMonsterBtn" and self.go_table.aorimage_testMonsterInfoView ~= nil then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_testMonsterInfoView, false)
    elseif name == "@_aorbtn_CloseItemBtn" and self.go_table.aorimage_testItemInfoView ~= nil then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_testItemInfoView, false)
    end
end

--每次打开界面
function LevelMiniMapView:OnEnable()
    self:HideMainView()
    self:UpdateLeftPlane()
    self:UpdateRightPlane()
end

function LevelMiniMapView:HideMainView()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
end
function LevelMiniMapView:ShowMainView()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
end

---创建view
function LevelMiniMapView:OnCreate()
    self.task = {
        task1 = false,
        task2 = false,
        task3 = false
    }
    self.SceneInfo = nil
    self.monsterList = {}
    self.propList = {}
    self.MiniMapTable = {}
    self.IsFirst = true
    self.LeftContentSize = {}
    self.RectTable = {}
    self.role = nil
    self.CurZoomID = _G.ChapterRoomManager:GetInstance():GetCurRoomID()
    self.CurSecCfg = require("ChapterModel"):GetInstance():GetCurChooseSectionCfg()
    self.CurSectionF = _G.ConfigManager.main_section_cfg[self.CurSecCfg.id].rooms[1][1]
    self.SingleTable = {}

    for i = 1, 25 do
        table.insert(self.monsterList, _G.PlayerModel:GetInstance().role_name)
        table.insert(self.propList, _G.PlayerModel:GetInstance().role_name)
    end

    table.sort(
        self.monsterList,
        function(a, b)
            return a < b
        end
    )
    table.sort(
        self.propList,
        function(a, b)
            return a < b
        end
    )

    if _G.table:isEmptyOrNil(self.go_table) or self.go_table.obj_leftPlane == nil or self.go_table.obj_rightPlane == nil then
        return
    end
    self.leftPlane = _G.GetAutoGoTable(self.go_table.obj_leftPlane)
    self.rightPlane = _G.GetAutoGoTable(self.go_table.obj_rightPlane)
    self.role = self.leftPlane.obj_RoleIcon:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    if self.leftPlane.aorimage_left ~= nil then
        local x, y =
            self.leftPlane.aorimage_left:GetComponentE(typeof(CS.UnityEngine.RectTransform)):GetRectTransformSizeDelta()
        self.LeftRightOff = x
    end

    if self.leftPlane.aorimage_top ~= nil then
        local x, y =
            self.leftPlane.aorimage_top:GetComponentE(typeof(CS.UnityEngine.RectTransform)):GetRectTransformSizeDelta()
        self.UPDownOff = y
    end
    self:HideMainView()
    self:CreateMapPlane()
    self:SetTask()

    if _G.AppSetting.DEBUG then
        _G.Log(self.obj_rightPlane.aorlooplist_EnemyIcon)
    end

    --创建Right面板
    self:SetEnemyAndProp()

    --改变现实方式
    -- if self.rightPlane.aorlooplist_EnemyIcon ~= nil then
    --     self.rightPlane.aorlooplist_EnemyIcon:StartUpdataDragInfo(#self.monsterList, _G.handler(self, self.SetEnemy))
    -- end
    -- if self.rightPlane.aorlooplist_TrophyIcon ~= nil then
    --     self.rightPlane.aorlooplist_TrophyIcon:StartUpdataDragInfo(#self.propList, _G.handler(self, self.SetProp))
    -- end
end

--创建小地图
function LevelMiniMapView:CreateMapPlane()
    if self.leftPlane and self.leftPlane.obj_content == nil then
        return
    end
    _G.PoolsManager:GetInstance():Spawn(
        singRoomPath,
        _G.ePoolType.UIItem,
        self.leftPlane.obj_Room,
        _G.handler(self, self.InnerCreate)
    )
end

--创建小地图回调函数
function LevelMiniMapView:InnerCreate(trans)
    if trans == nil then
        return
    end

    if self.leftPlane and self.leftPlane.obj_content == nil then
        return
    end
    --必须每次创建时获取
    local rect = self.leftPlane.obj_content:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    if rect == nil then
        return
    end

    local x, y = rect:GetAnchorPosition()
    self.LeftContentSize:SetAnchorPosition(x, y)
    local rx, ry = rect:GetRectTransformSizeDelta()
    self.LeftContentSize:SetRectTransformSize(rx, ry)

    self.MiniMapTable[self.CurSectionF] = trans
    _G.GameUtil.SetActiveByCondition(trans, true)
    self.SingleTable[self.CurSectionF] = _G.GetAutoGoTable(trans)

    self.RectTable[(self.CurSectionF)] = trans:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    if self.RectTable[(self.CurSectionF)] ~= nil then
        local rtfx, rtfy = self.LeftContentSize:GetRectTransformSizeDelta()
        local rtfsx, rtfsy = self.RectTable[(self.CurSectionF)]:GetRectTransformSizeDelta()
        self.RectTable[(self.CurSectionF)]:SetAnchorPosition(rtfx * 0.5 - rtfsx * 0.5, -rtfy * 0.5 + rtfsy * 0.5)

        --递归test数据
        self:MiniMapCount(_G.ConfigManager.main_room_cfg[self.CurSectionF])

        --结束后设置大小
        local x, y = self.RectTable[self.CurSectionF]:GetAnchorPosition()
        local maxX = x
        local maxY = y
        local miniX = x
        local miniY = y
        for _, v in pairs(self.RectTable) do
            if v ~= nil then
                local curPosx, curPosy = v:GetAnchorPosition()
                if curPosx > maxX then
                    maxX = curPosx
                end
                if curPosy > maxY then
                    maxY = curPosy
                end
                if curPosx < miniX then
                    miniX = curPosx
                end
                if curPosy < miniY then
                    miniY = curPosy
                end
            end
        end
        --以上定下content宽高
        --更改后大小记录下来
        local singleRoomx, singleRoomy = self.RectTable[(self.CurSectionF)]:GetRectTransformSizeDelta()
        local ContRect = self.leftPlane.obj_content:GetComponentE(typeof(CS.UnityEngine.RectTransform))
        if ContRect ~= nil then
            local x, y = self.LeftContentSize:GetRectTransformSizeDelta()
            self.content = ContRect
            self.content:SetRectTransformSize(
                maxX - miniX + singleRoomx + x * 0.5,
                maxY - miniY + singleRoomy + y * 0.5
            )
        end
        --修正地图与content相对位置
        local offPos = _G.Vector2(miniX - x, maxY - y)
        for _, v in pairs(self.RectTable) do
            local x, y = v:GetAnchorPosition()
            v:SetAnchorPosition(x - offPos.x, y - offPos.y)
        end

        if self.leftPlane.aortext_title ~= nil then
            self.leftPlane.aortext_title.text =
                _G.ConfigManager.scene_cfg[_G.WorldManager:GetInstance():GetCurWorldSid()].Name
        end
    end

    self:UpdateLeftPlane()
end

--递归创建
function LevelMiniMapView:MiniMapCount(scene)
    if scene == nil then
        return
    end

    local Info = self.MiniMapTable[scene.id]
    if Info == nil then
        return
    end

    local Rect = Info:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    if Rect == nil then
        return
    end
    local CurPosx, CurPosy = Rect:GetAnchorPosition()
    local CurViewx, CurViewy = Rect:GetRectTransformSizeDelta()

    if scene.LeftRoom ~= 0 and self.MiniMapTable[scene.LeftRoom] == nil then
        _G.PoolsManager:GetInstance():Spawn(
            singRoomPath,
            _G.ePoolType.UIItem,
            self.leftPlane.obj_Room,
            function(trans)
                if trans ~= nil then
                    self.MiniMapTable[scene.LeftRoom] = trans
                    _G.GameUtil.SetActiveByCondition(trans, true)
                end

                self.RectTable[(scene.LeftRoom)] = trans:GetComponentE(typeof(CS.UnityEngine.RectTransform))
                if self.RectTable[(scene.LeftRoom)] == nil then
                    return
                end
                self.RectTable[(scene.LeftRoom)]:SetAnchorPosition(CurPosx - CurViewx + self.LeftRightOff, CurPosy)

                self.SingleTable[scene.LeftRoom] = _G.GetAutoGoTable(trans)
                if self.SingleTable[scene.LeftRoom] ~= nil and self.SingleTable[scene.LeftRoom].aorimage_right ~= nil then
                    _G.GameUtil.SetActiveByCondition(self.SingleTable[scene.LeftRoom].aorimage_right, true)
                end
                --递归test数据
                self:MiniMapCount(_G.ConfigManager.main_room_cfg[scene.LeftRoom])
            end
        )
    end
    if scene.RightRoom ~= 0 and self.MiniMapTable[scene.RightRoom] == nil then
        _G.PoolsManager:GetInstance():Spawn(
            singRoomPath,
            _G.ePoolType.UIItem,
            self.leftPlane.obj_Room,
            function(trans)
                if trans ~= nil then
                    self.MiniMapTable[scene.RightRoom] = trans
                    _G.GameUtil.SetActiveByCondition(trans, true)
                end

                self.RectTable[(scene.RightRoom)] = trans:GetComponentE(typeof(CS.UnityEngine.RectTransform))
                if self.RectTable[(scene.RightRoom)] == nil then
                    return
                end
                self.RectTable[(scene.RightRoom)]:SetAnchorPosition(CurPosx + CurViewx - self.LeftRightOff, CurPosy)

                self.SingleTable[scene.RightRoom] = _G.GetAutoGoTable(trans)
                if self.SingleTable[scene.RightRoom] ~= nil and self.SingleTable[scene.RightRoom].aorimage_left ~= nil then
                    _G.GameUtil.SetActiveByCondition(self.SingleTable[scene.RightRoom].aorimage_left, true)
                end
                --递归test数据
                self:MiniMapCount(_G.ConfigManager.main_room_cfg[scene.RightRoom])
            end
        )
    end
    if scene.UpRoom ~= 0 and self.MiniMapTable[scene.UpRoom] == nil then
        _G.PoolsManager:GetInstance():Spawn(
            singRoomPath,
            _G.ePoolType.UIItem,
            self.leftPlane.obj_Room,
            function(trans)
                if trans ~= nil then
                    self.MiniMapTable[scene.UpRoom] = trans
                    _G.GameUtil.SetActiveByCondition(trans, true)
                end

                self.RectTable[(scene.UpRoom)] = trans:GetComponentE(typeof(CS.UnityEngine.RectTransform))
                if self.RectTable[(scene.UpRoom)] == nil then
                    return
                end
                self.RectTable[(scene.UpRoom)]:SetAnchorPosition(CurPosx, CurPosy + CurViewy - self.UPDownOff)

                self.SingleTable[scene.UpRoom] = _G.GetAutoGoTable(trans)
                if self.SingleTable[scene.UpRoom] ~= nil and self.SingleTable[scene.UpRoom].aorimage_down ~= nil then
                    _G.GameUtil.SetActiveByCondition(self.SingleTable[scene.UpRoom].aorimage_down, true)
                end
                --递归test数据
                self:MiniMapCount(_G.ConfigManager.main_room_cfg[scene.UpRoom])
            end
        )
    end
    if scene.DownRoom ~= 0 and self.MiniMapTable[scene.DownRoom] == nil then
        _G.PoolsManager:GetInstance():Spawn(
            singRoomPath,
            _G.ePoolType.UIItem,
            self.leftPlane.obj_Room,
            function(trans)
                if trans ~= nil then
                    self.MiniMapTable[scene.DownRoom] = trans
                    _G.GameUtil.SetActiveByCondition(trans, true)
                end

                self.RectTable[(scene.DownRoom)] = trans:GetComponentE(typeof(CS.UnityEngine.RectTransform))
                if self.RectTable[(scene.DownRoom)] == nil then
                    return
                end
                self.RectTable[(scene.DownRoom)]:SetAnchorPosition(CurPosx, CurPosy - CurViewy + self.UPDownOff)

                self.SingleTable[scene.DownRoom] = _G.GetAutoGoTable(trans)
                if self.SingleTable[scene.DownRoom] ~= nil and self.SingleTable[scene.DownRoom].aorimage_top ~= nil then
                    _G.GameUtil.SetActiveByCondition(self.SingleTable[scene.DownRoom].aorimage_top, true)
                end

                --递归test数据
                self:MiniMapCount(_G.ConfigManager.main_room_cfg[scene.DownRoom])
            end
        )
    end
end

--更新左边的面板
function LevelMiniMapView:UpdateLeftPlane()
    if self.leftPlane == nil or _G.table:isEmptyOrNil(self.MiniMapTable) then
        return
    end
    self:MiniMapCenter()
    self:MiniMapIconInfo()
    self:ShowTaskTips()
end

function LevelMiniMapView:ShowTaskTips()
    --获取任务数据
    self:GetTaskZoom()
    --这里用自定的数据做测试
    for _, v in pairs(TestTaskZoom) do
        if self.MiniMapTable[v] ~= nil then
            _G.GameUtil.SetActiveByCondition(self.SingleTable[v].obj_task, true)
        end
    end
end

function LevelMiniMapView:GetTaskZoom()
    --本应该获取从任务获取关卡ID，暂无
    self.TaskZoomID = nil
end

--让小地图居中显示
function LevelMiniMapView:MiniMapCenter()
    if self.leftPlane.aortext_title ~= nil then
        self.CurZoomID = _G.ChapterRoomManager:GetInstance():GetCurRoomID()
        self.leftPlane.aortext_title.text = _G.ChapterRoomManager:GetInstance():GetCurRoomCfg().Name
        if self.MiniMapTable[self.CurZoomID] ~= nil then
            local x, y = self.MiniMapTable[self.CurZoomID]:GetAnchorPosition()
            local mrtfx, mrtfy = self.MiniMapTable[self.CurZoomID]:GetRectTransformSizeDelta()
            local lrtfx, lrtfy = self.LeftContentSize:GetRectTransformSizeDelta()
            local tmpx, tmpy = _G.Vector2(x + mrtfx * 0.5 - lrtfx * 0.5, y - mrtfy * 0.5 + lrtfy * 0.5)
            self.content:SetAnchorPosition(-tmpx, -tmpy)
        end
    end
end

--设置房间信息
function LevelMiniMapView:MiniMapIconInfo()
    for i, v in pairs(self.MiniMapTable) do
        if v ~= nil then
            if _G.ConfigManager.main_room_cfg[i].SectionType ~= SectionType.None then
                self.SingleTable[i].aorimage_Info.SpriteName =
                    InfoIconNmae[_G.ConfigManager.main_room_cfg[i].SectionType]
                _G.GameUtil.SetActiveByCondition(self.SingleTable[i].aorimage_Info, true)
            end
            _G.GameUtil.SetActiveByCondition(self.SingleTable[i].obj_Role, false)
            if self.CurZoomID == i then
                local x, y =
                    self.SingleTable[i].obj_Role:GetComponentE(typeof(CS.UnityEngine.RectTransform)):GetAnchorPosition()
                local ax, ay = self.RectTable[i]:GetAnchorPosition()
                self.role:SetAnchorPosition(x + ax, y + ay)
            end
            --测试数据
            _G.GameUtil.SetActiveByCondition(self.SingleTable[i].obj_task, false)
        end
    end
end

--更新右边的面板
function LevelMiniMapView:UpdateRightPlane()
    self:UpdateTask()
end

---设置任务  test
function LevelMiniMapView:SetTask()
    if self.rightPlane == nil then
        return
    end
    if self.rightPlane.aortext_taskname1 ~= nil then
        if self.rightPlane.aorimage_starLight1 ~= nil then
            self.rightPlane.aortext_taskname1.text = GetLangPackValue(90022500417)
            _G.GameUtil.SetActiveByCondition(self.rightPlane.aorimage_starLight1, self.task.task1)
        end
    end

    if self.rightPlane.aortext_taskname2 ~= nil then
        if self.rightPlane.aorimage_starLight2 ~= nil then
            self.rightPlane.aortext_taskname2.text = GetLangPackValue(90022500418)
            _G.GameUtil.SetActiveByCondition(self.rightPlane.aorimage_starLight2, self.task.task2)
        end
    end
    if self.rightPlane.aortext_taskname3 ~= nil then
        if self.rightPlane.aorimage_starLight3 ~= nil then
            self.rightPlane.aortext_taskname3.text = GetLangPackValue(90022500419)
            _G.GameUtil.SetActiveByCondition(self.rightPlane.aorimage_starLight3, self.task.task3)
        end
    end
end

--初始化设置敌人
function LevelMiniMapView:SetEnemyAndProp()
    self.RightMCont = nil
    if self.monsterList == nil then
        return
    end
    self.RightMCont = nil
    if self.rightPlane.obj_EnemyContent ~= nil then
        self.RightMCont = self.rightPlane.obj_EnemyContent:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    end

    self.RightDCont = nil
    if self.rightPlane.obj_TrophyContent ~= nil then
        self.RightDCont = self.rightPlane.obj_TrophyContent:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    end

    if self.RightMCont == nil and self.RightDCont == nil then
        return
    end
    if self.monsterList == nil and self.propList == nil then
        return
    end

    for _, _ in pairs(self.monsterList) do
        _G.PoolsManager:GetInstance():Spawn(
            MonsterIconPath,
            _G.ePoolType.UIItem,
            self.RightMCont,
            function(trans)
                if trans == nil then
                    return
                end
                _G.AddViewBtnClick(trans, _G.handler(self, self.OnClickMonsterBtn))
                --留空，通过monsterID调用monsterList信息再传入
                self:SetMonsterContent(trans)
            end
        )
    end

    for _, _ in pairs(self.propList) do
        _G.PoolsManager:GetInstance():Spawn(
            TrophyIconPath,
            _G.ePoolType.UIItem,
            self.RightDCont,
            function(trans)
                if trans == nil then
                    return
                end
                _G.AddViewBtnClick(trans, _G.handler(self, self.OnClickPropBtn))
                --留空，通过Prop调用propList信息再传入
                self:SetTrophyContent(trans)
            end
        )
    end
end
function LevelMiniMapView:SetTrophyContent(trans)
    self.propIconSize = trans
    local grid = self.RightDCont:GetComponentE(typeof(CS.UnityEngine.UI.GridLayoutGroup))
    if grid == nil then
        return
    end
    local x, y = self.RightDCont:GetRectTransformSizeDelta()
    local tx, ty = trans:GetRectTransformSizeDelta()
    self.RightDCont:SetRectTransformSize(
        x,
        (_G.math.ceil(#self.propList / grid.constraintCount) * (ty + grid.spacing.y))
    )
end

function LevelMiniMapView:SetMonsterContent(trans)
    self.monsterIconSize = trans
    local grid = self.RightMCont:GetComponentE(typeof(CS.UnityEngine.UI.GridLayoutGroup))
    if grid == nil then
        return
    end
    local x, y = self.RightMCont:GetRectTransformSizeDelta()
    local tx, ty = trans:GetRectTransformSizeDelta()
    self.RightMCont:SetRectTransformSize(#self.monsterList * (tx + grid.spacing.x), y)
end

