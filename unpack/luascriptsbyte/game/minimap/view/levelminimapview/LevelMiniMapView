---更新任务 用于任务达成显示更新
function LevelMiniMapView:UpdateTask()
    if self.rightPlane == nil then
        return
    end

    --测试用
    self.task.task1 = true
    self.task.task2 = true
    if self.task.task1 and self.rightPlane.aorimage_starLight1 ~= nil then
        _G.GameUtil.SetActiveByCondition(self.rightPlane.aorimage_starLight1, true)
    end
    if self.task.task2 and self.rightPlane.aorimage_starLight2 ~= nil then
        _G.GameUtil.SetActiveByCondition(self.rightPlane.aorimage_starLight2, true)
    end
    if self.task.task3 and self.rightPlane.aorimage_starLight3 ~= nil then
        _G.GameUtil.SetActiveByCondition(self.rightPlane.aorimage_starLight3, true)
    end
end

function LevelMiniMapView:CloseMiniMap()
    self:ShowMainView()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.LevelMiniMapView.Name)
end

function LevelMiniMapView:OpenMiniMap()
    self:HideMainView()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.LevelMiniMapView.Name)
end

return LevelMiniMapView
