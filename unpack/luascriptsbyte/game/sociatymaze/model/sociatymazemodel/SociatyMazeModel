---@class SociatyMazeModel : Singleton	中文描述
local SociatyMazeModel = _G.BaseClass("SociatyMazeModel", _G.GameDataModelBase)

---@return SociatyMazeModel SociatyMazeModel
function SociatyMazeModel:GetInstance()
    return self.super.GetInstance(self)
end

local ScoreOptationList = {
    _G.GetLangPackValue(90032700008),
    _G.GetLangPackValue(90032700009),
    _G.GetLangPackValue(90032700010),
    _G.GetLangPackValue(90032700011)
}

---创建对象时,入口构造函数
function SociatyMazeModel:__init()
    self.curFunctionOpenID = 278
    _G.Events:GetInstance():AddListener(_G.eSociatyEvent.MasterBuildLevelChange, self.CheckFunctionOpen, self)
    _G.Events:GetInstance():AddListener(_G.eSociatyEvent.BeKicked, self.OnBeKicked, self)
end

function SociatyMazeModel:OnBeKicked(uid)
    if uid == _G.PlayerModel:GetInstance().role_uid then
        require("SociatyMazeBattleModel"):GetInstance():OnBeKicked()
    end
end

---活动结算
function SociatyMazeModel:SociatyMazeSettle(msg)
    if msg.ack ~= 1 then
        return
    end
    self.roleInfo = nil
    self.exploredPoint = {}
    self.startTime = 0
    self.endTime = 0
    self.stage = 1
    self.mvpRole = {}
    require("SociatyMazeBattleModel"):GetInstance():OnBeKicked()
    _G.Events:GetInstance():Broadcast(_G.eSociatyMaze.SociatyMazeSettle)
end

---达到公会等级拉取一次数据
function SociatyMazeModel:CheckFunctionOpen(curLevel)
    local level = _G.ConfigManager.discrete_cfg[116111][1][1]
    if curLevel >= level then
        self:GetInfo()
    end
end

function SociatyMazeModel:ReConnect(endcall)
    self:InitData(endcall)
end

function SociatyMazeModel:GetDataFormServer()
    self:GetInfo(_G.handler(self, self.ParseData))
end

---解析数据
---@param msg guild_maze.s2c_guild_maze_info
---@field roleInfo guild_maze.i_role_maze_info 玩家自己的数据
---@field exploredPoint table 已探索点位
---@field startTime number 活动开始时间
---@field guardian_boss table 守护boss技能k:点uid,v:技能sid
function SociatyMazeModel:ParseData(msg)
    if msg.ack ~= 1 then
        return
    end
    self.roleInfo = msg.role_info or {}
    self.roleInfo.mementos = self.roleInfo.mementos or {}
    self.roleInfo.put_mementos = self.roleInfo.put_mementos or {0, 0, 0, 0, 0}
    for i = 1, 5 do 
        self.roleInfo.put_mementos[i] = self.roleInfo.put_mementos[i] ~= 0 and self.roleInfo.put_mementos[i] or 0
    end
    self.roleInfo.special_battle = self.roleInfo.special_battle or {}
    self.exploredPoint = msg.explored_points or {}
    self.startTime = msg.start_time or 0
    self.endTime = msg.end_time or 0
    self.stage = msg.stage or 1
    self.mvpRole = msg.mvp_role
    self.guardianBoss = msg.guardian_boss
    self.win_point = msg.win_point
    self.pass_time = msg.pass_time
    require("SociatyMazeBattleModel"):GetInstance():ParseRoleInfo(self.roleInfo, msg.pass_time and msg.pass_time > 0)
    _G.Events:GetInstance():Broadcast(_G.eSociatyMaze.SociatyMazeInfo)
    if _G.PlayerPrefsManager.GetInt("SociatyMazeFace") ~= self.startTime and not self.hasAddFace then
        self.hasAddFace = true
        local MainOpenViewFunItem = {}
        MainOpenViewFunItem.OpenViewFun = function()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMazeFaceView.Name, true)
        end
        _G.MainManager:GetInstance():AddMainFunQueue(MainOpenViewFunItem, _G.MainViewShowOrder.SociatyMaze)
    end
    self.super.ParseData(self)
end

---检测是否在结算期
function SociatyMazeModel:CheckIsSettle()
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    local settle = _G.ConfigManager.discrete_cfg[116112][1][1]
    if serverTime >= self.endTime and serverTime < self.endTime + settle then
        return true
    end
    return false
end

function SociatyMazeModel:GetGuardianBoss()
    return self.guardianBoss
end

function SociatyMazeModel:GetWinPoint()
    return self.win_point
end

function SociatyMazeModel:GetPassTime()
    return self.pass_time or 0
end

function SociatyMazeModel:GetMvpRole()
    return self.mvpRole
end

function SociatyMazeModel:SetMvpData(data)
    self.mvpRole = data
    _G.Events:GetInstance():Broadcast(_G.eSociatyMaze.SociatyMazeMvp)
end

---获取阶段加成
function SociatyMazeModel:GetStageBonus(stage)
    if not stage then
        stage = self.stage 
    end
    local config = _G.ConfigManager.discrete_cfg[116106]
    for _, v in pairs(config) do
        if v[1] == stage then
           return (100 + v[2]) / 100
        end
    end

    return 1
end

---获取功能的时间
function SociatyMazeModel:GetTime()
    return self.startTime, self.endTime
end

---获取基础信息
function SociatyMazeModel:GetInfo()
    if _G.PlayerModel:GetInstance().main_open_time == 0 then
        ---未分配赛区
        self.super.ParseData(self)
        return
    end
    if not require("SociatyManager"):GetInstance():HasSociaty() then
        ---未加入公会
        self.super.ParseData(self)
        return
    end
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.curFunctionOpenID) then
        self.super.ParseData(self)
        return
    end
    local level = _G.ConfigManager.discrete_cfg[116111][1][1]
    if not _G.GlobalConditionManager.CheckCondition(_G.GlobalConditionManager.ConditionType.guildLv, level) then
        ---判断公会等级是否满足
        self.super.ParseData(self)
        return
    end
    require("SociatyMazeNet"):GetInstance():GetInfo(_G.handler(self, self.ParseData))
end

---获取对应点位的战斗信息
---@param uid number 点位uid
---@param callback function 回调方法
function SociatyMazeModel:GetBattleRecord(uid,callback)
    local pbdata = {uid = uid}
    require("SociatyMazeNet"):GetInstance():GetBattleRecord(pbdata,callback)
end

---获取体力标图
function SociatyMazeModel:GetRestoreIcon()
    return "ui_icon_stamina"
end

---检查遗物装备没有
function SociatyMazeModel:CheckRelicEquip(id)
    for k, v in ipairs(self.roleInfo.put_mementos) do 
        if id == v then 
            return 1
        end
    end
    return 0
end

function SociatyMazeModel:GetMazeLog(call)
    require("SociatyMazeNet"):GetInstance():GetLogList(
        function(data)
            self.logData = data.logs or {}
            _G.table.sort(self.logData, function(a, b)
                return a.value2 > b.value2
            end)
            self.logNum = #self.logData
            if call then
                call(self.logData)
            end
        end
    )
end

function SociatyMazeModel:GetSingleLog(index)
    if self.logData then
        return self.logData[index]
    end
    return nil
end

function SociatyMazeModel:ParseLogStr(data)
    local str
    local lan = _G.ConfigManager.guild_gve_report_cfg[data.type].language[1]
    local cardConfig = nil
    if data.value6 then
        cardConfig = require("SociatyMazeBattleModel"):GetInstance():GetCardCfg(nil, data.value6)
    end
    if data.type == 5 or data.type == 7 then
        if cardConfig then
            local bossName = _G.GetLangPackValue(cardConfig.Name)
            if data.type == 5 then
                str = _G.GetLangPackValue(lan, _G.GetLangPackValue(_G.ConfigManager.guild_gve_cfg[data.value3].name, bossName))
            else
                str = _G.GetLangPackValue(lan, _G.GetLangPackValue(_G.ConfigManager.guild_gve_cfg[data.value3].name, bossName))
            end
        else
            str = _G.GetLangPackValue(lan)
        end
    elseif data.type == 6 then
        local bossName = cardConfig and _G.GetLangPackValue(cardConfig.Name) or ""
        str = _G.GetLangPackValue(lan, _G.GetLangPackValue(_G.ConfigManager.guild_gve_cfg[data.value3].name, bossName), data.value1)
    elseif data.type == 8 then
        local bossName = ""
        if data.value3 == 107 or data.value3 == 108 then
            local name = cardConfig and _G.GetLangPackValue(cardConfig.Name) or ""
            bossName = _G.GetLangPackValue(_G.ConfigManager.guild_gve_cfg[data.value3].name, name)
        else
            bossName = _G.GetLangPackValue(_G.ConfigManager.guild_gve_cfg[data.value3].name)
        end
        str = _G.GetLangPackValue(lan, data.value1, ScoreOptationList[data.value4], bossName)
    elseif data.type == 9 then
        local bossName = cardConfig and _G.GetLangPackValue(cardConfig.Name) or ""
        str = _G.GetLangPackValue(lan, _G.GetLangPackValue(_G.ConfigManager.guild_gve_cfg[data.value3].name, bossName), data.value1)
    else
        str = _G.GetLangPackValue(lan, data.value1)
    end
    return str
end

---销毁对象时,析构函数
function SociatyMazeModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eSociatyEvent.MasterBuildLevelChange, self.CheckFunctionOpen, self)
    _G.Events:GetInstance():RemoveListener(_G.eSociatyEvent.BeKicked, self.OnBeKicked, self)
end

return SociatyMazeModel
