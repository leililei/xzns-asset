end

---修改地图数据
---@field uid number 格子uid
function SociatyMazeBattleModel:SetMapData(uid, field, data)
    if self.mapData[uid] then
        self.mapData[uid][field] = data
    end
end

---检查地图单元格是否已通关
---@param uid number
---@return boolean,boolean  (是否通关, 是否存在单元格实例)
function SociatyMazeBattleModel:CheckMapDataPass(uid)
    local d = self.mapData and self.mapData[uid]
    if not d then
        return false, false
    end
    --检查单元格是否已通关
    if d.status == 2 then
        return true, true
    end
    return false, true
end

---获取体力
function SociatyMazeBattleModel:GetRestore()
    return self.restore or 0
end

---修改体力
function SociatyMazeBattleModel:SetRestore(num)
    self.restore = self.restore + num
    self:RefreshRestoreRedPoint()
    if num < 0 then
       self:RefreshInfoRedPoint() 
    end
    _G.Events:GetInstance():Broadcast(_G.eSociatyMaze.SociatyMazeRestoreChange, num)
end

