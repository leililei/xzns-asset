end

---是否已领取女神像奖励
function SociatyMazeBattleModel:IsGetGoddess(uid)
    return _G.table.indexof(self.goddess, uid) ~= false
end

---最大体力数据
function SociatyMazeBattleModel:GetMaxRestore()
    return _G.ConfigManager.discrete_cfg[116103][1][1]
end

---获取地图大小
function SociatyMazeBattleModel:GetMapSize()
    return self.mapWidthPoint * self.mapHeightPoint
end

---将格子的uid反解成x,y
function SociatyMazeBattleModel:GetPointXY(uid)
    return _G.Mathf.Floor(uid / 100), uid % 100
end

---将格子的uid转换成一维数组的索引
function SociatyMazeBattleModel:GetPointIndexByUid(uid)
    local row, col = self:GetPointXY(uid)
    return (self.mapWidthPoint - row) * self.mapHeightPoint + col
end

---将格子坐标(x,y)转换成一维数组索引
function SociatyMazeBattleModel:GetPointIndexByXY(x, y)
    return (self.mapWidthPoint - x) * self.mapHeightPoint + y
end

---是否有战斗难度设定
---@param type number    地图格子类型
---@return boolean
function SociatyMazeBattleModel:HasGrade(type)
    --101	小怪_雷
    --102	小怪_风
    --103	小怪_水
    --104	小怪_火
    --105	小怪_土
    --106	小怪_神
    --107	小BOSS
    --108	大BOSS
    return type >= 101 and type <= 108 or type == 112
end

---是否已通关迷宫
---@return boolean
function SociatyMazeBattleModel:IsPass()
    return self.isPass
end

---是否已领取通关奖励
---@return boolean
function SociatyMazeBattleModel:IsGetPassAward()
    return self.isGetPassAward
end

---修改历史记录
function SociatyMazeBattleModel:ChangeHisTimes(type)
    if self.hisTimes then
        for i, v in pairs(self.hisTimes) do
            if v.k == type then
                self.hisTimes[i].v = v.v + 1
                break
            end
        end
    end
end

---宝箱和女神像是否达到上限
function SociatyMazeBattleModel:IsGetLimited(type)
    if self.hisTimes then
        local max = 0
        if type == self.pointType.Box then
            max = _G.ConfigManager.discrete_cfg[116113][1][1]
        elseif type == self.pointType.Goddess then
            max = _G.ConfigManager.discrete_cfg[116117][1][1]
        end
        for _, v in pairs(self.hisTimes) do
            if v.k == type then
                return v.v >= max
            end
        end
    end

    return false
end

---当前是否满体力
function SociatyMazeBattleModel:IsMaxRestore()
    return self:GetRestore() >= self:GetMaxRestore()
end

function SociatyMazeBattleModel:GetBoxRedNum()
    local boxList = self.boxOpenList[self.pointType.Box]
    if not boxList then
        return 0
    end

    if self:IsGetLimited(self.pointType.Box) then
        return 0
    end

    return _G.table.count(boxList)
end

function SociatyMazeBattleModel:GetInfoAward()
    if not self:IsGetLimited(self.pointType.Goddess) and not self:IsMaxRestore() then
        local goddessList = self.boxOpenList[self.pointType.Goddess]
        if goddessList and #goddessList > 0 then
            return 1
        end
    end

    local weaponryList = self.boxOpenList[self.pointType.Weaponry]
    if weaponryList then
        if weaponryList and #weaponryList > 0 then
            return 1
        end
    end
    return 0
end

---获取玩家胜点
---@return boolean
function SociatyMazeBattleModel:GetWinPoint()
    return self.winPoint or 0
end

---增加玩家胜点
---@param uid number 挑战的格子id
---@param grade number  挑战的难度(非怪物挑战传0)
---@return void
function SociatyMazeBattleModel:AddWinPointFromCell(uid, grade)
    local mapData = self:GetMapData(uid)
    if not mapData then
        return
    end
    --如果迷宫已通关, 不再获取胜点
    if self.isPass and mapData.type ~= self.pointType.BigBoss then
        return
    end
    local cfg = _G.ConfigManager.guild_gve_cfg[mapData.type]
    self.winPoint = (self.winPoint or 0) + (self:HasGrade(mapData.type) and cfg.score[grade] or cfg.score[1] or 0)

    if self.isPass then
        self:RefreshPassAwardRedPoint()
        self:RefreshRestoreRedPoint()
    end
end

---体力红点
function SociatyMazeBattleModel:CheckRestoreRedPoint()
    if self.isPass then
        return 0
    end
    if not self.restore then
        return 0
    end
    return self.restore > 0 and 1 or 0
end

function SociatyMazeBattleModel:RefreshRelic(uid)
    if self.boxOpenList[self.pointType.Weaponry] then
        self:RemoveBoxList(self.pointType.Weaponry, uid)
    end
end

