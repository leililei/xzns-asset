---@class SociatyMazeBattleModel : GameDataModelBase	中文描述
---@field mapData table<number,guild_maze.s2c_maze_cell>        @地图格子数据
---@field isPass boolean                                        @是否已通关迷宫
---@field isGetPassAward boolean                                @是否已领取通关奖励
local SociatyMazeBattleModel = _G.BaseClass("SociatyMazeBattleModel", _G.Singleton)

---@type table<number,number> 难度语言表id
local GradeLanguageIds = {
    [1] = 90032700008, --简单
    [2] = 90032700009, --普通
    [3] = 90032700010, --困难
    [4] = 90032700011, --地狱
}

---@return SociatyMazeBattleModel SociatyMazeBattleModel
function SociatyMazeBattleModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function SociatyMazeBattleModel:__init()
    self.pointType = {
        LeiMonster = 101,   --小怪-雷
        FengMonster = 102,  --小怪-风
        ShuiMonster = 103,  ---小怪-水
        HuoMonster = 104,   --小怪-火
        TuMonster = 105,    --小怪-土
        ShenMonster = 106,  --小怪-神
        SmallBoss = 107,    --小Boss
        BigBoss = 108,      --大Boss
        Goddess = 109,      --女神像
        Gift = 110,         --藏宝阁
        Box = 111,          --免费宝箱
        Weaponry = 112,     ---兵器库
        BrithPoint = 113,   ---出生点
        EmptyPoint = 114,   ---空白点
        BigPointEmpty = 115 ---大格子空白占位，方便后面做客户端表现，比如加特效
    }
    local mapSize = _G.ConfigManager.discrete_cfg[116110][1]
    self.mapWidthPoint = mapSize[1]
    self.mapHeightPoint = mapSize[2]
    self.boxOpenList = {}
end

---解析玩家的暗影迷宫数据
---@param roleInfo guild_maze.i_role_maze_info
---@param isPass boolean
function SociatyMazeBattleModel:ParseRoleInfo(roleInfo, isPass)
    ---体力点
    self.restore = roleInfo.restore or 0
    ---今日已探索点
    self.route = roleInfo.route or {}
    ---已触发的宝箱格子
    self.treasure = roleInfo.treasure or {}
    ---已触发的女神像格子
    self.goddess = roleInfo.goddess or {}
    ---玩家的胜点(累计)
    self.winPoint = roleInfo.win_point
    self.isPass = isPass
    self.isGetPassAward = roleInfo.pass_award and roleInfo.pass_award > 0
    ---宝箱和女神像的历史次数
    self.hisTimes = roleInfo.his_times
    self:RefreshRestoreRedPoint()
    self:RefreshPassAwardRedPoint()
    self:RefreshRelicEquipRedPoint()
    -- self:GetBoxList()
end

---订阅
---@param type number 0订阅或1取消订阅
function SociatyMazeBattleModel:Subscribe(type)
    require("SociatyMazeNet"):GetInstance():Subscribe(
        { subscribe_type = type },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
        end
    )
end

---设置探索路径(客户端只记录战斗格子，其他格子没有需求就暂时不缓存)
function SociatyMazeBattleModel:SetRoute(uid)
    if not _G.table.indexof(self.route, uid) then
        _G.table.insert(self.route, uid)
    end
end

---今日是否已探索路径
function SociatyMazeBattleModel:CheckRoute(uid)
    return _G.table.indexof(self.route, uid)
end

---拉取地图数据
function SociatyMazeBattleModel:GetMapInfo(callback)
    self.isPass = false
    require("SociatyMazeNet"):GetInstance():GetMapInfo(
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self.mapData = {}
            local mapPointData = {}
            local smallBossData = {}
            local bigBossData = {}
            if msg.cells then
                for _, v in pairs(msg.cells) do
                    mapPointData[self:GetPointIndexByUid(v.uid)] = v
                    if v.type == self.pointType.BigBoss then
                        bigBossData = v
                        self.isPass = v.status == 2 --已通关迷宫
                    elseif v.type == self.pointType.SmallBoss then
                        _G.table.insert(smallBossData, v)
                    end
                    self.mapData[v.uid] = v
                end
            end
            --刷新通关奖励红点
            if self.isPass then
                self:RefreshPassAwardRedPoint()
                self:RefreshRestoreRedPoint()
            end
            if callback then
                callback(mapPointData, smallBossData, bigBossData)
            end
        end
    )
end

function SociatyMazeBattleModel:ChangeBoxList(type, uid)
    if not self.boxOpenList[type] then
        self.boxOpenList[type] = {}
    end

    if _G.table.indexof(self.boxOpenList[type], uid) == false then
        _G.table.insert(self.boxOpenList[type], uid)
        if type == self.pointType.Box then
           self:RefreshBoxRedPoint()
        else
            self:RefreshInfoRedPoint() 
        end
    end
end

function SociatyMazeBattleModel:RemoveBoxList(type, uid)
    if not self.boxOpenList[type] then
        return
    end

    self:ChangeHisTimes(type)
    local index = _G.table.indexof(self.boxOpenList[type], uid)
    if index then
        _G.table.remove(self.boxOpenList[type], index)
        if type == self.pointType.Box then
           self:RefreshBoxRedPoint()
        else
            self:RefreshInfoRedPoint()
        end
    end
end

---修改格子状态
function SociatyMazeBattleModel:ChangeStatus(uid, callback)
    require("SociatyMazeNet"):GetInstance():ChangeStatus(
        { uid = uid, status = 1 },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            if self.mapData[uid] and (self.mapData[uid].type == self.pointType.Box or self.mapData[uid].type == self.pointType.Goddess) then
                self:ChangeBoxList(self.mapData[uid].type, uid)
            end
            if callback then
                callback()
            end
        end
    )
end

---触发事件
function SociatyMazeBattleModel:TriggerEvent(uid, type, callback)
    require("SociatyMazeNet"):GetInstance():TriggerEvent(
        { uid = uid },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            if type == self.pointType.Goddess then
                self:SetRestore(1)
                _G.table.insert(self.goddess, uid)
                _G.Events:GetInstance():Broadcast(_G.eSociatyMaze.SociatyMazeGoddess, uid)

                self:RemoveBoxList(type, uid)
            elseif type == self.pointType.Box then
                _G.table.insert(self.treasure, uid)
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                _G.Events:GetInstance():Broadcast(_G.eSociatyMaze.SociatyMazeBox, uid)

                self:RemoveBoxList(type, uid)
            end
            if callback then
                callback()
            end
        end
    )
end

---设置标记
function SociatyMazeBattleModel:SetMarker(uid, flag, callback)
    require("SociatyMazeNet"):GetInstance():SetMarker(
        { uid = uid, flag = flag },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self:SetMapData(uid, "flg", flag)
            if callback then
                callback(msg)
            end
        end
    )
end

---获取宝箱列表
function SociatyMazeBattleModel:GetBoxList(callback)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(264) then
        return
    end
    require("SociatyMazeNet"):GetInstance():GetBoxList(
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self.boxOpenList = {}
            if msg.boxes then
                for i, v in ipairs(msg.boxes) do
                    if v.open == 0 then
                        if not self.boxOpenList[v.cell.type] then
                            self.boxOpenList[v.cell.type] = {}
                        end
                        _G.table.insert(self.boxOpenList[v.cell.type], v.cell.uid)
                    end
                end
            end
            self:RefreshBoxRedPoint()
            self:RefreshInfoRedPoint()
            if callback then
                callback(msg)
            end
        end
    )
end

---获取地图数据
---@param uid number
---@return guild_maze.s2c_maze_cell
function SociatyMazeBattleModel:GetMapData(uid)
    if not self.mapData then
        return nil
    end
