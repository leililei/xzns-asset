---检测是否有可领取的兵器库
function SociatyMazeBattleModel:CheckWeaponryRedPoint(data)
    if not data or data.type ~= self.pointType.Weaponry or data.status ~= 2 then
        return 0
    end

    return require("SociatyMazeRelicManager"):GetInstance():CheckWeaponryRedPoint(data)
end

---玩家被踢数据或者功能结算
function SociatyMazeBattleModel:OnBeKicked()
    self.restore = 0
    self.mapData = {}
    self.route = {}
    self.treasure = {}
    self.winPoint = 0
    self:RefreshRestoreRedPoint()
    self:RefreshPassAwardRedPoint()
    self:RefreshRelicEquipRedPoint()
end

---获取卡牌配置
function SociatyMazeBattleModel:GetCardCfg(data, monsterId)
    if not monsterId then
        local config = _G.ConfigManager.guild_gve_cfg[data.type]
        monsterId = config.monster_group and config.monster_group[data.monster_pool][1]
    end
    if monsterId then
        local groupCfg = _G.ConfigManager.monster_group_cfg[monsterId]
        local defenserSids = groupCfg and groupCfg.DefaultDefenserSids and groupCfg.DefaultDefenserSids[1]
        if defenserSids then
            local monsterCfg
            if defenserSids[4] > 0 then
                monsterCfg = _G.ConfigManager.monster_cfg[defenserSids[4]]
            else
                monsterCfg = _G.ConfigManager.monster_cfg[defenserSids[1]]
            end
            local cardConfig = _G.ConfigManager.card_cfg[monsterCfg.CardID]
            return cardConfig
        end
    end
    return nil
end

--region ===========================战斗逻辑===================================

---获取挑战monster group id, 返回0表示地图缓存不存在
---@param uid number 挑战的格子id
---@param grade number  挑战的难度(非怪物挑战传0)
---@return number
function SociatyMazeBattleModel:GetFightMonsterGroupId(uid, grade)
    local mapData = self:GetMapData(uid)
    if not mapData then
        return 0
    end

    local cfg = _G.ConfigManager.guild_gve_cfg[mapData.type]
    return self:HasGrade(mapData.type) and
        cfg.monster_group[mapData.monster_pool][grade] or
        cfg.monster_group[1][1]
end

---获取挑战限定五行, 返回nil表示不作限制
---@param uid number 挑战的格子id
---@param grade number  挑战的难度(非怪物挑战传0)
---@return CardElementType[]
function SociatyMazeBattleModel:GetFightLockElements(uid, grade)
    local mapData = self:GetMapData(uid)
    if not mapData then
        return nil
    end
    if not self:HasGrade(mapData.type) then
        grade = 1
    end

    local cfg = _G.ConfigManager.guild_gve_cfg[mapData.type]
    local removeElements = cfg.Elements[grade]
    if not removeElements or #removeElements <= 0 then
        return nil
    end

    local elements = {
        _G.CardElementType.Thunder,
        _G.CardElementType.Wind,
        _G.CardElementType.Water,
        _G.CardElementType.Fire,
        _G.CardElementType.Earth,
        _G.CardElementType.God,
    }
    for _, remove in pairs(removeElements) do
        local index = _G.table.indexof(elements, remove)
        if index and index >= 0 then
            _G.table.remove(elements, index)
        end
    end
    return elements
end

function SociatyMazeBattleModel:GetMonsterName(uid, grade)
    uid = uid or self.id
    local mapData = self:GetMapData(uid)
    if not mapData then
        return ""
    end

    local cfg = _G.ConfigManager.guild_gve_cfg[mapData.type]
    ---@type string
    local name
    if self:HasGrade(mapData.type) then
        local bossName
        if mapData.type == self.pointType.SmallBoss or mapData.type == self.pointType.BigBoss then
            local cardCfg = self:GetCardCfg(mapData)
            bossName = _G.GetLangPackValue(cfg.name, _G.GetLangPackValue(cardCfg.Name))
        else
            bossName = _G.GetLangPackValue(cfg.name)
        end
        name = string.format(
            "%s(%s)",
            bossName,
            _G.GetLangPackValue(grade and GradeLanguageIds[grade] or GradeLanguageIds[1])
        )
    else
        name = _G.GetLangPackValue(cfg.name)
    end
    return name
end

---挑战当前关卡
---@param uid number 挑战的格子id
---@param grade number  挑战的难度(非怪物挑战传0)
---@return void
function SociatyMazeBattleModel:Fight(uid, grade)
    if _G.MainManager:GetInstance():IsFighting(true) then
        return
    end
    --检查地图单元格状态
    local pass, exists = self:CheckMapDataPass(uid)
    if pass or not exists then
        _G.PopWindowManager:GetInstance():ShowAllTips(1010107)
        self:ShowWindows()
        return
    end
    self.id = uid
    --获取monster id
    local monsterGroupId = self:GetFightMonsterGroupId(uid, grade)
    local autoFight = false
    --进入布阵场景
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMazeEmbattleView.Name,
        _G.handler(self, self.ExitEmbattle),
        function(_, _, skipBattle)
            if skipBattle then
                self:SkipFight(uid, grade, monsterGroupId)
            else
                self:EnterFight(uid, grade, monsterGroupId)
            end
        end,
        uid,
        grade,
        autoFight
    )
end

---进入战斗
---@return void
function SociatyMazeBattleModel:EnterFight(uid, grade, monsterGroupId)
    _G.BattleManager:GetInstance():SetInBattle(true)
    --发起战斗请求
    require("SociatyMazeNet"):GetInstance():Fight(
        { uid = uid, difficulty = grade, monster_sid = monsterGroupId },
        function(msg)
            if not msg or msg.ack ~= 1 then
                _G.BattleManager:GetInstance():SetInBattle(false)
                _G.WorldManager:GetInstance():DespawnRoleParent()
                self:ExitEmbattle()
                return
            end
            if msg.winner and msg.winner[1] then
                self:SetRestore(-1)
                self:AddWinPointFromCell(uid, grade)
                self:SetRoute(uid)
            end
            _G.BattleManager:GetInstance():SetArgData(msg.data)
            _G.BattleManager:GetInstance():EnterFight(_G.BattleControllerType.SociatyMaze, msg, uid, grade,
                monsterGroupId)
        end
    )
end

---跳过战斗
---@return void
function SociatyMazeBattleModel:SkipFight(uid, grade, monsterGroupId)
    _G.BattleManager:GetInstance():SetInBattle(true)
    --发起战斗请求
    require("SociatyMazeNet"):GetInstance():Fight(
        { uid = uid, difficulty = grade, monster_sid = monsterGroupId },
        function(msg)
            if not msg or msg.ack ~= 1 then
                _G.BattleManager:GetInstance():SetInBattle(false)
                _G.WorldManager:GetInstance():DespawnRoleParent()
                self:ExitEmbattle()
                return
            end
            if msg.winner and msg.winner[1] then
                self:SetRestore(-1)
                self:AddWinPointFromCell(uid, grade)
                self:SetRoute(uid)
            end

            ---@type BattleControllerSociatyMaze
            local controller = _G.require(_G.BattleControllerType.SociatyMaze).New()
            controller.id = uid
            controller.grade = grade
            controller.monsterId = monsterGroupId
            controller.curFightState = 4 --设置战斗结束
            controller.results = msg

            _G.BattleManager:GetInstance():SetArgData(msg.data)
            _G.BattleManager:GetInstance():SetBattleController(controller)
            --显示结算界面
            controller:FightResultFunc(nil)
        end
    )
end

---离开战斗
---@return void
function SociatyMazeBattleModel:ExitEmbattle()
    self:ShowWindows()
end

---返回主页面(刷新)
---@return void
function SociatyMazeBattleModel:ReturnPanel(isWin, id)
    if id == require("SettlementModel").FunctionEnum.Next or
        id == require("SettlementModel").FunctionEnum.DevelopRole or
        id == require("SettlementModel").FunctionEnum.DevelopEquip then
        return
    end
    if isWin then
        local mapData = self:GetMapData(self.id)
        if mapData.type == self.pointType.Weaponry and mapData.status == 2 then
            local msg = {}
            msg.cell_uid = self.id
            require "SociatyMazeNet":GetInstance():GetMementoList(
                msg,
                function(data)
                    if data.ack ~= 1 then
                        return
                    end
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMazeGetRelicView.Name,
                        data.mementos, self.id)
                end
            )
        end
    end
    self:ShowWindows()
end

---显示主界面
---@return void
function SociatyMazeBattleModel:ShowWindows()
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.SociatyMainView.Name)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.SociatyMazeMainView.Name)
end

---监听界面打开
---@param name string 界面名称
function SociatyMazeBattleModel:OnEmbattleViewOpened(name)
    if name ~= _G.ConfigManager.ui_cfg.EmbattleView.Name then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    --隐藏主界面
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SociatyMainView.Name)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SociatyMazeMainView.Name)
    --隐藏事件入口面板
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SociatyMazeBossInfoView.Name)
end

--endregion


--region ===========================网络接口===================================

---获取藏宝库信息
---@param uid number
---@param callback fun(msg:guild_maze.s2c_get_treasure_info):void
function SociatyMazeBattleModel:GetGiftInfo(uid, callback)
    require("SociatyMazeNet"):GetInstance():GetGiftInfo({ cell_uid = uid }, callback)
end

---购买藏宝库物品
---@param uid number
---@param index number 商品序号
---@param callback fun(msg:public.s2c_common_ack):void
function SociatyMazeBattleModel:BuyGift(uid, index, callback)
    require("SociatyMazeNet"):GetInstance():BuyGift({ cell_uid = uid, index = index }, callback)
end

---获取通关奖励信息
---@param callback fun(msg:guild_maze.s2c_get_award_log):void
function SociatyMazeBattleModel:GetPassAwardInfo(callback)
    require("SociatyMazeNet"):GetInstance():GetPassAwardInfo(
        _G.handlerbind(self, self.OnGetPassAwardInfoCallback, callback)
    )
end

---领取通关奖励
---@param index number
---@param callback fun(msg:public.s2c_common_ack):void
function SociatyMazeBattleModel:GetPassAward(index, callback)
    require("SociatyMazeNet"):GetInstance():GetPassAward(
        { award_index = index },
        _G.handlerbind(self, self.OnGetPassAwardCallback, callback)
    )
end

---通关奖励信息回调
function SociatyMazeBattleModel:OnGetPassAwardInfoCallback(msg, callback)
    if msg and msg.ack == 1 and msg.award_logs then
        local selfUid = _G.PlayerModel:GetInstance():GetPlayerUid()
        for _, v in pairs(msg.award_logs) do
            if v.uid == selfUid then
                self.isGetPassAward = true
                break
            end
        end
    end
    if callback then
        callback(msg)
    end
end

---领取通关奖励回调
function SociatyMazeBattleModel:OnGetPassAwardCallback(msg, callback)
    if msg and msg.ack == 1 then
        self.isGetPassAward = true
        --获取奖励
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
        --刷新红点状态
        self:RefreshPassAwardRedPoint()
    end
    if callback then
        callback(msg)
    end
end

--endregion


--region ===========================服务器推送===================================

---通关奖励领取状态推送
---@param msg guild_maze.i_award_log
function SociatyMazeBattleModel:OnPassAwardChange(msg)
    _G.Events:GetInstance():Broadcast(_G.eSociatyMaze.SociatyMazePassAwardChange, msg)
end

---迷宫格子推送
---@param cells guild_maze.s2c_maze_cell[]
function SociatyMazeBattleModel:OnSociatyMazeChange(cells)
    if not cells or not self.mapData then
        return
    end
    for _, v in pairs(cells) do
        self.mapData[v.uid] = v
        --已通关迷宫
        if v.type == self.pointType.BigBoss and v.status == 2 then
            self.isPass = true
            self:RefreshPassAwardRedPoint()
            self:RefreshRestoreRedPoint()
        end
        if (v.type == self.pointType.Goddess or v.type == self.pointType.Weaponry or v.type == self.pointType.Box) and v.status == 0 then
            self:ChangeBoxList(v.type, v.uid)
        end
    end
    _G.Events:GetInstance():Broadcast(_G.eSociatyMaze.SociatyMazeChange, cells)
end

---MVP结算推送
---@param msg guild_maze.i_guild_maze_member
function SociatyMazeBattleModel:OnSociatyMazeMvp(msg)
    --已通关迷宫
    self.isPass = true
    self:RefreshPassAwardRedPoint()
    self:RefreshRestoreRedPoint()
    require("SociatyMazeModel"):GetInstance():SetMvpData(msg)
end

--endregion

