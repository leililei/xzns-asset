local SociatyMazeModel = require("SociatyMazeModel"):GetInstance()
---@class SociatyMazeRelicManager : GameDataModelBase
---@field GetInstance fun():SociatyMazeRelicManager
local SociatyMazeRelicManager = _G.BaseClass("SociatyMazeRelicManager", _G.GameDataModelBase)

-- region -------------静态变量-------------

-- endregion

function SociatyMazeRelicManager:__init()
end

---奇物 飞行动画 遗物的坐标点， 方便 奇物界面获取位置用来计算
function SociatyMazeRelicManager:SetRelicPostionToScreenPoint(point)
    self.point_relic = point
end
function SociatyMazeRelicManager:GetRelicPostionToScreenPoint()
    return self.point_relic
end
---@param uid number 格子uid
function SociatyMazeRelicManager:CheckRelicGet(uid)
    return _G.table.ContainsValue(SociatyMazeModel.roleInfo.special_battle, uid)
end

function SociatyMazeRelicManager:CheckWeaponryRedPoint(data)
    if data.status == 2 and not self:CheckRelicGet(data.uid) then
        return 1
    end
    return 0
end

function SociatyMazeRelicManager:CheckRelicEquipRedPoint()
    local list
    if SociatyMazeModel.roleInfo then
        list = SociatyMazeModel.roleInfo.mementos
    else
        return 0 
    end
    local equipBol = false
    for i = 1, #list do 
        if SociatyMazeModel:CheckRelicEquip(list[i]) ~= 1 then 
            equipBol = true 
            break
        end
    end
    if _G.table.ContainsValue(SociatyMazeModel.roleInfo.put_mementos, 0) and equipBol then
        return 1
    end
    return 0
end

function SociatyMazeRelicManager:Dispose()
end

return SociatyMazeRelicManager