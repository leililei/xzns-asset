---@class SociatyMazeHelpView : UIBaseView	中文描述
---@field public go_table DrawUpAwardPreView_GoTable GoTable
local SociatyMazeHelpView = _G.BaseClass("SociatyMazeHelpView", _G.UIBaseView)
local tipsid = 1
function SociatyMazeHelpView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

local Picture = {
    "ImagesH5/hSociatyMaze/guild_gve_teach_02",
    "ImagesH5/hSociatyMaze/guild_gve_teach_04",
    "ImagesH5/hSociatyMaze/guild_gve_teach_03",
    "ImagesH5/hSociatyMaze/guild_gve_teach_01"
}

---界面的入口函数
---@param ActivityID number 活动id
function SociatyMazeHelpView:OnCreate()
    self.languages = _G.ConfigManager.discrete_cfg[116132]
    self.nowIndex = 1
    self.maxIndex = #self.languages
    self:FreshSkill()
end

function SociatyMazeHelpView:FreshSkill()
    self.go_table.aorrawimage_skill:LoadImage(
        Picture[self.nowIndex],
        function()
            if not _G.IsNil(self) then
                -- self.go_table.aorrawimage_skill:SetNativeSize()
            end
        end
    )
    self.go_table.aortext_skillName.text = _G.GetLangPackValue(self.languages[self.nowIndex][1])
    self.go_table.aortext_skillDes.text = _G.GetLangPackValue(self.languages[self.nowIndex][2])
    _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(self.go_table.aortext_skillDes.rectTransform)
    self:ShowArrow()
    for i = 1, 4 do 
        self.go_table["aorimage_dot" .. i]:SetActiveE(i > self.maxIndex and 0 or 1)
        self.go_table["aorimage_dotShow" .. i]:SetActiveE(i == self.nowIndex and 1 or 0)
    end
end
function SociatyMazeHelpView:ShowArrow()
    self.go_table.aorbtn_left:SetActiveE(self.nowIndex ~= 1 and 1 or 0)
    self.go_table.aorbtn_right:SetActiveE(self.nowIndex ~= self.maxIndex and 1 or 0)
end

---按钮点击事件在这里派发
function SociatyMazeHelpView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Get then
    elseif go == self.go_table.aorbtn_close then 
        self:Close()
    elseif go == self.go_table.aorbtn_left then 
        self.nowIndex = self.nowIndex - 1
        self.nowIndex = self.nowIndex > 0 and self.nowIndex or 1
        self:FreshSkill()
    elseif go == self.go_table.aorbtn_right then 
        self.nowIndex = self.nowIndex + 1
        self.nowIndex = self.nowIndex < self.maxIndex and self.nowIndex or self.maxIndex
        self:FreshSkill()
    end
end

function SociatyMazeHelpView:Dispose()
    --_G.UIUtils.CloseVideo()
end

return SociatyMazeHelpView
