---@class SociatyMazeRelicView : UIBaseView 中文描述
local SociatyMazeRelicView = _G.BaseClass("SociatyMazeRelicView", _G.UIBaseView)
local frameColor = {
    "TY_Background_kuang_zi",
    "TY_Background_kuang_cheng",
    "TY_Background_kuang_hong",
    "TY_Background_kuang_jin",
}
function SociatyMazeRelicView:Awake()
    self.Qiwu = _G.GetAutoGoTable(self.go_table.obj_qiwu, _G.handler(self, self.OnClickBtn))
    self.equipRelic = { self.Qiwu.obj_equip1, self.Qiwu.obj_equip2, self.Qiwu.obj_equip3, self.Qiwu.obj_equip4, self
        .Qiwu.obj_equip5 }
    self.NameColors = { "<color=#612B8B>", "<color=#D2510B>", "<color=#C62121>", "<color=#EDC23F>" }
    self.equipRelic_gotable = {}
    for i = 1, #self.equipRelic do
        self.equipRelic_gotable[i] = _G.GetAutoGoTable(self.equipRelic[i],
            _G.handlerbind(self, self.OnClickEquipRelic, i))
    end
end

---界面的入口函数
function SociatyMazeRelicView:OnCreate(...)
    self.args = { ... }
    self:UpdateView()
    --_G.UIUtils.LoadEffectByCfg(
    --    _G.ConfigManager.ui_effect_cfg.ef_SociatyMazeRelicView_huolu,
    --    self.Qiwu.obj_effect
    --)
    self:AddListener(_G.eSociatyEvent.BeKicked, self.OnBeKicked, self)
    self:AddListener(_G.eSociatyMaze.SociatyMazeSettle, self.OnSociatyMazeSettle, self)
end

---被踢出公会
function SociatyMazeRelicView:OnBeKicked(uid)
    if uid == _G.PlayerModel:GetInstance().role_uid then
        self:Close()
    end
end

---已结算-本期时间已结束
function SociatyMazeRelicView:OnSociatyMazeSettle()
    self:Close()
end

function SociatyMazeRelicView:UpdateView()
    --self.nowEquipIndex = self.nowEquipIndex or 1
    self.chooseId = nil
    self.chooseObj = nil
    self:UpdateEquip()
    self:RefreshRed()
end

---刷新装备的遗物显示
function SociatyMazeRelicView:UpdateEquip(go, info)
    self.nowEquipIndex = self.nowEquipIndex or 1
    local noEquipIndexT1 = {}
    local noEquipIndexT2 = {}
    local equipInfo = info or require "SociatyMazeModel":GetInstance().roleInfo.put_mementos
    require "SociatyMazeModel":GetInstance().roleInfo.put_mementos = equipInfo
    for i = 1, 5 do
        if equipInfo[i] and equipInfo[i] ~= 0 then
            self.equipRelic_gotable[i].aorrawimage_Icon:SetActiveE(1)
            local cfg = _G.ConfigManager.mementos_cfg[equipInfo[i]]
            self.equipRelic_gotable[i].aorrawimage_Icon:LoadImage(cfg.icon)
        else
            self.equipRelic_gotable[i].aorrawimage_Icon:SetActiveE(0)
            if self.nowEquipIndex > i then
                _G.table.insert(noEquipIndexT1, i)
            else
                _G.table.insert(noEquipIndexT2, i)
            end
        end
        self.equipRelic_gotable[i].aorimage_on:SetActiveE(0)
    end
    if noEquipIndexT2[1] or noEquipIndexT1[1] then
        self.chooseId = nil
    end
    self.nowEquipIndex = noEquipIndexT2[1] or noEquipIndexT1[1] or self.nowEquipIndex
    self.equipRelic_gotable[self.nowEquipIndex].aorimage_on:SetActiveE(1)
    local tempIndex = self.nowEquipIndex
    self.nowEquipIndex = nil
    self:OnClickEquipRelic(nil, nil, tempIndex, true)
    self:RefreshRed()
end

---点击装备的遗物
------autoBol是指穿戴后自动跳转下一个的情况
function SociatyMazeRelicView:OnClickEquipRelic(go, IsOn, index, autoBol)
    if self.nowEquipIndex == index then
        return
    end
    if self.nowEquipIndex then
        self.equipRelic_gotable[self.nowEquipIndex].aorimage_on:SetActiveE(0)
    end
    self.equipRelic_gotable[index].aorimage_on:SetActiveE(1)
    self.nowEquipIndex = index
    self:FreshBtnTxt()
    self:UpdateList(autoBol)
end

---刷新按键文字
function SociatyMazeRelicView:FreshBtnTxt()
    local equipInfo = require "SociatyMazeModel":GetInstance().roleInfo.put_mementos
    if not equipInfo[self.nowEquipIndex] or equipInfo[self.nowEquipIndex] == 0 then
        self.Qiwu.aortext_Sure.text = _G.LangUtil.GetLangPackValue(90023400020) --"穿戴"
    else
        self.Qiwu.aortext_Sure.text = _G.LangUtil.GetLangPackValue(90031300041) --"替换"
    end
end

---更新显示
---autoBol是指穿戴后自动跳转下一个的情况
function SociatyMazeRelicView:UpdateList(autoBol)
    local model = require "SociatyMazeModel"
    local list = {}
    list = model:GetInstance().roleInfo.mementos
    if list and #list > 0 then
        self.MemenList = list
        _G.SortList(
            self.MemenList,
            function(id)
                ---@type mementos_cfg
                local cfg = _G.ConfigManager.mementos_cfg[id]
                local equip = model:GetInstance():CheckRelicEquip(id) == 1 and 0 or 1
                return equip, cfg.quality, cfg.id
            end
        )
        self.Qiwu.obj_relic:SetActiveE(1)
        self.Qiwu.obj_nil:SetActiveE(0)
    else
        self.Qiwu.obj_relic:SetActiveE(0)
        self.Qiwu.obj_nil:SetActiveE(1)
        return
    end
    local equipInfo = require "SociatyMazeModel":GetInstance().roleInfo.put_mementos
    local index = 1
    if equipInfo[self.nowEquipIndex] and equipInfo[self.nowEquipIndex] ~= 0 then
        --装备栏里已装备，自动选中装备的那个遗物
        for i = 1, #list do
            if list[i] == equipInfo[self.nowEquipIndex] then
                index = i
                self.chooseId = list[i]
                break
            end
        end
    else
        --装备栏是空的，如果是自动跳转的情况，默认选中最高级的未穿戴的。如果是手动点的装备栏，默认是之前已选中的
        if autoBol then
            for i = 1, #list do
                if not _G.table.ContainsValue(require "SociatyMazeModel":GetInstance().roleInfo.put_mementos, list[i]) then
                    self.chooseId = list[i]
                    index = i
                    break
                end
            end
        end
        self.chooseId = self.chooseId or list[1]
    end
    if self.initScroll then
        self.Qiwu.scrollloopvectical_CardList2:UpdateAllItem(#self.MemenList)
        local goIndex = index >= (#self.MemenList - 2) and (#self.MemenList - 4) or (index - 1)
        self.Qiwu.scrollloopvectical_CardList2:ScrollToIndex(goIndex)
    else
        local goIndex = index >= (#self.MemenList - 2) and (#self.MemenList - 4) or (index - 1)
        self.Qiwu.scrollloopvectical_CardList2:InitItemData(#self.MemenList, _G.handler(self, self.RefreshList))
        self.initScroll = true
    end
end

---刷新列表
function SociatyMazeRelicView:RefreshList(index, obj)
    if index < 0 then
        return
    end
    local id = self.MemenList[index + 1]
    ---@type mementos_cfg
    local cfg = _G.ConfigManager.mementos_cfg[id]
    local item = _G.GetAutoGoTable(obj)
    item.aorbtn_click.onClick:AddListener(_G.handlerbind(self, self.OnClickItemBtn, index, item))
    item.aorrawimage_Icon:LoadImage(cfg.icon)
    item.aorimage_Color.SpriteName = frameColor[cfg.quality]
    item.aorimage_on.gameObject:SetActiveE(self.chooseId == cfg.id and 1 or 0)
    item.obj_gou:SetActiveE(require "SociatyMazeModel":GetInstance():CheckRelicEquip(id))
    if self.chooseId and self.chooseId == cfg.id then
        self:OnClickItemBtn(index, item)
    elseif not self.chooseId and not _G.table.ContainsValue(require "SociatyMazeModel":GetInstance().roleInfo.put_mementos, cfg.id) then
        --如果是自动跳转的情况，默认选中最高级的未穿戴的
        self:OnClickItemBtn(index, item)
    end
    return obj
end

function SociatyMazeRelicView:InitClickQiwu(cfg, item)
    if self.chooseObj then
        self.chooseObj:SetActiveE(0)
    end
    self.chooseObj = item.aorimage_on.gameObject
    self.chooseObj:SetActiveE(1)
    self.chooseId = cfg.id
    self.Qiwu.obj_equipNow:SetActiveE(1)
    local equipNowGoTable = _G.GetAutoGoTable(self.Qiwu.obj_equipNow)
    local cfg = _G.ConfigManager.mementos_cfg[self.chooseId]
    equipNowGoTable.aorrawimage_Icon:LoadImage(cfg.icon)
    if cfg.skills then
        local skillDesc = _G.ConfigManager.card_skills_cfg[cfg.skills].describe1
        equipNowGoTable.aortext_desc.text = _G.LangUtil.GetLangPackValue(skillDesc)
    else
        equipNowGoTable.aortext_desc.text = ""
    end
    equipNowGoTable.aortext_name.text = self.NameColors[cfg.quality] ..
        _G.LangUtil.GetLangPackValue(cfg.name) .. "</color>"
end

--打开遗物点击
function SociatyMazeRelicView:OnClickItemBtn(index, item)
    local id = self.MemenList[index + 1]
    local cfg = _G.ConfigManager.mementos_cfg[id]
    self:InitClickQiwu(cfg, item)
end

---主要界面点击事件
function SociatyMazeRelicView:OnClickBtn(go, IsOn)
    if go == self.Qiwu.aorbtn_CloseView then
        self:Close()
    elseif go == self.Qiwu.aorbtn_close then
        self:Close()
    elseif go == self.Qiwu.aorbtn_Sure then
        if not self.chooseId then
            return
        end
        local model = require "SociatyMazeModel"
        local list = {}
        list = model:GetInstance().roleInfo.mementos
        local equipInfo = _G.DeepCopy(model:GetInstance().roleInfo.put_mementos)
        if equipInfo[self.nowEquipIndex] and equipInfo[self.nowEquipIndex] == self.chooseId then
            return
        end
        local changeId = equipInfo[self.nowEquipIndex] or 0
        for i = 1, 5 do
            if equipInfo[i] == self.chooseId then
                equipInfo[i] = changeId
            end
        end
        equipInfo[self.nowEquipIndex] = self.chooseId
        local msg = { mementos = equipInfo }
        require "SociatyMazeNet":GetInstance():ChangeAllRelic(msg, _G.handlerbind(self, self.UpdateEquip, equipInfo))
        --_G.UIUtils.LoadEffectByCfg(
        --    _G.ConfigManager.ui_effect_cfg.ef_hunlian_bao,
        --    self.equipRelic_gotable[self.nowEquipIndex].gameObject
        --)
    elseif go == self.Qiwu.aorbtn_Pass then
        local equipInfo = _G.DeepCopy(require "SociatyMazeModel":GetInstance().roleInfo.put_mementos)
        if equipInfo[self.nowEquipIndex] and equipInfo[self.nowEquipIndex] ~= 0 then
            equipInfo[self.nowEquipIndex] = 0
            local msg = { mementos = equipInfo }
            require "SociatyMazeNet":GetInstance():ChangeAllRelic(msg, _G.handlerbind(self, self.UpdateEquip, equipInfo))
        end
    end
end
---刷新装备栏红点
function SociatyMazeRelicView:RefreshRed()
    if require("SociatyMazeRelicManager"):GetInstance():CheckRelicEquipRedPoint() == 1 then 
        local equipInfo = require "SociatyMazeModel":GetInstance().roleInfo.put_mementos
        for i = 1, 5 do 
            self.equipRelic_gotable[i].obj_red:SetActiveE(equipInfo[i] == 0 and 1 or 0)
        end
    else 
        for i = 1, 5 do 
            self.equipRelic_gotable[i].obj_red:SetActiveE(0)
        end
    end
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SociatyMazeRelicEquip.id)
end

---销毁对象时,析构函数
function SociatyMazeRelicView:OnDestroy()
    self:RemoveAllListener()
    self.initScroll = nil
end

return SociatyMazeRelicView
