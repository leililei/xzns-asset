---@class SociatyMazePreviewAwardView : UIBaseView	中文描述
---@field public go_table SociatyMazePreviewAwardView_GoTable GoTable
local SociatyMazePreviewAwardView = _G.BaseClass("SociatyMazePreviewAwardView", _G.UIBaseView)

function SociatyMazePreviewAwardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param uid number 关卡uid
---@param type number 关卡类型
function SociatyMazePreviewAwardView:OnCreate()
    self.type = 101
    self.itemTransDic = {}
    self:InitView()
end

---初始化窗口
function SociatyMazePreviewAwardView:InitView()
    ---基础奖励
    self.baseAward = {}
    ---掉落奖励
    self.dropAward = {{}, {}, {}}
    self.dropCfg = _G.ConfigManager.drop_cfg[_G.ConfigManager.guild_gve_reward_cfg[self.type].drop]
    -- 基础奖励
    self:InitBaseAward()
    local item, go
    for _, v in ipairs(self.baseAward) do
        item = _G.InstantiateObject(self.go_table.obj_node, self.go_table.obj_awards)
        go = _G.GetAutoGoTable(item)
        go.aortext_name.text = ""
        require "BaseAwardNewItem".New(item):ShowWithID(v)
    end

    -- 掉落奖励
    self:InitDropAward()
    self.go_table.scrollloophorizontal_awards1:InitItemData(
        #self.dropAward[1],
        _G.handlerbind(self, self.RefreshItem, 1)
    )
    self.go_table.scrollloophorizontal_awards2:InitItemData(
        #self.dropAward[2],
        _G.handlerbind(self, self.RefreshItem, 2)
    )
    self.go_table.scrollloophorizontal_awards3:InitItemData(
        #self.dropAward[3],
        _G.handlerbind(self, self.RefreshItem, 3)
    )
end

---初始化基础奖励
function SociatyMazePreviewAwardView:InitBaseAward()
    if not self.dropCfg then
        if _G.AppSetting.DEBUG then
            _G.LogError("战斗掉落为配置读取为空")
        end
        return
    end
    for i = 1, 2 do
        if self.dropCfg.fixed_drop[i] then
            _G.table.insert(self.baseAward, {self.dropCfg.fixed_drop[i][1], 0})
        end
    end
end

---初始化掉落奖励
function SociatyMazePreviewAwardView:InitDropAward()
    local sidDic = {}
    local dropCfg
    for _, v in pairs(_G.ConfigManager.guild_gve_reward_cfg) do
        dropCfg = _G.ConfigManager.drop_cfg[v.drop]
        for _, award in pairs(dropCfg.fixed_drop) do
            sidDic[award[1]] = true
        end
        for _, award in pairs(dropCfg.content1) do
            sidDic[award[1]] = true
        end
        for _, award in pairs(dropCfg.content2) do
            sidDic[award[1]] = true
        end
    end
    local order
    for sid, _ in pairs(sidDic) do
        order = _G.StorageManager:GetInstance():GetItemQuality(sid)
        if order > 5 then --6/7/8
            _G.table.insert(self.dropAward[1], {sid, order}) --不显示数量，数量位置为order方便排序
        elseif order > 4 then -- 5
            _G.table.insert(self.dropAward[2], {sid, order})
        else
            _G.table.insert(self.dropAward[3], {sid, order})
        end
    end
    -- 按品质排序
    for i = 1, 3 do
        _G.SortList(
            self.dropAward[i],
            function(a)
                return a[2], a[1]
            end
        )
    end
end

---掉落奖励道具刷新
function SociatyMazePreviewAwardView:RefreshItem(index, obj, group)
    index = index + 1
    obj:SetName(index)
    local instanceID = obj:GetInstanceIDE()
    local sid = self.dropAward[group][index][1]
    local type = self:GetItemType(sid)
    if not self.itemTransDic[instanceID] or not self.itemTransDic[instanceID][type] then
        if not self.itemTransDic[instanceID] then
            self.itemTransDic[instanceID] = {}
        end
        _G.ItemFactory:GetInstance():GetItemCard(
            type,
            obj,
            function(item)
                self.itemTransDic[instanceID][type] = item
                self.itemTransDic[instanceID][type]:Show(
                    sid,
                    function()
                        require("CommonTipManager"):GetInstance():OpenTip(obj, sid)
                    end
                )
            end
        )
    else
        self.itemTransDic[instanceID][type]:Show(
            sid,
            function()
                require("CommonTipManager"):GetInstance():OpenTip(obj, sid)
            end
        )
    end

    for i, v in pairs(self.itemTransDic[instanceID]) do
        if i == type then
            v.gameObject:SetActiveE(1)
        else
            v.gameObject:SetActiveE(0)
        end
    end
end

---获得item类型
function SociatyMazePreviewAwardView:GetItemType(sid)
    local storageType = _G.StorageManager:GetInstance():CheckSidType(sid)
    if storageType == _G.StorageType.Equipment then
        -- 装备
        return _G.ItemFactory.itemType.ItemEquipmentBase
    elseif storageType == _G.StorageType.Decoration then
        -- 饰品/刻魂
        return _G.ItemFactory.itemType.ItemDecorationBase
    elseif storageType == _G.StorageType.Card then
        -- 卡牌碎片
        return _G.ItemFactory.itemType.ItemDebrisBase
    elseif storageType == _G.StorageType.Artifact then
        -- 神器
        return _G.ItemFactory.itemType.ItemArtifactBase
    elseif storageType == _G.StorageType.Spiritual then
        -- 灵契
        return _G.ItemFactory.itemType.ItemSpiritualBase
    else
        -- 基础item
        return _G.ItemFactory.itemType.ItemBaseWithCount
    end
end

---界面的销毁函数
function SociatyMazePreviewAwardView:OnDestroy()
end

---按钮点击事件在这里派发
function SociatyMazePreviewAwardView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_closeview then
        self:Close()
    end
end

return SociatyMazePreviewAwardView
