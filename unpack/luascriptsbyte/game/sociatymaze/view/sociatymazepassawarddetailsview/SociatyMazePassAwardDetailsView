---@class SociatyMazePassAwardDetailsView: UIBaseView	暗影迷宫-通关奖励详情
---@field go_table SociatyMazePassAwardDetailsView_GoTable
---@field data guild_maze.i_award_log
local SociatyMazePassAwardDetailsView = _G.BaseClass("SociatyMazePassAwardDetailsView", _G.UIBaseView)

function SociatyMazePassAwardDetailsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    self:AddListener(_G.eSociatyEvent.BeKicked, self.OnBeKicked)
    self:AddListener(_G.eSociatyMaze.SociatyMazeSettle, self.OnBeKicked)
end

function SociatyMazePassAwardDetailsView:OnDestroy()
    self:RemoveAllListener()
end

---监听被踢出公会
---@return void
function SociatyMazePassAwardDetailsView:OnBeKicked()
    self:Close()
end

function SociatyMazePassAwardDetailsView:OnCreate(data)
    --如果没有公会, 关闭窗口
    if not require("SociatyManager"):GetInstance():HasSociaty() then
        self:Close()
        return
    end
    self.data = data
    self:LoadPlayerInfos()
    self:LoadRewardInfos()
end

---显示玩家信息
---@return void
function SociatyMazePassAwardDetailsView:LoadPlayerInfos()
    self.go_table.aortext_name.text = self.data.name
    require("SystemSettingNet"):GetInstance():GetPlayerInfo(
        { uid = self.data.uid },
        function(msg)
            if self:IsNil() then
                return
            end
            if not msg.info then
                return
            end
            _G.UIUtils.SetPlayerHeadItemNew(self.go_table.obj_HeadItemBase, msg.info, 0.8, true, true, false)
        end
    )
end

---显示奖励信息
---@return voids
function SociatyMazePassAwardDetailsView:LoadRewardInfos()
    if not self.data.item then
        return
    end
    for _, d in ipairs(self.data.item) do
        local parent = _G.InstantiateObject(self.go_table.obj_awardItem, self.go_table.obj_awardParent)
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            { d.k, d.v },
            parent,
            function(item)
                if self:IsNil() or _G.IsNil(item) or _G.IsNil(parent) then
                    return
                end
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)

                local data = _G.StorageManager:GetInstance():GetStorageItemData(d.k)
                if data and data.Cfg and _G.tonumber(data.Cfg.ef_item) == 1 then
                    item:ShowEffect(true)
                end
            end
        )
    end
end

---监听界面UI事件
---@return void
function SociatyMazePassAwardDetailsView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close1 then
        self:Close()
    end
end

return SociatyMazePassAwardDetailsView
