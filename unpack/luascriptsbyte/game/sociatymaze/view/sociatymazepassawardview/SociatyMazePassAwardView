---@class SociatyMazePassAwardView: UIBaseView	暗影迷宫-通关奖励
---@field go_table SociatyMazePassAwardView_GoTable
---@field listItems table<number,SociatyMazePassAwardView._obj_listItem_GoTable>
---@field count number              @有多少个箱子
---@field members table<number,guild_maze.i_award_log>  @公会成员领取状态
local SociatyMazePassAwardView = _G.BaseClass("SociatyMazePassAwardView", _G.UIBaseView)
local itemCfg = _G.ConfigManager.item_cfg
function SociatyMazePassAwardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eSociatyEvent.BeKicked, self.OnBeKicked)
    self:AddListener(_G.eSociatyMaze.SociatyMazeSettle, self.OnBeKicked)
    self:AddListener(_G.eSociatyMaze.SociatyMazePassAwardChange, self.OnPassAwardChange)

    --初始化节点状态
    self.go_table.obj_listItem:SetActiveE(0)
    self.go_table.scrollloopvectical_list:InitItemData(0, _G.handler(self, self.OnRefreshItem))
end

function SociatyMazePassAwardView:OnDestroy()
    self:RemoveAllListener()
end

---监听被踢出公会
---@return void
function SociatyMazePassAwardView:OnBeKicked()
    self:Close()
end

function SociatyMazePassAwardView:OnCreate()
    --如果没有公会, 关闭窗口
    if not require("SociatyManager"):GetInstance():HasSociaty() then
        self:Close()
        return
    end
    --self:AddComponent(
    --    self.go_table.obj_goldInfo,
    --    require("ResourceCompont").New(
    --        self.go_table.obj_goldInfo,
    --        _G.ConfigManager.ui_cfg.SociatyMazePassAwardView.resources
    --    )
    --)

    --初始化数据
    self.count = require("SociatyModel"):GetInstance().SociatySelf.SociatyMemberModule:GetCurMemberCount()
    self.count = require("SociatyModel"):GetInstance().SociatySelf.SociatyMemberModule.MaxMemberNum --以公会最大人数显示
    self.members = {}
    local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
    self.boxEffect = {
        [8] = ui_effect_cfg.ef_SociatyMazePassAwardView_cai,
        [7] = ui_effect_cfg.ef_SociatyMazePassAwardView_jin,
        [6] = ui_effect_cfg.ef_SociatyMazePassAwardView_hong,
        [5] = ui_effect_cfg.ef_SociatyMazePassAwardView_cheng
    }

    --拉取奖励状态
    local battleModel = require("SociatyMazeBattleModel"):GetInstance()
    if battleModel:IsPass() then
        battleModel:GetPassAwardInfo(_G.handler(self, self.OnPassAwardInfo))
    else
        self.go_table.scrollloopvectical_list:UpdateCount(self.count)
    end
end

---拉取通关奖励回调
---@param msg guild_maze.s2c_get_award_log
function SociatyMazePassAwardView:OnPassAwardInfo(msg)
    if not msg or msg.ack ~= 1 then
        self.go_table.scrollloopvectical_list:UpdateCount(self.count)
        return
    end

    self.members = {}
    if msg.award_logs then
        for _, v in pairs(msg.award_logs) do
            if v.item and #v.item > 0 then
                self:SortAwardItem(v)
            end
            self.members[v.award_index] = v
        end
    end
    self.go_table.scrollloopvectical_list:UpdateCount(self.count)
end

function SociatyMazePassAwardView:SortAwardItem(info)
    _G.SortList(
        info.item,
        function(data)
            local id = _G.tonumber(data.k)
            if itemCfg[id] then
                return itemCfg[id].Quality, -id
            end
            return -id
        end
    )
end

---刷新宝箱列表
---@param obj UnityEngine.GameObject
function SociatyMazePassAwardView:OnRefreshItem(index, obj)
    if not self.listItems then
        self.listItems = {}
    end
    ---@type SociatyMazePassAwardView._obj_listItem_GoTable
    local item = self.listItems[obj:GetInstanceIDE()]
    if not item then
        item = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickItemBtn, item))
        self.listItems[obj:GetInstanceIDE()] = item
    end

    local data = self.members and self.members[index + 1] or nil
    item.data = data
    item.index = index + 1
    ---显示玩家信息
    if data then
        item.obj_head:SetActiveE(1)
        item.aortext_name:SetActiveE(1)
        item.aortext_name.text = data.name
        require("SystemSettingNet"):GetInstance():GetPlayerInfo(
            {uid = data.uid},
            function(msg)
                if self:IsNil() then
                    return
                end
                if not msg.info then
                    return
                end
                _G.UIUtils.SetPlayerHeadItemNew(item.obj_HeadItemBase, msg.info, 0.8, true, true, false)
            end
        )
    else
        item.obj_head:SetActiveE(0)
        item.aortext_name:SetActiveE(0)
    end
    --显示宝箱信息
    item.obj_opened:SetActiveE(data and 1 or 0)
    item.obj_useable:SetActiveE(data and 0 or 1)
    if item.obj_effect:GetChildCountE() > 0 then
        item.obj_effect:ClearChildren()
    end
    if data then
        if data.item and #data.item > 0 then
            item.aorrawimage_award:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(data.item[1].k))
            local cfg = _G.ConfigManager.item_cfg[data.item[1].k]

            if cfg and cfg.Quality then
                if self.boxEffect[cfg.Quality] then
                    _G.UIUtils.LoadEffectByCfg(self.boxEffect[cfg.Quality], item.obj_effect)
                end

                if _G.ItemBaseIconName[cfg.Quality] then
                    item.aorimage_bg.SpriteName = _G.ItemBaseIconName[cfg.Quality]
                end
            end
        end
    end
end

---监听界面UI事件
---@param msg guild_maze.i_award_log
function SociatyMazePassAwardView:OnPassAwardChange(msg)
    if not msg or msg.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
        --如果是自己的推送, 不作处理
        return
    end

    if not self.members then
        self.members = {}
    end
    self:SortAwardItem(msg)
    self.members[msg.award_index] = msg
    self.go_table.scrollloopvectical_list:UpdateAllItem()
end

---宝箱点击事件
---@param item SociatyMazePassAwardView._obj_listItem_GoTable|{index:number,data:guild_maze.i_award_log}
function SociatyMazePassAwardView:OnClickItemBtn(go, isOn, item)
    if item.data then
        --显示领取详情
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMazePassAwardDetailsView.Name, item.data)
    else
        local battleModel = require("SociatyMazeBattleModel"):GetInstance()
        --未通关迷宫
        if not battleModel:IsPass() then
            _G.PopWindowManager:GetInstance():ShowAllTips(1010101)
            return
        end
        --已领取奖励
        if battleModel:IsGetPassAward() then
            _G.PopWindowManager:GetInstance():ShowAllTips(1010104)
            return
        end
        --未参与迷宫
        -- if battleModel:GetWinPoint() <= 0 then
        --     _G.PopWindowManager:GetInstance():ShowAllTips(1010114)
        --     return
        -- end
        --领取宝箱奖励
        local index = item.index
        require("SociatyMazeBattleModel"):GetInstance():GetPassAward(
            index,
            function(msg)
                if not msg or msg.ack ~= 1 then
                    return
                end
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.SociatyMazeePassAwardTip.Name,
                    function()
                        self:OnAwardCall(msg, index)
                    end
                )
            end
        )
    end
end

function SociatyMazePassAwardView:OnAwardCall(msg, index)
    --显示奖励
    _G.UIUtils.ShowCommonAward(msg)
    --更新缓存并更新视图
    if not self.members then
        self.members = {}
    end
    local info = {
        uid = _G.PlayerModel:GetInstance():GetPlayerUid(),
        name = _G.PlayerModel:GetInstance():GetName(),
        frame = _G.PlayerModel:GetInstance():GetCurFrame(),
        portrait = 0,
        item = {}
    }
    if msg and msg.award and msg.award.item then
        for _, v in ipairs(msg.award.item) do
            table.insert(info.item, {k = v.type[1], v = v.type[2]})
        end
    end
    self:SortAwardItem(info)
    self.get = true
    self.members[index] = info
    self.go_table.scrollloopvectical_list:UpdateAllItem()
end

---监听界面UI事件
---@return void
function SociatyMazePassAwardView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_preview then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMazePreviewAwardView.Name)
    end
end

return SociatyMazePassAwardView
