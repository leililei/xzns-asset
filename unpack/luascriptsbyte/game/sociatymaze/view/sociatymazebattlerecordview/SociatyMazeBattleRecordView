---@class SociatyMazeBattleRecoredView : UIBaseView	中文描述
---@field public go_table SociatyMazeBattleRecoredView_GoTable GoTable
---@field sid number 传入的关卡sid
---@field infos table 当前关卡的通关信息
local SociatyMazeBattleRecordView = _G.BaseClass("SociatyMazeBattleRecordView", _G.UIBaseView)

function SociatyMazeBattleRecordView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param uid number 关卡uid
---@param type number 关卡类型
function SociatyMazeBattleRecordView:OnCreate(uid, type)
    self.uid = uid
    self.infos = {}
    self.score = _G.ConfigManager.guild_gve_cfg[type].score
    ---难度列表
    self.difficultyList = {
        _G.GetLangPackValue(90032700008),
        _G.GetLangPackValue(90032700009),
        _G.GetLangPackValue(90032700010),
        _G.GetLangPackValue(90032700011)
    }
    self:InitView()
end

---初始化窗口
function SociatyMazeBattleRecordView:InitView()
    ---@type SociatyMazeModel
    local model = require("SociatyMazeModel"):GetInstance()
    if not model:CheckIsSettle() then
        model:GetBattleRecord(
        self.uid,
        function(msg)
            if msg.ack ~= 1 or not msg.reports then
                self.go_table.obj_isNil:SetActiveE(1)
                return
            end
            self.go_table.obj_isNil:SetActiveE(0)
            self.infos = msg.reports
            -- 对通过信息排序，难度>时间
            _G.SortList(self.infos, function(a)
                return a.difficulty, a.time
            end)

            self.go_table.scrollloopvectical_records:InitItemData(#self.infos, _G._G.handler(self, self.RefreshList))
        end)
    end
end

---刷新item
function SociatyMazeBattleRecordView:RefreshList(index, item)
    if index < 0 then
        return
    end
    index = index + 1
    local go_table = _G.GetAutoGoTable(item)
    local data
    data = self.infos[index]
    -- 账号信息(左)
    _G.UIUtils.SetPlayerHeadItemNew(
        go_table.obj_HeadItemBase,
        {
            frame = data.frame,
            style = data.portrait,
            title = data.title
        },
        0.7,
        true,
        true,
        true,
        function()
            local uid = data.uid
            if uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.PopWindowManager:GetInstance():ShowAllTips(620109)
            else
                _G.SystemSettingManager:GetInstance():OpenView(uid)
            end
        end
    )
    go_table.aortext_name.text = data.name
    go_table.aortext_power.text = _G.GameUtil.NumberToUnitStrBag(data.power, true)
    -- 通关信息(中)
    go_table.aortext_nandu.text = self.difficultyList[data.difficulty]
    go_table.aortext_shengdian.text = "+" .. (data.win_points)
    -- 队伍信息(右)
    local info = data.arrays
    for k, v in ipairs(info[1].cards) do
        -- 没有上阵卡牌，服务器会传来sid为0
        if v.sid and v.sid ~= 0 then
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.CardAllItem,
                go_table.obj_cardlist,
                function(tran)
                    tran.gameObject:SetLocalScaleXYZ(0.48)
                    tran.gameObject:SetRectTransformSize(88, 88)
                    -- 卡牌头像显示
                    tran:Show(
                        v.sid,
                        -- 点击回调
                        function ()
                            self:CilckCard(v.uid,data.uid, v)
                        end,
                        v.star,
                        v.soul_lv,
                        v.level,
                        nil,
                        nil,
                        1
                    )
                end
            )
        end
    end
end

---阵容卡牌点击
---@param card_uid number 卡牌uid
---@param role_uid number 角色uid
function SociatyMazeBattleRecordView:CilckCard(card_uid, role_uid, data)
    if data.c_type == 5 then 
        _G.PopWindowManager:GetInstance():ShowAllTips(602, _G.GetLangPackValue(90100000206))
        return 
    end
    require("PlayerInfoNet"):GetInstance():GetCardInfo(
        { card_uid = tonumber(card_uid), role_uid = role_uid },
        function(msg)
            if msg.ack ~= 1 then
                if _G.AppSetting.Debug then
                    _G.LogError("获取卡牌信息异常")
                end
                return
            end
            local cardData = require("CardData").New()
            local card = msg.card
            cardData:Parse(card)
            cardData:SaveEquipmentData(card, true)
            cardData:SaveDecorationData(card, true)
            if not _G.AppSetting.IsOverseas then
                cardData:SaveArtifactData(card, true)
                cardData:SaveSpiritualData(card, true)
            end
            local skin
            if cardData.skin ~= 0 then
                skin = cardData.skin
            end
            -- _G.UIManager:GetInstance():OpenWindow(
            --     _G.ConfigManager.ui_cfg.CommonIllustrationsTopView.Name,
            --     cardData.sid,
            --     nil,
            --     true,
            --     cardData,
            --     nil,
            --     nil,
            --     true,
            --     nil,
            --     nil,
            --     nil,
            --     skin
            -- )
        end
    )
end

---界面的销毁函数
function SociatyMazeBattleRecordView:OnDestroy()
end

---按钮点击事件在这里派发
function SociatyMazeBattleRecordView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_closeview then
        self:Close()
    end
end

return SociatyMazeBattleRecordView
