---@class SociatyMazeInfoView : UIBaseView	中文描述
---@field public go_table SociatyMazeInfoView_GoTable GoTable
local SociatyMazeInfoView = _G.BaseClass("SociatyMazeInfoView", _G.UIBaseView)

function SociatyMazeInfoView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyMazeInfoView:OnCreate(index)
     local defaultIndex = index and index or 1
     self.go_table.toggle_info.isOn = defaultIndex == 1
     self.go_table.toggle_Reward.isOn = defaultIndex == 2
     if defaultIndex == 1 then
         self:OnClickBtn(self.go_table.toggle_info, defaultIndex == 1)
     elseif defaultIndex == 2 then
         self:OnClickBtn(self.go_table.toggle_Reward, defaultIndex == 2)
     end
    self:ShowLog(true)
end

---日志
function SociatyMazeInfoView:ShowLog(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Info, isOn)
    if not isOn then
        return
    end
    if not self.SociatyMazeInfoLog then
        self.SociatyMazeInfoLog = self:AddComponent(self.go_table.obj_Info, require "SociatyMazeInfoLog".New(self))
        self.SociatyMazeInfoLog:Show()
    end
end

---宝箱奖励
function SociatyMazeInfoView:ShowBox(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Reward, isOn)
    if not isOn then
        return
    end
    if not self.SociatyMazeInfoBox then
        self.SociatyMazeInfoBox = self:AddComponent(self.go_table.obj_Reward, require "SociatyMazeInfoBox".New())
        self.SociatyMazeInfoBox:Show()
    end
end

function SociatyMazeInfoView:OnToggle(go, isOn, callback)
    local tb = _G.GetAutoGoTable(go)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, isOn)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOff, not isOn)
    callback(self, isOn)
end

---界面的销毁函数
function SociatyMazeInfoView:OnDestroy()
end

---按钮点击事件在这里派发
function SociatyMazeInfoView:OnClickBtn(go, isOn)
    if go == self.go_table.toggle_info then
        self:OnToggle(go, isOn, self.ShowLog)
    elseif go == self.go_table.toggle_Reward then
        self:OnToggle(go, isOn, self.ShowBox)
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

return SociatyMazeInfoView