local SociatyMazeNet = require("SociatyMazeNet")
local SociatyMazeBattleModel = require("SociatyMazeBattleModel")
---@class SociatyMazeInfoBox : Component	中文描述
local SociatyMazeInfoBox = _G.BaseClass("SociatyMazeInfoBox", _G.Component)

---创建对象时,入口构造函数
function SociatyMazeInfoBox:OnCreate()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self.cfg = _G.ConfigManager.guild_gve_cfg
    self.tiliIcon = require("SociatyMazeModel"):GetInstance():GetRestoreIcon()
    self.go_table.scrollloopvectical_itemList:InitItemData(0, _G.handler(self, self.RefreshItem))
end

function SociatyMazeInfoBox:Show()
    self.listData = {}
    self.ItemList = {}

    SociatyMazeBattleModel:GetInstance():GetBoxList(
        function(data)
            self.listData = data.boxes or {}

            for i = 1, #self.listData do
                local info = self.listData[i]
                if info.cell.type == SociatyMazeBattleModel:GetInstance().pointType.Weaponry then
                    info.boxsort = 3
                elseif info.cell.type == SociatyMazeBattleModel:GetInstance().pointType.Goddess then
                    info.boxsort = 2
                elseif info.cell.type == SociatyMazeBattleModel:GetInstance().pointType.Box then
                    info.boxsort = 1
                end
            end
            self:SetItemListView()
        end
    )
end

---滑动区域显示
function SociatyMazeInfoBox:SetItemListView()
    _G.table.sort(
        self.listData,
        function(a, b)
            if a.open == b.open then
                return a.boxsort < b.boxsort
            else
                return a.open < b.open
            end
        end
    )
    self.go_table.scrollloopvectical_itemList:UpdateCount(#self.listData)
    self.go_table.obj_IsNil:SetActiveE(#self.listData > 0 and 0 or 1)
end

function SociatyMazeInfoBox:RefreshItem(index, item)
    if index < 0 then
        return
    end
    local id = item:GetInstanceIDE()
    local eIndex = index + 1
    local ctrl = _G.GetAutoGoTable(item)
    _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnItemClickBtn, ctrl, eIndex))
    self.ItemList[id] = ctrl
    local data = self.listData[eIndex]
    if data then
        ctrl.aortext_name.text = _G.LangUtil.GetLangPackValue(self.cfg[data.cell.type].name)
        ctrl.aortext_time.text = _G.LangUtil.GetLangPackValue(90032700052) .. data.cell.role_name
    end
    ctrl.obj_open:SetActiveE(0)
    ctrl.aortext_num:SetActiveE(0)
    if data.cell.type == SociatyMazeBattleModel:GetInstance().pointType.Weaponry then
        ctrl.aorimage_box.SpriteName = data.open == 1 and "ui_guild_gve_buff_opne" or "ui_guild_gve_buff_close"
        ctrl.obj_redpoint:SetActiveE(data.open == 1 and 0 or 1)
    elseif data.cell.type == SociatyMazeBattleModel:GetInstance().pointType.Goddess then
        ctrl.aorimage_box.SpriteName = data.open == 1 and "ui_guild_gve_gold" or "ui_guild_gve_gold"

        local isMax = SociatyMazeBattleModel:GetInstance():IsMaxRestore()
        local isLimited = SociatyMazeBattleModel:GetInstance():IsGetLimited(data.cell.type)
        ctrl.obj_redpoint:SetActiveE((data.open == 1 or isMax or isLimited) and 0 or 1)
    elseif data.cell.type == SociatyMazeBattleModel:GetInstance().pointType.Box then
        ctrl.aorimage_box.SpriteName = data.open == 1 and "ui_guild_gve_box_open" or "ui_guild_gve_box_close"
        ctrl.obj_redpoint:SetActiveE((data.open == 1 or SociatyMazeBattleModel:GetInstance():IsGetLimited(data.cell.type)) and 0 or 1)
    else
        ctrl.obj_redpoint:SetActiveE(0)
    end
    ctrl.aorbtn_click:SetGray(data.open == 1)
    local color = data.open == 1 and "616161" or "8C2D14"
    ctrl.aortext_click.color = require("CardInfoManager").GetColorFromRGB(color)
    ctrl.data = data.cell
    ctrl.aorimage_tili.SpriteName = self.tiliIcon
end

function SociatyMazeInfoBox:OnItemClickBtn(go, _, ctrl, eIndex)
    if go == ctrl.aorbtn_click then
        local data = self.listData[eIndex]
        if data.open == 1 then
            return
        end
        if ctrl.data.type == SociatyMazeBattleModel:GetInstance().pointType.Weaponry then
            ---兵器库
            local msg = {}
            msg.cell_uid = ctrl.data.uid
            require "SociatyMazeNet":GetInstance():GetMementoList(
                msg,
                function(data1)
                    if data1.ack ~= 1 then
                        return
                    end
                    _G.Events:GetInstance():Broadcast(_G.eSociatyMaze.SociatyMazeGetRelic, msg.cell_uid)
                    _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.SociatyMazeGetRelicView.Name,
                        data1.mementos,
                        ctrl.data.uid,
                        function()
                            for _, v in ipairs(self.listData) do
                                if v.cell.uid == ctrl.data.uid then
                                    v.open = 1
                                    break
                                end
                            end
                            self:SetItemListView()
                        end
                    )
                end
            )
        else
            if ctrl.data.type == SociatyMazeBattleModel:GetInstance().pointType.Goddess then
                if SociatyMazeBattleModel:GetInstance():IsGetGoddess(ctrl.data.uid) then
                    _G.PopWindowManager:GetInstance():ShowAllTips(1010105)
                    return
                end

                if
                    SociatyMazeBattleModel:GetInstance():GetRestore() >=
                        SociatyMazeBattleModel:GetInstance():GetMaxRestore()
                 then
                    _G.PopWindowManager:GetInstance():ShowAllTips(1010106)
                    return
                end
            end
            SociatyMazeBattleModel:GetInstance():TriggerEvent(
                ctrl.data.uid,
                ctrl.data.type,
                function()
                    for i, v in ipairs(self.listData) do
                        if v.cell.uid == ctrl.data.uid then
                            v.open = 1
                            break
                        end
                    end
                    self:SetItemListView()
                end
            )
        end
    end
end
---销毁对象时,析构函数
function SociatyMazeInfoBox:OnDestroy()
end

return SociatyMazeInfoBox
