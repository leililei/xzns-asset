---@class SociatyMazeRankReward : Component	中文描述
local SociatyMazeRankReward = _G.BaseClass("SociatyMazeRankReward", _G.Component)

local CS = _G.CS
local typeof = _G.typeof

---创建对象时,入口构造函数
function SociatyMazeRankReward:OnCreate()
    self.go_table.scrollloopvectical_itemList:InitItemData(0, _G.handler(self, self.RefreshItem))
end

function SociatyMazeRankReward:Show()
    self:InitData()
    self.go_table.scrollloopvectical_itemList:UpdateCount(#self.Member)
    -- self:InitPlayer(index, num, score)
end

function SociatyMazeRankReward:InitData()
    self.rankData = {}
    self.ItemList = {}
end

function SociatyMazeRankReward:RefreshItem(index, item)
    if index < 0 then
        return
    end
    local id = item:GetInstanceIDE()
    local eIndex = index + 1
    local ctrl = _G.GetAutoGoTable(item)
    -- _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnItemClickBtn, ctrl, eIndex))
    self.ItemList[id] = ctrl
    self:RefreshItemShow(ctrl, eIndex)
end

function SociatyMazeRankReward:RefreshItemShow(ctrl, index)
    ctrl.index = index
    local data = self.rankData[index]
    if data then
        ctrl.aortext_name.text = _G.GetLangPackValue(90021800050)..index
        ctrl.aortext_time.text = data.time
        ctrl.aortext_num.text = data.num
    end
end

---销毁对象时,析构函数
function SociatyMazeRankReward:OnDestroy()
end
