local SociatyMazeNet = require("SociatyMazeNet")
local PlayerModel = require("PlayerModel")
---@class SociatyMazeRankPlayer : Component	中文描述
local SociatyMazeRankPlayer = _G.BaseClass("SociatyMazeRankPlayer", _G.Component)

local IconPath = {
    [1] = "0ui_icon_diyi",
    [2] = "0ui_icon_dier",
    [3] = "0ui_icon_disan"
}

---创建对象时,入口构造函数
function SociatyMazeRankPlayer:OnCreate()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.scrollloopvectical_itemList:InitItemData(0, _G.handler(self, self.RefreshItem))
end

function SociatyMazeRankPlayer:Show()
    self.ItemList = {}
    self.rankData = {}
    SociatyMazeNet:GetInstance():GetMemberList(
        function (data)
            self.rankData = data.member
            _G.table.sort(self.rankData, function (a, b)
                return a.win_points > b.win_points
            end)
            self.go_table.scrollloopvectical_itemList:UpdateCount(#self.rankData)
            local uid = _G.PlayerModel:GetInstance():GetPlayerUid()
            local index = 0
            for i, v in ipairs(self.rankData) do
                if v.role.uid == uid then
                    index = i
                    self.power = v.role.power
                    self:InitPlayer(index, v.win_points, v.contribute)
                    break
                end
            end
        end
    )
end


function SociatyMazeRankPlayer:RefreshItem(index, item)
    if index < 0 then
        return
    end
    local id = item:GetInstanceIDE()
    local eIndex = index + 1
    local ctrl = _G.GetAutoGoTable(item)
    -- _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnItemClickBtn, ctrl, eIndex))
    self.ItemList[id] = ctrl
    self:RefreshItemShow(ctrl, eIndex)
end

function SociatyMazeRankPlayer:RefreshItemShow(ctrl, index)
    ctrl.index = index
    local data = self.rankData[index]
    if data then
        ctrl.obj_rankBg2:SetActiveE(index <= 3 and 0 or 1)
        if index <= 3 then
            ctrl.aorimage_rank:SetActiveE(1)
            ctrl.obj_rankBg2:SetActiveE(0)
            for i = 1, 3 do
                ctrl["aortext_rankNum" .. i]:SetActiveE(i == index and 1 or 0)
            end
            ctrl.aorimage_rankBg:SetRectTransformSize(646, 116)
            ctrl.aorimage_rankBg.SpriteName = "ui_diban" .. index
            ctrl.aorimage_rank.SpriteName = IconPath[index]
        else
            ctrl.aorimage_rank:SetActiveE(0)
            ctrl.obj_rankBg2:SetActiveE(1)
            ctrl.aortext_rankNum.text = index
            ctrl.aorimage_rankBg.SpriteName = "TY_img_kuang"
            ctrl.aorimage_rankBg:SetRectTransformSize(635, 108)
        end
        ctrl.aortext_name.text = data.role.name
        ctrl.aortext_power.text = _G.GameUtil.NumberToUnitStrBag(data.role.power, true)
        _G.UIUtils.SetPlayerHeadItemNew(ctrl.obj_HeadItemBase, data.role, 1, true, true, false, function()
            if data.type ~= 1 then
                if data.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                    _G.PopWindowManager:GetInstance():ShowAllTips(620109)
                else
                    _G.SystemSettingManager:GetInstance():OpenView(data.role.uid)
                end
            else
                _G.SystemSettingManager:GetInstance():OpenRobotPlayInfo(data.role.uid, nil, _G.RobotType.Arena)
            end
        end)
        ctrl.aortext_num.text = data.win_points
        ctrl.aortext_score.text = _G.GetLangPackValue(90032700021) .. data.contribute .. "%"
    end
end

function SociatyMazeRankPlayer:InitPlayer(index, num, score)
    ---@type _obj_Rank._obj_rankItem_GoTable
    local tb = GetAutoGoTable(self.go_table.obj_player)
    if index == 0 then
        tb.aortext_rankNum.text = _G.GetLangPackValue(90022900040)
    else
        tb.aortext_rankNum.text = index
    end
    local data = _G.PlayerModel:GetInstance():GetIRroleTable()
    tb.aortext_name.text = data.name
    tb.aortext_power.text = _G.GameUtil.NumberToUnitStrBag(self.power, true)
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data, 1, true, true, false)
    tb.aortext_num.text = num
    tb.aortext_score.text = _G.GetLangPackValue(90032700021) .. score .. "%"
end

---销毁对象时,析构函数
function SociatyMazeRankPlayer:OnDestroy()
end

return SociatyMazeRankPlayer
