local SociatyMazeModel = require("SociatyMazeModel")

---@class SociatyMazeInfoLog : Component	中文描述
local SociatyMazeInfoLog = _G.BaseClass("SociatyMazeInfoLog", _G.Component)

---创建对象时,入口构造函数
function SociatyMazeInfoLog:OnCreate()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.scrollloopvectical_itemList:InitItemData(0, _G.handler(self, self.RefreshItem))
end

function SociatyMazeInfoLog:Show()
    self.logData = {}
    self.ItemList = {}
    SociatyMazeModel:GetInstance():GetMazeLog(
        function(data)
            self.logData = data
            self.go_table.scrollloopvectical_itemList:UpdateCount(#self.logData)
            self.go_table.obj_IsNil:SetActiveE(#self.logData > 0 and 0 or 1)
            self.go_table.scrollloopvectical_itemList:SetActiveE(#self.logData > 0 and 1 or 0)
        end
    )
end

function SociatyMazeInfoLog:RefreshItem(index, item)
    if index < 0 then
        return
    end
    local id = item:GetInstanceIDE()
    local eIndex = index + 1
    local ctrl = _G.GetAutoGoTable(item)
    -- _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnItemClickBtn, ctrl, eIndex))
    self.ItemList[id] = ctrl
    local data = self.logData[eIndex]
    if data then
        local str = SociatyMazeModel:GetInstance():ParseLogStr(data)
        ctrl.aortext_name.text = str
        ctrl.aortext_time.text = _G.TimeUtil.GetOfflineTimeDesc(data.value2)
    end
    ctrl.obj_line:SetActiveE(eIndex == #self.logData and 0 or 1)
end

---销毁对象时,析构函数
function SociatyMazeInfoLog:OnDestroy()
end

return SociatyMazeInfoLog
