---@class SociatyMazeEnterView : UIBaseView	中文描述
---@field public go_table SociatyMazeEnterView_GoTable GoTable
local SociatyMazeEnterView = _G.BaseClass("SociatyMazeEnterView", _G.UIBaseView)

function SociatyMazeEnterView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyMazeEnterView:OnCreate()
    self.activityCfg = {}
    for _, v in pairs(_G.ConfigManager.guild_gve_entrance_cfg) do
        _G.table.insert(self.activityCfg, v)
    end
    _G.SortList(
        self.activityCfg,
        function(item)
            return -item.order
        end
    )
    if #self.activityCfg < 3 then
        self.go_table.scrollloophorizontal_item:SetRectTransformSize(800, 606)
    end
    self.go_table.scrollloophorizontal_item:InitItemData(#self.activityCfg, _G.handler(self, self.RefreshList))
    self:AddListener(_G.eSociatyEvent.BeKicked, self.OnBeKicked, self)
    self:AddListener(_G.eSociatyMaze.SociatyMazeSettle, self.OnSociatyMazeSettle, self)
    self:AddListener(_G.eSociatyMaze.SociatyMazeInfo, self.OnSociatyMazeInfo, self)
end

function SociatyMazeEnterView:OnBeKicked(uid)
    if uid == _G.PlayerModel:GetInstance().role_uid then
        self:Close()
    end
end

---已结算-本期时间已结束
function SociatyMazeEnterView:OnSociatyMazeSettle()
    self:Close()
end

---刷新界面
function SociatyMazeEnterView:OnSociatyMazeInfo()
    self.go_table.scrollloophorizontal_item:UpdateAllItem()
end

function SociatyMazeEnterView:RefreshList(index, obj)
    local newIndex = index + 1
    local data = self.activityCfg[newIndex]
    local lock = not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(data.function_id)
    local mazeLockContent = nil
    lock = not data.id == 2
    if not lock or data.id == _G.ScoaityTrialType.SoicatyMaze then
        local level = _G.ConfigManager.discrete_cfg[116111][1][1]
        local isLock, _, content = _G.GlobalConditionManager.CheckConditionArrays(
            { { _G.GlobalConditionManager.ConditionType.guildLv, level } }
        )
        if not isLock then
            lock = true
            mazeLockContent = content
        end
    end
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnclickItem, data.id, lock))
    tb.obj_redpoint:UpdateRedPointItemIDAndParam(data.redpoint_cfg)
    tb.aorrawimage_bg:LoadImage(
        data.tab,
        function(tran)
            if _G.IsNil(tran) then
                return
            end
            tran:SetNativeSize()
        end
    )
    tb.aorrawimage_icon:LoadImage(
        data.image_sub,
        function(tran)
            if _G.IsNil(tran) then
                return
            end
            tran:SetNativeSize()
        end
    )
    --tb.aorimage_namebg.SpriteName = data.base
    tb.obj_Lock:SetActiveE(lock and 1 or 0)
    tb.obj_Open:SetActiveE(lock and 0 or 1)
    tb.aortext_Name.text = _G.GetLangPackValue(data.name)
    tb.aortext_Name.color = require("CardInfoManager").GetColorFromRGB("fff2b7")
    tb.aortext_LastTxt.text = _G.GetLangPackValue(data.number)
    tb.aortext_LastTxt.color = require("CardInfoManager").GetColorFromRGB("76694c")
    if data.id == _G.ScoaityTrialType.WitchTrail then
        tb.aortext_last.text = require("SociatyModel"):GetInstance():GetTrailTimes(data.id)
    elseif data.id == _G.ScoaityTrialType.SoicatyMaze then
        tb.aortext_last.text = require("SociatyMazeBattleModel"):GetInstance():GetRestore()
    end
    tb.aorrawimage_bg:SetGray(lock)
    tb.aorrawimage_icon:SetGray(lock)
    tb.aorimage_namebg:SetGray(lock)
    tb.aortext_test:SetActiveE(data.id == _G.ScoaityTrialType.SoicatyMaze and 1 or 0)
    if lock then
        tb.aortext_Name.color = require("CardInfoManager").GetColorFromRGB("414141")
        local lockStr = _G.FunctionManager:GetInstance():GetTipsStr(data.function_id)
        if data.id == _G.ScoaityTrialType.SoicatyMaze then
            if mazeLockContent then
                tb.aortext_condition.text = mazeLockContent
            else
                local funopenCfg = _G.ConfigManager.function_open_cfg[data.function_id]
                local _, lockType = _G.GlobalConditionManager.CheckConditionByArray(funopenCfg.condition_type)
                if lockType and lockType[1] and lockType[1] == 54 then
                    local t = _G.TimeUtil.TranslateSecond(
                        lockType[2] * 86400 + _G.PlayerModel:GetInstance():GetBattleOpenTime() -
                        _G.TimeUtil.GetServerUnixTime()
                    )
                    tb.aortext_condition.text = _G.GetLangPackValue(90028300082, _G.Mathf.Max(t.day, 1))
                else
                    tb.aortext_condition.text = lockStr
                end
            end
        else
            tb.aortext_condition.text = lockStr
        end
    else
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[data.effect],
            tb.obj_Open,
            function(obj)
                if self:IsNil() then
                    _G.DestroyObject(obj)
                end
            end
        )
        tb.aorimage_lastBg:SetActiveE(1)
        if data.id == _G.ScoaityTrialType.SoicatyMaze then
            local openFunction = true
            if require("SociatyMazeModel"):GetInstance():CheckIsSettle() then
                tb.aortext_LastTxt.text = _G.GetLangPackValue(90032100030)
                openFunction = false
            else
                local startTime = require("SociatyMazeModel"):GetInstance():GetTime()
                if not startTime or startTime <= 0 then
                    ---未拉到数据
                    tb.aortext_LastTxt.text = _G.GetLangPackValue(90032700071)
                    openFunction = false
                end
            end
            if not openFunction then
                tb.aorimage_lastBg:SetActiveE(0)
                tb.aortext_last.text = ""
            end
        end
    end

    tb.obj_Award:RemoveAllChildren()
    for _, v in pairs(data.precious_preview) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            v,
            tb.obj_Award,
            function(tran)
                tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
        )
    end
end

function SociatyMazeEnterView:OnclickItem(_, _, type, isLock)
    if type == _G.ScoaityTrialType.WitchTrail then
        ---魔女试炼
        if not isLock then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyWitchTrialsView.Name)
        else
            local _, tipsId, content =
                _G.GlobalConditionManager.CheckConditionPass(5, _G.ConfigManager.discrete_cfg[102605])
            _G.PopWindowManager:GetInstance():ShowAllTips(tipsId, content)
        end
    elseif type == _G.ScoaityTrialType.SoicatyMaze then
        ---公会迷宫
        if isLock then
            return
        end
        local startTime = require("SociatyMazeModel"):GetInstance():GetTime()
        if not startTime or startTime <= 0 then
            ---未拉到数据
            return
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMazeMainView.Name)
    end
    self:Close()
end

---界面的销毁函数
function SociatyMazeEnterView:OnDestroy()
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
function SociatyMazeEnterView:OnClickBtn(go)
    if go == self.go_table.aorbtn_Bg then
        self:Close()
    end
end

return SociatyMazeEnterView
