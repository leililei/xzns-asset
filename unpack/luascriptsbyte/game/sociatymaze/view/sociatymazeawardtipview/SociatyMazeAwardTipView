---@class SociatyMazeAwardTipView : UIBaseView	中文描述
---@field public go_table SociatyMazeAwardTipView_GoTable GoTable
local SociatyMazeAwardTipView = _G.BaseClass("SociatyMazeAwardTipView", _G.UIBaseView)

function SociatyMazeAwardTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyMazeAwardTipView:OnCreate(data, closeCallBack)
    self.data = data
    self.closeCallBack = closeCallBack
    self.battleModel = require("SociatyMazeBattleModel"):GetInstance()
    local titleTable = {
        [self.battleModel.pointType.Goddess] = 90032700001,
        [self.battleModel.pointType.Box] = 90032700013,
        [self.battleModel.pointType.Weaponry] = 90032700003
    }
    local tipTable = {
        [self.battleModel.pointType.Goddess] = 90032700002,
        [self.battleModel.pointType.Box] = 90032700014,
        [self.battleModel.pointType.Weaponry] = 90032700004
    }
    self.go_table.obj_box:SetActiveE(self.battleModel.pointType.Box == data.type and 1 or 0)
    self.go_table.obj_goddess:SetActiveE(self.battleModel.pointType.Box ~= data.type and 1 or 0)
    self.go_table.aortext_title.text = _G.GetLangPackValue(titleTable[data.type])
    self.go_table.aortext_tip.text = _G.GetLangPackValue(tipTable[data.type])
    if data.type ~= self.battleModel.pointType.Box then
        local iconList = {
            [self.battleModel.pointType.Weaponry] = "ImagesH5/hSociatyMaze/ui_box1",
            [self.battleModel.pointType.Goddess] = "ImagesH5/hSociatyMaze/ui_aymg_zjm_tlsjjxtc_icon_shixiang"
        }
        self.go_table.aorrawimage_icon:LoadImage(
            iconList[data.type],
            function(image)
                if self:IsNil() then
                    return
                end
                image:SetNativeSize()
            end
        )
    end
    local showBattle = {
        self.battleModel.pointType.Weaponry
    }
    self.isShowBattle = _G.table.indexof(showBattle, data.type) ~= false
    self.go_table.aorbtn_get:SetActiveE(self.isShowBattle and 0 or 1)
    self.go_table.aorbtn_battle:SetActiveE(self.isShowBattle and 1 or 0)
    self:AddListener(_G.eSociatyMaze.SociatyMazeChange, self.OnSociatyMazeChange, self)
    self:AddListener(_G.eSociatyEvent.BeKicked, self.OnBeKicked, self)
    self:AddListener(_G.eSociatyMaze.SociatyMazeSettle, self.OnSociatyMazeSettle, self)
end

---被踢出公会
function SociatyMazeAwardTipView:OnBeKicked(uid)
    if uid == _G.PlayerModel:GetInstance().role_uid then
        self:Close()
    end
end

---已结算-本期时间已结束
function SociatyMazeAwardTipView:OnSociatyMazeSettle()
    self:Close()
end

function SociatyMazeAwardTipView:OnSociatyMazeChange(cells)
    if self:IsNil() then
        return
    end
    if cells then
        for _, v in pairs(cells) do
            if v.uid == self.data.uid and self.isShowBattle and v.point and v.point <= 0 then
                ---当boss已死亡
                _G.PopWindowManager:GetInstance():ShowAllTips(1010108)
                self:Close()
                return
            end
        end
    end
end

---按钮点击事件在这里派发
function SociatyMazeAwardTipView:OnClickBtn(go)
    if go == self.go_table.aorbtn_Bg or go == self.go_table.aorbtn_Close then
        self:Close()
    elseif go == self.go_table.aorbtn_get then
        if self.data.type == self.battleModel.pointType.Goddess and self.battleModel:GetRestore() >= self.battleModel:GetMaxRestore() then
            _G.PopWindowManager:GetInstance():ShowAllTips(1010106)
            return
        end
        self.battleModel:TriggerEvent(
            self.data.uid,
            self.data.type,
            function()
                self:Close()
                if self.closeCallBack then
                    self.closeCallBack()
                end
            end
        )
    elseif go == self.go_table.aorbtn_battle then
        if self.battleModel:GetRestore() <= 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(1010102)
            return
        end
        self:Close()
        self.battleModel:Fight(self.data.uid, 1)
    end
end

function SociatyMazeAwardTipView:OnDestroy()
    self:RemoveAllListener()
end

return SociatyMazeAwardTipView
