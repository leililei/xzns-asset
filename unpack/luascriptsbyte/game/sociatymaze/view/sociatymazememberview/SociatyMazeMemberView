local SociatyMazeNet = require("SociatyMazeNet")
---@class SociatyMazeMemberView : UIBaseView	中文描述
---@field public go_table SociatyMazeMemberView_GoTable GoTable
local SociatyMazeMemberView = _G.BaseClass("SociatyMazeMemberView", _G.UIBaseView)

function SociatyMazeMemberView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyMazeMemberView:OnCreate()
    self.go_table.scrollloopvectical_itemList:InitItemData(0, _G.handler(self, self.RefreshItem))
    self.maxRestore = require("SociatyMazeBattleModel"):GetInstance():GetMaxRestore()
    self:InitData()
    self.tiliIcon = require("SociatyMazeModel"):GetInstance():GetRestoreIcon()
end

function SociatyMazeMemberView:InitData()
    self.listData = {}
    self.ItemList = {}
    SociatyMazeNet:GetInstance():GetMemberList(
        function (data)
            self.listData = data.member
            _G.table.sort(self.listData, function (a, b)
                if a.win_points ~= b.win_points then
                    return a.win_points > b.win_points
                end
                if a.is_online ~= b.is_online then
                    if a.is_online == 0 or b.is_online == 0 then
                        return a.is_online == 0
                    else
                        return a.is_online > b.is_online
                    end
                end
                return a.role.power > b.role.power
            end)
            self.go_table.scrollloopvectical_itemList:UpdateCount(#self.listData)
        end
    )
end

function SociatyMazeMemberView:RefreshItem(index, item)
    if index < 0 then
        return
    end
    local id = item:GetInstanceIDE()
    local eIndex = index + 1
    local ctrl = _G.GetAutoGoTable(item)
    -- _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnItemClickBtn, ctrl, eIndex)) 者：玩家名字6个字
    self.ItemList[id] = ctrl
    local data = self.listData[eIndex]
    if data then
        ctrl.aortext_name.text = data.role.name
        ctrl.aortext_state.text = _G.TimeUtil.GetOfflineStateDesc(data.is_online)
        ctrl.aortext_num.text = data.restore .. "/" .. self.maxRestore
        ctrl.aortext_score.text = data.win_points
        ctrl.aortext_power.text = _G.GetLangPackValue(90000000404, _G.GameUtil.NumberToUnitStrFight(data.role.power))
        ctrl.aortext_progress.text = _G.GetLangPackValue(90032700021) .. data.contribute .. "%"
        _G.UIUtils.SetPlayerHeadItemNew(ctrl.obj_HeadItemBase, data.role, 1, true, true, false, function()
            if data.type ~= 1 then
                if data.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                    _G.PopWindowManager:GetInstance():ShowAllTips(620109)
                else
                    _G.SystemSettingManager:GetInstance():OpenView(data.role.uid)
                end
            else
                _G.SystemSettingManager:GetInstance():OpenRobotPlayInfo(data.role.uid, nil, _G.RobotType.Arena)
            end
        end)
        ctrl.aorimage_tili.SpriteName = self.tiliIcon
    end
end

---界面的销毁函数
function SociatyMazeMemberView:OnDestroy()
end

---按钮点击事件在这里派发
function SociatyMazeMemberView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

return SociatyMazeMemberView