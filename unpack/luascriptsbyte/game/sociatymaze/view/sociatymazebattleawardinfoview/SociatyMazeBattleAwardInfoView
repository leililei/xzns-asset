---@class SociatyMazeBattleAwardInfoView : UIBaseView	中文描述
---@field public go_table SociatyMazeBattleAwardInfoView_GoTable GoTable
local SociatyMazeBattleAwardInfoView = _G.BaseClass("SociatyMazeBattleAwardInfoView", _G.UIBaseView)

function SociatyMazeBattleAwardInfoView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param uid number 关卡uid
---@param type number 关卡类型
---@param selectIndex number 关卡难度
function SociatyMazeBattleAwardInfoView:OnCreate(uid, type, selectIndex)
    self.uid = uid
    self.type = type
    self.selectIndex = selectIndex
    self.itemTransDic = {}
    self:InitView()
end

---初始化窗口
function SociatyMazeBattleAwardInfoView:InitView()
    ---基础奖励
    self.baseAward = {}
    ---掉落奖励
    self.dropAward = {}
    self.dropCfg = _G.ConfigManager.drop_cfg[_G.ConfigManager.guild_gve_cfg[self.type].drop[self.selectIndex]]
    -- 基础奖励
    self:InitBaseAward()
    local item, go
    for _, v in ipairs(self.baseAward) do
        item = _G.InstantiateObject(self.go_table.obj_node, self.go_table.obj_awards)
        go = _G.GetAutoGoTable(item)
        if _G.ConfigManager.item_cfg[v[1]] then
            go.aortext_name.text = _G.GetLangPackValue(_G.ConfigManager.item_cfg[v[1]].Name)
        end
        require "BaseAwardNewItem".New(item):ShowWithID(v)
    end

    -- 掉落奖励
    self:InitDropAward()
    self.go_table.scrollloophorizontal_awards:InitItemData(#self.dropAward, _G.handler(self, self.RefreshItem))
end

---初始化基础奖励
function SociatyMazeBattleAwardInfoView:InitBaseAward()
    if not self.dropCfg then
        if _G.AppSetting.DEBUG then
            _G.LogError("战斗掉落为配置读取为空")
        end
        return
    end
    if self.dropCfg.fixed_drop then
        _G.table.move(self.dropCfg.fixed_drop, 1, #self.dropCfg.fixed_drop, #self.baseAward + 1, self.baseAward)
    end
end

---初始化掉落奖励
function SociatyMazeBattleAwardInfoView:InitDropAward()
    if not self.dropCfg then
        if _G.AppSetting.DEBUG then
            _G.LogError("战斗掉落为配置读取为空")
        end
        return
    end
    if self.dropCfg.content1 then
        _G.table.move(self.dropCfg.content1, 1, #self.dropCfg.content1, #self.dropAward + 1, self.dropAward)
    end
    if self.dropCfg.content2 then
        _G.table.move(self.dropCfg.content2, 1, #self.dropCfg.content2, #self.dropAward + 1, self.dropAward)
    end
    -- 按品质排序
    _G.SortList(self.dropAward, function(a)
        return _G.StorageManager:GetInstance():GetItemQuality(a[1]), a[1]
    end)
end

---掉落奖励道具刷新
function SociatyMazeBattleAwardInfoView:RefreshItem(index, obj)
    index = index + 1
    obj:SetName(index)
    local instanceID = obj:GetInstanceIDE()
    local type = self:GetItemType(self.dropAward[index][1])
    if not self.itemTransDic[instanceID] or not self.itemTransDic[instanceID][type] then
        if not self.itemTransDic[instanceID] then
            self.itemTransDic[instanceID] = {}
        end
        _G.ItemFactory:GetInstance():GetItemCard(
            type,
            obj,
            function(item)
                self.itemTransDic[instanceID][type] = item
                self.itemTransDic[instanceID][type]:Show(
                    self.dropAward[index][1],
                    function()
                        require("CommonTipManager"):GetInstance():OpenTip(obj, self.dropAward[index][1])
                    end)
            end
        )
    else
        self.itemTransDic[instanceID][type]:Show(
            self.dropAward[index][1],
            function()
                require("CommonTipManager"):GetInstance():OpenTip(obj, self.dropAward[index][1])
            end)
    end

    for i, v in pairs(self.itemTransDic[instanceID]) do
        if i == type then
            v.gameObject:SetActiveE(1)
        else
            v.gameObject:SetActiveE(0)
        end
    end
end

---获得item类型
function SociatyMazeBattleAwardInfoView:GetItemType(sid)
    local storageType = _G.StorageManager:GetInstance():CheckSidType(sid)
    if storageType == _G.StorageType.Equipment then
        -- 装备
        return _G.ItemFactory.itemType.ItemEquipmentBase
    elseif storageType == _G.StorageType.Decoration then
        -- 饰品/刻魂
        return _G.ItemFactory.itemType.ItemDecorationBase
    elseif storageType == _G.StorageType.Card then
        -- 卡牌碎片
        return _G.ItemFactory.itemType.ItemDebrisBase
    elseif storageType == _G.StorageType.Artifact then
        -- 神器
        return _G.ItemFactory.itemType.ItemArtifactBase
    elseif storageType == _G.StorageType.Spiritual then
        -- 灵契
        return _G.ItemFactory.itemType.ItemSpiritualBase
    else
        -- 基础item
        return _G.ItemFactory.itemType.ItemBaseWithCount
    end
end

---界面的销毁函数
function SociatyMazeBattleAwardInfoView:OnDestroy()
end

---按钮点击事件在这里派发
function SociatyMazeBattleAwardInfoView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_closeview then
        self:Close()
    end
end

return SociatyMazeBattleAwardInfoView
