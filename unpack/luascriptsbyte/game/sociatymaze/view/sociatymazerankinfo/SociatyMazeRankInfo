local SociatyMazeNet = require("SociatyMazeNet")
local SociatyMazeModel = require("SociatyMazeModel")
---@class SociatyMazeRankInfo : Component	中文描述
local SociatyMazeRankInfo = _G.BaseClass("SociatyMazeRankInfo", _G.Component)

local IconPath = {
    [1] = "0ui_icon_diyi",
    [2] = "0ui_icon_dier",
    [3] = "0ui_icon_disan"
}

---创建对象时,入口构造函数
function SociatyMazeRankInfo:OnCreate()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self.sysRankIds = _G.ConfigManager.discrete_cfg[116133][1]
    self.go_table.scrollloopvectical_itemList:InitItemData(0, _G.handler(self, self.RefreshItem))
end

function SociatyMazeRankInfo:Show()
    self:InitData()
    SociatyMazeNet:GetInstance():GetGuildRank(
        function (data)
            self.rankData = data.guilds or {}
            for i = 1, 3 do
                self:ShowTopRank(i)
            end
            self.go_table.scrollloopvectical_itemList:UpdateCount(#self.rankData)
            local uid = require("SociatyModel"):GetInstance().SociatySelf.Uid
            local index = 0
            local num = SociatyMazeModel:GetInstance():GetWinPoint()
            local score = SociatyMazeModel:GetInstance():GetPassTime()
            for i, v in ipairs(self.rankData) do
                if v.uid == uid then
                    index = i
                    num = v.win_point
                    score = v.pass_time
                end
            end
            self:InitPlayer(index, num, score)
            self.go_table.obj_IsNil:SetActiveE(#self.rankData > 0 and 0 or 1)
        end
    )
end

function SociatyMazeRankInfo:InitData()
    self.rankData = {}
    self.ItemList = {}
end

function SociatyMazeRankInfo:RefreshItem(index, item)
    if index < 0 then
        return
    end
    local id = item:GetInstanceIDE()
    local eIndex = index + 1
    local ctrl = _G.GetAutoGoTable(item)
    _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnItemClickBtn, ctrl, eIndex))
    self.ItemList[id] = ctrl
    self:RefreshItemShow(ctrl, eIndex)
end

function SociatyMazeRankInfo:RefreshItemShow(ctrl, index)
    ctrl.index = index
    local data = self.rankData[index]
    if data then
        ctrl.obj_rankBg2:SetActiveE(index <= 3 and 0 or 1)
        if index <= 3 then
            ctrl.aorimage_rank:SetActiveE(1)
            ctrl.obj_rankBg2:SetActiveE(0)
            for i = 1, 3 do
                ctrl["aortext_rankNum" .. i]:SetActiveE(i == index and 1 or 0)
            end
            ctrl.aorimage_rankBg:SetRectTransformSize(644, 116)
            ctrl.aorimage_rankBg.SpriteName = "ui_diban" .. index
            ctrl.aorimage_rank.SpriteName = IconPath[index]
        else
            ctrl.aorimage_rank:SetActiveE(0)
            ctrl.obj_rankBg2:SetActiveE(1)
            ctrl.aortext_rankNum.text = index
            ctrl.aorimage_rankBg.SpriteName = "TY_img_kuang"
            ctrl.aorimage_rankBg:SetRectTransformSize(633, 108)
        end
        ctrl.aortext_name.text = data.name
        ctrl.aortext_power.text = _G.GetLangPackValue(90031500001)..data.level
        ctrl.aortext_num.text = _G.UIUtils.NumberToUnitStrBag(data.win_point)
        local str = data.pass_time == 0 and _G.GetLangPackValue(90032700076) or self:GetTime(data.pass_time)
        ctrl.aortext_score.text = str --_G.GetLangPackValue(90032700019, str)
        ctrl.aorrawimage_icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.banner].portrait)
        self:ShowAwardRank(ctrl, self.go_table.obj_Award, index)
        ctrl.uid = data.uid
    end
end

---获取时间
function SociatyMazeRankInfo:GetTime(v)
    local time = _G.TimeUtil.GetDateTime(v)
    local text =
                _G.string.format(
                    "%s-%s-%s %02d:%02d:%02d",
                    time.year,
                    time.month,
                    time.day,
                    time.hour,
                    time.minute,
                    time.second
                )
    return text
end


function SociatyMazeRankInfo:InitPlayer(index, num, score)
    ---@type _obj_Rank._obj_rankItem_GoTable
    local ctrl = _G.GetAutoGoTable(self.go_table.obj_player)
    if index == 0 then
        ctrl.aortext_rankNum.text = _G.GetLangPackValue(90022900040)
    else
        ctrl.aortext_rankNum.text = index
    end
    local data = require("SociatyModel"):GetInstance().SociatySelf
    ctrl.aortext_name.text = data.Name
    ctrl.aortext_power.text =  _G.GetLangPackValue(90031500001)..data:GetMasterBuildLevel()
    ctrl.aortext_num.text = _G.UIUtils.NumberToUnitStrBag(num)
    local str = score == 0 and _G.GetLangPackValue(90032700076) or self:GetTime(score)
    ctrl.aortext_score.text = str --_G.GetLangPackValue(90032700019, str)
    ctrl.aorrawimage_icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.Banner].portrait)
    self:ShowAwardRank(ctrl, self.go_table.obj_Award, index)
end

function SociatyMazeRankInfo:GetRankAward(index)
    local cfg
    if self.finalCfg == nil then
        self.finalCfg = false
        local maxRank = 0
        for i, v in pairs(self.sysRankIds) do
            cfg = _G.ConfigManager.arena_rank_cfg[v]
            if cfg then
                if maxRank < cfg.max_rank then
                    self.finalCfg = cfg
                    maxRank = cfg.max_rank
                end
            end
        end
    end
    if index > 0 then
        for _, v in pairs(self.sysRankIds) do
            cfg = _G.ConfigManager.arena_rank_cfg[v]
            if cfg then
                if index >= cfg.min_rank and index <= cfg.max_rank then
                    local awards = {}
                    _G.table.insertto(awards, self:FindManyItemByType(cfg.reward_appearance))
                    _G.table.insertto(awards, cfg.reward_daily)
                    return awards
                end
            end
        end
    end
    local awards = {}
    if self.finalCfg then
        _G.table.insertto(awards, self:FindManyItemByType(self.finalCfg.reward_appearance))
        _G.table.insertto(awards, self.finalCfg.reward_daily)
    end
    return awards
end

---通过类型查找物品
---@param list number[][]
---@return number[][]
function SociatyMazeRankInfo:FindManyItemByType(list)
    if not list or #list == 0 then
        return {}
    end
    --TODO: 循环查找效率太慢, 考虑字典缓存!!!
    local results = {}
    for _, v in pairs(list) do
        local type, sid = table.unpack(v)
        sid = tostring(sid)
        for _, item in pairs(_G.ConfigManager.item_cfg) do
            if item.UseType == type and item.UseParameter[1][1] == sid then
                _G.table.insert(results, {item.ID, 1})
                break
            end
        end
    end
    return results
end

---添加排行奖励显示
function SociatyMazeRankInfo:ShowAwardRank(tb, obj, index)
    local award = self:GetRankAward(index)
    if not tb.list then
        tb.list = {}
    end
    local count = #tb.list
    local count2 = #award
    for i = 1, count do
        if i <= count2 then
            tb.list[i]:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(award[i]))
            _G.GameUtil.SetActiveByCondition(tb.list[i].gameObject, true)
        else
            _G.GameUtil.SetActiveByCondition(tb.list[i].gameObject, false)
        end
    end
    if count < count2 then
        for i = count + 1, count2 do
            local obj2 = _G.InstantiateObject(obj)
            obj2:SetParentE(tb.trans_Content)
            local item = require "BaseAwardNewItem".New(obj2, nil, nil, obj2:GetChildE(0))
            tb.list[i] = item
            local data = award[i]
            if data.type then
                data = data.type
            end
            item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
        end
    end
end

---显示前三名公会信息
function SociatyMazeRankInfo:ShowTopRank(rank)
    local topItem = _G.GetAutoGoTable(self.go_table["obj_info" .. rank])
    local data = self.rankData[rank]
    if data == nil then
        topItem.obj_score:SetActiveE(0)
        return
    end
    topItem.aortext_name.text = data.name
    topItem.obj_score:SetActiveE(1)
    topItem.obj_Banner:SetActiveE(1)
    local str = data.pass_time == 0 and _G.GetLangPackValue(90032700076) or self:GetTime(data.pass_time)
    topItem.aortext_score.text = str
    topItem.aortext_num.text = data.win_point
    topItem.aorrawimage_Icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.banner].portrait)
end

function SociatyMazeRankInfo:OnItemClickBtn(go, isOn, tb)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyInfoPreviewView.Name, tb.uid)
end

---销毁对象时,析构函数
function SociatyMazeRankInfo:OnDestroy()
end

return SociatyMazeRankInfo
