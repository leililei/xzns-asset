---数据变化推送
function SociatyMazeMainView:OnSociatyMazeChange(cells)
    local bossChange = false
    for _, data in pairs(cells) do
        self.mapPointData[self.battleModel:GetPointIndexByUid(data.uid)] = data
        if data.type == self.battleModel.pointType.BigBoss then
            self.bigBossData = data
            bossChange = true
        elseif data.type == self.battleModel.pointType.SmallBoss then
            for i, v in ipairs(self.smallBossData) do
                if v.uid == data.uid then
                    self.smallBossData[i] = data
                    bossChange = true
                    break
                end
            end
        end
        if self.mapPointItemList[data.uid] then
            self:SetPointInfo(self.mapPointItemList[data.uid])
            self:RefreshAroundPoint(data)
        end
    end
    if bossChange then
        ---有boss数据变更时，刷新boss进度和boss进度预览
        self:InitBossProgress()
        if self.go_table.obj_bossInfo:GetActiveSelf() == 1 then
            self:ShowBossProgress()
        end
    end
end

---数据拉取（主要是断线重连）
function SociatyMazeMainView:OnSociatyMazeInfo()
    self.battleModel:GetMapInfo(
        function(mapPointData, smallBossData, bigBossData)
            self:RefreshMapPoint(mapPointData, smallBossData, bigBossData)
            if self.go_table.obj_bossInfo:GetActiveSelf() == 1 then
                self:ShowBossProgress()
            end
        end
    )
    self:InitRestore()
end

