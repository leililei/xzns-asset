---初始化boss进度
function SociatyMazeMainView:InitBossProgress()
    if not self.bossPointList then
        self.bossPointList = {}
    end
    _G.SortList(
        self.smallBossData,
        function(data)
            return data.status
        end
    )
    for i = 1, 4 do
        local tb = self.bossPointList[i]
        if not tb then
            tb = _G.GetAutoGoTable(self.go_table["obj_pointDetail" .. i])
            self.bossPointList[i] = tb
        end
        if i <= 3 then
            local point = self.smallBossData[i] and self.smallBossData[i].point or 0
            tb.obj_Pass:SetActiveE(point <= 0 and 1 or 0)
            tb.obj_boss:SetActiveE(point > 0 and 1 or 0)
        else
            local point = self.bigBossData and self.bigBossData.point or 0
            tb.obj_Pass:SetActiveE(point <= 0 and 1 or 0)
            tb.obj_boss:SetActiveE(point > 0 and 1 or 0)
        end
    end
    if self.bigBossData.point <= 0 then
        self.go_table.aorimage_progress:SetRectTransformSize(378, 22)
    else
        local killBossNum = 0
        for _, v in ipairs(self.smallBossData) do
            if v.point <= 0 then
                killBossNum = killBossNum + 1
            end
        end
        local progressWidth = {0, 108, 225, 378}
        self.go_table.aorimage_progress:SetRectTransformSize(progressWidth[killBossNum], 22)
    end
end

function SociatyMazeMainView:UpdateStateTimer()
    local servertime = _G.TimeUtil.GetServerUnixTime()
    if self.endTime - servertime > 0 then
        self.go_table.slider_level.value = (self.endTime - servertime) / self.durationTime
        self.go_table.aortext_time.text =
            _G.GetLangPackValue(
            90028500004,
            "<color=#96CE51>" .. _G.TimeUtil.GodSpecialGiftForStr(self.endTime - servertime) .. "</color>"
        )
    else
        self:Close()
    end
end

---刷新boss进度
function SociatyMazeMainView:ShowBossProgress()
    self.go_table.obj_bossInfo:SetActiveE(1)
    if not self.bossInfoList then
        self.bossInfoList = {}
    end
    for i = 1, 4 do
        local tb = self.bossInfoList[i]
        if not tb then
            tb =
                _G.GetAutoGoTable(self.go_table["obj_bossInfoItem" .. i], _G.handlerbind(self, self.OnClickBossItem, i))
            self.bossInfoList[i] = tb
        end
        if i <= 3 then
            local data = self.smallBossData[i] or {}
            local status = data.status or 0
            local type = data.type or self.battleModel.pointType.SmallBoss
            local config = _G.ConfigManager.guild_gve_cfg[type]
            if status == 0 then
                tb.aortext_name.text = _G.GetLangPackValue(config.name, "???")
                tb.aortext_status.text = "<color=#949494>" .. _G.GetLangPackValue(90032700059) .. "</color>"
            else
                tb.aortext_status.text =
                    status == 1 and "<color=#e0c369>" .. _G.GetLangPackValue(90032700058) .. "</color>" or
                    _G.GetLangPackValue(90032700057)
                local cardConfig = self.battleModel:GetCardCfg(data)
                if cardConfig then
                    tb.aorimage_head.SpriteName = cardConfig and cardConfig.Icon or ""
                    tb.aortext_name.text = _G.GetLangPackValue(90032700036, _G.GetLangPackValue(cardConfig.Name))
                end
            end
        else
            local status = self.bigBossData and self.bigBossData.status or 0
            local type = self.bigBossData.type or self.battleModel.pointType.SmallBoss
            local config = _G.ConfigManager.guild_gve_cfg[type]
            if status == 0 then
                tb.aortext_status.text = "<color=#e0c369>" .. _G.GetLangPackValue(90032700058) .. "</color>"
            else
                tb.aortext_status.text =
                    status == 1 and "<color=#e0c369>" .. _G.GetLangPackValue(90032700058) .. "</color>" or
                    _G.GetLangPackValue(90032700057)
            end
            local cardConfig = self.battleModel:GetCardCfg(self.bigBossData)
            if cardConfig then
                tb.aorimage_head.SpriteName = cardConfig and cardConfig.Icon or ""
                tb.aortext_name.text = _G.GetLangPackValue(90032700039, _G.GetLangPackValue(cardConfig.Name))
            end
        end
    end
end

function SociatyMazeMainView:OnClickBossItem(_, _, i)
    if i <= 3 then
        local data = self.smallBossData[i] or {}
        if data.status == 0 then
            return
        end
        local index = self.battleModel:GetPointIndexByUid(data.uid)
        self.go_table.scrollloopvectical_point:ScrollToIndex(index - 1)
        _G.DelayFrameDo(
            function()
                self:ScrollToItem(data.uid)
            end
        )
    else
        local index = self.battleModel:GetPointIndexByUid(self.bigBossData.uid)
        self.go_table.scrollloopvectical_point:ScrollToIndex(index - 1)
        _G.DelayFrameDo(
            function()
                self:ScrollToItem(self.bigBossData.uid)
            end
        )
    end
end

---设置
function SociatyMazeMainView:ScrollToItem(uid)
    if self:IsNil() then
        return
    end
    if not self.content then
        self.content =
            self.go_table.scrollloopvectical_point:FindE("Viewport/Content"):GetComponentE(
            _G.typeof(_G.CS.UnityEngine.RectTransform)
        )
    end
    local _, y = self.content:GetAnchorPosition()
    local _, column = self.battleModel:GetPointXY(uid)
    self.content:SetAnchorPosition(column <= 3 and 0 or -280, y)
end

function SociatyMazeMainView:OnStartClose()
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
    self.battleModel:Subscribe(0)
    self.super.OnStartClose(self)
end

---关闭标记模式
function SociatyMazeMainView:ShowMarkModel(go, isOn, bol)
    self.markModelOpenBol = bol
    self.go_table.obj_Panel:SetActiveE(bol and 0 or 1)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_tipBg, bol)
end

function SociatyMazeMainView:ShowLog()
    self.logIndex = self.logIndex + 1
    if self.logIndex > SociatyMazeModel:GetInstance().logNum then
        self.logIndex = 1
    end
    local data = SociatyMazeModel:GetInstance():GetSingleLog(self.logIndex)
    if data then
        local str = SociatyMazeModel:GetInstance():ParseLogStr(data)
        _G.PopWindowManager:GetInstance():ShowAllTips(1010128, str)
    end
end

---界面的销毁函数
function SociatyMazeMainView:OnDestroy()
    self:RemoveAllListener()
    if self.Sequence then
        self.Sequence:Kill()
        self.Sequence = nil
    end
    if self.stageTimer then
        self.stageTimer:Stop()
        self.stageTimer = nil
    end
    if self.logTimer then
        self.logTimer:Stop()
        self.logTimer = nil
    end
    if self.mapPointTimer then
        for _, v in pairs(self.mapPointTimer) do
            v:Stop()
        end
        self.mapPointTimer = nil
    end
    self.mapPointList = nil
    if self.delayCor then
        _G.coroutine.stopwaiting(self.delayCor)
        self.delayCor = nil
    end
end

---按钮点击事件在这里派发
function SociatyMazeMainView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        if self.markModelOpenBol then
            self:ShowMarkModel(nil, nil, false)
        else
            self:Close()
        end
    elseif go == self.go_table.aorbtn_help then
        ---打开玩法说明页面
        -- _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 152)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMazeHelpView.Name)
    elseif go == self.go_table.aorbtn_rank or go == self.go_table.aorbtn_mvp then
        ---排行榜
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMazeRankView.Name)
    elseif go == self.go_table.aorbtn_info then
        ---信息
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMazeInfoView.Name)
    elseif go == self.go_table.aorbtn_weaponry then
        ---遗物
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMazeRelicView.Name)
    elseif go == self.go_table.aorbtn_award then
        ---奖励
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMazePassAwardView.Name)
    elseif go == self.go_table.aorbtn_member then
        --成员
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMazeMemberView.Name)
    elseif go == self.go_table.aorbtn_bossInfo then
        self:ShowBossProgress()
    elseif go == self.go_table.aorbtn_closeBossInfo then
        self.go_table.obj_bossInfo:SetActiveE(0)
    elseif go == self.go_table.aorbtn_time then
        ---倍率
        local cfg = _G.ConfigManager.discrete_cfg[116106] or {}
        _G.PopWindowManager:GetInstance():ShowAllTips(
            1010119,
            nil,
            nil,
            nil,
            nil,
            nil,
            #cfg - self.mazeModel.stage + 1,
            self.mazeModel:GetStageBonus()
        )
    elseif go == self.go_table.aorbtn_restore then
        ---体力
        _G.PopWindowManager:GetInstance():ShowAllTips(1010120)
    elseif go == self.go_table.aorbtn_level then
        ---阶段
        _G.PopWindowManager:GetInstance():ShowAllTips(1010121)
    elseif go == self.go_table.aorbtn_mark then
        ---标记模式
        if self.markModelOpenBol then
            self:ShowMarkModel(nil, nil, false)
        else
            self:ShowMarkModel(nil, nil, true)
        end
    elseif go == self.go_table.aorbtn_detail then
        ---情报
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WorldBossIntroduceView.Name, 213, nil, true)
    end
end

return SociatyMazeMainView
