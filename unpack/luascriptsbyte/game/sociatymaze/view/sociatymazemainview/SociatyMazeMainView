---刷新地图上的点位
---@param datas guild_maze.s2c_maze_cell
function SociatyMazeMainView:RefreshMapPoint(mapPointData, smallBossData, bigBossData)
    if self:IsNil() then
        return
    end
    self.mapPointData = mapPointData or {}
    self.smallBossData = smallBossData or {}
    self.bigBossData = bigBossData or {}
    self.smallBossPoint = {}
    for _, v in pairs(self.smallBossData) do
        _G.table.insert(self.smallBossPoint, v.uid)
    end
    _G.SortList(
        self.smallBossPoint,
        function(data)
            return data
        end
    )
    if not self.pointListView then
        self.isInitListView = true
        self.mapSize = self.battleModel:GetMapSize()
        self.go_table.scrollloopvectical_point:InitItemData(self.mapSize, _G.handler(self, self.OnRefreshMapPointItem))
        self.pointListView = self.go_table.scrollloopvectical_point
        self.isInitListView = false
    else
        self.pointListView:UpdateAllItem()
    end
    self.delayCor =
        _G.DelayFrameDo(
        function()
            self.go_table.scrollloopvectical_point:ScrollToBottom()
            self.battleModel:Subscribe(1)

            ---初始化boss动画
            self:InitBossAnim()
        end
    )
    self:InitBossProgress()
end

function SociatyMazeMainView:InitBossAnim()
    local animStatus = _G.PlayerPrefsManager.GetInt("SociatyMazeBossAnim_", 0)
    if animStatus == 0 then
        if not self.content then
            self.content =
                self.go_table.scrollloopvectical_point:FindE("Viewport/Content"):GetComponentE(
                _G.typeof(_G.CS.UnityEngine.RectTransform)
            )
        end
        self.Sequence = _G.DOTween:Sequence()
        self.Sequence:SetAutoKill(true)
        self.Sequence:Append(
            _G.DOTween.To(
                function(value)
                end,
                0,
                1,
                0.3
            )
        )
        self.Sequence:Append(
            self.content:DOLocalMoveY(0, 0.3):SetEase(_G.CS.DG.Tweening.Ease.Linear):OnComplete(
                function()
                    if self:IsNil() then
                        return
                    end

                    _G.PlayerPrefsManager.SetInt("SociatyMazeBossAnim_", 1)
                    local itemGoTable = self.mapPointItemList[self.bigBossData.uid]
                    itemGoTable.obj_spineEffect:DOLocalMoveY(-150, 0.1):SetEase(_G.CS.DG.Tweening.Ease.Linear)
                    _G.UIUtils.LoadEffectByCfg(
                        ui_effect_cfg.bosscome_effect,
                        itemGoTable.obj_spineEffect,
                        function(effect)
                            if self:IsNil() then
                                return
                            end
                            _G.DelayDo(
                                1,
                                function()
                                    if self:IsNil() then
                                        return
                                    end
                                    _G.Events:GetInstance():AddListener(
                                        _G.eUIManagerStatus.OnUIClosed,
                                        self.OnUIClosed,
                                        self
                                    )
                                    _G.UIManager:GetInstance():OpenWindow(
                                        _G.ConfigManager.ui_cfg.SociatyMazeHelpView.Name
                                    )
                                end
                            )
                        end
                    )
                end
            )
        )
    end
end

function SociatyMazeMainView:OnUIClosed(name)
    if name == _G.ConfigManager.ui_cfg.SociatyMazeHelpView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
        self.go_table.scrollloopvectical_point:ScrollToBottom()
    end
end

function SociatyMazeMainView:OnRefreshMapPointItem(index, obj)
    local ins = obj:GetInstanceIDE()
    local itemGoTable = self.mapPointList[ins]
    if not itemGoTable then
        itemGoTable = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickPointItem, itemGoTable))
        self.mapPointList[ins] = itemGoTable
    end
    itemGoTable.index = index + 1
    itemGoTable.ins = ins

    local data = self.mapPointData[index + 1]
    if data then
        self.mapPointItemList[data.uid] = itemGoTable
        itemGoTable.gameObject:SetName(data.uid)
        itemGoTable.aorimage_firstpoint:SetActiveE(data.type == 113 and 1 or 0)
    end
    if not self.insDic then
        self.insDic = {}
    end
    self.insDic[ins] = index
    local num = 1
    for _, v in pairs(self.insDic) do
        if v < index then
            num = num + 1
        end
    end
    obj:SetSiblingIndexE(num)
    self:SetPointInfo(itemGoTable)
end

