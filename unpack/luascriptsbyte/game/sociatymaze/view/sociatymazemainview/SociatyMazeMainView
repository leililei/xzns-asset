---检测路径
function SociatyMazeMainView:CheckRouter(data)
    if not data then
        return false
    end
    if self:CheckPoinIsPass(data) then
        ---格子状态是通关或被点击过的状态
        return true
    end
    ---检测格子周围是否有通过的格子
    if
        data.type == self.battleModel.pointType.BigBoss or data.type == self.battleModel.pointType.SmallBoss or
            data.type == self.battleModel.pointType.Gift
     then
        if self:CheckBigPointIsPass(data) then
            return true
        end
    else
        local x, y = self.battleModel:GetPointXY(data.uid)
        local aroundPoint = self:GetSmallAroundPoint(x, y)
        for _, v in ipairs(aroundPoint) do
            if self.mapPointData[v] and self:CheckPointPass(self.mapPointData[v]) then
                return true
            end
        end
    end
    return false
end

---检测格子是否是通路状态
function SociatyMazeMainView:CheckPoinIsPass(aroundData)
    if aroundData.type == self.battleModel.pointType.BrithPoint then
        return true
    end

    if
        _G.table.indexof(self.monsterType, aroundData.type) or aroundData.type == self.battleModel.pointType.BigBoss or
            aroundData.type == self.battleModel.pointType.SmallBoss or
            aroundData.type == self.battleModel.pointType.Weaponry
     then
        ---战斗格子打完才通路
        return aroundData.status == 2
    end

    if
        aroundData.type == self.battleModel.pointType.Goddess or aroundData.type == self.battleModel.pointType.Box or
            aroundData.type == self.battleModel.pointType.Gift
     then
        ---旁边不是大格子占位点
        return aroundData.status == 1
    end

    return false
end

---旁边格子是否已连通
function SociatyMazeMainView:CheckPointPass(aroundData)
    if self:CheckPoinIsPass(aroundData) then
        return true
    end

    if aroundData.type == self.battleModel.pointType.BigPointEmpty then
        ---旁边是大格子占位点,需要检查对应的大格子状态是否已探索
        local index = self.battleModel:GetPointIndexByUid(aroundData.mapping_uid)
        local data = self.mapPointData[index]
        if data then
            if data.type == self.battleModel.pointType.Gift then
                return data.status == 1
            end
            return data.status == 2
        end
    end

    return false
end

---获取大格子是否通路
function SociatyMazeMainView:CheckBigPointIsPass(clickData)
    local x, y = self.battleModel:GetPointXY(clickData.uid)
    local aroundPoint = self:GetBigAroundPoint(x, y)
    for _, v in ipairs(aroundPoint) do
        local data = self.mapPointData[v]
        if data and self:CheckPoinIsPass(data) then
            return true
        end
    end

    return false
end

---大格子周围的点位
function SociatyMazeMainView:GetBigAroundPoint(x, y)
    local aroundPoint = {}
    if y > 1 then
        _G.table.insert(aroundPoint, self.battleModel:GetPointIndexByXY(x, y - 1))
        if x > 1 then
            _G.table.insert(aroundPoint, self.battleModel:GetPointIndexByXY(x - 1, y - 1))
        end
    end
    if x < self.battleModel.mapWidthPoint then
        _G.table.insert(aroundPoint, self.battleModel:GetPointIndexByXY(x + 1, y))
        if y < self.battleModel.mapHeightPoint then
            _G.table.insert(aroundPoint, self.battleModel:GetPointIndexByXY(x + 1, y + 1))
        end
    end
    if x - 2 > 0 then
        _G.table.insert(aroundPoint, self.battleModel:GetPointIndexByXY(x - 2, y))
        if y < self.battleModel.mapHeightPoint then
            _G.table.insert(aroundPoint, self.battleModel:GetPointIndexByXY(x - 2, y + 1))
        end
    end
    if y + 2 <= self.battleModel.mapHeightPoint then
        _G.table.insert(aroundPoint, self.battleModel:GetPointIndexByXY(x, y + 2))
        if y < self.battleModel.mapHeightPoint then
            _G.table.insert(aroundPoint, self.battleModel:GetPointIndexByXY(x - 1, y + 2))
        end
    end
    return aroundPoint
end

---小格子周围的点位
function SociatyMazeMainView:GetSmallAroundPoint(x, y)
    local aroundPoint = {}
    if y < self.battleModel.mapHeightPoint then
        _G.table.insert(aroundPoint, self.battleModel:GetPointIndexByXY(x, y + 1))
    end
    if y > 1 then
        _G.table.insert(aroundPoint, self.battleModel:GetPointIndexByXY(x, y - 1))
    end
    if x < self.battleModel.mapWidthPoint then
        _G.table.insert(aroundPoint, self.battleModel:GetPointIndexByXY(x + 1, y))
    end
    if x > 1 then
        _G.table.insert(aroundPoint, self.battleModel:GetPointIndexByXY(x - 1, y))
    end
    return aroundPoint
end

---当前格子通路后刷新周围四格或八格的状态
function SociatyMazeMainView:RefreshAroundPoint(data)
    if
        data.type == self.battleModel.pointType.BigBoss or data.type == self.battleModel.pointType.SmallBoss or
            data.type == self.battleModel.pointType.Gift
     then
        if data.type == self.battleModel.pointType.BigBoss and data.type == self.battleModel.pointType.SmallBoss then
            if data.status ~= 2 then
                return
            end
        elseif data.type == self.battleModel.pointType.Gift then
            if data.status == 0 then
                return
            end
        end
        local x, y = self.battleModel:GetPointXY(data.uid)
        local aroundPoint = self:GetBigAroundPoint(x, y)
        for _, v in ipairs(aroundPoint) do
            local aroundData = self.mapPointData[v]
            if aroundData and aroundData.status == 0 and _G.table.indexof(self.monsterType, aroundData.type) then
                if self.mapPointItemList[aroundData.uid] then
                    self:SetPointInfo(self.mapPointItemList[aroundData.uid])
                end
            end
        end
    else
        if data.type == self.battleModel.pointType.Weaponry or _G.table.indexof(self.monsterType, data.type) then
            if data.status ~= 2 then
                return
            end
        else
            if data.status == 0 then
                return
            end
        end
        local x, y = self.battleModel:GetPointXY(data.uid)
        local aroundPoint = self:GetSmallAroundPoint(x, y)
        for _, v in ipairs(aroundPoint) do
            local aroundData = self.mapPointData[v]
            if aroundData and aroundData.status == 0 and _G.table.indexof(self.monsterType, aroundData.type) then
                if self.mapPointItemList[aroundData.uid] then
                    self:SetPointInfo(self.mapPointItemList[aroundData.uid])
                end
            end
        end
    end
end

---设置连线的长度和宽度
function SociatyMazeMainView:SetLineSize(img, distance)
    img:SetActiveE(1)
    local rect = img:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    local _, height = rect:GetRectTransformWidthHeight()
    rect:SetRectTransformSize(distance, height)
end

---点击格子事件
function SociatyMazeMainView:OnClickPointItem(go, _, itemGoTable)
    local data = self.mapPointData[itemGoTable.index]
    if data.type == self.battleModel.pointType.EmptyPoint or data.type == self.battleModel.pointType.BrithPoint then
        return
    end
    if self.markModelOpenBol then --and data.type <= self.battleModel.pointType.BigBoss then
        local isFlag = data.flg and data.flg == 1
        local flag = isFlag and 0 or 1
        self.battleModel:SetMarker(
            data.uid,
            flag,
            function()
                if isFlag then
                    _G.PopWindowManager:GetInstance():ShowAllTips(1010117)
                else
                    _G.PopWindowManager:GetInstance():ShowAllTips(1010116)
                end
            end
        )
        return
    end
    if not self:CheckRouter(data) then
        ---路径未连通
        if data.type == self.battleModel.pointType.Goddess then
            _G.PopWindowManager:GetInstance():ShowAllTips(1010123)
        elseif data.type == self.battleModel.pointType.Weaponry then
            _G.PopWindowManager:GetInstance():ShowAllTips(1010124)
        elseif data.type == self.battleModel.pointType.Box then
            _G.PopWindowManager:GetInstance():ShowAllTips(1010125)
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(1010103)
        end
        return
    end

    if data.status == 0 then
        self.battleModel:ChangeStatus(data.uid)
    end

    if data then
        local name = go:GetName()
        if name == "@_aorbtn_Click" then
            if _G.table.indexof(self.monsterType, data.type) then
                if data.status == 2 then
                    _G.PopWindowManager:GetInstance():ShowAllTips(1010108)
                    return
                end
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMazeBossInfoView.Name, data)
            elseif data.type == self.battleModel.pointType.Box then
                if self.battleModel:IsGetTreasure(data.uid) then
                    _G.PopWindowManager:GetInstance():ShowAllTips(1010104)
                    return
                end
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMazeAwardTipView.Name, data)
            elseif data.type == self.battleModel.pointType.Goddess then
                if self.battleModel:IsGetGoddess(data.uid) then
                    _G.PopWindowManager:GetInstance():ShowAllTips(1010105)
                    return
                end
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMazeAwardTipView.Name, data)
            elseif data.type == self.battleModel.pointType.Weaponry then
                if data.status == 2 then
                    if not require "SociatyMazeRelicManager":GetInstance():CheckRelicGet(data.uid) then
                        local msg = {}
                        msg.cell_uid = data.uid
                        require "SociatyMazeNet":GetInstance():GetMementoList(
                            msg,
                            function(data1)
                                if data1.ack ~= 1 then
                                    return
                                end
                                _G.UIManager:GetInstance():OpenWindow(
                                    _G.ConfigManager.ui_cfg.SociatyMazeGetRelicView.Name,
                                    data1.mementos,
                                    data.uid
                                )
                            end
                        )
                    else
                        _G.PopWindowManager:GetInstance():ShowAllTips(1010109)
                        return
                    end
                else
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMazeBossInfoView.Name, data)
                end
            end
        elseif name == "@_aorbtn_bClick" then
            if data.type == self.battleModel.pointType.SmallBoss then
                if data.status == 2 then
                    _G.PopWindowManager:GetInstance():ShowAllTips(1010111)
                    return
                end
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.SociatyMazeBossInfoView.Name,
                    data,
                    self.smallBossData,
                    self.smallBossPoint
                )
            elseif data.type == self.battleModel.pointType.BigBoss then
                if data.status == 2 then
                    _G.PopWindowManager:GetInstance():ShowAllTips(1010110)
                    return
                end
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.SociatyMazeBossInfoView.Name,
                    data,
                    self.smallBossData,
                    self.smallBossPoint
                )
            elseif data.type == self.battleModel.pointType.Gift then
                --获取藏宝库信息
                self.battleModel:GetGiftInfo(
                    data.uid,
                    function(msg)
                        if not msg or msg.ack ~= 1 then
                            return
                        end
                        --如果物品已售罄, 不用打开窗口
                        if msg.index_list and #msg.index_list >= #msg.shop_list then
                            _G.PopWindowManager:GetInstance():ShowAllTips(610305)
                            return
                        end
                        --打开藏宝库页面
                        _G.UIManager:GetInstance():OpenWindow(
                            _G.ConfigManager.ui_cfg.SociatyMazeGiftView.Name,
                            data,
                            msg
                        )
                    end
                )
            end
        elseif name == "@_aorbtn_show" then
            _G.PopWindowManager:GetInstance():ShowAllTips(1010103)
        end
    end
end

---初始化mvp信息
function SociatyMazeMainView:InitMvpInfo()
    require("SociatyMazeNet"):GetInstance():GetMemberList(
        function(msg)
            if msg.ack ~= 1 or self:IsNil() then
                return
            end
            local members = {}
            self.go_table.obj_mvp:SetActiveE(1)
            if msg.member then
                for _, v in pairs(msg.member) do
                    if v.win_points and v.win_points > 0 then
                        _G.table.insert(members, v)
                    end
                end
                if not _G.table.isEmptyOrNil(members) then
                    _G.SortList(
                        members,
                        function(data)
                            return data.win_points
                        end
                    )
                end
                local memberData = members[1]
                self.go_table.obj_HeadItemBase:SetActiveE(memberData and 1 or 0)
                self.go_table.obj_mvpEmpty:SetActiveE(memberData and 0 or 1)
                if memberData then
                    self.go_table.aortext_name.text = memberData.role.name
                    _G.UIUtils.SetPlayerHeadItemNew(
                        self.go_table.obj_HeadItemBase,
                        memberData.role,
                        0.8,
                        true,
                        true,
                        true
                    )
                else
                    self.go_table.aortext_name.text = _G.GetLangPackValue(90000010159)
                end
            else
                self.go_table.aortext_name.text = _G.GetLangPackValue(90000010159)
                self.go_table.obj_HeadItemBase:SetActiveE(0)
                self.go_table.obj_mvpEmpty:SetActiveE(1)
            end
        end
    )
end

---初始化等级进度
function SociatyMazeMainView:InitLevelProgress()
    if not self.sliderLevelTb then
        self.sliderLevelTb = _G.GetAutoGoTable(self.go_table.slider_level)
    end
    local stageList = {}
    local config = _G.ConfigManager.discrete_cfg[116105]
    if not self.totalState then
        self.totalState = #config
    end
    self.startTime, self.endTime = self.mazeModel:GetTime()
    if not self.startTime then
        self.startTime = _G.TimeUtil.GetServerUnixTime()
        self.endTime = self.startTime + 86400
    end
    self.durationTime = self.endTime - self.startTime
    ---策划配的是1-7级的，客户端显示是7-1级的，所以需要倒转数据且最后一级需要根据时间时间去计算
    for index, v in ipairs(config) do
        if index == self.totalState then
            stageList[self.totalState - v[1] + 1] =
                self.durationTime - (config[index - 1] and config[index - 1][2] or 0) * 86400
        else
            stageList[self.totalState - v[1] + 1] =
                v[2] * 86400 - (config[index - 1] and config[index - 1][2] or 0) * 86400
        end
    end
    for i, v in ipairs(stageList) do
        if not self.stageItemList then
            self.stageItemList = {}
        end
        local tb = self.stageItemList[i]
        if not tb then
            local obj = _G.InstantiateObject(self.sliderLevelTb.obj_levelItem, self.sliderLevelTb.obj_root)
            tb = _G.GetAutoGoTable(obj)
            self.stageItemList[i] = tb
        end
        tb.aortext_level.text = _G.GetLangPackValue(90026200009, i)
        local _, y = tb.gameObject:GetRectTransformSizeDelta()
        tb.gameObject:SetRectTransformSize((v / self.durationTime) * 508, y)
        tb.aorimage_line:SetActiveE(i < self.totalState and 1 or 0)
    end
    local servertime = _G.TimeUtil.GetServerUnixTime()
    if self.endTime - servertime > 0 then
        -- self.go_table.slider_level.value = (self.endTime - servertime) / self.durationTime
        self.sliderLevelTb.aorimage_Fill.fillAmount = (self.endTime - servertime) / self.durationTime

        local time = "<color=#96ce51>" .. _G.TimeUtil.GodSpecialGiftForStr(self.endTime - servertime) .. "</color>"
        self.go_table.aortext_time.text = _G.GetLangPackValue(90028500004, time)
        self.stageTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateStateTimer, self, false, false)
        self.stageTimer:Start()
    else
        -- self.go_table.slider_level.value = 0
        self.sliderLevelTb.aorimage_Fill.fillAmount = 0
    end
end

