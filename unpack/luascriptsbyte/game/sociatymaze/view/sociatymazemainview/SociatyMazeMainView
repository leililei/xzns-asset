        end,
        [self.battleModel.pointType.ShuiMonster] = function(itemGoTable, data)
            self:SetMonsterInfo(itemGoTable, data)
        end,
        [self.battleModel.pointType.HuoMonster] = function(itemGoTable, data)
            self:SetMonsterInfo(itemGoTable, data)
        end,
        [self.battleModel.pointType.TuMonster] = function(itemGoTable, data)
            self:SetMonsterInfo(itemGoTable, data)
        end,
        [self.battleModel.pointType.ShenMonster] = function(itemGoTable, data)
            self:SetMonsterInfo(itemGoTable, data)
        end,
        [self.battleModel.pointType.SmallBoss] = function(itemGoTable, data)
            self:SetBossPointInfo(itemGoTable, data, false)
        end,
        [self.battleModel.pointType.BigBoss] = function(itemGoTable, data)
            self:SetBossPointInfo(itemGoTable, data, true)
        end,
        [self.battleModel.pointType.Goddess] = function(itemGoTable, data)
            itemGoTable.aorimage_sIcon.SpriteName = self.goddessPic
            local isGet = self.battleModel:IsGetGoddess(data.uid)
            itemGoTable.aorimage_sIcon:SetGray(isGet)
            if isGet then
                itemGoTable.aorimage_smallBg.SpriteName = self.smallBgPic[2]
            end
        end,
        [self.battleModel.pointType.Gift] = function(itemGoTable, data)
            itemGoTable.aorimage_bIcon:SetActiveE(1)
            itemGoTable.aorimage_bIcon.SpriteName = self.giftStatusPic[data.status]
        end,
        [self.battleModel.pointType.Box] = function(itemGoTable, data)
            local status = data.status
            if status == 1 then
                status = self.battleModel:IsGetTreasure(data.uid) and 2 or status
            end
            itemGoTable.aorimage_sIcon.SpriteName = self.boxStatusPic[status]
            itemGoTable.aorimage_sIcon:SetGray(status == 2)
            if status == 2 then
                itemGoTable.aorimage_smallBg.SpriteName = self.smallBgPic[2]
            end
        end,
        [self.battleModel.pointType.Weaponry] = function(itemGoTable, data)
            itemGoTable.aorimage_sIcon.SpriteName = self.weaponryStatusPic[data.status]
            local bol = require "SociatyMazeRelicManager":GetInstance():CheckRelicGet(data.uid)
            itemGoTable.aorimage_sIcon:SetGray(bol)
            if bol then
                itemGoTable.aorimage_smallBg.SpriteName = self.smallBgPic[2]
            end
            -- itemGoTable.aorimage_sIcon:SetLocalScaleXYZ(1.3)
        end,
        [self.battleModel.pointType.BrithPoint] = function(itemGoTable, data)
            itemGoTable.aorimage_sIcon.SpriteName = self.birthPointPic
        end
    }
end

---加载boss的spine
function SociatyMazeMainView:LoadBossSpint(itemGoTable, data, isBigBoss)
    local config = _G.ConfigManager.guild_gve_cfg[data.type]
    local monsterId = config.monster_group and config.monster_group[data.monster_pool][1]
    local groupCfg = _G.ConfigManager.monster_group_cfg[monsterId]
    local defenserSids = groupCfg and groupCfg.DefaultDefenserSids and groupCfg.DefaultDefenserSids[1]
    if defenserSids then
        local monsterCfg
        if defenserSids[4] > 0 then
            monsterCfg = _G.ConfigManager.monster_cfg[defenserSids[4]]
        else
            monsterCfg = _G.ConfigManager.monster_cfg[defenserSids[1]]
        end
        local cardConfig = _G.ConfigManager.card_cfg[monsterCfg.CardID]
        itemGoTable.obj_spineEffect:ClearChildren()
        _G.PoolsManager:GetInstance():Spawn(
            _G.AppSetting.IsXzns and _G.UIUtils.GetBattleSpine(cardConfig) or cardConfig.ModelPathHi,
            _G.ePoolType.Temporary,
            itemGoTable.obj_spineEffect,
            function(trans)
                if self:IsNil() then
                    _G.DestroyImmediate(trans)
                    return
                end
                local animStatus = _G.PlayerPrefsManager.GetInt("SociatyMazeBossAnim_", 0)
                if animStatus == 0 then
                    itemGoTable.obj_spineEffect:SetAnchorPosition(0, 1200)
                end
                if _G.AppSetting.IsXzns then
                    trans:SetLocalScaleXYZ(1)
                else
                    trans:SetLocalScaleXYZ(isBigBoss and 0.8 or 0.2)
                end
                trans:SetLocalPosition(0, -50, 0)
                if isBigBoss then
                    UIUtils.IsNeedChangeUI(IsNeedChangeUI.SociatyMazeMainViewItem,itemGoTable)
                else
                    itemGoTable.obj_spineEffect:SetLocalScaleXYZ(1)
                end
                if isBigBoss then
                    UIUtils.IsNeedChangeUI(IsNeedChangeUI.SociatyMazeMainViewItem,itemGoTable)
                else
                    itemGoTable.obj_spineEffect:SetLocalScaleXYZ(1)
                end
            end
        )
    end
end

---设置boss点位信息
function SociatyMazeMainView:SetBossPointInfo(itemGoTable, data, isBigBoss)
    local status = data.status
    if (isBigBoss and status ~= 2) or (not isBigBoss and status == 1) then
        itemGoTable.aorimage_bIcon:SetActiveE(0)
        itemGoTable.obj_spineEffect:SetActiveE(1)
        self:LoadBossSpint(itemGoTable, data, isBigBoss)
    else
        itemGoTable.aorimage_bIcon:SetActiveE(1)
        itemGoTable.aorimage_bIcon.SpriteName = self.bossStatusPic[status]
    end
end

---设置五行怪和神属性怪的点位信息
function SociatyMazeMainView:SetMonsterInfo(itemGoTable, data)
    local status = data.status
    local isInitStatus = false
    if status == 0 and data.icon and data.icon > 0 and not self:CheckRouter(data) then
        isInitStatus = true
        itemGoTable.aorimage_initStatus.SpriteName = self.smallBgPic[0]
    else
        itemGoTable.aorimage_sIcon.SpriteName = self.monsterStatusPic[data.status]
        if data.status == 2 then
            -- itemGoTable.aorimage_sIcon:SetLocalScaleXYZ(0.9)
            itemGoTable.aorimage_sIcon:SetGray(true)
        else
            -- itemGoTable.aorimage_sIcon:SetLocalScaleXYZ(1)
            itemGoTable.aorimage_sIcon:SetGray(false)
        end
    end
    itemGoTable.aorimage_initStatus:SetActiveE(isInitStatus and 1 or 0)
    itemGoTable.obj_itemInfo:SetActiveE(isInitStatus and 0 or 1)
end

---设置点位信息
function SociatyMazeMainView:SetPointInfo(itemGoTable)
    local data = self.mapPointData[itemGoTable.index]
    itemGoTable.aorimage_initStatus:SetActiveE(0)
    itemGoTable.obj_itemInfo:SetActiveE(1)
    if data then
        local bigPoint =
            data.type == self.battleModel.pointType.SmallBoss or data.type == self.battleModel.pointType.BigBoss or
            data.type == self.battleModel.pointType.Gift
        local isEmptyPoint =
            data.type == self.battleModel.pointType.BigPointEmpty or data.type == self.battleModel.pointType.EmptyPoint
        itemGoTable.obj_small:SetActiveE(not bigPoint and not isEmptyPoint and 1 or 0)
        itemGoTable.obj_big:SetActiveE(bigPoint and 1 or 0)

        itemGoTable.aorimage_sIcon:SetGray(false)
        itemGoTable.obj_spineEffect:SetActiveE(0)
        if
            data.type == self.battleModel.pointType.SmallBoss or data.type == self.battleModel.pointType.BigBoss or
                data.type == self.battleModel.pointType.Gift
         then
            itemGoTable.aorimage_bigBg.SpriteName = self.bigBgPic[data.status]
        elseif data.type == self.battleModel.pointType.BrithPoint then
            itemGoTable.aorimage_smallBg.SpriteName = self.smallBgPic[0]
        else
            itemGoTable.aorimage_smallBg.SpriteName = self.smallBgPic[data.status]
        end
        if self.PointFunction[data.type] then
            self.PointFunction[data.type](itemGoTable, data)
        end
        if bigPoint then
            itemGoTable.aorimage_bIcon:SetNativeSize()
        else
            itemGoTable.aorimage_sIcon:SetNativeSize()
        end
        ---标记特效
        itemGoTable.uid = data.uid
        if itemGoTable.markerEffect then
            itemGoTable.markerEffect:SetActiveE(data.flg == 1 and itemGoTable.uid == data.uid and 1 or 0)
            if itemGoTable.obj_markEffect then
                if bigPoint then
                    itemGoTable.obj_markEffect:SetLocalScaleXYZ(1.6)
                    itemGoTable.obj_markEffect:SetLocalPosition(89, -77, 0)
                else
                    itemGoTable.obj_markEffect:SetLocalScaleXYZ(1)
                    itemGoTable.obj_markEffect:SetLocalPosition(0, 0, 0)
                end
            end
        elseif data.flg == 1 then
            itemGoTable.loadMarkerEffect = true
            _G.UIUtils.LoadEffectByCfg(
                ui_effect_cfg.ef_zlmts_biaoji,
                itemGoTable.obj_markEffect,
                function(effect)
                    if self:IsNil() then
                        return
                    end
                    itemGoTable.loadMarkerEffect = false
                    if itemGoTable.uid ~= data.uid or data.flg ~= 1 then
                        effect:SetActiveE(0)
                        return
                    end
                    itemGoTable.markerEffect = effect
                    if bigPoint then
                        itemGoTable.obj_markEffect:SetLocalScaleXYZ(1.6)
                        itemGoTable.obj_markEffect:SetLocalPosition(89, -77, 0)
                    else
                        itemGoTable.obj_markEffect:SetLocalScaleXYZ(1)
                        itemGoTable.obj_markEffect:SetLocalPosition(0, 0, 0)
                    end
                end
            )
        end
        if not isEmptyPoint and self:CheckRouter(data) then
            self:RefreshPointLine(data, bigPoint, itemGoTable)
        else
            itemGoTable.obj_lineContent:SetActiveE(0)
            itemGoTable.obj_lineContentB:SetActiveE(0)
        end
    else
        ---裂缝或占位格
        itemGoTable.obj_small:SetActiveE(0)
        itemGoTable.obj_big:SetActiveE(0)
        if itemGoTable.markerEffect then
            itemGoTable.markerEffect:SetActiveE(0)
        end
        itemGoTable.obj_lineContent:SetActiveE(0)
    end
    self:LoadPointEffect(data, itemGoTable)
    itemGoTable.obj_empty:SetActiveE(data and 0 or 1)
    itemGoTable.obj_redpoint:SetActiveE(self.battleModel:CheckWeaponryRedPoint(data))

    if data and data.type == self.battleModel.pointType.Weaponry and data.status == 2 then
        itemGoTable.obj_effect:SetActiveE(require("SociatyMazeRelicManager"):GetInstance():CheckWeaponryRedPoint(data))
    end
end

---刷新格子连线
function SociatyMazeMainView:RefreshPointLine(data, bigPoint, itemGoTable)
    if not self.passedPointList then
        self.passedPointList = {}
    end
    if not self.passedPointList[data.uid] then
        self.passedPointList[data.uid] = true
    end

    itemGoTable.obj_lineContent:SetActiveE(bigPoint and 0 or 1)
    itemGoTable.obj_lineContentB:SetActiveE(bigPoint and 1 or 0)
    local x, y = self.battleModel:GetPointXY(data.uid)
    local distance = 0
    if bigPoint then
        ---大格子
        local aroundPoint = self:GetBigAroundPoint(x, y)
        itemGoTable.obj_lineLT:SetActiveE(0)
        itemGoTable.obj_lineLB:SetActiveE(0)
        itemGoTable.obj_lineRT:SetActiveE(0)
        itemGoTable.obj_lineRB:SetActiveE(0)
        itemGoTable.obj_lineTL:SetActiveE(0)
        itemGoTable.obj_lineTR:SetActiveE(0)
        itemGoTable.obj_lineBL:SetActiveE(0)
        itemGoTable.obj_lineBR:SetActiveE(0)
        for _, v in ipairs(aroundPoint) do
            local temp = self.mapPointData[v]
            if temp and (self.passedPointList[temp.uid] or self:CheckRouter(temp)) then
                self.passedPointList[temp.uid] = true
                local _x, _y = self.battleModel:GetPointXY(temp.uid)
                local itemGo
                if _y == y - 1 and _x == x - 1 then
                    distance = 185
                    itemGo = itemGoTable.obj_lineLB
                elseif _x == x - 2 then
                    distance = 230
                    itemGo = _y == y and itemGoTable.obj_lineBL or itemGoTable.obj_lineBR
                elseif _y == y + 2 then
                    distance = 230
                    itemGo = _x == x and itemGoTable.obj_lineRT or itemGoTable.obj_lineRB
                end
                if itemGo then
                    self:SetLineSize(itemGo, distance)
                end
            end
        end
    else
        ---小格子
        local aroundPoint = self:GetSmallAroundPoint(x, y)
        itemGoTable.obj_lineL:SetActiveE(0)
        itemGoTable.obj_lineR:SetActiveE(0)
        itemGoTable.obj_lineT:SetActiveE(0)
        itemGoTable.obj_lineB:SetActiveE(0)
        for _, v in ipairs(aroundPoint) do
            local temp = self.mapPointData[v]
            if temp and (self.passedPointList[temp.uid] or self:CheckRouter(temp)) then
                self.passedPointList[temp.uid] = true
                local _x, _y = self.battleModel:GetPointXY(temp.uid)
                local bigPoint =
                    temp.type == self.battleModel.pointType.SmallBoss or temp.type == self.battleModel.pointType.BigBoss or
                    temp.type == self.battleModel.pointType.Gift or
                    temp.type == self.battleModel.pointType.BigPointEmpty
                if bigPoint and (_x < x or (temp.type ~= self.battleModel.pointType.BigPointEmpty and _y >= y)) then
                    distance = 300
                else
                    distance = 150
                end
                if _x == x then
                    if _y > y then
                        self:SetLineSize(_y > y and itemGoTable.obj_lineR or itemGoTable.obj_lineL, distance)
                    end
                else
                    if _x < x then
                        self:SetLineSize(_x > x and itemGoTable.obj_lineT or itemGoTable.obj_lineB, distance)
                    end
                end
            end
        end
    end
end

