function SociatyMazeQiwuView:Init()
    for i = 1, self.parent:GetChildCountE() do
        _G.PoolsManager:GetInstance():Despawn(self.parent:GetChildE(0), _G.ePoolType.UIItem)
    end
    _G.PoolsManager:GetInstance():Spawn(
        self.ItemPath,
        _G.ePoolType.UIItem,
        self.parent,
        _G.handler(self, self.OnItemCardCall)
    )
end
---主要界面点击事件
function SociatyMazeQiwuView:OnClickBtn(go, IsOn, clickCall)
    if clickCall then 
        clickCall()
    end
end

