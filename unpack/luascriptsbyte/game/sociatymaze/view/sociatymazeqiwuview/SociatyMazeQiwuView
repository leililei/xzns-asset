function SociatyMazeQiwuView:__init(cfg, parent, clickCall, othercall)
    self.ItemPath = "UIH5/SociatyMaze/SociatyMazeQiwu"
    self.PropertyIcon = {
        "ui_aymg_yw_lv",
        "ui_aymg_yw_lan",
        "ui_aymg_yw_zi",
        "ui_aymg_yw_cheng",
    }
    self.PropertyTxt = {
        90031300005,
        90031300006,
        90031300007,
        90031300008
    }
    self.NameColors = {"<color=#14874a>", "<color=#763da3>", "<color=#b96939>", "<color=#a3423d>"}
    self.cfg = cfg
    self.clickCall = clickCall
    self.othercall = othercall
    self.parent = parent
    self:Init()
end
function SociatyMazeQiwuView:Show(cfg, parent, clickCall, othercall)
    self.cfg = cfg
    self.clickCall = clickCall
    self.othercall = othercall
    self.parent = parent
    self:Init()
end
function SociatyMazeQiwuView:OnItemCardCall(trans, ref)
    self.gameObject = trans
    local item = _G.GetAutoGoTable(trans, _G.handlerbind(self, self.OnClickBtn, self.clickCall))
    self.go_table = item
    item.aortext_name.text =
        self.NameColors[self.cfg.quality] .. _G.LangUtil.GetLangPackValue(self.cfg.name) .. "</color>"
    item.aortext_level.text = _G.LangUtil.GetLangPackValue(self.PropertyTxt[self.cfg.quality])
    if self.cfg.skills then
        local skillDesc = _G.ConfigManager.card_skills_cfg[self.cfg.skills].describe1
        item.aortext_desc.text = _G.LangUtil.GetLangPackValue(skillDesc)
    else
        item.aortext_desc.text = ""
    end
    item.aorrawimage_icon:LoadImage(self.cfg.icon)
