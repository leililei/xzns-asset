function SociatyMazeBossInfoView:RefreshScore()
    local config = _G.ConfigManager.guild_gve_cfg[self.data.type]
    self.scoreData = config.score
    self.go_table.slider_progress.value = self.data.point / config.max_score
    self.go_table.aortext_Slider.text = self.data.point .. "/" .. config.max_score
    self.go_table.aortext_time.text = "x" .. self.mazeModel:GetStageBonus()
end

---刷新下拉列表
function SociatyMazeBossInfoView:RefreshDropDown()
    self.go_table.aorbtn_down:SetActiveE(not self.unfold and 1 or 0)
    self.go_table.aorbtn_up:SetActiveE(self.unfold and 1 or 0)
    self.go_table.obj_options:SetActiveE(self.unfold and 1 or 0)
    self.go_table.aortext_dropdown.text = self.scoreOptationList[self.selectIndex]
    if self.unfold then
        if not self.optionListView then
            self.go_table.scrollloopvectical_optation:InitItemData(
                #self.scoreData,
                _G.handler(self, self.RefreshOptionItem)
            )
            self.optionListView = self.go_table.scrollloopvectical_optation
        else
            self.optionListView:UpdateAllItem()
        end
    end
end

function SociatyMazeBossInfoView:RefreshOptionItem(index, obj)
    local eIndex = index + 1
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickOption, eIndex))
    tb.aortext_label.text = self.scoreOptationList[eIndex]
    if self.selectIndex == eIndex then
        tb.aortext_label.text = "<color=#96ce51>" .. self.scoreOptationList[eIndex] .. "</color>"
        tb.aortext_num.text = "<color=#96ce51>" .. self.scoreData[eIndex] .. "</color>"
    else
        tb.aortext_label.text = "<color=#e6e0dc>" .. self.scoreOptationList[eIndex] .. "</color>"
        tb.aortext_num.text = "<color=#e6e0dc>" .. self.scoreData[eIndex] .. "</color>"
    end
end

function SociatyMazeBossInfoView:OnClickOption(_, _, eIndex)
    if self.selectIndex ~= eIndex then
        self.selectIndex = eIndex
        self.unfold = not self.unfold
        self:RefreshDropDown()
        if self.data.type ~= self.battleModel.pointType.BigBoss then
            self:RefreshSmallBoss()
        end
        self:RefreshBanElement()
        _G.PlayerPrefsManager.SetInt("SociatyMazeBossDifficult", eIndex)
    end
end

function SociatyMazeBossInfoView:RefreshSmallBoss()
    if not self.monsterTb then
        self.monsterTb = _G.GetAutoGoTable(self.go_table.obj_monsterPanel)
    end

    local config = _G.ConfigManager.guild_gve_cfg[self.data.type]
    local cardConfig = self.battleModel:GetCardCfg(self.data)
    if cardConfig then
        self:RefreshSpine(cardConfig) 
    end
    if self.data.type == self.battleModel.pointType.SmallBoss then
        if cardConfig then
            self.monsterTb.aortext_title.text = _G.GetLangPackValue(90032700036, _G.GetLangPackValue(cardConfig.Name))
        else
            self.monsterTb.aortext_title.text = ""
        end
    else
        self.monsterTb.aortext_title.text = _G.GetLangPackValue(config.name)
    end

    if self.battleModel:GetRestore() > 0 then
        self.monsterTb.aortext_consume.text = _G.GetLangPackValue(90032700023, 1)
    else
        self.monsterTb.aortext_consume.text = _G.GetLangPackValue(90032700023, "<color=#944D05>" .. 1 .. "</color>")
    end
    self.monsterTb.aortext_monsterDesc.text = _G.GetLangPackValue(90032700060)

    self.monsterTb.aortext_title1.text = _G.GetLangPackValue(90032700022)
    local skillEffectDesc = self:GetSkillEffectDesc(config.effect)
    local haveEffect = not _G.string.IsNullOrEmpty(skillEffectDesc)
    self.monsterTb.aortext_desc.text = haveEffect and skillEffectDesc or ""
    self.monsterTb.obj_noEffect:SetActiveE(haveEffect and 0 or 1)
    self.monsterTb.aorimage_consume.SpriteName = self.mazeModel:GetRestoreIcon()
end

---技能效果描述
function SociatyMazeBossInfoView:GetSkillEffectDesc(effect)
    local skillEffectDesc = ""
    if effect[self.selectIndex] then
        for _, v in ipairs(effect[self.selectIndex]) do
            local effectCfg = _G.ConfigManager.card_skills_cfg[v]
            if effectCfg then
                if _G.string.IsNullOrEmpty(skillEffectDesc) then
                    skillEffectDesc = _G.GetLangPackValue(effectCfg.describe1)
                else
                    skillEffectDesc = skillEffectDesc .. "\n" .. _G.GetLangPackValue(effectCfg.describe1)
                end
            end
        end
    end
    return skillEffectDesc
end

function SociatyMazeBossInfoView:RefreshBigBoss()
    if not self.bossTb then
        self.bossTb = _G.GetAutoGoTable(self.go_table.obj_BossPanel)
    end
    if self.battleModel:GetRestore() > 0 then
        self.bossTb.aortext_consume.text = _G.GetLangPackValue(90032700023, 1)
    else
        self.bossTb.aortext_consume.text = _G.GetLangPackValue(90032700023, "<color=#944D05>" .. 1 .. "</color>")
    end
    self.bossTb.aorimage_consume.SpriteName = self.mazeModel:GetRestoreIcon()
    local bossData = self.mazeModel:GetGuardianBoss()
    self.bossTb.aortext_desc.text = _G.GetLangPackValue(90032700086)
    local config = _G.ConfigManager.guild_gve_cfg[self.data.type]
    local monsterId = config.monster_group and config.monster_group[self.data.monster_pool][1]
    self.hasMonsterCfg = monsterId
    if monsterId then
        local groupCfg = _G.ConfigManager.monster_group_cfg[monsterId]
        local defenserSids = groupCfg and groupCfg.DefaultDefenserSids and groupCfg.DefaultDefenserSids[1]
        ---策划需求：默认获取4号位，找不到取1号位置的怪，都找不到就是策划配置有问题
        if defenserSids then
            local monsterCfg
            if defenserSids[4] > 0 then
                monsterCfg = _G.ConfigManager.monster_cfg[defenserSids[4]]
            else
                monsterCfg = _G.ConfigManager.monster_cfg[defenserSids[1]]
            end
            local cardConfig = _G.ConfigManager.card_cfg[monsterCfg.CardID]
            self.bossTb.aortext_title.text = _G.GetLangPackValue(90032700039, _G.GetLangPackValue(cardConfig.Name))
            self:RefreshSpine(cardConfig)
        end
    else
        self.bossTb.aortext_title.text = ""
    end
    self:LoadSkill(bossData)
end

---加载技能
function SociatyMazeBossInfoView:LoadSkill(bossData)
    if not self.skillItemList then
        self.skillItemList = {}
    end
    for i, v in ipairs(bossData) do
        local effectCfg = _G.ConfigManager.card_skills_cfg[v.v]
        if effectCfg then
            local tb = self.skillItemList[i]
            if not tb then
                tb =
                    _G.GetAutoGoTable(
                    _G.InstantiateObject(self.bossTb.obj_skill, self.bossTb.trans_skill),
                    _G.handlerbind(self, self.OnClickSkillItem, effectCfg)
                )
                self.skillItemList[i] = tb
            else
                self.skillItemList[i].gameObject:SetActiveE(1)
            end
            tb.aorrawimage_skillIcon:LoadImage(effectCfg.icon)
            local isClear = false
            if not _G.table.isEmptyOrNil(self.smallBossData) then
                for _, data in pairs(self.smallBossData) do
                    if data.uid == v.k and data.status == 2 then
                        isClear = true
                    end
                end
            end
            tb.obj_clear:SetActiveE(isClear and 1 or 0)
        end
    end
end

function SociatyMazeBossInfoView:OnClickSkillItem(_, _, effectCfg)
    require("CommonTipManager"):GetInstance():OpenSkillTip(effectCfg.id)
end

---界面的销毁函数
function SociatyMazeBossInfoView:OnDestroy()
    self:RemoveAllListener()
    if self.tweer then
        self.tweer:Kill()
        self.tweer = nil
    end
end

---按钮点击事件在这里派发
function SociatyMazeBossInfoView:OnClickBtn(go)
    if go == self.go_table.aorbtn_Bg or go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_mark then
        local isFlag = self.data.flg and self.data.flg == 1
        local flag = isFlag and 0 or 1
        self.battleModel:SetMarker(
            self.data.uid,
            flag,
            function()
                self:SetMarkerStatus()
                if isFlag then
                    _G.PopWindowManager:GetInstance():ShowAllTips(1010117)
                else
                    _G.PopWindowManager:GetInstance():ShowAllTips(1010116)
                end
            end
        )
    elseif go == self.go_table.aorbtn_battle then
        --镇魂街ZHJ-34510 【主任务】公测版本主任务ZHJ-38150
        --【客户端】天罡龙骑战每个建筑每天可多次挑战
        -- if self.battleModel:CheckRoute(self.data.uid) then
        --     _G.PopWindowManager:GetInstance():ShowAllTips(1010118)
        --     return
        -- end
        if self.battleModel:GetRestore() <= 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(1010102)
            return
        end
        local id = self.data.uid
        require("SociatyMazeBattleModel"):GetInstance():Fight(id, self.selectIndex)
    elseif go == self.go_table.aorbtn_award then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.SociatyMazeBattleAwardInfoView.Name,
            self.data.uid,
            self.data.type,
            self.selectIndex
        )
    elseif go == self.go_table.aorbtn_battleRecord then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.SociatyMazeBattleRecordView.Name,
            self.data.uid,
            self.data.type
        )
    elseif go == self.go_table.aorbtn_dropdown then
        ---下拉列表
        self.unfold = not self.unfold
        self:RefreshDropDown()
        --刷新难度红点
        local startTime, _ = self.mazeModel:GetTime()
        _G.PlayerPrefsManager.SetInt(
            tostring(_G.PlayerModel:GetInstance().role_uid) .. "SociatyMazeDifficult",
            startTime
        )
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SociatyMazeDifficult.id)
    elseif go == self.go_table.aorbtn_help then
        ---打开玩法说明页面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 153)
    end
end

return SociatyMazeBossInfoView
