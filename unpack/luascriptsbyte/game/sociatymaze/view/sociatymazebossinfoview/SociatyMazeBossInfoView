function SociatyMazeBossInfoView:LoadEffect()
    if self.data.type == self.battleModel.pointType.BigBoss or self.data.type == self.battleModel.pointType.BigBoss then
        return
    end
    local ck = function(trans)
        if self:IsNil() then
            _G.DestroyObject(trans)
            return
        end
    end
    if self.data.type == self.battleModel.pointType.HuoMonster then
        UIUtils.LoadEffectByCfg(ui_effect_cfg.ef_SociatyMazeBossInfoView_hong_bg, self.go_table.obj_effect, ck)
    end
    if self.data.type == self.battleModel.pointType.Weaponry then
        local cardConfig = self.battleModel:GetCardCfg(self.data)
        local element = cardConfig and cardConfig.Elements or 1
        UIUtils.LoadEffectByCfg(ui_effect_cfg[self.weaponryElementBgEffect[element]], self.go_table.aorrawimage_di, ck)
        UIUtils.LoadEffectByCfg(
            ui_effect_cfg[self.weaponryElementEffect[element]],
            self.go_table.aorrawimage_element,
            ck
        )
    else
        UIUtils.LoadEffectByCfg(ui_effect_cfg[self.elementBgEffect[self.data.type]], self.go_table.aorrawimage_di, ck)
        UIUtils.LoadEffectByCfg(
            ui_effect_cfg[self.elementEffect[self.data.type]],
            self.go_table.aorrawimage_element,
            ck
        )
    end
end

---禁用属性
function SociatyMazeBossInfoView:RefreshBanElement()
    local config = _G.ConfigManager.guild_gve_cfg[self.data.type]
    if config.Elements and config.Elements[self.selectIndex] then
        self.go_table.obj_banElement:SetActiveE(1)
        if not self.banElementList then
            self.banElementList = {}
        end
        local childCount = self.go_table.obj_banGrid:GetChildCountE()
        if childCount > 0 then
            for i = 0, childCount - 1 do
                self.go_table.obj_banGrid:GetChildE(i).gameObject:SetActiveE(0)
            end
        end
        for k, v in ipairs(config.Elements[self.selectIndex]) do
            local tb = self.banElementList[k]
            if not tb then
                tb =
                    _G.GetAutoGoTable(_G.InstantiateObject(self.go_table.obj_banElementItem, self.go_table.obj_banGrid))
                self.banElementList[k] = tb
            end
            self.banElementList[k].gameObject:SetActiveE(1)
            tb.aorimage_icon.SpriteName = self.elementIcon[v]
        end
    else
        self.go_table.obj_banElement:SetActiveE(0)
    end
end

---数据变化推送
function SociatyMazeBossInfoView:OnSociatyMazeChange(cells)
    if self:IsNil() then
        return
    end
    for _, data in pairs(cells) do
        if data.uid == self.data.uid then
            if data.point <= 0 then
                _G.PopWindowManager:GetInstance():ShowAllTips(1010108)
                self:Close()
            else
                self.data = data
                self:RefreshScore()
            end
            break
        end
    end
end

---被踢出公会
function SociatyMazeBossInfoView:OnBeKicked(uid)
    if uid == _G.PlayerModel:GetInstance().role_uid then
        self:Close()
    end
end

---已结算-本期时间已结束
function SociatyMazeBossInfoView:OnSociatyMazeSettle()
    self:Close()
end

---刷新怪物spine
---@param cfg card_cfg
function SociatyMazeBossInfoView:RefreshSpine(cfg)
    if not self.modelSpineEffect then
        self.modelSpineEffect = true
        local scale = cfg.size2
        local pos = cfg.pos_portrait
        local path = cfg.ModelPathHi
        if _G.UIUtils.IsUseBattleSpine(_G.UseBattleSpine.SociatyMazeBossInfoView) then
            scale = cfg.size4
            pos = { 0, 0, 0 }
            path = _G.UIUtils.GetBattleSpine(cfg)
        end
        _G.PoolsManager:GetInstance():Spawn(
            path,
            _G.ePoolType.Temporary,
            self.go_table.trans_Spine,
            function(trans)
                if not self.go_table then
                    _G.DestroyImmediate(trans)
                    return 
                end
                if _G.AppSetting.IsXzns then
                    trans:SetLocalScaleXYZ(1.3)
                else
                    trans:SetLocalScaleXYZ(scale)
                end
                trans:SetLocalPosition(pos[1], pos[2], pos[3])
            end
        ) 
    end
end

