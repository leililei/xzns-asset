function SociatyMazeRankView:OnToggle(go, isOn, callback)
    local tb = _G.GetAutoGoTable(go)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, isOn)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOff, not isOn)
    callback(self, isOn)
end

---按钮点击事件在这里派发
function SociatyMazeRankView:OnClickBtn(go, isOn)
    if go == self.go_table.toggle_PlayerRank then
        self:OnToggle(go, isOn, self.ShowPlayerRank)
    elseif go == self.go_table.toggle_Rank then
        self:OnToggle(go, isOn, self.ShowRank)
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

---界面的销毁函数
function SociatyMazeRankView:OnDestroy()
end

return SociatyMazeRankView