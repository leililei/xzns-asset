---@class SociatyMazeRankView : UIBaseView	中文描述
---@field public go_table SociatyMazeRankView_GoTable GoTable
local SociatyMazeRankView = _G.BaseClass("SociatyMazeRankView", _G.UIBaseView)

function SociatyMazeRankView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyMazeRankView:OnCreate(index)
    local defaultIndex = index and index or 1
    self.go_table.toggle_PlayerRank.isOn = defaultIndex == 1
    self.go_table.toggle_Rank.isOn = defaultIndex == 2
    if defaultIndex == 1 then
        self:OnClickBtn(self.go_table.toggle_PlayerRank, defaultIndex == 1)
    elseif defaultIndex == 2 then
        self:OnClickBtn(self.go_table.toggle_Rank, defaultIndex == 2)
    end
end

---玩家排行
function SociatyMazeRankView:ShowPlayerRank(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_PlayerRank, isOn)
    if not isOn then
        return
    end
    if not self.SociatyPlayerRank then
        self.SociatyPlayerRank = self:AddComponent(self.go_table.obj_PlayerRank, require "SociatyMazeRankPlayer".New(self))
        self.SociatyPlayerRank:Show()
    else
        -- self.SociatyPlayerRank:Show()
    end
end
---公会排行
function SociatyMazeRankView:ShowRank(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Rank, isOn)
    if not isOn then
        return
    end
    if not self.SociatyRankView then
        self.SociatyRankView = self:AddComponent(self.go_table.obj_Rank, require "SociatyMazeRankInfo".New(self))
            self.SociatyRankView:Show()
    else
        -- self.SociatyRankView:Show()
    end
end
