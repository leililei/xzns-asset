    -- end
    self.ChooseMementos = self.ItemList[index].gameObject
    self.ChooseMementos:SetLocalScale(1.1, 1.1, 1)
    --_G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_Sure, true)
end

---主要界面点击事件
function SociatyMazeGetRelicView:OnClickBtn(go, IsOn)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_Pass then
        self:Close()
    elseif go == self.go_table.aorbtn_Sure then
        -- if self.isOpen then
        --     -- ---@type roguelike.c2s_roguelike_choose_mementos
        --     -- local msg = {}
        --     -- msg.mementos = self.ChooseIndex
        --     require "SociatyMazeModel":GetInstance():OpenChooseMementos(
        --         self.ChooseIndex,
        --         function(data)
        --             ---@type DG.Tweening.Sequence
        --             self.Sequence = _G.DOTween:Sequence()
        --             if self.waitPlayAni == nil then
        --                 self.waitPlayAni = _G.coroutine.start(_G.handler(self, self.CoOnProgressPlayAni))
        --             end
        --         end
        --     )
        -- else
            if not self.ChooseIndex then 
                _G.PopWindowManager:GetInstance():ShowAllTips(1010115)
                return 
            end
            ---@type roguelike.c2s_roguelike_choose_mementos
            local msg = {}
            msg.cell_uid = self.cell_uid
            msg.memento_sid = self.ChooseIndex
            require "SociatyMazeNet":GetInstance():ChooseMementos(
                msg,
                function(data)
                    ---@type DG.Tweening.Sequence
                    if data.ack ~= 1 then 
                        return 
                    end
                    self.Sequence = _G.DOTween:Sequence()
                    if self.waitPlayAni == nil then
                        self.waitPlayAni = _G.coroutine.start(_G.handler(self, self.CoOnProgressPlayAni))
                    end
                    --遗物选择后加入增加战力
                    self.MementosList = require "SociatyMazeModel":GetInstance().roleInfo.mementos
                    _G.table.insert(self.MementosList, msg.memento_sid)
                    _G.table.insert(require "SociatyMazeModel":GetInstance().roleInfo.special_battle, msg.cell_uid)
                    ---刷新可装备遗物红点
                    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SociatyMazeRelicEquip.id)
                    _G.Events:GetInstance():Broadcast(_G.eSociatyMaze.SociatyMazeGetRelic, msg.cell_uid)

                    require("SociatyMazeBattleModel"):GetInstance():RefreshRelic(msg.cell_uid)
                end
            )
        --end
    end
end
