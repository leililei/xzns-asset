---@class SociatyMazeBattleShowAwardView : UIBaseView	公会-暗影迷宫战斗结算
---@field public go_table SociatyMazeBattleShowAwardView_GoTable
local SociatyMazeBattleShowAwardView = _G.BaseClass("SociatyMazeBattleShowAwardView", _G.UIBaseView)

---界面的入口函数
function SociatyMazeBattleShowAwardView:OnCreate(callback, results, info)
    self.callback = callback
    self.results = results
    self.info = info
    self:OpenShowAwardWithButtonView()
end

---打开嵌套子页面
---@return void
function SociatyMazeBattleShowAwardView:OpenShowAwardWithButtonView()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
        self.callback,
        self.results
    )
end

---监听界面打开
---@param name string 界面名称
function SociatyMazeBattleShowAwardView:OnUIOpened(name)
    if name ~= _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)

    _G.UIManager:GetInstance():ChangeCanvasOrder(
        name,
        self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 1
    )

    ---@type ShowAwardWithButtonView
    local showAwardWithButtonView = _G.UIManager:GetInstance():GetWindowCtrl(name)
    if showAwardWithButtonView then
        showAwardWithButtonView.transform:SetParentE(self.go_table.trans_view)
    end
end

---监听界面关闭
---@param name string 界面名称
function SociatyMazeBattleShowAwardView:OnUIClosed(name)
    if name ~= _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
    self:Close()
end

return SociatyMazeBattleShowAwardView
