local base = require("BaseGameNet")

---@class SociatyMazeNet : BaseGameNet	通信协议
local SociatyMazeNet = _G.BaseClass("SociatyMazeNet", base)
---@return SociatyMazeNet SociatyMazeNet
function SociatyMazeNet:GetInstance()
    return base.GetInstance(self)
end

function SociatyMazeNet:AddMessageListeners()
    self:AddMessageListener(_G.ConfigManager.net_map.send_guild_maze_change.Cmd, self.OnP2MazeChange)
    self:AddMessageListener(_G.ConfigManager.net_map.send_guild_maze_award.Cmd, self.OnP2CPassAwardChange)
    self:AddMessageListener(_G.ConfigManager.net_map.send_guild_maze_mvp.Cmd, self.OnP2CMazeMvp)
    self:AddMessageListener(_G.ConfigManager.net_map.send_guild_maze_settlement.Cmd, self.OnP2CMazeSettle)
end

---获取信息
function SociatyMazeNet:GetInfo(callback)
    self:Access(_G.ConfigManager.net_map.game_guild_maze_port_get_info, self:GetEmptyPB(), callback)
end

