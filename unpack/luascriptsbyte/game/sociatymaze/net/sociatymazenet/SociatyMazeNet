function SociatyMazeNet:GetLogList(callback)
    self:Access(_G.ConfigManager.net_map.game_guild_maze_port_get_logs, self:GetEmptyPB(), callback)
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function SociatyMazeNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function SociatyMazeNet:AccessWithError(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.CallbackWithError))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function SociatyMazeNet:CallbackWithError(port, data)
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return SociatyMazeNet
