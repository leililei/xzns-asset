---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function SociatyMazeNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---获取成员数据
function SociatyMazeNet:GetMemberList(callback)
    self:Access(_G.ConfigManager.net_map.game_guild_maze_port_get_member_info, self:GetEmptyPB(),callback)
end

---获取公会排行
function SociatyMazeNet:GetGuildRank(callback)
    self:Access(_G.ConfigManager.net_map.rank_guild_maze, {page = 1}, callback)
end

