---@class EightTheLoginNet : BaseGameNet 通信协议
local EightTheLoginNet = _G.BaseClass("EightTheLoginNet", require("BaseGameNet"))
local base = require("BaseGameNet")
---@return EightTheLoginNet EightTheLoginNet
function EightTheLoginNet:GetInstance()
    return self.super.super.GetInstance(self)
end
--活动信息
function EightTheLoginNet:landingInfo(callback)
    local item = _G.ConfigManager.net_map.game_landing_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.AccessCall))
    self.Call[port] = callback
    -- body
end

--活动领奖
---@param pbData c2s_landing_gate 输入
function EightTheLoginNet:landingGate(pbData, callback)
    local item = _G.ConfigManager.net_map.game_landing_gate
    local port = base.Access(self, item, pbData, _G.handler(self, self.AccessCall))
    self.Call[port] = callback
    -- body
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function EightTheLoginNet:AccessCall(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return EightTheLoginNet
