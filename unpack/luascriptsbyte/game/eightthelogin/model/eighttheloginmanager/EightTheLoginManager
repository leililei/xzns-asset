---@class EightTheLoginManager: GameDataModelBase	中文描述
local EightTheLoginManager = _G.BaseClass("EightTheLoginManager", _G.GameDataModelBase)

local EightTheLoginNet = require "EightTheLoginNet"

---@return EightTheLoginManager EightTheLoginManager
function EightTheLoginManager:GetInstance()
    return self.super.GetInstance(self)
end
---获取数据
function EightTheLoginManager:GetDataFormServer(_)
    EightTheLoginNet:GetInstance():landingInfo(_G.handler(self, self.GetIllustrationDataCallback))
end
---获取数据回调
function EightTheLoginManager:GetIllustrationDataCallback(msg)
    ---@field g_sids number[] 累计领取过的id
    self.Data = msg
    self:ParseData(msg)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.MainEight.id)
    _G.Events:GetInstance():Broadcast(_G.EightTheLoginEnum.EightTheLoginXianShi)
end
---领取奖励
---@param callback function 回调方法
function EightTheLoginManager:OpenTip(id, callback)
    ---@type store.c2s_landing_gate
    self.mag = {}
    self.mag.sid = id
    EightTheLoginNet:GetInstance():landingGate(self.mag, callback)
    -- self.Call[id] = callback
end
--是否显示
function EightTheLoginManager.InitialPanDuan()
    return require("EightTheLoginManager"):GetInstance():InitialBoll()
end

--是否显示.false是关闭,true是显示
function EightTheLoginManager:InitialBoll()
    if self.Data.g_sids ~= nil and #self.Data.g_sids >= 8 then
        return false
    end
    return true
end

--是否显示红点.false是关闭,true是显示
function EightTheLoginManager:hongDian()
    _G.PlayerModel:GetInstance():CumulativeLogin()
    if self.Data.g_sids ~= nil and #self.Data.g_sids >= _G.PlayerModel:GetInstance().day_count then
        return false
    end
    return true
end

return EightTheLoginManager
