local EightTheLoginView = _G.BaseClass("EightTheLoginView", _G.UIBaseView)
--领取标记 No 0：未领取 Yes 1：已领取 2：未开放
local firstCash = {
    No = 0,
    Yes = 1,
    NA = 2
}
--1 可领取  2 = 已领取 3= 未开放
local itemImage = {
    [1] = "ui_8D_frame_kelingqudi",
    [2] = "ui_8D_frame_yilingqudi",
    [3] = "ui_8D_frame_dailingqudi"
}
local daycolor = {
    [1] = {r = 255, g = 238, b = 158}, --ffee9e 可领取
    [2] = {r = 125, g = 46, b = 23}, --7D2E17 已领取
    [3] = {r = 229, g = 181, b = 124} --e5b57c 未开放
}
local namecolor = {
    [1] = {r = 180, g = 88, b = 48}, --未开放，已领取  b45830
    [2] = {r = 157, g = 61, b = 41} --可领取  9d3d29
}
--1 可领取 2 已领取 3
local itemStateImage = {
    [1] = "ui_8D_frame_yilingqu", --预防报错
    [2] = "ui_8D_frame_yilingqu",
    [3] = "ui_8D_frame_ciriling",
    [4] = "ui_8D_frame_dailingqu"
}
function EightTheLoginView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.landing_cfg = _G.ConfigManager.landing_cfg
    self.DQKeXuanZho = 1
    self.DengLuData = {}
    self.YiShengCheng = {}
    self.YiShengChengTieXiao = {}
    self.FuZhi = true

    _G.Events:GetInstance():AddListener(_G.EightTheLoginEnum.EightTheLoginXianShi, self.XianShi, self)
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.openPanel)
    _G.DelayFrameDo(
        function()
            self:XianShi()
        end
    )
end

---显示刷新
function EightTheLoginView:XianShi()
    local tb = {}
    self:lingQuTime()
    self:InitFinalAward()
    tb[1] = _G.GetAutoGoTable(self.go_table.obj_wupingkuang1, _G.handlerbind(self, self.XiangQingChaKan, 1))
    tb[2] = _G.GetAutoGoTable(self.go_table.obj_wupingkuang2, _G.handlerbind(self, self.XiangQingChaKan, 2))
    tb[3] = _G.GetAutoGoTable(self.go_table.obj_wupingkuang3, _G.handlerbind(self, self.XiangQingChaKan, 3))
    tb[4] = _G.GetAutoGoTable(self.go_table.obj_wupingkuang4, _G.handlerbind(self, self.XiangQingChaKan, 4))
    tb[5] = _G.GetAutoGoTable(self.go_table.obj_wupingkuang5, _G.handlerbind(self, self.XiangQingChaKan, 5))
    tb[6] = _G.GetAutoGoTable(self.go_table.obj_wupingkuang6, _G.handlerbind(self, self.XiangQingChaKan, 6))
    tb[7] = _G.GetAutoGoTable(self.go_table.obj_wupingkuang7, _G.handlerbind(self, self.XiangQingChaKan, 7))

    for i = 1, 7 do
        local x, y, z = tb[i].gameObject:GetAnchorPosition()
        local state, image = "", ""
        local color1, color2 = {}, {}
        color2 = _G.Color.New(namecolor[1].r / 255, namecolor[1].g / 255, namecolor[1].b / 255)
        if self.DengLuData[i] == firstCash.No then
            image = itemImage[1]
            state = itemStateImage[1]
            color1 = _G.Color.New(daycolor[1].r / 255, daycolor[1].g / 255, daycolor[1].b / 255)
            color2 = _G.Color.New(namecolor[2].r / 255, namecolor[2].g / 255, namecolor[2].b / 255)
        elseif self.DengLuData[i] == firstCash.Yes then
            state = itemStateImage[2]
            image = itemImage[2]
            color1 = _G.Color.New(daycolor[2].r / 255, daycolor[2].g / 255, daycolor[2].b / 255)
        else
            if (i - self.DQKeXuanZho) >= 2 then
                state = itemStateImage[4]
                color1 = _G.Color.New(daycolor[3].r / 255, daycolor[3].g / 255, daycolor[3].b / 255)
            else
                state = itemStateImage[3]
                color1 = _G.Color.New(daycolor[1].r / 255, daycolor[1].g / 255, daycolor[1].b / 255)
            end
            image = itemImage[3]
            color2 = _G.Color.New(namecolor[1].r / 255, namecolor[1].g / 255, namecolor[1].b / 255)
        end

        tb[i].aortext_dayname.color = color1

        tb[i].aorimage_cijilingqu.SpriteName = image
        tb[i].aorimage_cijilingqu:SetNativeSize()
        tb[i].aorimage_state.SpriteName = state
        local flag = self.DengLuData[i] == firstCash.No
        tb[i].aorbtn_wupin:SetActiveE(flag and 1 or 0)
        tb[i].aorimage_state:SetActiveE(not flag and 1 or 0)
        local sid = self.landing_cfg[i].reward[1][1]
        tb[i].aortext_name.text = _G.StorageManager:GetInstance():GetItemName(sid)
        tb[i].aortext_name.color = color2
        local insId = tb[i].transform:GetInstanceIDE()

        self:tanQuanDian(self.landing_cfg[i].reward[1], false, tb[i].obj_wupin2, self.DengLuData[i], insId)
    end
    self.go_table.aorimage_EightLock:SetActiveE(0)
    self.go_table.aorimage_EightUnlock:SetActiveE(0)
    if self.DengLuData[8] ~= nil and self.DengLuData[8] == 1 then
        self.go_table.aorimage_EightUnlock:SetActiveE(1)
        self.go_table.aorbtn_mingrilingqu:SetActiveE(0)
    elseif self.DQKeXuanZho >= 8 then
        self.go_table.aorbtn_mingrilingqu:SetActiveE(1)
    elseif self.DengLuData[8] ~= nil and self.DengLuData[8] == 2 then
        self.go_table.aorimage_EightLock:SetActiveE(1)
        self.go_table.aorbtn_mingrilingqu:SetActiveE(0)
    end
end

---物品内容选中显示
function EightTheLoginView:tanQuanDian(data, isGou, Parent, firstCashs, insId)
    if self.YiShengCheng[insId] ~= nil then
        self.YiShengCheng[insId].gameObject:SetActiveE(0)
        -- self.YiShengCheng[Sid].Despawn(self.YiShengCheng[Sid])
        self.YiShengCheng[insId] = nil
    end
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        data,
        Parent,
        function(item)
            item.gameObject:SetLocalScaleXYZ(1)
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
            -- item:SetGou(isGou)
            if item.go_table.aorrawimage_Icon ~= nil then
                item.go_table.aorrawimage_Icon:SetGray(isGou)
            end

            -- item.go_table.aorimage_Color:SetGray(isGou)
            if item.go_table.aorimage_ColorBG ~= nil then
                item.go_table.aorimage_ColorBG:SetActiveE(0)
            end
            if item.go_table.aorimage_Color ~= nil then
                item.go_table.aorimage_Color:SetActiveE(0)
            end
            -- if firstCash.No == firstCashs then
            if firstCash.Yes ~= firstCashs then
                self:TeXiaoShengCheng(item.gameObject, data[1])
            elseif firstCash.Yes == firstCashs then
                item:SetGou(true)
            end
            item:SetGrade(true)

            -- _G.DelayDo(
            --     1,
            --     function()
            --         -- body
            --     end
            -- )
            item.gameObject:SetLocalPosition(0, 0, 0)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            self.YiShengCheng[insId] = item
        end,
        function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data[1])
        end
    )
end
function EightTheLoginView:TeXiaoShengCheng(obj, Sid)
    local num = _G.StorageManager:GetInstance():GetCommonLightEffect(Sid)

    _G.UIUtils.LoadEffectByCfg(
        num,
        obj,
        function(trans)
            trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
        end
    )
end

---更新奖励领取情况
function EightTheLoginView:lingQuTime()
    ---获取当前登录天数
    self.DQKeXuanZho = _G.PlayerModel:GetInstance().day_count
    local g_sids = require("EightTheLoginManager"):GetInstance().Data.g_sids
    for i = 1, 8 do
        if i > self.DQKeXuanZho then
            self.DengLuData[i] = firstCash.NA
        else
            self.DengLuData[i] = firstCash.No
        end
    end
    if g_sids ~= nil then
        for key, value in pairs(g_sids) do
            self.DengLuData[value] = firstCash.Yes
        end
    end
end
---领取奖励或者显示详情
function EightTheLoginView:XiangQingChaKan(go, _, index)
    local name = go:GetName()

    if name == "@_aorbtn_wupin" then
        self.XuanZho = index
        if self.DengLuData[index] == firstCash.No then
            require("EightTheLoginManager"):GetInstance():OpenTip(index, _G.handler(self, self.JiangLiHuiDiao))
        else
            local sid = self.landing_cfg[index].reward[1][1]
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, sid)
        end
    end
end

---成功领取奖励回调
function EightTheLoginView:JiangLiHuiDiao(msg)
    _G.StorageManager:GetInstance():ReceiveAwardData(msg)

    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
    -- _G.table.insert(require("EightTheLoginManager"):GetInstance().Data.g_sids, self.XuanZho)
    if require("EightTheLoginManager"):GetInstance().Data.g_sids == nil then
        require("EightTheLoginManager"):GetInstance().Data.g_sids = {}
    end
    _G.table.insert(require("EightTheLoginManager"):GetInstance().Data.g_sids, self.XuanZho)

    if require("EightTheLoginManager"):GetInstance():InitialBoll() == false then
        _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.LimitGift)

        _G.Events:GetInstance():RemoveListener(_G.EightTheLoginEnum.EightTheLoginXianShi, self.XianShi, self)

        self:Close()
    end
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.MainEight.id)
    self:XianShi()
end
---试玩战斗
function EightTheLoginView:ZhanDou()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.EightTheLoginView.Name)
    local id = self.landing_cfg[8].reward
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonIllustrationsH5View.Name, id, self.DaKai)
    -- require "CommonTipManager":GetInstance():OpenCardTip(id, nil, self.DaKai)
end
function EightTheLoginView.DaKai()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.EightTheLoginView.Name)
end
---按钮点击事件在这里派发
function EightTheLoginView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_guanbi" then
        _G.Events:GetInstance():RemoveListener(_G.EightTheLoginEnum.EightTheLoginXianShi, self.XianShi, self)

        self:Close()
    elseif name == "@_aorbtn_shiwanBtn" then
        --require "CommonTipManager":GetInstance():OpenCardTip(self.landing_cfg[8].reward[1][1], nil, self.DaKai)
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.InitialView.Name)
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CommonIllustrationsH5View.Name,
            self.landing_cfg[8].reward[1][1],
            self.DaKai
        )
    elseif name == "@_aorbtn_mingrilingqu" then
        if self.DQKeXuanZho >= 8 then
            self.XuanZho = 8
            require("EightTheLoginManager"):GetInstance():OpenTip(self.XuanZho, _G.handler(self, self.JiangLiHuiDiao))
        else
            local content = _G.LangUtil.GetLangPackValue(_G.ConfigManager.tips_system_cfg[470102].content)
            _G.PopWindowManager:GetInstance():ShowAllTips(470102, content, nil)
        end
    end
end

function EightTheLoginView:InitFinalAward()
    local data = self.landing_cfg[8].reward[1]
    self.go_table.obj_wupin:RemoveAllChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        data,
        self.go_table.obj_wupin,
        function(item)
            self:TeXiaoShengCheng(item.gameObject, data[1])
            item.gameObject:SetLocalPosition(0, 0, 0)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end)
    self.go_table.aortext_name.text = _G.StorageManager:GetInstance():GetItemName(data[1])
end
return EightTheLoginView
