---充值奖励刷新
function RechargeDailyView:YeMian(id)
    local cfg = self.cfg[id]
    local isBuy = RechargeDailyModel:GetInstance():GetCashNumtimes(cfg.id)
    local CashNum = RechargeDailyModel:GetInstance():GetCashNum(cfg.id)
    self.go_table.obj_thirtyobj:RemoveAllChildren()
    for _, value in pairs(cfg.goods) do
        StorageManager:GetItemBaseViewNew(
            value,
            self.go_table.obj_thirtyobj,
            function(tran)
                tran.gameObject:SetLocalScaleXYZ(0.9)
                tran:SetGou(isBuy)
                tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                if tran.SetGradeNew then
                    tran:SetGradeNew(false)
                end
                if CoreSid[value[1]] then
                    tran:ShowEffect()
                end
            end
        )
    end
    local finalPrice = require "MallManager":GetInstance():GetFinalPrice(cfg.price_id)
    local str = GetLangPackValue(90021600061)
    local isGray = CashNum >= finalPrice and isBuy
    local color = "8C2D14"
    if _G.AppSetting.IsXzns then
        color = "895334"
    end
    self.go_table.aorbtn_thirty:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
        _G.ColorTools.FormatColorByString(isGray and "A9A9A9" or "FFFFFF")
    self.go_table.aortext_thirty.color = _G.ColorTools.FormatColorByString(isGray and "434343" or color)
    self.go_table.aorbtn_thirty:SetGray(false)
    self.go_table.obj_redpoint:SetActiveE(0)
    self.aorbtn_thirty = true
    if CashNum >= finalPrice then
        if isBuy then
            self.aorbtn_thirty = false
            self.go_table.aorbtn_thirty:SetGray(true)
            str = GetLangPackValue(90023800011)
        else
            self.go_table.obj_redpoint:SetActiveE(1)
            str = GetLangPackValue(90000010016)
        end
    end
    local price = _G.GameUtil.SetPriceByChannel(cfg.price_id)
    local ZNum = _G.GameUtil.GetPriceContentByNum(CashNum)
    if not _G.GameUtil.CheckVoucherModel() then
        self.go_table.aortext_Czlj.text  = _G.GetLangPackValue(90030400008, price)
        self.go_table.aortext_jindu.text = _G.GetLangPackValue(90030400011, ZNum, price)
    else
        self.go_table.aortext_Czlj.text  = _G.GetLangPackValue(90036300014, price)
        self.go_table.aortext_jindu.text = _G.GetLangPackValue(90030400011, ZNum, price)
    end

    self.go_table.aortext_thirty.text = str
end

function RechargeDailyView:ShowGrid()
    local cfg, item, goods, tb
    self.isBuy = {}
    local list = { 1001001, 1001002, 1001003, 1001004 }
    self.totalPrice = 0
    for i = 1, 4 do
        local count = 0
        if list[i] then
            cfg = self.cfg[list[i]]
            if cfg then
                local isfree = false
                if not self.GiftItemList[i] then
                    item = _G.InstantiateObject(self.go_table.obj_item, self.go_table.obj_Grid)
                    self.GiftItemList[i] = item
                end
                tb = _G.GetAutoGoTable(self.GiftItemList[i], _G.handlerbind(self, self.OnClickGift, cfg))
                tb.aortext_tittle.text = GetLangPackValue(cfg.name)

                tb.obj_redpoint:SetActiveE(0)

                local finalPrice = require "MallManager":GetInstance():GetFinalPrice(cfg.price_id)

                if RechargeDailyModel:GetInstance():GetCashNumtimes(1001000) and finalPrice ~= 0 then
                    self.isBuy[i] = true
                else
                    self.isBuy[i] = RechargeDailyModel:GetInstance():GetCashNumtimes(cfg.id)
                end
                if finalPrice == 0 then
                    tb.aortext_get.text = GetLangPackValue(90028800002)
                    if not self.isBuy[i] then
                        tb.obj_redpoint:SetActiveE(1)
                        isfree = true
                    end
                else
                    if self.isBuy[i] then
                        tb.aortext_get.text = GetLangPackValue(90023800011)
                    else
                        self.totalPrice = self.totalPrice + finalPrice
                        --local gearCfg = StoreCfg[cfg.price]
                        local content = _G.GameUtil.SetPriceByChannel(cfg.price_id)
                        if _G.GameUtil.IsNotPlatformSpecial() then
                            tb.aortext_get.text = content
                            if _G.GameUtil.CheckVoucherModel() then
                                _G.GameUtil.AddDouYinIcon(tb.aorbtn_get, true)
                            end
                        else
                            if _G.AppSetting.IsAlipayIos then
                                tb.aortext_get.text = content .. GetLangPackValue(90021800551)
                            else
                                tb.aortext_get.text = GetLangPackValue(90000010817, content)
                            end
                        end
                    end
                end
                goods = cfg.goods
                tb.aorbtn_get:SetActiveE(1)
                tb.obj_mask:SetActiveE(self.isBuy[i] and 1 or 0)
                tb.aortext_get:SetActiveE(self.isBuy[i] and 0 or 1)
                for j = 1, #goods do
                    count = count + 1
                    if goods[j] then
                        if not self.ItemList[i] then
                            self.ItemList[i] = {}
                        end
                        if not self.ItemList[i][j] then
                            local array = { goods[j][1], goods[j][2] }
                            StorageManager:GetItemBaseViewNew(
                                array,
                                tb.obj_itemRoot,
                                function(tran)
                                    tran.gameObject:SetLocalScaleXYZ(0.83)
                                    if _G.AppSetting.IsXzns then
                                        tran:SetGou(self.isBuy[i])
                                    end
                                    if CoreSid[array[1]] then
                                        if tran.SetGradeNew then
                                            tran:SetGradeNew(false)
                                        end
                                        tran:ShowEffect()
                                    end
                                    tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                                    if tran.SetGradeNew then
                                        tran:SetGradeNew(false)
                                    end
                                    self.ItemList[i][j] = tran
                                    --if isfree then
                                    --    local eff = _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang
                                    --    _G.UIUtils.LoadEffectByCfg(
                                    --        eff,
                                    --        tran.gameObject,
                                    --        function(trans)
                                    --            if _G.IsNil(tran) then
                                    --                _G.DestroyObject(trans)
                                    --                return
                                    --            end
                                    --        end
                                    --        )
                                    --    end
                                end
                            )
                        else
                            _G.DelayFrameDo(function()
                                self.ItemList[i][j]:SetGou(self.isBuy[i])
                            end)
                        end
                    end
                end
                tb["obj_itemRoot"]:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.GridLayoutGroup)).enabled = false
                tb["obj_itemRoot"]:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.GridLayoutGroup)).enabled = true
            end
        else
            if self.GiftItemList[i] then
                self.GiftItemList[i].gameObject:SetActiveE(0)
            end
        end
    end
end

function RechargeDailyView:OnClickGift(go, isOn, cfg)
    local name = go:GetName()
    if name == "@_aorbtn_get" then
        if RechargeDailyModel:GetInstance():GetCashNumtimes(cfg.id) then
            return
        end
        if cfg.price_id == 0 then
            RechargeDailyModel:GetInstance():GetFreeAward(
                cfg.id,
                function()
                    self:UpDateObj()
                end
            )
        else
            if RechargeDailyModel:GetInstance():GetCashNumtimes(1001000) then
                return
            else
                RechargeDailyModel:GetInstance():Buy(cfg.id)
            end
        end
    end
end

function RechargeDailyView:BtnAli()
    local list = { 1001000, 1001002, 1001003, 1001004 }
    local is = false
    for key, value in pairs(list) do
        if RechargeDailyModel:GetInstance():GetCashNumtimes(value) then
            is = true
        end
    end
    if is then
        self.go_table.aorbtn_getAll:SetGray(true)
        self.getAll = false
        --self.go_table.aorbtn_getAll.interactable = false
    else
        self.getAll = true
        self.go_table.aorbtn_getAll:SetGray(false)
        self.go_table.aorbtn_getAll.interactable = true
    end
    local color = "8C2D14"
    if _G.AppSetting.IsXzns then
        color = "895334"
    end
    self.go_table.aorbtn_getAll:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
        _G.ColorTools.FormatColorByString(is and "A9A9A9" or "FFFFFF")
    self.go_table.aortext_buyall.color = _G.ColorTools.FormatColorByString(is and "434343" or color)
    self.go_table.aortext_getall.color = _G.ColorTools.FormatColorByString(is and "434343" or color)
    local cfg = self.cfg[1001000]
    local finalPrice
    if not _G.GameUtil.IsNotPlatformSpecial() then
        if _G.AppSetting.IsDouYinIos then
            self.go_table.aortext_buyall.text = GetLangPackValue(90030400012)
        elseif _G.AppSetting.IsAlipayIos then
            self.go_table.aortext_buyall.text = GetLangPackValue(90030400015)
        end
        local _, price, _ = _G.GameUtil.SetPriceByChannel(cfg.price_id)
        finalPrice = price
    else
        local _, price, _ = _G.GameUtil.SetPriceByChannel(cfg.price_id)
        finalPrice = price

        local isVoucher = _G.GameUtil.CheckVoucherModel()
        if isVoucher then
            self.go_table.aortext_buyall.text = _G.GetLangPackValue(90036300013, _G.GameUtil.GetPriceContentByNum(price, true))
        else
            self.go_table.aortext_buyall.text = _G.GetLangPackValue(90030400005, price)
        end
    end

    if not is then
        --英文版折扣表述不同，区分处理
        local discount = finalPrice / (self.totalPrice / 100)
        if _G.GameUtil.GetIsUseChinese() then
            self.go_table.aortext_discount.text = _G.math.modf(discount * 100) / 10 .. _G.GetLangPackValue(90022500788)
        else
            self.go_table.aortext_discount.text = "-" .. (100 - _G.math.modf(discount * 100)) .. "%"
        end
    else
        self.go_table.obj_discount:SetActiveE(0)
    end
    --self.go_table.aorbtn_getAll.interactable = false
end

--按钮点击事件派发
function RechargeDailyView:OnClickBtn(go, isOn)
    local name = go:GetName()

    if name == "@_aorbtn_getAll" then
        if self.getAll then
            RechargeDailyModel:GetInstance():Buy(1001000)
        end
    elseif name == "$_toggle_daily" then
        if self.ToggleNum == 1 then
            return
        end
        self.ToggleNum = 1
        self:UpDateObj()
    elseif name == "$_toggle_thirty" then
        if self.ToggleNum == 2 then
            return
        end
        self.ToggleNum = 2
        self:UpDateObj()
    elseif name == "$_toggle_sixty" then
        -- body
        if self.ToggleNum == 3 then
            return
        end
        self.ToggleNum = 3
        self:UpDateObj()
    elseif name == "@_aorbtn_thirty" then
        local id = { 1001101, 1001102 }
        local cfg = self.cfg[id[self.ToggleNum - 1]]
        local CashNum = RechargeDailyModel:GetInstance():GetCashNum(cfg.id)
        local finalPrice = require "MallManager":GetInstance():GetFinalPrice(cfg.price_id)
        if CashNum < finalPrice then
            _G.JumpManager:GetInstance():Jump(159001)
            return
        end
        if self.aorbtn_thirty then
            -- body
            if self.ToggleNum == 2 then
                RechargeDailyModel:GetInstance():GetFreeAward(1001101, _G.handlerbind(self, self.UpDateObj))
            elseif self.ToggleNum == 3 then
                RechargeDailyModel:GetInstance():GetFreeAward(1001102, _G.handlerbind(self, self.UpDateObj))
            end
        end
    elseif name == "@_aorbtn_Tishi" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 104)
    elseif name == "@_aorbtn_closeView" or name == "@_aorbtn_closeN" then
        self:Close()
    end
end

return RechargeDailyView
