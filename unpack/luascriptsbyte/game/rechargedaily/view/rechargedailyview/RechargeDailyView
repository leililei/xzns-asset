local RechargeDailyModel
---@class RechargeDailyView : UIBaseView
local RechargeDailyView = _G.BaseClass("RechargeDailyView", _G.UIBaseView)
local GetLangPackValue = _G.GetLangPackValue
local StorageManager = _G.StorageManager:GetInstance()
function RechargeDailyView:Awake()
    _G.PlayerPrefsManager.SetInt("RechargeDailyView", _G.TimeUtil.GetServerUnixTime())

    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    RechargeDailyModel = require "RechargeDailyModel"
    self.ToggleNum     = 1
    self.cfg           = _G.ConfigManager.store_piece_cfg
    self.GiftItemList  = {}
    self.ItemList      = {}
    self:TimesNew()
    self.timeTimer = _G.TimerManager:GetInstance():GetTimer(1, self.TimesNew, self)
    self.timeTimer:Start()
end

local CoreSid = {
    [209030024] = true, --sr五行自选卡碎片
    [209030025] = true  --神卡选择碎片
}

function RechargeDailyView:OnCreate()
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.RechargeDailyView, self.go_table)
    self.go_table.aortext_Lj.text = "16"
    --_G.UIUtils.LoadEffectByPath("spine/ui/xialing/prf_xialing", self.go_table.obj_role, function(tran)
    --    if self:IsNil() then
    --        _G.DestroyObject(tran)
    --    end
    --end)
    self.Btns_lists = {
        [1] = self.go_table.toggle_daily,
        [2] = self.go_table.toggle_thirty,
        [3] = self.go_table.toggle_sixty,
    }
    for i = 1, 3 do
        local tb = _G.GetAutoGoTable(self.Btns_lists[i])
        UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.RechargeDailyViewToggleDaily, tb)
    end
    self:UpDateDayButtonNew()
    if not _G.UIUtils.IsHaveChange(_G.IsNeedChangeUI.RechargeDailyView, "obj_spine") then
        require("CardInfoManager"):GetInstance().GetRole(
            _G.ConfigManager.card_cfg[116030000].ModelPathHi,
            _G.ePoolType.Temporary,
            self.go_table.obj_spine,
            nil,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                end
            end
        )
    end


    self:UpDateObj()
    if _G.AppSetting.IsXzns then
        self.go_table.obj_spine:GetComponentE(_G.typeof(_G.CS.AorRawImage)):LoadImage("ImagesH5/hRechargeDaily/ui_mrcz_juese")
        _G.GameUtil.SetUiHeXieMask(self.go_table)
    end
end

function RechargeDailyView:UpDateDayButtonNew()
    local lanId
    for i = 1, 3 do
        local tb = _G.GetAutoGoTable(self.Btns_lists[i])
        if i == 3 then
            lanId = 90030400003
            if _G.AppSetting.IsDouYinIos then
                lanId = 90030400013
            elseif _G.AppSetting.IsAlipayIos then
                lanId = 90030400016
            end
            lanId = _G.GameUtil.GetVoucherArg(lanId, 90036300037)
            tb.aortext_GrayFriend.text = _G.GetLangPackValue(lanId)
            tb.aortext_Friend.text = _G.GetLangPackValue(lanId)
        end

        if i == 2 then
            lanId = 90030400002
            if _G.AppSetting.IsDouYinIos then
                lanId = 90030400012
            elseif _G.AppSetting.IsAlipayIos then
                lanId = 90030400015
            end
            lanId = _G.GameUtil.GetVoucherArg(lanId, 90036300036)
            tb.aortext_GrayFriend.text = _G.GetLangPackValue(lanId)
            tb.aortext_Friend.text = _G.GetLangPackValue(lanId)
        end
    end
end

function RechargeDailyView:OnStartClose()
    if self.timeTimer then
        self.timeTimer:Stop()
    end
end

---刷新页面
function RechargeDailyView:UpDateObj()
    self.go_table.obj_daily:SetActiveE(0)
    self.go_table.obj_thirty:SetActiveE(0)
    --self.go_table.obj_sixty:SetActiveE(0)
    self.go_table.aorrawimage_Czlj:SetActiveE(0)
    --self.go_table.aorimage_komgbai:SetActiveE(1)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RechargeDailyGift.id)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg
        .RechargeDailyGiftThirty.id)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg
        .RechargeDailyGiftSixtyEight.id)
    if self.ToggleNum == 1 then
        self.go_table.obj_daily:SetActiveE(1)
        --self.go_table.aorimage_komgbai:SetActiveE(1)
        self:ShowGrid()
        self:BtnAli()
    elseif self.ToggleNum == 2 then
        self.go_table.obj_thirty:SetActiveE(1)
        self.go_table.aorrawimage_Czlj:SetActiveE(1)
        self:YeMian(1001101)
        if _G.AppSetting.IsXzns then
            self.go_table.aorrawimage_30:SetActiveE(1)
            self.go_table.aorrawimage_68:SetActiveE(0)
        end
    elseif self.ToggleNum == 3 then
        self.go_table.obj_thirty:SetActiveE(1)
        self.go_table.aorrawimage_Czlj:SetActiveE(1)
        self:YeMian(1001102)
        if _G.AppSetting.IsXzns then
            self.go_table.aorrawimage_30:SetActiveE(0)
            self.go_table.aorrawimage_68:SetActiveE(1)
        end
    end
end

---时间刷新
