---@class RechargeDailyModel : GameDataModelBase
---@field GetInstance fun():RechargeDailyModel
local RechargeDailyModel = _G.BaseClass("RechargeDailyModel", _G.GameDataModelBase)

local RechargeDailyNet = require "RechargeDailyNet"
function RechargeDailyModel:__init()
    self.curFunctionOpenID = 149
    --累计充值
    self.cash_num = 0
    --礼包购买次数
    self.times = {}

    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

---@return RechargeDailyModel
function RechargeDailyModel:GetInstance()
    return self.super.GetInstance(self)
end

function RechargeDailyModel:GetDataFormServer()
    RechargeDailyNet:GetInstance():GetPopAwardInfos(_G.handler(self, self.ParseData))
end

function RechargeDailyModel:OnSixClockUpdate(endcall)
    self:OnSixUpdate()
    self.super.OnSixClockUpdate(self, endcall)
end

---解析数据
---@param data table 服务器返回数据
function RechargeDailyModel:ParseData(data)
    self.cash_num = data.cash_num
    self.times = data.sid_list or {}
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.RechargeDailyView.Name)
    if view then
        view:UpDateObj()
    end
    self.super.ParseData(self)
    -- require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FirstCharge.id)
end

---获取充值金额
function RechargeDailyModel:GetCashNum()
    return self.cash_num
end

---设置充值金额
function RechargeDailyModel:AddCashNum(num)
    self.cash_num = num + self.cash_num
end

---获取当前礼包是否购买
function RechargeDailyModel:GetCashNumtimes(id)
    local num = false
    for key, value in pairs(self.times) do
        if value == id then
            num = true
        end
    end
    return num
end

---购买礼包加入购买列表
function RechargeDailyModel:AddCashNumtimes(id)
    local num = true
    for key, value in pairs(self.times) do
        if value == id then
            --value.v = num
            num = false
        end
    end
    if num then
        _G.table.insert(self.times, id)
    end
    return num
end

---领取免费礼包
function RechargeDailyModel:GetFreeAward(id, call)
    local msg = {sid = id}
    RechargeDailyNet:GetInstance():GetAward(msg, _G.handlerbind(self, self.GetFreeAwardSuccess, id, call))
end

---领取付费礼包
function RechargeDailyModel:GetAllAward(sid, call)
    RechargeDailyNet:GetInstance():GetAward(sid, _G.handlerbind(self, self.GetAllAwardSuccess, sid, call))
end

function RechargeDailyModel:GetFreeAwardSuccess(msg, sid, call)
    if msg.ack ~= 1 then
        return
    end
    self:AddCashNumtimes(sid)
    if call then
        call()
    end
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RechargeDailyGift.id)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
        _G.ConfigManager.redpoint_cfg.RechargeDailyGiftThirty.id
    )
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
        _G.ConfigManager.redpoint_cfg.RechargeDailyGiftSixtyEight.id
    )
    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
    require "CommonTipManager".OpenCommonAwardView(msg)
end

--购买
function RechargeDailyModel:Buy(sid)
    local cfg = _G.ConfigManager.store_piece_cfg[sid]
    if cfg ~= nil then
        require("MallManager"):GetInstance():BuyActiveGift(cfg.price_id, nil, sid)
    end
end

function RechargeDailyModel:OnMallCashListener(data)
    -- 判断是否为计入累计充值
    if not data.total_cash_bool then
        return
    end
    local cfg = _G.ConfigManager.store_piece_cfg[data.sid]
    if cfg ~= nil then
        local finalPrice = require "MallManager":GetInstance():GetFinalPrice(cfg.price_id)
        if 1001000 == data.sid then
            self:AddCashNum(finalPrice)
            local list = {1001000, 1001002, 1001003, 1001004}
            for key, value in pairs(list) do
                cfg = _G.ConfigManager.store_piece_cfg[value]
                self:AddCashNumtimes(value)
            end
        else
            self:AddCashNum(finalPrice)
            self:AddCashNumtimes(data.sid)
        end
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.RechargeDailyView.Name)
        if view then
            view:UpDateObj()
        end
    else
        self:AddCashNum(data.cash_rmb)
    end
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
        _G.ConfigManager.redpoint_cfg.RechargeDailyGiftThirty.id
    )
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
        _G.ConfigManager.redpoint_cfg.RechargeDailyGiftSixtyEight.id
    )
end

function RechargeDailyModel:CheckMianfe()
    local IsOpen = 0
    local cfg = _G.ConfigManager.store_piece_cfg[1001001]
    if cfg == nil then
        return IsOpen
    end
    local isBuy = self:GetCashNumtimes(cfg.id)
    local CashNum = self:GetCashNum(cfg.id)
    local finalPrice = 0
    if cfg.price_id > 0 then
        local finalPrice = require "MallManager":GetInstance():GetFinalPrice(cfg.price_id)
        finalPrice = finalPrice
    end
    if CashNum >= finalPrice then
        if not isBuy then
            IsOpen = 1
        end
    end
    if self:CheckRedPoint() == 1 then
        IsOpen = 1
    end
    return IsOpen
end

