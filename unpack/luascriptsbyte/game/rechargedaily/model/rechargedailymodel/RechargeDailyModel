---检测红点
function RechargeDailyModel:CheckRedPoint()
    local IsOpen = 0
    local redPoint = _G.PlayerPrefsManager.GetInt("RechargeDailyView")
    if redPoint == nil or redPoint == 0 then
        IsOpen = 1
    elseif _G.TimeUtil.GetInterValDayByGame(_G.TimeUtil.GetServerUnixTime(), redPoint) >= 1 then
        IsOpen = 1
    end
    return IsOpen
end

--是否显示
function RechargeDailyModel.RechargeDailyModelPanDuan()
    return require("RechargeDailyModel"):GetInstance():RechargeDailyModelBoll()
end

function RechargeDailyModel:RechargeDailyModelBoll()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(149) then
        return false
    end

    return true
end

---获取18/30/68档购买总次数
function RechargeDailyModel:GetThreeBuyTimes()
    local num = 0
    if self:GetCashNumtimes(1001101) then
        num = num + 1
    end
    if self:GetCashNumtimes(1001102) then
        num = num + 1
    end
    if self:GetCashNumtimes(1001000) or self:GetCashNumtimes(1001004) then
        num = num + 1
    end
    return num
end

function RechargeDailyModel:OnSixUpdate()
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RechargeDailyGift.id)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
        _G.ConfigManager.redpoint_cfg.RechargeDailyGiftThirty.id
    )
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
        _G.ConfigManager.redpoint_cfg.RechargeDailyGiftSixtyEight.id
    )
end

---重连成功调用
---@param endcall function 完成回调
function RechargeDailyModel:ReConnect(endcall)
    self:InitData(endcall)
end

function RechargeDailyModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

return RechargeDailyModel
