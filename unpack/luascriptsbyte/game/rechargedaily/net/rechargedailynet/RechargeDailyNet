---@class RechargeDailyNet : BaseGameNet
---@field GetInstance fun():RechargeDailyNet
local RechargeDailyNet = _G.BaseClass("RechargeDailyNet", require "BaseGameNet")
local base = require "BaseGameNet"
---@return RechargeDailyNet RechargeDailyNet

function RechargeDailyNet:GetInstance()
    return base.GetInstance(self)
end

---获取首充信息
---@param pbData table PB数据
---@param callback function 完成回调
---@field s2c_game_store_pop_info 返回的信息数组
function RechargeDailyNet:GetPopAwardInfos(callback)
    local item = _G.ConfigManager.net_map.game_store_day_first_get_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.SuccessCall))
    self.Call[port] = callback
end

---领取奖励
---@param pbData table PB数据
---@param callback function 完成回调
---@field s2c_game_store_pop 返回的信息数组
function RechargeDailyNet:GetAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_store_day_first_get_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.SuccessCall))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function RechargeDailyNet:SuccessCall(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return RechargeDailyNet
