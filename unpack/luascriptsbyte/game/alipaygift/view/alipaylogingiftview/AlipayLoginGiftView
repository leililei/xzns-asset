---@class AlipayLoginGiftView : UIBaseView	中文描述
---@field public go_table AlipayLoginGift_GoTable GoTable
local AlipayLoginGiftView = _G.BaseClass("AlipayLoginGiftView", _G.UIBaseView)

function AlipayLoginGiftView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function AlipayLoginGiftView:OnCreate()
    self:RefreshAward()

    self.go_table.aortext_link:SetActiveE(_G.AppSetting.IsAlipayPC and 0 or 1)
    self.go_table.aorbtn_copy:SetActiveE(_G.AppSetting.IsAlipayPC and 0 or 1)

    local isGet = require("AlipayLoginGiftModel"):GetInstance():GetAlipayPCAwardBol()
    self.go_table.aorbtn_get:SetActiveE((_G.AppSetting.IsAlipayPC and not isGet) and 1 or 0)
    self.go_table.obj_got:SetActiveE((_G.AppSetting.IsAlipayPC and isGet) and 1 or 0)

    _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.AlipayLoginGift, 1)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedLoginwithgifts.id)
end

function AlipayLoginGiftView:RefreshAward()
    self.award = require("AlipayLoginGiftModel"):GetInstance():GetAwardCfg()
    local count = #self.award
    if not self.InitList then
        self.InitList = true
        self.go_table.scrollloophorizontal_item:InitItemData(count, _G.handler(self, self.RefreshList))
    end
    self.go_table.scrollloophorizontal_item:UpdateScrollRectWeight(130 * count)
end

function AlipayLoginGiftView:RefreshList(index, obj)
    local tb = _G.GetAutoGoTable(obj)

    tb.obj_root:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        self.award[index + 1],
        tb.obj_root,
        function(tran)
            if self:IsNil() then
                _G.DestroyObject(tran);
                return
            end

            if tran.ShowNumText then
                tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
        end
    )
end

---界面的销毁函数
function AlipayLoginGiftView:OnDestroy()
end

---按钮点击事件在这里派发
function AlipayLoginGiftView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeView or go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_copy then
        _G.SDKManager:GetInstance():SetClipboard(self.go_table.aortext_link.text)
    elseif go == self.go_table.aorbtn_get then
        require("AlipayLoginGiftModel"):GetInstance():GetAward(function()
            self:Close()
        end)
    end
end

return AlipayLoginGiftView
