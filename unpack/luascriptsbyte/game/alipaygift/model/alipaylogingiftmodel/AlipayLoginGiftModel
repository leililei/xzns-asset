---@class AlipayLoginGiftModel : Singleton	中文描述
local AlipayLoginGiftModel = _G.BaseClass("AlipayLoginGiftModel", _G.Singleton)

---@return AlipayLoginGiftModel AlipayLoginGiftModel
function AlipayLoginGiftModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function AlipayLoginGiftModel:__init()
    self.discreteId = 126107
end

function AlipayLoginGiftModel:OnSixClockUpdate()
    if _G.AppSetting.IsAlipay then
        local desktop = _G.PlayerModel:GetInstance().desktop_award or {}
        for i, v in pairs(desktop) do
            if v.key == self.discreteId then
                _G.table.remove(desktop, i)
                break
            end
        end

        _G.FunctionManager:GetInstance():OpenFunById(_G.MainFunctionItems.AlipayGift)
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedLoginwithgifts.id)
    end
end

function AlipayLoginGiftModel:CheckFuncOpen()
    if not _G.AppSetting.IsAlipay or require("AlipayLoginGiftModel"):GetInstance():GetAlipayPCAwardBol() then
        return false
    end

    return true
end

function AlipayLoginGiftModel:GetAwardCfg()
    return _G.ConfigManager.discrete_cfg[self.discreteId] or {}
end

--获取是否领取抖音PC每日奖励
function AlipayLoginGiftModel:GetAlipayPCAwardBol()
    self.awardID = _G.PlayerModel:GetInstance().desktop_award or {}
    for _, v in ipairs(self.awardID) do
        if v.key == self.discreteId then
            return true
        end
    end
    return false
end

function AlipayLoginGiftModel:CheckRedPoint()
    if not _G.AppSetting.IsAlipay then
        return 0
    end

    if _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.AlipayLoginGift, 0) == 0 then
        return 1
    end

    if _G.AppSetting.IsAlipayPC and not require("AlipayLoginGiftModel"):GetInstance():GetAlipayPCAwardBol() then
        return 1
    end
    return 0
end

function AlipayLoginGiftModel:GetAward(callBack)
    require("DouyinModel"):GetInstance():GetAward({ self.discreteId }, function()
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedLoginwithgifts.id)
        _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.AlipayGift)

        if callBack then
            callBack()
        end
    end)
end

---销毁对象时,析构函数
function AlipayLoginGiftModel:Dispose()
end

return AlipayLoginGiftModel
