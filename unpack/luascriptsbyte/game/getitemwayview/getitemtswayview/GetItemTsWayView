require "JumpManager"

---@class GetItemTsWayView : UIBaseView	中文描述
---@field public go_table GetItemTsWayView_GoTable GoTable
local GetItemTsWayView = _G.BaseClass("GetItemTsWayView", _G.UIBaseView)

local GetLangPackValue = _G.GetLangPackValue
local WayPath = "UIH5/GetItemWayView/$_obj_SingleWay"

function GetItemTsWayView:Awake()
    self.Way = {}
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

---界面的入口函数
function GetItemTsWayView:OnCreate(sid, num, carddata, call)
    if sid == 0 then
        self:Close()
        return
    end
    self.call = call
    ---@type currency_type_cfg
    self.Cfg = _G.ConfigManager.currency_type_cfg[sid]
    self.Num = num
    local wayId = self.Cfg.way[1]
    self.WayCfg = _G.ConfigManager.item_way_cfg[wayId]

    self.CardData = carddata

    self:SetData()
    self:SetGift(sid)
end
local ParseParam = function(param)
    local tmp = tonumber(param)
    if tmp then
        return tmp
    else
        return param
    end
end
function GetItemTsWayView:CheckIsSection()
    local world = _G.WorldManager:GetInstance():GetCurWorld()
    return world.Cfg.Scene_Type == _G.SceneType.Section
end
function GetItemTsWayView:SetData()
    self.go_table.aorrawimage_PropIcon:LoadImage(self.Cfg.icon)
    self.go_table.aortext_PropDes.text = GetLangPackValue(self.Cfg.Describe)

    local colorIndex = self.Cfg.Quality

    if colorIndex == nil then
        self.go_table.aorimage_Color.enabled = false
    else
        self.go_table.aorimage_Color.SpriteName = _G.ItemBaseIconName[colorIndex]
    end

    self.go_table.aortext_PropName.text = GetLangPackValue(self.Cfg.name)
    if self.Num ~= nil then
        self.go_table.aortext_num.text = _G.GameUtil.NumberToUnitStr(self.Num)
    else
        self.go_table.aortext_num:SetActiveE(0)
    end

    ---组件未自动生效，手动计算高度
    local rect = self.go_table.aortext_PropDes:GetComponentE(typeof(_G.CS.UnityEngine.RectTransform))
    local x,y = rect:GetRectTransformSizeDelta()
    local row = _G.math.ceil(string.len(self.go_table.aortext_PropDes.text) / 60)
    rect:SetRectTransformSize(x, 22 * row)

    if table.isEmptyOrNil(self.Cfg.way) then
        self.go_table.aortext_Des:SetActiveE(1)
        return
    end
    local cfg = _G.ConfigManager.item_way_cfg

    local wayListCfg = _G.DeepCopyCfgTable(self.Cfg.way)
    local wayList = {}
    for _, v in pairs(wayListCfg) do
        if cfg[v] and _G.GlobalConditionManager.CheckConditionArrays(cfg[v].condition_type) then
            _G.table.insert(wayList, v)
        end
    end
    table.sort(
        wayList,
        function(b, a)
            ---如果b未开放则不交换
            if #cfg[b].function_open >= 2 then
                if not _G[cfg[b].function_open[1]][cfg[b].function_open[2]](ParseParam(cfg[b].function_open[3])) then
                    return false
                end
            end
            ---如果b开放a未开放，则交换
            if #cfg[a].function_open >= 2 then
                if not _G[cfg[a].function_open[1]][cfg[a].function_open[2]](ParseParam(cfg[a].function_open[3])) then
                    return true
                end
            end
            ---其余情况均不交换
            return false
        end
    )

    for _, v in pairs(wayList) do
        _G.PoolsManager:GetInstance():Spawn(
            WayPath,
            _G.ePoolType.UIItem,
            self.go_table.obj_wayContent,
            function(trans)
                if trans == nil then
                    return
                end
                local tb = _G.GetAutoGoTable(trans, _G.handlerbind(self, self.OnGoClick, v))
                if tb == nil then
                    return
                end
                if not table.isEmptyOrNil(cfg[v].function_open) and #cfg[v].function_open >= 2 then
                    if not _G[cfg[v].function_open[1]][cfg[v].function_open[2]](ParseParam(cfg[v].function_open[3])) then
                        tb.aorbtn_GO:SetActiveE(0)
                    else
                        tb.aorbtn_GO:SetActiveE(1)
                    end
                else
                    tb.aorbtn_GO:SetActiveE(1)
                end
                local t_name = GetLangPackValue(cfg[v].name)
                tb.aortext_WayName.text = t_name or GetLangPackValue(90022500393)
            end
        )
    end
end

---设置礼包
function GetItemTsWayView:SetGift(sid)
    local giftData = require "GiftModel":GetInstance():GetGoods(1)
    self.curGiftData = nil
    for _, v in pairs(giftData) do
        if v.cfg and v.cfg.resource_id and v.cfg.resource_id == sid and not v.sellout then
            self.go_table.aortext_limitTimes.text = _G.GetLangPackValue(90000010359, v.cfg.count_limit)
            if not v.cfg.price or v.cfg.price == 0 then
               self.go_table.aortext_price.text = _G.GetLangPackValue(90023900001)
            else
                local curPrice = _G.GameUtil.RatioControl(v.cfg.price)
                if _G.AppSetting.IsOverseas then
                    self.go_table.aortext_price.text = GetLangPackValue(90000010807,curPrice)
                else
                    self.go_table.aortext_price.text = GetLangPackValue(90000010819,curPrice)
                end  
            end
            self:SetGiftGoods(v.cfg.goods)
            self.curGiftData = v
            return
        end
    end

    self.go_table.obj_gift:SetActiveE(0)
end

function GetItemTsWayView:SetGiftGoods(goods)
    self.giftGoods = goods
    if not self.giftListView then
        self.go_table.scrollloophorizontal_gift:InitItemData(#self.giftGoods, _G.handler(self, self.RefreshGiftGoodsItem))
        self.giftListView = self.go_table.scrollloophorizontal_gift
    else
        self.giftListView:UpdateCount(#self.giftGoods) 
    end
end

function GetItemTsWayView:RefreshGiftGoodsItem(index, obj)
    local data = self.giftGoods[index + 1]
    if not table.isEmptyOrNil(data) then
        local tb = _G.GetAutoGoTable(obj)
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            data,
            tb.gameObject,
            function(trans)
                if data[2] and data[2] > 1 then
                    trans:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end

                if trans.cfg and trans.cfg.ef_item and _G.tonumber(trans.cfg.ef_item) == 1 then
                    trans:ShowEffect(true)
                end
            end
        ) 
    end
end

---点击购买
function GetItemTsWayView:OnClickBuyBtn()
    local cfg = self.curGiftData.cfg
    if not cfg.price or cfg.price == 0 then
        require("MallManager"):GetInstance():Buy(
            cfg.id,
            function(data)
                require("MallManager"):GetInstance():OnUpMallBuy(data, cfg.id)
                self:OnMallCashListener(data)
                require "GiftModel":GetInstance():BuyGift(self.curGiftData)
                require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                    _G.ConfigManager.redpoint_cfg.StoreActive.id
                )
                self:SetGift(self.data)
            end
        )
    else
        require("MallManager"):GetInstance():BuyActiveGift(cfg.price, nil, cfg.id)
    end
end

---购买成功筛选回调
function GetItemTsWayView:OnMallCashListener(data)
    if self.curGiftData and data.sid == self.curGiftData.id then
        require "GiftModel":GetInstance():BuyGift(self.curGiftData)
        require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.StoreActive.id)
        self:SetGift(data.sid) 
    end
end

---当前往点击
function GetItemTsWayView:OnGoClick(go, isOn, sid)
    _G.UIManager:GetInstance():SwitchSceneCloseWindows()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CardDevelopView.Name, {cardUid = self.CardData.uid})
end

---按钮点击事件在这里派发
function GetItemTsWayView:OnClickBtn(go)
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView2" or name == "@_aorbtn_CloseView" then
        if self.call then
            self.call()
        end
        self:Close()
    elseif name == "@_aorbtn_Buy" then
        self:OnClickBuyBtn()
    end
end

function GetItemTsWayView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

return GetItemTsWayView
