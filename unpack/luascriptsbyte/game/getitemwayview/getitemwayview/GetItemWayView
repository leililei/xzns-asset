local TrackingPointModel = require("TrackingPointModel")
require "JumpManager"

---@class GetItemWayView : UIBaseView    中文描述
---@field public go_table GetItemWayView_GoTable GoTable
local GetItemWayView = _G.BaseClass("GetItemWayView", _G.UIBaseView)

local typeof = _G.typeof
local table = _G.table
local GetLangPackValue = _G.GetLangPackValue
local WayPath = "UIH5/GetItemWayView/$_obj_SingleWay"
local NameColor = {
    [1] = "FFFFFF",
    [2] = "076b2f",
    [3] = "1461a8",
    [4] = "612b8b",
    [5] = "d2510b",
    [6] = "c62121",
    [7] = "ce9c07",
    [8] = "B381FF"
}

function GetItemWayView:Awake()
    self.Way = {}
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.OnDataUpdate, self)
end

---界面的入口函数
function GetItemWayView:OnCreate(sid, call, isHideNum)
    if sid == 0 then
        self:Close()
        return
    end
    self.call = call
    self.isHideNum = isHideNum
    local _, storageID = _G.StorageManager:GetInstance():CheckSidType(sid)
    self.data = _G.StorageManager:GetInstance():GetItemDataByID(storageID, sid)
    if table.isEmptyOrNil(self.data) then
        self.data = _G.StorageManager:GetInstance():GetItemDataClass(sid, 0)
        self.data:Parse({ sid = sid, num = 0 })
    end
    if not self.data.cfg then
        self:Close()
        return
    end
    self:SetData(self.data)
    self:SetGift(self.data)
    _G.GameUtil.AddDouYinIcon(self.go_table.aorbtn_Buy, true)
end

local ParseParam = function(param)
    local tmp = tonumber(param)
    if tmp then
        return tmp
    else
        return param
    end
end

function GetItemWayView:CheckIsSection()
    local world = _G.WorldManager:GetInstance():GetCurWorld()
    return world.Cfg.Scene_Type == _G.SceneType.Section
end

function GetItemWayView:SetData(data)
    local colorIndex = _G.StorageManager:GetInstance():GetItemGrade(data.sid, data.uid)
    local type = _G.StorageManager:GetInstance():CheckSidType(data.sid)
    if type == _G.StorageType.Material or type == _G.StorageType.Prop or type == _G.StorageType.Remains then
        self.go_table.aorrawimage_PropIcon:LoadImage(
            data.Icon or data.cfg.Icon,
            function()
                -- self.go_table.aorrawimage_PropIcon:SetNativeSize()
            end
        )
        self.go_table.aortext_PropDes.text = GetLangPackValue(data.cfg.Describe)
    elseif type == _G.StorageType.ResProp then
        self.go_table.aorrawimage_PropIcon:LoadImage(
            data.cfg.icon,
            function()
                -- self.go_table.aorrawimage_PropIcon:SetNativeSize()
            end
        )
        self.go_table.aortext_PropDes.text = GetLangPackValue(data.cfg.Describe)
        if data.sid == 101 then
            data.count = require "MonsterSiegeManager":GetInstance():GetCoinActivity()
        elseif data.sid == 103 then
            --公平竞技场
            data.count = require "ArenaFairManager":GetInstance():GetCoin()
        elseif data.sid == 104 then
            --竞猜
            data.count = require "GuessGameModel":GetInstance():GetCoin()
        elseif data.sid == 105 then
            --主题活动代币
            data.count = require "DrawActivityModel":GetInstance():GetCoinNum()
        elseif data.sid == 109 then
            --灵弈对决代币
            data.count = require "SixVsSixCoinModel":GetInstance():GetCoin()
        elseif data.sid == require("DrawUpCoinModel"):GetInstance():GetCoinId() then
            --限时招募
            data.count = require "DrawUpCoinModel":GetInstance():GetCoin()
        elseif data.sid == 111 then
            --主题活动代币
            data.count = require("TreasureHuntingManager"):GetInstance():GetCoin()
        elseif data.sid == 115 then
            data.count = require("PetDrawUpMainModel"):GetInstance():GetCoinIdList(data.sid)
        elseif data.sid == 117 then
            data.count = require("TarotManager"):GetInstance():GetCoinNum()
        elseif data.sid == 118 then
            data.count = require("SwornModel"):GetInstance():GetCoinNum()
        elseif data.sid == 120 then
            ---国庆拼图道具1
            data.count = require("FestivalModel"):GetInstance():GetCoinNum1()
        elseif data.sid == 121 then
            ---国庆拼图道具2
            data.count = require("FestivalModel"):GetInstance():GetCoinNum2()
        elseif data.sid == 124 or data.sid == 128 then
            data.count = require("JointActivityDrawUpModel"):GetInstance():GetCoinIdList(data.sid)
        elseif data.sid == 125 then
            --限时掉落兑换代币
            data.count = require "LimitTimeDropCoinModel":GetInstance():GetCoin()
        elseif data.sid == 127 then
            data.count = require("IceFestivalPuzzleManager"):GetInstance():GetCoinNum1()
        elseif data.sid == 74 then
            data.count = require("ActivityDispatchModel"):GetInstance():GetCoinNum(data.sid)
        elseif data.sid == 191 then
            data.count = require("ActivityTournamentModel"):GetInstance():GetCoinNum(data.sid)
        elseif require("ActivityCumulativeModel"):GetInstance():CheckCoinType(data.sid) then
            data.count = require("ActivityCumulativeModel"):GetInstance():GetCoinNum(data.sid)
        else
            -- 获取不进背包的限时道具
            local count = _G.StorageManager:GetInstance():GetOtherItemCountBySid(data.sid)
            -- 道具数量为零，则不赋值，防止普通道具数量被覆盖
            if count then
                data.count = count
            end
        end
    elseif type == _G.StorageType.Decoration then
        colorIndex = nil
        self.go_table.aorrawimage_PropIcon.enabled = false
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemDecorationBase,
            self.go_table.aorimage_Color,
            function(item)
                item:ShowData(data)
                item.gameObject:SetLocalScaleXYZ(0.81)
            end
        )
        self.go_table.aortext_PropDes.text = GetLangPackValue(data.cfg.describe)
        data.count = 0
    end

    if colorIndex == nil then
        self.go_table.aorimage_Color.enabled = false
    else
        self.go_table.aorimage_Color.SpriteName = _G.ItemBaseIconName[colorIndex]
    end

    self.go_table.aortext_PropName.text = GetLangPackValue(data.cfg.Name or data.cfg.name)
    self.go_table.aortext_PropName.color = _G.ColorTools.FormatColorByString(NameColor[data.Grade] or "FFFFFF")
    if data.count ~= nil then
        if self.isHideNum ~= nil and self.isHideNum == true then
            self.go_table.aortext_num:SetActiveE(0)
        else
            self.go_table.aortext_num.text = data.count
        end
    else
        self.go_table.aortext_num:SetActiveE(0)
    end

    ---组件未自动生效，手动计算高度
    local rect = self.go_table.aortext_PropDes:GetComponentE(typeof(_G.CS.UnityEngine.RectTransform))
    local x, y = rect:GetRectTransformSizeDelta()
    local row = _G.math.ceil(string.len(self.go_table.aortext_PropDes.text) / 60)
    rect:SetRectTransformSize(x, 22 * row)

    if table.isEmptyOrNil(data.cfg.way) then
        self.go_table.aortext_Des:SetActiveE(1)
        return
    end
    local cfg = _G.ConfigManager.item_way_cfg

    local wayListCfg = _G.DeepCopyCfgTable(data.cfg.way)
    local wayList = {}
    for _, v in pairs(wayListCfg) do
        if cfg[v] and _G.GlobalConditionManager.CheckConditionArrays(cfg[v].condition_type) then
            _G.table.insert(wayList, v)
        end
    end
    table.sort(
        wayList,
        function(b, a)
            ---如果b未开放则不交换
            if #cfg[b].function_open >= 2 then
                if not _G[cfg[b].function_open[1]][cfg[b].function_open[2]](ParseParam(cfg[b].function_open[3])) then
                    return false
                end
            end
            ---如果b开放a未开放，则交换
            if #cfg[a].function_open >= 2 then
                if not _G[cfg[a].function_open[1]][cfg[a].function_open[2]](ParseParam(cfg[a].function_open[3])) then
                    return true
                end
            end
            ---其余情况均不交换
            return false
        end
    )

    for _, v in pairs(wayList) do
        _G.PoolsManager:GetInstance():Spawn(
            WayPath,
            _G.ePoolType.UIItem,
            self.go_table.obj_wayContent,
            function(trans)
                if trans == nil then
                    return
                end
                local tb = _G.GetAutoGoTable(trans, _G.handlerbind(self, self.OnGoClick, v))
                if tb == nil then
                    return
                end
                if not table.isEmptyOrNil(cfg[v].function_open) and #cfg[v].function_open >= 2 then
                    if not _G[cfg[v].function_open[1]][cfg[v].function_open[2]](ParseParam(cfg[v].function_open[3])) then
                        tb.aorbtn_GO:SetActiveE(0)
                    else
                        tb.aorbtn_GO:SetActiveE(1)
                    end
                else
                    tb.aorbtn_GO:SetActiveE(1)
                end
                local t_name = GetLangPackValue(cfg[v].name)
                tb.aortext_WayName.text = t_name or GetLangPackValue(90022500393)
            end
        )
    end
end

---设置礼包
function GetItemWayView:SetGift(data)
    local giftData = require "GiftModel":GetInstance():GetGoods(1)
    self.curGiftData = nil
    local storage = _G.StorageManager:GetInstance():GetItemCountBySid(data.cfg.ID)
    self.go_table.aortext_num.text = storage > 0 and storage or data.count
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(26) then
        for _, v in pairs(giftData) do
            if v.cfg and v.cfg.resource_id and v.cfg.resource_id == data.sid and not v.sellout then
                self.go_table.aortext_limitTimes.text = _G.GetLangPackValue(90000010359, v.cfg.count_limit)
                if not v.cfg.price_id or v.cfg.price_id == 0 then
                    self.go_table.aortext_price.text = _G.GetLangPackValue(90023900001)
                else
                    _G.GameUtil.SetPriceByChannel(v.cfg.price_id, self.go_table.aortext_price)
                    _G.GameUtil.AddDouYinIcon(self.go_table.aorbtn_Buy, true)
                end
                self:SetGiftGoods(v.cfg.goods)
                self.curGiftData = v
                return
            end
        end
    end

    self.go_table.obj_gift:SetActiveE(0)
    self.go_table.obj_waySv:SetRectTransformSize(598, 500)
end

function GetItemWayView:SetGiftGoods(goods)
    self.giftGoods = goods
    if not self.giftListView then
        self.go_table.scrollloophorizontal_gift:InitItemData(
            #self.giftGoods,
            _G.handler(self, self.RefreshGiftGoodsItem)
        )
        self.giftListView = self.go_table.scrollloophorizontal_gift
    else
        self.giftListView:UpdateCount(#self.giftGoods)
    end
end

function GetItemWayView:RefreshGiftGoodsItem(index, obj)
    local data = self.giftGoods[index + 1]
    if not table.isEmptyOrNil(data) then
        local tb = _G.GetAutoGoTable(obj)
        tb.gameObject:ClearChildren()
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            data,
            tb.gameObject,
            function(trans)
                if data[2] and data[2] > 1 then
                    trans:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end

                if trans.ShowEffectOrder and trans.cfg then
                    trans:ShowEffectOrder(trans.cfg.ef_item == 1 and true or false)
                end
            end
        )
    end
end

---点击购买
function GetItemWayView:OnClickBuyBtn()
    local cfg = self.curGiftData.cfg
    if not cfg.price_id or cfg.price_id == 0 then
        require("MallManager"):GetInstance():Buy(
            cfg.id,
            function(data)
                require("MallManager"):GetInstance():OnUpMallBuy(data, cfg.id)
                self:OnMallCashListener(data)
                require "GiftModel":GetInstance():BuyGift(self.curGiftData)
                require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                    _G.ConfigManager.redpoint_cfg.StoreActive.id
                )
                self:SetGift(self.data)
            end
        )
    else
        require("MallManager"):GetInstance():BuyActiveGift(cfg.price_id, nil, cfg.id)
    end
end

---购买成功筛选回调
function GetItemWayView:OnMallCashListener(data)
    if self.curGiftData and data.sid == self.curGiftData.id then
        require "GiftModel":GetInstance():BuyGift(self.curGiftData)
        require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.StoreActive.id)
        self:SetGift(self.data)
    end
end

---当前往点击
function GetItemWayView:OnGoClick(go, isOn, sid)
    TrackingPointModel:GetInstance():CloseActTrackingByLast()
    ---检测是否在 怪物攻城界面
    local world = _G.WorldManager:GetInstance():GetCurWorld()
    if world.Sid == 801 then
        require "MonsterSiegeManager":ExitSection(
            function()
                if self:CheckIsSection() then
                    _G.PopWindowManager:GetInstance():ShowAllTips(
                        110104,
                        nil,
                        function()
                            _G.ChapterRoomManager:GetInstance():ExitSectionSelf(
                                function(callback)
                                    _G.JumpManager:GetInstance():Jump(sid, callback)
                                end
                            )
                        end
                    )
                else
                    _G.JumpManager:GetInstance():Jump(sid)
                end
            end
        )
        return
    end

    if self:CheckIsSection() then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            110104,
            nil,
            function()
                _G.ChapterRoomManager:GetInstance():ExitSectionSelf(
                    function(callback)
                        _G.JumpManager:GetInstance():Jump(sid, callback)
                    end
                )
            end
        )
    else
        _G.JumpManager:GetInstance():Jump(sid)
    end
end

function GetItemWayView:OnDataUpdate(data)
    local needRefresh = false
    local id = self.data.cfg.id or self.data.cfg.ID
    for _, v in pairs(data) do
        if v.type[1] == id then
            needRefresh = true
            break
        end
    end
    if needRefresh then
        local storage = _G.StorageManager:GetInstance():GetItemCountBySid(id)
        self.go_table.aortext_num.text = storage > 0 and storage or self.data.count
    end
end

---按钮点击事件在这里派发
function GetItemWayView:OnClickBtn(go)
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView2" or name == "@_aorbtn_CloseView" then
        if self.call then
            self.call()
        end
        self:Close()
    elseif name == "@_aorbtn_Buy" then
        self:OnClickBuyBtn()
    end
end

function GetItemWayView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.OnDataUpdate, self)
end

return GetItemWayView
