local base = require("BaseGameNet")

---@class TradingCardsNet : BaseGameNet
---@field GetInstance fun():TradingCardsNet
local TradingCardsNet = _G.BaseClass("TradingCardsNet", base)

---获取当期信息
---@param albumId number 卡册id
---@param fun(msg:trading_card.s2c_info)
function TradingCardsNet:GetInfo(albumId, callback)
    ---@type trading_card.c2s_info
    local pbData = {
        album_sid = albumId
    }
    local item = _G.ConfigManager.net_map.game_trading_card_info
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---获取交换卡牌列表
function TradingCardsNet:GetExchangeCardList(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_trading_card_get_exchange_list
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---发布交换请求
---@param albumId number 卡册id
---@param give_card_sids table<number> 换出的卡牌
---@param want_card_sid number 向换入的卡牌
---@param callback fun(msg:trading_card.s2c_publish_exchange)
function TradingCardsNet:PubilshExchange(albumId, give_card_sids, want_card_sid, callback)
    ---@type trading_card.c2s_publish_exchange
    local pbData = {
        album_sid = albumId,
        give_card_sids = give_card_sids,
        want_card_sid = want_card_sid
    }
    local item = _G.ConfigManager.net_map.game_trading_card_publish_exchange
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---交换卡牌
---@param albumId number     卡册id
---@param exchangeId number     交换id
---@param cardId number         选择交换的卡牌id
---@param callback fun(msg:public.s2c_common_ack)
function TradingCardsNet:Exchange(albumId, exchangeId, cardId, callback)
    ---@type trading_card.c2s_publish_exchange
    local pbData = {
        album_sid = albumId,
        exchange_id = exchangeId,
        chosen_give_card_sid = cardId,
    }
    local item = _G.ConfigManager.net_map.game_trading_card_confirm_exchange
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---执行抽卡
---@param itemLst table<table<number, number>>  {{道具sid,抽奖次数}}
---@param callback fun(msg:trading_card.s2c_draw):void 完成回调
function TradingCardsNet:Draw(itemLst, callback)
    ---@type trading_card.c2s_draw
    local pbData = {
        item_list = itemLst
    }
    local item = _G.ConfigManager.net_map.game_trading_card_draw
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---激活卡牌
---@param albumId number    @卡册id
---@param collectionId number    @图集id
---@param cardId number     @卡牌id
---@param callback fun(msg:public.s2c_common_ack):void 完成回调
function TradingCardsNet:ActiveCard(albumId, collectionId, cardId, callback)
    ---@type trading_card.c2s_award
    local pbData = {
        type = 1,
        album_sid = albumId,
        collection_id = collectionId,
        card_sid = cardId
    }
    local item = _G.ConfigManager.net_map.game_trading_card_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---领取图集收集奖励
---@param albumId number    卡册id
---@param collectionId number    图集id
---@param callback fun(msg:public.s2c_common_ack):void 完成回调
function TradingCardsNet:GetCollectAward(albumId, collectionId, callback)
    ---@type trading_card.c2s_award
    local pbData = {
        type = 2,
        album_sid = albumId,
        collection_id = collectionId
    }
    local item = _G.ConfigManager.net_map.game_trading_card_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---全部卡牌激活奖励
---@param albumId number 卡册id
---@param callback fun(msg:public.s2c_common_ack):void 完成回调
function TradingCardsNet:GetAlbumAward(albumId, callback)
    ---@type trading_card.c2s_award
    local pbData = {
        type = 3,
        album_sid = albumId
    }
    local item = _G.ConfigManager.net_map.game_trading_card_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function TradingCardsNet:CallBack(port, data, error)
    if error then
        return
    end
    --TODO 写通用数据解析，没有需要做的记得删除TODO
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return TradingCardsNet
