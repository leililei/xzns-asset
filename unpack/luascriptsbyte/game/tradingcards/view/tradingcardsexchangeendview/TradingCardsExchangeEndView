---@class TradingCardsExchangeEndView : UIBaseView	中文描述
---@field public go_table TradingCardsExchangeEndView_GoTable GoTable
local TradingCardsExchangeEndView = _G.BaseClass("TradingCardsExchangeEndView", _G.UIBaseView)

function TradingCardsExchangeEndView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param sid1 number 换出的卡牌id
---@param sid2 number 获得的卡牌id
function TradingCardsExchangeEndView:OnCreate(data, call)
    self.call = call
    self.data = data
    self.go_table.scrollloopvectical_item:InitItemData(#data, _G.handler(self, self.RefreashItem))
end

function TradingCardsExchangeEndView:RefreashItem(index, obj)
    index = index + 1
    local sid1 = self.data[index][1]
    local sid2 = self.data[index][2]
    local tb = _G.GetAutoGoTable(obj)
    local Item = require("TradingCardsItemView")
    local item = Item.New(tb.obj_getItem1)
    item:Parse(sid1, 1)
    item = Item.New(tb.obj_getItem2)
    item:Parse(sid2, 1)
end

---按钮点击事件在这里派发
function TradingCardsExchangeEndView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end

return TradingCardsExchangeEndView