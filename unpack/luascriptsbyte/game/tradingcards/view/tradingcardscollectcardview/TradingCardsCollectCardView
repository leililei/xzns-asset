---@class TradingCardsCollectCardView : UIBaseView	小浣熊集卡_卡牌详情页面
---@field public go_table TradingCardsCollectCardView_GoTable
---@field cfg trading_card_cfg
---@field preview boolean
---@field model TradingCardsModel
---@field cardItem TradingCardsItemView
local TradingCardsCollectCardView = _G.BaseClass("TradingCardsCollectCardView", _G.UIBaseView)

function TradingCardsCollectCardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function TradingCardsCollectCardView:OnCreate(albumId, sid, preview)
    self.albumId = albumId
    self.cfg = _G.ConfigManager.trading_card_cfg[sid]
    self.preview = preview or false
    self.model = require("TradingCardsModel"):GetInstance()

    self:InitView()
    self:UpdateView()
end

---初始化
function TradingCardsCollectCardView:InitView()
    self.cardItem = _G.GetAutoGoTable(self.go_table.obj_TradingCardsItem)
    self.cardItem.aorrawimage_role:LoadImage(self.cfg.popup_portrait, function(tran)
        if self:IsNil() or not tran then
            return
        end
        tran:SetNativeSize()
        -- tran:SetLocalScaleXYZ(self.cfg.popup_portrait)
    end)
    self.cardItem.aortext_num.text = self.model:GetCollectCardNumber(self.cfg.id)
    local temp1, temp2
    temp2 = self.cfg.id % 100
    temp1 = self.cfg.card_collection % 100
    self.cardItem.aortext_number.text = _G.string.format("%s-%s", temp1, temp2)

    for _,v in pairs(self.cfg.attribute) do
        local item = _G.InstantiateObject(self.go_table.obj_attr, self.go_table.obj_attrs)
        item:SetActiveE(1)
        local tb = _G.GetAutoGoTable(item)
        tb.aortext_key.text = _G.AttrType[v[1]].des
        if v[2] == "2" then
            tb.aortext_value.text = (_G.tonumber(v[3]) / 100 ) .. "%"
        else
            if _G.AttrType[v[1]].percentage == 0 then
                tb.aortext_value.text = v[3]
            else
                tb.aortext_value.text = (_G.tonumber(v[3]) / 100 ) .. "%"
            end
        end
    end
end

---更新页面状态
function TradingCardsCollectCardView:UpdateView()
    local isActive = self.model:IsCollectActiveCard(self.cfg.id)
    local ownNum = self.model:GetCollectCardNumber(self.cfg.id)
    self.go_table.obj_lock:SetActiveE(not isActive and 1 or 0)
    self.go_table.aortext_name.text = _G.GetLangPackValue(self.cfg.Name)
    self.go_table.aortext_name.color = self.model.CollectAlbumQualityColor[self.cfg.quality]

    --激活奖励
    self.go_table.obj_awardParent:ClearChildren()
    if not _G.table.isEmptyOrNil(self.cfg.illustrated_reward) then
        local award = self.cfg.illustrated_reward
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            award,
            self.go_table.obj_awardParent,
            function(itemObj)
                if self:IsNil() then
                    _G.DestroyObject(itemObj.gameObject)
                    return
                end
                itemObj.gameObject:SetLocalPosition(0, 0, 0)
                itemObj.gameObject:SetLocalScaleXYZ(0.85)
                itemObj:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                if itemObj.SetGradeNew then
                    itemObj:SetGradeNew(false)
                end
                if isActive and itemObj.SetGou then
                    itemObj:SetGou(true)
                end
            end
        )
    end

    --按钮状态
    self.go_table.aorbtn_active:SetActiveE(not self.preview and not isActive and 1 or 0)
    self.go_table.aorbtn_help:SetActiveE(not self.preview and not isActive and ownNum <= 0 and 1 or 0)
    self.go_table.aorbtn_change:SetActiveE(not self.preview and isActive and 1 or 0)

    --更新卡牌数量
    if self.cardItem then
        self.cardItem.aortext_num.text = self.model:GetCollectCardNumber(self.cfg.id)
    end
end

---按钮点击事件在这里派发
function TradingCardsCollectCardView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_active then
        self.model:ActiveCard(self.albumId, self.cfg.id, function(msg)
            if not msg or msg.ack ~= 1 then
                return
            end
            self.go_table.obj_active_effect:SetActiveE(1)
            _G.UIUtils.ShowCommonAward(msg)
            if self:IsNil() then
                return
            end
            self.go_table.obj_active_effect:SetActiveE(0)
            self:UpdateView()
        end)
    elseif go == self.go_table.aorbtn_help then
        if self.model.pubilshCount >= _G.ConfigManager.discrete_cfg[202202][1][1] then
            _G.PopWindowManager:GetInstance():ShowAllTips(1290001)
            return
        end
        if not self.model:CheckPubilshCd()  then
            _G.PopWindowManager:GetInstance():ShowAllTips(1290008)
            return
        end
        local existNotActive = false
        for _, v in pairs(_G.ConfigManager.trading_card_cfg) do
            if not self.model:IsCollectActiveCard(v.id) and self.model:GetCanUseCardNum(v.id) == 0 then
                existNotActive = true
                break
            end
        end
        if existNotActive then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TradingCardsChangeCreateView.Name,
            {
                getItemData = {id = self.cfg.id, count = 0},
                call = function()
                    self:UpdateView()
                end
            })
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(1290012)
        end
    elseif go == self.go_table.aorbtn_change then
        if self.model.pubilshCount >= _G.ConfigManager.discrete_cfg[202202][1][1] then
            _G.PopWindowManager:GetInstance():ShowAllTips(1290001)
            return
        end
        if not self.model:CheckPubilshCd()  then
            _G.PopWindowManager:GetInstance():ShowAllTips(1290008)
            return
        end
        local existNotActive = false
        for _, v in pairs(_G.ConfigManager.trading_card_cfg) do
            if not self.model:IsCollectActiveCard(v.id) and self.model:GetCanUseCardNum(v.id) == 0 then
                existNotActive = true
                break
            end
        end
        if existNotActive then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TradingCardsChangeCreateView.Name,
            {
                call = function()
                    self:UpdateView()
                end
            })
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(1290012)
        end
    end
end

return TradingCardsCollectCardView
