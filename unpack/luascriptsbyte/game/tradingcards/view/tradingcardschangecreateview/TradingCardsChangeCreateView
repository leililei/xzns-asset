---@class TradingCardsChangeCreateView : UIBaseView	中文描述
---@field public go_table TradingCardsChangeCreateAndExchangeView_GoTable GoTable
local TradingCardsChangeCreateView = _G.BaseClass("TradingCardsChangeCreateView", _G.UIBaseView)

function TradingCardsChangeCreateView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function TradingCardsChangeCreateView:OnCreate(data)
    self.data = data
    self.model = require("TradingCardsModel"):GetInstance()
    self.getItemData = data.getItemData
    self.changeDataList = {}
    self.call = data.call
    self.getItem = require("TradingCardsItemView").New(self.go_table.obj_getItem)
    self.item1 = require("TradingCardsItemView").New(self.go_table.obj_changeItem1)
    self.item2 = require("TradingCardsItemView").New(self.go_table.obj_changeItem2)
    self.item3 = require("TradingCardsItemView").New(self.go_table.obj_changeItem3)
    self.item4 = require("TradingCardsItemView").New(self.go_table.obj_changeItem4)
    self:UpdateView()
end


function TradingCardsChangeCreateView:UpdateView()
    if self.getItemData then
        self.go_table.obj_getItem:SetActiveE(1)
        self.go_table.obj_getEmpty:SetActiveE(0)
        self.getItem:Parse(self.getItemData.id, self.getItemData.count)
    else
        self.go_table.obj_getItem:SetActiveE(0)
        self.go_table.obj_getEmpty:SetActiveE(1)
    end
    for i = 1, _G.ConfigManager.discrete_cfg[202201][1][1] do
        if self.changeDataList[i] then
            self.go_table["obj_changeItem" .. i]:SetActiveE(1)
            self.go_table["obj_empty" .. i]:SetActiveE(0)
            self["item" .. i]:Parse(self.changeDataList[i].id, self.changeDataList[i].count)
        else
            self.go_table["obj_changeItem" .. i]:SetActiveE(0)
            self.go_table["obj_empty" .. i]:SetActiveE(1)
        end
    end
end

---按钮点击事件在这里派发
function TradingCardsChangeCreateView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_getItem then
        local cardList = {}
        local selectList = {}
        for _, v in pairs(self.changeDataList) do
            selectList[v.id] = v
        end
        for _, v in pairs(_G.ConfigManager.trading_card_cfg) do
            if not selectList[v.id] and not self.model:IsCollectActiveCard(v.id) and self.model:GetCanUseCardNum(v.id) == 0 then
                _G.table.insert(cardList, { id = v.id, count = self.model:GetCollectCardNumber(v.id) })
            end
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TradingCardsSelectView.Name, {
            count = 1,
            cardList = cardList,
            initCall = function(view)
                view.go_table.aorbtn_all:SetActiveE(0)
                view.go_table.aortext_des:SetActiveE(0)
                view.go_table.aortext_title.text = _G.GetLangPackValue(90034560063)
            end,
            sureCall = function(selectList)
                self.getItemData = selectList[1] or nil
                self.changeDataList = {}
                self:UpdateView()
            end
        })
    elseif go == self.go_table.aorbtn_click then
        if not self.getItemData then
            return
        end
        local giveList = {}
        for _, v in pairs(self.changeDataList) do
            _G.table.insert(giveList, v.id)
        end
        if #giveList == 0 then
            return
        end
        self.model:PubilshExchange(giveList, self.getItemData.id, function()
            if self.call then
                self.call()
            end
            self:Close()
        end)
    else
        for i = 1, _G.ConfigManager.discrete_cfg[202201][1][1] do
            if go == self.go_table["aorbtn_change" .. i] then
                if not self.getItemData then
                    _G.PopWindowManager:GetInstance():ShowAllTips(1290010)
                    return
                end
                local cardList = {}
                for _, v in pairs(_G.ConfigManager.trading_card_cfg) do
                    local count = self.model:GetCanUseCardNum(v.id)
                    if count > 0 and (not self.getItemData or  v.id ~= self.getItemData.id) then
                        _G.table.insert(cardList, { id = v.id, count = count })
                    end
                end
                local selectList = {}
                for _, v in pairs(self.changeDataList) do
                    selectList[v.id] = v
                end
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TradingCardsSelectView.Name, {
                    count = _G.ConfigManager.discrete_cfg[202201][1][1],
                    cardList = cardList,
                    selectList = selectList,
                    selectQuality = _G.ConfigManager.trading_card_cfg[self.getItemData.id].quality - 2,
                    initCall = function(view)
                        view.go_table.aorbtn_all:SetActiveE(0)
                        view.go_table.aortext_title.text = _G.GetLangPackValue(90034560067)
                        view.go_table.obj_type:SetActiveE(0)
                    end,
                    sureCall = function(selectList)
                        self.changeDataList = selectList
                        self:UpdateView()
                    end,
                    selectClick = function(data)
                        if not self.model:IsCollectActiveCard(data.id) then
                            _G.PopWindowManager:GetInstance():ShowAllTips(1290002)
                            return false
                        end
                        if self.model:GetCollectCardNumber(data.id) <= 0 then
                            _G.PopWindowManager:GetInstance():ShowAllTips(1290003)
                        end
                        return true
                    end
                })
                break
            end
        end
    end
end

return TradingCardsChangeCreateView
