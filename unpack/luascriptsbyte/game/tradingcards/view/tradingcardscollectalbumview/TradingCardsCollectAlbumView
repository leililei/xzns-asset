local TradingCardsItemView = require("TradingCardsItemView")

---@class TradingCardsCollectAlbumView : UIBaseView	小浣熊集卡_某图集页面
---@field public go_table TradingCardsCollectAlbumView_GoTable
---@field data TradingCardsCollectAlbumData                                      @图册数据
---@field model TradingCardsModel
---@field datas number[]                                                        @卡牌id列表
---@field items table<any,TradingCardsCollectAlbumView._obj_item_GoTable>                                 @卡牌item列表
local TradingCardsCollectAlbumView = _G.BaseClass("TradingCardsCollectAlbumView", _G.UIBaseView)

function TradingCardsCollectAlbumView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    self:AddListener(_G.TradingCards.UpdateCard, self.UpdateView)
end

---界面的入口函数
function TradingCardsCollectAlbumView:OnCreate(albumId, data)
    self.albumId = albumId
    self.model = require("TradingCardsModel"):GetInstance()
    self.data = data

    self:InitView()
    self:UpdateView()
end

function TradingCardsCollectAlbumView:OnDestroy()
    self:RemoveAllListener()
end

---初始化
function TradingCardsCollectAlbumView:InitView()
    --列表初始化
    self.items = {}
    self.datas = _G.DeepCopyCfgTable(self.data:GetCards() or {})
    local cfg = _G.ConfigManager.trading_card_cfg
    _G.SortList(self.datas, function (item)
        return cfg[item].quality, cfg[item].star, item
    end)
    self.go_table.scrollloopvectical_list:InitItemData(_G.math.ceil(#self.datas / 3), _G.handler(self, self.UpdateItem))

    --奖励列表信息
    self.go_table.scrollloophorizontal_award:InitItemData(#self.data.cfg.reward, _G.handler(self, self.UpdateAwardItem))

    --图册数据
    local qualityCfg = self.model.CollectAlbumQualityImgs[self.data.cfg.quality]
    self.go_table.aorimage_bg.SpriteName = qualityCfg and qualityCfg[1] or ""
    self.go_table.aorimage_name.SpriteName = qualityCfg and qualityCfg[2] or ""
    --基础信息
    self.go_table.aortext_name.text = _G.GetLangPackValue(self.data.cfg.Name)
    self.go_table.aortext_name.color = self.model.CollectAlbumQualityColor[self.data.cfg.quality]
    local params = self.data:GetRoleParams()
    self.go_table.aorrawimage_role:LoadImage(self.data:GetRolePath(), function(img)
        if self:IsNil() then
            return
        end
        img:SetNativeSize()
        img:SetLocalScaleXYZ(params.size or 1)
        if params.pos_portrait then
            img:SetLocalPosition(
                params.pos_portrait[1] or 0,
                params.pos_portrait[2] or 0,
                params.pos_portrait[3] or 0
            )
        else
            img:SetLocalPositionToZero()
        end
    end)
end

---更新页面信息
function TradingCardsCollectAlbumView:UpdateView()
    local activeNum, totalNum = self.data:GetActiveNumber()
    self.go_table.aortext_progress.text = string.format("%s/%s", activeNum, totalNum)
    self.go_table.obj_totalFill:SetLocalScale(activeNum / totalNum, 1, 1)

    ---刷新列表
    self.go_table.scrollloopvectical_list:UpdateAllItem()
    self.go_table.scrollloophorizontal_award:UpdateAllItem()

    --一键激活按钮状态
    local showActiveAll = false
    for _, cardId in ipairs(self.datas) do
        if not self.data:IsCardActive(cardId) and
            self.data:GetCardNumber(cardId) > 0 then
            showActiveAll = true
            break
        end
    end
    self.go_table.aorbtn_autoActive:SetActiveE(showActiveAll and 1 or 0)

    --全激活奖励状态
    local canReceived = not self.data:IsReceivedAward() and self.data:GetActiveNumber() >= #self.datas
    self.go_table.obj_awardRedpoint:SetActiveE(canReceived and 1 or 0)
end

---刷新卡牌item
---@param index number 书架索引
---@param go GameObject 书架item对象
function TradingCardsCollectAlbumView:UpdateItem(index, go)
    ---@type TradingCardsCollectAlbumView._obj_item_GoTable|{cardItem?:TradingCardsItemView}
    local listItem = self.items[go:GetInstanceIDE()]
    if not listItem then
        listItem = _G.GetAutoGoTable(go)
        self.items[go:GetInstanceIDE()] = listItem
    end
    if not listItem.items then
        local firstItem = _G.GetAutoGoTable(listItem.obj_item)
        listItem.items = { firstItem }
    end
    for i = 1, 3 do
        local item = listItem.items[i]
        local sid = self.datas[index * 3 + i]
        if not sid then
            if item then
                item.gameObject:SetActiveE(0)
            end
        else
            --检查是否需要new节点
            if not item then
                local newObj = _G.InstantiateObject(listItem.obj_item, listItem.obj_albums)
                item = _G.GetAutoGoTable(newObj)
                listItem.items[i] = item
            end
            if not item.cardItem then
                item.cardItem = TradingCardsItemView.New(item.obj_card)
                item.cardItem:SetCallback(_G.handlerbind(self, self.OnClickCardBtn, item))
            end
            item.gameObject:SetActiveE(1) --激活
            --设置节点属性
            item.data = sid
            local isActive = self.data:IsCardActive(sid)
            local ownNum = self.data:GetCardNumber(sid)
            item.sid = sid
            item.cardItem:Parse(sid, ownNum, isActive, true)

            --锁定, 可激活状态
            item.obj_active:SetActiveE(not isActive and ownNum > 0 and 1 or 0)
            item.obj_lock:SetActiveE(not isActive and ownNum <= 0 and 1 or 0)
        end
    end
end

---刷新奖励item
---@param index number 书架索引
---@param go GameObject 书架item对象
function TradingCardsCollectAlbumView:UpdateAwardItem(index, go)
    local data = self.data.cfg.reward[index + 1]
    local isReceived = self.data:IsReceivedAward()
    local canReceived = not isReceived and self.data:GetActiveNumber() >= #self.datas

    local loadId = "__loadId" .. math.random()
    go:SetLocalScaleXYZ(0.75)
    go:ClearChildren()
    go:SetName(loadId)
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        data,
        go,
        function(itemObj)
            if self:IsNil() or go:GetName() ~= loadId then
                _G.DestroyObject(itemObj.gameObject)
                return
            end
            itemObj.gameObject:SetLocalPosition(0, 0, 0)
            --itemObj.gameObject:SetLocalScaleXYZ(0.85)
            itemObj:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            if itemObj.SetGradeNew then
                itemObj:SetGradeNew(false)
            end
            if isReceived and itemObj.SetGou then
                itemObj:SetGou(true)
            end
        end,
        function()
            if canReceived then
                self.model:GetCollectAward(self.albumId, self.data.cfg.id, function(msg)
                    if not msg or msg.ack ~= 1 then
                        return
                    end
                    _G.UIUtils.ShowCommonAward(msg)

                    --刷新列表
                    self.go_table.scrollloophorizontal_award:UpdateAllItem()
                    self.go_table.obj_awardRedpoint:SetActiveE(0)
                end)
            else
                require("CommonTipManager"):GetInstance():OpenTip(go, data[1])
            end
        end
    )
    if canReceived then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_daojukuang_cheng,
            go,
            function(obj)
                if self:IsNil() or go:GetName() ~= loadId then
                    _G.DestroyObject(obj)
                    return
                end
                obj:SetLocalScaleXYZ(1.4)
            end
        )
    end
end

---一键激活所有卡牌
---@param index number      卡牌序号
---@param awardList? award.i_award_item[]   奖励列表
---@private
function TradingCardsCollectAlbumView:ActiveAllCard(index, awardList)
    local cardId = self.datas[index]
    if not cardId then
        if awardList then
            _G.UIUtils.ShowCommonAward({ award = { item = awardList } })
        end
        return
    end
    if self.data:IsCardActive(cardId) or self.data:GetCardNumber(cardId) <= 0 then
        self:ActiveAllCard(index + 1, awardList)
        return
    end
    self.model:ActiveCard(self.albumId, cardId, function(msg)
        if not msg or msg.ack ~= 1 then
            self:ActiveAllCard(#self.datas + 1, awardList) --结算
            return
        end
        if msg.award and msg.award.item then
            if awardList then
                for _, v in ipairs(msg.award.item) do
                    table.insert(awardList, v)
                end
            else
                awardList = msg.award.item
            end
        end
        self:ActiveAllCard(index + 1, awardList)
    end)
end

---刷新单个书本item
---@param item TradingCardsCollectAlbumView._obj_item_GoTable|{sid?:number} 卡牌item对象
function TradingCardsCollectAlbumView:OnClickCardBtn(_, item)
    if not item or not item.sid then
        return
    end
    item.obj_click_effect:SetActiveE(1)
    _G.DelayDo(0.3,function()
        if self:IsNil() then
            return
        end
        item.obj_click_effect:SetActiveE(0)
    end)
    _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.TradingCardsCollectCardView.Name,
            self.albumId,
            item.sid
    )
end

---按钮点击事件在这里派发
function TradingCardsCollectAlbumView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_autoActive then
        self:ActiveAllCard(1)
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.GamePlayDescribeView.Name,
            227
        )
    end
end

return TradingCardsCollectAlbumView
