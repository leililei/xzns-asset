---@class TradingCardsSelectView : UIBaseView	中文描述
---@field sureCall function 点击确认回调
---@field selectList table 选中的卡
---@field showCardList table 筛选出来显示的卡
---@field selectMaxCount number 选择卡的最多数量
---@field initCall function 初始化完成回调，用来控制界面元素实现特殊需求
---@field selectClick function 选中时回调
---@field public go_table TradingCardsSelectView_GoTable GoTable
local TradingCardsSelectView = _G.BaseClass("TradingCardsSelectView", _G.UIBaseView)

function TradingCardsSelectView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function TradingCardsSelectView:OnCreate(data)
    self.sureCall = data.sureCall
    self.selectList = data.selectList or {}
    self.cardList = data.cardList
    self.showCardList = self.cardList
    self.selectMaxCount = data.count
    self.initCall = data.initCall
    self.selectClick = data.selectClick

    ---@type number 筛选的类型，默认全部
    local selectQuality = data.selectQuality or 0
    if selectQuality then
        self:SortList(selectQuality)
    end
    self:InitView()
end

function TradingCardsSelectView:InitView()
    self.go_table.scrollloopvectical_item:InitItemData(#self.showCardList, _G.handler(self, self.RefreashItem))
    if self.initCall then
        self.initCall(self)
    end
end

function TradingCardsSelectView:SortList(type)
    self.showCardList = {}
    local cfg = _G.ConfigManager.trading_card_cfg
    for _, v in pairs(self.cardList) do
        if type == 0 or cfg[v.id].quality == type + 2 then
            _G.table.insert(self.showCardList, v)
        end
    end
    self.go_table.scrollloopvectical_item:UpdateCount(#self.showCardList)
end

function TradingCardsSelectView:RefreashItem(index, obj)
    index = index + 1
    local data = self.showCardList[index]
    local tb = _G.GetAutoGoTable(obj)
    if not tb.item then
        tb.item = require("TradingCardsItemView").New(tb.obj_itemView)
    end
    tb.item:Parse(data.id, data.count or 1)

    if not self.selectList[data.id] then
        tb.obj_select:SetActiveE(1)
    else
        if self.selectMaxCount == 1 then
        else
            tb.obj_select:SetActiveE(0)
        end
    end

    tb.item:SetCallback(
        function()
            self:OnItemClick(tb, data)
        end
    )
    
    tb.obj_select:SetActiveE(self.selectList[data.id] and 1 or 0)
end

function TradingCardsSelectView:OnItemClick(tb, data)
    if self.selectClick and not self.selectClick(data) then
        return
    end
    if not self.selectList[data.id] then
        if _G.table.count(self.selectList) >= self.selectMaxCount then
            if self.selectMaxCount == 1 then
                self.selectList = {}
                self.selectList[data.id] = data
                self.go_table.scrollloopvectical_item:UpdateAllItem()
            end
            return
        end
        tb.obj_select:SetActiveE(1)
        self.selectList[data.id] = data
    else
        if self.selectMaxCount == 1 then
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.TradingCardsCollectCardView.Name,
                0,
                data.id,
                true --preview
            )
        else
            tb.obj_select:SetActiveE(0)
            self.selectList[data.id] = nil
        end
    end
end

---按钮点击事件在这里派发
function TradingCardsSelectView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_no then
        self:Close()
    elseif go == self.go_table.aorbtn_sure then
        self.selectList = _G.table.toArray(self.selectList)
        self.sureCall(self.selectList)
        self:Close()
    elseif go == self.go_table.aorbtn_all then
        if table.count(self.selectList) > 0 then
            self.selectList = {}
            self.go_table.scrollloopvectical_item:UpdateAllItem()
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(1290006)
        end

        self:OnClickBtn(self.go_table.aorbtn_btn0)
    elseif go == self.go_table.aorbtn_btn0 then
        self.go_table.aorimage_typeOn:SetParentE(self.go_table.obj_type0)
        self:SortList(0)
    elseif go == self.go_table.aorbtn_btn1 then
        self.go_table.aorimage_typeOn:SetParentE(self.go_table.obj_type1)
        self:SortList(1)
    elseif go == self.go_table.aorbtn_btn2 then
        self.go_table.aorimage_typeOn:SetParentE(self.go_table.obj_type2)
        self:SortList(2)
    elseif go == self.go_table.aorbtn_btn3 then
        self.go_table.aorimage_typeOn:SetParentE(self.go_table.obj_type3)
        self:SortList(3)
    elseif go == self.go_table.aorbtn_btn4 then
        self.go_table.aorimage_typeOn:SetParentE(self.go_table.obj_type4)
        self:SortList(4)
    elseif go == self.go_table.aorbtn_btn5 then
        self.go_table.aorimage_typeOn:SetParentE(self.go_table.obj_type5)
        self:SortList(5)
    end
end

return TradingCardsSelectView