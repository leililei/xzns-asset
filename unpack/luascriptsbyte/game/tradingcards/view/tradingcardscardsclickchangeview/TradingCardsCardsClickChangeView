---@class TradingCardsCardsClickChangeView : UIBaseView	中文描述
---@field public go_table TradingCardsCardsClickChangeView_GoTable GoTable
local TradingCardsCardsClickChangeView = _G.BaseClass("TradingCardsCardsClickChangeView", _G.UIBaseView)

function TradingCardsCardsClickChangeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param info activity_trading_card.i_exchange_info
function TradingCardsCardsClickChangeView:OnCreate(info)
    self.selectSid = 0
    for i = 1, 4 do
        local sid = info.give_card_sids[i]
        if sid then
            local item = require("TradingCardsItemView").New(self.go_table["obj_item" .. i])
            item:Parse(sid, 1)
            item:SetCallback(
                function()
                    self:OnItemClick(sid)
                end
            )
        else
            self.go_table["obj_item" .. i]:SetActiveE(0)
        end
    end
end

function TradingCardsCardsClickChangeView:OnItemClick(sid)
    self.selectSid = sid
    if not self.changeItem then
        self.changeItem = require("TradingCardsItemView").New(self.go_table.obj_getItem2)
    end
end

---按钮点击事件在这里派发
function TradingCardsCardsClickChangeView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_click then
    end
end

return TradingCardsCardsClickChangeView