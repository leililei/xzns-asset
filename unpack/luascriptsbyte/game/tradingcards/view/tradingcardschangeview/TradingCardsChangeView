---@class TradingCardsChangeView : UIBaseView	小浣熊集卡_交换页面
---@field public go_table TradingCardsChangeView_GoTable
---@field public exchangeList table<trading_card.i_exchange_info>
---@field model TradingCardsModel
local TradingCardsChangeView = _G.BaseClass("TradingCardsChangeView", _G.UIBaseView)

function TradingCardsChangeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.ConfigManager.net_map.game_trading_card_exchange_list_change.Cmd, self.UpdateView)
end

function TradingCardsChangeView:OnDestroy()
    self:RemoveAllListener()
end

---界面的入口函数
function TradingCardsChangeView:OnCreate()
    self.model = require("TradingCardsModel"):GetInstance()
    self.exchangeList = {}
    self.selectList = {}
    self.playerUid = _G.PlayerModel:GetInstance():GetPlayerUid()
    self.go_table.scrollloopvectical_list:InitItemData(0, _G.handler(self, self.RefreashItem))
    self:UpdateView()
end

---更新页面状态
function TradingCardsChangeView:UpdateView()
    self.exchangeList = self.model:GetChangeList()
    self:SortList()
    self.go_table.scrollloopvectical_list:UpdateCount(#self.showList)
    self.go_table.scrollloopvectical_list:ScrollToBottom()
    _G.DelayDo(
        1,
        function()
            local selfChangeList = self.model:GetSelfChangeList()
            if not _G.table.isEmptyOrNil(selfChangeList) then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TradingCardsExchangeEndView.Name, selfChangeList)
                self.model:ResetSelfChangeList()
            end
        end
    )
end

function TradingCardsChangeView:SortList()
    self.showList = {}
    if _G.table.count(self.selectList) == 0 then
        self.showList = self.exchangeList
    else
        for k, v in pairs(self.exchangeList) do
            for _, id in pairs(v.give_card_sids) do
                if self.selectList[id] then
                    _G.table.insert(self.showList, v)
                    break
                end
            end
        end
    end
end

function TradingCardsChangeView:RefreashItem(index, obj)
    index = index + 1
    obj:SetName(index)
    ---@type activity_trading_card.i_exchange_info
    local data = self.showList[index]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnItemClick, index))

    local isMe = _G.PlayerModel:GetInstance().role_uid == data.from_role_uid
    if isMe then
        tb.obj_other:SetActiveE(0)
        tb.obj_my:SetActiveE(1)
        local mytb = _G.GetAutoGoTable(tb.obj_my, _G.handlerbind(self, self.OnItemClick, index))
        mytb.aortext_name.text = data.role_info.name
        _G.UIUtils.SetPlayerHeadItemNew(
            mytb.obj_HeadItemBase,
            data.role_info,
            1,
            true,
            true,
            true
        )

        mytb.aortext_desc.text = _G.GetLangPackValue(90034560054, _G.GetLangPackValue(_G.ConfigManager.trading_card_cfg[data.want_card_sid].Name))
    	mytb.aorbtn_confirm:SetActiveE(self.playerUid == data.from_role_uid and 0 or 1)
        if self.playerUid == data.from_role_uid or not self.model:IsCollectActiveCard(data.want_card_sid) or self.model:GetCollectCardNumber(data.want_card_sid) <= 0 then
            mytb.aorbtn_confirm:SetGray(true)
        else
            mytb.aorbtn_confirm:SetGray(false)
        end
        -- 需要的卡牌
        if not mytb.item then
            mytb.item = require("TradingCardsItemView").New(mytb.obj_main)
        end
        mytb.item:Parse(data.want_card_sid, self.model:GetCollectCardNumber(data.want_card_sid))
        -- 交换的卡牌
        mytb.trans_cards:ClearChildren()
        for _, v in pairs(data.give_card_sids) do
            local itemObj = _G.InstantiateObject(mytb.obj_main, mytb.trans_cards)
            local item = require("TradingCardsItemView").New(itemObj)
            item:Parse(v, 1)
        end
    else
        tb.obj_other:SetActiveE(1)
        tb.obj_my:SetActiveE(0)
        tb.aortext_name.text = data.role_info.name
        _G.UIUtils.SetPlayerHeadItemNew(
            tb.obj_HeadItemBase,
            data.role_info,
            1,
            true,
            true,
            true
        )

        tb.aortext_desc.text = _G.GetLangPackValue(90034560054, _G.GetLangPackValue(_G.ConfigManager.trading_card_cfg[data.want_card_sid].Name))
    	tb.aorbtn_confirm:SetActiveE(self.playerUid == data.from_role_uid and 0 or 1)
        if self.playerUid == data.from_role_uid or not self.model:IsCollectActiveCard(data.want_card_sid) or self.model:GetCollectCardNumber(data.want_card_sid) <= 0 then
            tb.aorbtn_confirm:SetGray(true)
        else
            tb.aorbtn_confirm:SetGray(false)
        end
        -- 需要的卡牌
        if not tb.item then
            tb.item = require("TradingCardsItemView").New(tb.obj_main)
        end
        tb.item:Parse(data.want_card_sid, self.model:GetCollectCardNumber(data.want_card_sid))
        -- 交换的卡牌
        tb.trans_cards:ClearChildren()
        for _, v in pairs(data.give_card_sids) do
            local itemObj = _G.InstantiateObject(tb.obj_main, tb.trans_cards)
            local item = require("TradingCardsItemView").New(itemObj)
            item:Parse(v, 1)
        end
    end
end

function TradingCardsChangeView:OnItemClick(go, _, index)
    local name = go:GetName()
    local data = self.showList[index]
    if not data then
        return
    end
    if self.playerUid == data.from_role_uid then
        return
    elseif not self.model:IsCollectActiveCard(data.want_card_sid) then
        _G.PopWindowManager:GetInstance():ShowAllTips(1290002)
        return
    elseif self.model:GetCollectCardNumber(data.want_card_sid) <= 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(1290004)
        return
    end
    if name == "@_aorbtn_confirm" then
        if self.model.exchangeCount >= _G.ConfigManager.discrete_cfg[202206][1][1] then
            _G.PopWindowManager:GetInstance():ShowAllTips(1290013)
            return
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TradingCardsExchangeView.Name,
        {
            model = self.model,
            info = data,
            call = function()
                self:UpdateView()
            end
        })
    end
end

---按钮点击事件在这里派发
function TradingCardsChangeView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_create then
        if self.model.pubilshCount >= _G.ConfigManager.discrete_cfg[202202][1][1] then
            _G.PopWindowManager:GetInstance():ShowAllTips(1290001)
            return
        end
        if not self.model:CheckPubilshCd()  then
            _G.PopWindowManager:GetInstance():ShowAllTips(1290008)
            return
        end
        local existNotActive = false
        for _, v in pairs(_G.ConfigManager.trading_card_cfg) do
            if not self.model:IsCollectActiveCard(v.id) and self.model:GetCanUseCardNum(v.id) == 0 then
                existNotActive = true
                break
            end
        end
        if existNotActive then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TradingCardsChangeCreateView.Name,
            {
                call = function()
                    self:UpdateView()
                end
            })
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(1290012)
        end
    elseif go == self.go_table.aorbtn_search then
        local cardList = {}
        for _, v in pairs(self.exchangeList) do
            for _, id in pairs(v.give_card_sids) do
                if not cardList[id] then
                    cardList[id] = {id = id, count = 0}
                end
                cardList[id].count = cardList[id].count + 1                
            end
        end
        cardList = _G.table.toArray(cardList)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TradingCardsSelectView.Name,
        {
            count = 108,
            selectList = self.selectList,
            cardList = cardList,
            initCall = function(view)
                view.go_table.aortext_title.text = _G.GetLangPackValue(90034560068)
                view.go_table.aortext_des:SetActiveE(0)
            end,
            sureCall = function(selectList)
                self.selectList = {}
                for _, v in pairs(selectList) do
                    self.selectList[v.id] = v
                end
                self:UpdateView()
            end
        })
    end
end

return TradingCardsChangeView
