---品质背景框
local QualityImgs = {
    [3] = {"ui_jk_kp_zi", "ui_jk_dikuang_xh_zi"},
    [4] = {"ui_jk_kp_jin", "ui_jk_dikuang_xh_jin"},
    [5] = {"ui_jk_kp_hong", "ui_jk_dikuang_xh_hong"},
    [6] = {"ui_jk_kp_cheng", "ui_jk_dikuang_xh_cheng"},
    [7] = {"ui_jk_kp_cai", "ui_jk_dikuang_xh_cai"},
}

---@class TradingCardsItemView
---@field go_table _obj_TradingCardsItem_GoTable
---@field sid number                    @卡牌id
---@field cfg trading_card_cfg          @卡牌配置
---@field num number                    @卡牌数量
---@field clickCallback fun(item:TradingCardsItemView)  @点击回调
local TradingCardsItemView = _G.BaseClass("TradingCardsItemView")

function TradingCardsItemView:__init(trans)
    self.go_table = _G.GetAutoGoTable(trans, _G.handler(self, self.OnClickBtn))
end

---初始化数据
---@param sid number 卡片id
---@param num number 数量, 传了才显示数量
function TradingCardsItemView:Parse(sid, num, isActive, ishidenum)
    self.sid = sid
    self.cfg = _G.ConfigManager.trading_card_cfg[sid]
    self.num = num
    self.isActive = isActive
    self.ishidenum = ishidenum
    self:ShowBase()
    self:ShowNumber()
end

---设置点击回调
---@param callback fun(item:TradingCardsItemView)  @点击回调
function TradingCardsItemView:SetCallback(callback)
    self.clickCallback = callback
end

---显示卡牌基础信息: 品质丶名称丶立绘
---@private
function TradingCardsItemView:ShowBase()
    if not self.cfg then
        return
    end
    local size, pos_portrait = self.cfg.Size, self.cfg.pos_portrait

    local img = QualityImgs[self.cfg.quality]
    if not img then
        img = QualityImgs[3]
    end
    self.go_table.aorimage_bg.SpriteName = img[1]
    self.go_table.aorimage_number.SpriteName = img[2]
    self.go_table.aortext_name.text = _G.GetLangPackValue(self.cfg.Name)
    self.go_table.aortext_name.color = require("TradingCardsModel").CollectAlbumQualityColor[self.cfg.quality]
    local temp1, temp2
    temp2 = self.sid % 100
    temp1 = self.cfg.card_collection % 100
    self.go_table.aortext_number.text = _G.string.format("%s-%s", temp1, temp2)
    for i = 1, 5 do
        self.go_table["aorimage_star" .. i]:SetActiveE(self.cfg.star >= i and 1 or 0)
    end
    self.go_table.aorrawimage_role:LoadImage(self.cfg.Portrait, function(img)
        if _G.IsNil(img) then
            return
        end
        img:SetNativeSize()
        -- img:SetLocalScaleXYZ(size or 1)
        -- if pos_portrait then
        --     img:SetLocalPosition(pos_portrait[1] or 0, pos_portrait[2] or 0, pos_portrait[3] or 0)
        -- else
        --     img:SetLocalPositionToZero()
        -- end
    end)
end

---显示卡牌数量
---@private
function TradingCardsItemView:ShowNumber()
    if self.ishidenum then
        self.go_table.obj_num:SetActiveE(self.num and self.num >= 0 and self.isActive and 1 or 0)
    else
        self.go_table.obj_num:SetActiveE(self.num and self.num >= 0 and 1 or 0)
    end
    if self.num and self.num >= 0 then
        self.go_table.aortext_num.text = tostring(self.num)
    end
end

---监听事件
---@private
function TradingCardsItemView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_click then
        if self.clickCallback then
            self.clickCallback(self)
        end
    end
end

return TradingCardsItemView
