local ToggleNames = {
    [1] = "collect",
    [2] = "draw",
    [3] = "change",
}

---@class TradingCardsToggleView : UIBaseView	小浣熊集卡_Toggle页面
---@field public go_table TradingCardsToggleView_GoTable
---@field toggles table<string, TradingCardsToggleView._toggle_draw_GoTable>        切换toggle按钮
---@field beforeToggle string  @之前选中的界面
---@field curToggle string  @当前选中的界面
---@field views table<string, number|Component|UIBaseView> @界面实例
---@field activity ActivitySynBase
---@field model TradingCardsModel
local TradingCardsToggleView = _G.BaseClass("TradingCardsToggleView", _G.UIBaseView)

function TradingCardsToggleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    -- self:AddListener(_G.eUIManagerStatus.StartCloseUI, self.StartCloseUI)
end

---界面的入口函数
---@param toggleIndex number|string|nil 切换界面的索引
function TradingCardsToggleView:OnCreate(toggleIndex)
    self.model = require("TradingCardsModel"):GetInstance()
    self:InitToggles()

    local key
    if type(toggleIndex) == "string" then
        key = toggleIndex
    elseif type(toggleIndex) == "number" then
        key = ToggleNames[toggleIndex]
    end
    key = key or ToggleNames[1]

    local tog = self.go_table["toggle_" .. key] or self.go_table.toggle_collect
    if tog then
        --tog:SetIsOnWithoutNotify(false)
        tog.isOn = false
        tog.isOn = true
    end
end

function TradingCardsToggleView:OnDestroy()
    self:RemoveAllListener()
    if self.views then
        for _, view in pairs(self.views) do
            if view and view ~= 0 then
                view:Close()
            end
        end
    end
    self.views = nil
end

function TradingCardsToggleView:InitToggles()
    self.views = {}
    self.toggles = {
        collect = _G.GetAutoGoTable(
            self.go_table.toggle_collect,
            _G.handlerbind(self, self.OnClickToggle, "collect", _G.handler(self, self.OnCollect))
        ),
        change = _G.GetAutoGoTable(
            self.go_table.toggle_change,
            _G.handlerbind(self, self.OnClickToggle, "change", _G.handler(self, self.OnChange))
        ),
    }
    --初始化红点
    self.toggles.collect.obj_redpoint:UpdateRedPointItemIDAndParam(
        self.model:GetRedpointIDByIndex(self.model.RedPointTree.Album),
        -1
    )
    self.toggles.change.obj_redpoint:UpdateRedPointItemIDAndParam(
        self.model:GetRedpointIDByIndex(self.model.RedPointTree.Change),
        -1
    )
end

---监听Toggle点击事件
---@param key string
---@param callback function
function TradingCardsToggleView:OnClickToggle(_, isOn, key, callback)
    local tb = self.toggles[key]
    local view = self.views[key]
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)

    if isOn then
        self.beforeToggle = self.curToggle
        self.curToggle = key
    end

    --节点显隐
    if view and view ~= 0 then
        view.gameObject:SetActiveE(isOn and 1 or 0)
    end
    if isOn and callback then
        callback()
    end
end

--region ========================监听打开子页面========================

---监听打开子页面
function TradingCardsToggleView:OnCollect()
    local view = self.views.collect
    if not view then
        self.views.collect = 0
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.TradingCardsAlibumView.Name
        )
    elseif view ~= 0 then
        view:UpdateView()
    end
end

function TradingCardsToggleView:OnChange()
    _G.PlayerPrefsManager.SetInt("TradingCardsChangeRedPoint", _G.TimeUtil.GetServerUnixTime())
    require("RedPointManager"):GetInstance():RefreshNode(self.model:GetRedpointIDByIndex(self.model.RedPointTree.Change))
    local view = self.views.change
    if not view then
        self.views.change = 0
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TradingCardsChangeView.Name)
    elseif view ~= 0 then
        view:UpdateView()
    end
end

---监听界面打开
function TradingCardsToggleView:OnUIOpened(name)
    ---@type string
    local key
    if name == _G.ConfigManager.ui_cfg.TradingCardsAlibumView.Name then
        key = "collect"
    elseif name == _G.ConfigManager.ui_cfg.TradingCardsChangeView.Name then
        key = "change"
    else
        return
    end
    self:RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)

    local view = _G.UIManager:GetInstance():GetWindowCtrl(name)
    if self:IsNil() then
        view:Close()
        return
    end
    view.transform:SetParentE(self.go_table.obj_view)
    _G.UIManager:GetInstance():ChangeCanvasOrder(
        name,
        self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder + 1
    )
    if view.obj_BottomBar then
        view.obj_BottomBar:SetActiveE(0)
    end
    self.views[key] = view
    if self.curToggle ~= key then
        view:Hide()
    end
end
