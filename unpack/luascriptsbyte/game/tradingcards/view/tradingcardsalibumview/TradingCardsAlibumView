---@class TradingCardsAlibumView : UIBaseView	中文描述
---@field public go_table TradingCardsMainView_GoTable GoTable
local TradingCardsAlibumView = _G.BaseClass("TradingCardsAlibumView", _G.UIBaseView)

function TradingCardsAlibumView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.TradingCards.UpdateCard, self.UpdateView)
end

function TradingCardsAlibumView:OnDestroy()
    self:RemoveAllListener()
end

---界面的入口函数
function TradingCardsAlibumView:OnCreate()
    self.model = require("TradingCardsModel"):GetInstance()
    self.albumList = self.model.alibumList
    self.go_table.scrollloopvectical_item:InitItemData(#self.albumList, _G.handler(self, self.RefreshItem))
end

function TradingCardsAlibumView:UpdateView()
    self.go_table.scrollloopvectical_item:UpdateAllItem()
end

function TradingCardsAlibumView:RefreshItem(index, obj)
    index = index + 1
    local albumId = self.albumList[index]
    local data = _G.ConfigManager.trading_card_album_cfg[albumId]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnItemClick, albumId))
    local albumDatas = self.model:GetCollectAlbums(albumId)
    --全收集状态
    local activeNum, totalNum = 0, 0
    for _, album in ipairs(albumDatas) do
        activeNum = activeNum + album:GetActiveNumber()
        totalNum = totalNum + #album:GetCards()
    end
    tb.obj_redpoint:UpdateRedPointItemIDAndParam(self.model:GetRedpointIDByIndex(self.model.RedPointTree.Album), albumId)
    tb.aortext_total.text = _G.GetLangPackValue(90022500702) .. _G.string.format("%s/%s", activeNum, totalNum) --_G.GetLangPackValue(0, activeNum, totalNum) --收集进度: %s/%s
    tb.obj_totalFill:SetLocalScale(activeNum / totalNum, 1, 1)
    tb.aortext_title.text = _G.GetLangPackValue(data.Name)
    tb.scrollloophorizontal_award:InitItemData(#data.reward, _G.handlerbind(self, self.RefreshAwardItem, data))
end

function TradingCardsAlibumView:RefreshAwardItem(index, obj, data)
    index = index + 1
    obj:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        data.reward[index],
        obj,
        function(trans)
            if self:IsNil() then
                return
            end
            trans:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
            trans:SetGou(self.model:IsReceiveCollectAward(data.id))
        end
    )
end
function TradingCardsAlibumView:OnItemClick(_, _, albumId)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TradingCardsCollectView.Name, albumId)
end

---按钮点击事件在这里派发
function TradingCardsAlibumView:OnClickBtn(go)
    if go == self.go_table.aorbtn_tip then
        self:Close()
    end
end

return TradingCardsAlibumView
