---@class TradingCardsExchangeView : UIBaseView	中文描述
---@field public go_table TradingCardsExchangeView_GoTable GoTable
local TradingCardsExchangeView = _G.BaseClass("TradingCardsExchangeView", _G.UIBaseView)

function TradingCardsExchangeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function TradingCardsExchangeView:OnCreate(data)
    self.data = data
    self.model = data.model
    self.exchangeInfo = data.info
    self.call = data.call
    self.selectIndex = 0
    self.selectItem = require("TradingCardsItemView").New(self.go_table.obj_getItem2)
    self.getItem = require("TradingCardsItemView").New(self.go_table.obj_getItem1)
    self.item1 = require("TradingCardsItemView").New(self.go_table.obj_changeItem1)
    self.item2 = require("TradingCardsItemView").New(self.go_table.obj_changeItem2)
    self.item3 = require("TradingCardsItemView").New(self.go_table.obj_changeItem3)
    self.item4 = require("TradingCardsItemView").New(self.go_table.obj_changeItem4)
    self:UpdateView()
end

function TradingCardsExchangeView:UpdateView()
    self.getItem:Parse(self.exchangeInfo.want_card_sid, self.model:GetCollectCardNumber(self.exchangeInfo.want_card_sid))
    for i = 1, 4 do
        if self.exchangeInfo.give_card_sids[i] then
            self.go_table["obj_changeItem" .. i]:SetActiveE(1)
            self["item" .. i]:Parse(self.exchangeInfo.give_card_sids[i], 1)
            if self.selectIndex == self.exchangeInfo.give_card_sids[i] then
                self.go_table.aorimage_select:SetParentE(self.go_table["obj_item" .. i])
                self.go_table.aorimage_select:SetLocalPositionToZero()
            end
        else
            self.go_table["obj_item" .. i]:SetActiveE(0)
        end
    end
    local selectId = self.exchangeInfo.give_card_sids[self.selectIndex]
    if selectId then
        self.selectItem:Parse(selectId, 1)
        self.go_table.obj_empty:SetActiveE(0)
    else
        self.go_table.obj_empty:SetActiveE(1)
    end
end

---按钮点击事件在这里派发
function TradingCardsExchangeView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_exchange then
        if self.selectIndex == 0 or self.model:GetCollectCardNumber(self.exchangeInfo.want_card_sid) <= 0 then
            self:Close()
            return
        end
        if not self.model:CheckExistExchange(self.exchangeInfo.exchange_id) then
            _G.PopWindowManager:GetInstance():ShowAllTips(1290011)
            self:Close()
            return
        end
        self.model:ExchangeCard(
            self.exchangeInfo,
            self.exchangeInfo.give_card_sids[self.selectIndex],
            function()
                if self.call then
                    self.call()
                end
                self:Close()
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.TradingCardsExchangeEndView.Name,
                    {{
                        self.exchangeInfo.want_card_sid,
                        self.exchangeInfo.give_card_sids[self.selectIndex]
                    }}
                )
            end
        )
    else
        for i = 1, 4 do
            if go == self.go_table["aorbtn_change" .. i] then
                self.go_table.aorimage_select:SetParentE(self.go_table["obj_item" .. i])
                self.go_table.aorimage_select:SetLocalPositionToZero()
                self.selectIndex = i
                self:UpdateView()
                break
            end
        end
    end
end

return TradingCardsExchangeView
