---@class TradingCardsModel: GameDataModelBase
---@field cfg trading_card_album_cfg                                                @功能基础配置
---@field extraCoinCallbacks table<number,function>
--------------------------------------------------------------------------------
---@field collectFullAward boolean                                                  @全收集奖励领取状态
---@field collectAlbums table<number,TradingCardsCollectAlbumData>                  @集卡图册列表_<图册id, 图册实例>
---@field coolectAlbumReverseCards table<number,TradingCardsCollectAlbumData>       @集卡图册_<卡牌id, 图册实例>_反向映射
--------------------------------------------------------------------------------
local TradingCardsModel = _G.BaseClass("TradingCardsModel", _G.GameDataModelBase)

TradingCardsModel.CollectAlbumQualityImgs = CollectAlbumQualityImgs
TradingCardsModel.CollectAlbumQualityColor = CollectAlbumQualityColor

function TradingCardsModel:__init()
    self.isOpen = false
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.game_trading_card_exchange_list_change.Cmd,
    self.P2CUpdateChangeList, self)
end

function TradingCardsModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.game_trading_card_exchange_list_change.Cmd,
    self.P2CUpdateChangeList, self)
end

---@param activity TradingCardsSynModel
function TradingCardsModel:GetInfo(albumId, activity, initCall)
    self.albumId = albumId
    self.activity = activity
    self.initCall = initCall
    self.RedPointTree = activity.RedPointTree
    TradingCardsNet:GetInstance():GetInfo(albumId, _G.handler(self, self.GetInfoCall))
end

function TradingCardsModel:GetInfoCall(msg)
    self.isOpen = true
    self.alibumList = msg.alibum_list or {}
    self.record_list = msg.record_list or {}
    _G.table.insert(self.alibumList, self.albumId)
    _G.SortList(self.alibumList, function (item)
        return item
    end)
    self:InitCollect(msg.album_info)
    self:InitChangeList(msg.self_info)
    require("RedPointManager"):GetInstance():AddRedPointChild(_G.ConfigManager.redpoint_cfg.TradingCards.id, self:GetRedpointIDByIndex(1))
    if self.initCall then
        self.initCall()
    end
end

function TradingCardsModel:CheckOpen()
    return self.isOpen
end

--- 获取属性加成
function TradingCardsModel:GetAllAttr()
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local attribute = AttributeClassManager:GetAttribtueClass()
    if self.collectAlbums then
        for _, album in pairs(self.collectAlbums) do
            album:GetAttr(attribute)
        end
    end
    local changeAttrTypes = AttributeClassManager:GetChangeAttrTypes(attribute)
    return attribute, changeAttrTypes
end

--region 红点

function TradingCardsModel:GetRedpointIDByIndex(index)
    return self.activity:GetRedpointIDByIndex(index)
end

--endregion


---region ===============================集卡===============================

---初始化集卡数据
function TradingCardsModel:InitCollect(msg)
    self.collectAlbums = {}
    self.coolectAlbumReverseCards = {}
    self.collectFullAward = {}
    for _, v in pairs(msg) do
        local cfg = _G.ConfigManager.trading_card_album_cfg[v.album_sid]
        -- 初始化图集数据
        if cfg then
            for _, sid in ipairs(cfg.albums) do
                local collectCfg = _G.ConfigManager.trading_card_collection_cfg[sid]
                if cfg then
                    self.collectAlbums[sid] = TradingCardsCollectAlbumData.New(collectCfg, v.album_sid)
                else
                    if _G.AppSetting.DEBUG then
                        _G.LogError(string.format("找不到trading_card_collection_cfg配置id=%s", sid))
                    end
                end
            end
            -- 反向映射
            for _, album in pairs(self.collectAlbums) do
                local cardIds = album:GetCards()
                if cardIds and #cardIds > 0 then
                    for _, cardId in ipairs(cardIds) do
                        if _G.AppSetting.DEBUG and self.coolectAlbumReverseCards[cardId] then
                            _G.LogError(string.format("图册%s和%s 包含的卡牌id %s 重复",
                                self.coolectAlbumReverseCards[cardId].cfg.id, album.cfg.id, cardId))
                        end
                        self.coolectAlbumReverseCards[cardId] = album
                    end
                end
            end
            self.collectFullAward[v.album_sid] = v.album_claimed
        end

        -- 拥有的卡牌数量
        if v.card_list then
            for _, card in ipairs(v.card_list) do
                local album = self.coolectAlbumReverseCards[card.key]
                if album then
                    album:SetCardNumber(card.key, card.value)
                end
            end
        end
        -- 图册卡牌激活进度
        if v.album_progress then
            for _, progress in ipairs(v.album_progress) do
                local album = self.collectAlbums[progress.collection_id]
                if album and progress.card_sid then
                    for _, cardId in ipairs(progress.card_sid) do
                        album:SetCardActive(cardId)
                    end
                end
            end
        end
        -- 图册奖励领取状态
        if v.claimed_collections then
            for _, collect in ipairs(v.claimed_collections) do
                local album = self.collectAlbums[collect]
                if album then
                    album:SetReceivedAward(true)
                end
            end
        end
    end
end

---获取图册列表
---@return TradingCardsCollectAlbumData[]
function TradingCardsModel:GetCollectAlbums(albumId)
    local results = {}
    for _, id in pairs(_G.ConfigManager.trading_card_album_cfg[albumId].albums) do
        if self.collectAlbums[id] then
            _G.table.insert(results, self.collectAlbums[id])
        end
    end
    return results
end

---全图集收集奖励
---@return number[][]
function TradingCardsModel:GetCollectAwardCfg(albumId)
    local cfg = _G.ConfigManager.trading_card_album_cfg[albumId]
    if not cfg then
        return nil
    end
    return cfg.reward
end

---是否已领取全收集奖励
---@return boolean
function TradingCardsModel:IsReceiveCollectAward(albumId)
    return self.collectFullAward[albumId] or false
end

---卡牌是否已激活
---@param cardId number
---@return boolean
function TradingCardsModel:IsCollectActiveCard(cardId)
    local album = self.coolectAlbumReverseCards[cardId]
    if not album then
        return false
    end
    return album:IsCardActive(cardId)
end

---获取可用卡牌数量
---@param cardId number
---@return number
function TradingCardsModel:GetCollectCardNumber(cardId)
    local album = self.coolectAlbumReverseCards[cardId]
    if not album then
        return 0
    end
    return album:GetCardNumber(cardId)
end

function TradingCardsModel:GetCanUseCardNum(cardId)
    local count = self:GetCollectCardNumber(cardId)
    if count > 0 then
        local lis = self:GetChangeList()
        local uid = _G.PlayerModel:GetInstance():GetPlayerUid()
        for _, v in pairs(lis) do
            if v.from_role_uid == uid then
                if _G.table.ContainsValue(v.give_card_sids, cardId) then
                    count = count - 1
                end
            end
        end
    end
    return count
end

