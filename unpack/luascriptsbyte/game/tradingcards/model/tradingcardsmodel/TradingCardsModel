---region ===============================网络接口===============================

---获取换卡列表
---@param page number       页码
---@param count number      每页数量
---@param callback fun(msg:trading_card.s2c_get_exchange_list):void 回调
function TradingCardsModel:GetExchangeCardList(callback)
    TradingCardsNet:GetInstance():GetExchangeCardList(function(msg)
        if callback then
            callback(msg)
        end
    end)
end

---发布交换请求
function TradingCardsModel:PubilshExchange(give_card_sids, want_card_sid, callback)
    TradingCardsNet:GetInstance():PubilshExchange(self.albumId, give_card_sids, want_card_sid, function(msg)
        if msg.ack ~= 1 then
            return
        end
        self.pubilshTime = _G.TimeUtil.GetServerUnixTime()
        self.pubilshCount = self.pubilshCount + 1
        _G.table.insert(self.changeList, 1, msg.exchange)
        if callback then
            callback()
        end
    end)
end

---交换卡牌
---@param exchangeData trading_card.i_exchange_info    交换信息
---@param cardId number                                         交换的卡牌id
function TradingCardsModel:ExchangeCard(exchangeData, cardId, callback)
    TradingCardsNet:GetInstance():Exchange(self.albumId, exchangeData.exchange_id, cardId, function(msg)
        if msg.ack ~= 1 then
            return
        end
        self.exchangeCount = self.exchangeCount + 1
        local albumRedpointId = self:GetRedpointIDByIndex(self.RedPointTree.Collect)
        -- 添加卡牌
        if self.coolectAlbumReverseCards then
            local album = self.coolectAlbumReverseCards[cardId]
            if album then
                album:ChangeCardNumber(cardId, 1)
                if not album:IsCardActive(cardId) then
                    RedPointManager:GetInstance():RefreshNode(albumRedpointId, cardId)
                end
            end
            album = self.coolectAlbumReverseCards[exchangeData.want_card_sid]
            if album then
                album:ChangeCardNumber(exchangeData.want_card_sid, -1)
            end
        end

        local delIndex = false
        for k, v in pairs(self.changeList) do
            if v.exchange_id == exchangeData.exchange_id then
                delIndex = k
                break
            end
        end
        if delIndex then
            _G.table.remove(self.changeList, delIndex)
        end

        _G.Events:GetInstance():Broadcast(_G.TradingCards.NewCards)

        if callback then
            callback(msg)
        end
    end)
end

---执行抽卡
---@param albumId number        @卡册id
---@param itemSid number        @道具id
---@param num number        @抽卡次数
---@param callback fun(msg:activity_trading_card.s2c_draw):void 完成回调
function TradingCardsModel:Draw(itemList, callback)
    TradingCardsNet:GetInstance():Draw(itemList, function(msg)
        if not msg or msg.ack ~= 1 then
            return
        end

        local albumList = {}
        if msg.award and self.coolectAlbumReverseCards then
            for _, v in ipairs(msg.award.item) do
                local album = self.coolectAlbumReverseCards[v.type[1]]
                if album then
                    album:ChangeCardNumber(v.type[1], v.type[2])
                    albumList[album.albumId] = album.albumId
                end
            end
        end
        for _,item in pairs(itemList) do
            _G.StorageManager:GetInstance():ConsumeItem(item.key, 0, item.value)
        end

        -- 广播事件
        _G.Events:GetInstance():Broadcast(_G.TradingCards.NewCards)

        local albumRedpointId = self:GetRedpointIDByIndex(self.RedPointTree.Album)
        for _,albumId in pairs(albumList) do
            RedPointManager:GetInstance():RefreshNode(albumRedpointId, albumId)
        end

        if callback then
            callback(msg)
        end
    end)
end

---激活卡牌
---@param albumId number
---@param cardId number
---@param callback fun(msg:public.s2c_common_ack):void
function TradingCardsModel:ActiveCard(albumId, cardId, callback)
    local album = self.coolectAlbumReverseCards[cardId]
    if not albumId or not album or album:IsCardActive(cardId) or album:GetCardNumber(cardId) <= 0 then
        return
    end
    local id = _G.ConfigManager.trading_card_cfg[cardId].card_collection
    TradingCardsNet:GetInstance():ActiveCard(albumId, id, cardId, function(msg)
        if not msg or msg.ack ~= 1 then
            return
        end
        -- 扣除卡牌奖励
        album:SetCardActive(cardId)
        album:ChangeCardNumber(cardId, -1)
        -- 获取奖励
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
        -- 广播事件
        _G.Events:GetInstance():Broadcast(_G.TradingCards.UpdateCard, cardId)
        _G.Events:GetInstance():Broadcast(_G.TradingCards.UpdateAlbum, album.cfg.id)

        -- 刷新红点
        RedPointManager:GetInstance():RefreshNode(self:GetRedpointIDByIndex(self.RedPointTree.Album), albumId)

        if callback then
            callback(msg)
        end
    end)
end

---领取图集收集奖励
---@param albumId number    @卡册id
---@param collectionId number    @图集id
---@param callback fun(msg:public.s2c_common_ack):void 完成回调
function TradingCardsModel:GetCollectAward(albumId, collectionId, callback)
    local album = self.collectAlbums and self.collectAlbums[collectionId]
    if not album or album:IsReceivedAward() then
        return
    end

    TradingCardsNet:GetInstance():GetCollectAward(albumId, collectionId, function(msg)
        if not msg or msg.ack ~= 1 then
            return
        end
        -- 激活奖励
        album:SetReceivedAward(true)
        -- 获取奖励
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
        -- 广播事件
        _G.Events:GetInstance():Broadcast(_G.TradingCards.UpdateAlbum, collectionId)

        -- 刷新红点
        RedPointManager:GetInstance():RefreshNode(self:GetRedpointIDByIndex(self.RedPointTree.Album), albumId)

        if callback then
            callback(msg)
        end
    end)
end

---全部卡牌激活奖励
---@param albumId number 卡册id
---@param callback fun(msg:public.s2c_common_ack):void 完成回调
function TradingCardsModel:GetAlbumAward(albumId, callback)
    TradingCardsNet:GetInstance():GetAlbumAward(albumId, function(msg)
        if not msg or msg.ack ~= 1 then
            return
        end
        -- 全收集奖励
        self.collectFullAward[albumId] = true
        -- 获取奖励
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
        -- 刷新红点
        RedPointManager:GetInstance():RefreshNode(self:GetRedpointIDByIndex(self.RedPointTree.Album), albumId)

        if callback then
            callback(msg)
        end
    end)
end

---服务器推送卡牌交换
---@param info activity_trading_card.p2c_exchange_list_change
function TradingCardsModel:P2CUpdateChangeList(info)
    if info.exchanges and info.exchanges.from_role_uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
        return
    end
    if info.type == 1 then
        -- 发布
        _G.table.insert(self.changeList, 1, info.exchanges)
    elseif info.type == 2 then
        -- 交换
        local delIndex = false
        local playerUid = _G.PlayerModel:GetInstance():GetPlayerUid()
        for k, v in pairs(self.changeList) do
            if v.exchange_id == info.exchange_id then
                delIndex = k
                if v.from_role_uid == playerUid then
                    _G.Events:GetInstance():Broadcast(_G.TradingCards.NewCards)
                    local albumRedpointId = self:GetRedpointIDByIndex(self.RedPointTree.Album)
                    _G.table.insert(self.selfChangeList, {v.want_card_sid, info.give_card_sid})
                    -- 获取的卡牌
                    self.coolectAlbumReverseCards[v.want_card_sid]:ChangeCardNumber(v.want_card_sid, 1)
                    -- 交换出去的卡牌
                    self.coolectAlbumReverseCards[info.give_card_sid]:ChangeCardNumber(info.give_card_sid, -1)
                    if not self.coolectAlbumReverseCards[v.want_card_sid]:IsCardActive(v.want_card_sid) then
                        RedPointManager:GetInstance():RefreshNode(albumRedpointId, self.coolectAlbumReverseCards[v.want_card_sid].albumId)
                    end
                end
                break
            end
        end
        if delIndex then
            _G.table.remove(self.changeList, delIndex)
        end
    end
end

-- endregion

return TradingCardsModel
