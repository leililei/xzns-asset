---region ===============================换卡===============================

function TradingCardsModel:InitChangeList(msg)
    self.exchangeCount = msg.exchange_times or 0
    self.pubilshCount = msg.publish_times or 0
    self.pubilshTime = msg.last_publish_time or 0
    self.changeList = {}
    self.selfChangeList = {}
    self:GetExchangeCardList(function(msg)
        self.changeList = msg.exchanges or {}
    end)
end

function TradingCardsModel:GetChangeList()
    return self.changeList
end

--- 获取自己的被交换的交换
function TradingCardsModel:GetSelfChangeList()
    return self.selfChangeList
end

function TradingCardsModel:ResetSelfChangeList()
    self.selfChangeList = {}
end

--- 确认当前的交换是否存在
function TradingCardsModel:CheckExistExchange(exchange_id)
    for _, v in pairs(self.changeList) do
        if exchange_id == v.exchange_id then
            return true
        end
    end
    return false
end

---判断发布交换的cd
function TradingCardsModel:CheckPubilshCd()
    return self.pubilshTime + _G.ConfigManager.discrete_cfg[202203][1][1] < _G.TimeUtil.GetServerUnixTime()
end

