---@class TradingCardsCollectAlbumData
---@field cfg trading_card_collection_cfg
---@field albumId number trading_card_album_cfg中所属的id
---@field rolePath string
---@field roleParams {size:number,pos_portrait:number[]}
---@field activeMap table<number,boolean>                       @卡牌激活状态
---@field activeNum number                                      @总激活卡牌数量
---@field cardMap table<number,number>                          @可用卡牌数量(卡牌背包)
---@field cardNum number                                        @总卡牌数量
---@field receivedAward boolean                                 @是否已领取图集奖励
local TradingCardsCollectAlbumData = _G.BaseClass("TradingCardsCollectAlbumData")

function TradingCardsCollectAlbumData:__init(cfg, albumId)
    self.cfg = cfg
    self.albumId = albumId
    self:Reset()

    --rolePath默认使用第一张卡牌
    if self.cfg and #self.cfg.cards > 0 then
        local cardCfg = _G.ConfigManager.trading_card_cfg[self.cfg.cards[1]]
        self.rolePath = cardCfg and cardCfg.Portrait or ""
        self.roleParams = {}
        if cardCfg then
            self.roleParams.size = cardCfg.Size or 1
            self.roleParams.pos_portrait = cardCfg.pos_portrait
        end
    end
end

function TradingCardsCollectAlbumData:Dispose()
end

function TradingCardsCollectAlbumData:Reset()
    self.activeMap = {}
    self.cardMap = {}
    self.activeNum = 0
    self.cardNum = 0
    self.receivedAward = false
end

---获取角色立绘路径
---@return string
function TradingCardsCollectAlbumData:GetRolePath()
    return self.rolePath
end

---获取角色立绘路径
---@return {size:number,pos_portrait:number[]}
function TradingCardsCollectAlbumData:GetRoleParams()
    return self.roleParams
end

---是否已领取图集奖励(全激活)
---@return boolean
function TradingCardsCollectAlbumData:IsReceivedAward()
    return self.receivedAward or false
end

---设置图集奖励领取状态
---@param active boolean
function TradingCardsCollectAlbumData:SetReceivedAward(active)
    self.receivedAward = active or false
end

---获取包含的卡牌id列表
function TradingCardsCollectAlbumData:GetCards()
    return self.cfg.cards
end

---获取已激活卡牌数量
---@return number,number        @当前已激活数量, 总卡牌数量
function TradingCardsCollectAlbumData:GetActiveNumber()
    return self.activeNum, self.cfg and #self.cfg.cards or 0
end

---是否已激活全部卡牌
---@return boolean
function TradingCardsCollectAlbumData:IsActiveAll()
    if not self.cfg then
        return false
    end
    return self.activeNum >= #self.cfg.cards
end

---获取总卡牌数量(道具)
---@return number
function TradingCardsCollectAlbumData:GetTotalCardNumber()
    return self.cardNum or 0
end

---卡牌是否已激活
---@param cardId number
---@return boolean
function TradingCardsCollectAlbumData:IsCardActive(cardId)
    return self.activeMap[cardId] or false
end

---激活卡牌
---@param cardId number
function TradingCardsCollectAlbumData:SetCardActive(cardId)
    self.activeMap[cardId] = true
    self.activeNum = _G.table.count(self.activeMap)
end

---获取可用卡牌数量
---@param cardId number
---@return number
function TradingCardsCollectAlbumData:GetCardNumber(cardId)
    return self.cardMap[cardId] or 0
end

---设置可用卡牌数量
---@param cardId number
---@param num number
function TradingCardsCollectAlbumData:SetCardNumber(cardId, num)
    local oldNum = self.cardMap[cardId] or 0
    local newNum = num or 0
    self.cardMap[cardId] = newNum
    self.cardNum = math.max(0, self.cardNum + newNum - oldNum)
end

---增加/减少卡牌数量
---@param cardId number
---@param offset number
function TradingCardsCollectAlbumData:ChangeCardNumber(cardId, offset)
    local oldNum = self.cardMap[cardId] or 0
    self.cardMap[cardId] = math.max(0, oldNum + offset)
    self.cardNum = math.max(0, self.cardNum + offset)
end

---获取图集中激活卡牌的属性加成
---@param attribute? AttributeClass @可选，传入已有的属性对象进行累加
---@return AttributeClass, table
function TradingCardsCollectAlbumData:GetAttr(attribute)
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    if not attribute then
        attribute = AttributeClassManager:GetAttribtueClass()
    end
    local cards = self:GetCards()
    for _, cardId in pairs(cards) do
        if self:IsCardActive(cardId) then
            local cardCfg = _G.ConfigManager.trading_card_cfg[cardId]
            if cardCfg and cardCfg.attribute then
                for _, v in pairs(cardCfg.attribute) do
                    local attType = tonumber(v[2]) or 1
                    local attValue = tonumber(v[3]) or 0
                    local type
                    if attType == 2 then
                        type = _G.AttCountType.basePercent
                    elseif _G.AttrType[v[1]].percentage == 1 then
                        type = _G.AttCountType.basePercent
                    else
                        type =  _G.AttCountType.other
                    end
                    attribute:AddValueByName(
                        v[1],
                        AttributeClassManager:GetValueWithName(v[1], attValue, attType),
                        false,
                        type
                    )
                end
            end
        end
    end
    local changeAttrTypes = AttributeClassManager:GetChangeAttrTypes(attribute)
    return attribute, changeAttrTypes
end

return TradingCardsCollectAlbumData
