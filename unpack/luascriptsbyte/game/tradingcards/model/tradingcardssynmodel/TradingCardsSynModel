local base = require("ActivitySynTypeBase")
---@class TradingCardsSynModel : ActivitySynTypeBase	中文描述
local TradingCardsSynModel = _G.BaseClass("TradingCardsSynModel", base)

function TradingCardsSynModel:OnHandleGMData(data)
    local model = require("TradingCardsModel"):GetInstance()
    model:GetInfo(data.trading_card1.album_sid, self, _G.handler(self, self.ParseData))
end

---region ===============================红点树===============================

---红点树index定义: 从2开始(1作为GM活动根节点)
local RedPointTree = {
    Root = 1,
    Album = 2,
    Change = 3
}

TradingCardsSynModel.RedPointTree = RedPointTree

---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function TradingCardsSynModel:InitRedPointTree()
    self.checkRedPointFunc = {
        nil,
        [RedPointTree.Album] = self.CheckRedpointAlbum,
        [RedPointTree.Change] = self.CheckChangeClick
    }
    -- [index]必需依次递增, 不可中断
    self.redpointTree = {
        [RedPointTree.Root] = { RedPointTree.Album, RedPointTree.Change },
        -- 卡册红点
        [RedPointTree.Album] = false,
        -- 交换卡牌红点
        [RedPointTree.Change] = false
    }
    
end

---获取红点参数
function TradingCardsSynModel:GetRedPointParams(id)
    if id == RedPointTree.Album then
        local params = {}
        for _, cfg in pairs(_G.ConfigManager.trading_card_album_cfg) do
            _G.table.insert(params, cfg.id)
        end
        return params
    end
    return {}
end

---调用红点数检测方法
function TradingCardsSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self, param)
    end
    return 0
end

---检查集卡红点(合并FullAward和Albums逻辑)
---@return number
function TradingCardsSynModel:CheckRedpointAlbum(albumId)
    local model = require("TradingCardsModel"):GetInstance()
    if not model or not model.collectAlbums then
        return 0
    end

    local idList
    if not albumId or albumId == -1 or albumId == 0 then
        idList = {}
        for _,v in pairs(_G.ConfigManager.trading_card_album_cfg) do
            _G.table.insert(idList, v.id)
        end
    else
        idList = {albumId}
    end

    for _,id in pairs(idList) do
        local albumList = _G.ConfigManager.trading_card_album_cfg[id]
        -- 全图集奖励未领取
        if not model.collectFullAward[id] then
            local allActive = true
            for _, id in pairs(albumList.albums) do
                local album = model.collectAlbums[id]
                if album then
                    if not album:IsActiveAll() then
                        allActive = false
                        for _, cardId in ipairs(album:GetCards()) do
                            if not album:IsCardActive(cardId) and album:GetCardNumber(cardId) > 0 then
                                return 1
                            end
                        end
                    else
                        if not album:IsReceivedAward() then
                            -- 图集的全激活奖励可以领取
                            return 1
                        end
                    end
                end
            end
            if allActive then
                return 1
            end
        end
    end
    return 0
end

---检测今天是否点击了交换界面
function TradingCardsSynModel:CheckChangeClick()
    local time = _G.PlayerPrefsManager.GetInt("TradingCardsChangeRedPoint", 0)
    if time == 0 or not _G.TimeUtil.CheckTheSameDay(time, _G.TimeUtil.GetServerUnixTime()) then
        return 1
    end
    return 0
end

-- endregion

return TradingCardsSynModel
