---@class WorldNPCModel
---@field AllNpcByUid table<number,WorldNPCItem> 本场景所有的Npc
local WorldNPCModel = _G.BaseClass("WorldNPCModel")

---类的构造函数
function WorldNPCModel:__init()
end

---类的析构函数
function WorldNPCModel:Dispose()
    self.World = nil
    self.AllNpcByUid = nil
end

--场景加载物体
---@param world BaseWorld 当前场景
function WorldNPCModel:OnLoadObjectComplete(world)
    self.World = world
    self.AllNpcByUid = {}
    local normaltype = _G.WorldItemDataType.NomalItem
    local npctype = _G.WorldItemType.NPC
    for key, value in pairs(world.AllWorldItems) do
        if value.DataType == normaltype and value.ItemData.ItemType and value.ItemData.ItemType == npctype then
            self.AllNpcByUid[key] = value
        end
    end
    for _, value in pairs(self.AllNpcByUid) do
        value.Enable = false
    end
end

function WorldNPCModel:OnEnterWorld()
    for _, value in pairs(self.AllNpcByUid) do
        if value.OnEnterWorld then
            value:OnEnterWorld()
        end
    end
end

return WorldNPCModel
