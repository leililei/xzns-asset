---@field DoorItemThisScene WorldDoorItem[]
---@class WorldDoorModel 场景传送门模块
local WorldDoorModel = _G.BaseClass("WorldDoorModel")

function WorldDoorModel:__init()
    self.DoorItemThisScene = {}
    _G.Events:GetInstance():AddListener(_G.eScene.PassDoor, self.OnPassDoor, self)
    -- _G.Events:GetInstance():AddListener(_G.ePlayerStatus.PlayerMoveStart, self.OnPlayerMoveStart, self)
end

--场景加载物体
---@param world BaseWorld 当前场景
function WorldDoorModel:OnLoadObjectComplete(world)
    self.DoorItemThisScene = {}
    local normaltype = _G.WorldItemDataType.NomalItem
    local doortype = _G.WorldItemType.Door
    for key, value in pairs(world.AllWorldItems) do
        if value.DataType == normaltype and value.ItemData.ItemType and value.ItemData.ItemType == doortype then
            if not self.DoorItemThisScene[key] then
                self.DoorItemThisScene[key] = value
            end
        end
    end
end

--场景创建结束
---@param world BaseWorld 当前场景
function WorldDoorModel:OnEnterWorld()
    for _, value in pairs(self.DoorItemThisScene) do
        value:OnEnterWorld()
    end
end

--退出当前场景
function WorldDoorModel:OnExitWorld()
    self.DoorItemThisScene = {}
end

---移动时开启传送门
function WorldDoorModel:OnPlayerMoveStart()
    self:SetAllDoorItemEnable(true)
end

--找到本场景的对应传送门
---@param sid number sid
---@return WorldDoorItem
function WorldDoorModel:GetSceneDoorItemBySid(sid)
    local doorSid = sid
    local doorUid
    for _, value in pairs(self.DoorItemThisScene) do
        if value.Sid == doorSid then
            local id = value.ID or value.Uid
            doorUid = id
            break
        end
    end

    local doorItem
    if doorUid then
        doorItem = self.DoorItemThisScene[doorUid]
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("Dont Find Door    " .. sid)
        end
        return nil
    end

    if not doorItem then
        if _G.AppSetting.DEBUG then
            _G.LogError("Dont Find Door    " .. sid)
        end
        return nil
    end

    return doorItem, doorUid
end

--本场景对应传送门开关
---@param enable boolean
function WorldDoorModel:SetAllDoorItemEnable(enable)
    for _, value in pairs(self.DoorItemThisScene) do
        value.Enable = enable
    end
end

--找到本场景的对应传送门
---@param sid number sid
function WorldDoorModel:OnPassDoor(sid)
    local WorldPlayer = _G.WorldManager:GetInstance():GetCurWorldPlayer()
    local doorItem = self:GetSceneDoorItemBySid(sid)
    self:SetAllDoorItemEnable(false)
    if doorItem then
        local x, y, z = doorItem.Transform:GetLocalPosition()
        local targetPos = {x = x, y = y, z = z}
        x, y, z = doorItem.Transform:GetLocalEulerAngles()
        local targetAngles = {x = x, y = y, z = z}
        WorldPlayer:SetInitPosition(targetPos, targetAngles)
    else
        WorldPlayer:SetInitPosition()
    end
end

return WorldDoorModel
