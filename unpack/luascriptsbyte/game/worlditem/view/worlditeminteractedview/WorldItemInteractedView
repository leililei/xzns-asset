local updateTimeDelta = 0.04

---@class WorldItemInteractedView : UIBaseView	中文描述
---@field public go_table WorldItemInteractedView_GoTable GoTable
local WorldItemInteractedView = _G.BaseClass("WorldItemInteractedView", _G.UIBaseView)
function WorldItemInteractedView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIHide, self.OnMainViewHide, self)
end

---界面入口函数
---@param click function 点击回调方法
function WorldItemInteractedView:OnCreate(click)
    self.onClickCall = click
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_jiaohuanniu,
        self.go_table.trans_ef,
        function(effect)
            if not self.go_table then
                _G.UIUtils.RemoveEffect(effect)
            else
                self.go_table.trans_ef:SetActiveE(0)
            end
        end
    )
    if not _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.MainSiegeView.Name) then
        _G.UIManager:GetInstance():ChangeCanvasOrder(self.viewName, 15)
    end
end
function WorldItemInteractedView:OnDestroy()
    self.btns = nil
    self.onClickCall = nil
    self.interactedTime = nil
    self.curInteractedTime = nil
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIHide, self.OnMainViewHide, self)
end
---按钮点击事件在这里派发
function WorldItemInteractedView:OnClickBtn(go)
    for _type, btn in pairs(self.btns) do
        if go == btn then
            if self.onClickCall then
                self.onClickCall(_type)
            end
            break
        end
    end
end

function WorldItemInteractedView:OnMainViewHide(name)
    if name == _G.ConfigManager.ui_cfg.MainView.Name then
        self:Close()
    end
end

function WorldItemInteractedView:UpdateTime(elapsed)
    self.curInteractedTime = self.curInteractedTime + elapsed
    self.go_table.aorimage_time.fillAmount = self.curInteractedTime / self.interactedTime
    if self.curInteractedTime >= self.interactedTime then
        self.updateTimer:Stop()
        self.updateTimer = nil
        self:Close()
    end
end
--region 对外接口
---展示按钮
---@param _type _G.WorldItemType 物件类型
function WorldItemInteractedView:Show(_type)
    if not self.btns then
        self.btns = {
            [_G.WorldItemType.Box] = self.go_table.aorbtn_docollect,
            [_G.WorldItemType.Enemy] = self.go_table.aorbtn_fight,
            [_G.WorldItemType.NPC] = self.go_table.aorbtn_talk
        }
    end
    for t, btn in pairs(self.btns) do
        if t == _type then
            local x, y, z = btn:GetLocalPosition()
            self.go_table.trans_ef:SetLocalPosition(x, y, z)
            _G.GameUtil.SetActiveByCondition(btn, true)
            self.go_table.trans_ef:SetActiveE(1)
        else
            _G.GameUtil.SetActiveByCondition(btn, false)
            self.go_table.trans_ef:SetActiveE(0)
        end
    end
end
---展示时间
---@param time number 倒计时(<=0/nil 直接关闭)
function WorldItemInteractedView:ShowTime(time)
    self.interactedTime = time
    if not self.interactedTime or self.interactedTime <= 0 then
        self:Close()
        return
    end
    if self.go_table.aorbtn_docollect:GetActiveSelf() == 0 then
        self:Close()
        return
    end
    self.curInteractedTime = 0
    self.updateTimer = _G.TimerManager:GetInstance():GetTimer(updateTimeDelta, self.UpdateTime, self)
    self.updateTimer:Start()
end
--endregion

return WorldItemInteractedView
