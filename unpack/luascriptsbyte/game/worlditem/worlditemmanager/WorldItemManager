    enemyBattleDone = "OnEnemyBattleDone",
    interactionDone = "WorldObjectInteractionDone",
    interactionBoxStart = "WorldBoxInteractionBoxStart",
    interactionBoxEnd = "WorldBoxInteractionBoxEnd"
}
WorldItemManager.ItemEvent = ItemEvent

---创建对象时,入口构造函数
function WorldItemManager:__init()
    self.TotalModels = {}
    self.TotalModels[_G.WorldItemType.Door] = WorldDoorModel.New()
    self.TotalModels[_G.WorldItemType.NPC] = WorldNPCModel.New()
    self.interactionObjects = {}
    self.curSceneSid = 0
    self.dynWorldItemIndex = 0
    self.interactedItemDic = {}
end

function WorldItemManager:Dispose()
    self.TotalModels = nil
    self.interactionObjects = nil
    self.curSceneSid = nil
    self.dynWorldItemIndex = nil
    self.interactedItemDic = nil
end

function WorldItemManager:GetDataFormServer()
    _G.WorldNet:GetInstance():GetWorldObjectInfo(_G.handler(self, self.ParseData))
end
function WorldItemManager:ParseData(data)
    data = data.sid or {}
    self.interactionObjects = {}
    for i = 1, #data do
        self.interactionObjects[data[i]] = true
    end
    base.ParseData(self, data)
end

--region 对外接口
---当所有物件加载完毕后调用
function WorldItemManager:OnLoadObjectComplete()
    if not _G.AppSetting.IsloadScence then
        return
    end
    self.curWorld = _G.WorldManager:GetInstance():GetCurWorld()
    self.AllWorldItems = self.curWorld.AllWorldItems
    for _, value in pairs(self.TotalModels) do
        if value.OnLoadObjectComplete then
            value:OnLoadObjectComplete(self.curWorld)
        end
    end
end
---寻找对应的功能模块
---@param type WorldItemType 中文描述
---@return table 对应的功能模块
function WorldItemManager:GetModelByType(type)
    if self.TotalModels[type] then
        return self.TotalModels[type]
    end

    if _G.AppSetting.DEBUG then
        _G.LogError("Dont Find this Model", type)
    end
    return nil
end
---根据类型获取物件组
---@param type WorldItemType 物件类型
---@return table 物件数组
function WorldItemManager:GetItemsByType(type)
    local items = {}
    for key, value in pairs(self.AllWorldItems) do
        if value.ItemType == type then
            items[key] = value
        end
    end
    return items
end
---根据类型显示或者隐藏物件
---@param _type number 物件类型
---@param show boolean 显示(true)/隐藏(false)
---@param force boolean 是否强制
function WorldItemManager:ShowOrHideByType(_type, show, force)
    local items = self:GetItemsByType(_type)
    for key, value in pairs(items) do
        value:ShowOrHide(show, force)
    end
end
---获取物件sid数组
---@param type WorldItemType 物件类型
---@param worldSid number 世界id(scene_cfg中的id)
---@return table 物件sid数组
function WorldItemManager:GetItemSidsByType(type, worldSid)
    local cfg = _G.ConfigManager.scene_cfg[worldSid]
    local data = require(cfg.TiledResLua)
    local _datas = data.WorldItemDatas
    local items = {}
    for _, value in pairs(_datas) do
        for _, itemData in pairs(value) do
            if itemData.ItemType == type then
                _G.table.insert(items, itemData.Sid)
            end
        end
    end
    return items
end

