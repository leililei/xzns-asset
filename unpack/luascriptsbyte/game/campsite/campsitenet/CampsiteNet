local base = require("BaseGameNet")

---@class CampsiteNet : BaseGameNet	通信协议
local CampsiteNet = _G.BaseClass("CampsiteModel", base)
---@return CampsiteModel CampsiteModel
function CampsiteNet:GetInstance()
    return base.GetInstance(self)
end

---请求 获得 服务器 营地所有信息
---@param pbData table PB数据
---@param callback function 完成回调
function CampsiteNet:AccessCampInfos(callback)
    local item = _G.ConfigManager.net_map.game_camp_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.CallInfo))
    self.Call[port] = callback
end

--营地 卡牌 行为放置，取出，换卡
---@param type number 1 放卡，2取卡，3换卡
---@param beinfo i_card 槽位信息
---@param cid number 营地id
---@param uid number 卡牌uid
---@param location number 替换位置
function CampsiteNet:AccessCampBehavior(pbData, callback)
    local item = _G.ConfigManager.net_map.game_camp_behavior
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallInfo))
    self.Call[port] = callback
end

--营地 卡牌 一键上阵
---@param cards i_card 槽位信息
---@param cid number 营地id
---@param uid number 卡牌uid
---@param location number 替换位置
function CampsiteNet:AccessCampAutoUp(pbData, callback)
    local item = _G.ConfigManager.net_map.game_camp_put
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallInfo))
    self.Call[port] = callback
end
---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function CampsiteNet:CallInfo(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return CampsiteNet
