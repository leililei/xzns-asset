        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_queding, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_down, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_replace, false)
