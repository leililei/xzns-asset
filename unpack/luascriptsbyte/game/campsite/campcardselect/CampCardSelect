        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_queding, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_down, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_replace, false)
    elseif num == _G.CampBehaviorEnum.replaceCard then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_queding, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_down, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_replace, true)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_queding, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_down, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_replace, false)
    end
end
