--更新展示的 卡牌
function CampCardSelect:initCardAllLists()
    local allcards1 = self.campinfo:GetCampRenCards() or {}
    if _G.table.isEmptyOrNil(allcards1) then
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_nothing, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_queding, false)
        return
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_nothing, false)
    end
    local allcards = {}
    for key, va in pairs(allcards1) do
        allcards[key] = va[1]
    end
    local cardPos_info = self.campinfo.card_info
    if not _G.table.isEmptyOrNil(cardPos_info) then
        for key, value in pairs(cardPos_info) do
            if not _G.table.isEmptyOrNil(value) then
                -- body
                local cardd = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, value.uid)
                for k, va in pairs(allcards) do
                    if cardd.sid == tonumber(k) and cardd.uid ~= va.uid then
                        allcards[k] = nil
                        break
                    end
                end
            end
        end
    end
    if _G.table.isEmptyOrNil(allcards) then
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_nothing, true)
        return
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_nothing, false)
    end
    self.cards_lists = {}
    for key, value in pairs(allcards) do
        if value:GetCampPos() == 0 or value:GetCampPos() == self.onclick_Ind then
            _G.table.insert(self.cards_lists, value)
        end
    end
    if _G.table.isEmptyOrNil(self.cards_lists) then
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_nothing, true)
        return
    end
    _G.table.sort(
        self.cards_lists,
        function(a, b)
            local function sortState(pos)
                if pos ~= 0 then
                    return 10
                else
                    return 9
                end
            end
            local aState = sortState(a:GetCampPos())
            local bState = sortState(b:GetCampPos())
            if aState ~= bState then
                return aState > bState
            elseif aState == bState and a.star > b.star then
                return true
            elseif aState == bState and a.star == b.star and a.sid > b.sid then
                return true
            end
            return false
        end
    )
end
---更新 是否有卡牌
function CampCardSelect:UpdateNothing()
    if _G.table.isEmptyOrNil(self.StorageCard) then
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_nothing, true)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_nothing, false)
    end
end
--选择卡牌  五行（1-雷；2-风；3-水；4-火；5-土）
function CampCardSelect:SelectWuxing()
    local items = self.cards_lists
    self.CardData = {}
    self.StorageCard = {}
    if self.Elements_type == 0 then
        self.StorageCard = self.cards_lists
        if _G.table.isEmptyOrNil(self.StorageCard) then
        else
            self:RefreshAllItem()
        end
        self:UpdateNothing()
        return
    end

    for i = 1, #items do
        if require "CardInfoManager":GetInstance():CheckMultiMatchCOP(items[i].cfg.Elements_new,self.Elements_type) then
            table.insert(self.StorageCard, items[i])
        end
    end
    if _G.table.isEmptyOrNil(self.StorageCard) then
    else
        self:RefreshAllItem()
    end
    self:UpdateNothing()
end
---刷新
function CampCardSelect:RefreshAllItem()
    self.itemTransLuaDic = {}
    local sumCount = #self.StorageCard
    if self.mlistView2 == nil then
        self.go_table.scrollloopvectical_kapai:InitItemData(sumCount, _G.handler(self, self.RefreshRenItem))
        self.mlistView2 = self.go_table.scrollloopvectical_kapai
    else
        self.go_table.scrollloopvectical_kapai:UpdateCount(sumCount)
    end
end

function CampCardSelect:RefreshRenItem(index, obj)
    if index < 0 then
        return
    end
    local t_index = index + 1
    local params = self.StorageCard[index + 1]
    local ItemCardBodySelectView = self:GetComponent(obj, camp_card_body_select)
    if not ItemCardBodySelectView then
        ItemCardBodySelectView =
            self:AddComponent(
            obj,
            camp_card_body_select.New(
                obj,
                function()
                    self.itemTransLuaDic[params.uid] = ItemCardBodySelectView
                    self:Refresh_SetItem(obj, ItemCardBodySelectView, params, t_index)
                end
            )
        )
    else
        _G.GameUtil.SetActiveByCondition(obj, false)
        self.itemTransLuaDic[params.uid] = ItemCardBodySelectView
        self:Refresh_SetItem(obj, ItemCardBodySelectView, params, t_index)
    end
    return obj
end
function CampCardSelect:Refresh_SetItem(obj, ItemCardBodySelectView, params, itemindex)
    _G.GameUtil.SetActiveByCondition(obj, true)
    ItemCardBodySelectView:ShowCardData(
        ItemCardBodySelectView.Item,
        params,
        _G.handler(self, self.OnCardBodyClick_bg),
        true,
        itemindex,
        params.uid
    )
    local isSelect = false
    if self.CardData ~= nil then
        isSelect = params.uid == self.CardData.uid
    end
    local tb = _G.GetAutoGoTable(obj)
    local card = params
    local att = self.campinfo:CalCampCardAttribute(card)
    local value = 0
    if att then
        tb.aortext_att.text =
            _G.LangUtil.GetLangPackValue(90020300006) .. "<color=#14874a>+" .. att["atk"] .. "%</color>"
    else
        tb.aortext_att.text = ""
    end
    if params:GetCampPos() == 0 then
        _G.GameUtil.SetActiveByCondition(tb.obj_mask, false)
    elseif params:GetCampPos() == self.onclick_Ind then
        --tb.aortext_Desc.text = "已上阵"
        _G.GameUtil.SetActiveByCondition(tb.obj_mask, true)
    end
    self.itemTransLuaDic[params.uid].Item:SetSelectGou(isSelect)
end
function CampCardSelect:OnCardBodyClick_bg(parmas)
    if tonumber(parmas[1]) == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(" CardBagView.OnCardBodyClick_bg 参数有误")
        end
        return
    end
    if not _G.table.isEmptyOrNil(self.CardData) then
        local uid = self.StorageCard[parmas[1]].uid
        self.itemTransLuaDic[self.CardData.uid].Item:SetSelectGou(false)
    end
    self.nowCardIndex = parmas[1]
    self.CardData = self.StorageCard[parmas[1]]
    self.itemTransLuaDic[parmas[2]].Item:SetSelectGou(true)
    self.i_card = {
        cid = self.campinfo.campid,
        uid = self.CardData.uid,
        location = self.onclick_Ind
    }
    if self.flag then
        self:SetShowButton(_G.CampBehaviorEnum.putCard)
    else
        if self.CardData:GetCampPos() == self.onclick_Ind then
            self:SetShowButton(_G.CampBehaviorEnum.popCard)
        else
            self:SetShowButton(_G.CampBehaviorEnum.replaceCard)
        end
    end
end

--region 点击事件
---取出卡牌
function CampCardSelect:PopCard(card)
    self.campinfo.kacaoinfo[self.onclick_Ind] = _G.CampPosEnum.add
    self.campinfo.card_info[self.onclick_Ind] = {}
    card:SetCampPos(0)
end
---替换卡牌
function CampCardSelect:ReplaceCard(card, i_card)
    self.campinfo.kacaoinfo[self.onclick_Ind] = _G.CampPosEnum.cardsid
    if not _G.table.isEmptyOrNil(self.campinfo.card_info[self.onclick_Ind]) then
        local carddata =
            _G.StorageManager:GetInstance():GetItemDataByID(
            _G.StorageID.Card,
            self.campinfo.card_info[self.onclick_Ind].uid
        )
        carddata:SetCampPos(0)
    end
    self.campinfo.card_info[self.onclick_Ind] = i_card
    card:SetCampPos(self.onclick_Ind)
end
---放置卡牌
function CampCardSelect:PutCard(card, i_card)
    self.campinfo.kacaoinfo[self.onclick_Ind] = _G.CampPosEnum.cardsid
    self.campinfo.card_info[self.onclick_Ind] = i_card
    card:SetCampPos(self.onclick_Ind)
end

---放置卡牌
function CampCardSelect:Behaviro(card, pbData)
    require("CampsiteNet"):GetInstance():AccessCampBehavior(
        pbData,
        function(data)
            if data.ack ~= 1 then
                _G.FloatTipsModel:GetInstance():Show(data.ack)
                return
            end
            local tipsid = 0
            if pbData.type == _G.CampBehaviorEnum.putCard then
                --_G.PopWindowManager:GetInstance():ShowAllTips(tipsid)
                tipsid = 480104
                self:PutCard(card, pbData.be_info)
            elseif pbData.type == _G.CampBehaviorEnum.popCard then
                --local count = _G.LangUtil.GetLangPackValue(90012300054)
                --_G.FloatTipsModel:GetInstance():Show(count)
                self:PopCard(card)
            elseif pbData.type == _G.CampBehaviorEnum.replaceCard then
                tipsid = 480105
                self:ReplaceCard(card, pbData.be_info)
            end
            --_G.PopWindowManager:GetInstance():ShowAllTips(tipsid)

            --刷新红点
            for i = 1, 6 do
                require("CampsiteModel"):GetInstance():RefRedPoinCamp(self.campinfo.campid, i)
            end
            require("CampsiteModel").currentCampId = self.campinfo.campid
            _G.Events:GetInstance():Broadcast(_G.eCamp.PalyEffect, {self.onclick_Ind})
            self.campinfo:AllCalCamp()

            require("CampsiteModel"):GetInstance():CountUpdata(self.campinfo.campid)
            ---刷新主界面的 战力
            local windows = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.MainView.Name)
            if windows then
                windows.View:UpdatePower()
            end
            if self.callBack then
                self.callBack(self.campinfo)
                self:CloseView()
            end
        end
    )
end
