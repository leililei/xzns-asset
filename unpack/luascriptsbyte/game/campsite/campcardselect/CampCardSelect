--region 点击
---按钮点击事件在这里派发
function CampCardSelect:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_close" then
        self:CloseView()
    elseif name == "@_aorbtn_closeview" then
        self:CloseView()
    elseif name == "@_aorbtn_queding" then
        self:SureButton()
    elseif name == "@_aorbtn_down" then
        self:DownButton()
    elseif name == "@_aorbtn_replace" then
        self:ReplaceButton()
    elseif name == "$_toggle_1" then
        if isOn then
            self.Elements_type = Elements_enum.quan
            self:SelectWuxing()
        end
    elseif name == "$_toggle_2" then
        if isOn then
            self.Elements_type = Elements_enum.shen
            self:SelectWuxing()
        end
    elseif name == "$_toggle_3" then
        if isOn then
            self.Elements_type = Elements_enum.feng
            self:SelectWuxing()
        end
    elseif name == "$_toggle_4" then
        if isOn then
            self.Elements_type = Elements_enum.lei
            self:SelectWuxing()
        end
    elseif name == "$_toggle_5" then
        if isOn then
            self.Elements_type = Elements_enum.shui
            self:SelectWuxing()
        end
    elseif name == "$_toggle_6" then
        if isOn then
            self.Elements_type = Elements_enum.huo
            self:SelectWuxing()
        end
    elseif name == "$_toggle_7" then
        if isOn then
            self.Elements_type = Elements_enum.tu
            self:SelectWuxing()
        end
    end
    self.isInit = true
    --_G.AudioManager.PlayAudioByAudioCfgID(2049)
end
function CampCardSelect:CloseView()
    if self.callBack ~= nil then
        self.callBack = nil
    end
    self:Close()
end

---确定 添加卡牌
function CampCardSelect:SureButton()
    if _G.table.isEmptyOrNil(self.i_card) then
        return
    end
    if _G.table.isEmptyOrNil(self.CardData) then
        return
    end
    local pbData = {
        type = _G.CampBehaviorEnum.putCard,
        be_info = {}
    }
    pbData.be_info = self.i_card
    self:Behaviro(self.CardData, pbData)
end
---卸下
function CampCardSelect:DownButton()
    if _G.table.isEmptyOrNil(self.i_card) then
        return
    end
    local pbData = {
        type = _G.CampBehaviorEnum.popCard,
        be_info = {}
    }
    pbData.be_info = self.i_card
    self:Behaviro(self.CardData, pbData)
end
---替换
function CampCardSelect:ReplaceButton()
    if _G.table.isEmptyOrNil(self.i_card) then
        return
    end
    local pbData = {
        type = _G.CampBehaviorEnum.replaceCard,
        be_info = {}
    }
    pbData.be_info = self.i_card
    self:Behaviro(self.CardData, pbData)
end
