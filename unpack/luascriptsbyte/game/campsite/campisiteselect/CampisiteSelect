function CampisiteSelect:ShowCampInfoView()
    local campinfo = self.model:GetCampInfo(self.currentCampId)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.CampsiteShow.Name,
        campinfo,
        function()
            self:UpdateCampPrefab()
        end
    )
