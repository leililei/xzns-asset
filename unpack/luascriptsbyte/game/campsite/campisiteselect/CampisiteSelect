local typeof = _G.typeof
local item = "UI/Campsite/CampsiteItem"

function CampisiteSelect:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.model = require("CampsiteModel"):GetInstance()
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["@_aorbtn_tu_1"] = self.OnClickTuCamp,
        ["@_aorbtn_lei_2"] = self.OnClickLeiCamp,
        ["@_aorbtn_huo_3"] = self.OnClickFireCamp,
        ["@_aorbtn_Gad_4"] = self.OnClickShenCamp,
        ["@_aorbtn_shui_5"] = self.OnClickShuiCamp,
        ["@_aorbtn_feng_6"] = self.OnClickFengCamp,
        ["@_aorbtn_AllAttribute"] = self.OnClickAttribute,
        ["@_aorbtn_CloseTips"] = self.CloseTipsClick,
        ["@_aorbtn_help"] = self.HelpOnClick,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    self.localCampPre = {
        [101] = self.go_table.obj_item_lei,
        [102] = self.go_table.obj_item_feng,
        [103] = self.go_table.obj_item_shui,
        [104] = self.go_table.obj_item_huo,
        [105] = self.go_table.obj_item_tu,
        [106] = self.go_table.obj_item_shen
    }
    self.redpoinCamp = {
        [101] = self.go_table.obj_redpoint_lei,
        [102] = self.go_table.obj_redpoint_feng,
        [103] = self.go_table.obj_redpoint_shui,
        [104] = self.go_table.obj_redpoint_huo,
        [105] = self.go_table.obj_redpoint_tu,
        [106] = self.go_table.obj_redpoint_shen
    }
end

---界面的入口函数
function CampisiteSelect:OnCreate(callback)
    if callback then
        self.callback = callback
    end
    self.currentCampId = 0
    self.allCamp = self.model:GetAllCamp()
    self:SetRedPoint()
    self:UpdateCampPrefab()
    local RedPointManagerIns = require "RedPointManager":GetInstance()
    local redID = _G.ConfigManager.redpoint_cfg.Caedcamproom.id
    for key, value in pairs(self.localCampPre) do
        for i = 1, 6 do
            RedPointManagerIns:RefreshNode(redID, key * 10 + i)
        end
    end
    self:InitEffect()
end
function CampisiteSelect:InitEffect()
    local LoadEffect = _G.UIUtils.LoadEffectByCfg
    local effectCfg = _G.ConfigManager.ui_effect_cfg
    local RemoveEffect = _G.UIUtils.RemoveEffect
    local effDic = {
        [101] = {effectCfg.ef_wulingbaozhu_lei, effectCfg.ef_wulingbaozhu_lei_dian},
        [102] = {effectCfg.ef_wulingbaozhu_feng, effectCfg.ef_wulingbaozhu_feng_dian},
        [103] = {effectCfg.ef_wulingbaozhu_shui, effectCfg.ef_wulingbaozhu_shui_dian},
        [104] = {effectCfg.ef_wulingbaozhu_huo, effectCfg.ef_wulingbaozhu_huo_dian},
        [105] = {effectCfg.ef_wulingbaozhu_tu, effectCfg.ef_wulingbaozhu_tu_dian},
        [106] = {effectCfg.ef_wulingbaozhu_shen, effectCfg.ef_wulingbaozhu_shen_dian}
    }
    local mself = self
    local loadEffCall = function(effect)
        if not mself.go_table then
            RemoveEffect(effect)
        end
    end
    for key, value in pairs(self.localCampPre) do
        local tb = _G.GetAutoGoTable(value)
        local node = tb.obj_node
        for i = 1, 6 do
            LoadEffect(effDic[key][2], node:GetChildE(i - 1), loadEffCall)
        end
        LoadEffect(effDic[key][1], value, loadEffCall)
    end
    LoadEffect(effectCfg.ef_baozhulianjiedian, self.go_table.trans_eff, loadEffCall)
end
---动态设置红点参数
function CampisiteSelect:SetRedPoint()
    for key, value in pairs(self.localCampPre) do
        local tb = _G.GetAutoGoTable(value)
        tb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.Cardcampelements.id, key)
    end
end
---设置灵珠信息
---@param campdata table 营地数据
function CampisiteSelect:SetOneCampPrefab(go, campdata)
    local tb = _G.GetAutoGoTable(go)
    local card_info = campdata.card_info
    local num = 0
    if _G.table.isEmptyOrNil(card_info) then
        num = 0
    else
        for key, value in pairs(card_info) do
            if _G.table.isEmptyOrNil(card_info[key]) then
            else
                num = num + 1
            end
        end
    end
    tb.aortext_upNum.text = string.format("%d/6", num)
    local node = tb.obj_node
    for i = 1, 6 do
        if i <= num then
            _G.GameUtil.SetActiveByCondition(node:GetChildE(i - 1), true)
        else
            _G.GameUtil.SetActiveByCondition(node:GetChildE(i - 1), false)
        end
    end
end

---更新灵珠信息
function CampisiteSelect:UpdateCampPrefab()
    for key, value in pairs(self.allCamp) do
        self:SetOneCampPrefab(self.localCampPre[key], self.allCamp[key])
    end
    self:ShowAttributeInfo()
end

---按钮点击事件在这里派发
function CampisiteSelect:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
    --_G.AudioManager.PlayAudioByAudioCfgID(2049)
end
function CampisiteSelect:CloseTipsClick()
    if self.go_table.obj_tipsNode:GetActiveSelf() == 1 then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_tipsNode, false)
        return
    end
end
function CampisiteSelect:CloseView()
    if self.callback then
        self.callback()
    end
    self:Close()
end
---帮助按钮
function CampisiteSelect:HelpOnClick()
    --_G.ConfigManager.instruction_cfg.id == 20
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 35)
end
