    -- if windows then
    --     _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.CampsiteShow.Name, campinfo)
    -- else
    -- end
end
function CampisiteSelect:ShowAttributeInfo()
    local camp = self.model:GetAllCamp()
    local node = self.go_table.obj_ShowNode
    for i = 1, node:GetChildCountE() do
        local key = node:GetChildE(i - 1):GetName()
        key=_G.string.replace(key,"$_obj_","")
        key = tonumber(key)
        local allattribute = camp[key]:CalCampAttribute()
        self:OneAttributUI(node:GetChildE(i - 1), allattribute)
    end
end
function CampisiteSelect:OneAttributUI(go, data)
    local tb = _G.GetAutoGoTable(go)
    tb.aortext_att_1.text = "+" .. data.atk .. "%"
    tb.aortext_att_2.text = "+" .. data.max_hp .. "%"
    tb.aortext_att_3.text = "+" .. data.def .. "%"
    tb.aortext_att_4.text = "+" .. data.bre .. "%"
end
--endregion
