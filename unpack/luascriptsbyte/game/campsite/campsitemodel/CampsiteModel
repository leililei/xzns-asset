function CampsiteModel:AutoUp(campinfo, callCamp)
    local pbData = {
        type = 1,
        cards = {}
    }
    pbData.cards = self:CheckAuotReplace(campinfo.campid)
    if _G.table.isEmptyOrNil(pbData.cards) then
        local flag = true
        for i = 1, pos_num do
            if campinfo.kacaoinfo[i] == _G.CampPosEnum.add then
                flag = false
                break
            end
        end
        if flag then
            _G.PopWindowManager:GetInstance():ShowAllTips(480102) --已经是最大的
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(480101) --没有卡牌了
        end
        return
    end
    require("CampsiteNet"):GetInstance():AccessCampAutoUp(
        pbData,
        function(data)
            if data.ack ~= 1 then
                return
            end
            local cinfo = campinfo
            local indexs = {}
            for i = 1, #pbData.cards do
                cinfo:SetKaCaoInfo(pbData.cards[i].location, _G.CampPosEnum.cardsid)
                if not _G.table.isEmptyOrNil(cinfo.card_info[pbData.cards[i].location]) then
                    local card =
                        _G.StorageManager:GetInstance():GetItemDataByID(
                        _G.StorageID.Card,
                        cinfo.card_info[pbData.cards[i].location].uid
                    )
                    card:SetCampPos(0)
                end
                cinfo.card_info[pbData.cards[i].location] = pbData.cards[i]
                local nowCard = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, pbData.cards[i].uid)
                nowCard:SetCampPos(pbData.cards[i].location)
                --刷新红点
                --self:RefRedPoinCamp(campinfo.campid, pbData.cards[i].location)
                --刷新红点
                for i = 1, pos_num do
                    self:RefRedPoinCamp(campinfo.campid, i)
                end
                _G.table.insert(indexs, pbData.cards[i].location)
            end
            cinfo:AllCalCamp()
            self:CountUpdata(campinfo.campid)
            ---刷新主界面的 战力
            local windows = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.MainView.Name)
            if windows then
                windows.View:UpdatePower()
            end
            if callCamp then
                callCamp(cinfo)
            end
            _G.Events:GetInstance():Broadcast(_G.eCamp.PalyEffect, indexs)
        end
    )
end

