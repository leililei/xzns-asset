---获得卡牌，删除卡牌，改变卡牌数据
---@param add table 增加的卡牌
---@field uid number add的 key
---@field sid number add的 value
function CampsiteModel:AddorRemoveOrChange(add, rem, chang)
    if not self:CheckFunction() then
        return
    end
    if not _G.table.isEmptyOrNil(add) then
        self:AddCard(add)
    end
    if not _G.table.isEmptyOrNil(rem) then
        self:RemoveCard(rem)
    end
    if not _G.table.isEmptyOrNil(chang) then
        self:ChangeCard(chang)
    end
end
--获得卡牌 (默认检测 营地配置表，第一营地数据)
function CampsiteModel:AddCard(add)
    local flag = false
    local addCardElements = {}
    local campCfg = _G.ConfigManager.camp_cfg[101]
    for key, value in pairs(add) do
        local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, key)
        card:SetCampId(card.cfg.Elements + 100)
        if card.star >= campCfg.star_condition then
            flag = true
            table.insert(addCardElements, card.cfg.Elements)
        end
    end
    if flag then
        require("CampsiteNet"):GetInstance():AccessCampInfos(
            function(data)
                if data.ack ~= 1 then
                    return
                end
                self.camp = {}
                self:InitCamp(data.camp_info)
                for i = 1, #addCardElements do
                    self:RefredPointCampByElements(addCardElements[i])
                end
            end
        )
    else
        for _, value in pairs(self.camp) do
            value:AllCalCamp()
        end
    end
end
---删除卡牌
function CampsiteModel:RemoveCard(rem)
    local flag = false
    local addCardElements = {}
    for key, value in pairs(rem) do
        for k, v in pairs(self.camp) do
            local campData = v
            if not _G.table.isEmptyOrNil(campData.card_info) then
                for kc, vc in pairs(campData.card_info) do
                    if key == vc.uid then
                        flag = true
                        table.insert(addCardElements, vc.cfg.elements)
                        break
                    end
                end
            end
        end
    end
    if flag then
        require("CampsiteNet"):GetInstance():AccessCampInfos(
            function(data)
                if data.ack ~= 1 then
                    return
                end
                self.camp = {}
                self:InitCamp(data.camp_info)
                for i = 1, #addCardElements do
                    self:RefredPointCampByElements(addCardElements[i])
                end
            end
        )
    end
end
