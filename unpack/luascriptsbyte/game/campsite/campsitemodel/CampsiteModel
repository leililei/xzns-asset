---对外接口
function CampsiteModel:GetCampOneAttribute(campid, grade, star)
    local attrib = _G.AttributeClassManager:GetInstance():GetAttribtueClass()
    if campid == 0 then
        return attrib
    end
    --品質
    if grade <= 1 then
        return attrib
    end
    local cfg = _G.ConfigManager.camp_cfg[campid]
    if star < cfg.star_condition then
        return attrib
    end
    --檢測 星級 品值
    if not self:CheckFunction() then
        return attrib
    end
    if _G.table.isEmptyOrNil(self.camp) then
        return attrib
    end
    local allatt = self.camp[campid]:CalCampAttribute()
    attrib = self.camp[campid]:AddUpAttribute(allatt)
    return attrib
end
---6个阵营的平均效用星级，即取∑（上阵卡牌星级-配置放入条件星级+1）/6（四舍五入）
function CampsiteModel:GetCampAverageStar(campid)
    local star = 0
    local cfg = _G.ConfigManager.camp_cfg[campid]
    local data = self.camp[campid]
    if data then
        ---@type CardData[]
        local cards = data:GetAllCampCards()
        if not _G.table.isEmptyOrNil(cards) then
            for _, v in pairs(cards) do
                star = star + v.star - cfg.star_condition + 1
            end
        end
    end
    return _G.Mathf.RoundToInt(star / 6)
end

---初始化 营地
function CampsiteModel:InitCamp(CampAlldata)
    for i = 1, #CampAlldata do
        local data = CampData.New()
        data:Parse(CampAlldata[i])
        self.camp[CampAlldata[i].cid] = data
    end
    _G.table.sort(
        self.camp,
        function(a, b)
            return a.campid < b.campid
        end
    )
end
