    if data and data.card_info then
        count = table.count(data.card_info)
    end
    return count
end

function CampsiteModel:GetSumCount()
    local sumCount = 0

    if self.camp then
        ---@param  data CampData
        for key, data in pairs(self.camp) do
            if data and data.card_info then
                local count = table.count(data.card_info) or 0
                sumCount = sumCount + count
            end
        end
    end
    return sumCount
end

---单池更改
function CampsiteModel:CountUpdata(cid)
    local upCount = nil
    ---@type CampData
    local data = self:GetCampInfo(cid)
    if data and data.card_info then
        local count = table.count(data.card_info)

        if count > 0 then
            _G.Events:GetInstance():Broadcast(
                _G.ePlayAactionEvent.PlayAaction,
                {
                    _G.ActiveTaskEnum.ConditionEnum.Campsite.upCardCount,
                    cid
                },
                count,
                false,
                true
            )

            _G.Events:GetInstance():Broadcast(
                _G.ePlayAactionEvent.PlayAaction,
                {
                    _G.ActiveTaskEnum.ConditionEnum.Campsite.upCardCount,
                    ---全部
                    0
                },
                self:GetSumCount(),
                false,
                true
            )
        end
    end
end

