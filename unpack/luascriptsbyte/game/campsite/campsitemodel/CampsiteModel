function CampsiteModel:AutoDown(campinfo, callBack)
    if _G.table.isEmptyOrNil(campinfo.card_info) then
        _G.PopWindowManager:GetInstance():ShowAllTips(480103)
        return
    end
    local pbData = {
        type = 2,
        camp_id = 0
    }
    pbData.camp_id = campinfo.campid
    require("CampsiteNet"):GetInstance():AccessCampAutoUp(
        pbData,
        function(data)
            if data.ack ~= 1 then
                return
            end
            local count = _G.LangUtil.GetLangPackValue(90012300054)
            _G.FloatTipsModel:GetInstance():Show(count)
            ---清空
            local tem = {}
            local indexs = {}
            for key, value in pairs(campinfo.card_info) do
                if not _G.table.isEmptyOrNil(value) then
                    local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, value.uid)
                    card:SetCampPos(0)
                    _G.table.insert(indexs, value.location)
                end
            end
            campinfo.card_info = {}
            for i = 1, pos_num do
                if campinfo.kacaoinfo[i] == _G.CampPosEnum.unlock then
                else
                    campinfo.kacaoinfo[i] = _G.CampPosEnum.add
                end
            end
            --刷新红点
            for i = 1, pos_num do
                self:RefRedPoinCamp(campinfo.campid, i)
            end
            campinfo:AllCalCamp()
            _G.Events:GetInstance():Broadcast(_G.eCamp.PalyEffect, indexs)
            ---刷新主界面的 战力
            local windows = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.MainView.Name)
            if windows then
                windows.View:UpdatePower()
            end
            if callBack then
                callBack(campinfo)
            end
        end
    )
end
