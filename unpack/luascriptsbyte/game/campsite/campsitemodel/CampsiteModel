--region 对外接口 角色回退
---角色回退 下阵卡牌
---@param  i_card table
---@field  cid number 营地id
---@field  uid number 卡牌uid
---@field  location number 位置
function CampsiteModel:CardBakeCamp(card, call)
    if not self:CheckFunction() then
        return
    end
    local uid = card.uid
    --local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
    local campid = card:GetCampId()
    self.currentCampId = campid
    if campid == 0 then
        return
    end
    local star = card:GetStar()
    local cfg = _G.ConfigManager.camp_cfg

    if star < cfg[campid].star_condition then
        return
    end
    local camp = self:GetCampInfo(campid)
    local card_info = camp.card_info
    if _G.table.isEmptyOrNil(card_info) then
        return
    end
    local i_card = {}

    for key, value in pairs(card_info) do
        if not _G.table.isEmptyOrNil(value) then
            if value.uid == uid then
                i_card.uid = uid
                i_card.location = value.location
                i_card.cid = campid
                break
            end
        end
    end
    if _G.table.isEmptyOrNil(i_card) then
        return
    end
    local pbData = {
        type = _G.CampBehaviorEnum.popCard,
        be_info = {}
    }
    pbData.be_info = i_card
    require("CampsiteNet"):GetInstance():AccessCampBehavior(
        pbData,
        _G.handlerbind(self, self.PopCardCampidSuc, camp, card, i_card.location, call)
    )
end
function CampsiteModel:PopCardCampidSuc(data, campinfo, card, location, call)
    if data.ack ~= 1 then
        return
    end
    campinfo.kacaoinfo[location] = _G.CampPosEnum.add
    campinfo.card_info[location] = {}
    card:SetCampPos(0)
    --计算属性
    campinfo:AllCalCamp()
    --刷新红点
    --for i = 1, pos_num do
    --    self:RefRedPoinCamp(campinfo.campid, i)
    --end
    if call then
        call()
    end
end

---卡牌回退红点刷新
function CampsiteModel:RefRedPointForReset(card)
    local camp = self:GetCampInfo(card:GetCampId())
    for i = 1, pos_num do
        self:RefRedPoinCamp(camp.campid, i)
    end
end

---检测是否在营地
---@param card CardData
function CampsiteModel:CheckInCamp(card)
    if not self:CheckFunction() then
        return false
    end
    local uid = card.uid
    --local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
    local campid = card:GetCampId()
    if campid == 0 then
        return false
    end
    local star = card:GetStar()
    local cfg = _G.ConfigManager.camp_cfg

    if star < cfg[campid].star_condition then
        return false
    end
    local camp = self:GetCampInfo(campid)
    local card_info = camp.card_info
    if _G.table.isEmptyOrNil(card_info) then
        return
    end
    for key, value in pairs(card_info) do
        if not _G.table.isEmptyOrNil(value) then
            if value.uid == uid then
                return true
            end
        end
    end
    return false
end
---获取不同营地的星级
---@field table<number,number>  k=五行，v=星级
function CampsiteModel:GetAllStar()
    local tb = {}
    ---@type CampData[]
    local camp = self:GetAllCamp()
    for _, v in pairs(camp) do
        tb[v.cfg.elements] = v:GetAllCardStar()
    end
    return tb
end
return CampsiteModel
