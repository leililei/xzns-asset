--region 红点
function CampsiteModel:RefredPointAllCamp()
    local cfg = _G.ConfigManager.camp_cfg
    for _, value in pairs(cfg) do
        for i = 1, pos_num do
            self:RefRedPoinCamp(value.id, i)
        end
    end
end

function CampsiteModel:RefredPointCampByElements(elements)
    local cfg = _G.ConfigManager.camp_cfg
    for _, value in pairs(cfg) do
        if value.elements == elements then
            for i = 1, pos_num do
                self:RefRedPoinCamp(value.id, i)
            end
            break
        end
    end
end

function CampsiteModel:RefRedPoinCamp(campid, pos_index)
    require("RedPointManager"):GetInstance():RefreshNode(
        _G.ConfigManager.redpoint_cfg.Caedcamproom.id,
        campid * 10 + pos_index
    )
    --require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.Cardcampelements.id)
end
---获取营地红点数量
---@param param number 营地id + 营地得槽位(6)
function CampsiteModel:GerRedpointCampNum(param)
    local campid = _G.GameUtil.GetDivisionNumber(param,10)
    local index = math.fmod(param, 10)
    ---@type CampData
    local camp = self:GetCampInfo(campid)
    if _G.table.isEmptyOrNil(camp) then
        return 0
    end
    local card = camp:GetAllCampCardsToRed()
    if _G.table.isEmptyOrNil(card) then
        return 0
    end
    if camp:GetCaoweiState(index) == _G.CampPosEnum.unlock then
        return 0
    elseif camp:GetCaoweiState(index) == _G.CampPosEnum.cardsid then
        local temp = 0
        local card_info = camp:GetCardCampTOUid(index)
        temp = camp:CheckRedPointCamp(card_info.uid)
        return temp
    elseif camp:GetCaoweiState(index) == _G.CampPosEnum.add then
        local allcards1 = camp:GetCampRenCardsToRed() or {}
        if _G.table.isEmptyOrNil(allcards1) then
            return 0
        end
        local allcards = {}
        for k, va in pairs(allcards1) do
            allcards[k] = va[1]
        end
        local card_lists = {}
        for key, value in pairs(allcards) do
            if value:GetCampPos() == 0 then
                _G.table.insert(card_lists, value)
            end
        end
        if _G.table.isEmptyOrNil(card_lists) then
            return 0
        end
        if _G.table.isEmptyOrNil(camp.card_info) then
            return 1
        end
        local card = card_lists[1]
        for key, value in pairs(camp.card_info) do
            if not _G.table.isEmptyOrNil(value) then
                local tempcard = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, value.uid)
                if tempcard.sid == card.sid then
                    return 0
                end
            end
        end
    end
    return 1
end
