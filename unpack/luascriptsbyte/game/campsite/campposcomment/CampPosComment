---@class CampPosComment : Component	中文描述
local CampPosComment = _G.BaseClass("CampPosComment", _G.Component)

local CS = _G.CS
local typeof = _G.typeof

---创建对象时,入口构造函数
function CampPosComment:OnCreate(trans, campinfo, posIndex, call)
    self.gameObject = trans.gameObject
    self.transform = trans
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    self.cardData = {}
    self.campinfo = campinfo
    self.pos_state = 0
    self.pos_index = posIndex
    self:ShowCaoWeiInfo()
    self:Showdes(posIndex, campinfo, call)
    self.go_table.aorbtn_addBtn.onClick:RemoveAllListeners()
    self.go_table.aorbtn_addBtn.onClick:AddListener(_G.handlerbind(self, self.PosOnclick, self.pos_index, campinfo))
    self.go_table.aorbtn_unlock.onClick:RemoveAllListeners()
    self.go_table.aorbtn_unlock.onClick:AddListener(
        _G.handlerbind(self, self.PosUnLockOnclick, self.pos_index, campinfo)
    )
end

--region 展示界面
---展示槽位信息
function CampPosComment:ShowCaoWeiInfo()
    _G.ItemCardFactory:GetInstance():GetItemCard(
        _G.ItemCardFactory.itemCardType.CardAllItem,
        self.go_table.trans_item,
        _G.handler(self, self.ShowCardInfo)
    )
end
---设置 槽位的卡牌
function CampPosComment:SetCardData()
    self.cardData = {}
    if _G.table.isEmptyOrNil(self.campinfo.card_info) or _G.table.isEmptyOrNil(self.campinfo.card_info[self.pos_index]) then
        return
    end
    local uid = self.campinfo.card_info[self.pos_index].uid
    local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
    self.cardData = card
end
---设置槽位的 状态
function CampPosComment:SetPosState()
    self.pos_state = self.campinfo:GetCaoweiState(self.pos_index)
end
function CampPosComment:ShowArr(posindex)
    local att = self.campinfo:CalCampCaoWeiArrtibute(posindex)
    if not _G.table.isEmptyOrNil(att) then
        self.go_table.aortext_attribute.text =
            _G.LangUtil.GetLangPackValue(90020300006) .. "<color=#14874a>+" .. att["atk"] .. "%</color>"
    else
        self.go_table.aortext_attribute.text = ""
    end
end
function CampPosComment:Show()
    if self.pos_state == _G.CampPosEnum.add then
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_addpanle, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_unlockPanel, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_item, false)
    elseif self.pos_state == _G.CampPosEnum.unlock then
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_addpanle, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_unlockPanel, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_item, false)
        self:UnlockState()
    elseif self.pos_state == _G.CampPosEnum.cardsid then
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_addpanle, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_unlockPanel, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_item, true)
    end
end
function CampPosComment:Showdes(posIndex, campinfo, Call)
    self.pos_index = posIndex
    self.callBack = Call
    self.campinfo = campinfo
    self:SetPosState()
    self:Show()
    self:ShowArr(posIndex)
    self:SetCardData()
    if self.item and not _G.table.isEmptyOrNil(self.cardData) then
        self.item.gameObject:SetLocalScaleXYZ(1)
        self.item:ShowCardData(self.cardData, _G.handler(self, self.PosOnclick), true, true)
    end
    --红点 设置参数
    self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(
        _G.ConfigManager.redpoint_cfg.Caedcamproom.id,
        campinfo.campid * 10 + posIndex
    )
end
---未解锁
function CampPosComment:UnlockState()
    local limitlevel = self.campinfo.cfg.limit_condition
    local unlock_conditon = limitlevel[self.pos_index]
    local tip = unlock_conditon[2] --_G.LangUtil.GetLangPackValue(90012300037, lv)
    local cfg = _G.ConfigManager.afk_cfg
    local num = cfg[tip].chapter
    local num1 = cfg[tip].section
    self.go_table.aortext_unlock.text = _G.LangUtil.GetLangPackValue(90025100003, num, num1)
end
---
function CampPosComment:ShowCardInfo(item)
    self.item = item
    if _G.table.isEmptyOrNil(self.cardData) then
        return
    end
    item:ShowCardData(self.cardData, _G.handler(self, self.PosOnclick), true, true)
end
--endregion
--region 点击
function CampPosComment:PosOnclick()
    local data = {
        flag = false,
        click_ind = self.pos_index,
        camp_info = self.campinfo
    }

    if self.campinfo.kacaoinfo[self.pos_index] == _G.CampPosEnum.add then
        data.flag = true
    end
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.CampCardSelect.Name,
        data,
        _G.handler(self, self.CallBackSelectView)
    )
end
function CampPosComment:PosUnLockOnclick()
    if self.pos_state == _G.CampPosEnum.unlock then
        _G.PopWindowManager:GetInstance():ShowAllTips(480107)
        return
    end
end
function CampPosComment:CallBackSelectView(campinfo)
    if self.callBack then
        self.callBack(campinfo)
    end
end
--endregion
---销毁对象时,析构函数
function CampPosComment:OnDestroy()
end
return CampPosComment
