---@class CampComponent : Component	中文描述
---@field cfg card_cfg
local CampComponent = _G.BaseClass("CampComponent", _G.Component)

---创建对象时,入口构造函数
function CampComponent:OnCreate(trans, data)
    self.cfg = _G.ConfigManager.card_cfg
    self.gameObject = trans.gameObject
    self.transform = trans
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    self.cardData = data.c_value or nil
    self:ShowCardAll()
    self:Show(data)
end
function CampComponent:ShowItemHeadInfo(item)
    self.item = item
    if _G.table.isEmptyOrNil(self.cardData) then
        return
    end
    item:ShowCardData(self.cardData, nil)
end
function CampComponent:ShowCardAll()
    _G.ItemCardFactory:GetInstance():GetItemCard(
        _G.ItemCardFactory.itemCardType.CardAllItem,
        self.go_table.trans_node,
        _G.handler(self, self.ShowItemHeadInfo)
    )
end

function CampComponent:Show(data)
    if _G.table.isEmptyOrNil(data.c_value) then
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_node, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_menghui, true)
        local icon = self.cfg[data.sid].Icon
        if _G.string.contains(icon, "/") then
            icon = _G.string.split2tbl(icon, "/")
            icon = icon[#icon]
        end
        self.go_table.aorimage_icon.SpriteName = icon
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_node, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_menghui, false)
    end
end
function CampComponent:ShowDes(card)
    self.cardData = card.c_value or {}
    if not _G.table.isEmptyOrNil(self.cardData) then
        if self.item then
            self.item:ShowCardData(self.cardData, nil)
        end
    end
    self:Show(card)
end
---销毁对象时,析构函数
function CampComponent:OnDestroy()
end
return CampComponent
