---@class camp_card_body_select : Component	中文描述
local camp_card_body_select = _G.BaseClass("camp_card_body_select", _G.Component)

local CS = _G.CS
local typeof = _G.typeof

---创建对象时,入口构造函数
function camp_card_body_select:OnCreate(obj, callBack)
    self.gameObject = obj.gameObject
    self.transform = obj.gameObject
    self.callBack = callBack
    self.Item = {}
    self.go_table = _G.GetAutoGoTable(obj)
    self:Spawn()
end
function camp_card_body_select:Spawn(itemindex, uid)
    _G.ItemCardFactory:GetInstance():GetItemCard(
        _G.ItemCardFactory.itemCardType.BodyItem_select,
        self.go_table.obj_node,
        function(item)
            self.Item = item
            --self:ShowCardData(item, self.cardData, self.callBack, itemindex, uid)
            if self.callBack then
                self.callBack()
            end
        end
    )
end
function camp_card_body_select:ShowCardData(item, cardData, callBack, showSoulTalent, itemindex, uid)
    item:ShowCardData(cardData, callBack, showSoulTalent, itemindex, uid)
end
---销毁对象时,析构函数
function camp_card_body_select:OnDestroy()
end
return camp_card_body_select
