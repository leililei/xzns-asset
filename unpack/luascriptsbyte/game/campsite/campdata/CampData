---等级检测 释放 可以开启 槽位
function CampData:UpCaoWei()
    if (self.unlock + 1) > 6 then
        return
    end
    --local playerLevel = _G.PlayerModel:GetInstance():GetLevel()
    local limitlevel = self.cfg.limit_condition
    --local lv = limitlevel[self.unlock + 1][2]
    local flag =
        _G.GlobalConditionManager.CheckCondition(limitlevel[self.unlock + 1][1], limitlevel[self.unlock + 1][2])
    if flag then
        self.unlock = self.unlock + 1
        self:SetKaCaoInfo(self.unlock, _G.CampPosEnum.add)
        require("CampsiteModel"):GetInstance():RefRedPoinCamp(self.campid, self.unlock)
    end
end

function CampData:GetAllCampCardsToRed()
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    local cardsids
    cardsids = self:CheckCampConditionToRed(self.campid, cards)
    return cardsids
end

function CampData:GetCampRenCardsToRed()
    local allcard_sids = {}
    local allCards = self:GetAllCampCardsToRed()
    if _G.table.isEmptyOrNil(allCards) then
        return {}
    end
    allcard_sids = self:CheckSameSid(allCards)
    return allcard_sids
end

function CampData:CheckCampConditionToRed(campid, cards)
    local table = _G.table
    local cid = math.fmod(campid, 100)
    if table.isEmptyOrNil(cards) then
        return {}
    end
    local liveLimit = self.cfg.star_condition
    local temp = {}
    for _, value in pairs(cards) do
        if require "CardInfoManager":GetInstance():CheckMultiMatchCOP(value.cfg.Elements_new, cid) and value.star >= liveLimit and value.cfg.Order > 1 then
            _G.table.insert(temp, value)
        end
    end
    if _G.table.isEmptyOrNil(temp) then
        return {}
    end
    return temp
end

