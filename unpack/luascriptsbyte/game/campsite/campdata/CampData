    for key, value in pairs(att) do
        local num = value * 0.01
        attrib:AddValueByName(key, num, false, _G.AttCountType.basePercent)
    end
    return attrib
end

---属性 营地槽位 单个属性计算ss
function CampData:CalCampCaoWeiArrtibute(index)
    if _G.table.isEmptyOrNil(self.card_info[index]) then
        return {}
    end
    local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, self.card_info[index].uid)
    local attribute = self.cfg.attribute
    --检测星级
    local star = 0
    if card.star >= self.cfg.star_condition then
        star = card.star - self.cfg.star_condition + 1
    end
    local att = {}
    for key, value in pairs(attribute) do
        local type = _G.tonumber(value[2])
        local v = _G.tonumber(value[3])
        if type == 2 then
            v = star * v * 0.0001 * 100
        end
        att[value[1]] = v
    end
    return att
end
