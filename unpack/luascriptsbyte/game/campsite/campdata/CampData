---@param campid number 五行id
function CampData:CheckCampCondition(campid, cards)
    local cardsids = {}
    local table = _G.table
    local cid = math.fmod(campid, 100)
    if table.isEmptyOrNil(cards) then
        return {}
    end
    local liveLimit = self.cfg.star_condition
    local temp = {}
    for _, value in pairs(cards) do
        if require "CardInfoManager":GetInstance():CheckMultiMatchCOP(value.cfg.Elements_new, cid) and value.star >= liveLimit and value.cfg.Order > 1 then
            _G.table.insert(temp, value)
        end
    end
    if _G.table.isEmptyOrNil(temp) then
        return {}
    end
    local temp2 = self:SortCardSid(temp)
    return temp2
end
--排序 sid --》 战力 --》uid
---排序：星级-》品质-》战力-》uid
function CampData:SortCardSid(cards)
    local cardslist = {}
    _G.table.sort(
        cards,
        function(a, b)
            if a.cfg.Order < b.cfg.Order then
                return true
            elseif a.cfg.Order == b.cfg.Order and a:GetPower() < b:GetPower() then
                return true
            elseif a.sid == b.sid and a.cfg.Order == b.cfg.Order and a:GetPower() == b:GetPower() and a.uid < b.uid then
                return true
            else
                return false
            end
        end
    )
    cardslist = cards
    return cardslist
end
function CampData:CheckSameSid(cfg)
    local temp3 = {}
    local table = _G.table
    if not _G.table.isEmptyOrNil(cfg) then
        for key, value in ipairs(cfg) do
            if value.cfg.UnitType == 1 or value.cfg.UnitType == 2 then
                if _G.table.isEmptyOrNil(temp3[value.sid]) then
                    temp3[value.sid] = {}
                end
                _G.table.insert(temp3[value.sid], value)
            end
        end
    end
    if not _G.table.isEmptyOrNil(temp3) then
        for key, value in pairs(temp3) do
            _G.table.sort(
                value,
                function(a, b)
                    if a:GetCampPos() > b:GetCampPos() then
                        return true
                    elseif a:GetCampPos() == b:GetCampPos() and a.star > b.star then
                        return true
                    end
                    return false
                end
            )
        end
    end
    return temp3
end
---检测的位置 是空
function CampData:CheckposnilAuto(key)
    local cards = self:GetCampRenCards() or {}
    local temp = {}
    if _G.table.isEmptyOrNil(cards) then
        return temp
    end
    local te = {}
    local starLimit = self.cfg.star_condition
    for key, value in pairs(cards) do
        if value[1]:GetCampPos() == 0 and value[1].star >= starLimit then
            _G.table.insert(te, value[1])
        end
    end
    if _G.table.isEmptyOrNil(te) then
        return temp
    end
    _G.table.sort(
        te,
        function(a, b)
            if a.star > b.star then
                return true
            elseif a.star == b.star and a.cfg.Order > b.cfg.Order then
                return true
            elseif a.star == b.star and a.cfg.Order == b.cfg.Order and a:GetPower() > b:GetPower() then
                return true
            end
            return false
        end
    )
    temp = te[1]
    temp:SetCampPos(key)
    return temp
end
---同sid不同 uid检测 星级、品质 一键上阵检测
function CampData:CheckSidAndUid(uid, location)
    local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
    local cards = self:GetCampRenCards() or {}
    local temp = {}
    if _G.table.isEmptyOrNil(cards) then
        return temp
    end
    local temp_tb_card = {}
    --先检测同sid的 卡有没有 相同的卡牌
    local sid_list = cards[card.sid]
    for i = 1, #sid_list do
        if sid_list[i].star > card.star then
            _G.table.insert(temp_tb_card, sid_list[i])
        end
    end
    --在检测 其他sid 卡 ，没有上阵的卡牌
    local starLimit = self.cfg.star_condition
    for key, value in pairs(cards) do
        if key ~= card.sid and value[1]:GetCampPos() == 0 and value[1].star >= starLimit and value[1].star > card.star then
            _G.table.insert(temp_tb_card, value[1])
        end
    end
    if _G.table.isEmptyOrNil(temp_tb_card) then
        return temp
    end
    _G.table.sort(
        temp_tb_card,
        function(a, b)
            if a.star > b.star then
                return true
            elseif a.star == b.star and a.cfg.Order > b.cfg.Order then
                return true
            elseif a.star == b.star and a.cfg.Order == b.cfg.Order and a:GetPower() > b:GetPower() then
                return true
            end
            return false
        end
    )
    temp = temp_tb_card[1]
    temp:SetCampPos(location)
    --card:SetCampPos(0)
    return temp
end
---红点检测 有卡牌 刷新红点
function CampData:CheckRedPointCamp(uid)
    local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
    local cards = self:GetCampRenCardsToRed() or {}
    if _G.table.isEmptyOrNil(cards) then
        return 0
    end
    local starLimit = self.cfg.star_condition
    for key, value in pairs(cards) do
        if
            value[1]:GetCampPos() == 0 and value[1].uid ~= card.uid and value[1].star >= starLimit and
                value[1].star > card.star
         then
            return 1
        end
    end
    return 0
end
---属性加成 营地总属性计算UI 界面显示
function CampData:CalCampAttribute()
    local att = {}
    local attribtue = self.cfg.attribute
    for key, value in pairs(attribtue) do
        att[value[1]] = 0
    end
    for key, valeu in pairs(self.card_info) do
        if not _G.table.isEmptyOrNil(valeu) then
            local temp = self:CalCampCaoWeiArrtibute(valeu.location)
            for k, v in pairs(temp) do
                att[k] = att[k] + v
            end
        end
    end
    return att
end
