function CampData:GetAllCardStar()
    local num = 0
    if self.card_info then
        for _, v in pairs(self.card_info) do
            ---@type CardData
            local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, v.uid)
            if card then
                num = num + card:GetStar()
            end
        end
    end

    return num
end

