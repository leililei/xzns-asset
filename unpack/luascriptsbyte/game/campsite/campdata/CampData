---营地的 数据类
---@param data table 营地数据类
---@field cid number 营地的 id
---@field unlock number 当前营地解锁的数量
---@field cards table 当前营地中的 卡牌
---@field location number 卡牌在当前营地的位置
---(1,2,3,4,5,6) {1,2} {3,4} {5,6} 1,3,5,为人，2，4，6，为灵
function CampData:ParseInitMsg(data)
    local campcfg = _G.ConfigManager.camp_cfg
    self.cfg = campcfg[data.cid]
    self.unlock = data.unlock
    self.campid = data.cid
    self.cards = data.cards or {}
    self:SetCampCaoweiCard()
    ---营地槽位 状态
    self:SetCaoWeiInfo()
    --设置 卡牌所有的 营地id
    self:InitCampidofCard()
end

function CampData:InitCampidofCard()
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    local cid = math.fmod(self.campid, 100)
    if _G.table.isEmptyOrNil(cards) then
        return {}
    end
    for _, value in pairs(cards) do
        if require "CardInfoManager":GetInstance():CheckMultiMatchCOP(value.cfg.Elements_new,cid) then
            value:SetCampId(self.campid)
        end
    end
end

--region 设置
---根据营地中槽位卡牌信息
function CampData:SetCampCaoweiCard()
    self.card_info = {}
    if _G.table.isEmptyOrNil(self.cards) then
        return
    end
    for key, value in pairs(self.cards) do
        local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, value.uid)
        self.card_info[value.location] = value
        card:SetCampPos(value.location)
    end
end
---根据uid 获得 所在营地的位置
function CampData:GetUidCamppos(uid)
    for i = 1, #self.card_info do
        if self.card_info[i].uid == uid then
            return self.card_info[i].location
        end
    end
    return 0
end
---根据下标获得相应的 卡牌位置，和信息
function CampData:GetCardCampTOUid(index)
    return self.card_info[index]
end
---槽位的信息
function CampData:SetCaoWeiInfo()
    self.kacaoinfo = {
        [1] = _G.CampPosEnum.unlock,
        [2] = _G.CampPosEnum.unlock,
        [3] = _G.CampPosEnum.unlock,
        [4] = _G.CampPosEnum.unlock,
        [5] = _G.CampPosEnum.unlock,
        [6] = _G.CampPosEnum.unlock
    }
    for i = 1, #self.kacaoinfo do
        if i <= self.unlock then
            if _G.table.isEmptyOrNil(self.card_info[i]) or self.card_info[i] == nil then
                self:SetKaCaoInfo(i, _G.CampPosEnum.add)
            else
                self:SetKaCaoInfo(i, _G.CampPosEnum.cardsid)
            end
        else
            self:SetKaCaoInfo(i, _G.CampPosEnum.unlock)
        end
    end
end
---根据位置下标 获得 槽位状态
function CampData:GetCaoweiState(posindex)
    return self.kacaoinfo[posindex]
end
