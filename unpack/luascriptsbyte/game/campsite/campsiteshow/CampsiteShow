local CampPosCompoent = require("CampPosComment")
local CampsiteModel = require("CampsiteModel"):GetInstance()
---@class CampsiteShow : UIBaseView	魂修阁
---@field public go_table CampsiteShow_GoTable GoTable
---@field cfg card_cfg
local CampsiteShow = _G.BaseClass("CampsiteShow", _G.UIBaseView)
--_G.CampsiteShow = CampsiteShow
local item = "UIH5/Common/ItemView/ItemCardBodySelectView"
local itemCard = "UI/Campsite/$_obj_ListItemcard"

local effect = {
    [101] = "ef_wulingbaozhu_fankui_lei",
    [102] = "ef_wulingbaozhu_fankui_feng",
    [103] = "ef_wulingbaozhu_fankui_shui",
    [104] = "ef_wulingbaozhu_fankui_huo",
    [105] = "ef_wulingbaozhu_fankui_tu",
    [106] = "ef_wulingbaozhu_fankui_shen",
    [107] = "ef_wulingbaozhu_fankui_kuang" --框的 特效
}

function CampsiteShow:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.model = require("CampsiteModel"):GetInstance()
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_close"] = self.CloseView,
        ["@_aorbtn_closeview"] = self.CloseView,
        ["@_aorbtn_autoDown"] = self.OnClickAutoDown,
        ["@_aorbtn_autoUp"] = self.AutoUpOnClick,
        ["@_aorbtn_left"] = self.LeftBtnOnClick,
        ["@_aorbtn_right"] = self.RightBtnOnClick,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    self.cfg = _G.ConfigManager.card_cfg
    self.grid_effect = {}
    for i = 1, 6 do
        if _G.table.isEmptyOrNil(self.grid_effect[i]) then
            self.grid_effect[i] = {}
        end
        self.grid_effect[i] = self.go_table.trans_pos:GetChildE(i - 1)
    end
    ---播放特效事件
    _G.Events:GetInstance():AddListener(_G.eCamp.PalyEffect, self.paleyUIeffectKuang, self)
end

---界面的入口函数
function CampsiteShow:OnCreate(data, call)
    self.callBack = call
    self.currentCamp = data or {}
    self.type = data.campid or 101
    self.currentSid = self.currentCamp.campid
    self.currentpower = self.currentCamp:GetCampStorageCardsPower()
    self:UpDateAll()
end
function CampsiteShow:OnDestroy()
    ---播放特效事件
    _G.Events:GetInstance():RemoveListener(_G.eCamp.PalyEffect, self.paleyUIeffectKuang, self)
end
--region 初始化
--endregion
--region 更新
function CampsiteShow:UpDateAll()
    self:UpdateCampName()
    self:UpdateCampDesc()
    self:UpdateCampIcon()
    self:UpdateCampAtt()
    --self:UpdateBaGuaIcon()
    self:UpdateCampPos()
end
---更新属性展示
function CampsiteShow:UpdateCampAtt()
    local allatt = self.currentCamp:CalCampAttribute()
    self.go_table.aortext_att_1.text = "+" .. allatt["atk"] .. "%"
    self.go_table.aortext_att_2.text = "+" .. allatt["max_hp"] .. "%"
    self.go_table.aortext_att_3.text = "+" .. allatt["def"] .. "%"
    self.go_table.aortext_att_4.text = "+" .. allatt["bre"] .. "%"
end
function CampsiteShow:UpdateBaGuaIcon()
    local node = self.go_table.obj_baguaNode
    for i = 1, node:GetChildCountE() do
        self:SetBaGuaIcon(i)
    end
end
function CampsiteShow:SetBaGuaIcon(duishu)
    local node = self.go_table.obj_baguaNode
    local isShow = self.currentCamp:CheckBagua(duishu)
    _G.GameUtil.SetActiveByCondition(node:GetChildE(duishu - 1), isShow)
end
---戰力顯示
function CampsiteShow:UpdatePower()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_PowerNode, true)
    if self.waitPlayAni == nil then
        self.waitPlayAni = _G.coroutine.start(_G.handler(self, self.CoOnProgressTower))
    end
end
function CampsiteShow:NumToStr(num)
    --- 道具数量显示
    ---数量超过5位时，后三位数字四舍五入省略为K，比如56845既省略为57K
    ---数量超过8位时，后六位数字四舍五入省略为M，比如568452456省略为56M
    ---移除四舍五入
    -- if num >= 100000000 then
    --     local Floor = _G.Mathf.Floor
    --     num = Floor(num / 100000)
    --     num = num / 10
    --     num = math.ceil(num) --GameUtil.FormatNum(num)
    --     return num .. "m"
    -- elseif num >= 100000 then
    --     local Floor = _G.Mathf.Floor
    --     num = Floor(num / 1000)
    --     num = num / 100
    --     num = math.ceil(num) --GameUtil.FormatNum(num)
    --     return num .. "w"
    -- end
    local tStr = ""
    local tNum = _G.math.floor(tonumber(num))
    if tNum ~= nil then
        tStr = tostring(tNum)

        local len = string.len(tStr)

        if len >= 7 then
            --X.Y亿
            tStr = string.sub(tStr, 1, len - 6)
            tStr = (tonumber(tStr)) .. "m"
        elseif len >= 5 then
            tStr = string.sub(tStr, 1, len - 3)
            tStr = (tonumber(tStr)) .. "k"
        end
    end
    return tStr
end
function CampsiteShow:CoOnProgressTower()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_PowerNode, true)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_mask, true)
    self.go_table.aortext_nor_power.text = self:NumToStr(self.currentpower)
    local power = self.currentCamp:GetCampStorageCardsPower()
    if power < self.currentpower then
        _G.GameUtil.SetActiveByCondition(self.go_table.aortext_nor_powerdown, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.aortext_nor_powerup, false)
        self.go_table.aortext_nor_powerdown.text = "-" .. self:NumToStr(self.currentpower - power)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.aortext_nor_powerdown, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aortext_nor_powerup, true)
        self.go_table.aortext_nor_powerup.text = "+" .. self:NumToStr(power - self.currentpower)
        _G.AudioManager.PlayAudioByAudioCfgID(2032)
    end
    _G.coroutine.waitforseconds(0.8)
    self.currentpower = self.currentCamp:GetCampStorageCardsPower()
    _G.coroutine.waitforseconds(0.2)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_PowerNode, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.aortext_nor_powerdown, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.aortext_nor_powerup, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_mask, false)
    if self.waitPlayAni ~= nil then
        _G.coroutine.stopwaiting(self.waitPlayAni)
        self.waitPlayAni = nil
    end
end

---更新营地名字
function CampsiteShow:UpdateCampName()
    self.go_table.aortext_titleName.text = _G.LangUtil.GetLangPackValue(self.currentCamp.cfg.name)
end

---更新展示信息
function CampsiteShow:UpdateCampDesc()
    self.go_table.aortext_dec.text = _G.LangUtil.GetLangPackValue(self.currentCamp.cfg.desc)
end
---更新图标
function CampsiteShow:UpdateCampIcon()
    local icon = self.currentCamp.cfg.icon
    self.go_table.aorimage_campIcon.SpriteName = icon
    self.go_table.aorimage_campIcon_right.SpriteName = icon
end
---更新营地中 槽位信息
function CampsiteShow:UpdateCampPos()
    local campsid = self.currentCamp.campid
    local tranObj = self.go_table.trans_pos
    for i = 1, 6 do
        local tb = _G.GetAutoGoTable(tranObj:GetChildE(i - 1))
        local tb_i = self:GetComponent(tb.gameObject, CampPosCompoent)
        if tb_i == nil then
            self:AddComponent(
                tb.gameObject,
                CampPosCompoent.New(tb, self.currentCamp, i, _G.handler(self, self.UpdateBack))
            )
        else
            tb_i:Showdes(i, self.currentCamp, _G.handler(self, self.UpdateBack))
        end
    end
end
--endregion

--region 点击
---按钮点击事件在这里派发
function CampsiteShow:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
    --_G.AudioManager.PlayAudioByAudioCfgID(2049)
end
function CampsiteShow:CloseView()
    if self.waitPlayAni ~= nil then
        _G.coroutine.stopwaiting(self.waitPlayAni)
        self.waitPlayAni = nil
    end
    self:Close()
end
---一键卸载 营地中所有卡牌
function CampsiteShow:OnClickAutoDown()
    self.model:AutoDown(
        self.currentCamp,
        function(campinfo)
            self:paleyUIeffect()
            self.currentCamp = campinfo
            self:UpdateBack(2)
        end
    )
end
---界面刷新
function CampsiteShow:UpdateBack(data)
    self:UpdateCampAtt()
    self:UpdateCampPos()
    --self:UpdateBaGuaIcon()
    self:UpdatePower()
    if self.callBack then
        self.callBack()
    end
end
--endregion

--region 服务器相关操作
function CampsiteShow:AutoUpOnClick()
    self.model:AutoUp(
        self.currentCamp,
        function(campinfo)
            self:paleyUIeffect()
            self.currentCamp = campinfo
            self:UpdateBack(1)
        end
    )
end
--endregion

--region 特效
function CampsiteShow:paleyUIeffect()
    local eff = effect[self.type]
    local cfg = _G.ConfigManager.ui_effect_cfg[eff]
    _G.UIUtils.LoadEffectByCfg(cfg, self.go_table.obj_Effect, nil, nil)
end
---@param indexs table 框的下标节点
function CampsiteShow:paleyUIeffectKuang(indexs)
    if _G.table.isEmptyOrNil(indexs) then
        return
    end
    self:paleyUIeffect()
    local eff = effect[107]
    local cfg = _G.ConfigManager.ui_effect_cfg[eff]
    for i = 1, #indexs do
        local v = indexs[i]
        _G.UIUtils.LoadEffectByCfg(cfg, self.grid_effect[v], nil, nil)
    end
end
--endregion
return CampsiteShow
