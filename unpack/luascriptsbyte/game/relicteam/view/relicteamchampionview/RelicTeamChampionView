local RelicTeamModel = require "RelicTeamModel"

---@class RelicTeamChampionView : UIBaseView	中文描述
local RelicTeamChampionView = _G.BaseClass("RelicTeamChampionView", _G.UIBaseView)

function RelicTeamChampionView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function RelicTeamChampionView:OnCreate(curRankData)
    self.curRankData = curRankData
    self.Time = RelicTeamModel:GetInstance().EggEndTime and
        RelicTeamModel:GetInstance().EggEndTime - _G.TimeUtil.GetServerUnixTime() or 0

    self.Timer = _G.TimerManager:GetInstance():GetTimer(1, self.OnTimeRemaining, self, false)
    self.Timer:Start()

    self:InitEffct()
    self:InitView()
    self:UpdateIcon()
end

function RelicTeamChampionView:UpdateIcon()
    local icon
    if not RelicTeamModel:GetInstance().EggAwardFlag then
        icon = "ImagesH5/nAFK/ui_box1"
        self.go_table.obj_redpoint:SetActiveE(1)
    else
        icon = "ImagesH5/nAFK/ui_box3"
        self.go_table.obj_redpoint:SetActiveE(0)
    end
    self.go_table.aorrawimage_box:LoadImage(icon)
end

function RelicTeamChampionView:OnTimeRemaining(elapsed)
    self.Time = self.Time - elapsed
    if self.Time > 0 then
        local t = _G.TimeUtil.TranslateSecond(self.Time)
        self.go_table.aortext_time.text = _G.GetLangPackValue(90033500133, t.day, t.hour, t.min)
    else
        self:Close()
    end
end

function RelicTeamChampionView:InitEffct()
    local tbOur = _G.GetAutoGoTable(self.go_table.obj_fameHallOur)

    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_SociatyMobaGuessView_our,
        tbOur.obj_ourEff,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
        end
    )
end

function RelicTeamChampionView:InitView()
    self:InitFameHall()
end

---名人堂
---@param msg guild.s2c_other_guild_pos_info
function RelicTeamChampionView:InitFameHall()
    ---@type RelicTeamChampionView._obj_fameHallOur_GoTable|RelicTeamChampionView._obj_fameHallEnemy_GoTable
    local tb = _G.GetAutoGoTable(self.go_table.obj_fameHallOur)
    local cfg = _G.ConfigManager.player_portrait_cfg
    local icon = "ImagesH5/zRoles/" ..  cfg[self.curRankData.listRankDatas[1].playData.portrait].portrait1
    tb.aortext_sociatyName.text = self.curRankData.listRankDatas[1].playData.name
    self.go_table.aortext_tips.text = _G.GetLangPackValue(90033406003, self.curRankData.listRankDatas[1].playData.name)
    tb.aorrawimage_icon:LoadImage(icon)
    self:CreateRole(tb.obj_player1, self.curRankData.listRankDatas[1])
    self:CreateRole(tb.obj_player2, self.curRankData.listRankDatas[2])
    self:CreateRole(tb.obj_player3, self.curRankData.listRankDatas[3])
    self:CreateRole(tb.obj_player4, self.curRankData.listRankDatas[4])
    self:CreateRole(tb.obj_player5, self.curRankData.listRankDatas[5])
end

function RelicTeamChampionView:CreateRole(obj, role)
    if role then
        ---@type _obj_fameHallOur._obj_player1_GoTable
        local playerTb = _G.GetAutoGoTable(obj)
        playerTb.aortext_name.text = role.playData.name
        playerTb.aortext_power.text = _G.GameUtil.NumberToUnitWord(role.playData.power)
        -- playerTb.aorimage_official.SpriteName = officialBg[pos]
        -- playerTb.aortext_offName.text = _G.GetLangPackValue(_G.ConfigManager.guild_position_cfg[pos].name)
        -- playerTb.aortext_offName.color = officialColor[pos]
        -- playerTb.aortext_offName:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = officialOutlineColor[1]
        local cfg = require("CardInfoManager").GetCardSkin_ShowCfg(nil, role.playData.city_style_id)
        local path = cfg.ModelPathHi
        local scale = cfg.size2
        if _G.UIUtils.IsUseBattleSpine(_G.UseBattleSpine.RankView) then
            path = _G.UIUtils.GetBattleSpine(cfg)
            scale = cfg.size2
        end
        _G.PoolsManager:GetInstance():Spawn(
            path,
            _G.ePoolType.Temporary,
            playerTb.obj_spine,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                end
                trans:SetLocalScaleXYZ(scale)
                if not table.isEmptyOrNil(role.playData.artifact_skin) then
                    _G.UIUtils.LoadArtifacteffect(trans,nil,role.playData.artifact_skin[1],role.playData.artifact_skin[2])
                end
            end
        )
    else
        obj:SetActiveE(0)
    end
end

---按钮点击事件在这里派发
function RelicTeamChampionView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_AwardBox then
        ---点击领取宝箱
        if not RelicTeamModel:GetInstance().EggAwardFlag then
            RelicTeamModel:GetInstance():GetEggAward(function()
                self:UpdateIcon()
            end)
        end
    end
end

function RelicTeamChampionView:OnStartClose()
    if self.Timer then
        self.Timer:Stop()
        self.Timer = nil
    end
end

function RelicTeamChampionView:Dispose()
end

return RelicTeamChampionView
