---@class RelicTeamChooseCampView : UIBaseView    中文描述
---@field public go_table RelicTeamChooseCampView_GoTable GoTable
local RelicTeamChooseCampView = _G.BaseClass("RelicTeamChooseCampView", _G.UIBaseView)
local RelicTeamModel

local headScale = {
    [1] = 0.8,
    [2] = 0.74,
    [3] = 0.74,
    [4] = 0.68,
    [5] = 0.68
}

local index = {
    [1] = 1,
    [2] = 2,
    [3] = 4,
    [4] = 5,
    [5] = 3
}

local index2 = {
    [1] = 1,
    [2] = 3,
    [3] = 5,
    [4] = 4,
    [5] = 2
}

---构造函数
---@protected
function RelicTeamChooseCampView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.headIndex = 0
    self:AddListener("ActivityDispatchSignUp", self.PlayAnimation, self)
end

---界面的入口函数
function RelicTeamChooseCampView:OnCreate()
    RelicTeamModel = require "RelicTeamModel":GetInstance()
    self.campItems = {}
    self:InitActivityTime()
    self:InitCampView()
    --todo:播弹幕
end

---开始时间~结束时间  (日月)
function RelicTeamChooseCampView:InitActivityTime()
    local starTime = RelicTeamModel.start_time
    local start = _G.TimeUtil.GetDateTime(starTime)
    local endt = _G.TimeUtil.GetDateTime(RelicTeamModel.end_time)
    local endDay = endt.day
        if endt.hour == 0 and endt.sec == 0 and endt.min == 0 then 
            endDay = endDay.day - 1
        end
    self.go_table.aortext_time.text = _G.GetLangPackValue(
        90025800003, string.format("<color=#96ce51>%s</color>", start.month .. "." .. start.day .. "~" .. endt.month .. "." .. endDay))
end

---初始化界面
function RelicTeamChooseCampView:InitCampView()
    self.campHeadInfo = RelicTeamModel:GetCampHeadInfo()
    self.campNum = RelicTeamModel:GetCampNum()
    for i = 1, 2 do
        local index = i == 1 and 2 or 1
        if self.campItems[i] == nil then
            self.campItems[i] = _G.GetAutoGoTable(self.go_table["obj_camp" .. i], _G.handlerbind(self, self.OnClickCampItem, index))
        end
        local goTable = self.campItems[i]
        local data = self.campHeadInfo[index]
        goTable.aortext_power.text = _G.GetLangPackValue(90033400013, _G.GameUtil.NumberToUnitStrFight(math.ceil(100*self.campNum[index].value * self.campNum[index].value)))
        local bol = not _G.table.isEmptyOrNil(data)
        goTable.obj_headParent:SetActiveE(bol and 1 or 0)
        if bol then
            for k, v in ipairs(data) do
                local obj = goTable["obj_head" .. k]
                _G.UIUtils.SetPlayerHeadItemNew(obj, v, headScale[k], true, true, true)
                obj:SetActiveE(1)
                if k == 1 then
                    goTable.aortext_name.text = v.name
                end
            end
        end
    end
    self.isPlayAnimation = (self.campHeadInfo[1] and #self.campHeadInfo[1] > 1) and (self.campHeadInfo[2] and #self.campHeadInfo[2] > 1)
    self:SetHeadAnimation()
end

function RelicTeamChooseCampView:SetHeadAnimation()
    self.headIndex = self.headIndex + 1
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    for k = 1, 2 do
        local campIndex = k == 1 and 2 or 1
        local data = self.campHeadInfo[campIndex] or {}
        local goTable = self.campItems[k]
        for i = 1, 5 do
            local headIndex = k == 2 and index or index2
            local obj = goTable["obj_head" .. headIndex[i]]
            local j = i + self.headIndex - 1
            if j >= #data and self.isPlayAnimation == true then
                j = j % #data
                if j == 0 then
                    j = #data
                end
            end
            local headData = data[j]
            obj:SetActiveE(headData ~= nil and 1 or 0)
            if headData ~= nil then
                _G.UIUtils.SetPlayerHeadItemNew(obj, headData, headScale[i], true, true, true)
                if i == 1 then
                    goTable.aortext_name.text = headData.name
                end
            end
        end
        if #data > 1 and self.headIndex > 1 then
            for j = 1, 2 do
                local obj = goTable["obj_headAdd" .. j]
                local index = j == 1 and self.headIndex - 1 or self.headIndex + 2
                if index >= #data and self.isPlayAnimation == true then
                    index = index % #data
                    if index == 0 then
                        index = #data
                    end
                end
                local headData = data[index]
                if headData ~= nil then
                    _G.UIUtils.SetPlayerHeadItemNew(obj, headData, headScale[j == 1 and 1 or 5], true, true, true)
                end
            end
        end
    end
    if self.headIndex == 1 and self.isPlayAnimation then
        if not self.timer then
            self.timer = _G.TimerManager:GetInstance():GetTimer(2, self.SetHeadAnimation, self, true, false, true)
            self.timer:Start()
        end
    elseif self.isPlayAnimation then
        if self.AnimComponent == nil then
            self.AnimComponent = self.go_table.obj_root:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
        end
        self.AnimComponent:Play("Ani_ActivityDispatchSignUpView")
    end
end

function RelicTeamChooseCampView:PlayAnimation()
    self.AnimComponent:Play("New State")
    if not self.timer then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.SetHeadAnimation, self, true, false, true)
        self.timer:Start()
    end
end

function RelicTeamChooseCampView:OnClickCampItem(go, isOn, type)
    local name = go:GetName()
    if name == "@_aorbtn_signUp" then
        local otherType = type == 1 and 2 or 1
        local allNum = self.campNum[type].value + self.campNum[otherType].value
        local ratioT = _G.ConfigManager.discrete_cfg[125108][1]
        local status = RelicTeamModel:GetStatusAndNextTimeLine()
        if allNum < ratioT[2] or self.campNum[type].value <= self.campNum[otherType].value or ((self.campNum[type].value / self.campNum[otherType].value - 1) < ratioT[1] / 10000) then 
            local sure = function()
                local T = {camp = type}
                RelicTeamModel:ChooseCamp(T, function()
                    if status == RelicTeamModel.relicStatus.idle or status == RelicTeamModel.relicStatus.explore then 
                        local msg = {}
                        msg.name = _G.GetPlayerName()
                        msg.type = 1
                        msg.power = 0
                        RelicTeamModel:CreateTeam(msg, function()
                            if self:IsNil() then
                                return
                            end
                            self:Close()
                            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicTeamToggleView.Name)
                        end)
                    else 
                        self:Close()
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicTeamToggleView.Name)
                    end
                end)
            end
            _G.PopWindowManager:GetInstance():ShowAllTips(1070008, nil, sure) 
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(5219)  
        end
    elseif name == "@_aorbtn_rank" then
        --打开势力名单界面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicTeamCampPlayerView.Name, type)
    end
end

---界面的销毁函数
function RelicTeamChooseCampView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---按钮点击事件在这里派发
function RelicTeamChooseCampView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_info then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 169)
    elseif go == self.go_table.aorbtn_award then
        local RelicTeamModel = require("RelicTeamModel"):GetInstance()
        local RelicCfg = RelicTeamModel:GetRelicCfgNow()
        local camp = RelicTeamModel:GetCamp()
        local relic_rank1 = RelicCfg.relic_rank1
        local relic_rank2 = RelicCfg.relic_rank2
        local count1 = #relic_rank1
        local count2 = #relic_rank2

        local RankUtils = require("RankUtils")
        local rankStr = RankUtils.RankStrDefault.Points

        local rankType = RankUtils.RankType.AncientGodAllianceTeam
        if camp then
            if camp == 1 then
                rankType = RankUtils.RankType.AncientGodAllianceTeam
            elseif camp == 2 then
                rankType = RankUtils.RankType.AncientGodHordeSquad
            end
        end

        -----@type RewardPreviewView.OpenData[]
        local OpenData = {--TODO 排行榜 常量
            RankUtils.GetData(13,0,0,rankStr,nil,_G.ConfigManager.arena_rank_cfg,relic_rank1[1],relic_rank1[count1],1,RankUtils.RankType.AncientGodPersonalPoints),
            RankUtils.GetData(14,0,0,rankStr,nil,_G.ConfigManager.arena_rank_cfg,relic_rank2[1],relic_rank2[count2],1,rankType),
            --RankUtils.GetData(15,0,0,rankStr,nil,_G.ConfigManager.arena_rank_cfg,relic_rank2[1],relic_rank2[count2],1,RankUtils.RankType.AncientGodHordeSquad),
        }

        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RewardPreviewFullView.Name,OpenData,1, nil, nil, true)
        --todo:打开奖励界面
    end
end

return RelicTeamChooseCampView