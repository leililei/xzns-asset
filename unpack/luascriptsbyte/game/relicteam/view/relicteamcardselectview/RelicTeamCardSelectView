---@class RelicTeamCardSelectView : UIBaseView 
---@field public go_table RelicTeamCardSelectView_GoTable GoTable
local RelicTeamCardSelectView = _G.BaseClass("RelicTeamCardSelectView", _G.UIBaseView)

local elementType = _G.CardElementType
local profType = _G.CardProfType
local equipmentType = _G.EquipmentProfessional

function RelicTeamCardSelectView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.scrollloopvectical_card:InitItemData(0, _G.handler(self, self.OnItemCall))
end

---界面的入口函数
