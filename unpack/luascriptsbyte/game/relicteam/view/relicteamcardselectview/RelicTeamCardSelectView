        equipData = 0
    }
    self.profBtns = {
        self.go_table.aorbtn_pAll,
        self.go_table.aorbtn_pTK, --1
        self.go_table.aorbtn_pZS, --2
        self.go_table.aorbtn_pFS, --3
        self.go_table.aorbtn_pFZ, --4
        self.go_table.aorbtn_pYX --5
    }
    self.equipmentBtns = {
        self.go_table.aorbtn_eAll,
        self.go_table.aorbtn_eLiliang,
        self.go_table.aorbtn_eMinjie,
        self.go_table.aorbtn_eZhili
    }
    self.cardTypeEnum = {
        btnIcon = {
            [0] = "ui_js_all_btn",
            [1] = "ui_js_renlei_icon", --人类
            [2] = "ui_js_shouren_icon", --兽人
            [3] = "ui_js_jingling_icon", --精灵
            [4] = "ui_js_wangling_icon", --亡灵
            [5] = "ui_js_chuanqi_icon", --预留
            [6] = "ui_js_chuanqi_icon", --传奇
            [16] = "ui_js_multi16",   --人神
            [26] = "ui_js_multi26",   --兽神
            [36] = "ui_js_multi36",    --精神
            [46] = "ui_js_multi46"     --亡神
        }
    }

    ---筛选按钮 gotable
    self.cardTypeGos = {}
    self.itemObjDic = {}
    self.showCardlist = {}
    self.ElementsType = elementType.None
    self:SetCardList()
    self:InitBtn()
end

function RelicTeamCardSelectView:OnItemCall(index, obj)
    local id = obj:GetInstanceIDE()
    local item = self.itemObjDic[id]
    index = index + 1

    local func = function()
        local data = self.nowCardList[index]
        if data ~= nil then
            if item.ItemCardHeadSelectView.CardData == nil or item.ItemCardHeadSelectView.CardData.uid ~= data.uid then
                if self.IsLoopInit then
                    data.skinIs = true
                    data.isHave = true
                    item.ItemCardHeadSelectView:ShowCardData(data, _G.handler(self, self.OnClick_CardClick), true, index)
                else
                    _G.DelayDo(
                            index * 0.02,
                            function()
                                data.skinIs = true
                                data.isHave = true
                                item.ItemCardHeadSelectView:ShowCardData(
                                        data,
                                        _G.handler(self, self.OnClick_CardClick),
                                        true,
                                        index
                                )
                            end
                    )
                end
            end
            -- local isLv = data.lv_Old > 1
            -- if isLv then
            --     isGou = false
            --     isGray = true
            -- elseif self.NowSelectIndex == index then
            --     isGou = true
            --     isGray = true
            -- end
            item.ItemCardHeadSelectView:SetSelectGou(self.NowSelectIndex == index)
        end
    end

    if not item then
        item = _G.GetAutoGoTable(obj)
        self.itemObjDic[id] = item

        ------@param view ItemCardHeadSelectView
        _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.HeadItem_Select,
                item.gameObject,
                function(view)
                    view.gameObject:SetActiveE(1)
                    view.transform:SetLocalPositionToZero()
                    view.transform:SetLocalScale(0.75, 0.75, 1)
                    item.ItemCardHeadSelectView = view
                    func()
                end
        )
    else
        func()
    end

    return item
end

function RelicTeamCardSelectView:OnClick_CardClick(params)
    local index = params[1]
    local cardData = self.itemDatas[index]
    if cardData == nil then
        return
    end

    if self.NowSelectIndex ~= index then
        self.NowSelectIndex = index
    end
    self:UpdataList()
end

function RelicTeamCardSelectView:SetCardList()
    local Dic = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
        ---@type CardData[]
        ---@param v CardData
        self.itemDatas = table.toArray(Dic)
        _G.table.sort(self.itemDatas, _G.handler(self, self.SortCardListFunc))
    self.nowCardList = self.nowCardList or self.itemDatas
    local count = #self.nowCardList
    _G.GameUtil.SetActiveByCondition(self.go_table.aortext_null, count == 0)
    self:UpdataList(count)
    self.IsLoopInit = true
end

function RelicTeamCardSelectView:SortCardListFunc(a, b)
    local power1 = a:GetPower()
    local power2 = b:GetPower()
    if power1 == power2 then
        if a:GetStar() == b:GetStar() then
            if a.Grade == b.Grade then
                if a:GetLevel() == b:GetLevel() then
                    if a.sid == b.sid then
                        return a.uid > b.uid
                    else
                        return a.sid > b.sid
                    end
                else
                    return a:GetLevel() > b:GetLevel()
                end
            else
                return a.Grade > b.Grade
            end
        else
            return a:GetStar() > b:GetStar()
        end
    else
        return power1 > power2
    end
end

function RelicTeamCardSelectView:UpdataList(Count)
    if Count ~= nil then
        self.go_table.scrollloopvectical_card:UpdateCount(Count)
    else
        self.go_table.scrollloopvectical_card:UpdateAllItem()
    end
end

function RelicTeamCardSelectView:CloseView()
    self:Close()
end

---@private
function RelicTeamCardSelectView:ChangeProfListType(index)
    if index == nil then
        return
    end
    if index == self.sx_Elements.profData then
        self.sx_Elements.profData = profType.None
        self.NowSelectCardIndex = 1
        self:StarSx()
        self.go_table.trans_pChoose:SetPositionByTarget(self.profBtns[profType.None + 1])
        return
    end
    local olddata = self.sx_Elements.profData
    self.sx_Elements.profData = index
    self:StarSx()
    if #self.nowCardList == 0 then
        self.sx_Elements.profData = olddata
        self:StarSx()
        --并弹提示
        _G.PopWindowManager:GetInstance():ShowAllTips(self.profNilTips[index])
    else
        self.NowSelectCardIndex = 1
        self.go_table.trans_pChoose:SetPositionByTarget(self.profBtns[index + 1])
    end
end

---@private
function RelicTeamCardSelectView:ChangeEquipmentListType(index)
    if index == nil then
        return
    end
    if index == self.sx_Elements.equipData then
        self.sx_Elements.equipData = 0
        self.NowSelectCardIndex = 1
        self:StarSx()
        self.go_table.trans_eChoose:SetPositionByTarget(self.equipmentBtns[1])
        return
    end
    local olddata = self.sx_Elements.equipData
    self.sx_Elements.equipData = index
    self:StarSx()
    if #self.nowCardList == 0 then
        self.sx_Elements.equipData = olddata
        self:StarSx()
        --并弹提示
        _G.PopWindowManager:GetInstance():ShowAllTips(320114)
    else
        self.NowSelectCardIndex = 1
        self.go_table.trans_eChoose:SetPositionByTarget(self.equipmentBtns[index + 1])
    end
end

---@private
function RelicTeamCardSelectView:ShowTypeList(show)
    self.showTypeListTag = show
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_equipment, show)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_prof, show)
    self.go_table.aorbtn_typeList:SetEulerAngles(0, 0, show and 180 or 0)
end

---筛选
function RelicTeamCardSelectView:StarSx()
    ---@param CardData CardData
    self.nowCardList =
    _G.table.chooseToArray(
            self.itemDatas,
            function(_, CardData)
                if self.sx_Elements.data ~= 0 and not require "CardInfoManager":GetInstance():CheckMultiMatch(self.sx_Elements.data,CardData.cfg.Elements_new) then
                    return false
                elseif self.sx_Elements.profData ~= 0 and self.sx_Elements.profData ~= CardData.cfg.Professional then
                    return false
                elseif self.sx_Elements.equipData ~= 0 and self.sx_Elements.equipData ~= CardData.cfg.EquipmentType then
                    return false
                end
                return true
            end
    )
    self:UpdataList(#self.nowCardList)
end

function RelicTeamCardSelectView:OnClick_CardType(index)
    if index == nil or index == self.sx_Elements.data then
        return
    end
    local olddata = self.sx_Elements.data
    self.sx_Elements.data = self.sxEnum.Elements[index]
    ---先筛选
    local tempIndex = self.NowSelectIndex
    self.NowSelectIndex = 1
    self:StarSx()
    ---若没有卡
    if #self.nowCardList == 0 then
        ---还原
        self.NowSelectIndex = tempIndex
        self.sx_Elements.data = olddata
        self:StarSx()
        --并弹提示
        _G.PopWindowManager:GetInstance():ShowAllTips(320114)
    else
        --self.NowSelectCardIndex = 1
        self:InitBtn(true)
    end
end
---@param IsSetOn boolean True检测当前选中 (OnCreate里设置会错位)
function RelicTeamCardSelectView:InitBtn(IsSetOn)
    local obj, showGod
    for i = 0, 6 do
        if self.cardTypeGos[i] == nil then
            obj = self.go_table["obj_type (" .. i .. ")"]
            obj = _G.GetAutoGoTable(obj)
            self.cardTypeGos[i] = obj
        end
        self:btnSet(self.cardTypeGos[i], i, IsSetOn)
        if i == _G.CardElementType.God then
            showGod = _G.GlobalConditionManager.CheckConditionArrays(_G.ConfigManager.discrete_cfg[106706])
            self.cardTypeGos[i].gameObject:SetActiveE(showGod and 1 or 0)
        end
    end
end
function RelicTeamCardSelectView:btnSet(go_table, cardTypeEnumIndex, IsSetOn)
    if cardTypeEnumIndex ~= nil then
        go_table.aorimage_icon.SpriteName = self.cardTypeEnum.btnIcon[cardTypeEnumIndex]
    end
    if go_table.Click == nil then
        go_table.aorbtn_btn.onClick:AddListener(_G.handlerbind(self, self.OnClick_CardType, cardTypeEnumIndex))
        go_table.Click = true
    end
    if IsSetOn and cardTypeEnumIndex == self.sx_Elements.data then
        self.go_table.aorimage_typeOn:SetPositionByTarget(go_table.gameObject)
    end
end

---按钮点击事件在这里派发
function RelicTeamCardSelectView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseBtn" or name == "@_aorbtn_closeView" then
        self:CloseView()
    elseif name == "@_aorbtn_sure" then
        _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)
        if self.NowSelectIndex then 
            if require "RelicTeamModel":GetInstance():CheckCardCanAssist(self.nowCardList[self.NowSelectIndex].uid, self.playerUid) then
                self.selectCallBack(self.nowCardList[self.NowSelectIndex].uid)
                self:CloseView()
            else 
                _G.PopWindowManager:GetInstance():ShowAllTips(1070031)
            end
        end
    end
end

return RelicTeamCardSelectView
