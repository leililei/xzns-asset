---@class RelicTeamHallView : UIBaseView    中文描述
local RelicTeamHallView = _G.BaseClass("RelicTeamHallView", _G.Component)
local RelicTeamModel
function RelicTeamHallView:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end

function RelicTeamHallView:Awake()
end

---界面的入口函数
function RelicTeamHallView:OnCreate()
    RelicTeamModel = require "RelicTeamModel":GetInstance()
    _G.GameUtil.InputFieldCharacterLimit(self.go_table.input_input, 12, nil, true)
    self:GetInfo()
end

---刷新界面
function RelicTeamHallView:UpdateView()
    if not self.go_table then
        return
    end
    self:FreshData()
    self.showType = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.RelicTeamHallShowType, 1)
    self.go_table.obj_showNoFull:SetActiveE(self.showType == 2 and 1 or 0)
    self.infoList = self.showType == 1 and self.teamList or self.noFullTeamList
    if not self.init then
        self.go_table.scrollloopvectical_teamList:InitItemData(0, _G.handler(self, self.RefreshList))
        self.go_table.scrollloopvectical_teamList:UpdateCount(#self.infoList)
        self.init = true
    else
        self.go_table.scrollloopvectical_teamList:UpdateCount(#self.infoList)
        self.go_table.scrollloopvectical_teamList:UpdateAllItem()
    end
    local teamBol = self.status == RelicTeamModel.relicStatus.team 
    if teamBol then 
        self.countDown = self.nextTime - _G.TimeUtil.GetServerUnixTime()
        self:UpdateTime(0)
        self:StopTimer()
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.timer:Start()
    end 
end

function RelicTeamHallView:UpdateTime(elapsed)
    self.countDown = self.countDown - elapsed
    if self.countDown < 0 then
        self.countDown = 0
    end
    if self.go_table == nil then
        return
    end
    local time = _G.Mathf.RoundToInt(self.countDown)
    self.go_table.aortext_teamTime.text = _G.GetLangPackValue(90033500051, _G.string.AddColor(_G.TimeUtil.TransDayHourMineMiao(time), "69fa3c"))
end

function RelicTeamHallView:RefreshList(index, obj)
    local data = self.infoList[index + 1]
    local tb = _G.GetAutoGoTable(obj)
    tb["_onclick"] = _G.handlerbind(self, self.ClickItemBtn, tb, data)
    RelicTeamModel:SetTeamHeadItem(tb.obj_headTable, data, 1)
    tb.aortext_name.text = _G.GetLangPackValue(90033500125, data.name) 
    tb.aortext_power.text = _G.UIUtils.NumberToUnitStr_CardFightNum(data.power, true)
    tb.aortext_checkPower:SetActiveE(data.join_power and data.join_power > 0 and 1 or 0) 
    tb.aortext_checkPower.text = _G.GetLangPackValue(90033500053, _G.UIUtils.NumberToUnitStr(data.join_power, true))
    local grayColor = _G.AppSetting.IsXzns and _G.ColorTools.FormatColorByString("444444") or _G.Color.black
    local normalColor = _G.AppSetting.IsXzns and "FFFFFF" or "8C2D14"
    local isGray = false
    if table.ContainsValue(self.requestedTeamUidList, data.uid) then 
        tb.aorbtn_request:SetGray(true)
        tb.aortext_request.color = grayColor
        tb.aortext_request.text = _G.GetLangPackValue(90100000115)
        isGray = true
    elseif data.join_power and data.join_power > _G.PlayerModel:GetInstance():GetCorePower() then 
        tb.aorbtn_request:SetGray(true)
        tb.aortext_request.color = grayColor
        tb.aortext_request.text = _G.GetLangPackValue(90020100022)
        isGray = true
    elseif #data.role_info >= 3 then 
        tb.aorbtn_request:SetGray(true)
        tb.aortext_request.color = grayColor
        tb.aortext_request.text = _G.GetLangPackValue(90033500052)
        isGray = true
    elseif data.is_check == 1 then 
        tb.aorbtn_request:SetGray(false)
        tb.aortext_request.color = _G.ColorTools.FormatColorByString(normalColor)
        tb.aortext_request.text = _G.GetLangPackValue(90033400015)
    else 
        tb.aorbtn_request:SetGray(false)
        tb.aortext_request.color = _G.ColorTools.FormatColorByString(normalColor)
        tb.aortext_request.text = _G.GetLangPackValue(90020100022)
    end
    if _G.AppSetting.IsXzns then
        local gradient = tb.aortext_request:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient))
        gradient.enabled = not isGray
    end
end

function RelicTeamHallView:ClickItemBtn(go, isOn, tb, data)
    if go == tb.aorbtn_request then
        if _G.AppSetting.IsXzns and not RelicTeamModel:CheckArray() then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                5221,
                nil,
                function()
                    if _G.MainManager:GetInstance():IsFighting(true) then
                        return
                    end
                    RelicTeamModel:OnChallenge(true)
                end
            )
            return
        elseif table.ContainsValue(self.requestedTeamUidList, data.uid) then 
            return 
        elseif data.join_power and data.join_power > _G.PlayerModel:GetInstance():GetCorePower() then 
            _G.PopWindowManager:GetInstance():ShowAllTips(5215) 
            return 
        elseif #data.role_info >= 3 then 
            _G.PopWindowManager:GetInstance():ShowAllTips(1070010)
            return 
        else 
            tb.aorbtn_request:SetGray(true)
            tb.aortext_request.text = _G.GetLangPackValue(90100000115)
            RelicTeamModel:RequestTeam({uid = {data.uid}}, _G.handler(self,self.GetInfo))
            if _G.AppSetting.IsXzns then
                tb.aortext_request.color = _G.ColorTools.FormatColorByString("444444")
                local gradient = tb.aortext_request:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient))
                gradient.enabled = false
            end
        end 
    end
end

---刷新数据
function RelicTeamHallView:FreshData()
    self.teamList, self.noFullTeamList = RelicTeamModel:GetTeamList()
    self.requestedTeamUidList = RelicTeamModel:GetRequestedTeamUidList()
    self.status, self.nextTime = RelicTeamModel:GetStatusAndNextTimeLine()
end
---按钮点击事件在这里派发
function RelicTeamHallView:OnClickBtn(go, isOn)
    if go == self.go_table.obj_close then
        self:Close()
    elseif go == self.go_table.aorbtn_showMine then 
        self.showType = self.showType == 1 and 2 or 1
        self.go_table.obj_showNoFull:SetActiveE(self.showType == 2 and 1 or 0)
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.RelicTeamHallShowType, self.showType)
        self:UpdateView()
    elseif go == self.go_table.aorbtn_quick then
        if _G.AppSetting.IsXzns and not RelicTeamModel:CheckArray() then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                    5221,
                    nil,
                    function()
                        if _G.MainManager:GetInstance():IsFighting(true) then
                            return
                        end
                        RelicTeamModel:OnChallenge(true)
                    end
            )
            return
        end
        local T = {}
        for k, v in ipairs(self.noFullTeamList) do 
            if v.join_power <= _G.PlayerModel:GetInstance():GetCorePower() then 
                table.insert(T, v.uid)
            end
        end
        if #T == 0 then 
            _G.PopWindowManager:GetInstance():ShowAllTips(250104, _G.GetLangPackValue(90033500237))
            return
        end
        RelicTeamModel:RequestTeam({uid = T})
    elseif go == self.go_table.aorbtn_create then 
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicTeamCreateTeamView.Name)
    elseif go == self.go_table.aorbtn_inviteInfo then 
        RelicTeamModel:ClearNewInviteBol()
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RelicTeamInvite.id)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicTeamInviteMeView.Name)
    elseif go == self.go_table.aorbtn_search then 
         ---搜索队伍
        if self.go_table.input_input.text == "" then
            --_G.PopWindowManager:GetInstance():ShowAllTips(250104)
            self:UpdateView()
            return
        end
        local msg = {}
        msg.name = self.go_table.input_input.text
        RelicTeamModel:SelectTeam(msg, _G.handler(self, self.SelectBack))
    elseif go == self.go_table.aorbtn_Fresh then 
        self:GetInfo()
    elseif go == self.go_table.aorbtn_tips then 
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 169)
    end
end

function RelicTeamHallView:SelectBack(msg)
    if not self.go_table then
        return
    end
    if msg.list and #msg.list > 0 then 
        self.infoList = msg.list
    else 
        self.infoList = {}
    end 
    if not self.init then
        self.go_table.scrollloopvectical_teamList:InitItemData(0, _G.handler(self, self.RefreshList))
        self.go_table.scrollloopvectical_teamList:UpdateCount(#self.infoList)
        self.init = true
    else
        self.go_table.scrollloopvectical_teamList:UpdateCount(#self.infoList)
        self.go_table.scrollloopvectical_teamList:UpdateAllItem()
    end
end

function RelicTeamHallView:Hide()
    self.go_table.gameObject:SetActiveE(0)
end

function RelicTeamHallView:Show()
    self.go_table.gameObject:SetActiveE(1)
    self:GetInfo()
end

function RelicTeamHallView:GetInfo(msg)
    if (msg and msg.ack == 5204) or not msg then 
        RelicTeamModel:GetTeamListFromServer(_G.handler(self, self.UpdateView))
    end
end

function RelicTeamHallView:OnDestroy()
    self:StopTimer()
end

function RelicTeamHallView:StopTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return RelicTeamHallView
