---@class RelicView : UIBaseView  下边栏菜单
---@field go_table RelicView_GoTable
---@field nowEventCfg relic_events_cfg
local RelicView = _G.BaseClass("RelicView", _G.UIBaseView)
---@type RelicTeamModel
local RelicTeamModel
local energyItemSid = 203031101

function RelicView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.eRelicTeam.RelicTeamAttacked, self.AttackedPushCall, self)
    _G.Events:GetInstance():AddListener(_G.eRelicTeam.RelicTeamFall, self.AttackedPushCall, self)
    _G.Events:GetInstance():AddListener(_G.eRelicTeam.RelicTeamUpdateEnergy, self.FreshEnergy, self)
    _G.Events:GetInstance():AddListener(_G.eRelicTeam.RelicTeamUpdateTeamJewel, self.FreshMemberJewel, self)
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.UpdateView, self)
end

--被攻击推送
function RelicView:AttackedPushCall(msg)
    self:FreshHP()
    self:FreshMyJewel()
    _G.PopWindowManager:GetInstance():ShowAllTips(1070029)
    if RelicTeamModel:GetFallFlag() then
        local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.RelicTeamEmbattleView.Name)
        if ctrl then
            _G.WorldManager:GetInstance():DespawnRoleParent()
            local ctrlE = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.EmbattleView.Name)
            ctrlE:QuitEmbattle()
            RelicTeamModel:ReturnPanel(true)
        end
        if self.inEventViewBol and self.go_table.obj_eventRoot:GetctiveInHierarchy() == 1 then
            self:PopFallWindow()
        end
    end
end

--刷新自己的宝石数量
function RelicView:FreshMyJewel()
    for i = 1, 3 do
        if self.teamInfo.member_list[i] and self.teamInfo.member_list[i].role_info.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
            local tb = _G.GetAutoGoTable(self.go_table["obj_player" .. i])
            tb.aortext_jewel.text = RelicTeamModel:GetJewel()
        end
    end
end

function RelicView:FreshMemberJewel()
    for i = 1, 3 do
        if self.teamInfo.member_list[i] then
            local tb = _G.GetAutoGoTable(self.go_table["obj_player" .. i])
            tb.aortext_jewel.text = self.teamInfo.member_list[i].jewel or 0
            tb.aortext_power.text = _G.UIUtils.NumberToUnitStr_CardFightNum(self.teamInfo.member_list[i].power, true) or
                0
        end
    end
end

--掉层弹窗
function RelicView:PopFallWindow()
    if self.isOpenFallWindow then
        return
    end
    self.isOpenFallWindow = true
    RelicTeamModel:ChangeDrop()
    local sure = function()
        self:AnimOut(_G.handler(self, self.FallCallBack))
    end
    _G.PopWindowManager:GetInstance():ShowAllTipsExtend(1070002, nil, sure, nil, nil, nil, { noBgClose = true })
end

--升层弹窗
function RelicView:CheckUpLayerWindow()
    if RelicTeamModel:CheckCanNextLayer() and RelicTeamModel:GetUpLayerTipsBol() then
        local sure = function()
            RelicTeamModel:NextLayer(_G.handlerbind(self, self.AnimOut, _G.handler(self, self.ShowEventView)))
        end
        _G.PopWindowManager:GetInstance():ShowAllTips(1070020, nil, sure)
        RelicTeamModel:SetUpLayerTipsBol(false)
    end
end

function RelicView:FallCallBack()
    self.multipleIndex = 1
    self.isOpenFallWindow = nil
    RelicTeamModel:ClearFallFlag()
    self:UpdateView()
    self:ResetEventAnim()
end

---界面的入口函数
function RelicView:OnCreate()
    RelicTeamModel = require "RelicTeamModel":GetInstance()
    self.multipleList = RelicTeamModel:GetMultipleList()
    self.multipleEventNumList = RelicTeamModel:GetMultipleEventNumList()
    local hasTeam = RelicTeamModel:GetTeamInfo()
    local status = RelicTeamModel:GetStatusAndNextTimeLine()
    if not hasTeam and status == RelicTeamModel.relicStatus.settle then
        for i = 1, 3 do
            self.go_table["aorbtn_headAdd" .. i]:SetActiveE(0)
        end
        self.go_table.aorbtn_go:SetActiveE(0)
    end
    -- local res = _G.ConfigManager.ui_cfg.RelicView.resources
    -- local component = self:AddComponent(
    --     self.go_table.obj_goldInfo,
    --     require("ResourceCompont").New(self.go_table.obj_goldInfo, res)
    -- )
    -- component:SetClickCallback(_G.handler(self, self.UseEnergyItem))
    self:InitMultipleIndex()
    self:UpdateView()
end

--使用体力道具
function RelicView:UseEnergyItem(noItemCall)
    local itemData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, energyItemSid)
    local count =
        _G.StorageManager:GetInstance():GetItemCountByID(
            _G.StorageID.Prop,
            energyItemSid
        )
    if count > 0 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BagUsePropTipView.Name, itemData)
    else
        if noItemCall then
            noItemCall()
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, energyItemSid)
        end
    end
end

function RelicView:FreshData()
    self.status, self.nextTime = RelicTeamModel:GetStatusAndNextTimeLine()
    self.nowDay = RelicTeamModel:GetNowExploreDay()
    self.bossCfg = RelicTeamModel:GetBossCfg(self.nowDay)
    self.effectStr = RelicTeamModel:GetNowEffectsStr(self.nowDay)
    self.teamInfo = RelicTeamModel:GetTeamInfo()
    ---@type relic_cfg
    self.relicCfg = RelicTeamModel:GetRelicCfgNow()
end

function RelicView:UpdateView()
    self:FreshData()
    self.go_table.aorimage_next:SetGray(true)
    if self.inEventViewBol and self.status == RelicTeamModel.relicStatus.explore then
        self:ShowEventView()
    else
        self.inEventViewBol = false
        self:FreshEnergy()
        self.go_table.obj_relicRoot:SetActiveE(1)
        self.go_table.obj_eventRoot:SetActiveE(0)
        if _G.AppSetting.IsXzns then
            self.go_table.obj_resourceRoot:SetActiveE(0)
            self.go_table.aorrawimage_bossnamebg:LoadImage(self.relicCfg.boss_title)
            self.go_table.aorrawimage_Timebg:LoadImage(self.relicCfg.title)
            self.go_table.aorrawimage_messagebg:LoadImage(self.relicCfg.describe)
            self.go_table.aorimage_buffbg.SpriteName=self.relicCfg.buff_bj
            self.go_table.aorimage_bottommask.SpriteName=self.relicCfg.mask
        end
        self.go_table.obj_serverList:GetComponentE(_G.typeof(_G.CS.ExtendText)).text = string.format("<%s@1>",
            _G.GetLangPackValue(90033500130))
        self.go_table.obj_drop:GetComponentE(_G.typeof(_G.CS.ExtendText)).text = string.format("<%s@1>",
            _G.GetLangPackValue(90033500099))
        self.go_table.aortext_des.text = _G.GetLangPackValue(self.bossCfg.desc)
        self.go_table.aortext_bossName.text = _G.GetLangPackValue(self.bossCfg.name)
        local strT = _G.string.split(self.effectStr[1], "#")
        self.go_table.aortext_banner.text = strT[1]
        self.go_table.aortext_effect.text = strT[2]
        self.go_table.aortext_effect1.text = strT[2]
        local startTime, endTime, fightTime = RelicTeamModel:GetTime()
        startTime = _G.TimeUtil.date("*t", startTime)
        endTime = _G.TimeUtil.date("*t", endTime)
        local exploreHour = RelicTeamModel:GetExploreTime()
        local endDay = endTime.day
        if endTime.hour == 0 and endTime.sec == 0 and endTime.min == 0 then
            endDay = endTime.day - 1
        end
        self.go_table.aortext_dateTime.text = _G.GetLangPackValue(90033500128, startTime.month, startTime.day,
            endTime.month, endDay)
        self.go_table.aortext_hourTime.text = _G.GetLangPackValue(90033500129, exploreHour[1][1], exploreHour[2][1])
        local teamBol = self.status == RelicTeamModel.relicStatus.team
        local settleBol = self.status == RelicTeamModel.relicStatus.settle
        local fightBol = (self.status == RelicTeamModel.relicStatus.explore) or
            (self.status == RelicTeamModel.relicStatus.idle)
        self.go_table.obj_team:SetActiveE((teamBol or settleBol or fightBol) and 1 or 0)
        self:ChangeGoBtn()
        self:InitBossModel()
        if teamBol or settleBol or fightBol then
            local txt = teamBol and _G.GetLangPackValue(90033500035) or _G.GetLangPackValue(90033500132)
            txt = fightBol and _G.GetLangPackValue(90033500231) or txt
            self.go_table.aortext_status.text = txt
            if fightBol then
                self.countDown = fightTime - _G.TimeUtil.GetServerUnixTime()
            else
                self.countDown = self.nextTime - _G.TimeUtil.GetServerUnixTime()
            end
            self:UpdateTime(0)
            self:StopTimer()
            self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
            self.timer:Start()
        end
        RelicTeamModel:SetTeamHeadItem(self.go_table.obj_headTable, self.teamInfo or {}, 1)
        if not table.isEmptyOrNil(self.teamInfo) and not table.isEmptyOrNil(self.teamInfo.member_list) then
            for i = 1, 3 do
                if self.teamInfo.member_list[i] then
                    self.go_table["obj_name" .. i]:SetActiveE(1)
                    local mineBol = self.teamInfo.member_list[i].role_info.uid ==
                        _G.PlayerModel:GetInstance():GetPlayerUid()
                    if mineBol then
                        self.myTeamIndex = i
                    end
                    if mineBol then
                        self.go_table["aortext_name" .. i].text = _G.string.AddColor(
                            _G.PlayerModel:GetInstance():GetName(), "69fa3c")
                    else
                        self.go_table["aortext_name" .. i].text = _G.string.AddColor(
                            self.teamInfo.member_list[i].role_info.name, "ffffff")
                    end
                else
                    self.go_table["obj_name" .. i]:SetActiveE(0)
                end
            end
        else
            for i = 1, 3 do
                self.go_table["obj_name" .. i]:SetActiveE(0)
            end
        end
        self.go_table.aorrawimage_Bg:LoadImage(self.relicCfg.home_bg,
            function(tran)
                if self:IsNil() then
                    tran:DestroyObject()
                    return
                end
                tran:SetNativeSize()
            end
        )
        self.go_table.aorrawimage_Title:LoadImage(self.relicCfg.home_txt,
            function(tran)
                if self:IsNil() then
                    tran:DestroyObject()
                    return
                end
                tran:SetNativeSize()
            end
        )
        -- if not self.curSceneTrans then
        --     self:InitScene()
        -- end
    end
end

function RelicView:ChangeGoBtn()
    if _G.table.isEmptyOrNil(self.teamInfo) then
        self.go_table.aortext_goBtn.text = _G.GetLangPackValue(90033500126)
    else
        self.go_table.aortext_goBtn.text = _G.GetLangPackValue(90033500127)
        if self.status ~= RelicTeamModel.relicStatus.explore then
            self.go_table.aorbtn_go:SetGray(true)
            self.go_table.aortext_goBtn.color = _G.Color.black
        else
            self.go_table.aorbtn_go:SetGray(false)
            self.go_table.aortext_goBtn.color = _G.ColorTools.FormatColorByString("8C2D14")
        end
    end
end

--刷新事件页面
function RelicView:ShowEventView()
    if RelicTeamModel:GetFallFlag() then
        self:PopFallWindow()
    end
    self:FreshNowEvent(not self.inEventViewBol)
    self.inEventViewBol = true
    self.go_table.obj_relicRoot:SetActiveE(0)
    self.go_table.obj_eventRoot:SetActiveE(1)
    if _G.AppSetting.IsXzns then
        self.go_table.obj_resourceRoot:SetActiveE(1)
    end
    self.go_table.aorbtn_bag:SetActiveE(1)
    self.go_table.aorbtn_embattle:SetActiveE(0)
    local eventNum = RelicTeamModel:GetNowEventNum()
    local nowLayer = RelicTeamModel:GetNowLayer()
    local layerNeedNum = RelicTeamModel:GetLayerEventCondition(nowLayer)
    local upTxt = RelicTeamModel:GetUpTxt()
    local upBol
    if layerNeedNum then
        upBol = eventNum >= layerNeedNum
        local color = upBol and "69fa3c" or "C02313"
        self.go_table.aortext_eventNum:SetActiveE(1)
        self.go_table.aortext_eventNum.text = _G.GetLangPackValue(upTxt, layerNeedNum,
            _G.string.AddColor(eventNum, color), layerNeedNum)
        self.go_table.aorbtn_next:SetActiveE(1)
    else
        self.go_table.aortext_eventNum:SetActiveE(0)
        --self.go_table.aortext_eventNum.text = _G.GetLangPackValue(upTxt, _G.string.AddColor(eventNum, color), 0)
        self.go_table.aorbtn_next:SetActiveE(0)
    end
    self.go_table.obj_nextEffect:SetActiveE(upBol and 1 or 0)
    self.go_table.aorimage_next:SetActiveE(upBol and 0 or 1)
    self:FreshEnergy()
    self.go_table.aortext_layerName.text = RelicTeamModel:GetRelicName() .. _G.GetLangPackValue(90037010103, nowLayer)
    for i = 1, 3 do
        local tb = _G.GetAutoGoTable(self.go_table["obj_player" .. i])
        tb.gameObject:SetActiveE(self.teamInfo.member_list[i] and 1 or 0)
        if self.teamInfo.member_list[i] then
            tb.aortext_name.text = self.teamInfo.member_list[i].role_info.name
            tb.aortext_jewel.text = self.teamInfo.member_list[i].jewel or 0
            tb.aortext_power.text = _G.UIUtils.NumberToUnitStr_CardFightNum(self.teamInfo.member_list[i].power, true) or
                0
            _G.UIUtils.SetPlayerHeadItemNew(tb.obj_headItem, self.teamInfo.member_list[i].role_info,
                i == 1 and 0.6 or 0.5, true)
        end
    end
    self:FreshHP()
    if not self.IsFirst then
        self.go_table.looplist2_eventList:InitListView(0, _G.handler(self, self.RefreshList))
        self.IsFirst = true
    end
    self.go_table.looplist2_eventList:SetListItemCount(#self.eventShowTxtTable, true, true)
    self.go_table.looplist2_eventList:MovePanelToItemIndex(#self.eventShowTxtTable - 1)
    --self.go_table.looplist2_eventList:RefreshAllShownItem()
end

function RelicView:FreshMyPower()
    local tb = _G.GetAutoGoTable(self.go_table["obj_player" .. self.myTeamIndex])
    tb.aortext_power.text = _G.UIUtils.NumberToUnitStr_CardFightNum(self.teamInfo.member_list[self.myTeamIndex].power,
        true) or 0
end

---刷新列表
function RelicView:RefreshList(listView2, index)
    if index < 0 then
        return
    end
    local data = self.eventShowTxtTable[index + 1]
    local item = listView2:NewListViewItem("$_obj_ListItem")
    local tb = _G.GetAutoGoTable(item)
    tb.aortext_event.text = data
    _G.GameUtil.ReBuildRTF(item)
    _G.GameUtil.ReBuildRTF(self.go_table.obj_Content)
    return item
end

--刷新自己的HP
function RelicView:FreshHP()
    local hp = RelicTeamModel:GetNowHP()
    local maxHP = RelicTeamModel:GetMaxHP()
    self.go_table.aortext_hp.text = hp .. "%"
    self.go_table.aorimage_hp:SetRectTransformSize(hp / maxHP * 388, 20)
end

--刷新事件数据
function RelicView:FreshEventData()
    self.nowEventInfo = RelicTeamModel:GetRoleEvent()
    self.eventShowTxtTable = RelicTeamModel:GetEventShowTxtTable()
    if RelicTeamModel:CheckHaveEventNow() then
        self.nowEventCfg = _G.ConfigManager.relic_events_cfg[self.nowEventInfo.event.event_sid]
    else
        self.nowEventCfg = nil
    end
    if not self.IsFirst then
        self.go_table.looplist2_eventList:InitListView(0, _G.handler(self, self.RefreshList))
        self.IsFirst = true
    end
    self.go_table.looplist2_eventList:SetListItemCount(#self.eventShowTxtTable, true, true)
    self.go_table.looplist2_eventList:MovePanelToItemIndex(#self.eventShowTxtTable - 1)
    --self.go_table.looplist2_eventList:RefreshAllShownItem()
end

---获取事件对应位置的消耗
function RelicView:GetStoneXh(pos)
    local stone = self.nowEventCfg.stone[pos]

    if stone and stone[3] < 0 then
        return true, math.abs(stone[3])
    else
        return false
    end
end

--刷新事件按钮
function RelicView:ChangeExploreBtnTxt()
    if RelicTeamModel:CheckHaveEventNow() then
        self:ShowMultipleView(false)
        if self.nowEventCfg.event_type ~= 6 then
            self.go_table.aorbtn_explore:SetActiveE(1)
            self.go_table.aorbtn_explore1:SetActiveE(0)
            self.go_table.aorbtn_explore2:SetActiveE(0)
            self.go_table.aortext_exploreBtn.text = _G.GetLangPackValue(self.nowEventCfg.btn_desc[1][1])
            self.go_table.obj_eventxh1:SetActiveE(0)
            self.go_table.obj_eventxh2:SetActiveE(0)
        else
            self.go_table.aorbtn_explore:SetActiveE(0)
            self.go_table.aorbtn_explore1:SetActiveE(1)
            self.go_table.aorbtn_explore2:SetActiveE(1)
            self.go_table.aortext_exploreBtn1.text = _G.GetLangPackValue(self.nowEventCfg.btn_desc[1][1])
            self.go_table.aortext_exploreBtn2.text = _G.GetLangPackValue(self.nowEventCfg.btn_desc[1][2])

            local isxh, xhvalue = self:GetStoneXh(1)
            if isxh then
                self.go_table.obj_eventxh1:SetActiveE(1)
                self.go_table.aortext_jewelxh1.text = xhvalue
            else
                self.go_table.obj_eventxh1:SetActiveE(0)
            end

            isxh, xhvalue = self:GetStoneXh(2)
            if isxh then
                self.go_table.obj_eventxh2:SetActiveE(1)
                self.go_table.aortext_jewelxh2.text = xhvalue
            else
                self.go_table.obj_eventxh2:SetActiveE(0)
            end
        end
    else
        self:ShowMultipleView(true)
        self.go_table.aorbtn_explore:SetActiveE(1)
        self.go_table.aorbtn_explore1:SetActiveE(0)
        self.go_table.aorbtn_explore2:SetActiveE(0)
        self.go_table.aortext_exploreBtn.text = _G.GetLangPackValue(90033500055)
        self.go_table.obj_eventxh1:SetActiveE(0)
        self.go_table.obj_eventxh2:SetActiveE(0)
    end
end

function RelicView:InitMultipleIndex()
    self.multipleIndex = RelicTeamModel:GetMultipleIndex()
    local index = self.multipleIndex
    for i = self.multipleIndex, 2, -1 do 
        if RelicTeamModel:GetEventEnergy() * self.multipleList[index] > RelicTeamModel:GetEnergy() then 
            index = index - 1
        end
    end
    if index ~= self.multipleIndex then 
        self:SetMultiple(index)
    else 
        self:SetMultipleView()
    end
end

function RelicView:ShowMultipleView(bol)
    if RelicTeamModel:GetNowLayer() ~= 3 then 
        self.go_table.obj_times:SetActiveE(0)
        return 
    end
    self.go_table.obj_times:SetActiveE(bol and 1 or 0)
    if bol then 
        self:InitMultipleIndex()
    end
end

---倍率
function RelicView:SetMultipleView()
    local num = self.multipleList[self.multipleIndex]
    self.go_table.aortext_times.text = _G.GetLangPackValue(90032800024, num)

    self.go_table.aorbtn_sub:SetGray(self.multipleIndex == 1)
    self.go_table.aorbtn_add:SetGray(self.multipleIndex == #self.multipleList)
    if self.multipleIndex ~= #self.multipleList and self.multipleEventNumList[self.multipleIndex + 1] > RelicTeamModel:GetFinishEventNumInNowLayer() then 
        self.go_table.aorbtn_add:SetGray(true)
    end
    self:ShowEventEnergyCostTxt()
end

--刷新当前事件
function RelicView:FreshNowEvent(initBol)
    self:FreshEventData()
    self:ChangeExploreBtnTxt()
    if not self.curSceneTrans then
        self:InitScene(function()
            self:FreshEventModel(initBol)
        end)
    else
        self:FreshEventModel(initBol)
    end
end

function RelicView:StopTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.energyTimer then
        self.energyTimer:Stop()
        self.energyTimer = nil
    end
end

function RelicView:UpdateTime(elapsed)
    self.countDown = self.countDown - elapsed
    if self.countDown < 0 then
        self.countDown = 0
        self.go_table.obj_team:SetActiveE(0)
    end
    if self.go_table == nil then
        return
    end
    local time = _G.Mathf.RoundToInt(self.countDown)
    self.go_table.aortext_teamTime.text =
        _G.GetLangPackValue(90028900002, _G.string.AddColor(_G.TimeUtil.TranslateSecondForStrSixVsSix(time), "96ce51"))
end

function RelicView:OnDestroy()
    self:RemoveAllListener() --todo 这个移除没用
    self:StopTimer()
    if self.doTween then
        for k, v in ipairs(self.doTween) do
            v:Kill()
        end
        self.doTween = nil
    end
    self.RoleAni = {}
    if self.curSceneTrans then
        _G.PoolsManager:GetInstance():Despawn(self.curSceneTrans, _G.ePoolType.Static)
        self.curSceneTrans = nil
    end
    if self.Role then
        for k, v in pairs(self.Role) do
            _G.DestroyObject(v)
            self.Role[k] = nil
        end
        self.myModel = nil
    end
    if self.sceneRoot then
        _G.DestroyObject(self.sceneRoot)
        self.sceneRoot = nil
    end
    if self.boxEffect then
        _G.DestroyObject(self.boxEffect)
        self.boxEffect = nil
    end
    if self.PlayPngResRef ~= nil then 
        self.PlayPngResRef:Release()
    end
    self.initBossBol = nil
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name)
    _G.Events:GetInstance():RemoveListener(_G.eRelicTeam.RelicTeamAttacked, self.AttackedPushCall, self)
    _G.Events:GetInstance():RemoveListener(_G.eRelicTeam.RelicTeamFall, self.AttackedPushCall, self)
    _G.Events:GetInstance():RemoveListener(_G.eRelicTeam.RelicTeamUpdateEnergy, self.FreshEnergy, self)
    _G.Events:GetInstance():RemoveListener(_G.eRelicTeam.RelicTeamUpdateTeamJewel, self.FreshMemberJewel, self)
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.UpdateView, self)
end

---按钮点击事件在这里派发
function RelicView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_embattle then
        if _G.MainManager:GetInstance():IsFighting(true) then
            return
        end
        RelicTeamModel:OnChallenge(true)
    elseif go == self.go_table.aorbtn_battleInfo then
        self:OpenBattleInfoView()
        RelicTeamModel:ClearAttackedBol()
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RelicTeamAttacked.id)
    elseif go == self.go_table.aorbtn_go then
        if _G.table.isEmptyOrNil(self.teamInfo) then
            if not RelicTeamModel:CheckArray() then
                _G.PopWindowManager:GetInstance():ShowAllTips(1070016)
                return
            end
            local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.RelicTeamToggleView.Name)
            ctrl:SwitchToggle("team")
        else
            if self.status == RelicTeamModel.relicStatus.settle then
                _G.PopWindowManager:GetInstance():ShowAllTips(1070021, _G.GetLangPackValue(90026100053))
            elseif self.status ~= RelicTeamModel.relicStatus.explore then
                _G.PopWindowManager:GetInstance():ShowAllTips(1070021)
            else
                if not RelicTeamModel:CheckArray() then
                    _G.PopWindowManager:GetInstance():ShowAllTips(1070016)
                    return
                end
                if _G.MainManager:GetInstance():IsFighting(true) then
                    return
                end
                local nowtime = _G.TimeUtil.GetServerUnixTime()
                local savetime = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.RelicTeamDebuffTips)
                local todayTime = _G.TimeUtil.GetDayBySix(nowtime)
                local isChoose = savetime == todayTime
                if not isChoose and RelicTeamModel:CheckShowArrayTips() then
                    _G.PopWindowManager:GetInstance():ShowAllTips(1070003, nil, function(isChoose)
                        if isChoose then
                            _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.RelicTeamDebuffTips, todayTime)
                        end
                        self:GoRelic()
                    end)
                    return
                end
                self:AnimOut(_G.handler(self, self.ShowEventView))
            end
        end
    elseif go == self.go_table.aorbtn_serverList then
        require("RelicTeamNet"):GetInstance():GetServerList(
            function(data)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicTeamServerListView.Name, data)
            end
        )
    elseif go == self.go_table.aorbtn_drop then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MiningRewardView.Name)
    elseif go == self.go_table.aorbtn_bag then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicTeamBuffBagView.Name)
    elseif go == self.go_table.aorbtn_tips then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 169)
    elseif go == self.go_table.aorbtn_explore then
        if not self.finishEventAnimBol then
            if not RelicTeamModel:CheckHaveEventNow() then
                if not RelicTeamModel:CheckArray() then
                    _G.PopWindowManager:GetInstance():ShowAllTips(1070016)
                    return
                end
                if not RelicTeamModel:CheckEventEnergyEnough() then
                    self:UseEnergyItem(_G.handlerbind(self, self.ShowEnergyTimeTips, true))
                    return
                end
                RelicTeamModel:NextEvent( function()
                    if self:IsNil() then
                        return
                    end
                    self:FreshEventData()
                    self:ShowEventAnim()
                    self:FreshEnergy()
                end)
            else
                self:FinishEvent()
            end
        end
    elseif go == self.go_table.aorbtn_explore1 then
        local isxh, xhvalue = self:GetStoneXh(1)
        if isxh then
            local jw = RelicTeamModel:GetJewel()
            if jw < xhvalue then
                _G.PopWindowManager:GetInstance():ShowAllTips(1070030)
            else
                self:FinishEvent(1)
            end
        else
            self:FinishEvent(1)
        end
    elseif go == self.go_table.aorbtn_explore2 then
        local isxh, xhvalue = self:GetStoneXh(2)
        if isxh then
            local jw = RelicTeamModel:GetJewel()
            if jw < xhvalue then
                _G.PopWindowManager:GetInstance():ShowAllTips(1070030)
            else
                self:FinishEvent(2)
            end
        else
            self:FinishEvent(2)
        end
    elseif go == self.go_table.aorbtn_next then
        if RelicTeamModel:CheckHaveEventNow() then
            _G.PopWindowManager:GetInstance():ShowAllTips(1070025)
            return
        end
        if RelicTeamModel:CheckCanNextLayer() then
            local sure = function()
                RelicTeamModel:NextLayer(_G.handlerbind(self, self.AnimOut, _G.handler(self, self.ShowEventView)))
            end
            _G.PopWindowManager:GetInstance():ShowAllTips(1070001, nil, sure)
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(1070016, _G.GetLangPackValue(90033500193))
        end
    elseif go == self.go_table.aorbtn_addEnergy then
        self:UseEnergyItem()
    elseif go == self.go_table.aorbtn_energyTips then
        self:ShowEnergyTimeTips(true)
    elseif go == self.go_table.aorbtn_closeEnergyTips then
        self:ShowEnergyTimeTips(false)
    elseif go == self.go_table.aorbtn_headAdd1 or go == self.go_table.aorbtn_headAdd2 or go == self.go_table.aorbtn_headAdd3 then
        if not RelicTeamModel:CheckArray() then
            _G.PopWindowManager:GetInstance():ShowAllTips(1070016)
            return
        end
        local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.RelicTeamToggleView.Name)
        ctrl:SwitchToggle("team")
    elseif go == self.go_table.aorbtn_sub then
        if self.multipleIndex == 1 then
            return
        end
        self:SetMultiple(self.multipleIndex - 1)
    elseif go == self.go_table.aorbtn_add then
        if self.multipleIndex == #self.multipleList then
            return
        end
        if self.multipleEventNumList[self.multipleIndex + 1] > RelicTeamModel:GetFinishEventNumInNowLayer() then 
            if self.multipleIndex + 1 == 2 then 
                _G.PopWindowManager:GetInstance():ShowAllTips(1070033)
            elseif self.multipleIndex + 1 == 3 then 
                _G.PopWindowManager:GetInstance():ShowAllTips(1070034)
            end
            return 
        end
        self:SetMultiple(self.multipleIndex + 1)
    end
end

