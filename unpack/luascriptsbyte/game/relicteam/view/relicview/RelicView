function RelicView:InitScene(initCall)
    --_G.GameUtil.ReBuildRTF(self.go_table.rect_moveRoot)
    self.Role = {}
    self.RoleAni = {}
    self.sceneRoot = _G.GameObject("RelicTeamRoot")
    local path = "Scenes/Gonghuizhudi/prefabs/Gushenyiji"
    --_G.UIManager:GetInstance():SetWorldSceneHideTimes(1)
    _G.PoolsManager:GetInstance():Spawn(
        path,
        _G.ePoolType.Static,
        self.sceneRoot,
        function(trans)
            if _G.IsNil(self.sceneRoot) then
                _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.Static)
                return
            end
            trans:ChangeCameraAdaption()
            self.curSceneTrans = trans
            trans:SetLocalPositionToZero()
            _G.TimerManager:GetInstance():GetTimer(1, self.InitRoleModel, self, true, true):Start()
            _G.GraphicsManager.Instance:UpdateMainCameraPosImmediate()
            --相机高度降低固定值
            self.camera =
                self.curSceneTrans:FindE("Environment/Parent/Main Camera"):GetComponentE(
                    _G.typeof(_G.CS.FrameWork.Graphic.VisualCamera)
                )
            self.bgObj = {}
            self.bgObj[1] = self.curSceneTrans:FindE("Scene/static/fbx_Gonghuizhudi_01")
            local meshRenderer = self.bgObj[1]:GetComponentE(
                _G.typeof(_G.CS.UnityEngine.MeshRenderer)
            )
            _G.ResourcesManager:GetInstance():LoadTexture(
                self.relicCfg.map_bg,
                function(texture, resRef)
                    if self:IsNil() then
                        if resRef ~= nil then
                            resRef:Release()
                        end
                        return
                    end
                    self.PlayPngResRef = resRef
                    meshRenderer.material.mainTexture = texture
                end,
                self
            )

            if initCall then
                initCall()
            end
        end
    )
end

