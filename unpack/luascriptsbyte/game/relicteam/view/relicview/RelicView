--显示获得buff特效
function RelicView:ShowBuffEffect(data)
    local bol
    local buffT = {}
    for k, v in ipairs(data) do
        local Sid = v.sid
        while (Sid > 1000) do
            Sid = Sid / 10
        end
        Sid = _G.math.floor(Sid)
        if Sid == _G.ItemSidJudgeSection.RelicTeamBuff then
            bol = true
            table.insert(buffT, { sid = v.sid, num = v.number })
        end
    end
    if bol then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_tuanduibuff,
            self.myModel.item,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                self.effect = trans
                self.effect:SetLocalPositionToZero()
                trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
            end,
            function()
                if self:IsNil() then
                    return
                end
                self:ShowPowerUp(buffT)
                RelicTeamModel:CheckSelfRank(require("RankUtils").RankType.AncientGodPersonalPoints)
                RelicTeamModel:CheckSelfRank(require("RankUtils").RankType.AncientGodAllianceTeam)
            end
        )
    else
        RelicTeamModel:CheckSelfRank(require("RankUtils").RankType.AncientGodPersonalPoints)
        RelicTeamModel:CheckSelfRank(require("RankUtils").RankType.AncientGodAllianceTeam)
    end
    self:CheckUpLayerWindow()
end

--战斗力提升飘字动画
function RelicView:ShowPowerUp(buffT)
    RelicTeamModel:UpdateMyTeamPower()
    self:FreshMyPower()
    local nowMyPower = RelicTeamModel:GetTeamRoleInfo(_G.PlayerModel:GetInstance():GetPlayerUid()).power
    local ratio = 0
    for k, v in ipairs(buffT) do
        ratio = _G.ConfigManager.relic_effect_cfg[v.sid].power / 10000 * v.num + ratio
    end
    local addPower = math.floor(RelicTeamModel:GetMyTeamPowerNoBuff() * ratio)
    require("CommonTipManager").OpenPowerUpView(nowMyPower - addPower, addPower, true)
end

--完成事件
function RelicView:FinishEvent(chooseNum)
    if not RelicTeamModel:CheckArray() then
        _G.PopWindowManager:GetInstance():ShowAllTips(1070016)
        return
    end
    if self.lockFinishEventBtnBol then
        return
    end
    self.lockFinishEventBtnBol = true
    if self.nowEventCfg.event_type == 1 then
        RelicTeamModel:SetNowFightType(1)
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_shizizhan,
            self.curSceneTrans:FindE("Scene/static/fbx_Gonghuizhudi_01/2"),
            function(trans)
                self.effect = trans
                self.effect:SetLocalPosition(0, -0.77, -1.03)
                trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
            end,
            function(trans)
                local T = { args = {}, c_layer = RelicTeamModel:GetNowLayer() }
                RelicTeamModel:FinishEvent(T, function(msg)
                    self:FinishEventCallBack(msg)
                end)
            end
        )
        --RelicTeamModel:Fight()
    elseif self.nowEventCfg.event_type <= 2 then
        RelicTeamModel:SetNowFightType(2)
        RelicTeamModel:Fight(self.nowEventCfg.event_type)
    elseif self.nowEventCfg.event_type <= 3 then
        RelicTeamModel:SetNowFightType(3)
        RelicTeamModel:OnChallenge()
    elseif self.nowEventCfg.event_type == 6 then
        local T = { args = { chooseNum }, c_layer = RelicTeamModel:GetNowLayer() }
        RelicTeamModel:FinishEvent(T, function(msg)
            self:FinishEventCallBack(msg)
        end)
    elseif self.nowEventCfg.event_type == 4 then
        local T = { args = {}, c_layer = RelicTeamModel:GetNowLayer() }
        if self.boxEffect then
            local id = self.nowEventCfg.id
            id = math.floor(id / 100) % 10
            local name = id == 3 and "ani_baoxiangbaokai_open" or "ani_baoxiangbaokaiputong_open"
            self.boxEffect:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator)):Play(name)
            _G.DelayDo(
                1,
                function()
                    RelicTeamModel:FinishEvent(T, function(msg)
                        if msg.ack == 1 then
                            self:FinishEventCallBack(msg)
                            if self.boxEffect then
                                _G.DestroyObject(self.boxEffect)
                                self.boxEffect = nil
                            end
                        end
                    end)
                end
            )
        end
    else
        local T = { args = {}, c_layer = RelicTeamModel:GetNowLayer() }
        RelicTeamModel:FinishEvent(T, function(msg)
            self:FinishEventCallBack(msg)
        end)
    end
end

function RelicView:SetLockFinishEventBtnBol(bol)
    self.lockFinishEventBtnBol = bol
end

function RelicView:FinishEventCallBack(msg)
    if msg.ack ~= 1 then
        return
    end
    if self:IsNil() then
        return
    end
    if not _G.table.isEmptyOrNil(RelicTeamModel:GetEventArgs().award) then
        _G.DelayDo(0.5, function()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name,
                RelicTeamModel:GetEventArgs(), _G.handler(self, self.ShowBuffEffect),
                nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, { relicTeamSortBol = true })
        end)
    else
        self:CheckUpLayerWindow()
        RelicTeamModel:CheckSelfRank(require("RankUtils").RankType.AncientGodPersonalPoints)
        RelicTeamModel:CheckSelfRank(require("RankUtils").RankType.AncientGodAllianceTeam)
    end
    self:ShowEventView()
end

