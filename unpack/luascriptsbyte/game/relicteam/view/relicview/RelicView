    local msg = {}
    msg.multiple = self.multipleList[multipleIndex]
    RelicTeamModel:SetMultiple(msg, function(msg)
        if msg.ack == 1 then 
            self.multipleIndex = RelicTeamModel:GetMultipleIndex()
