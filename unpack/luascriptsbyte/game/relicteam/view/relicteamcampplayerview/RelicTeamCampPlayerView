local RelicTeamModel 
---@class RelicTeamCampPlayerView : UIBaseView    中文描述
---@field public go_table RelicTeamCampPlayerView_GoTable GoTable
local RelicTeamCampPlayerView = _G.BaseClass("RelicTeamCampPlayerView", _G.UIBaseView)


local IconName = {
    [1] = "0ui_icon_diyi",
    [2] = "0ui_icon_dier",
    [3] = "0ui_icon_disan",
}

local Gradient = {
    [1] = { "FFCB28", "ffffff", "110802" },
    [2] = { "E930FF", "ffffff", "110802" },
    [3] = { "1F7296", "ffffff", "110802" },
}

---构造函数
---@protected
function RelicTeamCampPlayerView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function RelicTeamCampPlayerView:OnCreate(type)
    self.campType = type
    RelicTeamModel = require("RelicTeamModel"):GetInstance()
    require("RelicTeamNet"):GetInstance():GetCampRole(
        { camp = type, page = 1 },
        function(data)
            if self:IsNil() then
                return
            end
            self:Show(data)
        end
    )
    local campName = RelicTeamModel:GetCampName(self.campType)
    self.go_table.aortext_des.text = _G.GetLangPackValue(90033400051, campName)
end

function RelicTeamCampPlayerView:Show(data)
    self.ItemList = {}
    self.Ranks = data.role_info or {}
    self:SetSelfInfo()
    local len = #self.Ranks
    self.go_table.scrollloopvectical_memberList:InitItemData(len, _G.handler(self, self.OnRefreshLoopListItem))
end

function RelicTeamCampPlayerView:SetSelfInfo()
    if self.selfRank == nil then
        self.selfRank = _G.GetAutoGoTable(self.go_table.obj_selfRank)
    end
    local selfRankNum = #self.Ranks > 0 and 100000 or 1
    local uid = _G.PlayerModel:GetInstance():GetPlayerUid()
    local myPower = _G.PlayerModel:GetInstance():GetCorePower()
    for k, v in ipairs(self.Ranks) do
        if myPower >= v.power then
            selfRankNum = k
            selfRankNum = selfRankNum < 1 and 1 or selfRankNum
            break
        end
    end
    local myRankData = _G.PlayerModel:GetInstance():GetIRroleTable(true)
    myRankData.power = myPower
    if #self.Ranks < 100 and selfRankNum > 100 then 
        selfRankNum = #self.Ranks + 1
        table.insert(self.Ranks, myRankData)
    elseif selfRankNum ~= 100000 then 
        self.selfRank.aortext_rank.text = selfRankNum
        table.insert(self.Ranks, selfRankNum, myRankData)
    end
    self.selfRank.aortext_name.text = _G.PlayerModel:GetInstance():GetName()
    self.selfRank.aortext_desc.text = _G.GameUtil.NumberToUnitStr(_G.PlayerModel:GetInstance():GetCorePower())
    self.selfRank.aortext_rank:SetActiveE(selfRankNum == 100000 and 0 or 1)
    self.selfRank.aortext_nil:SetActiveE(selfRankNum == 100000 and 1 or 0)
    _G.UIUtils.SetPlayerHeadItemNew(self.selfRank.obj_head, _G.PlayerModel:GetInstance():GetIRroleTable(), 1, true, true, true)
end

---@param looplist2 SuperScrollView.LoopListView2
---@param i number
function RelicTeamCampPlayerView:OnRefreshLoopListItem(i, item)
    if i < 0 then
        return
    end

    local eIndex = i + 1
    local id = item:GetInstanceIDE()
    local ctrl = self.ItemList[id]
    if not ctrl then
        ctrl = _G.GetAutoGoTable(item)
        self.ItemList[id] = ctrl
    end
    ctrl.index = eIndex
    local data = self.Ranks[eIndex]
    if data then
        ctrl.aortext_name.text = data.name
        ctrl.aorimage_rankBg:SetActiveE(eIndex <= 3 and 1 or 0)
        ctrl.aortext_Rank:SetActiveE(eIndex <= 3 and 1 or 0)
        ctrl.aortext_rank:SetActiveE(eIndex <= 3 and 0 or 1)
        self:SetItemRankInfo(ctrl, eIndex)
        if eIndex <= 3 then
            ctrl.aorimage_bg:SetActiveE(1)
            ctrl.aorimage_bg.SpriteName = "ui_diban" .. eIndex
        else
            ctrl.aorimage_bg:SetActiveE(0)
        end
        ctrl.aortext_desc.text = _G.GameUtil.NumberToUnitStrFight(data.power)
        _G.UIUtils.SetPlayerHeadItemNew(ctrl.obj_head, data, 1, true, true, true)
    end
    return item
end

function RelicTeamCampPlayerView:SetItemRankInfo(go, index)
    local ctrl = go
    local eIndex = index
    if eIndex <= 3 then
        ctrl.aorimage_rankBg.SpriteName = IconName[eIndex]

        ctrl.aortext_Rank.text = eIndex
        local gradient = ctrl.aortext_Rank:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient))
        local c1 = _G.ColorTools.FormatColorByString(Gradient[eIndex][1])
        local c2 = _G.ColorTools.FormatColorByString(Gradient[eIndex][2])
        local color1 = _G.CS.UnityEngine.GradientColorKey()
        local color2 = _G.CS.UnityEngine.GradientColorKey()
        color1.color = c1
        color1.time = 1
        color2.color = c2
        color2.time = 0

        local alpha1 = _G.CS.UnityEngine.GradientAlphaKey()
        local alpha2 = _G.CS.UnityEngine.GradientAlphaKey()

        alpha1.alpha = 255
        alpha1.time = 1
        alpha2.alpha = 255
        alpha2.time = 0

        gradient:GetGradient():SetKeys({ color1, color2 }, { alpha1, alpha2 })
    else
        ctrl.aortext_rank.text = eIndex
    end
end

---界面的销毁函数
function RelicTeamCampPlayerView:OnDestroy()
end

---按钮点击事件在这里派发
function RelicTeamCampPlayerView:OnClickBtn(go)
    if go == self.go_table.aorbtn_Close or go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

return RelicTeamCampPlayerView