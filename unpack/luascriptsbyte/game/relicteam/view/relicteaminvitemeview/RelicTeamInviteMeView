---@class RelicTeamInviteMeView : UIBaseView  下边栏菜单
---@field go_table RelicTeamInviteMeView_GoTable
local RelicTeamInviteMeView = _G.BaseClass("RelicTeamInviteMeView", _G.UIBaseView)
local RelicTeamModel

function RelicTeamInviteMeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function RelicTeamInviteMeView:OnCreate()
    RelicTeamModel = require "RelicTeamModel":GetInstance()
    self:GetInfo()
end

---刷新数据
function RelicTeamInviteMeView:FreshData()
    self.teamInviteList = RelicTeamModel:GetTeamInviteList()
    self.status, self.nextTime = RelicTeamModel:GetStatusAndNextTimeLine()
end

function RelicTeamInviteMeView:UpdateView()
    if self:IsNil() then
        return
    end
    self:FreshData()
    if not self.init then
        self.go_table.scrollloopvectical_teamList:InitItemData(0, _G.handler(self, self.RefreshList))
        self.go_table.scrollloopvectical_teamList:UpdateCount(#self.teamInviteList)
        self.init = true
    else
        self.go_table.scrollloopvectical_teamList:UpdateCount(#self.teamInviteList)
        self.go_table.scrollloopvectical_teamList:UpdateAllItem()
    end
    self.go_table.obj_refuse:GetComponentE(_G.typeof(_G.CS.ExtendText)).text = string.format("<%s@1>", _G.GetLangPackValue(90033500061))
end

function RelicTeamInviteMeView:RefreshList(index, obj)
    local data = self.teamInviteList[index + 1]
    local tb = _G.GetAutoGoTable(obj)
    tb["_onclick"] = _G.handlerbind(self, self.ClickItemBtn, tb, data)
    RelicTeamModel:SetTeamHeadItem(tb.obj_headTable, data, 1)
    tb.aortext_name.text = _G.GetLangPackValue(90033500125, data.name) 
    tb.aortext_power.text = _G.UIUtils.NumberToUnitStr_CardFightNum(data.power, true)
end

function RelicTeamInviteMeView:ClickItemBtn(go, isOn, tb, data)
    if go == tb.aorbtn_agree then
        local msg = {}
        msg.type = 1
        msg.uid = {data.uid}
        RelicTeamModel:CheckInvite(msg, _G.handlerbind(self, self.AcceptCallBack, msg))
    end
end

function RelicTeamInviteMeView:GetInfo()
    RelicTeamModel:GetTeamInviteListFromServer(_G.handler(self, self.UpdateView))
end

---按钮点击事件在这里派发
function RelicTeamInviteMeView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_refuse then 
        local msg = {}
        msg.type = 0
        msg.uid = {}
        for k, v in ipairs(self.teamInviteList) do 
            table.insert(msg.uid, v.uid)
        end
        if #msg.uid == 0 then 
            return 
        end
        RelicTeamModel:CheckInvite(msg, _G.handlerbind(self, self.UpdateView))
    end
end

function RelicTeamInviteMeView:AcceptCallBack()
    if self:IsNil() then
        return
    end
    if RelicTeamModel:GetTeamInfo() then 
        --_G.Events:GetInstance():Broadcast(_G.eRelicTeam.RelicTeamUpdateTeam, {state = -1})
        _G.Events:GetInstance():Broadcast(_G.eRelicTeam.RelicTeamRefresh)
        self:Close()
    end 
end

function RelicTeamInviteMeView:OnDestroy()
    self:RemoveAllListener()
end

return RelicTeamInviteMeView
