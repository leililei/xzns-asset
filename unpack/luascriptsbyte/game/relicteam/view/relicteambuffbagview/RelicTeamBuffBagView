---@class RelicTeamBuffBagView : UIBaseView  下边栏菜单
---@field go_table RelicTeamInviteMeView_GoTable
local RelicTeamBuffBagView = _G.BaseClass("RelicTeamBuffBagView", _G.UIBaseView)
local RelicTeamModel

local attNameT = {
    [1] = "atk",
    [2] = "max_hp",
    [3] = "def",
    [4] = "bre"
}
function RelicTeamBuffBagView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function RelicTeamBuffBagView:OnCreate()
    RelicTeamModel = require "RelicTeamModel":GetInstance()
    self:UpdateView()
end

---刷新数据
function RelicTeamBuffBagView:FreshData()
    self.buffList = RelicTeamModel:GetBuffCount()
end

function RelicTeamBuffBagView:UpdateView()
    self:FreshData()
    for i = 1, 4 do 
        self.go_table["aortext_attr" .. i].text = RelicTeamModel:GetBuffAttNum(attNameT[i])
    end
    if not self.init then
        self.go_table.scrollloopvectical_item:InitItemData(#self.buffList, _G.handler(self, self.RefreshList))
        --self.go_table.scrollloopvectical_item:UpdateCount(#self.buffList)
        self.init = true
    else
        self.go_table.scrollloopvectical_item:UpdateCount(#self.buffList)
        self.go_table.scrollloopvectical_item:UpdateAllItem()
    end
end

function RelicTeamBuffBagView:RefreshList(index, obj)
    local data = self.buffList[index + 1]
    local tb = _G.GetAutoGoTable(obj)
    tb.obj_item:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseView(
        data.key,
        data.value,
        tb.obj_item,
        function(item)
            if _G.IsNil(self.go_table) then
                _G.DestroyObject(item.go_table.gameObject)
                return
            end
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end
    )
end

---按钮点击事件在这里派发
function RelicTeamBuffBagView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or self.go_table.aorbtn_CloseView then
        self:Close()
    end
end
function RelicTeamBuffBagView:OnDestroy()
    self:RemoveAllListener()
end

return RelicTeamBuffBagView
