---@class RelicTeamServerListView : UIBaseView  下边栏菜单
---@field go_table RelicTeamInviteMeView_GoTable
local RelicTeamServerListView = _G.BaseClass("RelicTeamServerListView", _G.UIBaseView)
local RelicTeamModel 
function RelicTeamServerListView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function RelicTeamServerListView:OnCreate(data)
    self.serverList = data.server_list or {}
    self:UpdateView()
end

function RelicTeamServerListView:UpdateView()
    if not self.init then
        self.go_table.scrollloopvectical_item:InitItemData(#self.serverList, _G.handler(self, self.RefreshList))
        --self.go_table.scrollloopvectical_item:UpdateCount(#self.buffList)
        self.init = true
    else
        self.go_table.scrollloopvectical_item:UpdateCount(#self.serverList)
        self.go_table.scrollloopvectical_item:UpdateAllItem()
    end
end

function RelicTeamServerListView:RefreshList(index, obj)
    local data = self.serverList[index + 1]
    local tb = _G.GetAutoGoTable(obj)
    tb.aortext_name.text = _G.ServerManager:GetInstance():GetServerNameByServerID(data)
end

---按钮点击事件在这里派发
function RelicTeamServerListView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or self.go_table.aorbtn_CloseView then
        self:Close()
    end
end
function RelicTeamServerListView:OnDestroy()
    self:RemoveAllListener()
end

return RelicTeamServerListView
