---@class RelicTeamBattleInfoView : UIBaseView  下边栏菜单
---@field go_table RelicTeamBattleInfoView_GoTable
local RelicTeamBattleInfoView = _G.BaseClass("RelicTeamBattleInfoView", _G.UIBaseView)
local RelicTeamModel

function RelicTeamBattleInfoView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function RelicTeamBattleInfoView:OnCreate()
    RelicTeamModel = require "RelicTeamModel":GetInstance()
    self:UpdateView()
end

function RelicTeamBattleInfoView:FreshData()
    self.battleInfoMine, self.battleInfoAll, self.layerNum = RelicTeamModel:GetBattleInfo()
end

function RelicTeamBattleInfoView:UpdateView()
    self:FreshData()
    self.showType = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.RelicTeamBattleInfoShowType, 1)
    self.go_table.obj_showMine:SetActiveE(self.showType == 2 and 1 or 0)
    self.infoList = self.showType == 1 and self.battleInfoAll or self.battleInfoMine
    _G.table.sort(self.infoList, function(a, b)
        return a.time < b.time
    end)
    if not self.IsFirst then
        self.go_table.looplist2_infoList:InitListView(0, _G.handler(self, self.RefreshList))
        self.IsFirst = true
        self.go_table.looplist2_infoList:SetListItemCount(#self.infoList, true)
    else 
        if #self.battleInfoAll == #self.battleInfoMine then 
            self.go_table.looplist2_infoList:MovePanelToItemIndex(0)
        else
            self.go_table.looplist2_infoList:SetListItemCount(#self.infoList, true)
        end
    end
    
    --self.go_table.looplist2_infoList:RefreshAllShownItem()
    --self.go_table.looplist2_infoList:MovePanelToItemIndex(0)
    for key, value in ipairs(self.layerNum) do
        self.go_table["aortext_layerNum" .. value.k].text = _G.GetLangPackValue(90033500124, value.v)
    end
    for i = 1, 3 do
        self.go_table["aortext_layerName" .. i].text = RelicTeamModel:GetRelicName() .. _G.GetLangPackValue(90037010103, i)
    end
end

---刷新列表
function RelicTeamBattleInfoView:RefreshList(listView2, index)
    if index < 0 then
        return
    end
    local data = self.infoList[#self.infoList - index]
    local cfg = _G.ConfigManager.relic_report_cfg[data.type]
    local awardData
    local txt
    local seasonId = RelicTeamModel:GetIDNow()
    if cfg.condition then
        local hp = tonumber(data.des[#data.des])
        for k, v in ipairs(cfg.endurance) do
            if v == hp then
                txt = _G.GetLangPackValue(cfg.report_desc[seasonId][k], _G.SafeUnpack(data.des))
            end
        end
    else
        txt = _G.GetLangPackValue(cfg.report_desc[seasonId][1], _G.SafeUnpack(data.des))
    end
    local t = _G.TimeUtil.GetDateTime(data.time)
    txt = _G.GetLangPackValue(90033500258, _G.string.format("%02d:%02d:%02d", t.hour, t.minute, t.second), txt)
    self.go_table.aortext_event.text = txt
    if data.add_gem ~= nil or data.award ~= nil then
        awardData = _G.StorageManager:GetInstance():MergeAward(data)
        for i, v in ipairs(awardData) do
            local grade = _G.StorageManager:GetInstance():GetItemGrade(v[1])
            v[3] = grade
            v[4] = _G.ConfigManager.relic_effect_cfg[v[1]]
        end
        _G.table.sort(
            awardData,
            function(a, b)
                local cfgA = a[4]
                local cfgB = b[4]
                if cfgA and not cfgB then
                    return true
                elseif not cfgA and cfgB then 
                    return false
                end

                local gradeA = a[3]
                local gradeB = b[3]
                if gradeA == gradeB then
                    return a[1] < b[1]
                end
                return gradeA > gradeB
            end
        )
        awardData = _G.StorageManager:GetInstance():MergeAwardList(awardData)
        _G.table.insert(awardData, 1, { 76, data.add_gem })
    end
    local obj = "$_obj_ListItem1"
    for i = 1, 4 do
        local _, height = self.go_table["obj_ListItem" .. i]:GetRectTransformSize()
        if self.go_table.aortext_event.preferredHeight < (height - 20) then
            if data.add_gem ~= nil or data.award ~= nil then
                local columnCount = math.ceil(#awardData / 7) 
                obj = "$_obj_ListItem" .. i * 10 + columnCount
            else
                obj = "$_obj_ListItem" .. i
            end
            break
        end
    end
    local item = listView2:NewListViewItem(obj)
    local tb = _G.GetAutoGoTable(item)
    tb.aortext_time.text = ""--_G.string.format("%02d:%02d:%02d", t.hour, t.minute, t.second)

    tb.aortext_event.text = txt
    --_G.GameUtil.ReBuildRTF(item)
    --_G.GameUtil.ReBuildRTF(self.go_table.obj_Content)
    if data.add_gem ~= nil or data.award ~= nil then
        local num = math.min(#awardData, 21)
        tb.obj_itemRoot:RemoveAllChildren()
        for i = 1, num do
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                awardData[i],
                tb.obj_itemRoot,
                function(tran)
                    tran.gameObject:SetLocalPosition(0, 0, 0)
                    tran.gameObject:SetLocalScaleXYZ(1)
                    tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
            )
        end
    end
    return item
end

function RelicTeamBattleInfoView:OnDestroy()
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
function RelicTeamBattleInfoView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_showMine then
        self.showType = self.showType == 1 and 2 or 1
        self.go_table.obj_showMine:SetActiveE(self.showType == 2 and 1 or 0)
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.RelicTeamBattleInfoShowType, self.showType)
        self:UpdateView()
    end
end

return RelicTeamBattleInfoView
