---@class RlicTeamTeamMain : UIBaseView  下边栏菜单
---@field go_table RlicTeamTeamMain_GoTable
local RlicTeamTeamMain = _G.BaseClass("RlicTeamTeamMain", _G.UIBaseView)
local RelicTeamModel 

function RlicTeamTeamMain:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    
end

---界面的入口函数
function RlicTeamTeamMain:OnCreate(index)
    RelicTeamModel = require "RelicTeamModel":GetInstance()
    self:FreshData()
    self:InitView()
end

function RlicTeamTeamMain:InitView()
    local state = RelicTeamModel:GetTeamUpdateBol()
    if state == 3 then 
        RelicTeamModel:ClearTeamUpdateBol()
        self:UpdateView()
        return 
    end
    if self.teamInfo or state then 
        self:GetInfo()
    else 
        self:UpdateView()
    end
end

function RlicTeamTeamMain:GetInfo()
    RelicTeamModel:GetTeam(_G.handler(self, self.UpdateView))
end
function RlicTeamTeamMain:FreshData()
    self.teamInfo = RelicTeamModel:GetTeamInfo()
    self.status, self.nextTime = RelicTeamModel:GetStatusAndNextTimeLine()
end

function RlicTeamTeamMain:UpdateView()
    if self:IsNil() then
        return
    end
    self:FreshData()
    if not self.teamInfo and self.status == RelicTeamModel.relicStatus.team then 
        if not self.hallViewLua then
            self.hallViewLua = true
            local params = {}
            _G.PoolsManager:GetInstance():Spawn(
                "UIH5/hRelic/$_obj_RelicTeamHallView",
                _G.ePoolType.Temporary,
                self.go_table.obj_hallView,
                function(tran)
                    if self.go_table == nil then
                        _G.DestroyObject(tran)
                        return
                    end
                    -- local sortOrder = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
                    -- tran:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder = sortOrder + 23
                    self.hallViewLua = self:AddComponent(tran, require("RelicTeamHallView").New(tran, params))
                end
            )
        elseif self.hallViewLua ~= true then
            self.hallViewLua:Show()
        end
        self.go_table.obj_hallView:SetActiveE(1)
        self.go_table.obj_myTeamView:SetActiveE(0)
    else 
        if not self.myTeamViewLua then
            self.myTeamViewLua = true
            local params = {}
            _G.PoolsManager:GetInstance():Spawn(
                "UIH5/hRelic/$_obj_RelicTeamMyTeamView",
                _G.ePoolType.Temporary,
                self.go_table.obj_myTeamView,
                function(tran)
                    if self.go_table == nil then
                        _G.DestroyObject(tran)
                        return
                    end
                    -- local sortOrder = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
                    -- tran:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder = sortOrder + 23
                    self.myTeamViewLua = self:AddComponent(tran, require("RelicTeamMyTeamView").New(tran, params))
                end
            )
        elseif self.myTeamViewLua ~= true then
            self.myTeamViewLua:Show()
        end
        self.go_table.obj_hallView:SetActiveE(0)
        self.go_table.obj_myTeamView:SetActiveE(1)
    end
end

function RlicTeamTeamMain:OnDestroy()
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
function RlicTeamTeamMain:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end

return RlicTeamTeamMain
