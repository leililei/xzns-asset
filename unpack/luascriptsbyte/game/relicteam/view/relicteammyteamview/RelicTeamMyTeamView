---@class RelicTeamMyTeamView : UIBaseView    中文描述
local RelicTeamMyTeamView = _G.BaseClass("RelicTeamMyTeamView", _G.Component)
local RelicTeamModel
local assistIndexT = {
    {2, 3},
    {1, 3},
    {1, 2}
}
function RelicTeamMyTeamView:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end

function RelicTeamMyTeamView:Awake()
end

---界面的入口函数
function RelicTeamMyTeamView:OnCreate()
    RelicTeamModel = require "RelicTeamModel":GetInstance()
    self.cardItemTable = {{}, {}, {}}
    self.assisdCardItemTable = {{}, {}, {}}
    self:UpdateView()
end

---刷新数据
function RelicTeamMyTeamView:FreshData()
    self.teamInfo = RelicTeamModel:GetTeamInfo()
    self.leaderBol = RelicTeamModel:CheckLeader()
    self.status, self.nextTime = RelicTeamModel:GetStatusAndNextTimeLine()
    RelicTeamModel:FreshAssistInfo()
    RelicTeamModel:CalMyPowerByArray()
end

---刷新界面
function RelicTeamMyTeamView:UpdateView()
    self:FreshData()
    self.go_table.aorrawimage_camp:LoadImage(RelicTeamModel:GetCampIma())
    self.go_table.aortext_camp.text = RelicTeamModel:GetCampName()
    self.go_table.aortext_teamPower.text = _G.UIUtils.NumberToUnitStr_CardFightNum(RelicTeamModel:GetTeamPower(), not _G.AppSetting.IsXzns) 
    self.go_table.aortext_teamJewel.text = RelicTeamModel:GetAllJewel()
    self.go_table.aortext_teamRank.text = _G.GetLangPackValue(90033500077, self.teamInfo.rank)  
    self.go_table.aortext_teamName.text = _G.GetLangPackValue(90033500125, self.teamInfo.name)  
    self.go_table.aortext_teamID.text = _G.GetLangPackValue(90033500045, self.teamInfo.uid) 
    local teamBol = self.status == RelicTeamModel.relicStatus.team 
    for i = 1, 3 do 
        local tb = _G.GetAutoGoTable(self.go_table["obj_player" .. i])
        local member = self.teamInfo.member_list[i] 
        if member then
            _G.UIUtils.SetPlayerHeadItemNew(tb.obj_headItem, member.role_info, _G.AppSetting.IsXzns and 1 or 0.8, true)
            local mineBol = member.role_info.uid == _G.PlayerModel:GetInstance():GetPlayerUid()
            tb.gameObject:SetActiveE(1)  
            member.team = member.team or {}
            for k = 1, 5 do 
                if member.team[k] and member.team[k].sid ~= 0 then 
                    if not self.cardItemTable[i][k] then
                        _G.ItemCardFactory:GetInstance():GetItemCard(
                            _G.ItemCardFactory.itemCardType.CardAllItem,
                            tb["obj_card" .. k],
                        function(item)
                            if not self.go_table then
                                _G.DestroyObject(item.gameObject)
                                return
                            end
                            self.cardItemTable[i][k] = item
                            local cardData = _G.CardData.New()
                            cardData:Parse(member.team[k])
                            cardData:SetLevel(300)
                            item:ShowCardData(cardData, _G.handlerbind(self, self.ShowCardInfo, member.role_info.uid, member.team[k].uid))
                            item.gameObject:SetLocalScaleXYZ(1)
                        end
                        )
                    else
                        local cardData = _G.CardData.New()
                        cardData:Parse(member.team[k])
                        cardData:SetLevel(300)
                        self.cardItemTable[i][k]:ShowCardData(cardData, _G.handlerbind(self, self.ShowCardInfo, member.role_info.uid, member.team[k].uid))
                    end
                else 
                    if self.cardItemTable[i][k] then
                        self.cardItemTable[i][k].gameObject:SetActiveE(0)
                    end 
                end 
            end
            tb.aortext_name.text = member.role_info.name
            if mineBol then 
                tb.aortext_name.text =  _G.string.AddColor(member.role_info.name, "086411") 
            end
            local power = teamBol and member.role_info.power or member.power
            tb.aortext_power.text = _G.UIUtils.NumberToUnitStr_CardFightNum(power, not _G.AppSetting.IsXzns)
            tb.aorbtn_kickOut:SetActiveE((self.leaderBol and not mineBol) and 1 or 0)
            self:FreshAssist(i)
            tb["_onclick"] = _G.handlerbind(self, self.ClickItemBtn, tb, member)
            self.go_table["aorbtn_add" .. i]:SetActiveE(0)
        else 
            tb.gameObject:SetActiveE(0)
            self.go_table["aorbtn_add" .. i]:SetActiveE(1)
            -- if teamBol then 
            --     self.go_table["aorbtn_add" .. i]:SetActiveE(1)
            -- else 
            --     self.go_table["aorbtn_add" .. i]:SetActiveE(0)
            -- end
        end
    end
    
    if teamBol then 
        self.countDown = self.nextTime - _G.TimeUtil.GetServerUnixTime()
        self:UpdateTime(0)
        self:StopTimer()
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.timer:Start()
    end 
    self.go_table.aorbtn_setting:SetActiveE(self.leaderBol and 1 or 0)
    self.go_table.aortext_teamTime:SetActiveE(teamBol and 1 or 0)
    -- self.go_table.aorbtn_quit:SetActiveE(teamBol and 1 or 0)
    -- self.go_table.aorbtn_request:SetActiveE(teamBol and 1 or 0)
    -- self.go_table.aorbtn_share:SetActiveE(teamBol and 1 or 0)
end

--卡牌展示
function RelicTeamMyTeamView:ShowCardInfo(uid, c_uid)
    --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonIllustrationsH5View.Name, cardData.sid, nil ,nil, cardData)
    local pbData = {uid = uid, c_uid = c_uid}
    RelicTeamModel:GetCardInfo(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                if _G.AppSetting.Debug then
                    _G.LogError("获取卡牌信息异常")
                end
                return
            end
            local cardData = require("CardData").New()
            local card = msg.card
            cardData:Parse(card)
            cardData:SetSkin(msg.card.skin)
            --不使用玩家自身的皮肤数据
            cardData.skinIs = false
            cardData:SaveEquipmentData(card, true)
            cardData:SaveDecorationData(card, true)
            if not _G.AppSetting.IsOverseas then
                cardData:SaveArtifactData(card, true)
                cardData:SaveSpiritualData(card, true)
            end
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonIllustrationsH5View.Name, cardData.sid, nil ,nil, cardData, nil, nil, true)
        end
    )
end

--刷新援助
function RelicTeamMyTeamView:FreshAssist(i)
    if not self.go_table then
        return
    end
    local tb = _G.GetAutoGoTable(self.go_table["obj_player" .. i])
    local member = self.teamInfo.member_list[i] 
    if member then 
        local mineBol = member.role_info.uid == _G.PlayerModel:GetInstance():GetPlayerUid()
        -- local assistData = RelicTeamModel:GetGiveAssistInfo(member.role_info.uid)
        -- member.assistData = assistData
        local assistData = RelicTeamModel:GetReceiveAssistInfo(member.role_info.uid)
        local num = 0
        tb["obj_add1"]:SetActiveE(mineBol and 0 or 1)
        tb["obj_add2"]:SetActiveE(mineBol and 0 or 1)
        tb["obj_redpoint1"]:SetActiveE(0)
        tb["obj_redpoint2"]:SetActiveE(0)
        tb["aortext_assistName1"].text = _G.GetLangPackValue(90033500228) .. assistIndexT[i][1]
        tb["aortext_assistName2"].text = _G.GetLangPackValue(90033500228) .. assistIndexT[i][2]
        for j = 1, 2 do
            tb["aorbtn_assist" .. j].onClick:RemoveAllListeners()
            tb["aorbtn_assist" .. j].onClick:AddListener(_G.handlerbind(self, self.ClickAssistBtn, tb, nil, i, mineBol))
            if self.assisdCardItemTable[i][j] then 
                self.assisdCardItemTable[i][j].gameObject:SetActiveE(0)
            end
        end
        for k, v in pairs(assistData) do 
            num = num + 1
            local index = num
            local cardData
            if v.c_info then 
                tb["obj_redpoint" .. num]:SetActiveE(0)
                if not self.assisdCardItemTable[i][index] then
                    _G.ItemCardFactory:GetInstance():GetItemCard(
                        _G.ItemCardFactory.itemCardType.CardAllItem,
                        tb["obj_assist" .. num],
                    function(item)
                        if not self.go_table then
                            _G.DestroyObject(item.gameObject)
                            return
                        end
                        self.assisdCardItemTable[i][index] = item
                        cardData = _G.CardData.New()
                        cardData:Parse(v.c_info)
                        cardData:SetLevel(300)
                        item:ShowCardData(cardData)
                        item.gameObject:SetLocalScaleXYZ(1)
                        item.gameObject:SetActiveE(1)
                    end
                    )
                else
                    cardData = _G.CardData.New()
                    cardData:Parse(v.c_info)
                    self.assisdCardItemTable[i][index]:ShowCardData(cardData)
                    self.assisdCardItemTable[i][index].gameObject:SetActiveE(1)
                end
            else
                if self.assisdCardItemTable[i][index] then 
                    self.assisdCardItemTable[i][index].gameObject:SetActiveE(0)
                end
                tb["obj_redpoint" .. num]:SetActiveE(v.role.uid == _G.PlayerModel:GetInstance():GetPlayerUid() and 1 or 0)
            end
            tb["aortext_assistName" .. num].text = v.role.name
            tb["aorbtn_assist" .. num].onClick:RemoveAllListeners()
            tb["aorbtn_assist" .. num].onClick:AddListener(_G.handlerbind(self, self.ClickAssistBtn, tb, v, i, mineBol, member.role_info.uid))
        end
    end
end

function RelicTeamMyTeamView:ClickItemBtn(go, isOn, tb, data)
    if go == tb.aorbtn_kickOut then
        if self.status ~= RelicTeamModel.relicStatus.team then 
            _G.PopWindowManager:GetInstance():ShowAllTips(1070026) 
            return 
        end
        local msg = {}
        msg.uid = data.role_info.uid
        RelicTeamModel:TeamKickOut(msg, function()
            _G.Events:GetInstance():Broadcast(_G.eRelicTeam.RelicTeamUpdateTeam, {state = -1})
        end)
    end
end

function RelicTeamMyTeamView:ClickAssistBtn(go, data, index, mineBol, memberUid)
    if mineBol then 
        if data and data.c_info then 
            self:ShowCardInfo(memberUid, data.c_info.uid)
        else 
            _G.PopWindowManager:GetInstance():ShowAllTips(1070024)
        end 
    else
        if data and data.role.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then 
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicTeamCardSelectView.Name, function(cardUid)
                RelicTeamModel:TeamAssist({uid = self.teamInfo.member_list[index].role_info.uid, card_uid = cardUid}, _G.handlerbind(self, self.FreshAssist, index))
            end,
            self.teamInfo.member_list[index].role_info.uid)
        else 
            if data and data.c_info then 
                self:ShowCardInfo(memberUid, data.c_info.uid)
            else 
                _G.PopWindowManager:GetInstance():ShowAllTips(1070023)
            end 
        end
    end
end

function RelicTeamMyTeamView:UpdateTime(elapsed)
    self.countDown = self.countDown - elapsed
    if self.countDown < 0 then
        self.countDown = 0
        self:UpdateView()
    end
    if self.go_table == nil then
        return
    end
    local time = _G.Mathf.RoundToInt(self.countDown)
    self.go_table.aortext_teamTime.text = _G.GetLangPackValue(90033500051, _G.string.AddColor(_G.TimeUtil.TransDayHourMineMiao(time), "96ce51")) 
end

function RelicTeamMyTeamView:ShareTeam()
    if _G.AppSetting.DEBUG then
        _G.Log("分享古神遗迹组队")
    end
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ChooseChannelView.Name,
        function(channelargs, firendIdargs)
            local channel = channelargs
            local firendId = firendIdargs or 0
            ---@type share.c2s_share_save
            ---分享队伍
            local data = {}
            data.uid = self.teamInfo.uid
            data.name = self.teamInfo.name
            local num = 0
            local power = 0
            data.member = {}
            for k, v in ipairs(self.teamInfo.member_list) do 
                num = num + 1
                data.member[k] = {uid = v.role_info.uid, frame = v.role_info.frame, style = v.role_info.style, title = v.role_info.title}
                power = power + v.role_info.power
            end
            data.camp = RelicTeamModel:GetCamp()
            data.join_power = self.teamInfo.join_power
            data.power = power 
            data.memberNum = num

            local dataStr = _G.Table2Json(data)

            ---@type chat.c2s_chat 
            local param = {}
            param.channel = channel
            param.content = dataStr
            param.f_uid = firendId
            param.type = 9
            param.voice = 0

            ---@type ClintSendChatInfo ---本地自己的消息 先显示 忽略服务器广播 防止延迟
            local msg = {}
            msg.channel = channel
            msg.n_content = dataStr
            msg.f_uid = firendId
            msg.type = 9
            msg.voice = 0
            msg, _ = require("ChatManager"):GetInstance():GetNewChatInfo(msg)
            require("ChatViewNet"):GetInstance():SendCHAT(
                param,
                _G.handlerbind(self, self.CallSendChat, msg)
            )
        end)
end

function RelicTeamMyTeamView:CallSendChat()
    _G.PopWindowManager:GetInstance():ShowAllTips(230303, _G.GetLangPackValue(90000001048))
end

function RelicTeamMyTeamView:StopTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end
---按钮点击事件在这里派发
function RelicTeamMyTeamView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_setting then
        if self.status ~= RelicTeamModel.relicStatus.team then 
            _G.PopWindowManager:GetInstance():ShowAllTips(1070026) 
            return 
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicTeamSettingView.Name)
    elseif go == self.go_table.aorbtn_quit then
        if self.status ~= RelicTeamModel.relicStatus.team then 
            _G.PopWindowManager:GetInstance():ShowAllTips(1070026) 
            return 
        end
        local sure = function()
            local T = {args = {1}, c_layer = RelicTeamModel:GetNowLayer()}  
            RelicTeamModel:QuitTeam(function()
                _G.Events:GetInstance():Broadcast(_G.eRelicTeam.RelicTeamRefresh)
            end)
        end
        _G.PopWindowManager:GetInstance():ShowAllTips(1070004, nil, sure) 
    elseif go == self.go_table.aorbtn_request then
        if self.status ~= RelicTeamModel.relicStatus.team then 
            _G.PopWindowManager:GetInstance():ShowAllTips(1070026) 
            return 
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicTeamRequestAndCanInviteView.Name, 2)
    elseif go == self.go_table.aorbtn_share then
        if self.status ~= RelicTeamModel.relicStatus.team then 
            _G.PopWindowManager:GetInstance():ShowAllTips(1070026) 
            return 
        elseif #self.teamInfo.member_list == 3 then 
            _G.PopWindowManager:GetInstance():ShowAllTips(5206) 
            return 
        end 
        self:ShareTeam()
    elseif go == self.go_table.aorbtn_add2 or go == self.go_table.aorbtn_add3 then
        if self.status ~= RelicTeamModel.relicStatus.team then 
            _G.PopWindowManager:GetInstance():ShowAllTips(1070026) 
            return 
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicTeamRequestAndCanInviteView.Name, 1)
    elseif go == self.go_table.aorbtn_tips then 
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 169)
    end
end

function RelicTeamMyTeamView:CloseView()
    self:Close()
end

function RelicTeamMyTeamView:Hide()
    self.go_table.gameObject:SetActiveE(0)
end

function RelicTeamMyTeamView:Show()
    self.go_table.gameObject:SetActiveE(1)
    self:UpdateView()
end

function RelicTeamMyTeamView:OnDestroy()
    self:RemoveAllListener()
    self:StopTimer()
end

return RelicTeamMyTeamView
