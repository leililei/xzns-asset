---@class RelicTeamRequestAndCanInviteView : UIBaseView  下边栏菜单
---@field go_table RelicTeamRequestAndCanInviteView_GoTable
local RelicTeamRequestAndCanInviteView = _G.BaseClass("RelicTeamRequestAndCanInviteView", _G.UIBaseView)
local RelicTeamModel

function RelicTeamRequestAndCanInviteView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function RelicTeamRequestAndCanInviteView:OnCreate(type)
    RelicTeamModel = require "RelicTeamModel":GetInstance()
    self.type = type or 1
    self:GetInfo()
end

---刷新数据
function RelicTeamRequestAndCanInviteView:FreshData()
    self.requestsList = RelicTeamModel:GetRequestsList()
    self.canInviteList = RelicTeamModel:GetCanInviteList()
    self.InvitedUidList = RelicTeamModel:GetInvitedUidList()
    self.requestsUidList = RelicTeamModel:GetRequestsUidList()
    self.teamInfo = RelicTeamModel:GetTeamInfo()
end

function RelicTeamRequestAndCanInviteView:UpdateView()
    self:FreshData()
    self:FreshToggle()
    self.list = self.type == 1 and self.canInviteList or self.requestsList
    if self.type == 1 then
        -- RelicTeamModel:ClearNewInviteBol()
        -- require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RelicTeamInvite.id)
    else
        RelicTeamModel:ClearNewRequestBol()
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RelicTeamRequest.id)
    end
    if not self.init then
        self.go_table.scrollloopvectical_teamList:InitItemData(0, _G.handler(self, self.RefreshList))
        self.go_table.scrollloopvectical_teamList:UpdateCount(#self.list)
        self.init = true
    else
        self.go_table.scrollloopvectical_teamList:UpdateCount(#self.list)
        self.go_table.scrollloopvectical_teamList:UpdateAllItem()
    end
    self.go_table.obj_refuse:GetComponentE(_G.typeof(_G.CS.ExtendText)).text = string.format("<%s@1>", _G.GetLangPackValue(90020100030))
    self.go_table.obj_txt:SetActiveE(self.type == 1 and 1 or 0)
    self.go_table.obj_refuse:SetActiveE(self.type == 2 and 1 or 0)
    self.go_table.aorbtn_refuse:SetActiveE(self.type == 2 and 1 or 0)
end

function RelicTeamRequestAndCanInviteView:RefreshList(index, obj)
    local x = index + 1
    local data = self.list[x]
    local tb = _G.GetAutoGoTable(obj)
    tb.index = x
    tb["_onclick"] = _G.handlerbind(self, self.ClickItemBtn, tb, data, x)
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_head, data, 0.8, true)
    tb.aortext_name.text = data.name
    tb.aortext_power.text = _G.UIUtils.NumberToUnitStr_CardFightNum(data.power, true)
    if self.type == 1 then
        local bol = table.ContainsValue(self.InvitedUidList, data.uid)
        tb.aorbtn_request:SetActiveE(bol and 0 or 1)
        tb.obj_type1:SetActiveE(bol and 1 or 0)
        tb.obj_type2:SetActiveE(0)
        tb.aortext_btn.text = _G.GetLangPackValue(90033500073)
    else
        local bol = table.ContainsValue(self.requestsUidList, data.uid)
        tb.aorbtn_request:SetActiveE(bol and 0 or 1)
        tb.obj_type2:SetActiveE(bol and 1 or 0)
        tb.obj_type1:SetActiveE(0)
        tb.aortext_btn.text = _G.GetLangPackValue(90033500072)
    end
end

function RelicTeamRequestAndCanInviteView:FreshToggle()
    self.go_table.obj_toggle1:SetActiveE(self.type == 1 and 1 or 0)
    self.go_table.obj_toggle2:SetActiveE(self.type == 2 and 1 or 0)
end

function RelicTeamRequestAndCanInviteView:ClickItemBtn(go, isOn, tb, data, index)
    if go == tb.aorbtn_request then
        if self.type == 1 then
            if data.power < self.teamInfo.join_power then
                _G.PopWindowManager:GetInstance():ShowAllTips(1070009)
                return
            end
            local msg = {}
            msg.uid = { data.uid }
            RelicTeamModel:Invite(msg, _G.handlerbind(self, self.AcceptCallBack, tb, index))
        else
            local msg = {}
            msg.type = 1
            msg.uid = { data.uid }
            RelicTeamModel:CheckRequest(msg, _G.handlerbind(self, self.AgreeCallBack, tb, index))
        end
    end
end

function RelicTeamRequestAndCanInviteView:GetInfo()
    RelicTeamModel:GetRequestAndCanInviteList(_G.handler(self, self.UpdateView))
end

---按钮点击事件在这里派发
function RelicTeamRequestAndCanInviteView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_type1 then
        if self.type ~= 1 then
            self.type = 1
            self:UpdateView()
        end
    elseif go == self.go_table.aorbtn_type2 then
        if self.type ~= 2 then
            self.type = 2
            self:UpdateView()
        end
    elseif go == self.go_table.aorbtn_refuse then
        if self.type == 2 then
            local msg = {}
            msg.type = 0
            msg.uid = {}
            for k, v in ipairs(self.list) do
                table.insert(msg.uid, v.uid)
            end
            if #msg.uid == 0 then
                return
            end
            RelicTeamModel:CheckRequest(msg, _G.handlerbind(self, self.UpdateView))
        end
    end
end

function RelicTeamRequestAndCanInviteView:AcceptCallBack(tb, index)
    -- if RelicTeamModel:GetTeamInfo() then 
    --     _G.Events:GetInstance():Broadcast(_G.eRelicTeam.RelicTeamUpdateTeam, {state = 1})
    -- end 
    if self:IsNil() then
        return
    end
    if tb.index == index then
        tb.aorbtn_request:SetActiveE(0)
        tb.obj_type1:SetActiveE(1)
    end
end

function RelicTeamRequestAndCanInviteView:AgreeCallBack(tb, index)
    if RelicTeamModel:GetTeamInfo() then
        _G.Events:GetInstance():Broadcast(_G.eRelicTeam.RelicTeamUpdateTeam, { state = 1 })
    end
    if self:IsNil() then
        return
    end
    if tb.index == index then
        tb.aorbtn_request:SetActiveE(0)
        tb.obj_type2:SetActiveE(1)
    end
end

function RelicTeamRequestAndCanInviteView:OnDestroy()
    RelicTeamModel:RemoveRequestsUidList()
    self:RemoveAllListener()
end

return RelicTeamRequestAndCanInviteView
