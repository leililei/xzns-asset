---@class RelicTeamCreateTeamView : UIBaseView  下边栏菜单
---@field go_table RelicTeamCreateTeamView_GoTable
local RelicTeamCreateTeamView = _G.BaseClass("RelicTeamCreateTeamView", _G.UIBaseView)
local RelicTeamModel

function RelicTeamCreateTeamView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function RelicTeamCreateTeamView:OnCreate()
    self.powerUnits={
        [1]=90023100001,
        [2]=90023100002
    }
    RelicTeamModel = require "RelicTeamModel":GetInstance()
    self.powerType = 1
    self.autoType = 1
    _G.GameUtil.InputFieldCharacterLimit(self.go_table.input_input, 12, nil, true, nil, nil, true)
    _G.GameUtil.InputFieldCharacterLimit(self.go_table.input_power, 4, nil, true)
    self.units=1
    self.go_table.input_power.onValueChanged:RemoveAllListeners()
    self.go_table.input_power.onValueChanged:AddListener(
        function(input)
            local res=""
            local count = 0
            local arr = string.getStringCharArr(input)
            for i = 1, #arr do
                local char = arr[i]
                local charLen= string.getStringCharCount(char)
                count = count + charLen
                if count <= 4 then
                    res = res .. char
                else
                    break
                end
            end
            if #arr > 4 then
                if _G.AppSetting.DEBUG then
                    _G.Log("<color=red><size=10>" .. "超过限制长度" .. _G.tonumber(input) .. "</size></color>")
                end
                local num=_G.tonumber(input)
                if num and num>=10000 and self.units==1 then
                    self.go_table.input_power.text=math.ceil(_G.tonumber(res)/10000)
                    self.units=self.units+1
                else 
                    self.go_table.input_power.text=res
                end
            elseif #arr==0 then
                if self.units>1 then
                    self.units=self.units-1
                end
            else
                self.go_table.input_power.text = res
            end
            self.go_table.aortext_units.text=_G.GetLangPackValue(self.powerUnits[self.units])
        end
    )
    self:UpdateView()
end

function RelicTeamCreateTeamView:UpdateView()
    self.go_table.input_input.text = _G.PlayerModel:GetInstance():GetName() 
    self.go_table.input_power.text = 100
    self:FreshPowerObj()
    self:FreshAutoObj()
end

--更新战力设置UI
function RelicTeamCreateTeamView:FreshPowerObj()
    self.teamInfo = RelicTeamModel:GetTeamInfo()
    self.go_table.obj_powerType1:SetActiveE(self.powerType == 1 and 1 or 0)
    self.go_table.obj_powerType2:SetActiveE(self.powerType == 1 and 0 or 1)
    if self.teamInfo then
        if self.teamInfo.join_power>=10000 and self.teamInfo.join_power<100000000 then
            self.go_table.input_power.text = self.powerType == 1 and 0 or math.ceil(self.teamInfo.join_power / 10000)
            self.units=1
        elseif self.teamInfo.join_power>=100000000  then
            self.go_table.input_power.text = self.powerType == 1 and 0 or math.ceil(self.teamInfo.join_power / 100000000)
            self.units=2
        end   
    end
    self.go_table.aortext_units.text=_G.GetLangPackValue(self.powerUnits[self.units])
end

--更新自动手动UI
function RelicTeamCreateTeamView:FreshAutoObj()
    self.go_table.obj_autoType1:SetActiveE(self.autoType == 1 and 1 or 0)
    self.go_table.obj_autoType2:SetActiveE(self.autoType == 1 and 0 or 1)
end

function RelicTeamCreateTeamView:OnDestroy()
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
function RelicTeamCreateTeamView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.aorbtn_left or  go == self.go_table.aorbtn_right then 
        self.powerType = self.powerType == 1 and 2 or 1
        self:FreshPowerObj()
    elseif go == self.go_table.aorbtn_auto then 
        if self.autoType ~= 1 then 
            self.autoType = 1 
            self:FreshAutoObj()
        end
    elseif go == self.go_table.aorbtn_handle then
        if self.autoType ~= 2 then 
            self.autoType = 2
            self:FreshAutoObj()
        end
    elseif go == self.go_table.aorbtn_create then 
        local num = _G.tonumber(self.go_table.input_power.text)
        if self.powerType == 2 and (not num or num < 0) then
            _G.PopWindowManager:GetInstance():ShowAllTips(4404, _G.GetLangPackValue(90033500238))
            return
        end
        if self.go_table.input_input.text == "" then
            _G.PopWindowManager:GetInstance():ShowAllTips(250104, _G.GetLangPackValue(90033500238))
            return
        end
        local msg = {}
        msg.name = self.go_table.input_input.text
        msg.type = self.autoType
        if self.units==1 then
            msg.power = self.powerType == 1 and 0 or (num * 10000)
        elseif self.units>1 then
            msg.power = self.powerType == 1 and 0 or (num * 100000000)
        end
        RelicTeamModel:CreateTeam(msg, _G.handler(self, self.CreateCallBack))
    end
end

function RelicTeamCreateTeamView:CreateCallBack()
    if self:IsNil() then
        return
    end
    if RelicTeamModel:GetTeamInfo() then 
        _G.Events:GetInstance():Broadcast(_G.eRelicTeam.RelicTeamUpdateTeam, {state = -1})
    end 
    self:Close()
end

return RelicTeamCreateTeamView
