---@class RelicTeamToggleView : UIBaseView  下边栏菜单
---@field go_table RelicTeamToggleView_GoTable
---@field toggles table<string,RelicTeamToggleView._toggle_reset_GoTable> 切换按钮
---@field curToggle string  @当前选中的界面
---@field views table<string, number|Component|UIBaseView> @界面实例
local RelicTeamToggleView = _G.BaseClass("RelicTeamToggleView", _G.UIBaseView)
local RelicTeamModel
local keyName = {
    [1] = "relic", 
    [2] = "team",
    [3] = "rank",
    [4] = "gift",
    [5] = "award",
}

function RelicTeamToggleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.eRelicTeam.RelicTeamUpdateTeam, self.UpdateTeamPushCall, self)
    _G.Events:GetInstance():AddListener(_G.eRelicTeam.RelicTeamRefresh, self.UpdateView, self)
    _G.Events:GetInstance():AddListener(_G.eRelicTeam.RelicTeamChangeStatus, self.ChangeStatus, self)
end

function RelicTeamToggleView:UpdateTeamPushCall(msg)
    if msg.state == 3 then 
        _G.PopWindowManager:GetInstance():ShowAllTips(1070027)
        self:UpdateView()
        return 
    end
    if msg.state ~= 4 and msg.state ~= 6 then  
        RelicTeamModel:GetTeam(_G.handler(self, self.UpdateView))
    end 
end

function RelicTeamToggleView:UpdateView()
    if self.views then
        for _, view in pairs(self.views) do
            if view ~= 0 and view.gameObject:GetActiveSelf() == 1 and view.UpdateView then 
                view:UpdateView()
            end 
        end
    end
end

function RelicTeamToggleView:ChangeStatus(status, nextTime)
    if status == RelicTeamModel.relicStatus.settle then 
        self.go_table.toggle_gift:SetActiveE(0)  
    end
    if status == RelicTeamModel.relicStatus.idle and RelicTeamModel:CheckAutoTeamStatus() then 
        _G.PopWindowManager:GetInstance():ShowAllTips(1070022) 
        self:Close()
    elseif status ~= RelicTeamModel.relicStatus.close then 
        self:UpdateView()
    else 
        self:Close()
    end
end

---界面的入口函数
---@param toggleIndex number|string|nil 切换界面的索引
function RelicTeamToggleView:OnCreate(toggleIndex)
    RelicTeamModel = require "RelicTeamModel":GetInstance()
    self:InitToggles()
    self:InitTogglesFunctionUnlock()
    RelicTeamModel:GetRankData()
    RelicTeamModel:CalMyPowerByArray()
    ---@type string
    local key
    if type(toggleIndex) == "string" then
        key = toggleIndex
    elseif type(toggleIndex) == "number" then
        key = keyName[toggleIndex]
    end
    key = key or self:GetDefaultToggleKey()
    local tog = self.go_table["toggle_" .. key] or self.go_table.toggle_relic
    if tog then
        tog.isOn = false
        tog.isOn = true
    end
end

function RelicTeamToggleView:SwitchToggle(toggleName)
    if self.curToggle ~= toggleName then 
        local tog = self.go_table["toggle_" .. toggleName]
        if tog then
            tog.isOn = false
            tog.isOn = true
        end
    end
end

function RelicTeamToggleView:OnDestroy()
    self:RemoveAllListener()
    self.views = nil 
    _G.Events:GetInstance():RemoveListener(_G.eRelicTeam.RelicTeamUpdateTeam, self.UpdateTeamPushCall, self)
    _G.Events:GetInstance():RemoveListener(_G.eRelicTeam.RelicTeamRefresh, self.UpdateView, self)
    _G.Events:GetInstance():RemoveListener(_G.eRelicTeam.RelicTeamChangeStatus, self.ChangeStatus, self)
end

---根据功能获取当前可打开的toggle节点
function RelicTeamToggleView:GetDefaultToggleKey()
    return "relic"
end

function RelicTeamToggleView:InitToggles()
    self.views = {}
    self.toggles = {
        relic = _G.GetAutoGoTable(
            self.go_table.toggle_relic,
            _G.handlerbind(self, self.OnClickToggle, "relic", _G.handler(self, self.OnRelic))
        ),
        team = _G.GetAutoGoTable(
            self.go_table.toggle_team,
            _G.handlerbind(self, self.OnClickToggle, "team", _G.handler(self, self.OnTeam))
        ),
        rank = _G.GetAutoGoTable(
            self.go_table.toggle_rank,
            _G.handlerbind(self, self.OnClickToggle, "rank", _G.handler(self, self.OnRank))
        ),
        gift = _G.GetAutoGoTable(
            self.go_table.toggle_gift,
            _G.handlerbind(self, self.OnClickToggle, "gift", _G.handler(self, self.OnGift))
        ),
        award = _G.GetAutoGoTable(
            self.go_table.toggle_award,
            _G.handlerbind(self, self.OnClickToggle, "award", _G.handler(self, self.OnAward))
        )
    }
    self.giftActivity = require "ActivitySynManager":GetInstance():GetChildAcitivity(10014, 100081)
    RelicTeamModel:GetDataFromCfg()
    self.go_table.toggle_gift:SetActiveE(self.giftActivity and 1 or 0)
    local status = RelicTeamModel:GetStatusAndNextTimeLine()
    if status == RelicTeamModel.relicStatus.settle then 
        self.go_table.toggle_gift:SetActiveE(0)  
    end
    if self.giftActivity then 
        self.toggles.gift.obj_redpoint:UpdateRedPointItemIDAndParam(self.giftActivity:GetActivityTypeCls():GetRedpointIDByIndex(1) or 0)
    end
    local hasTeam = RelicTeamModel:GetTeamInfo()
    if not hasTeam and status == RelicTeamModel.relicStatus.settle then
        self.toggles.team.gameObject:SetActiveE(0)
    end
end

