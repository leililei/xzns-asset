---监听Toggle点击事件
---@param key string
---@param callback function
function RelicTeamToggleView:OnClickToggle(_, isOn, key, callback)
    local tb = self.toggles[key]
    local view = self.views[key]
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    self.curToggle = key

    --节点显隐
    if view and view ~= 0 then
        view.gameObject:SetActiveE(isOn and 1 or 0)
    end

    if isOn and callback then
        callback()
    end
end

function RelicTeamToggleView:OnRelic()
    local view = self.views.relic
    if not view then
        self.views.relic = 0
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
        --_G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.RelicView.Name)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicView.Name)
    elseif view ~= 0 then
        view:UpdateView()
    end
end

function RelicTeamToggleView:OnTeam()
    local view = self.views.team
    if not view then
        self.views.team = 0
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
        --_G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.RelicTeamView.Name)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicTeamTeamMain.Name)
    elseif view ~= 0 then
        view:InitView()
    end
end

function RelicTeamToggleView:OnRank()
    local view = self.views.rank
    if not view then
        self.views.rank = 0
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
        --_G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.RelicTeamView.Name)
        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicTeamRankView.Name)

        local RankUtils = require("RankUtils")
        RankUtils.ClearAllRankData()
        ---@type RecordRankModel
        local model = require("RecordRankModel"):GetInstance()
        local RankDatas = {
            model:GetRankData(RankUtils.RankType.AncientGodPersonalPoints),
            model:GetRankData(RankUtils.RankType.AncientGodAllianceTeam),
            --model:GetRankData(RankUtils.RankType.AncientGodHordeSquad),
        }
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArchaeologyRankView.Name,RankDatas,RankUtils.RankType.AncientGodPersonalPoints)
    elseif view ~= 0 then
        require("RankUtils").ClearAllRankData()
        view:RefreshData()
    end
end

function RelicTeamToggleView:OnGift()
    local view = self.views.gift
    if not view then
        self.views.gift = 0
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
        --_G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.RelicTeamView.Name)
        

        local args = {}
        args.modelName = "RelicTeamModel"
        args.aorrawimage_TitleBg = "ImagesH5/hRelic/ui_wf_kglb_txt_czxg"

        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonGiftSecondView.Name,function()
            local giftActivity = require "ActivitySynManager":GetInstance():GetChildAcitivity(10014, 100081)
            if giftActivity then 
                require "RedPointManager":GetInstance():RefreshNode(giftActivity:GetActivityTypeCls():GetRedpointIDByIndex(1))
            end
        end,args)

        
    elseif view ~= 0 then
        view:UpdateView()
    end
end

function RelicTeamToggleView:OnAward()
    local view = self.views.award
    if not view then
        self.views.award = 0
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
        --_G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.RelicTeamView.Name)
        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicTeamAwardView.Name)

        local RelicTeamModel = require("RelicTeamModel"):GetInstance()
        local RelicCfg = RelicTeamModel:GetRelicCfgNow()
        local camp = RelicTeamModel:GetCamp()
        local relic_rank1 = RelicCfg.relic_rank1
        local relic_rank2 = RelicCfg.relic_rank2
        local count1 = #relic_rank1
        local count2 = #relic_rank2

        local RankUtils = require("RankUtils")
        local rankStr = RankUtils.RankStrDefault.Points

        local rankType = RankUtils.RankType.AncientGodAllianceTeam
        if camp then
            if camp == 1 then
                rankType = RankUtils.RankType.AncientGodAllianceTeam
            elseif camp == 2 then
                rankType = RankUtils.RankType.AncientGodHordeSquad
            end
        end

        -----@type RewardPreviewView.OpenData[]
        local OpenData = {--TODO 排行榜 常量
            RankUtils.GetData(13,0,0,rankStr,nil,_G.ConfigManager.arena_rank_cfg,relic_rank1[1],relic_rank1[count1],1,RankUtils.RankType.AncientGodPersonalPoints),
            RankUtils.GetData(14,0,0,rankStr,nil,_G.ConfigManager.arena_rank_cfg,relic_rank2[1],relic_rank2[count2],1,rankType),
            --RankUtils.GetData(15,0,0,rankStr,nil,_G.ConfigManager.arena_rank_cfg,relic_rank2[1],relic_rank2[count2],1,RankUtils.RankType.AncientGodHordeSquad),
        }

        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RewardPreviewFullView.Name,OpenData,1)
    elseif view ~= 0 then
        if view.UpdateView then
            view:UpdateView()
        elseif view.RefreshUI then
            view:RefreshUI()
        end
    end
end

---加载界面
function RelicTeamToggleView:OnUIOpened(name)
    ---@type string
    local key
    if name == _G.ConfigManager.ui_cfg.RelicView.Name then
        key = "relic"
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    elseif name == _G.ConfigManager.ui_cfg.RelicTeamTeamMain.Name then
        key = "team"
    elseif name == _G.ConfigManager.ui_cfg.ArchaeologyRankView.Name then
        key = "rank"
    elseif name == _G.ConfigManager.ui_cfg.CommonGiftSecondView.Name then
        key = "gift"
    elseif name == _G.ConfigManager.ui_cfg.RewardPreviewFullView.Name then
        key = "award"
    elseif name == _G.ConfigManager.ui_cfg.RelicTeamToggleView.Name then 
        
    end
    if not key then 
        return
    end
    self:RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)

    local view = _G.UIManager:GetInstance():GetWindowCtrl(name)
    if self:IsNil() then
        view:Close()
        return
    end
    view.transform:SetParentE(self.go_table.obj_view)
    _G.UIManager:GetInstance():ChangeCanvasOrder(
        name,
        self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 1
    )
    self.views[key] = view
    if self.curToggle ~= key then
        view:Hide()
    end
end

function RelicTeamToggleView:Hide()
    if self.views.relic and self.views.relic ~= 0 then 
        self.views.relic:Hide()
    end
end

function RelicTeamToggleView:Show()
    if self.views.relic and self.views.relic ~= 0 then 
        self.views.relic:Show()
    end
end

---按钮点击事件在这里派发
function RelicTeamToggleView:Close()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    self.super.Close(self)
    --关闭内嵌页面
    if self.views then
        for _, view in pairs(self.views) do
            view:Close()
        end
        self.views = nil
    end
end

---按钮点击事件在这里派发
function RelicTeamToggleView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        if self.curToggle ~= "relic" then 
            self:SwitchToggle("relic")
        else 
            if self.views.relic.inEventViewBol then 
                self.views.relic:AnimOut(_G.handler(self, self.Close))
            else 
                self:Close()
            end
        end
    end
end

return RelicTeamToggleView
