---@class RelicTeamEmbattleView : UIBaseView	中文描述
---@field public go_table RelicTeamEmbattleView_GoTable GoTable
local RelicTeamEmbattleView = _G.BaseClass("RelicTeamEmbattleView", _G.UIBaseView)
local RelicTeamModel
local FSE = {
    win = 1, --战斗胜利
    sec = 2, --x秒内胜利
    dieNum = 3, --阵亡数不超过x
    leastEle = 4, --至少x个y种族
    mulEle = 5, --同时上阵x个ABCD种族
    diffEle = 6, --使用x种不同种族
    noPro = 7, --不使用x,y职业获得胜利
    allPro = 8, --全是x职业
    appoint2 = 100901, --包含x卡和y卡
    killNum = 10, --同一角色击杀x人
    mostEle = 11, --至多x个y种族
    mostPro = 12, --至多x个y职业
    highHP = 13, --队伍血量高于x%
    leastStar = 14, --至少上阵x个y星级
    leastOrder = 15, --至少上阵x个y品质
    leastPro = 16 --至少x个y职业
}

function RelicTeamEmbattleView:Awake()
    _G.Events:GetInstance():AddListener(_G.eRelicTeam.RelicTeamUpdateTeam, self.UpdateTeamPushCall, self)
end
---界面的入口函数
function RelicTeamEmbattleView:OnCreate(embattleType, exitCall, battleCall, autoFight, pvpInfo, cfg, embattleBol)
    RelicTeamModel = require "RelicTeamModel":GetInstance()
    self.onExitCall = exitCall
    self.embattleType = embattleType
    self.onBattleCall = battleCall
    self.autoFight = autoFight
    self.pvpInfo = pvpInfo
    self.cfg = cfg
    self.embattleBol = embattleBol
    self.colorEnum = {
        require("CardInfoManager").GetColorFromRGB("5CFF6F"),
        require("CardInfoManager").GetColorFromRGB("FF2A0D")
    }
    self:OpenEmbattleView()
end
function RelicTeamEmbattleView:OnDestroy()
    self.onExitCall = nil
    self.onBattleCall = nil
    self.embattleView = nil 
    _G.Events:GetInstance():RemoveListener(_G.eRelicTeam.RelicTeamUpdateTeam, self.UpdateTeamPushCall, self)
    self:RemoveAllListener()
end
--检查阵容条件
function RelicTeamEmbattleView:CheckCondition(embattleData)
    local eleDic = {}
    local proDic = {}
    local sidDic = {}
    local starDic = {}
    local orderDic = {}
    local totalNum = 0
    ---@type CardData
    local cardData, ele, pro
    for i, v in pairs(embattleData) do
        if v.uid > 0 then
            cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, v.uid)
            if not cardData then 
                local cardInfo = RelicTeamModel:GetMyAssistCards()
                for key, value in ipairs(cardInfo) do 
                    if value.c_info.uid == v.uid then 
                        cardData = _G.CardData.New()
                        cardData:Parse(v)
                    end
                end
            end
            ele = cardData:GetElement()
            pro = cardData:GetProfessional()
            eleDic[ele] = eleDic[ele] and eleDic[ele] + 1 or 1
            proDic[pro] = proDic[pro] and proDic[pro] + 1 or 1
            starDic[cardData:GetStar()] = starDic[cardData:GetStar()] and starDic[cardData:GetStar()] + 1 or 1
            orderDic[cardData:GetGrade()] = orderDic[cardData:GetGrade()] and orderDic[cardData:GetGrade()] + 1 or 1
            sidDic[cardData.sid] = true
            totalNum = totalNum + 1
        end
    end

    local conIds = RelicTeamModel:GetGarrayCondition()
    local flag, condition
    for i = 1, #conIds do
        condition = _G.ConfigManager.system_trial_star_cfg[conIds[i]].condition[1]
        flag = false
        if condition[1] == FSE.leastEle then
            if eleDic[condition[3]] ~= nil and eleDic[condition[3]] >= condition[2] then
                flag = true
            end
        elseif condition[1] == FSE.mostEle then
            if eleDic[condition[3]] == nil or eleDic[condition[3]] <= condition[2] then
                flag = true
            end
        elseif condition[1] == FSE.leastPro then
            if proDic[condition[3]] ~= nil and proDic[condition[3]] >= condition[2] then
                flag = true
            end
        elseif condition[1] == FSE.mostPro then
            if proDic[condition[3]] == nil or proDic[condition[3]] <= condition[2] then
                flag = true
            end
        elseif condition[1] == FSE.mulEle then
            flag = true
            for i = 3, 6 do
                if eleDic[condition[i]] == nil or eleDic[condition[i]] < 1 then
                    flag = false
                    break
                end
            end
        elseif condition[1] == FSE.appoint2 then
            if sidDic[condition[2]] or sidDic[condition[3]] then
                flag = true
            end
        elseif condition[1] == FSE.noPro then
            if proDic[condition[2]] ~= nil and proDic[condition[2]] > 0 then
                flag = true
            end
            if proDic[condition[3]] ~= nil and proDic[condition[3]] > 0 then
                flag = true
            end
        elseif condition[1] == FSE.allPro then
            if proDic[condition[2]] ~= nil and proDic[condition[2]] == totalNum then
                flag = true
            end
        elseif condition[1] == FSE.diffEle then
            if _G.table.count(eleDic) >= condition[2] then
                flag = true
            end
        elseif condition[1] == FSE.leastStar then
            local num = 0
            for k, v in pairs(starDic) do
                if k >= condition[3] then
                    num = num + v
                    if num >= condition[2] then
                        flag = true
                        break
                    end
                end
            end
        elseif condition[1] == FSE.leastOrder then
            local num = 0
            for k, v in pairs(orderDic) do
                if k >= condition[3] then
                    num = num + v
                    if num >= condition[2] then
                        flag = true
                        break
                    end
                end
            end
        end
        if flag then 
            break
        end
    end
    local str = RelicTeamModel:GetNowEffectsStr()
    for i = 1, 3 do
        local strT = _G.string.split(str[i], "#")
        --condition = _G.ConfigManager.relic_cfg[self.cfg.star_condition[i][1]].condition[1]
        local objTxt = self.go_table["aortext_starCon" .. i]
        objTxt.text = strT[2] or ""
        objTxt:SetActiveE(i <= #str and 1 or 0)
    end
    self.flag = flag
    self.go_table.aortext_starCon2.color = self.colorEnum[flag and 2 or 1]
    self.go_table.aortext_starCon1.color = self.colorEnum[flag and 2 or 1]
    self.go_table.aortext_starCon3.color = self.colorEnum[flag and 2 or 1]
    local embattleItem = require("EmbattleController"):GetInstance():GetCurEmbattleItem()
    local nowtime = _G.TimeUtil.GetServerUnixTime()
    local savetime = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.RelicTeamDebuffTips)
    local todayTime = _G.TimeUtil.GetDayBySix(nowtime)
    local isChoose = savetime == todayTime
    if  not isChoose and self.flag then 
        embattleItem.confirmTips = 1070003
    else 
        embattleItem.confirmTips = nil 
    end
    if self.AnimComponent == nil then
        self.AnimComponent = self.go_table.obj_starCondition:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
        self.group = self.go_table.aortext_starCon1:GetComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup))
    end
    if self.flag then 
        self.go_table.obj_debuff:SetActiveE(1)
        self.AnimComponent.enabled = true
        -- if self.go_table.obj_debuff:GetChildCountE() == 0 then 
        --     _G.UIUtils.LoadEffectByCfg(
        --     _G.ConfigManager.ui_effect_cfg.ef_RelicTeamEmbattleView_icon,
        --     self.go_table.obj_debuff,
        --     function(trans)
        --         if not self.go_table then
        --             _G.DestroyObject(trans)
        --             return 
        --         end
        --         trans:SetLocalPositionToZero()
        --         trans:SetLocalScaleXYZ(1)
        --         trans:SetActiveE(1)
        --         --trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
        --         self.AnimComponent:Play("ani_RelicTeamEmbattleView")
        --     end,
        --     function()
        --     end
        -- ) 
        -- end
        
    else 
        self.go_table.obj_debuff:SetActiveE(0)
        self.AnimComponent.enabled = false
        self.group.alpha = 1
    end
end

function RelicTeamEmbattleView:OpenEmbattleView()
    local team 
    if self.pvpInfo then 
        team = self.pvpInfo.team
    end
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    require "EmbattleController":GetInstance():SetEmbattleChangeCall(_G.handler(self, self.CheckCondition))
    require "EmbattleController":GetInstance():OpenEmbattle(
        self.embattleType,
        _G.EmbattleSaveType.server,
        true,
        self.embattleBol and _G.EmbattleControllerItemType.RelicTeamDefence or _G.EmbattleControllerItemType.RelicTeamAttack,
        _G.handlerbind(self, self.OnExitCall, self.pvpInfo),
        _G.handlerbind(self, self.OnBattleCall, self.pvpInfo),
        RelicTeamModel:GetFightMap(), 
        team
    )
end

function RelicTeamEmbattleView:OnExitCall()
    require "EmbattleController":GetInstance():SetEmbattleChangeCall(nil)
    self:Close()
    if self.onExitCall then
        self.onExitCall()
        self.onExitCall = nil
    end
end 
function RelicTeamEmbattleView:OnBattleCall(...)
    require "EmbattleController":GetInstance():SetEmbattleChangeCall(nil)
    local args = {...}
    if self.onBattleCall then
        self.onBattleCall(args)
        self.onBattleCall = nil
    end
    self:Close()
end

---监听界面打开
---@param name string 界面名称
function RelicTeamEmbattleView:OnEmbattleViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
        self.embattleView = _G.UIManager:GetInstance():GetWindowCtrl(name)
        _G.UIManager:GetInstance():ChangeCanvasOrder(
            name,
            self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
        )
        self.embattleView:SetQuitCallback(_G.handler(self, self.CheckQuitEmbattle))
        self.embattleView.transform:SetParentE(self.go_table.trans_view)
        local left = _G.PlayerModel:GetInstance():GetName()
        local right
        if self.pvpInfo then 
            right = self.pvpInfo.role_info.name
            RelicTeamModel:SetFightName(right)
        end
        self.embattleView:SetVsDescription(left, right)
    end
end
--更新阵容
function RelicTeamEmbattleView:UpdateGarrayCall()
    if self.embattleView then 
        _G.PopWindowManager:GetInstance():ShowAllTips(1070028)
        self.embattleView:ChangeAssistCard()
    end
end
--更新阵容推送回调
function RelicTeamEmbattleView:UpdateTeamPushCall(msg)
    if msg.state == 5 then  
        self:UpdateGarrayCall()
    end 
end

function RelicTeamEmbattleView:CheckQuitEmbattle(call)
    call(true)
end

return RelicTeamEmbattleView
