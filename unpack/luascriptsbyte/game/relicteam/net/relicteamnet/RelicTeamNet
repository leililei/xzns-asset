local base = require("BaseGameNet")

---@class RelicTeamNet : BaseGameNet    通信协议
local RelicTeamNet = _G.BaseClass("RelicTeamNet", base)
---@return RelicTeamNet RelicTeamNet
function RelicTeamNet:GetInstance()
    return base.GetInstance(self)
end

---监听推送
function RelicTeamNet:AddMessageListeners()
    self:AddMessageListener(_G.ConfigManager.net_map.game_relic_team_update.Cmd, self.TeamUpdatePushCall)
    self:AddMessageListener(_G.ConfigManager.net_map.game_relic_attacked_new.Cmd, self.AttackedPushCall)
    self:AddMessageListener(_G.ConfigManager.net_map.game_relic_gem_change.Cmd, self.GemChangePushCall)
end

---队伍数据更新推送(推送客户端)
---@param msg relic.p2c_team_update
function RelicTeamNet:TeamUpdatePushCall(msg)
    if msg.state == 3 and msg.uid and msg.uid ~= _G.PlayerModel:GetInstance():GetPlayerUid() then 
        msg.state = 1
    end
    require("RelicTeamModel"):GetInstance():TeamUpdatePushCall(msg)
    if msg.state <= 3 then 
        require("RelicTeamModel"):GetInstance():SetTeamUpdateBol(msg.state)
    end
    _G.Events:GetInstance():Broadcast(_G.eRelicTeam.RelicTeamUpdateTeam, msg)
end

---被攻击更新推送(推送客户端)
---@param msg relic.p2c_attacked_new
function RelicTeamNet:AttackedPushCall(msg)
    require("RelicTeamModel"):GetInstance():AttackedPushCall(msg)
    _G.Events:GetInstance():Broadcast(_G.eRelicTeam.RelicTeamAttacked, msg)
end

---队友水晶更新推送(推送客户端)
---@param msg relic.p2c_gem_change
function RelicTeamNet:GemChangePushCall(msg)
    require("RelicTeamModel"):GetInstance():GemChangePushCall(msg)
    _G.Events:GetInstance():Broadcast(_G.eRelicTeam.RelicTeamUpdateTeamJewel, msg)
end

