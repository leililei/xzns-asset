function RelicTeamModel:TeamUpdatePushCall(msg)
    local uid = msg.uid or _G.PlayerModel:GetInstance():GetPlayerUid()
    local info = self:GetTeamRoleInfo(uid)
    if msg.g then
        if msg.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
            self.array = msg.g
        else
            for i = 1, #msg.g.sits do
                if msg.g.sits[i] == 0 then
                    info.team[i] = { sid = 0 }
                end
            end
        end
    end
    if msg.ass then
        info.assist_info = msg.ass
        self:FreshAssistInfo()
        self:FreshReceiveAssistInfo()
    end
    if msg.state == 4 then
        self.newRequestBol = true
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RelicTeamRequest.id)
    elseif msg.state == 6 then
        self.newInviteBol = true
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RelicTeamInvite.id)
    elseif msg.state == 3 then
        self.team_info = nil
        self.RequestedTeamUidList = {}
    end
end

