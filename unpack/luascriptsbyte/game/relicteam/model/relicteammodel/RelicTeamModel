    RelicTeamNet:GetInstance():GetTeamList(function(msg)
        if msg.ack == 1 then
            self.teamList = msg.list or {}
            self.noFullTeamList = {}
            for k, v in ipairs(self.teamList) do
                if #v.role_info < 3 then
                    table.insert(self.noFullTeamList, v)
                end
                v.power = 0
                for k1, v1 in ipairs(v.role_info) do
                    v.power = v.power + v1.power
