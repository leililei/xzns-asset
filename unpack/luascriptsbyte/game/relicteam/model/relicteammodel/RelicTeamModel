---获取自身队伍信息
function RelicTeamModel:GetTeam(call)
    RelicTeamNet:GetInstance():GetTeam(function(msg)
        if msg.ack == 1 then
            self.team_info = msg.team or self.team_info
            self.allJewel = 0
            if self.team_info then
                local InvitedUidList = self:GetInvitedUidList()
                for k, v in pairs(self.team_info.member_list or {}) do
                    v.jewel = v.jewel or 0
                    self.allJewel = self.allJewel + v.jewel
                    table.removebyvalue(InvitedUidList, v.role_info.uid)
                    if v.role_info.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                        if v.team then
                            self.array = self.array or {}
                            self.array.sits = self.array.sits or { 0, 0, 0, 0, 0 }
                            for i = 1, #v.team do
                                self.array.sits[i] = v.team[i].uid or 0
                            end
                        end
                    end
                end
                self.RequestedTeamUidList = {}
                self:FreshAssistInfo()
                self:FreshReceiveAssistInfo()
            end
            self:CalMyPowerByArray()
            self:SetTeamUpdateBol(false)
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RelicTeamInvite.id)
        elseif msg.ack == 5204 then
            self.team_info = nil
            self:SetTeamUpdateBol(false)
        end
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RelicTeamAssist.id)
        if call then
            call()
        end
    end)
end

---创建队伍
function RelicTeamModel:CreateTeam(pbData, callback)
    RelicTeamNet:GetInstance():CreateTeam(pbData, function(msg)
        if msg.ack == 1 then
            self.team_info = {}
            self.team_info.name = pbData.name
            self.team_info.is_check = pbData.type
            self.team_info.join_power = pbData.power
            self.team_info.uid = msg.uid
            self.team_info.leader_uid = _G.PlayerModel:GetInstance():GetPlayerUid()
            self.team_info.member_list = { {} }
            self.team_info.member_list[1].role_info = _G.PlayerModel:GetInstance():GetIRroleTable()
            self.team_info.member_list[1].jewel = 0
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RelicTeamInvite.id)
            if callback then
                callback()
            end
        end
    end)
end

