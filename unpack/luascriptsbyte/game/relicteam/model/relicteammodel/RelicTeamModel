---完成事件
function RelicTeamModel:FinishEvent(pb, callback)
    local T = { args = self.role_event.event.event_sid }
    self:GetRankData()
    RelicTeamNet:GetInstance():FinishEvent(pb, function(msg)
        if msg.ack == 1 then
            self.eventArgs = msg
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            local cfg = relic_events_cfg[self.role_event.event.event_sid]
            -- if cfg.event_type == 3 or cfg.event_type == 2 then
            --     local addScore = msg.winner and cfg.points[1][1] or cfg.points[2][1]
            --     self.score = self.score + addScore
            -- elseif cfg.event_type == 6 then
            --     local addScore = pb.args[1] == 1 and cfg.points[1][1] or cfg.points[2][1]
            --     self.score = self.score + addScore
            -- else
            --     self.score = self.score + cfg.points[1][1]
            -- end
            if cfg.fold ~= 1 then 
                self.role_event.all_e_num = self.role_event.all_e_num + self.multiple
            else 
                self.role_event.all_e_num = self.role_event.all_e_num + 1
            end
            if msg.add_score then 
                self.score = self.score + msg.add_score
            end
            local upLayerList = self:GetUpLayerEventIdList()
            if table.ContainsValue(upLayerList, self.role_event.event.event_sid) then
                local num = self:GetLayerEventCondition()
                if num - self.role_event.event_num == 1 then
                    self.upLayerTipsBol = true
                end
                self.role_event.event_num = self.role_event.event_num + 1
            end
            self.role_event.event = {}
            self.role_event.event_show = self.role_event.event_show or {}
            local jewelNum = 0
            for k, v in ipairs(msg.add_event_show) do
                table.insert(self.role_event.event_show, 1, v)
                jewelNum = jewelNum + v.jewel
            end
            if jewelNum > 0 then
                msg.award = msg.award or {}
                msg.award.item = msg.award.item or {}
                table.insert(msg.award.item, { type = { 76, jewelNum } })
            end
            if msg.n_energy then
                self.energy = msg.n_energy[1]
                self.energy_time = msg.n_energy[2]
            end
            if msg.n_hp then
                self.role_event.hp = msg.n_hp
            end
            if msg.role_event then
                self.role_event = msg.role_event
            end
            if msg.is_fall then
                self.fallFlag = msg.is_fall
                self.fallFlag = true
                _G.Events:GetInstance():Broadcast(_G.eRelicTeam.RelicTeamFall)
            end
            if msg.add_jewel then
                local info = self:GetTeamRoleInfo(_G.PlayerModel:GetInstance():GetPlayerUid())
                ---如果不存在字段或者字段是增加宝石那就加宝石
                if nil == msg.add_jewel_bool or msg.add_jewel_bool == true then
                    info.jewel = info.jewel + msg.add_jewel
                else
                    info.jewel = info.jewel - msg.add_jewel
                end
            end
        elseif msg.ack == 5213 then
            self.fallFlag = true
            if msg.n_energy then
                self.energy = msg.n_energy[1]
                self.energy_time = msg.n_energy[2]
            end
            if msg.n_hp then
                self.role_event.hp = msg.n_hp
            end
            if msg.role_event then
                self.role_event = msg.role_event
            end
            _G.Events:GetInstance():Broadcast(_G.eRelicTeam.RelicTeamFall)
        else
            if msg.n_energy then
                self.energy = msg.n_energy[1]
                self.energy_time = msg.n_energy[2]
            end
            if msg.n_hp then
                self.role_event.hp = msg.n_hp
            end
            if msg.role_event then
                self.role_event = msg.role_event
            end
        end
        if callback then
            callback(msg)
        end
        local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.RelicView.Name)
        if ctrl then
            ctrl:SetLockFinishEventBtnBol(false)
        end
    end)
end

