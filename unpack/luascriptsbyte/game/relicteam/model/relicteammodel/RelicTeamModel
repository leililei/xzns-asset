        else
            _G.DelayFrameDo(function()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicTeamToggleView.Name, "gift")
            end)
        end
    else
        local msg = {}
        msg.name = _G.GetPlayerName()
        msg.type = 1
        msg.power = 0
        self:CreateTeam(msg, function()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicTeamToggleView.Name, "gift")
        end)
    end
end

function RelicTeamModel:ShowRankUp(addNum, lanID)
    self.rankUpList = self.rankUpList or {}
    local content = _G.GetLangPackValue(lanID, addNum)
    table.insert(self.rankUpList, content)
    if not self.rankUpTimer then
        self.rankUpTimer = _G.TimerManager:GetInstance():GetTimer(0.5, self.UpdateRankTimer, self, false, false, true)
        self.rankUpTimer:Start()
    end
end

function RelicTeamModel:UpdateRankTimer()
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    if serverTime > self.end_time then
        if self.rankUpTimer then
            self.rankUpTimer:Stop()
            self.rankUpTimer = nil
        end
    end
    local ctrl1 = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.PowerUpView.Name)
    local ctrl2 = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.FloatTipsView.Name)
    local ctrl3 = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.CommonAwardView.Name)
    local ctrl4 = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.OptionDialogView.Name)
    local ctrl5 = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.OptionDialogByToggleView.Name)

    if not ctrl1 and not ctrl2 and not ctrl3 and not ctrl4 and not ctrl5 then
        if self.rankUpList and self.rankUpList[1] then
            require("CommonTipManager").OpenRankUpView(self.rankUpList[1])
            table.remove(self.rankUpList, 1)
        else
            if self.rankUpTimer then
                self.rankUpTimer:Stop()
                self.rankUpTimer = nil
            end
        end
    end
end

function RelicTeamModel:GetRankData(nowBol)
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    self.lastGetRankTime = self.lastGetRankTime or (serverTime + 601)
    if nowBol or (self.lastGetRankTime - serverTime > 600) then
        require("RecordRankModel"):GetInstance():GetListInfoByPage(
            require("RankUtils").RankType.AncientGodPersonalPoints, nil, 2)
        require("RecordRankModel"):GetInstance():GetListInfoByPage(require("RankUtils").RankType.AncientGodAllianceTeam,
            nil, 2)
    end
end

--- 监测自己的排行榜有没有提升
function RelicTeamModel:CheckSelfRank(type)
    local value, lanID
    if type == require("RankUtils").RankType.AncientGodPersonalPoints then
        value = self.score
        lanID = 90033500241
    elseif type == require("RankUtils").RankType.AncientGodAllianceTeam then
        value = self:GetAllJewel()
        lanID = 90033500240
    end
    local listRankDatas = require("RecordRankModel"):GetInstance():GetListData(type)
    if listRankDatas == nil then
        return
    end

    local selfUid = _G.PlayerModel:GetInstance():GetPlayerUid()

    local oldRank = 0

    for k, v in pairs(listRankDatas) do
        if v.role_info.uid == selfUid then
            oldRank = k
        end
    end

    local newRank
    for i, v in pairs(listRankDatas) do
        local bol
        if v.score then
            bol = value > v.score
        elseif v.gem then
            bol = value > v.gem
        end
        if bol then
            newRank = i
            break
        end
    end
    if newRank and newRank < oldRank then
        self:ShowRankUp(newRank, lanID)
        --self:GetRankData(true)
        local temp = listRankDatas[oldRank]
        table.remove(listRankDatas, oldRank)
        table.insert(listRankDatas, newRank, temp)
    end
end

function RelicTeamModel:GetFinishEventNumInNowLayer()
    return self.role_event.all_e_num or 0
end

function RelicTeamModel:SetFinishEventNumInNowLayer(num)
    self.role_event.all_e_num = num or 0
end

---销毁对象时,析构函数
function RelicTeamModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.OnSixClockUpdateCallback, self)
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.activityTimer then
        self.activityTimer:Stop()
        self.activityTimer = nil
    end
    if self.rankUpTimer then
        self.rankUpTimer:Stop()
        self.rankUpTimer = nil
    end
    self.upLayerTipsBol = nil
    self.activity = nil
end

return RelicTeamModel
