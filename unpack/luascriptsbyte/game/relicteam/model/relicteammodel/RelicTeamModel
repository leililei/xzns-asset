function RelicTeamModel:CalMyPowerByArray()
    local power = 0
    local uid = 0
    local card = nil
    local ratio = self:GetBuffPowerRatio()
    local myInfo = self:GetTeamRoleInfo(_G.PlayerModel:GetInstance():GetPlayerUid())
    if myInfo and myInfo.team then
        for i = 1, #myInfo.team do
            uid = myInfo.team[i].uid
            if uid and uid > 0 then
                card = self:GetCardData(uid)
                power = power + card:GetPower()
            end
        end
    elseif self.array then
        for i = 1, #self.array.sits do
            uid = self.array.sits[i]
            if uid > 0 then
                card = self:GetCardData(uid)
                power = power + card:GetPower()
            end
        end
    end
    uid = nil
    card = nil
    self:SetMyTeamPower(power * ratio, power)
end

---获取卡牌对象
---@param uid number 卡牌uid
---@return CardData
function RelicTeamModel:GetCardData(uid)
    local info = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
    local card
    if not info then
        local assistCards = self:GetMyAssistCards()
        for k, v in ipairs(assistCards) do
            if v.c_info.uid == uid then
                info = v.card or v.c_info
                card = _G.CardData.New()
                card:Parse(info)
                card.assist = 1
                card:SetLevel(300)
                card:SaveEquipmentData(info, true)
                card:SaveDecorationData(info, true)
                if not _G.AppSetting.IsOverseas then
                    card:SaveArtifactData(info, true)
                    card:SaveSpiritualData(info, true)
                end
                card:CalcNowSumProp()
            end
        end
    else
        card = _G.DeepCopy(info)
        card:SetLevel(300)
        card.shenshiPosType = _G.StonePosType.PosZero
        card:CalcNowSumProp()
    end
    return card
end

