---@param msg relic.s2c_relic_info
function RelicTeamModel:ParseData(msg)
    if msg.ack == 1 then
        self.status = msg.relic_info.status
        self.camp = msg.relic_info.camp
        self.jewel = msg.relic_info.jewel or 0
        self.team_info = msg.relic_info.team_info
        self.role_event = msg.relic_info.role_event or {}
        self.role_event.event = self.role_event.event or {}
        self.role_event.all_e_num = self.role_event.all_e_num or 0
        self.multiple = msg.relic_info.role_event.multiple or 1
        self.energy = msg.relic_info.energy or 0
        self.energy_time = msg.relic_info.energy_time
        self.buff_count = msg.relic_info.buff_count or {}
        self:SortBuff()
        self:CalBuffAttNum()
        self.array = msg.relic_info.array
        self.allJewel = 0
        if msg.relic_info.invite then
            self.newInviteBol = true
        end
        if self.team_info then
            if self.team_info.request then
                self.newRequestBol = true
            end
            for k, v in pairs(self.team_info.member_list or {}) do
                v.jewel = v.jewel or 0
                self.allJewel = self.allJewel + v.jewel
            end
            self:FreshAssistInfo()
            self:FreshReceiveAssistInfo()
        end
        self:CalMyPowerByArray()
        -- self.campHeadInfo = {}
        -- self.campHeadInfo[1] = msg.relic_info.camp_role1
        -- self.campHeadInfo[2] = msg.relic_info.camp_role2
        self.curActivityClass = require "ActivitySynManager":GetInstance():GetActivityWithTypeId(10058)
        local eggTime = 0 
        if self.curActivityClass then 
            eggTime = _G.ConfigManager.discrete_cfg[125111][1][1]
        end
        self.EggAwardFlag = msg.relic_info.easter_egg
        self.campNum = msg.relic_info.camp_count
        self.id = msg.pub.season_id or 1
        self.start_time = msg.pub.start_timer
        self.end_time = msg.pub.end_time - eggTime
        self.EggEndTime = msg.pub.end_time
        self.team_time = self.start_time + msg.pub.team_time
        self.fight_time = self.start_time + msg.pub.team_time + msg.pub.fight_time
        self.fallFlag = msg.relic_info.role_event.drop_out
        self.score = msg.relic_info.score or 0
        relic_cfg = _G.ConfigManager.relic_cfg[self.id]
        self:ChangeStatusAndNextTimeLine()

        if self.status and self.status ~= 0 then
            self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimer, self, false, false, true)
            self.timer:Start()
            --todo 改到一个计时器里面
            self:UpdateTimer()

            self.activityTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateActivityTimer, self, false, false,
                true)
            self.activityTimer:Start()
            self:UpdateActivityTimer()
            --require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RelicTeamFullEnergy.id)
        end
        self.activity = require "ActivitySynManager":GetInstance():GetChildAcitivity(10058, 100081)
        if self.activity then
            self.activity:GetActivityTypeCls():RefreshRedPoint()
        end
        _G.Events:GetInstance():Broadcast(_G.eRelicTeam.RelicTeamRefresh)
    elseif msg.ack == 5220 then
        self:SetLaterGetDataBol(true)
        self.status = self.relicStatus.close
    elseif msg.ack == 5 then
        self.status = self.relicStatus.close
        self.activity = require "ActivitySynManager":GetInstance():GetChildAcitivity(10058, 100081)
        require("ActivitySynEnterManager"):GetInstance():RemoveActivityBtn(self.activity)
    end

    self.super.ParseData(self)
end

