function RelicTeamModel:AddEnergy(num)
    self.energy = self.energy + num
    _G.Events:GetInstance():Broadcast(_G.eRelicTeam.RelicTeamUpdateEnergy)
    if self.energy >= relic_cfg.physical[1][1] and self.status == self.relicStatus.explore then
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RelicTeamFullEnergy.id)
    end
    return self.energy
