function RelicTeamModel:RequestTeam(pbData, callback)
    RelicTeamNet:GetInstance():RequestTeam(pbData, function(msg)
        if msg.ack == 1 then
            if msg.team then
                self.team_info = msg.team or {}
                self:FreshAssistInfo()
                self:FreshReceiveAssistInfo()
                _G.Events:GetInstance():Broadcast(_G.eRelicTeam.RelicTeamRefresh)
