        for k1, v1 in ipairs(v.assist_info or {}) do
            if self.assistInfo[v1.uid] then
                if self.assistInfo[v1.uid][v.role_info.uid] then
                    self.assistInfo[v1.uid][v.role_info.uid].c_info = v1.c_info
                else
                    self.assistInfo[v1.uid][v.role_info.uid] = { role = v.role_info, c_info = v1.c_info }
                end
            end
        end
    end
