---根据上次体力恢复事件刷新计时器
---@param energy_time number 上次体力恢复时间
function RelicTeamModel:UpdateTimer()
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    if self.energy > relic_cfg.physical[1][1] then
        self.energy_time = serverTime
    else
        if (serverTime - self.energy_time) >= relic_cfg.physical[2][1] then
            local num = math.floor((serverTime - self.energy_time) / relic_cfg.physical[2][1])
            for i = 1, num do
                if self.energy < relic_cfg.physical[1][1] then
                    self:AddEnergy(relic_cfg.physical[2][2])
                    self.energy_time = self.energy_time + relic_cfg.physical[2][1]
                else
                    break
                end
            end
        end
    end
    if serverTime > self.end_time then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
    end
end

function RelicTeamModel:GetNextEnergyTime()
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    local nextTime = 0
    local nextFullTime = 0
    if self.energy < relic_cfg.physical[1][1] then
        nextTime = self.energy_time + relic_cfg.physical[2][1] - serverTime
        nextFullTime = nextTime + (relic_cfg.physical[1][1] - self.energy - 1) * relic_cfg.physical[2][1]
    end
    return nextTime, nextFullTime
end

---根据下次时间结点刷新计时器
function RelicTeamModel:UpdateActivityTimer()
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    if serverTime >= self.nextTime then
        self:ChangeStatusAndNextTimeLine()
    end
    if serverTime > self.end_time then
        if self.activityTimer then
            self.activityTimer:Stop()
            self.activityTimer = nil
        end
    end
end

