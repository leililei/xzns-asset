function RelicTeamModel:GetEventShowTxtTable()
    local T = {}
    local str1, str2
    if self.role_event.event_show then
        for k, v in ipairs(self.role_event.event_show) do
            if k <= 3 then
                local cfg = relic_events_cfg[v.event_sid]
                if cfg.event_type == 3 or cfg.event_type == 2 then
                    str1 = _G.GetLangPackValue(tonumber(v.args[1]) == 1 and cfg.desc[2][1] or cfg.desc_defeat)
                    -- if v.jewel and v.jewel > 0 then
                    --     str1 = string.format("%s%s", str1, _G.GetLangPackValue(90033500123, v.jewel))
                    -- end
                    table.insert(T, str1)
                    str2 = _G.GetLangPackValue(cfg.desc[1][1])
                    table.insert(T, str2)
                elseif cfg.event_type == 6 then
                    str1 = _G.GetLangPackValue(tonumber(v.args[1]) == 1 and cfg.desc[2][1] or cfg.desc[2][2])
                    -- if v.jewel and v.jewel > 0 then
                    --     str1 = string.format("%s%s", str1, _G.GetLangPackValue(90033500123, v.jewel))
                    -- end
                    table.insert(T, str1)
                    str2 = _G.GetLangPackValue(cfg.desc[1][1])
                    table.insert(T, str2)
                elseif cfg.desc[1] then
                    str1 = _G.GetLangPackValue(cfg.desc[2][1])
                    -- if v.jewel and v.jewel > 0 then
                    --     str1 = string.format("%s%s", str1, _G.GetLangPackValue(90033500123, v.jewel))
                    -- end
                    table.insert(T, str1)
                    str2 = _G.GetLangPackValue(cfg.desc[1][1])
                    table.insert(T, str2)
                end
            end
        end
        T = table.reverseTable(T)
    end
    if self:CheckHaveEventNow() then
        local cfg = relic_events_cfg[self.role_event.event.event_sid]
        str1 = _G.GetLangPackValue(cfg.desc[1][1])
        table.insert(T, str1)
    end
    return T
end

