function RelicTeamModel:AddBuff(args)
    self.buff_count = self.buff_count or {}
    local haveBol
    for k, v in ipairs(self.buff_count) do
        if v.key == args.sid then
            if args.factNum then
                v.value = args.factNum
            else
                v.value = args.fixNum + v.value
            end
            haveBol = true
            break
        end
    end
    if not haveBol then
        table.insert(self.buff_count, { key = args.sid, value = args.factNum or args.fixNum })
        self:SortBuff()
    end
    self:CalBuffAttNum()
end

function RelicTeamModel:SortBuff()
    table.sort(self.buff_count, function(a, b)
        local cfgA = _G.ConfigManager.relic_effect_cfg[a.key]
        local cfgB = _G.ConfigManager.relic_effect_cfg[b.key]
        if cfgA.grade ~= cfgB.grade then
            return cfgA.grade > cfgB.grade
        else
            return a.key < b.key
        end
    end)
end

function RelicTeamModel:GetBuffNum(sid)
    for k, v in ipairs(self.buff_count or {}) do
        if v.key == sid then
            return v.value
        end
    end
    return 0
end

function RelicTeamModel:CalBuffAttNum()
    self.buffAtt = { atk = 0, def = 0, max_hp = 0, bre = 0 }
    for k, v in ipairs(self.buff_count or {}) do
        local data = _G.ConfigManager.relic_effect_cfg[v.key]
        for k1, v1 in ipairs(data.attribute) do
            if self.buffAtt[v1[1]] then
                self.buffAtt[v1[1]] = self.buffAtt[v1[1]] + tonumber(v1[3]) * v.value
            end
        end
    end
end

