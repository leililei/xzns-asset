function RelicTeamModel:__init()
    self.relicStatus = {
        close = 0,
        team = 1,
        explore = 2,
        idle = 3,
        settle = 4
    }
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.OnSixClockUpdateCallback, self)
    local multipleData = _G.ConfigManager.discrete_cfg[125110]
    self.multipleList = {}
    self.multipleEventNumList = {}
    for k, v in ipairs(multipleData) do 
        self.multipleList[k] = v[1]
        self.multipleEventNumList[k] = v[2]
    end
    
    self.team_info = nil
end

