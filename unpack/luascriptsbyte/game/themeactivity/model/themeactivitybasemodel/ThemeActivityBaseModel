---@class ThemeActivityBaseModel	主题活动基类
---@field type ThemeActivityType 活动类型
---@field theme activity_theme.i_theme 主题数据
---@field redTree table {id,lua,child} 红点树
local ThemeActivityBaseModel = _G.BaseClass("ThemeActivityBaseModel", _G.GameDataModelBase)

---创建对象时,入口构造函数
function ThemeActivityBaseModel:OnInitData(type, msg, redId)
    self.type = type
    self.theme = msg.theme
    self.redId = redId
    self.redTree = {}
    self:InitData(msg)
    self:OnInitRedTree()
end

---初始化红点树
function ThemeActivityBaseModel:OnInitRedTree()
    self:InitRedTree()
    local tb = {}
    for i = 1, #self.redTree do
        tb[i] = {
            id = self:GetRedPointId(self.redTree[i][1]),
            lua = self.redTree[i][2],
            child = self.redTree[i][3] or {},
            functionopenid = 0
        }
    end
    require "RedPointManager":GetInstance():AddSyncNodes(tb, true)
end

---销毁对象时,析构函数
function ThemeActivityBaseModel:Dispose()
    self.theme = nil
end

