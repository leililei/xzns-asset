---获取主题红点Id(默认第一个红点为整个主题活动的红点)
function ThemeActivityBaseModel:GetRedPointId(index)
    if not index or index == 1 then
        return self.redId
    else
        return self.redId * 100 + index
    end
end

---刷新红点
function ThemeActivityBaseModel:RefreshRedPoint(id, param)
    require "RedPointManager":GetInstance():RefreshNode(self:GetRedPointId(id), param)
end

