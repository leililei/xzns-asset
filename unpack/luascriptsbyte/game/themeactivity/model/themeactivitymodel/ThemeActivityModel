local ActivitySynManager = require "ActivitySynManager"
local base = require "ActivitySynTypeBase"
---@class ThemeActivityModel : ActivitySynTypeBase 主题活动
---@field info activity_theme.i_activity_theme 主题活动数据
---@field openThemeActivityList ThemeActivityBaseModel[] 开放的活动
local ThemeActivityModel = _G.BaseClass("ThemeActivityModel", base)
local ThemeActivityType = _G.ThemeActivityType
local IsNil = _G.IsNil

---@type ThemeActivityBaseModel[]
local themeModels = {
    [ThemeActivityType.Draw] = require "DrawActivityModel":GetInstance(),
    [ThemeActivityType.Task] = require "ThemeTaskModel":GetInstance(),
    [ThemeActivityType.Sign] = require "ThemeSignModel":GetInstance(),
    [ThemeActivityType.SpiritualGift] = require "SpiritualGiftModel":GetInstance(),
    [ThemeActivityType.Koi] = require "KoiModel":GetInstance(),
    [ThemeActivityType.Treasure] = require "TreasureHuntModel":GetInstance(),
    [ThemeActivityType.CelebrationTrial] = require "CelebrationTrialModel":GetInstance(),
    [ThemeActivityType.Turntable] = require "ThemeTurntableModel":GetInstance(),
    [ThemeActivityType.CashSign] = require "ThemeCashSignModel":GetInstance(),
    [ThemeActivityType.artifact] = require "TreasureHuntingManager":GetInstance()
}
---获取GM数据
---@param info activity.i_activity_self_info
function ThemeActivityModel:OnHandleGMData(info)
    self:ParseData(info)
end

---解析数据
function ThemeActivityModel:ParseData(info)
    self:SetSelfData(info)
    base.ParseData(self)
end

---初始化数据
---@param info activity.i_activity_self_info
function ThemeActivityModel:SetSelfData(info)
    self.info = info.theme
    self.role_spine = self.info.face_photo
    ---背景图+立绘资源配置
    local background = self.info.background
    if not _G.string.IsNullOrEmpty(background) then
        local backgroundArray = _G.string.split2tbl(background, "|")
        ---背景图片路径
        self.backgroundPath = backgroundArray[1]
        ---立绘路径#坐标X#坐标Y#坐标Z
        self.imagePath = backgroundArray[2]
    end
    ---功能图标资源
    self.icon = self.info.icon
    ---特效
    local effects = self.info.effects
    if not _G.string.IsNullOrEmpty(effects) then
        local effectArray = _G.string.split2tbl(effects, "|")
        ---背景图特效
        self.bgEffectPath = effectArray[1]
        ---立绘特效#坐标X#坐标Y#坐标Z
        self.imageEffectPath = effectArray[2]
    end
    local arry = _G.string.split(self.info.display_type, "|")
    self.mainViewName = arry[1]
    self.coinSid = tonumber(arry[2])
    ---标题字体路径
    ---@type string
    self.titleFontPath = arry[3]
    self.openThemeActivityList = {}
    require "ThemeActivityManager":GetInstance():SetCurThemeActitity(self)
    self.startTime = self.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Open)
    self.endTime = self.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    for k, v in pairs(themeModels) do
        if not IsNil(self.info[k]) then
            v:OnInitData(k, self.info[k], self.curActivityClass:GetActivityID() * 100 + self.info[k].theme.index + 1)
            _G.table.insert(self.openThemeActivityList, v)
        end
    end
    _G.SortList(
        self.openThemeActivityList,
        function(data)
            return -data.theme.index
        end
    )
    self:InitRedPoint()
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(self:GetRedpointIDByIndex(1))
end

function ThemeActivityModel:Role_SpineParse()
    --角色id|跳转id|背景资源路径与资源名称#0#0#0|角色美术字资源#-304.1#79.5#0|slogan底图资源#-435.1#40.76#0|<color=#FEF7BA>剑气冲霄</color>!<color=#FEF7BA>神剑伏妖</color>|spine路径#-7.93#8.8#0#0.7
    if self.role_spine == nil or self.role_spine == "Test" then
        return
    end

    self.role_spineList = {}
    local dev = _G.string.split(self.role_spine, "|")
    for key, value in pairs(dev) do
        if key == 1 then
            self.role_spineList.id = _G.tonumber(value)
        elseif key == 2 then
            self.role_spineList.jump_id = _G.tonumber(value)
        elseif key == 3 then
            self.role_spineList.bg = value
        elseif key == 4 then
            self.role_spineList.role = value
        elseif key == 5 then
            self.role_spineList.name = value
        elseif key == 6 then
            self.role_spineList.slogan = value
        elseif key == 7 then
            self.role_spineList.spice = value
        end
    end
    return self.role_spineList
end

---初始化红点
function ThemeActivityModel:InitRedPoint()
    if self.isInited then
        return
    end
    self.redpointTree = {{}}
    local child = {}
    local insert = _G.table.insert
    for _, v in pairs(self.openThemeActivityList) do
        insert(child, v:GetRedPointId())
    end
    self.redpointTree[1] = child
    -- require "RedPointManager":GetInstance():AddSyncNodes(
    --     {{id = self.curActivityClass:GetActivityID(), lua = "RedPointThemeActivity", child = child, functionopenid = 0}}
    -- )
    self.isInited = true
end

---获取主题活动名字
function ThemeActivityModel:GetName(index)
    if IsNil(self.openThemeActivityList[index]) then
        return ""
    end
    return self.openThemeActivityList[index].theme.name
end

---获取主题活动图片
function ThemeActivityModel:GetImage(index)
    if IsNil(self.openThemeActivityList[index]) then
        return ""
    end
    local arry = _G.string.split(self.openThemeActivityList[index].theme.page_pos, "|")
    return arry[1]
end

---获取开放主题
function ThemeActivityModel:GetOpenThemeActivityList()
    return self.openThemeActivityList
end

---获取界面名字
function ThemeActivityModel:OnGetMainViewName()
    if self.mainViewName == _G.ConfigManager.ui_cfg.ThemeActivitySecView.Name then
        return _G.ConfigManager.ui_cfg.ThemeActivitySecView.Name
    elseif self.mainViewName == _G.ConfigManager.ui_cfg.ThemeActivityThirdView.Name then
        return _G.ConfigManager.ui_cfg.ThemeActivityThirdView.Name
    end
    return _G.ConfigManager.ui_cfg.ThemeActivityView.Name
end

---进入活动
function ThemeActivityModel:EnterActivity(param)
    if not self:CheckThemeActivityIsOpen() then
        return
    end
    if param then
        for _, v in pairs(self.openThemeActivityList) do
            if v.type == param then
                v:EnterActivity()
                break
            end
        end
    else
        self:EnterActivityViewByPrefab()
    end
    require "ThemeActivityManager":GetInstance():SetCurThemeActitity(self)
end

---进入活动
function ThemeActivityModel:EnterActivityWithIndex(index)
    if not self:CheckThemeActivityIsOpen() then
        return
    end
    self.openThemeActivityList[index]:EnterActivity()
end

---检测主题活动是否开启
function ThemeActivityModel:CheckThemeActivityIsOpen()
    if self.curActivityClass:GetCurActivityState() == nil then
        return false
    end
    return self.curActivityClass:GetCurActivityState() ~= ActivitySynManager.State.Close
end

---初始化红点树
function ThemeActivityModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {}
end

function ThemeActivityModel:GetRedPointTree()
    return self.redpointTree
end

---接收主题任务推送
function ThemeActivityModel:UpdateTask(taskinfo)
    return require "ThemeTaskModel":GetInstance():UpdateTask(taskinfo)
end

---进入活动
function ThemeActivityModel:OnEnterActivity()
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.ThemeActivityView.Name)
    if window then
        window.View:UpdateView(self.curActivityClass)
    else
        self:EnterActivityViewByPrefab()
    end
    base.OnEnterActivity(self)
end

function ThemeActivityModel:GetRedPointId(index)
    if not self.openThemeActivityList[index] then
        return 0
    end
    return self.openThemeActivityList[index]:GetRedPointId()
end

