---@class ThemeActivityManager : Singleton	主题活动管理
---@field curActitity ThemeActivityModel 主题活动数据
local ThemeActivityManager = _G.BaseClass("ThemeActivityManager", _G.Singleton)

---@return ThemeActivityManager ThemeActivityManager
function ThemeActivityManager:GetInstance()
    return self.super.GetInstance(self)
end

---设置当前 主题活动
---@param activity ThemeActivityModel
function ThemeActivityManager:SetCurThemeActitity(activity)
    self.curActitity = activity
end

---检测主题活动是否开启
function ThemeActivityManager:CheckThemeActivityIsOpen()
    if not self.curActitity then
        return false
    end
    return self.curActitity:CheckThemeActivityIsOpen()
end


function ThemeActivityManager:Role_SpineParse()
    return self.curActitity:Role_SpineParse()
end

---检测活动拍脸图
function ThemeActivityManager:CheckThemeActivityOpenView()
    if self:CheckThemeActivityIsOpen() == true and self:Role_SpineParse() ~= nil then
        local activityID = self:GetActivityID()
        -- body
        local time = _G.PlayerPrefsManager.GetInt("ThemePeakView" .. activityID)
        if
            time == 0 or
                _G.PlayerPrefsManager.GetInt("ThemePeakView" .. activityID) ~=
                    _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
        then
            return true
        end
    end
    return false
end

---获取开启时间
function ThemeActivityManager:GetStartTime()
    if not self.curActitity then
        return false
    end
    return self.curActitity.startTime
end

---获取结束时间
function ThemeActivityManager:GetEndTime()
    if not self.curActitity then
        return false
    end
    return self.curActitity.endTime
end

---获取剩余时间
function ThemeActivityManager:GetRTS()
    if not self.curActitity then
        return false
    end
    return _G.math.max(self:GetEndTime() - _G.TimeUtil.GetServerUnixTime(), 0)
end
---获取活动id
function ThemeActivityManager:GetActivityID()
    if not self.curActitity then
        return 0
    end
    return self.curActitity.curActivityClass:GetActivityID()
end

---进入活动
function ThemeActivityManager:EnterActivity(param)
    if not self:CheckThemeActivityIsOpen() then
        return
    end
    -- _G.UIManager:GetInstance():OpenWindow(
    --     _G.ConfigManager.ui_cfg.ThemeActivityView.Name,
    --     self.curActitity.curActivityClass
    -- )
    self.curActitity:EnterActivityViewByPrefab()
    self.curActitity:EnterActivity(param)
end

function ThemeActivityManager:GetCoinSid()
    if not self.curActitity.coinSid then
        return 105
    end
    return self.curActitity.coinSid
end

return ThemeActivityManager
