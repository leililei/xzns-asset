---@class ThemeTaskView : UIBaseView	中文描述
---@field public go_table ThemeTaskView_GoTable GoTable
---@field taskList ThemeTaskView._obj_task_GoTable[]
---@field taskDatas ThemeTaskData[]
local ThemeTaskView = _G.BaseClass("ThemeTaskView", _G.UIBaseView)
function ThemeTaskView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ThemeTaskView:OnCreate()
    self.model = require "ThemeTaskModel":GetInstance()
    self.taskList = {}
    self.go_table.scrollloopvectical_taskList:InitItemData(0, _G.handler(self, self.RefreshTask))
    self:UpdateView()
end
function ThemeTaskView:UpdateView()
    self.taskDatas = self.model:GetTaskDatas()
    self.go_table.scrollloopvectical_taskList:UpdateCount(#self.taskDatas)
    local canTake=self.model:GetCanFinishTaskList()
    self.go_table.aorbtn_getAll:SetActiveE(#canTake>=2 and 1 or 0)
end
function ThemeTaskView:SortTask()
    self.model:SortTask()
end
---刷新奖励
function ThemeTaskView:RefreshTask(index, obj)
    local id = obj:GetInstanceIDE()
    local tb = self.taskList[id]
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickTask, tb))
        self.taskList[id] = tb
    end
    ---@type HellGuardTaskData
    local data = self.taskDatas[index + 1]
    tb.index = index + 1
    tb.aortext_name.text = data.Cfg.desc
    if data.i_task.state == _G.TaskEnum.ETaskState.Claimed then
        tb.slider_progress.value = data.i_task.target[1] / data.Cfg.count
        tb.aortext_Slider.text = data.i_task.target[1] .. "/" .. data.Cfg.count
    elseif self:CheckIsCanTake(data.id) or self:CheckIsFinish(data.id) then
        tb.slider_progress.value = 1
        tb.aortext_Slider.text = data.Cfg.count .. "/" .. data.Cfg.count
    else
        tb.slider_progress.value = data.i_task.target[1] / data.Cfg.count
        tb.aortext_Slider.text = data.i_task.target[1] .. "/" .. data.Cfg.count
    end
    _G.GameUtil.SetActiveByCondition(tb.aorbtn_get, self:CheckIsCanTake(data.id))
    _G.GameUtil.SetActiveByCondition(
        tb.aorbtn_go,
        data.i_task.state == _G.TaskEnum.ETaskState.Claimed and data.Cfg.link > 0
    )
    _G.GameUtil.SetActiveByCondition(tb.obj_complete, self:CheckIsFinish(data.id))
    if not tb.item1 then
        tb.item1 = require "BaseAwardNewItem".New(tb.obj_award1, nil, 74, tb.obj_Root1)
    end
    tb.item1:Show(_G.StorageManager:GetInstance():GetItemDataClass(data.Cfg.reward[1].sid, data.Cfg.reward[1].num))
    _G.GameUtil.SetActiveByCondition(tb.obj_gou1, self:CheckIsFinish(data.id))
    if not tb.item2 then
        tb.item2 = require "BaseAwardNewItem".New(tb.obj_award2, nil, 74, tb.obj_Root2)
    end
    if data.Cfg.reward[2] == nil or data.Cfg.reward[2].sid == nil then
        tb.obj_award2:SetActiveE(0)
    else
        tb.obj_award2:SetActiveE(1)

        tb.item2:Show(_G.StorageManager:GetInstance():GetItemDataClass(data.Cfg.reward[2].sid, data.Cfg.reward[2].num))
    end
    _G.GameUtil.SetActiveByCondition(tb.obj_gou2, self:CheckIsFinish(data.id))
end
function ThemeTaskView:CheckIsCanTake(sid)
    return self.model:CheckIsCanTake(sid)
end
function ThemeTaskView:CheckIsFinish(sid)
    return self.model:CheckIsFinish(sid)
end

---点击领取奖励
---@param tb ThemeTaskView._obj_task_GoTable
function ThemeTaskView:OnClickTask(go, _, tb)
    local name = go:GetName()
    local taskDatas = self.taskDatas[tb.index]
    if not require "ThemeActivityManager":GetInstance():CheckThemeActivityIsOpen() then
        _G.PopWindowManager:GetInstance():ShowAllTips(3602)
        return
    end
    if name == "@_aorbtn_get" then
        self.model:FinishTask(
            taskDatas.id,
            function(data)
                local datas = {}
                datas.award = {}
                datas.award.item = {}
                if taskDatas.Cfg.reward then
                    for key, value in pairs(taskDatas.Cfg.reward) do
                        local item1 = {
                            type = {
                                value.sid,
                                value.num
                            }
                        }
                        _G.table.insert(datas.award.item, item1)
                    end
                end
                require "CommonTipManager".OpenCommonAwardView(datas)
                self:UpdateView()
            end
        )
    elseif name == "@_aorbtn_go" then
        local link = taskDatas.Cfg.link
        if link then
            if link ~= 0 then
                if _G.ConfigManager.item_way_cfg[link] then
                    _G.JumpManager:GetInstance():Jump(link)
                else
                    require "ActivitySynManager":GetInstance():JumpActivity(link)
                end
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(690102)
            end
        end
    end
end

---按钮点击事件在这里派发
function ThemeTaskView:OnClickBtn(go, isOn)
    if self.isinited == nil then
        self.isinited = false
    elseif self.isinited == false then
        self.isinited = true
    end
    if go == self.go_table.aorbtn_close2 or go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_getAll then
        self.model:FinishAllTask(
            function()
                self:UpdateView()
            end
        )
    end
end

function ThemeTaskView:ShowAward(tb, obj, award, parent)
    if not tb.list then
        tb.list = {}
    end
    local count = #tb.list
    local count2 = #award
    for i = 1, count do
        if i <= count2 then
            tb.list[i]:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(award[i]))
            tb.list[i].gameObject:SetActiveE(1)
        else
            tb.list[i].gameObject:SetActiveE(0)
        end
    end
    if count < count2 then
        for i = count + 1, count2 do
            local obj2 = _G.InstantiateObject(obj)
            obj2:SetParentE(tb.trans_Content)
            local item = require "BaseAwardNewItem".New(obj2, nil, 73, obj2:GetChildE(0))
            tb.list[i] = item
            local data = award[i]
            item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))
            item.gameObject:SetActiveE(1)
        end
    end
end

return ThemeTaskView
