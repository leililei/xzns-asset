---@class ThemeActivitySecView : UIBaseView    主题活动2.0主页面
---@field public go_table ThemeActivitySecView_GoTable GoTable
---@field activity ActivitySynGMActivity 活动信息
---@field activityCls ThemeActivityModel 活动数据
local ThemeActivitySecView = _G.BaseClass("ThemeActivitySecView", _G.UIBaseView)
--_G.ThemeActivitySecView = ThemeActivitySecView

local tonumber = _G.tonumber
local IsNullOrEmpty = _G.string.IsNullOrEmpty

function ThemeActivitySecView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param activity ActivitySynGMActivity 活动信息
function ThemeActivitySecView:OnCreate(activity)
    self.items = {}
    self:UpdateView(activity)
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(self.activityCls:GetRedpointIDByIndex(1))
end

---更新界面
---@param activity ActivitySynGMActivity 活动信息
function ThemeActivitySecView:UpdateView(activity)
    self.activity = activity
    self.activityCls = activity:GetActivityTypeCls()
    self:StartTimer()

    self.iconList = {}
    if not IsNullOrEmpty(self.activityCls.icon) then
        self.iconList = _G.string.split(self.activityCls.icon, "|")
    end
    for i = 1, 5 do
        self:RefreshItem(i, self.go_table["obj_ActivityItem" .. i])
    end

    self:RefreshImage()
    self:LoadTitleFont()
    self:LoadEffect()
    self:LoadTimerPosition()
end

---背景和立绘
function ThemeActivitySecView:RefreshImage()
    if not IsNullOrEmpty(self.activityCls.backgroundPath) then
        self.go_table.aorrawimage_bg:LoadImage(
            self.activityCls.backgroundPath,
            function(image)
                if _G.IsNil(self.go_table.aorrawimage_bg) then
                    return
                end
                image:SetNativeSize()
            end
        )
    end

    if not IsNullOrEmpty(self.activityCls.imagePath) then
        local array = _G.string.split(self.activityCls.imagePath, "#")
        self.go_table.aorrawimage_lh:LoadImage(
            array[1],
            function(image)
                if _G.IsNil(self.go_table.aorrawimage_lh) then
                    return
                end
                image:SetNativeSize()
                image:SetLocalPosition(tonumber(array[2] or 0), tonumber(array[3] or 0), tonumber(array[4] or 0))
            end
        )
    end
end

---背景特效和立绘特效
function ThemeActivitySecView:LoadEffect()
    local bgEffect = _G.ConfigManager.ui_effect_cfg.ef_LBbg
    if not IsNullOrEmpty(self.activityCls.bgEffectPath) then
        bgEffect = {Path = self.activityCls.bgEffectPath}
    end
    _G.UIUtils.LoadEffectByCfg(
        bgEffect,
        self.go_table.obj_effbg,
        function(obj)
            if self:IsNil() then
                _G.DestroyObject(obj)
                return
            end
        end
    )

    local imageEffect = _G.ConfigManager.ui_effect_cfg.ef_DrawUpMainView_LB_front
    if not IsNullOrEmpty(self.activityCls.imageEffectPath) then
        local array = _G.string.split(self.activityCls.imageEffectPath, "#")
        imageEffect = {
            Path = array[1], --应传递string类型?不需要转number
            Scale = 1,
            Pos = {tonumber(array[2] or 0), tonumber(array[3] or 0), tonumber(array[4] or 0)}
        }
    end
    _G.UIUtils.LoadEffectByCfg(
        imageEffect,
        self.go_table.obj_eff,
        function(object)
            if self:IsNil() then
                _G.DestroyObject(object)
                return
            end
        end
    )
end
---加载标题名称(艺术字)
function ThemeActivitySecView:LoadTitleFont()
    local path = self.activityCls.titleFontPath
    if IsNullOrEmpty(path) then
        return
    end
    self.go_table.aorrawimage_uiName:LoadImage(
        path,
        function(image)
            if _G.IsNil(self.go_table.aorrawimage_uiName) then
                return
            end
            image:SetNativeSize()
        end
    )
end
---加载倒计时位置
function ThemeActivitySecView:LoadTimerPosition()
    --倒计时位置配置固定第6个, 前面5个为图标信息
    local info = self.iconList and self.iconList[6] or nil
    if IsNullOrEmpty(info) then
        return
    end
    local x, y, z = table.unpack(_G.string.split(info, "#"))
    if not IsNullOrEmpty(x) or not IsNullOrEmpty(y) or not IsNullOrEmpty(y) then
        self.go_table.obj_countdown:SetLocalPosition(tonumber(x) or 0, tonumber(y) or 0, tonumber(z) or 0)
    end
end

---更新单个物体
function ThemeActivitySecView:RefreshItem(index, obj)
    ---@type ThemeActivitySecView._obj_ActivityItem1_GoTable
    local go_table = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, index))
    local path = self.activityCls:GetImage(index)
    --子功能页签艺术字
    if not IsNullOrEmpty(path) then
        local _path, x, y, z, scale = table.unpack(_G.string.split(path, "#"))
        go_table.aorrawimage_name:LoadImage(
            _G.string.trim(_path),
            function(image)
                if not go_table or _G.IsNil(go_table.aorrawimage_name) then
                    return
                end
                image:SetNativeSize()
                if not IsNullOrEmpty(x) or not IsNullOrEmpty(y) or not IsNullOrEmpty(y) then
                    image:SetLocalPosition(tonumber(x) or 0, tonumber(y) or 0, tonumber(z) or 0)
                end
                if not IsNullOrEmpty(scale) then
                    image:SetLocalScaleXYZ(tonumber(scale) or 1)
                end
            end
        )
    end
    go_table.obj_redpoint:UpdateRedPointItemIDAndParam(self.activityCls:GetRedPointId(index))
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_ThemeActivitySecView_denglong,
        go_table.obj_eff,
        function(object)
            if self:IsNil() then
                _G.DestroyObject(object)
                return
            end
            object:SetLocalScaleXYZ(1.44)
        end
    )
    --子功能页签图片和缩放角度
    if not IsNullOrEmpty(self.iconList[index]) then
        local aorimage = go_table.aorbtn_Lantern:GetComponentE(_G.typeof(_G.CS.AorRawImage))
        local array = _G.string.split(self.iconList[index], "#")
        local scale, angle = array[5], array[6]
        aorimage:LoadImage(
            array[1],
            function(image)
                if _G.IsNil(aorimage) then
                    return
                end
                image:SetNativeSize()
                image:SetLocalScaleXYZ(1)
                image:SetLocalEulerAngles(0, 0, tonumber(angle) or 0)
            end
        )
        go_table.obj_info:SetLocalPosition(tonumber(array[2] or 0), tonumber(array[3] or 0), tonumber(array[4] or 0))
        if not IsNullOrEmpty(scale) then
            go_table.obj_info:SetLocalScaleXYZ(tonumber(scale) or 1)
        end
    end
end

---倒计时显示
function ThemeActivitySecView:StartTimer()
    self.RTS = require "ThemeActivityManager":GetInstance():GetRTS()
    if self.RTS < 0 then
        self.RTS = 0
    end
    self.go_table.aortext_time.text =
        _G.LangUtil.GetLangPackValue(90039010001, _G.TimeUtil.TranslateSecondForStrDHMS(self.RTS))
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.OnTimeCall, self, false, false, true)
    self.timer:Start()
end

---更新时间
function ThemeActivitySecView:OnTimeCall(elapsed)
    if _G.IsNil(self.timer) then
        return
    end
    if self.RTS > 0 then
        self.RTS = self.RTS - elapsed
        self.go_table.aortext_time.text =
            _G.LangUtil.GetLangPackValue(90039010001, _G.TimeUtil.TranslateSecondForStrDHMS(Mathf.RoundToInt(self.RTS)))
    else
        self.timer:Stop()
    end
end

---点击功能
function ThemeActivitySecView:OnClickItem(_, _, index)
    self.activityCls:EnterActivityWithIndex(index)
end

---按钮点击事件在这里派发
function ThemeActivitySecView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

function ThemeActivitySecView:OnStartClose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return ThemeActivitySecView
