---@class ThemeActivityView : UIBaseView	中文描述
---@field public go_table ThemeActivityView_GoTable GoTable
---@field activity ActivitySynGMActivity 活动信息
---@field activityCls ThemeActivityModel 活动数据
local ThemeActivityView = _G.BaseClass("ThemeActivityView", _G.UIBaseView)
--_G.ThemeActivityView = ThemeActivityView

function ThemeActivityView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_ThemeActivityView_Bg, self.go_table.obj_BgEffect)
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_ThemeActivityView_huoxing, self.go_table.obj_BgEffect)
    _G.DelayDo(
        0.27,
        function()
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_ThemeActivityView_shuaguang,
                self.go_table.obj_moon
            )
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_ThemeActivityView_title,
                self.go_table.obj_tittle
            )
        end
    )
end

---界面的入口函数
---@param activity ActivitySynGMActivity 活动信息
function ThemeActivityView:OnCreate(activity)
    self.items = {}
    self.go_table.scrollloophorizontal_itemList:InitItemData(0, _G.handler(self, self.RefreshItem))
    self:UpdateView(activity)
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(self.activityCls:GetRedpointIDByIndex(1))
end

---更新界面
---@param activity ActivitySynGMActivity 活动信息
function ThemeActivityView:UpdateView(activity)
    self.activity = activity
    self.activityCls = activity:GetActivityTypeCls()
    local count = #self.activityCls:GetOpenThemeActivityList()
    self.go_table.scrollloophorizontal_itemList:UpdateCount(count)
    if count > 5 then
        self.go_table.scrollloophorizontal_itemList:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect)).horizontal =
            true
    end
    self.RTS = require "ThemeActivityManager":GetInstance():GetRTS()
    if nil == self.timer then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.timer:Start()
    end
    self:UpdateTime(0)
    self:UpdateRole()
end
---更新人物
function ThemeActivityView:UpdateRole()
    local arry = _G.string.split(self.activityCls.info.theme_pos, "|")
    local path = _G.string.trim(arry[1])
    self.go_table.aorrawimage_role:LoadImage(
        path,
        function(raw)
            if raw then
                raw:SetNativeSize()
            end
        end
    )
    if #arry > 1 then
        arry = _G.string.split(arry[2], "|")
        self.go_table.aorrawimage_role:SetLocalPosition(arry[1] or 0, arry[2] or 0, arry[3] or 0)
    end
end

---更新单个物体
function ThemeActivityView:RefreshItem(index, obj)
    local go_table = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, index + 1))
    go_table.aortext_name.text = self.activityCls:GetName(index + 1)
    local path = self.activityCls:GetImage(index + 1)
    if not _G.string.IsNullOrEmpty(path) then
        path = _G.string.trim(path)
        go_table.aorrawimage_bg:LoadImage(path)
    end

    go_table.obj_redpoint:UpdateRedPointItemIDAndParam(self.activityCls:GetRedPointId(index + 1))
end
---更新时间
function ThemeActivityView:UpdateTime(fix)
    self.RTS = self.RTS - fix
    if self.RTS <= 0 then
        self.go_table.aortext_time.text =
            _G.LangUtil.GetLangPackValue(90022500595) ..
            _G.LangUtil.GetLangPackValue(
                90021800086,
                "<color=#ffffff>" .. 0 .. "</color>",
                "<color=#ffffff>" .. 0 .. "</color>"
            )
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        return
    else
        local time = _G.TimeUtil.TranslateSecond(self.RTS)
        if time.day > 1 then
            self.go_table.aortext_time.text =
                _G.LangUtil.GetLangPackValue(90022500595) ..
                _G.LangUtil.GetLangPackValue(90025500011, "<color=#ffffff>" .. time.day .. "</color>", "")
        elseif time.hour > 0 then
            if time.day > 0 then
                time.hour = time.hour + time.day * 24
            end
            self.go_table.aortext_time.text =
                _G.LangUtil.GetLangPackValue(90022500595) ..
                _G.LangUtil.GetLangPackValue(
                    90022100002,
                    "<color=#ffffff>" .. time.hour .. "</color>",
                    "<color=#ffffff>" .. time.min .. "</color>"
                )
        else
            self.go_table.aortext_time.text =
                _G.LangUtil.GetLangPackValue(90022500595) ..
                _G.LangUtil.GetLangPackValue(
                    90021800086,
                    "<color=#ffffff>" .. time.min .. "</color>",
                    "<color=#ffffff>" .. time.sec .. "</color>"
                )
        end
    end
end

---点击功能
function ThemeActivityView:OnClickItem(_, _, index)
    self.activityCls:EnterActivityWithIndex(index)
end

---按钮点击事件在这里派发
function ThemeActivityView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

function ThemeActivityView:OnStartClose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return ThemeActivityView
