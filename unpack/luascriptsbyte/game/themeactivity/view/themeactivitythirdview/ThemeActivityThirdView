---@class ThemeActivityThirdView : UIBaseView    主题活动2.0主页面
---@field public go_table ThemeActivityThirdView_GoTable GoTable
---@field activity ActivitySynGMActivity 活动信息
---@field activityCls ThemeActivityModel 活动数据
local ThemeActivityThirdView = _G.BaseClass("ThemeActivityThirdView", _G.UIBaseView)
--_G.ThemeActivityThirdView = ThemeActivityThirdView

function ThemeActivityThirdView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param activity ActivitySynGMActivity 活动信息
function ThemeActivityThirdView:OnCreate(activity)
    self.items = {}
    self:UpdateView(activity)
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(self.activityCls:GetRedpointIDByIndex(1))
    self:LoadEffect()
end

function ThemeActivityThirdView:LoadEffect()
    local check = function(trans)
        if self:IsNil() then
            _G.DestroyObject(trans)
        end
    end
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_ThemeActivityThirdView_bg,
        self.go_table.obj_eff,
        check
    )
end

---更新界面
---@param activity ActivitySynGMActivity 活动信息
function ThemeActivityThirdView:UpdateView(activity)
    self.activity = activity
    self.activityCls = activity:GetActivityTypeCls()
    self:StartTimer()
    for i = 1, 5 do
        self:RefreshItem(i, self.go_table["obj_ActivityItem" .. i])
    end
end

---更新单个物体
function ThemeActivityThirdView:RefreshItem(index, obj)
    ---@type ThemeActivityThirdView._obj_ActivityItem1_GoTable
    local go_table = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, index))
    local path = self.activityCls:GetImage(index)
    if not _G.string.IsNullOrEmpty(path) then
        path = _G.string.trim(path)
        go_table.aorrawimage_name:LoadImage(
            path,
            function(trans)
                trans:SetNativeSize()
            end
        )
    end
    go_table.obj_redpoint:UpdateRedPointItemIDAndParam(self.activityCls:GetRedPointId(index))
end

---倒计时显示
function ThemeActivityThirdView:StartTimer()
    self.RTS = require "ThemeActivityManager":GetInstance():GetRTS()
    if self.RTS < 0 then
        self.RTS = 0
    end
    self.go_table.aortext_time.text =
        _G.LangUtil.GetLangPackValue(90039010001, _G.TimeUtil.TranslateSecondForStrDHMS(self.RTS))
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.OnTimeCall, self, false, false, true)
    self.timer:Start()
end

---更新时间
function ThemeActivityThirdView:OnTimeCall(elapsed)
    if _G.IsNil(self.timer) then
        return
    end
    if self.RTS > 0 then
        self.RTS = self.RTS - elapsed
        self.go_table.aortext_time.text =
            _G.LangUtil.GetLangPackValue(90039010001, _G.TimeUtil.TranslateSecondForStrDHMS(Mathf.RoundToInt(self.RTS)))
    else
        self.timer:Stop()
    end
end

---点击功能
function ThemeActivityThirdView:OnClickItem(_, _, index)
    self.activityCls:EnterActivityWithIndex(index)
end

---按钮点击事件在这里派发
function ThemeActivityThirdView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

function ThemeActivityThirdView:OnStartClose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return ThemeActivityThirdView
