    _G.table.insert(pos, _G.tonumber(_G.string.split(self.Role_SpineParse.spice, "#")[3]))
    _G.table.insert(pos, _G.tonumber(_G.string.split(self.Role_SpineParse.spice, "#")[4]))
    _G.table.insert(pos, _G.tonumber(_G.string.split(self.Role_SpineParse.spice, "#")[5]))
