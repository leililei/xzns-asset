    self.go_table.obj_role:SetActiveE(0)
    -- if self.role_spineList.int == 1 then
    self.go_table.aorrawimage_role:SetActiveE(1)
    _G.UIUtils.LoadEffectByPath(pos[1], self.go_table.aorrawimage_role)
    --     self.go_table.aorrawimage_role:SetLocalPosition(pos[2], pos[3], pos[4])
    --     self.go_table.aorrawimage_role:SetLocalScale(roleScale, roleScale, roleScale)
    --     --大小缩放
    -- elseif self.role_spineList.int == 2 then
    --self.go_table.aorrawimage_role:SetActiveE(1)
    -- --立绘路径
    -- self.go_table.aorrawimage_role:LoadImage(
    --     pos[1],
    --     function(trans)
    --         if self:IsNil() then
    --             _G.DestroyObject(trans)
    --             return
    --         end
    --         trans:SetNativeSize()
    --     end
    -- )
    self.go_table.aorrawimage_role:SetLocalPosition(pos[2], pos[3], pos[4])
    self.go_table.aorrawimage_role:SetLocalScale(roleScale, roleScale, roleScale)
    --end
end

function ThemePeakView:RoleShow_SetSkill(go_table, sid)
    local card_skills_cfg = _G.ConfigManager.card_skills_cfg

    ---技能obj索引
    local ObjIndex = 00
    local SetFun = function(skill_i)
        local skillid = sid + skill_i * 100 + 1
        local skillCfg = card_skills_cfg[skillid]
        if skillCfg ~= nil then
            ObjIndex = ObjIndex + 1

            if ObjIndex == 1 then
                ---如果解锁了 第一个技能是怒气技
                local nuqi = go_table.aorimage_nuqi
                if nuqi then
                    _G.GameUtil.SetActiveByCondition(nuqi, skillCfg.skill_pos == 1)
                end
            end
            go_table["aorrawimage_SkillIcon (" .. ObjIndex .. ")"]:LoadImage(skillCfg.icon)
            -- go_table["aorrawimage_SkillType (" .. ObjIndex .. ")"]:LoadImage(skillCfg.skill_type)
            go_table["aorimage_Skill (" .. ObjIndex .. ")"]:SetActiveE(1)
            _G.SetEventTrigger(
                go_table["aorimage_Skill (" .. ObjIndex .. ")"],
                "onClick",
                _G.handlerbind(self, self.RoleShow_SkillTips, skillid)
            )
        end
    end
    SetFun(1)

    SetFun(3)
    SetFun(4)
    SetFun(5)

    ObjIndex = ObjIndex + 1
    for i = ObjIndex, 4 do
        ---隐藏无技能 按钮
        go_table["aorimage_Skill (" .. i .. ")"]:SetActiveE(0)
    end
end

function ThemePeakView:RoleShow_SkillTips(_, _, skillId)
    require("CommonTipManager"):GetInstance():OpenSkillTip(skillId)
end

---@private
function ThemePeakView:OnDisable()
end

---界面的销毁函数
function ThemePeakView:OnDestroy()
end

---按钮点击事件在这里派发
function ThemePeakView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeView then
        self:Close()
    elseif go == self.go_table.aorbtn_skip then
        _G.JumpManager:GetInstance():Jump(self.Role_SpineParse.jump_id)
    end

    if self.go_table.toggle_eject.isOn then
        local activityID = ThemeActivityManager:GetInstance():GetActivityID()
        _G.PlayerPrefsManager.SetInt("ThemePeakView" .. activityID,
            _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime()))
    end
end

return ThemePeakView