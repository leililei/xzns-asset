---获取赛季立绘数据
function ThemePeakView:SetRoleDate()
    self.Role_SpineParse = ThemeActivityManager:GetInstance():Role_SpineParse()
    if self.Role_SpineParse == nil or self.Role_SpineParse.id == nil then
        self:Close()
    end
    ---@type card_cfg
