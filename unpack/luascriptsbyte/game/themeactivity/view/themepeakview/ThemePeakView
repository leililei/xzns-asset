    if cfg == nil then
        return
    end

    local ElementEnum = {
        [1] = "ui_js_btn_shuxing_lei",
        [2] = "ui_js_btn_shuxing_feng",
        [3] = "ui_js_btn_shuxing_shui",
        [4] = "ui_js_btn_shuxing_huo",
        [5] = "ui_js_btn_shuxing_tu",
        [6] = "ui_js_btn_shuxing_shen"
    }
    self.go_table.aorimage_tip.SpriteName = ElementEnum[cfg.Elements]


    local pos = {}
    _G.table.insert(pos, _G.string.split(self.Role_SpineParse.bg, "#")[1])
    _G.table.insert(pos, _G.tonumber(_G.string.split(self.Role_SpineParse.bg, "#")[2]))
    _G.table.insert(pos, _G.tonumber(_G.string.split(self.Role_SpineParse.bg, "#")[3]))
    _G.table.insert(pos, _G.tonumber(_G.string.split(self.Role_SpineParse.bg, "#")[4]))
    --背景路径
    self.go_table.aorrawimage_BG:LoadImage(
        pos[1],
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            trans:SetNativeSize()
        end
    )
    self.go_table.aorrawimage_BG:SetLocalPosition(pos[2], pos[3], pos[4])

    pos = {}
    _G.table.insert(pos, _G.string.split(self.Role_SpineParse.role, "#")[1])
    _G.table.insert(pos, _G.tonumber(_G.string.split(self.Role_SpineParse.role, "#")[2]))
    _G.table.insert(pos, _G.tonumber(_G.string.split(self.Role_SpineParse.role, "#")[3]))
    _G.table.insert(pos, _G.tonumber(_G.string.split(self.Role_SpineParse.role, "#")[4]))
    --背景路径
    self.go_table.aorrawimage_title:LoadImage(
        pos[1],
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            trans:SetNativeSize()
        end
    )
    self.go_table.aorrawimage_title:SetLocalPosition(pos[2], pos[3], pos[4])
    pos = {}
    _G.table.insert(pos, _G.string.split(self.Role_SpineParse.name, "#")[1])
    _G.table.insert(pos, _G.tonumber(_G.string.split(self.Role_SpineParse.name, "#")[2]))
    _G.table.insert(pos, _G.tonumber(_G.string.split(self.Role_SpineParse.name, "#")[3]))
    _G.table.insert(pos, _G.tonumber(_G.string.split(self.Role_SpineParse.name, "#")[4]))
    --背景路径
    self.go_table.aorrawimage_DiText:LoadImage(
        pos[1],
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            trans:SetNativeSize()
        end
    )
    self.go_table.aorrawimage_DiText:SetLocalPosition(pos[2], pos[3], pos[4])

    pos = {}
    _G.table.insert(pos, _G.string.split(self.Role_SpineParse.slogan, "!")[1])
    _G.table.insert(pos, _G.string.split(self.Role_SpineParse.slogan, "!")[2])
    self.go_table.aortext_diText1.text = pos[1]
    self.go_table.aortext_diText2.text = pos[2]
    local Tweening = _G.CS.DG.Tweening
    local x, y, z = self.go_table.obj_role:GetLocalPosition()
