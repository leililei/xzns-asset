local base = require "BaseGameNet"

---@class ThemeTaskNet : BaseGameNet	通信协议
local ThemeTaskNet = _G.BaseClass("ThemeTaskNet", base)

---@return ThemeTaskNet ThemeTaskNet
function ThemeTaskNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---许愿
---@param pbData table PB数据
---@param callback function 完成回调
function ThemeTaskNet:FinishTask(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_module_theme_finish
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function ThemeTaskNet:Callback(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type ThemeTaskNet
_G.ThemeTaskNet = ThemeTaskNet
return ThemeTaskNet
