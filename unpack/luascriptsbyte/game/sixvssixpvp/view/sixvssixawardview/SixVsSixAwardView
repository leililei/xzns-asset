---@class SixVsSixAwardView : UIBaseView	中文描述
---@field public go_table SixVsSixAwardView_GoTable GoTable
local SixVsSixAwardView = _G.BaseClass("SixVsSixAwardView", _G.UIBaseView)

local pageIndex = {
    rank = 3,
    day = 2,
    season = 1
}
function SixVsSixAwardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end


---界面的入口函数
function SixVsSixAwardView:OnCreate()
    self.curView = nil
    self.curViewIndex = 0
    self.choose = {
        self.go_table.obj_choose1,
        self.go_table.obj_choose2,
        self.go_table.obj_choose3
    }
    self:OnRankToggleClick(true)
end

function SixVsSixAwardView:OnDestroy()
    self.curView = nil
    self.curViewIndex = nil
    self.onBtnTag = nil
end

---按钮点击事件在这里派发
function SixVsSixAwardView:OnClickBtn(go)
    if self.onBtnTag then
        return
    end
    self.onBtnTag = true
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_bg then
        self.curView:Close()
        self:Close()
    elseif go == self.go_table.aorbtn_rank then
        self:OnSeasonToggleClick()
    elseif go == self.go_table.aorbtn_day then
        self:OnRankToggleClick()
    elseif go == self.go_table.aorbtn_season then
        self:OnLevelToggleClick()
    end
end

function SixVsSixAwardView:OnLevelToggleClick()
    if self.curViewIndex == pageIndex.rank then
        self.onBtnTag = false
        return
    end
    if self.curView then
        self.curView:Close()
    end
    self.curViewIndex = pageIndex.rank
    self:ShowChoose()
    self.curOpenViewName = _G.ConfigManager.ui_cfg.SixVsSixLevelAwardView.Name
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpen, self)
    self.curView = _G.UIManager:GetInstance():OpenWindow(self.curOpenViewName,self).View
end

function SixVsSixAwardView:OnRankToggleClick()
    if self.curViewIndex == pageIndex.day then
        self.onBtnTag = false
        return
    end
    if self.curView then
        self.curView:Close()
    end
    self.curViewIndex = pageIndex.day
    self:ShowChoose()
    self.curOpenViewName = _G.ConfigManager.ui_cfg.SixVsSixRankAwardView.Name
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpen, self)
    self.curView = _G.UIManager:GetInstance():OpenWindow(self.curOpenViewName,self).View
end

function SixVsSixAwardView:OnSeasonToggleClick()
    if self.curViewIndex == pageIndex.season then
        self.onBtnTag = false
        return
    end
    if self.curView then
        self.curView:Close()
    end
    self.curViewIndex = pageIndex.season
    self:ShowChoose()
    self.curOpenViewName = _G.ConfigManager.ui_cfg.SixVsSixRankView.Name
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpen, self)
    self.curView = _G.UIManager:GetInstance():OpenWindow(self.curOpenViewName,self).View
    --_G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.pageSwitchAuido)
end

function SixVsSixAwardView:ShowChoose()
    for i = 1, #self.choose do
        self.choose[i]:SetActiveE(i == self.curViewIndex and 1 or 0)
    end
end

function SixVsSixAwardView:OnViewOpen(name)
    if name ~= self.curOpenViewName then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpen, self)
    self.onBtnTag = false
    self.curView.transform:SetParentE(self.go_table.trans_panel)
    self.curView.transform:SetLocalScaleToOne()
end

return SixVsSixAwardView