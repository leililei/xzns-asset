local SixVsSixRankItem = _G.BaseClass("SixVsSixRankItem")
local rankImageName = {
    "tz_qjhs_phb_mingci_01",
    "tz_qjhs_phb_mingci_02",
    "tz_qjhs_phb_mingci_03"
}
local rankBgName = {
    "tz_qjhs_di_02",
    "tz_qjhs_di_03",
    "tz_qjhs_di_04",
    "ui_jjc_pic_jinjijl"
}
local UIUtils = _G.UIUtils
local ItemFactory = _G.ItemFactory
local RewardDatas
local SixVsSixPVPModel
local GetLangPackValue = _G.GetLangPackValue
function SixVsSixRankItem:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end
function SixVsSixRankItem:Dispose()
    self.go_table = nil
    self.uid = nil
end

function SixVsSixRankItem:Show(data, index, my)
    self.go_table.aortext_score.text = data.score
    local role_info = data.role_info
    local name = role_info.name
    local onClick
    if data.type == 1 then
        name = GetLangPackValue(role_info.name)
        onClick = function()
            _G.SystemSettingManager:GetInstance():OpenRobotPlayInfo(role_info.uid, nil,
            _G.RobotType.Other,data.role_info)
        end
    end
    self.go_table.aortext_name.text = name
    self.uid = data.uid
    self.awardData = self:GetRankData(index)
    UIUtils.SetPlayerHeadItemNew(self.go_table.obj_HeadItemBase,role_info,0.8,true,true,true,onClick)
    if my or index > 3 then
        if index == 0 then
            self.go_table.aortext_mNumber.text = _G.GetLangPackValue(90022900040)
        else
            self.go_table.aortext_mNumber.text = index
        end
        if not my then
            self.go_table.aortext_mNumber:SetActiveE(1)
            self.go_table.aorimage_rank:SetActiveE(0)
            self.go_table.aorimage_bg:SetActiveE(0)
        end
    else
        self.go_table.aortext_mNumber:SetActiveE(0)
        self.go_table.aorimage_rank:SetActiveE(1)
        self.go_table.aorimage_rank.SpriteName = rankImageName[index]
        self.go_table.aorimage_rank:SetNativeSize()
        self.go_table.aorimage_bg:SetActiveE(1)
        self.go_table.aorimage_bg.SpriteName = rankBgName[index]
    end
    self.go_table.aortext_Power.text = _G.GameUtil.NumberToUnitStrFight(role_info.power)
    self:ShowAward(self.awardData.reward_daily)
end

---点击事件
function SixVsSixRankItem:OnClickBtn(go)
    if go == self.go_table.aorbtn_info then
        --TODO:查看玩家信息界面
        _G.SystemSettingManager:GetInstance():OpenView(self.uid)
    end
end

---显示奖励
function SixVsSixRankItem:ShowAward(award)
    if self.itemList then
        for i = 1, #self.itemList do
            ItemFactory:GetInstance():SetItemCard(self.itemList[i])
        end
    end
    self.itemList = {}
    local insert = _G.table.insert
    if award then
        for i = 1, #award do
            ItemFactory:GetInstance():GetItemCard(
                ItemFactory.itemType.ItemBaseWithCount,
                self.go_table.obj_grid,
                function(item)
                    item:Show(award[i][1], nil, award[i][2])
                    insert(self.itemList, item)
                end
            )
        end
    end
end

---获取排名奖励
function SixVsSixRankItem:GetRankData(index)
    if index <= 0 then
        return nil
    end
    for _, v in ipairs(RewardDatas) do
        if index >= v.max_rank and index <= v.min_rank then
            return v
        end
    end
    return nil
end

--endregion
---@class SixVsSixRankView : UIBaseView	中文描述
---@field public go_table ArenaFairRankView_GoTable GoTable
local SixVsSixRankView = _G.BaseClass("SixVsSixRankView", _G.UIBaseView)

function SixVsSixRankView:Awake()
end

---界面的入口函数
function SixVsSixRankView:OnCreate(parent)
    self.parent = parent
    SixVsSixPVPModel = require"SixVsSixPVPModel":GetInstance()
    --local ArenaManager = require "ArenaManager"
    RewardDatas = SixVsSixPVPModel.DayRankAward
    self.ranks = SixVsSixPVPModel:GetRanks()
    self.myRankItem = SixVsSixRankItem.New(self.go_table.obj_myItem)
    self:OnRankListCall(self.ranks)
    --self.arenaClass:GetRankInfo(0, 0, _G.handler(self, self.OnRankListCall))
end

---界面的销毁函数
function SixVsSixRankView:OnDestroy()
    self.myRankItem:Dispose()
    self.myRankItem = nil
    if self.rankItemTab then
        for _, value in pairs(self.rankItemTab) do
            value:Dispose()
        end
        self.rankItemTab = nil
    end
    self.arenaClass = nil
end

function SixVsSixRankView:OnRankListCall(msg)
    if msg then
        self.rankDataList = msg
        self.rankItemTab = {}
        self.go_table.scrollloopvectical_award:InitItemData(#msg, _G.handler(self, self.OnRankObjCall))
    end
    local PlayerModelIns = _G.PlayerModel:GetInstance()
    self.myRankItem:Show(
        {
        score = SixVsSixPVPModel.score,
        role_info = {
            name = PlayerModelIns:GetName(),
            style = PlayerModelIns:GetRoleStyle(),
            frame = PlayerModelIns:GetCurFrame(),
            level = PlayerModelIns:GetLevel(),
            title = PlayerModelIns:GetTitle(),
            power = SixVsSixPVPModel.defencePower}},
        SixVsSixPVPModel.rank,
        true
    )
end

function SixVsSixRankView:OnRankObjCall(index, obj)
    if index < 0 then
        return
    end
    local id = obj:GetInstanceIDE()
    local item = self.rankItemTab[id]
    if not item then
        item = SixVsSixRankItem.New(obj)
        self.rankItemTab[id] = item
    end
    index = index + 1
    item:Show(self.rankDataList[index], index)
end

function SixVsSixRankView:EscClose()
    if self.parent then
        self.parent.curView:Close()
        self.parent:Close()
    end
end

return SixVsSixRankView