---@class SixVsSixChanllengeView : UIBaseView	中文描述
---@field public go_table SixVsSixChanllengeView_GoTable GoTable
local SixVsSixChallengeItem = _G.BaseClass("SixVsSixChallengeItem")
local SixVsSixPVPNet
local SixVsSixPVPModel
function SixVsSixChallengeItem:__init(obj, challengeCall)
    self.gameObject = obj
    self.onChallengeCallback = challengeCall
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.refreshTime = 0
    self.refreshTimer = nil
end

function SixVsSixChallengeItem:OnClickBtn(go)
    if go == self.go_table.aorbtn_chanllenge then
        if self.onChallengeCallback then
            self.onChallengeCallback(self.enemyUid,self.enemyType,self.data)
        end
    end
end

function SixVsSixChallengeItem:Show(data, free, mpower)
    self.data = data
    self.enemyUid = data.uid
    self.enemyType = data.type
    self.go_table.aortext_score.text = data.score
    if data.type == 1 then
        data.name = _G.GetLangPackValue(data.name)
    end
    self.go_table.aortext_name.text = data.name
    if mpower and mpower < data.power then
        self.go_table.aortext_power.text =
        string.format("<color=#ff0000>%s</color>", _G.GameUtil.NumberToUnitWord(data.power))
    else
        self.go_table.aortext_power.text = _G.GameUtil.NumberToUnitWord(data.power)
    end
    local portraitCfg = _G.ConfigManager.player_portrait_cfg[data.style]
    _G.UIUtils.SetAorImageByPath(self.go_table.aorimage_head, portraitCfg.portrait1)
    self.go_table.aortext_victoryScore.text =_G.LangUtil.GetLangPackValue(90022100046,SixVsSixPVPModel.winScore)
    self.go_table.obj_free:SetActiveE(free and 1 or 0)
    self.go_table.obj_challenge:SetActiveE(free and 0 or 1)
    self.gameObject:SetActiveE(1)
end
--endregion

---@class SixVsSixChallengeView : UIBaseView	中文描述
---@field public go_table SixVsSixChallengeView_GoTable GoTable
local SixVsSixChallengeView = _G.BaseClass("SixVsSixChallengeView", _G.UIBaseView)
function SixVsSixChallengeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SixVsSixChallengeView:OnCreate()
    SixVsSixPVPNet = require("SixVsSixPVPNet"):GetInstance()
    SixVsSixPVPModel = require"SixVsSixPVPModel":GetInstance()
    self.freshCd = SixVsSixPVPModel.freshCd
    self.ticketID = SixVsSixPVPModel.ticketID
    self.power = SixVsSixPVPModel.defencePower
    self.isFirst = true
    self.onChallengeHandler = _G.handler(self, self.OnChallengeBtn)
    self.itemList = {
        SixVsSixChallengeItem.New(self.go_table.obj_chanllengeItem1, self.onChallengeHandler),
        SixVsSixChallengeItem.New(self.go_table.obj_chanllengeItem2, self.onChallengeHandler),
        SixVsSixChallengeItem.New(self.go_table.obj_chanllengeItem3, self.onChallengeHandler),
        SixVsSixChallengeItem.New(self.go_table.obj_chanllengeItem4, self.onChallengeHandler)
    }
    for i = 1, #self.itemList do
        self.itemList[i].gameObject:SetActiveE(0)
    end
    --self.arenaClass = ArenaManager:GetInstance():GetArenaClass(1)
    self.refreshTime = 0
    SixVsSixPVPNet:GetEnemyData(_G.handler(self, self.OnEnemyArrayCall))
end

function SixVsSixChallengeView:OnEnable()
    self:Show()
end

function SixVsSixChallengeView:OnDisable()
end

function SixVsSixChallengeView:OnDestroy()
    --SixVsSixPVPModel:RemoveTimer()
    if self.refreshTimer then
        self.refreshTimer:Stop()
        self.refreshTimer = nil
    end
    self.arenaClass = nil
    self.onChallengeHandler = nil
end

---按钮点击事件在这里派发
function SixVsSixChallengeView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_bg then
        --ArenaController:GetInstance():OnChallengeViewBack()
        self:Close()
    elseif go == self.go_table.aorbtn_chanllengeTimes then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ItemBuyView.Name,
            10009,
            _G.handler(self, self.OnBuyTicketCall)
        )
    elseif go == self.go_table.aorbtn_fresh then
        self:FreshEnemy()
    end
end

---刷新敌人
function SixVsSixChallengeView:FreshEnemy()
    if self.refreshTime > 0 then --提示刷新时间
        _G.PopWindowManager:GetInstance():ShowAllTips(300106)
    else
        SixVsSixPVPNet:RefreshEnemyData(_G.handlerbind(self, self.OnEnemyArrayCall,true))
        --self.arenaClass:RefreshEnemy(_G.handler(self, self.OnEnemyArrayCall), _G.handler(self, self.OnFreshBtnTimeCall))
    end
end

---刷新界面
function SixVsSixChallengeView:RefreshView()
    self.go_table.aortext_chanllengeTimes.text = SixVsSixPVPModel:GetFightTicketNum()
    SixVsSixPVPNet:GetEnemyData(_G.handler(self, self.OnEnemyArrayCall))
end

---挑战卷购买回调
function SixVsSixChallengeView:OnBuyTicketCall(result)
    if result == 1 then
        self.go_table.aortext_chanllengeTimes.text = SixVsSixPVPModel:GetFightTicketNum()
    end
end

---挑战按钮点击事件
function SixVsSixChallengeView:OnChallengeBtn(uid,type,data)
    if not SixVsSixPVPModel:CheckIsOpen() then
        local closeFun = function()
            self:Close()
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SixVsSixMainView.Name)
        end
        _G.PopWindowManager:GetInstance():ShowAllTips(300301, nil,  closeFun, closeFun)
        return
    end
    if SixVsSixPVPModel:GetAllFightTimes() <= 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(300101)
        return
    end
    SixVsSixPVPModel:Challenge(uid,type,data)
end

function SixVsSixChallengeView:Show()
    self.go_table.aortext_chanllengeTimes.text = SixVsSixPVPModel:GetFightTicketNum()
end

---获取敌人信息回调
---isFresh 代表手动刷新
function SixVsSixChallengeView:OnEnemyArrayCall(msg,isFresh)
    if msg.ack ~= 1 then
        return
    end
    local list = msg.enemy
    local times, sum = SixVsSixPVPModel:GetFreshEnemyTimes(isFresh)
    if isFresh then
        SixVsSixPVPModel.lastRefreshTime  = _G.TimeUtil.GetServerUnixTime()
        self.refreshTime = SixVsSixPVPModel.freshCd
    else
        self.refreshTime = SixVsSixPVPModel.lastRefreshTime + SixVsSixPVPModel.freshCd - _G.TimeUtil.GetServerUnixTime()
    end
    if self.refreshTime > 0 then
        self.refreshTimer = _G.TimerManager:GetInstance():GetTimer(1, self.RefreshCool, self, false)
        self.refreshTimer:Start()
        self.go_table.aortext_fresh.text = _G.string.format(_G.GetLangPackValue(90026100037), Mathf.RoundToInt(self.refreshTime))
    else
        if self.refreshTimer then
            self.refreshTimer:Stop()
        end
        self.go_table.aortext_fresh.text = _G.GetLangPackValue(90021700009)
    end
    self.go_table.aortext_freshtimes.text = _G.LangUtil.GetLangPackValue(90022100107,times, sum)
    local freeFight = SixVsSixPVPModel.fightTimes > 0
    local power = self.power
    for i = 1, #list do
        if i > #self.itemList then
            break
        end
        self.itemList[i]:Show(list[i], freeFight, power)
    end
end




---刷新冷却时间
function SixVsSixChallengeView:RefreshCool(elapsed)
    --local time = SixVsSixPVPModel.lastRefreshTime + SixVsSixPVPModel.freshCd - _G.TimeUtil.GetServerUnixTime()
    self.refreshTime = self.refreshTime - (elapsed or 1)
    if self.refreshTime > 0 then
        self.go_table.aortext_fresh.text = _G.string.format(_G.GetLangPackValue(90026100037), Mathf.RoundToInt(self.refreshTime))
    else
        self.refreshTimer:Stop()
        self.go_table.aortext_fresh.text = _G.GetLangPackValue(90021700009)
    end
end

---更新界面
function SixVsSixChallengeView:UpdateView()
    self:RefreshView()
end

return SixVsSixChallengeView