---@class SxiVsSixReportView : UIBaseView	中文描述
---@field public go_table ArenaPeakReportPanelView_GoTable GoTable
local SxiVsSixReportView = _G.BaseClass("SxiVsSixReportView", _G.UIBaseView)

function SxiVsSixReportView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
end

---界面的入口函数
function SxiVsSixReportView:OnCreate(sid)
    local SixVsSixPVPModel = require "SixVsSixPVPModel":GetInstance()
    self.itemTransDic = {}
    self.go_table.scrollloopvectical_report:InitItemData(0, _G.handler(self, self.RefreshItem))
    SixVsSixPVPModel:GetReport(_G.handler(self, self.ShowReport))
    SixVsSixPVPModel.haveNewReport = false
    SixVsSixPVPModel.curActivityClass.typeClass:UpdateReport()
    self:AddListener(_G.eBattleState.RecordStart, self.OnRecordStart)
    self:AddListener(_G.eBattleState.RecordEnd, self.OnRecordEnd)
end

function SxiVsSixReportView:OnRecordStart()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SixVsSixReportView.Name)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SixVsSixMainView.Name)
end

function SxiVsSixReportView:OnRecordEnd()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.SixVsSixReportView.Name)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.SixVsSixMainView.Name)
end
function SxiVsSixReportView:OnDestroy()
    if self.itemTransDic then
        for _, value in pairs(self.itemTransDic) do
            value:Dispose()
        end
    end
end
---按钮点击事件在这里派发
function SxiVsSixReportView:OnClickBtn(go)
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
    self:Close()
end

function SxiVsSixReportView:ShowReport(data)
    self.reportList = data or {}
    local count = #self.reportList or 0
    self.go_table.obj_emptybg:SetActiveE(count == 0 and 1 or 0)
    self.go_table.scrollloopvectical_report:UpdateCount(count)
end

function SxiVsSixReportView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    local instanceID = obj:GetInstanceIDE()
    if not self.itemTransDic[instanceID] then
        self.itemTransDic[instanceID] = SixVsSixReportViewItem.New(obj)
    end
    index = index + 1
    self.itemTransDic[instanceID]:Show(self.reportList[index])
end

return SxiVsSixReportView
