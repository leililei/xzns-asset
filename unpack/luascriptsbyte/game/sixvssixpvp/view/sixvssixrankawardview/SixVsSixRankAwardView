local descStr = _G.GetLangPackValue(90022100112)
local descStr2 = _G.GetLangPackValue(90022100121)
local descStr3 = _G.GetLangPackValue(90022100122)
--region 奖励item
local SixVsSixRankAwardItem = _G.BaseClass("SixVsSixRankAwardItem")
local insert = _G.table.insert
local rankBgName = {
    "tz_qjhs_di_02",
    "tz_qjhs_di_03",
    "tz_qjhs_di_04",
    "ui_jjc_pic_jinjijl"
}
local rankIconName = {
    "tz_qjhs_phb_mingci_01",
    "tz_qjhs_phb_mingci_02",
    "tz_qjhs_phb_mingci_03"
}
function SixVsSixRankAwardItem:__init(obj)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj)
    self.itemList = {}
end
function SixVsSixRankAwardItem:Dispose()
    self.go_table = nil
    self.gameObject = nil
    local ItemFactoryIns = _G.ItemFactory:GetInstance()
    for i = 1, #self.itemList do
        ItemFactoryIns:SetItemCard(self.itemList[i])
    end
    self.itemList = nil
end
---显示
---@param id number 奖励id
---@param index number 排名序列号
---@return 变量类型 中文描述
function SixVsSixRankAwardItem:Show(data, index)
    self.gameObject:SetActiveE(1)
    self:ShowDay(data, index)
end
function SixVsSixRankAwardItem:ShowDay(data, index)
    local str = ""
    if data.min_rank == data.max_rank then
        str = string.format(descStr, data.min_rank)
    else
        if data.max_rank >= 99999 then
            str = string.format(descStr3, data.min_rank)
        else
            str = string.format(descStr2, data.max_rank,data.min_rank)
        end
    end
    self.go_table.aortext_mScoreRank.text = str
    if index <= 3 then
        self.go_table.aorimage_rank.SpriteName = rankIconName[index]
        self.go_table.aorimage_rankbg.SpriteName = rankBgName[index]
        self.go_table.aorimage_rank:SetActiveE(1)
    else
        self.go_table.aorimage_rankbg.SpriteName = rankBgName[4]
        self.go_table.aorimage_rank:SetActiveE(0)
    end
    self:ShowAward(data.reward_daily)
end


---显示奖励
function SixVsSixRankAwardItem:ShowAward(award)
    local ItemFactory = _G.ItemFactory
    for i = 1, #self.itemList do
        ItemFactory:GetInstance():SetItemCard(self.itemList[i])
    end
    self.itemList = {}
    local insert = _G.table.insert
    for i = 1, #award do
        ItemFactory:GetInstance():GetItemCard(
            ItemFactory.itemType.ItemBaseWithCount,
            self.go_table.trans_mItemRoot,
            function(item)
                item:Show(award[i][1], nil, award[i][2])
                insert(self.itemList, item)
            end
        )
    end
end
--endregion

---@class SixVsSixRankAwardView : UIBaseView	中文描述
---@field public go_table SixVsSixRankAwardView_GoTable GoTable
local SixVsSixRankAwardView = _G.BaseClass("SixVsSixRankAwardView", _G.UIBaseView)

function SixVsSixRankAwardView:Awake()
    self.itemList = {}
    self.itemTransDic = {}
    self.awardList = {}
end

---界面的入口函数
function SixVsSixRankAwardView:OnCreate(parent)
    self.parent = parent
    self:ShowList()
    self:ShowMyRank()
end
function SixVsSixRankAwardView:Close()
    local ItemFactory = _G.ItemFactory
    for i = 1, #self.itemList do
        ItemFactory:GetInstance():SetItemCard(self.itemList[i])
    end
    for _, item in pairs(self.itemTransDic) do
        item:Dispose()
    end
    self.itemTransDic = nil
    _G.UIBaseView.Close(self)
end

function SixVsSixRankAwardView:ShowList()
    self.awardList = require"SixVsSixPVPModel":GetInstance().DayRankAward
    _G.SortList(
        self.awardList,
        function(a)
            return -a.min_rank
        end
    )
    self.go_table.scrollloopvectical_award:InitItemData(#self.awardList, _G.handler(self, self.RefreshItem))
end

function SixVsSixRankAwardView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    local instanceID = obj:GetInstanceIDE()
    if not self.itemTransDic[instanceID] then
        self.itemTransDic[instanceID] = SixVsSixRankAwardItem.New(obj)
    end
    index = index + 1
    self.itemTransDic[instanceID]:Show(self.awardList[index], index)
end

function SixVsSixRankAwardView:ShowMyRank()
    local award = {}
    --我的排名
    local rank = require"SixVsSixPVPModel":GetInstance().rank
    self.go_table.aortext_mNumber.text = rank
    for k,v in pairs(self.awardList) do
        if v.min_rank >= rank and v.max_rank <= rank then
            award = v.reward_daily
            if v.min_rank == v.max_rank then
                self.go_table.aortext_mScoreRank.text = string.format(descStr, v.min_rank)
            else
                if v.max_rank >= 99999 then
                    self.go_table.aortext_mScoreRank.text = string.format(descStr3, v.min_rank)
                else
                    self.go_table.aortext_mScoreRank.text = string.format(descStr2,v.max_rank,v.min_rank)
                end
            end
            break
        end
    end
    local ItemFactory = _G.ItemFactory
    self.itemList = {}
    for i = 1, #award do
        ItemFactory:GetInstance():GetItemCard(
            ItemFactory.itemType.ItemBaseWithCount,
            self.go_table.trans_mItemRoot,
            function(item)
                item:Show(award[i][1], nil, award[i][2])
                _G.table.insert(self.itemList, item)
            end
        )
    end
end

function SixVsSixRankAwardView:EscClose()
    if self.parent then
        self.parent.curView:Close()
        self.parent:Close()
    end
end

return SixVsSixRankAwardView
