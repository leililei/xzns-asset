---@class SixVsSixMainView : UIBaseView	中文描述
---@field public go_table SixVsSixMainView_GoTable GoTable
local SixVsSixMainView = _G.BaseClass("SixVsSixMainView", _G.UIBaseView)
---@type SixVsSixPVPModel
local SixVsSixPVPModel
local TimeUtil
--local SixVsSixPVPNet = require("SixVsSixPVPNet"):GetInstance()
local UIUtils = _G.UIUtils
local GetLangPackValue = _G.GetLangPackValue
function SixVsSixMainView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SixVsSixMainView:OnCreate()
    SixVsSixPVPModel = require("SixVsSixPVPModel"):GetInstance()
    TimeUtil = _G.TimeUtil
    self.go_table.obj_missionRedpoint:UpdateRedPointItemIDAndParam(
        SixVsSixPVPModel.curActivityClass.typeClass:GetRedpointIDByIndex(3)
    )
    self.go_table.obj_embattleRedpoint:UpdateRedPointItemIDAndParam(
        SixVsSixPVPModel.curActivityClass.typeClass:GetRedpointIDByIndex(4)
    )
    self.go_table.obj_reportRedpoint:UpdateRedPointItemIDAndParam(
        SixVsSixPVPModel.curActivityClass.typeClass:GetRedpointIDByIndex(5)
    )
    if SixVsSixPVPModel.curActivityClass.typeClass.exchange then
        self.go_table.obj_exchangeRedpoint:UpdateRedPointItemIDAndParam(
            SixVsSixPVPModel.curActivityClass.typeClass.exchangeRedPoint
        )
    end
    self.resource =
    self:AddComponent(
    self.go_table.obj_resourceRoot,
    require("ResourceCompont").New(self.go_table.obj_resourceRoot, _G.ConfigManager.ui_cfg.SixVsSixMainView.resources))
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_SixVsSixMainView_BG,self.go_table.trans_bgParent)
    self.littleRank = _G.GetAutoGoTable(self.go_table.obj_littleZonePanel,_G.handler(self,self.RankClick))
    self:SetPlayerData()
    self:SetRank()
    self:InitTime()
end

---排行榜点击事件
function SixVsSixMainView:RankClick(go)
    local name = go:GetName()
    if name == "@_aorbtn_openLeft" then
        self.littleRank.obj_ShowPanel:SetActiveE(1)
        self.littleRank.obj_hideRank:SetActiveE(0)
    elseif name == "@_aorbtn_closeLeft" then
        self.littleRank.obj_ShowPanel:SetActiveE(0)
        self.littleRank.obj_hideRank:SetActiveE(1)
    end
end

---界面的销毁函数
function SixVsSixMainView:OnDestroy()
    self:StopTimer()
end

function SixVsSixMainView:Dispose()
    self:StopTimer()
end

---按钮点击事件在这里派发
function SixVsSixMainView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_report then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SixVsSixReportView.Name)
    elseif go == self.go_table.aorbtn_start then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SixVsSixChanllengeView.Name)
    elseif go == self.go_table.aorbtn_embattle then
        local function OnEmbattleViewOpen(self, name)
            _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, OnEmbattleViewOpen, self)
            self:Hide()
        end
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, OnEmbattleViewOpen, self)
        SixVsSixPVPModel:OpenEmbattle()
    elseif go == self.go_table.aorbtn_award then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SixVsSixAwardView.Name)
    elseif go == self.go_table.aorbtn_mission then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SixVsSixMissionView.Name)
    elseif go == self.go_table.aorbtn_exchange then
        SixVsSixPVPModel:JumpExchange()
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 77)
    end
end

---设置自身数据
function SixVsSixMainView:SetPlayerData()
    local playerModel = _G.PlayerModel:GetInstance()
    local playerData = {}
    playerData.frame = playerModel:GetCurFrame()
    playerData.style = playerModel:GetRoleStyle()
    playerData.uid = playerModel:GetPlayerUid()
    playerData.lv = playerModel:GetLevel()
    playerData.title = playerModel:GetTitle()
    _G.UIUtils.SetPlayerHeadItemNew(self.go_table.obj_HeadItemBase, playerData, 1, true)
    self.go_table.aortext_name.text = playerModel:GetName()
    self.go_table.aortext_power.text = _G.GameUtil.NumberToUnitWord(SixVsSixPVPModel.defencePower)
    self.go_table.aortext_rate.text = SixVsSixPVPModel.winRate .. "%"
    self.go_table.aortext_rank.text = SixVsSixPVPModel.rank
    self.go_table.aortext_point.text = SixVsSixPVPModel.score
    self.go_table.aortext_limit.text = GetLangPackValue(90022100106, SixVsSixPVPModel.fightTimes)
    self:InitSelfRank(playerData)
end

---初始化排行榜自身数据
function SixVsSixMainView:InitSelfRank(playerData)
    local tb = _G.GetAutoGoTable(self.littleRank.obj_rankplayer)
    local rank = SixVsSixPVPModel.rank
    tb.aorimage_rank:SetActiveE(0)
    if rank == 0 then
        if tb.obj_selfplayer then
            tb.obj_selfplayer:SetActiveE(1)
        end
        tb.aortext_rank.text = GetLangPackValue(90026500029)
    elseif rank <= 3 then
        tb.aorimage_rank.SpriteName = "tz_qjhs_phb_mingci_0" .. rank
        tb.aorimage_rank:SetActiveE(1)
        if tb.obj_selfplayer then
            tb.obj_selfplayer:SetActiveE(0)
        end
    else
        tb.aortext_rank.text = rank
        if tb.obj_selfplayer then
            tb.obj_selfplayer:SetActiveE(1)
        end
    end
    tb.aortext_name.text = _G.PlayerModel:GetInstance():GetName()
    if SixVsSixPVPModel.defencePower then
        tb.obj_power:SetActiveE(1)
        tb.aortext_name:SetLocalPosition(-22.9, 23.8, 0)
        tb.aortext_power.text = _G.GameUtil.NumberToUnitStrBag(SixVsSixPVPModel.defencePower)
    else
        tb.obj_power:SetActiveE(0)
        tb.aortext_name:SetLocalPosition(-22.9, 5, 0)
        tb.aortext_power.text = ""
    end
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, playerData, 1, true, true, true)
    tb.aortext_value.text = SixVsSixPVPModel.score
    self.littleRank.obj_rankplayer:SetActiveE(1)
end

---设置排行榜数据
function SixVsSixMainView:SetRank()
    SixVsSixPVPModel:GetRank(_G.handler(self, self.RefreshRank))
end
---刷新排行榜
function SixVsSixMainView:RefreshRank(msg)
    if not msg or not msg.ranks then
        return
    end
    self.ranks = msg.ranks
    self.littleRank.scrollloopvectical_rank:InitItemData(#self.ranks, _G.handler(self, self.RefreshRankItem))
    self.littleRank.obj_ShowPanel:SetActiveE(0)
    self.littleRank.obj_ShowPanel:SetLocalPosition(0, 0, 0)
    for i = 1, 3 do
        local data = msg.ranks[i]
        local onClick
        local tb = _G.GetAutoGoTable(self.go_table["trans_rank" .. i])
        local name = data.role_info.name
        if data.type == 1 then
            name = GetLangPackValue(name)
            onClick = function()
                _G.SystemSettingManager:GetInstance():OpenRobotPlayInfo(
                    data.role_info.uid,
                    nil,
                    _G.RobotType.SixVsSix,
                    data.role_info
                )
            end
        end
        UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data.role_info, 1, true, false, false, onClick)
        tb.aortext_name.text = name
        tb.aortext_point.text = data.score
        tb.aortext_rate.text = data.win_rate .. "%"
    end

    --战斗结束时的排行是异步的(不能及时更新排名名词)
    --此处尝试从排行榜中获取自身数据, 如果存在直接更新自身数据(界面显示一致)
    local selfUid = _G.PlayerModel:GetInstance():GetPlayerUid()
    for rank, d in pairs(msg.ranks) do
        if d.role_info.uid == selfUid then
            SixVsSixPVPModel:UpdateRankSelf(
                {
                    rank = rank,
                    score = d.score,
                    rate = d.win_rate
                }
            )
            self:SetPlayerData()
            break
        end
    end
end

---刷新排行榜
function SixVsSixMainView:RefreshRankItem(index, obj)
    index = index + 1
    local data = self.ranks[index]
    local roleInfo = data.role_info
    local tb = _G.GetAutoGoTable(obj)
    tb.aorimage_rank:SetActiveE(0)
    tb.aortext_rank.text = ""
    if tb.aortext_no then
        tb.aortext_no.text = ""
    end
    if tb.obj_selfplayer then
        tb.obj_selfplayer:SetActiveE(0)
    end
    local rank = index
    if rank == 0 then
        if tb.obj_selfplayer then
            tb.obj_selfplayer:SetActiveE(1)
        end
        tb.aortext_rank.text = GetLangPackValue(90026500029)
    elseif rank <= 3 then
        tb.aorimage_rank.SpriteName = "tz_qjhs_phb_mingci_0" .. rank
        tb.aorimage_rank:SetActiveE(1)
    else
        tb.aortext_rank.text = rank
        if tb.obj_selfplayer then
            tb.obj_selfplayer:SetActiveE(1)
        end
    end
    -- if tb.aortext_no and data.player_mingci == 0 then
    --     tb.aortext_no.text = LangUtil.GetLangPackValue(90026500029)
    -- end
    local onClick
    if data.type == 1 then
        tb.aortext_name.text = GetLangPackValue(roleInfo.name)
        onClick = function()
            _G.SystemSettingManager:GetInstance():OpenRobotPlayInfo(data.role_info.uid, nil, _G.RobotType.SixVsSix,data.role_info)
        end
    else
        tb.aortext_name.text = roleInfo.name
    end
    if roleInfo.power then
        tb.obj_power:SetActiveE(1)
        tb.aortext_name:SetLocalPosition(-22.9, 23.8, 0)
        tb.aortext_power.text = _G.GameUtil.NumberToUnitStrBag(roleInfo.power)
    else
        tb.obj_power:SetActiveE(0)
        tb.aortext_name:SetLocalPosition(-22.9, 5, 0)
        tb.aortext_power.text = ""
    end
    tb.aortext_value.text = data.score
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, roleInfo, 1, true, true, false, onClick)
end
---初始化倒计时
function SixVsSixMainView:InitTime()
    local endTime = SixVsSixPVPModel:GetEndTime()
    local curTime = _G.TimeUtil.GetServerUnixTime()
    self.timeRemain = endTime - curTime
    self.go_table.aortext_time.text = TimeUtil.TranslateSecondForStrSixVsSix(self.timeRemain)
    self.Timer =
        _G.TimerManager:GetInstance():GetTimer(
        1,
        self.ShowTime,
        self,
        false,
        false,
        true
        -- self.go_table.aortext_timedown1
    )
    self.Timer:Start()
end

---活动剩余时间计时器
function SixVsSixMainView:ShowTime(elapsed)
    self.timeRemain = self.timeRemain - elapsed
    self.go_table.aortext_time.text = TimeUtil.TranslateSecondForStrSixVsSix(Mathf.RoundToInt(self.timeRemain))
    if self.timeRemain <= 0 then
        self:StopTimer()
        SixVsSixPVPModel:OnQuit()
    end
end

---停止计时器
function SixVsSixMainView:StopTimer()
    if self.Timer then
        self.Timer:Stop()
        self.Timer = nil
    end
end

---刷新界面
function SixVsSixMainView:UpdateView()
    self:SetPlayerData()
    self:SetRank()

    ---更新货币状态
    if self.resource then
        self.resource:RestRs(_G.ConfigManager.ui_cfg.SixVsSixMainView.resources)
    end
end

return SixVsSixMainView
