function SixVsSixMissionView:WasTaken(sid,type)
    return self.finishMissionList[sid]
end

function SixVsSixMissionView:CheckCanTake(index,type)
    if self.missionList[index] then
        local data = self.missionList[index]
        if data.need <= data.curr and not self.finishMissionList[data.sid] then
            return true
        end
    end
    return false
end


