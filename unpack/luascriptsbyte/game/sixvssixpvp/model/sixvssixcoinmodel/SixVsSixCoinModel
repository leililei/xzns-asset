---@class SixVsSixCoinModel : Singleton	中文描述
local SixVsSixCoinModel = _G.BaseClass("SixVsSixCoinModel", _G.Singleton)
local CS = _G.CS
local typeof = _G.typeof

---@return SixVsSixCoinModel SixVsSixCoinModel
function SixVsSixCoinModel:GetInstance()
    return self.super.GetInstance(self)
end

function SixVsSixCoinModel:__init()
    _G.Events:GetInstance():AddListener(_G.eArena.SetSixVsSix, self.AddCoin, self)
end

---销毁对象时,析构函数
function SixVsSixCoinModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eArena.SetSixVsSix, self.AddCoin, self)
end

---设置活动
function SixVsSixCoinModel:SetActivity(activity)
    self.activity = activity
end
---设置coin
function SixVsSixCoinModel:SetCoin(coin)
    self.coin = coin
end
---增加代币
function SixVsSixCoinModel:AddCoin(num)
    self.coin = self.coin + num
    local tmp = {}
    _G.table.insert(tmp, 109)
    _G.table.insert(tmp, num)
    _G.table.insert(tmp, self.coin)
    _G.Events:GetInstance():Broadcast(_G.eItemUpdata.Updata, {{type = tmp}})
end
---获取代币
function SixVsSixCoinModel:GetCoin()
    return self.coin or 0
end
---兑换id
function SixVsSixCoinModel:SetExchangeId(id)
    self.exchangeId = id
end
---获取兑换id
function SixVsSixCoinModel:GetExchangeId()
   return self.exchangeId or 0
end

return SixVsSixCoinModel