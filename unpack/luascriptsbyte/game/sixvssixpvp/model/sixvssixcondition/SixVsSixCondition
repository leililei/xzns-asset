---@class SixVsSixCondition : Singleton	中文描述
local SixVsSixCondition = _G.BaseClass("SixVsSixCondition", _G.Singleton)
local GetLangPackValue = _G.GetLangPackValue
local career = {
    [1] = 90000200101,
    [2] = 90000200201,
    [3] = 90000200301,
    [4] = 90000200401,
    [5] = 90000200501,
    [6] = 90000200601,
}

local attribute = {
    [1] = 90000800101,
    [2] = 90000800201,
    [3] = 90000800301,
    [4] = 90000800401,
    [5] = 90000800501,
}

local join = {
    [1] = 90001005905,
    [2] = 90001005907
}

local take = {
    [1] = 90001005908,
    [2] = 90001005909
}

---@return SixVsSixCondition SixVsSixCondition
function SixVsSixCondition:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function SixVsSixCondition:__init()
end

---销毁对象时,析构函数
function SixVsSixCondition:Dispose()
end

function SixVsSixCondition:CheckCondition(data)
    local condition
    condition = data.condition
    local text
    if condition[1] == 3 then
        local str1 = GetLangPackValue(career[condition[3]])
        local str3 = GetLangPackValue(join[condition[4]])
        text = GetLangPackValue(data.language,condition[2],str1,str3,data.need)
    elseif condition[1] == 5 then
        text = GetLangPackValue(data.language,data.extra)
    elseif condition[1] == 7 then
        local str1 = GetLangPackValue(take[condition[2]])
        local str2 = GetLangPackValue(attribute[condition[3]])
        local str3 = GetLangPackValue(join[condition[4]])
        text = GetLangPackValue(data.language,str1,str2,str3,data.need)
    else
        text = GetLangPackValue(data.language,data.need)
    end
    return text
end

return SixVsSixCondition