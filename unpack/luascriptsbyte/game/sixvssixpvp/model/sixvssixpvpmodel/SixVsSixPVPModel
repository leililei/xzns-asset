function SixVsSixPVPModel:ParseData(msg, typeClass)
    self.curActivityClass = typeClass
    self.curActivityClass.model = self
    local data = msg.season_duel
    if data.info then
        local info = data.info
        self.fightTimes = info.fight_num or 0
        self.rank = info.rank or 0
        self.winRate = info.win_rate or 0
        self.defencePower = info.power or 0
        self.score = info.score or 0
        self.lastRefreshTime = info.last_refresh or 0
        self.refreshTimes = info.refresh_times or 0
        self.attacked = info.attacked or 0
        require "SixVsSixCoinModel":GetInstance():SetCoin(info.coin)
        self:InitMission(info)
        self:InitRankAward(data)
        self:UpdateView()
    end
    if self.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Open then
        self:GetReport()
    end
    --base.ParseData(self)
end

