function SixVsSixPVPModel:GetReport(callback, data)
    if self.reportList then
        if callback then
            callback(self.reportList)
        end
    else
        SixVsSixPVPNet:GetReport(function(data)
            if data.ack == 1 then
                self.reportList = data.reports
                if callback then
                    callback(self.reportList)
                end
            end
        end)
    end
end

---添加单条战报
function SixVsSixPVPModel:AddSingleReport(data)
    if not self.reportList then
        self:GetReport(
            function()
                self.curActivityClass.typeClass:UpdateReport()
            end
        )
    else
        _G.table.insert(self.reportList, 1, data)
        self.curActivityClass.typeClass:UpdateReport()
    end
end

---获取排行榜数据
function SixVsSixPVPModel:GetRanks()
    return self.ranks
end

return SixVsSixPVPModel
