---初始化任务进度
function SixVsSixPVPModel:InitMission(info)
    local table = _G.table
    local insert = table.insert
    self.missionList = {}
    self.finishMissionList = {}
    if info.task_info then
        for k, v in pairs(info.task_info) do
            local data = {}
            data.language = v.language
            data.order = v.order
            data.sid = v.sid
            data.type = v.type
            local coin = {}
            coin.type = {109, v.coin}
            data.award = v.award
            data.isFinish = false
            data.coin = v.coin
            insert(data.award, coin)
            data.condition = {}
            for i = 1, #v.condition - 1 do
                data.condition[i] = v.condition[i]
            end
            if data.condition[1] == 5 then
                data.need = 1
                data.extra = v.condition[2]
            else
                data.need = v.condition[#v.condition]
            end
            insert(self.missionList, data)
        end
    end
    if info.task_curr then
        for k, v in pairs(info.task_curr) do
            for k1, v1 in pairs(self.missionList) do
                if table.same(v.type, v1.condition) then
                    v1.curr = v.curr
                    if v1.condition[1] == 5 then
                        if v.curr > 0 and v.curr <= v1.extra then
                            v1.curr = 1
                        else
                            v1.curr = 0
                        end
                    end
                end
            end
        end
    end
    if info.finish_task then
        for k, v in pairs(info.finish_task) do
            self.finishMissionList[v] = true
        end
    end
    self.curActivityClass.typeClass:UpdateMission()
end

