---变更分数
function SixVsSixPVPModel:ChangeScore(win)
    if win then
        self.score = self.score + self.winScore
        return self.score - self.winScore, self.winScore, self.loseScore
    else
        self.score = self.score - self.loseScore
        return self.score, self.loseScore
    end
end

