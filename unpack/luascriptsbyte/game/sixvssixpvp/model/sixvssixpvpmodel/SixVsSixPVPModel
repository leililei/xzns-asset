---完成任务并领奖
function SixVsSixPVPModel:GetMissionAward(data,callback)
    SixVsSixPVPNet:GetMissionAward(data,function(msg)
        if msg.ack ~= 1 then
            return
        end
        local coins = 0
        for k,v in pairs(self.missionList) do
            for k1,v1 in pairs(data) do
                if v.sid == v1 then
                    coins = coins + v.coin
                    self.finishMissionList[v1] = true
                end
            end
        end
        local coinData = {[1] = 109,[2] = coins}
        if coins > 0 then
           table.insert(msg.award.item,{type = coinData})
        end
        _G.Events:GetInstance():Broadcast(_G.eArena.SetSixVsSix, coins)
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name,msg,callback)
        self.curActivityClass.typeClass:UpdateMission()
    end)
end

---变更任务进度
function SixVsSixPVPModel:ChangeMission(data)
    for k, v in pairs(data) do
        for k1, v1 in pairs(self.missionList) do
            if table.same(v.type, v1.condition) then
                v1.curr = v.curr
                if v1.condition[1] == 5 then
                    if v.curr > 0 and v.curr <= v1.extra then
                        v1.curr = 1
                    else
                        v1.curr = 0
                    end
                end
            end
        end
    end
    self.curActivityClass.typeClass:UpdateMission()
end

