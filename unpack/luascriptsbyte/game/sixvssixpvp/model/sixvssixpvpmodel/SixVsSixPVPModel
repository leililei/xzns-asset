    self.attackEmbattle = team
    if self:CheckEmbattleEmpty(self.defenceEmabattle) then
        self.defenceEmabattle = self.attackEmbattle
        SixVsSixPVPNet:SetArray(_G.EmbattleType.SixVsSixPVPDefence, team)
        self.curActivityClass.typeClass:UpdateDefence()
    end
    SixVsSixPVPNet:SetArray(_G.EmbattleType.SixVsSixPVPAttack, team, callback)
end

