---检测进攻阵容是否为空
function SixVsSixPVPModel:CheckAttackTeamIsEmpty()
    if self.attackEmbattle == nil then
        return true
    end
    -- 1位置为第一队，2,3 位置为第二队，456为第3对 有一队为空，战斗就直接算队伍为空
    if self.attackEmbattle[1].sid == 0 or (self.attackEmbattle[2].sid == 0 and self.attackEmbattle[3].sid ==0) or (self.attackEmbattle[4].sid ==0 and self.attackEmbattle[5].sid ==0 and self.attackEmbattle[6].sid == 0)then
        return true
    end
    return false
end

---挑战对手
function SixVsSixPVPModel:Challenge(uid, type, enemy)
    self.enemyData = enemy
    self.curChallengeUid = uid
    self.curChallengeType = type
    if self.curActivityClass:GetCurActivityState() ~= ActivitySynManager.State.Open then
        self:OnQuit()
    end
    self:GetEnemyEmbattleArray(
        uid,type,
        function(sids)
            local data = {false, false, false, false, false, false}
            local myteam = self:CheckEmbattleEmpty(self.attackEmbattle)
            --如果我方进攻阵容不为空
            if myteam ~= false then
                --检测阵容是否为空 镇魂街ZHJ-27879 Alpha_JT BUG合集ZHJ-31375【灵弈对决】对面三支队伍中存在一支队伍为空时，进入战斗卡死
                local teamEmpty = false
                if not sids.team then
                    teamEmpty = true
                else
                    -- 1位置为第一队，2,3 位置为第二队，456为第3对 有一队为空，战斗就直接算队伍为空
                    if sids.team[1].sid == 0 or (sids.team[2].sid == 0 and sids.team[3].sid ==0) or (sids.team[4].sid ==0 and sids.team[5].sid ==0 and sids.team[6].sid == 0)then
                        teamEmpty = true
                    end
                end
                if teamEmpty then
                    self:EnterFightEmpty()
                    return
                end
            end
            if sids.team == nil then
                for i = 1, #data do
                    data[i] = {
                        uid = 0,
                        sid = 0,
                        level = 0,
                        star = 0,
                        soul_lv = 0
                    }
                end
                self.enemyPower = {0, 0, 0}
            else
                for i = 1, #sids.team do
                    data[i] = {
                        uid = sids.team[i].sid,
                        sid = sids.team[i].sid,
                        level = sids.team[i].lv or 0,
                        star = sids.team[i].star or 0,
                        soul_lv = sids.team[i].soul_lv or 0
                    }
                end
                self.enemyPower = sids.power
            end

            _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
            require("EmbattleController"):GetInstance():OpenSixVsSixEmbattle(
                _G.EmbattleType.SixVsSixPVPAttack,
                _G.EmbattleSaveType.server,
                false,
                _G.EmbattleControllerItemType.SixVsSixPVPAttack,
                _G.handler(self, self.ExitEmbattle),
                _G.handler(self, self.EnterFight),
                _G.ConfigManager.arena_info_cfg[6].battle_sences,
                data)
            self.curEmbattleAttackTag = true
        end
    )
end

function SixVsSixPVPModel:OnChallengeEmptyCall(msg)
    if msg.ack == 1 then
        SixVsSixPVPNet:FightResult(
            function(_data)
                _G.PopWindowManager:GetInstance():ShowAllTips(
                    300302,
                    nil,
                    function()
                        self:UpdateData(_data)
                    end
                )
            end
        )
    end
end

function SixVsSixPVPModel:UpdateData(data)
    local UIManagerIns = _G.UIManager:GetInstance()
    local ui_cfg = _G.ConfigManager.ui_cfg
    self:ChangeScore(data.winner)
    self:AddSingleReport(data.report)
    if data.task_curr then
        self:ChangeMission(data.task_curr)
    end
    if data.info then
        self:ChangeSelfInfo(data.info)
    end
    self:UpdateView()

    UIManagerIns:CloseWindow(ui_cfg.SixVsSixChanllengeView.Name)
    UIManagerIns:OpenWindow(ui_cfg.SixVsSixChanllengeView.Name)
end

