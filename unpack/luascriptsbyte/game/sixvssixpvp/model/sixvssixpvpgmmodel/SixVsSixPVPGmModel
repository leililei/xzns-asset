---@class SixVsSixPVPGmModel:ActivitySynTypeBase	中文描述
local base = require "ActivitySynTypeBase"
local SixVsSixPVPGmModel = _G.BaseClass("SixVsSixPVPGmModel",base)
local ActivitySynManager = require "ActivitySynManager":GetInstance()
function SixVsSixPVPGmModel:OnHandleGMData(info)
    self:ParseData(info)
end
---解析数据
function SixVsSixPVPGmModel:ParseData(info)
    if info == nil then
        return
    end
    self:SetSelfData(info)
    base.ParseData(self)
end

function SixVsSixPVPGmModel:SetSelfData(info)
    require"SixVsSixPVPModel":GetInstance():ParseData(info,self.curActivityClass)
    if self.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Settlement then
        self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
    end
end

function SixVsSixPVPGmModel:OnEnterActivity()
    --TODO:进入到具体活动内容
    if self.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Settlsement then
        _G.GlobalInterface.JumpActivityByGM(10005, self.curActivityClass:GetJumpType())
        return
    elseif self.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Open then
        -- body
        if not self.isFirst then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SixVsSixMainView.Name)
        else
            self.isFirst = false
            require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
            require("SixVsSixPVPNet"):GetInstance():GetArray(_G.EmbattleType.SixVsSixPVPAttack,function(data)
                require"SixVsSixPVPModel":GetInstance().attackEmbattle = data.array
                require("SixVsSixPVPNet"):GetInstance():GetArray(_G.EmbattleType.SixVsSixPVPDefence,function(data)
                    require"SixVsSixPVPModel":GetInstance().defenceEmabattle = data.array
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SixVsSixMainView.Name)
                end)
            end)
        end
        base.OnEnterActivity(self)
        if self.onEnterDoneCall then
            self.onEnterDoneCall()
            self.onEnterDoneCall = nil
        end
    else
        return
    end
end

---类的构造函数
function SixVsSixPVPGmModel:__init()
    self.isFirst = true
    require("RedPointManager"):GetInstance():AddListener(_G.eRedPoint.RedPointRefresh, self.UpdateExtraRedPoint,self)
end

---类的析构函数
function SixVsSixPVPGmModel:Dispose()
    require("RedPointManager"):GetInstance():RemoveListener(_G.eRedPoint.RedPointRefresh, self.UpdateExtraRedPoint,self)
end

function SixVsSixPVPGmModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckFirst,self.CheckExchange,self.CheckMission,self.CheckDefence,self.CheckReport}
    self.redpointTree = {{2,3,4,5},false,false,false,false}
end

function SixVsSixPVPGmModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---检测红点
function SixVsSixPVPGmModel:CheckMission()
    return self.curActivityClass.model:CheckMission()
end

function SixVsSixPVPGmModel:LaterInitFunction()
    self.exchange = require "ActivitySynManager":GetInstance():GetChildAcitivity(10005,self.curActivityClass:GetJumpType())
    if self.exchange then
        self.exchangeRedPoint = self.exchange.typeClass:GetRedpointIDByIndex(1)
        self.exchangePoint = self.exchange.typeClass:CheckHaveExchangeItem()
    end
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(2))
end

function SixVsSixPVPGmModel:UpdateExtraRedPoint(id,num)
    if id == self.exchangeRedPoint then
        self.exchangePoint = num
        require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(2))
    end
end

---检测任务是否完成
function SixVsSixPVPGmModel:UpdateMission()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(3))
end

---检测战报推送
function SixVsSixPVPGmModel:UpdateReport()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(5))
end

---检测是否有东西可以兑换
function SixVsSixPVPGmModel:CheckExchange()
    if self.exchangePoint == 1 then
        return 1
    end
    return 0
end

---检测是否有新战报
function SixVsSixPVPGmModel:CheckReport()
    return self.curActivityClass.model:CheckReport()
end

---检测是否是每天第一次
function SixVsSixPVPGmModel:CheckFirst()
    return self.curActivityClass.model:CheckFirst()
end

---检测防守布阵
function SixVsSixPVPGmModel:CheckDefence()
    return self.curActivityClass.model:CheckDefence()
end

---更新防守红点
function SixVsSixPVPGmModel:UpdateDefence()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(4))
end

return SixVsSixPVPGmModel