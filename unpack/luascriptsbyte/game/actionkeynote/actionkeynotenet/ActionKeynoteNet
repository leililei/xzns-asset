---领取7日目标 活动奖励
---@param pbData number 奖励 id(index = 1)
---@param callback funtion 完成回调（public.s2c_common_ack）
function ActionKeynoteNet:SendGoalsReward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_task_keynote_port_goals_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.ActionGoalsCall))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function ActionKeynoteNet:ActionGoalsCall(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type ActionKeynoteNet
_G.ActionKeynoteNet = ActionKeynoteNet
return ActionKeynoteNet
