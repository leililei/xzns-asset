---@class ActionKeynoteNet : BaseGameNet	通信协议
local ActionKeynoteNet = _G.BaseClass("ActionKeynoteNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return ActionKeynoteNet ActionKeynoteNet
function ActionKeynoteNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求 7日目标 任务 信息
---@param pbData table PB数据
---@param callback function 完成回调
---i_task sid任务sid  target
function ActionKeynoteNet:SendTaskGoalsGet(callback)
    local item = _G.ConfigManager.net_map.game_task_keynote_port_get
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.ActionGoalsCall))
    self.Call[port] = callback
end

---接取任务
function ActionKeynoteNet:SendJieQuTask(pbData, callback)
    local item = _G.ConfigManager.net_map.game_task_keynote_port_accept
    local port = base.Access(self, item, pbData, _G.handler(self, self.ActionGoalsCall))
    self.Call[port] = callback
end

---单条任务完成
---@param pbData table unit32 (sid = 1) 任务id unit32 (day=2) 任务所属天数
---@param callback function 完成回调 （task.s2c_task_finish：形式）
function ActionKeynoteNet:SendTaskOneFinish(pbData, callback)
    local item = _G.ConfigManager.net_map.game_task_keynote_port_finish
    local port = base.Access(self, item, pbData, _G.handler(self, self.ActionGoalsCall))
    self.Call[port] = callback
end

---描述：领取七日任务累计充值奖励奖励
---@param pbData number 领取的天数 (day = 1)
---@param callback function (public.s2c_common_ack 通用返回)
function ActionKeynoteNet:SendDayAllCash_award(pbData, callback)
    local item = _G.ConfigManager.net_map.game_task_keynote_port_group_cash_award  
    local port = base.Access(self, item, pbData, _G.handler(self, self.ActionGoalsCall))
    self.Call[port] = callback
end

---领取天数 的 全通奖励
---@param pbData number 领取的天数 (day = 1)
---@param callback function (public.s2c_common_ack 通用返回)
function ActionKeynoteNet:SendDayAllPassAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_task_keynote_port_day_award  
    local port = base.Access(self, item, pbData, _G.handler(self, self.ActionGoalsCall))
    self.Call[port] = callback
