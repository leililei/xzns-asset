---@class ActionKeynoteGiftView : UIBaseView	中文描述
---@field public go_table SeasonBigGiftView_GoTable GoTable
local ActionKeynoteGiftView = _G.BaseClass("ActionKeynoteGiftView", _G.UIBaseView)

function ActionKeynoteGiftView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ActionKeynoteGiftView:OnCreate(Data)
    self.data = Data
    self.go_table.scrollloopvectical_final:InitItemData(0, _G.handler(self, self.RefreshFinalList))
    local listNum = #self.data
    self.go_table.scrollloopvectical_final:UpdateCount(listNum)
end

function ActionKeynoteGiftView:RefreshFinalList(index, objGame)
    if index < 0 then
        return
    end
    local id = objGame:GetInstanceID()
    objGame:SetName(id)
    local obj = _G.GetAutoGoTable(objGame)
    local data = self.data[index + 1]
    if obj.obj_root:GetChildCountE() > 0 then
        for _ = 1, obj.obj_root:GetChildCountE() do
            _G.DestroyObject(obj.obj_root:GetChildE(0))
        end
    end
    _G.StorageManager:GetInstance():GetItemBaseView(
        data[1],
        data[2],
        obj.obj_root,
        function(item)
            if item.go_table.obj_gou and item.go_table.obj_gou:GetChildCountE() > 0 then
                for _ = 1, item.go_table.obj_gou:GetChildCountE() do
                    _G.DestroyObject(item.go_table.obj_gou:GetChildE(0))
                end
            end
            if item.go_table.obj_uieffect and item.go_table.obj_uieffect:GetChildCountE() > 0 then
                for _ = 1, item.go_table.obj_uieffect:GetChildCountE() do
                    _G.DestroyObject(item.go_table.obj_uieffect:GetChildE(0))
                end
            end
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end,
        function(go)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data[1])
        end,
        {data[3]}
    )
    return obj
end


---按钮点击事件在这里派发
function ActionKeynoteGiftView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_close" or name == "@_aorbtn_CloseView" or name == "@_aorbtn_sure" then
        self:Close()
    end
end

return ActionKeynoteGiftView
