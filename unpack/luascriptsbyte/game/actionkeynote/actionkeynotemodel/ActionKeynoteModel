            return
        end
        self:SendTaskJiequ(data)
    end
end

---编辑 任务 匹配到每天 有什么任务
function ActionKeynoteModel:GetOneDayAllTask()
    if not _G.table.isEmptyOrNil(self.currentAlltasks) then
        for i = 1, #self.currentAlltasks do
            local temp, daily = self:ChenckCrruetTaskToDay(self.currentAlltasks[i].i_task.sid, self.currentAlltasks[i])
            if temp then
                self.currentAlltasks[i].dayid = temp.dayid
                self.dailyAlltasks[self:GetCurrentDay(temp.dayid)] = daily
                if _G.table.isEmptyOrNil(temp) then
                    if _G.AppSetting.DEBUG then
                        _G.LogError("配置表中：未找到次任务..:" .. self.currentAlltasks[i].i_task.sid)
                    end
                else
                    _G.table.insert(self.AllDayTasks[self:GetCurrentDay(temp.dayid)], temp)
                end
            end
        end
        
    end
    local qishu, bol = self:GetCurrentQiShu()
    if bol then 
        for i = 1, totalDays do 
            self.dailyAlltasks[i] = self.goalsCfg[qishu][i]
        end
    end
end

---检测 某个任务所在的 天数
function ActionKeynoteModel:ChenckCrruetTaskToDay(taskid, task)
    local cfg = self.goalsCfg[self:GetCurrentQiShu()]
    local DayAllTask = {}
    local temp = {}
    for i = 1, #cfg do 
        if cfg[i].mission_extra1 then
            for j = 1, #cfg[i].mission_extra1 do
                if taskid == cfg[i].mission_extra1[j] then
                    temp = {}
                    temp.dayid = cfg[i].id
                    temp.group = cfg[i].group
                    temp.task = task
                    _G.table.insert(DayAllTask, temp)
                    return temp, cfg[i]
                end
            end
        end
        if cfg[i].mission_extra2 then
            for j = 1, #cfg[i].mission_extra2 do
                if taskid == cfg[i].mission_extra2[j] then
                    temp = {}
                    temp.dayid = cfg[i].id
                    temp.group = cfg[i].group
                    temp.task = task
                    temp.value = cfg[i]
                    _G.table.insert(DayAllTask, temp)
                    return temp, cfg[i]
                end
            end
        end
    end
end

