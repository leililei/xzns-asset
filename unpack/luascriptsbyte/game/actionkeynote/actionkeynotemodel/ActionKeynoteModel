function ActionKeynoteModel:OnMallCashListener(data)
    local time = self:GetCurrentTime()
    if time <= 0 then
        return
    end
    -- local cfg = _G.ConfigManager.store_battle_pass_cfg[data.sid]
    if data.cash_rmb and data.cash_rmb > 0 then
        self:AddGroup_cash(data.cash_rmb)

        local store_extra_cfg = _G.ConfigManager.store_extra_cfg[data.sid]
        if store_extra_cfg and data.sid == self.store_extra_cfgData then
            local MallManager = require("MallManager"):GetInstance()
            MallManager:SetItemBuyTimes(store_extra_cfg.id, store_extra_cfg.type_reset, 1)
            self.store_extra_cfgData = nil
        end
        self:RefRedPointActionDay()
        local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ActionKeynoteView.Name)
        if ctrl then
            ctrl:DayButtonClick()
            -- ctrl:Support()
        end
    end
end

