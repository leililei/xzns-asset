---检测 全通的奖励
---@param isEquality boolean 检测 任务是否已经 领取
function ActionKeynoteModel:CheckAllPss(isEquality)
    local cfg = self.goalsCfg
    local alltasks = self:GetAllDayTasks()
    local qishu = self:GetCurrentQiShu()
    for key, value in ipairs(cfg[qishu]) do
        local flag = false
        if not _G.table.isEmptyOrNil(self.day_award) then
            for i = 1, #self.day_award do
                if key == self.day_award[i] then
                    flag = true
                    break
                end
            end
        end
        if not flag then
            if isEquality then
                ---判断任务过期，全通的肯定是不能完成
                if self:CheckGuoQi(key) then
                else
                    return 1
                end
                --return 1
            end
            local flagAward = true
            if not _G.table.isEmptyOrNil(alltasks[key]) then
                local daytasks = alltasks[key]
                for i = 1, #daytasks do
                    local temp = daytasks[i]
                    if
                        temp.task.i_task.state ~= _G.TaskEnum.ETaskState.Submited and
                        temp.task.i_task.state ~= _G.TaskEnum.ETaskState.Completed
                    then
                        flagAward = false
                        break
                    end
                end
                if flagAward then
                    ---判断任务过期，全通的肯定是不能完成
                    if self:CheckGuoQi(key) then
                    else
                        return 1
                    end
                end
            end
        end
    end
    return 0
end

