---静态 配置表 数据
function ActionKeynoteModel:initStaticData()
    self.activeCfg = self:GetGoalsActiveCfg()
    self.goalMissCfg = self:GetMissionExtraCfg()
    self.goalsCfg = self:GetGoalsSevenCfg()
end

---获取 活动 7日、14日 目标奖励 配置表 goals_active_cfg
---@return table 7日\14日 配置表信息
function ActionKeynoteModel:GetGoalsActiveCfg()
    local cfg =  _G.ConfigManager.keynote_active_cfg
    local activeCfg = {}
    if cfg then
        for key, value in pairs(cfg) do
            activeCfg[value.group] = activeCfg[value.group] or {}
            _G.table.insert(activeCfg[value.group], value)
        end
    end
    for k, v in pairs(activeCfg) do 
        _G.table.sort(
            v,
            function(a, b)
                return a.id < b.id
            end
        )
    end
    return activeCfg
end

---获取目标活动任务的 配置表 mission_extra_cfg
function ActionKeynoteModel:GetMissionExtraCfg()
    local cfg = _G.ConfigManager.mission_extra_cfg
    self.goalMissCfg = {}
    for key, value in pairs(cfg) do
        if value.type_mission == 14 then
            _G.table.insert(self.goalMissCfg, value)
        end
    end
    return self.goalMissCfg
end

---获取目标活动配置表 goals_seven_cfg
function ActionKeynoteModel:GetGoalsSevenCfg()
    local cfg = _G.ConfigManager.keynote_seven_cfg
    local goalsCfg = {}
    for k, v in pairs(cfg) do 
        goalsCfg[v.group] = goalsCfg[v.group] or {}
        _G.table.insert(goalsCfg[v.group], v)
    end
    for k, v in pairs(goalsCfg) do 
        _G.table.sort(
            v,
            function(a, b)
                return a.id < b.id
            end
        )
    end
    return goalsCfg
end

