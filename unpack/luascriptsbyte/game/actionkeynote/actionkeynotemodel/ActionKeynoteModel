    if self:GetCurrentTime() == 0 then
        return 0
    end
    if _G.table.isEmptyOrNil(self.goals_award) or self.goals_award == nil then
        return 1
    end
    local cfg = self.activeCfg[self:GetCurrentQiShu()]
    local count = table.count(cfg)

    if count == #self.goals_award then
        return 0
    end
    return 1
end

