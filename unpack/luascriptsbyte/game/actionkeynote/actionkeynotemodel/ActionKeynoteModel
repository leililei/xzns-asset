function ActionKeynoteModel:RedCheckFunction(id)
    local flag = 0
    if self:GetCurrentDay() < id then
        return 0
    end
    local data = _G.PlayerPrefsManager.GetTable("ActionKeynoteModelID")
    if data ~= nil then
        for key, value in pairs(data) do
            if value == id then
                flag = 0
            end
        end
        -- body
    end
    local allTask = self:GetDailyAlltasks()
    if allTask then
        local DailyAlltasks = allTask[id]
        if DailyAlltasks then
            local total = DailyAlltasks.total_recharge
            local ids = self:GetIsGroup_cash(DailyAlltasks.group)
            local is = self:GetCash_award(id)
            if total and ids and total <= ids and not is then
                flag = 1
            end
        end
    end

    return flag
end

function ActionKeynoteModel:AddRedCheckFunction(id)
    local flag = true

    if self:GetCurrentDay() < id then
        flag = false
        return
    end
    local data = _G.PlayerPrefsManager.GetTable("ActionKeynoteModelID")
    if data ~= nil then
        for key, value in pairs(data) do
            if value == id then
                flag = false
            end
        end
        -- body
    else
        flag = false
        data = { id }
    end
    if flag then
        _G.table.insert(data, id)
    end
    _G.PlayerPrefsManager.SetTable("ActionKeynoteModelID", data)
    self:RefRedPointActionDay()
end

