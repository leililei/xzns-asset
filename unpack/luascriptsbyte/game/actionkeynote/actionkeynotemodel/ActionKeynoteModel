--第二个返回值bol返回活动开没开
function ActionKeynoteModel:GetCurrentQiShu()
    local currentime = _G.TimeUtil.GetServerUnixTime()
    local day = _G.TimeUtil.GetInterValDayByGame(_G.PlayerModel:GetInstance().open_time, currentime) + 1
    for k, v in pairs(self.goalsCfg) do 
        for i = 1, #v do 
            if day == v[i].id then 
                self.currentQishu = v[i].group
                return self.currentQishu, true
            end
        end
    end
    return 1, false
end

---获得当前 活动时间
function ActionKeynoteModel:GetCurrentTime()
    local times_cu = 0
    local cfg = self.goalsCfg[self:GetCurrentQiShu()]
    times_cu = 86400 * cfg[#cfg].id
    local curtime = _G.TimeUtil.GetServerUnixTime()
    --与前后端时间统一
    local curtime2 = _G.TimeUtil.GetDayBySix(self.roletime)
    self.currentTime = curtime2 + times_cu - curtime
    if self.currentTime <= 0 then
        self.currentTime = 0
    end
    return self.currentTime
end

