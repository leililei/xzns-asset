---单条 任务（完成)
function ActionKeynoteModel:SendTaskOneFinish(da, task, Call)
    local pbData = {
        sid = task.task.i_task.sid,
        day = task.task.dayid,
        finish_type = 2
    }
    local d = task.task.dayid
    require("ActionKeynoteNet"):GetInstance():SendTaskOneFinish(
        pbData,
        function(data)
            if data.ack ~= 1 then
                return
                -- elseif data.ack == "not_open" then --未开启
                --     _G.FloatTipsModel:GetInstance():Show(data.ack)
                --     return
                -- elseif data.ack == "input_error" then
                --     _G.FloatTipsModel:GetInstance():Show(data.ack)
                --     return
            end
            if data then
                local awardDatas = {
                    award = {
                        item = {},
                        overflow = data.award.overflow
                    }
                }

                for i = 1, #data.award.item do
                    local sid = data.award.item[i].type[1]
                    if  sid == _G.ResPropID.Active_keynote then
                        self.goalsNum = self.goalsNum + data.award.item[i].type[2]
                    else
                        local temp = data.award.item[i]
                        _G.table.insert(awardDatas.award.item, temp)
                    end
                end
                --更新 资源背包
                --_G.Events:GetInstance():Broadcast(_G.eItemUpdata.Updata,awardDatas.award.item)
                _G.StorageManager:GetInstance():ReceiveAwardData(awardDatas)
                --奖励
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.CommonAwardView.Name,
                    awardDatas,
                    function()
                        _G.PlayerModel:GetInstance():ShowRoleLvUpAward()
                    end
                )
            end
            local alltasks = self:GetAllDayTasks()
            local onetaskData = alltasks[self.currenDay]
            for i = 1, #onetaskData do
                if data.new_task.sid == onetaskData[i].task.i_task.sid then
                    onetaskData[i].task.i_task.state = data.new_task.state
                    break
                end
            end
            self:RefRedPointActionDay()
            --刷新红点 GoalTarget
            require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.KeynoteTarget.id)
            if Call then
                Call()
            end
        end
    )
end

