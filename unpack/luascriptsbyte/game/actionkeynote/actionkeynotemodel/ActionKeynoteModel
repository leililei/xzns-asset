function ActionKeynoteModel:Dispose()
    self.data = nil
    if not _G.table.isEmptyOrNil(self.currentAlltasks) then
        for k, v in pairs(self.currentAlltasks) do
            v:Dispose()
        end
    end
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.currentAlltasks = nil
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

