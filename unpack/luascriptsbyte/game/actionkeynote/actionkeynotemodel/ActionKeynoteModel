---时间转为天数(服务器时间： 转为 当前是第几天)
function ActionKeynoteModel:GetSevertimeToDay()
    local currentime = _G.TimeUtil.GetServerUnixTime()
    local day = _G.TimeUtil.GetInterValDayByGame(self.roletime, currentime) + 1
    for k, v in pairs(self.goalsCfg) do 
        for i = 1, #v do 
            for i = 1, #v do 
                if day == v[i].id then 
                    self.currenDay = i
                    return 
                end
            end
        end
    end
    self.currenDay = totalDays
end

function ActionKeynoteModel:GetRealDay(num)
    local day 
    if num then 
        return self.goalsCfg[self:GetCurrentQiShu()][num].id
    else
        local currentime = _G.TimeUtil.GetServerUnixTime()
        day = _G.TimeUtil.GetInterValDayByGame(self.roletime, currentime) + 1
    end
    
    return day
end

--dayNum 给定一个天数，算出是该期的第几天
function ActionKeynoteModel:GetCurrentDay(dayNum)
    local currentime = _G.TimeUtil.GetServerUnixTime()
    local day = dayNum or (_G.TimeUtil.GetInterValDayByGame(_G.PlayerModel:GetInstance().open_time, currentime) + 1)
    for k, v in pairs(self.goalsCfg) do 
        for i = 1, #v do 
            if day == v[i].id then 
                return i
            end
        end
    end
    return totalDays
end

