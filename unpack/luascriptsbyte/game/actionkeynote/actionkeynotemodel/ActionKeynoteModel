---七日目标 目标点 红点奖励
function ActionKeynoteModel:CheckGoalsRedpoint(param)
    --判断新一期的时候手动清零点数
    local alltask = self:GetAllDayTasks()
    if #alltask[1] == 0 then 
        self.goalsNum = 0
        return false
    end
    local qishu, bol = self:GetCurrentQiShu()
    if bol then
        param = qishu * 100 + param
        local cfg = _G.ConfigManager.keynote_active_cfg[param]
        local num = self.goalsNum
        if num == nil then
            return false
        end
        --检测目标点数
        if num < cfg.value_active then
            return false
        end
        --判断奖励是否已经领取过
        if _G.table.isEmptyOrNil(self.goals_award) then
            return true
        end
        for i = 1, #self.goals_award do
            if self.goals_award[i] == param then
                return false
            end
        end
        return true
    end
    return false
end

