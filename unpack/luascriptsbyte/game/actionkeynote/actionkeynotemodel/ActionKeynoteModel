--一天所有的任务所有奖励（奖励物品，奖励物品数量）
function ActionKeynoteModel:OndAwardAll(alltasks)
    local a_awards = {}
    for i = 1, #alltasks do
        local awards = self:rewardOfTask(alltasks[i])
        if _G.table.isEmptyOrNil(a_awards) then
            for j = 1, #awards do
                a_awards[awards[j][1]] = _G.GlobalInterface.GetNewArray(awards[j])
            end
        else
            local flag = false
            for j = 1, #awards do
                flag = false
                local val = 0
                for key, value in pairs(a_awards) do
                    if key == awards[j][1] then
                        val = value[2] + awards[j][2]
                        flag = true
                        break
                    end
                end
                if not flag then
                    a_awards[awards[j][1]] = _G.GlobalInterface.GetNewArray(awards[j])
                else
                    a_awards[awards[j][1]][2] = val
                end
            end
        end
    end
    local AllAwards = {}
    if not _G.table.isEmptyOrNil(a_awards) then
        local data = {}
        for _, value in pairs(a_awards) do
            data = {}
            data = _G.StorageManager:GetInstance():GetItemDataClassByCfg(value)
            _G.table.insert(AllAwards, data)
        end
    end
    return AllAwards
