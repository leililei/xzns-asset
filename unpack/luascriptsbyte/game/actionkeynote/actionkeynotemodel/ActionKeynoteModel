--检测 所有任务领取 完成关闭
---@param taskstate number 任务的 状态
---@param isEquality boolean 相等检测（领取） 不相等（完成）
function ActionKeynoteModel:CheckAlltasksState(taskstate, isEquality)
    local alltasks = self:GetAllDayTasks()
    local curr_day = self:GetCurrentDay()
    if curr_day > number_7 then
        curr_day = number_7
    end
    --检测所有任务
    for i = 1, number_7 do
        local daytasks = self.AllDayTasks[i]
        if not _G.table.isEmptyOrNil(daytasks) then
            for j = 1, #daytasks do
                local temp = daytasks[j]
                if isEquality then
                    if temp.task.i_task.state == taskstate and curr_day >= i then
                        return 1
                    end
                else
                    if temp.task.i_task.state == 1 then --过期的任务相等于 是完成的状态
                        if self:CheckGuoQi(temp.dayid) then
                        else
                            return 1
                        end
                    elseif temp.task.i_task.state ~= taskstate then --任务都没有完成
                        return 1
                    end
                end
            end
        end
    end
    return 0
end

---@return 1 奖励都已经 领取完成
function ActionKeynoteModel:CheckFunctionClose()
    local taskstate = self:CheckAlltasksState(_G.TaskEnum.ETaskState.Completed)
    local goalsstate = self:CheckGoals(true)
    local allpassState = self:CheckAllPss(true)
    --local goals_pass_state = self:CheckAllGoals(true) and goals_pass_state == 0
    if taskstate == 0 and goalsstate == 0 and allpassState == 0 then
        return 1
    end
    return 0
end

