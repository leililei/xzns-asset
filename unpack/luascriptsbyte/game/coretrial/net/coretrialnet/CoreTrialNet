local base = require("BaseGameNet")

---@class CoreTrialNet : BaseGameNet	通信协议
local CoreTrialNet = _G.BaseClass("CoreTrialNet", base)
---@return CoreTrialNet CoreTrialNet
function CoreTrialNet:GetInstance()
    return  base.GetInstance(self)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function CoreTrialNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function CoreTrialNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

function CoreTrialNet:GetRank(pbData, callback)
    local pb = {}
    if _G.table.isEmptyOrNil(pbData) then
        pb = self:GetEmptyPB()
    else
        pb = pbData
    end
    local item = _G.ConfigManager.net_map.game_rank_heart_trial
    local port = base.Access(self, item, pb, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

function CoreTrialNet:ChoiceAward(pbData,callback)
    local item = _G.ConfigManager.net_map.game_activity_module_heart_choose_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

