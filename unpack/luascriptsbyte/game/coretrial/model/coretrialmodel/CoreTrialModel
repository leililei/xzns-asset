end

---选择奖励
function CoreTrialModel:ChoiceAward(sid,index,callBack)
    local pbData = {activity_id = self.curSid, position_sid = sid,index = index}
    CoreTrialNet:ChoiceAward(pbData,function(data)
        if data.ack == 1 then
            self.finalAwardCfg[sid].index = index
            self:RefreshFinalRedPoint()
            if callBack then
                callBack()
            end
        end
    end)
end

---领取奖励
function CoreTrialModel:GetFinalAward(call)
    local params = {}
    for _,v in pairs(self.finalAwardCfg) do
        if v.index ~= 0 and not v.receive then
            table.insert(params,v.sid)
        end
    end
    if #params > 0 then
        require("ActivitySynNet"):GetInstance():GetAward(self.curSid,params,
        function(data)
            if data.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
            for _,v in pairs(params) do
                self.finalAwardCfg[v].receive = true
            end
            self:RefreshFinalRedPoint()
            if call then
                call()
            end
        end)
    end 
end

---修改关卡数据
function CoreTrialModel:ChangeLevelInfo(data,level)
    for _,v in pairs(data.defense_team) do
        for _1,v1 in pairs(self.levelCfg[level].enemyList) do
            if v.sid == v1.sid then
                v1.lv = v.lv
                v1.star = v.star
            end
        end
    end
end

---进入布阵界面
function CoreTrialModel:EnterEmbattle(level,curbattle)
    self.fightLevel = level
    self.curBattleLevel = curbattle
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    if self.defenseList[level] then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CoreTrialEmbattleView.Name,
            embattleType,
            _G.handler(self, self.ExitEmbattle),
            _G.handler(self, self.EnterFight),
            groupId,
            self.defenseList[level],
            self.curBattleLevel,
            self.levelCfg[self.curBattleLevel]
        )
    else
        self:CheckLevelDefense(level,function(data)
            local fighters = {}
            for j = 1, #data.defense_team do
                local fi = data.defense_team[j]
                _G.table.insert(
                    fighters,
                    {
                        uid = fi.uid,
                        sid = fi.sid,
                        level = fi.lv,
                        star = fi.star
                    }
                )
            end
            fighters.power = data.power
            self.defenseList[level] = fighters 
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CoreTrialEmbattleView.Name,
                embattleType,
                _G.handler(self, self.ExitEmbattle),
                _G.handler(self, self.EnterFight),
                groupId,
                fighters,
                self.curBattleLevel,
                self.levelCfg[self.curBattleLevel]
            )
        end)
    end
end

