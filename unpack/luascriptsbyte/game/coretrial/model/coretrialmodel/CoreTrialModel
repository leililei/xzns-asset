function CoreTrialModel:UpdateEnemyCardSoulAndTalent(card, param, soulStar, talentStar)
    if card.star >= soulStar then
        card.soulLink_IsActivate = card.hunlianIsActive
        card.soulLink_lv = param.maxHunLian
    else
        card.soulLink_IsActivate = 0
        card.soulLink_lv = 0
    end
    card.open_inborn = {}
    card.big_born_num = 0
    if card.star >= talentStar then
        if param.maxTF > 0 then
            local index = 0
            for i = 1, #card.cfg.talent do
                for j = 1, #card.cfg.talent[i] do
                    index = index + 1
                    card.open_inborn[index] = card.cfg.talent[i][j]
                    if index >= param.maxTF then
                        break
                    end
                end
                if index >= param.maxTF then
                    break
                end
            end
        end
        card.big_born_num = require("CardInfoManager"):GetInstance():GetTalentsNumByInborn(card.open_inborn)
    end
end

---获取卡牌参数
function CoreTrialModel:GetSoulLinkAndTalent()
    ---@type CardData[]
    local datas = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    datas = _G.table.toArray(datas)
    _G.SortList(
        datas,
        function(data)
            return data.power, data.star, data.Grade, data.uid
        end
    )
    ---@type CardData[]
    local chooseCards = {}
    local count = #datas
    if count > 5 then
        count = 5
    end
    for i = 1, count do
        chooseCards[i] = datas[i]
    end
    local param = {
        maxTF = 0,
        maxHunLian = 0,
        hunlianIsActive = 0
    }
    for _, v in pairs(chooseCards) do
        if v.soulLink_IsActivate == 1 then
            param.hunlianIsActive = 1
        end
        param.maxHunLian = param.maxHunLian + v.soulLink_lv
        param.maxTF = param.maxTF + #v.open_inborn
    end

    param.maxHunLian = _G.Mathf.RoundToInt(param.maxHunLian / count)
    param.maxTF = _G.Mathf.RoundToInt(param.maxTF / count)
    return param
end

return CoreTrialModel