---返回活动界面
---@param win boolean 是否获胜
---@param result table 战斗数据
function CoreTrialModel:ReturnActivityView(win,result)
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.CoreTrialView.Name)
    if window then
        window.View:Show()
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CoreTrialView.Name,self.curActivityClass)
    end
    if win then
        ---达成条件第一个必定为战斗获胜
        local isNext = false
        if not table.isEmptyOrNil(result.condition) then
            for k,v in pairs(result.condition)do
                if not self.levelCfg[self.curBattleLevel].conditionList[v].isFinish then
                    self.levelCfg[self.curBattleLevel].conditionList[v].isFinish = true
                    self.levelCfg[self.curBattleLevel].star = self.levelCfg[self.curBattleLevel].star + 1
                    self.haveStar = self.haveStar + 1
                    if v == 1 then
                        self.curLevel = self.curLevel + 1
                        isNext = true
                    end
                end
            end
        end
        if result.enemyData and result.enemyData[1] ~= 0 and self.curBattleLevel+1 <= #self.levelCfg then
            local param = self:GetSoulLinkAndTalent()
            local soulStar = _G.ConfigManager.discrete_cfg[102401][1][1]
            local talentStar = _G.ConfigManager.discrete_cfg[107401][1][1]
            for _,v in pairs(self.levelCfg[self.curBattleLevel+1].enemyList) do
                v.lv = result.enemyData[1]
                v.star = result.enemyData[2]
                self:UpdateEnemyCardSoulAndTalent(v, param, soulStar, talentStar)
            end
        end
        if not table.isEmptyOrNil(result.award) then
            _G.StorageManager:GetInstance():ReceiveAwardData(result.award)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, result.award,function()
                if window then
                    window.View:RefreshData(isNext,self.curLevel)
                end
            end)
        else
            if window then
                window.View:RefreshData(isNext,self.curLevel)
            end
        end
    end
end

