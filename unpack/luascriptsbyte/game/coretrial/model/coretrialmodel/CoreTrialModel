---@class CoreTrialModel	中文描述
local ActivitySynManager = require "ActivitySynManager"
local base = require "ActivitySynTypeBase"
local CoreTrialModel = _G.BaseClass("CoreTrialModel", base)
local table = _G.table
local awardCfg = _G.ConfigManager.system_trial_reward_cfg
local card_cfg = _G.ConfigManager.card_cfg
local CardData = _G.CardData
local groupId = _G.ConfigManager.discrete_cfg[107701][1][1]
local embattleType = _G.EmbattleType.coreTrial
local SortList = _G.SortList
local CoreTrialNet = require "CoreTrialNet":GetInstance()

---类的构造函数
function CoreTrialModel:__init()
    _G.Events:GetInstance():AddListener(_G.eAfkEvents.Pass, self.RefreshFinalRedPoint, self)
end

---类的析构函数
function CoreTrialModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eAfkEvents.Pass, self.RefreshFinalRedPoint, self)
end

function CoreTrialModel:InitData()
    self.isFirst = false
    self.levelCfg = {}
    self.levelInfo = {}
    self.finalAwardCfg = {}
    self.defenseList = {}
    self.endTime = self.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    self.openTime = self.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Open)
end

---@return CoreTrialModel CoreTrialModel
---获取GM数据
---@param info activity.i_activity_heart_trial
function CoreTrialModel:OnHandleGMData(info)
    self:InitData()
    self:ParseData(info)
end

---解析数据
function CoreTrialModel:ParseData(info)
    self:InitInfo(info)
end

---初始化活动数据
function CoreTrialModel:InitInfo(info)
    self.curSid = self.curActivityClass:GetActivityID()
    local data = info.heart_trial
    ---当前开放层数
    self.openLevel = data.open_layer
    ---后续每N天开放层数
    self.continue = data.continue_layer
    ---后续开放间隔天数
    self.intervalDay = data.continue_day
    ---当前最高层数
    self.curLevel = data.attack_layer + 1
    self.curTime = _G.TimeUtil:GetServerUnixTime()
    self.intervalTimes = self.intervalDay - _G.TimeUtil.GetInterValDayByGame(self.openTime,self.curTime)%self.intervalDay
    self.haveStar = 0
    self.levelCfg = {}
    local newdata
    self.awradList = {}
    if data.layer_info then
        local param = self:GetSoulLinkAndTalent()
        local soulStar = _G.ConfigManager.discrete_cfg[102401][1][1]
        local talentStar = _G.ConfigManager.discrete_cfg[107401][1][1]
        for k,v in pairs(data.layer_info) do
            newdata = {}
            newdata.sid = v.sid
            newdata.star = 0
            --newdata.condition = {}
            newdata.conditionList = {}
            if v.star_con then
                for k1,con in pairs(v.star_con) do
                    local condition = con
                    condition.isFinish = false
                    table.insert(newdata.conditionList,condition)
                end
            end
            if v.star_award then
                for k1,index in pairs(v.star_award) do
                    newdata.conditionList[index].isFinish = true
                    newdata.star = newdata.star + 1
                    self.haveStar = self.haveStar + 1
                end
            end
            newdata.enemyList = {}
            for _,cardData in pairs(v.card_info) do
                if not cardData.lv then
                    cardData.lv = -1
                    cardData.star = -1
                end
                local card = CardData.New()
                local cfg = card_cfg[cardData.sid]
                card.cfg = cfg
                card.sid = cardData.sid
                card.lv = cardData.lv
                card.star = cardData.star == -1 and card.cfg.Star or cardData.star
                card.Icon = card.cfg.Icon
                self:UpdateEnemyCardSoulAndTalent(card, param, soulStar, talentStar)
                table.insert(newdata.enemyList,card)
            end
            newdata.awradList = {}
            for _,award in pairs(v.reward) do
                local data = {[1] = award.k,[2] = award.v}
                table.insert(newdata.awradList,data)
            end
            newdata.layer =  v.layer
            table.insert(self.levelCfg,newdata)
        end
    end
    SortList(
        self.levelCfg,
        function(a)
            return -a.layer
        end
    )
    self.finalAwardCfg ={}
    for _,v in pairs(awardCfg) do
        local item ={}
        item.select = v.item_select
        item.condition = v.limit_condition
        item.receive = false
        item.index = 0
        item.sid = v.id
        self.finalAwardCfg[v.id] = item
    end
    if data.select_award then
        for _,v in pairs(data.select_award) do
            self.finalAwardCfg[v.sid].index = v.index
            self.finalAwardCfg[v.sid].receive = v.is_receive
        end
    end
    if data.attack_layer == 0 and self.levelCfg[1].enemyList[1].lv < 0 then
        self.isFirst = true
    end
    ---留着6点刷新界面，现在没东西要刷
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.CoreTrialView.Name)
    if window then
        window.View:RefreshData()
    end
end

function CoreTrialModel:ReConnect(endcall)
    if endcall ~= nil then
        endcall(self.__cname)
    end
end

---初始化功能逻辑
function CoreTrialModel:InitFunction()
end

---进入活动主体
function CoreTrialModel:OnEnterActivity()
    if self.isFirst then
        self:CheckLevelDefense(self.levelCfg[1].sid,
        function(data)
            self:ChangeLevelInfo(data,1)
            self.isFirst = false
            require "RedPointManager":GetInstance():RefreshNode(self:GetRedpointIDByIndex(2))
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CoreTrialView.Name,self.curActivityClass)
        end)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CoreTrialView.Name,self.curActivityClass)
    end
end

function CoreTrialModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckCanGet,self.CheckIsFirst}
    self.redpointTree = {{2},false}
end

---刷新最终奖励红点
function CoreTrialModel:RefreshFinalRedPoint()
    require "RedPointManager":GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

function CoreTrialModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---检测第一次进入活动
function CoreTrialModel:CheckIsFirst()
    if self.levelCfg[1].enemyList[1].lv < 1 then
        return 1
    else
        return 0
    end
end

---检测能否领奖
function CoreTrialModel:CheckCanGet()
    local curAfk = require "AfkModel":GetInstance():GetCurSection()
    if self.curLevel > #self.levelCfg then
        for _,v in pairs(self.finalAwardCfg) do
            if not v.receive then
                if v.index ~= 0 or v.condition[2] < curAfk then
                    return 1
                end
            end
        end
    end
    return 0
end

