---@return CoreTrialCondition CoreTrialCondition
function CoreTrialCondition:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function CoreTrialCondition:__init()
end

function CoreTrialCondition:CheckCondition(con)
    local data
    local condition
    for _,v in pairs(conditionCfg) do
        if v.id == con.sid then
            data = v
            break
        end
    end
    if not data then
        return "配置表没有"..con.sid.."这条任务"
    end
    condition = data.condition[1]
    local text
    if condition[1] ~= 9 then
        text = GetLangPackValue(data.desc)
    else
        local str1 = GetLangPackValue(card_cfg[con.args[1]].Name)
        local str2 = GetLangPackValue(card_cfg[con.args[2]].Name)
        text = GetLangPackValue(data.desc,str1,str2)
    end
    return text
end

---销毁对象时,析构函数
function CoreTrialCondition:Dispose()
end

return CoreTrialCondition