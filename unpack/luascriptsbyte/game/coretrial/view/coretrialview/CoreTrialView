---@class CoreTrialView : UIBaseView	中文描述
---@field public go_table CoreTrialView_GoTable GoTable
local CoreTrialView = _G.BaseClass("CoreTrialView", _G.UIBaseView)
local table = _G.table
local GetLangPackValue = _G.GetLangPackValue
local GetColorFromRGB = require("CardInfoManager").GetColorFromRGB
local TimeUtil = _G.TimeUtil
local UIUtils = _G.UIUtils
local CS = _G.CS
local typeof = _G.typeof
local effectCfg = _G.ConfigManager.ui_effect_cfg
local stars = {
    [1] = "sxzl_zjm_xingxing_weidianliang",
    [2] = "sxzl_zjm_xingxing_dianliang"
}
local color = {
    ["choice"] = {"f6dd93","f7f4ec"},
    ["unChoice"] = {"a3acd8","a3acd8"}
}
local CoreTrialCondition = require("CoreTrialCondition"):GetInstance()
function CoreTrialView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.upArray = self.go_table.obj_up
    self.downArray = self.go_table.obj_down
    self.curFloor = self.go_table.aorbtn_level
    self.box = self.go_table.aorbtn_box
    self.towerList = self.go_table.looplist2_Tower
    self.oldToewer = nil
end

---界面的入口函数
function CoreTrialView:OnCreate(curActivity)
    self.curActivity = curActivity
    self.typeClass = curActivity.typeClass
    self.levelCfg = self.typeClass.levelCfg
    self.curLevel = self.typeClass.curLevel
    self.awradList = self.typeClass.awradList
    self.openLevel = self.typeClass.openLevel
    self.continue = self.typeClass.continue
    self.intervalTimes = self.typeClass.intervalTimes
    self.intervalDay = self.typeClass.intervalDay
    self.finalAwardCfg = self.typeClass.finalAwardCfg
    self.endTime = self.typeClass.endTime
    self.finalePos = #self.levelCfg*300
    self:LoadEffect()
    self:InitView()
    self:InitTime()
    self:UpdateLocalLevel()
end

function CoreTrialView:LoadEffect()
    UIUtils.LoadEffectByCfg(
        effectCfg.ef_xunhuan_effect,
        self.go_table.obj_fightEffect
    )
    UIUtils.LoadEffectByCfg(
        effectCfg.ef_CoreTrialView_shuaguang,
        self.go_table.obj_effect
    )
end

function CoreTrialView:InitView()
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(self.typeClass:GetRedpointIDByIndex(1))
    self.length = _G.table.count(self.levelCfg) + 1
    local jump = self.curLevel >self.openLevel and self.openLevel or self.curLevel
    self.curBattleLevel = jump
    if jump == self.length then
        jump = jump + 1
    end
    self.towerList:InitListView(0, _G.handler(self, self.InitTower))
    self.towerList:SetListItemCount(self.length,true)
    for i = 1 ,self.length -1 do
        self.towerList:SetItemSize(i-1,350)
    end
    self.towerList:SetItemSize(self.length-1,700)
    self.towerList:RefreshAllShownItem()
    self.towerList:MovePanelToItemIndex(jump - 1)
    self.towerList.ScrollRect.onValueChanged:AddListener(_G.handler(self,self.ShowQuickButton))
    self:InitInfoView()
    if self.curLevel < #self.levelCfg then
        self.downArray:SetActiveE(1)
        self.box:SetActiveE(1)
    end
end

---界面的销毁函数
function CoreTrialView:OnDestroy()
    self:Stop_CloseTimer()
end

---快速跳转
function CoreTrialView:ShowQuickButton()
    local posx,posy = self.go_table.obj_Content:GetLocalPosition()
    self.upArray:SetActiveE(0)
    self.curFloor:SetActiveE(0)
    self.downArray:SetActiveE(0)
    self.box:SetActiveE(0)
    if self.curLevel ~= self.length then
        if posy <= self.curlevelPosy - 600 then
            self.downArray:SetActiveE(1)
            self.curFloor:SetActiveE(1)
        elseif posy >=self.curlevelPosy + 300  then
            self.upArray:SetActiveE(1)
            self.curFloor:SetActiveE(1)
        elseif posy <= self.finalePos + 700  then
            self.downArray:SetActiveE(1)
            self.box:SetActiveE(1)
        end
    else
        if posy <= self.finalePos + 700  then
            self.downArray:SetActiveE(1)
            self.box:SetActiveE(1)
        end
    end
end

---按钮点击事件在这里派发
function CoreTrialView:OnClickBtn(go)
    if go == self.go_table.aorbtn_RestartDo then
        if self.curLevel >= self.curBattleLevel and self.curBattleLevel <= self.openLevel then
            local sid = self.levelCfg[self.curBattleLevel].sid
            self.typeClass:EnterEmbattle(sid,self.curBattleLevel)
        elseif self.curBattleLevel > self.curLevel and  self.openLevel >= self.curBattleLevel then
            _G.PopWindowManager:GetInstance():ShowAllTips(310103)
        elseif self.openLevel < self.curBattleLevel then
            _G.PopWindowManager:GetInstance():ShowAllTips(830101)
        end
    elseif go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 62)
    elseif go == self.go_table.aorbtn_award then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CoreTrialDetailView.Name,
        self.curActivity,
        self.levelCfg,
    function(level)
        self:MoveAnim(level)
        --self.towerList:MovePanelToItemIndex(level-1)
        self:RefreshTowerInfo(level)
    end)
    elseif go == self.go_table.aorbtn_rank then
        self.typeClass:GetRankInfo(
            function(data)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CoreTrialRankView.Name,self.curActivity,data)
            end
        )
    elseif go == self.go_table.aorbtn_box then
        self:MoveAnim(self.length)
        --self.towerList:MovePanelToItemIndex(#self.levelCfg +1)
        self.downArray:SetActiveE(0)
        self.box:SetActiveE(0)
    elseif go == self.go_table.aorbtn_level then
        self:MoveAnim(self.curLevel)
        --self.towerList:MovePanelToItemIndex(self.curLevel - 1)
        self.upArray:SetActiveE(0)
        self.downArray:SetActiveE(0)
        self.curFloor:SetActiveE(0)
    end
end

---初始化当前层数信息
function CoreTrialView:InitInfoView()
    self.enemyList = {}
    self.conditionList = {}
    local item
    local levelIndex = self.curLevel < self.openLevel and self.curLevel or self.openLevel
    local data = self.levelCfg[levelIndex]
    self.go_table.aortext_level.text = GetLangPackValue(90023200002,levelIndex)
    for i=1,#data.conditionList  do
        item = _G.InstantiateObject(self.go_table.obj_ImageContent, self.go_table.obj_Grid)
        local tb = _G.GetAutoGoTable(item)
        local v = data.conditionList[i]
        tb.aorimage_star.SpriteName = v.isFinish and stars[2] or stars[1]
        tb.aortext_condition.text = CoreTrialCondition:CheckCondition(v)
        local awardData = data.awradList[i]
        _G.StorageManager:GetInstance():GetItemBaseViewNew(awardData,
        tb.obj_item,
        function(trans)
            trans.gameObject:SetLocalScaleXYZ(0.83)
            trans:SetGou(v.isFinish)
            trans:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            tb.trans = trans
        end)
        table.insert(self.conditionList,tb)
    end
    for _,v in pairs(data.enemyList) do
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.CardAllItem,
            self.go_table.obj_enemylist,
            _G.handlerbind(self, self.showItemHeadInfo, v)
        )
    end
end

function CoreTrialView:showItemHeadInfo(item, cardData)
    item:ShowCardData(cardData, nil)
    item:ShowLevel(cardData.lv)
    table.insert(self.enemyList,item)
end

---刷新右侧当前层数信息
function CoreTrialView:RefreshTowerInfo(index)
    self.curBattleLevel = index
    self.go_table.aortext_level.text = GetLangPackValue(90023200002,self.curBattleLevel)
    local data = self.levelCfg[index]
    for i=1,#data.conditionList  do
        local tb = self.conditionList[i]
        local v = data.conditionList[i]
        tb.aorimage_star.SpriteName = v.isFinish and stars[2] or stars[1]
        tb.aortext_condition.text = CoreTrialCondition:CheckCondition(v)
        tb.trans:UpdateFunction(_G.handlerbind(self, self.ShowTips,data.awradList[i][1]))
        tb.trans:SetGou(v.isFinish)
        tb.trans:SetImage(data.awradList[i][1])
        tb.trans:ShowCount(data.awradList[i][2])
    end
    for _,v in pairs(self.enemyList) do
        local cardData = data.enemyList[_]
        v:ShowCardData(cardData, nil)
        v:ShowLevel(cardData.lv)
        v:HideOrShowLevel(cardData.lv ~= -1)
    end
    self.go_table.aortext_openTime:SetActiveE(0)
    if self.openLevel >= self.curBattleLevel and self.curLevel >= self.curBattleLevel then
        self.go_table.aorbtn_RestartDo:SetGray(false)
        self.go_table.aorrawimage_zhandou:SetGray(false)
        self.go_table.obj_fightEffect:SetActiveE(1)
    else
        self.go_table.aorbtn_RestartDo:SetGray(true)
        self.go_table.aorrawimage_zhandou:SetGray(true)
        self.go_table.obj_fightEffect:SetActiveE(0)
        local times = (index - self.openLevel)/self.continue
        times = math.ceil(times) - 1
        local day = times*self.intervalDay + self.intervalTimes
        if day > 0 then
            self.go_table.aortext_openTime:SetActiveE(1)
            self.go_table.aortext_openTime.text = GetLangPackValue(90022501339,day)
        end
    end
end

function CoreTrialView:InitTower(listView2, index)
    if index < 0 then
        return
    end
    local data = self.levelCfg[index+1]
    local item = nil
    if index + 1 < self.length then
        item = listView2:NewListViewItem("$_obj_TowerItem")
        local tb = _G.GetAutoGoTable(item)
        tb.index = index +1
        _G.AddViewBtnClick(item,_G.handlerbind(self, self.OnButtonClick,tb))
        tb.aorimage_star1.SpriteName = data.star < 1 and stars[1] or stars [2]
        tb.aorimage_star2.SpriteName = data.star < 2 and stars[1] or stars [2]
        tb.aorimage_star3.SpriteName = data.star < 3 and stars[1] or stars [2]
        tb.aortext_floor.text = GetLangPackValue(90023200002,index + 1)
        tb.obj_effect:RemoveAllChildren()
        UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_guangquan,tb.obj_effect,
        function(item)
            item:AddComponentE(typeof(CS.ParticleClipRect))
        end)
        if index + 1 == self.curBattleLevel then
            tb.aortext_floor.color = GetColorFromRGB(color.choice[1])
            self.oldToewer = tb
            --self.oldToewer.obj_unSelect:SetActiveE(0)
            self.oldToewer.obj_effect:SetActiveE(1)
        else
            tb.aortext_floor.color = GetColorFromRGB(color.unChoice[1])
            tb.obj_effect:SetActiveE(0)
        end
    else
        item = listView2:NewListViewItem("$_obj_TowerGourd")
        local tb = _G.GetAutoGoTable(item,_G.handlerbind(self, self.OnButtonClick,index+1))
        self.finalTb = tb
        tb.obj_effect:RemoveAllChildren()
        tb.obj_seal:RemoveAllChildren()
        if self.curLevel == self.length then
            tb.obj_seal:SetActiveE(0)
            UIUtils.LoadEffectByCfg(effectCfg.ef_CoreTrialView_chuansongmen,tb.obj_effect,
            function(item)
                item:AddComponentE(typeof(CS.ParticleClipRect))
            end)
        else
            UIUtils.LoadEffectByCfg(effectCfg.ef_feng_gaoliang,tb.obj_seal,
            function(item)
                item:AddComponentE(typeof(CS.ParticleClipRect))
            end)
        end
    end
    return item
end

function CoreTrialView:RefreshData(isNext,nextLv)
    self.levelCfg = self.typeClass.levelCfg
    self.curLevel = self.typeClass.curLevel
    self.awradList = self.typeClass.awradList
    self.finalAwardCfg = self.typeClass.finalAwardCfg
    if isNext and nextLv == self.length then
        _G.Events:GetInstance():AddListener(_G.AnimationEvents.CoreTrialAnim, self.AnimFinish, self)
        self.finalTb.obj_seal:SetActiveE(0)
        self.go_table.obj_mask:SetActiveE(1)
        UIUtils.LoadEffectByCfg(effectCfg.ef_CoreTrialView_fengyinjiechu,self.finalTb.obj_effect)
        self.towerList:MovePanelToItemIndex(self.length-1)
        self:UpdateLocalLevel()
    else
        if self.levelCfg[self.curBattleLevel].star == 3 then
            self.curBattleLevel = self.curBattleLevel + 1
            if self.curBattleLevel <= #self.levelCfg then
                --self:UpdateLocalLevel()
                self:MoveAnim(self.curBattleLevel,350)
                --self.towerList:MovePanelToItemIndex(self.curBattleLevel - 1)
            end
        end
    end
    self:RefreshTowerInfo(self.curBattleLevel)
    if isNext then
        self.curlevelPosy = self.curlevelPosy + 300
    end
    self.towerList:RefreshAllShownItem()
end
 
function CoreTrialView:AnimFinish()
    UIUtils.LoadEffectByCfg(effectCfg.ef_feng_gaoliang,self.finalTb.obj_effect)
    self.go_table.obj_mask:SetActiveE(0)
    _G.Events:GetInstance():RemoveListener(_G.AnimationEvents.CoreTrialAnim, self.AnimFinish, self)
end

function CoreTrialView:OnButtonClick(go,isOn,tb)
    local name = go:GetName()
    if name == "@_aorbtn_chain" then
        if tb ~= self.oldToewer then
            tb.aortext_floor.color = GetColorFromRGB(color.choice[1])
            --tb.obj_unSelect:SetActiveE(0)
            tb.obj_effect:SetActiveE(1)
            self.oldToewer.aortext_floor.color = GetColorFromRGB(color.unChoice[1])
            --self.oldToewer.obj_unSelect:SetActiveE(1)
            self.oldToewer.obj_effect:SetActiveE(0)
            self.oldToewer = tb
            self:RefreshTowerInfo(tb.index)
        end
    elseif name == "@_aorbtn_gourd" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CoreTrialSelectView.Name,self.curActivity)
    end
end

function CoreTrialView:ShowTips(go,got,isOn,rewardsid)
    require("CommonTipManager"):GetInstance():OpenPropTip(go.gameObject, rewardsid)
end

function CoreTrialView:InitTime()
    self.Times = self.endTime - TimeUtil.GetServerUnixTime()
    self.go_table.aortext_limitTime.text = GetLangPackValue(90022900045,TimeUtil.TransDayHourMineMiaoPushGift(self.Times))
    self:Stop_CloseTimer()
    self.Timers =
        _G.TimerManager:GetInstance():GetTimer(
        1,
        self.ShowTime,
        self,
        false,
        false,
        true
    )
    self.Timers:Start()
end

function CoreTrialView:ShowTime(elapsed)
    self.Times = self.Times - elapsed
    self.go_table.aortext_limitTime.text = GetLangPackValue(90022900045,TimeUtil.TransDayHourMineMiaoPushGift(Mathf.RoundToInt(self.Times)))
    if self.Times <= 0 then
        self:Stop_CloseTimer()
        self:Close()
    end
end

function CoreTrialView:Stop_CloseTimer()
    if self.Timers ~= nil then
        self.Timers:Stop()
        self.Timers = nil
    end
end

function CoreTrialView:UpdateLocalLevel()
    self.curlevelPosx,self.curlevelPosy = self.go_table.obj_Content:GetLocalPosition()
end

---层数跳转动画
function CoreTrialView:MoveAnim(targetLevel,Speed)
    --local localPosx,localPosy = self.go_table.obj_Content:GetLocalPosition()
    local distance = targetLevel * 350 -700
    local speed = Speed or 4000
    self.go_table.obj_mask:SetActiveE(1)
    self.go_table.obj_effect:SetActiveE(1)
    if targetLevel == self.length then
        distance = distance + 185
    end
    self.go_table.obj_Content:DOLocalMoveY(
        distance,
        4000,
        function()
            self.go_table.obj_mask:SetActiveE(0)
            self.go_table.obj_effect:SetActiveE(0)
            self:ShowQuickButton()
            --self:UpdateLocalLevel()
        end
    ):SetSpeedBased():SetEase(_G.CS.DG.Tweening.Ease.Linear)
end

return CoreTrialView