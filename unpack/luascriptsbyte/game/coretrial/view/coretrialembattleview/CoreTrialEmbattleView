---@class CoreTrialEmbattleView : UIBaseView	中文描述
---@field public go_table CoreTrialEmbattleView_GoTable GoTable
local CoreTrialEmbattleView = _G.BaseClass("CoreTrialEmbattleView", _G.UIBaseView)
local EmbattleController = require "EmbattleController"
local stars = {
    [1] = "sxzl_zjm_xingxing_weidianliang",
    [2] = "sxzl_zjm_xingxing_dianliang"
}
function CoreTrialEmbattleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function CoreTrialEmbattleView:OnCreate(embattleType, exitCall, battleCall,groupId,data,level,levelData)
    self.onExitCall = exitCall
    self.embattleType = embattleType
    self.onBattleCall = battleCall
    self.groupId = groupId
    self.data = data
    self:OpenEmbattleView()
    self:ShowCurSectionTag(level,levelData)
end

function CoreTrialEmbattleView:OnDestroy()
    self.onExitCall = nil
    self.onBattleCall = nil
end

function CoreTrialEmbattleView:ShowCurSectionTag(level,data)
    self.go_table.aortext_CurSection.text = _G.GetLangPackValue(90023200002,level)
    local CoreTrialCondition = require("CoreTrialCondition"):GetInstance()
    local item
    for i=1,#data.conditionList  do
        item = _G.InstantiateObject(self.go_table.obj_ImageContent, self.go_table.obj_Grid)
        local tb = _G.GetAutoGoTable(item)
        local v = data.conditionList[i]
        tb.aorimage_star.SpriteName = v.isFinish and stars[2] or stars[1]
        tb.aortext_condition.text = CoreTrialCondition:CheckCondition(v)
        local awardData = data.awradList[i]
        _G.StorageManager:GetInstance():GetItemBaseViewNew(awardData,
        tb.obj_item,
        function(trans)
            trans.gameObject:SetLocalScaleXYZ(0.83)
            trans:SetGou(v.isFinish)
            trans:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            tb.trans = trans
        end)
    end
    self.go_table.obj_move:SetActiveE(0)
end

function CoreTrialEmbattleView:OpenEmbattleView()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    EmbattleController:GetInstance():OpenEmbattle(
        self.embattleType,
        _G.EmbattleSaveType.server,
        false,
        _G.EmbattleControllerItemType.coreTrial,
        _G.handler(self, self.OnExitCall),
        self.onBattleCall,
        self.groupId,
        self.data
    )
end

function CoreTrialEmbattleView:OnExitCall()
    self:Close()
    if self.onExitCall then
        self.onExitCall()
        self.onExitCall = nil
    end
end
function CoreTrialEmbattleView:OnBattleCall(...)
    if self.onBattleCall then
        self.onBattleCall(...)
        self.onBattleCall = nil
    end
end

---监听界面打开
---@param name string 界面名称
function CoreTrialEmbattleView:OnEmbattleViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
        local embattleView = _G.UIManager:GetInstance():GetWindowCtrl(name)
        _G.UIManager:GetInstance():ChangeCanvasOrder(
            name,
            self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
        )
        --embattleView:SetQuitCallback(_G.handler(self, self.CheckQuitEmbattle))
        embattleView.transform:SetParentE(self.go_table.trans_view)
    end
end

function CoreTrialEmbattleView:OnClickBtn(go,isOn)
    if go == self.go_table.aorbtn_unfold then
        if self.go_table.obj_move:GetActiveSelf() == 1 then
            self.go_table.obj_move:SetActiveE(0)
            self.go_table.obj_move_anniu:SetLocalPosition(22,0,0)
            self.go_table.obj_move:SetLocalPosition(22,0,0)
        else
            self.go_table.obj_move:SetActiveE(1)
            self.go_table.obj_move_anniu:SetLocalPosition(-480,0,0)
            self.go_table.obj_move:SetLocalPosition(-480,0,0)
        end
    end
end

return CoreTrialEmbattleView