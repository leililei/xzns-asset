---@class CoreTrialSettlementView : SettlementBaseView	中文描述
local SettlementBaseView = require "SettlementBaseView"
---@field public go_table CoreTrialSettlementView_GoTable GoTable
local CoreTrialSettlementView = _G.BaseClass("CoreTrialSettlementView", SettlementBaseView)
local stars = {
    [1] = "sxzl_zjm_xingxing_weidianliang",
    [2] = "sxzl_zjm_xingxing_dianliang"
}
---界面的入口函数
function CoreTrialSettlementView:OnCreateChild(data,typeClass,result)
    self.data = data
    self.typeClass = typeClass
    self.levelData = typeClass.levelCfg[typeClass.curBattleLevel]
    self:ShowData(self.levelData)
    self:OpenEmbattleView(result)
end

function CoreTrialSettlementView:OpenEmbattleView(result)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, self.callback,result)
end

---按钮点击事件在这里派发
function CoreTrialSettlementView:OnClickBtn(go)
    self:CloseCall(require("SettlementModel").FunctionEnum.None)
end

function CoreTrialSettlementView:ShowData(data)
    local CoreTrialCondition = require("CoreTrialCondition"):GetInstance()
    local finish = {}
    for k,v in pairs(data.conditionList) do
        finish[k] = v.isFinish
    end
    if self.data.condition then
        for k,v1 in pairs(self.data.condition) do
            finish[v1] = true
        end
    end
    local item
    for i=1,#data.conditionList  do
        item = _G.InstantiateObject(self.go_table.obj_ImageContent, self.go_table.obj_Grid)
        local tb = _G.GetAutoGoTable(item)
        local v = data.conditionList[i]
        tb.aorimage_star.SpriteName = finish[i] and stars[2] or stars[1]
        tb.aortext_condition.text = CoreTrialCondition:CheckCondition(v)
        local awardData = data.awradList[i]
        _G.StorageManager:GetInstance():GetItemBaseViewNew(awardData,
        tb.obj_item,
        function(trans)
            trans.gameObject:SetLocalScaleXYZ(0.83)
            trans:SetGou(finish[i])
            trans:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            tb.trans = trans
        end)
    end
end

---监听界面
---@param name string 界面名称
function CoreTrialSettlementView:OnUIOpened(name)
    if name == _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
        self.ShowAwardWithButtonView = _G.UIManager:GetInstance():GetWindowCtrl(name)
        self.ShowAwardWithButtonView.go_table.aortext_tip:SetParentE(self.ShowAwardWithButtonView.go_table.obj_tips1)
        _G.UIManager:GetInstance():ChangeCanvasOrder(
            name,
            self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 1
        )
        self.ShowAwardWithButtonView.transform:SetParentE(self.go_table.trans_view)
        self.go_table.obj_info:SetActiveE(1)
    end
end

---监听界面
---@param name string 界面名称
function CoreTrialSettlementView:OnUIClosed(name)
    if name == _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
        self:Close()
    end
end

function CoreTrialSettlementView:EscClose()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name)
    if view then
        view:CloseCall(_G.SettlementModel.FunctionEnum.None)
    end
end

return CoreTrialSettlementView
