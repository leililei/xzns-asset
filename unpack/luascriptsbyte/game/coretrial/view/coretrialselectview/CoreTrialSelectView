---@class CoreTrialSelectView : UIBaseView	中文描述
---@field public go_table CoreTrialSelectView_GoTable GoTable
local CoreTrialSelectView = _G.BaseClass("CoreTrialSelectView", _G.UIBaseView)
local StorageManager = _G.StorageManager:GetInstance()
local initArray = {[1] = 12,[2] = 1}
local tipsCfg = _G.ConfigManager.tips_system_cfg
local GetLangPackValue = _G.GetLangPackValue
function CoreTrialSelectView:Awake()
    self.leftLists = {}
    self.rightLists = {}
    self.curSelect = 1
    self.curIndex = 0
    self.AfkModel = require "AfkModel":GetInstance()
    self.curAfk = self.AfkModel:GetCurSection()
    self.curChapter = self.AfkModel:GetCurAfkChapter()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function CoreTrialSelectView:OnCreate(curActivity)
    self.curActivity = curActivity
    self.finalAwardCfg = self.curActivity.typeClass.finalAwardCfg
    self.curLevel = self.curActivity.typeClass.curLevel
    self.levelCfg = self.curActivity.typeClass.levelCfg
    self.itemDataList = self.curActivity.typeClass.itemDataList
    self.length = #self.finalAwardCfg
    self.go_table.scrollloopvectical_ItemList:InitItemData(math.ceil(self.length/4),_G.handler(self,self.InitLeftScroll))
    self.go_table.scrollloopvectical_AwardList:InitItemData(3,_G.handler(self,self.InitRightScroll))
    self:InitSelect()
end

---初始化选中槽位
function CoreTrialSelectView:InitSelect()
    local select = -1
    local noSelect = -1
    for _,v in pairs(self.finalAwardCfg) do
        if self:CheckCondition(v.condition)then
            if v.index == 0 and not v.receive then
                noSelect = v.sid
                select = v.sid
                self.leftLists[noSelect].obj_select:SetActiveE(1)
                self:OnClickLeft(nil,nil,noSelect)
                break
            else
                if not v.receive then
                    select = v.sid
                else
                    select = 1
                end
            end
            break
        end
    end
    if noSelect == -1 and select == -1 then
        self.go_table.obj_nil:SetActiveE(1)
        self.go_table.scrollloopvectical_AwardList:SetActiveE(0)
    elseif noSelect == -1 and select ~= -1 then
        self.leftLists[select].obj_select:SetActiveE(1)
        self:OnClickLeft(nil,nil,select)
    end
    for _,v in pairs(self.finalAwardCfg) do
        if not self:CheckCondition(v.condition) then
            self.go_table.aortext_bottomTips:SetActiveE(1)
            local id = self.AfkModel:GetSectionChapter(v.condition[2])
            self.go_table.aortext_bottomTips.text = GetLangPackValue(90047010001,id)
            break
        end
    end
    self:ShowGetAwardButton()
end

---界面的销毁函数
function CoreTrialSelectView:OnDestroy()
end

---按钮点击事件在这里派发
function CoreTrialSelectView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_choice then
        if self.curIndex ~= self.finalAwardCfg[self.curSelect].index and self.curIndex ~=0 and not self.finalAwardCfg[self.curSelect].receive then
            self.curActivity.typeClass:ChoiceAward(
                self.curSelect,
                self.curIndex,
                function()
                    self:SetCurAward()
                    self:ShowGetAwardButton()
                end)
        end
    elseif go == self.go_table.aorbtn_getAward then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            830301,
            nil,
            function()
                self.curActivity.typeClass:GetFinalAward(
                function()
                    self:ShowGetAwardButton()
                    self.go_table.scrollloopvectical_ItemList:UpdateAllItem()
                end
                )
            end,
            nil,
            nil,
            nil
        )
    end
end

---显示当前槽位奖励
function CoreTrialSelectView:SetCurAward()
    local tb = self.leftLists[self.curSelect]
    local data = self.finalAwardCfg[self.curSelect]
    tb.obj_item:SetActiveE(1)
    tb.obj_unhave:SetActiveE(0)
    tb.trans:SetImage(data.select[self.curIndex][1])
    tb.trans:ShowCount(data.select[self.curIndex][2])
    for index,v in pairs(self.finalAwardCfg) do
        if v.index ==0 and self:CheckCondition(v.condition) then
            self:OnClickLeft(nil,nil,index)
            break
        end
    end
end

function CoreTrialSelectView:InitLeftScroll(index,obj)
    if index < 0 then
        return
    end
    local loopitemTb = _G.GetAutoGoTable(obj, _G.handler(self))
    local name = "obj_award"
    for i = 1, 4 do
        local item = loopitemTb[name .. i]
        local curIndex = index*4 + i
        local data = self.finalAwardCfg[curIndex]
        local itemTb
        if self.leftLists[curIndex] then
            itemTb = self.leftLists[curIndex]
            itemTb.obj_item:SetActiveE(0)
            itemTb.obj_unhave:SetActiveE(0)
            itemTb.obj_suo:SetActiveE(0)
        else
            itemTb = _G.GetAutoGoTable(item, _G.handlerbind(self, self.OnClickLeft, curIndex))
            StorageManager:GetItemBaseViewNew(
                initArray,
                itemTb.obj_item,
                function(trans)
                    trans.gameObject:SetLocalScaleXYZ(0.73)
                    trans:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    itemTb.trans = trans
                end)
                itemTb.obj_item:SetActiveE(0)
                self.leftLists[curIndex] = itemTb
            end
            if data ~= nil then
            local chapter = self.AfkModel:GetSectionChapter(data.condition[2])
            itemTb.chapter = chapter
            if self:CheckCondition(data.condition) then
                self.go_table.obj_nil:SetActiveE(0)
                if data.index ~= 0 then
                    itemTb.obj_item:SetActiveE(1)
                    itemTb.trans:SetImage(data.select[data.index][1])
                    itemTb.trans:ShowCount(data.select[data.index][2])
                    itemTb.trans:SetGou(data.receive)
                else
                    itemTb.obj_unhave:SetActiveE(1)
                end
            else
                itemTb.obj_suo:SetActiveE(1)
            end
        else
            itemTb.gameObject:SetActiveE(0)
        end
    end
end

function CoreTrialSelectView:InitRightScroll(index,obj)
    if index < 0 then
        return
    end
    local loopitemTb = _G.GetAutoGoTable(obj, _G.handler(self))
    local name = "obj_award"
    for i = 1, 3 do
        local item = loopitemTb[name .. i]
        local curIndex = index*3 + i
        local itemTb
        local data = self.finalAwardCfg[self.curSelect].select[curIndex]
        if not data then
            item:SetActiveE(0)
        else
            item:SetActiveE(1)
            if self.rightLists[curIndex] then
                itemTb = self.rightLists[curIndex]
                itemTb.trans:SetImage(data[1])
                itemTb.trans:ShowCount(data[2])
            else
                itemTb = _G.GetAutoGoTable(item, _G.handlerbind(self, self.OnClickRight, curIndex))
                StorageManager:GetItemBaseViewNew(
                data,
                itemTb.obj_item,
                function(trans)
                    trans.gameObject:SetLocalScaleXYZ(0.73)
                    trans:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    itemTb.trans = trans
                end
                )
                self.rightLists[curIndex] = itemTb
            end
            if self.finalAwardCfg[self.curSelect].index == curIndex then
                itemTb.obj_choice:SetActiveE(1)
                self.curIndex = curIndex
            else
                itemTb.obj_choice:SetActiveE(0)
            end
        end
    end
end

---左侧槽位点击事件
function CoreTrialSelectView:OnClickLeft(go,isOn,index)
    local tb = self.leftLists[index]
    if tb.obj_suo:GetActiveSelf() == 1 then
        local content = GetLangPackValue(tipsCfg[830102].content,tb.chapter)
        _G.PopWindowManager:GetInstance():ShowAllTips(830102,content)
        return
    end
    if self.curSelect ~= index and self.curSelect ~= 0then
        local oldTb = self.leftLists[self.curSelect]
        oldTb.obj_select:SetActiveE(0)
    end
    tb.obj_select:SetActiveE(1)
    self.curSelect = index
    self:showChangeAward(index)
end

---检测槽位是否开启
function CoreTrialSelectView:CheckCondition(condition)
    if condition[1] == 4 then
        return condition[2] < self.curAfk
    end
    return false
end

function CoreTrialSelectView:showChangeAward()
    self.curIndex = 0
    self.go_table.scrollloopvectical_AwardList:UpdateAllItem()
end

---右侧奖励点击事件
function CoreTrialSelectView:OnClickRight(go,isOn,index)
    local tb = self.rightLists[index]
    if self.curIndex ~= index and self.curIndex ~= 0 then
        local oldTb = self.rightLists[self.curIndex]
        oldTb.obj_choice:SetActiveE(0)
    elseif self.curIndex == index then
        local data = self.finalAwardCfg[self.curSelect].select[index]
        require "CommonTipManager":GetInstance():OpenTip(tb.gameObject,data[1])
    end
    tb.obj_choice:SetActiveE(1)
    self.curIndex = index
end

---显示领奖按钮
function CoreTrialSelectView:ShowGetAwardButton()
    self.go_table.aorbtn_getAward:SetActiveE(0)
    if self.curLevel > #self.levelCfg then
        for _,v in pairs(self.finalAwardCfg) do
            if v.index ~= 0 and not v.receive then
                self.go_table.aorbtn_getAward:SetActiveE(1)
                break
            end
        end
    end
end

return CoreTrialSelectView