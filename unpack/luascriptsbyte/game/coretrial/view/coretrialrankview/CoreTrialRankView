        -- _G.SortList(
        --     self.rankDatas,
        --     function(a)
        --         return -a.level,-a.star,-a.pass_time
        --     end)
        self.rankList = {}
        self.rewardList_Rank = {}
        self.Rank.scrollloopvectical_rankList:InitItemData(#self.rankDatas, _G.handler(self, self.RefreshRank))
        self.playerRank = data.self_rank
        self:InitPlayer()
        self:InitToggle()
        self.go_table.toggle_rank.isOn = true
    else
        self.Rank.obj_no:SetActiveE(1)
    end
end

