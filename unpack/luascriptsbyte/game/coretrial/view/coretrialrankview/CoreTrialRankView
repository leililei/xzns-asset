---排行
function CoreTrialRankView:OnRank(isOn)
    -- _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)

    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Rank, isOn)
    if not isOn then
        return
    end
    if not self.Rank then
        self.Rank = _G.GetAutoGoTable(self.go_table.obj_Rank)
        _G.GameUtil.SetActiveByCondition(self.Rank.obj_yiwu, false)
        self.rankDatas = require "DungonesModel":GetInstance().rank_all_player or {}
        self.rankList = {}
        self.rewardList_Rank = {}
        self.RewardDatas = _G.table.toArray(_G.ConfigManager.boss_rank_cfg)
        -- _G.table.sort(
        --         self.RewardDatas,
        --         function(a, b)
        --             return a.id < b.id
        --         end
        -- )
        self.Rank.scrollloopvectical_rankList:InitItemData(#self.rankDatas, _G.handler(self, self.RefreshRank))
        _G.GameUtil.SetActiveByCondition(self.Rank.obj_no, #self.rankDatas <= 0)
        self:InitPlayer()
    end
end

---界面的销毁函数
function CoreTrialRankView:OnDestroy()
end

---按钮点击事件在这里派发
function CoreTrialRankView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

function CoreTrialRankView:RefreshRank(index, obj)
    local newindex = index + 1
    local instanceID = obj:GetInstanceIDE()
    local tb1 = self.rankList[instanceID]
    if not self.rankList[instanceID] then
        tb1 = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.RankItemClick, tb1))
        self.rankList[instanceID] = tb1
    end
    local tb = self.rankList[instanceID]
    local data = self.rankDatas[newindex]
    tb.rankData = data
    _G.GameUtil.SetActiveByCondition(tb.aorimage_rankBg, newindex <= 3)
    _G.GameUtil.SetActiveByCondition(tb.obj_rankBg2, newindex > 3)
    if newindex <= 3 then
        tb.aorimage_rankBg.SpriteName = "tz_qjhs_di_0" .. (newindex + 1)
        tb.aorimage_rank.SpriteName = "tz_qjhs_phb_mingci_0" .. newindex
    else
        tb.aortext_rankNum.text = newindex
    end
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase,data.role_info,1,true,true)
    tb.aortext_name.text = data.role_info.name
    tb.aortext_floor.text = data.level
    tb.aortext_star.text = data.star
    local times = _G.TimeUtil.GetDateTime(data.pass_time)
    tb.aortext_time1.text = _G.string.format("%s-%s-%s", times.year, times.month, times.day)
    tb.aortext_time2.text = _G.string.format("%02d:%02d:%02d", times.hour, times.minute, times.second)
end

function CoreTrialRankView:InitPlayer()
    local PlayerModel = _G.PlayerModel:GetInstance()
    if not self.player then
        self.player =
            _G.GetAutoGoTable(
            self.Rank.obj_player,
            _G.handlerbind(
                self,
                self.RankItemClick,
                {rankData = {role_info = {uid = PlayerModel:GetPlayerUid()}}}
            )
        )
    end
    local tb = self.player
    local newindex = self.playerRank.index
    if newindex == 0 then
        tb.aortext_rankNum.text = _G.LangUtil.GetLangPackValue(90022900040)
    else
        tb.aortext_rankNum.text = newindex
    end
    tb.aortext_floor.text = self.playerRank.values[1] ==0 and "" or self.playerRank.values[1]
    tb.aortext_star.text = self.playerRank.values[2] ==0 and "" or self.playerRank.values[2]
    tb.aortext_name.text = _G.PlayerModel:GetInstance():GetName()
    local Params_PlayerHeadItem = {}
    Params_PlayerHeadItem.frame = PlayerModel:GetCurFrame()
    Params_PlayerHeadItem.lv = PlayerModel:GetLevel()
    Params_PlayerHeadItem.style = PlayerModel:GetRoleStyle()
    Params_PlayerHeadItem.sid = PlayerModel:GetRoleStyle()
    Params_PlayerHeadItem.uid =PlayerModel:GetPlayerUid()
    Params_PlayerHeadItem.title = PlayerModel.title
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase,Params_PlayerHeadItem,1,true,true)
    if newindex > 0 then
        local times = _G.TimeUtil.GetDateTime(self.playerRank.values[3])
        tb.aortext_time1.text = _G.string.format("%s-%s-%s", times.year, times.month, times.day)
        tb.aortext_time2.text = _G.string.format("%02d:%02d:%02d", times.hour, times.minute, times.second)
    else
        tb.aortext_time1.text = ""
        tb.aortext_time2.text = ""
    end
end

function CoreTrialRankView:RankItemClick(go, ref, tb)
    local data = tb.rankData
    local name = go:GetName()
    if name == "@_aorbtn_HeadClick" then
        if data.role_info.uid > 0 then
            if data.role_info.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.PopWindowManager:GetInstance():ShowAllTips(620109)
            else
                _G.SystemSettingManager:GetInstance():OpenView(data.role_info.uid)
            end
        end
    end
end

return CoreTrialRankView