---@class CoreTrialDetailView : UIBaseView	中文描述
---@field public go_table CoreTrialDetailView_GoTable GoTable
local CoreTrialDetailView = _G.BaseClass("CoreTrialDetailView", _G.UIBaseView)
local StorageManager = _G.StorageManager:GetInstance()
local GetLangPackValue = _G.GetLangPackValue
local stars = {
    [1] = "sxzl_zjm_xingxing_weidianliang",
    [2] = "sxzl_zjm_xingxing_dianliang"
}
function CoreTrialDetailView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function CoreTrialDetailView:OnCreate(curActivity,data,callback)
    self.callBack = callback
    self.curActivity = curActivity
    self.haveStar = self.curActivity.typeClass.haveStar
    self.data = data
    self.go_table.aortext_mystar.text = GetLangPackValue(90043010001,self.haveStar,#data*3)
    local level = 0
    for _,v in pairs(self.data) do
        level = v.layer - 1
        if v.star < 3 then
            break
        end
    end
    self.rewardLists = {}
    self.go_table.scrollloopvectical_boxList:InitItemData(#data, _G.handler(self, self.InitList),level)
end

---界面的销毁函数
function CoreTrialDetailView:OnDestroy()
end

---按钮点击事件在这里派发
function CoreTrialDetailView:OnClickBtn(go)
    if go == self.go_table.aorbtn_anyclose then
        self:Close()
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    end
end

function CoreTrialDetailView:InitList(index,obj)
    local level = index + 1
    obj:SetName(level)
    local instanceID = obj:GetInstanceIDE()
    local data = self.data[level]
    local tb = _G.GetAutoGoTable(obj,_G.handlerbind(self, self.OnClick, level))
    tb.aortext_star.text = GetLangPackValue(90044010001)
    tb.aorimage_star1.SpriteName = data.star < 1 and stars[1] or stars [2]
    tb.aorimage_star2.SpriteName = data.star < 2 and stars[1] or stars [2]
    tb.aorimage_star3.SpriteName = data.star < 3 and stars[1] or stars [2]
    tb.aortext_floor.text = GetLangPackValue(90023200002,level)
    if data.star == 3 then
        tb.aorbtn_jump:SetActiveE(0)
        tb.obj_complete:SetActiveE(1)
    elseif data.star == 0 then
        tb.aorbtn_jump:SetActiveE(0)
        tb.obj_complete:SetActiveE(0)
    else
        tb.obj_complete:SetActiveE(0)
        tb.aorbtn_jump:SetActiveE(1)
    end
    for _,v in pairs(data.awradList) do
        if self.rewardLists[instanceID .. _] then
            self.rewardLists[instanceID .. _]:SetImage(v[1])
            self.rewardLists[instanceID .. _]:ShowCount(v[2])
            self.rewardLists[instanceID .. _]:UpdateFunction(_G.handlerbind(self, self.ShowTips,v[1]))
        else
            StorageManager:GetItemBaseViewNew(v,tb.obj_Content,
        function(trans)
            trans.gameObject:SetLocalScaleXYZ(0.83)
            trans:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            self.rewardLists[instanceID .. _] = {}
            self.rewardLists[instanceID .. _] = trans
            end)
        end
    end
end

function CoreTrialDetailView:OnClick(go,isOn,level)
    local name = go:GetName()
    if name == "@_aorbtn_jump" then
        self:Close()
        self.callBack(level)
    end
end

function CoreTrialDetailView:ShowTips(go,got,isOn,rewardsid)
    require("CommonTipManager"):GetInstance():OpenPropTip(go.gameObject, rewardsid)
end

return CoreTrialDetailView