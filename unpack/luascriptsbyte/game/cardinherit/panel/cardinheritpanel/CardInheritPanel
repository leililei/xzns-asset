local CardInheritModel = require("CardInheritModel")
local CardInfoManager = require("CardInfoManager")

---@class CardInheritPanel : UIBaseView
---@field public go_table _obj_cardInheritPanel_GoTable
---@field public curCfg card_inherit_cfg
---@field public rolesNode _obj_cardInheritPanel._obj_scale1_GoTable[]
local CardInheritPanel = _G.BaseClass("CardInheritPanel", _G.Component)

local InheritBg = {
    "ui_qyxt_jc_icon",
    "ui_qyxt_jc_icon2"
}

local BuffState = {
    CanUnlock = 1, --可激活
    Unlock = 2,    --已激活
    Lock = 3       --未达条件
}

function CardInheritPanel:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, _G.handler(self, self.SixUpdate), self)
end

function CardInheritPanel:Awake()
    self.rolesNode = {
        _G.GetAutoGoTable(self.go_table.obj_scale1),
        _G.GetAutoGoTable(self.go_table.obj_scale2),
        _G.GetAutoGoTable(self.go_table.obj_scale3),
        _G.GetAutoGoTable(self.go_table.obj_scale4)
    }
    self.cardsNode = {
        _G.GetAutoGoTable(self.go_table.obj_heads1),
        _G.GetAutoGoTable(self.go_table.obj_heads2),
        _G.GetAutoGoTable(self.go_table.obj_heads3),
        _G.GetAutoGoTable(self.go_table.obj_heads4)
    }
    self.cardLua = {}
end

function CardInheritPanel:OnCreate()
    self:InitData()
    self:InitView()
    local resources = _G.ConfigManager.ui_cfg.PlayerTreeView.resources
    self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, resources))
    self.playerHead =
        self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))
end

function CardInheritPanel:InitData()
    self.inheritLis = {}
    local illCfg = _G.ConfigManager.illustrations_card_cfg
    local isHide
    for k, v in pairs(_G.ConfigManager.card_inherit_cfg) do
        isHide = true
        for _, cardSid in pairs(v.cards) do
            if _G.GlobalConditionManager.CheckConditionArrays(illCfg[cardSid].condition_type) then
                isHide = false
            end
        end
        if not isHide then
            _G.table.insert(self.inheritLis, v)
        end
    end
end

function CardInheritPanel:InitView()
    self:CalCanUnlockIndex()
    self.curCfg = self.inheritLis[self.curIndex]
    self.curBuffLis = self.curCfg.att1
    self.go_table.scrollloophorizontal_inherit:InitItemData(
        #self.inheritLis,
        _G.handler(self, self.RefreshInheritItem),
        self.curIndex - 1
    )
    self.go_table.scrollloophorizontal_buff:InitItemData(
        #self.curBuffLis,
        _G.handler(self, self.RefreshBuffItem),
        self.curBuffIndex - 1
    )
    self:UpdateView()
end

function CardInheritPanel:CalCanUnlockIndex()
    self.curIndex = 1
    self.curBuffIndex = 1
    local canUnlock, sidStar, inheritStar, inheritIndex = CardInheritModel:GetInstance():GetCanUnlockBuff()
    self.canUnlock = canUnlock
    self.sidStar = sidStar
    self.inheritStar = inheritStar
    if _G.table.isEmptyOrNil(canUnlock) then
        return
    end
    for i, cfg in pairs(self.inheritLis) do
        if canUnlock[cfg.id] then
            self.curIndex = i
            self.curBuffIndex = canUnlock[cfg.id][1]
            return
        end
    end
end

function CardInheritPanel:UpdateView()
    self.go_table.aortext_name.text = _G.GetLangPackValue(self.curCfg.name)
    self:UpdateRoles()
end

function CardInheritPanel:UpdateRoles()
    local tb, sid, cfg, card, star, showGod, condition
    --如果是6类型需要判断是否满足显示条件
    showGod = _G.GlobalConditionManager.CheckConditionArrays(_G.ConfigManager.discrete_cfg[106706])
    local num = #self.curCfg.cards
    local illCfg = _G.ConfigManager.illustrations_card_cfg
    for i = 1, #self.rolesNode do
        tb = self.rolesNode[i]
        tb.obj_role:ClearChildren()
        condition = (self.curCfg.cards[i] and illCfg[self.curCfg.cards[i]]) and
        _G.GlobalConditionManager.CheckConditionArrays(illCfg[self.curCfg.cards[i]].condition_type) or false
        tb.gameObject:SetActiveE((i <= num and condition) and 1 or 0)
        self.cardsNode[i].gameObject:SetActiveE((i <= num and condition) and 1 or 0)
        if i <= num and condition then
            sid = self.curCfg.cards[i]
            cfg = CardInfoManager.GetShowCfgBySid(sid)
            if require "CardInfoManager":GetInstance():CheckMultiMatchCOP(cfg.Elements_new , _G.CardElementType.God) and not showGod then
                self.cardsNode[i].gameObject:SetActiveE(0)
                self.rolesNode[i].gameObject:SetActiveE(0)
            else
                local pos = self.curCfg.pos_portrait1[i]
                tb.obj_role:SetLocalScaleXYZ(pos[4]*0.2)
                tb.obj_role:SetLocalPosition(pos[1], pos[2], pos[3])
                local path = _G.UIUtils.GetBattleSpine(cfg, _G.UseBattleSpine.CardInheritPanel)
                local cardsid=cfg.card and cfg.card or cfg.id
                _G.PoolsManager:GetInstance():Spawn(
                    path,
                    _G.ePoolType.Temporary,
                    tb.obj_role,
                    function(trans)
                        if self.go_table == nil then
                            _G.DestroyObject(trans)
                        end
                        --- 只有星座女神有神环
                        if _G.AppSetting.IsXzns then
                            local godHaloID = _G.PlayerModel:GetInstance():IsCardWearGodHalo(cardsid)
                            if godHaloID ~= 0 then
                                local effCfg = _G.ConfigManager.god_halo_cfg[godHaloID].ui_effect_cfg
                                --- 神环路径，父级路径(加载角色的下面)
                                _G.UIUtils.LoadGodHalo(effCfg, trans,godHaloID)
                            end
                            _G.UIUtils.LoadArtifacteffect(trans, cardsid ,nil,nil)
                        end
                    end
                )
                card = self.sidStar[sid]
                star = card and card.star or _G.ConfigManager.card_cfg[sid].Star
                self.cardsNode[i].aorimage_mask:SetActiveE(card == nil and 1 or 0)
                self:ShowCardItem(i, sid, cfg.id, star, card == nil)
            end
        end
    end
end

function CardInheritPanel:SixUpdate()
    self:InitData()
    self:InitView()
end

function CardInheritPanel:ShowCardItem(index, sid, skinId, star, noCard)
    if not self.cardLua[index] then
        self.cardLua[index] = true
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.CardAllItem,
            self.cardsNode[index].obj_card,
            function(item)
                item:Show(sid, nil, star, nil, 1, nil, skinId)
                item:HideOrShowLevel(false)
                item:HideOrShowProfession(false)
                -- item:SetAllGray(noCard)
                self.cardLua[index] = item
            end
        )
    elseif self.cardLua[index] ~= true then
        self.cardLua[index]:Show(sid, nil, star, nil, 1, nil, skinId)
        -- self.cardLua[index]:SetAllGray(noCard)
    end
    local cardCfg = _G.ConfigManager.card_cfg[sid]
    self.cardsNode[index].aortext_name.text = _G.GetLangPackValue(cardCfg.Name)
end

function CardInheritPanel:RefreshInheritItem(index, obj)
    index = index + 1
    ---@type _obj_cardInheritPanel._obj_inheritItem_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickInheritItem, index))
    tb.aorimage_selectBg.SpriteName = index == self.curIndex and InheritBg[1] or InheritBg[2]
    local cfg = self.inheritLis[index]
    tb.aortext_name.text = _G.GetLangPackValue(cfg.name)
end

function CardInheritPanel:RefreshBuffItem(index, obj)
    index = index + 1
    ---@type _obj_cardInheritPanel._obj_buffItem_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickBuffItem, index))
    local attrId = self.curCfg.att1[index][1]
    ---@type attribute_cfg
    local attCfg = _G.ConfigManager.attribute_cfg[attrId]
    local curStar = self.inheritStar[self.curCfg.id]
    tb.aortext_name.text = _G.GetLangPackValue(attCfg.name)
    tb.aorrawimage_icon:LoadImage(attCfg.icon)
    for i = 1, 2 do
        tb["aortext_attr" .. i].text = self:GetPropStr(attCfg.attribute[i])
    end
    tb.aortext_stars.text = "<color=#097a04>" .. curStar .. "</color>/" .. self.curCfg.condition_star1[index]

    local state = BuffState.Lock
    if CardInheritModel:GetInstance():GetBuffIsUnlock(self.curCfg.id, index) then
        state = BuffState.Unlock
    elseif curStar >= self.curCfg.condition_star1[index] then
        state = BuffState.CanUnlock
    end
    tb.aorbtn_active:SetActiveE(state == BuffState.CanUnlock and 1 or 0)
    tb.aorimage_isActive:SetActiveE(state == BuffState.Unlock and 1 or 0)
end

function CardInheritPanel:GetCurCanUnlockIndex()
    local conStars = self.curCfg.condition_star1
    for i = 1, #conStars do
        if self.inheritStar[self.curCfg.id] >= conStars[i] then
            if not CardInheritModel:GetInstance():GetBuffIsUnlock(self.curCfg.id, i) then
                return i
            end
        end
    end
    return 1
end

function CardInheritPanel:GetPropStr(attribute)
    if attribute == nil then
        return ""
    end
    local key = attribute[1]
    local num = _G.tonumber(attribute[3])
    local aType = attribute[2] == "1" and _G.AttCountType.other or _G.tonumber(attribute[2])
    num = _G.AttributeClassManager:GetInstance():GetValueWithName(key, num, aType)
    local isPer = attribute[2] == "2" and true or false
    return self:ToPropNum(key, num, isPer)
end

---属性数字转换
---@param key string 属性key
---@param num number 属性值
---@return string 属性值文本
function CardInheritPanel:ToPropNum(key, num, isPer)
    local numStr
    if _G.AttrType[key].percentage == 1 or isPer then
        num = num * 100
        num = _G.GameUtil.FormatNum(num)
        numStr = _G.tostring(num) .. "%"
    else
        num = _G.math.floor(num)
        num = _G.GameUtil.NumberWY(num)
        numStr = _G.tostring(num)
    end
    return _G.AttrType[key].des .. "<color=#097a04>+" .. numStr .. "</color>"
end

function CardInheritPanel:OnClickInheritItem(go, isOn, index)
    if index == self.curIndex then
        return
    end
    self.curIndex = index
    self.curCfg = self.inheritLis[self.curIndex]
    self.curBuffIndex = self:GetCurCanUnlockIndex()
    self.go_table.scrollloophorizontal_inherit:UpdateAllItem()
    local preNum = #self.curBuffLis
    self.curBuffLis = self.curCfg.att1
    local nowNum = #self.curBuffLis
    local jumpIndex = self.curBuffIndex
    if jumpIndex > #self.curBuffLis - 2 then
        jumpIndex = #self.curBuffLis - 2
    end
    jumpIndex = jumpIndex - 1
    if nowNum ~= preNum then
        self.go_table.scrollloophorizontal_buff:UpdateCount(nowNum, jumpIndex)
    else
        self.go_table.scrollloophorizontal_buff:UpdateAllItem()
        self.go_table.scrollloophorizontal_buff:ScrollToIndex(jumpIndex)
    end
    self:UpdateView()
end

function CardInheritPanel:GetAllUnlockIndex()
    local curStar = self.inheritStar[self.curCfg.id]
    local indexes = {}
    for i = 1, #self.curBuffLis do
        if curStar >= self.curCfg.condition_star1[i] and not CardInheritModel:GetInstance():GetBuffIsUnlock(self.curCfg.id, i) then
            _G.table.insert(indexes, i)
        end
    end
    return indexes
end

function CardInheritPanel:OnClickBuffItem(go, isOn, index)
    if self.inheritStar[self.curCfg.id] < self.curCfg.condition_star1[index] then
        return
    end
    local indexes = self:GetAllUnlockIndex()
    if #indexes == 0 then
        return
    end
    local power = _G.StorageManager:GetInstance():GetPlayerPower()
    CardInheritModel:GetInstance():UnlockMultiInherit(
        self.curCfg.id,
        indexes,
        function()
            self.go_table.scrollloophorizontal_buff:UpdateAllItem()

            -- 战斗力tips
            local offset = _G.StorageManager:GetInstance():GetPlayerPower() - power
            if offset > 0 then
                require "CommonTipManager".OpenPowerUpView(power, offset)
            end
            -- 切换页签
            -- 检查当前配置是否还有可激活未领取的
            local hasActivatableBuff = false
            for i = 1, #self.curBuffLis do
                if self.inheritStar[self.curCfg.id] >= self.curCfg.condition_star1[i] and
                    not CardInheritModel:GetInstance():GetBuffIsUnlock(self.curCfg.id, i) then
                    hasActivatableBuff = true
                    break
                end
            end
            -- 如果当前配置已没有可激活未领取则寻找下一个
            if not hasActivatableBuff then
                for i, cfg in ipairs(self.inheritLis) do
                    for j = 1, #cfg.att1 do
                        if self.inheritStar[cfg.id] >= cfg.condition_star1[j] and
                            not CardInheritModel:GetInstance():GetBuffIsUnlock(cfg.id, j) then
                            -- 找到新的可激活未领取切换页面
                            self.curIndex = i
                            self.curCfg = cfg
                            self.curBuffIndex = j
                            self:InitView()
                            return
                        end
                    end
                end
            end
        end
    )
end

function CardInheritPanel:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_attr then
        require("CommonTipManager"):GetInstance():OpenView(
            _G.TipType.Inherit,
            self.curCfg,
            self.inheritStar[self.curCfg.id]
        )
    end
end

function CardInheritPanel:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, _G.handler(self, self.SixUpdate), self)
end

return CardInheritPanel
