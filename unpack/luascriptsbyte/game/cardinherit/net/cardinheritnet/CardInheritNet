local base = require("BaseGameNet")

---@class CardInheritNet : BaseGameNet	通信协议
local CardInheritNet = _G.BaseClass("CardInheritNet", base)

---@return CardInheritNet CardInheritNet
function CardInheritNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求
function CardInheritNet:GetInfo(callback)
    local item = _G.ConfigManager.net_map.game_card_inherit_port_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---解锁传承
function CardInheritNet:Unlock(pbData, callback)
    local item = _G.ConfigManager.net_map.game_card_inherit_port_unlock
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

function CardInheritNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end


---@type CardInheritNet
return CardInheritNet
