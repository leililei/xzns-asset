end

---按钮点击事件在这里派发
function GiftPackGroupEquipView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeView then
        self:CloseView()
    elseif go == self.go_table.aorbtn_get then
        if self.buyTimes <= self.getIndex or self.getIndex == #self.giveGift.award or self.buyTimes == 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(690104)
            return
        end
        self:GetAward()
    elseif go == self.go_table.aorbtn_GetAward then
        if self.buyTimes <= self.getIndex or self.getIndex == #self.giveGift.award or self.buyTimes == 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(690104)
            return
        end
        self:GetAward()
    end
end

---领取奖励
function GiftPackGroupEquipView:GetAward()
    self.typeClass:GetAward(_G.handler(self, self.UpdateGiveGift))
end

---刷新奖励
function GiftPackGroupEquipView:UpdateGiveGift()
    self.buyTimes = self.typeClass.buyTimes
    self.getIndex = self.typeClass.giveGiftIndex
    self.buyInfo = self.typeClass.buyInfo
    for k, v in pairs(self.giveGiftItem) do
        v.go_table.obj_uieffect:RemoveAllChildren()
        if self.getIndex >= k then
            v:SetGou(true)
        elseif self.buyTimes >= k then
            _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
                    v.go_table.obj_uieffect
            )
        end
    end
    self:CheckCantake()
end

---关闭界面
function GiftPackGroupEquipView:CloseView()
    self:StopTimer()
    self:Close()
end

---购买礼包
function GiftPackGroupEquipView:BuyGift(go, ison, data)
    if data.count <= self.buyInfo[data.sid] then
        return
    end
    self.typeClass:BuyGift(data, _G.handler(self, self.UpdateView))
end

---刷新界面
function GiftPackGroupEquipView:UpdateView()
    self:SortGiftList()
    self:UpdateGiveGift()
    self.go_table.scrollloopvectical_GiftList:UpdateAllItem()
end

