---检测礼包是否可以领取
function GiftPackGroupEquipView:CheckCantake()
    if self.typeClass:CheckGiveAward() == 1 then
        self.go_table.aorbtn_get:SetGray(false)
        self.go_table.aortext_get.color = require("CardInfoManager").GetColorFromRGB("815633")
        --self.go_table.obj_btnEffect:SetActiveE(1)
        self.go_table.aorbtn_GetAward:SetActiveE(1)
    else
        self.go_table.aorbtn_get:SetGray(true)
        self.go_table.aortext_get.color = require("CardInfoManager").GetColorFromRGB("414141")
        --self.go_table.obj_btnEffect:SetActiveE(0)
        self.go_table.aorbtn_GetAward:SetActiveE(0)
    end
end

---开始计时器
function GiftPackGroupEquipView:StartTime()
    self.endTime = self.curActivityClass:GetActivityDeadLineByCondition(require "ActivitySynManager":GetInstance().State.Close)
    self.residueTime = self.endTime - TimeUtil.GetServerUnixTime()
    self.go_table.aortext_time.text = GetLangPackValue(90023800077, TimeUtil.GiftPackGroupTime(Mathf.RoundToInt(self.residueTime)))
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.TimeCutDown, self, false, false, false)
    self.timer:Start()
end

---计时器
function GiftPackGroupEquipView:TimeCutDown(elapsed)
    local residuesTime = elapsed or 1
    self.residueTime = self.residueTime - residuesTime
    if self.residueTime <= 0 then
        self:CloseView()
        -- self.typeClass:CloseActivity()
    end
    self.go_table.aortext_time.text = GetLangPackValue(90000011044, TimeUtil.GiftPackGroupTime(_G.Mathf.RoundToInt(self.residueTime)))
end

---停止计时器
function GiftPackGroupEquipView:StopTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return GiftPackGroupEquipView
