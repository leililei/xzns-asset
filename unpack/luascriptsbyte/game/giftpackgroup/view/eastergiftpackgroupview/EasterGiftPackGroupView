---@class EasterGiftPackGroupView : UIBaseView    中文描述
---@field public go_table EasterGiftPackGroupView_GoTable GoTable
local EasterGiftPackGroupView = _G.BaseClass("EasterGiftPackGroupView", _G.UIBaseView)
local InstantiateObject = _G.InstantiateObject
---@type StorageManager
local StorageManager
local GetAutoGoTable = _G.GetAutoGoTable
local GetLangPackValue = _G.GetLangPackValue
local RatioControl = _G.GameUtil.RatioControl
local AddViewBtnClick = _G.AddViewBtnClick
local TimeUtil = _G.TimeUtil
local UIUtils = _G.UIUtils
function EasterGiftPackGroupView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param activity ActivitySynGMActivity
function EasterGiftPackGroupView:OnCreate(activity)
    StorageManager = _G.StorageManager:GetInstance()
    ---@type GiftPackGroupModel
    self.curActivityClass = activity
    ---@type GiftPackGroupModel
    self.typeClass = activity.typeClass
    if self.typeClass == nil then
        self:Close()
    end
    self.giftList = self.typeClass.buyGiftList or {}
    self.giveGift = self.typeClass.giveGift or {}
    self.getIndex = self.typeClass.giveGiftIndex
    self.buyTimes = self.typeClass.buyTimes
    self.buyInfo = self.typeClass.buyInfo
    self:RefreshData()
    self:SortGiftList()
    self:InitGiveGift()
    self:InitGiftPack()
    self:RefreshUI()
    --UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_EasterGiftPackGroupView_title, self.go_table.rawimage_tittle.gameObject)
    --UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_EasterGiftPackGroupView_btn, self.go_table.obj_btnEffect)
    -- if #activity.cfg.info.title > 0 then
    --     self.go_table.rawimage_tittle:LoadImage(
    --         self.typeClass:GetTitlePath(activity.cfg.info.title),
    --         function(image)
    --             image:SetNativeSize()
    --         end
    --     )
    -- end

    local gsi = activity.cfg.info.front.gift_group_show
    if gsi and gsi.images then
        self.go_table.aorrawimage_baoxiang:LoadImage(gsi.images[1].path,
            function(image)
                image:SetNativeSize()
            end)
    end
end

function EasterGiftPackGroupView:RefreshData()
    self.totalNumberPurc = 0
    for i = 1, #self.giftList do
        local data = self.giftList[i]
        local buyTimes = self.buyInfo[data.sid]
        self.totalNumberPurc = self.totalNumberPurc + buyTimes
    end
end

function EasterGiftPackGroupView:RefreshUI()
    if _G.AppSetting.IsXzns then
        self.go_table.aortext_tip.text = GetLangPackValue(90034815002)
    else
        self.go_table.aortext_tip.text = GetLangPackValue(90034815002,self.totalNumberPurc)
    end
    for i = 1, #self.giveGiftItem do
        if self.totalNumberPurc >= i and i > self.getIndex then
            self.giveGiftItem[i].tb.obj_redPoint:SetActiveE(1)
        else
            self.giveGiftItem[i].tb.obj_redPoint:SetActiveE(0)
        end
    end
end

---初始化礼包列表
function EasterGiftPackGroupView:InitGiftPack()
    self.go_table.scrollloopvectical_GiftList:InitItemData(#self.giftList, _G.handler(self, self.RefreshGift))
end

---初始化赠送奖励
function EasterGiftPackGroupView:InitGiveGift()
    self.giveGiftItem = {}
    if not self.giveGift.award then
        self:StartTime()
        return
    end
    local topNum, downNum
    if _G.AppSetting.IsXzns then
        topNum = 4
        downNum = 3
    else
        topNum = 3
        downNum = 4
    end
    for i = 1, topNum do
        local item = InstantiateObject(self.go_table.obj_item, self.go_table.obj_content)
        item:SetActiveE(1)
        local tb = _G.GetAutoGoTable(item)
        local data = self.giveGift.award[i]
        if _G.AppSetting.IsXzns then
            tb.aortext_No.text = i
        else
            tb.aortext_No.text = _G.GetLangPackValue(90027000004, i)
        end
        if self.totalNumberPurc >= i and i > self.getIndex then
            tb.obj_redPoint:SetActiveE(1)
        else
            tb.obj_redPoint:SetActiveE(0)
        end
        StorageManager:GetItemBaseViewNew(
            data.type,
            tb.obj_icon,
            function(trans)
                if not _G.AppSetting.IsXzns then
                    trans.gameObject:SetLocalScaleXYZ(0.7)
                end
                trans:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                local isShowOrdereff = true
                if i <= self.getIndex then
                    trans:SetGou(true)
                    isShowOrdereff = false
                elseif i <= self.buyTimes then
                    _G.UIUtils.LoadEffectByCfg(
                        _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
                        trans.go_table.obj_uieffect
                    )
                end
                trans:ShowEffectOrder(isShowOrdereff)

                ---无论是否可领，无论领没领，都显示特效，张一说的
                --_G.UIUtils.LoadEffectByCfg(
                --    _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
                --    trans.go_table.obj_uieffect
                --)
                self.giveGiftItem[i] = trans
                self.giveGiftItem[i].tb = tb
            end
        )
    end

    for i = 1, downNum do
        local item = InstantiateObject(self.go_table.obj_item, self.go_table.obj_content2)
        item:SetActiveE(1)
        local tb = _G.GetAutoGoTable(item)
        local curIndex = i + topNum
        local data = self.giveGift.award[curIndex]
        if _G.AppSetting.IsXzns then
            tb.aortext_No.text = curIndex
        else
            tb.aortext_No.text = _G.GetLangPackValue(90027000004, curIndex)
        end
        if self.totalNumberPurc >= curIndex and curIndex > self.getIndex then
            tb.obj_redPoint:SetActiveE(1)
        else
            tb.obj_redPoint:SetActiveE(0)
        end
        StorageManager:GetItemBaseViewNew(
            data.type,
            tb.obj_icon,
            function(trans)
                if not _G.AppSetting.IsXzns then
                    trans.gameObject:SetLocalScaleXYZ(0.7)
                end
                trans:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                local isShowOrdereff = true
                if curIndex <= self.getIndex then
                    trans:SetGou(true)
                    isShowOrdereff = false
                elseif curIndex <= self.buyTimes then
                    _G.UIUtils.LoadEffectByCfg(
                        _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
                        trans.go_table.obj_uieffect
                    )
                end
                trans:ShowEffectOrder(isShowOrdereff)

                ---无论是否可领，无论领没领，都显示特效，张一说的
                --_G.UIUtils.LoadEffectByCfg(
                --    _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
                --    trans.go_table.obj_uieffect
                --)
                self.giveGiftItem[curIndex] = trans
                self.giveGiftItem[curIndex].tb = tb
            end
        )
    end
    self:CheckCantake()
    self:StartTime()
end

---刷新礼包
function EasterGiftPackGroupView:RefreshGift(index, obj)
    if index < 0 then
        return
    end
    local newIndex = index + 1
    local tb = GetAutoGoTable(obj)
    local data = self.giftList[newIndex]
    AddViewBtnClick(obj, _G.handlerbind(self, self.BuyGift, data))
    tb.aortext_name.text = data.name

    tb.aortext_price.text = _G.GameUtil.GetPriceContentByNum(data.price)

    local buyTimes = self.buyInfo[data.sid]
    local soldOut = data.count == buyTimes
    tb.aorimage_soldout:SetActiveE(soldOut and 1 or 0)
    tb.aorbtn_buy:SetActiveE(soldOut and 0 or 1)
    _G.GameUtil.AddDouYinIcon(tb.aorbtn_buy, true, nil, nil, nil, data.price)

    tb.aortext_limit.text = GetLangPackValue(90023800079, data.count - buyTimes, data.count)
    tb.aortext_discount.text = GetLangPackValue(90000010507) .. RatioControl(data.discount) .. "%"
    tb.obj_content:RemoveAllChildren()
    for i = 1, #data.award do
        StorageManager:GetItemBaseViewNew(
            data.award[i].type,
            tb.obj_content,
            function(trans)
                if not trans then
                    return
                end
                trans:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                trans:SetGou(soldOut)
                trans:ShowEffectOrder(not soldOut)
            end)
    end
end

---界面的销毁函数
function EasterGiftPackGroupView:OnDestroy()
end

---按钮点击事件在这里派发
function EasterGiftPackGroupView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeViewo or go == self.go_table.aorbtn_close then
        self:CloseView()
    elseif go == self.go_table.aorbtn_get then
        if self.buyTimes <= self.getIndex or (self.giveGift.award and self.getIndex == #self.giveGift.award) or self.buyTimes == 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(690104)
            return
        end
        self:GetAward()
    elseif go == self.go_table.aorbtn_GetAward then
        if self.buyTimes <= self.getIndex or (self.giveGift.award and self.getIndex == #self.giveGift.award) or self.buyTimes == 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(690104)
            return
        end
        self:GetAward()
    end
end

---领取奖励
function EasterGiftPackGroupView:GetAward()
    self.typeClass:GetAward(_G.handler(self, self.UpdateGiveGift))
end

---刷新奖励
function EasterGiftPackGroupView:UpdateGiveGift()
    self.buyTimes = self.typeClass.buyTimes
    self.getIndex = self.typeClass.giveGiftIndex
    self.buyInfo = self.typeClass.buyInfo
    for k, v in pairs(self.giveGiftItem) do
        --ZHJH5ZHJH-8827 【Beta1.0.0_CN】BuglistZHJH-10202
        --【神器盛典】下方赠礼高亮特效显示条件错误
        v.go_table.obj_uieffect:RemoveAllChildren()
        local isShowOrdereff = true
        if self.getIndex >= k then
            v:SetGou(true)
            v.tb.obj_redPoint:SetActiveE(0)
            isShowOrdereff = false
        elseif self.buyTimes >= k then
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
                v.go_table.obj_uieffect
            )
        end
        v:ShowEffectOrder(isShowOrdereff)
    end
    self:CheckCantake()
end

---关闭界面
function EasterGiftPackGroupView:CloseView()
    self:StopTimer()
    self:Close()
end

---购买礼包
function EasterGiftPackGroupView:BuyGift(go, ison, data)
    if data.count <= self.buyInfo[data.sid] then
        return
    end
    self.typeClass:BuyGift(data, _G.handler(self, self.UpdateView))
end

---刷新界面
function EasterGiftPackGroupView:UpdateView()
    self:SortGiftList()
    self:UpdateGiveGift()
    self:RefreshData()
    self:RefreshUI()
    self.go_table.scrollloopvectical_GiftList:UpdateAllItem()
end

---对礼包进行排序
function EasterGiftPackGroupView:SortGiftList()
    _G.SortList(
        self.giftList,
        function(a)
            local buy = 1
            if self.buyInfo[a.sid] == a.count then
                buy = 0
            end
            return buy, -a.sid
        end)
end

---检测礼包是否可以领取
function EasterGiftPackGroupView:CheckCantake()
    if self.typeClass:CheckGiveAward() == 1 then
        self.go_table.aorbtn_get:SetGray(false)
        self.go_table.aorbtn_get:GetComponentE(_G.typeof(_G.CS.AorImage)).color = require("CardInfoManager")
        .GetColorFromRGB("FFFFFF")
        self.go_table.aortext_get.color = require("CardInfoManager").GetColorFromRGB("8C2D14")
        self.go_table.obj_btnEffect:SetActiveE(1)
        self.go_table.aorbtn_GetAward:SetActiveE(1)
    else
        self.go_table.aorbtn_get:SetGray(true)
        self.go_table.aorbtn_get:GetComponentE(_G.typeof(_G.CS.AorImage)).color = require("CardInfoManager")
        .GetColorFromRGB("A9A9A9")
        self.go_table.aortext_get.color = require("CardInfoManager").GetColorFromRGB("434343")
        self.go_table.obj_btnEffect:SetActiveE(0)
        self.go_table.aorbtn_GetAward:SetActiveE(0)
    end
end

---开始计时器
function EasterGiftPackGroupView:StartTime()
    self.endTime = self.curActivityClass:GetActivityDeadLineByCondition(require "ActivitySynManager":GetInstance().State
        .Close)
    self.residueTime = self.endTime - TimeUtil.GetServerUnixTime()
    if _G.AppSetting.IsXzns then
        self.go_table.aortext_time.text = TimeUtil.GiftPackGroupTime(Mathf.RoundToInt(self.residueTime))
    else
        self.go_table.aortext_time.text = GetLangPackValue(90023800077,
            TimeUtil.GiftPackGroupTime(Mathf.RoundToInt(self.residueTime)))
    end
    self.timer = _G.TimerManager:GetInstance():GetTimer(1,
        self.TimeCutDown,
        self,
        false,
        false,
        false)
    self.timer:Start()
end

---计时器
function EasterGiftPackGroupView:TimeCutDown(elapsed)
    local residuesTime = elapsed or 1
    self.residueTime = self.residueTime - residuesTime
    if self.residueTime <= 0 then
        self:CloseView()
        -- self.typeClass:CloseActivity()
        return
    end
    if _G.AppSetting.IsXzns then
        self.go_table.aortext_time.text = TimeUtil.GiftPackGroupTime(Mathf.RoundToInt(self.residueTime))
    else
        self.go_table.aortext_time.text = GetLangPackValue(90023800077,
            TimeUtil.GiftPackGroupTime(Mathf.RoundToInt(self.residueTime)))
    end
end

---停止计时器
function EasterGiftPackGroupView:StopTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return EasterGiftPackGroupView
