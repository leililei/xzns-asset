---解析数据
---@param data table 服务器返回数据
function GiftPackGroupModel:ParseData(data)
    local info = data.gift_group
    self.buyGiftList = info.item
    self.buyInfo = {}
    self.giveGift = {}
    local timesInfo = info.times or {}
    for k, v in pairs(self.buyGiftList) do
        if v.price == 0 then
            self.giveGift = v
            table.remove(self.buyGiftList, k)
            break
        end
    end
    for k, v in pairs(self.buyGiftList) do
        self.buyInfo[v.sid] = 0
        if _G.tonumber(v.name) then
            v.name = _G.LangUtil.GetLangPackValue(_G.tonumber(v.name))
        end
        -- ZHJH-11051 GM活动的多语言调整需求
        local cfg = _G.ConfigManager.store_gear_cfg[v.price]
        v.price = cfg and cfg.price or v.price
    end
    self.buyTimes = 0
    for k, v in pairs(timesInfo) do
        self.buyInfo[v.k] = v.v
        self.buyTimes = self.buyTimes + v.v
    end
    self.giveGiftIndex = info.index and #info.index or 0
    if self.sendBuy then
        local data = {}
        data.award = {}
        data.award.item = self.buyData.award
        -- _G.StorageManager:GetInstance():ReceiveAwardData(award)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
        if self.mallCall then
            self.mallCall()
            self.mallCall = nil
        end
        self.sendBuy = false
        _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    end
    if not self.isOpened then
        self:InitIsOpen()
        self.isOpened = true
    end
    self:BuyAllToClose()
    base.ParseData(self)
end

function GiftPackGroupModel:InitIsOpen()
    local MainOpenViewFunItem = {}
    self.isFirst = true
    MainOpenViewFunItem.OpenViewFun = function()
        if not self.curActivityClass:GetFunctionOpen() then
            return
        end
        if self:GetViewType() == 2 then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GiftPackGroupEquipView.Name,
                self.curActivityClass)
        elseif self:GetViewType() == 3 then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MTGiftPackGroupView.Name,
                self.curActivityClass)
        elseif self:GetViewType() == 4 then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.HolyFireGiftPackGroupView.Name,
                self.curActivityClass)
        elseif self:GetViewType() == 5 then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpringFestivalGiftPackGroupView.Name,
                self.curActivityClass)
        elseif self:GetViewType() == 6 then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.EasterGiftPackGroupView.Name,
                self.curActivityClass)
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GiftPackGroupView.Name, self.curActivityClass)
        end
        self.isFirst = false
        require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
    end
    _G.MainManager:GetInstance():AddMainFunQueue(MainOpenViewFunItem, _G.MainViewShowOrder.GiftPackGroup)
end

