---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function GiftPackGroupModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---购买礼包
function GiftPackGroupModel:BuyGift(data, callBack)
    self.sendBuy = true
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    self.mallCall = callBack
    self.buyData = data
    require "MallManager":GetInstance():BuyActiveGift(data.price, self.curActivityClass:GetActivityID(), data.sid)
end

---充值监听
function GiftPackGroupModel:OnMallCashListener(data)
    if data.activity_id == self.curActivityClass:GetActivityID() then
        if not self.buyInfo[data.sid] then
            self.buyInfo[data.sid] = 0
        end
        self.buyInfo[data.sid] = self.buyInfo[data.sid] + 1
        self.buyTimes = self.buyTimes + 1
        if self.mallCall then
            self.mallCall()
            self.mallCall = nil
        end
        _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    end
    self.sendBuy = false
    self:BuyAllToClose()
    self:UpdateRedpoint(2)
end

function GiftPackGroupModel:CheckRedPoint()
    return self.isFirst and 1 or 0
end

---检测是否可以领奖
function GiftPackGroupModel:CheckGiveAward()
    if not self.giveGift.award or #self.giveGift.award == self.giveGiftIndex then
        return 0
    elseif self.buyTimes == 0 then
        return 0
    end
    return self.buyTimes > self.giveGiftIndex and 1 or 0
end

---设置主界面计时器
function GiftPackGroupModel:SetTimerTb(tb)
    self.MainTimerTb = tb
    self.endTime = self.curActivityClass:GetActivityDeadLineByCondition(require "ActivitySynManager":GetInstance().State
        .Close)
    self.residueTime = self.endTime - TimeUtil.GetServerUnixTime()
    self.MainTimerTb.aortext_time:SetActiveE(1)
    self.MainTimerTb.aortext_time.text = TimeUtil.TimeToString(self.residueTime, 1)
    self:StopMainTimer()
    self.MainTimer =
        _G.TimerManager:GetInstance():GetTimer(
            1,
            self.TimeCutDown,
            self,
            false,
            false,
            false
        )
    self.MainTimer:Start()
end

---计时器
function GiftPackGroupModel:TimeCutDown(elapsed)
    self.residueTime = self.residueTime - elapsed
    if self.residueTime <= 0 then
        self:StopMainTimer()
    end
    self.MainTimerTb.aortext_time.text = TimeUtil.TimeToString(Mathf.RoundToInt(self.residueTime), 1)
end

---停止主界面计时器
function GiftPackGroupModel:StopMainTimer()
    if self.MainTimer then
        self.MainTimer:Stop()
        self.MainTimer = nil
    end
end

---关闭活动
function GiftPackGroupModel:CloseActivity()
    self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
end

---检测购买完毕关闭
function GiftPackGroupModel:BuyAllToClose()
    if self.giveGift and self.giveGift.award then
        for k, v in pairs(self.giveGift.award) do
            if k > self.giveGiftIndex then
                return
            end
        end
    end
    for _, v in pairs(self.buyGiftList) do
        if v.count ~= self.buyInfo[v.sid] then
            return
        end
    end
    self:CloseActivity()
end

---拿到标题地址
---@param title string 标题title
function GiftPackGroupModel:GetTitlePath(title)
    return "ImagesH5/hGiftPackGroup/" .. title
end

function GiftPackGroupModel:GetViewType()
    local show = self.curActivityClass.cfg.info.front.gift_group_show
    return show and show.type or 1
end

return GiftPackGroupModel
