---领奖
function GiftPackGroupModel:GetAward(callback)
    self.call = callback
    local params = { 1, self.giveGift.sid }
    for k, v in pairs(self.giveGift.award) do
        if k > self.giveGiftIndex and k <= self.buyTimes then
            table.insert(params, k)
        end
    end
    self.itemData = params
    require "ActivitySynNet":GetInstance():GetAward(self.curActivityClass:GetActivityID(), params,
        function(msg)
            self:UpdateData(msg)
            self:BuyAllToClose()
        end)
end

---领奖回调
function GiftPackGroupModel:UpdateData(msg)
    if msg.ack ~= 1 then
        return
    end
    self.giveGiftIndex = self.giveGiftIndex + #self.itemData - 2
    self.itemData = nil
    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg,
        function()
            require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(2))
            if self.call then
                self.call()
                self.call = nil
            end
        end)
end

function GiftPackGroupModel:InitRedPointTree()
    self.checkRedPointFunc = { self.CheckRedPoint, self.CheckGiveAward }
    self.redpointTree = { { 2 }, false }
end

