function ArtifactDrawUpMainModel:GetRankType(ActivityID)
    local data = self.activityList[ActivityID]
    if data == nil then
        return 0
    end
    return data:GetRankType()
end

---是否是sp卡神器活动
function ArtifactDrawUpMainModel:IsSP(ActivityID)
    local data = self.activityList[ActivityID]
    if data == nil then
        return false
    end
    return data.activity:GetJumpType() == 100091
end

