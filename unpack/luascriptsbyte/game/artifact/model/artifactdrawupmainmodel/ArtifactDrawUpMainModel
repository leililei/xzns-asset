---自身活动代币增加（如锻造豪礼）
function ArtifactDrawUpMainModel:SetMallCoin(ActivityID, giftId)
    if self.activityList == nil or self.activityList[ActivityID] == nil then
        return 0
    end
    local data = self.activityList[ActivityID]
    if data then
        return data:SetMallCoin(giftId)
    end
end

---自身探寻礼包购买次数增加
function ArtifactDrawUpMainModel:AddPackGiftBuyTimes(ActivityID, giftId)
    if self.activityList == nil or self.activityList[ActivityID] == nil then
        return 0
    end
    local data = self.activityList[ActivityID]
    if data then
        return data:AddPackGiftBuyTimes(giftId)
    end
end

return ArtifactDrawUpMainModel
