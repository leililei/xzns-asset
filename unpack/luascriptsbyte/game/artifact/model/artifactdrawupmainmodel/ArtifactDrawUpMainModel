---抽卡
---@param ActivityID number 活动ID
---@param consumeType number _1活动代币 2魂玉
function ArtifactDrawUpMainModel:DrawCard(ActivityID, consumeType, num, type, call, IsEff)
    local data = self.activityList[ActivityID]

    if self:GetTime(ActivityID) <= 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(870102)
        return
    end
    if self:GetdaY_times(ActivityID) + num > data.limited_roller_cfg.limit_daily then
        _G.PopWindowManager:GetInstance():ShowAllTips(130102)
        return
    end

    require("ArtifactDrawUpMainModel"):GetInstance().JianGe = true

    local msg = {}
    msg.activity_id = ActivityID
    msg.consume_type = consumeType
    msg.draw_times = num
    require "ArtifactNet":GetInstance():Port_draw(
        msg,
        _G.handlerbind(self, self.DrawCardSuc, consumeType, num, type, call, IsEff, ActivityID)
    )
end

---抽卡返回
---@param consumeType number _1活动代币 2魂玉
function ArtifactDrawUpMainModel:DrawCardSuc(data, consumeType, num, type, call, IsEff, ActivityID)
    require("ArtifactDrawUpMainModel"):GetInstance().JianGe = false
    if data.ack ~= 1 then
        return
    end
    local datas = self.activityList[ActivityID]

    local Elements = 0
    local crad = 1
    local GetTimes = self:GetTimes(ActivityID)
    if GetTimes + num ~= data.times then
        crad = 2
    -- body
    end

    if consumeType == _G.DrawConsumeType.token then
        --消耗招募券
        self:AddCoin(ActivityID, -num)
    elseif consumeType == _G.DrawConsumeType.diamond then
        --消耗魂玉
        local consumeNum = self:GetDiamondConsume(ActivityID, num)
        if type == _G.DrawType.TenTimes then
            local limited_roller_cfg = require "ArtifactDrawUpMainModel":GetInstance():Getlimited_roller_cfg(ActivityID)
            local discount = limited_roller_cfg.ticket_discount[1]
            if nil ~= discount then
                consumeNum = _G.Mathf.Floor(consumeNum * discount / 10000)
            end
        end
        self:AddDiamondTimes(ActivityID, num)
        _G.StorageManager:GetInstance():ConsumeItem(_G.ResPropID.Diamond, 0, consumeNum)
    end
    self:AddTotalTimes(ActivityID, num)
    self:AdddaY_times(ActivityID, num)

    datas.activity.typeClass:RefreshRedPoint()
    datas.activity.typeClass:RefreshRedPoint(2)

    self:SetTimes(ActivityID, data.times)
    IsEff(
        crad,
        function()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data, nil, true)
        end,
        Elements
    )
    _G.StorageManager:GetInstance():ReceiveAwardData(data)
    if data.award.overflow then 
        _G.PopWindowManager:GetInstance():ShowAllTips(380104)
    end
    --  _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data, nil, true)
    --require("ArtifactDrawUpMainModel"):GetInstance().JianGe = false

    if call ~= nil then
        call(num)
    end
end

