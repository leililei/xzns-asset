function ArtifactDrawUpMainModel:HongDianPackGift(ActivityID)
    if ActivityID == nil or self.activityList == nil or self.activityList[ActivityID] == nil then
        return 0
    end
    if _G.AppSetting.IsXzns and _G.TimeUtil.GetDayBegin(_G.TimeUtil.GetServerUnixTime()) ~=
            _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.ArtifactDrawUpPackGiftLogin, 0)
    then
        return 1
    end
    local data = self.activityList[ActivityID]
    local rewards_count = data.limited_roller_cfg.rewards_count

    for key, value in pairs(rewards_count) do
        local total_times = self:GetTotalTimes(ActivityID)
        if not self:GetLingQu(ActivityID, key) and value <= total_times then
            return 1
        end
    end
    return 0
end

-- 获取当前任务完成进度
function ArtifactDrawUpMainModel:BaileyZhi(ActivityID)
    local data = self.activityList[ActivityID]

    local rewards_count = data.limited_roller_cfg.rewards_count
    local total_times = self:GetTotalTimes(ActivityID)

    local num, k = total_times, 0
    for key, value in pairs(rewards_count) do
        if value > total_times then
            num = value
            k = key
            break
        end
    end
    local nuts

    if k >= 2 and k <= _G.table.count(rewards_count) then
        nuts = (total_times - rewards_count[k - 1]) / (num - rewards_count[k - 1])
    else
        nuts = total_times / num
    end
    return nuts, k
end

-- 领取招募奖励
function ArtifactDrawUpMainModel:GetAwarddata(ActivityID, num, call)
    local data = self.activityList[ActivityID]

    if self:GetTime(ActivityID) <= 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(870102)

        return
    end
    local mag = {activity_id = ActivityID, index = {num}}
    require "ArtifactNet":GetInstance():Port_draw_award(
        mag,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            local cfg = self:Getlimited_roller_cfg(ActivityID)
            if #cfg.rewards_item[num] == 1 then
                local coinData = {
                    type = {
                        [1] = self:GetCoinId(ActivityID),
                        [2] = cfg.rewards_item[num][1]
                    }
                }
                if not msg.award then
                    msg.award = {}
                end
                if not msg.award.item then
                    msg.award.item = {}
                end
                _G.table.insert(msg.award.item, coinData)
                self:AddCoin(ActivityID, coinData.type[2])
            end
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            self:InAward(ActivityID, num)
            data.activity.typeClass:RefreshRedPoint(2)
            if call ~= nil then
                call()
            end
        end
    )
end

