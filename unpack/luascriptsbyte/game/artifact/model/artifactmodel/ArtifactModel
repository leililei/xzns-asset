function ArtifactModel:OnUpData(data)
    local sid
    local gainArtifact = false
    for _, value in pairs(data) do
        sid = value.type[1]
        if _G.table.ContainsValue(LvUpMaterial, sid) then
            RedPointManager:GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RoleArtifactUpgrade.id)
            RedPointManager:GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.ArtifactUpgrade.id)
            break
        elseif _G.StorageManager:GetInstance():CheckSidType(sid) == _G.StorageType.Artifact then
            RedPointManager:GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RoleArtifact.id)
            RedPointManager:GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RoleArtifactUpgrade.id)
            gainArtifact = true
            break
        end
    end
    if gainArtifact then
        _G.Events:GetInstance():Broadcast(_G.ArtifactShow.GainArtifact)
    end
end

