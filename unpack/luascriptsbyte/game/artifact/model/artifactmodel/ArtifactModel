---是否可穿戴神器
---@param uid number 卡牌uid
function ArtifactModel:CheckCardNeedArtifact(uid)
    local StorageManager = _G.StorageManager:GetInstance()
    ---@type CardData
    local card = StorageManager:GetDatasByUid(_G.StorageID.Card, uid)
    if _G.table.isEmptyOrNil(card) then
        return false
    elseif card.star < _G.ConfigManager.discrete_cfg[101204][1][1] then
        return false
    else
        ---@type ArtifactData[]
        local artifacts = StorageManager:GetDataByID(_G.StorageID.Artifact, _G.ArtifactType.NoWear, true)
        if _G.table.isEmptyOrNil(card.ArtifactBar) and not _G.table.isEmptyOrNil(artifacts) then
            return true
        end
    end
    return false
end

---是否有更好的可穿戴神器
---@param uid number 卡牌uid
function ArtifactModel:CheckCardCanPutOnArtifact(uid)
    local bwearArtifact = self:GetCardCanPutOnArtifact(uid, false, true)
    if bwearArtifact then
        return true
    end
    return false
end

---获取卡牌可穿戴的更优神器
---@param uid number 卡牌uid
---@param bestArtifact boolean 当卡牌未穿戴神器时, 是否获取最优神器实例
---@param ignoreCompare boolean 是否忽略可替换
---@return ArtifactData
function ArtifactModel:GetCardCanPutOnArtifact(uid, bestArtifact, ignoreCompare)
    local storageManager = _G.StorageManager:GetInstance()
    ---@type CardData
    local card = storageManager:GetDatasByUid(_G.StorageID.Card, uid)
    if _G.table.isEmptyOrNil(card) then
        return nil
    end

    ---星级要求
    local cfg = _G.ConfigManager.discrete_cfg[101204]
    if not cfg or card.star < cfg[1][1] then
        return nil
    end

    ---获取神器实例
    ---@type ArtifactData[]
    local artifacts = storageManager:GetDataByID(_G.StorageID.Artifact, _G.ArtifactType.NoWear, true)
    if not artifacts or #artifacts == 0 then
        return nil
    end
    ---@type ArtifactData
    local artifact = card.ArtifactBar
    if _G.table.isEmptyOrNil(artifact) then
        artifact = nil
        if not bestArtifact then
            return artifacts[1]
        end
    elseif ignoreCompare then
        return nil
    end

    --已穿戴专属神器则不进行替换
    if artifact and artifact.cfg.card_id == card.sid then
        return nil
    end

    --比较神器: 专属>品质>星级>等级
    for _, v in pairs(artifacts) do
        if v.cfg.card_id == card.sid then
            artifact = v
            break
        end
        if not artifact then
            artifact = v
        else
            local compare = compareNumber(v:GetOrder(), artifact:GetOrder())
            if compare == 0 then
                compare = compareNumber(v:GetStar(), artifact:GetStar())
            end
            if compare == 0 then
                compare = compareNumber(v:GetLevel(), artifact:GetLevel())
            end
            if compare > 0 then
                if not bestArtifact then
                    return v
                end
                artifact = v
            end
        end
    end
    if artifact and artifact ~= card.ArtifactBar then
        return artifact
    end
    return nil
end

---卡牌所穿戴的神器是否可以升级
---@param uid number 卡牌uid
function ArtifactModel:CheckCardArtifactCanUpgrade(uid)
    local StorageManager = _G.StorageManager:GetInstance()
    ---@type CardData
    local card = StorageManager:GetDatasByUid(_G.StorageID.Card, uid)
    if _G.table.isEmptyOrNil(card) then
        return false
    else
        local artifactData = card.ArtifactBar
        if _G.table.isEmptyOrNil(artifactData) then
            return false
        end
        local cLv, cStar, cAwaken = artifactData:CanDevelop()
        ---ZHJH-7235 取消升级
        if cStar or cAwaken then
            return true
        end
    end
    return false
end

--- 检查神器能否向战力高的替换
function ArtifactModel:CheckCardArtifactCanReplace(uid)
    local card = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, uid)
    if _G.table.isEmptyOrNil(card) then
        return false
    end
    local artifactData = card.ArtifactBar
    if _G.table.isEmptyOrNil(artifactData) then --没装备的时候归红点管
        return false
    end
    local order = artifactData:GetOrder()
    if order == 3 then --最高品质彩
        return false
    end
    local artifacts = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Artifact, _G.ArtifactType.NoWear, true)
    if _G.table.isEmptyOrNil(artifacts) then
        return false
    end
    for _, v in pairs(artifacts) do
        if v:GetOrder() > order then
            return true
        end
    end
    return false
end

function ArtifactModel.GetStarSkillDes(sid, star)
    ---@type artifact_cfg
    local cfg = _G.ConfigManager.artifact_cfg[sid]
    if star == nil or star == 0 then
        if cfg.skill_3_id[1] and cfg.skill_3_id[1] > 0 then
            return _G.GetLangPackValue(_G.ConfigManager.card_skills_cfg[cfg.skill_3_id[1]].describe1)
        elseif cfg.skill_id[1] > 0 then
            ---@type attribute_cfg
            local attCfg = _G.ConfigManager.attribute_cfg[cfg.skill_id[1]]
            if attCfg.skill > 0 then
                return _G.GetLangPackValue(_G.ConfigManager.card_skills_cfg[attCfg.skill].describe1)
            else
                return _G.AttributeClassManager:GetInstance().GetAttrbuteDes(attCfg.attribute)
            end
        end
    else
        if cfg.skill_3_id[star + 1] and cfg.skill_3_id[star + 1] ~= cfg.skill_3_id[star] then
            return _G.GetLangPackValue(_G.ConfigManager.card_skills_cfg[cfg.skill_3_id[star + 1]].describe1)
        else
            local isSkill, data = _G.AttributeClassManager:GetInstance().CalAddedAttribute(cfg.skill_id[star + 1], cfg.skill_id[star])
            if isSkill then
                return _G.GetLangPackValue(_G.ConfigManager.card_skills_cfg[data].describe1)
            else
                return _G.AttributeClassManager:GetInstance().GetAttrbuteDes(data)
            end
        end
    end
end

