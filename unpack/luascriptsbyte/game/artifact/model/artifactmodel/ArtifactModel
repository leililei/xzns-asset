---神器升级
---@param cardUid number 穿戴的卡牌Uid
---@param artifactUid number 神器uid
---@param level number 提升星级
---@param isUnstack boolean 是否独立（不堆叠）
function ArtifactModel:LevelUp(artifactUid, cardUid, level, isUnstack, callback)
    if not isUnstack and not _G.StorageManager:GetInstance():CheckSize(_G.StorageID.Artifact, 1) then
        _G.PopWindowManager:GetInstance():ShowAllTips(270801)
        return
    end
    local pbData = { card_uid = cardUid, up_level = level, artifact_uid = cardUid == 0 and artifactUid or 0 }
    ArtifactNet:GetInstance():LevelUp(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            ---@type ArtifactData
            local data = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Artifact, artifactUid)
            if isUnstack then
                --TODO
                --if data.cfg.Order == 3 then
                require "PopUpGiftBagModel":GetInstance():CheckArtifactsLevel(data:GetLevel(), data:GetLevel() + level)
                --end

                data:UpLevel(data:GetLevel() + level)
                if data.cardUid ~= 0 then
                    ---@type CardData
                    local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, data.cardUid)
                    if not _G.table.isEmptyOrNil(cardData) then
                        cardData:CalcNowSumProp()
                    end
                end
            else
                local newMsg = data.GetMsg(data)
                newMsg.uid = msg.uid
                local newData = _G.ArtifactData.New()
                newData:Parse(newMsg)
                newData:UpLevel(newData:GetLevel() + level)
                _G.StorageManager:GetInstance():AddItemByArtifactData(newData)
                _G.StorageManager:GetInstance():ConsumeItem(data.sid, data.uid, 1)
            end
            _G.Events:GetInstance():Broadcast(_G.ArtifactShow.ArtifactLevel)
            if callback then
                callback(msg)
            end

            RedPointManager:GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RoleArtifactUpgrade.id)
            RedPointManager:GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.ArtifactUpgrade.id)
        end
    )
end


---获取可用于升星的材料
---@param data ArtifactData 升星神器data
---@param list table[] 已选择饰品
---@param needCount number 需要的材料数量
function ArtifactModel:GetStarUpMaterial(data, list, needCount)
    local ArtifactDic = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Artifact)
    local ArtifactList = {}
    local SelectList = {}
    local isNotWear = data.cardUid == 0
    local isUnstack = data.uid ~= data.sid
    local excludeSelf = false
    for _, v in pairs(ArtifactDic) do
        if v.cfg.id == data.cfg.id then
            if v.star == 0 then
                if (v.cardUid ~= 0 and v.cardUid == data.cardUid) or
                        (isNotWear and not excludeSelf and isUnstack and data.uid == v.uid) or
                        (isNotWear and not excludeSelf and not isUnstack and v.uid == v.sid)
                then
                    if isNotWear then
                        excludeSelf = true
                        if not isUnstack then
                            for i = 1, v.count - 1 do
                                _G.table.insert(ArtifactList, v)
                            end
                        end
                    end
                else
                    for i = 1, v.count do
                        _G.table.insert(ArtifactList, v)
                    end
                end
            end
        end
    end
    _G.SortList(
            ArtifactList,
            function(a)
                return -a.cardUid, a.star, a.lv
            end
    )
    for k, v in pairs(ArtifactList) do
        if v.cardUid == 0 then
            if #SelectList < needCount then
                _G.table.insert(SelectList, { k, ArtifactList[k].uid, ArtifactList[k] })
            end
        end
    end
    return {
        material = ArtifactList,
        select = SelectList
    }
end

---神器升星
---@param cardUid number 穿戴的卡牌Uid
---@param items artifact.i_cs_artifact[] 消耗的神器列表
---@param isUnstack boolean 是否独立（不堆叠）
function ArtifactModel:StarUp(artifactUid, cardUid, items, isUnstack, callback)
    if not isUnstack and not _G.StorageManager:GetInstance():CheckSize(_G.StorageID.Artifact, 1) then
        _G.PopWindowManager:GetInstance():ShowAllTips(270801)
        return
    end
    local pbData = { card_uid = cardUid, items = items, artifact_uid = cardUid == 0 and artifactUid or 0 }
    ArtifactNet:GetInstance():StarUp(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            ---@type ArtifactData
            local data = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Artifact, artifactUid)
            if isUnstack then
                data:UpStar()
                if data.cardUid ~= 0 then
                    ---@type CardData
                    local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, data.cardUid)
                    if not _G.table.isEmptyOrNil(cardData) then
                        cardData:CalcNowSumProp()
                    end
                end
                require "ArtifactIllustrationModel":GetInstance():ChangeMaxStar(data.sid, data:GetStar())
            else
                local newMsg = data.GetMsg(data)
                newMsg.uid = msg.uid
                local newData = _G.ArtifactData.New()
                newData:Parse(newMsg)
                newData:UpStar()
                _G.StorageManager:GetInstance():AddItemByArtifactData(newData)
                _G.StorageManager:GetInstance():ConsumeItem(data.sid, data.uid, 1)
                require "ArtifactIllustrationModel":GetInstance():ChangeMaxStar(newData.sid, newData:GetStar())
            end
            if msg.award then
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            end
            _G.Events:GetInstance():Broadcast(_G.ArtifactShow.ArtifactStar)
            if callback then
                callback(msg)
            end
            RedPointManager:GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RoleArtifactUpgrade.id)
            RedPointManager:GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.ArtifactUpgrade.id)
        end
    )
end

