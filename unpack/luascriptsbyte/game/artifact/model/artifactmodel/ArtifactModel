---重置神器
function ArtifactModel:ResetArtifact(artifactData, callback)
    local pbData = { artifact_uid = artifactData.uid }
    ArtifactNet:GetInstance():ResetArtifact(
        pbData,
        function (msg)
            if msg.ack ~= 1 then
                return
            end

            local StorageManager = _G.StorageManager:GetInstance()
            local costNum = _G.ConfigManager.discrete_cfg[101208][1][1]
            StorageManager:ConsumeItem(_G.ResPropID.Diamond, 0, costNum)
            artifactData:Reset()
            StorageManager:ReceiveAwardData(msg)

            ---神器>道具>货币 品质>ID
            if msg.award.item then
                _G.SortList(
                    msg.award.item,
                    function(a)
                        local sid = a.type[1]
                        local aStorageType = StorageManager:CheckSidType(sid)
                        local type = 0
                        if aStorageType == _G.StorageType.Artifact then
                            type = 2
                        elseif aStorageType == _G.StorageType.Prop then
                            type = 1
                        end

                        return type, StorageManager:GetItemQuality(sid), sid
                    end
                )
            end
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CommonAwardView.Name,
                {award = msg.award},
                nil,
                true,
                nil,
                nil,
                nil,
                nil,
                true
            )

            if callback then
                callback()
            end
        end
    )
end

