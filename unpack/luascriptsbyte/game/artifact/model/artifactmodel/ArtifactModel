---穿上神器
---@param cardData CardData
---@param artifactData ArtifactData
function ArtifactModel:PutOnArtifact(cardData, artifactData, call)
    if artifactData.type == _G.ArtifactDataType.Normal then
        self:PutOn(
            cardData.uid,
            artifactData.uid,
            function(msg)
                if msg.ack == 1 then
                    local StorageManager = _G.StorageManager:GetInstance()
                    if not _G.table.isEmptyOrNil(cardData.ArtifactBar) then
                        StorageManager:TakeOffArtifact(cardData.ArtifactBar)
                    end
                    if artifactData.uid == artifactData.sid then
                        local newMsg = artifactData.GetMsg(artifactData)
                        newMsg.uid = msg.uid
                        newMsg.cardUid = cardData.uid
                        cardData:SaveArtifactData({ artifact = { newMsg } })
                        StorageManager:PutOnArtifact(cardData.ArtifactBar)
                        StorageManager:ConsumeItem(artifactData.sid, artifactData.uid, 1)
                    else
                        artifactData:BindCard(cardData.uid)
                        cardData:PutOnArtifact(artifactData)
                        StorageManager:PutOnArtifact(artifactData)
                    end
                    cardData:CalcNowSumProp()
                    if call then
                        call()
                    end
                    -- local key = "ArtifactUpgradeRedPoint_" .. cardData.uid
                    -- if not _G.PlayerPrefsManager.HasKey(key) then
                    --     _G.PlayerPrefsManager.SetInt(key, 1)
                    -- end
                    RedPointManager:GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RoleArtifact.id)
                    RedPointManager:GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RoleArtifactUpgrade.id)
                    RedPointManager:GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.ArtifactUpgrade.id)
                end
            end
        )
    else
        require("ArtifactDemoModel"):GetInstance():PutOnDemoArtifact(cardData, artifactData, call)
    end
end

---脱下神器
---@param cardData CardData
function ArtifactModel:TakeOffArtifact(cardData, call)
    local artifactData = cardData.ArtifactBar
    if artifactData.type == _G.ArtifactDataType.Normal then
        if _G.table.isEmptyOrNil(artifactData) then
            if call then
                call()
            end
            return
        end
        self:TakeOff(
            cardData.uid,
            function(msg)
                if msg.ack == 1 then
                    _G.StorageManager:GetInstance():TakeOffArtifact(artifactData)
                    cardData.ArtifactBar = {}
                    cardData:CalcNowSumProp()
                    if call then
                        call()
                    end
                    -- local key = "ArtifactUpgradeRedPoint_" .. cardData.uid
                    -- if _G.PlayerPrefsManager.HasKey(key) then
                    --     _G.PlayerPrefsManager.DeleteKey(key)
                    -- end
                    RedPointManager:GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RoleArtifact.id)
                    RedPointManager:GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RoleArtifactUpgrade.id)
                end
            end
        )
    else
        require("ArtifactDemoModel"):GetInstance():TakeOffDemoArtifact(cardData, call)
    end
end

---一键脱下指定卡牌的神器
---@param cardDataList CardData[]
function ArtifactModel:OneKeyTakeOffArtifact(cardDataList, call)
    local cardUidList = {}
    for _, v in pairs(cardDataList) do
        local artifactData = v.ArtifactBar
        if not _G.table.isEmptyOrNil(artifactData) then
            if artifactData.type == _G.ArtifactDataType.Normal then
                _G.table.insert(cardUidList, v.uid)
            end
        end
    end
    self:OneKeyTakeOff(cardUidList, function(msg)
        if msg.ack == 1 then
            for _, v in pairs(cardDataList) do
                local artifactData = v.ArtifactBar
                if not _G.table.isEmptyOrNil(artifactData) then
                    if artifactData.type == _G.ArtifactDataType.Normal then
                        _G.StorageManager:GetInstance():TakeOffArtifact(artifactData)
                        v.ArtifactBar = {}
                        v:CalcNowSumProp()
                        RedPointManager:GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RoleArtifact.id)
                        RedPointManager:GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RoleArtifactUpgrade.id)
                    end
                end
            end
            if call then
                call()
            end
        end
    end)
end

---批量脱下
---@param uidList number[] uid列表
function ArtifactModel:MultiTakeOffArtifact(uidList, index, call)
    index = index or #uidList
    if index <= 0 then
        if call then
            call()
        end
        return
    end
    local cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uidList[index])
    if cardData ~= nil and not _G.table.isEmptyOrNil(cardData.ArtifactBar) then
        self:TakeOffArtifact(cardData, _G.handlerbind(self, self.MultiTakeOffArtifact, uidList, index - 1, call))
    else
        self:MultiTakeOffArtifact(uidList, index - 1, call) --递归脱下
    end
end

---检测背包是否有位置并弹tips
---@param CardDataList CardData[]
---@param showTip boolean 是否弹tips
function ArtifactModel:CheckEnoughStorageToTakeOffArtifact(CardDataList, showTip)
    local num = 0
    for _, v in pairs(CardDataList) do
        if not _G.table.isEmptyOrNil(v.ArtifactBar) then ---身上没穿，所以等价于背包空间足够
            num = num + 1
        end
    end
    if num == 0 then
        return true
    elseif num > 0 and _G.StorageManager:GetInstance():CheckSize(_G.StorageID.Artifact, num) then
        return true
    else
        if showTip then
            _G.PopWindowManager:GetInstance():ShowAllTips(270801)
        end
        return false
    end
end

---获取穿戴指定sid神器的角色中星级最高的神器
---@param artifactSid number 神器sid
---@return ArtifactData 返回穿戴的最高星级的神器数据没有就为nil
function ArtifactModel:GetMaxStarArtifactBySid(artifactSid)
    local list = _G.StorageManager:GetInstance():GetDatasBySid(_G.StorageID.Artifact, artifactSid)
    if _G.TableIsEmpty(list) then
        return nil
    end
    local outArtifact = nil

    local GetCardSidByUid = function(cardUid)
        if not cardUid  or cardUid == 0 then
            return 0
        end
        local cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, cardUid)
        if cardData and cardData.sid then
            return cardData.sid
        end
        return 0
    end

    for k, v in pairs(list) do
        if v.cfg.card_id ~= 0 and v.cfg.card_id == GetCardSidByUid(v.cardUid) then
            if not outArtifact or outArtifact.star < v.star then
                outArtifact = v
            end
        end
    end
    return outArtifact
end

---获取指定sid神器的星级最高的神器
---@param artifactSid number 神器sid
---@return ArtifactData 返回穿戴的最高星级的神器数据没有就为nil
function ArtifactModel:GetMaxStarArtifactBySidNoCard(artifactSid)
    local list = _G.StorageManager:GetInstance():GetDatasBySid(_G.StorageID.Artifact, artifactSid)
