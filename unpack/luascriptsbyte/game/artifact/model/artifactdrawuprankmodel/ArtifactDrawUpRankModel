---@class ArtifactDrawUpRankModel : Singleton	中文描述
local ArtifactDrawUpRankModel = _G.BaseClass("ArtifactDrawUpRankModel", _G.Singleton)
_G.ArtifactDrawUpRankModel = ArtifactDrawUpRankModel

---@return ArtifactDrawUpRankModel ArtifactDrawUpRankModel
function ArtifactDrawUpRankModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function ArtifactDrawUpRankModel:__init()
    self.rankAwardList = {}
    ---奖励总区间数
    self.rankAwardTotal = 0
    ---前三名上榜抽卡次数
    self.topDrawTimes = _G.ConfigManager.discrete_cfg[108603][1][2]
    ---最大上榜人数
    self.maxRankAmount = 1000
end

---请求排行榜数据
function ArtifactDrawUpRankModel:RequestRankInfo(page, activityId, callback)
    local pbData = {page = page, id = activityId}
    require("ArtifactNet"):GetInstance():GetArtifactDrawUpRankInfo(
        pbData,
        function(msg)
            local rankDatas = {}
            if not _G.table.isEmptyOrNil(msg) then
                rankDatas = self:UpdateRankData(msg.ranks, activityId)
            end

            ---个人排行榜数据必须等总榜的数据下发后才请求，两者有依赖关系
            require("ArtifactNet"):GetInstance():GetSelfRank(
                activityId,
                function(msg)
                    local mineRank, mineValue = self:GetMineRankData(msg, rankDatas, activityId)
                    if callback then
                        callback(rankDatas, mineRank, mineValue)
                    end
                end
            )
        end
    )
end

---前三名需要抽两百次才能上榜，所以需要对排名进行后移
function ArtifactDrawUpRankModel:UpdateRankData(rankDatas, activityId)
    local newRankData = {}
    if _G.table.isEmptyOrNil(rankDatas) then
       return newRankData 
    end

    local updateIndex = 0
    for i = 1, 3 do
        if not rankDatas[i] or rankDatas[i].draw_times < self.topDrawTimes then
            newRankData[i] = {}
        else
            updateIndex = i
            newRankData[i] = rankDatas[i]
        end
    end

    local offset = 3 - updateIndex
    local totalCount = #rankDatas
    if totalCount + offset > self.maxRankAmount then
       totalCount = self.maxRankAmount - offset
    end
    for i = updateIndex + 1, totalCount do
        newRankData[i + offset] = rankDatas[i]
    end
    return newRankData
end

---获取自己的排行榜数据
---@param mineData table 自己的排行榜数据
---@param rankDatas table 总排行榜数据
---@param activityId number 活动id
function ArtifactDrawUpRankModel:GetMineRankData(mineData, rankDatas, activityId)
    local playerUid = _G.PlayerModel:GetInstance():GetPlayerUid()
    for index, v in ipairs(rankDatas) do
        if v.role_info and v.role_info.uid == playerUid then
            return index, mineData.value
        end
    end

    local totalTimes = require("ArtifactDrawUpMainModel"):GetInstance():GetTotalTimes(activityId)
    if totalTimes > 0 then
        ---有抽奖次数未上榜则说明排名在100之外
       return 1001, totalTimes
    end
    return 0, totalTimes
end

---排行榜奖励
function ArtifactDrawUpRankModel:GetRankAwards(activityId)
    if not _G.table.isEmptyOrNil(self.rankAwardList[activityId]) then
        return self.rankAwardList[activityId]
    end
    self.rankAwardList[activityId] = {}
    local poolId = require("ArtifactDrawUpMainModel"):GetInstance():GetCfgId(activityId)
    local config = _G.ConfigManager.limited_roller_cfg[poolId] or {}
    local rankAward = config.draw_rank or {}
    local rankConfig = _G.ConfigManager.system_rank_cfg
    for _, v in pairs(rankAward) do
        if rankConfig[v] then
            _G.table.insert(self.rankAwardList[activityId],rankConfig[v])
            self.rankAwardTotal = self.rankAwardTotal + 1
        end
    end

    --进行排序(从高到底)
    _G.SortList(
        self.rankAwardList[activityId],
        function(v)
            return -v.min_rank
        end
    )

    return self.rankAwardList[activityId]
end


---销毁对象时,析构函数
function ArtifactDrawUpRankModel:Dispose()
    self.rankAwardList = nil
end

return ArtifactDrawUpRankModel