function ArtifactDrawUpMaindata:SetAward(id, isUp)
    if isUp then
        self.BattlePasspayAwards[id] = true
    else
        self.BattlePassfreeAwards[id] = true
    end
end

---是否购买高级战令
function ArtifactDrawUpMaindata:GetIsUp()
