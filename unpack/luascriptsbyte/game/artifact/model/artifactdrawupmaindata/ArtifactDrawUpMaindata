---获取当前等级、经验、总经验、下一等级奖励、是否满级
function ArtifactDrawUpMaindata:GetLvAndNextAward()
    ---@type limited_battlecon_cfg
    local item
    local coinId = self:GetCoinId()
    local maxLv = limited_battlecon_cfg[self.BattlePasscfgLis.award_id_list[#self.BattlePasscfgLis.award_id_list]].level
    local sum, lv, curIndex, maxExp = 0, 0, 0, 0
    for i = 1, #self.BattlePasscfgLis.award_id_list do
        item = limited_battlecon_cfg[self.BattlePasscfgLis.award_id_list[i]]
        sum = sum + item.conditions[1]
        maxExp = item.conditions[1]
        if self.BattlePassinfo.battle_exp >= sum then
            lv = item.level
            curIndex = i
        else
            sum = sum - item.conditions[1]
            break
        end
    end
    local isMaxLv = lv == maxLv
    local nextAward = {free = {}, pay = {}}
    if isMaxLv then
        curIndex = curIndex - 1
    end
    item = limited_battlecon_cfg[self.BattlePasscfgLis.award_id_list[curIndex + 1]]
    for _, v in pairs(item.rewards_free_item) do
        _G.table.insert(nextAward.free, v)
    end
    if item.rewards_free_cur > 0 then
        _G.table.insert(nextAward.free, {coinId, item.rewards_free_cur})
    end
    for _, v in pairs(item.rewards_pay) do
        _G.table.insert(nextAward.pay, v)
    end
    if item.rewards_pay_cur > 0 then
        _G.table.insert(nextAward.pay, {coinId, item.rewards_pay_cur})
    end
    local curExp = self.BattlePassinfo.battle_exp - sum
    return lv, curExp, maxExp, nextAward, isMaxLv
end

