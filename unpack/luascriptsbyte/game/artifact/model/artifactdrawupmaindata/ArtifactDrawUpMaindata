---自身活动代币增加（如锻造豪礼）
function ArtifactDrawUpMaindata:SetMallCoin(giftId)
    local data = {
        type = {
            [1] = self.coinId
        }
    }
    for _, v in pairs(self.limited_roller_cfg.rewards_goods) do
        if v[1] == giftId then
            data.type[2] = v[2]
            break
        end
    end
    _G.Events:GetInstance():Broadcast(_G.eArena.SetDrawUp, data.type)
    return data
end

---自身探寻礼包购买次数增加
function ArtifactDrawUpMaindata:AddPackGiftBuyTimes(giftId)
    if self.cashGift[giftId] == nil then
        self.cashGift[giftId] = 1
    else
        self.cashGift[giftId] = self.cashGift[giftId] + 1
    end
end

