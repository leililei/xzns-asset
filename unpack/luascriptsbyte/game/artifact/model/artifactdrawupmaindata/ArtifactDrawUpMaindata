---创建对象时,入口构造函数
function ArtifactDrawUpMaindata:__init(data, info)
    _G.Events:GetInstance():AddListener(_G.eArena.SetDrawUp, self.AddCoins, self)

    self:SetSelfData(data, info)
end

function ArtifactDrawUpMaindata:AddCoins(data)
    if data[1] == self.coinId then
        self:AddCoin(data[2])
        self:RefreshRedPoint()
    end
end

function ArtifactDrawUpMaindata:SetSelfData(activity, info)
    self.self_infoId = {}
    self.activity = activity
    self.info = info
    --GM配置
    self.cfg = info.cfg
    ---排行榜类型（1：单服 2：战区）
    self.rank_type = self.cfg.rank_type or 1
    ---当期展示神器 0：为未选择
    self.pool_id = self.cfg.pool_id or 0
    self.id = info.id or 0
    --当前保底累积次数limited_item
    self.times = info.times or {}
    --总招募次数
    self.total_times = info.forge_num or 0
    ---今日抽卡次数
    self.daY_times = info.day_forge_num or 0
    self.ActivityID = activity.activityID
    --已领取招募次数奖励
    self.award = info.award_id or {}
    local cashGift = info.cash_gift or {}
    self.cashGift = {}
    for _, v in pairs(cashGift) do
        self.cashGift[v.k] = v.v
    end

    --招募卷数量
    self.prop_num = info.coin_num or 0
    local coinId = 106 --默认值
    if self.cfg.coin_type and not _G.string.IsNullOrEmpty(self.cfg.coin_type) then
        coinId = _G.tonumber(self.cfg.coin_type)
    end
    self:SetCoin(self.prop_num, coinId)
    ---持续时间
    self.run_time = activity.cfg.time.run_time
    ---开始时间
    self.start_time = activity.cfg.time.start_time
    ---赛季奖励
    --self.artifact_pools_cfg = _G.ConfigManager.artifact_pools_cfg[self.pool_id]

    ---限时道具及其权重（卡牌id）
    --self.limited_itemId = self.artifact_pools_cfg.limited_item[1]

    -- require "RedPointManager":GetInstance():AddRedPointChild(1030, self.activity.typeClass:GetRedpointIDByIndex(1))

    ---当前概率提升
    -- self.guaranteed_init = _G.ConfigManager.artifact_pools_cfg.artifact_pools_cfg[self.Id].guaranteed_init

    local data = _G.ConfigManager.limited_roller_cfg[info.cfg.pool_id]
    if not data and _G.AppSetting.DEBUG then
        _G.LogError("invaild limited_roller_cfg.id=" .. info.cfg.pool_id)
    end
    self.limited_roller_cfg = data
    ---已使用魂玉召唤次数
    self.diamond_times = info.diamond_times or 0
    ---总共可使用魂玉次数(配置表丶服务器数据总和, 暂无服务器数据)
    self.diamond_total_times = data and data.count_diamond or 0
    ---魂玉单抽消耗数量
    self.diamond_consume_num = data and data.ticket_2[1] or 0
end

