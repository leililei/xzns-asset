end

---购买高级战令
function ArtifactDrawUpMaindata:BuyUp()
    require("MallManager"):GetInstance():BuyActiveGift(
        self.BattlePasscfgLis.price,
        self.DrawUpBattlePassModel.curActivityClass:GetActivityID(),
        self.BattlePasscfgLis.sid
    )
end

---一键领取
function ArtifactDrawUpMaindata:GetAwardAll(ActivityID, unclaimed, callback)
    if unclaimed == nil then
        unclaimed = self:FindAllUnclaimedRewards() or {}
    end
    if #unclaimed == 0 then
        return
    end
    local pbData = {activity_id = self.DrawUpBattlePassModel.curActivityClass:GetActivityID(), award_list = unclaimed}
    DrawUpBattlePassNet:GetInstance():GetAward(
        pbData,
        function(data)
            if data.ack == 1 then
                _G.StorageManager:GetInstance():ReceiveAwardData(data)
                self:ParseCoin(ActivityID, unclaimed, data)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
                for _, v in pairs(unclaimed) do
                    if v.type == 1 then
                        self.BattlePasspayAwards[v.a_id] = true
                    else
                        self.BattlePassfreeAwards[v.a_id] = true
                    end
                end
                self:RefreshRedPoint()
                if callback then
                    callback(data)
                end
            end
        end
    )
end

---刷新红点
function ArtifactDrawUpMaindata:RefreshRedPoint()
    if self.DrawUpBattlePassModel then 
        RedPointManager:GetInstance():RefreshNode(self.DrawUpBattlePassModel:GetRedpointIDByIndex(1))
    end
end

---查找所有未领取奖励
function ArtifactDrawUpMaindata:FindAllUnclaimedRewards()
    ---@type limited_battlecon_cfg
    local item
    local unclaimed = {}
    local sum = 0
    for _, id in pairs(self.BattlePasscfgLis.award_id_list) do
        item = limited_battlecon_cfg[id]
        sum = sum + item.conditions[1]
        if self.BattlePassinfo.battle_exp >= sum then
            if not self.BattlePassfreeAwards[id] then
                _G.table.insert(unclaimed, {type = 0, a_id = id})
            end
            if self:GetIsUp() and not self.BattlePasspayAwards[id] then
                _G.table.insert(unclaimed, {type = 1, a_id = id})
            end
        else
            break
        end
    end
    return unclaimed
end

---解析活动代币奖励
function ArtifactDrawUpMaindata:ParseCoin(ActivityID, unclaimed, data)
    ---@type limited_battlecon_cfg
    local cfg
    local sumCoin = 0
    for _, v in pairs(unclaimed) do
        cfg = limited_battlecon_cfg[v.a_id]
        if v.type == 1 then
            sumCoin = sumCoin + cfg.rewards_pay_cur
        else
            sumCoin = sumCoin + cfg.rewards_free_cur
        end
    end
    if sumCoin > 0 then
        if not data.award then
            data.award = {item = {}}
        end
        local coinId = ArtifactDrawUpMainModel:GetInstance():GetCoinId(ActivityID)
        _G.table.insert(data.award.item, {type = {coinId, sumCoin, 0}})
        ArtifactDrawUpMainModel:GetInstance():AddCoin(ActivityID, sumCoin)
    end
end

---领取奖励
function ArtifactDrawUpMaindata:BattlePassGetAward(ActivityID, id, isUp, callback)
    local pbData = {
        activity_id = self.DrawUpBattlePassModel.curActivityClass:GetActivityID(),
        award_list = {{type = isUp and 1 or 0, a_id = id}}
    }
    DrawUpBattlePassNet:GetInstance():GetAward(
        pbData,
        function(data)
            if data.ack == 1 then
                _G.StorageManager:GetInstance():ReceiveAwardData(data)
                self:ParseCoin(ActivityID, pbData.award_list, data)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
                if isUp then
                    self.BattlePasspayAwards[id] = true
                else
                    self.BattlePassfreeAwards[id] = true
                end
                self:RefreshRedPoint()
                if callback then
                    callback(data)
                end
            end
        end
    )
end

--- 获取购买经验的方法
---@param exp number 购买的经验值
---@param consume number 消耗的资源值
---@param callback function 回调函数
function ArtifactDrawUpMaindata:GetBuyExp(exp, consume, callback)
    ---@type store_season_battle.c2s_store_season_battle_buy_exp
    local pbData = {activity_id = self.DrawUpBattlePassModel.curActivityClass:GetActivityID(), exp = exp}
    DrawUpBattlePassNet:GetInstance():GetBuyExp(
        pbData,
        function(data)
            if data.ack == 1 then
                _G.StorageManager:GetInstance():ConsumeItem(_G.ResPropID.Diamond, 0, consume)
                self:AddExp(exp)
                self:RefreshRedPoint()
                if callback then
                    callback(data)
                end
            end
        end
    )
end

---高级战令购买成功监听
function ArtifactDrawUpMaindata:OnMallCashListener(data)
    if data.activity_id == self.DrawUpBattlePassModel.curActivityClass:GetActivityID() then
        self.BattlePassinfo.is_up = 1
        self:RefreshRedPoint()
        local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DrawUpBattlePassView.Name)
        if ctrl then
            ctrl:UpdateView()
        end
    end
end

