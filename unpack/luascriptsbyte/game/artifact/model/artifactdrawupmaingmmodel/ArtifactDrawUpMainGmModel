function ArtifactDrawUpMainGmModel:OnHandleGMData(info)
    -- self:SetSelfData(info)
    self:ParseData(info)
end

function ArtifactDrawUpMainGmModel:ParseData(info)
    -- self:SetSelfData(info)
    --  self:InitFunction()
    self.activity = self.curActivityClass
    require "ArtifactDrawUpMainModel":GetInstance():SetSelfData(info.artifact_pool, self.curActivityClass)
    base.ParseData(self)
end

