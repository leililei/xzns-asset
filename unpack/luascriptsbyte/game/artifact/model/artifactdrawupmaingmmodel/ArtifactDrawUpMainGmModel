---进入活动主体
function ArtifactDrawUpMainGmModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArtifactDrawUpMainView.Name, self.activity)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function ArtifactDrawUpMainGmModel:AddCoin(num)
    require "ArtifactDrawUpMainModel":GetInstance():AddCoin(self.activity.activityID, num)
end

function ArtifactDrawUpMainGmModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.ArtifactDrawUpMainView.Name
end

---领取奖励
---@param callback function 回调
function ArtifactDrawUpMainGmModel:GetAward(index, callback)
    self:GetActivityAward(index, callback)
end

function ArtifactDrawUpMainGmModel:GetOtherActivityRedPointIds()
    return { 10014, 10027, 10007, 10088 }
end

---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function ArtifactDrawUpMainGmModel:InitRedPointTree()
    self.checkRedPointFunc = { self.CheckRedPoint, self.CheckRedPointPackGift, self.CheckRedPointWish }
    self.redpointTree = {{2, 3}, false, false}
    --require "RedPointManager":GetInstance():AddRedPointChild(1030, self:GetRedpointIDByIndex(1))
    -- if self.curActivityClass:GetJumpType() == 100091 then 
    --     require "RedPointManager":GetInstance():AddRedPointChild(_G.ConfigManager.redpoint_cfg.CardHall.id, self:GetRedpointIDByIndex(1))
    -- end
end

function ArtifactDrawUpMainGmModel:CheckRedPoint()
    if self.activity then
        return require "ArtifactDrawUpMainModel":GetInstance():HongDian(self.activity.activityID)
    end
    return 0
end

function ArtifactDrawUpMainGmModel:CheckRedPointPackGift()
    if self.activity then
        return require "ArtifactDrawUpMainModel":GetInstance():HongDianPackGift(self.activity.activityID)
    end
    return 0
end

function ArtifactDrawUpMainGmModel:CheckRedPointWish()
    if self.activity then
        local sid = require "ArtifactDrawUpMainModel":GetInstance():GetArtifact(self.activity.activityID)
        return sid == 0 and 1 or 0
    end
    return 0
end

---刷新奖励红点
function ArtifactDrawUpMainGmModel:RefreshRedPoint(param)
    param = param or 1
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(param))
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function ArtifactDrawUpMainGmModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

