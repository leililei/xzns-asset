---@field exp number 图鉴当前等级经验
---@field illList artifact_illustration.i_artifact_illustration[] 图鉴数据
local ArtifactIllustrationModel = _G.BaseClass("ArtifactIllustrationModel", _G.GameDataModelBase)
local PlayerTreeID = _G.PlayerTreeID
local ProfSort = {
    [PlayerTreeID.tank] = 2,
    [PlayerTreeID.warrior] = 5,
    [PlayerTreeID.master] = 3,
    [PlayerTreeID.support] = 1,
    [PlayerTreeID.ranger] = 4
}

---品质
---@field Purple number 紫
---@field Orange number 橙
---@field Red number 红
---@field Colour number 彩
local ArtifactQuality = {
    Purple = 1,
    Orange = 2,
    Colour = 3,
    All = 4
}
---@return ArtifactIllustrationModel ArtifactIllustrationModel
