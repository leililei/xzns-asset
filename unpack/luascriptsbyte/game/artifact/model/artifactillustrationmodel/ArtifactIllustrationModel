    return self.super.GetInstance(self)
end

local ConfigManager = _G.ConfigManager
local TimeUtil = _G.TimeUtil
local UIManager = _G.UIManager
local ArtifactCfg = ConfigManager.artifact_cfg
local lvCfg = ConfigManager.illustrations_artifact_lv_cfg
local card_skills_cfg = ConfigManager.card_skills_cfg

---创建对象时,入口构造函数
