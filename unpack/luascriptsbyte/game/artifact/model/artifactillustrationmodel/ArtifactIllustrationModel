        endcall()
    end
   self:GetDataFormServer()
end
---获取信息
function ArtifactIllustrationModel:GetInfo()
    ArtifactNet:GetInstance():IllustrationInfo(_G.handler(self, self.ParseData))
end

---@param msg artifact_illustration.s2c_info
function ArtifactIllustrationModel:ParseData(msg)
    self.illLevel = msg.level
    self.exp = msg.exp
    self.needExp = 0
    if lvCfg[self.illLevel + 1] then
        self.needExp = lvCfg[self.illLevel + 1].exp - lvCfg[self.illLevel].exp
    end
    local insert = _G.table.insert
    self.illAllList = {}
    self.career = {
        [ArtifactQuality.Purple] = {},
        [ArtifactQuality.Orange] = {},
        [ArtifactQuality.Colour] = {},
        [ArtifactQuality.All] = {},
    }
    for k, v in pairs(ArtifactCfg) do
        local condition = v.condition_type
        if (condition == nil or #condition == 0 or _G.GlobalConditionManager.CheckConditionByArray(condition)) then
            local data = {}
            data.sid = v.id
            data.icon = v.Icon
            data.image = v.image_1
            data.name = v.image_2
            data.effect = v.effect
            data.professional = v.Professional
            data.exp = v.exp
            data.maxStar = -1
            data.curStar = -1
            data.unLock = 0
            data.cfg = v
            data.star = v.star
            data.order = v.Order
            data.own = false
            data.desc = require("ArtifactModel").GetStarSkillDes(v.id, 0)
            -- if v.skill_2_id ~= 0 then
            --     local skillData = card_skills_cfg[v.skill_2_id] or {}
            --     data.awakeDesc = skillData.describe1
            -- end
            self.illAllList[v.id] = data
        end
    end
    if msg.info then
        for k, v in pairs(msg.info) do
            if self.illAllList[v.sid] then
                self.illAllList[v.sid].unLock = v.is_unlock
                self.illAllList[v.sid].maxStar = v.high_star
                self.illAllList[v.sid].curStar = v.is_unlock == 0 and -1 or v.display_star
                self.illAllList[v.sid].own = true
            end
        end
    end
    if msg.skin_list then
        for k,v in pairs(msg.skin_list) do
            if self.illAllList[v.sid] then
                self.illAllList[v.sid].skin_list=v.skin_list
            end
        end
    end
    for k, v in pairs(self.illAllList) do
        insert(self.career[v.order], v)
        insert(self.career[ArtifactQuality.All], v)
    end
    -- _G.SortList(
    --     self.career[4],
    --     function(a)
    --         return ProfSort[a.professional]
    --     end
    -- )
    self:RefreshAttr()
    self.super.ParseData(self)
end

---图鉴升星
---@param sid number 神器sid
function ArtifactIllustrationModel:UpStar(sids, index, callback)
    local pbData = { sid = sids }
    ArtifactNet:GetInstance():IllustrationUpStar(pbData, function(msg)
        if msg.ack ~= 1 then
            return
        end
        local datas = {}
        local isAddExp = false
        local exp = 0
        for _, sid in pairs(sids) do
            local data = self.illAllList[sid]
            if data.unLock == 0 then
                data.unLock = 1
                exp = exp + (data.exp[data.curStar + 1] or 0)
            end
            for i= data.curStar + 1, data.maxStar do
                local addExp = data.exp[i + 1]
                if addExp and addExp > 0 then
                    exp = exp + addExp
                end
            end
            data.curStar = data.maxStar
            self.illAllList[sid] = data
            table.insert(datas, data)
        end
        local upPower
        if exp > 0 then
            isAddExp = true
            upPower = self:ChangeExp(exp)
        end
        if callback then
            callback(datas)
        end
        require("RedPointManager"):GetInstance():RefreshNode(self.repointID)
    end)
end

---更新图鉴经验
function ArtifactIllustrationModel:ChangeExp(exp)
    self.exp = self.exp + exp
    local upPower = false
    while (self.exp >= self.needExp) do
        self.illLevel = self.illLevel + 1
        self.exp = self.exp - self.needExp
        self.needExp = lvCfg[self.illLevel + 1].exp - lvCfg[self.illLevel].exp
        upPower = true
    end
    self:RefreshAttr(upPower)
    return upPower
end

---更新属性加成
function ArtifactIllustrationModel:RefreshAttr(upPower)
    local data = lvCfg[self.illLevel]
    local attributeManager = _G.AttributeClassManager:GetInstance()
    self.attribute = attributeManager:GetAttribtueClass()
    self.attribute:AddValueByName("atk", data.atk, nil, _G.AttCountType.other)
    self.attribute:AddValueByName("bre", data.bre, nil, _G.AttCountType.other)
    self.attribute:AddValueByName("def", data.def, nil, _G.AttCountType.other)
    self.attribute:AddValueByName("max_hp", data.max_hp, nil, _G.AttCountType.other)
    self.attributeChangeType = attributeManager:GetChangeAttrTypes(self.attribute)
    if upPower then
        local mypower = _G.StorageManager:GetInstance():GetPlayerPower()
        _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.ArtifactIll)
        local offset = _G.StorageManager:GetInstance():GetPlayerPower() - mypower
        if offset > 0 then
            require "CommonTipManager".OpenPowerUpView(mypower, offset)
        end
    end
end

function ArtifactIllustrationModel:GetillAttr()
    if not self.attribute then
        self:RefreshAttr()
    end
    return self.attribute, self.attributeChangeType
end

---获取光武皮肤卡牌专属属性
function ArtifactIllustrationModel:GetSkinAttr(id)
    local cfg = _G.ConfigManager.card_cfg[id]
    local attributeManager = _G.AttributeClassManager:GetInstance()
    local attribute = attributeManager:GetAttribtueClass()
    if not table.isEmptyOrNil(self.illAllList) then
        local data=self.illAllList[cfg.artifactid]
        local skinCfg
        if data and not table.isEmptyOrNil(data.skin_list) then
            for i = 1, #data.skin_list do
                skinCfg=_G.ConfigManager.artifact_skin_cfg[data.skin_list[i]]
                for _, v in pairs(skinCfg.base_att) do
                    attribute:AddValueByName(
                            v[1],
                            attributeManager:GetValueWithName(v[1], v[3], _G.tonumber(v[2])),
                            nil,
                            _G.tonumber(v[2]) == 1 and _G.AttCountType.other or _G.AttCountType.basePercent
                    )
                end
            end
        end
    end
    return attribute, _G.AttributeClassManager:GetInstance():GetChangeAttrList(attribute)
end
---获得全局光武皮肤属性
function ArtifactIllustrationModel:GetSkinAllAttr()
    local changeAttrTypes
    if self.allSkinAttr == nil then
        changeAttrTypes = self:UpdateAllSkinAttr()
    else
        changeAttrTypes = _G.AttributeClassManager:GetInstance():GetChangeAttrList(self.allSkinAttr)
    end
    return self.allSkinAttr, changeAttrTypes
end

---更新皮肤全局属性（获得生效）
function ArtifactIllustrationModel:UpdateAllSkinAttr()
    local attributeManager = _G.AttributeClassManager:GetInstance()
    local attribute = attributeManager:GetAttribtueClass()
    local cfg
    if not table.isEmptyOrNil(self.illAllList) then
        for k,v in pairs(self.illAllList) do
            if v.skin_list and #v.skin_list>0 then
                for i = 1, #v.skin_list do
                    cfg=_G.ConfigManager.artifact_skin_cfg[v.skin_list[i]]
                    for _, t in pairs(cfg.team_base_att) do
                        attribute:AddValueByName(
                                t[1],
                                attributeManager:GetValueWithName(t[1], t[3], _G.tonumber(t[2])),
                                nil,
                                _G.tonumber(t[2]) == 1 and _G.AttCountType.other or _G.AttCountType.basePercent
                        )
                    end
                end
            end
        end
    end
    local changeAttrTypes = _G.AttributeClassManager:GetInstance():GetChangeAttrList(attribute)
    self.allSkinAttr = attribute
    return changeAttrTypes
end


---改变神器最大星级
---@param sid number 神器sid
---@param newStar number 新的星级
function ArtifactIllustrationModel:ChangeMaxStar(sid, newStar)
    if self.illAllList[sid] then
        local data = self.illAllList[sid]
        data.maxStar = data.maxStar > newStar and data.maxStar or newStar
        self.illAllList[data.sid] = data
        for k, v in pairs(self.career[data.order]) do
            if v.sid == data.sid then
                v = data
                break
            end
        end

        for k, v in pairs(self.career[ArtifactQuality.All]) do
            if v.sid == data.sid then
                v = data
                break
            end
        end

        require("RedPointManager"):GetInstance():RefreshNode(self.repointID)
    end
end

