    return _G.DeepCopy(lvCfg[level])
end

---获得神器
function ArtifactIllustrationModel:GainArtifact(sid)
    if not self.illAllList then
        self.illAllList = {}
    end
    local data = self.illAllList[sid]
    if data and not data.own then
        data.own = true
        data.maxStar = 0
        self.illAllList[data.sid] = data
        for k, v in pairs(self.career[data.order]) do
            if v.sid == data.sid then
                v = data
                break
            end
        end
        for k, v in pairs(self.career[ArtifactQuality.All]) do
            if v.sid == data.sid then
                v = data
                break
            end
        end
        require("RedPointManager"):GetInstance():RefreshNode(self.repointID)
    end
end

---检测红点
function ArtifactIllustrationModel:RedPointCheck()
    for k, v in pairs(self.illAllList) do
        if v.curStar < v.maxStar then
            return 1
        end
    end
    return 0
end

---检测是否已拥有对应光武皮肤
function ArtifactIllustrationModel:CheckIsHasSkinBySid(sid)
    local artifactId = _G.ConfigManager.artifact_skin_cfg[sid].card
    if self.illAllList[artifactId] and self.illAllList[artifactId].skin_list then
        return _G.table.ContainsValue(self.illAllList[artifactId].skin_list, sid)
    end
    return false
end

---检测是否拥有神器光武皮肤
---@param Artifactsid number 神器sid
---@param skinsid number 光武皮肤sid
function ArtifactIllustrationModel:ChectIsHasArtifactSkin(Artifactsid,skinsid)
    local data=self.illAllList[Artifactsid]
    if not data.own then
        return false
    end
    ---原皮光武默认拥有
    if skinsid==data.cfg.skin[1] then
        return true
    end
    if not data.skin_list or #data.skin_list==0 then
        return false
    end
    return table.ContainsValue(data.skin_list,skinsid)
end
---通过卡片sid检测是否拥有光武皮肤
---@param cardid number 卡牌sid
---@param skinsid number 光武皮肤sid
function ArtifactIllustrationModel:ChectIsHasArtifactSkinByCardData(cardid,skinsid)
    local cardcfg=_G.ConfigManager.card_cfg[cardid]
    if cardid==skinsid then
        local data=self.illAllList[cardcfg.artifactid]
        return data.unLock==1
    end
    return self:ChectIsHasArtifactSkin(cardcfg.artifactid,skinsid)
end
---判断卡片信息是否显示光武皮肤
function ArtifactIllustrationModel:CheckCardIsShowArtifactSkin(cardid)
    local cardcfg=_G.ConfigManager.card_cfg[cardid]
    local data=self.illAllList[cardcfg.artifactid]
    return data and data.cfg.skin and table.count(data.cfg.skin)>0
end
---判断光武形态是否解锁
---@param id number 神器id
---@param star number 星级
function ArtifactIllustrationModel:CheckIsUnLockArtifactStage(id,star)
    local data=self.illAllList[id]
    if star==0 then
        return data.unLock==1
    elseif data.unLock==1 then
        return data.maxStar>=star
    else
        return false
    end
end
---获取当前光武形态
---@param id number 神器id
function ArtifactIllustrationModel:GetNowArtifactStage(id)
    local data=self.illAllList[id]
    if  not data or data.unlock == 0 then
        return 0
    end
    local stage=1
    for i = 2, #data.cfg.form_name do
        if data.cfg.form_name[i][1]<=data.maxStar then
            stage=i
        end
    end
    return stage
end
---激活光武皮肤
function ArtifactIllustrationModel:AddArtifactSkin(skinid)
    local skincfg=_G.ConfigManager.artifact_skin_cfg[skinid]
    local data=self.illAllList[skincfg.card]
    if not data.skin_list then
        data.skin_list={}
    end
    _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.ArtifactSkinAttr)
    _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.ArtifactSkinAllAttr)
    table.insert(data.skin_list,skinid)
    
end
---通过皮肤id判断对应神器是否解锁
function ArtifactIllustrationModel:CheckArtifaceIsUnLockBySkinId(skinid)
    local skincfg=_G.ConfigManager.artifact_skin_cfg[skinid]
    local data=self.illAllList[skincfg.card]
    return data.unlock==1
end
---通过id获得神器是否解锁
function ArtifactIllustrationModel:CheckArtifactIsUnLockById(id)
    local data=self.illAllList[id]
    return data.unlock==1
end
---通过卡牌皮肤id获取对应光武皮肤id
---@param cardid number 卡牌id
---@param skinid number 卡牌皮肤id
function ArtifactIllustrationModel:GetArtifactSkinidByCardSkinid(cardid,skinid)
    local cardcfg=_G.ConfigManager.card_cfg[cardid]
    local data=self.illAllList[cardcfg.artifactid]
    if not data or not data.cfg.skin or #data.cfg.skin==0 then
        return nil
    end
    if cardid==skinid  then
        return data.cfg.skin[1]
    end
    ---@type artifact_skin_cfg
    local artifactskincfg=nil
    for i = 1, #data.cfg.skin do
        artifactskincfg=_G.ConfigManager.artifact_skin_cfg[data.cfg.skin[i]]
        if artifactskincfg.skin_id==skinid then
            return artifactskincfg.id
        end
    end
    return  nil
end

---皮肤购买回调
function ArtifactIllustrationModel:OnBuy(data)
    if not data then
        return
    end
    local type = data[1]
    if type ~= 10 then
        return
    end
    local sid = data[2]
    if not _G.ConfigManager.artifact_skin_cfg[sid] then
        sid = tonumber(_G.ConfigManager.item_cfg[sid].UseParameter[1][1])
    end
    local artifactId = _G.ConfigManager.artifact_skin_cfg[sid].card
    if not self.illAllList[artifactId] then
        self.illAllList[artifactId] = {
            skin_list = {}
        }
    end
    if not self.illAllList[artifactId].skin_list then
        self.illAllList[artifactId].skin_list = {}
    end
    _G.table.insert(self.illAllList[artifactId].skin_list, sid)
    _G.Events:GetInstance():Broadcast(_G.eCertificateMall.Parsed)
end

---销毁对象时,析构函数
function ArtifactIllustrationModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eCertificateMall.Buy, self.OnBuy, self)
end

return ArtifactIllustrationModel
