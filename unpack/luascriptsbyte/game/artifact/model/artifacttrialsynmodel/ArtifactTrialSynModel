local ActivitySynManager = require("ActivitySynManager")
local base = require("ActivitySynTypeBase")
---@class ArtifactTrialSynModel : ActivitySynTypeBase
---@field artifactTrialData activity_artifact_trial.i_activity_artifact_trial
local ArtifactTrialSynModel = _G.BaseClass("ArtifactTrialSynModel", base)

function ArtifactTrialSynModel:__init()
    self.artifactTrialData = {}
end

function ArtifactTrialSynModel:OnHandleGMData(data)
    self:ParseData(data)
end


function ArtifactTrialSynModel:ParseData(data)
    if not data then
        return
    end
    if data.artifact_trial then
        local activityEndTime = self.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
        if data.artifact_trial.is_award == 1 or activityEndTime <= _G.TimeUtil.GetServerUnixTime() then
            self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
        else
            self.artifactTrialData = data.artifact_trial
            local time = data.artifact_trial.time
            self.artifactTrialData.endDay = _G.Mathf.Floor(time / 86400)
        end
    end
end

---进入活动主体
function ArtifactTrialSynModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArtifactTrialActivityView.Name, self.curActivityClass)
end

---初始化红点树
function ArtifactTrialSynModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function ArtifactTrialSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---检查红点
function ArtifactTrialSynModel:CheckRedPoint()
    if self.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Open
        and self.artifactTrialData.is_award
        and self.artifactTrialData.is_award == 0 then
        return 1
    end
    return 0
end

function ArtifactTrialSynModel:GetAward(call)
    local pbData = {activity_id = self.curActivityClass:GetActivityID()}
    require("ArtifactNet"):GetInstance():GetDemoArtifact(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            msg.sid = self.artifactTrialData.sid
            self.artifactTrialData.is_award = 1
            self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
            require("ArtifactDemoModel"):GetInstance():AddDemoArtifact(msg)
            local award = {award = {item = {{self.artifactTrialData.sid, 0, 1}}}}
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, award)
            require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
            if call then
                call()
            end
        end
    )
end

return ArtifactTrialSynModel