local ArtifactTimerData = require("ArtifactTimerData")
local ArtifactNet = require("ArtifactNet")
local RedPointManager = require("RedPointManager")

---@class ArtifactDemoModel    中文描述
local ArtifactDemoModel = _G.BaseClass("ArtifactDemoModel", _G.GameDataModelBase)

function ArtifactDemoModel:__init()
    self.demoUidLis = {}
    self.artifactLis = {}
    _G.Events:GetInstance():AddListener(_G.eCard.CardUpStar, self.UpdateAllArtifact, self)
    _G.Events:GetInstance():AddListener(_G.ePlayAactionEvent.PlayAaction, self.OnLevelUp, self)
    _G.Events:GetInstance():AddListener(_G.eShenshiEvents.UpCoreCard, self.OnStoneCoreChange, self)
    _G.Events:GetInstance():AddListener(_G.eShenshiEvents.DownCoreCard, self.OnStoneCoreChange, self)
end

---@return ArtifactDemoModel ArtifactDemoModel
function ArtifactDemoModel:GetInstance()
    return self.super.GetInstance(self)
end

---从服务器拉取数据
function ArtifactDemoModel:GetDataFormServer()
    require "ArtifactNet":GetInstance():GetDemoInfo(_G.handler(self, self.ParseData))
end

function ArtifactDemoModel:ParseData(msg)
    ---@type artifact.i_artifact_demo
    self.demoLis = msg.demo_list or {}
    self.demoUidLis = {}
    self.artifactLis = {}
    self.super.ParseData(self)
end

function ArtifactDemoModel:InitFunction()
    if #self.demoLis == 0 then
        return
    end
    local lv, star = self:GetArtifactParam()
    for _, v in pairs(self.demoLis) do
        self:AddDemoArtifact(v, lv, star)
    end
end

---添加试玩神器
function ArtifactDemoModel:AddDemoArtifact(msg, lv, star)
    if lv == nil then
        lv, star = self:GetArtifactParam()
    end
    local artifactStorage = _G.StorageManager:GetInstance():GetDataStorageByID(_G.StorageID.Artifact)
    ---@type ArtifactTimerData
    local data = ArtifactTimerData.New()
    msg.level = lv
    msg.star = star
    data:ParseInitMsg(msg)
    data:SetTime(msg.end_time)
    self.demoUidLis[msg.uid] = true
    self.artifactLis[msg.uid] = data
    artifactStorage:AddOtherTypeArtifact(data)
    if msg.card_uid and msg.card_uid > 0 then
        local cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, msg.card_uid)
        cardData:PutOnArtifact(data)
        cardData:CalcNowSumProp()
    end
end

---穿戴试玩神器
function ArtifactDemoModel:PutOnDemoArtifact(cardData, artifactData, call)
    local pbData = {card_uid = cardData.uid, artifact_uid = artifactData.uid}
    ArtifactNet:GetInstance():DemoPutOn(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            local StorageManager = _G.StorageManager:GetInstance()
            if not _G.table.isEmptyOrNil(cardData.ArtifactBar) then
                StorageManager:TakeOffArtifact(cardData.ArtifactBar)
            end
            artifactData:BindCard(cardData.uid)
            cardData:PutOnArtifact(artifactData)
            StorageManager:PutOnArtifact(artifactData)
            cardData:CalcNowSumProp()
            if call then
                call()
            end
            RedPointManager:GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RoleArtifact.id)
            RedPointManager:GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RoleArtifactUpgrade.id)
        end
    )
end

---脱下试玩神器
function ArtifactDemoModel:TakeOffDemoArtifact(cardData, call)
    local artifactData = cardData.ArtifactBar
    if _G.table.isEmptyOrNil(artifactData) then
        if call then
            call()
        end
        return
    end
    local pbData = {card_uid = cardData.uid, artifact_uid = artifactData.uid}
    ArtifactNet:GetInstance():DemoTakeOff(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():TakeOffArtifact(artifactData)
            cardData.ArtifactBar = {}
            cardData:CalcNowSumProp()
            if call then
                call()
            end
            RedPointManager:GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RoleArtifact.id)
            RedPointManager:GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RoleArtifactUpgrade.id)
        end
    )
end

---移除试玩神器
function ArtifactDemoModel:RemoveArtifact(uid)
    self.artifactLis[uid] = nil
    self.demoUidLis[uid] = nil
    ---@type ArtifactStorage
    local ArtifactStorage = _G.StorageManager:GetInstance():GetDataStorageByID(_G.StorageID.Artifact)
    ArtifactStorage:RemoveOtherTypeArtifact(uid)
end

---检查是否是试玩神器
function ArtifactDemoModel:CheckIsDemoArtifact(uid)
    return self.demoUidLis[uid]
end

function ArtifactDemoModel:GetArtifactParam()
    local y = require("CardResonanceModel"):GetInstance():GetAverageLevel()
    if y < 1 then
        y = 1
    end 
    local cfg = _G.ConfigManager.discrete_cfg[101207]
    local a = cfg[1][1]
    local b = cfg[1][2]
    local c = cfg[2][1]
    local d = cfg[2][2]
    local x = require("IllustrationModel"):GetInstance():GetTopNStarAverage(5)
    local mathf = _G.Mathf
    local star = mathf.Min(mathf.Max(mathf.RoundToInt((x - b) / a), 0), 5)
    local lv = mathf.Min(mathf.Max(mathf.RoundToInt((y - d) / c), 1), 100)
    return lv, star
end

function ArtifactDemoModel:UpdateAllArtifact()
    if _G.table.isEmptyOrNil(self.artifactLis) then
        return
    end
    local lv, star = self:GetArtifactParam()
    for _, v in pairs(self.artifactLis) do
        if lv ~= v.lv or star ~= v.star then
            v.lv = lv
            v.star = star
            v:UpdateAttribute()
        end
    end
end

function ArtifactDemoModel:OnLevelUp(data)
    if data[1] == _G.ActiveTaskEnum.ConditionEnum.CardLevel.assignSidAssignLevel then
        self:UpdateAllArtifact()
    end
end

function ArtifactDemoModel:OnStoneCoreChange()
    self:UpdateAllArtifact()
end

---销毁对象时,析构函数
function ArtifactDemoModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eCard.CardUpStar, self.UpdateAllArtifact, self)
    _G.Events:GetInstance():RemoveListener(_G.ePlayAactionEvent.PlayAaction, self.OnLevelUp, self)
    _G.Events:GetInstance():RemoveListener(_G.eShenshiEvents.UpCoreCard, self.OnStoneCoreChange, self)
    _G.Events:GetInstance():RemoveListener(_G.eShenshiEvents.DownCoreCard, self.OnStoneCoreChange, self)
end

return ArtifactDemoModel
