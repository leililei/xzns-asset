-- 根据代币类型获取代币数量
function TenOneModel:GetCoinIdList(ID)
    if self.activityList == nil then
        return nil
    end
    for key, value in pairs(self.activityList) do
        if value:GetCoinId() == ID then
            return value:GetCoin()
        end
    end
    return nil
end

