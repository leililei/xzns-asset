---@param msg activity.i_activity_self_info
function TenOneModel:ParseData(ActivityID, msg, activity)
    self:SetSelfData(msg, activity.curActivityClass)
    local data = self.activityList[ActivityID]
    if data == nil then
        return 0
    end
    return data:ParseData(msg, activity)
end

