---@class ArtifactAwakenSuccessView : UIBaseView    中文描述
---@field public go_table ArtifactAwakenSuccessView_GoTable GoTable
---@field data ArtifactData 神器数据
local ArtifactAwakenSuccessView = _G.BaseClass("ArtifactAwakenSuccessView", _G.UIBaseView)

function ArtifactAwakenSuccessView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArtifactAwakenSuccessView:OnCreate(data, call)
    self.data = data
    self.call = call
    self:Show()
end
---显示界面
function ArtifactAwakenSuccessView:Show()
    self:ShowItem()
    --self:ShowProp()
    --self:ShowSkill()
    self:RefreshSkillNode()
end

---显示觉醒item
function ArtifactAwakenSuccessView:ShowItem()
    self.go_table.aorrawimage_icon:LoadImage(self.data.cfg.image_1,
        function(image)
            if self:IsNil() then
                return
            end
            image:SetNativeSize()
        end)
end

---显示觉醒加成
function ArtifactAwakenSuccessView:ShowProp()
    if _G.table.isEmptyOrNil(self.data.cfg.att_awaken) then
        self.go_table.obj_add:SetActiveE(0)
    else
        local str = ""
        local params
        for i = 1, #self.data.cfg.att_awaken do
            params = self.data.cfg.att_awaken[i]
            if _G.AttrType[params[1]] then
                local value = _G.AttributeClassManager:GetInstance():GetShowProp(
                    params[1],
                    tonumber(params[2]),
                    params[3],
                    0.01,
                    1
                )
                str = str .. _G.AttrType[params[1]].des .. "+" .. value .. " "
            end
        end
        self.go_table.aortext_addDes.text = str
        self.go_table.obj_add:SetActiveE(1)
    end
end

---显示觉醒技能
function ArtifactAwakenSuccessView:ShowSkill()
    if self.data.cfg.skill_2_id > 0 then
        local skillCfg = _G.ConfigManager.card_skills_cfg[self.data.cfg.skill_2_id]
        if skillCfg then
            self.go_table.aortext_skillDesc.text = _G.GetLangPackValue(skillCfg.describe1)
        end
        self.go_table.obj_skill:SetActiveE(1)
    else
        self.go_table.obj_skill:SetActiveE(0)
    end
end

function ArtifactAwakenSuccessView:RefreshSkillNode()
    ---@type artifact_awaken_cfg
    local cfg = {}
    for _, v in pairs(_G.ConfigManager.artifact_awaken_cfg) do
        if v.star == self.data.awaken then
            cfg = v
        end
    end
    self.go_table.aortext_title2.text=_G.GetLangPackValue(cfg.exclusive_if == 1 and 90022501363 or 92010700063)
    if cfg.exclusive_if == 1 then
        GameUtil.SetChildCount(self.go_table.obj_skillNode, 1, function(obj, index)
            ---@type ArtifactAwakenSuccessView._obj_skillItem
            local item = GetAutoGoTable(obj)
            local skillid = self.data.cfg.skill_4_id
            local cardskillcfg = _G.ConfigManager.card_skills_cfg[skillid]
            local icon = cardskillcfg.icon
            item.aorrawimage_icon1:LoadImage(icon)
            item.aorimage_skillspbg1:SetActiveE(1)
            item.aorimage_skillbg1:SetActiveE(0)

        end)
    else
        GameUtil.SetChildCount(self.go_table.obj_skillNode, #cfg.skill_id, function(obj, index)
            ---@type ArtifactAwakenSuccessView._obj_skillItem
            local item = GetAutoGoTable(obj)
            local id = cfg.skill_id[index]
            local skillcfg = _G.ConfigManager.artifact_awaken_skill[id]
            item.aorrawimage_icon1:LoadImage(skillcfg.icon)
            item.aorimage_skillspbg1:SetActiveE(0)
            item.aorimage_skillbg1:SetActiveE(1)

        end)
    end
end

---按钮点击事件在这里派发
function ArtifactAwakenSuccessView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        if self.call then
            self.call()
        end
        self:Close()
    end
end

return ArtifactAwakenSuccessView
