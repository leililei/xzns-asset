---@class ArtifactDevelop_UpLevelPanel : UIBaseView	中文描述
---@field public go_table ArtifactDevelop_UpLevelPanel_GoTable GoTable
---@field item ItemArtifactBase 神器item
local ArtifactDevelop_UpLevelPanel = _G.BaseClass("ArtifactDevelop_UpLevelPanel", _G.UIBaseView)
--_G.ArtifactDevelop_UpLevelPanel = ArtifactDevelop_UpLevelPanel
local GetLangPackValue = _G.GetLangPackValue
local GetAutoGoTable = _G.GetAutoGoTable
local LevelUpTen = 10
function ArtifactDevelop_UpLevelPanel:Awake()
    self.go_table = GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self.consumeResList = {}
    self:AddListener(_G.eItemUpdata.Updata, self.OnItemUpdate, self)
end

---显示界面
---@param data ArtifactData
---@param cardData CardData
function ArtifactDevelop_UpLevelPanel:Show(data, cardData, call)
    self.artifactData = data
    if self.cardData and self.cardData.uid==cardData.uid then
        if not self.lastPower then
            self.lastPower = self.cardData.power
        end
    else
        self.cardData = cardData
        self.lastPower = self.cardData.power
    end
    if not table.isEmptyOrNil(data) then
        self.call = call
        self.maxLevel = _G.ConfigManager.artifact_star_cfg[100 + self.artifactData.cfg.Star].level_limit
        self.curMaxLevel = self.artifactData:GetMaxLevel()
        self.upLevel = self.artifactData:GetLevel() == self.maxLevel and 0 or 1
        self.go_table.obj_Prop:SetActiveE(1)
        self.go_table.aorrawimage_nowearArtifact:SetActiveE(0)
    else
        self.go_table.obj_Prop:SetActiveE(0)
        self.go_table.aorrawimage_nowearArtifact:SetActiveE(1)
    end
    self:ShowInfo()
    self:ShowProp()
end
function ArtifactDevelop_UpLevelPanel:Refresh()
    self.maxLevel = _G.ConfigManager.artifact_star_cfg[100 + self.artifactData.cfg.Star].level_limit
    self.curMaxLevel = self.artifactData:GetMaxLevel()
    self.upLevel = self.artifactData:GetLevel() == self.maxLevel and 0 or 1
    self.go_table.obj_Prop:SetActiveE(1)
    self.go_table.aorrawimage_nowearArtifact:SetActiveE(0)
    self:ShowInfo()
    self:ShowProp()
end

---显示信息
function ArtifactDevelop_UpLevelPanel:ShowInfo()
    self:ShowConsume()
    self:ShowBtn()
end

function ArtifactDevelop_UpLevelPanel:ShowConsumItem(datas)
    if datas then
        self.go_table.obj_Matrial:SetActiveE(1)
        local consumeResList = {}
        for _, v in ipairs(datas) do
            if v[2] > 0 then
                _G.table.insert(consumeResList, {v[1], false, v[2]})
            end
        end
        if not self.resConsume then
            self.resConsume = self:AddComponent(
                    self.go_table.obj_Matrial,
                    require("ConsumeCompont").New(self.go_table.obj_Matrial, consumeResList, nil, nil, true, {textColorType = 4, showNow = true})
            )
        else
            self.resConsume:RestRs(consumeResList)
        end
    else
        self.go_table.obj_Matrial:SetActiveE(0)
    end
end

---显示消耗
function ArtifactDevelop_UpLevelPanel:ShowConsume()
    if table.isEmptyOrNil(self.artifactData) then
        self.go_table.obj_Matrial:SetActiveE(0)
        return
    end
    self.go_table.obj_Matrial:SetActiveE(1)
    local curLevel = self.artifactData:GetLevel()
    local upLevel = LevelUpTen
    if curLevel + upLevel > self.curMaxLevel then
        upLevel = self.curMaxLevel - curLevel
    end
    local consumeResList
    local lastConsumeResList
    local canUpLevel = 0
    local enoughRes = true
    local StorageManager = _G.StorageManager:GetInstance()
    for i = curLevel + 1, curLevel + upLevel do
        consumeResList = self:GetConsume(i, i - curLevel)
        for _, v in pairs(consumeResList) do
            if v[2] > 0 and not StorageManager:CheckItem(v[1], v[2]) then
                enoughRes = false
                break
            end
        end
        if not enoughRes then
            if not lastConsumeResList then
                lastConsumeResList = consumeResList
            end
            break
        else
            canUpLevel = canUpLevel + 1
            lastConsumeResList = consumeResList
        end
    end
    self.consumeResList = lastConsumeResList
    self.upLevel = canUpLevel > 0 and canUpLevel or 1
    self.go_table.aortext_levelUp.text = _G.GetLangPackValue(91307420705, self.upLevel)
    self:ShowConsumItem(self.consumeResList)
end

---升10级的消耗
function ArtifactDevelop_UpLevelPanel:ShowTenLevelConsume(upLevel)
    local curLevel = self.artifactData:GetLevel()
    local nextLevel = curLevel + upLevel
    if nextLevel > self.maxLevel then
        nextLevel = self.maxLevel
    end
    return self:GetConsume(nextLevel, upLevel)
end

---计算消耗
function ArtifactDevelop_UpLevelPanel:GetConsume(nextLevel, upLevel)
    ---@type artifact_level_cfg
    local cfg = _G.ConfigManager.artifact_level_cfg[nextLevel]
    local curCfg = _G.ConfigManager.artifact_level_cfg[self.artifactData:GetLevel()]
    local order = self.artifactData:GetOrder()
    local consumeResList = _G.DeepCopyCfgTable(cfg["material_" .. order])
    if upLevel > 0 then
        for _, v in pairs(consumeResList) do
            for _, v2 in pairs(curCfg["material_" .. order]) do
                if v2[1] == v[1] then
                    v[2] = v[2] - v2[2]
                    break
                end
            end
        end
    end
    return consumeResList
end

---显示按钮
function ArtifactDevelop_UpLevelPanel:ShowBtn()
    if table.isEmptyOrNil(self.artifactData) then
        self.go_table.aorbtn_up:SetActiveE(0)
        self.go_table.aorbtn_autoUp:SetActiveE(0)
        self.go_table.obj_max:SetActiveE(0)
        return
    end
    if self.artifactData:GetLevel() == self.curMaxLevel then
        self.go_table.aorbtn_up:SetActiveE(0)
        self.go_table.aorbtn_autoUp:SetActiveE(0)
        if self.curMaxLevel >= self.maxLevel then
            self.go_table.aortext_tips.text = ""
            self.go_table.obj_max:SetActiveE(1)
        else
            self.go_table.obj_max:SetActiveE(0)
            self.go_table.aortext_tips.text = _G.GetLangPackValue(90022300048)
        end
    else
        self.go_table.aorbtn_up:SetActiveE(1)
        self.go_table.aorbtn_autoUp:SetActiveE(1)
        self:SetUpLevelButton()
        self.go_table.obj_max:SetActiveE(0)
        self.go_table.aortext_tips.text = ""
    end
    self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(
        _G.ConfigManager.redpoint_cfg.ArtifactUpgrade.id,
        self.artifactData.uid * 10 + 1
    )
end


---升多级的显示
function ArtifactDevelop_UpLevelPanel:SetUpLevelButton()
    local curLevel = self.artifactData:GetLevel()
    local upLevel = LevelUpTen
    local upMaxLevel = _G.ConfigManager.discrete_cfg[114007][1][1]
    if upLevel + curLevel > self.curMaxLevel and upMaxLevel + curLevel >= self.curMaxLevel then
        upLevel = self.curMaxLevel - curLevel
    end

    ---计算升级所需要的资源是否足够
    local resEnough = true
    local consumeResList = self:ShowTenLevelConsume(upLevel)
    local StorageManager = _G.StorageManager:GetInstance()
    for _, v in pairs(consumeResList) do
        if v[2] > 0 and not StorageManager:CheckItem(v[1], v[2]) then
            resEnough = false
            break
        end
    end
    self.go_table.aorbtn_autoUp:SetGray(not resEnough)
    if not resEnough or upLevel > upMaxLevel then
        self.go_table.aortext_autoUp.text = _G.GetLangPackValue(90030900055)
    else
        self.go_table.aortext_autoUp.text = _G.GetLangPackValue(90030900056) 
    end
end

function ArtifactDevelop_UpLevelPanel:OnItemUpdate()
    self:ShowConsume()
    self:ShowBtn()
    self:ShowProp()
end

function ArtifactDevelop_UpLevelPanel:OnUpLevel()
    local StorageManager = _G.StorageManager:GetInstance()
    for _, v in pairs(self.consumeResList) do
        if v[2] > 0 then
            if not StorageManager:CheckItemNew(v[1], v[2], function()
                self:ShowConsume()
            end)
            then
                return
            end
        end
    end

    if self.artifactData:GetLevel() >= self.curMaxLevel then
        return
    end
    self:SendLevelUpMsg(self.upLevel, StorageManager)
end
---一键强化
function ArtifactDevelop_UpLevelPanel:OnAutoUpLevel()
    local curLevel = self.artifactData:GetLevel()
    if curLevel >= self.maxLevel then
        return
    end

    local upLevel = LevelUpTen
    local upMaxLevel = _G.ConfigManager.discrete_cfg[114007][1][1]
    if upLevel + curLevel > self.curMaxLevel and upMaxLevel + curLevel >= self.curMaxLevel then
        upLevel = self.curMaxLevel - curLevel
    end
    local consumeResList = self:ShowTenLevelConsume(upLevel)
    local StorageManager = _G.StorageManager:GetInstance()
    for _, v in pairs(consumeResList) do
        if not StorageManager:CheckItem(v[1], v[2]) then
            return
        end
    end
    self.consumeResList = consumeResList
    self:SendLevelUpMsg(upLevel, StorageManager)
end

function ArtifactDevelop_UpLevelPanel:SendLevelUpMsg(upLevel, StorageManager)
    local msgData = self.artifactData:GetMsg()
    msgData.card_uid = self.artifactData.cardUid
    local data = _G.ArtifactData.New()
    data:ParseInitMsg(msgData)
    self.lastCardProp = _G.GameUtil.GetPropUpData(self.cardData)
    require "ArtifactModel":GetInstance():LevelUp(
        self.artifactData.uid,
        self.artifactData.cardUid,
        upLevel,
        self.artifactData.uid ~= self.artifactData.sid,
        function(msg)
            if msg.ack ~= 1 then
                return
            end

            local count = 0
            for _, v in ipairs(self.consumeResList) do
                if v[2] > 0 then
                    StorageManager:ConsumeItem(v[1], nil, v[2])
                    count = count + 1
                end
            end

            if msg.uid then
                self.artifactData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Artifact, msg.uid)
            end
            --ZHJH-5212 修改为属性飘字，不显示tips
            --if count >= 1 then
            --    _G.UIManager:GetInstance():OpenWindow(
            --        _G.ConfigManager.ui_cfg.DecorationUpView.Name,
            --        data,
            --        self.artifactData,
            --        2
            --    )
            --end
            if self.cardData then
                require "CardInfoManager":GetInstance():Updata_CardViewUpdataFun(self.cardData, true)
                _G.UIUtils.ShowPropUp(self.cardData, self.lastCardProp)
                local curPower = self.cardData.power
                if self.lastPower and self.lastPower < curPower then
                    require "CommonTipManager".OpenPowerUpView(self.lastPower, curPower - self.lastPower)
                end
                self.lastPower = curPower
            end
            if self.call then
                if self.cardData then
                    self.call(self.artifactData, self.cardData)
                else
                    self.call(self.artifactData)
                end
            end
            self.playEff = true
            self:Refresh()
        end
    )
end

---显示属性
function ArtifactDevelop_UpLevelPanel:ShowProp()
    if not self.initprop then
        self.initprop=true
        self.go_table.scrollloopvectical_Prop:InitItemData(0,_G.handler(self,self.RefreshItem))
    end
    if table.isEmptyOrNil(self.artifactData) then
        self.go_table.scrollloopvectical_Prop:UpdateCount(0)
        return
    end
    if not self.propList then
        self.lvTb = GetAutoGoTable(self.go_table.obj_Prop)
        self.propList = {}
        for _, v in pairs(_G.AttrType) do
            if v.proptype == 1 then
                _G.table.insert(self.propList, {type = v})
            end
        end
        _G.table.sort(
            self.propList,
            function(a, b)
                return a.type.sortid < b.type.sortid
            end
        )
    end
    local lv = self.artifactData:GetLevel()
    local next = self.upLevel + self.artifactData:GetLevel()
    local isMax = lv == self.maxLevel
    self.lvTb.aortext_curValue.text = lv
    self.lvTb.aortext_nextValue.text = isMax and _G.GetLangPackValue(9002050021) or next
    self.go_table.scrollloopvectical_Prop:UpdateCount(#self.propList)
end

function ArtifactDevelop_UpLevelPanel:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    index = index + 1
    self.propList[index].tb = GetAutoGoTable(obj)
    self.propList[index].tb.aorimage_di:SetActiveE(index % 2 == 0 and 0 or 1)
    self.propList[index].tb.aortext_propName.text = self.propList[index].type.des
    local lv = self.artifactData:GetLevel()
    local isMax = lv == self.maxLevel
    local next = isMax and lv or self.upLevel + self.artifactData:GetLevel()
    local Attribute = self.artifactData:GetAttribute()
    local NextAttribute = self.artifactData:GetTempUPProp(next)
    local data = self.propList[index]
    local tb = data.tb
    tb.aortext_curValue.text = _G.GameUtil.NumberToUnitStrBag(
            _G.GameUtil.FormatNum(_G.Mathf.RoundToInt(Attribute:GetValueByName(data.type.key)))
    )
    tb.aortext_nextValue.text =
        isMax and _G.GetLangPackValue(9002050021) or
                _G.GameUtil.NumberToUnitStrBag(
                        _G.GameUtil.FormatNum(_G.Mathf.RoundToInt(NextAttribute:GetValueByName(data.type.key)))
                )
end

function ArtifactDevelop_UpLevelPanel:OnDisPose()
    self:RemoveListener(_G.eItemUpdata.Updata, self.OnItemUpdate, self)
end

---按钮点击事件在这里派发
function ArtifactDevelop_UpLevelPanel:OnClickBtn(go)
    if go == self.go_table.aorbtn_up then
        self:OnUpLevel()
    elseif go == self.go_table.aorbtn_autoUp then
        self:OnAutoUpLevel()
    elseif go == self.go_table.aorbtn_clickConsume then
        require "CommonTipManager":GetInstance():OpenTip(go, self.consumeResList[2][1])
    end
end

return ArtifactDevelop_UpLevelPanel
