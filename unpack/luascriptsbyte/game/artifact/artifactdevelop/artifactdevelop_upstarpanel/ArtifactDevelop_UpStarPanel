function ArtifactDevelop_UpStarPanel:Awake()
    self.go_table = GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.scrollloopvectical_propList:InitItemData(0, _G.handler(self, self.RefreshPropItem))
    self.artifactitemList = {}
    self.consumeItem = {}
end

---显示界面
---@param data ArtifactData
function ArtifactDevelop_UpStarPanel:Show(data, cardData, call)
    self.go_table.aorrawimage_nowearArtifact:SetActiveE(table.isEmptyOrNil(data) and 1 or 0)
    if self.cardData and self.cardData.uid==cardData.uid then
        if not self.lastPower then
            self.lastPower = self.cardData.power
        end
    else
        self.cardData = cardData
        self.lastPower = self.cardData.power
    end
    if not table.isEmptyOrNil(data) then
        self.artifactData = data
        self.call = call
        ---@type artifact_star_cfg
        self.starCfg = _G.ConfigManager.artifact_star_cfg[100 + self.artifactData.star]

        local isMax = self.artifactData.cfg.Star == self.artifactData.star
        self.go_table.aorbtn_up:SetActiveE(isMax and 0 or 1)
        self.go_table.obj_max:SetActiveE(isMax and 1 or 0)
        self.go_table.trans_remainsRoot:SetActiveE(isMax and 0 or 1)
        --ZHJH-7019 取消显示该提示词
        --self.go_table.aortext_tips:SetActiveE(isMax and 0 or 1)
        self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(
                _G.ConfigManager.redpoint_cfg.ArtifactUpgrade.id,
                self.artifactData.uid * 10 + 2
        )
        self.go_table.obj_redpoint2:UpdateRedPointItemIDAndParam(
                _G.ConfigManager.redpoint_cfg.ArtifactUpgrade.id,
                self.artifactData.uid * 10 + 2
        )
    else
        self.artifactData = nil
        self.go_table.aorbtn_up:SetActiveE(0)
        self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(
                _G.ConfigManager.redpoint_cfg.ArtifactUpgrade.id,
                0
        )
        self.go_table.obj_redpoint2:UpdateRedPointItemIDAndParam(
                _G.ConfigManager.redpoint_cfg.ArtifactUpgrade.id,
                0
        )
    end
    if not self.skillExtendText then
        self.skillExtendText = self.go_table.obj_skillDesc1:GetComponentE(_G.typeof(_G.CS.ExtendText))
    end
    self.materialList = {}
    self:UpdateSkillDesc()
    self:InitArtifactItem()
    self:UpdateProp()
end
function ArtifactDevelop_UpStarPanel:Refresh()
    self.starCfg = _G.ConfigManager.artifact_star_cfg[100 + self.artifactData.star]

    local isMax = self.artifactData.cfg.Star == self.artifactData.star
    self.go_table.aorbtn_up:SetActiveE(isMax and 0 or 1)
    self.go_table.obj_max:SetActiveE(isMax and 1 or 0)
    self.go_table.trans_remainsRoot:SetActiveE(isMax and 0 or 1)
    --ZHJH-7019 取消显示该提示词
    --self.go_table.aortext_tips:SetActiveE(isMax and 0 or 1)
    self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(
            _G.ConfigManager.redpoint_cfg.ArtifactUpgrade.id,
            self.artifactData.uid * 10 + 2
    )
    self.go_table.obj_redpoint2:UpdateRedPointItemIDAndParam(
            _G.ConfigManager.redpoint_cfg.ArtifactUpgrade.id,
            self.artifactData.uid * 10 + 2
    )
    if not self.skillExtendText then
        self.skillExtendText = self.go_table.obj_skillDesc1:GetComponentE(_G.typeof(_G.CS.ExtendText))
    end
    self.materialList = {}
    self:UpdateSkillDesc()
    self:InitArtifactItem()
    self:UpdateProp()
end

---显示神器物体
function ArtifactDevelop_UpStarPanel:InitArtifactItem()
    if  self.artifactData==nil  then
        self.go_table.trans_remainsRoot:SetActiveE(0)
    else
        if self.artifactData.cfg.Star == self.artifactData.star then
            self.go_table.trans_artifactRoot:ClearChildren()
            return
        end
        --self.go_table.trans_remainsRoot:ClearChildren()
        --local datas = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Artifact, _G.ArtifactType.NoWear)
        --local count = 0
        local needCount = self.starCfg.materials_oneself
        self.needCount = needCount
        self.list = require("ArtifactModel"):GetInstance():GetStarUpMaterial(
                self.artifactData,
                self.materialList,
                self.needCount
        )
        self:UpdateMaterial(self.list.select)
        local tb = _G.GetAutoGoTable(self.go_table.obj_material, _G.handler(self, self.OpenSelectView))
        tb.aorimage_Color.SpriteName = _G.EquipItemIconName[_G.ConfigManager.artifact_cfg[self.artifactData.sid].Order + 4]
        tb.aorrawimage_Icon:LoadImage(_G.StorageManager:GetItemIcon(self.artifactData.sid))
    end
end
---更新技能显示
function ArtifactDevelop_UpStarPanel:UpdateSkillDesc()
    if self.artifactData==nil then
        self.skillExtendText.text = ""
        self.go_table.trans_skill:SetActiveE(0)
        return
    end
    if self.artifactData.star >= self.artifactData.cfg.Star then
        self.skillExtendText.text = ""
        self.go_table.trans_skill:SetActiveE(0)
    else
        local str = require("ArtifactModel").GetStarSkillDes(self.artifactData.sid, self.artifactData.star + 1)
        if str ~= "" then
            self.skillExtendText.text = _G.string.gsub(str, "5bdf99", "15874B")
            self.go_table.trans_skill:SetActiveE(1)
            self.skillExtendText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))
        else
            self.skillExtendText.text = ""
            self.go_table.trans_skill:SetActiveE(0)
        end
    end
end

function ArtifactDevelop_UpStarPanel:UpdateMaterial(list)
    self.materialList = list and list or {}
    local str=""
    if #self.list.material >= self.needCount then
        str=string.format("<color=#12ac3b>%s/%s</color>", #self.list.material , self.needCount)
    else
        str=string.format("<color=#e75344>%s/%s</color>", #self.list.material , self.needCount)
    end
    self.go_table.aortext_Slider.text = str
    local canUse = 0
    for _, v in pairs(self.list.material) do
        if v.cardUid == 0 then
            canUse = canUse + 1
        end
    end
    local isEnough = #self.materialList == self.needCount
    local canUp = canUse >= self.needCount
    if canUp then
        self.go_table.obj_redpoint:SetActiveE(isEnough and 0 or 1)
        self.go_table.obj_redpoint2:SetActiveE(isEnough and 1 or 0)
    end
    self.go_table.obj_add:SetActiveE(#self.materialList < self.needCount and 1 or 0)
    self:UpdateConsumeItem()
end

function ArtifactDevelop_UpStarPanel:UpdateConsumeItem()
    self.consumeItem = {}
    for _, v in pairs(self.materialList) do
        _G.table.insert(self.consumeItem, v[3])
    end
end

function ArtifactDevelop_UpStarPanel:OpenSelectView()
    _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ArtifactSelectView.Name,
            self.artifactData,
            self.cardData,
            self.needCount,
            self.list,
            _G.handler(self, self.UpdateMaterial)
    )
end


