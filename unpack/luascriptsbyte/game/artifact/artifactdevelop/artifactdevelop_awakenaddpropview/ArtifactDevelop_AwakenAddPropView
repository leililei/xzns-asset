---@class ArtifactDevelop_AwakenAddPropView : UIBaseView    中文描述
---@field public go_table ArtifactDevelop_AwakenAddPropView_GoTable GoTable
local ArtifactDevelop_AwakenAddPropView = _G.BaseClass("ArtifactDevelop_AwakenAddPropView", _G.UIBaseView)
--_G.ArtifactDevelop_AwakenAddPropView = ArtifactDevelop_AwakenAddPropView

local CS = _G.CS
local typeof = _G.typeof

function ArtifactDevelop_AwakenAddPropView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["@_aorbtn_TipsClose"] = self.CloseTips,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
end

---@class params_ArtifactDevelop_AwakenAddPropView Data

---界面的入口函数
function ArtifactDevelop_AwakenAddPropView:OnCreate(arrribute, des)
    self:ShowProp(arrribute, des)
end
---设置属性
---@param data AttributeClass
function ArtifactDevelop_AwakenAddPropView:ShowProp(arrribute, des)
    local iconDic = {
        ["max_hp"] = "ui_js_sm_icon",
        ["atk"] = "ui_js_gj_icon",
        ["def"] = "ui_js_fy_icon",
        ["bre"] = "ui_js_pj_icon",
        ["hit_rate"] = "ui_js_mzl_icon",
        ["avd_rate"] = "ui_js_sbl_icon",
        ["cri_rate"] = "ui_js_bjl_icon",
        ["cri_r_rate"] = "ui_js_kbl_icon",
        ["cri_dmg"] = "ui_js_bjsh_icon",
        ["cri_dmg_r"] = "ui_js_bsjm_icon",
        ["dmg_inc"] = "ui_js_shzj_icon",
        ["psy_d_r"] = "ui_js_wsjm_icon",
        ["mag_d_r"] = "ui_js_fsjm_icon",
        ["all_speed"] = "ui_js_js_icon",
        ["pvp_dmg"] = "ui_js_pvpzs_icon",
        ["pvp_dmg_r"] = "ui_js_pvpjs_icon",
        ["recover_rate"] = "ui_js_zy_icon",
        ["recover_suffer"] = "ui_js_sy_icon",
        ["control_dec"] = "ui_js_rx_icon",
    }

    local prop = {}
    local GetValue = function(key, value, isPer)
        local num = value
        local numStr
        if _G.AttrType[key].percentage == 1 or isPer then
            num = num * 10000
            num = _G.GameUtil.FormatNum(_G.Mathf.RoundToInt(num) / 100)
            num = tostring(num) .. "%"
            numStr = num
        else
            num = _G.math.floor(num)
            num = _G.GameUtil.NumberWY(num)
            numStr = tostring(num)
        end
        return numStr
    end

    local showlist = {}
    local showProp = function(type)
        prop = arrribute:GetAttrByName(type)
        local isPer = type == _G.AttCountType.basePercent
        for i, v in pairs(prop) do
            if _G.AttrType[i] then
                _G.table.insert(showlist, { key = _G.AttrType[i], value = GetValue(i, v, isPer), sortid = _G.AttrType[i].sortid, icon = iconDic[i] })
            end
        end
    end
    for _, v in pairs(_G.AttCountType) do
        showProp(v)
    end

    SortList(
        showlist,
        function(a)
            return -a.sortid
        end
    )

    for _, v in pairs(showlist) do
        local tran = _G.InstantiateObject(self.go_table.obj_BaseProp, self.go_table.obj_PropContent)
        if tran then
            local tb = _G.GetAutoGoTable(tran)
            if v.icon then
                tb.aorimage_icon:SetActiveE(1)
                tb.aorimage_icon.SpriteName = v.icon
            else
                tb.aorimage_icon:SetActiveE(0)
            end
            tb.aortext_Name.text = v.key.des
            tb.aortext_Num.text = v.value
        end
    end

    self.go_table.obj_addDes:SetActiveE(des ~= nil and 1 or 0)
    if des ~= nil then
        self.go_table.DesExText = self.go_table.obj_addDes:GetComponentE(_G.typeof(_G.CS.ExtendText))
        self.go_table.DesExText.text = _G.GetLangPackValue(des)
        self.go_table.DesExText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))
    end
end

---点击超链接
function ArtifactDevelop_AwakenAddPropView:OnHrefClick(id, name, asa)
    local weight, height = self.go_table.obj_ArtifactlDescribe:GetRectTransformWidthHeight()
    require("CommonTipManager"):GetInstance():OpenSkillHyper(tonumber(id), nil, weight, height)
end

function ArtifactDevelop_AwakenAddPropView:CloseView()
    self:Close()
end

---按钮点击事件在这里派发
function ArtifactDevelop_AwakenAddPropView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

return ArtifactDevelop_AwakenAddPropView
