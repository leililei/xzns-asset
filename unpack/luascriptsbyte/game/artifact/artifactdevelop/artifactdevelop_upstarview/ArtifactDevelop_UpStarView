---更新技能显示
function ArtifactDevelop_UpStarView:UpdateSkillDesc()
    if self.artifactData.star >= self.artifactData.cfg.Star then
        self.skillExtendText.text = ""
        self.go_table.aortext_max.text = ""
        self.go_table.trans_skill:SetActiveE(0)
    else
        self.go_table.aortext_max.text = ""
        local str = require("ArtifactModel").GetStarSkillDes(self.artifactData.sid, self.artifactData.star + 1)
        if str ~= "" then
            self.skillExtendText.text = _G.string.gsub(str, "5bdf99", "15874B")
            self.go_table.trans_skill:SetActiveE(1)
            self.skillExtendText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))
        else
            self.skillExtendText.text = ""
            self.go_table.aortext_max.text = _G.LangUtil.GetLangPackValue(LanguageID.NoUp)
            self.go_table.trans_skill:SetActiveE(0)
        end
    end
end

function ArtifactDevelop_UpStarView:UpdateMaterial(list)
    self.materialList = list and list or {}
    self.go_table.slider_progress.value = #self.materialList / self.needCount
    self.go_table.aortext_Slider.text = #self.materialList .. "/" .. self.needCount
    local canUse = 0
    for _, v in pairs(self.list.material) do
        if v.cardUid == 0 then
            canUse = canUse + 1
        end
    end
    local isEnough = #self.materialList == self.needCount
    local canUp = canUse >= self.needCount
    if canUp then
        self.go_table.obj_redpoint:SetActiveE(isEnough and 0 or 1)
        self.go_table.obj_redpoint2:SetActiveE(isEnough and 1 or 0)
    end
    self.go_table.obj_add:SetActiveE(#self.materialList < self.needCount and 1 or 0)
    self:UpdateConsumeItem()
end

function ArtifactDevelop_UpStarView:UpdateConsumeItem()
    self.consumeItem = {}
    for _, v in pairs(self.materialList) do
        _G.table.insert(self.consumeItem, v[3])
    end
end

function ArtifactDevelop_UpStarView:OpenSelectView()
    _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ArtifactSelectView.Name,
            self.artifactData,
            self.cardData,
            self.needCount,
            self.list,
            _G.handler(self, self.UpdateMaterial)
    )
end


