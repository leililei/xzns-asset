---升星
function ArtifactDevelop_UpStarView:OnUp()
    if self.artifactData.star >= self.artifactData.cfg.Star then
        return
    end
    if #self.consumeItem < self.starCfg.materials_oneself then
        local quickUseBox = _G.StorageManager:GetInstance():FastCheckItem(self.artifactData.sid, function()
            self:InitArtifactItem()
            return
        end)
        if not quickUseBox then
            _G.PopWindowManager:GetInstance():ShowAllTips(270901)
        end
        return
    end
    for _, v in pairs(self.consumeItem) do
        if v.lv > 1 or v.star > 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(271301, nil, _G.handler(self, self.DoUp))
            return
        end
    end
    self:DoUp()
end

---执行升星
function ArtifactDevelop_UpStarView:DoUp()
    local tb = {}
    local startUp = function()
        local msg = self.artifactData:GetMsg()
        msg.card_uid = self.artifactData.cardUid
        local data = _G.ArtifactData.New()
        data:ParseInitMsg(msg)
        require "ArtifactModel":GetInstance():StarUp(
                self.artifactData.uid,
                self.artifactData.cardUid,
                tb,
                self.artifactData.uid ~= self.artifactData.sid,
                function(msg2)
                    if msg2.ack ~= 1 then
                        return
                    end
                    for _, v in pairs(self.consumeItem) do
                        _G.StorageManager:GetInstance():ConsumeItem(v.sid, v.uid, 1)
                    end
                    if msg2.uid then
                        self.artifactData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Artifact, msg2.uid)
                    end
                    --清空之前保存的材料信息
                    require("ArtifactModel"):GetInstance().MaterialList = nil
                    _G.UIManager:GetInstance():OpenWindow(
                            _G.ConfigManager.ui_cfg.DecorationUpView.Name,
                            data,
                            self.artifactData,
                            2,
                            function()
                                if msg2.award then
                                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg2)
                                end
                            end
                    )
                    if self.cardData then
                        require "CardInfoManager":GetInstance():Updata_CardViewUpdataFun(self.cardData, true)
                        local curPower = self.cardData.power
                        if self.lastPower < curPower then
                            require "CommonTipManager".OpenPowerUpView(self.lastPower, curPower - self.lastPower)
                        end
                        self.lastPower = curPower
                    end
                    if self.call then
                        if self.cardData then
                            self.call(self.artifactData, self.cardData)
                        else
                            self.call(self.artifactData)
                        end
                    end
                    self:Show()
                end
        )
    end
    local needTakeList = {}
    for _, v in pairs(self.consumeItem) do
        if v.cardUid ~= 0 then
            --已装备的先脱再消耗
            _G.table.insert(needTakeList, v.cardUid)
        end
        if not tb[v.uid] then
            -- body
            tb[v.uid] = {uid = v.uid, num = 0}
        end
        tb[v.uid].num = tb[v.uid].num + 1
    end
    tb = _G.table.toArray(tb)
    if #needTakeList > 0 then
        self:TakeOffArtifact(needTakeList, startUp)
    else
        startUp()
    end
end

---更新属性
function ArtifactDevelop_UpStarView:UpdateProp()
    local arrribute = self.artifactData:GetAttribute()
    local star = _G.math.min(self.artifactData.star + 1, self.artifactData.cfg.Star)
    local nextAttribute = self.artifactData:GetTempUPProp(nil, star)
    local prop = arrribute:GetAttrByName()
    self.propList = {}
    local GetValue = function(key, value, isPer)
        local num = value
        local numStr
        if _G.AttrType[key].percentage == 1 or isPer then
            num = num * 10000
            num = _G.GameUtil.FormatNum(_G.Mathf.RoundToInt(num) / 100)
            num = tostring(num) .. "%"
            numStr = num
        else
            num = _G.math.floor(num)
            num = _G.GameUtil.NumberWY(num)
            numStr = tostring(num)
        end
        return numStr
    end

    local showProp = function(type)
        prop = arrribute:GetAttrByName(type)
        local isPer = type == _G.AttCountType.basePercent
        for i, v in pairs(prop) do
            if _G.AttrType[i] then
                _G.table.insert(
                    self.propList,
                    {
                        name = _G.AttrType[i].des,
                        value = GetValue(i, v, isPer),
                        nextValue = GetValue(i, nextAttribute:GetValueByName(i, type), isPer),
                        sort = isPer and _G.AttrType[i].sortid + 10 or _G.AttrType[i].sortid
                    }
                )
            end
        end
    end
    for _, v in pairs(_G.AttCountType) do
        showProp(v)
    end
    _G.SortList(
        self.propList,
        function(a)
            return -a.sort
        end
    )
    --if self.artifactData.star >= self.artifactData.cfg.Star then
    --    self.go_table.scrollloopvectical_propList:SetActiveE(0)
    --    self.go_table.scrollloopvectical_maxPropList:SetActiveE(1)
    --    self.go_table.scrollloopvectical_maxPropList:UpdateCount(#self.propList)
    --else
    ---ZHJH-5791修改满星后属性显示
    self.go_table.scrollloopvectical_propList:SetActiveE(1)
    self.go_table.scrollloopvectical_maxPropList:SetActiveE(0)

    self.go_table.scrollloopvectical_propList:UpdateCount(#self.propList)
    --end
end
---刷新属性显示
function ArtifactDevelop_UpStarView:RefreshPropItem(index, obj)
    local tb = GetAutoGoTable(obj)
    if self.artifactData.star >= self.artifactData.cfg.Star then
        self.propList[index + 1].nextValue = _G.GetLangPackValue(90022300065)
    end
    tb.aortext_propName.text = self.propList[index + 1].name
    tb.aortext_curValue.text = self.propList[index + 1].value
    if tb.aortext_nextValue then
        tb.aortext_nextValue.text = self.propList[index + 1].nextValue
    end
    --tb.aorimage_di:SetActiveE((index + 1) % 2)
end
