---显示界面
---@param data ArtifactData
function ArtifactDevelop_UpStarView:Show(data, cardData, call)
    if data then
        self.artifactData = data
        self.cardData = cardData
        self.call = call
        if self.cardData then
            self.lastPower = self.cardData.power
        end
    end
    ---@type artifact_star_cfg
    self.starCfg = _G.ConfigManager.artifact_star_cfg[100 + self.artifactData.star]
    if not self.skillExtendText then
        self.skillExtendText = self.go_table.obj_skillDesc1:GetComponentE(_G.typeof(_G.CS.ExtendText))
    end
    self.materialList = {}
    self:UpdateArtifactInfo()
    self:UpdateSkillDesc()
    self:InitArtifactItem()
    self:UpdateProp()
    local isMax = self.artifactData.cfg.Star == self.artifactData.star
    self.go_table.aorbtn_up:SetActiveE(isMax and 0 or 1)
    self.go_table.obj_max:SetActiveE(isMax and 1 or 0)
    self.go_table.trans_remainsRoot:SetActiveE(isMax and 0 or 1)
    --ZHJH-7019 取消显示该提示词
    --self.go_table.aortext_tips:SetActiveE(isMax and 0 or 1)
    self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(
        _G.ConfigManager.redpoint_cfg.ArtifactUpgrade.id,
        self.artifactData.uid * 10 + 2
    )
    self.go_table.obj_redpoint2:UpdateRedPointItemIDAndParam(
            _G.ConfigManager.redpoint_cfg.ArtifactUpgrade.id,
            self.artifactData.uid * 10 + 2
    )
end

function ArtifactDevelop_UpStarView:UpdateArtifactInfo()
    self.go_table.aorrawimage_artifact:LoadImage(self.artifactData:GetIconPath())
    self.go_table.aorrawimage_artifact:SetNativeSize()
    self.go_table.aortext_name.text = self.artifactData:GetName()
    local order = self.artifactData:GetOrder() + 4
    if order == 7 then
        order = 8
    end
    local ctm = require("CommonTipManager"):GetInstance()
    ctm:SetItemTextGradient(self.go_table.aortext_name, order)
    self.go_table.aortext_name:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor =
    _G.ColorTools.FormatColorByString(ctm:GetTipTypeNameOutLineColorByGrade(order))
    local CardInfoManager = require("CardInfoManager"):GetInstance()
    local SpriteName
    for i = 1, 5 do
        SpriteName = CardInfoManager:GetHuoSpriteName(self.artifactData:GetStar(), i)
        self.go_table["aorimage_star" .. i].SpriteName = SpriteName
        self.go_table["aorimage_star" .. i]:SetActiveE(SpriteName and 1 or 0)
    end
end

