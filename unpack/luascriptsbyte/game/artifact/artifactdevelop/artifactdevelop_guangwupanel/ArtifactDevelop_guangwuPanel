    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 1030)
end

function ArtifactDevelop_guangwuPanel:Cradzuo()
    if self.NowPutSkinIndex - 1 >= 0 then
        local artifactskincfg=_G.ConfigManager.artifact_skin_cfg[self.skindic[self.NowPutSkin[self.NowPutSkinIndex - 1]]]
        if (not artifactskincfg and self.NowPutSkinIndex - 1~=0 ) or table.isEmptyOrNil(artifactskincfg.ui_form_effect) then
            _G.PopWindowManager:GetInstance():ShowAllTips(271803)
            return
        end
        self:ShowNew(self.NowPutSkinIndex - 1)
    else
        local artifactskincfg=_G.ConfigManager.artifact_skin_cfg[self.skindic[self.NowPutSkin[#self.NowPutSkin]]]
        if not artifactskincfg or table.isEmptyOrNil(artifactskincfg.ui_form_effect) then
            _G.PopWindowManager:GetInstance():ShowAllTips(271803)
            return
        end
        self:ShowNew(#self.NowPutSkin)
    end
end

function ArtifactDevelop_guangwuPanel:You()
    if self.NowPutSkinIndex + 1 > #self.NowPutSkin then
        self:ShowNew(0)
    else
        local artifactskincfg=_G.ConfigManager.artifact_skin_cfg[self.skindic[self.NowPutSkin[self.NowPutSkinIndex + 1]]]
        if not artifactskincfg or table.isEmptyOrNil(artifactskincfg.ui_form_effect) then
            _G.PopWindowManager:GetInstance():ShowAllTips(271803)
            return
        end
        self:ShowNew(self.NowPutSkinIndex + 1)
    end
end
