function ArtifactDevelop_guangwuPanel:SetSortOrder()
    local base = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.CardShowView.Name)
    if not base then
        base = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.PreviewCardShowView.Name)
    end
    if base then
        _G.UIUtils.SetCanvasSortingOrder(self.gameObject, base.gameObject)
    end
end
function ArtifactDevelop_guangwuPanel:RefreshPropItem(index, obj)
    local tb = _G.GetAutoGoTable(obj)
    if self.propList[index + 1].unlock then
        tb.aortext_propName.color=_G.ColorTools.FormatColorByString("368845")
        --tb.aortext_nextValue.color=_G.ColorTools.FormatColorByString("368845")
    else
        tb.aortext_propName.color=_G.ColorTools.FormatColorByString("343A48")
        --tb.aortext_nextValue.color=_G.ColorTools.FormatColorByString("343A48")
    end
    tb.aorimage_di:SetActiveE(self.yulanstage==index+1 and 1 or 0)
    tb.aorimage_suo:SetActiveE(self.propList[index + 1].unlock and 0 or 1)
    tb.aortext_propName.text = (self.NowPutSkinIndex==0 and index==0) and _G.GetLangPackValue(25531080013) or self.propList[index + 1].condition
    tb.aortext_nextValue.text = self.propList[index + 1].name
    tb.aorimage_bg.SpriteName=StagebgName[index+1]
end
function ArtifactDevelop_guangwuPanel:InitShowstage()
    self.propList={}
    for i = 1, #self.artifactCfg.form_name do
        local condition=""
        if self.artifactCfg.form_name[i][1]==0 then
            condition=_G.GetLangPackValue(90000012069)
        else
            condition=_G.GetLangPackValue(90000012070,self.artifactCfg.form_name[i][1])
        end
        local unlock=ArtifactIllustrationModel:CheckIsUnLockArtifactStage(self.artifactCfg.id,self.artifactCfg.form_name[i][1])
        table.insert(self.propList,
                {star=self.artifactCfg.form_name[i][1],condition=condition,name=_G.GetLangPackValue(self.artifactCfg.form_name[i][2]),
                 unlock=self.jumpSkinId~=nil and 1 or unlock})
    end
end

function ArtifactDevelop_guangwuPanel:CardSid(id, skinId)
    local data, skin = CardCommentManager:CardData(skinId, true)
    self.CradSid = CardCommentManager:CradSid(id, skinId)
    local haveSkin=self:HaveSkinDicIs(skinId)
    local haveArtifactSkin=ArtifactIllustrationModel:ChectIsHasArtifactSkinByCardData(self.CardData.sid,self.skindic[skinId] and self.skindic[skinId] or self.CardData.sid)
    local unlock = haveSkin and haveArtifactSkin
    --self.desc = data.card_title
    local str = 2
    if  unlock and  (self.CradSid or id == skinId)   then
        if self:CardWearSkinIs(skinId) then
            str = 4
        else
            str = 1
        end
    else
        if skin and skin.way > 0 then
            self.CaedBtn = false
            self.CradNum = skin.way
        else
            self.CaedBtn = true
            self.CradNum = 0
        end
    end

    if self.Params.UI.Btn[str] then
        --- 如果有jumpId 说明是跳转皮肤过来的，此时只在可以去获得的时候展示按钮
        if self.jumpSkinId ~= nil then
            --self.go_table.aorbtn_btn:SetActiveE(str == 2 and 1 or 0)
        end
        self.go_table.aortext_btn.text = language_package_cfg[self.Params.UI.Btn[str].langId]
        self.go_table.aorimage_btn:SetGray(self.Params.UI.Btn[str].isGray)
        self.go_table.aorimage_btn.color = _G.ColorTools.FormatColorByString(self.Params.UI.Btn[str].isGray and "A9A9A9" or
            "FFFFFF")
        self.go_table.aortext_btn.color = _G.ColorTools.FormatColorByString(self.Params.UI.Btn[str].isGray and "434343" or
            "8C2D14")
    end
end

