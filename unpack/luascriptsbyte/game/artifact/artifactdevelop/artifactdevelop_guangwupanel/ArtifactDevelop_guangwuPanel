function ArtifactDevelop_guangwuPanel:Btn()
    ---是否已解锁，解锁后可替换穿戴
    local sid = self.NowPutSkinIndex == 0 and self.CardData.cfg.id or self.NowPutSkin[self.NowPutSkinIndex]
    local unlockArtifact=ArtifactIllustrationModel:CheckArtifactIsUnLockById(self.CardData.cfg.artifactid)
    local unlockskin = self:HaveSkinDicIs(sid) 
    local unlockArtifactSkin=ArtifactIllustrationModel:ChectIsHasArtifactSkinByCardData(self.CardData.sid,self.skindic[sid] and self.skindic[sid] or self.CardData.sid)
    if unlockArtifact and unlockskin and unlockArtifactSkin then
        if not self:CardWearSkinIs(sid) then
            self:OnClick_sure()
        end
    elseif not unlockArtifact then
        local data=_G.StorageManager:GetInstance():GetDataByID(209060002)
        if not table.isEmptyOrNil(data) then
            self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnOpenUI, self)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BagNewView.Name, 1)
            return
        end
        _G.PopWindowManager:GetInstance():ShowAllTips(271801)
        return
    elseif not unlockskin then
        -- ZHJH-9040 通过item的way显示皮肤的获取路径
        local skinItemSid = _G.ConfigManager.skin_cfg[self.skindic[sid]].item
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, skinItemSid)
    else
        -- ZHJH-9040 通过item的way显示皮肤的获取路径
        local skinItemSid = _G.ConfigManager.artifact_skin_cfg[self.skindic[sid]].item
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, skinItemSid)
    end
end
function ArtifactDevelop_guangwuPanel:OnOpenUI(name)
    if name == _G.ConfigManager.ui_cfg.BagNewView.Name then
        self:RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnOpenUI, self)
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.BagNewView.Name)
        view:OnClickToggle(nil, true, 1)
        view.go_table.toggle_prop.isOn = true
    end
end
function ArtifactDevelop_guangwuPanel:yulan()
    local trans=self.go_table.obj_miniSpine:GetChildE(0)
    if not self.yulanstage then
        self.yulanstage=ArtifactIllustrationModel:GetNowArtifactStage(self.artifactCfg.id)+1
    else
        if self.yulanstage==table.count(self.artifactCfg.form_name) then
            self.yulanstage=ArtifactIllustrationModel:GetNowArtifactStage(self.artifactCfg.id)
        else
            self.yulanstage=self.yulanstage+1
        end
    end
    if self.skinid==self.CardData.sid then
        _G.UIUtils.LoadArtifacteffect(trans,nil ,self.artifactCfg.skin[1],self.yulanstage-1)
    else
        _G.UIUtils.LoadArtifacteffect(trans,nil ,self.skindic[self.skinid],self.yulanstage-1)
    end
    self:ShowyulanText()
end
function ArtifactDevelop_guangwuPanel:ShowyulanText()
    local nextyulan=self.yulanstage
    self.go_table.aortext_yulan.text=_G.GetLangPackValue(self.artifactCfg.form_name[nextyulan][2])
    if not self.yulanpoint then
        self.yulanpoint={}
        for i = 1, #self.artifactCfg.form_name do
            local obj=_G.InstantiateObject(self.go_table.obj_stagepointitem,self.go_table.obj_stagecontent)
            obj:SetActiveE(1)
            local itemtab=_G.GetAutoGoTable(obj)
            table.insert( self.yulanpoint,itemtab)
        end
    end
    for i = 1, #self.yulanpoint do
        self.yulanpoint[i].obj_stagelight:SetActiveE(i==nextyulan and 1 or 0)
    end
    self.go_table.scrollloopvectical_propList:UpdateCount(#self.propList)
end

function ArtifactDevelop_guangwuPanel:StartLoadRoleScene()
    local str
    if self.NowPutSkinIndex == 0 then
        str = self.CardData.sid
        self.skinid = nil
    else
        str = self.NowPutSkin[self.NowPutSkinIndex]
        self.skinid = str
    end
    self:CardSid(self.CardData.sid, str)
    if self.str == str then
        return
    end

    -- local tWindow = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.CardShowView.Name)
    -- if tWindow == nil then
    --     -- 可能是预览界面
    --     tWindow = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.PreviewCardShowView.Name)
    -- end
    -- if tWindow ~= nil then
    --     tWindow:StartLoadRoleScene(self.CardData, str, _G.handlerbind(self, self.Shou))
    -- end
    self:Shou(str)
end

function ArtifactDevelop_guangwuPanel:Shou(ca, call)
    if ca and (self.skinid == nil or self.skinid~=ca ) then
        self.skinid = ca
    elseif self.skinid == self.CardData.sid then
        -- body
        self.skinid = nil
    end
    if self.skinid == nil then
        return
    end
    local cfg = self.skinid == self.CardData.sid and _G.ConfigManager.card_cfg[self.skinid] or
        _G.ConfigManager.skin_cfg[self.skinid]
    if not cfg then
        return
    end

    if _G.AppSetting.IsXzns then
        self.go_table.obj_miniSpine:ClearChildren()
        if cfg.Order == 1 then
            self.go_table.obj_miniSpine:SetActiveE(0)
        else
            self.go_table.obj_miniSpine:SetActiveE(1)
            local path = cfg.spine and cfg.spine[1] or cfg.ModelPathHi
            _G.PoolsManager:GetInstance():Spawn(
                path,
                _G.ePoolType.Temporary,
                self.go_table.obj_miniSpine,
                function(obj)
                    if not self.go_table then
                        _G.DestroyObject(obj)
                        return
                    end
                    obj:SetLocalScaleXYZ(1.6)
                    local sg = obj:GetChildE(0):GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
                    sg.AnimationState:SetAnimation(0, "stand_2", true)

                    --- 只有星座女神有神环
                    if _G.AppSetting.IsXzns then
                        local godHaloID = _G.PlayerModel:GetInstance():IsCardWearGodHalo(cfg.id)
                        if godHaloID ~= 0 then
                            local effCfg = _G.ConfigManager.god_halo_cfg[godHaloID].ui_effect_cfg
                            --- 神环路径，父级路径(加载角色的下面)
                            _G.UIUtils.LoadGodHalo(effCfg, obj, godHaloID)
                        end
                        local stage=ArtifactIllustrationModel:GetNowArtifactStage(self.artifactCfg.id)
                        if self.jumpSkinId~=nil then
                            stage=table.count(self.artifactCfg.form_name)
                            self.yulanstage=stage
                            self.go_table.scrollloopvectical_propList:UpdateCount(#self.propList)
                        else
                            self.yulanstage=ArtifactIllustrationModel:GetNowArtifactStage(self.artifactCfg.id)
                            self:ShowyulanText()
                        end
                        if self.skinid==self.CardData.sid then
                            _G.UIUtils.LoadArtifacteffect(obj,nil ,self.artifactCfg.skin[1],stage-1)
                        else
                            _G.UIUtils.LoadArtifacteffect(obj,nil ,self.skindic[self.skinid],stage-1)
                        end
                    end
                end
            )
        end
    end
    if call then
        call(cfg)
    end
end

---@param CardData CardData
function ArtifactDevelop_guangwuPanel:Show(CardData,jumpSkinId)
    self.jumpSkinId = jumpSkinId
    self.go_table.obj_WearEffect:SetActiveE(0)
    self.go_table.obj_TeamEffect:SetActiveE(0)
    self.skinid = nil
    if self.CardData and self.CardData.sid == CardData.sid then
        self.NowPutSkinIndex = 0
        if not self.skinid then
            for key, value in pairs(self.NowPutSkin) do
                if value == self.CardData.skin and ArtifactIllustrationModel:ChectIsHasArtifactSkinByCardData(self.CardData.sid,self.skindic[value])  then
                    self.NowPutSkinIndex = key
                end
            end
        end
        self.noSkin = #self.NowPutSkin == 0
    else
        ---@type CardData
        self.CardData = CardData
        local skinlist={}
        self.NowPutSkin = {}
        if _G.AppSetting.IsXzns then
            if not _G.table.isEmptyOrNil(self.CardData.cfg.skin) then
                for _, v in pairs(self.CardData.cfg.skin) do
                    local cfg = _G.ConfigManager.skin_cfg[v]
                    if cfg.skin_show and cfg.skin_show == true then
                        _G.table.insert(skinlist, v)
                    end
                end
            end
        else
            skinlist = require("CardCommentManager"):GetInstance():GetCardSkinCfgs(self.CardData.cfg) or {}
        end
        self.artifactCfg=_G.ConfigManager.artifact_cfg[CardData.cfg.artifactid]
        self.skindic={}
        if self.artifactCfg and self.artifactCfg.skin then
            local artifactskincfg=_G.ConfigManager.artifact_skin_cfg
            for i = 2, #self.artifactCfg.skin do
                if table.ContainsValue(skinlist,artifactskincfg[self.artifactCfg.skin[i]].skin_id) then
                    table.insert(self.NowPutSkin,artifactskincfg[self.artifactCfg.skin[i]].skin_id)
                    self.skindic[artifactskincfg[self.artifactCfg.skin[i]].skin_id]=self.artifactCfg.skin[i]
                end
            end
        end
        self.noSkin = #self.NowPutSkin == 0
        if self.CardData.skin ~= 0 then
            self.NowPutSkinIndex = 0
            for key, value in pairs(self.NowPutSkin) do
                if value == self.CardData.skin and ArtifactIllustrationModel:ChectIsHasArtifactSkinByCardData(self.CardData.sid,self.skindic[value]) then
                    self.NowPutSkinIndex = key
                end
            end
        else
            self.NowPutSkinIndex = 0
        end
        --_G.table.insertto(self.NowPutSkin, self.CardData.cfg.skin)

        self:CardSid(self.CardData.sid, self.NowPutSkin[1])

        self.AllPropItemDic = {}
        self.HaveSkinCount = 0
    end
    self.go_table.aorbtn_You:SetActiveE(self.noSkin and 0 or 1)
    self.go_table.aorbtn_Cradzuo:SetActiveE(self.noSkin and 0 or 1)
    --- 如果是跳转过来的 以跳转ID为准，不考虑穿戴的皮肤
    if self.jumpSkinId ~= nil then
        for key, value in pairs(self.NowPutSkin) do
            if self.jumpSkinId == self.skindic[value] then
                self.NowPutSkinIndex = key
            end
        end
    end
    self.go_table.aorbtn_yulan:SetActiveE((table.count(self.artifactCfg.form_name)==ArtifactIllustrationModel:GetNowArtifactStage(self.artifactCfg.id) 
            or self.jumpSkinId~=nil ) and 0 or 1)
    self:InitShowstage()
    self:ShowNew(self.NowPutSkinIndex)
end

