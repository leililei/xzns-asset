function ArtifactDevelop_guangwuPanel:OnClick_sure(go, isOn)
    local nowid = self.skinid
    if nowid == nil then
        nowid = 0
        if _G.AppSetting.DEBUG then
            _G.Log("未选中皮肤", "<color=red>" .. ">>>" .. "</color>")
        end
    end
    if self.skinid == self.CardData.cfg.sid or self.NowPutSkin[self.NowPutSkinIndex] == self.CardData.cfg.sid then
        nowid = 0
    end

    require("CardInfoManager").CardPutSkin(
        self.CardData.sid,
        nowid,
        function(data)
            if data.ack ~= 1 then
                --_G.GameUtil.NetAckShowTips(data.ack)
                return
            end

            _G.PopWindowManager:GetInstance():ShowAllTips(self.Params.UI.tipsId.ghcg)
            CardCommentManager:AddSid(self.CardData.sid, nowid)
            -- self.NowPutSkin = nowid
            ---@type table<number,CardData>
            local cardList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
            for _, v in pairs(cardList) do
                if v.sid == self.CardData.sid then
                    v:SetSkin(nowid)
                    -- v:GetCardSumAttr()
                end
            end
            self:ShowNew(self.NowPutSkinIndex)

            ---更换皮肤时如果是与形象同sid角色则更换形象
            if self.CardData.sid == CardCommentManager:GetBaseSidBySkin(_G.PlayerModel:GetInstance():GetRoleSid()) then
                _G.SystemSettingManager:GetInstance():UpadteRoleStyle(nowid == 0 and self.CardData.sid or nowid)
            end

            _G.Events:GetInstance():Broadcast(_G.eCardShow.CardChangeSkin, self.CardData)
            local str
            if self.NowPutSkinIndex == 0 then
                str = self.CardData.sid
                self.skinid = nil
            else
                str = self.NowPutSkin[self.NowPutSkinIndex]
                self.skinid = str
            end
            local cfg = require("CardInfoManager").GetCardSkin_ShowCfg(str, self.CardData.sid)
            local tWindow = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.CardShowView.Name)
            if tWindow == nil then
                -- 可能是预览界面
                tWindow = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.PreviewCardShowView.Name)
            end
            if tWindow ~= nil then
                tWindow:UpdateSpine(cfg)
            end
            --self:SetNowCard(self.NowPutSkinIndex)
        end
    )
end

