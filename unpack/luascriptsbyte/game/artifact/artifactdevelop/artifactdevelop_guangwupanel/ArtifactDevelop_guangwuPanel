            self.go_table.obj_WearEffect:SetActiveE(0)
        end
        ---现在后端没有全队加成，暂时屏蔽
        if skincfg and skincfg.team_base_att and #skincfg.team_base_att > 0 then
            noAtt = false
            self.go_table.aortext_title.text=_G.GetLangPackValue(90021800503)
            self.go_table.obj_AllProp2:SetActiveE(1)
            self.go_table.obj_TeamEffect:SetActiveE(1)
            self.go_table.obj_AllProp2:ClearChildren()
            self:ShowProp(skincfg.team_base_att, self.go_table.obj_AllProp2, self.AllPropItemDic)
        else
            self.go_table.aortext_title.text=_G.GetLangPackValue(25531080012)
            self.go_table.obj_AllProp2:SetActiveE(0)
            self.go_table.obj_TeamEffect:SetActiveE(0)
        end
        self.go_table.aortext_desc:SetActiveE(noAtt and 1 or 0)
        if  noAtt and self.artifactCfg.desc>0 then
            self.go_table.aortext_desc.text=_G.GetLangPackValue(self.artifactCfg.desc)
        end
        --self.CardData:SetSkin(self.NowPutSkinIndex)
    end

