    self.go_table.obj_Crad1:ClearChildren()
    self.go_table.obj_CradCount:SetActiveE(#self.NowPutSkin > 0 and 1 or 0)
    if #self.NowPutSkin == 1 then
        if num == 0 then
            ID, Card = self:SkinList(num + 1)

            if ID then
                local obj = _G.InstantiateObject(self.go_table.obj_CardItem, self.go_table.obj_Crad2)
                obj:SetLocalPositionToZero()
                self:RefreshAwardItem(Card, obj, num + 1)
            end
            -- self.go_table.obj_Crad1:ClearChildren()
        else
            ID, Card = self:SkinList(num - 1)

            if ID then
                local obj = _G.InstantiateObject(self.go_table.obj_CardItem, self.go_table.obj_Crad1)
                obj:SetLocalPositionToZero()
                self:RefreshAwardItem(Card, obj, num - 1)
            end
            -- self.go_table.obj_Crad2:ClearChildren()
        end
    elseif #self.NowPutSkin > 1 then
        local left = num - 1 < 0 and #self.NowPutSkin or num - 1
        ID, Card = self:SkinList(left)

        if ID then
            local obj = _G.InstantiateObject(self.go_table.obj_CardItem, self.go_table.obj_Crad1)
            obj:SetLocalPositionToZero()
            self:RefreshAwardItem(Card, obj, left)
        end
        local right = num + 1 > #self.NowPutSkin and 0 or num + 1
        ID, Card = self:SkinList(right)

        if ID then
            local obj = _G.InstantiateObject(self.go_table.obj_CardItem, self.go_table.obj_Crad2)
            obj:SetLocalPositionToZero()
            self:RefreshAwardItem(Card, obj, right)
        end
    end
end

---奖励显示
function ArtifactDevelop_guangwuPanel:RefreshAwardItem(Card, obj, num)
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickCard, num))
    if Card.Name then
        self.cardName = Card.Name
    else
        self.cardName = _G.ConfigManager.card_cfg[Card.card].Name
    end
    --tb.obj_Redpoint:SetActiveE(CardCommentManager:ChaXun(Card.id) and 1 or 0)
    tb.aortext_CardName.text = language_package_cfg[self.cardName]
    tb.aortext_SkinName.text = language_package_cfg[Card.name or 90020800034]
    tb.aorimage_Bg.SpriteName = Card.name and "ui_szsc_pifu_frame" or "ui_szsc_yuanpi_frame"
    -- tb.aorimage_Hei.SpriteName = Card.name and "ui_szsc_pifu_frame" or "ui_szsc_yuanpi_frame"
    if AppSetting.IsXzns then
        tb.aorrawimage_Card:LoadImage(
            Card.Photo2 and Card.Photo2 or Card.Photo,
            function(image)
                if image then
                    image:SetNativeSize()
                    image:SetActiveE(1)
                end
            end
        )
    else
        tb.aorrawimage_Card:LoadImage(
            Card.Photo,
            function(image)
                if image then
                    image:SetNativeSize()
                    image:SetActiveE(1)
                end
            end
        )
    end
    local artifactSkincfg=_G.ConfigManager.artifact_skin_cfg[self.skindic[Card.id]]
    local ishaveskineffect=true
    if not artifactSkincfg or table.isEmptyOrNil(artifactSkincfg.ui_form_effect) then
        ishaveskineffect= (not num or num==0)
    end
    local isHave = self:HaveSkinDicIs(Card.id)
    local isWear = self:CardWearSkinIs(Card.id) 
            and ArtifactIllustrationModel:ChectIsHasArtifactSkinByCardData(self.CardData.sid ,self.skindic[Card.id])
    tb.aorimage_Hei:SetActiveE((isHave and ishaveskineffect) and 0 or 1)
    tb.aorimage_Wear:SetActiveE(isWear and 1 or 0)
    if self.jumpSkinId ~= nil then
        tb.aorimage_Hei:SetActiveE(0)
        tb.aorimage_Wear:SetActiveE(0)
    end

    tb.gameObject:SetActiveE(1)
end

function ArtifactDevelop_guangwuPanel:OnClickCard(_, _, index)
    local artifactskincfg=_G.ConfigManager.artifact_skin_cfg[self.skindic[self.NowPutSkin[index]]]
    if (not artifactskincfg or table.isEmptyOrNil(artifactskincfg.ui_form_effect))and (index and  index~=0)then
        _G.PopWindowManager:GetInstance():ShowAllTips(271803)
        return
    end
    if index then
        self:ShowNew(index)
    end
end

function ArtifactDevelop_guangwuPanel:ShowProp(additions, parent, dic)
    ------ local scale = self.CurArrayData:GetStarAllAttr()
    local len = #additions

    local obj, num

    for i, v in pairs(additions) do
        ---生成属性条

        obj = _G.InstantiateObject(self.go_table.obj_propItem, parent)
        --local obj = _G.GetAutoGoTable(tb)

        -- _G.table.insert(dic, obj)

        num = _G.tonumber(v[3])
        num = _G.AttributeClassManager:GetInstance():GetShowProp(v[1], v[2], num, 0.01, 1)
        self:SetProp(
            obj,
            _G.LangUtil.GetLangPackValue(_G.ConfigManager.type_attribute_cfg[_G.AttrType[v[1]].ID].name),
            num
        )
        obj:SetActiveE(1)
    end
    len = len + 1
    for i = len, #dic do
        dic[i]:SetActiveE(0)
    end
end

