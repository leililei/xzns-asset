---查询对应id数据
function ArtifactDevelop_guangwuPanel:SkinList(num)
    local ID, Card
    if num == 0 then
        ID = self.CardData.sid
        Card = CardCommentManager:CardData(ID, false)
    elseif num < 0 then
    elseif self.NowPutSkin[num] then
        -- body
        Card = skin_cfg[self.NowPutSkin[num]]
        ID = Card.id
    end
    return ID, Card
end

---查询是否拥有该皮肤
function ArtifactDevelop_guangwuPanel:HaveSkinDicIs(num)
    if self.CardData.sid == num then
        return true
    end
    local value = CardCommentManager:CradSid(self.CardData.sid, num)

    return value
end

