---显示界面
---@param data ArtifactData
function ArtifactDevelop_AwakenView:OnCreate(data, cardData, call)
    if data then
        self.artifactData = data
        self.cardData = cardData
        self.call = call
    end

    if _G.AppSetting.DEBUG then
        Log(self.artifactData.uid, "神器Uid")
        Log(self.artifactData.sid, "神器Sid")
        Log(self.artifactData.awaken, "神器当前觉醒等级")
        Log(self.artifactData.awaken_set, "神器当前觉醒技能选择")
    end

    ---@type artifact_awaken_cfg[]
    self.AllAwaken = {}
    for _, v in pairs(_G.ConfigManager.artifact_awaken_cfg) do
        table.insert(self.AllAwaken, v)
    end

    _G.SortList(
        self.AllAwaken,
        function(a)
            return -a.star
        end
    )
    if self.AllAwaken[1].exclusive_if == 1 then
        self.curSelectSkillID = self.artifactData.cfg.skill_4_id
    else
        self.curSelectSkillID = self.AllAwaken[1].skill_id[1]
    end

