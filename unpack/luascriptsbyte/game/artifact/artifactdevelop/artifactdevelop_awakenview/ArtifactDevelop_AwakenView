    local awakevalue = canvas.sortingOrder

    canvas.sortingOrder = viewcanvas.sortingOrder + awakevalue]]

    self.go_table.obj_awakentips:SetActiveE(0)

    self.AllItems = {}

    self:ShowInfo()
end

---显示信息
function ArtifactDevelop_AwakenView:ShowInfo()
    local index = 0
    for i, v in ipairs(self.AllAwaken) do
        local choosevalue = self.artifactData:GetAwakeSkill(i)
        if self.artifactData.awaken >= i then
            index = i
            if choosevalue == 0 then
                break
            end
        else
            break
        end
    end
    index = index - 1
    if index < 0 then
        index = 0
    end
    self.go_table.scrollloopvectical_skillandattr:InitItemData(#self.AllAwaken, _G.handler(self, self.RefreshItem), index)

    self:ShowMaterial()

    local tb = _G.GetAutoGoTable(self.go_table.obj_material, _G.handler(self, self.OpenSelectView))
    tb.aorimage_Color.SpriteName = _G.EquipItemIconName[_G.ConfigManager.artifact_cfg[self.artifactData.sid].Order + 4]
    tb.aorrawimage_Icon:LoadImage(_G.StorageManager:GetItemIcon(self.artifactData.sid))

    self:UpdateProp()
end

function ArtifactDevelop_AwakenView:ShowMaterial()
    local awaken = self.artifactData.awaken

    local isMax = awaken == #self.AllAwaken
    self.go_table.aorbtn_awaken:SetActiveE(isMax and 0 or 1)
    self.go_table.obj_max:SetActiveE(isMax and 1 or 0)
    self.go_table.trans_remainsRoot:SetActiveE(isMax and 0 or 1)

    if not isMax then
        ---@type artifact_awaken_cfg
        self.artifactCfg = self.AllAwaken[awaken + 1]

        local needCount = self.artifactCfg.materials_oneself
        self.needCount = needCount
        self.list = require("ArtifactModel"):GetInstance():GetStarUpMaterial(
            self.artifactData,
            self.materialList,
            self.needCount
        )
        self:UpdateMaterial(self.list.select)
    end
end

function ArtifactDevelop_AwakenView:UpdateProp()
    local arrribute = self.artifactData:GetAwakenAttr()
    if self.artifactData.awaken == 0 then
        self.go_table.aorbtn_prop:SetActiveE(0)
    else
        self.go_table.aorbtn_prop:SetActiveE(1)
    end

    local prop = {}
    local propList = ""
    local GetValue = function(key, value, isPer)
        local num = value
        local numStr
        if _G.AttrType[key].percentage == 1 or isPer then
            num = num * 10000
            num = _G.GameUtil.FormatNum(_G.Mathf.RoundToInt(num) / 100)
            num = tostring(num) .. "%"
            numStr = num
        else
            num = _G.math.floor(num)
            num = _G.GameUtil.NumberWY(num)
            numStr = tostring(num)
        end
        return numStr
    end

    local showProp = function(type)
        prop = arrribute:GetAttrByName(type)
        local isPer = type == _G.AttCountType.basePercent
        local index = 0
        local len = _G.table.count(prop)
        for i, v in pairs(prop) do
            if _G.AttrType[i] then
                index = index + 1
                propList = propList .. _G.AttrType[i].des .. ":<color=#00721d>+" .. GetValue(i, v, isPer)
                if index < len then
                    if index % 3 == 0 then
                        propList = propList .. "</color>\n"
                    else
                        propList = propList .. ",</color>"
                    end
                else
                    if index % 3 == 0 then
                        propList = propList .. "</color>\n"
                    else
                        propList = propList .. "</color>"
                    end
                end
            end
        end
    end
    for _, v in pairs(_G.AttCountType) do
        showProp(v)
    end

    self.go_table.aortext_addDes.text = propList
end

function ArtifactDevelop_AwakenView:OpenSelectView()
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ArtifactSelectView.Name,
        self.artifactData,
        self.cardData,
        self.needCount,
        self.list,
        _G.handler(self, self.UpdateMaterial)
    )
end

function ArtifactDevelop_AwakenView:UpdateMaterial(list)
    self.materialList = list and list or {}
    self.go_table.aortext_Slider.text = #self.materialList .. "/" .. self.needCount
    local canUse = 0
    for _, v in pairs(self.list.material) do
        if v.cardUid == 0 then
            canUse = canUse + 1
        end
    end
    local isEnough = #self.materialList == self.needCount
    local canUp = canUse >= self.needCount
    if canUp then
        -- self.go_table.obj_redpoint:SetActiveE(isEnough and 0 or 1)
        -- self.go_table.obj_redpoint2:SetActiveE(isEnough and 1 or 0)
    end
    self.go_table.obj_add:SetActiveE(#self.materialList < self.needCount and 1 or 0)
    self:UpdateConsumeItem()
end

function ArtifactDevelop_AwakenView:UpdateConsumeItem()
    self.consumeItem = {}
    for _, v in pairs(self.materialList) do
        _G.table.insert(self.consumeItem, v[3])
    end
end

---刷新列表
function ArtifactDevelop_AwakenView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    index = index + 1
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.ClickAwakenSkill, index))
    --local objId = obj:GetInstanceIDE()

    for i = 1, 4 do
        tb["obj_skillbg" .. i]:SetActiveE(0)
    end
    local data = self.AllAwaken[index]

    local isSp = data.exclusive_if == 1

    local choosevalue = self.artifactData:GetAwakeSkill(index)

    if isSp then
        ---当前为专属技能
        local skillobj = tb.obj_skillbg1
        skillobj:SetActiveE(1)
        local skillid = self.artifactData.cfg.skill_4_id
        local cardskillcfg = _G.ConfigManager.card_skills_cfg[skillid]
        local icon = cardskillcfg.icon
        tb.aorrawimage_icon1:LoadImage(icon)
        --tb.aorimage_skillspbg1.SpriteName = "ui_js_skill_frame2"
        local name = cardskillcfg.name1

        tb.aorimage_skillspbg1:SetActiveE(1)
        tb.aorimage_skillbg1:SetActiveE(0)

        if self.artifactData.awaken >= index then
            tb.aorrawimage_icon1:SetGray(false)
            tb.aorimage_skillspbg1:SetGray(false)
            self:LoadSelectLoad(tb["obj_choose" .. 1], 2)
            tb.aortext_title.text = _G.GetLangPackValue(92010700005)
        else
            tb.aorrawimage_icon1:SetGray(true)
            tb.aorimage_skillspbg1:SetGray(true)
            self:HideSelectLoad(tb["obj_choose" .. 1])
            tb.aortext_title.text = _G.GetLangPackValue(92010700002)
        end

        self.AllItems[index] = { { name = name, icon = icon, desc = cardskillcfg.describe1 } }
    else
        ---普通技能
        self.AllItems[index] = {}
        for i = 1, #data.skill_id do
            local skillobj = tb["obj_skillbg" .. i]
            if skillobj then
                skillobj:SetActiveE(1)
                local id = data.skill_id[i]
                local skillcfg = _G.ConfigManager.artifact_awaken_skill[id]
                tb["aorrawimage_icon" .. i]:LoadImage(skillcfg.icon)

                tb["aorimage_skillspbg" .. i]:SetActiveE(0)
                tb["aorimage_skillbg" .. i]:SetActiveE(1)

                --tb["aorimage_skillbg"..i].SpriteName = "ui_js_skill_frame1"

                if self.artifactData.awaken >= index then
                    tb["aorimage_skillbg" .. i]:SetGray(true)
                    tb["aorrawimage_icon" .. i]:SetGray(false)
                    if choosevalue == id then
                        tb["aorimage_skillbg" .. i]:SetGray(false)
                        self:LoadSelectLoad(tb["obj_choose" .. i], 1)
                    else
                        self:HideSelectLoad(tb["obj_choose" .. i])
                    end
                else
                    tb["aorrawimage_icon" .. i]:SetGray(true)
                    tb["aorimage_skillbg" .. i]:SetGray(true)
                    self:HideSelectLoad(tb["obj_choose" .. i])
                end
                --if id == self.curSelectSkillID then
                --    self:LoadSelectLoad(tb["obj_choose" .. i],1)
                --else
                --    self:HideSelectLoad(tb["obj_choose" .. i])
                --end

                local info = { name = skillcfg.name, icon = skillcfg.icon, desc = skillcfg.describe }
                table.insert(self.AllItems[index], info)
            end
        end

        if self.artifactData.awaken >= index then
            if choosevalue > 0 then
                tb.aortext_title.text = _G.GetLangPackValue(92010700004)
            else
                tb.aortext_title.text = _G.GetLangPackValue(92010700003)
            end
        else
            tb.aortext_title.text = _G.GetLangPackValue(92010700002)
        end
    end
end

function ArtifactDevelop_AwakenView:LoadSelectLoad(obj, efftype)
    obj:SetActiveE(1)
    obj:RemoveAllChildren()
    local effname = "ef_shenqijuexing0" .. efftype
    UIUtils.LoadEffectByCfg(ConfigManager.ui_effect_cfg[effname], obj, function(eff)
        if self.go_table == nil then
            DestroyObject(eff)
        end
    end)
end

function ArtifactDevelop_AwakenView:HideSelectLoad(obj)
    obj:RemoveAllChildren()
    obj:SetActiveE(0)
end

function ArtifactDevelop_AwakenView:ClickAwakenSkill(go, isOn, index)
    local data = self.AllAwaken[index]
    local isSp = data.exclusive_if == 1
    --if isSp then
    --    --self.curSelectSkillID = self.artifactData.cfg.skill_4_id
    --    --self.go_table.scrollloopvectical_skillandattr:UpdateAllItem()
    --    return
    --end
    local name = go:GetName()
    local skillindex = 0
    if name == "@_aorbtn_skill1" then
        skillindex = 1
    elseif name == "@_aorbtn_skill2" then
        skillindex = 2
    elseif name == "@_aorbtn_skill3" then
        skillindex = 3
    elseif name == "@_aorbtn_skill4" then
        skillindex = 4
    end

    local info = self.AllItems[index][skillindex]
    self.go_table.obj_awakentips:SetActiveE(1)

    local tb = _G.GetAutoGoTable(self.go_table.obj_awakentips, _G.handlerbind(self, self.ClickOverTips, index, skillindex))

    if isSp then
        tb.aorimage_skillspbg:SetActiveE(1)
        tb.aorimage_skillbg:SetActiveE(0)
    else
        tb.aorimage_skillspbg:SetActiveE(0)
        tb.aorimage_skillbg:SetActiveE(1)
    end

    tb.aorrawimage_icon:LoadImage(info.icon)

    --tb.aortext_title.text = _G.GetLangPackValue(info.name)
    --tb.aortext_addDes.text = _G.GetLangPackValue(info.desc)
    tb.DesExText = tb.obj_addDes:GetComponentE(_G.typeof(_G.CS.ExtendText))
    tb.DesExText.text = _G.GetLangPackValue(info.desc)
    tb.DesExText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))

    local choosevalue = self.artifactData:GetAwakeSkill(index)
    local isActive = self.artifactData.awaken >= index
    local isShowBtn = isActive
    local isChoose = choosevalue == data.skill_id[skillindex]
    if isSp then
        isShowBtn = false
    end
    _G.GameUtil.SetActiveByCondition(tb.aorbtn_active, isShowBtn and (isChoose == false))
    _G.GameUtil.SetActiveByCondition(tb.aortext_isactive, not isActive)
    _G.GameUtil.SetActiveByCondition(tb.aortext_isUse, isChoose == true)
end

---点击超链接
function ArtifactDevelop_AwakenView:OnHrefClick(id, name, asa)
    require("CommonTipManager"):GetInstance():OpenSkillHyper(_G.tonumber(id), nil, 0, 200)
end

function ArtifactDevelop_AwakenView:ClickOverTips(go, isOn, index, skillindex)
    local name = go:GetName()
    if name == "@_aorbtn_overtips" then
        self.go_table.obj_awakentips:SetActiveE(0)
    elseif name == "@_aorbtn_active" then
        ---激活
        self.go_table.obj_awakentips:SetActiveE(0)
        local data = self.AllAwaken[index]
        self:SetAwakenSkill(index, data.skill_id[skillindex])
    end
end

