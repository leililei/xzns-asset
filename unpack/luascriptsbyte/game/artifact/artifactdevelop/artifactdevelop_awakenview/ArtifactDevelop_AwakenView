---觉醒卡牌
function ArtifactDevelop_AwakenView:OnUp()
    local datas = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Artifact, _G.ArtifactType.NoWear)
    local count = self.artifactCfg.materials_oneself
    local isDeveloped = false
    local star = 0
    local tb = {}
    for _, v in pairs(datas) do
        if v.sid == self.artifactData.sid and v.star == star then
            if not tb[v.uid] then
                tb[v.uid] = 0
            end
            tb[v.uid] = tb[v.uid] + 1
            if v.lv > 1 then
                isDeveloped = true
            end
            count = count - 1
            if count <= 0 then
                break
            end
        end
    end
    -- 觉醒材料不足
    if count > 0 then
        local quickUseBox = _G.StorageManager:GetInstance():FastCheckItem(self.artifactData.sid, function()
            --self:InitArtifactItem()
            self:ShowMaterial()
            return
        end)

        if not quickUseBox then
            _G.PopWindowManager:GetInstance():ShowAllTips(271001)
        end

        return
    end
    if isDeveloped then
        _G.PopWindowManager:GetInstance():ShowAllTips(271301, nil, _G.handlerbind(self, self.DoUp, tb))
    else
        self:DoUp(tb)
    end
end

--执行觉醒卡牌
--@param tb any 神器uid：数量
function ArtifactDevelop_AwakenView:DoUp(tb)
    local consumeList = {}
    for k, v in pairs(tb) do
        _G.table.insert(consumeList, { uid = k, num = v })
    end
    require "ArtifactModel":GetInstance():Awaken(
        self.artifactData.uid,
        self.artifactData.cardUid,
        consumeList,
        function(msg)
            for k, v in pairs(tb) do
                _G.StorageManager:GetInstance():ConsumeItem(self.artifactData.sid, k, v)
            end

            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.ArtifactAwakenSuccessView.Name,
                self.artifactData,
                function()
                    if msg.award then
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                    end
                end
            )

            self:ShowMaterial()

            self:UpdateProp()

            local index
            local value
            for i, v in ipairs(self.AllAwaken) do
                local choosevalue = self.artifactData:GetAwakeSkill(i)
                if self.artifactData.awaken >= i then
                    if choosevalue == 0 and #v.skill_id == 1 then
                        value = v.skill_id[1]
                        index = i
                        break
                    end
                else
                    break
                end
            end
            if index ~= nil then
                self:SetAwakenSkill(index, value)
            else
                self.go_table.scrollloopvectical_skillandattr:UpdateAllItem()
            end
            if _G.AppSetting.IsXzns then
                require("RedPointManager"):GetInstance():RefreshNode(
                    _G.ConfigManager.redpoint_cfg.ArtifactAwaken.id,
                    self.cardData.uid
                )
            end
        end
    )
end
function ArtifactDevelop_AwakenView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_awaken then
        self:OnUp()
    elseif go == self.go_table.aorbtn_prop then
        local des
        for i, v in ipairs(self.AllAwaken) do
            local isSp = v.exclusive_if == 1
            if isSp and self.artifactData.awaken >= i then
                local skillid = self.artifactData.cfg.skill_4_id
                des = _G.ConfigManager.card_skills_cfg[skillid].describe1
                break
            end
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArtifactDevelop_AwakenAddPropView.Name, self.artifactData:GetAwakenAttr(), des)
    elseif go==self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_tip then
        local id
        if _G.AppSetting.IsXzns then
            id = 1031
        else
            id = 231
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, id)
    end
end

return ArtifactDevelop_AwakenView
