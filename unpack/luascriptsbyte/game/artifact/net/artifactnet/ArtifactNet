local base = require("BaseGameNet")

---@class ArtifactNet : BaseGameNet    通信协议
local ArtifactNet = _G.BaseClass("ArtifactNet", base)
---@return ArtifactNet ArtifactNet
function ArtifactNet:GetInstance()
    return base.GetInstance(self)
end

--region ------------- 神器穿戴与养成 -------------

---穿戴神器
function ArtifactNet:PutOn(pbData, callback)
    local item = _G.ConfigManager.net_map.game_artifact_put_artifact
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

