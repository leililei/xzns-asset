function ArtifactDevelopView:OnOpenUI(name)
    if name == _G.ConfigManager.ui_cfg.BagNewView.Name then
        self:RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnOpenUI, self)
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.BagNewView.Name)
        view:OnClickToggle(nil, true, 3)
        _G.DelayDo(0.1, function()
            view.go_table.toggle_artifact.isOn = true
            view:OnClickEquipToggle(nil, true, 4)
        end)
        view.go_table.toggle_equipment.isOn = true
    end
end

function ArtifactDevelopView:OnDestroy()
    self:RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnOpenUI, self)
end

---@param data ArtifactData 测试数据
function ArtifactDevelopView:OnStartClose()
    if self.call then
        self.call(self.cardData)
    end
    if self.tweer then
        self.tweer:Kill()
        self.tweer = nil
    end
end

---显示界面
function ArtifactDevelopView:ShowView()
    self.go_table.aorrawimage_icon:LoadImage(
        self.artifactData.cfg.image_1,
        function(raw)
            if raw then
                raw:SetActiveE(1)
            end
        end
    )
    for i = 1, 2 do
        self.toggleTb[i].obj_redpoint:UpdateRedPointItemIDAndParam(
            _G.ConfigManager.redpoint_cfg.ArtifactUpgrade.id,
            self.artifactData.uid * 10 + i
        )
    end
end

return ArtifactDevelopView
