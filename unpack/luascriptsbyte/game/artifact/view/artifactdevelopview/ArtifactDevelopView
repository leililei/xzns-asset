---@class ArtifactDevelopView : UIBaseView	中文描述
---@field public go_table ArtifactDevelopView_GoTable GoTable
---@field artifactData ArtifactData 神器数据
local ArtifactDevelopView = _G.BaseClass("ArtifactDevelopView", _G.UIBaseView)

local PrefabPath = {
    awaken = "UIH5/Artifact/ArtifactDevelop/ArtifactDevelop_AwakenView",
    upLevel = "UIH5/Artifact/ArtifactDevelop/ArtifactDevelop_UpLevelView",
    upStar = "UIH5/Artifact/ArtifactDevelop/ArtifactDevelop_UpStarView"
}

---页签类型
local ToggleType = {
    UpLevel = 1,
    UpStar = 2,
    Awaken = 3
}

function ArtifactDevelopView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param data ArtifactData artifactData
function ArtifactDevelopView:OnCreate(data, cardData, call)
    self.artifactData = data
    self.cardData = cardData
    self.curToggle = ToggleType.UpLevel
    self.go_table.toggle_upLevel.isOn = false
    self.go_table.toggle_upLevel.isOn = true

    self.toggleTb = {
        _G.GetAutoGoTable(self.go_table.toggle_upLevel),
        _G.GetAutoGoTable(self.go_table.toggle_upStar)
        --self.awakenTB
    }
    self:ShowView()

    if self.artifactData.star == self.artifactData.cfg.Star and self.artifactData.cfg.card_id > 0 and (self.artifactData.cfg.display and self.artifactData.cfg.display == 1) then
        self.go_table.toggle_awaken:SetActiveE(1)
    else
        self.go_table.toggle_awaken:SetActiveE(0)
    end

    --self.go_table.toggle_awaken:SetActiveE(0)

    self.call = call
end

---觉醒
function ArtifactDevelopView:OnAwaken(isOn)
    if self.awakenView then
        self.awakenView.gameObject:SetActiveE(isOn and 1 or 0)
    end
    self.go_table.obj_realIcon:SetActiveE(1)
    if not isOn then
        return
    end
    self.go_table.aorbtn_bag:SetLocalPosition(-24000, 327, 0)
    self.go_table.aorbtn_reset:SetLocalPosition(24000, -336, 0)
    self.curToggle = ToggleType.Awaken
    if not self.awakenView then
        _G.PoolsManager:GetInstance():Spawn(
            PrefabPath.awaken,
            _G.ePoolType.Temporary,
            self.go_table.trans_view,
            function(obj)
                self.awakenView = self:AddComponent(obj, require "ArtifactDevelop_AwakenView".New())
                self.awakenView:Show(self.artifactData, self.cardData, _G.handler(self, self.UpdateArtifactData))
            end
        )
    else
        self.awakenView:Show(self.artifactData)
    end
end

---升级
function ArtifactDevelopView:OnUpLevel(isOn)
    if self.upLevelView then
        self.upLevelView.gameObject:SetActiveE(isOn and 1 or 0)
    end
    self.go_table.obj_realIcon:SetActiveE(1)
    if not isOn then
        return
    end
    self.go_table.aorbtn_bag:SetLocalPosition(-240, 327, 0)
    self.go_table.aorbtn_reset:SetLocalPosition(203, -336, 0)
    self.curToggle = ToggleType.UpLevel
    if not self.upLevelView then
        _G.PoolsManager:GetInstance():Spawn(
            PrefabPath.upLevel,
            _G.ePoolType.Temporary,
            self.go_table.trans_view,
            function(obj)
                self.upLevelView = self:AddComponent(obj, require "ArtifactDevelop_UpLevelView".New())
                self.upLevelView:Show(self.artifactData, self.cardData, _G.handler(self, self.UpdateArtifactData))
            end
        )
    else
        self.upLevelView:Show(self.artifactData, self.cardData, _G.handler(self, self.UpdateArtifactData))
    end
end

