---刷新主界面的神器对象
---@param artifactData ArtifactData
function ArtifactDevelopView:UpdateArtifactData(artifactData, cardData)
    self.artifactData = artifactData
    self.cardData = cardData

    if self.artifactData.star == self.artifactData.cfg.Star and self.artifactData.cfg.card_id > 0 and (self.artifactData.cfg.display and self.artifactData.cfg.display == 1) then
        self.go_table.toggle_awaken:SetActiveE(1)
    end
end

---按钮点击事件在这里派发
function ArtifactDevelopView:OnClickBtn(go, isOn)
    if go == self.go_table.toggle_upStar then
        self:OnUpStar(isOn)
    elseif go == self.go_table.toggle_upLevel then
        self:OnUpLevel(isOn)
    elseif go == self.go_table.toggle_awaken then
        self:OnAwaken(isOn)
    elseif go == self.go_table.aorbtn_anyClose then
        self:Close()
    elseif go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_reset then
        if self.artifactData:GetLevel() <= 1 and self.artifactData:GetStar() <= 0 then
            ---未升级或升星不可重置
            _G.PopWindowManager:GetInstance():ShowAllTips(280110)
        else
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.ResetLevelView.Name,
                self.artifactData,
                function()
                    if self:IsNil() then
                        return
                    end
                    if self.curToggle == ToggleType.UpLevel then
                        self:OnUpLevel(true)
                    elseif self.curToggle == ToggleType.UpStar then
                        self:OnUpStar(true)
                    else
                        self:OnAwaken(true)
                    end
                end
            )
        end
    elseif go == self.go_table.aorbtn_bag then
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnOpenUI, self)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BagNewView.Name, 3)
    end
end

