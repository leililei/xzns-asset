---@class ArtifactDecomposeSelectView : UIBaseView	中文描述
---@field public go_table ArtifactDecomposeSelectView_GoTable GoTable
local ArtifactDecomposeSelectView = _G.BaseClass("ArtifactDecomposeSelectView", _G.UIBaseView)

function ArtifactDecomposeSelectView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function ArtifactDecomposeSelectView:OnCreate(call, selectButton)
    self.callDeco = call
    self.isShow = false
    if _G.table.isEmptyOrNil(selectButton) then
        self.selectButton = {
            [1] = {grade = 1, isShow = false},
            [2] = {grade = 2, isShow = false},
            [3] = {grade = 3, isShow = false}
        }
    else
        self.selectButton = selectButton
    end

    self.select_obj = {
        [1] = self.go_table.aorimage_2_1,
        [2] = self.go_table.aorimage_2_2,
        [3] = self.go_table.aorimage_2_3
    }
    self:UpdateButton()
end

---按钮点击事件在这里派发
function ArtifactDecomposeSelectView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        for i = 1, #self.selectButton do
            if self.selectButton[i].isShow then
                self.isShow = true
                break
            end
        end
        if self.callDeco and self.isShow then
            self.callDeco(self.selectButton,self.isShow)
        end
        self:Close()
    elseif name == "@_aorbtn_queding" then
        for i = 1, #self.selectButton do
            if self.selectButton[i].isShow then
                self.isShow = true
                break
            end
        end
        if self.callDeco and self.isShow then
            self.callDeco(self.selectButton,self.isShow)
        end
        self:Close()
    elseif name == "@_aorbtn_1" then
        self.selectButton[3].isShow = not self.selectButton[3].isShow
        self.select_obj[1]:SetActiveE(self.selectButton[3].isShow and 1 or 0)
    elseif name == "@_aorbtn_2" then
        self.selectButton[2].isShow = not self.selectButton[2].isShow
        self.select_obj[2]:SetActiveE(self.selectButton[2].isShow and 1 or 0)
    elseif name == "@_aorbtn_3" then
        self.selectButton[1].isShow = not self.selectButton[1].isShow
        self.select_obj[3]:SetActiveE(self.selectButton[1].isShow and 1 or 0)
    end
end
function ArtifactDecomposeSelectView:UpdateButton()
    if _G.table.isEmptyOrNil(self.selectButton) then
        return
    end
    for i = 1, #self.selectButton do
        _G.GameUtil.SetActiveByCondition(self.select_obj[i], self.selectButton[i].isShow)
    end
end

return ArtifactDecomposeSelectView

