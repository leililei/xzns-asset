local ArtifactDrawUpCoinModel = require("ArtifactDrawUpCoinModel")

---@class ArtifactDrawUpPackView : UIBaseView    中文描述
---@field public go_table ArtifactDrawUpPackView_GoTable GoTable
local ArtifactDrawUpPackView = _G.BaseClass("ArtifactDrawUpPackView", _G.UIBaseView)
local StorageManager, UIUtils
function ArtifactDrawUpPackView:Awake()
    UIUtils = _G.UIUtils
    StorageManager = _G.StorageManager:GetInstance()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    ---可购买文本显示时的次数
    self.limitTimesCond = _G.ConfigManager.discrete_cfg[106208][1][1]
end

---界面的入口函数
function ArtifactDrawUpPackView:OnCreate(data, type_enum)
    self.GetJumpType = require "ActivitySynManager":GetInstance():GetChildAcitivity(10031, data:GetJumpType())
    self.ActivityID = self.GetJumpType.activityID
    if not _G.IsNil(self.go_table.obj_goldInfo) and self.go_table.obj_goldInfo:GetctiveInHierarchy() == 1 then
        ---添加要显示的货币或者资源
        local resources = _G.ConfigManager.ui_cfg.ArtifactDrawUpPackView.resources
        local newResource = {}
        for i = 1, #resources do
            if resources[i] == 106 then
                newResource[i] = ArtifactDrawUpCoinModel:GetInstance():GetCoinId(self.ActivityID)
            else
                newResource[i] = resources[i]
            end
        end
        if #newResource > 0 then
            self:AddComponent(
                self.go_table.obj_goldInfo,
                require("ResourceCompont").New(self.go_table.obj_goldInfo, newResource)
            )
        end
    end
    self:UpdateView(data, type_enum)
    -- if not _G.string.IsNullOrEmpty(data.cfg.info.icon) then
    --     self.go_table.aorrawimage_titlebg:LoadImage(
    --         "ImagesH5/" .. data.cfg.info.icon,
    --         function(raw)
    --             raw:SetNativeSize()
    --         end
    --     )
    -- end
    self:UIEffect()
end

function ArtifactDrawUpPackView:RefreshListTop(index, objGame)
    if index < 0 then
        return
    end
    local i = index + 1
    local data = self.list1[i]
    if data == nil then
        return
    end
    local itemGoTable = _G.GetAutoGoTable(objGame, _G.handlerbind(self, self.OnClick_item, data))

    itemGoTable.obj_special:SetActiveE(1)
    self:UpdateCommonItem(objGame, data, index)
end

---@param index number
function ArtifactDrawUpPackView:RefreshItem(index, objGame)
    if index < 0 then
        return
    end
    local i = index + 1
    local data = self.list2[i]
    if data == nil then
        return
    end
    local itemGoTable = _G.GetAutoGoTable(objGame, _G.handlerbind(self, self.OnClick_item, data))

    itemGoTable.obj_special:SetActiveE(0)
    self:UpdateCommonItem(objGame, data, index)
end

function ArtifactDrawUpPackView:UpdateCommonItem(obj, data, index)
    obj:SetName(index)
    ---@type ArtifactDrawUpPackView._obj_item_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.itemOnClickBtn, data))
    local limit = data.count_limit
    if self.type_enum == 2 then
        limit = data.count
    end
    local buy_num = self.typeClass:GetItemBuyTimes(data.id or data.sid, data.type_reset)
    if limit - buy_num > self.limitTimesCond then
        tb.aortext_num:SetActiveE(0)
    else
        tb.aortext_num:SetActiveE(1)
        tb.aortext_num.text = _G.LangUtil.TryGetLangValue(90021600042, limit - buy_num)
    end

    _G.GameUtil.AddDouYinIcon(tb.aorbtn_star, true, nil, nil, nil, data.consume_type == 0 and data.price or 0)

    tb.aorbtn_star:SetActiveE(limit == buy_num and 0 or 1)
    tb.obj_soldout:SetActiveE(limit == buy_num and 1 or 0)
    tb.aortext_giftname.text = data and data.name or ""
    tb.aortext_discount.text = _G.math.floor(data.discount * 0.01) .. "%"
    if data.price == 0 then
        tb.aortext_price.text = ""
        tb.aortext_price.text = _G.LangUtil.TryGetLangValue(90023900001)
    elseif data.consume_type == 0 then
        tb.aortext_price.text = ""
        _G.GameUtil.SetPriceByChannel(data.price, tb.aortext_price)
    else
        tb.aortext_price.text = data.price
        local item = _G.StorageManager:GetInstance():GetItemDataClassByCfg({ data.consume_type, data.price })
        if item then
            tb.aorrawimage_icon:LoadImage(item.Icon)
        end
    end
    tb.aorrawimage_icon:SetActiveE(data.consume_type == 0 and 0 or 1)
    local awrad = data.goods
    for i = 1, tb.obj_AwardNode:GetChildCountE() do
        _G.DestroyImmediate(tb.obj_AwardNode:GetChildE(0).gameObject)
    end
    for j = 1, #awrad do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            awrad[j],
            tb.obj_AwardNode,
            function(item)
                if not self.go_table or obj:GetName() ~= tostring(index) or tb.obj_AwardNode:GetChildCountE() > #awrad then
                    _G.DestroyImmediate(item.gameObject)
                    return
                end
                item.gameObject:SetLocalScaleXYZ(0.9)
                item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                item:ShowEffectOrder(item.cfg and item.cfg.ef_item == 1 and true or false)
            end
        )
    end
end

--- 判断特殊礼包是否能购买
function ArtifactDrawUpPackView:CheckIsCanbuy()
    local data = self.data

    if #self.model_data > 0 then
        self.spDataId = self.model_data[1].sid
        local buy_num = data.typeClass:GetItemBuyTimes(self.model_data[1].id or self.model_data[1].sid,
            self.model_data[1].type_reset)
        local limit = self.model_data[1].count_limit or self.model_data[1].count

        if buy_num >= limit then
            self.isCanBuy = false
        end

        for i = 2, #self.model_data do
            if self.spDataId > self.model_data[i].sid then
                self.spDataId = self.model_data[i].sid
                local buy_num = data.typeClass:GetItemBuyTimes(
                    self.model_data[i].id or self.model_data[i].sid,
                    self.model_data[i].type_reset)
                local limit = self.model_data[i].count_limit or self.model_data[i].count

                if buy_num >= limit then
                    self.isCanBuy = false
                end
            end
        end
    end
end

---刷新
function ArtifactDrawUpPackView:UpdateView(data, type_enum)
    --self.model_data = data.typeClass.model_cfg
    data.typeClass:ArtifactUpdateDynamicData(self.ActivityID)
    self.model_data = data.typeClass:GetModelCfgByCondition(self.ActivityID)
    self.isCanBuy = true
    self.data = data

    self:CheckIsCanbuy()

    self.typeClass = data.typeClass
    if type_enum then
        self.type_enum = type_enum
    else
        self.type_enum = 1
    end

    self:UpDateScorllView()
end

