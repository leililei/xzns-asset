---获取基本技能描述
function ArtifactIllustrationView:GetSkillDesBase(id)
    if card_skills_cfg[id] then
        return GetLangPackValue(card_skills_cfg[id].describe1)
    else
        return id
    end
end

---获取技能描述
function ArtifactIllustrationView:GetSkillDes(index, id)
    if card_skills_cfg[id] then
        return GetLangPackValue(90022300084, index, GetLangPackValue(card_skills_cfg[id].describe1))
    else
        return GetLangPackValue(90022300084, index, id)
    end
end

function ArtifactIllustrationView:ShowOrderEffect(tb, isShow)
    self:RemoveEffect(tb)
    if isShow then
        local effect = OrderEffectCfg
        _G.UIUtils.LoadEffectByCfg(
                effect,
                tb.obj_uieffect,
                function(trans)
                    if tb.obj_uieffect:GetChildCountE() > 1 then
                        _G.DestroyObject(trans)
                        return
                    end
                    trans:AddComponentE(typeof(CS.ParticleClipRect))
                end
        )
    end
end

---清楚品质特效
function ArtifactIllustrationView:RemoveEffect(tb)
    if tb.obj_uieffect:GetChildCountE() > 0 then
        for i = 1, tb.obj_uieffect:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(tb.obj_uieffect:GetChildE(0), _G.ePoolType.UIEffect)
        end
    end
end

function ArtifactIllustrationView:OnEnable()
    self.go_table.scrollloopvectical_Items:UpdateAllItem()
    self:SetBtnInfo(ArtifactQuality.All)
    self:UpdataUpBtn()
end

return ArtifactIllustrationView
