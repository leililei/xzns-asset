---界面的入口函数
function ArtifactIllustrationView:OnCreate()
    local lvcfg = {}
    for k, v in pairs(lvCfg) do
        local data = _G.DeepCopy(v)
        _G.table.insert(lvcfg, data)
    end
    _G.SortList(
        lvcfg,
        function(a)
            return -a.level_limit
        end
    )
    local maxLv = lvcfg[#lvcfg].level_limit
    self.go_table.aortext_Lv.text = "Lv." .. maxLv
    self.curArtifact = 0
    ItemFactory = _G.ItemFactory:GetInstance()
    ArtifactIllustrationModel = require "ArtifactIllustrationModel":GetInstance()
    for i = 1, 4 do
        pos[i] = {}
        pos[i].x, pos[i].y = self.go_table["aorbtn_" .. i]:GetLocalPosition()
    end
    -- self.detailTextTb = _G.GetAutoGoTable(self.go_table.obj_skillItem)
    -- self.detailText = self.detailTextTb.obj_upDes:GetComponentE(_G.typeof(_G.CS.ExtendText))
    self.career = ArtifactIllustrationModel:GetIllustrationList()
    self.ItemList = {}
    self.curList = self.career[4]
    -- self.curList = _G.table.toArray(self.career[5])
    _G.SortList(self.curList, function(data)
        return data.cfg.Order, data.cfg.card_id
    end)
    self.curindex = 1
    -- local Pos = pos[4]
    -- self.go_table.aorimage_select:SetLocalPosition(Pos.x, Pos.y, 0)
    self.go_table.scrollloopvectical_Items:InitItemData(#self.curList, _G.handler(self, self.RefreshItemList))
    local data = self.curList[self.curindex]
    self:InitView()
    --self:InitCareerBtn()
    self:UpdateArtifact(data)
    self:UpdateDetail(data)
    self:UpdateAwaken(data)
    local curdata = ArtifactIllustrationModel:GetIllLevelAddition(self.curLevel)
    self.lastProp = {
        [_G.AttrType.max_hp.key] = curdata.max_hp or 0,
        [_G.AttrType.atk.key] = curdata.atk or 0,
        [_G.AttrType.def.key] = curdata.def or 0,
        [_G.AttrType.bre.key] = curdata.bre or 0
    }

    self:UpdataUpBtn()
end

---初始化图鉴信息
function ArtifactIllustrationView:InitView()
    self.go_table.obj_Detail:SetActiveE(0)
    self.curLevel, self.curexp = ArtifactIllustrationModel:GetCurIllLevel()
    self.needExp = ArtifactIllustrationModel.needExp
    local curdata = ArtifactIllustrationModel:GetIllLevelAddition(self.curLevel)
    local tb = _G.GetAutoGoTable(self.go_table.obj_LevelInfo)
    tb.aortext_cur1.text = curdata.atk
    tb.aortext_cur2.text = curdata.bre
    tb.aortext_cur3.text = curdata.def
    tb.aortext_cur4.text = curdata.max_hp
    tb.aortext_level.text = _G.GetLangPackValue(90022300032, self.curLevel)
    tb.aortext_exp.text = self.curexp .. "/" .. self.needExp
    tb.slider_exp.value = self.curexp / self.needExp
end

---初始化职业按钮 ZHJH-5350 不显示筛选按钮红点
function ArtifactIllustrationView:InitCareerBtn()
    for i = 1, 5 do
        for k, v in pairs(self.career[i]) do
            if v.curStar < v.maxStar then
                self.go_table["obj_redpoint" .. i]:SetActiveE(1)
                break
            else
                self.go_table["obj_redpoint" .. i]:SetActiveE(0)
            end
        end
    end
end

---更新视图显示
function ArtifactIllustrationView:UpdateView()
