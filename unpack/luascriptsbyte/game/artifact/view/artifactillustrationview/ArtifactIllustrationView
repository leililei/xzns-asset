        self:SetBtnInfo(ArtifactQuality.All)
    elseif go == self.go_table.aorbtn_btn3 then
        self:SetBtnInfo(ArtifactQuality.Colour)
    elseif go == self.go_table.aorbtn_btn2 then
        self:SetBtnInfo(ArtifactQuality.Orange)
    elseif go == self.go_table.aorbtn_btn1 then
        self:SetBtnInfo(ArtifactQuality.Purple)
    elseif go == self.go_table.aorbtn_1 then
        self:ChangeList(_G.PlayerTreeID.tank)
    elseif go == self.go_table.aorbtn_2 then
        self:ChangeList(_G.PlayerTreeID.warrior)
    elseif go == self.go_table.aorbtn_3 then
        self:ChangeList(_G.PlayerTreeID.master)
    elseif go == self.go_table.aorbtn_4 then
        self:ChangeList(_G.PlayerTreeID.support)
    elseif go == self.go_table.aorbtn_5 then
        self:ChangeList(_G.PlayerTreeID.ranger)
    elseif go == self.go_table.aorbtn_6 then
        self:ChangeList(6)
    elseif go == self.go_table.aorbtn_CloseDetail then
        self.go_table.obj_Detail:SetActiveE(0)
    elseif go == self.go_table.aorbtn_tips then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 89)
    elseif go == self.go_table.aorbtn_detail then
        ---需要填充中间的参数(nil), 目标参数为showMaxLevel = true
        require "CommonTipManager":GetInstance():OpenTip(
            self.gameObject,
            self.curList[self.curindex].sid,
            nil,
            nil,
            true
        )
        end
end

---获取可激活和升星的灵契
function ArtifactIllustrationView:GetUpStarList()
    local sids = {}
    for _, v in pairs(self.curList) do
        if (v.unLock == 0 and v.maxStar >= 0) or (v.unLock ~= 0 and v.curStar < v.maxStar) then
            _G.table.insert(sids, v.sid)
        end
    end

    return sids
end

function ArtifactIllustrationView:OneKeyUpStar()
    local sids = self:GetUpStarList()
    if not _G.table.isEmptyOrNil(sids) then
        ArtifactIllustrationModel:UpStar(sids,
                nil,
                function(datas)
                    local curListMap = {}
                    for _, Item in pairs(self.curList) do
                        curListMap[Item.sid] = Item
                    end

                    for _, dataItem in ipairs(datas) do
                        local curListItem = curListMap[dataItem.sid]
                        if curListItem then
                            for k, v in pairs(dataItem) do
                                curListItem[k] = v
                            end
                        end
                    end

                    self.go_table.scrollloopvectical_Items:UpdateAllItem()
                    -- 更新视图
                    self:UpdataUpBtn()
                    self:InitView()
                    self:PropShow()
                end)
    end
end

function ArtifactIllustrationView:UpdataUpBtn()
    --按钮
    local sids = self:GetUpStarList()
    if not _G.table.isEmptyOrNil(sids) then
        self.go_table.obj_redpoint:SetActiveE(1)
        local color = "8C2D14"
        if _G.AppSetting.IsXzns then
            color = "50351E"
        end
        self.go_table.aortext_active.color =
        _G.ColorTools.FormatColorByString(color)
        self.go_table.aorbtn_active:SetGray(false)
        self.go_table.aorbtn_active:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
        _G.ColorTools.FormatColorByString("FFFFFF")
    else
        self.go_table.obj_redpoint:SetActiveE(0)
        self.go_table.aortext_active.color =
        _G.ColorTools.FormatColorByString("434343")
        self.go_table.aorbtn_active:SetGray(true)
        self.go_table.aorbtn_active:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
        _G.ColorTools.FormatColorByString("A9A9A9")
    end
end

