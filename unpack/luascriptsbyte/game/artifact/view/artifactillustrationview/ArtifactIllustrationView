---刷新物品列表
function ArtifactIllustrationView:RefreshItemList(index, obj)
    local x = index + 1
    local data = self.curList[x]
    local tb
    -- if self.ItemList[x] then
    --     tb = self.ItemList[x]
    -- else
    --     tb = _G.GetAutoGoTable(obj)
    --     _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickItem, tb, x, data))
    --     tb.aorrawimage_item:LoadImage(data.icon)
    --     tb.aorimage_bg.SpriteName = _G.ArtifactItemIconName[data.order]

    --     self.ItemList[x] = tb
    -- end

    tb = _G.GetAutoGoTable(obj)
    _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickItem, tb, x, data))
    tb.aorrawimage_item:LoadImage(data.icon)
    tb.aorimage_bg.SpriteName = _G.ArtifactItemIconName[data.order]

    if self.curindex == x then
        --tb.aorimage_select:SetActiveE(1)
        tb.aorimage_select:SetActiveE(0)
    else
        tb.aorimage_select:SetActiveE(0)
    end
    if data.curStar < data.maxStar then
        tb.obj_redpoint:SetActiveE(1)
    else
        tb.obj_redpoint:SetActiveE(0)
    end
    
    tb.aorimage_upstar:SetActiveE(0)
    tb.aorimage_active:SetActiveE(0)
    if data.unLock == 1 and data.curStar >= data.maxStar then
        tb.aorimage_mask:SetActiveE(0)
    else
        tb.aorimage_mask:SetActiveE(1)
    end

    if data.unLock == 0 then
        tb.aorimage_active:SetActiveE(data.maxStar >= 0 and 1 or 0)
    elseif data.curStar < data.maxStar then
        tb.aorimage_upstar:SetActiveE(1)
    end

    if data.cfg.card_id and data.cfg.card_id > 0 then
        tb.aorimage_exclusiveRole:SetActiveE(1)
        local CardCfg = _G.ConfigManager.card_cfg[data.cfg.card_id]
        if CardCfg then
            tb.aorimage_exclusiveIcon.SpriteName = CardCfg.Icon
        end
    else
        tb.aorimage_exclusiveRole:SetActiveE(0)
    end
    
    -- tb.aorrawimage_item:SetGray(data.unLock == 0)
    -- tb.aorimage_bg:SetGray(data.unLock == 0)
    local isHigh = data.curStar > 5
    tb.obj_Stars:SetActiveE(isHigh and 0 or 1)
    tb.obj_highStar:SetActiveE(isHigh and 1 or 0)
    tb.aortext_star.text = data.curStar
    for i = 1, 5 do
        tb["aorimage_Star" .. i]:SetActiveE(data.curStar >= i and 1 or 0)
    end
    self:ShowOrderEffect(tb, data.order >= 3)
    --_G.StorageManager:GetInstance():GetItemBaseViewNew()
end

---物品点击事件
function ArtifactIllustrationView:OnClickItem(go, isOn, tb, index)
    local oldindex = self.curindex
    self.curindex = index
    self.go_table.scrollloopvectical_Items:UpdateItemSingle(oldindex - 1)
    self.go_table.scrollloopvectical_Items:UpdateItemSingle(self.curindex - 1)
    self.go_table.obj_Detail:SetActiveE(1)
    local data = self.curList[self.curindex]
    local ArtifactData = require("ArtifactTipModel").New()
    ArtifactData:Init(data.sid, nil, self.go_table.gameObject)
    ArtifactData.data.star = _G.ConfigManager.artifact_cfg[data.sid].Star
    ArtifactData.data.lv = #_G.ConfigManager.artifact_level_cfg
    ArtifactData.data:UpdateAttribute()

    local showTip = function()
        if not self.tipView then
            _G.PoolsManager:GetInstance():Spawn(
                    "UIH5/Common/CommonTipView/View/$_obj_ArtifactTipView",
                    _G.ePoolType.UIItem,
                    self.go_table.obj_artifactTip,
                    function(tran)
                        if not self.go_table then
                            _G.DestroyObject(tran)
                            return
                        end
                        ---@type ArtifactTipView
                        self.tipView = self:AddComponent(tran, require("ArtifactTipView").New(tran, self))
                        self.tipView:Init(ArtifactData.data)
                        self:UpdateArtifact(data)
                        self:UpdateDetail(data)
                        self:UpdateAwaken(data)
                    end
            )
        else
            self.tipView.go_table.obj_exclusive:SetActiveE(0)
            self.tipView.gameObject:SetActiveE(1)
            self.tipView:Init(ArtifactData.data)
            self:UpdateArtifact(data)
            self:UpdateDetail(data)
            self:UpdateAwaken(data)
        end
    end

    if data.unLock == 0 and data.maxStar >= 0 then
        -- 解锁
        self:UpStar()
    elseif data.unLock == 1 and data.curStar < data.maxStar then
        -- 升星
        self:UpStar()
    else
        -- 显示TIPS
        showTip()
    end
end

function ArtifactIllustrationView:CloseTip()
    self.go_table.obj_Detail:SetActiveE(0)
end

