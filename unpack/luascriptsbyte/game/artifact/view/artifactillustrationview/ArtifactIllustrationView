---改变神器列表
function ArtifactIllustrationView:ChangeList(type)
    local Pos = pos[type]
    self.go_table.aorimage_select:SetLocalPosition(Pos.x, Pos.y, 0)
    self.curList = self.career[type]
    self.curindex = 1
    local data = self.curList[self.curindex]
    self:UpdateArtifact(data)
    self:UpdateDetail(data)
    self:UpdateAwaken(data)
    self.go_table.scrollloopvectical_Items:UpdateCount(#self.curList)
end

---神器升星
function ArtifactIllustrationView:UpStar()
    local data = self.curList[self.curindex]
    if data.curStar >= data.maxStar then
        return
    end
    local curStar = data.curStar
    ArtifactIllustrationModel:UpStar({ data.sid },
        self.curindex,
        function(data, upPower)
            self.curList[self.curindex] = data[1]
            self.go_table.scrollloopvectical_Items:UpdateItemSingle(self.curindex - 1)
            --self:InitCareerBtn()
            self:UpdateArtifact(data[1], curStar)
            self:UpdateDetail(data[1])
            self:UpdateAwaken(data[1])
            self:InitView()
            self:PropShow()
            self:UpdataUpBtn()
        end)
end

function ArtifactIllustrationView:PropShow()
    ---@type Params_View_PropUp
    local Params_View_PropUp = {}
    Params_View_PropUp.Posx = 0
    local data = ArtifactIllustrationModel:GetIllLevelAddition(self.curLevel)
    local curdata = {
        [_G.AttrType.max_hp.key] = data.max_hp,
        [_G.AttrType.atk.key] = data.atk,
        [_G.AttrType.def.key] = data.def,
        [_G.AttrType.bre.key] = data.bre
    }
    _G.UIUtils.ShowPropUp(curdata, self.lastProp,
        function()
            self.lastProp = curdata
        end,
        Params_View_PropUp)
end

function ArtifactIllustrationView:ShowSkill(data)
    local cfg = data.cfg
    if not _G.table.isEmptyOrNil(self.skillDesc) then
        for k, v in pairs(self.skillDesc) do
            _G.DestroyObject(v)
        end
    end
    self.skillDesc = {}
