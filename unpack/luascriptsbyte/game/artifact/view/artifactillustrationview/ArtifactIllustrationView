---按钮点击事件在这里派发
function ArtifactIllustrationView:OnClickBtn(go)
    local name = go:GetName()


    if go == self.go_table.aorbtn_active then
        --self:UpStar()
        self:OneKeyUpStar()
    elseif go == self.go_table.aorbtn_addition then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArtifactIllustrationLevelView.Name)
    elseif go == self.go_table.aorbtn_awake then
        self.go_table.obj_awake:SetActiveE(1)
    elseif go == self.go_table.aorbtn_hide then
        self.go_table.obj_awake:SetActiveE(0)
