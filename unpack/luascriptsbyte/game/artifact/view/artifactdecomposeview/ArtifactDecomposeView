    self.DeComposeCall = DeComposeCall
    self:UpdateData()
    self.itemList = {}
    --self.ArtifactData = StorageManager:GetDataByID(_G.StorageID.Artifact,_G.ArtifactType.NoWear)
    self.go_table.scrollloopvectical_Items:InitItemData(#self.ArtifactData,_G.handler(self,self.RefereshItemList))
end

function ArtifactDecomposeView:UpdateData()
    local data = StorageManager:GetDataByID(_G.StorageID.Artifact,_G.ArtifactType.NoWear)
    local insert = table.insert
    self.ArtifactData = {}
    self.ArtifactList = {}
    for k,v in pairs(data) do
        insert(self.ArtifactData,v)
        self.ArtifactList[v.uid] = {uid = v.uid,num = 0,order = v.cfg.Order,sid = v.sid}
    end
    _G.SortList(self.ArtifactData,
    function (a)
        return -a.cfg.Order,a.count,a.sid
    end)
end

