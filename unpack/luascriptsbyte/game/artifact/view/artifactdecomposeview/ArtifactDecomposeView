---@param isInit boolean true第一次生成 Item信息已初始化
function ArtifactDecomposeView:SetLoopItem(itemGoTable, isInit)
    if itemGoTable == nil then
        return
    end

    ---@type EquipmentItem
    local ItemData = itemGoTable.data
    ---@type ItemEquipmentBase
    local lua
    ---@type ItemViewBase
    lua = itemGoTable.lua
    itemGoTable.data = ItemData
    itemGoTable.gameObject:SetName(ItemData.uid)
    self:SetItemNum(itemGoTable)

    if itemGoTable.btnSub == nil then
        itemGoTable.aorbtn_reduce.onClick:AddListener(_G.handlerbind(self, self.ReduceItem, itemGoTable))
        itemGoTable.btnSub = true
    end
end

function ArtifactDecomposeView:SetItemNum(itemGoTable)
    local num = self.ArtifactList[itemGoTable.data.uid].num or 0
    _G.UIUtils.SetItemNum_EquItemNum(itemGoTable, num, itemGoTable.data.count)
    itemGoTable.aorbtn_reduce:SetActiveE(num > 0 and 1 or 0)
end

function ArtifactDecomposeView:OnClickItem(go,itemGoTable)
    self:Click_Item(itemGoTable)
end

function ArtifactDecomposeView:Click_Item(itemGoTable)
    ---@type EquipmentItem
    local ItemData = itemGoTable.data
    self:SelectOneItem(ItemData)
    self:SetItemNum(itemGoTable)
end

function ArtifactDecomposeView:ReduceItem(itemGoTable)
    ---@type EquipmentItem
    local ItemData = itemGoTable.data
    local num = self.ArtifactList[ItemData.uid].num
    if num <= 0 then
        return
    end

    self:SelectOneItem(ItemData, -1)
    self:SetItemNum(itemGoTable)
end

function ArtifactDecomposeView:OnLongPress_Add(tb)
    self:Click_Item(tb)
end

---选择一格装备
------@param ItemData EquipmentItem
---@return boolean false不能在选(for时判断换格)
function ArtifactDecomposeView:SelectOneItem(ItemData, num)
    local uid = ItemData.uid
    local nowNum
    --判断是否存在
    nowNum = self.ArtifactList[uid].num
    if nowNum == nil then
        nowNum = 0
    end
    if num ~= nil then
        nowNum = nowNum + num
    else
        nowNum = nowNum + 1
    end
    if nowNum > ItemData.count then
        --- 数量不可超出
        return false
    end

    self.ArtifactList[uid].num = nowNum

    if nowNum + 1 >= ItemData.count then
        --- 数量不可超出
        return false
    end

    return true
end

function ArtifactDecomposeView:Select(select,refresh)
    for k,v in pairs(self.ArtifactData) do
        if select[v.cfg.Order].isShow then
            self.ArtifactList[v.uid].num = v.count
        else
            self.ArtifactList[v.uid].num = 0
        end
    end
    if refresh then
        self.go_table.scrollloopvectical_Items:UpdateAllItem()
    end
end

---界面的销毁函数
function ArtifactDecomposeView:OnDestroy()
end

---按钮点击事件在这里派发
function ArtifactDecomposeView:OnClickBtn(go)
    if go == self.go_table.aorbtn_screen then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArtifactDecomposeSelectView.Name,
        _G.handler(self, self.Select))
    elseif go == self.go_table.aorbtn_Decompose then
        local Artifact_List = {}
        local value = false
        for k ,v in pairs(self.ArtifactList) do
            if v.num ~= 0 then
                local data= {uid = v.uid,num = v.num}
                if v.order == 3 then
                    value = true
                end
                table.insert(Artifact_List,data)
            end
        end
        if #Artifact_List == 0 then
            return
        end
        if value then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                270601,
                nil,
                _G.handlerbind(self, self.Decompose,Artifact_List)
            )
        else
            self:Decompose(Artifact_List)
        end

    elseif go == self.go_table.aorbtn_anyClose then
        self:Close()
    elseif go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

function ArtifactDecomposeView:Decompose(Artifact_List)
    ArtifactModel:Decompose(
        Artifact_List,
        function(msg)
            local StorageManager = _G.StorageManager:GetInstance()
            for k,v in pairs(self.ArtifactList) do
                StorageManager:ConsumeItem(v.sid, v.uid, v.num)
            end
            self:UpdateData()
            self.go_table.scrollloopvectical_Items:UpdateCount(#self.ArtifactData)
            if self.DeComposeCall then
                self.DeComposeCall()
            end
    end)
end

return ArtifactDecomposeView