local ArtifactTrialSkillView = _G.BaseClass("ArtifactTrialSkillView", _G.UIBaseView)
local card_skills_cfg = _G.ConfigManager.card_skills_cfg
local GetLangPackValue = _G.GetLangPackValue

---职业图标枚举
local ProfessionalEnum = _G.ProfessionalIcon

---类的析构函数
function ArtifactTrialSkillView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function ArtifactTrialSkillView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Close then
        self:Close()
    end
end

---类的析构函数
function ArtifactTrialSkillView:OnCreate(sid)
    self.artifactCfg = _G.ConfigManager.artifact_cfg[sid]

    self:SetProfession()
    self:SetSkill()
    self:SetSpSkill()
    self:SetExclusiveHead()
end

---设置神器的技能效果
function ArtifactTrialSkillView:SetSkill()
    local skills = self.artifactCfg.skill_id or {}
    local skillAmount = #skills
    if skillAmount > 0 then
        self.go_table.aortext_skill.text = require("ArtifactModel").GetStarSkillDes(self.artifactCfg.id, 0)
        _G.GameUtil.ReBuildRTF(self.go_table.obj_baseSkill)
    end

    if skillAmount > 1 then
        for i = 2, skillAmount do
            _G.PoolsManager:GetInstance():Spawn(
            "UIH5/Common/CommonTipView/View/$_obj_skillItem",
            _G.ePoolType.Temporary,
            self.go_table.trans_content,
            function(trans)
                if _G.IsNil(self.go_table.trans_content) then
                    _G.DestroyObject(trans)
                    return
                end
                local tb = _G.GetAutoGoTable(trans)
                tb.DesExText = tb.obj_upDes:GetComponentE(_G.typeof(_G.CS.ExtendText))
                tb.DesExText.text = require("ArtifactModel").GetStarSkillDes(self.artifactCfg.id, i - 1)
                tb.DesExText.color = _G.ColorTools.FormatColorByString("76DAF8")
            end
        )
        end
    end
end

---获取技能描述
function ArtifactTrialSkillView:GetSkillDes(index, id)
    if card_skills_cfg[id] then
        if not index then
            return GetLangPackValue(card_skills_cfg[id].describe1)
        else
            return GetLangPackValue(90022300084, index, GetLangPackValue(card_skills_cfg[id].describe1))
        end
    else
        return id
    end
end

---设置神器专属技能
function ArtifactTrialSkillView:SetSpSkill()
    local skills = self.artifactCfg.skill_3_id or {}
    local skillAmount = #skills
    if skillAmount > 0 then
        self.go_table.aortext_spSkill.text = self:GetSkillDes(nil, skills[1])
        _G.GameUtil.ReBuildRTF(self.go_table.obj_spSkill)
    end

    if skillAmount > 1 then
        for i = 2, skillAmount do
            _G.PoolsManager:GetInstance():Spawn(
            "UIH5/Common/CommonTipView/View/$_obj_skillItem",
            _G.ePoolType.Temporary,
            self.go_table.trans_spSkill,
            function(trans)
                if _G.IsNil(self.go_table.trans_spSkill) then
                    _G.DestroyObject(trans)
                    return
                end
                local tb = _G.GetAutoGoTable(trans)
                tb.DesExText = tb.obj_upDes:GetComponentE(_G.typeof(_G.CS.ExtendText))
                tb.DesExText.text = self:GetSkillDes(nil, skills[i])
                tb.DesExText.color = _G.ColorTools.FormatColorByString("76DAF8")
            end
        )
        end
    end
end

---设置神器对应的职业
function ArtifactTrialSkillView:SetProfession()
    local profession = self.artifactCfg.Professional
    self.go_table.aorimage_profession.SpriteName = ProfessionalEnum[profession]
end

---设置神器的专属效果对应的头像
function ArtifactTrialSkillView:SetExclusiveHead()
    local cardId = self.artifactCfg.card_id
    if cardId and cardId > 0 then
        local cardCfg = _G.ConfigManager.card_cfg[cardId]
        local icon = cardCfg.Icon
        if _G.string.contains(icon, "/") then
            icon = _G.string.split2tbl(icon, "/")
            icon = icon[#icon]
        end
        self.go_table.aorimage_cardIcon.SpriteName = icon
        self.go_table.aorimage_cardBg.SpriteName = require("CardInfoManager"):GetInstance():GetHeadBgSpriteName(nil, 7)
    else
        self.go_table.obj_card:SetActiveE(0)
    end
end

return ArtifactTrialSkillView