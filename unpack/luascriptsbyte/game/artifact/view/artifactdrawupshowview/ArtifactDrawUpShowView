--region debug模式
---debug模式, 开启后打开页面将依次遍历配置展示所有神器
local DEBUG_MODE = false

---@type number[]
local DEBUG_LOOP_IDS

---循环遍历配置表
---@param sid number
---@return number
local function getNextDebugSid(sid)
    ---@generic T
    ---@param array T[]
    ---@param value T
    local function contains(array, value)
        for _, v in pairs(array) do
            if v == value then
                return true
            end
        end
        return false
    end

    if not DEBUG_LOOP_IDS then
        DEBUG_LOOP_IDS = {}
    end
    local resultSid = sid
    if contains(DEBUG_LOOP_IDS, resultSid) then
        for _sid, _ in pairs(_G.ConfigManager.artifact_cfg) do
            if not contains(DEBUG_LOOP_IDS, _sid) then
                resultSid = _sid
                break
            end
        end
    end
    if resultSid ~= sid or not contains(DEBUG_LOOP_IDS, resultSid) then
        table.insert(DEBUG_LOOP_IDS, resultSid)
    else
        DEBUG_LOOP_IDS = {}
    end
    return resultSid
end
--endregion

local orderDic = {
    [1] = "ui_js_a_icon",
    [2] = "ui_js_s_icon",
    [3] = "ui_js_splus_icon",
    [4] = "ui_js_splus_icon",
    [5] = "ui_js_splus_icon"
}

local ActivitySynManager = require("ActivitySynManager")
local CardInfoManager = require("CardInfoManager"):GetInstance()
---@class ArtifactDrawUpShowView : UIBaseView
local ArtifactDrawUpShowView = _G.BaseClass("ArtifactDrawUpShowView", _G.UIBaseView)
local TimeUtil = _G.TimeUtil
local GetLangPackValue = _G.GetLangPackValue

---类的析构函数
function ArtifactDrawUpShowView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function ArtifactDrawUpShowView:OnClickBtn(go, isOn)
    local function close()
        if self.go_table.toggle_reject.isOn then
            _G.PlayerPrefsManager.SetInt(
                "ArtifactDrawUpShowView_" .. tostring(_G.PlayerModel:GetInstance().role_uid) .. "_" .. self.data.ActivityID,
                _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
            )
        end
        self:CloseView()
    end
    if go == self.go_table.aorbtn_close then
        close()
    elseif go == self.go_table.aorbtn_card or go == self.go_table.aorbtn_details then
        ---需要填充中间的参数(nil), 目标参数为showMaxLevel = true
        require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, self.sid, nil, nil, true)
    elseif go == self.go_table.aorbtn_card then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ArtifactTrialSkillView.Name,
            self.sid
        )
    elseif go == self.go_table.aorbtn_get then
        close()
        require "ActivitySynEnterManager":GetInstance():OnBtnClickBtn(self.data.ActivityID)
    elseif go == self.go_table.aorbtn_close1 then
        close()
    end
end
---类的析构函数
---@param activityClass ActivitySynBase
function ArtifactDrawUpShowView:OnCreate(data)
    self.data = data
    ----@type ArtifactTrialSynModel
    -- self.activity = activityClass:GetActivityTypeCls()
    -- self.artifactTrialData = self.activity.artifactTrialData

    ---别问问就是策划不敢配，影响线上怕
    self.isSp = self.data.activity.cfg.info.front.sub_type == 100091
    local sid
    local nowChoose = self.data:GetArtifact()
    if nowChoose and nowChoose ~= 0 then 
        self.sid = nowChoose
    else 
        self.sid = self.data:GetGodPreAward()[1][1]
    end
    if DEBUG_MODE then
        sid = getNextDebugSid(sid)
        self.sid = sid
    end
    self.artifactCfg = _G.ConfigManager.artifact_cfg[self.sid]
    self.activityEndTime = self.data.start_time + self.data.run_time
    self.go_table.toggle_reject.isOn = false
    self:SetInfo()
    self:SetTimer()
    self:UpdateTime()
    self:SetCardInfo()
    --self.go_table.aortext_txt.text = GetLangPackValue(90022300098, self.artifactTrialData.endDay)
    -- self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(
    --     self.activity:GetRedpointIDByIndex(1)
    -- )
    local Tweening = _G.CS.DG.Tweening
    local x, y, z = self.go_table.aorrawimage_icon:GetLocalPosition()
    self.tweer =
        self.go_table.aorrawimage_icon:DOLocalMoveY(y + 20, 1.5):SetEase(Tweening.Ease.InOutSine):SetLoops(
        -1,
        Tweening.LoopType.Yoyo
    )
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_xianshishenqizhaomu_pailian,
            self.go_table.obj_eff,
            function(obj)
                if self.go_table==nil then
                    _G.DestroyObject(obj)
                    return
                else
                    obj:SetActiveE(1)
                end
            end
    )
end

---设置神器信息
