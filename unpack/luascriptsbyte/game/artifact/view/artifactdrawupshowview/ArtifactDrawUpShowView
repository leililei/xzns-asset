        self.artifactCfg.image_1,
        function(trans)
            if _G.IsNil(trans) then
                return
            end
            trans:SetActiveE(1)
        end
    )
    self.go_table.aorrawimage_name:LoadImage(
        self.artifactCfg.image_2,
        function(trans)
            if _G.IsNil(trans) then
                return
            end
            trans:SetActiveE(1)
        end
    )
    self.go_table.aorimage_Order.SpriteName = orderDic[self.artifactCfg.Order]
    self.go_table.aortext_name.text = _G.GetLangPackValue(self.artifactCfg.Name)
    if not _G.string.IsNullOrEmpty(self.data.cfg.word) then
        -- local word = string.split(self.data.cfg.word, "#")
        -- if word[1] then 
        --     self.go_table.aortext_desc1.text = GetLangPackValue(word[1])
        -- end
        -- if word[2] then 
        --     self.go_table.aortext_desc2.text = GetLangPackValue(word[2])
        -- end
        self.go_table.aorrawimage_slogan:LoadImage(
        self.data.cfg.word,
        function(trans)
            if self:IsNil() then
                return
            end
            trans:SetNativeSize()
        end
    )
    end
    self.go_table.aorimage_tip.SpriteName = _G.ProfessionalIcon[self.artifactCfg.Professional]
    self:SetEffect()
end

---初始化特效
function ArtifactDrawUpShowView:SetEffect()
    for _, v in pairs(self.artifactCfg.effect) do
        _G.UIUtils.LoadEffectByPath(
            v[2],
            self.go_table["trans_effect" .. v[1]],
            function(obj)
                if _G.IsNil(self.go_table) then
                    _G.DestroyObject(obj)
                    return
                end
                obj:SetLocalPosition(v[3], v[4], v[5])
                obj:SetLocalScaleXYZ(v[6])
            end,
            nil,
            nil,
            nil,
            nil,
            nil,
            true
        )
    end
end

---设置专属神器卡牌头像
function ArtifactDrawUpShowView:SetCardInfo()
    local cardId = self.artifactCfg.card_id
    if cardId and cardId > 0 then
        local cardCfg = _G.ConfigManager.card_cfg[cardId]
        local icon = cardCfg.Icon
        if _G.string.contains(icon, "/") then
            icon = _G.string.split2tbl(icon, "/")
            icon = icon[#icon]
        end
        self.go_table.aorimage_cardIcon.SpriteName = icon
        self.go_table.aorimage_cardBg.SpriteName = CardInfoManager:GetHeadBgSpriteName(nil, 7)
    else
        self.go_table.aorbtn_card:SetActiveE(0)
    end
end

---活动倒计时
function ArtifactDrawUpShowView:SetTimer()
    if not self.activityTimer then
        self.activityTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.activityTimer:Start()
    end
end

function ArtifactDrawUpShowView:UpdateTime()
    if self:IsNil() then
        return
    end
    local time = self.activityEndTime - TimeUtil.GetServerUnixTime()
    if time <= 0 then
        self:CloseView()
        return
    end
    self.go_table.aortext_time.text = GetLangPackValue(90000010360, TimeUtil.GodSpecialGiftForStr(time))
end

function ArtifactDrawUpShowView:StopAllTimer()
    if self.activityTimer then
        self.activityTimer:Stop()
        self.activityTimer = nil
    end
end

function ArtifactDrawUpShowView:OnDestroy()
    self:StopAllTimer()
end

function ArtifactDrawUpShowView:CloseView()
    self:StopAllTimer()
    self:Close()
end

function ArtifactDrawUpShowView:Dispose()
    self.go_table = nil
    if self.tweer then
        self.tweer:Kill()
        self.tweer = nil
    end
end

return ArtifactDrawUpShowView