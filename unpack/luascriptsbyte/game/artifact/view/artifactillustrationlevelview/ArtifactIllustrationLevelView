---@class ArtifactIllustrationLevelView : UIBaseView	中文描述
---@field public go_table ArtifactIllustrationLevelView_GoTable GoTable
local ArtifactIllustrationLevelView = _G.BaseClass("ArtifactIllustrationLevelView", _G.UIBaseView)
local ArtifactIllustrationModel

function ArtifactIllustrationLevelView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArtifactIllustrationLevelView:OnCreate(showEff)
    ArtifactIllustrationModel = require "ArtifactIllustrationModel":GetInstance()
    self.curLevel, self.curexp = ArtifactIllustrationModel:GetCurIllLevel()
    self.needExp = ArtifactIllustrationModel.needExp
    self:InitView()
    if showEff then
        for i = 1, 2 do
            self:LoadEffect(self.go_table["aortext_cur" .. 2 * i - 1], 100)
            self:LoadEffect(self.go_table["aortext_next" .. 2 * i - 1], 100)
        end
        self:LoadEffect(self.go_table.aortext_level, 165)
    end
end

function ArtifactIllustrationLevelView:LoadEffect(parent, x)
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_ListLevUp,
        parent,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
            trans:SetLocalPosition(x, 0, 0)
        end
    )
end

function ArtifactIllustrationLevelView:InitView()
    local curdata = ArtifactIllustrationModel:GetIllLevelAddition(self.curLevel)
    local nextdata = ArtifactIllustrationModel:GetIllLevelAddition(self.curLevel + 1)
    self.go_table.aortext_cur1.text = curdata.atk
    self.go_table.aortext_cur2.text = curdata.bre
    self.go_table.aortext_cur3.text = curdata.def
    self.go_table.aortext_cur4.text = curdata.max_hp
    self.go_table.aortext_next1.text = nextdata.atk
    self.go_table.aortext_next2.text = nextdata.bre
    self.go_table.aortext_next3.text = nextdata.def
    self.go_table.aortext_next4.text = nextdata.max_hp
    self.go_table.aortext_level.text = _G.GetLangPackValue(90022300032, self.curLevel)
    self.go_table.aortext_exp.text = self.curexp .. "/" .. self.needExp
    self.go_table.slider_exp.value = self.curexp / self.needExp
end

---界面的销毁函数
function ArtifactIllustrationLevelView:OnDestroy()
end

---按钮点击事件在这里派发
function ArtifactIllustrationLevelView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end

return ArtifactIllustrationLevelView
