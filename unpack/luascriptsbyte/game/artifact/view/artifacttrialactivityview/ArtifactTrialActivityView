--region debug模式
---debug模式, 开启后打开页面将依次遍历配置展示所有神器
local DEBUG_MODE = false

---@type number[]
local DEBUG_LOOP_IDS

---循环遍历配置表
---@param sid number
---@return number
local function getNextDebugSid(sid)
    ---@generic T
    ---@param array T[]
    ---@param value T
    local function contains(array, value)
        for _, v in pairs(array) do
            if v == value then
                return true
            end
        end
        return false
    end

    if not DEBUG_LOOP_IDS then
        DEBUG_LOOP_IDS = {}
    end
    local resultSid = sid
    if contains(DEBUG_LOOP_IDS, resultSid) then
        for _sid, _ in pairs(_G.ConfigManager.artifact_cfg) do
            if not contains(DEBUG_LOOP_IDS, _sid) then
                resultSid = _sid
                break
            end
        end
    end
    if resultSid ~= sid or not contains(DEBUG_LOOP_IDS, resultSid) then
        table.insert(DEBUG_LOOP_IDS, resultSid)
    else
        DEBUG_LOOP_IDS = {}
    end
    return resultSid
end
--endregion

local ActivitySynManager = require("ActivitySynManager")
local CardInfoManager = require("CardInfoManager"):GetInstance()
---@class ArtifactTrialActivityView : UIBaseView
local ArtifactTrialActivityView = _G.BaseClass("ArtifactTrialActivityView", _G.UIBaseView)
local TimeUtil = _G.TimeUtil
local GetLangPackValue = _G.GetLangPackValue

---类的析构函数
function ArtifactTrialActivityView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function ArtifactTrialActivityView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:CloseView()
    elseif go == self.go_table.aorbtn_card or go == self.go_table.aorbtn_details then
        ---需要填充中间的参数(nil), 目标参数为showMaxLevel = true
        require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, self.artifactTrialData.sid, nil, nil, true)
    elseif go == self.go_table.aorbtn_card then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ArtifactTrialSkillView.Name,
            self.artifactTrialData.sid
        )
    elseif self.go_table.aorbtn_get then
        self.activity:GetAward(
            function()
                self:Close()
            end
        )
    end
end
---类的析构函数
---@param activityClass ActivitySynBase
function ArtifactTrialActivityView:OnCreate(activityClass)
    self.activityClass = activityClass
    ---@type ArtifactTrialSynModel
    self.activity = activityClass:GetActivityTypeCls()
    self.artifactTrialData = self.activity.artifactTrialData

    local sid = self.artifactTrialData.sid
    if DEBUG_MODE then
        sid = getNextDebugSid(sid)
        self.artifactTrialData.sid = sid
    end
    self.artifactCfg = _G.ConfigManager.artifact_cfg[sid]
    self.activityEndTime = self.activityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    self:SetInfo()
    self:SetTimer()
    self:UpdateTime()
    self:SetCardInfo()
    self.go_table.aortext_txt.text = GetLangPackValue(90022300098, self.artifactTrialData.endDay)
    self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(
        self.activity:GetRedpointIDByIndex(1)
    )
end

---设置神器信息
function ArtifactTrialActivityView:SetInfo()
    self.go_table.aorrawimage_icon:SetActiveE(0)
    self.go_table.aorrawimage_icon:LoadImage(
        self.artifactCfg.image_1,
        function(trans)
            if _G.IsNil(trans) then
                return
            end
            trans:SetActiveE(1)
        end
    )
    self.go_table.aorrawimage_name:LoadImage(
        self.artifactCfg.image_2,
        function(trans)
            if _G.IsNil(trans) then
                return
            end
            trans:SetActiveE(1)
        end
    )
    
    if self.artifactTrialData.title1 then
        self.go_table.aortext_desc1.text = GetLangPackValue(self.artifactTrialData.title1)
    end
    if self.artifactTrialData.title2 then
        self.go_table.aortext_desc2.text = GetLangPackValue(self.artifactTrialData.title2)
    end
    self:SetEffect()
end

---初始化特效
function ArtifactTrialActivityView:SetEffect()
    for _, v in pairs(self.artifactCfg.effect) do
        _G.UIUtils.LoadEffectByPath(
            v[2],
            self.go_table["trans_effect" .. v[1]],
            function(obj)
                if _G.IsNil(self.go_table) then
                    _G.DestroyObject(obj)
                    return
                end
                obj:SetLocalPosition(v[3], v[4], v[5])
                obj:SetLocalScaleXYZ(v[6])
            end,
            nil,
            nil,
            nil,
            nil,
            nil,
            true
        )
    end
end

---设置专属神器卡牌头像
function ArtifactTrialActivityView:SetCardInfo()
    local cardId = self.artifactCfg.card_id
    if cardId and cardId > 0 then
        local cardCfg = _G.ConfigManager.card_cfg[cardId]
        local icon = cardCfg.Icon
        if _G.string.contains(icon, "/") then
            icon = _G.string.split2tbl(icon, "/")
            icon = icon[#icon]
        end
        self.go_table.aorimage_cardIcon.SpriteName = icon
        self.go_table.aorimage_cardBg.SpriteName = CardInfoManager:GetHeadBgSpriteName(nil, 7)
    else
        self.go_table.aorbtn_card:SetActiveE(0)
    end
end

---活动倒计时
function ArtifactTrialActivityView:SetTimer()
    if not self.activityTimer then
        self.activityTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.activityTimer:Start()
    end
end

function ArtifactTrialActivityView:UpdateTime()
    if self:IsNil() then
        return
    end
    local time = self.activityEndTime - TimeUtil.GetServerUnixTime()
    if time <= 0 then
        self:CloseView()
        return
    end
    self.go_table.aortext_time.text = GetLangPackValue(90000010360, TimeUtil.GodSpecialGiftForStr(time))
end

function ArtifactTrialActivityView:StopAllTimer()
    if self.activityTimer then
        self.activityTimer:Stop()
        self.activityTimer = nil
    end
end

function ArtifactTrialActivityView:OnDestroy()
    self:StopAllTimer()
end

function ArtifactTrialActivityView:CloseView()
    self:StopAllTimer()
    self:Close()
end

function ArtifactTrialActivityView:Dispose()
    self.go_table = nil
end

return ArtifactTrialActivityView