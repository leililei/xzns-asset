---点击抽卡按钮
function ArtifactDrawUpMainView:DrawCard(type, consumeType)
    local model = require("ArtifactDrawUpMainModel"):GetInstance()
    if model.JianGe then
        return
    end
    if #self.AwardDatas > 1 and self.nowChoose == 0 then
        self:ShowGuide()
        return
    end
    --获取拥有的招募券数量
    local coinNum = model:GetPropNum(self.ActivityID)
    --获取魂玉召唤总次数
    local totalTimes = model:GetDiamondTotalTimes(self.ActivityID)
    local remainTimes = totalTimes - model:GetDiamondTimes(self.ActivityID)

    local tens = coinNum >= 10 and 10 or coinNum

    local num = 0
    if consumeType == _G.DrawConsumeType.token then
        num = type == 1 and 1 or (tens > 0 and tens or 10)
    elseif consumeType == _G.DrawConsumeType.diamond then
        num = type == 1 and 1 or 10
    end
    local num1 = type == 1 and 1 or 10

    ---@type number 消耗模式: 1活动代币 2魂玉
    local consumeNum = 0
    if coinNum >= num or totalTimes == 0 or remainTimes < num1 then
        --检查招募券数量
        if coinNum < num then
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.GetItemWayView.Name,
                model:GetCoinId(self.ActivityID)
            )
            return
        end
        consumeType = _G.DrawConsumeType.token
    else
        --检查魂玉数量
        consumeNum = model:GetDiamondConsume(self.ActivityID, num)
        if type == _G.DrawType.TenTimes then
            local limited_roller_cfg = require "ArtifactDrawUpMainModel":GetInstance():Getlimited_roller_cfg(self.ActivityID)
            local discount = limited_roller_cfg.ticket_discount[1]
            if nil ~= discount then
                consumeNum = _G.Mathf.Floor(consumeNum * discount / 10000)
            end
        end
        local ownNum = _G.StorageManager:GetInstance():GetItemCountBySid(_G.ResPropID.Diamond)
        if ownNum < consumeNum then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ResPropID.Diamond)
            return
        end
        consumeType = _G.DrawConsumeType.diamond
    end

    if consumeType == _G.DrawConsumeType.diamond then

        _G.PopWindowManager:GetInstance():ShowBtnWindowByToggle(
            631,
            function()
                require "IllustrationModel":GetInstance().NewChoKa = {}
                model:DrawCard(
                    self.ActivityID,
                    consumeType,
                    num,
                    type,
                    _G.handler(self, self.Sharing),
                    _G.handlerbind(self, self.IsEff)
                )
            end,
            function()
            end,
            nil,
            true,
            consumeNum,
            num,
            _G.GetLangPackValue(_G.ConfigManager.currency_type_client_cfg[self.coinId].name),
            num
        )
    else
        require "IllustrationModel":GetInstance().NewChoKa = {}
        model:DrawCard(
            self.ActivityID,
            consumeType,
            num,
            type,
            _G.handler(self, self.Sharing),
            _G.handlerbind(self, self.IsEff)
        )
    end
end

function ArtifactDrawUpMainView:ShowGuide()
    _G.PopWindowManager:GetInstance():ShowAllTips(271703)
    if self.go_table.obj_finger:GetChildCountE() == 0 then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.Ef_yindaoshoushi,
            self.go_table.obj_finger,
            function(trans)
                trans:SetLocalPosition(50, -50, 0)
                _G.DelayDo(3, function()
                    if not self.go_table then
                        return
                    end
                    self.go_table.obj_finger:RemoveAllChildren()
                end)
            end
        )
    end
end

function ArtifactDrawUpMainView:hongDian()
    if require("ArtifactDrawUpMainModel"):GetInstance():GetPropNum(self.ActivityID) >= 10 then
        self.go_table.obj_hongDian:SetActiveE(1)
    else
        self.go_table.obj_hongDian:SetActiveE(0)
    end
end

---特效显示隐藏
function ArtifactDrawUpMainView:IsEff(num, call, Elements)
    self.var = self.go_table.aorimage_onceLan
    local it = _G.ConfigManager.ui_effect_cfg["ef_ArtifactDrawView_n"].LifeTime

    if num == 1 then
        self.go_table.aorimage_onceLan:SetActiveE(1)
    elseif num == 2 then
        it = _G.ConfigManager.ui_effect_cfg["ef_ArtifactDrawView_gold"].LifeTime

        self.go_table.aorimage_onceJin:SetActiveE(1)
        self.var = self.go_table.aorimage_onceJin
    end
    if self.eff == nil then
        self.eff = _G.TimerManager:GetInstance():GetTimer(it, self.EffClose, self, false, false, true, call)
        self.eff:Start()
    end
end

function ArtifactDrawUpMainView:EffClose(call)
    if self.eff then
        self.eff:Stop()
        self.eff = nil
    end
    if self.var then
        self.var:SetActiveE(0)
    end
    if call then
        require("ArtifactDrawUpMainModel"):GetInstance().JianGe = false
        call()
    end
end

function ArtifactDrawUpMainView:Dispose()
    self.Anim = nil

    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.ResUpdate, self)
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.ResRefresh, self.ResUpdate, self)
end

function ArtifactDrawUpMainView.IsHuanXing(_, num)
    if num == 1 then
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ArtifactDrawUpMainView.Name)
    else
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ArtifactDrawUpMainView.Name)
    end
end

---获取排行榜数据
function ArtifactDrawUpMainView:GetRankInfo()
    require("ArtifactDrawUpRankModel"):GetInstance():RequestRankInfo(
        1,
        self.ActivityID,
        function(rankDatas, mineRank, mineValue)
            self.topThreeRankData = rankDatas
            self:RefreshRank()
            self:RefreshMineRank(mineRank, mineValue)
        end
    )
end

---刷新排行榜显示
function ArtifactDrawUpMainView:RefreshRank()
    if not self.rankListView then
        self.go_table.scrollloopvectical_rank:InitItemData(3, _G.handler(self, self.RefreshRankItem))
        self.rankListView = self.go_table.scrollloopvectical_rank
    else
        self.rankListView:UpdateCount(3)
    end
end

function ArtifactDrawUpMainView:RefreshRankItem(csIndex, obj)
    if csIndex < 0 then
        return
    end
    local luaIndex = csIndex + 1
    ---@type DrawUpMainView._obj_rankItem_GoTable
    local goTable = _G.GetAutoGoTable(obj)
    local rankInfo = self.topThreeRankData[luaIndex]
    local posRank = luaIndex
    if posRank >= 1 and posRank <= 3 then
        goTable.aorimage_rankIcon:SetActiveE(1)
        goTable.aorimage_rankIcon:LoadSprite(rankIcon[posRank])
    else
        goTable.aorimage_rankIcon:SetActiveE(0)
    end
    goTable.aortext_rankscore.text = posRank
    if rankInfo and rankInfo.role_info and rankInfo.role_info.uid > 0 then
        goTable.aortext_rankname.text = rankInfo.role_info.name
    else
        goTable.aortext_rankname.text = _G.GetLangPackValue(90022300109)
    end
end

---刷新排行榜自己的排名
function ArtifactDrawUpMainView:RefreshMineRank(mineRank, mineValue)
    local myGoTable = _G.GetAutoGoTable(self.go_table.obj_myrankItem)
    local playerModel = _G.PlayerModel:GetInstance()
    myGoTable.aortext_rankname.text = playerModel:GetName()
    local myRank = mineRank
    if myRank >= 1 and myRank <= 3 then
        --myGoTable.aorimage_rankIcon:SetActiveE(1)
        myGoTable.aortext_rankscore:SetActiveE(1)
        myGoTable.aortext_rankno:SetActiveE(0)
        --myGoTable.aorimage_rankIcon:LoadSprite(string.format("tz_qjhs_phb_mingci_0%d", myRank))
        myGoTable.aortext_rankscore.text = myRank
    elseif mineValue == 0 then
        --myGoTable.aorimage_rankIcon:SetActiveE(0)
        myGoTable.aortext_rankscore:SetActiveE(0)
        myGoTable.aortext_rankno:SetActiveE(1)
    else
        --myGoTable.aorimage_rankIcon:SetActiveE(0)
        myGoTable.aortext_rankscore:SetActiveE(1)
        myGoTable.aortext_rankno:SetActiveE(0)
        myGoTable.aortext_rankscore.text = (myRank == 0 or myRank > 1000) and "1000+" or myRank
    end
end

function ArtifactDrawUpMainView:OnClickBtn(go, _)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:Close()
    elseif name == "@_aorbtn_autoLeft" then
        self:kaiguanbut()
    elseif name == "@_aorbtn_Wenhao" then
        if require("ArtifactDrawUpMainModel"):GetInstance().JianGe then
            return
        end
        local sid = require "ArtifactDrawUpMainModel":GetInstance():GetItemId(self.ActivityID)
        require("CommonTipManager"):GetInstance():OpenTip(go, sid, nil, nil, nil, 1)
    elseif name == "@_aorbtn_DrawOnce" then
        self:DrawCard(_G.DrawType.once, self.MyDrawConsumeType)
    elseif name == "@_aorbtn_DrawTenTimes" then
        self:DrawCard(_G.DrawType.TenTimes, self.MyDrawConsumeType)
    elseif name == "@_aorbtn_LiBao" then
        if require("ArtifactDrawUpMainModel"):GetInstance().JianGe then
            return
        end
        _G.GlobalInterface.JumpActivityByGM(10014, self.activity:GetJumpType(self.ActivityID))
    elseif name == "@_aorbtn_baodian" then
        if require("ArtifactDrawUpMainModel"):GetInstance().JianGe then
            return
        end
        _G.GlobalInterface.JumpActivityByGM(10027, self.activity:GetJumpType(self.ActivityID))
    elseif name == "@_aorbtn_zhouka" then
        if require("ArtifactDrawUpMainModel"):GetInstance().JianGe then
            return
        end
        _G.GlobalInterface.JumpActivityByGM(10088, self.activity:GetJumpType(self.ActivityID))
    elseif name == "@_aorbtn_Yulan" then
        self:OnHrefClick()
    elseif name == "@_aorbtn_help1" then
        if require("ArtifactDrawUpMainModel"):GetInstance().JianGe then
            return
        end
        local sid = self.activity:GetJumpType() == 100091 and 224 or 88
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, sid)
    elseif name == "@_aorbtn_task" then
        if require("ArtifactDrawUpMainModel"):GetInstance().JianGe then
            return
        end
        _G.GlobalInterface.JumpActivityByGM(10007, self.activity:GetJumpType(self.ActivityID))
    elseif name == "@_aorbtn_packGift" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArtifactDrawUpPackGiftView.Name, self.activity)
    elseif name == "@_aorbtn_ZhuLi" then
        if require("ArtifactDrawUpMainModel"):GetInstance().JianGe then
            return
        end

        _G.GlobalInterface.JumpActivityByGM(10030, self.activity:GetJumpType(self.ActivityID))
    elseif name == "@_aorbtn_QieHuan" then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ArtifactDrawAwardPreView.Name,
            self.ActivityID,
            _G.handlerbind(self, self.SwitchImage)
        )
        self.go_table.obj_finger:RemoveAllChildren()
    elseif name == "@_aorbtn_change" then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ArtifactDrawAwardPreView.Name,
            self.ActivityID,
            _G.handlerbind(self, self.SwitchImage)
        )
        self.go_table.obj_finger:RemoveAllChildren()
    elseif name == "@_aorbtn_detail" then
        require "CommonTipManager":GetInstance():OpenTip(self.gameObject, self.GetArtifactID)
    elseif name == "@_aorbtn_rank" then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CommonRankView.Name,
            _G.CommonRankType.ArtifactDrawUp,
