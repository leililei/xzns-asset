function ArtifactDrawUpMainView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.Anim = self.go_table.transform:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    _G.Events:GetInstance():AddListener(_G.AnimationEvents.DrawUpMain, self.DrawUpMainAnim, self)
    self.kaiguan = _G.PlayerPrefsManager.GetInt("DrawUpMainViewkaiguan")
    --判断开关
    if self.kaiguan == nil or self.kaiguan == 0 then
        self.kaiguan = 0
        _G.PlayerPrefsManager.SetInt("DrawUpMainViewkaiguan", self.kaiguan)
    end
    require("ArtifactDrawUpMainModel"):GetInstance().JianGe = false
    --_G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_ArtifactDrawView_fazhen, self.go_table.aorrawimage_di)
