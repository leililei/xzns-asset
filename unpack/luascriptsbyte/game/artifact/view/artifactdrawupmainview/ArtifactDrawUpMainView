---界面的入口函数
function ArtifactDrawUpMainView:OnCreate(activity)
    UIUtils.SetUIModel(self.go_table.obj_Name, nil, self.go_table.obj_Name2, nil, nil, false)
    if activity then
        self.activity = activity
        self.ActivityID = activity.activityID
        ---判断物品是否存在并且是可见状态（显示各种货币）
        if not _G.IsNil(self.go_table.obj_GoldInfo) and self.go_table.obj_GoldInfo:GetctiveInHierarchy() == 1 then
            ---添加要显示的货币或者资源
            local resources = _G.ConfigManager.ui_cfg.ArtifactDrawUpMainView.resources
            local newResource = {}
            for i = 1, #resources do
                if resources[i] == 106 then
                    newResource[i] = ArtifactDrawUpMainModel:GetInstance():GetCoinId(self.ActivityID)
                else
                    newResource[i] = resources[i]
                end
            end
            if #newResource > 0 then
                self:AddComponent(
                    self.go_table.obj_GoldInfo,
                    require("ResourceCompont").New(self.go_table.obj_GoldInfo, newResource)
                )
            end
        end
        self.coinId = require("ArtifactDrawUpMainModel"):GetInstance():GetCoinId(self.ActivityID)
        self.go_table.obj_redpointPackGift:UpdateRedPointItemIDAndParam(
            self.activity:GetActivityTypeCls():GetRedpointIDByIndex(2)
        )
    end
    self:LoadConsumesInfos()
    self:LoadDiamondTimes()
    self:ZanDouTimer()
    if self.timeShengYus == nil then
        self.timeShengYus = _G.TimerManager:GetInstance():GetTimer(1, self.ZanDouTimer, self, false, false, true)
        self.timeShengYus:Start()
    end
    if not self.ExtendText then
        self.ExtendText = self.go_table.obj_goto:GetComponentE(_G.typeof(_G.CS.ExtendText))
        self.ExtendText.OnHrefClick:AddListener(_G.handler(self, self.OnHrefClick))
    end
    local str = GetLangPackValue(langugageId.get)
    str = string.format(string.format("<%s@0>", str))
    self.ExtendText.text = str
    self:Sharing(0, true)
    self:FirstChoose()

    if not self.RankExtendText then
        self.RankExtendText = self.go_table.obj_rankBtn:GetComponentE(_G.typeof(_G.CS.ExtendText))
        self.RankExtendText.OnHrefClick:AddListener(
            _G.handler(
                self,
                function(self)
                    _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.CommonRankView.Name,
                        _G.CommonRankType.ArtifactDrawUp,
                        self.ActivityID
                    )
                end
            )
        )
    end
    local strDraw = GetLangPackValue(langugageId.gotoDrawRank)
    strDraw = string.format(string.format("<%s@0>", strDraw))
    self.RankExtendText.text = strDraw
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.ResUpdate, self)
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.ResRefresh, self.ResUpdate, self)

    local Tweening = _G.CS.DG.Tweening
    local x, y, z = self.go_table.aorrawimage_Card:GetLocalPosition()
    self.tweer = self.go_table.aorrawimage_Card:DOLocalMoveY(y + 20, 1.5):SetEase(Tweening.Ease.InOutSine):SetLoops(
        -1,
        Tweening.LoopType.Yoyo
    )
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_xianshishenqizhaomu_zhujiemian,
        self.go_table.obj_eff,
        function(obj)
            if self.go_table == nil then
                _G.DestroyObject(obj)
                return
            else
                obj:SetActiveE(1)
            end
        end
    )
    local model = require("ArtifactDrawUpMainModel"):GetInstance()
    local sid = model:GetCoinId(self.ActivityID)
    if sid ~= 0 then
        self.go_table.aortext_tipsText.text = _G.GetLangPackValue(90029300060, _G.StorageManager:GetInstance():GetItemName(sid))
    end
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.ArtifactDrawUpMainViewRightBtnIcon, self.go_table)
    if self.activity:GetJumpType() == 100091 then 
        self.go_table.aorrawimage_di:LoadImage(
            "ImagesH5/CardHall/ui_zgsq_drawBG",
            function(image)
                if image ~= nil then
                    image:SetActiveE(1)
                    image:SetNativeSize()
                end
            end
        )
    end
end

function ArtifactDrawUpMainView:FirstChoose()
    self.AwardDatas = require "ArtifactDrawUpMainModel":GetInstance():GetGodPreAward(self.ActivityID)
    self.nowChoose = require("ArtifactDrawUpMainModel"):GetInstance():GetArtifact(self.ActivityID)

    --ZHJH-8378 如果有多个可选项不默认选择
    if #self.AwardDatas > 1 or self.nowChoose ~= 0 then
        self:SwitchImage()
        return
    end
    require("ArtifactDrawUpMainModel"):GetInstance():Port_change(
        self.ActivityID,
        self.AwardDatas[1][1],
        _G.handlerbind(self, self.SwitchImage)
    )
end

-- 图片切换
function ArtifactDrawUpMainView:SwitchImage(GetArtifact)
    if not GetArtifact then
        GetArtifact = require("ArtifactDrawUpMainModel"):GetInstance():GetArtifact(self.ActivityID)
    else
        --XZNS-3298 首次选择为默认的神器时未显示神器名字
        self.nowChoose = GetArtifact
    end
    local artifact_cfgData = _G.ConfigManager.artifact_cfg[GetArtifact]

    --ZHJH-8378 多个可选项时第一次需手动选择
    if #self.AwardDatas > 1 and self.nowChoose == 0 then
        self.go_table.aorimage_add:SetActiveE(1)
        self.go_table.obj_Name:SetActiveE(0)
    else
        self.go_table.obj_Name:SetActiveE(1)
    end
    self.go_table.obj_redpointWish:UpdateRedPointItemIDAndParam(
        self.activity:GetActivityTypeCls():GetRedpointIDByIndex(3)
    )
    self.activity.typeClass:RefreshRedPoint(3)

    if not artifact_cfgData then
        return
    end

    if _G.AppSetting.IsXzns then
        self.go_table.aorrawimage_di.color = _G.ColorTools.FormatColorByString("8A8A8A")
    	self.go_table.aorimage_tip:SetActiveE(1)
    end
    self.go_table.obj_Empty:SetActiveE(0)
    self.go_table.aorimage_add:SetActiveE(0)
    self.GetArtifactID = GetArtifact
    self.nowChoose = GetArtifact
    self.go_table.aorrawimage_jia:SetActiveE(0)
    ---立绘图片更新
    self.go_table.aorrawimage_Card:LoadImage(
        artifact_cfgData.image_1,
        function(image)
            if image ~= nil then
                image:SetActiveE(1)
                image:SetNativeSize()
            end
        end
    )
    ---立绘图片更新
    self.go_table.aorrawimage_ShuaXin:LoadImage(
        artifact_cfgData.image_2,
        function(image)
            if image ~= nil then
                image:SetActiveE(1)
                image:SetNativeSize()
            end
        end
    )
    self.go_table.obj_Sprie:ClearChildren()
    self.go_table.aorrawimage_Card:ClearChildren()
    local effects = artifact_cfgData.effect
    local parent
    for _, v in pairs(effects) do
        parent = v[1] == "1" and self.go_table.obj_Sprie or self.go_table.aorrawimage_Card
        _G.UIUtils.LoadEffectByPath(
            v[2],
            parent,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                trans:SetLocalPosition(v[3], v[4], v[5])
                trans:SetLocalScaleXYZ(v[6])
            end,
            nil,
            nil,
            nil,
            nil,
            nil,
            true
        )
    end
    self.go_table.aorimage_Orderzi.SpriteName = orderDic[artifact_cfgData.Order]
    --self.go_table.aortext_Name.text = _G.GetLangPackValue(artifact_cfgData.Name)
    UIUtils.SetUIModelText(self.go_table.aortext_Name, self.go_table.aortext_Name2, _G.GetLangPackValue(artifact_cfgData.Name))
    UIUtils.SetUIModel(self.go_table.obj_Name, nil, self.go_table.obj_Name2)
    self.artifactName = _G.GetLangPackValue(artifact_cfgData.Name)
    self.go_table.aortext_Num2.text = self.artifactName
    if not self.item then
        self.item = require "BaseAwardNewItem".New(self.go_table.obj_Root, _G.handler(self, self.OnClickItem), 96)
    end
    self.item:ShowWithID(
        { artifact_cfgData.id, 1 },
        nil,
        function(item)
            if item.item.HideOrShowStar then
                item.item:HideOrShowStar(false)
            end
            if _G.AppSetting.IsXzns then
                local cardId = artifact_cfgData.card_id
                if cardId and cardId > 0 then
                    local cardCfg = _G.ConfigManager.card_cfg[cardId]
                    local icon = cardCfg.Icon
                    if _G.string.contains(icon, "/") then
                        icon = _G.string.split2tbl(icon, "/")
                        icon = icon[#icon]
                    end
                    item.item.go_table.aorimage_BoundIcon:SetActiveE(1)
                    item.item.go_table.aorimage_BoundBg:SetActiveE(1)
                    item.item.go_table.aorimage_BoundIcon.SpriteName = icon
                    item.item.go_table.aorimage_BoundBg.SpriteName = require("CardInfoManager"):GetInstance():GetHeadBgSpriteName(nil, 7)
                else
                    item.item.go_table.aorimage_BoundIcon:SetActiveE(0)
                    item.item.go_table.aorimage_BoundBg:SetActiveE(0)
                end
            end
        end
    )
    -- self.go_table.aorrawimage_Card:SetLocalPosition(artifact_cfgData.image_1)

    -- local dev = _G.string.split(artifact_cfgData.effect, "#")

    -- for _, value in pairs(dev) do
    --     _G.UIUtils.LoadEffectByPath(value, self.go_table.aorrawimage_Spzm)
    -- end
end

