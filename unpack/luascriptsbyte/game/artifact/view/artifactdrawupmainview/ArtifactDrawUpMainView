function ArtifactDrawUpMainView:LoadDiamondTimes()
    local model = require("ArtifactDrawUpMainModel"):GetInstance()

    --获取魂玉召唤次数信息
    local usedTimes = model:GetDiamondTimes(self.ActivityID)
    local totalTimes = model:GetDiamondTotalTimes(self.ActivityID)
    self.go_table.obj_diamondTimes:SetActiveE(totalTimes > 0 and 1 or 0)
    if totalTimes <= 0 then
        return
    end

    local remain = totalTimes - usedTimes
    self.go_table.aortext_remainDiamondTimes.text = _G.GetLangPackValue(90022300102, remain .. "/" .. totalTimes)
end
