function ArtifactDrawUpMainView:ShowDisCount()
    local model = require("ArtifactDrawUpMainModel"):GetInstance()

    --获取招募券数量
    local coinNum = model:GetPropNum(self.ActivityID)
    --获取魂玉召唤总次数
    local totalTimes = model:GetDiamondTotalTimes(self.ActivityID)
    local remainTimes = totalTimes - model:GetDiamondTimes(self.ActivityID)

    local isdiamod
    if coinNum >= 1 or totalTimes == 0 or remainTimes < 10 then
        isdiamod = false
    else
        isdiamod = true
    end

    local usedTimes = model:GetDiamondTimes(self.ActivityID)
    --local totalTimes = model:GetDiamondTotalTimes(self.ActivityID)
    local remain = totalTimes - usedTimes

    local limited_roller_cfg = model:Getlimited_roller_cfg(self.ActivityID)
    local discount = limited_roller_cfg.ticket_discount[1]
    if nil ~= discount and remain >= 10 and isdiamod then
        self.go_table.obj_discount:SetActiveE(1)
        if _G.GameUtil.GetIsUseChinese() then
            self.go_table.aortext_discount.text = _G.GetLangPackValue(90028800006, string.format("%.1f", discount / 1000))
        else
            self.go_table.aortext_discount.text = _G.GetLangPackValue(90028800006, string.format("%d%%", 100 - (discount / 100)))
        end
    else
        self.go_table.obj_discount:SetActiveE(0)
    end
end

