---@class ArtifactDrawUpAwardPreView : UIBaseView	中文描述
---@field public go_table DrawUpAwardPreView_GoTable GoTable
local ArtifactDrawUpAwardPreView = _G.BaseClass("ArtifactDrawUpAwardPreView", _G.UIBaseView)
--local artifact_pools_cfg = _G.ConfigManager.artifact_pools_cfg
--_G.ArtifactDrawUpAwardPreView = ArtifactDrawUpAwardPreView
function ArtifactDrawUpAwardPreView:Awake()
    self.AwardDatas = {}
    self.itemList = {}
    self.weight = 0
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param ActivityID number 活动id
function ArtifactDrawUpAwardPreView:OnCreate(ActivityID, artifactID)
    local insert = _G.table.insert
    local data = artifactdrawupmainmodel:GetInstance():Getlimited_roller_cfg(ActivityID)
    if data then
        for k, v in pairs(data.limited_item) do
            if artifactID == v[1] then
                local item = {}
                item.sid = v[1]
                item.num = v[2]
                item.weight = v[3] or 0
                self.weight = self.weight + item.weight
                insert(self.AwardDatas, item)
            end
        end
        -- grandPrize.sid = data.limited_item[1]
        -- grandPrize.num = data.limited_item[2]
        -- grandPrize.weight = data.limited_item[3]
        -- grandPrize.Grand = true
        -- self.weight = self.weight + grandPrize.weight
        -- insert(self.AwardDatas, grandPrize)
        for k, v in pairs(data.pool) do
            local item = {}
            item.sid = v[1]
            item.num = v[2]
            item.weight = v[3] or 0
            self.weight = self.weight + item.weight
            insert(self.AwardDatas, item)
        end
    end
    -- _G.SortList(self.AwardDatas, function(a)
    --     local type = 0
    --     if a.Grand then
    --         type = 1
    --     end
    --     return type, -a.sid
    -- end)

    self.go_table.scrollloopvectical_AwardList:InitItemData(#self.AwardDatas, _G.handler(self, self.RefreshList))
end

---刷新显示
function ArtifactDrawUpAwardPreView:RefreshList(index, obj)
    local instanceID = obj:GetInstanceIDE()
    local tb = self.itemList[instanceID]
    local data = self.AwardDatas[index + 1]
    if not data then
        return
    end
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        self.itemList[instanceID] = tb
        ---@type BaseAwardNewItem
        tb.item = require "BaseAwardNewItem".New(tb.obj_Root, _G.handler(self, self.OnClickItem), 96)
    end
    ---@param item BaseAwardNewItem
    tb.item:ShowWithID(
        { data.sid, data.num },
        nil,
        function(item)
            if item.item.HideOrShowStar then
                item.item:HideOrShowStar(false)
            end
            item:ShowEffect(data.Grand)
        end
    )
    -- local name = _G.StorageManager:GetInstance():GetItemName(data.award[1].sid)
    -- tb.aortext_name.text = _G.LangUtil.GetLangPackValue(name)
    tb.aortext_probNum.text = self:GetPerData(index + 1) .. "%"
end

---点击奖励
function ArtifactDrawUpAwardPreView:OnClickItem(item)
    require "CommonTipManager":GetInstance():OpenTip(item.gameObject, item.data.sid)
end

---按钮点击事件在这里派发
function ArtifactDrawUpAwardPreView:OnClickBtn(go, isOn)
    self:Close()
end

function ArtifactDrawUpAwardPreView:GetPerData(index)
    local weight = self.AwardDatas[index].weight / self.weight * 100
    weight = string.format("%.2f", weight)
    return weight
end

return ArtifactDrawUpAwardPreView
