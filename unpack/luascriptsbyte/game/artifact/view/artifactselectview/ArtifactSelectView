---@class ArtifactSelectView : UIBaseView
---@field public go_table ArtifactSelectView_GoTable GoTable
local ArtifactSelectView = _G.BaseClass("ArtifactSelectView", _G.UIBaseView)
local StorageManager = _G.StorageManager:GetInstance()


function ArtifactSelectView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function ArtifactSelectView:OnCreate(data, cardData, needCount, list, callback)
    self.ItemList = {}
    self.ArtifactList = {}
    self.SelectDic = {}
    self.ArtifactData = data
    self.CardData = cardData
    self.needCount = needCount
    self.TempList = _G.DeepCopy(list.select)
    self.SelectList = list.select
    self.ArtifactList =list.material
    for _, v in pairs(self.SelectList) do
        self.SelectDic[v[1]] = true
    end
    if callback then
        self.callback = callback
    end
    self:InitView()
end

function ArtifactSelectView:InitView()
    self.go_table.aortext_NoNum:SetActiveE(#self.ArtifactList == 0 and 1 or 0)
    self.go_table.scrollloopvectical_List:InitItemData(#self.ArtifactList, _G.handler(self, self.RefreshList))
end

function ArtifactSelectView:RefreshList(index, obj)
    local newIndex = index + 1
    local tb = self.ItemList[newIndex]
    local data = self.ArtifactList[newIndex]
    if not tb then
        tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, newIndex))
        self.ItemList[newIndex] = tb
    end
    _G.PoolsManager:GetInstance():Spawn(
        "UIH5/Common/ItemView/ItemArtifactBase",
            _G.ePoolType.Temporary,
            tb.obj_Root,
            function(trans)
                local lua = require("ItemArtifactBase").New(trans.gameObject)
                lua:ShowData(data)
                lua:ShowCount(false)
                tb.obj_Mask:SetActiveE(self.SelectDic[index + 1] and 1 or 0)
            end
    )
end

function ArtifactSelectView:Sure()
    if self.callback then
        self.callback(self.SelectList)
    end
    self:Close()
end

function ArtifactSelectView:SelectItem(index)

end

function ArtifactSelectView:OnClickItem(go, isOn, index)
    local inList = 0
    local insert = function()
        _G.table.insert(self.SelectList, { index, self.ArtifactList[index].uid, self.ArtifactList[index] })
        inList = #self.SelectList
        self.ItemList[index].obj_Mask:SetActiveE(1)
    end

    for i = 1, #self.SelectList do
        if self.SelectList[i][1] == index then
            inList = i
        end
    end
    if inList == 0 then
        if self.needCount == #self.SelectList then
            return
        end
        if self.ArtifactList[index].cardUid ~= 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(
            1050001,
            nil,
            function()
                insert()
            end)
        else
            insert()
        end
    else
        _G.table.remove(self.SelectList, inList)
        self.ItemList[index].obj_Mask:SetActiveE(0)
    end
end

function ArtifactSelectView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Close then
        if self.callback then
            self.callback(self.TempList)
        end
        self:Close()
    elseif go == self.go_table.aorbtn_Sure then
        self:Sure()
    end
end

function ArtifactSelectView:Dispose()
end

return ArtifactSelectView
