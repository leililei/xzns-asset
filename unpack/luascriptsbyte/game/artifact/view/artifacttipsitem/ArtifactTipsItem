        return GetLangPackValue(90022300084, index, GetLangPackValue(card_skills_cfg[id].describe1))
    else
        return GetLangPackValue(90022300084, index, id)
    end
end

---展示属性
---@param data ArtifactData
function ArtifactTipsItem:ShowPropByCfg(data)
    local ChildCount = self.go_table.obj_PropContent:GetChildCountE()
    if ChildCount > 0 then
        for i = 1, ChildCount do
            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_PropContent:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    local attrDic = data:GetAttrDict()
    local numStr, num, tb, tran, key, showList
    local showProp = function(prop)
        showList = {}
        for i, v in pairs(prop) do
            _G.table.insert(showList, {key = v[1], sortId = _G.AttrType[v[1]].sortid, num = v[2], isPer = v[3]})
        end
        _G.SortList(
            showList,
            function(a)
                return -a.sortId
            end
        )
        local index = 0
        for _, v in pairs(showList) do
            index = index + 1
            key = v.key
            tran = _G.InstantiateObject(self.go_table.obj_BaseProp, self.go_table.obj_PropContent)
            if tran then
                tb = _G.GetAutoGoTable(tran)
                if index % 2 == 0 then
                    tb.aorimage_Bg:SetActiveE(1)
                end
                tb.aortext_Name.text = _G.AttrType[key].des
                num = v.num
                if _G.AttrType[key].percentage == 1 or v.isPer then
                    num = num * 100
                    num = _G.GameUtil.FormatNum(num)
                    numStr = tostring(num) .. "%"
                else
                    num = _G.math.floor(num)
                    numStr = _G.GameUtil.NumberWY(num)
                end
                tb.aortext_Num.text = "<color=#6effc6>" .. numStr .. "</color>"
            end
        end
    end
    showProp(attrDic.base)
    showProp(attrDic.other)
    self.go_table.obj_BaseProp:SetActiveE(0)
end

---设置属性(弃用)
------@param data ArtifactData
function ArtifactTipsItem:ShowProp(data)
    local ChildCount = self.go_table.obj_PropContent:GetChildCountE()
    if ChildCount > 0 then
        for i = 1, ChildCount do
            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_PropContent:GetChildE(0), _G.ePoolType.UIItem)
        end
    end

    local numStr, num, tb, tran, key, showList
    local showProp = function(prop, isPer)
        showList = {}
        for i, v in pairs(prop) do
            if v > 0 then
                table.insert(showList, {key = i, sortId = _G.AttrType[i].sortid})
            end
        end
        _G.SortList(
            showList,
            function(a)
                return -a.sortId
            end
        )
        for _, v in pairs(showList) do
            key = v.key
            tran = _G.InstantiateObject(self.go_table.obj_BaseProp, self.go_table.obj_PropContent)
            if tran then
                tb = _G.GetAutoGoTable(tran)
                tb.aortext_Name.text = _G.AttrType[key].des
                num = prop[key]
                if _G.AttrType[key].percentage == 1 or isPer then
                    num = num * 100
                    num = _G.GameUtil.FormatNum(num)
                    num = tostring(num) .. "%"
                    numStr = "<color=#5bdf99>" .. num .. "</color>"
                else
                    num = _G.math.floor(num)
                    num = _G.GameUtil.NumberWY(num)
                    numStr = "<color=#5bdf99>" .. num .. "</color>"
                end
                tb.aortext_Num.text = numStr
            end
        end
    end
    local prop = data.attribute:GetAttrByName()
    showProp(prop)
    prop = data.attribute:GetAttrByName(_G.AttCountType.basePercent)
    showProp(prop, true)

    self.go_table.obj_BaseProp:SetActiveE(0)
end

---@private
function ArtifactTipsItem:ShowBtn()
    self.go_table.obj_Self:SetActiveE(self.isSelf and 1 or 0)
    if self.btn == nil then
        self.go_table.obj_Btn:SetActiveE(0)
        self.go_table.obj_scrollloop_vectical:SetRectTransformSize(406, 532)
        return
    end
    self.go_table.obj_scrollloop_vectical:SetRectTransformSize(406, 440)
    if self.btn.left then
        self.go_table.aorbtn_left:SetActiveE(1)
        self.go_table.aortext_BtnLeftName.text = self.btn.left.name
        if self.btn.left.redPoint then
            self.go_table.obj_redpointLeft:UpdateRedPointItemIDAndParam(
                self.btn.left.redPoint[1],
                self.btn.left.redPoint[2]
            )
        end
    end
    if self.btn.middle then
        self.go_table.aorbtn_middle:SetActiveE(1)
        self.go_table.aortext_BtnMiddleName.text = self.btn.middle.name
        if self.btn.middle.redPoint then
            self.go_table.obj_redpointMiddle:UpdateRedPointItemIDAndParam(
                self.btn.middle.redPoint[1],
                self.btn.middle.redPoint[2]
            )
        end
    end
    if self.btn.right then
        self.go_table.aorbtn_right:SetActiveE(1)
        self.go_table.aortext_BtnRightName.text = self.btn.right.name
        if self.btn.right.redPoint then
            self.go_table.obj_redpointRight:UpdateRedPointItemIDAndParam(
                self.btn.right.redPoint[1],
                self.btn.right.redPoint[2]
            )
        end
    end
end

---按钮点击事件在这里派发
function ArtifactTipsItem:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_left" then
        self.btn.left.func()
        if self.btn.left.close then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DecorationTipsView.Name)
        end
    elseif name == "@_aorbtn_middle" then
        self.btn.middle.func()
        if self.btn.middle.close then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DecorationTipsView.Name)
        end
    elseif name == "@_aorbtn_right" then
        self.btn.right.func()
        if self.btn.right.close then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DecorationTipsView.Name)
        end
    end
end

function ArtifactTipsItem:Dispose()
    self.go_table = nil
    self.Components = nil
    self.gameObject = nil
    self.transform = nil
    self.CacheListener = nil
    self.view = nil
    self.cards = nil
end

return ArtifactTipsItem
