---类的构造函数
function ArtifactTipsItem:__init()
end

---设置参数
---@param dData EquipmentItem 饰品数据类
---@param isSelf boolean 是否是当前穿戴(当此参数为true，则btn不生效，反之)
---@param btn table {left = {name = string ,onclickFunc = function },right = {name = string ,onclickFunc = function }}
---@param tran transform tran
function ArtifactTipsItem:SetData(dData, isSelf, btn, tran, hideSP)
    if not dData then
        return
    end
    self.data = dData
    self.isSelf = isSelf
    self.btn = btn
    self.gameObject = tran
    self.hideSP = hideSP
    self.go_table = _G.GetAutoGoTable(tran, _G.handler(self, self.OnClickBtn))
    self:InitView()
end

---初始化界面
---@param data ArtifactData
---@param btn table {left = {name = string, func = function, close = boolean},right = {...}, middle = {...}}
function ArtifactTipsItem:InitView()
    self:ShowBase(true)
    -- self:ShowProp(self.data)
    self:ShowPropByCfg(self.data)
    self:ShowSkill()
    self:ShowBtn()
    _G.GameUtil.ReBuildRTF(self.go_table.obj_ArtifactlDescribe)
    _G.GameUtil.ReBuildRTF(self.go_table.obj_parent1)
    _G.GameUtil.ReBuildRTF(self.go_table.obj_parent)
end

---@private
function ArtifactTipsItem:ShowBase(hideCount)
    local order = self.data:GetCfg().Order + 4
    if order == 7 then
        order = 8
    end
    local outlineColor = _G.ColorTools.FormatColorByString(CommonTipManager:GetTipTypeNameOutLineColorByGrade(order))
    self.go_table.aortext_name.text = self.data:GetName()
    CommonTipManager:SetItemTextGradient(self.go_table.aortext_name, order)

    self.go_table.aortext_name:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor
    self.go_table.aortext_level.text =
        _G.GetLangPackValue(90021800050) .. "<color=#ffd65b>" .. self.data:GetLevel() .. "</color>"
    self.go_table.aortext_level:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor

    self.go_table.aortext_power.text =
        _G.GetLangPackValue(90000000404,
        "<color=#ffd65b>" .. _G.GameUtil.NumberToUnitStrBag(self.data:GetPower()) .. "</color>")
    self.go_table.aortext_power:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor

    --self.go_table.aortext_name.color = CommonTipManager:GetInstance():Get
    -- self.go_table.aortext_level.color = OrderCfg[order][2]
    -- self.go_table.aortext_power.color = OrderCfg[order][2]
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[CommonTipManager:GetItemBgEffectPathByGrade(order)],
            self.go_table.obj_EffNode
    )
    self.go_table.aorrawimage_gradeBG:LoadImage(
            CommonTipManager:GetItemBgPathByGrade(order),
        function(trans)
            if self.go_table == nil then
                _G.DestroyObject(trans)
            end
        end
    )
    -- local star = self.data:GetStar()
    -- for i = 1, 5 do
    --     self.go_table["aorimage_tStar" .. i]:SetActiveE(i <= star and 1 or 0)
    -- end
    _G.ItemFactory:GetInstance():GetItemCard(
        _G.ItemFactory.itemType.ItemArtifactBase,
        self.go_table.obj_item,
        function(item)
            item:ShowData(
                self.data,
                function()
                end
            )
            item:HideLevel()
            -- item:HideStar()
            if hideCount then
                item:HideCount()
            end
            if self.data.cardUid == 0 then
                item:ShowOrHideProfessional(true)
            end
            item:SetSize(80)
            if self.data:GetOrder()>=3 then
                item:ShowEffectOrder(true)
                --item.go_table.obj_uieffect:SetLocalScale(0.8,0.8)
            end
        end
    )
end

---点击超链接
function ArtifactTipsItem:OnHrefClick(id, name, asa)
    local cfg = self.data:GetCfg()
    local rect = self.go_table.obj_ArtifactlDescribe:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    local posX, posY = rect:GetRectTransformWidthHeight()
    if not self.hideSP and self.go_table.obj_SPSkillDescribe and cfg.card_id > 0 then
        local rect1 = self.go_table.obj_SPSkillDescribe:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
        local width, height = rect1:GetRectTransformWidthHeight()
        ---因为右侧多了一个界面，所以需要偏移一个view的宽度
        posX = posX - width
        posY = height / -2 + 30
    end
    require("CommonTipManager"):GetInstance():OpenSkillHyper(_G.tonumber(id), nil, posX, posY)
end

---显示技能
function ArtifactTipsItem:ShowSkill()
    local cfg = self.data:GetCfg()
    --self.go_table.aortext_skillSP1:SetActiveE(0)
    local str=require("ArtifactModel").GetStarSkillDes(cfg.id, 0)
    if string.contains(str,"<color=#FC9948>（专属）</color>") then
        str=string.replace(str,"<color=#FC9948>（专属）</color>","")
    end
    local tb
    if  not self.hideSP and cfg.card_id > 0 then
        self.go_table.obj_zhuanshuskill:SetActiveE(1)
        self.go_table.obj_putongskill:SetActiveE(0)
        tb= _G.GetAutoGoTable(self.go_table.obj_zhuanshuskill)
        local cardTb = _G.GetAutoGoTable(tb.obj_zhuanshutag)
        local cardCfg = _G.ConfigManager.card_cfg[cfg.card_id] and _G.ConfigManager.card_cfg[cfg.card_id] or nil
        if cardCfg then
            cardTb.aorimage_icon.SpriteName = _G.ConfigManager.card_cfg[cfg.card_id].Icon
        end
    else
        self.go_table.obj_zhuanshuskill:SetActiveE(0)
        self.go_table.obj_putongskill:SetActiveE(1)
        tb= _G.GetAutoGoTable(self.go_table.obj_putongskill)
    end
    local skillDesExText = tb.obj_baseSkill:GetComponentE(_G.typeof(_G.CS.ExtendText))
    skillDesExText.text =str
    skillDesExText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))

    for i = 1, #cfg.skill_id - 1 do
        local obj = _G.InstantiateObject(self.go_table.obj_skillItem, self.go_table.trans_content)
        local tb = _G.GetAutoGoTable(obj)
        tb.DesExText = tb.obj_upDes:GetComponentE(_G.typeof(_G.CS.ExtendText))
        local color = self.data.star < i and "A9A9A37F" or "76DAF8FF"
        tb.DesExText.color = _G.ColorTools.FormatColorByString(color)
        local killiszhuanshu=0
        local skillstr = require("ArtifactModel").GetStarSkillDes(cfg.id, i)
        local tempStr = _G.GetLangPackValue(90000010475, i)
        if string.contains(tempStr,"星") then
            --小程序无法显示对应占位符，改为不替换文本，用改小的两个*占位
            tempStr = string.replace(tempStr,"星","<color=#00000000>**</color>")
            tb.obj_star:SetActiveE(1)
            if i >= 10 then
                tb.obj_star:SetAnchorPosition(-45, -2)
            else 
                tb.obj_star:SetAnchorPosition(-57, -2)
            end
        else 
            tb.obj_star:SetActiveE(0)
        end
        if string.contains(skillstr,"<color=#FC9948>（专属）</color>") then
            --ZHJH-9132 小程序无法显示对应占位符，改为不替换文本，将图片置于文本之上
            --skillstr=string.replace(skillstr,"<color=#FC9948>（专属）</color>","\u{2003}\u{2003}\u{2003}\u{2003}")
            killiszhuanshu=1
            if i >= 10 then
                tb.obj_zhuanshu:SetAnchorPosition(8.5, -2)
            else 
                tb.obj_zhuanshu:SetAnchorPosition(-2, -2)
            end
            -- if _G.GameUtil.IsUsedEnglish() then
            --     tb.obj_zhuanshu:SetAnchorPosition(29, -2)
            -- end
        end
        tb.obj_zhuanshu:SetActiveE(killiszhuanshu)
        tb.DesExText.text = tempStr .. ":".. skillstr
        tb.DesExText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))
    end

    self.go_table.obj_Star:SetActiveE(1)
    if #cfg.skill_id <= 1 or cfg.Order < 3 then
        self.go_table.obj_gap:SetActiveE(0)
        self.go_table.obj_skills:SetActiveE(0)
        self.go_table.obj_Star:SetActiveE(0)
    end
    if not self.hideSP and cfg.card_id > 0 then
        self.go_table.aortext_starUp.text = _G.GetLangPackValue(90022300143)
        self:ShowSPSkill(cfg)
    else
        self.go_table.obj_card:SetActiveE(0)
        self.go_table.aortext_starUp.text = _G.GetLangPackValue(90022300049)
    end
end

