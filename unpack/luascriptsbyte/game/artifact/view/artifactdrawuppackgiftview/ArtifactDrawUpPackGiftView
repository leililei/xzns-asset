function ArtifactDrawUpPackGiftView:RefreshList(index, obj)
    index = index + 1
    local needNum = self.cfg.rewards_count[index]
    local freeAwards = self.cfg.rewards_item[index]
    local gift = self.cfg.rewards_goods[index]
    local payCfg = store_extra_cfg[gift[1]]
    ---@type ArtifactDrawUpPackGiftView._obj_item_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, index, payCfg))
    local canGet = self.totalDrawNum >= needNum
    local selfCanGet = false
    if index <= #self.cfg.rewards_count and self.totalDrawNum >= self.cfg.rewards_count[index] then
        selfCanGet = true
    end
    local lastTime = payCfg.count_limit -
        require("ArtifactDrawUpMainModel"):GetInstance():GetCashGiftBuyNum(self.ActivityID, gift[1])
    if lastTime < 0 then
        lastTime = 0
    end
    _G.GameUtil.AddDouYinIcon(tb.aorbtn_buy, true, nil, nil, nil, payCfg.price_id)

    local soldOut = lastTime == 0
    local freeGet = require("ArtifactDrawUpMainModel"):GetInstance():GetLingQu(self.ActivityID, index)
    tb.aortext_num.text = needNum
    tb.aortext_limite.text = GetLangPackValue(90023800079, lastTime, payCfg.count_limit)
    tb.aortext_limite:SetActiveE(soldOut and 0 or 1)
    --tb.aorimage_bgCur:SetActiveE(canGet and 1 or 0)
    tb.aorimage_sliderBg:SetActiveE(index <= #self.cfg.rewards_count and 1 or 0)
    tb.aorimage_slider:SetActiveE(selfCanGet and 1 or 0)
    tb.aorbtn_buy:SetGray(not canGet)
    tb.aorbtn_buy:GetComponentE(_G.typeof(_G.CS.AorImage)).color = _G.ColorTools.FormatColorByString(canGet and "FFFFFF" or "A9A9A9")
    tb.aortext_price.color = _G.ColorTools.FormatColorByString(canGet and "8C2D14" or "434343")
    -- if not canGet then
    --     tb.aortext_price.color = _G.ColorTools.FormatColorByString("8C2D14")
    -- end
    tb.aorbtn_buy:SetActiveE(soldOut and 0 or 1)
    tb.obj_soldout:SetActiveE(soldOut and 1 or 0)
    tb.aorbtn_clickObj:SetActiveE((canGet and not freeGet) and 1 or 0)
    _G.GameUtil.SetPriceByChannel(payCfg.price_id, tb.aortext_price)

    --tb.obj_AwardNodeFree:ClearChildren()
    --tb.obj_AwardNodeBuy:ClearChildren()
    tb.obj_item1:ClearChildren()
    tb.obj_item2:ClearChildren()
    local array = #freeAwards == 1 and { self.coinId, freeAwards[1] } or freeAwards
    self:SetItem(array, tb, tb["obj_item1"], freeGet, canGet)
    if gift[2] > 0 then
        self:SetItem({ self.coinId, gift[2] }, tb, tb["obj_item2"], soldOut, canGet)
    end
    for _, v in pairs(payCfg.goods) do
        self:SetItem(v, tb, tb["obj_item2"], soldOut, canGet)
    end
    obj:SetName(index)
    if not table.ContainsValue(self.itemList, obj) then
        self.itemList[index] = obj
    end
    for i = 1, #self.itemList do
        _G.SortList(
            self.itemList,
            function(a)
                return -a:GetName()
            end
        )
        self.itemList[i]:SetSiblingIndexE(i)
    end
end

function ArtifactDrawUpPackGiftView:SetItem(array, tb, parent, setGou, canGet)
    local obj = _G.InstantiateObject(tb.obj_item21, parent)
    obj:SetLocalPositionToZero()
    local goTable = _G.GetAutoGoTable(obj)
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        array,
        goTable.obj_itemRoot,
        function(item)
            --item:SetGou(setGou)
            if item.ShowNumText then
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
            item.gameObject:SetRectTransformSize(78, 78)
            item.gameObject:SetLocalScaleXYZ(0.88)
            local grade, type = _G.StorageManager:GetInstance():GetItemGrade(array[1])
            if grade > 3 then
                item:ShowEffect(canGet and not setGou)
            end
            if item.HideOrShowLevel then 
                item:HideOrShowLevel(false)
            end 
            if item.HideOrShowSpEffect then 
                item:HideOrShowSpEffect(false)
            end 
            if item.ShowCount then 
                item:ShowCount(array[2])
            end
        end
    )
    goTable.obj_gou:SetActiveE(setGou and 1 or 0)
    goTable.obj_suo:SetActiveE(not canGet and 1 or 0)
end

function ArtifactDrawUpPackGiftView:UpdateView()
    self.go_table.scrollloopvectical_item:UpdateAllItem()
end

function ArtifactDrawUpPackGiftView:OnClickItem(go, isOn, index, cfg)
    local needNum = self.cfg.rewards_count[index]
    if self.totalDrawNum < needNum then
        return
    end
    local name = go:GetName()
    if name == "@_aorbtn_clickObj" then
        require("ArtifactDrawUpMainModel"):GetInstance():GetAwarddata(
            self.ActivityID,
            index,
            _G.handler(self, self.UpdateView)
        )
    elseif name == "@_aorbtn_buy" then
        require("MallManager"):GetInstance():BuyActiveGift(cfg.price_id, self.ActivityID, cfg.id)
    end
end

function ArtifactDrawUpPackGiftView:OnMallCashListener(data)
    self:UpdateView()
end

function ArtifactDrawUpPackGiftView:OnClickBtn(go, _)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

function ArtifactDrawUpPackGiftView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

return ArtifactDrawUpPackGiftView
