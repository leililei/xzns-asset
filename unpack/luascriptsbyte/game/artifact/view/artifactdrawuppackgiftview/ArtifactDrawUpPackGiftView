function ArtifactDrawUpPackGiftView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.itemList = {}
end

---界面的入口函数
function ArtifactDrawUpPackGiftView:OnCreate(activity)
    self.activity = activity
    self.ActivityID = activity.activityID
    local ArtifactDrawUpMainModelIns = require("ArtifactDrawUpMainModel"):GetInstance()
    self.coinId = ArtifactDrawUpMainModelIns:GetCoinId(self.ActivityID)
    self.cfg = ArtifactDrawUpMainModelIns:Getlimited_roller_cfg(self.ActivityID)
    self.totalDrawNum = ArtifactDrawUpMainModelIns:GetTotalTimes(self.ActivityID)
    self.countDown = ArtifactDrawUpMainModelIns:GetTime(self.ActivityID)
    self.go_table.aortext_time.text = GetLangPackValue(langugageId.time, _G.TimeUtil.TranslateSecondForStrMiaoHui(self.countDown))
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()
    self:AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    self:InitView()
    if _G.AppSetting.IsXzns then
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.ArtifactDrawUpPackGiftLogin, _G.TimeUtil.GetDayBegin(_G.TimeUtil.GetServerUnixTime()))
        ArtifactDrawUpMainModelIns.activityList[self.ActivityID].activity.typeClass:RefreshRedPoint(2)
    end
end

function ArtifactDrawUpPackGiftView:UpdateTime(elapsed)
    if self:IsNil() then
        return
    end
    self.countDown = self.countDown - elapsed
    if self.countDown < 0 then
        self.countDown = 0
    end
    local time = _G.Mathf.RoundToInt(self.countDown)
    self.go_table.aortext_time.text = GetLangPackValue(langugageId.time, _G.TimeUtil.TranslateSecondForStrMiaoHui(time))
end

