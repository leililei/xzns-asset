    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_CloseViewAny then
        self:CloseView()
    elseif go == self.go_table.aorbtn_all then
        self:ChangeProfession(0)
    elseif go == self.go_table.aorbtn_warrior then
        self:ChangeProfession(3)
    elseif go == self.go_table.aorbtn_ranger then
        self:ChangeProfession(2)
    elseif go == self.go_table.aorbtn_master then
        self:ChangeProfession(1)
        -- elseif go == self.go_table.aorbtn_tank then
        --     self:ChangeProfession(PlayerTreeID.tank)
        -- elseif go == self.go_table.aorbtn_support then
        --     self:ChangeProfession(PlayerTreeID.support)
        -- elseif go == self.go_table.aorbtn_add then
        --     self:AutoPutOn()
        -- elseif go == self.go_table.aorbtn_tachie then
        --     self:OpenTipView(self.cardData.ArtifactBar)
    elseif go == self.go_table.aorbtn_go then
        _G.JumpManager:GetInstance():Jump(169001)
    end
end

return ArtifactWearView
