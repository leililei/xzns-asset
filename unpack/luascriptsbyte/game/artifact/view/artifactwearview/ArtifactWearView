---脱下神器
function ArtifactWearView:TakeOffArtifact(cardData, isOther, call)
    cardData = cardData or self.cardData
    if not _G.StorageManager:GetInstance():CheckSize(_G.StorageID.Artifact, 1) then
        _G.PopWindowManager:GetInstance():ShowAllTips(270801)
        return
    end
    self.power = _G.StorageManager:GetInstance():GetPlayerPower()
    self.lastCardProp = _G.GameUtil.GetPropUpData(self.cardData)
    ArtifactModel:GetInstance():TakeOffArtifact(
        cardData,
        function()
            if not isOther then
                self:UpdateArtifact()
                self:InitArtifactList()
                self:ChangeProfession(self.curProfession, true)
                --_G.UIUtils.ShowPropUp(cardData, self.lastCardProp)
                --local offset = _G.StorageManager:GetInstance():GetPlayerPower() - self.power
                --if offset > 0 then
                --    require "CommonTipManager".OpenPowerUpView(self.power, offset)
                --end
                self.closeCall()
            end
            if call then
                call()
            end
        end
    )
end

---自动穿戴
function ArtifactWearView:AutoPutOn()
    _G.SortList(
        self.artifactUidList[self.cardData:GetProfessional()],
        function(a)
            local dataA = self.artifactList[a]
            -- 神器是否是角色专属
            local exclusive = 0
            if self.cardData.sid == dataA.cfg.card_id then
                exclusive = 1
            end
            return exclusive, dataA.awaken, dataA:GetOrder(), dataA.star, dataA.lv, ProfSort[dataA:GetProfessional()],
                dataA.sid, dataA.uid
        end
    )
    for _, v in pairs(self.artifactUidList[self.cardData:GetProfessional()]) do
        if self.artifactList[v].cardUid == 0 then
            self:TryToPutOnArtifact(self.artifactList[v])
            return
        end
    end
    _G.SortList(
        self.artifactUidList[PlayerTreeID.none],
        function(a)
            local dataA = self.artifactList[a]
            return dataA.awaken, dataA:GetOrder(), dataA.star, dataA.lv, ProfSort[dataA:GetProfessional()], dataA.sid,
                dataA.uid
        end
    )
    for _, v in pairs(self.artifactUidList[PlayerTreeID.none]) do
        if self.artifactList[v].cardUid == 0 then
            self:TryToPutOnArtifact(self.artifactList[v])
            _G.PopWindowManager:GetInstance():ShowAllTips(271701)
            return
        end
    end
    _G.PopWindowManager:GetInstance():ShowAllTips(271201)
end

---培养神器
function ArtifactWearView:DevelopArtifact(artifactData)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ArtifactDevelopView.Name,
        artifactData,
        function()
            self:InitArtifactList()
            self:UpdateArtifact()
            self:ChangeProfession(self.curProfession, true)
        end
    )
end

---培养当前角色神器
function ArtifactWearView:DevelopCurrentArtifact()
    if _G.table.isEmptyOrNil(self.cardData.ArtifactBar) then
        return
    end
    self:DevelopArtifact(self.cardData.ArtifactBar)
end

function ArtifactWearView:UpdateTime(elapsed)
    self.countDown = self.countDown - elapsed
    if self.countDown < 0 then
        self.countDown = 0
    end
    if self.countDown > 0 then
        local timeStr = TimeUtil.TimeToString(_G.Mathf.RoundToInt(self.countDown), 1)
        self.go_table.aortext_timer.text = GetLangPackValue(90022300101, "<color=#5bdf99>" .. timeStr .. "</color>")
    else
        self.go_table.aortext_timer.text = ""
    end
end

function ArtifactWearView:OnArtifactTimeOver()
    self:InitArtifactList()
    self:UpdateArtifact()
    self:ChangeProfession(self.curProfession, true)
end

---界面的销毁函数
function ArtifactWearView:OnDestroy()
    self:RemoveListener(_G.ArtifactShow.ArtifactTimeOver, self.OnArtifactTimeOver)
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---@private
function ArtifactWearView:CloseView()
    if not _G.IsNil(self.sceneTrans) then
        _G.PoolsManager:GetInstance():Despawn(self.sceneTrans, _G.ePoolType.Static)
        self.sceneTrans = nil
    end
    if self.closeCall then
        self.closeCall()
    end
    self:Close()
end

function ArtifactWearView:OnClickRecommend(go, isOn)
    if not self.showRecommend then
        return
    end
    if self.cardData.cfg.Order >= 6 then
        local cfg = _G.ConfigManager.artifact_cfg[self.artifactId]
        local openDay = cfg.condition_type[1][2] + 2--神器固定比角色晚两天开启
        local curDay = _G.TimeUtil.GetIntervalDay(
            _G.PlayerModel:GetInstance():GetServerOpenTime(),
            _G.TimeUtil.GetServerUnixTime()
        )
        if curDay >= openDay then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SevenGiftView.Name)
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(1, _G.GetLangPackValue(90028300082, openDay - curDay))
        end
    else
        _G.JumpManager:GetInstance():Jump(169001)
    end
end

---按钮点击事件在这里派发
