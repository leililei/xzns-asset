    if profession ~= self.curProfession or force then
        self.curIndex = 1
        self.curProfession = profession
        self.go_table.aorimage_select:SetParentE(self.professionBtn[profession])
        self.go_table.aorimage_select:SetLocalPosition(profession == PlayerTreeID.none and 0 or -1, 0, 0)
        if profession == PlayerTreeID.none then
            -- _G.SortList(
            --     self.artifactUidList[profession],
            --     function(a)
            --         local dataA = self.artifactList[a]
            --         return dataA.awaken, dataA:GetOrder(), dataA.star, dataA.lv, ProfSort[dataA:GetProfessional()],
            --             dataA.sid, dataA.uid
            --     end
            -- )
        else
            -- _G.SortList(
            --     self.artifactUidList[profession],
            --     function(a)
            --         local dataA = self.artifactList[a]
            --         --- local sort1 = dataA.cardUid == 0 and 1 or 0
            --         return dataA.awaken, dataA:GetOrder(), dataA.star, dataA.lv, dataA.sid, dataA.uid
            --     end
            -- )
        end
        self.curUidList = {}
        ---@type ArtifactData
        local data
        local insert = table.insert
        for _, uid in ipairs(self.artifactUidList[profession]) do
            data = self.artifactList[uid]
            for j = 1, data.count do
                insert(self.curUidList, uid)
            end
            if data.cardUid == self.cardData.uid then
                self.curIndex = #self.curUidList
            end
        end
        local count = #self.curUidList
        self.go_table.scrollloopvectical_artifact:UpdateCount(count)
        if self.curIndex > 11 then
            self.go_table.scrollloopvectical_artifact:ScrollToIndex(self.curIndex - 1)
        end

        self.go_table.obj_Empty:SetActiveE(count <= 0 and 1 or 0)
    end
end

---职业不符时二次确认
---@param artifactData ArtifactData
function ArtifactWearView:ConfirmToPutOnArtifact(artifactData)
    if artifactData:GetProfessional() ~= self.cardData:GetProfessional() then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            271601,
            nil,
            _G.handlerbind(self, self.TryToPutOnArtifact, artifactData)
        )
    else
        self:TryToPutOnArtifact(artifactData)
    end
end

---预穿戴神器（神器已被其它角色穿戴则先脱下）
---@param artifactData ArtifactData
function ArtifactWearView:TryToPutOnArtifact(artifactData)
    if artifactData.cardUid > 0 then
        self.lastCardProp = _G.GameUtil.GetPropUpData(self.cardList[artifactData.cardUid])
        if artifactData.cardUid==self.cardData.uid then
            self:TakeOffArtifact(
                    self.cardList[artifactData.cardUid],
                    true,
                    function()
                        self.power = _G.StorageManager:GetInstance():GetPlayerPower()
                        require("CardInfoManager"):GetInstance():Updata_CardViewUpdataFun(self.cardData, true)
                        self.closeCall()
                    end)
        else
            self:TakeOffArtifact(
                    self.cardList[artifactData.cardUid],
                    true,
                    _G.handlerbind(self, self.PutOnArtifact, artifactData)
            )
            end
    else
        self.power = _G.StorageManager:GetInstance():GetPlayerPower()
        self.lastCardProp = _G.GameUtil.GetPropUpData(self.cardData)
        self:PutOnArtifact(artifactData)
    end
end

