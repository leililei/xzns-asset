---@param closeCall function 关闭回调
function ArtifactWearView:OnCreate(cardData, closeCall)
    self.cardData = cardData
    self.closeCall = closeCall
    self.lastCardProp = _G.GameUtil.GetPropUpData(cardData)
    --self:LoadScene() --角色背包界面场景移动
    self.curIndex = 1
    self.cardItemList = {}
    self.cardList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    if self.cardData:GetStar() < minStar then
        self.cardData = self.cardList[self.cardUidList[1]]
    end
    self.specialDesc = self.go_table.obj_specialDes:GetComponentE(_G.typeof(_G.CS.ExtendText))
    self.baseDesColor = self.specialDesc.color
    self:InitArtifactList()
    self:UpdateArtifact()
    self.go_table.scrollloopvectical_artifact:InitItemData(0, _G.handler(self, self.RefreshArtifactList))

    self:ChangeProfession(PlayerTreeID.none)
    self.artifactId = self.cardData.cfg.artifactid
    self.showRecommend = self.artifactId ~= 0
    for _, v in pairs(self.artifactList) do
        if self.artifactId ~= 0 and v.cfg.id == self.artifactId then
            self.showRecommend = false
        end
    end
    self:UpdateRecommentArtifact()

    ---@type _obj_ArtifactTipView._obj_BaseProp_GoTable[]
    self.propList = {}
    self.countDown = 0
    -- self:UpdateArtifact()
    --local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.CardShowView.Name)
    --if ctrl then
    --    ctrl:Hide()
    --end
end

---初始化神器列表
function ArtifactWearView:InitArtifactList()
    self.artifactList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Artifact)
    self.artifactUidList = {
        [0] = {},
        [1] = {},
        [2] = {},
        [3] = {}
    }
    local list = {}
    for k, v in pairs(self.artifactList) do
        v.uidSort = k
        table.insert(list, v)
    end
    table.sort(
        list,
        function(a, b)
            local cradA = a:GetCfg().card_id or 0
            local cradB = b:GetCfg().card_id or 0
            local isCardA = cradA == self.cardData.sid and 1 or 0
            local isCardB = cradB == self.cardData.sid and 1 or 0

            if isCardA == 1 and isCardB == 1 then
                if a:GetOrder() == b:GetOrder() then
                    if a:GetPower() == b:GetPower() then
                        return a.uid > b.uid
                    else
                        return a:GetPower() > b:GetPower()
                    end
                else
                    return a:GetOrder() > b:GetOrder()
                end

            elseif isCardA == 0 and isCardB == 0 then
                  if a:GetOrder() == b:GetOrder() then
                    if a:GetPower() == b:GetPower() then
                        return a.uid > b.uid
                    else
                        return a:GetPower() > b:GetPower()
                    end
                else
                    return a:GetOrder() > b:GetOrder()
                end

            else
                return isCardA > isCardB
            end
        end
    )

    for i, v in pairs(list) do
        table.insert(self.artifactUidList[v:GetOrder()], v.uidSort)
        table.insert(self.artifactUidList[0], v.uidSort)
    end
end

---刷新神器列表
function ArtifactWearView:RefreshArtifactList(index, obj)
    index = index + 1
    local artifactData = self.artifactList[self.curUidList[index]]

    ---@type ArtifactWearView._obj_artItem_GoTable
    local tb = GetAutoGoTable(obj, handlerbind(self, self.OnClickArtifact, artifactData))
    if tb.obj_artifact:GetChildCountE() == 0 then
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemArtifactBase,
            tb.obj_artifact,
            function(item)
                if self:IsNil() then
                    _G.DestroyObject(item.gameObject)
                    return
                end
                tb.lua = item
                item:ShowData(artifactData)
                item.gameObject:SetLocalScaleXYZ(0.9)
                item:HideCount()
                self:UpdateSingleItem(tb, artifactData)
            end
        )
    else
        if tb.lua == nil then
            tb.lua = ItemArtifactBase.New(tb.obj_artifact:GetChildE())
        end
        tb.lua:ShowData(artifactData)
        self:UpdateSingleItem(tb, artifactData)
    end
end

function ArtifactWearView:UpdateSingleItem(go, data, isRecommend)
    local artifactData = data
    go.aortext_Name.text = artifactData:GetName()
    go.aortext_power.text = _G.GetLangPackValue(90025700007, "<color=#CC4432>" .. artifactData:GetPower() .. "</color>")

    local createHeadItem = function()
        if not go.headItem then
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.CardAllItem,
                go.obj_head,
                function(item)
                    if self:IsNil() then
                        _G.DestroyObject(item.gameObject)
                        return
                    end
                    go.headItem = item
                    local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card,
                            isRecommend and self.cardData.uid or artifactData.cardUid)
                    item:ShowCardData(cardData)
                    item.gameObject:SetLocalScaleXYZ(0.75)
                end
            )
        else
            local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, artifactData.cardUid)
            go.headItem:ShowCardData(cardData)
        end
    end
    if artifactData.cardUid == 0 then
        go.aortext_Done.text = _G.GetLangPackValue(isRecommend and 90027200021 or 90023400020)
        go.aortext_tips:SetActiveE(isRecommend and 1 or 0)
        go.obj_head:SetActiveE(isRecommend and 1 or 0)
        if isRecommend then
            go.aortext_tips.text = _G.GetLangPackValue(90022300162, _G.GetLangPackValue(self.cardData.cfg.Name))
            createHeadItem()
        end
    else
        if artifactData.cardUid == self.cardData.uid then
            go.aortext_Done.text = _G.GetLangPackValue(90012500501)
        else
            go.aortext_Done.text = _G.GetLangPackValue(90031300041)
        end
        go.aortext_tips:SetActiveE(1)
        go.obj_head:SetActiveE(1)

        createHeadItem()
    end
end

function ArtifactWearView:UpdateRecommentArtifact()
    local tb = _G.GetAutoGoTable(self.go_table.obj_Recommend, _G.handlerbind(self, self.OnClickRecommend))
    local recommendData = _G.ArtifactData.New()
    self.go_table.obj_Recommend:SetActiveE(self.showRecommend and 1 or 0)
    local x = self.go_table.obj_ArtifactList:GetRectTransformSize()
    self.go_table.obj_ArtifactList:SetRectTransformSize(x, self.showRecommend and height[2] or height[1])
    self.go_table.obj_Empty:SetLocalPosition(0, self.showRecommend and position[2] or position[1])
    if self.showRecommend then
        local cfg = _G.ConfigManager.artifact_cfg[self.artifactId]
        local msg = {
            sid = self.artifactId,
            star = cfg.Star,
            level = _G.table.count(_G.ConfigManager.artifact_level_cfg)
        }
        recommendData:ParseInitMsg(msg)
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemArtifactBase,
            tb.obj_artifact,
            function(item)
                if self:IsNil() then
                    _G.DestroyObject(item.gameObject)
                    return
                end
                tb.lua = item
                item:ShowData(recommendData)
                item.gameObject:SetLocalScaleXYZ(1)
                item:HideCount()
                self:UpdateSingleItem(tb, recommendData, true)
            end
        )
    end
end

