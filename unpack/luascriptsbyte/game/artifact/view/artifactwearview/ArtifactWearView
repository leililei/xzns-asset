function ArtifactWearView:OpenTipView(artifactData)
    local btnDevelop = {
        name = GetLangPackValue(90020400065),
        func = handlerbind(self, self.DevelopArtifact, artifactData),
        close = true,
        redPoint = { _G.ConfigManager.redpoint_cfg.ArtifactUpgradeAny.id, artifactData.uid }
    }
    local btnTakeOff = {
        name = GetLangPackValue(90020400064),
        func = handlerbind(self, self.TakeOffArtifact),
        close = true
    }
    local btnPutOn = {
        name = GetLangPackValue(90023400020),
        func = handlerbind(self, self.ConfirmToPutOnArtifact, artifactData),
        close = true
    }
    local btnReplace = {
        name = GetLangPackValue(90020400047),
        func = handlerbind(self, self.ConfirmToPutOnArtifact, artifactData),
        close = true
    }
    -- _G.UIManager:GetInstance():OpenWindow(
    --     _G.ConfigManager.ui_cfg.CommonTipView.Name,
    --     _G.TipType.Artifact,
    --     artifactData,
    --     btn,
    --     true
    -- )
    local msg = {}
    local artifact = {}
    if _G.table.isEmptyOrNil(self.cardData.ArtifactBar) then --未穿戴
        artifact.data = artifactData
        if artifactData.type == _G.ArtifactDataType.Normal then
            artifact.btn = { left = btnDevelop, middle = btnPutOn }
        else
            artifact.btn = { left = btnPutOn }
        end
        artifact.isSelf = false
        table.insert(msg, artifact)
    elseif artifactData.cardUid == self.cardData.uid then --当前穿戴
        artifact.data = artifactData
        if artifactData.type == _G.ArtifactDataType.Normal then
            artifact.btn = { left = btnTakeOff, middle = btnDevelop }
        else
            artifact.btn = { left = btnTakeOff }
        end
        -- artifact.isSelf = true
        table.insert(msg, artifact)
    else --已穿戴且非当前穿戴
        artifact.data = self.cardData.ArtifactBar
        -- artifact.btn = {middle = btnTakeOff, left = btnDevelop}
        artifact.isSelf = true
        artifact.hideSP = false

        local artifact1 = {}
        artifact1.data = artifactData
        if artifactData.type == _G.ArtifactDataType.Normal then
            artifact1.btn = { left = btnDevelop, middle = btnReplace }
        else
            artifact1.btn = { left = btnReplace }
        end
        artifact1.isSelf = false
        artifact1.hideSP = false

        --检测二者是否都有专属技能
        local bothHasSpSkill = true
        local cfg = artifact.data:GetCfg()
        local cfg1 = artifact1.data:GetCfg()
        if cfg.card_id <= 0 or cfg1.card_id <= 0 then
            bothHasSpSkill = false
        end

        if bothHasSpSkill then
            artifact.setSmallScale = true
            artifact1.setSmallScale = true
        else
            artifact.setSmallScale = false
            artifact1.setSmallScale = false
        end

        table.insert(msg, artifact)
        table.insert(msg, artifact1)
    end

    local arg = 2
    for k, v in ipairs(msg) do
        local quality = v.data:GetOrder()
        if quality ~= nil and quality == 3 then
            arg = 5
            break
        end
    end
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.ArtifactUpgrade.id)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecorationTipsView.Name, msg, arg)
end

