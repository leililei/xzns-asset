---显示属性
---@param artifactData ArtifactData
function ArtifactWearView:ShowProp(artifactData)
    local index = 1
    local numStr, num, tb, tran, key, showList
    local showProp = function(prop, isPer)
        showList = {}
        for i, v in pairs(prop) do
            if v > 0 then
                table.insert(showList, { key = i, sortId = _G.AttrType[i].sortid })
            end
        end
        _G.SortList(
            showList,
            function(a)
                return -a.sortId
            end
        )
        for _, v in pairs(showList) do
            key = v.key
            tran = self.propList[index]
            if tran == nil then
                tran = _G.InstantiateObject(self.go_table.obj_BaseProp, self.go_table.obj_PropContent)
                self.propList[index] = tran
            end
            tran:SetActiveE(1)
            tb = _G.GetAutoGoTable(tran)
            tb.aortext_Name.text = _G.AttrType[key].des
            num = prop[key]
            if _G.AttrType[key].percentage == 1 or isPer then
                num = num * 100
                num = _G.GameUtil.FormatNum(num)
                num = tostring(num) .. "%"
                --numStr = "<color=#6effc6>+" .. num .. "</color>"
                numStr = "+" .. num
            else
                num = _G.math.floor(num)
                num = _G.GameUtil.NumberWY(num)
                numStr = "+" .. tostring(num)
            end
            tb.aortext_Num.text = numStr
            index = index + 1
        end
    end

    local attribute = artifactData:GetBaseAttr()
    local prop = attribute:GetAttrByName()
    showProp(prop)
    prop = attribute:GetAttrByName(_G.AttCountType.basePercent)
    showProp(prop, true)
    for i = index, #self.propList do
        self.propList[i]:SetActiveE(0)
    end
end

