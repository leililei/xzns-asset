local ItemArtifactBase = require("ItemArtifactBase")
local ArtifactDrawModel = require "ArtifactDrawModel"
local PlayerTreeID = _G.PlayerTreeID
local GetAutoGoTable = _G.GetAutoGoTable
local handlerbind = _G.handlerbind
local CardInfoManager = require("CardInfoManager"):GetInstance()

---@class ArtifactWishListView : UIBaseView    中文描述
---@field public go_table ArtifactWishListView_GoTable GoTable
local ArtifactWishListView = _G.BaseClass("ArtifactWishListView", _G.UIBaseView)


local bgColorPath = {
    "ui_biaoqian_hong",
    "ui_biaoqian_cheng",
    "ui_biaoqian_lv",
    "ui_biaoqian_zi",
}

function ArtifactWishListView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.scrollloopvectical_artifact:InitItemData(0, _G.handler(self, self.RefreshArtifactList))
    ---神器数据列表
    self.artifactDataList = {
        [PlayerTreeID.none] = {},
        [PlayerTreeID.tank] = {},
        [PlayerTreeID.warrior] = {},
        [PlayerTreeID.master] = {},
        [PlayerTreeID.support] = {},
        [PlayerTreeID.ranger] = {}
    }
    ---神器职业页签
    self.professionBtn = {
        [PlayerTreeID.none] = self.go_table.aorbtn_all,
        [PlayerTreeID.tank] = self.go_table.aorbtn_tank,
        [PlayerTreeID.warrior] = self.go_table.aorbtn_warrior,
        [PlayerTreeID.master] = self.go_table.aorbtn_master,
        [PlayerTreeID.support] = self.go_table.aorbtn_support,
        [PlayerTreeID.ranger] = self.go_table.aorbtn_ranger
    }
    ---可选中神器的数量
    self.selectArtifactNum = 1
    ---神器已选中Item
    self.selectArtifactItem = {}

    self.EmbattleModel = require "EmbattleModel":GetInstance()
end

---按钮点击事件在这里派发
function ArtifactWishListView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_closeX then
        ---遮罩或者关闭按钮

        self:Close()
    elseif go == self.go_table.aorbtn_all then
        self:ChangeProfession(PlayerTreeID.none)
    elseif go == self.go_table.aorbtn_warrior then
        self:ChangeProfession(PlayerTreeID.warrior)
    elseif go == self.go_table.aorbtn_ranger then
        self:ChangeProfession(PlayerTreeID.ranger)
    elseif go == self.go_table.aorbtn_master then
        self:ChangeProfession(PlayerTreeID.master)
    elseif go == self.go_table.aorbtn_tank then
        self:ChangeProfession(PlayerTreeID.tank)
    elseif go == self.go_table.aorbtn_support then
        self:ChangeProfession(PlayerTreeID.support)
    elseif go == self.go_table.aorbtn_selectItem1 then
        self:OnClickSelectItem(1)
    elseif go == self.go_table.aorbtn_selectItem2 then
        self:OnClickSelectItem(2)
    elseif go == self.go_table.aorbtn_selectItem3 then
        self:OnClickSelectItem(3)
    elseif go == self.go_table.aorbtn_help then
        ---TODO:策划还没有给id
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 118)
    elseif go == self.go_table.aorbtn_sure then
        self:OnSend()
        self:Close()
    end
end

---界面的入口函数
function ArtifactWishListView:OnCreate()
    self:InitArtifactData()
    ---已选中的数据,0是未选择（TODO:临时测试数据）
    self.selectArtifactData = ArtifactDrawModel:GetInstance():GetWishsids()
    self.selecID = self.selectArtifactData[1]
    ---默认显示全部
    self:ChangeProfession(PlayerTreeID.none)
    self:RefreshSelectArtifact()
    self.go_table.aortext_toptips.text = _G.GetLangPackValue(90022300068)
end

---初始化神器数据
function ArtifactWishListView:InitArtifactData()
    --TODO:临时测试数据
    -- _G.ConfigManager.item_roller_cfg[10100].wish_item
    local wishItemData = _G.ConfigManager.item_roller_cfg[10100].wish_item
    local artifactConfig = _G.ConfigManager.artifact_cfg
    for _, id in pairs(wishItemData) do
        local cfg = artifactConfig[id]
        if cfg then
            _G.table.insert(self.artifactDataList[cfg.Professional], id)
            _G.table.insert(self.artifactDataList[PlayerTreeID.none], id)
        end
    end
end

---更改当前选择职业
---@param profession number 职业
---@param force boolean 是否强制刷新
function ArtifactWishListView:ChangeProfession(profession, force)
    if profession ~= self.curProfession or force then
        self.curProfession = profession
        self.go_table.aorimage_select:SetParentE(self.professionBtn[profession])
        self.curArtifactData = self.artifactDataList[profession]
        self.go_table.scrollloopvectical_artifact:UpdateCount(#self.curArtifactData)
    end
end

---刷新神器列表
function ArtifactWishListView:RefreshArtifactList(index, obj)
    index = index + 1
    local artifactSid = self.curArtifactData[index]
    ---@type ArtifactWearView._obj_artItem_GoTable
    local tb = GetAutoGoTable(obj, handlerbind(self, self.OnClickArtifact, artifactSid))
    tb.aorimage_cardIcon:SetActiveE(1)
    tb.aorimage_cardBg:SetActiveE(1)
    ---神器名字
    local artifact_cfg = _G.ConfigManager.artifact_cfg[artifactSid]
    local cardId = artifact_cfg.card_id
    if cardId and cardId > 0 then
        local cardCfg = _G.ConfigManager.card_cfg[cardId]
        local icon = cardCfg.Icon
        if _G.string.contains(icon, "/") then
            icon = _G.string.split2tbl(icon, "/")
            icon = icon[#icon]
        end
        tb.aorimage_cardIcon.SpriteName = icon
        tb.aorimage_cardBg.SpriteName = CardInfoManager:GetHeadBgSpriteName(nil, 7)
    else
        tb.aorimage_cardIcon:SetActiveE(0)
        tb.aorimage_cardBg:SetActiveE(0)
    end
    local showArtifact = require("ArtifactModel"):GetInstance():GetMaxStarArtifactBySid(artifactSid)
    local cfg = _G.ConfigManager.artifact_star_cfg
    if cardId and cardId > 0 then
        -- 有专属角色
        tb.obj_progress:SetActiveE(1)
        tb.aortext_name:SetActiveE(0)
        if not showArtifact then
            -- 没有穿戴角色
            tb.obj_jindu:SetActiveE(1)
            tb.aortext_star:SetActiveE(1)
            tb.obj_maxStar:SetActiveE(0)
            tb.aortext_star.text = _G.GetLangPackValue(90000010475,0)
            tb.aortext_progress.text = 0 .. "/" .. 0
            tb.aorimage_activeSchedule:SetLocalScale(0,1,1)
        elseif not showArtifact:IsMaxStar() then
            -- 没有满星
            tb.obj_jindu:SetActiveE(1)
            tb.aortext_star:SetActiveE(1)
            tb.obj_maxStar:SetActiveE(0)
            tb.aortext_star.text = _G.GetLangPackValue(90000010475,showArtifact:GetStar() + 1)
            local count = showArtifact:SameCount()
            local needCount = cfg[100 + showArtifact:GetStar()].materials_oneself
            tb.aortext_progress.text = count .. "/" .. needCount
            if needCount <= count then
                tb.aorimage_activeSchedule:SetLocalScale(1,1,1)
            else
                tb.aorimage_activeSchedule:SetLocalScale(count/needCount,1,1)
            end
        else
            -- 满星
            tb.obj_jindu:SetActiveE(0)
            tb.aortext_star:SetActiveE(0)
            tb.obj_maxStar:SetActiveE(1)
        end
    else
        -- 没有专属角色
        tb.obj_progress:SetActiveE(0)
        --ZHJH-11479 不显示神器名称
        tb.aortext_name:SetActiveE(0)
        tb.obj_maxStar:SetActiveE(0)
        tb.aortext_name.text = _G.LangUtil.GetLangPackValue(artifact_cfg.Name)
    end
    tb.aorimage_tipsBg.SpriteName = bgColorPath[artifact_cfg.label[1]]
    tb.aortext_tipsname.text = _G.LangUtil.GetLangPackValue(artifact_cfg.label[2])

    if tb.obj_Root:GetChildCountE() == 0 then
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemArtifactBase,
            tb.obj_Root,
            function(item)
                if _G.IsNil(tb.obj_Root) then
                    return
                end
                tb.lua = item
                item:Show(artifactSid)
                item:SetSize(85)
                item:HideStar()
                item:HideLevel()
                if self.selecID == artifactSid then
                    tb.aorimage_choose:SetActiveE(1)
                    tb.aorimage_cardIcon:SetActiveE(0)
                    tb.aorimage_cardBg:SetActiveE(0)
                else
                    tb.aorimage_choose:SetActiveE(0)
                end
            end
        )
    else
        if tb.lua == nil then
            tb.lua = ItemArtifactBase.New(tb.obj_Root:GetChildE())
        end
        tb.lua:Show(artifactSid)
        tb.lua:SetSize(85)
        tb.lua:HideStar()
        tb.lua:HideLevel()
        if self.selecID == artifactSid then
            tb.aorimage_choose:SetActiveE(1)
            tb.aorimage_cardIcon:SetActiveE(0)
            tb.aorimage_cardBg:SetActiveE(0)
        else
            tb.aorimage_choose:SetActiveE(0)
        end
    end

    ---@type UnityEngine.UI.ScrollRect
    local scorll = self.go_table.scrollloopvectical_artifact:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect))
    ---设置升级按钮 长按事件
    -- _G.SetEventTrigger(tb.aorbtn_clickObj, "onDown", _G.handler(self, self.OnDownEvent, artifactSid))
    _G.SetEventTrigger(tb.aorbtn_clickObj, "onDrag", function(s, event)
        scorll:OnDrag(event)
    end)
    _G.SetEventTrigger(tb.aorbtn_clickObj, "onDragEnd", function(s, event)
        scorll:OnEndDrag(event)
    end)
    _G.SetEventTrigger(tb.aorbtn_clickObj, "onDragBegin", function(s, event)
        scorll:OnBeginDrag(event)
    end)
    -- tb.aorbtn_clickObj.LongPress = true
    -- tb.aorbtn_clickObj.onLongPress = _G.handlerbind(self, self.OnLongPressEvent, artifactSid)

    local StorageManager = _G.StorageManager:GetInstance()
    local itemData = StorageManager:GetItemDataClassByCfg({ artifactSid })
    local datas = StorageManager:GetDatasBySid(_G.StorageID.Artifact, itemData.sid)
    local cardList = {}
    if not _G.table.isEmptyOrNil(datas) then
        for _, v in pairs(datas) do
            -- if v.cardUid and v.cardUid > 0 and not v:IsMaxStar() then
            -- 镇魂街ZHJ-27879 Alpha_JT BUG合集ZHJ-34317 测试要求将未觉醒的神器加入快捷使用
            if v.cardUid and v.cardUid > 0 and (not v:IsMaxStar() and not v:GetIsAwaken()) then
                local cardData = StorageManager:GetDatasByUid(_G.StorageID.Card, v.cardUid)
                if not _G.table.isEmptyOrNil(cardData) and self.EmbattleModel:CheckHeroEmbattle(v.cardUid) then
                    _G.table.insert(cardList, cardData)
                end
            end
        end
    end

    if not _G.table.isEmptyOrNil(cardList) then
        tb.aorbtn_tip:SetActiveE(1)
        tb.aorbtn_tip.onClick:RemoveAllListeners()
        tb.aorbtn_tip.onClick:AddListener(
            _G.handlerbind(self, self.OnClickBtnTip, _G.StorageType.Artifact, cardList, itemData)
        )
    else
        tb.aorbtn_tip:SetActiveE(0)
    end
end

