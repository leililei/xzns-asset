---刷新选中的神器
function ArtifactWishListView:RefreshSelectArtifact(index)
    if index then
        ---如果点击已选择的神器，则取消选择
        self.selectArtifactData[index] = 0
        local parentObj = self.go_table["aorbtn_select" .. index]
        self.go_table["aortext_name" .. index].text = ""
        self.selectArtifactItem[parentObj:GetInstanceIDE()] = nil
        parentObj:ClearChildren()
        -- self:OnSend()
        return
    end
    for i = 1, self.selectArtifactNum do
        local parentObj = self.go_table["aorbtn_select" .. i]
        if self.selectArtifactData[i] > 0 and not self.selectArtifactItem[parentObj:GetInstanceIDE()] then
            local sid = self.selectArtifactData[i]
            _G.ItemFactory:GetInstance():GetItemCard(
                _G.ItemFactory.itemType.ItemArtifactBase,
                parentObj,
                function(item)
                    item:Show(sid)
                    item:SetSize(100)
                    self.selectArtifactItem[parentObj:GetInstanceIDE()] = item
                end
            )
            ---神器名字
            local artifact_cfg = _G.ConfigManager.artifact_cfg[sid]
            self.go_table["aortext_name" .. i].text = _G.LangUtil.GetLangPackValue(artifact_cfg.Name)
            self.go_table["obj_gou_" .. i]:SetActiveE(0)
        end
    end
end

function ArtifactWishListView:OnClickBtnTip(storageType, cardList, itemData)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.CommonTipView.Name,
        _G.TipType.WearCardList,
        storageType,
        cardList,
        itemData
    )
end

---选中item点击事件
---@param index number item的索引
function ArtifactWishListView:OnClickSelectItem(index)
    if self.selectArtifactData[index] then
        self:RefreshSelectArtifact(index)
        self:ChangeProfession(self.curProfession, true)
    end
end

---发送消息
function ArtifactWishListView:OnSend()
    ArtifactDrawModel:GetInstance():SetWish({ self.selecID, 0, 0 })
end

