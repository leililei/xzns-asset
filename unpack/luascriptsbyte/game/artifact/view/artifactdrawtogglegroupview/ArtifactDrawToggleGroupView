---@class ArtifactDrawToggleGroupView : UIBaseView 神器丶饰品抽卡, 下边栏菜单
---@field go_table ArtifactDrawToggleGroupView_GoTable
---@field toggles table<string,ArtifactDrawToggleGroupView._toggle_reset_GoTable> 切换按钮
---@field curToggle string  @当前选中的界面
---@field views table<string, number|Component|UIBaseView> @界面实例
local ArtifactDrawToggleGroupView = _G.BaseClass("ArtifactDrawToggleGroupView", _G.UIBaseView)

function ArtifactDrawToggleGroupView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed)
    self:AddListener(_G.eUIManagerStatus.StartOpenUI, self.StartOpenUI)
end

---界面的入口函数
---@param toggleIndex number|string|nil 切换界面的索引
function ArtifactDrawToggleGroupView:OnCreate(toggleIndex)
    self:InitToggles()
    self:InitTogglesFunctionUnlock()

    ---@type string
    local key
    if not toggleIndex then
        key = self:GetDefaultToggleKey()
    elseif type(toggleIndex) == "string" then
        key = toggleIndex
    elseif toggleIndex == 1 then
        key = "artifact"
    elseif toggleIndex == 2 then
        key = "spiritual"
    else
        key = self:GetDefaultToggleKey()
    end

    local tog = self.go_table["toggle_" .. key] or self.go_table.toggle_artifact
    if tog then
        tog.isOn = false
        tog.isOn = true
    end
end

function ArtifactDrawToggleGroupView:OnUIClosed(name)
    if name == _G.ConfigManager.ui_cfg.DrawAwardView.Name and self.views and self.views[self.curToggle] then
        self.views[self.curToggle]:ChangeBtnSO(true)
    end
end

function ArtifactDrawToggleGroupView:StartOpenUI(name)
    if name == _G.ConfigManager.ui_cfg.DrawAwardView.Name and self.views and self.views[self.curToggle] then
        self.views[self.curToggle]:ChangeBtnSO(false)
    end
end

function ArtifactDrawToggleGroupView:OnDestroy()
    self:RemoveAllListener()
end

---根据功能获取当前可打开的toggle节点
function ArtifactDrawToggleGroupView:GetDefaultToggleKey()
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.ArtifactDraw) then
        return "artifact"
    end
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.SpiritualDraw) then
        return "spiritual"
    end
    return "artifact"
end

function ArtifactDrawToggleGroupView:InitToggles()
    self.views = {}
    self.toggles = {
        artifact = _G.GetAutoGoTable(
            self.go_table.toggle_artifact,
            _G.handlerbind(self, self.OnClickToggle, "artifact", _G.handler(self, self.OnArtifact))
        ),
        spiritual = _G.GetAutoGoTable(
            self.go_table.toggle_spiritual,
            _G.handlerbind(self, self.OnClickToggle, "spiritual", _G.handler(self, self.OnSpiritual))
        )
    }
    UIUtils.IsNeedChangeUI(IsNeedChangeUI.ArtifactDrawToggleGroupViewToggle,self.toggles.artifact)
end

function ArtifactDrawToggleGroupView:InitTogglesFunctionUnlock()
    local isUnlockArtifact = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.ArtifactDraw)
    local isUnlockSpiritual = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.SpiritualDraw)
    self.go_table.toggle_artifact:SetActiveE(isUnlockArtifact and 1 or 0)
    self.go_table.toggle_spiritual:SetActiveE(isUnlockSpiritual and 1 or 0)
end

---监听Toggle点击事件
---@param key string
---@param callback function
function ArtifactDrawToggleGroupView:OnClickToggle(_, isOn, key, callback)
    local tb = self.toggles[key]
    local view = self.views[key]
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    self.curToggle = key

    --节点显隐
    if view and view ~= 0 then
        view.gameObject:SetActiveE(isOn and 1 or 0)
    end

    if isOn and callback then
        callback()
    end
end

function ArtifactDrawToggleGroupView:OnArtifact()
    local view = self.views.artifact
    if not view then
        self.views.artifact = 0
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArtifactDrawView.Name)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArtifactDrawView.Name)
    elseif view ~= 0 then
        --view:UpdateView()
    end
end

function ArtifactDrawToggleGroupView:OnSpiritual()
    local view = self.views.spiritual
    if not view then
        self.views.spiritual = 0
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SpiritualDrawView.Name)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpiritualDrawView.Name)
    elseif view ~= 0 then
        --view:UpdateView()
    end
end

---加载升星界面
function ArtifactDrawToggleGroupView:OnUIOpened(name)
    ---@type string
    local key
    if name == _G.ConfigManager.ui_cfg.ArtifactDrawView.Name then
        key = "artifact"
    elseif name == _G.ConfigManager.ui_cfg.SpiritualDrawView.Name then
        key = "spiritual"
    end
    if not key then
        return
    end
    self:RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)

    local view = _G.UIManager:GetInstance():GetWindowCtrl(name)
    if self:IsNil() then
        view:Close()
        return
    end
    view.transform:SetParentE(self.go_table.obj_view)
    if view.go_table and view.go_table.obj_close then
        view.go_table.obj_close:SetActiveE(0)
    end
    _G.UIManager:GetInstance():ChangeCanvasOrder(
        name,
        self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 1,
        true
    )
    self.views[key] = view
    if self.curToggle ~= key then
        view:Hide()
    end
end

---按钮点击事件在这里派发
function ArtifactDrawToggleGroupView:Close()
    self.super.Close(self)
    --关闭内嵌页面
    if self.views then
        for _, view in pairs(self.views) do
            view:Close()
        end
        self.views = nil
    end
end

---按钮点击事件在这里派发
function ArtifactDrawToggleGroupView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end

return ArtifactDrawToggleGroupView
