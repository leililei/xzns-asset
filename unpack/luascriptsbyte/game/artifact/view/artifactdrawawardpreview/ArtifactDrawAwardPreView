---@class ArtifactDrawAwardPreView : UIBaseView	中文描述
---@field public go_table ArtifactDrawAwardPreView_GoTable GoTable
---@field itemList ArtifactDrawAwardPreView._obj_Item_GoTable[]
local ArtifactDrawAwardPreView = _G.BaseClass("ArtifactDrawAwardPreView", _G.UIBaseView)
--_G.ArtifactDrawAwardPreView = ArtifactDrawAwardPreView

function ArtifactDrawAwardPreView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArtifactDrawAwardPreView:OnCreate(ActivityID, call)
    self.ActivityID = ActivityID
    self.call = call
    self.AwardDatas = require "ArtifactDrawUpMainModel":GetInstance():GetGodPreAward(self.ActivityID)
    self.coinId = require("ArtifactDrawUpMainModel"):GetInstance():GetArtifact(self.ActivityID)

    ---页面选中
    self.index = self.AwardDatas[1][1]
    if self.coinId ~= 0 then
        self.index = self.coinId
    end
    self.itemList = {}
    self.go_table.scrollloopvectical_AwardList:InitItemData(#self.AwardDatas, _G.handler(self, self.RefreshList))
end

function ArtifactDrawAwardPreView:RefreshList(index, obj)
    local instanceID = obj:GetInstanceIDE()
    local tb = self.itemList[instanceID]
    local data = self.AwardDatas[index + 1][1]
    local artifact_cfg = _G.ConfigManager.artifact_cfg[data]

    if not artifact_cfg then
        return
    end
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj,_G.handlerbind(self, self.OnClickItem, index + 1,tb,data))
        self.itemList[instanceID] = tb
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemArtifactBase,
            tb.obj_Root, function(item)
                if not item then
                    return
                end
                self.itemList[instanceID].item = item
                item:Show(data)
                item:HideLevel()
                if _G.AppSetting.IsXzns then
                    tb.itemTb = item.go_table
                    self:ShowHead(tb.itemTb, index + 1, artifact_cfg.card_id)
                end
            end
        )
        --  _G.SetEventTrigger(tb.aorbtn_dianji, "onDown", _G.handler(self, self.onDown_Uplv))
        -- tb.aorbtn_dianji.LongPress = true
    else
        self.itemList[instanceID].item:Show(data)
        self.itemList[instanceID].item:HideLevel()
        if _G.AppSetting.IsXzns then
            self:ShowHead(tb.itemTb, index + 1, artifact_cfg.card_id)
        end
    end
    if self.index == self.AwardDatas[index + 1][1] then
        tb.obj_eff:SetActiveE(1)
    else
        tb.obj_eff:SetActiveE(0)
    end


    local name = artifact_cfg.Name
    tb.aortext_name.text = _G.LangUtil.GetLangPackValue(name)
    --tb.aortext_probNum.text = (data.per * 100) .. "%"
end

function ArtifactDrawAwardPreView:ShowHead(tb, index, cardId)
    if cardId and cardId > 0 and not (self.index == self.AwardDatas[index][1]) then
        local cardCfg = _G.ConfigManager.card_cfg[cardId]
        local icon = cardCfg.Icon
        if _G.string.contains(icon, "/") then
            icon = _G.string.split2tbl(icon, "/")
            icon = icon[#icon]
        end
        tb.aorimage_BoundIcon:SetActiveE(1)
        tb.aorimage_BoundBg:SetActiveE(1)
        tb.aorimage_BoundIcon.SpriteName = icon
        tb.aorimage_BoundBg.SpriteName = require("CardInfoManager"):GetInstance():GetHeadBgSpriteName(nil, 7)
    else
        tb.aorimage_BoundIcon:SetActiveE(0)
        tb.aorimage_BoundBg:SetActiveE(0)
    end
end

---点击切换
function ArtifactDrawAwardPreView:OnClickItem(_, _, index,item,data)
    if self.AwardDatas[index][1] == self.index then
        require "CommonTipManager":GetInstance():OpenTip(item.gameObject, data)
        return
    end
    self.index = self.AwardDatas[index][1]
    self.go_table.scrollloopvectical_AwardList:UpdateCount(#self.AwardDatas)
end

---点击奖励
function ArtifactDrawAwardPreView.OnClickonDown_Uplv(item, self)
    require "CommonTipManager":GetInstance():OpenTip(self.gameObject, item)
end

---按钮点击事件在这里派发
function ArtifactDrawAwardPreView:OnClickBtn(go, _)
    local name = go:GetName()
    if name == "@_aorbtn_shadow" or name == "@_aorbtn_close" or name == "@_aorbtn_quXiao" then
        -- if self.coinId == 0 then
        --     return
        -- end
        self:Close()
    elseif name == "@_aorbtn_queding" then
        -- body
        if self.coinId == self.index then
            self:Close()
            return
        end
        --local sid = require "ArtifactDrawUpMainModel":GetInstance():GetItemId(self.ActivityID)

        require("ArtifactDrawUpMainModel"):GetInstance():Port_change(self.ActivityID, self.index)
        if self.call then
            self.call(self.index)
        end
        self:Close()
    end
end

return ArtifactDrawAwardPreView
