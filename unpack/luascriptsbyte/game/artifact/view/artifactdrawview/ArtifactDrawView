---界面的入口函数
---@param DefaultIndex number 默认选中页签
function ArtifactDrawView:OnCreate(DefaultIndex)
    if _G.AppSetting.IsXzns then
        _G.GameUtil.SetUiHeXieMask(self.go_table)
    end
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.ArtifactDrawView, self.go_table)
    self.materialItems = {}
    self.index = DefaultIndex or 1
    ---@type BaseAwardNewItem
    for i = 1, #mIDLis do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
                { mIDLis[i] },
                self.go_table["obj_item" .. i],
                function(item)
                    self.materialItems[i] = item
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    -- if i == self.curIndex then
                    --     item:SetGou(true)
                    -- end
                end,
                _G.handlerbind(self, self.OnClickMaterial, i),
                mIDLis[i]
        )
    end
    --显示货币信息
    if not _G.IsNil(self.go_table.obj_goldInfo) and self.go_table.obj_goldInfo:GetctiveInHierarchy() == 1 then
        --额外显示兑换货币id
        --local sids = {table.unpack(mIDLis)}
        local sids = { mIDLis[MaterialType.SR] }
        local currencySid = getExchangeCurrency(ExchanegCfgId.Left)
        if currencySid and currencySid > 0 then
            table.insert(sids, 1, currencySid)
        end
        self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, sids))
    end

    --显示玩家信息
    self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))
    --self:InitToggle()
    self:OnClickMaterial(nil, nil, nil, 3)
    self.curIndex = 3
    self.InitEffectObj = false
    self:UpdateMaterialRedPoint()
    self.go_table.aorimage_autobg:SetActiveE(1)
    self:UpdateDrawPlayBtn()
    self:RefreshActivityBtn()
    self:LoadBaseEffect()
    self:LoadDiamondTimes()
    self:LoadSpine()
    self:ShowWish()
    self:SetNeedCount()
    self:AddListener(_G.eLimitePrivilege.LimitePrivilegeChange, self.PrivilegeChange, self)
    self:AddListener(_G.ArtifacteDrawUpBattlePass.ArtifacteDrawWishRefresh, self.ShowWish, self)
    self:AddListener(_G.eSixUpdate.SixClockUpdate, self.OnSixUpdate, self)
    self:PlayAni()
    self:ShowAwardsBtn()
end

