---按钮点击事件在这里派发
function ArtifactDrawView:OnClickBtn(go)
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DrawAwardView.Name)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 87)
    elseif go == self.go_table.aorbtn_Draw1 then
        local sid = mIDLis[self.curIndex]
        if ArtifactDrawModel:GetInstance():GetDayFreeCount() > 0 then
            self:ClickDrawBtn(DrawType.one, not window)
        else
            if _G.StorageManager:GetInstance():CheckItem(sid, 1) then
                --魂铁单抽
                self:ClickDrawBtn(DrawType.one, not window)
            else
                --没有魂铁，钻石单抽
                self:ClickDrawBtn(DrawType.rmbOne, not window)
            end
        end

        if window then
            window.View:Close()
        end
    elseif go == self.go_table.aorbtn_Draw2 then
        self:ClickDrawBtn(DrawType.ten, not window)
        if window then
            window.View:Close()
        end
    elseif go == self.go_table.aorbtn_Draw3 then
        self:ClickDrawBtn(DrawType.rmbTen, not window)
        if window then
            window.View:Close()
        end
    elseif go == self.go_table.aorbtn_autoLeft then
        self:UpdateDrawPlayBtn(1 - self.playType)
    elseif go == self.go_table.aorbtn_shop then
        UIManager:GetInstance():OpenWindow(ConfigManager.ui_cfg.ShopView.Name, 8)
        self:ChangeBtnSO(true)
    elseif go == self.go_table.aorbtn_illustrate then
        _G.MainManager:GetInstance():OpenMainViewToggle("card", function()
            local window = _G.UIManager:GetInstance():GetWindowCtrl("MainView")
            if window then
                local panel = window.panelLua
                if panel.card then
                    --panel.card.go_table.obj_artifact:SetActiveE(1)
                    panel.card.selecttoggle = "artifact"
                end
            end
        end)
        self:Close()
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArtifactDrawToggleGroupView.Name)
    elseif go == self.go_table.aorbtn_probability then
        self:ChangeBtnSO(true)
        UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArtifactProbabilityView.Name)
    elseif go == self.go_table.aorbtn_Privilege then
        local data = require "PrivilegeManager":GetInstance():GetPrivilegeData({ _G.PrivilegeType.LimitedTimePrivilege
                                                                                   .ShopNumAdd, 2 })
        -- if data[1] then
        --     self.Privileged = 1
        --     self:InstructionIS()
        -- else
        --     UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LimitedTimePrivilegeView.Name,405002)
        -- end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LimitedTimePrivilegeView.Name, 405002, data)
    elseif go == self.go_table.aorbtn_jianlitanchuang then
        self.Privileged = 0
        self:InstructionIS()
    elseif go == self.go_table.aorbtn_awards then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DrawGiftPackToggleView.Name, nil, subType)
    elseif go == self.go_table.aorbtn_AD then
        require "MonthlyModel":GetInstance():CheckShowADTips(function()
            require("AdvertisementModel"):GetInstance():VideoAD(_G.AdvertisementType.ArtifactDraw,
                    _G.handler(self, self.UpdateDrawBtn))
        end)
    end
end

