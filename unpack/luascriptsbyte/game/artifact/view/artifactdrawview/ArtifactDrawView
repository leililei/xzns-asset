function ArtifactDrawView:InitToggle()
    self.viewList = {}

    -- 检查功能解锁
    local isSpiritualUnlocked = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.SpiritualDraw)
    self.go_table.toggle_spiritualDraw:SetActiveE(isSpiritualUnlocked and 1 or 0)

    local isArtifactUnlock = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.ArtifactDraw)
    self.go_table.toggle_artifactDraw:SetActiveE(isArtifactUnlock and 1 or 0)

    -- 绑定 Toggles
    self.toggles = {
        artifact = _G.GetAutoGoTable(self.go_table.toggle_artifactDraw, _G.handler(self, self.OnArtifact)),
        spiritual = _G.GetAutoGoTable(self.go_table.toggle_spiritualDraw, _G.handler(self, self.OnSpiritual))
    }

    if self.index == 2 and isSpiritualUnlocked then
        self.go_table.toggle_spiritualDraw.isOn = true
        self:OnSpiritual(self.go_table.toggle_spiritualDraw, true)
    elseif self.index == 1 and isArtifactUnlock then
        self.go_table.toggle_artifactDraw.isOn = true
        self:OnArtifact(self.go_table.toggle_artifactDraw, true)
    else
        if isArtifactUnlock then
            self.go_table.toggle_artifactDraw.isOn = true
            self:OnArtifact(self.go_table.toggle_artifactDraw, true)
        else
            self.go_table.toggle_spiritualDraw.isOn = true
            self:OnSpiritual(self.go_table.toggle_spiritualDraw, true)
        end
    end
end

