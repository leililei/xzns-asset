function ArtifactDrawView:ClickDrawBtn(type, isBtnDraw)
    if type == nil then
        self:ChangeBtnSO(true)
        return
    end
    self.isBtnDraw = isBtnDraw == nil and true or isBtnDraw
    self:SetDrawBtnEnabled(false)
    local wishs = ArtifactDrawModel:GetInstance():GetWishsids()
    local hasNoWish = false
    local data = require "PrivilegeManager":GetInstance():GetPrivilegeData(
            { _G.PrivilegeType.LimitedTimePrivilege.ShopNumAdd, 2 }
    )
    if data and data[1] ~= nil then
        if wishs[1] == 0 then
            hasNoWish = true
        end
    end
    if hasNoWish then
        _G.PopWindowManager:GetInstance():ShowBtnWindowByToggle(
                271702,
                function()
                    self:Draw(type)
                end,
                function()
                    self:SetDrawBtnEnabled(true)
                    self:OnClickWishBtn()
                end,
                function()
                    self:Draw(type)
                end
        )
    else
        self:Draw(type)
    end
end

function ArtifactDrawView:PlayDrawEffect(msg)
    local legend = false
    local type, sid
    self.go_table.obj_ring1:SetActiveE(0)
    for _, v in pairs(msg.award.item) do
        sid = v.type[1]
        type = _G.StorageManager:GetInstance():CheckSidType(sid)
        if type == _G.StorageType.Artifact then
            if artifact_cfg[sid].Order == 3 then
                legend = true
                break
            end
        end
    end
    self.go_table.obj_material:SetActiveE(0)
    --self.go_table.obj_eff:SetActiveE(1)
    local eff = AniType.normal
    if self.SpineAni then
        self:PlaySpineAni("show")
        if _G.AppSetting.IsXzns and self.SpineAni then
            self.SpineAni.color = _G.ColorTools.FormatColorByString("FFFFFF")
        end
    end
    local showResult = function()
        self.go_table.obj_DefaultEff:SetActiveE(1)
        self.go_table.obj_PlayEff:ClearChildren()
        --2024/05/22 不展示材料选择(以后可能还会再用上, 不作破坏性删除修改, 此处仅隐藏)
        --self.go_table.obj_material:SetActiveE(1)
        self.go_table.obj_material:SetActiveE(0)
        --self.go_table.obj_eff:SetActiveE(0)
        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg, nil, true)
        _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.DrawAwardView.Name,
                msg,
                _G.handler(self, self.ClickDrawBtn),
                true, nil, nil, nil, nil, true, nil, nil, nil, nil,
                { ItemCfg[mIDLis[self.curIndex]].Icon, self.drawNum or 10 }
        )
        self:StopAni()
        --local data = require "PrivilegeManager":GetInstance():GetPrivilegeData({ _G.PrivilegeType.LimitedTimePrivilege.Choose })
        --if data and data[1] then
        --    self.go_table.obj_ring1:SetActiveE(1)
        --end
        _G.DelayDo(
                0.2,
                function()
                    self.go_table.obj_ring1:SetActiveE(1)
                    if _G.AppSetting.IsXzns and self.SpineAni then
                        local wishs = ArtifactDrawModel:GetInstance():GetWishsids()
                        if wishs[1] ~= 0 then
                            self.SpineAni.color = _G.ColorTools.FormatColorByString("787878")
                        end
                    end
                end
        )
        self:SetDrawBtnEnabled(true)
    end
    if _G.AppSetting.IsXzns then
        self.go_table.obj_ring1:SetActiveE(1)
        _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_ArtifactDrawView_zhaohuan,
                self.go_table.obj_PlayEff,
                function(trans)
                    if self:IsNil() then
                        _G.DestroyImmediate(trans)
                        return
                    end
                end,
                function()
                    if self:IsNil() then
                        return
                    end
                    self.go_table.obj_eff:SetActiveE(1)
                    showResult()
                end
        )
    else
        _G.UIUtils.LoadEffectByPath(eff, self.go_table.obj_PlayEff, function()
            self.go_table.obj_DefaultEff:SetActiveE(0)
        end)
        _G.DelayDo(
                2.733,
                function()
                    if self:IsNil() then
                        return
                    end
                    showResult()
                end
        )
        local Tweening = _G.CS.DG.Tweening
        self.tween = {}
        _G.DelayDo(
                0.267,
                function()
                    if self:IsNil() then
                        return
                    end
                    self.tween[1] = self.go_table.aorrawimage_Bg.transform:DOShakeAnchorPos(0.1, 8, 1)
                end
        )
        _G.DelayDo(
                0.733,
                function()
                    if self:IsNil() then
                        return
                    end
                    self.tween[2] = self.go_table.aorrawimage_Bg.transform:DOShakeAnchorPos(0.1, 8, 10)
                end
        )
        _G.DelayDo(
                1.933,
                function()
                    if self:IsNil() then
                        return
                    end
                    if legend then
                        self.tween[3] = self.go_table.aorrawimage_Bg.transform:DOShakePosition(0.3, 25, 18):SetEase(
                                Tweening.Ease.InOutCubic
                        )
                    else
                        self.tween[3] = self.go_table.aorrawimage_Bg.transform:DOShakeAnchorPos(0.1, 8, 10)
                    end
                end
        )
    end
end

function ArtifactDrawView:StopAni()
    if self.tween then
        for _, v in pairs(self.tween) do
            if v then
                v:Kill()
            end
        end
    end
end

function ArtifactDrawView:Dispose()
    self:RemoveListener(_G.eLimitePrivilege.LimitePrivilegeChange, self.LoadDiamondTimes, self)
    self:RemoveListener(_G.ArtifacteDrawUpBattlePass.ArtifacteDrawWishRefresh, self.ShowWish, self)
    self:RemoveListener(_G.eSixUpdate.SixClockUpdate, self.OnSixUpdate, self)
    --_G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    _G.Events:GetInstance():RemoveListener(_G.eAdvertisement.Refresh, self.UpdateDrawBtn, self)
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.RefreshDrawBtn, self)
    if self.viewList then
        for k, v in pairs(self.viewList) do
            if v.CloseView then
                v:CloseView()
            else
                v:Close()
            end
            self.viewList[k] = nil
        end
    end
    self.viewList = nil
end

