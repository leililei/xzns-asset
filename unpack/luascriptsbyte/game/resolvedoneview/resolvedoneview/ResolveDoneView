require "PropData"

---@class ResolveDoneView : UIBaseView	中文描述
---@field public go_table ResolveDoneView_GoTable GoTable
local ResolveDoneView = _G.BaseClass("ResolveDoneView", _G.UIBaseView)
--_G.ResolveDoneView = ResolveDoneView

local CS = _G.CS
local typeof = _G.typeof

local ItemPath = "UI/ResolveDoneView/Item"

local tipsID = {
    HaveHeightGrade = 120302
}

function ResolveDoneView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ResolveDoneView:OnCreate(Equip, call)
    self.EquipList = Equip
    self.ItemList = {}
    self.ItemIDList = {}
    self.call = call
    self.IsFirst = true
    self:SetData()
end

function ResolveDoneView:SetData()
    local cfg
    for _, Equip in pairs(self.EquipList) do
        for _, v in pairs(Equip.cfg.decomposition) do
            if self.ItemList[v[1]] == nil then
                self.ItemList[v[1]] = _G.PropData.New()
                self.ItemList[v[1]]:Parse({sid = v[1], num = v[2]})
            else
                self.ItemList[v[1]].count = self.ItemList[v[1]].count + v[2]
            end
        end
        cfg = Equip:GetEquipCurStrengCfg()
        if cfg ~= nil then
            for _, v in pairs(cfg.decomposition) do
                if self.ItemList[v[1]] == nil then
                    self.ItemList[v[1]] = _G.PropData.New()
                    self.ItemList[v[1]]:Parse({sid = v[1], num = v[2]})
                else
                    self.ItemList[v[1]].count = self.ItemList[v[1]].count + v[2]
                end
            end
        end
    end

    self:ShowItemView()
end

function ResolveDoneView:ShowItemView()
    local isRefresh = false
    if self.ItemIDList ~= nil and #self.ItemIDList == table.count(self.ItemList) then
        isRefresh = true
    end
    self.ItemIDList = {}
    for i, _ in pairs(self.ItemList) do
        table.insert(self.ItemIDList, i)
    end
    table.sort(
        self.ItemIDList,
        function(a, b)
            local bl = false
            local ea = self.ItemList[a]
            local eb = self.ItemList[b]
            if ea.cfg.Quality < eb.cfg.Quality then
                bl = true
            end
            return bl
        end
    )
    if self.IsFirst then
        self.go_table.looplist2_ItemList:InitListView(0, _G.handler(self, self.RefreshList))
        self.IsFirst = false
    end
    self.go_table.looplist2_ItemList:SetListItemCount(_G.math.ceil(#self.ItemIDList / 5), true)
    if isRefresh then
        self.go_table.looplist2_ItemList:RefreshAllShownItem()
    end
end

function ResolveDoneView:RefreshList(listView2, index)
    if index < 0 then
        return
    end
    local list = self.ItemList
    local item = listView2:NewListViewItem("$_obj_ListItem")
    local x = index * 5 + 1
    item:SetName(x)
    local tb = {}
    local data = {}
    for i = 1, 5 do
        data = list[self.ItemIDList[x - 1 + i]]
        tb =
            _G.GetAutoGoTable(
            item:FindE(string.format("$_obj_Item%d", i)),
            _G.handlerbind(self, self.OnClickItem, data)
        )
        if data == nil then
            tb:SetActiveE(0)
        else
            tb:SetActiveE(1)
            tb.aorimage_Color.SpriteName = _G.itemColorIconName[data.cfg.Quality]
            tb.aorrawimage_Icon:LoadImage(
                data.Icon,
                function(image)
                    if image == nil then
                        return
                    end
                    image:SetActiveE(1)
                end
            )
            if data.count > 1 then
                tb.aortext_Number.text = data.count
            else
                tb.aortext_Number.text = ""
            end
        end
    end
    return item
end

function ResolveDoneView:OnClickItem(go, isOn, data)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, data.sid)
end

function ResolveDoneView:ResolveDone()
    local uids = {}
    for i, _ in pairs(self.EquipList) do
        table.insert(uids, i)
    end

    require("EquipmentModel"):GetInstance():EquipResolve(
        uids,
        function(data)
            -- _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
            self.call(true, data)
            self:Close()
        end
    )
end

---按钮点击事件在这里派发
function ResolveDoneView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_Cancel" then
        self:Close()
    elseif name == "@_aorbtn_Done" then
        local bl = false
        for i, v in pairs(self.EquipList) do
            if v then
                if self.EquipList[i].Grade > _G.EquipQuality.Purple then
                    bl = true
                    break
                end
            end
        end

        if bl then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                tipsID.HaveHeightGrade,
                nil,
                function()
                    self:ResolveDone()
                    self:Close()
                end
            )
            return
        end
        self:ResolveDone()
        self:Close()
    end
end

return ResolveDoneView
