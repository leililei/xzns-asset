local base = require("TakeOutGameMainView")

---@class MTSwordCasualMainView : TakeOutGameMainView	剑之修行_主页面选关(MT联动)
local MTSwordCasualMainView = _G.BaseClass("MTSwordCasualMainView", base)

---打开游戏游玩页面
---@param stageIndex number 关卡索引
---@param callback fun(score:number):void
function MTSwordCasualMainView:OpenGameView(stageIndex, callback)
    local stageCfg = _G.ConfigManager.jzxx_stage_cfg[self.stages[stageIndex].sid]

    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.SwordCasualView.Name,
        stageIndex,
        stageCfg,
        function(win, num, time, score)
            if self:IsNil() then
                return
            end
            --显示结算面板
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.SwordCasualSettlementView.Name,
                { win = win, num = num, time = time, score = score },
                function(type)
                    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SwordCasualView.Name)
                    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SwordCasualSettlementView.Name)
                    if self:IsNil() then
                        return
                    end
                    --重新开始
                    if type == 2 then
                        self:OpenGameView(stageIndex, callback)
                        return
                    end

                    --返回主界面
                    if callback then
                        callback(math.max(score or 0, 0))
                    end
                end
            )
        end,
        true --showScore
    )
end

---获取关卡配置
---@param sid number
---@return number,number,string  @名称id,fraction分数,icon路径
function MTSwordCasualMainView:GetStageCfg(sid)
    local cfg = _G.ConfigManager.jzxx_stage_cfg[sid]
    return cfg.name,
        (cfg.fraction and cfg.fraction[1][1] or 9999), --超越xx%的玩家
        cfg.icon
end

return MTSwordCasualMainView
