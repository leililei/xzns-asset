---@class SwordCasual_MapControll : Component	剑之修行_战斗页面_地图控制器
---@field go_table SwordCasualView._obj_mapRoot_GoTable
---@field position {x:number,y:number}                      @当前位置
---@field blockSize {width:number,height:number}            @渲染块大小
---@field blocks Transform[]                                @渲染块实例(长度为9, 中心点为角色当前所在块)
---@field centerBlockPosition {x:number,y:number}           @中心渲染块位置
---@field direction {x:number,y:number}                     @主角色行进方向(实际计算时方向取反)
local SwordCasual_MapControll = _G.BaseClass("SwordCasual_MapControll", _G.Component)

---入口函数
function SwordCasual_MapControll:OnCreate(trans)
    self.go_table = _G.GetAutoGoTable(trans)

    --初始化节点信息
    local sx, sy = self.go_table.obj_rendererBlock:GetRectTransformSize()
    self.position = { x = 0, y = 0, z = 0 }
    self.blockSize = { x = sx, y = sy }
    self.centerBlockPosition = { x = 0, y = 0 }
    --初始化渲染块
    self.blocks = {}
    for i = 1, 9 do
        if i == 5 then
            self.blocks[i] = self.go_table.obj_rendererBlock
        else
            local block = _G.InstantiateObject(self.go_table.obj_rendererBlock, self.go_table.obj_renderer)
            block:SetLocalScaleXYZ(1)
            self.blocks[i] = block
        end
        self:SetBlockPosition(self.blocks[i], i)
        if _G.AppSetting.DEBUG then
            self.blocks[i]:SetName(i)
        end
    end
end

---设置角色行进方向
---@param direction {x:number,y:number} @方向
function SwordCasual_MapControll:SetDirection(direction)
    self.direction = direction
end

---更新地图位置
---@param delta number @移动距离
function SwordCasual_MapControll:UpdatePosition(delta)
    --地图块移动(与摇杆/角色方向相反)
    local moveX = self.direction.x * delta
    local moveY = self.direction.y * delta
    self.position.x = self.position.x - moveX
    self.position.y = self.position.y - moveY
    self.transform:SetLocalPosition(self.position.x, self.position.y, 0)

    --检测是否需要更新中心渲染块
    local offsetX, offsetY = self.position.x - self.centerBlockPosition.x,
        self.position.y - self.centerBlockPosition.y
    local bsHalfX = self.blockSize.x * 0.5
    local bsHalfY = self.blockSize.y * 0.5
    if math.abs(offsetX) <= bsHalfX and math.abs(offsetY) <= bsHalfY then
        return
    end
    --计算偏移索引
    local xOffsetIndex = offsetX > bsHalfX and 1 or offsetX < -bsHalfX and -1 or 0
    local yOffsetIndex = offsetY > bsHalfY and 1 or offsetY < -bsHalfY and -1 or 0
    self:SetBlockCenterMove(xOffsetIndex, yOffsetIndex)
end

---获取地图节点偏移值
---@return number @x轴偏移值
---@return number @y轴偏移值
function SwordCasual_MapControll:GetPosition()
    return self.position.x, self.position.y
end

---注册角色实例到地图上
---@param item SwordCasual_RoleItem @角色实例
function SwordCasual_MapControll:AddRoleItem(item)
    item.transform:SetParentE(self.go_table.obj_roles)
end

---获取角色实例根节点
---@return UnityEngine.Transform @角色实例根节点
function SwordCasual_MapControll:GetRoleParent()
    return self.go_table.obj_roles
end

---注册子弹实例到地图上
---@param item SwordCasual_BulletItem @子弹实例
function SwordCasual_MapControll:AddBulletItem(item)
    item.transform:SetParentE(self.go_table.obj_bullets)
end

---注册掉落物实例到地图上
---@param item SwordCasual_BoxItem @掉落物实例
function SwordCasual_MapControll:AddBoxItem(item)
    item.transform:SetParentE(self.go_table.obj_box)
end

---设置渲染块位置
---@param block Transform   @渲染块实例
---@param index number      @渲染块索引(1-9), 5表示中心块
function SwordCasual_MapControll:SetBlockPosition(block, index)
    local x = (index - 1) % 3 - 1
    local y = (math.floor((index - 1) / 3) - 1) * -1 --对y轴取反, 渲染块序号从小到大对于从上到下排列
    --对渲染中心点取反(记录的坐标位置与mapRoot方向相反)
    block:SetLocalPosition(
        -self.centerBlockPosition.x + x * self.blockSize.x,
        -self.centerBlockPosition.y + y * self.blockSize.y,
        0
    )
end

---设置中心渲染块更换
---@param index number @渲染块索引(1-9), 5表示中心块
function SwordCasual_MapControll:SetBlockCenterMove(xOffsetIndex, yOffsetIndex)
    if xOffsetIndex == 0 and yOffsetIndex == 0 then
        return
    end

    ---渲染块排列方式:
    --- 1 | 2 | 3
    --- 4 | 5 | 6
    --- 7 | 8 | 9
    if yOffsetIndex < 0 then
        --向下转移
        self.blocks = {
            self.blocks[4], self.blocks[5], self.blocks[6],
            self.blocks[7], self.blocks[8], self.blocks[9],
            self.blocks[1], self.blocks[2], self.blocks[3],
        }
    elseif yOffsetIndex > 0 then
        --向上转移
        self.blocks = {
            self.blocks[7], self.blocks[8], self.blocks[9],
            self.blocks[1], self.blocks[2], self.blocks[3],
            self.blocks[4], self.blocks[5], self.blocks[6],
        }
    end
    if xOffsetIndex < 0 then
        --向左转移
        self.blocks = {
            self.blocks[3], self.blocks[1], self.blocks[2],
            self.blocks[6], self.blocks[4], self.blocks[5],
            self.blocks[9], self.blocks[7], self.blocks[8],
        }
    elseif xOffsetIndex > 0 then
        --向右转移
        self.blocks = {
            self.blocks[2], self.blocks[3], self.blocks[1],
            self.blocks[5], self.blocks[6], self.blocks[4],
            self.blocks[8], self.blocks[9], self.blocks[7],
        }
    end

    --重新计算中心点位置与渲染块位置
    self.centerBlockPosition.x = self.centerBlockPosition.x + xOffsetIndex * self.blockSize.x
    self.centerBlockPosition.y = self.centerBlockPosition.y + yOffsetIndex * self.blockSize.y
    for i = 1, 9 do
        self:SetBlockPosition(self.blocks[i], i)
        if _G.AppSetting.DEBUG then
            self.blocks[i]:SetName(i)
        end
    end
end

return SwordCasual_MapControll
