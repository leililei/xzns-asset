---获得武器升级特效
function SwordCasual_RoleItem:PlayAddSwordEff()
    _G.AudioManager.PlayAudioByAudioCfgID(2056)
    if not self.effDic.AddSword then
        self.effDic.AddSword = true
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_jueseshengji_2,
            self.go_table.obj_eff,
            function(trans)
                if self.go_table == nil then
                    _G.UIUtils.RemoveEffect(trans)
                    return
                end
                trans:SetLocalPosition(0, -90, 0)
                self.effDic.AddSword = trans
            end
        )
    elseif self.effDic.AddSword ~= true then
        self.effDic.AddSword:SetActiveE(0)
        self.effDic.AddSword:SetActiveE(1)
    end
end

---boss血条光环特效
function SwordCasual_RoleItem:PlayHPCircleEff()
    if not self.effDic.HPCircle then
        self.effDic.HPCircle = true
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_fazhen2,
            self.go_table.obj_bgEff,
            function(trans)
                if self.go_table == nil then
                    _G.UIUtils.RemoveEffect(trans)
                    return
                end
                trans:SetLocalPosition(0, -65, 0)
                trans:SetLocalScaleXYZ(0.6)
                trans:RequireComponentE(_G.typeof(_G.CS.UIParticleOrderChange))
                self.effDic.HPCircle = trans
            end
        )
    elseif self.effDic.HPCircle ~= true then
        self.effDic.HPCircle:SetActiveE(0)
        self.effDic.HPCircle:SetActiveE(1)
    end
end

---隐藏全部特效
function SwordCasual_RoleItem:HideAllEff()
    for k, v in pairs(self.effDic) do
        if v ~= true then
            v:SetActiveE(0)
        end
    end
end

