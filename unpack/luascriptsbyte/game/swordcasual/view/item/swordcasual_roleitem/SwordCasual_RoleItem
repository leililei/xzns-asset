---设置是否显示生命值
---@param showHp boolean @是否显示生命值
function SwordCasual_RoleItem:SetShowHp(showHp)
    self.showHp = showHp
    self.go_table.trans_hpBG:SetActiveE(showHp and 1 or 0)
    self:UpdateHpRenderer()
end

---更新生命值渲染器
---@private
function SwordCasual_RoleItem:UpdateHpRenderer()
    if not self.showHp or not self.maxHp or self.maxHp <= 0 then
        return
    end
    if self.hp <= 0 then
        self.go_table.trans_hpBG:SetActiveE(0)
        return
    end

    local val = math.max(0, math.min(1, self.hp / self.maxHp)) --限定值范围[0.0-1.0]
    self.go_table.image_hp:SetLocalScale(val, 1, 1)
end

