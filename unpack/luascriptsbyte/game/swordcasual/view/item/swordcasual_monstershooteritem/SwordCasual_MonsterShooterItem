local base = require("SwordCasual_MonsterItem")

---@class SwordCasual_MonsterShooterItem : SwordCasual_MonsterItem	剑之修行_战斗页面_(射击手)怪物控制逻辑
---@field shootTime number                                                  @射击时间间隔
---@field shootTimeInterval number                                          @射击时间
---@field shootCallback fun(role:SwordCasual_MonsterShooterItem,target:SwordCasual_RoleItem):void       @射击事件回调
local SwordCasual_MonsterShooterItem = _G.BaseClass("SwordCasual_MonsterShooterItem", base)

---入口函数
function SwordCasual_MonsterShooterItem:OnCreate(...)
    base.OnCreate(self, ...)
    self.magnitude = 500

    self.shootTime = 5
    self.shootTimeInterval = 0.1
end

---设置配置数据
---@param cfg jzxx_role_cfg
function SwordCasual_MonsterShooterItem:SetData(cfg, ...)
    base.SetData(self, cfg, ...)
    self.shootTime = cfg.bullet_cd
end

---物理逻辑更新
---@param deltaTime number @时间间隔
function SwordCasual_MonsterShooterItem:Update(deltaTime)
    local prveRun = self:IsRun()
    base.Update(self, deltaTime)

    if self:IsDizzin() then
        return
    end

    --还在移动中, 等待进入攻击范围
    if self:IsRun() then
        return
    end
    --达到攻击距离时, 先停顿n秒再进行攻击
    if prveRun then
        self.shootTimeInterval = 0.2 + math.random() * 0.4 --随机等待0.2-0.6秒
        self:PlayAttackAnimation(_G.handler(self, self.OnAttackAnimationPost))
        return
    end

    --发射子弹
    self.shootTimeInterval = self.shootTimeInterval - deltaTime
    if self.shootTimeInterval <= 0 then
        self.shootTimeInterval = self.shootTime

        if self.shootCallback then
            self.shootCallback(self, self.target)
        end
    end
end

---攻击完成后的动画处理
function SwordCasual_MonsterShooterItem:OnAttackAnimationPost()
    if self:IsDeath() then
        return
    end
    self:UpdateAnimationState(self.modelAnimationState)
end

--region ===================注册事件===================

---注册射击事件
---@param callback fun(role:SwordCasual_MonsterShooterItem,target:SwordCasual_RoleItem):void @事件回调
function SwordCasual_MonsterShooterItem:OnShoot(callback)
    self.shootCallback = callback
end

--endregion

return SwordCasual_MonsterShooterItem
