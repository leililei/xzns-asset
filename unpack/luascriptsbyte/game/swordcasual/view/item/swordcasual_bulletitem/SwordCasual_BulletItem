---@class SwordCasual_BulletItem : Component	剑之修行_战斗页面_子弹控制逻辑
---@field go_table SwordCasualView._trans_bullet_GoTable
---@field rect SwordCasual_Rect
---@field cfg jzxx_bullet_cfg
----------------------------------------------------------------------
---@field hp number                         @当前单位生命值
----------------------------------------------------------------------
---@field modelNode Transform               @模型实例
----------------------------------------------------------------------
---@field parent SwordCasual_RoleItem       @父节点
---@field team number                       @阵营id
---@field attack number                     @当前单位攻击力
---@field speed number                      @当前单位速度
---@field duration number                   @剩余时间
---@field direction {x:number,y:number}     @行进方向
---@field position {x:number,y:number}      @当前位置
---@field target SwordCasual_RoleItem       @追踪目标角色
---@field angleSpeed number                 @追踪目标时的角速度
---@field onDestroyed fun(item:SwordCasual_BulletItem):void @销毁事件回调
local SwordCasual_BulletItem = _G.BaseClass("SwordCasual_BulletItem", _G.Component)

---入口函数
function SwordCasual_BulletItem:OnCreate(trans)
    self.go_table = _G.GetAutoGoTable(trans)

    self.position = { x = 0, y = 0 }
    --self.direction = { x = 1, y = 0 }
    self.speed = 500
    self.attack = 1
    self.angleSpeed = 120
    self.duration = 5
end

---物理逻辑更新
---@param deltaTime number @时间间隔
function SwordCasual_BulletItem:Update(deltaTime)
    if self.direction then
        if self.target then
            --追踪型子弹, 更新朝向
            self:UpdateTrackDirection()
        end

        --更新位置信息
        self:UpdatePosition(self.speed * deltaTime)
        --更新矩形信息
        self:UpdateRect()
    end

    --子弹销毁
    self.duration = self.duration - deltaTime
    if self.duration <= 0 then
        if self.onDestroyed then
            self.onDestroyed(self)
        else
            if _G.AppSetting.DEBUG then
                _G.LogError("未处理子弹销毁事件")
            end
        end
    end
end

---设置父节点
---@param parent SwordCasual_RoleItem @父节点
function SwordCasual_BulletItem:SetParent(parent)
    self.parent = parent
end

---获取父节点
---@return SwordCasual_RoleItem @父节点
function SwordCasual_BulletItem:GetParent()
    return self.parent
end

---设置目标角色(追踪弹)
---@param target SwordCasual_RoleItem @目标角色
function SwordCasual_BulletItem:SetTraceTarget(target)
    self.target = target

    if self.target then
        self:StopMoveAnimation()
    end
end

---设置配置数据
function SwordCasual_BulletItem:SetData(cfg)
    self.cfg = cfg

    --配置信息
    self:SetSpeed(self.cfg.bulletSpeed)
    self:SetDuration(self.cfg.lifeTime)
    self:SetHp(math.max(1, self.cfg.penCount + 1))
    self:UpdateColliderSize()
end

---获取配置数据
---@return jzxx_bullet_cfg
function SwordCasual_BulletItem:GetData()
    return self.cfg
end

--region ===================战斗属性相关===================
---设置生命值
---@param hp number @生命值
function SwordCasual_BulletItem:SetHp(hp)
    self.hp = hp
    self:UpdateModel()
end

---改变生命值
---@param deltaHp number @生命值变化量
function SwordCasual_BulletItem:ChangeHp(offset)
    self.hp = self.hp + offset
    if self.hp < 0 then
        self.hp = 0
    end
end

---获取生命值
---@return number @生命值
function SwordCasual_BulletItem:GetHp()
    return self.hp
end

---是否死亡
---@return boolean @是否死亡
function SwordCasual_BulletItem:IsDeath()
    return self.hp <= 0
end

---子弹能否被格挡
---@return boolean @是否死亡
function SwordCasual_BulletItem:IsBlocked()
    if self.cfg and not self.cfg.isBlocked then
        return false
    end
    return true
end

---设置攻击值
---@param attack number @攻击值
function SwordCasual_BulletItem:SetAttack(attack)
    self.attack = attack
end

---获取攻击值
---@return number @攻击值
function SwordCasual_BulletItem:GetAttack()
    return self.attack
end

---设置阵营id
---@param team number @阵营id
function SwordCasual_BulletItem:SetTeam(team)
    self.team = team
end

---获取阵营id
---@return number @阵营id
function SwordCasual_BulletItem:GetTeam()
    return self.team
end

--endregion

--region ===================物理/重叠判断相关===================

---更新自身矩形信息(立即更新信息)
function SwordCasual_BulletItem:UpdateRect()
    if not self.rect then
        local w, h = self.go_table.trans_trigger:GetRectTransformWidthHeight()
        local rad = _G.math.rad(self:GetDirectionAngle())
        self.rect = { x = 0, y = 0, w = w, h = h, rot = rad }
    end
    self.rect.x = self.position.x
    self.rect.y = self.position.y
end

---获取自身矩形信息
---@return SwordCasual_Rect @矩形a
function SwordCasual_BulletItem:GetRect()
    if not self.rect then
        self:UpdateRect()
    end
    return self.rect
end

---更新碰撞盒大小
function SwordCasual_BulletItem:UpdateColliderSize()
    local width, height = table.unpack(self.cfg.box)
    width = math.max(1, width)
    height = math.max(1, height)
    self.go_table.trans_trigger:SetRectTransformSize(width, height)
    --更新矩形信息
    if self.rect then
        self.rect.w = width
        self.rect.h = height
    end
end

--endregion

--region ===================位置/方向/速度相关===================

---设置方向
---@param direction {x:number,y:number} @方向
function SwordCasual_BulletItem:SetDirection(direction)
    self.direction = direction

    local angle = self:GetDirectionAngle()
    ---更新子弹方向
    if self.rect then
        local rad = _G.math.rad(angle)
        self.rect.rot = rad
    end
    --更新子弹朝向
    self.transform:SetLocalEulerAngles(0, 0, angle + 90) --子弹默认朝下, 旋转90度

    if not self.target then
        self:UpdateMoveAnimation()
    end
end

---获取方向
---@return {x:number,y:number} @方向
function SwordCasual_BulletItem:GetDirection()
    return self.direction
end

---设置移动速度
---@param speed number @速度
function SwordCasual_BulletItem:SetSpeed(speed)
    self.speed = speed

    if not self.target then
        self:UpdateMoveAnimation()
    end
end

---设置追踪目标时的角速度
---@param angleSpeed number @角速度
function SwordCasual_BulletItem:SetAngleSpeed(angleSpeed)
    self.angleSpeed = angleSpeed
end

---设置位置
---@param x number @x坐标
---@param y number @y坐标
function SwordCasual_BulletItem:SetPosition(x, y)
    self.position.x = x
    self.position.y = y

    if not self.target then
        self:UpdateMoveAnimation()
    else
        self.transform:SetLocalPosition(self.position.x, self.position.y, 0)
    end
end

---设置剩余时间
---@param duration number @剩余时间
function SwordCasual_BulletItem:SetDuration(duration)
    self.duration = duration
end

---更新位置
---@param delta number @移动距离
function SwordCasual_BulletItem:UpdatePosition(delta)
    local moveX = self.direction.x * delta
    local moveY = self.direction.y * delta
    self.position.x = self.position.x + moveX
    self.position.y = self.position.y + moveY

    if self.target then
        self.transform:SetLocalPosition(self.position.x, self.position.y, 0)
    end
end

---更新朝向(追踪型子弹)
function SwordCasual_BulletItem:UpdateTrackDirection()

end

---获取位置
---@return number @x轴坐标
---@return number @y轴坐标
function SwordCasual_BulletItem:GetPosition()
    return self.position.x, self.position.y
end

---获取方向角度
---@private
---@return number @角度
function SwordCasual_BulletItem:GetDirectionAngle()
    if not self.direction then
        return 0
    end

    local rad = math.atan(self.direction.y, self.direction.x)
    local angle = rad * 180 / math.pi
    return angle
end

---停止移动动画
function SwordCasual_BulletItem:StopMoveAnimation()
    self.go_table.trans_bullet:DOKill()
    self.transform:SetLocalPosition(self.position.x, self.position.y, 0)
end

---更新移动动画
function SwordCasual_BulletItem:UpdateMoveAnimation()
    self:StopMoveAnimation()
    if not self.direction then
        return
    end

    local x = self.direction.x * self.speed
    local y = self.direction.y * self.speed

    local tweener = self.go_table.trans_bullet:DOBlendableLocalMoveBy(_G.Vector3(x, y, 0), 1)
    tweener:SetEase(_G.CS.DG.Tweening.Ease.Linear)
    tweener:SetLoops(-1, _G.CS.DG.Tweening.LoopType.Incremental)
    tweener:SetTarget(self.go_table.trans_bullet)
end

--endregion


--region ===================模型相关===================

---根据当前血量更新模型
---@param force? boolean @是否强制更新
function SwordCasual_BulletItem:UpdateModel()
    self:RemoveModel()
    if self.cfg.imgName and #self.cfg.imgName > 0 then
        self.go_table.trans_effect:SetActiveE(0)
        self.go_table.aorimage_renderer:SetActiveE(1)

        self.go_table.aorimage_renderer.SpriteName = self.cfg.imgName
        self.go_table.aorimage_renderer:SetNativeSize()
    elseif self.cfg.effectPath and #self.cfg.effectPath > 0 then
        self.go_table.trans_effect:SetActiveE(1)
        self.go_table.aorimage_renderer:SetActiveE(0)

        local d = self.cfg
        _G.PoolsManager:GetInstance():Spawn(
            self.cfg.effectPath,
            _G.ePoolType.Temporary,
            self.go_table.trans_effect,
            function(trans)
                if self.cfg ~= d or self.modelNode then
                    _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.Temporary)
                    return
                end
                trans:SetLocalScaleXYZ(1)
                trans:SetLocalPositionToZero()
                trans:RequireComponentE(_G.typeof(_G.CS.UIParticleOrderChange))
                self.modelNode = trans
            end
        )
    end
end

---移除旧的模型实例
function SwordCasual_BulletItem:RemoveModel()
    if not self.modelNode then
        return
    end
    --_G.PoolsManager:GetInstance():Despawn(self.modelNode, _G.ePoolType.Temporary)
    _G.DestroyObject(self.modelNode) --存在UIParticleOrderChange组件时, 不能回收入池
    self.modelNode = nil
end

--endregion

--region ===================注册事件===================

---注册销毁事件
---@param callback fun(item:SwordCasual_BulletItem):void @事件回调
function SwordCasual_BulletItem:OnDestroyed(callback)
    self.onDestroyed = callback
end

--endregion

return SwordCasual_BulletItem
