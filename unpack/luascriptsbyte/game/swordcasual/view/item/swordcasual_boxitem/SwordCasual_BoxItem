---@class SwordCasual_BoxItem : Component	剑之修行_战斗页面_掉落物
---@field go_table SwordCasualView._trans_box_GoTable
---@field rect SwordCasual_Rect
---@field data any                          @自定义数据
---@field type number                       @宝箱类型: 1增加刀刃, 2随机事件
---@field position {x:number,y:number}      @当前位置
---@field duration number                   @剩余时间
---@field flashTime number                  @闪烁时间
---@field flashState number                 @闪烁状态: 0:无, 1:闪烁
---@field graphic UnityEngine.UI.Graphic    @渲染对象
---@field onDestroyed fun(item:SwordCasual_BoxItem):void @销毁事件回调
local SwordCasual_BoxItem = _G.BaseClass("SwordCasual_BoxItem", _G.Component)

---入口函数
function SwordCasual_BoxItem:OnCreate(trans)
    self.go_table = _G.GetAutoGoTable(trans)
    self.graphic = trans:GetComponentInChildrenE(_G.typeof(_G.CS.UnityEngine.UI.Graphic))
    self.position = { x = 0, y = 0 }
    self.duration = 1
    self.flashState = 0
    self.flashTime = 3
    self.type = 1
    self.effDic = {}
end

---物理逻辑更新
---@param deltaTime number @时间间隔
function SwordCasual_BoxItem:Update(deltaTime)
    --销毁时间
    self.duration = self.duration - deltaTime
    if self.duration <= 0 then
        if self.onDestroyed then
            self.onDestroyed(self)
        else
            if _G.AppSetting.DEBUG then
                _G.LogError("未处理掉落物销毁事件")
            end
        end
        return
    end

    --更新闪烁状态
    local state = self.flashTime > 0 and self.duration < self.flashTime and 1 or 0
    if self.flashState ~= state then
        self.flashState = state
        self:UpdateAnimationFlash(state)
    end
end

---设置剩余时间
---@param duration number @剩余时间
function SwordCasual_BoxItem:SetDuration(duration)
    self.duration = duration
end

---设置闪烁时间(时间小于此刻时, 开始闪烁)
---@param flashTime number @闪烁时间
function SwordCasual_BoxItem:SetFlashTime(flashTime)
    self.flashTime = flashTime
end

---设置自定义数据
---@param type number @宝箱类型: 1增加刀刃, 2随机事件
---@param data any @自定义数据
function SwordCasual_BoxItem:SetData(type, data)
    self.type = type
    self.data = data
    self:PlayDropEff()
end

---获取自定义数据
---@return any @自定义数据
function SwordCasual_BoxItem:GetData()
    return self.data
end

---获取宝箱类型
---@return number @宝箱类型: 1增加刀刃, 2随机事件
function SwordCasual_BoxItem:GetType()
    return self.type
end

---停止模型闪烁动画
function SwordCasual_BoxItem:StopAnimationFlash()
    self.flashState = 0
    self:UpdateAnimationFlash(0)
end

---更新模型闪烁状态
---@private
---@param state number @闪烁状态: 0:无, 1:闪烁
function SwordCasual_BoxItem:UpdateAnimationFlash(state)
    if not self.graphic then
        return
    end
    self.graphic:DOKill()
    self.graphic.color = _G.Color(1, 1, 1, 1)
    if state ~= 1 then
        return
    end

    local tweener = self.graphic:DOColor(_G.Color(1, 1, 1, 0.3), 0.3)
    tweener:SetEase(_G.CS.DG.Tweening.Ease.Linear)
    tweener:SetLoops(-1, _G.CS.DG.Tweening.LoopType.Yoyo)
    tweener:SetTarget(self.graphic)
end

--region ===================物理/重叠判断相关===================

---更新自身矩形信息(立即更新信息)
function SwordCasual_BoxItem:UpdateRect()
    if not self.rect then
        local w, h = self.go_table.trans_box:GetRectTransformWidthHeight()
        self.rect = { x = 0, y = 0, w = w, h = h, rot = 0 }
    end
    self.rect.x = self.position.x
    self.rect.y = self.position.y
end

---获取自身矩形信息
---@return SwordCasual_Rect @矩形a
function SwordCasual_BoxItem:GetRect()
    if not self.rect then
        self:UpdateRect()
    end
    return self.rect
end

--endregion

--region ===================位置相关===================

---设置位置
---@param x number @x坐标
---@param y number @y坐标
function SwordCasual_BoxItem:SetPosition(x, y)
    self.position.x = x
    self.position.y = y
    self.transform:SetLocalPosition(self.position.x, self.position.y, 0)

    --更新矩形信息
    self:UpdateRect()
end

---获取位置
---@return number @x轴坐标
---@return number @y轴坐标
function SwordCasual_BoxItem:GetPosition()
    return self.position.x, self.position.y
end

--endregion

--region ===================注册事件===================

---注册销毁事件
---@param callback fun(item:SwordCasual_BoxItem):void @事件回调
function SwordCasual_BoxItem:OnDestroyed(callback)
    self.onDestroyed = callback
end

--endregion

--region ===================播放特效===================

---宝箱出现特效
function SwordCasual_BoxItem:PlayDropEff()
    local eff, key
    if self.type == 1 then --加刀宝箱
        eff = _G.ConfigManager.ui_effect_cfg.ef_SwordCasualView_purple
        key = "Purple"
    else --事件宝箱
        eff = _G.ConfigManager.ui_effect_cfg.ef_SwordCasualView_gold
        key = "Gold"
    end
    if not self.effDic[key] then
        self.effDic[key] = true
        _G.UIUtils.LoadEffectByCfg(
            eff,
            self.go_table.obj_eff,
            function(trans)
                if self.go_table == nil then
                    _G.UIUtils.RemoveEffect(trans)
                    return
                end
                self.effDic[key] = trans
            end
        )
    elseif self.effDic[key] ~= true then
        self.effDic[key]:SetActiveE(0)
        self.effDic[key]:SetActiveE(1)
    end
end

---隐藏全部特效
function SwordCasual_BoxItem:HideAllEff()
    for _, v in pairs(self.effDic) do
        if v ~= true then
            v:SetActiveE(0)
        end
    end
end

--endregion


return SwordCasual_BoxItem
