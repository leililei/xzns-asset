local base = require("SwordCasual_RoleItem")
local SwordCasual_Utils = require("SwordCasual_Utils")

---@class SwordCasual_MasterItem : SwordCasual_RoleItem	剑之修行_战斗页面_主角控制器
---@field cfg jzxx_role_cfg
---@field shootTime number                                                  @射击时间间隔
---@field shootTimeInterval number                                          @射击时间
---@field shootCallback fun(role:SwordCasual_MonsterShooterItem):void       @射击事件回调
local SwordCasual_MasterItem = _G.BaseClass("SwordCasual_MasterItem", base)

function SwordCasual_MasterItem:OnCreate(...)
    base.OnCreate(self, ...)
    --self:SetShowHp(true) --启用血条显示

    self.shootTime = 5
    self.shootTimeInterval = 0.1
end

---物理逻辑更新
---@param deltaTime number @时间间隔
function SwordCasual_MasterItem:Update(deltaTime)
    --更新位置信息
    base.Update(self, deltaTime)

    if not self:IsDizzin() then
        --发射子弹
        if self:GetEffectOverlay(SwordCasual_Utils.Effects.Shooter) > 0 then
            self.shootTimeInterval = self.shootTimeInterval - deltaTime
            if self.shootTimeInterval <= 0 then
                self.shootTimeInterval = self.shootTime

                if self.shootCallback then
                    self.shootCallback(self)
                end
            end
        end
    end
end

---能否被击退
---@return boolean
function SwordCasual_MasterItem:IsBeatback()
    return false
end

--region ===================注册事件===================

---注册射击事件
---@param callback fun(role:SwordCasual_MonsterShooterItem):void @事件回调
function SwordCasual_MasterItem:OnShoot(callback)
    self.shootCallback = callback
end

--endregion

return SwordCasual_MasterItem
