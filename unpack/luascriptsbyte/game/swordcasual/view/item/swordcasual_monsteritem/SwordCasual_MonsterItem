local base = require("SwordCasual_RoleItem")

---@class SwordCasual_MonsterItem : SwordCasual_RoleItem	剑之修行_战斗页面_怪物控制逻辑
---@field cfg jzxx_role_cfg
---@field target SwordCasual_RoleItem                       @跟随目标角色
---@field magnitude number                                  @追踪达成距离(距离小于此值时, 停止追踪)
local SwordCasual_MonsterItem = _G.BaseClass("SwordCasual_MonsterItem", base)

---入口函数
function SwordCasual_MonsterItem:OnCreate(...)
    base.OnCreate(self, ...)
    self.magnitude = 50
end

---设置配置数据
---@param cfg jzxx_role_cfg
function SwordCasual_MonsterItem:SetData(cfg, ...)
    base.SetData(self, cfg, ...)
    if self.cfg and self.cfg.hp_show then
        self:PlayHPCircleEff()
    end
end

---物理逻辑更新
---@param deltaTime number @时间间隔
function SwordCasual_MonsterItem:Update(deltaTime)
    if not self:IsDizzin() then
        --计算朝向
        local x, y = self:GetPosition()
        local tx, ty = self.target:GetPosition()
        local offsetX, offsetY = tx - x, ty - y
        local distance = math.sqrt(offsetX * offsetX + offsetY * offsetY)
        if distance < self.magnitude then
            self.direction.x = 0
            self.direction.y = 0
        else
            self.direction.x = offsetX / distance
            self.direction.y = offsetY / distance
        end
        self:SetDirection(self.direction)
    end

    --更新位置信息
    base.Update(self, deltaTime)
end

---设置目标角色
---@param target SwordCasual_RoleItem @目标角色
function SwordCasual_MonsterItem:SetTraceTarget(target)
    self.target = target
end

---是否正在跑动
---@return boolean
function SwordCasual_MonsterItem:IsRun()
    if not self.direction then
        return false
    end
    return self.direction.x ~= 0 or self.direction.y ~= 0
end

---能否被击退
---@return boolean
function SwordCasual_MonsterItem:IsBeatback()
    --如果是boss, 则不能被击退
    if self.cfg and self.cfg.is_boss then
        return false
    end
    return true
end

return SwordCasual_MonsterItem
