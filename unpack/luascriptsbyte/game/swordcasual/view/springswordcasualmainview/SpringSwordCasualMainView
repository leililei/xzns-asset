function SpringSwordCasualMainView:UpdateStages()
    --更新关卡状态
    local offsetIndex = math.ceil(#self.stageItems / 2)
    self.model:UpdateOpenTime()
    for index, item in ipairs(self.stageItems) do
        local _index = self.stageIndex + index - offsetIndex
        local d = self.stages[_index]
        item.gameObject:SetActiveE(d and 1 or 0)
        if d then
            local name, surpassScore, icon = self:GetStageCfg(d.sid)
            item.aortext_title.text = _G.GetLangPackValue(name)
            local maxScore = self.model:GetHistoryScore(d.sid)
            if maxScore > 0 then
                item.aortext_score.text = _G.GetLangPackValue(90034511003, maxScore)
            else
                item.aortext_score.text = _G.GetLangPackValue(90034511002)
            end
            if maxScore > 0 and self.model:IsPass(_index) then
                --超越xx%的玩家
                item.aortext_condition.text = _G.GetLangPackValue(90034511014,
                    string.format("%.2f%%", math.min(maxScore / surpassScore * 100, 99.99)))
            else
                item.aortext_condition.text = _G.GetLangPackValue(90034511004, d.pass)
            end
            if icon then
                item.aorrawimage_role:LoadImage(icon, function()
                    item.aorrawimage_role:SetNativeSize()
                end)
            end
            --节点是否锁定
            local isLock = self.model:IsLock(_index) or
                _index > 1 and not self.model:IsPass(_index - 1)
            item.isLock = isLock
            local isPass = not isLock and self.model:IsPass(_index)
            --_G.CS.GrayManager.SetGaryWithAllChildren(item.transform, isLock)
            -- _G.CS.GrayManager.ProcessTextSetGray(item.aortext_title, isLock)
             if _index== self.stageIndex then
                item.aorrawimage_bg:LoadImage(not isLock and stagebg[1] or stagebg[2])
            else
                item.aorrawimage_bg:LoadImage(not isLock and stagebg[3] or stagebg[2])           
            end
            item.aorrawimage_role:SetGray(isLock)
        end
    end
    
    --奖励信息
    local curentStage = self.stages[self.stageIndex]
    local award = curentStage.pass_award
    if self.model:GetHistoryScore(curentStage.sid) > 0 and self.model:IsPass(self.stageIndex) then
        self.go_table.aortext_awardTitle.text = _G.GetLangPackValue(90034511005)
    else
        self.go_table.aortext_awardTitle.text = _G.GetLangPackValue(90024300020)
        --额外添加首通奖励
        if not _G.table.isEmptyOrNil(curentStage.qualify_award) then
            local function isSameAward(a1, a2)
                if a1.type[1] == 0 and a2.type[1] == 0 then
                    for i = 1, 4 do
                        --0#活动type#活动subType#奖励id#奖励数量
                        if not a1.type[i] or a1.type[i] ~= a2.type[i] then
                            return false
                        end
                    end
                    return true
                end
                return a1.type[1] == a2.type[1]
            end
            if _G.table.isEmptyOrNil(award) then
                award = curentStage.qualify_award
            else
                award = _G.DeepCopy(award)
                --合并奖励
                for _, a1 in ipairs(curentStage.qualify_award) do
                    local isAdd = true
                    for _, a2 in ipairs(award) do
                        if isSameAward(a1, a2) then
                            isAdd = false
                            if a2.type[1] == 0 then
                                a2.type[5] = a2.type[5] + a1.type[5] --活动代币奖励
                            else
                                a2.type[2] = a2.type[2] + a1.type[2]
                            end
                            break
                        end
                    end
                    if isAdd then
                        table.insert(award, a1)
                    end
                end
            end
        end
    end
    self.go_table.obj_rewardParent:ClearChildren()
    if award then
        for _, v in ipairs(award) do
            local parent = _G.InstantiateObject(self.go_table.obj_rewardItem, self.go_table.obj_rewardParent)
            parent:SetActiveE(1)
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                v.type,
                parent,
                function(item)
                    if not item or self:IsNil() then
                        return
                    end
                    item.gameObject:SetLocalScale(0.8, 0.8, 0.8)
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
            )
        end
    end

    self:UpdateStageButtons()
end
---获取关卡配置
---@param sid number
---@return number,number,string  @名称id,fraction分数,icon路径
function SpringSwordCasualMainView:GetStageCfg(sid)
    local cfg = _G.ConfigManager.jzxx_stage_cfg[sid]
    return cfg.name,
        (cfg.fraction and cfg.fraction[1][1] or 9999), --超越xx%的玩家
        cfg.icon
end

