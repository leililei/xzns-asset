local ChallengeCounts = {
    10,
    5,
    1,
}
local function getChallengeCount(own)
    for _, v in ipairs(ChallengeCounts) do
        if own >= v then
            return v
        end
    end
    return ChallengeCounts[#ChallengeCounts]
end
local base = require("TakeOutGameMainView")
---@class SpringSwordCasualMainView : TakeOutGameMainView	剑之修行_主页面选关(MT联动)
local SpringSwordCasualMainView = _G.BaseClass("SpringSwordCasualMainView", base)

local stagebg={
    [1]="ImagesH5/hSpringFestival/ui_xchd_jzxx_kk",
    [2]="ImagesH5/hSpringFestival/ui_xchd_jzxx_kk2",
    [3]="ImagesH5/hSpringFestival/ui_xchd_jzxx_kk3",
}
function SpringSwordCasualMainView:OnUIChange(name)
    if name==_G.ConfigManager.ui_cfg.SpringSwordCasualView.Name then
        if self.model:IsGaming() then
            --先结算上一次游玩
            self.model:FinishGame(self.model:GetLastStageIndex(), 0, function()
                    self:RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIChange)
                return
            end)
            return
        end
        self:RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIChange)
    end
end
---打开游戏游玩页面
---@param stageIndex number 关卡索引
---@param callback fun(score:number):void
function SpringSwordCasualMainView:OpenGameView(stageIndex, callback)
    local stageCfg = _G.ConfigManager.jzxx_stage_cfg[self.stages[stageIndex].sid]
    self:RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIChange)
    self:AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIChange)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.SpringSwordCasualView.Name,
        stageIndex,
        stageCfg,
        function(win, num, time, score)
            if self:IsNil() then
                return
            end
            --显示结算面板
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.SwordCasualSettlementView.Name,
                { win = win, num = num, time = time, score = score },
                function(type)
                    self:RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIChange)
                    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SpringSwordCasualView.Name)
                    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SwordCasualSettlementView.Name)
                    if self:IsNil() then
                        return
                    end
                    --重新开始
                    if type == 2 then
                        self:AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIChange)
                        self:OpenGameView(stageIndex, callback)
                        return
                    end

                    --返回主界面
                    if callback then
                        callback(math.max(score or 0, 0))
                    end
                end
            )
        end,
        true --showScore
    )
end

