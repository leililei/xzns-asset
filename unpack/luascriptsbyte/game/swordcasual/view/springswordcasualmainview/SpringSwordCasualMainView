function SpringSwordCasualMainView:OnClickBtn(go)
    if self.stageMove then
        return
    end
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_sweep then
        self:Sweep()
    elseif go == self.go_table.aorbtn_challenge then
        --发起挑战
        local stageSid = self.stages[self.stageIndex].sid
        if self.model:GetHistoryScore(stageSid) > 0 and self.model:IsPass(self.stageIndex) and self.model:GetCoinNumber() <= 0 then
            _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.GetItemWayView.Name,
                    self.model:GetCoinSid()
            )
            return
        end
        self:Challenge(self.stageIndex)
    elseif go == self.go_table.aorbtn_battlePass then
        --战令
        _G.GlobalInterface.JumpActivityByGM(10088, self.activity:GetJumpType(), nil, self.activity:GetMainType())
    elseif go == self.go_table.aorbtn_extraAward then
        _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.SpringSwordCasualExtraAwardView.Name,
                self.activity,
                self.model
        )
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.GamePlayDescribeView.Name,
                196
        )
    end
end
function SpringSwordCasualMainView:Sweep()
    --扫荡
    local coin = self.model:GetCoinNumber()
    if coin <= 0 then
        _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.GetItemWayView.Name,
                self.model:GetCoinSid()
        )
        return
    end
    self.model:Sweep(self.stageIndex,getChallengeCount(coin), function(msg)
        --展示奖励信息
        if msg and msg.ack == 1 and msg.award then
            _G.UIUtils.ShowCommonAward(msg)
        end

        --刷新关卡信息
        self:UpdateStages()
    end)
end

return SpringSwordCasualMainView
