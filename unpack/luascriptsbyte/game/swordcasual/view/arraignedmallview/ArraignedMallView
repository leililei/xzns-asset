---@class ArraignedMallView : UIBaseView	审核模式_充值商店
---@field go_table ArraignedMallView_GoTable
---@field model ArraignedMallModel
---@field datas store_audit_cfg[]
---@field items table<number,ArraignedMallView._obj_item_GoTable>
---@field pointItem CommonRsItem_GoTable
----------------------------------------------------------
---@field callback function                 @关闭回调函数
local ArraignedMallView = _G.BaseClass("ArraignedMallView", _G.UIBaseView)

function ArraignedMallView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    self:AddListener(_G.ArraignedMall.PointUpdate, self.UpdateView)
end

function ArraignedMallView:OnDestroy()
    self:RemoveAllListener()
end

function ArraignedMallView:OnCreate(callback)
    self.model = require("ArraignedMallModel"):GetInstance()
    self.datas = self.model:GetCfgs()
    self.go_table.scrollloopvectical_list:InitItemData(#self.datas, _G.handler(self, self.RefreshItem))
    self.callback = callback

    --加载点数货币栏
    self.model:LoadPointItem(
        self.go_table.obj_goldInfo,
        function(item)
            self.pointItem = item
        end
    )

    if _G.GameUtil.IsUsedRussian() then
        self.go_table.aorrawimage_title:LoadImage("ImagesH5/hMall/ui_djqsd_txt_djqsd")
    end
end

---刷新页面
function ArraignedMallView:UpdateView()
    if self.pointItem then
        self.model:UpdatePointItem(self.pointItem)
    end
    self.go_table.scrollloopvectical_list:UpdateAllItem()
end

---刷新商品元素
---@param index number
---@param go UnityEngine.GameObject
function ArraignedMallView:RefreshItem(index, go)
    if not self.items then
        self.items = {}
    end

    local cfg = self.datas[index + 1]
    local isFirst = not self.model:IsBuy(cfg.id)

    ---@type ArraignedMallView._obj_item_GoTable
    local item = self.items[go:GetInstanceIDE()]
    if not item then
        item = _G.GetAutoGoTable(go)
        _G.AddViewBtnClick(go, _G.handlerbind(self, self.OnClickItemBtn, item))
        self.items[go:GetInstanceIDE()] = item
    end

    item.data = cfg
    item.obj_first:SetActiveE(isFirst and 1 or 0)
    item.obj_firstExtra:SetActiveE(isFirst and 1 or 0)
    item.aortext_name.text = _G.GetLangPackValue(cfg.name)
    item.aorimage_icon.SpriteName = cfg.icon
    item.aorrawimage_buyIcon:SetActiveE(0)
    --价格文本
    --策划说不走store_gear_cfg表, 写死n/100取价格
    item.aortext_num.text = _G.GetLangPackValue(90000010819, cfg.price / 100)
    -- _G.GameUtil.SetPriceByChannel(
    --     cfg.price,
    --     item.aortext_num,
    --     nil,
    --     nil,
    --     false
    -- )
end

---点击商品信息
---@param item ArraignedMallView._obj_item_GoTable|{data:ArraignedMallData}
function ArraignedMallView:OnClickItemBtn(go, isOn, item)
    if not item.data then
        return
    end

    self.model:Buy(item.data.id, function(msg)
        if not msg or msg.ack ~= 1 then
            if type(msg.ack) == "number" then
                _G.PopWindowManager:GetInstance():ShowAllTips(msg.ack)
            end
            return
        end
        self:UpdateView()
        if msg.award then
            _G.UIUtils.ShowCommonAward(msg)
        end
    end)
end

function ArraignedMallView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
        if self.callback then
            self.callback()
        end
    end
end

return ArraignedMallView
