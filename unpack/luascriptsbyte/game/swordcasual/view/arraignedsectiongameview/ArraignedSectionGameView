---@class ArraignedSectionGameView : UIBaseView	审核模式_小游戏选关
---@field go_table MiniSectionGameView_GoTable
---@field typeId number                         审核模式类型id
---@field index number                          审核模式_最大已通过序号
---@field pass table<number,boolean>            审核模式_已通关关卡序号
---@field curIndex number                       审核模式_当前选中序号
---@field awardSid number                       奖励sid
---@field datas jzxx_stage_cfg[]
---@field items table<number,MiniSectionGameView._obj_item_GoTable>
----------------------------------------------------------
---@field callback function                 @关闭回调函数
local ArraignedSectionGameView = _G.BaseClass("ArraignedSectionGameView", _G.UIBaseView)

function ArraignedSectionGameView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.aorbtn_close:SetActiveE(0)
    --self.go_table.aorbtn_help:SetActiveE(0)
end

function ArraignedSectionGameView:OnCreate(typeId)
    self.typeId = typeId
    self:ShowTitleDescription()

    --初始化列表
    if self.typeId == 1001 or self.typeId == 1101 then
        --剑之修行
        local model = require("SwordCasualModel"):GetInstance()
        self.datas = model:GetArraignedSectionCfgs()
        self.pass = model:GetArraignedPass()
        self.index = model:GetArraignedNoPassIndex()
        self:UpdateDouYinBtn()
    else
        self.datas = {}
        self.index = 1
    end
    self.curIndex = self.index
    self.go_table.scrollloopvectical_ItemList:InitItemData(
        #self.datas,
        _G.handler(self, self.RefreshSection),
        self.index - 1
    )
end

---显示标题信息
function ArraignedSectionGameView:ShowTitleDescription()
    local cfg = _G.ConfigManager.game_show_title_cfg[self.typeId]
    if not cfg then
        if _G.AppSetting.DEBUG then
            _G.LogError("ArraignedSectionGameView:ShowTitleDescription() cfg is nil: " .. tostring(self.typeId))
        end
        return
    end
    --toggle
    local toggleObj = _G.InstantiateObject(self.go_table.toggle_temp, self.go_table.togglegroup_Content)
    toggleObj:SetActiveE(1)
    local toggleTb = _G.GetAutoGoTable(toggleObj)
    toggleTb.aorimage_iconOn.SpriteName = cfg.c_icon
    toggleTb.aorimage_iconOff.SpriteName = cfg.n_icon
    toggleTb.aortext_name.text = _G.GetLangPackValue(cfg.Name)
    toggleTb.aorimage_isOn:SetActiveE(1)
    --toggleObj:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle)).isOn = true

    --background
    self.go_table.aorrawimage_bg:LoadImage(cfg.bg)
    self.go_table.aorrawimage_name:LoadImage(cfg.title_img)
    local cardCfg = _G.ConfigManager.card_cfg[cfg.hero_id]
    local scale = cardCfg.size2
    local pos = cardCfg.pos_portrait
    local path = _G.UIUtils.GetBattleSpine(cardCfg, _G.UseBattleSpine.RankView)
    if _G.UIUtils.IsUseBattleSpine(_G.UseBattleSpine.RankView) then
        scale = cardCfg.size4
        pos = { 0, 0, 0 }
    end
    self.go_table.obj_spine:ClearChildren()
    _G.PoolsManager:GetInstance():Spawn(
        path,
        _G.ePoolType.Temporary,
        self.go_table.obj_spine,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
            trans:SetLocalScaleXYZ(scale)
            trans:SetLocalPosition(_G.table.unpack(pos))
        end
    )
    --审核特殊渠道显示
    --toggleTb.aortext_name.text = _G.GetLangPackValue(90036300048)
    --self.go_table.aorrawimage_name:LoadImage(
    --    "ImagesH5/hMiniSectionGame/ui_txt_htzc"
    --)

    if _G.GameUtil.IsUsedRussian() then
        self.go_table.aorrawimage_name:SetActiveE(0)
    else
        self.go_table.aorrawimage_name:SetActiveE(1)
    end
end

---刷新显示列表关卡item
---@param index number @列表索引
---@param go GameObject @列表item对象
function ArraignedSectionGameView:RefreshSection(index, go)
    if not self.items then
        self.items = {}
    end

    index = index + 1

    ---@type MiniSectionGameView._obj_item_GoTable
    local item = self.items[go:GetInstanceIDE()]
    if not item then
        item = _G.GetAutoGoTable(go)
        _G.AddViewBtnClick(go, _G.handlerbind(self, self.OnClickSectionBtn, item))
        self.items[go:GetInstanceIDE()] = item
    end

    local data = self.datas[index]
    item.data = data
    item.index = index
    item.obj_isOn:SetActiveE(index == self.curIndex and 1 or 0)
    item.aorbtn_click:SetActiveE(1)
    item.aortext_floor.text = _G.GetLangPackValue(90049100011, index)
    if self.pass[index] then
        item.aortext_state.text = _G.GetLangPackValue(90000000118)
    else
        item.aortext_state.text = _G.GetLangPackValue(90000010806)
    end

end

function ArraignedSectionGameView:RefreshAward(index, obj, item)
    if not item.awardItems then
        item.awardItems = {}
    end
    index = index + 1
    local data = item.awards[index]
    local awardItem = item.awardItems[obj:GetInstanceIDE()]
    if not awardItem then
        awardItem = _G.GetAutoGoTable(obj)
        awardItem.award = require "BaseAwardNewItem".New(awardItem.obj_Root)
        item.awardItems[obj:GetInstanceIDE()] = awardItem
    end
    
end

function ArraignedSectionGameView:UpdateDouYinBtn()
    local isDouYinArraigned = require("DouyinModel"):GetInstance():GetIsDouYinArraigned()
    self.go_table.aorbtn_entry:SetActiveE(isDouYinArraigned and 1 or 0)
    self.go_table.aorbtn_customer:SetActiveE(isDouYinArraigned and 1 or 0)
end

---点击关卡列表
---@param item {data:jzxx_stage_cfg,index:number}
function ArraignedSectionGameView:OnClickSectionBtn(go, isOn, item)
    if not item.data then
        return
    end
    self.curIndex = item.index
    self.go_table.scrollloopvectical_ItemList:UpdateAllItem()
end

function ArraignedSectionGameView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_challenge then
        if self.typeId == 1001 or self.typeId == 1101 then
            --剑之修行
            require("SwordCasualModel"):GetInstance():ArraignedChallengeStage(self.datas[self.curIndex])
        end
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 186)
    elseif go == self.go_table.aorbtn_entry then
        _G.SDKManager:GetInstance():FollowUpReport(require("SDKDef").GameLauncher.ClickEnter)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DouyinSideBarView.Name)
    elseif go == self.go_table.aorbtn_customer then
        require("DouyinModel"):GetInstance():OpenCustomerService()
    end
end

return ArraignedSectionGameView
