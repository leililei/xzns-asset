local OrderBg = {
    "ImagesH5/hDungones/ui_qjhs_ywxz_db_lan",
    "ImagesH5/hDungones/ui_qjhs_ywxz_db_zi",
    "ImagesH5/hDungones/ui_qjhs_ywxz_db_cheng"
}

---@class SwordCasualEventView : UIBaseView	剑之修行_事件页面
---@field go_table SwordCasualEventView_GoTable
---@field items SwordCasualEventView._obj_Item1_GoTable[] 节点状态
---@field cfgs jzxx_event_cfg[]                     @配置数据
---@field callback fun(cfg:jzxx_event_cfg)          @回调函数
---@field selectIndex number                        @当前选中索引
----------------------------------------------------------
---@field payConsume number                         @重置效果道具消耗, 如果传0表示不能使用货币重置
---@field pointItem CommonRsItem_GoTable            @点数货币栏实例(提审模式)
---@field resetCallback fun(num:number)             @重置回调函数
local SwordCasualEventView = _G.BaseClass("SwordCasualEventView", _G.UIBaseView)

function SwordCasualEventView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    self:AddListener(_G.ArraignedMall.PointUpdate, self.UpdatePointView)
end

function SwordCasualEventView:OnDestroy()
    self:RemoveAllListener()
end

function SwordCasualEventView:OnCreate(cfgs, callback, payConsume, resetCallback)
    self.cfgs = cfgs
    self.callback = callback
    self.resetCallback = resetCallback
    self.selectIndex = 0

    self:InitView()
    self:Set(cfgs)
    self:SetPayConsume(payConsume)
end

---设置buff列表
function SwordCasualEventView:Set(cfgs)
    self.cfgs = cfgs
    self.selectIndex = 0

    self:UpdateView()
end

---设置是否使用货币消耗
function SwordCasualEventView:SetPayConsume(num)
    self.payConsume = num or 0
    self.go_table.aorbtn_reset:SetActiveE(self.payConsume > 0 and 1 or 0)

    if self.payConsume > 0 then
        local model = require("ArraignedMallModel"):GetInstance()
        self.go_table.aortext_resetConsume.text = string.format("x%d", self.payConsume)

        if not self.__initPayConsume then
            self.__initPayConsume = true
            --图标
            local iconPath = _G.StorageManager:GetInstance():GetItemIcon(model:GetPointSid()) --即使不登录, 此接口也可正常使用
            self.go_table.aorrawimage_resetIcon:LoadImage(iconPath)
            --道具栏
            model:LoadPointItem(
                self.go_table.obj_goldInfo,
                function(item)
                    self.pointItem = item
                end,
                function()
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArraignedMallView.Name)
                end
            )
        end
    end
end

---获取当前货币消耗
function SwordCasualEventView:GetPayConsume()
    return self.payConsume or 0
end

function SwordCasualEventView:UpdatePointView()
    if self.pointItem then
        require("ArraignedMallModel"):GetInstance():UpdatePointItem(self.pointItem)
    end
end

---初始化页面状态
---@private
function SwordCasualEventView:InitView()
    self.items = {
        _G.GetAutoGoTable(self.go_table.obj_Item1, _G.handlerbind(self, self.OnClickEvents, 1)),
        _G.GetAutoGoTable(self.go_table.obj_Item2, _G.handlerbind(self, self.OnClickEvents, 2)),
        _G.GetAutoGoTable(self.go_table.obj_Item3, _G.handlerbind(self, self.OnClickEvents, 3)),
    }
end

---更新页面状态
---@private
function SwordCasualEventView:UpdateView()
    for i, item in ipairs(self.items) do
        if self.cfgs[i] then
            item.obj_effectChoose:SetActiveE(0)
            item.gameObject:SetLocalScaleXYZ(0.8)
            item.aorrawimage_bg:LoadImage(OrderBg[self.cfgs[i].quality])
            item.aorrawimage_icon:LoadImage(self.cfgs[i].img_path)
            item.aortext_name.text = _G.GetLangPackValue(self.cfgs[i].Name)
            item.aortext_desc.text = _G.GetLangPackValue(self.cfgs[i].intr)
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_SecretRealmSettlementView_xuanze,
                item.obj_effectChoose
            )
        else
            item.gameObject:SetActiveE(0)
        end
    end
end

function SwordCasualEventView:OnClickEvents(_, _, index)
    if self.selectIndex > 0 and self.selectIndex ~= index then
        ---@type SwordCasualEventView._obj_Item1_GoTable
        local lastItem = self.items[self.selectIndex]
        lastItem.gameObject:SetLocalScaleXYZ(0.8)
        lastItem.obj_effectChoose:SetActiveE(0)
    end
    self.selectIndex = index

    ---@type SwordCasualEventView._obj_Item1_GoTable
    local selectItem = self.items[index]
    selectItem.gameObject:SetLocalScaleXYZ(1)
    selectItem.obj_effectChoose:SetActiveE(1)
end

---按钮点击事件在这里派发
function SwordCasualEventView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        --self:Close()
    elseif go == self.go_table.aorbtn_Sure and self.selectIndex > 0 then
        if self.callback then
            self.callback(self.cfgs[self.selectIndex])
        end
    elseif go == self.go_table.aorbtn_reset then
        if self.resetCallback then
            self.resetCallback(self.payConsume or 0)
        end
    end
end

return SwordCasualEventView
