---更新剑与其他角色的重叠碰撞(a->b发动攻击)
---@param a SwordCasual_RoleItem @主角色实例
---@param b SwordCasual_RoleItem @其他角色实例列表
function SwordCasualView:UpdateRoleOverlap(a, b)
    local aSwords = a:GetSwordItems()
    local bSwords = b:GetSwordItems()

    local isAttackA, isAttackB = false, false
    --计算a->b攻击逻辑
    if aSwords then
        local isDestroyed = false
        for i = #aSwords, 1, -1 do
            --a武器 -> b武器
            isDestroyed = false
            if bSwords then
                for j = #bSwords, 1, -1 do
                    if SwordCasual_Utils.Physics:rectOverlapOBB(aSwords[i]:GetRect(), bSwords[j]:GetRect()) then
                        local val = math.max(1, math.min(aSwords[i]:GetHp(), bSwords[j]:GetHp()))
                        aSwords[i]:ChangeHp(-val)
                        bSwords[j]:ChangeHp(-val)
                        aSwords[i]:PlayHitEff()
                        if aSwords[i]:IsDeath() then
                            local delayItem = aSwords[i] --防止延迟销毁多把刀时i变化
                            _G.DelayDo(
                                0.5,
                                function()
                                    if self:IsNil() then
                                        return
                                    end
                                    self.swordPool:Release(delayItem)
                                end
                            )
                            a:RemoveSwordItem(aSwords[i])
                            isDestroyed = true --武器损毁
                        end
                        if bSwords[j]:IsDeath() then
                            self.swordPool:Release(bSwords[j])
                            b:RemoveSwordItem(bSwords[j])
                        end
                        break
                    end
                end
            end
            --a武器 -> b角色
            if not isDestroyed and not b:IsSuperArmor() and SwordCasual_Utils.Physics:rectOverlapOBB(aSwords[i]:GetRect(), b:GetRect()) then
                b:ChangeHp(-aSwords[i]:GetAttack())
                if b:IsBeatback() then
                    b:Beatback(
                        SwordCasual_Utils.Physics:direction(a, b),
                        SWORD_BEATBACK_DISTANCE *
                        (1 + a:GetEffectValue(SwordCasual_Utils.Effects.BeatbackPercent) * 0.0001),
                        0.2
                    )
                end
                isAttackB = true
                if b:IsDeath() then
                    self:ClearSwordOrBullet(b)
                    break
                end
            end
        end
    end
    --计算b->a攻击逻辑
    if bSwords and not a:IsSuperArmor() then
        for i = #bSwords, 1, -1 do
            if SwordCasual_Utils.Physics:rectOverlapOBB(bSwords[i]:GetRect(), a:GetRect()) then
                a:ChangeHp(-bSwords[i]:GetAttack())
                if a:IsBeatback() then
                    a:Beatback(
                        SwordCasual_Utils.Physics:direction(b, a),
                        SWORD_BEATBACK_DISTANCE *
                        (1 + b:GetEffectValue(SwordCasual_Utils.Effects.BeatbackPercent) * 0.0001),
                        0.2
                    )
                end
                isAttackA = true
                if a:IsDeath() then
                    self:ClearSwordOrBullet(a)
                    break
                end
            end
        end
    end
    --计算a <-> b本体重叠攻击
    if not a:IsSuperArmor() and not b:IsSuperArmor() and SwordCasual_Utils.Physics:rectOverlapOBB(a:GetRect(), b:GetRect()) then
        a:ChangeHp(-b:GetAttack())
        b:ChangeHp(-a:GetAttack())
        if a:IsBeatback() then
            a:Beatback(
                SwordCasual_Utils.Physics:direction(b, a),
                SWORD_BEATBACK_DISTANCE *
                (1 + b:GetEffectValue(SwordCasual_Utils.Effects.BeatbackPercent) * 0.0001),
                0.2
            )
        end
        if b:IsBeatback() then
            b:Beatback(
                SwordCasual_Utils.Physics:direction(a, b),
                SWORD_BEATBACK_DISTANCE *
                (1 + a:GetEffectValue(SwordCasual_Utils.Effects.BeatbackPercent) * 0.0001),
                0.2
            )
        end
        isAttackA = true
        isAttackB = true
    end

    if isAttackA then
        a:SetSuperArmor(SUPER_ARMOR_TIME)
    end
    if isAttackB then
        b:SetSuperArmor(SUPER_ARMOR_TIME)
    end
end

---更新子弹与角色的重叠碰撞(a->b发射子弹)
---@param item SwordCasual_RoleItem @主角色实例
---@param bullets SwordCasual_BulletItem[]
function SwordCasualView:UpdateBulletOverlap(item, bullets)
    local swords = item:GetSwordItems()
    local team = item:GetTeam()

    local isDestroyed = false
    for i = #bullets, 1, -1 do
        if bullets[i]:GetTeam() ~= team then
            --检测子弹是否被武器格挡
            isDestroyed = false
            if swords and bullets[i]:IsBlocked() then
                for j = #swords, 1, -1 do
                    if SwordCasual_Utils.Physics:rectOverlapOBB(bullets[i]:GetRect(), swords[j]:GetRect()) then
                        self:OnBulletDestroyed(bullets[i])
                        isDestroyed = true
                        break
                    end
                end
            end
            --检测子弹是否击中目标
            if
                not isDestroyed and not item:IsSuperArmor() and
                SwordCasual_Utils.Physics:rectOverlapOBB(bullets[i]:GetRect(), item:GetRect())
            then
                item:ChangeHp(-bullets[i]:GetAttack())
                item:SetSuperArmor(SUPER_ARMOR_TIME)
                if item:IsBeatback() then
                    local parent = bullets[i]:GetParent()
                    local percent = parent and
                        (parent:GetEffectValue(SwordCasual_Utils.Effects.BeatbackPercent) * 0.0001) or 0
                    item:Beatback(
                        bullets[i]:GetDirection(),
                        BULLET_BEATBACK_DISTANCE * (1 + percent),
                        0.2
                    )
                end
                --子弹穿透
                bullets[i]:ChangeHp(-1)
                if bullets[i]:IsDeath() then
                    self:OnBulletDestroyed(bullets[i])
                end

                if item:IsDeath() then
                    self:ClearSwordOrBullet(item)
                    break
                end
            end
        end
    end
end

---更新地图与主角色方向
function SwordCasualView:UpdateDirection()
    self.mapControll:SetDirection(self.direction)
    if self.masterItem then
        self.masterItem:SetDirection(self.direction)
    end
end

---更新Monster列表层级顺序
function SwordCasualView:UpdateMonsterSibling()
    table.sort(
        self.monsterItems,
        function(a, b)
            return a:GetOrderPosition() > b:GetOrderPosition()
        end
    )
    local criticalOrderPosition = self.masterItem:GetOrderPosition()

    local n = #self.monsterItems
    for i = n, 1, -1 do
        local orderPosition = self.monsterItems[i]:GetOrderPosition()
        if orderPosition < criticalOrderPosition then
            break
        end
        self.monsterItems[i].transform:SetAsFirstSiblingE()
    end
    for i = 1, n do
        local orderPosition = self.monsterItems[i]:GetOrderPosition()
        if orderPosition >= criticalOrderPosition then
            break
        end
        self.monsterItems[i].transform:SetAsLastSiblingE()
    end
end

---是否暂停游戏
---@return boolean
function SwordCasualView:IsPause()
    return self.pause or not self.masterItem
end

---设置是否暂停游戏
---@param pause boolean
function SwordCasualView:SetPause(pause)
    self.pause = pause
end

---设置渲染表现层暂停(DOTween动画)
function SwordCasualView:SetPauseRenderer(pause)
    local masterSwords = self.masterItem:GetSwordItems()
    if masterSwords then
        for _, swordItem in ipairs(masterSwords) do
            if pause then
                swordItem:StopRotateAnimation()
            else
                swordItem:UpdateRotateAnimation()
            end
        end
    end
    for _, monsterItem in ipairs(self.monsterItems) do
        local monsterSwords = monsterItem:GetSwordItems()
        if monsterSwords then
            for _, swordItem in ipairs(monsterSwords) do
                if pause then
                    swordItem:StopRotateAnimation()
                else
                    swordItem:UpdateRotateAnimation()
                end
            end
        end
    end
    for _, bulletItem in ipairs(self.bulletItems) do
        if pause then
            bulletItem:StopMoveAnimation()
        else
            bulletItem:UpdateMoveAnimation()
        end
    end
end

---战斗是否已结束
function SwordCasualView:IsFinish()
    --出怪阶段是否已结束
    if not self.createFinish then
        return false
    end

    --怪物是否已被歼灭
    if self.monsterItems and #self.monsterItems > 0 then
        return false
    end
    return true
end

