---监听处理怪物死亡事件
---@param roleItem SwordCasual_RoleItem @角色实例
function SwordCasualView:OnMonsterDeath(monsterItem)
    self.kill = self.kill + 1

    --分数
    local cfg = monsterItem:GetData()
    if cfg then
        if self.score >= 0 then
            self.score = self.score + cfg.score
            self:UdpateScore()
        end
    end

    --延迟回收实例(等待动画完成)
    _G.DelayDo(
        SUPER_ARMOR_TIME,
        function()
            if self:IsNil() then
                return
            end
            monsterItem:PlayDeathAnimation(
                function()
                    --生成掉落物
                    ---@type jzxx_role_cfg
                    local cfg = monsterItem:GetData()
                    if cfg then
                        local drop = 0
                        if cfg.drop_rate > 0 and math.random() <= cfg.drop_rate then
                            drop = drop + 1
                            local cx, cy = monsterItem:GetPosition()
                            ---@type SwordCasual_BoxItem
                            local boxItem = self:CreateBoxItem(1, cfg, cx, cy)
                            boxItem:SetDuration(30) --保留30秒
                            table.insert(self.boxItems, boxItem)
                        end
                        if cfg.event_rate > 0 and math.random() <= cfg.event_rate and self.effectCfgs and #self.effectCfgs > 0 then
                            local cx, cy = monsterItem:GetPosition()
                            if drop > 0 then
                                cx = cx + math.random(-20, 20)
                                cy = cy - 50
                            end
                            cx = cx + math.random(-10, 10)
                            cy = cy + math.random(-10, 10)
                            ---@type SwordCasual_BoxItem
                            local boxItem = self:CreateBoxItem(2, cfg, cx, cy)
                            boxItem:SetDuration(30) --保留30秒
                            table.insert(self.boxItems, boxItem)
                        end
                    end

                    --回收节点
                    self:ReleaseMonsterItem(monsterItem)
                    --战斗胜利结算
                    if self:IsFinish() then
                        self:SetPause(true)
                        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SwordCasualEventView.Name)
                        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArraignedMallView.Name)

                        local jssc = _G.ConfigManager.jzxx_stage_show_cfg[1000 + self.cfg.type]

                        if self.callback then
                            self.callback(not self.masterItem:IsDeath(), self.kill, self.time, self.score, jssc)
                            self.callback = nil
                        end
                    end
                end
            )
        end
    )
end

---监听处理盒子销毁事件
