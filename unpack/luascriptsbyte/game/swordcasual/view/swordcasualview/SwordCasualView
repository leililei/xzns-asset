---监听子弹发射事件
---@param shooter SwordCasual_MonsterShooterItem @射击手实例
---@param target SwordCasual_RoleItem @目标实例
---@return SwordCasual_BulletItem
function SwordCasualView:OnShoot(shooter, target)
    --初始位置和方向
    local x, y = shooter:GetPosition()
    local tx, ty = target:GetPosition()
    local offsetX, offsetY = tx - x, ty - y
    --为子弹朝向添加一个随机偏移值
    offsetX = offsetX + math.random(-5, 5)
    offsetY = offsetY + math.random(-10, 10)

    local distance = math.sqrt(offsetX * offsetX + offsetY * offsetY)
    if distance < 0.001 then
        if _G.AppSetting.DEBUG then
            _G.LogError("目标与射击手距离过近: 位置重叠")
        end
        return
    end
    local direction = { x = offsetX / distance, y = offsetY / distance }

    ---@type SwordCasual_BulletItem
    local bulletItem = self.bulletPool:Get()
    shooter:AddBulletItem(bulletItem)
    bulletItem:SetDirection(direction)
    bulletItem:SetPosition(x, y)
    --子弹配置
    local d = shooter:GetData()
    if d then
        local cfg = _G.ConfigManager.jzxx_bullet_cfg[d.bullet_id]
        bulletItem:SetData(cfg)
        --bulletItem:SetTraceTarget(target)   --追踪弹
    end

    --注册子弹销毁事件
    local onBulletDestroyed = self[self.OnBulletDestroyed]
    if not onBulletDestroyed then
        onBulletDestroyed = _G.handler(self, self.OnBulletDestroyed)
        self[self.OnBulletDestroyed] = onBulletDestroyed
    end
    bulletItem:OnDestroyed(onBulletDestroyed)

    table.insert(self.bulletItems, bulletItem)
end

---监听主角射击事件
---@param shooter SwordCasual_MasterItem @射击手实例
function SwordCasualView:OnMasterShoot(shooter)
    if not self.monsterItems or #self.monsterItems <= 0 then
        return
    end

    --寻找最近的目标
    local target = self.monsterItems[1]
    local distance = SwordCasual_Utils.Physics:magnitude(shooter:GetRect(), target:GetRect())
    for i = 2, #self.monsterItems do
        local _d = SwordCasual_Utils.Physics:magnitude(shooter:GetRect(), self.monsterItems[i]:GetRect())
        if _d < distance then
            distance = _d
            target = self.monsterItems[i]
        end
    end

    self:OnShoot(shooter, target)
end

---监听子弹销毁事件
---@param bulletItem SwordCasual_BulletItem @子弹实例
function SwordCasualView:OnBulletDestroyed(bulletItem)
    local parent = bulletItem:GetParent()
    if parent then
        parent:RemoveBulletItem(bulletItem)
    end
    self.bulletPool:Release(bulletItem)
    --从全局列表中移除
    for i = #self.bulletItems, 1, -1 do
        if self.bulletItems[i] == bulletItem then
            table.remove(self.bulletItems, i)
            break
        end
    end
end

---监听剑创建事件
---@param roleItem SwordCasual_RoleItem @角色实例
---@param swordItem SwordCasual_SwordItem @剑实例
function SwordCasualView:OnSwordCreated(roleItem, swordItem)
    local d = roleItem:GetData()
    swordItem:SetHp(1)
    swordItem:SetSpeed(d.rota_speed)
    swordItem:SetAttack(d.sword_atk)
    swordItem:SetModelCfgs(d.sword_png)
    --非主角使用指定模型
    if not roleItem:instanceof(SwordCasual_MasterItem) then
        if d.sword_png and #d.sword_png > 0 then
            swordItem:SetModel(d.sword_png[1])
        end
    end

    --注册剑生命值改变事件
    local onHpChange = self[self.OnSwordHpChange]
    if not onHpChange then
        onHpChange = _G.handler(self, self.OnSwordHpChange)
        self[self.OnSwordHpChange] = onHpChange
    end
    swordItem:OnHpChange(onHpChange)

    --角色buff状态处理
    local swordDirection = roleItem:GetEffectOverlay(SwordCasual_Utils.Effects.SwordDirection)
    if swordDirection % 2 == 1 then
        --刀的方向改变
        swordItem:SetSpeed(swordItem:GetSpeed() * -1)
    end
    local swordSpeedScale = roleItem:GetEffectValue(SwordCasual_Utils.Effects.SwordRotateSpeed)
    if swordSpeedScale > 0 then
        --刀的速度改变
        local speedScale = math.max(1 + swordSpeedScale * 0.0001, 0.1)
        swordItem:SetSpeedScale(speedScale)
    end
end

---监听剑生命值改变事件
---@param swordItem SwordCasual_SwordItem @剑实例
---@param newValue number @新生命值
---@param offset number @改变值
function SwordCasualView:OnSwordHpChange(swordItem, newValue, offset)
    if newValue <= 0 then
        return
    end
    local parent = swordItem:GetParent()
    if not parent or not parent:GetEffect(SwordCasual_Utils.Effects.SwordAddAttack) then
        --角色身上不带增加剑的buff, 不作处理
        return
    end
    local changeAttack = parent:GetEffectOverlay(SwordCasual_Utils.Effects.SwordAddAttack)
    local oldValue = newValue - offset
    if oldValue <= 1 and newValue >= 2 then
        --增加剑的攻击
        swordItem:SetAttack(swordItem:GetAttack() + changeAttack)
    elseif oldValue >= 2 and newValue <= 1 then
        --减少剑的攻击
        swordItem:SetAttack(swordItem:GetAttack() - changeAttack)
    end
end

---监听主角死亡事件
function SwordCasualView:OnMasterDeath()
    -- if true then
    --     --TODO: 测试数据
    --     self.masterItem:SetHp(99)
    --     self.masterItem:SetShowHp(true)
    --     return
    -- end
