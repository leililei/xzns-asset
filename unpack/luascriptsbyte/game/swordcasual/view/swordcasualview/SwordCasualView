---监听处理收集掉落物事件
---@param roleItem SwordCasual_RoleItem @角色实例
---@param boxItem SwordCasual_BoxItem @盒子实例
function SwordCasualView:OnBoxCollect(roleItem, boxItem)
    if boxItem:GetType() == 1 then
        ---@type jzxx_role_cfg
        local data = boxItem:GetData()
        if not data then
            return
        end

        local addSwordCount = math.max(1, data.sword_num) --新增道具数量
        self:AddSwords(roleItem, addSwordCount)
        roleItem:PlayAddSwordEff()
    else
        if not self.effectCfgs or #self.effectCfgs == 0 then
            return
        end
        self:OnEventCollect(roleItem, false)
    end
end

---监听处理事件收集事件
---@param roleItem SwordCasual_RoleItem @角色实例
---@param removeResetEvent? boolean @是否移除重置事件
function SwordCasualView:OnEventCollect(roleItem, removeResetEvent)
    if not self.effectCfgs or #self.effectCfgs == 0 then
        return
    end

    --主角拾取事件
    if roleItem:instanceof(SwordCasual_MasterItem) then
        --过滤重置事件(不要连续刷出重置事件)
        local events = { table.unpack(self.effectCfgs) }
        if removeResetEvent then
            for i = #events, 1, -1 do
                if events[i].id == SwordCasual_Utils.Effects.Reset then
                    table.remove(events, i)
                end
            end
        end

        --随机获取2~3个事件
        local count = math.random() > 0.8 and 3 or 2
        events = SwordCasual_Utils.randomCfgs(events, count)
        if not events or #events == 0 then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SwordCasualEventView.Name)
            --如果当前处于暂停中, 还原状态
            if self:IsPause() then
                self:SetPause(false)
                self:SetPauseRenderer(false)
            end
            return
        end

        --暂停游戏, 进入选择面板
        if not self:IsPause() then
            self:SetPause(true)
            self:SetPauseRenderer(true)
            --暂停动作
            roleItem:SetDirection({ x = 0, y = 0 })
        end

        ---@type SwordCasualEventView
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SwordCasualEventView.Name)
        if view then
            view:Set(events)
            if self.isPayment then
                view:SetPayConsume(math.max(1, view:GetPayConsume() * 2)) --消耗呈现: 1/2/4/8/....规律增加
            else
                view:SetPayConsume(-1)
            end
        else
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.SwordCasualEventView.Name,
                events,
                ---@param cfg jzxx_event_cfg
                function(cfg)
                    if cfg.id == SwordCasual_Utils.Effects.Reset then
                        self:OnAddEffect(roleItem, cfg)
                        return
                    end
                    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SwordCasualEventView.Name)
                    self:SetPause(false)
                    self:SetPauseRenderer(false)

                    self:OnAddEffect(roleItem, cfg)
                end,
                self.isPayment and 1 or -1,
                function(num)
                    if num <= 0 then
                        return
                    end
                    local model = require("ArraignedMallModel"):GetInstance()
                    if model:GetPointNum() < num then
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArraignedMallView.Name) --此时游戏已处于暂停状态, 无需额外处理
                        return
                    end

                    model:UsePointNum(num)
                    self:OnEventCollect(roleItem, false) --重新刷新列表
                end
            )
        end
    else
        local cfg = self.effectCfgs[math.random(1, #self.effectCfgs)]
        if cfg.id == SwordCasual_Utils.Effects.Reset then
            return
        end
        self:OnAddEffect(roleItem, cfg)
    end
end

---为目标角色添加buff
---@param roleItem SwordCasual_RoleItem @角色实例
---@param cfg jzxx_event_cfg
function SwordCasualView:OnAddEffect(roleItem, cfg)
    ---如果选择了唯一事件, 从事件列表中移除
    if cfg.isOnly then
        for i = #self.effectCfgs, 1, -1 do
            if cfg == self.effectCfgs[i] then
                table.remove(self.effectCfgs, i)
            end
        end
    end

    ---@type table<number,function>
    local effectAdds = self.__EffectAdds
    if not effectAdds then
        effectAdds = {
            ---增加速度
            ---@param roleItem SwordCasual_RoleItem
            ---@param cfg jzxx_event_cfg
            [SwordCasual_Utils.Effects.Speed] = function(roleItem, cfg)
                roleItem:AddEffect(SwordCasual_Utils.Effects.Speed, cfg.value)
            end,
            ---击退距离增加百分比
            ---@param roleItem SwordCasual_RoleItem
            ---@param cfg jzxx_event_cfg
            [SwordCasual_Utils.Effects.BeatbackPercent] = function(roleItem, cfg)
                roleItem:AddEffect(SwordCasual_Utils.Effects.BeatbackPercent, cfg.value)
            end,
            ---刀刃反向旋转(额外增加一把刀)
            ---@param roleItem SwordCasual_RoleItem
            ---@param cfg jzxx_event_cfg
            [SwordCasual_Utils.Effects.SwordDirection] = function(roleItem, cfg)
                roleItem:AddEffect(SwordCasual_Utils.Effects.SwordDirection, 1)
                self:AddSwords(roleItem, 1)
            end,
            ---额外增加两把刀
            ---@param roleItem SwordCasual_RoleItem
            ---@param cfg jzxx_event_cfg
            [SwordCasual_Utils.Effects.AddSword2] = function(roleItem, cfg)
                self:AddSwords(roleItem, 2)
                roleItem:PlayAddSwordEff()
            end,
            ---刀转速增加
            ---@param roleItem SwordCasual_RoleItem
            ---@param cfg jzxx_event_cfg
            [SwordCasual_Utils.Effects.SwordRotateSpeed] = function(roleItem, cfg)
                roleItem:AddEffect(SwordCasual_Utils.Effects.SwordRotateSpeed, cfg.value)
            end,
            ---重置效果列表
            ---@param roleItem SwordCasual_RoleItem
            ---@param cfg jzxx_event_cfg
            [SwordCasual_Utils.Effects.Reset] = function(roleItem, cfg)
                self:OnEventCollect(roleItem, true)
            end,
            ---概率加减刀: 50%加两把刀, 50%失去两把刀
            ---@param roleItem SwordCasual_RoleItem
            ---@param cfg jzxx_event_cfg
            [SwordCasual_Utils.Effects.ProbAddSword] = function(roleItem, cfg)
                if math.random() > 0.5 then
                    --添加刀
                    self:AddSwords(roleItem, 4)
                    roleItem:PlayAddSwordEff()
                else
                    --损失刀
                    local swords = roleItem:GetSwordItems()
                    if swords then
                        local n = 2
                        while #swords > 0 and n > 0 do
                            local randomSword = swords[math.random(1, #swords)]
                            if randomSword:GetHp() > n then
                                randomSword:ChangeHp(-n)
                                n = 0
                            else
                                --randomSword:SetHp(0)
                                n = n - randomSword:GetHp()
                                self.swordPool:Release(randomSword)
                                roleItem:RemoveSwordItem(randomSword)
                            end
                        end
                    end
                end
            end,
            ---发射飞刀(子弹)
            ---@param roleItem SwordCasual_RoleItem
            ---@param cfg jzxx_event_cfg
            [SwordCasual_Utils.Effects.Shooter] = function(roleItem, cfg)
                roleItem:AddEffect(SwordCasual_Utils.Effects.Shooter, 1)
            end,
            ---2级以上刀增加攻击力
            ---@param roleItem SwordCasual_RoleItem
            ---@param cfg jzxx_event_cfg
            [SwordCasual_Utils.Effects.SwordAddAttack] = function(roleItem, cfg)
                roleItem:AddEffect(SwordCasual_Utils.Effects.SwordAddAttack, 1)
            end,

        }
        self.__EffectAdds = effectAdds
    end

    local add = effectAdds[cfg.id]
    if add then
        add(roleItem, cfg)
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("未实现的效果处理:" .. tostring(cfg.id))
        end
    end
end

---监听处理角色效果变化事件
---@param roleItem SwordCasual_MasterItem
---@param effect SwordCasual_Effect
---@param beforeOverlay number
---@param afterOverlay number
function SwordCasualView:OnEffectChange(roleItem, effect, beforeOverlay, afterOverlay)
    ---@type table<number,function>
    local effectResolves = self.__EffectResolves
    if not effectResolves then
        effectResolves = {
            ---增加移动速度
            ---@param roleItem SwordCasual_MasterItem
            ---@param effect SwordCasual_Effect
            ---@param beforeOverlay number
            ---@param afterOverlay number
            [SwordCasual_Utils.Effects.Speed] = function(roleItem, effect, beforeOverlay, afterOverlay)
                local speedScale = math.max(1 + afterOverlay * effect.value * 0.0001, 0.1)
                roleItem:SetSpeedScale(speedScale, true)
            end,
            ---刀旋转改向
            ---@param roleItem SwordCasual_MasterItem
            ---@param effect SwordCasual_Effect
            ---@param beforeOverlay number
            ---@param afterOverlay number
            [SwordCasual_Utils.Effects.SwordDirection] = function(roleItem, effect, beforeOverlay, afterOverlay)
                if math.abs(afterOverlay - beforeOverlay) % 2 ~= 1 then
                    --旋转方向未曾改变
                    return
                end
                local swords = roleItem:GetSwordItems()
                if not swords then
                    return
                end
                for _, swordItem in ipairs(swords) do
                    swordItem:SetSpeed(swordItem:GetSpeed() * -1)
                end
            end,
            ---增加刀旋转速度
            ---@param roleItem SwordCasual_MasterItem
            ---@param effect SwordCasual_Effect
            ---@param beforeOverlay number
            ---@param afterOverlay number
            [SwordCasual_Utils.Effects.SwordRotateSpeed] = function(roleItem, effect, beforeOverlay, afterOverlay)
                local swords = roleItem:GetSwordItems()
                if not swords then
                    return
                end
                local speedScale = math.max(1 + afterOverlay * effect.value * 0.0001, 0.1)
                for _, swordItem in ipairs(swords) do
                    swordItem:SetSpeedScale(speedScale)
                end
            end,
            ---增加攻击值
            ---@param roleItem SwordCasual_MasterItem
            ---@param effect SwordCasual_Effect
            ---@param beforeOverlay number
            ---@param afterOverlay number
            [SwordCasual_Utils.Effects.SwordAddAttack] = function(roleItem, effect, beforeOverlay, afterOverlay)
                local swords = roleItem:GetSwordItems()
                if not swords then
                    return
                end
                local offset = afterOverlay - beforeOverlay
                for _, swordItem in ipairs(swords) do
                    if swordItem:GetLevel() >= 2 then
                        swordItem:SetAttack(math.max(1, swordItem:GetAttack() + offset))
                    end
                end
            end,
        }
        self.__EffectResolves = effectResolves
    end
    local resolve = effectResolves[effect.id]
    if resolve then
        resolve(roleItem, effect, beforeOverlay, afterOverlay)
    end
end

--endregion

--region ===================实例创建/回收/清理===================

---创建主角实例
---@return SwordCasual_RoleItem
function SwordCasualView:CreateMasterItem()
    ---@type jzxx_role_cfg
    local cfg = self.cfg.role_id and self.cfg.role_id > 0 and _G.ConfigManager.jzxx_role_cfg[self.cfg.role_id] or
        _G.ConfigManager.jzxx_role_cfg[101]
    if not cfg then
        if _G.AppSetting.DEBUG then
            _G.LogError("主角配置不存在")
        end
        return nil
    end

    local instance = _G.InstantiateObject(self.go_table.trans_role, self.go_table.obj_mapRoot)
    instance:SetActiveE(1)

    ---@type SwordCasual_MasterItem
    local roleItem = self:AddComponent(instance, SwordCasual_MasterItem.New(instance))
    if self.mapControll then
        self.mapControll:AddRoleItem(roleItem)
    elseif _G.AppSetting.DEBUG then
        _G.LogError("地图控制器尚未初始化")
    end
    --角色随机朝向
    local d = { x = math.random() > 0.5 and 1 or -1, y = 0 }
    roleItem:SetDirection(d, true)
    d.x = 0
    roleItem:SetDirection(d, true)

    --设置基础属性
    roleItem:SetTeam(1) --阵营id
    roleItem:SetData(cfg)
    roleItem:OnEffectChange(_G.handler(self, self.OnEffectChange))
    roleItem:OnShoot(_G.handler(self, self.OnMasterShoot))

    --角色近战武器
    local swordNum = cfg.sword_num
    local douyinModel = require("DouyinModel"):GetInstance()
    if douyinModel:GetIsDouYinArraigned() then--抖小提审领取入口有礼后初始增加4把刀
        if douyinModel:CheckReturnBySideBar() or true then
            swordNum = swordNum + 4
        end
    end
    for _ = 1, swordNum do
        ---@type SwordCasual_SwordItem
        local swordItem = self.swordPool:Get()
        self:OnSwordCreated(roleItem, swordItem)
        roleItem:AddSwordItem(swordItem)
        self:OnSwordHpChange(swordItem, swordItem:GetHp(), swordItem:GetHp())
    end

    return roleItem
end

---创建怪物实例
---@param cx number @中心x坐标
---@param cy number @中心y坐标
---@param cfg jzxx_role_cfg @怪物配置
---@return SwordCasual_MonsterItem
function SwordCasualView:CreateMonsterItem(cx, cy, cfg)
    ---@type SwordCasual_MonsterItem|SwordCasual_MonsterShooterItem
    local monsterItem
    if cfg.role_type == 1 then
        --远程怪
        monsterItem = self.monsterShooterPool:Get()
        --注册射击事件
        local onShoot = self[self.OnShoot]
        if not onShoot then
            onShoot = _G.handler(self, self.OnShoot)
            self[self.OnShoot] = onShoot
        end
        monsterItem:OnShoot(onShoot)
    else
        --近战怪
        monsterItem = self.monsterPool:Get()
    end
    --设置基础属性
    monsterItem:SetTraceTarget(self.masterItem) --追踪目标
    monsterItem:SetTeam(2)                      --阵营id
    monsterItem:SetData(cfg)

    --以当前角色为中心点作圆, 在边上随机一点处生成
    local radAngle = math.rad(math.random(-180, 180))
    local radius = 1000
    monsterItem:SetPosition(cx + radius * _G.math.sin(radAngle), cy + radius * _G.math.cos(radAngle))

    --角色近战武器
    for _ = 1, cfg.sword_num do
        ---@type SwordCasual_SwordItem
        local swordItem = self.swordPool:Get()
        self:OnSwordCreated(monsterItem, swordItem)
        monsterItem:AddSwordItem(swordItem)
    end

    return monsterItem
end

---回收怪物实例
---@param roleItem SwordCasual_MonsterItem @角色实例
function SwordCasualView:ReleaseMonsterItem(roleItem)
    if roleItem.__cname == SwordCasual_MonsterItem.__cname then
        self.monsterPool:Release(roleItem)
    elseif roleItem.__cname == SwordCasual_MonsterShooterItem.__cname then
        self.monsterShooterPool:Release(roleItem)
    else
        _G.DestroyObject(roleItem.gameObject)
        if _G.AppSetting.DEBUG then
            _G.LogError("未知的实例类型: " .. tostring(roleItem.__cname))
        end
    end
end

---回收角色实例的所有武器/子弹实例
---@param roleItem SwordCasual_RoleItem @角色实例
function SwordCasualView:ClearSwordOrBullet(roleItem)
    local swords = roleItem:GetSwordItems()
    if swords then
        for i = #swords, 1, -1 do
            self.swordPool:Release(swords[i])
        end
        roleItem:ClearSwordItems()
    end

    local bullets = roleItem:GetBulletItems()
    if bullets then
        for i = #bullets, 1, -1 do
            --self.bulletPool:Release(bullets[i])
            bullets[i]:SetParent(nil)
        end
        roleItem:ClearBulletItems()
    end
end

---为角色添加x把近战武器
---@param roleItem SwordCasual_RoleItem @角色实例
---@param addSwordCount number @增加刀的数量
function SwordCasualView:AddSwords(roleItem, addSwordCount)
    local swards = roleItem:GetSwordItems()
    local swordCount = swards and #swards or 0

    --直接创建的刀剑实例
    local create = MAX_SWORD_COUNT - swordCount
    if create > 0 then
        if create > addSwordCount then
            create = addSwordCount
        end
        addSwordCount = addSwordCount - create
        for _ = 1, create do
            ---@type SwordCasual_SwordItem
            local swordItem = self.swordPool:Get()
            self:OnSwordCreated(roleItem, swordItem)
            roleItem:AddSwordItem(swordItem)
            self:OnSwordHpChange(swordItem, swordItem:GetHp(), swordItem:GetHp())
        end
    end
    --往剩下的刀剑上添加生命值(随机)
    if addSwordCount > 0 then
        ---@type SwordCasual_SwordItem[]
        local swards = { table.unpack(roleItem:GetSwordItems()) }
        for _ = 1, addSwordCount do
            table.sort(
                swards,
                function(a, b)
                    return a:GetHp() < b:GetHp()
                end
            )
            swards[1]:ChangeHp(1)
        end
    end
end

---创建掉落物实例
---@param type number @宝箱类型: 1增加刀刃, 2随机事件
---@param data any @自定义数据
---@param cx number @中心x坐标
---@param cy number @中心y坐标
---@return SwordCasual_BoxItem
function SwordCasualView:CreateBoxItem(type, data, cx, cy)
    ---@type SwordCasual_BoxItem
    local boxItem = self.boxPool:Get()
    boxItem:SetPosition(cx, cy)
    boxItem:SetData(type, data)

    --注册销毁事件
    local onBoxDestroyed = self[self.OnBoxDestroyed]
    if not onBoxDestroyed then
        onBoxDestroyed = _G.handler(self, self.OnBoxDestroyed)
        self[self.OnBoxDestroyed] = onBoxDestroyed
    end
    boxItem:OnDestroyed(onBoxDestroyed)
    return boxItem
end

