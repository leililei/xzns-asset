---按钮点击事件在这里派发
function SwordCasualView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_settings then
        if self:IsFinish() and go == self.go_table.aorbtn_CloseView then
            self:Close()
        else
            --弹窗确认
            self:SetPause(true)
            self:SetPauseRenderer(true)
            _G.PopWindowManager:GetInstance():ShowAllTips(
                1140004,
                nil,
                _G.handler(self, self.Close),
                function()
                    self:SetPause(false)
                    self:SetPauseRenderer(false)
                end
            )
        end
    elseif go == self.go_table.aorbtn_help then
        self:SetPause(true)
        self:SetPauseRenderer(true)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 186, function()
            self:SetPause(false)
            self:SetPauseRenderer(false)
        end)
    end
end

return SwordCasualView
