    ---创建事件触发条目
    ---@param eventType UnityEngine.EventSystems.EventTriggerType @事件类型
    ---@param callback fun(data:UnityEngine.EventSystems.PointerEventData):void @回调函数
    local function createTriggerEntry(eventType, callback)
        local entry = _G.CS.UnityEngine.EventSystems.EventTrigger.Entry()
        entry.eventID = eventType
        entry.callback:AddListener(callback)
        return entry
    end


    local dragRadius = self.go_table.obj_move:GetRectTransformWidthHeight() * 0.5
    local clickPosition

    local eventTriggers = self.go_table.obj_move:GetComponentE(_G.typeof(_G.CS.UnityEngine.EventSystems.EventTrigger))
    eventTriggers.triggers:Add(createTriggerEntry(
        _G.CS.UnityEngine.EventSystems.EventTriggerType.PointerDown,
        function(data)
            clickPosition = data.position
            self.isMoveJoystick = true
        end)
    )
    eventTriggers.triggers:Add(createTriggerEntry(
        _G.CS.UnityEngine.EventSystems.EventTriggerType.Drag,
        function(data)
            if not clickPosition then
                return
            end
            local x, y = self.go_table.obj_movePoint:GetLocalPosition()
            self.direction.x = x
            self.direction.y = y
            --归一化处理
            local len = math.sqrt(self.direction.x ^ 2 + self.direction.y ^ 2)
            if len > 0.0001 then
                self.direction.x = self.direction.x / len
                self.direction.y = self.direction.y / len
            else
                self.direction.x = 0
                self.direction.y = 0
            end
            if not self:IsPause() then
                self:UpdateDirection()
            end

            --thumb位置计算
            local offsetX = data.position.x - clickPosition.x
            local offsetY = data.position.y - clickPosition.y
            local offsetDistance = math.sqrt(offsetX ^ 2 + offsetY ^ 2)
            if offsetDistance > dragRadius then
                offsetX = offsetX / offsetDistance * dragRadius
                offsetY = offsetY / offsetDistance * dragRadius
            end
            self.go_table.obj_moveThumb:SetLocalPosition(
                offsetX - x,
                offsetY - y,
                0
            )
        end)
    )
    eventTriggers.triggers:Add(createTriggerEntry(
        _G.CS.UnityEngine.EventSystems.EventTriggerType.PointerUp,
        function(data)
            self.direction.x = 0
            self.direction.y = 0
            if not self:IsPause() then
                self:UpdateDirection()
            end

            self.go_table.obj_movePoint:SetLocalPositionToZero()
            self.go_table.obj_moveThumb:SetLocalPositionToZero()
            clickPosition = nil
            self.isMoveJoystick = true
        end)
    )
end

---初始化对象池
function SwordCasualView:InitPools()
    self.boxPool =
        ObjectFactory.New(
            function()
                --create
                local instance = _G.InstantiateObject(self.go_table.trans_box, self.go_table.obj_mapRoot)
                instance:SetActiveE(1)

                ---@type SwordCasual_BoxItem
                local boxItem = self:AddComponent(instance, SwordCasual_BoxItem.New(instance))
                if self.mapControll then
                    self.mapControll:AddBoxItem(boxItem)
                elseif _G.AppSetting.DEBUG then
                    _G.LogError("地图控制器尚未初始化")
                end
                return boxItem
            end,
            ---@param item SwordCasual_BoxItem
            function(item)
                --active
                item.gameObject:SetActiveE(1)
            end,
            ---@param item SwordCasual_BoxItem
            function(item)
                --release
                item:HideAllEff()
                item.gameObject:SetActiveE(0)
                item:StopAnimationFlash()
            end
        )
    self.swordPool =
        ObjectFactory.New(
            function()
                --create
                local instance = _G.InstantiateObject(self.go_table.trans_sword, self.go_table.obj_mapRoot)
