---界面的入口函数
---@param stageIndex number @关卡序号
---@param cfg jzxx_stage_cfg
---@param callback fun(win:boolean,num:number,time:number,score:number):void     @是否胜利/击杀数量/总耗时时间
---@param showScore boolean @是否显示得分
---@param isPayment boolean @是否显示支付模块
function SwordCasualView:OnCreate(stageIndex, cfg, callback, showScore, isPayment)
    self.stageIndex = stageIndex
    self.cfg = cfg
    self.callback = callback
    self.time = 0
    self.kill = 0
    self.boxUpdateInterval = 0
    self.boxCollectInterval = 0

    --初始化怪物波次
    self.createFinish = false
    self.createCfg = {}
    for _, v in ipairs(self.cfg.monster_config) do
        local startTime, endTime, interval, count, monsterId = v[1], v[2], v[3], v[4], v[5]
        table.insert(
            self.createCfg,
            {
                time = 0,
                startTime = startTime,
                endTime = endTime,
                interval = interval,
                count = count,
                monsterIds = { monsterId }
            }
        )
    end

    --初始事件
    self.effectCfgs = {}
    if self.cfg.event_config and #self.cfg.event_config > 0 then
        for _, eventId in ipairs(self.cfg.event_config[1]) do
            local cfg = _G.ConfigManager.jzxx_event_cfg[eventId]
            if cfg then
                table.insert(self.effectCfgs, cfg)
            end
        end
    end

    self:InitView()
    --初始化摇杆
    self:InitJoystick()
    --初始化对象池
    self:InitPools()

    local jssc = _G.ConfigManager.jzxx_stage_show_cfg[1000 + self.cfg.type]
    if jssc then
        local mrgotable = _G.GetAutoGoTable(self.go_table.obj_mapRoot)
        mrgotable.obj_rendererBlock:GetComponentE(_G.typeof(_G.CS.AorRawImage)):LoadImage(jssc.bg, function()
                --初始化组件
            self.mapControll =
            self:AddComponent(self.go_table.obj_mapRoot, SwordCasual_MapControll.New(self.go_table.obj_mapRoot))

            self:DoStartGame(showScore, isPayment)
        end)
    else
        --初始化组件
        self.mapControll =
        self:AddComponent(self.go_table.obj_mapRoot, SwordCasual_MapControll.New(self.go_table.obj_mapRoot))
        self:DoStartGame(showScore, isPayment)
    end
end

    ---主循环事件
function SwordCasualView:DoStartGame(showScore, isPayment)

    self.masterItem = self:CreateMasterItem()
    self.monsterItems = {}
    self.monsterUpdateSiblingInterval = 0
    self.bulletItems = {}
    self.boxItems = {}

    --初始化主循环
    self.mainLoop = _G.TimerManager:GetInstance():GetTimer(1, self.Update, self, false, true)
    self.mainLoop:Start()

    self:UpdateTime()

    --积分信息
    self.score = showScore and 0 or -1
    self.go_table.obj_score:SetActiveE(showScore and 1 or 0)
    if showScore then
        self:UdpateScore()
    end

    self.go_table.obj_tip:SetActiveE(0)

    --(提审)支付模块
    self.isPayment = isPayment
    if isPayment then
        require("ArraignedMallModel"):GetInstance():LoadPointItem(
            self.go_table.obj_goldInfo,
            function(item)
                self.pointItem = item
            end,
            function()
                --打开商城页面
                self:SetPause(true)
                self:SetPauseRenderer(true)
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.ArraignedMallView.Name,
                    function()
                        self:SetPause(false)
                        self:SetPauseRenderer(false)
                    end)
            end
        )
    end
end

---主循环事件
function SwordCasualView:Update()
    if self:IsPause() then
        return
    end

    local dt = _G.Time.deltaTime

    --时间计数
    self.time = self.time + dt
    self:UpdateTime()

    --主角移动
    if self.direction.x ~= 0 or self.direction.y ~= 0 then
        local delta = self.masterItem:GetSpeed() * dt
        self.mapControll:UpdatePosition(delta)
        --self.roleItem:UpdatePosition(delta)
    end
    --物理逻辑更新
    self.masterItem:Update(dt)
    for i = #self.monsterItems, 1, -1 do
        self.monsterItems[i]:Update(dt)
    end
    for i = #self.bulletItems, 1, -1 do
        self.bulletItems[i]:Update(dt)
    end
    --计算掉落物过期
    self.boxUpdateInterval = self.boxUpdateInterval + dt
    if self.boxUpdateInterval >= 0.1 then
        local _dt = self.boxUpdateInterval
        self.boxUpdateInterval = 0
        for i = #self.boxItems, 1, -1 do
            self.boxItems[i]:Update(_dt)
            --进入选事件界面
            if self:IsPause() then
                return
            end
        end
    end

    --更新怪物层级(定时)
    -- self.monsterUpdateSiblingInterval = self.monsterUpdateSiblingInterval - dt
    -- if self.monsterUpdateSiblingInterval <= 0 then
    --     self.monsterUpdateSiblingInterval = 0.1
    --     self:UpdateMonsterSibling()
    -- end
    self:UpdateMonsterSibling()

    --计算角色/武器碰撞
    for i = #self.monsterItems, 1, -1 do
        self:UpdateRoleOverlap(self.masterItem, self.monsterItems[i])

        --如果怪物死亡, 播放死亡动画
        if self.monsterItems[i]:IsDeath() then
            local monsterItem = self.monsterItems[i]
            table.remove(self.monsterItems, i)
            self:OnMonsterDeath(monsterItem)
        end

        --如果玩家死亡, 则结束游戏
        if self.masterItem:IsDeath() then
            self:OnMasterDeath()
            return
        end
    end

    --计算子弹碰撞
    self:UpdateBulletOverlap(self.masterItem, self.bulletItems)
    if self.masterItem:IsDeath() then
        self:OnMasterDeath()
        return
    end
    local masterBullets = self.masterItem:GetBulletItems()
    if masterBullets and #masterBullets > 0 then --主角发出的子弹
        for i = #self.monsterItems, 1, -1 do
            self:UpdateBulletOverlap(self.monsterItems[i], masterBullets)
            --如果怪物死亡, 播放死亡动画
            if self.monsterItems[i]:IsDeath() then
                local monsterItem = self.monsterItems[i]
                table.remove(self.monsterItems, i)
                self:OnMonsterDeath(monsterItem)
            end
        end
    end

    --计算物品拾取
    self.boxCollectInterval = self.boxCollectInterval + dt
    if self.boxCollectInterval >= 0.1 then
        self.boxCollectInterval = 0
        for i = #self.boxItems, 1, -1 do
            if SwordCasual_Utils.Physics:rectOverlapOBB(self.masterItem:GetRect(), self.boxItems[i]:GetRect()) then
                self:OnBoxCollect(self.masterItem, self.boxItems[i])
                self.boxPool:Release(self.boxItems[i])
                table.remove(self.boxItems, i)
            end
        end
    end

    --生成怪物实例
    self.createFinish = true
    for _, v in pairs(self.createCfg) do
        if self.time >= v.startTime and self.time <= v.endTime then
            v.time = v.time - dt
            if v.time <= 0 then
                v.time = v.interval
                local mx, my = self.masterItem:GetPosition()
                for _ = 1, v.count do
                    local monsterId = v.monsterIds[math.random(1, #v.monsterIds)]
                    local cfg = _G.ConfigManager.jzxx_role_cfg[monsterId]
                    local monsterItem = self:CreateMonsterItem(mx, my, cfg)
                    table.insert(self.monsterItems, monsterItem)
                end
            end
        end
        if self.time <= v.endTime then
            self.createFinish = false
        end
    end

    --通关WASD或方向键, 控制玩家行进
    if _G.AppSetting.IS_EDITOR and not self.isMoveJoystick then
        local horizontal = _G.CS.UnityEngine.Input.GetAxis("Horizontal")
        local vertical = _G.CS.UnityEngine.Input.GetAxis("Vertical")

        --归一化处理
        local len = math.sqrt(horizontal ^ 2 + vertical ^ 2)
        if len > 0.0001 then
            self.direction.x = horizontal / len
            self.direction.y = vertical / len
        else
            self.direction.x = 0
            self.direction.y = 0
        end

        if not self:IsPause() then
            self:UpdateDirection()
        end
    end
end

