---@class MainViewGiftAdventureView : UIBaseView	中文描述
---@field public go_table MainViewGiftAdventureView_GoTable GoTable
local MainViewGiftAdventureView = _G.BaseClass("MainViewGiftAdventureView", _G.UIBaseView)

function MainViewGiftAdventureView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MainViewGiftAdventureView:OnCreate(callback)
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_MainViewGiftAdventureView_open, self.go_table.obj_effect)
    _G.Events:GetInstance():AddListener(_G.AnimationEvents.OpenAnimEnd, self.FinishAnim, self)
    self.callback = callback
end

---界面的销毁函数
function MainViewGiftAdventureView:OnDestroy()
    self.callback = nil
end

---按钮点击事件在这里派发
function MainViewGiftAdventureView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        _G.Events:GetInstance():RemoveListener(_G.AnimationEvents.OpenAnimEnd, self.FinishAnim, self)
        if self.callback then
            self.callback()
        end
        self:Close()
    end
end

function MainViewGiftAdventureView:FinishAnim()
    _G.Events:GetInstance():RemoveListener(_G.AnimationEvents.OpenAnimEnd, self.FinishAnim, self)
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_MainViewGiftAdventureView_loop, self.go_table.obj_effect)
end

return MainViewGiftAdventureView