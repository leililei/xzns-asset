local base = require("BaseGameNet")

---@class AllHeroesBattleNet : BaseGameNet	通信协议
local AllHeroesBattleNet = _G.BaseClass("AllHeroedBattleNet", base)
---@return AllHeroesBattleNet AllHeroedBattleNet
function AllHeroesBattleNet:GetInstance()
    return base.GetInstance(self)
end

---请求
---@param pbData table PB数据
---@param callback function 完成回调
function AllHeroesBattleNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function AllHeroesBattleNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---初始化数据
---@param callback function 完成回调
function AllHeroesBattleNet:Init(callback)
    self:Access(_G.ConfigManager.net_map.game_pvp_info, self:GetEmptyPB(), callback)
end
---获取房间敌人基础信息
---@param id number 房间ID
---@param callback function 完成回调
function AllHeroesBattleNet:GetEnemy(id, callback)
    self:Access(_G.ConfigManager.net_map.game_pvp_room_info, {room = id}, callback)
end
---获取敌人布阵信息
---@param uid number 玩家UID
---@param callback function 完成回调
function AllHeroesBattleNet:GetEnemyEmbattleData(uid, callback)
    self:Access(_G.ConfigManager.net_map.game_pvp_array, {uid = uid}, callback)
end
---挑战敌人
---@param id number 位置ID
---@param uid number 玩家UID
---@param callback function 完成回调
function AllHeroesBattleNet:Challenge(id, uid, callback)
    return self:Access(_G.ConfigManager.net_map.game_pvp_fight, {sid = id, role_uid = uid}, callback)
end
---领取挂机奖励
---@param callback function 完成回调
function AllHeroesBattleNet:GetAward(callback)
    self:Access(_G.ConfigManager.net_map.game_pvp_award, self:GetEmptyPB(), callback)
end
---获取战斗信息
---@param callback function 完成回调
function AllHeroesBattleNet:GetBattleInfo(callback)
    self:Access(_G.ConfigManager.net_map.game_pvp_fight_info, self:GetEmptyPB(), callback)
end
---获取战报信息
---@param callback function 完成回调
function AllHeroesBattleNet:GetBattleReport(callback)
    self:Access(_G.ConfigManager.net_map.game_pvp_report, self:GetEmptyPB(), callback)
end
---战报回放
function AllHeroesBattleNet:ReportPlayBack(uid, callback)
    self:Access(_G.ConfigManager.net_map.game_pvp_report_playback, {play_back_uid = uid}, callback)
end

---任务领奖
function AllHeroesBattleNet:GetTaskAward(pbData, callback)
    self:Access(_G.ConfigManager.net_map.game_pvp_room_award, pbData, callback)
end
return AllHeroesBattleNet
