---@class AllHeroesBattleReportView : UIBaseView	中文描述
---@field public go_table AllHeroesBattleReportView_GoTable GoTable
local AllHeroesBattleReportView = _G.BaseClass("AllHeroesBattleReportView", _G.UIBaseView)

function AllHeroesBattleReportView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function AllHeroesBattleReportView:OnCreate()
    local instance = require("AllHeroesBattleManager"):GetInstance()
    instance:GetReport(_G.handler(self, self.OnReportCall))
end

---界面的销毁函数
function AllHeroesBattleReportView:OnDestroy()
    self.reportList = nil
    self.itemDic = nil
end

---按钮点击事件在这里派发
function AllHeroesBattleReportView:OnClickBtn(go)
    self:Close()
end

function AllHeroesBattleReportView:OnReportCall(success, data)
    if not success then
        self.go_table.obj_emptybg:SetActiveE(1)
        self.go_table.scrollloopvectical_report:SetActiveE(0)
        return
    end
    self.reportList = data
    if _G.table.isEmptyOrNil(data) then
        self.go_table.obj_emptybg:SetActiveE(1)
        self.go_table.scrollloopvectical_report:SetActiveE(0)
    else
        self.go_table.obj_emptybg:SetActiveE(0)
        self.go_table.scrollloopvectical_report:SetActiveE(1)
        self.itemDic = {}
        self.go_table.scrollloopvectical_report:InitItemData(#data, _G.handler(self, self.OnReportItemCall))
    end
    require("AllHeroesBattleManager"):GetInstance():SetNewReportNil()
end

function AllHeroesBattleReportView:OnReportItemCall(index, obj)
    if index < 0 then
        return
    end
    local id = obj:GetInstanceIDE()
    local item = self.itemDic[id]
    if not item then
        item = AllHeroesBattleReportItem.New(obj)
        self.itemDic[id] = item
    end
    index = index + 1
    item:Show(self.reportList[index])
end

return AllHeroesBattleReportView
