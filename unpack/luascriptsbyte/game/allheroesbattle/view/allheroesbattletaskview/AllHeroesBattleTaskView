local AllHeroesBattleManager = require("AllHeroesBattleManager")

--region 奖励item
local AllHeroesBattleTaskItem = _G.BaseClass("AllHeroesBattleTaskItem")
function AllHeroesBattleTaskItem:__init(obj)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.itemList = {}
end

function AllHeroesBattleTaskItem:Dispose()
    self.go_table = nil
    self.gameObject = nil
    local ItemFactoryIns = _G.ItemFactory:GetInstance()
    for i = 1, #self.itemList do
        ItemFactoryIns:SetItemCard(self.itemList[i])
    end
    self.itemList = nil
end

---显示
function AllHeroesBattleTaskItem:Show(data, loopItemIndex, index, AllTask, View)
    self.data = data
    self.View = View
    self.taskList = AllTask
    self.loopItemIndex = loopItemIndex
    self.gameObject:SetActiveE(1)
    self.go_table.aortext_des.text = _G.LangUtil.GetLangPackValue(data.des)
    local award = data.reward
    self:ShowAward(award, index)
    self:SetBtnState()
end

---显示奖励
function AllHeroesBattleTaskItem:ShowAward(award, index)
    local ItemFactory = _G.ItemFactory
    for i = 1, #self.itemList do
        ItemFactory:GetInstance():SetItemCard(self.itemList[i])
    end
    self.itemList = {}
    local insert = _G.table.insert
    for i = 1, #award do
        ItemFactory:GetInstance():GetItemCard(
            ItemFactory.itemType.ItemBaseWithCount,
            self.go_table.trans_mItemRoot,
            function(item)
                if self.go_table == nil or self.loopItemIndex ~= index then
                    _G.DestroyObject(item.gameObject)
                    return
                end
                item:Show(award[i][1], nil, award[i][2])
                insert(self.itemList, item)
            end
        )
    end
end

---设置按钮状态
function AllHeroesBattleTaskItem:SetBtnState()
    local state = AllHeroesBattleManager:GetInstance():GetTaskStateByStarAndType(self.data.sid, self.data.type)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_XianShi, state == 2)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_get, state == 1)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_go, state == 0)
end

function AllHeroesBattleTaskItem:OnClickBtn(go)
    if go == self.go_table.aorbtn_get then
        local list = {}
        for _, v in pairs(self.taskList) do
            _G.table.insert(list, {room_star = v.sid, room_type = v.type})
        end

        AllHeroesBattleManager:GetInstance():GetTaskAward(list, function()
            if self.View and self.go_table then
                self.View:UpDateScroll()
            end
        end)
    elseif go == self.go_table.aorbtn_go then
        AllHeroesBattleManager:GetInstance():OpenBattleView()
    end
end

--endregion

---@class AllHeroesBattleTaskView : UIBaseView	群英会武任务界面
---@field public go_table AllHeroesBattleTaskView_GoTable GoTable
local AllHeroesBattleTaskView = _G.BaseClass("AllHeroesBattleTaskView", _G.UIBaseView)

function AllHeroesBattleTaskView:Awake()
    self.itemTransDic = {}
    self.loopItemIndex = {}
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function AllHeroesBattleTaskView:OnCreate()
    self:ScrollCreat()
end

function AllHeroesBattleTaskView:ScrollCreat()
    local taskList = AllHeroesBattleManager:GetInstance():GetTaskList()
    self.taskList = taskList

    --检查开启剩余时间(功能开启或赛季开启第n天后开启), 未解锁的任务不显示
    local result = _G.TimeUtil.GetServerUnixTime() - AllHeroesBattleManager:GetInstance():GetRoomFirstTime()
    local open_time = math.ceil(result / 86400)
    for i = #taskList, 1, -1 do
        if open_time < taskList[i].open_condition then
            table.remove(taskList, i)
        end
    end
    --对任务进行排序, 排序规则如下(排序后不再需要跳转到指定位置)
    --1.领取状态: 可领取>前往>已完成(已领取)
    --2.sid升序
    _G.SortList(
        taskList,
        function(d)
            local state = AllHeroesBattleManager:GetInstance():GetTaskStateByStarAndType(d.sid, d.type)
            local stateSort = state == 1 and 2 or state == 0 and 1 or 0
            return stateSort, d.sid, d.type
        end
    )

    self.go_table.scrollloopvectical_award:InitItemData(#self.taskList, _G.handler(self, self.RefreshItem))

    if self.ScrollView == nil then
        self.go_table.scrollloopvectical_award:InitItemData(#self.taskList, _G.handler(self, self.RefreshItem))
        self.ScrollView = self.go_table.scrollloopvectical_award
    else
        self.ScrollView:UpdateAllItem()
    end
end

function AllHeroesBattleTaskView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    local instanceID = obj:GetInstanceIDE()
    if not self.itemTransDic[instanceID] then
        self.itemTransDic[instanceID] = AllHeroesBattleTaskItem.New(obj)
    end
    index = index + 1
    if index == self.loopItemIndex[instanceID] then
        return
    end
    self.loopItemIndex[instanceID] = index

    local canGetList = {}
    for i = 1, #self.taskList do
        local state = AllHeroesBattleManager:GetInstance():GetTaskStateByStarAndType(self.taskList[i].sid,
            self.taskList[i].type)
        if state == 1 then
            table.insert(canGetList, self.taskList[i])
        end
    end

    self.itemTransDic[instanceID]:Show(self.taskList[index], self.loopItemIndex[instanceID], index, canGetList, self)
end

function AllHeroesBattleTaskView:UpDateScroll()
    for key, value in pairs(self.itemTransDic) do
        value:SetBtnState()
    end
    self:ScrollCreat()
end

---界面的销毁函数
function AllHeroesBattleTaskView:OnDestroy()
end

---按钮点击事件在这里派发
function AllHeroesBattleTaskView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_bg then
        self:Close()
    end
end

return AllHeroesBattleTaskView
