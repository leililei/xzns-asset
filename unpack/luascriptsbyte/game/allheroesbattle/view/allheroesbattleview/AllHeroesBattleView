---打开外显（赛季首次进入打开奖励界面）
function AllHeroesBattleView:OpenTopAwardView()
    local seasonID = require("SeasonModel"):GetInstance():GetCurSeasonId()
    local key = "AllHeroesTopAwardSeason"
    local isShowAward = _G.ConfigManager.discrete_cfg[isShowRankAwardCfg][1][1] == 1
    if seasonID ~= _G.PlayerPrefsManager.GetInt(key) and isShowAward then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaTopAwardView.Name, 3)
        _G.PlayerPrefsManager.SetInt(key, seasonID)
    end
end

