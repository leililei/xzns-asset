        self.showCall = showCall
    end
    self.dangerousTag = {
        self.go_table.obj_danger3,
        self.go_table.obj_danger4,
        self.go_table.obj_danger5
    }
    self:InitViewChild()
    self.isInit = true
    --self:AddComponent(
    --    self.go_table.trans_res,
    --    require("ResourceCompont").New(self.go_table.trans_res, _G.ConfigManager.ui_cfg.AllHeroesBattleView.resources)
    --)
    --self:AddComponent(
    --    self.go_table.trans_PlayerHead,
    --    require("PlayerComponent").New(self.go_table.trans_PlayerHead)
    --)
    self.go_table.aorbtn_topAward:SetActiveE(_G.ConfigManager.discrete_cfg[isShowRankAwardCfg][1][1])

    --self:InitEffect()
    require("AllHeroesBattleManager"):GetInstance():SetArenaLoginFirstByDay()
    self:OpenTopAwardView()
