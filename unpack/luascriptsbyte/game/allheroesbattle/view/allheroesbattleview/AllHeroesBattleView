---界面的销毁函数
function AllHeroesBattleView:OnDestroy()
    base.OnDestroy(self)
    self.onBtnTag = nil
end

---按钮点击事件在这里派发
function AllHeroesBattleView:OnClickBtnChild(go)
    if self.onBtnTag then
        return
    end
    self.onBtnTag = true
    if go == self.go_table.aorbtn_Close then
        local call = require("AllHeroesBattleManager"):GetInstance():GetMainViewCloseCall()
        if call then
            call()
        end
        TrackingPointModel:GetInstance():CloseActTracking(self.viewName)
        self:Close()
    elseif go == self.go_table.aorbtn_report then
        self:OpenReport()
    elseif go == self.go_table.aorbtn_embattle then
        require("AllHeroesBattleManager"):GetInstance():OpenDefenceEmbattle()
    elseif go == self.go_table.aorbtn_shop then
        local isUnlock, unlocktype = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(25)
        if isUnlock then
            require "ShopModel":GetInstance():OpenShop(_G.ShopID.PvpAllHeros)
        else
            if unlocktype then
                local cfg = _G.ConfigManager.afk_cfg[unlocktype[1][2]]
                _G.PopWindowManager:GetInstance():ShowAllTips(
                    110119,
                    GetLangPackValue(91300009910, cfg.chapter, cfg.section)
                )
            end
        end
        self.onBtnTag = false
    elseif go == self.go_table.aorbtn_topAward then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaTopAwardView.Name, 3)
        self.onBtnTag = false
    elseif go == self.go_table.aorbtn_task then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.AllHeroesBattleTaskView.Name)
        self.onBtnTag = false
    end
end
function AllHeroesBattleView:InitEffect()
    local LoadEffectByCfg = _G.UIUtils.LoadEffectByCfg
    local RemoveEffect = _G.UIUtils.RemoveEffect
    local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
    local call = function(trans)
        if _G.IsNil(self.go_table) then
            RemoveEffect(trans)
        end
    end
    LoadEffectByCfg(
        ui_effect_cfg.ef_AllHeroesBattleView_mid_cur,
        self.go_table.trans_cur:GetChildE(0),
        function(obj)
            obj:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
            call()
        end
    )
    LoadEffectByCfg(ui_effect_cfg.ef_AllHeroesBattleView_mid_once, self.go_table.trans_effRoot, call)
    LoadEffectByCfg(ui_effect_cfg.ef_AllHeroesBattleView_mid_loop, self.go_table.trans_effRoot, call)
end
function AllHeroesBattleView:RefreshView()
    base.RefreshView(self)
    self:InitViewChild()
end

function AllHeroesBattleView:InitViewChild()
    self.roomFirstTime = require("AllHeroesBattleManager"):GetInstance():GetRoomFirstTime()
    local AllHeroesBattleManagerIns = require("AllHeroesBattleManager"):GetInstance()
    self.curRoomID = AllHeroesBattleManagerIns:GetCurRoomID()
    self.rooms = _G.DeepCopy(AllHeroesBattleManagerIns.rooms)
    if not self.isInit then
        local layer = _G.math.ceil(_G.table.count(self.rooms) / 2)
        self.go_table.scrollloopvectical_listView:InitItemData(
            layer,
            _G.handler(self, self.InitRoomItem)
        )
    else
        self.go_table.scrollloopvectical_listView:UpdateAllItem()
    end
    self.go_table.trans_canChanllenge:SetActiveE(_G.table.count(self.rooms) <= self.curRoomID and 0 or 1)
    AllHeroesBattleManagerIns:GetBattleInfo(_G.handler(self, self.InitFightInfo))
    if self.curRoomID > 2 then
        self.go_table.scrollloopvectical_listView:ScrollToIndex(((self.curRoomID - 1) // 2))
    end
     for i = 1, #self.dangerousTag do
         self.dangerousTag[i]:SetActiveE(self.curRoomID < i and 1 or 0)
     end
end

function AllHeroesBattleView:InitRoomItem(index, obj)
    local newIndex = index * 2
    local tb = _G.GetAutoGoTable(obj)
    for i = 1, 2 do
        if self.rooms[newIndex + i] then
            tb["aorbtn_room" .. i]:SetActiveE(1)
            self:InitListItem(newIndex + i, tb["aorbtn_room" .. i])
        else
            tb["aorbtn_room" .. i]:SetActiveE(0)
        end
    end
end

function AllHeroesBattleView:InitListItem(index, obj)
    ---@type AllHeroesBattleView._aorbtn_room1_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickRoom, index))
    local data = self.rooms[index]
    if not data then
        return
    end
    tb.aorrawimage_bg:LoadImage(data.image)
    tb.aortext_name.text = _G.GetLangPackValue(data.name)
    if data.id == self.curRoomID then
        self.go_table.trans_cur:SetParentE(tb.obj_cur)
        self.go_table.trans_cur:SetLocalPositionToZero()
        tb.obj_cur:SetActiveE(1)
    else
        tb.obj_cur:SetActiveE(0)
    end
    if data.id == 1 then
        tb.obj_Star:SetActiveE(0)
        tb.obj_Text:SetActiveE(0)
        tb.obj_placeHolder_1:SetActiveE(1)
        tb.obj_placeHolder_2:SetActiveE(1)
        tb.aortext_award:SetActiveE(1)
        tb.aorrawimage_icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(18))
        tb.aortext_award.text = "+" .. _G.ConfigManager.activity_pvp_cfg[101].efficiency .. _G.GetLangPackValue(90021800504)
    else
        tb.obj_Star:SetActiveE(0)
        tb.obj_Text:SetActiveE(1)
        if tb.aortext_award then
            tb.aortext_award:SetActiveE(0)
        end
        for i = 1, 8 do
            tb["obj_fire" .. i]:SetActiveE(data.id - 1 >= i and 1 or 0)
        end
        _G.DelayFrameDo(function()
            tb.obj_Star:SetActiveE(1)
        end)
    end
    
    --检查开启剩余时间(功能开启或赛季开启第n天后开启) 
    local result = _G.TimeUtil.GetServerUnixTime() - self.roomFirstTime
    local leftTime = ((data.open_condition - 1)*86400) - result
    tb.obj_lock:SetActiveE(leftTime > 0 and 1 or 0)
    if leftTime > 0 then
        tb.aortext_lock.text = self:GetTimeStr(leftTime)
    end
    tb.obj_eff:RemoveAllChildren()
    if data.id - self.curRoomID == 1 then
        self.go_table.trans_canChanllenge:SetParentE(tb.obj_can)
        self.go_table.trans_canChanllenge:SetLocalPositionToZero()
        tb.obj_can:SetActiveE(leftTime > 0 and 0 or 1)
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_hundunrukou,
            tb.obj_eff,
            function (obj)
                if self:IsNil() then
                    _G.UIUtils.RemoveEffect(obj)
                    return
                end
            end
        )
    else
        tb.obj_can:SetActiveE(0)
    end
end

--获取剩余时间描述
function AllHeroesBattleView:GetTimeStr(time)
    local timeStr
    local t = _G.TimeUtil.TranslateSecond(time)
    if t.day > 0 then
        timeStr = _G.GetLangPackValue(90000011347,_G.GetLangPackValue(90022100001, t.day, t.hour))
    elseif t.hour > 0 then
        timeStr = _G.GetLangPackValue(90000011347,_G.GetLangPackValue(90022100002, t.hour, t.min))
    elseif t.min > 0 then
        timeStr = _G.GetLangPackValue(90000011346,_G.GetLangPackValue(90000010394, t.min))
    else
        timeStr = _G.GetLangPackValue(90000011346,_G.GetLangPackValue(90000010394, 1))
    end
    return timeStr
end

function AllHeroesBattleView:OnClickRoom(_, _, index)
    if index > 1 then
        self:OpenRoom(index)
    elseif index == 1 then
        _G.PopWindowManager:GetInstance():ShowAllTips(800501)
    end
end

function AllHeroesBattleView:InitFightInfo(success, data)
    if success then
        self.infoList = data
        self.dataCount = #data
        for i = 1, self.dataCount do
            if data[i].type ~= 1 then --机器人
                data[i].name_defense = GetLangPackValue(data[i].name_defense)
            end
        end
        if self.isInit then
            self.itemDic = {}
            self.go_table.scrollloopvectical_battle:InitItemData(1, _G.handler(self, self.OnInfoItemCall))
            self.isInit = nil
            local AllHeroesBattleManagerIns = require("AllHeroesBattleManager"):GetInstance()
            AllHeroesBattleManagerIns:RegiestPosChangeCall(_G.handler(self, self.RefreshView))
        else
            self.go_table.scrollloopvectical_battle:UpdateCount(1)
        end
    end
    self.onBtnTag = false
end
function AllHeroesBattleView:OnInfoItemCall(index, obj)
    if index < 0 then
        return
    end
    local id = obj:GetInstanceIDE()
    local item = self.itemDic[id]
    if not item then
        item = AllHeroesBattleInfoItem.New(obj)
        self.itemDic[id] = item
    end
    item:Show(self.infoList[self.dataCount])
end
--region 按钮点击事件
---进入房间
---@param id number 房间ID(序列号)
function AllHeroesBattleView:OpenRoom(id)
    if id == 1 then
        _G.PopWindowManager:GetInstance():ShowAllTips(800501)
        return
    end
    local data = self.rooms[id]
    local result = _G.TimeUtil.GetServerUnixTime() - self.roomFirstTime
    local leftTime = ((data.open_condition - 1)*86400) - result
    if leftTime > 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(630112, nil, nil, nil, nil, nil, self:GetTimeStr(leftTime))
        return
    end
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnRoomViewOpened, self)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.AllHeroesBattleRoomView.Name, data.id)
end
function AllHeroesBattleView:OnRoomViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.AllHeroesBattleRoomView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnRoomViewOpened, self)
        self.onBtnTag = false
        self:Close()
    end
end
function AllHeroesBattleView:OnReportViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.AllHeroesBattleReportView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnReportViewOpened, self)
        self.onBtnTag = false
    end
end
---打开战报
function AllHeroesBattleView:OpenReport()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnReportViewOpened, self)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.AllHeroesBattleReportView.Name)
end
