local TrackingPointModel = require("TrackingPointModel")
local GetLangPackValue = _G.GetLangPackValue
local format = _G.string.format
--region 战斗信息item
local normalPosWords
local specailPosWords
local formatWords
---@see discrete_cfg
local isShowRankAwardCfg = 105730
local AllHeroesBattleInfoItem = _G.BaseClass("AllHeroesBattleInfoItem")
function AllHeroesBattleInfoItem:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj)
end
--[[
  required string name_attack=1;//进攻玩家名字
  required string name_defense=2;//防守玩家名字
  required uint32 type = 3;//防守玩家类型 1，玩家，2，机器人
  required uint32 sid=4;//点位sid
]]
function AllHeroesBattleInfoItem:Show(data)
    if not normalPosWords then
        normalPosWords = GetLangPackValue(90000010080)
        specailPosWords = GetLangPackValue(90000010081)
        formatWords = GetLangPackValue(90000010079)
    end
    local cfg = _G.ConfigManager.activity_pvp_cfg[data.sid]
    if not cfg then
        return
    end
    local name = _G.ConfigManager.activity_pvp_room_cfg[cfg.room].name
    if cfg.type_pos == 0 then
        self.go_table.aortext_report.text =
            format(formatWords, data.name_attack, GetLangPackValue(name), data.name_defense, normalPosWords)
    else
        self.go_table.aortext_report.text =
            format(formatWords, data.name_attack, GetLangPackValue(name), data.name_defense, specailPosWords)
    end
end
--endregion
