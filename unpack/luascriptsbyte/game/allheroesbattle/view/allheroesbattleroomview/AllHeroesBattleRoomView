  required uint32 style = 5;//头像
  required uint32 frame = 6;//头像框
  required uint32 power = 7;//阵容总战斗力
]]
function AllHeroesBattleRoomPlayerItem:Show(data)
    self.data = data
    local isSelf = _G.PlayerModel:GetInstance():GetPlayerUid() == data.role_uid
    local isSettlement = require("SeasonModel"):GetInstance():IsSettlementTime()

    if self.data.type == 1 then
        if isSelf then
            self.go_table.aortext_name.text=_G.string.AddColor(data.name,"5bdf99")
        else
            self.go_table.aortext_name.text=_G.string.AddColor(data.name,"ff5555")
        end
    else
        self.go_table.aortext_name.text = data.name
    end
    local power = data.power--isSelf and _G.PlayerModel:GetInstance():GetPower() or data.power
    self.go_table.aorrawimage_icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(18))
    self.go_table.aorbtn_challenge:SetActiveE(isSelf and 0 or 1)
    self.go_table.aorbtn_challenge:SetGray(isSettlement)
    self.go_table.aortext_power.text =
        string.format(_G.GameUtil.NumberToUnitStrBag(power))
    self.go_table.aortext_earn.text = "+" .. data.earn .. _G.GetLangPackValue(90021800504)

    UIUtils.SetPlayerHeadItemNew(self.go_table.obj_HeadItemBase, data, 0.8, true, false, false)
    self.gameObject:SetActiveE(1)
end

