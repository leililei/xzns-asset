        _G.handler(self, self.OnRoomDataCall)
    )
end

--region 初始化3D
function AllHeroesBattleRoomView:InitScene()
    if not self.sceneTrans then
        if self.isLoadScene then
            return
        end
        self.isLoadScene = true
        _G.PoolsManager:GetInstance():Spawn(
            "Scenes/sp_qunyinghuiwu/Export/prf_sp_qunyinghuiwu",
            _G.ePoolType.Temporary,
            nil,
            function(trans)
                local environment =
                    trans:GetComponentInChildren(_G.typeof(_G.CS.FrameWork.Environment.EnvironmentSetting))
                if environment then
                    environment.SceneCamera.fieldOfView = 30 * _G.CS.Launcher.Inst.FovScale
                end
                self.sceneTrans = trans
                self.go_table.obj_bg:SetActiveE(0)
                --self:InitEffect()
            end
        )
    elseif self.sceneTrans then
        --self:InitEffect()
    end
end

function AllHeroesBattleRoomView:InitRole(data)
    if self.roleTrans then
        self.roleTrans:ClearChildren()
        self.roleTrans = nil
    end
    local isSelf = _G.PlayerModel:GetInstance():GetPlayerUid() == data.uid
    local isSettlement = require("SeasonModel"):GetInstance():IsSettlementTime()
    self.go_table.aortext_name.text = data.name
    self.go_table.aortext_power.text =data.power --isSelf and _G.PlayerModel:GetInstance():GetPower() or data.power
    self.go_table.aortext_earn.text = "+" .. self.specialEarn .. _G.GetLangPackValue(90021800504)
    self.go_table.aorbtn_challenge:SetActiveE(isSelf and 0 or 1)
    self.go_table.aorbtn_challenge:SetGray(isSettlement)
    local card = require "CardCommentManager":GetInstance():CardData(data.sid, false)
    local isWearSkin, skinId = require "CardCommentManager":GetInstance():CardWearSkin(data.sid)
    local path = isWearSkin and _G.ConfigManager.skin_cfg[skinId].ModelPathHi or card.ModelPathHi
    _G.PoolsManager:GetInstance():Spawn(
        path,
        _G.ePoolType.Temporary,
        nil,
        function(trans)
            self.roleTrans = self.go_table.trans_spine
            trans:SetParentE(self.roleTrans)
            --策划说皮肤不会改到这个数据
            local pos = card.pos_portrait1
            local showCfg = _G.ConfigManager.card_show_cfg[card.id]
            trans:SetLocalPosition(pos[1], pos[2], pos[3])
            self.roleTrans:SetLocalScaleXYZ((showCfg and showCfg.Size1 or 1) * MODELSCALEVALUE)
            -- self:InitTitle(data)
        end
    )
end

function AllHeroesBattleRoomView:InitTitle(data)
    local RolePoint = self.roleTrans:GetComponentE(_G.typeof(_G.CS.RolePoint))
    if _G.IsNil(RolePoint) then
        self.onBtnTag = false
        return
    end
    local parent
    if _G.IsNil(RolePoint.Point_Hp) then
        if _G.IsNil(RolePoint.Point_Head) then
            self.onBtnTag = false
            return
        else
            parent = RolePoint.Point_Head
        end
    else
        parent = RolePoint.Point_Hp
    end
    _G.PoolsManager:GetInstance():Spawn(
        "CommonPrefab/World/Common_TitleWithDesignation",
        _G.ePoolType.Temporary,
        parent,
        function(trans)
            trans:AddComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
            --trans:SetLocalScale(-1, 1, 1)
            trans:SetLocalPositionToZero()
            _G.WorldManager:GetInstance().CurrentWorld.WorldSetting:TranLookAtCamera(trans)
            local go_table = _G.GetAutoGoTable(trans)
            go_table.aortext_TextName.text = data.name
            local title, Type = _G.SystemSettingManager.GetTitleIcon(data.tittle)

            if title then
                if Type ~= 2 then
                    go_table.aorrawimage_Title:LoadImage(
                        title,
                        function()
                            go_table.aorrawimage_Title:SetActiveE(1)
                            go_table.aorrawimage_Title:SetNativeSize()
                            self.onBtnTag = false
                        end
                    )
                else
                    _G.UIUtils.LoadEffectTitleOrFrame(
                        title,
                        go_table.gameObject,
                        function(trnas)
                            trans:SetLayerAndChild(30)
                            local x, y, z = go_table.aorrawimage_Title:GetPosition()
                            trnas:SetPosition(x, y + 0.2, z)
                            trnas:SetLocalScaleXYZ(_G.ConfigManager.discrete_cfg[103902][1][1] * 0.0035)
                            _G.GameUtil.SetActiveByCondition(trans, true)
                        end
                    )
                end
            else
                self.onBtnTag = false
            end
        end
    )
end

