---按钮点击事件在这里派发
function AllHeroesBattleRoomView:OnClickBtnChild(go)
    if self.onBtnTag then
        return
    end
    self.onBtnTag = true
    if go == self.go_table.aorbtn_Close then
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnAllHeroesBattleViewOpened, self)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.AllHeroesBattleView.Name)
    elseif go == self.go_table.aorbtn_challenge then
        if require("SeasonModel"):GetInstance():IsSettlementTime() then
            _G.PopWindowManager:GetInstance():ShowAllTips(620105)
            self.onBtnTag = false
            return
        end
        if self.commander then
            require("AllHeroesBattleManager"):GetInstance():Challenge(self.curRoomID, self.commander)
        end
        self.onBtnTag = nil
    elseif go == self.go_table.aorbtn_right then
        self:ChangePage(1)
    elseif go == self.go_table.aorbtn_left then
        self:ChangePage(-1)
    end
end

function AllHeroesBattleRoomView:InitEffect()
    local LoadEffectByCfg = _G.UIUtils.LoadEffectByCfg
    local RemoveEffect = _G.UIUtils.RemoveEffect
    local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
    local call = function(trans)
        if _G.IsNil(self.go_table) then
            RemoveEffect(trans)
        end
    end
    self.go_table.trans_effRoot:ClearChildren()
    self.go_table.trans_fireRoot:ClearChildren()
    LoadEffectByCfg(ui_effect_cfg.ef_AllHeroesBattleRoomView_mid, self.go_table.trans_effRoot, call)
    local cfg = ui_effect_cfg.ef_AllHeroes_fire_loop
    local index = 0
    local x, y, z
    local fireCall = function(trans)
        if _G.IsNil(self.go_table) then
            RemoveEffect(trans)
            return
        end
        index = index + 1
        x, y, z = self.stars[index]:GetLocalPosition()
        trans:SetLocalPosition(x, y, z)
    end
    for i = 1, #self.stars do
        if self.stars[i]:GetActiveSelf() == 1 then
            LoadEffectByCfg(cfg, self.go_table.trans_fireRoot, fireCall)
        end
    end
end

