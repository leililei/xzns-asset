function AllHeroesBattleRoomView:InitViewChild()
    --for i = 1, #self.stars do
    --    self.stars[i]:SetActiveE(i <= self.curRoomID and 1 or 0)
    --end
    local AllHeroesBattleManagerIns = require("AllHeroesBattleManager"):GetInstance()
    if not self.maxCount then
        self.maxCount = _G.table.count(require("AllHeroesBattleManager"):GetInstance().rooms)
    end
    local data = require("AllHeroesBattleManager"):GetInstance():GetRoomBaseData(self.curRoomID)
    self.normalEarn = data.normal
    self.specialEarn = data.specail
    --self.go_table.aortext_posInfo1.text = string.format(_G.GetLangPackValue(90000010083), 12, 12 * data.normal)
    --self.go_table.aortext_posInfo2.text = string.format(_G.GetLangPackValue(90000010084), 12, 12 * data.specail)
    self.go_table.aorbtn_right:SetActiveE(self.curRoomID < self.maxCount and 1 or 0)
    self.go_table.aorbtn_left:SetActiveE(self.curRoomID > 2 and 1 or 0)
    AllHeroesBattleManagerIns:GetRoomPlayerData(self.curRoomID, _G.handler(self, self.OnRoomDataCall))
end

--[[
  required uint32 sid=1;//点位sid
  required uint64 role_uid=2;//点位玩家uid
  required uint32 type = 3;//类型 1，玩家，2，机器人
  required string name = 4;//玩家名字
  required uint32 style = 5;//头像
  required uint32 frame = 6;//头像框
  required uint32 power = 7;//阵容总战斗力
]]
function AllHeroesBattleRoomView:OnRoomDataCall(success, data)
    self.onBtnTag = false
    local AllHeroesBattleManagerIns = require("AllHeroesBattleManager"):GetInstance()
    local mRoleUid
    if self.isInit then
        AllHeroesBattleManagerIns:RegiestPosChangeCall(_G.handler(self, self.RefreshView))
        mRoleUid = _G.PlayerModel:GetInstance():GetPlayerUid()
        self.isInit = nil
    end
    if not success then
        return
    end
    self.players = {}
    local commander = {}
    local GetLangPackValue = _G.GetLangPackValue
    for i = 1, #data do
        if data[i].type ~= 1 then --机器人
            data[i].name = GetLangPackValue(data[i].name)
        end

        if data[i].sid % 100 == 50 then
            self.commander = data[i]
            commander.sid = data[i].city_style
            commander.name = data[i].name
            commander.tittle = data[i].title
            commander.power = data[i].power
            commander.uid = data[i].role_uid
        else
            self.players[i] = data[i]
        end
        -- if modelsid == 0 and activity_pvp_cfg[data[i].sid].type_pos == 1 then
        --     modelsid = data[i].city_style
        -- end
    end
    table.sort(self.players, function(a, b)
        local powerA = a.power and a.power or _G.PlayerModel:GetInstance():GetPower()
        local powerB = b.power and b.power or _G.PlayerModel:GetInstance():GetPower()
        local aisSelf = _G.PlayerModel:GetInstance():GetPlayerUid() ==a.role_uid
        local bisSelf = _G.PlayerModel:GetInstance():GetPlayerUid() ==b.role_uid
        if aisSelf or bisSelf then
            return aisSelf and not bisSelf
        else
            return powerA > powerB
        end
    end)
    self.go_table.scrollloopvectical_playerList:InitItemData(#data - 1, _G.handler(self, self.RefreshList))
    AllHeroesBattleManagerIns:SetPlaySuccessEffectTag(false)
    self:InitRole(commander)
end

function AllHeroesBattleRoomView:RefreshList(index, obj)
    local newIndex = index + 1
    local click = _G.handler(self, self.OnPlayerClick)
    local item = AllHeroesBattleRoomPlayerItem.New(obj, click)
    self.players[newIndex].earn = self.normalEarn
    if self.players[newIndex].sid % 100 ~= 50 then
        item:Show(self.players[newIndex])
    end
end

function AllHeroesBattleRoomView:ChangePage(num)
    local nextRoomId = self.curRoomID + num
    local nextRoomData = require("AllHeroesBattleManager"):GetInstance():GetRoomBaseData(nextRoomId)
    --检查开启剩余时间(功能开启或赛季开启后第n天后开启)
    local result = _G.TimeUtil.GetServerUnixTime() - require("AllHeroesBattleManager"):GetInstance():GetRoomFirstTime()
    local open_time = math.ceil(result / 86400)
    if open_time < nextRoomData.open_condition then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            630112,
            nil,
            nil,
            nil,
            nil,
            nil,
            nextRoomData.open_condition - open_time
        )
        self.onBtnTag = false
        return
    end

    self.curRoomID = nextRoomId
    self:Show(self.curRoomID)
end

function AllHeroesBattleRoomView:EscClose()
    self:Close()
end

return AllHeroesBattleRoomView
