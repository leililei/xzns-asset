    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end

function AllHeroesBattleRoomPlayerItem:Dispose()
    self.go_table = nil
    self.onClick = nil
    self.posID = nil
    self.playerID = nil
    self.gameObject = nil
end

