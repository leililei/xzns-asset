local format = _G.string.format
---@class AllHeroesBattleBaseView : UIBaseView	中文描述
---@field public go_table AllHeroesBattleBaseView_GoTable GoTable
local AllHeroesBattleBaseView = _G.BaseClass("AllHeroesBattleBaseView", _G.UIBaseView)

function AllHeroesBattleBaseView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.onBtnTag = true
    self.IsUpdateRedPointBox = false
end

---界面的入口函数
function AllHeroesBattleBaseView:OnCreate()
    self:InitView()
    self.go_table.aorrawimage_icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(18))
    local cycle = _G.ConfigManager.discrete_cfg[116122][1][1]
    local curDay = require("SeasonModel"):GetInstance().curDay
    local cfg = require("SeasonModel"):GetInstance():GetCfg()
    local now = _G.TimeUtil.GetServerUnixTime()
    if cfg.duration - curDay < cycle then
        local seasonTime = require("SeasonModel"):GetInstance():GetTime()
        self.curEndTime = seasonTime and seasonTime.settlementTime - now or require("AllHeroesBattleManager"):GetInstance():GetEndTime()
    else
        local secOfSix = now - _G.TimeUtil.GetDayBySix(now)
        self.curEndTime = (cycle - (curDay - 1) % cycle) * 86400 - secOfSix
    end
    local AllHeroesBattleManagerIns = require("AllHeroesBattleManager"):GetInstance()
    AllHeroesBattleManagerIns:HandleCfg()
    AllHeroesBattleManagerIns:RegiestInfoDataCall(_G.handler(self, self.OnSixClockUpdate))
    self:OnSecUpdate()
    self.endTimeTimer = _G.TimerManager:GetInstance():GetTimer(1, self.OnSecUpdate, self)
    self.endTimeTimer:Start()
end

function AllHeroesBattleBaseView:OnDisable()
    self.onBtnTag = false
end
---界面的销毁函数
function AllHeroesBattleBaseView:OnDestroy()
    if self.endTimeTimer then
        self.endTimeTimer:Stop()
        self.endTimeTimer = nil
    end
    local AllHeroesBattleManagerIns = require("AllHeroesBattleManager"):GetInstance()
    AllHeroesBattleManagerIns:RegiestPosChangeCall(nil)
    AllHeroesBattleManagerIns:RegiestInfoDataCall(nil)
end

---按钮点击事件在这里派发
function AllHeroesBattleBaseView:OnClickBtn(go)
    if go == self.go_table.aorbtn_buy then --购买挑战券
        require("AllHeroesBattleManager"):GetInstance():BuyFightTimes(_G.handler(self, self.OnBuyFightTimes))
    elseif go == self.go_table.aorbtn_award then --领取宝箱
        require("AllHeroesBattleManager"):GetInstance():GetAward(_G.handler(self, self.GetAwardFinish))
    elseif go == self.go_table.aorbtn_way then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 36)
    else
        self:OnClickBtnChild(go)
    end
end
function AllHeroesBattleBaseView:OnBuyFightTimes(success)
    self.go_table.aortext_times.text =
        format(_G.GetLangPackValue(90000010077), require("AllHeroesBattleManager"):GetInstance():GetFightTimes())
end
function AllHeroesBattleBaseView:OnSixClockUpdate()
    self:OnBuyFightTimes()
end
--region 子类重写
function AllHeroesBattleBaseView:OnClickBtnChild(go)
end
function AllHeroesBattleBaseView:RefreshView()
    self:InitView()
end
--endregion
---每秒更新方法
function AllHeroesBattleBaseView:OnSecUpdate(elapsed)
    self.curEndTime = self.curEndTime - (elapsed or 1)
    if self.curEndTime <= 0 then
        self.curEndTime = 0
        return
    end
    self.go_table.aortext_time.text = self:HandleTime(Mathf.RoundToInt(self.curEndTime))
    --每秒刷新
    self:UpdateOnAwardChange()
end

function AllHeroesBattleBaseView:InitView()
    self.go_table.aortext_times.text =
        format(_G.GetLangPackValue(90000010077), require("AllHeroesBattleManager"):GetInstance():GetFightTimes())
    self:UpdateOnPosChange()
end

---当段位发生变化时更新界面
function AllHeroesBattleBaseView:UpdateOnPosChange()
    local AllHeroesBattleManagerIns = require("AllHeroesBattleManager"):GetInstance()
    local curPosID = AllHeroesBattleManagerIns:GetCurPosID()
    curPosID = _G.ConfigManager.activity_pvp_cfg[curPosID].efficiency
    self.go_table.aortext_award.text = curPosID
    self:UpdateOnAwardChange()
end

---领宝箱奖励完成
function AllHeroesBattleBaseView:GetAwardFinish()
    self.IsUpdateRedPointBox = false
    --require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.AllHeroesBattleBox.id)
    self:UpdateOnAwardChange()
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.SeasonView.Name)
    if window then
        window.View:UpdateButton()
    end
end

---当奖励变化时
function AllHeroesBattleBaseView:UpdateOnAwardChange()
    local AllHeroesBattleManagerIns = require("AllHeroesBattleManager"):GetInstance()
    self.go_table.aortext_award.text =
        format(_G.GetLangPackValue(90000010085), AllHeroesBattleManagerIns:GetCurAwardEfficiency())
    local now = AllHeroesBattleManagerIns:GetAwardInfo()
    local max = AllHeroesBattleManagerIns:GetAwardMaxCount()
    self.go_table.aortext_count.text = format("%d/%d", now, max)

    if now >= max and false == self.IsUpdateRedPointBox then
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.AllHeroesBattleBox.id)
        self.IsUpdateRedPointBox = true
    end
end

--90000000948
--90021800086
function AllHeroesBattleBaseView:HandleTime(time)
    if time < 60 then
        return format(_G.GetLangPackValue(90021800086), "0", time)
    else
        local Floor = _G.Mathf.Floor
        self.timeDay = Floor(time / 86400)
        time = time - self.timeDay * 86400
        self.timeHour = Floor(time / 3600)
        time = time - self.timeHour * 3600
        time = Floor(time / 60)
        return format(_G.GetLangPackValue(90000000948), self.timeDay, self.timeHour, time)
    end
end

return AllHeroesBattleBaseView
