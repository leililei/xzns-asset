--region 内部方法
---计算奖励
---@return number|number 奖励数量|下一次刷新奖励的间隔时间
function AllHeroesBattleManager:CalculateAward()
    if self.awardTimeStamp == 0 then
        return 0
    end
    if self.calculateAwardCount >= MaxAwardCount then --达到上限
        self.calculateAwardCount = MaxAwardCount
        return self.calculateAwardCount
    end
    self.calculateAwardCount = _G.ConfigManager.activity_pvp_cfg[self.curPosID].efficiency
    self.calculateAwardCount =
        self.awardCount +
        _G.Mathf.RoundToInt(self.calculateAwardCount * (_G.TimeUtil.GetServerUnixTime() - self.awardTimeStamp) / 3600)
    if self.calculateAwardCount > MaxAwardCount then
        self.calculateAwardCount = MaxAwardCount
    end
    return self.calculateAwardCount
end

---退出布阵
function AllHeroesBattleManager:ExitEmbattle()
    self.openEmbattleTag = false
    self.playSuccessEffectTag = false
    if self.attackEmbattle then
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.AllHeroesBattleRoomView.Name)
    else
        --require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.AllHeroesBattleEmbattle.id)
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.AllHeroesBattleView.Name)
    end
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ChatView.Name)
end

---进入战斗
function AllHeroesBattleManager:EnterFight()
    self.openEmbattleTag = false
    local skip =
        _G.PlayerPrefsManager.GetInt(_G.tostring(_G.PlayerModel:GetInstance().role_uid) .. "SkipBattle" .. 4) or 0
    if skip == 1 then
        AllHeroesBattleNet:GetInstance():Challenge(
            self.curChallengePosID,
            self.curChallengeUid,
            _G.handler(self, self.TiaoGuo)
        )
    else
        --双方对战名称
        local leftName = _G.PlayerModel:GetInstance():GetName()
        local rightName = self.curChallengePlayer and self.curChallengePlayer.name or ""
        _G.BattleManager:GetInstance():EnterFight(
            _G.BattleControllerType.AllHeroesBattle,
            self.curChallengePosID,
            self.curChallengeUid,
            _G.handler(self, self.OnChallengeCall),
            _G.handler(self, self.OnEnterFight),
            leftName,
            rightName
        )
    end
    --require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.AllHeroesBattleEmbattle.id)
end

function AllHeroesBattleManager:TiaoGuo(_data)
    self:OnEnterFight(_data)
    if _data.ack == 1 then
        _G.WorldManager:GetInstance():DespawnRoleParent()
        _G.StorageManager:GetInstance():ReceiveAwardData(_data)
        local result = _data.winner or false

        --双方对战名称
        local leftName = _G.PlayerModel:GetInstance():GetName()
        local rightName = self.curChallengePlayer and self.curChallengePlayer.name or ""

        self.curBattleController = _G.require(_G.BattleControllerType.AllHeroesBattle).New()
        self.curBattleController.leftName = leftName
        self.curBattleController.rightName = rightName
        self.curBattleController.fightArg = _data.fight_arg
        self.curBattleController:StartSettlement(
            _G.SettlementModel.SettlementType.AllHeroesBattle,
            result,
            true,
            function()
                self:UpdateInitData(_G.handlerbind(self, self.OnChallengeCall, true))
            end,
            nil, --_G.BattleManager:GetInstance():GetStatisticsRecord(_data.fight_arg)
            _data.fight_arg,
            self.report_uid,
            self.curChallengePlayer
        )
        _G.BattleManager:GetInstance():DestroyBattle()
        _G.BattleManager:GetInstance():SetArgData(_data.fight_arg)
        _G.BattleManager:GetInstance():SetBattleController( self.curBattleController)
        _G.Events:GetInstance():Broadcast(_G.eSeasonTask.Action, {_G.SeasonTaskID.AllHeroesBattle_Fight}, 1)
    end
end

function AllHeroesBattleManager:OnChallengeCall(success)
    if not success then --战斗验证不通过
        self.playSuccessEffectTag = false
        self:GetRoomPlayerData(
            self.curChooseRoomID,
            function(success, data)
                local UIManagerIns = _G.UIManager:GetInstance()
                local name = _G.ConfigManager.ui_cfg.AllHeroesBattleRoomView.Name
                UIManagerIns:ShowWindow(name)
                local view = UIManagerIns:GetWindowCtrl(name)
                view:OnRoomDataCall(success, data)
                _G.WorldManager:GetInstance():DestoryRoleParent()
            end
        )
    else
        self.reports = nil
        -- require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.AllHeroesBattleChallenge.id)
        if self.fightNums <= 0 then --免费次数用完，消耗道具
            _G.StorageManager:GetInstance():ConsumeItem(ticketItemID, 0, 1)
            local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.AllHeroesBattleRoomView.Name)
            if view then
                view:RefreshView()
            end
        end
    end
end

