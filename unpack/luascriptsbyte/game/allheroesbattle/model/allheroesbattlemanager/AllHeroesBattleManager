---挑战玩家
---@param id number 位置ID
---@param uid number 挑战的玩家UID
function AllHeroesBattleManager:Challenge(roomid, player)
    if player.role_uid == _G.PlayerModel:GetInstance():GetPlayerUid() then --点自己没反应
        return
    end
    if roomid == 1 then
        _G.PopWindowManager:GetInstance():ShowAllTips(620106)
        if player.type == 1 then --玩家就弹出信息界面
            _G.SystemSettingManager:GetInstance():OpenView(player.role_uid)
        end
        return
    end
    if self:GetFightTimes() <= 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            620103,
            nil,
            function()
                local view =
                    _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.AllHeroesBattleRoomView.Name)
                self:BuyFightTimes(_G.handler(view, view.OnBuyFightTimes))
            end
        )
        return
    end
    self.curChallengePosID = player.sid
    self.curChallengeUid = player.role_uid
    self.curChallengePower = player.power
    self.curChallengePlayer = player
    local cfgs = _G.ConfigManager.activity_pvp_cfg
    local ecfg = cfgs[self.curChallengePosID]
    local mcfg = cfgs[self.curPosID]
    if ecfg.room - mcfg.room > 1 then --不能越级挑战
        _G.PopWindowManager:GetInstance():ShowAllTips(630110)
    elseif ecfg.room < mcfg.room or (ecfg.room == mcfg.room and ecfg.type_pos <= mcfg.type_pos) then --挑战同等位置或者底位置的玩家提示
        _G.PopWindowManager:GetInstance():ShowAllTips(
            620102,
            nil,
            function()
                AllHeroesBattleNet:GetInstance():GetEnemyEmbattleData(
                    player.role_uid,
                    _G.handler(self, self.OnEmbattleDataCall)
                )
            end
        )
    else
        self.playSuccessEffectTag = true
        AllHeroesBattleNet:GetInstance():GetEnemyEmbattleData(
            player.role_uid,
            _G.handler(self, self.OnEmbattleDataCall)
        )
    end
end

