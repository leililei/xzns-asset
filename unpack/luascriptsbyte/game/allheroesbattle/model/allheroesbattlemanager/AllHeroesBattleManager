--region 数据解析
--[[
  required uint32 sid=1;//所在房间点位sid
  required uint32 fight_num=2;//剩余免费战斗次数
  required uint32 time=3;//挂机开始时间戳
  required uint32 reward = 4;//截至该时间戳已积攒奖励数量
]]
function AllHeroesBattleManager:OnInitData(data)
    self.functionOpenTag = true
    self.curPosID = (data.sid and data.sid > 0) and data.sid or self.rooms[1].center
    self.fightNums = data.fight_num or 0
    -- require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.AllHeroesBattleChallenge.id)
    self.awardTimeStamp = data.time
    self.awardCount = data.reward
    self.calculateAwardCount = 0
    self.max_star = data.max_star
    self.max_type = data.max_type
    self.taskAwardData = {}
    if data.room_award then
        for k, v in ipairs(data.room_award) do
            if not self.taskAwardData[v.k] then
                self.taskAwardData[v.k] = {}
            end
            self.taskAwardData[v.k][v.v] = true
        end
    end
    self:InitRepoetNewTag(data.attacked)
    if self.onPosChangeCall then
        self.onPosChangeCall()
    end
    if self.onInfoDataCall then
        self.onInfoDataCall()
    end
    --刷新红点状态
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.AllHeroesBattleReport.id)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.AllHeroesBattleTask.id) --任务奖励
end

---获取是否离线被攻击
function AllHeroesBattleManager:InitRepoetNewTag(attacked)
    if not require "SeasonModel":GetInstance():CheckSeasonIsOpen() then
        self.reportNewTag = false
        return
    end
    ---只有被从中心点掉出或者从房间中掉出
    if attacked then
        if self.reportNewTag then
            return
        end
        local num = _G.PlayerPrefsManager.GetInt(_G.AllHeroBattle.AllHeroReporTagKey, 0)
        self.reportNewTag = num > 0
        if not self.reportNewTag then
            self.reportNewTag = self:CheckIsLose()
        end
    else
        local time = _G.PlayerPrefsManager.GetString(_G.AllHeroBattle.AllHeroFightTimeKey)
        local seasonTime = "" .. require "SeasonModel":GetInstance():GetTime().startTime
        if _G.string.IsNullOrEmpty(time) or time == seasonTime then
            local num = _G.PlayerPrefsManager.GetInt(_G.AllHeroBattle.AllHeroReporTagKey, 0)
            self.reportNewTag = num > 0
        else
            _G.PlayerPrefsManager.SetString(_G.AllHeroBattle.AllHeroFightTimeKey, seasonTime)
            if self.reportNewTag == nil then
                self.reportNewTag = false
                _G.PlayerPrefsManager.DeleteKey(_G.AllHeroBattle.AllHeroReportKey)
                _G.PlayerPrefsManager.DeleteKey(_G.AllHeroBattle.AllHeroReporTagKey)
            end
        end
    end
end

---检测是否掉段吗
function AllHeroesBattleManager:CheckIsLose()
    if _G.PlayerPrefsManager.HasKey(_G.AllHeroBattle.AllHeroReportKey) then
        ---@type activity_pvp_cfg
        local cfg2 = _G.ConfigManager.activity_pvp_cfg[self.curPosID]
        local num = _G.PlayerPrefsManager.GetInt(_G.AllHeroBattle.AllHeroReportKey, 0)
        if num > 0 and num ~= self.curPosID then
            ---@type activity_pvp_cfg
            local cfg = _G.ConfigManager.activity_pvp_cfg[num]
            if cfg then
                if cfg.room == cfg2.room then
                    return num == self.rooms[cfg2.room].center
                elseif cfg2.room < cfg.room then
                    return true
                end
            end
        end
    end
    return false
end

--[[
  required uint32 ack = 1;
  repeated i_room rooms=2;
]]
function AllHeroesBattleManager:OnRoomData(data)
    if self.onRoomDataCall then
        if data.ack ~= 1 then --数据获取出错
            self.onRoomDataCall(false)
        else
            data = data.rooms
            if data[1].sid == 0 then --一星房间不给位置，按照顺序默认位置 自己在第9位 对应中心位置
                local pos = self.rooms[self.curChooseRoomID].pos
                for i = 1, #data do
                    data[i].sid = pos[i]
                end
            end
            self.onRoomDataCall(true, data)
        end
        self.onRoomDataCall = nil
    end
end

