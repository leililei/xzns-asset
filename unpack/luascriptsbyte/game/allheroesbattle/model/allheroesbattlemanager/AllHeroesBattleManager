--[[
  optional uint32 sid = 1;//卡牌sid
  optional uint32 level = 2;//等级
  optional uint32 star = 3;//星级
  optional uint32 index = 4;//站位
]]
function AllHeroesBattleManager:OnEmbattleDataCall(data)
    if data.ack ~= 1 then
        return
    end
    self.attackEmbattle = true
    local edata = {}
    for i = 1, #data.team do
        edata[data.team[i].index] = data.team[i]
        edata[data.team[i].index].uid = data.team[i].sid
        edata[data.team[i].index].soulLink_IsActivate = data.team[i].soul_state
        edata[data.team[i].index].soulLink_lv = data.team[i].soul_lv
        edata[data.team[i].index].open_inborn = data.team[i].born_skill_num
        edata[data.team[i].index].index = nil
    end
    edata.power = self.curChallengePower or 0
    self.openEmbattleTag = true
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    require("EmbattleController"):GetInstance():OpenEmbattle(
        _G.EmbattleType.AllHeroesBattle,
        _G.EmbattleSaveType.server,
        nil,
        _G.EmbattleControllerItemType.allHeroesAttack,
        _G.handler(self, self.ExitEmbattle),
        _G.handler(self, self.EnterFight),
        _G.ConfigManager.activity_pvp_cfg[self.curChallengePosID].battle_scene,
        edata,
        self.curChallengeUid,
        self.curChallengePosID
    )
end

