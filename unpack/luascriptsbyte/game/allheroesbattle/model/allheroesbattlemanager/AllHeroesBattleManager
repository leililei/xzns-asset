---检测是否存在任务红点
---@return boolean
function AllHeroesBattleManager:CheckRedpointTask()
    ---尚未初始化完成
    if not self.taskAwardData then
        return false
    end

    local cfgsRoom = _G.ConfigManager.activity_pvp_room_cfg

    local roomids = self:GetRoomIds()
    local count = #roomids
    for i = 1, count do
        local cfg = cfgsRoom[roomids[count - i + 1]]
        --当前存在可领取的奖励
        if self:GetTaskStateByStarAndType(cfg.id, 0) == 1 or self:GetTaskStateByStarAndType(cfg.id, 1) == 1 then
            return true
        end
    end
    return false
end

--获取计算房间开启的初始时间（第一赛季用功能开启时间，之后的赛季用赛季开始时间）
function AllHeroesBattleManager:GetRoomFirstTime()
    local model = require "SeasonModel":GetInstance()
    local seasonStartTime = model:GetTime() and model:GetTime().startTime or 0
    local functionOpenTime = _G.PlayerModel:GetInstance().open_time + (_G.ConfigManager.function_open_cfg[_G.FunctionID.AllHeroesBattle].condition_type[2][2] - 1) * 86400
    if seasonStartTime and seasonStartTime > functionOpenTime then
        local periods = self:GetCurPeriods()
        return seasonStartTime + periods * self.cycle * 86400 
    else 
        return functionOpenTime
    end
end

---获取当前期数（1赛季4期）
function AllHeroesBattleManager:GetCurPeriods()
    local curDay = require "SeasonModel":GetInstance().curDay
    return (curDay - 1) // self.cycle
end

