---领取通关奖励
---@param callback function 战报回调
function AllHeroesBattleManager:GetTaskAward(list, callback)
    AllHeroesBattleNet:GetInstance():GetTaskAward(
        {list = list},
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)

            for _, v in pairs(list) do
                if not self.taskAwardData[v.room_star] then
                    self.taskAwardData[v.room_star] = {}
                end
                self.taskAwardData[v.room_star][v.room_type] = true 
            end
            require("RedPointManager"):GetInstance():RefreshNode(
                _G.ConfigManager.redpoint_cfg.AllHeroesBattleTask.id
            )
            if callback then
                callback()
            end
        end
    )
end

