--[[
    public.s2c_common_ack
]]
function AllHeroesBattleManager:OnGetAwardCall(data)
    if data.ack ~= 1 then
        return
    end
    _G.StorageManager:GetInstance():ReceiveAwardData(data)
    require("CommonTipManager"):GetInstance():OpenDropTip(data)
    self.awardCount = 0
    self.calculateAwardCount = 0
    self.awardTimeStamp = _G.TimeUtil.GetServerUnixTime()
    if self.onGetAwardCall then
        self.onGetAwardCall(true)
        self.onGetAwardCall = nil
    end
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.AllHeroesBattleBox.id)
    _G.Events:GetInstance():Broadcast(_G.eSeasonTask.Action, {_G.SeasonTaskID.AllHeroesBattle_Award}, 1)
