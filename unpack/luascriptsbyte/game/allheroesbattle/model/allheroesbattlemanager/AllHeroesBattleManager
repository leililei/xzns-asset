function AllHeroesBattleManager:InitFunction()
    if self.tipsTimer then --已经开启了跑马灯计时器
        return
    end
    local discrete_cfg = _G.ConfigManager.discrete_cfg
    ---群英会武跑马灯
    ---@type number 循环间隔时间, 开始延迟等待时间
    local tipsTime, startTipsTime
    if discrete_cfg[105714] and discrete_cfg[105715] then
        tipsTime = discrete_cfg[105714][1][1]
        startTipsTime = _G.TimeUtil.GetSecondsOfDay() - discrete_cfg[105715][1][1] * 3600
    end
    if tipsTime and startTipsTime and tipsTime > 0 then
        self.tipsTime = tipsTime
        if startTipsTime < 0 then
            while startTipsTime < 0 do
                startTipsTime = startTipsTime + self.tipsTime
            end
        else
            while startTipsTime > 0 do
                startTipsTime = startTipsTime - self.tipsTime
            end
            startTipsTime = 0 - startTipsTime
        end

        if startTipsTime == 0 then
            self:HandleTips()
        else
            self.tipsTimer = _G.TimerManager:GetInstance():GetTimer(startTipsTime, self.HandleTips, self, true)
            self.tipsTimer:Start()
        end
    else
        self:StopTipsTimer()
        self.tipsTime = nil
    end
end

--endregion
function AllHeroesBattleManager:HandleCfg()
    if self.rooms then
        return
    end
    local cfgsPvp = _G.ConfigManager.activity_pvp_cfg
    local cfgsRoom = _G.ConfigManager.activity_pvp_room_cfg
    local roomids = self:GetRoomIds()
    self.rooms = {false, false, false, false, false}
    local dic

    for k, room in ipairs(roomids) do
        local cfgs = cfgsRoom[room]
        for k2, v in ipairs(cfgs.pos) do
            local cfg = cfgsPvp[v]
            dic =
                self.rooms[cfg.room] or
                {
                    id = cfg.room,
                    normal = 0,
                    specail = 0,
                    pos = {},
                    center = 0,
                    image = cfgs.room_picture,
                    name = cfgs.name,
                    open_condition = cfgs.open_condition,
                }
            dic.pos[#dic.pos + 1] = cfg.id
            if cfg.type_pos == 0 then
                dic.normal = cfg.efficiency
            else
                dic.specail = cfg.efficiency
                dic.center = cfg.id
            end
            self.rooms[cfg.room] = dic
        end
    end
    local sort = _G.table.sort
    for i = 1, #self.rooms do
        sort(self.rooms[i].pos)
    end
end

---获取任务list
function AllHeroesBattleManager:GetTaskList()
    local roomids = self:GetRoomIds()
    local cfgsRoom = _G.ConfigManager.activity_pvp_room_cfg
    local taskList = {}
    local taskFinishList = {}
    local jumpIndex = 0

    local count = #roomids
    for i = 1, count do
        local room = roomids[count - i + 1]
        local cfg = cfgsRoom[room]
        local state1 = self:GetTaskStateByStarAndType(cfg.id, 0)
        local state2 = self:GetTaskStateByStarAndType(cfg.id, 1)

        if state2 == 2 then
            _G.table.insert(
                taskFinishList,
                {sid = cfg.id, type = 1, reward = cfg.reward_pos_1, des = cfg.reward_desc[2], open_condition = cfg.open_condition}
            )
        else
            _G.table.insert(taskList, {sid = cfg.id, type = 1, reward = cfg.reward_pos_1, des = cfg.reward_desc[2], open_condition = cfg.open_condition})
            if state2 == 1 and jumpIndex == 0 then
                jumpIndex = #taskList
            end
        end

        if state1 == 2 then
            _G.table.insert(
                taskFinishList,
                {sid = cfg.id, type = 0, reward = cfg.reward_pos_0, des = cfg.reward_desc[1], open_condition = cfg.open_condition}
            )
        else
            _G.table.insert(taskList, {sid = cfg.id, type = 0, reward = cfg.reward_pos_0, des = cfg.reward_desc[1], open_condition = cfg.open_condition})
            if state1 == 1 and jumpIndex == 0 then
                jumpIndex = #taskList
            end
        end
    end

    for k, v in ipairs(taskFinishList) do
        _G.table.insert(taskList, v)
    end
    return taskList, jumpIndex
end

---获取房间id列表
---@return number[]
function AllHeroesBattleManager:GetRoomIds()
    local sid = require "SeasonModel":GetInstance():GetCurSeasonId() == 1 and 105728 or 105729
    return _G.ConfigManager.discrete_cfg[sid][1]
end

---获取任务状态
---@param star number
---@param type number
---@return number 0:不可领取 1：可领取 2：已领取
function AllHeroesBattleManager:GetTaskStateByStarAndType(star, type)
    local state = 0
    if self.taskAwardData[star] and self.taskAwardData[star][type] then
        state = 2
    elseif (self.max_star > star) or (self.max_star == star and self.max_type >= type) then
        state = 1
    end
    return state
end

---打开对应房间界面
function AllHeroesBattleManager:OpenBattleView()
    local id = _G.ConfigManager.activity_pvp_cfg[self.curPosID].room
    local name = _G.ConfigManager.ui_cfg.AllHeroesBattleView.Name
    local view = _G.UIManager:GetInstance():GetWindowCtrl(name)
