---@class ReedCatkinsQuickSweepView : UIBaseView	中文描述
---@field public go_table ReedCatkinsQuickSweepView_GoTable GoTable
local ReedCatkinsQuickSweepView = _G.BaseClass("ReedCatkinsQuickSweepView", _G.UIBaseView)
--_G.ReedCatkinsQuickSweepView = ReedCatkinsQuickSweepView

---@class ReedCatkinsQuickSweepView_Params
---@field sweepCall function 扫荡回调
---@field itemId number 物品sid
---@field consume number 单次消耗
---@field awardData table 可能获得的奖励
---@field title string 标题

function ReedCatkinsQuickSweepView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param params ReedCatkinsQuickSweepView_Params
function ReedCatkinsQuickSweepView:OnCreate(params)
    self.go_table.input_userNum.onEndEdit:AddListener(_G.handlerbind(self, self.OnEndEditorDeclaration))
    self.go_table.scrollloopvectical_awardList:InitItemData(0, _G.handler(self, self.RefreshAwardList))
    self.maxChooseCount=_G.ConfigManager.discrete_cfg[104703][1][1]
    self:UpdatePanel(params)
end

---改变输入值
function ReedCatkinsQuickSweepView:OnEndEditorDeclaration(input)
    local num = _G.tonumber(input)
    if num == nil then
        return
    elseif num <= 0 then
        num = 1
    end
    self.selectCount = num
    self:ChangeSelectCount(0)
end

---更新界面
---@param params ReedCatkinsQuickSweepView_Params
function ReedCatkinsQuickSweepView:UpdatePanel(params)
    self.sweepCall = params.sweepCall
    self.go_table.aortext_title.text = params.title
    self.selectCount = 1
    self:InitData(params)
    self:UpdateAward()
    self:ChangeSelectCount(0)
    local icon = _G.StorageManager:GetInstance():GetItemIcon(self.itemId)
    self.go_table.aorrawimage_icon:LoadImage(icon)
    self.go_table.aorrawimage_icon2:LoadImage(icon)
    self.go_table.aortext_totalNum.text = _G.GameUtil.NumberToUnitStrBag(self.totalCount)
end

function ReedCatkinsQuickSweepView:UpdateAward()
    local count = #self.awardData
    self.go_table.scrollloopvectical_awardList:UpdateCount(count)
    if count <= 8 then
        self.go_table.scrollloopvectical_awardList:UpdateScrollRectHeight(100)
        self.go_table.scrollloopvectical_awardList:SetRectTransformSize(count * 88 + (count - 1) * 9 + 20, 100)
        local grad =
            self.go_table.scrollloopvectical_awardList:GetChildE(0):GetChildE(0):GetComponentE(
            _G.typeof(_G.CS.UnityEngine.UI.GridLayoutGroup)
        )
        if grad then
            grad.enabled = true
        end
    end
end
---@param params ReedCatkinsQuickSweepView_Params
function ReedCatkinsQuickSweepView:InitData(params)
    self.itemId = params.itemId
    self.totalCount = _G.StorageManager:GetInstance():GetItemCountBySid(self.itemId)
    self.consume = params.consume
    self.maxCount = _G.math.floor(self.totalCount / self.consume)
    self.awardData = _G.GlobalInterface.GetNewArray(params.awardData)
    local StorageManagerInst = _G.StorageManager:GetInstance()
    _G.SortList(
        self.awardData,
        function(a)
            local type = StorageManagerInst:CheckSidType(a)
            local index = 1
            if type == _G.StorageType.Decoration then
                index = 99 + (StorageManagerInst:GetItemGrade(a) or 0)
            end
            return index, a
        end
    )
end

function ReedCatkinsQuickSweepView:UpdateCount()
    self.go_table.input_userNum.text = self.selectCount
    self.go_table.aortext_needNum.text = self.consume * self.selectCount
end

function ReedCatkinsQuickSweepView:ChangeSelectCount(num)
    self.selectCount = self.selectCount + num
    local max = self.totalCount

    local min = 1
    if self.selectCount >= max then
        self.selectCount = max
    elseif self.selectCount < min then
        self.selectCount = min
    end
    if self.selectCount > self.maxChooseCount then
        self.selectCount = self.maxChooseCount
    end
    self:UpdateCount()
end

function ReedCatkinsQuickSweepView:RefreshAwardList(index, obj)
    obj:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew({self.awardData[index+1], 1}, obj)
end

---按钮点击事件在这里派发
function ReedCatkinsQuickSweepView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.aorbtn_sweep then
        if self.sweepCall then
            self.sweepCall(self.selectCount, _G.handler(self, self.Close))
        else
            self:Close()
        end
    elseif go == self.go_table.aorbtn_propMax then
        self:ChangeSelectCount(self.totalCount)
    elseif go == self.go_table.aorbtn_propAdd then
        self:ChangeSelectCount(1)
    elseif go == self.go_table.aorbtn_propSub then
        self:ChangeSelectCount(-1)
    end
end

return ReedCatkinsQuickSweepView
