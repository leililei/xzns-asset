---挑战或者扫荡
function ReedCatkinsView:OnChallenge()
    if self.curDayReedTypeID ~= self.curReedTypeID then
        _G.PopWindowManager:GetInstance():ShowAllTips(310102)
        return
    end
    local count = require "ReedCatkinsModel":GetInstance():GetFreeTimes()
    local number = require "HellRoadModel":GetInstance():GetNumber({_G.PrivilegeType.VIP.luhuahuanjing})
    if require "ReedCatkinsModel":GetInstance():GetFreeTimes() <= 0 and not self:CheckCanChallenge() then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.GetItemWayView.Name,
            require "ReedCatkinsModel":GetInstance().customCfg[1][1]
        )
        return
    end
    if self.curReedCatkinsData.isLock then
        _G.PopWindowManager:GetInstance():ShowAllTips(94)
        return
    end
    require("ReedCatkinsModel"):GetInstance():ChallengeReedCatkins(self.curReedTypeID, self.curReedCatkinsData.sid)
end

---扫荡
function ReedCatkinsView:OnSweep()
    local i = 2
    if require "ReedCatkinsModel":GetInstance():GetFreeTimes() > 0 then
        i = 1
    elseif not self:CheckCanChallenge() then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.GetItemWayView.Name,
            require "ReedCatkinsModel":GetInstance().customCfg[1][1]
        )
        return
    end
    if
        self.curReedCatkinsData.isFirst or
            not _G.GlobalConditionManager.CheckCondition(
                self.curReedCatkinsData.cfg.sweep_condition[1],
                self.curReedCatkinsData.cfg.sweep_condition[2]
            )
     then
        return
    end
    local msg = {sid = self.curReedCatkinsData.sid, type = i}
    local sweep = function(num, call)
        msg.num = num or 1
        require("ReedCatkinsNet"):GetInstance():SweepReedCatkins(
            msg,
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                if call then
                    call()
                end
                if i == 1 then
                    require "ReedCatkinsModel":GetInstance().fightTimes =
                        require "ReedCatkinsModel":GetInstance().fightTimes + num
                elseif i == 2 then
                    local customCfg = require "ReedCatkinsModel":GetInstance().customCfg
                    _G.StorageManager:GetInstance():ConsumeItem(customCfg[1][1], nil, customCfg[1][2] * num)
                end
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                self:UpdateInfoDataAndPanel(true)
                require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                    _G.ConfigManager.redpoint_cfg.ReedCatkins.id
                )
                --  require("ReedCatkinsModel"):GetInstance():UpdateTimes()
            end
        )
    end
    if self.go_table.toggle_sweepAll.isOn then
        if i == 1 then
            sweep(require "ReedCatkinsModel":GetInstance():GetFreeTimes())
        else
            local cfg = _G.ConfigManager.monster_cfg[self.curReedCatkinsData.cfg.preview_monster]
            local customCfg = require "ReedCatkinsModel":GetInstance().customCfg
            ---@type ReedCatkinsQuickSweepView_Params
            local param = {}
            param.itemId = customCfg[1][1]
            param.consume = customCfg[1][2]
            param.awardData = self.curReedCatkinsData.cfg.preview_reward
            param.title = _G.GetLangPackValue(90022900075, _G.GetLangPackValue(cfg.Name))
            param.sweepCall = sweep
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ReedCatkinsQuickSweepView.Name, param)
        end
    else
        sweep(1)
    end
end

function ReedCatkinsView:CheckCanChallenge()
    return require "ReedCatkinsModel":GetInstance():CheckCanChallenge()
end

---更新Toggle显示
function ReedCatkinsView:UpdateToggle()
    self.startId = self.curReedCatkinsData.sid - self.curReedCatkinsData.sid % 10
    ---@param v ReedCatkinsData[]
    self.curReedCatkinsDatas =
        _G.table.chooseToArray(
        self.ReedCatkinsDatas,
        function(_, v)
            return v.cfg.grade == self.curReedCatkinsData.cfg.grade
        end
    )
    self.go_table.scrollloopvectical_levelList:UpdateCount(
        #self.curReedCatkinsDatas,
        self.curReedCatkinsData.cfg.difficulty - 1
    )
end
---刷新难度显示
function ReedCatkinsView:RefreshLevel(index, obj)
    local check = function(o)
        o:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
        if self:IsNil() then
            RemoveEffect(o)
        end
    end

    local id = obj:GetInstanceIDE()
    local tb = self.levelList[id]
    if _G.IsNil(tb) then
        tb = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickLockLevel, tb))
        self.levelList[id] = tb
    end
    tb.index = index + 1
    local data = self.ReedCatkinsDatas[self.startId + index + 1]
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOff, data.sid ~= self.curReedCatkinsData.sid)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, data.sid == self.curReedCatkinsData.sid)
    tb.aortext_label1.text = _G.LangUtil.GetLangPackValue(data.cfg.layer)
    tb.aortext_label2.text = _G.LangUtil.GetLangPackValue(data.cfg.layer)
    if data.sid == self.curReedCatkinsData.sid then
        self.curItem = tb
    end
    _G.GameUtil.SetActiveByCondition(tb.obj_lock, data.isLock)
    if data.isLock then
        tb.aortext_lock.text = data:GetLockStr()
    else
        ---ZHJ-21725 注：以目前的toggle刷新规则不会走到这里的if
        if data.sid > self.curReedCatkinsData.sid and _G.PlayerPrefsManager.GetInt(PrefsKey .. data.sid, 0) == 0 then
            _G.PlayerPrefsManager.SetInt(PrefsKey .. data.sid, 1)
            if tb.obj_eff:GetChildCountE() > 0 then
                tb.obj_eff:SetActiveE(0)
                tb.obj_eff:SetActiveE(1)
            else
                _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_fubentongyongjiesuo, tb.obj_eff, check)
            end

            tb.obj_lock:SetActiveE(1)
            tb.aorimage_suo:SetActiveE(0)
            tb.aortext_lock.text = _G.LangUtil.GetLangPackValue(90022900062)
            _G.DelayDo(
                1.41,
                function()
                    if tb then
                        tb.obj_lock:SetActiveE(0)
                        tb.obj_eff:SetActiveE(0)
                    end
                end
            )
        end
    end
end

function ReedCatkinsView:OnClickLockLevel(go, isOn, tb)
    local data = self.ReedCatkinsDatas[self.startId + tb.index]
    if data.isLock then
        if not _G.GlobalConditionManager.CheckCondition(data.cfg.limit_condition[1], data.cfg.limit_condition[2]) then
            local str, tipsID =
                _G.FunctionManager:GetInstance():GetStrWithType(
                data.cfg.limit_condition[1],
                data.cfg.limit_condition[2]
            )
            _G.PopWindowManager:GetInstance():ShowAllTips(tipsID, str)
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(310103)
        end
    else
        if self.curReedCatkinsData and self.curReedCatkinsData.sid == data.sid then
            return
        end
        if self.curItem then
            _G.GameUtil.SetActiveByCondition((self.curItem.aorimage_isOff), true)
            _G.GameUtil.SetActiveByCondition((self.curItem.aorimage_isOn), false)
        end
        _G.GameUtil.SetActiveByCondition((tb.aorimage_isOff), false)
        _G.GameUtil.SetActiveByCondition((tb.aorimage_isOn), true)
        self.curReedCatkinsData = data
        self.curItem = tb
        self:UpdatePanel()
    end
end

function ReedCatkinsView:OnToggle(name, isOn)
    local str = string.replace(name, "$_toggle_", "")
    local index = tonumber(str)
    _G.GameUtil.SetActiveByCondition((self.Toggles[index].aorimage_isOff), not isOn)
    _G.GameUtil.SetActiveByCondition((self.Toggles[index].aorimage_isOn), isOn)
    if not isOn then
        return
    end
    local startId = self.curReedCatkinsData.sid - self.curReedCatkinsData.sid % 10

    startId = startId + index
    self.curReedCatkinsData = require("ReedCatkinsModel"):GetInstance().ReedCatkinsDatas[startId]
    self:UpdatePanel()
    _G.GameUtil.SetActiveByCondition((self.Toggles[index].aorimage_isOn), true)
end

---更新当前难度数据
function ReedCatkinsView:UpdateCurReedCatkinsData()
    local ReedCatkinsDatas = require("ReedCatkinsModel"):GetInstance().ReedCatkinsDatas
    local keys = _G.table.keys(ReedCatkinsDatas)
    _G.table.sort(
        keys,
        function(a, b)
            return a < b
        end
    )
    local count = #keys
    for i = 1, count do
        local data = ReedCatkinsDatas[keys[i]]
        if math.abs(data.sid - self.curReedTypeID) < 10 then
            if data.isLock then
                break
            end
            self.curReedCatkinsData = data
        end
    end

    if not self.curReedCatkinsData then
        self.curReedCatkinsData = ReedCatkinsDatas[keys[1]]
    end
end

function ReedCatkinsView:ChangeReedType(type)
    if self.curReedTypeID then
        self:UpdateBall(false)
    end
    self.curReedTypeID = type
    self:UpdateInfoDataAndPanel()
    self:UpdateBall(true)
end

---按钮点击事件在这里派发
function ReedCatkinsView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_close" then
        self:CloseView()
    elseif name == "@_aorbtn_playerWay" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 26)
    elseif name == "@_aorbtn_challenge" then
        self:OnChallenge()
    elseif name == "@_aorbtn_sweep" then
        self:OnSweep()
    elseif name == "@_aorbtn_wind" then
        self:ChangeReedType(ReedCatkinsID.Feng)
    elseif name == "@_aorbtn_flower" then
        self:ChangeReedType(ReedCatkinsID.Hua)
    elseif name == "@_aorbtn_snow" then
        self:ChangeReedType(ReedCatkinsID.Xue)
    elseif name == "@_aorbtn_month" then
        self:ChangeReedType(ReedCatkinsID.Yue)
    elseif name == "$_toggle_sweepAll" then
        self:SweepAll(isOn)
    elseif string.contains(name, "toggle") then
        self:OnToggle(name, isOn)
    elseif name == "@_aorbtn_gift" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ReedCatkinsGiftView.Name)
    end
end

function ReedCatkinsView:SweepAll(isOn)
    _G.PlayerPrefsManager.SetInt(SweepKey, isOn and 1 or 0)
end

return ReedCatkinsView
