---创建奖励列表
function ReedCatkinsView:CreateAwardList()
    self.AwardList = {}
    local reward = self.curReedCatkinsData.reward

    for _, v in pairs(reward) do
        table.insert(self.AwardList, v)
    end

    self.go_table.scrollloophorizontal_Award:UpdateCount(#self.AwardList)
end

---刷新单个奖励
---@param listView2 table 无限滚动组件
---@param index number 下表，由0开始
function ReedCatkinsView:RefreshAwardList(index, obj)
    if index < 0 then
        return
    end
    local list = self.AwardList
    local item = obj
    local instanceID = item:GetInstanceIDE()
    ---@type BaseAwardNewItem
    local tb = self.AwardItems[instanceID]
    local x = index + 1
    local sid = list[x]
    if not tb then
        tb = require "BaseAwardNewItem".New(item, _G.handler(self, self.OnAwardClick), 70, obj)
        self.AwardItems[instanceID] = tb
    end
    local data = _G.StorageManager:GetInstance():GetItemDataClass(sid, 0)
    tb:Show(
        data,
        function()
            if tb.item and tb.item.ShowFrame then
                tb.item:ShowFrame()
            end
        end
    )
end

---@param item EquipmentItem
function ReedCatkinsView:OnAwardClick(item)
    require("CommonTipManager"):GetInstance():OpenTip(item.gameObject, item.data.sid, item.data.uid)
end

