local ReedCatkinsView = _G.BaseClass("ReedCatkinsView", _G.UIBaseView)

local ReedCatkinsID = {
    Feng = 101000,
    Hua = 102000,
    Xue = 103000,
    Yue = 104000
}
local ReedCatkinsName = {
    [ReedCatkinsID.Feng] = "wind",
    [ReedCatkinsID.Hua] = "flower",
    [ReedCatkinsID.Xue] = "snow",
    [ReedCatkinsID.Yue] = "month"
}

local Spine = {
    [ReedCatkinsID.Feng] = {icon = "spine/ui/fenghuang/prf_fenghuang", pos = {66.96, 86}, scale = 1.2}, --86
    [ReedCatkinsID.Hua] = {icon = "spine/ui/huawang/prf_huawang", pos = {90, 65.93}, scale = 0.9}, --7,130 0.8
    [ReedCatkinsID.Yue] = {icon = "spine/ui/yuewang/prf_yuewang", pos = {80, 0}, scale = 1},
    [ReedCatkinsID.Xue] = {icon = "spine/ui/jiuyinger/prf_jiuyinger", pos = {30.1, -3.5}, scale = 1.4}
}

local Effect = {
    [ReedCatkinsID.Feng] = _G.ConfigManager.ui_effect_cfg.ef_luhuahuanjing_feng,
    [ReedCatkinsID.Hua] = _G.ConfigManager.ui_effect_cfg.ef_luhuahuanjing_hua,
    [ReedCatkinsID.Xue] = _G.ConfigManager.ui_effect_cfg.ef_luhuahuanjing_xue,
    [ReedCatkinsID.Yue] = _G.ConfigManager.ui_effect_cfg.ef_luhuahuanjing_yue
}

local PrefsKey = "ReedCatkinsView"
local SweepKey = "ReedCatkinsViewSweep"

function ReedCatkinsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.curReedCatkinsData = nil
    self.Skills = nil
    self.Ball = {}
    self.Spine = {}
    self.AwardItems = {}
    self.levelList = {}
end

---界面的入口函数
---@param id ReedCatkinsID
function ReedCatkinsView:OnCreate()
    self.ReedCatkinsDatas = require("ReedCatkinsModel"):GetInstance().ReedCatkinsDatas
    self:InitBall()
    self:Init()
    self:AddListener("ReedCatkins", self.RefreshPanel, self)
    self:AddComponent(
        self.go_table.obj_gold,
        require("ResourceCompont").New(
            self.go_table.obj_gold,
            {
                _G.ResPropID.Coin,
                _G.ResPropID.Diamond,
                require "ReedCatkinsModel":GetInstance().customCfg[1][1]
            }
        )
    )
    local cfg =
        _G.ConfigManager.item_cfg[require "ReedCatkinsModel":GetInstance().customCfg[1][1]] or
        _G.ConfigManager.currency_type_cfg[require "ReedCatkinsModel":GetInstance().customCfg[1][1]]
    if cfg then
        self.go_table.aorrawimage_consumeIcon:LoadImage(
            cfg.Icon or cfg.icon,
            function()
                self.go_table.aorrawimage_consumeIcon:SetNativeSize()
            end
        )
    end

    self:InitEffect()
    TrackingPointModel:GetInstance():SetWindowStartTime(self.viewName, true)
    self.go_table.toggle_sweepAll.isOn = _G.PlayerPrefsManager.GetInt(SweepKey, 0) == 1
end

---初始化背景特效
function ReedCatkinsView:InitEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_ReedCatkinsView,
        self.go_table.obj_effect,
        function(trans)
            if _G.IsNil(self.go_table) then
                _G.DestroyObject(trans)
            end
        end
    )
end

function ReedCatkinsView:InitBall()
    for k, v in pairs(ReedCatkinsName) do
        self.Ball[k] = _G.GetAutoGoTable(self.go_table["obj_" .. v])
        _G.UIUtils.LoadEffectByCfg(
            Effect[k],
            self.Ball[k].obj_on,
            function(trans)
                if _G.IsNil(self.go_table) then
                    _G.DestroyObject(trans)
                    return
                end
                trans:SetAnchorPosition(-1, 10)
            end
        )
        -- _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg["ef_ReedCatkinsView_" .. v], self.Ball[k].obj_show)
    end
end

---界面初始化
function ReedCatkinsView:Init()
    self.isInited = false
    require("ReedCatkinsModel"):GetInstance():UpdateData()
    self.data = require("ReedCatkinsModel"):GetInstance().ReedCatkinsInfo
    self.go_table.scrollloophorizontal_Award:InitItemData(0, _G.handler(self, self.RefreshAwardList))
    self.curDayReedTypeID = 100000 + require("ReedCatkinsModel"):GetInstance().ReedCatkinsInfo.now_boss * 1000
    self.curReedTypeID = self.curDayReedTypeID
    self.go_table.scrollloopvectical_levelList:InitItemData(0, _G.handler(self, self.RefreshLevel))
    self:UpdateInfoDataAndPanel()
    self:UpdateBall(true)
    self:UpdateBossInfo()
    self:UpdateBossSkillPreview()
end
---刷新技能界面
function ReedCatkinsView:UpdateBossSkillPreview()
    self.SkillCfg = self.curReedCatkinsData.cfg.preview_skill
    if _G.table.isEmptyOrNil(self.SkillCfg) then
        return
    end
    if not self.SkillTrans then
        _G.GameUtil.ShowBossSkill(self.go_table.obj_skills, _G.handler(self, self.LoadSkillCall))
    else
        --  end
        -- if self.skillsCount ~= #self.SkillCfg then
        --     self.SkillTrans:UpdateCount(#self.SkillCfg)
        --     self.skillsCount = #self.SkillCfg
        -- else
        self.SkillTrans:UpdateAllItem()
    end
end
--endregion
function ReedCatkinsView:LoadSkillCall(skillTrans)
    local tb = _G.GetAutoGoTable(skillTrans)
    local layout = tb.obj_Content:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.GridLayoutGroup))
    layout.spacing = _G.Vector2(0, 33.9)
    layout.enabled = true
    self.SkillTrans = skillTrans:GetComponentE(_G.typeof(_G.CS.ScrollLoopVertical))
    self.SkillTrans:InitItemData(#self.SkillCfg, _G.handler(self, self.RefreshSkill))
    self.skillsCount = #self.SkillCfg
end
--endregion
function ReedCatkinsView:RefreshSkill(index, obj)
    local x = index + 1
    local id = self.SkillCfg[x]
    obj:SetName(obj:GetInstanceIDE() .. x)
    if id and id > 0 then
        local cfg = _G.ConfigManager.card_skills_cfg[id]
        if cfg then
            local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.ClickSkill, cfg.id))
            tb.aorrawimage_skill:LoadImage(
                cfg.icon,
                function(image)
                end
            )
            _G.GameUtil.SetActiveByCondition(obj, true)
        else
            _G.GameUtil.SetActiveByCondition(obj, false)
        end
    else
        _G.GameUtil.SetActiveByCondition(obj, false)
    end
end
---点击技能提示
function ReedCatkinsView:ClickSkill(go, isOn, skillId)
    require("CommonTipManager"):GetInstance():OpenSkillTip(skillId)
end
---刷新界面
function ReedCatkinsView:RefreshPanel()
    self.curDayReedTypeID = 100000 + require("ReedCatkinsModel"):GetInstance().ReedCatkinsInfo.now_boss * 1000
    self:ChangeReedType(self.curDayReedTypeID)
end

---获取当前
---@return ReedCatkinsID
function ReedCatkinsView:GetCurReedType()
    if self.curReedCatkinsData then
        local index = self.curReedCatkinsData.cfg.grade * 1000 + 100000
        for _, v in pairs(ReedCatkinsID) do
            if v == index then
                return v
            end
        end
    end
    return ReedCatkinsID.Feng
end

---更新界面信息及数据
---@param isNotUpdateData boolean 不更新当前数据
function ReedCatkinsView:UpdateInfoDataAndPanel(isNotUpdateData)
    if not isNotUpdateData then
        self:UpdateCurReedCatkinsData()
    end
    self:UpdateToggle()
    self:UpdatePanel()
end

---更新界面
function ReedCatkinsView:UpdatePanel()
    if self.isInited then
        self:UpdateBossInfo()
        self:UpdateBossSkillPreview()
    else
        self.isInited = true
    end
    self:CreateAwardList()
    if _G.table.count(self.curReedCatkinsData.cfg.sweep_condition) > 0 and not self.curReedCatkinsData.isFirst then
        if
            not _G.GlobalConditionManager.CheckCondition(
                self.curReedCatkinsData.cfg.sweep_condition[1],
                self.curReedCatkinsData.cfg.sweep_condition[2]
            )
         then
            self.go_table.aorbtn_sweep:SetGray(true)
        else
            self.go_table.aorbtn_sweep:SetGray(false)
        end
        self.go_table.obj_sweep:SetActiveE(1)
    else
        self.go_table.obj_sweep:SetActiveE(0)
    end
    self:UpdateTimes()
    self.go_table.aorrawimage_font:SetGray(self.curDayReedTypeID ~= self.curReedTypeID)
    self.go_table.aorbtn_challenge:SetGray(self.curDayReedTypeID ~= self.curReedTypeID)
    self.go_table.aorbtn_sweep:SetGray(self.curDayReedTypeID ~= self.curReedTypeID)
end
---更新挑战次数
function ReedCatkinsView:UpdateTimes()
    if self.curDayReedTypeID ~= self.curReedTypeID then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_free, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_consume, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_no, false)
        self.go_table.aortext_notType.text =
            _G.string.format(
            "%s天后开启",
            require "ReedCatkinsModel":GetInstance():GetDay((self.curReedTypeID - 100000) / 1000)
        )
    else
        self.go_table.aortext_notType.text = ""
        local isHave = self:CheckCanChallenge()
        local count = require "ReedCatkinsModel":GetInstance():GetFreeTimes()
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_free, count > 0)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_consume, count <= 0 and isHave)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_no, count <= 0 and not isHave)
        self.go_table.aortext_num.text =
            _G.string.format("%s/%s", count, require "ReedCatkinsModel":GetInstance().maxCount)
    end
end

---更新风花雪月的图标
function ReedCatkinsView:UpdateBall(isShow)
    local tb = self.Ball[self.curReedTypeID]
    _G.GameUtil.SetActiveByCondition(tb.obj_on, isShow)
    _G.GameUtil.SetActiveByCondition(tb.obj_off, not isShow)
    if self.Spine[self.curReedTypeID] then
        _G.GameUtil.SetActiveByCondition(self.Spine[self.curReedTypeID], isShow)
    end
end

---更新怪物立绘及技能
function ReedCatkinsView:UpdateBossInfo()
    ---@type card_cfg
    local cfg = _G.ConfigManager.card_cfg[self.curReedCatkinsData.cfg.preview_monster]
    if Spine[self.curReedTypeID] then
        self.go_table.aorrawimage_monster.color = _G.Color.New(1, 1, 1, 0)
        local ID = self.curReedTypeID
        if not self.Spine[self.curReedTypeID] and not self.isSpawn then
            self.isSpawn = true
            _G.PoolsManager:GetInstance():Spawn(
                Spine[self.curReedTypeID].icon,
                _G.ePoolType.Temporary,
                self.go_table.trans_spine,
                function(trans)
                    if _G.IsNil(self.go_table) then
                        _G.DestroyObject(trans)
                        return
                    end
                    self.Spine[ID] = trans
                    trans:SetAnchorPosition(Spine[self.curReedTypeID].pos[1], Spine[self.curReedTypeID].pos[2])
                    trans:SetLocalScaleXYZ(Spine[self.curReedTypeID].scale)
                    if self.curReedTypeID ~= ID then
                        _G.GameUtil.SetActiveByCondition(trans, false)
                    end
                    self.isSpawn = false
                end
            )
        end
    else
        self.go_table.aorrawimage_monster:LoadImage(
            cfg.Portrait,
            function(trans)
                self.go_table.aorrawimage_monster:SetNativeSize()
            end
        )
        self.go_table.aorrawimage_monster:SetGray(self.curReedCatkinsData.isLock)
    end
    --self:UpdateSkill()
end

---更新技能显示
function ReedCatkinsView:UpdateSkill()
    if not self.Skills then
        self.Skills = {
            _G.GetAutoGoTable(self.go_table.obj_skill1, _G.handler(self, self.OnClickSkill)),
            _G.GetAutoGoTable(self.go_table.obj_skill2, _G.handler(self, self.OnClickSkill)),
            _G.GetAutoGoTable(self.go_table.obj_skill3, _G.handler(self, self.OnClickSkill))
        }
    end
    for i = 1, 3 do
        local cfg = _G.ConfigManager.card_skills_cfg[self.curReedCatkinsData.cfg.preview_skill[i]]
        if cfg then
            if cfg.skill_type == "" then
                self.Skills[i].aorimage_sign:SetActiveE(0)
            else
                self.Skills[i].aorimage_sign.SpriteName = string.replace(cfg.skill_type, "Images/Icon/", "")
                self.Skills[i].aorimage_sign:SetActiveE(1)
            end
            self.Skills[i].aorimage_icon.SpriteName = cfg.id
        else
            _G.GameUtil.SetActiveByCondition(self.Skills[i].gameObject, false)
        end
    end
end

---点击技能
function ReedCatkinsView:OnClickSkill(go, isOn)
    local str = string.replace(go:GetParent():GetName(), "$_obj_skill", "")
    local index = tonumber(str)
    require("CommonTipManager"):GetInstance():OpenSkillTip(self.curReedCatkinsData.cfg.preview_skill[index])
