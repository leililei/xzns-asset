local TrackingPointModel = require("TrackingPointModel")
local RemoveEffect = _G.UIUtils.RemoveEffect

---@class ReedCatkinsView : UIBaseView    中文描述
---@field public go_table ReedCatkinsView_GoTable GoTable
---@field data instance_decoration.s2c_instance_decoration_info
