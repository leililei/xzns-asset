---@class ReedCatkinsGiftView : UIBaseView	中文描述
---@field public go_table ReedCatkinsGiftView_GoTable GoTable
local ReedCatkinsGiftView = _G.BaseClass("ReedCatkinsGiftView", _G.UIBaseView)
---@type ReedCatkinsModel
local ReedCatkinsModel
local ColorTools = _G.ColorTools
local bossScale = { 0.5, 0.44, 1, 0.44 }
local ReedCatkinsGiftType = _G.ReedCatkinsGiftType
local GetLangPackValue = _G.GetLangPackValue
function ReedCatkinsGiftView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.scrollloopvectical_items:InitItemData(0, _G.handler(self, self.RefreshGiftList))
end

---界面的入口函数
function ReedCatkinsGiftView:OnCreate()
    ReedCatkinsModel = require "ReedCatkinsModel":GetInstance()
    self.resource =
        self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, { 12 }))
    self.diamondNum = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.ResProp, _G.ResPropID.Diamond)
    self.giftList = {}
    self:Show()
    self:MoveToNext()
    self:AddListener("ReedCatkins", _G.handler(self, self.Show))
    ReedCatkinsModel:SetGiftKey()
end

function ReedCatkinsGiftView:Show()
    if self.boss and self.boss == ReedCatkinsModel.ReedCatkinsInfo.now_boss then
        return
    end
    self.boss = ReedCatkinsModel.ReedCatkinsInfo.now_boss
    self.giftDataList = ReedCatkinsModel:GetGiftDatas(self.boss)
    self.maxGiftCount = #self.giftDataList
    ---@type system_decoration_cfg
    local cfg = _G.ConfigManager.system_decoration_cfg[self.giftDataList[1].sectionId]
    self.go_table.scrollloopvectical_items:UpdateCount(self.maxGiftCount)
    ---@type card_cfg
    local cardCfg = _G.ConfigManager.card_cfg[cfg.preview_monster]
    self.go_table.aorrawimage_icon:LoadImage(
        cardCfg.Portrait,
        function(raw)
            if raw then
                raw:SetNativeSize()
                raw:SetLocalScaleXYZ(bossScale[self.boss])
            end
        end
    )
end

function ReedCatkinsGiftView:RefreshGiftList(index, obj)
    local id = obj:GetInstanceIDE()
    local tb = self.giftList[id]
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.ItemOnclick, tb))
        tb.scrollloophorizontal_awardList:InitItemData(0, _G.handlerbind(self, self.RefreshAwardList, tb))
    end
    local data = self.giftDataList[index + 1]
    tb.data = data
    local cfg = data.storeCfg
    local x = index + 1
    tb.index = index + 1
    ----@type HellGuardTaskData
    tb.aorimage_up:SetActiveE(x ~= 1 and 1 or 0)
    tb.aorimage_down:SetActiveE(x ~= self.maxGiftCount and 1 or 0)
    if data.type == ReedCatkinsGiftType.RMB then
        tb.wasBuy = ReedCatkinsModel:GetBuyCount(data.type, data.id) < cfg.count_limit
    else
        tb.wasBuy = ReedCatkinsModel:GetBuyCount(data.type, data.sectionId) < cfg.count_limit
    end
    local isPass = _G.GlobalConditionManager.CheckConditionByArray(cfg.conditions)
    if tb.wasBuy then
        tb.aorbtn_buy:SetActiveE(1)
        if isPass then
            tb.aorbtn_buy:SetGray(false)
        else
            tb.aorbtn_buy:SetGray(true)
        end
        tb.obj_soldOut:SetActiveE(0)
        tb.aortext_cash:SetActiveE(data.type == ReedCatkinsGiftType.RMB and 1 or 0)
        tb.aortext_diamond:SetActiveE(data.type == ReedCatkinsGiftType.Diamond and 1 or 0)
        tb.aortext_limit:SetActiveE(1)
    else
        tb.aorbtn_buy:SetActiveE(0)
        tb.obj_soldOut:SetActiveE(1)
        tb.aortext_cash:SetActiveE(0)
        tb.aortext_diamond:SetActiveE(0)
        tb.aortext_limit:SetActiveE(0)
        tb.obj_cash:SetActiveE(0)
        tb.obj_diamond:SetActiveE(0)
    end
    ---@type system_decoration_cfg
    local sectionCfg = _G.ConfigManager.system_decoration_cfg[data.sectionId]
    tb.aortext_level.text = GetLangPackValue(sectionCfg.layer)
    if data.type == ReedCatkinsGiftType.RMB then
        if tb.wasBuy then
            tb.obj_cash:SetActiveE(1)
            tb.obj_diamond:SetActiveE(0)
        end
        _G.GameUtil.SetPriceByChannel(cfg.original_id, tb.aortext_cashnum, 90028800008)
        _G.GameUtil.SetPriceByChannel(cfg.price_id, tb.aortext_cash)
        tb.aortext_limit.text =
            GetLangPackValue(90021600007, ReedCatkinsModel:GetBuyCount(data.type, data.id), cfg.count_limit)
        if isPass then
            tb.aortext_cash.color = ColorTools.FormatColorByString("914801")
        else
            tb.aortext_cash.color = ColorTools.FormatColorByString("444444")
        end
    elseif data.type == ReedCatkinsGiftType.Diamond then
        if tb.wasBuy then
            tb.obj_cash:SetActiveE(0)
            tb.obj_diamond:SetActiveE(1)
        end

        local finalPriceal = require "MallManager":GetInstance():GetFinalPrice(cfg.original_id)
        local finalPricece = require "MallManager":GetInstance():GetFinalPrice(cfg.price_id)

        tb.aortext_diamondnum.text = finalPriceal
        tb.aortext_diamond.text = finalPricece
        if self.diamondNum >= finalPricece then
            tb.aortext_diamond.color = ColorTools.FormatColorByString("9F6145")
        else
            tb.aortext_diamond.color = ColorTools.FormatColorByString("FF0000")
        end
        if not isPass then
            tb.aortext_diamond.color = ColorTools.FormatColorByString("444444")
        end
        tb.aortext_limit.text =
            GetLangPackValue(90021600007, ReedCatkinsModel:GetBuyCount(data.type, data.sectionId), cfg.count_limit)
    end
    tb.obj_discount:SetActiveE(cfg.discount > 0 and 1 or 0)
    if cfg.discount > 0 then
        tb.aortext_discount.text = cfg.discount / 100 .. "%"
    end
    tb.awardDatas = cfg.goods

    local count = #cfg.goods
    tb.scrollloophorizontal_awardList:UpdateCount(count)
    if not tb.scroll then
        tb.scroll = tb.scrollloophorizontal_awardList:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect))
    end
    tb.scroll.enabled = count > 4
end

function ReedCatkinsGiftView:RefreshAwardList(index, obj, tb)
    obj:RemoveAllChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        tb.awardDatas[index + 1],
        obj,
        function(tran)
            tran.gameObject:SetLocalPosition(0, 0, 0)
            tran.gameObject:SetLocalScaleXYZ(0.83)
            tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
            if tran.SetGou then
                tran:SetGou(not tb.wasBuy)
            end
        end
    )
end

---界面的销毁函数
function ReedCatkinsGiftView:OnDestroy()
end

---按钮点击事件在这里派发
function ReedCatkinsGiftView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_Close then
        self:Close()
    end
end

function ReedCatkinsGiftView:ItemOnclick(go, isOn, tb)
    local cfg = tb.data.storeCfg
    if not _G.GlobalConditionManager.CheckConditionByArray(cfg.conditions) then
        _G.PopWindowManager:GetInstance():ShowAllTips(310119)
        return
    end

    local finalPrice = require "MallManager":GetInstance():GetFinalPrice(cfg.price_id)
    if tb.data.type == ReedCatkinsGiftType.Diamond and finalPrice > self.diamondNum then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ResPropID.Diamond)
        return
    end
    local id = tb.data.type == ReedCatkinsGiftType.Diamond and tb.data.sectionId or tb.data.id
    ReedCatkinsModel:BuyGift(
        id,
        tb.data.type,
        tb.data.id,
        function()
            self.diamondNum =
                _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.ResProp, _G.ResPropID.Diamond)
            self.go_table.scrollloopvectical_items:UpdateItemSingle(tb.index - 1)
            self:MoveToNext()
        end
    )
end

---移动到下一个
function ReedCatkinsGiftView:MoveToNext()
    local index = -1
    for i = 1, self.maxGiftCount do
        local data = self.giftDataList[i]
        local id = self.giftDataList[i].type == ReedCatkinsGiftType.Diamond and data.sectionId or data.id
        if ReedCatkinsModel:CheckIsPass(data.sectionId) then
            if ReedCatkinsModel:GetBuyCount(data.type, id) < data.storeCfg.count_limit then
                index = i - 1
                break
            end
        else
            index = i - 1
            break
        end
    end
    if index < 0 then
        return
    end
    self.go_table.scrollloopvectical_items:ScrollToIndex(index)
end

return ReedCatkinsGiftView
