require "ReedCatkinsNet"
local ReedCatkinsData = require "ReedCatkinsData"
---@class ReedCatkinsModel	中文描述
---@field ReedCatkinsInfo instance_decoration.s2c_instance_decoration_info
---@field ReedCatkinsDatas ReedCatkinsData[] 所有的关卡数据
---@field curReedCatkinsData ReedCatkinsData 当前进行挑战的关卡数据
---@field giftDataList  table 礼包数据
local ReedCatkinsModel = _G.BaseClass("ReedCatkinsModel", _G.GameDataModelBase)
local GiftKey = "ReedCatkinsGigtKey"
---@return ReedCatkinsModel ReedCatkinsModel
function ReedCatkinsModel:GetInstance()
    return self.super.GetInstance(self)
end

---类的构造函数
function ReedCatkinsModel:__init()
    self.curFunctionOpenID = 54
    self.curReedCatkinsData = nil
    self.maxCount = _G.ConfigManager.system_cfg[203].count_limit
    self.customCfg = _G.ConfigManager.discrete_cfg[104701]
end

---类的析构函数
function ReedCatkinsModel:Dispose()
    self.ReedCatkinsInfo = nil
    self.curReedCatkinsData = nil
    self.ReedCatkinsDatas = nil
end

function ReedCatkinsModel:GetDataFormServer()
    self:GetReedCatkinsInfo()
end

---获取芦花幻境信息回调
---@param msg instance_decoration.s2c_instance_decoration_info
function ReedCatkinsModel:GetReedCatkinsInfoCall(msg, callback)
    if self.ReedCatkinsInfo then
        self.ReedCatkinsInfo.boss_list = msg.info.boss_list
        self.ReedCatkinsInfo.now_boss = msg.info.now_boss
        self.ReedCatkinsInfo.coin_store = msg.info.coin_store
        self.ReedCatkinsInfo.rmb_store = msg.info.rmb_store
        self.fightTimes = msg.info.fight_times
        self:InitGiftInfo()
        _G.Events:GetInstance():Broadcast("ReedCatkins")
        self:ParseData()
    else
        self.ReedCatkinsInfo = msg.info
        self.fightTimes = msg.info.fight_times
        self:InitReedCatkinsData()
        self:InitGiftInfo()
        self:ParseData()
    end
    if callback then
        callback()
    end

    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.ReedCatkins.id)
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.ReedCatkinsPack.id)
end

---初始化芦花幻境数据
function ReedCatkinsModel:InitReedCatkinsData()
    self.ReedCatkinsDatas = {}
    self.giftDataList = {}
    local decorationCfg = _G.ConfigManager.system_decoration_cfg
    local keys = _G.table.keys(decorationCfg)
    _G.table.sort(keys)
    ---@type system_decoration_cfg
    local cfg
    local insert = _G.table.insert
    for i = 1, #keys do
        cfg = decorationCfg[keys[i]]
        self.ReedCatkinsDatas[keys[i]] = ReedCatkinsData.Create(cfg)
        if not self.giftDataList[cfg.grade] then
            self.giftDataList[cfg.grade] = {}
        end
        if cfg.rmb > 0 then
            insert(
                self.giftDataList[cfg.grade],
                {
                    id = cfg.rmb,
                    type = _G.ReedCatkinsGiftType.RMB,
                    sectionId = _G.ConfigManager.store_extra_cfg[cfg.rmb].conditions[1][2],
                    storeCfg = _G.ConfigManager.store_extra_cfg[cfg.rmb]
                }
            )
        end
        if cfg.diamond > 0 then
            insert(
                self.giftDataList[cfg.grade],
                {
                    id = cfg.diamond,
                    type = _G.ReedCatkinsGiftType.Diamond,
                    sectionId = keys[i],
                    storeCfg = _G.ConfigManager.store_exchange_cfg[cfg.diamond]
                }
            )
        end
    end
end

---初始化礼包信息
function ReedCatkinsModel:InitGiftInfo()
    self.buyList = { {}, {} }
    if not self.isBuyList then
        self.isBuyList = {}
    end
    if not self.ReedCatkinsInfo then
        return
    end
    local datas = { award = { item = {} } }
    local StorageManager = _G.StorageManager:GetInstance()
    local insert = _G.table.insert
    if self.ReedCatkinsInfo.coin_store then
        for _, v in pairs(self.ReedCatkinsInfo.coin_store) do
            self.buyList[_G.ReedCatkinsGiftType.Diamond][v.k] = v.v
            if self.isBuyList[v.k] then
                local cfg = _G.ConfigManager.store_exchange_cfg[v.k]
                if cfg then
                    for _, v2 in pairs(cfg.goods) do
                        insert(datas.award.item, StorageManager:SimulationAward(v2[1], v2[2], { v2[3] }))
                    end
                end
                self.isBuyList[v.k]()
                self.isBuyList[v.k] = nil
            end
        end
    end
    if self.ReedCatkinsInfo.rmb_store then
        for _, v in pairs(self.ReedCatkinsInfo.rmb_store) do
            self.buyList[_G.ReedCatkinsGiftType.RMB][v.k] = v.v
            if self.isBuyList[v.k] then
                local cfg = _G.ConfigManager.store_extra_cfg[v.k]
                if cfg then
                    for _, v2 in pairs(cfg.goods) do
                        insert(datas.award.item, StorageManager:SimulationAward(v2[1], v2[2], { v2[3] }))
                    end
                end
                self.isBuyList[v.k]()
                self.isBuyList[v.k] = nil
            end
        end
    end
    if not _G.table.isEmptyOrNil(datas.award.item) then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, datas)
    end
end

---获取芦花幻境信息
function ReedCatkinsModel:GetReedCatkinsInfo(callback)
    require("ReedCatkinsNet"):GetInstance():GetReedCatkinsInfo(
        _G.handlerbind(self, self.GetReedCatkinsInfoCall, callback)
    )
end

---检测任务是否完成
function ReedCatkinsModel:IsComplete(type, sid)
    if not self.ReedCatkinsInfo.boss_list or not self.ReedCatkinsInfo.boss_list[type] then
        return false
    end
    return sid <= self.ReedCatkinsInfo.boss_list[type].high_section
end

---战斗胜利
function ReedCatkinsModel:FightWin(isReturn)
    --self:UpdateTimes()

    self.curReedCatkinsData.isFirst = false
    if self:GetFreeTimes() > 0 then
        self.fightTimes = self.fightTimes + 1
    else
        _G.StorageManager:GetInstance():ConsumeItem(self.customCfg[1][1], nil, self.customCfg[1][2])
    end

    if not self.ReedCatkinsInfo.boss_list then
        self.ReedCatkinsInfo.boss_list = {}
    end
    if not self.ReedCatkinsInfo.boss_list[self.curReedCatkinsData.cfg.grade] then
        self.ReedCatkinsInfo.boss_list[self.curReedCatkinsData.cfg.grade] = {
            sid = self.curReedCatkinsData.cfg.grade,
            high_section = 0
        }
    end
    self.ReedCatkinsInfo.boss_list[self.curReedCatkinsData.cfg.grade].high_section = self.curReedCatkinsData.sid

    local data = self.ReedCatkinsDatas[self.curReedCatkinsData.sid + 1]
    if data then
        data:ChangeLock()
    end
    if isReturn then
        local View = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ReedCatkinsView.Name)
        if View then
            View:RefreshPanel()
        end
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ReedCatkinsView.Name)
    end
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.ReedCatkins.id)
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.ReedCatkinsPack.id)
end

---战斗失败
function ReedCatkinsModel:FightLose(isReturn)
    if isReturn then
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ReedCatkinsView.Name)
    end
end

---开始芦花幻境挑战
function ReedCatkinsModel:ChallengeReedCatkins(ID, sid)
    self.curReedCatkinsData = self.ReedCatkinsDatas[sid]
    self.curReedTypeID = ID
    self:StartEmbattle()
end

---退出界面 清理下布阵数据
function ReedCatkinsModel:ClearEmbattle()
    require("EmbattleModel"):GetInstance():ClearEmbattleData(_G.EmbattleType.ReedCatkins)
end

---开始布阵
function ReedCatkinsModel:StartEmbattle()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    --require("EmbattleModel"):GetInstance():ClearEmbattleData(_G.EmbattleType.ReedCatkins)
    require("EmbattleController"):GetInstance():OpenEmbattle(
        _G.EmbattleType.ReedCatkins,
        _G.EmbattleSaveType.server,
        false,
        _G.EmbattleControllerItemType.pve,
        _G.handler(self, self.ExitEmbattle),
        _G.handler(self, self.EnterFight),
        self.curReedCatkinsData.cfg.monster
    )
    -- self:FightWin()
end

---监听界面打开
---@param name string 界面名称
function ReedCatkinsModel:OnEmbattleViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ReedCatkinsView.Name)
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    end
end

function ReedCatkinsModel:ExitEmbattle()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ReedCatkinsView.Name, self.curReedTypeID)
end

---进入战斗
function ReedCatkinsModel:EnterFight()
    if self.curReedCatkinsData.isLock then
        _G.PopWindowManager:GetInstance():Show(94)
        return
    end
    _G.BattleManager:GetInstance():EnterFight(_G.BattleControllerType.ReedCatkins, self.curReedCatkinsData.sid)
end

---重新开始当前关卡
function ReedCatkinsModel:ReplayCurSection()
    self:StartEmbattle()
end

function ReedCatkinsModel:ExitSectionSelf()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ReedCatkinsView.Name, self.curReedTypeID)
end

---检测是否能挑战
function ReedCatkinsModel:CheckCanChallenge()
    return _G.StorageManager:GetInstance():GetItemCountBySid(self.customCfg[1][1]) >= self.customCfg[1][2]
end

function ReedCatkinsModel:UpdateData()
    for _, v in pairs(self.ReedCatkinsDatas) do
        v:ChangeLock()
    end
end

function ReedCatkinsModel:OnSixClockUpdate(endcall)
    _G.StorageManager:GetInstance():GetExChangeData()
    self.super.OnSixClockUpdate(self, endcall)
end

---获取免费次数
function ReedCatkinsModel:GetFreeTimes()
    if nil == self.fightTimes then
        return 0
    end
    return self.maxCount - self.fightTimes
end

function ReedCatkinsModel:GetDay(type)
    if not self.typeDay then
        self.typeDay = {}
        for i, v in ipairs(_G.ConfigManager.discrete_cfg[104702][1]) do
            self.typeDay[v] = i
        end
    end
    if self.typeDay[self.ReedCatkinsInfo.now_boss] > self.typeDay[_G.math.floor(type)] then
        return 4 - self.typeDay[self.ReedCatkinsInfo.now_boss] + self.typeDay[_G.math.floor(type)]
    else
        return self.typeDay[_G.math.floor(type)] - self.typeDay[self.ReedCatkinsInfo.now_boss]
    end
end

function ReedCatkinsModel:UpdateMaxFightsCount()
    local data = require "PrivilegeManager":GetInstance():GetPrivilegeData({ _G.PrivilegeType.VIP.luhuahuanjing })
    if not _G.table.isEmptyOrNil(data) then
        self.maxCount = _G.ConfigManager.system_cfg[203].count_limit + data[1]
    else
        self.maxCount = _G.ConfigManager.system_cfg[203].count_limit
    end
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.ReedCatkins.id)
end

---获取礼包购买次数
---@param type ReedCatkinsGiftType 礼包类型
---@param id number 礼包id
function ReedCatkinsModel:GetBuyCount(type, id)
    return self.buyList[type][id] or 0
end

---@param id number 礼包id|魂玉 关卡id
---@param type number 礼包类型 1RMB 2魂玉
---@param giftid number 礼包id
function ReedCatkinsModel:BuyGift(id, type, giftid, call)
    if type == _G.ReedCatkinsGiftType.RMB then
        ---@type store_extra_cfg
        local cfg = _G.ConfigManager.store_extra_cfg[giftid]
        if not self.isBuyList then
            self.isBuyList = {}
        end
        self.isBuyList[id] = call
        _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
        require "MallManager":GetInstance():BuyActiveGift(cfg.price_id, nil, id)
    else
        require "ReedCatkinsNet":GetInstance():BuyGift(
            { sid = id },
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                ---@type store_extra_cfg
                local cfg = _G.ConfigManager.store_exchange_cfg[giftid]
                if not self.buyList[type][id] then
                    self.buyList[type][id] = 0
                end
                self.buyList[type][id] = self.buyList[type][id] + 1
                local finalPrice = require "MallManager":GetInstance():GetFinalPrice(cfg.price_id)
                _G.StorageManager:GetInstance():ConsumeItem(_G.ResPropID.Diamond, nil, finalPrice)
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                if call then
                    call()
                end
            end
        )
    end
end

function ReedCatkinsModel:OnMallCashListener(data)
    if not data then
        return
    end
    if self.isBuyList[data.sid] then
        local tb = self.buyList[_G.ReedCatkinsGiftType.RMB]
        if not tb[data.sid] then
            tb[data.sid] = 0
        end
        tb[data.sid] = tb[data.sid] + 1
        self.isBuyList[data.sid]()
        self.isBuyList[data.sid] = nil
        _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    end
end

function ReedCatkinsModel:ReConnect(call)
    self:InitData(call)
end

---检测是否通关(用于礼包)
function ReedCatkinsModel:CheckIsPass(sid)
    if not self.ReedCatkinsInfo then
        return false
    end
    ---@type system_decoration_cfg
    local cfg = _G.ConfigManager.system_decoration_cfg[sid]
    if not cfg then
        return false
    end
    if cfg.grade ~= self.ReedCatkinsInfo.now_boss then
        for _, v in pairs(_G.ConfigManager.system_decoration_cfg) do
            if v.grade == self.ReedCatkinsInfo.now_boss and cfg.difficulty == v.difficulty then
                sid = v.id
                break
            end
        end
    end
    if self.ReedCatkinsDatas[sid] then
        return not self.ReedCatkinsDatas[sid].isFirst
    end
    return false
end

---获取礼包数据
function ReedCatkinsModel:GetGiftDatas(type)
    return self.giftDataList[type]
end

---检测是否有可购买礼包
function ReedCatkinsModel:CheckCanBuyGift()
    local datas = self:GetGiftDatas(self.ReedCatkinsInfo.now_boss)
    if not datas then
        return false
    end
    local CheckConditionByArray = _G.GlobalConditionManager.CheckConditionByArray
    local id
    for _, v in ipairs(datas) do
        id = v.id
        if v.type == _G.ReedCatkinsGiftType.Diamond then
            id = v.sectionId
        end
        if CheckConditionByArray(v.storeCfg.conditions) and self:GetBuyCount(v.type, id) < v.storeCfg.count_limit then
            return true
        end
    end
    return false
end

function ReedCatkinsModel:GetMaxGiftId()
    local datas = self:GetGiftDatas(self.ReedCatkinsInfo.now_boss)
    if not datas then
        return -1
    end
    local CheckConditionByArray = _G.GlobalConditionManager.CheckConditionByArray
    local check = -1
    for i, v in ipairs(datas) do
        if CheckConditionByArray(v.storeCfg.conditions) then
            if i > check then
                check = i
            end
        else
            break
        end
    end
    return check
end

---检测可购买红点
function ReedCatkinsModel:CheckBuyGiftRedPoint()
    if not self.ReedCatkinsInfo then
        return false
    end
    if _G.PlayerPrefsManager.GetInt(GiftKey .. self.ReedCatkinsInfo.now_boss, -1) >= self:GetMaxGiftId() then
        return false
    end
    return self:CheckCanBuyGift()
end

---设置礼包key
function ReedCatkinsModel:SetGiftKey()
    _G.PlayerPrefsManager.SetInt(GiftKey .. self.ReedCatkinsInfo.now_boss, self:GetMaxGiftId())
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.ReedCatkinsPack.id)
end

return ReedCatkinsModel
