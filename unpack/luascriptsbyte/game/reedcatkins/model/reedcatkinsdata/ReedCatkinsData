---@class ReedCatkinsData	芦花幻境数据
---@field sid number 难度的sid
---@field cfg system_decoration_cfg_Item
---@field isFirst boolean 关卡是否首次通关
---@field reward table 通关奖励
---@field isLock boolean 是否解锁(根据等级及上个关卡是否通关)
local ReedCatkinsData = _G.BaseClass("ReedCatkinsData")

---类的构造函数
function ReedCatkinsData:__init()
    self.cfg = nil
    self.isFirst = true
    self.isLock = true
end

---类的析构函数
function ReedCatkinsData:Dispose()
end

---解析数据
---@param data system_decoration_cfg
function ReedCatkinsData:Parse(data)
    self.sid = data.id
    self.cfg = data
    self.isFirst = not require("ReedCatkinsModel"):GetInstance():IsComplete(data.grade, data.id)
    if data.pre_id > 0 then
        if
            data.limit_condition[1] and
                not _G.GlobalConditionManager.CheckCondition(data.limit_condition[1], data.limit_condition[2])
         then
            if data.limit_condition[1] == 4 then
                local cfg = _G.ConfigManager.afk_cfg[data.limit_condition[2]]
                if cfg then
                    self.lockStr = _G.string.format(_G.LangUtil.GetLangPackValue(90022900050), cfg.chapter, cfg.section)
                end
            elseif data.limit_condition[1] == 1 then
                self.lockStr = _G.string.format(_G.LangUtil.GetLangPackValue(90022900052), data.limit_condition[2])
            else
                self.lockStr =
                    _G.FunctionManager:GetInstance():GetStrWithType(data.limit_condition[1], data.limit_condition[2])
            end
            self.isLock = true
        elseif not require("ReedCatkinsModel"):GetInstance():IsComplete(data.grade, data.pre_id) then
            self.lockStr = _G.LangUtil.GetLangPackValue(90022900062)
            self.isLock = true
        else
            self.isLock = false
        end
    else
        if
            data.limit_condition[1] and
                not _G.GlobalConditionManager.CheckCondition(data.limit_condition[1], data.limit_condition[2])
         then
            if data.limit_condition[1] == 4 then
                local cfg = _G.ConfigManager.afk_cfg[data.limit_condition[2]]
                if cfg then
                    self.lockStr = _G.string.format(_G.LangUtil.GetLangPackValue(90022900050), cfg.chapter, cfg.section)
                end
            elseif data.limit_condition[1] == 1 then
                self.lockStr = _G.string.format(_G.LangUtil.GetLangPackValue(90022900052), data.limit_condition[2])
            else
                self.lockStr =
                    _G.FunctionManager:GetInstance():GetStrWithType(data.limit_condition[1], data.limit_condition[2])
            end
            self.isLock = true
        else
            self.isLock = false
        end
    end
    self.reward = data.preview_reward
end

---当上个关卡通关时解锁下个关卡
function ReedCatkinsData:ChangeLock()
    if not self.isLock then
        return
    end
    if not self.cfg.limit_condition[1] then
        self.isLock = false
    elseif _G.GlobalConditionManager.CheckCondition(self.cfg.limit_condition[1], self.cfg.limit_condition[2]) then
        if self.cfg.pre_id > 0 and require("ReedCatkinsModel"):GetInstance():IsComplete(self.cfg.grade, self.cfg.pre_id) then
            self.isLock = false
        elseif self.cfg.pre_id <= 0 then
            self.isLock = false
        end
    end
end

function ReedCatkinsData:GetLockStr()
    return self.lockStr
end

---创建数据
---@param data system_decoration_cfg_Item
---@return ReedCatkinsData
function ReedCatkinsData.Create(data)
    local item = ReedCatkinsData.New()
    item:Parse(data)
    return item
end
return ReedCatkinsData
