---@class ReedCatkinsNet : BaseGameNet	通信协议
local ReedCatkinsNet = _G.BaseClass("ReedCatkinsNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return ReedCatkinsNet ReedCatkinsNet
function ReedCatkinsNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求获取芦花幻境信息
---@param callback function 完成回调
function ReedCatkinsNet:GetReedCatkinsInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_instance_decoration_info
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---开始芦花幻境挑战
---@param pbData instance_decoration.c2s_instance_decoration_fight PB数据
---@param callback function 完成回调
function ReedCatkinsNet:ChallengeReedCatkins(pbData, callback)
    local item = _G.ConfigManager.net_map.game_instance_decoration_fight
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
    return port
end

---获取芦花幻境boss难度伤害
------@param pbData instance_decoration.c2s_instance_sweep PB数据
---@param callback function 完成回调
function ReedCatkinsNet:SweepReedCatkins(pbData, callback)
    local item = _G.ConfigManager.net_map.game_instance_decoration_sweep
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---芦花幻境扫荡
---@param callback function 完成回调
function ReedCatkinsNet:GetBossDamage(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_instance_decoration_get_damage
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---芦花幻境扫荡
---@param callback function 完成回调
function ReedCatkinsNet:BuyGift(pbData,callback)
    local item = _G.ConfigManager.net_map.game_instance_decoration_buy_store
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function ReedCatkinsNet:CallBack(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type ReedCatkinsNet
return ReedCatkinsNet
