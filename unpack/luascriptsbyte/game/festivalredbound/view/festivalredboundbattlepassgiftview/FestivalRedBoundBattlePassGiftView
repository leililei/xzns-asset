---@class FestivalRedBoundBattlePassGiftView : UIBaseView  下边栏菜单
---@field go_table MineUpgrateView_GoTable
local FestivalRedBoundBattlePassGiftView = _G.BaseClass("FestivalRedBoundBattlePassGiftView", _G.UIBaseView)
local FestivalRedBoundModel

function FestivalRedBoundBattlePassGiftView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function FestivalRedBoundBattlePassGiftView:OnCreate(activity)
    self.activity = activity 
    FestivalRedBoundModel = require "FestivalRedBoundModel":GetInstance()
    self:UpdateView()
end

---刷新数据
function FestivalRedBoundBattlePassGiftView:FreshData()
    self.awardList = FestivalRedBoundModel:GetBattleGift(self.activity:GetActivityID())
end

function FestivalRedBoundBattlePassGiftView:UpdateView()
    self:FreshData()
    self.go_table.obj_newItem1:ClearChildren()
    for k, v in ipairs(self.awardList) do 
        local awardT
        if v.type[1] == 0 then 
            awardT = {v.type[4], v.type[5]}
        else 
            awardT = v.type
        end
        local _, storageId = _G.StorageManager:GetInstance():CheckSidType(awardT[1])
        _G.StorageManager:GetInstance():GetItemBaseView(
            awardT[1],
            awardT[2],
            self.go_table.obj_newItem1,
            function(item)
                if _G.IsNil(self.go_table) then
                    _G.DestroyObject(item.go_table.gameObject)
                    return
                end
                item.go_table.gameObject:SetLocalScaleXYZ(0.8)
                if item.ShowNumText then
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
            end
        )
    end
    self.battleActivitys =
        require "ActivitySynManager":GetInstance():GetChildAcitivity(10027, self.activity:GetJumpType())
    if self.battleActivitys then 
        self.activityTypeLua = self.battleActivitys:GetActivityTypeCls()
    end
    if self.activityTypeLua and self.activityTypeLua:GetIsUp(self.battleActivitys:GetActivityID()) then 
        self.go_table.aorbtn_comfirm:SetActiveE(1)
        self.go_table.aorbtn_buy:SetActiveE(0)
    else 
        self.go_table.aorbtn_comfirm:SetActiveE(0)
        self.go_table.aorbtn_buy:SetActiveE(1)
    end
end

---按钮点击事件在这里派发
function FestivalRedBoundBattlePassGiftView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close1 then
        self:Close()
    elseif go == self.go_table.aorbtn_comfirm then 
        if #self.awardList == 0 then 
            self:Close()
            return 
        end
        local msg = {id = self.activity:GetActivityID()}
        FestivalRedBoundModel:GetExtraAward(msg, function(msg)
            if msg.ack == 1 then 
                self.activity.typeClass:RefreshRedPoint()
                self:Close()
            end 
        end)
    elseif go == self.go_table.aorbtn_buy then     
        if self.battleActivitys then 
            self.battleActivitys:GetActivityTypeCls():OnEnterActivity()
        end 
    end
end

function FestivalRedBoundBattlePassGiftView:OnDestroy()
    self:RemoveAllListener()
end

return FestivalRedBoundBattlePassGiftView
