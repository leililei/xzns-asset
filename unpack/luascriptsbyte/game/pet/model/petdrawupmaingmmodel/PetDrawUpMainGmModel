local base = require "ActivitySynTypeBase"
---@class PetDrawUpMainGmModel : ActivitySynTypeBase	中文描述
local PetDrawUpMainGmModel = _G.BaseClass("PetDrawUpMainGmModel", base)

function PetDrawUpMainGmModel:OnHandleGMData(info)
    self:ParseData(info)
end

function PetDrawUpMainGmModel:ParseData(info)
    self.activity = self.curActivityClass
    require "PetDrawUpMainModel":GetInstance():ParseActivityData(info.pet_draw, self.curActivityClass)
    base.ParseData(self)
end

---进入活动主体
function PetDrawUpMainGmModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.PetDrawUpMainView.Name, self.activity)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

---领取奖励
---@param callback function 回调
function PetDrawUpMainGmModel:GetAward(index, callback)
    self:GetActivityAward(index, callback)
end

---10014:礼包 10007：任务 10027：战令
function PetDrawUpMainGmModel:GetOtherActivityRedPointIds()
    return { 10027, 10007, 10014 }
end

---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function PetDrawUpMainGmModel:InitRedPointTree()
    self.checkRedPointFunc = { self.CheckRedPoint, self.CheckRedPointPackGift }
    self.redpointTree = { {2}, false }
end

function PetDrawUpMainGmModel:CheckRedPoint()
    if self.activity then
        return require "PetDrawUpMainModel":GetInstance():CheckActivityRedPoint(self.activity.activityID)
    end
    return 0
end

---礼包红点
function PetDrawUpMainGmModel:CheckRedPointPackGift()
    if self.activity then
        return require "PetDrawUpMainModel":GetInstance():PackGiftRedPoint(self.activity.activityID)
    end
    return 0
end

---刷新奖励红点
function PetDrawUpMainGmModel:RefreshRedPoint(param)
    param = param or 1
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(param))
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function PetDrawUpMainGmModel:CheckRedPointNumChild(index, _)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---自身活动代币增加（如锻造豪礼）
---@return table MallManager监听充值回调需要展示活动代币获得
function PetDrawUpMainGmModel:SetCoin(giftId)
    return require "PetDrawUpMainModel":GetInstance():SetMallCoin(self.activity.activityID, giftId)
end

---礼包购买次数增加
function PetDrawUpMainGmModel:SetItemBuyTimes(giftId)
    require "PetDrawUpMainModel":GetInstance():AddPackGiftBuyTimes(self.activity.activityID, giftId)
end

---设置主界面“新”字样式
function PetDrawUpMainGmModel:SetNewTb(go_table)
    go_table.aorimage_new:SetActiveE(1)
end

return PetDrawUpMainGmModel