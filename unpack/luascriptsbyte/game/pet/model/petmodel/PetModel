end

---销毁对象时,析构函数
function PetModel:Dispose()
    for _, v in pairs(self.pets) do
        v:Dispose()
    end
    self.pets = nil
end

---通过battle_skill_cfg反查pet_cfg及其星级
---@param skillId number card_skill_cfg.id
---@return pet_cfg,number
function PetModel:GetPetByCardSkillId(skillId)
    if not self.cardSkillMapiing then
        ---@type table<any,{cfg: pet_cfg, star: number}> @缓存card_skill_cfg到pet_cfg的映射
        self.cardSkillMapiing = {}

        for _, cfg in pairs(_G.ConfigManager.pet_cfg) do
            for star, id in pairs(cfg.skill_id) do
                self.cardSkillMapiing[id] = { cfg = cfg, star = star - 1 }
            end
        end
    end

    local info = self.cardSkillMapiing[skillId]
    if info then
        return info.cfg, info.star
    end
    return nil, 0
end

---通过碎片id获取宠物的id
function PetModel:GetPetIdByPropId(propId)
    return self.petRelationShipList[propId]
end

---获取升星进度
function PetModel:GetUpStarByPropId(propId)
    local sid = self:GetPetIdByPropId(propId)
    local petData = self.pets[sid]
    if petData:IsMaxStar() then
        return true, 0
    end

    return false, petData:GetUpCostNum()
end

function PetModel:BuySkillIdShowPetSkill(skillid)
    local petcfg,star=self:GetPetByCardSkillId(skillid)
    local petData=PetData.New(petcfg.id)
    petData.star=star
    petData.active=false
    local CommonTipView=_G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.CommonTipView.Name)
    if CommonTipView then
        CommonTipView:ShowTips( _G.TipType.PetSkill,
                petData,false)
    else
        _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CommonTipView.Name,
                _G.TipType.PetSkill,
                petData,false)
    end
end

---是否自动分解
---@return boolean
function PetModel:IsAutoDecompose()
    return _G.PlayerPrefsManager.GetInt("AutoPetDecompose", 0) == 1
end

---设置自动分解
---@param isOn boolean
function PetModel:SetAutoDecompose(isOn)
    _G.PlayerPrefsManager.SetInt("AutoPetDecompose", isOn and 1 or 0)
end

---调用立即自动分解
---@param callback fun(ok:boolean):void
function PetModel:AutoDecompose(callback)
    --只处理紫丶橙丶红三种品质
    local gradeList = _G.ConfigManager.discrete_cfg[114411]
    if not gradeList then
        if callback then
            callback(false)
        end
        return
    end

    local petDebrisList = {}
    for _, petData in pairs(self:GetAllPets()) do
        --已合成且满星的灵兽, 才进行分解
        if petData:IsMaxStar() and _G.table.ContainsValue(gradeList[1], petData.cfg.Order) then
            local data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, petData.cfg.materials_item)
            if not table.isEmptyOrNil(data) then
                table.insert(petDebrisList, { sid = petData.cfg.materials_item, num = data.count })
            end
        end
    end

    if #petDebrisList > 0 then
        self:DebrisDecompose(petDebrisList, function(msg)
            if not msg or msg.ack ~= 1 then
                if callback then
                    callback(false)
                end
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            --对应材料id
            local gradeCfg = _G.ConfigManager.discrete_cfg[114407]
            if gradeCfg and gradeCfg[1] then
                local firstGradeCfg = _G.ConfigManager.discrete_cfg[gradeCfg[1][2]]
                local itemId = firstGradeCfg[1][1]
                local itemNum = 0
                if msg.award and msg.award.item then
                    for _, v in ipairs(msg.award.item) do
                        if v.type[1] == itemId then
                            itemNum = itemNum + v.type[2]
                        end
                    end
                end
                if itemNum > 0 then
                    --显示分解tip
                    _G.PopWindowManager:GetInstance():ShowAllTips(914106, nil, nil, nil, nil, nil, itemNum)
                end
            end

            if callback then
                callback(true)
            end
        end)
    else
        if callback then
            callback(false)
        end
    end
end

return PetModel
