local PetNet = require("PetNet")
local PetData = require("PetData")

local base = _G.GameDataModelBase
---@class PetModel : GameDataModelBase
---@field pets PetData[]
local PetModel = _G.BaseClass("PetModel", base)

---@return PetModel PetModel
function PetModel:GetInstance()
    return self.super.GetInstance(self)
end

---定义宠物品质框
local PetOrderFrame = {
    [0] = "ui_js_txk_lan",
    [1] = "ui_js_txk_zi",
    [2] = "ui_js_txk_cheng",
    [3] = "ui_js_txk_hong",
    [4] = "ui_js_txk_cai"
}
PetModel.PetOrderFrame = PetOrderFrame

---创建对象时,入口构造函数
function PetModel:__init()
    self.curFunctionOpenID = _G.FunctionID.Pet
    self.petUpStarRedPoint = _G.ConfigManager.redpoint_cfg.PetillustratedItem.id
    self.pets = {}
    self.petGetStates = {}

    for _, v in pairs(_G.ConfigManager.pet_cfg) do
        self.pets[v.id] = PetData.New(v.id)
    end

    ---提前缓存所有的灵兽碎片配置，通过配置数据去道具仓库找碎片效果比遍历所有的道具仓库要快点
    self.petDebrisList = {}
    for _, v in pairs(_G.ConfigManager.item_cfg) do
        if v.Type1 == _G.ItemCfgType.PetChip then
            self.petDebrisList[v.ID] = v
        end
    end

    ---灵兽关系列表，list<灵兽碎片id， 灵兽id>
    self.petRelationShipList = {}
    for _, v in pairs(_G.ConfigManager.pet_cfg) do
        self.petRelationShipList[v.materials_item] = v.id
    end
end

---从服务器拉取数据
function PetModel:GetDataFormServer()
    PetNet:GetInstance():GetPetInfo(_G.handler(self, self.ParseData))
end

---@param msg pet.s2c_pet_info
function PetModel:ParseData(msg)
    local pets = msg.pets or {}
    for _, v in pairs(pets) do
        if self.pets[v.sid] then
            self.pets[v.sid]:Parse(v)
        end
    end
    self.super.ParseData(self)
end

function PetModel:UpStar(sid, star, active, call)
    local pbData = { sid = sid, new_star = star }
    PetNet:GetInstance():PetUpStar(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            if star == 0 then
                self.pets[sid]:DoActive()
            else
                self.pets[sid]:UpStar(star)
            end
            if star == 0 then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.PetShowView.Name, sid)
            else
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.PetStarUpView.Name, sid)
            end
            require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg
            .PetForestPosition.id)
            require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg
            .PetForestPositionBetter.id)
            require "PetForestModel":GetInstance():RefreshForestView()
            _G.StorageManager:GetInstance():ConsumeItem(self.pets[sid].cfg.materials_item, 0,
                self.pets[sid].cfg.materials_item_number[star + 1])
            _G.Events:GetInstance():Broadcast(_G.ePetUpStar.PetUpStarRefresh, sid)
            _G.Events:GetInstance():Broadcast(
                _G.ePlayAactionEvent.PlayAaction,
                {
                    _G.ActiveTaskEnum.ConditionEnum.Pet.PetStar,
                    sid,
                    self.pets[sid]:GetStar()
                },
                1
            )
            _G.Events:GetInstance():Broadcast(
                _G.ePlayAactionEvent.PlayAaction,
                {
                    _G.ActiveTaskEnum.ConditionEnum.Pet.PetStarNum,
                    self.pets[sid]:GetOrder(),
                    self.pets[sid]:GetStar()
                },
                1
            )
            ---0：所有品质
            _G.Events:GetInstance():Broadcast(
                _G.ePlayAactionEvent.PlayAaction,
                {
                    _G.ActiveTaskEnum.ConditionEnum.Pet.PetStarNum,
                    0,
                    self.pets[sid]:GetStar()
                },
                1
            )
            require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.PetFetterPage.id
            )
            require("RedPointManager"):GetInstance():RefreshNode(self.petUpStarRedPoint, sid)
            if call then
                call()
            end
        end
    )
end

---灵兽碎片分解
---@param sidNumLis table 碎片数组{{sid = 1, num = 1},..}
function PetModel:DebrisDecompose(sidNumLis, call)
    local pbData = { pet_debris = sidNumLis }
    PetNet:GetInstance():PetDebrisDecompose(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            for _, v in pairs(sidNumLis) do
                _G.StorageManager:GetInstance():ConsumeItem(v.sid, nil, v.num)
            end
            require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg
            .PetillustratedItem.id)
            if call then
                call(msg)
            end
        end
    )
end

