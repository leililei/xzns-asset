function PetModel:GetPet(sid)
    return self.pets[sid]
end

---获取所有灵兽数据
function PetModel:GetAllPets()
    return self.pets
end

---获取所有灵兽数据(灵兽界面排序 可合成>已激活>未激活 品质高的在前，品质相同时星级高的在前,星级一样时SID大的在前)
function PetModel:GetAllPetsBySort()
    local check = function(a, b, isAsc)
        local orderA = a:GetOrder()
        local orderB = b:GetOrder()
        if orderA == orderB then
            local starA = a:GetStar()
            local starB = b:GetStar()
            if starA == starB then
                return a.sid > b.sid
            else
                return starA > starB
            end
        else
            if isAsc then
                return orderA < orderB
            end
            return orderA > orderB
        end
    end


    --可合成>已激活>未激活
    --可合成和已激活中品质降序排序
    --未激活中品质升序排序
    local petList = {}
    local petRemainList = {}
    local activeList = {}
    local notActiveList = {}
    local condition
    for _, v in pairs(self.pets) do
        condition = v.cfg.condition_type
        if condition == nil or #condition == 0 or _G.GlobalConditionManager.CheckConditionByArray(condition) then
            if not self.petGetStates[v.sid] then
                self.petGetStates[v.sid] = v:IsCanGet()
            end
            if self.petGetStates[v.sid] then
                table.insert(petList, v)
            else
                table.insert(petRemainList, v)
            end
        end
    end
    for _, v in pairs(petRemainList) do
        if v:GetIsActive() then
            table.insert(activeList, v)
        else
            table.insert(notActiveList, v)
        end
    end
    --_G.table.sort(activeList, function(a, b)
    --    return check(a, b)
    --end)
    --_G.table.sort(notActiveList, function(a, b)
    --    return check(a, b)
    --end)
    for _, v in pairs(activeList) do
        table.insert(petList, v)
    end
    for _, v in pairs(notActiveList) do
        table.insert(petList, v)
    end
    _G.table.sort(petList, function(a, b)
        return check(a, b)
    end)
    return petList
end

---获取到灵兽碎片判断是否可以激活或者升星
function PetModel:CheckCompsePetRedPoint(addList)
    local itemConfig = _G.ConfigManager.item_cfg
    for _, sid in pairs(addList) do
        if itemConfig[sid] and itemConfig[sid].Type1 == _G.ItemCfgType.PetChip then
            local petSid = self.petRelationShipList[sid]
            if self:CheckPointRed(petSid) then
                require("RedPointManager"):GetInstance():RefreshNode(self.petUpStarRedPoint, petSid)
            end
        end
    end
end

---合成升星红点
---@param sid number 灵兽sid
function PetModel:CheckPointRed(sid)
    local data = self:GetPet(sid)
    if data:IsCanGet() then
        return true
    elseif data:GetIsActive() and (not data:IsMaxStar()) then
        local num = 0
        local itemSid = data.cfg.materials_item
        local itemData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, itemSid)
        if itemData then
            num = itemData:GetCount()
        end
        local maxNum = data:GetUpCostNum()
        return num >= maxNum
    else
        return false
    end
end

---获取所有已激活灵兽数据
function PetModel:GetAllActivePets()
    local pets = {}
    for _, v in pairs(self.pets) do
        if v:GetIsActive() then
            _G.table.insert(pets, v)
        end
    end
    return pets
end

