---灵兽抽奖奖励红点
function PetDrawModel:CheckDrawAwardPointRed(index)
    local isGet = self:IsGetAwardByIndex(index)
    if isGet then
        return false
    else
        local score = _G.ConfigManager.item_roller_cfg[self.cfgid].rewards_count[index]
        return self.drawScore >= score
    end
end

---灵兽抽奖心愿单红点
function PetDrawModel:CheckDrawWishPointRed(index)
    return self.wish_sids[index] == 0
end

---销毁对象时,析构函数
function PetDrawModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.OnUpData, self)
end

return PetDrawModel
