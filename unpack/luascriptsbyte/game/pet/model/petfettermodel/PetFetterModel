local PetNet = require("PetNet")

local base = _G.GameDataModelBase
---@class PetFetterModel : GameDataModelBase
local PetFetterModel = _G.BaseClass("PetFetterModel", base)

---@return PetFetterModel PetFetterModel
function PetFetterModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function PetFetterModel:__init()
    self.curFunctionOpenID = _G.FunctionID.Pet
    self.fetters = {}
end

---从服务器拉取数据
function PetFetterModel:GetDataFormServer()
    PetNet:GetInstance():GetPetFetterInfo(_G.handler(self, self.ParseData))
end

---@param msg
function PetFetterModel:ParseData(msg)
    local fetters = msg.fetter_list or {}
    self.fetters = {}
    for _, v in pairs(fetters) do
        self.fetters[v.fetter_sid] = v.index
    end
    self.super.ParseData(self)
end

---激活灵兽羁绊
---@param sid number 羁绊sid
---@param index number 羁绊阶段
function PetFetterModel:FetterActive(sid, index, call)
    local pbData = {fetter_sid = sid, index = index}
    PetNet:GetInstance():PetFetterActive(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self.fetters[sid] = index
            if call then
                call()
            end
            require("RedPointManager"):GetInstance():RefreshNode(
                _G.ConfigManager.redpoint_cfg.PetFetterPage.id,
                sid
            )
        end
    )
end

---获取羁绊阶段
---@param sid number 羁绊sid
function PetFetterModel:GetFetterIndex(sid)
    return self.fetters[sid] or 0
end

---当前羁绊对应的灵兽总星级
---@param pets table 羁绊对应的宠物
---@param condition_star number 解锁星级
function PetFetterModel:CanActiveFetter(pets, condition_star)
    for _, v in pairs(pets) do
        local petData = require("PetModel"):GetInstance():GetPet(v)
        if _G.table.isEmptyOrNil(petData) or not petData:GetIsActive() then
            return false
        end

        if petData:GetStar() < condition_star then
            return false
        end
    end
    return true
end

---是否有可激活的羁绊
function PetFetterModel:CheckCanActiveFetter(param)
    local allCfg = _G.ConfigManager.pet_fetter_cfg
    if allCfg[param] then
        local cfg = allCfg[param]
        for i = 1, 3 do
            if self:GetFetterIndex(cfg.id) < i and self:CanActiveFetter(cfg.pets, cfg["condition_star" .. i]) then
                return 1
            end
        end

        return 0
    end

    for _, v in pairs(allCfg) do
        for i = 1, 3 do
            if self:GetFetterIndex(v.id) < i and self:CanActiveFetter(v.pets, v["condition_star" .. i]) then
                return 1
            end
        end
    end
    return 0
end

---获取当前羁绊内可激活的最高阶段
function PetFetterModel:GetActiveMaxIndex(sid)
    local curIndex = self:GetFetterIndex(sid)
    if curIndex >= 3 then
        return
    end

    local fetterCfg = _G.ConfigManager.pet_fetter_cfg[sid]
    local maxIndex = nil
    for i = curIndex + 1, 3 do
        if self:CanActiveFetter(fetterCfg.pets, fetterCfg["condition_star" .. i]) then
            maxIndex = i 
        end
    end

    return maxIndex
end

---灵兽图鉴的属性
function PetFetterModel:GetPetFetterAttribute()
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local attribute = AttributeClassManager:GetAttribtueClass()
    for _, v in pairs(_G.ConfigManager.pet_fetter_cfg) do
        local index = self.fetters[v.id]
        if index and index > 0 then
            attribute = self:UpdateAttribute(AttributeClassManager, attribute, v["att" .. index])
        end
    end

    local changeAttrTypes = AttributeClassManager:GetChangeAttrTypes(attribute)
    return attribute, changeAttrTypes
end

function PetFetterModel:UpdateAttribute(attributeManager, attribute, attData)
    for _, v in pairs(attData) do
        local type = v[2] == "2" and _G.AttCountType.basePercent or _G.AttCountType.other
        attribute:AddValueByName(
            v[1],
            attributeManager:GetValueWithName(v[1], v[3], v[2]),
            false,
            type
        )
    end
    return attribute
end

---销毁对象时,析构函数
function PetFetterModel:Dispose()
end

return PetFetterModel
