---请求排行榜数据
---@param activityId number 活动id
---@param page number 排行榜页数
---@param callback Function 回调
function PetDrawUpMainModel:RequestRankInfo(activityId, page, callback)
    local pbData = {page = page, id = activityId}
    require("PetNet"):GetInstance():GePetDrawUpRankInfo(
        pbData,
        function(msg)
            if callback then
                callback(msg.ranks) 
            end
        end
    )
end

---获取排行榜数据
---@param activityId number 活动id
---@param page number 排行榜页数
---@param rankCall Function 所有排行榜回调
---@param mineRankCall Function 个人排行榜回调
function PetDrawUpMainModel:GetRankInfo(activityId, page, rankCall, mineRankCall)
    self:RequestRankInfo(activityId, page, function(allRankData)
        if not allRankData then
            allRankData = {}
        end

        local updateIndex = 0
        local newRankData = {}
        local totalNum = #allRankData
        for i = 1, 3 do
            if not allRankData[i] or allRankData[i].draw_times < self.topThreeNum then
                newRankData[i] = {}
            else
                updateIndex = i
                newRankData[i] = allRankData[i]
            end
        end

        local offset = 3 - updateIndex
        for i = updateIndex + 1, totalNum do
            ---前三后移后后面的也一起移动
            newRankData[i + offset] = allRankData[i]
        end
        if rankCall then
            rankCall(newRankData)
        end

        ---个人排行榜数据必须等总榜的数据下发后才请求，两者有依赖关系
        self:RequestMineRankInfo(activityId, function(msg)
            if msg.value < self.topThreeNum and msg.index > 0 then
                msg.index = msg.index + offset
            end
            if mineRankCall then
                mineRankCall(msg.index, msg.value)
            end
        end)
    end)
end

---排行榜奖励
function PetDrawUpMainModel:GetRankAwards(activityId)
    if not _G.table.isEmptyOrNil(self.rankAwardList) then
        return self.rankAwardList
    end

    local config = self:Getlimited_roller_cfg(activityId)
    local rankAward = config.draw_rank or {}
    local rankConfig = _G.ConfigManager.system_rank_cfg
    for _, v in pairs(rankAward) do
        if rankConfig[v] then
            _G.table.insert(self.rankAwardList,rankConfig[v])
            self.rankAwardTotal = self.rankAwardTotal + 1
        end
    end

    --进行排序(从高到底)
    _G.SortList(
        self.rankAwardList,
        function(v)
            return -v.min_rank
        end
    )

    return self.rankAwardList
end

