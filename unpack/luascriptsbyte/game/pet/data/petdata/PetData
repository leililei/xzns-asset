---是否可合成
function PetData:IsCanGet()
    if self.active then
        return false
    end
    local num = 0
    local itemData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, self.cfg.materials_item, true)
    if itemData then
        num = itemData:GetCount()
    end
    local maxNum = self.cfg.materials_item_number[self.star + 1]
    return num >= maxNum
end

---是否可升星
function PetData:IsCanStarUp()
    local needNum = self:GetUpCostNum()
    local num = 0
    local itemData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, self.cfg.materials_item)
    if itemData then
        num = itemData:GetCount()
    end
    return num >= needNum
end

---获取升星消耗数量
function PetData:GetUpCostNum()
    return self:GetIsActive() and self.cfg.materials_item_number[self.star + 2] or self.cfg.materials_item_number[self.star + 1]
end

---是否已满星
function PetData:IsMaxStar()
    return self:GetStar() == self:GetCfg().Star
end


