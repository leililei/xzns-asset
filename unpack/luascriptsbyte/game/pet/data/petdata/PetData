--region ------------- 增删改 -------------

---合成激活
function PetData:DoActive()
    self.active = true
    self.star = 0
    self:UpdateAttribute()
end

---升星
function PetData:UpStar(star)
    if star then
        self.star = star
    else
        self.star = self.star + 1
    end
    if self.star > self.cfg.Star then
        self.star = self.cfg.Star
    end
    self:UpdateAttribute()
end

--endregion ----------- 增删改 end -----------

