local base = require("BaseGameNet")

---@class PetNet : BaseGameNet	通信协议
local PetNet = _G.BaseClass("PetNet", base)
---@return PetNet PetNet
function PetNet:GetInstance()
    return base.GetInstance(self)
end

--region ------------- 灵兽 -------------

---获取灵兽信息
function PetNet:GetPetInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_pet_pet_info
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

