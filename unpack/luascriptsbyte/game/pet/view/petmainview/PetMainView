---界面的入口函数
function PetMainView:OnCreate(name)
    self.maxStage = PetForestModel:GetInstance():GetMaxStage()
    self.posTotalNum = ConfigManager.pet_phase_cfg[self.maxStage].pet_num
    self.curView = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.PetMainView.Name)
    self.unlockStage = {}
    local cfg = ConfigManager.pet_phase_cfg[1]
    local preNum = cfg.pet_num
    for i = 1, preNum do
        self.unlockStage[i] = cfg.phase
    end
    for i = 2, self.maxStage do
        cfg = ConfigManager.pet_phase_cfg[i]
        for j = preNum + 1, cfg.pet_num do
            self.unlockStage[j] = i
        end
        preNum = cfg.pet_num
    end
    _G.SetEventTrigger(self.go_table.aorbtn_lvUp, "onDown", _G.handler(self, self.OnDownLvUp))
    _G.SetEventTrigger(self.go_table.aorbtn_lvUp, "onLongPress", _G.handler(self, self.OnLongPressLvUp))
    self.scorll = self.go_table.scrollloophorizontal_pet:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect))
    self.lastPosCurNum = ConfigManager.pet_phase_cfg[PetForestModel:GetInstance():GetStage()].pet_num
    self.unlockAniPos = {}
    self:InitView()
    --self:LoadEffect()
    self:RecordPowerAndProp()
    local res = _G.ConfigManager.ui_cfg.PetMainView.resources
    self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, res))
    --self.playerHead =
    --    self:AddComponent(
    --            self.go_table.obj_PlayerHead,
    --            require("PlayerComponent").New(self.go_table.obj_PlayerHead)
    --    )
    self:AddListener(_G.eItemUpdata.Updata, self.UpdateTree)
    self:AddListener(_G.ePetUpStar.PetUpStarRefresh, self.OnPetUpStar)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    --self:RefreshBetterButton()
    if name then
        self:ChangeView(name)
    end
end

