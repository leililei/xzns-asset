---按钮点击事件在这里派发
function PetMainView:OnClickBtn(go, isOn)
    local UIManager = _G.UIManager:GetInstance()
    if go == self.go_table.aorbtn_close then
        self:Close()
        for _, window in pairs(WindowName) do
            local view = UIManager:GetWindow(window)
            if view then
                UIManager:CloseWindow(window)
            end
        end
    elseif go == self.go_table.aorbtn_help then
        UIManager:OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 120)
    elseif go == self.go_table.aorbtn_lvUp then
        if self.isMaxLv then
            return
        elseif self.isUpStage then
            PetForestModel:GetInstance():UpStage(
                function()
                    self:InitView()
                    self:ShowPowerAndPropUp()
                    --self:LoadLevelUpEffect()
                    --self:LoadPropUpEffect(true)
                end
            )
        else
            if self.tempLv <= self.curLv then
                self.tempLv = self.curLv + 1
            end
            PetForestModel:GetInstance():UpLevel(
                self.tempLv,
                function()
                    self:UpdateTree()
                    self:UpdateProp()
                    self:ShowPowerAndPropUp()
                end
            )
        end
    elseif go == self.go_table.aorbtn_lvUpTen then
        if self.isMaxLv or self.isUpStage then
            return
        end
        PetForestModel:GetInstance():UpLevel(
            self.tempLv + 10,
            function()
                self.go_table.aorbtn_lvUpTen:SetActiveE(0)
                self.go_table.aorbtn_lvUp:SetActiveE(1)
                self:UpdateTree()
                self:UpdateProp()
                self:ShowPowerAndPropUp()
                --self:LoadLevelUpEffect()
                --self:LoadPropUpEffect()
            end
        )
    elseif go == self.go_table.aorbtn_lvDetail then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.PetTreePreView.Name, self.maxStage)
    elseif go == self.go_table.aorbtn_main then
        self:ChangeView(WindowName.Main)
    elseif go == self.go_table.aorbtn_drawPet then
        self:ChangeView(WindowName.Draw)
    elseif go == self.go_table.aorbtn_pet then
        self:ChangeView(WindowName.Illustrated)
    elseif go == self.go_table.aorbtn_yoke then
        self:ChangeView(WindowName.Fetter)
    elseif go == self.go_table.aorbtn_decompose then
        self:ChangeView(WindowName.Decompose)
    elseif go == self.go_table.aorbtn_better then
        --一键上阵
        self:CheckLoad()
    end
end

---@private
function PetMainView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    self:RemoveListener(_G.eItemUpdata.Updata, self.UpdateTree)
    self:RemoveListener(_G.ePetUpStar.PetUpStarRefresh, self.OnPetUpStar)
    if self.moveTween then
        for k, v in pairs(self.moveTween) do
            v:Kill()
        end
        self.moveTween = nil
    end
end

return PetMainView
