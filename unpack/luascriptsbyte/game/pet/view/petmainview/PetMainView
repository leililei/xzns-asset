function PetMainView:RecordPowerAndProp()
    self.lastProp = PetForestModel:GetInstance():GetAllOtherProp(self.curLv)
    self.power = _G.StorageManager:GetInstance():GetPlayerPower()
end

function PetMainView:ShowPowerAndPropUp(lv)
    if lv == nil then ---临时等级提升不显示战力变化
        local newPower = _G.StorageManager:GetInstance():GetPlayerPower()
        local offset = newPower - self.power
        if offset > 0 then
            require "CommonTipManager".OpenPowerUpView(self.power, offset)
        end
        self.power = newPower
    end
    lv = lv or self.curLv
    local curProp = PetForestModel:GetInstance():GetAllOtherProp(lv)
    _G.UIUtils.ShowPropUp(nil, self.lastProp, nil, { prop = curProp })
    self.lastProp = curProp
end

function PetMainView:SetNewNpc(index, forward)
    local id = _G.Mathf.Random(1, #self.allLoadedPets)
    if index then
        local nowPetId = self.movePets[index]
        self.movePets[index] = self.allLoadedPets[id]
        if self.moveTween[index] then
            self.moveTween[index]:Kill()
            self.moveTween[index] = nil
        end
        _G.DestroyImmediate(self.movePetPrefabs[index])
        table.remove(self.allLoadedPets, id)
        table.insert(self.allLoadedPets, nowPetId)
        self:LoadNpc(index, true, forward)
    else
        table.insert(self.movePets, self.allLoadedPets[id])
        table.remove(self.allLoadedPets, id)
        self:LoadNpc(#self.movePets)
    end
end

---随机数个灵兽播放移动动画（策划说最多3个）
function PetMainView:InitNpc()
    self.movePets = {}
    self.movePetSteps = {}
    self.movePetCurSteps = { 0, 0, 0 }
    self.movePetCurForward = { 0, 0, 0 }
    self.movePetPrefabs = {}
    self.allLoadedPets = {}
    self.moveTween = {}
    for _, v in pairs(_G.ConfigManager.pet_cfg) do
        if #v.effect > 0 then
            table.insert(self.allLoadedPets, v.id)
        end
    end

    if AppSetting.IsXzns == false then
        if #self.allLoadedPets >= 1 then
            local moveCount = _G.Mathf.Min(3, #self.allLoadedPets)
            for _ = 1, moveCount do
                self:SetNewNpc()
            end
        end
    else
        self.petBoxCount = #PetForestModel:GetInstance().position
        self.loopCount = self.petBoxCount
        self.petTransDict = {}
        self:ClearBuffer()
        self:LoadPetToCenter()
    end
end

function PetMainView:ResetPetList()
    if self.loopCount == self.petBoxCount then
        self.movePets = {}
        for i = 1, self.petBoxCount do
            table.insert(self.movePets, i)
        end
        self.loopCount = 0
    end
end

function PetMainView:GetRandomPetSid()
    self:ResetPetList()
    local count = self.petBoxCount - self.loopCount
    local index = Mathf.Random(1, count)
    local curindex = 0
    for i, v in pairs(self.movePets) do
        curindex = curindex + 1
        if curindex == index then
            index = v
            self.movePets[i] = nil
            break
        end
    end
    self.loopCount = self.loopCount + 1
    return PetForestModel:GetInstance():GetPositionPet(index)
end

function PetMainView:ClearBuffer()
    for i, v in pairs(self.petTransDict) do
        DestroyObject(v)
    end
end

function PetMainView:LoadPetToCenter()
    if self.petBoxCount == nil or self.petBoxCount == 0 then
        return
    end
    local sid, data
    sid = self:GetRandomPetSid()
    if sid > 0 then
        ---@type PetData
        data = PetModel:GetInstance():GetPet(sid)
    end
    local petCfg = _G.ConfigManager.pet_cfg
    local moveCfg = petCfg[sid]
    self.curShowPetSid = sid
    if self.petTransDict[sid] == nil then
        _G.PoolsManager:GetInstance():Spawn(
            moveCfg.spine_1,
            _G.ePoolType.Temporary,
            self.go_table.trans_MoveNode,
            _G.handlerbind(self, self.LoadCompBack, sid)
        )
    else
        self:LoadCompBack(self.petTransDict[sid], nil, sid)
    end
    self:RefreshPetTransDict()
end

function PetMainView:RefreshPetTransDict()
    for i, v in pairs(self.petTransDict) do
        if i == self.curShowPetSid then
            v:SetActiveE(1)
        else
            v:SetActiveE(0)
        end
    end
end

function PetMainView:LoadCompBack(trans, path, sid)
    local petCfg = _G.ConfigManager.pet_cfg
    local moveCfg = petCfg[sid]
    local Zoom = moveCfg.effect[1]
    local pos_y = moveCfg.effect[2]

    if self.go_table == nil then
        _G.DestroyObject(trans)
        self.petTransDict[sid] = nil
        return
    end
    if Zoom then
        trans:SetLocalScaleXYZ(tonumber(Zoom[1]))
    end
    if pos_y then
        trans:SetLocalPosition(0, tonumber(pos_y[1]), 0)
    end
    self.petTransDict[sid] = trans
    local showTime = ConfigManager.discrete_cfg[200003][1][1]
    _G.DelayDo(
        showTime,
        function()
            if self:IsNil() then
                return
            end
            self:LoadPetToCenter()
        end
    )
end

---加载灵兽模型
function PetMainView:LoadNpc(i, isReplace, curForward)
    local petCfg = _G.ConfigManager.pet_cfg
    local moveCfg = petCfg[self.movePets[i]]
    local delayList = moveCfg.effect[5]
    if #moveCfg.effect > 0 then
        _G.PoolsManager:GetInstance():Spawn(
            moveCfg.spine_1,
            _G.ePoolType.Temporary,
            self.go_table.trans_MoveNode,
            function(trans)
                if self.go_table == nil then
                    _G.DestroyObject(trans)
                    return
                end
                self.movePetPrefabs[i] = trans
                self.movePetSteps[i] = _G.Mathf.Random(tonumber(delayList[1]), tonumber(delayList[2]))
                local cfg = moveCfg.effect
                trans:SetLocalScaleXYZ(tonumber(cfg[1][1]))
                local forward = 0
                if isReplace then
                    --如果是替换的则继承之前的方向
                    forward = curForward
                else
                    --如果加载的第二个和第一个的y值相同则从另一侧出发
                    if i == 2 and tonumber(petCfg[self.movePets[1]].effect[2][1]) == tonumber(cfg[2][1]) then
                        forward = 1
                    end
                    if i == 3 then
                        local first = tonumber(petCfg[self.movePets[1]].effect[2][1])
                        local second = tonumber(petCfg[self.movePets[2]].effect[2][1])
                        --如果和前两个其中一个y值相同则从另一侧出发
                        if first == tonumber(cfg[2][1]) or second == tonumber(cfg[2][1]) then
                            forward = 1
                            --如果加载的第三个和前两个的y值都相同则重新随机
                        elseif first == second and tonumber(cfg[2][1]) == first then
                            --检测一下是否其他可随机的全都是相同y值，若无可替换则不生成
                            local canReplace = false
                            for j = 1, #self.allLoadedPets do
                                if petCfg[self.allLoadedPets[j]].effect[2][1] ~= first then
                                    canReplace = true
                                    break
                                end
                            end
                            if not canReplace then
                                return
                            end
                            self:SetNewNpc(3)
                            return
                        end
                    end
                end
                self.movePetCurForward[i] = forward
                self:PlayNpcAni(i)
            end
        )
    end
end

---开始播放灵宠移动动画
function PetMainView:PlayNpcAni(index)
    if self.go_table == nil then
        return
    end
    local npc = self.movePetPrefabs[index]
    local cfg = _G.ConfigManager.pet_cfg[self.movePets[index]].effect
    local outX = tonumber(cfg[4][1])
    if self.movePetCurForward[index] == 1 then
        npc:SetLocalPosition(outX, tonumber(cfg[2][1]), 0)
        npc:SetLocalRotation(0, 180, 0)
    else
        npc:SetLocalRotation(0, 0, 0)
        npc:SetLocalPosition(-outX, tonumber(cfg[2][1]), 0)
    end
    self:NpcMoveTo(index)
end

---灵宠移动动画
function PetMainView:NpcMoveTo(index)
    if self.go_table == nil then
        return
    end
    local cfg = _G.ConfigManager.pet_cfg[self.movePets[index]].effect
    local outX = tonumber(cfg[4][1])
    local x, y, z = self.movePetPrefabs[index]:GetLocalPosition()
    --到达右边界后转向
    if self.movePetCurForward[index] == 0 and x > outX then
        self.movePetPrefabs[index]:SetLocalRotation(0, 180, 0)
        self.movePetCurForward[index] = 1
        self.movePetCurSteps[index] = 0
        self:SetNewNpc(index, self.movePetCurForward[index])
        self:NpcMoveTo(index)
        return
    end
    --到达左边界后转向
    if self.movePetCurForward[index] == 1 and x < -outX then
        self.movePetPrefabs[index]:SetLocalRotation(0, 0, 0)
        self.movePetCurForward[index] = 0
        self.movePetCurSteps[index] = 0
        self:SetNewNpc(index, self.movePetCurForward[index])
        self:NpcMoveTo(index)
        return
    end
    --走过当前停顿步数时停顿
    if self.movePetCurSteps[index] == self.movePetSteps[index] then
        local delayList = cfg[6]
        self.movePetSteps[index] = _G.Mathf.Random(tonumber(cfg[5][1]), tonumber(cfg[5][2]))
        _G.DelayDo(
            _G.Mathf.Random(tonumber(delayList[1]), tonumber(delayList[2])),
            function()
                if self:IsNil() or _G.IsNil(self.movePetPrefabs[index]) then
                    return
                end
                self.movePetCurSteps[index] = 0
                self:NpcMoveTo(index)
            end
        )
        return
    end
    local moveDistance = tonumber(cfg[3][1])
    --根据当前方向计算移动距离
    if self.movePetCurForward[index] == 1 then
        moveDistance = -1 * moveDistance
    end

    if self.moveTween[index] then
        self.moveTween[index]:Kill()
        self.moveTween[index] = nil
    end
    if _G.IsNil(self.movePetPrefabs[index]) then
        return
    end
    self.moveTween[index] = self.movePetPrefabs[index]:DOLocalMove(tonumber(x + moveDistance), y, z, 1):SetEase(
        _G.CS.DG.Tweening.Ease.Linear
    ):OnComplete(
        function()
            if self.go_table == nil or _G.IsNil(self.movePetPrefabs[index]) then
                return
            end

            self.movePetCurSteps[index] = self.movePetCurSteps[index] + 1
            self:NpcMoveTo(index)
        end
    )
end

---检测主界面上阵状态
function PetMainView:CheckLoad()
    local model = PetForestModel:GetInstance()
    local function checkPosition(index, maxIndex)
        if index > maxIndex then
            return
        end
        --获取空闲宠物
        ---@type PetData[]
        local pets = model:GetAllActiveAndIdlePets()
        if #pets <= 0 then
            return
        end
        --获取当前位置宠物, 是否可替换更高战力的宠物
        local curPetId = model:GetPositionPet(index)
        local newPetId, power, order, star = 0, 0, 0, 0
        if curPetId > 0 then
            local petData = require("PetModel"):GetInstance():GetPet(curPetId)
            power = petData.power
            order = petData:GetOrder()
            star = petData.star
        end
        for _, v in pairs(pets) do
            if v.power > power then
                power = v.power
                newPetId = v.cfg.id
            elseif v.power == power then
                if v:GetOrder() > order then
                    power = v.power
                    newPetId = v.cfg.id
                elseif v:GetOrder() == order and v.star > star then
                    power = v.power
                    newPetId = v.cfg.id
                end
            end
        end

        if newPetId > 0 then
            model:PutOnPet(index, newPetId, function()
                self:UpdatePet()
                checkPosition(index + 1, maxIndex)
            end)
        else
            checkPosition(index + 1, maxIndex)
        end
    end
    checkPosition(1, model:GetPosUnlockNum())
end

