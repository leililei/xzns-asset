---初始化页面
function PetMainView:InitView()
    self.go_table.aorbtn_lvUpTen:SetActiveE(0)
    self.go_table.aortext_lvUpTen.text = GetLangPackValue(90021800244, 10)
    self:UpdateTree()
    self:UpdateProp()
    self:UpdatePet()
    if not self.npcInited then
        self.npcInited = true
        self:InitNpc()
    end
end

function PetMainView:UpdateTree()
    self.curLv = PetForestModel:GetInstance():GetLevel()
    self.curStage = PetForestModel:GetInstance():GetStage()
    self.posCurNum = ConfigManager.pet_phase_cfg[self.curStage].pet_num
    if self.posCurNum > self.lastPosCurNum then
        for i = self.lastPosCurNum + 1, self.posCurNum do
            self.unlockAniPos[i] = true
            self.lastPosCurNum = self.posCurNum
        end
    end
    local stageCfg = ConfigManager.pet_phase_cfg[self.curStage]
    local maxStageCfg = ConfigManager.pet_phase_cfg[self.maxStage]
    self.go_table.aortext_maxLv.text = "/" .. stageCfg.max_level
    self.go_table.aortext_curLv.text = self.curLv
    self.go_table.aortext_attr1.text = GetLangPackValue(90031300014, GetColorStr(self.curStage))
    self.go_table.aortext_attr2.text = GetLangPackValue(90031300015, GetColorStrPer(stageCfg.pet_trans / 100))
    self.go_table.aortext_attr3.text = GetLangPackValue(90031300016, GetColorStrPer(GetAttrPerNum(stageCfg.att[1])))
    self.go_table.aortext_attr4.text = GetLangPackValue(90031300017, GetColorStrPer(GetAttrPerNum(stageCfg.att[2])))
    self.go_table.aortext_attr5.text = GetLangPackValue(90031300018, GetColorStrPer(GetAttrPerNum(stageCfg.att[4])))
    self.go_table.aortext_attr6.text = GetLangPackValue(90031300019, GetColorStrPer(GetAttrPerNum(stageCfg.att[3])))

    self.isMaxLv = self.curLv >= maxStageCfg.max_level
    self.isUpStage = self.curLv == stageCfg.max_level and not self.isMaxLv
    self.go_table.aorbtn_lvUp:SetGray(self.isMaxLv)

    if self.isMaxLv then
        self.go_table.aortext_lvUp.text = GetLangPackValue(9002050021)
    elseif self.isUpStage then
        self.go_table.aortext_lvUp.text = GetLangPackValue(90031300029)
    else
        self.go_table.aortext_lvUp.text = GetLangPackValue(9002050015)
    end

    self.go_table.obj_costContent:ClearChildren()
    self.go_table.obj_cost:SetActiveE(self.isMaxLv and 0 or 1)
    if not self.isMaxLv then
        local materials, oldCfg, newCfg
        if self.isUpStage then
            materials, oldCfg, newCfg = PetForestModel:GetInstance():CalMaterialCost(self.curStage + 1, nil, true)
        else
            materials, oldCfg, newCfg = PetForestModel:GetInstance():CalMaterialCost(self.curLv + 1)
        end
        ---@type PetMainView._obj_costItem_GoTable
        local tb
        local obj, icon, enough
        for _, v in pairs(newCfg.material) do
            obj = _G.InstantiateObject(self.go_table.obj_costItem, self.go_table.obj_costContent)
            obj:SetActiveE(1)
            tb = GetAutoGoTable(obj)
            icon = _G.StorageManager:GetInstance():GetItemIcon(v[1])
            tb.aorrawimage_icon:LoadImage(icon)
            tb.aortext_num.text = materials[v[1]]
            enough = _G.StorageManager:GetInstance():CheckItem(v[1], materials[v[1]])
            tb.aortext_num.color = _G.ColorTools.FormatColorByString(enough and "56C13F" or "FB1111")
        end
    end
end

function PetMainView:UpdateProp(level)
    local prop = PetForestModel:GetInstance():GetAllOtherProp(level)
    self.go_table.aortext_sumProp1.text = prop.atk
    self.go_table.aortext_sumProp2.text = prop.bre
    self.go_table.aortext_sumProp3.text = prop.max_hp
    self.go_table.aortext_sumProp4.text = prop.def
end

function PetMainView:UpdatePet()
    if not self.petInit then
        self.petList = {}
        self.go_table.scrollloophorizontal_pet:InitItemData(self.posTotalNum, _G.handler(self, self.RefreshList))
        self.petInit = true
    else
        self.go_table.scrollloophorizontal_pet:UpdateAllItem()
    end
    self.go_table.scrollloophorizontal_pet:ScrollToTop()
end

function PetMainView:RefreshList(index, obj)
    index = index + 1
    obj:SetName("$_obj_petItem_" .. index)
    local state = PosState.Lock
    local sid, data
    if index <= self.posCurNum then
        state = PosState.Unlock
        sid = PetForestModel:GetInstance():GetPositionPet(index)
        if sid > 0 then
            data = PetModel:GetInstance():GetPet(sid)
            state = PosState.Full
        end
    end

    ---@type PetMainView._obj_petItem_GoTable
    local tb = GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickPet, index, state))
    _G.SetEventTrigger(tb.aorbtn_choose, "onLongPress", _G.handlerbind(self, self.OnLongPressPet, sid))
    _G.SetEventTrigger(tb.aorbtn_choose, "onDown", _G.handler(self, self.OnDownPet))

    tb.aorimage_bg:SetActiveE(state ~= PosState.Full and 1 or 0)
    tb.obj_pet:SetActiveE(state == PosState.Full and 1 or 0)
    tb.aorimage_lock:SetActiveE(state == PosState.Lock and 1 or 0)
    tb.aortext_unlockTip.text = state == PosState.Lock and GetLangPackValue(90031300038, self.unlockStage[index]) or ""
    if self.unlockAniPos[index] then
        self.unlockAniPos[index] = false
        --_G.UIUtils.LoadEffectByCfg(
        --    ConfigManager.ui_effect_cfg.ef_suo,
        --    tb.aorimage_bg,
        --    function(trans)
        --        if self:IsNil() then
        --            _G.DestroyObject(trans)
        --        end
        --    end,
        --    _G.handlerbind(self, self.ShowItemByUnlock, tb, state, index)
        --)
    else
        self:ShowItemByUnlock(tb, state, index)
    end
    tb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.PetForestPosition.id, index)
    tb.data = data
    self.petList[index] = tb
    if data and not tb.spawning then
        if tb.pet then
            tb.pet:ShowData(data)
        else
            tb.spawning = true
            _G.PoolsManager:GetInstance():Spawn(
                "UIH5/Common/ItemView/ItemPetBodyBaseView",
                _G.ePoolType.UIItem,
                tb.obj_pet,
                _G.handlerbind(self, self.OnPetSpawnCall, tb)
            )
        end
    end
    ---设置升级按钮 长按事件
    _G.SetEventTrigger(tb.aorbtn_choose, "onDown", _G.handler(self, self.OnDownPet))
    _G.SetEventTrigger(
        tb.aorbtn_choose,
        "onDrag",
        function(s, event)
            self.scorll:OnDrag(event)
        end
    )
    _G.SetEventTrigger(
        tb.aorbtn_choose,
        "onDragEnd",
        function(s, event)
            self.scorll:OnEndDrag(event)
        end
    )
    _G.SetEventTrigger(
        tb.aorbtn_choose,
        "onDragBegin",
        function(s, event)
            self.scorll:OnBeginDrag(event)
        end
    )
end

