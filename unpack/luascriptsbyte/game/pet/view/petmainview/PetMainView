function PetMainView:OnClickPet(go, isOn, index, state)
    if self.longPress then
        return
    end
    if state ~= PosState.Lock then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.PetChooseView.Name,
            index,
            -- _G.handler(self, self.OnPetChange),
            _G.handler(self, self.CheckLoad),
            self
        )
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(914102, nil, nil, nil, nil, nil, self.unlockStage[index])
    end
end

function PetMainView:OnDownPet(go, isOn)
    if self.onPress then
        return
    end
    self.longPress = false
    self.onPress = true
end

function PetMainView:OnLongPressPet(go, isOn, sid)
    if self.onPress then
        self.onPress = false
        self.longPress = true
        if sid and sid > 0 then
            local isActive = PetModel:GetInstance():GetPet(sid):GetIsActive()
            CommonTipManager:GetInstance():OpenTip(self.gameObject, sid, nil, nil, not isActive, true)
        end
    end
end

function PetMainView:OnDownLvUp()
    self.materialEnough = true
    if self.isUpStage or self.isMaxLv then
        return
    end
    self.tempLv = self.curLv
    if not self:TempMaterialCheck() then
        return
    end
    self.tempLv = self.curLv + 1
    self:TempUpdate()
    self:ShowPowerAndPropUp(self.tempLv)
end

function PetMainView:OnLongPressLvUp()
    if self.isUpStage or self.isMaxLv then
        return
    end
    if self.tempLv >= _G.ConfigManager.pet_phase_cfg[self.curStage].max_level then
        return
    end
    if not self.materialEnough then
        return
    end
    if not self:TempMaterialCheck() then
        return
    end
    self.tempLv = self.tempLv + 1
    self:TempUpdate()
    self:ShowPowerAndPropUp(self.tempLv)
end

function PetMainView:TempMaterialCheck()
    local materials = PetForestModel:GetInstance():CalMaterialCost(self.tempLv + 1)
    for k, v in pairs(materials) do
        if not _G.StorageManager:GetInstance():CheckItem(k, v) then
            self.materialEnough = false
            return false
        end
    end
    return true
end

function PetMainView:TempUpdate()
    self.go_table.aortext_curLv.text = self.tempLv
    self:UpdateProp(self.tempLv)
    local stageCfg = ConfigManager.pet_phase_cfg[self.curStage]
    local maxStageCfg = ConfigManager.pet_phase_cfg[self.maxStage]
    local isMaxLv = self.tempLv >= maxStageCfg.max_level
    local isUpStage = self.tempLv == stageCfg.max_level and not isMaxLv
    self.go_table.obj_costContent:ClearChildren()
    self.go_table.obj_cost:SetActiveE(isMaxLv and 0 or 1)
    if not isMaxLv then
        local materials, oldCfg, newCfg, enough
        if isUpStage then
            materials, oldCfg, newCfg = PetForestModel:GetInstance():CalMaterialCost(self.curStage + 1, nil, true)
        else
            materials, oldCfg, newCfg = PetForestModel:GetInstance():CalMaterialCost(self.tempLv + 1, self.tempLv)
            if stageCfg.max_level - self.tempLv >= 10 then
                local tenM, _, tenCfg = PetForestModel:GetInstance():CalMaterialCost(self.tempLv + 10, self.curLv)
                enough = true
                for _, v in pairs(tenCfg.material) do
                    if not _G.StorageManager:GetInstance():CheckItem(v[1], tenM[v[1]]) then
                        enough = false
                        break
                    end
                end
                self.go_table.aorbtn_lvUpTen:SetActiveE(enough and 1 or 0)
                self.go_table.aorbtn_lvUp:SetActiveE(enough and 0 or 1)
            else
                self.go_table.aorbtn_lvUpTen:SetActiveE(0)
                self.go_table.aorbtn_lvUp:SetActiveE(1)
            end
        end
        ---@type PetMainView._obj_costItem_GoTable
        local tb
        local obj, icon
        for _, v in pairs(newCfg.material) do
            obj = _G.InstantiateObject(self.go_table.obj_costItem, self.go_table.obj_costContent)
            obj:SetActiveE(1)
            tb = GetAutoGoTable(obj)
            icon = _G.StorageManager:GetInstance():GetItemIcon(v[1])
            tb.aorrawimage_icon:LoadImage(icon)
            tb.aortext_num.text = materials[v[1]]
            enough = _G.StorageManager:GetInstance():CheckItem(v[1], materials[v[1]])
            tb.aortext_num.color = _G.ColorTools.FormatColorByString(enough and "56C13F" or "FB1111")
        end
    end
    --self:LoadLevelUpEffect()
    --self:LoadPropUpEffect()
end

