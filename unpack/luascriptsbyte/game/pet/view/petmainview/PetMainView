local GetColorStr = function(num)
    return "<color=#a7e960>" .. _G.Mathf.Floor(num) .. "</color>"
end

local GetColorStrPer = function(num)
    return "<color=#a7e960>" .. _G.Mathf.Floor(num) .. "%" .. "</color>"
end

local GetAttrPerNum = function(attr)
    if attr then
        return attr[3] / 100
    else
        return 0
    end
end

function PetMainView:Awake()
