function PetMainView:OpenDecomposeView()
    local canvas = self.go_table.obj_BottomBar:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))

    local params = {}
    params.titleText = 91118100101
    params.ToggleCall = function(isOn)
        _G.PopWindowManager:GetInstance():ShowAllTips(isOn and 914104 or 914105)
        if isOn then
            require("PetModel"):GetInstance():AutoDecompose(function(ok)
                if not ok then
                    return
                end
                ---@type DecomposeView
                local view = _G.UIManager:GetInstance():GetWindowCtrl(WindowName.Decompose)
                if view then
                    view:UpdateView(true)
                end
            end)
        end
    end
    local view = _G.UIManager:GetInstance():OpenWindow(WindowName.Decompose, _G.StorageID.Prop, params)
    if view.LayerSorting <= canvas.sortingOrder then
        view.LayerSorting = view.LayerSorting + 5
    end
end

