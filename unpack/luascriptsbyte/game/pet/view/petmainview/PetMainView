function PetMainView:OnUIOpened(name)
    if name == _G.ConfigManager.ui_cfg.PetDrawView.Name then
        local canvas = self.go_table.obj_BottomBar:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
        _G.UIManager:GetInstance():ChangeCanvasOrder(name, canvas.sortingOrder - 5)
    elseif name == _G.ConfigManager.ui_cfg.PetillustratedView.Name then
        local canvas = self.go_table.obj_BottomBar:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
        _G.UIManager:GetInstance():ChangeCanvasOrder(name, canvas.sortingOrder - 5)
    elseif name == _G.ConfigManager.ui_cfg.PetFetterView.Name then
        local canvas = self.go_table.obj_BottomBar:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
        _G.UIManager:GetInstance():ChangeCanvasOrder(name, canvas.sortingOrder - 5)
    end

    if name ~= _G.ConfigManager.ui_cfg.PetDrawView.Name then
        return
    end
    if _G.PlayerPrefsManager.HasKey("PetDrawRedPoint") then
        return
    end
    local sid = _G.ConfigManager.item_roller_cfg[require("PetDrawModel"):GetInstance().cfgid].ticket[1]
    local itemNum = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.Prop, sid)
    if itemNum and itemNum >= 10 then
        --ZHJH-3174 有足够道具时，打开招募界面红点消失
        _G.PlayerPrefsManager.SetInt("PetDrawRedPoint", _G.StorageManager:GetInstance():GetItemCountBySid(203120100))
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.PetDraw.id)
    end
end

