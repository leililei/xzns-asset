end

---界面的入口函数
function PetStarUpView:OnCreate(sid)
    ---@type PetData
    self.data = PetModel:GetInstance():GetPet(sid)
    local oldData = require("PetData").New(sid)
    oldData:Parse({ star = self.data:GetStar() - 1 })
    local nowData = require("PetData").New(sid)
    nowData:Parse({ star = self.data:GetStar() })
    self:InitbgCanvasSortingOrder()
    _G.PoolsManager:GetInstance():Spawn(
            self.data:GetSpinePath(),
            _G.ePoolType.Temporary,
            self.go_table.aorrawimage_icon,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                local cfg = self.data.cfg.spine_portrait1
                trans:SetLocalPosition(cfg[1], cfg[2], cfg[3])
                trans:SetLocalScaleXYZ(cfg[4])
            end
    )
    self:SetCompareData(oldData)
    self:ShowBase(true)
    self:ShowProp(nowData)
    self:ShowSkill()
    self:ShowBtn()
end

---按钮点击事件在这里派发
function PetStarUpView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        ---关闭按钮
        self:Close()
    end
end
