local PetModel = require "PetModel"
local PetForestModel = require("PetForestModel")

local base = require "EventViewBase"
---@class PetAttributeView : UIBaseView	灵兽属性
---@field public go_table PetAttributeView_GoTable GoTable
local PetAttributeView = _G.BaseClass("PetAttributeView", base)

local propIndex = {
    atk = 1,
    max_hp = 3,
    def = 2,
    bre = 4
}

function PetAttributeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.PropListObj = {}
end

---界面的入口函数
function PetAttributeView:OnCreate(sid)
    self:AddListener(_G.ePetUpStar.PetUpStarRefresh, self.PetUpStarRefresh, self)
    self.mainView = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.PetMainView.Name)
    self.petList=PetModel:GetInstance():GetAllPetsBySort()
    for k,v in pairs(self.petList) do
        if v.sid==sid then
            self.petIndex=k
        end
    end
    local curData = PetModel:GetInstance():GetPet(sid)
    self:ShowPet(curData)
end

function PetAttributeView:ShowPet(curData)
    if self.petIndex ~= nil  then
        self.go_table.aorbtn_left:SetActiveE(self.petIndex > 1 and 1 or 0)
    else
        self.go_table.aorbtn_left:SetActiveE(0)
    end
    if self.petIndex ~= nil then
        self.go_table.aorbtn_right:SetActiveE(self.petIndex ~= table.count(self.petList) and 1 or 0)
    else
        self.go_table.aorbtn_right:SetActiveE(0)
    end
    self.isPreview = not curData:GetIsActive()
    if self.isPreview then
        local data = require("PetData").New(curData.sid)
        data:Parse({ star = curData:GetCfg().Star })
        self.data = data
    else
        self.data = curData
    end
    self:FreshStar()
    self.go_table.obj_maxStarTip:SetActiveE(self.isPreview and 1 or 0)
    _G.PoolsManager:GetInstance():Spawn(
            self.data:GetSpinePath(),
            _G.ePoolType.Temporary,
            self.go_table.obj_pet,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                local cfg = self.data.cfg.spine_portrait1
                trans:SetLocalPosition(cfg[1], cfg[2], cfg[3])
                trans:SetLocalScaleXYZ(cfg[4])
            end
    )
    self:SetCostState()
    self:SetRightView()
    _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.baseItem,
            self.go_table.aorrawimage_cost,
            function(item)
                if _G.IsNil(self.go_table.aorrawimage_cost) then
                    return
                end
                item:Show(self.data.cfg.materials_item)
            end
    )
    self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.PetillustratedItem.id,
            self.data.sid)
    -- local res = _G.ConfigManager.ui_cfg.PetAttributeView.resources
    -- self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, res))
end

function PetAttributeView:FreshStar()
    local ctm = require "CommonTipManager":GetInstance()
    local orderDic = {
        [1] = 4,
        [2] = 5,
        [3] = 6,
        [4] = 8
    }
    ctm:SetItemTextGradient(self.go_table.aortext_name, orderDic[self.data.cfg.Order])
    self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(self.data.cfg.Name)
    local star = self.data:GetStar()
    for i = 1, 5 do
        self.go_table["aorimage_starMask"..i]:SetActiveE(star >= i and 0 or 1)
    end
end

function PetAttributeView:PetUpStarRefresh()
    self:SetCostState()
    self:ShowPropByCfg()
    self:ShowSkill()
    local curProp = PetForestModel:GetInstance():GetAllOtherProp()
    _G.UIUtils.ShowPropUp(nil, self.lastProp, nil, { prop = curProp })
    self:FreshStar()
end

---右侧界面
function PetAttributeView:SetRightView()
    self:ShowPropByCfg()
    self:ShowSkill()
    self:ShowSkillTag()
end

---展示属性
function PetAttributeView:ShowPropByCfg()
    local attrDic = self.data:GetAttributeDict()
    local index
    local go = _G.GetAutoGoTable(self.go_table.obj_PropContent)
    for k, v in pairs(attrDic) do
        index = propIndex[k]
        go["aortext_num" .. index].text = v
    end
end

---展示技能
function PetAttributeView:ShowSkill()
    local baseSkillCfg = _G.ConfigManager.card_skills_cfg[self.data.cfg.skill_id[1]]
    self.go_table.aorrawimage_skill:LoadImage(baseSkillCfg.icon)
    self.go_table.aortext_petSkillName.text = _G.GetLangPackValue(baseSkillCfg.name1)
    local skillDesExText = self.go_table.obj_baseSkill:GetComponentE(_G.typeof(_G.CS.ExtendText))
    local maxStar = #self.data.cfg.skill_instruction
    local des = ""
    if self.isPreview then
        for i = 1, maxStar do
            des = des .. "<color=#ff912c>" .. _G.GetLangPackValue(90000010475, i - 1) .. ":</color>"
                .. _G.GetLangPackValue(self.data.cfg.skill_instruction[i])
            if i < maxStar then
                des = des .. "\n\n"
            end
        end
    else
        des = des ..
            "<color=#ff912c>" .. _G.GetLangPackValue(90000010475, self.data:GetStar()) .. ":</color>"
            .. _G.GetLangPackValue(self.data.cfg.skill_instruction[self.data:GetStar() + 1])
    end
    skillDesExText.text = des

    skillDesExText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))
end

function PetAttributeView:ShowSkillTag()
    local lanID, obj, tb
    for i = 1, self.go_table.obj_skillTagContent:GetChildCountE() do
        self.go_table.obj_skillTagContent:GetChildE(i-1):SetActiveE(0)
    end
    for i = 1, 3 do
        lanID = self.data.cfg["pet_position" .. i]
        if lanID and lanID > 0 then
            if self.go_table.obj_skillTagContent:GetChildCountE()<=i then
                obj = _G.InstantiateObject(self.go_table.obj_skillTagItem, self.go_table.obj_skillTagContent)
            else
                obj = self.go_table.obj_skillTagContent:GetChildE(i)
            end
            obj:SetActiveE(1)
            tb = _G.GetAutoGoTable(obj)
            --tb.aorimage_bg.SpriteName = i == 1 and "ui_js_biaoqian_jnleixing" or "ui_js_biaoqian_zhanwei"
            tb.aortext_tagName.text = _G.GetLangPackValue(lanID)
        end
    end
end

