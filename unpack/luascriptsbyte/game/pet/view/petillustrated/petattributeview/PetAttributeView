---消耗展示
function PetAttributeView:SetCostState()
    if self.isPreview then
        self.go_table.obj_upStar:SetActiveE(0)
        self.go_table.obj_up:SetActiveE(0)
        self.go_table.obj_maxStar:SetActiveE(0)
        self.go_table.scrollrect_content:SetRectTransformSize(536, 232)
        return
    end
    self.go_table.scrollrect_content:SetRectTransformSize(536, 200)
    self.go_table.obj_upStar:SetActiveE(1)
    local isMaxStar = self.data:IsMaxStar()
    local isActive = self.data:GetIsActive()
    local isShowUp = isActive and (not isMaxStar)
    self.go_table.obj_up:SetActiveE(isShowUp and 1 or 0)
    self.go_table.obj_maxStar:SetActiveE(isMaxStar and 1 or 0)
    if isShowUp then
        local num = 0
        local itemSid = self.data.cfg.materials_item
        local itemData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, itemSid)
        if itemData then
            num = itemData:GetCount()
        end
        local maxNum = self.data:GetUpCostNum()
        local strNum = num
        if num < maxNum then
            strNum = num < maxNum and string.format("<color=#ff5252>%s</color>", num) or
                string.format("<color=#56C13F>%s</color>", num)
        end
        self.go_table.aortext_cost.text = strNum .. "/" .. maxNum
    end
end

---按钮点击事件在这里派发
function PetAttributeView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_up then
        local itemSid = self.data.cfg.materials_item
        if not _G.StorageManager:GetInstance():CheckItem(itemSid, self.data:GetUpCostNum()) then
            local quickUseBox = _G.StorageManager:GetInstance():PetFastCheckItem(self.data.sid, function()
                self:SetCostState()
            end)
            if quickUseBox then
                return
            end
        end

        local num = 0
        local itemData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, itemSid)
        if itemData then
            num = itemData:GetCount()
        end
        local maxNum = self.data:GetUpCostNum()

        if num < maxNum then
            _G.PopWindowManager:GetInstance():ShowAllTips(95)
            return
        end


        self.lastProp = PetForestModel:GetInstance():GetAllOtherProp()
        PetModel:GetInstance():UpStar(self.data.sid, self.data:GetStar() + 1)
    elseif go == self.go_table.aorbtn_info then
        require("CommonTipManager"):GetInstance():OpenPetSkillTip(self.data.sid)
    elseif go==self.go_table.aorbtn_right then
        self:ChangeShowPet(true)
    elseif go==self.go_table.aorbtn_left then
        self:ChangeShowPet(false)
    end
end

---切换魔兽展示
---@param isNext boolean 切换下一个魔兽
function PetAttributeView:ChangeShowPet(isNext)
    if isNext then
        self.petIndex=self.petIndex+1
    else
        self.petIndex=self.petIndex-1
    end
    local data=self.petList[self.petIndex]
    _G.DestroyObject(self.go_table.obj_pet:GetChildE(0))
    self:ShowPet(data)
end

---界面的销毁函数
function PetAttributeView:OnDestroy()
    self:RemoveListener(_G.ePetUpStar.PetUpStarRefresh, self.PetUpStarRefresh, self)
end

return PetAttributeView
