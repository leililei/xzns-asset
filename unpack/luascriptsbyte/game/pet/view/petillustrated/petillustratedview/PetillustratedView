function PetillustratedView:InitView()
    _G.DelayFrameDo(_G.handler(self, self.RefreshView))
end

function PetillustratedView:RefreshView()
    self.loadTimer = 0
    self.petDataList = {}
    local petDataList = PetModel:GetInstance():GetAllPetsBySort()
    for i, v in ipairs(petDataList) do
        local channel = v.cfg.channel_id
        if #channel == 0 or _G.table.ContainsValue(channel, tonumber(_G.SDKManager:GetInstance():GetChannelId())) then
            _G.table.insert(self.petDataList, v)
        end
    end
    local index = self:GetJumpPetIndex()
    self.go_table.scrollloopvectical_pet:InitItemData(#self.petDataList, _G.handler(self, self.RefreshPetList))
    self.go_table.scrollloopvectical_pet:UpdateAllItem()
    self.go_table.scrollloopvectical_pet:ScrollToIndex(index)
end

function PetillustratedView:LoadEffect()
    local check = function(trans)
        if self:IsNil() then
            _G.DestroyObject(trans)
        end
    end
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_PetillustratedView_bg_loop,
        self.go_table.aorrawimage_Bg,
        check
    )
end
function PetillustratedView:onValueChanged(x)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_arrowLeft, x <= 0)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_arrowRight, x >= (-self.maxNum))
end

---刷新列表
function PetillustratedView:RefreshPetList(index, obj)
    index = index + 1
    local data = self.petDataList[index]
    ---@type PetillustratedView._obj_item_GoTable
    local tb = GetAutoGoTable(obj, handlerbind(self, self.OnClickPet, data))
    obj:SetName("$_obj_item_" .. index)
    local itemSid = data.cfg.materials_item
    local IsCanGet = data:IsCanGet()
    local isGay = (not data:GetIsActive()) and (not IsCanGet)
    tb.gameObject:SetActiveE(0)

    if not tb.obj_root then
        return
    end
    tb.gameObject:SetActiveE(1)
    if tb.obj_root:GetChildCountE() == 0 then
        if _G.IsNil(tb.obj_root) then
            return
        end
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.baseItem,
            tb.obj_root,
            function(item)
                if _G.IsNil(tb.obj_root) then
                    return
                end
                tb.lua = item
                item:Show(itemSid)
                -- item.go_table.aorimage_Color:SetGray(isGay)
                -- item:SetGray(isGay)
            end
        )
    else
        if tb.lua == nil then
            tb.lua = ItemViewNew.New(tb.obj_root:GetChildE())
        end
        tb.lua:Show(itemSid)
        -- tb.lua.go_table.aorimage_Color:SetGray(isGay)
        -- tb.lua:SetGray(isGay)
    end

    ---名字
    local pet_cfg = _G.ConfigManager.pet_cfg[data.sid]
    local ctm = require "CommonTipManager":GetInstance()
    local orderDic = {
        [1] = 4,
        [2] = 5,
        [3] = 6,
        [4] = 8
    }
    ctm:SetItemTextGradient(tb.aortext_name, orderDic[pet_cfg.Order])
    tb.aortext_name.text = _G.LangUtil.GetLangPackValue(pet_cfg.Name)
    local star = data:GetStar()
    for i = 1, 5 do
        tb["aorimage_starMask" .. i]:SetActiveE(star >= i and 0 or 1)
    end
    local num = 0
    local itemData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, itemSid)
    if itemData then
        num = itemData:GetCount()
    end
    local maxNum = data:GetUpCostNum()
    local strNum = num
    if num < maxNum then
        -- if isGay then
        --     strNum = string.format("<color=#585858>%s</color>", _G.GameUtil.NumberWY(num))
        -- else
        strNum = string.format("<color=#fb1111>%s</color>", _G.GameUtil.NumberWY(num))
        -- end
    end
    local spriteName = _G.PetBodyIconName[pet_cfg.Order]
    tb.aortext_num.text = strNum .. "/" .. _G.GameUtil.NumberWY(maxNum)
    tb.aorimage_bg.SpriteName = spriteName
    tb.aorimage_mask.SpriteName = spriteName
    tb.aorrawimage_icon:LoadImage(
        pet_cfg.image_1,
        function(trans)
            trans:SetNativeSize()
            local pos = pet_cfg.image_portrait1
            if #pos == 4 then
                trans:SetLocalPosition(pos[1], pos[2], pos[3])
                trans:SetLocalScaleXYZ(pos[4])
            end
        end
    )
    local canUpStar = star < 5 and num >= maxNum and not IsCanGet
    tb.aorimage_mask:SetActiveE((IsCanGet or isGay or canUpStar) and 1 or 0)
    tb.obj_TextBg:SetActiveE((IsCanGet or canUpStar) and 1 or 0)
    tb.aortext_maskTxt.text = canUpStar and _G.GetLangPackValue(90022300042) or _G.GetLangPackValue(90000010005)
    tb.aortext_maskTxt:SetNativeSize()
    -- tb.aorrawimage_bg:SetGray(isGay)
    -- tb.aorrawimage_icon:SetGray(isGay)
    -- tb.aorrawimage_maskBg:SetGray(isGay)
    --_G.CSGrayManager.SetGaryWithAllChildren(tb.transform, true)
    local slider = GetAutoGoTable(tb.slider_Progress)
    local value = num / maxNum
    UIUtils.SetUIModelText(tb.aortext_type,tb.aortext_type2,_G.GetLangPackValue(data.cfg.professional + 90024900003))
    UIUtils.SetUIModel(tb.aorimage_typeBg,nil,tb.aorimage_typeBg2)
    tb.aorimage_profession.SpriteName = ProfessionalEnum[data.cfg.professional]
    tb.slider_Progress.value = value > 1 and 1 or value
    slider.aorimage_Fill.SpriteName = value < 1 and "ui_bb_jindutiao_huang" or "ui_bb_jindutiao_lan"
    tb.obj_root:SetActiveE(star < 5 and 1 or 0)
    tb.slider_Progress:SetActiveE(star < 5 and 1 or 0)
    tb.aortext_num:SetActiveE(star < 5 and 1 or 0)
    tb.obj_hongDian:UpdateRedPointItemIDAndParam(self.petUpStarRedPoint, data.sid)
    self:ShowOrderEffect(tb, pet_cfg.Order >= 4)

end

function PetillustratedView:ShowOrderEffect(tb, isShow)
    self:RemoveEffect(tb)
    if isShow then
        local effect = OrderEffectCfg
        _G.UIUtils.LoadEffectByCfg(
            effect,
            tb.obj_uieffect,
            function(trans)
                if tb.obj_uieffect:GetChildCountE() > 1 then
                    _G.DestroyObject(trans)
                    return
                end
                --trans.gameObject:SetLocalScaleXYZ(0.77)
                trans:AddComponentE(typeof(CS.ParticleClipRect))
            end
        )
    end
end

---清楚品质特效
function PetillustratedView:RemoveEffect(tb)
    if tb.obj_uieffect:GetChildCountE() > 0 then
        for i = 1, tb.obj_uieffect:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(tb.obj_uieffect:GetChildE(0), _G.ePoolType.UIEffect)
        end
    end
end

--- 获取快捷跳转索引
---@return number 索引（从0开始）
function PetillustratedView:GetJumpPetIndex()
    -- 获取第一个可进行操作（可合成、可升星）的索引（合成>升星）
    local index = 0
    local isCanStarUP = false
    for k, data in pairs(self.petDataList) do
        -- 当前对象可合成
        if data:IsCanGet() then
            index = k - 1
            break
        end
        -- 当前对象可升星
        if not isCanStarUP and data:IsCanStarUp() then
            index = k - 1
            isCanStarUP = true
        end
    end
    return index
end

---Item点击事件
---@param artifactSid number 神器sid
function PetillustratedView:OnClickPet(obj, isOn, data)
    if data:IsCanGet() then
        PetModel:GetInstance():UpStar(data.sid, 0, false, _G.handler(self, self.RefreshView))
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.PetAttributeView.Name, data.sid)
    end
end

---按钮点击事件在这里派发
function PetillustratedView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        ---关闭按钮
        self:Close()
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 124)
    end
end

---界面的销毁函数
function PetillustratedView:OnDestroy()
    self:RemoveListener(_G.ePetUpStar.PetUpStarRefresh, self.RefreshView, self)
end

return PetillustratedView