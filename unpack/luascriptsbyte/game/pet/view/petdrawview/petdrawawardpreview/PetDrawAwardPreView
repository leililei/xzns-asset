local base = require "EventViewBase"
---@class PetDrawAwardPreView : UIBaseView	灵兽抽卡概率
---@field public go_table PetDrawAwardPreView_GoTable GoTable
local PetDrawAwardPreView = _G.BaseClass("PetDrawAwardPreView", base)

function PetDrawAwardPreView:Awake()
    self.AwardDatas = {}
    self.itemList = {}
    self.weight = 0
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param sid number 奖池idp
function PetDrawAwardPreView:OnCreate(sid)
    local insert = _G.table.insert
    self.cfgid = 20100
    local poolid = _G.ConfigManager.item_roller_cfg[self.cfgid].pool[1][1]
    local data = _G.ConfigManager.item_pools_cfg[poolid]
    if data then
        for k,v in pairs(data.items) do
            local item ={}
            item.sid = v[1]
            item.num = v[2]
            item.weight = v[3] or 0
            self.weight = self.weight + item.weight
            insert(self.AwardDatas,item)
        end
    end
    _G.SortList(self.AwardDatas,function(a)
        local type = 0
        if a.Grand then
            type = 1
        end
        return type, - a.weight ,-a.sid
    end)

    self.go_table.scrollloopvectical_AwardList:InitItemData(#self.AwardDatas, _G.handler(self, self.RefreshList))
end
---刷新显示
function PetDrawAwardPreView:RefreshList(index, obj)
    local instanceID = obj:GetInstanceIDE()
    local tb = self.itemList[instanceID]
    local data = self.AwardDatas[index + 1]
    if not data then
        return
    end
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        self.itemList[instanceID] = tb
        ---@type BaseAwardNewItem
        tb.item = require "BaseAwardNewItem".New(tb.obj_Root, _G.handler(self, self.OnClickItem), 96)
    end
    ---@param item BaseAwardNewItem
    tb.item:ShowWithID(
        {data.sid,data.num},
        nil,
        function(item)
        end
    )
    tb.aortext_probNum.text = self:GetPerData(index + 1) .. "%"
end

---点击奖励
function PetDrawAwardPreView:OnClickItem(item)
    require "CommonTipManager":GetInstance():OpenTip(item.gameObject, item.data.sid)
end

---按钮点击事件在这里派发
function PetDrawAwardPreView:OnClickBtn(go, isOn)
    self:Close()
end

function PetDrawAwardPreView:GetPerData(index)
    local weight = self.AwardDatas[index].weight/self.weight*100
    weight = string.format("%.2f", weight)
    return weight
end

return PetDrawAwardPreView