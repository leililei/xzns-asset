---选中item点击事件
---@param index number item的索引
function PetWishListView:OnClickSelectItem(index)
    if self.selectPetData[index] then
        self:RefreshSelectPet(index)
        self:ChangeProfession()
    end
end

---按钮点击事件在这里派发
function PetWishListView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_closeX then
        ---遮罩或者关闭按钮
        self:Close()
        --elseif go == self.go_table.aorbtn_selectItem1 then
        --    self:OnClickSelectItem(1)
        --elseif go == self.go_table.aorbtn_selectItem2 then
        --    self:OnClickSelectItem(2)
        --elseif go == self.go_table.aorbtn_selectItem3 then
        --    self:OnClickSelectItem(3)
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 125)
    elseif go == self.go_table.aorbtn_sure then
        self:OnSend()
        self:Close()
    end
end

---发送消息
function PetWishListView:OnSend()
    PetDrawModel:GetInstance():SetWish({ self.selecID, 0, 0 })
end

return PetWishListView
