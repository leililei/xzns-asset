local ItemPetBase = require("ItemPetBase")
local base = require "EventViewBase"
---@class PetWishListView : UIBaseView	灵兽心愿单
---@field public go_table PetWishListView_GoTable GoTable
local PetWishListView = _G.BaseClass("PetWishListView", base)
local PetDrawModel = require("PetDrawModel")
local PetModel = require("PetModel")
local GetAutoGoTable = _G.GetAutoGoTable
local handlerbind = _G.handlerbind

function PetWishListView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    ---可选中的数量
    self.selectPetNum = 1
    self.cfgid = 20100
    ---已选中Item
    self.selectPetItem = {}
    self.petTypeList = {}
    self.petItemList = {}
end

---界面的入口函数
function PetWishListView:OnCreate(doneCall, closeCall)
    base.OnCreate(self, doneCall, closeCall)
    ---已选中的数据,0是未选择
    self.selectPetData = PetDrawModel:GetInstance():GetWishsids()
    self.selecID = self.selectPetData[1]
    self:InitPetData()

    ---默认显示全部
    --self:ChangeProfession()
    self:RefreshSelectPet()
end

---初始化数据
function PetWishListView:InitPetData()
    local wishItemData = _G.ConfigManager.item_roller_cfg[self.cfgid].wish_item
    local petConfig = _G.ConfigManager.pet_cfg
    for _, id in pairs(wishItemData) do
        local cfg = petConfig[id]
        if cfg then
            local pro = cfg.professional
            if not self.petTypeList[pro] then
                self.petTypeList[pro] = {}
            end
            _G.table.insert(self.petTypeList[pro], id)
        end
    end
    self:ShowList()
end

---显示列表
function PetWishListView:ShowList()
    --单行展示个数
    local lineLimit = 4
    for k, v in pairs(self.petTypeList) do
        if v then
            local typeList = _G.InstantiateObject(self.go_table.obj_TypeList, self.go_table.obj_Content)
            local typeTb = _G.GetAutoGoTable(typeList)
            typeTb.aortext_TypeName.text = _G.GetLangPackValue(90024900003 + k)
            local typeLine = (#v + lineLimit - 1) // lineLimit
            for i = 1, typeLine do
                local line = (i - 1) * lineLimit
                local petList = _G.InstantiateObject(self.go_table.obj_PetList, typeList)
                for j = 1, lineLimit do
                    if v[line + j] then
                        local item = _G.InstantiateObject(self.go_table.obj_Item, petList)
                        self:ShowItem(item, v[line + j])
                    end
                end
                _G.GameUtil.ReBuildRTF(petList)
            end
            _G.GameUtil.ReBuildRTF(typeList)
        end
    end
    _G.GameUtil.ReBuildRTF(self.go_table.obj_Content)
end

function PetWishListView:ShowItem(obj, sid)
    local petSid = sid
    ---@type PetWishListView._obj_Item_GoTable
    local tb = GetAutoGoTable(obj, handlerbind(self, self.OnClickPet, petSid))
    if not self.petItemList[sid] then
        self.petItemList[sid] = tb
    end
    local data = PetModel:GetInstance():GetPet(sid)

    if tb.obj_Root:GetChildCountE() == 0 then
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemPetBase,
            tb.obj_Root,
            function(item)
                if _G.IsNil(tb.obj_Root) then
                    return
                end
                tb.lua = item
                item:Show(petSid, data.star)
                item:SetSize(95)
                item:HideLevel()
                item:ShowOrHideProfessional(false)
                if self.selecID == petSid then
                    tb.aorimage_choose:SetActiveE(1)
                else
                    tb.aorimage_choose:SetActiveE(0)
                end
                tb.lua:ShowStar(data:GetIsActive())
                tb.lua.go_table.aorrawimage_Icon:SetGray(not data:GetIsActive())
                tb.lua.go_table.aorimage_ColorBG:SetGray(not data:GetIsActive())
            end
        )
    else
        if tb.lua == nil then
            tb.lua = ItemPetBase.New(tb.obj_Root:GetChildE())
        end
        tb.lua:Show(petSid, data.star)
        tb.lua:ShowStar(data:GetIsActive())
        tb.lua:SetSize(95)

        tb.lua.go_table.aorrawimage_Icon:SetGray(not data:GetIsActive())
        tb.lua.go_table.aorimage_ColorBG:SetGray(not data:GetIsActive())
        tb.lua:ShowOrHideProfessional(false)
    end
    if self.selecID == petSid then
        tb.aorimage_choose:SetActiveE(1)
    else
        tb.aorimage_choose:SetActiveE(0)
    end

    ---名字
    local pet_cfg = _G.ConfigManager.pet_cfg[petSid]
    tb.aortext_name.text = _G.LangUtil.GetLangPackValue(pet_cfg.Name)
    local skillId = pet_cfg.skill_id[#pet_cfg.skill_id]
    tb.aortext_type.text = _G.ConfigManager.language_package_cfg[_G.ConfigManager.card_skills_cfg[skillId].brief]
    tb.aortext_tagName.text = _G.GetLangPackValue(pet_cfg.pet_position1)
    ---@type UnityEngine.UI.ScrollRect
    local scroll = self.go_table.obj_ScrollRect:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect))
    ---设置升级按钮 长按事件
    _G.SetEventTrigger(tb.aorbtn_clickObj, "onDown", _G.handler(self, self.OnDownEvent))
    _G.SetEventTrigger(tb.aorbtn_clickObj, "onDrag", function(s, event) scroll:OnDrag(event) end)
    _G.SetEventTrigger(tb.aorbtn_clickObj, "onDragEnd", function(s, event) scroll:OnEndDrag(event) end)
    _G.SetEventTrigger(tb.aorbtn_clickObj, "onDragBegin", function(s, event) scroll:OnBeginDrag(event) end)
    tb.aorbtn_clickObj.LongPress = true
    tb.aorbtn_clickObj.onLongPress = _G.handlerbind(self, self.OnLongPressEvent, petSid)
end

--按下事件
function PetWishListView:OnDownEvent()
    if self.isLongPress then
        return
    end
    self.isLongPress = true
end

---长按事件
function PetWishListView:OnLongPressEvent(petSid)
    if self.isLongPress then
        self.isLongPress = false
        require("CommonTipManager"):GetInstance():OpenTip(self.gameObject, petSid, nil, nil, true, true)
    end
end

---刷新
function PetWishListView:ChangeProfession(petSid, isShow)
    if self.petItemList[petSid] then
        self.petItemList[petSid].aorimage_choose:SetActiveE(isShow and 1 or 0)
    end
end

---刷新选中的item
function PetWishListView:RefreshSelectPet(index)
    if index then
        ---如果点击已选择的神器，则取消选择
        self.selectPetData[1] = 0
        local parentObj = self.go_table["aorbtn_select" .. 1]
        self.selectPetItem[parentObj:GetInstanceIDE()] = nil
        parentObj:ClearChildren()
        self:OnSend()
        return
    end

    for i = 1, self.selectPetNum do
        local parentObj = self.go_table["aorbtn_select" .. i]
        if self.selectPetData[i] > 0 and not self.selectPetItem[parentObj:GetInstanceIDE()] then
            local sid = self.selectPetData[i]
            local data = PetModel:GetInstance():GetPet(sid)
            _G.ItemFactory:GetInstance():GetItemCard(
                _G.ItemFactory.itemType.ItemPetBase,
                parentObj,
                function(item)
                    item:Show(sid, data.star)
                    item:SetSize(95)
                    item:ShowStar(data:GetIsActive())
                    self.selectPetItem[parentObj:GetInstanceIDE()] = item
                end
            )
            self.go_table["obj_gou_" .. i]:SetActiveE(0)
        end
    end
end

