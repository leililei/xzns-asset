---@private
function PetProbabilityView:RefreshList(index, obj)
    index = index + 1
    local instanceID = obj:GetInstanceIDE()
    local tb = self.itemList[instanceID]
    local data = self.probList[index]
    if not data then
        return
    end
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        self.itemList[instanceID] = tb
        ---@type BaseAwardNewItem
        tb.item = require "BaseAwardNewItem".New(tb.obj_itemBase, _G.handler(self, self.OnClickItem), 96)
    end
    ---@param item BaseAwardNewItem
    tb.item:ShowWithID(
        { data.sid, data.num },
        nil,
        function(item)
            if item.item.HideLevel then
                item.item:HideLevel()
                item.item:HideStar()
            end
        end
    )
    tb.aortext_prob.text = string.format("%.2f", data.prob) .. "%"
end

---@private
function PetProbabilityView:OnClickItem(go, isOn)
    require "CommonTipManager":GetInstance():OpenTip(go.gameObject, go.data.sid, nil, nil, { maxLevel })
end

---按钮点击事件在这里派发
function PetProbabilityView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

return PetProbabilityView