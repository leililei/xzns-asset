---刷新当前羁绊对应的灵兽立绘
function PetFetterView:RefreshPetInfo(tb, index)
    local fetterCfg = self.fetterConfigs[index]
    if not self.pets then
        self.pets = {}
    end
    self.pets[index] = {}
    if not table.isEmptyOrNil(fetterCfg.pets) then
        ---灵宠立绘
        self.pets[index] = fetterCfg.pets
    end
    local petCount = #self.pets[index]
    self.petIndex = index
    tb.scrollloophorizontal_PetList:InitItemData(petCount, _G.handler(self, self.RefreshPetItem))
    tb.scrollloophorizontal_PetList:UpdateCount(petCount)

    self:RefreshFetterAttribute(index)
end

---刷新指定羁绊对应的属性
function PetFetterView:RefreshFetterAttribute(index)
    local cfg = self.fetterConfigs[index]
    ---当前羁绊激活的阶段
    --self.curStage = PetFetterModel:GetInstance():GetFetterIndex(cfg.id)

    if not self.attributeList then
        self.attributeList = {}
    end
    self.attributeList[index] = {}
    for i = 1, 3 do
        if cfg["att" .. i] then
            self.attributeList[index][i] = {
                condition_star = cfg["condition_star" .. i] or 0,
                att = cfg["att" .. i],
                desc = cfg["desc" .. i]
            }
        end
    end
    --self.fetterListView:UpdateCount(#self.fetterConfigs)
end

---刷新羁绊信息
function PetFetterView:RefreshFetterItem(index, obj)
    local params = {}
    local newIndex = index + 1
    local cfg = self.fetterConfigs[newIndex]
    local nowIndex = PetFetterModel:GetInstance():GetFetterIndex(cfg.id)
    self.canActive[newIndex] = false
    params.index = newIndex
    params.stage = nowIndex
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickFetterItem, params))
    local childCount = tb.obj_PropContent:GetChildCountE()
    if childCount > 0 then
        for i = 1, childCount do
            _G.PoolsManager:GetInstance():Despawn(tb.obj_PropContent:GetChildE(i - 1), _G.ePoolType.UIItem)
        end
    end

    ---属性
    self:RefreshPetInfo(tb, newIndex)

    tb.obj_PropContent:SetActiveE(1)
    tb.aorbtn_click:SetActiveE(1)
    tb.aortext_title.fontSize = 20
    tb.aortext_title:SetLocalPosition(0, -164, 0)
    if nowIndex < 3 then
        local data = self.attributeList[newIndex][nowIndex + 1]
        local attributeList = self:GetBaseAttr(data.att)
        local iconDic = {
            ["atk"] = "ui_js_gj_icon",
            ["def"] = "ui_js_fy_icon",
            ["max_hp"] = "ui_js_sm_icon",
            ["bre"] = "ui_js_pj_icon",
            ["hit_rate"] = "ui_js_mzl_icon",
            ["avd_rate"] = "ui_js_sbl_icon",
            ["cri_rate"] = "ui_js_bjl_icon",
            ["cri_r_rate"] = "ui_js_kbl_icon",
            ["cri_dmg"] = "ui_js_bjsh_icon",
            ["cri_dmg_r"] = "ui_js_bsjm_icon",
            ["dmg_inc"] = "ui_js_shzj_icon",
            ["psy_d_r"] = "ui_js_wsjm_icon",
            ["mag_d_r"] = "ui_js_fsjm_icon",
        }
        for _, v in pairs(attributeList) do
            local tran = _G.InstantiateObject(tb.obj_BaseProp, tb.obj_PropContent)
            if tran then
                local tb = _G.GetAutoGoTable(tran)
                tb.aortext_Name.text = _G.AttrType[v.key].des
                tb.aortext_Name.color = _G.ColorTools.FormatColorByString("FFEBD2")
                tb.aorimage_icon:SetActiveE(0)
                tb.aorrawimage_icon:SetActiveE(0)
                local numStr = v.num
                if v.type == 2 or _G.AttrType[v.key].percentage == 1 then
                    numStr = _G.GameUtil.FormatNum(numStr * 100) .. "%"
                else
                    numStr = _G.GameUtil.NumberWY(_G.math.floor(numStr))
                end
                tb.aortext_Num.text = numStr
                tran:SetActiveE(1)
            end
        end
        local canActive = PetFetterModel:GetInstance():CanActiveFetter(cfg.pets or {}, data.condition_star)
        tb.aorbtn_click:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
        _G.ColorTools.FormatColorByString(canActive and "FFFFFF" or "A9A9A9")
        tb.aortext_Operation.color =
        _G.ColorTools.FormatColorByString(canActive and "8C2D14" or "434343")
        tb.aorbtn_click:SetGray(not canActive)
        --tb.aortext_Operation:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineWidth = canActive and 0 or 1
        self.canActive[newIndex] = canActive
        local color = canActive and "<color=#1E7A2D>" or "<color=#c02f2f>"
        local textColor = canActive and "<color=#8C2D14>" or "<color=#444444>"
        tb.aortext_title.text = color .. _G.GetLangPackValue(data.desc) .. "</color>"
        tb.aortext_Operation.text =
            textColor .. (nowIndex == 0 and _G.GetLangPackValue(90023500003) or _G.GetLangPackValue(90023500004)) .. "</color>"
    else
        tb.aorbtn_click:SetActiveE(0)
        tb.obj_PropContent:SetActiveE(0)
        tb.aortext_title.fontSize = 40
        tb.aortext_title:SetLocalPosition(0, -182, 0)
        tb.aortext_title.text = _G.GetLangPackValue(90020600059)
        tb.aortext_Operation.text = ""
    end
end

---获取基础属性
function PetFetterView:GetBaseAttr(att)
    local attributeManager = _G.AttributeClassManager:GetInstance()
    local attributeList = {}
    for _, v in pairs(att) do
        table.insert(attributeList, {
            key = v[1],
            sortId = _G.AttrType[v[1]].sortid,
            type = _G.tonumber(v[2]),
            num = attributeManager:GetValueWithName(v[1], v[3], v[2])
        })
    end
    _G.SortList(
        attributeList,
        function(a)
            return -a.sortId
        end
    )

    return attributeList
end

---羁绊Btn点击事件
function PetFetterView:OnClickFetterItem(obj, _, params)
    if not self.canActive[params.index] then
        return
    end
    local data = self.attributeList[params.index][params.stage + 1]
    if params.stage < 3 then
        local cfg = self.fetterConfigs[params.index]
        if not PetFetterModel:GetInstance():CanActiveFetter(cfg.pets or {}, data.condition_star) then
           return
        end

        ---可以解锁，点击解锁
        local maxIndex = PetFetterModel:GetInstance():GetActiveMaxIndex(cfg.id)
        if maxIndex then
            PetFetterModel:GetInstance():FetterActive(cfg.id, maxIndex, function()
                --_G.UIUtils.LoadEffectByCfg(
                --    _G.ConfigManager.ui_effect_cfg.ef_PetFetterView_bao,
                --    obj,
                --    function(tran)
                --        if _G.IsNil(obj) then
                --            tran:DestroyObject()
                --            return
                --        end
                --
                --    end
                --)
                self:InitFetterList()
                ---战力变化提示
                _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.PetFetter)
                local newPower = _G.StorageManager:GetInstance():GetPlayerPower()
                local offset = newPower - self.power
                if offset > 0 then
                    require "CommonTipManager".OpenPowerUpView(self.power, offset)
                    self.power = newPower
                end
            end)
        end
    end
end

