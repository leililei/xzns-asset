function PetFetterView:InitFetterCfg()
    self.fetterConfigs = {}
    local fetterCfg = _G.ConfigManager.pet_fetter_cfg
    for _, v in pairs(fetterCfg) do
        table.insert(self.fetterConfigs, v)
    end
    _G.table.sort(self.fetterConfigs, function (a, b)
        return a.id < b.id
    end)
    self.canActive = {}
    --可激活/升级置顶 -> 已解锁按羁绊等级降序，等级相同则按id升序 -> 未解锁按id升序
    local activeList = {}
    local unlockList = {}
    local lockList = {}
    for i = 1, #self.fetterConfigs do
        local index = PetFetterModel:GetInstance():GetFetterIndex(self.fetterConfigs[i].id)
        if index < 3 and
                PetFetterModel:GetInstance():CanActiveFetter(
                        self.fetterConfigs[i].pets or {},
                        self.fetterConfigs[i]["condition_star" .. index + 1]
                ) then
            table.insert(activeList, self.fetterConfigs[i])
        elseif index > 0 then
            table.insert(unlockList, self.fetterConfigs[i])
        else
            table.insert(lockList, self.fetterConfigs[i])
        end
    end
    table.sort(unlockList, function(a, b)
        local aId = PetFetterModel:GetInstance():GetFetterIndex(a.id)
        local bId = PetFetterModel:GetInstance():GetFetterIndex(b.id)
        if aId == bId then
            return a.id < b.id
        end
        return aId > bId
    end)
    for i = 1, #unlockList do
        table.insert(activeList,unlockList[i])
    end
    for i = 1, #lockList do
        table.insert(activeList, lockList[i])
    end
    local playermodel=_G.PlayerModel:GetInstance()
    local serverStartTime=playermodel:GetServerOpenTime()
    local curTime=_G.TimeUtil.GetServerUnixTime()
    local today=math.ceil((curTime-serverStartTime)/86400)
    local creatDay=math.ceil((playermodel.create_time-serverStartTime)/86400)
    local nowAfk=require("AfkModel"):GetInstance():GetCurSection()
    local lv=playermodel:GetLevel()
    local petcfg={}
    local fetterConfig={}
    local removelist={}
    for i = 1, #activeList do
        fetterConfig=activeList[i]
        for j = 1, #fetterConfig.pets do
            petcfg=_G.ConfigManager.pet_cfg[fetterConfig.pets[j]]
            if not table.isEmptyOrNil(petcfg.condition_type) then
                for k = 1, #petcfg.condition_type do
                    if petcfg.condition_type[k][1] ==1 then
                        if petcfg.condition_type[k][2] >lv then
                            table.insert(removelist,fetterConfig)
                            break
                        end
                    elseif petcfg.condition_type[k][1] ==4 then
                        if petcfg.condition_type[k][2] >nowAfk then
                            table.insert(removelist,fetterConfig)
                            break
                        end
                    elseif petcfg.condition_type[k][1] ==9 then
                        if petcfg.condition_type[k][2]>(today-creatDay) then
                            table.insert(removelist,fetterConfig)
                            break
                        end
                    elseif petcfg.condition_type[k][1] ==50 then
                        if petcfg.condition_type[k][2]>(today) then
                            table.insert(removelist,fetterConfig)
                            break
                        end
                    end
                    if  table.ContainsValue(removelist,fetterConfig) then
                        break
                    end
                end
                if table.ContainsValue(removelist,fetterConfig) then
                    break
                end
            end
            if table.ContainsValue(removelist,fetterConfig) then
                break
            end
        end
    end
    for i = 1, #removelist do
        table.removebyvalue(activeList,removelist[i],false)
    end
    self.fetterConfigs = activeList
end

---初始化资源栏
function PetFetterView:InitResources()
    if not _G.IsNil(self.go_table.obj_GoldInfo) and self.go_table.obj_GoldInfo:GetctiveInHierarchy() == 1 then
        local resources = _G.ConfigManager.ui_cfg.PetFetterView.resources
        self:AddComponent(
            self.go_table.obj_GoldInfo,
            require("ResourceCompont").New(self.go_table.obj_GoldInfo, resources)
        )
    end

    self.playerHead =
        self:AddComponent(
                self.go_table.obj_PlayerHead,
                require("PlayerComponent").New(self.go_table.obj_PlayerHead)
        )
end

function PetFetterView:InitFetterList()
    self:InitFetterCfg()
    self.go_table.scrollloopvectical_fetterList:InitItemData(
            #self.fetterConfigs,
            _G.handler(self, self.RefreshFetterItem)
    )
    self.fetterListView = self.go_table.scrollloopvectical_fetterList
end

function PetFetterView:RefreshFetterPageItem(index, obj)
    local newIndex = index + 1
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickPageItem, newIndex))
    self.pageItemList[newIndex] = tb

    local config = self.fetterConfigs[newIndex]
    tb.aortext_label.text = _G.GetLangPackValue(config.name)
    tb.aortext_label2.text = _G.GetLangPackValue(config.name)
    tb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.PetFetterPage.id, config.id)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_On, self.curPageIndex == newIndex)
end

function PetFetterView:RefreshPetItem(index, obj)
    local newIndex = index + 1
    local tb = _G.GetAutoGoTable(obj)
    local sid = self.pets[self.petIndex][newIndex]
    local petData = PetModel:GetInstance():GetPet(sid)
    tb.data = petData
    if petData and not tb.spawning then
        if tb.pet then
            tb.pet:ShowData(petData)
            tb.pet.go_table.aorimage_mask:SetActiveE(tb.data:GetIsActive() and 0 or 1)
        else
            tb.spawning = true
            _G.PoolsManager:GetInstance():Spawn(
                "UIH5/Common/ItemView/ItemPetBodyBaseView",
                _G.ePoolType.UIItem,
                tb.obj_PetItem,
                _G.handlerbind(self, self.OnPetSpawnCall, tb)
            )
        end
    end
end

function PetFetterView:OnEnable()
    self:InitFetterList()
end

function PetFetterView:OnPetSpawnCall(trans, path, tb)
    tb.spawning = false
    tb.pet = require "ItemPetBodyBaseView".New(trans.gameObject)
    if tb.data then
        tb.pet:ShowData(tb.data)
        tb.pet.go_table.aorimage_mask:SetActiveE(tb.data:GetIsActive() and 0 or 1)
    end
end

