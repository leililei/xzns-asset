local base = require "DrawUpBattlePassTaskInfoData"
---@class PetBattlePassTaskInfoData: DrawUpBattlePassTaskInfoData
local PetBattlePassTaskInfoData = _G.BaseClass("PetBattlePassTaskInfoData", base)

---领取奖励
function PetBattlePassTaskInfoData:GetAward(ids, call)
    require "DrawUpBattlePassTaskNet":GetInstance():GetAward(
        {activity_id = self.curActivityClass:GetActivityID(), task_sid = ids, finish_type = 2},
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            ---@type ActivitySynBase
            local activity =
                require "ActivitySynManager":GetInstance():GetChildAcitivity(
                self:GetJumpModelType(),
                self.curActivityClass:GetJumpType()
            )
            local ActivityID = activity:GetActivityID()
            local exp = 0
            local coin = 0
            local coinId = require "PetDrawUpMainModel":GetInstance():GetCoinId(ActivityID)
            for _, v in pairs(ids) do
                local task = self.activity:GetTaskData(v)
                if not msg.award or not msg.award.item then
                    msg.award = {item = {}}
                end
                if task.Cfg.other_award[2] then
                    local tb = _G.StorageManager:GetInstance():SimulationAward(coinId, task.Cfg.other_award[2].num)
                    _G.table.insert(msg.award.item, {type = tb})
                    coin = coin + task.Cfg.other_award[2].num
                end
                if task.Cfg.other_award[1] then
                    exp = exp + task.Cfg.other_award[1].num
                end

                self.activity.finishTask[v] = true
            end
            require "CommonTipManager".OpenCommonAwardView(msg)
            self.activity:RefreshRedPoint()
            require "PetDrawUpMainModel":GetInstance():AddCoin(ActivityID, coin)
            require "PetDrawUpMainModel":GetInstance():AddExp(ActivityID, exp)
            if call then
                call()
            end
        end
    )
end

function PetBattlePassTaskInfoData:GetJumpModelType()
    return 10036
end

return PetBattlePassTaskInfoData
