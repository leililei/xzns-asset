---检测红点
function PetDrawUpBattlePassData:CheckRedPoint()
    ---可领奖
    if not _G.table.isEmptyOrNil(self:FindAllUnclaimedRewards(self:GetActivityID())) then
        return 1
    end
    local endTime, _ = self.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    local key =
        _G.PlayerModel:GetInstance():GetPlayerUid() ..
        "DrawUpBattlePass" .. self.curActivityClass:GetActivityID() .. endTime
    ---首次开启
    if _G.PlayerPrefsManager.GetInt(key) ~= 1 then
        return 1
    end
    local delta = _G.ConfigManager.discrete_cfg[108601][1][1]
    ---加速按钮开启
    if _G.PlayerPrefsManager.GetInt(key .. "Add") ~= 1 and _G.TimeUtil.GetServerUnixTime() >= endTime - delta * 86400 then
        return 1
    end
    return 0
end

function PetDrawUpBattlePassData:SetOnSixUpdateCall(name, callback)
    if not self.onSixUpdateCall then
        self.onSixUpdateCall = {}
    end
    self.onSixUpdateCall[name] = callback
end

function PetDrawUpBattlePassData:GetJumpModelType()
    return 10036
end

function PetDrawUpBattlePassData:InitJump()
    self.GetJumpType =
        require "ActivitySynManager":GetInstance():GetChildAcitivity(
        self:GetJumpModelType(),
        self.curActivityClass:GetJumpType()
    )
    if self.GetJumpType then
        self.ActivityID = self.GetJumpType.activityID
        require "PetDrawUpMainModel":GetInstance():ParseData(self.ActivityID, self.msg, self.activity)
    end
end

function PetDrawUpBattlePassData:GetActivityID()
    if not self.ActivityID then
        self:InitJump()
    end
    return self.ActivityID
end

function PetDrawUpBattlePassData:GetCoinId()
    return require "PetDrawUpMainModel":GetInstance():GetCoinId(self:GetActivityID())
end

