local PetDrawUpMainModel = require("PetDrawUpMainModel")
local BaseAwardNewItem = require("BaseAwardNewItem")
---@class PetDrawUpAwardPreView : UIBaseView	中文描述
---@field public go_table PetDrawUpAwardPreView_GoTable GoTable
local PetDrawUpAwardPreView = _G.BaseClass("PetDrawUpAwardPreView", _G.UIBaseView)

function PetDrawUpAwardPreView:Awake()
    self.AwardDatas = {}
    self.itemList = {}
    self.weight = 0
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function PetDrawUpAwardPreView:OnCreate(activityID)
    local data = PetDrawUpMainModel:GetInstance():Getlimited_roller_cfg(activityID)
    if data then
        local grandPrize = {}
        local limited_item = data.limited_item[1] or {}
        ---需要将灵兽sid转换成碎片的sid,同时数量也需要转换成合成的碎片数量
        local petCfg = _G.ConfigManager.pet_cfg[limited_item[1]]
        grandPrize.sid = petCfg.materials_item
        grandPrize.num = petCfg.materials_item_number[1]
        grandPrize.weight = limited_item[2] or 0
        grandPrize.Grand = true
        self.weight = self.weight + grandPrize.weight
        _G.table.insert(self.AwardDatas,grandPrize)
        for _, v in pairs(data.pool) do
            local item ={}
            item.sid = v[1]
            item.num = v[2]
            item.weight = v[3] or 0
            self.weight = self.weight + item.weight
            _G.table.insert(self.AwardDatas,item)
        end
    end
    self.go_table.scrollloopvectical_AwardList:InitItemData(#self.AwardDatas, _G.handler(self, self.RefreshList))
end

---刷新显示
function PetDrawUpAwardPreView:RefreshList(index, obj)
    local instanceID = obj:GetInstanceIDE()
    local tb = self.itemList[instanceID]
    local data = self.AwardDatas[index + 1]
    if not data then
        return
    end
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        self.itemList[instanceID] = tb
        ---@type BaseAwardNewItem
        tb.item = BaseAwardNewItem.New(tb.obj_Root, _G.handler(self, self.OnClickItem), 96)
    end
    ---@param item BaseAwardNewItem
    tb.item:ShowWithID(
        {data.sid,data.num},
        nil,
        function(item)
            if item.item.HideOrShowStar then
                item.item:HideOrShowStar(false)
            end
            item:ShowEffect(data.Grand)
        end
    )
    tb.aortext_probNum.text = self:GetPerData(index + 1) .. "%"
end

---点击奖励
function PetDrawUpAwardPreView:OnClickItem(item)
    require "CommonTipManager":GetInstance():OpenTip(item.gameObject, item.data.sid)
end

---按钮点击事件在这里派发
function PetDrawUpAwardPreView:OnClickBtn(go, isOn)
    self:Close()
end

function PetDrawUpAwardPreView:GetPerData(index)
    local weight = self.AwardDatas[index].weight/self.weight*100
    weight = string.format("%.2f", weight)
    return weight
end
return PetDrawUpAwardPreView