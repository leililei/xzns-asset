---@class PetWishPetSelectView : UIBaseView	中文描述
---@field public go_table PetWishPetSelectView_GoTable GoTable
local PetWishPetSelectView = _G.BaseClass("PetWishPetSelectView", _G.UIBaseView)

function PetWishPetSelectView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function PetWishPetSelectView:OnCreate(ackctivityID, callback)
    self.ackctivityID = ackctivityID
    self.callback = callback
    self.AwardDatas = require "PetDrawUpMainModel":GetInstance():Getlimited_itemId(ackctivityID)
    self.wishId = require("PetDrawUpMainModel"):GetInstance():GetItemId(ackctivityID)

    ---页面选中
    self.index = self.AwardDatas[1][1]
    if self.wishId ~= 0 then
        self.index = self.wishId
    end
    self.itemList = {}
    self.go_table.scrollloopvectical_AwardList:InitItemData(#self.AwardDatas, _G.handler(self, self.RefreshList))
end

function PetWishPetSelectView:RefreshList(index, obj)
    local instanceID = obj:GetInstanceIDE()
    local tb = self.itemList[instanceID]
    local data = self.AwardDatas[index + 1][1]
    local pet_cfg = _G.ConfigManager.pet_cfg[data]

    if not pet_cfg then
        return
    end
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj,_G.handlerbind(self, self.OnClickItem, index + 1,tb,data))
        self.itemList[instanceID] = tb
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemPetBase,
            tb.obj_Root,
            function(item)
                if _G.IsNil(tb.obj_Root) then
                    _G.ItemFactory:GetInstance():SetItemCard(item)
                   return 
                end
                self.itemList[instanceID].item = item
                local petData = require("PetModel"):GetInstance():GetPet(data)
                item:ShowData(petData)
            end
        )
    else
        local petData = require("PetModel"):GetInstance():GetPet(data)
        self.itemList[instanceID].item:ShowData(petData)
    end
    if self.index == self.AwardDatas[index + 1][1] then
        tb.obj_eff:SetActiveE(1)
    else
        tb.obj_eff:SetActiveE(0)
    end
    tb.aortext_name.text = _G.LangUtil.GetLangPackValue(pet_cfg.Name)
end

---点击切换
function PetWishPetSelectView:OnClickItem(_, _, index,item,data)
    if index == self.wishId then
        return
    end
    self.index = self.AwardDatas[index][1]
    self.go_table.scrollloopvectical_AwardList:UpdateCount(#self.AwardDatas)
    require "CommonTipManager":GetInstance():OpenTip(item.gameObject, data)
end

---点击奖励
function PetWishPetSelectView.OnClickonDown_Uplv(item, self)
    require "CommonTipManager":GetInstance():OpenTip(self.gameObject, item)
end

---界面的销毁函数
function PetWishPetSelectView:OnDestroy()
end

---按钮点击事件在这里派发
function PetWishPetSelectView:OnClickBtn(go)
    if go == self.go_table.aorbtn_shadow or go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_quXiao then
        self:Close()
    elseif go == self.go_table.aorbtn_queding then
        if #self.AwardDatas <= 1 then
            ---只有一个心愿灵兽，点确认按钮关闭界面
            self:Close()
        end

        if self.wishId == self.index then
            return
        end

        require("PetDrawUpMainModel"):GetInstance():SetWishPet(self.ackctivityID, self.index, function()
            if self.callback then
                self.callback(self.index)
            end
            self:Close()
        end)
    end
end

return PetWishPetSelectView