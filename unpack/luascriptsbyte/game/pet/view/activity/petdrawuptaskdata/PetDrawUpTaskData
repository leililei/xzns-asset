---@class PetDrawUpTaskData : Component	起源召唤任务
local PetDrawUpTaskData = _G.BaseClass("PetDrawUpTaskData", _G.LogicClass)

---类的析构函数
---解析
---创建对象时,入口构造函数
---@param task task.i_task
---@param call function 任务完成后执行函数(刷新相关界面等)
function PetDrawUpTaskData:__init(task, call)
    self.call = call
    self:ParseData(task)
end

function PetDrawUpTaskData:ParseData(task)
    self.cfg = task.cfg
    self.i_task = task

    if not self.taskEnumType then
       self.taskEnumType = self.cfg.condition[1]
       self.taskcontentparams = self.cfg.condition
    end
    if not self.i_task.taskEnumType then
        self.i_task.taskEnumType = self.cfg.condition[1]
        self.i_task.taskcontentparams = self.cfg.condition
    end
    self:CheckTaskTarget()
    self:CheckTaskState()
end

function PetDrawUpTaskData:CheckTaskTarget()
end

function PetDrawUpTaskData:CheckTaskState() 
end

return PetDrawUpTaskData