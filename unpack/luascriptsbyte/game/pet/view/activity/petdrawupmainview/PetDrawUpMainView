function PetDrawUpMainView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    PetDrawUpMainModel:GetInstance().InDrawing = false
end

---按钮点击事件在这里派发
function PetDrawUpMainView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
       self:Close()
    elseif go == self.go_table.aorbtn_rank then
        ---排行榜界面
        if PetDrawUpMainModel:GetInstance().InDrawing then
            return
        end
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CommonRankView.Name,
            _G.CommonRankType.PetDrawUp,
            self.activityID
        )
    elseif go == self.go_table.aorbtn_wishPet or go == self.go_table.aorbtn_switchWishPet then
        ---切换心愿灵兽
        if PetDrawUpMainModel:GetInstance().InDrawing then
            return
        end
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.PetWishPetSelectView.Name,
            self.activityID,
            function()
                self:SwitchImage()
                self:SetTipInfo()
            end
        )
    elseif go == self.go_table.aorbtn_DrawOnce then
        ---抽一次
        self:DrawCard(_G.DrawType.once)
    elseif go == self.go_table.aorbtn_DrawTenTimes then
        ---抽十次
        self:DrawCard(_G.DrawType.TenTimes)
    elseif go == self.go_table.aorbtn_battlePass then
        ---宝典
        if PetDrawUpMainModel:GetInstance().InDrawing then
            return
        end
        _G.GlobalInterface.JumpActivityByGM(10027, self.activity:GetJumpType(self.activityID))
    elseif go == self.go_table.aorbtn_gift then
        ---礼包
        if PetDrawUpMainModel:GetInstance().InDrawing then
            return
        end
        _G.GlobalInterface.JumpActivityByGM(10014, self.activity:GetJumpType(self.activityID))
    elseif go == self.go_table.aorbtn_task then
        ---任务
        if PetDrawUpMainModel:GetInstance().InDrawing then
            return
        end
        _G.GlobalInterface.JumpActivityByGM(10007, self.activity:GetJumpType(self.activityID))
    elseif go == self.go_table.aorbtn_packGift then
        ---锻造豪礼
        if PetDrawUpMainModel:GetInstance().InDrawing then
            return
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.PetDrawUpPackGiftView.Name, self.activity)
    elseif go == self.go_table.aorbtn_help1 then
        ---帮助信息
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 123)
    end
end

---界面的入口函数
function PetDrawUpMainView:OnCreate(activity)
    self.activity = activity
    self.activityID = activity.activityID
    self.coinId = PetDrawUpMainModel:GetInstance():GetCoinId(self.activityID)

    self:InitResources()
    self:RefreshView()
    self:InitExtendText()
    self:SwitchImage()
    self:UpdateTimer()
    if not self.activityTimer then
        self.activityTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimer, self, false, false, true)
        self.activityTimer:Start()
    end

    ---设置红点参数
    self.go_table.obj_redpointPackGift:UpdateRedPointItemIDAndParam(
        self.activity:GetActivityTypeCls():GetRedpointIDByIndex(2)
    )

    local topThreeNum = _G.ConfigManager.discrete_cfg[108603][1][3]
    self.go_table.aortext_ranktip.text = _G.GetLangPackValue(90031300031, topThreeNum)

    ---背景特效
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_PetFetterView_bg,
        self.go_table.aorrawimage_di,
        function(tran)
            if _G.IsNil(self.go_table.aorrawimage_di) then
                tran:DestroyObject()
                return
            end
        end
    )

    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.LoadConsumesInfos, self)
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.ResRefresh, self.LoadConsumesInfos, self)
end

---刷新按钮
function PetDrawUpMainView:RefreshBtnRedPoint()
    ---礼包红点
    local giftActivity = ActivitySynManager:GetInstance():GetChildAcitivity(10014, self.activity:GetJumpType(self.activityID))
    if giftActivity then
        self.go_table.obj_redpointGift:UpdateRedPointItemIDAndParam(
            giftActivity:GetActivityTypeCls():GetRedpointIDByIndex(1)
        )

        self.go_table.aorbtn_gift:SetActiveE(1)
    else
        self.go_table.aorbtn_gift:SetActiveE(0)
    end

    ---宝典红点
    local battlePassActivity = ActivitySynManager:GetInstance():GetChildAcitivity(10027, self.activity:GetJumpType(self.activityID))
    if battlePassActivity then
        self.go_table.obj_redpointBattlePass:UpdateRedPointItemIDAndParam(
            battlePassActivity:GetActivityTypeCls():GetRedpointIDByIndex(1)
        )

        self.go_table.aorbtn_battlePass:SetActiveE(1)
    else
        self.go_table.aorbtn_battlePass:SetActiveE(0)
    end

    ---任务红点
    local taskActivity = ActivitySynManager:GetInstance():GetChildAcitivity(10007, self.activity:GetJumpType(self.activityID))
    if taskActivity then
        self.go_table.obj_redpointask:UpdateRedPointItemIDAndParam(
            taskActivity:GetActivityTypeCls():GetRedpointIDByIndex(1)
        )

        self.go_table.aorbtn_task:SetActiveE(1)
    else
        self.go_table.aorbtn_task:SetActiveE(0)
    end
end

---倒计时
function PetDrawUpMainView:UpdateTimer()
    local leftTime = PetDrawUpMainModel:GetInstance():GetTime(self.activityID)
    if leftTime <= 0 then
        self.activityTimer:Stop()
        self.go_table.aortext_Timer.text = ""
        self:Close()
    else
        self.go_table.aortext_Timer.text =
            _G.GetLangPackValue(langugageId.Tiem, _G.TimeUtil.TranslateSecondForStrMiaoHui(leftTime, 1))
    end
end

---图片切换
function PetDrawUpMainView:SwitchImage()
    local itemId = PetDrawUpMainModel:GetInstance():GetItemId(self.activityID)
    local petCfg = _G.ConfigManager.pet_cfg[itemId]
    if not petCfg then
       return
    end

    ---立绘图片更新
    if not _G.string.IsNullOrEmpty(petCfg.spine_1) then
        local portrait = petCfg.spine_portrait3
        local scale, pos
        if not _G.table.isEmptyOrNil(portrait) then
            pos = {portrait[1], portrait[2], portrait[3]}
            scale = {portrait[4], portrait[4], portrait[4]}
        end
        _G.UIUtils.LoadEffectByPath(
            petCfg.spine_1,
            self.go_table.obj_Sprie,
            function(trans)
                if _G.IsNil(self.go_table.obj_Sprie) then
                    _G.DestroyObject(trans)
                end
            end,
            nil,
            nil,
            pos,
            scale
        )
    end

    ---名字立绘图片更新
    self.go_table.aorrawimage_Name:LoadImage(
        petCfg.image_2,
        function(image)
            if _G.IsNil(self.go_table.aorrawimage_Name) then
                return
             end
            if image then
                image:SetActiveE(1)
                image:SetNativeSize()
            end
        end
    )
    self.go_table.obj_Sprie:ClearChildren()
    local effects = petCfg.effect
    local parent
    for _, v in pairs(effects) do
        parent = self.go_table.obj_Sprie
        _G.UIUtils.LoadEffectByPath(
            v[2],
            parent,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                trans:SetLocalPosition(v[3], v[4], v[5])
                trans:SetLocalScaleXYZ(v[6])
            end,
            nil,
            nil,
            nil,
            nil,
            nil,
            true
        )
    end
end

function PetDrawUpMainView:InitExtendText()
    if not self.ExtendText then
        self.ExtendText = self.go_table.obj_goto:GetComponentE(_G.typeof(_G.CS.ExtendText))
        self.ExtendText.OnHrefClick:AddListener(_G.handler(self, self.OnHrefClick))
    end
    local str = _G.GetLangPackValue(langugageId.get)
    str = _G.string.format(string.format("<%s@%s>", str, str))
    self.ExtendText.text = str
end

