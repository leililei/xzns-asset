---加载招募消耗信息
function PetDrawUpMainView:LoadConsumesInfos()
    ---获取代币数量
    local coinNum = PetDrawUpMainModel:GetInstance():GetPropNum(self.activityID)
    ---获取魂玉召唤次数
    local totalTimes = PetDrawUpMainModel:GetInstance():GetDiamondTotalTimes(self.activityID)
    local usedTimes = PetDrawUpMainModel:GetInstance():GetDiamondTimes(self.activityID)
    local remainTimes = totalTimes - usedTimes

    local isUseDiamode = false
    local leftIcon, leftNum, rightNum, rightIcon
    ---单抽
    if coinNum >= 1 or totalTimes == 0 or remainTimes < 1 then
        leftNum = 1
        leftIcon = self:getCurrencyTypeIcon(self.coinId)
    else
        leftNum = PetDrawUpMainModel:GetInstance():GetDiamondConsume(self.activityID, 1)
        leftIcon = _G.StorageManager:GetInstance():GetItemIcon(_G.ResPropID.Diamond)

        isUseDiamode = true
    end

    ---多抽
    self.go_table.aortext_PropRightNum.text = ""
    if coinNum >= 1 or totalTimes == 0 or remainTimes < 10 then
        if coinNum >= 10 then
            rightNum = 10
        else
            rightNum = coinNum > 0 and coinNum or 10
        end
        rightIcon = self:getCurrencyTypeIcon(self.coinId)
    else
        rightNum = PetDrawUpMainModel:GetInstance():GetDiamondConsume(self.activityID, 10)
        rightIcon = _G.StorageManager:GetInstance():GetItemIcon(_G.ResPropID.Diamond)
        isUseDiamode = true
    end
    self.go_table.aortext_PropLeftNum.text = leftNum

    if isUseDiamode then
        self.drawConsumeType = _G.DrawConsumeType.diamond
        self.go_table.aortext_PropRightNumDesc.text =
            _G.GetLangPackValue(90031300043, _G.GameUtil.NumberToWordByLanguage(10))
    else
        self.drawConsumeType = _G.DrawConsumeType.token
        self.go_table.aortext_PropRightNumDesc.text =
            _G.GetLangPackValue(90031300043, _G.GameUtil.NumberToWordByLanguage(rightNum))
    end

    if isUseDiamode then
        local limited_roller_cfg = PetDrawUpMainModel:GetInstance():Getlimited_roller_cfg(self.activityID)
        local discount = limited_roller_cfg.ticket_discount[1]
        if discount and remainTimes >= 10 then
            self.go_table.aortext_PropRightNum.text = _G.string.format("%.0f", rightNum * discount / 10000)
            ---使用魂玉时的折扣
            self.go_table.obj_discount:SetActiveE(1)
            if _G.GameUtil.GetIsUseChinese() then
                self.go_table.aortext_discount.text =
                _G.GetLangPackValue(90028800006, string.format("%.1f", discount / 1000))
            else
                self.go_table.aortext_discount.text =
                _G.GetLangPackValue(90028800006, string.format("%d%%", 100 - (discount / 100)))
            end
        else
            self.go_table.aortext_PropRightNum.text = rightNum
            self.go_table.obj_discount:SetActiveE(0)
        end
    else
        self.go_table.obj_discount:SetActiveE(0)
        self.go_table.aortext_PropRightNum.text = rightNum
    end
    self.go_table.obj_hongDian:SetActiveE(coinNum >= 10 and 1 or 0)
    self.go_table.aorrawimage_PropLeft:LoadImage(
        leftIcon,
        function(image)
            if image then
                image:SetActiveE(1)
            end
        end
    )
    self.go_table.aorrawimage_PropRight:LoadImage(
        rightIcon,
        function(image)
            if image then
                image:SetActiveE(1)
            end
        end
    )
end

---加载魂玉召唤次数信息
function PetDrawUpMainView:LoadDiamondTimes()
    --获取魂玉召唤次数信息
    local usedTimes = PetDrawUpMainModel:GetInstance():GetDiamondTimes(self.activityID)
    local totalTimes = PetDrawUpMainModel:GetInstance():GetDiamondTotalTimes(self.activityID)
    self.go_table.obj_diamondTimes:SetActiveE(totalTimes > 0 and 1 or 0)
    if totalTimes <= 0 then
        return
    end

    local remain = totalTimes - usedTimes
    self.go_table.aortext_remainDiamondTimes.text = _G.GetLangPackValue(90022300102, remain .. "/" .. totalTimes)
end

---概率提升显示
function PetDrawUpMainView:SetTipInfo()
    local GetTotalTimes = PetDrawUpMainModel:GetInstance():GetTotalTimes(self.activityID)
    local limited_roller_cfg = PetDrawUpMainModel:GetInstance():Getlimited_roller_cfg(self.activityID)
    local Max = limited_roller_cfg.guaranteed_init

    if GetTotalTimes >= Max then
        Max = limited_roller_cfg.pseudo
    end
    local sid = PetDrawUpMainModel:GetInstance():GetItemId(self.activityID)
    self.go_table.aortext_Num.text =
        _G.GetLangPackValue(
        langugageId.GaiLv,
        Max - PetDrawUpMainModel:GetInstance():GetTimes(self.activityID),
        _G.GetLangPackValue(_G.ConfigManager.pet_cfg[sid].Name)
    )
end

---获取排行榜数据
function PetDrawUpMainView:GetRankInfo()
    PetDrawUpMainModel:GetInstance():GetRankInfo(self.activityID, 1, function(rankDatas)
        self.topThreeRankData = rankDatas
        self:RefreshRank()
    end, function(mineRank, mineValue)
        self:RefreshMineRank(mineRank, mineValue)
    end)
end

---刷新排行榜显示
function PetDrawUpMainView:RefreshRank()
    if not self.rankListView then
        self.go_table.scrollloopvectical_rankList:InitItemData(3, _G.handler(self, self.RefreshRankItem))
        self.rankListView = self.go_table.scrollloopvectical_rankList
    else
        self.rankListView:UpdateCount(3)
    end
end

function PetDrawUpMainView:RefreshRankItem(index, obj)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj)
    tb.aorimage_rankIcon.SpriteName = "tz_qjhs_phb_mingci_0" .. index
    if not _G.table.isEmptyOrNil(self.topThreeRankData[index]) then
        tb.aortext_rankname.text = self.topThreeRankData[index].role_info.name
    else
        tb.aortext_rankname.text = _G.GetLangPackValue(90000010159)
    end
end

---刷新排行榜自己的排名
function PetDrawUpMainView:RefreshMineRank(mineRank)
    if not mineRank or mineRank <= 0 or mineRank > 1000 then
        self.go_table.aortext_notrank:SetActiveE(mineRank > 1000 and 0 or 1)
        if mineRank > 1000 then
            self.go_table.aortext_rankscore.text = "1000+"
        else
            self.go_table.aortext_rankscore.text = ""
        end
        self.go_table.aorimage_rankIcon:SetActiveE(0)
    else
        self.go_table.aorimage_rankIcon:SetActiveE(mineRank <= 3 and 1 or 0)
        self.go_table.aortext_rankscore:SetActiveE(mineRank > 3 and 1 or 0)
        self.go_table.aortext_notrank:SetActiveE(0)

        if mineRank <= 3 then
            self.go_table.aorimage_rankIcon.SpriteName = "tz_qjhs_phb_mingci_0" .. mineRank
        else
            self.go_table.aortext_rankscore.text = mineRank
        end
    end
    self.go_table.aortext_rankname.text = _G.PlayerModel:GetInstance():GetName()
end

function PetDrawUpMainView:DrawCard(type)
    if PetDrawUpMainModel:GetInstance().InDrawing then
       return
    end

    --获取拥有的代币数量
    local coinNum = PetDrawUpMainModel:GetInstance():GetPropNum(self.activityID)
    local num = 0
    if self.drawConsumeType == _G.DrawConsumeType.diamond then
        num = type == _G.DrawType.once and 1 or 10
    else
        local ten = coinNum >= 10 and 10 or coinNum
        num = type == _G.DrawType.once and 1 or (ten > 0 and ten or 10)
    end

    --获取魂玉召唤总次数
    local totalTimes = PetDrawUpMainModel:GetInstance():GetDiamondTotalTimes(self.activityID)
    local remainTimes = totalTimes - PetDrawUpMainModel:GetInstance():GetDiamondTimes(self.activityID)

    ---@type number 消耗模式: 1活动代币 2魂玉
    local consumeType = nil
    local consumeNum = 0
    if coinNum >= num or totalTimes == 0 or remainTimes < num then
        --检查招募券数量
        if coinNum < num then
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.GetItemWayView.Name,
                PetDrawUpMainModel:GetInstance():GetCoinId(self.activityID)
            )
            return
        end
        consumeType = _G.DrawConsumeType.token
    else
        --检查魂玉数量
        consumeNum = PetDrawUpMainModel:GetInstance():GetDiamondConsume(self.activityID, num)
        if type == _G.DrawType.TenTimes then
            local limited_roller_cfg = PetDrawUpMainModel:GetInstance():Getlimited_roller_cfg(self.activityID)
            local discount = limited_roller_cfg.ticket_discount[1]
            if discount then
                consumeNum = _G.Mathf.Floor(consumeNum * discount / 10000)
            end
        end
        local ownNum = _G.StorageManager:GetInstance():GetItemCountBySid(_G.ResPropID.Diamond)
        if ownNum < consumeNum then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ResPropID.Diamond)
            return
        end
        consumeType = _G.DrawConsumeType.diamond
    end
    if num > 0 then
        if consumeType == _G.DrawConsumeType.diamond then
            _G.PopWindowManager:GetInstance():ShowDrawWindowByToggle(
                340605,
                _G.DrawRollerType.PetDrawUp,
                PetDrawUpMainModel:GetInstance():GetCfgId(self.activityID),
                num,
                consumeNum,
                function()
                    PetDrawUpMainModel:GetInstance():DrawCard(
                        self.activityID,
                        consumeType,
                        num,
                        _G.handler(self, self.RefreshView),
                        _G.handlerbind(self, self.IsEff)
                    )
                end,
                function()
                end
            )
        else
            PetDrawUpMainModel:GetInstance():DrawCard(
                self.activityID,
                consumeType,
                num,
                _G.handler(self, self.RefreshView),
                _G.handlerbind(self, self.IsEff)
            )
        end
    end
end

---特效显示隐藏
function PetDrawUpMainView:IsEff(num, call)
    self.var = self.go_table.aorimage_onceZi
    local it = _G.ConfigManager.ui_effect_cfg["ef_DrawUpMainView_once_zi"].LifeTime

    if num == 0 then
        self.go_table.aorimage_onceZi:SetActiveE(1)
    elseif num == 1 then
        it = _G.ConfigManager.ui_effect_cfg["ef_DrawUpMainView_once_jin"].LifeTime

        self.go_table.aorimage_onceJin:SetActiveE(1)
        self.var = self.go_table.aorimage_onceJin
    end
    if not self.eff then
        self.eff = _G.TimerManager:GetInstance():GetTimer(it, self.EffClose, self, false, false, true, call)
        self.eff:Start()
    end
end

function PetDrawUpMainView:EffClose(call)
    if self.eff then
        self.eff:Stop()
        self.eff = nil
    end
    if self.var then
        self.var:SetActiveE(0)
    end
    if call then
        call()
    end
end

function PetDrawUpMainView:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.LoadConsumesInfos, self)
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.ResRefresh, self.LoadConsumesInfos, self)
    if self.activityTimer then
        self.activityTimer:Stop()
        self.activityTimer = nil
    end
end

return PetDrawUpMainView