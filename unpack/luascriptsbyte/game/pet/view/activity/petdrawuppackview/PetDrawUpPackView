local baseView = require("DrawUpPackView")
---@class PetDrawUpPackView : UIBaseView	中文描述
---@field public go_table PetDrawUpPackView_GoTable GoTable
local PetDrawUpPackView = _G.BaseClass("PetDrawUpPackView", baseView)

---界面的入口函数
function PetDrawUpPackView:OnCreate(data, type_enum)
    self.GetJumpType = require "ActivitySynManager":GetInstance():GetChildAcitivity(10036, data:GetJumpType())
    self.ActivityID = self.GetJumpType.activityID
    if not _G.IsNil(self.go_table.obj_goldInfo) and self.go_table.obj_goldInfo:GetctiveInHierarchy() == 1 then
        ---添加要显示的货币或者资源
        local resources = _G.ConfigManager.ui_cfg.PetDrawUpPackView.resources
        if #resources > 0 then
            self:AddComponent(
                self.go_table.obj_goldInfo,
                require("ResourceCompont").New(self.go_table.obj_goldInfo, resources)
            )
        end
    end
    baseView.UpdateView(self, data, type_enum)
    if not _G.string.IsNullOrEmpty(data.cfg.info.icon) then
        self.go_table.aorrawimage_titlebg:LoadImage(
            "Images/" .. data.cfg.info.icon,
            function(raw)
                raw:SetNativeSize()
            end
        )
    end
    baseView.UIEffect(self)
end

return PetDrawUpPackView