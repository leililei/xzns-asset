local PetDrawUpMainModel = require("PetDrawUpMainModel")
---@class PetDrawUpPackGiftView : UIBaseView	召唤豪礼
---@field public go_table PetDrawUpPackGiftView_GoTable GoTable
local PetDrawUpPackGiftView = _G.BaseClass("PetDrawUpPackGiftView", _G.UIBaseView)

local langugageId = {
    ---活动时间
    time = 90029000005
}
local GetLangPackValue = _G.GetLangPackValue
local store_extra_cfg = _G.ConfigManager.store_extra_cfg

function PetDrawUpPackGiftView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function PetDrawUpPackGiftView:OnCreate(activity)
    self.activity = activity
    self.ActivityID = activity.activityID
    self.coinId = PetDrawUpMainModel:GetInstance():GetCoinId(self.ActivityID)
    self.cfg = PetDrawUpMainModel:GetInstance():Getlimited_roller_cfg(self.ActivityID)
    self.totalDrawNum = PetDrawUpMainModel:GetInstance():GetTotalTimes(self.ActivityID)
    self.countDown = PetDrawUpMainModel:GetInstance():GetTime(self.ActivityID)
    self.go_table.aortext_time.text = GetLangPackValue(langugageId.time, _G.TimeUtil.TranslateSecondForStrMiaoHui(self.countDown))
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()
    self:AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    self:InitView()
end

function PetDrawUpPackGiftView:UpdateTime(elapsed)
    if self:IsNil() then
        return
    end
    self.countDown = self.countDown - elapsed
    if self.countDown < 0 then
        self.countDown = 0
    end
    local time = _G.Mathf.RoundToInt(self.countDown)
    self.go_table.aortext_time.text = GetLangPackValue(langugageId.time, _G.TimeUtil.TranslateSecondForStrMiaoHui(time))
end

---初始化界面
function PetDrawUpPackGiftView:InitView()
    local pets = PetDrawUpMainModel:GetInstance():Getlimited_itemId(self.ActivityID)
    local cfg = _G.ConfigManager.pet_cfg[pets[1][1]]
    self.go_table.aortext_curNum.text = self.totalDrawNum

    ---立绘图片更新
    if not _G.string.IsNullOrEmpty(cfg.spine_1) then
        local portrait = cfg.spine_portrait3
        local scale, pos
        if not _G.table.isEmptyOrNil(portrait) then
            pos = {portrait[1], portrait[2], portrait[3]}
            scale = {portrait[4], portrait[4], portrait[4]}
        end
        _G.UIUtils.LoadEffectByPath(
            cfg.spine_1,
            self.go_table.obj_Sprie,
            function(trans)
                if _G.IsNil(self.go_table.obj_Sprie) then
                    _G.DestroyObject(trans)
                end
            end,
            nil,
            nil,
            pos,
            scale
        )
    end

    self.go_table.obj_petEff:ClearChildren()
    local effects = cfg.effect
    for _, v in pairs(effects) do
        _G.UIUtils.LoadEffectByPath(
            v[2],
            self.go_table.obj_petEff,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                trans:SetLocalPosition(v[3], v[4], v[5])
                trans:SetLocalScaleXYZ(v[6])
            end,
            nil,
            nil,
            nil,
            nil,
            nil,
            true
        )
    end
    local res = _G.ConfigManager.ui_cfg.PetDrawUpPackGiftView.resources
    local newResource = {}
    for i = 1, #res do
        newResource[i] = res[i] == 106 and self.coinId or res[i]
    end
    self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, newResource))
    self.go_table.scrollloopvectical_item:InitItemData(#self.cfg.rewards_count, _G.handler(self, self.RefreshList))
end

function PetDrawUpPackGiftView:RefreshList(index, obj)
    index = index + 1
    local needNum = self.cfg.rewards_count[index]
    local freeAwards = self.cfg.rewards_item[index]
    local gift = self.cfg.rewards_goods[index]
    local payCfg = store_extra_cfg[gift[1]]
    ---@type ArtifactDrawUpPackGiftView._obj_item_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, index, payCfg))
    local canGet = self.totalDrawNum >= needNum
    local nextCanGet = false
    if index < #self.cfg.rewards_count and self.totalDrawNum >= self.cfg.rewards_count[index + 1] then
        nextCanGet = true
    end
    local lastTime = payCfg.count_limit - PetDrawUpMainModel:GetInstance():GetCashGiftBuyNum(self.ActivityID, gift[1])
    if lastTime < 0 then
        lastTime = 0
    end
    local soldOut = lastTime == 0
    local freeGet = PetDrawUpMainModel:GetInstance():IsReceiveAward(self.ActivityID, index)
    tb.aortext_num.text = needNum
    tb.aortext_limite.text = GetLangPackValue(90023800079, lastTime, payCfg.count_limit)
    tb.aortext_limite:SetActiveE(soldOut and 0 or 1)
    tb.aorimage_bgCur:SetActiveE(canGet and 1 or 0)
    tb.aorimage_sliderBg:SetActiveE(index < #self.cfg.rewards_count and 1 or 0)
    tb.aorimage_slider:SetActiveE(nextCanGet and 1 or 0)
    tb.aorbtn_buy:SetGray(not canGet)
    tb.aorbtn_buy:SetActiveE(soldOut and 0 or 1)
    tb.obj_soldout:SetActiveE(soldOut and 1 or 0)
    tb.aorbtn_clickObj:SetActiveE((canGet and not freeGet) and 1 or 0)
    local curPrice = _G.GameUtil.RatioControl(payCfg.price)
    local dataInfo = _G.LoginManager:GetInstance():GetGooglePayInfoByPrice(payCfg.price)
    if dataInfo then
        tb.aortext_price.text = dataInfo.formattedPrice
    else
        if _G.AppSetting.IsOverseas then
            tb.aortext_price.text = GetLangPackValue(90000010807) .. curPrice
        else
            tb.aortext_price.text = GetLangPackValue(90000010819, curPrice)
        end
    end

    tb.obj_AwardNodeFree:ClearChildren()
    tb.obj_AwardNodeBuy:ClearChildren()
    local array = #freeAwards == 1 and {self.coinId, freeAwards[1]} or freeAwards
    self:SetItem(array, tb.obj_AwardNodeFree, freeGet, canGet)
    if gift[2] > 0 then
        self:SetItem({self.coinId, gift[2]}, tb.obj_AwardNodeBuy, soldOut, canGet)
    end
    for _, v in pairs(payCfg.goods) do
        self:SetItem(v, tb.obj_AwardNodeBuy, soldOut, canGet)
    end
end

function PetDrawUpPackGiftView:SetItem(array, parent, setGou, canGet)
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        array,
        parent,
        function(item)
            item:SetGou(setGou)
            if item.ShowNumText then
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
            item.gameObject:SetRectTransformSize(78, 78)
            item.gameObject:SetLocalScaleXYZ(0.88)
            item:ShowEffect(canGet and not setGou)
        end
    )
end

function PetDrawUpPackGiftView:UpdateView()
    self.go_table.scrollloopvectical_item:UpdateAllItem()
end

function PetDrawUpPackGiftView:OnClickItem(go, isOn, index, cfg)
    local needNum = self.cfg.rewards_count[index]
    if self.totalDrawNum < needNum then
        return
    end
    local name = go:GetName()
    if name == "@_aorbtn_clickObj" then
        PetDrawUpMainModel:GetInstance():GetPackGiftAward(self.ActivityID, index, _G.handler(self, self.UpdateView))
    elseif name == "@_aorbtn_buy" then
        require("MallManager"):GetInstance():BuyActiveGift(cfg.price, self.ActivityID, cfg.id)
    end
end

function PetDrawUpPackGiftView:OnMallCashListener(data)
    self:UpdateView()
end

function PetDrawUpPackGiftView:OnClickBtn(go, _)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

function PetDrawUpPackGiftView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

return PetDrawUpPackGiftView