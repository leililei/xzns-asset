local PetForestModel = require("PetForestModel")

---@class PetTreePreView : UIBaseView    中文描述
---@field public go_table PetTreePreView_GoTable GoTable
---@field cfgList limit_broken_cfg[]
local PetTreePreView = _G.BaseClass("PetTreePreView", _G.UIBaseView)

local GetAutoGoTable = _G.GetAutoGoTable
local GetLangPackValue = _G.GetLangPackValue


local iconDic = {
    ["atk"] = "ui_js_gj_icon",
    ["def"] = "ui_js_fy_icon",
    ["max_hp"] = "ui_js_sm_icon",
    ["bre"] = "ui_js_pj_icon"
}

local GetColorStrPer = function(str)
    return  "<color=#084611>" .. str .. "%" .. "</color>"
end

local GetAttrPerNum = function(attr)
    if attr then
        return _G.Mathf.Floor(attr[3] / 100)
    else
        return 0
    end
end

function PetTreePreView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function PetTreePreView:OnCreate(maxStage)
    self.maxStage = maxStage
    self:InitView()
end

function PetTreePreView:LoadEffect()
end

---初始化页面
function PetTreePreView:InitView()
    self.go_table.scrollloopvectical_level:InitItemData(self.maxStage, _G.handler(self, self.RefreshList))
    self.go_table.scrollloopvectical_level:ScrollToIndex(PetForestModel:GetInstance():GetStage() - 1)
end

function PetTreePreView:RefreshList(index, obj)
    index = index + 1
    ---@type PetTreePreView._obj_levelItem_GoTable
    local tb = GetAutoGoTable(obj)
    local cfg = _G.ConfigManager.pet_phase_cfg[index]
    tb.aortext_stage.text = GetLangPackValue(90031300026, index)
    tb.aortext_lvMax.text = GetLangPackValue(90022501211) .. cfg.max_level
    local isFirst = index == 1
    for i = 1, 4 do
        tb["aortext_attr" .. i]:SetActiveE(isFirst and 0 or 1)
        tb["aorimage_icon" .. i]:SetActiveE(isFirst and 0 or 1)
        tb.gameObject:SetRectTransformSize(556, isFirst and 100 or 200)
        if not isFirst then
            local langKey = 90010200001 + (i * 100)
            tb["aortext_attr" .. i].text = GetLangPackValue(langKey) .. GetColorStrPer("+" .. GetAttrPerNum(cfg.att[i]))
            tb["aorimage_icon" .. i].SpriteName = iconDic[cfg.att[i][1]]
        end
    end
    tb.aortext_otherAttr.text = GetLangPackValue(90031300015, GetColorStrPer(_G.Mathf.Floor(cfg.pet_trans / 100)))
    tb.aortext_unlock:SetActiveE(cfg.pet_num > 0 and 1 or 0)
    if index > 1 then
        local preCfg = _G.ConfigManager.pet_phase_cfg[index - 1]
        if cfg.pet_num <= preCfg.pet_num then
            tb.aortext_unlock:SetActiveE(0)
        end
    end
end

---按钮点击事件在这里派发
function PetTreePreView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_closeView then
        self:Close()
    end
end

---@private
function PetTreePreView:OnDestroy()
end

return PetTreePreView
