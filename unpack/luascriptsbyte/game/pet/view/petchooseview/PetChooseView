local PetModel = require("PetModel")
local PetForestModel = require("PetForestModel")
local CommonTipManager = require("CommonTipManager")

---@class PetChooseView : UIBaseView    中文描述
---@field public go_table PetChooseView_GoTable GoTable
---@field cfgList limit_broken_cfg[]
local PetChooseView = _G.BaseClass("PetChooseView", _G.UIBaseView)

local GetAutoGoTable = _G.GetAutoGoTable

function PetChooseView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function PetChooseView:OnCreate(index, call, mainView)
    self.pos = index
    self.call = call
    self.mainView = mainView
    self.pets = PetForestModel:GetInstance():GetAllActiveAndIdlePets()
    self.curSid = PetForestModel:GetInstance():GetPositionPet(index)
    if self.curSid > 0 then
        _G.table.insert(self.pets, PetModel:GetInstance():GetPet(self.curSid))
    end
    ---@param a PetData
    ---@param b PetData
    _G.table.sort(
        self.pets,
        function(a, b)
            if a.power ~= b.power then
                return a.power > b.power
            elseif a:GetOrder() ~= b:GetOrder() then
                return a:GetOrder() > b:GetOrder()
            elseif a:GetStar() ~= b:GetStar() then
                return a:GetStar() > b:GetStar()
            end
            return a.sid > b.sid
        end
    )
    self.curChooseIndex = 0
    self.curIndex = 0
    if self.curSid then
        for i = 1, #self.pets do
            if self.pets[i].sid == self.curSid then
                self.curChooseIndex = i
                self.curIndex = i
                break
            end
        end
    end
    self.scorll = self.go_table.scrollloopvectical_pet:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect))
    self:InitView()
end

function PetChooseView:LoadEffect()
end

---初始化页面
function PetChooseView:InitView()
    self.go_table.obj_no:SetActiveE(#self.pets == 0 and 1 or 0)
    self.go_table.aorbtn_sure:SetActiveE(#self.pets > 0 and 1 or 0)
    self.go_table.scrollloopvectical_pet:InitItemData(#self.pets, _G.handler(self, self.RefreshList))
    if #self.pets > 0 then
        self:ShowSkill(1)
    end
end

function PetChooseView:RefreshList(index, obj)
    index = index + 1
    obj:SetName("$_obj_petItem_" .. index)
    local data = self.pets[index]
    ---@type PetChooseView._obj_petItem_GoTable
    local tb = GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickPet, index))
    _G.SetEventTrigger(tb.aorbtn_click, "onLongPress", _G.handlerbind(self, self.OnLongPressPet, data.sid))
    _G.SetEventTrigger(tb.aorbtn_click, "onDown", _G.handler(self, self.OnDownPet))

    tb.aorimage_isOn:SetActiveE(index == self.curChooseIndex and 1 or 0)
    tb.aortext_name.text = _G.GetLangPackValue(data.cfg.Name)
    tb.data = data
    if data and not tb.spawning then
        if tb.pet then
            tb.pet:ShowData(data)
            tb.pet:SetGou(index == self.curIndex)
        else
            tb.spawning = true
            _G.PoolsManager:GetInstance():Spawn(
                "UIH5/Common/ItemView/ItemPetBase",
                _G.ePoolType.UIItem,
                tb.obj_pet,
                _G.handlerbind(self, self.OnPetSpawnCall, tb, index)
            )
        end
    end
    ---设置升级按钮 长按事件
    _G.SetEventTrigger(tb.aorbtn_click, "onDown", _G.handler(self, self.OnDownPet))
    _G.SetEventTrigger(tb.aorbtn_click, "onDrag", function(s, event) self.scorll:OnDrag(event) end)
    _G.SetEventTrigger(tb.aorbtn_click, "onDragEnd", function(s, event) self.scorll:OnEndDrag(event) end)
    _G.SetEventTrigger(tb.aorbtn_click, "onDragBegin", function(s, event) self.scorll:OnBeginDrag(event) end)
end

function PetChooseView:ShowSkill(index)
    if index then
        self.go_table.obj_petSkill:SetActiveE(1)
        self.go_table.scrollrect_content:SetActiveE(1)
        local cfg = _G.ConfigManager.card_skills_cfg[self.pets[index].cfg.skill_id[1]]
        self.go_table.aorrawimage_skill:LoadImage(cfg.icon)
        self.go_table.aortext_petSkillName.text = _G.GetLangPackValue(cfg.name1)
        local desText = self.go_table.obj_baseSkill:GetComponentE(_G.typeof(_G.CS.ExtendText))
        desText.text = _G.GetLangPackValue(self.pets[index].cfg.skill_instruction[self.pets[index]:GetStar() + 1])
        desText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))
    end
end

function PetChooseView:OnHrefClick(id, name, asa)
    -- local rect = self.go_base.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    -- local posX, posY = rect:GetRectTransformWidthHeight()
    -- require("CommonTipManager"):GetInstance():OpenSkillHyper(_G.tonumber(id), nil, posX, posY)
    require("CommonTipManager"):GetInstance():OpenSkillHyper(_G.tonumber(id), nil, 0, 0)
end

function PetChooseView:OnPetSpawnCall(trans, path, tb, index)
    tb.spawning = false
    tb.pet = require "ItemPetBase".New(trans.gameObject)
    if tb.data then
        tb.pet:ShowData(tb.data)
        tb.pet:SetGou(index == self.curIndex)
    end
end

function PetChooseView:OnClickPet(go, isOn, index)
    if self.longPress then
        return
    end
    if index == self.curChooseIndex then
        self.curChooseIndex = 0
    else
        self.curChooseIndex = index
    end
    self.go_table.scrollloopvectical_pet:UpdateAllItem()
    self:ShowSkill(index)
end

function PetChooseView:OnDownPet(go, isOn)
    if self.onPress then
        return
    end
    self.longPress = false
    self.onPress = true
end

function PetChooseView:OnLongPressPet(go, isOn, sid)
    if self.onPress then
        self.onPress = false
        self.longPress = true
        if sid then
            local isActive = PetModel:GetInstance():GetPet(sid):GetIsActive()
            CommonTipManager:GetInstance():OpenTip(self.gameObject, sid, nil, nil, not isActive)
        end
    end
end

