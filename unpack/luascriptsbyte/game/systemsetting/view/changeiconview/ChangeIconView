---@class ChangeIconList    中文描述
local ChangeIconList = _G.BaseClass("ChangeIconList")

---类的析构函数
function ChangeIconList:Dispose()
    for i = 1, #self.mIconList do
        local il = self.mIconList[i]
        il:Dispose()
    end
    self.mIconList = nil
end

function ChangeIconList:Awake()
    ---@type ChangeIconItem[]
    self.mIconList = {}
    self.count = self.transform:GetChildCountE()
    for i = 1, self.transform:GetChildCountE() do
        local item = self.transform:GetChildE(i - 1)
        if item == nil then
            break
        end
        self.mIconList[i] = ChangeIconItem.CretatItem(item, self.type, self.cilckFunction)
    end
end

function ChangeIconList:Init(index, changeIconDatas, callback)
    self.callback = callback
    if index == 0 then
        if self.gameObject:GetActiveSelf() == 1 then
            self.gameObject:SetActiveE(0)
        end
        return
    else
        if not self.gameObject:GetActiveSelf() == 1 then
            self.gameObject:SetActiveE(1)
        end
    end
    self.index = index
    if self.type == itemType.Portrait then
        self:ShowPortrait(changeIconDatas)
    else
        self:ShowFrame(changeIconDatas)
    end
end

function ChangeIconList:ShowPortrait(changeIconDatas)
    for i = 1, self.count do
        local data = changeIconDatas[i + (self.index - 1) * self.count]
        self.mIconList[i]:Init(data, self.callback)
    end
end

function ChangeIconList:ShowFrame(changeIconDatas)
    for i = 1, self.count do
        self.mIconList[i]:Init(changeIconDatas[i + (self.index - 1) * self.count], self.callback)
    end
end

function ChangeIconList:UpdateShow()
    for i = 1, #self.mIconList do
        self.mIconList[i]:UpdateShow()
    end
end

function ChangeIconList.CreateList(obj, data, type, callBack)
    local item = ChangeIconList.New()
    item.gameObject = obj
    item.transform = obj
    item.data = data
    item.cilckFunction = callBack
    item.type = type
    item:Awake()
    return item
end

