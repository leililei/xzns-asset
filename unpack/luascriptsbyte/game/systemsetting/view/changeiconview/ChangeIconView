function ChangeIconView:GetPortraitCfg()
    local channelId = tonumber(_G.SDKManager:GetInstance():GetChannelId()) or 1
    local list = {}
    for k, v in pairs(PortraitCfg) do
        if not v.condition_type or _G.GlobalConditionManager.CheckConditionArrays(v.condition_type) then
            if _G.table.isEmptyOrNil(v.channel_id) or _G.table.ContainsValue(v.channel_id, channelId) then
                _G.table.insert(list, v)
            end
        end
    end
    return list
