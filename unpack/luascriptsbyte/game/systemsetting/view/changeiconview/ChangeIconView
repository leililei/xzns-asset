---更改按钮显示
function ChangeIconView:ChangeEnterShow(data)
    if data.isUse then
        --self.go_table.aortext_desc.text = "<color=#814801>" .. _G.LangUtil.TryGetLangValue(90012500601) .. "</color>"
        self.go_table.aorbtn_enter:SetActiveE(0)
        self.go_table.aorbtn_use:SetActiveE(1)
        self.go_table.obj_tujing:SetActiveE(0)
    else
        local str = ""
        if data.isLock then
            str = "<color=#515268>" .. _G.LangUtil.GetLangPackValue(90012500701) .. "</color>" --未获得
        else
            str = _G.LangUtil.GetLangPackValue(90021300049)                                    --"确定更换"
        end
        self.go_table.aortext_desc.text = str
        self.go_table.aorbtn_enter.interactable = not (data.isLock)
        self.go_table.aorbtn_enter.ClickAnimation = not (data.isLock)
        --self.go_table.aorbtn_enter:SetGray(data.isLock)
        --self:UpdateEnterLabel()
        if data.isLock then
            self.go_table.obj_tujing:SetActiveE(1)
            self.go_table.aorbtn_enter:SetActiveE(0)
            self.go_table.aorbtn_use:SetActiveE(0)
        elseif data.isLock ~= nil then
            self.go_table.obj_tujing:SetActiveE(0)
            self.go_table.aorbtn_enter:SetActiveE(1)
            self.go_table.aorbtn_use:SetActiveE(0)
        else
            self.go_table.obj_tujing:SetActiveE(0)
            self.go_table.aorbtn_enter:SetActiveE(0)
            self.go_table.aorbtn_use:SetActiveE(0)
        end
    end
end

