function ChangeIconView:RefreshRole(listView2, index)
    index = index + 1
    local trans = listView2:NewListViewItem("$_obj_ListItem")
    trans:SetName(index)
    local instance = trans:GetInstanceIDE()
    if not self.Roles[instance] then
        self.Roles[instance] = ChangeRoleItemList.Create(trans, _G.handler(self, self.OnClickRole))
    end
    self.Roles[instance]:UpdateData(self.CardList, index)

    local card
    if self.curItem ~= nil then
        for i = 1, 4 do
            card = self.CardList[(index - 1) * 4 + i]
            if card and card.isChoose then
                self.curItem = self.Roles[instance].itemList[i]
                break
            end
        end
    elseif index == 1 and self.curItem == nil then
        self.curItem = self.Roles[instance].itemList[1]
    end
    return trans
end

