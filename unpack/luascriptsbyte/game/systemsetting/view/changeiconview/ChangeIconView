function ChangeIconItem:ShowRemain()
    if self.data.type ~= itemType.Frame then
        return
    end
    if not self.data.isLock then
        local endTime = _G.PlayerModel:GetInstance():GetFrameData(self.data.sid).end_time
        if self.data.cfg.time_duration > 0 then
            self.go_table.aortext_timeremain:SetActiveE(1)
            local lastTime = _G.TimeUtil.TranslateSecond(endTime - _G.TimeUtil.GetServerUnixTime())
            if lastTime.day == 0 then
                if lastTime.hour == 0 then
                    self.go_table.aortext_timeremain.text = lastTime.min .. _G.GetLangPackValue(90022500434)
                    if lastTime.min == 0 then
                        self.go_table.aortext_timeremain.text = "1" .. _G.GetLangPackValue(90022500434)
                    end
                else
                    self.go_table.aortext_timeremain.text = lastTime.hour .. _G.GetLangPackValue(90022500435)
                end
            else
                --"天"
                self.go_table.aortext_timeremain.text = _G.GetLangPackValue(90022010703, lastTime.day)
            end
        else
            self.go_table.aortext_timeremain:SetActiveE(0)
        end
    end
end

