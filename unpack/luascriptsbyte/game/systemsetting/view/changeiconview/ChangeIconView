function ChangeIconView:UpdateAttribute(data, isTitle)
    self.go_table.obj_attr:SetActiveE(isTitle and 1 or 0)
    if isTitle and data then
        local str = ""
        local attr = data.cfg.base_att
        for i, v in pairs(attr) do
            local num = _G.tonumber(v[3])
            local aType = v[2] == "1" and _G.AttCountType.other or _G.tonumber(v[2])
            num = _G.AttributeClassManager:GetInstance():GetValueWithName(v[1], num, aType)
            local numStr
            if _G.AttrType[v[1]].percentage == 1 or v[2] == "2" then
                num = num * 100
                num = _G.GameUtil.FormatNum(num)
                numStr = _G.tostring(num) .. "%"
            else
                num = _G.math.floor(num)
                num = _G.GameUtil.NumberWY(num)
                numStr = _G.tostring(num)
            end
            numStr = _G.AttrType[v[1]].des .. "+" .. numStr
            if i > 1 then
                numStr = " " .. numStr
            end
            str = str .. numStr
        end
        str = "<color=#5bdf99>" .. str .. "</color>"
        str = _G.GetLangPackValue(18900000089, str)
        self.go_table.aortext_attr.text = str
    end
end

