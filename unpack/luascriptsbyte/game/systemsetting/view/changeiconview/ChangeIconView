---更新卡牌显示
function ChangeIconView:UpdateCards(arrays)
    local datas = {}
    if arrays and arrays[1] then
        datas = arrays[1].cards or {}
    end
    local cfg
    local skinCfgs = _G.ConfigManager.skin_cfg
    local cardCfgs = _G.ConfigManager.card_cfg
    local skin
    local cardSid
    local data
    local soulLinkLv
    if not self.cardItems then
        self.cardItems = {}
    end
    for i = 1, 5 do
        if not self.cardItems[i] then
            local go_table = _G.GetAutoGoTable(self.go_table["obj_cardItem" .. i])
            self.cardItems[i] = require "ItemCardBodyBaseView".New(go_table.obj_node)
        end
        if datas[i] and datas[i].sid and datas[i].sid > 0 then
            data = datas[i]
            cardSid = data.sid
            skin = 0
            if skinCfgs then
                cfg = skinCfgs[data.sid]
                if cfg then
                    cardSid = cfg.card
                end
                skin = data.sid
            end
            self.cardItems[i]:Show(
                {
                    sid = cardSid,
                    lv = data.level,
                    star = data.star,
                    skin = skin,
                    potential = data.awaken_lv,
                    showSoulTalent = true,
                    soulState = data.soul_state,
                    soulLink_lv = data.soul_lv,
                    talents = data.born_skill_num,
                    type = data.c_type == 5 and _G.CardType.Timer or _G.CardType.Normal
                },
                _G.handlerbind(self, self.ShowCardInfo, data)
            )
            self.go_table["obj_cardItem" .. i]:SetActiveE(1)
            self.go_table["obj_emptyItem" .. i]:SetActiveE(0)
        else
            self.go_table["obj_cardItem" .. i]:SetActiveE(0)
            self.go_table["obj_emptyItem" .. i]:SetActiveE(1)
        end
    end
end

function ChangeIconView:SetCurShowData(selectId, datas, back)
    if selectId ~= nil then
        local count = _G.math.ceil(#datas / 4)
        local count2 = 4
        local num = 0
        for i = 1, count do
            for j = 1, count2 do
                ---@type ChangeIconData
                local showData = datas[j + num * count2]
                if showData and showData.sid == selectId then
                    if back then
                        back(showData, num)
                    end
                    break
                end
            end
            num = num + 1
        end
    end
end

function ChangeIconView:ShowCardInfo(go, data)
    if data.c_type == 5 then
        _G.PopWindowManager:GetInstance():ShowAllTips(602, _G.GetLangPackValue(90100000206))
        return
    end
    local pbData = { role_uid = self.uid, card_uid = data.uid }
    require("PlayerInfoNet"):GetInstance():GetCardInfo(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                if _G.AppSetting.Debug then
                    _G.LogError("获取卡牌信息异常")
                end
                return
            end
            if self.alreadyTip == nil then
                self.alreadyTip = {}
            end
            if not self.alreadyTip[data.uid] then
                if msg.card.star ~= data.star or msg.card.lv ~= data.level then
                    self.alreadyTip[data.uid] = true
                    _G.PopWindowManager:GetInstance():ShowAllTips(915101)
                end
            end
            ---@type CardData
            local cardData = require("CardData").New()
            local card = msg.card
            cardData:Parse(card)
            cardData:SetSkin(msg.card.skin)
            --不使用玩家自身的皮肤数据
            cardData.skinIs = false
            cardData:SaveEquipmentData(card, true)
            cardData:SaveDecorationData(card, true)
            if not _G.AppSetting.IsOverseas then
                cardData:SaveArtifactData(card, true)
                cardData:SaveSpiritualData(card, true)
            end
            --local skin
            --if cardData.skin ~= 0 then
            --    skin = cardData.skin
            --end
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CommonIllustrationsH5View.Name,
                cardData.sid,
                function()
                end,
                nil,
                cardData,
                nil,
                nil,
                true
            )
        end
    )
    -- _G.UIManager:GetInstance():OpenWindow(
    --     _G.ConfigManager.ui_cfg.CommonIllustrationsH5View.Name,
    --     data.sid,
    --     data,
    --     true
    -- )
end

function ChangeIconView:InitData(portraitSid, frameSid, roleSid, title)
    local datas = _G.table.toArray(self.portraitCfg)
    self.data.portraitDatas = {}
    local count = #datas
    for i = 1, count do
        ---@type ChangeIconData
        local data = ChangeIconData.New()
        data:Init(datas[i], itemType.Portrait)
        if datas[i].ID == portraitSid then
            data.isChoose = true
            data.isUse = true
        end
        if self.PreviewPortraitSid ~= nil then
            if datas[i].ID == self.PreviewPortraitSid then
                data.isChoose = true
            else
                data.isChoose = false
            end
        end
        self.data.portraitDatas[#self.data.portraitDatas + 1] = data
    end
    _G.SortList(
        self.data.portraitDatas,
        function(item)
            local num = 10
            if item.sid == portraitSid then
                num = 10
            elseif not item.isLock then
                num = 9
                local key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "portrait" .. item.sid
                if _G.CS.WechatGameCore.PlayerPrefs.HasKey(key) then
                    if _G.CS.WechatGameCore.PlayerPrefs.GetInt(key) == 0 then
                        num = 7
                    end
                end
            else
                num = 5
            end
            return num, -item.cfg.display_priority, -item.sid
        end
    )
    
    self:SetCurShowData(self.PreviewPortraitSid, self.data.portraitDatas, function(data, movePos)
        self.curData.curPortraitData = data
        self.movePos = movePos
    end)

    -- _G.table.sort(
    --     self.data.portraitDatas,
    --     function(a, b)
    --         if a.sid == portraitSid then
    --             return true
    --         end
    --         if b.sid == portraitSid then
    --             return false
    --         end
    --         if (a.isLock and b.isLock) or (not a.isLock and not b.isLock) then
    --             return a.sid < b.sid
    --         else
    --             return not a.isLock
    --         end
    --     end
    -- )
    datas = self.FrameCfg

    self.data.frameDatas = {}
    count = #datas
    for i = 1, count do
        ---@type ChangeIconData
        local data = ChangeIconData.New()
        data:Init(datas[i], itemType.Frame)
        ---@type  player_frame_cfg
        local isShow = not data.cfg.reveal
        if AppSetting.IsXzns and isShow == false then
            isShow = GlobalConditionManager.CheckConditionByArray(data.cfg.condition_type)
        end
        if isShow then
            if datas[i].ID == frameSid then
                data.isChoose = true
                data.isUse = true
            end
            if self.PreviewHeadBoxId ~= nil then
                if datas[i].ID == self.PreviewHeadBoxId then
                    data.isChoose = true
                else
                    data.isChoose = false
                end
            end
            self.data.frameDatas[#self.data.frameDatas + 1] = data
        end
    end
    _G.SortList(
        self.data.frameDatas,
        function(item)
            local num = 10
            if item.sid == frameSid then
                num = 10
            elseif not item.isLock then
                num = 9
                local key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "frame" .. item.sid
                if _G.CS.WechatGameCore.PlayerPrefs.HasKey(key) then
                    if _G.CS.WechatGameCore.PlayerPrefs.GetInt(key) == 0 then
                        num = 7
                    end
                end
            else
                num = 5
            end
            return num, -item.cfg.display_priority, -item.sid
        end
    )

    self:SetCurShowData(self.PreviewHeadBoxId, self.data.frameDatas, function(data, movePos)
        self.curData.curFrameData = data
        self.movePos2 = movePos
    end)

    self.frameCount = _G.table.count(self.data.frameDatas)
    self.data.useFrameData = self.data.frameDatas[1]
