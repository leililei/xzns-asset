function ChangeIconView:RefreshToggle(index, isOn)
    if isOn then
        self.curToggle = index
    end
    for i = 1, #ToggleList do
        local on = isOn and i == index
        local tb = _G.GetAutoGoTable(self.ToggleLua[i])
        tb.aorimage_isOn:SetActiveE(on and 1 or 0)
        tb.aorimage_isOff:SetActiveE(on and 0 or 1)
        self.go_table["obj_" .. ToggleList[i] .. "List"]:SetActiveE(on and 1 or 0)
    end
    self.go_table.obj_Head:SetActiveE((index == 1 or index == 6) and 0 or 1)
    self.go_table.obj_Head:SetLocalPosition(index == 5 and -92 or 0, 304, 0)
    self.go_table.trans_Name:SetActiveE((index == 1 or index == 5 or index == 6) and 0 or 1)
    self.go_table.trans_Spine:SetActiveE(index == 1 and 1 or 0)
    self.go_table.trans_SpineXzns:SetActiveE(index == 1 and 1 or 0)
    self.go_table.obj_chat:SetActiveE(index == 5 and 1 or 0)
    self.go_table.obj_roleFrame:SetActiveE(index == 6 and 1 or 0)
    self:RefreshSpine()
end

