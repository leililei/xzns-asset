---更新头像或头像框的显示
---@param data ChangeIconData
function ChangeIconView:UpdateTopShow(data)
    local loadPath, Type, eff = data:GetIconPath()
    if data.type == itemType.Frame then
        UIUtils.RemoveChildren(self.go_table.aorrawimage_frame)
        if Type ~= 2 then
            self.go_table.aorrawimage_frame:LoadImage(loadPath)
        else
            self.go_table.aorrawimage_frame.color = _G.Color.New(1, 1, 1, 0)
            UIUtils.LoadEffectTitleOrFrame(
                loadPath,
                self.go_table.aorrawimage_frame,
                function(item)
                    if self:IsNil() then
                        item:DestroyObject()
                    end
                end
            )
        end
    else
        local aorImage = self.go_table.aorimage_portrait:GetComponentE(_G.typeof(_G.CS.AorImage))
        self.go_table.aorimage_portrait:ClearChildren()
        local index = self.go_table.aorrawimage_frame:GetSiblingIndexE()
        local index1 = self.go_table.aorimage_portrait:GetSiblingIndexE()
        if Type == 2 then
            if index1 < index then
                self.go_table.aorimage_portrait:SetSiblingIndexE(index)
            end
            aorImage.enabled = false
            _G.UIUtils.LoadEffectTitleOrFrame(
                eff,
                self.go_table.aorimage_portrait,
                function(trans)
                    if self:IsNil() then
                        trans:DestroyObject()
                    end
                end
            )
        else
            if index1 > index then
                self.go_table.aorimage_portrait:SetSiblingIndexE(index - 1)
            end
            aorImage.enabled = true
            self.go_table.aorimage_portrait.SpriteName = loadPath
        end
    end

    --self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(data.cfg.name)
    self:UpdateAttribute()
    self:UpdateGetPath(data)
    self:ChangeEnterShow(data)
end

