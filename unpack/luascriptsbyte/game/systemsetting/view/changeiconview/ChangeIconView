    if self.curToggle == 1 then
        self.go_table.aortext_kname.text = _G.GetLangPackValue(cfg.Name)
    end
    local trans = self.go_table.trans_Spine
    if _G.AppSetting.IsXzns then
        trans = self.go_table.trans_SpineXzns
    end
    trans:ClearChildren()
    local pos = { cfg.pos_portrait[1], cfg.pos_portrait[2] + 400, cfg.pos_portrait[3] }
    local scale = cfg.size2
    local isWearSkin, skinId = require("CardCommentManager"):GetInstance():CardWearSkin(cfg.id)
    local path = isWearSkin and _G.ConfigManager.skin_cfg[skinId].ModelPathHi or cfg.ModelPathHi
    local isUseBattleSpine = _G.UIUtils.IsUseBattleSpine(_G.UseBattleSpine.ChangeIconView)
    if isUseBattleSpine then
        path = _G.UIUtils.GetBattleSpine(cfg)
        pos = { 0, 0, 0 }
        scale = cfg.size4
    end
    _G.PoolsManager:GetInstance():Spawn(
        path,
        _G.ePoolType.Temporary,
        trans,
        function(obj)
            if self:IsNil() then
                _G.DestroyObject(obj)
            end
            trans:SetLocalScaleXYZ(scale)
            trans:SetLocalPosition(pos[1], pos[2], pos[3])

            --- 只有星座女神有神环
            if _G.AppSetting.IsXzns then
                local godHaloID = _G.PlayerModel:GetInstance():IsCardWearGodHalo(cfg.id)
                if godHaloID ~= 0 then
                    local effCfg = _G.ConfigManager.god_halo_cfg[godHaloID].ui_effect_cfg
                    --- 神环路径，父级路径(加载角色的下面)
                    _G.UIUtils.LoadGodHalo(effCfg, obj,godHaloID)
                end
                _G.UIUtils.LoadArtifacteffect(obj,cfg.id,nil,nil)
            end
        end
    )
    self.go_table.obj_tujing:SetActiveE(self.curRoleData.isLock and 1 or 0)
    self:UpdateAttribute(self.curData.curRoleData)
    if self.curRoleData.LockList[self.curRoleData.index] then
        if self.curRoleData.index == 1 then
            self.go_table.aortext_getPath.text = _G.LangUtil.GetLangPackValue(90020300185)
        end
    else
        local skinCfg = CardCommentManager:GetInstance():GetCfgs(self.curRoleData.skinList[self.curRoleData.index])
        if skinCfg then
            self.go_table.aortext_getPath.text = _G.GetLangPackValue(90021300121, _G.GetLangPackValue(skinCfg.name))
        end

        -- local key = tostring(_G.PlayerModel:GetInstance().role_uid) ..
        --     "playerRole" .. self.curRoleData.skinList[self.curRoleData.index]
        -- if _G.CS.UnityEngine.PlayerPrefs.GetInt(key, 1) == 0 then
        --     return
        -- end
