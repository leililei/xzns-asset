---移除红点信息(形象/头像/头像框/称号)
---@param type number 目标节点类型
---@param data any 列表节点数据
---@param force? boolean 强制刷新红点信息,默认为nil
function ChangeIconView:RemoveRedpoint(type, data, force)
    if not data or data.isLock then
        return
    end
    ---@type number,string
    local id, key
    if type == itemType.Portrait then
        id = _G.ConfigManager.redpoint_cfg.Portrait.id
        key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "portrait" .. data.sid
    elseif type == itemType.Frame then
        id = _G.ConfigManager.redpoint_cfg.Frame.id
        key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "frame" .. data.sid
    elseif type == itemType.Role then
        id = _G.ConfigManager.redpoint_cfg.PlayerRole.id
        key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "playerRole" .. data.skinList[data.index]
    elseif type == itemType.Title then
        id = _G.ConfigManager.redpoint_cfg.PlayerTitle.id
        key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "title" .. data.sid
    elseif type == itemType.ChatFrame then
        id = _G.ConfigManager.redpoint_cfg.PlayerChatFrame.id
        key = tostring(_G.PlayerModel:GetInstance().role_uid) .. _G.PlayerPrefsKey.ChatFrame .. data.sid
    elseif type == itemType.RoleFrame then
        id = _G.ConfigManager.redpoint_cfg.PlayerRoleBox.id
        key = tostring(_G.PlayerModel:GetInstance().role_uid) .. _G.PlayerPrefsKey.RoleFrame .. data.sid
    end
    if not id or not key then
        return
    end
    --检测红点是否已点击
    if not force and _G.CS.WechatGameCore.PlayerPrefs.GetInt(key, -1) == 0 then
        return
    end
    _G.CS.WechatGameCore.PlayerPrefs.SetInt(key, 0)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(id)
end

function ChangeIconView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_close" then
        -- if self.curItemF then
        --     self.curItemF:ChangeXuanZ()
        --     self.curItemF = nil
        -- end
        -- if self.curItemP then
        --     self.curItemP:ChangeXuanZ()
        --     self.curItemP = nil
        -- end
        self:RefreshAllPlayerRole()
        self:RefreshAllPortrait()
        self:RefshAllFrame()
        self:Close()
    elseif name == "@_aorbtn_anyClose" then
        self:RefreshAllPlayerRole()
        self:RefreshAllPortrait()
        self:RefshAllFrame()
        self:Close()
    elseif name == "$_toggle_role" then
        self:RefreshToggle(1, isOn)
        if isOn and self.curRoleData then
            self:ChangeEnterShow(self.curRoleData)
            self:RemoveRedpoint(itemType.Role, self.curRoleData)
        end
    elseif name == "$_toggle_portrait" then
        self:RefreshToggle(2, isOn)
        self.go_table.obj_portraitList:SetActiveE(isOn and 1 or 0)
        if isOn then
            --self.curData.curPortraitData.isChoose = false
            --self.curData.curPortraitData = self.data.usePortraitData
            --self.data.usePortraitData.isChoose = true
            self:RemoveRedpoint(itemType.Portrait, self.curData.curPortraitData)
            self:UpdateTopShow(self.curData.curPortraitData)
            self.go_table.looplist2_portrait:RefreshAllShownItem()
        end
        self:OnTogglePortrait(go, isOn)
    elseif name == "$_toggle_frame" then
        self:RefreshToggle(3, isOn)
        self.go_table.obj_frameList:SetActiveE(isOn and 1 or 0)
        if isOn then
            --self.curData.curFrameData.isChoose = false
            --self.curData.curFrameData = self.data.useFrameData
            --self.data.useFrameData.isChoose = true
            self:RemoveRedpoint(itemType.Frame, self.curData.curFrameData)
            self:UpdateTopShow(self.curData.curFrameData)
            self.go_table.looplist2_frame:RefreshAllShownItem()
        end
        self:OnToggleFrame(go, isOn)
    elseif name == "$_toggle_title" then
        self:RefreshToggle(4, isOn)
        if isOn then
            if not self.TitleListCount then
                if not self.curTitle then
                    self.curTitle = {}
                end
                self.curTitle.data = self.data.useTitleData.sid == -1 and self.curData.curTitleData or
                    self.data.useTitleData
                self.curTitle.data.isLock = self.curTitle.data.state == 0
                self.go_table.scrollloopvectical_TitleList:InitItemData(#self.data.titleDatas,
                    _G.handler(self, self.RefreshTitle))
                self.TitleListCount = #self.data.titleDatas
            else
                self.go_table.scrollloopvectical_TitleList:UpdateAllItem()
            end
            if self.movePos3 then
                self.go_table.scrollloopvectical_TitleList:ScrollToIndex(self.movePos3)
                self.movePos3 = nil
            end
            self:RemoveRedpoint(itemType.Title, self.curData.curTitleData)
            self:UpdateAttribute(self.curData.curTitleData, true)
            self:UpdateGetPath(self.curData.curTitleData, true)
            self:ChangeEnterShow(self.curData.curTitleData)
            self.go_table.obj_titleEffect:SetActiveE(1)
        end
    elseif name == "$_toggle_chatFrame" then
        self:RefreshToggle(5, isOn)
        if isOn then
            if not self.chatFrameInit then
                if not self.curChatFrame then
                    self.curChatFrame = {}
                end
                --self.curChatFrame.data = self.data.useChatFrameData.sid == -1 and self.curData.curChatFrameData or
                --    self.data.useChatFrameData
                self.curChatFrame.data = self.curData.curChatFrameData
                self.curChatFrame.data.isLock = self.curChatFrame.data.state == 0
                self.go_table.scrollloopvectical_ChatFrameList:InitItemData(#self.data.chatFrameDatas,
                    _G.handler(self, self.RefreshChatFrame))
                self.chatFrameInit = true
            else
                self.go_table.scrollloopvectical_ChatFrameList:UpdateAllItem()
            end
            if self.movePos4 then
                self.go_table.scrollloopvectical_ChatFrameList:ScrollToIndex(self.movePos4)
                self.movePos4 = nil
            end
            self:RemoveRedpoint(itemType.Title, self.curData.curChatFrameData)
            self:UpdateAttribute(self.curData.curChatFrameData, false)
            self:UpdateGetPath(self.curData.curChatFrameData, false)
            self:ChangeEnterShow(self.curData.curChatFrameData)
            self.go_table.obj_titleEffect:SetActiveE(1)
        end
    elseif name == "$_toggle_roleFrame" then
        self:RefreshToggle(6, isOn)
        if isOn then
            if not self.roleFrameInit then
                if not self.curRoleFrame then
                    self.curRoleFrame = {}
                end
                self.curRoleFrame.data = self.data.useRoleFrameData.sid == -1 and self.curData.roleFrameDatas or
                    self.data.useRoleFrameData
                self.curRoleFrame.data.isLock = self.curRoleFrame.data.state == 0
                self.go_table.scrollloopvectical_RoleFrameList:InitItemData(#self.data.roleFrameDatas,
                    _G.handler(self, self.RefreshRoleFrame))
                self.roleFrameInit = true
            else
                self.go_table.scrollloopvectical_RoleFrameList:UpdateAllItem()
            end
            self:RemoveRedpoint(itemType.RoleFrame, self.curData.curRoleFrameData)
            self:UpdateGetPath(self.curData.curRoleFrameData, false)
            self:ChangeEnterShow(self.curData.curRoleFrameData)
            self.go_table.obj_titleEffect:SetActiveE(1)
        end
    elseif name == "@_aorbtn_enter" then
        if self.curToggle == 1 and self.curRoleData and
            self.curRoleData.cfg.id ~= self.curData.curRoleData then
            local skinId = CardCommentManager:GetInstance():GetSkinIdBySid(self.curRoleData.cfg.id)
            _G.SystemSettingManager:GetInstance():UpadteRoleStyle(
                skinId,
                _G.handler(self, self.UpdateRoleStyle)
            )
            self.updateCount = self.updateCount + 1
            --- 判断卡牌是否装备神环 等于0为没有
            local godHaloID = _G.PlayerModel:GetInstance():IsCardWearGodHalo(self.curRoleData.cfg.id)
            if godHaloID ~= 0 then
                _G.PlayerModel:GetInstance():SetGodHaloToRole(godHaloID)
            end
        end
        if
        self.curToggle == 2 and self.curItemP and self.curData.curPortraitData and
            self.data.usePortraitData.sid ~= self.curData.curPortraitData.sid
        then
            _G.SystemSettingManager:GetInstance():UpdateStyle(
                self.curData.curPortraitData.sid,
                _G.handler(self, self.UpdatePortrait)
            )
            self.updateCount = self.updateCount + 1
        end
        if self.curToggle == 3 and self.curItemF and self.curData.curFrameData and
            self.data.useFrameData.sid ~= self.curData.curFrameData.sid then
            _G.SystemSettingManager:GetInstance():UpdateFrame(
                self.curData.curFrameData.sid,
                _G.handler(self, self.UpdateFrame)
            )
            self.updateCount = self.updateCount + 1
        end
        if self.curToggle == 4 and self.curData.curTitleData and self.data.useTitleData.sid ~= self.curTitle.data.sid then
            --local sid = _G.PlayerModel:GetInstance():GetRoleSid()
            _G.SystemSettingManager:GetInstance():UpdateHaloAndTitle(
                self.curTitle.data.sid,
                2,
                _G.handlerbind(self, self.UpdateHaloAndTitle, self.curTitle.data)
            )
            self.updateCount = self.updateCount + 1
        end
        if self.curToggle == 5 and self.curData.curChatFrameData and self.data.useChatFrameData.sid ~= self.curChatFrame.data.sid then
            local sid = self.curChatFrame.data.sid
             if sid == _G.PlayerModel:GetInstance():GetDefaultChatFrameSid() then
                 sid = 0
             end
            _G.SystemSettingManager:GetInstance():UpdateHaloAndTitle(
                sid,
                3,
                _G.handlerbind(self, self.UpdateChatFrame, self.curChatFrame.data)
            )
            self.updateCount = self.updateCount + 1
        end
        if self.curToggle == 6 and self.curData.curRoleFrameData and self.data.useRoleFrameData.sid ~= self.curRoleFrame.data.sid then
            local sid = self.curRoleFrame.data.sid
            if sid == _G.PlayerModel:GetInstance():GetDefaultRoleFrameSid() then
                sid = 0
            end
            _G.SystemSettingManager:GetInstance():UpdateHaloAndTitle(
                sid,
                5,
                _G.handlerbind(self, self.UpdateRoleFrame, self.curRoleFrame.data)
            )
            self.updateCount = self.updateCount + 1
        end
    elseif name == "@_aorbtn_getPath" then
        --self:GetPath()
    end
end

return ChangeIconView
