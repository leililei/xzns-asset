        -- require "RedPointManager":GetInstance():RefreshNode(
        --     _G.ConfigManager.redpoint_cfg.PlayerRole.id,
        --     self.curRoleData.cfg.id
        -- )
        self:RemoveRedpoint(itemType.Role, self.curRoleData)
    end
    if self.curRoleData.isLock then
        self.go_table.aortext_time.text = "<color=#FE7C7C>" .. _G.GetLangPackValue(90026100015) .. "</color>"
    else
        local time = _G.LangUtil.GetLangPackValue(90028300074)
        self.go_table.aortext_time.text = _G.LangUtil.GetLangPackValue(90028900002, time)
    end
