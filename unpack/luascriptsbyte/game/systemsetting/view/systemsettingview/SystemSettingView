---界面的入口函数
---@param data role.s2c_role_info 玩家个人信息
---@param isCurPlayer boolean 是否为当前玩家
---@param  sortingOrder number 需要调整 层级的界面
function SystemSettingView:OnCreate(data, _, sortingOrder)
    _G.GameUtil.SetActiveByCondition(self.gameObject, true)
    self.isInited = false
    self.isCurPlayer = true
    self:InitData(data)
    self:InitClickFunction()
    self:InitView()
    self.isInited = true
    if sortingOrder then
        local Canvas = self.go_table.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
        Canvas.sortingOrder = Canvas.sortingOrder + sortingOrder
    end
    self.RobotListe = {}
end

---初始化界面显示
function SystemSettingView:InitView()
    self.SettingOtherSetView =
        self:AddComponent(self.go_table.obj_OtherSet, require "SettingOtherSetView".New(self, self.data))
    local visible = self.isHidePrivacy and 0 or 1
    self.go_table.aorbtn_yszc:SetActiveE(visible)
    self.go_table.aorbtn_yhxy:SetActiveE(visible)

    if _G.AppSetting.DEBUG then
        _G.Log(_G.AppSetting.IsEditor, "订阅判断是不是编辑器")
        _G.Log(_G.AppSetting.IsWeiXin, "订阅判断是不是微信")
    end

    -- if _G.AppSetting.IsEditor then
    --     _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_dytx, true)
    -- else
    local platform = _G.tonumber(_G.SDKManager:GetInstance():GetChannelId())
    if AppSetting.IsXzns then
        local needpf = _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.pushNotification,platform)
        if _G.AppSetting.DEBUG then
            _G.Log(platform, "渠道id")
            _G.Log(needpf, "配置表订阅要求渠道是否开启")
        end
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_dytx, needpf)
    else
        local needpf = _G.ConfigManager.discrete_cfg[124012][1][1]
        if _G.AppSetting.DEBUG then
            _G.Log(platform, "渠道id")
            _G.Log(needpf, "配置表订阅要求渠道id")
        end
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_dytx, _G.AppSetting.IsWeiXin and platform == needpf)
    end
    local cfg = _G.GameUtil.GetFunctionData(_G.FunctionBlock.language_list)
    if cfg and #cfg > 0 then
        self.go_table.aorbtn_yysz:SetActiveE(_G.AppSetting.LanguageChoose and 1 or 0)
    else
        self.go_table.aorbtn_yysz:SetActiveE(0)
    end
    --end
end
---初始化数据
function SystemSettingView:InitData(data)
    self.data = data
    self.ImageData = _G.SystemSettingManager:GetInstance():GetImageData()
    self.isHidePrivacy = _G.GameUtil.GetFunctionBlockState(_G.FunctionBlock.PrivacyPolicy)
    if self.isCurPlayer then
        self.playerType = PlayerType.Player
    else
        if self.data.isComment then
            self.playerType = PlayerType.Robot
        else
            if string.len(tostring(self.data.uid)) == 6 then
                self.playerType = PlayerType.Robot
                self.RobotCfg = _G.ConfigManager.arena_robot_cfg[self.data.uid]
            else
                self.playerType = PlayerType.OtherPlayer
            end
        end
    end
end

