---关闭界面
function SystemSettingView:CloseView()
    self:Close()
end

---按钮点击事件在这里派发
function SystemSettingView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.functions[name] then
        self.functions[name](self, go, isOn)
    else
        if _G.AppSetting.DEBUG then
            _G.Log("", "<color=red>" .. ">>>" .. name .. "没有对应的点击方法</color>")
        end
    end
    _G.AudioManager.PlaySoundYeQian(name)
end

--账户
function SystemSettingView:OnAccount()
    _G.PopWindowManager:GetInstance():ShowAllTips(
        200301,
        _G.LangUtil.GetLangPackValue(_G.ConfigManager.tips_system_cfg[200301].content),
        function()
            if _G.CS.Launcher.Inst.IsSDK then
                self:AddEvent()
                _G.SDKManager:GetInstance():SendLogOut()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
            else
                self:CloseView()
                _G.GameMain:ResetGame()
            end
        end
    )
end

function SystemSettingView:OnStartClose()
    self:RemoveEvent()
end
function SystemSettingView:AddEvent()
    if _G.CS.Launcher.Inst.IsSDK then
        _G.SDKManager:GetInstance():AddListener(SDKDef.GetMsg.auth_logout, self.auth_logout, self)
    end
end

function SystemSettingView:RemoveEvent()
    if _G.CS.Launcher.Inst.IsSDK then
        _G.SDKManager:GetInstance():RemoveListener(SDKDef.GetMsg.auth_logout, self.auth_logout, self)
    end
end

--这里默认登出成功
function SystemSettingView:auth_logout()
    self:RemoveEvent()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
    self:CloseView()
    _G.GameMain:ResetGame()
end

---保存当前状态
function SystemSettingView:SaveState(key, value)
    _G.CS.WechatGameCore.PlayerPrefs.SetFloat("Setting" .. key, value)
end

---检测key是否被保存
function SystemSettingView:HasKey(key)
    return _G.CS.WechatGameCore.PlayerPrefs.HasKey("Setting" .. key)
end

---获取当前状态
function SystemSettingView:GetState(key, isFloat)
    if not self:HasKey(key) then
        return -1
    end
    if isFloat == nil or isFloat then
        return _G.CS.WechatGameCore.PlayerPrefs.GetFloat("Setting" .. key)
    else
        return math.floor(_G.CS.WechatGameCore.PlayerPrefs.GetFloat("Setting" .. key))
    end
end

