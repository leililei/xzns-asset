---隐私政策
function SystemSettingView:OpenYSZC()
    local WechatGameApp = _G.CS.WechatGameCore.WechatGameApp.Instance
    if _G.AppSetting.IsWebGl then
        ---获取隐私协议和用户协议(H5不能跳转网页，所以通过游戏内弹窗的方式弹出)

        ---隐私协议
        local urlpr = WechatGameApp.PrivacyAgreement
        local title = _G.GetLangPackValue(90000011257)

        if not _G.string.IsNullOrEmpty(urlpr) then
            _G.CS.GameUtility.HttpRequest(
                urlpr,
                function(result, resultData)
                    if result then
                        _G.UIManager:GetInstance():OpenWindow(
                            _G.ConfigManager.ui_cfg.AgreementTipView.Name,
                            title,
                            resultData
                        )
                    end
                end
            )
        else
            if _G.AppSetting.DEBUG then
                _G.LogError("获取的url地址为空！")
            end
        end
    else
        ---隐私政策
        if _G.string.IsNullOrEmpty(WechatGameApp.PrivacyAgreement) then
            if _G.AppSetting.DEBUG then
                _G.LogError("挂接后台没有配置隐私政策跳转链接！")
            end
            return
        end
        _G.CS.UnityEngine.Application.OpenURL(WechatGameApp.PrivacyAgreement)
    end
end

