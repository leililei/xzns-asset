---设置fps
function SettingOtherSetView:ChangeFPSLevel(go, isOn, index)
    if isOn then
        if nil ~= self.CurFPSIndex and index == 2 and index > self.CurFPSIndex then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                212,
                nil,
                function()
                    local value = self:GetFPSLevel(index)
                    self.ownerView:SaveState(SettingType.FPS, index)
                    self:SwitchFPSLevel(value)
                    self.CurFPSIndex = index
                end,
                function()
                    if self.CurFPSIndex == 1 then
                        self.go_table.toggle_fps30.isOn = true
                    elseif self.CurFPSIndex == 2 then
                        self.go_table.toggle_fps60.isOn = true
                    end
                end
            )
        else
            local value = self:GetFPSLevel(index)
            self.ownerView:SaveState(SettingType.FPS, index)
            self:SwitchFPSLevel(value)
            self.CurFPSIndex = index
        end
    end
end

---切换画质
function SettingOtherSetView:SwitchFPSLevel(LevelTemplate)
    _G.SystemSettingManager:GetInstance():SetGameFPS(LevelTemplate)
end

---获取要改变画质的light
---@param index number 画质的下标
function SettingOtherSetView:GetFPSLevel(index)
    return 60
end

---初始化fps
function SettingOtherSetView:InitFps()
    local index = self.ownerView:GetState(SettingType.FPS)
    if index == nil or index == -1 then
        index = 1
    end
    if index == 1 then
        self.go_table.toggle_fps30.isOn = true
    elseif index == 2 then
        self.go_table.toggle_fps60.isOn = true
    else
        --找不到索引用30
        self.go_table.toggle_fps30.isOn = true
    end
end

---初始化画质设置
function SettingOtherSetView:initHuazhi()
    local index = self.ownerView:GetState(SettingType.ImageQuality)
    if index == nil or index < 0 or index > 3 then
        index = 1
    end
    local item = self:GetQuality(index)
    item:SetActiveE(1)
    self.curImage = item
    self.curImageIndex = index
end

---切换画质
function SettingOtherSetView:ChangeImageQuality(go, isOn, index)
    local item, changeImage = self:GetQuality(index)
    if changeImage then
        if index == 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                200309,
                nil,
                function()
                    self.ownerView:SaveState(SettingType.ImageQuality, changeImage)
                    self:SwitchImage(changeImage)
                    if self.curImage ~= nil then
                        self.curImage:SetActiveE(0)
                    end
                    item:SetActiveE(1)

                    self.curImage = item
                    self.curImageIndex = index
                end
            )
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(
                200304,
                nil,
                function()
                    self.ownerView:SaveState(SettingType.ImageQuality, changeImage)
                    self:SwitchImage(changeImage)
                    if self.curImage ~= nil then
                        self.curImage:SetActiveE(0)
                    end
                    item:SetActiveE(1)

                    self.curImage = item
                    self.curImageIndex = index
                end,
                nil,
                nil,
                nil,
                _G.LangUtil.GetLangPackValue(tips[index])
            )
        end
    end
end
---切换画质
function SettingOtherSetView:SwitchImage(LevelTemplate)
    _G.SystemSettingManager:GetInstance():SetTemplateLevel(LevelTemplate)
    self.ownerView.ImageData = _G.SystemSettingManager:GetInstance():GetImageData()
end
---获取要改变画质的light
---@param index number 画质的下标
function SettingOtherSetView:GetQuality(index)
    local item
    local changeImage
    if index == 3 then
        item = self.go_table.obj_lowLight
        changeImage = 3
    elseif index == 2 then
        item = self.go_table.obj_midLight
        changeImage = 2
    elseif index == 1 then
        item = self.go_table.obj_highLight
        changeImage = 1
    else
        item = self.go_table.obj_uitraLight
        changeImage = 0
    end
    return item, changeImage
end
--toggle切换动画
function SettingOtherSetView:OnToggleAni(go, isOn, OnId, OffId, key)
    local table = _G.GetAutoGoTable(go)
    _G.GameUtil.SetActiveByCondition(table.obj_off, not isOn)
    _G.GameUtil.SetActiveByCondition(table.obj_on, isOn)
    if isOn then
        table.aorimage_BG.SpriteName = "xtsz_jindutiao_07"
    else
        table.aorimage_BG.SpriteName = "xtsz_jindutiao_06"
    end
    if self.isInited then
        if isOn then
            _G.PopWindowManager:GetInstance():ShowAllTips(OnId)
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(OffId)
        end
        local index = isOn and 1, 0
        self.ownerView:SaveState(key, index)
    end
end

