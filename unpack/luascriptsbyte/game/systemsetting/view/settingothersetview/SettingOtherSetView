        self:UpdateMusicBaifenbi(_G.AudioManager.GetMusicVolume())
        self.go_table.slider_bgMusic.value = _G.AudioManager.GetMusicVolume()
    end

    if self.ownerView:HasKey(SettingType.BGAudio_is) then
        self.go_table.slider_bgAudio.value = self.ownerView:GetState(SettingType.BGAudio)
        self:UpdateAudioBaifenbi(self.ownerView:GetState(SettingType.BGAudio))
    else
        self:UpdateAudioBaifenbi(_G.AudioManager.GetAudioVolume())
        self.go_table.slider_bgAudio.value = _G.AudioManager.GetAudioVolume()
    end
