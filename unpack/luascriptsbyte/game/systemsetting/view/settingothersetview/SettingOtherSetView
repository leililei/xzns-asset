    --         self.ownerView:GetState(SettingType.PeopleAudio) == nil and 1 or
    --         self.ownerView:GetState(SettingType.PeopleAudio)
    -- end
    self.go_table.slider_bgMusic.onValueChanged:AddListener(_G.handler(self, self.ChangeMusic))
    self.go_table.slider_bgAudio.onValueChanged:AddListener(_G.handler(self, self.ChangeAudio))
    -- self.go_table.slider_peopleAudio.onValueChanged:AddListener(_G.handler(self, self.ChangePeopleAudio))
    self.isPlayMusic = false

    local isPlay = false
    if self.ownerView:HasKey(SettingType.BGMusic_is) then
        if (self.ownerView:GetState(SettingType.BGMusic_is)) > 0 then
            isPlay = true
        end
    else
        isPlay = true
    end
    -- self.go_table.toggle_music.isOn = isPlay
    self.go_table.aorimage_fill_music:SetGray(not isPlay)
    self.go_table.aorimage_Handle_music:SetGray(not isPlay)
    isPlay = false
