function SettingOtherSetView:UpdateMusicBaifenbi(value)
    self.go_table.aortext_BgMusic.text = math.ceil(value * 100) .. "%"
end
function SettingOtherSetView:UpdateAudioBaifenbi(value)
    self.go_table.aortext_BgAudio.text = math.ceil(value * 100) .. "%"
end
---改变音乐音量大小
function SettingOtherSetView:ChangeMusic(volume)
    local isPlay = true
    if self.ownerView:HasKey(SettingType.BGMusic_is) then
        if (self.ownerView:GetState(SettingType.BGMusic_is)) > 0 then
            isPlay = true
        else
            isPlay = false
        end
    end
    if isPlay then
        _G.AudioManager.SetMusicVolume(volume)
    end
    _G.AudioManager.RefreshCurMusicVolume()
    self:UpdateMusicBaifenbi(volume)
    self.ownerView:SaveState(SettingType.BGMusic, volume)
end

---改变音效音量大小
function SettingOtherSetView:ChangeAudio(volume)
    local isPlay = true
    if self.ownerView:HasKey(SettingType.BGAudio_is) then
        if (self.ownerView:GetState(SettingType.BGAudio_is)) > 0 then
            isPlay = true
        else
            isPlay = false
        end
    end
    if isPlay then
        _G.AudioManager.SetAudioVolume(volume)
    end
    self:UpdateAudioBaifenbi(volume)
    self.ownerView:SaveState(SettingType.BGAudio, volume)
end
---更改人声音效
function SettingOtherSetView:ChangePeopleAudio(volume)
    self.ownerView:SaveState(SettingType.PeopleAudio, volume)
end
