function SettingOtherSetView:OnClickShengdian()
    if self.ownerView:GetState(SettingType.ShengDian) == 1 then
        _G.PopWindowManager:GetInstance():ShowAllTips(215)
        self.ownerView:SaveState(SettingType.ShengDian, 0)
        self:ChangeShengdian(false)
        _G.GameMain:SetShengDianFlag(false)
    else
        local contentid = _G.ConfigManager.tips_system_cfg[213].content
        local str = _G.GetLangPackValue(contentid, math.modf(self.shengdianTime / 60))
        _G.PopWindowManager:GetInstance():ShowAllTips(
            213,
            str,
            function()
                _G.PopWindowManager:GetInstance():ShowAllTips(214)
                self.ownerView:SaveState(SettingType.ShengDian, 1)
                self:ChangeShengdian(true)
                _G.GameMain:SetShengDianFlag(true)
            end
        )
    end
end

function SettingOtherSetView:ChangeShengdian(isOn)
    if isOn then
        self.go_table.obj_shengdianOn:SetActiveE(1)
        self.go_table.obj_shengdianOff:SetActiveE(0)
        self.go_table.aorimage_shengdianBG.SpriteName = "xtsz_jindutiao_07"
    else
        self.go_table.obj_shengdianOn:SetActiveE(0)
        self.go_table.obj_shengdianOff:SetActiveE(1)
        self.go_table.aorimage_shengdianBG.SpriteName = "xtsz_jindutiao_06"
    end
end

return SettingOtherSetView
