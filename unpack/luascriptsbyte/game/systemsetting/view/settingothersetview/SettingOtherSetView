---初始化音量
function SettingOtherSetView:InitMusicAndAudio()
    if self.ownerView:HasKey(SettingType.BGMusic_is) then
        self.go_table.slider_bgMusic.value = self.ownerView:GetState(SettingType.BGMusic)
        self:UpdateMusicBaifenbi(self.ownerView:GetState(SettingType.BGMusic))
