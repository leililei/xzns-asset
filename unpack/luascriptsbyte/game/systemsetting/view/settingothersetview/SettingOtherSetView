---修改点的位置
function SettingOtherSetView:ChangePointPos(toggle, key)
    local index = self.ownerView:GetState(key)
    if index == nil then
        return
    end
    if index == -1 then
        toggle.isOn = true
    else
        toggle.isOn = index == 1
    end
    local tb = _G.GetAutoGoTable(toggle)
    _G.GameUtil.SetActiveByCondition(tb.obj_off, not toggle.isOn)
    _G.GameUtil.SetActiveByCondition(tb.obj_on, toggle.isOn)
end

