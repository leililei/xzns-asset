---@class SettingGiftView : UIBaseView	中文描述
---@field public go_table SettingGiftView_GoTable GoTable
local SettingGiftView = _G.BaseClass("SettingGiftView", _G.UIBaseView)
--_G.SettingGiftView = SettingGiftView

function SettingGiftView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SettingGiftView:OnCreate(key,callback)
    self.callback = callback
    self:initChangeName()
    if key then
        self.go_table.input_Name.text = key
    end
    self.UiDic = {
        upTime = 0,
        ---兑换间隔(防止连点)
        upDown = 0.5
    }
end
---界面的销毁函数
function SettingGiftView:OnDestroy()
end

function SettingGiftView:initChangeName()
    ---兑换码长度规则,8位固定走通用,用于活动-福利兑换码的长度不限（前端限制输入100）
    self.go_table.input_Name.text = ""
    _G.GameUtil.InputFieldCharacterLimit(self.go_table.input_Name, 100, nil, true,true)
end

---按钮点击事件在这里派发
function SettingGiftView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_close" or name == "@_aorbtn_closeView" then
        self:Close()
    elseif name == "@_aorbtn_enter" then
        if os.time() - self.UiDic.upTime < self.UiDic.upDown then
            if _G.AppSetting.DEBUG then
                _G.Log("防止连续点击兑换按钮")
            end
            return
        else
            self:EnterGift()
            self.UiDic.upTime = os.time()
        end
    end
end
---确定
function SettingGiftView:EnterGift()
    local msg = {}
    msg.name = self.go_table.input_Name.text
    if _G.string.IsNullOrEmpty(msg.name) then
        _G.PopWindowManager:GetInstance():ShowAllTips(160107)
        return
    elseif #msg.name > 0 then
        _G.SystemSettingManager:GetInstance():RedemptionCode(
            self.go_table.input_Name.text,
            _G.handler(self, self.EnterGiftCallBack)
        )
    --else
        --self:CDKeyACtivity()
    end
end

---活动-福利兑换码
function SettingGiftView:CDKeyACtivity()
    local msg = {}
    msg.code = self.go_table.input_Name.text
    if _G.string.IsNullOrEmpty(msg.code) then
        _G.PopWindowManager:GetInstance():ShowAllTips(160107)
        return
    else
        _G.SystemSettingManager:GetInstance():GetCDKeyActivity(
            msg,
            function(data)
                if 1 == data.ack then
                    _G.StorageManager:GetInstance():ReceiveAwardData(data)
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
                end
            end
        )
    end
end

function SettingGiftView:EnterGiftCallBack(data)
    if data.ack == 1 then
        _G.StorageManager:GetInstance():ReceiveAwardData(data)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
    end
end

return SettingGiftView
