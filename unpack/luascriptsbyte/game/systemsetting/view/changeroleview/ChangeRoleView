function ChangeRoleView:GetRoleDataBySid(sid)
    for _, v in pairs(self.CardList) do
        if v.cfg.id == sid then
            return v
        end
    end
end

function ChangeRoleView:UpdateEffectByRole()
    self:UpdateHaloByRole()
    self:UpdateTitleByRole()
end

function ChangeRoleView:UpdateHaloByRole(data)
    self.haloID = _G.PlayerModel:GetInstance():GetRoleEffect(1, self.curRoleData.cfg.id)
    if self.haloID > 0 then
        local haloData = data or self:FindHaloDataByID(self.haloID)
        if haloData ~= nil then
            self.curHalo = {}
            self.curHalo.data = haloData
            self:SpawnHalo({isChoose = true, data = haloData})
        end
    else
        self.curHalo = nil
        if not _G.IsNil(self.Halo) then
            _G.PoolsManager:GetInstance():Despawn(self.Halo, _G.ePoolType.Temporary)
            self.Halo = nil
        end
    end
end

function ChangeRoleView:UpdateTitleByRole(data)
    _G.GameUtil.SetActiveByCondition(self.Title.aorrawimage_Title, false)
    self.titleID = _G.PlayerModel:GetInstance():GetRoleEffect(2, self.curRoleData.cfg.id)
    if self.titleID > 0 then
        local titleData = data or self:FindTitleDataByID(self.titleID)
        if titleData ~= nil then
            self.curTitle = {}
            self.curTitle.data = titleData
            self:SapwnTitle(
                {isChoose = true, data = titleData},
                function()
                    -- self:InitRotPos()
                end
            )
        end
    else
        self.curTitle = nil
        if self.Title.item then
            _G.DestroyObject(self.Title.item)
            self.Title.item = nil
        end
    end
end

function ChangeRoleView:FindHaloDataByID(id)
    for _, v in pairs(self.HaloDatas) do
        if v.sid == id then
            return v
        end
    end
end

function ChangeRoleView:FindTitleDataByID(id)
    for _, v in pairs(self.TitleDatas) do
        if v.sid == id then
            return v
        end
    end
end

return ChangeRoleView
