function ChangeRoleView:OnToggleHalo(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_conotent, isOn)
    self.go_table.obj_PropContent:SetActiveE(1)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorlooplist_HaloList, isOn)
