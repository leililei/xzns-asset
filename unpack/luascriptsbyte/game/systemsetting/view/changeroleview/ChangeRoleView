        self.go_table.aorlooplist_HaloList:StartUpdataDragInfo(#self.HaloDatas, _G.handler(self, self.RefreshHalo))
    end
    if isOn then
        self.toggleFunc = self.ChangeHalo
    end
    _G.GameUtil.SetActiveByCondition(self.haloTb.aorimage_isOn, isOn)
    if self.curHalo then
        local id = _G.PlayerModel:GetInstance():GetRoleEffect(1, self.curRoleData.cfg.id)
        self:ChangeTitleBtn(self.curHalo.data, id)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_Road_node, true)
        if self.curHalo.data.state > 2 then
        --string.format("获得“%s”卡牌解锁", _G.LangUtil.GetLangPackValue(self.curItem.roleData.cfg.Name))
        end
        self.go_table.aortext_conotent.text = self.curHalo.data:GetLockTips()
        local text = _G.ConfigManager.player_halo_effect_cfg[self.curHalo.data.sid]
        -- local text1 = text:toString()
        -- self.go_table.aortext_conotent2.text = text1
        if isOn then
            self:TurnProp(text.base_att)
            local cardSid = _G.PlayerModel:GetInstance():GetEffectUser(1, self.curHalo.data.sid)
            if cardSid ~= 0 and cardSid ~= self.curRoleData.cfg.id then
                local data = self:GetRoleDataBySid(cardSid)
                if data then
                    self:SetData(data)
                end
            end
        end
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_change2, false)
        self.go_table.aorbtn_choose:SetActiveE(0)
        self:ClearShow()
        if isOn then
