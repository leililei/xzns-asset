                self:UpdateHaloByRole()
                local text = _G.ConfigManager.player_halo_effect_cfg[self.curHalo.data.sid]
                self:TurnProp(text.base_att)
            end
        end
    end
    if isOn then
        self.go_table.aorlooplist_HaloList:RefreshAllShowItem()
        self.refreshHaloRedpoint = true
    end
