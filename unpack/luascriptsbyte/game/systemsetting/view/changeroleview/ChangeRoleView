---初始化卡牌列表
function ChangeRoleView:InitCardList()
    self.CardList = {}
    local playerId = _G.PlayerModel:GetInstance():GetRoleSid()
    local tempList = {unLock = {}, Lock = {}}
    local id = _G.ConfigManager.discrete_cfg[100002][1][1]
    local params = _G.ConfigManager.discrete_cfg[100002]
    local initId = 0
    for _, v in pairs(params) do
        local cfg = _G.ConfigManager.card_cfg[v[1]]
        if cfg and cfg.UnitType == 1 then
            initId = cfg.id
            break
        end
    end
    local CardCommentManagerInst = CardCommentManager:GetInstance()
    local cardId = CardCommentManagerInst:GetCfgs(playerId).card
    local insert = _G.table.insert
    local curIndex = 1
    local IllustrationModelInst = require "IllustrationModel":GetInstance()
    _G.table.choose(
        _G.ConfigManager.card_cfg,
        function(k, v)
            if (v.UnitType == 1 or v.UnitType == 2) and v.Order > 1 and v.is_put_into then
                local data = CreateRoleData()
                data.cfg = v
                data.skinList = CardCommentManagerInst:GetAllSkins(v.id) or {}
                if not data.LockList then
                    data.LockList = {}
                    data.LockList[1] = true
                end
                for l, v2 in pairs(data.skinList) do
                    if l > 1 then
                        if CardCommentManagerInst:CheckSkin(v2) then
                            data.isLock = false
                        end
                        insert(data.LockList, not CardCommentManagerInst:CheckSkin(v2))
                    end
                end
                if data.cfg.id == cardId then
                    data.isUse = true
                    data.isChoose = true
                    self.useRoleData = _G.DeepCopy(data)
                    self.sourceUseRoleData = data
                    self.curRoleData = data
                    data.LockList[1] = not (IllustrationModelInst:HunjiangJieSuo(data.cfg.id) or data.cfg.id == initId)
                    for l, v2 in pairs(self.useRoleData.skinList) do
                        if v2 == playerId then
                            self.curRoleData.index = l
                            self.useRoleData.index = l
                            break
                        end
                    end
                    data.isLock = false
                else
                    if IllustrationModelInst:HunjiangJieSuo(data.cfg.id) or data.cfg.id == initId then
                        if data.cfg.id == initId then
                            data.LockList[1] = false
                            data.isLock = false
                        else
                            local star = IllustrationModelInst:GetCardMaxStar(data.cfg.id)
                            for _, v in pairs(_G.ConfigManager.discrete_cfg[101402]) do
                                if data.cfg.Order == v[1] and (star >= v[2] or data.cfg.id == id) then
                                    data.LockList[1] = false
                                    data.isLock = false
                                    break
                                end
                            end
                        end
                    end
                end
                if data.cfg.id ~= cardId then
                    if data.isLock then
                        _G.table.insert(tempList.Lock, data)
                    else
                        _G.table.insert(tempList.unLock, data)
                    end
                end
            end
        end
    )
    if not self.curRoleData then
        self.curRoleData = tempList[1]
    end
    self.CardList[1] = self.curRoleData
    _G.table.insertto(self.CardList, tempList.unLock)
    _G.table.insertto(self.CardList, tempList.Lock)
    _G.SortList(
        self.CardList,
        function(data)
            local num = 10
            if data.cfg.id == self.curRoleData.cfg.id then
                num = 10
            elseif not data.isLock then
                num = 9
                local key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "playerRole" .. data.cfg.id
                if _G.CS.WechatGameCore.PlayerPrefs.HasKey(key) then
                    if _G.CS.WechatGameCore.PlayerPrefs.GetInt(key) == 0 then
                        num = 7
                    end
                end
            else
                num = 5
            end
            return num, -data.cfg.id
        end
    )
    self.unlockCardList = {}
    self.unlockCardList[1] = self.curRoleData
    _G.table.insertto(self.unlockCardList, tempList.unLock)
    _G.SortList(
        self.unlockCardList,
        function(data)
            local num = data.cfg.id == self.curRoleData.cfg.id and 1 or 0
            return num, -data.cfg.id
        end
    )
end

---获取仓库中所有寄灵人
function ChangeRoleView:GetAllCardSids()
    local CardSids = {}
    for _, v in pairs(_G.StorageManager:GetInstance().Storages[_G.StorageID.Card].list) do
        if CardSids[v.sid] == nil and v.cfg.UnitType == 1 then
            CardSids[v.sid] = v
        end
    end
    return CardSids
end

---刷新所有头像
function ChangeRoleView:RefreshCardList(trans, index)
    index = index + 1
    local instance = trans:GetInstanceIDE()
    if not self.itemList[instance] then
        self.itemList[instance] = ChangeRoleItemList.Create(trans, _G.handler(self, self.OnClickItem))
    end
    self.itemList[instance]:UpdateData(self.CardList, index)

    local card
    if self.curItem ~= nil then
        for i = 1, 3 do
            card = self.CardList[(index - 1) * 3 + i]
            if card and card.isChoose then
                self.curItem = self.itemList[instance].itemList[i]
                break
            end
        end
    elseif index == 1 and self.curItem == nil then
        self.curItem = self.itemList[instance].itemList[1]
    end
end

---点击物体
---@param item ChangeRoleItem
function ChangeRoleView:OnClickItem(item)
    if not self.Title then
        return
    end
    if self.curRoleData and self.curRoleData.cfg.id == item.roleData.cfg.id then
        return
    end
    if self.curItem then
        -- if self.curItem.roleData.cfg.id == item.roleData.cfg.id then
        --     return
        -- end
        if self.curRoleData then
            self.curRoleData.isChoose = false
        end
        -- self.curItem.roleData.isChoose = false
        self.curItem:ChangeChoose()
        self.curItem = nil
    end
    item.roleData.isChoose = true
    item:ChangeChoose()
    self.curItem = item

    if item.roleData.cfg.id ~= self.useRoleData.cfg.id then
        item.roleData.index = 1
    end
    if item.roleData.LockList[item.roleData.index] then
        if item.roleData.index == 1 then
            if item.roleData.cfg.Order == _G.ConfigManager.discrete_cfg[101402][1][1] then
                self.go_table.aortext_conotent.text = _G.LangUtil.GetLangPackValue(90020300185)
                self.go_table.obj_conotent:SetActiveE(0)
                self.go_table.obj_PropContent:SetActiveE(0)
            elseif item.roleData.cfg.Order == _G.ConfigManager.discrete_cfg[101402][2][1] then
                self.go_table.aortext_conotent.text = _G.LangUtil.GetLangPackValue(90020300186)
                self.go_table.obj_conotent:SetActiveE(0)
                self.go_table.obj_PropContent:SetActiveE(0)
            end
        else
            local cfg = CardCommentManager:GetInstance():GetCfgs(item.roleData.skinList[item.roleData.index])
            if cfg then
                self.go_table.aortext_conotent.text = _G.GetLangPackValue(90021300121, _G.GetLangPackValue(cfg.name))
            end
        end
        self.go_table.obj_Road_node:SetActiveE(1)
    else
        self.go_table.obj_Road_node:SetActiveE(0)
    end
    self:SetData(item.roleData, nil, _G.handler(self, self.UpdateEffectByRole))
    self:SwithcChangeBtn()
end

function ChangeRoleView:RefreshAllPlayerRole()
    for i = 1, #self.CardList do
        local item = self.CardList[i]
        if not item.isLock then
            local key
            for _, v in pairs(self.CardList[i].skinList) do
                key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "playerRole" .. v
                _G.CS.WechatGameCore.PlayerPrefs.SetInt(key, 0)
            end
        end
    end
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.PlayerRole.id)
end

function ChangeRoleView:RefreshAllTitle()
    for k, item in pairs(self.TitleDatas) do
        if item.state ~= 0 then
            local key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "title" .. item.sid
            _G.CS.WechatGameCore.PlayerPrefs.SetInt(key, 0)
        end
    end
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.PlayerTitle.id)
end

function ChangeRoleView:RefreshAllHalo()
    for k, item in pairs(self.HaloDatas) do
        if item.state ~= 0 then
            local key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "halo" .. item.sid
            _G.CS.WechatGameCore.PlayerPrefs.SetInt(key, 0)
        end
    end
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.PlayerHalo.id)
end

---更换按钮的状态
function ChangeRoleView:SwithcChangeBtn()
    local isShow
    if self.curRoleData == nil or self.curRoleData.LockList[self.curRoleData.index] or self:CheckRoleDataIsUse() then
        isShow = false
    else
        isShow = true
    end

    self.go_table.aorbtn_change:GetComponentE(typeof(CS.AorImage)):SetGray(not isShow)
    if isShow then
        self.go_table.aortext_changeLabel.color = _G.ColorTools.FormatColorByString("914801")
    else
        self.go_table.aortext_changeLabel.color = _G.ColorTools.FormatColorByString("414141")
    end

    self:UpdateBtnLabel()
end

---更新按钮显示内容
function ChangeRoleView:UpdateBtnLabel()
    local str
    if self:CheckRoleDataIsUse() then
        str = 90021300066
    elseif self.curRoleData.isLock or self.curRoleData.LockList[self.curRoleData.index] then
        str = 90021300067
    else
        str = 90021300068
    end
    self.go_table.aortext_changeLabel.text = _G.LangUtil.GetLangPackValue(str)
end

function ChangeRoleView:CheckRoleDataIsUse()
    return self.curRoleData.cfg.id == self.useRoleData.cfg.id and self.curRoleData.index == self.useRoleData.index
end

---设置卡牌数据
---@param roleData  ChangeRoleData	卡牌类
function ChangeRoleView:SetData(roleData, index, call)
    if roleData == nil then
        return
    end
    if not self.inited then
        self:InitRenderTexture()
        self.inited = true
        if self.LoadFunctionCall then
            self.LoadFunctionCall()
            self.LoadFunctionCall = nil
        end
    end
    if index and roleData then
        index = index <= 1 and 1 or index
        if index > #roleData.skinList then
            index = #roleData.skinList
        end
    end
    self.isCur = false

    local pos = self.ControlCameraPosArr[1]
    self.ControlCamera:SetPosition(pos[1], pos[2], pos[3])

    local qua = self.ControlCameraQuaArr[1]
    self.ControlCamera:SetRotation(qua[1], qua[2], qua[3], qua[4])
    if self.sceneTrans == nil then
        self.sceneTrans = self.ResList["sceneTrans"]
        local cfg = CardCommentManager:GetInstance():GetCfgs(self.curRoleData.skinList[self.curRoleData.index])
        LoadRoleScene(
            self,
            cfg.ModelPathHi,
            function(roleTrans)
                if cfg.id ~= self.curRoleData.skinList[self.curRoleData.index] then
                    _G.DestroyObject(roleTrans)
                    return
                end
                if self:IsNil() then
                    return
                end
                if self.AnimComponent then
                    self.AnimComponent:Play("idle_1")
                end

                if self.titleID > 0 then
                    for _, v in pairs(self.TitleDatas) do
                        if v.sid == self.titleID then
                            self.curTitle = {}
                            self.curTitle.data = v
                            self:SapwnTitle(
                                {isChoose = true, data = v},
                                function()
                                    self:InitRotPos()
                                end
                            )
                            break
                        end
                    end
                else
                    self:SapwnTitle(
                        nil,
                        function()
                            self:InitRotPos()
                        end
                    )
                end
                if self.haloID > 0 then
                    for _, v in pairs(self.HaloDatas) do
                        if v.sid == self.haloID then
                            self.curHalo = {}
                            self.curHalo.data = v
                            self:SpawnHalo({isChoose = true, data = v})
                            break
                        end
                    end
                end
            end
        )
    else
        if roleData.cfg.id ~= self.curRoleData.cfg.id or (index and self.curRoleData.index ~= index) then
            self.curRoleData = roleData
            if index then
                self.curRoleData.index = index
            end
            local cfg = CardCommentManager:GetInstance():GetCfgs(roleData.skinList[roleData.index])
            LoadRoleScene(
                self,
                cfg.ModelPathHi,
                function(roleTrans)
                    if cfg.id ~= self.curRoleData.skinList[self.curRoleData.index] then
                        _G.DestroyObject(roleTrans)
                        return
                    end
                    if self:IsNil() then
                        return
                    end
                    if self.AnimComponent then
                        self.AnimComponent:Play("idle_1")
                    end

                    if self.Title then
                        self.Title.gameObject:SetParentE(self.roleTrans)
                        self:SetTitlePos()
                        _G.GameUtil.SetActiveByCondition(self.Title.gameObject, true)
                    end
                    if self.Halo then
                        self.Halo.gameObject:SetParentE(self.roleTrans)
                        self:SetHaloPos(self.curHalo.data.type)
                        _G.GameUtil.SetActiveByCondition(self.Halo.gameObject, true)
                    end
                    self:InitRotPos()
                    if call then
                        call()
                    end
                end
            )
        else
            self.isCur = true
            self:InitRotPos()
            if call then
                call()
            end
        end
    end
    local count = #self.curRoleData.skinList
    self.go_table.aorbtn_Left:SetActiveE(self.curRoleData.index > 1 and 1 or 0)
    self.go_table.aorbtn_Right:SetActiveE(self.curRoleData.index >= count and 0 or 1)
    local cfg = CardCommentManager:GetInstance():GetCfgs(roleData.skinList[self.curRoleData.index])
    if self.curRoleData.index == 1 then
        self.go_table.aortext_equTips.text = _G.GetLangPackValue(self.curRoleData.cfg.Name)
    else
        self.go_table.aortext_equTips.text =
            _G.GetLangPackValue(self.curRoleData.cfg.Name) .. "·" .. _G.GetLangPackValue(cfg.name)
    end
    if count > 1 then
        if self.curRoleData.skinList[self.curRoleData.index + 1] then
            local key =
                tostring(_G.PlayerModel:GetInstance().role_uid) ..
                "playerRole" .. self.curRoleData.skinList[self.curRoleData.index + 1]
            self.go_table.obj_redPointR:SetActiveE(_G.CS.WechatGameCore.PlayerPrefs.GetInt(key) == 1 and 1 or 0)
        end
        if self.curRoleData.skinList[self.curRoleData.index - 1] then
            local key =
                tostring(_G.PlayerModel:GetInstance().role_uid) ..
                "playerRole" .. self.curRoleData.skinList[self.curRoleData.index - 1]
