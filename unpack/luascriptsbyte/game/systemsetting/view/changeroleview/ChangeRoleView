function ChangeRoleView:OnToggleRole(isOn)
    if not self.roleTb then
        self.roleTb = _G.GetAutoGoTable(self.go_table.toggle_role)
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_conotent, not isOn)
    self.go_table.obj_PropContent:SetActiveE(0)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorlooplist_RolesList, isOn)
    _G.GameUtil.SetActiveByCondition(self.roleTb.aorimage_isOn, isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_change, isOn)

    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Road_node, isOn and self.curRoleData.isLock)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_change2, not isOn)
    self.go_table.aorbtn_choose:SetActiveE(isOn and 0 or 1)
    if isOn then
        if self.curRoleData.LockList[self.curRoleData.index] then
            if self.curRoleData.index == 1 then
                if self.curRoleData.cfg.Order == _G.ConfigManager.discrete_cfg[101402][1][1] then
                    self.go_table.aortext_conotent.text = _G.LangUtil.GetLangPackValue(90020300185)
                    self.go_table.obj_conotent:SetActiveE(0)
                    self.go_table.obj_PropContent:SetActiveE(0)
                elseif self.curRoleData.cfg.Order == _G.ConfigManager.discrete_cfg[101402][2][1] then
                    self.go_table.aortext_conotent.text = _G.LangUtil.GetLangPackValue(90020300186)
                    self.go_table.obj_conotent:SetActiveE(0)
                    self.go_table.obj_PropContent:SetActiveE(0)
                end
            end
        else
            local cfg = CardCommentManager:GetInstance():GetCfgs(self.curRoleData.skinList[self.curRoleData.index])
            if cfg then
                self.go_table.aortext_conotent.text = _G.GetLangPackValue(90021300121, _G.GetLangPackValue(cfg.name))
            end
        end
        ---从其它页签切回形象，刷新
        local playerId = _G.PlayerModel:GetInstance():GetRoleSid()
        local CardCommentManagerInst = CardCommentManager:GetInstance()
        local cardId = CardCommentManagerInst:GetCfgs(playerId).card
        local index = 0
        for k, v in pairs(self.CardList) do
            if v.cfg.id == cardId then
                v.isChoose = true
                index = k
            else
                v.isChoose = false
            end
        end
        self:SetData(self.sourceUseRoleData, nil, _G.handler(self, self.UpdateEffectByRole))
        self.go_table.aorlooplist_RolesList:RefreshAllShowItem()
        self.go_table.aorlooplist_RolesList:Jump2SpercialIndex(_G.Mathf.Ceil(index / 3), _G.Mathf.Floor((index - 1) / 3))
        self:SwithcChangeBtn()
    end
