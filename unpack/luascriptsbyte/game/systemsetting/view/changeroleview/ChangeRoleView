---按钮点击事件在这里派发
function ChangeRoleView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_close" or name == "@_aorbtn_close2" then
        if self.onclick_time_interval + 0.5 >= _G.TimeUtil:GetServerUnixTime() then
            return
        end
        if self.closeFunction then
            self.closeFunction()
        end
        self:CloseView()
        self:RefreshAllPlayerRole()
        if self.refreshTitleRedpoint then
            self:RefreshAllTitle()
        end
        if self.refreshHaloRedpoint then
            self:RefreshAllHalo()
        end
    elseif name == "@_aorbtn_change" then
        self:ChangeRole()
    elseif name == "$_toggle_role" then
        if isOn then
            _G.AudioManager.PlayAudioByAudioCfgID(_G.AudioClipTypeEnum.clickAuido)
        end
        self:OnToggleRole(isOn)
    elseif name == "$_toggle_title" then
        if isOn then
            _G.AudioManager.PlayAudioByAudioCfgID(_G.AudioClipTypeEnum.clickAuido)
        end
        self:OnToggleTitle(isOn)
    elseif name == "$_toggle_halo" then
        if isOn then
            _G.AudioManager.PlayAudioByAudioCfgID(_G.AudioClipTypeEnum.clickAuido)
        end
        self:OnToggleHalo(isOn)
    elseif name == "@_aorbtn_change2" then
        if self.toggleFunc then
            self.toggleFunc(self)
        end
    elseif name == "@_aorbtn_choose" then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.PlayerInfoChangeRoleView.Name,
            self.unlockCardList,
            self.curRoleData,
            _G.handler(self, self.ChangeEffUser)
        )
    elseif name == "@_aorbtn_Left" then
        self:ChangeSkin(-1)
    elseif name == "@_aorbtn_Right" then
        self:ChangeSkin(1)
    end
end

function ChangeRoleView:ChangeEffUser(index)
    local roleData = self.unlockCardList[index]
    if index > 0 and roleData ~= self.curRoleData then
        self:SetData(roleData)
        if self.go_table.toggle_title.isOn then
            local id = _G.PlayerModel:GetInstance():GetRoleEffect(2, self.curRoleData.cfg.id)
            self.titleID = id
            self.go_table.aorlooplist_TitleList:RefreshAllShowItem()
            self:ChangeTitleBtn(self.curTitle.data, self.titleID)
        end
        if self.go_table.toggle_halo.isOn then
            local id = _G.PlayerModel:GetInstance():GetRoleEffect(1, self.curRoleData.cfg.id)
            self.haloID = id
            self.go_table.aorlooplist_HaloList:RefreshAllShowItem()
            self:ChangeTitleBtn(self.curHalo.data, self.haloID)
        end
        if self.toggleFunc then
            self.toggleFunc(self, true)
        end
    end
    if roleData.cfg.id ~= self.curRoleData.cfg.id then
        if self.toggleFunc then
            self.toggleFunc(self)
        end
        return
    end
end

