function ChangeRoleView:SapwnTitle(item, call)
    if true then
        return
    end
    if not self.Title or _G.IsNil(self.Title.gameObject) then
        _G.PoolsManager:GetInstance():Spawn(
            "CommonPrefab/World/Common_TitleWithDesignation",
            _G.ePoolType.Temporary,
            self.roleTrans,
            function(trans)
                local go_table = _G.GetAutoGoTable(trans)
                trans:AddComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
                self.Title = go_table
                self:SetTitlePos()
                if item then
                    if item.data.cfg.type_title == 1 then
                        go_table.aorrawimage_Title:LoadImage(
                            item.data.icon,
                            function()
                                go_table.aorrawimage_Title:SetNativeSize()
                                go_table.aorrawimage_Title:SetLocalScaleXYZ(self.titleScale)
                            end
                        )
                        if self.Title.item then
                            _G.DestroyObject(self.Title.item)
                            self.Title.item = nil
                        end
                        _G.GameUtil.SetActiveByCondition(self.Title.aorrawimage_Title, true)
                    else
                        _G.GameUtil.SetActiveByCondition(self.Title.aorrawimage_Title, false)
                        if self.Title.item then
                            _G.DestroyObject(self.Title.item)
                            self.Title.item = nil
                        end
                        _G.UIUtils.LoadEffectTitleOrFrame(
                            item.data.resPath,
                            self.Title.gameObject,
                            function(trans)
                                if self:IsNil() then
                                    _G.DestroyObject(trans)
                                    return
                                end
                                trans:SetLayerAndChild(30)
                                self.Title.item = trans
                                local x, y, z = self.Title.aorrawimage_Title:GetPosition()
                                trans:SetPosition(x, y + 0.2, z)
                                self.Title.item:SetLocalScaleXYZ(self.titleScale)
                                _G.GameUtil.SetActiveByCondition(trans, true)
                            end
                        )
                    end
                end

                go_table.aortext_TextName.text = string.AddColor(_G.PlayerModel:GetInstance().role_name, "ffee9c")
                if call then
                    call()
                end
            end
        )
    elseif self.Title then
        _G.GameUtil.SetActiveByCondition(self.Title.aorrawimage_Title, item.isChoose)
        if self.Title.item then
            _G.DestroyObject(self.Title.item)
            self.Title.item = nil
        end
        if item.data.cfg.type_title == 1 then
            self.Title.aorrawimage_Title:LoadImage(
                item.data.icon,
                function()
                    self.Title.aorrawimage_Title:SetNativeSize()
                    self.Title.aorrawimage_Title:SetLocalScaleXYZ(self.titleScale)
                end
            )
        else
            if item.isChoose then
                _G.UIUtils.LoadEffectByPath(
                    item.data.resPath,
                    self.Title.gameObject,
                    function(trans)
                        if self:IsNil() then
                            _G.DestroyObject(trans)
                            return
                        end
                        trans:SetLayerAndChild(30)
                        self.Title.item = trans
                        local x, y, z = self.Title.aorrawimage_Title:GetPosition()
                        trans:SetPosition(x, y + 0.2, z)
                        self.Title.item:SetLocalScaleXYZ(self.titleScale)
                        _G.GameUtil.SetActiveByCondition(trans, true)
                    end,
                    nil,
                    0,
                    {0, 0, 0},
                    1,
                    0,
                    true,
                    false,
                    0
                )
                _G.GameUtil.SetActiveByCondition(self.Title.aorrawimage_Title, false)
            end
        end
    end
end

