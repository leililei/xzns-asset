---@class SettingBasePlayerView : Component	中文描述
---@field private go_table SystemSettingView._obj_PlayerBaseInfo_GoTable
---@field data role.i_role_info
local SettingBasePlayerView = _G.BaseClass("SettingBasePlayerView", _G.Component)
local PlayerType = {
    Player = "1",
    OtherPlayer = "2",
    Robot = "3"
}
local UIUtils = _G.UIUtils
---创建对象时,入口构造函数
function SettingBasePlayerView:OnCreate(ownerView, data)
    self.ownerView = ownerView
    self.data = data
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self:InitView()
    self:HideOther()
end

---初始化界面
function SettingBasePlayerView:InitView()
    -- if self.playerType == PlayerType.Robot then
    --     self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(self.RobotCfg.name)
    -- else
    --     self.go_table.aortext_name.text = self.data.name
    -- end
    self.go_table.aortext_name.text = self.data.name
    self.go_table.aorimage_portrait.SpriteName = _G.ConfigManager.player_portrait_cfg[self.data.style].portrait1
    ---self.data.frame = 0 默认头像框 100
    local frame = self.data.frame
    if _G.ConfigManager.player_frame_cfg[frame].type_title ~= 2 then
        self.go_table.aorrawimage_frame:LoadImage(_G.ConfigManager.player_frame_cfg[frame].frame)
    else
        UIUtils.LoadEffectByPath(
            _G.ConfigManager.player_frame_cfg[frame].frame,
            self.go_table.aorrawimage_frame,
            function(item)
                item:AddComponentE(_G.typeof(_G.CS.UIParticleOrderChange))
                item:SetLocalScale(1.2,1.2,1)
            end
        )
    end
    _G.UIUtils.SetImageFont({self.go_table.aorimage_level1}, self.data.level, _G.AorImageFont.Cardlevel)
    ---@type SDKServerShowInfo
    local servername = _G.ServerManager:GetInstance():GetServerNameByServerID(self.data.server_id)
    if servername then
        self.go_table.aortext_sever.text = servername
    else
        self.go_table.aortext_sever.text = self:GetInSeverName()
    end
    self.go_table.aortext_id.text = self.data.uid
    self.go_table.aortext_sociaty.text =
        _G.string.IsNullOrEmpty(self.data.union) and _G.GetLangPackValue(90022500411) or self.data.union
    local cfg = _G.ConfigManager.afk_cfg
    if self.data.afk == 0 then
        cfg = cfg[101001]
    else
        cfg = cfg[self.data.afk]
    end
    self.go_table.aortext_guank.text = cfg.chapter .. "-" .. cfg.section
end

---获取内网服务器信息
function SettingBasePlayerView:GetInSeverName()
    local list = {}
    local curServer = _G.ServerManager:GetInstance().CurServer
    for _, v in pairs(_G.ConfigManager.server_list_cfg) do
        if v.ServerID == self.data.server_id then
            _G.table.insert(list, v)
        end
    end
    local count = #list
    if count == 0 or count > 1 then
        return curServer.ServerName
    else
        return list[1].ServerName
    end
end

---隐藏界面
function SettingBasePlayerView:HideOther()
    if self.ownerView.isCurPlayer then
        return
    end
    self.go_table.obj_redpoint:SetActiveE(0)
    self.go_table.aorbtn_changeName:SetActiveE(0)
    self.go_table.aorbtn_changeIcon:SetActiveE(0)
end

---复制uid
function SettingBasePlayerView:CopyUid()
    --_G.CS.UnityEngine.GUIUtility.systemCopyBuffer = self.data.uid
    _G.GameUtil.CopyContent(self.data.uid)
    _G.PopWindowManager:GetInstance():ShowAllTips(200105)
end

---更改名字
function SettingBasePlayerView:ChangeName()
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.SettingChangeNameView.Name,
        _G.handler(self, self.EnterNameCallBack)
    )
end

---接收服务器更改名字的回调，同时修改包含名字的界面及模型
function SettingBasePlayerView:EnterNameCallBack(name)
    self.go_table.aortext_name.text = name
    _G.PlayerModel:GetInstance():UpdateName(name)
    _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name):UpdateName()
    _G.WorldManager:GetInstance():GetCurWorldPlayer().TitleTextName.text = "<color=#fff08d>" .. name .. "</color>"
    _G.PlayerModel:GetInstance().update_name_times = _G.PlayerModel:GetInstance().update_name_times + 1
    _G.PopWindowManager:GetInstance():ShowAllTips(200106)
end

--打开更换头像界面
function SettingBasePlayerView:OpenChangeIcon()
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ChangeIconView.Name,
        self.data.style,
        self.data.frame,
        _G.handler(self, self.UpdatePortrait),
        _G.handler(self, self.UpdateFrame)
    )
end

--更新头像
function SettingBasePlayerView:UpdatePortrait(sid)
    if not sid then
        return
    end
    self.data.style = sid
    self.go_table.aorimage_portrait.SpriteName = _G.ConfigManager.player_portrait_cfg[self.data.style].portrait1
    _G.PlayerModel:GetInstance():SetRoleStyle(sid)
    _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name):UpdatePlayerInfo()
end

--更新头像框
function SettingBasePlayerView:UpdateFrame(sid)
    if not sid then
        return
    end
    self.data.frame = sid
    _G.PlayerModel:GetInstance():UpdateCurFrame(sid)
    _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name):UpdatePlayerInfo()
    if _G.ConfigManager.player_frame_cfg[self.data.frame].type_title ~= 2 then
        UIUtils.RemoveChildren(self.go_table.aorrawimage_frame)
        self.go_table.aorrawimage_frame:LoadImage(_G.ConfigManager.player_frame_cfg[self.data.frame].frame)
    else
        self.go_table.aorrawimage_frame.color = _G.Color.New(1,1,1,0)
        UIUtils.LoadEffectByPath(
            _G.ConfigManager.player_frame_cfg[self.data.frame].frame,
            self.go_table.aorrawimage_frame,
            function(item)
                item:SetLocalScale(1.2,1.2,1)
            end
        )
    end
end

function SettingBasePlayerView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_copyId then
        self:CopyUid()
    elseif go == self.go_table.aorbtn_changeIcon then
        self:OpenChangeIcon()
    elseif go == self.go_table.aorbtn_changeName then
        self:ChangeName()
    end
end

return SettingBasePlayerView
