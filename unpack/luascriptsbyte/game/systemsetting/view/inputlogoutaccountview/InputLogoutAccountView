---@class InputLogoutAccountView : UIBaseView	中文描述
---@field public go_table InputLogoutAccountView_GoTable GoTable
local InputLogoutAccountView = _G.BaseClass("InputLogoutAccountView", _G.UIBaseView)
--_G.InputLogoutAccountView = InputLogoutAccountView

function InputLogoutAccountView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.code = _G.tostring(_G.math.random(100000, 999999))
end

---界面的入口函数
function InputLogoutAccountView:OnCreate()
    self.go_table.aortext_content.text = _G.GetLangPackValue(90000010822, self.code)
end

---按钮点击事件在这里派发
function InputLogoutAccountView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.aorbtn_1 then
        if self.go_table.input_enterCode.text == self.code then
            _G.SDKManager:GetInstance():DeleteUserId()
            self:Close()
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(153)
        end
    elseif go == self.go_table.aorbtn_2 then
        self:Close()
    end
end

return InputLogoutAccountView
