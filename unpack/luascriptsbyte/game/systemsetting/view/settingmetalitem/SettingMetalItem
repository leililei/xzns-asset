---@class SettingMetalItem	系统设置界面
---@field data player_medal_cfg_Item 勋章数据
local SettingMetalItem = _G.BaseClass("SettingMetalItem")

---类的构造函数
function SettingMetalItem:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    --  _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.SetEventTrigger(self.go_table.aorbtn_metal, "onDown", _G.handler(self, self.OnDown))
    _G.SetEventTrigger(self.go_table.aorbtn_metal, "onUp", _G.handler(self, self.OnUp))
end

function SettingMetalItem:Init(sid)
    self.sid = sid

    if sid == 0 then
        self.go_table.aorrawimage_icon:SetActiveE(0)
        return
    end
    self.isLongClick = false
    self.data = _G.ConfigManager.player_medal_cfg[self.sid]
    self:UpdateMetal()
end

function SettingMetalItem:UpdateMetal()
    self.go_table.aorrawimage_icon:SetActiveE(1)
    --TODO 加载勋章
    self.go_table.aorrawimage_icon:LoadImage(self.data.medal)
end

function SettingMetalItem:OnDown()
    if self.sid == 0 then
        return
    end
    if self.isCurPlayer then
        self.timer = _G.TimerManager:GetInstance():GetTimer(0.5, self.LongClick, self, true, false, true)
        self.timer:Start()
    end
end

function SettingMetalItem:OnUp()
    if not self.isCurPlayer then
        if self.sid <= 0 then
            return
        end
        require("CommonTipManager"):GetInstance():OpenMedalView(self.transform, self.data.ID)
        return
    end
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end

    if self.isLongClick then
        self.isLongClick = false
        return
    end
    if self.callback then
        self.callback()
    end
end

function SettingMetalItem:LongClick()
    self.isLongClick = true
    --TODO 出现
    require("CommonTipManager"):GetInstance():OpenMedalView(self.transform, self.data.ID)
end

function SettingMetalItem:__init(obj, index, isCurPlayer, callback, view)
    self.gameObject = obj
    self.transform = obj
    self.callback = callback
    self.index = index
    self.isCurPlayer = isCurPlayer
    self.view = view
    self:Awake()
end

return SettingMetalItem
