---@class SettingChangeNameView : UIBaseView	中文描述
---@field public go_table SettingChangeNameView_GoTable GoTable
local SettingChangeNameView = _G.BaseClass("SettingChangeNameView", _G.UIBaseView)
--_G.SettingChangeNameView = SettingChangeNameView

function SettingChangeNameView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SettingChangeNameView:OnCreate(callback)
    self.callback = callback
    self:initChangeName()
end

function SettingChangeNameView:initChangeName()
    local cost = _G.ConfigManager.discrete_cfg[101301]
    local firstFlag = _G.PlayerModel:GetInstance().update_name_times > 0
    local index = math.min(_G.PlayerModel:GetInstance().update_name_times + 1, #cost)
    local coinIndex = firstFlag and 2 or 1
    self.go_table.aortext_free:SetActiveE(firstFlag and 0 or 1)
    self.go_table.aortext_coinNum:SetActiveE(firstFlag and 1 or 0)
    -- if firstFlag then
    --     self.go_table.aortext_enter:SetLocalPosition(-43.8, 1, 0)
    -- else
    --     self.go_table.aortext_enter:SetLocalPositionToZero()
    -- end
    self.custome = cost[index][coinIndex]
    self.go_table.aortext_coinNum.text = "X" .. self.custome
    self.go_table.input_Name.text = ""
    local cfg = _G.ConfigManager.discrete_cfg[100145][1]
    local limitNum = _G.GameUtil.GetIsUseChinese() and cfg[1] or _G.GameUtil.IsUsedRussian() and cfg[3] or cfg[2]
    _G.GameUtil.InputFieldCharacterLimit(
            self.go_table.input_Name,
            limitNum,
            nil,
            true,
            nil,
            nil,
            true
    )
end

---按钮点击事件在这里派发
function SettingChangeNameView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:Close()
    elseif name == "@_aorbtn_RandomName" then
        self:RandomName()
    elseif name == "@_aorbtn_enter" then
        self:EnterName()
    end
end

---确定
function SettingChangeNameView:EnterName()
    local msg = {}
    --msg.name = self.go_table.input_Name.text
    msg.name = self.go_table.input_Name.text
    if _G.string.IsNullOrEmpty(msg.name) then
        _G.PopWindowManager:GetInstance():ShowAllTips(200117)
        return
    end
    _G.GameUtil.SecCheck(msg.name, "1",function()
        local firstFlag = _G.PlayerModel:GetInstance().update_name_times > 0
        if firstFlag then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                    200303,
                    nil,
                    function()
                        _G.SystemSettingManager:GetInstance():UpdateName(
                                self.go_table.input_Name.text,
                                _G.handler(self, self.EnterNameCallBack)
                        )
                    end,
                    nil,
                    nil,
                    nil,
                    self.custome
            )
        else
            _G.SystemSettingManager:GetInstance():UpdateName(
                    self.go_table.input_Name.text,
                    _G.handler(self, self.EnterNameCallBack)
            )
        end
    end)
end

function SettingChangeNameView:EnterNameCallBack(data)
    local name = self.go_table.input_Name.text
    if _G.string.IsNullOrEmpty(name) then
        return
    end
    if data.ack == 1 then
        if self.callback then
            self.callback(self.go_table.input_Name.text)
        end
        _G.StorageManager:GetInstance():ConsumeItem(_G.ResPropID.Diamond, 0, self.custome)
        self:Close()
    elseif data.ack == 2 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ResPropID.Diamond)
    end
end

---获取随即名字
function SettingChangeNameView:RandomName()
    self.go_table.input_Name.text = _G.LoginManager:GetInstance():GetRandomName()
end

return SettingChangeNameView
