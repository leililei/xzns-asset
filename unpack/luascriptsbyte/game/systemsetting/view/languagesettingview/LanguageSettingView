---@class LanguageSettingView : UIBaseView  下边栏菜单
---@field go_table HeroicIconPreView_GoTable
local LanguageSettingView = _G.BaseClass("LanguageSettingView", _G.UIBaseView)

function LanguageSettingView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function LanguageSettingView:OnCreate()
    self:UpdateView()
end

---刷新数据
function LanguageSettingView:FreshData()
    self.list = _G.GameUtil.GetFunctionData(_G.FunctionBlock.language_list) or {}
    --self.list = _G.CS.XLocalization.LocalizationConfigration.GetInstance().langs
    self.nowLang = _G.CS.XLocalizationExtend.LocalizationHepler.GetUsedLang()
end

function LanguageSettingView:UpdateView()
    self:FreshData()
    self.go_table.obj_root:ClearChildren()
    self.tbList = {}
    for k, v in ipairs(self.list) do
        local obj = _G.InstantiateObject(self.go_table.obj_item,self.go_table.obj_root)
        local tb = _G.GetAutoGoTable(obj)
        self.tbList[k] = tb
        tb.aortext_lang.text = _G.GetLangPackValue(v[2])
        tb.obj_gou:SetActiveE(self.nowLang == v[1] and 1 or 0)
        tb["_onclick"] = _G.handlerbind(self, self.ClickItemBtn, tb, k)
    end
end

function LanguageSettingView:ClickItemBtn(go, isOn, tb, index)
    if go == tb.aorbtn_choose then
        for k, v in ipairs(self.tbList) do 
            v.obj_gou:SetActiveE(index == k and 1 or 0)
        end
        self.nowLang = self.list[index][1]
    end
end

---按钮点击事件在这里派发
function LanguageSettingView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        if self.nowLang ~= _G.CS.XLocalizationExtend.LocalizationHepler.GetUsedLang() then 
            _G.CS.XLocalizationExtend.LocalizationHepler.SetUsedLang(self.nowLang)
            _G.PopWindowManager:GetInstance():ShowAllTips(
                217,
                nil,
                function()
                    _G.GameUtil.DoQuit()
                end,
                function()
                    self:Close()
                end
            )
            --_G.PlayerPrefsManager.SetString(_G.PlayerPrefsKey.LangSetting,  self.nowLang, true)
        else
            self:Close()
        end
    end
end

function LanguageSettingView:OnDestroy()
    self:RemoveAllListener()
end

return LanguageSettingView
