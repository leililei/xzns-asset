---@class LogoutAccountView : UIBaseView	中文描述
---@field public go_table LogoutAccountView_GoTable GoTable
local LogoutAccountView = _G.BaseClass("LogoutAccountView", _G.UIBaseView)
--_G.LogoutAccountView = LogoutAccountView

function LogoutAccountView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.toggle_enter.isOn=false
    self.go_table.aorbtn_enter:SetGray(true)
    self.go_table.aortext_enterLabel.color= _G.ColorTools.FormatColorByString("afafaf")
end


---按钮点击事件在这里派发
function LogoutAccountView:OnClickBtn(go,isOn)
    if go==self.go_table.toggle_enter then
        self.go_table.aorbtn_enter:SetGray(not isOn)
        self.go_table.aortext_enterLabel.color= isOn and _G.ColorTools.FormatColorByString("FFFFFF") or _G.ColorTools.FormatColorByString("afafaf")
    elseif go==self.go_table.aorbtn_enter then
        if self.go_table.toggle_enter.isOn then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.InputLogoutAccountView.Name)
            self:Close()
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(158)
        end
    elseif go==self.go_table.aorbtn_close then
       self:Close()
    end
end


return LogoutAccountView