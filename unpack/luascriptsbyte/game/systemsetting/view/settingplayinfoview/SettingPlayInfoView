---@class SettingPlayInfoView : Component 系统设置玩家签名等界面(战力)
---@field private go_table SystemSettingView._obj_playerInfo_GoTable
---@field private ownerView SystemSettingView
---@field Metals SettingMetalItem[]
local SettingPlayInfoView = _G.BaseClass("SettingPlayInfoView", _G.Component)

local PlayerType = {
    Player = "1",
    OtherPlayer = "2",
    Robot = "3"
}

---创建对象时,入口构造函数
function SettingPlayInfoView:OnCreate(ownerView, data)
    self.ownerView = ownerView
    self.data = data
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self.skills_obj = {
        [1] = self.go_table.obj_skill1,
        [2] = self.go_table.obj_skill2,
        [3] = self.go_table.obj_skill3
    }
    self:InitView()
end

function SettingPlayInfoView:InitView()
    self.go_table.obj_Placeholder:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Text)).text =
        _G.LangUtil.TryGetLangValue(90021300010)

    --self.characterLimit = _G.ConfigManager.discrete_cfg[101401][1][1]
    _G.GameUtil.InputFieldCharacterLimitNew(self.go_table.input_sign, _G.ConfigManager.discrete_cfg[101401][1][1])
    self:UpdateLocalSign(self.data.sign)
    --self.go_table.input_sign.onValueChanged:AddListener(_G.handler(self, self.OnInputChange))
    --_G.GameUtil.InputFieldCharacterLimit(  self.go_table.input_sign, self.characterLimit )
    self.go_table.input_sign.onEndEdit:AddListener(_G.handler(self, self.UpdateNetSign))

    --self.go_table.input_sign.characterLimit = self.characterLimit
    self:InitCardList()
    --self:InitMetal()
    self:InitCombine()
    self:HideOther()
end
---隐藏其他
function SettingPlayInfoView:HideOther()
    if self.ownerView.isCurPlayer then
        return
    end
    self.go_table.input_sign.enabled = false
    self.go_table.obj_Placeholder:SetActiveE(0)
    self.go_table.aorbtn_OnSign:SetActiveE(0)
end

---更新本地签名
function SettingPlayInfoView:UpdateLocalSign(str)
    self.go_table.input_sign.text = str
end

---更新签名
function SettingPlayInfoView:UpdateNetSign(str)
    if str == self.data.sign then
        _G.PopWindowManager:GetInstance():ShowAllTips(200103)
        _G.DelayDo(
            0.2,
            function()
                local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.SystemSettingView.Name)
                if window ~= nil then
                    self.go_table.input_sign.enabled = false
                end
            end
        )
        return
    end
    _G.SystemSettingManager:GetInstance():UpdateSign(str, _G.handler(self, self.UpdateSignCallBack))
end
---检测输入
function SettingPlayInfoView:OnInputChange()
    self:SubStringGetTotalIndex(self.go_table.input_sign.text)
end

--返回当前字符实际占用的字符数
local function SubStringGetByteCount(str, index)
    local curByte = string.byte(str, index)
    local byteCount = 1
    if curByte == nil then
        byteCount = 0
    elseif curByte > 0 and curByte <= 127 then
        byteCount = 1
    elseif curByte >= 192 and curByte <= 223 then
        byteCount = 2
    elseif curByte >= 224 and curByte <= 239 then
        byteCount = 3
    elseif curByte >= 240 and curByte <= 247 then
        byteCount = 4
    end
    return byteCount
end

--防止输入超限制字符
function SettingPlayInfoView:SubStringGetTotalIndex(str)
    local curIndex = 0
    local i = 1
    local lastCount = 1

    --- 策划要求12字符 中英文混输 中文算2字符 英文1
    local width = 0

    repeat
        lastCount = SubStringGetByteCount(str, i)

        if lastCount ~= 0 then
            if lastCount == 1 then
                width = width + 1
            else
                width = width + 2
            end
        end
        curIndex = curIndex + 1
        if width > self.characterLimit then
            local ssstr = string.sub(str, 1, i - 1)
            self.go_table.input_sign.text = ssstr
            break
        end
        i = i + lastCount
    until (lastCount == 0)
    -- return curIndex - 1
    -- return width
end

---更新签名回调
function SettingPlayInfoView:UpdateSignCallBack(data)
    if data.ack == 1 then
        self.data.sign = self.go_table.input_sign.text
        _G.PopWindowManager:GetInstance():ShowAllTips(200103)
    elseif data.ack == 2 then
        self.go_table.obj_Placeholder:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Text)).text = ""
        self.go_table.input_sign.text = ""
    end
    _G.DelayDo(
        0.2,
        function()
            local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.SystemSettingView.Name)
            if window ~= nil then
                self.go_table.input_sign.enabled = false
            end
        end
    )
end

---初始化合计机
function SettingPlayInfoView:InitCombine()
    local combineinfo
    if self.ownerView.playerType == PlayerType.OtherPlayer then
        combineinfo = self.data.skill_index
        self:InitRoleCombine(combineinfo)
    elseif self.ownerView.playerType == PlayerType.Robot then
        combineinfo = self.data.skill_index
        self:IintRobotCombin(combineinfo)
    else
        combineinfo = require "EmbattleModel":GetInstance():GetSkillIndex(_G.EmbattleType.AFKOnly)
        self:InitRoleCombine(combineinfo)
    end
end
---真实玩家信息
function SettingPlayInfoView:InitRoleCombine(combineinfo)
    if combineinfo == nil then
        combineinfo = {}
    end

    local card_skills_cfg = _G.ConfigManager.card_skills_cfg
    local combine_cfg = _G.ConfigManager.combine_cfg
    local cfg, cfg1, lv, isShow
    for i = 1, #self.skills_obj do
        isShow = false
        if combineinfo[i] ~= 0 then
            _G.GameUtil.SetActiveByCondition(self.skills_obj[i], true)
            local tb = _G.GetAutoGoTable(self.skills_obj[i])

            cfg1 = combine_cfg[combineinfo[i]]
            if cfg1 then
                lv = cfg1.classify
                cfg = card_skills_cfg[cfg1.skills[1]]
                if cfg then
                    tb.aorrawimage_icon:LoadImage(cfg.icon)
                end
                cfg = _G.ConfigManager.battle_skill_cfg[cfg.skills[1]]
                if cfg then
                    tb.aortext_type.text = _G.ConfigManager.language_package_cfg[cfg.Brief]
                end

                isShow = true
            end
        end
        _G.GameUtil.SetActiveByCondition(self.skills_obj[i], isShow)
    end
end
---机器人合击技
function SettingPlayInfoView:IintRobotCombin(combineinfo)
    local card_skills_cfg = _G.ConfigManager.card_skills_cfg
    local cfg, isShow
    for i = 1, #self.skills_obj do
        isShow = false
        if combineinfo[i] ~= 0 then
            _G.GameUtil.SetActiveByCondition(self.skills_obj[i], true)
            local tb = _G.GetAutoGoTable(self.skills_obj[i])
            cfg = card_skills_cfg[combineinfo[i]]
            if cfg then
                tb.aorrawimage_icon:LoadImage(cfg.icon)
                cfg = _G.ConfigManager.battle_skill_cfg[cfg.skills[1]]
                if cfg then
                    tb.aortext_type.text = _G.ConfigManager.language_package_cfg[cfg.Brief]
                end
                isShow = true
            end
        end
        _G.GameUtil.SetActiveByCondition(self.skills_obj[i], isShow)
    end
end
---初始化卡牌列表
function SettingPlayInfoView:InitCardList()
    self.card = {}

    local power = self.data.power or 0
    if self.ownerView.playerType == PlayerType.Player then
        local info = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.AFKOnly)
        power = 0 --self.data.power or
        for i = 1, #info do
            if info[i] ~= 0 then
                local cardd = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, info[i])
                if cardd then
                    power = power + cardd:GetPower()
                    _G.table.insert(self.card, cardd)
                end
            end
        end
    else
        if self.data.array ~= nil then
            for _, info in pairs(self.data.array) do
                if info.sid ~= 0 then
                    local data = require("CardData").New()
                    data:Parse({sid = info.sid, uid = info.sid, count = 1, lv = info.level, star = info.star})
                    _G.table.insert(self.card, data)
                end
            end
        end
    end

    self.go_table.aortext_MaxPower.text = _G.GameUtil.NumberToUnitStrFight(power)
    --self.go_table.looplist2_CardList:InitListView(#self.card, _G.handler(self, self.RefreshCard))
    for i = 1, #self.card do
        local data = self.card[i]
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.baseBodyItem,
            self.go_table.obj_akf_card_lists,
            function(cardItem)
                --cardItem:Show(data.sid, nil, data.star, data.soulLink_lv, data.lv, data.uid)
                cardItem.gameObject:SetLocalScaleXYZ(0.65)
                cardItem:ShowCardData(data)
            end
        )
    end
end

---获取背包中6张战力最高的卡牌
function SettingPlayInfoView:GetCardDatas()
    local CardDatas = _G.table.toArray(_G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card))
    _G.table.sort(
        CardDatas,
        function(a, b)
            return a:GetPower() > b:GetPower()
        end
    )
    local tb = {}
    for i = 1, 6 do
        tb[i] = CardDatas[i]
    end
    return tb
end

---刷新卡牌显示
function SettingPlayInfoView:RefreshCard(listView2, index)
    if index < 0 then
        return
    end
    local newItem = index + 1
    local item = listView2:NewListViewItem("$_obj_ListItem")
    local data = self.card[newItem]
    _G.ItemCardFactory:GetInstance():GetItemCard(
        _G.ItemCardFactory.itemCardType.baseBodyItem,
        item:GetChildE(0),
        function(cardItem)
            --cardItem:Show(data.sid, nil, data.star, data.soulLink_lv, data.lv, data.uid)
            cardItem:ShowCardData(data)
        end
    )
    return item
end

---初始化勋章
function SettingPlayInfoView:InitMetal()
    if self.Metals == nil then
        self.Metals = {}
        for i = 1, 5 do
            local item =
                require "SettingMetalItem".New(
                self.go_table["obj_metal" .. i],
                i,
                self.ownerView.isCurPlayer,
                _G.handler(self, self.OpenMetalView),
                self
            )
            self.Metals[i] = item
        end
    end
    local count = self.data.medal == nil and 0 or #self.data.medal
    for i = 1, #self.Metals do
        if i <= count then
            self.Metals[i]:Init(self.data.medal[i])
        else
            self.Metals[i]:Init(0)
        end
    end
end

---打开勋章界面
function SettingPlayInfoView:OpenMetalView()
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ChooseMetalView.Name,
        self.data.medal,
        _G.handler(self, self.UpdateMetal)
    )
end
---更新勋章显示
function SettingPlayInfoView:UpdateMetal(data)
    if not self.data.medal then
        self.data.medal = {}
    end
    if _G.table.same(self.data.medal, data) then
        return
    end
    _G.SystemSettingManager:GetInstance():UpdateMetal(
        data,
        function(msg)
            if msg.ack ~= 1 and msg.ack ~= "role_same_medal" then
                return
            end
            self.data.medal = data
            for i = 1, #self.Metals do
                if i <= #data then
                    self.Metals[i]:Init(data[i])
                end
            end
        end
    )
end
---点击按钮签名
function SettingPlayInfoView:OnSign()
    if not self.go_table.input_sign.enabled then
        self.go_table.input_sign.enabled = true
        self.go_table.input_sign:ActivateInputField()
    end
end

function SettingPlayInfoView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_OnSign then
        if self.ownerView.playerType == PlayerType.Player then
            self:OnSign()
        end
    elseif go == self.go_table.aorbtn_OnSign1 then
        if self.ownerView.playerType == PlayerType.Player then
            self:OnSign()
        end
    end
end
---销毁对象时,析构函数
function SettingPlayInfoView:OnDestroy()
end

return SettingPlayInfoView
