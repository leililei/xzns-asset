---@class ChooseMetalView	中文描述
---@field view ChooseMetalView 勋章界面
---@field data player_medal_cfg_Item 勋章数据
local MetalItem = _G.BaseClass("MetalItem")

---类的析构函数
function MetalItem:Dispose()
end

function MetalItem:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    _G.AddViewBtnClick(self.gameObject, _G.handler(self, self.OnClickBtn))
    if self.isTop then
        if self.effect then
            _G.GameUtil.SetActiveByCondition(self.effect, false)
        else
            _G.PoolsManager:GetInstance():Spawn(
                "",
                _G.ePoolType.UIEffect,
                self.transform,
                function(trans)
                    self.effect = trans
                    _G.GameUtil.SetActiveByCondition(self.effect, false)
                end
            )
        end
        local canvas = self.go_table.aorrawimage_icon:AddComponentE(typeof(CS.UnityEngine.Canvas))
        canvas.overrideSorting = true
        canvas.sortingOrder = 2000
    end
end

local MetalType = {
    SettingMetal = 101,
    TopMetal = 102,
    DownMetal = 103
}

function MetalItem:Init(data)
    self.data = data
    if self.isTop then
        self:TopShow()
    else
        self:DownShow()
    end
end

function MetalItem:ShowEffect()
    _G.GameUtil.SetActiveByCondition(self.effect, true)
    self.go_table.aorrawimage_icon:SetLocalScaleXYZ(2)
    self.go_table.aorrawimage_icon:DOScale(1, 1, 1, 0.2)
end

function MetalItem:TopShow()
    if self.data == nil then
        self.go_table.aortext_des.text = ""
        self.go_table.aorimage_add:SetActiveE(1)
        self.go_table.aorrawimage_icon:SetActiveE(0)
    else
        self.go_table.aorrawimage_icon:SetActiveE(1)
        self.go_table.aorrawimage_icon:LoadImage(self.data.medal)
        self.go_table.aortext_des.text = "" --_G.GetLangPackValue(self.data.name)
        self.go_table.aorimage_add:SetActiveE(0)
    end
    if self.effect then
        _G.GameUtil.SetActiveByCondition(self.effect, false)
    end
end

function MetalItem:DownShow()
    if self.data == nil then
        self.gameObject:SetActiveE(0)
        return
    end
    self.gameObject:SetActiveE(1)
    self.go_table.aorrawimage_icon:LoadImage(self.data.medal)
    self.go_table.aortext_des.text = _G.GetLangPackValue(self.data.name)

    self.isShow, self.index = self.view:CheckIsTop(self.data.ID)
    self.isLock = self:CheckIsLock()
    self:DisplayGou()

    --显示钩
end
---检测是否显示钩
function MetalItem:DisplayGou()
    self.go_table.aorimage_gou:SetActiveE(self.isShow and 1 or 0)
    if not self.isLock then
        self.go_table.aorimage_mask:SetActiveE(self.isShow and 1 or 0)
    else
        self.go_table.aorimage_mask:SetActiveE(0)
    end
end

function MetalItem:CheckIsLock()
    if self.data.unlock_type > 0 and #self.data.unlock_params > 0 then
        return _G.TaskModule.IsCompletedTask(self.data.unlock_params[1])
    else
        return false
    end
end
---顶部点击
function MetalItem:TopClick(go, isOn)
    if self.data == nil then
        return
    end
    self.view:CancelMetal(self.index)
end
---底部点击
function MetalItem:DownClick(go, isOn)
    if self.isShow then
        self.isShow = false
        self.view:CancelMetal(self.index)
    else
        self.view:ChangeMetal(
            self.data,
            function(index)
                self.isShow = true
                self.index = index
                self:DisplayGou()
            end
        )
    end
end

function MetalItem:OnClickBtn(go, isOn)
    if self.isTop then
        self:TopClick(go, isOn)
    else
        self:DownClick(go, isOn)
    end
end

function MetalItem.CreatItem(trans, view, isTop, index)
    local item = MetalItem.New()
    item.gameObject = trans
    item.transform = trans
    item.view = view
    item.isTop = isTop
    if item.isTop then
        item.index = index
    end
    item:Awake()
    return item
end

---@class ChooseMetalView : Component	中文描述
local ChooseMetalView = _G.BaseClass("ChooseMetalView", _G.UIBaseView)

function ChooseMetalView:Awake()
    _G.AddViewBtnClick(self.gameObject, _G.handler(self, self.OnClickBtn))
end
---创建对象时,入口构造函数
function ChooseMetalView:OnCreate(data, changeCallBack)
    data = data == nil and {} or data
    self.data = _G.DeepCopy(data)
    self.medal = _G.DeepCopy(data)
    self.metalCfg = _G.ConfigManager.player_medal_cfg
    self.metalCfgCount = _G.table.count(self.metalCfg)
    self.callBack = changeCallBack
    self.Metals = {}
    self.TopMetals = {}
    self:InitTopChooseMetalView()
    self.go_table.aorlooplist_Mettal:StartUpdataDragInfo(self.metalCfgCount, _G.handler(self, self.InitAorloopList))
end

function ChooseMetalView:Dispose()
    for i = 1, #self.Metals do
        self.Metals[i]:Dispose()
    end
    for i = 1, #self.TopMetals do
        self.TopMetals[i]:Dispose()
    end
    self.go_table = nil
end

---初始化顶部的奖章列表
function ChooseMetalView:InitTopChooseMetalView()
    for i = 1, 5 do
        if self.TopMetals[i] == nil then
            self.TopMetals[i] = MetalItem.CreatItem(self.go_table["obj_metal" .. i], self, true, i)
        end

        if self.data and self.data[i] ~= 0 then
            self.TopMetals[i]:Init(self.metalCfg[self.data[i]])
        else
            self.TopMetals[i]:Init(nil)
        end
    end
end
---初始化底部奖章列表
function ChooseMetalView:InitAorloopList(trans, index)
    local tblIndex = index + 1
    if not self.Metals[tblIndex] then
        self.Metals[tblIndex] = MetalItem.CreatItem(trans, self, false)
    end
    if tblIndex <= self.metalCfgCount then
        self.Metals[tblIndex]:Init(self.metalCfg[100 + tblIndex])
    else
        self.Metals[tblIndex]:Init(nil)
    end
end
--更换头像
function ChooseMetalView:ChangeMetal(data, callBack)
    for i = 1, #self.TopMetals do
        if self.TopMetals[i].data == nil then
            self.data[i] = data.ID
            self.TopMetals[i]:Init(data)
            self.TopMetals[i]:ShowEffect()
            callBack(i)
            break
        end
    end
end
function ChooseMetalView:UpdateData(data)
    data = data == nil and {} or data
    self.data = _G.DeepCopy(data)
    self.medal = _G.DeepCopy(data)
    self:InitTopChooseMetalView()
    self:RefreshAllMetals()
end
---移除顶部头像
function ChooseMetalView:CancelMetal(index)
    self.data[index] = 0
    self.TopMetals[index]:Init(nil)
    self:RefreshAllMetals()
end

---销毁对象时,析构函数
function ChooseMetalView:OnDestroy()
end

function ChooseMetalView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_close" then
        if not _G.table.isEmptyOrNil(self.data) then
            self.callBack(self.data)
        end
        self:Close()
    elseif name == "@_aorbtn_enter" then
        self.callBack(self.data)
        self:Close()
    end
end

---检测是否有改动
function ChooseMetalView:CheckIsChange()
    if #self.medal ~= #self.data then
        return true
    end
    for i = 1, #self.medal do
        if self.medal[i] ~= self.data[i] then
            return true
        end
    end
    return false
end

function ChooseMetalView:RefreshAllMetals()
    self.go_table.aorlooplist_Mettal:RefreshAllShowItem()
end

function ChooseMetalView:CheckIsTop(id)
    if self.data then
        for i = 1, #self.data do
            if self.data[i] ~= 0 and self.data[i] == id then
                return true, i
            end
        end
    end

    return false
end

return ChooseMetalView
