end

---请求  获取玩家个人信息
---@param pbData table PB数据
---@param callback function 完成回调
function SystemSettingNet:GetPlayerInfo(pbData, callback)
    local item = _G.ConfigManager.net_map.game_role_info
    local port = base.Access(self, item, pbData, _G.handler(self, self.GetSuccess))
    self.Call[port] = callback
end
