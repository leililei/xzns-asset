---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function SystemSettingNet:GetSuccess(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---显示错误消息ack的tips
function SystemSettingNet:ShowErrorAckTips(ack)
    if ack == 59 or ack == 135 then
        self.tip14 = false
        return
    elseif ack == 23 and self.tip14 then
        _G.PopWindowManager:GetInstance():ShowAllTips(908)
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(ack)
    end
    self.tip14 = false
end

---@type SystemSettingNet
return SystemSettingNet
