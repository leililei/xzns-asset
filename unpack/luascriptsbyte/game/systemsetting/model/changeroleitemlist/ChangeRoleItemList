---图片变灰
function ChangeRoleItem:ChangeGray()
    -- self.changeGrayList = {[3] = {}}
    -- self.changeGrayList[3] = self.go_table.aorimage_portrait
    -- self.changeGrayList[3]:SetGray(self.roleData.isLock)
    if self.changeGrayList == nil then
        self.changeGrayList = {}
        self.changeGrayList[1] = self.go_table.aorimage_portrait
    end
    for i = 1, #self.changeGrayList do
        self.changeGrayList[i]:SetGray(self.roleData.isLock)
    end
end

---显示或隐藏选中框
function ChangeRoleItem:ChangeChoose()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_choose, self.roleData.isChoose)
end

---显示或隐藏使用
function ChangeRoleItem:ChangeUse()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_use, self.roleData.isUse)
end

function ChangeRoleItem:OnClickBtn()
    if self.clickFunction then
        self.clickFunction(self)
    end
end

function ChangeRoleItem.CreateItem(trans, clickFunction)
    local item = ChangeRoleItem.New()
    item.transform = trans
    item.gameObject = trans
    item.clickFunction = clickFunction
    item:Awake()
    return item
end

---@class ChangeRoleItemList	中文描述
---@field itemList ChangeRoleItem[]
local ChangeRoleItemList = _G.BaseClass("ChangeRoleItemList")
_G.ChangeRoleItemList = ChangeRoleItemList

---类的构造函数
function ChangeRoleItemList:__init()
end

---类的析构函数
function ChangeRoleItemList:Dispose()
    self.itemList = nil
end

---初始化所有物体
function ChangeRoleItemList:InitItemList()
    for i = 1, 4 do
        self.itemList[i] = ChangeRoleItem.CreateItem(self.go_table["obj_item" .. i], self.clickFunction)
    end
end
---@param data ChangeRoleData[] 所有寄灵人数据
---@param index number 当前下标
function ChangeRoleItemList:UpdateData(data, index)
    if self.itemList == nil then
        self.itemList = {}
        self:InitItemList()
    end

    for i = 1, 4 do
        self.itemList[i]:Init(data[(index - 1) * 4 + i])
    end
end

function ChangeRoleItemList.Create(trans, clickFunction)
    local item = ChangeRoleItemList.New()
    item.go_table = _G.GetAutoGoTable(trans)
    item.clickFunction = clickFunction

    return item
end

return ChangeRoleItemList
