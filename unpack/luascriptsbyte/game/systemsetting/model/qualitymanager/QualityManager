---@class QualityManager : Singleton
---@field public GetInstance fun():QualityManager
local QualityManager = _G.BaseClass("QualityManager", _G.Singleton)

function QualityManager:__init()
    ---@class GameQualityType
    ---@field public Hd number
    ---@field public High number
    ---@field public Mid number
    ---@field public Normal number
    self.GameQualityType = {
        Hd = 0,
        High = 1,
        Mid = 2,
        Normal = 3
    }
    self.gameQuality = 0
    self.GameQualityHD = 4800
    self.GameQualityHigh = 4000
    self.GameQualityNormal = 2620
    self.sdkInit = false
end

---获取游戏当前的品质 调用这个方法保证SdkSetQuality 已经出发了
---@return number
function QualityManager:GetGameDefaultQuality()
    self.gameQuality = self.GameQualityType.Mid
    return self.gameQuality
end
---SdkSetQuality
---@param DeviceScore number
function QualityManager:SdkSetQuality(DeviceScore)
    --如果是模拟器就默认最高的画质
    self.sdkInit = true
    self.gameQuality = self.GameQualityType.Mid
    return
end
function QualityManager:Dispose()
    self.GameQualityType = nil
    self.sdkInit = false
end
---@return QualityManager
return QualityManager
