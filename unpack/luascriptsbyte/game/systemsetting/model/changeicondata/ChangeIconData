---@class ChangeIconData
---@field isLock boolean 是否解锁
---@field isChoose boolean 是否被选中
---@field sid number
---@field isUse boolean 是否使用中
---@field cfg player_portrait_cfg|player_frame_cfg_Item
---@field type itemType Portrait，Frame
local ChangeIconData = _G.BaseClass("ChangeIconItem")

local itemType = {
    Portrait = 101,
    Frame = 102,
    Role = 103,
    Title = 104
}

function ChangeIconData:__init()
    self.isLock = true
    self.isChoose = false
    self.sid = nil
    self.cfg = nil
    self.isUse = false
end
---数据初始化
---@param cfg player_portrait_cfg_Item|player_frame_cfg_Item
---@param type itemType
function ChangeIconData:Init(cfg, type)
    self.sid = cfg.ID
    self.cfg = cfg
    self.isChoose = false
    self.type = type
    self.isLock = self:GetIsLock()
end

function ChangeIconData:GetIsLock()
    if self.type == itemType.Frame then
        if _G.PlayerModel:GetInstance():IsUnlockFrame(self.sid) then
            return false
        end
    elseif self.type == itemType.Portrait then
        if self.cfg.unlock_type == 1 then
            local data = self.cfg
            local contain = require "IllustrationModel":GetInstance():HunjiangJieSuo(data.unlock_params[1])
            if contain then
                local star = require "IllustrationModel":GetInstance():GetCardMaxStar(data.unlock_params[1])
                if star >= data.unlock_params[2] then
                    return false
                end
            end
        elseif self.cfg.unlock_type == 2 then
            return not require "CardCommentManager":GetInstance():CradSid(
                    self.cfg.unlock_params[1],
                    self.cfg.unlock_params[2]
            )
        elseif self.cfg.unlock_type == 3 then
            return not PlayerModel:GetInstance():GetIsHasHeadShot(self.cfg.ID)
        else
            return true
        end
    elseif self.type == itemType.Role then
        return not require "IllustrationModel":GetInstance():HunjiangJieSuo(self.cfg.sid)
    end
    return true
end

---获取头像路径
---@return string
function ChangeIconData:GetIconPath()
    if self.type == itemType.Frame then
        return self.cfg.frame, self.cfg.type_title, self.cfg.icon
    elseif self.type == itemType.Portrait then
        return self.cfg.portrait1, self.cfg.type_portrait, self.cfg.effect_portrait
    else
        return self.cfg.portrait1, self.cfg.type_title
    end
end

function ChangeIconData:Dispose()
    self.isLock = nil
    self.isChoose = nil
    self.sid = nil
    self.cfg = nil
    self.isUse = nil
end

return ChangeIconData
