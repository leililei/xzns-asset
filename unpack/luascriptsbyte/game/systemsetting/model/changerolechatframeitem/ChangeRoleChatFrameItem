---@class ChangeRoleChatFrameItem	中文描述
---@field go_table ChangeRoleView._obj_TitleItem_GoTable
---@field data SettingHaloData
local ChangeRoleChatFrameItem = _G.BaseClass("ChangeRoleChatFrameItem")

---类的构造函数
function ChangeRoleChatFrameItem:__init(trans, callback)
    self.transform = trans
    self.gameObject = trans
    self.callback = callback
    self.go_table = _G.GetAutoGoTable(trans, _G.handler(self, self.OnClickBtn))
    self.bg = self.go_table.aorbtn_click:GetComponentE(_G.typeof(_G.CS.AorImage))
end

---类的析构函数
function ChangeRoleChatFrameItem:Dispose()
end

---@param data SettingHaloData
---@param typeEnum number 2 = 称号 1 = 光环
function ChangeRoleChatFrameItem:Show(data, isUse, isChoose)
    self.data = data
    self.go_table.aorrawimage_icon:LoadImage(
        data.icon,
        function()
            self.go_table.aorrawimage_icon:SetNativeSize()
        end
    )
    self.go_table.aorrawimage_icon:SetGray(data.state == 0)
    self.go_table.aorimage_use:SetActiveE(isUse and 1 or 0)
    self.go_table.obj_choose:SetActiveE(isChoose and 1 or 0)
    self.bg:SetGray(data.state == 0)
    self.go_table.aortext_name.text = data.name
    self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(
        _G.ConfigManager.redpoint_cfg.PlayerChatFrame.id,
        self.data.sid
    )
    if data.cfg.time_duration == 0 or data.state == 0 then
        self.go_table.aortext_timeremain:SetActiveE(0)
    else
        self.go_table.aortext_timeremain:SetActiveE(1)
        local endTime = _G.PlayerModel:GetInstance():GetChatFrameData(data.sid).end_time - _G.TimeUtil.GetServerUnixTime()
        if endTime < 0 then
            endTime = 0
        end
        local date = _G.TimeUtil.TranslateSecond(endTime)
        if date.day == 0 then
            if date.hour == 0 then
                self.go_table.aortext_timeremain.text = date.min .. _G.GetLangPackValue(90022500434)
                if date.min == 0 then
                    self.go_table.aortext_timeremain.text = "1" .. _G.GetLangPackValue(90022500434)
                end
            else
                self.go_table.aortext_timeremain.text = date.hour .. _G.GetLangPackValue(90022500435)
            end
        else
            self.go_table.aortext_timeremain.text = _G.GetLangPackValue(90022010703, date.day)
        end
    end
end

function ChangeRoleChatFrameItem:SetChoose(isChoose)
    self.isChoose = isChoose
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_choose, isChoose)
end

function ChangeRoleChatFrameItem:ChangeUse(isUse)
    _G.GameUtil.SetActiveByCondition(self.go_table.aortext_use, isUse)
end

function ChangeRoleChatFrameItem:OnClickBtn()
    self:SetChoose(true)
    if self.callback then
        self.callback(self)
    end
end

return ChangeRoleChatFrameItem
