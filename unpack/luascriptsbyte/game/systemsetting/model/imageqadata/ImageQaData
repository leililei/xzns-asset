---@class ImageQaData
---@field key string key值
---@field value boolean 画质数值
---@field options table<string,number>
---@field type string 数值类型
local ImageQaData = _G.BaseClass("ImageData")

---解析
---@field key SettingType
---@param data table<string,boolean|number>
function ImageQaData:Parse(key, value, options)
    self.key = key
    self.type = _G.type(options[1].value)
    self.value = value
    self.options = options
    self.name = self:GetOpsitionName(self.value)
end

function ImageQaData:SetValue(value)
    self.value = value
    self.name = self:GetOpsitionName(self.value)
end

function ImageQaData:GetOpsitionName(value)
    local str = ""
    local count = #self.options

    for i = 1, count do
        for _, v in pairs(self.options[i].value) do
            if v == value then
                str = self.options[i].name
                break
            end
        end
        if not string.IsNullOrEmpty(str) then
            break
        end
    end
    if type(str) == "number" then
        return _G.LangUtil.GetLangPackValue(str)
    end
    return str
end

function ImageQaData:GetCurValueName()
    return self.name
end

---@return ImageQaData
return ImageQaData
