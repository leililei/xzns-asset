---@class ChangeRoleTitleItem	中文描述
---@field go_table ChangeRoleView._obj_TitleItem_GoTable
---@field data SettingHaloData
local ChangeRoleTitleItem = _G.BaseClass("ChangeRoleTitleItem")
local type = {
    [1] = 1, --光环
    [2] = 2 --称号
}
local GetLangPackValue = _G.GetLangPackValue
---类的构造函数
function ChangeRoleTitleItem:__init(trans, callback)
    self.transform = trans
    self.gameObject = trans
    self.callback = callback
    self.go_table = _G.GetAutoGoTable(trans, _G.handler(self, self.OnClickBtn))
    self.bg = self.go_table.aorbtn_click:GetComponentE(_G.typeof(_G.CS.AorImage))
end

---类的析构函数
function ChangeRoleTitleItem:Dispose()
end

---@param data SettingHaloData
---@param typeEnum number 2 = 称号 1 = 光环
function ChangeRoleTitleItem:Show(data, isUse, isChoose, typeEnum)
    self.data = data
    self.go_table.aorrawimage_icon:LoadImage(
        data.icon,
        function()
            self.go_table.aorrawimage_icon:SetNativeSize()
        end
    )
    self.go_table.aorrawimage_icon:SetGray(data.state == 0)
    -- _G.GameUtil.SetActiveByCondition(self.go_table.obj_lock, data.state == 0)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_use, isUse)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_choose, isChoose)
    self.go_table.obj_head:SetActiveE(0)
--[[    local userSid = _G.PlayerModel:GetInstance():GetEffectUser(typeEnum, self.data.sid)
    self.go_table.obj_head:SetActiveE(userSid > 0 and 1 or 0)
    if userSid > 0 then
        self.go_table.aorimage_portrait.SpriteName = _G.ConfigManager.card_cfg[userSid].Icon
    end]]
    self.bg:SetGray(data.state == 0)
    if data.state == 0 then
        self.go_table.aortext_name.text = data.name
        --self.go_table.aortext_content.text = _G.string.AddColor(data.desc, "4c4c4c")
    else
        self.go_table.aortext_name.text = data.name
        --self.go_table.aortext_name.text = _G.string.AddColor(data.name, "A2A9DA")
        self.go_table.aortext_content.text = data.desc
    end
    --设置（称号或者光环红点） 2称号，1光环
    if type[typeEnum] == 2 then
        --self.go_table.aortext_timeremain.text=data.time
        self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(
            _G.ConfigManager.redpoint_cfg.PlayerTitle.id,
            self.data.sid
        )
        --右上角时间显示，称号时间显示
        if data.state == 1 then
            local id = data.sid
            local titleEndTime = _G.PlayerModel:GetInstance():GetTitleData(id).end_time
            local isforever = _G.ConfigManager.player_title_effect_cfg[id].time_duration
            if isforever ~= 0 then
                self.go_table.aortext_timeremain:SetActiveE(1)

                local lasttime = titleEndTime - _G.TimeUtil.GetServerUnixTime()
                local showtimeday = _G.TimeUtil.TranslateSecond(lasttime).day
                local showtimehour = _G.TimeUtil.TranslateSecond(lasttime).hour
                local showtimemin = _G.TimeUtil.TranslateSecond(lasttime).min
                if showtimeday == 0 then
                    if showtimehour == 0 then
                        self.go_table.aortext_timeremain.text = showtimemin .. GetLangPackValue(90022500434)
                        if showtimemin == 0 then
                            self.go_table.aortext_timeremain.text = "1" .. GetLangPackValue(90022500434)
                        end
                    else
                        self.go_table.aortext_timeremain.text = showtimehour .. GetLangPackValue(90022500435)
                    end
                else
                    --"天"
                    self.go_table.aortext_timeremain.text = GetLangPackValue(90022010703, showtimeday)
                end
            else
                self.go_table.aortext_timeremain:SetActiveE(0)
            end
        else
            self.go_table.aortext_timeremain:SetActiveE(0)
        end
    else
        self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(
            _G.ConfigManager.redpoint_cfg.PlayerHalo.id,
            self.data.sid
        )
        --正上方时间显示,光环时间显示
        if data.state == 1 then
            local id = data.sid
            local haloEndTime = _G.PlayerModel:GetInstance():GetHaloData(id).end_time
            local isforever = _G.ConfigManager.player_halo_effect_cfg[id].time_duration
            if isforever ~= 0 then
                self.go_table.aortext_timeremain:SetActiveE(1)

                local lasttime = haloEndTime - _G.TimeUtil.GetServerUnixTime()
                local showtimeday = _G.TimeUtil.TranslateSecond(lasttime).day
                local showtimehour = _G.TimeUtil.TranslateSecond(lasttime).hour
                local showtimemin = _G.TimeUtil.TranslateSecond(lasttime).min
                if showtimeday == 0 then
                    if showtimehour == 0 then
                        self.go_table.aortext_timeremain.text = showtimemin .. GetLangPackValue(90022500434)
                        if showtimemin == 0 then
                            self.go_table.aortext_timeremain.text = "1" .. GetLangPackValue(90022500434)
                        end
                    else
                        self.go_table.aortext_timeremain.text = showtimehour .. GetLangPackValue(90022500435)
                    end
                else
                    self.go_table.aortext_timeremain.text = GetLangPackValue(90022010703, showtimeday)
                end
            else
                self.go_table.aortext_timeremain:SetActiveE(0)
            end
        else
            self.go_table.aortext_timeremain:SetActiveE(0)
        end
    end
end

function ChangeRoleTitleItem:SetChoose(isChoose)
    self.isChoose = isChoose
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_choose, isChoose)
end

function ChangeRoleTitleItem:ChangeUse(isUse)
    _G.GameUtil.SetActiveByCondition(self.go_table.aortext_use, isUse)
end

function ChangeRoleTitleItem:OnClickBtn()
    self:SetChoose(true)
    if self.callback then
        self.callback(self)
    end
end

return ChangeRoleTitleItem
