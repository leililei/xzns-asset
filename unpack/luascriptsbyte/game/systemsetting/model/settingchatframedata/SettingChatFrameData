---@class SettingChatFrameData	中文描述
---@field sid number
---@field state number 0 上锁 1未上锁
---@field icon string
---@field desc string
---@field name string
---@field cfg player_title_effect_cfg
local SettingChatFrameData = _G.BaseClass("SettingChatFrameData")

---类的构造函数
---@param cfg player_title_effect_cfg
function SettingChatFrameData:__init(cfg)
    self:Parse(cfg)
end

---类的析构函数
function SettingChatFrameData:Dispose()
    self.sid = nil
    self.state = nil
    self.cfg = nil
    self.icon = nil
    self.desc = nil
    self.name = nil
    self.end_time = nil
end

---@param cfg player_bubble_cfg
function SettingChatFrameData:Parse(cfg)
    self.sid = cfg.id
    self.cfg = cfg
    self.state = self:CheckState()
    self.icon = self.cfg.icon
    self.desc = _G.GetLangPackValue(self.cfg.desc)
    self.name = _G.GetLangPackValue(self.cfg.name)
end

---检测状态
function SettingChatFrameData:CheckState()
    if _G.PlayerModel:GetInstance():IsUnlockChatFrame(self.sid) then
        return 1
    end
    return 0
end

function SettingChatFrameData:GetLockTips()
    if self.state == 0 then
        ---@type item_cfg
        if self.cfg.unlock_prompt ~= nil then
            return _G.GetLangPackValue(self.cfg.unlock_prompt)
        else
            local cfg = _G.ConfigManager.item_cfg[self.cfg.unlock_params[1]]
            return _G.GetLangPackValue(90021300101, _G.GetLangPackValue(cfg.Name))
        end
    end
    return ""
end

return SettingChatFrameData
