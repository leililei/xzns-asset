---@class SettingHaloData	中文描述
---@field sid number
---@field state number 0 上锁 1未上锁
---@field icon string
---@field desc string
---@field name string
---@field cfg player_title_effect_cfg
local SettingHaloData = _G.BaseClass("SettingHaloData")

---类的构造函数
---@param cfg player_title_effect_cfg
function SettingHaloData:__init(cfg)
    self:Parse(cfg)
end

---类的析构函数
function SettingHaloData:Dispose()
    self.sid = nil
    self.state = nil
    self.cfg = nil
    self.icon = nil
    self.desc = nil
    self.name = nil
    self.end_time = nil
end

---@param cfg player_title_effect_cfg
function SettingHaloData:Parse(cfg)
    self.sid = cfg.id
    self.cfg = cfg
    self.state = self:CheckState()
    self.icon = self.cfg.icon
    self.resPath = self.cfg.title or self.cfg.halo
    self.type = cfg.type_title or cfg.type_halo
    self.desc = _G.LangUtil.GetLangPackValue(self.cfg.desc)
    self.name = _G.LangUtil.GetLangPackValue(self.cfg.name)
    if cfg.time_duration > 0 then
        ---@type role.i_effect
        local data
        if cfg.type_title then
            data = _G.PlayerModel:GetInstance():GetTitleData(self.sid)
        else
            data = _G.PlayerModel:GetInstance():GetHaloData(self.sid)
        end

        if data then
            if data then
                self.end_time = data.end_time
            end
        end
    end
end

---检测状态
function SettingHaloData:CheckState()
    if self.cfg.type_title then
        if _G.PlayerModel:GetInstance():IsUnlockTitle(self.sid) then
            --   or  _G.StorageManager:GetInstance():CheckItem(self.cfg.unlock_params[1], self.cfg.unlock_params[2])
            return 1
        end
    end
    if self.cfg.type_halo then
        if _G.PlayerModel:GetInstance():IsUnlockHalo(self.sid) then
            -- or _G.StorageManager:GetInstance():CheckItem(self.cfg.unlock_params[1], self.cfg.unlock_params[2])
            return 1
        end
    end
    return 0
end

function SettingHaloData:GetLockTips()
    if self.state == 0 then
        ---@type item_cfg
        if self.cfg.unlock_prompt ~= nil then
            return _G.LangUtil.GetLangPackValue(self.cfg.unlock_prompt)
        else
            --_G.LangUtil.GetLangPackValue(90021300101, _G.LangUtil.GetLangPackValue(self.cfg.name))
            local cfg = _G.ConfigManager.item_cfg[self.cfg.unlock_params[1]]
            return _G.LangUtil.GetLangPackValue(90021300101, _G.LangUtil.GetLangPackValue(cfg.Name))
        end
    end
    return ""
end

return SettingHaloData
