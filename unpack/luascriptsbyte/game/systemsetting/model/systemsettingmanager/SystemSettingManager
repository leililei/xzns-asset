---获取称号和光环数据
function SystemSettingManager:GetTitleAndHaloData()
    local channelId = tonumber(_G.SDKManager:GetInstance():GetChannelId()) or -1

    local tb = { title = {}, Halo = {} }
    for _, v in pairs(_G.ConfigManager.player_title_effect_cfg) do
        if not v.reveal and (
            _G.table.isEmptyOrNil(v.channel_id) or
                _G.table.ContainsValue(v.channel_id, channelId) or
                _G.PlayerModel:GetInstance():IsUnlockTitle(v.ID) or GlobalConditionManager.CheckConditionByArray(v.condition_type)) then
            _G.table.insert(tb.title, SettingHaloData.New(v))
        end
    end
    for _, v in pairs(_G.ConfigManager.player_halo_effect_cfg) do
        if not v.reveal and (
            _G.table.isEmptyOrNil(v.channel_id) or
                _G.table.ContainsValue(v.channel_id, channelId) or
                _G.PlayerModel:GetInstance():IsUnlockHalo(v.ID)) then
            _G.table.insert(tb.Halo, SettingHaloData.New(v))
        end
    end
    _G.table.sort(
        tb.title,
        function(a, b)
            if (a.state == 1 and b.state == 1) or (a.state == 0 and b.state == 0) then
                if a.cfg.display_priority == b.cfg.display_priority then
                    return a.cfg.id < b.cfg.id
                else
                    return a.cfg.display_priority < b.cfg.display_priority
                end
            else
                return a.state > b.state
            end
        end
    )
    _G.table.sort(
        tb.Halo,
        function(a, b)
            if (a.state == 1 and b.state == 1) or (a.state == 0 and b.state == 0) then
                if a.cfg.display_priority == b.cfg.display_priority then
                    return a.cfg.id < b.cfg.id
                else
                    return a.cfg.display_priority < b.cfg.display_priority
                end
            else
                return a.state > b.state
            end
        end
    )
    return tb
end

