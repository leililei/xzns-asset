function SystemSettingManager:GetUnLockIconData()
    local datas = _G.table.toArray(_G.ConfigManager.player_portrait_cfg)
    local count = #datas
    local IllustrationModel = require "IllustrationModel":GetInstance()
    local tb = {}
    local data
    for i = 1, count do
        data = datas[i]
        local constain = IllustrationModel:HunjiangJieSuo(data.unlock_params[1])
        if constain then
            local star = IllustrationModel:GetCardMaxStar(data.unlock_params[1])
            if star >= data.unlock_params[2] then
                _G.table.insert(tb, data)
            end
        end
    end
    return tb
end

