---机器人数据整理
---@param type _G.RobotType 机器人类型
---@param uid number 机器人配置表中的 id
---@field data role.s2c_role_info 机器人数据信息
---@field name string  名字
---@field level number  等级
---@field style number  头像
---@field frame number  头像框
---@field union string  公会
---@field sign string   签名
---@field medal number[]
---@field skin number[]  皮肤
---@field afk number   放置关卡
---@field array role.card_info[] 魂将展示
---@field skill_index number[] 合击技   机器人 数据直接 的传入 合击技配置表中的 具体的值
---@field power number  战力
function SystemSettingManager:RobotInfoData(uid, type, robotdata)
    local cfg
    local data = {}
    if type == _G.RobotType.Arena then
        cfg = _G.ConfigManager.arena_robot_cfg[uid]
        data = self:RobotArenaData(uid, cfg)
    elseif type == _G.RobotType.ArenaSenior then
        cfg = _G.ConfigManager.arena_senior_robot_cfg[uid]
        data = self:RobotArenaData(uid, cfg)
    elseif type == _G.RobotType.SixVsSix then
        data.name = robotdata.name
        data.level = robotdata.level
        data.style = robotdata.style
        data.frame = robotdata.frame
        data.title = robotdata.title
        data.uid = robotdata.uid
        data.power = robotdata.power
        data.model_path = data.model_path
        local name = data.name
        local isNum = tonumber(name)
        data.name = isNum and GetLangPackValue(isNum) or name
    else
        data = robotdata
    end
    return data
end

