function SystemSettingManager:InitImageOtherSet()
    ---画质设置
    if not self:HasKey(self.SettingType.ImageQuality) then
        local level = qualityManager:GetInstance():GetGameDefaultQuality()
        GraphicsQualityManager:SetTemplateLevel(level)
        self:SaveState(self.SettingType.ImageQuality, level)
        ---暂时处理 初始画质时
        ---更新屏幕高宽
        --屏幕宽
        _G.AppSetting.SCREEN_WIDTH = _G.CS.UnityEngine.Screen.width
        --屏幕高
        _G.AppSetting.SCREEN_HEIGHT = _G.CS.UnityEngine.Screen.height
    else
        local index = self:GetState(self.SettingType.ImageQuality)
        self:SetTemplateLevel(index)
    end
    ---Fps设置
    if not self:HasKey(self.SettingType.FPS) then
        local index = 2
        self:SetFPSLevel(index)
        self:SaveState(self.SettingType.FPS, index)
    else
        local index = self:GetState(self.SettingType.FPS)
        self:SetFPSLevel(index)
    end
end

