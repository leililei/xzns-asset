---获取玩家信息
---@param uid number 玩家的uid
---@param sortingOrder number 层级调整 （千机排行，点击调整层级）
---@param type number 类型（用作判定，假数据读取的配置表）
function SystemSettingManager:OpenView(uid, sortingOrder, call, friend)
    self.curUid = uid
    self.isCurPlayer = uid == _G.PlayerModel:GetInstance():GetPlayerUid()
    local msg = {}
    msg.uid = uid
    SystemSettingNet:GetInstance():GetPlayerInfo(
        msg,
        _G.handlerbind(
            self,
            self.GetPlayerInfoSuccess,
            function(data)
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.PlayerInfoView.Name,
                    data,
                    self.isCurPlayer,
                    uid,
                    friend
                )
                if call then
                    call()
                end
            end
        )
    )
end

