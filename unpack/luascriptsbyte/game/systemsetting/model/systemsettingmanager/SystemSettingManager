---检测问题反馈的红点
function SystemSettingManager:Get()
    if not self.getUrl then
        self.getUrl = _G.string.format(
            "https://zhjhkwork.youkia.net/prod-api/player/unreadByUser?userId=%s",
            _G.PlayerModel:GetInstance():GetPlayerUid()
        )
        self.CommonWebRequestManagerIns = require "CommonWebRequestManager":GetInstance()
    end
    self.CommonWebRequestManagerIns:Get(
        self.getUrl,
        "Authorization",
        function(data)
            local tb = _G.Json2Table(data)
            self.redPointGD = tb.data
            require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.Feedback.id)
        end
    )
end
