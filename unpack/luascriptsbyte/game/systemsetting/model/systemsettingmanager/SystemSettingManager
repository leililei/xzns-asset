---刷新属性
function SystemSettingManager:RefreshTitleAndHaloAttribute()
    self.Attribute = _G.AttributeClassManager:GetInstance():GetAttribtueClass()
    local attributeManager = _G.AttributeClassManager:GetInstance()
    local datas = _G.PlayerModel:GetInstance().titleDic
    local cfgs = _G.ConfigManager.player_title_effect_cfg
    local cfg
    if datas then
        for _, v in pairs(datas) do
            cfg = cfgs[v.sid]
            if cfg then
                for _, v in pairs(cfg.base_att) do
                    self.Attribute:AddValueByName(
                        v[1],
                        attributeManager:GetValueWithName(v[1], v[3], _G.tonumber(v[2])),
                        false,
                        _G.tonumber(v[2])
                    )
                end
            end
        end
    end

    datas = _G.PlayerModel:GetInstance().haloDic
    cfgs = _G.ConfigManager.player_halo_effect_cfg
    if datas then
        for _, v in pairs(datas) do
            cfg = cfgs[v.sid]
            if cfg then
                for _, v in pairs(cfg.base_att) do
                    self.Attribute:AddValueByName(
                        v[1],
                        attributeManager:GetValueWithName(v[1], v[3], _G.tonumber(v[2])),
                        false,
                        _G.tonumber(v[2])
                    )
                end
            end
        end
    end
    self.Attribute:AttributeToOther()
    self.AttributeChangeType = attributeManager:GetChangeAttrTypes(self.Attribute)
end

---获取称号属性
---@param id number 称号id
---@return AttributeClass
function SystemSettingManager:GetTitleAttribute(id)
    local Attribute = _G.AttributeClassManager:GetInstance():GetAttribtueClass()
    local attributeManager = _G.AttributeClassManager:GetInstance()
    ---@type player_title_effect_cfg
    local cfg = _G.ConfigManager.player_title_effect_cfg[id]
    if cfg then
        for _, v in pairs(cfg.base_att) do
            Attribute:AddValueByName(
                v[1],
                attributeManager:GetValueWithName(v[1], v[3], _G.tonumber(v[2])),
                false,
                _G.tonumber(v[2]) and _G.AttCountType.other or _G.AttCountType.basePercent
            )
        end
    end
    return Attribute
end

---获取光环属性
---@param id number 光环id
---@return AttributeClass
function SystemSettingManager:GetHaloAttribute(id)
    local Attribute = _G.AttributeClassManager:GetInstance():GetAttribtueClass()
    local attributeManager = _G.AttributeClassManager:GetInstance()
    ---@type player_halo_effect_cfg
    local cfg = _G.ConfigManager.player_halo_effect_cfg[id]
    if cfg then
        for _, v in pairs(cfg.base_att) do
            Attribute:AddValueByName(
                v[1],
                attributeManager:GetValueWithName(v[1], v[3], _G.tonumber(v[2])),
                false,
                _G.tonumber(v[2]) == 1 and _G.AttCountType.other or _G.AttCountType.basePercent
            )
        end
    end
    return Attribute
end

---获取头像
---@return string ,player_title_effect_cfg
function SystemSettingManager.GetTitleIcon(title)
    if _G.table.isEmptyOrNil(title) or title.sid <= 0 then
        return nil, nil
    end
    local cfg = _G.ConfigManager.player_title_effect_cfg[title.sid]

    if cfg then
        if cfg.time_duration > 0 then
            local time = _G.TimeUtil.GetServerUnixTime()
            if title.end_time > time then
                return cfg.title, cfg.type_title
            end
        else
            return cfg.title, cfg.type_title
        end
    end
    return nil, nil
end

---获取光环
---@return player_halo_effect_cfg
function SystemSettingManager.GetHaloCfg(halo)
    if _G.table.isEmptyOrNil(halo) or halo.sid <= 0 then
        return nil, nil
    end
    local cfg = _G.ConfigManager.player_halo_effect_cfg[halo.sid]

    if cfg then
        if cfg.time_duration > 0 then
            local time = _G.TimeUtil.GetServerUnixTime()
            if halo.end_time > time then
                return cfg
            end
        end
    end
    return nil, nil
end

