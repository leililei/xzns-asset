    local pbData = {activity_id = self.curActivityClass:GetActivityID(), task_sid = {sid}, finish_type = 1}
    require("GMBigChallengeNet"):GetInstance():FinishTask(pbData, function(msg)
        if msg.ack == 1 then
            -- for k, v in ipairs(pbData.task_sids) do 
            --     _G.table.insert(self.finish_task, v.sid)
            --     local task = self:GetTaskByTaskid(v.sid)
            --     if task then 
            --         task.i_task.state = _G.TaskEnum.ETaskState.Completed
            --     end
            --     self.cardDataT[sid].taskLv = self.cardDataT[sid].taskLv + 1
            -- end
            _G.Events:GetInstance():Broadcast(_G.eGMBigChallenge.UpdateView)
            self:AfkPassUpdate()
            if callback then
                callback(msg)
            else 
