local base = require("ActivitySynTypeBase")

---@class GMBigChallengeSynModel : ActivitySynTypeBase	中文描述
local GMBigChallengeSynModel = _G.BaseClass("GMBigChallengeSynModel", base)

---类的构造函数
function GMBigChallengeSynModel:__init()
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.AddMainFunQueue, self)
end

function GMBigChallengeSynModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.AddMainFunQueue, self)
    base.Dispose(self)
end

function GMBigChallengeSynModel:OnHandleGMData(data)
    self:SetSelfInfo(data.challenge_award)
    base.ParseData(self)
end

function GMBigChallengeSynModel:SetSelfInfo(data)
    self.award_cfg = data.award_cfg or {}
    self.award_list = data.award_list or {}
    self.free_award_cfg = data.free_award_cfg
    self.free_award = data.free_award
    self.target_cfg = data.target_cfg
    self.afk_num = data.afk_num
    self.award_num = data.award_num
    self.exchange_cfg = data.exchange_cfg
    self.exchange_list = data.exchange_list or {}
    ---@type activity_afk_award.i_activity_afk_award
    self.data = data
    _G.SortList(self.award_cfg, function(item)
        return -item.sid
    end)
    self.task = data.task
    self.task_curr = data.task_curr
    self:InitTaskList()
    _G.Events:GetInstance():Broadcast(_G.eGMBigChallenge.UpdateView)
    require "RedPointManager":GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
    require "RedPointManager":GetInstance():RefreshNode(self:GetRedpointIDByIndex(2))
end

function GMBigChallengeSynModel:AddMainFunQueue()
    local MainOpenViewFunItem = {}
    MainOpenViewFunItem.OpenViewFun = function()
        if self.curActivityClass then
            self.curActivityClass:EnterActivity()
        end
    end
    _G.MainManager:GetInstance():AddMainFunQueue(MainOpenViewFunItem, _G.MainViewShowOrder.GMBigChallenge)
end

---接收主题任务推送
---@param taskinfo task.i_task
function GMBigChallengeSynModel:UpdateTask(taskinfo)
    if not self.cfgs[taskinfo.sid] then
        return
    end
    local task = self:GetTaskData(taskinfo.sid)
    if not task then
        return
    end
    task:UpdataData(taskinfo)
end

---获取任务数据
---@param id number 任务id
---@return DrawUpBattlePassTaskData
function GMBigChallengeSynModel:GetTaskData(id)
    local task
    for _, v in pairs(self.taskList) do
        if v.Cfg.id == id then
            task = v
            break
        end
    end
    return task
end

--- 获取界面人物路径
function GMBigChallengeSynModel:GetRolePath()
    if not self.rolePath then
        if not self.curActivityClass.cfg.info.front.precast then
            self.rolePath = ""
        else
            local path = self.curActivityClass.cfg.info.front.precast
            local paths = _G.string.split(path, "#")
            self.rolePath = paths[3] or ""
            local pos = _G.string.split(paths[4], "$")
            self.rolePos = {0, 0, 0}
            if pos[1] then 
                self.rolePos = {_G.tonumber(pos[1]), _G.tonumber(pos[2]), _G.tonumber(pos[3])}
            end
        end
    end
    return self.rolePath, self.rolePos
end

--- 获取界面美术字路径
function GMBigChallengeSynModel:GetTitlePath()
    if not self.titlePath then
        if not self.curActivityClass.cfg.info.front.precast then
            self.titlePath = ""
        else
            local path = self.curActivityClass.cfg.info.front.precast
            local paths = _G.string.split(path, "#")
            self.titlePath = paths[1] or ""
            local pos = _G.string.split(paths[2], "$")
            self.rolePos = {0, 0, 0}
            if pos[1] then
                self.titlePos = {_G.tonumber(pos[1]), _G.tonumber(pos[2]), _G.tonumber(pos[3])}
            end
        end
    end
    return self.titlePath, self.titlePos
end

---获取配置
function GMBigChallengeSynModel:GetCfg(id)
    return self.cfgs[id]
end

---初始化任务列表
function GMBigChallengeSynModel:InitTaskList()
    if self.taskList then
        for _, v in pairs(self.taskList) do
            v:Dispose()
        end
    end
    self.taskList = {}
    self.cfgs = {}
    if self.task then
        for _, v in pairs(self.task) do
            self.cfgs[v.sid] = self:SwapCfg(v)
        end
    end
    if self.task_curr then
        for _, v in pairs(self.task_curr) do
            v.activity = self
            _G.table.insert(
                self.taskList,
                require("GMBigChallengeTaskData").New(
                    v,
                    function()
                        self:FinishTask(v.sid)
                    end
                )
            )
        end
