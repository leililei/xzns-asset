---配置转换
---@param data activity_task.i_task_activity
function GMBigChallengeSynModel:SwapCfg(data)
    local cfg = {}
    cfg.id = data.sid
    if _G.tonumber(data.name) then
        cfg.name = _G.LangUtil.GetLangPackValue(_G.tonumber(data.name))
    else
        cfg.name = data.name
    end
    if _G.tonumber(data.desc) then
        cfg.desc = _G.LangUtil.GetLangPackValue(_G.tonumber(data.desc))
    else
        cfg.desc = data.desc
    end
    cfg.type_calculate = data.type_calculate
    local tb = {}
    for _, v in pairs(data.complete) do
        _G.table.insert(tb, v.con)
    end
    cfg.condition = tb
    cfg.count = data.count
    cfg.link = data.link
    cfg.reward = data.award or {}

    cfg.other_award = data.other_award
    cfg.page = data.page
    cfg.function_open = 0
    return cfg
end

