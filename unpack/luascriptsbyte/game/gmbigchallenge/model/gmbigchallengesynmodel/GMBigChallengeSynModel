function GMBigChallengeSynModel:AfkPassUpdate()
    self.award_num = self.award_num + 1
    require "RedPointManager":GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

---进入活动主体
function GMBigChallengeSynModel:OnEnterActivity()
    local main_type = self.curActivityClass.cfg.info.front.main_type
    if main_type == 2 or main_type == 3 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GMBigChallenge2View.Name, self)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GMBigChallengeView.Name, self)
    end
end

function GMBigChallengeSynModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.GMBigChallengeView.Name
end

function GMBigChallengeSynModel:IsShowBtn()
    return true
end

---初始化红点树
function GMBigChallengeSynModel:InitRedPointTree()
    self.checkRedPointFunc = { self.CheckRedPoint , self.CheckRedPointWeekFreeGift}
    self.redpointTree = { false, false }
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function GMBigChallengeSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---检查红点
function GMBigChallengeSynModel:CheckRedPoint()
    if self:CheckRedPointWeekFreeGift() == 1 then
        return 1
    end
    if self:GetIsCanGetReward() == 1 then
        return 1
    end
    return 0
end

--可领取红点
function GMBigChallengeSynModel:GetIsCanGetReward()
    for i = 1, #self.award_cfg do
        if not self:CheckIsGet(self.award_cfg[i].sid) and i <= self.award_num then
            return 1
        end
    end
    return 0
end

--免费礼包
function GMBigChallengeSynModel:CheckRedPointWeekFreeGift()
    if self.data.free_award == true or (self.data.free_award_cfg == nil or self.data.free_award_cfg[1] == nil) then
        return 0
    end
    return 1
end

--region 外部接口

function GMBigChallengeSynModel:GetAwardList()
    return self.award_cfg
end

--- 检测是否已经领取
function GMBigChallengeSynModel:CheckIsGet(id)
    return _G.table.ContainsValue(self.award_list, id)
end

---检测是否能够领取
function GMBigChallengeSynModel:CheckCanGet(index)
    if self:CheckIsGet(index) then
        return false
    end
    return self.award_num >= index
end

function GMBigChallengeSynModel:GetAward(callback)
    self:GetActivityAward(
        { 1 },
        function(msg)
            for i = 1, #self.award_cfg do
                if not self:CheckIsGet(self.award_cfg[i].sid) and i <= self.award_num then
                    _G.table.insert(self.award_list, self.award_cfg[i].sid)
                end
            end
            require "RedPointManager":GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
            if callback then
                callback(msg)
            end
        end
    )
end

function GMBigChallengeSynModel:QuickBuy(num, callback)
    self:GetActivityAward(
        { 3, self.exchange_cfg[1].sid, num},
        function(msg)
            if msg.ack == 1 then 
                local bol
                for k, v in pairs(self.exchange_list) do 
                    if v.key == self.exchange_cfg[1].sid then 
                        self.exchange_list[k].value = self.exchange_list[k].value + num
                        bol = true
                    end
                end
                if not bol then 
                    table.insert(self.exchange_list, {key = self.exchange_cfg[1].sid, value = num})
                end
            end
            if callback then
                callback(msg)
            end
        end
    )
end

function GMBigChallengeSynModel:GetNowQuickCanBuyNum()
    local num = 0
    for k, v in pairs(self.exchange_list) do 
        if v.key == self.exchange_cfg[1].sid then 
            num = v.value
        end
    end
    return self.exchange_cfg[1].count - num
end

function GMBigChallengeSynModel:GetFreeReward(callback)
    if self.data.free_award == true then
        return
    end
    self:GetActivityAward(
        { 2 },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self.data.free_award = true
            require "RedPointManager":GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
            require "RedPointManager":GetInstance():RefreshNode(self:GetRedpointIDByIndex(2))
            if callback then
                callback(msg)
            end
        end
    )
end

--endregion

