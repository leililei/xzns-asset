---@class GMBigChallengeTaskData:ActiveTaskBase	中文描述
local GMBigChallengeTaskData = _G.BaseClass("GMBigChallengeTaskData", _G.ActiveTaskBase)

---创建对象时,入口构造函数
---@param task task.i_task
---@param call function 任务完成后执行函数(刷新相关界面等)
function GMBigChallengeTaskData:__init(task, call, MarkTaskType, Params_ActiveTaskBase)
    Params_ActiveTaskBase = Params_ActiveTaskBase or {}

    ---广播该任务枚举 有变动后 用通用检测 (死魂塔 参数复杂 全塔 主塔 五行塔 不好全部广播)
    self.CommonTaskEnum = {
        [_G.ActiveTaskEnum.ConditionEnum.Section.DeadsoulFoor] = true,
        ---等级 要比大小 直接查背包
        [_G.ActiveTaskEnum.ConditionEnum.CardLevel.assignCountAssignLevel] = true,
        ---星级 要比大小 直接查背包
        [_G.ActiveTaskEnum.ConditionEnum.CardLevel.assignCountAssignStar] = true,
        ---指定sid卡牌升到n级(优化 连续升级)
        [_G.ActiveTaskEnum.ConditionEnum.CardLevel.assignSidAssignLevel] = true,
        ---共鸣槽位最低等级达到n级
        [_G.ActiveTaskEnum.ConditionEnum.CardResonance.FivePosLevel] = true,
        ---X个英雄（槽位）达到Y级
        [_G.ActiveTaskEnum.ConditionEnum.CardResonance.PosLevelNum] = true,
        ---界限突破相关
        [_G.ActiveTaskEnum.ConditionEnum.Artifact.LevelNum] = true,
        [_G.ActiveTaskEnum.ConditionEnum.Artifact.StarNum] = true,
        [_G.ActiveTaskEnum.ConditionEnum.Artifact.AwakenNum] = true,
        [_G.ActiveTaskEnum.ConditionEnum.Artifact.SidLevel] = true,
        [_G.ActiveTaskEnum.ConditionEnum.Artifact.SidStar] = true,
        [_G.ActiveTaskEnum.ConditionEnum.Artifact.SidAwaken] = true,
        [_G.ActiveTaskEnum.ConditionEnum.CardTalent.LevelNum] = true,
        [_G.ActiveTaskEnum.ConditionEnum.CardResonance.PosLevelNum] = true,
        ---同时拥有x个y星的彩色品质的饰品
        [_G.ActiveTaskEnum.ConditionEnum.Spiritual.LevelNum] = true,
    }

    ---任务对应 手册id 标记任务完成用
    self.manualId = Params_ActiveTaskBase.manualId or 0
    ---七日目标 任务
    self.dayid = Params_ActiveTaskBase.dayid or 1
    ---标记任务完成  枚举类型
    self.MarkTaskType = MarkTaskType or _G.MarkTaskType.none
    self:Init(task)
    self.call = call
    --self:Clear()
    self:ParseData(task)
    if task.state == _G.TaskEnum.ETaskState.Claimed then
        if self.taskEnumType == _G.ActiveTaskEnum.ConditionEnum.CumulativeLogin.specifiedTime then
            --指定时间段登录 6点起 0- 86400
            local starSecond = task.taskcontentparams[2]
            local notSecond = _G.TimeUtil.GetSecondsOfDayOf6Hour()
            ---如果已错过时间 86400+明天启始时间-今天已过时间
            local nexttime
            if notSecond < 0 then
                nexttime = -notSecond
            else
                nexttime = starSecond - notSecond
            end
            self:AddSpecifiedTime(nexttime)
        elseif self.taskEnumType == _G.ActiveTaskEnum.ConditionEnum.CumulativeLogin.dayAfter then
            --接取任务后几天登录
            local nowSecond = _G.TimeUtil.GetServerUnixTime()
            local starSecond = (self.taskcontentparams[2] - 1) * 86400 + _G.TimeUtil.GetDayBySix(self.getTime)
            local nexttime = starSecond - nowSecond
            self:AddDayAfterTime(nexttime)
        else
            _G.Events:GetInstance():AddListener(_G.ePlayAactionEvent.PlayAaction, self.OnAactionEnent, self)
            if self.taskEnumType == _G.ActiveTaskEnum.ConditionEnum.SecretRealm.SecretRealmLayer then 
                _G.Events:GetInstance():AddListener(_G.eSecretRealm.Refresh, self.SecretRealmInfoUpdateCallBack, self)
            end
        end
    end
end

function GMBigChallengeTaskData:Init(task)
    self.activity = task.activity
end

function GMBigChallengeTaskData:InitCfg()
    self.Cfg = self.activity:GetCfg(self.i_task.sid)
end

function GMBigChallengeTaskData:GetProgress()
    if self.i_task.state == _G.TaskEnum.ETaskState.Completed or self.i_task.state == _G.TaskEnum.ETaskState.Submited then
        return 1
    end
    local v1, v2 = self:GetCount()
    return v1 / v2
end

function GMBigChallengeTaskData:GetCount()
    if self.i_task.state == _G.TaskEnum.ETaskState.Completed or self.i_task.state == _G.TaskEnum.ETaskState.Submited then
        return self.Cfg.count, self.Cfg.count
    end
    if self.taskEnumType == _G.ActiveTaskEnum.ConditionEnum.AFK.IsPass then
        local id = require "AfkModel":GetInstance().LastSid
        local endId = self.taskcontentparams[#self.taskcontentparams]
        local cfg = _G.ConfigManager.afk_cfg[endId]

        if cfg then
            if id >= endId then
                return 1, 0
            else
                local cfg2 = _G.ConfigManager.afk_cfg[id]
                if cfg2 then
                    if not _G.ConfigManager.afk_cfg[id + 1] then
                        return cfg.chapter,cfg2.chapter
                    else
                        return cfg.chapter,cfg2.chapter - 1
                    end
                else
                    return 1, 0
                end
            end
        else
            return 1, 1
        end
    else
        return self.Cfg.count,self.i_task.target[1]
    end
end

function GMBigChallengeTaskData:SecretRealmInfoUpdateCallBack()
    if self.taskEnumType == _G.ActiveTaskEnum.ConditionEnum.SecretRealm.SecretRealmLayer then 
        self:CheckTaskTarget()
    end
end

--- 检测任务状态
function GMBigChallengeTaskData:CheckTaskState()
    if self.i_task == nil then
        return
    end
    --- 防止 抽卡0/5 任务  十连   服务器记录10/5
    if self.i_task.target[1] > self.Cfg.count then
        self.i_task.target[1] = self.Cfg.count
    end

    if self.i_task.state == _G.TaskEnum.ETaskState.Claimed then
        if self.taskEnumType == _G.ActiveTaskEnum.ConditionEnum.AFK.IsPass then
            if self.taskcontentparams[2] > require "AfkModel":GetInstance().LastSid then
                return
            end
        else
            if self.i_task.target[1] >= self.Cfg.count then
            else
                --- 次数没达到 不算完成
                return
            end
        end

        self.i_task.state = _G.TaskEnum.ETaskState.Submited
        _G.Events:GetInstance():RemoveListener(_G.ePlayAactionEvent.PlayAaction, self.OnAactionEnent, self)
        -- local activity = require "ActivitySynManager":GetInstance():GetActivityWithTypeId(10092)
        -- require("RedPointManager"):GetInstance():RefreshNodeByAllParams(activity:GetRedpointIDByIndex(1))
        if self.taskEnumType == _G.ActiveTaskEnum.ConditionEnum.SecretRealm.SecretRealmLayer then 
            _G.Events:GetInstance():RemoveListener(_G.eSecretRealm.Refresh, self.SecretRealmInfoUpdateCallBack, self)
        end
        if self.MarkTaskType == _G.MarkTaskType.none then
            if _G.AppSetting.DEBUG then
                _G.LogError("MarkTaskType  未定义")
            end
        else
            local tData = {}
            tData.dayid = self.dayid
            tData.manualId = self.manualId
            require("TaskManager").MarkTask(self.MarkTaskType, self.i_task.sid, tData, self.i_task)
        end

        if self.call ~= nil then
            _G.TaskModule:GetInstance():SetCompletedTask(self.i_task.sid)
            self.call(self.i_task.sid)
            self.call = nil
        end
    elseif self.i_task.state == _G.TaskEnum.ETaskState.Submited then
        ---如果已标记为完成 就设置进度为完成
        if self.i_task.target[1] == 0 then
            ---只有没进度 才这样 防止 频繁刷新 数据不对
            local value = self.taskcontentparams[#self.taskcontentparams] or 0
            local num = value
            if self.Cfg and self.Cfg.count then
                if num >= self.Cfg.count then
                    num = self.Cfg.count
                end
            end
            self.i_task.target[1] = num
        end
    end
end

function GMBigChallengeTaskData:Clear()
    --- 服务器下发 任务数据
    ---@type task.i_task
    self.i_task = nil

    --- 配置表  mission_cfg[自身]
    self.Cfg = nil

    --- 任务是否解锁
    self.isUnlock = false
    ---移除监听
    _G.Events:GetInstance():RemoveListener(_G.ePlayAactionEvent.PlayAaction, self.OnAactionEnent, self)
    _G.Events:GetInstance():RemoveListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.OnEvent_CheckLock, self)
    if self.taskEnumType == _G.ActiveTaskEnum.ConditionEnum.SecretRealm.SecretRealmLayer then 
        _G.Events:GetInstance():RemoveListener(_G.eSecretRealm.Refresh, self.SecretRealmInfoUpdateCallBack, self)
    end
end


return GMBigChallengeTaskData
