local base = require("BaseGameNet")

---@class GMBigChallengeNet : BaseGameNet    通信协议
local GMBigChallengeNet = _G.BaseClass("GMBigChallengeNet", base)
---@return GMBigChallengeNet GMBigChallengeNet
function GMBigChallengeNet:GetInstance()
    return base.GetInstance(self)
end

---完成任务
function GMBigChallengeNet:FinishTask(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_challenge_award_finish
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function GMBigChallengeNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return GMBigChallengeNet