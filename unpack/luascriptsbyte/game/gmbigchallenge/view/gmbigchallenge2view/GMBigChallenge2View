function GMBigChallenge2View:UpdateView()
    local index = 0
    for k, v in pairs(self.awardCfg) do
        index = index + 1
        local tb = self.AwardTbs[index]
        tb.aortext_dayText.text = _G.GetLangPackValue(90023800006, index)
        local isGet = self.activity:CheckIsGet(v.sid)
        local canGet = self.activity:CheckCanGet(v.sid)

        local trans = self.AwardItems[index]
        if nil ~= trans then
            trans:SetGou(isGet)
            trans:ShowEffect(not isGet)
        end

        tb.obj_effNode:RemoveAllChildren()
        tb.obj_redpoint:SetActiveE(canGet and 1 or 0)
        if isGet then
            tb.obj_isget:SetActiveE(1)
            tb.obj_effNode:SetActiveE(0)
            tb.aorrawimage_Icon:SetGray(true)
        else
            tb.obj_isget:SetActiveE(0)
            tb.aorrawimage_Icon:SetGray(false)
        end
    end

    if self.activity.data.free_award_cfg and self.activity.data.free_award_cfg[1] then
        self.isGetFreeReward = self.activity.data.free_award
        self.go_table.aortext_num.text = self.freeRewardCount
        self.go_table.obj_freeRewardNode:SetActiveE(1)
        if self.freeItem then
            self.freeItem:SetGou(self.isGetFreeReward)
            --self.freeItem.go_table.aorrawimage_Icon:SetGray(self.isGetFreeReward)
        end
    else
        self.go_table.obj_freeRewardNode:SetActiveE(0)
    end
    local task = self.activity.taskList[1]

    local task1 = _G.UIUtils.NumberToUnitStr_CardFightNum(task.i_task.target[1])

    local taskcount = _G.UIUtils.NumberToUnitStr_CardFightNum(task.Cfg.count)
    --self.go_table.aortext_jd.text = task.Cfg.desc
    self.go_table.aortext_jd.text = GetLangPackValue(self.main_type == 2 and 33100000311 or 33100000309,task1, taskcount)
    --self.go_table.aortext_jd2.text = string.format("(%s/%s)", task1, taskcount)
    --self.go_table.aortext_finishday.text = _G.GetLangPackValue(33100000304, self.activity.award_num)
    self:FreshQuickBuy()
end

