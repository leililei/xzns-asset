function GMBigChallengeView:UpdateView()
    local index = 0
    for k, v in pairs(self.awardCfg) do
        index = index + 1
        local tb = self.AwardTbs[index]
        tb.aortext_dayText.text = _G.GetLangPackValue(90023800006, index)
        local isGet = self.activity:CheckIsGet(v.sid)
        local canGet = self.activity:CheckCanGet(v.sid)

        local trans = self.AwardItems[index]
        if nil ~= trans then
            self:SetItemBase(trans,isGet,canGet)
        end

        tb.obj_effNode:RemoveAllChildren()
        -- if canGet then
        --     UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_daojukuang_cheng, tb.obj_effNode, function(obj)
        --         if self.go_table == nil then
        --             DestroyObject(obj)
        --         end
        --     end)
        -- end
        tb.obj_redpoint:SetActiveE(canGet and 1 or 0)
        if isGet then
            tb.obj_isget:SetActiveE(1)
            tb.obj_effNode:SetActiveE(0)
            tb.aorrawimage_Icon:SetGray(true)
        else
            tb.obj_isget:SetActiveE(0)
            tb.aorrawimage_Icon:SetGray(false)
        end
    end

    if self.activity.data.free_award_cfg and self.activity.data.free_award_cfg[1] then
        self.isGetFreeReward = self.activity.data.free_award
        self.go_table.aortext_num.text = self.freeRewardCount
        self.go_table.obj_freeRewardNode:SetActiveE(1)
        if self.freeItem then
            self.freeItem:SetGou(self.isGetFreeReward)
            --self.freeItem.go_table.aorrawimage_Icon:SetGray(self.isGetFreeReward)
        end
    else
        self.go_table.obj_freeRewardNode:SetActiveE(0)
    end
    local task = self.activity.taskList[1]
    
    local task1 = _G.UIUtils.NumberToUnitStr_CardFightNum(task.i_task.target[1])

    local taskcount = _G.UIUtils.NumberToUnitStr_CardFightNum(task.Cfg.count)
    --self.go_table.aortext_jd.text = task.Cfg.desc
    self.go_table.aortext_jd.text = GetLangPackValue(33100000313,task1, taskcount)
    --self.go_table.aortext_jd1.text = string.format("(%s/%s)", task1, taskcount)
    self.go_table.aortext_finishday.text = _G.GetLangPackValue(33100000304, self.activity.award_num)
    self:FreshQuickBuy()
end

function GMBigChallengeView:UpdateTime(elapsed)
    self.elapsedTime = self.elapsedTime - elapsed
    if self.elapsedTime <= 0 then
        self:Close()
        return
    end
    self.go_table.aortext_time.text = _G.GetLangPackValue(33100000303, _G.TimeUtil.GodSpecialGiftForStr(self.elapsedTime))
end

function GMBigChallengeView:OnClickAward(_, _, index)
    local canGet = self.activity:CheckCanGet(index)
    if not canGet then
        local award = self.awardCfg[index].base_award[1].type
        local sid = award[1] == 0 and award[4] or award[1]
        require("CommonTipManager"):GetInstance():OpenTip(self.gameObject, sid)
        return
    end
    self.activity:GetAward(function(msg)
        if msg.ack ~= 1 then
            return
        end
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
        self.isGetFreeReward = self.activity.data.free_award
        self:UpdateView()
    end)
end

---界面的销毁函数
function GMBigChallengeView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eGMBigChallenge.UpdateView, self.UpdateView, self)
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---按钮点击事件在这里派发
function GMBigChallengeView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_getreward then
        self.activity:GetFreeReward(function(msg)
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            self.isGetFreeReward = self.activity.data.free_award
            self:UpdateView()
        end)
    elseif go == self.go_table.aorbtn_taskAward then
        if self.activity:GetNowQuickCanBuyNum() <= 0 then 
            _G.PopWindowManager:GetInstance():ShowAllTips(1020015)
            return 
        end
        local _,type =  _G.StorageManager:GetInstance():CheckSidType(self.activity.exchange_cfg[1].award[1].type[1])
        type=stroageID2Tip[type]
        local data= require "TipBaseModel".New()
        data:Init(self.activity.exchange_cfg[1].award[1].type[1], self.go_table.gameObject)
        local currencysid = self.activity.exchange_cfg[1].consume[1].type[1]
        local currencyData = _G.StorageManager:GetInstance():GetStorageItemData(currencysid)
        local buydata = {price = self.activity.exchange_cfg[1].consume[1].type[2],
                       currencyIcon = currencyData.Cfg.icon,
                       limit = self.activity:GetNowQuickCanBuyNum(),BuyTime = 0,count = 1}
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ShopItemTipsView.Name,
            type,
            buydata,
            data,
            function(count,call)
                if not _G.StorageManager:GetInstance():CheckItem(currencysid, buydata.price * count) then
                    _G.PopWindowManager:GetInstance():ShowAllTips(230303)
                    _G.UIManager:GetInstance():OpenWindow(
                            _G.ConfigManager.ui_cfg.GetItemWayView.Name,
                            currencysid
                    )
                    return
                end
                self.activity:QuickBuy(count,function(msg)
                    if msg.ack == 1 then 
                        _G.StorageManager:GetInstance():ConsumeItem(currencysid, 0, buydata.price * count)
                        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name,msg)
                        self:FreshQuickBuy()
                    end
                    if call then
                        call(true)
                    end
                end)
            end
        )
    end
end

return GMBigChallengeView
