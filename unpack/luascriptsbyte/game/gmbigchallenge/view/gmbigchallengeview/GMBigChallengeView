function GMBigChallengeView:LoadFreeReward()
    if self.activity.data.free_award_cfg and self.activity.data.free_award_cfg[1] then
        self.freeReward = self.activity.data.free_award_cfg[1]
        self.isGetFreeReward = self.activity.data.free_award
        local award = self.freeReward.type
        local sid = award[1] == 0 and award[4] or award[1]
        self.freeRewardCount = award[1] == 0 and award[5] or award[2]
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
                { sid, self.freeRewardCount },
                self.go_table.obj_itemNode,
                function(itemLua)
                    if _G.IsNil(self.go_table == nil) then
                        return
                    end
                    if itemLua then
                        ---@type ItemCommonBase
                        self.freeItem = itemLua
                        --itemLua:ShowData(sid)
                        --itemLua:SetIconScale(0.8)
                        itemLua:SetGou(self.isGetFreeReward)
                        --self.freeItem.go_table.aorrawimage_Icon:SetGray(self.isGetFreeReward)
                    end
                end
        )
    end
end

function GMBigChallengeView:SetItemBase(trans,isGet,canGet,tb)
    trans:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
    trans:SetGou(isGet)
    trans:ShowEffect(not isGet)
    trans.transform:SetLocalScaleXYZ(0.8)
    if tb then
        self.AwardItems[tb.index] = trans
    end
    if canGet then
        _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
                trans.transform,
                function(eff)
                    if not self.go_table then
                        _G.DestroyObject(eff)
                        return
                    end
                    trans.eff = eff
                    eff:SetLocalScaleXYZ(1.15)
                end
        )
    else
        if trans.eff then
            _G.DestroyObject(trans.eff)
        end
    end
end

