local base = require "ActivitySynTypeBase"
---@class LuckySignModel : ActivitySynTypeBase	中文描述
---@field received number               @已领取奖励序号
---@field active number                  @可领取奖励序号
---@field total number                  @总奖励序号
local LuckySignModel = _G.BaseClass("LuckySignModel", base)
--LevelActivitySynModel

---@return LuckySignModel
function LuckySignModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function LuckySignModel:__init()
end

---销毁对象时,析构函数
function LuckySignModel:Dispose()
end

--- 网络请求初始化
function LuckySignModel:GetDataFormServer()
    --初始化数据
    self.received = 0
    self.active = 0
    self.total = #_G.ConfigManager.dayaward_cfg
    if _G.PlayerModel:GetInstance():CheckCreateRole() then
        --每天解锁一个奖励, 即使中间不登陆也进行累计
        local createTime = _G.PlayerModel:GetInstance():GetCreateRoleTime()
        self.active = _G.TimeUtil.GetIntervalDay(_G.TimeUtil.GetServerUnixTime(), createTime)+1
    end
    self:RefreshRedPoint()
    self:GetInfo(_G.handler(self, self.ParseData))
end

---进入活动主体
function LuckySignModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LuckySignView.Name, self.curActivityClass, self)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function LuckySignModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.LuckySignView.Name
end

---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function LuckySignModel:InitRedPointTree()
    self.checkRedPointFunc = { self.CheckRedPoint }
    self.redpointTree = { false }
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function LuckySignModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc and self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---检查是否有红点
---@return number
function LuckySignModel:CheckRedPoint()
    local num = self:GetActive() - self:GetReceived()
    return num
end

---刷新奖励红点
---@return void
function LuckySignModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

--region====================数据接口============================

---已领取奖励序号
---@return number
function LuckySignModel:GetReceived()
    return self.received or 0
end

---可领取奖励序号
---@return number
function LuckySignModel:GetActive()
    return  _G.TimeUtil.GetIntervalDay(_G.TimeUtil.GetServerUnixTime(), _G.PlayerModel:GetInstance():GetCreateRoleTime())+1
end

---总奖励序号
---@return number
function LuckySignModel:GetTotal()
    return self.total or 0
end

---获取下一个大奖配置(未激活)
---@return dayaward_cfg
function LuckySignModel:GetNextBigAward()
    if not self.active then
        return nil
    end

    for id = self.active + 1, self.total do
        local cfg = _G.ConfigManager.dayaward_cfg[id]
        if cfg and cfg.bigaward and #cfg.bigaward > 0 and cfg.bigaward[1][1] == 1 then
            return cfg
        end
    end
    return nil
end

--endregion

--region====================网络接口============================

---获取签到信息
---@param callback fun(msg:role.s2c_get_ten_thousand_sign):void
function LuckySignModel:GetInfo(callback)
    require("LuckySignNet"):GetInstance():GetInfo(_G.handlerbind(self, self.OnInfoCallback, callback))
end

---签到回调
---@param msg role.s2c_get_ten_thousand_sign
---@param callback function
function LuckySignModel:OnInfoCallback(msg, callback)
    if msg and msg.sign_day then
        self.received = msg.sign_day
    else
        self.received = self.active
    end

    if callback then
        callback(msg)
    end
end

---进行签到请求
---@param callback fun(msg:role.s2c_ten_thousand_sign_award):void
function LuckySignModel:Sign(callback)
    require("LuckySignNet"):GetInstance():Sign(_G.handlerbind(self, self.OnSignCallback, callback))
end

---签到回调
---@param msg role.s2c_ten_thousand_sign_award
---@param callback function
function LuckySignModel:OnSignCallback(msg, callback)
    if msg and msg.ack == 1 then
        --获取奖励
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
        --更新缓存
        self.received = msg.sign_day

        --刷新红点
        self:RefreshRedPoint()
    end
    if callback then
        callback(msg)
    end
end

--endregion


return LuckySignModel
