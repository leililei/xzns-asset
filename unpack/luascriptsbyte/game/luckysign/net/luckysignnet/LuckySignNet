local base = require("BaseGameNet")
---@class LuckySignNet : BaseGameNet	中文描述
local LuckySignNet = _G.BaseClass("LuckySignNet", base)

-- 单例类有获取实例的方法GetInstance()
---@return LuckySignNet LuckySignNet
function LuckySignNet:GetInstance()
    return base.GetInstance(self)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function LuckySignNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function LuckySignNet:Callback(port, data, error)
    if error then
        return
    end
    if data.server_time then
        --同步服务器时间
        --服务器下发的时间单位是S  本地解析是按照MS解析的 所以*1000
        _G.CS.YoukiaCore.TimeKit.ModifyTime(data.server_time * 1000)
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---获取万抽签到信息
---@param callback function
function LuckySignNet:GetInfo(callback)
    self:Access(_G.ConfigManager.net_map.game_role_get_ten_thousand_sign, self:GetEmptyPB(), callback)
end

---进行万抽签到
---@param callback function
function LuckySignNet:Sign(callback)
    self:Access(_G.ConfigManager.net_map.game_role_ten_thousand_sign_award, self:GetEmptyPB(), callback)
end

---@type LuckySignNet
return LuckySignNet
