---刷新节点信息
---@param index number
---@param go UnityEngine.GameObject
---@return void
function LuckySignView:RefreshItem(index, go)
    if not self.items then
        self.items = {}
    end
    ---@type LuckySignView._obj_rewardItem_GoTable
    local item = self.items[go:GetInstanceIDE()]
    if not item then
        item = _G.GetAutoGoTable(go)
        self.items[go:GetInstanceIDE()] = item
    end

    --显示节点
    local data = self.datas[index + 1]
    local isReceived = data.id <= self.model:GetReceived()
    local canGet = not isReceived and data.id <= self.model:GetActive()

    item.data = data
    item.obj_shadow:SetActiveE(isReceived and 1 or 0)
    item.aortext_index.text = _G.GetLangPackValue(90023800019, data.id)
    --奖励信息
    item.obj_item:ClearChildren()
    if data.reward and #data.reward > 0 then
        local sid, num = table.unpack(data.reward[1])
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemBaseWithCount,
            item.obj_item,
            function(rewardItem)
                if self:IsNil() or item.data ~= data then
                    _G.DestroyObject(rewardItem.gameObject)
                    return
                end
                rewardItem:Show(sid, _G.handlerbind(self, self.OnItemClickBtn, item), num)
            end
        )
        if item.eff then
            item.obj_eff:SetActiveE(canGet and 1 or 0)
        else
            local eff = _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang
            _G.UIUtils.LoadEffectByCfg(
                eff,
                item.obj_eff,
                function(trans)
                    if _G.IsNil(item.obj_eff) then
                        _G.DestroyObject(trans)
                        return
                    end
                    item.eff = trans
                    -- trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                    item.obj_eff:SetActiveE(canGet and 1 or 0)
                end
            )
        end
    end
end

---进行签到操作, 获取奖励
---@return void
function LuckySignView:Sign()
    self.model:Sign(function(msg)
        if not msg or msg.ack ~= 1 then
            return
        end
        --显示奖励信息
        _G.UIUtils.ShowCommonAward(msg)
        --刷新列表
        self:UpdateView()
    end)
end

---节点点击事件
---@param item LuckySignView._obj_rewardItem_GoTable|{data:dayaward_cfg}
function LuckySignView:OnItemClickBtn(item)
    local data = item.data
    if not data then
        return
    end
    if data.id <= self.model:GetReceived() or data.id > self.model:GetActive() then
        --展示奖励tip
        if data.reward and #data.reward > 0 then
            local sid, num = table.unpack(data.reward[1])
            require("CommonTipManager"):GetInstance():OpenTip(item.gameObject, sid)
        end
    else
        self:Sign()
    end
end

---按钮点击事件
function LuckySignView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_all1 or go == self.go_table.aorbtn_all2 then
        self:Sign()
    end
end

function LuckySignView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate,self.UpdateView,self)
end

function LuckySignView:CloseView()
    self:Close()
end

return LuckySignView
