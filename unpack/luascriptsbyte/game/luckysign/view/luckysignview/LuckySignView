---@class LuckySignView : UIBaseView	万抽签到
---@field public go_table LuckySignView_GoTable GoTable
---@field activity any
---@field model LuckySignModel
---@field datas dayaward_cfg[]
---@field items table<any,LuckySignView._obj_rewardItem_GoTable>    列表节点
local LuckySignView = _G.BaseClass("LuckySignView", _G.UIBaseView)
function LuckySignView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate,self.UpdateView,self)
end

function LuckySignView:OnCreate(activity, model)
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.LuckySignView, self.go_table)
    self.activity = activity
    self.model = model

    --初始化资源栏
    local resources = _G.ConfigManager.ui_cfg.LuckySignView.resources
    self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, resources))

    --初始化列表
    self.go_table.scrollloopvectical_reward:InitItemData(0, _G.handler(self, self.RefreshItem))

    --更新视图
    --self:UpdateView()
    --ZHJH-4725【万抽福利】解锁后第一天奖励没高亮
    --因嵌套父页面, 导致ui_effect_cfg显示层级异常
    _G.DelayFrameDo(_G.handler(self,self.DelayUpdateView))

    --spine
    self:LoadSpine()

    --置灰
    self:BtnGray()

    --local uiModel = _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.ui_model_1)
    --self.go_table.obj_t3:SetActiveE(uiModel and 0 or 1)
    UIUtils.SetUIModel(self.go_table.obj_tip1,nil,self.go_table.obj_tip3)
end

function LuckySignView:BtnGray()
    self.go_table.aorbtn_clear:SetGray(true)
    self.go_table.aorbtn_clear:GetComponentE(_G.typeof(_G.CS.AorImage)).color = _G.ColorTools.FormatColorByString("A9A9A9")
end

function LuckySignView:LoadSpine()
    if _G.AppSetting.IsXzns then
        _G.GameUtil.SetUiHeXieMask(self.go_table)
    end
    if _G.UIUtils.IsHaveChange(_G.IsNeedChangeUI.LuckySignView, "obj_role") then
        return
    end
    if not self.roleSpine then
        require("CardInfoManager"):GetInstance().GetRole(
                _G.ConfigManager.card_cfg[111010000].ModelPathHi,
                _G.ePoolType.Temporary,
                self.go_table.obj_role,
                nil,
                function(trans)
                    if _G.IsNil(self.go_table.obj_role) then
                        _G.DestroyObject(trans)
                        return
                    end
                    self.roleSpine = trans
                end
        )
    end
end

---延迟更新视图
function LuckySignView:DelayUpdateView()
    if self:IsNil() then
        return
    end
    self:UpdateView()
end

function LuckySignView:UpdateView()
    --更新按钮状态
    local num = self.model:GetActive() - self.model:GetReceived()
    self.go_table.aorbtn_all1:SetActiveE(num > 1 and 1 or 0)
    self.go_table.aorbtn_all2:SetActiveE(num == 1 and 1 or 0)
    self.go_table.aorbtn_clear:SetActiveE(num <= 0 and 1 or 0)

    self:UpdateRewardView()
    self:UpdateBigAwardView()
end

---更新大奖信息
---@return void
function LuckySignView:UpdateBigAwardView()
    local bigAwardCfg = self.model:GetNextBigAward()
    self.go_table.obj_bigAward:SetActiveE(bigAwardCfg and 1 or 0)
    if not bigAwardCfg then
        return
    end

    self.go_table.aortext_bigAward.text = _G.GetLangPackValue(90027500004, bigAwardCfg.id - self.model:GetActive())
    --奖励信息
    self.bigAwardCfg = bigAwardCfg
    self.go_table.obj_bigAwardRoot:ClearChildren()
    if bigAwardCfg.reward and #bigAwardCfg.reward > 0 then
        local sid, num = table.unpack(bigAwardCfg.reward[1])
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemBaseWithCount,
            self.go_table.obj_bigAwardRoot,
            function(rewardItem)
                if self:IsNil() or self.bigAwardCfg ~= bigAwardCfg then
                    _G.DestroyObject(rewardItem.gameObject)
                    return
                end
                rewardItem.gameObject:SetLocalScaleXYZ(1.64)
                rewardItem:Show(sid, nil, num)
            end
        )
    end

    --特效
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_daojuliubian_cai,
        self.go_table.obj_bigAward,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            trans:SetAnchorPosition(0, 82)
            if AppSetting.IsXzns then
                trans:SetAnchorPosition(-6, 112)
            end
        end
    )
end

