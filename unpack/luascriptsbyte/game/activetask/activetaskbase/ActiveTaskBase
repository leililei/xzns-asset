---@class ActiveTaskBase : BaseEvent	中文描述
local ActiveTaskBase = _G.BaseClass("ActiveTaskBase", _G.BaseEvent)
_G.ActiveTaskBase = ActiveTaskBase

function ActiveTaskBase:Clear()
    --- 服务器下发 任务数据
    ---@type task.i_task
    self.i_task = nil

    --- 配置表  mission_cfg[自身]
    self.Cfg = nil

    --- 任务是否解锁
    self.isUnlock = false
    ---移除监听
    _G.Events:GetInstance():RemoveListener(_G.ePlayAactionEvent.PlayAaction, self.OnAactionEnent, self)
    _G.Events:GetInstance():RemoveListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.OnEvent_CheckLock, self)
end

---@field dayid number 手册id
---@field manualId number 手册id
---@class Params_ActiveTaskBase

---创建对象时,入口构造函数
---@param task task.i_task
---@param call function 任务完成后执行函数(刷新相关界面等)
---@param activity ActivitySynBase
function ActiveTaskBase:__init(task, call, MarkTaskType, Params_ActiveTaskBase, activity)
    Params_ActiveTaskBase = Params_ActiveTaskBase or {}
    self.activityClass = activity

    ---广播该任务枚举 有变动后 用通用检测 (死魂塔 参数复杂 全塔 主塔 五行塔 不好全部广播)
    self.CommonTaskEnum = {
        [_G.ActiveTaskEnum.ConditionEnum.Section.DeadsoulFoor] = true,
        ---等级 要比大小 直接查背包
        [_G.ActiveTaskEnum.ConditionEnum.CardLevel.assignCountAssignLevel] = true,
        ---星级 要比大小 直接查背包
        [_G.ActiveTaskEnum.ConditionEnum.CardLevel.assignCountAssignStar] = true,
        ---指定sid卡牌升到n级(优化 连续升级)
        [_G.ActiveTaskEnum.ConditionEnum.CardLevel.assignSidAssignLevel] = true,
        ---共鸣槽位最低等级达到n级
        [_G.ActiveTaskEnum.ConditionEnum.CardResonance.FivePosLevel] = true,
        ---X个英雄（槽位）达到Y级
        [_G.ActiveTaskEnum.ConditionEnum.CardResonance.PosLevelNum] = true,
        ---界限突破相关
        [_G.ActiveTaskEnum.ConditionEnum.Artifact.LevelNum] = true,
        [_G.ActiveTaskEnum.ConditionEnum.Artifact.StarNum] = true,
        [_G.ActiveTaskEnum.ConditionEnum.Artifact.AwakenNum] = true,
        [_G.ActiveTaskEnum.ConditionEnum.Artifact.SidLevel] = true,
        [_G.ActiveTaskEnum.ConditionEnum.Artifact.SidStar] = true,
        [_G.ActiveTaskEnum.ConditionEnum.Artifact.SidAwaken] = true,
        [_G.ActiveTaskEnum.ConditionEnum.CardTalent.LevelNum] = true,
        [_G.ActiveTaskEnum.ConditionEnum.CardResonance.PosLevelNum] = true,
        ---同时拥有x个y星的彩色品质的饰品
        [_G.ActiveTaskEnum.ConditionEnum.Spiritual.LevelNum] = true,
    }

    ---任务对应 手册id 标记任务完成用
    self.manualId = Params_ActiveTaskBase.manualId or 0
    ---七日目标 任务
    self.dayid = Params_ActiveTaskBase.dayid or 1
    ---标记任务完成  枚举类型
    self.MarkTaskType = MarkTaskType or _G.MarkTaskType.none
    self:Init(task)
    self.call = call
    --self:Clear()
    self:ParseData(task)
    if task.state == _G.TaskEnum.ETaskState.Claimed then
        if self.taskEnumType == _G.ActiveTaskEnum.ConditionEnum.CumulativeLogin.specifiedTime then
            --指定时间段登录 6点起 0- 86400
            local starSecond = task.taskcontentparams[2]
            local notSecond = _G.TimeUtil.GetSecondsOfDayOf6Hour()
            ---如果已错过时间 86400+明天启始时间-今天已过时间
            local nexttime
            if notSecond < 0 then
                nexttime = -notSecond
            else
                nexttime = starSecond - notSecond
            end
            self:AddSpecifiedTime(nexttime)
        elseif self.taskEnumType == _G.ActiveTaskEnum.ConditionEnum.CumulativeLogin.dayAfter then
            --接取任务后几天登录
            local nowSecond = _G.TimeUtil.GetServerUnixTime()
            local starSecond = (self.taskcontentparams[2] - 1) * 86400 + _G.TimeUtil.GetDayBySix(self.getTime)
            local nexttime = starSecond - nowSecond
            self:AddDayAfterTime(nexttime)
        else
            _G.Events:GetInstance():AddListener(_G.ePlayAactionEvent.PlayAaction, self.OnAactionEnent, self)
        end
    end
end

function ActiveTaskBase:Init()
end

---@param task task.i_task
function ActiveTaskBase:ParseData(task)
    self.i_task = task
    self:InitCfg()
    if self.taskEnumType == nil then
        ---@type ConditionEnum
        self.taskEnumType = self.Cfg.condition[1][1]
        self.taskcontentparams = self.Cfg.condition[1]
    end
    if self.taskEnumType == _G.ActiveTaskEnum.ConditionEnum.CumulativeLogin.dayAfter then 
        self.getTime = self.i_task.target[1]
        self.i_task.target[1] = 0
    end
    if self.taskEnumType == _G.ActiveTaskEnum.ConditionEnum.Charge.TotalCharge then 
        self.i_task.target[1] = require("MallManager"):GetInstance():GetCashRmb() or 0
    end
    self:CheckLock()
    self:CheckTaskState()
    self:CheckTaskTarget()
end

function ActiveTaskBase:InitCfg()
    self.Cfg = _G.ConfigManager.mission_cfg[self.i_task.sid]
end

--- 检测任务状态
function ActiveTaskBase:CheckTaskState()
    if self.i_task == nil then
        return
    end
    --- 防止 抽卡0/5 任务  十连   服务器记录10/5
    if self.i_task.target[1] > self.Cfg.count then
        self.i_task.target[1] = self.Cfg.count
    end

    if self.i_task.state == _G.TaskEnum.ETaskState.Claimed then
        if self.i_task.target[1] >= self.Cfg.count then
        else
            --- 次数没达到 不算完成
            return
        end

        self.i_task.state = _G.TaskEnum.ETaskState.Submited
        _G.Events:GetInstance():RemoveListener(_G.ePlayAactionEvent.PlayAaction, self.OnAactionEnent, self)

        if self.MarkTaskType == _G.MarkTaskType.none then
            if _G.AppSetting.DEBUG then
                _G.LogError("MarkTaskType  未定义")
            end
        else
            local tData = {}
            tData.dayid = self.dayid
            tData.manualId = self.manualId
            require("TaskManager").MarkTask(self.MarkTaskType, self.i_task.sid, tData, self.i_task)
        end

        if self.call ~= nil then
            _G.TaskModule:GetInstance():SetCompletedTask(self.i_task.sid)
            self.call(self.i_task.sid)
            self.call = nil
        end
    elseif self.i_task.state == _G.TaskEnum.ETaskState.Submited then
        ---如果已标记为完成 就设置进度为完成
        if self.i_task.target[1] == 0 then
            ---只有没进度 才这样 防止 频繁刷新 数据不对
            local value = self.taskcontentparams[#self.taskcontentparams] or 0
            local num = value
            if self.Cfg and self.Cfg.count then
                if num >= self.Cfg.count then
                    num = self.Cfg.count
                end
            end
            self.i_task.target[1] = num
        end
    end
end

---@param task task.i_task
function ActiveTaskBase:UpdataData(task)
    self.i_task = task
    self:CheckTaskState()
end

---@param isfh boolean true解析多组id
function ActiveTaskBase:OnAactionEnent(id, parmas, isfh, isSet)
    if self:IsCheckTaskTarget(id[1]) then
        ---该任务枚举 有变动后 用通用检测 (死魂塔 参数2复杂(全塔 主塔 五行塔)  不好各参数全部广播)
        return
    end
    if isfh then
        local array = table.toArray(id)
        table.sort(
            array,
            function(a, b)
                return a < b
            end
        )
        local index = table.indexof(array, self.Cfg.condition[1][1])
        if false ~= index then
            local keys = {array[index]}
            for i = 2, #parmas[index] do
                table.insert(keys, parmas[index][i])
            end
            self:DoOne(keys, parmas[index][1], isSet)
        end
    else
        self:DoOne(id, parmas, isSet)
    end
end

---@param isSet boolean true设置进度(检测类条件且有数量要求 初始化)
function ActiveTaskBase:DoOne(id, parmas, isSet)
    ---isSet  更新设置当前任务进度
    ---例:指定N张卡 升到指定X级  55#10#3   指定3张卡升到10级
    ---检测背包有2张 直接设置当前任务进度为2  而不是累计
    local condition = self.Cfg.condition[1]

    if table.sameByCount(id, condition) then
        if self.i_task.state ~= _G.TaskEnum.ETaskState.Claimed then
            return
        end
        if _G.AppSetting.DEBUG then
            _G.LogUtilities.LogError(_G.EModuleName.TaskModule, string.format(" ActiveTaskBase 任务id %s", tostring(id)))
            _G.LogUtilities.LogError(_G.EModuleName.TaskModule, string.format(" ActiveTaskBase参数 %s", tostring(parmas)))
        end

        local value = parmas or 0
        local num = 0

        if isSet == true then
            num = value
        else
            ---累加的就直接加
            if self.Cfg.type_calculate == 1 or self.Cfg.type_calculate == 0 then
                num = self.i_task.target[1] + value
            else
                if value >= self.i_task.target[1] then
                    num = value
                else
                    num = self.i_task.target[1]
                end
            end
        end

        local numS = self:IsCheckTaskTargets(num)
        self.i_task.target[1] = numS
        self:CheckTaskState()
    end
end

function ActiveTaskBase:IsCheckTaskTargets(num)
    if num >= self.Cfg.count then
        num = self.Cfg.count
    end
    return num
end

----广播该任务枚举 有变动后 用通用检测 (死魂塔 参数复杂 全塔 主塔 五行塔 不好全部广播))
---@return boolean true使用通用检测
function ActiveTaskBase:IsCheckTaskTarget(taskEnumType)
    if taskEnumType == self.taskEnumType and self.CommonTaskEnum[self.taskEnumType] then
        self:CheckTaskTarget()
        return true
    else
        return false
    end
end

function ActiveTaskBase:CheckLock()
    if self.isUnlock == true then
        return
    end
    if self.Cfg == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(" 任务信息未找到 taskid: " .. tostring(self.i_task.sid))
        end
        return
    end
    if self.Cfg.function_open == 0 then
        self.isUnlock = true
        return
    end
    self.isUnlock = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.Cfg.function_open)

    if not self.isUnlock then
        _G.Events:GetInstance():AddListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.OnEvent_CheckLock, self)
    end
end

function ActiveTaskBase:OnEvent_CheckLock(id)
    if self.isUnlock == true then
        _G.Events:GetInstance():RemoveListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.OnEvent_CheckLock, self)
        return
    end
    if self.Cfg.function_open ~= id then
        return
    end
    self.isUnlock = true
    self:CheckTaskTarget()
    _G.Events:GetInstance():RemoveListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.OnEvent_CheckLock, self)
end

---检测任务目标   检测类任务(检测某个关卡是否通关/检测背包仓库等)  任务初始化时执行
function ActiveTaskBase:CheckTaskTarget()
    if self.isUnlock == false then
        return
    end
    if self.i_task.state ~= _G.TaskEnum.ETaskState.Claimed then
        return
    end
    local okfun = function(id, parmas, isSet)
        self:DoOne(id, parmas, isSet)
    end

    require("TaskManager").CheckTaskTarget(self, okfun)
end

--region --------------------------------------指定时间段登录--------

function ActiveTaskBase:AddSpecifiedTime(time)
    if time == nil then
        return
    end
    if self.SpecifiedTimeCo == nil then
        if time > 0 then
            self.SpecifiedTimeCo = _G.DelayDo(time, _G.handler(self, self.SpecifiedTime))
        else
            self:CheckTaskTarget()
        end
    end
end

function ActiveTaskBase:SpecifiedTime()
    self:SubSpecifiedTime()
    self:CheckTaskTarget()
end

function ActiveTaskBase:SubSpecifiedTime()
    if self.SpecifiedTimeCo == nil then
        return
    end
    _G.coroutine.stopwaiting(self.SpecifiedTimeCo)
    self.SpecifiedTimeCo = nil
end

--endregion------------------------------------指定时间段登录--------

--region --------------------------------------指定接取任务后几天登录--------

function ActiveTaskBase:AddDayAfterTime(time)
    if time == nil then
        return
    end
    if self.DayAfterTimeCo == nil then
        if time > 0 then
            self.DayAfterTimeCo = _G.DelayDo(time, _G.handler(self, self.DayAfterTime))
        else
            self:CheckTaskTarget()
        end
    end
end

function ActiveTaskBase:DayAfterTime()
    self:SubDayAfterTime()
    self:CheckTaskTarget()
end

function ActiveTaskBase:SubDayAfterTime()
    if self.DayAfterTimeCo == nil then
        return
    end
    _G.coroutine.stopwaiting(self.DayAfterTimeCo)
    self.DayAfterTimeCo = nil
end

--endregion------------------------------------指定接取任务后几天登录--------

---销毁对象时,析构函数
function ActiveTaskBase:Dispose()
    self:Clear()
end

return ActiveTaskBase
