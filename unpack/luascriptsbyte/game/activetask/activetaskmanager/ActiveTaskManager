---一键领取循环判断服务器端
function ActiveTaskManager:YiJianLingQu(data)
    local mission_cfg = _G.ConfigManager.mission_cfg
    local cfg = mission_cfg[data.sid]
    local idList = {}
    if cfg.type_mission ~= 2 then
        return idList
    end
    _G.table.insert(idList, data.sid)

    if cfg.re_sid == nil or cfg.re_sid < 0 then
        return idList
    end
    for _ = 1, 99 do
        cfg = mission_cfg[cfg.re_sid]
        if cfg == nil or cfg.id < 0 then
            return idList
        end
        local num = #cfg.condition[1]
        local count = self:TiaoMuPanDuan(cfg.condition)
        if self:GetAcfieve(cfg.id) then
            _G.table.insert(idList, cfg.id)
        elseif count >= cfg.condition[1][num] then
            _G.table.insert(idList, cfg.id)
        else
            if self:CheckTaskTarget(cfg.condition[1], data) then
                _G.table.insert(idList, cfg.id)
            else
                return idList
            end
        end
        -- if  _G.table.sameByCount(cfg.condition, data[i]) then
        --     -- body
        -- end
        -- if cfg.condition[1][num] <= data.target[1] then
        --     _G.table.insert(self.tasks, cfg.id)
        -- else
        --     return idList
        -- end
    end
end

function ActiveTaskManager:GetAcfieve(condition)
    if self.dataA.get_achieve ~= nil then
        for _, value in pairs(self.dataA.get_achieve) do
            if condition == value then
                return true
            end
        end
    end
    return false
end

function ActiveTaskManager:TiaoMuPanDuan(condition)
    local _ = #condition[1]
    for key, value in pairs(self.dataB) do
        if condition[1][1] == key then
            return value
        end
    end

    return 0
end

function ActiveTaskManager:ShuZhiPanDuan(condition, num)
    if self.dataB ~= nil and self.dataB[condition] then
        if self.dataB[condition] < num then
            self.dataB[condition] = num
        end
    end
end

