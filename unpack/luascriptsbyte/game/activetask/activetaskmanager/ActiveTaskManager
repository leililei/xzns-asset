    local mission_cfg = _G.ConfigManager.mission_cfg
    local cfg = mission_cfg[data.sid]
    ---判断是否
    if cfg.type_mission ~= 2 then
        return idList
    end
end

function ActiveTaskManager:UpdateMangerTasks(data)
    local cfg = _G.ConfigManager.mission_cfg[data]
    if cfg.re_sid > 0 then
        for i = 1, #self.tasks do
            if self.tasks[i].i_task.sid == data then
                --isAdd = true
                _G.table.remove(self.tasks, i)
                local states
                if self:GetAcfieve(cfg.re_sid) then
                    states = _G.TaskEnum.ETaskState.Submited
                else
                    states = _G.TaskEnum.ETaskState.Claimed
                end
                local task = {
                    sid = cfg.re_sid,
                    state = states,
                    target = { self:TiaoMuPanDuan(cfg.condition) }
                }
                self:AddTask(task)
                return
            end
        end
    else
        -- local states
        -- if self:GetAcfieve(data) then
        --     states = _G.TaskEnum.ETaskState.Submited
        -- else
        --     states = _G.TaskEnum.ETaskState.Completed
        -- end
        local task = {
            sid = data,
            state = _G.TaskEnum.ETaskState.Completed,
            target = { cfg.count }
        }
        self:UpdataTask(task)
        return
    end
end

---放置章节末打完主动领取成就章节奖励u
---登录检测不缓存奖励数据 false 登录 true 战斗结束领取
function ActiveTaskManager:GetCurAfkChapterEndAward(taskId, type)
    if taskId ~= nil then
        require("TaskNet"):GetInstance():GetAchieveAward(
                { sid = { taskId } },
                function(data)
                    if data.sids == nil then
                        return
                    end
                    for i = 1, #data.sids do
                        self:UpdateMangerTasks(data.sids[i])
                    end
                    _G.StorageManager:GetInstance():ReceiveAwardData(data)
                    if type then
                        require "AfkModel":GetInstance():SetCurChapterEndAward(data, taskId)
                    end
                    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.AchievementPage.id)
                    self.check = nil
                    require("AchieveTipManager"):GetInstance():Show(taskId)
                end
        )
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("章节关卡id为空，成就领奖暂停")
        end
    end
end

---销毁对象时,析构函数
function ActiveTaskManager:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.ResUpdata, self)
    _G.Events:GetInstance():RemoveListener(_G.GlobalEvents.GlobalResetGame, self.OnEvent_ResetGame, self)
    _G.SDKManager:GetInstance():RemoveListener(SDKDef.GetMsg.onShareAppMessage, self.ShareSuccess, self)

    self.super:Dispose()
end

