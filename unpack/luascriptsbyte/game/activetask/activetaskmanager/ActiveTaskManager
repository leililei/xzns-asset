function ActiveTaskManager:UpdateMangerTasksNew(data)
    local cfg = _G.ConfigManager.mission_cfg[data]
    if cfg.re_sid > 0 then
        --local isAdd = false

        local task = {
            sid = cfg.re_sid,
            state = _G.TaskEnum.ETaskState.Claimed,
            target = { self:TiaoMuPanDuan(cfg.condition) }
            -- target = self.tasks[data].target
        }
        self:AddTask(task)
    else
        local task = {
            sid = data,
            state = _G.TaskEnum.ETaskState.Completed,
            target = { cfg.count }
        }
        local blacklist = {}
        local wxid = _G.ConfigManager.discrete_cfg[103303][1][1]
        local dyid = _G.ConfigManager.discrete_cfg[103304][1][1]
        if _G.AppSetting.IsXzns then
            table.insert(blacklist, dyid)
            table.insert(blacklist, wxid)
            if _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.shareSwitch) then
                if _G.AppSetting.IsWeiXin then
                    table.removebyvalue(blacklist, wxid)
                elseif _G.AppSetting.IsDouYin then
                    table.removebyvalue(blacklist, dyid)
                end
            end
        else
            if _G.AppSetting.IsWeiXin then
                table.insert(blacklist, dyid)
            elseif _G.AppSetting.IsDouYin then
                table.insert(blacklist, wxid)
            else
                table.insert(blacklist, dyid)
                table.insert(blacklist, wxid)
            end
        end
        if false == table.indexof(blacklist, task.sid) then
            local ActiveTaskBases = _G.ActiveTaskBase.New(task, self.taskCompletedFun, _G.MarkTaskType.Daily)
            table.insert(self.tasks, ActiveTaskBases)
        end
        return
    end
