-- 是否有待 提交的每日任务
function ActiveTaskManager:HaveTaskSubmited()
    for i = 1, #self.tasks do
        local tasks = self.tasks[i]
        if tasks.Cfg.type_mission == 1 and tasks.i_task.state == _G.TaskEnum.ETaskState.Submited then
            --- 为0 默认显示
            local isfunction_open = tasks.Cfg.function_open == 0
            if isfunction_open == false then
                isfunction_open = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(tasks.Cfg.function_open)
            end
            if isfunction_open then
                return true
            end
        end
    end

    return false
end

