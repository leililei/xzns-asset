function ActiveTaskManager:PanDuanZhi(onFinishCallback, onRespCallback)
    -- local mission_cfg = _G.ConfigManager.mission_cfg
    if self.yijianlingqupanduan then
        return
    end
    self.yijianlingqupanduan = true
    local canGets = {}
    local mission_cfg = _G.ConfigManager.mission_cfg
    for _, value in pairs(self.tasks) do
        if value.i_task.state == _G.TaskEnum.ETaskState.Submited then
            local idList = self:YiJianLingQu(value.i_task)
            for _, s in pairs(idList) do
                _G.table.insert(canGets, s)
            end
        end
    end

    if _G.table.count(canGets) > 0 then
        require("TaskNet"):GetInstance():GetAchieveAward(
                { sid = canGets },
                function(data)
                    self.yijianlingqupanduan = false
                    if data == nil then
                        onFinishCallback()
                        return
                    end
                    local num = {}
                    if data.sids == nil then
                        data.sids = {}
                    end
                    for _, value in pairs(self.tasks) do
                        local cfg = mission_cfg[value.i_task.sid]
                        if cfg.type_mission == 2 then
                            if self:ShanChu(data.sids, value) then
                                _G.table.insert(num, value)
                            end
                        else
                            _G.table.insert(num, value)
                        end
                    end
                    self.tasks = num

                    local list = self:LingQuShuaXing(data.sids)
                    for i = 1, #list do
                        self:UpdateMangerTasksNew(list[i])
                    end

                    if onRespCallback then
                        onRespCallback()
                    end

