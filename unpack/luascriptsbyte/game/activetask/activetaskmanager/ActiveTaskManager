function ActiveTaskManager:UpdataBoxStauts()
    for boxIndex, value in pairs(self.Box_status) do
        local tagerNum = self.ActiveTaskBoxValue[boxIndex]

        --- 如果当前活跃 达到阈值
        if self.ActiveValue >= tagerNum then
            if value == _G.ActiveTaskBoxType.Invalid then
                --- 宝箱可领取
                self.Box_status[boxIndex] = _G.ActiveTaskBoxType.WaitClaim
            end
        end

        --- 宝箱Sid配置
        if self.Box_BoxSid[boxIndex] == nil then
            self.Box_BoxSid[boxIndex] = self:GetBoxRewardSid(boxIndex)
        end
    end
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.DailyBox.id)
    self:UpdataView()
end

function ActiveTaskManager:TaskCompleted(taskid)
    local id = _G.ConfigManager.mission_cfg[taskid].type_mission
    if id == 1 then
        require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.DailyTaskPage.id,
                taskid
        )
    elseif id == 2 then
        require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.AchievementPage.id,
                taskid
        )
    end

    self:UpdataView()
end

