---数据解析完成

function ActiveTaskManager:ParseDataD(data)
    --- 缓存数据 InitFunction后销毁
    if data ~= nil then
        self.dataD = data

        self.award_num = data.award_num or 0
        self.award_state = nil

        local all_liveness = data.all_liveness or 0
        if all_liveness > 0 then
            --- 如果 大于上次领取
            --- 250> 100+100
            all_liveness = data.all_liveness - self.award_num

            if data.all_liveness > (self.award_num + self.all_livenessDic.value) then
                self.award_state = 1
            end
        end

        self.all_liveness = all_liveness
        self.ActiveValue = data.liveness or 0

        local resdata = {
            type = {}
        }
        resdata.type = { _G.ResPropID.ActiveValue, 0, self.ActiveValue }

        ---  初始化仓库 活跃度值  tips查看活跃度道具 会显示当前拥有数量
        _G.StorageManager:GetInstance():ParseSimpleAward(resdata)
        _G.Events:GetInstance():Broadcast(_G.FunctionOpenDailyCheckEvent.DailyActive)
    end
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.Active.id)
end

function ActiveTaskManager:ReConnect(call)
    require("TaskNet"):GetInstance():DailyTask_Get(
            function(data)
                if data.ack ~= 1 then
                    data = nil
                end

                self:ParseDataD(data)
                ---成就是否开放
                --if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(32) then
                require("TaskNet"):GetInstance():GetAchieveInfo(
                        function(datas)
                            self:ParseDatas(datas)
                            self.IsGetAchieveData = true

                            self:InitFunction()
                            if call then
                                call()
                            end
                        end
                )
                -- else
                --end
            end
    )
    ---self:InitFunction()
end

function ActiveTaskManager:InitFunction()
    if not _G.table.isEmptyOrNil(self.tasks) then
        for i = 1, _G.table.count(self.tasks) do
            self.tasks[i]:Dispose()
            -- _G.table.remove(self.tasks, i)
        end
        -- for k, v in pairs(self.tasks) do
        --     v:Dispose()
        -- end
        self.tasks = {}
    end
    local blacklist = {}
    local wxid = _G.ConfigManager.discrete_cfg[103303][1][1]
    local dyid = _G.ConfigManager.discrete_cfg[103304][1][1]

    if _G.AppSetting.IsXzns then
        table.insert(blacklist, dyid)
        table.insert(blacklist, wxid)
        if _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.shareSwitch) then
            if _G.AppSetting.IsWeiXin then
                table.removebyvalue(blacklist, wxid)
            elseif _G.AppSetting.IsDouYin then
                table.removebyvalue(blacklist, dyid)
            end
        end
    else
        if _G.AppSetting.IsWeiXin then
            table.insert(blacklist, dyid)
        elseif _G.AppSetting.IsDouYin then
            table.insert(blacklist, wxid)
        else
            table.insert(blacklist, dyid)
            table.insert(blacklist, wxid)
        end
    end

    local data
    if self.dataD ~= nil then
        data = self.dataD
        if data.task ~= nil then
            for _, value in pairs(data.task) do
                if false == table.indexof(blacklist, value.sid) then
                    local ActiveTaskBases = _G.ActiveTaskBase.New(value, self.taskCompletedFun, _G.MarkTaskType.Daily)
                    table.insert(self.tasks, ActiveTaskBases)
                end
            end
        end

        if data.finish_task ~= nil then
            for _, taskid in pairs(data.finish_task) do
                local task = {
                    sid = taskid,
                    state = _G.TaskEnum.ETaskState.Completed,
                    target = {
                        [1] = 999
                    }
                }
                if false == table.indexof(blacklist, task.sid) then
                    local ActiveTaskBases = _G.ActiveTaskBase.New(task, self.taskCompletedFun, _G.MarkTaskType.Daily)
                    table.insert(self.tasks, ActiveTaskBases)
                end
            end
        end
        if data.box_award ~= nil then
            for _, boxSid in pairs(data.box_award) do
                local boxIndex = boxSid % 10
                self.Box_status[boxIndex] = _G.ActiveTaskBoxType.Claimed
                --- 宝箱Sid配置
                self.Box_BoxSid[boxIndex] = boxSid
            end
        end
    end
    -- self.dataD = nil

    if self.dataA ~= nil then
        data = self.dataA

        local temp = {}
        for _, info in pairs(_G.ConfigManager.mission_cfg) do
            if info.type_mission == 2 and info.pre_sid == 0 then
                table.insert(temp, info.id)
            end
        end

        for i = 1, #temp do
            self:SetServerInfo(data, temp[i])
        end

        local tempType = {}
        for i = 1, #self.tasks do
            if self.tasks[i].Cfg.type_mission == 2 then
                table.insert(tempType, self.tasks[i].Cfg.condition[1][1])
            end
        end

        local tempKeys = {}

        if data.finish_achieve ~= nil then
            for _, taskid in pairs(data.finish_achieve) do
                local cfg = _G.ConfigManager.mission_cfg[taskid]
                if cfg and cfg.re_sid == 0 then
                    -- body

                    local task = {
                        sid = taskid,
                        state = _G.TaskEnum.ETaskState.Completed,
                        target = {
                            [1] = cfg.count
                        }
                    }
                    local keyTask = tempKeys[cfg.condition[1][1]]

                    if nil == keyTask or taskid > keyTask.sid then
                        tempKeys[cfg.condition[1][1]] = task
                    end
                    if false == table.indexof(blacklist, task.sid) then
                        local ActiveTaskBases = _G.ActiveTaskBase.New(task, self.taskCompletedFun, _G.MarkTaskType.Daily)
                        table.insert(self.tasks, ActiveTaskBases)
                    end
                end
            end
        end
        if data.get_achieve == nil then
            data.get_achieve = {}
        end
        if data.collector ~= nil then
            -- body

            for _, value in pairs(data.collector) do
                _G.Events:GetInstance():Broadcast(_G.ePlayAactionEvent.PlayAactionCj, value.key, value.value, nil, true)
            end
        end
    end
    --self.dataA = nil

    self:UpdataBoxStauts(0)
    self:UpdataAllLiveness(0)
    if #self.initFunc then
        for _, v in pairs(self.initFunc) do
            v()
        end
    end
    -- self:CheckAfteChapterEndAwardIsGet() ---ZHJH-797 屏蔽掉奖励界面
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.AchievementPage.id)
end

---判断所有章节成就奖励是否全部领取 未领取自动领取
function ActiveTaskManager:CheckAfteChapterEndAwardIsGet()
    if self.check then
        return
    end
    self.check = true
    self.ChapterEndAward = require "AfkModel":GetInstance().ActiveTaskChapterEndAward
    for _, v in pairs(self.tasks) do
        if self.ChapterEndAward[v.i_task.sid] then
            local res = self:CheckChapterEndTaskState(v.i_task.state)
            if res then
                self:GetCurAfkChapterEndAward(v.i_task.sid, 1)
            end
        end
    end
end

---获取显示ID
---@param data achieve.s2c_achieve_info 成就信息
---@param id number 成就id
function ActiveTaskManager:GetId(data, id)
    local finishInd = -1
    if data.finish_achieve ~= nil then
        for k, taskid in pairs(data.finish_achieve) do
            if taskid == id then
                finishInd = k
            end
        end
    end
    if finishInd ~= -1 then
        local cfg = _G.ConfigManager.mission_cfg[id]
        if cfg.re_sid > 0 then
            return self:GetId(data, cfg.re_sid)
        else
            return nil
        end
    else
        return id
    end
end

---整理服务器数据
---@param data achieve.s2c_achieve_info 成就信息
---@param id number 成就id
function ActiveTaskManager:SetServerInfo(data, id)
    local endId = self:GetId(data, id)
    if endId then
        local endValue
        if data.get_achieve ~= nil then
            for _, value in pairs(data.get_achieve) do
                if endId == value then
                    endValue = {
                        sid = endId,
                        state = _G.TaskEnum.ETaskState.Submited,
                        target = {
                            [1] = 0
                        }
                    }
                    break
                end
            end
        end
        if endValue then
            local CjTaskData = require("CjTaskData").New(endValue, self.taskCompletedFun, _G.MarkTaskType.Achieve)
            table.insert(self.tasks, CjTaskData)
        else
            local task = {
                sid = endId,
                state = _G.TaskEnum.ETaskState.Claimed,
                target = {
                    [1] = 0
                }
            }
            local CjTaskData = require("CjTaskData").New(task, self.taskCompletedFun, _G.MarkTaskType.Achieve)
            table.insert(self.tasks, CjTaskData)
        end
    end
end

function ActiveTaskManager:AddTask(task)
    local CjTaskData = require("CjTaskData").New(task, self.taskCompletedFun, _G.MarkTaskType.Achieve)
    table.insert(self.tasks, CjTaskData)
end

---成就信息
---@param data achieve.s2c_achieve_info 成就信息
function ActiveTaskManager:ParseDatas(data)
    self.dataA = data
    self.dataB = {}

    for _, value in pairs(data.collector) do
        local s = value.key[1]
        self.dataB[s] = value.value
    end
    self.GetCjPointLevel = data.finish_lv
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.AchievementBadge.id)
    self:ParseData(self)
end

function ActiveTaskManager:GetLevel()
    self.PointNum = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.ResProp, _G.ResPropID.ActiveAch)
    local exp = 0
    local lv = 0
    local curExp = 0
    local maxExp = 0
    for i = 1, #_G.ConfigManager.ach_stage_cfg do
        local item = _G.ConfigManager.ach_stage_cfg[i]
        exp = exp + item.chapter
        if self.PointNum == exp then
            if i == #_G.ConfigManager.ach_stage_cfg then
                lv = i
                curExp = exp
                maxExp = exp
            else
                lv = i
                curExp = self.PointNum
                maxExp = exp
            end
            break
        elseif self.PointNum < exp then
            lv = i - 1
            curExp = self.PointNum
            maxExp = exp
            break
        else
            if i == #_G.ConfigManager.ach_stage_cfg then
                lv = i
                curExp = exp
                maxExp = exp
            end
        end
    end
    return lv, curExp, maxExp
end

