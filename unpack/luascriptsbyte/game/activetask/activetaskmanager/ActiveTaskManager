---创建对象时,入口构造函数
function ActiveTaskManager:__init()
    self.curFunctionOpenID = _G.FunctionID.ActiveTask
    self.initFunc = {}
    --- 累计循环活跃值 (递增)
    self.all_liveness = 0
    --- 循环活跃奖励进度  1 可领取
    self.award_state = nil

    local cfg = _G.ConfigManager.discrete_cfg[103301]
    local parameters
    if cfg ~= nil then
        parameters = cfg
    end
    --- 累计循环活跃值 (递增)
    self.all_livenessDic = {
        --- 每达到  100
        value = parameters[1][1],
        --- 奖励组  12#30
        award = parameters[2]
    }

    --- 活跃值
    self.ActiveValue = 0
    --- 宝箱状态
    ---@type _G.ActiveTaskBoxType[]
    self.Box_status = {}

    --- 任务
    ---@type ActiveTaskBase[]
    self.tasks = {}

    --- 宝箱Sid配置
    self.Box_BoxSid = {}

    --- 成就任务获取与否all_liveness
    self.IsGetAchieveData = false

    ---成就点数
    self.PointNum = 0

    ---成就点数等级
    self.GetCjPointLevel = 0

    --- 每日活跃  阈值
    -- [1] = 20,
    -- [2] = 40,
    -- [3] = 60,
    -- [4] = 80,
    -- [5] = 100
    self.ActiveTaskBoxValue = {}
    ---@param value active_reward_cfg
    for _, value in pairs(_G.ConfigManager.active_reward_cfg) do
        self.ActiveTaskBoxValue[value.grade] = value.value_active
    end

    for key, _ in pairs(self.ActiveTaskBoxValue) do
        self.Box_status[key] = _G.ActiveTaskBoxType.Invalid
    end

    ---任务完成 刷新界面
    self.taskCompletedFun = _G.handler(self, self.TaskCompleted)

    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.ResUpdata, self)

    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.GetDataFormServer, self)
    _G.Events:GetInstance():AddListener(_G.GlobalEvents.GlobalResetGame, self.OnEvent_ResetGame, self)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIShow, self.UpdataOnUIShow, self)

    _G.SDKManager:GetInstance():AddListener(SDKDef.GetMsg.onShareAppMessage, self.ShareSuccess, self)
end

