---@param data award.i_award_item[]
function ActiveTaskManager:ResUpdata(data)
    for _, value in pairs(data) do
        local sid = value.type[1]

        if sid == _G.ResPropID.ActiveValue then
            -- body
            local _, storageId = _G.StorageManager:GetInstance():CheckSidType(sid)

            local activenum = _G.StorageManager:GetInstance():GetItemCountByID(storageId, _G.ResPropID.ActiveValue)
            if activenum ~= nil then
                self.ActiveValue = activenum
                self:UpdataBoxStauts()
            end
            break
        elseif sid == _G.ResPropID.ActiveAch then
            self:UpdataView()
        end
    end
end

function ActiveTaskManager:UpdataAllLiveness(AddNum)
    self.all_liveness = self.all_liveness + AddNum
    self.award_state = nil

    if self.all_liveness >= (self.all_livenessDic.value) then
        self.award_state = 1
    end
    _G.Events:GetInstance():Broadcast(_G.BattlePassExpEvents.BPActive, AddNum)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.DailyBigBOX.id)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.Active.id)
end

