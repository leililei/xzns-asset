---@param  task task.i_task
function ActiveTaskManager:UpdataTask(task)
    local isUpdata = false
    if task == nil or task.sid == nil then
        return isUpdata
    end
    local mTask = self:GetTaskByTaskid(task.sid)
    if mTask == nil then
        return isUpdata
    end
    mTask:UpdataData(task)

    return true
end

function ActiveTaskManager:GetTaskByTaskid(taskid)
    for i = 1, #self.tasks do
        if self.tasks[i].i_task.sid == taskid then
            return self.tasks[i]
        end
    end

    return nil
end

