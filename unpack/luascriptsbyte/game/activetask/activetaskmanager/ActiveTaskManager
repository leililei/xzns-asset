function ActiveTaskManager:CheckTaskTarget(task, taskData)
    if _G.ActiveTaskEnum.ConditionEnum.CumulativeLogin.specifiedTime == task[1] then
        --指定时间段登录
        local starSecond = task[2]
        local endSecond = task[3]
        local notSecond = _G.TimeUtil.GetSecondsOfDayOf6Hour()
        if notSecond >= starSecond and notSecond <= endSecond then
            return true
        end
    elseif _G.ActiveTaskEnum.ConditionEnum.CumulativeLogin.dayAfter == task[1] then
        --指定接取任务后几天登录
        local nowSecond = _G.TimeUtil.GetServerUnixTime()
        local starSecond = (task[2] - 1) * 86400 + _G.TimeUtil.GetDayBySix(taskData.getTime)
        if nowSecond >= starSecond then
            return true
        end
    elseif _G.ActiveTaskEnum.ConditionEnum.Section.SectionPass == task[1] then
        --副本是否通关
        local id = task[2]
        if _G.GlobalConditionManager.CheckCondition(2, id) then
            return true
        end
    elseif _G.ActiveTaskEnum.ConditionEnum.Section.CompleteTargetEvent == task[1] then
        -- 完成目标事件
        local id = task[2]
        if _G.GlobalConditionManager.CheckCondition(10, id) then
            return true
        end
    elseif _G.ActiveTaskEnum.ConditionEnum.AFK.IsPass == task[1] then
        ---该放置关卡是否过关
        local id = task[2]

        if _G.GlobalConditionManager.CheckCondition(4, id) then
            return true
