function ActiveTaskView:OnCreate(Data)
    if Data ~= nil then
        self.call = Data.call
        self.ShowViewType = Data.ShowViewType
    end
    self.activePanelLua = {
        [PanelType.Achievement] = "ActiveAchievementPanel",
        [PanelType.DailyTask] = "ActiveDailyTaskPanel",
        [PanelType.BattlePass] = "ActiveBattlePassPanel"
    }
    if _G.AppSetting.IsXzns then
        self.activePanelPrefabs = {
            [PanelType.Achievement] = "UIH5_xzns/Task/$_obj_cj",       --成就
            [PanelType.DailyTask] = "UIH5_xzns/Task/$_obj_hy",         --每日任务
            [PanelType.BattlePass] = "UIH5_xzns/Task/$_obj_battlePass" --战令
        }
    else
        self.activePanelPrefabs = {
            [PanelType.Achievement] = "UIH5/Task/$_obj_cj",       --成就
            [PanelType.DailyTask] = "UIH5/Task/$_obj_hy",         --每日任务
            [PanelType.BattlePass] = "UIH5/Task/$_obj_battlePass" --战令
        }
    end
    self.activePanelList = {}

    local bpId = require("CycleBattlePassModel").BattlePassIDEnum.Talent
    local bpUnlock = require("CycleBattlePassModel"):GetInstance():CheckSingleIsOpen(bpId)
    self.go_table.aorbtn_zhanling:SetActiveE((not _G.AppSetting.IsArraigned and bpUnlock) and 1 or 0)

    _G.DelayFrameDo(
        function()
            self:ChooseType(PanelType.DailyTask)
            self:SetData(Data)
        end
    )
    self:ShowTransitionGuidedBtn()
end

---@protected
function ActiveTaskView:ShowTransitionGuidedBtn()
    local activity = require("ActivitySynManager"):GetInstance():GetActivityWithTypeId(10081)
    if activity then
        local isOpen = activity:GetActivityTypeCls():CheckOpen()
        if isOpen == true then
            local index = activity:GetActivityTypeCls():GetOpenIndex()
            self.go_table.aorbtn_transitionGuided:SetActiveE(tonumber(index) == 1 and 1 or 0)
            if tonumber(index) == 1 then
                local tb = _G.GetAutoGoTable(self.go_table.aorbtn_transitionGuided)
                local icon, _ = activity:GetShowBtnInfo()
                tb.aorimage_icon.SpriteName = icon

                -- local redpointManager = require("RedPointManager"):GetInstance()

                -- redpointManager:AddRedPointChild(
                --     1021,
                --     activity:GetActivityTypeCls():GetRedpointIDByIndex(1)
                -- )

                tb.obj_redpointJi:UpdateRedPointItemIDAndParam(
                    activity:GetActivityTypeCls():GetRedpointIDByIndex(1),
                    -1
                )
            end
        end
    end
end

function ActiveTaskView:CheckGiftView()
    if self.activePanelList[PanelType.Achievement] then
        self.activePanelList[PanelType.Achievement]:CheckGiftView()
    end
end

------@param Data  params_ActiveTaskView
function ActiveTaskView:SetData(Data)
    self.IsItemMove = true
    self:InitView()
    self.IsItemMove = false
    if self.ShowViewType ~= nil then
        if self.ShowViewType == PanelType.DailyTask then
            -- elseif self.ShowViewType == 2 then
            --     self.clickFunction["$_aorbtn_adventure"](self)
            self.clickFunction["$_aorbtn_dailyTask"](self)
        elseif self.ShowViewType == PanelType.Achievement then
            self.clickFunction["$_aorbtn_achievement"](self)
        elseif self.ShowViewType == PanelType.BattlePass then
            self.clickFunction["$_aorbtn_zhanling"](self)
        end
    end
end

