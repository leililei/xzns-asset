function ActiveTaskView:HelpOnClick()
    local id = self.UIinfoCfg.helpId[self.TypeMission]
    if id == nil then
        id = self.UIinfoCfg.helpId[1]
    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, id)
end

---按钮点击事件在这里派发
function ActiveTaskView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
end

return ActiveTaskView
