---刷新界面
function ActiveTaskView:InitView()
    --("ActiveTaskView:InitView ----+++++++--")
    ---标记当前界面正在刷新 防止一次完成过多任务界面 频繁刷新
    if self.IsInitViewIng == true then
        self.IsNextInit = true
        return
    end
    --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ShadowTopView.Name)
    self.IsInitViewIng = true
    self.SuaXing = _G.TimerManager:GetInstance():GetTimer(4, self.IsInitViewIngFun, self, true, true)
    self.SuaXing:Start()
end

---延迟刷新逻辑
function ActiveTaskView:IsInitViewIngFun()
    if self.activePanelList[self.TypeMission] then
        self.activePanelList[self.TypeMission]:RefreshView()
    end
    self.IsInitViewIng = false
    --_G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ShadowTopView.Name)
    if self.IsNextInit == true then
        self.IsNextInit = false
        self:InitView()
    end
end

