local ActiveTaskView = _G.BaseClass("ActiveTaskView", _G.UIBaseView)

local PanelType = {
    DailyTask = 1,
    Achievement = 2,
    BattlePass = 3
}

function ActiveTaskView:ChooseType(type)
    self.TypeMission = type
    self.ItemDataAll_Index = 0

    if not self.activePanelList[type] then
        self.isLoadPanel = true
        _G.PoolsManager:GetInstance():Spawn(
            self.activePanelPrefabs[type],
            _G.ePoolType.Temporary,
            self.go_table.obj_panel,
            function(tran)
                if tran == nil then
                    if _G.AppSetting.DEBUG then
                        _G.LogError("ActiveAchievementPanel加载预制体失败")
                    end
                    return
                end
                if self:IsNil() then
                    _G.DestroyObject(tran)
                    return
                end
                self.activePanelList[type] = self:AddComponent(
                    tran, require(self.activePanelLua[type]).New(tran, type, self)
                )
                self.activePanelList[type]:RefreshView()
                self:ShowPanel()
                self.isLoadPanel = false
            end
        )
    else
        self:ShowPanel()
    end

    -- self.go_table.obj_hy:SetActiveE(type == 1 and 1 or 0)
    -- self.go_table.obj_cj:SetActiveE(type == 2 and 1 or 0)

    self.DailyGoTable.aorimage_TaskRed:SetActiveE(type == PanelType.DailyTask and 1 or 0)
    self.DailyGoTable.aorimage_TaskBlack:SetActiveE(type ~= PanelType.DailyTask and 1 or 0)
    -- self.DailyGoTable.aortext_text.color = self.chooseBtnColor[type == 1 and 1 or 2]

    self.AchieveGoTable.aorimage_TaskRed:SetActiveE(type == PanelType.Achievement and 1 or 0)
    self.AchieveGoTable.aorimage_TaskBlack:SetActiveE(type ~= PanelType.Achievement and 1 or 0)

    self.BattlePassGoTable.aorimage_TaskRed:SetActiveE(type == PanelType.BattlePass and 1 or 0)
    self.BattlePassGoTable.aorimage_TaskBlack:SetActiveE(type ~= PanelType.BattlePass and 1 or 0)
    -- self.AchieveGoTable.aortext_text.color = self.chooseBtnColor[type == 2 and 1 or 2]

    -- self.AdventureGoTable.aortext_text.color = self.chooseBtnColor[type == 3 and 1 or 2]
end

function ActiveTaskView:ShowPanel()
    for k, v in pairs(self.activePanelList) do
        if k == self.TypeMission then
            v:Show()
        else
            v:Hide()
        end
    end
end

