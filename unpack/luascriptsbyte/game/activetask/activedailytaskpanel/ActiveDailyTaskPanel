function ActiveDailyTaskPanel:PanDuanYiJina()
    local canGets = {}

    for i = 1, #self.MyTask do
        local task = self.MyTask[i]
        local canget = false
        if task.i_task.state == _G.TaskEnum.ETaskState.Submited then
            canget = true
        end
        if canget then
            _G.table.insert(canGets, task.i_task.sid)
        end
