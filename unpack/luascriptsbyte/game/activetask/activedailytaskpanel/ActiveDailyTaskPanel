end

function ActiveDailyTaskPanel:ShowBigBoxItems()
    ---@type discrete_cfg
    local cfg = _G.ConfigManager.discrete_cfg[103301]
    if cfg == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(string.format("ActiveTaskView:ShowBigBoxItems 未找到配置 discrete_cfg[103301]"))
        end
        return
    end
    self.NowShowIndex = 99
    local NowItems = cfg[2]

    for i = 1, 1 do
        local sid = NowItems[i]
        i = i + 1
        local num = NowItems[i]
        _G.StorageManager:GetInstance():GetItemBaseView(
            sid,
            num,
            self.go_table.obj_bigBox,
            function(item)
                item.gameObject:SetLocalScaleXYZ(0.6)
                item.gameObject:SetActiveE(1)
                item:ShowItemCard(self.taskManager.award_state == 1)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end,
            function(go, isOn)
                if self.taskManager.award_state == 1 then
                    self:Btn_LoopGetClick()
                else
                    require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, sid)
                end
            end
        )
    end
end

function ActiveDailyTaskPanel:Btn_LoopGetClick()
    local loopValue = self.taskManager.all_liveness
    local loopValue_Max = self.taskManager.all_livenessDic.value
    local isGet = loopValue >= loopValue_Max
    if isGet then
        require("TaskNet"):GetInstance():DailyTask_AllLive_Finish(
            function(data)
                _G.StorageManager:GetInstance():ReceiveAwardData(data)
                _G.PopWindowManager:GetInstance():AddAwardPopQuene(data)

                self.taskManager:UpdataAllLiveness(
                    -(_G.Mathf.Floor(self.taskManager.all_liveness / self.taskManager.all_livenessDic.value) * 100)
                )

                self:InitView_ActiveTask()
            end
        )
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(360105)
    end
end

function ActiveDailyTaskPanel:SetBoxStatus()
    local Box_status = self.taskManager:GetBoxStatus()

    for boxIndex, value in pairs(Box_status) do
        ---@type AorRawImage 变量名
        local boxImage = self.go_table["aorrawimage_box" .. boxIndex]
        local anim = boxImage:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
        -- 防止宝箱摇摆不整齐，统一取消动画，然后设置旋转，再开启
        anim.enabled = false
        if boxImage ~= nil then
            boxImage:LoadImage(self.UIinfoCfg.boxStatusImagePath[value][boxIndex])
            boxImage:SetRotationToIdentity()
            boxImage:SetGray(value == _G.ActiveTaskBoxType.Claimed)
        end
        if value == _G.ActiveTaskBoxType.WaitClaim then
            anim.enabled = true
            anim:Play("ani_shikongzhimenbaoxiang", 0, 0)
        end
        --- 初始化 宝箱红点参数
        if self.Red_BoxInit == nil then
            local name = "obj_Redbox (" .. boxIndex .. ")"
            if self.go_table[name] then
                self.go_table[name]:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.DailyBox.id, boxIndex)
            end
        end
    end
    self.Red_BoxInit = true
end

function ActiveDailyTaskPanel:SetActiveNumText()
    local len = #self.taskManager.ActiveTaskBoxValue
    for i = 1, len do
        self.go_table["aortext_active" .. i].text = tostring(self.taskManager.ActiveTaskBoxValue[i])
    end
end

function ActiveDailyTaskPanel:SetActiveValue()
    local v = self.taskManager.ActiveValue
    self.go_table.aortext_nowActive.text = _G.tostring(v)
    self:SetActiveSchedule(v)
end

function ActiveDailyTaskPanel:SetActiveSchedule(v)
    local num
    local w = v / self.taskManager.ActiveTaskBoxValue[_G.table.count(self.taskManager.ActiveTaskBoxValue)]
    if w > 1 then
        w = 1
    end
    num = w * 476
    if num >= 476 then
        num = 476
    end
    self.go_table.aorimage_activeSchedule:SetRectTransformSize(num, 21)
end

function ActiveDailyTaskPanel:Btn_TaskClick(go, num)
    local name = go.aorbtn_get:GetName()
    local taskid = tonumber(name)
    if taskid == nil then
        return
    end
    self.ItemDataAll_Index = num
    local task = self.taskManager:GetTaskByTaskid(taskid)
    if task == nil or not self.JianGe then
        return
    end
    if task.i_task.state == _G.TaskEnum.ETaskState.Claimed then
        if not _G.string.IsNullOrEmpty(task.Cfg.link) then
            _G.JumpManager:GetInstance():Jump(task.Cfg.link)
            return
        end
    elseif task.i_task.state ~= _G.TaskEnum.ETaskState.Submited then
        return
    end
    self.JianGe = false
    self:GetOneKey()
end

function ActiveDailyTaskPanel:GetOneKey()
    local taskSids = {}
    local activeSids = {}
    local taskDatas = {}
    if self.yijianlingqupanduan then
        return
    end
    if not self.MyTask then
        return
    end
    for _, task in pairs(self.MyTask) do
        if task.i_task.state == _G.TaskEnum.ETaskState.Submited then
            _G.table.insert(taskSids, task.i_task.sid)
            _G.table.insert(taskDatas, task)
        end
    end
    local increaseActiveValue = 0
    for _, sid in pairs(taskSids) do
        --self.Manager:UpdataAllLiveness(_G.ConfigManager.mission_cfg[value].reward[1][2])
        increaseActiveValue = increaseActiveValue + _G.ConfigManager.mission_cfg[sid].reward[1][2]
    end
    --记录活跃值
    local beforeActive = self.Manager.ActiveValue
    local newActiveValue = self.Manager.ActiveValue + increaseActiveValue

    if #taskSids + #activeSids > 0 then
        local myTask = self.MyTask
        self.yijianlingqupanduan = true
        for i = 1, #taskSids do
            _G.DelayDo(
                0.1 * i,
                function()
                    taskDatas[i].i_task.state = _G.TaskEnum.ETaskState.Claimed
                    self:SortMyTask()
                    self.go_table.scrollloopvectical_Group:UpdateAllItem()
                    if i == #taskSids then
                        require("TaskNet"):GetInstance():One_key_Finish(
                            {sids = taskSids, asids = activeSids},
                            function(data)
                                --请求错误
                                if data.err_task and data.err_task[1] then
                                    _G.PopWindowManager:GetInstance():ShowAllTips(data.err_task[1].ack)
                                    self.yijianlingqupanduan = false
                                    return
                                end
                                --数据已刷新(6点自动刷新)
                                if not myTask or myTask ~= self.MyTask then
                                    self.yijianlingqupanduan = false
                                    return
                                end

                                for _, sid in pairs(taskSids) do
                                    self.Manager:UpdataAllLiveness(_G.ConfigManager.mission_cfg[sid].reward[1][2])
                                    require("SuperValuGiftModel"):GetInstance():UpdataDayLiveness(
                                        _G.ConfigManager.mission_cfg[sid].reward[1][2]
                                    )
                                    --num = num + _G.ConfigManager.mission_cfg[value].reward[1][2]
                                end
                                local dataitem = {}
                                dataitem.award = {}
                                dataitem.award.item = {}
                                --更新礼盒UI状态
                                self.Manager.ActiveValue = newActiveValue
                                -- for _, value in pairs(activeSids) do
                                --     boxStatus[value - 100] = _G.ActiveTaskBoxType.Claimed
                                -- end

                                if data ~= nil and data.tasks ~= nil then
                                    -- body

                                    for i = 1, #data.tasks do
                                        self:UpdateMangerTasks(data.tasks[i])
                                    end
                                end
                                _G.StorageManager:GetInstance():ReceiveAwardData(data)

                                _G.PopWindowManager:GetInstance():AddAwardPopQuene(data)
                                --self:InitView()
                                self:JianGeGuanBi()
                                -- require("ActiveTaskManager"):GetInstance():UpdataBoxStauts()
                                require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
                                    _G.ConfigManager.redpoint_cfg.DailyTaskPage.id
                                )
                                require("RedPointManager"):GetInstance():RefreshNode(
                                    _G.ConfigManager.redpoint_cfg.NoviceGiftPack.id
                                )
                                require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
                                    _G.ConfigManager.redpoint_cfg.FirstStore.id
                                )
                                self.Manager:CheckDaliyFinishAll()
                                self.yijianlingqupanduan = false

                                --上报游戏行为
                                if beforeActive < 60 and newActiveValue >= 60 then
                                    beforeActive = newActiveValue
                                    _G.SDKManager:GetInstance():GameAction(SDKDef.GameAction.DailyTask60, newActiveValue)
                                end
                                _G.Events:GetInstance():Broadcast(_G.FunctionOpenDailyCheckEvent.DailyActive)
                            end
                        )
                        self.yijianlingqupanduan = true
                    end
                end
            )
        end
    else
        --todo 加提示
        --("无奖励可领取")
        _G.PopWindowManager:GetInstance():ShowAllTips(400102)
    end
end

-- ---@param data task.i_task 中文描述
function ActiveDailyTaskPanel:UpdateMangerTasks(data)
    local cfg = _G.ConfigManager.mission_cfg[data.sid]
    if cfg.re_sid > 0 then
        for i = 1, #self.Manager.tasks do
            if self.Manager.tasks[i].i_task.sid == data.sid then
                table.remove(self.taskManager.tasks, i)
                break
            end
        end
        local task = {
            sid = cfg.re_sid,
            state = _G.TaskEnum.ETaskState.Claimed,
            target = data.target
        }
        self.taskManager:AddTask(task)
    else
        self.taskManager:UpdataTask(data)
    end
end

function ActiveDailyTaskPanel:ShowItems(Index, isGou)
    if Index == self.NowShowIndex and self.go_table.aorbtn_TipsView:GetActiveSelf() == 1 then
        self.go_table.aorbtn_TipsView:SetActiveE(0)
        return
    end

    -- _G.CS.UnityEditor.EditorApplication.isPaused = true;
    ---@type AorButton
    local btn = self.go_table[self.UIinfoCfg.Box_Btnstr .. Index]
    if btn ~= nil then
        local x, y, z = btn:GetPosition()
        self.go_table.obj_ItemTips:SetPosition(x, y, z)
    end

    local cfg = _G.ConfigManager.active_reward_cfg[self.taskManager.Box_BoxSid[Index]]
    if cfg == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(string.format("ActiveTaskView:ShowItems 未找到配置 boxIndex:%d", Index))
        end
        return
    end
    self.NowShowIndex = Index
    local NowItems = _G.DeepCopyCfgTable(cfg.reward)
    local award =
        require "PrivilegeManager":GetInstance():GetPrivilegeDataNew({_G.PrivilegeType.ActiveTask.Box, cfg.id})
    if not _G.table.isEmptyOrNil(award) then
        local tb = {}
        for _, v in pairs(award) do
            tb[v[3]] = {v[3], v[4]}
            tb[v[3]].isPri = true
        end
        for _, v in pairs(NowItems) do
            if tb[v[1]] then
                v[2] = v[2] + tb[v[1]][1]
                tb[v[1]] = nil
            end
        end
        for _, v in pairs(tb) do
            _G.table.insert(NowItems, v)
        end
    end

    if self.go_table.aorbtn_TipsView:GetActiveSelf() == 0 then
        self.go_table.aorbtn_TipsView:SetActiveE(1)
    end

    self.go_table.obj_Parent:ClearChildren()
    for i = 1, #NowItems do
        local info = NowItems[i]
        local num = info[2]
        self:CareatItem(
            info,
            isGou,
            self.go_table.obj_Parent,
            function(item)
                item.gameObject:SetRectTransformSize(88, 88)
                item.gameObject:SetLocalScaleXYZ(0.6)
            end
        )
    end
    ---@type UnityEngine.RectTransform
    -- local rect =  self.go_table.obj_itemBg:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    self.go_table.obj_itemBg:SetRectTransformSize((#NowItems) * 75, 80)
    self.go_table.obj_ItemTips:SetRectTransformSize((#NowItems) * 75, 80)
    _G.UIUtils.SetOffScreenRectPosition(self.go_table.obj_ItemTips)
end

function ActiveDailyTaskPanel:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        if go == self.go_table.aorbtn_TipsView then
            if self.NowShowIndex == nil then
                return
            end
            self:ShowItems(self.NowShowIndex, false)
        end
    end
end

---销毁对象时,析构函数
function ActiveDailyTaskPanel:OnDestroy()
    base.OnDestroy(self)
end

return ActiveDailyTaskPanel
