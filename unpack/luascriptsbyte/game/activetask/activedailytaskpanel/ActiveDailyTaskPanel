local base = require("ActivePanelBase")
local SDKDef = require("SDKDef")

---@class ActiveDailyTaskPanel : ActivePanelBase	中文描述
local ActiveDailyTaskPanel = _G.BaseClass("ActiveDailyTaskPanel", base)

function ActiveDailyTaskPanel:Awake()
    self.taskManager = require("ActiveTaskManager"):GetInstance()
    self.go_table.scrollloopvectical_Group:InitItemData(0, _G.handler(self, self.RefreshList))
    local len = #self.taskManager.ActiveTaskBoxValue
    for i = 1, len do
        self.clickFunction["@_" .. self.UIinfoCfg.Box_Btnstr .. i] = _G.handlerbind(self, self.Btn_BoxClick, i)
    end
end

function ActiveDailyTaskPanel:Btn_BoxClick(_, go, isOn, go_name, Index)
    local Box_status = self.taskManager:GetBoxStatus()
    local status = Box_status[Index]
    if status == _G.ActiveTaskBoxType.Claimed then
        self:ShowItems(Index, true)
    elseif status == _G.ActiveTaskBoxType.Invalid then
        self:ShowItems(Index, false)
    elseif status == _G.ActiveTaskBoxType.WaitClaim then
        local GetAwardBoxList = {}
        for k, v in pairs(Box_status) do
            if v == _G.ActiveTaskBoxType.WaitClaim then
                _G.table.insert(GetAwardBoxList, k)
            end
        end
        if #GetAwardBoxList > 0 then
            self:GetBoxReward(GetAwardBoxList, {award = {item = {}}})
        end
    end
end

function ActiveDailyTaskPanel:GetBoxReward(Box_status, data)
    if _G.table.count(Box_status) > 0 then
        local status = _G.table.remove(Box_status)
        local boxSid = self.taskManager:GetBoxRewardSid(status)
        require("TaskNet"):GetInstance():DailyTask_Box(
            {sid = boxSid},
            function(msg)
                if msg.ack ~= 1 then
                    _G.LogError("日常领取宝箱奖励失败,ack:" .. msg.ack)
                    return
                end
                self.taskManager:SetBoxStatus(status, _G.ActiveTaskBoxType.Claimed)
                self.taskManager:UpdataBoxStauts()
                _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2012)
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.table.insertto(data.award.item, msg.award.item, 0)
                self:GetBoxReward(Box_status, data)
            end
        )
    else
        self.taskManager:UpdataBoxStauts()
        _G.PopWindowManager:GetInstance():AddAwardPopQuene(data)
    end
end

function ActiveDailyTaskPanel:RefreshView()
    if self.go_table == nil then
        return
    end
    self:GetTaskData()
    local count = #self.MyTask
    if self.loopCount ~= count then
        self.go_table.scrollloopvectical_Group:UpdateCount(count)
    else
        self.go_table.scrollloopvectical_Group:UpdateAllItem()
    end
    self.loopCount = count
    self:PanDuanYiJina()
    self:InitView_ActiveTask()
end

function ActiveDailyTaskPanel:RefreshList(index, listView)
    if index < 0 then
        return
    end
    _G.DelayFrameDo(
        function()
            self:ItemsInit(index + 1, listView)
        end
    )
    return listView
end

