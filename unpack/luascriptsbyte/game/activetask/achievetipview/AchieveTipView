local AchieveTipManager = require("AchieveTipManager")

---@class AchieveTipView : UIBaseView	中文描述
---@field public go_table AchieveTipView_GoTable GoTable
local AchieveTipView = _G.BaseClass("AchieveTipView", _G.UIBaseView)

function AchieveTipView:Awake()
    AchieveTipManager:GetInstance():SetView(self)
end

---界面的入口函数
function AchieveTipView:OnCreate(cfg)
    self.queue = {}
    self:Add(cfg)
    self:ShowNext()
end

--region 对外接口
function AchieveTipView:Add(cfg)
    _G.table.insert(self.queue, cfg)
end

function AchieveTipView:ShowNext()
    if self:IsNil() then
        return
    end
    if #self.queue == 0 then
        self:Close()
        return
    end
    self.go_table.obj_bg:SetActiveE(0)
    self.go_table.obj_bg:SetActiveE(1)
    ---@type mission_cfg
    local cfg = _G.table.remove(self.queue, 1)
    self.go_table.aorimage_icon.SpriteName = cfg.icon[1]
    self.go_table.aortext_des.text = _G.GetLangPackValue(_G.tonumber(cfg.icon[2]))
    _G.DelayDo(3, _G.handler(self, self.ShowNext))
end

function AchieveTipView:OnDestroy()
    AchieveTipManager:GetInstance():SetView(nil)
end

--endregion
return AchieveTipView
