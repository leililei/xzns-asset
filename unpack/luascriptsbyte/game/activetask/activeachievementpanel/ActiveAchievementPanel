function ActiveAchievementPanel:GetOneKey()
    local taskSids = {}
    if self.yijianlingqupanduan then
        return
    end
    if not self.MyTask then
        return
    end
    self.yijianlingqupanduan = true
    for _, task in pairs(self.MyTask) do
        if task.i_task.state == _G.TaskEnum.ETaskState.Submited then
            _G.table.insert(taskSids, task)
        end
    end
    if #taskSids > 0 then
        self.corT = {}
        for i = 1, #taskSids do
            self.corT[i] = _G.DelayDo(
                0.1 * i,
                function()
                    if self ~= nil and self.go_table then
                        taskSids[i].i_task.state = _G.TaskEnum.ETaskState.Claimed
                        self:SortMyTask()
                        self.go_table.scrollloopvectical_Group2:UpdateAllItem()
                        if i == #taskSids then
                            self.Manager:HuoQuShuJu(
                                _G.handler(self.viewLua, self.viewLua.AchGetSuccessCall),
                                _G.handler(self.viewLua, self.viewLua.InitView) --刷新UI视图
                            )
                            self.yijianlingqupanduan = false
                        end
                    end
                end
            )
        end
    else
        --todo 加提示
        --("无奖励可领取")
        _G.PopWindowManager:GetInstance():ShowAllTips(400102)
        self.yijianlingqupanduan = false
    end
end

function ActiveAchievementPanel:YingChangtuoWeo(data)
    self.go_table.obj_tuoWeo:SetActiveE(0)
    if data.sids == nil then
        data.sids = {}
    end
    for key, value in pairs(data.sids) do
        self.taskManager:UpdateMangerTasks(value)
    end

    _G.StorageManager:GetInstance():ReceiveAwardData(data)
    _G.PopWindowManager:GetInstance():AddAwardPopQuene(data)

    self:SetAch()
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.AchievementPage.id)
    self:RefreshView()
end

function ActiveAchievementPanel:OnClickBtn(go)
    ---跳转到VIP界面
    if go == self.go_table.aorbtn_jump then
        -- _G.JumpManager:GetInstance():Jump(176001)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MallView.Name, _G.MallViewPage.vip)
    end
end

---销毁对象时,析构函数
function ActiveAchievementPanel:OnDestroy()
    if self.TiemcurtuoWeo ~= nil then
        self.TiemcurtuoWeo:Stop()
    end
    self.corT = self.corT or {}
    local corNum = #self.corT
    for i = 1, corNum do
        if self.corT[i] ~= nil then
            _G.coroutine.stopwaiting(self.corT[i])
            self.corT[i] = nil
        end
    end
    base.OnDestroy(self)
end

return ActiveAchievementPanel
