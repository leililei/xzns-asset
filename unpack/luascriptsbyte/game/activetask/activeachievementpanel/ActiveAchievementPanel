local base = require("ActivePanelBase")
---@class ActiveAchievementPanel : Component	中文描述
local ActiveAchievementPanel = _G.BaseClass("ActiveAchievementPanel", base)

local GetLangPackValue = _G.GetLangPackValue
function ActiveAchievementPanel:Awake()
    self.JianGeTiem = 0
    self.go_table.scrollloopvectical_Group2:InitItemData(0, _G.handler(self, self.RefreshListCj))


    if not _G.AppSetting.IsXzns then
        self.go_table.aorimage_di:SetActiveE(_G.AppSetting.IsArraigned and 0 or 1)
    else
        self.go_table.aorrawimage_di:SetActiveE(_G.FunctionManager:GetInstance():CheckFunctionIsUnlock(FunctionID.MallVip) and 1 or 0)
    end
end

function ActiveAchievementPanel:Hide()
    self.go_table.gameObject:SetActiveE(0)
end

function ActiveAchievementPanel:Show()
    self.go_table.gameObject:SetActiveE(1)
    self:SetAch()
end

function ActiveAchievementPanel:RefreshView()
    if self.go_table == nil then
        return
    end
    self:GetTaskData()
    local count = #self.MyTask
    if self.loopCount ~= count then
        self.go_table.scrollloopvectical_Group2:UpdateCount(count)
    else
        self.go_table.scrollloopvectical_Group2:UpdateAllItem()
    end
    self.loopCount = count
    self:PanDuanYiJina()
end

--成就信息赋值
function ActiveAchievementPanel:SetAch()
    if _G.AppSetting.DEBUG then
        _G.Log("", "<color=red>" .. "已领等级" .. self.taskManager.GetCjPointLevel .. "</color>")
    end
    --self.go_table.obj_lingqu:SetActiveE(0)
    --    self.go_table.obj_feixing:SetActiveE(0)
    local lv = self.taskManager:GetLevel()
    require "PopUpGiftBagModel":GetInstance():IsAchievementTarget(lv)

    local model = require "VIPPrivilegeModel":GetInstance()
    local currentVipLevel = model.realVipLevel
    self.go_table.aortext_vipLv.text = _G.GetLangPackValue(90010100117, currentVipLevel)
    local palyer_vipinfo = model.all_player_vip[currentVipLevel]
    if currentVipLevel < model.vipmaxlevel then
        local cfg = _G.ConfigManager.player_vip_cfg[currentVipLevel + 1]
        local cur_exp = model.total_exp - palyer_vipinfo.max_exp
        if cur_exp <= 0 then
            cur_exp = 0
        end
        self.go_table.aortext_press.text = cur_exp .. "/" .. (cfg.exp - palyer_vipinfo.max_exp)
        self:CjSetLefJljd(self.go_table.aorimage_cjjd1, cur_exp, cfg.exp - palyer_vipinfo.max_exp)
        self:CjSetLefJljd(self.go_table.aorimage_cjjd2, cur_exp, cfg.exp - palyer_vipinfo.max_exp)
    else
        local cfg = _G.ConfigManager.player_vip_cfg[model.vipmaxlevel]
        self:CjSetLefJljd(self.go_table.aorimage_cjjd1, cfg.exp, cfg.exp)
        self:CjSetLefJljd(self.go_table.aorimage_cjjd2, cfg.exp, cfg.exp)
        self.go_table.aortext_press.text = GetLangPackValue(90000010282)
    end

    require("RedPointManager"):GetInstance():RefreshNode(
        _G.ConfigManager.redpoint_cfg.AchievementBadge.id
    )
end

---成就进度条显示
function ActiveAchievementPanel:CjSetLefJljd(aorimage_cjjd, value, loopValue_Max)
    local w = value / loopValue_Max
    if w > 1 then
        w = 1
    end
    aorimage_cjjd:SetRectTransformSize(value > 0 and w * (303) or 0, 15)
end

function ActiveAchievementPanel:CheckGiftView()
    local isUpLevel = require "VIPPrivilegeModel":GetInstance().isUpLevel
    local lastUpLevel = _G.PlayerPrefsManager.GetInt("LastUpVipLevel", 1)
    local currentVipLevel = require "VIPPrivilegeModel":GetInstance().currentVipLevel
    if isUpLevel or currentVipLevel > lastUpLevel then
        local popFuncItem = {}
        popFuncItem.DelFun = function()
            return not require "VIPPrivilegeModel":GetInstance().isUpLevel and
                require "VIPPrivilegeModel":GetInstance().currentVipLevel <=
                _G.PlayerPrefsManager.GetInt("LastUpVipLevel", 1)
        end
        popFuncItem.OpenViewFun = function()
            require "VIPPrivilegeModel":GetInstance():ChangeCurLevel(require "VIPPrivilegeModel":GetInstance().uplevel)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.VIPPrivilegeUpLevelView.Name)
        end
        _G.PopWindowManager:GetInstance():AddPopWindowQuene(popFuncItem, _G.PopViewShowOrder.VipLevelUp)
    end
end

--成就
function ActiveAchievementPanel:RefreshListCj(index, listView)
    if index < 0 then
        return
    end
    _G.DelayFrameDo(
        function()
            if self ~= nil then
                self:ItemsInit(index + 1, listView)
            end
        end
    )

    return listView
end

