function ActiveBattlePassPanel:UpdateTime(elapsed)
    self.countDown = self.countDown - elapsed
    if self.countDown < 0 then
        self.countDown = 0
    end
    if self.go_table == nil then
        return
    end
    local time = _G.Mathf.RoundToInt(self.countDown)
    self.go_table.aortext_countDown.text =
        GetLangPackValue(90028900002, _G.string.AddColor(_G.TimeUtil.TransDayHourMineMiao(time), "83e497"))
    self:UpdateAddBtnShow()
end

