function ActivePanelBase:GetTaskData()
    self.MyTask = {}
    for _, value in pairs(self.taskManager.tasks) do
        if value.Cfg.type_mission == self.typeMission then
            local isfunction_open = value.Cfg.function_open == 0
            if isfunction_open == false then
                isfunction_open = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(value.Cfg.function_open)
            end
            if isfunction_open then
                table.insert(self.MyTask, _G.DeepCopy(value))
            end
        end
    end
    self:SortMyTask()
end

function ActivePanelBase:SortMyTask()
    --- 按任务已完成奖励可领取>任务未完成>任务奖励已领取>配置表id（从小到大）的顺序进行排列
    table.sort(
        self.MyTask,
        function(a, b)
            --- 不同任务状态优先级
            local function sortState(state)
                if state == _G.TaskEnum.ETaskState.Submited then
                    return 10
                elseif state == _G.TaskEnum.ETaskState.Claimed then
                    return 9
                elseif state == _G.TaskEnum.ETaskState.Completed then
                    return 8
                end
                return 0
            end

            local aState = sortState(a.i_task.state)
            local bState = sortState(b.i_task.state)
            if aState ~= bState then
                return aState > bState
            end
            return a.i_task.sid < b.i_task.sid
        end
    )
end

