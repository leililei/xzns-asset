---@param  item UnityEngine.Transform
function ActivePanelBase:ItemsInit(taskIndex, item)
    taskIndex = taskIndex
    local task = self.MyTask[taskIndex]

    local gotable = _G.GetAutoGoTable(item)
    if item:GetctiveInHierarchy() == 0 then
        return
    end

    gotable.gameObject:SetName(task.Cfg.id)
    if self.IsItemMove then
        gotable.obj_node:SetAnchorPosition(0, -100, 0)
        gotable.obj_node:DOLocalMoveY(0, 0.15 * taskIndex)
    end
    --- 完成任务 按钮隐藏
    local btn_show = true
    --- 完成任务 任务条置灰
    local gray_show = false
    local isGet = false
    local stateStr = nil
    local stateColor = nil
    ---self.UIinfoCfg.taskinfo 索引
    local taskinfoIndex = 1
    if task.i_task.state == _G.TaskEnum.ETaskState.Claimed then
        stateStr = _G.LangUtil.GetLangPackValue(self.langIdDic.taskItemBtnText_go)
        local color = "EEC398"
        if _G.AppSetting.IsXzns then
            stateStr = _G.LangUtil.GetLangPackValue(90022200010)
            color = "ffffff"
            self.UIinfoCfg.taskinfo[taskinfoIndex].btnSpriteName = "ui_ty_kuang_01"
        end
        stateColor = _G.ColorTools.FormatColorByString(color)
    elseif task.i_task.state == _G.TaskEnum.ETaskState.Completed then
        --- 已完成
        stateStr = ""

        btn_show = false
        gray_show = true
        taskinfoIndex = 3
    elseif task.i_task.state == _G.TaskEnum.ETaskState.Submited then
        taskinfoIndex = 2
        stateStr = _G.LangUtil.GetLangPackValue(self.langIdDic.taskItemBtnText_get)
        local color = "8C2D14"
        if _G.AppSetting.IsXzns then
            self.UIinfoCfg.taskinfo[taskinfoIndex].btnSpriteName = "ui_ty_kuang_00"
        end
        stateColor = _G.ColorTools.FormatColorByString(color)
        isGet = true
    else
        stateStr = "state" .. task.i_task.state
    end
    local taskUicfg = self.UIinfoCfg.taskinfo[taskinfoIndex]

    -- --- 为0 默认显示
    -- local isfunction_open = task.Cfg.function_open == 0
    -- if isfunction_open == false then
    --     isfunction_open = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(task.Cfg.function_open)
    -- end

    gotable.aortext_text:SetActiveE(1)
    gotable.aorimage_get:SetActiveE(1)
    gotable.aorbtn_get:SetActiveE(1)

    if _G.AppSetting.IsXzns then
        gotable.aorimage_get:SetActiveE(1)
        if gotable.aorimage_noGet then
            gotable.aorimage_noGet:SetActiveE(0)
        end
    end

    --gotable.aortext_hyd.color = taskUicfg.hydColor
    if self.typeMission == 1 then
        gotable.aortext_hzExp:SetActiveE(1)
        gotable.aortext_hyd:SetActiveE(1)
        gotable.aortext_hyd.text = _G.LangUtil.GetLangPackValue(self.langIdDic.hydText)
        gotable.aortext_hzExp.text = task.Cfg.reward[1][2]
    else
        gotable.aortext_hzExp:SetActiveE(0)
    end
    gotable.aortext_info.text = _G.LangUtil.GetLangPackValue(task.Cfg.desc)

    local task1 = self:NumberToUnitStr_CardFightNum(task.i_task.target[1])

    local taskcount = self:NumberToUnitStr_CardFightNum(task.Cfg.count)
    gotable.aortext_jd.text = task1 .. "/" .. taskcount
    self:SetTaskItemjd(gotable.aorimage_jd, task.i_task.target[1], task.Cfg.count)
    --end

    if taskUicfg.btnSpriteName ~= nil then
        gotable.aorimage_get.SpriteName = taskUicfg.btnSpriteName
    end

    gotable.aorimage_get:SetActiveE(taskUicfg.btnSpriteName ~= nil and 1 or 0)
    gotable.aorimage_over:SetActiveE(taskUicfg.btnSpriteName == nil and 1 or 0)

    -- if taskUicfg.btnText ~= nil then
    --     gotable.aortext_text.text = taskUicfg.btnText
    -- end

    -- if taskUicfg.btntextcolor ~= nil then
    --     gotable.aortext_text.color = taskUicfg.btntextcolor
    -- end
    gotable.aortext_text.text = _G.tostring(stateStr)
    if stateColor then
        gotable.aortext_text.color = stateColor
    end
    gotable.aorbtn_get:SetActiveE(btn_show and 1 or 0)


    if gray_show then
        local task11 = self:NumberToUnitStr_CardFightNum(task.i_task.target[1])
        local taskcount1 = self:NumberToUnitStr_CardFightNum(task.Cfg.count)
        gotable.aortext_jd.text = task11 .. "/" .. taskcount1
        self:SetTaskItemjd(gotable.aorimage_jd, task.Cfg.count, task.Cfg.count)
    end
    -- 页面为成就，并且item没有达成领取条件
    if task.i_task.state == 1 and task.Cfg.link == 0 then
        gotable.aorimage_get.SpriteName = self.UIinfoCfg.taskinfo[2].btnSpriteName
        _G.UIUtils.SetBtnDark(gotable.aorimage_get, "cbcbcb")
        gotable.aortext_text.text = _G.LangUtil.GetLangPackValue(90022600043)
        gotable.aortext_text.color = _G.ColorTools.FormatColorByString("474747")
        gotable.aorbtn_get:SetActiveE(0)
        if not _G.AppSetting.IsXzns then
            gotable.aorimage_get:SetGray(true)
        else
            gotable.aorimage_get:SetActiveE(0)
            gotable.aorimage_noGet:SetActiveE(1)
        end
    else
        _G.UIUtils.SetBtnDark(gotable.aorimage_get, "ffffff")
        gotable.aorimage_get:SetGray(false)
    end
    local btnName = gotable.aorbtn_get:GetName()
    if _G.tonumber(btnName) == nil then
        gotable.aorbtn_get.onClick:AddListener(_G.handlerbind(self, self.Btn_TaskClick, gotable, taskIndex))
    end
    gotable.aorbtn_get:SetName(_G.tostring(task.i_task.sid))
    gotable.obj_items:ClearChildren()
    for key, value in pairs(task.Cfg.reward) do
        self:CareatItem(value, gray_show, gotable.obj_items)
    end
    return item
end

function ActivePanelBase:CareatItem(data, isGou, Parent, backCall)
    if _G.IsNil(Parent) or Parent:GetctiveInHierarchy() == 0 then
        return
    end
    local Sid = data[1]
    local id = Parent:GetInstanceID()
    if self.CaCheLoadAwardList[id] then
        if self.CaCheLoadAwardList[id][Sid] then
            return
        end
    else
        self.CaCheLoadAwardList[id] = {}
    end
    self.CaCheLoadAwardList[id][Sid] = true
    if Sid ~= _G.ResPropID.ActiveAch and Sid ~= _G.ResPropID.ActiveValue then
        -- body
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            data,
            Parent,
            function(item)
                if _G.IsNil(Parent) then
                    _G.DestroyImmediate(item.gameObject)
                    return
                end
                self.CaCheLoadAwardList[id][Sid] = false
                item.gameObject:SetLocalScaleXYZ(0.8)
                item.gameObject:SetActiveE(1)
                item:SetPri(data.isPri)
                item:SetGou(isGou)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                if item.SetGradeNew then
                    item:SetGradeNew(false)
                end
                if backCall then
                    backCall(item)
                end
            end,
            function(go, isOn)
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, Sid)
            end
        )
    end
    --end
end

function ActivePanelBase:TeXiaoShengCheng(obj, insId, Sid, go_table, effCfg, key)
    _G.UIUtils.LoadEffectByCfg(
        effCfg,
        obj,
        function(trans)
            go_table.EffTranDic[key] = trans
            if self.TaskRewardInfo[insId] and self.TaskRewardInfo[insId]["showEff"] == 1 then
                trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
            else
                trans:SetActiveE(0)
            end
        end
    )
end

---战斗力 数字计算
function ActivePanelBase:NumberToUnitStr_CardFightNum(num)
    -- 小数点规则
    -- 保留一位小数 四舍五入
    -- 10.56亿 算10.6亿
    --num = _G.GameUtil.FormatNum(num)
    local str = ""
    local len = string.len(num)
    --个十百千万十百千亿
    if len > 8 then
        num = num / 1000000
        local t1, t2 = _G.math.modf(tonumber(num))
        str = _G.LangUtil.GetLangPackValue(90023100005, t1)
    elseif len > 6 then
        num = num / 1000
        local t1, t2 = _G.math.modf(tonumber(num))
        str = _G.LangUtil.GetLangPackValue(90023100004, t1)
    else
        str = tostring(num)
    end
    return str
end

function ActivePanelBase:SetTaskItemjd(aorimage, value, loopValue_Max)
    local w = value / loopValue_Max
    if w > 1 then
        w = 1
    end
    if _G.AppSetting.IsXzns then
        aorimage:SetRectTransformSize(value > 0 and w * (256) or 0, 8)
    else
        aorimage:SetRectTransformSize(value > 0 and w * (211) or 0, 14)
    end
end

