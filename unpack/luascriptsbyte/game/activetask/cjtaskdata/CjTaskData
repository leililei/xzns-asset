---@class CjTaskData : ActiveTaskBase	中文描述
---@field Cfg mission_extra_cfg
local CjTaskData = _G.BaseClass("CjTaskData", _G.ActiveTaskBase)

function CjTaskData:Init(task)
    if task.state == _G.TaskEnum.ETaskState.Claimed then
        _G.Events:GetInstance():AddListener(_G.ePlayAactionEvent.PlayAactionCj, self.OnAactionEnentCj, self)
    end
end
---类的析构函数
function CjTaskData:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.ePlayAactionEvent.PlayAaction, self.OnAactionEnent, self)
    _G.Events:GetInstance():RemoveListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.OnEvent_CheckLock, self)
    _G.Events:GetInstance():RemoveListener(_G.ePlayAactionEvent.PlayAactionCj, self.OnAactionEnentCj, self)
end
function CjTaskData:OnAactionEnentCj(a, b, c, d, e, f, g)
    self:OnAactionEnent(a, b, c, d, e, f, g)
end

function CjTaskData:IsCheckTaskTargets(num)
    return num
end

return CjTaskData
