---@class ActiveBattlePassBuyTips	中文描述
local ActiveBattlePassBuyTips = _G.BaseClass("ActiveBattlePassBuyTips", _G.Component)

local GetLangPackValue = _G.GetLangPackValue

---类的构造函数
---@param Params_FundBuyTips Params_FundBuyTips
function ActiveBattlePassBuyTips:__init(obj, Params_FundBuyTips)
    self.okFun = Params_FundBuyTips.okFun
    self.closeFun = Params_FundBuyTips.closeFun
    self.price_id = Params_FundBuyTips.price_id or 0
    self.goods = Params_FundBuyTips.goods
    self.storeContentCfg = _G.ConfigManager.store_season_battlecon_cfg
    self.name = Params_FundBuyTips.name or ""
    ---@type number[] 包含内容 [ store_battle_content_cfg.id, store_battle_content_cfg.id,]
    self.contentIds = Params_FundBuyTips.contentIds
    self.nowLevel = Params_FundBuyTips.nowLevel
    self.activityId = Params_FundBuyTips.activityID

    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self:Init()
    _G.GameUtil.AddDouYinIcon(self.go_table.aorbtn_btn, false)
end

function ActiveBattlePassBuyTips:Parse(Params_FundBuyTips)
    self.okFun = Params_FundBuyTips.okFun
    self.closeFun = Params_FundBuyTips.closeFun
    self.price_id = Params_FundBuyTips.price_id or 0
    self.goods = Params_FundBuyTips.goods
    self.name = Params_FundBuyTips.name or ""
    self.storeContentCfg = _G.ConfigManager.store_season_battlecon_cfg
    ---@type number[] 包含内容 [ store_battle_content_cfg.id, store_battle_content_cfg.id,]
    self.contentIds = Params_FundBuyTips.contentIds
    self.nowLevel = Params_FundBuyTips.nowLevel
    self.activityId = Params_FundBuyTips.activityID
    self:Init()
    self:Hide()
end

function ActiveBattlePassBuyTips:Init()
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.ActiveBattlePassBuyTips, self.go_table)
    --刷新时间
    self.activityId = self.activityId or 1012201
    local activity = require("ActivitySynManager"):GetInstance():GetActivityClass(self.activityId)
    self.typeClass = activity.typeClass
    self.countDown = self.typeClass:GetEndTime() - _G.TimeUtil.GetServerUnixTime()
    self:UpdateTime(0)
    self:StopTimer()
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()

    self:LoadSpine()

    local content = _G.GameUtil.SetPriceByChannel(self.price_id)
    self.go_table.aortext_rmb.text = _G.GetLangPackValue(90025500017, content)

    --self.go_table.aortext_name.text = self.name
    if self.contentIds == nil then
        if _G.AppSetting.DEBUG then
            _G.Log("", "<color=red>" .. "参数有误 奖励为空" .. "</color>")
        end
        return
    end

    ---总计获得
    ---{ sid=num, }
    local rewardsSumDic = {}
    ---立即获得
    local rewardsDic = {}
    ---购买立即奖励钻石
    rewardsDic[self.goods[1][1]] = self.goods[1][2]

    local sid, num, cfgid, isPass
    ---@type store_battle_content_cfg
    local cfgInfo
    for i = 1, #self.contentIds do
        ---奖励配置id
        cfgid = self.contentIds[i]
        ---奖励配置
        cfgInfo = self.storeContentCfg[cfgid]
        if cfgInfo then
            ---true可领取
            isPass = self.nowLevel and self.nowLevel >= i
            --isPass = _G.GlobalConditionManager.CheckCondition(cfgInfo.conditions[1], cfgInfo.conditions[2])
            for i = 1, #cfgInfo.rewards_pay do
                sid = cfgInfo.rewards_pay[i][1]
                num = cfgInfo.rewards_pay[i][2]

                if rewardsSumDic[sid] == nil then
                    rewardsSumDic[sid] = num
                else
                    rewardsSumDic[sid] = rewardsSumDic[sid] + num
                end

                if isPass then
                    if rewardsDic[sid] == nil then
                        rewardsDic[sid] = num
                    else
                        rewardsDic[sid] = rewardsDic[sid] + num
                    end
                end
            end
        end
    end

    -- for sid, num in pairs(rewardsSumDic) do
    --     _G.StorageManager:GetInstance():GetItem(self.go_table.obj_item1, sid, num, _G.handler(self, self.itemCall))
    -- end

    -- for sid, num in pairs(rewardsDic) do
    --     _G.StorageManager:GetInstance():GetItem(self.go_table.obj_item2, sid, num, _G.handler(self, self.itemCall))
    -- end



    local rewardsDic2 = {}
    for k, v in pairs(rewardsDic) do
        table.insert(rewardsDic2, { sid = k, num = v })
    end

    local rewardsSumDic2 = {}
    for k, v in pairs(rewardsSumDic) do
        table.insert(rewardsSumDic2, { sid = k, num = v })
    end

    _G.table.sort(
        rewardsDic2,
        function(a, b)
            local gradeA = _G.StorageManager:GetInstance():GetItemGrade(a.sid)
            local gradeB = _G.StorageManager:GetInstance():GetItemGrade(b.sid)
            if gradeA == gradeB then
                return a.sid < b.sid
            end
            return gradeA > gradeB
        end
    )

    _G.table.sort(
        rewardsSumDic2,
        function(a, b)
            local gradeA = _G.StorageManager:GetInstance():GetItemGrade(a.sid)
            local gradeB = _G.StorageManager:GetInstance():GetItemGrade(b.sid)
            if gradeA == gradeB then
                return a.sid < b.sid
            end
            return gradeA > gradeB
        end
    )

    --  for k,v in pairs (rewardsDic2) do
    --     table.insert (rewardsDic2,v)

    --  end

    self.go_table.obj_item1:RemoveAllChildren()
    for awardSid, v in pairs(rewardsDic2) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew({ [1] = v.sid, [2] = v.num }, self.go_table.obj_item1,
            _G.handler(self, self.itemCall))
    end

    if _G.table.count(rewardsSumDic) >= 5 then
        self.go_table.obj_item2:SetPivotPosition(0, 0.5)
    end
    self.go_table.obj_item2:RemoveAllChildren()
    local i = 0
    for awardSid, v in pairs(rewardsSumDic2) do
        -- i = i + 1
        -- if i > 4 then
        --     break
        -- end
        _G.StorageManager:GetInstance():GetItemBaseViewNew({ [1] = v.sid, [2] = v.num }, self.go_table.obj_item2,
            _G.handler(self, self.itemCall))
    end
end

function ActiveBattlePassBuyTips:StopTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

function ActiveBattlePassBuyTips:UpdateTime(elapsed)
    self.countDown = self.countDown - elapsed
    if self.countDown < 0 then
        self.countDown = 0
    end
    if self.go_table == nil then
        return
    end
    local time = _G.Mathf.RoundToInt(self.countDown)
    self.go_table.aortext_time.text =
        GetLangPackValue(90028900002, _G.string.AddColor(_G.TimeUtil.TransDayHourMineMiao(time), "69fa3c"))
end

function ActiveBattlePassBuyTips:LoadSpine()
    if not self.spine then
        if not _G.UIUtils.IsHaveChange(_G.IsNeedChangeUI.ActiveBattlePassBuyTips, "obj_spine") then
            local cfg = _G.ConfigManager.card_cfg[116040000]
            _G.PoolsManager:GetInstance():Spawn(
                    cfg.ModelPathHi,
                    _G.ePoolType.UIItem,
                    self.go_table.obj_spine,
                    function(trans)
                        if not self.go_table then
                            _G.DestroyObject(trans)
                            return
                        end
                        GameUtil.SetCardUiSpineAnimation(trans,"idle",true)
                        self.spine = trans
                        trans:SetLocalScaleXYZ(0.8)
                        trans:SetLocalPosition(_G.table.unpack(cfg.pos_portrait))
                    end
            )
        end

    end
end

function ActiveBattlePassBuyTips:Show()
    self.gameObject:SetActiveE(1)
end

function ActiveBattlePassBuyTips:Hide()
    self.gameObject:SetActiveE(0)
end

function ActiveBattlePassBuyTips:UpdateNowLevel(nowLevel)
    self.nowLevel = nowLevel
    self:Init()
end

function ActiveBattlePassBuyTips:itemCall(itemLua)
    ---@type ItemViewBase
    local lua = itemLua
    lua.gameObject:SetLocalScaleXYZ(0.9)
    lua:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
    lua:ShowEffectOrder(true)
end

function ActiveBattlePassBuyTips:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_btn then
        if self.okFun then
            self.okFun()
        end
        self:Hide()
    elseif go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close2 then
        if self.closeFun then
            self.closeFun()
        end
        self:Hide()
    end
end

---类的析构函数
function ActiveBattlePassBuyTips:Dispose()
    self:StopTimer()
end

return ActiveBattlePassBuyTips
