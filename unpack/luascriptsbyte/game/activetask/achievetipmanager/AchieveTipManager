---@class AchieveTipManager : Singleton	中文描述
local AchieveTipManager = _G.BaseClass("AchieveTipManager", _G.Singleton)

---@return AchieveTipManager AchieveTipManager
function AchieveTipManager:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function AchieveTipManager:__init()
end

---销毁对象时,析构函数
function AchieveTipManager:Dispose()
end

--region对外接口
function AchieveTipManager:Show(taskId)
    local cfg = _G.ConfigManager.mission_cfg[taskId]
    if cfg == nil then
        return
    end
    if cfg.type_mission ~= 2 then
        return
    end
    if #cfg.icon == 0 then
        return
    end 
    if self.view then
        self.view:Add(cfg)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.AchieveTipView.Name, cfg)
    end
end

function AchieveTipManager:SetView(view)
    self.view = view
end

function AchieveTipManager:CloseView()
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.AchieveTipView.Name)
end

return AchieveTipManager
--endregion
