local ThemeActivityManager = require("ThemeActivityManager"):GetInstance()
local CelebrationTrialModel = require("CelebrationTrialModel"):GetInstance()

---@class CelebrationTrialBoxItem    中文描述
---@field public go_table CelebrationTrialView._obj_box1_GoTable
local CelebrationTrialBoxItem = _G.BaseClass("CelebrationTrialBoxItem", _G.Component)
_G.CelebrationTrialBoxItem = CelebrationTrialBoxItem

local CS = _G.CS
local typeof = _G.typeof

---类的构造函数
---@field data CelebrationTrialBoxData
function CelebrationTrialBoxItem:__init(obj, id, callback)
    self.id = id
    self.sid = CelebrationTrialModel.boxesInfo[id].sid
    self.condition = CelebrationTrialModel.boxesInfo[id].condition
    self.callback = callback
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.aSid = ThemeActivityManager:GetActivityID()
end

function CelebrationTrialBoxItem:Show()
    self.state = CelebrationTrialModel:CheckBoxState(self.id)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_boxClose, self.state ~= 3)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_boxOpen, self.state == 3)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_eff, self.state == 2)
    if self.state == 2 then
        if self.go_table.obj_eff:GetChildCountE() == 0 then
            _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_TreasureHuntView_baoxiang, self.go_table.obj_eff, function()
                if _G.IsNil(self) then
                    _G.UIUtils.RemoveEffect(self.go_table.obj_eff)
                end
            end)
        end
    end
end

---@private
function CelebrationTrialBoxItem:OnClickBtn(go)
    if go == self.go_table.aorbtn_open then
        if self.state == 2 then
            CelebrationTrialModel:GetAward(self.sid, self.aSid, _G.handler(self, self.Show),self.id)
        else
            if self.callback then
                self.callback(self.id, self.state == 3)
            end
        end
    end
end

---类的析构函数
function CelebrationTrialBoxItem:Dispose()
end

return CelebrationTrialBoxItem