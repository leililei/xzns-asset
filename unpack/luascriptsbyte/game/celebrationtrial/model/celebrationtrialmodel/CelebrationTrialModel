---初始化数据
---@param msg activity_theme.i_celebration_trial
function CelebrationTrialModel:InitData(msg)
    self.info = msg
    self.passTime = msg.all_pass_times
    self.boxesInfo = msg.cfg_award
    self.damage = msg.day_high_dps
    _G.SortList(
        self.boxesInfo,
        function(a)
            return -a.condition
        end
    )
    self.receivedList = msg.times_award or {}
    self.finishList = msg.finish or {}
    local curTaskValue = msg.curr or {}
    self.curTaskValue = {}
    for _, v in pairs(curTaskValue) do
        if v.k == 2 then
            self.curTaskValue[v.k] = Mathf.Floor(v.v / 1000)
        else
            self.curTaskValue[v.k] = v.v
        end
    end
    self:InitTask(msg.cfg_list)
    self.delta = msg.day_change_list
    self.monsterGroup = msg.monster_id
end

---进入活动
function CelebrationTrialModel:EnterActivity()
    UIManager:GetInstance():OpenWindow(ConfigManager.ui_cfg.CelebrationTrialView.Name)
end

---@private
---@param taskData activity_theme.i_celebration_task[]
function CelebrationTrialModel:InitTask(taskData)
    self.taskList = {}
    _G.SortList(
        taskData,
        function(a)
            return a.condition[1], a.condition[2]
        end
    )
    local item
    local task
    for _, v in pairs(taskData) do
        item = {}
        item.type = v.condition[1]
        item.count = v.condition[2]
        item.award = v.award
        task = {}
        task.sid = v.sid
        task.target = {self.curTaskValue[task.sid] or 0}
        task.time = 0
        task.state = self:GetTaskState(task.sid, item.count, task.target[1])
        item.i_task = task
        _G.table.insert(self.taskList, item)
    end
end

---@private
function CelebrationTrialModel:GetTaskState(sid, target, cur)
    if _G.table.ContainsValue(self.finishList, sid) then
        return _G.TaskEnum.ETaskState.Completed
    elseif cur >= target then
        return _G.TaskEnum.ETaskState.Submited
    else
        return _G.TaskEnum.ETaskState.Claimed
    end
end

---解析战斗结果（任务用）
---@param data fight.s2c_fight_result
function CelebrationTrialModel:ParseFightResult(data)
    if data.ack == 1 then
        for _, v in pairs(self.taskList) do
            if v.i_task.state ~= _G.TaskEnum.ETaskState.Completed then
                if v.i_task.sid == 1 then
                    v.i_task.target[1] = v.i_task.target[1] + 1
                elseif v.i_task.sid == 2 then
                    if v.i_task.target[1] < data.args[1] / 1000 then
                        v.i_task.target[1] = Mathf.Floor(data.args[1] / 1000)
                    end
                elseif v.i_task.sid == 3 then
                    if v.i_task.target[1] < data.atk_dps then
                        v.i_task.target[1] = data.atk_dps
                    end
                end
                if v.i_task.target[1] >= v.count and v.i_task.state == _G.TaskEnum.ETaskState.Claimed then
                    v.i_task.state = _G.TaskEnum.ETaskState.Submited
                end
            end
        end
    end
end

---获取当前阶段
function CelebrationTrialModel:GetCurStage()
    local startTime = ThemeActivityManager:GetStartTime()
    local timeShow = {}
    local now = TimeUtil.GetServerUnixTime()
    local stageIdx = now > startTime and 1 or 0
    local stage = startTime
    for i = 1, 3 do
        timeShow[i] = stage - now
        stage = stage + self.delta[i] * 86400
        if now > stage then
            stageIdx = i + 1
        end
    end
    if timeShow[stageIdx] then
        timeShow[stageIdx] = timeShow[stageIdx] + self.delta[stageIdx] * 86400
    end
    return stageIdx, timeShow
end

---检查宝箱状态 1.未解锁 2.可领取 3.已领取
function CelebrationTrialModel:CheckBoxState(index)
    if _G.table.ContainsValue(self.receivedList, self.boxesInfo[index].sid) then
        return 3
    elseif self.boxesInfo[index].condition <= self.passTime then
        return 2
    else
        return 1
    end
end

---领取阶段奖励
function CelebrationTrialModel:GetAward(id, activityId, callback,index)
    if not self.coinSid then
        self.coinSid = require"ThemeActivityManager":GetInstance():GetCoinSid()
    end
    local pbData = {activity_id = activityId, id = id}
    CelebrationTrialNet:GetAward(
        pbData,
        function(data)
            if data.ack ~= 1 then
                return
            end
            for k,v in pairs(self.boxesInfo[index].award) do
                if v.sid == self.coinSid then
                    local itemData = {type = {v.sid,v.num}}
                    _G.table.insert(data.award.item,itemData)
                end
            end
            _G.table.insert(self.receivedList, id)
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
            self:RefreshRedPoint()
            if callback then
                callback(data)
            end
        end
    )
end

---完成任务
function CelebrationTrialModel:FinishTask(sid, award, callback)
    local activityId = ThemeActivityManager:GetActivityID()
    local pbData = {activity_id = activityId, sid = sid}
    CelebrationTrialNet:FinishTask(
        pbData,
        function(data)
            local coinSid = require("ThemeActivityManager"):GetInstance():GetCoinSid()
            for _, v in pairs(award) do
                if v.sid == coinSid then
                    local type = {type = {v.sid, v.num}}
                    _G.table.insert(data.award.item, type)
                end
            end
            _G.table.insert(self.finishList, sid)
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            if callback then
                callback(data)
            end
            self:RefreshRedPoint()
        end
    )
end

