    require "RedPointManager":GetInstance():RefreshNodeByAllParams(self:GetRedPointId())
end

function CelebrationTrialModel:PlayRankHuiFang(rankid, playeruid)
    local msg = {}
    msg.type = rankid
    msg.uid = playeruid
    require "LingRankNet":GetInstance():GetRankReport(
        msg,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self.fight_arg = msg.arg
            self:UpdateData1(_G.BattleManager:GetInstance():GetStatisticsRecord(msg.arg))
        end
    )
end

function CelebrationTrialModel:UpdateData1(data)
    if not data then
        _G.PopWindowManager:GetInstance():ShowAllTips(540302)
        return
    end
    self.maxCountRank = _G.table.count(data.FighterInfo)
    self.PveData = {}
    local damage, win = _G.GameUtil.ShowStatisticsView(data)
    self.PveData = damage
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name,
        self.PveData,
        win,
        function()
            local ThemeActivitySecView =
                _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.ThemeActivitySecView.Name)
            if ThemeActivitySecView then
                ThemeActivitySecView.View:Show()
            end
            local CelebrationTrialView =
                _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.CelebrationTrialView.Name)
            if CelebrationTrialView then
                CelebrationTrialView.View:Show()
            end
            local CelebrationTrialRankView =
                _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.CelebrationTrialRankView.Name)
            if CelebrationTrialRankView then
                CelebrationTrialRankView.View:Show()
            end
        end,
        nil,
        self.otherPlayer,
        1,
        true,
        self.fight_arg
    )
end

