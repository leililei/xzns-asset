function CelebrationTrialModel:OnSettlement()
    if not self.isChallenge then
        if
            _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.CelebrationTrialRankView.Name) and
                _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name)
         then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name)
        end
        if
            _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.CelebrationTrialView.Name) and
                _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.EmbattleView.Name)
         then
            ---@type EmbattleNewView
            local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.EmbattleView.Name)
            ctrl:QuitEmbattle()
        end
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.CelebrationTrialView.Name)

        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.CelebrationTrialTaskView.Name)

        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.CelebrationTrialRankView.Name)
    end
end

