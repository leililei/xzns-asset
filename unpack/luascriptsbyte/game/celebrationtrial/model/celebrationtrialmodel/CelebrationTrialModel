---更换界面
function CelebrationTrialModel:ReturnPanel(isWin)
    self.isChallenge = false
    _G.UIManager:GetInstance():ShowWindow(ThemeActivityManager.curActitity:OnGetMainViewName())
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.CelebrationTrialView.Name)
    if not ThemeActivityManager:CheckThemeActivityIsOpen() then
        if
            _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.CelebrationTrialRankView.Name) and
                _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name)
         then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name)
        end
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.CelebrationTrialView.Name)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.CelebrationTrialRankView.Name)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.CelebrationTrialTaskView.Name)
        _G.UIManager:GetInstance():CloseWindow(ThemeActivityManager.curActitity:OnGetMainViewName())
    else
        if isWin then
            local index = 2
            ---@type monster_group_cfg
            local monster_group = _G.ConfigManager.monster_group_cfg[self.monsterGroup]
            local cfgs = _G.ConfigManager.monster_cfg
            ---@type monster_cfg
            local monsterCfg
            for _, v in ipairs(monster_group.DefaultDefenserSids[1]) do
                monsterCfg = cfgs[v]
                if monsterCfg and monsterCfg.MonsterType == 5 then
                    break
                end
            end
            local card_cfg = _G.ConfigManager.card_cfg[monsterCfg.CardID]
            local data = {
                rankDatas = {},
                playerRankData = {},
                name = _G.GetLangPackValue(monsterCfg.Name),
                icon = card_cfg.Portrait,
                type = _G.FightBossWinType.CelebrationTrial,
                cardId = monsterCfg.CardID,
            }
            local showView = function()
                index = index - 1
                if index <= 0 then
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FightBossWinView.Name, data)
                end
            end

            require("DungonesModel"):GetInstance():GetRanKInfo(
                {type = 80},
                function()
                    ---@type FightBossWinView_Params

                    local rankDatas = require("DungonesModel"):GetInstance().rank_all_player or {}
                    if rankDatas then
                        for i = 1, #rankDatas do
                            data.rankDatas[i] = {
                                rank = i,
                                role = rankDatas[i]:GetRole(),
                                value = rankDatas[i]:GetDamage()
                            }
                        end
                    end
                    showView()
                end
            )

            require "CelebrationTrialModel":GetInstance():GetPlayerRank(
                function(msg)
                    data.playerRankData = {rank = msg.index}
                    showView()
                end
            )
        end
    end
end

