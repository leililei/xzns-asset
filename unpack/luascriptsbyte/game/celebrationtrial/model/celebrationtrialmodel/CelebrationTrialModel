---检查红点
function CelebrationTrialModel:CheckRedPoint(param)
    if not ThemeActivityManager:CheckThemeActivityIsOpen() then
        return false
    end
    if param == 1 then
        return self:CheckTaskRedPoint()
    end
    local uid = _G.PlayerModel:GetInstance():GetPlayerUid()
    local key = uid .. ConfigManager.ui_cfg.CelebrationTrialView.Name .. ThemeActivityManager:GetActivityID()
    local stageIdx, timeShow = self:GetCurStage()
    if 0 < stageIdx and stageIdx < 4 and not _G.PlayerPrefsManager.HasKey(key .. stageIdx) then
        return true
    end
    for k, v in pairs(self.boxesInfo) do
        if self:CheckBoxState(k) == 2 then
            return true
        end
    end
    return self:CheckTaskRedPoint()
end

---@private
function CelebrationTrialModel:CheckTaskRedPoint()
    for k, v in pairs(self.taskList) do
        if v.i_task.state == _G.TaskEnum.ETaskState.Submited then
            return true
        end
    end
    return false
end

