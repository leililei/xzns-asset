local ThemeActivityManager = require("ThemeActivityManager"):GetInstance()
local base = require("BaseGameNet")

---@class CelebrationTrialNet : BaseGameNet	通信协议
local CelebrationTrialNet = _G.BaseClass("CelebrationTrialNet", base)
---@return CelebrationTrialNet CelebrationTrialNet
function CelebrationTrialNet:GetInstance()
    return  base.GetInstance(self)
end

function CelebrationTrialNet:FinishTask(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_module_theme_celebration_finish
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

function CelebrationTrialNet:GetAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_module_theme_celebration_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

function CelebrationTrialNet:Fight(callback)
    local item = _G.ConfigManager.net_map.game_activity_module_theme_celebration_fight
    local pbData = { activity_id = ThemeActivityManager:GetActivityID()}
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

function CelebrationTrialNet:GetRank(pbData, callback)
    local item = _G.ConfigManager.net_map.game_rank_celebration
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

function CelebrationTrialNet:GetPlayerRank(pbData, callback)
    local item = _G.ConfigManager.net_map.game_rank_get_rank_num
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function CelebrationTrialNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end


return CelebrationTrialNet