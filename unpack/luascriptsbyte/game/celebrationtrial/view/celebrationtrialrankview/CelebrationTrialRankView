function CelebrationTrialRankView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eBattleState.RecordStart, self.RecordStart)
    self:AddListener(_G.eBattleState.RecordEnd, self.RecordEnd)
end

function CelebrationTrialRankView:RecordStart()
    self:Hide()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.WroldBossView.Name)
end

function CelebrationTrialRankView:RecordEnd()
    self:Show()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.WroldBossView.Name)
end

---界面的入口函数
function CelebrationTrialRankView:OnCreate()
    self.RewardDatas = {}
    local array = CelebrationTrialModel:GetInstance():GetRankAwards()
    for _, v in pairs(array) do
        _G.table.insert(self.RewardDatas, _G.ConfigManager.system_rank_cfg[v])
    end
    _G.table.sort(
        self.RewardDatas,
        function(a, b)
            return a.id < b.id
        end
    )
    self:InitToggle()
    if self.go_table.toggle_zoneRank:GetActiveSelf() == 1 then
        self.go_table.toggle_zoneRank.isOn = true
    else
        self.go_table.toggle_rank.isOn = true
    end
    ---排行回放 不会关闭 挑战界面
    local ChangllengeView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
    if ChangllengeView then
        ChangllengeView:Hide()
    end
end

