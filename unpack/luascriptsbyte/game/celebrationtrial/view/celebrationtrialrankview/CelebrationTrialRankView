---点击Togggle
function CelebrationTrialRankView:OnToggle(go, isOn, key, call)
    local tb = self.Toggles[key]
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOff, not isOn)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, isOn)
    if call then
        call(isOn)
    end
end

---大区排行
function CelebrationTrialRankView:OnZoneRank(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_ZoneRank, isOn)
    if not isOn then
        return
    end
    if not self.ZoneRank then
        local ThemeActivityManager = require("ThemeActivityManager"):GetInstance()
        local name = "UI/ZoneRank/$_obj_zoneRank"
        _G.PoolsManager:GetInstance():Spawn(
            name,
            _G.ePoolType.Temporary,
            self.go_table.obj_ZoneRank,
            function(trans)
                _G.GameUtil.SetActiveByCondition(trans, true)
                local view = self:AddComponent(trans.gameObject, require "ZoneRankView".New(trans, self))
                view:InitView(_G.ZoneRankType.CelebrationTrial, ThemeActivityManager:GetActivityID())
                self.ZoneRank = view
            end
        )
    end
end

---排行
function CelebrationTrialRankView:OnRank(isOn)
    -- _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)
    DungonesModel = require "DungonesModel":GetInstance()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Rank, isOn)
    if not isOn then
        return
    end
    if not self.Rank then
        self.Rank = _G.GetAutoGoTable(self.go_table.obj_Rank)
        --_G.GameUtil.SetActiveByCondition(self.Rank.obj_yiwu, false)
        self.rankList = {}
        self.rewardList_Rank = {}
        local data = {}
        data.type = 80
        require("LingRankNet"):GetInstance():GetRankAllInfos(
            data,
            function(msg)
                DungonesModel.rank_all_player = {}
                DungonesModel:SetRankAllPlayer(msg.rank, 80)
                self.rankDatas = DungonesModel.rank_all_player
                _G.GameUtil.SetActiveByCondition(self.Rank.obj_no, #self.rankDatas <= 0)
                _G.GameUtil.SetActiveByCondition(self.gameObject, true)
                self.Rank.scrollloopvectical_rankList:InitItemData(#self.rankDatas, _G.handler(self, self.RefreshRank))
                _G.GameUtil.SetActiveByCondition(self.Rank.obj_no, #self.rankDatas <= 0)
            end
        )
        require "CelebrationTrialModel":GetInstance():GetPlayerRank(
            function()
                self:InitPlayer()
            end
        )
    end
end

---刷新排行
function CelebrationTrialRankView:RefreshRank(index, obj)
    local newindex = index + 1
    local instanceID = obj:GetInstanceIDE()
    local tb1 = self.rankList[instanceID]
    if not self.rankList[instanceID] then
        tb1 = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.RankItemClick, tb1))
        self.rankList[instanceID] = tb1
    -- self.rankList[instanceID].scrollloophorizontal_AwardList:InitItemData(
    --     0,
    --     _G.handlerbind(self, self.RefreshReward, self.rewardList_Rank, self.rankList[instanceID])
    -- )
    end
    local tb = self.rankList[instanceID]
    ---@type rank.i_celebration
    local data = self.rankDatas[newindex]
    tb.rankData = data
    --tb.data = self:GetRankData(newindex)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_rankBg, newindex <= 3)
    _G.GameUtil.SetActiveByCondition(tb.obj_rankBg2, newindex > 3)
    if newindex <= 3 then
        tb.aorimage_rankBg.SpriteName = "tz_qjhs_di_0" .. (newindex + 1)
        tb.aorimage_rank.SpriteName = "tz_qjhs_phb_mingci_0" .. newindex
    else
        tb.aortext_rankNum.text = newindex
    end
    tb.aortext_name.text = data.playerName
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data, 1, true, true, true)
    tb.aortext_damage.text = _G.GameUtil.NumberToUnitStr(data.Damage)
    self:ShowTeam(tb.trans_cardnode, data)
end

function CelebrationTrialRankView:ShowTeam(parent, data)
    if parent:GetChildCountE() > 0 then
        for i = 1, parent:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(parent:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    local teamCard = data:GetTeamCard()
    if not teamCard then
        return
    end
    for i = 1, 5 do
        if teamCard[i] then
            local tData = teamCard[i]
            -- _G.StorageManager:GetInstance():GetItemBaseView(
            --     teamcard[i].sid,
            --     nil,
            --     parent,
            --     function(item)
            --         --item:Show(data)
            --     end
            -- )
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.ItemCardStorageView,
                parent,
                function(item)
                    item:Show(
                        tData.sid,
                        nil,
                        tData.star,
                        tData.soulLink_lv,
                        tData.lv,
                        nil,
                        nil,
                        tData.soulLink_IsActivate,
                        tData.open_inborn
                    )
                end
            )
        end
    end
end
function CelebrationTrialRankView:RankItemClick(go, ref, tb)
    local data = tb.rankData
    local name = go:GetName()
    if name == "@_aorbtn_HeadClick" then
        if data.uid > 0 then
            if data.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.PopWindowManager:GetInstance():ShowAllTips(620109)
            else
                _G.SystemSettingManager:GetInstance():OpenView(data.uid)
            end
        end
    elseif name == "@_aorbtn_huifang" then
        local ThemeActivitySecView =
            _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.ThemeActivitySecView.Name)
        if ThemeActivitySecView then
            ThemeActivitySecView.View:Hide()
        end
        local CelebrationTrialView =
            _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.CelebrationTrialView.Name)
        if CelebrationTrialView then
            CelebrationTrialView.View:Hide()
        end
        local CelebrationTrialRankView =
            _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.CelebrationTrialRankView.Name)
        if CelebrationTrialRankView then
            CelebrationTrialRankView.View:Hide()
        end
        require "CelebrationTrialModel":GetInstance():PlayRankHuiFang(80, data.uid)
    end
end
function CelebrationTrialRankView:ShowAward(tb, obj, award, parent)
    if not tb.list then
        tb.list = {}
    end
    local count = #tb.list
    local count2 = #award
    for i = 1, count do
        if i <= count2 then
            tb.list[i]:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(award[i]))
            _G.GameUtil.SetActiveByCondition(tb.list[i].gameObject, true)
        else
            _G.GameUtil.SetActiveByCondition(tb.list[i].gameObject, false)
        end
    end
    if count < count2 then
        for i = count + 1, count2 do
            local obj2 = _G.InstantiateObject(obj)
            obj2:SetParentE(tb.trans_Content)
            local item = require "BaseAwardNewItem".New(obj2, nil, 73, obj2:GetChildE(0))
            tb.list[i] = item
            local data = award[i]
            item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
        end
    end
end

function CelebrationTrialRankView:GetRankData(index)
    if index <= 0 then
        return
    end
    for _, v in ipairs(self.RewardDatas) do
        if index >= v.min_rank and index <= v.max_rank then
            return v
        end
    end
    return nil
end

---显示玩家排行
function CelebrationTrialRankView:InitPlayer()
    self.playerRank = require "CelebrationTrialModel":GetInstance().playerRank
    if not self.player then
        self.player =
            _G.GetAutoGoTable(
            self.Rank.obj_player,
            _G.handlerbind(self, self.RankItemClick, {rankData = {uid = _G.PlayerModel:GetInstance():GetPlayerUid()}})
        )
    -- self.player.scrollloophorizontal_AwardList:InitItemData(
    --     0,
    --     _G.handlerbind(self, self.RefreshReward, self.rewardList_Rank, self.player)
    -- )
    end
    local tb = self.player
    local newindex = self.playerRank.index
    tb.data = self:GetRankData(newindex)
    if newindex == 0 then
        tb.aortext_rankNum.text = _G.LangUtil.GetLangPackValue(90022900040)
    else
        tb.aortext_rankNum.text = newindex
    end
    local playerModel = _G.PlayerModel:GetInstance()
    local playerData = {}
    tb.aortext_name.text = playerModel:GetName()
    playerData.frame = playerModel:GetCurFrame()
    playerData.style = playerModel:GetRoleStyle()
    playerData.uid = playerModel:GetPlayerUid()
    playerData.lv = playerModel:GetLevel()
    playerData.title = playerModel:GetTitle()
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, playerData, 1, true, true, true)
    tb.aortext_damage.text = _G.GameUtil.NumberToUnitStr(self.playerRank.value)
    if tb.data then
        self:ShowAward(tb, tb.obj_item, tb.data.rewards, tb.obj_item:GetChildE(0))
    else
        self:ShowAward(tb, tb.obj_item, {}, tb.obj_item:GetChildE(0))
    end
end
