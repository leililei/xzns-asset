---@class CelebrationTrialTaskView : UIBaseView    中文描述
---@field public go_table CelebrationTrialTaskView_GoTable GoTable
---@field taskList CelebrationTrialTaskView._obj_task_GoTable[]
---
local CelebrationTrialTaskView = _G.BaseClass("CelebrationTrialTaskView", _G.UIBaseView)
--_G.CelebrationTrialTaskView = CelebrationTrialTaskView

function CelebrationTrialTaskView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

local desLang = { 90028900006, 90028900004, 90028900005 } -- 1、挑战X次BOSS 2、存活达到XX秒 3、单次伤害达到XX

---界面的入口函数
function CelebrationTrialTaskView:OnCreate()
    self.taskList = {}
    self.taskData = require "CelebrationTrialModel":GetInstance().taskList
    self:SortTask()
    self.go_table.scrollloopvectical_taskList:InitItemData(#self.taskData, _G.handler(self, self.RefreshTask))
end

function CelebrationTrialTaskView:SortTask()
    _G.table.sort(
            self.taskData,
            function(a, b)
                local isGetA = a.i_task.state == _G.TaskEnum.ETaskState.Completed
                local isGetB = b.i_task.state == _G.TaskEnum.ETaskState.Completed
                local isOverA = a.i_task.state == _G.TaskEnum.ETaskState.Submited
                local isOverB = b.i_task.state == _G.TaskEnum.ETaskState.Submited
                if a.i_task.state == b.i_task.state then
                    return a.i_task.sid < b.i_task.sid
                elseif isOverA or isOverB then
                    return isOverA
                elseif isGetA or isGetB then
                    return not isGetA
                end
            end
    )
end

---刷新奖励
function CelebrationTrialTaskView:RefreshTask(index, obj)
    local id = obj:GetInstanceIDE()
    local tb = self.taskList[id]
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickTask, tb))
        self.taskList[id] = tb
        tb.awardList = {}
        tb.scrollloophorizontal_awardList:InitItemData(0, _G.handlerbind(self, self.RefreshAward, tb))
    end
    local data = self.taskData[index + 1]
    tb.index = index + 1
    tb.aortext_name.text = _G.LangUtil.GetLangPackValue(desLang[data.type], data.count)
    if data.i_task.state == _G.TaskEnum.ETaskState.Submited or data.i_task.state == _G.TaskEnum.ETaskState.Completed then
        tb.slider_progress.value = 1
        tb.aortext_Slider.text = data.count .. "/" .. data.count
    else
        tb.slider_progress.value = data.i_task.target[1] / data.count
        tb.aortext_Slider.text = data.i_task.target[1] .. "/" .. data.count
    end
    _G.GameUtil.SetActiveByCondition(tb.aorbtn_get, data.i_task.state == _G.TaskEnum.ETaskState.Submited)
    _G.GameUtil.SetActiveByCondition(tb.obj_unGet, data.i_task.state == _G.TaskEnum.ETaskState.Claimed)
    _G.GameUtil.SetActiveByCondition(tb.obj_complete, data.i_task.state == _G.TaskEnum.ETaskState.Completed)
    local count = #data.award
    tb.scrollloophorizontal_awardList:UpdateScrollRectWeight(count <= 1 and 94 or 168)
    tb.scrollloophorizontal_awardList:UpdateCount(count)
end
---显示奖励
---@param tb  CelebrationTrialTaskView._obj_task_GoTable
function CelebrationTrialTaskView:RefreshAward(index, obj, tb)
    local id = obj:GetInstanceIDE()
    ---@type BaseAwardNewItem
    local item = tb.awardList[id]
    if not item then
        item = require "BaseAwardNewItem".New(obj, nil, 74)
        tb.awardList[id] = item
    end
    local taskData = self.taskData[tb.index]
    local awardData = taskData.award[index + 1]
    awardData = { awardData.sid, awardData.num }
    local data = _G.StorageManager:GetInstance():GetItemDataClassByCfg(awardData)
    item:Show(data)
    _G.GameUtil.SetActiveByCondition(item.go_table.obj_gou, taskData.i_task.state == _G.TaskEnum.ETaskState.Completed)
end

---点击领取奖励
---@param tb CelebrationTrialTaskView._obj_task_GoTable
function CelebrationTrialTaskView:OnClickTask(_, _, tb)
    -- _G.AudioManager.PlayAudioByAudioCfgID(_G.AudioClipTypeEnum.clickAuido)
    local taskData = self.taskData[tb.index]
    require "CelebrationTrialModel":GetInstance():FinishTask(
        { taskData.i_task.sid },
        taskData.award,
        function(data)
            require "CommonTipManager".OpenCommonAwardView(data)
            taskData.i_task.state = _G.TaskEnum.ETaskState.Completed
            self:SortTask()
            self.go_table.scrollloopvectical_taskList:UpdateAllItem()
        end
    )
end

function CelebrationTrialTaskView:RefreshView(id)
    if id == _G.FunctionID.SeasonBoss then
        self.taskList = {}
        self.taskData = require "CelebrationTrialModel":GetInstance().taskList
        self:SortTask()
        self.go_table.scrollloopvectical_taskList:UpdateCount(#self.taskData)
    end
end

---按钮点击事件在这里派发
function CelebrationTrialTaskView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        -- _G.AudioManager.PlayAudioByAudioCfgID(_G.AudioClipTypeEnum.clickAuido)
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

return CelebrationTrialTaskView
