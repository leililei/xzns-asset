---@type ThemeActivityManager
local ThemeActivityManager
---@type CelebrationTrialModel
local CelebrationTrialModel
local CelebrationTrialBoxItem = require("CelebrationTrialBoxItem")

---@class CelebrationTrialView : UIBaseView    中文描述
---@field public go_table CelebrationTrialView_GoTable GoTable
local CelebrationTrialView = _G.BaseClass("CelebrationTrialView", _G.UIBaseView)

local GetLangPackValue = _G.GetLangPackValue
local ConfigManager = _G.ConfigManager
local UIManager = _G.UIManager:GetInstance()
local GetAutoGoTable = _G.GetAutoGoTable
local SetActiveByCondition = _G.GameUtil.SetActiveByCondition
local TimeUtil = _G.TimeUtil

function CelebrationTrialView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function CelebrationTrialView:OnCreate()
    ThemeActivityManager = require("ThemeActivityManager"):GetInstance()
    CelebrationTrialModel = require("CelebrationTrialModel"):GetInstance()
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.OnSixUpdate, self)
    self.sid = ThemeActivityManager:GetActivityID()
    self:InitView()
    self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(CelebrationTrialModel:GetRedPointId(1), 1)
end

---初始化显示
---@private
function CelebrationTrialView:InitView()
    self.itemTable = {}
    local pos = CelebrationTrialModel.info.theme.pos
    local array1 = _G.string.split(pos, "|")
    local array2 = _G.string.split(array1[2], "#")
    if array1[3] == "1" then
        self.go_table.aorrawimage_role:LoadImage(
                array1[1],
                function(tran)
                    tran:SetNativeSize()
                    tran:SetLocalPosition(tonumber(array2[1]) or 0, tonumber(array2[2]) or 0, tonumber(array2[3]) or 0)
                    tran:SetLocalScaleXYZ(tonumber(array2[4]) or 0)
                    tran:SetActiveE(1)
                end
        )
    else
        self.go_table.aorrawimage_role:SetActiveE(0)
        self.go_table.obj_role:SetLocalPosition(tonumber(array2[1]) or 0, tonumber(array2[2]) or 0, tonumber(array2[3]) or 0)
        self.go_table.obj_role:SetLocalScaleXYZ(tonumber(array2[4]) or 0)
        _G.UIUtils.LoadEffectByPath(array1[1], self.go_table.obj_role, function(tran)
            if self:IsNil() then
                _G.UIUtils.RemoveEffect(tran)
            end
        end)
    end

    self:RefreshView()
    self.timer = _G.TimerManager:GetInstance():GetTimer(60, self.UpdateTime, self, false, false, true)
    self.timer:Start()
    self:InitBox()
    _G.UIUtils.LoadEffectByCfg(ConfigManager.ui_effect_cfg.ef_CelebrationTrialView_bg, self.go_table.obj_eff, function(tran)
        if self:IsNil() then
            _G.UIUtils.RemoveEffect(tran)
        end
    end)
    
    self:LoadTitleFont()
end

---更新buff和阶段显示
function CelebrationTrialView:RefreshView()
    local stage, timeShow = CelebrationTrialModel:GetCurStage()
    if stage ~= self.stage then
        self.stage = stage
        self:InitBuffDes()
        local buffDes = CelebrationTrialModel:GetBuffList()[stage]
        if buffDes then
            if #buffDes.buff_id_list == 1 then
                self.go_table.aortext_buff1:SetLocalPosition(0, 2.5, 0)
                self.go_table.aortext_buff1.text = GetLangPackValue(ConfigManager.card_skills_cfg[buffDes.buff_id_list[1]].describe1)
                self.go_table.aortext_buff2:SetActiveE(0)
            else
                self.go_table.aortext_buff1:SetLocalPosition(0, 24, 0)
                self.go_table.aortext_buff2:SetLocalPosition(0, -19, 0)
                self.go_table.aortext_buff1.text = GetLangPackValue(ConfigManager.card_skills_cfg[buffDes.buff_id_list[1]].describe1)
                self.go_table.aortext_buff2.text = GetLangPackValue(ConfigManager.card_skills_cfg[buffDes.buff_id_list[2]].describe1)
            end
        end
    end
    local w, h, time
    for i = 1, 3 do
        if i == stage then
            self.countDown = timeShow[i]
            self.curStageObj = self.go_table["aortext_stage" .. i]
            time = TimeUtil.TranslateSecond(timeShow[i])
            if time.day > 0 then
                self.go_table["aortext_stage" .. i].text = GetLangPackValue(90028900002, GetLangPackValue(90025500011, time.day, GetLangPackValue(90022100002, time.hour, time.min)))
            elseif time.hour > 0 then
                self.go_table["aortext_stage" .. i].text = GetLangPackValue(90028900002, GetLangPackValue(90022100002, time.hour, time.min))
            else
                self.go_table["aortext_stage" .. i].text = GetLangPackValue(90028900002, GetLangPackValue(90000010394, time.min))
            end
        elseif i < stage then
            self.go_table["aortext_stage" .. i].text = GetLangPackValue(90028900001)
        else
            local day = TimeUtil.TranslateSecond(timeShow[i]).day
            self.go_table["aortext_stage" .. i].text = GetLangPackValue(90028900003, day > 0 and day or 1)
        end
        _G.GameUtil.ReBuildRTF(self.go_table["aortext_stage" .. i])
        w, h = self.go_table["aortext_stage" .. i]:GetRectTransformSize()
        self.go_table["aorimage_bgStage" .. i]:SetRectTransformSize(w + 40, 26)
    end
    self.go_table.slider_award.value = CelebrationTrialModel.passTime/100
    local tb = GetAutoGoTable(self.go_table.slider_award)
    tb.obj_Fill:SetActiveE(CelebrationTrialModel.passTime > 0 and 1 or 0)

    local uid = _G.PlayerModel:GetInstance():GetPlayerUid()
    local key = uid .. ConfigManager.ui_cfg.CelebrationTrialView.Name .. ThemeActivityManager:GetActivityID()
    if 0 < stage and stage < 4  then
        _G.PlayerPrefsManager.SetInt(key .. stage, 1)
    end
    CelebrationTrialModel:RefreshRedPoint()
end
---加载标题名称(艺术字)
function CelebrationTrialView:LoadTitleFont()
    local page_pos = CelebrationTrialModel.info.theme.page_pos
    local path = page_pos and _G.string.split(page_pos, "|")[2] or nil

    local isEmpty = _G.string.IsNullOrEmpty(path)
    self.go_table.aorimage_txt:SetActiveE(isEmpty and 1 or 0)
    self.go_table.aorrawimage_txt:SetActiveE(isEmpty and 0 or 1)
    if isEmpty then
        return
    end

    self.go_table.aorrawimage_txt:LoadImage(
        path,
        function(image)
            if _G.IsNil(self.go_table.aorrawimage_txt) then
                return
            end
            image:SetNativeSize()
        end
    )
end

---@private
function CelebrationTrialView:RefreshTimeShow(elapsed)
    self.countDown = self.countDown - elapsed
    local time = TimeUtil.TranslateSecond(Mathf.RoundToInt(self.countDown))
    if time.day > 0 then
        self.curStageObj.text = GetLangPackValue(90028900002, GetLangPackValue(90025500011, time.day, GetLangPackValue(90022100002, time.hour, time.min)))
    elseif time.hour > 0 then
        self.curStageObj.text = GetLangPackValue(90028900002, GetLangPackValue(90022100002, time.hour, time.min))
    else
        self.curStageObj.text = GetLangPackValue(90028900002, GetLangPackValue(90000010394, time.min))
    end
end

---@private
function CelebrationTrialView:OnSixUpdate()
    self:RefreshView()
    self.go_table.slider_award.value = CelebrationTrialModel.passTime/100
    for i = 1, 5 do
        self.boxList[i]:Show()
    end
end

---初始化buff显示
function CelebrationTrialView:InitBuffDes()
    self.go_table.aortext_buff1:SetActiveE(1)
    self.go_table.aortext_buff2:SetActiveE(1)
    self.go_table.aortext_buff1:SetLocalPosition(0, 20, 0)
    self.go_table.aortext_buff2:SetLocalPosition(0, -15, 0)
    self.go_table.aortext_buff1.text = ""
    self.go_table.aortext_buff2.text = ""
end

---更新时间
function CelebrationTrialView:UpdateTime(elapsed)
    if not ThemeActivityManager:CheckThemeActivityIsOpen() then
        self:Close()
        return
    end
    self:RefreshTimeShow(elapsed)
end

---初始化宝箱显示
function CelebrationTrialView:InitBox()
    ---@type CelebrationTrialView._obj_box1_GoTable
    self.boxList = {}
    for i = 1, 5 do
        self.boxList[i] = self:AddComponent(self.go_table["obj_box" .. i], CelebrationTrialBoxItem.New(self.go_table["obj_box" .. i], i, _G.handler(self, self.ShowBoxAward)))
        self.boxList[i]:Show()
    end
end

---点击显示宝箱奖励
function CelebrationTrialView:ShowBoxAward(id, isGou)
    if id ~= self.lastBoxId then
        self.lastBoxId = id
        for key, value in pairs(self.itemTable) do
            _G.DestroyObject(value.gameObject)
        end
        local x, y, z = self.go_table["obj_box" .. id]:GetPosition()
        self.go_table.obj_ItemTips:SetPosition(x, y + 1.5, z)
        self.itemTable = {}
        if self.go_table.aorbtn_TipsView:GetActiveSelf() == 0 then
            local tf = self.go_table.obj_ItemTips:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
            if not _G.IsNil(tf) then
                tf:SetSizeWithCurrentAnchors(_G.CS.UnityEngine.RectTransform.Axis.Horizontal, #CelebrationTrialModel.boxesInfo[id].award * 68)
            end
        end
        self.go_table.aorbtn_TipsView:SetActiveE(1)
        for _, v in pairs(CelebrationTrialModel.boxesInfo[id].award) do
            local info = { v.sid, v.num }
            self:CreateItem(info, isGou, self.go_table.obj_Parent, self.itemTable)
        end
    else
        self.go_table.aorbtn_TipsView:SetActiveE(1 - self.go_table.aorbtn_TipsView:GetActiveSelf())
    end
end

---创建宝箱奖励显示item
function CelebrationTrialView:CreateItem(data, isGou, Parent, itemTable)
    if _G.IsNil(Parent) or Parent:GetctiveInHierarchy() == 0 then
        return
    end
    local Sid = data[1]
    if Sid ~= _G.ResPropID.ActiveAch and Sid ~= _G.ResPropID.ActiveValue then
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
                data,
                Parent,
                function(item)
                    item.gameObject:SetLocalScaleXYZ(0.7)
                    item.gameObject:SetActiveE(1)
                    item:SetGou(isGou)
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    table.insert(itemTable, item)
                end,
                function(go, isOn)
                    require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, Sid)
                end
        )
    end
end

---@private
function CelebrationTrialView:OnFight()
    CelebrationTrialModel:OnChallenge()
end

---界面的销毁函数
function CelebrationTrialView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.OnSixUpdate, self)
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---按钮点击事件在这里派发
function CelebrationTrialView:OnClickBtn(go)
    if go == self.go_table.aorbtn_fight then
        self:OnFight()
    elseif go == self.go_table.aorbtn_rank then
        UIManager:OpenWindow(ConfigManager.ui_cfg.CelebrationTrialRankView.Name)
    elseif go == self.go_table.aorbtn_task then
        UIManager:OpenWindow(ConfigManager.ui_cfg.CelebrationTrialTaskView.Name)
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_TipsView then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_TipsView, false)
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 68)
    elseif go == self.go_table.aorbtn_hotHelp then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 69)
    end
end

return CelebrationTrialView
