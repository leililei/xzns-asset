local base = require("BaseGameNet")

---@class WeekSigninNet : BaseGameNet	通信协议
local WeekSigninNet = _G.BaseClass("WeekSigninNet", base)
---@return WeekSigninNet WeekSigninNet
function WeekSigninNet:GetInstance()
    return base.GetInstance(self)
end

---获取服务的  周签到的 信息
---@param pbData table PB数据
---@param callback function 完成回调
function WeekSigninNet:GetSignAccess(callback)
    local item = _G.ConfigManager.net_map.game_week_sign_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.CallInfo))
    self.Call[port] = callback
end

---签到 奖励(天)
---@param pbData number 数据信息
---@field id  number 签到的天数
---@field type number 签到的类型(2 当日签到 3 补签)
function WeekSigninNet:SignAccess(pbData, callBack)
    local item = _G.ConfigManager.net_map.game_week_sign_hand
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallInfo))
    self.Call[port] = callBack
end
---领取周末宝箱
---@param pbData table 累计签到宝箱
---@field id number 累计登录奖励的id
function WeekSigninNet:SignAwardAccess(callBack)
    local item = _G.ConfigManager.net_map.game_week_sign_award
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.CallInfo))
    self.Call[port] = callBack
end
---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function WeekSigninNet:CallInfo(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return WeekSigninNet
