---初始化 数据
--- 转变下 服务器的 状态数据
function WeekSigninModel:InitModelDay()
    for i = 1, weekDayLoopTime do
        local dayinfo = WeekSigninData.New()
        dayinfo:ParseInitMsg({id = i})
        local flag = _G.WeekSigninEnum.unLockDay
        if i <= self.days then
            flag = _G.WeekSigninEnum.signinday
            if _G.table.isEmptyOrNil(self.award_list) then
                flag = _G.WeekSigninEnum.signinday
            else
                for j = 1, #self.award_list do
                    if i == self.award_list[j] then
                        flag = _G.WeekSigninEnum.lingqu
                        break
                    end
                end
            end
        end
        dayinfo:SetSigninEnum(flag)
        if _G.table.isEmptyOrNil(self.all_signday[i]) then
            self.all_signday[i] = {}
        end
        self.all_signday[i] = dayinfo
    end
end

