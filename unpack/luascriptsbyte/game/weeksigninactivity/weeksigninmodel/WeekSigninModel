---天数奖励领取
---@param enum number 天数类型
function WeekSigninModel:SendSeverLingQuReaward(day)
    local pbData = {}
    pbData.id = day
    WeekSigninNet:GetInstance():SignAccess(
        pbData,
        function(data)
            if data.ack ~= 1 then
                return
            end
            --成功修改 数据
            local dayinfo = self:GetSigninInfo(day)
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            --奖励
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
            dayinfo:SetSigninEnum(_G.WeekSigninEnum.lingqu)
            _G.table.insert(self.award_list, day)
            self:RefRedPointWeek()
            _G.Events:GetInstance():Broadcast(_G.EventWeekEnum.LingQuSignWeekAward, day)
        end
    )
end
---周末宝箱领取
---@param day number 累计的天数 配置表 中的 id
function WeekSigninModel:SendSeverWeeken()
    WeekSigninNet:GetInstance():SignAwardAccess(
        function(data)
            if data.ack ~= 1 then
                return
            end
            self:SetWeekenAwardState(2)
            --奖励
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            self:RefRedPointWeek()
            _G.Events:GetInstance():Broadcast(_G.EventWeekEnum.LingquWeekenAward)
        end
    )
end
--6点刷新
function WeekSigninModel:SixUpdata()
    self:RefRedPointWeek()
    local time = _G.TimeUtil.GetSixClockTimer()
    if time == 0 then
        time = 86400
    end
    local timer = _G.TimerManager:GetInstance():GetTimer(time, self.SixOnUpDate, self, true, false, true)
    timer:Start()
end
function WeekSigninModel:SixOnUpDate()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(47) then
        return
    end
    local nowTime = _G.TimeUtil.GetServerUnixTime()
    local endTIme = self.refresh_time + (weekDayLoopTime - 1) * 86400
    if nowTime >= endTIme then
        WeekSigninNet:GetInstance():GetSignAccess(
            function(data)
                if data.ack ~= 1 then
                    return
                end
                self.refresh_time = 0
                self.award_state = 0
                self.days = 1
                self.award_list = {}
                self:ParseDataWeek(data)
                self:RefRedPointWeek()
                _G.Events:GetInstance():Broadcast(_G.EventWeekEnum.JieMian)
            end
        )
        return
    end
