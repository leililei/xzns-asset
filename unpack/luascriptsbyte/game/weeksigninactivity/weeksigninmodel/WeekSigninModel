---检测 是否 是六点 之前
function WeekSigninModel:CheckIsSixTime()
    local flag = false
    local nowTiem = _G.TimeUtil.GetServerUnixTime()
    local nowTb = _G.TimeUtil.GetDateTime(nowTiem)
    ---当天时间的秒数
    local secondNumer = nowTb.hour * 3600 + nowTb.minute * 60 + nowTb.second
    if secondNumer < _G.TimeUtil.GAME_DAY_TIME then
        flag = true
    end
    return flag
end
