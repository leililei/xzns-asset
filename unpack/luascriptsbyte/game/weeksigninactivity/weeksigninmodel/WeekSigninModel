end
---获取 服务器 信息 award_state(id、state)
---@param data s2c_week_sign_info table
---@field ack number 消息
---@field refresh_day number 上次刷新的 时间节点 单位天
---@field award_state number 周末宝箱的 状态 0 不可领取 1 已领取
---@field days number 活动登录的 次数
---@field award_list table  已领取的 id
function WeekSigninModel:ParseDataWeek(data)
    if data.ack ~= 1 then
        return
    end
    self:InitDataWeek(data)
    self.super.ParseData(self)
end
function WeekSigninModel:InitDataWeek(data)
    self.refresh_time = data.time
    if data.award_state == 1 then
        self.award_state = 2
    else
        if self:InitWeekAwardState() then
            self.award_state = 0
        else
            self.award_state = 1
        end
    end

    self.days = data.days or 1
    self.award_list = data.award_list or {}
    self:InitModelDay()
end
---初始化周末 宝箱的状态
function WeekSigninModel:InitWeekAwardState()
    local nowTime = _G.TimeUtil.GetServerUnixTime()
    local tb = _G.TimeUtil.GetDateTime(nowTime)
    local flag = true
    if tb.week == 6 and tb.hour < _G.TimeUtil.GAME_DAY_HOUR then
        --不可领取
    elseif tb.week == 1 and tb.hour == _G.TimeUtil.GAME_DAY_HOUR and tb.minute >= 1 then
        --不可领取
    elseif tb.week == 1 and tb.hour > _G.TimeUtil.GAME_DAY_HOUR then
    elseif tb.week > 1 and tb.week < 6 then
        --不可领取
    else
        flag = false
    end
    return flag
end
---断线重连
function WeekSigninModel:ReConnect(endcall)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(47) then
        if endcall then
            endcall()
        end
        return
    end
    self.all_signday = {}
    self.award_list = {}
    self.days = 1
    WeekSigninNet:GetInstance():GetSignAccess(
        function(data)
            if data.ack ~= 1 then
                return
            end
            self:InitDataWeek(data)
            local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.WeekSigninActivity.Name)
            if window then
                self:RefRedPointWeek()
                _G.Events:GetInstance():Broadcast(_G.EventWeekEnum.JieMian)
            end
        end
    )
    if endcall then
        endcall()
    end
end
