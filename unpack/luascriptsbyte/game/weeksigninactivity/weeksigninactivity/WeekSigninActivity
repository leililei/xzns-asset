function WeekSigninActivity:WeekenBtnOnClickTips()
    local nowTime = _G.TimeUtil.GetServerUnixTime()
    local tb = _G.TimeUtil.GetDateTime(nowTime)
    local flag = true
    if tb.week == 6 and tb.hour < _G.TimeUtil.GAME_DAY_HOUR then
        --不可领取
    elseif tb.week == 1 and tb.hour == _G.TimeUtil.GAME_DAY_HOUR and tb.minute >= 1 then
        --不可领取
    else
        flag = false
    end
    if flag then
        local reaward = self.model:GetWeekenAwardInfo()
        local itemid = reaward[1]
        require("CommonTipManager"):GetInstance():OpenTip(self.go_table.aorbtn_weekTips.gameObject, itemid[1])
    else
        self.model:SendSeverWeeken()
    end
end

--endregion

--region 派发的事件
function WeekSigninActivity:RefresJiemian()
    self:DisposeDayItem()
    self:InitSignData()
end
---刷新某天的 信息
function WeekSigninActivity:RefreshDay(day)
    local node = self.go_table.obj_DayNode
    local dayNode = node:GetChildE(day - 1)
    local tb = _G.GetAutoGoTable(dayNode:GetChildE(0))
    self:UpdateOneDay(tb, day)
end
---刷新 周末宝箱 暂时不需要 刷新
function WeekSigninActivity:RefreshWeekenAward()
    self:SetWeekState()
end
--endregion
--region 特效
---播放特效
---@param parent table 父节点
---@param param number 1 == 普通签到  2== 周末签到特效
---@param tb table 储存信息，界面刷新时调用(隐藏特效)
---@param flag boolean 是否显示特效
function WeekSigninActivity:PlayUIEffect(parent, param, flag)
    local effect_name = uieffect[param]
    local cfg = _G.ConfigManager.ui_effect_cfg[effect_name]
    _G.UIUtils.LoadEffectByCfg(
        cfg,
        parent,
        function(trans)
            _G.GameUtil.SetActiveByCondition(trans, flag)
        end
    )
end

--endregion
--region 释放
function WeekSigninActivity:DisposeDayItem()
    local node = self.go_table.obj_DayNode
    for i = 1, node:GetChildCountE() do
        local daynode = node:GetChildE(i - 1)
        _G.PoolsManager:GetInstance():Despawn(daynode:GetChildE(0), _G.ePoolType.Temporary)
    end
end
--endregion

return WeekSigninActivity
