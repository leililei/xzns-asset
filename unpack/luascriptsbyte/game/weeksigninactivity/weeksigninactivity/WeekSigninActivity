---@class WeekSigninActivity : UIBaseView	中文描述
---@field public go_table WeekSigninActivity_GoTable GoTable
local WeekSigninActivity = _G.BaseClass("WeekSigninActivity", _G.UIBaseView)
--_G.WeekSigninActivity = WeekSigninActivity

local CS = _G.CS
local typeof = _G.typeof
local GetLangPackValue = _G.GetLangPackValue
local dayitem = "UI/WeekSigninActivityPrefab/DayItem"
local daytips = {
    [1] = 90023800038,
    [2] = 90023800039,
    [3] = 90023800040,
    [4] = 90023800041,
    [5] = 90023800042,
    [6] = 90023800043,
    [7] = 90023800044
}
local uieffect = {
    [1] = "ef_putongqiandao",
    [2] = "ef_zhoumoqiandao_1"
}
function WeekSigninActivity:Awake()
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_close"] = self.CloseView,
        ["@_aorbtn_weekBtn"] = self.WeekenBtnOnClick,
        ["@_aorbtn_weekTips"] = self.WeekenBtnOnClickTips,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    self.model = require("WeekSigninModel"):GetInstance()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.currentSelect = {}
    ---设置三个事件
    _G.Events:GetInstance():AddListener(_G.EventWeekEnum.LingQuSignWeekAward, self.RefreshDay, self)
    _G.Events:GetInstance():AddListener(_G.EventWeekEnum.JieMian, self.RefresJiemian, self)
    -- 暂时不需要 刷新周末宝箱
    _G.Events:GetInstance():AddListener(_G.EventWeekEnum.LingquWeekenAward, self.RefreshWeekenAward, self)
end

---界面的入口函数
function WeekSigninActivity:OnCreate()
    self.order = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
    self:InitSignData()
    self:InitEffect()
    self:ShowEffectChangZhuang()
end

function WeekSigninActivity:InitEffect()
    local canvas = self.go_table.obj_weelReward:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
    canvas.sortingOrder = canvas.sortingOrder + self.order
end
---常驻特效
function WeekSigninActivity:ShowEffectChangZhuang()
    --背景
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_WeekSignin_bg_loop, self.go_table.obj_bguieffect)
    --文字
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_WeekSignin_ziti_loop, self.go_table.obj_titleBg)
end
---宝箱特效
function WeekSigninActivity:ShowEffectBox(flag)
    if flag then
        if self.go_table.obj_boxUIeffect:GetChildCountE() > 0 then
            self.go_table.obj_boxUIeffect:SetActiveE(1)
        else
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_WeekSignin_bx_loop,
                self.go_table.obj_boxUIeffect
            )
        end
    else
        self.go_table.obj_boxUIeffect:SetActiveE(0)
    end

    --背景
end
---选中特效
function WeekSigninActivity:ShowEffectDaySelect(node)
    --背景
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_WeekSignin_kuang_loop, node)
end

function WeekSigninActivity:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.EventWeekEnum.LingQuSignWeekAward, self.RefreshDay, self)
    _G.Events:GetInstance():RemoveListener(_G.EventWeekEnum.JieMian, self.RefresJiemian, self)
    --暂时不需要 刷新周末宝箱
    _G.Events:GetInstance():RemoveListener(_G.EventWeekEnum.LingquWeekenAward, self.RefreshWeekenAward, self)
end

---按钮点击事件在这里派发
function WeekSigninActivity:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

--region 初始化数据
function WeekSigninActivity:InitSignData()
    self:SetAddDay()
    --self:SetGrandTotalAward()
    self:SetWeekState()
    --self:SetActiveTime()
end
--endregion

--region 设置界面
function WeekSigninActivity:SetActiveTime()
    local timeArea = self.model:GetActiveTime()
    self.go_table.aortext_ActiveTime.text = GetLangPackValue(90023800032) .. timeArea
end
--设置 周末宝箱领取状态
function WeekSigninActivity:SetWeekState()
    local nowTime = _G.TimeUtil.GetServerUnixTime()
    local tb = _G.TimeUtil.GetDateTime(nowTime)
    local flag = false
    if tb.week == 6 then
        flag = true
    elseif tb.week == 0 then
        flag = true
    end
    if self.model:GetWeekenAwardState() == _G.award_stateEnum.kelingqu then
        flag = true
    end
    self.go_table.aorimage_baoxiang:SetActiveE((not flag) and 1 or 0)
    self.go_table.aorimage_baoxiang_k:SetActiveE(flag and 1 or 0)
    -- ---周末特效
    self:ShowEffectBox(self.model:GetWeekenAwardState() == _G.award_stateEnum.kelingqu)
end
---设置所有天数的信息
function WeekSigninActivity:SetAddDay()
    local node = self.go_table.obj_DayNode
    for i = 1, node:GetChildCountE() do
        local daynode = node:GetChildE(i - 1)
        _G.PoolsManager:GetInstance():Spawn(
            dayitem,
            _G.ePoolType.Temporary,
            daynode,
            function(trans)
                local tb = _G.GetAutoGoTable(trans)
                local Canvas = tb.obj_show:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
                Canvas.sortingOrder = Canvas.sortingOrder + self.order
                self:UpdateOneDay(tb, i)
            end
        )
    end
end
---设置累计天数的奖励
function WeekSigninActivity:SetGrandTotalAward()
    --读取配置表中的信息　进行　设置奖励
    local itemcfg = self.model:GetWeekenCfg()
    self.go_table.aorrawimage_weekReward:LoadImage(itemcfg.icon or itemcfg.Icon)
    self.go_table.aortext_weektips.text = GetLangPackValue(90023800003, self.model:GetWeekenAwardDay())
end
--endregion

--region 更新事件
--更新 某一天
function WeekSigninActivity:UpdateOneDay(tb, da)
    local day = self.model:GetSigninInfo(da)
    local daytip = ""
    local isGray = false
    local reward = day:GetSigninDayReaward()
    local spName = "UI_qrqd_card_normal"
    if day:GetSigninEnum() == _G.WeekSigninEnum.unLockDay then
        --次日显示为 待签到
        if tb.obj_effect:GetChildCountE() > 0 then
            tb.obj_effect:GetChildE(0):SetActiveE(1)
        end
        if da >= 2 or da < 7 then
            local day_ci = self.model:GetSigninInfo(da - 1)
            if day_ci:GetSigninEnum() ~= _G.WeekSigninEnum.unLockDay then
                daytip = "<color=#f4efd8>" .. GetLangPackValue(90023800057) .. "</color>"
            else
                daytip = "<color=#9c4a18>" .. GetLangPackValue(daytips[day.dayid]) .. "</color>"
            end
        elseif da == 1 or da == 7 then
            daytip = "<color = #f4efd8>" .. GetLangPackValue(90023800057) .. "</color>"
        else
            daytip = "<color=#9c4a18>" .. GetLangPackValue(daytips[day.dayid]) .. "</color>"
        end
    elseif day:GetSigninEnum() == _G.WeekSigninEnum.signinday then
        if tb.obj_effect:GetChildCountE() > 0 then
            tb.obj_effect:GetChildE(0):SetActiveE(0)
        else
            --self:PlayUIEffect(tb.obj_effect, 1, true)
            self:ShowEffectDaySelect(tb.obj_effect)
        end
        daytip = "<color=#f4efd8>" .. GetLangPackValue(90000000122) .. "</color>"
    elseif day:GetSigninEnum() == _G.WeekSigninEnum.lingqu then
        isGray = true
        spName = "UI_qrqd_card_off"
        daytip = "<color=#70450e>" .. GetLangPackValue(90023800056) .. "</color>"
        if tb.obj_effect:GetChildCountE() > 0 then
            tb.obj_effect:GetChildE(0):SetActiveE(0)
        end
    end
    tb.aorimage_wupinBg.SpriteName = spName
    tb.aortext_daytip.text = daytip
    local iamge = day:GetItemCfg(reward[1][1])
    tb.aortext_reward.text = GetLangPackValue(iamge.name or iamge.Name)
    tb.aortext_num.text = day:GetReawardNumer(reward[1][2])
    tb.aorrawimage_icon:LoadImage(iamge.icon or iamge.Icon)
    tb.aorrawimage_icon_menghui:LoadImage(iamge.icon or iamge.Icon)
    _G.GameUtil.SetActiveByCondition(tb.obj_gray, isGray)
    tb.aorbtn_itembtn.onClick:RemoveAllListeners()
    tb.aorbtn_itembtn.onClick:AddListener(
        _G.handlerbind(self, self.ItemOnClick, tb, reward, day:GetSigninEnum(), day.dayid)
    )
end
--更新签到
function WeekSigninActivity:UpdateSigninNum(num)
    local node = self.go_table.obj_signin_node
    _G.GameUtil.SetActiveByCondition(node:GetChildE(num - 1), true)
end
--endregion

--region 点击事件
---天数 物品点击事件
---@param reaward table 天数奖励的信息
---@param enum number 天数的类型
function WeekSigninActivity:ItemOnClick(go, reaward, enum, day)
    local itemid = reaward[1]
    if enum == _G.WeekSigninEnum.lingqu or enum == _G.WeekSigninEnum.unLockDay then
        require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, itemid[1])
    else
        self.model:SendSeverLingQuReaward(day)
    end
end

