---@class WeekSigninData	中文描述
local base = require "BaseItemData"
local WeekSigninData = _G.BaseClass("WeekSigninData", base)
_G.WeekSigninData = WeekSigninData

---类的析构函数
function WeekSigninData:Dispose()
    self.dayid = nil
    self.cfg = nil
    self.signinDayEnum = nil
    self.reaward = nil
    self.total = nil
end

function WeekSigninData:ParseInitMsg(data)
    local weekSignCfg = _G.ConfigManager.week_sign_cfg
    self.dayid = data.id or 1
    self.cfg = weekSignCfg[data.id] or {}
    self.signinDayEnum = data.state or _G.WeekSigninData.unlock
    self.reaward = self.cfg.reward or {}
    self.total = self.cfg.total or {}
    self.isLingQu = false
end

--region 设置 、获得
---设置 签到的类型
---@param enum number 签到的类型
function WeekSigninData:SetSigninEnum(enum)
    self.signinDayEnum = enum
end
---获得签到的类型
function WeekSigninData:GetSigninEnum()
    return self.signinDayEnum
end
---获得签到天数的奖励
function WeekSigninData:GetSigninDayReaward()
    return self.reaward
end
---获得签到 累计天数的奖励
function WeekSigninData:GetSigninTotalReaward()
    return self.total
end
---获得 item cfg
---@param itemid number 奖励物品id
function WeekSigninData:GetItemCfg(itemid)
    local itemCfg = {}
    itemCfg = _G.ConfigManager.currency_type_cfg[itemid] or _G.ConfigManager.item_cfg[itemid]
    return itemCfg
end
---数量超过 4位数 显示k,超过5位数显示 m
function WeekSigninData:GetReawardNumer(num)
    return _G.GameUtil.NumberToUnitStr(num)
end
--endregion
return WeekSigninData
