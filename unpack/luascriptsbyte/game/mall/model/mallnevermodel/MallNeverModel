local MallModelBase = require "MallModelBase"
---@class MallNeverModel	中文描述
local MallNeverModel = _G.BaseClass("MallNeverModel", MallModelBase)

---类的构造函数
function MallNeverModel:__init()
end

---类的析构函数
function MallNeverModel:Dispose()
end

---初始化数据
---@param data table 数据
function MallNeverModel:InitData(data)
    self.timesData = {}
    if data and #data > 0 then
        for i = 1, #data do
            self.timesData[data[i].k] = data[i].v
        end
    end
    self.super.InitData(self)
end

---初始化物品列表
function MallNeverModel:InitItems()
    self.itemList = {}
    local cfgs = {}
    local conditionType = 0
    local conditionParams = nil
    for key, value in pairs(_G.ConfigManager.store_active_cfg) do
        if value.is_open then --开放
            if not value.is_display_con then --不满足条件就不显示
                if #value.conditions > 0 then --限制条件
                    for i = 1, #value.conditions do
                        if #value.conditions[i] > 1 then
                            local conditionParams = _G.DeepCopyCfgTable(value.conditions[i])
                            conditionType = conditionParams[1]
                            _G.table.remove(conditionParams, 1)
                            if _G.GlobalConditionManager.CheckMainEventCondition(conditionType, conditionParams) then
                                _G.table.insert(self.itemList, value)
                            end
                        else
                            if _G.AppSetting.DEBUG then
                                _G.Log("商城物品购买限制配置有问题，参数数量不对  id=" .. key)
                            end
                        end
                    end
                else
                    _G.table.insert(self.itemList, value)
                end
            else
                _G.table.insert(self.itemList, value)
            end
        end
    end
    _G.table.sort(
        self.itemList,
        function(a, b)
            if a.display_priority == b.display_priority then
                return a.id < b.id
            else
                return a.display_priority < b.display_priority
            end
        end
    )
end
---获取已经购买次数
---@param id number 商品ID
---@return number 次数
function MallNeverModel:GetBuyTimes(id)
    return self.timesData[id] or 0
end

return MallNeverModel
