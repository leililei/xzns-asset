local MallNet = require "MallNet"
local MallModelBase = require "MallModelBase"

---@class MallCashModel	中文描述
---@field GetInstance fun():MallCashModel
local MallCashModel = _G.BaseClass("MallCashModel", MallModelBase)

---类的构造函数
function MallCashModel:__init()
end

---类的析构函数
function MallCashModel:Dispose()
end

---初始化数据
---@param data table 数据
function MallCashModel:InitData(data)
    self.firstCash = {}
    for i = 1, #data do
        self.firstCash[data[i].k] = data[i].v > 0
    end
    self.super.InitData(self)
end

---初始化物品列表
function MallCashModel:InitItems()
    self.itemList = {}
    for key, value in pairs(_G.ConfigManager.store_recharge_cfg) do
        if value.price ~= 0 or value.price_id ~= 0 then
            _G.table.insert(self.itemList, value)
        end
    end
    _G.table.sort(
        self.itemList,
        function(a, b)
            return a.id < b.id
        end
    )
end

---根据页签类型获取商品列表
function MallCashModel:GetItemListByType(type)
    local vipLv = require "VIPPrivilegeModel":GetInstance().currentVipLevel
    local typeItemList = {}
    for i = 1, #self.itemList do
        if self.itemList[i].type1 == type and vipLv >= self.itemList[i].vip_display then
            _G.table.insert(typeItemList, self.itemList[i])
        end
    end
    return typeItemList
end

function MallCashModel:GetIsFirstCash(id)
    return not self.firstCash[id] or false
end

function MallCashModel:SetFirstCash(curCashId)
    local cfg = _G.ConfigManager.store_recharge_cfg[curCashId]
    if cfg then
        if nil == self.firstCash then
            self.firstCash = {}
        end
        self.firstCash[curCashId] = true
    end
end

function MallCashModel:CheckVoucherRedPoint()
    local unlockIds = _G.PlayerPrefsManager.GetTable("VoucherVIPUnlock") or {}
    local vipLv = require "VIPPrivilegeModel":GetInstance().currentVipLevel

    --- 周免费礼包
    local curBool = require("MallManager"):GetInstance():GetFreeTime()

    if curBool == 0 then
        return true
    end

    for _, v in pairs(self.itemList) do
        if v.type1 == 2 then
            if v.vip_display > 0 and vipLv >= v.vip_display and unlockIds[v.id] == nil then
                return true
            end
        end
    end
    return false
end

function MallCashModel:SetVoucherUnlock()
    local unlockIds = _G.PlayerPrefsManager.GetTable("VoucherVIPUnlock") or {}
    local vipLv = require "VIPPrivilegeModel":GetInstance().currentVipLevel
    for _, v in pairs(self.itemList) do
        if v.type1 == 2 then
            if v.vip_display > 0 and vipLv >= v.vip_display then
                unlockIds[v.id] = true
            end
        end
    end
    _G.PlayerPrefsManager.SetTable("VoucherVIPUnlock", unlockIds)
end

return MallCashModel
