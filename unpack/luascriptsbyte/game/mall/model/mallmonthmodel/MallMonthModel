local MallModelBase = require "MallModelBase"
---@class MallMonthModel	中文描述
local MallMonthModel = _G.BaseClass("MallMonthModel", MallModelBase)

---类的构造函数
function MallMonthModel:__init()
end

---类的析构函数
function MallMonthModel:Dispose()
end

---初始化数据
---@param data table 数据
function MallMonthModel:InitData(data)
    self.timesData = {}
    if data and #data > 0 then
        for i = 1, #data do
            self.timesData[data[i].k] = data[i].v
        end
    end
    self.super.InitData(self)
end
---@param id number goodsId 免费物品id
---@param state boolean 是否已购买
function MallMonthModel:CacheFreeGoodsInfo(id, state)
    if self.FreeGoods == nil then
        self.FreeGoods = {}
    end
    if self.FreeGoods[id] == nil then
        self.FreeGoods[id] = {id = id, state = state}
    else
        self.FreeGoods[id].state = state
    end
end
function MallMonthModel:InitItems()
    self.itemList = {}
    local cfgs = {}
    local conditionType = 0
    local conditionParams = nil
    for key, value in pairs(_G.ConfigManager.store_active_cfg) do
        if value.is_open and value.type_2 == require("MallManager").MallType.month and value.type_1 == 3 then --开放
            if not value.is_display_con then --不满足条件就不显示
                if #value.conditions > 0 then --限制条件
                    for i = 1, #value.conditions do
                        if #value.conditions[i] > 1 then
                            local conditionParams = _G.DeepCopyCfgTable(value.conditions[i])
                            conditionType = conditionParams[1]
                            _G.table.remove(conditionParams, 1)
                            if _G.GlobalConditionManager.CheckMainEventCondition(conditionType, conditionParams) then
                                _G.table.insert(self.itemList, value)
                            end
                        else
                            if _G.AppSetting.DEBUG then
                                _G.Log("商城物品购买限制配置有问题，参数数量不对  id=" .. key)
                            end
                        end
                    end
                else
                    _G.table.insert(self.itemList, value)
                end
            else
                _G.table.insert(self.itemList, value)
            end
        end
    end
    _G.table.sort(
        self.itemList,
        function(a, b)
            if a.display_priority == b.display_priority then
                return a.id < b.id
            else
                return a.display_priority < b.display_priority
            end
        end
    )
end

return MallMonthModel
