---@class MallModelBase : Singleton	中文描述
local MallModelBase = _G.BaseClass("MallModelBase", _G.Singleton)

---@return MallModelBase MallModelBase
function MallModelBase:GetInstance()
    return _G.Singleton.GetInstance(self)
end

---创建对象时,入口构造函数
function MallModelBase:__init()
    self.refreshTime = 0
    self.itemList = {}
end

---销毁对象时,析构函数
function MallModelBase:Dispose()
end

---初始化数据
---@param data table 数据
function MallModelBase:InitData(data)
    self:InitItems()
end
---初始化物品列表
function MallModelBase:InitItems()
end
---获取刷新倒计时
---@return number 刷新倒计时
function MallModelBase:GetRefreshTime()
    return self.refreshTime
end

---获取商品列表
---@return table 商品列表
function MallModelBase:GetItemList()
    return self.itemList
end
---@param id number goodsId 免费物品id
---@param state boolean 是否已购买
function MallModelBase:CacheFreeGoodsInfo(id, state)
end
---@return number 1/0 该类型商店是否还有免费物品未售罄
function MallModelBase:CheckFreeGoodsIsSellOut()
    if not self.FreeGoods then
        return 0
    end
    for k, v in pairs(self.FreeGoods) do
        if v.state == true then
            return 1
        end
    end
    return 0
end
---刷新倒计时
function MallModelBase:UpdateTIme()
    if self.refreshTime <= 0 then
        return
    end
    self.refreshTime = self.refreshTime - 1
end
---获取商品已购买次数
---@param id number 商品ID
---@return 变量类型 中文描述
function MallModelBase:GetItemBuyTimes(id)
    return (self.timesData and self.timesData[id]) and self.timesData[id] or 0
end

---商品已购买的次数
---@param id number 商品id
---@param number number 商品购买的次数
function MallModelBase:SetItemBuyTiems(id, number)
    self.timesData[id] = number
end

return MallModelBase
