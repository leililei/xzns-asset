---支付服务器回调
---@param data store.p2c_store_cash
---@param mock boolean 是否是模拟数据(本地模拟事件, 不是真实的服务器推送)
function MallManager:OnMallCashListener(data, mock)
    if _G.AppSetting.DEBUG then
        _G.Log("MallManager服务器提示支付成功")
    end

    if _G.AppSetting.DEBUG then
        _G.Log(_G.CS.Launcher.Inst.IsSDK, "是否是sdk")
    end

    if not mock then
        _G.StorageManager:GetInstance():ReceiveAwardData(data)
    end

    if data ~= nil and data.total_cash_bool then
        if version == 1 then
            require "MonthlyModel":GetInstance():AddTotalCash(data.cash_rmb)
        elseif version == 2 then
            require "MonthlyModel":GetInstance():AddTotalCash(data.base_rmb)
        end

        local rmb = data.cash_rmb
        -- if _G.AppSetting.IsOverseas and data.base_rmb and data.base_rmb > 0 then
        --     rmb = data.base_rmb
        -- end
        require "InitialManager":GetInstance():UpdateCashNum(data.sid, rmb)
    end

    local giftId = data.sid
    local activityId = data.activity_id
    if giftId then
        if _G.AppSetting.DEBUG then
            _G.Log(giftId, "MallManager活动刷新对应礼包id>>>>>>>>>>>>>")
        end
        if _G.AppSetting.DEBUG then
            _G.Log(activityId, "MallManager活动刷新对应活动id>>>>>>>>>>>>>")
        end
        ---@type store_active_cfg
        local cfg = _G.ConfigManager.store_active_cfg[giftId]
        if cfg ~= nil then
            self:SetItemBuyTimes(cfg.id, cfg.type_reset, self:GetItemBuyTimes(cfg.id, cfg.type_reset) + 1)
        else
            --local str = _G.string.split(giftId, "ykyk")
            if activityId > 0 then
                local ActivitySynManager = require "ActivitySynManager"
                local activity = ActivitySynManager:GetInstance():GetActivityClass(activityId)
                activity.typeClass:SetItemBuyTimes(giftId)

                ---代币的 不走仓库
                local item = activity.typeClass:SetCoin(giftId)
                if item and item.type[2] > 0 then
                    _G.table.insert(data.award.item, item)
                end
            end
        end

        require "MallCashModel":GetInstance():SetFirstCash(giftId)
    end
    if data.cash_rmb ~= nil then
        self.cash_base_rmb = self.cash_base_rmb + data.base_rmb
        if data.total_cash_bool then
            local start = self.cash_rmb
            self.cash_rmb = self.cash_rmb + data.cash_rmb
            self.cash_times = self.cash_times + 1
            require "PopUpGiftBagModel":GetInstance():IsActiveCash()
            require "SDKDotManager":GetInstance():OnEvent(_G.SDKDotType.SDKDot_Recharege, start, self.cash_rmb)
            require "SDKDotManager":GetInstance():OnEvent(_G.SDKDotType.SDKDot_Charge, self.cash_times)
            require "SDKDotManager":GetInstance():OnEvent(_G.SDKDotType.SDKDot_Purchase, data.cash_rmb)
            self:RuTrackEvent(start)
            ---首次充值
            if start <= 0 and self.cash_rmb > 0 then
                if _G.SDKManager:GetInstance():CheckRusChannel() then
                    require("BindAccountModel"):GetInstance():DoAddMainViewQuene()
                end
            end
        end
    end

    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, buyAudioID)
    _G.PopWindowManager:GetInstance():AddAwardPopQuene(data)
    ---判断是否满足首充
    if data.is_all_first ~= nil and data.is_first_cash ~= nil and data.is_all_first ~= 0 and data.is_first_cash ~= 0 then
        --- first_cash number 首充标记 0：未充值  1：已充值
        --- first_time number 首充时间
        require "SDKDotManager":GetInstance():OnEvent(_G.SDKDotType.SDKDot_FirstPurchase, data.cash_rmb)
        _G.SDKManager:GetInstance():TrackEvent(require "SDKDef".DotMsg.Ru.recharge_first)

        if _G.SDKManager:GetInstance():CheckRusChannel() then
            require("BindAccountModel"):GetInstance():DoAddMainViewQuene()
        end
    end
    _G.Events:GetInstance():Broadcast(
        _G.ePlayAactionEvent.PlayAaction,
        {
            _G.ActiveTaskEnum.ConditionEnum.Charge.TotalCharge
        },
        self.cash_rmb
    )

    _G.Events:GetInstance():Broadcast(_G.eRechargeEvent.TotalCash, data)
    _G.Events:GetInstance():Broadcast(_G.eRechargeEvent.DayCash)
    _G.Events:GetInstance():Broadcast(_G.eRechargeEvent.OneCash)
end

---俄罗斯充值上报
function MallManager:RuTrackEvent(_start)
    if not _start then
        _start = 0
    end

    local start = _start/100
    local cash_rmb = self.cash_rmb/100

    if start <= 1 and cash_rmb >= 1 then
        _G.SDKManager:GetInstance():TrackEvent(require "SDKDef".DotMsg.Ru.Rev_1)
    end
    if start < 3 and cash_rmb >= 3 then
        _G.SDKManager:GetInstance():TrackEvent(require "SDKDef".DotMsg.Ru.Rev_3)
    end
    if start < 5 and cash_rmb >= 5 then
        _G.SDKManager:GetInstance():TrackEvent(require "SDKDef".DotMsg.Ru.Rev_5)
    end
    if start < 10 and cash_rmb >= 10 then
        _G.SDKManager:GetInstance():TrackEvent(require "SDKDef".DotMsg.Ru.Rev_10)
    end
    if start < 20 and cash_rmb >= 20 then
        _G.SDKManager:GetInstance():TrackEvent(require "SDKDef".DotMsg.Ru.Rev_20)
    end
    if start < 50 and cash_rmb >= 50 then
        _G.SDKManager:GetInstance():TrackEvent(require "SDKDef".DotMsg.Ru.Rev_50)
    end
    if start < 100 and cash_rmb >= 100 then
        _G.SDKManager:GetInstance():TrackEvent(require "SDKDef".DotMsg.Ru.Rev_100)
    end
end

