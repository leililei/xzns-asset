--- 充值礼包点击购买
---@param price_id number 充值档位id
---@param activityId number 活动id，如果没有传nil即可
---@param giftId number 礼包id
function MallManager:BuyActiveGift(price_id, activityId, giftId, canVoucher)
    _G.SDKManager:GetInstance():ReportData(SDKDef.DotMsg.OverseasFT.pre_initiated_checkout)
    if _G.AppSetting.DEBUG then
        _G.Log("充值礼包购买接口触发>>>>>>>>>>>>>>>")
    end

    if nil == canVoucher then
        canVoucher = true
    end

    if _G.AppSetting.DEBUG then
        _G.Log(price_id, "充值档位配置id")
    end

    ---@type store_gear_cfg
    local gearCfg = _G.ConfigManager.store_gear_cfg[price_id]
    --local gear = utils.getCashGear(gearCfg)
    local sdkGoodsData
    local gear = gearCfg.gear
    for i = 1, #gear do
        sdkGoodsData = self:GetPayGoodsData(gear[i])
        if sdkGoodsData then
            break
        end
    end
    if _G.AppSetting.DEBUG then
        _G.Log(sdkGoodsData.product_id, "充值档位")
    end

    if _G.AppSetting.DEBUG then
        _G.Log(gearCfg.price, "充值金额")
    end

    if _G.AppSetting.DEBUG then
        _G.Log(activityId, "活动id")
    end

    if _G.AppSetting.DEBUG then
        _G.Log(giftId, "礼包id")
    end

    local id = tostring(giftId)
    if activityId then
        id = activityId .. "ykyk" .. id
    end

    local function cashByVoucher()
        local voucherin = _G.StorageManager:GetInstance():GetItemCountBySid(gearCfg.voucher[2][1])
        MallNet:GetInstance():CashByVoucher(
            gearCfg,
            price_id,
            gearCfg.price,
            id,
            function(msg)
                if not msg or msg.ack ~= 1 then
                    return
                end

                local VoucherDiscount = require("VoucherDiscountModel"):GetInstance():GetVoucherDiscountValue()
                if voucherin >= (gearCfg.voucher[1][2] * VoucherDiscount) then
                    _G.StorageManager:GetInstance():ConsumeItem(gearCfg.voucher[2][1], 0,
                        math.floor(gearCfg.voucher[2][2] * VoucherDiscount))
                else
                    if voucherin > 0 then
                        _G.StorageManager:GetInstance():ConsumeItem(gearCfg.voucher[2][1], 0, voucherin)
                        _G.StorageManager:GetInstance():ConsumeItem(gearCfg.voucher[1][1], 0,
                            math.floor(gearCfg.voucher[1][2] * VoucherDiscount) - voucherin)
                    else
                        _G.StorageManager:GetInstance():ConsumeItem(gearCfg.voucher[1][1], 0,
                            math.floor(gearCfg.voucher[1][2] * VoucherDiscount))
                    end
                end
            end
        )
    end
    local function cashByDefault()
        if _G.GameUtil.CheckVoucherModel() and canVoucher then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                218,
                nil,
                function()
                    _G.JumpManager:GetInstance():Jump(213001) -- _G.handlerbind(self, self.BuyVoucher, price_id),
                end,
                function()
                end
            )
            return
        end
        if not sdkGoodsData then
            if _G.AppSetting.DEBUG then
                _G.LogError("没有查询到对应档位的商品配置，请检查挂机后台是否配置，否拉取到对应配置：" .. gear)
            end
            return
        end
        if _G.GameUtil.GetFunctionBlockState(_G.FunctionBlock.rechargeSwitch) then
            _G.LogError("屏蔽充值")
            return
        end
        _G.SDKManager:GetInstance():SendBuyPro(sdkGoodsData, id)
    end

    if canVoucher then
        --外部使用
        local voucher = _G.StorageManager:GetInstance():GetItemCountBySid(gearCfg.voucher[1][1])
        self.voucher = voucher

        --内部使用
        local voucherin = _G.StorageManager:GetInstance():GetItemCountBySid(gearCfg.voucher[2][1])
        self.voucherin = voucherin
        local VoucherDiscount = require("VoucherDiscountModel"):GetInstance():GetVoucherDiscountData()

        local discountNum
        if VoucherDiscount == nil then
            discountNum = 10000
        else
            local value = _G.ConfigManager.item_accumulate_cfg[tonumber(VoucherDiscount.cfg.UseParameter[1][1])]
            discountNum = value.ratio_recharge
        end

        if voucher + voucherin >= math.floor(gearCfg.voucher[1][2] * (discountNum / 10000)) then
            _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OpenDialog, self)
            if VoucherDiscount == nil then
                _G.PopWindowManager:GetInstance():ShowAllTips(
                    470104,
                    nil,
                    cashByVoucher,
                    function()
                        if not _G.GameUtil.CheckVoucherModel() then
                            cashByDefault()
                        end
                    end,
                    nil,
                    nil,
                    gearCfg.voucher[1][2]
                )
            else
                local value = _G.ConfigManager.item_accumulate_cfg[tonumber(VoucherDiscount.cfg.UseParameter[1][1])]
                _G.PopWindowManager:GetInstance():ShowAllTips(
                    470107,
                    nil,
                    cashByVoucher,
                    function()
                        if not _G.GameUtil.CheckVoucherModel() then
                            cashByDefault()
                        end
                    end,
                    nil,
                    nil,
                    _G.GetLangPackValue(VoucherDiscount.cfg.Name),
                    math.floor(gearCfg.voucher[1][2] * (value.ratio_recharge / 10000)),
                    gearCfg.voucher[1][2],
                    (value.ratio_recharge / 100) .. "%"
                )
            end
        else
            cashByDefault()
        end
    else
        cashByDefault()
    end
end

function MallManager:BuyVoucher(price_id)
    local gearCfg = _G.ConfigManager.store_gear_cfg[price_id]
    local num = gearCfg.voucher[1][2]
    local dataList = self:GetMallItemListByType(MallManager.MallType.cash, 2)
    for _, v in pairs(dataList) do
        if v.goods[1][2] >= num then
            self:BuyActiveGift(v.price_id, nil, v.id, false)
            return
        end
    end
    if _G.AppSetting.DEBUG then
        _G.LogError("未匹配到档位id对应的代金券档位: " .. price_id)
    end
end

