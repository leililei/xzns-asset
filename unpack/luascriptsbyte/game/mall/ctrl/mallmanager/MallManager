---获取最后一次的充值信息
---@param reconnect boolean 是否重连请求
function MallManager:GetLastCashInfo(reconnect)
    --拉取订单信息
    MallNet:GetInstance():GetCashInfo(
        function(msg)
            if not msg or not msg.info then
                return
            end
            for _, v in ipairs(msg.info) do
                self:OnMallCashListener(v, reconnect)
                _G.Events:GetInstance():PcallBroadcast(_G.ConfigManager.net_map.store_cash.Cmd, v, reconnect)
            end
        end
    )
end

