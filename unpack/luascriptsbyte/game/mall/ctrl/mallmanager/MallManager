        if _G.GameUtil.CheckVoucherModel() and canVoucher then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                218,
                nil,
                function()
                    _G.JumpManager:GetInstance():Jump(213001) -- _G.handlerbind(self, self.BuyVoucher, price_id),
                end,
                function()
                end
            )
            return
        end
        _G.SDKManager:GetInstance():SendBuy(goodsData)
