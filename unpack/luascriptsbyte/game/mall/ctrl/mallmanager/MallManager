---获取价钱
function MallManager:GetFinalPrice(price_id, isRechargeCfg)
    if price_id > 0 then
        local gearCfg
        if isRechargeCfg then
            gearCfg = _G.ConfigManager.store_recharge_cfg[price_id]
        else
            gearCfg = _G.ConfigManager.store_gear_cfg[price_id]
        end
        if gearCfg then
            return gearCfg.price
        else
            return price_id
        end
    end
    return 0
end

