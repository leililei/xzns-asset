    if _G.AppSetting.DEBUG then
        _G.Log("商城固定充值购买接口触发>>>>>>>>>>>>>>>")
    end

    if _G.AppSetting.DEBUG then
        _G.Log(cfg, "固定充值配置信息")
    end

    if nil == canVoucher then
        canVoucher = true
    end

    --local gear = utils.getCashGear(cfg)
    local sdkGoodsData
    local gear
    if cfg.type1 == 1 then
        gear = cfg.gear
    else
        local gearCfg = _G.ConfigManager.store_gear_cfg[cfg.price_id]
        gear = gearCfg.gear
    end
    for i = 1, #gear do
        sdkGoodsData = self:GetPayGoodsData(gear[i])
        if sdkGoodsData then
            break
        end
    end
    if _G.AppSetting.DEBUG then
        _G.Log(sdkGoodsData.product_id, "充值档位")
    end

    local function cashByDefault()
        if _G.AppSetting.DEBUG then
            _G.Log("sdk充值接口调用")
