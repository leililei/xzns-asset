function MallManager:AddEvent()
    if _G.CS.Launcher.Inst.IsSDK then
        _G.SDKManager:GetInstance():AddListener(SDKDef.GetMsg.can_recharge_true, self.can_recharge_true, self)
        _G.SDKManager:GetInstance():AddListener(SDKDef.GetMsg.can_recharge_false, self.can_recharge_false, self)
        _G.SDKManager:GetInstance():AddListener(SDKDef.GetMsg.pay_success, self.pay_success, self)
        _G.SDKManager:GetInstance():AddListener(SDKDef.GetMsg.pay_failed, self.pay_failed, self)
        _G.SDKManager:GetInstance():AddListener(SDKDef.GetMsg.pay_goods_list, self.GetPayGoodsList, self)
    end

    _G.Events:GetInstance():AddListener(_G.MallCash.StateChange, self.OnMallCashStateChange, self)
    _G.Events:GetInstance():AddListener(_G.eYKNetEvent.ReconnectSuccess, self.OnReconnectSuccess, self)
end

function MallManager:RemoveEvent()
    if _G.CS.Launcher.Inst.IsSDK then
        _G.SDKManager:GetInstance():RemoveListener(SDKDef.GetMsg.can_recharge_true, self.can_recharge_true, self)
        _G.SDKManager:GetInstance():RemoveListener(SDKDef.GetMsg.can_recharge_false, self.can_recharge_false, self)
        _G.SDKManager:GetInstance():RemoveListener(SDKDef.GetMsg.pay_success, self.pay_success, self)
        _G.SDKManager:GetInstance():RemoveListener(SDKDef.GetMsg.pay_failed, self.pay_failed, self)
        _G.SDKManager:GetInstance():RemoveListener(SDKDef.GetMsg.pay_goods_list, self.GetPayGoodsList, self)
    end

    _G.Events:GetInstance():RemoveListener(_G.MallCash.StateChange, self.OnMallCashStateChange, self)
    _G.Events:GetInstance():RemoveListener(_G.eYKNetEvent.ReconnectSuccess, self.OnReconnectSuccess, self)
end

