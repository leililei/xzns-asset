---获取商品数据
function MallManager:GetPayGoodsData(gear)
    if not self.sdkGoodsList then
        if _G.AppSetting.DEBUG then
            _G.LogError("没有商品数据，检查是否拉起了商品数据！")
        end
        _G.SDKManager:GetInstance():SendGetGoodsList()
        return
    end

    for _, v in pairs(self.sdkGoodsList) do
        if v.product_id == gear then
            return v
        end
    end
end

---初始化商场数据
---@param month_time table public.i_k_v  k == 物品id , v = 购买次数
function MallManager:InitDataMall(data)
    local temp_da = {} --
    if not _G.table.isEmptyOrNil(data.month_time) then
        for i = 1, #data.month_time do
            _G.table.insert(temp_da, data.month_time[i])
        end
    end
    if not _G.table.isEmptyOrNil(data.week_time) then
        for i = 1, #data.week_time do
            _G.table.insert(temp_da, data.week_time[i])
        end
    end
    if not _G.table.isEmptyOrNil(data.day_time) then
        for i = 1, #data.day_time do
            _G.table.insert(temp_da, data.day_time[i])
        end
    end
    if not _G.table.isEmptyOrNil(data.all_time) then
        for i = 1, #data.all_time do
            _G.table.insert(temp_da, data.all_time[i])
        end
    end
    self.controllers[MallManager.MallType.Preference]:InitData(temp_da)
end

