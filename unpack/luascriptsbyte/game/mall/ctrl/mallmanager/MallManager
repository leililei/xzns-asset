function MallManager:ParseData(data)
    self.isRecvMallData = true
    self.controllers[MallManager.MallType.month]:InitData(data.month_time or {})
    self.controllers[MallManager.MallType.week]:InitData(data.week_time or {})
    self.controllers[MallManager.MallType.day]:InitData(data.day_time or {})
    self.controllers[MallManager.MallType.never]:InitData(data.all_time or {})
    self.controllers[MallManager.MallType.cash]:InitData(data.all_time or {})
    ---累计充值金额
    self.cash_rmb = data.cash_rmb
    self.cash_base_rmb = data.cash_base_rmb
    ---充值次数
    self.cash_times = data.cash_times
    ---每周免费奖励
    self.FreeGiftWeek = data.week_award
    self:InitDataMall(data)
    base.ParseData(self)

    if self.MallNetCallback then
        self:UpdataCurView()
        self.MallNetCallback()
        self.MallNetCallback = nil
    end

    if not _G.AppSetting.IsArraigned then
        --降神特惠(免费)礼包存储在此处
        local GodSpecialGiftRegularView = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.GodSpecialGiftRegularView.Name)
        if GodSpecialGiftRegularView then
            GodSpecialGiftRegularView.View:UpdateView(true)
        end
        --刷新降神特惠礼包红点
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GiftofGod.id)

        --饰品招募礼包(免费)礼包存储在此处
        local SpiritualDrawGiftPackView = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.SpiritualDrawGiftPackView.Name)
        if SpiritualDrawGiftPackView then
            SpiritualDrawGiftPackView.View:UpdateView(true)
        end
        --刷新饰品招募礼包红点
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SpiritualDrawGiftPack.id)

        require("SevenGiftModel"):GetInstance():ParseData()
        require("SevenGiftGMSynModel"):GetInstance():ParseData()
    end
end

function MallManager:GetPayGoodsList(data)
