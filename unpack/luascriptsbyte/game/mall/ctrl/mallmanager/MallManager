    local fangchenmi_flag = json_data.fangchenmi_flag
    local total_amount = json_data.total_amount

    local canRealRecharge = true

    local tipsId = 290305
    if fangchenmi_flag <= 1 then
        -- 8岁以下或未认证
        canRealRecharge = false
        tipsId = 290305
    elseif fangchenmi_flag == 2 then
        -- 8-16岁
        if self.sendCfgNum > 50 then
            canRealRecharge = false
            tipsId = 290306
        elseif self.sendCfgNum + total_amount > 200 then
            canRealRecharge = false
            tipsId = 290307
        end
    elseif fangchenmi_flag == 3 then
        -- 16-18岁
        if self.sendCfgNum > 100 then
            canRealRecharge = false
            tipsId = 290308
        elseif self.sendCfgNum + total_amount > 400 then
            canRealRecharge = false
            tipsId = 290309
        end
    end

    if canRealRecharge then
        ---这里是版署的已不适配新接口
        -- self:Cash(self.sendCfgId, _G.handler(self, self.FreshPage))
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(
            tipsId,
            nil,
            function()
            end
        )
    end
end

