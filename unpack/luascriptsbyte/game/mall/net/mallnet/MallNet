        --     gear = gearCfg.gear_lenovo
        -- else
        --     if _G.AppSetting.IsAndriod then
        --         gear = gearCfg.gear
        --     elseif _G.AppSetting.IsIos then
        --         gear = gearCfg.gear_ios
        --     else
        --         gear = gearCfg.gear
        --     end
        -- end
        for i = 1, #gearCfg.gear do
            if mallManager:GetPayGoodsData(gearCfg.gear[i]) then
                gear = gearCfg.gear[i]
                break
            end
        end
    else
        gear = gearCfg.gear[1]
    end

    agId = tostring(agId)

    if _G.AppSetting.DEBUG then
        _G.Log(gear, "充值档位")
    end

