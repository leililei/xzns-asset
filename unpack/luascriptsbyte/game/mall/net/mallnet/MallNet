require "BaseGameNet"
---@class MallNet : BaseGameNet	通信协议
local MallNet = _G.BaseClass("MallNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return MallNet MallNet
function MallNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function MallNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function MallNet:Callback(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---获取商城数据
---@param callback function 获取回调
function MallNet:GetMallInfo(callback)
    self:Access(_G.ConfigManager.net_map.game_store_port_get_info, self:GetEmptyPB(), callback)
end

---领取免费礼包
---@param callback function 获取回调
function MallNet:GetMallWeekFree(callback)
    self:Access(_G.ConfigManager.net_map.game_store_port_get_week_award, { id = 0 }, callback)
end

---购买道具
---@param id number 道具ID
---@param callback function 购买回调
function MallNet:BuyItem(id, num, callback)
    self:Access(_G.ConfigManager.net_map.game_store_port_buy, { sid = id, num = num }, callback)
end

