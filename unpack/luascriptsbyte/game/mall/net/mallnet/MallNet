        _G.Log(rmb, "充值金额")
    end

    if _G.AppSetting.DEBUG then
        _G.Log(agId, "充值id")
    end
    self:Access(_G.ConfigManager.net_map.game_cash_cash, { gear = gear, rmb = rmb, active_item_sid = agId }, callback)
end

