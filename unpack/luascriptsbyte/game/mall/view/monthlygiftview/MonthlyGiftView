---@class MonthlyGiftView : UIBaseView	中文描述
---@field public go_table MonthlyGiftView_GoTable GoTable
local MonthlyGiftView = _G.BaseClass("MonthlyGiftView", _G.UIBaseView)
local GetLangPackValue = _G.GetLangPackValue
local store_month_cfg = _G.ConfigManager.store_month_cfg
function MonthlyGiftView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MonthlyGiftView:OnCreate(day)
    local data = store_month_cfg[401003]
    local award = {data.goods_extra[1][1],data.goods_extra[1][2]*day}
    self.go_table.aortext_body.text = GetLangPackValue(90021600059,day,award[2])
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        award,
        self.go_table.obj_node,
        function(item)
            item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
        end
    )
end

---界面的销毁函数
function MonthlyGiftView:OnDestroy()
end

---按钮点击事件在这里派发
function MonthlyGiftView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

return MonthlyGiftView