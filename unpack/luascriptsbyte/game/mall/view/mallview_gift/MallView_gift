local base = require("MallView_base")
---@class MallView_gift : MallView_gift	商城界面_礼包
local MallView_gift = _G.BaseClass("MallView_gift", base)
local MallListItems = require "MallListItems"
---大页签类型（2-特惠；3-礼包；4-月卡）
local type_1 = 3

local Gradient = {
    [1] = {"BAFEA6", "ffffff", "465B34"},
    [2] = {"fdf67f", "ffffff", "d57b21"}
}

---创建对象时,入口构造函数
function MallView_gift:Init(...)
    self.itemObjDic = {}
    self.shopPageList = {}
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        -- ["@_aorbtn_refresh"] = self.ShowRefreshView,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    self.IsFirst = {page = true, goods = true}
    ---1-每日礼包；2-每周礼包；3-每月礼包；4-皮肤礼包
    if ... then
        local args = {...}
        self.CurShopID = args[1]
    else
        self.CurShopID = 1
    end
    self.itemDataList = {}

    if not _G.IsNil(self.go_table.obj_GoldInfo) and self.go_table.obj_GoldInfo:GetctiveInHierarchy() == 1  then
        local resources = _G.GameUtil.GetVoucherResource({11,12})
        self.resource =
            self:AddComponent(
            self.go_table.obj_GoldInfo,
            require("ResourceCompont").New(self.go_table.obj_GoldInfo, resources)
        )
    end

    self.playerHead =
    self:AddComponent(
            self.go_table.obj_PlayerHead,
            require("PlayerComponent").New(self.go_table.obj_PlayerHead)
    )
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    local uiModel = _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.ui_model_1)
    self.go_table.aortext_SubTitle:SetActiveE(uiModel and 0 or 1)
end
function MallView_gift:ClearTimer()
    if self.timer ~= nil then
        self.timer:Stop()
        self.timer = nil
    end
end
function MallView_gift:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    self.Time = nil
    self:ClearTimer()
end

function MallView_gift:OnMallCashListener(data)
    local cfg
    local isActivity
    if self.data then
        isActivity = self.data.GoodsList.isActivity
        for _, value in pairs(self.data.GoodsList) do
            if value.id == data.sid then
                cfg = value
                break
            end
        end
    end
    if cfg and cfg.price_id > 0 then
        if not isActivity then
            if _G.AppSetting.DEBUG then
                _G.Log("商城礼包回调刷新界面")
            end
            require "GiftModel":GetInstance():BuyGift(cfg)
            require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.StoreActive.id)
            self:InitView(true)
        elseif isActivity > 0 then
            if _G.AppSetting.DEBUG then
                _G.Log("活动礼包回调刷新界面")
            end
            local ActivitySynManager = require "ActivitySynManager"
            local activity = ActivitySynManager:GetInstance():GetActivityClass(isActivity)
            if activity.typeClass.BuyGift then
                activity.typeClass:BuyGift(cfg, self.CurShopID)
            end
            self:InitView(true)
        end
    end
end

function MallView_gift:UpdataView()
    if self.gameObject:GetActiveSelf() == 1 then
        self:InitView(true)
    end
end
---初始化界面
function MallView_gift:InitView(notAnim)
    --self.itemDataList = require("MallManager"):GetInstance():GetMallItemList(self.CurShopID)
    self.data = {}
    self.data.CurShopID = self.CurShopID
    local data = self:GetGoods(self.CurShopID)
    if not data then
        self.CurShopID = 1
        self.data.CurShopID = 1
        data = self:GetGoods(self.CurShopID)
    end
    --每日每周读取配置
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.MallView.Name)
    if window and window.View.Lua_chipGift then 
        window.View.Lua_chipGift:Hide()
    end
   
    self.go_table.aorrawimage_Bg:LoadImage("ImagesH5/hMall/ui_lb_bg_banner0" .. self.CurShopID)
    if _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.ui_model_1) then
        self.go_table.aorrawimage_TitleBg:LoadImage("")
    else
        self.go_table.aorrawimage_TitleBg:LoadImage("ImagesH5/hMall/ui_lb_bg_banner0" .. self.CurShopID .. "_guang")
    end
    self.go_table.aorrawimage_Portrait:SetActiveE(self.CurShopID == 2 and 0 or 1)
    self.go_table.obj_spine:SetActiveE(self.CurShopID == 2 and 1 or 0)
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.GiftMallView, self.go_table)
    if self.CurShopID == 2 then
        if not self.roleSpine then
            require("CardInfoManager"):GetInstance().GetRole(
                _G.ConfigManager.card_cfg[111020000].ModelPathHi,
                _G.ePoolType.Temporary,
                self.go_table.obj_spine,
                nil,
                function(trans)
                    if _G.IsNil(self.go_table.obj_spine) then
                        _G.DestroyObject(trans)
                        return
                    end
                    GameUtil.SetCardUiSpineAnimation(trans, "idle", true)
                    self.roleSpine = trans
                end
            )
        end
    else
        self.go_table.aorrawimage_Portrait:LoadImage("ImagesH5/hMall/ui_banner0" .. self.CurShopID .. "_pic")
    end
    self.data.GoodsList = data
    self:SetPage()
    self.data.shopPageList = {}
    self.data.OnPageClick = nil
    self.data.OnGoodsClick = _G.handlerbind(self, self.OnGoodsClick)
    local tb_i = self:GetComponent(self.go_table.obj_MallListItems, MallListItems)
    if tb_i == nil then
        tb_i = self:AddComponent(self.go_table.obj_MallListItems, MallListItems.New(2, self.data))
    end
    tb_i:Show(self.data, self.go_table.obj_MallListItems, notAnim)
    local activityid = self.data.GoodsList.isActivity
    if activityid then
        local ActivitySynManager = require "ActivitySynManager"
        local activity = ActivitySynManager:GetInstance():GetActivityClass(activityid)
        local _, time = activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
        self.Time = time
    else
        self.Time = nil
    end
    if self.CurShopID == 1 then
        self.go_table.aortext_des.text = _G.LangUtil.GetLangPackValue(90000010440)
        -- self.go_table.aorrawimage_Portrait:SetLocalPosition(548, 213.4, 0)
        self.go_table.aortext_Title.text = _G.LangUtil.GetLangPackValue(18900000009)
    elseif self.CurShopID == 2 then
        self.go_table.aortext_des.text = _G.LangUtil.GetLangPackValue(90000010441)
        -- self.go_table.aorrawimage_Portrait:SetLocalPosition(522, 245.4, 0)
        self.go_table.aortext_Title.text = _G.LangUtil.GetLangPackValue(18900000010)
    elseif self.CurShopID == 3 then
        if window and window.View.Lua_chipGift then 
            window.View.Lua_chipGift:Show()
        end
        return 
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Time, self.Time)
    if self.Time and self.Time > 0 then
        self:ClearTimer()
        if self.Time > 86400 then
            self.go_table.aortext_Timer.text =
                _G.LangUtil.GetLangPackValue(
                90022100001,
                _G.math.floor(self.Time / 86400),
                _G.math.floor((self.Time % 86400) / 3600)
            )
        else
            self.go_table.aortext_Timer.text = _G.TimeUtil.TimeToString(self.Time, 1)
        end
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.TimerUpdata, self, false, false, true)
        self.timer:Start()
    else
        self:ClearTimer()
    end
    self:SetGradient(self.CurShopID)
    self.go_table.aortext_Title:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor =
        _G.ColorTools.FormatColorByString(Gradient[self.CurShopID][3])
    self.go_table.aortext_SubTitle:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor =
        _G.ColorTools.FormatColorByString(Gradient[self.CurShopID][3])


end

function MallView_gift:TimerUpdata(elapsed)
    if self.Time > 0 then
        self.Time = self.Time - elapsed
        if self.Time > 86400 then
            self.go_table.aortext_Timer.text =
                _G.LangUtil.GetLangPackValue(
                90022100001,
                _G.math.floor(Mathf.RoundToInt(self.Time) / 86400),
                _G.math.floor((Mathf.RoundToInt(self.Time) % 86400) / 3600)
            )
        else
            self.go_table.aortext_Timer.text = _G.TimeUtil.TimeToString(Mathf.RoundToInt(self.Time), 1)
        end
    end
end
--region 页签
---生成页签
function MallView_gift:SetPage()
    local page, go
    for i = 1, self:GetPages() do
        local index = i
        if not self.shopPageList[index] then
            self.shopPageList[index] = {name = require "GiftModel":GetInstance():GetPagesName(index)}
            page = _G.InstantiateObject(self.go_table.obj_ListItem, self.go_table.obj_yeqian)
            go = _G.GetAutoGoTable(page, _G.handlerbind(self,self.OnPageClick,index))
            self.shopPageList[index].page = page
            self.shopPageList[index].go = go
        else
            page = self.shopPageList[index].page
            go = self.shopPageList[index].go
        end
        go.aortext_Name.text = _G.GetLangPackValue(self.shopPageList[index].name)
        if self.CurShopID == index then
            go.obj_Normal:SetActiveE(0)
            go.obj_Select:SetActiveE(1)
            go.aortext_Name.color = _G.ColorTools.FormatColorByString(_G.AppSetting.IsXzns and "410f0f" or "400E0E")
        else
            go.obj_Normal:SetActiveE(1)
            go.obj_Select:SetActiveE(0)
            go.aortext_Name.color = _G.ColorTools.FormatColorByString(_G.AppSetting.IsXzns and "384562" or "C6B69D")
        end
        if i == 1 then
            go.obj_redpoint:SetActiveE(require "MallManager":GetInstance():CheckFreeGoodsIsSellOut(index))
        elseif i == 2 then
            go.obj_redpoint:SetActiveE(require "MallManager":GetInstance():CheckFreeGoodsIsSellOut(index))
        else
            go.obj_redpoint:SetActiveE(0)
        end
    end
end

function MallView_gift:SetGradient(index)
    local gradient = self.go_table.aortext_Title:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient))
    local gradient2 = self.go_table.aortext_SubTitle:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient))
    -- local gradient = go
    local c1 =  _G.ColorTools.FormatColorByString(Gradient[index][1])
    local c2 =  _G.ColorTools.FormatColorByString(Gradient[index][2])
    local color1 =  _G.CS.UnityEngine.GradientColorKey()
    local color2 =  _G.CS.UnityEngine.GradientColorKey()
    color1.color = c1
    color1.time = 1
    color2.color = c2
    color2.time = 0

    local alpha1 = _G.CS.UnityEngine.GradientAlphaKey()
    local alpha2 = _G.CS.UnityEngine.GradientAlphaKey()

    alpha1.alpha = 255
    alpha1.time = 1
    alpha2.alpha = 255
    alpha2.time = 0

    gradient:SetActiveE(0)
    gradient2:SetActiveE(0)
    gradient:GetGradient():SetKeys({color1,color2},{alpha1,alpha2})
    gradient2:GetGradient():SetKeys({color1,color2},{alpha1,alpha2})
    gradient:SetActiveE(1)
    gradient2:SetActiveE(1)
end


---页签点击后回调
function MallView_gift:OnPageClick(_,_,id)
    self.CurShopID = id
    self:InitView()
end
--endregion

--region 礼包item生成
---缓存礼包基础数据(配置数据)
function MallView_gift:GetGoods(type_2)
    return require "GiftModel":GetInstance():GetGoods(type_2)
end
function MallView_gift:GetPages()
    return require "GiftModel":GetInstance():GetPages()
end
---点击货品的消息
function MallView_gift:OnGoodsClick(listItems, go, index)
    local name = go:GetName()
    local cfg = self.data.GoodsList[index]
    local isActivity = self.data.GoodsList.isActivity
    if name == "@_aorbtn_Btn" then
        if cfg.price_id == 0 then
            if not isActivity then
                require "MallManager":GetInstance():Buy(
                    cfg.id,
                    function(data)
                        require("MallManager"):GetInstance():OnUpMallBuy(data, cfg.id)
                        require "GiftModel":GetInstance():BuyGift(cfg)
                        require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                            _G.ConfigManager.redpoint_cfg.StoreActive.id
                        )
                        self:InitView(true)
                    end
                )
            elseif isActivity > 0 then
                local ActivitySynManager = require "ActivitySynManager"
                local activity = ActivitySynManager:GetInstance():GetActivityClass(isActivity)
                activity.typeClass:BuyActivityGiftFree(
                    cfg.id,
                    function()
                        if _G.AppSetting.DEBUG then
                            _G.Log("活动礼包回调刷新界面")
                        end
                        if activity.typeClass.BuyGift then
                            activity.typeClass:BuyGift(cfg, self.CurShopID)
                        end
                        self:InitView(true)
                    end
                )
            end
        else
            local price_id = cfg.price_id
            local giftId = cfg.id
            if not isActivity then
                require("MallManager"):GetInstance():BuyActiveGift(price_id, nil, giftId)
            elseif isActivity > 0 then
                require("MallManager"):GetInstance():BuyActiveGift(price_id, isActivity, giftId)
            end
        end
    end
end
