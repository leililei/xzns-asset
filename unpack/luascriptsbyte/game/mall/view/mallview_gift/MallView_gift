    base.Hide(self)
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.MallView.Name)
    if window and window.View.Lua_chipGift then 
        window.View.Lua_chipGift:Hide()
    end
end
return MallView_gift
