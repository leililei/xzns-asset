local MallNormalBoxView = _G.BaseClass("MallNormalBoxView", _G.UIBaseView)
--_G.MallNormalBoxView = MallNormalBoxView

local CS = _G.CS
local typeof = _G.typeof

function MallNormalBoxView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MallNormalBoxView:OnCreate(cfg)
    -- self.go_table.obj_discount:SetActiveE(cfg.discount < 10000 and cfg.discount >= 0)
    -- self.go_table.obj_redline:SetActiveE(cfg.discount < 10000 and cfg.discount >= 0)
    -- if cfg.discount < 10000 and cfg.discount >= 0 then
    --     self.go_table.aortext_account.text = _G.Mathf.Ceil(cfg.discount / 10000 * 10)
    --     self.go_table.aortext_accountPrice.text = _G.Mathf.Ceil(cfg.price_original * cfg.discount / 10000)
    -- end
    self.go_table.aortext_price.text = cfg.price
    local createItem, index = nil, 1
    createItem = function()
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            cfg.goods[index],
            self.go_table.trans_content,
            function(item)
                index = index + 1
                if index <= #cfg.goods then
                    createItem()
                end
            end
        )
    end
    createItem()
end

---按钮点击事件在这里派发
function MallNormalBoxView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_bg" then
        self:Close()
    elseif name == "@_aorbtn_buy" then
        _G.PopWindowManager:GetInstance():ShowAllTips(240301)
    end
end

return MallNormalBoxView
