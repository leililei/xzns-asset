local CS = _G.CS
local typeof = _G.typeof
local GetLangPackValue = _G.GetLangPackValue
--region
local MallDayItem = _G.BaseClass("MallDayItem")

function MallDayItem:__init(obj)
    self.gameObject = obj
    self.transform = obj
    self.go_table = _G.GetAutoGoTable(obj)
end

function MallDayItem:Show(data)
    self.gameObject:SetActiveE(1)
    self.go_table.aortext_number.text = "x" .. data[2]
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        data,
        self.go_table.trans_itemRoot,
        function(item)
            self.go_table.aortext_name.text = GetLangPackValue(item.cfg.Name or item.cfg.name)
            item:SetLocalPosition(0, 0, 0)
        end
    )
end

--endregion

---@class MallDayBoxView : UIBaseView	中文描述
---@field public go_table MallDayBoxView_GoTable GoTable
local MallDayBoxView = _G.BaseClass("MallDayBoxView", _G.UIBaseView)
--_G.MallDayBoxView = MallDayBoxView

function MallDayBoxView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.itemList = {}
end

---界面的入口函数
function MallDayBoxView:OnCreate(cfg)
    self.go_table.aortext_name.text = GetLangPackValue(cfg.name)
    self.go_table.aortext_awardDesc.text = GetLangPackValue(90022500394, cfg.day_extra)
    -- self.go_table.obj_discount:SetActiveE(cfg.discount < 10000 and cfg.discount >= 0)
    -- self.go_table.obj_redline:SetActiveE(cfg.discount < 10000 and cfg.discount >= 0)
    -- if cfg.discount < 10000 and cfg.discount >= 0 then
    --     self.go_table.aortext_account.text = _G.Mathf.Ceil(cfg.discount / 10000 * 10)
    --     self.go_table.aortext_accountPrice.text = _G.Mathf.Ceil(cfg.price_original * cfg.discount / 10000)
    -- end
    self.go_table.aortext_price.text = cfg.price
    _G.table.insert(self.itemList, MallDayItem.New(self.go_table.obj_mallDayItem))
    local index = 1
    for i = 1, #cfg.goods do
        local item = self:GetItem(index, self.go_table.trans_contentAward)
        item:Show(cfg.goods[i])
        index = index + 1
    end
    for i = 1, #cfg.goods_extra do
        local item = self:GetItem(index, self.go_table.trans_contentMail)
        item:Show(cfg.goods[i])
        index = index + 1
    end
    for i = index, #self.itemList do
        self.itemList[i]:SetActiveE(0)
    end
end

---按钮点击事件在这里派发
function MallDayBoxView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_bg" then
        self:Close()
    elseif name == "@_aorbtn_buy" then
        _G.PopWindowManager:GetInstance():ShowAllTips(240301)
    end
end

function MallDayBoxView:GetItem(index, parent)
    if self.itemList[index] then
        self.itemList[index]:SetParentE(parent)
        return self.itemList[index]
    end
    local obj = self.go_table.obj_mallDayItem:InstantiatE(parent)
    local item = MallDayItem.New(obj)
    _G.table.insert(self.itemList, item)
    return item
end

return MallDayBoxView
