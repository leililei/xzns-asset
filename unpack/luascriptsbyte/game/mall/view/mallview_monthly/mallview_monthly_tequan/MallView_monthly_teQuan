local MallView_monthly_teQuan = _G.BaseClass("MallView_monthly_teQuan", _G.Component)
local GetLangPackValue = _G.GetLangPackValue
local store_month_cfg = _G.ConfigManager.store_month_cfg
local privilege_cfg = _G.ConfigManager.privilege_cfg

--[[---字体颜色
