    -- end
    -- _G.table.insert(self.PrivisId, sid)
end

function MallView_monthly_teQuan:OnMallCashListener(data)
    self:UpdataView()
end

---销毁对象时,析构函数
function MallView_monthly_teQuan:OnDestroy()
    self.PrivisId = nil
    self.ShowId = nil
    self.TeQuanId = nil
    self.ShowList = nil
    self.PriData = nil
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.UpdataView, self)
end

function MallView_monthly_teQuan:OnDisable()
    self.cardRedpointStates = nil
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
        _G.ConfigManager.redpoint_cfg.PrivilegeCardOfDiamond.id
    )
end

---获取卡牌红点状态
---@param cardId number 卡牌id
---@param flash boolean 是否刷新
---@return boolean 卡牌红点状态
function MallView_monthly_teQuan:GetCardRedpoint(cardId, flash)
    local cfg = store_month_cfg[cardId]
    if not cfg or cfg.type_1 ~= 5 or cfg.type_2 ~= 2 then
        return false
    end
    if not self.cardRedpointStates then
        self.cardRedpointStates = {}
    end

    local state = self.cardRedpointStates[cardId]
    if state ~= nil then
        return state
    end
    if not self.MonthlyModel:IsHavePrivi(cardId) then
        local key = "DiamondPrivilegeCard" .. cardId
        local time = _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
        state = _G.PlayerPrefsManager.GetInt(key) ~= time
        if state and flash then
            _G.PlayerPrefsManager.SetInt(key, time)
            -- require("RedPointManager"):GetInstance():RefreshNode(
            --     _G.ConfigManager.redpoint_cfg.PrivilegeCardOfDiamond.id,
            --     cardId
            -- )
        end
    else
        state = false
    end
    self.cardRedpointStates[cardId] = state
    return state
end

return MallView_monthly_teQuan
