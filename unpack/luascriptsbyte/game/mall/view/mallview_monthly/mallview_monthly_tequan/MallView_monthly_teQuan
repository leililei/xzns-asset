    local sid = self.TeQuanId[index]
    local cfg = store_month_cfg[self.TeQuanId[index]]
    local finalPrice = require "MallManager":GetInstance():GetFinalPrice(cfg.price_id)
    --特权数据，先从store_month_cfg拿到对应的特权id，再从特权配置表获得需要添加的特权
    local mData = store_month_cfg[sid].extra_first
    if cfg.type_2 == 1 then
        self.MonthlyModel:BuyRmb(sid, cfg.price_id, require("MallManager").MallType.monthCard)
    elseif cfg.type_2 == 2 then
        local Diamond = _G.StorageManager:GetInstance():GetItemCountBySid(12)
        if Diamond >= cfg.price_id then
            self.MonthlyModel:BuyByDiamond(
                sid,
                function(msg)
                    self:UpdataView()
                end
            )
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(230303)
        end
    end
