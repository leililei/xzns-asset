function MallView_monthly_teQuan:Awake()
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.UpdataView, self)
end

---创建对象时,入口构造函数
function MallView_monthly_teQuan:OnCreate(obj)
    self.MonthlyModel = require("MonthlyModel"):GetInstance()
    self.go_table = _G.GetAutoGoTable(obj)
    --已激活的特权id
    self.PrivisId = {}
    --展示特权列表ID
    self.ShowId = {}
    self.TeQuanId = {}
    --展示特权列表
    self.ShowList = {}
    self:SetData()
    self:InitView()
end

function MallView_monthly_teQuan:SetData()
    --祝福特权根据策划要求固定死三位
    self.ShowId = self.MonthlyModel.BlessCfg
    for k, v in pairs(self.ShowId) do
        _G.table.insert(self.ShowList, store_month_cfg[v.id].extra_first)
    end
    --已激活的特权卡
    self.PrivisId = require "MonthlyModel":GetInstance().privis or {}
    self.PrivisId = _G.table.KeyToTable(self.PrivisId)
end

---初始化界面
function MallView_monthly_teQuan:InitView()
    if _G.AppSetting.IsXzns then
        _G.GameUtil.SetUiHeXieMask(_G.GetAutoGoTable(self.go_table.obj_BenedictionItem))
    end
    for k, v in pairs(self.ShowId) do
        if not v.display or v.display == 0 or _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(v.display) then
            _G.table.insert(self.TeQuanId, v.id)
        end
    end
    _G.table.sort(
        self.TeQuanId,
        function(a, b)
            local cfga = store_month_cfg[a]
            local cfgb = store_month_cfg[b]
            local isBuya, timea = self.MonthlyModel:IsHavePrivi(a)
            local isBuyb, timeb = self.MonthlyModel:IsHavePrivi(b)
            if isBuya and isBuyb then
                return cfga.display_priority < cfgb.display_priority
            elseif isBuya or isBuyb then
                if isBuya and not isBuyb then
                    return false
                else
                    return true
                end
            else
                return cfga.display_priority < cfgb.display_priority
            end
        end
    )
    self.go_table.scrollloopvectical_blessing:InitItemData(#self.TeQuanId, _G.handler(self, self.RefreshList))
end

---特权奖励展示
function MallView_monthly_teQuan:RefreshList(index, obj)
    index = index + 1
    ---@type View._obj_BenedictionItem_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.ClickBtn, index))
    UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.BenedictionItem, tb)
    local blessId = self.TeQuanId[index]
    local cfg = store_month_cfg[blessId]
    if not tb.LoadAwardNum then
        -- 正在加载的奖励数量（用于防止其他页面跳转，多次刷新页面导致多次异步加载奖励）
        tb.LoadAwardNum = 0
    end
    tb.aorrawimage_bg:LoadImage(cfg.icon[1])
    tb.aorrawimage_title:LoadImage(cfg.icon[2])
    tb.aorrawimage_icon:LoadImage(
        cfg.icon[3],
        function(tran)
            tran:SetNativeSize()
        end
    )
    tb.obj_tips:SetActiveE(cfg.label>0 and 1 or 0)
    if cfg.label>0 then
        tb.aortext_tips.text=GetLangPackValue(cfg.label)
    end
    tb.aortext_title.text = GetLangPackValue(cfg.name)
    if cfg.color then
        tb.aortext_title:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor =
            _G.ColorTools.FormatColorByString(cfg.color)
    else
        tb.aortext_title:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor =
            _G.ColorTools.FormatColorByString("000000")
    end

    tb.aortext_icon.text =
        cfg.day_extra == 0 and GetLangPackValue(90000001066) or GetLangPackValue(90000001143, cfg.day_extra)
    --tb.aorimage_tag:SetActiveE(0)

    if cfg.type_2 == 1 then
        tb.aortext_Price:SetActiveE(1)
        tb.obj_zuan:SetActiveE(0)
        _G.GameUtil.SetPriceByChannel(cfg.price_id, tb.aortext_Price)
        _G.GameUtil.AddDouYinIcon(tb.aorbtn_Buy, true)
    elseif cfg.type_2 == 2 then
        tb.aortext_Price:SetActiveE(0)
        tb.obj_zuan:SetActiveE(1)
        tb.aortext_zuan.text = cfg.price_id
    end

    local isBuy, time = self.MonthlyModel:IsHavePrivi(blessId)
    tb.aorbtn_Buy:SetActiveE(isBuy and 0 or 1)

    tb.aortext_Activated:SetActiveE(isBuy and 1 or 0)
    local day = _G.math.floor(time / 86400)
    tb.aortext_Activated.text =
        time == 0 and GetLangPackValue(90031700205) or
        GetLangPackValue(90028800005, "<color=#29F151>" .. day .. "</color>")
    if cfg.color then
        tb.aortext_Activated:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor =
            _G.ColorTools.FormatColorByString(cfg.color)
    else
        tb.aortext_Activated:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor =
            _G.ColorTools.FormatColorByString("000000")
    end

    local hasRedpoint = self:GetCardRedpoint(blessId, self.gameObject:GetActiveSelf() == 1)
    tb.obj_redpoint:SetActiveE(hasRedpoint and 1 or 0)

    tb.aortext_des.text = GetLangPackValue(cfg.describe)
    if cfg.color then
        tb.aortext_des:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor =
            _G.ColorTools.FormatColorByString(cfg.color)
    else
        tb.aortext_des:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor =
            _G.ColorTools.FormatColorByString("000000")
    end
    -- local pId = self.ShowList[index][1]
    -- if pId then
    --     local data = privilege_cfg[pId]
    --     if _G.table.ContainsValue(whiteList, data.privilege[1][1]) then
    --         tb.aortext_des.text = GetLangPackValue(data.desc)
    --     else
    --         local dataNum = data.privilege[1][3]
    --         ---服务器数据为浮点数，处理数据
    --         if dataNum > 1000 then
    --             dataNum = _G.math.floor(dataNum / 100)
    --         end
    --         tb.aortext_des.text = GetLangPackValue(data.desc, dataNum)
    --     end
    -- else
    --     tb.aortext_des.text = ""
    -- end
    if tb.LoadAwardNum == 0 then
        tb.obj_awards:ClearChildren()
        tb.LoadAwardNum = _G.table.count(cfg.goods1)
        for _, v in pairs(cfg.goods1) do
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                v,
                tb.obj_awards,
                function(item)
                    if not self.go_table then
                        _G.DestroyObject(item)
                        return
                    end
                    tb.LoadAwardNum = tb.LoadAwardNum - 1
                    item:SetGou(isBuy)
                    if item.ShowNumText then
                        item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    end
                    if item.SetGradeNew then
                        item:SetGradeNew(false)
                    end
                    item.gameObject:SetRectTransformSize(100, 100)
                    item.gameObject:SetLocalScaleXYZ(0.8)
                end
            )
        end
    end
end

---激活后更新界面
function MallView_monthly_teQuan:UpdataView()
    self.go_table.scrollloopvectical_blessing:UpdateAllItem()
end

---点击事件在此触发
