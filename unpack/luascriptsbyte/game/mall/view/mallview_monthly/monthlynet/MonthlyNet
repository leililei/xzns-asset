require "BaseGameNet"
require "NetMap"
local base = require("BaseGameNet")
---@class MonthlyNet : BaseGameNet	通信协议
local MonthlyNet = _G.BaseClass("MonthlyNet", base)
---@return MonthlyNet MonthlyNet
function MonthlyNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---月卡信息
---@param callback function 完成回调
function MonthlyNet:GetInfo_month(callback)
    local item = _G.ConfigManager.net_map.game_month_card_info_month
    local pbData = self:GetEmptyPB()
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---特权卡信息
---@param callback function 完成回调
function MonthlyNet:GetInfo_privi(callback)
    local item = _G.ConfigManager.net_map.game_month_card_info_privi
    local pbData = self:GetEmptyPB()
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

--领奖
---@param pbData table PB数据
---@param callback function 完成回调
function MonthlyNet:GetMonthCardGate(pbData, callback)
    local item = _G.ConfigManager.net_map.game_month_card_gate
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---商城购买商品
---@param pbData table PB数据
---@param callback function 完成回调
function MonthlyNet:BuyItem(pbData, callback)
    local item = _G.ConfigManager.net_map.game_store_port_buy
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

function MonthlyNet:UnLockMonthCard(pbData, callback)
    local item = _G.ConfigManager.net_map.game_month_card_unlock
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function MonthlyNet:CallBack(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type MonthlyNet
-- _G.MonthlyNet = MonthlyNet
return MonthlyNet
