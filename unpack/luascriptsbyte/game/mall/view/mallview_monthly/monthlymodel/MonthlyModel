---每日领取周卡
function MonthlyModel:GetWeekCardGate(ShopID, call)
    ---@type month_card.c2s_month_card_gate
    local pbdata = {}
    pbdata.sid = ShopID
    ------@param msg public.s2c_common_ack
    MonthlyNet:GetInstance():GetMonthCardGate(
        pbdata,
        function(msg)
            if msg.ack == 1 then
                self.WeekCfg[ShopID].state = 1
                self:RefreshWeekRedPoint()
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
