---创建对象时,入口构造函数
function MonthlyModel:__init()
    --- 是否初始化过特权 PrivilegeManager:InitPrivilege  (防止6点刷新多次调用)
    self.InitPrivil = false
    local store_month_cfg = _G.ConfigManager.store_month_cfg
    self.monthCfgSidsArr = {}
    ---所有月卡id
    self.monthCfgSids = {}
    self.BlessCfg = {}
    self.WeekCfg = {}
    for key, store_month_cfgItem in pairs(store_month_cfg) do
        if store_month_cfgItem.type_1 == type.MonthCard and store_month_cfgItem.type_2 == 0 then
            self.monthCfgSidsArr[store_month_cfgItem.id] = store_month_cfgItem.id
            self.monthCfgSids[store_month_cfgItem.id] = store_month_cfgItem.id
        elseif store_month_cfgItem.type_1 == type.WeekCard then --初始化周卡数据
            self.WeekCfg[store_month_cfgItem.id] = {
                id = store_month_cfgItem.id,
                cfg = store_month_cfgItem,
                state = 0,
                time = 0
            }
        elseif store_month_cfgItem.type_1 == type.MonthCard and store_month_cfgItem.type_2 == 1 then
            self.monthCfgSids[store_month_cfgItem.id] = store_month_cfgItem.id
        elseif store_month_cfgItem.type_1 == type.PriCard then --初始化祝福特权
            self.BlessCfg[store_month_cfgItem.id] = {
                id = store_month_cfgItem.id,
                display = store_month_cfgItem.display
            }
        end
    end
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    _G.Events:GetInstance():AddListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.FunOpen, self)
end

