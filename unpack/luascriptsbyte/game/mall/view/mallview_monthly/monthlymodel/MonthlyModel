---获取周卡数据 根据排序规则
function MonthlyModel:GetWeekCardSids()
    local tmpArr = {}
    for k, v in pairs(self.WeekCfg) do
        _G.table.insert(tmpArr, v.id)
    end
    _G.SortList(
        tmpArr,
        function(a)
            local state = self.WeekCfg[a].state
            local res
            if state == 2 then
                res = 2
            elseif state == 1 then
                res = 0
            else
                res = 1
            end
            return res, -self.WeekCfg[a].cfg.display_priority
        end
    )
    return tmpArr
end

