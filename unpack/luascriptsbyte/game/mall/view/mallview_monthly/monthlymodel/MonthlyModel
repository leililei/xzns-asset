---激活月卡回调
---@param sid number 月卡sid
function MonthlyModel:UnLockCallBack(data, sid)
    if data.ack == 1 then
        _G.StorageManager:GetInstance():ReceiveAwardData(data)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
        self.monthCardCashs[sid] = nil
        self:BuyRmbSuc(sid)
    end
end

---是否能够激活月卡
---@param sid number 月卡sid
---@return boolean true 月卡能激活
function MonthlyModel:IsCanUnLock(sid)
    if self:GetMonthlyCard(sid) == nil then
        local pc = _G.ConfigManager.store_month_cfg[sid].price_condition_id
        local finalPrice = require "MallManager":GetInstance():GetFinalPrice(pc)
        if self:GetTotalCash(sid) >= finalPrice then
            return true
        end
    end
    return false
end

---增加累计充值金额
---@param count number 金额(分)
function MonthlyModel:AddTotalCash(count)
    local isRefresh = false
    for k, v in pairs(self.monthCfgSidsArr) do
        if not self:IsUnlockMonthCard(v, 1) then
            isRefresh = true
            if self.monthCardCashs[v] == nil then
                self.monthCardCashs[v] = count
            else
                self.monthCardCashs[v] = self.monthCardCashs[v] + count
            end
        end
    end
    if isRefresh then
        --如果购买永久卡是否会导致刷两遍
        require("MallManager"):GetInstance():UpdataView(_G.MallViewPage.monthly)
    end
end

---获取累充金额
---@param sid number 月卡id
---@return number 月卡累充金额
function MonthlyModel:GetTotalCash(sid)
    if self.monthCardCashs[sid] == nil then
        return 0
    end
    return self.monthCardCashs[sid]
end

