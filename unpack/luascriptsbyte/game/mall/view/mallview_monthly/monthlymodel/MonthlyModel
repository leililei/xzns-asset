function MonthlyModel:IsOutTimePopUp(id)
    local nowTime = _G.TimeUtil.GetServerUnixTime()
    for _, v in pairs(self.time_out) do
        if v.key == id and nowTime > v.value then
            local cfg = _G.ConfigManager.store_month_cfg[id]
            local isbuy, time
            if cfg.type_1 == 1 then
                local data = self:GetMonthlyCard(id)
                if data then
                    isbuy = true
                    time = _G.TimeUtil.GetDayBegin(nowTime) + data.time * 86400
                else
                    isbuy = false
                end
            elseif cfg.type_1 == 2 then
                isbuy, time = self:IsHavePrivi(id)
            end
            if isbuy then
                return false
            else
                local lasttime = _G.PlayerPrefsManager.GetInt("store_month_cfg" .. "_" .. id, 0, false)
                if not self.outTime_Cfg then
                    self.outTime_Cfg = _G.ConfigManager.discrete_cfg[126501]
                end
                if (lasttime == 0 or v.value > lasttime) then
                    local Interval_time = _G.TimeUtil.GetIntervalDay(v.value, nowTime)
                    if Interval_time < self.outTime_Cfg[1][1] * 86400 then
                        _G.PlayerPrefsManager.SetInt("store_month_cfg" .. "_" .. id, v.value, false)
                        return true
                    else
                        return false
                    end
                else
                    return false
                end
            end
        end
    end
    return false
end

---检测是不是要直接走广告
function MonthlyModel:CheckShowADTips(callback)
    local yuka1 = self:IsUnlockMonthCard(401001, 1)
    local yuka3 = self:IsUnlockMonthCard(401003, 1)
    if _G.AppSetting.DEBUG then
        _G.Log(yuka1, "月卡1解锁")
        _G.Log(yuka3, "月卡3解锁")
    end
    ---解锁月卡
    if yuka1 or yuka3 then
        if callback then
            callback()
        end
    else
        local showADTips = _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.ShowADTips)
        if showADTips then
            local nowtime = _G.TimeUtil.GetServerUnixTime()
            local savetime = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.ShowPopAdTips)
            local todayTime = _G.TimeUtil.GetDayBySix(nowtime)
            local isChoose = savetime == todayTime
            if not isChoose then
                _G.PopWindowManager:GetInstance():ShowAllTips(
                    1180001,
                    nil,
                    function(isChoose)
                        if isChoose then
                            _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.ShowPopAdTips, todayTime)
                        end
                        if callback then
                            callback()
                        end
                    end,
                    function(isChoose)
                        _G.JumpManager:GetInstance():Jump(148001)
                    end
                )
            else
                --_G.JumpManager:GetInstance():Jump(148001)
                if callback then
                    callback()
                end
            end
        else
            if callback then
                callback()
            end
        end
    end
end

