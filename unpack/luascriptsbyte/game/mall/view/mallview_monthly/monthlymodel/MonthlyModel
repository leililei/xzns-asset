    self:BuyRmbSuc(data.sid)
end

function MonthlyModel:BuyRmbSuc(ShopID)
    local card = _G.ConfigManager.store_month_cfg[ShopID]
    if card ~= nil then
        if card.type_1 == type.MonthCard then
            ---@type MonthlyModel_monthCard
            local data = {}
            data.gate_flag = false
            data.sid = ShopID
            if card.day_extra == 0 then
                --永久卡
                data.time = FOREVERDAY
                local createTime = _G.PlayerModel:GetInstance().create_time
                local curTime = TimeUtil.GetServerUnixTime()
                local day = TimeUtil.GetInterValDayByGame(createTime, curTime)
                data.acc_day = day
            else
                data.time = card.day_extra
            end
            table.insert(self.monthCards, data)
            require "SDKDotManager":GetInstance():OnEvent(_G.SDKDotType.SDKDot_Month)
            if card.day_extra == 0 then
                require "PrivilegeManager":GetInstance():AddPrivilege(card.extra_first[1], true, true)
            elseif card.id == 401002 then 
                for k, v in ipairs(card.extra_first) do 
                    require "PrivilegeManager":GetInstance():AddPrivilege(v, true)
                end
            end
            _G.Events:GetInstance():Broadcast(
                _G.ePlayAactionEvent.PlayAaction,
                { _G.ActiveTaskEnum.ConditionEnum.Mall.PermanentMonthCard, ShopID },
                1
            )
        elseif card.type_1 == type.Gift then
            if #card.extra_first > 0 then
                for i = 1, #card.extra_first do
                    require("PrivilegeManager"):GetInstance():AddPrivilege(card.extra_first[i], true, false)
                end
            end
            local day = _G.TimeUtil.GetTotalDayBy201611() + _G.ConfigManager.store_month_cfg[ShopID].day_extra - 1
            self.privis[ShopID] = day
        elseif card.type_1 == type.WeekCard then
            --_G.PlayerPrefsManager.DeleteKey(WeekKey)
            local time
            if card.day_extra == 0 then
                --永久卡
                time = FOREVERDAY
            else
                time = card.day_extra
            end
            self.WeekCfg[ShopID].state = 2
            self.WeekCfg[ShopID].time = time
            require "SDKDotManager":GetInstance():OnEvent(_G.SDKDotType.SDKDot_Week)
        elseif card.type_1 == type.PriCard then
            if #card.extra_first > 0 then
                for i = 1, #card.extra_first do
                    require("PrivilegeManager"):GetInstance():AddPrivilege(card.extra_first[i], true, false)
                end
            end
            local day = _G.TimeUtil.GetTotalDayBy201611() + _G.ConfigManager.store_month_cfg[ShopID].day_extra - 1
            -- 永久卡day_extra为0
            self.privis[ShopID] = _G.ConfigManager.store_month_cfg[ShopID].day_extra == 0 and 0 or day
            _G.PlayerPrefsManager.SetInt("BlessExpire" .. ShopID, day)
            if card.id == 405007 then
                _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.HeroicMinePrivilegeDay, day)
                require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg
                    .HeroicIconMinePrivilege.id)
            end
            _G.Events:GetInstance():Broadcast(_G.eLimitePrivilege.LimitePrivilegeChange)
        end
    end
    self:RefreshWeekRedPoint()
    self:RefreshMonthRedPoint()
    self:RefreshPrivilegeRedPoint()
    require("MallManager"):GetInstance():UpdataView(_G.MallViewPage.monthly)
    _G.Events:GetInstance():Broadcast(_G.eMonthCard.MonthCardHasActive)
    self.BuyTime = nil
end

