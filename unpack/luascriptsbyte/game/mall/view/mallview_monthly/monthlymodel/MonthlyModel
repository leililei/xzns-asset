---@class type
---@field public MonthCard number 月卡
---@field public Gift number 不知道
---@field public WeekCard number 周卡
---@field public PriCard number 祝福卡
local type = {
    MonthCard = 1,
    --月卡
    Gift = 2,
    --不知道
    WeekCard = 3,
    --周卡
    PriCard = 5
    --祝福卡
}
