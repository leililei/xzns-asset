end

---初始化功能逻辑
function MonthlyModel:InitBlessPrivilege()
    local cfg = _G.ConfigManager.store_month_cfg
    local removeLis = {}
    for k, v in pairs(self.BlessCfg) do
        removeLis[v.id] = true
    end
    local extra_firsts = {}
    local cfgItem
    --- 遍厉特权卡id  读取特权id
    for k, v in pairs(self.privis) do
        cfgItem = _G.ConfigManager.store_month_cfg[k]
        if cfgItem ~= nil and self:IsHavePrivi(k) then
            table.insertto(extra_firsts, cfgItem.extra_first)
            removeLis[k] = false
        end
    end
    local idLis = {}
    for k, v in pairs(removeLis) do
        if v then
            for _, id in pairs(cfg[k].extra_first) do
                _G.table.insert(idLis, id)
            end
        end
    end
    require("PrivilegeManager"):GetInstance():MultiRemovePrivilege(idLis)
    require("PrivilegeManager"):GetInstance():InitPrivilege(extra_firsts)
end

---@return boolean 是否购买月卡
function MonthlyModel:IsUnlockMonthCard(id, _time)
    if _G.table.isEmptyOrNil(self.monthCards) then
        return false
    end
    for i = 1, #self.monthCards do
        if self.monthCards[i].sid == id and self.monthCards[i].time >= _time then
            return true
        end
        if id == 0 and self.monthCards[i].time >= _time then
            return true
        end
    end
    return false
end

---@return boolean 是否购买周卡
function MonthlyModel:IsUnlockWeekCard(id, _time)
    if self.WeekCfg[id] then
        if self.WeekCfg[id].state ~= 0 then
            return true
        end
    end
    return false
end

---@return MonthlyModel_monthCard nil未买该卡
function MonthlyModel:GetMonthlyCard(id)
    if self.monthCards == nil then
        return nil
    end
    for i = 1, #self.monthCards do
        if self.monthCards[i].sid == id then
            return self.monthCards[i]
        end
    end
end

---周卡是否可领取
function MonthlyModel:GetWeekIsCanTake(id)
    local week = self.WeekCfg[id]
    if week then
        if week.state == 2 then
            return true
        end
    end
    return false
end

---@return boolean,number true有该卡, 剩余时间戳
function MonthlyModel:IsHavePrivi(id)
    if self.privis == nil then
        return false, 0
    end
    if self.privis[id] == nil then
        return false, 0
    end
    local time = _G.TimeUtil.CalCountDownByEndTotalDay(self.privis[id])
    if time > 0 or self.privis[id] == 0 then
        -- 永久特权结束时间为0
        return true, time
    end
    return false, 0
end

---@return boolean true有月卡每日可领取,新加可激活月卡
function MonthlyModel:IsHaveMonthCardGate()
    ---是否可激活月卡,flag1 401001为30月卡,flag2 401002为68月卡,配置表store_month_cfg
    ---30月卡改为了直购
    -- local flag1 = self:IsCanUnLock(401001)
    local flag2 = self:IsCanUnLock(401002)
    if flag2 then
        return true
    end
    if not _G.table.isEmptyOrNil(self.monthCards) then
        for i = 1, #self.monthCards do
            if self.monthCards[i].gate_flag == false then
                return true
            end
        end
    end
    if not self:GetMonthlyCard(401003) then
        local createTime = _G.PlayerModel:GetInstance().create_time
        local curTime = TimeUtil.GetServerUnixTime()
        local day = TimeUtil.GetInterValDayByGame(createTime, curTime)
        local value = _G.PlayerPrefsManager.GetInt("isShowMonthlyRepoint", 0)
        if day >= 14 and value ~= 1 then
            _G.PlayerPrefsManager.SetInt("isShowMonthlyRepoint", 1)
            return true
        end
    end
    return false
end

---@return boolean true有周卡每日可领取
