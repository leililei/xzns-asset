---检测祝福红点
function MonthlyModel:CheckPrivilegePoint()
    -- if  _G.table.isEmptyOrNil(self.privis) then
    --     return _G.TimeUtil.GetServerUnixTime()-_G.PlayerPrefsManager.GetInt(PrivilegeKey, 0) >= 604800
    -- end
    local noHaveLis = {}
    for _, v in pairs(self.BlessCfg) do
        if not self:IsHavePrivi(v.id) then
            _G.table.insert(noHaveLis, v.id)
        end
    end
    if #noHaveLis == 0 then
        return false
    end

    local bm = _G.PlayerPrefsManager.GetInt("BlessMonday")
    local time = _G.TimeUtil.GetMondaySixTime()
    if bm ~= time then
        return true
    end

    local expire
    for _, id in pairs(noHaveLis) do
        expire = _G.PlayerPrefsManager.GetInt("BlessExpire" .. id)
        if self.privis and self.privis[id] then
            if expire ~= self.privis[id] then
                return true
            end
        elseif expire > 0 then
            return true
        end
    end

    return false
end

