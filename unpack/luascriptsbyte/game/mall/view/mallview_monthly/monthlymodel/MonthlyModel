---@param msg month_card.s2c_month_card_info_month
function MonthlyModel:ParseMonthData(msg)
    self.Cards = msg.cards or {}
    local len = #self.Cards
    for i = len, 1, -1 do
        local data = self.Cards[i]
        --- 删除0天月卡
        if data.time <= 0 then
            table.remove(self.Cards, i)
        elseif self.monthCfgSids[data.sid] then
            if data.sid == 401003 then
                local store_month_cfg = _G.ConfigManager.store_month_cfg[401003]
                require "PrivilegeManager":GetInstance():AddPrivilege(store_month_cfg.extra_first[1], true, true)
            end
            if data.sid == 401002 then
                local store_month_cfg = _G.ConfigManager.store_month_cfg[401002]
                for k, v in ipairs(store_month_cfg.extra_first) do 
                    require "PrivilegeManager":GetInstance():AddPrivilege(v, true, true)
                end
            end
            _G.table.insert(self.monthCards, data)
        elseif self.WeekCfg[data.sid] then
            self.WeekCfg[data.sid].time = data.time
            self.WeekCfg[data.sid].state = data.gate_flag and 1 or 2
        end
    end
    if msg.card_cash ~= nil then
        local len = #msg.card_cash
        for i = 1, len do
            self.monthCardCashs[msg.card_cash[i].k] = msg.card_cash[i].v
        end
    end
    self.privis = {}
    if msg.g_sids ~= nil then
        for _, v in pairs(msg.g_sids) do
            self.privis[v.id] = v.day
        end
    end
    if msg.time_out then
        for k, v in pairs(msg.time_out) do
            self.time_out[k] = v
        end
    end
    self:InitBlessPrivilege()
    self:GetDataFormServer_End()
    self:RefreshWeekRedPoint()
    self:RefreshMonthRedPoint()
    self:RefreshPrivilegeRedPoint()
end

function MonthlyModel:GetDataFormServer_End()
    self:ParseData()
    require("MallManager"):GetInstance():UpdataView(_G.MallViewPage.monthly)
    local mainview = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    if mainview then
        mainview.View:ShowQuickBtn()
    end

    if self.MonthReConnectCallback then
        self.MonthReConnectCallback()
        self.MonthReConnectCallback = nil
    end
end

