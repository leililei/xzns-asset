---@class MallView_monthly : MallView_base	商城界面-月卡
local MallView_monthly = _G.BaseClass("MallView_monthly", _G.UIBaseView)
local GetLangPackValue = _G.GetLangPackValue
---创建对象时,入口构造函数
local UIinfoCfg = {
    --亮
    _G.Color.New(253 / 255, 244 / 255, 223 / 255),
    --暗
    _G.Color.New(254 / 255, 226 / 255, 193 / 255)
}
function MallView_monthly:OnCreate(...)
    self.ItemList = {}
    self.LuaDic = {
        [1] = require("MallView_monthly_yueKa"),
        -- [2] = require("MallView_monthly_Week"),
        [2] = require("MallView_monthly_teQuan")
    }
    self.itemObjDic = {}
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    self.Cfg = {
        ---月卡
        [1] = {
            Name = GetLangPackValue(90021600012),
            RedPoint = 307001,
            GameObject = self.go_table.obj_yue,
            Lua = nil
        },
        ---周卡
        -- [2] = {
        --     Name = GetLangPackValue(90000010497),
        --     RedPoint = 307002,
        --     GameObject = self.go_table.obj_week,
        --     Lua = nil
        -- },
        ---祝福
        [2] = {
            Name = GetLangPackValue(90000010498),
            RedPoint = 307003,
            GameObject = self.go_table.obj_teQuan,
            Lua = nil
        }
    }
    if ... then
        local args = {...}
        self.nowIndex = args[1]
    else
        self.nowIndex = 1
    end
    self.go_table.scrollloopvectical_YeQian:InitItemData(#self.Cfg, _G.handler(self, self.RefreshItem))
    self:ShowView()
    if not _G.IsNil(self.go_table.obj_GoldInfo) and self.go_table.obj_GoldInfo:GetctiveInHierarchy() == 1 then
        local resources = _G.GameUtil.GetVoucherResource({12})
        self.resource =
            self:AddComponent(
            self.go_table.obj_GoldInfo,
            require("ResourceCompont").New(self.go_table.obj_GoldInfo, resources)
        )
    end
    self.playerHead =
    self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))
end

function MallView_monthly:RefreshItem(index, obj)
    local x = index + 1
    local cfg = self.Cfg[x]
    local gotable = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.ClickYeQian, x))
    if cfg then
        if not self.ItemList[x] then
            self.ItemList[x] = gotable
        end
        gotable.aortext_Name.text = cfg.Name
        gotable.aortext_Name.color = UIinfoCfg[2]
        gotable.obj_redpoint:UpdateRedPointItemIDAndParam(cfg.RedPoint)
        _G.GameUtil.SetActiveByCondition(gotable.obj_Select, self.nowIndex == x)
        if gotable.obj_Effect:GetChildCountE() < 1 then
            _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_MailViewChild, gotable.obj_Effect)
        end
    end
end
function MallView_monthly:ClickYeQian(go, inOn, index)
    if index == self.nowIndex then
        return
    end
    self.ItemList[self.nowIndex].aortext_Name.color = UIinfoCfg[2]
    self.ItemList[self.nowIndex].obj_Select:SetActiveE(0)
    if self.Cfg[self.nowIndex].GameObject then
        self.Cfg[self.nowIndex].GameObject:SetActiveE(0)
    end
    self.nowIndex = index
    self:ShowView()
end
-- function MallView_monthly:Show()
--     base.Show(self)
-- end
-- function MallView_monthly:Hide()
--     base.Hide(self)
-- end

function MallView_monthly:UpdataView()
    self.Cfg[self.nowIndex].Lua:UpdataView()
end

function MallView_monthly:ShowView()
    local cfg = self.Cfg[self.nowIndex]
    self.ItemList[self.nowIndex].obj_Select:SetActiveE(1)
    self.ItemList[self.nowIndex].aortext_Name.color = UIinfoCfg[1]
    if not cfg.GameObject then
        return
    end
    cfg.GameObject:SetActiveE(1)
    if not cfg.Lua then
        cfg.Lua = self:AddComponent(cfg.GameObject, self.LuaDic[self.nowIndex].New(cfg.GameObject))
    else
        cfg.Lua:UpdataView()
    end
end

---销毁对象时,析构函数
function MallView_monthly:OnDestroy()
    self.Cfg = nil
end

return MallView_monthly
