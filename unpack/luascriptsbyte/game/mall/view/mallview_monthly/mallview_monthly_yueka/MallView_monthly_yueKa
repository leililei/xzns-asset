---@param parentTable {awardItems:table,awardCounts:table}
function MallView_monthly_yueKa:CreatItem(data, parent, parentTable, index)
    -- if luaitemDic[data[1]] == data[2] then
    --     return
    -- end
    -- luaitemDic[data[1].. index] = data[2]
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        data,
        parent,
        function(luaItem)
            -- if luaitemDic[data[1]] == nil or luaitemDic[data[1]] ~= data[2] then
            --     require("ItemViewBase").Despawn(luaItem)
            --     return
            -- end
            if luaItem.ShowNumText ~= nil then
                luaItem:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
            luaItem:SetPri(data.isPri)
            if luaItem.SetGradeNew then
                luaItem:SetGradeNew(false)
            end
            --缓存奖励节点
            if parentTable.awardItems then
                parentTable.awardItems[index] = luaItem
            end
            --读取临时存储的奖励数量
            if parentTable.awardCounts and parentTable.awardCounts[index] and luaItem.ShowCount then
                luaItem:ShowCount(parentTable.awardCounts[index])
            end
            --luaitemDic[data[1]] = luaItem
        end
    )
end

function MallView_monthly_yueKa:UpdataView()
    self.isHaveYue = #self.MonthlyModel.monthCards > 0
    for i = 1, #self.goTableKaArr do
        self:Yue_UpdataKa(self.goTableKaArr[i])
    end
    for i = 1, #self.goTableLibaoArr do
        self:Yue_UpdataLibao(self.goTableLibaoArr[i])
    end
end

