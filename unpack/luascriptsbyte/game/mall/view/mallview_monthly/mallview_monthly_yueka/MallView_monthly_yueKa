function MallView_monthly_yueKa:Yue_UpdataKa(goTable)
    local store_month_cfgItem = goTable.store_month_cfgItem
    local monthlyCard = self.MonthlyModel:GetMonthlyCard(store_month_cfgItem.id)
    if
        not _G.AppSetting.IsAlipayPC and require("AdvertisementModel"):GetInstance():CheckADOPen() and
        self.adDic[store_month_cfgItem.id]
    then
        goTable.aortext_adtips1:SetActiveE(1)
        goTable.aortext_adtips2:SetActiveE(1)
        goTable.aortext_adtips1.text = _G.GetLangPackValue(self.adDic[store_month_cfgItem.id])
        goTable.aortext_adtips2.text = _G.GetLangPackValue(self.adDic[store_month_cfgItem.id])
    else
        goTable.aortext_adtips1:SetActiveE(0)
        goTable.aortext_adtips2:SetActiveE(0)
    end
    --- 是否拥有当前这卡
    local isHaveNow = monthlyCard ~= nil

    ---头顶提示类型  1 购买  2 领取
    local tipsType = 0
    if isHaveNow == false then
        tipsType = 1
    else
        tipsType = 2
    end

    ---按钮显示类型 0激活类型  1 Rmb购买  2 魂玉购买 3领取
    local getType = 0
    if isHaveNow == true then
        getType = 3
    else
        getType = store_month_cfgItem.type_2
    end
    local data =
        require "PrivilegeManager":GetInstance():GetPrivilegeDataNew(
            { _G.PrivilegeType.Shop.Month, store_month_cfgItem.id }
        )
    local addCount = _G.table.isEmptyOrNil(data) and 0 or data[1][3]
    local recordBuyCount = function(cfg)
        local goods = _G.table.isEmptyOrNil(cfg.goods) and 0 or cfg.goods[1][2]
        local extraGoodsTotal =
            _G.table.isEmptyOrNil(cfg.goods_extra) and 0 or (cfg.goods_extra[1][2] + addCount) * cfg.day_extra
        return goods + extraGoodsTotal
    end
    local curPrice = 0
    local finalPriceId
    if version == 1 then
        if store_month_cfgItem.type_2 == 0 then
            local finalPrice = require "MallManager":GetInstance():GetFinalPrice(store_month_cfgItem.price_condition_id)
            curPrice = _G.GameUtil.RatioControl(finalPrice)
            finalPriceId = store_month_cfgItem.price_condition_id
        else
            local finalPrice = require "MallManager":GetInstance():GetFinalPrice(store_month_cfgItem.price_id)
            curPrice = _G.GameUtil.RatioControl(finalPrice)
            finalPriceId = store_month_cfgItem.price_id
        end
    elseif version == 2 then
        if store_month_cfgItem.type_2 == 0 then
            local finalPrice = require "MallManager":GetInstance():GetFinalPrice(store_month_cfgItem.price_condition_id)
            curPrice = finalPrice
            finalPriceId = store_month_cfgItem.price_condition_id
        else
            local finalPrice = require "MallManager":GetInstance():GetFinalPrice(store_month_cfgItem.price_id)
            curPrice = finalPrice
            finalPriceId = store_month_cfgItem.price_id
        end
    end
    goTable.obj_extra1:SetActiveE(store_month_cfgItem.goods_extra and store_month_cfgItem.goods_extra[2] and 1 or 0)
    goTable.obj_extra2:SetActiveE(store_month_cfgItem.goods_extra and store_month_cfgItem.goods_extra[2] and 1 or 0)
    if tipsType == 1 then
        local id = store_month_cfgItem.goods[1][1]
        goTable.aorrawimage_icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(id))
        goTable.aortext_getNum.text = store_month_cfgItem.goods[1][2]
        _G.GameUtil.SetActiveByCondition(
            goTable.aortext_tips2,
            not _G.table.isEmptyOrNil(store_month_cfgItem.goods_extra)
        )
        if not _G.table.isEmptyOrNil(store_month_cfgItem.goods_extra) then
            id = store_month_cfgItem.goods_extra[1][1]
            goTable.aorrawimage_icon2:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(id))
            goTable.aortext_getNum2.text = store_month_cfgItem.goods_extra[1][2] + addCount
            if store_month_cfgItem.goods_extra[2] then
                goTable.aortext_getNum21.text = store_month_cfgItem.goods_extra[2][2]
            end
        end
        goTable.aortext_recordGet.text = recordBuyCount(store_month_cfgItem)
        goTable.aorrawimage_recordIcon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(id))
        goTable.aortext_tips3:SetActiveE(0)
        if getType == 0 then
            if store_month_cfgItem.display_priority == 2 then
                goTable.aortext_tips3:SetActiveE(1)
                goTable.aortext_tips3.text = GetLangPackValue(90000011952)
            else
                if version == 1 then
                    goTable.aortext_tips3.text =
                        GetLangPackValue(self.UiDic.langId.lcjh1, GetLangPackValue(90000010819, curPrice))
                elseif version == 2 then
                    goTable.aortext_tips3.text = GetLangPackValue(90000010813, curPrice)
                end
            end
        else
            goTable.aortext_tips3.text = GetLangPackValue(self.UiDic.langId.sdlq)
            if goTable.obj_accumulate then
                goTable.aorrawimage_zuan1:LoadImage(
                    _G.StorageManager:GetInstance():GetItemIcon(store_month_cfgItem.goods_extra[1][1])
                )
            end
            if store_month_cfgItem.goods_extra[2] then
                local id = store_month_cfgItem.goods_extra[2][1]
                if goTable.obj_accumulate then
                    goTable.aorrawimage_quan1:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(id))
                end
                goTable.aorrawimage_quan2:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(id))
                goTable.aorrawimage_icon31:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(id))
            end
        end
    elseif tipsType == 2 then
        if store_month_cfgItem.day_extra ~= 0 then
            goTable.aortext_Gettips.text = GetLangPackValue(self.UiDic.langId.xsday, monthlyCard.time)
        else
            goTable.aortext_Gettips.text = GetLangPackValue(self.UiDic.langId.yjday)
        end
        if goTable.aortext_GetTips3 then
            if store_month_cfgItem.display_priority == 2 then
                goTable.aortext_GetTips3:SetActiveE(1)
                goTable.aortext_GetTips3.text = GetLangPackValue(90000011952)
            else
                goTable.aortext_GetTips3:SetActiveE(0)
            end
        end
        if getType ~= 0 then
            if goTable.obj_accumulate then
                goTable.aorrawimage_zuan1:LoadImage(
                    _G.StorageManager:GetInstance():GetItemIcon(store_month_cfgItem.goods_extra[1][1])
                )
            end
            if store_month_cfgItem.goods_extra[2] then
                local id = store_month_cfgItem.goods_extra[2][1]
                if goTable.obj_accumulate then
                    goTable.aorrawimage_quan1:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(id))
                end
                goTable.aorrawimage_quan2:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(id))
                goTable.aorrawimage_icon31:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(id))
            end
        end
    end
    goTable.obj_tipsBuy:SetActiveE(tipsType == 1 and 1 or 0)
    goTable.obj_tipsGet:SetActiveE(tipsType == 2 and 1 or 0)

    --激活后可以领取的奖励
    local goods = _G.DeepCopyCfgTable(store_month_cfgItem.goods_extra)
    goTable.aortext_getNum3.text = goods[1][2]
    if goods[2] then
        goTable.aortext_getNum31.text = goods[2][2]
    end

    local id = store_month_cfgItem.goods[1][1]
    goTable.aorrawimage_icon3:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(id))

    if getType == 1 then
        _G.GameUtil.AddDouYinIcon(goTable.aorbtn_buyR, true)
    end

    goTable.aorbtn_get:SetActiveE(getType == 3 and 1 or 0)
    goTable.aorbtn_buyR:SetActiveE((getType == 1 or getType == 0) and 1 or 0)
    goTable.aorbtn_buytH:SetActiveE(getType == 2 and 1 or 0)
    if store_month_cfgItem.type_2 == 1 and store_month_cfgItem.day_extra == 0 then
        --获取累计未领取的天数(终身月卡)
        local day =
            monthlyCard and monthlyCard.acc_day or
            TimeUtil.GetInterValDayByGame(_G.PlayerModel:GetInstance().create_time, TimeUtil.GetServerUnixTime())
        if day > 0 then
            local count1 = day * store_month_cfgItem.goods_extra[1][2]
            local count2 = day * store_month_cfgItem.goods_extra[2][2]
            goTable.aortext_accumulate.text = count1 > 9999 and "9999+" or count1
            goTable.aortext_accumulate1.text = count2 > 9999 and "9999+" or count2
            if _G.AppSetting.IsXzns then
                -- goTable.aortext_accumulate.color = _G.ColorTools.FormatColorByString("1ACC55")
                -- goTable.aortext_accumulate1.color = _G.ColorTools.FormatColorByString("1ACC55")
            end
        end
        goTable.obj_accumulate:SetActiveE(day > 0 and 1 or 0)
        --获取缓存的奖励节点(第一个), 显示可领取的奖励
