        _G.SortList(
            cfgArr,
            function(store_exchange_cfgItem)
                return -store_exchange_cfgItem.id
            end
        )

        ---@type store_exchange_cfg[]
        self.yue_LiBaoCfgArr = cfgArr

        local store_exchange_cfgItem
        for i = 1, #self.yue_LiBaoCfgArr do
