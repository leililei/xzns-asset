---@param store_exchange_cfgItem store_exchange_cfg
function MallView_monthly_yueKa:Yue_InitLibao(tran, store_exchange_cfgItem)
    local goTable = _G.GetAutoGoTable(tran)
    goTable.store_exchange_cfgItem = store_exchange_cfgItem
    self:Yue_UpdataLibao(goTable)
    table.insert(self.goTableLibaoArr, goTable)
end

function MallView_monthly_yueKa:Yue_UpdataLibao(goTable)
    ---@type store_active_cfg
    local store_exchange_cfgItem = goTable.store_exchange_cfgItem
    local isMask = false
    local conditionsType, conditionsNum, conditionsStr, isconditions, _
    --- 解锁购买条件  显示条件
    for i = 1, #store_exchange_cfgItem.conditions do
        conditionsType = store_exchange_cfgItem.conditions[i][1]
        conditionsNum = store_exchange_cfgItem.conditions[i][2]
        isconditions, _, conditionsStr = _G.GlobalConditionManager.CheckCondition(conditionsType, conditionsNum)
        if isconditions == false then
            isMask = true
            break
        end
    end

    ---@type Mallltem
    local itemLua
    if goTable.itemlua == nil then
        local lua = self:AddComponent(goTable.gameObject, require("MallItem").New())
        goTable.itemlua = lua
    end
    itemLua = goTable.itemlua

    local tipsStr
    if self.isHaveYue == false then
        ---购买月卡解锁
        tipsStr = GetLangPackValue(self.UiDic.langId.ykjs)
    elseif isMask == true then
        tipsStr = conditionsStr
    end

    local dayTips = {
        -- [1] = "每日限购(%d/%d)",
        -- [2] = "每周限购(%d/%d)",
        -- [3] = "每月限购(%d/%d)",
        -- [4] = "终身限购(%d/%d)"

        [1] = self.UiDic.langId.mrxg,
        [2] = self.UiDic.langId.mzxg,
        [3] = self.UiDic.langId.myxg,
        [4] = self.UiDic.langId.zsxg
    }

    local nowBuyCount =
        require("MallManager"):GetInstance():GetItemBuyTimes(
            store_exchange_cfgItem.id,
            store_exchange_cfgItem.type_reset
        )
    local maxBuyCount = store_exchange_cfgItem.count_limit

    local itemdata = _G.StorageManager:GetInstance():GetStorageItemData(store_exchange_cfgItem.type_price)
    local data = {
        sid = store_exchange_cfgItem.id,
        icon = store_exchange_cfgItem.icon[1],
        count = 1,
        price_id = store_exchange_cfgItem.price_id,
        moneyIcon = itemdata.Icon,
        name = GetLangPackValue(store_exchange_cfgItem.name),
        mask = tipsStr,
        limit = store_exchange_cfgItem.type_reset < 4 and
            GetLangPackValue(dayTips[store_exchange_cfgItem.type_reset], nowBuyCount, maxBuyCount) or
            nil,
        sellout = nowBuyCount >= maxBuyCount,
        saleState = 0
    }

    goTable.Params_id = store_exchange_cfgItem.id
    goTable.Params_price_id = store_exchange_cfgItem.price_id

    itemLua:Show(
        4,
        data,
        goTable.gameObject,
        function()
            self:Yue_OnClick_Libao(goTable)
        end
    )
end

