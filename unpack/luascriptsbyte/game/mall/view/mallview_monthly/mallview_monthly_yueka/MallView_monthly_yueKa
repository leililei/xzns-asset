function MallView_monthly_yueKa:CheckTime()
    local MonthlyModel = require("MonthlyModel"):GetInstance()
    for i = 1, #self.yue_CfgArr do
        if MonthlyModel:IsOutTimePopUp(self.yue_CfgArr[i].id) then
            table.insert(self.OutTimeList, self.yue_CfgArr[i].id)
        end
    end
    if #self.OutTimeList > 0 then
        self:OutTimePopup(self.OutTimeList[1])
    end
end

function MallView_monthly_yueKa:Yue_OnClick_Yue(go, isOn, store_month_cfgItem_id, price_id)
    local btnName = go:GetName()
    -- 永久卡中的钻石和抽卡券的图标需要点击弹出tip
    if _G.string.match(btnName, "@_aorbtn_zuan") then
        require "CommonTipManager":GetInstance():OpenTip(self.gameObject, 12)
        return
    elseif _G.string.match(btnName, "@_aorbtn_quan") then
        require "CommonTipManager":GetInstance():OpenTip(
            self.gameObject,
            _G.ConfigManager.store_month_cfg[store_month_cfgItem_id].goods_extra[2][1]
        )
        return
    end

    local card = self.MonthlyModel:GetMonthlyCard(store_month_cfgItem_id)
    if card == nil then
        ---@type store_month_cfg
        local store_month_cfgItem = _G.ConfigManager.store_month_cfg[store_month_cfgItem_id]
        if store_month_cfgItem == nil then
            if _G.AppSetting.DEBUG then
                _G.LogError("store_month_cfg isnil " .. tostring(store_month_cfgItem_id))
            end
            return
        end
        ---rmb
        if store_month_cfgItem.type_2 == 1 then
            self.MonthlyModel:BuyRmb(store_month_cfgItem_id, price_id, require("MallManager").MallType.monthCard)
        elseif store_month_cfgItem.type_2 == 0 then
            --require("ShopController"):GetInstance():OpenUIWindow(_G.ShopViewEnum.hunyu)
            if self.MonthlyModel:IsCanUnLock(store_month_cfgItem.id) then
                self.MonthlyModel:UnLockMonthCard(store_month_cfgItem.id)
            else
                _G.Events:GetInstance():Broadcast(_G.eMonthCard.MonthCardActive)
            end
        else
            local finalPrice = require "MallManager":GetInstance():GetFinalPrice(price_id)
            self.MonthlyModel:BuyItem(store_month_cfgItem_id, finalPrice)
        end
    else
        self.MonthlyModel:GetMonthCardGate(store_month_cfgItem_id)
    end
    self:CheckTime()
end

function MallView_monthly_yueKa:Yue_OnClick_Libao(goTable)
    local cantBuyCall = function()
        if not self.isHaveYue then
            _G.PopWindowManager:GetInstance():ShowAllTips(240304)
            return
        end
    end
    local store_exchange_cfgItem_id = goTable.Params_id
    local price_id = goTable.Params_price_id
    local finalPrice = require "MallManager":GetInstance():GetFinalPrice(price_id)
    local cantBuy = nil
    if not self.isHaveYue then
        cantBuy = {
            call = cantBuyCall,
            str = "<size=25>" .. GetLangPackValue(self.UiDic.langId.ykjs) .. "</size>"
        }
    end
    ---@type store_exchange_cfg
    local cfg = _G.ConfigManager.store_exchange_cfg[store_exchange_cfgItem_id]
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.MallItemDetailView.Name,
        cfg.id,
        4,
        function()
            self.MonthlyModel:BuyItemByCurrencyItem(
                cfg.type_price,
                store_exchange_cfgItem_id,
                finalPrice,
                cfg.type_reset
            )
        end,
        cantBuy
    )
end

