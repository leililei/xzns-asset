            cfg.ModelPathHi,
            _G.ePoolType.UIItem,
            self.go_table.obj_role,
            function(obj)
                if not self.go_table then
                    _G.DestroyObject(obj)
                    return
                end
            end
        )
    end

    --endregion------------------------------------月卡--------

    --region --------------------------------------礼包--------
    --[[
        local store_month_cfg = _G.ConfigManager.store_month_cfg
        local store_exchange_cfg = _G.ConfigManager.store_exchange_cfg
        cfgArr = {}
        local libao = {}
        for k, v in pairs(store_month_cfg) do
