function MallView_monthly_yueKa:Yue_InitView()
    --region --------------------------------------月卡--------

    local store_month_cfg = _G.ConfigManager.store_month_cfg
    local cfgArr = {}
    ---@param store_month_cfgItem store_month_cfg
    for key, store_month_cfgItem in pairs(store_month_cfg) do
        if store_month_cfgItem.type_1 == 1 then
            table.insert(cfgArr, store_month_cfgItem)
        end
    end
    ---@param store_month_cfgItem store_month_cfg
    _G.SortList(
        cfgArr,
        function(store_month_cfgItem)
            return -store_month_cfgItem.display_priority, -store_month_cfgItem.id
        end
    )

    ---@type store_month_cfg[]
    self.yue_CfgArr = cfgArr
    self:CheckTime()

    local tran, store_month_cfgItem
    for i = 1, #self.yue_CfgArr do
        store_month_cfgItem = self.yue_CfgArr[i]
        if store_month_cfgItem.type_2 == 1 and store_month_cfgItem.day_extra == 0 then
            tran = _G.InstantiateObject(self.go_table.obj_yjka, self.go_table.obj_kaParent)
        else
            tran = _G.InstantiateObject(self.go_table.obj_ka, self.go_table.obj_kaParent)
        end
