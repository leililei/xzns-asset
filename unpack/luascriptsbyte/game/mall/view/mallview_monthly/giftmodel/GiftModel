---该类只负责礼包功能的六点刷新
---@class GiftModel : GameDataModelBase	中文描述
local GiftModel = _G.BaseClass("GiftModel", _G.GameDataModelBase)
local storecfg = _G.ConfigManager.store_active_cfg
---@return GiftModel GiftModel
function GiftModel:GetInstance()
    return self.super.GetInstance(self)
end

function GiftModel:__init()
    self.PageNum = 0
    self.AddActivityDataIds = {} ---从活动中加的物品 暂存活动id 活动结束清数据
end

---1-每日礼包；2-每周礼包；3-特惠礼包(之前是每月礼包)；4-皮肤礼包
local XianGouText = {
    [1] = "90021600007",
    [2] = "90021600008",
    --[3] = "90021600009",
    [4] = "90021600010",
    [3] = "90021600010"
}
local CurShopIDText = {
    [1] = "90021600017",
    [2] = "90021600018",
    --[3] = "90021600019",
    [4] = "90021600020",
    [3] = "90023800099"
}
function GiftModel:GetDataFormServer()
    self:ParseData()
    self:CacheGoodsBaseInfo()
    -- self:CachGoodsExtra()
end

function GiftModel:OnSixClockUpdate(endcall)
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.StoreActive.id)
    --self:CachGoodsExtra()
    require("MallManager"):GetInstance():UpdataView(_G.MallViewPage.gift)
    if endcall then
        endcall()
    end
end

function GiftModel:GetPages()
    return self.PageNum
end

function GiftModel:GetPagesName(i)
    return self.shopGoodsList[i].PageName
end

function GiftModel:CacheGoodsBaseInfo()
    self.PageNum = 0
    if not self.shopGoodsList then
        self.shopGoodsList = {}
        for _, v in pairs(storecfg) do
            if v.type_1 == 3 and v.type_2 ~= 3 then
                -- ZHJH-2494  移除特惠礼包功能
                if self.shopGoodsList[v.type_2] == nil then
                    self.shopGoodsList[v.type_2] = {}
                    self.shopGoodsList[v.type_2].PageName = CurShopIDText[v.type_2]
                    self.PageNum = self.PageNum + 1
                end

                if v.is_open then
                    local list = {}
                    list.cfg = v
                    list.display_priority = v.display_priority
                    list.id = v.id
                    list.icon = v.icon
                    list.items = v.goods
                    list.conditions = v.conditions
                    list.name = _G.LangUtil.GetLangPackValue(v.name)
                    list.count = 1
                    list.price_id = v.price_id
                    list.discount =
                        (v.discount and v.discount > 0) and _G.math.ceil(v.discount * 0.01) .. "%" or nil
                    list.saleState =
                        v.saleState == 0 and nil or v.status_sale
                    list.sellout = false
                    list.limit = nil
                    table.insert(self.shopGoodsList[v.type_2],list)
                end
            end
        end
    end
end

local sortfunc = function(v)
    _G.SortList(
        v,
        function(a)
            local res = a.sellout == true and 0 or 1
            local displayPriority = a.display_priority
            return res, -displayPriority
        end
    )
end
function GiftModel:Sortfunc(index)
    sortfunc(self.shopGoodsList[index])
end

function GiftModel:AddLimitGift(Gifts, ActivityId, PageName)
    local _index
    if not _G.table.isEmptyOrNil(self.shopGoodsList) then
        if not self.AddActivityDataIds[ActivityId] then
            _index = #self.shopGoodsList + 1
        else
            if self.shopGoodsList[self.AddActivityDataIds[ActivityId].index] then
                self.shopGoodsList[self.AddActivityDataIds[ActivityId].index] = nil
                self.PageNum = self.PageNum - 1
                _index = self.AddActivityDataIds[ActivityId].index
            end
        end
    else
        _index = 1
    end
    self.shopGoodsList[_index] = {}
    self.shopGoodsList[_index].PageName = PageName
    self.shopGoodsList[_index].isActivity = ActivityId
    local _data
    for i = 1, #Gifts do
        _data = {}
        _data.display_priority = i
        _data.id = Gifts[i].sid
        _data.icon = Gifts[i].icon
        _data.items = Gifts[i].award
        _data.conditions = Gifts[i].conditions
        _data.name = Gifts[i].name
        _data.count = Gifts[i].count
        _data.price_id = Gifts[i].price_id
        _data.type_reset = Gifts[i].type_reset
        _data.discount =
            (Gifts[i].discount and Gifts[i].discount > 0) and _G.math.ceil(Gifts[i].discount * 0.01) .. "%" or nil
        _data.saleState = nil
        _data.sellout = Gifts[i].sellout
        _data.limit = Gifts[i].limit
        self.shopGoodsList[_index][i] = _data
    end
    self.PageNum = self.PageNum + 1
    self.AddActivityDataIds[ActivityId] = { id = ActivityId, index = _index }
end

function GiftModel:RemoveLimitGift(ActivityId)
    if self.AddActivityDataIds[ActivityId] then
        self.shopGoodsList[self.AddActivityDataIds[ActivityId].index] = nil
        self.PageNum = self.PageNum - 1
    end
end

function GiftModel:CachGoodsExtra()
    if not self.shopGoodsList then
        return
    end
    for k, v in pairs(self.shopGoodsList) do
        if not v.isActivity then
            for i = 1, #v do
                if v[i] and v[i].id then
                    local datanum = require("MallManager"):GetInstance():GetItemBuyTimes(v[i].id, k)
                    v[i].sellout = datanum >= v[i].cfg.count_limit
                    v[i].limit =
                        v[i].cfg.type_reset < 4 and
                        _G.LangUtil.GetLangPackValue(XianGouText[v[i].cfg.type_reset], v[i].cfg.count_limit - datanum,
                            v[i].cfg.count_limit) or
                        nil
                end
            end
            sortfunc(v)
        end
    end
end

function GiftModel:BuyGift(good)
    local datanum = require("MallManager"):GetInstance():GetItemBuyTimes(good.id, good.cfg.type_2)
    good.sellout = datanum >= good.cfg.count_limit
    good.limit =
        good.cfg.type_reset < 4 and
        _G.LangUtil.GetLangPackValue(XianGouText[good.cfg.type_reset], good.cfg.count_limit - datanum,
            good.cfg.count_limit) or
        nil
    sortfunc(self.shopGoodsList[good.cfg.type_2])
end

---得到对应礼包基础数据
function GiftModel:GetGoods(type_2)
    self:CachGoodsExtra()
    local shoplist = {}
    if not self.shopGoodsList or not self.shopGoodsList[type_2] then
        return nil
    end
    shoplist.PageName = self.shopGoodsList[type_2].PageName
    shoplist.isActivity = self.shopGoodsList[type_2].isActivity
    for i = 1, #self.shopGoodsList[type_2] do
        if _G.table.isEmptyOrNil(self.shopGoodsList[type_2][i].conditions) then
            _G.table.insert(shoplist, self.shopGoodsList[type_2][i])
        else
            local xian = true
            for _, n in pairs(self.shopGoodsList[type_2][i].conditions) do
                if not _G.GlobalConditionManager.CheckCondition(n[1], n[2]) then
                    xian = false
                end
            end
            if xian then
                _G.table.insert(shoplist, self.shopGoodsList[type_2][i])
            end
        end
    end
    return shoplist
end

function GiftModel:JumpToActivityPage(activityid)
    local info
    if _G.table.isEmptyOrNil(self.AddActivityDataIds) then
        return
    end
    info = self.AddActivityDataIds[activityid]
    if info then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MallView.Name, _G.MallViewPage.gift, info.index)

        if _G.CS.Launcher.Inst.IsSDK then
            local json =
                _G.Table2Json(
                    {
                        role_uid = _G.PlayerModel:GetInstance().role_uid,
                        role_level = _G.PlayerModel:GetInstance():GetLevel(),
                        role_vip = _G.PlayerModel:GetInstance().vipLv,
                        server_id = tostring(_G.ServerManager:GetInstance().CurServer.ServerID),
                        channel_id = _G.ServerManager:GetInstance().AppInfo.Platform,
                        phone_device = tostring(_G.ServerManager:GetInstance().AppInfo.DeviceID),
                        user_type = 1,
                        record_time = _G.TimeUtil.GetServerUnixTime(),
                        parent_interface = "LimitTimeETG"
                    }
                )
            if _G.AppSetting.DEBUG then
                _G.Log(json, "进入商城界面打点")
            end
            _G.SDKManager:GetInstance():DoShushuData_track("enter_shop_interface", json)
        end
    end
end

--endregion
---销毁对象时,析构函数
function GiftModel:Dispose()
    self.PageNum = nil
end

return GiftModel
