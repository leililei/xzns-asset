---@class MallView_monthly_Week : Component	中文描述
local MallView_monthly_Week = _G.BaseClass("MallView_monthly_Week", _G.Component)

-- local CS = _G.CS
-- local typeof = _G.typeof
local Color = {
    ---未选中 #BCBCBC
    off = require("CardInfoManager").GetColorFromRGB("5a5a5a"),
    ---选中 #FFFFFF
    on = require("CardInfoManager").GetColorFromRGB("815633")
}
local GetLangPackValue = _G.GetLangPackValue
local store_month_cfg = _G.ConfigManager.store_month_cfg
local LoginManager = _G.LoginManager
---创建对象时,入口构造函数
function MallView_monthly_Week:OnCreate(obj)
    self.MonthlyModelIns = require("MonthlyModel"):GetInstance()
    self.WeekItem = {}
    self.WeekData = self.MonthlyModelIns:GetWeekCard()
    self.go_table = _G.GetAutoGoTable(obj)
    self:InitView()
end
function MallView_monthly_Week:InitView()
    self.WeekSids = self.MonthlyModelIns:GetWeekCardSids()
    if not self.First then
        self.go_table.scrollloophorizontal_weekList:InitItemData(#self.WeekSids, _G.handler(self, self.RefrehItem))
        self.First = true
    else
        self.go_table.scrollloophorizontal_weekList:UpdateCount(#self.WeekSids)
    end
    if #self.WeekSids > 2 then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_right, true)
        self.go_table.scrollloophorizontal_weekList:SetContentPosChangeCall(_G.handler(self, self.onValueChanged))
    else
        self.go_table.scrollloophorizontal_weekList:SetContentPosChangeCall()
    end
end
function MallView_monthly_Week:onValueChanged(x)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_left, x < -1)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_right, x > -474 * (#self.WeekSids - 2))
end
function MallView_monthly_Week:RefrehItem(index, obj)
    local x = index + 1
    local sid = self.WeekSids[x]
    local data = self.WeekData[sid]
    local item = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.ClickBtn, x))
    if not self.WeekItem[x] then
        self.WeekItem[x] = item
    end
    if data then
        item.aorbtn_Btn:SetGray(data.state == 1)
        item.aortext_btnTxt.color = data.state == 1 and Color.off or Color.on
        if data.state == 1 then
            item.aortext_btnTxt.text = GetLangPackValue(90025500040)
        elseif data.state == 2 then
            item.aortext_btnTxt.text = GetLangPackValue(90022100029)
        else
            local info = _G.LoginManager:GetInstance():GetGooglePayInfoByPrice(data.cfg.price)
            if info ~= nil then
                item.aortext_btnTxt.text = info.formattedPrice
            else
                if _G.AppSetting.IsOverseas then
                    item.aortext_btnTxt.text = GetLangPackValue(90000010807) .. _G.GameUtil.RatioControl(data.cfg.price)
                else
                    item.aortext_btnTxt.text = GetLangPackValue(90000010819, _G.GameUtil.RatioControl(data.cfg.price))
                end
            end
        end
        item.aorrawimage_icon:LoadImage(
            data.cfg.icon[1],
            function(image)
                image:SetNativeSize()
            end
        )
        item.aorrawimage_desc:LoadImage(
            data.cfg.icon[2],
            function(image)
                image:SetNativeSize()
            end
        )
        _G.GameUtil.SetActiveByCondition(item.aorimage_lastday, data.state > 0)
        if data.state > 0 then
            item.aortext_lastday.text = GetLangPackValue(90021600034, data.time)
        end
        self:CreateItem(data.cfg.goods, item.obj_OnTimeGrid)
        self:CreateItem(data.cfg.goods_extra, item.obj_DailyGrid)
    end
end
function MallView_monthly_Week:CreateItem(data, parent)
    local chileCount = parent:GetChildCountE()
    for i = 1, chileCount do
        _G.PoolsManager:GetInstance():Despawn(parent:GetChildE(0), _G.ePoolType.UIItem)
    end
    if #data > 0 then
        for k, v in pairs(data) do
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                v,
                parent,
                function(tran)
                    tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    tran.gameObject:SetLocalScaleXYZ(0.94)
                    if tran.SetGradeNew then
                        tran:SetGradeNew(false)
                    end
                end
            )
        end
    end
end
function MallView_monthly_Week:ClickBtn(go, isOn, index)
    local sid = self.WeekSids[index]
    local data = self.WeekData[sid]
    local isUnlock = self.MonthlyModelIns:IsUnlockWeekCard(sid)
    if not isUnlock then
        ---rmb
        if data.cfg.type_2 == 1 then
            self.MonthlyModelIns:BuyRmb(sid, data.cfg.price, require("MallManager").MallType.monthCard)
        elseif data.cfg.type_2 == 2 then
            self.MonthlyModelIns:BuyItem(sid, data.cfg.price)
        end
    else
        self.MonthlyModelIns:GetWeekCardGate(sid)
    end
end

function MallView_monthly_Week:UpdataView()
    self:InitView()
end

---销毁对象时,析构函数
function MallView_monthly_Week:OnDestroy()
    self.WeekData = nil
    self.WeekItem = nil
    self.WeekSids = nil
end

function MallView_monthly_Week:OnEnable()
    self.MonthlyModelIns:SetWeekCardKey()
end

return MallView_monthly_Week
