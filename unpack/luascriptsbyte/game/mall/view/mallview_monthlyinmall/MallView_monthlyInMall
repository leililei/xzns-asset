function MallView_monthlyInMall:Show(mallViewPage)
    if mallViewPage == _G.MallViewPage.Privilege then
        self.nowIndex = 1
    elseif mallViewPage == _G.MallViewPage.monthly then
        self.nowIndex = 2
    end
    base.Show(self)
    self:ShowView()
end
function MallView_monthlyInMall:Hide()
    base.Hide(self)
end

function MallView_monthlyInMall:UpdataView()
    self.Cfg[self.nowIndex].Lua:UpdataView()
end

function MallView_monthlyInMall:ShowView()
    local cfg = self.Cfg[self.nowIndex]
    -- self.ItemList[self.nowIndex].obj_Select:SetActiveE(1)
    -- self.ItemList[self.nowIndex].aortext_Name.color = UIinfoCfg[1]
    if not cfg.GameObject then
        return
    end
    -- cfg.GameObject:SetActiveE(1)
    for k, v in pairs(self.Cfg) do
        v.GameObject:SetActiveE(k == self.nowIndex and 1 or 0)
    end
    if not cfg.Lua then
        cfg.Lua = self:AddComponent(cfg.GameObject, self.LuaDic[self.nowIndex].New(cfg.GameObject))
    else
        cfg.Lua:UpdataView()
    end
end

---销毁对象时,析构函数
function MallView_monthlyInMall:OnDestroy()
    self.Cfg = nil
end

return MallView_monthlyInMall
