---@class MallView_artifactGift : UIBaseView	
---@field go_table MallView_artifactGift_GoTable
local MallView_artifactGift = _G.BaseClass("MallView_artifactGift", _G.UIBaseView)
local storeCfg = _G.ConfigManager.store_extra_cfg
local StorageManager = _G.StorageManager:GetInstance()

function MallView_artifactGift:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function MallView_artifactGift:OnDestroy()
    self:RemoveAllListener()
end

function MallView_artifactGift:OnCreate()
    self:InitView()
end

---初始化视图
function MallView_artifactGift:InitView()
    local data = storeCfg[510502]
    self.giftData = data
    for k, v in pairs(data.goods) do
        StorageManager:GetItemBaseViewNew(
            v,
            self.go_table.obj_items,
            function(trans)
                trans:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                trans:ShowEffectOrder(true)
            end
        )
    end
    _G.GameUtil.SetPriceByChannel(self.giftData.price_id, self.go_table.aortext_giftprice)
    _G.GameUtil.AddDouYinIcon(self.go_table.aorbtn_buygift, true)
end

---处理按钮事件
function MallView_artifactGift:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_buygift then
        require("MallManager"):GetInstance():BuyActiveGift(self.giftData.price_id, nil, self.giftData.id)
    elseif go == self.go_table.aorbtn_hide then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

function MallView_artifactGift:CloseView()
    self:Close()
end

return MallView_artifactGift
