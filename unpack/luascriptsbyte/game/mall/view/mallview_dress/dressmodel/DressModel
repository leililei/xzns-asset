---初始化商品数据
function DressModel:CacheGoodsBaseInfo()
    local cfglist = {}
    for i, v in pairs(storecfg) do
        cfglist[v.id] = v
    end
    if AppSetting.IsXzns then
        for i, v in pairs(_G.ConfigManager.store_god_dress_cfg) do
            table.insert(cfglist,v)
        end
    end

    local cfglist = {}
    for i, v in pairs(storecfg) do
        cfglist[v.id] = v
    end
    if AppSetting.IsXzns then
        for i, v in pairs(_G.ConfigManager.store_god_dress_cfg) do
            table.insert(cfglist,v)
        end
    end

    local insert = _G.table.insert
    if not self.shopGoodsList then
        self.shopGoodsList = {}
        for _, v in pairs(cfglist) do
            if self.shopGoodsList[v.subtab] == nil then
                self.shopGoodsList[v.subtab] = {}
                self.shopGoodsList[v.subtab].PageName = CurShopIDText[v.subtab]
                self.shopGoodsList[v.subtab].type = v.subtab
                self.shopGoodsList[v.subtab].show = false
            end
            local isOpen = true
            if not _G.table.isEmptyOrNil(v.conditions) then
                isOpen = _G.GlobalConditionManager.CheckCondition(v.conditions[1], v.conditions[2])
            end
            if not v.reveal and isOpen then
                local data = {}
                data.cfg = v
                data.display_priority = v.display_priority
                data.id = v.id
                data.items = v.get_item
                data.conditions = v.condition_limit
                data.count = 1
                data.need_item = v.need_item
                data.sellout = false
                data.limit = v.count_limit
                self.shopGoodsList[v.subtab].show = true
                insert(self.shopGoodsList[v.subtab], data)
            end
        end

    end
end

local sortfunc = function(v)
    _G.SortList(
        v,
        function(a)
            local res = a.sellout == true and 0 or 1
            local isHave = a.isHave == true and 0 or 1
            local displayPriority = a.display_priority
            return res, isHave, -displayPriority
        end
    )
end

function DressModel:Sortfunc(index)
    sortfunc(self.shopGoodsList[index])
end

---检测商品已购买次数
function DressModel:CachGoodsExtra(subtab)
    local MallManager = require("MallManager"):GetInstance()
    if not self.shopGoodsList[subtab] then
        return
    end
    for i = 1, #self.shopGoodsList[subtab] do
        local datanum = MallManager:GetItemBuyTimes(self.shopGoodsList[subtab][i].id, MallManager.MallType.never)
        self.shopGoodsList[subtab][i].sellout = datanum >= self.shopGoodsList[subtab][i].limit
        local condition = self.shopGoodsList[subtab][i].conditions
        local isHave = self:CheckIsHave(condition[1], condition[2])
        self.shopGoodsList[subtab][i].isHave = isHave
    end
    sortfunc(self.shopGoodsList[subtab])
end

---得到对应礼包基础数据
function DressModel:GetGoods(subtab,cfg)
    self:CachGoodsExtra(subtab)
    if not self.shopGoodsList[subtab] then
        return nil
    end
    local list = {}
    if cfg == nil then
        cfg = storecfg
    end
    local proplist = self.shopGoodsList[subtab]
    local count = #proplist
    for i = 1, count do
        if cfg[proplist[i].cfg.id] then
            table.insert(list,proplist[i])
        end
    end
    list.PageName = proplist.PageName
    list.type = proplist.type
    list.show = proplist.show
    return list
end

---代币购买商品
function DressModel:BuyItem(item, call)
    if item == nil then
        return
    end
    if item.isHave or item.sellOut then
        return
    end
    if item.cfg then
        if not _G.StorageManager:GetInstance():CheckItem(item.need_item[1], item.need_item[2]) then
            _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.CoinLimit)
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.GetItemWayView.Name,
               item.need_item[1]
            )
            return
        end
    end
    MallNet:GetInstance():BuyItem(item.id, 1, _G.handlerbind(self, self.BuyItemSuc, item, call))
end

---购买物品返回
function DressModel:BuyItemSuc(data, item, call)
    if data.ack ~= 1 then
        return
    end
    local MallManager = require("MallManager"):GetInstance()
    MallManager:SetItemBuyTimes(item.id, MallManager.MallType.never, 1)
    _G.StorageManager:GetInstance():ConsumeItem(item.need_item[1], 0, item.need_item[2])
    _G.StorageManager:GetInstance():ReceiveAwardData(data)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
    if call ~= nil then
        call()
    end
end

---销毁对象时,析构函数
function DressModel:Dispose()
    self.PageNum = nil
end

---检查是否拥有该物品
---@param type number 类型
---@param id number 物品id
function DressModel:CheckIsHave(type, id)
    local target = StoreType[type]
    if target == 1 then
        return _G.PlayerModel:GetInstance():IsUnlockFrame(id)
    elseif target == 2 then
        return _G.PlayerModel:GetInstance():IsUnlockTitle(id)
    elseif target == 3 then
        return _G.PlayerModel:GetInstance():IsUnlockHalo(id)
    elseif target == 4 then
        return require "CardCommentManager":GetInstance():CheckSkin(id)
    elseif target == 5 then
        return require "ChatManager":GetInstance():IsExpressionUnlocked(id)
    elseif target == 6 then
        return require "ChatManager":GetInstance():IsExpressionUnlocked(id)
    elseif target == 7 then
        --神环
        return _G.PlayerModel:GetInstance():IsUnlockGodHalo(id)
    elseif target == 8 then
        --聊天框
        return _G.PlayerModel:GetInstance():IsUnlockChatFrame(id)
    elseif target == 9 then
        --头像
        return _G.PlayerModel:GetInstance():GetIsHasHeadShot(id)
    elseif target == 10 then
        return require("ArtifactIllustrationModel"):GetInstance():CheckIsHasSkinBySid(id)
    end
    return false
end

---是否显示时装入口
function DressModel:CheckShowDressBtn(shopID)
    if shopID then
        if self.shopGoodsList[shopID].show then
            return true
        end
    else
        for k, v in pairs(self.shopGoodsList) do
            if v.show then
                return true
            end
        end
    end
    return false
end

return DressModel
