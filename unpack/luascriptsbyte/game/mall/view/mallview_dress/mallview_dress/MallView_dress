---刷新页签
function MallView_dress:SetPage()
    local page, go
    for i = 1, #self.Cfg do
        local index = i
        if not self.Cfg[index].page then
            page = _G.InstantiateObject(self.go_table.obj_ListItem, self.go_table.obj_yeqian)
            go = _G.GetAutoGoTable(page, _G.handlerbind(self, self.OnPageClick, index))
            self.Cfg[index].page = page
            self.Cfg[index].go = go
        else
            page = self.Cfg[index].page
            go = self.Cfg[index].go
        end
        go.aortext_Name.text = self.Cfg[index].Name
        if self.nowIndex == index then
            self.Cfg[index].go.obj_Normal:SetActiveE(0)
            self.Cfg[index].go.obj_Select:SetActiveE(1)
            self.Cfg[index].go.aortext_Name.color = _G.Color(64 / 255, 14 / 255, 14 / 255)
        else
            self.Cfg[index].go.obj_Normal:SetActiveE(1)
            self.Cfg[index].go.obj_Select:SetActiveE(0)
            self.Cfg[index].go.aortext_Name.color = _G.Color(198 / 255, 182 / 255, 157 / 255)
        end
        go.obj_redpoint:SetActiveE(0)
    end
end

---页签点击后回调
function MallView_dress:OnPageClick(_, _, id)
    if id == self.nowIndex then
        return
    end
    self.nowIndex = id

    self:ShowView()
    local res = {}

    self.go_table.obj_MallListItems1:SetActiveE(self.nowIndex == 1 and 1 or 0)
    self.go_table.obj_MallListItems2:SetActiveE(self.nowIndex == 1 and 0 or 1)

    if self.nowIndex == 1 then
        res = { 13 }
    else
        res = { 73, 90 }
    end

    self.resource:RestRs(res)
end

---显示商店详情
function MallView_dress:ShowView()
    local cfg = self.Cfg[self.nowIndex]
    if not cfg.ScrollList then
        return
    end
    for i = 1, #self.Cfg do
        if self.nowIndex == i then
            self.Cfg[i].go.obj_Normal:SetActiveE(0)
            self.Cfg[i].go.obj_Select:SetActiveE(1)
            self.Cfg[i].ScrollList:SetActiveE(1)
            self.Cfg[i].go.aortext_Name.color = _G.Color(64 / 255, 14 / 255, 14 / 255)
        else
            self.Cfg[i].go.obj_Normal:SetActiveE(1)
            self.Cfg[i].go.obj_Select:SetActiveE(0)
            self.Cfg[i].ScrollList:SetActiveE(0)
            self.Cfg[i].go.aortext_Name.color = _G.Color(198 / 255, 182 / 255, 157 / 255)
        end
    end

    cfg.ScrollList:SetActiveE(1)
    self.curData = self:GetGoods(cfg.shopID)
    if not cfg.init then
        if cfg.shopID == 4 or cfg.shopID == 6 then
            if self.sceneTrans then
                self.sceneTrans:SetActiveE(0)
            end
            cfg.ScrollList:InitItemData(#self.curData, _G.handler(self, self.RefreshSkin))
        else
            if self.sceneTrans then
                self.sceneTrans:SetActiveE(0)
            end
            cfg.ScrollList:InitItemData(#self.curData, _G.handler(self, self.RefershItem))
        end
        cfg.init = true
    else
        if self.sceneTrans then
            self.sceneTrans:SetActiveE(self.nowIndex == 3 and 1 or 0)
        end
        cfg.ScrollList:UpdateAllItem(self.curData)
    end

    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(288) or not self:GetGoods(6).show then
        self.go_table.obj_yeqian:SetActiveE(0)
        if self.rectHeight == nil then
            local _, rectHeight = self.go_table.scrollloopvectical_skin:GetRectTransformWidthHeight()
            self.go_table.scrollloopvectical_skin:UpdateScrollRectHeight(rectHeight + 72)
            self.rectHeight = true
        end
    else
        self.go_table.obj_yeqian:SetActiveE(1)
    end
end

---刷新皮肤列表
function MallView_dress:RefreshSkin(index, obj)
    local x = index + 1
    local itemdata = _G.StorageManager:GetItemDataClassByCfg(self.curData[x].items)
    local skinid = tonumber(itemdata.cfg.UseParameter[1][1])
    local skinData = CardCommentManager:GetCfgs(skinid)
    local data = self.curData[x]
    local tb = _G.GetAutoGoTable(obj,
        _G.handlerbind(self, self.OnClickBuy, self.curData[x], itemdata))

    local number = self.curData[x].sellout == true and 1 or 0
    tb.aortext_ItemName.text = GetLangPackValue(itemdata.cfg.Name)
    tb.aortext_limit.text = GetLangPackValue(90021600010,
        number, 1)
    local skinCfg = _G.ConfigManager.skin_cfg[skinid]

    local orderStr = { "ui_szsc_pifu_pzk_lan", "ui_szsc_pifu_pzk_jin", "ui_szsc_pifu_pzk_cai" }
    tb.aorimage_MonthIcon.SpriteName = orderStr[tonumber(skinCfg.SkinType)]
    -- tb.aorimage_MonthIcon:LoadAtlasSprite(
    --     "AtlasH5/hMallDress/hMallDressAtlas", orderStr[tonumber(skinCfg.SkinType)])
    tb.aorrawimage_Icon:LoadImage(
        skinData.Photo2,
        function(trans)
            -- trans:SetNativeSize()
        end
    )
    if data.sellout then
        --tb.aortext_price.color = require("CardInfoManager").GetColorFromRGB("c95f00")
        tb.aorbtn_btn:SetActiveE(0)
        tb.aorimage_isHave:SetActiveE(0)
        tb.aorimage_sellOut:SetActiveE(1)
        tb.aortext_price:SetActiveE(0)
    elseif data.isHave then
        tb.aorbtn_btn:SetActiveE(0)
        tb.aorimage_isHave:SetActiveE(1)
        tb.aorimage_sellOut:SetActiveE(0)
        tb.aortext_price:SetActiveE(0)
    else
        tb.aorbtn_btn:SetActiveE(1)
        tb.aorimage_isHave:SetActiveE(0)
        tb.aorimage_sellOut:SetActiveE(0)
        tb.aortext_price:SetActiveE(1)
        tb.aortext_price.text = self.curData[x].need_item[2]
    end

    local priceIcon = _G.StorageManager:GetInstance():GetItemIcon(self.curData[x].need_item[1])
    tb.aorrawimage_icon:LoadImage(priceIcon)
end

---刷新其他商店列表
function MallView_dress:RefershItem(index, obj)
    local x = index + 1
    local data = self.curData[x]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickBuy, data))
    local target = _G.StorageManager:GetItemDataClassByCfg(data.items)
    local id = target.cfg.UseParameter[1][1]
    local itemdata, path
    if self.curData.type == 1 then
        itemdata = frameCfg[tonumber(id)]
        path = itemdata.frame
    elseif self.curData.type == 2 then
        itemdata = titleCfg[tonumber(id)]
        path = itemdata.title
    elseif self.curData.type == 3 then
        itemdata = haloCfg[tonumber(id)]
        path = itemdata.halo
    end
    tb.aortext_limit.text = GetLangPackValue(90021600010, data.sellout == true and 1 or 0, 1)
    tb.obj_item:RemoveAllChildren()
    if itemdata.type_title == 1 then
        tb.aorrawimage_Icon:SetActiveE(1)
        tb.aorrawimage_Icon:LoadImage(
            path,
            function(tran)
                tran:SetNativeSize()
            end
        )
    elseif itemdata.type_title == 2 then
        _G.UIUtils.LoadEffectTitleOrFrame(
            path,
            tb.obj_item,
            function(tran)
                tran:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
            end
        )
        tb.aorrawimage_Icon:SetActiveE(0)
    end
    tb.aortext_price.text = self.curData[x].need_item[2]
    if data.sellout then
        --tb.aortext_price.color = require("CardInfoManager").GetColorFromRGB("c95f00")
        tb.aorbtn_btn:SetGray(true)
        tb.aorimage_isHave:SetActiveE(0)
        tb.aorimage_sellOut:SetActiveE(1)
        tb.aortext_price:SetActiveE(0)
    elseif data.isHave then
        tb.aorbtn_btn:SetGray(true)
        tb.aorimage_isHave:SetActiveE(1)
        tb.aorimage_sellOut:SetActiveE(0)
        tb.aortext_price:SetActiveE(0)
    else
        tb.aorbtn_btn:SetGray(false)
        tb.aorimage_isHave:SetActiveE(0)
        tb.aorimage_sellOut:SetActiveE(0)
        tb.aortext_price.text = self.curData[x].need_item[2]
    end
end

---购买商品
function MallView_dress:OnClickBuy(go, isOn, data, itemdata)
    local name = go:GetName()

    if name == "@_aorbtn_btn" then
        if data.sellout or data.isHave then
            return
        end

        DressModel:BuyItem(
            data,
            function()
                data.sellout = true
                self:ShowView()
            end
        )
    elseif name == "@_aorbtn_btn2" then
        --- 获取卡牌数据 查找此皮肤是否已经挂载在卡牌上了
        local cardData = require("CardData").GetPreviewData(data.cfg.cardID)
        local skinList = cardData.cfg.skin
        local show = #skinList > 0 and cardData.type ~= _G.CardType.Timer
        local haveSkin = false
        if show then
            for i = 1, #skinList do
                if skinList[i] == data.cfg.skinID then
                    haveSkin = true
                end
            end
        end

        if haveSkin then
            cardData:SetSkin(0)
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CardShowView.Name,
                { CardData = cardData },
                nil,
                true,
                nil,
                data.cfg.skinID)
        else
            require("CommonTipManager"):GetInstance():OpenPropTip(go, itemdata.cfg.ID)
        end
    end
end

