---@class  MallListItems : Component 中文描述
local MallListItems = _G.BaseClass(" MallListItems", _G.Component)
local MallItem = require "MallItem"

function MallListItems:Awake()
    --_G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
local UIinfoCfg = {
    --亮
    Color(64 / 255, 14 / 255, 14 / 255),
    --暗
    Color(198 / 255, 182 / 255, 157 / 255)
}
---@param type number 1充值 2礼包 3杂货 4月卡
---@param parent UnityEngine.GameObject 父物体
---@param data table
function MallListItems:__init(type, data, parent)
    self.IsFirst = { page = true, goods = true }
    self.ItemPath = "UI/Mall/MallListItemsNew"
    self.type = type
    self.CurShopID = data.CurShopID
    self.shopPageList = data.shopPageList
    self.GoodsList = data.GoodsList
    self.OnPageClick = data.OnPageClick
    self.OnGoodsClick = data.OnGoodsClick
    if parent then
        self.parent = parent
        self:ShowData()
    end
end
function MallListItems:Dispose()
    self.type = nil
    self.shopPageList = nil
    self.GoodsList = nil
    self.OnPageClick = nil
    self.OnGoodsClick = nil
    self.parent = nil
end
function MallListItems:Show(data, tran, notAnim)
    --self.notAnim = notAnim or nil
    self.shopPageList = data.shopPageList
    self.GoodsList = data.GoodsList
    self.CurShopID = data.CurShopID
    self:OnItemCardCall(tran)
    if data.VouncherImage and self.item.aorrawimage_title then
        self.item.aorrawimage_title:LoadImage(data.VouncherImage)
    end
end
function MallListItems:OnItemCardCall(tran)
    self.item = _G.GetAutoGoTable(tran)
    --item类型
    if self.item.scrollloopvectical_ItemList ~= nil then
        self.IsVectical = true
    elseif self.item.scrollloophorizontal_ItemList ~= nil then
        self.IsVectical = false
    end
    --页签类型
    if self.item.scrollloopvectical_YeQian ~= nil then
        self.TagIsVectical = false
    elseif self.item.scrollloophorizontal_YeQian ~= nil then
        self.TagIsVectical = true
    end
    _G.GameUtil.SetActiveByCondition(self.item.aorimage_mask, self.type == 2 or self.type == 3)
    self:ShowGoods()
    self:ShowPage()
    if _G.AppSetting.IsXzns then
        _G.GameUtil.SetUiHeXieMask(self.item)
    end
end
---显示货物
function MallListItems:ShowGoods()
    self.ItemLuaList = {}
    self.Count = 0
    if self.IsFirst.goods then
        if self.IsVectical then
            self.item.scrollloopvectical_ItemList:InitItemData(0, _G.handler(self, self.RefreshGoodsList))
        else
            self.item.scrollloophorizontal_ItemList:InitItemData(0, _G.handler(self, self.RefreshGoodsList))
        end
        self.IsFirst.goods = false
    end
    -- if not self.notAnim then
    -- end
    -- self.co =
    --     _G.coroutine.start(
    --     function()
    --     end
    -- )

    local amount = #self.GoodsList
    if self.count == amount then
        if self.IsVectical then
            self.item.scrollloopvectical_ItemList:UpdateAllItem()
        else
            self.item.scrollloophorizontal_ItemList:UpdateAllItem()
        end
    else
        if self.IsVectical then
            self.item.scrollloopvectical_ItemList:UpdateCount(amount)
            self.item.scrollloopvectical_ItemList:UpdateScrollRectHeight()
        else
            self.item.scrollloophorizontal_ItemList:UpdateCount(amount)
        end
    end
    self.count = amount
end
---刷新单个货物
function MallListItems:RefreshGoodsList(index, obj)
    if index < 0 then
        return
    end
    local tb = _G.GetAutoGoTable(obj)

    local x = index + 1
    obj:SetName(x)
    local tb_i = {}
    -- local anim = obj:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    -- anim.enabled = false
    self.ItemLuaList[index + 1] = {}
    local MallItemData = {}
    tb_i = tb["obj_MallItemNew"]
    local data = self.GoodsList[x]
    if data then
        MallItemData.id = data.id
        MallItemData.sid = (data.cfg or {}).item
        MallItemData.items = data.items
        MallItemData.icon = data.icon
        MallItemData.count = data.count
        MallItemData.type1 = data.type1
        MallItemData.price = data.price
        MallItemData.price_id = data.price_id
        MallItemData.formattedPrice = data.formattedPrice
        MallItemData.moneyIcon = data.currencyIcon
        MallItemData.moneyType = (data.cfg or {}).currency_type
        MallItemData.name = data.name
        MallItemData.cashTag = data.cashTag
        MallItemData.discount = data.discount
        MallItemData.saleState = data.saleState
        MallItemData.mask = data.mask
        MallItemData.limit = data.limit
        MallItemData.sellout = data.sellout
        if data.BuyTime then
            MallItemData.sellout = data.BuyTime > 0 and true or false
        end
    else
        MallItemData = nil
    end
    _G.GameUtil.SetActiveByCondition(tb_i, MallItemData)
    if MallItemData then
        local item_lua = self:GetComponent(tb_i, MallItem)
        if item_lua == nil then
            item_lua = self:AddComponent(
                    tb_i,
                    MallItem.New(
                            self.type,
                            MallItemData,
                            nil,
                            function()
                                _G.handlerbind(self, self.OnGoodsClick, x)
                            end
                    )
            )
        end
        item_lua:Show(self.type, MallItemData, tb_i, _G.handlerbind(self, self.OnGoodsClick, x), nil, true)
        --_G.GameUtil.SetActiveByCondition(tb_i, self.notAnim)
    end
end
---页签
---1 礼包 2杂货
function MallListItems:ShowPage()
    if self.type == 1 then
        return
    end
    local view = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.MallView.Name)
    if view then
        local sortingOrder = view.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
        if self.TagIsVectical then
            self.item.scrollloophorizontal_YeQian:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder = sortingOrder + 30
        else
            self.item.scrollloopvectical_YeQian:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder = sortingOrder + 30
        end
    end
    --local ScrollerRect = self.item.scrollloophorizontal_YeQian:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect))
    --ScrollerRect.horizontal = #self.shopPageList > 5
    local grid = self.item.obj_ToggleContent:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.GridLayoutGroup))
    if self.type == 2 or self.type == 3 then
        if #self.shopPageList > 5 then
            grid.padding.left = 0
        elseif #self.shopPageList > 4 then
            grid.padding.left = 50
        elseif #self.shopPageList > 3 then
            grid.padding.left = 15
        elseif #self.shopPageList > 2 then
            grid.padding.left = 15
        end
    else
        grid.padding.left = 0
    end
    grid.enabled = true
    local count = #self.shopPageList
    if not self.pageCount then
        if self.TagIsVectical then
            self.item.scrollloophorizontal_YeQian:InitItemData(
                    count,
                    _G.handler(self, self.RefreshPageList)
            )
            self.pageCount = count
        else
            self.item.scrollloopvectical_YeQian:InitItemData(
                    count,
                    _G.handler(self, self.RefreshPageList)
            )
            self.pageCount = count
        end
    else
        if self.pageCount ~= count then
            if self.TagIsVectical then
                self.item.scrollloophorizontal_YeQian:UpdateCount(count)
                self.pageCount = count
            else
                self.item.scrollloopvectical_YeQian:UpdateCount(count)
                self.pageCount = count
            end
        else
            if self.TagIsVectical then
                self.item.scrollloophorizontal_YeQian:UpdateAllItem()
            else
                self.item.scrollloopvectical_YeQian:UpdateAllItem()
            end
        end
    end
end
---刷新单个page显示
function MallListItems:RefreshPageList(index, obj)
    if index < 0 then
        return
    end
    local x = index + 1
    obj:SetName(x)
    local data
    local index
    local name
    local showRed = false
    if self.type == 2 then
        showRed = require "MallManager":GetInstance():CheckFreeGoodsIsSellOut(x) == 1
        data = self.shopPageList[x]
        index = x
        name = data.name
    elseif self.type == 3 then
        data = _G.ConfigManager.shop_list_cfg[self.shopPageList[x]]
        index = self.shopPageList[x]
        name = data.name
    end
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnPageClick, index))
    if data == nil then
        tb.gameObject:SetActiveE(0)
    else
        tb.gameObject:SetActiveE(1)
        if index == self.CurShopID then
            tb.obj_Normal:SetActiveE(0)
            tb.obj_Select:SetActiveE(1)
            tb.aortext_Name.color = UIinfoCfg[1]
        else
            tb.obj_Normal:SetActiveE(1)
            tb.obj_Select:SetActiveE(0)
            tb.aortext_Name.color = UIinfoCfg[2]
        end
        tb.aortext_Name.text = _G.LangUtil.GetLangPackValue(name)
        _G.GameUtil.SetActiveByCondition(tb.obj_redpoint, showRed)
    end
    if tb.obj_Effect:GetChildCountE() < 1 then
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_MailViewChild, tb.obj_Effect)
    end
end

function MallListItems:ShowData()
    for i = 1, self.parent:GetChildCountE() do
        _G.PoolsManager:GetInstance():Despawn(self.parent:GetChildE(0), _G.ePoolType.UIItem)
    end
    _G.PoolsManager:GetInstance():Spawn(
            self.ItemPath,
            _G.ePoolType.UIItem,
            self.parent,
            function(tran)
                self:OnItemCardCall(tran)
            end
    )
end

---销毁对象时,析构函数
function MallListItems:OnDestroy()
    if self.co then
        _G.coroutine.stopwaiting(self.co)
        self.co = nil
    end
end
return MallListItems
