---@class MallItemView	中文描述
---@field go_table MallPanelView._obj_item_GoTable
local MallItemView = _G.BaseClass("MallItemView")

local ShowByCash = function(self)
    self.go_table.aorrawimage_Icon:LoadImage(self.cfg.icon)
    self.go_table.aorimage_tag:SetActiveE(0)
    self.go_table.obj_Free:SetActiveE(0)
    self.go_table.aorrawimage_Material:SetActiveE(0)
    self.go_table.obj_cashPrice:SetActiveE(1)
    self.go_table.aortext_limit:SetActiveE(0)
    self.go_table.aortext_cashPrice:SetActiveE(1)
    self.go_table.aortext_cashPrice.text = self.cfg.price
    if require("MallCashModel"):GetInstance():GetIsFirstCash(self.cfg.id) then
        self.go_table.aorimage_cashTag:SetActiveE(1)
        self.go_table.aortext_cashDiscount:SetActiveE(0)
        --self.go_table.aorimage_cashTag.SpriteName = "ui-sc-img-scsb"
    else
        if self.cfg.extra_default > 0 then
            self.go_table.aorimage_cashTag:SetActiveE(1)
            self.go_table.aortext_cashDiscount:SetActiveE(1)
            self.go_table.aortext_cashDiscount.text =
                (_G.Mathf.Floor(self.cfg.extra_default / self.cfg.goods[1][2] * 100)) .. "%"
            self.go_table.aorimage_cashTag.SpriteName = "ui-sc-img-zs"
        else
            --self.go_table.aorimage_cashTag:SetActiveE(0)
        end
    end
    if not _G.string.IsNullOrEmpty(self.cfg.special) then
        if self.go_table.trans_effect:GetChildCountE() <= 0 then
            _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg[self.cfg.special], self.go_table.trans_effect)
        end
    else
        if self.go_table.trans_effect:GetChildCountE() > 0 then
            _G.UIUtils.RemoveEffect(self.go_table.trans_effect:GetChildE(0))
        end
    end
end

local tagName = {
    "ui-sc-bg-tuijian",
    "ui-sc-bg-huobao",
    "ui-sc-bg-tehui",
    "ui-sc-bg-xinpin"
}
local tagTxtName = {
    "ui-sc-font-tuijian",
    "ui-sc-font-huobao",
    "ui-sc-font-tehui",
    "ui-sc-font-xinpin"
}
local discountBase = 10000

local ShowByBox = function(self)
    self.go_table.aorimage_cashTag:SetActiveE(0)
    self.go_table.aorrawimage_Icon:LoadImage(self.cfg.icon)
    self.go_table.obj_cashPrice:SetActiveE(0)
    self.go_table.aorrawimage_Material:SetActiveE(self.cfg.discount ~= 0 and 1 or 0)
    self.go_table.aorimage_tag:SetActiveE(self.cfg.status_sale > 0 and 1 or 0)
    if self.cfg.status_sale > 0 then
        self.go_table.aorimage_tag.SpriteName = tagName[self.cfg.status_sale]
        self.go_table.aorimage_tagImage.SpriteName = tagTxtName[self.cfg.status_sale]
        self.go_table.aorimage_tag:SetNativeSize()
        self.go_table.aorimage_tagImage:SetNativeSize()
        self.go_table.aortext_Discount:SetActiveE(self.cfg.status_sale == 3 and 1 or 0)
        self.go_table.obj_discountTag:SetActiveE(self.cfg.status_sale == 3 and 1 or 0)
    end
    self.go_table.obj_Free:SetActiveE(self.cfg.price == 0 and 1 or 0)
    self.go_table.aorrawimage_Material:SetActiveE(self.cfg.price ~= 0 and 1 or 0)
    local curPrice = _G.GameUtil.RatioControl(self.cfg.price)
    self.go_table.aortext_MaterialNum.text = curPrice
    self.go_table.aortext_limit:SetActiveE(self.cfg.count_limit > 0 and 1 or 0)
    if self.cfg.count_limit > 0 then
        self.go_table.aortext_limit.text =
            _G.string.format(
            "每日限购  ( %s/%s )",
            require("MallManager"):GetInstance():GetItemBuyTimes(self.cfg.id, self.itemType),
            self.cfg.count_limit
        )
    end
    if not _G.string.IsNullOrEmpty(self.cfg.special) then
        if self.go_table.trans_effect:GetChildCountE() <= 0 then
            _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg[self.cfg.special], self.go_table.trans_effect)
        end
    else
        if self.go_table.trans_effect:GetChildCountE() > 0 then
            _G.UIUtils.RemoveEffect(self.go_table.trans_effect:GetChildE(0))
        -- self.go_table.trans_effect:DisposeChildren()
        end
    end
end

---类的构造函数
function MallItemView:__init(obj)
    self.gameObject = obj
    self.transform = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClick))
end

---类的析构函数
function MallItemView:Dispose()
    if self.go_table.trans_effect:GetChildCountE() > 0 then
        _G.UIUtils.RemoveEffect(self.go_table.trans_effect:GetChildE(0))
    end
end

function MallItemView:OnClick(btn)
    if self.clickFunction then
        self.clickFunction(self.cfg, self.itemType)
    end
end
---显示物品
---@param cfg store_active_cfg_Item|store_cycle_cfg_Item|store_recharge_cfg_Item 物品配置
---@param _type MallManager.MallType 物品类型
---@return 变量类型 中文描述
function MallItemView:ShowItem(cfg, _type)
    self.cfg = cfg
    self.itemType = _type
    self.go_table.aortext_ItemName.text = _G.LangUtil.GetLangPackValue(cfg.name)
    self:ShowOrHide(true)
    if _type == require("MallManager").MallType.cash then
        ShowByCash(self)
    else
        ShowByBox(self)
    end
end
function MallItemView:ShowOrHide(show)
    self.gameObject:SetActiveE(show and 1 or 0)
end
function MallItemView:SetClickFunction(callback)
    self.clickFunction = callback
end
return MallItemView
