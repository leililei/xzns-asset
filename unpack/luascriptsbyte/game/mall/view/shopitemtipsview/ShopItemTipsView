---装备轮换计时器
function ShopItemTipsView:UpdateTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    local delay = _G.ConfigManager.discrete_cfg[104910][1][1]
    self.timer = _G.TimerManager:GetInstance():GetTimer(delay, self.OnTimeCall, self, false, false)
    self.timer:Start()
end

function ShopItemTipsView:OnTimeCall()
    local advance = _G.ConfigManager.stone_cfg[self.data.cfg.ID].advance
    if self.showEquipIndex >= #advance then
        self.showEquipIndex = 1
    else
        self.showEquipIndex = self.showEquipIndex + 1
    end
    self:InitEquipInfo()
end

---轮换的装备信息
function ShopItemTipsView:InitEquipInfo()
    local advance = _G.ConfigManager.stone_cfg[self.data.cfg.ID].advance
    ---当前装备
    local leftEquipId = advance[self.showEquipIndex][1]
    self.go_table.obj_equipItem1:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseView(
        leftEquipId,
        1,
        self.go_table.obj_equipItem1,
        function(item)
            if _G.IsNil(self.go_table.obj_equipItem1) then
                _G.DestroyObject(item.gameObject)
                return
            end

            item.gameObject:SetLocalScaleXYZ(0.8)
            local equipmentData = _G.StorageManager:GetInstance():GetDatasBySid(_G.StorageID.Equipment, leftEquipId)
            if _G.table.isEmptyOrNil(equipmentData) then
                item.go_table.aortext_num.text = _G.string.format("<color=#e33f3f>%s</color>/%s", 0, 1)
            else
                local count = 0
                for _, v in pairs(equipmentData) do
                    count = v.count + count
                end
                item.go_table.aortext_num.text = count .. "/" .. 1
            end
        end
    )

    ---消耗的道具
    self.go_table.obj_propItem:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseView(
        self.data.cfg.ID,
        0,
        self.go_table.obj_propItem,
        function(item)
            if _G.IsNil(self.go_table.obj_propItem) then
                _G.DestroyObject(item.gameObject)
                return
            end
            item.gameObject:SetLocalScaleXYZ(0.8)
        end,
        function()
        end
    )

    ---当前装备
    local rightEquipId = advance[self.showEquipIndex][2]
    self.go_table.obj_equipItem2:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseView(
        rightEquipId,
        0,
        self.go_table.obj_equipItem2,
        function(item)
            if _G.IsNil(self.go_table.obj_equipItem2) then
                _G.DestroyObject(item.gameObject)
                return
            end
            item.gameObject:SetLocalScaleXYZ(0.8)
        end
    )
end

function ShopItemTipsView:OnClcikArrow(change)
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end

    self.showEquipIndex = self.showEquipIndex + change
    local advance = _G.ConfigManager.stone_cfg[self.data.cfg.ID].advance
    if self.showEquipIndex > #advance then
        self.showEquipIndex = 1
    elseif self.showEquipIndex <= 0 then
        self.showEquipIndex = #advance
    end
    self:InitEquipInfo()
end

