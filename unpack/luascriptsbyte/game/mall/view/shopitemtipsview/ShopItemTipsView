---初始化奖励数据
function ShopItemTipsView:InitAwardData(data)
    self.awardData = {}
    local item_cfgItem = data.cfg
    local UseParameter = item_cfgItem.UseParameter
    if item_cfgItem.UseType == _G.ItemUseType.ItemDrop then
        ---掉落预览要查掉落表
        ---@type drop_cfg
        local drop_cfgItem = _G.ConfigManager.drop_cfg[tonumber(UseParameter[1][2])]
        if drop_cfgItem ~= nil then
            local info, infoS, itemData
            infoS = drop_cfgItem.fixed_drop
            for i = 1, #infoS do
                info = infoS[i]
                table.insert(self.awardData, info)
            end
            infoS = drop_cfgItem.content1
            for i = 1, #infoS do
                info = infoS[i]
                table.insert(self.awardData, info)
            end
            infoS = drop_cfgItem.content2
            for i = 1, #infoS do
                info = infoS[i]
                table.insert(self.awardData, info)
            end
        end
    elseif item_cfgItem.UseType == _G.ItemUseType.ProgressChest then
        ---@type item_box_con_cfg
        local cfg = _G.ConfigManager.item_box_con_cfg[_G.tonumber(UseParameter[1][1])]
        if cfg then
            for i = 1, #cfg.rewards do
                table.insert(self.awardData, cfg.rewards[i])
            end
        end
    elseif item_cfgItem.UseType == _G.ItemUseType.DrawCard then
        for i = 1, #UseParameter do
            if i ~= 1 then
                ---@type lucky_pools_cfg
                local cfg = _G.ConfigManager.lucky_pools_cfg[tonumber(UseParameter[i][1])]
                if cfg then
                    for j = 1, #cfg.cards do
                        table.insert(self.awardData, { cfg.cards[j][1], 1 })
                    end
                end
            end
        end
    else
        local info, itemData
        if #UseParameter > 0 then
            for i = 1, #UseParameter do
                info = UseParameter[i]
                table.insert(self.awardData, info)
            end
        elseif #UseParameter == 0 and #item_cfgItem.UseParameter2 > 0 and #item_cfgItem.use_parameter2_con > 0 then
            for i, v in pairs(item_cfgItem.UseParameter2) do
                if _G.GlobalConditionManager.CheckConditionByArray({ item_cfgItem.use_parameter2_con[i] }) then
                    itemData = _G.StorageManager:GetInstance():GetItemDataClassByCfg(v)
                    _G.table.insert(self.awardData, v)
                end
            end
        end
    end
end

function ShopItemTipsView:SetBasePropData(tran, data, type)
    local tb = _G.GetAutoGoTable(tran)
    tb.aortext_des.text = _G.AttrType[data.key].des
    local num = data.value
    type = type or 0
    if _G.AttrType[data.key].percentage == 1 then
        if type == 1 then
            num = num * 0.01
            tb.aortext_value.text = num .. "%"
            return
        end
        num = num * 100
        num = _G.Mathf.RoundToInt(num)
        num = tostring(num) .. "%"
    else
        num = tostring(num)
        if type == 2 then
            num = tostring(num * 0.01) .. "%"
        end
    end
    tb.aortext_value.text = num
end

---ZHJH-2491 策划要求内容框根据内容变化，最多4行（maxheight = 135
function ShopItemTipsView:SetScrollViewHeight(contentRect)
    ---@type UnityEngine.RectTransform
    local rect = contentRect
    ---@type UnityEngine.RectTransform
    local bgRect = self.go_table.obj_BG:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    ---@type UnityEngine.RectTransform
    local scrollRect = self.go_table.obj_ScrollView:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    -- 最低45，以防内容没有加载完就设置内容框
    local rectW, rectH = rect:GetRectTransformSize()
    local height = _G.math.min(rectH, contentMaxHeight)
    height = _G.math.max(45, height)
    local bgW, bgH = bgRect:GetRectTransformSize()
    local scrollW, scrollH = scrollRect:GetRectTransformSize()
    bgRect:SetRectTransformSize(bgW, bgH + height)
    scrollRect:SetRectTransformSize(scrollW, scrollH + height)
end

