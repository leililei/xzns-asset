            self.go_table.obj_progress:SetActiveE(1)
            self.go_table.obj_maxStar:SetActiveE(0)
            self.go_table.aortext_star.text = _G.GetLangPackValue(90000010475, 0)
            self.go_table.aortext_progress.text = 0 .. "/" .. 0
            self.go_table.aorimage_activeSchedule:SetLocalScale(0, 1, 1)
        elseif not isMax then
            -- 没有满星
            self.go_table.obj_progress:SetActiveE(1)
            self.go_table.obj_maxStar:SetActiveE(0)
            self.go_table.aortext_star.text = _G.GetLangPackValue(90000010475, showSp:GetStar() + 1)
            local count = require("SpiritualModel"):GetInstance():GetSameSid(showSp)
            local needCount = cfg[100 + showSp:GetStar() + 1].materials_oneself -
            cfg[100 + showSp:GetStar()].materials_oneself
            self.go_table.aortext_progress.text = count .. "/" .. needCount
            if needCount <= count then
                self.go_table.aorimage_activeSchedule:SetLocalScale(1, 1, 1)
            else
                self.go_table.aorimage_activeSchedule:SetLocalScale(count / needCount, 1, 1)
            end
        else
            -- 满星
            self.go_table.obj_progress:SetActiveE(0)
            self.go_table.obj_maxStar:SetActiveE(1)
        end


        local TmpAttr = {}
        TmpAttr.atk = _data.cfg.atk
        TmpAttr.bre = _data.cfg.bre
        TmpAttr.def = _data.cfg.def
        TmpAttr.max_hp = _data.cfg.max_hp
        local SpiritualBase = {}
        for i, v in pairs(TmpAttr) do
            if v ~= 0 then
                _G.table.insert(SpiritualBase, { key = i, value = v })
            end
        end
        local propitem
        for i = 1, #SpiritualBase do
            propitem = _G.InstantiateObject(self.go_table.obj_propitem, self.go_table.obj_spiritualContent)
            self:SetBasePropData(propitem, SpiritualBase[i])
        end
        local skill = require("SpiritualModel").GetStarSkillDes(_data.cfg.id, 0)
        local sdDesExText = self.go_table.obj_spiritualDetail:GetComponentE(_G.typeof(_G.CS.ExtendText))
        -- ZHJ-36257 修改神器和灵契在背包和商店的对应文字颜色
        local text = _G.string.gsub(skill, "5bdf99", "14874a")
        text = _G.string.gsub(text, "76daf8", "3d57aa")
        text = _G.string.gsub(text, "ffee9d", "ba7d09")
        sdDesExText.text = text
        self.go_table.obj_spiritual:SetActiveE(1)
        _G.GameUtil.ReBuildRTF(self.go_table.obj_spiritual)
    end
    -- 延迟两帧，防止有些内容较多的没有加载出来就设置高度
    _G.DelayFrameDo(
        function()
            _G.DelayFrameDo(
                function()
                    if _G.IsNil(layoutGroup) then
                        return
                    end
                    layoutGroup.enabled = false
                    layoutGroup.enabled = true
                    self:SetScrollViewHeight(contentRect)
                end
            )
        end
    )
    if type == TipType.Spiritual or type == TipType.Artifact then
        local EmbattleModel = require "EmbattleModel":GetInstance()
        self.afkCardIds = EmbattleModel:GetEmbattleData(_G.EmbattleType.AFK)
        self.arenaAtkCardIds = EmbattleModel:GetEmbattleData(_G.EmbattleType.arenaAttack)
        self.arenaDefCardIds = EmbattleModel:GetEmbattleData(_G.EmbattleType.arenaDefence)
        local StorageManager = _G.StorageManager:GetInstance()
        local datas = {}
        if type == TipType.Spiritual then
            datas = StorageManager:GetDatasBySid(_G.StorageID.Spiritual, self.data.sid)
        elseif type == TipType.Artifact then
            datas = StorageManager:GetDatasBySid(_G.StorageID.Artifact, self.data.sid)
        end
        self.cardList = {}
        if not _G.table.isEmptyOrNil(datas) then
            for _, v in pairs(datas) do
                if v.cardUid and v.cardUid > 0 and (not v:IsMaxStar() or type == TipType.Artifact and not v:GetIsAwaken()) then
                    local cardData = StorageManager:GetDatasByUid(_G.StorageID.Card, v.cardUid)
                    if not _G.table.isEmptyOrNil(cardData) and (self:CardIsInEmbattle(v.cardUid, self.afkCardIds) or
                            self:CardIsInEmbattle(v.cardUid, self.arenaAtkCardIds) or self:CardIsInEmbattle(v.cardUid, self.arenaDefCardIds)) then
                        _G.table.insert(self.cardList, cardData)
                    end
                end
            end
        end

        if not _G.table.isEmptyOrNil(self.cardList) then
            self.go_table.aorbtn_openTip:SetActiveE(1)
        end
    end

    _G.GameUtil.ReBuildRTF(self.go_table.obj_Content)

    --如果是物品是紫色魂石的时候，需要让下拉框足够到达角色列表
    -- if (data.sid == 203050200) then
    --     local ScrollViewContent =
    --         self.go_table.obj_ScrollView:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect)).content
    --     ScrollViewContent:SetRectTransformSize(0, 240)
    -- end
end

