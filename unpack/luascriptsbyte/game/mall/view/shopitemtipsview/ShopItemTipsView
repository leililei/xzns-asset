---按钮点击事件在这里派发
function ShopItemTipsView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_close" or name == "@_aorbtn_closeView" then
        self:CloseTip()
    elseif name == "@_aorbtn_buy" then
        -- local data = _G.ConfigManager.item_cfg[self.data.sid]
        local pan = false
        if self.data.cfg and not _G.table.isEmptyOrNil(self.data.cfg.UseParameter) then
            local id = _G.tonumber(self.data.cfg.UseParameter[1][2])
            pan = _G.StorageManager:GetInstance():GetIDMax(self.data.sid, id)
        end

        if pan then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                622,
                nil,
                function()
                    if self.callback then
                        self.callback(
                            self.BuyNum,
                            function(res)
                                if res then
                                    self:CloseTip()
                                end
                            end
                        )
                    end
                end
            )
        else
            if self.callback then
                self.callback(
                    self.BuyNum,
                    function(res)
                        if res then
                            self:CloseTip()
                        end
                    end
                )
            end
        end
    elseif name == "@_aorbtn_leftArrow" then
        self:OnClcikArrow(-1)
    elseif name == "@_aorbtn_openTip" then
        if self.type == TipType.Spiritual or self.type == TipType.Artifact then
            local storageType = _G.StorageManager:GetInstance():CheckSidType(self.data.sid)
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CommonTipView.Name,
                _G.TipType.WearCardList,
                storageType,
                self.cardList,
                self.data.data
            )
        else
            local data = self.data.equip
            local cards = require("CardResonanceModel"):GetInstance():GetAllPosCards()
            _G.PlayerPrefsManager.SetInt("EquipmentCommend" .. data.sid, true)
            self.go_table.obj_RedPoint:SetActiveE(0)
            require("CommonTipManager"):GetInstance():OpenView(_G.TipType.EquipmentCommendOnly, self.equipRolesData)
        end
    elseif name == "@_aorbtn_rightArrow" then
        self:OnClcikArrow(1)
    elseif name == "@_aorbtn_propAdd" then
        self:AddNum()
    elseif name == "@_aorbtn_propSub" then
        self:SubNum()
    elseif name == "@_aorbtn_propMax" then
        self:AddNumForMax()
    end
end

function ShopItemTipsView:Dispose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return ShopItemTipsView
