function ShopItemTipsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
end

---界面的入口函数
---@param type TipType 提示类型
---@param data table  所要显示对象的数据
---@param call function  购买回调
function ShopItemTipsView:OnCreate(type, buyData, data, call, getcurryhave, ...)
    self.itemTransDic = {}
    self.callback = call
    self.data = data
    self.type = type
    self.Price = buyData.price
    self.limitBuyNum = buyData.limit - buyData.BuyTime
    self.BuyNum = 1
    if getcurryhave then
        local _, buynum = getcurryhave()
        self.BuyNum = buynum
    end
    self.buyData = buyData
    self.getcurryhave = getcurryhave or nil
    self:ShowTips(type, data, ...)

    self.go_table.aortext_money.text = _G.GameUtil.NumberToShopPrice(self.Price)
    if buyData.currencyIcon then
        self.go_table.aorrawimage_moneyIcon.Alpha = 0
        self.go_table.aorrawimage_moneyIcon:LoadImage(buyData.currencyIcon)
    end
    self.go_table.obj_useCount:SetActiveE(1)
    self:UpDateBuyNum()
    self.go_table.input_userNum.onEndEdit:AddListener(_G.handler(self, self.OnEndEditorDeclaration))
end

