---对直接向购买数量编辑的行为注册方法
function ShopItemTipsView:OnEndEditorDeclaration(input)
    -- 输入不是数字
    if not tonumber(input) then
        input = self.BuyNum
    end
    local num = tonumber(input)
    local max = self.limitBuyNum
    local min = 1
    if num >= max then
        num = max
    elseif num <= min then
        num = min
    end
    self.BuyNum = num
    self:UpDateBuyNum()
end

---更新购买数量
function ShopItemTipsView:UpDateBuyNum()
    self.go_table.input_userNum.text = self.BuyNum
    -- 更新购买的价格
    self.go_table.aortext_money.text = _G.GameUtil.NumberToShopPrice(self.Price * self.BuyNum)
end

function ShopItemTipsView:AddNum()
    if self.BuyNum < self.limitBuyNum then
        self.BuyNum = self.BuyNum + 1
        self:UpDateBuyNum()
    end
end

function ShopItemTipsView:SubNum()
    if self.BuyNum > 1 then
        self.BuyNum = self.BuyNum - 1
        self:UpDateBuyNum()
    end
end

function ShopItemTipsView:AddNumForMax()
    self.BuyNum = self.limitBuyNum
    self:UpDateBuyNum()
end

