local base = require("MallView_base")
---@class MallView_chipGift : MallView_chipGift	商城界面_碎片礼包
local MallView_chipGift = _G.BaseClass("MallView_chipGift", base)

local BtnsType = {
    CHEAP_GIFT = 1,
    DAILY_GIFT = 2,
    MONTH_GIFT = 3
}

---创建对象时,入口构造函数
function MallView_chipGift:Init(...)
    self.itemObjDic = {}
    --按钮点击对应的方法
    self.clickFunction = {
        ["@_aorbtn_select"] = function()
            self:SelectCard()
        end,
        ["@_aorbtn_getAll"] = function()
            self:BuyAll()
        end,
        ["@_aorbtn_tip"] = function()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 53)
        end,
        --界面关闭
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    ---1-特惠礼包；2-每日礼包；3-每月礼包
    if ... then
        local args = { ... }
        self.CurShopID = args[1]
    else
        self.CurShopID = 1
    end
    self.itemDataList = {}
    if not self.resource then
        self.resource =
            self:AddComponent(
                self.go_table.obj_GoldInfo,
                require("ResourceCompont").New(self.go_table.obj_GoldInfo, { 12 })
            )
    end
    if not self.playerHead then
        self.playerHead =
            self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))
    end
end

---打开角色选择界面
function MallView_chipGift:SelectCard()
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.DailyChipGiftView.Name,
        _G.handler(self, self.OnSelectedCard)
    )
end

---当角色选择界面关掉
----@param 选择对应卡牌所对应的礼包索引
function MallView_chipGift:OnSelectedCard()
    self.curCardSid = require("ChipGiftModel"):GetInstance():GetCurrentCard()

    self:SetCurSelectedCard()
    self:ShowProducts()
    self:ShowAllBought()
end

---购买所有
function MallView_chipGift:BuyAll()
    if self.curCardSid == 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(750101)
    else
        if require("ChipGiftModel"):GetInstance():CanBuyAll() then
            require("ChipGiftModel"):GetInstance():BuyAll()
        end
    end
end

function MallView_chipGift:OnDestroy()
end

function MallView_chipGift:UpdataView()
    if self.gameObject:GetActiveSelf() == 1 then
        self:InitView(true)
    end
end

---初始化界面
function MallView_chipGift:InitView()
    local curCardSid = require("ChipGiftModel"):GetInstance():GetCurrentCard()
    if self.curCardSid ~= curCardSid then
        self.curCardSid = curCardSid
        self:SetCurSelectedCard()
    end
    self:InitBottomTab()
    self:ShowProducts()
    if self.selectToggleTab == BtnsType.CHEAP_GIFT then
        self:ShowAllBought()
    end
end

---展示一键购买状态
function MallView_chipGift:ShowAllBought()
    local allProduct = require("ChipGiftModel"):GetInstance():GetAllBoughtProduct()
    local callBuyAllProduct = require("ChipGiftModel"):GetInstance():CanBuyAll()
    --一键购买状态丶价格显示
    self.go_table.aorbtn_getAll:SetGray(self.curCardSid == 0 or not callBuyAllProduct)
    _G.GameUtil.SetPriceByChannel(allProduct.cfg.price_id, self.go_table.aortext_getAll)
end

function MallView_chipGift:SetCurSelectedCard()
    if self.curCardSid and self.curCardSid > 0 then
        local config = _G.ConfigManager.card_cfg[self.curCardSid]
        self.go_table.aortext_cardName.text = _G.GetLangPackValue(90023800089, _G.GetLangPackValue(config.Name))
        self.go_table.aorrawimage_card:LoadImage(config.SkillPortrait, function()
            self.go_table.aorrawimage_card:SetNativeSize()
        end)
    else
        self.go_table.aortext_cardName.text = ""
    end
end

function MallView_chipGift:InitBottomTab()
    self.selectToggleTab = BtnsType.CHEAP_GIFT
    self.toggles = {
        [BtnsType.CHEAP_GIFT] = _G.GetAutoGoTable(
            self.go_table.toggle_cheapGift,
            _G.handlerbind(self, self.OnClickToggle, BtnsType.CHEAP_GIFT)
        ),
        [BtnsType.DAILY_GIFT] = _G.GetAutoGoTable(
            self.go_table.toggle_dailyGift,
            _G.handlerbind(self, self.OnClickToggle, BtnsType.DAILY_GIFT)
        ),
        [BtnsType.MONTH_GIFT] = _G.GetAutoGoTable(
            self.go_table.toggle_monthGift,
            _G.handlerbind(self, self.OnClickToggle, BtnsType.MONTH_GIFT)
        )
    }
    self.toggles[self.selectToggleTab].isOn = true
    self:OnClickToggle(self.toggles[self.selectToggleTab], true, self.selectToggleTab)
end

function MallView_chipGift:OnClickToggle(go, isOn, key)
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if isOn then
        self.selectToggleTab = key
    end
end

function MallView_chipGift:ShowProducts()
    if self.selectToggleTab == BtnsType.CHEAP_GIFT then
        self.products = require("ChipGiftModel"):GetInstance():GetProducts() or {}
        if not self.itemListView then
            self.go_table.scrollloopvectical_item:InitItemData(#self.products, _G.handler(self, self.RefreshItem))
            self.itemListView = self.go_table.scrollloopvectical_item
        else
            self.itemListView:UpdateCount(#self.products)
        end
    end
end

function MallView_chipGift:RefreshItem(index, obj)
    local product = self.products[index + 1]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickGift, product))
    --物品展示
    local goods = require("ChipGiftModel"):GetInstance():GetGift(product.cfg.id)
    --按钮状态
    local canBuy = require("ChipGiftModel"):GetInstance():CanBuyProduct(product.cfg.id)
    _G.GameUtil.SetActiveByCondition(tb.aorbtn_get, canBuy)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_complete, not canBuy)
    _G.UIUtils.RemoveChildren(tb.obj_awardGrid)
    if not _G.table.isEmptyOrNil(goods) then
        for _, v in pairs(goods) do
            local sid, num = _G.table.unpack(v)
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                { sid, num },
                tb.obj_awardGrid,
                function(trans)
                    if _G.IsNil(tb.obj_awardGrid) then
                        _G.DestroyObject(trans.gameObject)
                        return
                    end
                    if trans.SetGradeNew then
                        trans:SetGradeNew(false)
                    end
                    if trans.SetGou then
                        trans:SetGou(not canBuy)
                    end
                end
            )
            --价格显示
            if product.cfg.price <= 0 then
                tb.aortext_get.text = _G.GetLangPackValue(90000010016)
                tb.aorimage_get:SetGray(false)
            else
                tb.aortext_get.text = _G.GetLangPackValue(90000010819, _G.GameUtil.RatioControl(product.cfg.price))
                --默认未选择角色时置灰购买按钮
                tb.aorimage_get:SetGray(self.curCardSid == 0)
            end
        end
    end
end

function MallView_chipGift:OnClickGift(go, isOn, product)
    if go:GetName() ~= "@_aorbtn_get" then
        return
    end
    if not product or product.remainCount <= 0 then
        return
    end
    if product.cfg.price <= 0 then
        require("ChipGiftModel"):GetInstance():GetFreeAward(
            product.cfg.id,
            function()
                self:InitView()
            end
        )
    else
        if self.curCardSid == 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(750101)
        else
            require("ChipGiftModel"):GetInstance():BuyProduct(product.cfg.id)
        end
    end
end

function MallView_chipGift:OnDisable()
end

function MallView_chipGift:Show()
    base.Show(self)
    self:InitView()
end

function MallView_chipGift:Hide()
    base.Hide(self)
end

return MallView_chipGift
