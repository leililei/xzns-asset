function MallView_recharge:Show()
    base.Show(self)
    self:FreshPage()
    self.go_table.aortext_tip2.text = _G.GetLangPackValue(_G.GameUtil.GetVoucherArg(90000011730, 90036300032))
end

function MallView_recharge:Hide()
    base.Hide(self)
end

function MallView_recharge:UpdataView()
    self:FreshPage(true)
end

function MallView_recharge:ShowHeXieMask()
    if self.nowIndex == 2 then
        if _G.AppSetting.IsXzns then
            _G.GameUtil.SetUiHeXieMask(_G.GetAutoGoTable(self.go_table.obj_MallListItems_djq))
        end
    end
end

function MallView_recharge:FreshPage(notAnim)
    if _G.AppSetting.DEBUG then
        _G.Log("充值回调刷新界面")
    end
    self:ShowHeXieMask()
    self.itemDataList = {}
    self:InitPage()
    if self.IsSDK then
        if _G.table.isEmptyOrNil(self.SdkList) then
            _G.SDKManager:GetInstance():SendGetGoodsList()
        else
            self.itemDataList = require("MallManager"):GetInstance():GetMallItemListByType(self.curPageType,
                self.nowIndex)
            self:SetGoods()
            self:InitList()
        end
    else
        self.itemDataList = require("MallManager"):GetInstance():GetMallItemListByType(self.curPageType, self.nowIndex)
        self:SetGoods()
        self:InitList(notAnim)
    end
end

function MallView_recharge:InitPage()
    if self.gameObject:GetctiveInHierarchy() ~= 1 then
        return
    end
    if self.nowIndex == 1 then
        self.go_table.obj_MallListItems:SetActiveE(1)
        self.go_table.obj_MallListItems_djq:SetActiveE(0)
        self.go_table.aorimage_tipBak:SetActiveE(1)
        self.go_table.aorimage_tipBak2:SetActiveE(0)
    elseif self.nowIndex == 2 then
        self.go_table.obj_MallListItems:SetActiveE(0)
        self.go_table.obj_MallListItems_djq:SetActiveE(1)
        self.go_table.aorimage_tipBak:SetActiveE(0)
        self.go_table.aorimage_tipBak2:SetActiveE(1)
    end
end

function MallView_recharge:InitList(notAnim)
    if self.gameObject:GetctiveInHierarchy() ~= 1 then
        return
    end
    if self.nowIndex == 1 then
        local data = {}
        data.GoodsList = self.shopGoodsList
        data.OnGoodsClick = _G.handlerbind(self, self.AddBtn)
        local tb_i = self:GetComponent(self.go_table.obj_MallListItems, MallListItems)
        if tb_i == nil then
            tb_i = self:AddComponent(self.go_table.obj_MallListItems, MallListItems.New(1, data))
        end
        tb_i:Show(data, self.go_table.obj_MallListItems, notAnim)
    elseif self.nowIndex == 2 then
        local data = {}
        data.GoodsList = self.shopGoodsList
        data.OnGoodsClick = _G.handlerbind(self, self.AddDJQBtn)
        data.VouncherImage = _G.GameUtil.CheckVoucherModel() and "ImagesH5/hMall/ui_djqsd_txt_djqsd_mj" or "ImagesH5/hMall/ui_djqsd_txt_djqsd"
        local tb_i = self:GetComponent(self.go_table.obj_MallListItems_djq, MallListItems)
        if tb_i == nil then
            tb_i = self:AddComponent(self.go_table.obj_MallListItems_djq, MallListItems.New(1, data))
        end
        if _G.AppSetting.IsXzns then
            local tb = _G.GetAutoGoTable(self.go_table.obj_MallListItems_djq)
            if tb.aorrawimage_roleImage then
                tb.aorrawimage_roleImage:LoadImage("ImagesH5/hShopNew/ui_yueka_dijing")
            end
        end
        tb_i:Show(data, self.go_table.obj_MallListItems_djq, notAnim)
        require("MallCashModel"):GetInstance():SetVoucherUnlock()
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.StoreVoucher.id)
    end
end

---获取当前配置表id对应的
function MallView_recharge:GetPayInfoByGear(gear)
    if self.SdkList then
        for _, info in pairs(self.SdkList) do
            if info.product_id == gear then
                return info
            end
        end
    end
    return nil
end

---设置商品信息
function MallView_recharge:SetGoods()
    local mallManager = require("MallManager"):GetInstance()

    --ZHJH-7552【客户端】秒约IOS渠道屏蔽代金券1280/3280/6480档位
    --只处理"秒约/ios/代金券"商城, 秒约渠道id: 13304
    local filterPrice = -1
    if self.IsSDK and _G.AppSetting.IsIos and self.nowIndex == 2 then
        local platform = _G.ServerManager:GetInstance().AppInfo.Platform
        local platformId = _G.tonumber(platform)
        if platformId ~= nil and platformId == 13304 then
            filterPrice = 64800
        end
    end
    local IsArraigned = _G.AppSetting.IsArraigned
    local channelId = tonumber(_G.SDKManager:GetInstance():GetChannelId())
    self.shopGoodsList = {}
    for i = 1, #self.itemDataList do
        local data = {}
        data = {}
        data.id = self.itemDataList[i].id
        data.icon = self.itemDataList[i].icon
        data.type1 = self.itemDataList[i].type1
        if data.type1 == 2 and _G.GameUtil.CheckVoucherModel() then
            data.icon = data.icon .. "_mj"
        end
        --tb_recharge.aorimage_Icon:SetNativeSize()
        data.name = _G.LangUtil.GetLangPackValue(self.itemDataList[i].name)
        data.count = 1
        data.price_id = self.itemDataList[i].price_id
        data.audit = self.itemDataList[i].audit
        if self.IsSDK then
            local sdkData
            -- local Platform = _G.ServerManager:GetInstance().AppInfo.Platform
            -- local Platformid = _G.tonumber(Platform)
            -- if Platformid ~= nil and Platformid == 77 then
            --     sdkData = self:GetPayInfoByGear(self.itemDataList[i].gear_lenovo)
            -- else
            --     if _G.AppSetting.IsAndriod or _G.AppSetting.IsWebGl then
            --         sdkData = self:GetPayInfoByGear(self.itemDataList[i].gear)
            --     elseif _G.AppSetting.IsIos then
            --         sdkData = self:GetPayInfoByGear(self.itemDataList[i].gear_ios)
            --     end
            -- end
            local gear = {}
            if data.type1 == 2 then
                local gearCfg = _G.ConfigManager.store_gear_cfg[data.price_id]
                gear = gearCfg.gear
            else
                gear = self.itemDataList[i].gear
            end
            for i = 1, #gear do
                sdkData = self:GetPayInfoByGear(gear[i])
                if sdkData then
                    break
                end
            end

            data.name = _G.LangUtil.GetLangPackValue(self.itemDataList[i].name)
            if sdkData then
                data.price = sdkData.price / 100
                -- data.formattedPrice = sdkData.price // 100
                data.sdk_id = sdkData.id
                data.amount = sdkData.amount
            else
                data.price = self.itemDataList[i].price / 100
            end
        else
            data.name = _G.LangUtil.GetLangPackValue(self.itemDataList[i].name)
            data.price = self.itemDataList[i].price / 100
        end
        data.cashTag = {}
        if not require("MallCashModel"):GetInstance():GetIsFirstCash(self.itemDataList[i].id) then
            data.cashTag[1] = 1
            data.cashTag[2] = self.itemDataList[i].extra_default
            data.cashTag[3] = false
        else
            data.cashTag[1] = 1
            data.cashTag[2] = self.itemDataList[i].extra_first
            data.cashTag[3] = true
        end
        if _G.AppSetting.IsXzns then
            local isInsert = false
            if table.isEmptyOrNil(data.audit) then
                isInsert = true
            else
                if IsArraigned and table.indexof(data.audit, channelId) then
                    isInsert = true
                end
            end
            if isInsert then
                self.shopGoodsList[#self.shopGoodsList + 1] = data
            end
        else
            if filterPrice < 0 or mallManager:GetFinalPrice(data.price_id or data.price) <= filterPrice then
                self.shopGoodsList[#self.shopGoodsList + 1] = data
            end
        end
    end
end

function MallView_recharge:AddBtn(MallListItems, go, index)
    if not self.itemDataList[index] then
        return
    end
    require("MallManager"):GetInstance():BuyFixedGoods(self.itemDataList[index], self.shopGoodsList[index])
end

function MallView_recharge:AddDJQBtn(MallListItems, go, index)
    require("MallManager"):GetInstance():BuyActiveGift(
        self.itemDataList[index].price_id,
        nil,
        self.itemDataList[index].id,
        false
    )
end

function MallView_recharge:OnMallCashListener(data)
    if _G.ConfigManager.store_recharge_cfg[data.sid] then
        if self.gameObject:GetctiveInHierarchy() == 1 then
            self:FreshPage(true)
        end
    end
end

function MallView_recharge:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_tip" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, instructionCfgSid)
    elseif name == "@_aorbtn_tip2" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, instructionCfgSid2)
    elseif name == "@_aorbtn_mllb" then
        require("MallManager"):GetInstance():GetMallWeekFree(function(data)
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
            require("MallManager"):GetInstance():SetFreeTime()
            self:ShowFreeGift()
            require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.StoreVoucher.id)
        end)
    end
end

---销毁对象时,析构函数
function MallView_recharge:OnDestroy()
    _G.SDKManager:GetInstance():RemoveListener(SDKDef.GetMsg.pay_goods_list, self.GetPayGoodsList, self)
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

return MallView_recharge
