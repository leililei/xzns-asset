local MallView_recharge = _G.BaseClass("MallView_recharge", base)
local instructionCfgSid = 119
local instructionCfgSid2 = 160
---创建对象时,入口构造函数
function MallView_recharge:Init(...)
    self.ItemList = {}
    self.IsSDK = _G.CS.Launcher.Inst.IsSDK
    if self.IsSDK then
        _G.SDKManager:GetInstance():AddListener(SDKDef.GetMsg.pay_goods_list, self.GetPayGoodsList, self)
    end
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    self.itemObjDic = {}
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    self.curPageType = 5
    self.itemList = {}

    if not _G.IsNil(self.go_table.obj_GoldInfo) and self.go_table.obj_GoldInfo:GetctiveInHierarchy() == 1 then
        local resources = _G.GameUtil.GetVoucherResource({12})
        self.resource =
            self:AddComponent(
            self.go_table.obj_GoldInfo,
            require("ResourceCompont").New(self.go_table.obj_GoldInfo, resources)
        )
    end
    self.playerHead = self:AddComponent(self.go_table.obj_PlayerHead,
        require("PlayerComponent").New(self.go_table.obj_PlayerHead))
    if ... then
        local args = { ... }
        self.nowIndex = args[1]
    else
        self.nowIndex = 1
    end
    self:ShowHeXieMask()
    self:ShowFreeGift()

    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function MallView_recharge:ShowFreeGift()
    local curFree = require("MallManager"):GetInstance():GetFreeTime()
    self.go_table.obj_VipSelection:SetActiveE(curFree == 0 and 1 or 0)
end

