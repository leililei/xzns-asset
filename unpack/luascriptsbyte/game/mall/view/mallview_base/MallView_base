---@class MallView_base : Component	商城系统-子页面
local MallView_base = _G.BaseClass("MallView_base", _G.Component)

-- local CS = _G.CS
-- local typeof = _G.typeof

---创建对象时,入口构造函数
------@param mallview MallView
function MallView_base:OnCreate(obj, MallView, ...)
    ---@type MallView
    self.mMallView = MallView
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    self:Init(...)
    -- self.gameObject:SetActiveE(0)
end
function MallView_base:Init()
    --(" Init未重写 " .. self.__cname)
end
function MallView_base:Show()
    self.gameObject:SetActiveE(1)
end
function MallView_base:Hide()
    self.gameObject:SetActiveE(0)
end

function MallView_base:UpdataView()
    --(" UpdataView 未定义 ")
end

---按钮点击事件在这里派发
function MallView_base:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

return MallView_base
