---@param refreshType PersonalizedShop.RefreshType
function PersonalizedShop:AddRefreshGroup(addtable,refreshType,isAddLine)
    if isAddLine == nil then
        isAddLine = true
    end
    local count = #addtable
    local dataIndex = 1
    local groupIndex = #self.RefreshList
    local groupCount = math.ceil(count / 3)
    for i = 1, groupCount do
        --local groupId = groupIndex + i
        ---@type PersonalizedShop.LoopData
        self.RefreshList[i] = {
            data = {addtable[dataIndex],addtable[dataIndex + 1],addtable[dataIndex + 2]},
            RefreshType = refreshType,
        }
        dataIndex = dataIndex + 3
        groupIndex = groupIndex + 1
    end

    if isAddLine and count > 0 then
        self.RefreshList[groupIndex + 1] = {
            data = nil,
            RefreshType = PersonalizedShop.RefreshType.line,
        }
    end
end

