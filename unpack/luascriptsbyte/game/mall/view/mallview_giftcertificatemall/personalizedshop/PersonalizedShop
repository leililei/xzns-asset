function PersonalizedShop:RefreshItem_Personal(listView2, index)
    local data = self.RefreshList[index + 1]
    local item = listView2:NewListViewItem(PersonalizedShop.ItemName[data.RefreshType])
    if data.RefreshType ~= PersonalizedShop.RefreshType.line then
        local count = #data.data
        local childCount = item:GetChildCountE()
        for i = 1, childCount do
            local childobj = item:GetChildE(i - 1)
            if i <= count then
                childobj:SetActiveE(1)
                local propData = data.data[i]
                local obj_titleIcon = GetAutoGoTable(childobj,handlerbind(self.view,self.view.OnClickBuy,propData,propData.cfg.subtab))
                local itemdata = _G.StorageManager:GetItemDataClassByCfg(propData.cfg.get_item)
                self.view:RefreshProp(obj_titleIcon,propData,itemdata:GetName(),itemdata:GetGrade(),self.view:GetIcon(propData.cfg),true)
            else
                childobj:SetActiveE(0)
            end
        end
    end
    --_G.GameUtil.ReBuildRTF(tb.gameObject)

    return item
end

