function MallView_GiftCertificateMall:RefreshItem(index,obj)
    local newIndex = index + 1
    local id = obj:GetInstanceIDE()
    if self.curSelectTag == MallView_GiftCertificateMall.Tagtype.Fashion then
        local data = self.CurSelectSkinData[newIndex]
        local itemdata = _G.StorageManager:GetItemDataClassByCfg(data.items)
        local skinid = tonumber(itemdata.cfg.UseParameter[1][1])
        local skinData = self.CardCommentManager:GetCfgs(skinid)
        local tb = _G.GetAutoGoTable(obj,
                _G.handlerbind(self, self.OnClickBuy, data, itemdata,4))
        local skinCfg = _G.ConfigManager.skin_cfg[skinid]
        self:RefreshProp(tb,data,GetLangPackValue(itemdata.cfg.Name),tonumber(skinCfg.SkinType),skinData.Photo2)
        if data.sellout or data.isHave then
            tb.aortext_buyRestr:SetActiveE(0)
        else
            tb.aortext_buyRestr:SetActiveE(1)
            tb.aortext_buyRestr.text = GetLangPackValue(90049200092,0,data.cfg.count_limit)
        end
    elseif self.curSelectTag == MallView_GiftCertificateMall.Tagtype.RingGod then
        local data = self.ShowDataList[newIndex]
        ---@type god_halo_cfg
        local cfg = ConfigManager.god_halo_cfg[data.cfg.get_item[1]]
        local itemdata = _G.StorageManager:GetItemDataClassByCfg(data.items)
        if cfg == nil then
            return
        end
        --local itemdata = _G.StorageManager:GetItemDataClassByCfg(data.items)
        local tb = _G.GetAutoGoTable(obj,
                _G.handlerbind(self, self.OnClickBuy, data,itemdata,7))
        self:RefreshProp(tb,data,GetLangPackValue(cfg.name),self:GetGradequality(cfg.grade),cfg.icon)
    elseif self.curSelectTag == MallView_GiftCertificateMall.Tagtype.artifactSkin then
        local data = self.ShowDataList[newIndex]
        local itemdata = _G.StorageManager:GetItemDataClassByCfg(data.items)
        local skinid = tonumber(itemdata.cfg.UseParameter[1][1])
        local tb = _G.GetAutoGoTable(obj,
                _G.handlerbind(self, self.OnClickBuy, data, itemdata,10))
        local skinCfg = _G.ConfigManager.artifact_skin_cfg[skinid]
        self:RefreshProp(tb,data,GetLangPackValue(itemdata.cfg.Name))
        self:RefreshArtifactskinminRole(tb,skinCfg)
        if data.sellout or data.isHave then
            tb.aortext_buyRestr:SetActiveE(0)
        else
            tb.aortext_buyRestr:SetActiveE(1)
            tb.aortext_buyRestr.text = GetLangPackValue(90049200092,0,data.cfg.count_limit)
        end
    end
    --local item = self.itemList[id]
    --item:Show(cfg, newIndex)
end
---@param skincfg artifact_skin_cfg
function MallView_GiftCertificateMall:RefreshArtifactskinminRole(tb,skincfg)
    local cfg=_G.ConfigManager.skin_cfg[skincfg.skin_id]
    local path = cfg.spine and cfg.spine[1] or cfg.ModelPathHi
    tb.obj_miniSpine:ClearChildren()
    _G.PoolsManager:GetInstance():Spawn(
            path,
            _G.ePoolType.Temporary,
           tb.obj_miniSpine,
            function(obj)
                if table.isEmptyOrNil(tb) then
                    _G.DestroyObject(obj)
                    return
                end
                obj:SetLocalScaleXYZ(cfg.size6 or 1.2)
                local sg = obj:GetChildE(0):GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
                sg.AnimationState:SetAnimation(0, "stand_2", true)

                --- 只有星座女神有神环
                if _G.AppSetting.IsXzns then
                    local godHaloID = _G.PlayerModel:GetInstance():IsCardWearGodHalo(cfg.id)
                    if godHaloID ~= 0 then
                        local effCfg = _G.ConfigManager.god_halo_cfg[godHaloID].ui_effect_cfg
                        --- 神环路径，父级路径(加载角色的下面)
                        _G.UIUtils.LoadGodHalo(effCfg, obj, godHaloID)
                    end
                    _G.UIUtils.LoadArtifacteffect(obj,nil ,skincfg.id,table.count(skincfg.ui_form_effect),true)
                end
            end
    )
end

function MallView_GiftCertificateMall:GetGradequality(grade)
    if grade == 5 then
        return 1
    elseif grade == 6 then
        return 2
    else
        return 3
    end
end

---@param tb _obj_skinItem_GoTable
---@param data DressModel:CacheGoodsBaseInfo
function MallView_GiftCertificateMall:RefreshProp(tb,data,name,quality,icon,isPersonShop)
    if isPersonShop == nil then
        isPersonShop = false
    end
    local orderStr = { "ui_sj_img_touxiang", "ui_sj_img_chenghao", "ui_sj_img_cai" }
    local bgicon = orderStr[quality]
    if bgicon == nil then
        bgicon = orderStr[3]
    end
    if data.cfg.subtab == 4 then
        bgicon = "ui_sj_img_cai"
    end
    if isPersonShop then
        bgicon = "ui_sc_bak_huang"
    end
    tb.aorimage_MonthIcon:LoadAtlasSprite("AtlasH5/hMallXzns/hMallXznsAtlas", bgicon)
    tb.aorimage_MonthIcon.SpriteName = bgicon

    local need_item = data.cfg.need_item
    local needData = _G.StorageManager:GetItemDataClassByCfg(need_item)

    tb.aorrawimage_icon:LoadImage(needData:GetIconPath(),function(trans)
        if self.go_table == nil then
            DestroyObject(trans)
        end
        -- trans:SetNativeSize()
    end)
    tb.aorbtn_btn2:SetActiveE(data.cfg.subtab == 7 and 1 or 0)
    local number = data.sellout == true and 1 or 0
    tb.aortext_ItemName.text = name
    tb.aortext_limit.text = GetLangPackValue(90021600010,
            number, 1)
    if icon then
        tb.aorrawimage_Icon:LoadImage(
                icon,
                function(trans)
                    if self.go_table == nil then
                        DestroyObject(trans)
                    end
                    trans:SetNativeSize()
                end
        )
    end
    if data.sellout then
        --tb.aortext_price.color = require("CardInfoManager").GetColorFromRGB("c95f00")
        tb.aorbtn_btn:SetActiveE(0)
        tb.aorimage_isHave:SetActiveE(0)
        tb.aorimage_sellOut:SetActiveE(1)
        tb.aortext_price:SetActiveE(0)
    elseif data.isHave then
        tb.aorbtn_btn:SetActiveE(0)
        tb.aorimage_isHave:SetActiveE(1)
        tb.aorimage_sellOut:SetActiveE(0)
        tb.aortext_price:SetActiveE(0)
    else
        tb.aorbtn_btn:SetActiveE(1)
        tb.aorimage_isHave:SetActiveE(0)
        tb.aorimage_sellOut:SetActiveE(0)
        tb.aortext_price:SetActiveE(1)
        tb.aortext_price.text = data.need_item[2]
    end
end

---点击购买
function MallView_GiftCertificateMall:OnClickBuy(go,ison,data,itemdata,subType)
    local name = go:GetName()

    if name == "@_aorbtn_btn" then
        if subType==nil  then
            subType = data.cfg.subtab
        end
        if subType==10 then
            local ArtifactIllustrationModel=require("ArtifactIllustrationModel"):GetInstance()
            if ArtifactIllustrationModel:CheckArtifaceIsUnLockBySkinId(data.cfg.skinID)==0 then
                _G.PopWindowManager:GetInstance():ShowAllTips(271801)
                return 
            end
            local artifactskincfg=_G.ConfigManager.artifact_skin_cfg[data.cfg.skinID]
            local artifactcfg=_G.ConfigManager.artifact_cfg[artifactskincfg.card]
            if not require("CardCommentManager"):GetInstance():CradSid(artifactcfg.card_id,artifactskincfg.skin_id) then
                _G.PopWindowManager:GetInstance():ShowAllTips(271802)
                return
            end
        end
        self:BuyshopData(data)
    elseif name == "@_aorbtn_jump" then
        if subType == nil then
            subType = data.cfg.subtab
        end
        self:OpenPropWindow(go,subType,data,itemdata)
    elseif name == "@_aorbtn_btn2" then
        --展示详情
        if subType == 7 then
            --打开神环详情界面
            local cfg = _G.ConfigManager.god_halo_cfg[data.cfg.get_item[1]]
            local need_item = data.cfg.need_item
            local needData = _G.StorageManager:GetItemDataClassByCfg(need_item)

            ---@type GodHaloShowView
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GodHaloShowView.Name, cfg,{
                icon = needData:GetIconPath(),
                num = data.need_item[2],
            },data,nil,handler(self,self.BuyshopData))
        end
    end
end

function MallView_GiftCertificateMall:BuyshopData(data)
    if data.sellout or data.isHave then
        return
    end

    self.mdoel:BuyItem(
            data,
            function()
                _G.Events:GetInstance():Broadcast(_G.eCertificateMall.Buy, data.cfg.condition_limit)
                data.sellout = true
                self:RefreshData()
                self:RefreshUI()
            end
    )
end

function MallView_GiftCertificateMall:RefreshData()
    if self.curSelectTag == MallView_GiftCertificateMall.Tagtype.Head  then

    else
        self.ShowDataList = self.mdoel:GetGoods(self.curSelectTag,ConfigManager.store_god_dress_cfg)
    end
    self.curSelectTagData = self.tagbtnData[self:TagIdToIndex(self.curSelectTag)]

    self.isShowSkinTag = false
    if self.curSelectTag == MallView_GiftCertificateMall.Tagtype.Fashion then
        self.CurSelectSkinData = {}
        local count = #self.ShowDataList
        --_G.LogError("数量：" .. count)
        local group1 = {}
        local group2 = {}
        for i = 1, count do
            --if self.ShowDataList[i].cfg.layer2 == self.CurSelectSkinTag then
            --    table.insert(self.CurSelectSkinData,self.ShowDataList[i])
            --end
            if self.ShowDataList[i].cfg.layer2 == MallView_GiftCertificateMall.SkinTag.Normal then
                table.insert(group1,self.ShowDataList[i])
            else
                table.insert(group2,self.ShowDataList[i])
            end
        end

        local count1 = #group1
        local count2 = #group2
        if count2 == 0 or count1 == 0 then
            self.isShowSkinTag = false
        else
            self.isShowSkinTag = true
        end
        if self.CurSelectSkinTag == MallView_GiftCertificateMall.SkinTag.Normal then
            if count1 == 0 and count2 > 0 then
                self.CurSelectSkinTag = MallView_GiftCertificateMall.SkinTag.Fashion
                self.CurSelectSkinData = group2
            else
                self.CurSelectSkinData = group1
            end
        else
            self.CurSelectSkinData = group2
        end
        --_G.LogError("CurSelectSkinData数量：" .. #self.CurSelectSkinData)
    end
end

function MallView_GiftCertificateMall:TagIdToIndex(tagtype)
    if tagtype == MallView_GiftCertificateMall.Tagtype.RingGod then
        return 1
    elseif tagtype == MallView_GiftCertificateMall.Tagtype.Fashion then
        return 2
    elseif tagtype == MallView_GiftCertificateMall.Tagtype.Head then
        return 3
    elseif tagtype == MallView_GiftCertificateMall.Tagtype.artifactSkin then
        return 4
    end
end

function MallView_GiftCertificateMall:InitUI()
    GameUtil.SetChildCount(self.go_table.obj_ToggleContent,self.tagCount,function(trans,index)
        local data = self.tagbtnData[index]
        ---@type MallView_giftCertificate._obj_ListItem_GoTable
        local gotable = GetAutoGoTable(trans,handlerbind(self,self.SetTag,data.tagType))
        gotable.aortext_Name.text = GetLangPackValue(data.tagNameKey)
        data.tagGotable = gotable
    end)
    local resources = {12}
    if resources and #resources > 0 then
        ---@type ResourceCompont
        self.resbar =  self:AddComponent(
                self.go_table.obj_GoldInfo,
                require("ResourceCompont").New(self.go_table.obj_GoldInfo, resources)
        )
    end
    self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))

    local count = 0
    for i, v in pairs(_G.ConfigManager.store_god_dress_cfg) do
        count = count + 1
    end
    _G.PlayerPrefsManager.SetInt("_RedPointBeastGiftCert_QuantityGoods", count)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GiftCert.id)

    ---@type table<MallView_GiftCertificateMall,MallView_giftCertificate._toggle_pass_GoTable>
    self.skinTagDict = {
        [MallView_GiftCertificateMall.SkinTag.Normal] = GetAutoGoTable(self.go_table.toggle_pass,handlerbind(self,self.SetSkinTag,MallView_GiftCertificateMall.SkinTag.Normal)),
        [MallView_GiftCertificateMall.SkinTag.Fashion] = GetAutoGoTable(self.go_table.toggle_task,handlerbind(self,self.SetSkinTag,MallView_GiftCertificateMall.SkinTag.Fashion)),
    }
end

function MallView_GiftCertificateMall:SetSkinTag(go,ison,SelectTag)
    self.CurSelectSkinTag = SelectTag
    self:RefreshTag()
    self:RefreshData()
    self:RefreshUI()
end

function MallView_GiftCertificateMall:RefreshUI()
    self:RefreshTag()
    local isShowGift = 0
    local giftName = 90033000002
    if self.curSelectTag == MallView_GiftCertificateMall.Tagtype.Head then
        self.curSelectTagData.PersonalizedShop:RefreshData(self.ShowDataList)
        self.curSelectTagData.PersonalizedShop:RefreshUI(#self.ShowDataList)
    elseif self.curSelectTag == MallView_GiftCertificateMall.Tagtype.Fashion then
        self.curSelectTagData.loopList:UpdateCount(#self.CurSelectSkinData)
        isShowGift = 1
    else
        if self.curSelectTag == MallView_GiftCertificateMall.Tagtype.artifactSkin then
            isShowGift = 1
            giftName = 90033000007
        end
        if self.ShowDataList == nil then
            return
        end
        self.curSelectTagData.loopList:UpdateCount(#self.ShowDataList)
    end
    self.go_table.aorbtn_gift:SetActiveE(isShowGift)
    self.go_table.aortext_giftName.text = _G.GetLangPackValue(giftName)
    if self.ShowDataList and self.ShowDataList[1] and self.resbar then
        local data = self.ShowDataList[1]
        local curresbatIds = {data.need_item[1]}
        if self.curSelectTag == MallView_GiftCertificateMall.Tagtype.Fashion and self.CurSelectSkinData[1] then
            curresbatIds = {self.CurSelectSkinData[1].need_item[1]}
        end
        local cfg = resourceCfg[self.curSelectTag]
        local res = cfg[self.CurSelectSkinTag] and cfg[self.CurSelectSkinTag] or cfg[1]
        self.resbar:RestRs({ res })
    end
end

function MallView_GiftCertificateMall:SetTag(go,ison,tagType)
    self.curSelectTag = tagType
    self:RefreshData()
    self:RefreshUI()
end

function MallView_GiftCertificateMall:RefreshTag()
    for i = 1, self.tagCount do
        local data = self.tagbtnData[i]
        if data.tagType == self.curSelectTag then
            data.tagGotable.obj_Select:SetActiveE(1)
            data.tagGotable.obj_Normal:SetActiveE(0)
            data.tagGotable.aortext_Name.text =GetLangPackValue(data.tagNameKey):AddColor("50351E")
            data.loopList:SetActiveE(1)
        else
            data.tagGotable.obj_Select:SetActiveE(0)
            data.tagGotable.obj_Normal:SetActiveE(1)
            data.tagGotable.aortext_Name.text = GetLangPackValue(data.tagNameKey):AddColor("BBBAB4")
            data.loopList:SetActiveE(0)
        end
    end

    if self.curSelectTag == MallView_GiftCertificateMall.Tagtype.Fashion then
        self.go_table.obj_downTag:SetActiveE(self.isShowSkinTag and 1 or 0)
        for i = 1, 2 do
            local data = self.skinTagDict[i]
            data.aorimage_isOn:SetActiveE(i == self.CurSelectSkinTag and 1 or 0)
        end
    else
        self.go_table.obj_downTag:SetActiveE(0)
    end

    self.go_table.obj_downPersonTag:SetActiveE(self.curSelectTag == MallView_GiftCertificateMall.Tagtype.Head and 1 or 0)
    
end

function MallView_GiftCertificateMall:UpdataView()
    self:RefreshData()
    self:RefreshUI()
end

