function MallView_GiftCertificateMall:OpenPropWindow(go,subType,data,itemdata)
    self.jumpheadId = nil
    self.jumpheadbox = nil
    self.jumptitle = nil
    self.jumpChatbox = nil
    if subType == 4 then
        --- 获取卡牌数据 查找此皮肤是否已经挂载在卡牌上了
        local cardData = require("CardData").GetPreviewData(data.cfg.cardID)
        local skinList = cardData.cfg.skin
        local show = #skinList > 0 and cardData.type ~= _G.CardType.Timer
        local haveSkin = false
        if show then
            for i = 1, #skinList do
                if skinList[i] == data.cfg.skinID then
                    haveSkin = true
                end
            end
        end

        if haveSkin then
            cardData:SetSkin(0)
            _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.CardShowView.Name,
                    { CardData = cardData },
                    nil,
                    true,
                    nil,
                    data.cfg.skinID)
        else
            if itemdata then
                require("CommonTipManager"):GetInstance():OpenPropTip(go, itemdata.cfg.ID)
            end
        end
    elseif subType == 9 then
        self.jumpheadId = tonumber(_G.ConfigManager.item_cfg[data.cfg.get_item[1]].UseParameter[1][1])
        self:JumpView(MallView_GiftCertificateMall.itemType.Frame)
    elseif subType == 8 then
        self.jumpChatbox = tonumber(_G.ConfigManager.item_cfg[data.cfg.get_item[1]].UseParameter[1][1])
        ---聊天框
        self:JumpView(MallView_GiftCertificateMall.itemType.ChatFrame)
    elseif subType == 2 then
        self.jumptitle = tonumber(_G.ConfigManager.item_cfg[data.cfg.get_item[1]].UseParameter[1][1])
        ---称号
        self:JumpView(MallView_GiftCertificateMall.itemType.Title)
    elseif subType == 1 then
        ---头像框
        self.jumpheadbox = tonumber(_G.ConfigManager.item_cfg[data.cfg.get_item[1]].UseParameter[1][1])
        self:JumpView(MallView_GiftCertificateMall.itemType.Role)
    elseif subType == 7 then
        --打开神环主界面
        ---@type GodHaloMainView
        _G.JumpManager:GetInstance():Jump(310002,self.EmtyFunc,
            data.cfg.get_item[1]
        )
    elseif subType==10 then
        --- 获取卡牌数据 查找此皮肤是否已经挂载在卡牌上了
        ---@type CardData
        local cardData = require("CardData").GetPreviewData(data.cfg.cardID)
        local skinList=_G.ConfigManager.artifact_cfg[cardData.cfg.artifactid].skin
        local show = #skinList > 0 and cardData.type ~= _G.CardType.Timer
        local haveSkin = false
        if show then
            for i = 1, #skinList do
                if skinList[i] == data.cfg.skinID then
                    haveSkin = true
                end
            end
        end 
        if haveSkin then
            cardData:SetSkin(0)
            _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.CardShowView.Name,
                    { CardData = cardData },
                    nil,
                    true,
                    nil,
                    data.cfg.skinID)
        else
            if itemdata then
                require("CommonTipManager"):GetInstance():OpenPropTip(go, itemdata.cfg.ID)
            end
        end
    end
end

---@param openType MallView_GiftCertificateMall.itemType
function MallView_GiftCertificateMall:JumpView(openType)
    local uid = _G.PlayerModel:GetInstance():GetPlayerUid()
    local msg = {}
    msg.uid = uid
    local SystemSettingNet = require("SystemSettingNet")
    SystemSettingNet:GetInstance():GetPlayerInfo(
        msg,
        _G.handlerbind(
            self,
            self.GetPlayerInfoSuccess,
            function(data)
                ---@type ChangeIconView
                _G.JumpManager:GetInstance():Jump(310001,self.EmtyFunc,
                    data.style or nil,
                    data.frame or nil,
                    data.city_style_id or nil,
                    data.title or nil,
                    nil,nil,nil,
                    openType,self.jumpChatbox,self.jumpheadId,self.jumptitle,self.jumpheadbox
                )
            end
        )
    )
end

