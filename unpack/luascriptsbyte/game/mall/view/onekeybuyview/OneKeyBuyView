---增减数量
function OneKeyBuyView:SetSelectOne(index, id, num)
    -- if self.CurSelectNum + num > maxLimit or self.CurSelectNum + num < 0 then
    --     -- _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.OverMaxCount)
    --     return
    -- end
    if not self.CurSelect[index] and num < 0 then
        return
    end

    if self.CurSelect[index] == 0 and num < 0 then
        return
    end

    if not self.CurSelect[index] then
        self.CurSelect[index] = 0
    end

    self.CurSelect[index] = self.CurSelect[index] + num
    -- self.CurSelectNum = self.CurSelectNum + num
    -- self.go_table.aortext_useNum.text = _G.GetLangPackValue(90020200043, self.CurSelectNum, self.itemData.count)
    self.SelectItems[id].input_Name.text = self.CurSelect[index]
    local list = {}
    self.shopSave[self.goodsData[index].sid] = self.CurSelect[index]
    for k, v in pairs(self.shopSave) do
        _G.table.insert(list, { key = k, value = v })
    end
    require("ShopModel"):GetInstance():RememberSave(self.CurShopID, list)
end

