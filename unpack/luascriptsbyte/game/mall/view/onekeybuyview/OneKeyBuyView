---界面的入口函数
---@param sid number 道具id
---@param call function 使用成功回调
function OneKeyBuyView:OnCreate(goodsData, ShopID, call)
    self.goodsData = goodsData
    self.CurShopID = ShopID
    self.CurSelect = {}
    self.SelectItems = {}
    self.call = call
    require("ShopModel"):GetInstance():GetRemember(self.CurShopID, function(data)
        self.shopSave = {}
        if data then
            for i, v in ipairs(data) do
                self.shopSave[v.key] = v.value
            end
        end
        self:CreateItem()
    end)
end

---创建可选择的道具
function OneKeyBuyView:CreateItem()
    self.go_table.scrollloopvectical_View:InitItemData(_G.table.count(self.goodsData), _G.handler(self, self.RefreshItem))
end

function OneKeyBuyView:RefreshItem(index, obj)
    index = index + 1
    local data = self.goodsData[index]

    self:SetItem(obj, data, index)
end

---创建可选择的道具
function OneKeyBuyView:SetItem(tran, data, i)
    local tb, itemData
    local _data = {}
    local id = tran:GetInstanceIDE()
    itemData = _G.StorageManager:GetInstance():GetItemDataClassByCfg(data)
    tb = _G.GetAutoGoTable(tran, _G.handlerbind(self, self.ClickSelectItem, i, id, data[1], data[3]))
    tb.input_Name.onEndEdit:RemoveAllListeners()
    tb.input_Name.onEndEdit:AddListener(_G.handlerbind(self, self.OnEndEditorDeclarationOen, i, id, data[1]))

    tb.input_Name.text = self.CurSelect[i] or (self.shopSave[data.sid] or 0)
    self.SelectItems[id] = tb
    tb.aortext_num.text = _G.GameUtil.NumberToShopPrice(data.price)

    if data.currencyIcon then
        tb.aorrawimage_icon.Alpha = 0
        tb.aorrawimage_icon:LoadImage(data.currencyIcon)
    end
    local CreateItem = function(item, parent)
        local type
        local cfg
        local sid
        local count
        local element
        if item then
            sid = item[1]
            count = item[2]
            element = item[3]
            local array = { [1] = sid, [2] = count, [3] = element }
            type = _G.StorageManager:GetInstance():CheckSidType(sid)
            cfg = _G.ConfigManager.item_cfg[sid]
            if
                type == _G.StorageType.Prop and cfg and cfg.Type1 and cfg.Type1 == 6 and
                _G.ConfigManager.card_cfg[_G.tonumber(cfg.UseParameter[1][2])]
            then
                _G.ItemFactory:GetInstance():GetItemCard(
                    _G.ItemFactory.itemType.ItemDebrisBase,
                    parent,
                    function(trans)
                        if not cfg then
                            _G.DestroyObject(trans.go_table.gameObject)
                            return
                        end
                        trans:Show(sid, nil, count)
                        local HideEffect = false
                        if self.CurShopID == 6 and data.Restrict[1] and data.Restrict[1][1] == 1 then
                            local delta = data.Restrict[1][3] - require("SeasonModel"):GetInstance():GetTotalCoin()
                            HideEffect = delta > 0
                        end
                        if trans.SetGradeNew then
                            trans:SetGradeNew(HideEffect)
                        end
                    end
                )
            else
                _G.StorageManager:GetInstance():GetItemBaseViewNew(
                    array,
                    parent,
                    function(trans)
                        trans.sid = sid
                        trans.gameObject:SetLocalPosition(0, 0, 0)
                        if array[2] then
                            trans:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                        end
                        local HideEffect = false
                        if self.CurShopID == 6 and data.Restrict[1] and data.Restrict[1][1] == 1 then
                            local delta = data.Restrict[1][3] - require("SeasonModel"):GetInstance():GetTotalCoin()
                            HideEffect = delta > 0
                        end
                        if type == _G.StorageType.Debris then
                            HideEffect = true
                        end
                        if trans.SetGradeNew then
                            trans:SetGradeNew(HideEffect)
                        end
                        -- if type == _G.StorageType.Equipment then
                        --     local haveRedPoint = false
                        --     if self.model:IsItemRedPoint(self.CurShopID, tb.data.index) then
                        --         if self.commendCards == nil then
                        --             self.commendCards = require("CardResonanceModel"):GetInstance():GetAllPosCards()
                        --         end
                        --         local list = self.commendLis
                        --         list[x] = require("EquipmentModel"):GetInstance():GetCommendCardsBySidAndEle(
                        --             sid,
                        --             element,
                        --             self.commendCards
                        --         )
                        --         haveRedPoint = #list[x] > 0
                        --     end
                        --     trans:RefreshRedPoint(haveRedPoint)
                        -- end
                    end,
                    function(go)
                        require("CommonTipManager"):GetInstance():OpenTip(parent, go.sid or go[1].sid)
                    end
                )
            end
        end
    end


    if data.cfg.item ~= nil then
        tb.obj_item:ClearChildren()
        CreateItem({ data.cfg.item[1], data.count, data.cfg.item[3] }, tb.obj_item)
        _G.GameUtil.SetActiveByCondition(tb.obj_SellOut, data.BuyTime > 0)
        local limitBol = 0
        if data.limit > 0 then
            if data.limit <= data.BuyTime then
                limitBol = 1
            end
            -- tb.aortext_num.text = data.limit - data.BuyTime
        end
        -- tb.obj_Limit:SetActiveE(data.limit > 0 and 1 or 0)
        if not _G.table.isEmptyOrNil(data.conditions) then
            local lockBol, tipsID, content = _G.GlobalConditionManager.CheckConditionArrays(data.conditions)
