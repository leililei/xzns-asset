end

---选择完毕确认使用
function OneKeyBuyView:Done()
    local items = {}
    local datas = {}

    for k, v in pairs(self.goodsData) do
        if self.CurSelect[k] ~= nil and self.CurSelect[k] ~= 0 then
            table.insert(items, v)

            local data = {}
            data.buy_num = self.CurSelect[k]
            data.buy_type = v.sp and 2 or 1
            if v.cfg.item then
                data.index = v.index
            else
                data.id = v.sid
            end
            table.insert(datas, data)
        end
    end

    if #datas == 0 then
        return
    end
    require("ShopModel"):GetInstance():BuyAllItem(
        self.CurShopID,
        items,
        datas,
        function()
            _G.AudioManager.PlayAudioByAudioCfgID(2013)
            if self.call then
                self.call()
            end
            self:Close()
        end
    )
end

---选择完毕确认使用
function OneKeyBuyView:DoneUseTape()
    if self.Index == 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.NotSelect)
        return
    else
        _G.StorageManager:GetInstance():UsePropToServer(
            self.sid,
            self.CurSelectNum,
            function()
                if self.call then
                    self.call()
                end
                self:Close()
            end,
            { 1 },
            self.Index
        )
    end
end

---按钮点击事件在这里派发
function OneKeyBuyView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_close" then
        self:Close()
    elseif name == "@_aorbtn_Done" then
        self:Done()
    elseif name == "@_aorbtn_propSub" then
        self:SetSelect(-1)
    elseif name == "@_aorbtn_propAdd" then
        self:SetSelect(1)
    elseif name == "@_aorbtn_propMax" then
        self.CurSelectNum = self.itemData.count > 9999 and 9999 or self.itemData.count
        -- self.go_table.aortext_useNum.text = _G.GetLangPackValue(90020200043, self.CurSelectNum, self.itemData.count)
        _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(self.go_table.aorimage_numdi.rectTransform)
        self.go_table.input_userNum.text = self.CurSelectNum
    end
end

return OneKeyBuyView
