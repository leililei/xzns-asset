require "CommonUIEffect"
---@class MallItemDetailView : UIBaseView    中文描述
---@field public go_table MallItemDetailView_GoTable GoTable
local MallItemDetailView = _G.BaseClass("MallItemDetailView", _G.UIBaseView)
local CS = _G.CS
local typeof = _G.typeof
local RectCfg = {
    ItemListRoot = {x = 0, y = -98.9},
    ContentExtral = {width = 447.82, height = 145},
    btnExtralPos = {x = 1, y = -49}
}
local XianGouText = {
    [1] = "90021600007",
    [2] = "90021600008",
    [3] = "90021600009",
    [4] = "90021600010"
}
local ExtralTextId = 90021600026
function MallItemDetailView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.Content1 = self.go_table.obj_content1:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    self.Content2 = self.go_table.obj_content2:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    self.ScrollRect1 = self.go_table.scrollloophorizontal_1:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect))
    self.ScrollRect2 = self.go_table.scrollloophorizontal_2:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect))
    self.ItemListRootVerticalLayoutGroup =
        self.go_table.obj_ItemList:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.VerticalLayoutGroup))
    self.GridLayoutGroup1 = self.go_table.obj_Content1:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.GridLayoutGroup))
    self.GridLayoutGroup2 = self.go_table.obj_Content2:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.GridLayoutGroup))
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
end

---@class MallItemDetailViewParams
---界面的入口函数
---@param params MallItemDetailViewParams 参数
---@param CurShopID number 商城id 3月卡 4货架礼包
---@param cantBuy {str,call} 策划需要 未达到购买条件 也需要打开界面 界面显示有所更改 字符串为下方价格更改字符串 call为点击按钮回调
function MallItemDetailView:OnCreate(id, CurShopID, call, cantBuy)
    if not _G.table.isEmptyOrNil(cantBuy) then
        self.cantBuyCall = cantBuy.call
        self.cantBuyStr = cantBuy.str
    end
    self.call = call
    self.id = id
    self.CurShopID = CurShopID
    self.Cfg =
        CurShopID == 3 and _G.ConfigManager.store_month_cfg[self.id] or _G.ConfigManager.store_exchange_cfg[self.id]
    if self.Cfg.day_extra and self.Cfg.day_extra > 0 then
        self:InitView(1)
    else
        self:InitView(0)
    end
end
---@param params number 0无返利天数展示 1额外返利天数展示
function MallItemDetailView:InitView(params)
    self.go_table.scrollloophorizontal_1:InitItemData(0, _G.handler(self, self.RefreshListNormal))
    self.go_table.scrollloophorizontal_1:UpdateCount(#self.Cfg.goods)
    if #self.Cfg.goods <= 4 then
        self.ScrollRect1.horizontal = false
        if #self.Cfg.goods > 3 then
            self.GridLayoutGroup1.padding.left = 25
        elseif #self.Cfg.goods > 2 then
            self.GridLayoutGroup1.padding.left = 75
        elseif #self.Cfg.goods > 1 then
            self.GridLayoutGroup1.padding.left = 115
        else
            self.GridLayoutGroup1.padding.left = 160
        end
        self.GridLayoutGroup1.enabled = true
    end
    if params == 1 then
        self.ItemListRootVerticalLayoutGroup.padding.top = 50
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_content2, true)
        self.go_table.aorbtn_1:SetLocalPosition(RectCfg.btnExtralPos.x, RectCfg.btnExtralPos.y, 0)

        self.go_table.obj_content1:SetRectTransformSize(RectCfg.ContentExtral.width, RectCfg.ContentExtral.height)
        self.go_table.aorbtn_1:SetAnchorPosition(RectCfg.btnExtralPos.x, RectCfg.btnExtralPos.y)
        self.go_table.scrollloophorizontal_2:InitItemData(0, _G.handler(self, self.RefreshListExtral))
        if self.Cfg.goods_extra then
            self.go_table.scrollloophorizontal_2:UpdateCount(#self.Cfg.goods_extra)
            if #self.Cfg.goods_extra <= 4 then
                self.ScrollRect2.horizontal = false
                if #self.Cfg.goods_extra > 3 then
                    self.GridLayoutGroup2.padding.left = 25
                elseif #self.Cfg.goods_extra > 2 then
                    self.GridLayoutGroup2.padding.left = 75
                elseif #self.Cfg.goods_extra > 1 then
                    self.GridLayoutGroup2.padding.left = 115
                else
                    self.GridLayoutGroup2.padding.left = 160
                end
                self.GridLayoutGroup2.enabled = true
            end
        end
        if self.Cfg.day_extra then
            self.go_table.aortext_Extraltext.text =
                string.format(_G.LangUtil.GetLangPackValue(ExtralTextId), self.Cfg.day_extra)
        end
    end
    local datanum = require("MallManager"):GetInstance():GetItemBuyTimes(self.Cfg.id, self.CurShopID)
    self.go_table.aortext_ItemName.text = _G.LangUtil.GetLangPackValue(self.Cfg.name)
    if self.Cfg.type_reset and self.Cfg.count_limit > datanum then
        self.go_table.aortext_ItemLimit.text =
            _G.LangUtil.GetLangPackValue(XianGouText[self.Cfg.type_reset], datanum, self.Cfg.count_limit)
        self.go_table.aortext_ItemLimit:SetActiveE(1)
    else
        self.go_table.aortext_ItemLimit:SetActiveE(0)
    end
    self.go_table.aorrawimage_item:LoadImage(
        self.Cfg.icon[1],
        function(image)
            if image then
                image:SetNativeSize()
            end
        end
    )
    _G.GameUtil.SetActiveByCondition(
        self.go_table.aortext_Name1,
        ((self.Cfg.price and self.Cfg.price ~= 0) or (self.Cfg.price and self.Cfg.price ~= 0)) and not self.cantBuyStr
    )
    _G.GameUtil.SetActiveByCondition(
        self.go_table.aortext_Name2,
        not ((self.Cfg.price and self.Cfg.price ~= 0) or (self.Cfg.price and self.Cfg.price ~= 0)) and
            not self.cantBuyStr
    )
    _G.GameUtil.SetActiveByCondition(self.go_table.aortext_Name3, self.cantBuyStr)
    if self.cantBuyStr then
        self.go_table.aortext_Name3.text = self.cantBuyStr
    end
    if ((self.Cfg.price and self.Cfg.price ~= 0) or (self.Cfg.price and self.Cfg.price ~= 0)) and not self.cantBuyStr then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_Name1, self.Cfg.type_price)
        if not self.Cfg.type_price then
            self.go_table.aortext_Name1:SetLocalPosition(0, 1, 0)
        else
            self.go_table.aortext_Name1:SetLocalPosition(15, 1, 0)
        end
        if self.Cfg.type_price then
            local itemdata = _G.StorageManager:GetInstance():GetStorageItemData(self.Cfg.type_price)
            if itemdata.Icon then
                self.go_table.aorrawimage_Name1.Alpha = 0
                self.go_table.aorrawimage_Name1:LoadImage(itemdata.Icon)
            end
        end
        if self.Cfg.type_price then
            self.go_table.aortext_Name1.text = self.Cfg.price or self.Cfg.price
        else
            self.go_table.aortext_Name1.text = self.Cfg.price or self.Cfg.price
        end
    end
end
function MallItemDetailView:RefreshListNormal(index, obj)
    if index < 0 then
        return
    end
    local x = index + 1
    local goTable = _G.GetAutoGoTable(obj)
    local goods = self.Cfg.goods
    goTable.sid = goods[x][1]
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        goods[x],
        goTable.obj_item,
        function(tran)
            if tran.ShowName then
                tran:ShowName(true)
            end
            tran.go_table.aortext_Name.color = _G.Color.New(0.317, 0.321, 0.407, 1)
            _G.GameUtil.SetActiveByCondition(tran.gameObject, true)
            if tran.SetGrade ~= nil then
                tran:SetGrade(true)
            end
            if tran.ShowNumText ~= nil then
                tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
        end,
        function()
            self:ClickAward(goTable)
        end
    )
end
function MallItemDetailView:RefreshListExtral(index, obj)
    if index < 0 then
        return
    end
    local x = index + 1
    local goTable = _G.GetAutoGoTable(obj)
    local goods_extra = self.Cfg.goods_extra
    goTable.sid = goods_extra[x][1]
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        goods_extra[x],
        goTable.obj_item,
        function(tran)
            if tran.ShowName then
                tran:ShowName(true)
            end
            tran.go_table.aortext_Name.color = _G.Color.New(0.317, 0.321, 0.407, 1)
            _G.GameUtil.SetActiveByCondition(tran.gameObject, true)
            if tran.SetGrade ~= nil then
                tran:SetGrade(true)
            end
            if tran.ShowNumText ~= nil then
                tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
        end,
        function()
            self:ClickAward(goTable)
        end
    )
end
function MallItemDetailView:ClickAward(goTable)
    require("CommonTipManager"):GetInstance():OpenTip(goTable.gameObject, goTable.sid)
end

function MallItemDetailView:OnDisable()
end

---按钮点击事件在这里派发
function MallItemDetailView:OnClickBtn(go)
    if go == self.go_table.aorbtn_1 then
        if self.cantBuyCall ~= nil then
            self.cantBuyCall()
            return
        end
        if self.call ~= nil then
            self.call()
        end
        self:Close()
    elseif go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_Close then
        self:Close()
    end
end

return MallItemDetailView
