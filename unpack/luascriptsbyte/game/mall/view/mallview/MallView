---进入商城，默认前往礼包界面
function MallView:GetOpenShop()
    if _G.AppSetting.IsXzns then
        return self.uiDic[_G.MallViewPage.gift] and _G.MallViewPage.gift or _G.MallViewPage.recharge
    else
        return _G.MallViewPage.gift
    end
end

---逐个页签去加载功能
function MallView:LoadViewRes()
    if self.OneShowIndex == _G.MallViewPage.gift then
        self:LoadGiftRes()
    elseif self.OneShowIndex == _G.MallViewPage.monthly or self.OneShowIndex == _G.MallViewPage.Privilege then
        self:LoadMonthlyRes(self.OneShowIndex)
    elseif self.OneShowIndex == _G.MallViewPage.vip then
        self:LoadVipRes()
    elseif self.OneShowIndex == _G.MallViewPage.recharge then
        self:LoadRechargeRes(1)
    elseif self.OneShowIndex == _G.MallViewPage.rechargeDjq then
        self:LoadRechargeRes(2)
    elseif self.OneShowIndex == _G.MallViewPage.dress then
        self:LoadDressRes()
    elseif self.OneShowIndex == _G.MallViewPage.giftCertificate then
        self:Load_GiftCertificateMall(function()
            local x, y, z = self.go_table.obj_btnNode:GetLocalPosition()
            self.go_table.obj_btnNode:SetLocalPosition(-383, y, z)
        end)
    end
end

---加载时装界面
function MallView:LoadDressRes(callback)
    if not self.Lua_dress then
        self.Lua_dress = true
        _G.PoolsManager:GetInstance():Spawn(
                self.resKey.dress,
                _G.ePoolType.UIItem,
                self.go_table.obj_ViewParent,
                function(tran)
                    if self:IsNil() then
                        return
                    end

                    local link = self.OneShowIndex == _G.MallViewPage.dress and self.tokenId or nil
                    self.Lua_dress = self:AddComponent(tran, require("MallView_dress").New(tran, self, link))
                    self.uiDic[_G.MallViewPage.dress].lua = self.Lua_dress
                    if not self.NowPageIndex or self.NowPageIndex ~= _G.MallViewPage.dress then
                        self:OnClickPage(true, _G.MallViewPage.dress)
                        if callback then
                            callback()
                        end
                    else
                        self.Lua_dress:Hide()
                    end
                end
        )
    elseif self.Lua_dress ~= true then
        if not self.NowPageIndex or self.NowPageIndex ~= _G.MallViewPage.dress then
            self:OnClickPage(true, _G.MallViewPage.dress)
            if callback then
                callback()
            end
        end
    end
end

