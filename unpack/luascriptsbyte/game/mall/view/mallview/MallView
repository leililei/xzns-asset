---加载月卡界面或特权
function MallView:LoadMonthlyRes(mallViewPage, callback)
    if not self.Lua_monthly then
        self.Lua_monthly = true
        _G.PoolsManager:GetInstance():Spawn(
                self.resKey.monthly,
                _G.ePoolType.UIItem,
                self.go_table.obj_ViewParent,
                function(tran)
                    if self:IsNil() then
                        return
                    end

                    local index = mallViewPage == _G.MallViewPage.monthly and self.tokenId or nil
                    if not index or index > 2 then
                        if mallViewPage == _G.MallViewPage.Privilege then
                            index = 1
                        elseif mallViewPage == _G.MallViewPage.monthly then
                            index = 2
                        end
                    end
                    self.Lua_monthly = self:AddComponent(tran, require("MallView_monthlyInMall").New(tran, self, index))
                    if mallViewPage == _G.MallViewPage.monthly then
                        self.uiDic[_G.MallViewPage.monthly].lua = self.Lua_monthly
                    else
                        self.uiDic[_G.MallViewPage.Privilege].lua = self.Lua_monthly
                    end
                    if not self.NowPageIndex or self.NowPageIndex ~= _G.MallViewPage.monthly or self.NowPageIndex ~= _G.MallViewPage.Privilege then
                        self:OnClickPage(true, mallViewPage)
                        if callback then
                            callback()
                        end
                    else
                        self.Lua_monthly:Hide()
                    end
                end
        )
    elseif self.Lua_monthly ~= true then
        if mallViewPage == _G.MallViewPage.monthly or mallViewPage == _G.MallViewPage.Privilege then
            if not self.uiDic[mallViewPage].lua then
                self.uiDic[mallViewPage].lua = self.Lua_monthly
            end
        end
        if self.NowPageIndex ~= _G.MallViewPage.monthly or self.NowPageIndex ~= _G.MallViewPage.Privilege then
            self:OnClickPage(true, mallViewPage)
            if callback then
                callback()
            end
        end
    end
end

