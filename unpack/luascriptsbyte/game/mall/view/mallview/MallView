---充值
function MallView:LoadRechargeRes(type, callback)
    local page = _G.MallViewPage.recharge
    if type == 2 then
        page = _G.MallViewPage.rechargeDjq
    end
    if not self.Lua_recharge then
        self.Lua_recharge = true
        _G.PoolsManager:GetInstance():Spawn(
                self.resKey.recharge,
                _G.ePoolType.UIItem,
                self.go_table.obj_ViewParent,
                function(tran)
                    if self:IsNil() then
                        return
                    end

                    self.Lua_recharge = self:AddComponent(tran, require("MallView_recharge").New(tran, self))
                    self.Lua_recharge.nowIndex = type
                    if self.uiDic[_G.MallViewPage.recharge] then
                        self.uiDic[_G.MallViewPage.recharge].lua = self.Lua_recharge
                    end
                    if self.uiDic[_G.MallViewPage.rechargeDjq] then
                        self.uiDic[_G.MallViewPage.rechargeDjq].lua = self.Lua_recharge
                    end
                    if not self.NowPageIndex or self.NowPageIndex ~= page then
                        self:OnClickPage(true, page)
                        if callback then
                            callback()
                        end
                    else
                        self.Lua_recharge:Hide()
                    end
                end
        )
    elseif self.Lua_recharge ~= true then
        if not self.NowPageIndex or self.NowPageIndex ~= page then
            self:OnClickPage(true, page)
            self.Lua_recharge.nowIndex = type
            self.Lua_recharge:Show()
            if callback then
                callback()
            end
        end
    end
end

---资源加载
function MallView:AddRest()
    self.resKey = {
        recharge = "UIH5/Mall/MallView_recharge",
        gift = "UIH5/Mall/MallView_gift",
        monthly = AppSetting.IsXzns and "UIH5_xzns/Mall/MallView_monthly" or "UIH5/Mall/MallView_monthly",
        vip = ConfigManager.ui_cfg.VIPPrivilegeView.PrefabPath,
        privilege = "UIH5/Mall/MallView_monthly",
        dress = "UIH5/Mall/MallView_dress",
        giftCertificate = "UIH5_xzns/Mall/MallView_giftCertificate",
    }
    for _, v in pairs(self.uiDic) do
        v.btnGoTable.gameObject:SetActiveE(1)
        if v.page == _G.MallViewPage.dress then
            if not require "DressModel":GetInstance():CheckShowDressBtn() then
                v.btnGoTable.gameObject:SetActiveE(0)
            end
        elseif v.page == _G.MallViewPage.rechargeDjq then
            local list = require("MallManager"):GetInstance():GetMallItemList(5)
            local bool = false
            for i = 1, #list do
                if require("MallCashModel"):GetInstance():GetIsFirstCash(list[i].id) then
                    bool = true
                end
            end
            v.btnGoTable.aorimage_Tips:SetActiveE(bool and 1 or 0)
        end
    end
end

function MallView:OnClickPage(isShow, MallViewPage)
    local nowPage = self.uiDic[MallViewPage]
    self.Page = nowPage.page
    if nowPage == nil then
        --("未定义 ")
        self:Close()
        return
    end
    local pagelua = nowPage.lua
    local SetShow = function()
        self.NowPageIndex = MallViewPage
        if pagelua ~= nil then
            pagelua:Show(MallViewPage)
        end
        self:InitBtns()
    end
    -- 当前空 直接显示
    if self.NowPageIndex == nil then
        if isShow == true then
            if MallViewPage == _G.MallViewPage.vip then
                self.VipOpen = true
                self:VipSet()
            end
            SetShow()
        end
    else
        --如果不等 且显示新的 则显示
        if self.NowPageIndex ~= MallViewPage then
            local oldPageLua = self.uiDic[self.NowPageIndex]
            if isShow == true then
                self:InitBtns()
                if oldPageLua.lua ~= nil then
                    oldPageLua.lua:Hide()
                end
                SetShow()
            else
                return
            end
        end
    end
end

function MallView:CloseView()
    --判断是不是 恶灵入侵界面有没有开启
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.VIPPrivilegeView.Name)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.VIPPrivilegeGiftView.Name)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.HeroGiftPackView.Name)
    if self.callback then
        self.callback()
    end
    self:Close()
end

function MallView:UpdataDefaultView()
    if not self.NowPageIndex then
        return
    end
    local nowPage = self.uiDic[self.NowPageIndex]
    if nowPage == nil then
        --("未定义 ")
        return
    end
    if nowPage.lua then
        nowPage.lua:UpdataView()
    end
end

function MallView:UpdataCurView()
    self:UpdataDefaultView()
end

function MallView:UpdataView(MallViewPage)
    local nowPage = self.uiDic[MallViewPage]
    if nowPage == nil then
        --("未定义 ")
        return
    end
    if nowPage.lua then
        nowPage.lua:UpdataView()
    end
end

function MallView:UpdateCurPageView(MallViewPage)
    if not self.NowPageIndex or self.NowPageIndex ~= MallViewPage then
        return
    end
    self:UpdataView(MallViewPage)
end

---按钮点击事件在这里派发
function MallView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

function MallView:OnClickMonthCard()
    local type = self.go_table.aorbtn_recharge:GetActiveSelf() == 1 and 1 or
            self.go_table.aorbtn_rechargeDjq:GetActiveSelf() == 1 and 2 or 0
    if not type or type == 0 then
        if _G.AppSetting.DEBUG then
            _G.LogError("无效的type参数" .. tostring(type))
        end
        return
    end
    self:LoadRechargeRes(
            type,
            function()
                self.VipOpHeroGiftPacken = false

                self.VipOpen = false
                self:VipSet()
            end
    )
end

