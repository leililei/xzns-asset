---VIP显隐
function MallView:VipSet()
    if self.VipOpen then
        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.VIPPrivilegeView.Name, self.vipLevel)
        self.VipOpen = false
        if self.uiDic[_G.MallViewPage.vip] then
            local tbVip = self.uiDic[_G.MallViewPage.vip].btnGoTable
            tbVip.aorimage_select:SetActiveE(1)
        end
        if self.uiDic[_G.MallViewPage.gift] then
            local tbGift = self.uiDic[_G.MallViewPage.gift].btnGoTable
            tbGift.aorimage_select:SetActiveE(0)
        end
        if self.uiDic[_G.MallViewPage.recharge] then
            local tbRecharge = self.uiDic[_G.MallViewPage.recharge].btnGoTable
            tbRecharge.aorimage_select:SetActiveE(0)
        end
        if self.uiDic[_G.MallViewPage.monthly] then
            local tbMonthly = self.uiDic[_G.MallViewPage.monthly].btnGoTable
            tbMonthly.aorimage_select:SetActiveE(0)
        end
        if self.uiDic[_G.MallViewPage.Privilege] then
            local tbPrivilege = self.uiDic[_G.MallViewPage.Privilege].btnGoTable
            tbPrivilege.aorimage_select:SetActiveE(0)
        end
        if self.uiDic[_G.MallViewPage.dress] then
            local tbDress = self.uiDic[_G.MallViewPage.dress].btnGoTable
            tbDress.aorimage_select:SetActiveE(0)
        end
    else
        -- nowPage.lua:Show()
        -- _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.VIPPrivilegeView.Name)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.VIPPrivilegeGiftView.Name)
        self.VipOpen = true
        if self.uiDic[_G.MallViewPage.vip] then
            local tbVip = self.uiDic[_G.MallViewPage.vip].btnGoTable
            tbVip.aorimage_select:SetActiveE(0)
        end
        local nowPage = self.uiDic[self.Page]
        nowPage.btnGoTable.aorimage_select:SetActiveE(1)
    end
end

function MallView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eMonthCard.MonthCardActive, self.OnClickMonthCard, self)
end

function MallView:InitBtns()
    for _, v in pairs(self.uiDic) do
        self:SetBtns(v.btnGoTable, v.page)
    end
    if AppSetting.IsXzns then
        if self.NowPageIndex and self.NowPageIndex == _G.MallViewPage.chipGift then
            self.go_table.trans_BottomPanel:SetRectTransformSize(36, 218)
        else
            self.go_table.trans_BottomPanel:SetRectTransformSize(36, 125)
        end
    else
        if self.NowPageIndex and self.NowPageIndex == _G.MallViewPage.chipGift then
            self.go_table.trans_BottomPanel:SetRectTransformSize(18, 218)
        else
            self.go_table.trans_BottomPanel:SetRectTransformSize(18, 125)
        end
    end
end

function MallView:SetBtns(btn_goTable, i)
    local isOn = 0
    if self.NowPageIndex == nil then
        isOn = i == 1 and 1 or 0
    else
        isOn = self.NowPageIndex == i and 1 or 0
    end
    if btn_goTable.obj_select then
        btn_goTable.obj_select:SetActiveE(isOn)
    elseif btn_goTable.aorimage_select then
        btn_goTable.aorimage_select:SetActiveE(isOn)
    end
end

