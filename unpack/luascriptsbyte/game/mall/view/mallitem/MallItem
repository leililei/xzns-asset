---@class  Mallltem : Component 中文描述
local Mallltem = _G.BaseClass("Mallltem", _G.Component)
function Mallltem:Awake()
    --_G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

local StateIcon = {
    "ui_sc__frame_tuijian",
    "ui_sc__frame_rexiao",
    "ui_sc__frame_xin"
}
local MallItemBg = {
    "ui_sc_frame_xuanxiangka1",
    "ui_sc_frame_xuanxiangka2",
    "ui_sc_frame_xuanxiangka1",
    "ui_sc_frame_xuanxiangka3"
}
local btnBg = {
    "ui_sc_btn_1",
    "ui_sc_btn_1",
    "ui_sc_btn_1",
    "ui_sc_btn_2"
}
local GoTableType = {
    "obj_recharge",
    "obj_gift",
    "obj_token",
    "obj_monthly"
}
---@param type number 1充值 2礼包 3杂货 4月卡
---@param parent UnityEngine.GameObject 父物体
---不传则不显示 不传则不显示 不传则不显示 不传则不显示 不传则不显示
---data.items table {sid,count} item展示 礼包使用
---data.sid number  item展示
---data.id number  配置id
---data.icon string 图片路径 充值礼包月卡使用
---data.count number item个数
---data.price_id number item消耗货币档位id
---data.moneyIcon string item消耗货币资源
---data.moneyType number 货币类型
---data.name string item名字
---data.cashTag table{} 双倍和赠送获得 赠送索引2为赠送数量
---data.discount string 折扣
---data.saleState number  1推荐2热销3新
---data.mask string 显示tips 例如 购买月卡获得
---data.limitType 限购类型
---data.limit string 限购text
---data.sellout bool 售罄
---@param data table
function Mallltem:__init(type, data, parent, clickCall)
    self.ItemPath = "UI/Mall/$_obj_MallItemNew"
    self.type = type
    self.data = data
    self.clickCall = clickCall
    if parent then
        self.parent = parent
        self:ShowData()
    end
end

function Mallltem:ClickCall(a, b, c)
    if self.ClickLimit then
        return
    end
    self.clickCall(a)
end

function Mallltem:Show(type, data, tran, clickCall, notAnim, isShowGrade)
    self.type = type
    self.data = data
    self.clickCall = clickCall
    self.isShowGrade = isShowGrade
    self:OnItemCardCall(tran, notAnim)
end

local CreateItem = function(items, parent, isGou, isShowGrade)
    local tb = _G.GetAutoGoTable(parent)
    local type
    local cfg
    local sid
    local count
    local root
    local large = false
    if #items == 1 then
        large = true
    end
    for i = 1, 4 do
        root = tb["obj_root" .. i]
        if items[i] then
            if large then
                tb["obj_Root" .. i]:SetLocalScaleXYZ(1)
            else
                tb["obj_Root" .. i]:SetLocalScaleXYZ(0.8)
            end
            _G.GameUtil.SetActiveByCondition(parent:GetChildE(i - 1).gameObject, true)
            _G.GameUtil.SetActiveByCondition(tb["obj_gou" .. i], isGou)
            sid = items[i][1]
            count = items[i][2]
            type = _G.StorageManager:GetInstance():CheckSidType(sid)
            cfg = _G.ConfigManager.item_cfg[sid]
            if
                type == _G.StorageType.Prop and cfg and cfg.Type1 and cfg.Type1 == 6 and
                _G.ConfigManager.card_cfg[_G.tonumber(cfg.UseParameter[1][2])]
            then
                _G.ItemFactory:GetInstance():GetItemCard(
                    _G.ItemFactory.itemType.ItemDebrisBase,
                    root,
                    function(trans)
                        if not cfg then
                            _G.DestroyObject(trans.go_table.gameObject)
                            return
                        end
                        trans:Show(sid, nil, count)
                        if trans.SetGradeNew then
                            trans:SetGradeNew(not isShowGrade)
                        end
                    end
                )
            else
                _G.StorageManager:GetInstance():GetItemBaseViewNew(
                    items[i],
                    root,
                    function(trans)
                        --trans.sid = sid
                        trans.gameObject:SetLocalPosition(0, 0, 0)
                        if items[i][2] and items[i][2] > 1 then
                            trans:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                        end
                        if trans.SetGradeNew then
                            trans:SetGradeNew(not isShowGrade)
                        end
                    end
                -- function(go)
                --     require("CommonTipManager"):GetInstance():OpenTip(parent, go.sid or go[1].sid)
                -- end
                )
            end
        else
            _G.GameUtil.SetActiveByCondition(parent:GetChildE(i - 1).gameObject, false)
        end
    end
end
function Mallltem:OnItemCardCall(tran, notAnim)
    self.ClickLimit = true
    if self.ClickLimitCo then
        _G.coroutine.stopwaiting(self.ClickLimitCo)
        self.ClickLimitCo = nil
    end
    self.ClickLimitCo = _G.DelayDo(
        1,
        function()
            self.ClickLimit = false
        end
    )
    local item = _G.GetAutoGoTable(tran)
    --UIUtils.IsNeedChangeUI(IsNeedChangeUI.Mallltem,item)
    _G.GameUtil.SetActiveByCondition(tran, self.data)
    --item.aorimage_bg:GetComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup)).alpha = notAnim and 1 or 0
    if not self.data then
        return
    end
    if self.data.items then
        item.items = self.data.items
    else
        item.items = { { self.data.sid, self.data.count } }
    end
    item.aortext_ItemName.text = self.data.name
    --item.aorimage_bg.SpriteName = MallItemBg[self.type]
    --item.aorimage_bg:SetNativeSize()
    --item.aorimage_btnBg.SpriteName = btnBg[self.type]
    --item.aorimage_btnBg:SetNativeSize()
    ---直充表比较特别走的是表本身，代金券是走的通用档位表，这里判断一下档位id是不是为0
    local finalPriceId = 0
    local finalPrice = 0
    if self.data.price_id and self.data.price then
        if self.data.price_id > 0 then
            local gearCfg = _G.ConfigManager.store_gear_cfg[self.data.price_id]
            finalPrice = gearCfg.price / 100
            finalPriceId = self.data.price_id
        else
            finalPrice = self.data.price
            finalPriceId = self.data.price
        end
    else
        if self.data.price_id > 0 then
            local gearCfg = _G.ConfigManager.store_gear_cfg[self.data.price_id]
            finalPrice = gearCfg.price
            finalPriceId = self.data.price_id
        end
    end

    local dataInfo = _G.LoginManager:GetInstance():GetGooglePayInfoByPrice(finalPriceId)

    local curPrice = _G.GameUtil.RatioControl(finalPrice)
    local isVoucherPage = self.type == 1 and self.data.type1 == 2
    if isVoucherPage  then
        if not _G.GameUtil.CheckVoucherModel() then
            _G.GameUtil.AddDouYinIcon(item.aorimage_btnBg, true, item.aortext_MaterialNum, nil, nil, finalPrice)
        end
    else
        _G.GameUtil.AddDouYinIcon(item.aorimage_btnBg, true, item.aortext_MaterialNum, nil, nil, finalPrice)
    end
    if finalPrice == 0 and not self.data.mask then
        item.aortext_MaterialNum.text = _G.LangUtil.GetLangPackValue(90023900001)
    elseif self.data.moneyType and not _G.StorageManager:GetInstance():CheckItem(self.data.moneyType, finalPrice) then
        item.aortext_MaterialNum.text = dataInfo and dataInfo.formattedPrice or _G.GameUtil.NumberToUnitStr(finalPrice)
    elseif self.type == 3 then
        item.aortext_MaterialNum.text = dataInfo and dataInfo.formattedPrice or _G.GameUtil.NumberToUnitStr(finalPrice)
    elseif self.type == 4 then
        if self.data.mask then
            item.aortext_MaterialNum.text = self.data.mask
        else
            if self.data.moneyIcon then
                item.aortext_MaterialNum.text = dataInfo and dataInfo.formattedPrice or finalPrice
            else
                _G.GameUtil.SetPriceByChannel(finalPriceId, item.aortext_MaterialNum)
            end
        end
    elseif self.type == 1 then
        if self.data.moneyIcon then
            item.aortext_MaterialNum.text = dataInfo and dataInfo.formattedPrice or finalPrice
        else
            if _G.CS.Launcher.Inst.IsSDK then
                if self.data.formattedPrice then
                    item.aortext_MaterialNum.text = self.data.formattedPrice
                else
                    if isVoucherPage then
                        local isVoucher = _G.GameUtil.CheckVoucherModel()
                        if self.data.type1 == 2 and isVoucher then
                            if not self.channelId then
                                self.channelId = _G.tonumber(_G.SDKManager:GetInstance():GetChannelId()) or 0
                            end
                            if self.channelId == 13396 then
                                ---繁体官网包特殊处理显示价格
                                item.aortext_MaterialNum.text = _G.LangUtil.GetLangPackValue(90036300047) ..
                                    _G.GameUtil.RatioControl(self.data.price * 100)
                            elseif self.data["local"] then
                                ---只改代金券界面的价格显示,local: json对象，渠道SDK返回的谷歌后台或苹果后台的商品数据
                                local _sData = self.data["local"]
                                if _sData and _sData.price then
                                    item.aortext_MaterialNum.text = _sData.price
                                else
                                    item.aortext_MaterialNum.text = _G.LangUtil.GetLangPackValue(90000010807) ..
                                        _G.GameUtil.RatioControl(self.data.price * 100)
                                end
                            elseif _G.ConfigManager.function_block_cfg[self.channelId] then
                                local blockCfg  = _G.ConfigManager.function_block_cfg[self.channelId]
                                local langId = 90000010807
                                if blockCfg and  blockCfg.CurrencyDisplay then
                                    langId = blockCfg.CurrencyDisplay
                                end
                                item.aortext_MaterialNum.text = _G.LangUtil.GetLangPackValue(langId) ..
                                        _G.GameUtil.RatioControl(self.data.price * 100)
                            else
                                item.aortext_MaterialNum.text = _G.LangUtil.GetLangPackValue(90000010807) ..
                                    _G.GameUtil.RatioControl(self.data.price * 100)
                            end
                        else
                            if _G.GameUtil.IsNotPlatformSpecial() then
                                if _G.AppSetting.IsOverseas then
                                    item.aortext_MaterialNum.text = _G.LangUtil.GetLangPackValue(90000010807) ..
                                        _G.GameUtil.RatioControl(finalPrice * 100)
                                else
                                    item.aortext_MaterialNum.text = _G.LangUtil.GetLangPackValue(90000010819,
                                        _G.GameUtil.RatioControl(finalPrice * 100))
                                end
                            else
                                item.aortext_MaterialNum.text = _G.GameUtil.PlatformPrice(finalPrice * 100)
                            end
                        end
                    else
                        _G.GameUtil.SetPriceByChannel(self.data.id, item.aortext_MaterialNum, nil, nil, true)
                    end
                end
            else
                _G.GameUtil.SetPriceByChannel(self.data.id, item.aortext_MaterialNum, nil, nil, true)
            end
        end
    else
        if self.data.moneyIcon then
            item.aortext_MaterialNum.text = finalPrice
        else
            _G.GameUtil.SetPriceByChannel(finalPriceId, item.aortext_MaterialNum)
        end
    end
    if self.data.moneyIcon and finalPrice > 0 and not self.data.mask then
        item.aortext_MaterialNum:SetLocalPosition(15, 1, 0)
    else
        item.aortext_MaterialNum:SetLocalPosition(-4, 1, 0)
    end
    _G.GameUtil.SetActiveByCondition(
        item.aorrawimage_Material,
        self.data.moneyIcon and finalPrice > 0 and not self.data.mask
    )
    if self.data.moneyIcon then
        item.aorrawimage_Material.Alpha = 0
        item.aorrawimage_Material:LoadImage(self.data.moneyIcon)
    end
    _G.GameUtil.SetActiveByCondition(
        item.aortext_IconNum,
        self.data.count and self.data.count > 1 and (self.type == 1 or self.type == 4)
    )
    _G.GameUtil.SetActiveByCondition(item.aorimage_MonthIcon, self.data.icon and self.type == 4)
    _G.GameUtil.SetActiveByCondition(item.aorimage_Icon, self.data.icon and self.type == 1)
    if self.type == 1 then
        if self.data.icon then
            local icon
            if item.aorimage_IconLang then
                item.aorimage_Icon:SetActiveE(self.data.type1 == 2 and 0 or 1)
                item.aorimage_IconLang:SetActiveE(self.data.type1 == 2 and 1 or 0)
                icon = self.data.type1 == 2 and item.aorimage_IconLang or item.aorimage_Icon
            else
                icon = item.aorimage_Icon
            end
            icon.Alpha = 0
            icon.SpriteName = self.data.icon
            icon.Alpha = 1
            icon:SetNativeSize()
            if self.data.type1 == 2 then
                icon:SetLocalScaleXYZ(1)
            end
        end
        item.aortext_IconNum.text = self.data.count
    elseif self.type == 4 then
        if self.data.icon then
            item.aorrawimage_Icon:LoadImage(self.data.icon)
        end
        item.aortext_IconNum.text = self.data.count
    else
        local root = _G.GetAutoGoTable(item.obj_Root)
        for i = 1, 4 do
            for j = 1, root["obj_root" .. i]:GetChildCountE() do
                _G.PoolsManager:GetInstance():Despawn(root["obj_root" .. i]:GetChildE(0), _G.ePoolType.UIItem)
            end
        end
        CreateItem(item.items, item.obj_Root, self.data.sellout, self.isShowGrade)
    end
    item.aorimage_btnBg:SetActiveE(self.data.sellout and 0 or 1)
    _G.GameUtil.SetActiveByCondition(item.obj_SellOut, self.data.sellout)
    _G.GameUtil.SetActiveByCondition(item.aorimage_monthMask, self.data.sellout and self.type == 4)
    if self.data.sellout then
        if self.type == 3 or self.type == 2 or self.type == 4 then
            item.aorimage_mask.Alpha = 0
        else
            item.aorimage_mask.Alpha = 1
        end
    end
    _G.GameUtil.SetActiveByCondition(item.aortext_MaterialNum, not self.data.sellout)
    local tb = _G.GetAutoGoTable(item[GoTableType[self.type]], _G.handler(self, self.ClickCall))
    tb.aorbtn_Btn:SetActiveE(self.data.sellout and 0 or 1)
    _G.GameUtil.SetActiveByCondition(item.obj_token, self.type == 3)
    _G.GameUtil.SetActiveByCondition(item.obj_recharge, self.type == 1)
    _G.GameUtil.SetActiveByCondition(item.obj_gift, self.type == 2)
    _G.GameUtil.SetActiveByCondition(item.obj_monthly, self.type == 4)
    if tb.obj_giveaway then
        _G.GameUtil.SetActiveByCondition(
            tb.obj_giveaway,
            not _G.table.isEmptyOrNil(self.data.cashTag) and not self.data.sellout and self.type == 1
        )
    end
    if tb.aorimage_Limit then
        _G.GameUtil.SetActiveByCondition(tb.aorimage_Limit, not self.data.sellout)
        if not self.data.sellout then
            tb.aortext_limit.text = self.data.limit
        end
    end
    if tb.obj_tagS and tb.aorimage_tagH then
        local uiModel = _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.ui_model_1)
        tb.obj_tagS:SetActiveE(uiModel and 0 or 1)
        tb.aorimage_tagH:SetActiveE(uiModel and 1 or 0)
    end
    if self.type == 1 then
        UIUtils.IsNeedChangeUI(IsNeedChangeUI.MallListItemsRecharge, tb)
        if not _G.table.isEmptyOrNil(self.data.cashTag) then
            _G.GameUtil.SetActiveByCondition(tb.obj_giveaway, self.data.cashTag[2])
            _G.GameUtil.SetActiveByCondition(tb.aorimage_double, self.data.cashTag[3])
            local isUseChinese = _G.GameUtil.GetIsUseChinese()
            if not isUseChinese and tb.aortext_double then
                tb.aortext_double.text = "2X"
            end
            if self.data.cashTag and #self.data.cashTag > 1 then
                if self.data.cashTag[2] == 0 then
                    tb.obj_giveaway:SetActiveE(0)
                end
                tb.aortext_BaiFenBi.text = "+" .. self.data.cashTag[2]
                if _G.AppSetting.IsXzns then
                    tb.aortext_BaiFenBi.color = _G.ColorTools.FormatColorByString("FFFAF1")
                    if isVoucherPage and not  self.data.cashTag[3] then
                        tb.aortext_des.text = _G.LangUtil.GetLangPackValue(90000012061)
                    end
                end
            end
        end
    elseif self.type == 2 then
        tb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.StoreActive.id, self.data.id)
        _G.GameUtil.SetActiveByCondition(tb.obj_discount, self.data.discount and not self.data.sellout)
        if self.data.discount then
            tb.aortext_discount.text = self.data.discount
        end
        _G.GameUtil.SetActiveByCondition(
            tb.aorimage_statusSale,
            (self.data.saleState and self.data.saleState > 0) and not self.data.sellout
        )
        if self.data.saleState then
            if self.data.saleState > 0 then
                tb.aorimage_statusSale.SpriteName = StateIcon[self.data.saleState]
            end
        end
    elseif self.type == 3 then
        _G.GameUtil.SetActiveByCondition(
            tb.aorimage_discount,
            self.data.discount and self.data.discount > 0 and not self.data.sellout
        )
        if self.data.discount then
            tb.aortext_discount.text = _G.LangUtil.GetLangPackValue(90021600041, math.floor(self.data.discount))
        end
    elseif self.type == 4 then
        _G.GameUtil.SetActiveByCondition(
            tb.aorimage_statusSale,
            (self.data.saleState and self.data.saleState > 0) and not self.data.sellout
        )
        if self.data.saleState then
            if self.data.saleState > 0 then
                tb.aorimage_statusSale.SpriteName = StateIcon[self.data.saleState]
            end
        end
    end
end

function Mallltem:ShowData()
    for i = 1, self.parent:GetChildCountE() do
        _G.PoolsManager:GetInstance():Despawn(self.parent:GetChildE(0), _G.ePoolType.UIItem)
    end
    _G.PoolsManager:GetInstance():Spawn(
        self.ItemPath,
        _G.ePoolType.UIItem,
        self.parent,
        function(tran)
            self:OnItemCardCall(tran)
        end
    )
end

---销毁对象时,析构函数
function Mallltem:OnDestroy()
end

return Mallltem
