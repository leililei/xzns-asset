local base = require "BaseGameNet"

---@class FriendsHelpNet : BaseGameNet	通信协议
local FriendsHelpNet = _G.BaseClass("FriendsHelpNet", base)

---@return FriendsHelpNet FriendsHelpNet
function FriendsHelpNet:GetInstance()
    return self.super.super.GetInstance(self)
end

function FriendsHelpNet:AddMessageListeners()
    self:AddMessageListener(_G.ConfigManager.net_map.assist_agree.Cmd, self.P2CAgreeBorrow)
    self:AddMessageListener(_G.ConfigManager.net_map.assist_resort.Cmd, self.P2CResort)
end

---请求助战信息
---@param callback fun(param:assist.s2c_assist_info) 完成回调
function FriendsHelpNet:GetInfo(callback)
    local item = _G.ConfigManager.net_map.game_assist_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---获取助战卡牌信息
---@param pbData assist.c2s_assist_resort_cards
---@param callback fun(param:assist.s2c_assist_resort)
function FriendsHelpNet:GetHelpCardInfo(pbData, callback)
    local item = _G.ConfigManager.net_map.game_assist_resort_cards
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

