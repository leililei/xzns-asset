---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function FriendsHelpNet:CallBack(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end
---同意借出卡牌
---@param msg assist.p2c_assist_agree
function FriendsHelpNet:P2CAgreeBorrow(msg)
    require "FriendHelpModel":GetInstance():P2CAgreeBorrow(msg)
end

