local base = require "BaseGameNet"
local FriendManager = require "FriendManager"

---@class FriendsNet : BaseGameNet	通信协议
local FriendsNet = _G.BaseClass("FriendsNet", base)

---查询玩家请求
---@param pbData table PB数据
---@param callback function 完成回调
function FriendsNet:SeekPlayerAccess(pbData, callback)
    local item = _G.ConfigManager.net_map.game_friend_port_select_friend
    local port = base.Access(self, item, pbData, _G.handler(self, self.AccessCall))
    self.Call[port] = callback
end

