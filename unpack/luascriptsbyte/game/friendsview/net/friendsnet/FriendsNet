---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function FriendsNet:AccessCall(port, data, error)
    if error then
        return
    end

    if _G.AppSetting.DEBUG then
        _G.Log(data.ack)
    end
    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---添加所有后端主动推的网络消息监听接口
function FriendsNet:AddMessageListeners()
    self:AddMessageListener(_G.ConfigManager.net_map.friend.Cmd, self.P2C_Friendinfo)
    self:AddMessageListener(_G.ConfigManager.net_map.delete_friend.Cmd, self.P2C_DelFriend)
end

local S2CType = {
    --获取到友情点
    Friendship = 1,
    --对方同意好友申请
    tongYi = 2,
    --接收到好友申请
    Apply = 3
}

---后端主动推送的聊天数据
function FriendsNet:P2C_Friendinfo(data)
    if _G.IsNil(data) then
        return
    end
    if data.type == S2CType.Friendship then
        FriendManager:GetInstance():S2C_Friendship(data.f_uid)
    elseif data.type == S2CType.Apply then
        FriendManager:GetInstance():S2C_Apply(data)
    elseif data.type == S2CType.tongYi then
        FriendManager:GetInstance():S2C_tongYi(data)

    -- _G.Events:GetInstance():Broadcast(
    --     _G.ePlayAactionEvent.PlayAaction,
    --     {_G.ActiveTaskEnum.ConditionEnum.Friends.count},
    --     1
    -- )
    end
end

function FriendsNet:P2C_DelFriend(data)
    if _G.table.isEmptyOrNil(data) then
        return
    end
    FriendManager:GetInstance():DelFriendSuc({result = {ack = 1, f_uid = data.role_uid}},nil,true)
end

---@type FriendsNet

return FriendsNet
