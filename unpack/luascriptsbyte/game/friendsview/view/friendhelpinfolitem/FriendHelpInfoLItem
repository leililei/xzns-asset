---@class FriendHelpInfoLItem	FriendHelpInfoView_HelpPanel 刷新物体
---@field go_table _obj_LendInfo._obj_item2_GoTable
---@field data HelpSingleData 申请数据
---@field cardItem ItemCardAllView 卡牌
local FriendHelpInfoLItem = _G.BaseClass("FriendHelpInfoLItem")
---类的构造函数
function FriendHelpInfoLItem:__init(go, call)
    self.gameObject = go
    self.go_table = _G.GetAutoGoTable(go, _G.handler(self, self.OnClickBtn))
    self.call = call
end
---更新显示
function FriendHelpInfoLItem:Show(data, index)
    self.data = data
    self.index = index
    self.go_table.aortext_name.text = self.data.browRole.name
    if not self.cardItem then
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.CardAllItem,
            self.go_table.obj_Root,
            function(item)
                self.cardItem = item
                self.cardItem:ShowCardData(self.data.cardData)
            end
        )
    else
        self.cardItem:ShowCardData(self.data.cardData)
    end
end
---点击事件
function FriendHelpInfoLItem:OnClickBtn(go, isOn)
end
---类的析构函数
function FriendHelpInfoLItem:Dispose()
end

return FriendHelpInfoLItem
