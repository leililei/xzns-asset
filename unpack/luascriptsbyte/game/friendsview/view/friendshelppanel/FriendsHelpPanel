---@class FriendsHelpPanel : Component	中文描述
---@field go_table FriendsView._obj_FriendHelp_GoTable
---@field Elements _obj_FriendHelp._obj_Elements_GoTable
---@field ItemList FriendsHelpPanelCardItem[]
---@field helpDatas table<number,HelpSingleData[]> 所有强援卡牌
---@field helpData HelpSingleData[] 当前显示的强援卡牌
---@field topCards _obj_FriendHelp._obj_card1_GoTable[] 借入卡牌
---@field borrowDatas HelpSingleData[] 借入卡牌数据
---@field dataInItem table<number,FriendsHelpPanelCardItem>
local FriendsHelpPanel = _G.BaseClass("FriendsHelpPanel", _G.Component)
local FriendsHelpPanelCardItem = require "FriendsHelpPanelCardItem"
function FriendsHelpPanel:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建对象时,入口构造函数
function FriendsHelpPanel:OnCreate()
    self.ItemList = {}
    self.dataInItem = {}
    self.go_table.scrollloophorizontal_cardList:InitItemData(0, _G.handler(self, self.RefreshItem))
    self.Elements = _G.GetAutoGoTable(self.go_table.obj_Elements, _G.handler(self, self.OnClickBtn))
    self:UpdatePanel()
    self:AddListener(_G.eFriendHelp.AgreeBorrow, self.AgreeBorrowCall)
    self:AddListener(_G.eFriendHelp.TimeOver, self.UpdatePanel)
    self:AddListener(_G.eFriendHelp.BorrowCard, self.UpdateItemState)
    self:AddListener(_G.eFriendHelp.ReturnCard, self.UpdateSingleCard)
    self:AddListener(_G.eFriendHelp.UnPutCard, self.UnPutCard)
    self:InitEffect()
    local cardDatas = require "FriendHelpModel":GetInstance():GetCanSetCardDatas()
    self.go_table.aorbtn_help:SetActiveE(#cardDatas > 0 and 1 or 0)
end

---初始化界面
function FriendsHelpPanel:InitView()
    self.helpDatas = {}
    self.helpDatas[_G.CardElementType.None] = self:GetHelpDatas()
    self.Elements.toggle_0.isOn = false
    self.Elements.toggle_0.isOn = true
end

function FriendsHelpPanel:InitEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_xuanzhong_effect_loop,
        self.Elements.obj_select,
        function(obj)
            if _G.IsNil(self.gameObject) then
                _G.DestroyObject(obj)
            end
        end
    )
end

---更新顶部卡牌
function FriendsHelpPanel:UpdateTopCards()
    if not self.topCards then
        self.topCards = {}
    end
    for i = 1, 3 do
        if not self.topCards[i] then
            self.topCards[i] =
                _G.GetAutoGoTable(self.go_table["obj_card" .. i], _G.handlerbind(self, self.OnClickTopCard, i))
        end

        self:UpdateSingleCard(i)
    end
end
---其他玩家同意借出回调
function FriendsHelpPanel:AgreeBorrowCall(index)
    self:UpdateSingleCard(index)
    self:UpdateItemState(self.borrowDatas[index])
end
---更新卡牌状态
function FriendsHelpPanel:UpdateItemState(data)
    local item = self.dataInItem[data.cardData.sid]
    if item then
        item:UpdateShow()
    end
end

---更新单个卡牌
function FriendsHelpPanel:UpdateSingleCard(index)
    local tb = self.topCards[index]
    local data = self.borrowDatas[index]
    if _G.IsNil(data) then
        tb.obj_root:SetActiveE(0)
        tb.obj_Empty:SetActiveE(1)
    else
        tb.obj_root:SetActiveE(1)
        tb.obj_Empty:SetActiveE(0)
        if _G.IsNil(tb.card) then
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.baseBodyItem,
                tb.obj_root,
                function(item)
                    if _G.IsNil(self.gameObject) then
                        _G.DestroyObject(item.go_table.gameObject)
                        return
                    end
                    tb.card = item
                    data.cardData.skinIs = false
                    tb.card:ShowCardData(data.cardData, _G.handlerbind(self, self.OnClickTopCard, index))
                end
            )
        else
            data.cardData.skinIs = false

            tb.card:ShowCardData(data.cardData, _G.handlerbind(self, self.OnClickTopCard, index))
        end
        tb.aortext_name.text = data.lendRole.name
    end
end

---点击借入卡牌
---@param index number 下标
function FriendsHelpPanel:OnClickTopCard(_, index)
    local data = self.borrowDatas[index]
    if data then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CommonIllustrationsH5View.Name,
            data.cardData.sid,
            nil,
            true,
            data.cardData,
            function(call)
                _G.PopWindowManager:GetInstance():ShowAllTips(
                    100316,
                    nil,
                    function()
                        require "FriendHelpModel":GetInstance():ApplyHelpCard(
                            data,
                            3,
                            function()
                                _G.PopWindowManager:GetInstance():ShowAllTips(100319)
                                if call then
                                    call()
                                end
                            end
                        )
                    end
                )
            end,
            nil,
            nil,
            nil,
            {"qh", "hl"}
        )
    end
end
---获取强援卡牌
---@return HelpSingleData[]
function FriendsHelpPanel:GetHelpDatas()
    local data = require "FriendHelpModel":GetInstance().HelpDatas
    ---@type HelpSingleData[]
    local tb = {}
    for _, v in pairs(data) do
        if not tb[v.cardData.sid] then
            tb[v.cardData.sid] = v
        elseif tb[v.cardData.sid].cardData.star < v.cardData.star then
            tb[v.cardData.sid] = v
        end
    end
    tb = _G.table.toArray(tb)
    self:SortHelpData(tb)
    return tb
end

---初始化Timer
function FriendsHelpPanel:InitTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    local endTime = require "FriendHelpModel":GetInstance():GetEndTime()
    self.RTS = endTime - _G.TimeUtil.GetServerUnixTime()
    self:UpdateTime(true)
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true,false)
    self.timer:Start()
end

---刷新卡牌
---@param index number 下标
---@param obj UnityEngine.GameObject
function FriendsHelpPanel:RefreshItem(index, obj)
    local id = obj:GetInstanceIDE()
    local item = self.ItemList[id]
    if not item then
        item = FriendsHelpPanelCardItem.New(obj)
        self.ItemList[id] = item
    end
    self.dataInItem[self.helpData[index + 1].cardData.sid] = item
    item:Show(self.helpData[index + 1], index)
end
---处理信息回调
function FriendsHelpPanel:OnClickCardItem()
end

---销毁对象时,析构函数
function FriendsHelpPanel:OnDestroy()
end
---更新归还时间
function FriendsHelpPanel:UpdateTime(isNotChange,elapsed)
    if _G.IsNil(isNotChange) then
        self.RTS = self.RTS -elapsed
    end
    self.go_table.aortext_time.text =
        _G.LangUtil.GetLangPackValue(90022500853, "<color=#14874a>" .. self:TimeToStr() .. "</color>")
end

function FriendsHelpPanel:TimeToStr()
    return require "FriendHelpModel":GetInstance():TimeToStr(Mathf.RoundToInt(self.RTS))
end

---更改元素
---@param type CardElementType 卡牌五行
function FriendsHelpPanel:ChangeElements(type, go)
    if not self.helpDatas[type] then
        ---@param v HelpSingleData
        self.helpDatas[type] =
            _G.table.chooseToArray(
            self.helpDatas[_G.CardElementType.None],
            function(_, v)
                return v.cardData:GetElement() == type
            end
        )
        self:SortHelpData(self.helpDatas[type])
    end
    self.element = type
    self.helpData = self.helpDatas[type]
    self.go_table.scrollloophorizontal_cardList:UpdateCount(#self.helpData)
    self.go_table.obj_Nil:SetActiveE(#self.helpData <= 0 and 1 or 0)
    self.Elements.obj_select:SetPositionByTarget(go)
end
---数据排序
---@param data HelpSingleData[]
function FriendsHelpPanel:SortHelpData(data)
    ---@param a HelpSingleData
    _G.SortList(
        data,
        function(a)
            return a.cardData.star, a.cardData.Grade, a.cardData:GetRealLevel(), a.cardData.sid, a.cardData.uid
        end
    )
end
---更新界面
function FriendsHelpPanel:UpdatePanel()
    self.borrowDatas = require "FriendHelpModel":GetInstance():GetBorrowDatas()
    self:InitTimer()
    self:UpdateTopCards()
    require "FriendHelpModel":GetInstance():GetHelpCardDatas(
        function()
            self:InitView()
        end,
        1
    )
end
---下架卡牌
---@param msg assist.p2c_assist_agree
function FriendsHelpPanel:UnPutCard(msg)
    local data = self.helpDatas[_G.CardElementType.None]
    local isHave = false
    local element = _G.CardElementType.Thunder
    for k, v in pairs(data) do
        if v.cardData.uid == msg.card_uid and v.lendRole.uid == msg.role_uid then
            _G.table.remove(data, k)
            element = v.cardData:GetElement()
            isHave = true
            break
        end
    end
    if not isHave then
        return
    end
    self.helpDatas = {}
    self.helpDatas[_G.CardElementType.None] = self:GetHelpDatas()
    if self.element == element or self.element == _G.CardElementType.None then
        self:ChangeElements(self.element)
    end
end
---点击书简
function FriendsHelpPanel:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_manager then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FriendHelpInfoView.Name)
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FriendHelpView.Name)
    elseif go == self.go_table.aorbtn_way then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 48)
    elseif go == self.Elements.toggle_0 then
        if not isOn then
            return
        end
        self:ChangeElements(_G.CardElementType.None, go)
    elseif go == self.Elements.toggle_1 then
        if not isOn then
            return
        end
        self:ChangeElements(_G.CardElementType.Thunder, go)
    elseif go == self.Elements.toggle_2 then
        if not isOn then
            return
        end
        self:ChangeElements(_G.CardElementType.Wind, go)
    elseif go == self.Elements.toggle_3 then
        if not isOn then
            return
        end
        self:ChangeElements(_G.CardElementType.Water, go)
    elseif go == self.Elements.toggle_4 then
        if not isOn then
            return
        end
        self:ChangeElements(_G.CardElementType.Fire, go)
    elseif go == self.Elements.toggle_5 then
        if not isOn then
            return
        end
        self:ChangeElements(_G.CardElementType.Earth, go)
    elseif go == self.Elements.toggle_6 then
        if not isOn then
            return
        end
        self:ChangeElements(_G.CardElementType.God, go)
    end
end

function FriendsHelpPanel:OnDestroy()
    if self.timer then
        self.timer:Stop()
    end
    require "FriendHelpModel":GetInstance():RemoveHelpDatas()
end

return FriendsHelpPanel
