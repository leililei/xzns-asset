---@class FriendHelpApplyView_Item	中文描述
---@field go_table FriendHelpApplyView._obj_item_GoTable
---@field data HelpSingleData 申请数据
---@field item ItemCardAllView 卡牌
local FriendHelpApplyView_Item = _G.BaseClass("FriendHelpApplyView_Item")
---类的构造函数
function FriendHelpApplyView_Item:__init(obj, call)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.playerUid = _G.PlayerModel:GetInstance():GetPlayerUid()
    self.call = call
end
---显示
function FriendHelpApplyView_Item:Show(data)
    self.data = data
    if not self.item then
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.CardAllItem,
            self.go_table.obj_Root,
            function(item)
                if _G.IsNil(self.gameObject) then
                    _G.DestroyObject(item.go_table.gameObject)
                    return
                end
                self.item = item
                self.item:ShowCardData(self.data.cardData)
            end
        )
    else
        self.item:ShowCardData(self.data.cardData)
    end
    self.go_table.aortext_name.text = self.data.lendRole.name
    self.go_table.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(self.data.cardData.power)
    self.go_table.aortext_num.text = self.data.msg.apply_num
    self:ShowBtn()
end

function FriendHelpApplyView_Item:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_apply then
        self:OnApply()
    elseif go == self.go_table.aorbtn_cancel then
        self:OnCancel()
    end
end
---申请
function FriendHelpApplyView_Item:OnApply()
    require "FriendHelpModel":GetInstance():ApplyHelpCard(
        self.data,
        1,
        function()
            --self.data:AddResort({uid = _G.PlayerModel:GetInstance():GetPlayerUid()})
            self.data.msg.apply_num = self.data.msg.apply_num + 1
            self.go_table.aortext_num.text = self.data.msg.apply_num
            self:ShowBtn()
            _G.PopWindowManager:GetInstance():ShowAllTips(100309)
            if self.call then
                self.call()
            end
        end
    )
end

---取消申请
function FriendHelpApplyView_Item:OnCancel()
    _G.PopWindowManager:GetInstance():ShowAllTips(
        100307,
        nil,
        function()
            require "FriendHelpModel":GetInstance():ApplyHelpCard(
                self.data,
                2,
                function()
                    self.data.msg.apply_num = self.data.msg.apply_num - 1
                    self.go_table.aortext_num.text = self.data.msg.apply_num
                    self:ShowBtn()
                    if self.call then
                        self.call()
                    end
                end
            )
        end
    )
end

function FriendHelpApplyView_Item:ShowBtn()
    local isLend = not _G.table.isEmptyOrNil(self.data.browRole)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_unApply, not isLend)
    _G.GameUtil.SetActiveByCondition(self.go_table.aortext_apply, isLend)
    if isLend then
        if self.data.browRole.uid == self.playerUid then
            self.data.browRole.name = _G.PlayerModel:GetInstance():GetName()
        end
        self.go_table.aortext_apply.text =
            _G.LangUtil.GetLangPackValue(90022500836, "<color=#3d57aa>" .. self.data.browRole.name .. "</color>")
    else
        local isApply = require "FriendHelpModel":GetInstance():CheckIsApply(self.data.cardData.uid)
        self.go_table.aorbtn_apply:SetActiveE(isApply and 0 or 1)
        self.go_table.aorbtn_cancel:SetActiveE(isApply and 1 or 0)
    end
end

---类的析构函数
function FriendHelpApplyView_Item:Dispose()
end

return FriendHelpApplyView_Item
