---@class FriendHelpInfoView_LendPanel : Component	中文描述
---@field go_table FriendHelpInfoView._obj_LendInfo_GoTable
---@field lendDatas HelpSingleData[] 借出数据
local FriendHelpInfoView_LendPanel = _G.BaseClass("FriendHelpInfoView_LendPanel", _G.Component)
local FriendHelpInfoLItem = require "FriendHelpInfoLItem"
function FriendHelpInfoView_LendPanel:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建对象时,入口构造函数
function FriendHelpInfoView_LendPanel:OnCreate()
    self.itemList = {}
    self.go_table.scrollloopvectical_itemList:InitItemData(0, _G.handler(self, self.RefreshItem))
    self:AddListener(_G.eFriendHelp.TimeOver, self.UpdatePanel)
    self:UpdatePanel()
end

---更新界面
function FriendHelpInfoView_LendPanel:UpdatePanel()
    self.lendDatas = require "FriendHelpModel":GetInstance():GetLendDatas()
    self.go_table.scrollloopvectical_itemList:UpdateCount(#self.lendDatas)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Nil, #self.lendDatas <= 0)
end

---刷新物体
---@param index number 下标
---@param obj UnityEngine.GameObject 物体
function FriendHelpInfoView_LendPanel:RefreshItem(index, obj)
    local id = obj:GetInstanceIDE()
    local item = self.itemList[id]
    if not item then
        item = FriendHelpInfoLItem.New(obj, _G.handler(self, self.DealResortCall))
        self.itemList[id] = item
    end
    item:Show(self.lendDatas[index + 1], index + 1)
end

function FriendHelpInfoView_LendPanel:DealResortCall()
    self.go_table.scrollloopvectical_itemList:UpdateCount(#self.lendDatas)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Nil, #self.resortDatas <= 0)
end

---销毁对象时,析构函数
function FriendHelpInfoView_LendPanel:OnDestroy()
end

function FriendHelpInfoView_LendPanel:OnClickBtn(_, _)
end

return FriendHelpInfoView_LendPanel
