---@class FriendHelpInfoHItem	FriendHelpInfoView_HelpPanel 刷新物体
---@field go_table _obj_HelpInfo._obj_item_GoTable
---@field data HelpSingleData 申请数据
---@field cardItem ItemCardAllView 卡牌
local FriendHelpInfoHItem = _G.BaseClass("FriendHelpInfoHItem")
local UIUtils = _G.UIUtils
---类的构造函数
function FriendHelpInfoHItem:__init(go, call)
    self.gameObject = go
    self.go_table = _G.GetAutoGoTable(go, _G.handler(self, self.OnClickBtn))
    self.call = call
end
---更新显示
function FriendHelpInfoHItem:Show(data, index)
    self.data = data
    self.index = index
    UIUtils.SetPlayerHeadItemNew(self.go_table.obj_HeadItemBase,self.data.resortRole[1],0.7,true,true)
    self.go_table.aortext_name.text = self.data.resortRole[1].name
    self.go_table.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(self.data.resortRole[1].power)
    if not self.cardItem then
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.CardAllItem,
            self.go_table.obj_Root,
            function(item)
                self.cardItem = item
                self.cardItem:ShowCardData(self.data.cardData)
            end
        )
    else
        self.cardItem:ShowCardData(self.data.cardData)
    end
end
---点击事件
function FriendHelpInfoHItem:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_yes then
        require "FriendHelpModel":GetInstance():DealResort(
            {{role_uid = self.data.resortRole[1].uid, card_uid = self.data.cardData.uid, type = 1}},
            function()
                if self.call then
                    self.call()
                end
            end
        )
    elseif go == self.go_table.aorbtn_no then
        require "FriendHelpModel":GetInstance():DealResort(
            {{role_uid = self.data.resortRole[1].uid, card_uid = self.data.cardData.uid, type = 2}},
            function()
                if self.call then
                    self.call()
                end
            end
        )
    end
end
---类的析构函数
function FriendHelpInfoHItem:Dispose()
end

return FriendHelpInfoHItem
