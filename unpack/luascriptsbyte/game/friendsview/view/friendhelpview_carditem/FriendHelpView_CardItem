---@class FriendHelpView_CardItem	中文描述
---@field go_table FriendHelpView._obj_card_GoTable
---@field data CardData 申请数据
---@field card ItemCardAllView
local FriendHelpView_CardItem = _G.BaseClass("FriendHelpView_CardItem")
---类的构造函数
function FriendHelpView_CardItem:__init(obj, call)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.call = call
end
---更新卡牌显示
function FriendHelpView_CardItem:Show(data, index, isUse)
    self.data = data
    self.index = index
    if not self.card then
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.baseBodyItem,
            self.go_table.obj_Root,
            function(item)
                if _G.IsNil(self.gameObject) then
                    _G.DestroyObject(item.go_table.game)
                    return
                end
                self.card = item
                self.data.skinIs = false
                self.card:ShowCardData(self.data, _G.handler(self, self.OnClickBtn))
            end
        )
    else
        self.data.skinIs = false

        self.card:ShowCardData(self.data, _G.handler(self, self.OnClickBtn))
    end
    self:SetUse(isUse)
end

function FriendHelpView_CardItem:SetUse(isUse)
    self.go_table.obj_use:SetActiveE(isUse and 1 or 0)
end

function FriendHelpView_CardItem:OnClickBtn(go, isOn)
    if self.call then
        self.call(self)
    end
end

---类的析构函数
function FriendHelpView_CardItem:Dispose()
end

return FriendHelpView_CardItem
