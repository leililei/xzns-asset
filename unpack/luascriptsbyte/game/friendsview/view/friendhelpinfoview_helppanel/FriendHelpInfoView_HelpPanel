---@class FriendHelpInfoView_HelpPanel : Component	中文描述
---@field go_table FriendHelpInfoView._obj_HelpInfo_GoTable
---@field itemList table<number,FriendHelpInfoHItem> 生成的物体
---@field resortDatas HelpSingleData[] 申请数据
local FriendHelpInfoView_HelpPanel = _G.BaseClass("FriendHelpInfoView_HelpPanel", _G.Component)
local FriendHelpInfoHItem = require "FriendHelpInfoHItem"
function FriendHelpInfoView_HelpPanel:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建对象时,入口构造函数
function FriendHelpInfoView_HelpPanel:OnCreate()
    self.itemList = {}
    self.resortDatas = require "FriendHelpModel":GetInstance():GetResortData()
    _G.table.sort(
        self.resortDatas,
        function(a, b)
            return a.time[1] < b.time[1]
        end
    )
    self.go_table.scrollloopvectical_itemList:InitItemData(#self.resortDatas, _G.handler(self, self.RefreshItem))
    self:ShowBtn()
    self:AddListener(_G.eFriendHelp.TimeOver, self.DealResortCall)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Nil, #self.resortDatas <= 0)
end
---刷新物体
---@param index number 下标
---@param obj UnityEngine.GameObject 物体
function FriendHelpInfoView_HelpPanel:RefreshItem(index, obj)
    local id = obj:GetInstanceIDE()
    local item = self.itemList[id]
    if not item then
        item = FriendHelpInfoHItem.New(obj, _G.handler(self, self.DealResortCall))
        self.itemList[id] = item
    end
    item:Show(self.resortDatas[index + 1], index + 1)
end

function FriendHelpInfoView_HelpPanel:DealResortCall()
    self.resortDatas = require "FriendHelpModel":GetInstance():GetResortData()
    _G.table.sort(
        self.resortDatas,
        function(a, b)
            return a.time[1] < b.time[1]
        end
    )
    self.go_table.scrollloopvectical_itemList:UpdateCount(#self.resortDatas)
    self:ShowBtn()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Nil, #self.resortDatas <= 0)
end
---显示按钮
function FriendHelpInfoView_HelpPanel:ShowBtn()
    local count = #self.resortDatas
    self.go_table.aorbtn_agree:SetActiveE(count > 0 and 1 or 0)
    self.go_table.aorbtn_ignore:SetActiveE(count > 0 and 1 or 0)
end

---更新界面
function FriendHelpInfoView_HelpPanel:UpdatePanel()
    self.go_table.scrollloopvectical_itemList:UpdateCount(#self.resortDatas)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Nil, #self.resortDatas <= 0)
end

---销毁对象时,析构函数
function FriendHelpInfoView_HelpPanel:OnDestroy()
end
---全部同意
function FriendHelpInfoView_HelpPanel:OnAgree()
    local count = #self.resortDatas
    local msg = {}
    for i = 1, count do
        ---@type assist.i_apply
        local data = {}
        data.card_uid = self.resortDatas[i].cardData.uid
        data.role_uid = self.resortDatas[i].resortRole[1].uid
        data.type = 1
        msg[i] = data
    end
    require "FriendHelpModel":GetInstance():DealResort(msg, _G.handler(self, self.DealResortCall))
end
---全部忽略
function FriendHelpInfoView_HelpPanel:OnIgonre()
    local count = #self.resortDatas
    local msg = {}
    for i = 1, count do
        ---@type assist.i_apply
        local data = {}
        data.card_uid = self.resortDatas[i].cardData.uid
        data.role_uid = self.resortDatas[i].resortRole[1].uid

        data.type = 2
        msg[i] = data
    end
    require "FriendHelpModel":GetInstance():DealResort(msg, _G.handler(self, self.DealResortCall))
end

function FriendHelpInfoView_HelpPanel:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_agree then
        self:OnAgree()
    elseif go == self.go_table.aorbtn_ignore then
        self:OnIgonre()
    end
end

return FriendHelpInfoView_HelpPanel
