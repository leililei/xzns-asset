---@class FriendHelpApplyView : UIBaseView	中文描述
---@field public go_table FriendHelpApplyView_GoTable GoTable
---@field ItemList table<number,FriendHelpApplyView_Item> 所有的申请物体
---@field public helpDatas HelpSingleData 申请数据
local FriendHelpApplyView = _G.BaseClass("FriendHelpApplyView", _G.UIBaseView)
--_G.FriendHelpApplyView = FriendHelpApplyView
local FriendHelpApplyView_Item = require "FriendHelpApplyView_Item"

function FriendHelpApplyView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function FriendHelpApplyView:OnCreate(sid)
    self.sid = sid
    self.ItemList = {}
    self.go_table.scrollloopvectical_itemList:InitItemData(0, _G.handler(self, self.RefreshItem))
    self:UpdatePanel(sid)
    self:AddListener(_G.eFriendHelp.TimeOver, self.UpdatePanel)
    self:AddListener(_G.eFriendHelp.AgreeBorrow, self.UpdateSingle)
    self:AddListener(_G.eFriendHelp.UnPutCard, self.UnPutCard)
end

function FriendHelpApplyView:UpdateSingle(index)
    ---@type HelpSingleData
    local data = require "FriendHelpModel":GetInstance():GetBorrowDatas(true)[index]
    for i, v in pairs(self.helpDatas) do
        if v.cardData.uid == data.cardData.uid then
            self.go_table.scrollloopvectical_itemList:UpdateItemSingle(i - 1)
            break
        end
    end
    self:UpdateApplyCount()
end

function FriendHelpApplyView:UpdatePanel()
    self.helpDatas = require "FriendHelpModel":GetInstance():GetHelpCardDataBySid(self.sid)
    self:SortDatas()
    self.go_table.scrollloopvectical_itemList:UpdateCount(#self.helpDatas)
    self:UpdateApplyCount()
end

---刷新卡牌
---@param index number 下标
---@param obj UnityEngine.GameObject
function FriendHelpApplyView:RefreshItem(index, obj)
    local id = obj:GetInstanceIDE()
    local item = self.ItemList[id]
    if not item then
        item = FriendHelpApplyView_Item.New(obj, _G.handler(self, self.UpdateApplyCount))
        self.ItemList[id] = item
    end
    item:Show(self.helpDatas[index + 1], index)
end
---更新申请数
function FriendHelpApplyView:UpdateApplyCount()
    self.go_table.aortext_title2.text =
        _G.LangUtil.GetLangPackValue(90000010403) ..
        _G.string.format("%s/%s", require "FriendHelpModel":GetInstance():GetApplyCount())
end

---下阵卡牌
---@param msg assist.p2c_assist_agree
function FriendHelpApplyView:UnPutCard(msg)
    for k, v in pairs(self.helpDatas) do
        if v.cardData.uid == msg.card_uid and v.lendRole.uid == msg.role_uid then
            _G.table.remove(self.helpDatas, k)
            self.go_table.scrollloopvectical_itemList:UpdateCount(#self.helpDatas)
            break
        end
    end
    self:UpdateApplyCount()
end

---数据排序
function FriendHelpApplyView:SortDatas()
    ---@param a HelpSingleData
    _G.SortList(
        self.helpDatas,
        function(a)
            local int = _G.table.isEmptyOrNil(a.browRole) and 1 or 0
            return int, a.cardData.power, a.cardData.star, a.cardData.Grade, a.cardData:GetLevel(), -a.cardData.uid
        end
    )
end

---按钮点击事件在这里派发
function FriendHelpApplyView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_anyclose then
        self:Close()
    end
end

return FriendHelpApplyView
