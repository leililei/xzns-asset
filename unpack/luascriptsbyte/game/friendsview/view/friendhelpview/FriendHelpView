---@class FriendHelpView : UIBaseView	中文描述
---@field public go_table FriendHelpView_GoTable GoTable
---@field topCards FriendHelpView._obj_card5_GoTable[]
---@field topCardDatas HelpSetInfoData[] 已选中卡牌数据
---@field topCardUids table<number,number> 已选中卡牌uid
---@field cardList table<number,FriendHelpView_CardItem> 卡牌物体
---@field dataInItem table<number,FriendHelpView_CardItem> 卡牌数据对应的物体
local FriendHelpView = _G.BaseClass("FriendHelpView", _G.UIBaseView)
--_G.FriendHelpView = FriendHelpView

function FriendHelpView:Awake()
    self.go_table.toggle_autoHelp.isOn = require "FriendHelpModel":GetInstance():GetAutoAgree()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function FriendHelpView:OnCreate(call)
    self.topCards = {}
    self.cardList = {}
    self.dataInItem = {}
    self.topCardDatas = _G.DeepCopy(require "FriendHelpModel":GetInstance():GetSetCardDatas())
    self.topCardUids = _G.DeepCopy(require "FriendHelpModel":GetInstance():GetSetCardUids())
    self.cardDatas = require "FriendHelpModel":GetInstance():GetCanSetCardDatas()

    self:InitTopCards()
    self.go_table.scrollloopvectical_cardList:DetectingSlippage(_G.handler(self, self.OnMove))
    self.go_table.scrollloopvectical_cardList:InitItemData(#self.cardDatas, _G.handler(self, self.RefreshItem))

    self.go_table.aorbtn_enter:SetActiveE(#self.cardDatas == 0 and 0 or 1)
    if #self.cardDatas == 0 then
        self.go_table.aortext_enter.color = _G.ColorTools.FormatColorByString("414141")
    end

    --local goTable = _G.GetAutoGoTable(self.go_table.toggle_autoHelp)
    --goTable.aorimage_isOn:SetActiveE(require "FriendHelpModel":GetInstance():GetAutoAgree() and 1 or 0)
end
---初始化顶部卡牌
function FriendHelpView:InitTopCards()
    for i = 1, 5 do
        self.topCards[i] =
            _G.GetAutoGoTable(self.go_table["obj_card" .. i], _G.handlerbind(self, self.OnClickTopCard, i))
        self:UpdateTopCard(i)
    end
end

---更新TopCard显示
---@param index number 下标
function FriendHelpView:UpdateTopCard(index)
    local tb = self.topCards[index]
    if not self.topCardDatas[index] then
        _G.GameUtil.SetActiveByCondition(tb.aorbtn_cancel, false)
        _G.GameUtil.SetActiveByCondition(tb.obj_Root, false)
    else
        _G.GameUtil.SetActiveByCondition(tb.aorbtn_cancel, true)
        _G.GameUtil.SetActiveByCondition(tb.obj_Root, true)
        if not tb.card then
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.CardAllItem,
                tb.obj_Root,
                function(item)
                    if self:IsNil() then
                        _G.DestroyObject(item.go_table.gameObject)
                        return
                    end
                    tb.card = item
                    tb.card:ShowCardData(self.topCardDatas[index].CardData, nil, false)
                end
            )
        else
            tb.card:ShowCardData(self.topCardDatas[index].CardData, nil, false)
        end
    end
end

---检测卡牌是否设置
function FriendHelpView:CheckCardIsSet(cardUid)
    return not _G.IsNil(self.topCardUids[cardUid])
end

---点击顶部卡牌
function FriendHelpView:OnClickTopCard(_, _, index)
    self:DownCard(self.topCardDatas[index].CardData.uid)
end

---刷新物体
---@param index number 下标
---@param obj UnityEngine.GameObject
function FriendHelpView:RefreshItem(index, obj)
    local id = obj:GetInstanceIDE()
    local item = self.cardList[id]
    if _G.IsNil(item) then
        item = require "FriendHelpView_CardItem".New(obj, _G.handler(self, self.OnClickCard))
        self.cardList[id] = item
    end
    local data = self.cardDatas[index + 1]
    if item.timer then
        item.timer:Stop()
        item.timer = nil
    end
    if not self.inited then
        item.timer =
            _G.TimerManager:GetInstance():GetTimer(
            1 * _G.math.floor(index / 4),
            self.ItemShow,
            self,
            true,
            true,
            true,
            item,
            data,
            index + 1
        )
        item.timer:Start()
    else
        self:ItemShow(item, data, index + 1)
        item:Show(data, index + 1, self:CheckCardIsSet(data.uid))
    end

    self.dataInItem[data.uid] = item
end

function FriendHelpView:ItemShow(item, data, index)
    item:Show(data, index + 1, self:CheckCardIsSet(data.uid))
end

function FriendHelpView:OnMove()
    self.inited = true
    self.go_table.scrollloopvectical_cardList:DetectingSlippage()
end

---点击卡牌
---@param item FriendHelpView_CardItem 卡牌
function FriendHelpView:OnClickCard(item)
    if self:CheckCardIsSet(item.data.uid) then
        self:DownCard(item.data.uid)
    else
        if self:AddCard(item.data) then
            item:SetUse(true)
        end
    end
end
---卡牌取消设置
function FriendHelpView:DownCard(cardUid)
    -- if require "FriendHelpModel":GetInstance():CheckIsLend(cardUid) then
    --     --TODO 提示
    --     return false
    -- end
    local index = self.topCardUids[cardUid]
    self.topCardUids[cardUid] = nil
    self.topCardDatas[index] = nil
    self:UpdateTopCard(index)
    local item = self.dataInItem[cardUid]
    if not _G.IsNil(item) then
        item:SetUse(self:CheckCardIsSet(item.data.uid))
    end
    return true
end

---卡牌设置
---@param cardData CardData 卡牌数据
function FriendHelpView:AddCard(cardData)
    local index = self:GetTopEmptyIndex()
    if index <= 0 then
        --TODO 提示
        return false
    end
    self.topCardUids[cardData.uid] = index
    self.topCardDatas[index] = {CardData = cardData}
    self:UpdateTopCard(index)
    return true
end

---获取顶部未设置卡槽
function FriendHelpView:GetTopEmptyIndex()
    for i = 1, 5 do
        if _G.IsNil(self.topCardDatas[i]) then
            return i
        end
    end
    return 0
end
---保存设置的卡牌
function FriendHelpView:SaveSetCards()
    local infoDatas = require "FriendHelpModel":GetInstance():GetSetCardDatas()
    local tb = {}
    ---@type HelpSingleData
    local data1, data2
    for i = 1, 5 do
        data1 = infoDatas[i]
        data2 = self.topCardDatas[i]
        if (not _G.IsNil(data1) and not _G.IsNil(data2)) then
            if data1.CardData.uid ~= data2.CardData.uid then
                _G.table.insert(tb, {uid = data2.CardData.uid, type = 1, index = i})
            end
        elseif (_G.IsNil(data1) and not _G.IsNil(data2)) then
            _G.table.insert(tb, {uid = data2.CardData.uid, type = 1, index = i})
        elseif (not _G.IsNil(data1) and _G.IsNil(data2)) then
            _G.table.insert(tb, {type = 2, index = i})
        end
    end
    _G.PopWindowManager:GetInstance():ShowAllTips(4515)
    require "FriendHelpModel":GetInstance():SetBorrowCard(
        tb,
        function()
            self:Close()
        end
    )
end

---按钮点击事件在这里派发
function FriendHelpView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_anyclose then
        self:Close()
    elseif go == self.go_table.aorbtn_enter then
        if #self.cardDatas <= 0 then
            return
        end
        self:SaveSetCards()
    elseif go == self.go_table.toggle_autoHelp then
        require "FriendHelpModel":GetInstance():SetAutoAgree()
    elseif go == self.go_table.aorbtn_CloseTips then
        self.go_table.aorbtn_CloseTips:SetActiveE(0)
        self.go_table.obj_tips:SetActiveE(0)
    elseif go == self.go_table.aorbtn_tips then
        self.go_table.aorbtn_CloseTips:SetActiveE(1)
        self.go_table.obj_tips:SetActiveE(1)
    end
end

function FriendHelpView:OnStartClose()
    for _, v in pairs(self.cardList) do
        if v.timer then
            v.timer:Stop()
            v.timer = nil
        end
    end
end

return FriendHelpView
