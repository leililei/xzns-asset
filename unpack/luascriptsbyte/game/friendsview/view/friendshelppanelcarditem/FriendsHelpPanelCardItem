---@class FriendsHelpPanelCardItem	中文描述
---@field go_table _obj_FriendHelp._obj_Item_GoTable
---@field item ItemCardAllView 卡牌
local FriendsHelpPanelCardItem = _G.BaseClass("FriendsHelpPanelCardItem")
---类的构造函数
function FriendsHelpPanelCardItem:__init(go, click)
    self.gameObject = go
    self.transform = go
    self.go_table = _G.GetAutoGoTable(go)
    self.click = click
end
---显示
---@param data HelpSingleData
function FriendsHelpPanelCardItem:Show(data, index)
    self.index = index
    self.data = data
    if not self.item then
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.CardAllItem,
            self.go_table.obj_Root,
            function(item)
                self.item = item
                self.item:ShowCardData(self.data.cardData, _G.handler(self, self.OnClick))
                self.item:HideOrShowLevel(false)
            end
        )
    else
        self.item:ShowCardData(self.data.cardData, _G.handler(self, self.OnClick))
    end
    self:UpdateShow()
end
---更新状态显示
function FriendsHelpPanelCardItem:UpdateShow()
    self.go_table.obj_mask:SetActiveE(0)
    if require "FriendHelpModel":GetInstance():CheckIsUse(self.data.cardData.sid) then
        self.go_table.obj_mask:SetActiveE(1)
        self.go_table.obj_use:SetActiveE(1)
        self.go_table.obj_apply:SetActiveE(0)
    else
        self.go_table.obj_use:SetActiveE(0)
        if require "FriendHelpModel":GetInstance():CheckIsApply(self.data.cardData.uid) then
            self.go_table.obj_mask:SetActiveE(1)
            self.go_table.obj_apply:SetActiveE(1)
        else
            self.go_table.obj_apply:SetActiveE(0)
        end
    end
end

---点击
function FriendsHelpPanelCardItem:OnClick()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FriendHelpApplyView.Name, self.data.cardData.sid)
end

---类的析构函数
function FriendsHelpPanelCardItem:Dispose()
end

return FriendsHelpPanelCardItem
