---@class FriendHelpInfoView : UIBaseView	中文描述
---@field public go_table FriendHelpInfoView_GoTable GoTable
---@field lendInfoPanel FriendHelpInfoView_LendPanel 借出信息
---@field helpInfoPanel FriendHelpInfoView_HelpPanel 申请借入信息
local FriendHelpInfoView = _G.BaseClass("FriendHelpInfoView", _G.UIBaseView)
--_G.FriendHelpInfoView = FriendHelpInfoView

function FriendHelpInfoView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function FriendHelpInfoView:OnCreate()
    self:UpdatePanel()
    self.go_table.toggle_help.isOn = true
    self:AddListener(_G.eFriendHelp.Resort, self.UpdateHelp)
    self:AddListener(_G.eFriendHelp.TimeOver, self.UpdatePanel)
    self:AddListener(_G.eFriendHelp.AgreeResort, self.UpdatePanel)
end

function FriendHelpInfoView:UpdatePanel()
    local point, max = require "FriendHelpModel":GetInstance():GetPoint()
    self.go_table.aortext_point.text = _G.string.format("%s/%s", point, max)
end

---显示求助信息
function FriendHelpInfoView:OnHelp(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.toggle_help:GetChildE(2), isOn)
    self.go_table.obj_HelpInfo:SetActiveE(isOn and 1 or 0)
    if isOn then
        if not self.helpInfoPanel then
            self.helpInfoPanel =
                self:AddComponent(self.go_table.obj_HelpInfo, require "FriendHelpInfoView_HelpPanel".New())
        end
    end
end

---显示借出信息
function FriendHelpInfoView:OnLend(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.toggle_lend:GetChildE(2), isOn)
    self.go_table.obj_LendInfo:SetActiveE(isOn and 1 or 0)
    if isOn then
        if not self.lendInfoPanel then
            self.lendInfoPanel =
                self:AddComponent(self.go_table.obj_LendInfo, require "FriendHelpInfoView_LendPanel".New())
        end
    end
end

---更新求助
---@param data HelpSingleData 申请数据
function FriendHelpInfoView:UpdateHelp(data)
    if self.helpInfoPanel then
        self.helpInfoPanel:UpdatePanel()
    end
end

---更新借出
function FriendHelpInfoView:UpdateLend()
end

---按钮点击事件在这里派发
function FriendHelpInfoView:OnClickBtn(go, isOn)
    if go == self.go_table.toggle_help then
        self:OnHelp(isOn)
    elseif go == self.go_table.toggle_lend then
        self:OnLend(isOn)
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_anyclose then
        self:Close()
    end
end

return FriendHelpInfoView
