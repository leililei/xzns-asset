---@class GuideNpcHelpView : UIBaseView	中文描述
---@field public go_table GuideNpcHelpView_GoTable GoTable
local GuideNpcHelpView = _G.BaseClass("GuideNpcHelpView", _G.UIBaseView)
local LangUtil = _G.LangUtil
local Step = {
    90000010491,
    90000010492
}

function GuideNpcHelpView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function GuideNpcHelpView:OnCreate()
    self.stepIndex = 0
    self.maxStep = #Step
    self:OnNext()
end

function GuideNpcHelpView:OnNext()
    self.stepIndex = self.stepIndex + 1
    if self.stepIndex > self.maxStep then
        _G.PlayerPrefsManager.SetInt(require "FriendHelpModel".npcKey, 1)
        self:Close()
        return
    end
    self.go_table.aortext_fullContent.text = LangUtil.GetLangPackValue(Step[self.stepIndex])
end

---按钮点击事件在这里派发
function GuideNpcHelpView:OnClickBtn(go)
    if go == self.go_table.aorbtn_next then
        self:OnNext()
    end
end

return GuideNpcHelpView
