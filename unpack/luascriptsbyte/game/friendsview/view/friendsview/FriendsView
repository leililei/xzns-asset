---删除好友成功
function FriendsView:DelFriendSuc(uidLis)
    --self.go_table.obj_IconClick:SetActiveE(0)
    local count = #self.FriendUidList
    self.Frienindex = self.Frienindex or 1
    for i = count, 1, -1 do
        if _G.table.ContainsValue(uidLis, self.FriendUidList[i]) then
            _G.table.remove(self.FriendUidList, i)
        end
    end

    if self.AddFriendListYitianJia then
        for i = #self.AddFriendListYitianJia, 1, -1 do
            if _G.table.ContainsValue(uidLis, self.AddFriendListYitianJia[i]) then
                _G.table.remove(self.AddFriendListYitianJia, i)
            end
        end
    end
    self.Frienindex = _G.math.min(self.Frienindex - 1, count - 1)
    self.Frienindex = _G.math.max(self.Frienindex, 0)
    if count == 0 then
        self.go_table.scrollloopvectical_FriendList:UpdateCount(0)
    else
        self.go_table.scrollloopvectical_FriendList:UpdateCount(#self.FriendUidList, self.Frienindex)
    end

    self.numList = _G.table.count(self.FriendList)
    local maxNum = _G.ConfigManager.discrete_cfg[100308][1][1] * _G.ConfigManager.discrete_cfg[100309][1][2]
