---更新添加好友列表
---@param list table 好友列表信息
---@param search boolean true为搜索好友列表,可以滑动刷新,false为推荐好友列表,不可滑动刷新
function FriendsView:UpdateAddFriend(list, search, asda)
    if search == nil then
        self.search = false
    else
        self.search = search
    end
    ---判断该表是否为空
    if _G.table.isEmptyOrNil(list) then
        if self.IsSeek then
            self.go_table.input_SeekPlayer.text = self.SeekUid
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_NotSeekPlayer, true)
        else
            self.go_table.input_SeekPlayer.text = ""
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_NotSeekPlayer, false)
        end
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_NotSeekPlayer, false)
    end
    self.AddFriendList = {}
    self.CanAddFriendList = {}
    for i, v in pairs(list) do
        if (not v.has_request or search) and not _G.table.ContainsValue(self.FriendsAreFullList, i) then
            table.insert(self.CanAddFriendList, i)
        end
        table.insert(self.AddFriendList, i)
    end

    ---表排序
    table.sort(
        self.AddFriendList,
        function(a, b)
            if list[a].time == 0 and list[b].time ~= 0 then
                return true
            elseif list[b].time == 0 then
                return false
            end
            return list[a].time > list[b].time
        end
    )
    self:InitAllAddBtn(list)
    -- self.go_table.uiinf_AddFriendList.TableDataCount = #self.AddFriendList
    local isRefresh = false
    local num = table.count(list) --_G.math.ceil(_G.table.count(list))
    ---判断一个表是否长度为零或者长度不一致
    if self.friendNum.AddFriend ~= nil and self.friendNum.AddFriend == num then
        isRefresh = true
    end
    self.friendNum.AddFriend = num
    if self.curType == TagType.AddFriend then
        if self.first.AddFriend then
            self.go_table.scrollloopvectical_AddFriendList:InitItemData(0, _G.handler(self, self.RefreshAddFriendList))
            self.first.AddFriend = false
        end

        if isRefresh and asda == nil then
            self.go_table.scrollloopvectical_AddFriendList:UpdateAllItem()
        else
            self.go_table.scrollloopvectical_AddFriendList:UpdateCount(num)
        end
        ---是否可以滑动刷新
        local isNextRefresh = require("FriendManager"):GetInstance():CheckIsContinue()
        if self.search and isNextRefresh then
            self.go_table.scrollloopvectical_AddFriendList:DetectingSlippage(_G.handler(self, self.onValueChanged))
        else
            self.go_table.scrollloopvectical_AddFriendList:DetectingSlippage()
        end
    end
    if self.toAddAllFriend then
        self.toAddAllFriend = false
        self:AddAllFriend()
    end
end

