        if not isOn or self.curType == TagType.Left then
            return
        end
        self.curType = TagType.Left
        if self.IsFriendView == false then
            self.CurItem = 1
        end
        self.IsFriendView = true
        self.go_table.input_UserInput.text = ""

        self:UpdateFriendPanel()
    elseif name == "@_aorbtn_Auto" then
        --self.FriendShip = 2
        --self:AllGetOrGive(2)
        self.FriendShip = 3
        self:AllGetOrGive()
    elseif name == "@_aorbtn_DelFriendBtn" then
        self:DelFriend()
    elseif name == "@_aorbtn_AddBlackBtn" then
        self:AddBlcakList()
    elseif name == "@_aorbtn_CloseIconClcik" then
        self.go_table.obj_IconClick:SetActiveE(0)
    elseif name == "@_aorbtn_Seed" then
        self:SeekPlayer()
    elseif name == "@_aorbtn_Update" then
        if self.HuanYiPi then
            self.PoolTime = _G.ConfigManager.discrete_cfg[100310][1][1]
            --self.lastClick = time + _G.ConfigManager.discrete_cfg[100310][1][1]
            self.isMove = true
            self.HuanYiPi = false
            self:UpdateAddFriendPanel()
            self.go_table.aorbtn_Update:SetGray(true)
            --self.go_table.aorbtn_Update.interactable = false
            self.go_table.aortext_huanYiPiname.text =
                _G.ConfigManager.language_package_cfg[9002010009] .. "(" .. self.PoolTime .. "s)"
            self.go_table.aortext_huanYiPiname.color = require("CardInfoManager").GetColorFromRGB("414141")
            if nil == self.timer then
                self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.PoolTimer, self, false, false, true)
                self.timer:Start()
            end
        end
    elseif name == "@_aorbtn_AllAdd" then
        self:AddAllFriend()
    elseif name == "@_aorbtn_AllRefuse" then
        self:DealAllApply(0)
    elseif name == "@_aorbtn_AllAgree" then
        self:DealAllApply(1)
    elseif name == "@_aorbtn_Send" then
        self:SendMsgOfChat()
    elseif name == "@_aorbtn_way" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 47)
    elseif name == "@_aorbtn_StrategyStation" then
        -- if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.StrategyStation) then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.StrategyStationKeyboardView.Name)
        -- else
        --     _G.FunctionManager:GetInstance():ShowFuncitonOpenTips(_G.FunctionID.StrategyStation)
        -- end
    elseif name == "@_aorbtn_sworn" then 
        self:Close()
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SwornView.Name)
    elseif name == "@_aorbtn_delAndApply" then 
        self:DelAndApplyFriend()
    end
end

function FriendsView:CheckSworn()
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Sworn) then
        self.go_table.aorbtn_sworn:SetActiveE(1)
    else
        self.go_table.aorbtn_sworn:SetActiveE(0)
    end

    
end


function FriendsView:CheckStrategyStation()
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.StrategyStation) then
        self.go_table.aorbtn_StrategyStation:SetActiveE(1)
    local knowIdx = StrategyStationModel:GetInstance().index
            
        self.go_table.aortext_num.text =StrategyStationModel:GetInstance():GetNumByIndex(knowIdx)

    else
