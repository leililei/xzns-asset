function FriendsView:UpdateFriendPanel(back)
    self.IsSeek = false
    if self.IsFriendView then
        require("FriendManager"):GetInstance():GetFriendListInServer(
            function(list)
                self.numList = _G.table.count(list)
                self.go_table.obj_FriendInfoPanel:SetActiveE(1)
                --self.go_table.obj_RecentChatPanel:SetActiveE(0)
                local maxNum = _G.ConfigManager.discrete_cfg[100308][1][1] * _G.ConfigManager.discrete_cfg[100309][1][2]
                self.go_table.aortext_GetNum.text =
                    require("FriendManager"):GetInstance():GetFriendShipToday() .. "/" .. maxNum
                -- "<color=#5F3838>" ..
                -- _G.ConfigManager.language_package_cfg[9002010003] ..
                --     "</color> " ..
                self.go_table.aortext_FriendshipNum.text =
                    _G.GameUtil.NumberToUnitStr(
                        _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.ResProp, _G.ResPropID.Friendship)
                    )
                self.go_table.aortext_FriendNum.text =
                    self.numList .. "/" .. _G.ConfigManager.discrete_cfg[100301][1][1]
                -- self.FriendListRect:SetRectTransformSize(376, 360)
                self.go_table.obj_BottomBtn:SetActiveE(1)
                self:UpdateFriendList(list)
                if back then
                    back()
                end
            end
        )
    else
        self.go_table.obj_FriendInfoPanel:SetActiveE(0)
        self.go_table.obj_RecentChatPanel:SetActiveE(1)

        require("FriendManager"):GetInstance():GetRecentChatListInServer(
            function(list)
                self.go_table.aortext_RecentChatNum.text =
                    _G.table.count(list) .. "/" .. _G.ConfigManager.discrete_cfg[100304][1][1]
                self:UpdateFriendList(list)
                if back then
                    back()
                end
            end
        )
    end
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FriendApplication.id)
end

----更新好友界面
function FriendsView:UpdateFriendList(list)
    --self.Items.Friend = {}
    self.FriendList = list
    self.FriendUidList = {}
    if _G.table.isEmptyOrNil(list) and self.IsFriendView then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_NoFriend, true)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_NoFriend, false)
        if self.IsFriendView then
            for i, _ in pairs(list) do
                _G.table.insert(self.FriendUidList, i)
            end
            _G.table.sort(
                self.FriendUidList,
                function(a, b)
                    if list[a].time == 0 and list[b].time ~= 0 then
                        return true
                    elseif list[b].time == 0 then
                        return false
                    end
                    return list[a].time > list[b].time
                end
            )
        else
            self.FriendUidList = require("FriendManager"):GetInstance():GetRecentChat()
        end
    end

    self.friendNum.Friend = _G.table.count(list)
    if self.first.Friend then
        self.go_table.scrollloopvectical_FriendList:InitItemData(0, _G.handler(self, self.RefreshFriendList))
        self.first.Friend = false
    end
    self.go_table.scrollloopvectical_FriendList:UpdateCount(self.friendNum.Friend)
    if self.Frienindex ~= nil then
        self.go_table.scrollloopvectical_FriendList:ScrollToIndex(self.Frienindex)
    end

    -- self.go_table.scrollloopvectical_FriendList:RefreshAllShownItem()
    --self:OnFriendClick(self.CurItem)
end

---更新单个好友
function FriendsView:RefreshFriendList(index, listView2)
    if index < 0 then
        return
    end
    local list
    list = self.FriendList
    local item = listView2
    local x = index + 1
    item:SetName(x)
    local tb = _G.GetAutoGoTable(item, _G.handlerbind(self, self.OnFriendListClick, x))
    local data = list[self.FriendUidList[x]]
    if self.IsFriendView then
        tb.aorimage_redpoint:SetActiveE(0)
        tb.aorimage_Heart:SetGray(data.accept ~= 1)
        tb.aorimage_GiveHeart:SetGray(data.send ~= 0)
    else
        --tb.aorimage_Heart:SetActiveE(0)
        local chats = require("FriendManager"):GetInstance().RedDotRecentChat
        if chats ~= nil and chats[self.FriendUidList[x]] ~= nil and chats[self.FriendUidList[x]].bool then
            tb.aorimage_redpoint:SetActiveE(1)
        else
            tb.aorimage_redpoint:SetActiveE(0)
        end
    end

    --tb.aortext_LV.text = "Lv " .. data.lv
    tb.aortext_Name.text = data.name
    ---TODO预留跨区
    local power = data.power
    local strPow = _G.GameUtil.NumberToUnitStrFight(power)
    tb.aortext_power.text = strPow
    ---@type Params_PlayerHeadItem
    local Params_PlayerHeadItem = {}
    Params_PlayerHeadItem.frame = data.frame
    Params_PlayerHeadItem.lv = data.lv
    Params_PlayerHeadItem.style = data.style
    Params_PlayerHeadItem.sid = _G.ConfigManager.player_portrait_cfg[data.style].ID
    Params_PlayerHeadItem.title = data.title
    UIUtils.SetPlayerHeadItemNew(tb.obj_FriendHead, Params_PlayerHeadItem, 0.75, true, true, true)
    --_G.GameUtil.SetActiveByCondition(tb.aorimage_Light, false)
    if data.time == 0 then
        _G.GameUtil.SetActiveByCondition(tb.aortext_Offline, false)
        _G.GameUtil.SetActiveByCondition(tb.aortext_Online, true)
    else
        local time = _G.TimeUtil.GetServerUnixTime() - data.time
        if time < 60 then
            tb.aortext_Offline.text = GetLangPackValue(90022500384)
        else
            time = time / 60
            if time < 60 then
                tb.aortext_Offline.text = _G.math.floor(time) .. GetLangPackValue(90022500387)
            else
                time = time / 60
                if time < 24 then
                    tb.aortext_Offline.text = _G.math.floor(time) .. GetLangPackValue(90022500388)
                else
                    time = time / 24
                    if time < 30 then
                        tb.aortext_Offline.text = _G.math.floor(time) .. GetLangPackValue(90022500389)
                    else
                        tb.aortext_Offline.text = GetLangPackValue(90022500390)
                    end
                end
            end
        end
        _G.GameUtil.SetActiveByCondition(tb.aortext_Offline, true)
        _G.GameUtil.SetActiveByCondition(tb.aortext_Online, false)
    end
    local server = _G.ServerManager:GetInstance():GetServerNameByServerID(data.server)
    if server then
        tb.aortext_ServerName.text = GetLangPackValue(LangID.FuWuQi) .. server
    else
        tb.aortext_ServerName.text =
            GetLangPackValue(LangID.FuWuQi) .. _G.ServerManager:GetInstance().CurServer.ServerName
    end

    tb.aortext_ProgressNum:SetActiveE(0)
    if data.afk ~= nil and data.afk ~= 0 then
        tb.aortext_ProgressNum:SetActiveE(1)
        tb.aortext_ProgressNum.text =
            GetLangPackValue(LangID.GuanKa, self.afk_cfg[data.afk].chapter, self.afk_cfg[data.afk].section)
    else
        tb.aortext_ProgressNum:SetActiveE(1)
        tb.aortext_ProgressNum.text = GetLangPackValue(LangID.GuanKa, 1, 1)
    end
    return item
end

---计算今天友情点的数量
function FriendsView:HeartValue(list)
    local num = 0
    if list == nil then
        return
    end
    for _, v in pairs(list) do
        if v.accept == 2 then
            num = num + _G.ConfigManager.discrete_cfg[100309][1][2]
        end
    end
    return num
end

