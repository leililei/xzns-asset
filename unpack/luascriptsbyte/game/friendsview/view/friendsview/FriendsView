---搜索玩家返回
function FriendsView:SeekPlayerSuc(data)
    if data == nil then
        return
    end
    self.go_table.aorbtn_Seed.interactable = false
    self.go_table.aorbtn_Seed:SetGray(true)
    if nil == self.delaySecondHandle then
        self.delaySecondHandle = _G.TimerManager:GetInstance():GetTimer(0.5, self.ZhaoMuBut, self, true, false, true)
        self.delaySecondHandle:Start()
    end
    local ack = data.ack
    local friend = data.friend
    if ack == 1 then
        if _G.table.isEmptyOrNil(friend) then
            _G.PopWindowManager:GetInstance():ShowAllTips(TipsID.NotFindPlayer)
            self.go_table.obj_NotSeekPlayer:SetActiveE(1)
            return
        else
            local list = {}
            for _, v in pairs(friend) do
                list[v.uid] = require("FriendData").New()
                list[v.uid]:Init(v)
            end
            self.isMove = false
            self:UpdateAddFriend(list, true)
        end
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(TipsID.NotFindPlayer)
        self.isMove = false
        -- self:UpdateAddFriendPanel()
        return
    end
end

