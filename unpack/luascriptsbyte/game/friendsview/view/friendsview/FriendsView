---选择好友
function FriendsView:OnFriendClick(index)
    if _G.table.isEmptyOrNil(self.Items.Friend) then
        return
    end
    _G.GameUtil.SetActiveByCondition(self.Items.Friend[self.CurItem].aorimage_Light, false)
    _G.GameUtil.SetActiveByCondition(self.Items.Friend[index].aorimage_Light, true)

    self.CurItem = index
    self.CurChatUid = self.FriendUidList[index]
    local time = _G.TimeUtil.GetServerUnixTime()
    require("FriendManager"):GetInstance():RedDotnil(self.CurChatUid, time)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RecentFriendChat.id)
    require("ChatManager"):GetInstance():GetChatPrivateByUID(self.CurChatUid, _G.handler(self, self.UpdateChatView))
end

