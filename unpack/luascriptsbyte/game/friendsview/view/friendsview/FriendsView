    end
end

function FriendsView:OnStartClose()
    if self.delaySecondHandle ~= nil then
        self.delaySecondHandle:Stop()
        self.delaySecondHandle = nil
    end
    if self.timer ~= nil then
        self.timer:Stop()
        self.timer = nil
    end
end

return FriendsView
