----更新单个聊天信息
function FriendsView:RefreshChatList(listView2, index)
    if index < 0 then
        return
    end
    local t_index = index + 1
    local list = require("ChatManager"):GetInstance():GetChatByUID(self.CurChatUid)
    local CurData = list[self.CurChatList[t_index]]
    local LastData
    local item = nil
    if CurData.is_self == 1 then
        item = listView2:NewListViewItem("$_obj_chatR")
    else
        item = listView2:NewListViewItem("$_obj_chat")
    end
    --end
    if item == nil then
        --(" item==nil ChatView:RefreshItem(listView2, index, chatlooplist)")
        return
    end
    local tb = _G.GetAutoGoTable(item)
    tb.obj_time:SetActiveE(0)
    if index > 1 then
        LastData = list[self.CurChatList[index]]
        local IntervalTime = CurData.time - LastData.time
        if IntervalTime > 180 then
            tb.obj_time:SetActiveE(1)
            local isNowday = _G.TimeUtil.CheckTheSameDay(CurData.time, _G.TimeUtil.GetServerUnixTime())
            local tTime = math.floor(CurData.time)
            local str = ""
            if isNowday then
                str = _G.TimeUtil.date("%H:%M", tTime)
            else
                str = _G.TimeUtil.date("%Y-%m-%d  %H:%M", tTime)
            end
            tb.aortext_info.text = str
        else
            tb.obj_time:SetActiveE(0)
        end
    end

    self:inititem(item, list, self.CurChatList[t_index])
    return item
end

