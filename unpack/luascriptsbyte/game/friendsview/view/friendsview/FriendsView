        self:UpdateAddFriendPanel()
        self:ShowPanel(self.Panels.AddFriend)
    elseif name == "$_toggle_Apply" then
        _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)
        if not isOn or self.curType == TagType.Apply then
            return
        end
        self.curType = TagType.Apply
        self.ShuaXing = true
        self:UpdateApplyListPanel()
        self:ShowPanel(self.Panels.ApplyPanel)
    elseif name == "$_toggle_BlackList" then
        _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)
        if not isOn or self.curType == TagType.Black then
            return
        end
        self.curType = TagType.Black
        self.HeiMingDanShuaXing = true
        self:UpdateBlackListPanel()
        self:ShowPanel(self.Panels.BlackList)
