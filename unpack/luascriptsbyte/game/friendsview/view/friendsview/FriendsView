    elseif name == "$_toggle_Friend" then
        _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)
        self.go_table.aorbtn_way:SetActiveE(isOn and 1 or 0)
        if not isOn or self.curType == TagType.Friend then
