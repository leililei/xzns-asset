function FriendHelpModel:GetEndTime()
    return self.endTime
end

---检测功能是否能使用助战角色
---@param id FriendsHelpType 功能id
function FriendHelpModel:CheckCanUseHelp(id, param, type, uid)
    if not self.infoData then
        return false
    end
    if not type then
        type = 1
        if uid and uid == self.npcSid then
            type = 2
        end
    end
    return self.infoData:CheckCanUse(id, param, type)
end

--region 获取可助战卡牌的卡牌列表(未借入)
---@param call fun() 回调
---@param type number 1所有，2特定卡
---@param roleUid number 角色uid
---@param cardUid number 卡牌uid
function FriendHelpModel:GetHelpCardDatas(call, type, roleUid, cardUid)
    self.isRedPoint = false
    if not self:ChekcOperation() then
        self.HelpDatas = {}
        if call then
            call()
        end
        return
    end
    require "FriendsHelpNet":GetInstance():GetHelpCardInfo(
        {type = type, uid = roleUid, card_uid = cardUid},
        function(msg)
            self:InitHelpCardDatas(msg)
            if call then
                call()
            end
        end
    )
    for k, v in pairs(self.infoData.borrowDatas) do
        _G.PlayerPrefsManager.SetString(Key .. k, _G.tostring(v.cardData.uid))
    end
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FriendsHelpSetupAssistance.id, 0)
end

---初始化助战卡牌数据
---@param msg assist.s2c_assist_resort
function FriendHelpModel:InitHelpCardDatas(msg)
    self.HelpDatas = {}
    if _G.table.isEmptyOrNil(msg.simple) then
        return
    end
    for i = 1, #msg.simple do
        if msg.simple[i].cards then
            for j = 1, #msg.simple[i].cards do
                local data = msg.simple[i].cards[j]
                _G.table.insert(
                    self.HelpDatas,
                    require "HelpSingleData".New(
                        {
                            lend_role = {uid = msg.simple[i].role_uid, name = msg.simple[i].role_name},
                            card = {
                                sid = data.sid,
                                star = data.star,
                                uid = data.card_uid,
                                lv = data.lv,
                                power = data.power
                            },
                            time = {0},
                            apply_num = data.apply_num
                        }
                    )
                )
            end
        end
    end
    local isHave = false
    for _, v in pairs(self:GetApplyData()) do
        isHave = false
        for _, v2 in pairs(self.HelpDatas) do
            if v2.cardData.uid == v.cardData.uid then
                isHave = true
                break
            end
        end
        if not isHave then
            -- self:ApplyHelpCard(v, 2)
            ---@type assist.i_assist
            local data = _G.DeepCopy(v.msg)
            data.resort_role = {{uid = _G.PlayerModel:GetInstance():GetPlayerUid()}}
            _G.table.insert(self.HelpDatas, require "HelpSingleData".New(data))
        end
    end
    for _, v in pairs(self:GetBorrowDatas()) do
        _G.table.insert(self.HelpDatas, v)
    end
end

---更新卡牌信息
---@param data prop.i_card 卡牌数据
---@param maxData CardData 战力最高的卡牌
---@param maxLevel number 共鸣神石上的卡牌等级
function FriendHelpModel:UpdateCardMsg(data)
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    local cardDatas = {}
    for _, value in pairs(cards) do
        table.insert(cardDatas, value)
    end
    _G.table.sort(
        cardDatas,
        function(a, b)
            return a.power > b.power
        end
    )

    local maxGrade = 0
    local maxGradeEquipBar = cardDatas[1].EquipBar
    local maxStreng = 0
    local maxStrengEquipBar = cardDatas[1].EquipBar
    for i = 1, 5 do
        if _G.IsNil(cardDatas[i]) then
            break
        end
        local sumGrade = 0
        local sumStreng = 0
        local equipBar = cardDatas[i].EquipBar
        for j = 1, #equipBar do
            if not _G.table.isEmptyOrNil(equipBar[j]) then
                sumGrade = sumGrade + equipBar[j].Grade
                sumStreng = sumStreng + equipBar[j].streng
            end
        end
        if sumGrade > maxGrade then
            maxGrade = sumGrade
            maxGradeEquipBar = equipBar
        end
        if sumStreng > maxStreng then
            maxStreng = sumStreng
            maxStrengEquipBar = equipBar
        end
    end

    local equipments = {}
    for i = 1, #maxGradeEquipBar do
        if not _G.table.isEmptyOrNil(maxGradeEquipBar[i]) then
            ---@type card_cfg
            local cfg = _G.ConfigManager.card_cfg[data.sid]
            ---@type prop.i_equipment
            local equipData = {}
            ---装备胚子
            equipData.sid = 201000000 + cfg.EquipmentType * 1000 + i * 100 + maxGradeEquipBar[i].Grade
            equipData.uid = 0
            ---装备五行属性
            equipData.element = cfg.Elements
            equipData.reset_element = 0
            ---装备强化
            if not _G.table.isEmptyOrNil(maxStrengEquipBar[i]) then
                equipData.streng = maxStrengEquipBar[i].streng
                equipData.exp = maxStrengEquipBar[i].strengExp
            else
                equipData.streng = 0
                equipData.exp = 0
            end
            --if maxGradeEquipBar[i]:CheckEquipmentBoundSidIsCurCardSid() then
            --    equipData.bound = data.sid
            --end
            _G.table.insert(equipments, equipData)
        end
    end
    ---卡牌星级、魂链等级、饰品、聚灵法阵阵内属性、天赋取对方
    ---卡牌等级
    data.lv = self:GetMaxLevel()
    data.equipments = equipments
end

--region  申请
---(取消)申请助战卡牌
---@param msg HelpSingleData 申请数据
---@param type number  1申请 2取消
---@param call function 回调
function FriendHelpModel:ApplyHelpCard(msg, type, call)
    if not self:ChekcOperation() then
        _G.PopWindowManager:GetInstance():ShowAllTips(4514)
        return
    end
    if type == 1 and self.infoData:CheckIsMaxApply() then
        _G.PopWindowManager:GetInstance():ShowAllTips(100306)
        return
    end
    if type == 1 and self.infoData:CheckIsBorrowMax() then
        _G.PopWindowManager:GetInstance():ShowAllTips(100321)
        return
    end
    require "FriendsHelpNet":GetInstance():ApplyHelpCard(
        {role_uid = msg.lendRole.uid, card_uid = msg.cardData.uid, type = type},
        _G.handlerbind(self, self.ApplyHelpCardCall, msg, type, call)
    )
end

---(取消)申请成功回调
---@param msg public.s2c_common_ack
---@param data HelpSingleData
function FriendHelpModel:ApplyHelpCardCall(msg, data, type, call)
    if msg.ack ~= 1 then
        ---4406无法申请 4514申请已满
        _G.PopWindowManager:GetInstance():ShowAllTips(100308)
        return
    end
    if type == 1 and msg.auto_agree then
        self.infoData:AddApplyWithSingleData(data, _G.TimeUtil.GetServerUnixTime())
        _G.Events:GetInstance():Broadcast(_G.eFriendHelp.BorrowCard, data)
        --申请自动通过
        self:ApplyBorrowCallback(data.cardData.uid, data.lendRole.uid)
        if call then
            call()
        end
    else
        if type == 1 then
            self.infoData:AddApplyWithSingleData(data, _G.TimeUtil.GetServerUnixTime())
        elseif type == 2 then
            self.infoData:RemoveApply(data.cardData.uid)
        elseif type == 3 then
            local pos = self.infoData:RemoveBorrowCardData(data.cardData.uid, data.lendRole.uid)
            for k, v in pairs(self.HelpDatas) do
                if v.cardData.uid == data.cardData.uid then
                    _G.table.remove(self.HelpDatas, k)
                    break
                end
            end
            _G.Events:GetInstance():Broadcast(_G.eFriendHelp.ReturnCard, pos)
        end
        if call then
            call()
        end
        _G.Events:GetInstance():Broadcast(_G.eFriendHelp.BorrowCard, data)
    end
end

