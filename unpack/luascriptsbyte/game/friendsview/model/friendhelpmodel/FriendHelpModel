        _G.PopWindowManager:GetInstance():ShowAllTips(4514)
        return
    end

    require "FriendsHelpNet":GetInstance():SetHelpCard(
        {sets = msg},
        _G.handlerbind(self, self.SetBorrowCardCall, msg, call)
    )
end

---设置助战卡牌
---@param msg public.s2c_common_ack
---@param data assist.i_set[]
function FriendHelpModel:SetBorrowCardCall(msg, data, call)
    if msg.ack ~= 1 then
        return
    end
    for _, v in pairs(data) do
        self.infoData:RemoveSetCard(v.index)
    end
    for _, v in pairs(data) do
        if v.type == 1 then
            self.infoData:AddSetCard(v.index, v.uid)
        end
    end
    if call then
        call()
    end
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.FriendsHelpSetup.id)
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(
        _G.ConfigManager.redpoint_cfg.FriendsHelpSetupSeekhelp.id
    )
end

