---获取卡牌参数
function FriendHelpModel:GetMaxParams()
    ---@type CardData[]
    local datas = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    datas = _G.table.toArray(datas)
    _G.SortList(
        datas,
        function(data)
            return data.power, data.star, data.Grade, data.uid
        end
    )
    ---@type CardData[]
    local chooseCards = {}
    local count = #datas
    if count > 5 then
        count = 5
    end
    for i = 1, count do
        chooseCards[i] = datas[i]
    end
    local param = {
        maxLevel = 0,
        maxStar = 0,
        maxHunLian = 0,
        maxGrade = 0,
        maxStreng = 0,
        maxTF = 0,
        maxDecStreng = 0,
        maxArtifactOrder = 0,
        maxArtifactLevel = 0,
        maxArtifactStar = 0,
        maxArtifactAwaken = 0
    }
    param.maxLevel = self:GetMaxLevel()
    param.hunlianIsActive = false
    local table = _G.table
    for _, v in pairs(chooseCards) do
        -- if param.maxStar == 0 or param.maxStar < v:GetStar() then
        --     param.maxStar = v:GetStar()
        -- end
        if v.soulLink_IsActivate == 1 then
            param.hunlianIsActive = 1
        end
        if param.maxHunLian == 0 or param.maxHunLian < v.soulLink_lv then
            param.maxHunLian = v.soulLink_lv
        end
        if not _G.table.isEmptyOrNil(v.ArtifactBar) then
            if param.maxArtifactOrder <= v.ArtifactBar:GetOrder() then
                if param.maxArtifactOrder == 0 or param.maxArtifactOrder < v.ArtifactBar:GetOrder() then
                    param.maxArtifactOrder = v.ArtifactBar:GetOrder()
                    param.maxArtifactAwaken = v.ArtifactBar:GetAwaken()
                end
                if param.maxArtifactLevel == 0 or param.maxArtifactLevel < v.ArtifactBar:GetLevel() then
                    param.maxArtifactLevel = v.ArtifactBar:GetLevel()
                end
                if param.maxArtifactStar == 0 or param.maxArtifactStar < v.ArtifactBar:GetStar() then
                    param.maxArtifactStar = v.ArtifactBar:GetStar()
                end
            end
        end

        for _, v2 in pairs(v.EquipBar) do
            if not table.isEmptyOrNil(v2) then
                if param.maxGrade < v2.Grade then
                    param.maxGrade = v2.Grade
                end
                local v2str = v2.streng
                if v2str > v2.cfg.strengthen_level then
                    v2str = v2.cfg.strengthen_level
                end
                if param.maxStreng < v2str then
                    param.maxStreng = v2str
                end
            end
        end
        for _, v2 in pairs(v.DecorationBar) do
            if not table.isEmptyOrNil(v2) and v2.streng then
                if param.maxDecStreng < v2.streng then
                    param.maxDecStreng = v2.streng
                end
                param.isDec = true
            end
        end
        if v.open_inborn and param.maxTF < #v.open_inborn then
            param.maxTF = #v.open_inborn
        end
    end
    param.maxStar = require("IllustrationModel"):GetInstance():GetAllCardMaxStar()
    return param, chooseCards[1]
end

