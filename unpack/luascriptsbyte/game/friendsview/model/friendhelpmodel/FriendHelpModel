function FriendHelpModel:GetGarrayCall(msg)
    self.garrayList = {}
    for _, v in pairs(msg.garrays) do
        self.garrayList[v.id] = v
    end
end

---刷新红点
function FriendHelpModel:InitRedPoint()
    self.isRedPoint = false
    if not self.HelpDatas or not self:ChekcOperation() then
        for k, v in pairs(self.infoData.borrowDatas) do
            local uid = _G.tonumber(_G.PlayerPrefsManager.GetString(Key .. k))
            if v.cardData.uid > 0 and v.cardData.uid ~= uid then
                self.isRedPoint = true
                break
            end
        end
    end
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.FriendsHelpSetup.id)
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(
        _G.ConfigManager.redpoint_cfg.FriendsHelpSetupSeekhelp.id
    )
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(
        _G.ConfigManager.redpoint_cfg.FriendsHelpSetupAdministration.id
    )
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(
        _G.ConfigManager.redpoint_cfg.FriendsHelpSetupAssistance.id
    )
end

---显示红点（周一统一刷新后显示
function FriendHelpModel:WeekRed()
    local time = _G.PlayerPrefsManager.GetInt("FriendHelpModelWeekRed")
    if time == nil or time == 0 then
        return true
    end
    if _G.TimeUtil.GetServerUnixTime() >= time then
        return true
    end
    return false
end

---红点刷新时间写入
function FriendHelpModel:SetWeekRed()
    local endTime
    local time = _G.TimeUtil.GetServerUnixTime()
    local data = _G.TimeUtil.GetDateTime(time)
    local params = _G.ConfigManager.discrete_cfg[106413][1]
    local duration = _G.ConfigManager.discrete_cfg[106403][1][1] * 86400
    data.week = data.week == 0 and 7 or data.week
    if data.week > 1 then
        endTime = _G.TimeUtil.GetDayBegin(time) - ((data.week - 1) * 86400) + params[1] * 3600 + duration
    else
        endTime = _G.TimeUtil.GetDayBegin(time) - math.abs(6 + data.week) * 86400 + params[1] * 3600 + duration
    end
    if endTime <= time then
        endTime = _G.TimeUtil.GetDayBegin(time) + params[1] * 3600 + duration
    end
    _G.PlayerPrefsManager.SetInt("FriendHelpModelWeekRed", endTime)
end

---初始化归还倒计时
function FriendHelpModel:InitTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    local time = _G.TimeUtil.GetServerUnixTime()
    local data = _G.TimeUtil.GetDateTime(time)
    local params = _G.ConfigManager.discrete_cfg[106413][1]
    local duration = _G.ConfigManager.discrete_cfg[106403][1][1] * 86400
    data.week = data.week == 0 and 7 or data.week
    if data.week > 1 then
        self.endTime = _G.TimeUtil.GetDayBegin(time) - ((data.week - 1) * 86400) + params[1] * 3600 + duration
    else
        self.endTime = _G.TimeUtil.GetDayBegin(time) - math.abs(6 + data.week) * 86400 + params[1] * 3600 + duration
    end
    if self.endTime <= time then
        self.endTime = _G.TimeUtil.GetDayBegin(time) + params[1] * 3600 + duration
    end

    local offset = self.endTime - time + 2
    -- if time < settleTime and time < self.endTime then
    --     offset = settleTime - time
    -- end
    self.timer = _G.TimerManager:GetInstance():GetTimer(offset, self.OnTimeOver, self, true, false, true)
    self.timer:Start()
end

---归还计时结束
function FriendHelpModel:OnTimeOver()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.timeOver = true
    self:GetInfo()
    self:SetWeekRed()
    --require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FriendsHelpSetupRefresh.id, 0)
end

---初始化设置卡牌
function FriendHelpModel:InitSetCard(call)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.FriendHelp) then
        return
    end
    ---@type CardData[]
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    local lowStar = _G.ConfigManager.discrete_cfg[106402][1][1]
    ---@param v CardData
    local cardDatas =
        _G.table.chooseToArray(
        cards,
        function(_, v)
            return v.star >= lowStar
        end
    )
    _G.table.sort(
        cardDatas,
        function(a, b)
            return a.power > b.power
        end
    )
    local sets = {}
    for i = 1, 5 do
        if cardDatas[i] then
            sets[i] = {uid = cardDatas[i].uid, type = 1, index = i}
        else
            break
        end
    end
    self:SetBorrowCard(sets, call)
end

