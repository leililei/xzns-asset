end

---保存布阵
---@param id number 布阵id
---@param garray number[] 阵容
function FriendHelpModel:SaveGarray(id, garray, call)
    if not self.infoData then
        if call then
            call()
        end
        return
    end
    self.UseAssist = false
    for k, v in pairs(garray) do
        if v ~= 0 then
            self.UseAssist = true
            break
        end
    end
    require "FriendsHelpNet":GetInstance():SaveGarray(
        {garrays = {{id = id, sits = garray, skill_index = {0, 0, 0}, pet = { 0, 0, 0 }}}},
        function(msg)
            if msg.ack ~= 1 then
                if call then
                    call()
                end
