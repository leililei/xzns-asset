        function(msg)
            if self.infoData then
                self.infoData.auto_agree = not self.infoData.auto_agree
            end
            if call then
                call()
            end
        end
    )
end

---是否开启npc助战()
---@private
---@param type number   @1.AFK冒险 2.死魂塔 3.死魂塔试炼
---@param checkFunctionOpen boolean 额外检查功能是否已开启
function FriendHelpModel:CheckNpcConditions(type, checkFunctionOpen)
    if checkFunctionOpen and (not self.infoData or not self.infoData:CheckNpcOpen()) then
        return false
    end
    local params =
        type == 1 and self.npcConditionsOfAfk or type == 2 and self.npcConditionsOfDeadsoulTower1 or
        type == 3 and self.npcConditionsOfDeadsoulTower2
    if not params then
        return false
    end

    for _, condition in pairs(params) do
        if not _G.GlobalConditionManager.CheckCondition(condition[1], condition[2]) then
            return false
        end
    end
    return true
end

return FriendHelpModel
