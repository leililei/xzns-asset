---开启npc助战
---@param type boolean 助战提示仅播一次 在准备提示时传true标记播放
---@param npcType number   @1.AFK冒险 2.死魂塔 3.死魂塔试炼
function FriendHelpModel:OpenNpc(callback, type, npcType)
    if not self.infoData then
        return
    end
    if not self:CheckNpcConditions(npcType or 1, false) then
        return
    end
    if type then
        if self.infoData:CheckNpcHasOpen() then
            return
        end
    else
        if self.infoData:CheckNpcOpen() then
            return
        end
    end
    require "FriendsHelpNet":GetInstance():OpenNpc(
        function(msg)
            if msg.ack ~= 1 then
                if callback then
                    callback()
                end
                return
            end
            --助战提示仅播一次 在准备提示时传true标记播放
            if type then
                self.infoData.isOpenNpc = true
            else
                self.infoData.npcOpen = true
            end
            if callback then
                callback()
            end
        end
    )
end

