---获取Info回调
function FriendHelpModel:GetInfoCall(msg)
    if not self.infoData then
        self.infoData = require "FriendHelpInfoData".New(msg)
    else
        self.infoData:Parse(msg)
    end
    self:InitTimer()
    self.isOpen = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.FriendHelp)
    if not self.isOpen and not self.addFunctionListener then
        self.addFunctionListener = true
        _G.Events:GetInstance():AddListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.OnFunctionOpenCall, self)
    end
    if self.isReconnect then
        self:InitSetCard()
    end
    if self.timeOver or self.isReconnect then
        self.timeOver = false
        self.isReconnect = false
        _G.Events:GetInstance():Broadcast(_G.eFriendHelp.TimeOver)
    end
    self:ParseData()
    self:InitRedPoint()
end

