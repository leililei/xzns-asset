---处理其他玩家申请回调
---@param msg assist.s2c_assist_apply 返回值
---@param data assist.i_apply[]
---@param call fun() 回调
function FriendHelpModel:DealResortCall(msg, data, call)
    if msg.ack ~= 1 then
        return
    end
    if msg.reply then
        local isSingle = #data == 1
        for _, v in pairs(data) do
            for _, v2 in pairs(msg.reply) do
                if v2.card_uid == v.card_uid and v.role_uid == v2.role_uid then
                    if v.type == 1 then
                        if v2.type == 1 then
                            self.infoData:ApplyResort(v.card_uid, v.role_uid)
                            if v2.award then
                                _G.StorageManager:GetInstance():ReceiveAwardData(v2)
                            end
                        else
                            self.infoData:RefuseResort(v.card_uid, v.role_uid)
                            if isSingle then
                                if v2.type == 4507 then
                                    _G.PopWindowManager:GetInstance():ShowAllTips(100310)
                                else
                                    _G.PopWindowManager:GetInstance():ShowAllTips(100308)
                                end
                            end
                        end
                    else
                        self.infoData:RefuseResort(v.card_uid, v.role_uid)
                    end
                    break
                end
            end
        end
    end

    if call then
        call()
    end
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(
        _G.ConfigManager.redpoint_cfg.FriendsHelpSetupSeekhelp.id
    )
end

