---同意借出卡牌
---@param msg assist.p2c_assist_agree
function FriendHelpModel:P2CAgreeBorrow(msg)
    if msg.type == 1 then
        self:ApplyBorrowCallback(msg.card_uid, msg.role_uid)
    elseif msg.type == 2 then
        if self.HelpDatas then
            for k, v in pairs(self.HelpDatas) do
                if v.cardData.uid == msg.card_uid and v.lendRole.uid == msg.role_uid then
                    _G.table.remove(self.HelpDatas, k)
                    break
                end
            end
        end
        self.infoData:RemoveApply(msg.card_uid)
        _G.Events:GetInstance():Broadcast(_G.eFriendHelp.UnPutCard, msg)
    end
end

---申请自动通过回调
function FriendHelpModel:ApplyBorrowCallback(card_uid, role_uid)
    if self.HelpDatas then
        for _, v in pairs(self.HelpDatas) do
            if v.cardData.uid == card_uid and v.lendRole.uid == role_uid then
                v.browRole = {uid = _G.PlayerModel:GetInstance():GetPlayerUid()}
                break
            end
        end
    else
        self.isRedPoint = true
    end
    require "FriendsHelpNet":GetInstance():GetInfo(
        function(data)
            if data.ack ~= 1 then
                return
            end
            local assist
            for _, v in pairs(data.borrow) do
                if v.lend_role.uid == role_uid and v.card.uid == card_uid then
                    assist = v
                    break
                end
            end
            if assist then
                local pos = self.infoData:AddBorrowCardData(card_uid, assist)
                _G.Events:GetInstance():Broadcast(_G.eFriendHelp.AgreeBorrow, pos)
                require "RedPointManager":GetInstance():RefreshNode(
                    _G.ConfigManager.redpoint_cfg.FriendsHelpSetupAssistance.id,
                    0
                )
            end
        end
    )
end

---其他玩家申请借入卡牌
---@param msg assist.p2c_assist_resort
function FriendHelpModel:P2CResort(msg)
    local data
    if msg.type == 1 then
        if self.infoData:CheckIsMaxResort() then
            return
        end
        self.infoData:AddResort(msg.resort)
    elseif msg.type == 4 then
        --此处服务器发的i_assist里面没有card数据，他们硬是不发，不想再讲了，重拉数据
        require "FriendsHelpNet":GetInstance():GetInfo(
            function(data)
                if data.ack ~= 1 then
                    return
                end
                self.infoData:InitLendCardDatas(data.lend)
                self.infoData:InitPoint(data.point)
                _G.Events:GetInstance():Broadcast(_G.eFriendHelp.AgreeResort)
            end
        )
        if msg.award then
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
        end
    else
        self.infoData:RemoveResort(msg.role_uid, msg.card_uid)
    end
    _G.Events:GetInstance():Broadcast(_G.eFriendHelp.Resort)
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(
        _G.ConfigManager.redpoint_cfg.FriendsHelpSetupSeekhelp.id
    )
end

