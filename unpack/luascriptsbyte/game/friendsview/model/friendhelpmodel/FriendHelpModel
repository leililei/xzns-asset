---是否存在助战NPC
---@private
---@param fightArgs? fight.i_fight_arg[] @战报数据(如不传则取C#统计数据)
---@return boolean,number   是否存在助战, 借用类型
function FriendHelpModel:HasBorrowCard(fightArgs)
    local isAssist = false
    local type = 1

    local npcId = self.npcSid
    if fightArgs and #fightArgs > 0 then
        --从战报数据中判断是否存在助战角色
        ---@param fightArg fight.i_fight_arg
        for _, fightArg in pairs(fightArgs) do
            for _, teamData in pairs(fightArg.attacker_team) do
                for _, fightData in pairs(teamData.fights) do
                    if self:CheckIsBorrowCard(fightData.uid) then
                        isAssist = true
                        break
                    end
                    if fightData.sid == npcId and fightData.uid == npcId * 10 then
                        isAssist = true
                        type = 2
                        break
                    end
                end
            end
        end
    else
        --从C#拉取统计数据, 判断是否存在助战
        local statistics = _G.BattleManager:GetInstance():GetStatistics()
        for _, v in pairs(statistics.FighterInfo) do
            for _, v2 in pairs(v.Attacker) do
                if self:CheckIsBorrowCard(v2.Uid) then
                    isAssist = true
                    break
                end
                if v2.Sid == npcId and v2.Uid == npcId * 10 then
                    isAssist = true
                    type = 2
                    break
                end
            end
        end
    end
    return isAssist, type
end

