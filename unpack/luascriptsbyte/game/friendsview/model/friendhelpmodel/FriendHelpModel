---生成卡牌数据
function FriendHelpModel:CreateCardDatas(sid)
    ---@type prop.i_card
    local msg = {}
    msg.sid = sid
    msg.uid = msg.sid

    local params, maxData = self:GetMaxParams()
    msg.lv = params.maxLevel
    msg.soul_chain_lv = params.maxHunLian
    msg.soul_state = params.hunlianIsActive
    ---@type card_cfg
    local cfg = _G.ConfigManager.card_cfg[msg.sid]
    params.maxStar = _G.Mathf.Max(params.maxStar, cfg.Star)
    msg.star = cfg.Star > params.maxStar and cfg.Star or params.maxStar
    msg.open_inborn = {}
    if params.maxTF > 0 then
        local index = 0
        for i = 1, #cfg.talent do
            for j = 1, #cfg.talent[i] do
                index = index + 1
                msg.open_inborn[index] = cfg.talent[i][j]
                if index >= params.maxTF then
                    break
                end
            end
            if index >= params.maxTF then
                break
            end
        end
    end
    msg.big_born_num = require("CardInfoManager"):GetInstance():GetTalentsNumByInborn(msg.open_inborn)

    local tb = {}
    if params.maxGrade > 0 then
        for i = 1, #maxData.EquipBar do
            if i ~= 3 then
                ---@type prop.i_equipment
                local data2 = {}
                data2.sid = 201000000 + params.maxGrade + cfg.EquipmentType * 1000 + i * 100
                data2.uid = 0
                data2.streng = params.maxStreng
                data2.exp = 0
                data2.element = cfg.Elements
                -- if maxData.EquipBar[i]:CheckEquipmentBoundSidIsCurCardSid() then
                --     data2.bound = msg.sid
                -- end
                data2.reset_element = 0
                _G.table.insert(tb, data2)
            end
        end
    end
    local decTb = {}
    if params.isDec then
        local tempDecTb = {}
        for i, v in pairs(_G.ConfigManager.monster_dungeons_cfg) do
            if v.min_level <= params.maxLevel and v.max_level >= params.maxLevel then
                tempDecTb = v.decoration_pools[cfg.Professional]
                break
            end
        end
        if not _G.table.isEmptyOrNil(tempDecTb) then
            for i = 1, #maxData.DecorationBar do
                ---@type prop.i_equipment
                local data2 = {}
                data2.sid = tempDecTb[i]
                data2.uid = 0
                data2.level = params.maxDecStreng
                data2.exp = 0
                data2.resonance_sid = 0
                data2.resonance = 0
                data2.lock = 0
                _G.table.insert(decTb, data2)
            end
        end
    end
    local artifactTb = {}
    if params.maxArtifactOrder > 0 then
        local artifact = {
            sid = 255000000 + params.maxArtifactOrder * 100000 + cfg.Professional * 10000 + 100,
            uid = 0,
            num = 1,
            level = params.maxArtifactLevel,
            star = params.maxArtifactStar,
            awaken = params.maxArtifactAwaken
        }
        _G.table.insert(artifactTb, artifact)
    end
    local lv = 0
    local count = 0
    for _, v in pairs(_G.PlayerTreeID) do
        if v ~= _G.PlayerTreeID.none or v ~= _G.PlayerTreeID.mainTree then
            lv = lv + require("PlayerTreeModel"):GetInstance():GetLv(v)
            count = count + 1
        end
    end
    lv = _G.Mathf.RoundToInt(lv / count)
    msg.equipments = tb
    msg.decoration = decTb
    msg.artifact = artifactTb
    ---@type HelpNpcCardData
    local data = require "HelpNpcCardData".New()
    data:Parse(msg)
    data:OnInitMutuallyData(true)
    data:SetBranchLv(lv)
    return data
end

