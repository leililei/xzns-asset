local HelpUseInfoData = require "HelpUseInfoData"
local HelpSingleData = require "HelpSingleData"
---@class FriendHelpInfoData	中文描述
---@field lendDatas HelpSingleData[] 借出信息
---@field apply table<number,HelpSingleData> 申请信息 number 卡牌Uid
---@field borrowDatas table<number,HelpSingleData> 借入信息 number 下标
---@field borrowUids number[] 卡牌uids
---@field point number 友情点
---@field lendCardUids boolean[] 借出卡牌Uids
---@field useInfo table<EmbattleType,table<number,HelpUseInfoData>> 使用信息
---@field setCardUids table<number,number>[] 设置的卡牌
---@field setInfo HelpSetInfoData[] 设置卡牌信息
---@field resortDatas HelpSingleData[] 其他玩家的申请
local FriendHelpInfoData = _G.BaseClass("FriendHelpInfoData")

local maxUseCountTb = {
    [_G.EmbattleType.Tower] = _G.ConfigManager.discrete_cfg[106405][1][1],
    [_G.EmbattleType.Tower1] = _G.ConfigManager.discrete_cfg[106406][1][1],
    [_G.EmbattleType.Tower2] = _G.ConfigManager.discrete_cfg[106406][1][1],
    [_G.EmbattleType.Tower3] = _G.ConfigManager.discrete_cfg[106406][1][1],
    [_G.EmbattleType.Tower4] = _G.ConfigManager.discrete_cfg[106406][1][1],
    [_G.EmbattleType.Tower5] = _G.ConfigManager.discrete_cfg[106406][1][1],
    [_G.EmbattleType.AFKOnly] = _G.ConfigManager.discrete_cfg[106407][1][1]
}
local npcCount = _G.ConfigManager.discrete_cfg[106420][1][1]
---类的构造函数
function FriendHelpInfoData:__init(data)
    self.maxApply = _G.ConfigManager.discrete_cfg[106411][1][1]
    self.maxResort = _G.ConfigManager.discrete_cfg[106414][1][1]
    self.maxPoint = _G.ConfigManager.discrete_cfg[106409][1][1]
    self:Parse(data)
end

---类的析构函数
function FriendHelpInfoData:Dispose()
    self.lendDatas = {}
    self.lendCardUids = {}
    self.borrowDatas = {}
    self.resortDatas = {}
end
---解析数据
---@param data assist.s2c_assist_info
function FriendHelpInfoData:Parse(data)
    if not data then
        return
    end
    self.npcOpen = data.npc_open >= 1
    self.isOpenNpc = data.npc_open == 2
    ---是否已经提示过助战
    self.isAssist = data.assist_bool == 1
    self.auto_agree = data.auto_agree == 1
    self.point = data.point
    self:InitResort(data.resort)
    self:InitUseInfo(data.use_info)
    self:InitApply(data.apply)
    self:InitLendCardDatas(data.lend)
    self:InitBorrowCardDatas(data.borrow)
    self:InitSetInfo(data.set)
end
--region 借出
---初始化借出的卡牌信息
---@param msg assist.i_assist[] 借出数据
function FriendHelpInfoData:InitLendCardDatas(msg)
    self.lendCardDatas = {}
    self.lendCardUids = {}
    if not msg then
        return
    end
    local count = #msg
    for i = 1, count do
        self:AddLendData(msg[i])
    end
end

---初始化友情点
function FriendHelpInfoData:InitPoint(point)
    self.point = point
end

---增加借出数据
---@param msg assist.i_assist
function FriendHelpInfoData:AddLendData(msg)
    local singleData = HelpSingleData.New(msg)
    _G.table.insert(self.lendCardDatas, singleData)
    self.lendCardUids[msg.card.uid] = true
end

---增加借出数据
---@param singleData HelpSingleData
function FriendHelpInfoData:AddLendDataWithSingleData(singleData)
    _G.table.insert(self.lendCardDatas, singleData)
    self.lendCardUids[singleData.cardData.uid] = true
end

---检测是否借出
---@param cardUid number 卡牌uid
function FriendHelpInfoData:CheckIsLend(cardUid)
    return self.lendCardUids[cardUid]
end

--endregion
---初始化借入入卡牌信息
---@param msg assist.i_assist[] 接入数据
function FriendHelpInfoData:InitBorrowCardDatas(msg)
    self.borrowDatas = {}
    self.borrowUids = {}
    if _G.IsNil(msg) then
        return
    end
    local count = #msg
    for i = 1, count do
        if msg[i].borrow_role == nil then
            msg[i].borrow_role = {name = _G.PlayerModel:GetInstance():GetName()}
        end
        local singleData = HelpSingleData.New(msg[i])
        self.borrowDatas[msg[i].index] = singleData
        self.borrowUids[msg[i].card.uid] = true
    end
end

---增加卡牌借入信息
---@param cardUid number
---@return number
function FriendHelpInfoData:AddBorrowCardData(cardUid, data)
    if not self.apply[cardUid] then
        return
    end
    if data then
        self.apply[cardUid].msg = data
    end
    ---@type assist.i_assist
    local msg = _G.DeepCopy(self.apply[cardUid].msg)
    if msg.borrow_role == nil then
        msg.borrow_role = {name = _G.PlayerModel:GetInstance():GetName()}
    end
    for i = 1, 3 do
        if _G.IsNil(self.borrowDatas[i]) then
            self.borrowDatas[i] = HelpSingleData.New(msg)
            self.borrowUids[cardUid] = true
            self:RemoveApply(cardUid)
            return i
        end
    end
end

---归还卡牌
function FriendHelpInfoData:RemoveBorrowCardData(cardUid, roleUid)
    for k, v in pairs(self.borrowDatas) do
        if v.lendRole.uid == roleUid and v.cardData.uid == cardUid then
            self.borrowDatas[k] = nil
            self.borrowUids[v.cardData.uid] = nil
            return k
        end
    end
end
--endregion

--region 申请
---初始化卡牌申请
---@param msg assist.i_assist[]
function FriendHelpInfoData:InitApply(msg)
    self.apply = {}
    if _G.IsNil(msg) then
        return
    end

    local count = #msg
    for i = 1, count do
        self:AddApply(msg[i])
    end
end

---增加申请卡牌借入
---@param msg assist.i_assist 申请数据
---@param time number 时间戳
function FriendHelpInfoData:AddApply(msg, time)
    if self:CheckIsMaxApply() then
        return
    end
    local singleData = HelpSingleData.New(msg)
    self.apply[msg.card.uid] = singleData
    if _G.IsNil(time) then
        singleData:SetTime(time)
    end
end

---增加申请卡牌借入
---@param data HelpSingleData 申请数据
---@param time number 时间戳
function FriendHelpInfoData:AddApplyWithSingleData(data, time)
    self.apply[data.cardData.uid] = data
    if _G.IsNil(time) then
        data:SetTime(time)
    end
end

---移出申请借入
---@param cardUid number 卡牌uid
function FriendHelpInfoData:RemoveApply(cardUid)
    self.apply[cardUid] = nil
end

---检测是否申请
---@param cardUid number 卡牌uid
function FriendHelpInfoData:CheckIsApply(cardUid)
    return not _G.IsNil(self.apply[cardUid])
end
--endregion

---检测申请是否达到上限
---@return boolean
function FriendHelpInfoData:CheckIsMaxApply()
    return _G.table.count(self.apply) >= self.maxApply
end

--region 使用信息
---初始化使用信息
---@param msg assist.i_use[]
function FriendHelpInfoData:InitUseInfo(msg)
    if self.useInfo then
        ---防止重连问题
        if require "FriendHelpModel":GetInstance().isReconnect and not _G.IsNil(msg) then
            return
        end
    end
    self.useInfo = {{}, {}}
    if _G.IsNil(msg) then
        return
    end
    for _, v in pairs(msg) do
        self:AddUseData(v.k, v.v, v.param, v.t)
    end
end

---检测是否能上阵助战卡牌
---@param id FriendsHelpType 功能类型
---@param param number 其他参数
function FriendHelpInfoData:CheckCanUse(id, param, type)
    if _G.IsNil(param) then
        param = 1
    end
    if not type then
        type = 1
    end
    if _G.IsNil(self.useInfo[type][id]) or _G.IsNil(self.useInfo[type][id][param]) then
        return true
    end
    return not self.useInfo[type][id][param]:CheckIsMax()
end
---获取最大使用数量
---@param id number 功能类型
function FriendHelpInfoData:GetMaxUseCount(id, isNpc)
    if isNpc then
        return npcCount
    else
        return maxUseCountTb[id]
    end
end
---获取已使用次数
function FriendHelpInfoData:GetUseCount(id, param, type)
    if not self.useInfo or not self.useInfo[type] or not self.useInfo[type][id] then
        return 0
    end
    if _G.table.isEmptyOrNil(param) then
        return self.useInfo[type][id][1] and self.useInfo[type][id][1]:GetCount() or 0
    else
        return self.useInfo[type][id][param[1]] and self.useInfo[type][id][param[1]]:GetCount() or 0
    end
end

---增加助战卡牌信息
---@param id FriendsHelpType 使用类型
---@field count number  使用此时
---@field param number 其他参数
function FriendHelpInfoData:AddUseData(id, count, param, type)
    if not self.useInfo[type][id] then
        self.useInfo[type][id] = {}
    end
    local msg = {k = id, v = count or 1, param = param}
    local maxcount = type == 2 and npcCount or (maxUseCountTb[id] or 1)
    if _G.table.isEmptyOrNil(param) then
        self.useInfo[type][id][1] = HelpUseInfoData.New(msg, maxcount)
    else
        self.useInfo[type][id][param[1]] = HelpUseInfoData.New(msg, maxcount)
    end
end
---增加使用次数
---@param id number 布阵id
---@param param number 其他参数
function FriendHelpInfoData:AddUseCount(id, param, type)
    local data = self:GetHelpUseInfoData(id, param, type)
    data:AddUseCount()
end
---增加临时使用次数
---@param id number 布阵id
---@param param number 其他参数
function FriendHelpInfoData:AddTempCount(id, param, type)
    local data = self:GetHelpUseInfoData(id, param, type)
    data:AddTempCount()
end
---移除临时使用次数
---@return void
function FriendHelpInfoData:RemoveTempCount()
    ---@type HelpUseInfoData[][][]
    local lst = self.useInfo
    for _, v1 in pairs(lst) do
        for _, v2 in pairs(v1) do
            for _, v3 in pairs(v2) do
                v3:RemoveTempCount()
            end
        end
    end
end
---应用临时使用次数至永久次数
---@return void
function FriendHelpInfoData:ApplyTempCount()
    ---@type HelpUseInfoData[][][]
    local lst = self.useInfo
    for _, v1 in pairs(lst) do
        for _, v2 in pairs(v1) do
            for _, v3 in pairs(v2) do
                v3:ApplyTempCount()
            end
        end
    end
end

---获取或创建HelpUseInfoData实例
---@private
---@param id number 布阵id
---@param param number 其他参数
---@return HelpUseInfoData
function FriendHelpInfoData:GetHelpUseInfoData(id, param, type)
    if not self.useInfo[type] then
        self.useInfo[type] = {}
    end
    if not self.useInfo[type][id] then
        self.useInfo[type][id] = {}
    end
    if _G.IsNil(param) then
        param = 1
    end
    if not self.useInfo[type][id][param] then
        local msg = {k = id, v = 0}
        local maxcount = type == 1 and npcCount or (maxUseCountTb[id] or 1)
        self.useInfo[type][id][param] = HelpUseInfoData.New(msg, maxcount)
    end
    return self.useInfo[type][id][param]
end
--endregion

--region 设置卡牌
---初始化设置的卡牌信息
---@param msg assist.i_set[]
function FriendHelpInfoData:InitSetInfo(msg)
    self.setInfo = {}
    self.setCardUids = {}
    if _G.table.isEmptyOrNil(msg) then
        return
    end
    for _, v in pairs(msg) do
        self:AddSetCard(v.index, v.uid)
    end
end
---@field isLend boolean 是否借出
---@field CardData CardData 卡牌信息
---@class HelpSetInfoData

---添加助战卡牌信息
---@param cardUid number 卡牌uid
---@param index number 卡牌槽位
function FriendHelpInfoData:AddSetCard(index, cardUid)
    self.setInfo[index] = {
        CardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, cardUid),
        isLend = self:CheckIsLend(cardUid)
    }
    self.setCardUids[cardUid] = index
end

---移除助战卡牌
---@param index number 卡牌槽位
function FriendHelpInfoData:RemoveSetCard(index)
    if _G.IsNil(self.setInfo[index]) then
        return
    end
    self:RemoveResortWithCardUid(self.setInfo[index].CardData.uid)
    self.setCardUids[self.setInfo[index].CardData.uid] = nil
    self.setInfo[index] = nil
end
--endregion

--region 处理其他玩家申请

---处理其他玩家申请
---@param msg assist.i_assist[]
function FriendHelpInfoData:InitResort(msg)
    self.resortDatas = {}
    if _G.IsNil(msg) then
        return
    end
    for i = 1, #msg do
        self:AddResort(msg[i])
    end
end

---添加其他玩家申请
---@param msg assist.i_assist 申请数据
---@return HelpSingleData
function FriendHelpInfoData:AddResort(msg)
    for i = 1, #msg.resort_role do
        local singleData =
            HelpSingleData.New(
            {
                borrow_role = msg.borrow_role,
                card = msg.card,
                lend_role = msg.lend_role,
                resort_role = {msg.resort_role[i]},
                index = msg.index,
                time = {msg.time[i]}
            }
        )
        _G.table.insert(self.resortDatas, singleData)
    end
end
---检测是否为最大申请
function FriendHelpInfoData:CheckIsMaxResort()
    return #self.resortDatas >= self.maxResort
end

---移除其他玩家申请
---@param roleUid number 申请人uid
---@param cardUid number 卡牌uid
function FriendHelpInfoData:RemoveResort(roleUid, cardUid)
    for k, v in pairs(self.resortDatas) do
        if v.resortRole[1].uid == roleUid and v.cardData.uid == cardUid then
            _G.table.remove(self.resortDatas, k)
            break
        end
    end
end

---移除其他玩家申请
---@param cardUid number 卡牌uid
function FriendHelpInfoData:RemoveResortWithCardUid(cardUid)
    ---@param v HelpSingleData
    self.resortDatas =
        _G.table.chooseToArray(
        self.resortDatas,
        function(_, v)
            return v.cardData.uid ~= cardUid
        end
    )
end

---同意其他玩家申请
---@param roleUid number 角色uid
---@param cardUid number 卡牌Uid
function FriendHelpInfoData:ApplyResort(cardUid, roleUid)
    for _, v in pairs(self.resortDatas) do
        if v.cardData.uid == cardUid and v.resortRole[1].uid == roleUid then
            v.browRole = v.resortRole[1]
            self:AddLendDataWithSingleData(v)
            break
        end
    end
    ---@param v HelpSingleData
    self.resortDatas =
        _G.table.chooseToArray(
        self.resortDatas,
        function(_, v)
            return v.cardData.uid ~= cardUid
        end
    )
    self.point = _G.math.min(self.point + _G.ConfigManager.discrete_cfg[106408][1][1], self.maxPoint)
    _G.Events:GetInstance():Broadcast(_G.eFriendHelp.AgreeResort)
end

---拒绝其他玩家申请
---@param cardUid number 卡牌Uid
---@param roleUid number 角色Uid
function FriendHelpInfoData:RefuseResort(cardUid, roleUid)
    for k, v in pairs(self.resortDatas) do
        if v.cardData.uid == cardUid and v.resortRole[1].uid == roleUid then
            _G.table.remove(self.resortDatas, k)
            break
        end
    end
end
---刷新借入卡牌数据
function FriendHelpInfoData:RefreshBorrowDatas()
    for _, v in pairs(self.borrowDatas) do
        v:UpdateCardData()
    end
end
---检测npc助战是否开启
function FriendHelpInfoData:CheckNpcOpen()
    return self.npcOpen
end
---检测npc助战是否需要标记
function FriendHelpInfoData:CheckNpcHasOpen()
    return self.isOpenNpc
end
---检测是否已经达到借入上限
function FriendHelpInfoData:CheckIsBorrowMax()
    for i = 1, 3 do
        if not self.borrowDatas[i] then
            return false
        end
    end
    return true
end
return FriendHelpInfoData
