local GeatherSoulArrayModel = require("GeatherSoulArrayModel")

local base = require "CardData"
local equipmentImte = require "FriendHelpEquipmenItem"
---@class HelpCardData : CardData
local HelpCardData = _G.BaseClass("HelpCardData", base)

function HelpCardData:SaveEquipmentData(msg)
    if msg == nil then
        return
    end
    if msg.equipments == nil then
        return
    end
    local equips = msg.equipments
    local cfg = _G.ConfigManager.equipment_cfg
    ---身上装备不在入库
    -- local equipList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Equipment)
    local equip
    for i = 1, #equips do
        equip = equipmentImte.New()
        equip:Parse(equips[i])
        equip:PutEquip(self.uid, self.cfg.Elements_new, true)
        ---处理未选择的随机属性
        equip:SelectReset(equips[i])
        equip:SelectResetElement(equips[i])

        self.EquipBar[cfg[equip.sid].parts] = equip
        -- equipList[equip.uid] = equip
    end
end

---计算 卡牌 当前属性(重写单独处理聚灵法阵)
function HelpCardData:CalcNowSumProp()
    --     （∑基础属性数值）*（1+∑基础属性数值百分比）+∑各处数值
    -- 目前基础属性=（卡牌升级升星属性+共鸣神石属性+装备基础属性+装备强化属性）

    --- 获取共鸣神石等级
    self.lv = self:GetLevel()
    self:UpdateAttr()
    self.NowSumProp:OnInit(self.cfg.Elements)
    local attributeManager = _G.AttributeClassManager:GetInstance()

    local attr = attributeManager:GetAttribtueClass(self.cfg.Elements)
    ---装备属性
    local euqipAttr = self:GetEquipPropValueAll()
    ---神器属性
    local ChangeArtifactAttr = self:GetArtifactAttribute()
    ---神器图鉴属性
    local ChangeArtifactIllAttr = require("ArtifactIllustrationModel"):GetInstance():GetillAttr()
    ---灵契属性
    local ChangeSpiritualAttr
    ---灵契图鉴属性
    local ChangeSpiritualIllAttr
    if not _G.AppSetting.IsOverseas then
        ChangeSpiritualAttr = self:GetSpiritualAttribute()
        ChangeSpiritualIllAttr = require("SpiritualIllustrationModel"):GetInstance():GetillAttr()
    end
    ---职业树属性
    local TreeAttr = require("PlayerTreeModel"):GetInstance():GetGrowProp(self:GetProfessional())
    ---营地（灵珠）
    local campAttr =
        require("CampsiteModel"):GetInstance():GetCampOneAttribute(self.campid, self.Grade, self:GetCampStar())
    local hellAttr = require("HellRoadModel"):GetInstance():GetAllAttr()
    ---称号和光环
    local titleAndHaloAttr = _G.SystemSettingManager:GetInstance():GetTitleAndHaloAttribute()
    ---合击技
    local combineAttr = require "CombineModel":GetInstance():GetAllAttribute()
    ---羁绊
    local fetterAttr = require "CardFetterManager":GetInstance():GetCardActiveAttr(self.sid)
    --阵法
    local geatherSoulAttrOnce
    local geatherSoulAttr
    if self.msg.formation then
        geatherSoulAttr = self:CalGeatherSoulAttr()
    else
        --阵法全队
        geatherSoulAttrOnce = GeatherSoulArrayModel:GetInstance():GetAllAttrByOnce()
        geatherSoulAttr = GeatherSoulArrayModel:GetInstance():GetAllAttribute(self.uid)
    end
    --天赋
    local talentAttr = self:GetTalentAttribute()

    --魂链 是否激活
    if self.soulLink_IsActivate == 1 then
        local hunlian_exclusive =
            require("CardHunLianManger"):GetInstance():CalAttributeBase(self.sid, self.soulLink_lv)
        attributeManager:AddAttribute(attr, hunlian_exclusive)
        local hunlian_attribute = require("CardHunLianManger"):GetInstance():CalAttribute(self.sid, self.soulLink_lv)
        if not _G.table.isEmptyOrNil(hunlian_attribute) then
            attributeManager:AddAttribute(attr, hunlian_attribute)
        end
    end
    local Decoration = self:GetDecorationProp()
    attributeManager:AddAttribute(attr, self.BaseProp, true)
    attributeManager:AddAttribute(attr, euqipAttr, true)
    attributeManager:AddAttribute(attr, ChangeArtifactAttr, true)
    attributeManager:AddAttribute(attr, ChangeArtifactIllAttr, true)
    if ChangeSpiritualAttr then
        attributeManager:AddAttribute(attr, ChangeSpiritualAttr, true)
    end
    if ChangeSpiritualIllAttr then
        attributeManager:AddAttribute(attr, ChangeSpiritualIllAttr, true)
    end
    attributeManager:AddAttribute(attr, TreeAttr, true)
    attributeManager:AddAttribute(attr, Decoration, true)
    attributeManager:AddAttribute(attr, campAttr, true)
    attributeManager:AddAttribute(attr, hellAttr, true)
    attributeManager:AddAttribute(attr, titleAndHaloAttr, true)
    attributeManager:AddAttribute(attr, combineAttr, true)
    attributeManager:AddAttribute(attr, fetterAttr, true)
    if geatherSoulAttrOnce then
        attributeManager:AddAttribute(attr, geatherSoulAttrOnce, true)
    end
    attributeManager:AddAttribute(attr, geatherSoulAttr, true)
    attributeManager:AddAttribute(attr, talentAttr, true)

    attributeManager:AddAttribute(self.NowSumProp, attr, true)
    attributeManager:PutAttribtueClass(attr)
    self:CalculateRole()
    self:CalculatePower()
    require("PowerToTheTopModel"):GetInstance():hongDianNew()
    if self.type == _G.CardType.Normal then
        require "DemoModel":GetInstance():UpdateCards()
    end
end

---@private
function HelpCardData:CalGeatherSoulAttr()
    local formation = self.msg.formation
    local geatherSoulAttr = _G.AttributeClassManager:GetInstance():GetAttribtueClass()
    GeatherSoulArrayModel:GetInstance():ClaAllTeamAttribute(geatherSoulAttr)
    if self.msg.formation and formation.f_sid ~= 0 then
        local cfg = GeatherSoulArrayModel:GetInstance().LevelCfg[formation.f_sid][formation.level + 1].selectAttr
        local scale = GeatherSoulArrayModel:GetInstance().StarCfg[formation.f_sid][formation.star + 1].allAttr
        local Level_att = {}
        for i = 1, #cfg do
            local temp = {}
            temp.key = cfg[i][1]
            temp.type = cfg[i][2]
            temp.value = cfg[i][3] * scale * 0.0001
            table.insert(Level_att, temp)
        end
        GeatherSoulArrayModel:GetInstance():SortDispaly_Priority(Level_att)
        GeatherSoulArrayModel:GetInstance():CalAttributeBase(geatherSoulAttr, Level_att)
    end
    return geatherSoulAttr
end

---获取聚灵法阵信息
function HelpCardData:GetGeatherSoul()
	return self.msg.formation
end

---初始化交互数据
function HelpCardData:OnInitMutuallyData(isTemp)
    self:SaveEquipmentData(self.msg, isTemp)
    self:SaveDecorationData(self.msg, isTemp)
    if not _G.Application.IsOverseas then
        self:SaveSpiritualData(self.msg, isTemp)
    end
    self:SaveArtifactData(self.msg, isTemp)
    self:CalcNowSumProp()
end

---@return HelpCardData
return HelpCardData
