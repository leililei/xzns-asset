---@class HelpUseInfoData
local HelpUseInfoData = _G.BaseClass("HelpUseInfoData")
---类的构造函数
---@param msg assist.i_use 助战使用信息
function HelpUseInfoData:__init(msg, maxCount)
    self.maxCount = maxCount
    self.count = 0
    self.tempCount = 0
    self:Parse(msg)
end
---解析
---@param msg assist.i_use 助战使用信息
function HelpUseInfoData:Parse(msg)
    self.id = msg.k
    self.count = msg.v or 0
    --self:ParseParam(msg.param)
end
-- ---解析参数
-- ---@param msg number[]
-- function HelpUseInfoData:ParseParam(msg)
-- end

---增加使用次数
---@return void
function HelpUseInfoData:AddUseCount()
    self.count = self.count + 1
    if self.count >= self.maxCount then
        self.count = self.maxCount
    end
end
---增加临时使用次数
---@return void
function HelpUseInfoData:AddTempCount()
    self.tempCount = self.tempCount + 1
end
---移除临时使用次数
---@return void
function HelpUseInfoData:RemoveTempCount()
    self.tempCount = 0
end
---应用临时使用次数至永久次数
---@return void
function HelpUseInfoData:ApplyTempCount()
    self.count = self.count + self.tempCount
    if self.count >= self.maxCount then
        self.count = self.maxCount
    end
    self.tempCount = 0
end

---检测是否达到上限
function HelpUseInfoData:CheckIsMax()
    return self.count + self.tempCount >= self.maxCount
end

---获取已使用次数
---@return number
function HelpUseInfoData:GetCount()
    return self.count + self.tempCount
end
---获取最大次数
---@return number
function HelpUseInfoData:GetMax()
    return self.maxCount
end

return HelpUseInfoData
