    end
    if data.ack == 1 then
        for _, v in pairs(data.friend) do
            self.RecentChatList[v.uid] = require "FriendData".New()
            self.RecentChatList[v.uid]:Init(v)
        end
    end

    if call ~= nil then
        call(self.RecentChatList)
    end
end

