---友情点操作成功，获得友情点
function FriendManager:GetFriendShip(data, msg, call)
    if data == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("data is nil at GetFriendShip of friendmanager")
        end
        return
    end
    local tmp = false
    local ack = 1
    local ack_tu = 1

    --- 获得数量
    local acceptCount = 0
    ---赠送数量
    local sendCount = 0

    if data.a_result ~= nil then
        for _, v in pairs(data.a_result) do
            if v.ack == 1 then
                tmp = true

                self.YouQingDianGengXing = self.YouQingDianGengXing - 1
                self.Friendlist[v.f_uid].accept = 2
                acceptCount = acceptCount + 10
                self.Friendaccept = self.Friendaccept + 1
            else
                ack = v.ack
            end
        end
    end
    if data.g_result ~= nil then
        for _, v in pairs(data.g_result) do
            if v.ack == 1 then
                tmp = true
                self.g_result = self.g_result - 1
                self.Friendlist[v.f_uid].send = 1
                sendCount = sendCount + 10
                self.FriendShip = self.FriendShip + 1
            else
                ack_tu = v.ack
            end
        end
    end
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FriendApplication.id)
    _G.StorageManager:GetInstance():ReceiveAwardData(data)
    if call ~= nil then
        call(ack, ack_tu)
    end
end

