function FriendManager:AddBlackListSuc(data, call)
    if data == nil or data.result == nil then
        return
    end
    local ack = data.result.ack
    local uid = data.result.f_uid
    if ack == 1 then
        require("FriendsNet"):GetInstance():GetBlackListAccess(
            _G.handlerbind(
                self,
                self.ParseBlackData,
                function()
                    if ack == 1 then
                        _G.PopWindowManager:GetInstance():ShowAllTips(TipsID.AddBlcakListSuc)
                        local view = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.FriendsView.Name)
                        for key, value in pairs(self.Friendlist) do
                            if value.uid == uid then
                                value.accept = 0
                            end
                        end
                        if view ~= nil then
                            view.View:S2C_Friendship(uid)
                        end
                    end
                    if call ~= nil then
                        call()
                    end
                end
            )
        )
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(ack)
    end
end

