---解析好友申请
function FriendManager:ParseApplyData(data, call)
    self.ApplyList = {}
    if data ~= nil and data.request_friend ~= nil then
        for _, v in pairs(data.request_friend) do
            local time = _G.TimeUtil.GetServerUnixTime() - v.request_time
            local keepTime = _G.ConfigManager.discrete_cfg[100303][1][1]
            if time > keepTime then
                local msg = {}
                msg.type = 0
                msg.f_uid = v.f_uid
                self:DealApply(msg)
            else
                if self.ApplyList[v.uid] == nil then
                    self.ApplyList[v.uid] = require "FriendData".New()
                end
                self.ApplyList[v.uid]:Init(v)
            end
        end
    end
    if call ~= nil then
        call()
    end
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SupportPage.id)
end

