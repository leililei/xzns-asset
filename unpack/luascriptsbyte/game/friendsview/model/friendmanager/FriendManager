---发送消息
function FriendManager:SendMsg(msg, call)
    require("ChatViewNet"):GetInstance():FriendSendCHAT(msg, _G.handlerbind(self, self.SendMsgSuc, msg, call))
end

---发送消息返回
function FriendManager:SendMsgSuc(data, msg, call)
    if data == nil or data.ack ~= 1 then
        -- if data.ack == "yet_black" then
        --     _G.PopWindowManager:GetInstance():ShowAllTips(TipsID.InOppBlacklist)
        -- end
        return
    end
    local I
    for i, v in pairs(self.RecentChat) do
        if v == msg.f_uid then
            I = i
        end
    end
    if I ~= nil then
        table.remove(self.RecentChat, I)
    end
    table.insert(self.RecentChat, 1, msg.f_uid)
    for i, v in pairs(self.RecentChat) do
        if i > _G.ConfigManager.discrete_cfg[100304][1][1] then
            self.RecentChat[i] = nil
        end
    end
    if call ~= nil then
        call(data)
    end
end

---接受好友赠送（推送）
function FriendManager:S2C_Friendship(uid)
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.FriendsView.Name)
    for key, value in pairs(self.Friendlist) do
        if value.uid == uid then
            value.accept = 1
        end
    end
    if view ~= nil then
        view:S2C_Friendship(uid)
    end

    self.YouQingDianGengXing = self.YouQingDianGengXing + 1

    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FriendApplication.id)
end

---接受好友申请（推送）
function FriendManager:S2C_Apply(uid)
    self:GetApplyListInServer(
        function()
            local view = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.FriendsView.Name)
            for key, value in pairs(self.ApplyList) do
                if value.uid == uid then
                    self.ZaiXianHaoYou = self.ZaiXianHaoYou - 1
                end
            end
            self.ZaiXianHaoYou = self.ZaiXianHaoYou + 1

            if view ~= nil then
                view.View:UpdateApplyListPanel()
            end
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SupportPage.id)
        end
    )
end

---对方同意好友申请（推送）
function FriendManager:S2C_tongYi(uid)
    local view = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.FriendsView.Name)

    if view ~= nil then
        view.View:S2C_Friendship(uid)
        view.View:UpdateAddFriendPanel()
        view.View:UpdateApplyListPanel()
    else
        self:GetFriendListInServer()
    end

    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FriendApplication.id)
end

--region 红点信息纪录
---从本地获取已记录的红点信息
function FriendManager:RedDotRecentChatNew()
    self.RedDotRecentChat = _G.PlayerPrefsManager.GetTable("RedDotRecentChat", false)

    if self.RedDotRecentChat == nil then
        self.RedDotRecentChat = {}
    end
end

---根据Uid判断数据写入
function FriendManager:RedDotChat(UID, time)
    if self.RedDotRecentChat[UID] == nil or self.RedDotRecentChat[UID].time < time then
        self.RedDotRecentChat[UID] = {}
        self.RedDotRecentChat[UID].time = time
        self.RedDotRecentChat[UID].bool = true
        _G.PlayerPrefsManager.SetTable("RedDotRecentChat", self.RedDotRecentChat, true)
    end
end

---根据Uid判断数据删除
function FriendManager:RedDotnil(UID, time)
    if self.RedDotRecentChat[UID] ~= nil and self.RedDotRecentChat[UID].bool == true then
        self.RedDotRecentChat[UID].time = time
        self.RedDotRecentChat[UID].bool = false
        _G.PlayerPrefsManager.SetTable("RedDotRecentChat", self.RedDotRecentChat, false)
    end
end

---最近聊天红点更新
function FriendManager:RedDotBool()
    for key, value in pairs(self.RedDotRecentChat) do
        if value.bool ~= nil and value.bool then
            return true
        end
    end

    return false
end

---好友列表红点显示判断
function FriendManager:RedDotApplylist()
    if _G.table.count(self.ApplyList) > 0 then
        return true
    end
    return false
end

---友情点红点更新
function FriendManager:YouQingDian()
    if self.YouQingDianGengXing <= 0 then
        self.YouQingDianGengXing = 0
    end
    local maxNum = _G.ConfigManager.discrete_cfg[100308][1][1]
    local result = _G.ConfigManager.discrete_cfg[100307][1][1]

    if self.JieXiZi then
        self.YouQingDianGengXing = 0
        for key, value in pairs(self.Friendlist) do
            if value.accept == 1 then
                self.YouQingDianGengXing = self.YouQingDianGengXing + 1
            end
        end
    end
    -- self.YouQingDianGengXing = 0
    -- for key, value in pairs(self.Friendlist) do
    --     if value.accept == 1 then
    --         self.YouQingDianGengXing = self.YouQingDianGengXing + 1
    --     end
    -- end
    if self.Friendaccept == nil then
        self.Friendaccept = 0
    end
    if self.FriendShip == nil then
        self.FriendShip = 0
    end
    if self.YouQingDianGengXing > 0 and self.Friendaccept < maxNum then
        return true
    elseif self.g_result > 0 and self.FriendShip < result then
        -- body
        return true
    end
    return false
end

