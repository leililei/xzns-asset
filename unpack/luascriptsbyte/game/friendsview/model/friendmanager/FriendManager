function FriendManager:DelFriendSuc(data, call, isOther)
    if data == nil or data.result == nil then
        return
    end
    local uidLis = {}
    local ack, uid, flag
    for _, v in pairs(data.result) do
        ack = v.ack
        uid = v.f_uid
        self.g_result = self.g_result - 1
        if ack == 1 then
            self.Friendlist[uid] = nil
            flag = true
            _G.table.insert(uidLis, uid)
            -- _G.ChatManager:GetInstance().DelFriendChatRecord(uid)
        end
    end
    if not isOther and flag then
        _G.PopWindowManager:GetInstance():ShowAllTips(TipsID.DelFriendSuc)
    end
    local view = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.FriendsView.Name)
    if view ~= nil then
        view.View:DelFriendSuc(uidLis)
    end
    if call ~= nil then
        call()
