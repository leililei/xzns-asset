---查询当前在线好友
function FriendManager:FriendListOnLien(call)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.curFunctionOpenID) then
        call({})
        return
    end
    local OnLien = {}
    require("FriendsNet"):GetInstance():FriendListAccess(
        function(data)
            if data ~= nil and data.friends ~= nil then
                for _, v in pairs(data.friends) do
                    if v.time == 0 then
                        _G.table.insert(OnLien, v)
                    end
                end
            end
            call(OnLien)
        end
    )
end

---解析推荐/搜索好友列表
function FriendManager:ParseAddFriendData(data, call)
    self.AddFriend = {}
    if data ~= nil and data.r_friend ~= nil then
        for _, v in pairs(data.r_friend) do
            if self.AddFriend[v.uid] == nil then
                self.AddFriend[v.uid] = require "FriendData".New()
            end
            self.AddFriend[v.uid]:Init(v)
        end
    end
    if call ~= nil then
        call()
    end
end

---解析黑名单列表
