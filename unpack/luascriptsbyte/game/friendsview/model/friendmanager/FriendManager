end

---解析好友列表
function FriendManager:ParseServerData(data, call)
    self.JieXiZi = true
    self.Friendlist = {}
    self.g_result = 0
    if data ~= nil and data.friends ~= nil then
        for _, v in pairs(data.friends) do
            if self.Friendlist[v.uid] == nil then
                self.Friendlist[v.uid] = require "FriendData".New()
            end
            self.Friendlist[v.uid]:Init(v)
            if v.send_friendcoin == 0 then
                self.g_result = self.g_result + 1
            end
        end
    end
    if data.accept_time ~= nil then
        self.Friendaccept = data.accept_time
    end
    if data.send_time ~= nil then
        self.FriendShip = data.send_time
    end
    if call ~= nil then
        call()
    end
end

