function FriendManager:GetRecentChatListInServer(call)
    self.RecentChatList = {}
    for i = 1, #self.RecentChat - 1 do
        local msg = {}
        msg.condition = tostring(self.RecentChat[i])
        require("FriendsNet"):GetInstance():SeekPlayerAccess(msg, _G.handlerbind(self, self.GetRecentChatListSuc))
    end
    local msg = {}
    msg.condition = tostring(self.RecentChat[#self.RecentChat])
    require("FriendsNet"):GetInstance():SeekPlayerAccess(msg, _G.handlerbind(self, self.GetRecentChatListSuc, call))
end

---成功的返回
function FriendManager:GetRecentChatListSuc(data, call)
