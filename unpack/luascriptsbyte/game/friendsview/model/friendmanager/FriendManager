---移除黑名单成功
function FriendManager:RemoveBlackListSuc(data, call)
    if data == nil or table.isEmptyOrNil(data.result) then
        return
    end
    local ack = data.result.ack
    local uid = data.result.f_uid
    if ack == 1 then
        if self.BlackList[uid] ~= nil then
            self.BlackList[uid] = nil
        end
    end
    if call ~= nil then
        call(ack)
    end
end

