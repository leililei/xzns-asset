---处理所有好友请求回调
function FriendManager:DealAllApplySuc(data, msg, call)
    if data == nil then
        return
    end
    local ack = 0
    if data.result ~= nil then
        for _, v in pairs(data.result) do
            if msg.type == 1 then
                -- body
                if v.ack == 1 or ack == 100322 then
                    ack = 100322
                    break
                else
                    ack = v.ack
                end
            end
        end
    end
    if msg.type == 1 then
        if ack == 100322 then
            _G.PopWindowManager:GetInstance():ShowAllTips(100322)
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(ack)
        end
    end
    self.ZaiXianHaoYou = 0
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SupportPage.id)
    if call ~= nil then
        call(ack, msg.type)
    end
end

---对外接口：与他人聊天
function FriendManager:GoChatOfFriendView(uid)
    if uid == _G.PlayerModel:GetInstance().role_uid then
        return
    end
    local I
    for i, v in pairs(self.RecentChat) do
        if v == uid then
            I = i
        end
    end
    if I ~= nil then
        table.remove(self.RecentChat, I)
    end
    table.insert(self.RecentChat, 1, uid)
    for i, v in pairs(self.RecentChat) do
        if i > _G.ConfigManager.discrete_cfg[100304][1][1] then
            self.RecentChat[i] = nil
        end
    end
    _G.PlayerPrefsManager.SetTable("RecentChat", self.RecentChat)

    self:GetRecentChatListInServer(
        function()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FriendsView.Name, "ToChat")
        end
    )
end

