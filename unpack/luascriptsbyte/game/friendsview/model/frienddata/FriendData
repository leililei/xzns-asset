---@class FriendData	中文描述
local FriendData = _G.BaseClass("FriendData")

---类的构造函数
function FriendData:Init(data)
    --uid
    self.uid = data.uid
    --角色名
    self.name = data.name
    --头像
    self.style = data.style
    --玩家等级
    self.lv = data.level
    --在线情况（0为在线，不在线则返回最后登出时间）
    self.time = data.time
    --战斗力
    self.power = data.power
    --赠予友情点标记 0-今日未赠送；1-今日已赠送
    self.send = data.send_friendcoin
    --接收友情点标记 0-今日未赠送；1-今日对方已赠送未接收；2-今日已接收
    self.accept = data.accept_friendcoin
    --申请时间
    self.requestTime = data.request_time
    --头像框
    self.frame = data.frame
    --放置进度
    self.afk = data.afk
    --称号
    self.title = data.title
    --区服id
    self.server = data.server
    ---是否已申请
    self.has_request = data.has_request
    self.Apply = false
    self.LastSendMsgTime = 0
    ---女仆信息
    self.study_info = data.study_info
end

function FriendData:SetApplySuc()
    self.Apply = true
end

function FriendData:SetLastSendMsgTime(time)
    self.LastSendMsgTime = time
end

---类的析构函数
function FriendData:Dispose()
end
return FriendData
