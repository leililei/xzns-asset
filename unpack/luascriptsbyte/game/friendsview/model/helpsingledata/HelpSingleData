---@class HelpSingleData	中文描述
---@field msg assist.i_assist
---@field lendRole role.i_role 借出玩家信息
---@field browRole role.i_role 借入玩家信息
---@field resortRole role.i_role[] 申请玩家信息
---@field cardData HelpCardData 接触卡牌信息
---@field isApply boolean 是否申请
local HelpSingleData = _G.BaseClass("HelpSingleData")

function HelpSingleData:__init(msg)
    self:Parse(msg)
end

---解析数据
---@param msg assist.i_assist
function HelpSingleData:Parse(msg)
    self.msg = msg
    self.lendRole = msg.lend_role or {}
    self.browRole = msg.borrow_role or {}
    self.resortRole = msg.resort_role or {}
    self.time = msg.time
    self:UpdateCardData()
end
---设置申请时间
---@param time number 时间戳
function HelpSingleData:SetTime(time)
    self.time = time
end

---添加申请
---@param msg role.i_role
function HelpSingleData:AddResort(msg)
    _G.table.insert(self.resortRole, msg)
end

---移除申请
function HelpSingleData:RemoveResort(role_uid)
    for k, v in pairs(self.resortRole) do
        if v.uid == role_uid then
            _G.table.remove(self.resortRole, k)
            break
        end
    end
end
---刷新卡牌数据
function HelpSingleData:UpdateCardData()
    require "FriendHelpModel":GetInstance():UpdateCardMsg(self.msg.card)
    self.cardData = require "HelpCardData".New()
    self.cardData:Parse(self.msg.card)
    self.cardData:OnInitMutuallyData(true)
    if self.msg.card.power then
        self.cardData.power=self.msg.card.power
    end
end

return HelpSingleData
