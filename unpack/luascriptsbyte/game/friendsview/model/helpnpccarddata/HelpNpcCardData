local base = require "CardData"
---@class HelpNpcCardData : CardData
local HelpNpcCardData = _G.BaseClass("HelpCardData", base)

function HelpNpcCardData:GetProfessional()
    return self.cfg.Professional, nil, self.branckLv or 0
end
function HelpNpcCardData:SetBranchLv(lv)
    self.branckLv = lv
end


function HelpNpcCardData:GetCampStar()
    return require "CampsiteModel":GetInstance():GetCampAverageStar(self.campid)
end

---@return HelpNpcCardData
return HelpNpcCardData
