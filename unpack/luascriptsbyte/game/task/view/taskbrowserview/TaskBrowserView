---界面的入口函数
function TaskBrowserView:OnCreate()
    self.go_table.aorlooplist_test:StartUpdataDragInfo(#self.TestFun, _G.handler(self, self.InitAorloopList))
end

function TaskBrowserView:InitAorloopList(trans, index)
    local tblIndex = index + 1
    local cfg = self.TestFun[tblIndex]

    if cfg then
        if not self.loopList_Gotable[tblIndex] then
            local go_table = _G.GetAutoGoTable(trans)
            go_table.aorbtn_btn.onClick:AddListener(_G.handler(self, cfg.fun))
            self.loopList_Gotable[tblIndex] = go_table
        end
        self.loopList_Gotable[tblIndex].aortext_text.text = cfg.text
    end
end

