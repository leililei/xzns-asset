function TaskBrowserView:TestFun_yk17()
    local mainCards = {}
    ---@type card_cfg
    local card_cfg = _G.ConfigManager.card_cfg
    for key, value in pairs(card_cfg) do
        local award = {value.id, value.id * 1001}
        table.insert(mainCards, {type = award})
        if #mainCards >= 5 then
            break
        end
    end
    local item_cfg = _G.ConfigManager.item_cfg
    for key, value in pairs(item_cfg) do
        local award = {value.ID, 12}
        table.insert(mainCards, {type = award})
        if #mainCards >= 10 then
            break
        end
    end
    local equipment_cfg = _G.ConfigManager.equipment_cfg
    for key, value in pairs(equipment_cfg) do
        local award = {value.sid, value.sid * 1001}
        table.insert(mainCards, {type = award})
        if #mainCards >= 14 then
            break
        end
    end
    local data = {}
    data.award = {
        item = {}
    }

    table.insertto(data.award.item, mainCards, 1)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
end
