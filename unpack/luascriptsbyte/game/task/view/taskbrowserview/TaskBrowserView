function TaskBrowserView:TestFun_yk10()
    _G.GraphicsManager.Instance:CaptureFrameAndBlur(
        function()
            _G.StoryManager:GetInstance().DialogueRootTranDic.SceneBlurTran:SetActiveE(1)

            local world = _G.WorldManager:GetInstance():GetCurWorld()
            if world ~= nil then
                _G.WorldManager:GetInstance():GetCurWorldPlayer():NavInterruptMove(true)
                ---如果在主世界 要隐藏角色模型
                if world.Cfg.Scene_Type == _G.SceneType.MainWorld then
                    _G.WorldItemManager:GetInstance():SetAllItemVisible(false)
                end
            end

            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.DialogueView.Name,
                810010002,
                _G.handler(self, self.TestFun_yk11)
            )
