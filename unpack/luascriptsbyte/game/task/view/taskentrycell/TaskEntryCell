require "LuaBaseCell"

---TaskEntryCell上的UIBinder挂载组件
---@class TaskEntryCellComponent
---@field public BtnBG AorButton @任务入口按钮
---@field public TMPTaskTitle AorTMP @主任务描述
---@field public TMPChildTaskDes AorTMP @子任务描述
---@field public TMPChildTaskProgress AorTMP @子任务进度
---@field public RTTTaskSubmited RenderToTexture @任务提交特效RTT
---@field public RTTTaskDoing GameObject @任务选中特效父节点GameObject
---@field public ImageBG AorImage @背景 方便修改
---
---@class TaskEntryCell : LuaBaseCell @***单元格类
---@field Components TaskEntryCellComponent @TaskDetailCell单元格组件
---@field Data BaseTask @当前任务信息
local TaskEntryCell = _G.BaseClass("TaskEntryCell", _G.LuaBaseCell)

---构造函数
function TaskEntryCell:__init(data)
end

---缓存组件
function TaskEntryCell:CacheComponent()
end

---清除组件
function TaskEntryCell:ClearComponent()
end

---添加监听
function TaskEntryCell:AddListeners()
    self.Components.BtnBG.onClick:AddListener(_G.handler(self, self.OnTaskClick))
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, string.format("监听任务ID:%s的提交状态!", self.Data.TaskID))
    -- 没有监听TaskSubmit的主要原因是任务提交后可能会导致任务数据变化触发单元格重新刷新，导致没法看到提交特效
    self.Data:AddListener(_G.BaseTaskEvent, _G.BaseTaskEvent.EnumValue.PreTaskSubmit, self.OnPreTaskSubmited, self)
end

---移除监听
function TaskEntryCell:RemoveListeners()
    self.Components.BtnBG.onClick:RemoveAllListeners()
    self.Data:RemoveListener(_G.BaseTaskEvent, _G.BaseTaskEvent.EnumValue.PreTaskSubmit, self.OnPreTaskSubmited, self)
end

---Cell显示
function TaskEntryCell:OnShow()
    self:InitData()
    self:InitView()
end

---Cell销毁
function TaskEntryCell:OnDestroy()
    if self.TaskDoingEffect then
        _G.UIUtils.RemoveEffect(self.TaskDoingEffect, 1)
        self.TaskDoingEffect = nil
    end
    _G.LuaBaseCell.OnDestroy(self)
end

---初始化数据
function TaskEntryCell:InitData()
end

---初始化显示
function TaskEntryCell:InitView()
    --_G.LogUtilities.Log(_G.EModuleName.TaskModule, "TaskEntryCell:InitView()")
    --修改默认背景宽高适配描述
    ---@type UnityEngine.RectTransform
    local gorect = self.CSBaseCell.CellGO:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    gorect:SetRectTransformSize(self.CSBaseCell.CellSize.x, self.CSBaseCell.CellSize.y)
    if self.Data.type == _G.TaskEnum.ETaskType.MainTask then
        self:InitMainTaskView()
    elseif self.Data.type == _G.TaskEnum.ETaskType.BranchTask then
        self:InitBranchTaskView()
    elseif self.Data.type == _G.TaskEnum.ETaskType.DailyTask then
        self:InitDailyTaskView()
    else
        if _G.AppSetting.DEBUG then
            _G.LogError(string.format("不支持的任务类型:%d", self.Data.type))
        end
    end
end

---初始化主任务显示
function TaskEntryCell:InitMainTaskView()
    --print("TaskEntryCell:InitMainTaskView()")
    --如果主线任务成完成状态则表明做到了最后一个任务，默认不需要显示
    local taskinfo = self.Data:GetTaskInfo()
    if self.Data:IsDone() then
        self.Components.TMPTaskTitle.text = ""
        self.Components.TMPChildTaskDes.text = ""
        self.Components.TMPChildTaskProgress.text = ""
    else
        local tasktypetitle = _G.TaskUtilities.GetTaskTypeTitle(self.Data.type)
        local completedchildtasknumber = 0
        if taskinfo.f_subs ~= nil then
            completedchildtasknumber = #taskinfo.f_subs
        end
        self.Components.TMPTaskTitle.text = tasktypetitle .. self.Data.TaskCfg.Des
        --TODO: 支持多个子任务信息展示
        self.Components.TMPChildTaskDes.text = _G.TaskUtilities.GetTaskDes(self.Data)
        self.Components.TMPChildTaskProgress.text = _G.TaskUtilities.GetTaskProgress(self.Data)

        self.Components.ImageBG.SpriteName = "ui_zjm_eff_rwwancheng"

        _G.GameUtil.SetActiveByCondition(self.Components.RTTTaskDoing, true)
        if not self.TaskDoingEffect then
            -- local effectCfg = _G.ConfigManager.ui_effect_cfg["fx_renwukuangxuanzhong_effect"]
            -- _G.UIUtils.LoadEffectByCfg(
            --     effectCfg,
            --     self.Components.RTTTaskDoing,
            --     OnEffectLoaded
            -- )
            local function OnEffectLoaded(transf)
                self.TaskDoingEffect = transf:GetComponentE(_G.typeof(_G.CS.UIParticleScale))
                if self.TaskDoingEffect then
                    self.TaskDoingEffect:UpdateScale()

                    if _G.AppSetting.DEBUG then
                        _G.LogError("self.TaskDoingEffect Loaded. ")
                    end
                end
            end
        else
            self.TaskDoingEffect:UpdateScale()
        end
    end
end

---初始化分支任务显示
function TaskEntryCell:InitBranchTaskView()
    --print("TaskEntryCell:InitBranchTaskView()")
    --如果主线任务成完成状态则表明做到了最后一个任务，认不需要显示
    local taskinfo = self.Data:GetTaskInfo()
    if self.Data:IsDone() then
        self.Components.TMPTaskTitle.text = ""
        self.Components.TMPChildTaskDes.text = ""
        self.Components.TMPChildTaskProgress.text = ""
    else
        local tasktypetitle = _G.TaskUtilities.GetTaskTypeTitle(self.Data.type)
        local completedchildtasknumber = 0
        if taskinfo.f_subs ~= nil then
            completedchildtasknumber = #taskinfo.f_subs
        end
        self.Components.TMPTaskTitle.text = tasktypetitle .. self.Data.TaskCfg.Des
        --TODO: 支持多个子任务信息展示
        self.Components.TMPChildTaskDes.text = _G.TaskUtilities.GetTaskDes(self.Data)
        self.Components.TMPChildTaskProgress.text = _G.TaskUtilities.GetTaskProgress(self.Data)

        self.Components.ImageBG.SpriteName = "ui_zjm_bak_rwjinxingzhong"

        --测试期间 不响应点击
        self.Components.BtnBG.interactable = false

        _G.GameUtil.SetActiveByCondition(self.Components.RTTTaskDoing, true)
        if not self.TaskDoingEffect then
            -- local effectCfg = _G.ConfigManager.ui_effect_cfg["fx_renwukuangxuanzhong_effect"]
            -- _G.UIUtils.LoadEffectByCfg(
            --     effectCfg,
            --     self.Components.RTTTaskDoing,
            --     OnEffectLoaded
            -- )
            local function OnEffectLoaded(transf)
                self.TaskDoingEffect = transf:GetComponentE(_G.typeof(_G.CS.UIParticleScale))
                if self.TaskDoingEffect then
                    self.TaskDoingEffect:UpdateScale()

                    if _G.AppSetting.DEBUG then
                        _G.LogError("self.TaskDoingEffect Loaded. ")
                    end
                end
            end
        else
            self.TaskDoingEffect:UpdateScale()
        end
    end
end

