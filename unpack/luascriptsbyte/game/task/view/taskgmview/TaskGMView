---@class TaskGMView : UIBaseView @任务GM界面
---@field public go_table TaskGMView_GoTable GoTable
---@field private Param1Number number @参数1数值
---@field private Param2Bool bool @参数2布尔值
---@field private Param3String string @参数3字符串
local TaskGMView = _G.BaseClass("TaskGMView", _G.UIBaseView)
TaskGMView.Param1Number = nil
TaskGMView.Param2Bool = nil
TaskGMView.Param3String = nil
--_G.TaskGMView = TaskGMView

local CS = _G.CS
local typeof = _G.typeof

function TaskGMView:Awake()
    self.go_table.aorbtn_BtnBack.onClick:AddListener(_G.handler(self, self.OnClickBack))
    self.go_table.aorbtn_BtnRequirePlayerTask.onClick:AddListener(_G.handler(self, self.OnClickRequirePlayerTask))
    self.go_table.aorbtn_BtnInteruptTaskExecution.onClick:AddListener(
        _G.handler(self, self.OnClickInteruptTaskExecitopm)
    )
    self.go_table.aorbtn_BtnRequireClaimTask.onClick:AddListener(_G.handler(self, self.OnClickRequireClaimTask))
    self.go_table.aorbtn_BtnRequireGiveUpTask.onClick:AddListener(_G.handler(self, self.OnClickRequireGiveUpTask))
    self.go_table.aorbtn_BtnRequireCompleteTask.onClick:AddListener(_G.handler(self, self.OnClickRequireCompleteTask))
    self.go_table.aorbtn_BtnRequireSubmitTask.onClick:AddListener(_G.handler(self, self.OnClickRequireSubmitTask))
    self.go_table.aorbtn_BtnOpenTaskView.onClick:AddListener(_G.handler(self, self.OnClickOpenTaskView))
    self.go_table.aorbtn_BtnOpenTaskBrowserView.onClick:AddListener(_G.handler(self, self.OnClickOpenTaskBrowserView))
end

---界面的入口函数
function TaskGMView:OnCreate()
end

---解析参数
function TaskGMView:ParseParams()
    self.Param1Number = tonumber(self.go_table.input_IfTaskParam1.text)
    self.Param2Bool = _G.ToBoolean(self.go_table.input_IfTaskParam2.text)
    self.Param3String = self.go_table.input_IfTaskParam3.text
    print(string.format("参数1:%s", self.Param1Number))
    print(string.format("参数2:%s", self.Param2Bool))
    print(string.format("参数3:%s", self.Param3String))
end

---点击返回按钮
---@param go UnityEngine.GameObject @按钮对象
---@param ison number @按钮都是1
function TaskGMView:OnClickBack(go, isOn)
    print("TaskGMView:OnClickBack()")
    self:Close()
end

