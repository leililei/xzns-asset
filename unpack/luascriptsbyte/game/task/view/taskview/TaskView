require "TaskEntryCell"
---@class TaskView : UIBaseView	主任务交互界面
---@field public go_table TaskView_GoTable GoTable
local TaskView = _G.BaseClass("TaskView", _G.UIBaseView)

local CS = _G.CS
local typeof = _G.typeof

function TaskView:Awake()
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_BtnBack"] = function(self, go, isOn)
            self:Close()
        end,
        ["@_toggle_ZhuXian"] = function(self, go, isOn)
            -- self:OnClick_Task(go, isOn)
        end,
        ["@_toggle_ZhiXian"] = function(self, go, isOn)
            -- self:OnClickRW(go, isOn)
        end,
        ["@_aorbtn_addRW"] = function(self, go, isOn)
            self:OnClickRW(go, isOn)
        end,
        ---领取任务
        ["@_aorbtn_Execute"] = function(self, go, isOn)
            if self.nowTask_treeChildData == nil then
                return
            end
            local task = _G.TaskModule:GetInstance():GetTaskWithID(self.nowTask_treeChildData.taskid)
            if task ~= nil then
                _G.TaskModule:GetInstance():ExecuteTask(task)
            end
            self:Close()
        end,
        ["@_aorbtn_gogogo"] = function(self, go, isOn)
            if self.nowTask_treeChildData == nil then
                return
            end
            _G.TaskModule:GetInstance():FinishTask(
                self.nowTask_treeChildData.taskid,
                function()
                end
            )
        end,
        ["@_aorbtn_subRW"] = function(self, go, isOn)
            self:SubRW(go, isOn)
        end,
        ----------------------------------↑↑↑
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }

    self.go_table.aortext_Button1.text = "返回登录"
    self.go_table.aorbtn_btn1.onClick:AddListener(_G.handler(self, self.Click_btn1))
end

---界面的入口函数
function TaskView:OnCreate()
    if _G.AppSetting.DEBUG then
        _G.Log("OnCreate", "<color=red>" .. ">>>" .. "</color>")
    end
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))

    self:InitData()
    self:InitView()
    _G.TaskModule:GetInstance():AddListener(
        _G.TaskModuleEvent,
        _G.TaskModuleEvent.EnumValueTable.TaskInfoUpdate,
        self.OnTaskInfoUpdate,
        self
    )
    _G.TaskModule:GetInstance():AddListener(
        _G.TaskModuleEvent,
        _G.TaskModuleEvent.EnumValueTable.TaskNumberUpdate,
        self.OnTaskNumberUpdate,
        self
    )
    ---任务 树视图  父节点 点击事件参数 (objid ->  nowTreeNodeData)
    self.taskInfoObjList = {}

    ---任务 树视图  子节点 点击事件参数 (objid -> nowTreeNodeData)
    self.taskInfoChildObjList = {}

    ---当前任务视图 选中节点 ( 任务类型 主城  任务)
    self.nowTaskViewNode = nil
    ---当前任务 数据
    self.nowTask_treeChildData = nil

    self.TasktreeData = require("TasktreeData").New()
    self.TasktreeData:UpdataTreeView()

    self.go_table.looplist2_tasktype:InitListView(
        self.TasktreeData:GetTreeViewListCount(),
        _G.handler(self, self.OnGetItemByIndex)
    )

    local showNodeData = self.TasktreeData:GetTreeViewDataByIndex(1)
    self:OnTaskChildClicked(showNodeData)
end

---初始化数据
function TaskView:InitData()
end

---初始化显示
function TaskView:InitView()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "TaskView:InitView()")
end

---刷新重创显示
---@param index int cs返回的index从0起始
function TaskView:OnGetItemByIndex(listView2, index)
    local nowTreeNodeData = self.TasktreeData:GetTreeViewDataByIndex(index + 1)
    if nowTreeNodeData == nil then
        return nil
    end

    local itme = nil
    local goTable = nil
    ---@type treeData
    local nowNodeData =
        self.TasktreeData:GetTreeNodeData(
        nowTreeNodeData.treeIndex,
        nowTreeNodeData.childIndex,
        nowTreeNodeData.childchildIndex
    )
    if nowNodeData == nil then
        return nil
    end
    if nowTreeNodeData.nodetype == 1 then
        itme = listView2:NewListViewItem("$_obj_tasktype_Task")
    elseif nowTreeNodeData.nodetype == 2 then
        itme = listView2:NewListViewItem("$_obj_tasktype_ZhuCheng")
    else
        itme = listView2:NewListViewItem("$_obj_tasktype_RenWu")
    end
    goTable = _G.GetAutoGoTable(itme)
    ---初始化点击事件
    local objid = itme:GetInstanceIDE()
    if self.taskInfoObjList[objid] == nil then
        goTable.aorbtn_btn.onClick:AddListener(_G.handlerbind(self, self.OnTreeClicked, objid))
    end
    ---点击事件 参数更新
    self.taskInfoObjList[objid] = nowTreeNodeData

    local name = ""
    if not _G.IsNil(nowNodeData.name) then
        if nowTreeNodeData.nodetype == 2 then
            -- name = nowNodeData.name .. "\tV"
            name = nowNodeData.name .. "\tV"
        else
            name = nowNodeData.name
        end
    end

    ---显示数据
    goTable.aortext_name.text = name

    return itme
end

---主城 点击
function TaskView:OnTreeClicked(objid)
    ---@type treeViewNodeData
    local nowTreeNodeData = self.taskInfoObjList[objid]
    if nowTreeNodeData == nil then
        return
    end
    if nowTreeNodeData.nodetype == 3 then
        self:OnTaskChildClicked(nowTreeNodeData)
    else
        self:OnExpandClicked(nowTreeNodeData)
    end
end

---展开 点击
function TaskView:OnExpandClicked(nowTreeNodeData)
    if nowTreeNodeData == nil then
        return
    end
    self.nowTaskViewNode = nowTreeNodeData

    if _G.AppSetting.DEBUG then
        _G.Log("OnExpandClicked", "<color=red>" .. nowTreeNodeData.treeIndex .. "</color>")
    end

    self.TasktreeData:UpdataExpand(
        nowTreeNodeData.treeIndex,
        nowTreeNodeData.childIndex,
        nowTreeNodeData.childchildIndex
    )
    self:UpdateView()
end
---任务点击
function TaskView:OnTaskChildClicked(nowTreeNodeData)
    if nowTreeNodeData == nil or nowTreeNodeData.IsChild == true then
        return
    end
    self.nowTaskViewNode = nowTreeNodeData
    self:UpdateTaskInfo(nowTreeNodeData)
end

---刷新 显示的任务信息
---@type  treeData nowTreeNodeData  当前信息显示的节点
function TaskView:UpdateTaskInfo(nowTreeNodeData)
    if nowTreeNodeData == nil then
        return
    end
    ---@type treeChildData
    local treeChildData =
        self.TasktreeData:GetTreeNodeData(
        nowTreeNodeData.treeIndex > 0 and nowTreeNodeData.treeIndex or 1,
        nowTreeNodeData.childIndex > 0 and nowTreeNodeData.childIndex or 1,
        nowTreeNodeData.childchildIndex > 0 and nowTreeNodeData.childchildIndex or 1
    )
    if treeChildData.taskid ~= 1 then
        self.nowTask_treeChildData = treeChildData
    end

    local taskid = treeChildData.taskid
    local task = _G.TaskModule:GetInstance():GetTaskWithID(taskid)
    if task == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("无法获取 任务信息 TaskView:UpdateTaskInfo()")
        end
        return
    end
    ---任务章节 标题
    self.go_table.aortext_title.text = "第" .. nowTreeNodeData.treeIndex .. "章 欢迎来到主城" .. nowTreeNodeData.treeIndex
    --任务名字
    self.go_table.aortext_taskname.text = string.format("%s  <size=20>任务id:%s</size>", treeChildData.name, task.TaskID)

    --任务描述
    self.go_table.aortext_taskdes.text = _G.LangUtil.GetLangPackValue(task.TaskCfg.describe)

    --任务目标
    local taskTager = _G.TaskUtilities.GetAllChildTaskDes(task, true) .. "\n"
    if task.AllTaskContents[1].TaskContentCfg.SceneType == 2 then
        taskTager = taskTager .. " 副本_场景id:"
    else
        taskTager = taskTager .. " 主城_场景id:"
    end
    taskTager = taskTager .. task.AllTaskContents[1].TaskContentCfg.SceneIdRequired
    self.go_table.aortext_target.text = taskTager

    local taskinfo = _G.TaskModule:GetInstance():GetTaskInfoWithID(taskid)
    if taskinfo == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("无法获取 任务信息 TaskView:UpdateTaskInfo()")
        end
        return
    end

    local str = ""
    if taskinfo.state == 0 then
        str = "可领取"
    elseif taskinfo.state == 1 then
        str = "已领取"
    elseif taskinfo.state == 2 then
        str = "执行中"
    elseif taskinfo.state == 3 then
        str = "完成"
    elseif taskinfo.state == 4 then
        str = "无效"
    end

    self.go_table.aortext_Execute.text = str
    -- _G.Log(
    --     "OnTaskChildClicked",
    --     "<color=red>" .. nowTreeNodeData.treeIndex .. " " .. nowTreeNodeData.childIndex .. "</color>"
    -- )
end

---刷新显示(不重创)
function TaskView:UpdateView()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "TaskView:UpdateView()")
    self.go_table.looplist2_tasktype:SetListItemCount(self.TasktreeData:GetTreeViewListCount(), false)
    self.go_table.looplist2_tasktype:RefreshAllShownItem()
end

function TaskView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

---选择 任务类型 主线任务/支线任务
function TaskView:OnClick_Task(go, isOn)
    if isOn == false then
        return
    end
    self.NowTaskObj = go
    local goTable = _G.GetAutoGoTable(go)
end

---点击按钮 添加任务
---@param go UnityEngine.GameObject @按钮对象
---@param ison number @按钮都是1
function TaskView:OnClickRW(go, isOn)
    local zcindex = self.go_table.input_ZC.text
    if #zcindex > 0 then
        zcindex = tonumber(zcindex)
        if zcindex > 0 then
            ---@type treeChildData
            local data = {}
            data.name = "" .. os.time()
            self.TasktreeData:AddTreeChildItemAndUpdata(data, zcindex)
            self:UpdateView()
            return
        end
    end

    local nowTreeNodeData = self.nowTaskViewNode
    if nowTreeNodeData == nil then
        return
    end

    if _G.AppSetting.DEBUG then
        _G.Log("TaskView:OnClickRW()", "<color=red>" .. nowTreeNodeData.treeIndex .. "</color>")
    end

    ---@type treeChildData
    local data = {}
    data.name = "" .. os.time()
    self.TasktreeData:AddTreeChildItemAndUpdata(data, nowTreeNodeData.treeIndex)
    self:UpdateView()
end
---点击按钮 删除任务
---@param go UnityEngine.GameObject @按钮对象
---@param ison number @按钮都是1
function TaskView:SubRW(go, isOn)
    local nowTreeNodeData = self.nowTaskViewNode
    if nowTreeNodeData == nil then
        return
    end

    if _G.AppSetting.DEBUG then
        _G.Log("TaskView:SubRW()", "<color=red>" .. nowTreeNodeData.treeIndex .. "</color>")
    end

    self.TasktreeData:SubTreeChildItemAndUpdata(nowTreeNodeData.childIndex, nowTreeNodeData.treeIndex)

    self:UpdateView()
    local showNodeData = self.TasktreeData:GetTreeViewDataByIndex(2)
    self:UpdateTaskInfo(showNodeData)
end

---添加主城item
function TaskView:AddZCItme(go, isOn)
end

---响应任务数据更新变化
function TaskView:OnTaskInfoUpdate()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "TaskView:OnTaskInfoUpdate()")
    self:UpdateView()
end

---响应任务数量更新变化
function TaskView:OnTaskNumberUpdate()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "TaskView:OnTaskNumberUpdate()")
    self:RefreshView()
end

---响应任务入口界面关闭
function TaskView:Dispose()
    if _G.AppSetting.DEBUG then
        _G.Log("TaskView:Dispose()")
    end
    _G.TaskModule:GetInstance():RemoveListener(
        _G.TaskModuleEvent,
        _G.TaskModuleEvent.EnumValueTable.TaskInfoUpdate,
        self.OnTaskInfoUpdate,
        self
    )
    _G.TaskModule:GetInstance():RemoveListener(
        _G.TaskModuleEvent,
        _G.TaskModuleEvent.EnumValueTable.TaskNumberUpdate,
        self.OnTaskNumberUpdate,
        self
    )
end

