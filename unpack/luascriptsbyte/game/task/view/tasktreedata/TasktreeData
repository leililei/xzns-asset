---@class TasktreeData	任务 树视图 数据
local TasktreeData = _G.BaseClass("TasktreeData")

---@class treeViewNodeData 树视图每个节点 通用数据
local treeViewNodeData = {
    --- 全索引 (父节点+子节点)
    index = -1,
    --- 是否展开
    isExpand = true,
    ---节点类型    1任务类型  2 主城名字  3 任务
    nodetype = 1,
    ---所属子节点的孙索引
    childchildIndex = -1,
    --父节点索引
    treeIndex = -1,
    ---所属父节点的子索引
    childIndex = -1
}

---@class treeChildChildData 孙节点数据
local treeChildChildData = {
    ---名字
    name = "",
    ---任务id
    taskid = 1,
    nodetype = 3,
    ---任务类型
    tasktype = 1,
    ---所属子节点的孙索引
    childchildIndex = -1
}

---@class treeChildData 子节点数据
local treeChildData = {
    ---名字
    name = "",
    ---任务id
    taskid = 1,
    nodetype = 2,
    --- 是否展开
    isExpand = true,
    ---@type treeChildChildData
    ChildList = {},
    ---所属父节点的子索引
    childIndex = -1
}

---@class treeData 父节点 数据
local treeData = {
    ---名字
    name = "",
    nodetype = 1,
    ---父节点索引
    treeIndex = -1,
    --- 是否展开
    isExpand = true,
    ---@type treeChildData
    ChildList = {}
}

local CS = _G.CS
local typeof = _G.typeof

---类的构造函数
function TasktreeData:__init()
    ---数据内容
    self.treeItemList = {}
    ---树当前显示内容
    self.treeViewList = {}

    self:InitFalseData()

    self:InitTreeView()
end

---初始化假数据...
function TasktreeData:InitFalseData()
    local taskAllMain = {}
    local taskAll = {}

    --可领取任务
    local waitClaimTaskAll = {}
    --已完成任务
    local CompletedTaskAll = {}

    --所有领取的任务id
    local nowTaskIdAll = {}
    for key, eTaskType in pairs(_G.TaskEnum.ETaskType) do
        local taskinfolist = _G.TaskModule:GetInstance():GetAllTask(eTaskType)
        if not _G.IsNil(taskinfolist) then
            --主线任务添加到主线任务里
            if eTaskType == _G.TaskEnum.ETaskType.MainTask then
                for _, task in pairs(taskinfolist) do
                    if task:IsAvalibleExecute() then
                        table.insert(taskAllMain, task)
                    elseif task:IsAvalibleClaim() == 1 then
                        table.insert(waitClaimTaskAll, task)
                    elseif task:IsDone() then
                        table.insert(CompletedTaskAll, task)
                    end
                end
            else
                for _, task in pairs(taskinfolist) do
                    if task:IsAvalibleExecute() then
                        table.insert(taskAll, task)
                    elseif task:IsAvalibleClaim() == 1 then
                        table.insert(waitClaimTaskAll, task)
                    elseif task:IsDone() then
                        table.insert(CompletedTaskAll, task)
                    end
                end
            end
        end
    end

    self.treeItemList = {}
    local treeIndex = 0

    --添加主线任务
    if #taskAllMain > 0 then
        treeIndex = treeIndex + 1
        local t_treeData = _G.DeepCopy(treeData)
        t_treeData.name = "主线任务"
        t_treeData.nodetype = 1
        t_treeData.treeIndex = 1
        self:AddTreeItem(t_treeData)
        ---任务
        for taskid, taskinfo in pairs(taskAllMain) do
            ---@type treeChildData
            local treeChildData = _G.DeepCopy(treeChildData)
            treeChildData.taskid = taskinfo.TaskID
            treeChildData.tasktype = _G.TaskEnum.ETaskType.MainTask
            treeChildData.nodetype = 3
            treeChildData.name = _G.LangUtil.GetLangPackValue(taskinfo.TaskCfg.name)
            table.insert(nowTaskIdAll, taskinfo.TaskID)
            self:AddTreeChildItem(treeChildData, treeIndex)
        end
    end

    --添加其他任务
    if #taskAll > 0 then
        treeIndex = treeIndex + 1
        local t_treeData = _G.DeepCopy(treeData)
        t_treeData.name = "支线任务"
        t_treeData.nodetype = 1
        t_treeData.treeIndex = treeIndex
        ---主线任务标题
        self:AddTreeItem(t_treeData)

        --主城
        local main_sceneList = {}
        --将不同任务 按主城分类
        for _, task in pairs(taskAll) do
            local main_scene = task.TaskCfg.main_scene
            if main_sceneList[main_scene] == nil then
                main_sceneList[main_scene] = {}
            end
            table.insert(main_sceneList[main_scene], task)
        end
        local sceneIndex = 1

        for main_sceneid, scenetasklist in pairs(main_sceneList) do
            --主城
            local treeChildData = _G.DeepCopy(treeChildData)

            treeChildData.name = self:GetZCNameStr(main_sceneid)
            treeChildData.treeIndex = t_treeData.treeIndex
            self:AddTreeChildItem(treeChildData, t_treeData.treeIndex)

            for _, task in pairs(scenetasklist) do
                --任务
                ---@type treeChildChildData
                local treeChildChildData = _G.DeepCopy(treeChildChildData)
                treeChildChildData.taskid = task.TaskID
                treeChildChildData.tasktype = _G.TaskEnum.ETaskType.MainTask
                treeChildChildData.name = _G.LangUtil.GetLangPackValue(task.TaskCfg.name)

                table.insert(nowTaskIdAll, task.TaskID)
                self:AddTreeChildChildItem(treeChildChildData, t_treeData.treeIndex, treeChildData.childIndex)
            end
        end
    end

    --添加 可领取任务
    if #waitClaimTaskAll > 0 then
        treeIndex = treeIndex + 1
        local t_treeData = _G.DeepCopy(treeData)
        t_treeData.name = "可领取任务"
        t_treeData.nodetype = 1
        t_treeData.treeIndex = treeIndex
        ---主线任务标题
        self:AddTreeItem(t_treeData)
        --主城
        local main_sceneList = {}
        --将不同任务 按主城分类
        for _, task in pairs(waitClaimTaskAll) do
            local main_scene = task.TaskCfg.main_scene
            if main_sceneList[main_scene] == nil then
                main_sceneList[main_scene] = {}
            end
            table.insert(main_sceneList[main_scene], task)
        end
        local sceneIndex = 1

        for main_sceneid, scenetasklist in pairs(main_sceneList) do
            --主城
            local treeChildData = _G.DeepCopy(treeChildData)

            treeChildData.name = self:GetZCNameStr(main_sceneid)
            treeChildData.treeIndex = t_treeData.treeIndex
            self:AddTreeChildItem(treeChildData, t_treeData.treeIndex)

            for _, task in pairs(scenetasklist) do
                --任务
                ---@type treeChildChildData
                local treeChildChildData = _G.DeepCopy(treeChildChildData)
                treeChildChildData.taskid = task.TaskID
                treeChildChildData.tasktype = _G.TaskEnum.ETaskType.MainTask
                treeChildChildData.name = _G.LangUtil.GetLangPackValue(task.TaskCfg.name)

                table.insert(nowTaskIdAll, task.TaskID)
                self:AddTreeChildChildItem(treeChildChildData, t_treeData.treeIndex, treeChildData.childIndex)
            end
        end
    end

    --添加 已完成任务
    if #CompletedTaskAll > 0 then
        treeIndex = treeIndex + 1
        local t_treeData = _G.DeepCopy(treeData)
        t_treeData.name = "已完成任务"
        t_treeData.nodetype = 1
        t_treeData.treeIndex = treeIndex
        ---主线任务标题
        self:AddTreeItem(t_treeData)
        --主城
        local main_sceneList = {}
        --将不同任务 按主城分类
        for _, task in pairs(CompletedTaskAll) do
            local main_scene = task.TaskCfg.main_scene
            if main_sceneList[main_scene] == nil then
                main_sceneList[main_scene] = {}
            end
            table.insert(main_sceneList[main_scene], task)
        end
        local sceneIndex = 1

        for main_sceneid, scenetasklist in pairs(main_sceneList) do
            --主城
            local treeChildData = _G.DeepCopy(treeChildData)

            treeChildData.name = self:GetZCNameStr(main_sceneid)
            treeChildData.treeIndex = t_treeData.treeIndex
            self:AddTreeChildItem(treeChildData, t_treeData.treeIndex)

            for _, task in pairs(scenetasklist) do
                --任务
                ---@type treeChildChildData
                local treeChildChildData = _G.DeepCopy(treeChildChildData)
                treeChildChildData.taskid = task.TaskID
                treeChildChildData.tasktype = _G.TaskEnum.ETaskType.MainTask
                treeChildChildData.name = _G.LangUtil.GetLangPackValue(task.TaskCfg.name)

                table.insert(nowTaskIdAll, task.TaskID)
                self:AddTreeChildChildItem(treeChildChildData, t_treeData.treeIndex, treeChildData.childIndex)
            end
        end
    end
end

---[数据list  添加第一层  任务类型  (主线任务,支线任务)
---@param treeData treeData
function TasktreeData:AddTreeItem(t_treeData)
    table.insert(self.treeItemList, t_treeData)
end

---添加 子节点 数据 [数据list  添加第二层  主城
---@param data   treeChildData  childIndex自动顺序赋值
---@param treeIndex   int  所属 父节点索引
function TasktreeData:AddTreeChildItem(data, treeIndex)
    if #self.treeItemList < treeIndex then
        if _G.AppSetting.DEBUG then
            _G.Log("AddTreeChildItem treeIndex索引超出", "<color=red>" .. treeIndex .. "</color>")
        end
        return
    end
    data.childIndex = #self.treeItemList[treeIndex].ChildList + 1
    table.insert(self.treeItemList[treeIndex].ChildList, data)
end

---添加 孙节点 数据 [数据list  添加第三层  任务名
---@param data   treeChildData  childIndex自动顺序赋值
---@param treeIndex   int  所属 父节点索引
function TasktreeData:AddTreeChildChildItem(data, treeIndex, childIndex)
    if #self.treeItemList < treeIndex then
        if _G.AppSetting.DEBUG then
            _G.Log("AddTreeChildChildItem treeIndex索引超出", "<color=red>" .. treeIndex .. "</color>")
        end
        return
    end
    if #self.treeItemList[treeIndex].ChildList < childIndex then
        if _G.AppSetting.DEBUG then
            _G.Log("AddTreeChildChildItem childIndex", "<color=red>" .. childIndex .. "</color>")
        end
        return
    end
    data.childIndex = childIndex
    data.childchildIndex = #self.treeItemList[treeIndex].ChildList[childIndex].ChildList + 1
    table.insert(self.treeItemList[treeIndex].ChildList[childIndex].ChildList, data)
end

---添加 子节点 数据 并刷新视图数据
---@param data   treeChildData  childIndex自动顺序赋值
---@param treeIndex   int  所属 父节点索引
function TasktreeData:AddTreeChildItemAndUpdata(data, treeIndex)
    self:AddTreeChildItem(data, treeIndex)
    self:UpdataTreeView()
end
---添加 孙节点 数据 并刷新视图数据
---@param data   treeChildData  childIndex自动顺序赋值
---@param treeIndex   int  所属 父节点索引
function TasktreeData:AddTreeChildChildItemAndUpdata(data, treeIndex, childIndex)
    self:AddTreeChildChildItem(data, treeIndex, childIndex)
    self:UpdataTreeView()
end
---删除 子节点 数据
---@param childIndex   int  子节点索引
---@param treeIndex   int  所属 父节点索引
function TasktreeData:SubTreeChildItem(childIndex, treeIndex)
    local data = self.treeItemList[treeIndex]
    if data == nil then
        if _G.AppSetting.DEBUG then
            _G.Log("SubTreeChildItem 索引超出", "<color=red>" .. treeIndex .. "</color>")
        end
        return
    end
    local data_Child = data.ChildList[childIndex]
    if data_Child == nil then
        if _G.AppSetting.DEBUG then
            _G.Log("SubTreeChildItem data_Child索引超出", "<color=red>" .. childIndex .. "</color>")
        end
        return
    end
    table.remove(self.treeItemList[treeIndex].ChildList, childIndex)
end
---删除 孙节点 数据
---@param childIndex   int  子节点索引
---@param treeIndex   int  所属 父节点索引
function TasktreeData:SubTreeChildChildItem(childIndex, treeIndex, childchildIndex)
    local data = self.treeItemList[treeIndex]
    if data == nil then
        if _G.AppSetting.DEBUG then
            _G.Log("SubTreeChildChildItem childIndex 索引超出", "<color=red>" .. treeIndex .. "</color>")
        end
        return
    end
    local data_Child = data.ChildList[childIndex]
    if data_Child == nil then
        if _G.AppSetting.DEBUG then
            _G.Log("SubTreeChildChildItem  childIndex 索引超出", "<color=red>" .. childIndex .. "</color>")
        end
        return
    end
    local data_ChildChild = data_Child.ChildList[childchildIndex]
    if data_ChildChild == nil then
        if _G.AppSetting.DEBUG then
            _G.Log("SubTreeChildChildItem childchildIndex 索引超出", "<color=red>" .. childIndex .. "</color>")
        end
        return
    end
    table.remove(self.treeItemList[treeIndex].ChildList[childIndex], childchildIndex)
end
---删除 子节点 数据 并刷新视图数据
---@param childIndex   int  子节点索引
---@param treeIndex   int  所属 父节点索引
function TasktreeData:SubTreeChildItemAndUpdata(childIndex, treeIndex)
    self:SubTreeChildItem(childIndex, treeIndex)
    self:UpdataTreeView()
end
---删除 孙节点 数据 并刷新视图数据
---@param childIndex   int  子节点索引
---@param treeIndex   int  所属 父节点索引
function TasktreeData:SubTreeChildChildItemAndUpdata(childIndex, treeIndex)
    self:SubTreeChildChildItem(childIndex, treeIndex)
    self:UpdataTreeView()
end

function TasktreeData:InitTreeView()
    self.treeViewList = {}
    local allindex = 0
    for index_i, value_i in ipairs(self.treeItemList) do
        allindex = allindex + 1
        ---@type treeViewNodeData
        local t_treeViewNodeData_i = _G.DeepCopy(treeViewNodeData)
        t_treeViewNodeData_i.index = allindex
        t_treeViewNodeData_i.nodetype = 1
        t_treeViewNodeData_i.treeIndex = index_i
        t_treeViewNodeData_i.childIndex = -1

        table.insert(self.treeViewList, t_treeViewNodeData_i)

        for index_j, value_j in ipairs(value_i.ChildList) do
            allindex = allindex + 1
            ---@type treeViewNodeData
            local t_treeViewNodeData_j = _G.DeepCopy(treeViewNodeData)
            t_treeViewNodeData_j.index = allindex
            t_treeViewNodeData_j.nodetype = 2
            t_treeViewNodeData_j.treeIndex = index_i
            t_treeViewNodeData_j.childIndex = index_j
            table.insert(self.treeViewList, t_treeViewNodeData_j)

            for index_k, value_k in ipairs(value_j.ChildList) do
                allindex = allindex + 1
                ---@type treeViewNodeData
                local t_treeViewNodeData_k = _G.DeepCopy(treeViewNodeData)
                t_treeViewNodeData_k.index = allindex
                t_treeViewNodeData_k.nodetype = 3
                t_treeViewNodeData_k.treeIndex = index_i
                t_treeViewNodeData_k.childIndex = index_j
                t_treeViewNodeData_k.childchildIndex = index_k

                table.insert(self.treeViewList, t_treeViewNodeData_j)
            end
        end
    end
end

---根据数据  刷新树视图所有节点
function TasktreeData:UpdataTreeView()
    self.treeViewList = {}
    local allindex = 0
    for index_i, value_i in ipairs(self.treeItemList) do
        allindex = allindex + 1
        ---@type treeViewNodeData
        local t_treeViewNodeData_i = _G.DeepCopy(treeViewNodeData)
        t_treeViewNodeData_i.index = allindex
        t_treeViewNodeData_i.nodetype = value_i.nodetype
        t_treeViewNodeData_i.treeIndex = index_i

        table.insert(self.treeViewList, t_treeViewNodeData_i)
        if value_i.isExpand == true then
            for index_j, value_j in ipairs(value_i.ChildList) do
                allindex = allindex + 1
                ---@type treeViewNodeData
                local t_treeViewNodeData_j = _G.DeepCopy(treeViewNodeData)
                t_treeViewNodeData_j.index = allindex
                t_treeViewNodeData_j.nodetype = value_j.nodetype
                t_treeViewNodeData_j.treeIndex = index_i
                t_treeViewNodeData_j.childIndex = index_j
                table.insert(self.treeViewList, t_treeViewNodeData_j)

                if value_j.isExpand == true then
                    for index_k, value_k in ipairs(value_j.ChildList) do
                        allindex = allindex + 1
                        ---@type treeViewNodeData
                        local t_treeViewNodeData_k = _G.DeepCopy(treeViewNodeData)
                        t_treeViewNodeData_k.index = allindex
                        t_treeViewNodeData_k.nodetype = value_k.nodetype
                        t_treeViewNodeData_k.treeIndex = index_i
                        t_treeViewNodeData_k.childIndex = index_j
                        t_treeViewNodeData_k.childchildIndex = index_k

                        table.insert(self.treeViewList, t_treeViewNodeData_k)
                    end
                end
            end
        end
    end
end

---获取树视图 总节点数量
function TasktreeData:GetTreeViewListCount()
    local count = 0
    if self.treeViewList == nil then
        return count
    end
    count = #self.treeViewList
    return count
end

---根据树视图节点索引  获取该节点数据
function TasktreeData:GetTreeViewDataByIndex(index)
    local nodedata = self.treeViewList[index]
    if nodedata == nil then
        return nil
    end

    return self.treeViewList[index] -- or   nil
end

---获取节点数据  根据节点索引
---@return  treeChildData
function TasktreeData:GetTreeNodeData(treeIndex, childIndex, childchildIndex)
    local data = nil
    if not (treeIndex > 0) or #self.treeItemList < treeIndex then
        return data
    end
    --父节点数据
    data = self.treeItemList[treeIndex]
    if not (childIndex > 0) or #data.ChildList < childIndex then
        return data
    end
    -- 子节点数据
    data = data.ChildList[childIndex]
    if not (childchildIndex > 0) or #data.ChildList < childchildIndex then
        return data
    end
    -- 孙节点数据
    data = data.ChildList[childchildIndex]
    return data
end

---获取父节点数据  根据父节点索引
function TasktreeData:GetTreeData(treeIndex)
    return self.treeItemList[treeIndex] -- or   nil
end

---获取子节点数据  根据子节点索引
function TasktreeData:GetTreeChildData(treeIndex, childIndex)
    local data = self:GetTreeData(treeIndex)
    if data == nil then
        return nil
    end
    return data.ChildList[childIndex] -- or   nil
end

function TasktreeData:GetZCNameStr(main_sceneid)
    local zcCfg = _G.ConfigManager.scene_world_cfg[main_sceneid]
    local zcNameStr = tostring(main_sceneid)
    if zcCfg ~= nil then
        zcNameStr = zcCfg.note
    end
    return zcNameStr
end

---展开收起
function TasktreeData:UpdataExpand(treeIndex, childIndex, childchildIndex)
    local data = self:GetTreeNodeData(treeIndex, childIndex, childchildIndex)

    if data == nil then
        return nil
    end
    data.isExpand = not data.isExpand
    self:UpdataTreeView()
end
---类的析构函数
function TasktreeData:Dispose()
end

return TasktreeData
