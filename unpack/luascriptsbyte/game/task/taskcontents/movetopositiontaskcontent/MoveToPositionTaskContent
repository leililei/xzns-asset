require "BaseTaskContent"

---@class MoveToPositionTaskContent : BaseTaskContent @玩家移动到指定位置任务内容
---@field TargetPosition UnityEngine.Vector3 @目标位置
---@field MoveToPosTipTrigger any @移动到指定位置的提示触发器对象
local MoveToPositionTaskContent = _G.BaseClass("MoveToPositionTaskContent", _G.BaseTaskContent)
MoveToPositionTaskContent.TargetPosition = nil
MoveToPositionTaskContent.MoveToPosTipTrigger = nil

local base = _G.BaseTaskContent

---MoveToPositionTaskContent构造函数
---@param ownertask BaseTask @任务内容所属子任务
---@param taskcontentid number @任务内容id
---@param index number @所属任务的任务内容索引号
function MoveToPositionTaskContent:__init(ownertask, taskcontentid, index)
    --初始化当前任务类型相关的数据
end

---解析任务内容参数
---@param taskcontentparams string @条件详细参数
function MoveToPositionTaskContent:ParseParam(taskcontentparams)
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "MoveToPositionTaskContent:ParseParam()")
    --TODO:解析参数
    self.TargetPosition =
        _G.Vector3.New(tonumber(taskcontentparams[1]), tonumber(taskcontentparams[2]), tonumber(taskcontentparams[3]))
    _G.LogUtilities.Log(
        _G.EModuleName.TaskModule,
        string.format("目标位置：[%s, %s, %s]", self.TargetPosition.x, self.TargetPosition.y, self.TargetPosition.z)
    )
    self.TaskContentTotalProgress = 1
end

---抵达当前任务内容要求场景
function MoveToPositionTaskContent:OnReachTaskContentTargetWorld()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "MoveToPositionTaskContent:OnReachTaskContentTargetWorld()")
    self:TryCreateTaskTip()
end

---更新任务信息
function MoveToPositionTaskContent:UpdateInfo()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "MoveToPositionTaskContent:UpdateInfo()")
    base.UpdateInfo(self)
    self:TryCreateTaskTip()
end

---尝试创建任务提示
function MoveToPositionTaskContent:TryCreateTaskTip()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "MoveToPositionTaskContent:TryCreateTaskTip()")
    --- 抵达指定位置任务支持手动完成，且需要创建目标位置特效
    if self:IsAvalibleExecute() == true then
        _G.LogUtilities.Log(_G.EModuleName.TaskModule, string.format("任务内容ID:%d需要创建目标位置特效!", self.TaskContentID))

        --如果当前世界 是目标世界
        if _G.WorldManager:GetInstance():GetCurWorldSid() == self.TargetSceneID then
            if self.MoveToPosTipTrigger ~= nil then
                if _G.IsNil(self.MoveToPosTipTrigger.Transform) == false then
                    -- 之前创建过，但已经销毁了，需要重新创建!
                    _G.LogUtilities.Log(
                        _G.EModuleName.TaskModule,
                        string.format("任务内容ID:%s的移动到指定位置提示之前创建过，但已经销毁了，需要重新创建!", self.TaskContentID)
                    )
                    self.MoveToPosTipTrigger =
                        _G.TaskUtilities.CreateBaseTaskContentTip(
                        self,
                        _G.handler(self, self.OnTargetPosTriggerEnter),
                        self.TargetPosition,
                        nil
                    )
                end
            else
                -- 还未创建过任务的移动到指定位置提示
                _G.LogUtilities.Log(
                    _G.EModuleName.TaskModule,
                    string.format("任务内容ID:%s的移动到指定位置提示还未创建过,需要创建!", self.TaskContentID)
                )
                self.MoveToPosTipTrigger =
                    _G.TaskUtilities.CreateBaseTaskContentTip(
                    self,
                    _G.handler(self, self.OnTargetPosTriggerEnter),
                    self.TargetPosition,
                    nil
                )
            end
        end
    end
end

---目标位置抵达触发
---@param isEnter boolean True：进入；False：离开
---@param tarInstId number 碰撞到的物体InstId
---@param tarObj UnityEngine.GameObject 碰撞到的物体
---@param luaObj WorldBaseItem 碰撞到的物体Lua对象
function MoveToPositionTaskContent:OnTargetPosTriggerEnter(isEnter, tarInstId, tarObj, luaObj)
    _G.LogUtilities.Log(
        _G.EModuleName.TaskModule,
        string.format(
            "MoveToPositionTaskContent:OnTargetPosTriggerEnter(%s, %d, %s, %s)",
            isEnter,
            tarInstId,
            tarObj.name,
            luaObj.Uid
        )
    )
    -- 抵达之后强制停止，不然任务完成会比抵达寻路终点更先触发(导致寻路的Idle会打断后续剧情动画)
    _G.WorldManager:GetInstance():GetCurWorldPlayer():NavInterruptMove(true)
    self:OnTaskContentComplete()
end

---任务内容完成回调
function MoveToPositionTaskContent:OnTaskContentComplete()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "MoveToPositionTaskContent:OnTaskContentComplete()")
    ---清除寻路提示
    if self.MoveToPosTipTrigger ~= nil then
        _G.WorldManager:GetInstance():GetCurWorld():RemoveWorldItems(self.MoveToPosTipTrigger.Uid)
    end
    base.OnTaskContentComplete(self)
end

---更新任务内容状态
---@param newstate task.TaskState @新的任务内容状态
---@return bool @是否改变状态成功
function MoveToPositionTaskContent:UpdateTaskState(newstate)
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "MoveToPositionTaskContent:UpdateTaskState()")
    --移动到指定位置任务没有进度以服务器端发送的父任务状态为准
    if not self.OwnerTask:IsDone() then
        self:ChangeState(_G.TaskEnum.ETaskState.Executing)
    else
        self:ChangeState(_G.TaskEnum.ETaskState.Completed)
    end
    --TODO:打印相关信息
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, string.format("移动到指定位置任务数据: 当前任务状态:%s", self.TaskContentState))
end

---打断任务内容执行
function MoveToPositionTaskContent:DoInterruptTaskContent()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "打断玩家移动到指定位置任务内容!")
end

---真正开始做任务内容
function MoveToPositionTaskContent:RealDoTaskContent()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "开始执行玩家移动到指定位置任务内容!")
    ---@type NavParam
    local navparam = {}
    navparam.Object = _G.WorldManager:GetInstance():GetCurWorldPlayer()
    navparam.Position = self.TargetPosition
    local navitem, navstate = _G.NavManager:GetInstance():DoNavMove(navparam)
    if navstate == _G.NavState.Success then
        navitem:AddListener(
            _G.NavItemEvent,
            _G.NavItemEvent.EnumValue.NavComplete,
            self.OnMoveToPositionComplete,
            self,
            true
        )
        _G.LogUtilities.Log(_G.EModuleName.TaskModule, string.format("目标位置:%s", self.TargetPosition))
    else
        self:OnMoveToPositionComplete()
    end
    --默认自动完成
    --self:OnTaskContentComplete()
end

---移动到指定位置完成
function MoveToPositionTaskContent:OnMoveToPositionComplete()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "MoveToPositionTaskContent:OnMoveToPositionComplete()")
    --目标位置有引导提示(Trigger触发任务完成逻辑)，不再需要手动触发完成逻辑
    --self:OnTaskContentComplete()
end

---任务完成后支持清除部分数据(子类重写去清除)
function MoveToPositionTaskContent:ClearData()
    base.ClearData(self)
    self.MoveToPosTipTrigger = nil
end

---@type MoveToPositionTaskContent @玩家移动到指定位置任务
_G.MoveToPositionTaskContent = MoveToPositionTaskContent

---@type MoveToPositionTaskContent @玩家移动到指定位置任务
return MoveToPositionTaskContent
