require "BaseTaskContent"

---@class DungeonPassTaskContent : BaseTaskContent @关卡任务
---@field sectionID number @关卡id
---@field  sectionClaim number @关卡要求
---@field  sectionCount number @关卡次数
local DungeonPassTaskContent = _G.BaseClass("DungeonPassTaskContent", _G.BaseTaskContent)
DungeonPassTaskContent.sectionID = nil
DungeonPassTaskContent.sectionClaim = nil
DungeonPassTaskContent.sectionCount = nil
---DungeonPassTaskContent构造函数
---@param ownertask BaseTask @任务内容所属子任务
---@param taskcontentid number @任务内容id
---@param index number @所属任务的任务内容索引号
function DungeonPassTaskContent:__init(ownertask, taskcontentid, index)
    --初始化当前任务类型相关的数据
end

---解析任务内容参数
---@param taskcontentparams string @条件详细参数
function DungeonPassTaskContent:ParseParam(taskcontentparams)
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "DungeonPassTaskContent:ParseParam()")
    local params = tonumber(taskcontentparams[2])
    self.sectionID = _G.GameUtil.GetDivisionNumber(params,10)
    self.sectionClaim = params % 10
    self.sectionCount = tonumber(taskcontentparams[3])
    self.TaskContentTotalProgress = self.sectionCount
end

---更新任务内容状态
---@return bool @是否改变状态成功
function DungeonPassTaskContent:UpdateTaskState()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "DungeonPassTaskContent:UpdateTaskState()")
    local oldtaskcontentstate = self.TaskContentState
    if self.TaskContentProgress >= self.TaskContentTotalProgress then
        self:ChangeState(_G.TaskEnum.ETaskState.Completed)
    else
        self:ChangeState(_G.TaskEnum.ETaskState.Executing)
    end
    -- --怪物战斗是通过后端主动推送变化来判定完成的，所以需要主动判定触发完成(否则无法触发任务完成相关判定)
    -- --判定状态是否变化是为了避免推送和请求完成时触发多次状态更新导致触发多次后置表现
    -- if oldtaskcontentstate ~= self.TaskContentState and self.TaskContentState == _G.TaskEnum.ETaskState.Completed then
    --     _G.LogUtilities.Log(_G.EModuleName.TaskModule, string.format("怪物ID:%s战斗任务完成,主动请求完成!", self.MonsterID))
    --     self:OnTaskContentComplete()
    -- end
    _G.LogUtilities.Log(
        _G.EModuleName.TaskModule,
        string.format(
            "关卡任务数据: 关卡id:%d 关卡要求:%d 关卡次数:%d 当前任务状态:%d",
            self.sectionID,
            self.sectionClaim,
            self.sectionCount,
            self.TaskContentState
        )
    )
end

---打断任务内容执行
function DungeonPassTaskContent:DoInterruptTaskContent()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "打断关卡任务!")
end

---真正开始做任务内容
function DungeonPassTaskContent:RealDoTaskContent()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "开始执行关卡任务!")
end

---关卡任务完成
function DungeonPassTaskContent:OnDialogueComplete()
    self:OnTaskContentComplete()
end

---@type DungeonPassTaskContent @NPC对话任务内容
_G.DungeonPassTaskContent = DungeonPassTaskContent

---@type DungeonPassTaskContent @NPC对话任务内容
return DungeonPassTaskContent
