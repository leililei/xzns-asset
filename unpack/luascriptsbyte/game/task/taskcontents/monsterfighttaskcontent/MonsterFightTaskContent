require "BaseTaskContent"

---@class MonsterFightTaskContent : BaseTaskContent @怪物战斗任务内容
---@field MonsterID number @怪物ID
---@field FightTimes number @战斗次数
---@field DialogueIDBeforeEnterFight number @进战斗前的对话ID(可配可不配)
local MonsterFightTaskContent = _G.BaseClass("MonsterFightTaskContent", _G.BaseTaskContent)
MonsterFightTaskContent.MonsterID = nil
MonsterFightTaskContent.FightTimes = nil
MonsterFightTaskContent.DialogueIDBeforeEnterFight = nil

---MonsterFightTaskContent构造函数
---@param ownertask BaseTask @任务内容所属子任务
---@param taskcontentid number @任务内容id
---@param index number @所属任务的任务内容索引号
function MonsterFightTaskContent:__init(ownertask, taskcontentid, index)
    --初始化当前任务类型相关的数据
end

---解析任务内容参数
---@param taskcontentparams string @条件详细参数
function MonsterFightTaskContent:ParseParam(taskcontentparams)
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "MonsterFightTaskContent:ParseParam()")
    self.MonsterID = tonumber(taskcontentparams[1])
    self.FightTimes = tonumber(taskcontentparams[2])
    if taskcontentparams[3] ~= nil then
        self.DialogueIDBeforeEnterFight = tonumber(taskcontentparams[3])
    end
    self.TaskContentTotalProgress = self.FightTimes
end

---更新任务内容状态
---@param newstate task.TaskState @新的任务内容状态
---@return bool @是否改变状态成功
function MonsterFightTaskContent:UpdateTaskState(newstate)
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "MonsterFightTaskContent:UpdateTaskState()")
    local oldtaskcontentstate = self.TaskContentState
    if self.TaskContentProgress >= self.TaskContentTotalProgress then
        self:ChangeState(_G.TaskEnum.ETaskState.Completed)
    else
        self:ChangeState(_G.TaskEnum.ETaskState.Executing)
    end
    --怪物战斗是通过后端主动推送变化来判定完成的，所以需要主动判定触发完成(否则无法触发任务完成相关判定)
    --判定状态是否变化是为了避免推送和请求完成时触发多次状态更新导致触发多次后置表现
    if oldtaskcontentstate ~= self.TaskContentState and self.TaskContentState == _G.TaskEnum.ETaskState.Completed then
        _G.LogUtilities.Log(_G.EModuleName.TaskModule, string.format("怪物ID:%s战斗任务完成,主动请求完成!", self.MonsterID))
        self:OnTaskContentComplete()
    end
    local dialogueid = ""
    if self.DialogueIDBeforeEnterFight ~= nil then
        dialogueid = tostring(self.DialogueIDBeforeEnterFight)
    end
    _G.LogUtilities.Log(
        _G.EModuleName.TaskModule,
        string.format(
            "怪物战斗任务数据: 怪物ID:%d 战斗次数:%d 对话ID:%s 当前任务进度:%d 总进度:%d 当前任务状态:%s",
            self.MonsterID,
            self.FightTimes,
            dialogueid,
            self.TaskContentProgress,
            self.TaskContentTotalProgress,
            self.TaskContentState
        )
    )
end

---打断任务内容执行
function MonsterFightTaskContent:DoInterruptTaskContent()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "打断怪物战斗任务内容!")
end

---真正开始做任务内容
function MonsterFightTaskContent:RealDoTaskContent()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "开始执行怪物战斗任务内容!")
    --暂时假定怪物都是NPC
    local worldmanager = _G.WorldManager:GetInstance()
    ---@type WorldNPCItem
    local npcitem = worldmanager:GetCurWorld():GetItemInfo(self.MonsterID)
    ---@type NavParam
    local navparam = {}
    navparam.Object = worldmanager:GetCurWorldPlayer()
    navparam.Position = _G.Vector3.New(npcitem.Transform:GetPosition())
    local navitem, navstate = _G.NavManager:GetInstance():DoNavMove(navparam)
    if navstate == _G.NavState.Success then
        navitem:AddListener(
            _G.NavItemEvent,
            _G.NavItemEvent.EnumValue.NavComplete,
            self.OnMoveToMonsterComplete,
            self,
            true
        )
    elseif navstate == _G.NavState.TooClose then
        self:OnMoveToMonsterComplete()
    end
end

---移动到怪物完成
function MonsterFightTaskContent:OnMoveToMonsterComplete()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "MonsterFightTaskContent:OnMoveToNPCComplete()")
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, string.format("MonsterID = %d", self.MonsterID))
    if self.DialogueIDBeforeEnterFight == nil then
        ---@type WorldNPCItem
        local npcitem = _G.WorldManager:GetInstance():GetCurWorld():GetItemInfo(self.MonsterID)
        self:ShowFightHudTips(npcitem)
    else
        _G.StoryManager:GetInstance():PlayDialogueView(
            self.DialogueIDBeforeEnterFight,
            _G.handler(self, self.OnDialogueComplete)
        )
    end
end
---显示战斗标识0.5秒
---@field item WorldNPCItem 怪物对象
function MonsterFightTaskContent:ShowFightHudTips(item)
    local hudinfo = _G.HUDUtilities.CreateDefaultHudInfo()
    hudinfo.HudCfg.HudType = _G.HUDData.EHudType.Base
    hudinfo.HudCfg.ResPath = _G.HUDData.ConstHudResData.FightTipsHudRes
    hudinfo.HudCfg.Content = ""
    hudinfo.BindTransform = item.TitleTransform
    hudinfo.HudCfg.UIOffset = {0, 20}
    hudinfo.HudCfg.FlowBindTarget = true
    hudinfo.HudCfg.Duration = 0
    local temphud = _G.HUDUtilities.ShowHUDWith3DPos(hudinfo)
    _G.DelayDo(
        0.5,
        function()
            --TODO:进入战斗，之前的战斗接口取消了。等具体需求再实现
            if temphud then
                temphud:Destroy()
            end
        end
    )
end

---对话完成
function MonsterFightTaskContent:OnDialogueComplete()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "MonsterFightTaskContent:OnDialogueComplete()")
end

---@type MonsterFightTaskContent @怪物战斗任务内容
_G.MonsterFightTaskContent = MonsterFightTaskContent

---@type MonsterFightTaskContent @怪物战斗任务内容
return MonsterFightTaskContent
