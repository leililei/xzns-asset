require "BaseTaskContent"

---@class CollectItemTaskContent : BaseTaskContent @采集任务
---@field ItemID number @采集物ID
---@field CollectTimes number @采集次数
local CollectItemTaskContent = _G.BaseClass("CollectItemTaskContent", _G.BaseTaskContent)
CollectItemTaskContent.ItemID = nil
CollectItemTaskContent.CollectTimes = nil

--CollectItemTaskContent构造函数
---@param ownertask BaseTask @任务内容所属子任务
---@param taskcontentid number @任务内容id
---@param index number @所属任务的任务内容索引号
function CollectItemTaskContent:__init(ownertask, taskcontentid, index)
    --初始化当前任务类型相关的数据
end

---解析任务内容参数
---@param taskcontentparams string @条件详细参数
function CollectItemTaskContent:ParseParam(taskcontentparams)
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "CollectItemTaskContent:ParseParam()")
    self.ItemID = tonumber(taskcontentparams[2])
    self.CollectTimes = tonumber(taskcontentparams[3])
    self.TaskContentTotalProgress = self.CollectTimes
end

---更新任务内容状态
---@param newstate task.TaskState @新的任务内容状态
---@return bool @是否改变状态成功
function CollectItemTaskContent:UpdateTaskState(newstate)
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "CollectItemTaskContent:UpdateTaskState()")
    if self.TaskContentProgress >= self.TaskContentTotalProgress then
        self:ChangeState(_G.TaskEnum.ETaskState.Completed)
    else
        self:ChangeState(_G.TaskEnum.ETaskState.Executing)
    end
    _G.LogUtilities.Log(
        _G.EModuleName.TaskModule,
        string.format(
            "采集任务数据: 采集物ID:%d 采集次数:%d 当前任务进度:%d 总进度:%d 当前任务状态:%d",
            self.ItemID,
            self.CollectTimes,
            self.TaskContentProgress,
            self.TaskContentTotalProgress,
            self.TaskContentState
        )
    )
end

---打断任务内容执行
function CollectItemTaskContent:DoInterruptTaskContent()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "打断采集物品!")
end

---真正开始做任务内容
function CollectItemTaskContent:RealDoTaskContent()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "默认完成采集物品!")
    --默认自动完成
    self:OnTaskContentComplete()
end

---@type CollectItemTaskContent @采集物品
_G.CollectItemTaskContent = CollectItemTaskContent

---@type CollectItemTaskContent @采集物品
return CollectItemTaskContent
