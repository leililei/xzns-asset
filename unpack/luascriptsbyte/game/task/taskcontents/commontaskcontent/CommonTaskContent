-- 包路径:        UI.Task.TaskContents.CommonTaskContent
-- File Name:    CommonTaskContent.lua
-- Description:  通用任务内容
require "BaseTaskContent"

---@class CommonTaskContent : BaseTaskContent @通用任务
---@field ItemID number @通用物ID
---@field CollectTimes number @通用次数
local CommonTaskContent = _G.BaseClass("CommonTaskContent", _G.BaseTaskContent)
CommonTaskContent.ItemID = nil
CommonTaskContent.CollectTimes = nil

--CommonTaskContent构造函数
---@param ownertask BaseTask @任务内容所属子任务
---@param taskcontentid number @任务内容id
---@param index number @所属任务的任务内容索引号
function CommonTaskContent:__init(ownertask, taskcontentid, index)
    --初始化当前任务类型相关的数据
    _G.Events:GetInstance():AddListener(_G.ePlayAactionEvent.PlayAaction, self.OnAactionEnent, self)
end

---解析任务内容参数
---@param taskcontentparams string @条件详细参数
function CommonTaskContent:ParseParam(taskcontentparams)
    ---进度值 对应任务 参数次数
    local ParasmsDic = {
        [_G.ActiveTaskEnum.ConditionEnum.DrawCard.HaveCount] = 2,
        [_G.ActiveTaskEnum.ConditionEnum.CardLevel.assignSidAssignLevel] = 4,
        [_G.ActiveTaskEnum.ConditionEnum.HellRoad.FinishTask] = 2,
        [_G.ActiveTaskEnum.ConditionEnum.Section.materialAssignLayer] = 4,
        [_G.ActiveTaskEnum.ConditionEnum.Section.TzyDispath] = 2,
        [_G.ActiveTaskEnum.ConditionEnum.ResonanceCrystal.upCardCount] = 2
    }

    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "CommonTaskContent:ParseParam()")
    ---- 任务类型 枚举 (任务枚举.xlsx -)
    self.taskEnumType = tonumber(taskcontentparams[1])

    --- 任务参数
    self.taskcontentparams = taskcontentparams

    local Progress = ParasmsDic[self.taskEnumType]

    if Progress then
        self.TaskContentTotalProgress = self.taskcontentparams[Progress] or 1
    else
        self.TaskContentTotalProgress = self.taskcontentparams[3] or 1
    end
end

---更新任务内容状态
---@param newstate task.TaskState @新的任务内容状态
---@return bool @是否改变状态成功
function CommonTaskContent:UpdateTaskState(newstate)
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "CommonTaskContent:UpdateTaskState()")
    local taskinfo = self.OwnerTask:GetTaskInfo()
    if taskinfo.sid == 312010002 then
        local sdsds = 1
    end
    if self.OwnerTask:IsDone() or self:CheckComplete() then
        self:ChangeState(_G.TaskEnum.ETaskState.Completed)
        _G.Events:GetInstance():RemoveListener(_G.ePlayAactionEvent.PlayAaction, self.OnAactionEnent, self)
    else
        self:ChangeState(_G.TaskEnum.ETaskState.Executing)
    end
    if self:IsAvalibleExecute() then
        _G.coroutine.start(_G.handler(self, self.CheckTaskTarget))
    end
end

---打断任务内容执行
function CommonTaskContent:DoInterruptTaskContent()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "打断通用物品!")
end

---真正开始做任务内容
function CommonTaskContent:RealDoTaskContent()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "默认完成通用物品!")
    --检测是否完成
    _G.coroutine.start(_G.handler(self, self.CheckTaskTarget))
end

---@param isSet boolean true设置进度(检测类条件且有数量要求 初始化)
function CommonTaskContent:OnAactionEnent(id, parmas, isfh, isSet)
    if isfh then
        local array = table.toArray(id)
        table.sort(
            array,
            function(a, b)
                return a < b
            end
        )
        local index = table.indexof(array, self.taskEnumType)
        if false ~= index then
            local keys = {array[index]}
            for i = 2, #parmas[index] do
                table.insert(keys, parmas[index][i])
            end
            self:DoOne(keys, parmas[index][1], isSet)
        end
    else
        self:DoOne(id, parmas, isSet)
    end
end

---@param isSet boolean true设置进度(检测类条件且有数量要求 初始化)
function CommonTaskContent:DoOne(id, parmas, isSet)
    if _G.AppSetting.DEBUG then
        _G.LogUtilities.LogError(_G.EModuleName.TaskModule, string.format(" CommonTaskContent任务id %s", tostring(id)))
        _G.LogUtilities.LogError(_G.EModuleName.TaskModule, string.format(" CommonTaskContent参数 %s", tostring(parmas)))
    end

    --- 已领取 或进行中 才算任务中
    if self.TaskContentState == _G.TaskEnum.ETaskState.Claimed then
    elseif self.TaskContentState == _G.TaskEnum.ETaskState.Executing then
    else
        return
    end
    if table.sameByCount(id, self.taskcontentparams) then
        if _G.AppSetting.DEBUG then
            _G.LogUtilities.LogError(
                _G.EModuleName.TaskModule,
                string.format(" 任务 进度增加 id %s  %s", tostring(id[1]), tostring(parmas))
            )
        end
        if isSet == true then
            self.TaskContentProgress = parmas
        else
            self.TaskContentProgress = self.TaskContentProgress + parmas
        end

        if self:CheckComplete() then
            self:OnComplete()
        end
        self:DispatchEvent(_G.BaseTaskContentEvent, _G.BaseTaskContentEvent.EnumValue.TaskContentUpdate, self)
    end
end

---任务完成
function CommonTaskContent:OnComplete(isShowEff)
    if self:IsAvalibleExecute() == false then
        return
    end
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "NPCDialogueTaskContent:OnDialogueComplete()")

    _G.Events:GetInstance():RemoveListener(_G.ePlayAactionEvent.PlayAaction, self.OnAactionEnent, self)
    self:ChangeState(_G.TaskEnum.ETaskState.Completed)
    self:OnTaskContentComplete(isShowEff)

    local taskinfo = self.OwnerTask:GetTaskInfo()
    if taskinfo.target == nil then
        taskinfo.target = {}
    end

    taskinfo.target[self.TaskContentIndex] = self.TaskContentProgress

    if _G.TaskUtilities.GetTaskProgressIsAllOver(self.OwnerTask) then
        taskinfo.state = _G.TaskEnum.ETaskState.Completed
    end

    ---处理后端主动推送的任务数据更新
    _G.TaskModule:GetInstance():UpdateTaskInfo(taskinfo)
end

---任务完成
function CommonTaskContent:CheckComplete()
    if self.TaskContentProgress >= self.TaskContentTotalProgress then
        self.TaskContentProgress = self.TaskContentTotalProgress
        return true
    end
    return false
end

---检测任务目标   检测类任务(检测某个关卡是否通关)
function CommonTaskContent:CheckTaskTarget()
    local mainv = nil

    --- 等待主界面显示后 等task创建完成  再检测
    while _G.IsNil(mainv) or _G.MainManager == nil or _G.IsNil(mainv.isInMainView) do
        if _G.MainManager ~= nil then
            mainv = _G.MainManager:GetInstance()
        end
        _G.coroutine.waitforendofframe()
    end
    -- _G.coroutine.waitforseconds(1)
    --- 如果能完成  就直接完成
    if self.OwnerTask:IsDone() or self:CheckComplete() then
        self:OnComplete()
        -- self:ChangeState(_G.TaskEnum.ETaskState.Completed)
        return
    end

    local okfun = function(id, parmas, isSet)
        self:OnAactionEnent(id, parmas, false, isSet)
    end

    require("TaskManager").CheckTaskTarget(self, okfun)
end

---@type CommonTaskContent @通用物品
_G.CommonTaskContent = CommonTaskContent

---@type CommonTaskContent @通用物品
return CommonTaskContent
