require "WorldDynamicBaseItem"
require "TaskContentTriggerEvent"
require "TriggerNode"

---@class TaskContentTrigger : WorldDynamicBaseItem @任务内容触发器
---@field TaskContentOwner BaseTaskContent @所属任务内容
---@field TriggerResPath string @触发器资源路径
---@field BTCTriggerNode TriggerNode @任务内容触发器对象
---@field BTCTriggerCB fun(isEnter:boolean,tarInstId:number,tarInstId:tarObj,luaObj:WorldBaseItem) @任务内容触发回调方法
---@field IsTriggered boolean @是否已触发
local TaskContentTrigger = _G.BaseClass("TaskContentTrigger", _G.WorldDynamicBaseItem)
TaskContentTrigger.TaskContentOwner = nil
TaskContentTrigger.TriggerResPath = nil
TaskContentTrigger.BTCTriggerNode = nil
TaskContentTrigger.BTCTriggerCB = nil
TaskContentTrigger.IsTriggered = nil

local base = _G.WorldDynamicBaseItem

---TaskContentTrigger构造函数
---@param info BaseItemParam @类型
---@param taskcontentowner BaseTaskContent @所属任务内容
---@param triggerrespath string @触发器资源路径
---@param triggercb fun(isEnter:boolean,tarInstId:number,tarInstId:tarObj,luaObj:WorldBaseItem) @触发器回调方法
function TaskContentTrigger:__init(info, taskcontentowner, triggerrespath, triggercb)
    self.TaskContentOwner = taskcontentowner
    self.TriggerResPath = triggerrespath
    self.BTCTriggerNode = nil
    self.BTCTriggerCB = triggercb
    self.IsTriggered = false
end

---加载资源完成
function TaskContentTrigger:OnLoadResObjComplete()
    base.OnLoadResObjComplete(self)
    self:AddTriggerNode()
end

---添加触发器节点
function TaskContentTrigger:AddTriggerNode()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "TaskContentTrigger:AddTriggerNode()")
    ---@type TriggerNodeCreateArgs
    local args = {}
    args.Name = string.format("%s_%s", self.__cname, self.TaskContentOwner.TaskContentID)
    args.Parent = self
    args.ResPath = self.TriggerResPath
    args.AcceptItemType = {"WorldPlayerItem"}
    args.CallBack = _G.handler(self, self.OnTriggerLoadCompleted)
    self.BTCTriggerNode = require("TriggerNode").Create(args, self.World)
end

---触发器节点加载完成
---@param triggernode TriggerNode @触发器对象
function TaskContentTrigger:OnTriggerLoadCompleted(triggernode)
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "TaskContentTrigger:OnTriggerLoadCompleted()")
    self.BTCTriggerNode = triggernode
    self.BTCTriggerNode:SetTriggerEvent(_G.handler(self, self.OnTrigger))
    self.BTCTriggerNode:SetTriggerEnable(true)
end

---任务触发节点触发回调
---@param isEnter boolean True：进入；False：离开
---@param tarInstId number 碰撞到的物体InstId
---@param tarObj UnityEngine.GameObject 碰撞到的物体
---@param luaObj WorldBaseItem 碰撞到的物体Lua对象
function TaskContentTrigger:OnTrigger(isEnter, tarInstId, tarObj, luaObj)
    if self.IsTriggered == false then
        self.IsTriggered = true
        if self.BTCTriggerCB ~= nil then
            self.BTCTriggerCB(isEnter, tarInstId, tarObj, luaObj)
        end
    end
end

---销毁自身
function TaskContentTrigger:DisWorldItem()
    base.DisWorldItem(self)
    self.TaskContentOwner = nil
    self.TriggerResPath = nil
    self.BTCTriggerNode = nil
    self.BTCTriggerCB = nil
    self.IsTriggered = false
end

---@type TaskContentTrigger @任务内容触发器
_G.TaskContentTrigger = TaskContentTrigger

---@type TaskContentTrigger @任务内容触发器
return TaskContentTrigger
