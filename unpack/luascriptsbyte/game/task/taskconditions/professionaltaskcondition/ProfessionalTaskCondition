require "BaseTaskCondition"

---@class ProfessionalTaskCondition : BaseTaskCondition @玩家职业任务条件
---@field ProfressionalRequired number @职业要求
local ProfessionalTaskCondition = _G.BaseClass("ProfessionalTaskCondition", _G.BaseTaskCondition)
ProfessionalTaskCondition.ProfressionalRequired = nil

---ProfessionalTaskCondition构造函数
---@param ownertask BaseTask @任务条件所属任务
---@param taskconditiontype ETaskCondition @任务条件类型
---@param conditionparams string @条件详细参数(上层统一传字符串，子类自行解析)
function ProfessionalTaskCondition:__init(ownertask, taskconditiontype, conditionparams)
end

---解析条件参数
---@param conditionparams string @条件详细参数
function ProfessionalTaskCondition:ParseParam(conditionparams)
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, string.format("玩家职业任务条件参数:%s", conditionparams))
    self.ProfressionalRequired = tonumber(conditionparams)
end

---检查玩家职业任务条件
---@return boolean @任务条件是否满足
function ProfessionalTaskCondition:CheckCondition(...)
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "默认满足玩家职业任务条件!")
    return true
end

---@type ProfessionalTaskCondition @玩家职业任务条件
_G.ProfessionalTaskCondition = ProfessionalTaskCondition

---@type ProfessionalTaskCondition @玩家职业任务条件
return ProfessionalTaskCondition
