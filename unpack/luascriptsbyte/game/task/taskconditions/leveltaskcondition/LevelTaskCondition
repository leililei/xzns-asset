require "BaseTaskCondition"

---@class LevelTaskCondition : BaseTaskCondition @玩家等级任务条件
---@field LevelRequired number @要求等级
local LevelTaskCondition = _G.BaseClass("LevelTaskCondition", _G.BaseTaskCondition)
LevelTaskCondition.LevelRequired = nil

---LevelTaskCondition构造函数
---@param ownertask BaseTask @任务条件所属任务
---@param taskconditiontype ETaskCondition @任务条件类型
---@param conditionparams string @条件详细参数(上层统一传字符串，子类自行解析)
function LevelTaskCondition:__init(ownertask, taskconditiontype, conditionparams)
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "LevelTaskCondition:__init()")
end

---解析条件参数
---@param conditionparams string @条件详细参数
function LevelTaskCondition:ParseParam(conditionparams)
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, string.format("等级条件参数:%s", conditionparams))
    self.LevelRequired = tonumber(conditionparams)
end

---检查玩家等级任务条件
---@return boolean @任务条件是否满足
function LevelTaskCondition:CheckCondition(...)
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "默认满足等级条件!")
    return true
end

---@type LevelTaskCondition @玩家等级任务条件
_G.LevelTaskCondition = LevelTaskCondition

---@type LevelTaskCondition @玩家等级任务条件
return LevelTaskCondition
