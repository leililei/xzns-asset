-- 包路径:        UI.Task.TaskConditions.CommonTaskCondition
-- File Name:    CommonTaskCondition.lua
-- Description:  通用任务条件检测

require "BaseTaskCondition"

---@class CommonTaskCondition : BaseTaskCondition @通用任务条件检测
---@field LevelRequired number @要求等级
local CommonTaskCondition = _G.BaseClass("CommonTaskCondition", _G.BaseTaskCondition)
CommonTaskCondition.LevelRequired = nil

---CommonTaskCondition构造函数
---@param ownertask BaseTask @任务条件所属任务
---@param taskconditiontype ETaskCondition @任务条件类型
---@param conditionparams string @条件详细参数(上层统一传字符串，子类自行解析)
function CommonTaskCondition:__init(ownertask, taskconditiontype, conditionparams)
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "CommonTaskCondition:__init()")
end

---解析条件参数
---@param conditionparams string @条件详细参数
function CommonTaskCondition:ParseParam(conditionparams)
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, string.format("等级条件参数:%s", conditionparams))
    self.LevelRequired = tonumber(conditionparams)
end

---通用任务条件检测
---@return boolean @任务条件是否满足
function CommonTaskCondition:CheckCondition(...)
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "默认满足等级条件!")
    return true
end
---@type CommonTaskCondition @通用任务条件检测
_G.CommonTaskCondition = CommonTaskCondition

---@type CommonTaskCondition @通用任务条件检测
return CommonTaskCondition
