---@class BranchTask : BaseTask @分支任务
local BranchTask = _G.BaseClass("BranchTask", _G.BaseTask)

---BranchTask构造函数
---@param taskinfo task.TaskInfo @任务信息
function BranchTask:__init(taskinfo)
end

---获取当前符合条件的任务内容列表(含内嵌子任务的任务内容)
---@param filterfunc funtion(taskcontent:BaseTaskContent):bool @任务内容过滤条件
---@return BaseTaskContent[] @获取当前正在做的任务内容列表
function BranchTask:GetAllTaskContents(filterfunc)
    filterfunc = filterfunc or nil
    ---只有叶子结点的任务才有任务内容
    --所有子任务排除完成的剩下接受到任务信息的表示当前正在做的任务
    local currentdoingtaskcontents = {}
    ---@type BaseTaskContent taskcontent
    for k, taskcontent in pairs(self.AllTaskContents) do
        if taskcontent:IsAvalibleExecute() then
            if filterfunc == nil then
                _G.table.insert(currentdoingtaskcontents, taskcontent)
            else
                if filterfunc(taskcontent) == true then
                    _G.table.insert(currentdoingtaskcontents, taskcontent)
                end
            end
        end
    end
    return currentdoingtaskcontents
end

---@type BranchTask @分支任务
_G.BranchTask = BranchTask

---@type BranchTask @分支任务
return BranchTask
