---提交当前任务
------@param isPlayer boolean true是玩家操作 点击提交任务
function BaseTask:SubmitTask(isPlayer)
    ---防止刚上线 loading中 自动提交
    if _G.UIManager:GetInstance():IsActiveWindow(_G.ConfigManager.ui_cfg.LoadingView.Name) == true then
        return
    end
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "BaseTask:SubmitTask()")
    local scenceID = tonumber(self.TaskCfg.submit[1])
    --找NPC提交
    if self.TaskCfg.is_auto_submit == 0 then
        if scenceID ~= nil then
            ---如果 不在关卡里
            if not _G.WorldManager:GetInstance():CheckSceneType(_G.SceneType.Section) then
                local openSectionID = tonumber(self.TaskCfg.submit[3])
                local chapterID = tonumber(self.TaskCfg.submit[4])
                if openSectionID ~= nil and chapterID ~= nil then
                    --- 就打开 关卡选择界面
                    _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.SelectSectionMapView.Name,
                        chapterID,
                        openSectionID,
                        function()
                            -- body
                        end
                        -- ,            self.TaskContentCfg.TaskContentParam[2]
                    )
                    return
                end
                if _G.WorldManager:GetInstance():GetCurWorldSid() == scenceID then
                    ---如果是当前场景 则不处理
                elseif _G.ConfigManager.scene_world_cfg[scenceID] ~= nil then
                    --- 如果是其他主城场景 打开世界地图 ZHJ-3788
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WorldMapView.Name)
                    return
                end
            end

            _G.LogUtilities.Log(_G.EModuleName.TaskModule, string.format("提交任务ID:%d 场景:%d引导", self.TaskID, scenceID))
            self.OnSceneNavCompleteCB = _G.handler(self, self.OnSubmitTaskSceneNavigationComplete)
            self.OnNavCompleteCB = _G.handler(self, self.OnSubmitTaskNPCNavigationComplete)
            self:DoSceneNavigation(scenceID)
        else
            _G.LogUtilities.Log(_G.EModuleName.TaskModule, string.format("提交任务ID:%d不需要场景引导,直接提交任务!", self.TaskID))
            self:OnSubmitTaskNPCNavigationComplete()
        end
    elseif self.TaskCfg.is_auto_submit == 1 or isPlayer == true then
        --自动提交
        self:OnSubmitTaskNPCNavigationComplete()
    end
end

---[private]执行任务场景寻路导航
---@param targetsceneid number @目标场景id
function BaseTask:DoSceneNavigation(targetsceneid)
    local sceneCfg = _G.ConfigManager.scene_cfg[targetsceneid]
    if sceneCfg == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("没有该场景配置 targetsceneid:" .. targetsceneid)
        end
        return
    end

    _G.LogUtilities.Log(_G.EModuleName.TaskModule, string.format("BaseTask:DoSceneNavigation(%d)", targetsceneid))
    local worldmanager = _G.WorldManager:GetInstance()
    local worldSid = worldmanager:GetCurWorldSid()
    if worldSid ~= targetsceneid then
        _G.LogUtilities.Log(
            _G.EModuleName.TaskModule,
            string.format("当前场景:%d和目标场景:%d不同需要引导切换场景!", worldSid, targetsceneid)
        )
        local mainplayer = worldmanager:GetCurWorldPlayer()
        ---@type NavParam
        local navparam = {}
        navparam.Object = mainplayer
        navparam.OriginSceneSid = worldSid
        navparam.TargetSceneSid = targetsceneid
        local navitem = _G.NavManager:GetInstance():DoNavMove(navparam)
        if navitem == nil then
            _G.PopWindowManager:GetInstance():ShowAllTips(_G.TipsSystemCfgDic.task.CanNotGo)
            if _G.AppSetting.DEBUG then
                _G.LogError("无法寻路 至目标点 targetsceneid:" .. targetsceneid)
            end
        else
            navitem:AddListener(
                _G.NavItemEvent,
                _G.NavItemEvent.EnumValue.NavComplete,
                self.OnSceneNavigationComplete,
                self,
                true
            )
        end
    else
        _G.LogUtilities.Log(
            _G.EModuleName.TaskModule,
            string.format("当前场景:%d和目标场景:%d相同，无需引导切换场景!", worldSid, targetsceneid)
        )
        self:OnSceneNavigationComplete()
    end
end

---[private]执行任务NPC寻路导航
---@param npcid number @目标NPC id
function BaseTask:DoNPCNavigation(npcid)
    if _G.WorldManager:GetInstance():GetCurWorld() == nil then
        return
    end
    -- _G.LogUtilities.Log(_G.EModuleName.TaskModule, string.format("BaseTask:DoNPCNavigation(%d)", npcid))
    ---@type WorldNPCItem
    local npc = _G.WorldManager:GetInstance():GetCurWorld():GetItemInfo(npcid)
    if npc == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(" 未在该场景 找到NPC:" .. npcid)
        end
        return
    end
    if _G.IsNil(npc.Transform) or npc.Transform:GetActiveSelf() == 0 then
        if _G.AppSetting.DEBUG then
            _G.LogError(" 该NPC已隐藏 不可寻路 NPCid:" .. npcid)
        end
        return
    end

    ---@type NavParam
    local navparam = {}
    navparam.Position = _G.Vector3.New(npc.Transform:GetPosition())
    navparam.Object = _G.WorldManager:GetInstance():GetCurWorldPlayer()

    local x, y, z = npc.Transform:GetPosition()
    local x1, y1, z1 = navparam.Object.Transform:GetPosition()

    local subX = x - x1
    local subY = y - y1
    local subZ = z - z1
    subX = Mathf.Abs(subX)
    subY = Mathf.Abs(subY)
    subZ = Mathf.Abs(subZ)
    local sub = subX + subY + subZ
    if sub < 3 then
        self:OnNPCNavigationComplete()
        return
    end
    local navitem, navstate = _G.NavManager:GetInstance():DoNavMove(navparam)
    ---寻路点太近
    if navitem == nil and navstate == _G.NavState.TooClose then
        self:OnNPCNavigationComplete()
    else
        navitem:AddListener(
            _G.NavItemEvent,
            _G.NavItemEvent.EnumValue.NavComplete,
            self.OnNPCNavigationComplete,
            self,
            true
        )
    end
end

