---@class BaseTask : BaseEvent @任务基类抽象
---@field protected TaskID number @任务ID
---@field protected TaskCfg task_cfg @当前任务对应的配置数据段(方便快速读取)
---@field protected type ETaskType @任务类型
---@field protected ParentTaskID number @父任务ID
---@field protected AllTaskContentsID number[] @所有任务内容ID列表
---@field protected AllTaskContents BaseTaskContent[] @所有的任务内容列表
---@field protected AllClaimPreConditionsInfo number[] @任务领取的前置条件ID列表
---@field protected AllClaimPreConditions BaseTaskCondition[] @任务领取的前置条件列表
---@field protected IsExecuting boolean @当前任务是否正在执行
---@field protected OnSceneNavCompleteCB function @场景导航完成回调
---@field protected OnNavCompleteCB function @导航完成回调
---@field protected RecentlyCompletedTaskContent BaseTaskContent @最近完成的任务内容
---@field protected ClaimedNPCUID number @任务领取的NPC UID
---@field protected SubmitedNPCUID number @任务提交的NPC UID
---@field protected ClaimedAPS AutomaticPlayStory @任务接受时的自动化剧情播放
---@field protected AfterSubmitAPS AutomaticPlayStory @任务提交后的自动化剧情播放
---@field protected StoryTriggerType EStoryTriggerType @触发器触发任务剧情类型
---@field protected StoryTriggerUid number @触发器触发UID
---@field protected StoryTriggerAPS AutomaticPlayStory @触发器可触发任务时机的自动化剧情播放(时机分类：0.接受前；1.接收时到提交前；2.提交后)(默认只允许配一个)
---@field protected complete_parameters number[] @完成条件参数（1: %玩家对话；2:副本采集(key:副本sid*10+0|1，value），次数；3:采集道具（key:道具sid，value:数量);4:击杀怪物(key:怪物sid，value:数量);5::数值任务(key:数值类型(1:玩家等级)，value:目标数值))）
---@field protected complete_num number 需要完成的任务目标个数
local BaseTask = _G.BaseClass("BaseTask", _G.BaseEvent)
BaseTask.TaskID = nil
BaseTask.TaskCfg = nil
BaseTask.type = nil
BaseTask.ParentTaskID = nil
BaseTask.AllTaskContentsID = nil
BaseTask.AllTaskContents = nil
BaseTask.AllClaimPreConditionsInfo = nil
BaseTask.AllClaimPreConditions = nil
BaseTask.IsExecuting = false
BaseTask.OnSceneNavCompleteCB = nil
BaseTask.OnNavCompleteCB = nil
BaseTask.RecentlyCompletedTaskContent = nil
BaseTask.ClaimedNPCUID = nil
BaseTask.SubmitedNPCUID = nil
BaseTask.ClaimedAPS = nil
BaseTask.AfterSubmitAPS = nil
BaseTask.StoryTriggerType = nil
BaseTask.StoryTriggerUid = nil
BaseTask.StoryTriggerAPS = nil

BaseTask.complete_parameters = nil
BaseTask.complete_num = nil

---BaseTask构造函数
---@param taskid number @任务ID
function BaseTask:__init(taskid)
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, string.format("构建任务ID:%d的任务抽象!", taskid))
    self.TaskID = taskid
    -- 读取任务相关表格数据
    self.TaskCfg = _G.ConfigManager.task_cfg[taskid]
    self.type = self.TaskCfg.Type1
    self.ParentTaskID = self.TaskCfg.ParentTaskID
    self.AllTaskContentsID = self.TaskCfg.complete_parameters
    self.AllTaskContents = {}
    self.AllClaimPreConditionsInfo = self.TaskCfg.conditions
    self.AllClaimPreConditions = {}
    self.IsExecuting = false
    if #self.TaskCfg.rec_npc > 0 then
        self.ClaimedNPCUID = tonumber(self.TaskCfg.rec_npc[2])
    end
    if #self.TaskCfg.submit > 0 then
        self.SubmitedNPCUID = tonumber(self.TaskCfg.submit[2])
    end
    self.ClaimedAPS = _G.AutomaticPlayStory.New()
    self.AfterSubmitAPS = _G.AutomaticPlayStory.New()
    if #self.TaskCfg.StoryTriggerParams > 0 then
        _G.LogUtilities.Log(_G.EModuleName.TaskModule, self.TaskCfg.StoryTriggerParams)
        self.StoryTriggerType = tonumber(self.TaskCfg.StoryTriggerParams[1])
        self.StoryTriggerUid = tonumber(self.TaskCfg.StoryTriggerParams[2])
        self.StoryTriggerAPS = _G.AutomaticPlayStory.New()
        _G.LogUtilities.Log(
            _G.EModuleName.TaskModule,
            string.format(
                "任务ID:%s创建触发器剧情数据初始化, StoryTriggerType:%s, StoryTriggerUid:%s!",
                self.TaskID,
                self.StoryTriggerType,
                self.StoryTriggerUid
            )
        )
    end
    self.complete_parameters = self.TaskCfg.complete_parameters
    ---需要完成的任务目标个数
    self.complete_num = self.TaskCfg.complete_num

    -- 任务领取前置条件相关数据
    if self:IsAvalibleClaim() == 1 then
        _G.LogUtilities.Log(_G.EModuleName.TaskModule, "任务可领取，构建领取前置条件数据!")
        for k, v in pairs(self.AllClaimPreConditionsInfo) do
            _G.LogUtilities.Log(_G.EModuleName.TaskModule, "ClaimPreCondition:", v)
            local conditiontype = tonumber(v[1])
            local conditionparams = v[2]
            local claimpretaskcondition = _G.TaskUtilities.CreateTaskCondition(self, conditiontype, conditionparams)
            table.insert(self.AllClaimPreConditions, claimpretaskcondition)
        end
    end
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "是最里层任务，构建任务内容数据!")
    --
    if _G.AppSetting.DEBUG then
        _G.Log("是最里层任务，构建任务内容数据", "<color=red>" .. ">>>" .. "</color>")
    end
    -- _G.print_table(self.AllTaskContentsID)
    local index = 1
    for k, v in pairs(self.AllTaskContentsID) do
        _G.LogUtilities.Log(_G.EModuleName.TaskModule, "TaskContentID:", v)
        local taskcontent = _G.TaskUtilities.CreateTaskContent(self, v, index)
        index = index + 1
        table.insert(self.AllTaskContents, taskcontent)
        if taskcontent:IsDone() == false then
            _G.LogUtilities.Log(
                _G.EModuleName.TaskModule,
                string.format("任务ID：%d的任务内容ID:%d处于未完成状态，监听完成状态!", self.TaskID, taskcontent.TaskContentID)
            )
            taskcontent:AddListener(
                _G.BaseTaskContentEvent,
                _G.BaseTaskContentEvent.EnumValue.TaskContentComplete,
                self.OnTaskContentComplete,
                self,
                true
            )
        end
    end
end

---任务内容完成回调
---@param taskcontent BaseTaskContent @任务内容
function BaseTask:OnTaskContentComplete(taskcontent)
    if _G.AppSetting.DEBUG then
        _G.Log(_G.EModuleName.TaskModule, string.format("任务内容ID:%d完成!", taskcontent.TaskContentID))
    end
    self.RecentlyCompletedTaskContent = taskcontent
    -- self:UpdateTaskContentsInfo()
    if self:IsAvalibleSubmit() then
        _G.LogUtilities.Log(
            _G.EModuleName.TaskModule,
            string.format(
                "self.RecentlyCompletedTaskContent.IsAfterStoryCompleted = %s",
                self.RecentlyCompletedTaskContent.IsAfterStoryCompleted
            )
        )
        if
            self.RecentlyCompletedTaskContent:HasAfterStory() and
                self.RecentlyCompletedTaskContent.IsAfterStoryCompleted == false
         then
            _G.LogUtilities.Log(_G.EModuleName.TaskModule, "有后置剧情需要等待播放完成!")
            self.RecentlyCompletedTaskContent:AddListener(
                _G.BaseTaskContentEvent,
                _G.BaseTaskContentEvent.EnumValue.AfterStoryComplete,
                self.OnTaskContentAfterStoryCompleted,
                self,
                true
            )
        else
            _G.LogUtilities.Log(_G.EModuleName.TaskModule, "无后置剧情需要等待播放完成!")
            _G.LogUtilities.Log(_G.EModuleName.TaskModule, string.format("任务ID:%d满足提交条件，自动提交!", self.TaskID))
            if self.TaskCfg.is_auto_submit == 1 then
                self:SubmitTask()
            end
        end
    end
end

---获取任务数据(每次都从任务数据模块获取最新的)
---@return task.i_task @对应的任务数据
function BaseTask:GetTaskInfo()
    --return _G.TaskModule:GetInstance():GetTaskInfo(self.type, self.TaskID)
    local taskinfo = _G.TaskModule:GetInstance():GetTaskInfo(self.type, self.TaskID)
    if taskinfo ~= nil then
        return taskinfo
    else
        if _G.AppSetting.DEBUG then
            _G.LogError(string.format("找不到任务类型:%s任务ID:%s的任务信息!", self.type, self.TaskID))
        end
        return nil
    end
end

---获取任务状态
---@return ETaskState @任务状态
function BaseTask:GetTaskState()
    local taskinfo = self:GetTaskInfo()
    if taskinfo ~= nil then
        return taskinfo.state
    else
        return nil
    end
end

---获取任务最上层任务
---@return BaseTask @最上层任务
function BaseTask:GetRootTask()
    local roottask = self
    while roottask ~= nil and roottask.ParentTaskID ~= 0 do
        local newroottask = _G.TaskModule:GetInstance():GetTaskInfo(self.type, roottask.ParentTaskID)
        if newroottask ~= nil then
            roottask = newroottask
        else
            return roottask
        end
    end
    return roottask
end

---获取父任务任务数据
---@return BaseTask @父任务任务数据(没有返回nil)
function BaseTask:GetParentTask()
    if self.ParentTaskID ~= 0 then
        return _G.TaskModule:GetInstance():GetTask(self.type, self.ParentTaskID)
    else
        return nil
    end
end

---获取任务完成进度
---Note:
---如果任务是最里层任务即包含任务内容的任务，任务完成进度 = 任务内容完成数
---如果任务是非最里层任务即包含任务内容的任务，任务完成进度 = 子任务完成数
function BaseTask:GetTaskCompleteProgress()
    return self:GetCompletedTaskContentNumber()
end

---获取已完成的任务内容数量
---Note:
---仅当此任务是最里层任务即包含任务内容的任务时才有意义
function BaseTask:GetCompletedTaskContentNumber()
    local completedtaskcontentnumber = 0
    for k, v in pairs(self.AllTaskContents) do
        ---@type BaseTaskContent
        local taskcontent = v
        if taskcontent.IsDone() then
            completedtaskcontentnumber = completedtaskcontentnumber + 1
        end
    end
    return completedtaskcontentnumber
end

---得到当前任务第一个可执行的任务内容
---@return BaseTaskContent @任务内容
function BaseTask:GetFirstAvalibleExecuteTaskContent()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "BaseTask:GetFirstAvalibleExecuteTaskContent()")
    for index, taskcontent in ipairs(self.AllTaskContents) do
        if taskcontent:IsAvalibleExecute() then
            return taskcontent
        end
    end
    return nil
end

---更新任务内容信息(当任务信息更新时需要触发其旗下的任务内容信息更新)
function BaseTask:UpdateTaskContentsInfo()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "BaseTask:UpdateTaskCOntentsInfo()")
    for _, taskContent in pairs(self.AllTaskContents) do
        taskContent:UpdateInfo()
    end
    local taskinfo = self:GetTaskInfo()
    if _G.TaskUtilities.GetTaskProgressIsAllOver(self) and taskinfo.state ~= _G.TaskEnum.ETaskState.Completed then
        taskinfo.state = _G.TaskEnum.ETaskState.Completed
    end

    _G.TaskModule:GetInstance():DispatchEvent(
        _G.TaskModuleEvent,
        _G.TaskModuleEvent.EnumValueTable.TaskInfoUpdate,
        self.TaskID
    )

    if
        _G.TaskModule:GetInstance():IsCompletedTask(self.TaskID) == false and self:IsAvalibleSubmit() and
            self.TaskCfg.is_auto_submit == 1
     then
        self:SubmitTask()
    end
end

---[public]执行当前任务里第一个可做的任务内容(如果未领取则先判定是否可领取并引导对应操作)
---@return boolean @是否成功执行任务
function BaseTask:ExecuteTask()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "BaseTask:ExecuteTask()")
    --执行任务流程(无论是领取还是执行任务内容还是提交任务)：
    --1. 执行任务场景导航
    --2. 执行任务目标导航
    --3. 执行任务相关操作
    if self:IsAvalibleClaim() == 1 then
        self.IsExecuting = true
        self:ExecuteClaimTask()
        return true
    elseif self:IsAvalibleExecute() then
        --TODO:执行第一个可做的子任务
        --elseif
        --已经是最里层任务，直接执行任务内容(暂时默认内容只有一个)

        for i = 1, #self.AllTaskContents do
            local Content = self.AllTaskContents[i]
            if Content:IsAvalibleExecute() and Content:ExecuteTask() then
                self.IsExecuting = true
                _G.LogUtilities.Log(
                    _G.EModuleName.TaskModule,
                    string.format("任务ID:%d是最里层任务，执行任务内容ID:%d!", self.TaskID, Content.TaskContentID)
                )
                return true
            end
        end

        if _G.AppSetting.DEBUG then
            _G.LogWarning(" 无 可执行任务")
        end
        return false
    elseif self:IsAvalibleSubmit() then
        if self:IsDone() then
            --提交任务
            self.IsExecuting = true
            self:SubmitTask(true)
            return true
        else
            if _G.AppSetting.DEBUG then
                _G.Log(string.format("当前任务状态%s不满足提交条件,提交失败!", self.TaskState))
            end
            return false
        end
    else
        if _G.AppSetting.DEBUG then
            _G.Log(string.format("当前任务ID:%s任务状态:%s不满足执行状态要求!", self.TaskID, self.TaskState))
        end
        return false
    end
end

---[private]执行领取当前任务操作
function BaseTask:ExecuteClaimTask()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "BaseTask:ExecuteClaimTask()")
    local scenceID = tonumber(self.TaskCfg.rec_npc[1])
    --场景寻路引导
    if scenceID ~= nil then
        ---如果 不在关卡里
        if not _G.WorldManager:GetInstance():CheckSceneType(_G.SceneType.Section) then
            local openSectionID = tonumber(self.TaskCfg.rec_npc[3])
            local chapterID = tonumber(self.TaskCfg.rec_npc[4])
            if openSectionID ~= nil and chapterID ~= nil then
                --- 就打开 关卡选择界面
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.SelectSectionMapView.Name,
                    chapterID,
                    openSectionID,
                    function()
                        -- body
                    end
                    -- ,            self.TaskContentCfg.TaskContentParam[2]
                )

                return
            end
            if _G.WorldManager:GetInstance():GetCurWorldSid() == scenceID then
                ---如果是当前场景 则不处理
            elseif _G.ConfigManager.scene_world_cfg[scenceID] ~= nil then
                --- 如果是其他主城场景 打开世界地图 ZHJ-3788
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WorldMapView.Name)
                return
            end
        end

        _G.LogUtilities.Log(_G.EModuleName.TaskModule, string.format("领任务ID:%d 场景:%d引导", self.TaskID, scenceID))
        self.OnSceneNavCompleteCB = _G.handler(self, self.OnClaimTaskSceneNavigationComplete)
        self.OnNavCompleteCB = _G.handler(self, self.OnClaimTaskNPCNavigationComplete)
        self:DoSceneNavigation(scenceID)
    elseif self.TaskCfg.is_auto_receive then
        self:DoClaimTask()
    else
        _G.LogUtilities.Log(_G.EModuleName.TaskModule, string.format("领任务ID:%d不需要场景引导", self.TaskID))
    end
end

---打断当前任务正在做的任务内容
---@return boolean @是否打断任务成功
function BaseTask:InterruptTaskExecution()
    if self.IsExecuting == true then
        self.OnSceneNavCompleteCB = nil
        self.OnNavCompleteCB = nil
        if self:IsAvalibleClaim() == 1 then
            --打断任务领取
            self.IsExecuting = false
            self:DispatchEvent(_G.BaseTaskEvent, _G.BaseTaskEvent.EnumValue.TaskInterrupt, self)
            return true
        elseif self:IsAvalibleExecute() then
            --TODO:打断第一个可做的子任务
            --elseif
            --打断执行任务内容
            self.IsExecuting = false
            self:DispatchEvent(_G.BaseTaskEvent, _G.BaseTaskEvent.EnumValue.TaskInterrupt, self)
            return true
        elseif self:IsAvalibleSubmit() then
            --打断任务提交
            self.IsExecuting = false
            self:DispatchEvent(_G.BaseTaskEvent, _G.BaseTaskEvent.EnumValue.TaskInterrupt, self)
            return true
        else
            if _G.AppSetting.DEBUG then
                _G.Log(string.format("当前任务ID:%s任务状态:%s不满足打断状态要求!", self.TaskID, self.TaskState))
            end
            return false
        end
    else
        if _G.AppSetting.DEBUG then
            _G.Log(string.format("当前任务ID:%s并未处于执行中，打断失败!", self.TaskID))
        end
        return false
    end
end

