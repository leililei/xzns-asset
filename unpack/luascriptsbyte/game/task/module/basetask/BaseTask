---是否是最上层任务即主任务(没有父任务的任务即为最顶层任务)
---@return bool @是否是最上层任务即主任务(没有父任务的任务即为最顶层任务)
function BaseTask:IsRootTask()
    return self.ParentTaskID == 0
end

---@return number @任务是否可领取(-1-前置条件不满足 0-WaitClaim状态不满足 1-可领取)[public]
function BaseTask:IsAvalibleClaim()
    local taskinfo = self:GetTaskInfo()
    if taskinfo.state == _G.TaskEnum.ETaskState.WaitClaim then
        if self.TaskCfg.per_sid ~= 0 then
            --TODO:如果有领取前置条件写在这(e.g. 等级条件，前置任务条件等)
            for key, perTaskid in pairs(self.TaskCfg.per_sid) do
                if perTaskid ~= 0 then
                    local perTask = _G.TaskModule:GetInstance():GetTaskInfoWithID(perTaskid)
                    if _G.IsNil(perTask) or perTask.state ~= _G.TaskEnum.ETaskState.Completed then
                        return -1
                    end
                end
            end
        end

        for k, v in pairs(self.AllClaimPreConditions) do
            ---@type BaseTaskCondition
            local claimprecondition = v
            if claimprecondition:CheckCondition() == false then
                return -1
            end
        end
        return 1
    else
        return 0
    end
end

---@return boolean @任务是否可执行(Executing状态才允许执行)[public]
function BaseTask:IsAvalibleExecute()
    -- TODO:修改可执行状态判定到正确状态
    local taskinfo = self:GetTaskInfo()
    local parenttask = self:GetParentTask()
    return taskinfo.state == _G.TaskEnum.ETaskState.Claimed and
        (parenttask == nil or (parenttask ~= nil and parenttask:IsAvalibleExecute()))
end

---@return boolean @任务是否可放弃[public]
function BaseTask:IsAvalibleGiveUp()
    --配置表配置是否可放弃且无父任务(即为根任务)的才可以放弃
    local taskinfo = self:GetTaskInfo()
    local isroottask = self:IsRootTask()
    return taskinfo.state == _G.TaskEnum.ETaskState.Claimed and isroottask and self.TaskCfg.IsTaskAbandonable
end

---@return boolean @任务是否可提交[public]
function BaseTask:IsAvalibleSubmit()
    if self.type == _G.TaskEnum.ETaskType.NoviceTask or self.type == _G.TaskEnum.ETaskType.MainTask then
        --- 新手任务 必须  顺序依次提交
        if self.TaskCfg.per_sid[1] ~= nil and TaskModule:GetInstance():IsCompletedTask(self.TaskCfg.per_sid[1]) == false then
            return
        end
    end
    --TODO:
    --任务可提交相关判定
    local isalltaskcontentcompleted = true
    ---@type taskcontent BaseTaskContent @任务内容
    for k, taskcontent in pairs(self.AllTaskContents) do
        if taskcontent:IsDone() == false then
            isalltaskcontentcompleted = false
            return self:IsDone() or isalltaskcontentcompleted
        end
    end
    _G.LogUtilities.Log(
        _G.EModuleName.TaskModule,
        string.format("任务ID:%d是否可提交:%s", self.TaskID, self:IsDone() or isalltaskcontentcompleted)
    )
    return self:IsDone() or isalltaskcontentcompleted
end

---@return boolean @任务是否已放弃[public]
function BaseTask:IsGiveUped()
    local taskinfo = self:GetTaskInfo()
    return taskinfo.state == _G.TaskEnum.ETaskState.GiveUp
end

---@return boolean @任务是否完成[public]
function BaseTask:IsDone()
    local taskinfo = self:GetTaskInfo()
    return taskinfo.state == _G.TaskEnum.ETaskState.Completed
end

---@return boolean @任务是否已提交[public]
function BaseTask:IsSubmitted()
    local taskinfo = self:GetTaskInfo()
    --现在没有任务提交状态，所以默认Completed等价于Submited
    return taskinfo.state == _G.TaskEnum.ETaskState.Completed
    --return taskinfo.state == _G.TaskEnum.ETaskState.Submited
end

