---更新触发器剧情监听
function BaseTask:UpdateStoryTriggerListener()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "BaseTask:UpdateStoryTriggerListener()")
    if self.StoryTriggerAPS ~= nil then
        --TODO:优化成判定是否有监听的形式再移除
        _G.Events:GetInstance():RemoveListener(_G.eTriggerStatus.TriggerEnter, self.OnWorldTriggerEnter, self)
        local taskstate = self:GetTaskState()
        _G.LogUtilities.Log(
            _G.EModuleName.TaskModule,
            string.format("self.StoryTriggerType = %s taskstate = %s", self.StoryTriggerType, taskstate)
        )
        if self.StoryTriggerType == _G.EStoryTriggerType.BeforeClaimed and taskstate == _G.TaskEnum.ETaskState.WaitClaim then
            _G.LogUtilities.Log(_G.EModuleName.TaskModule, string.format("任务ID:%s监听接受前触发器剧情监听!", self.TaskID))
            _G.Events:GetInstance():AddListener(_G.eTriggerStatus.TriggerEnter, self.OnWorldTriggerEnter, self)
        elseif
            self.StoryTriggerType == _G.EStoryTriggerType.AfterClaimedBeforeSubmited and
                taskstate > _G.TaskEnum.ETaskState.WaitClaim and
                taskstate < _G.TaskEnum.ETaskState.Completed
         then
            _G.LogUtilities.Log(_G.EModuleName.TaskModule, string.format("任务ID:%s监听接受后提交前触发器剧情监听!", self.TaskID))
            _G.Events:GetInstance():AddListener(_G.eTriggerStatus.TriggerEnter, self.OnWorldTriggerEnter, self)
        elseif
            self.StoryTriggerType == _G.EStoryTriggerType.AfterSubmited and
                taskstate == _G.TaskEnum.ETaskState.Completed
         then
            _G.LogUtilities.Log(_G.EModuleName.TaskModule, string.format("任务ID:%s监听提交后触发器剧情监听!", self.TaskID))
            _G.Events:GetInstance():AddListener(_G.eTriggerStatus.TriggerEnter, self.OnWorldTriggerEnter, self)
        else
            _G.LogUtilities.LogError(_G.EModuleName.TaskModule, string.format("不支持的剧情触发器类型:%s", self.StoryTriggerType))
        end
    end
end

