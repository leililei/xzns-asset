---添加指定任务(private)
---@param task BaseTask @任务数据
---@return boolean @是否添加任务成功
function TaskModule:AddTask(task)
    assert(task, "不允许添加空任务!")
    if self.AllTasksMap[task.type][task.TaskID] == nil then
        self.AllTasksMap[task.type][task.TaskID] = task

        if task:IsDone() then
            return
        end

        if task.type == _G.TaskEnum.ETaskType.MainTask then
            self:OnAddMainTask(task)
        elseif task.type == _G.TaskEnum.ETaskType.NoviceTask then
            self:OnAddNoviceTask(task)
        elseif task.type == _G.TaskEnum.ETaskType.BranchTask then
            self:OnAddBrachTask(task)
        elseif task.type == _G.TaskEnum.ETaskType.DailyTask then
            self:OnAddDailyTask(task)
        end

        -- 监听任务领取
        if
            task:HasListener(_G.BaseTaskEvent, _G.BaseTaskEvent.EnumValue.TaskClaimed, self.OnTaskClaimCompleted, self) ==
                false
         then
            task:AddListener(_G.BaseTaskEvent, _G.BaseTaskEvent.EnumValue.TaskClaimed, self.OnTaskClaimCompleted, self)
        end

        if
            task:HasListener(_G.BaseTaskEvent, _G.BaseTaskEvent.EnumValue.TaskSubmit, self.OnTaskSubmitCompleted, self) ==
                false
         then
            -- 监听任务提交
            task:AddListener(_G.BaseTaskEvent, _G.BaseTaskEvent.EnumValue.TaskSubmit, self.OnTaskSubmitCompleted, self)
        end

        -- 处理任务可领取相关逻辑代码
        if task:IsAvalibleClaim() == 1 and task.ClaimedNPCUID ~= nil then
            if self.WaitClaimedTasksMap[task.ClaimedNPCUID] == nil then
                self.WaitClaimedTasksMap[task.ClaimedNPCUID] = {}
            end
            _G.LogUtilities.Log(
                _G.EModuleName.TaskModule,
                string.format("添加NPC UID:%d需要领取的任务ID:%d", task.ClaimedNPCUID, task.TaskID)
            )
            table.insert(self.WaitClaimedTasksMap[task.ClaimedNPCUID], task)
            -- 通知头顶提示刷新
            WorldUtils.UpdateWorldItemTip(task.ClaimedNPCUID)
        end

        -- 处理任务可提交相关逻辑代码
        if (task:IsAvalibleExecute() == true or task:IsAvalibleClaim() == 1) and task.SubmitedNPCUID ~= nil then
            if self.WaitSubmitedTasksMap[task.SubmitedNPCUID] == nil then
                self.WaitSubmitedTasksMap[task.SubmitedNPCUID] = {}
            end
            _G.LogUtilities.Log(
                _G.EModuleName.TaskModule,
                string.format("添加NPC UID:%d需要提交的任务ID:%d", task.SubmitedNPCUID, task.TaskID)
            )
            table.insert(self.WaitSubmitedTasksMap[task.SubmitedNPCUID], task)
            -- 通知头顶提示刷新
            WorldUtils.UpdateWorldItemTip(task.SubmitedNPCUID)
        end

        -- 处理任务 可执行相关逻辑代码
        if task:IsAvalibleExecute() == true then
            -- 处理任务内容的创建响应
            self:OnAddTaskContents(task)
        end

        return true
    else
        if _G.AppSetting.DEBUG then
            _G.LogError(string.format("已经添加过任务类型:%s,任务ID:%d的任务，无法再次添加!", task.type, task.TaskID))
        end
        return false
    end
end

---响应任务领取完成
function TaskModule:OnTaskClaimCompleted(task)
