---@param tasktype TaskEnum.type @任务类型
---@param filterfunc funtion(taskcontent:BaseTaskContent):bool @任务内容过滤条件
---@return BaseTaskContent[] @对应的所有任务内容
function TaskModule:GetAllTaskContent(tasktype, filterfunc)
    filterfunc = filterfunc or nil
    local alltaskcontents = {}
    local allroottasks = self:GetAllRootTask(tasktype)
    ---@type BaseTask roottask
    for k, roottask in pairs(allroottasks) do
        _G.table.insertto(alltaskcontents, roottask:GetAllTaskContents(filterfunc))
    end
    return alltaskcontents
end

---改变主线任务
---@param newmaintask MainTask @新的主线任务
function TaskModule:ChangeMainTask(newmaintask)
    if newmaintask == nil or newmaintask.type ~= _G.TaskEnum.ETaskType.MainTask then
        return
    end
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, string.format("切换当前主任务到任务ID:%d", newmaintask.TaskID))
    if self:IsCompletedTask(newmaintask.TaskID) == true then
        return
    end
    if
        -- 当前主线任务完成才切换--  临时
        (not _G.IsNil(self.CurrentMainTask) and
            self:GetTaskInfoWithID(self.CurrentMainTask.TaskID).state ~= _G.TaskEnum.ETaskState.Completed) and
            -- 或者该任务已领取
            (self:GetTaskInfoWithID(newmaintask.TaskID).state ~= _G.TaskEnum.ETaskState.Claimed)
     then
        return
    end

    self.CurrentMainTask = newmaintask
    -- self:DispatchEvent(_G.TaskModuleEvent, _G.TaskModuleEvent.EnumValueTable.MainTaskUpdate, self.DoingMainTask)
end

