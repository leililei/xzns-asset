---根据 前置任务id  获取所有任务
---@param dailytaskid number @需要判定的日常任务id
function TaskModule:GetAllTask_byPer(persid)
    local tasks = {}
    local taskconfig = _G.ConfigManager.task_cfg

    ---@type task_cfg_Item
    for taskid, taskinfomap in pairs(taskconfig) do
        local isAdd = false

        if
            table.find(
                taskinfomap.per_sid,
                function(v)
                    return v == persid
                end
            )
         then
            isAdd = true
            for key, perTaskid in pairs(taskinfomap.per_sid) do
                local perTask = _G.TaskModule:GetInstance():GetTaskInfoWithID(perTaskid)
                if _G.IsNil(perTask) or perTask.state ~= _G.TaskEnum.ETaskState.Completed then
                    isAdd = false
                    break
                end
            end
        end

        if isAdd then
            table.insert(tasks, taskid)
        end
    end
    return tasks
end

--- region 任务头顶提示部分
---获取指定对象的任务提示类型
---@param uid number @NPC UID
---@return EWorldItemTipType @任务提示类型
function TaskModule:GetTaskTipType(worlditem, uid)
    -- NPC头顶提示优先级:
    -- 任务可提交 > 对话提示 > 可接受任务 > 可提交但不满足提交条件提示
    --- 支线 用蓝色问号 感叹号     主线用橙色

    local tipsPath = WorldData.EWorldItemTipType.None
    -- 任务可提交
    local isSubmitTask, taskSubmit = self:IsWorldItemHasAvalibleSubmitTask(uid)
    if isSubmitTask then
        if
            taskSubmit ~= nil and
                (taskSubmit.TaskCfg.Type1 == _G.TaskEnum.ETaskType.MainTask or
                    taskSubmit.TaskCfg.Type1 == _G.TaskEnum.ETaskType.NoviceTask)
         then
            tipsPath = WorldData.EWorldItemTipType.orangeDoubt
        else
            tipsPath = WorldData.EWorldItemTipType.blueDoubt
        end
        return tipsPath
    end

    -- 对话提示
    if self:IsWorldItemHasDialogueTaskLeft(uid) then
        -- DialogueTip    --临时TaskAvalibleClaimedTip
        return WorldData.EWorldItemTipType.DialogueTip --  WorldData.EWorldItemTipType.TaskAvalibleClaimedTip
    end

    -- 任务可领取
    local isClaimedTask, taskClaimed = self:IsWorldItemHasAvalibleClaimedTask(uid)
    if isClaimedTask then
        if
            taskClaimed ~= nil and
                (taskClaimed.TaskCfg.Type1 == _G.TaskEnum.ETaskType.MainTask or
                    taskClaimed.TaskCfg.Type1 == _G.TaskEnum.ETaskType.NoviceTask)
         then
            tipsPath = WorldData.EWorldItemTipType.orangeMarvel
        else
            tipsPath = WorldData.EWorldItemTipType.blueMarvel
        end
        return tipsPath
    end

    -- 任务不满足提交
    if self:IsHasUnavalibleSubmitTask(uid) then
        return WorldData.EWorldItemTipType.TaskUnavalibleSubmitTip
    end
    return WorldData.EWorldItemTipType.None
end

--- 指定对象是否有满足提交条件的可提交任务
---@param uid number @对象UID
---@return boolean,BaseTask @指定NPC是否有可提交的任务
function TaskModule:IsWorldItemHasAvalibleSubmitTask(uid)
    if self.WaitSubmitedTasksMap[uid] ~= nil and #self.WaitSubmitedTasksMap[uid] > 0 then
        for key, task in pairs(self.WaitSubmitedTasksMap[uid]) do
            if task ~= nil and task:IsAvalibleSubmit() then
                return true, task
            end
        end
    end
    return false
end

