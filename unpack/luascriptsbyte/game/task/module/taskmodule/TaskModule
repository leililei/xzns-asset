end

---移除指定任务信息
---@param taskinfo task.TaskInfo @任务信息
---@return boolean @移除任务信息是否成功
function TaskModule:RemoveTaskInfo(taskinfo)
    assert(taskinfo, "不允许移除空任务信息!")
    local TaskCfg = _G.ConfigManager.task_cfg[taskinfo.sid]
    local result = self:GetTaskInfo(TaskCfg.Type1, taskinfo.sid)
    if result ~= nil then
        _G.LogUtilities.Log(
            _G.EModuleName.TaskModule,
            string.format("移除任务类型:%s 任务ID:%s的任务信息", TaskCfg.Type1, taskinfo.sid)
        )

        self.AllTaskInfosMap[TaskCfg.Type1][taskinfo.sid] = nil
        self:RemoveTask(TaskCfg.Type1, taskinfo.sid)
    else
        if _G.AppSetting.DEBUG then
            _G.LogError(string.format("任务类型:%s,任务ID:%d的任务信息不存在,无法移除!", TaskCfg.Type1, taskinfo.id))
        end
        return false
    end
end
