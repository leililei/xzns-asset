function TaskModule:OnAddTaskContents(task)
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "TaskModule:OnAddTaskContents()")
    WorldUtils.UpdateWorldItemTip(task.ClaimedNPCUID)
    local taskcontents = task.AllTaskContents
    for k, taskcontent in pairs(taskcontents) do
        table.insert(self.AllTaskContents, taskcontent)
        if _G.IsClass(taskcontent, _G.NPCDialogueTaskContent) then
            if self.DialogueTaskContentsMap[taskcontent.NpcUid] == nil then
                self.DialogueTaskContentsMap[taskcontent.NpcUid] = {}
            end
            if not table.ContainsValue(self.DialogueTaskContentsMap[taskcontent.NpcUid], taskcontent) then
                _G.LogUtilities.Log(
                    _G.EModuleName.TaskModule,
                    string.format("添加世界对象 UID:%d的对话任务,任务内容ID:%d", taskcontent.NpcUid, taskcontent.TaskContentID)
                )
                table.insert(self.DialogueTaskContentsMap[taskcontent.NpcUid], taskcontent)
                -- 监听任务内容完成情况，方便移除相关数据
                taskcontent:AddListener(
                    _G.BaseTaskContentEvent,
                    _G.BaseTaskContentEvent.EnumValue.TaskContentComplete,
                    self.OnTaskContentCompleted,
                    self
                )
                -- 通知头顶提示刷新
