function TaskModule:ClaimAllTask_byPer(nowTaskSid)
    --          -- 接取  前置任务id  为该任务的所有任务
    local tasklist = _G.TaskModule:GetInstance():GetAllTask_byPer(nowTaskSid)

    local nowTask = self:GetTaskWithID(nowTaskSid)
    if #tasklist == 0 then
        --- 如果当前任务完成 且无后续任务
        if self:IsCompletedTask(nowTaskSid) == true then
            if nowTask.type == _G.TaskEnum.ETaskType.MainTask then
                self.CurrentMainTask = nil
            elseif nowTask.type == _G.TaskEnum.ETaskType.NoviceTask then
                self.CurrentNoviceTask = nil
            end
            return
        end
    else
        for index, tasksid in ipairs(tasklist) do
            local taskInfo = self:GetTaskInfoWithID(tasksid)
            if taskInfo == nil then
                ---@type task.i_task
                local i_task = {}
                i_task.sid = tasksid
                i_task.state = _G.TaskEnum.ETaskState.WaitClaim
                self:AddTaskInfo(i_task)
                local task = self:GetTaskWithID(tasksid)
                if task.TaskCfg.is_auto_receive then
                    self:AcceptTask(tasksid, _G.handler(task, task.OnReplyClaimTask))
                end
            else
                local task = self:GetTaskWithID(tasksid)
                if task ~= nil then
                    if task.type == _G.TaskEnum.ETaskType.MainTask then
                        self:ChangeMainTask(task)
                    elseif task.type == _G.TaskEnum.ETaskType.NoviceTask then
                        self:ChangeNoviceTask(task)
                    end
                end
            end
        end
    end
end

function TaskModule:AcceptTask(taskid, funLua)
    local taskcfg = _G.ConfigManager.task_cfg[taskid]
    if taskcfg == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(" 没有该任务配置 taskid:" .. taskid)
        end
        return
    end
    --2. 提交任务(需要发送消息)
    ---@type task.c2s_task_accept
    local finishpbdata = {}
    finishpbdata.sid = taskid
    if taskcfg.Type1 == _G.TaskEnum.ETaskType.MainTask or taskcfg.Type1 == _G.TaskEnum.ETaskType.NoviceTask then
        require("TaskNet"):GetInstance():Accept(finishpbdata, funLua)
    elseif taskcfg.Type1 == _G.TaskEnum.ETaskType.BranchTask then
        if _G.ChapterRoomManager:GetInstance():CheckResetTaskid(taskid) then
            require("TaskNet"):GetInstance():AcceptSectionTaskSides(finishpbdata, funLua)
        else
            require("TaskNet"):GetInstance():AcceptTaskSides(finishpbdata, funLua)
        end
    end
end

function TaskModule:FinishTask(taskid, funLua)
    ---关卡最后的boss任务不提交 免得关卡重置还提交任务报错
    -- local ignore = {
    --     [312010108] = true,
    --     [312010206] = true,
    --     [312010310] = true
    -- }
    -- if ignore[taskid] then
    --     return
    -- end

    --- 缓存提交任务 防止多次提交 服务器推送人物内容完成/前端检测任务内容完成
    if self.FinishTaskDic == nil then
        self.FinishTaskDic = {}
    end

    if self.FinishTaskDic[taskid] ~= nil and os.time() - self.FinishTaskDic[taskid] < 3 then
        return
    end

    local taskcfg = _G.ConfigManager.task_cfg[taskid]
    if taskcfg == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(" 没有该任务配置 taskid:" .. taskid)
        end
        return
    end

    self.FinishTaskDic[taskid] = os.time()

    local ReFun = function()
        if funLua ~= nil then
            funLua()
            funLua = nil
        end
        _G.Events:GetInstance():Broadcast(
            _G.eIllustrationsToUnlockEvent.Unlock,
            {
                taskid
            }
        )
    end

    --2. 提交任务(需要发送消息)
    ---@type task.c2s_task_accept
    local finishpbdata = {}
    finishpbdata.sid = taskid
    finishpbdata.finish_type = 2
    if taskcfg.Type1 == _G.TaskEnum.ETaskType.MainTask or taskcfg.Type1 == _G.TaskEnum.ETaskType.NoviceTask then
        require("TaskNet"):GetInstance():Finish(finishpbdata, ReFun)
    elseif taskcfg.Type1 == _G.TaskEnum.ETaskType.BranchTask then
        if _G.ChapterRoomManager:GetInstance():CheckResetTaskid(taskid) then
            require("TaskNet"):GetInstance():FinishSectionTaskSides(finishpbdata, ReFun)
        else
            require("TaskNet"):GetInstance():FinishTaskSides(finishpbdata, ReFun)
        end
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("没有该任务类型提交")
        end
    end
end

