---指定任务id是否已领取   (可执行就是已领取)
---@param taskid number @需要判定的任务id
function TaskModule:IsTaskIdAvalibleExecute(taskid)
    ---@type TaskConfig_Item
    local TaskCfg = _G.ConfigManager.task_cfg[taskid]
    if not TaskCfg then
        if _G.AppSetting.DEBUG then
            _G.LogError("未找到任务配置 id = " .. tostring(taskid), "TaskModule:IsTaskIdAvalibleExecute")
        end
        return false
    end
    local task = self:GetTask(TaskCfg.Type1, taskid)
    if task ~= nil then
        return task:IsAvalibleExecute()
    else
        return false
    end
end

---指定任务id是否 满足提交条件
