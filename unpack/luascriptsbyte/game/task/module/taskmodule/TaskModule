---根据关卡id  获得对应的所有关卡房间任务id
function TaskModule:FinishAFkChapterTask(afkstageIdS)
    local cfg = _G.ConfigManager.task_cfg
    ---@param a task_cfg
    ---@type task_cfg[]
    local taskcfgS =
        _G.table.chooseToArray(
        cfg,
        function(k, v)
            return v.Type1 == _G.TaskEnum.ETaskType.MainTask and
                table.find(
                    afkstageIdS,
                    function(finv)
                        return finv == v.chapter
                    end
                ) ~= nil
        end
    )
    if taskcfgS ~= nil then
        local index = 1

        local Finish
        local addFun
        addFun = function(taskid)
            if _G.AppSetting.DEBUG then
                _G.LogError(" 章节奖励任务   已完成 " .. taskid)
            end
            index = index + 1
            if index > #taskcfgS then
                return
            else
                Finish()
            end
        end

        Finish = function()
            if taskcfgS[index] == nil then
                return
            end
            local taskid = taskcfgS[index].ID
            if self:IsCompletedTask(taskid) == true then
                addFun(taskid)
            elseif self:GetTaskWithID(taskid) == nil then
                _G.DelayDo(
                    0.2,
                    function()
                        if _G.AppSetting.DEBUG then
                            _G.LogError(" 章节奖励任务   准备完成 " .. taskid)
                        end
                        self:FinishTask(
                            taskid,
                            function()
                                addFun(taskid)
                            end
                        )
                    end
                )
            else
                if _G.AppSetting.DEBUG then
                    _G.LogError(" 章节奖励任务   准备完成 " .. taskid)
                end
                self:FinishTask(
                    taskid,
                    function()
                        addFun(taskid)
                    end
                )
            end
        end
        Finish()
    end
