---移除指定任务(private)
---@param tasktype task.ETaskType @任务类型
---@param taskid number @任务id
---@return boolean @是否移除任务成功
function TaskModule:RemoveTask(tasktype, taskid)
    local task = self:GetTask(tasktype, taskid)
    if task ~= nil then
        self.AllTasksMap[tasktype][taskid] = nil
        if tasktype == _G.TaskEnum.ETaskType.MainTask then
            self:OnRemoveMainTask(task)
        elseif tasktype == _G.TaskEnum.ETaskType.NoviceTask then
            self:OnRemoveNoviceTask(task)
        elseif tasktype == _G.TaskEnum.ETaskType.BranchTask then
            self:OnRemoveBrachTask(task)
        elseif tasktype == _G.TaskEnum.ETaskType.DailyTask then
            self:OnRemoveDailyTask(task)
        end

        ---响应任务内容的移除
        self:OnRemoveTaskContents(task.AllTaskContents)
        if self.WaitClaimedTasksMap[task.ClaimedNPCUID] ~= nil then
            self.WaitClaimedTasksMap[task.ClaimedNPCUID] = nil
        end
        if self.WaitSubmitedTasksMap[task.SubmitedNPCUID] ~= nil then
            self.WaitSubmitedTasksMap[task.SubmitedNPCUID] = nil
        end

        task:RemoveListener(_G.BaseTaskEvent, _G.BaseTaskEvent.EnumValue.TaskClaimed, self.OnTaskClaimCompleted, self)
        task:RemoveListener(_G.BaseTaskEvent, _G.BaseTaskEvent.EnumValue.TaskSubmit, self.OnTaskSubmitCompleted, self)
        return true
    else
        return false
    end
end

