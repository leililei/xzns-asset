---- missionExtra 34打头  mission 33打头   task31打头的
local missionExtra_Min = 340000000
local missionExtra_Max = 349999999
local mission_Min = 330000000
local mission_Max = 339999999
local task_Min = 310000000
local task_Max = 319999999
local gm_Min = 350000000 --GM活动任务
local gm_Max = 359999999 --GM活动任务
----根据任务id返回任务配置
function TaskModule:GetTaskCfgEnumByTaskid(taskid)
    local enum
    taskid = tonumber(taskid)
    if taskid == nil then
        return
    end
    if taskid >= missionExtra_Min and taskid <= missionExtra_Max then
        enum = _G.TaskCfgEnum.missionExtra
    elseif taskid >= mission_Min and taskid <= mission_Max then
        --- 每日 / 成就
        enum = _G.TaskCfgEnum.mission
    elseif taskid >= task_Min and taskid <= task_Max then
        --- 主线任务
        enum = _G.TaskCfgEnum.task
    elseif taskid >= gm_Min and taskid <= gm_Max then
        enum = _G.TaskCfgEnum.gmActivityTask
    end
    return enum
end

----根据任务id返回任务配置
function TaskModule:GetTakCfgByTaskid(taskid, TaskCfgEnum)
    taskid = tonumber(taskid)
    if taskid == nil then
        return
    end
    if TaskCfgEnum == nil then
        TaskCfgEnum = self:GetTaskCfgEnumByTaskid(taskid)
    end
    local cfg
    if TaskCfgEnum == _G.TaskCfgEnum.missionExtra then
        --- 七日任务
        cfg = _G.ConfigManager.mission_extra_cfg
    elseif TaskCfgEnum == _G.TaskCfgEnum.mission then
        --- 每日 / 成就
        cfg = _G.ConfigManager.mission_cfg
    elseif TaskCfgEnum == _G.TaskCfgEnum.task then
        --- 主线任务
        cfg = _G.ConfigManager.mission_cfg
    end
    if cfg then
        return cfg[taskid]
    end
end

