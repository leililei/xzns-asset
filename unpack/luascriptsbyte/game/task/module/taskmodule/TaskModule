---是否存在 可接取的关卡任务 (主城接剧本任务)
function TaskModule:UnLockSectionTask()
    local getTask = {}
    local len = #self.SectionTaskidArr
    for i = 1, len do
        local taskid = self.SectionTaskidArr[i]
        if self:IsCompletedTask(taskid) then
            -- return
        else
            local taskCfg = _G.ConfigManager.task_cfg[taskid]
            if self.AllTasksMap[taskCfg.Type1][taskid] ~= nil then
                -- return
            else
                local tSectionid = taskCfg.script_type[1]
                if require("ChapterModel"):GetInstance():CheckSection(tSectionid) then
                    table.insert(getTask, taskid)
                    break
                end
            end
        end
    end
    return getTask
end

---是否存在 当前关卡里可接取的任务 (关卡里接可重置的关卡任务 )
function TaskModule:ReceiveSectionBranchTaskTask(sectionid, roomid)
    local getTask = {}

    local Addfun = function(taskid)
        local taskCfg = _G.ConfigManager.task_cfg[taskid]
        if taskCfg == nil then
            return
        end
        if taskCfg.per_sid ~= nil then
            ---如果前置任务没完成
            local DontPerTask =
                table.find(
                taskCfg.per_sid,
                function(per_sid)
                    return self:IsCompletedTask(per_sid) == false
                end
            )
            if DontPerTask ~= nil then
                --- 不能显示领取
                return
            end
        end

        if self.AllTasksMap[taskCfg.Type1][taskid] ~= nil then
            -- return
        else
            local tSectionid = taskCfg.script_type[1]
            local tRoomid = taskCfg.script_type[2]
            if sectionid == tSectionid and roomid == tRoomid then
                table.insert(getTask, taskid)
            end
        end
    end

    local len = #self.SectionBranchTaskidArr
    for i = 1, len do
        local taskid = self.SectionBranchTaskidArr[i]

        --- 已完成 就不加
        if self:IsCompletedTask(taskid) then
            -- return
        else
            Addfun(taskid)
        end
    end
    for _, v in pairs(getTask) do
        local taskid = v
        ---@type task.i_task
        local i_task = {}
        i_task.sid = taskid
        i_task.state = _G.TaskEnum.ETaskState.WaitClaim
        _G.TaskModule:GetInstance():AddTaskInfo(i_task)
        local task = _G.TaskModule:GetInstance():GetTaskWithID(taskid)
        --- 自动领取 无前置 无场景npc的任务
        if task.TaskCfg.is_auto_receive and task.TaskCfg.per_sid[1] == nil and task.TaskCfg.rec_npc[1] == nil then
            _G.TaskModule:GetInstance():AcceptTask(taskid, _G.handler(task, task.OnReplyClaimTask))
        end
    end
end

---获取所有关卡任务
---@return number[],number[] taskid[]  关卡任务,关卡内支线任务
function TaskModule:GetAllSectionTask()
    local SectionTask = {}
    local SectionBranchTask = {}

    local cfg = _G.ConfigManager.task_cfg
    ---@param lkey task_cfg_Item
    ---@param rkey task_cfg_Item
    ---@param v task_cfg_Item
    table.walksort(
        cfg,
        function(lkey, rkey)
            local dataL = cfg[lkey]
            local dataR = cfg[rkey]
            return dataL.ID < dataR.ID
        end,
        function(taskid, v)
            if v.script_type ~= nil then
                local tSectionid = v.script_type[1]
                if tSectionid ~= nil then
                    local tRoomid = v.script_type[2]
                    if tRoomid ~= nil then
                        table.insert(SectionBranchTask, taskid)
                    else
                        table.insert(SectionTask, taskid)
                    end
                end
            end
        end
    )
    return SectionTask, SectionBranchTask
end

---根据关卡id  获得对应的关卡任务id
function TaskModule:GetTaskIdBySectionId(sectionid)
    for _, taskid in pairs(self.SectionTaskidArr) do
        local taskCfg = _G.ConfigManager.task_cfg[taskid]
        local taskSection = taskCfg.script_type[1]
        if taskSection ~= nil and taskSection == sectionid then
            return taskid
        end
    end
    return nil
end

---根据关卡id  获得对应的所有关卡房间任务id
function TaskModule:GetRoomTaskIdArrBySectionId(sectionid)
    local arr = {}
    for _, taskid in pairs(self.SectionBranchTaskidArr) do
        local taskCfg = _G.ConfigManager.task_cfg[taskid]
        local taskSection = taskCfg.script_type[1]
        if taskSection ~= nil and taskSection == sectionid then
            table.insert(arr, taskid)
        end
    end
    return arr
end

---根据关卡id  获得对应的所有关卡房间任务id
function TaskModule:ResetSectionRoomTask(sectionid)
    local taskidArr = self:GetRoomTaskIdArrBySectionId(sectionid)
    local taskinfoArr = {}
    for i = 1, #taskidArr do
        local taskid = taskidArr[i]
        self:DelCompletedTask(taskid)
        local taskinfo = self:GetTaskInfoWithID(taskid)
        if taskinfo ~= nil then
            table.insert(taskinfoArr, taskinfo)
        end
    end
    if #taskinfoArr > 0 then
        self:RemoveTaskInfos(taskinfoArr)
    end
end

