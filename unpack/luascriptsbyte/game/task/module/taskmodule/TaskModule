--- 指定对象是否有不满足提交条件的可提交任务
---@param uid number @对象UID
---@return boolean @指定对象是否有不满足提交条件的可提交任务
function TaskModule:IsHasUnavalibleSubmitTask(uid)
    if self.WaitSubmitedTasksMap[uid] ~= nil and #self.WaitSubmitedTasksMap[uid] > 0 then
        for k, v in pairs(self.WaitSubmitedTasksMap[uid]) do
            ---@type BaseTask
            local task = v
            if task:IsAvalibleSubmit() == false then
                return true
            end
        end
        return false
    else
        return false
    end
end

