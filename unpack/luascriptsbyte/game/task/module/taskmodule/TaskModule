function TaskModule:CheckIsRoomTask(taskid)
    local taskCfg = _G.ConfigManager.task_cfg[taskid]
    local taskSection = taskCfg.script_type[1]
    local roomid = taskCfg.script_type[2]
    return taskSection ~= nil and roomid ~= nil
end

