--- 指定对象是否还有剩余对话任务
---@param uid number @对象UID
---@return boolean,BaseTask @指定NPC是否还有剩余对话任务
function TaskModule:IsWorldItemHasDialogueTaskLeft(npcid)
    if self.DialogueTaskContentsMap[npcid] ~= nil and #self.DialogueTaskContentsMap[npcid] > 0 then
        local t_task = self.DialogueTaskContentsMap[npcid]
        for npcuid, taskContent in ipairs(t_task) do
