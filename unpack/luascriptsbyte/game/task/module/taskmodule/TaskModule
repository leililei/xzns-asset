--- 指定对象是否有可接受任务
---@param uid number @对象UID
---@return boolean,BaseTask @指定对象是否有可接受任务
function TaskModule:IsWorldItemHasAvalibleClaimedTask(npcid)
    if self.WaitClaimedTasksMap[npcid] ~= nil and #self.WaitClaimedTasksMap[npcid] > 0 then
        local t_task = self.WaitClaimedTasksMap[npcid]
        for _, basetask in ipairs(t_task) do
            return true, basetask
