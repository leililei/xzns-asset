function TaskModule:UpDatecollector(taskinfos)
    if taskinfos == nil then
        return
    end
    for key, value in pairs(taskinfos.collector) do
        local list = require("AcientEvilComesModel"):GetInstance():GetNumcollectors(value.key)

        if list ~= nil then
            for s, b in pairs(list.mission_group) do
                local a = _G.ConfigManager.mission_extra_cfg[b]
                local state = _G.TaskEnum.ETaskState.Claimed
                if a.count <= value.value then
                    if require("AcientEvilComesModel"):GetInstance():Getstate(b) == _G.TaskEnum.ETaskState.Completed then
                        state = _G.TaskEnum.ETaskState.Completed
                    else
                        state = _G.TaskEnum.ETaskState.Submited
                    end
                end

                local task = {sid = b, state = state, target = {[1] = value.value}, cfg = a}
                task.id = list
                require("AcientEvilComesModel"):GetInstance():UpdataTask(task, value.value)
            end
        end
    end
end

