function TaskModule:Dispose()
    for k, v in pairs(_G.TaskEnum.ETaskType) do
        self:RemoveTaskInfos(self.AllTaskInfosMap[v])
    end
    rawset(self._class_type, "Singleton", nil)
end

---执行指定任务(执行任务统一接口，请勿直接调用BaseTask:ExecuteTask())
---@param task BaseTask @任务
---@return boolean @是否成功执行任务
function TaskModule:ExecuteTask(task)
    assert(task, "无法执行空任务!")
    if task:ExecuteTask() then
        self.CurrentDoingTask = task
        _G.LogUtilities.Log(_G.EModuleName.TaskModule, string.format("执行任务ID:%d", self.CurrentDoingTask.TaskID))
        return true
    else
        return false
    end
end

---打断当前任务正在做的任务内容(打断当前正在做的任务统一接口，请勿直接调用BaseTask:InterruptTaskExecution())
---@param task BaseTask @任务
---@return boolean @是否成功执行任务
function TaskModule:InterruptDoingTaskExecution()
    if self.CurrentDoingTask ~= nil and self.CurrentDoingTask:InterruptTaskExecution() then
        _G.LogUtilities.Log(_G.EModuleName.TaskModule, string.format("打断任务ID:%d", self.CurrentDoingTask.TaskID))
        self.CurrentDoingTask = nil
        return true
    else
        if _G.AppSetting.DEBUG then
            _G.Log("当前没有在做任务，打断任务失败!")
        end
        return false
    end
end

