    if not TaskCfg then
        if _G.AppSetting.DEBUG then
            _G.LogError("未找到任务配置 id = " .. tostring(taskid), "TaskModule:IsTaskIdSubmited")
        end
        return false
    end
    local task = self:GetTask(TaskCfg.Type1, taskid)
    if task ~= nil then
        return task:IsSubmitted()
    else
        return false
    end
end

