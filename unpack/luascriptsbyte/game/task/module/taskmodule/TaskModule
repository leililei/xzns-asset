                        string.format(
                            "重复添加世界对象 UID:%d的对话任务,任务内容ID:%d,添加对话任务内容失败!",
                            taskcontent.NpcUid,
                            taskcontent.TaskContentID
                        )
                    )
                end
            end
        elseif _G.IsClass(taskcontent, _G.MonsterFightTaskContent) then
            if self.FightTaskContentsMap[taskcontent.MonsterID] == nil then
                self.FightTaskContentsMap[taskcontent.MonsterID] = {}
            end
            if not table.ContainsValue(self.FightTaskContentsMap[taskcontent.MonsterID], taskcontent) then
                _G.LogUtilities.Log(
                    _G.EModuleName.TaskModule,
                    string.format("添加世界对象 UID:%d的战斗任务,任务内容ID:%d", taskcontent.MonsterID, taskcontent.TaskContentID)
                )
                table.insert(self.FightTaskContentsMap[taskcontent.MonsterID], taskcontent)
                -- 监听任务内容完成情况，方便移除相关数据
                taskcontent:AddListener(
                    _G.BaseTaskContentEvent,
                    _G.BaseTaskContentEvent.EnumValue.TaskContentComplete,
                    self.OnTaskContentCompleted,
                    self
                )
                -- 通知头顶提示刷新
                WorldUtils.UpdateWorldItemTip(taskcontent.MonsterID)
            else
                if _G.AppSetting.DEBUG then
                    _G.LogError(
                        string.format(
                            "重复添加世界对象 UID:%d的战斗任务,任务内容ID:%d,添加战斗任务内容失败!",
                            taskcontent.MonsterID,
                            taskcontent.TaskContentID
                        )
                    )
                end
            end
        elseif _G.IsClass(taskcontent, _G.CommonTaskContent) then
            local key = tostring(taskcontent.OwnerTask.TaskID) .. tostring(taskcontent.TaskContentID)
            if self.CommonTaskContentsMap[key] == nil then
                self.CommonTaskContentsMap[key] = {}
            end
            if not table.ContainsValue(self.CommonTaskContentsMap[key], taskcontent) then
                table.insert(self.CommonTaskContentsMap[key], taskcontent)
                -- 监听任务内容完成情况，方便移除相关数据
                taskcontent:AddListener(
                    _G.BaseTaskContentEvent,
                    _G.BaseTaskContentEvent.EnumValue.TaskContentComplete,
                    self.OnTaskContentCompleted,
                    self
                )
            end
