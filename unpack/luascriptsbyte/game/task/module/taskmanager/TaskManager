---@class TaskManager : GameDataModelBase    中文描述
local TaskManager = _G.BaseClass("TaskManager", _G.GameDataModelBase)

---创建对象时,入口构造函数
function TaskManager:__init()
    self.finish_task = nil
    self.MainTaskdata = nil
end

function TaskManager:GetDataFormServer()
    self:GetTaskMains()
end

function TaskManager:ParseData(SidesTaskdata, MainTaskdata)
    --- 所有已完成的任务
    local finish_task = {}
    if SidesTaskdata.finish_task ~= nil then
        for _, taskid in pairs(SidesTaskdata.finish_task) do
            if _G.TaskModule:GetInstance():CheckIsRoomTask(taskid) then
                _G.TaskModule:GetInstance():SetCompletedRoomTask(taskid)
                _G.TaskModule:GetInstance():SetCompletedTask(taskid)
            else
                local task = {}
                task.sid = taskid
                task.state = _G.TaskEnum.ETaskState.Completed
                table.insert(finish_task, task)

                _G.TaskModule:GetInstance():SetCompletedTask(taskid)
            end
        end
    end
    if MainTaskdata.finish_task ~= nil then
        for _, taskid in pairs(MainTaskdata.finish_task) do
            local task = {}
            task.sid = taskid
            task.state = _G.TaskEnum.ETaskState.Completed
            _G.TaskModule:GetInstance():SetCompletedTask(taskid)
            table.insert(finish_task, task)
        end
    end

    --- 当前正在进行的任务
    local current_task = {}
    if SidesTaskdata.task ~= nil then
        table.insertto(current_task, SidesTaskdata.task)
    end
    if MainTaskdata.task ~= nil then
        table.insertto(current_task, MainTaskdata.task)
    end

    --- 所有已知任务 入库
    -- local allhavetask = {}
    -- table.insertto(allhavetask, finish_task)

    _G.TaskModule:GetInstance():AddTaskInfos(finish_task)

    self.finish_task = finish_task
    self.MainTaskdata = MainTaskdata
    self.current_task = current_task
    self.super.ParseData(self)
end

---初始化功能逻辑
function TaskManager:InitFunction()
    _G.SortList(
        self.current_task,
        function(a)
            return a.sid
        end
    )
    _G.TaskModule:GetInstance():AddTaskInfos(self.current_task)

    --- 所有当前任务不算当前完成   副本任务1 完成过 关卡重置 再次领取副本任务1 不完成 是当前任务
    for _, task in pairs(self.current_task) do
        _G.TaskModule:GetInstance():DelCompletedTask(task.sid)
    end

    --- 所有已完成的任务检测 是否有可领取的后续任务
    for key, taskinfo in pairs(self.finish_task) do
        _G.TaskModule:GetInstance():ClaimAllTask_byPer(taskinfo.sid)
    end

    local maintask = _G.TaskModule:GetInstance().CurrentMainTask
    if table.isEmptyOrNil(maintask) then
        local NoviceTasks = _G.ConfigManager.discrete_cfg[103601]
        if NoviceTasks ~= nil then
            NoviceTasks = NoviceTasks[1]
        end
        -- 103401
        local oneTaskid
        if self.MainTaskdata.finish_task ~= nil then
            _G.SortList(
                self.MainTaskdata.finish_task,
                function(v)
                    return v
                end
            )
            oneTaskid = self.MainTaskdata.finish_task[1]
            _G.TaskModule:GetInstance():ClaimAllTask_byPer(oneTaskid)
        else
            --- 如果 有新手任务
            if NoviceTasks ~= nil then
                for i = 1, #NoviceTasks do
                    oneTaskid = NoviceTasks[i]
                    local i_task = {}
                    i_task.sid = oneTaskid
                    i_task.state = _G.TaskEnum.ETaskState.WaitClaim
                    _G.TaskModule:GetInstance():AddTaskInfo(i_task)
                    local task = _G.TaskModule:GetInstance():GetTaskWithID(oneTaskid)
                    _G.TaskModule:GetInstance():AcceptTask(oneTaskid, _G.handler(task, task.OnReplyClaimTask))
                end
            end
            ---查找第一个主线任务
            local onetaskcfg = table.find(
                _G.ConfigManager.task_cfg,
                function(v)
                    --- 主线 无前置任务
                    return v.Type1 == _G.TaskEnum.ETaskType.MainTask and table.isEmptyOrNil(v.per_sid)
                end
            )
            if onetaskcfg ~= nil then
                oneTaskid = onetaskcfg.ID
                ---@type task.i_task
                local i_task = {}
                i_task.sid = oneTaskid
                i_task.state = _G.TaskEnum.ETaskState.WaitClaim
                _G.TaskModule:GetInstance():AddTaskInfo(i_task)
                local task = _G.TaskModule:GetInstance():GetTaskWithID(oneTaskid)
                if task.TaskCfg.is_auto_receive then
                    _G.TaskModule:GetInstance():AcceptTask(oneTaskid, _G.handler(task, task.OnReplyClaimTask))
                end
            else
                if _G.AppSetting.DEBUG then
                    _G.LogError("未找到启始主线任务")
                end
            end
        end
    elseif maintask:IsDone() then
        --- 如果当前主线任务已完成 就领取后续任务
        -- _G.TaskModule:GetInstance():ClaimAllTask_byPer(maintask.TaskID)
    end

    --通知任务模块任务数量变化
    _G.TaskModule:GetInstance():DispatchEvent(_G.TaskModuleEvent, _G.TaskModuleEvent.EnumValueTable.TaskNumberUpdate)

    --177任务类型: 同时拥有x个y星的彩色品质的饰品
    --任务进度从SpiritualStorage中获取饰品列表, 但英雄穿戴的饰品在StorageManager:InitFunction()中才会加入SpiritualStorage中, 因此在其之后手动触发一次任务
    local order = 4
    _G.Events:GetInstance():Broadcast(
        _G.ePlayAactionEvent.PlayAaction,
        {
            _G.ActiveTaskEnum.ConditionEnum.Spiritual.LevelNum,
            order,
            0
        },
        1
    )
end

---主任务
function TaskManager:GetTaskMains()
    require("TaskNet"):GetInstance():GetTaskMains(_G.handler(self, self.GetTaskMainsCallBack))
end

---@param data task.ReplyGetTaskMains
function TaskManager:GetTaskMainsCallBack(data)
    self:GetTaskSides(data)
end

---获取支线任务
