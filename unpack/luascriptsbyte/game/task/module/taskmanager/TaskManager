                            totalNum = totalNum + 1
                            if totalNum >= num then
                                break
                            end
                        end
                    end
                end

                local count = totalNum >= num and task.Cfg.count or totalNum
                okfun({ task.taskEnumType }, count, true)
            end,
            [_G.ActiveTaskEnum.ConditionEnum.WarTechnology.RaceCurMaxStar] = function(task, okfun)
