                local race = task.taskcontentparams[2]
                local order = task.taskcontentparams[3]
                local star = task.taskcontentparams[4]

                local allstar = {}

                ---@type table<number, CardData>
                local allCards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card)
                if allCards then
                    for _, v in pairs(allCards) do
                        local sid = v.sid
                        if require "CardInfoManager":GetInstance():CheckMultiMatchCOP(v.cfg.Elements_new, race) and v.cfg.Order >= order then
                            if nil == allstar[sid] then
                                allstar[sid] = v:GetStar()
                            elseif allstar[sid] < v:GetStar() then
                                allstar[sid] = v:GetStar()
                            end
                        end
                    end
                end

                local totalNum = 0
                for k, v in pairs(allstar) do
                    totalNum = totalNum + v
                end
                local count = totalNum >= star and task.Cfg.count or totalNum
                okfun({ task.taskEnumType }, count, true)
            end,
            [_G.ActiveTaskEnum.ConditionEnum.WarTechnology.RaceAwakeMaxLevel] = function(task, okfun)
                ---X种族#品质角色总觉醒等级达到Y
                local race = task.taskcontentparams[2]
                local order = task.taskcontentparams[3]
                local awake = task.taskcontentparams[4]
                local allpotential = {}

                ---@type table<number, CardData>
                local allCards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card)
                if allCards then
                    for _, v in pairs(allCards) do
                        if require "CardInfoManager":GetInstance():CheckMultiMatchCOP(v.cfg.Elements_new, race) and v.cfg.Order >= order then
