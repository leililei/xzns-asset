                --LogError(require "DungeonChallengeModel":GetInstance().max_chapter)
                local count = require "DungeonChallengeBattleModel":GetInstance():GetLevelID()
                -- LogError(count)
                okfun({ task.taskEnumType }, chapter <= count and 1 or 0, true)
            end,
            [_G.ActiveTaskEnum.ConditionEnum.DungeonChallenge.LightSomeEquip] = function(task, okfun)
                local type = task.taskcontentparams[2]
                local num = task.taskcontentparams[3]
                local list = require "DungeonChallengeIllustrationModel":GetInstance():CheckNumByType(type)

                local count = (list and #list > num) and task.Cfg.count or #list
                okfun({ task.taskEnumType }, count, true)
            end,
            [_G.ActiveTaskEnum.ConditionEnum.ActivityTour.CorrectGuessWinCount] = function(task, okfun)
                local type = task.taskcontentparams[1]
                local num = task.taskcontentparams[2]
                local model = require("ActivityTournamentModel"):GetInstance()
                if model.GuessData and model.GuessData.guess_role then
                   model:GetGuessWinCount(function(winCount)
                       local count = (winCount > num) and task.Cfg.count or winCount
                       okfun({ task.taskEnumType }, count, true)
                   end)
                end
            end,
            [_G.ActiveTaskEnum.ConditionEnum.ActivityTour.CumulativeSpeechDay] = function(task, okfun)
                local type = task.taskcontentparams[1]
                local num = task.taskcontentparams[2]
                local model = require("ActivityTournamentModel"):GetInstance()
                local dayCount = 0
                if model.StageData and model.StageData.eliminate_info and model.StageData.eliminate_info.chat_day then
                    dayCount = model.StageData.eliminate_info.chat_day
                elseif model.StageData and model.StageData.champion_info and model.StageData.champion_info.chat_day then
                    dayCount = model.StageData.champion_info.chat_day
                end
                local count = (dayCount > num) and task.Cfg.count or dayCount
                okfun({ task.taskEnumType }, count, true)
            end,
            [_G.ActiveTaskEnum.ConditionEnum.Beast.BeastStar] = function(task, okfun)
                local sid = task.taskcontentparams[2]
                local star = task.taskcontentparams[3]
                local model = require("BeastModel"):GetInstance()
                local beastStar = model:GetBeast(sid).star
                local count = (beastStar > star) and star or beastStar
                okfun({ task.taskEnumType }, count, true)
            end,
            [_G.ActiveTaskEnum.ConditionEnum.Beast.BeastQualityStarNum] = function(task, okfun)
                local order = task.taskcontentparams[2]
                local star = task.taskcontentparams[3]
                local num = task.taskcontentparams[4]
                local model = require("BeastModel"):GetInstance()
                local beastCount = 0
                for _, v in pairs(model:GetAllActiveBeasts()) do
                    if v:GetOrder() == order then
                        if v:GetStar() >= star then 
                            beastCount = beastCount + 1
                        end
                    end
                end
                local count = (beastCount > num) and num or beastCount
                okfun({ task.taskEnumType }, count, true)
            end,
            [_G.ActiveTaskEnum.ConditionEnum.Gemstone.HasGemWithGradeHistory] = function(task, okfun)
                --- 同时拥有x个y品质或以上的宝石
                local star = task.taskcontentparams[2]
                local num = task.taskcontentparams[3]
                local totalNum = 0
                local gemList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Gemstone)
                if gemList then
                    for _, gem in pairs(gemList) do
                        if gem:GetStar() >= star then
                            totalNum = totalNum + 1
                        end
                    end
                end
                local count = (totalNum > num) and task.Cfg.count or totalNum
                okfun({ task.taskEnumType }, count, true)
            end,
            [_G.ActiveTaskEnum.ConditionEnum.Gemstone.HasGemWithLevelHistory] = function(task, okfun)
                --- 同时拥有x个y等级或以上的宝石
                local level = task.taskcontentparams[2]
                local num = task.taskcontentparams[3]
                local totalNum = 0
                local gemList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Gemstone)
                if gemList then
                    for _, gem in pairs(gemList) do
                        if gem:GetLevel() >= level then
                            totalNum = totalNum + 1
                        end
                    end
                end
                local count = (totalNum > num) and task.Cfg.count or totalNum
                okfun({ task.taskEnumType }, count, true)
            end,
        }
    end

    ---任务枚举 ID
    -- task.taskEnumType
    ---任务参数
    -- task.taskcontentparams
    local fun = taskEnumTypeFunDic[task.taskEnumType]
    if fun ~= nil then
        fun(task, okfun)
    end
end

---标记任务完成
---@param Data table 七日目标天Data.dayid   手册idData.manualId
function TaskManager.MarkTask(eMarkTaskType, taskid, Data, task)
    local pbData = TaskManager.MarkTaskGetpPbData(eMarkTaskType, taskid, Data)
    if pbData == nil then
        return
    end
    require("AchieveTipManager"):GetInstance():Show(taskid)
    if eMarkTaskType == _G.MarkTaskType.Achieve then
        ----@type achieve.c2s_achieve_finish
        require("TaskNet"):GetInstance():MarkFinishAchieve(pbData)
    elseif eMarkTaskType == _G.MarkTaskType.WarTechnology then
        if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.WarTechnology) then
            require("WarTechnologyNet"):GetInstance():FinishTask(pbData)
        end
    else
        pbData.finish_type = 1

        if eMarkTaskType == _G.MarkTaskType.Daily then
            -- -@type task.c2s_task_batch_finish
            require("TaskNet"):GetInstance():DailyTask_Finish(pbData)
        elseif eMarkTaskType == _G.MarkTaskType.Goals then
            -- -@type task_goals.c2s_task_goals_finish
            --require("ActionGoalsNet"):GetInstance():SendTaskOneFinish(pbData)
            require "ActionGoalsModel":GetInstance():SendTaskFinshSign(pbData, task)
        elseif eMarkTaskType == _G.MarkTaskType.Keynote then
            -- -@type task_goals.c2s_task_goals_finish
            --require("ActionGoalsNet"):GetInstance():SendTaskOneFinish(pbData)
            require "ActionKeynoteModel":GetInstance():SendTaskFinshSign(pbData, task)
        elseif eMarkTaskType == _G.MarkTaskType.Hell then
            -- -@type task.c2s_task_finish
            require("HellRoadNet"):GetInstance():FinishTask(pbData)
        elseif eMarkTaskType == _G.MarkTaskType.Manual then
            -- -@type handbook.c2s_handbook_finish
            require("ManualNet"):GetInstance():Finish(pbData)
        elseif eMarkTaskType == _G.MarkTaskType.TaskMain then
            require("TaskNet"):GetInstance():Finish(pbData)
        elseif eMarkTaskType == _G.MarkTaskType.TaskSection then
            require("TaskNet"):GetInstance():FinishSectionTaskSides(pbData)
        elseif eMarkTaskType == _G.MarkTaskType.TaskSides then
            require("TaskNet"):GetInstance():FinishTaskSides(pbData)
        elseif eMarkTaskType == _G.MarkTaskType.SeasonBoss then
            require("SeasonNet"):GetInstance():FinishBossTask(pbData)
        elseif eMarkTaskType == _G.MarkTaskType.ActiveSeverMerge then
            require("ActiveSeverMergeModel"):GetInstance():SendTaskFinshSign(pbData)
        else
            if _G.AppSetting.DEBUG then
                _G.Log("", "<color=red>" .. "类型无效" .. "</color>")
            end
            return
        end
    end
end

---标记任务完成 获取pbData
---@param Data table 七日目标天Data.dayid   手册idData.manualId
function TaskManager.MarkTaskGetpPbData(eMarkTaskType, taskid, Data)
    if Data == nil then
        if _G.AppSetting.DEBUG then
            _G.Log("", "<color=red>" .. "参数错误" .. "</color>")
        end
        return
    end

    if eMarkTaskType == _G.MarkTaskType.Achieve then
        ---@type achieve.c2s_achieve_finish
        local pbdata = {}
        pbdata.sids = { taskid }
        return pbdata
    else
        if eMarkTaskType == _G.MarkTaskType.Daily then
            ---@type task.c2s_task_batch_finish
            local pbdata = {}
            pbdata.sid = { taskid }
            return pbdata
        elseif eMarkTaskType == _G.MarkTaskType.Goals then
            if Data == nil or Data.dayid == nil then
                if _G.AppSetting.DEBUG then
                    _G.Log("", "<color=red>" .. "参数无效" .. "</color>")
                end
                return
            end
            ---@type task_goals.c2s_task_goals_finish
            local pbdata = {}
            local T = { day = Data.dayid, sid = { taskid } }
            pbdata.task = { T }
            return pbdata
        elseif eMarkTaskType == _G.MarkTaskType.Keynote then
            if Data == nil or Data.dayid == nil then
                if _G.AppSetting.DEBUG then
                    _G.Log("", "<color=red>" .. "参数无效" .. "</color>")
                end
                return
            end
            ---@type task_keynote.c2s_task_keynote_finish
            local pbdata = {}
            pbdata.day = Data.dayid
            pbdata.sid = taskid
            return pbdata
        elseif eMarkTaskType == _G.MarkTaskType.Hell then
            ---@type task.c2s_task_finish
            local pbdata = {}
            pbdata.sid = taskid
            return pbdata
        elseif eMarkTaskType == _G.MarkTaskType.Manual then
            if Data == nil or Data.manualId == nil then
                if _G.AppSetting.DEBUG then
                    _G.Log("", "<color=red>" .. "参数无效" .. "</color>")
                end
                return
            end
            ---@type handbook.c2s_handbook_finish
            local pbdata = {}
            pbdata.t_sid = { taskid }
            pbdata.sid = Data.manualId
            return pbdata
        elseif eMarkTaskType == _G.MarkTaskType.TaskMain then
            ---@type task.c2s_task_finish
            local pbdata = {}
            pbdata.sid = taskid
            return pbdata
        elseif eMarkTaskType == _G.MarkTaskType.TaskSection then
            ---@type task.c2s_task_finish
            local pbdata = {}
            pbdata.sid = taskid
            return pbdata
        elseif eMarkTaskType == _G.MarkTaskType.TaskSides then
            ---@type task.c2s_task_finish
            local pbdata = {}
            pbdata.sid = taskid
            return pbdata
        elseif eMarkTaskType == _G.MarkTaskType.ActiveSeverMerge then
            local pbdata = {}
            local T = { day = Data.dayid, sid = { taskid } }
            pbdata.task = { T }
            return pbdata
        elseif eMarkTaskType == _G.MarkTaskType.WarTechnology then
            ---@type task.c2s_task_finish
            local pbdata = {}
            pbdata.sids = { taskid }
            return pbdata
        else
            if _G.AppSetting.DEBUG then
                _G.Log("", "<color=red>" .. "类型无效" .. "</color>")
            end
            return
        end
    end
end

