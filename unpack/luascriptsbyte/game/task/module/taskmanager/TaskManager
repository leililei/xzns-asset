                local totalNum = 0
                for k, v in pairs(allpotential) do
                    totalNum = totalNum + v
                end

                local count = totalNum >= awake and task.Cfg.count or totalNum
                okfun({ task.taskEnumType }, count, true)
            end,
            [_G.ActiveTaskEnum.ConditionEnum.DungeonChallenge.PassChapterNum] = function(task, okfun)
