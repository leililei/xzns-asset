                ---@type table<number, CardData>
                local allCards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card)
                if allCards then
                    for _, v in pairs(allCards) do
                        if require "CardInfoManager":GetInstance():CheckMultiMatchCOP(v.cfg.Elements_new, race) and v.cfg.Order >= order and v:GetStar() >= star then
                            totalNum = totalNum + 1
                            if totalNum >= num then
                                break
                            end
                        end
                    end
                end

                local count = totalNum >= num and task.Cfg.count or totalNum
                okfun({ task.taskEnumType }, count, true)
            end,
