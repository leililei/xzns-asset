---@return number scenceid(关卡内 场景id是房间id)
function TaskUtilities.GetTaskStateScence(task)
    local scenceid = 0
    if _G.IsNil(task) then
        if _G.AppSetting.DEBUG then
            _G.LogError(" TaskUtilities.IsTaskStateScence(task) 有误")
        end
        return scenceid
    end
    local state = task:GetTaskState()
    if state == _G.TaskEnum.ETaskState.WaitClaim then
        scenceid = task.TaskCfg.rec_npc[1]
    elseif state == _G.TaskEnum.ETaskState.Claimed or state == _G.TaskEnum.ETaskState.Executing then
        local TaskContents = task:GetAllTaskContents()
        scenceid = TaskContents[1].TargetSceneID
    elseif state == _G.TaskEnum.ETaskState.Completed then
        scenceid = task.TaskCfg.submit[1]
    end
    scenceid = tonumber(scenceid) or 0

    return scenceid
end

---当前场景 是否是当前任务状态 任务场景   (领取 提交 任务目标场景)
---@param task BaseTask
function TaskUtilities.IsTaskStateScence(task, nowScenceid)
    local scenceid = TaskUtilities.GetTaskStateScence(task)
    nowScenceid = tonumber(nowScenceid) or 0
    if scenceid > 0 and nowScenceid > 0 then
        return scenceid == nowScenceid
    end
    return false
end

