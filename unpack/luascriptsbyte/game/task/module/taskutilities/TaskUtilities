---创建一个任务内容触发器对象
---@param ownertaskcontent BaseTaskContent @所属任务内容
---@param eventtriggercb fun(isEnter:boolean,tarInstId:number,tarInstId:tarObj,luaObj:WorldBaseTask) @触发器回调方法
---@param worldpos Vector3 @初始位置
---@param loadcompletecb function @资源加载完成回调
---@param ... @自定义参数信息
function TaskUtilities.CreateBaseTaskContentTip(ownertaskcontent, eventtriggercb, worldpos, loadcompletecb, ...)
    --_G.LogUtilities.Log(                _G.EModuleName.TaskModule,TaskUtilities.CreateBaseTaskContentTip()")
    assert(_G.IsClass(ownertaskcontent, _G.BaseTaskContent), "所属任务内容必须继承至BaseTaskContent且不能为空!")
    local world = _G.WorldManager:GetInstance():GetCurWorld()
    if world ~= nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("主世界已加载，开始创建任务提示!")
        end
        if _G.IsClass(ownertaskcontent, _G.MoveToPositionTaskContent) then
            ---@type BaseItemParam
            local info = {}
            info.dataType = _G.WorldItemDataType.NomalItem
            info.itemType = _G.WorldItemType.Obj
            info.resPath = "CommonPrefab/World/MoveToPosTip"
            info.worldPos = worldpos
            info.loadCompletedCB = loadcompletecb
            return nil
        else
            if _G.AppSetting.DEBUG then
                _G.LogError(string.format("不支持创建所属任务内容类型:%s的触发器", ownertaskcontent.__cname))
            end
            return nil
        end
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("主世界还未加载，无法创建任务提示!")
        end
    end
end

