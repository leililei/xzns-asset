---根据后端推送的任务消息来创建主任务(在这里做不同任务类型的特殊适配构造)
---@param tasktype ETaskType @任务类型
---@param taskid number @任务ID
---@return BaseTask @返回对应的任务对象
function TaskUtilities.CreateTask(tasktype, taskid)
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "TaskUtilities.CreateTask()")
    if TaskTypeScriptMap[tasktype] ~= nil then
        local realtaskscriptpath = TaskTypeScriptMap[tasktype] --string.format("Game.Task.Task.%s", TaskTypeScriptMap[tasktype])
        if _G.AppSetting.DEBUG then 
            _G.LogUtilities.Log(
                _G.EModuleName.TaskModule,
                string.format("创建任务类型:%s脚本路径:%s的任务!", tasktype, realtaskscriptpath)
            )
        end
        local realtask = require(realtaskscriptpath)
        local realtaskinstance = realtask.New(taskid)
        return realtaskinstance
    else
        if _G.AppSetting.DEBUG then 
            _G.LogUtilities.Log(
                _G.EModuleName.TaskModule,
                "TaskUtilities.CreateTask()",
                string.format("未定义的任务类型:%s,创建任务对象失败!", tasktype)
            )
        end
        return nil
    end
end

---创建一个对应类型对应ID的任务目标内容(任务目标内容创建统一入口)
---@param ownertask BaseTask @任务目标内容所属任务
---@param taskcontentArr number[] @任务目标内容参数
---@param index number @所属任务的任务内容索引号
---@return BaseTaskContent @对应任务内容
function TaskUtilities.CreateTaskContent(ownertask, taskcontentArr, index)
    --_G.LogUtilities.Log(        _G.EModuleName.TaskModule,"TaskUtilities.CreateTaskContent()")
    ---@type taskcontenttype ETaskContentType @任务内容类型
    local taskcontenttype = taskcontentArr[1]
    local TypeScript = TaskContentTypeScriptMap[taskcontenttype]
    if TypeScript == nil then
        TypeScript = "CommonTaskContent"
    end

    if TypeScript ~= nil then
        local realtaskcontentscriptpath = TypeScript --string.format("Game.Task.TaskContents.%s", TypeScript)
        if _G.AppSetting.DEBUG then 
            _G.LogUtilities.Log(
                _G.EModuleName.TaskModule,
                string.format("创建任务内容类型:%s脚本路径:%s的任务内容!", taskcontenttype, realtaskcontentscriptpath)
            )
        end
        local realtaskcontent = require(realtaskcontentscriptpath)
        local realtaskcontentinstance = realtaskcontent.New(ownertask, taskcontentArr, index)
        return realtaskcontentinstance
    else
        if _G.AppSetting.DEBUG then 
            _G.LogUtilities.Log(
                _G.EModuleName.TaskModule,
                "TaskUtilities.CreateTaskContent()",
                string.format("未定义的任务内容类型:%s,创建任务内容对象失败!", taskcontenttype)
            )
        end
        return nil
    end
end

