---获取指定任务的任务状态描述
---@param task BaseTask @任务
---@return string @所有子任务描述
function TaskUtilities.GetTaskStateDes(task)
    if task == nil then
        return "无效任务"
    end
    local state = task:GetTaskState()
    local stateStr = tostring(state)
    local langid = 0

    if state == _G.TaskEnum.ETaskState.WaitClaim then
        langid = 90000000033
    elseif state == _G.TaskEnum.ETaskState.Claimed or state == _G.TaskEnum.ETaskState.Executing then
        langid = 90000000034
    elseif state == _G.TaskEnum.ETaskState.Completed then
        if task:GetScetionId() > 0 and task:GetScetionRoomId() == 0 then
            langid = 90000000118
        else
            langid = 90000000035
        end
    end
    if langid ~= 0 then
        stateStr = _G.LangUtil.GetLangPackValue(langid)
    end
    return stateStr
end

---获取指定任务的 根据任务状态 返回任务描述  (前往xx领取 前往xx提交 任务目标是xx)
---@param task BaseTask @任务
---@return string @所有子任务描述
function TaskUtilities.GetTaskStateNowDes(task)
    if task == nil then
        return "无效任务"
    end
    local state = task:GetTaskState()
    local Str = TaskUtilities.GetAllChildTaskDes(task)
    if state == _G.TaskEnum.ETaskState.Claimed or state == _G.TaskEnum.ETaskState.Executing then
    else
        local scencename = ""
        local stateStr = ""
        ---@type scene_cfg_Item
        local scenceCfg = nil
        ---@type WorldNPCItem
        local NpcCfg = nil
        local NowWolrdCfg = _G.WorldManager:GetInstance():GetCurWorld()
        if NowWolrdCfg then
            ---     不自动领取，提交  且有场景  则
            if
                state == _G.TaskEnum.ETaskState.WaitClaim and task.TaskCfg.is_auto_receive == false and
                    tonumber(task.TaskCfg.rec_npc[1]) ~= nil
             then
                scenceCfg = _G.ConfigManager.scene_cfg[task.TaskCfg.rec_npc[1]]

                if NowWolrdCfg.Sid == scenceCfg.Sid then
                    NpcCfg = _G.WorldManager:GetInstance():GetCurWorld():GetItemInfo(tonumber(task.TaskCfg.rec_npc[2]))
                end

                stateStr = "   领取"
            elseif
                state == _G.TaskEnum.ETaskState.Completed and task.TaskCfg.is_auto_submit == 0 and
                    tonumber(task.TaskCfg.submit[1]) ~= nil
             then
                scenceCfg = _G.ConfigManager.scene_cfg[task.TaskCfg.submit[1]]

                if NowWolrdCfg.Sid == scenceCfg.Sid then
                    NpcCfg = _G.WorldManager:GetInstance():GetCurWorld():GetItemInfo(tonumber(task.TaskCfg.submit[2]))
                end
                stateStr = "   提交"
            end
            if NpcCfg ~= nil then
                -- Str = "与：" .. NpcCfg.Cfg.Name .. stateStr
                Str = _G.LangUtil.GetLangPackValue(90000010020, NpcCfg.Cfg.Name)
            elseif scenceCfg ~= nil then
                -- Str = "前往：" .. scenceCfg.Name .. stateStr
                Str = _G.LangUtil.GetLangPackValue(90000010019, scenceCfg.Name)
            end
        end
    end

    return Str
end

---可领取任务 只显示当前场景
---@param task BaseTask @任务
---@return string @所有子任务描述
function TaskUtilities.GetIsShowWaitClaimTask(task)
    local isShow = true
    local scenceid = tonumber(task.TaskCfg.rec_npc[1])
    if task == nil or scenceid == nil then
        return isShow
    end

    local state = task:GetTaskState()
    if state == _G.TaskEnum.ETaskState.WaitClaim then
        local NowWolrdCfg = _G.WorldManager:GetInstance():GetCurWorld()
        if NowWolrdCfg.Sid == scenceid then
            isShow = true
            if task.TaskCfg.is_auto_receive then
                _G.TaskModule:GetInstance():AcceptTask(task.TaskID, _G.handler(task, task.OnReplyClaimTask))
            end
        else
            isShow = false
        end
    end

    return isShow
end

