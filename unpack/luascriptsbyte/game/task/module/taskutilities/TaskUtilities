---当前场景 是否是任务场景
---@param taskscenceid number @任务所需场景id
---@param withprogress boolean @是否包含进度
---@return string @所有子任务描述
function TaskUtilities.IsTaskScence(taskscenceid, scenceid)
    if _G.IsNil(taskscenceid) then
        if _G.AppSetting.DEBUG then
            _G.LogError(" taskscenceid参数 有误")
        end
        return true
    end
    if scenceid == nil then
        scenceid = _G.WorldManager:GetInstance().curSceneSid
    end
    if taskscenceid == scenceid or scenceid == -1 then
        return true
    end
    return false
end

---获取当前任务状态 任务场景 id  (领取 提交 任务目标场景)
