---获取指定任务内容的描述
---@param taskcontent BaseTaskContent @任务内容
---@param withprogress boolean @是否包含进度
---@return string @任务内容描述
function TaskUtilities.GetTaskContentDes(taskcontent, withprogress)
    --_G.LogUtilities.Log(                _G.EModuleName.TaskModule,TaskUtilities.GetTaskContentDes()")
    assert(taskcontent, "获取任务内容描述不允许传空的任务内容!")
    withprogress = withprogress or false
    local taskdes = _G.LangUtil.GetLangPackValue(taskcontent.TaskContentCfg.Des)
    if withprogress then
        local taskcontentprogress = TaskUtilities.GetTaskContentProgressDes(taskcontent)
        if taskcontentprogress ~= nil then
            taskdes = taskdes .. taskcontentprogress
        end
    end
    return taskdes
end

