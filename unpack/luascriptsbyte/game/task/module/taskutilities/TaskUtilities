    assert(task, "获取子任务进度描述不允许传空的子任务!")
    local childtaskprogressdes = nil
    --TODO: 支持一个子任务多个任务内容的进度获取
    childtaskprogressdes = TaskUtilities.GetTaskContentProgress(task.AllTaskContents[1])
    return childtaskprogressdes
end

---获取指定任务的子任务完成进度 (当前完成目标数量/需要完成的目标数量)
---@param task BaseTask @任务
---@return string @子任务进度描述
function TaskUtilities.GetTaskProgress(task)
    --_G.LogUtilities.Log(                _G.EModuleName.TaskModule,TaskUtilities.GetChildTaskProgressDes()")
    assert(task, "获取子任务进度描述不允许传空的子任务!")
    local str = "(%d/%d)"
    local childtaskprogressdes = task.complete_num or 1
    local count = 0
    for i = 1, #task.AllTaskContents do
        if TaskUtilities.GetTaskContentProgress(task.AllTaskContents[i]) then
            count = count + 1
        end
    end
    if count > childtaskprogressdes then
        count = childtaskprogressdes
    end

    if count == childtaskprogressdes then
        --- "已完成"
        return LangUtil.GetLangPackValue(90000000035)
    else
        return string.format(str, count, childtaskprogressdes)
    end
end

---获取指定任务的子任务是否全部完成 (当前完成目标数量 >=需要完成的目标数量)
---@param task BaseTask @任务
---@return string @子任务进度描述
function TaskUtilities.GetTaskProgressIsAllOver(task)
    --_G.LogUtilities.Log(                _G.EModuleName.TaskModule,TaskUtilities.GetChildTaskProgressDes()")
    assert(task, "获取子任务进度描述不允许传空的子任务!")

    local childtaskprogressdes = task.complete_num or 1
    local count = 0
    for i = 1, #task.AllTaskContents do
        if TaskUtilities.GetTaskContentProgress(task.AllTaskContents[i]) then
            count = count + 1
        end
    end
    if count > childtaskprogressdes then
        count = childtaskprogressdes
    end
    return count >= childtaskprogressdes
end

