---获取指定格式(限制两个参数，一个是当前进度，一个是总进度)的任务内容进度描述
---@param format string @格式
function BaseTaskContent:GetProgressDesWithFormat(format)
    if self.OwnerTask.AllTaskContents[self.TaskContentIndex].TaskContentTotalProgress ~= nil then
        return string.format(format, self.TaskContentProgress, self.TaskContentTotalProgress)
    else
        --默认没有进度的都显示0/1和1/1(通过状态来判定)
        if self.TaskContentState == _G.TaskEnum.ETaskState.Completed then
            return "(1/1)"
        else
            return "(0/1)"
        end
    end
end
---获取指定格式(限制两个参数，一个是当前进度，一个是总进度)的任务内容进度描述
---@param format string @格式
function BaseTaskContent:GetProgressDesWith()
    if self.OwnerTask.AllTaskContents[self.TaskContentIndex].TaskContentTotalProgress ~= nil then
        return self.TaskContentProgress >= self.TaskContentTotalProgress
    else
        --默认没有进度的都显示0/1和1/1(通过状态来判定)
        if self.TaskContentState == _G.TaskEnum.ETaskState.Completed then
            return true
        else
            return false
        end
    end
end

---改变任务内容状态
---@param newstate task.TaskState @新的任务内容状态
---@return bool @是否改变状态成功
function BaseTaskContent:ChangeState(newstate)
    if newstate == _G.TaskEnum.ETaskState.Executing or newstate == _G.TaskEnum.ETaskState.Completed then
        self.TaskContentState = newstate
    else
        _G.LogUtilities.Log(_G.EModuleName.TaskModule, string.format("任务内容不允许修改状态到:%s", newstate))
    end
end

---@return boolean @任务内容是否可执行
function BaseTaskContent:IsAvalibleExecute()
    --如果任务内容执行有前置条件写在这里

    return self.OwnerTask:IsAvalibleExecute() and (self.TaskContentState == _G.TaskEnum.ETaskState.Executing)
end

---@return boolean @任务内容是否完成
function BaseTaskContent:IsDone()
    return self.TaskContentState == _G.TaskEnum.ETaskState.Completed
end

---执行当前任务内容
---@return boolean @是否成功执行任务内容
function BaseTaskContent:ExecuteTask()
    if self:IsAvalibleExecute() then
        self:DoTaskContent()
        return true
    elseif self:IsDone() then
        self:DoTaskContent()
        return true
    else
        _G.LogUtilities.Log(
            _G.EModuleName.TaskModule,
            string.format("当前任务内容ID:%s不满足执行状态:%s要求!", self.TaskContentID, self.TaskContentState)
        )
        return false
    end
end

---执行任务内容
function BaseTaskContent:DoTaskContent()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "BaseTaskContent:DoTaskContent()")
    ---如果 不在关卡里
    if not _G.WorldManager:GetInstance():CheckSceneType(_G.SceneType.Section) then
        local nowTaskTracking = self.TaskContentCfg.TaskTracking

        local link = self.TaskContentCfg.link
        if link ~= nil and link > 0 then
            _G.JumpManager:GetInstance():Jump(link)
            return
        elseif self.TaskContentType == _G.ActiveTaskEnum.ConditionEnum.AFK.IsPass then
            require("AfkModel").GlobalOpenAfkEmbattleView()
            return
        elseif self.OwnerTask:GetScetionId() > 0 then
            local sectionId = self.OwnerTask:GetScetionId()

            local chapterId = _G.ConfigManager.main_section_cfg[sectionId].Chapter
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.SelectSectionMapView.Name,
                chapterId,
                sectionId
            )
            return
        end
    end

    self:DoSceneNavigation()
end

---打断当前任务正在做的任务内容
---@return boolean @是否打断任务成功
function BaseTaskContent:InterruptTaskExecution()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "BaseTaskContent:InterruptTaskExecution()")
    if self:IsAvalibleExecute() then
        self:DoInterruptTaskContent()
    else
        _G.LogUtilities.Log(
            _G.EModuleName.TaskModule,
            string.format("当前任务内容ID:%s不满足打断状态:%s要求!", self.TaskContentID, self.TaskContentState)
        )
        return false
    end
end

