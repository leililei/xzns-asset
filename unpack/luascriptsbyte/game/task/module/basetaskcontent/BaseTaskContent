BaseTaskContent.IsAfterStoryCompleted = nil

---TaskContent构造函数
---@param ownertask BaseItem @任务内容所属子任务
---@param taskcontentArr number[] @任务目标内容参数
---@param index number @所属任务的任务内容索引号
function BaseTaskContent:__init(ownertask, taskcontentArr, index)
    ---@type task_cfg
    local TaskCfg = _G.ConfigManager.task_cfg[ownertask.TaskID]

    self.OwnerTask = ownertask
    self.TaskContentID = taskcontentArr[1]
    self.TaskContentIndex = index
    self.TaskContentType = taskcontentArr[1]

    if #TaskCfg.TaskTracking < index then
        if _G.AppSetting.DEBUG then
            _G.Log("任务 内容对应的 TaskTracking 字段未配置")
        end
    --return
    end
    self.TargetSceneID = TaskCfg.TaskTracking[index] and TaskCfg.TaskTracking[index][2] or nil

    self.TaskContentDes = TaskCfg.targetdes[index]
    if self.TaskContentDes == nil then
        ---没有 则用第一个
        self.TaskContentDes = TaskCfg.targetdes[1]
    end

    ---@class TaskContentConfig_Item
    self.TaskContentCfg = {
        ---@field public TaskContentParam number[] @任务目标内容参数
        TaskContentParam = taskcontentArr,
        ---@field public type ETaskContentType @任务内容类型
        type = self.TaskContentType,
        ---@field public type number[] 目标场景信息
        TaskTracking = TaskCfg.TaskTracking[index],
        ---@field public SceneType number @目标场景类型  1主城 2副本
        SceneType = TaskCfg.TaskTracking[index] and TaskCfg.TaskTracking[index][1] or nil,
        ---@field public SceneIdRequired number @目标场景id
        SceneIdRequired = self.TargetSceneID,
        ---@field public SceneIdRequired number @做任务需要寻路到的NPC
        TargetNpcUid = TaskCfg.TaskTracking[index] and TaskCfg.TaskTracking[index][4] or nil,
        ---@field public Des string @任务内容描述
        Des = self.TaskContentDes,
        ---@field public submit_story number @提交任务剧情
        submit_story = TaskCfg.submit_story,
        ---@field public submit_default number @提交任务对白
        submit_default = TaskCfg.submit_default,
        ---@field public receive_story number @接受任务剧情
        receive_story = TaskCfg.receive_story,
        ---@field public receive_default number @接取任务对白
        receive_default = TaskCfg.receive_default,
        ---@field public link number @界面跳转
        link = TaskCfg.link
    }
    self:ParseParam(self.TaskContentCfg.TaskContentParam)

    self.AfterAutoPlayStory = _G.AutomaticPlayStory.New()
    self.IsAfterStoryCompleted = false

    -- 更新任务内容进度和状态等数据
    self:UpdateInfo()

    self:ChangeState(_G.TaskEnum.ETaskState.Executing)
end

