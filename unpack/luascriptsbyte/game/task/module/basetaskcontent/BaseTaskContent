---任务内容完成回调(子类执行完成后主动调用此接口)
---@param isShowEff boolean  是否显示任务完成特效  默认显示
function BaseTaskContent:OnTaskContentComplete(isShowEff)
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "BaseTaskContent:OnTaskContentComplete()")

    local startCo = _G.handlerbind(self, self.OnTaskContentCompleteCoroutine, isShowEff)
    self.stopCoProgress = coroutine.start(startCo)
end

function BaseTaskContent:OnTaskContentCompleteCoroutine(isShowEff)
    if isShowEff == nil then
        --- 默认播放
        isShowEff = true
    end
    local nowStory = _G.StoryManager:GetInstance():GetNowStory()
    if nowStory ~= nil then
        if nowStory.IsStoryPlaying == true then
            -- 剧情播放完成 再显示任务完成
            while (nowStory.IsStoryPlaying == true) do
                _G.coroutine.waitforendofframe()
            end
            _G.coroutine.waitforseconds(0.5)
        end
    end

    local isSection = false

    local curRoomCfg = _G.ChapterRoomManager:GetInstance():GetCurRoomCfg()
    if not _G.IsNil(curRoomCfg) and curRoomCfg.Type1 == _G.SectionType.BossBattle then
        isSection = true

        _G.TaskModule:GetInstance().isSectionTaskOver = true
    end

    --TODO:任务内容完成以后的事情
    self:ChangeState(_G.TaskEnum.ETaskState.Completed)

    --通知上层任务当前任务内容完成
    self:DispatchEvent(_G.BaseTaskContentEvent, _G.BaseTaskContentEvent.EnumValue.TaskContentComplete, self)

    ---防止 结算界面挡住特效
    if
        isSection == false and isShowEff == true and _G.TaskUtilities.GetTaskProgressIsAllOver(self.OwnerTask) and
            --- 不能是新手任务  防止没显示任务 却提示有任务目标完成
            self.OwnerTask.type ~= _G.TaskEnum.ETaskType.NoviceTask
     then
        local effectStep = 0

        _G.TaskModule:GetInstance():PlayTaskEff_01(
            _G.TaskEnum.ETaskState.Completed,
            self.OwnerTask.TaskCfg.Type1,
            function()
                effectStep = 1
            end,
            function()
                effectStep = 2
            end
        )
        -- _G.UIUtils.LoadEffectByCfg(
        --     _G.ConfigManager.ui_effect_cfg.fx_c_renwuwancheng_effect,
        --     _G.UIManager:GetInstance():GetUILayerTrans(_G.UILayers.InfoLayer.Name),
        --     function()
        --         effectStep = 1
        --     end,
        --     function()
        --         effectStep = 2
        --     end
        -- )

        while (effectStep < 1) do --特效加载出来之前，不执行下去
            _G.coroutine.waitforendofframe()
        end
        ---执行任务完成后的剧情表现
        self:DoAfterStory()
    end

    -- 完成后移除相关全局监听
    _G.Events:GetInstance():RemoveListener(_G.eScene.EnterWorldOver, self.OnChangeWorldOver, self)
    ---清除数据
    self:ClearData()
end

