---更新任务内容数据和状态
function BaseTaskContent:UpdateInfo()
    _G.LogUtilities.Log(
        _G.EModuleName.TaskModule,
        string.format("更新任务ID:%d的任务内容ID:%d", self.OwnerTask.TaskID, self.TaskContentID)
    )
    local ownertaskinfo = self.OwnerTask:GetTaskInfo()
    if ownertaskinfo.target ~= nil then
        self.TaskContentProgress = ownertaskinfo.target[self.TaskContentIndex] or 0
    else
        self.TaskContentProgress = 0
    end
    self:UpdateTaskState()

    -- 如果任务切换到可执行状态，则需要监听世界切换事件，因为部分任务内容切换场景后有特定事情需要做
    if self:IsAvalibleExecute() then
        _G.LogUtilities.Log(_G.EModuleName.TaskModule, string.format("任务内容ID:%d处于执行状态,需要监听场景切换!", self.TaskContentID))
        -- 避免重复监听
        _G.Events:GetInstance():RemoveListener(_G.eScene.EnterWorldOver, self.OnChangeWorldOver, self)
        _G.Events:GetInstance():AddListener(_G.eScene.EnterWorldOver, self.OnChangeWorldOver, self)
    end
    self:DispatchEvent(_G.BaseTaskContentEvent, _G.BaseTaskContentEvent.EnumValue.TaskContentUpdate, self)
end

