---执行任务场景寻路导航
function BaseTaskContent:DoSceneNavigation()
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "BaseTaskContent:DoSceneNavigation()")
    _G.LogUtilities.Log(
        _G.EModuleName.TaskModule,
        string.format("任务内容ID:%d 场景:%d引导", self.TaskContentID, self.TaskContentCfg.SceneIdRequired)
    )

    local worldsid = _G.WorldManager:GetInstance():GetCurWorldSid()
    ---@type NavParam
    if worldsid ~= self.TaskContentCfg.SceneIdRequired then
        _G.LogUtilities.Log(
            _G.EModuleName.TaskModule,
            string.format("当前场景:%d和目标场景:%d不同需要引导切换场景!", worldsid, self.TaskContentCfg.SceneIdRequired)
        )
        local mainplayer = _G.WorldManager:GetInstance():GetCurWorldPlayer()
        ---@type NavParam
        local navparam = {}
        navparam.Object = mainplayer
        navparam.OriginSceneSid = worldsid
        navparam.TargetSceneSid = self.TaskContentCfg.SceneIdRequired
        local navitem = _G.NavManager:GetInstance():DoNavMove(navparam)
        if navitem == nil then
            return
        end
        navitem:AddListener(
            _G.NavItemEvent,
            _G.NavItemEvent.EnumValue.NavComplete,
            self.OnSceneNavigationComplete,
            self,
            true
        )
    else
        _G.LogUtilities.Log(
            _G.EModuleName.TaskModule,
            string.format("当前场景:%d和目标场景:%d相同，无需引导切换场景!", worldsid, self.TaskContentCfg.SceneIdRequired)
        )
        self:OnSceneNavigationComplete()
    end
end

