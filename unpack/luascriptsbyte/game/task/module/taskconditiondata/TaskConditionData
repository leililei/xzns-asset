---Note:
---所有任务条件类型以及任务类型和对应脚本的映射都定义在这里

local ETaskConditionSource = {
    "Level",
    "Professional"
}

---@class ETaskCondition @任务内容类型定义
---@field LevelTaskCondition number @角色等级条件
---@field ProfessionalTaskCondition number @角色职业条件
_G.ETaskCondition = _G.CreatEnumTable(ETaskConditionSource, 0)

---Note:
---任务条件类型和对应脚本名的映射
---取名规则：ETaskConditionSource里的对应定义+TaskCondition后缀名)
--print("任务条件类型脚本映射Map数据初始化:")
---@class TaskConditionTypeScriptMap @任务条件类型与脚本名映射Map
local taskconditiontypescriptmap = {}
for k, v in pairs(_G.ETaskCondition) do
    taskconditiontypescriptmap[v] = k .. "TaskCondition"
    --_G.LogUtilities.Log(        _G.EModuleName.TaskModule,string.format("任务条件类型:%d,任务条件对应脚本名:%s", v, taskconditiontypescriptmap[v]))
end
---@type TaskConditionTypeScriptMap @任务类型与脚本名映射Map
_G.TaskConditionTypeScriptMap = taskconditiontypescriptmap
