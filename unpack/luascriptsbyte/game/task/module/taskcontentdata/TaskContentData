---任务内容的优先级
local ETaskContentPrioritySource = {
    "Lowest",
    "Low",
    "Medium",
    "Hight",
    "Hightest"
}

---@class ETaskContentPriority @任务内容的优先级
---@field Lowest number @最低优先级
---@field Low number @低优先级
---@field Medium number @中等优先级
---@field Hight number @高优先级
---@field Hightest number @最高优先级
_G.ETaskContentPriority = _G.CreatEnumTable(ETaskContentPrioritySource, 0)

---Note:
---所有任务目标类型以及任务目标类型和对应脚本的映射都定义在这里

local ETaskContentTypeSource = {
    "MoveToPosition",
    "NPCDialogue",
    "DungeonPass",
    "MonsterFight",
    "CollectItem"
}

---@class ETaskContentType @任务内容类型定义
---@field MoveToPosition number @玩家移动到指定位置任务
---@field NPCDialogue number @NPC对话任务
---@field DungeonPass number @副本过关
---@field MonsterFight number @怪物战斗任务
---@field TaskContent number @采集任务
_G.ETaskContentType = _G.CreatEnumTable(ETaskContentTypeSource, 0)

---Note:
---任务内容类型和对应脚本名的映射
---取名规则:ETaskContentTypeSource里的对应定义+TaskContent后缀名
--print("任务内容类型脚本映射Map数据初始化:")
---@class TaskContentTypeScriptMap @任务类型与脚本名映射Map
local taskcontenttypescriptmap = {}
for k, v in pairs(_G.ETaskContentType) do
    taskcontenttypescriptmap[v] = k .. "TaskContent"
    --_G.LogUtilities.Log(        _G.EModuleName.TaskModule,string.format("任务内容类型:%d,任务内容对应脚本名:%s", v, taskcontenttypescriptmap[v]))
end
---@type TaskContentTypeScriptMap @任务类型与脚本名映射Map
_G.TaskContentTypeScriptMap = taskcontenttypescriptmap
