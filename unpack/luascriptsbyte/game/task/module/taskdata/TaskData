---@class TaskEnum @任务枚举定义
---@field ETaskType ETaskType
---@field ETaskState ETaskState
local TaskEnum = {
    ---@class ETaskType @任务类型
    ---@field MainTask number @主任务
    ---@field BranchTask number @分支任务
    ---@field DailyTask number @日常任务
    ---@field NoviceTask number @新手任务
    ETaskType = {
        ["MainTask"] = 1,
        ["BranchTask"] = 2,
        ["DailyTask"] = 3,
        ["NoviceTask"] = 4
    },
    ---@class ETaskState @任务状态
    ---@field WaitClaim number @可领取
    ---@field Claimed number @已领取
    ---@field Executing number @执行中
    ---@field GiveUp number @放弃
    ---@field Completed number @完成(Note:现阶段没有任务提交阶段，完成等价于提交状态)
    ---@field Submited number @提交
    ---@field Invalide number @无效
    ETaskState = {
        ["WaitClaim"] = 0,
        ["Claimed"] = 1,
        ["Executing"] = 2,
        --['GiveUp'] = 2,
        ["Completed"] = 3,
        ["Submited"] = 5,
        ["Invalide"] = 4
    },
    ---@class ECollectType @采集类型
    ---@field Collect number @采集
    ---@field Fight number @战斗
    ECollectType = {
        ["Collect"] = 1,
        ["Fight"] = 2
    },
    ---@class ECollectFightResult @采集战斗结果
    ---@field Win number @胜利
    ---@field Lose number @失败
    ECollectFightResult = {
        ["Win"] = 1,
        ["Lose"] = 2
    }
}

---@type TaskEnum
_G.TaskEnum = TaskEnum

---Note:
---任务类型和对应脚本名源至TaskEnum.ETaskType里的定义
---取名规则:与TaskEnum.ETaskType里取名一致
--print("任务类型脚本映射Map数据初始化:")
---@class TaskTypeScriptMap @任务类型与脚本名映射Map
local tasktypescriptmap = {}
for k, v in pairs(TaskEnum.ETaskType) do
    tasktypescriptmap[v] = k
    --print(string.format("任务类型:%d,任务对应脚本名:%s", v, tasktypescriptmap[v]))
end
---@type TaskTypeScriptMap @任务类型与脚本名映射Map
_G.TaskTypeScriptMap = tasktypescriptmap
