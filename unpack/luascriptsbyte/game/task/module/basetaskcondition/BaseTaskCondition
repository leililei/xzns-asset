---@class BaseTaskCondition @任务条件基类抽象
---@field OwnerTask BaseTask @任务条件所属任务
---@field TaskConditionType ETaskCondition @任务条件类型
local BaseTaskCondition = _G.BaseClass("BaseTaskCondition")
BaseTaskCondition.BaseTask = nil
BaseTaskCondition.TaskConditionType = nil

---BaseTaskCondition构造函数
---@param ownertask BaseTask @任务条件所属任务
---@param taskconditiontype ETaskCondition @任务条件类型
---@param conditionparams string @条件详细参数(上层统一传字符串，子类自行解析)
function BaseTaskCondition:__init(ownertask, taskconditiontype, conditionparams)
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "BaseTaskCondition:__init()")
    self.OwnerTask = ownertask
    self.TaskConditionType = taskconditiontype
    self:ParseParam(conditionparams)
end

---解析条件参数(子类重现实现特定参数解析)
---@param conditionparams string @条件详细参数
function BaseTaskCondition:ParseParam(conditionparams)
end

---检查任务条件(子类重写实现特定条件判定)
---@return boolean @任务条件是否满足
function BaseTaskCondition:CheckCondition(...)
    return true
end

---@type BaseTaskCondition @任务条件基类抽象
_G.BaseTaskCondition = BaseTaskCondition

---@type BaseTaskCondition
return BaseTaskCondition
