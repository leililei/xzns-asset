--region -------------------------------------- 任务返回--------

---获得主线任务-返回
---@param port number @消息唯一id
---@param data task.s2c_get_task_info
---@param error string @错误信息
---@param tasktype number 1 主线请求 2 支线请求
function TaskNet:GetTaskMainsCall(port, data, error, tasktype)
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "TaskNet:GetTaskMainsCall()")
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---接任务-返回
---@param port number @消息唯一id
---@param data task.s2c_task_accept
---@param error string @错误信息
function TaskNet:AcceptCall(port, data, error)
    if error or (data.ack ~= nil and data.ack ~= 1) then
        return
    end
    --通用逻辑部分
    _G.TaskModule:GetInstance():UpdateTaskInfos(data.new_tasks)
    --通知任务模块任务数量变化
    _G.TaskModule:GetInstance():DispatchEvent(_G.TaskModuleEvent, _G.TaskModuleEvent.EnumValueTable.TaskNumberUpdate)
    if data.acc_goods ~= nil then
        local dataaward = {}
        dataaward.award = {
            item = data.acc_goods.item
        }
        _G.StorageManager:GetInstance():ReceiveAwardData(dataaward)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, dataaward)
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---交任务-返回
---@param port number @消息唯一id
---@param data task.s2c_task_finish
---@param error string @错误信息
function TaskNet:FinishCall(port, data, error)
    if error or (data.ack ~= nil and data.ack ~= 1) then
        return
    end
    if data.new_task == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("data.new_task = nil ")
        end
        return
    end

    local taskid = data.new_task.sid
    -- 接取  前置任务id  为该任务的所有任务
    if taskid ~= nil then
        _G.TaskModule:GetInstance():SetCompletedTask(taskid)

        --- 设置关卡任务 真实完成
        if _G.TaskModule:GetInstance():CheckIsRoomTask(taskid) then
            _G.TaskModule:GetInstance():SetCompletedRoomTask(taskid)

            local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name)
            if view then
                view:UpdateRoomAward()
            end
        end

        --通用逻辑部分
        --更新老任务数据
        _G.TaskModule:GetInstance():UpdateTaskInfo(data.new_task)

        _G.TaskModule:GetInstance():ClaimAllTask_byPer(taskid)
    end

    ---@type task_cfg
    local taskcfg = _G.ConfigManager.task_cfg[taskid]
    if taskcfg ~= nil and taskcfg.Type1 == _G.TaskEnum.ETaskType.MainTask then
        local AfkTaskModel = require("AfkTaskModel"):GetInstance()
        if AfkTaskModel ~= nil then
        -- if taskcfg.chapter > AfkTaskModel.Data.c_sid then
        --     AfkTaskModel:ReceiveAward(
        --         taskcfg.chapter,
        --         function(msg)
        --             _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
        --         end
        --     )
        -- end
        end
    end

    --打印交任务奖励物品
    if data.award ~= nil and data.award.item ~= nil then
        _G.StorageManager:GetInstance():ReceiveAwardData(data)
        --- 在 放置界面 直接显示奖励
        if _G.UIManager:GetInstance():IsActiveWindow(_G.ConfigManager.ui_cfg.AfkView.Name) then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
        end
    end
    --打印交任务消耗物品
    if data.consume ~= nil and data.consume.item ~= nil then
        for i = 1, #data.consume.item do
            _G.StorageManager:GetInstance():ConsumeItem(data.consume.item[i].item[1], 0, data.consume.item[i].item[2])
        end
    end

    --通知任务模块任务数据更新
    _G.TaskModule:GetInstance():DispatchEvent(
        _G.TaskModuleEvent,
        _G.TaskModuleEvent.EnumValueTable.TaskInfoUpdate,
        data.new_task.sid
    )
    _G.TaskModule:GetInstance():DispatchEvent(
        _G.TaskModuleEvent,
        _G.TaskModuleEvent.EnumValueTable.TaskComplete,
        data.new_task.sid
    )
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

--endregion

