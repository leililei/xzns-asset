---@type BaseGameNet
local base = require("BaseGameNet")

---@return TaskNet @单例获取
function TaskNet:GetInstance()
    return require("BaseGameNet").GetInstance(self)
end

---添加所有后端主动推的网络消息监听接口
function TaskNet:AddMessageListeners()
    _G.LogUtilities.Log("TaskNet:AddMessageListeners()")
    ---请手动添加后端主动推送的消息监听代码
    self:AddMessageListener(_G.ConfigManager.net_map.task_collector.Cmd, self.SendTaskCollectorCall)
    self:AddMessageListener(_G.ConfigManager.net_map.game_achieve_collector.Cmd, self.SendChengJiuCollectorCall)
end

---后端主动推送的消息数据开始
---发送任务收集消息
---@param data task.s2c_get_task_info
function TaskNet:SendTaskCollectorCall(data)
    if _G.AppSetting.DEBUG then
        _G.Log("TaskNet:SendTaskCollectorCall()")
    end
    ---处理后端主动推送的任务数据更新
    _G.TaskModule:GetInstance():UpdateTaskInfos(data.col_task, data.activity_id)
    if data.col_task and data.col_task[1] then
        --通知任务模块任务数据更新
        _G.TaskModule:GetInstance():DispatchEvent(
            _G.TaskModuleEvent,
            _G.TaskModuleEvent.EnumValueTable.TaskInfoUpdate,
            data.col_task[1].sid
        )
        _G.Events:GetInstance():Broadcast(_G.eServerTaskEvent.Update, data.col_task)
    end
end
---后端主动推送的消息数据开始
---发送成就收集消息
---@param data achieve.s2c_achieve_collector
function TaskNet:SendChengJiuCollectorCall(data)
    if _G.AppSetting.DEBUG then
        _G.Log("TaskNet:SendTaskCollectorCall()")
    end
    ---处理后端主动推送的任务数据更新
    _G.TaskModule:GetInstance():UpdateChengJiu(data)
