---@class RoleTitleHaloView BaseClass 临时显示光环称号头像框第一次获得弹窗
---@field public go_table BaseClass GoTable
local RoleTitleHaloView = _G.BaseClass("RoleTitleHaloView", _G.UIBaseView)

function RoleTitleHaloView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面入口
function RoleTitleHaloView:OnCreate(data)
    self:InitView(data)
end

---析构函数
function RoleTitleHaloView:OnDispose()
end

---初始化界面
---@param table data 奖励展示数据
function RoleTitleHaloView:InitView(data)
    local loadpath, type = self:CheckData(data)
    if loadpath ~= nil then
        if type ~= 2 then
            self.go_table.aorrawimage_show:LoadImage(
                loadpath,
                function(tran)
                    if tran then
                        tran:SetNativeSize()
                        if data.type == 2 then
                            tran:SetLocalScaleXYZ(0.8)
                        end
                    end
                end
            )
        else
            _G.UIUtils.LoadEffectByPath(
                loadpath,
                self.go_table.aorrawimage_show,
                nil,
                nil,
                0,
                {0, 0, 0},
                1,
                0,
                true,
                false,
                0
            )
        end
    else
        self:Close()
    end
end

---检测数据并返回要展示的图片路径
---@param table data 奖励展示数据
---@return string 返回需要加载的图片路径
function RoleTitleHaloView:CheckData(data)
    if data.type == 1 then
        local frame_cfg = _G.ConfigManager.player_frame_cfg
        return frame_cfg[data.sid].frame, frame_cfg[data.sid].type_title
    elseif data.type == 2 then
        local title_cfg = _G.ConfigManager.player_title_effect_cfg
        self.go_table.aorrawimage_show:SetLocalPosition(0, 50, 0)
        return title_cfg[data.sid].title, title_cfg[data.sid].type_title
    elseif data.type == 3 then
        local halo_cfg = _G.ConfigManager.player_halo_effect_cfg
        return halo_cfg[data.sid].icon
    elseif data.type == 4 then
        local halo_cfg = _G.ConfigManager.player_scene_cfg
        return halo_cfg[data.sid].image
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("当前数据非光环称号头像框数据!")
        end
        return nil
    end
end

---点击事件在此触发
function RoleTitleHaloView:OnClickBtn(go)
    if nil == go then
        return
    end
    local name = go:GetName()
    if "@_aorbtn_close" == name then
        self:Close()
    end
end

return RoleTitleHaloView
