local StarSoulModel = require "StarSoulModel"
local rankEffect = {
    "Ef_ArenaTop1",
    "Ef_ArenaTop2",
    "Ef_ArenaTop3"
}
local GetLangPackValue = _G.GetLangPackValue
---@class StarSoulBossView : UIBaseView	中文描述
------@field itemList StarSoulRankView._obj_ListItem_GoTable[]
local StarSoulRankView = _G.BaseClass("StarSoulRankView", _G.UIBaseView)
function StarSoulRankView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.monster_cfg = _G.ConfigManager.monster_cfg
    self.cfg = _G.table.toArray(_G.ConfigManager.system_prof_reward_cfg)
    self.itemList = {}
    self.go_table.looplist2_rankItem:InitListView(#self.cfg, _G.handler(self, self.RefrshItem))
    self:JiSuanDangQian()
end

---刷新排行显示
---@param listView2 SuperScrollView.LoopListView2
function StarSoulRankView:RefrshItem(listView2, index)
    local newIndex = index + 1
    local item = listView2:NewListViewItem("$_obj_ListItem")
    local instance = item:GetInstanceIDE()
    if not self.itemList[instance] then
        self.itemList[instance] = _G.GetAutoGoTable(item, _G.handler(self, self.OnClickAward))
        self.itemList[instance].itemList = {}
        self.itemList[instance].itemCount = 0
    end
    local tb = self.itemList[instance]
    local data = self.cfg[newIndex]
    tb.aorimage_rankIcon:DisposeChildren()
    if data.min_rank <= 3 and data.min_rank == data.max_rank then
        _G.GameUtil.SetActiveByCondition(tb.aorimage_rankIcon, true)
        tb.aortext_rankItem.text = ""
        tb.aorimage_rankIcon.SpriteName = "uui_tz_maoxian_shd_paiming" .. data.min_rank
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg[rankEffect[data.min_rank]], tb.aorimage_rankIcon)
    else
        _G.GameUtil.SetActiveByCondition(tb.aorimage_rankIcon, false)
        _G.GameUtil.SetActiveByCondition(tb.aorrawimage_rankIcon2, false)
        tb.aortext_rankItem.text = GetLangPackValue(90022500407, data.min_rank, data.max_rank)
    end
    local count = #data.reward
    local curItemCount = tb.itemCount
    if count > curItemCount then
        for i = curItemCount + 1, count do
            _G.ItemFactory:GetInstance():GetItemCard(
                _G.ItemFactory.itemType.ItemBaseWithCount,
                tb.trans_content,
                function(item)
                    tb.itemCount = tb.itemCount + 1
                    tb.itemList[i] = item
                    item:Show(data.reward[i][1], nil, data.reward[i][2])
                end
            )
        end
    else
        for i = 1, curItemCount do
            if i <= count then
                _G.GameUtil.SetActiveByCondition(tb.itemList[i].go_table.gameObject, true)
                tb.itemList[i]:Show(data.reward[i][1], nil, data.reward[i][2])
            else
                _G.GameUtil.SetActiveByCondition(tb.itemList[i].go_table.gameObject, false)
            end
        end
    end
    return item
end

---计算当前人物排名
function StarSoulRankView:JiSuanDangQian()
    local playerRank = {}
    playerRank.index = 0
    playerRank.value = StarSoulModel:GetInstance():Getdps() or 0
    local id = _G.PlayerModel:GetInstance():GetPlayerUid()
    self.rankData = StarSoulModel:GetInstance().rankData or {}
    for key, value in pairs(self.rankData) do
        if value.uid == id then
            playerRank.index = key
            playerRank.value = value.dps
        end
    end
    local data = {}
    local pandaun = true
    for key, value in pairs(self.cfg) do
        if value.max_rank >= playerRank.index and pandaun then
            data = value.reward
            pandaun = false
        end
    end
    if playerRank.index == 0 then
        self.go_table.aortext_paiming.text = GetLangPackValue(90022500425)
        self.go_table.aortext_paimingjiangli:SetActiveE(1)
        self.go_table.trans_content:SetActiveE(0)
        self.go_table.aortext_paimingjiangli.text = GetLangPackValue(90022900041)
        return
    end
    self.go_table.aortext_paimingjiangli:SetActiveE(0)
    self.go_table.trans_content:SetActiveE(1)
    self.go_table.aortext_paiming.text = playerRank.index
    if _G.table.count(data) > 0 then
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemBaseWithCount,
            self.go_table.trans_content,
            function(item)
                item:Show(data[1][1], nil, data[1][2])
            end
        )
    end
end
---按钮点击事件在这里派发
function StarSoulRankView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end

return StarSoulRankView
