local StarSoulModel = require "StarSoulModel"

local BossTpyeName = {
    [1] = "ui-xhsl-icon-tk",
    [2] = "ui-xhsl-icon-zs",
    [3] = "ui-xhsl-icon-fs",
    [4] = "ui-xhsl-icon-fz",
    [5] = "ui-xhsl-icon-yx"
}
local rankEffect = {
    "Ef_ArenaTop1",
    "Ef_ArenaTop2",
    "Ef_ArenaTop3"
}
local RankColor = {
    "ffee9d",
    "feae46",
    "ad76ff"
}
--90022900040  未上榜 90022900041  暂无奖励
local Ranktext = {
    [1] = "90022900040",
    [2] = "90022900041"
}
---@class StarSoulView : UIBaseView	中文描述
---@field RankList StarSoulView._obj_ListItem_GoTable[]
local StarSoulView = _G.BaseClass("StarSoulView", _G.UIBaseView)
function StarSoulView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.RankList = {}
    self.monster_cfg = _G.ConfigManager.monster_cfg
    self.system_prof_cfg = _G.ConfigManager.system_prof_cfg
    self.card_skills_cfg = _G.ConfigManager.card_skills_cfg
    self.go_table.looplist2_RankList:InitListView(0, _G.handler(self, self.RefreshRankItem))

    self:xianshiShuaXing()
end

function StarSoulView:xianshiShuaXing()
    StarSoulModel:GetInstance():GetWorldBossData(_G.handler(self, self.BossType))
    StarSoulModel:GetInstance():GetPaiHangBang(_G.handler(self, self.InitRank))
end
---更新boss职业和技能
function StarSoulView:BossType()
    local boss_id = StarSoulModel:GetInstance():Getboss_id()
    self:TiaoZhanTime()
    self.go_table.aorimage_zhiye.SpriteName = BossTpyeName[boss_id]
    local Tipe = self.system_prof_cfg[boss_id].skill
    local tb = {}
    tb[1] = _G.GetAutoGoTable(self.go_table.obj_skill1, _G.handlerbind(self, self.TipYe, 1))
    tb[3] = _G.GetAutoGoTable(self.go_table.obj_skill2, _G.handlerbind(self, self.TipYe, 2))
    tb[2] = _G.GetAutoGoTable(self.go_table.obj_skill3, _G.handlerbind(self, self.TipYe, 3))
    self.dataIdList = {}
    for i = 1, 3 do
        tb[i].gameObject:SetActiveE(1)
        local dataId = Tipe[i]
        local skills = self.card_skills_cfg[dataId]
        if skills == nil then
            tb[i].gameObject:SetActiveE(0)
            return
        end
        tb[i].aorrawimage_icon.gameObject:SetActiveE(0)
        tb[i].aorrawimage_icon:LoadImage(
            skills.icon,
            function(image)
                if image ~= nil then
                    image:SetActiveE(1)
                end
            end
        )
    end
end
---技能tip显示
function StarSoulView:TipYe(go, _, dataId)
    local boss_id = StarSoulModel:GetInstance():Getboss_id()
    local name = go:GetName()

    local skillid = self.system_prof_cfg[boss_id].skill
    local skills = self.card_skills_cfg[skillid[dataId]]
    require("CommonTipManager"):GetInstance():OpenSkillTip(skills.id)
end
function StarSoulView:InitRank()
    self.rankData = StarSoulModel:GetInstance().rankData or {}
    local count = #self.rankData
    self.go_table.looplist2_RankList:SetListItemCount(count, true)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_No, count == 0)
    self:InitPlayer()
    self:TiaoZhanCiShu()
    local num = StarSoulModel:GetInstance():Getf_num()
end

---刷新排行榜显示
---@param listView2 SuperScrollView.LoopListView2
function StarSoulView:RefreshRankItem(listView2, index)
    local newindex = index + 1
    local item = listView2:NewListViewItem("$_obj_ListItem")
    local instanceID = item:GetInstanceIDE()
    if not self.RankList[instanceID] then
        self.RankList[instanceID] = _G.GetAutoGoTable(item)
    end
    local tb = self.RankList[instanceID]
    local data = self.rankData[newindex]

    _G.GameUtil.SetActiveByCondition(tb.aorimage_rankIcon, newindex <= 3)
    tb.aorimage_rankIcon:DisposeChildren()
    if newindex <= 3 then
        local color = RankColor[newindex]
        tb.aortext_rankNum.text = ""
        tb.aorimage_rankIcon.SpriteName = "uui_tz_maoxian_shd_paiming" .. newindex
        tb.aortext_name.text = _G.string.AddColor(data.name, color)
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg[rankEffect[newindex]], tb.aorimage_rankIcon)
    else
        tb.aortext_rankNum.text = newindex
        tb.aortext_name.text = data.name
    end
    tb.aortext_damage.text = _G.GameUtil.NumberToUnitStr(data.dps)
    return item
end
---显示个人排名
function StarSoulView:InitPlayer()
    self.playerRank = self:JiSuanDangQian()
    if self.playerRank.index == 0 or self.playerRank.index > 3 then
        self.go_table.aortext_name.text = _G.PlayerModel:GetInstance().role_name
    else
        self.go_table.aortext_name.text =
            string.AddColor(_G.PlayerModel:GetInstance().role_name, RankColor[self.playerRank.index])
    end

    if self.playerRank.index == 0 then
        self.go_table.aortext_rank.text = _G.ConfigManager.language_package_cfg[Ranktext[1]]
        if self.playerRank.value == 0 then
            self.go_table.aortext_damage.text = _G.ConfigManager.language_package_cfg[Ranktext[2]]
        else
            self.go_table.aortext_damage.text =
                string.AddColor(_G.GameUtil.NumberToUnitStr(self.playerRank.value), "41EA91")
        end
    else
        self.go_table.aortext_rank.text = self.playerRank.index
        self.go_table.aortext_damage.text =
            string.AddColor(_G.GameUtil.NumberToUnitStr(self.playerRank.value), "41EA91")
    end
end

---计算当前人物排名
function StarSoulView:JiSuanDangQian()
    local playerRank = {}
    playerRank.index = 0
    playerRank.value = StarSoulModel:GetInstance():Getdps() or 0
    local id = _G.PlayerModel:GetInstance():GetPlayerUid()
    for key, value in pairs(self.rankData) do
        if value.uid == id then
            playerRank.index = key
            playerRank.value = value.dps
        end
    end
    return playerRank
end
---刷新挑战次数
function StarSoulView:TiaoZhanCiShu()
    local num = StarSoulModel:GetInstance():Getf_num()
    self.go_table.aortext_tiaozhanname.text =
        _G.GetLangPackValue(90022500426, (num .. "/" .. _G.ConfigManager.system_cfg[105].count_limit))
end

---剩余挑战时间
function StarSoulView:TiaoZhanTime()
    local time = StarSoulModel:GetInstance():Gettime()
    local DQtime = _G.TimeUtil:GetServerUnixTime()
    self.XianShitiem = 48 * 60 * 60 - (DQtime - time)
    self:ShuXingTime()
end

function StarSoulView:ShuXingTime()
    self.go_table.aortext_time.text = _G.TimeUtil.TimeToString(Mathf.RoundToInt(self.XianShitiem), 1)
    if self.Timers == nil then
        -- body

        local timer = _G.TimerManager:GetInstance():GetTimer(1, self.PoolTimer, self, false, false, true)
        timer:Start()
        self.XianShitiems = timer
    end
end
---倒计时
function StarSoulView:PoolTimer(elapsed)
    self.XianShitiem = self.XianShitiem - elapsed
    if self.XianShitiem < 0 then
        self.XianShitiem = self.XianShitiem + 1
        self:xianshiShuaXing()
    end
    self.go_table.aortext_time.text = _G.TimeUtil.TimeToString(Mathf.RoundToInt(self.XianShitiem), 1)
end

---挑战
function StarSoulView:TiaoZhan()
    if StarSoulModel:GetInstance():Getf_num() > 0 then
        StarSoulModel:GetInstance():StartChangllenge()
        if self.XianShitiems ~= nil then
            self.XianShitiems:Stop()
        end
        self:Close()
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(310101)
    end
end

---按钮点击事件在这里派发
function StarSoulView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        if self.XianShitiems ~= nil then
            self.XianShitiems:Stop()
        end
        self:Close()
    elseif go == self.go_table.aorbtn_tiaozhan then
        self:TiaoZhan()
    elseif go == self.go_table.aorbtn_xqyg then
        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.StarSoulBossView.Name)
    elseif go == self.go_table.aorbtn_phjl then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.StarSoulRankView.Name)
    end
end
return StarSoulView
