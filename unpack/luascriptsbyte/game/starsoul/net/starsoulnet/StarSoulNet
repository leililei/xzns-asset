---@class StarSoulNet : BaseGameNet	通信协议
local StarSoulNet = _G.BaseClass("StarSoulNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return StarSoulNet StarSoulNet
function StarSoulNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---获取排行榜数据
---@param callback function 完成回调
function StarSoulNet:GetRank(pbData, callback)
    local item = _G.ConfigManager.net_map.game_rank_system_prof_rank
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---星魂试炼信息
---@param callback function 完成回调
function StarSoulNet:GetInfo(callback)
    local item = _G.ConfigManager.net_map.game_system_prof_info
    local pbData = self:GetEmptyPB()
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end
---挑战Boss
function StarSoulNet:FightBoss(pbData, callback)
    local item = _G.ConfigManager.net_map.game_system_prof_fight
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
    return port
end

function StarSoulNet:Sweep(times, callback)
    local pbData = {num = times}
    local item = _G.ConfigManager.net_map.game_system_prof_sweep
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---获取通关录像
---@param pbdata system_prof.c2s_system_prof_recommend 发送数据
---@param callback function 回调方法
function StarSoulNet:GetRecommend(pbData, callback)
    local item = _G.ConfigManager.net_map.game_system_prof_recommend
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---获取单个录像数据
---@param pbdata system_prof.c2s_system_prof_report 发送数据
---@param callback function 回调方法
function StarSoulNet:GetRecord(pbData, callback)
    local item = _G.ConfigManager.net_map.game_system_prof_report
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function StarSoulNet:CallBack(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return StarSoulNet
