---@class SwornModel : GameDataModelBase  结义
---@field SociatySelf SociatyData 自己的公会数据
---@field SociatyRoleSelf guild.i_role_guild 公会个人数据
---@field super GameDataModelBase 游戏数据基类
local SwornModel = _G.BaseClass("SwornModel", _G.GameDataModelBase)

local SwornNet = require("SwornNet")
local SwornTaskData = require("SwornTaskData")

---@return SwornModel SwornModel
function SwornModel:GetInstance()
    return self.super.GetInstance(self)
end

---公会数据类构造函数
function SwornModel:__init()
    self.NewAppcetList = {}
    require "SwornManager":GetInstance():StartUp()
    _G.Events:GetInstance():AddListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.OnSwornOpenCall, self)
end

function SwornModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.OnSwornOpenCall, self)
end

function SwornModel:OnSwornOpenCall(id)
    if id == _G.FunctionID.Sworn then
        _G.Events:GetInstance():RemoveListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.OnSwornOpenCall, self)
        self:GetDataFormServer()
    end
end

function SwornModel:UpdateInfo(back)
    self.SwornBack = back
    self:GetInfo()
end

---拿数据
function SwornModel:GetDataFormServer()
    self:GetInfo()
end

---拿数据
function SwornModel:GetInfo()
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Sworn) then
        SwornNet:GetInstance():GetInfo(_G.handler(self, self.ParseData))
    else
        self.SwornInfo = nil
        self.super.ParseData(self)

        if _G.AppSetting.DEBUG then
            _G.Log("<color=#ff0000>不满足公会开放等级，拿到不公会数据</color>")
        end
    end
end

---任务完成
function SwornModel:FinshSwornTask(task_sid)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SwornTask.id)
end

---数据回调
function SwornModel:ParseData(msg)
    --_G.LogError(msg, "结义数据")
    if msg.ack == 1 then
        self.SwornInfo = msg

        self.super.ParseData(self)
        self.Task = {}

        local temptask = self.SwornInfo.self_info.task or {}
        for i = 1, #temptask do
            local task =
                SwornTaskData.New(temptask[i], _G.handler(self, self.FinshSwornTask), _G.MarkTaskType.SwornTask)
            table.insert(self.Task, task)
        end

        if #temptask > 0 then
            _G.PlayerPrefsManager.SetInt("SwornTaskFirst", 1)
            require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SwornTask.id)
        end

        self.FinshTask = {}

        local tempfinishtask = self.SwornInfo.self_info.finish_task or {}
        for i = 1, #tempfinishtask do
            table.insert(self.FinshTask, tempfinishtask[i])
            local tt = {}
            tt.sid = tempfinishtask[i]
            tt.target = {99}
            tt.state = _G.TaskEnum.ETaskState.Completed
            local task = SwornTaskData.New(tt, nil, _G.MarkTaskType.SwornTask)
            table.insert(self.Task, task)
        end

        self.CurrTask = {}

        local tempcurrtask = self.SwornInfo.pub_info.task_curr or {}
        for i = 1, #tempcurrtask do
            local task = tempcurrtask[i]
            table.insert(self.CurrTask, task)
        end

        local lol = msg.last_off_line or 0
        local giftInfo = self:GetSelfInfo().gift_info
        if giftInfo and #giftInfo > 0 then
            for i = 1, #giftInfo do
                ---如果有送花时间在离线中的话新进来给予红点提示
                if giftInfo[i].last_time > lol then
                    _G.PlayerPrefsManager.SetInt("SwornGiftBox", 1)
                    break
                end
            end
                    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SwornGift.id)
        end
    else
        self.SwornInfo = nil
        self.super.ParseData(self)

        self.TipSworn = true
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SwornNot.id)

        self:CheckRedPoint()
    end

    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SwornPass.id)
    if self.SwornBack then
        self.SwornBack()
        self.SwornBack = nil
    end
end

function SwornModel:CheckRedPoint()
    SwornNet:GetInstance():RequestInfo(
            function(list)
                local listCount = list.request_info and _G.table.count(list.request_info) or 0
                _G.PlayerPrefsManager.SetInt("SwornAccept", listCount > 0 and 1 or 0)
                require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SwornAcceptPage.id)
            end
    )
end

---结义后要刷新的红点
function SwornModel:CreateRefreshRedPoint()
    self.NewAppcetList = {}
    self.TipSworn = false
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SwornNot.id)
    _G.PlayerPrefsManager.SetInt("SwornAccept", 0)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SwornAcceptPage.id)
end

---解除结义后要刷新的结点
function SwornModel:ClearRefreshRedPoint()
    self.SwornInfo = nil
    self.Task = nil
    self.CurrTask = nil
    self.FinshTask = nil
    _G.PlayerPrefsManager.SetInt("SwornTaskFirst", 0)
    _G.PlayerPrefsManager.SetInt("SwornGiftBox", 0)
    _G.PlayerPrefsManager.SetInt("SwornAccept", 0)

    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SwornGift.id)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SwornTask.id)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SwornPass.id)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SwornWater.id)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SwornAcceptPage.id)
end

---更新任务进度
function SwornModel:UpdataTask(taskinfo)
    if nil ~= self.SwornInfo then
        for i = 1, #self.Task do
            if self.Task[i].i_task.sid == taskinfo.sid then
                self.Task[i]:UpdataData(taskinfo)

                _G.Events:GetInstance():Broadcast(_G.SwornEvents.TaskFinish)

                break
            end
        end
    end
end

---获取浇花道具数
function SwornModel:GetCoinNum()
    if nil ~= self.SwornInfo then
        return self.SwornInfo.self_info.battle_info.coin
    end

    return 0
end

---获取自身数据
function SwornModel:GetSelfInfo()
    if nil ~= self.SwornInfo then
        return self.SwornInfo.self_info
    end

    return nil
end

---获取全局数据
function SwornModel:GetPubInfo()
    if nil ~= self.SwornInfo then
        return self.SwornInfo.pub_info
    end

    return nil
end

---是否有改名次数
function SwornModel:CanChangeNameTimes()
    local pubInfo = self:GetPubInfo()
    if pubInfo then
        if nil == pubInfo.change_times then
            return true
        else
            for i = 1, #pubInfo.change_times do
                if _G.PlayerModel:GetInstance().role_uid == pubInfo.change_times[i].key then
                    return pubInfo.change_times[i].value < _G.ConfigManager.discrete_cfg[114606][1][1]
                end
            end
        end
    end
    return false
end

---消耗改名次数
function SwornModel:ChangeNameTimes()
    local pubInfo = self:GetPubInfo()
    if pubInfo then
        if nil == pubInfo.change_times then
            pubInfo.change_times = {}
            local info = {}
            info.key = _G.PlayerModel:GetInstance().role_uid
            info.value = 1
            table.insert(pubInfo.change_times, info)
        else
            for i = 1, #pubInfo.change_times do
                if _G.PlayerModel:GetInstance().role_uid == pubInfo.change_times[i].key then
                    pubInfo.change_times[i].value = pubInfo.change_times[i].value + 1
                end
            end
        end
    end
end

---是否有浇水次数
function SwornModel:IsCanWater()
    local selfInfo = self:GetSelfInfo()
    if selfInfo then
        return selfInfo.battle_info.coin > 0
    end
    return false
end

---是否有战令奖励
function SwornModel:IsCanGetPassAward()
    local selfInfo = self:GetSelfInfo()
    local lv = selfInfo and selfInfo.battle_info.lv or 0
    local ssbc = _G.ConfigManager.store_season_battle_cfg[708001]
    for i = 1, #ssbc.content do
        ---@type store_season_battlecon_cfg
        local cfgItem = _G.ConfigManager.store_season_battlecon_cfg[ssbc.content[i]]
        local ispass = lv >= cfgItem.level
        local isGet = self:CheckAwardGet(cfgItem.id)
        if ispass and (false == isGet) then
            return true
        end
    end
    return false
end

---判断奖励战令领取状态
function SwornModel:CheckAwardGet(id)
    local selfInfo = self:GetSelfInfo()
    if nil ~= selfInfo then
        if selfInfo.battle_info.award then
            return _G.table.indexof(selfInfo.battle_info.award, id) ~= false
        end
    end
    return false
end

return SwornModel
