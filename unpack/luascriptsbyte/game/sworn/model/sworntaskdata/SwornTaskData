require("ActiveTaskBase")
---@class SwornTaskData : ActiveTaskBase	中文描述
local SwornTaskData = _G.BaseClass("SwornTaskData", _G.ActiveTaskBase)

function SwornTaskData:Init()
    self.MarkTaskType = _G.MarkTaskType.SwornTask
end
function SwornTaskData:ParseData(task)
    ---任务对应 天数 标记任务完成用
    self.i_task = task
    self.Cfg = _G.ConfigManager.mission_extra_cfg[task.sid]
    if self.taskEnumType == nil then
        self.taskEnumType = self.Cfg.condition[1][1]
        self.taskcontentparams = self.Cfg.condition[1]
    end
    self:CheckLock()
    self:CheckTaskState()
    self:CheckTaskTarget()
end

---销毁对象时,析构函s数
function SwornTaskData:Dispose()
end
return SwornTaskData
