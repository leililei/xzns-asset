---@class SwornAcceptView : UIBaseView	自已以及其他人邀请情况
---@field public go_table SwornAcceptView_GoTable GoTable
local SwornAcceptView = _G.BaseClass("SwornAcceptView", _G.UIBaseView)

local SwornAppliedPanel = require "SwornAppliedPanel"
local SwornAcceptPanel = require "SwornAcceptPanel"

function SwornAcceptView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.SwornEvents.DoSworn, self.DoSworn, self)
    _G.Events:GetInstance():AddListener(_G.SwornEvents.OtherDoSworn, self.Close, self)
    _G.Events:GetInstance():AddListener(_G.SwornEvents.JumpApplyView, self.Close, self)
end

function SwornAcceptView:DoSworn()
    -- body
    self:Close()
end

---界面的入口函数
function SwornAcceptView:OnCreate()
    self.CurToggle = 1
    self:UpdatePanel()
end

---申请结义
function SwornAcceptView:UpdatePanel()
    if self.CurToggle == 1 then
        self.go_table.obj_ApplyPanel:SetActiveE(1)
        self.go_table.obj_AcceptPanel:SetActiveE(0)
        if nil == self.ApplyPanel then
            self.ApplyPanel = self:AddComponent(self.go_table.obj_ApplyPanel, SwornAppliedPanel.New())
        else
            self.ApplyPanel:UpdateComponent()
        end
    else
        self.go_table.obj_ApplyPanel:SetActiveE(0)
        self.go_table.obj_AcceptPanel:SetActiveE(1)
        if nil == self.AcceptPanel then
            self.AcceptPanel = self:AddComponent(self.go_table.obj_AcceptPanel, SwornAcceptPanel.New())
        else
            self.AcceptPanel:UpdateComponent()
        end
    end
end

---按钮点击事件在这里派发
function SwornAcceptView:OnClickBtn(go, isOn)
    if go == nil then
        return
    end
    local name = go:GetName()

    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_closeView" then
        self:Close()
    elseif name == "$_toggle_apply" then
        if isOn then
            self.CurToggle = 1
            self:UpdatePanel()
        end
    elseif name == "$_toggle_accept" then
        if isOn then
            self.CurToggle = 2
            self:UpdatePanel()
        end
    end
end

function SwornAcceptView:OnStartClose()
    _G.Events:GetInstance():RemoveListener(_G.SwornEvents.DoSworn, self.DoSworn, self)
    _G.Events:GetInstance():RemoveListener(_G.SwornEvents.OtherDoSworn, self.Close, self)
    _G.Events:GetInstance():RemoveListener(_G.SwornEvents.JumpApplyView, self.Close, self)
end

return SwornAcceptView
