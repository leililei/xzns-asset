---@class SwornTaskView : UIBaseView 结义任务面板
---@field public go_table SwornTaskView_GoTable GoTable
local SwornTaskView = _G.BaseClass("SwornTaskView", _G.UIBaseView)

local SwornManager = require "SwornManager"
local SwornModel = require "SwornModel"
local SwornNet = require "SwornNet"

function SwornTaskView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.SwornEvents.UnSworn, self.Close, self)
    _G.Events:GetInstance():AddListener(_G.SwornEvents.TaskFinish, self.TaskFinish, self)
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.OnCreate, self)
end

function SwornTaskView:OnStartClose()
    _G.Events:GetInstance():RemoveListener(_G.SwornEvents.UnSworn, self.Close, self)
    _G.Events:GetInstance():RemoveListener(_G.SwornEvents.TaskFinish, self.TaskFinish, self)
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.OnCreate, self)
end

function SwornTaskView:TaskFinish()
    self:UpdatePanel()
end

---界面的入口函数
function SwornTaskView:OnCreate()
    self.PublicInfo = SwornModel:GetInstance():GetPubInfo()
    self.SelfInfo = SwornModel:GetInstance():GetSelfInfo()
    if nil == self.PublicInfo.battle_record then
        self.PublicInfo.battle_record = {}
    end
    _G.PlayerPrefsManager.SetInt("SwornTaskFirst", 0)
    self.isAuto = _G.PlayerPrefsManager.GetInt("SwornAuto",1)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SwornTask.id)
    self:UpdatePanel()
end

-- region更新好友界面
---@param back function 更新列表后回调
function SwornTaskView:UpdatePanel()
    self.ListCount = #SwornModel:GetInstance().Task

    if not self.TaskSlc then
        self.go_table.scrollloopvectical_List:InitItemData(self.ListCount, _G.handler(self, self.RefreshTaskList))
        self.TaskSlc = true
    else
        self.go_table.scrollloopvectical_List:UpdateCount(self.ListCount)
    end

    local canGet, _ = self:CheckHasGet()
    --_G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_Onekey, canGet)
end

function SwornTaskView:GetCurrTarget(id)
    for i = 1, #SwornModel:GetInstance().CurrTask do
        if SwornModel:GetInstance().CurrTask[i].k == id then
            return SwornModel:GetInstance().CurrTask[i].v
        end
    end
    return 0
end

---更新任务列表
function SwornTaskView:RefreshTaskList(index, listView2)
    if index < 0 then
        return
    end
    local list
    list = SwornModel:GetInstance().Task
    local itemview = listView2
    local x = index + 1
    itemview:SetName(x)
    local tb = _G.GetAutoGoTable(itemview, _G.handlerbind(self, self.OnTaskListClick, x))
    local data = list[x]
    local cfg = data.Cfg

    tb.aortext_desc.text = _G.GetLangPackValue(cfg.desc)
    tb.aortext_progress.text = _G.GetLangPackValue(90031600055) .. self:GetCurrTarget(data.i_task.sid) .. "/" .. 2

    if nil == tb.LoadTans then
        tb.LoadTans = {}
    end

    if data.i_task.state == _G.TaskEnum.ETaskState.Completed then
        _G.GameUtil.SetActiveByCondition(tb.aorimage_Doned, true)
        _G.GameUtil.SetActiveByCondition(tb.aorbtn_Done, false)
        _G.GameUtil.SetActiveByCondition(tb.aorbtn_Goto, false)
    elseif data.i_task.state == _G.TaskEnum.ETaskState.Submited then
        _G.GameUtil.SetActiveByCondition(tb.aorimage_Doned, false)
        _G.GameUtil.SetActiveByCondition(tb.aorbtn_Done, true)
        _G.GameUtil.SetActiveByCondition(tb.aorbtn_Goto, false)
    else
        _G.GameUtil.SetActiveByCondition(tb.aorimage_Doned, false)
        _G.GameUtil.SetActiveByCondition(tb.aorbtn_Done, false)
        _G.GameUtil.SetActiveByCondition(tb.aorbtn_Goto, true)
    end

    local exp, water = SwornManager:GetInstance():GetFnishGetNum(data.i_task.sid)

    local totalAward = {}
    for i = 1, #cfg.reward do
        table.insert(totalAward, cfg.reward[i])
    end

    ----添加纯展示道具
    if water > 0 then
        table.insert(totalAward, {118, water})
    end
    if exp > 0 then
        table.insert(totalAward, {119, exp})
    end

    for i = 1, #totalAward do
        local aw = totalAward[i]

        if not tb.LoadTans[i] then
            tb.LoadTans[i] = 1
            _G.StorageManager:GetInstance():GetItemBaseView(
                aw[1],
                aw[2],
                tb.obj_goods,
                function(item)
                    tb.LoadTans[i] = item
                    if tb.obj_goods:GetChildCountE() > #totalAward then
                        item.gameObject:SetLocalScaleXYZ(0.85)
                        _G.GameUtil.SetActiveByCondition(item.gameObject, true)
                    else
                        item.gameObject:SetLocalScaleXYZ(0.85)
                        _G.GameUtil.SetActiveByCondition(item.gameObject, true)
                        item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    end
                end
            )
        else
            if not _G.IsNumber(tb.LoadTans[i]) then
                local item = tb.LoadTans[i]
                local newdata = _G.StorageManager:GetInstance():GetItemDataClassByCfg({aw[1], aw[2]})
                item:UpdateData(item.gameObject, newdata)

                _G.GameUtil.SetActiveByCondition(item.gameObject, true)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
        end
    end

    return itemview
end

function SwornTaskView:OnTaskListClick(go, _, index)
    if go == nil then
        return
    end
    local name = go:GetName()

    if name == "@_aorbtn_Done" then
        local ti = {SwornModel:GetInstance().Task[index].i_task.sid}
        local msg = {}
        msg.task_sid = ti
        msg.finish_type = 2
        SwornNet:GetInstance():FinishTask(
            msg,
            function(data)
                if data.ack == 1 then
                    local totalexp = 0
                    local totalwater = 0
                    for i = 1, #ti do
                        local exp, water = SwornManager:GetInstance():GetFnishGetNum(ti[i])
                        self.PublicInfo.exp = self.PublicInfo.exp + exp
                        totalexp = totalexp + exp
                        SwornManager:GetInstance():CheckPublicExp()
                        self.SelfInfo.battle_info.coin = self.SelfInfo.battle_info.coin + water
                        totalwater = totalwater + water
                        table.insert(SwornModel:GetInstance().FinshTask, ti[i])
                        for j = 1, #SwornModel:GetInstance().Task do
                            if ti[i] == SwornModel:GetInstance().Task[j].i_task.sid then
                                SwornModel:GetInstance().Task[j].i_task.state = _G.TaskEnum.ETaskState.Completed
                                break
                            end
                        end
                    end
                    for i = 1, #data.task_finish do
                        local info
                        for j = 1, #SwornModel:GetInstance().CurrTask do
                            if SwornModel:GetInstance().CurrTask[j].k == data.task_finish[i].k then
                                info = SwornModel:GetInstance().CurrTask[j]
                            end
                        end
                        if nil == info then
                            local kv = {}
                            kv.k = data.task_finish[i].k
                            kv.v = 1
                            table.insert(SwornModel:GetInstance().CurrTask, kv)
                        else
                            info.v = info.v + 1
                        end
                    end

                    --奖励
                    _G.StorageManager:GetInstance():ReceiveAwardData(data)

                    if totalwater > 0 then
                        local totalwaters = {118, totalwater}
                        _G.table.insert(data.award.item, { type = totalwaters })
                    end
                    if totalexp > 0 then
                        local totalexps = {119, totalexp}
                        _G.table.insert(data.award.item, { type = totalexps })
                    end

                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)

                    _G.Events:GetInstance():Broadcast(_G.SwornEvents.TaskFinish)

                    --自动提交礼物和浇水
                    if self.isAuto == 1 then
                        if totalwater > 0 then
                            SwornNet:GetInstance():WaterFlowers({num=totalwater},function(mwaterMsg)
                                if mwaterMsg.ack ~= 1 then
                                    return
                                end
                                local changeExp = totalwater * _G.ConfigManager.discrete_cfg[114608][1][1]
                                self.SelfInfo.battle_info.exp = self.SelfInfo.battle_info.exp + changeExp
                                self.SelfInfo.battle_info.coin = self.SelfInfo.battle_info.coin - totalwater

                                SwornManager:GetInstance():CheckBattleExp()

                                local info = {}
                                info.role_name = _G.PlayerModel:GetInstance().role_name
                                info.add_exp = changeExp
                                info.time = _G.TimeUtil.GetServerUnixTime()
                                _G.table.insert(self.PublicInfo.battle_record, 1, info)
                                _G.Events:GetInstance():Broadcast(_G.SwornEvents.WaterFlowers,mwaterMsg)
                                require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SwornWater.id)
                                require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SwornPass.id)
                            end)
                        end
                        local giftList = _G.ConfigManager.discrete_cfg[114607]
                        for _, v in pairs(data.award.item) do
                            local temp = _G.table.find(giftList,function(item)
                            return v.type and item[1] == v.type[1]
                        end)
                        if temp ~= nil then
                            local giftMsg = {
                                    num = v.type[2],
                                    sid = temp[1]
                                    }
                                    SwornNet:GetInstance():SendGift(giftMsg,function(giftData)
                                    if giftData.ack ~= 1 then
                                        return
                                    end
                                    self.PublicInfo.exp = self.PublicInfo.exp + giftMsg.num * temp[2]
                                    SwornManager:GetInstance():CheckPublicExp()
                                    _G.StorageManager:GetInstance():ConsumeItem(temp[1], nil, v.type[2])
                                    _G.Events:GetInstance():Broadcast(_G.SwornEvents.SendGift,giftData)
                                end)
                            end
                        end
                    end


                    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SwornTask.id)
                    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SwornWater.id)
                end
            end
        )
    elseif name == "@_aorbtn_Goto" then
        _G.JumpManager:GetInstance():Jump(SwornModel:GetInstance().Task[index].Cfg.link)
    end
end

function SwornTaskView:UpdateComponent()
end

function SwornTaskView:CheckHasGet()
    local ti = {}
    for i = 1, #SwornModel:GetInstance().Task do
        if SwornModel:GetInstance().Task[i].i_task.state == _G.TaskEnum.ETaskState.Submited then
            table.insert(ti, SwornModel:GetInstance().Task[i].i_task.sid)
        end
    end
    return #ti > 0, ti
end

---按钮点击事件在这里派发
function SwornTaskView:OnClickBtn(go, isOn)
    if go == nil then
        return
    end
    local name = go:GetName()

    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_closeView" then
        self:Close()
    elseif name == "@_aorbtn_Onekey" then
        local canGet, ti = self:CheckHasGet()
        if canGet then
            local msg = {}
            msg.task_sid = ti
            msg.finish_type = 2
            SwornNet:GetInstance():FinishTask(
                msg,
                function(data)
                    if data.ack == 1 then
                        local totalexp = 0
                        local totalwater = 0
                        for i = 1, #ti do
                            local exp, water = SwornManager:GetInstance():GetFnishGetNum(ti[i])
                            self.PublicInfo.exp = self.PublicInfo.exp + exp
                            totalexp = totalexp + exp
                            SwornManager:GetInstance():CheckPublicExp()
                            self.SelfInfo.battle_info.coin = self.SelfInfo.battle_info.coin + water
                            totalwater = totalwater + water
                            table.insert(SwornModel:GetInstance().FinshTask, ti[i])
                            for j = 1, #SwornModel:GetInstance().Task do
                                if ti[i] == SwornModel:GetInstance().Task[j].i_task.sid then
                                    SwornModel:GetInstance().Task[j].i_task.state = _G.TaskEnum.ETaskState.Completed
                                    break
                                end
                            end
                        end

                        for i = 1, #data.task_finish do
                            local info
                            for j = 1, #SwornModel:GetInstance().CurrTask do
                                if SwornModel:GetInstance().CurrTask[j].k == data.task_finish[i].k then
                                    info = SwornModel:GetInstance().CurrTask[j]
                                end
                            end
                            if nil == info then
                                local kv = {}
                                kv.k = data.task_finish[i].k
                                kv.v = 1
                                table.insert(SwornModel:GetInstance().CurrTask, kv)
                            else
                                info.v = info.v + 1
                            end
                        end

                        --奖励
                        _G.StorageManager:GetInstance():ReceiveAwardData(data)

                        if totalwater > 0 then
                            local totalwaters = {118, totalwater}
                            _G.table.insert(data.award.item, totalwaters)
                        end
                        if totalexp > 0 then
                            local totalexps = {119, totalexp}
                            _G.table.insert(data.award.item, totalexps)
                        end

                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
                        self:UpdatePanel()
                        _G.Events:GetInstance():Broadcast(_G.SwornEvents.TaskFinish)

                        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SwornTask.id)
                        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SwornWater.id)
                    end
                end
            )
        else
            if _G.AppSetting.DEBUG then
                _G.Log("没有任务可以领了")
            end
        end
    end
end

return SwornTaskView
