local SwornModel = require "SwornModel"
local SwornNet = require "SwornNet"

---@class SwornSettingView : UIBaseView	设置界面
---@field public go_table SwornSettingView_GoTable GoTable
local SwornSettingView = _G.BaseClass("SwornSettingView", _G.UIBaseView)

function SwornSettingView:Awake()
    self.SelfInfo = SwornModel:GetInstance():GetSelfInfo()
    self.PublicInfo = SwornModel:GetInstance():GetPubInfo()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.SwornEvents.UnSworn, self.Close, self)
end

---界面的入口函数
function SwornSettingView:OnCreate()
    self.Index = self.PublicInfo.link
    self.NewIndex = self.PublicInfo.link
    if self.Index == 1 then
        self.go_table.toggle_relation1.isOn = true
    elseif self.Index == 2 then
        self.go_table.toggle_relation2.isOn = true
    elseif self.Index == 3 then
        self.go_table.toggle_relation3.isOn = true
    elseif self.Index == 4 then
        self.go_table.toggle_relation4.isOn = true
    end

    local sgg = require "SwornManager":GetInstance()
    self.go_table.aortext_line1.text = sgg:GetQmName(1)
    self.go_table.aortext_line2.text = sgg:GetQmName(2)
    self.go_table.aortext_line3.text = sgg:GetQmName(3)
    self.go_table.aortext_line4.text = sgg:GetQmName(4)
    if _G.GameUtil.GetLang() == "ru" then
        self.go_table.aorimage_icon4.SpriteName = "ui_hy_icon_04"
    end
end

---按钮点击事件在这里派发
function SwornSettingView:OnClickBtn(go, isOn)
    local setlink = function()
        local msg = {}
        msg.index = self.NewIndex
        SwornNet:GetInstance():SetLink(
            msg,
            function(data)
                if data.ack == 1 then
                    self.Index = self.NewIndex
                    self.PublicInfo.link = self.NewIndex
                    _G.Events:GetInstance():Broadcast(_G.SwornEvents.UpdateLink)
                    SwornModel:GetInstance():ChangeNameTimes()
                    --_G.PopWindowManager:GetInstance():ShowAllTips(1001, _G.GetLangPackValue(90000000402))
                    self:Close()
                end
            end
        )
    end
    if go == self.go_table.aorbtn_closeView or go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.toggle_relation1 then
        self.NewIndex = 1
    elseif go == self.go_table.toggle_relation2 then
        self.NewIndex = 2
    elseif go == self.go_table.toggle_relation3 then
        self.NewIndex = 3
    elseif go == self.go_table.toggle_relation4 then
        self.NewIndex = 4
    elseif go == self.go_table.aorbtn_UnSworn then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            940109,
            nil,
            function()
                ---解除关系
                SwornNet:GetInstance():RemoveLink(
                    function(data)
                        if data.ack == 1 then
                            SwornModel:GetInstance():ClearRefreshRedPoint()
                            _G.Events:GetInstance():Broadcast(_G.SwornEvents.UnSworn)
                        end
                    end
                )
            end,
            nil,
            nil,
            false,
            math.floor(_G.ConfigManager.discrete_cfg[114605][1][1] / 60)
        )
    elseif go == self.go_table.aorbtn_Sure then
        if SwornModel:GetInstance():CanChangeNameTimes() then
            if self.Index ~= self.NewIndex then
                _G.PopWindowManager:GetInstance():ShowAllTips(
                    940112,
                    nil,
                    function()
                        setlink()
                    end
                )
            else
                --_G.PopWindowManager:GetInstance():ShowAllTips(1001, _G.GetLangPackValue(90000000402))
                self:Close()
            end
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(940113)
        end
    end
end

function SwornSettingView:OnStartClose()
    _G.Events:GetInstance():RemoveListener(_G.SwornEvents.UnSworn, self.Close, self)
end

return SwornSettingView
