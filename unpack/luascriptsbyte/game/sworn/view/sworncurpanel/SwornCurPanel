    _G.UIUtils.SetPlayerHeadItemNew(self.go_table.obj_HeadItemBase, Params_PlayerHeadItem, 1, true, true, true)

    ---@type Params_PlayerHeadItem
    local Params_PlayerHeadItemOther = {}
    Params_PlayerHeadItemOther.frame = self.SelfInfo.role_info.frame
    Params_PlayerHeadItemOther.lv = self.SelfInfo.role_info.level
    Params_PlayerHeadItemOther.style = self.SelfInfo.role_info.style
    Params_PlayerHeadItemOther.sid = self.SelfInfo.role_info.style
    Params_PlayerHeadItemOther.title = self.SelfInfo.role_info.title
    Params_PlayerHeadItemOther.uid = self.SelfInfo.role_info.uid
    _G.UIUtils.SetPlayerHeadItemNew(
        self.go_table.obj_HeadItemBaseOther,
        Params_PlayerHeadItemOther,
        1,
        true,
        true,
        true
    )
end

function SwornCurPanel:TaskFinish()
    self:UpdateExp()
    if self.CurToggle == 1 then
        self:UpdatePanel()
    end
end

----更新好友界面
function SwornCurPanel:UpdatePanel()
    if self.CurToggle == 1 then
        self.ListCount = #self.Tasks

        self.go_table.obj_gift:SetActiveE(0)
        self.go_table.obj_task:SetActiveE(1)

        if not self.TaskSlc then
            self.go_table.scrollloopvectical_Tasks:InitItemData(self.ListCount, _G.handler(self, self.RefreshTaskList))
            self.TaskSlc = true
        else
            self.go_table.scrollloopvectical_Tasks:UpdateCount(self.ListCount)
        end
    else
        self.ListCount = #self.Gifts

        self.go_table.obj_gift:SetActiveE(1)
        self.go_table.obj_task:SetActiveE(0)

        if not self.GiftSlc then
            self.go_table.scrollloopvectical_Gifts:InitItemData(self.ListCount, _G.handler(self, self.RefreshGiftList))
            self.GiftSlc = true
        else
            self.go_table.scrollloopvectical_Gifts:UpdateCount(self.ListCount)
        end
    end
end

function SwornCurPanel:UpdateChat()
    local ChatManager = require("ChatManager"):GetInstance()
    local ChatInfo = ChatManager.Chat_InfoAll
    if ChatInfo and ChatInfo[_G.ChatType.privateChat] and ChatInfo[_G.ChatType.privateChat][self.SelfInfo.role_info.uid] then
        self.ChatInfo = ChatInfo[_G.ChatType.privateChat][self.SelfInfo.role_info.uid]
        if self.lastChat == self.ChatInfo[#self.ChatInfo].n_content then
            return
        end
        local lastContent = {}
        for _, v in pairs(self.ChatInfo) do
            _G.table.insert(lastContent, { lastPlayer = v.role_info.name, lastChat = v.n_content })
        end
        --防止显示的聊天记录过多
        local maxLimit = 5
        local showIndex = #lastContent - _G.math.min(maxLimit, #lastContent)
        self.go_table.obj_minChat:RemoveAllChildren()
        for i = showIndex + 1, #lastContent do
            local info = lastContent[i]
            local item = _G.InstantiateObject(self.go_table.obj_minChatItem, self.go_table.obj_minChat)
            local tb = _G.GetAutoGoTable(item)
            tb.aortext_pindao.text = ""
            tb.aortext_info.text = "<color=#85b7e6>" .. info.lastPlayer .. "：</color>" ..
                    _G.string.removeRichTextSpecal(info.lastChat)
        end
        self.lastChat = lastContent[#lastContent].lastChat
    end

end

function SwornCurPanel:UpdateLink()
    self.go_table.aortext_gx.text = SwornManager:GetInstance():GetQmName(self.PublicInfo.link)
end

function SwornCurPanel:UpdateExp()
    self.lv = self.PublicInfo and self.PublicInfo.lv or 0
    self.exp = self.PublicInfo and self.PublicInfo.exp or 0

    self.go_table.aortext_level.text = self.PublicInfo.lv

    -- local lastExp = 0
    -- if self.lv >= 1 then
    --     lastExp = _G.ConfigManager.friend_level_cfg[self.lv].exp
    -- end
    local maxExp

    if self.lv >= #_G.ConfigManager.friend_level_cfg then
        maxExp = _G.ConfigManager.friend_level_cfg[self.lv].exp --- lastExp
    else
        maxExp = _G.ConfigManager.friend_level_cfg[self.lv + 1].exp --- lastExp
    end

    local expStr, expslider
    if self.exp == maxExp then
        expStr = "" --"Max"
        expslider = self.lv > 0 and 1 or 0
    else
        if self.exp > maxExp then
            self.exp = maxExp
        end
        expStr = string.format("%d/%d", self.exp, maxExp)
        expslider = self.exp / maxExp
    end
    self.go_table.aortext_exp.text = expStr
    self.go_table.slider_exp.value = expslider
end

---更新礼物列表
function SwornCurPanel:RefreshGiftList(index, listView2)
    if index < 0 then
        return
    end
    local list
    list = self.Gifts
    local itemview = listView2
    local x = index + 1
    itemview:SetName(x)
    local data = list[x]
    local tb = _G.GetAutoGoTable(itemview, _G.handlerbind(self, self.OnGiftListClick, data[1], data[2], x))

    local num = _G.StorageManager:GetInstance():GetItemCountBySid(data[1])

    if not tb.LoadTans then
        tb.LoadTans = 1
        _G.StorageManager:GetInstance():GetItemBaseView(
            data[1],
            num,
            tb.obj_goods,
            function(item)
                tb.LoadTans = item
                item.gameObject:SetLocalScaleXYZ(1)
                _G.GameUtil.SetActiveByCondition(item.gameObject, true)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
        )
    else
        if not _G.IsNumber(tb.LoadTans) then
            local item = tb.LoadTans
            local newdata = _G.StorageManager:GetInstance():GetItemDataClassByCfg({data[1], num})
            item:UpdateData(item.gameObject, newdata)
            item.gameObject:SetLocalScaleXYZ(1)
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end
    end

    return itemview
end

function SwornCurPanel:OnGiftListClick(_, _, id, exp, index)
    local num = _G.StorageManager:GetInstance():GetItemCountBySid(id)
    if num >= 1 then
        self.go_table.obj_giftchoose:SetActiveE(1)
        self.CurGift = id
        self.CurGiftIndex = index
        self.CurExp = exp
        self.ParamsProp_useNum = num
        self.MaxNum = num
        self:UpdateGiftInput()
        self:UpdateGiftInfo()
    else
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ItemBuyView.Name,
            self.ItemBuyWayIds[index],
            _G.handler(self, self.OnBuyCall)
        )
    end
end

---购买完成
function SwornCurPanel:OnBuyCall()
    self:UpdatePanel()
end

---更新任务列表
function SwornCurPanel:RefreshTaskList(index, listView2)
    if index < 0 then
        return
    end
    local item = listView2
    local x = index + 1
    item:SetName(x)
    local tb = _G.GetAutoGoTable(item, _G.handlerbind(self, self.OnTaskListClick, x))
    local cfg = _G.ConfigManager.mission_extra_cfg[self.Tasks[x][1]]
    tb.aortext_desc.text = _G.GetLangPackValue(cfg.desc)
    tb.aortext_process.text = self:GetCurrTarget(cfg.id) .. "/" .. 2
    if self:GetCurrTarget(cfg.id) == 2 then
        tb.aortext_process.color = _G.Color.New(11 / 255, 105 / 255, 1 / 255, 1)
        tb.aorimage_pointOn:SetActiveE(1)
    else
        tb.aortext_process.color = _G.Color.New(204 / 255, 85 / 255, 27 / 255, 1)
        tb.aorimage_pointOn:SetActiveE(0)
    end

    return item
end

function SwornCurPanel:GetCurrTarget(id)
    for i = 1, #SwornModel:GetInstance().CurrTask do
        if SwornModel:GetInstance().CurrTask[i].k == id then
            return SwornModel:GetInstance().CurrTask[i].v
        end
    end
    return 0
end

function SwornCurPanel:OnTaskListClick()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SwornTaskView.Name)
end

