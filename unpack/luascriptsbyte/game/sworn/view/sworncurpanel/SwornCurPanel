---按钮点击事件在这里派发
function SwornCurPanel:OnClickBtn(go, isOn)
    if go == nil then
        return
    end
    local name = go:GetName()

    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_closeView" then
        self:Close()
    elseif name == "@_aorbtn_auto" then
        self.isAuto = self.isAuto == 0 and 1 or 0
        self:UpdateAuto()
        _G.PlayerPrefsManager.SetInt("SwornAuto",self.isAuto)
    elseif name == "@_aorbtn_lwh" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SwornGiftBoxView.Name)
    elseif name == "@_aorbtn_setting" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SwornSettingView.Name)
    elseif name == "@_aorbtn_exptips" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 133)
    elseif name == "@_aorbtn_propSub" then
        self:OnClick_PropUse_Sub()
    elseif name == "@_aorbtn_propAdd" then
        self:OnClick_PropUse_Add()
    elseif name == "@_aorbtn_gifttips" then
        ---礼物tips
    elseif name == "@_aorbtn_sworntask" then
        ---任务
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SwornTaskView.Name)
    elseif name == "@_aorbtn_closeflower" then
        ---关闭送花界面
        self.go_table.obj_showflower:SetActiveE(0)
        if self.CurFlowerEff then
            _G.UIUtils.RemoveEffect(self.CurFlowerEff, 0)
            self.CurFlowerEff = nil
        end
    elseif name == "@_aorbtn_giftsend" then
        local msg = {}
        msg.sid = self.CurGift
        msg.num = self.ParamsProp_useNum
        SwornNet:GetInstance():SendGift(
            msg,
            function(data)
                if data.ack~=1 then
                    return
                end
                self.PublicInfo.exp = self.PublicInfo.exp + msg.num * self.CurExp

                SwornManager:GetInstance():CheckPublicExp()

                _G.StorageManager:GetInstance():ConsumeItem(self.CurGift, nil, msg.num)
                self.MaxNum = self.MaxNum - msg.num
                self:SendGiftEnd(data)
            end
        )
    elseif name == "@_aorbtn_giftclose" then
        self.go_table.obj_giftchoose:SetActiveE(0)
--[[    elseif go == self.go_table.toggle_task then
        if isOn then
            self.CurToggle = 1
            self:UpdatePanel()
        end
    elseif go == self.go_table.toggle_gift then
        if isOn then
            self.CurToggle = 2
            self:UpdatePanel()
        end]]
    elseif name == "@_aorbtn_chatView" then
        _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.ChatView.Name,
                _G.ChatType.privateChat,
                {},
                nil,
                nil,
                self.SelfInfo.role_info.uid
        )
    end
end

function SwornCurPanel:InitToggle()
    self.toggles = {
        [1] = _G.GetAutoGoTable(
                self.go_table.toggle_task,
                _G.handlerbind(self, self.OnClickToggle, 1, _G.handler(self, self.UpdatePanel))
        ),
        [2] = _G.GetAutoGoTable(
                self.go_table.toggle_gift,
                _G.handlerbind(self, self.OnClickToggle, 2, _G.handler(self, self.UpdatePanel))
        ),
    }
    
    self:OnClickToggle(self.toggles[self.CurToggle], true, self.CurToggle, _G.handler(self, self.UpdatePanel))
end

function SwornCurPanel:OnClickToggle(go, isOn, key, call)
    if isOn then
        self.CurToggle = key
    end

    for k, tb in pairs(self.toggles) do
        if k ~= key then
            tb.isOn = false
            tb.aorimage_isOff:SetActiveE(1)
            tb.aorimage_isOn:SetActiveE(0)
        end
    end
    
    local tb = self.toggles[key]
    tb.aorimage_isOff:SetActiveE(not isOn and 1 or 0)
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    if isOn and call then
        call()
    end
end

function SwornCurPanel:OnClick_PropUse_Add()
    if self.ParamsProp_useNum < self.MaxNum then
        self.ParamsProp_useNum = self.ParamsProp_useNum + 1
    end
    self:UpdateGiftInput()
end

function SwornCurPanel:OnClick_PropUse_Sub()
    if self.ParamsProp_useNum > 1 then
        self.ParamsProp_useNum = self.ParamsProp_useNum - 1
    end
    self:UpdateGiftInput()
end

function SwornCurPanel:SendGiftEnd(data)
    if data.ack == 1 then
        _G.Log("赚送鲜花成功")

        _G.Events:GetInstance():Broadcast(
            _G.ePlayAactionEvent.PlayAaction,
            {_G.ActiveTaskEnum.ConditionEnum.Sworn.FlowerOne},
            1
        )

        self:UpdateExp()
        self:UpdatePanel()
        self:UpdateGiftInfo()
        self:ShowFlower(self.CurGiftIndex)
        -- 在赠送鲜花成功后，关闭赠送弹窗
        self.go_table.obj_giftchoose:SetActiveE(0)
    end
end

function SwornCurPanel:UpdateGiftInput()
    self.go_table.aorinputfield_userNum.text = self.ParamsProp_useNum
end

function SwornCurPanel:UpdateGiftInfo()
    if not self.go_table.GiftLoadTans then
        self.go_table.GiftLoadTans = 1
        _G.StorageManager:GetInstance():GetItemBaseView(
            self.CurGift,
            self.MaxNum,
            self.go_table.obj_giftgoods,
            function(item)
                self.go_table.GiftLoadTans = item
                item.gameObject:SetLocalScaleXYZ(1)
                _G.GameUtil.SetActiveByCondition(item.gameObject, true)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                self.go_table.aortext_giftname.text = _G.GetLangPackValue(item.cfg.Name)
                self.go_table.aortext_giftdesc.text = _G.GetLangPackValue(item.cfg.Describe)
            end
        )
    else
        if not _G.IsNumber(self.go_table.GiftLoadTans) then
            local item = self.go_table.GiftLoadTans
            local newdata = _G.StorageManager:GetInstance():GetItemDataClassByCfg({self.CurGift, self.MaxNum})
            item:UpdateData(item.gameObject, newdata)
            item.gameObject:SetLocalScaleXYZ(1)
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            self.go_table.aortext_giftname.text = _G.GetLangPackValue(item.cfg.Name)
            self.go_table.aortext_giftdesc.text = _G.GetLangPackValue(item.cfg.Describe)
        end
    end
end

function SwornCurPanel:OnEndEditorDeclaration(input)
    if not tonumber(input) then
        input = self.ParamsProp_useNum
    end
    local num = tonumber(input)
    local max = self.MaxNum
    local min = 1
    if num >= max then
        num = max
    elseif num <= min then
        num = min
    end
    self.ParamsProp_useNum = num
    self:UpdateGiftInput()
end

function SwornCurPanel:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.SwornEvents.TaskFinish, self.TaskFinish, self)
    _G.Events:GetInstance():RemoveListener(_G.SwornEvents.UpdateLink, self.UpdateLink, self)
    _G.Events:GetInstance():RemoveListener(_G.SwornEvents.UpdateExp, self.UpdateSelfExp, self)
    _G.Events:GetInstance():RemoveListener(_G.eChatStatus.newChat, self.UpdateChat, self)
    _G.Events:GetInstance():RemoveListener(_G.eChatStatus.SendGift, self.SendGiftEnd, self)
end

return SwornCurPanel
