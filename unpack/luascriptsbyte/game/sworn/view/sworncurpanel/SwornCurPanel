local SwornPanelBase = require "SwornPanelBase"
---@class SwornCurPanel : SwornPanelBase	中文描述
local SwornCurPanel = _G.BaseClass("SwornCurPanel", SwornPanelBase)

local SwornManager = require "SwornManager"
local SwornModel = require "SwornModel"
local SwornNet = require "SwornNet"

function SwornCurPanel:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.SwornEvents.TaskFinish, self.TaskFinish, self)
    _G.Events:GetInstance():AddListener(_G.SwornEvents.UpdateLink, self.UpdateLink, self)
    _G.Events:GetInstance():AddListener(_G.SwornEvents.UpdateExp, self.UpdateSelfExp, self)
    _G.Events:GetInstance():AddListener(_G.eChatStatus.newChat, self.UpdateChat, self)
    _G.Events:GetInstance():AddListener(_G.eChatStatus.SendGift, self.SendGiftEnd, self)
    self.go_table.aorinputfield_userNum.onEndEdit:AddListener(_G.handler(self, self.OnEndEditorDeclaration))
end

function SwornCurPanel:UpdateSelfExp()
    SwornManager:GetInstance():CheckPublicExp()

    self:UpdateExp()
end

---界面的入口函数
function SwornCurPanel:OnCreate(curPanelDefaultIndex)
    self.Gifts = _G.ConfigManager.discrete_cfg[114607]
    self.CurGift = 0
    self.go_table.obj_giftchoose:SetActiveE(0)
    self.Tasks = _G.ConfigManager.discrete_cfg[114610]
    self.SelfInfo = SwornModel:GetInstance():GetSelfInfo()
    self.PublicInfo = SwornModel:GetInstance():GetPubInfo()
    self.CurToggle = curPanelDefaultIndex or 1
    self.ItemBuyWayIds = {60001, 60002, 60003}
    self.isAuto = _G.PlayerPrefsManager.GetInt("SwornAuto",1)
    self:UpdateAuto()
    self:StaticInfo()
    self:UpdateExp()
    self:UpdateLink()
    self:UpdateChat()
    self:InitToggle()
end

function SwornCurPanel:UpdateView()
    self:UpdateExp()
end

function SwornCurPanel:UpdateAuto()
    if self.isAuto == 1 then
        self.go_table.aorimage_autoGou:SetActiveE(1)
    else
        self.go_table.aorimage_autoGou:SetActiveE(0)
    end
end

