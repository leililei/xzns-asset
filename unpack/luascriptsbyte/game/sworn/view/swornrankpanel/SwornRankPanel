local SwornPanelBase = require "SwornPanelBase"
---@class SwornRankPanel : SwornPanelBase	排行
local SwornRankPanel = _G.BaseClass("SwornRankPanel", SwornPanelBase)

local SwornModel = require "SwornModel"
local SwornNet = require "SwornNet"

--排名前三bg
local IconName = {
    [1] = "0ui_icon_diyi",
    [2] = "0ui_icon_dier",
    [3] = "0ui_icon_disan",
}

local Gradient = {
    [1] = {"FFCB28", "ffffff", "110802"},
    [2] = {"E930FF", "ffffff", "110802"},
    [3] = {"1F7296", "ffffff", "110802"},
}

function SwornRankPanel:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self:UpdateComponent()
    self.top3Tb = {
        _G.GetAutoGoTable(self.go_table.obj_no1, _G.handlerbind(self, self.OpenPlayerInfo, 1)),
        _G.GetAutoGoTable(self.go_table.obj_no2, _G.handlerbind(self, self.OpenPlayerInfo, 2)),
        _G.GetAutoGoTable(self.go_table.obj_no3, _G.handlerbind(self, self.OpenPlayerInfo, 3))
    }
    local count = #self.top3Tb
    for i = 1, count do
        UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.SwornViewRoleNode, self.top3Tb[i])
    end
end

function SwornRankPanel:UpdateComponent()
    self.RankSelf = nil
    self.SelfInfo = SwornModel:GetInstance():GetSelfInfo()
    self.PublicInfo = SwornModel:GetInstance():GetPubInfo()
    self.IsSworn = self.SelfInfo ~= nil
    --_G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_closeView, not self.IsSworn)

end

---界面的入口函数
function SwornRankPanel:OnCreate()
    self:UpdatePanel()
end

---@param back function 更新列表后回调
function SwornRankPanel:UpdatePanel()
    local msg = {}
    msg.page = 1
    SwornNet:GetInstance():FriendBattleRank(
        msg,
        function(data)
            self.DataList = data.ranks or {}
            for i = 1, #self.DataList do
                local info = self.DataList[i]
                if
                    info.role_1.uid == _G.PlayerModel:GetInstance().role_uid or
                        info.role_2.uid == _G.PlayerModel:GetInstance().role_uid
                 then
                    info.index = self.PublicInfo.link
                    info.lv = self.PublicInfo.lv
                    info.exp = self.PublicInfo.exp
                end
            end
            _G.SortList(
                self.DataList,
                function(a)
                    return a.lv, a.exp
                end
            )
            self:UpdateList()

            for i = 1, #self.DataList do
                if
                    self.DataList[i].role_1.uid == _G.PlayerModel:GetInstance().role_uid or
                        self.DataList[i].role_2.uid == _G.PlayerModel:GetInstance().role_uid
                 then
                    self.RankSelf = i
                    break
                end
            end
            self:UpdateSelf()
        end
    )
end

function SwornRankPanel:UpdateList()
    local count = #self.DataList
    if nil == self.FriendSlc then
        self.go_table.scrollloopvectical_Rank:InitItemData(count, _G.handler(self, self.RefreshList))
        self.FriendSlc = true
    else
        self.go_table.scrollloopvectical_Rank:UpdateCount(count)
    end
    self:UpdateTop3Rank()
    self.go_table.aortext_noRank:SetActiveE(count > 0 and 0 or 1)
end

---更新列表
function SwornRankPanel:RefreshList(index, listView2)
    if index < 0 then
        return
    end
    local list
    list = self.DataList
    local item = listView2
    local x = index + 1
    item:SetName(x)
    local tb = _G.GetAutoGoTable(item)
    local data = list[x]

    tb.aortext_gx.text = require "SwornManager":GetInstance():GetQmName(data.index)
    tb.aortext_level.text = data.lv
    tb.aortext_qmd.text = data.exp

    if x > 3 then
        tb.aorimage_rank:SetActiveE(0)
        tb.aortext_rank.text = x
    else
        tb.aorimage_rank:SetActiveE(1)
        tb.aorimage_rank.SpriteName = IconName[x]
        --local ctm = require "CommonTipManager":GetInstance()
        --ctm:SetItemTextGradient(tb.aortext_TopRank.gameObject, x)
        self:SetItemRankInfo(tb, x)
        tb.aortext_rank.text = ""
    end

    ---@type Params_PlayerHeadItem
    local Params_PlayerHeadItem = {}
    Params_PlayerHeadItem.frame = data.role_1.frame
    Params_PlayerHeadItem.lv = data.role_1.level
    Params_PlayerHeadItem.style = data.role_1.style
    Params_PlayerHeadItem.sid = _G.ConfigManager.player_portrait_cfg[data.role_1.style] and _G.ConfigManager.player_portrait_cfg[data.role_1.style].ID or 0
    if data.role_1.uid ~= _G.PlayerModel:GetInstance().role_uid then
        Params_PlayerHeadItem.uid = data.role_1.uid
    end
    Params_PlayerHeadItem.title = data.role_1.title
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, Params_PlayerHeadItem, 1, true, true, true)

    tb.aortext_name.text = data.role_1.name

    ---@type Params_PlayerHeadItem
    local Params_PlayerHeadItemOther = {}
    Params_PlayerHeadItemOther.frame = data.role_2.frame
    Params_PlayerHeadItemOther.lv = data.role_2.level
    Params_PlayerHeadItemOther.style = data.role_2.style
    Params_PlayerHeadItemOther.sid = _G.ConfigManager.player_portrait_cfg[data.role_2.style] and _G.ConfigManager.player_portrait_cfg[data.role_2.style].ID or 0
    if data.role_2.uid ~= _G.PlayerModel:GetInstance().role_uid then
        Params_PlayerHeadItemOther.uid = data.role_2.uid
    end
    Params_PlayerHeadItemOther.title = data.role_2.title
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBaseOther, Params_PlayerHeadItemOther, 1, true, true, true)

    tb.aortext_othername.text = data.role_2.name

    if
        data.role_1.uid == _G.PlayerModel:GetInstance().role_uid or
            data.role_2.uid == _G.PlayerModel:GetInstance().role_uid
     then
        tb.aortext_gx.text = require "SwornManager":GetInstance():GetQmName(self.PublicInfo.link)
        tb.aortext_level.text = self.PublicInfo.lv
        tb.aortext_qmd.text = self.PublicInfo.exp
    end

    return item
end

function SwornRankPanel:UpdateSelf()
    if self.RankSelf then
        local data = self.DataList[self.RankSelf]
        if data then
            self.go_table.obj_unRank:SetActiveE(0)
            self.go_table.obj_SingleMe:SetActiveE(1)

            self.go_table.aortext_gx.text = require "SwornManager":GetInstance():GetQmName(self.PublicInfo.link)
            self.go_table.aortext_level.text = self.PublicInfo.lv
            self.go_table.aortext_qmd.text = self.PublicInfo.exp

            if self.RankSelf > 3 then
                self.go_table.aorimage_rank:SetActiveE(0)
                self.go_table.aortext_rank.text = self.RankSelf
            else
                self.go_table.aorimage_rank:SetActiveE(1)
                self.go_table.aorimage_rank.SpriteName = IconName[self.RankSelf]
                --local ctm = require "CommonTipManager":GetInstance()
                --ctm:SetItemTextGradient(self.go_table.aortext_TopRank.gameObject, self.RankSelf)
                self:SetItemRankInfo(self.go_table, self.RankSelf)
                self.go_table.aortext_rank.text = ""
            end

            ---@type Params_PlayerHeadItem
            local Params_PlayerHeadItem = {}
            Params_PlayerHeadItem.frame = data.role_1.frame
            Params_PlayerHeadItem.lv = data.role_1.level
            Params_PlayerHeadItem.style = data.role_1.style
            Params_PlayerHeadItem.sid = _G.ConfigManager.player_portrait_cfg[data.role_1.style] and _G.ConfigManager.player_portrait_cfg[data.role_1.style].ID or 0
            Params_PlayerHeadItem.title = data.role_1.title
            if data.role_1.uid ~= _G.PlayerModel:GetInstance().role_uid then
                Params_PlayerHeadItem.uid = data.role_1.uid
            end
            _G.UIUtils.SetPlayerHeadItemNew(self.go_table.obj_HeadItemBase, Params_PlayerHeadItem, 1, true, true, true)

            self.go_table.aortext_name.text = data.role_1.name

            ---@type Params_PlayerHeadItem
            local Params_PlayerHeadItemOther = {}
            Params_PlayerHeadItemOther.frame = data.role_2.frame
            Params_PlayerHeadItemOther.lv = data.role_2.level
            Params_PlayerHeadItemOther.style = data.role_2.style
            Params_PlayerHeadItemOther.sid = _G.ConfigManager.player_portrait_cfg[data.role_2.style] and _G.ConfigManager.player_portrait_cfg[data.role_2.style].ID or 0
            Params_PlayerHeadItemOther.title = data.role_2.title
            if data.role_2.uid ~= _G.PlayerModel:GetInstance().role_uid then
                Params_PlayerHeadItemOther.uid = data.role_2.uid
            end
            _G.UIUtils.SetPlayerHeadItemNew(
                self.go_table.obj_HeadItemBaseOther,
                Params_PlayerHeadItemOther,
                1,
                true,
                true,
                true
            )

            self.go_table.aortext_othername.text = data.role_2.name
        else
            self.go_table.obj_unRank:SetActiveE(1)
            self.go_table.obj_SingleMe:SetActiveE(0)
        end
    else
        self.go_table.obj_unRank:SetActiveE(1)
        self.go_table.obj_SingleMe:SetActiveE(0)
    end
end

function SwornRankPanel:UpdateTop3Rank()
    local tb, data
    self.uidRank = {}
    self.roleSkin = {}

    for i = 1, 3 do
        tb = self.top3Tb[i]
        data = self.DataList[i]

        -- 清空角色节点
        for n = 1, 2 do
            tb["trans_role"..n]:ClearChildren()
        end

        -- 设置角色名称和黑影
        self:SetRoleNames(tb, data, i)

        -- 加载模型
        if data then
            self:LoadModels(tb, data, i)
        end
    end
end

function SwornRankPanel:SetRoleNames(tb, data, i)
    -- 遍历 role_1 和 role_2，设置名称
    for j = 1, 2 do
        if data == nil then
            tb["aortext_name"..j].text = _G.GetLangPackValue(90021800103)  -- 默认名称
        else
            local role = data["role_"..j]
            if role then
                tb["aortext_name"..j].text = role.name  -- 设置名称
            else
                tb["aortext_name"..j].text = _G.GetLangPackValue(90021800103)  -- 默认名称
            end
            tb["aorrawimage_noRole"..j]:SetActiveE(role and 0 or 1)
        end
    end
end

function SwornRankPanel:LoadModels(tb, data, i)
    for j = 1, 2 do
        local role = data["role_"..j]
        if role then
            local playerUid = role.uid
            -- 获取玩家信息
            require("SystemSettingNet"):GetInstance():GetPlayerInfo(
                    { uid = playerUid },
                    function(msg)
                        if not msg.info then
                            return
                        end
                        -- 获取角色配置
                        local cfg = require "CardCommentManager":GetInstance():CardData(msg.info.city_style_id, false)
                        local scale = cfg.size2
                        local pos = cfg.pos_portrait

                        -- 清空目标节点
                        tb["trans_role"..j]:ClearChildren()

                        local battleSpine = UIUtils.GetBattleSpine(cfg,UseBattleSpine.RankView)

                        -- 加载模型
                        _G.PoolsManager:GetInstance():Spawn(
                                battleSpine,
                                _G.ePoolType.Temporary,
                                tb["trans_role"..j],
                                function(trans)
                                    if trans == nil then
                                        if _G.AppSetting.DEBUG then
                                            _G.LogError("角色无法加载 path:" .. cfg.ModelPathHi .. "    CardInfoView LoadRoleScene")
                                        end
                                        return
                                    end
                                    if self.go_table == nil then
                                        _G.DestroyObject(trans)
                                        return
                                    end
                                    trans:SetParentE(tb["trans_role"..j])
                                    trans:SetLocalPosition(0, 0, 0)
                                    trans:SetLocalScaleXYZ(scale)
                                    local rolePoint = trans:GetComponentE(_G.typeof(_G.CS.RolePoint))
                                    if rolePoint == nil then
                                        rolePoint = trans:AddComponentE(_G.typeof(_G.CS.RolePoint))
                                    end
                                end
                        )
                    end
            )
        end
    end
end

function SwornRankPanel:SetItemRankInfo(go, index)
    local ctrl = go
    local eIndex = index
    if eIndex <= 3 then
        ctrl.aortext_TopRank.text = eIndex
        local gradient = ctrl.aortext_TopRank:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient))
        local c1 = _G.ColorTools.FormatColorByString(Gradient[eIndex][1])
        local c2 = _G.ColorTools.FormatColorByString(Gradient[eIndex][2])
        local color1 = _G.CS.UnityEngine.GradientColorKey()
        local color2 = _G.CS.UnityEngine.GradientColorKey()
        color1.color = c1
        color1.time = 1
        color2.color = c2
        color2.time = 0

        local alpha1 = _G.CS.UnityEngine.GradientAlphaKey()
        local alpha2 = _G.CS.UnityEngine.GradientAlphaKey()

        alpha1.alpha = 255
        alpha1.time = 1
        alpha2.alpha = 255
        alpha2.time = 0

        gradient:GetGradient():SetKeys({ color1, color2 }, { alpha1, alpha2 })
    end
end

