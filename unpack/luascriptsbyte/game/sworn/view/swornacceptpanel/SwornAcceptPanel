local SwornPanelBase = require "SwornPanelBase"

---@class SwornAcceptPanel : SwornPanelBase	受邀请
local SwornAcceptPanel = _G.BaseClass("SwornAcceptPanel", SwornPanelBase)

local SwornModel = require "SwornModel"
local SwornNet = require "SwornNet"

function SwornAcceptPanel:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SwornAcceptPanel:OnCreate()
    self:UpdatePanel()
    SwornModel:GetInstance().NewAppcetList = {}
    _G.PlayerPrefsManager.SetInt("SwornAccept", 0)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SwornAcceptPage.id)
end

---已取消申请人清理并刷新界面
function SwornAcceptPanel:CancelAndUpdate(uid)
    if #self.RequestInfoList > 0 then
        for i = 1, #self.RequestInfoList do
            if self.RequestInfoList[i].role.uid == uid then
                table.remove(self.RequestInfoList, i)
                break
            end
        end
        self.ListCount = #self.RequestInfoList
        self:UpdateList(self.RequestInfoList)
        if self.ListCount <= 0 then
            self.go_table.scrollloopvectical_List:UpdateCount(self.ListCount)
        end
    end
end

-- region更新好友界面
---@param back function 更新列表后回调
function SwornAcceptPanel:UpdatePanel()
    SwornNet:GetInstance():RequestInfo(
        function(list)
            self.ListCount = list.request_info and _G.table.count(list.request_info) or 0
            self.RequestInfoList = {}
            if self.ListCount > 0 then
                self.RequestInfoList = list.request_info
            end
            self:UpdateList(list.request_info)
        end
    )
end

----更新好友界面
function SwornAcceptPanel:UpdateList(list)
    self.DataList = list

    if self.ListCount <= 0 then
        --_G.PlayerPrefsManager.SetInt("SwornAccept", 0)
        --require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SwornAcceptPage.id)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_NoInfo, true)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_NoInfo, false)
        if nil == self.FriendSlc then
            self.go_table.scrollloopvectical_List:InitItemData(self.ListCount, _G.handler(self, self.RefreshList))
            self.FriendSlc = true
        else
            self.go_table.scrollloopvectical_List:UpdateCount(self.ListCount)
        end
    end
end

---更新单个好友
function SwornAcceptPanel:RefreshList(index, listView2)
    if index < 0 then
        return
    end
    local list
    list = self.DataList
    local item = listView2
    local x = index + 1
    item:SetName(x)
    local tb = _G.GetAutoGoTable(item, _G.handlerbind(self, self.OnListClick, x))
    local data = list[x]

    local role = data.role
    tb.aortext_Name.text = role.name
    local power = role.power
    local strPow = _G.GameUtil.NumberToUnitStrFight(power)
    tb.aortext_FightValue.text = strPow
    ---@type Params_PlayerHeadItem
    local Params_PlayerHeadItem = {}
    Params_PlayerHeadItem.frame = role.frame
    Params_PlayerHeadItem.lv = role.level
    Params_PlayerHeadItem.style = role.style
    Params_PlayerHeadItem.sid = _G.ConfigManager.player_portrait_cfg[role.style].ID
    Params_PlayerHeadItem.title = role.title
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, Params_PlayerHeadItem, 1, true, true, true)
    return item
end

function SwornAcceptPanel:OnListClick(_, _, x)
    local msg = {}
    msg.role_uid = self.DataList[x].role.uid
    SwornNet:GetInstance():Agree(
        msg,
        function(data)
            if data.ack == 1 then
                SwornModel:GetInstance():UpdateInfo(
                    function()
                        SwornModel:GetInstance():CreateRefreshRedPoint()
                        _G.Events:GetInstance():Broadcast(_G.SwornEvents.DoSworn)

                        _G.PlayerPrefsManager.SetInt("SwornTaskFirst", 1)
                        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SwornTask.id)
                    end
                )
            elseif data.ack == 940116 then
                self:CancelAndUpdate(msg.role_uid)
            end
        end
    )
end

