local SwornPanelBase = require "SwornPanelBase"
---@class SwornAppliedPanel : SwornPanelBase	已申请
local SwornAppliedPanel = _G.BaseClass("SwornAppliedPanel", SwornPanelBase)

local SwornNet = require "SwornNet"

function SwornAppliedPanel:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SwornAppliedPanel:OnCreate()
    self:UpdatePanel()
end

---取消申请并刷新界面
function SwornAppliedPanel:CancelAndUpdate(uid)
    if #self.ApplyInfoList > 0 then
        for i = 1, #self.ApplyInfoList do
            if self.ApplyInfoList[i].role.uid == uid then
                table.remove(self.ApplyInfoList, i)
                break
            end
        end
        self.ListCount = #self.ApplyInfoList
        self:UpdateList(self.ApplyInfoList)
        if self.ListCount <= 0 then
            self.go_table.scrollloopvectical_List:UpdateCount(self.ListCount)
        end
    end
end

---更新申请单列表
function SwornAppliedPanel:UpdatePanel()
    SwornNet:GetInstance():ApplyInfo(
        function(list)
            self.ListCount = list.apply_info and _G.table.count(list.apply_info) or 0
            self.ApplyInfoList = {}
            if self.ListCount > 0 then
                self.ApplyInfoList = list.apply_info
            end
            self:UpdateList(list.apply_info)
        end
    )
end

---更新申请单列表
function SwornAppliedPanel:UpdateList(list)
    self.DataList = list
    if self.ListCount <= 0 then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_NoInfo, true)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_NoInfo, false)
        if nil == self.ApplySlc then
            self.go_table.scrollloopvectical_List:InitItemData(self.ListCount, _G.handler(self, self.RefreshList))
            self.ApplySlc = true
        else
            self.go_table.scrollloopvectical_List:UpdateCount(self.ListCount)
        end
    end
end

---更新单个申请
function SwornAppliedPanel:RefreshList(index, listView2)
    if index < 0 then
        return
    end
    local list = self.DataList
    local item = listView2
    local x = index + 1
    item:SetName(x)
    local tb = _G.GetAutoGoTable(item, _G.handlerbind(self, self.OnListClick, x))
    local data = list[x]

    local role = data.role

    tb.aortext_Name.text = role.name
    local power = role.power
    local strPow = _G.GameUtil.NumberToUnitStrFight(power)
    tb.aortext_FightValue.text = strPow

    ---@type Params_PlayerHeadItem
    local Params_PlayerHeadItem = {}
    Params_PlayerHeadItem.frame = role.frame
    Params_PlayerHeadItem.lv = role.level
    Params_PlayerHeadItem.style = role.style
    Params_PlayerHeadItem.title = role.title
    Params_PlayerHeadItem.sid = _G.ConfigManager.player_portrait_cfg[role.style].ID
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, Params_PlayerHeadItem, 1, true, true, true)

    return item
end

---列表按钮点击
function SwornAppliedPanel:OnListClick(_, _, x)
    _G.PopWindowManager:GetInstance():ShowAllTips(
        940115,
        nil,
        function()
            local msg = {}
            msg.uid = self.DataList[x].role.uid
            SwornNet:GetInstance():CancelApply(
                msg,
                function(data)
                    if data.ack == 1 then
                        self:CancelAndUpdate(msg.uid)
                    end
                end
            )
        end
    )
end

---按钮点击事件在这里派发
function SwornAppliedPanel:OnClickBtn(go, isOn)
    if go == nil then
        return
    end
    local name = go:GetName()
    if name == "@_aorbtn_gotoSworn" then
        _G.Events:GetInstance():Broadcast(_G.SwornEvents.JumpApplyView)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SwornApplyView.Name)
    end
end

return SwornAppliedPanel
