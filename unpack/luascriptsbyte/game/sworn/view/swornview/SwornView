---加载自己和结义对象模型
function SwornView:LoadModels(tb, uid)
    if uid then
        -- 获取角色配置
        local cfg = require "CardCommentManager":GetInstance():CardData(uid, false)
        local scale = cfg.size2

        -- 清空目标节点
        tb:ClearChildren()

        -- 加载模型
        _G.PoolsManager:GetInstance():Spawn(
            _G.AppSetting.IsXzns and _G.UIUtils.GetBattleSpine(cfg) or cfg.ModelPathHi,
            _G.ePoolType.Temporary,
            tb,
            function(trans)
                if trans == nil then
                    if _G.AppSetting.DEBUG then
                        _G.LogError("角色无法加载 path:" .. cfg.ModelPathHi .. "    CardInfoView LoadRoleScene")
                    end
                    return
                end
                if self.go_table == nil then
                    _G.DestroyObject(trans)
                    return
                end
                trans:SetParentE(tb)
                trans:SetLocalPosition(0, 0, 0)
                if _G.AppSetting.IsXzns then
                    tb:SetLocalScaleXYZ(0.9)
                    trans:SetLocalScaleXYZ(1)
                else
                    trans:SetLocalScaleXYZ(scale)
                end
                local rolePoint = trans:GetComponentE(_G.typeof(_G.CS.RolePoint))
                if rolePoint == nil then
                    rolePoint = trans:AddComponentE(_G.typeof(_G.CS.RolePoint))
                end
            end)
    end
end

