function SwornView:AddRest()
    --self:AddResToList("SceneTrans", _G.UIResType.pool, "Scenes/sp_guildStatue/Export/prf_sp_SwornView")
end

function SwornView:SetData()
    if _G.AppSetting.DEBUG then
        _G.Log("结义场景完成>>>")
    end
    -- self.camera = _G.Camera.main
    -- self.camera.depth = 55
    -- local camera = _G.FindObject("3DUICam")
    -- if not _G.IsNil(camera) then
    --     self.camera3D = camera:GetComponentE(_G.typeof(_G.CS.UnityEngine.Camera))
    --     self.camera3D.depth = 55
    -- end
    self.SceneTrans = self.ResList["SceneTrans"]

    if self.DefaultIndex and self.IsSworn then
        self:ShowSwornedView()

        self.go_table.toggle_sworn.isOn = self.CurToggle == 1
        self.go_table.toggle_mibao.isOn = self.CurToggle == 2
        self.go_table.toggle_rank.isOn = self.CurToggle == 3
    else
        if self.IsSworn then
            self:ShowSwornedView()
            self.go_table.toggle_sworn.isOn = true
        else
            _G.DelayFrameDo(_G.handler(self, self.UpdateView))
            self.go_table.toggle_notSwornPanel.isOn = self.NotSwornToggle == 1
            self.go_table.toggle_notSwornRank.isOn = self.NotSwornToggle == 2
        end
    end
end

function SwornView:ShowSwornedView()
    self.go_table.obj_unsworn:SetActiveE(0)
    self.go_table.obj_sworned:SetActiveE(1)
    --self.SceneTrans:FindE("Dynamics/IsSwornPlane"):SetActiveE(1)
    --self.SceneTrans:FindE("Dynamics/NotSwornPlane"):SetActiveE(0)
    self.go_table.aorrawimage_unswornbg:SetActiveE(0)
    self.go_table.obj_effectsworn:SetActiveE(1)
    self.go_table.obj_effectunsworn:SetActiveE(0)
    --toggle
    self.go_table.obj_NotSwornToggle:SetActiveE(0)
    self.go_table.obj_Toggle:SetActiveE(1)
end

function SwornView:ShowUnSwornView()
    self.go_table.obj_unsworn:SetActiveE(1)
    self.go_table.obj_sworned:SetActiveE(0)
    --self.SceneTrans:FindE("Dynamics/IsSwornPlane"):SetActiveE(0)
    --self.SceneTrans:FindE("Dynamics/NotSwornPlane"):SetActiveE(1)
    self.go_table.aorrawimage_unswornbg:SetActiveE(1)
    self.go_table.obj_effectsworn:SetActiveE(0)
    self.go_table.obj_effectunsworn:SetActiveE(1)
    --toggle
    self.go_table.obj_NotSwornToggle:SetActiveE(0)
    self.go_table.obj_Toggle:SetActiveE(1)
end

function SwornView:UpdateView(first)
    if self.IsSworn then
        self:ShowSwornedView()
        if first then
            self.go_table.toggle_sworn.isOn = true
            self:UpdatePanel()
        else
            self:UpdatePanel()
        end
    else
        --self:UpdateNotSwornPanel()
        self:LoadAward()
    end
end

function SwornView:UpdateNotSwornPanel()
    self.go_table.toggle_notSwornPanel.isOn = self.NotSwornToggle == 1
    self.go_table.toggle_notSwornRank.isOn = self.NotSwornToggle == 2
    if self.NotSwornToggle == 1 then
        self:ShowUnSwornView()

        self.go_table.obj_rank:SetActiveE(0)
    elseif self.NotSwornToggle == 2 then
        self:ShowRank()
        ---亲密排行
        self:UpdateRankInfo()
    end
    self:RefreshToggles()
end

function SwornView:UpdatePanel()
    if self.CurToggle == 1 then
        if self.roleTrans then
            self.roleTrans:SetActiveE(1)
            self.roleTransSworn:SetActiveE(1)
            self.Shadow:SetActiveE(1)
            self.ShadowSworn:SetActiveE(1)
            --self.go_table.aorbtn_otherplayer:SetActiveE(1)
        end
        if self.FlowerShadow and not _G.IsNumber(self.FlowerShadow) then
            self.FlowerShadow:SetActiveE(0)
        end
        self.go_table.obj_rank:SetActiveE(0)
        self.go_table.obj_names:SetActiveE(1)
        self.go_table.obj_swornnode:SetActiveE(1)
        self.go_table.obj_mibaonode:SetActiveE(0)
        self.go_table.obj_ranknode:SetActiveE(0)
        self:LoadRoleSelf()
        self:LoadRoleSworn()
        self:UpdateCurInfo()
    elseif self.CurToggle == 2 then
        if self.roleTrans then
            self.roleTrans:SetActiveE(0)
            self.roleTransSworn:SetActiveE(0)
            self.Shadow:SetActiveE(0)
            self.ShadowSworn:SetActiveE(0)
            --self.go_table.aorbtn_otherplayer:SetActiveE(0)
        end
        self.go_table.obj_rank:SetActiveE(0)
        self.go_table.obj_names:SetActiveE(0)
        self.go_table.obj_swornnode:SetActiveE(0)
        self.go_table.obj_mibaonode:SetActiveE(1)
        self.go_table.obj_ranknode:SetActiveE(0)

        if nil == self.FlowerShadow then
            self.FlowerShadow = 1
            --[[            _G.UIUtils.LoadEffectByCfg(
                            _G.ConfigManager.ui_effect_cfg["prf_fakeshadow"],
                            self.SceneTrans,
                            function(shadow)
                                self.FlowerShadow = shadow
                                _G.GameUtil.SetActiveByCondition(shadow, self.CurToggle == 2)
                                shadow:SetPosition(0.21, 0, 0)
                            end
                        )]]
        else
            if self.FlowerShadow and not _G.IsNumber(self.FlowerShadow) then
                self.FlowerShadow:SetActiveE(1)
            end
        end
        self:UpdateWaterInfo()
    else
        if self.roleTrans then
            self.roleTrans:SetActiveE(1)
            self.roleTransSworn:SetActiveE(1)
            self.Shadow:SetActiveE(1)
            self.ShadowSworn:SetActiveE(1)
            --self.go_table.aorbtn_otherplayer:SetActiveE(1)
        end
        if self.FlowerShadow and not _G.IsNumber(self.FlowerShadow) then
            self.FlowerShadow:SetActiveE(0)
        end
        self.go_table.obj_rank:SetActiveE(1)
        self.go_table.obj_names:SetActiveE(1)
        self.go_table.obj_swornnode:SetActiveE(0)
        self.go_table.obj_mibaonode:SetActiveE(0)
        self.go_table.obj_ranknode:SetActiveE(1)
        self:UpdateRankInfo()
    end
    self:RefreshToggles()
end

function SwornView:RefreshToggles()
    for i = 1, #self.toggleGotables do
        local toggle = self.toggleGotables[i]
        if i == self.CurToggle then
            toggle.aorimage_isOn:SetActiveE(1)
        else
            toggle.aorimage_isOn:SetActiveE(0)
        end
    end
    self.toggleGotables[SwornView.toggleTag.CellarMead].gameObject:SetActiveE(self.IsSworn and 1 or 0)
end

function SwornView:LoadAward()
    local ssbc = _G.ConfigManager.store_season_battle_cfg[708001]

    self.countCfgArr = {}
    self.PreAward = {}

    for i = #ssbc.content, #ssbc.content - 5, -1 do
        ---@type store_season_battlecon_cfg
        local cfgItem = _G.ConfigManager.store_season_battlecon_cfg[ssbc.content[i]]
        local sid = cfgItem.rewards_normal[1][1]
        local num = cfgItem.rewards_normal[1][2]

        _G.StorageManager:GetInstance():GetItemBaseView(
            sid,
            num,
            self.go_table.obj_Award,
            function(item)
                table.insert(self.PreAward, item.gameObject)
                item.gameObject:SetLocalScaleXYZ(1)
                _G.GameUtil.SetActiveByCondition(item.gameObject, true)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
        )
    end
end

function SwornView:ClearAward()
    if self.PreAward then
        for i = 1, #self.PreAward do
            _G.DestroyObject(self.PreAward[i])
        end
    end
end

