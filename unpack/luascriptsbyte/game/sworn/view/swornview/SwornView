    self:LoadModels(self.go_table.trans_role1, cardid)

    if self.SceneTrans == nil then
        self.SceneTrans = self.ResList["SceneTrans"]
        self:LoadRoleScene(
            cfg.ModelPathHi,
            function(roleTrans)
                self.current_cardid = cardid
                self.roleTrans = roleTrans
                roleTrans:SetParentE(self.SceneTrans)
                roleTrans:SetLocalScaleXYZ(1)
                roleTrans:SetPosition(-0.84 + 100, -0.15, 0)
