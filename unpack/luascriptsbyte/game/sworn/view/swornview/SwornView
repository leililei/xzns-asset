            self:LoadRoleScene(
                cfg.ModelPathHi,
                function(roleTrans)
                    if cardid ~= self.current_cardid then
                        _G.DestroyObject(roleTrans)
                        return
                    end
                    self.roleTrans = roleTrans
                    roleTrans:SetParentE(self.SceneTrans)
                    roleTrans:SetLocalScaleXYZ(1)
                    roleTrans:SetPosition(-0.84 + 100, -0.15, 0)
                    roleTrans.gameObject.layer = _G.LayerMask.NameToLayer("WorldObject")

                    --[[                    _G.UIUtils.LoadEffectByCfg(
