local SwornModel = require "SwornModel"

local SwornCurPanel = require "SwornCurPanel"
local SwornRankPanel = require "SwornRankPanel"
local SwornWaterPanel = require "SwornWaterPanel"

---@class SwornView : UIBaseView    结义主界面
---@field public go_table SwornView_GoTable GoTable
local SwornView = _G.BaseClass("SwornView", _G.UIBaseView)

---@class SwornView.toggleTag
SwornView.toggleTag = {
    Covenant = 1, --盟约
    CellarMead = 2, --蜜酒窖藏
    IntimacyRanking = 3, --亲密排行
}

function SwornView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.SwornEvents.DoSworn, self.DoSworn, self)
    _G.Events:GetInstance():AddListener(_G.SwornEvents.UnSworn, self.Close, self)
    _G.Events:GetInstance():AddListener(_G.SwornEvents.CloseRank, self.CloseRank, self)
    _G.Events:GetInstance():AddListener(_G.SwornEvents.OtherDoSworn, self.OtherDoSworn, self)
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.SixClockUpdate, self)
end

function SwornView:SixClockUpdate()
    self:UpdateData()
    self:UpdateView()
end

function SwornView:OtherDoSworn()
    self:CloseRank()
    self:ClearAward()
    self:UpdateData()
    self:UpdateView(true)
end

function SwornView:DoSworn()
    self:ClearAward()
    self:UpdateData()
    self:UpdateView(true)
end

function SwornView:UnSworn()
    self:ClearAllRoleModel()
    self:UpdateData()
    self:UpdateView()
end

function SwornView:CloseRank()
    self.go_table.obj_rank:SetActiveE(0)
    self.go_table.obj_unsworn:SetActiveE(1)
    self.go_table.obj_sworned:SetActiveE(0)
end

function SwornView:ShowRank()
    self.go_table.obj_rank:SetActiveE(1)
    self.go_table.obj_unsworn:SetActiveE(0)
end

---界面的入口函数
---@param DefaultIndex number 默认选中页签
---@param CurPanelDefaultIndex number 当前默认选中页签（任务或者鲜花）
function SwornView:OnCreate(DefaultIndex, CurPanelDefaultIndex)
    self:AddRest()
    self.ResLoadCompleteCall = _G.handler(self, self.SetData)
    self.DefaultIndex = DefaultIndex
    self.CurPanelDefaultIndex = CurPanelDefaultIndex
    ---@type SwornView.toggleTag
    self.CurToggle = self.DefaultIndex or 1
    self.NotSwornToggle = 1
    self:UpdateData()
    local res = _G.ConfigManager.ui_cfg.SwornView.resources
    self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, res))
    self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))

    ---@type table<SwornView.toggleTag,SwornView._toggle_notSwornRank_GoTable>
    self.toggleGotables = {
        [SwornView.toggleTag.Covenant] = GetAutoGoTable(self.go_table.toggle_sworn, _G.handler(self, self.OnClickBtn)),
        [SwornView.toggleTag.CellarMead] = GetAutoGoTable(self.go_table.toggle_mibao, _G.handler(self, self.OnClickBtn)),
        [SwornView.toggleTag.IntimacyRanking] = GetAutoGoTable(self.go_table.toggle_rank, _G.handler(self, self.OnClickBtn)),
    }
    --镇魂街ZHJ-34446 Beta_1.0.0公测BuglistZHJ-35356
    --【日常】从日常跳转好友赠送友情点，进入义结金兰后UI异常
    --如果结义了，因为有场景存在
    if self.IsSworn then
        if _G.UIManager:GetInstance():IsActiveWindow(_G.ConfigManager.ui_cfg.ActiveTaskView.Name) then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ActiveTaskView.Name)
        end
        --self.go_table.aorbtn_otherplayer:SetLocalPosition(-357, -27, 0)
        --self.go_table.aorbtn_otherplayer:SetRectTransformSize(269, 554)
        self:UpdatePanel()
    end

end

function SwornView:UpdateData()
    self.SelfInfo = SwornModel:GetInstance():GetSelfInfo()
    self.PublicInfo = SwornModel:GetInstance():GetPubInfo()

    self.IsSworn = self.SelfInfo ~= nil
end

