                                    function(shadow)
                                        self.Shadow = shadow
                                        shadow:SetActiveE(1)
                                        shadow:SetPosition(-0.84 + 100, -0.15, 0)
                                    end
                                )]]

                -- self:InitTitle()
            end
        )
    else
        if cardid ~= self.current_cardid then
