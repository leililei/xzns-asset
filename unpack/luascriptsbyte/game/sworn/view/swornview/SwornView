    else
        if cardid ~= self.current_cardidSworn then
            self.current_cardidSworn = cardid
            self:LoadRoleScene(
                cfg.ModelPathHi,
                function(roleTrans)
                    if cardid ~= self.current_cardidSworn then
                        _G.DestroyObject(roleTrans)
