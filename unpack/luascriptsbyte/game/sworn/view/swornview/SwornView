function SwornView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_Close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_help then
        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SwornPassView.Name, 1)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 130)
        --elseif go == self.go_table.aorbtn_rank then
        --    self:ShowRank()
        --    ---亲密排行
        --    self:UpdateRankInfo()
    elseif go == self.go_table.aorbtn_apply then
        ---申请列表
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SwornAcceptView.Name)
    elseif go == self.go_table.aorbtn_Sworn then
        ---结义
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SwornApplyView.Name)
    elseif go == self.go_table.aorbtn_bd then
        ---宝典
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SwornPassView.Name, 2)
    elseif go == self.go_table.toggle_sworn then
        if isOn then
            self.CurToggle = 1
            self.NotSwornToggle = 1
            if self.IsSworn then
                self:UpdatePanel()
            else
                self:UpdateNotSwornPanel()
            end
        end
    elseif go == self.go_table.toggle_mibao then
        if isOn then
            self.CurToggle = 2
            self:UpdatePanel()
        end
    elseif go == self.go_table.toggle_rank then
        if isOn then
            self.CurToggle = 3
            self.NotSwornToggle = 2
            self:UpdatePanel()
            if self.IsSworn then
                self:UpdatePanel()
            else
                self:UpdateNotSwornPanel()
            end
        end
    elseif go == self.go_table.toggle_notSwornPanel then
        if isOn then
            self.NotSwornToggle = 1
            self:UpdateNotSwornPanel()
        end
    elseif go == self.go_table.toggle_notSwornRank then
        if isOn then
            self.NotSwornToggle = 2
            self:UpdateNotSwornPanel()
        end
        --elseif go == self.go_table.aorbtn_otherplayer then
        --    _G.SystemSettingManager:GetInstance():OpenView(self.SelfInfo.role_info.uid)
    end
end

function SwornView:OnStartClose()
    _G.Events:GetInstance():RemoveListener(_G.SwornEvents.DoSworn, self.DoSworn, self)
    _G.Events:GetInstance():RemoveListener(_G.SwornEvents.UnSworn, self.Close, self)
    _G.Events:GetInstance():RemoveListener(_G.SwornEvents.CloseRank, self.CloseRank, self)
    _G.Events:GetInstance():RemoveListener(_G.SwornEvents.OtherDoSworn, self.OtherDoSworn, self)
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.SixClockUpdate, self)
end

function SwornView:OnDestroy()
    if self.camera ~= nil then
        self.camera.depth = 0
    end
    if self.camera3D then
        self.camera3D.depth = 1
    end
    if self.ResList ~= nil then
        for _, v in pairs(self.ResList) do
            if _G.IsNil(v) == false then
                _G.PoolsManager:GetInstance():Despawn(v, _G.ePoolType.UIItem)
            end
        end
        self.ResList = nil
    end
    self.SceneTrans = nil
    self:ClearAllRoleModel()
end

function SwornView:ClearAllRoleModel()
    if self.roleTrans then
        _G.PoolsManager:GetInstance():Despawn(self.roleTrans, _G.ePoolType.Temporary)
        self.roleTrans = nil
    end
    if self.roleTransSworn then
        _G.PoolsManager:GetInstance():Despawn(self.roleTransSworn, _G.ePoolType.Temporary)
        self.roleTransSworn = nil
    end

    if self.Shadow then
        _G.DestroyObject(self.Shadow)
        self.Shadow = nil
    end

    if self.ShadowSworn then
        _G.DestroyObject(self.ShadowSworn)
        self.ShadowSworn = nil
    end
end

return SwornView
