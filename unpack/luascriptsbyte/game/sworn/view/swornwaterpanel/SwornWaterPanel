local SwornPanelBase = require "SwornPanelBase"
---@class SwornWaterPanel : SwornPanelBase	浇水密宝提升界面
local SwornWaterPanel = _G.BaseClass("SwornWaterPanel", SwornPanelBase)

local SwornManager = require "SwornManager"
local SwornModel = require "SwornModel"
local SwornNet = require "SwornNet"

function SwornWaterPanel:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.SwornEvents.OtherWater, self.OtherWater, self)
    _G.Events:GetInstance():AddListener(_G.SwornEvents.WaterFlowers, self.WaterEnd, self)
end

function SwornWaterPanel:OtherWater()
    self:UpdatePanel()
end

---界面的入口函数
function SwornWaterPanel:OnCreate()
    -- self.Flowers = {
    --     "Images/nSworn/ui_yjjl_penzai1_img",
    --     "Images/nSworn/ui_yjjl_penzai2_img",
    --     "Images/nSworn/ui_yjjl_penzai3_img"
    -- }
    self.FlowersEff = {
        _G.ConfigManager.ui_effect_cfg.flower_spine_1,
        _G.ConfigManager.ui_effect_cfg.flower_spine_2,
        _G.ConfigManager.ui_effect_cfg.flower_spine_3
    }
    self.AddExp = _G.ConfigManager.discrete_cfg[114608][1][1]
    self.SelfInfo = SwornModel:GetInstance():GetSelfInfo()
    self.PublicInfo = SwornModel:GetInstance():GetPubInfo()
    if nil == self.PublicInfo.battle_record then
        self.PublicInfo.battle_record = {}
    end
    self:UpdatePanel()
end

function SwornWaterPanel:UpdateComponent()
    self:UpdatePanel()
end

---@param back function 更新列表后回调
function SwornWaterPanel:UpdatePanel()
    self.DataList = self.PublicInfo.battle_record or {}
    self:UpdateList()
end

function SwornWaterPanel:UpdateList()
    if #self.DataList > 0 then
        if nil == self.Slc then
            self.go_table.scrollloopvectical_water:InitItemData(#self.DataList, _G.handler(self, self.RefreshList))
            self.Slc = true
        else
            self.go_table.scrollloopvectical_water:UpdateCount(#self.DataList)
        end
        self.go_table.obj_NoInfo:SetActiveE(0)
    else
        self.go_table.obj_NoInfo:SetActiveE(1)
    end

    self.lv = self.SelfInfo and self.SelfInfo.battle_info.lv or 0
    self.exp = self.SelfInfo and self.SelfInfo.battle_info.exp or 0
    self.go_table.aortext_lv.text = self.lv

    local ssbc = _G.ConfigManager.store_season_battle_cfg[708001]

    local maxExp
    if self.lv >= #ssbc.content then
        maxExp = _G.ConfigManager.store_season_battlecon_cfg[ssbc.content[self.lv]].conditions[2]
    else
        maxExp = _G.ConfigManager.store_season_battlecon_cfg[ssbc.content[self.lv + 1]].conditions[2]
    end

    local expStr, expslider
    if self.exp == maxExp then
        expStr = string.format("%d/%d", self.exp, maxExp)
        expslider = self.lv > 0 and 1 or 0
    else
        if self.exp > maxExp then
            self.exp = maxExp
        end
        expStr = string.format("%d/%d", self.exp, maxExp)
        expslider = self.exp / maxExp
    end
    self.go_table.aortext_exp.text = expStr
    self.go_table.slider_exp.value = expslider

    local changeLvs = _G.ConfigManager.discrete_cfg[114619][1]

    local fIndex = 1
    if self.lv >= changeLvs[1] then
        fIndex = 2
    end
    if self.lv >= changeLvs[2] then
        fIndex = 3
    end

    self.FIndex = fIndex

    if nil == self.FlowerItem then
        self.FlowerItem = 1
        self.go_table.aorimage_flower.SpriteName = "0_ui_hy_hp" .. self.FIndex
--[[        _G.UIUtils.LoadEffectByCfg(
            self.FlowersEff[self.FIndex],
            self.go_table.obj_flowspine,
            function(item)
                self.FlowerItem = item
            end
        )]]
    end
    self:UpdateWater()
end

function SwornWaterPanel:UpdateWater()
    self.go_table.aortext_water.text = self.SelfInfo.battle_info.coin
end

---更新列表
function SwornWaterPanel:RefreshList(index, listView2)
    if index < 0 then
        return
    end
    local list
    list = self.DataList
    local item = listView2
    local x = index + 1
    item:SetName(x)
    local tb = _G.GetAutoGoTable(item)
    local data = list[x]
    local dt = _G.TimeUtil.GetDateTime(data.time)
    tb.aortext_time.text = dt.year .. "." .. dt.month .. "." .. dt.day
    tb.aortext_desc.text = _G.LangUtil.GetLangPackValue(91307420704, data.role_name, data.add_exp)

    return item
end

---按钮点击事件在这里派发
function SwornWaterPanel:OnClickBtn(go, isOn)
    if go == nil then
        return
    end
    local name = go:GetName()

    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_closeView" then
        self:Close()
    elseif name == "@_aorbtn_mibao" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SwornPassView.Name, 2)
    elseif name == "@_aorbtn_water" then
        if self.SelfInfo.battle_info.coin > 0 then
            local msg = {}
            msg.num = self.SelfInfo.battle_info.coin
            SwornNet:GetInstance():WaterFlowers(msg,function(msg)
                if msg.ack~=1 then
                    return
                end
                local changeExp = self.AddExp * self.SelfInfo.battle_info.coin
                self.SelfInfo.battle_info.exp = self.SelfInfo.battle_info.exp + changeExp
                self.SelfInfo.battle_info.coin = 0

                SwornManager:GetInstance():CheckBattleExp()

                local info = {}
                info.role_name = _G.PlayerModel:GetInstance().role_name
                info.add_exp = changeExp
                info.time = _G.TimeUtil.GetServerUnixTime()
                table.insert(self.PublicInfo.battle_record, 1, info)
                self:WaterEnd(msg)
            end)
        else
            -- _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, 118)
            -- 策划优化为 缺少物品时，直接跳转任务界面
            local view = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.SwornView.Name)
            if view then
                view.View.go_table.toggle_sworn.isOn = true
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SwornTaskView.Name)
            end
        end
    end
end

function SwornWaterPanel:WaterEnd(data)
    if data.ack == 1 then
        self.lv = self.SelfInfo and self.SelfInfo.battle_info.lv or 0
        local changeLvs = _G.ConfigManager.discrete_cfg[114619][1]
        local fIndex = 1
        if self.lv >= changeLvs[1] then
            fIndex = 2
        end
        if self.lv >= changeLvs[2] then
            fIndex = 3
        end

        if self.FIndex ~= fIndex then
            self.FIndex = fIndex
            if self.FlowerItem and not _G.IsNumber(self.FlowerItem) then
                _G.DestroyObject(self.FlowerItem)
                self.FlowerItem = nil
            end
            self.go_table.aorimage_flower.SpriteName = "0_ui_hy_hp" .. self.FIndex
--[[            _G.UIUtils.LoadEffectByCfg(
                self.FlowersEff[self.FIndex],
                self.go_table.obj_flowspine,
                function(item)
                    self.FlowerItem = item
                end
            )]]
        end

        self:UpdatePanel()
        _G.Events:GetInstance():Broadcast(
            _G.ePlayAactionEvent.PlayAaction,
            {_G.ActiveTaskEnum.ConditionEnum.Sworn.WaterOne},
            1
        )
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SwornWater.id)
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SwornPass.id)
    end
end

function SwornWaterPanel:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.SwornEvents.OtherWater, self.OtherWater, self)
    _G.Events:GetInstance():RemoveListener(_G.SwornEvents.WaterFlowers, self.WaterEnd, self)
end

return SwornWaterPanel
