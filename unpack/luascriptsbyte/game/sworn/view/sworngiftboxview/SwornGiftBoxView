---界面的入口函数
function SwornGiftBoxView:OnCreate()
    self.Gi = self.SelfInfo.gift_info or {}

    if #self.Gi > 0 then
        _G.SortList(
            self.Gi,
            function(a)
                return a.last_time
            end
        )
        self.go_table.obj_NoInfo:SetActiveE(0)
        if nil == self.FriendSlc then
            self.go_table.scrollloopvectical_List:InitItemData(#self.Gi, _G.handler(self, self.RefreshList))
            self.FriendSlc = true
        else
            self.go_table.scrollloopvectical_List:UpdateCount(#self.Gi)
        end
    else
        self.go_table.obj_NoInfo:SetActiveE(1)
    end

    if _G.PlayerPrefsManager.GetInt("SwornGiftBox") == 1 then
        local gifts = _G.ConfigManager.discrete_cfg[114607]
        for i = 1, #gifts do
            if gifts[i][1] == self.Gi[1].sid then
                self:ShowFlower(i)
                break
            end
        end
    end

    _G.PlayerPrefsManager.SetInt("SwornGiftBox", 0)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SwornGift.id)
end

