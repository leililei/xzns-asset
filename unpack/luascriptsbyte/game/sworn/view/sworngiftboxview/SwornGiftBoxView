---更新单个好友
function SwornGiftBoxView:RefreshList(index, listView2)
    if index < 0 then
        return
    end
    local list
    list = self.Gi
    local itemview = listView2
    local x = index + 1
    itemview:SetName(x)
    local tb = _G.GetAutoGoTable(itemview, _G.handlerbind(self, self.OnItemClick, x))
    local data = list[x]

    local dt = _G.TimeUtil.GetDateTime(data.last_time)
    local str = dt.year .. "." .. dt.month .. "." .. dt.day
    if AppSetting.IsXzns then
        str=str.."\u{2003}"..dt.hour.."."..dt.minute.. "." .. dt.second
    end
    tb.aortext_Time.text =  str

    tb.aortext_SendGiftRName.text = self.SelfInfo.role_info.name

    if not tb.LoadTans then
        tb.LoadTans = 1
        _G.StorageManager:GetInstance():GetItemBaseView(
            data.sid,
            data.num,
            tb.obj_gift,
            function(item)
                tb.LoadTans = item
                item.gameObject:SetLocalScaleXYZ(0.9)
                _G.GameUtil.SetActiveByCondition(item.gameObject, true)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                tb.aortext_GiftName.text = _G.GetLangPackValue(item.cfg.Name)
            end
        )
    else
        if not _G.IsNumber(tb.LoadTans) then
            local item = tb.LoadTans
            local newdata = _G.StorageManager:GetInstance():GetItemDataClassByCfg({data.sid, data.num})
            item:UpdateData(item.gameObject, newdata)
            item.gameObject:SetLocalScaleXYZ(0.9)
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            tb.aortext_GiftName.text = _G.GetLangPackValue(item.cfg.Name)
        end
    end

    return itemview
end

function SwornGiftBoxView:OnItemClick()
end

---按钮点击事件在这里派发
function SwornGiftBoxView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_closeView or go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_closeflower then
        ---关闭送花界面
        self.go_table.obj_showflower:SetActiveE(0)
        if self.CurFlowerEff then
            _G.UIUtils.RemoveEffect(self.CurFlowerEff, 0)
            self.CurFlowerEff = nil
        end
    end
end

function SwornGiftBoxView:OnStartClose()
    _G.Events:GetInstance():RemoveListener(_G.SwornEvents.UnSworn, self.Close, self)
end

return SwornGiftBoxView
