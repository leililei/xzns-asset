---特效加载
---@private
function SwornPassView:UIEffect()
    local LoadEffectByCfg = _G.UIUtils.LoadEffectByCfg
    local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg

    LoadEffectByCfg(ui_effect_cfg.ef_SwornPassView_bg, self.go_table.obj_eff)
