local BaseAwardNewItem = require("BaseAwardNewItem")

---@class SwornPassView : UIBaseView    战令
---@field public go_table SwornPassView_GoTable GoTable
local SwornPassView = _G.BaseClass("SwornPassView", _G.UIBaseView)

local SwornModel = require "SwornModel"
local SwornNet = require "SwornNet"

function SwornPassView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.SwornEvents.OtherDoSworn, self.Close, self)
    _G.Events:GetInstance():AddListener(_G.SwornEvents.UnSworn, self.Close, self)
end

---界面的入口函数
function SwornPassView:OnCreate(type)
    self.mark = {}
    self.SelfInfo = SwornModel:GetInstance():GetSelfInfo()
    if self.SelfInfo then
        if nil == self.SelfInfo.battle_info.award then
            self.SelfInfo.battle_info.award = {}
        end
    end
    if type == 1 then
        ---显示tips界面
        self.go_table.obj_ContentInfo:SetActiveE(0)
        self.go_table.obj_TipsInfo:SetActiveE(1)
    elseif type == 2 then
        self.go_table.obj_ContentInfo:SetActiveE(1)
        self.go_table.obj_TipsInfo:SetActiveE(0)
        self:InitView()
        self:UpdateView()
    end
end

---倒计时结束
function SwornPassView:TimeOverUp()
    SwornModel:GetInstance():UpdateInfo(
        function()
            self.SelfInfo = SwornModel:GetInstance():GetSelfInfo()
            if self.SelfInfo then
                self.SelfInfo.battle_info.award = {}
                self:UpdateView()
                self.go_table.scrollloopvectical_items:ScrollToIndex(0)
                self.endTime = self.SelfInfo.battle_info.end_time - _G.TimeUtil.GetServerUnixTime()
                self:SetTimeEnd(0)
                if nil == self.TimerEnd then
                    self.TimerEnd = _G.TimerManager:GetInstance():GetTimer(1, self.SetTimeEnd, self, false, false)
                    self.TimerEnd:Start()
                end
            end
        end
    )
end

