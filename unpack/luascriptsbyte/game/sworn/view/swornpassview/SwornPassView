function SwornPassView:UpdateView()
    self:LoadRoleSelf()
    self:LoadRoleSworn()
    ---当前等级 初始0级
    self.lv = self.SelfInfo and self.SelfInfo.battle_info.lv or 0
    self.exp = self.SelfInfo and self.SelfInfo.battle_info.exp or 0
    self.go_table.aortext_lv.text = self.lv

    local ssbc = _G.ConfigManager.store_season_battle_cfg[708001]

    local maxExp
    if self.lv >= #ssbc.content then
        maxExp = _G.ConfigManager.store_season_battlecon_cfg[ssbc.content[self.lv]].conditions[2]
    else
        maxExp = _G.ConfigManager.store_season_battlecon_cfg[ssbc.content[self.lv + 1]].conditions[2]
    end

    local expStr, expslider
    if self.exp == maxExp then
        expStr = "" --"Max"
        expslider = self.lv > 0 and 1 or 0
    else
        if self.exp > maxExp then
            self.exp = maxExp
        end
        expStr = string.format("%d/%d", self.exp, maxExp)
        expslider = self.exp / maxExp
    end
    self.go_table.aortext_exp.text = expStr
    self.go_table.slider_exp.value = expslider

    --长滑动经验条
    local allExpCount = 0
    for i = 1, #self.countCfgArr do
        allExpCount = allExpCount + _G.ConfigManager.store_season_battlecon_cfg[self.countCfgArr[i].id].conditions[2]
    end
    local nowExp = 0
    for i = 1, self.lv do
        nowExp = nowExp + _G.ConfigManager.store_season_battlecon_cfg[self.countCfgArr[i].id].conditions[2]
    end

    nowExp = nowExp + self.exp
    self.go_table.slider_LongExp.value = nowExp / allExpCount
    --经验条背景
    for i = 1, #self.countCfgArr - 1 do
        _G.InstantiateObject(self.go_table.aorimage_littleBg, self.go_table.obj_sliderBg)
    end

    self.showDelay = true
    if self.P_LoopInit == nil then
        self.go_table.scrollloopvectical_items:InitItemData(#self.countCfgArr, _G.handler(self, self.RefreshList))
        self.go_table.scrollloopvectical_items:DetectingSlippage(_G.handler(self, self.OnValueChanged))
        self.P_LoopInit = true

        local toIndex = self.lv - 1
        if toIndex < 0 then
            toIndex = 0
        end
        local len = #self.countCfgArr
        for i = 1, len do
            local data = self.countCfgArr[i]
            local ispass = self.lv >= data.level
            local isGetAward = SwornModel:GetInstance():CheckAwardGet(data.id)
            if ispass and isGetAward == false then
                toIndex = i - 1
                if toIndex < 0 then
                    toIndex = 0
                end
                break
            end
        end

        self.go_table.scrollloopvectical_items:ScrollToIndex(toIndex)
    else
        self.go_table.scrollloopvectical_items:UpdateAllItem()
    end
    self:OnValueChanged()
end

function SwornPassView:SetTimeEnd(fix)
    self.endTime = self.endTime - fix
    if self.endTime <= 0 then
        if self.TimerEnd ~= nil then
            self.TimerEnd:Stop()
            self.TimerEnd = nil
        end
        self:TimeOverUp()
        return
    end
    local _t = _G.TimeUtil.TranslateSecond(self.endTime)
    local day = _t.day
    local timeStr = string.format("%02d:%02d:%02d", _t.hour, _t.min, _t.sec)
    self.go_table.aortext_time.text = _G.GetLangPackValue(90025500011, day, timeStr)
end

function SwornPassView:RefreshList(index, objGame, isPrize)
    if index < 0 then
        return
    end
    index = index + 1
    local data = self.countCfgArr[index]
    local itemGoTable = _G.GetAutoGoTable(objGame)

    itemGoTable.data = data
    itemGoTable.ispass = self.lv >= data.level
    itemGoTable.isPrize = isPrize

    itemGoTable.isGet = SwornModel:GetInstance():CheckAwardGet(data.id)

    ---设置可领取
    local isGet = false

    if itemGoTable.ispass then
        isGet = itemGoTable.isGet == false
    end

    --itemGoTable.obj_good:SetActiveE(0)

    local rewards = data.rewards_normal

    if not itemGoTable.item then
        itemGoTable.item = BaseAwardNewItem.New(itemGoTable.obj_good, nil, 88, itemGoTable.obj_good)
    end
    itemGoTable.item:ShowWithID(rewards[1], nil, _G.handlerbind(self, self.itemCall, itemGoTable, false))

    itemGoTable.obj_good1:SetActiveE(0)
    itemGoTable.obj_gou1:SetActiveE(0)
    --itemGoTable.obj_suo1:SetActiveE(0)

    ---是否可点击领取
    _G.GameUtil.SetActiveByCondition(itemGoTable.aorbtn_get, isGet)
    ---是否未达成领取条件
    _G.GameUtil.SetActiveByCondition(itemGoTable.aorbtn_cantGet, not itemGoTable.ispass)
    itemGoTable.aorbtn_cantGet:SetGray(not itemGoTable.ispass)
    itemGoTable.aorimage_lvBg:SetGray(not itemGoTable.ispass)

    if itemGoTable.addClick == nil then
        itemGoTable.aorbtn_get.onClick:AddListener(_G.handlerbind(self, self.OnClick_GetItem, itemGoTable))
        itemGoTable.addClick = true
    end

    if self.isKeyGet == false and isGet then
        self.isKeyGet = true
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_yjlq, self.isKeyGet)
    end

    --itemGoTable.obj_good:SetActiveE(1)

    ---是否显示 锁 勾
    _G.GameUtil.SetActiveByCondition(itemGoTable.obj_gou, itemGoTable.isGet == true)
    --_G.GameUtil.SetActiveByCondition(itemGoTable.obj_suo, itemGoTable.isGet == false and isGet == false and not isPrize)

    if #rewards > 1 then
        _G.GameUtil.SetActiveByCondition(itemGoTable.obj_gou1, itemGoTable.isGet == true)
        --_G.GameUtil.SetActiveByCondition(
        --    itemGoTable.obj_suo1,
        --    itemGoTable.isGet == false and isGet == false and not isPrize
        --)

        itemGoTable.obj_good1:SetActiveE(1)
        if not itemGoTable.item1 then
            itemGoTable.item1 = BaseAwardNewItem.New(itemGoTable.obj_good1, nil, 88, itemGoTable.obj_good1)
        end
        itemGoTable.item1:ShowWithID(rewards[2], nil, _G.handlerbind(self, self.itemCall, itemGoTable, false))
    end

    itemGoTable.aortext_lv.text = data.level

    local num = index
    local nowExpCount = 0
    for i = 1, num do
        nowExpCount = nowExpCount + _G.ConfigManager.store_season_battlecon_cfg[self.countCfgArr[i].id].conditions[2]
    end
    itemGoTable.aortext_count.text = nowExpCount

    if self.showDelay then
        _G.DelayDo(
            self:GetDelayTime(index),
            function()
                objGame:SetActiveE(1)
            end
        )
    end
    if index > 8 then
        self.showDelay = false
    end
    return objGame
end

---@private
function SwornPassView:OnValueChanged()
    local _, x = self.go_table.obj_Content:GetAnchorPosition()
    local lv = self.mark[1] or 0
    for i = 1, #self.mark - 1 do
        if x > self.mark[i] * 138 - 460 then
            lv = self.mark[i + 1]
        end
    end
    if lv > 0 then
        if self.OvcLevel ~= lv then
            self:RefreshList(lv - 1, self.go_table.obj_nextItem, true)
            self.OvcLevel = lv
        end
    else
        self.go_table.obj_nextItem:SetActiveE(0)
    end
end

---获取item延迟展示时间
---@private
---@param index number item索引
function SwornPassView:GetDelayTime(index)
    ---动态加载组件0.133秒出现一个每个延后0.033秒第七个需要间隔0.066秒
    return 0.1 + index * 0.033 + (index > 6 and 1 or 0) * 0.033
end

---@param itemLua BaseAwardNewItem 奖励脚本
function SwornPassView:itemCall(itemLua, itemGoTable)
    ---@type ItemViewBase
    local lua = itemLua.item
    if itemLua.type ~= _G.StorageType.Card then
        lua:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
    end

    local isShowEffect = false
    if itemGoTable.isPrize then
        isShowEffect = true
    elseif itemGoTable.ispass then
        if itemGoTable.isGet == false then
            isShowEffect = true
        end
    end
    if itemLua.type ~= _G.StorageType.Card then
        itemLua:ShowEffect(false)
        if isShowEffect then
            local effect, _ = _G.StorageManager:GetInstance():GetCommonLightEffect(itemLua.data.sid)
            if effect then
                lua:ShowEffect()
            end
        else
            lua:ShowOrHideEffect(false)
        end
    else
        itemLua:ShowEffect(isShowEffect)
    end
end

---@return  number,number,number  等级, 当前经验, 最大经验
function SwornPassView:GetLvExp(sumexp)
    local lv = 0
    local max = 0
    local exp = 0
    local cfginfo
    for i = 1, #self.countCfgArr do
        cfginfo = self.countCfgArr[i]
        local subexp = cfginfo.conditions[1]
        if subexp == nil then
            if _G.AppSetting.DEBUG then
                _G.LogError("未配置经验 limited_battlecon_cfg." .. cfginfo.id)
            end
            subexp = 0
            sumexp = 0
        end
        if sumexp >= subexp then
            sumexp = sumexp - subexp
            lv = cfginfo.level
        else
            exp = sumexp
            max = subexp
            break
        end
    end

    return lv, exp, max
end

---处理自已角色
function SwornPassView:LoadRoleSelf()
    local cardid = _G.PlayerModel:GetInstance():GetRoleSid()
    self.go_table.aortext_myname.text = _G.PlayerModel:GetInstance().role_name

    UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.SwornPassViewRole, self.go_table)
    -- 加载模型
    self:LoadModels(self.go_table.trans_role1, cardid)
end

---处理结义角色
function SwornPassView:LoadRoleSworn()
    if self.SelfInfo then
        local cardid = self.SelfInfo.role_info.city_style_id or 112020000
        self.go_table.aortext_hename.text = self.SelfInfo.role_info.name

        -- 加载模型
        self:LoadModels(self.go_table.trans_role2, cardid)
    end
end

---加载自己和结义对象模型
function SwornPassView:LoadModels(tb, uid)
    if uid then
        -- 获取角色配置
        local cfg = require "CardCommentManager":GetInstance():CardData(uid, false)
        local scale = cfg.size2

        -- 清空目标节点
        tb:ClearChildren()

        local path = UIUtils.GetBattleSpine(cfg,UseBattleSpine.SwornPassView)
        -- 加载模型
        _G.PoolsManager:GetInstance():Spawn(
                path,
                _G.ePoolType.Temporary,
                tb,
                function(trans)
                    if trans == nil then
                        if _G.AppSetting.DEBUG then
                            _G.LogError("角色无法加载 path:" .. cfg.ModelPathHi .. "    CardInfoView LoadRoleScene")
                        end
                        return
                    end
                    if self.go_table == nil then
                        _G.DestroyObject(trans)
                        return
                    end
                    trans:SetParentE(tb)
                    trans:SetLocalPosition(0, 0, 0)
                    trans:SetLocalScaleXYZ(scale)
                    local rolePoint = trans:GetComponentE(_G.typeof(_G.CS.RolePoint))
                    if rolePoint == nil then
                        rolePoint = trans:AddComponentE(_G.typeof(_G.CS.RolePoint))
                    end
                end)
    end
end

---获取一键战令列表
function SwornPassView:GetOneKeyList()
    local oneKeyList = {}
    local len = #self.countCfgArr
    for i = 1, len do
        local data = self.countCfgArr[i]
        local ispass = self.lv >= data.level

        local isGetAward = SwornModel:GetInstance():CheckAwardGet(data.id)

        ---设置可领取
        local isGet = false

        if ispass then
            isGet = isGetAward == false
        end

        if isGet then
            table.insert(oneKeyList, data.id)
        end
    end
    return oneKeyList
end

function SwornPassView:CloseView()
    self:Close()
end

function SwornPassView:OnClickHelp()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 132)
end

function SwornPassView:OnClick_GetItem()
    local list = self:GetOneKeyList()
    if #list > 0 then
        local msg = {}
        msg.sid_list = list
        SwornNet:GetInstance():Award(msg, _G.handlerbind(self, self.GetAward, msg.sid_list))
    end
end

function SwornPassView:GetAward(data, list)
    --奖励
    _G.StorageManager:GetInstance():ReceiveAwardData(data)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)

    if self.SelfInfo then
        for i = 1, #list do
            table.insert(self.SelfInfo.battle_info.award, list[i])
        end
    end

    self:UpdateView()
    if self.OvcLevel and self.OvcLevel > 0 then
        self:RefreshList(self.OvcLevel - 1, self.go_table.obj_nextItem, true)
    end

    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SwornPass.id)
end

---按钮点击事件在这里派发
function SwornPassView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:CloseView()
    elseif name == "@_aorbtn_closeView" then
        self:CloseView()
    elseif name == "@_aorbtn_help" then
        self:OnClickHelp()
    elseif name == "aorbtn_getAll" then
        self:OnClick_GetItem()
    elseif name == "@_aorbtn_GotoSworn" then
        self:CloseView()
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SwornApplyView.Name)
    end
end

function SwornPassView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.SwornEvents.OtherDoSworn, self.Close, self)
    _G.Events:GetInstance():RemoveListener(_G.SwornEvents.UnSworn, self.Close, self)
    if self.TimerEnd ~= nil then
        self.TimerEnd:Stop()
        self.TimerEnd = nil
    end
end

return SwornPassView
