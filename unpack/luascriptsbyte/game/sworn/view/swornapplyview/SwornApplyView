---@class SwornApplyView : UIBaseView	申请功能
---@field public go_table SwornApplyView_GoTable GoTable
local SwornApplyView = _G.BaseClass("SwornApplyView", _G.UIBaseView)

local SwornMeetPanel = require "SwornMeetPanel"
local SwornFriendPanel = require "SwornFriendPanel"

function SwornApplyView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.SwornEvents.OtherDoSworn, self.Close, self)
end

---界面的入口函数
function SwornApplyView:OnCreate()
    self.CurToggle = 1
    self:UpdatePanel()
    require "SwornModel":GetInstance().TipSworn = false
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SwornNot.id)

    --local res = _G.ConfigManager.ui_cfg.SwornApplyView.resources
    --self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, res))
end

function SwornApplyView:UpdatePanel()
    if self.CurToggle == 1 then
        ---推荐非好友用户
        self.go_table.obj_MeetPanel:SetActiveE(1)
        self.go_table.obj_FriendPanel:SetActiveE(0)
        if nil == self.MeetPanel then
            self.MeetPanel = self:AddComponent(self.go_table.obj_MeetPanel, SwornMeetPanel.New())
        else
            self.MeetPanel:UpdateComponent()
        end
    else
        ---好友
        self.go_table.obj_MeetPanel:SetActiveE(0)
        self.go_table.obj_FriendPanel:SetActiveE(1)
        if nil == self.FriendPanel then
            self.FriendPanel = self:AddComponent(self.go_table.obj_FriendPanel, SwornFriendPanel.New())
        else
            self.FriendPanel:UpdateComponent()
        end
    end
end

---按钮点击事件在这里派发
function SwornApplyView:OnClickBtn(go, isOn)
    if go == nil then
        return
    end
    local name = go:GetName()

    if go == self.go_table.aorbtn_help then
        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SwornPassView.Name, 1)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 131)
    elseif name == "@_aorbtn_close" or name == "@_aorbtn_closeView" then
        if self.timer ~= nil then
            self.timer:Stop()
            self.timer = nil
        end
        self:Close()
    elseif name == "$_toggle_friend" then
        if isOn then
            self.CurToggle = 2
            self:UpdatePanel()
        end
    elseif name == "$_toggle_meet" then
        if isOn then
            self.CurToggle = 1
            self:UpdatePanel()
        end
    end
end

function SwornApplyView:OnStartClose()
    _G.Events:GetInstance():RemoveListener(_G.SwornEvents.OtherDoSworn, self.Close, self)
end

function SwornApplyView:OnDestroy()
    self.MeetPanel:Dispose()
    self.MeetPanel = nil
end

return SwornApplyView
