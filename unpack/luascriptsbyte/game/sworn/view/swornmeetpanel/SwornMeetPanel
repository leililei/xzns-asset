local SwornPanelBase = require "SwornPanelBase"
---@class SwornMeetPanel : SwornPanelBase	推荐非好友用户结义
local SwornMeetPanel = _G.BaseClass("SwornMeetPanel", SwornPanelBase)

local SwornNet = require "SwornNet"

function SwornMeetPanel:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SwornMeetPanel:OnCreate()
    self.Tables = {}
    self:UpdatePanel(1)
end

-- region更新好友界面
---@param back function 更新列表后回调
function SwornMeetPanel:UpdatePanel(type)
    local msg = {}
    msg.type = type
    SwornNet:GetInstance():RecommendFriend(
        msg,
        function(list)
            self.OldTime = list.last_refresh and 10 or 0
            self.ListCount = list.role_info and _G.table.count(list.role_info) or 0
            self:UpdateFriendList(list.role_info)
        end
    )
end

----更新好友界面
function SwornMeetPanel:UpdateFriendList(list)
    self.DataList = list

    if self.ListCount <= 0 then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_NoInfo, true)
        if nil ~= self.FriendSlc then
            self.go_table.scrollloopvectical_List:UpdateCount(self.ListCount)
        end
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_NoInfo, false)
        if nil == self.FriendSlc then
            self.go_table.scrollloopvectical_List:InitItemData(self.ListCount, _G.handler(self, self.RefreshFriendList))
            self.FriendSlc = true
        else
            self.go_table.scrollloopvectical_List:UpdateCount(self.ListCount)
        end
    end
end

---更新单个好友
function SwornMeetPanel:RefreshFriendList(index, listView2)
    if index < 0 then
        return
    end
    local list
    list = self.DataList
    local item = listView2
    local x = index + 1
    item:SetName(x)
    local tb = _G.GetAutoGoTable(item, _G.handlerbind(self, self.OnListClick, x))
    local data = list[x]
    self.Tables[x] = tb

    _G.GameUtil.SetActiveByCondition(tb.aorbtn_Done, data.bool == 0)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_Sworned, data.bool == 1)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_Doned, data.bool == 2)

    local role = data.role
    tb.aortext_Name.text = role.name
    local servername = _G.ServerManager:GetInstance():GetServerNameByServerID(role.server_id)
    if servername then
        tb.aortext_server.text = servername
    else
        tb.aortext_server.text = self:GetInSeverName(role.server_id)
    end
    local power = role.power
    local strPow = _G.GameUtil.NumberToUnitStrFight(power)
    tb.aortext_FightValue.text = strPow
    ---@type Params_PlayerHeadItem
    local Params_PlayerHeadItem = {}
    Params_PlayerHeadItem.frame = role.frame
    Params_PlayerHeadItem.lv = role.level
    Params_PlayerHeadItem.style = role.style
    Params_PlayerHeadItem.sid = _G.ConfigManager.player_portrait_cfg[role.style].ID
    Params_PlayerHeadItem.uid = role.uid
    Params_PlayerHeadItem.title = role.title
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, Params_PlayerHeadItem, 1, true, true, true)

    if role.title and role.title.sid > 0 then
        --tb.obj_PortraitBG:SetLocalPositionToZero()
    else
        --tb.obj_PortraitBG:SetLocalPosition(0, 16, 0)
    end

    return item
end

---获取内网服务器信息
function SwornMeetPanel:GetInSeverName(id)
    local list = {}
    local curServer = _G.ServerManager:GetInstance().CurServer
    for _, v in pairs(_G.ConfigManager.server_list_cfg) do
        if v.ServerID == id then
            _G.table.insert(list, v)
        end
    end
    local count = #list
    if count == 0 or count > 1 then
        return curServer.ServerName
    else
        return list[1].ServerName
    end
end

function SwornMeetPanel:OnListClick(_, _, index)
    self.ChangeIndex = index
    local msg = {}
    msg.uid = self.DataList[index].role.uid
    SwornNet:GetInstance():Apply(msg, _G.handler(self, self.ApplySuc))
end

---处理请求回调
function SwornMeetPanel:ApplySuc(data)
    if data.ack == 1 then
        _G.PopWindowManager:GetInstance():ShowAllTips(940107)
        self.DataList[self.ChangeIndex].bool = 2
        self.Tables[self.ChangeIndex].aorimage_Doned:SetActiveE(1)
        self.Tables[self.ChangeIndex].aorbtn_Done:SetActiveE(0)
        self.Tables[self.ChangeIndex].aorimage_Sworned:SetActiveE(0)
    end
end

function SwornMeetPanel:UpdateTimer(elapsed)
    self.OldTime = self.OldTime - elapsed
    if self.OldTime <= 0 then
        self.timer:Stop()
        self.timer = nil
        self.go_table.aortext_change.text = _G.GetLangPackValue(9002010009)
        return
    end
    self.go_table.aortext_change.text = _G.GetLangPackValue(90000011450, _G.math.ceil(self.OldTime))
end

---按钮点击事件在这里派发
function SwornMeetPanel:OnClickBtn(go, isOn)
    if go == nil then
        return
    end
    local name = go:GetName()

    if name == "@_aorbtn_Change" then
        if not self.timer then
            self:UpdatePanel(2)
            self.OldTime = 10
            self.timer = _G.TimerManager:GetInstance():GetTimer(1,self.UpdateTimer,self)
            self.timer:Start()
            self:UpdateTimer(0)
        else
            if _G.AppSetting.DEBUG then
                _G.Log("刷新列表CD中")
            end
            _G.PopWindowManager:GetInstance():ShowAllTips(940110)
        end
    end
end

function SwornMeetPanel:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return SwornMeetPanel
