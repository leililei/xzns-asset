local base = require "BaseGameNet"

---@class SwornNet : BaseGameNet	通信协议
local SwornNet = _G.BaseClass("SwornNet", base)

---@return SwornNet SwornNet
function SwornNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---获取结义信息
---@param callback function 完成回调
function SwornNet:GetInfo(callback)
    ---/game/friend_battle_port/info
    local item = _G.ConfigManager.net_map.game_friend_battle_port_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

