---@field public itemList SelectServerView._obj_ListItem_GoTable[]
---@field public go_table SelectServerView_GoTable
---@field public RecentItemList SelectServerView._obj_PlayerItem_GoTable[]
---@field public RecentLogin SDKServerShowInfo[]
---@field public TagList SelectServerView._obj_TagItem_GoTable[]
---@class SelectServerView : UIBaseView	服务器选择界面
local SelectServerView = _G.BaseClass("SelectServerView", _G.UIBaseView)
local table = _G.table
local player_portrait_cfg = _G.ConfigManager.player_portrait_cfg

function SelectServerView:Awake()
    self.aorImage_keys = {
        ---流畅
        lc = "ui_icon_liuchang",
        ---爆满
        bm = "ui_icon_baoman",
        ---维护
        wh = "ui_icon_weihu"
    }
    if AppSetting.IsXzns then
        self.aorImage_keys = {
            ---流畅
            lc = "ui_xzfwq_icon_liuchang",
            ---爆满
            bm = "ui_xzfwq_icon_baoman",
            ---维护
            wh = "ui_xzfwq_icon_weihu"
        }
    end
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.curTag = nil
    self.curServerList = nil
    self.go_table.scrollloopvectical_Server:InitItemData(0, _G.handler(self, self.RefreshItem))
end

---界面的入口函数
function SelectServerView:OnCreate(savedServer)
    self.isFirst = false
    self.itemList = {}
    self.RecommendList = {}
    self.RecentItemList = {}
    self.regionCfg = _G.ConfigManager.server_region_cfg
    self.go_table.obj_image:SetActiveE(0)
    if _G.CS.Launcher.Inst.IsSDK then
        self.serverListCfg = _G.ServerManager:GetInstance():GetAllServerList()
        self.RecentLogin = _G.ServerManager:GetInstance():GetNearList()
    else
        self.serverListCfg = _G.ConfigManager.server_list_cfg
    end
    table.sort(
        self.serverListCfg,
        function(a, b)
            if a.IsLogin and b.IsLogin then
                if a.IsNew and b.IsNew then
                    return a.Sid > b.Sid
                elseif (a.IsNew) then
                    return true
                elseif (b.IsNew) then
                    return false
                else
                    return a.Sid > b.Sid
                end
            elseif ((a.IsLogin == false) and (b.IsLogin == false)) then
                if a.IsNew and b.IsNew then
                    return a.Sid > b.Sid
                elseif (a.IsNew) then
                    return true
                elseif (b.IsNew) then
                    return false
                else
                    return a.Sid > b.Sid
                end
            elseif (a.IsLogin) then
                return true
            elseif (b.IsLogin) then
                return false
            end
        end
    )
    self.Recommend = _G.ServerManager:GetInstance():GetRecommendList()
    self.curServer = savedServer

    self.TagList = {}
    self.TagCfg = {}
    local haveRecentLogin = table.isEmptyOrNil(self.RecentLogin)
    if not haveRecentLogin then
        self.curServerList = self.RecentLogin
        self.go_table.scrollloopvectical_Server:UpdateCount(#self.curServerList)
        self.TagCfg[1] = {
            cfg = {id = -1, ServerName = _G.LangUtil.GetLangPackValue(90021100044)},
            severList = self.RecentLogin
        }
    end
    self:InitTag()
    self:SetTag(self.TagCfg[1])
    if haveRecentLogin then
        self.go_table.scrollloopvectical_Server:UpdateCount(#self.curServerList)
    end
    self.go_table.scrollloopvectical_leftBtn:InitItemData(#self.TagCfg, _G.handler(self, self.RefreshTagItem))

    -- 初始化toggle
    self:InitToggle()
end

---设置标签
function SelectServerView:SetTag(tag)
    self.curTag = tag
    self.curServerList = tag and tag.severList or {}
end

---初始化标签
function SelectServerView:InitTag()
    local tb = {}

    ---false全服务器 true内部体验服   编辑器全服务器 否则只有内部体验服
    local isSkip = _G.ServerManager:GetInstance():IsAssignServer()

    for _, v in ipairs(self.serverListCfg) do
        if v.Sid == _G.ServerManager:GetInstance().InsideServerId then
            isSkip = false
        end
        if isSkip == false then
            local index = v.ServerGroup
            if not tb[index] then
                tb[index] = {cfg = self.regionCfg[index], severList = {}}
            end
            tb[index].severList[#tb[index].severList + 1] = v
        end
    end
    table.insertto(self.TagCfg, _G.table.toArray(tb))
end

---底部页签
function SelectServerView:InitToggle()
    self.toggles = {
        new = _G.GetAutoGoTable(
                self.go_table.toggle_new,
                _G.handlerbind(self, self.OnClickToggle, "new", _G.handler(self, self.OnNew))
        ),
        all = _G.GetAutoGoTable(
                self.go_table.toggle_all,
                _G.handlerbind(self, self.OnClickToggle, "all", _G.handler(self, self.OnAll))
        ),
    }
    
    -- 默认选中toggle_new
    _G.DelayDo(
            0.1,
            function()
                self.go_table.toggle_new.isOn = true
            end
    )
end

function SelectServerView:OnClickToggle(go, isOn, key, call)
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if call then
        call(isOn)
    end
end

function SelectServerView:AddRecentLoginTag()
    if not table.isEmptyOrNil(self.RecentLogin) then
        local recentTag = {
            cfg = {
                id = -1,
                ServerName = _G.LangUtil.GetLangPackValue(90021100044) -- 最近登录
            },
            severList = self.RecentLogin
        }
        table.insert(self.TagCfg, 1, recentTag)
    end
end


function SelectServerView:OnNew(isOn)
    if not isOn then
        return
    end

     -- 清空原有数据
    self.TagCfg = {}
    local newTag = {
        cfg = {
            id = -2,
            ServerName = _G.LangUtil.GetLangPackValue(90021100052) -- “最新服务器”
        },
        severList = _G.ServerManager:GetInstance():GetRecommendList()
    }

    table.insert(self.TagCfg, newTag)

    -- 添加最近登录页签到最前面
    self:AddRecentLoginTag()

    self:SetTag(self.TagCfg[1])
    self.go_table.scrollloopvectical_leftBtn:UpdateCount(#self.TagCfg)
    self.go_table.scrollloopvectical_Server:UpdateCount(#self.curServerList)
end

function SelectServerView:OnAll(isOn)
    if not isOn then
        return
    end

    self.TagCfg = {}

    -- 添加最近登录页签到最前面
    self:AddRecentLoginTag()

    self:InitTag()

    self:SetTag(self.TagCfg[1])
    self.go_table.scrollloopvectical_leftBtn:UpdateCount(#self.TagCfg)
    self.go_table.scrollloopvectical_Server:UpdateCount(#self.curServerList)
end


---刷新服务器信息
---@param trans Transform
---@param index number obj索引从零开始
function SelectServerView:RefreshItem(index, trans)
    local tblIndex = index + 1
    trans:SetName(tblIndex)
    local cfg = self.curServerList[tblIndex]
    local instanceID = trans:GetInstanceIDE()
    if cfg then
        local tb = self.RecentItemList[instanceID]
        if not tb then
            tb = _G.GetAutoGoTable(
                trans,
                function(btn, isOn)
                    self:OnClickItemBtn(btn, isOn)
                end
            )
            self.RecentItemList[instanceID] = tb
        end
        local stateSpName
        if not cfg.IsOpen then
            stateSpName = self.aorImage_keys.wh
        elseif cfg.IsHot then
            stateSpName = self.aorImage_keys.bm
        else
            stateSpName = self.aorImage_keys.lc
        end
        _G.GameUtil.SetActiveByCondition(tb.aorimage_new, cfg.IsNew)
        tb.aorimage_icon.SpriteName = stateSpName
        tb.aortext_serverName.text = cfg.ServerName or ""
        tb.aortext_name.text = cfg.UserName or ""
        _G.GameUtil.SetActiveByCondition(tb.obj_headParent, cfg.UserStyle)
        if cfg.UserStyle then
            tb.aorimage_head.SpriteName = player_portrait_cfg[cfg.UserStyle].portrait1
            tb.aortext_level.text = "Lv." .. cfg.UserLevel
        end
    end
end

---刷新最近登录信息
---@param trans Transform
---@param index number obj索引从零开始
function SelectServerView:RefreshRecommandItem(index, trans)
    local tblIndex = index + 1
    trans:SetName(tblIndex)
    local cfg = self.Recommend[tblIndex]
    local instanceID = trans:GetInstanceIDE()
    if cfg then
        if not self.RecommendList[instanceID] then
            local go_table =
                _G.GetAutoGoTable(
                trans,
                function(btn, isOn)
                    self:OnClickItemBtn(btn, isOn)
                end
            )
            --go_table.toggle_Select.isOn = false
            self.RecommendList[instanceID] = go_table
        end
        local stateSpName = self.aorImage_keys.wh
        if not cfg.IsOpen then
        elseif cfg.IsHot then
            stateSpName = self.aorImage_keys.bm
        else
            stateSpName = self.aorImage_keys.lc
        end
        _G.GameUtil.SetActiveByCondition(self.RecommendList[instanceID].aorimage_new, cfg.IsNew)
        self.RecommendList[instanceID].aorimage_icon.SpriteName = stateSpName
        -- self.RecommendList[instanceID].aortext_ServerName.text = cfg.ServerName
        _G.GameUtil.SetActiveByCondition(
            self.RecommendList[instanceID].aortext_lv,
            cfg.UserLevel and tonumber(cfg.UserLevel) > 0
        )
        if cfg.UserLevel and tonumber(cfg.UserLevel) > 0 then
            self.RecommendList[instanceID].aortext_lv.text =
                _G.LangUtil.GetLangPackValue(90020300005) .. _G.LangUtil.GetLangPackValue(90020600039, cfg.UserLevel)
        end
        _G.GameUtil.SetActiveByCondition(self.RecommendList[instanceID].aortext_Name, cfg.UserName)
        if cfg.UserName then
            self.RecommendList[instanceID].aortext_Name.text = cfg.UserName
        end
    end
end
---刷新
function SelectServerView:RefreshTagItem(index, obj)
    local tblIndex = index + 1
    local cfg = self.TagCfg[tblIndex]
    if cfg then
        local instanceID = obj:GetInstanceIDE()
        if not self.TagList[instanceID] then
            local go_table =
                _G.GetAutoGoTable(
                obj,
                function(btn, isOn)
                    self:OnClickTag(btn, isOn)
                end
            )
            self.TagList[instanceID] = go_table
        end
        local tb = self.TagList[instanceID]
        tb.cfg = cfg
        tb.aortext_togDescOff.text = cfg.cfg.ServerName
        tb.aortext_togDescOn.text = cfg.cfg.ServerName
        _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, self.curTag.cfg.id == cfg.cfg.id)
        if tblIndex == 1 and not self.isFirst then
            tb.toggle_TagSelect.isOn = true
        end
    end
end
---点击标签回调
function SelectServerView:OnClickTag(go, isOn)
    local instanceID = go:GetParent():GetInstanceIDE()
    local tb = self.TagList[instanceID]
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, isOn)

    if isOn then
        self:SetTag(tb.cfg)
        self.go_table.scrollloopvectical_Server:UpdateCount(#self.curServerList)
    end
end

---设置选中的服务器
function SelectServerView:SetSelectServer()
    if self.curServer then
        local id = self.curServer.id
        if self.itemList[id] then
            self.itemList[id].toggle_Select.isOn = true
        end
    end
end

---toggle点击事件在这里派发
---@param _ UnityEngine.GameObject
---@param isOn boolean
---@param cfg table
---@param index number
function SelectServerView:OnClickItemBtn(_, isOn)
    if isOn then
        local index = tonumber(_:GetParent():GetName())
        local cfg = self.curServerList[index]
        ---本地缓存防止重复存档
        if self.curServer ~= cfg then
            self.curServer = cfg
            self:SetSelectServer()

            local loginView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.LoginView.Name)
            if loginView then
                loginView:SelectServer(cfg)
            end

        -- if self.itemList[index] then
        --     local state = self.itemList[index]
        --     if state ~= isOn then
        --         _G.GameUtil.SetActiveByCondition(self.itemList[index].aorimage_isOn, isOn)
        --         _G.GameUtil.SetActiveByCondition(self.itemList[index].aorimage_isOff, not isOn)
        --     end
        -- end
        end

        if _G.AppSetting.DEBUG then
            _G.Log("SelectServerView:OnClickItemBtn:>>>>>>>index:" .. index)
        end
        self:Close()
    end
end

---按钮点击事件在这里派发
function SelectServerView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

return SelectServerView
