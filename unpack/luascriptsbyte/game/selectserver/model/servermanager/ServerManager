--region -------------本地持久化-------------

---获取上次登陆的服务器，没有就给推荐，再没有就给最后一个服务器
---@return SDKServerShowInfo 服务器信息，登录账号
function ServerManager:GetLastServer()
    if _G.CS.Launcher.Inst.IsSDK and not _G.AppSetting.IsTuoGuan then
        --这里肯定有一个推荐服务器，这个规定好的必须有
        if NearList and #NearList > 0 then
            return NearList[1]
        else
            if RecommendList then
                local reCount = #RecommendList
                if reCount > 0 then
                    if reCount > 1 then
                        local ms = _G.LoginManager:GetInstance():GetRandRecommend(reCount)
                        return RecommendList[ms]
                    else
                        return RecommendList[1]
                    end
                end
            end
        end
        _G.LogError("没有找到推荐服务器，产品说好的必须配一个")
    else
        local tab = _G.PlayerPrefsManager.GetTable(ConstKey, true)
        local account_name = ""
        local server_sid = -1

        --兼容旧的配置格式
        if not table.isEmptyOrNil(tab) and tab[1] ~= nil then
            if tab.AccountName ~= nil then
                account_name = tab.AccountName
                server_sid = tab.ServerSid
            else
                account_name = tab[1].AccountName
                server_sid = tab[1].ServerSid
            end
        end

        local server_info = nil
        if server_sid == -1 and RecommendList and #RecommendList > 0 then
            server_info = RecommendList[1]
        elseif server_sid ~= -1 then
            server_info = self:GetServerBySid(server_sid)
        end

        if not server_info then
            server_info = AllServerList[1]
        end

        if server_info and server_info.AccountName == nil and (string.IsNullOrEmpty(account_name) == false) then
            if _G.AppSetting.DEBUG then
                _G.Log("从本地读取账户名称")
            end
            server_info.AccountName = account_name
        end

        return server_info
    end
end

---本地登陆数据存档
function ServerManager:SaveLastServer()
    if not _G.CS.Launcher.Inst.IsSDK then
        ---@type LocalServerSaveInfo[]
        local newSaveList = {}
        ---@type LocalServerSaveInfo
        local cur = {}
        cur.AccountName = self.CurServer.AccountName
        cur.ServerSid = self.CurServer.Sid

        newSaveList[1] = cur
        ---@type LocalServerSaveInfo[]
        local localSaveList = _G.PlayerPrefsManager.GetTable(ConstKey, true)
        --兼容旧的配置格式
        if localSaveList == nil or localSaveList.AccountName ~= nil then
            localSaveList = nil
        else
            local pos = 0
            for index, value in ipairs(localSaveList) do
                if value.ServerSid == cur.ServerSid then
                    pos = index
                end
            end
            if pos ~= 0 then
                table.remove(localSaveList, pos)
            end
        end
        if localSaveList ~= nil then
            table.AddRange(newSaveList, localSaveList)
        end
        _G.PlayerPrefsManager.SetTable(ConstKey, newSaveList, true)
    end
end

