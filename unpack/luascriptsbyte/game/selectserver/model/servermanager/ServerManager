    return AllServerList
end

function ServerManager:GetNearList()
    return NearList
end

function ServerManager:GetRecommendList()
    return RecommendList
end

---获取 服务器 是否 是新的 服务器
function ServerManager:GetServerIsNew()
    return self.CurServer.IsNew
end

---获取当前服务器sid
function ServerManager:GetServerSid()
    if self.CurServer == nil then
        return
    end
    return self.CurServer.Sid
end

function ServerManager:GetCurServer()
    return self.CurServer
end

---销毁对象时,析构函数
function ServerManager:Dispose()
    InitTagNum = nil
    PageNum = nil
    RecommendList = nil
    NearList = nil
    LoginList = nil
    AllServeridToNameList = nil
end

---检测是否已经拥有角色
function ServerManager:CheckHasPlayer()
    if not LoginList then
        return false
    end
    if _G.CS.Launcher.Inst.IsSDK then
        return #LoginList > 0
    else
        return false
    end
end
