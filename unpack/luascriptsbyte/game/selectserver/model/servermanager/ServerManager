--region -------------功能方法------------

---打开选服界面
---@param info SDKServerShowInfo 上次登录的服务器
function ServerManager:OpenUI(info)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.UIConfig.SelectServerView.Name, self.CurServer, info)
end

---通过Sid查找服务器  这个本地包含所有，sdk只有最近登录的服务器
---@param server_sid number 服务器sid
function ServerManager:GetServerBySid(server_sid)
    local server_info =
        table.find(
            AllServerList,
            function(a)
                return a.Sid == server_sid
            end
        )
    return server_info
end

---通过Sid查找服务器  这个接口返回的服务器不全
---@param server_sid number 服务器sid
function ServerManager:GetServerByServerID(server_sid)
    local server_info = self:GetCurServer()
    if not server_info or server_info.ServerID ~= server_sid then
        server_info =
            table.find(
                AllServerList,
                function(a)
                    return a.ServerID == server_sid
                end
            )
    end
    return server_info
end

---通过Sid查找服务器名字
---@param server_sid number 服务器sid
function ServerManager:GetServerNameByServerID(server_sid)
    if _G.CS.Launcher.Inst.IsSDK then
        local server_info = self:GetCurServer()
        if server_info and server_info.ServerID == server_sid then
            return server_info.ServerName
        else
            local lsName = AllServeridToNameList[_G.tostring(server_sid)]
            if lsName then
                return lsName
            end
        end
    else
        local server_info = self:GetServerByServerID(server_sid)
        if server_info then
            return server_info.ServerName
        end
    end
    --ZHJ-35299【客户端】公平竞技场&街机乱斗-排行榜点击不可查看玩家名片
    --找不到玩家服务器, 兼容显示为"异域强者-xxx"
    return _G.GetLangPackValue(90031700169)
end

