---@class DrawProbabilityView : UIBaseView	中文描述
---@field public go_table DrawProbabilityView_GoTable GoTable
local DrawProbabilityView = _G.BaseClass("DrawProbabilityView", _G.UIBaseView)
--_G.DrawProbabilityView = DrawProbabilityView

local CS = _G.CS
local typeof = _G.typeof

local DrawProbItem = "UI/Draw/DrawProbItem"

function DrawProbabilityView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
end

---界面的入口函数
function DrawProbabilityView:OnCreate(poolID)
    self.poolID = poolID
    self.cfg = _G.ConfigManager.lucky_roller_cfg[poolID]
    local SumProbability = 0
    for _, v in pairs(self.cfg.pool) do
        SumProbability = SumProbability + v[2]
    end

    local probText = {
        [1] = self.go_table.aortext_NProbability,
        [2] = self.go_table.aortext_RProbability,
        [3] = self.go_table.aortext_SRProbability,
        [4] = self.go_table.aortext_SSRProbability
    }
    local probContent = {
        [1] = self.go_table.obj_NContent,
        [2] = self.go_table.obj_RContent,
        [3] = self.go_table.obj_SRContent,
        [4] = self.go_table.obj_SSRContent
    }
    self.Names = {}

    local poolCards, tb
    for i = 1, #self.cfg.pool do
        self.Names[i] = {}
        probText[i].text = self.cfg.pool[i][2] / SumProbability * 100 .. "%"
        poolCards = _G.ConfigManager.lucky_pools_cfg[self.cfg.pool[i][1]].cards
        for n = 1, #poolCards do
            _G.PoolsManager:GetInstance():Spawn(
                DrawProbItem,
                _G.ePoolType.UIItem,
                probContent[i],
                function(tran)
                    if tran then
                        tb = _G.GetAutoGoTable(tran)
                        self.Names[i][n] = tb.aortext_Name
                        if i == #self.cfg.pool and n == #poolCards then
                            for j = 1, #self.cfg.pool do
                                poolCards = _G.ConfigManager.lucky_pools_cfg[self.cfg.pool[j][1]].cards
                                for k = 1, #poolCards do
                                    self.Names[j][k].text =
                                        _G.LangUtil.GetLangPackValue(_G.ConfigManager.card_cfg[poolCards[k][1]].Name)
                                end
                            end
                        end
                    end
                end
            )
        end
    end
end

function DrawProbabilityView:OnUIOpened()
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
end

---按钮点击事件在这里派发
function DrawProbabilityView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_BG" then
        self:Close()
    end
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
end

return DrawProbabilityView
