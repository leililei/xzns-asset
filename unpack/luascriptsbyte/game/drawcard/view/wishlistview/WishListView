---选中数据显示
function WishListView:DangQianXuanZhe()
    ---初始化选中数据
    local wish = require("DrawModel"):GetInstance().wish_card or {}
    local wish_get = require("DrawModel"):GetInstance().wish_get or {}
    self.wish_card = wish
    for value = 1, 3 do
        if wish[value].id ~= nil and wish[value].id ~= 0 then
            local cardData = self.cfg[wish[value].id]
            local insId = self.itemCard[value]:GetInstanceIDE()
            self:showItemBaseHeadInfo(self.itemCard[value], cardData, insId, self.YiShengCheng)
            local tb_1 = self.itemguoCard[value]
            tb_1:SetActiveE(0)
            if wish[value].isGet then
                tb_1:SetActiveE(1)
            end
        end
    end

    self.go_table.scrollloopvectical_kapai:UpdateCount(_G.table.count(self.WuXingChiShuJu[self.WuXingTpye]))
end

---列表数据显示
function WishListView:RefreshRenItem(index, obj)
    if index < 0 then
        return
    end
    local x = index + 1
    local WuXingDa = self.WuXingChiShuJu[self.WuXingTpye]
    local cardData = self.cfg[WuXingDa[x]]
    local panduan
    --判断当前卡牌列表是否选取
    for i = 1, 3 do
        if self.wish_card[i].id ~= 0 and self.wish_card[i].id == cardData.id then
            panduan = true
            break
        else
            panduan = false
        end
    end
    local tb_i = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.DianJiBtn, cardData, panduan))
    ---设置升级按钮 长按事件
    _G.SetEventTrigger(tb_i.aorbtn_DianJi, "onDown", _G.handler(self, self.onDown_Uplv))
    tb_i.aorbtn_DianJi.LongPress = true
    tb_i.aorbtn_DianJi.onLongPress = _G.handlerbind(self, self.onLongPressS_Uplv, cardData.id)
    ---@type UnityEngine.Transform
    -- local var = tb_i.obj_node
    -- local i_1 = var:GetChildCountE()
    -- if i_1 > 0 then
    --     for i = 1, i_1 do
    --         var.GetChildE(i - 1)
    --     end
    -- end
    local wish = require("DrawModel"):GetInstance().wish_card
    tb_i.aorimage_Icon.SpriteName = IconType[cardData.Professional]
    tb_i.image_gou:SetActiveE(1)
    tb_i.aortext_tip.text = _G.ConfigManager.language_package_cfg[cardData.recommend_doc[1]]
    --tb_i.aortext_yichozho:SetActiveE(0)
    for _, value in pairs(wish) do
        if value.id == cardData.id and value.isGet then
            tb_i.image_gou:SetActiveE(0)
            --tb_i.aortext_yichozho:SetActiveE(1)
            panduan = true
        end
    end

    if cardData ~= nil then
        if panduan then
            tb_i.obj_gou:SetActiveE(1)
        else
            tb_i.obj_gou:SetActiveE(0)
        end

        local Instanceid = obj:GetInstanceIDE()
        if self.DnaGe[Instanceid] ~= nil then
            self.DnaGe[Instanceid]:Show(cardData.id, nil, self.cardStar[cardData.id] and self.cardStar[cardData.id] or cardData.Star)
        else
            self:showItemBaseHeadInfo(tb_i.obj_node, cardData, Instanceid, self.DnaGe)
        end
    else
        return tb_i
    end
    return tb_i
end
--初始化
function WishListView:onDown_Uplv()
    if self.isLongPress then
        return
    end
    self.DownClickTime = 0
    self.isLongPress = true
end

--计算时间
function WishListView:onLongPressS_Uplv(Sid)
    if self ~= nil and self.DownClickTime ~= nil then
        self.DownClickTime = self.DownClickTime + 1
        if self.DownClickTime >= 2 and self.isLongPress then
            self.isLongPress = false
            require("CommonTipManager"):GetInstance():OpenTip(self.gameObject, Sid, nil, nil)
        end
    end
end

---筛选心愿表空位
---@param number Elements 当前选中卡牌五行
---@param number CurId 当前选中卡牌id
---@return number 当前下标位置，0不做处理
function WishListView:ScreenOutIndex(Elements, CurId)
    local cfg = _G.ConfigManager.card_cfg
    local wish = require("DrawModel"):GetInstance().wish_card or {}
    self.wish_card = wish
    for i = 1, 3 do
        if self.wish_card[i].isGet and CurId == self.wish_card[i].id then
            _G.PopWindowManager:GetInstance():ShowAllTips(340401)

            if _G.AppSetting.DEBUG then
                _G.Log("该心愿单角色已获取1>>>>>>>>>>>>>>>>>>")
            end
            return 0
        elseif self.wish_card[i].isGet and cfg[self.wish_card[i].id].Elements == Elements then
            _G.PopWindowManager:GetInstance():ShowAllTips(340401)

            if _G.AppSetting.DEBUG then
                _G.Log("该心愿单角色已获取2>>>>>>>>>>>>>>>>>>")
            end
            return 0
        elseif
            self.wish_card[i].id ~= 0 and cfg[self.wish_card[i].id].Elements == Elements and
                CurId ~= self.wish_card[i].id
         then
            _G.PopWindowManager:GetInstance():ShowAllTips(340201)

            if _G.AppSetting.DEBUG then
                _G.Log("已有当前属性的选择(防空位)>>>>>>>>>>>>>>>>>>")
            end
            return 0
        elseif self.wish_card[i].id == CurId then
            return self.wish_card[i].index
        end
    end
    for index, v in ipairs(self.wish_card) do
        if v.id ~= 0 and cfg[v.id].Elements == Elements and v.id ~= CurId then
            _G.PopWindowManager:GetInstance():ShowAllTips(340201)

            if _G.AppSetting.DEBUG then
                _G.Log("已有当前属性的选择>>>>>>>>>>>>>>>>>>")
            end
            return 0
        elseif v.id == CurId then
            return index
        elseif v.id == 0 then
            return index
        end
    end
    _G.PopWindowManager:GetInstance():ShowAllTips(340501)

    if _G.AppSetting.DEBUG then
        _G.Log("当前心愿单位置已满>>>>>>>>>>>>>>>>>>")
    end
    return 0
end

