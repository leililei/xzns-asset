---图标更新
function WishListView:showItemBaseHeadInfo(headTrans, cardData, num, XianShi)
    _G.ItemCardFactory:GetInstance():GetItemCard(
        _G.ItemCardFactory.itemCardType.baseItem,
        headTrans,
        function(item)
            item:Show(cardData.id, nil, self.cardStar[cardData.id] and self.cardStar[cardData.id] or cardData.Star)
            XianShi[num] = item
        end
    )
end
function WishListView:toggleKaiGuan(num)
    local mSplit = "toggle_1 (" .. self.WuXingTpye
    local mSplit1 = "toggle_1 (" .. num
    self.go_table[mSplit].isOn = false
    self.go_table[mSplit1].isOn = true
end

---按钮点击事件在这里派发
function WishListView:OnClickBtn(go, IsOn)
    local name = go:GetName()
    if name == "@_aorbtn_help" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 33)
    elseif name == "@_aorbtn_DianJi_1" then
        local cardData = _G.ConfigManager.card_cfg[self.wish_card[1].id]
        if cardData ~= nil then
            self:DianJiBtn(nil, nil, cardData, true)
            self.wish_card = require "DrawModel":GetInstance().wish_card
        end
    elseif name == "@_aorbtn_DianJi_2" then
        local cardData = _G.ConfigManager.card_cfg[self.wish_card[2].id]
        if cardData ~= nil then
            self:DianJiBtn(nil, nil, cardData, true)
            self.wish_card = require "DrawModel":GetInstance().wish_card
        end
    elseif name == "@_aorbtn_DianJi_3" then
        local cardData = _G.ConfigManager.card_cfg[self.wish_card[3].id]
        if cardData ~= nil then
            self:DianJiBtn(nil, nil, cardData, true)
            self.wish_card = require "DrawModel":GetInstance().wish_card
        end
    elseif name == "@_aorbtn_close" then
        self.wish_card = require "DrawModel":GetInstance().wish_card
        if self.call then
            self.call(self.wish_card)
        end
        self:Close()
    elseif name == "@_aorbtn_closeX" then
        self.wish_card = require "DrawModel":GetInstance().wish_card
        if self.call then
            self.call(self.wish_card)
        end
        self:Close()
    end
end
return WishListView
