---心愿单剩余重置时间统计
function WishListView:RemainTime()
    --星期一早上六点刷新
    local curTime = _G.TimeUtil.GetServerUnixTime() - (_G.TimeUtil.GAME_DAY_TIME)
    local curTimeTb = _G.TimeUtil.GetDateTime(curTime)
    local remainTime
    --周日早上六点-周一早上6点为小于一天
    if curTimeTb.week == 0 then
        self.go_table.aortext_Timedown.text = _G.GetLangPackValue(90000010496)
    else
        remainTime = 7 - curTimeTb.week + 1
        self.go_table.aortext_Timedown.text = _G.GetLangPackValue(90000010495, remainTime)
    end
end

---筛选
function WishListView:OnToggle_sx_Elements(go, isOn)
    if isOn == false then
        return
    end
    local name = go:GetName()
    local mSplit = _G.string.split(name, " (")
    local now = _G.tonumber(mSplit[2]) or 0
    self.sx_Elements.TempIndex = now
    self.nowCardIndex = 1
    self.sx_Elements.Index = self.sx_Elements.TempIndex
    self.sx_Elements.data = sxEnum.Elements[self.sx_Elements.Index]
    self.WuXingTpye = self.sx_Elements.data
    local num = 0
    if self.WuXingChiShuJu[self.WuXingTpye] ~= nil then
        num = _G.table.count(self.WuXingChiShuJu[self.WuXingTpye])
    end
    self.go_table.scrollloopvectical_kapai:UpdateCount(num)
end

---心愿单分类
function WishListView:WuXingFenLei()
    local vars = RoleYueType.Thunder
    for key, value in pairs(self.WuXingChi) do
        if self.WuXingChiShuJu[vars] == nil then
            self.WuXingChiShuJu[vars] = {}
            self.WuXingChiShuJu[vars] = value
        end
        if vars == RoleYueType.Thunder then
            vars = RoleYueType.Wind
        elseif vars == RoleYueType.Wind then
            vars = RoleYueType.Water
        elseif vars == RoleYueType.Water then
            vars = RoleYueType.Fire
        elseif vars == RoleYueType.Fire then
            vars = RoleYueType.Earth
        elseif vars == RoleYueType.Earth then
            vars = 0
        end
    end

    self:ButChuShiHua()
end

