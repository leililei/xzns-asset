---加载招募消耗信息(图标和数量)(降神招募)
function GodDrawView:LoadGodConsumesInfos()
    local material = require("DrawModel"):GetInstance():GetGodCfg().ticket
    local model = require("DrawModel"):GetInstance()

    local midNum = 10
    --右边显示的招募次数
    local rightDrawNumber = 10
    --获取招募券数量
    local ownNum = _G.StorageManager:GetInstance():GetItemCountBySid(material[1])
    local needNum1, needNum10 = material[2], material[2] * rightDrawNumber
    if ownNum > needNum1 and ownNum < needNum10 then
        --道具数量 1 < n < 10 时, 动态显示剩余数量
        midNum = _G.Mathf.Floor(ownNum / needNum1)
        if midNum <= 1 then
            midNum = 10
        end
        needNum10 = material[2] * midNum
    end

    local leftIcon, leftNum, rightIcon, rightNum
    --降神特权折扣
    local _, discount = model:GetGodDiamondConsume(1)
    leftNum = needNum1
    leftIcon = self.item[material[1]].Icon
    rightIcon = _G.StorageManager:GetInstance():GetItemIcon(_G.ResPropID.Diamond)
    rightNum, discount = model:GetGodDiamondConsume(10)
    local ownDiaNum = _G.StorageManager:GetInstance():GetItemCountBySid(_G.ResPropID.Diamond)

    --获取降神招募魂玉次数
    local totalTimes = model:GetGodDiamondTotalTimes()
    local remainTimes = totalTimes - model:GetGodDiamondTimes()
    -- totalTimes = _G.Mathf.Floor(totalTimes / 10)
    -- remainTimes = _G.Mathf.Floor(remainTimes / 10)
    self.go_table.aortext_remainDiamondTimes.text = _G.GetLangPackValue(90022300102, remainTimes .. "/" .. totalTimes)

    local isDiamond = remainTimes > 0 and ownNum <= 1
    self.isDiamond = isDiamond
    self.go_table.aortext_Prop2NumDesc.text =
        _G.GetLangPackValue(90000011229, _G.GameUtil.NumberToWordByLanguage(isDiamond and 10 or midNum))
    self.go_table.obj_hongDian:SetActiveE(ownNum >= 10 and 1 or 0)
    self.go_table.aortext_Prop2Num.text = isDiamond and rightNum or tostring(midNum)
    self.go_table.aortext_Prop2Num.color =
        (isDiamond and rightNum > ownDiaNum) and langugageColor.numRed or langugageColor.num
    if isDiamond and discount and discount < 1 then
        ---使用魂玉时的折扣
        self.go_table.obj_discount:SetActiveE(1)
        local showtxt = ""
        if GameUtil.GetLang() == "zh-CN" then
            showtxt =  _G.GetLangPackValue(90028800006, string.format("%.1f", discount * 10))
        else
            showtxt = _G.GetLangPackValue(90028800006, string.format("%d", 100 - discount * 100))
        end
        self.go_table.aortext_discount.text = showtxt
    else
        self.go_table.obj_discount:SetActiveE(0)
    end
    self.go_table.aortext_Prop1Num.text = leftNum
    self.go_table.aorrawimage_Prop1:LoadImage(leftIcon)
    self.go_table.aorrawimage_Prop2:LoadImage(isDiamond and rightIcon or leftIcon)
end

