---卡牌名称和招募次数变化
function GodDrawView:JiangNameNum(isReset)
    local num = self.cfg and require "DrawModel":GetInstance():GetGodCardInfo(self.cfg.id) or 0
    local cishu = self.num - (num - (_G.math.modf(num / self.num) * self.num))
    self.go_table.aortext_num.text = self.cfg ~= nil and _G.GetLangPackValue(90021000022, cishu) or ""
    self.go_table.trans_card:ClearChildren()
    local name = _G.GetLangPackValue(self.cfg ~= nil and self.cfg.Name or 90021000024)
    local fontSize
    local charCount = _G.string.getStringCharCount(name)
    if charCount == 5 then
        fontSize = 62
    elseif charCount >= 6 then
        fontSize = 52
    else
        fontSize = 72
    end
    self.go_table.aortext_Name.fontSize = fontSize
    self.go_table.aortext_Name.text = name
    --self.go_table.aortext_Name:SetLocalPosition(self.cfg ~= nil and 287 or 17, 7, 0)
    --self.go_table.obj_nameBg:SetLocalPosition(self.cfg ~= nil and 287 or 17, -19, 0)
    if self.cfg ~= nil then
        self.go_table.obj_roleInfo:SetActiveE(1)
        self.isHave = require("IllustrationModel"):GetInstance():HunjiangJieSuo(self.cfg.id)

        local uiModel = _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.ui_model_1)
        self.go_table.obj_cardInfo:SetActiveE(uiModel and 0 or 1)
        self.go_table.obj_cardInfo1:SetActiveE(uiModel and 1 or 0)

        local grade = self.cfg.Order
        if uiModel then
            self.go_table.aortext_cardName1.text = name
            self.go_table.aorimage_cardOrder1.SpriteName = require("CardInfoManager"):GetInstance():GetCardOrderZi(grade)
            if _G.CardOrderBigIconName[grade] then
                self.go_table.aorimage_cardLogo1:SetActiveE(1)
                self.go_table.aorimage_cardLogo1.SpriteName = _G.CardOrderBigIconName[grade]
            else
                self.go_table.aorimage_cardLogo1:SetActiveE(0)
            end
        else
            self.go_table.aortext_cardName.text = name
            self.go_table.aorimage_cardOrder.SpriteName = require("CardInfoManager"):GetInstance():GetCardOrderZi(grade)
            if _G.CardOrderBigIconName[grade] then
                self.go_table.aorimage_cardLogo:SetActiveE(1)
                self.go_table.aorimage_cardLogo.SpriteName = _G.CardOrderBigIconName[grade]
            else
                self.go_table.aorimage_cardLogo:SetActiveE(0)
            end
        end

        self.go_table.trans_card:SetLocalScaleXYZ(self.cfg.size2)
        local pos = self.cfg.pos_portrait
        self.go_table.trans_card:SetLocalPosition(pos[1], pos[2], pos[3])
        _G.PoolsManager:GetInstance():Spawn(
            self.cfg.ModelPathHi,
            _G.ePoolType.Temporary,
            self.go_table.trans_card,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                end
                GameUtil.SetCardUiSpineAnimation(trans, "idle", true)
            end
        )
    else
        self.go_table.obj_roleInfo:SetActiveE(0)
        self.go_table.aortext_cardName.text = ""
        self.go_table.aorimage_cardLogo:SetActiveE(0)
    end
end

