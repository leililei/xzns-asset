---销毁对象时,析构函数
function GodDrawView:OnDestroy()
    if self.co then
        _G.coroutine.stopwaiting(self.co)
    end
    if self.co1 then
        _G.coroutine.stopwaiting(self.co1)
    end
    if self.tweer then
        self.tweer:Kill()
        self.tweer = nil
    end
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:RemoveListener(_G.eItemUpdata.Updata, self.ResUpdata)
end

return GodDrawView
