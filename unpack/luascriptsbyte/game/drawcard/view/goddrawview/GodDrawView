function GodDrawView:DrawCard(type, consumeType)
    if self.isClick then
        return
    end
    -- if _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.DrawResultView.Name) then
    --     _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DrawResultView.Name)
    -- end
    self.isClick = true
    local num = type == _G.DrawType.once and 1 or 10

    local model = require("DrawModel"):GetInstance()
    --获取拥有的招募券数量
    local material = require("DrawModel"):GetInstance():GetGodCfg().ticket
    local ownNum = _G.StorageManager:GetInstance():GetItemCountBySid(material[1])
    local needBase, needNum = material[2], num * material[2]
    if needNum > needBase and ownNum < needNum then
        --道具数量 1 < n < 10 时, 动态显示剩余数量
        num = math.floor(ownNum / needBase)
        if num <= 1 then
            num = 10
        end
        needNum = needBase * num
    end

    ---@type number 消耗模式: 1活动代币 2魂玉
    if consumeType == _G.DrawConsumeType.token then
        --检查招募券数量
        if ownNum < needNum then
            self.isClick = false
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, material[1])
            return
        end
    else
        --检查魂玉数量
        num = 10
        local consumeNum = model:GetGodDiamondConsume(num)
        local ownDiamondNummondNum = _G.StorageManager:GetInstance():GetItemCountBySid(_G.ResPropID.Diamond)
        if ownDiamondNummondNum < consumeNum then
            self.isClick = false
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ResPropID.Diamond)
            return
        end
        --获取魂玉召唤总次数
        local totalTimes = model:GetGodDiamondTotalTimes()
        local remainTimes = totalTimes - model:GetGodDiamondTimes()
        if remainTimes == 0 then
            return
        end
    end

    --检查仓库是否已满
    if self.cfg and _G.StorageManager:GetInstance():CheckIsFullBySid(self.cfg.id, num) then
        _G.PopWindowManager:GetInstance():ShowAllTips(130101)
        self.isClick = false
        return
    end

    if consumeType == 2 then
        local poolCfg = _G.ConfigManager.discrete_cfg[104314]

        _G.PopWindowManager:GetInstance():ShowBtnWindowByToggle(
                629,
                function()
                    require "DrawModel":GetInstance():DrawGodCard(
                            consumeType,
                            num,
                            _G.handler(self, self.DrawCall),
                            function()
                                self.isClick = false
                            end
                    )
                end,
                function()
                    self.isClick = false
                end,
                nil,
                true,
                model:GetGodDiamondConsume(num),
                num,
                _G.GetLangPackValue(_G.ConfigManager.item_cfg[material[1]].Name),
                num
        )
    else
        require "DrawModel":GetInstance():DrawGodCard(
            consumeType,
            num,
            _G.handler(self, self.DrawCall),
            function()
                self.isClick = false
            end
        )
    end
end

