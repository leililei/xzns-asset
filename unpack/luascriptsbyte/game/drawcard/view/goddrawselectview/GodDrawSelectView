---播放动画
function GodDrawSelectView:PlayAni()
    local Tweening = _G.CS.DG.Tweening
    self.tweer = self.go_table.obj_ring2:DOLocalMoveY(34, 1):SetEase(Tweening.Ease.InOutSine):SetLoops(
            -1,
            Tweening.LoopType.Yoyo
    )
end

function GodDrawSelectView:OnClickItem(go, isOn, tb)
    local data = self.curCardData[tb.index]
    if self.selectCardId == data.sid then
        return
    end
    self.selectCardId = data.sid
    local pan = false
    if self.selectCardId then
        local id = _G.tonumber(data.sid)
        pan = _G.StorageManager:GetInstance():GetIDMax(id, id)
    end
    if pan then
        _G.PopWindowManager:GetInstance():ShowAllTips(
                622,
                nil,
                function()
                    self.go_table.scrollloopvectical_CardList:UpdateAllItem()
                    self:UpdateCardShow(data)
                end
        )
    else
        self.go_table.scrollloopvectical_CardList:UpdateAllItem()
        self:UpdateCardShow(data)
    end
end

function GodDrawSelectView:OnToggle(go, isOn)
    local name = go:GetName()
    if not _G.string.contains(name, "toggle") then
        return
    end
    local str = _G.string.replace(name, "$_toggle_", "")
    local element = _G.tonumber(str)
    if not self.CardData[element] then
        local tb = {}
        for _, v in ipairs(self.CardData[0]) do
            if require "CardInfoManager":GetInstance():CheckMultiMatchCOP(v.cfg.Elements_new, element) then
                _G.table.insert(tb, v)
            end
        end
        self.CardData[element] = tb
    end
    self.curElement = element
    self.curCardData = self.CardData[element]
    self.go_table.scrollloopvectical_CardList:UpdateCount(#self.curCardData)
end

---按钮点击事件在这里派发
function GodDrawSelectView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_enter then
        if self.cardId == self.selectCardId then
            self:Close()
        else
            require "DrawModel":GetInstance():SetGodCard(
                    self.selectCardId,
                    function()
                        if self.callback then
                            self.callback()
                        end
                        self:Close()
                    end
            )
        end
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.aorbtn_showInfo then
        self:OnLongPress(self.selectCardId)
    else
        self:OnToggle(go, isOn)
    end
end

function GodDrawSelectView:OnStartClose()
    if self.tweer then
        self.tweer:Kill()
        self.tweer = nil
    end
end

return GodDrawSelectView
