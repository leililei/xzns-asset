end

function DrawView:PlayAnimation()
    if self.sg and _G.AppSetting.HeXieLevel == 0 then
        local idle = "idle"
        local show = "show"
        Log(self.nowDotIndex, "self.nowDotIndex")
        if self.nowDotIndex == 3 then
            show = "show2"
        end
        self.sg.AnimationState:SetAnimation(0, show, false)
        self.sg.AnimationState:AddAnimation(0, idle, true, 0)
    end
end

