--更换种族按钮图标
function DrawView:ChangePropIma(id)
    --id = id or require("DrawModel"):GetInstance().PropPoolToday
    if not self.propBtn then
        self.propBtn = {
            [_G.CardPoolID.Thunder] = _G.GetAutoGoTable(
                    self.go_table.obj_raceItem1,
                    _G.handlerbind(self, self.OnClickRaceItem, _G.CardPoolID.Thunder)
            ),
            [_G.CardPoolID.Wind] = _G.GetAutoGoTable(
                    self.go_table.obj_raceItem2,
                    _G.handlerbind(self, self.OnClickRaceItem, _G.CardPoolID.Wind)
            ),
            [_G.CardPoolID.Water] = _G.GetAutoGoTable(
                    self.go_table.obj_raceItem3,
                    _G.handlerbind(self, self.OnClickRaceItem, _G.CardPoolID.Water)
            ),
            [_G.CardPoolID.Fire] = _G.GetAutoGoTable(
                    self.go_table.obj_raceItem4,
                    _G.handlerbind(self, self.OnClickRaceItem, _G.CardPoolID.Fire)
            )
        }
    end
    if id then
        self.go_table.obj_prop:SetActiveE(1)
        self.go_table.aorrawimage_noProp:SetActiveE(0)
        self.go_table.aorimage_Prop.SpriteName = RoleBtnType[id]
        self.go_table.aorrawimage_factor:LoadImage(RoleTextType[id], function(img)
            img:SetNativeSize()
            self.go_table.aorrawimage_banner5:SetNativeSize()
            self.go_table.aorrawimage_banner6:SetNativeSize()
        end)
    else
        self.go_table.obj_prop:SetActiveE(0)
        self.go_table.aorrawimage_noProp:SetActiveE(1)
        self.go_table.aorrawimage_noProp:SetNativeSize()
    end
    self:RefreshItem()
end

function DrawView:RefreshItem()
    for id, v in pairs(self.propBtn) do
        if _G.AppSetting.IsXzns then
            if v.obj_select:GetChildCountE() == 0 then
                _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_select, v.obj_select)
            end
        end
        v.obj_select:SetActiveE(self.CurPool == id and 1 or 0)
    end
end

