---进度信息刷新
function DrawView:JiangLiXianShi(obj, aortext_Award, aortext_leiji, aorimage_AwardSlider)
    ---@type DrawModel
    local model = require("DrawModel"):GetInstance()
    self.NextAward = model.NextAward
    obj:SetParentE(self.go_table.obj_LimitDrawView)
    obj:SetLocalScaleXYZ(1)
    local _, y, _ = obj:GetLocalPosition()
    obj:SetLocalPosition(0, y, 0)

    -- self.go_table.aortext_LimitNum.text =
    --     self.pools[self.CurPool].day_count ..
    --     GetLangPackValue(90025800011) ..
    --         "/" .. self.pools[self.CurPool].cfg.limit_daily .. GetLangPackValue(90025800011)

    local curnum = model.exit_num - model.NextAward.LastTime
    if curnum >= model.NextAward.num then
        aortext_Award.text = string.format("%d/%d", curnum, model.NextAward.num)
    else
        aortext_Award.text = string.format("<color=#e55353>%d</color>/%d", curnum, model.NextAward.num)
    end

    aortext_leiji.text = _G.string.format(GetLangPackValue(90000000978), self.NextAward.num)
    aorimage_AwardSlider.fillAmount = curnum / model.NextAward.num
    --self.go_table.obj_awardActiveEffect:SetActiveE(curnum >= self.NextAward.num and 1 or 0)
end

---特效显示修改
function DrawView:imageXianShi()
    local count =
        require "HellRoadModel":GetInstance():GetNumber(
        {_G.PrivilegeType.DrawCard.Count, self.CurPool or _G.CardPoolID.Thunder}
    )
    local isFree = count > self.pools[self.CurPool or _G.CardPoolID.Thunder].free_times
    self.go_table.aorrawimage_PropLeft:SetActiveE(not isFree and 1 or 0)
    self.go_table.aortext_free:SetActiveE(not isFree and 1 or 0)
    self.go_table.aortext_free2:SetActiveE(isFree and 1 or 0)
    self.go_table.aortext_PropLeftNum:SetActiveE(not isFree and 1 or 0)
end

