function DrawView:InitToggle()
    self.viewList = {}
    self.go_table.toggle_godDraw:SetActiveE(
        _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.GodDraw) and 1 or 0
    )
    self.toggles = {
        normal = _G.GetAutoGoTable(self.go_table.toggle_normal, _G.handler(self, self.OnNormal)),
        godDraw = _G.GetAutoGoTable(self.go_table.toggle_godDraw, _G.handler(self, self.OnGodDraw))
    }
end

function DrawView:OnToggleChange(tb, isOn)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
end

function DrawView:OnNormal(go, isOn)
    self:OnToggleChange(self.toggles.normal, isOn)
    if not isOn then
        return
    end
end

function DrawView:OnGodDraw(go, isOn)
    self:OnToggleChange(self.toggles.godDraw, isOn)
    self.go_table.obj_godDraw:SetActiveE(isOn and 1 or 0)
    if isOn and not self.godDrawInit then
        self.godDrawInit = true
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GodDrawView.Name)
    end
end

function DrawView:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.ResUpdate, self)
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.ResRefresh, self.ResUpdate, self)
    _G.Events:GetInstance():RemoveListener(_G.eDraw.RefreshDrawView, self.UpdateNormalView, self)
    _G.Events:GetInstance():RemoveListener(_G.eLimitePrivilege.LimitePrivilegeChange, self.LoadGodDiamondTimes, self)
    _G.Events:GetInstance():RemoveListener(_G.eLimitePrivilege.LimitePrivilegeChange, self.LoadGodConsumesInfos, self)
    _G.Events:GetInstance():RemoveListener(_G.eLimitePrivilege.LimitePrivilegeChange, self.UpdateNormalView, self)
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.LoadGodDiamondTimes, self)
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    for k, v in pairs(self.viewList) do
        if v.CloseView then
            v:CloseView()
        else
            v:Close()
        end
        self.viewList[k] = nil
    end
    self.viewList = nil
    self:StopGodPrivilegTimer()
end

