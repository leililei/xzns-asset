---界面切换
function DrawView:RecruitmentTypeSwitch(type, propChooseBol)
    if type == ChangeType.Left then
        local info = table.remove(self.CurTypeList, #self.CurTypeList)
        table.insert(self.CurTypeList, 1, info)
        self.nowDotIndex = self.nowDotIndex + 1 > 3 and 1 or self.nowDotIndex + 1
    elseif type == ChangeType.Right then
        local info = table.remove(self.CurTypeList, 1)
        table.insert(self.CurTypeList, info)
        self.nowDotIndex = self.nowDotIndex - 1 < 1 and 3 or self.nowDotIndex - 1
    end
    for i = 1, 3 do
        self.dotObj[i]:SetActiveE(i == self.nowDotIndex and 1 or 0)
        self.go_table["obj_banner" .. i]:SetActiveE(i == self.nowDotIndex and 1 or 0)
        if i == self.nowDotIndex then
            if bannerImage[i] and bannerImagePath[i] then
                for k, v in ipairs(bannerImage[i]) do
                    if self.go_table[v] then
                        self.go_table[v]:SetActiveE(1)
                        self.go_table[v]:LoadImage(
                                bannerImagePath[i][k],
                                function(img)
                                    img:SetNativeSize()
                                end
                        )
                    end
                end
            end
        end
    end
    self:CheckArrowRed()
    --self.go_table.aorbtn_TeQuan:SetActiveE(0)
    --self.go_table.obj_GodToggles:SetActiveE(0)
    self.go_table.aorbtn_wuxingShop:SetActiveE(0)
    --self.go_table.aorimage_YouJian.SpriteName = RoleBiaoTiType[self.CurTypeList[3]]
    self:ChangeShowPosition(self.go_table.obj_hongDian3, self.CurTypeList[3], self.go_table.obj_NormalDrawView)
    --self.go_table.aorimage_ZuoJian.SpriteName = RoleBiaoTiType[self.CurTypeList[1]]
    self:ChangeShowPosition(self.go_table.obj_hongDian4, self.CurTypeList[1], self.go_table.obj_PropDrawView)

    self:LoadDiscount(DISCOUNT.NONE, "right")

    self:LoadResComponent(self.CurTypeList[2])

    self.go_table.obj_ElementAward:SetActiveE(0)
    self.go_table.aorbtn_DrawTenTimes:SetActiveE(1)
    self.go_table.aorbtn_DrawOnce:SetActiveE(1)
    self.go_table.obj_diamondTimes:SetActiveE(1)
    self.go_table.obj_hzylAward:SetActiveE(self.CurTypeList[2] == _G.CardPoolType.Prop and 1 or 0)
    --self.go_table.obj_Award_ylzz:SetActiveE(self.CurTypeList[2] == _G.CardPoolType.Normal)
    self.go_table.aorrawimage_model:LoadImage(diaoxiangIma[self.CurTypeList[2]])
    self.go_table.obj_remainTimes:SetActiveE(self.CurTypeList[2] == _G.CardPoolType.Normal and 1 or 0)
    if self.CurTypeList[2] == _G.CardPoolType.Normal then
        --self.go_table.obj_GodToggles:SetActiveE(1)
        if self.isGod then
            self:LoadGodConsumesInfos()
            self:LoadGodDiamondTimes()

            if require("DrawModel"):GetInstance():HasGodPrivilegeDiamondDiscount() then
                self:StartGodPrivilegTimer(true)
            end
        else
            self.CurPool = _G.CardPoolID.Normal
            self.CurView = _G.CardPoolType.Normal
            self.go_table.obj_NormalDrawView:SetActiveE(1)
            self:LoadDiscount(DISCOUNT.NORMAL, "right")

            --self.go_table.aorbtn_TeQuan:SetActiveE(0)
            self:UpdateNormalView()
        end
    elseif self.CurTypeList[2] == _G.CardPoolType.FriendShip then
        self.CurPool = _G.CardPoolID.FriendShip
        self.CurView = _G.CardPoolType.FriendShip

        self:UpdateFriendView()
        self:YouQingWuPinItem()
        if _G.PlayerPrefsManager.GetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "DrawYouQingDian", 0) == 0 then
            _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "DrawYouQingDian", 1)
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FriendDraw.id)
        end
    elseif self.CurTypeList[2] == _G.CardPoolType.Prop then
        self.CurPool = require("DrawModel"):GetInstance().PropPoolToday
        self.CurView = _G.CardPoolType.Prop
        if propChooseBol then
            self:UpdatePropView(self.CurPool)
        else
            self:UpdatePropView()
        end
        if _G.PlayerPrefsManager.GetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "DrawWuXi", 0) == 0 then
            _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "DrawWuXi", 1)
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.DrawButton.id)
        end
    end
    --self:ShowTotalDrawBtn(self.CurTypeList[2])
    self:ShowCumulativeAwardsBtn(self.CurTypeList[2])
    _G.Events:GetInstance():Broadcast(_G.eGuideEvent.SpecialTrigger, _G.GuideSpecialTrigger.DrawTypeChange)
end

