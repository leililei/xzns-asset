function DrawView:UpdateFLOR()
    self.go_table.obj_ElementAward:SetActiveE(0)
    ---显示五行招募累计活动界面
    self.FlorClass = require("DrawModel"):GetInstance():GetFiveLinesOfRecruitment()
    if self.FlorClass then
        self.go_table.obj_ElementAward:SetActiveE(1)

        self.FlorTime = self.FlorClass:GetTime()

        self.go_table.aortext_ElementAwardTime.text = _G.GetLangPackValue(90029300004, _G.TimeUtil.TranslateSecondForStrMiaoHui(self.FlorTime, 1))

        if _G.string.IsNullOrEmpty(self.FlorClass:GetTips()[2]) then
            self.go_table.aorimage_ElementAwardBtnTips:SetActiveE(0)
        else
            self.go_table.aorimage_ElementAwardBtnTips:SetActiveE(1)
        end
        self.go_table.aortext_ElementAwardBtnTips.text = self.FlorClass:GetTips()[2]

        self.go_table.aortext_ElementAwardName.text = self.FlorClass.Info.cfg.name
        local str = _G.string.split(self.FlorClass.Info.cfg.skin, "#")
        --self.go_table.aorrawimage_ElementAwardbsx:LoadImage(str[1])
        self.go_table.aorrawimage_ElementAwardbsx:SetNativeSize()
        if #str > 1 then
            self.go_table.aorrawimage_ElementAwardbsx:SetLocalPosition(str[2], str[3], str[4])
            self.go_table.aorrawimage_ElementAwardbsx:SetLocalScaleXYZ(str[5])
        end

        if self.FlorClass.Info.award_times < 1 then
            self.go_table.aortext_ElementAwardjdtext.text = self.FlorClass.CurTimes .. "/" .. self.FlorClass.Info.cfg.first_num

            self.go_table.aorimage_ElementAwardjd.fillAmount = self.FlorClass.CurTimes / self.FlorClass.Info.cfg.first_num

            self.go_table.aortext_ElementAwardDesc.text = string.format(self.FlorClass.Info.cfg.desc, self.FlorClass.Info.cfg.first_num)

            if self.FlorClass.CurTimes >= self.FlorClass.Info.cfg.first_num then
                self.IsCanGet = true
            end
        else
            local showTims = self.FlorClass.CurTimes - self.FlorClass.Info.cfg.first_num -
                    (self.FlorClass.Info.award_times - 1) * self.FlorClass.Info.cfg.num

            self.go_table.aortext_ElementAwardjdtext.text = showTims .. "/" .. self.FlorClass.Info.cfg.num

            self.go_table.aorimage_ElementAwardjd.fillAmount = showTims / self.FlorClass.Info.cfg.num

            self.go_table.aortext_ElementAwardDesc.text = string.format(self.FlorClass.Info.cfg.desc, self.FlorClass.Info.cfg.num)
            if showTims >= self.FlorClass.Info.cfg.num then
                self.IsCanGet = true
            end
        end

        if self.IsCanGet then
            require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.DrawFLOR.id)
        end

        if nil == self.FlorTimer then
            self.FlorTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateFlorTime, self, false, false, true)
            self.FlorTimer:Start()
        end
    end
end

