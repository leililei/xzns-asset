function DrawView:LoadResComponent(type)
    if _G.IsNil(self.go_table.obj_GoldInfo) or self.go_table.obj_GoldInfo:GetctiveInHierarchy() ~= 1 then
        return
    end

    ---@type number[]
    local rsList = {_G.ResPropID.Diamond}
    if type == _G.CardPoolType.Normal then
        table.insert(rsList, 1, _G.ConfigManager.lucky_roller_cfg[_G.CardPoolID.Normal].ticket[1])
    elseif type == _G.CardPoolType.FriendShip then
        table.insert(rsList, 1, _G.ConfigManager.lucky_roller_cfg[_G.CardPoolID.FriendShip].ticket[1])
    elseif type == _G.CardPoolType.Prop then
        table.insert(rsList, 1, _G.ConfigManager.lucky_roller_cfg[_G.CardPoolID.Thunder].ticket[1])
    --local sid = require("DrawModel"):GetInstance():GetWuxingAwardInfos()
    --if sid > 0 then
    --    table.insert(rsList, 1, sid)
    --end
    end
    if self.goldComponent then
        self.goldComponent:RestRs(rsList)
    else
        ---@type ResourceCompont @货币资源组件
        self.goldComponent =
            self:AddComponent(
            self.go_table.obj_GoldInfo,
            require("ResourceCompont").New(self.go_table.obj_GoldInfo, rsList)
        )
    end
end

---降神特权定时检测(如果定时器已开启, 则不会进行创建)
---@param force boolean  强制重新创建定时器
function DrawView:StartGodPrivilegTimer(force)
    if self.godPrivilegeTimer and not force then
        return
    end
    self:StopGodPrivilegTimer()
    self.godPrivilegeTimer = _G.TimerManager:GetInstance():GetTimer(1, self.GodPrivilegeUpdate, self, false, false, true)
    self.godPrivilegeTimer:Start()
end

---停止(降神特权)定时器
function DrawView:StopGodPrivilegTimer()
    if not self.godPrivilegeTimer then
        return
    end
    self.godPrivilegeTimer:Stop()
    self.godPrivilegeTimer = nil
end

function DrawView:GodPrivilegeUpdate()
    if not self.isGod then
        self:StopGodPrivilegTimer()
        return
    end
    if not require("DrawModel"):GetInstance():HasGodPrivilegeDiamondDiscount() then
        self:LoadGodConsumesInfos()
        self:LoadGodDiamondTimes()

        self:StopGodPrivilegTimer()
    end
end

