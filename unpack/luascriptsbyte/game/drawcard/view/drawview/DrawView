---点击抽卡按钮结果返回
function DrawView:DrawCardSuc(num, bool)
    self.hideResUp = false
    if self.CurPool >= 301 then
        require("DrawModel"):GetInstance():ChangeFLORTimes(num)
    end
    self.go_table.aorimage_zhedang:SetActiveE(1)
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DrawResultView.Name)
    local kaihuan = _G.PlayerPrefsManager.GetInt("kaiguan")
    if window then
        window.View:InitView()
    elseif kaihuan == 1 then
        _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.DrawResultView.Name,
                self.CurPool,
                num,
                _G.handler(self, self.Shuaxing),
                _G.handler(self, self.DrawCard),
                bool,
                _G.handler(self, self.EnableClickBtn)
        )
    else
        isReloadFinish = false
        isVideoFinish = false
        --local path = _G.ConfigManager.video_cfg["zhaomu"]

        ---@type DynamicVideoCfg
        local dynamicVideoCfg
        if _G.AppSetting.IsShowTeach and _G.GuideManager:GetInstance().IsGuideing then
            dynamicVideoCfg = {}
            dynamicVideoCfg.isShowSkipBtn = false
        end
        -- _G.AudioManager.PauseMusic()
        self.go_table.obj_Eff:ClearChildren()
        _G.AudioManager.PlayAudioByAudioCfgID(2054)
        local effectCfg = _G.ConfigManager.ui_effect_cfg.ef_zhaomu
        if _G.AppSetting.IsXzns then
            if RoleEffectType[self.CurPool] then
                effectCfg = _G.ConfigManager.ui_effect_cfg[RoleEffectType[self.CurPool]]
            end
            self:PlayAnimation()
        end
        _G.UIUtils.LoadEffectByCfg(
            effectCfg,
            self.go_table.obj_Eff,
            function()
                self.go_table.aorimage_EffMask:SetActiveE(1)
                self.go_table["obj_banner" .. self.nowDotIndex]:SetActiveE(0)
            end,
            function()
                self:DrawResultView(num, bool)
                self.go_table.aorimage_EffMask:SetActiveE(0)
                self.go_table["obj_banner" .. self.nowDotIndex]:SetActiveE(1)
            end
        )
        --_G.UIUtils.PlayVideo(path, _G.handlerbind(self, self.DrawResultView, num, bool), nil, dynamicVideoCfg)
        _G.PoolsManager:GetInstance():Preload(
                _G.ConfigManager.ui_cfg.DrawResultView.PrefabPath,
                function()
                    isReloadFinish = true
                    if isReloadFinish and isVideoFinish then
                        self:OpenDrawResult(num, bool)
                    end
                end,
                _G.ePoolType.UIItem
        )
    end
    self:SetCumulativeAwardsViewRedPoint()
end

