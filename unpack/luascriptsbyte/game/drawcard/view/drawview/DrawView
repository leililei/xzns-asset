---刷新十连招募图标
function DrawView:UpdateDrawIcon(data)
    local material = self.cfg[self.CurPool or _G.CardPoolID.Thunder].ticket
    if _G.IsNil(data) then
        local count = _G.StorageManager:GetInstance():GetItemCountBySid(material[1])
        self.go_table.obj_drawIcon:SetActiveE((count >= 10 * material[2]) and 1 or 0)
    else
        if not self.hideResUp then
            for _, value in pairs(data) do
                local sid = value.type[1]
                if sid == material[1] then
                    local count = _G.StorageManager:GetInstance():GetItemCountBySid(material[1])
                    self.go_table.obj_drawIcon:SetActiveE((count >= 10 * material[2]) and 1 or 0)
                    self:RecruitmentTypeSwitch(ChangeType.None, true)
                end
            end
        end
    end
end

function DrawView:SetWinLayer(parent, name)
    local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(name)
    _G.UIManager:GetInstance():ChangeCanvasOrder(
            ctrl.viewName,
            self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder + 30
    )
    ctrl.transform:SetParentE(parent)
    ctrl.transform:SetAsLastSiblingE()
    self.viewList[name] = ctrl
end

return DrawView
