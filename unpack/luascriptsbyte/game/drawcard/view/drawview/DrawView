function DrawView:drawUpBut()
    if require "DrawUpMainModel":GetInstance().activity == nil then
        self.go_table.aorbtn_DrawUp:SetActiveE(0)

        return
    end
    local activitys =
        require "ActivitySynManager":GetInstance():GetChildAcitivity(
        10028,
        require "DrawUpMainModel":GetInstance().activity:GetJumpType()
    )
    if activitys then
        self.go_table.obj_redpointDrawUp:UpdateRedPointItemIDAndParam(
                activitys:GetActivityTypeCls():GetRedpointIDByIndex(1)
        )

        self.go_table.aorbtn_DrawUp:SetActiveE(1)
    else
        self.go_table.aorbtn_DrawUp:SetActiveE(0)
    end

    local cfg = require("DrawUpMainModel"):GetInstance().cfg
    if cfg and cfg.coin ~= "test" then
        --self.go_table.aorrawimage_DrawUp.SpriteName = cfg.coin
        self.go_table.aorrawimage_DrawUp:LoadImage(
                cfg.coin,
                function(image)
                    if image then
                        image:SetActiveE(1)
                        image:SetNativeSize()
                    end
                end
        )
        self.go_table.aorrawimage_DrawUp:SetNativeSize()
    end
    if cfg and cfg.coin_effects ~= "test" then
        _G.UIUtils.LoadEffectByPath(cfg.coin_effects, self.go_table.aorrawimage_DrawUp)
    end
end

