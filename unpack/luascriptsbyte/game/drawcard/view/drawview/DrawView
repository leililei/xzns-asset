    else
        self.go_table.aorbtn_AD:SetActiveE(0)
    end
    local material = self.cfg[self.CurPool].ticket
    local Diamond = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Prop)[material[1]]

    local rmb = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.ResProp, _G.ResPropID.Diamond)

    local materialrmb, free, DrawTenTimes
    free = true
    DrawTenTimes = true
    --self.go_table.obj_hongDian:SetActiveE(0)
    if rmb >= self.exchange[10002].need_item[1][2] then
        materialrmb = self.exchange[10002].need_item[1][2]
    else
        -- "<color=#e55352>" .. self.exchange[10002].need_item[1][2] .. " </color>"
        materialrmb = self.exchange[10002].need_item[1][2]
    end
    local materialrmb_1
    if rmb >= self.exchange[10001].need_item[1][2] then
        materialrmb_1 = self.exchange[10001].need_item[1][2]
    else
        --"<color=#e55352>" .. self.exchange[10001].need_item[1][2] .. " </color>"
        materialrmb_1 = self.exchange[10001].need_item[1][2]
    end
    self:LoadDiscount(DISCOUNT.NORMAL, "right")
    -- if Diamond ~= nil and Diamond.count >= 10 then
    --     self.go_table.obj_normalRed:SetActiveE(1)
    -- else
    --     self.go_table.obj_normalRed:SetActiveE(0)
    -- end
    if Diamond == nil or Diamond.count <= 0 then
        free = false
        DrawTenTimes = false
        self:loadImage(self.currency[12].icon, self.currency[12].icon, materialrmb_1, materialrmb, 10)
    elseif Diamond.count == 1 then
        DrawTenTimes = false

        self:loadImage(self.item[material[1]].Icon, self.currency[12].icon, material[2], materialrmb, 10)
    elseif Diamond.count < 10 then
        DrawTenTimes = false

        self:loadImage(self.item[material[1]].Icon, self.currency[12].icon, material[2], materialrmb, 10)
    else
        --self.go_table.obj_hongDian:SetActiveE(1)
        self:LoadDiscount(DISCOUNT.NONE, "right")

        self:loadImage(self.item[material[1]].Icon, self.item[material[1]].Icon, material[2], material[2] * 10, 10)
    end
    self.go_table.obj_hongDian:UpdateRedPointItemIDAndParam(BtnRedType[1])
    self:tieXiaoNew(free, DrawTenTimes)
    self:imageXianShi()
    self:LoadGodDiamondTimes()
    self:ShowXinYuanDan()
