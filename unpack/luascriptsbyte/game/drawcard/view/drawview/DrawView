---点击抽卡按钮
function DrawView:DrawCard(type)
    if self.View == _G.CardPoolType.Prop then
        if not self.CurPool then
            _G.PopWindowManager:GetInstance():ShowAllTips(340606)
            return
        end
        self.CurPool = require("DrawModel"):GetInstance():GetPropPool()
    end
    -- if require("DrawModel"):GetInstance().exit_num - self.NextAward.LastTime >= self.NextAward.num then
    --     return
    -- end
    if self.clickBol then
        return
    end
    if self.pools[self.CurPool].day_count >= self.pools[self.CurPool].cfg.limit_daily then
        _G.PopWindowManager:GetInstance():ShowAllTips(TipsID.DrawCardTimesLimit)
        return
    end

    local material = _G.DeepCopyCfgTable(_G.ConfigManager.lucky_roller_cfg[self.CurPool].ticket)
    if type == 2 and self.View ~= _G.CardPoolType.FriendShip then
        material[2] = material[2] * 10
    elseif type == 1 then
        material[2] = 1
    end
    local list = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    if _G.table.count(list) + material[2] > _G.StorageManager:GetInstance():GetStorageCapacity(_G.StorageID.Card) then
        _G.PopWindowManager:GetInstance():ShowAllTips(TipsID.CardBagIsFull)
        _G.DelayDo(
                0.3,
                function()
                    if self:IsNil() then
                        return
                    end
                    _G.StorageUtils.CardBagAdd(nil, self)
                end
        )
        return
    end
    self.clickBol = true
    local freeCount = require "HellRoadModel":GetInstance():GetNumber({_G.PrivilegeType.DrawCard.Count, self.CurPool})
    if
    not _G.StorageManager:GetInstance():CheckItem(material[1], material[2]) and
            freeCount < self.pools[self.CurPool].free_times + material[2]
     then
        if self.CurPool == _G.CardPoolID.Normal then
            local rmb = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.ResProp, _G.ResPropID.Diamond)
            local MaterialData, id
            local getItemData
            if type == 1 then
                id = 10001
                MaterialData = self.exchange[10001].need_item[1][2]
                getItemData = self.exchange[10001].get_item[1]
            elseif type == 2 then
                id = 10002
                MaterialData = self.exchange[10002].need_item[1][2]
                getItemData = self.exchange[10002].get_item[1]
            else
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TicketExchangeView.Name)
                self.clickBol = false
                return
            end
            if rmb >= MaterialData then
                _G.PopWindowManager:GetInstance():ShowBtnWindowByToggle(
                        627,
                        function()
                            self.JianGe = _G.TimeUtil:GetServerUnixTime()
                            self.hideResUp = true
                            _G.StorageManager:GetInstance():PropBuy(
                                    id,
                                    1,
                                    1,
                                    function()
                                        _G.UIManager:GetInstance():OpenWindow(
                                                _G.ConfigManager.ui_cfg.DrawFloatTipsView.Name,
                                                id
                                        )
                                        require("DrawModel"):GetInstance():DrawCard(
                                                self.CurPool,
                                                type,
                                                _G.handler(self, self.DrawCardSuc)
                                        )
                                    end
                            )
                        end,
                        function()
                            self.clickBol = false
                        end,
                        nil,
                        true,
                        MaterialData,
                        getItemData[2],
                        _G.GetLangPackValue(_G.ConfigManager.item_cfg[getItemData[1]].Name),
                        getItemData[2]
                        
                )
            else
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ResPropID.Diamond)
                self.clickBol = false
            end
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, material[1])
            self.clickBol = false
        end
        return
    end
    -- if self.JianGe == nil or self.JianGe + 1 >= _G.TimeUtil:GetServerUnixTime() then
    --     return
    -- end

    local needMaterial = self.cfg[self.CurPool].ticket
    if not _G.StorageManager:GetInstance():CheckItem(
        needMaterial[1], 
        type == 1 and needMaterial[2] or needMaterial[2] * 10
    ) then
        self.clickBol = false
    end
    self.JianGe = _G.TimeUtil:GetServerUnixTime()
    require "IllustrationModel":GetInstance().NewChoKa = {}

    require("DrawModel"):GetInstance():DrawCard(self.CurPool, type, _G.handler(self, self.DrawCardSuc))
end

---奖励抽卡
function DrawView:ChouKa(type)
    local list = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    if _G.table.count(list) + 1 > _G.StorageManager:GetInstance():GetStorageCapacity(_G.StorageID.Card) then
