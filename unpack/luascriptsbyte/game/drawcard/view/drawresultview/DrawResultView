---界面的入口函数
function DrawResultView:OnCreate(pool, time, call, ZhaoMu, boo1, btnCall)
    --召唤类型
    self.pool = pool

    --回调方法
    self.call = call

    --生成完卡牌展示解锁抽卡按钮回调
    self.enableBtnCall = btnCall

    self.TimeitemCardlist = {}
    self.EffList = {}
    self.ZhaoMu = ZhaoMu
    self.tiaoGou = false
    self.cfg = _G.ConfigManager.lucky_roller_cfg[pool]
    self.card_cfg = _G.ConfigManager.card_cfg
    self.card_level_cfg = _G.ConfigManager.card_level_cfg
    self.card_skills_cfg = _G.ConfigManager.card_skills_cfg
    self.timeUnix = _G.TimeUtil:GetServerUnixTime() + 3
    local tieXiaoShi = _G.ConfigManager.discrete_cfg[100405]
    self.tieXiaotiem = {
        [2] = tieXiaoShi[1][1],
        [3] = tieXiaoShi[1][2],
        [5] = tieXiaoShi[1][3]
    }
    self.headTransList = {}
    self.curShowIndex = 1
    if time < 10 then
        self.time = 1
    else
        self.time = 10
    end

    if boo1 ~= nil then
        self.go_table.aorbtn_ZhaoMuTen:SetActiveE(0)
        self.go_table.aorbtn_QueRen:SetLocalPosition(0, -287, 0)
    end
    if not _G.IsNil(self.go_table.obj_GoldInfo) and self.go_table.obj_GoldInfo:GetctiveInHierarchy() == 1 then
        self:AddComponent(
            self.go_table.obj_GoldInfo,
            require("ResourceCompont").New(
                self.go_table.obj_GoldInfo,
                {
                    _G.ConfigManager.lucky_roller_cfg[self.pool].ticket[1],
                    _G.ResPropID.Diamond
                }
            )
        )
    end
    --self:()
    self:InitView()
    ---适配刘海屏
    if self.danchou then
        local x, y, z = self.danchou.aorimage_new:GetLocalPosition()
        self.danchou.aorimage_new:SetLocalPosition(x, y + Woff, z)
    end
end

