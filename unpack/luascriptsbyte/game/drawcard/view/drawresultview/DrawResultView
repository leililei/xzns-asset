function DrawResultView:loadImage()
    local material = _G.ConfigManager.lucky_roller_cfg[self.pool].ticket
    local id = ""

    local num
    --local numstr = "招募一次"
    local mat = _G.DeepCopyCfgTable(_G.ConfigManager.lucky_roller_cfg[self.pool].ticket)
    local Diamond = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Prop)[mat[1]]

    if self.time == 10 then
        if Diamond ~= nil and Diamond.count >= 10 then
            num = 10
        else
            num = 10
        end
    else
        --numstr = "招募一次"
        if Diamond ~= nil and Diamond.count >= 1 then
            num = 1
        else
            num = 1
        end
    end
    self.go_table.aorrawimage_dazhedi:SetActiveE(0)
    --self.go_table.aorimage_shuliangdi:SetRectTransformSize(102, 30)
    if self.pool == _G.CardPoolID.FriendShip then
        num = material[2]
        if self.time == 10 then
            num = material[2] * 10
        end

        id = _G.ConfigManager.currency_type_cfg[material[1]].icon
    else
        if self.pool == _G.CardPoolID.Normal then
            if self.time == 1 then
                if Diamond ~= nil and Diamond.count >= 1 then
                    id = _G.ConfigManager.item_cfg[material[1]].Icon
                    num = 1
                else
                    id = _G.ConfigManager.currency_type_cfg[12].icon
                    num = _G.ConfigManager.exchange_cfg[10001].need_item[1][2]
                end
            elseif self.time == 10 then
                if Diamond ~= nil and Diamond.count >= 10 then
                    id = _G.ConfigManager.item_cfg[material[1]].Icon
                    num = 10
                else
                    self.go_table.aorrawimage_dazhedi:SetActiveE(1)

                    id = _G.ConfigManager.currency_type_cfg[12].icon
                    num = _G.ConfigManager.exchange_cfg[10002].need_item[1][2]
                    --self.go_table.aorimage_shuliangdi:SetRectTransformSize(120, 30)
                end
            end
        else
            id = _G.ConfigManager.item_cfg[material[1]].Icon
        end
    end

    self.go_table.aortext_PropLeftNum.text = num
    self.go_table.aorrawimage_PropLeft:LoadImage(
        id,
        function(image)
            if image then
                image:SetActiveE(1)
            end
        end
    )
