function DrawResultView:CloseView()
    if self.Option and not _G.AppSetting.IsArraigned then
        local condition = _G.ConfigManager.discrete_cfg[100117][1]
        local time = _G.TimeUtil.GetServerUnixTime()
        local day = _G.PlayerPrefsManager.GetInt("OptionConditonDay", 0)
        local curAfkSid = require "AfkModel":GetInstance():GetLastSection()
        if day + 86400 * condition[2] < time and curAfkSid >= condition[1] then
            _G.PlayerPrefsManager.SetInt("OptionConditonDay", time)
            if _G.AppSetting.IsIos then
                _G.CS.UnityEngine.iOS.Device.RequestStoreReview()
            else
                local IsOption = _G.PlayerPrefsManager.GetInt("IsOption", 0)
                if _G.AppSetting.IsOverseas and IsOption ~= 1 and _G.CS.Launcher.Inst.IsSDK then
                    _G.PopWindowManager:GetInstance():ShowAllTips(
                        200308,
                        nil,
                        function()
                            _G.CS.UnityEngine.Application.OpenURL("market://details?id=com.morefun.zhjtw")
                            _G.PlayerPrefsManager.SetInt("IsOption", 1)
                        end
                    )
                end
            end
        end
        self.Option = false
    end
    self:Close()
end

