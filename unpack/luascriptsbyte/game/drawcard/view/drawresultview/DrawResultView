function DrawResultView:OnStartClose()
    if self.TiemcurShowIndex ~= nil then
        self.TiemcurShowIndex:Stop()
    end
    if self.Timei ~= nil then
        self.Timei:Stop()
    end
    if self.call then
        require("DrawModel"):GetInstance():CalcAwardTime()
        require("DrawModel"):GetInstance():GetWuxingAwardThenClear()
        require("DrawModel"):GetInstance():GetAward(self.call(datalist), datalist, self.awardList)
        require("DrawModel"):GetInstance():PopAwardTips()
    end
end

