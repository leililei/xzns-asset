---卡牌展示
function DrawResultView:KaPaiZhanShi(index, listView2)
    if index < 0 then
        return
    end
    local x = index

    self.itemCard[x] = {}
    self.itemCard[x] = _G.GetAutoGoTable(listView2, _G.handlerbind(self, self.AddDianJiBtn, x))
    self.itemCard[x].CardIndex = index

    local data = self.data[x]
    if data ~= nil then
        self:SpawnCard(self.itemCard[x])
    end
end

---单抽卡牌展示
function DrawResultView:KaPaiZhanShiDanChou()
    if not self.itemCardDan or not self.itemCardDan.Lua then
        self.itemCardDan = {}
        self.itemCardDan = _G.GetAutoGoTable(self.go_table.obj_cardItemDan,
            _G.handlerbind(self, self.AddDianJiDanChouCard, 1))
        self.itemCardDan.CardIndex = 1
    end

    local data = self.data[1]
    if data ~= nil then
        if self.itemCardDan.Lua then
            self:SetCardItem(self.itemCardDan)
        else
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.baseBodyItem,
                self.itemCardDan.obj_node,
                function(itemLua)
                    self.itemCardDan.Lua = itemLua
                    self:SetCardItem(self.itemCardDan)
                end
            )
        end
    end
end

function DrawResultView:AddDianJiDanChouCard(go, _, index)
    --("卡牌" .. index .. "被点击")
    if self.card_cfg[self.data[index].sid] == nil then
        if _G.AppSetting.DEBUG then
            _G.Log(self.data[index])
        end
    else
        self:DrawAnimator(go.gameObject, self.data[index].sid)
    end
end

function DrawResultView:SpawnCard(itemGoTable)
    if itemGoTable.Lua then
        self.nowIndex = self.nowIndex + 1
        self:SetCardItem(itemGoTable)
        self:TiaoZhuan(nil, itemGoTable.CardIndex)
        if self.dataNum == self.nowIndex then
            self:DrawResultRole()
            self.nowIndex = 0
        end
    else
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.baseBodyItem,
            itemGoTable.obj_node,
            function(itemLua)
                self.nowIndex = self.nowIndex + 1
                itemGoTable.Lua = itemLua
                self:SetCardItem(itemGoTable)
                self:TiaoZhuan(nil, itemGoTable.CardIndex)
                if self.dataNum == self.nowIndex then
                    self:DrawResultRole()
                    self.nowIndex = 0
                end
            end
        )
    end
end

function DrawResultView:SetCardItem(itemGoTable)
    if itemGoTable == nil or self:IsNil() then
        return
    end
    ---@type CardData
    local carddata = self.data[itemGoTable.CardIndex]
    if not carddata then
        return
    end
    ---@type ItemCardBodySelectView
    local lua = itemGoTable.Lua
    itemGoTable.gameObject:SetName(itemGoTable.CardIndex)
    carddata.skinIs = false

    if carddata.skin and carddata.skin ~= 0 then
        carddata.skinIs = true
    end
    if carddata.Grade == 3 then
        carddata.newEff = carddata.newEff or {}
        carddata.newEff[1] = "ef_kapailiuguang_hongwai"
    elseif carddata.Grade > 3 then
        carddata.newEff = carddata.newEff or {}
        carddata.newEff[1] = "ef_kapailiuguang_jinwai"
    end
    lua:ShowCardData(carddata, nil, true)
end

function DrawResultView:LoadEffectByCfg(effect, ui, call)
    _G.UIUtils.LoadEffectByCfg(
        effect,
        ui,
        function(trans)
            _G.table.insert(self.EffList, trans)
            if call then
                call()
            end
        end
    )
end

