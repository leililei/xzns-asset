---初始化显示
function DrawResultView:InitView()
    for _, value in pairs(self.CDList) do
        value.barAnimator.enabled = true
    end
    -- self.Timei = _G.TimerManager:GetInstance():GetTimer(2, self.AorBtn_Closs, self, true, false, true)
    -- self.Timei:Start()
    self.go_table.aortext_Tips:SetActiveE(1)
    self.CDList = {}
    local obj_CardShow
    self.tiaoGou = false
    self.DianjiIll = true
    if self.EffList ~= nil and #self.EffList >= 1 then
        for i = #self.EffList, 1, -1 do
            local a = _G.table.remove(self.EffList, i)
            _G.DestroyObject(a)
        end
    end
    self.data = {}
    self.itemCard = {}
    self.itemCardTieXiao = {}
    self.TimeitemCard = {}
    self.curShowIndex = 1
    for _, v in pairs(require("DrawModel"):GetInstance():GetCurDrawCardInfo()) do
        local msg = {}
        msg.sid = v.sid
        msg.cfg = _G.ConfigManager.card_cfg[msg.sid]
        msg.star = v.star
        local cardData = _G.CardData.New()
        cardData:ParseInitMsg(msg)
        table.insert(self.data, cardData)
        table.insert(datalist, v)
        -- local info = {}
        -- info.sid = 114200000
        -- info.cfg = _G.ConfigManager.card_cfg[info.sid]
        -- info.star = 5
        -- table.insert(self.data, info)
        -- table.insert(datalist, info)
    end

    local cdad = require("DrawModel"):GetInstance().CurDrawAwardData
    if cdad then
        for i = 1, #cdad.award.item do
            local id = cdad.award.item[i].type[1]
            local num = cdad.award.item[i].type[2]
            if self.awardList[id] then
                local it = self.awardList[id]
                it.type[2] = it.type[2] + num
            else
                self.awardList[id] = cdad.award.item[i]
            end
        end
        require("DrawModel"):GetInstance().CurDrawAwardData = nil
    end
    self.go_table.obj_Danchou:SetActiveE(0)
    self.go_table.obj_GoldInfo:SetActiveE(1)
    self.go_table.obj_CardShow:SetActiveE(0)
    self.indexNum = 0
    self.DrawResultRoleView = {}
    if self.time == 1 then
        if self.data[1].star < 5 then
            self.TimeitemCards = _G.TimerManager:GetInstance():GetTimer(1, self.YingChang, self, true, false, true)
            self.TimeitemCards:Start()
        end
        self.go_table.aorbtn_Closs:SetActiveE(0)
        self.go_table.obj_Danchou:SetActiveE(1)
        self.go_table.obj_GoldInfo:SetActiveE(0)
        self.go_table.aortext_Num10:SetActiveE(0)
        self.go_table.aortext_free:SetActiveE(1)
        self.danchou = _G.GetAutoGoTable(self.go_table.obj_Danchou, _G.handlerbind(self, self.AddDianJiBtn, 1))
        _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.DrawResultView, self.danchou)
        self:showItemBaseInfo(self.danchou, self.data[1])
    else
        self.go_table.aortext_Num10:SetActiveE(1)
        self.go_table.aortext_free:SetActiveE(0)
        self.go_table.obj_CardShow:SetActiveE(1)
        self.nowIndex = 0
        self.dataNum = #self.data
        for i = 1, 10 do
            local var = self.go_table["obj_cardItem" .. i]
            self:KaPaiZhanShi(i, var)
        end
        self.go_table.aorrawimage_BG:LoadImage(
            "ImagesH5/hDraw/ui_zmzs_bg_06",
            function()
                if not _G.IsNil(self.go_table) then
                    self.go_table.obj_all:SetActiveE(1)
                end
            end
        )
    end
    self:ZhaoMuBut(1)
    --self.go_table.obj_DrawTenTimes:SetActiveE(0)
    self:loadImage()
    --_G.TimerManager:GetInstance():GetTimer((0.5), self.DrawResultRole, self, true, false, true):Start()
end

