---@class DrawExAwardView : UIBaseView	中文描述
---@field public go_table DrawExAwardView_GoTable GoTable
---@field itemList table<number,ItemViewBase>
local DrawExAwardView = _G.BaseClass("DrawExAwardView", _G.UIBaseView)


--region DrawExAwardViewItem
---@class DrawExAwardViewItem
local DrawExAwardViewItem = _G.BaseClass("DrawExAwardViewItem")
function DrawExAwardViewItem:__init(obj)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj)
end
function DrawExAwardViewItem:Show(data)
    self.gameObject:SetActiveE(1)
    local storageManager = _G.StorageManager:GetInstance()
    storageManager:GetItemBaseViewNew(data, self.go_table.obj_Node, _G.handler(self, self.OnItemShow))
end
function DrawExAwardViewItem:OnItemShow(item)
    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
    item.transform:SetLocalPosition(0, 0, 0)
end
--endregion


function DrawExAwardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function DrawExAwardView:OnCreate()
    ---@type number[][] 奖励二维数组{{sid,num},{sid,num}} 
    local preaward = require("DrawModel"):GetInstance():GetAwardPre()
    local award = { { preaward[2], preaward[3] } }
    self.itemList = {}
    if preaward[2] == nil or preaward[2] == 0 then
        self.go_table.obj_sp_award:SetActiveE(1)
        self.go_table.obj_common_award:SetActiveE(0)
    else
        self.go_table.obj_sp_award:SetActiveE(0)
        self.go_table.obj_common_award:SetActiveE(1)
        for i = 1, #award do
            local item = self:GetItem(i)
            item:Show(award[i])
        end
    end
    
    self.rewards = require("DrawModel"):GetInstance():GetTotalAward()
    if self.rewardsScroll == nil then
        self.go_table.scrollloopvectical_list:InitItemData(#self.rewards, _G.handler(self, self.RefreshItem))
        self.rewardsScroll = self.go_table.scrollloopvectical_list
    end
end

function DrawExAwardView:GetItem(index)
    local obj = _G.InstantiateObject(self.go_table.obj_item, self.go_table.trans_precontent)
    local item = DrawExAwardViewItem.New(obj)
    return item
end


---@param index 位置
---@param obj UnityEngine.GameObject  
function DrawExAwardView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    local id = obj:GetInstanceIDE()
    local data = self.rewards[index + 1]
    obj:SetName(id .. "_" .. data[1])
    if self.itemList[id] then
        require("ItemViewBase").Despawn(self.itemList[id])
        self.itemList[id] = nil
    end
    local tb = _G.GetAutoGoTable(obj)
    ---@param item ItemViewBase
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        data,
        tb.obj_Node,
        function(item)
            self.itemList[id] = item
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end,
        function(go)
            self:OnBtnCallItem(go, data[1])
        end
    )
end

function DrawExAwardView:OnDestroy()
    
end

---点击掉落物品
function DrawExAwardView:OnBtnCallItem(go, itemid)
    require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, itemid)
end

---按钮点击事件在这里派发
function DrawExAwardView:OnClickBtn(go)
    if go == self.go_table.aorbtn_Close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_Done then
        require("DrawModel"):GetInstance():GetDrawExAward(function() self:Close() end)
    end
end


return DrawExAwardView
