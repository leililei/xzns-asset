require "DrawModel"

---@class PropDrawView : DrawView	中文描述
local PropDrawView = _G.BaseClass("PropDrawView", _G.Component)

---创建对象时,入口构造函数
function PropDrawView:OnCreate(obj, DrawView)
    ---@type DrawView
    self.mDrawView = DrawView
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))

    self:UpdatePropView()
end
---刷新招募界面
function PropDrawView:UpdatePropView()
    --require("DrawModel"):GetInstance():GetAwards()
    if self.PropViewTime ~= nil then
        self.PropViewTime:Stop()
        self.PropViewTime = nil
    end
    self.PropPoolID = _G.PlayerPrefsManager.GetInt("PropPoolID")
    local PropPoolIDUnixTime = _G.PlayerPrefsManager.GetInt("PropServerUnixTime")
    local PropPoolIDClockTimer = _G.PlayerPrefsManager.GetInt("PropSixClockTimer")
    self:WuXIngSet()
    local PropPoolToday = require("DrawModel"):GetInstance():GetPropPool()
    if PropPoolIDUnixTime ~= 0 and PropPoolIDClockTimer ~= 0 and self.PropPoolID ~= 0 then
        local panduan = _G.TimeUtil.CheckTheSameDay(PropPoolIDUnixTime, _G.TimeUtil.GetServerUnixTime())
        local PropSixClockTimer = _G.TimeUtil.GetSixClockTimer()
        if panduan then
            if PropPoolIDClockTimer == false and PropSixClockTimer == false then
                self:GengXingBenDiCuCun(PropPoolToday)
            end
        else
            self:GengXingBenDiCuCun(PropPoolToday)
        end

        if self.PropPoolID == _G.CardPoolID.Thunder then
            self.go_table.aorrawimage_Lei:SetActiveE(1)
        elseif self.PropPoolID == _G.CardPoolID.Earth then
            self.go_table.aorrawimage_Tu:SetActiveE(1)
        elseif self.PropPoolID == _G.CardPoolID.Fire then
            self.go_table.aorrawimage_Hou:SetActiveE(1)
        elseif self.PropPoolID == _G.CardPoolID.Water then
            self.go_table.aorrawimage_Shui:SetActiveE(1)
        elseif self.PropPoolID == _G.CardPoolID.Wind then
            self.go_table.aorrawimage_Feng:SetActiveE(1)
        end
        require("DrawModel"):GetInstance().PropPoolToday = self.PropPoolID
        self.CurPool = self.PropPoolID
        return
    end

    if PropPoolToday == _G.CardPoolID.Thunder then
        self.go_table.aorrawimage_Lei:SetActiveE(1)
    elseif PropPoolToday == _G.CardPoolID.Earth then
        self.go_table.aorrawimage_Tu:SetActiveE(1)
    elseif PropPoolToday == _G.CardPoolID.Fire then
        self.go_table.aorrawimage_Hou:SetActiveE(1)
    elseif PropPoolToday == _G.CardPoolID.Water then
        self.go_table.aorrawimage_Shui:SetActiveE(1)
    elseif PropPoolToday == _G.CardPoolID.Wind then
        self.go_table.aorrawimage_Feng:SetActiveE(1)
    end
    require("DrawModel"):GetInstance().PropPoolToday = PropPoolToday
    self.CurPool = PropPoolToday

end

function PropDrawView:PropViewTimeUpdata()
    -- self.Views.Prop.aortext_TimerNum.text = _G.TimeUtil.TimeToString(self.PropTime, 1)
end
---更新本地储存的五行
function PropDrawView:GengXingBenDiCuCun(PropPoolToday)
    _G.PlayerPrefsManager.SetInt("PropPoolID", PropPoolToday)
    _G.PlayerPrefsManager.SetInt("PropServerUnixTime", _G.TimeUtil.GetServerUnixTime())
    _G.PlayerPrefsManager.SetInt("PropSixClockTimer", _G.TimeUtil.GetSixClockTimer())
    self.PropPoolID = PropPoolToday
end
---五行背景隐藏
function PropDrawView:WuXIngSet()
    self.go_table.aorrawimage_Feng:SetActiveE(0)
    self.go_table.aorrawimage_Hou:SetActiveE(0)
    self.go_table.aorrawimage_Lei:SetActiveE(0)
    self.go_table.aorrawimage_Shui:SetActiveE(0)
    self.go_table.aorrawimage_Tu:SetActiveE(0)
end
---按钮点击事件在这里派发
function PropDrawView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_ChanGe" then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.PropDrawSelectView.Name,
            self.CurPool,
            function(poolID)
                self.CurPool = poolID
                self:UpdatePropView()
            end
        )
    end
end

---销毁对象时,析构函数
function PropDrawView:OnDestroy()
end
return PropDrawView
