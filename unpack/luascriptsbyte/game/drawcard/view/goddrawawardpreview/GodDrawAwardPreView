---@class GodDrawAwardPreView : UIBaseView    中文描述
---@field public go_table GodDrawAwardPreView_GoTable GoTable
---@field itemList GodDrawAwardPreView._obj_Item_GoTable[]
local GodDrawAwardPreView = _G.BaseClass("GodDrawAwardPreView", _G.UIBaseView)
--_G.GodDrawAwardPreView = GodDrawAwardPreView

function GodDrawAwardPreView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function GodDrawAwardPreView:OnCreate()
    self.AwardDatas = require "DrawModel":GetInstance():GetGodPreAward()
    self.itemList = {}
    self.go_table.scrollloopvectical_AwardList:InitItemData(#self.AwardDatas, _G.handler(self, self.RefreshList))
end

function GodDrawAwardPreView:RefreshList(index, obj)
    local instanceID = obj:GetInstanceIDE()
    local tb = self.itemList[instanceID]
    local data = self.AwardDatas[index + 1]
    if not data then
        return
    end
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        self.itemList[instanceID] = tb
        ---@type BaseAwardNewItem
        tb.item = require "BaseAwardNewItem".New(tb.obj_Root, _G.handler(self, self.OnClickItem))
    end
    ---@param item BaseAwardNewItem
    tb.item:Show(
        data.data,
        function(item)
            if item.item.HideOrShowStar then
                item.item:HideOrShowStar(false)
            end
            local type = _G.StorageManager:GetInstance():CheckSidType(data.data.sid)
            if type == _G.StorageType.Card then
                item.item.go_table.gameObject:SetLocalScaleXYZ(0.88)
            end
            if item.item.SetGradeNew then
                item.item:SetGradeNew(false)
            end
        end
    )
    local name = data.data.cfg.Name or data.data.cfg.name
    tb.aortext_name.text = _G.LangUtil.GetLangPackValue(name)
    tb.aortext_probNum.text = (data.per * 100) .. "%"
end

---点击奖励
function GodDrawAwardPreView:OnClickItem(item)
    local type = _G.StorageManager:GetInstance():CheckSidType(item.data.sid)
    if type == _G.StorageType.Card then
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.DrawView.Name)
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.GodDrawAwardPreView.Name)
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CommonIllustrationsH5View.Name,
            item.data.sid,
            function()
                _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.DrawView.Name)
                _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.GodDrawAwardPreView.Name)
            end
        )
    else
        require "CommonTipManager":GetInstance():OpenTip(item.gameObject, item.data.sid, item.data.uid)
    end
end

---按钮点击事件在这里派发
function GodDrawAwardPreView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_close" or name == "@_aorbtn_guanbi" then
        self:Close()
    end
end

return GodDrawAwardPreView
