local ActivitySynManager = require "ActivitySynManager"
---@class DrawFLORAwardView : UIBaseView	中文描述
---@field public go_table DrawFLORAwardView_GoTable GoTable
---@field itemList table<number,ItemViewBase>
local DrawFLORAwardView = _G.BaseClass("DrawFLORAwardView", _G.UIBaseView)

function DrawFLORAwardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    self.FlorClass = require("DrawModel"):GetInstance():GetFiveLinesOfRecruitment()

    self.aorimage_sliderRect = {self.go_table.aorimage_slider:GetRectTransformSize()}
    self.doneBtnColor = self.go_table.aortext_Done.color
end

---界面的入口函数
function DrawFLORAwardView:OnCreate()
    self.IsCanGet = false
    self.GetNum = 0
    if self.FlorClass.Info.award_times < 1 then
        self.go_table.aortext_slider.text = self.FlorClass.CurTimes .. "/" .. self.FlorClass.Info.cfg.first_num

        local w = 417 * self.FlorClass.CurTimes / self.FlorClass.Info.cfg.first_num
        if w > 417 then
            w = 417
        end
        self.go_table.aorimage_slider:SetRectTransformSize(w, 17)

        self.go_table.aortext_title.text =
            string.format(self.FlorClass.Info.cfg.desc, self.FlorClass.Info.cfg.first_num)

        if self.FlorClass.CurTimes >= self.FlorClass.Info.cfg.first_num then
            self.GetNum =
                math.floor((self.FlorClass.CurTimes - self.FlorClass.Info.cfg.first_num) / self.FlorClass.Info.cfg.num) +
                1
            self.IsCanGet = true
        end
    else
        local showTims =
            self.FlorClass.CurTimes - self.FlorClass.Info.cfg.first_num -
            (self.FlorClass.Info.award_times - 1) * self.FlorClass.Info.cfg.num

        self.go_table.aortext_slider.text = showTims .. "/" .. self.FlorClass.Info.cfg.num

        local w = 417 * showTims / self.FlorClass.Info.cfg.num
        if w > 417 then
            w = 417
        end
        self.go_table.aorimage_slider:SetRectTransformSize(w, 17)

        self.go_table.aortext_title.text = string.format(self.FlorClass.Info.cfg.desc, self.FlorClass.Info.cfg.num)

        if showTims >= self.FlorClass.Info.cfg.num then
            self.GetNum = math.floor(showTims / self.FlorClass.Info.cfg.num)
            self.IsCanGet = true
        end
    end
    self.rewards = {}
    if self.IsCanGet then
        for i = 1, self.GetNum do
            table.insert(self.rewards, {self.FlorClass.Info.cfg.award_sid, 1})
        end
        if self.GetNum > 1 then
            self.go_table.obj_num:SetActiveE(1)
            local num = self.GetNum > 9 and 9 or self.GetNum
            self.go_table.aorimage_num.SpriteName = "ui_js_zdl_txt_" .. num
        else
            self.go_table.obj_num:SetActiveE(0)
        end
        self.go_table.aorbtn_Done:SetGray(false)
    else
        self.rewards = {{self.FlorClass.Info.cfg.award_sid, 0}}
        self.go_table.obj_num:SetActiveE(0)
        self.go_table.aorbtn_Done:SetGray(true)
    end

    local storageManager = _G.StorageManager:GetInstance()
    storageManager:GetItemBaseViewNew(
        self.rewards[1],
        self.go_table.obj_award,
        _G.handler(self, self.OnItemShow)
    )
end

function DrawFLORAwardView:OnItemShow(item)
    item:ShowNumText(false)
    item.transform:SetLocalPosition(0, 0, 0)
    -- if item.go_table.itemLua.go_table.aorimage_element then
    --     item.go_table.itemLua.go_table.aorimage_element:SetActiveE(0)
    -- end
end

function DrawFLORAwardView:OnDestroy()
end

---按钮点击事件在这里派发
function DrawFLORAwardView:OnClickBtn(go)
    if go == self.go_table.aorbtn_Close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_Done then
        if self.IsCanGet then
            local msg = {}
            msg.activity_id = self.FlorClass.curActivityClass.activityID
            msg.num = self.GetNum
            require("FiveLinesOfRecruitmentNet"):GetInstance():GetAward(msg, _G.handler(self, self.FlorAwardCallBack))
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(340604)
        end
    end
end

function DrawFLORAwardView:FlorAwardCallBack(msg)
    if msg.ack == 1 then
        if msg.award then
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
        end
        require("DrawModel"):GetInstance():ChangeAwardTimes(self.GetNum)
        self:Close()

        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DrawView.Name)
        if view then
            view:UpdateFLOR()
        end
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.DrawFLOR.id)
    end
end

return DrawFLORAwardView
