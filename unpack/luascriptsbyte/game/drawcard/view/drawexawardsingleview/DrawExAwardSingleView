---@class DrawExAwardSingleView : UIBaseView	中文描述
---@field public go_table DrawExAwardSingleView_GoTable GoTable
---@field itemList table<number,ItemViewBase>
local DrawExAwardSingleView = _G.BaseClass("DrawExAwardSingleView", _G.UIBaseView)
local function_open_cfg = _G.ConfigManager.function_open_cfg
local functionId = 159


function DrawExAwardSingleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.aorimage_sliderRect = { self.go_table.aorimage_slider:GetRectTransformSize() }
    self.doneBtnColor = self.go_table.aortext_Done.color 
end

---界面的入口函数
function DrawExAwardSingleView:OnCreate()
    ---@type DrawModel 
    local drawModel = require("DrawModel"):GetInstance()
    ---@type number[][] 奖励二维数组{{sid,num},{sid,num}}
    local preaward, awardSid, spAwardSid = drawModel:GetAwardPre()
    self.spAwardSid = spAwardSid
    self.rewards = drawModel:GetTotalAward()
    if not self.rewards or #self.rewards <= 0 then
        self.rewards = { { awardSid, 0 } }
    end
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_yueguangcifudaoju,self.go_table.obj_effect)
    local storageManager = _G.StorageManager:GetInstance()
    storageManager:GetItemBaseViewNew(self.rewards[1], self.go_table.obj_award, _G.handler(self, self.OnItemShow))

    local progress = (drawModel.exit_num - drawModel.NextAward.LastTime) / drawModel.NextAward.num 
    local sliderx = progress * self.aorimage_sliderRect[1]
    sliderx = sliderx > self.aorimage_sliderRect[1] and self.aorimage_sliderRect[1] or sliderx
    self.go_table.aorimage_slider:SetRectTransformSize(sliderx, self.aorimage_sliderRect[2])
    local curnum = drawModel.exit_num - drawModel.NextAward.LastTime

    local finalPrice = require("MallManager"):GetInstance():GetFinalPrice(_G.ConfigManager.discrete_cfg[104515][1][2])

    local condition = _G.GameUtil.GetPriceContentByNum(finalPrice)

    local num = _G.GameUtil.GetPriceContentByNum(require("MallManager"):GetInstance():GetCashRmb() or 0)
    self.go_table.obj_tip:GetComponentE(_G.typeof(_G.CS.AorText)).text = _G.GetLangPackValue(90036300008, num, condition)

    if curnum >= drawModel.NextAward.num then
        self.go_table.aortext_slider.text = string.format("%d/%d", curnum, drawModel.NextAward.num)
    else
        self.go_table.aortext_slider.text = string.format("<color=#bd30303>%d</color>/%d", curnum, drawModel.NextAward.num)
    end

    if not _G.GlobalConditionManager.CheckConditionArrays(_G.ConfigManager.discrete_cfg[104515]) then
        self.go_table.aorbtn_Done:SetActiveE(0)
        self.go_table.obj_tip:SetActiveE(1)
        self.go_table.aorbtn_Goto:SetActiveE(1)
    else
        self.go_table.aorbtn_Done:SetActiveE(1)
        if self.rewards[1][2] > 0 then
            self.go_table.aortext_Done.color = self.doneBtnColor
            self.go_table.aorimage_Done.color = require("CardInfoManager").GetColorFromRGB("FFFFFF")
            self.go_table.aorbtn_Done:SetGray(false)
            self.go_table.obj_btnEffect:SetActiveE(1)
        else
            self.go_table.aortext_Done.color = require("CardInfoManager").GetColorFromRGB("434343")
            self.go_table.aorimage_Done.color = require("CardInfoManager").GetColorFromRGB("A9A9A9")
            self.go_table.aorbtn_Done:SetGray(true)
            self.go_table.obj_btnEffect:SetActiveE(0)
        end
        self.go_table.obj_tip:SetActiveE(0)
        self.go_table.aorbtn_Goto:SetActiveE(0)
    end

    self.go_table.aortext_CloseText:DOFade(0.2, 1):SetLoops(-1, CS.DG.Tweening.LoopType.Yoyo)
    drawModel:SetDrawRewardRedRead()
end

function DrawExAwardSingleView:OnItemShow(item)
    item:ShowNumText(false)
    item.gameObject:SetLocalPosition(0, 0, 0)
    if item.go_table.itemLua and item.go_table.itemLua.go_table.aorimage_element then
        item.go_table.itemLua.go_table.aorimage_element:SetActiveE(0)
    end
end

function DrawExAwardSingleView:OnDestroy()

end

---按钮点击事件在这里派发
function DrawExAwardSingleView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_Done then
        if self.rewards[1][2] > 0 then
            require("DrawModel"):GetInstance():GetDrawExAward(function() self:Close() end,
                self.rewards[1][1] == self.spAwardSid)
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(340604)
        end
    elseif go == self.go_table.aorbtn_Goto then
        _G.JumpManager:GetInstance():Jump(108001)
    end
end

return DrawExAwardSingleView
