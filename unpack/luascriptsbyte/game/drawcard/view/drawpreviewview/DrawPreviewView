    [1] = 90023200042,
    [2] = 90023200043,
    [3] = 90023200044,
    [4] = 90023200045,
}

function DrawPreviewView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.looplist2_team:InitListView(0, _G.handler(self, self.RefreshRenItem))
end

---界面的入口函数
function DrawPreviewView:OnCreate()
    self:FreshData()
    self.num = _G.table.count(self.heroRaceData)
    self.go_table.looplist2_team:SetListItemCount(4, true, false)
end

---按钮点击事件在这里派发
function DrawPreviewView:OnClickBtn(go)
    if go:GetName() == "@_aorbtn_CloseView" then 
        self:Close()
        _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
    end
end

function DrawPreviewView:FreshData()
    self.heroRaceData = {}
    local idTable = {301, 302, 303, 304}
    self.poolIdTable = {}
    for i = 1, #idTable do 
        self.poolIdTable[i] = {}
        local pool = _G.ConfigManager.lucky_roller_cfg[idTable[i]].pool
        -- for k, v in ipairs(pool) do 
        --     table.insert(self.poolIdTable[i], v[1])
        -- end
        local index = 1
        for j = #pool, 1, -1 do 
            --table.insert(self.poolIdTable[i], pool[j][1])
            self.poolIdTable[i][index] = pool[j][1]
            index = index + 1
        end 
        -- table.sort(
        --     self.poolIdTable[i],
        --     function(a, b)
        --         return _G.ConfigManager.lucky_pools_cfg[a].order > _G.ConfigManager.lucky_pools_cfg[b].order
        --     end
        -- )
    end 
    for i = 1, #self.poolIdTable do
        self.heroRaceData[i] = {}
        local allCards = {}
        local index = 1
        for k, v in ipairs(self.poolIdTable[i]) do 
            local poolCardCfg = _G.ConfigManager.lucky_pools_cfg[v].cards
            for k1, v1 in ipairs(poolCardCfg) do 
                allCards[index] = v1[1]
                index = index + 1
            end
            
        end 
        for k, v in ipairs(allCards) do 
            local groupIndex = math.ceil(k / 4)
            self.heroRaceData[i][groupIndex] = self.heroRaceData[i][groupIndex] or {}
            --table.insert(self.heroRaceData[i][groupIndex], v)
            self.heroRaceData[i][groupIndex][#self.heroRaceData[i][groupIndex] + 1] = v
        end
    end 
end 

--初始化item
function DrawPreviewView:RefreshRenItem(listView2, index)
    if index < 0 then
        return
    end
    local t_index = index + 1
    local item = listView2:NewListViewItem("$_obj_Item1")
    item:SetActiveE(1)

    self:SetItem(item, t_index)
    return item
end

--设置Item
function DrawPreviewView:SetItem(go, teamsid)
    if not self.cardItems then
        self.cardItems = {}
    end

    local item = self.cardItems[go:GetInstanceIDE()]
    if not item then
        item = _G.GetAutoGoTable(go)
        self.cardItems[go:GetInstanceIDE()] = item
    end

    local index = teamsid
    local data = self.heroRaceData[index]
    item.index = index
    item.data = data
    item.aorimage_Elements.SpriteName = ElementsIcon[index]
    item.aortext_Elements.text = _G.LangUtil.GetLangPackValue(ElementsName[index]) 
    -- item.obj_title:SetActiveE(0)
    -- item.obj_cards:SetActiveE(0)

    -- if not data or data == 1 or data == 2 or data == 3 then
    --     item.obj_title:SetActiveE(1)
    --     item.aorimage_pinjie.SpriteName = PingJie[data]
    --     item.aorimage_pinjie:SetNativeSize()
    -- else
    --     item.obj_cards:SetActiveE(1)
    --     self:SetCardItem(item, index)
    -- end
    for i = 1, #self.heroRaceData[index] do 
        self:SetCardItem(item, index, i)
    end
    _G.GameUtil.ReBuildRTF(go.gameObject)
    self.go_table.looplist2_team:OnItemSizeChanged(index - 1)
end

function DrawPreviewView:SetCardItem(go, index, groupIndex)
    local groupObj, obj
    go.cardList = go.cardList or {}
    if go.cardList[groupIndex] then 
        groupObj = go.cardList[groupIndex]
    else 
        obj = _G.InstantiateObject(self.go_table.obj_cards, go.transform)
        groupObj = _G.GetAutoGoTable(obj)  
        go.cardList[groupIndex] = groupObj
    end
    local cards_Item = {
        [1] = groupObj.obj_cardItem1,
        [2] = groupObj.obj_cardItem2,
        [3] = groupObj.obj_cardItem3,
        [4] = groupObj.obj_cardItem4,
    }
    for i = 1, CARD_ROW_COUNT do
        local sid, tb, data
        sid = self.heroRaceData[index][groupIndex][i]
        if not sid or sid == 0 then
            cards_Item[i]:SetActiveE(0)
        else
            cards_Item[i]:SetActiveE(1)
            data = _G.StorageManager:GetInstance():GetItemDataClass(sid, 1) 
            tb = _G.GetAutoGoTable(cards_Item[i])
            _G.AddViewBtnClick(tb.gameObject, _G.handlerbind(self, self.AddHunJiangBtn, data.sid))
            tb.aortext_name.text =_G.LangUtil.GetLangPackValue(data.cfg.Name)
            tb.rowIndex = groupIndex    --行index
            tb.index = i    --行index
            tb.data = data
            if not tb.cardItem then
                tb.cardItem = require "ItemCardAllView".New(tb.obj_card)
            end
            tb.cardItem:ShowCardData(data, nil, false)
        end
    end
end

function DrawPreviewView:AddHunJiangBtn(go, isOn, cardSid)
    require("CommonTipManager"):GetInstance():OpenTip(self.go_table.gameObject, cardSid)
end

return DrawPreviewView
