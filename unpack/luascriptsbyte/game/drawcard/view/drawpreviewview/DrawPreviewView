---每行显示多少个图鉴卡牌
local CARD_ROW_COUNT = 4
local ElementsIcon = {
    [1] = "ui_js_renlei_icon", --人类
    [2] = "ui_js_shouren_icon", --兽人
    [3] = "ui_js_jingling_icon", --精灵
    [4] = "ui_js_wangling_icon", --亡灵
    [5] = "ui_js_chuanqi_icon", --预留
    [6] = "ui_js_chuanqi_icon", --传奇
    [16] = "ui_js_multi16",   --人神
    [26] = "ui_js_multi26",   --兽神
    [36] = "ui_js_multi36",    --精神
    [46] = "ui_js_multi46"     --亡神
}
