---@class KaPaiJiangXuanZeView : UIBaseView	中文描述
---@field public go_table KaPaiJiangXuanZeView_GoTable GoTable
local KaPaiJiangXuanZeView = _G.BaseClass("KaPaiJiangXuanZeView", _G.UIBaseView)
--_G.KaPaiJiangXuanZeView = KaPaiJiangXuanZeView

local CS = _G.CS
local typeof = _G.typeof

function KaPaiJiangXuanZeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function KaPaiJiangXuanZeView:OnCreate(call)
    self.call = call
    self.poolData = _G.ConfigManager.discrete_cfg[100406][1]

    self.pool = {
        [1] = _G.GetAutoGoTable(self.go_table.obj_Thunder, _G.handler(self, self.OnClickThunder)),
        [2] = _G.GetAutoGoTable(self.go_table.obj_Wind, _G.handler(self, self.OnClickWind)),
        [3] = _G.GetAutoGoTable(self.go_table.obj_Water, _G.handler(self, self.OnClickWater)),
        [4] = _G.GetAutoGoTable(self.go_table.obj_Fire, _G.handler(self, self.OnClickFire)),
        [5] = _G.GetAutoGoTable(self.go_table.obj_Earth, _G.handler(self, self.OnClickEarth))
    }
    self.CurPool = 0
    self.Timers = {}
    self.TimersDa = {}
    self.PoolTime = {}
    self:DoneBtn()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.PropDrawUnlock,
        self.gameObject,
        function(tran)
            if tran then
                self.UnlockEff = tran
                tran:SetActiveE(0)
            end
            self:InitView()
        end
    )
end

---初始化界面
function KaPaiJiangXuanZeView:InitView()
    for i, v in pairs(self.pool) do
        self.PoolTime[i] = _G.TimeUtil.GetSixClockTimer()

        v.aorrawimage_BGXiao:SetActiveE(1)
        v.aorrawimage_Lock:SetActiveE(0)
        v.aorrawimage_BGDa:SetActiveE(0)
        if i == self.CurPool then
            v.aorrawimage_BGXiao:SetActiveE(0)
            v.aorrawimage_Lock:SetActiveE(0)
            v.aorrawimage_BGDa:SetActiveE(1)
        end
        v.gameObject:SetActiveE(1)
    end
end
---开场动画
function KaPaiJiangXuanZeView:XianShi()
    local tmp = self.go_table.obj_Thunder:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    local x, y = tmp:GetAnchorPosition()
    tmp:DOAnchorPos(_G.Vector2(x, 54), 0.2)
    tmp = self.go_table.obj_Fire:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    tmp:DOAnchorPos(_G.Vector2(x + 440 * 1, 54), 0.3)
    tmp = self.go_table.obj_Water:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    tmp:DOAnchorPos(_G.Vector2(x + 440 * 2, 54), 0.4)
    tmp = self.go_table.obj_Wind:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    tmp:DOAnchorPos(_G.Vector2(x + 440 * 3, 54), 0.5)
    tmp = self.go_table.obj_Earth:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    tmp:DOAnchorPos(_G.Vector2(x + 440 * 4, 54), 0.6)
end

---点击雷
function KaPaiJiangXuanZeView:OnClickThunder(go, IsOn)
    if 1 == self.CurPool or not IsOn then
        return
    end
    self:UnlockPool(1)
end
---点击风
function KaPaiJiangXuanZeView:OnClickWind(go, IsOn)
    if 2 == self.CurPool or not IsOn then
        return
    end
    self:UnlockPool(2)
end
---点击水
function KaPaiJiangXuanZeView:OnClickWater(go, IsOn)
    if 3 == self.CurPool or not IsOn then
        return
    end
    self:UnlockPool(3)
end
---点击火
function KaPaiJiangXuanZeView:OnClickFire(go, IsOn)
    if 4 == self.CurPool or not IsOn then
        return
    end
    self:UnlockPool(4)
end
---点击土
function KaPaiJiangXuanZeView:OnClickEarth(go, IsOn)
    if 5 == self.CurPool or not IsOn then
        return
    end
    self:UnlockPool(5)
end

----解锁池
function KaPaiJiangXuanZeView:UnlockPool(poolID)
    self.CurPool = poolID
    self:InitView()
    self:DoneBtn()
end
function KaPaiJiangXuanZeView:DoneBtn()
    local btntextcolor_Yes = require("CardInfoManager").GetColorFromRGB("414141")
    local hydColor_No = require("CardInfoManager").GetColorFromRGB("914801")

    self.go_table.aorbtn_Done:SetGray(self.CurPool == 0)
    if self.CurPool == 0 then
        self.go_table.aortext_PropRightNum.color = btntextcolor_Yes
    else
        self.go_table.aortext_PropRightNum.color = hydColor_No
    end
end
---按钮点击事件在这里派发
function KaPaiJiangXuanZeView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Done" then
        if self.CurPool == 0 then
            return
        end
        if self.call ~= nil then
            self.call(self.CurPool)
        end
        self:Close()
    elseif name == "@_aorbtn_BG" then
        self:Close()
    end
end

return KaPaiJiangXuanZeView
