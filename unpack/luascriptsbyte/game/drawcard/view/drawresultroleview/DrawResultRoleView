---@param skillID number _<0 为未解锁该技能
function DrawResultRoleView:SkillInfo(obj, skillID, index)
    local isShow = false
    if skillID > 0 then
        isShow = true
    else
        skillID = _G.math.abs(skillID)
    end
    local go_table = obj
    if go_table == nil then
        return
    end

    if go_table.SkillClick == nil then
        --go_table.aorbtn_skill.onClick:AddListener(_G.handlerbind(self, self.TipYe, index))
        go_table.SkillClick = true
    end

    local nowskillCfg = _G.ConfigManager.card_skills_cfg[skillID]
    if nowskillCfg == nil then
        go_table.gameObject:SetActiveE(0)
        return
    end

    if nowskillCfg then
        require("CardInfoManager").LoadRawImage(go_table.aorrawimage_skill, nowskillCfg.icon)
        --等级
        -- go_table.aortext_skilllevel.text = nowskillCfg.level

        go_table.aorimage_nuqi:SetActiveE(nowskillCfg.skill_pos == 1 and 1 or 0)
    else
        isShow = false
    end
    --锁隐藏
    go_table.obj_skilllock:SetActiveE(not isShow and 1 or 0)

    --等级显示
    go_table.aorimage_skilllevel:SetActiveE(0)
    -- --有该技能才显示技能图标
    go_table.gameObject:SetActiveE(1)
    return go_table.gameObject
end

---  判断品阶
function DrawResultRoleView:LiHuiNumber(int)
    self.go_table.obj_R:SetActiveE(0)
    self.go_table.obj_SR:SetActiveE(0)
    self.go_table.obj_SSR:SetActiveE(0)
    local obj = nil
    if int == 1 or int == 2 then
        self.go_table.obj_R:SetActiveE(1)
        obj = self.go_table.aorrawimage_BGOne
    elseif int == 3 then
        self.go_table.obj_SR:SetActiveE(1)
        obj = self.go_table.aorrawimage_BGTwo
    else
        self.go_table.obj_SSR:SetActiveE(1)
        obj = self.go_table.aorrawimage_BGThree
    end
    ---品阶对应的立绘item
    return _G.GetAutoGoTable(obj)
end

