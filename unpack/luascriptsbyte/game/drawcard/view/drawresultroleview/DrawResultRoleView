---界面的入口函数
function DrawResultRoleView:OnCreate(pool, call, star, isNotXin, GetNewCard)
    --回调方法
    self.call = call
    if _G.AppSetting.IsXzns then--星座女神解救女神功能特殊判断回调
        if _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.RescueGoddessView.Name) then
            local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.RescueGoddessView.Name)
            if view then
                self.call = view.CloseFun
            end
        end
        _G.GameUtil.SetUiHeXieMask(self.go_table, 3)
    end
    -- self.cfg = _G.ConfigManager.lucky_roller_cfg[pool]
    self.card_cfg = _G.ConfigManager.card_cfg
    self.card_level_cfg = _G.ConfigManager.card_level_cfg
    self.card_skills_cfg = _G.ConfigManager.card_skills_cfg
    local soundPath
    if _G.ConfigManager.card_show_cfg[pool.id] == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(
                string.format(
                    "cardId:%s 在card_show_cfg未找到",
                    tostring(pool.id)
                )
            )
        end
    else
        soundPath = _G.ConfigManager.card_show_cfg[pool.id].sound_enter
    end
    if star == nil then
        star = pool.Star
    end
    if isNotXin then
        self.go_table.aorimage_xinfu:SetActiveE(0)
        self.go_table.obj_white:SetActiveE(0)
    else
        self:JiShiTime()
        if _G.string.IsNullOrEmpty(soundPath) == false then
            local path = soundPath
            if path ~= nil then
                ---当前是否在播放
                self.LinesPath = path
                _G.AudioManager.PlayPathBackFun(path)
            end
        end
    end
    local msg = {}
    msg.sid = pool.id
    msg.cfg = _G.ConfigManager.card_cfg[msg.sid]
    msg.star = star
    local cardData = _G.CardData.New()
    cardData:ParseInitMsg(msg)
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.DrawResultView, self.go_table)
    self:XianShiLiHui(self.go_table, cardData)
    self.cardData=cardData
    self.GetNewCard = GetNewCard
    if _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name) and self.GetNewCard then
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name)
    end
    ---适配刘海屏
    local x, y, z = self.go_table.aorimage_new:GetLocalPosition()
    self.go_table.aorimage_new:SetLocalPosition(x, y + Woff, z)
end

function DrawResultRoleView:JiShiTime()
    self.longde = _G.TimerManager:GetInstance():GetTimer(
        15,
        self.LongdeTimerFunc,
        self,
        true,
        false,
        true
    )
    self.longde:Start()
end

function DrawResultRoleView:LongdeTimerFunc()
    self:CloseView()
    if self.call ~= nil then
        self.call()
    end
end

---立绘展示
function DrawResultRoleView:XianShiLiHui(headTrans, cardDatas)
    if cardDatas == nil then
        return
    end
    local cardData = _G.ConfigManager.card_cfg[cardDatas.sid]
    require("CardInfoManager"):GetInstance():SetElementsProfessionalSP(
        headTrans.aorimage_ShuXing,
        cardData.Elements_new,
        headTrans.aorimage_professionalIcon,
        cardData.Professional
    )
    headTrans.aortext_Name.text = cardDatas:GetName()
    headTrans.aorimage_Orderzi.SpriteName = require("CardInfoManager"):GetInstance():GetCardOrderZi(cardDatas.Grade)
    self.go_table.aorimage_Orderzi:ClearChildren()
    if cardDatas.Grade == 7 then 
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_ItemCardBodyBaseViewSP_bg,
            self.go_table.aorimage_Orderzi,
            function(trans)
                trans:SetLocalScaleXYZ(1)
            end
        )
    end
    --headTrans.aortext_name.text = _G.ConfigManager.language_package_cfg[_G.tonumber(cardData.Name)]
    headTrans.aorimage_ShuXing.SpriteName = ElementsIcon[require("CardInfoManager"):GetInstance():GetElementsKey(cardData.Elements_new)]
    headTrans.aorrawimage_guang:LoadImage(Grade[cardDatas.Grade].BG)
    if AppSetting.IsXzns then
        headTrans.aorrawimage_bottombg:LoadImage(Grade[cardDatas.Grade].Bottombg)
    end
    local SpriteName
    for i = 1, 5 do
        SpriteName = require("CardInfoManager"):GetInstance():GetHuoSpriteName(cardDatas.star, i)
        if SpriteName then
            headTrans["aorimage_star" .. i].SpriteName = SpriteName
        end
        headTrans["aorimage_star" .. i]:SetActiveE(SpriteName and 1 or 0)
    end

    headTrans.obj_cardSpine:ClearChildren()
    headTrans.obj_cardSpine:SetLocalScaleXYZ(cardData.size8)
    local pos = cardData.pos_portrait8
    headTrans.obj_cardSpine:SetLocalPosition(pos[1], pos[2], pos[3])
    local showData = _G.ConfigManager.card_show_cfg[cardDatas.sid]
    require("CardInfoManager"):GetInstance().GetRole(
        cardData.ModelPathHi,
        _G.ePoolType.Temporary,
        headTrans.obj_cardSpine,
        nil,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            if _G.AppSetting.IsXzns then
                local spineCfg = _G.ConfigManager.card_show_cfg[cardDatas.sid] or _G.ConfigManager.skin_cfg[cardDatas.sid]
                local idle = spineCfg.display_idle[1]
                _G.GameUtil.SetCardUiSpineAnimation(trans, idle, true)
            end
            self:PlaySound(showData.audio_enter, showData.sound_enter)
        end
    )
    self:JiNeng(cardData.id, cardData.Order)
    if _G.UIUtils.IsUseBattleSpine(_G.UseBattleSpine.DrawResultView) then
        headTrans.aorrawimage_portrait:RemoveAllChildren()
        headTrans.aorrawimage_portrait.color = _G.Color.New(1, 1, 1, 0)
        _G.PoolsManager:GetInstance():Spawn(
                _G.UIUtils.GetBattleSpine(cardData),
                _G.ePoolType.Temporary,
                headTrans.aorrawimage_portrait,
                function(trans)
                    trans:SetLocalScaleXYZ(cardData.size4)
                    trans:SetLocalPosition(0, 0, 0)
                end
        )
    else
        headTrans.aorrawimage_portrait:LoadImage(
                cardData.Portrait,
                function()
                    if not _G.IsNil(headTrans) then
                        headTrans.aorrawimage_portrait:SetNativeSize()
                    end
                end
        )
        headTrans.aorrawimage_portrait1:LoadImage(
                cardData.Portrait,
                function()
                    if not _G.IsNil(headTrans) then
                        headTrans.aorrawimage_portrait1:SetNativeSize()
                        local pos = cardData.pos_portrait4
                        headTrans.aorrawimage_portrait1:SetLocalPosition(pos[1], pos[2], pos[3])
                        headTrans.aorrawimage_portrait1:SetLocalScaleXYZ(cardData.Size)
                        headTrans.aorrawimage_portrait1.color = _G.Color.New(1, 1, 1, 25 / 255)
                    end
                end
        )
    end
    headTrans.aorimage_ShuXing1.SpriteName = ElementsIcon1[cardData.Elements]
    if _G.AppSetting.IsXzns then
        headTrans.aortext_Professional1.text = ""
        headTrans.aortext_Professional2.text = ""
    else
        headTrans.aortext_Professional1.text = _G.LangUtil.GetLangPackValue(ProfessionalCNTxt[cardData.Professional], 48)
        headTrans.aortext_Professional2.text = _G.LangUtil.GetLangPackValue(ProfessionalENTxt[cardData.Professional])
    end
    if GameUtil.GetUsedLang() == "zh-CN" then
        headTrans.aortext_Professional2:SetActiveE(1)
    else
        headTrans.aortext_Professional2:SetActiveE(0)
    end
    local posText
    local posId = cardData.card_position1
    if posId > 0 then
        posText = _G.GetLangPackValue(posId)
    end
    posId = cardData.card_position2
    if posId > 0 then
        if _G.AppSetting.IsXzns then
            posText = posText .. "," .. _G.GetLangPackValue(posId)
        else
            posText = posText .. "/" .. _G.GetLangPackValue(posId)
        end
    end

    if _G.AppSetting.IsXzns then
        headTrans.aortext_ProfessionalDes.text = _G.LangUtil.GetLangPackValue(ProfessionalCNTxt[cardData.Professional],
            48) .. "," .. posText
    else
        headTrans.aortext_ProfessionalDes.text = posText
    end
    self.go_table.obj_coreEffObj1:SetActiveE(cardDatas.Grade >= 5 and 1 or 0)
    self.go_table.obj_coreEffObj2:SetActiveE(cardDatas.Grade >= 5 and 1 or 0)
    if not self.coreEff1 then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_hexing,
            self.go_table.obj_coreEffObj1,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                self.coreEff1 = trans
            end
        )
    end
    if not self.coreEff2 then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_hexinyinxionghuodei,
            self.go_table.obj_coreEffObj2,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                self.coreEff2 = trans
                self.coreEff2:SetLocalScale(1, _G.CS.UnityEngine.Screen.height / 1600, 1)
                self.coreEff2:SetLocalPosition(0, -30, 0)
            end
        )
    end
    if cardDatas.Grade < 5 then
        headTrans.aorimage_core:SetActiveE(0)
    else
        headTrans.aorimage_core:SetActiveE(1)

    end
    local icon = require("CardInfoManager"):GetInstance():GetCardGradeFlag1(cardDatas.Grade, cardDatas.sid)
    if icon then
        headTrans.aorimage_core.SpriteName = icon
    end
end

function DrawResultRoleView:PlaySound(audioCfg, soundPath)
    self:ClearSound()
    self.ActionAudioArr = {}
    if _G.string.IsNullOrEmpty(audioCfg) == false then
        local path = audioCfg
        if path ~= nil then
            self.ActionAudioArr[path] = true
            _G.AudioManager.Dialogue_PlayPath(path)
        end
    end
    if _G.string.IsNullOrEmpty(soundPath) == false then
        local path = soundPath
        if path ~= nil then
            self.LinesPath = path
            _G.AudioManager.PlayPathBackFun(path)
        end
    end
end

function DrawResultRoleView:ClearSound()
    if self.ActionAudioArr ~= nil then
        for path, value in pairs(self.ActionAudioArr) do
            _G.AudioManager.StopSoundByPath(path)
            self.ActionAudioArr[path] = nil
        end
    end
    if self.LinesPath ~= nil then
        _G.AudioManager.Dialogue_StopPath(self.LinesPath)
    end
end

