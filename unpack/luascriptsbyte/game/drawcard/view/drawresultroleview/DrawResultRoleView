---按钮点击事件在这里派发
function DrawResultRoleView:OnClickBtn(go, IsOn)
    local name = go:GetName()
    if name == "@_aorbtn_BG" then
        self:CloseView()
        if self.longde ~= nil then
            self.longde:Stop()
        end
        if self.call ~= nil then
            self.call()
        end
    end
end

function DrawResultRoleView:CloseView()
    if self.LinesPath ~= nil then
        _G.AudioManager.Dialogue_StopPath(self.LinesPath)
        self.LinesPath = nil
    end

    ---taptap评论跳转
    if self.cardData.Grade and self.cardData.Grade>=4  and  require("DrawModel"):GetInstance().IsShowTapTapDiscuss  then
        require("DrawModel"):GetInstance().IsShowTapTapDiscuss=false
        local creatroletime= _G.PlayerModel:GetInstance():GetCreateRoleTime()
        local day=_G.TimeUtil.GetIntervalDayBySix1(creatroletime,_G.TimeUtil.GetServerUnixTime())+1
        _G.PlayerPrefsManager.SetInt("firstGetS+Card"..day,1)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GoToTaptapDiscussView.Name)
    end
    self.cardData = IllustrationModel:GetPurpleCardData()
    if self.longde ~= nil then
        self.longde:Stop()
    end
    if self.index >= #self.cardData then
        IllustrationModel:CleanPurpleCardData()
        if _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name) and self.GetNewCard then
            _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name)
        end
        self:Close()
    else
        self.index = self.index + 1
        self:UpdataView()
    end
end

function DrawResultRoleView:UpdataView()
    self:OnCreate(self.cardData[self.index], nil, self.cardData[self.index].Star, false, true)
end

function DrawResultRoleView:Dispose()
    if self.longde ~= nil then
        self.longde:Stop()
    end
end

return DrawResultRoleView
