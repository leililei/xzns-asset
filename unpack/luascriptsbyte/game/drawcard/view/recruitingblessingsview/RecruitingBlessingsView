local RecruitingBlessingsModel = require "RecruitingBlessingsModel"

---@class RecruitingBlessingsView : UIBaseView	中文描述
---@field public go_table RecruitingBlessingsView_GoTable GoTable
---@field cfg card_cfg
local RecruitingBlessingsView = _G.BaseClass("RecruitingBlessingsView", _G.UIBaseView)

local progress = {
    [1] = 195,
    [2] = 183
}

function RecruitingBlessingsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function RecruitingBlessingsView:OnCreate(callback)
    self.call = callback
    _G.PlayerPrefsManager.SetInt("RecruitingBlessingsModel", 1)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RecruitingBlessings.id)

    self.cfg = _G.ConfigManager.lucky_bless_cfg
    ---道具选着id
    self.cardId = 1
    --道具选中id，默认0就是未选中
    self.cardIS = 1
    self.JiangChi = 120
    self.go_table.scrollloopvectical_CardBag:InitItemData(0, _G.handler(self, self.RefreshRenItem))

    --隐藏进度
    --self.Isprogress = 0.8
    self:CardIs()
    self:Progress()
    local panduan = RecruitingBlessingsModel:GetInstance():WishPanduan(self.cardId, self.cardIS)
    self.go_table.aorbtn_queding:SetGray(panduan)
end
---列表数据显示
function RecruitingBlessingsView:RefreshRenItem(index, obj)
    if index < 0 then
        return
    end
    local x = index + 1

    local cardData = self.cfg[self.cardId].bonus[x]
    local panduan = RecruitingBlessingsModel:GetInstance():WishPanduan(self.cardId, x)
    --判断当前卡牌列表是否选取
    local tb_i = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.DianJiBtn, x, panduan))

    if x == self.cardIS then
        tb_i.aorimage_xuanzhong:SetActiveE(1)
    else
        tb_i.aorimage_xuanzhong:SetActiveE(0)
    end
    if panduan then
        tb_i.obj_hp:SetActiveE(1)
    else
        tb_i.obj_hp:SetActiveE(0)
    end
    tb_i.obj_node:RemoveAllChildren()
    self:ItemNew(cardData[1], panduan, cardData[2], tb_i.obj_node)
    return tb_i
end

---物品内容选中显示
function RecruitingBlessingsView:ItemNew(Sid, isGou, number, Parent)
    _G.StorageManager:GetInstance():GetItemBaseView(
        Sid,
        number,
        Parent,
        function(item)
            if self:IsNil() then
                _G.DestroyObject(item.gameObject)
                return
            end
            item.gameObject:SetLocalScaleXYZ(1)
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
            item:SetGou(isGou)
            if item.go_table.aorrawimage_Icon then
                item.go_table.aorrawimage_Icon:SetGray(isGou)
            end
            if item.go_table.aorimage_Color then
                item.go_table.aorimage_Color:SetGray(isGou)
            end
            item.gameObject:SetLocalPosition(0, 0, 0)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end,
        function()
        end
    )
end

function RecruitingBlessingsView:DianJiBtn(go, _, cardData, panduan)
    if panduan then
        return
    end
    self.go_table.aorbtn_queding:SetGray(panduan)

    self.cardIS = cardData
    self:CardIs(self.cardId)
end

--初始化
---设置当前选中id
function RecruitingBlessingsView:CardIs(id)
    local wish_card = RecruitingBlessingsModel:GetInstance().wish_card

    if id == nil then
        for key, value in pairs(wish_card) do
            if value.isGet == false then
                self.cardId = key
            end
            if key == self.cardId then
                self.cardIS = value.award
                self.JiangChi = value.id
            end
        end
    else
        for key, value in pairs(wish_card) do
            if key == id then
                self.cardId = key

                if self.cardIS == 0 then
                    self.cardIS = value.award
                end
                self.JiangChi = value.id
            end
        end
    end
    local cardData = self.cfg[self.cardId].bonus
    self.go_table.scrollloopvectical_CardBag:UpdateCount(#cardData)
    self.start_time = RecruitingBlessingsModel:GetInstance().start_time
    if self.timer == nil then
        self.timer = _G.TimerManager:GetInstance():GetTimer(100, self.TimerUpdata, self, false, false, true)
        self.timer:Start()
    end
    self:TimerUpdata()
    self:TextNew()
    self:ObjItemNew()
end

--剩余时间刷新
function RecruitingBlessingsView:TimerUpdata()
    self.bet = _G.ConfigManager.discrete_cfg[100408][1][1]
    local start_time = RecruitingBlessingsModel:GetInstance().start_time

    local time = self.bet * 86400 + start_time
    local S = time - _G.TimeUtil.GetServerUnixTime()
    local timeStr = _G.TimeUtil.TranslateSecond(S)
    if timeStr.day >= 1 then
        timeStr = _G.GetLangPackValue(90022100001, timeStr.day, timeStr.hour)
    elseif timeStr.hour > 1 then
        -- body
        timeStr = timeStr.hour .. _G.GetLangPackValue(90022500435)
    else
        timeStr = 1 .. _G.GetLangPackValue(90022500435)
    end
    self.go_table.aortext_timer.text = _G.GetLangPackValue(90030300006, timeStr)
end

--物品刷新
function RecruitingBlessingsView:ObjItemNew()
    local wish_card = RecruitingBlessingsModel:GetInstance().wish_card
    local GetScore = RecruitingBlessingsModel:GetInstance():GetScore()

    for key, value in pairs(wish_card) do
        --判断当前卡牌列表是否选取
        local tb_i = _G.GetAutoGoTable(self.go_table["obj_TouXiangk_" .. key], _G.handlerbind(self, self.LingQu, key))
        tb_i.obj_Item:RemoveAllChildren()

        if key == self.cardId then
            tb_i.aorimage_xuanzhong:SetActiveE(1)
        else
            tb_i.aorimage_xuanzhong:SetActiveE(0)
        end
        if RecruitingBlessingsModel:GetInstance():chooseIS(key) then
            tb_i.aorimage_QieHuan:SetActiveE(0)
            tb_i.aorbtn_QieHuanS:SetActiveE(1)
            tb_i.aorbtn_XuanZhe:SetActiveE(0)
        else
            if value.isGet then
                tb_i.aorimage_QieHuan:SetActiveE(0)
                tb_i.aorbtn_QieHuanS:SetActiveE(1)
            else
                tb_i.aorimage_QieHuan:SetActiveE(1)
                tb_i.aorbtn_QieHuanS:SetActiveE(1)
            end
            if GetScore >= value.id and not value.isGet then
                tb_i.aorbtn_XuanZhe:SetActiveE(1)
                tb_i.aorbtn_QieHuanS:SetActiveE(0)
            else
                tb_i.aorbtn_XuanZhe:SetActiveE(0)
                tb_i.aorbtn_QieHuanS:SetActiveE(1)
            end
            local cardData = self.cfg[key].bonus[value.award]
            self:ItemNew(cardData[1], value.isGet, cardData[2], tb_i.obj_Item)
        end
    end
end
function RecruitingBlessingsView:LingQu(go, _, cardData)
    local name = go:GetName()
    local GetScore = RecruitingBlessingsModel:GetInstance():GetScore()
    local wish_card = RecruitingBlessingsModel:GetInstance().wish_card
    if name == "@_aorbtn_XuanZhe" then
        if
            wish_card[cardData].id <= GetScore and not wish_card[cardData].isGet and
                not RecruitingBlessingsModel:GetInstance():chooseIS(cardData)
         then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                2505,
                nil,
                function()
                    RecruitingBlessingsModel:GetInstance():WishAwardIs(
                        cardData,
                        function()
                            self.cardId = cardData
                            self.cardIS = 0
                            self:CardIs(self.cardId)
                        end
                    )
                end
            )
        else
        end
    elseif name == "@_aorbtn_QieHuan" or name == "@_aorbtn_QieHuanS" then
        if cardData == self.cardId then
            if
                wish_card[cardData].id <= GetScore and RecruitingBlessingsModel:GetInstance():chooseIS(cardData) and
                    not wish_card[cardData].isGet
             then
                _G.PopWindowManager:GetInstance():ShowAllTips(2506)
            end
            return
        else
            self.cardId = cardData

            self.cardIS = 0

            self:CardIs(self.cardId)
        end
    end
end

--进度展示
function RecruitingBlessingsView:Progress()
    local wish_card = RecruitingBlessingsModel:GetInstance().wish_card
    local GetScore = RecruitingBlessingsModel:GetInstance():GetScore()
    local num = 0
    -- local isProgress = 1
    if GetScore > 0 then
        if wish_card[1].id >= GetScore then
            local progres = GetScore / wish_card[1].id
            -- if wish_card[1].id == GetScore then
            --     isProgress = 0
            -- end
            num = progres * progress[1] + 20
        else
            local zhi1 = GetScore - wish_card[1].id
            local zhi2 = wish_card[2].id - wish_card[1].id
            local bai = zhi1 / zhi2
            if bai > 1 then
                bai = 1
            end
            -- if bai > self.Isprogress or bai < 0.1 then
            --     isProgress = 0
            -- end
            num = bai * progress[2] + progress[1] + 20
        end
        if GetScore > wish_card[2].id * 2 then
            GetScore = wish_card[2].id * 2
        end
        self.go_table.aortext_jdNew.text = GetScore
        self.go_table.aortext_jdNew:SetActiveE(1)
    else
        self.go_table.aortext_jdNew:SetActiveE(0)
    end

    self.go_table.aortext_jd.text = wish_card[1].id
    self.go_table.aortext_jdX.text = wish_card[2].id
    self.go_table.aorimage_jd:SetRectTransformSize(num, 20)
end

--文本刷新
function RecruitingBlessingsView:TextNew()
    if self.cardIS == 0 then
        self.go_table.aortext_Name:SetActiveE(0)
        self.go_table.aortext_Num:SetActiveE(0)
        self.go_table.aortext_Text:SetActiveE(0)
    else
        self.go_table.aortext_Name:SetActiveE(1)
        self.go_table.aortext_Num:SetActiveE(1)
        self.go_table.aortext_Text:SetActiveE(1)
        local cardData = self.cfg[self.cardId].bonus[self.cardIS][1]
        self.go_table.aortext_Name.text = _G.StorageManager:GetInstance():GetItemName(cardData)
        self.go_table.aortext_Num.text =
            _G.ConfigManager.language_package_cfg[90030300002] ..
            (_G.StorageManager:GetInstance():GetItemCountBySid(cardData) or 0)
        local data = _G.StorageManager:GetInstance():GetStorageItemData(cardData)
        self.go_table.aortext_Text.text = _G.ConfigManager.language_package_cfg[data.Cfg.Describe]
    end
end

---按钮点击事件在这里派发
function RecruitingBlessingsView:OnClickBtn(go, IsOn)
    local name = go:GetName()
    if name == "@_aorbtn_close" or name == "@_aorbtn_close2" then
        if self.timer then
            self.timer:Stop()
        end
        self:Close()
    elseif name == "@_aorbtn_queding" then
        local wish_card = RecruitingBlessingsModel:GetInstance().wish_card
        if self.cardIS == 0 or wish_card[self.cardId].isGet then
            return
        elseif self.cardIS == wish_card[self.cardId].award and self.cardIS ~= 1 then
            return
        end
        self.go_table.aorbtn_queding:SetGray(true)

        RecruitingBlessingsModel:GetInstance():WishAward(
            self.cardId,
            self.cardIS,
            function()
                self:CardIs(self.cardId)
            end
        )
    elseif name == "@_aorbtn_XiangQing" then
        if self.cardIS == 0 then
            return
        end
        local cardData = self.cfg[self.cardId].bonus[self.cardIS]

        require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, cardData[1])
    elseif name == "@_aorbtn_Tips" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 75)
    end
end
return RecruitingBlessingsView
