---@class DrawFloatTipsView : UIBaseView	中文描述
---@field public go_table DrawFloatTipsView_GoTable GoTable
local DrawFloatTipsView = _G.BaseClass("DrawFloatTipsView", _G.UIBaseView)

function DrawFloatTipsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function DrawFloatTipsView:OnCreate(exchangeId, drawTimes, callback, extraList)
    self.callback = callback
    local exchange_cfg = _G.ConfigManager.exchange_cfg[exchangeId]
    self.extraList = extraList or {exchange_cfg.get_item[2]}
    local extra = self.extraList[1]
    self:GetAwardFloatTip(extra, drawTimes)
end
function DrawFloatTipsView:AddExtraList(extra)
    table.insert(self.extraList, extra)
end
function DrawFloatTipsView:GetAwardFloatTip(data)
    if self.curTips then
        _G.DestroyObject(self.curTips)
        self.curTips = nil
    end
    if self.upTween then
        self.upTween:Kill(true)
        self.upTween = nil
    end
    if self.fadeTween then
        self.fadeTween:Kill(true)
        self.fadeTween = nil
    end
    if self.extraList[1] then 
        table.remove(self.extraList, 1)
    end
    local _obj = _G.GameObject()
    _obj:SetParentE(self.transform)
    local canvasGrounp = _obj:AddComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup))
    _G.PoolsManager:GetInstance():Spawn(
        "UIH5/Draw/DrawTipItem",
        _G.ePoolType.Temporary,
        self.transform,
        function(trans)
            if _G.IsNil(trans) then
                _G.DestroyObject(trans)
               return
            end
            self.curTips = _obj

            local tb = _G.GetAutoGoTable(trans)
            local iconPath = _G.StorageManager:GetInstance():GetItemIcon(data[1])
            tb.aorrawimage_icon:SetActiveE(0)
            tb.aorrawimage_icon:LoadImage(
                iconPath,
                function(image)
                    if _G.IsNil(tb.aorrawimage_icon) then
                       return
                    end

                    image:SetActiveE(1)
                end
            )
            tb.aortext_content.text = _G.StorageManager:GetInstance():GetItemName(data[1]) .. data[2]
            trans:SetAnchorPosition(0, 0)
            trans:SetParentE(_obj)
            self.upTween, self.fadeTween = _G.CommonUIEffect:GetInstance():UpAndFade(
                _obj,
                130,
                0.2,
                0.3,
                canvasGrounp,
                0.2,
                function()
                    if not _G.IsNil(_obj) then
                        _G.DestroyObject(_obj)
                    end
                    if self.upTween then
                        self.upTween:Kill(true)
                        self.upTween = nil
                    end
                    if self.fadeTween then
                        self.fadeTween:Kill(true)
                        self.fadeTween = nil
                    end
                    self.curTips = nil
                    self:ShowEnd()
                end
            )
        end
    )
end

function DrawFloatTipsView:ShowEnd()
    if self.callback then
        self.callback()
    end
    if self.extraList and self.extraList[1] then 
        local extra = self.extraList[1]
        self:GetAwardFloatTip(extra)
        return 
    end
    self:Close()
end

function DrawFloatTipsView:Dispose()
    if self.upTween then
        self.upTween:Kill(true)
        self.upTween = nil
    end
    if self.fadeTween then
        self.fadeTween:Kill(true)
        self.fadeTween = nil
    end
end

return DrawFloatTipsView