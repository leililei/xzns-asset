---@class TicketExchangeView : UIBaseView	中文描述
---@field public go_table TicketExchangeView_GoTable GoTable
local TicketExchangeView = _G.BaseClass("TicketExchangeView", _G.UIBaseView)
--_G.TicketExchangeView = TicketExchangeView

local CS = _G.CS
local typeof = _G.typeof

local itemOneSid = 10001
local itemTenSid = 10002
local itemSid = 203020100
local tipsID = 340301
local LanguageID = 90021000003

function TicketExchangeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param data table<oneSid,TenSid,itemSid>
function TicketExchangeView:OnCreate(data, call)
    self.call = call
    itemOneSid = data and data.oneSid or 10001
    itemTenSid = data and data.tenSid or 10002
    itemSid = data and data.itemSid or 203020100
    self.One = _G.GetAutoGoTable(self.go_table.obj_One, _G.handlerbind(self, self.OnClickBuy, 1))
    self.Ten = _G.GetAutoGoTable(self.go_table.obj_Ten, _G._G.handlerbind(self, self.OnClickBuyTen, 10))
    self:InitView()
end

---初始化界面
function TicketExchangeView:InitView()
    local needMaterial = _G.ConfigManager.exchange_cfg[itemOneSid].need_item[1]
    local MaterialData = _G.StorageManager:GetInstance():GetItemDataClassByCfg(needMaterial)
    local str = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.ResProp, _G.ResPropID.Diamond)
    local itemCfg = _G.ConfigManager.item_cfg[itemSid]
    if str >= MaterialData.count then
        str = "<color=#FFFFFF>" .. _G.GameUtil.NumberToUnitStr(str) .. "</color>"
        self.OneCheck = true
    else
        str = "<color=#FF0C00>" .. _G.GameUtil.NumberToUnitStr(str) .. "</color>"
        self.OneCheck = false
    end
    self.One.aortext_ItemNum.text = str .. "/" .. needMaterial[2]
    self.One.aorrawimage_Material:LoadImage(MaterialData.Icon)
    self.One.aorimage_Grade.SpriteName = _G.itemColorIconName[itemCfg.Quality]
    self.One.aorrawimage_Icon:LoadImage(
        itemCfg.Icon,
        function(image)
            if image then
                image:SetNativeSize()
            end
        end
    )
    self.One.aortext_ItemName.text = _G.LangUtil.GetLangPackValue(itemCfg.Name) .. " x1"

    needMaterial = _G.ConfigManager.exchange_cfg[itemTenSid].need_item[1]
    MaterialData = _G.StorageManager:GetInstance():GetItemDataClassByCfg(needMaterial)
    str = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.ResProp, _G.ResPropID.Diamond)
    if str >= MaterialData.count then
        str = "<color=#FFFFFF>" .. _G.GameUtil.NumberToUnitStr(str) .. "</color>"
        self.TenCheck = true
    else
        str = "<color=#d62828>" .. _G.GameUtil.NumberToUnitStr(str) .. "</color>"
        self.TenCheck = false
    end
    self.Ten.aortext_ItemNum.text = str .. "/" .. needMaterial[2]
    self.Ten.aorrawimage_Material:LoadImage(MaterialData.Icon)
    self.Ten.aorimage_Grade.SpriteName = _G.itemColorIconName[itemCfg.Quality]
    self.Ten.aorrawimage_Icon:LoadImage(
        itemCfg.Icon,
        function(image)
            if image then
                image:SetNativeSize()
            end
        end
    )
    self.Ten.aortext_ItemName.text = _G.LangUtil.GetLangPackValue(itemCfg.Name) .. " x10"
end

---点击购买卷
function TicketExchangeView:OnClickBuy()
    if self.OneCheck then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ItemBuyView.Name,
            itemOneSid,
            function()
                self:Exit()
            end
        )
    else
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.GetItemWayView.Name,
            _G.ConfigManager.exchange_cfg[itemOneSid].need_item[1][1],
            function()
                self:InitView()
            end
        )
    end
end

---点击购买10张卷
function TicketExchangeView:OnClickBuyTen(go, isOn)
    if self.TenCheck then
        local str =
            string.format(
            _G.LangUtil.GetLangPackValue(LanguageID),
            _G.ConfigManager.exchange_cfg[itemTenSid].need_item[1][2]
        )
        _G.PopWindowManager:GetInstance():ShowAllTips(
            tipsID,
            str,
            function()
                _G.StorageManager:GetInstance():PropBuy(
                    itemTenSid,
                    1,
                    1,
                    function()
                        self:Exit()
                    end
                )
            end
        )
    else
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.GetItemWayView.Name,
            _G.ConfigManager.exchange_cfg[itemTenSid].need_item[1][1],
            function()
                self:InitView()
            end
        )
    end
end

---按钮点击事件在这里派发
function TicketExchangeView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:Exit()
    end
end

---界面退出
function TicketExchangeView:Exit()
    if self.call then
        self.call()
    end
    self:Close()
end

return TicketExchangeView
