local DrawModel = require("DrawModel")

---@class PropDrawSelectView : UIBaseView	中文描述
---@field public go_table PropDrawSelectView_GoTable GoTable
local PropDrawSelectView = _G.BaseClass("PropDrawSelectView", _G.UIBaseView)

function PropDrawSelectView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function PropDrawSelectView:OnCreate(curPool, call)
    self.call = call
    self.pool = {
        [_G.CardPoolID.Thunder] = _G.GetAutoGoTable(
            self.go_table.obj_raceItem1,
            _G.handlerbind(self, self.OnClickRaceItem, _G.CardPoolID.Thunder)
        ),
        [_G.CardPoolID.Wind] = _G.GetAutoGoTable(
            self.go_table.obj_raceItem2,
            _G.handlerbind(self, self.OnClickRaceItem, _G.CardPoolID.Wind)
        ),
        [_G.CardPoolID.Water] = _G.GetAutoGoTable(
            self.go_table.obj_raceItem3,
            _G.handlerbind(self, self.OnClickRaceItem, _G.CardPoolID.Water)
        ),
        [_G.CardPoolID.Fire] = _G.GetAutoGoTable(
            self.go_table.obj_raceItem4,
            _G.handlerbind(self, self.OnClickRaceItem, _G.CardPoolID.Fire)
        )
    }
    self.curPool = curPool
    self:InitAwardTip()
    self:RefreshItem()
end

---加载五行招募额外奖励信息
function PropDrawSelectView:InitAwardTip()
    local sid, num = require("DrawModel"):GetInstance():GetWuxingAwardInfos()
    if sid <= 0 or num <= 0 then
        return
    end
    local icon = _G.StorageManager:GetInstance():GetItemIcon(sid)
    self.go_table.aortext_num.text = _G.GetLangPackValue(90000011147, num)
    self.go_table.aorrawimage_icon1:LoadImage(icon)
end

function PropDrawSelectView:RefreshItem()
    for id, v in pairs(self.pool) do
        v.obj_select:SetActiveE(self.curPool == id and 1 or 0)
    end
end

---点击种族item
function PropDrawSelectView:OnClickRaceItem(go, IsOn, id)
    if id == self.curPool or not IsOn then
        return
    end
    self.curPool = id
    require("DrawModel"):GetInstance().PropPoolToday = id
    _G.PlayerPrefsManager.SetInt("PropPoolID", id)
    _G.PlayerPrefsManager.SetInt("PropServerUnixTime", _G.TimeUtil.GetServerUnixTime())
    _G.PlayerPrefsManager.SetInt("PropSixClockTimer", _G.TimeUtil.GetSixClockTimer())
    self:RefreshItem()
    local drawView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DrawView.Name)
    if drawView then 
        drawView:UpdatePropView()
    end
    self:Close()
end

---按钮点击事件在这里派发
function PropDrawSelectView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_close" then
        if self.call then
            self.call(self.curPool)
        end
        self:Close()
    end
end

function PropDrawSelectView:EscClose()
    if self.call then
        self.call(self.curPool)
    end
    self:Close()
end
return PropDrawSelectView
