local base = require("BaseGameNet")
---@class FiveLinesOfRecruitmentNet : BaseGameNet	通信协议
local FiveLinesOfRecruitmentNet = _G.BaseClass("FiveLinesOfRecruitmentNet", base)

---@return FiveLinesOfRecruitmentNet FiveLinesOfRecruitmentNet
function FiveLinesOfRecruitmentNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---五行招募累计-领取奖励
---@param pbData activity_wuxing_draw.c2s_wuxing_award PB数据
---@param callback function 完成回调
function FiveLinesOfRecruitmentNet:GetAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_module_port_wuxing_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.CardCall))
    self.Call[port] = callback
end

---请求回调 通用 返回 ack 字符Call
---@param port number 流水号Card
---@param data table 返回PB数据
---@param error string 错误信息
function FiveLinesOfRecruitmentNet:CardCall(port, data, error)
    if error then
        return
    end
    --TODO 写通用数据解析，没有需要做的记得删除TODO
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end
---@type FiveLinesOfRecruitmentNet
return FiveLinesOfRecruitmentNet
