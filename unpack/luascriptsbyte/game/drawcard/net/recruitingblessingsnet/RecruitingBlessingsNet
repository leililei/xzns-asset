require "BaseGameNet"
require "net_map"

---@class RecruitingBlessingsNet : BaseGameNet	通信协议
local RecruitingBlessingsNet = _G.BaseClass("RecruitingBlessingsNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return RecruitingBlessingsNet RecruitingBlessingsNet
function RecruitingBlessingsNet:GetInstance()
    return self.super.super.GetInstance(self)
end

--获取招募祝福信息
---@param pbData table PB数据
---@param callback function 完成回调
function RecruitingBlessingsNet:WishInfo(callback)
    local item = _G.ConfigManager.net_map.game_lucky_draw_recruit_wish_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.CardCall))
    self.Call[port] = callback
end

---招募祝福-选择奖励
---@param pbData table PB数据
---@param callback function 完成回调
function RecruitingBlessingsNet:WishAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_lucky_draw_choose_recruit_wish_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.CardCall))
    self.Call[port] = callback
end

---招募祝福-领取奖励
---@param pbData table PB数据
---@param callback function 完成回调
function RecruitingBlessingsNet:WishAwardIs(pbData, callback)
    local item = _G.ConfigManager.net_map.game_lucky_draw_recruit_wish_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.CardCall))
    self.Call[port] = callback
end

---请求回调 通用 返回 ack 字符Call
---@param port number 流水号Card
---@param data table 返回PB数据
---@param error string 错误信息
function RecruitingBlessingsNet:CardCall(port, data, error)
    if error then
        return
    end
    --TODO 写通用数据解析，没有需要做的记得删除TODO
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end
---@type RecruitingBlessingsNet
return RecruitingBlessingsNet
