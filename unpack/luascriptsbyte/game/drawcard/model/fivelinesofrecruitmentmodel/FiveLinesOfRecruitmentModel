---活动本身数据处理
---@param info activity.i_activity_self_info
function FiveLinesOfRecruitmentModel:SetSelfData(info)
    self.Info = info.wuxing_draw
    self.CurTimes = self.Info.times

    require "DrawModel":GetInstance():SetFiveLinesOfRecruitment(self)

    self.SyTime = self:GetTime()
    if self.SyTime > 0 then
        self.SyTimer = _G.TimerManager:GetInstance():GetTimer(1, self.GoSyTime, self, false, false, true)
        self.SyTimer:Start()
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.DrawFLOR.id)
    end
end

function FiveLinesOfRecruitmentModel:GoSyTime(elapsed)
    self.SyTime = self.SyTime - elapsed
    if self.SyTime <= 0 then
        self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
        self.SyTimer:Stop()
        self.SyTimer = nil
    end
end

---获取当前拍脸图显示id
function FiveLinesOfRecruitmentModel:GetIdRde()
    -- body
    local time = _G.PlayerPrefsManager.GetInt("FiveLinesOfRecruitmentModel" .. self.curActivityClass.activityID)
    if
        time == 0 or
            _G.PlayerPrefsManager.GetInt("FiveLinesOfRecruitmentModel" .. self.curActivityClass.activityID) ~=
                _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
     then
        return self.curActivityClass.activityID
    end
    return 0
end

function FiveLinesOfRecruitmentModel:Role_SpineParse()
    --角色id|跳转id|拍脸背景图路径+资源名称#X坐标#Y坐标#Z坐标|角色名称路径+资源名称#X坐标
    --#Y坐标#Z坐标|名称底框路径+资源名称#X坐标#Y坐标#Z坐标|
    --slogan文本“<color=#C95F00>玄秘机巧，尽在一心</color>”
    local cfg = self.Info.cfg
    if cfg.role_spine == nil or cfg.role_spine == "Test" then
        return
    end

    cfg.role_spineList = {}
    cfg.role_spineList.int = 2
    local dev = _G.string.split(cfg.role_spine, "|")
    for key, value in pairs(dev) do
        if key == 1 then
            cfg.role_spineList.id = _G.tonumber(value)
        elseif key == 2 then
            cfg.role_spineList.jump_id = _G.tonumber(value)
        elseif key == 3 then
            cfg.role_spineList.bg = value
        elseif key == 4 then
            cfg.role_spineList.role = value
        elseif key == 5 then
            cfg.role_spineList.name = value
        elseif key == 6 then
            cfg.role_spineList.slogan = value
        elseif key == 7 then
            cfg.role_spineList.spice = value
        end
    end
    return cfg.role_spineList
end

---剩余时间计算
function FiveLinesOfRecruitmentModel:GetTime()
    local timeShengYu = 0
    if self.curActivityClass and self.curActivityClass.cfg then
        timeShengYu =
            self.curActivityClass.cfg.time.start_time + self.curActivityClass.cfg.time.run_time -
            _G.TimeUtil.GetServerUnixTime()
    end
    return timeShengYu
end

function FiveLinesOfRecruitmentModel:GetTips()
    local tips = self.Info.cfg.tips
    tips = string.split(tips, "|")
    return tips or {}
end

function FiveLinesOfRecruitmentModel:Dispose()
    if self.curActivityClass then
        self.curActivityClass:RemoveStateChanged(_G.handler(self, self.OnActivityStateChanged), self)
    end
    if self.SyTimer then
        self.SyTimer:Stop()
        self.SyTimer = nil
    end
    base.Dispose(self)
end

