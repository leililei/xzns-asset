local RecruitingBlessingsNet = require "RecruitingBlessingsNet"
local base = require "GameDataModelBase"

---@class RecruitingBlessingsModel : Singleton	中文描述
local RecruitingBlessingsModel = _G.BaseClass("RecruitingBlessingsModel", base)

-- ---@return RecruitingBlessingsModel RecruitingBlessingsModel
-- function RecruitingBlessingsModel:GetInstance()
--     return self.super.GetInstance(self)
-- end

---创建对象时,入口构造函数
function RecruitingBlessingsModel:__init()
    self.curFunctionOpenID = 144
    --积分
    self.score = 0
    --选择奖励
    self.choose = {}
    --选择奖励
    self.award = {}
    self.Pools = {}
end
---销毁对象时,析构函数
function RecruitingBlessingsModel:Dispose()
    -- self.Pools = nil
    if self.timer ~= nil then
        self.timer:Stop()
    end
    _G.Events:GetInstance():RemoveListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.OnDrawGodOpenCall, self)
end
function RecruitingBlessingsModel:OnDrawGodOpenCall(id)
    if id == 144 then
        self.addGodFunctionListener = nil
        _G.Events:GetInstance():RemoveListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.OnDrawGodOpenCall, self)
        -- require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.GodDraw.id)
        self:GetDataFormServer()
    end
end
---初始化数据
function RecruitingBlessingsModel:InitDatas(call)
    -- self:GetDataFormServer(call)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(144) and not self.addGodFunctionListener then
        self.addGodFunctionListener = true
        _G.Events:GetInstance():AddListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.OnDrawGodOpenCall, self)
    end
end
---获取已抽奖次数
function RecruitingBlessingsModel:GetScore()
    return self.score
end
---增加抽奖次数
function RecruitingBlessingsModel:AddScore(num)
    self.score = self.score + num
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RecruitingBlessings.id)
end
---获取抽奖信息
function RecruitingBlessingsModel:GetDataFormServer()
    RecruitingBlessingsNet:GetInstance():WishInfo(_G.handlerbind(self, self.ParseData))
    self:InitDatas()
end
---获取抽奖信息
function RecruitingBlessingsModel:ParseData(data)
    -- if data.ack == 1 then
    --     return
    -- end
    ---心愿单数据
    self.wish_card = {
        [1] = {id = 120, isGet = false, award = 1},
        [2] = {id = 240, isGet = false, award = 1}
    }

    self.wish_card[1].id = _G.ConfigManager.lucky_bless_cfg[1].condition
    self.wish_card[2].id = _G.ConfigManager.lucky_bless_cfg[2].condition
    if data.score then
        self.score = data.score
    else
        self.score = 0
    end
    if data.choose then
        self.choose = data.choose
    else
        self.choose = {}
    end
    if data.award then
        self.award = data.award
    else
        self.award = {}
    end
    self.Pools = {}
    if data.start_time then
        self.start_time = data.start_time
    end

    self:Choose()
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.RecruitingBlessingsView.Name)

    if window then
        window.View:CardIs()
        window.View:Progress()
    end
    base.ParseData(self)
end

---红点刷新
function RecruitingBlessingsModel:RepNew()
    if not require("DrawModel"):GetInstance():CheckBlessOpen() then
        return false
    end
    local Is = _G.PlayerPrefsManager.GetInt("RecruitingBlessingsModel")
    if Is == nil or Is == 0 then
        return true
    end
    for key, value in pairs(self.wish_card) do
        if value.id <= self:GetScore() then
            if not value.isGet then
                return true
            elseif self:chooseIS(key) then
                return true
            end
        end
    end
    return false
end

function RecruitingBlessingsModel:chooseIS(id)
    for key, value in pairs(self.choose) do
        if value.k == id then
            return false
        end
    end
    return true
end

--已选中赋值
function RecruitingBlessingsModel:Choose()
    for key, value in pairs(self.choose) do
        if self.wish_card[value.k] then
            self.wish_card[value.k].award = value.v
        end
    end

    for key, value in pairs(self.award) do
        if self.wish_card[value] then
            self.wish_card[value].isGet = true
        end
    end
end

---选择奖励
function RecruitingBlessingsModel:WishAward(Id, choose, call)
    local msg = {index = Id, choose_index = choose}
    RecruitingBlessingsNet:GetInstance():WishAward(
        msg,
        function()
            local is = true
            for key, value in pairs(self.choose) do
                if value.k == Id then
                    is = false
                    self.choose[key].v = choose
                end
            end
            if is then
                _G.table.insert(self.choose, {k = Id, v = choose})
            end
            self:Choose()
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RecruitingBlessings.id)

            if call then
                call()
            end
        end
    )
end

function RecruitingBlessingsModel:WishPanduan(id, NumId)
    local zo = self:chooseIS(id)
    if self.wish_card[id].award == NumId and not zo then
        return true
    end
    return false
end

---领取奖励
function RecruitingBlessingsModel:WishAwardIs(Id, call)
    local msg = {index = Id}
    RecruitingBlessingsNet:GetInstance():WishAwardIs(
        msg,
        function(mag)
            _G.StorageManager:GetInstance():ReceiveAwardData(mag)

            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, mag)

            _G.table.insert(self.award, Id)
            self:Choose()
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RecruitingBlessings.id)

            if call then
                call()
            end
        end
    )
end

return RecruitingBlessingsModel
