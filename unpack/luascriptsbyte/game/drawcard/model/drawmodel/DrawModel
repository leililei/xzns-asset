function DrawModel:AutoCardResolve(data, awardList)
    self.datalistitem.award.item = {}

    if data == nil then
        return
    end
    local isAuto = require("CardInfoManager").GetPlayerPrefs_CardIsAutoResolve()
    if isAuto == false then
        return
    end

    if awardList then
        local aw = {award = {}}
        aw.award.item = {}
        for _, value in pairs(awardList) do
            table.insert(aw.award.item, value)
        end
        if #aw.award.item > 0 then 
            self.popTipsAward = self.popTipsAward or {}
            for i = 1, #aw.award.item do 
                table.insert(self.popTipsAward, aw.award.item[i].type)
            end
