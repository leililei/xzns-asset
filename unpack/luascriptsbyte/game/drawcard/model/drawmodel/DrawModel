---获取绝卡的卡牌
function DrawModel:GetCard()
    local StorageManager = _G.StorageManager:GetInstance()
    local tb = {}
    local cardList = self:GetGodCfg().limited_item[1] or {}
    for _, v in pairs(cardList) do
        local data = StorageManager:GetMaxStarCardBySid(v)
        if not data then
            data = StorageManager:GetItemDataClass(v, 1)
        end
        if v == self.godCardSid then
            _G.table.insert(tb, 1, data)
        else
            _G.table.insert(tb, data)
        end
    end
    local max = _G.ConfigManager.discrete_cfg[103704][1][1]
    ---@param a CardData
    _G.SortList(
        tb,
        function(a)
            local god = a:GetElement() == _G.CardElementType.God and 1 or 0
            local isCur = a.sid == self.godCardSid and 1 or 0
            local haveCard = a.sid ~= a.uid and 1 or 0
            local isMax = a.star < max and 1 or 0
            return isCur, isMax, god, haveCard, a.sid
        end
    )
    return tb
end

