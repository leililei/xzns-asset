---获取抽奖信息
function DrawModel:GetDrawCardInfoSuc(data, call)
    if data.day_count ~= nil then
        for _, v in pairs(data.day_count) do
            self.Pools[v.key].day_count = v.value
        end
    end
    self.XinYuanDanDrawNum = 0
    if data.total_count ~= nil then
        for _, v in pairs(data.total_count) do
            self.Pools[v.key].total_count = v.value
            if self.ShowXinYuanPool[v.key] then
                self.XinYuanDanDrawNum = self.XinYuanDanDrawNum + v.value
            end
        end
    end
    if self.ShowXinYuanPool[_G.CardPoolType.God] then
        self.XinYuanDanDrawNum = data.b_all_num + self.XinYuanDanDrawNum
    end
    self.exit_num = data.exit_num
    self.award_num = data.award_num

    require "IllustrationModel":GetInstance().Maxstars = (data.star_con or 1)
    self:GengXingDqXingJi()
    if self.star_con == nil or self.star_con == 0 then
        self.star_con = 1
    end
    self.got_star_con = self.star_con
    self.award_index = (data.award_index or 0) + 1
    self:CalcAwardTime()

    -- if self.award_index == nil or self.award_index == 0 then
    --     self.award_index = 1
    -- end
    if data.wish_card ~= nil then
        for _, v in pairs(data.wish_card) do
            self.wish_card[v.index].id = v.card_sid
            self.wish_card[v.index].index = v.index
            self.wish_card[v.index].isGet = v.is_ld
        end
    end
    for i, v in pairs(self.Pools) do
        if v.cfg.pool_type == _G.CardPoolType.Prop then
            self.Pools[i].Lock = true
        end
    end
    if data.special_pool ~= nil then
        for _, v in pairs(data.special_pool) do
            self.Pools[v].Lock = false
        end
    end
    if data.free_times ~= nil then
        for _, v in pairs(data.free_times) do
            self.Pools[v.key].free_times = v.value
        end
    end
    self.Pools[self.PropPoolToday].Lock = false
    self.godCardSid = data.befall_card
    self.godCount = data.b_day_num
    self.godMaxCount = data.b_all_num
    if data.befall_card_num then
        for _, v in pairs(data.befall_card_num) do
            if v.key == 0 then
                self.godCardDrawInfo = v.value
                break
            end
        end
        if not self.godCardDrawInfo then
            self.godCardDrawInfo = 0
        end
    else
        self.godCardDrawInfo = 0
    end

    ---(降神招募)已使用魂玉召唤次数
    self.god_diamond_times = data.befall_diamond_times or 0
    ---(降神招募)总共可使用魂玉次数(配置表丶服务器数据总和, 暂无服务器数据)
    self.god_diamond_total_times = self:GetGodCfg().count_diamond
    ---(降神招募)魂玉单抽消耗数量
    self.god_diamond_consume_num = self:GetGodCfg().ticket_2[1]

    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.WishListView.Name)

    if data.element_award ~= nil then
        self.KaPao = data.element_award
    end

    --降神礼包购买次数
    self.BefallGift = {}
    if data.befall_gift then
        for _, v in ipairs(data.befall_gift) do
            self.BefallGift[v.k] = v.v
        end
    end

    if window then
        window.View:DangQianXuanZhe()
    end
    self:RefreshDrawRewardRed()
    if call ~= nil then
        call()
    end
    self.super.ParseData(self)
    --self:imageXianShi()
end

