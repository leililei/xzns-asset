---获取魂玉召唤消耗
---@param num number        召唤次数
---@return number,number    @需要消耗的魂玉数量, @特权折扣信息
function DrawModel:GetGodDiamondConsume(num)
    local consume = (self.god_diamond_consume_num or 0) * num
    local discount = 1

    --获取降神召唤(魂玉)折扣特权
    local privilege =
        require "PrivilegeManager":GetInstance():GetPrivilegeData(
        {_G.PrivilegeType.LimitedTimePrivilege.GodDrawDiamondReduce}
    )
    if privilege and privilege[1] then
        local poolId, _discount = self:GetGodPrivilegeDiamondDiscount()
        local poolCfg = _G.ConfigManager.discrete_cfg[104314]
        if poolCfg and poolId == poolCfg[1][1] and _discount > 0 then --判断poolId是否为当前降神召唤
            discount = 1 - _discount
        end
    end
    if discount > 0 and discount < 1 then
        --小数不能准确表示, 在向上取整时应额外减去一个很小的偏移值
        consume = math.ceil(consume * discount - 0.0001)
    end

    return consume, discount
end

---获取降神特权折扣信息
---@return number,number  @对应池子ID, @折扣比例0.0-1.0, 10%折扣表示为0.1
function DrawModel:GetGodPrivilegeDiamondDiscount()
    local monthCfg = _G.ConfigManager.store_month_cfg[405001]
    if not monthCfg then
        return 0, 0
    end

    local poolId, discount = 0, 0
    for _, privilegeId in pairs(monthCfg.extra_first) do
        local d = _G.ConfigManager.privilege_cfg[privilegeId]
        if d and d.privilege[1][1] == _G.PrivilegeType.LimitedTimePrivilege.GodDrawDiamondReduce then
            --策划说降神召唤只会同时存在一个, 特权配置里也不对同时存在多个降神召唤池子的折扣配置, 因此直接退出循环
            poolId = d.privilege[1][2]
            discount = d.privilege[1][3] * 0.0001
            break
        end
    end
    return poolId, discount
end

---是否拥有降神特权折扣
---@return boolean
function DrawModel:HasGodPrivilegeDiamondDiscount()
    if not require("MonthlyModel"):GetInstance():IsHavePrivi(405001) then
        return false
    end
    --判断poolId是否为当前降神召唤
    local poolId = self:GetGodPrivilegeDiamondDiscount()
    local poolCfg = _G.ConfigManager.discrete_cfg[104314]
    if not poolCfg or poolId ~= poolCfg[1][1] then
        return false
    end
    return true
end

