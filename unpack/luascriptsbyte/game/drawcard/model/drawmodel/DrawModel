---taptap评论跳转
function DrawModel:TapTapDiscuss()
    local date=_G.ConfigManager.discrete_cfg[201801]
    if SDKManager:GetChannelChildId()>0 and _G.GameUtil.GetFunctionData(_G.FunctionBlock.taptapevaluation) == SDKManager:GetChannelChildId() 
            and _G.GlobalConditionManager.CheckConditionArraysCustomUnlockTip(date) then   
        local creatroletime= _G.PlayerModel:GetInstance():GetCreateRoleTime()
        local day=_G.TimeUtil.GetIntervalDayBySix1(creatroletime,_G.TimeUtil.GetServerUnixTime())+1
        local hasScard=false
        for k,v in pairs(self.CurDrawCardData) do
            if v.cfg.Order>=4 then
                hasScard=true
            end
        end
        if (day==1 or day==3 or day==7 ) and hasScard and  _G.PlayerPrefsManager.GetInt("firstGetS+Card"..day,0)==0 then
            self.IsShowTapTapDiscuss=true
        end
    end

end

