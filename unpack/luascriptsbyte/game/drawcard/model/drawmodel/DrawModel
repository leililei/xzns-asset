---获取下一个可领取的奖励
---@return number[][] @{{抽卡次数，奖励id，数量}}
function DrawModel:GetAwardPre()
    self:GengXingDqXingJi()
    local turnTotalNum = self:GetTurnTotalDrawCount()
    local nowTurnDrawStart = math.floor(self.exit_num / turnTotalNum) * turnTotalNum
    local bonus = _G.ConfigManager.lucky_goal_cfg[self.star_con].bonus
    local index = 1
    while nowTurnDrawStart < self.exit_num do
        nowTurnDrawStart = nowTurnDrawStart + bonus[index][1]
        if nowTurnDrawStart > self.exit_num then
            break
        end
        index = index + 1
    end
    local bonus = _G.ConfigManager.lucky_goal_cfg[self.star_con].bonus[index]
    local item = _G.ConfigManager.lucky_goal_cfg[self.star_con].item
    return bonus, bonus[2] == 0 and item or bonus[2], item
end

---获取一个轮次的总抽卡数
---默认每个轮次相同才能计算当前奖励位置
---@return number
function DrawModel:GetTurnTotalDrawCount()
    if not self.turnTotalNum then
        self.turnTotalNum = 0
        local bonus = _G.ConfigManager.lucky_goal_cfg[self.got_star_con].bonus
        for i = 1, #bonus do
            self.turnTotalNum = self.turnTotalNum + bonus[i][1]
        end
    end
    return self.turnTotalNum
end

---获取未领取的全部奖励
---@return number[][] @{{奖励id，数量}}
function DrawModel:GetTotalAward()
    self:GengXingDqXingJi()
    if not self.isDrawUpdateAwardFlag and self.toGetAwardsCache then
        return self.toGetAwardsCache
    end
    self.isDrawUpdateAwardFlag = false
    local turnTotalNum = self:GetTurnTotalDrawCount()
    local nowTurnDrawStart = math.floor(self.award_num / turnTotalNum) * turnTotalNum
    local drawCount = self.award_num
    local index = 1
    local bonus = _G.ConfigManager.lucky_goal_cfg[self.got_star_con].bonus
    while nowTurnDrawStart + bonus[index][1] <= drawCount do
        nowTurnDrawStart = bonus[index][1] + nowTurnDrawStart
        index = index + 1
    end
    local star_con = self.got_star_con
    --从下一位开始计算
    if index > #bonus then
        index = 1
        star_con = self.star_con
    end
    local togetAwardsDic = {}
    while drawCount + bonus[index][1] <= self.exit_num do
        drawCount = bonus[index][1] + drawCount
        if bonus[index][2] ~= 0 then --五行卡单独处理
            if togetAwardsDic[bonus[index][2]] then
                togetAwardsDic[bonus[index][2]] = togetAwardsDic[bonus[index][2]] + bonus[index][3]
            else
                togetAwardsDic[bonus[index][2]] = bonus[index][3]
            end
        else
            local sid = _G.ConfigManager.lucky_goal_cfg[self.got_star_con].item
            if togetAwardsDic[sid] then
                togetAwardsDic[sid] = togetAwardsDic[sid] + bonus[index][3]
            else
                togetAwardsDic[sid] = bonus[index][3]
            end
        end
        index = index + 1
        if index > #bonus then
            index = 1
            star_con = self.star_con
        end
    end
    self.toGetAwardsCache = {}
    for sid, num in pairs(togetAwardsDic) do
        self.toGetAwardsCache[#self.toGetAwardsCache + 1] = {sid, num}
    end
    table.sort(
        self.toGetAwardsCache,
        function(l, r)
            local itemCfg = _G.ConfigManager.item_cfg
            if itemCfg[l[1]].Quality ~= itemCfg[r[1]].Quality then
                return itemCfg[l[1]].Quality > itemCfg[r[1]].Quality
            end
            return l[1] < r[1]
        end
    )
    return self.toGetAwardsCache
end

---领取累计奖励
---@param callback fun()
function DrawModel:GetDrawExAward(callback, isSpAward)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(159) then
        _G.PopWindowManager:GetInstance():ShowAllTips(340603)
        return
    end

    local net = require "DrawNet":GetInstance()

    local recieveAwardPre = function()
        local turnTotalNum = self:GetTurnTotalDrawCount()
        local nowTurnDrawStart = math.floor(self.exit_num / turnTotalNum) * turnTotalNum
        local index = 0
        while nowTurnDrawStart <= self.exit_num do
            local bonusItem = _G.ConfigManager.lucky_goal_cfg[self.got_star_con].bonus[index]
            if bonusItem then
                if bonusItem[1] + nowTurnDrawStart > self.exit_num then
                    break
                end
                nowTurnDrawStart = bonusItem[1] + nowTurnDrawStart
            end
            index = index + 1
        end

        self.award_num = nowTurnDrawStart
        self.award_index = index
        self.isDrawUpdateAwardFlag = true

        self:GengXingDqXingJi()
        self.got_star_con = self.star_con
        self:CalcAwardTime()
    end
    local recieveAward = function(awardData)
        _G.StorageManager:GetInstance():ReceiveAwardData(awardData)
        if #awardData.award.item > 0 then
            _G.UIUtils.ShowCommonAward(awardData)
        end
    end

    if isSpAward then
        local msg = {}
        msg.element = 1
        msg.num = 1
        net:GetDrawExAward(
            function(data)
                net:ChoKaDrawCard(
                    msg,
                    function(data)
                        if data.ack ~= 1 then
                            return
                        end
                        recieveAwardPre()
                        if data.award.item ~= nil then
                            recieveAward(data)
                        end
                        _G.Events:GetInstance():Broadcast(_G.eDraw.RefreshDrawView)
                        self:RefreshDrawRewardRed()
                        if callback then
                            callback()
                        end
                    end
                )
            end
        )
    else
        ---@param data lucky_draw.s2c_get_total_award
        net:GetDrawExAward(
            function(data)
                if data.add_element_award ~= 0 then
                    self.KaPao = self.KaPao + data.add_element_award
                end
                recieveAwardPre()
                if data.total_award ~= nil or data.add_element_award ~= 0 then
                    if data.total_award == nil then
                        data.total_award = {}
                    end
                    local datalistitem = {}
                    datalistitem.award = {
                        item = {}
                    }
                    for key, value in ipairs(data.total_award.item) do
                        _G.table.insert(datalistitem.award.item, value)
                    end
                    recieveAward(datalistitem)
                end
                _G.Events:GetInstance():Broadcast(_G.eDraw.RefreshDrawView)
                self:RefreshDrawRewardRed()
                if callback then
                    callback()
                end
            end
        )
    end
end

