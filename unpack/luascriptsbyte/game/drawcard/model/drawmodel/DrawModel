    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.NomalDraw.id)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FriendDraw.id)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GodDraw.id)
end

