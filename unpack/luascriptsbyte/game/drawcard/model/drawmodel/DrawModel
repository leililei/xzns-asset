---抽卡
function DrawModel:DrawCard(poolID, type, call)
    local num = 0
    if type == DrawType.once then
        num = 1
    elseif type == DrawType.TenTimes then
        num = 10
    end
    if
        not _G.StorageManager:GetInstance():CheckItem(
            self.Pools[poolID].cfg.ticket[1],
            0,
            self.Pools[poolID].cfg.ticket[2] * num
        )
     then
        return
    end
    if self.Pools[poolID].day_count + num > self.Pools[poolID].cfg.limit_daily then
        _G.PopWindowManager:GetInstance():ShowAllTips(130102)
        return
    end
    local list = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    if _G.table.count(list) + num > _G.StorageManager:GetInstance():GetStorageCapacity(_G.StorageID.Card) then
        _G.PopWindowManager:GetInstance():ShowAllTips(130101)
        return
    end
    local msg = {}
    msg.pool = poolID
    msg.type = type
    msg.is_resolve = true
    DrawNet:GetInstance():DrawCard(msg, _G.handlerbind(self, self.DrawCardSuc, poolID, type, call))
end

---抽卡返回
---@param data lucky_draw.s2c_ld_execute
function DrawModel:DrawCardSuc(data, poolID, type, call)
    if data.ack ~= 1 then
        return
    end

    local num = 0
    if type == DrawType.once then
        num = 1
    elseif type == DrawType.TenTimes then
        num = 10
    end
    local RecordTotalZhaomuModelIns = require "RecordTotalZhaomuModel":GetInstance()
    --累计招募活动是否开启或结束
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(56) and not RecordTotalZhaomuModelIns:CheckIsOver() then
        RecordTotalZhaomuModelIns:GetInfo(
            function()
                RecordTotalZhaomuModelIns:RefreshRedPoint()
            end
        )
    end

    self.Pools[poolID].day_count = self.Pools[poolID].day_count + num
    self.Pools[poolID].total_count = self.Pools[poolID].total_count + num

    if self.ShowXinYuanPool[poolID] then
        self.XinYuanDanDrawNum = self.XinYuanDanDrawNum + num
    end
    if self.cfg[poolID].is_cumulative then
        self.exit_num = self.exit_num + num
    end
    if data.add_element_award ~= 0 then
        self.KaPao = self.KaPao + data.add_element_award
    end
    if data.total_award ~= nil or data.add_element_award ~= 0 then
        local award = _G.ConfigManager.lucky_goal_cfg[self.star_con].bonus
        self.award_num = self.award_num + award[self.award_index][1]

        self.award_index = self.award_index + 1
        if self.award_index > _G.table.count(award) then
            self.award_index = self.award_index - _G.table.count(award)
        end
        self:GengXingDqXingJi()
        self:CalcAwardTime()
        -- _G.StorageManager:GetInstance():ReceiveAwardData(data)
        local datalistitem = {}
        datalistitem.award = {
            item = {}
        }
        if data.total_award == nil then
            data.total_award = {}
        end
        for key, value in pairs(data.total_award) do
            _G.table.insert(self.datalistitem.award.item, value[1])
            _G.table.insert(datalistitem.award.item, value[1])
        end
    end
    self.isDrawUpdateAwardFlag = true
    --五行召唤, 额外获取奖励
    if data.element_award then
        _G.StorageManager:GetInstance():ReceiveAwardData({award = data.element_award})
        if not self.wuxingAward then
            ---@type table<number,number> 五行召唤奖励(每召唤一次, 额外获取n枚五行商店代币)
            self.wuxingAward = {}
        end
        for _, v in pairs(data.element_award.item) do
            if v.type then
                local currencySid, currencyNum = table.unpack(v.type)
                self.wuxingAward[currencySid] = (self.wuxingAward[currencySid] or 0) + currencyNum
            end
        end
    end

    if data.resolve_award then
        local aw = {award = data.resolve_award}
        _G.StorageManager:GetInstance():ReceiveAwardData(aw)
        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, aw)
        self.CurDrawAwardData = aw
    end
    if num == 1 then
        local HellRoadModel = require "HellRoadModel"
        local freeCount = HellRoadModel:GetInstance():GetNumber({_G.PrivilegeType.DrawCard.Count, poolID})
        if self.Pools[poolID].free_times + num <= freeCount then
            self.Pools[poolID].free_times = self.Pools[poolID].free_times + num
            require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.NomalDraw.id)
            require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.DrawButton.id)
            require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.FriendDraw.id)
        else
            self.Pools[poolID].free_times = freeCount
            _G.StorageManager:GetInstance():ConsumeItem(
                self.Pools[poolID].cfg.ticket[1],
                0,
                self.Pools[poolID].cfg.ticket[2] * num
            )
        end
    else
        _G.StorageManager:GetInstance():ConsumeItem(
            self.Pools[poolID].cfg.ticket[1],
            0,
            self.Pools[poolID].cfg.ticket[2] * num
        )
    end

    if data.award and data.award.item ~= nil then
        --local cardUidList = {}
        --local cardstarList = {}
        local cardCfg = _G.ConfigManager.card_cfg
        _G.StorageManager:GetInstance():ReceiveAwardData(data)
        self.CurDrawCardData = {}
        for _, v in pairs(data.award.item) do
            --cardUidList[v.type[2]] = true
            --cardstarList[v.type[2]] = v.type[3]
            --心愿单新加星级判断,wish_get理论上没用了已经，不过防止策划反复横跳先保留
            for key, value in pairs(self.wish_card) do
                if value.id == v.type[1] and cardCfg[value.id].Grade == cardCfg[v.type[1]].Grade then
                    _G.table.insert(self.wish_get, value.id)
                    self.wish_card[key].isGet = true
                end
            end

            local info = {}
            info.sid = v.type[1]
            info.cfg = _G.ConfigManager.card_cfg[info.sid]
            info.star = v.type[3]
            _G.table.insert(self.CurDrawCardData, info)
        end
        -- local cardList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
        -- for _, v in pairs(cardList) do
        --     if cardUidList[v.uid] ~= nil then
        --         v:upStarCardAward(cardstarList[v.uid])
        --         self.CurDrawCardData[v.uid] = v
        --     end
        -- end
        require "PopUpGiftBagModel":GetInstance():IsRecruitCard(data.award.item)
        local is_bless = self.cfg[poolID].is_bless
        if is_bless then
            require "RecruitingBlessingsModel":GetInstance():AddScore(num)
        end
    end
    local id
    if poolID == 101 then
        id = 1
    elseif poolID == 201 then
        id = 2
    else
        id = 3
    end
    self:RefreshDrawRewardRed()
    _G.Events:GetInstance():Broadcast(_G.eSeasonTask.Action, { _G.SeasonTaskID.Draw, id }, num)
    _G.Events:GetInstance():Broadcast(_G.eSeasonTask.Action, { _G.SeasonTaskID.Draw, 0 }, num)
    ---taptap评论跳转相关
    self:TapTapDiscuss()
    --抽卡行为上报
    local simpleDataModel = require("PlayerSimpleDataModel"):GetInstance()
    local actionNum = simpleDataModel:GetGameAction(SDKDef.GameAction.EveryDraw40) + num
    if actionNum >= 10 then
        actionNum = actionNum - 10
        _G.SDKManager:GetInstance():GameAction(SDKDef.GameAction.EveryDraw40, 1)
    end
    simpleDataModel:SetGameAction(SDKDef.GameAction.EveryDraw40, actionNum)

    if call ~= nil then
        call(num)
    end
end

