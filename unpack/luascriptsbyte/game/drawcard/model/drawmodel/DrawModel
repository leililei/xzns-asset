---获取降神召唤预览奖励
function DrawModel:GetGodPreAward()
    local Card
    local tb
    if self.godCardSid > 0 then
        local data
        data = _G.StorageManager:GetInstance():GetMaxStarCardBySid(self.godCardSid)
        if not data then
            data = _G.StorageManager:GetInstance():GetItemDataClass(self.godCardSid, 1)
        end
        local per = self:GetGodCfg().limited_item[2][1]
        Card = {data = data, per = per / 10000}
    end
    local Award = {}
    if Card then
        Award[1] = Card
    end
    local AllPer = Card and 1 - Card.per or 1
    local itemAward = self:GetGodCfg().pool
    local allPower = 0
    for i, v in ipairs(itemAward) do
        local data = _G.StorageManager:GetInstance():GetItemDataClass(v[1], v[2])
        _G.table.insert(Award, {data = data, per = v[3]})
        allPower = v[3] + allPower
    end
    for i, v in ipairs(Award) do
        if Card then
            if i > 1 then
                v.per = _G.math.ceil(AllPer / allPower * v.per * 10000) / 10000
            end
        else
            v.per = _G.math.ceil(AllPer / allPower * v.per * 10000) / 10000
        end
    end
    return Award
end

---降神抽取
---@param num number @召唤次数
---@param consumeType number @1招募券召唤, 2魂玉召唤
function DrawModel:DrawGodCard(consumeType, num, call, cancelCall)
    if self.godCardSid <= 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(260101)
        if cancelCall then
            cancelCall()
        end
        return
    end

    local material = _G.DeepCopyCfgTable(self:GetGodCfg().ticket)
    material[2] = material[2] * num
    if self.godCount + material[2] > self:GetGodCfg().limit_daily then
        _G.PopWindowManager:GetInstance():ShowAllTips(130102)
        if cancelCall then
            cancelCall()
        end
        return
    end

    local msg = {}
    msg.consume_type = consumeType
    msg.draw_times = num
    DrawNet:GetInstance():DrawGodCard(msg, _G.handlerbind(self, self.DrawGodCardSuc, material, call, consumeType, num))
end

function DrawModel:OpenViewEndTOBack(call)
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DrawView.Name)
    if not view then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DrawView.Name, 1, call)
    end
end

---@param consumeType numeber @1招募券召唤, 2魂玉召唤
function DrawModel:DrawGodCardSuc(data, material, call, consumeType, num)
    -- local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DrawView.Name)
    -- if window and window.View and not window.View:IsNil() then
    --     window.View.GodDraw.isClick = false
    --     window.View:LoadGodConsumesInfos()
    -- end
    if data.ack ~= 1 then
        return
    end
    if consumeType == 1 then
        --消耗招募券
        _G.StorageManager:GetInstance():ConsumeItem(material[1], nil, material[2])
        if self.ShowXinYuanPool[_G.CardPoolType.God] then
            self.XinYuanDanDrawNum = self.XinYuanDanDrawNum + num
        end
    else
        --消耗魂玉
        local consumeNum = self:GetGodDiamondConsume(num)
        self:AddGodDiamondTimes(num)
        _G.StorageManager:GetInstance():ConsumeItem(_G.ResPropID.Diamond, 0, consumeNum)
    end
    _G.StorageManager:GetInstance():ReceiveAwardData(data)
    self.godCount = self.godCount + material[2]
    self.godMaxCount = self.godMaxCount + material[2]

    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GodDraw.id)
    _G.Events:GetInstance():Broadcast(_G.eSeasonTask.Action, {_G.SeasonTaskID.Draw, 4}, num)
    _G.Events:GetInstance():Broadcast(_G.eSeasonTask.Action, {_G.SeasonTaskID.Draw, 0}, num)

    local reset = self:UpdateGodDrawInfo(data, consumeType)
    if call then
        call(data, reset)
    end
end

