---@class FastLoadingView : UIBaseView	快速切换场景的loading界面
---@field public go_table FastLoadingView_GoTable GoTable
local FastLoadingView = _G.BaseClass("FastLoadingView", _G.UIBaseView)

function FastLoadingView:Awake()
end

---界面的入口函数
function FastLoadingView:OnCreate(blackcall, endcall)
    self.blackCallback = blackcall
    self.endCallback = endcall
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.FastLoadingEffect,
        self.transform,
        function()
            _G.DelayDo(
                0.6,
                function()
                    if self.blackCallback then
                        self.blackCallback()
                    end
                    self.blackCallback = nil
                end
            )
        end,
        function()
            self:Close()
            if self.endCallback then
                self.endCallback()
            end
            self.endCallback = nil
        end
    )
end
return FastLoadingView
