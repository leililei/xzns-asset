---显示tips
function LoadingView:ShowTips()
    self.lauguageId = self:GetCurTips()
    self.go_table.aortext_tips.text =
        _G.LangUtil.GetLangPackValue(90100100204, _G.LangUtil.GetLangPackValue(self.lauguageId)) --self:GetRandomTipsString()
end

---保证tips必定和上一次不一样
function LoadingView:GetCurTips()
    local index = math.random(1, #self.tips)
    local lauguageId = self.tips[index]

    if self.lauguageId ~= lauguageId then
        return lauguageId
    else
        return self:GetCurTips()
    end
end

--region 对外接口

function LoadingView:SetProgress(progress)
    self.targetProgress = progress
end

function LoadingView:GetProgress()
    return self.targetProgress
end

function LoadingView:CheckComplete()
    return self.m_displayProgress >= 100
end

--endregion

function LoadingView:OnDestroy()
    self.targetProgress = 0.0
    self.m_displayProgress = 0.0
    if self.temp_co ~= nil then
        _G.coroutine.stopwaiting(self.temp_co)
        self.temp_co = nil
    end
end

return LoadingView
