---@class LoadingView : UIBaseView    Loading
---@field go_table LoadingView_GoTable
local LoadingView = _G.BaseClass("LoadingView", _G.UIBaseView)

function LoadingView:Awake()
    ---@private temp_co 协程
    self.temp_co = nil

    self.targetProgress = 0.0
    self.m_displayProgress = 0.0

    self.progressFullCall = nil

    self.tips = _G.ConfigManager.discrete_cfg[106101][1]
end

---界面的入口函数
function LoadingView:OnCreate()
    self.temp_co = _G.coroutine.start(_G.handler(self, self.CoOnProgress))
    self.go_table.aortext_version.text = GetLangPackValue(90022500414) .. _G.CS.Main.Inst:GetVersion()
    self:ShowTips()

    local path = _G.GameUtil.GetFunctionData(_G.FunctionBlock.loading_bg)
    if not _G.table.isEmptyOrNil(path) then
        self.go_table.aorrawimage_bg_random:LoadImage(
            path[1],
            function(img)
                if self:IsNil() then
                   return 
                end

                img:SetNativeSize()
            end
        )
    end
    _G.CS.Launcher.Inst:CloseLoading()
end

function LoadingView:CoOnProgress()
    local _toProgress = 90
    while self.targetProgress < 0.9 do
        while self.m_displayProgress < _toProgress do
            self.m_displayProgress = self.m_displayProgress + 2
            self:SetLoadingPercentage(self.m_displayProgress)
            _G.coroutine.waitforendofframe()
        end
        _G.coroutine.waitforendofframe()
    end
    _toProgress = 100
    while self.m_displayProgress < _toProgress do
        self.m_displayProgress = self.m_displayProgress + 1
        self.m_displayProgress = _G.Mathf.Min(self.m_displayProgress, 100)
        self:SetLoadingPercentage(self.m_displayProgress)
        _G.coroutine.waitforendofframe()
    end
end

---UIManager:CloseWindow 调用 让进度条先走完 在关闭界面
function LoadingView:CloseViewFun(closeFun)
    if self.m_displayProgress >= 100 then
        if closeFun then
            closeFun()
        end
        return
    end
    self.targetProgress = 1
    self.progressFullCall = closeFun
end

function LoadingView:SetLoadingPercentage(displayProgress)
    self.go_table.slider_process.value = displayProgress / 100
    self.go_table.aortext_processNum.text = _G.GetLangPackValue(9002010023, displayProgress)
    if displayProgress >= 100 and self.progressFullCall then
        self.progressFullCall()
        self.progressFullCall = nil
        if self.temp_co ~= nil then
            _G.coroutine.stopwaiting(self.temp_co)
            self.temp_co = nil
        end
    end
end

