---@class SpBoxManager : Singleton    中文描述
local SpBoxManager = _G.BaseClass("SpBoxManager", _G.GameDataModelBase)

---@return SpBoxManager SpBoxManager
function SpBoxManager:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function SpBoxManager:__init()
end

---选择队伍
function SpBoxManager:GetCoin(sid)
    return self.SpModel:GetCoin(sid)
end

---销毁对象时,析构函数
function SpBoxManager:Dispose()
end
---设置活动
function SpBoxManager:SetActivityModel(model)
    self.SpModel = model
end

---0点刷新
function SpBoxManager:OnSixClockUpdate(endCall)
    if nil == self.SpModel then
        if endCall then
            endCall()
        end
        return
    end
    self.SpModel:OnSixClockUpdate(endCall)
end

return SpBoxManager
