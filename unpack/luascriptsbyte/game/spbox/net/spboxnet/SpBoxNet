local base = require("BaseGameNet")

---@class SpBoxNet : BaseGameNet	通信协议
local SpBoxNet = _G.BaseClass("SpBoxNet", base)
---@return SpBoxNet SpBoxNet
function SpBoxNet:GetInstance()
    return  base.GetInstance(self)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function SpBoxNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function SpBoxNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---购买宝箱
function SpBoxNet:BuyBox(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_surprise_box_buy_box
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

