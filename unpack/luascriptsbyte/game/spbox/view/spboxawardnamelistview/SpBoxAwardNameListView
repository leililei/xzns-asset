---@class SpBoxAwardNameListView : UIBaseView  下边栏菜单
---@field go_table RelicTeamInviteMeView_GoTable
local SpBoxAwardNameListView = _G.BaseClass("SpBoxAwardNameListView", _G.UIBaseView)
local RelicTeamModel 
function SpBoxAwardNameListView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SpBoxAwardNameListView:OnCreate(data)
    self.dataList = data or {}
    self:UpdateView()
end

function SpBoxAwardNameListView:UpdateView()
    if not self.init then
        self.go_table.scrollloopvectical_item:InitItemData(#self.dataList, _G.handler(self, self.RefreshList))
        --self.go_table.scrollloopvectical_item:UpdateCount(#self.buffList)
        self.init = true
    else
        self.go_table.scrollloopvectical_item:UpdateCount(#self.dataList)
        self.go_table.scrollloopvectical_item:UpdateAllItem()
    end
end

function SpBoxAwardNameListView:RefreshList(index, obj)
    local data = self.dataList[index + 1]
    local tb = _G.GetAutoGoTable(obj)
    tb.aortext_name.text = data.name
    tb.aortext_item.text = _G.StorageManager:GetInstance():GetItemName(data.display.key) .. "x" .. data.display.value
    tb.aorimage_bg:SetActiveE(index % 2 == 1 and 0 or 1)
end

---按钮点击事件在这里派发
function SpBoxAwardNameListView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or self.go_table.aorbtn_CloseView then
        self:Close()
    end
end
function SpBoxAwardNameListView:OnDestroy()
    self:RemoveAllListener()
end

return SpBoxAwardNameListView
