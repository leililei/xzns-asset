---@class SpBoxPreviewView : UIBaseView	中文描述
---@field public go_table SpBoxPreviewView_GoTable GoTable
local SpBoxPreviewView = _G.BaseClass("SpBoxPreviewView", _G.UIBaseView)

function SpBoxPreviewView:Awake()
    self.awardData = {}
    self.itemList = {}
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.looplist2_team:InitListView(0, _G.handler(self, self.RefreshRenItem))
end

---界面的入口函数
function SpBoxPreviewView:OnCreate(activity)
    self.activity = activity
    self:FreshData()

    self.Sids = {}
    for i = 1, #self.activity.typeClass.coinIndex do
        table.insert(self.Sids, self.activity.typeClass.coinIndex[i])
    end

    _G.SortList(self.Sids, function(a)
        return -a
    end)
    self.num = _G.table.count(self.groupData)
    self.go_table.looplist2_team:SetListItemCount(#self.awardData, true, false)
end

---按钮点击事件在这里派发
function SpBoxPreviewView:OnClickBtn(go)
    if go:GetName() == "@_aorbtn_CloseView" then
        self:Close()
        _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
    end
end

function SpBoxPreviewView:FreshData()
    self.groupData = {}
    local awardData = self.activity.typeClass:GetAwardData()
    self.poolIdTable = {}
    for i = 1, #awardData do
        self.awardData[i] = {}
        for k, v in pairs(awardData[i]) do
            local item = {}
            item.sid = v[1]
            item.num = v[2]
            item.weight = v[3] or 0
            table.insert(self.awardData[i], item)
            _G.SortList(self.awardData[i], function(a)
                local type = 0
                if a.Grand then
                    type = 1
                end
                if item.weight == 1 then
                    type = 2
                end
                return type, -a.weight, -a.sid
            end)
        end
    end

    for i = 1, #self.awardData do
        self.groupData[i] = {}
        local awardData = {}
        for k, v in ipairs(self.awardData[i]) do
            local groupIndex = math.ceil(k / 4)
            self.groupData[i][groupIndex] = self.groupData[i][groupIndex] or {}
            --table.insert(self.groupData[i][groupIndex], v)
            self.groupData[i][groupIndex][#self.groupData[i][groupIndex] + 1] = v
        end
    end
end

--初始化item
function SpBoxPreviewView:RefreshRenItem(listView2, index)
    if index < 0 then
        return
    end
    local t_index = index + 1
    local item = listView2:NewListViewItem("$_obj_Item1")
    item:SetActiveE(1)

    self:SetItem(item, t_index)
    return item
end

--设置Item
function SpBoxPreviewView:SetItem(go, teamsid)
    if not self.cardItems then
        self.cardItems = {}
    end

    local item = self.cardItems[go:GetInstanceIDE()]
    if not item then
        item = _G.GetAutoGoTable(go)
        self.cardItems[go:GetInstanceIDE()] = item
    end

    local index = teamsid
    local data = self.groupData[index]
    item.index = index
    item.data = data
    local sid = self.Sids[index]
    local txt
    if _G.ConfigManager.currency_type_client_cfg[sid] then
        txt = _G.ConfigManager.currency_type_client_cfg[sid].name
    end
    item.aortext_Elements.text = _G.LangUtil.GetLangPackValue(txt)
    -- item.obj_title:SetActiveE(0)
    -- item.obj_cards:SetActiveE(0)

    -- if not data or data == 1 or data == 2 or data == 3 then
    --     item.obj_title:SetActiveE(1)
    --     item.aorimage_pinjie.SpriteName = PingJie[data]
    --     item.aorimage_pinjie:SetNativeSize()
    -- else
    --     item.obj_cards:SetActiveE(1)
    --     self:SetAwardItem(item, index)
    -- end

    --LogError(#self.groupData[index])

    if not item.awarditems then
        item.awarditems = {}
    end

    local addindex = 0
    for i = 1, #self.groupData[index] do
        local awardItem
        if not item.awarditems[i] then
            awardItem = _G.InstantiateObject(self.go_table.obj_awards, item.gameObject)
            item.awarditems[i] = awardItem
        else
            awardItem = item.awarditems[i]
        end
        if item.awarditems[i] then
            _G.GameUtil.SetActiveByCondition(item.awarditems[i], true)
        end
        self:SetAwardItem(awardItem, index, i)
        addindex = addindex + 1
    end

    for i = addindex + 1, #item.awarditems do
        if item.awarditems[i] then
            _G.GameUtil.SetActiveByCondition(item.awarditems[i], false)
        end
    end
    _G.GameUtil.ReBuildRTF(go.gameObject)
    self.go_table.looplist2_team:OnItemSizeChanged(index - 1)
end

function SpBoxPreviewView:SetAwardItem(go, index, groupIndex)
    local instanceID = go:GetInstanceIDE()
    local tb = self.itemList[instanceID]
    for i = 1, 4 do
        local data = self.groupData[index][groupIndex][i]
        if not tb then
            tb = _G.GetAutoGoTable(go)
            self.itemList[instanceID] = tb
        end
        if not data then
            tb["obj_group" .. i]:SetActiveE(0)
        else
            local groupItem = _G.GetAutoGoTable(tb["obj_group" .. i])
            local item = require "BaseAwardNewItem".New(groupItem.obj_Root, nil, 88)
            ---@param item BaseAwardNewItem
            item:ShowWithID(
                { data.sid, data.num },
                nil,
                function(item)
                    if item.item.HideOrShowStar then
                        item.item:HideOrShowStar(false)
                    end
                    item:ShowEffect(data.Grand)
                end
            )
            -- local name = _G.StorageManager:GetInstance():GetItemName(data.award[1].sid)
            -- tb.aortext_name.text = _G.LangUtil.GetLangPackValue(name)
            groupItem.aortext_probNum.text = self:GetPerData(data) .. "%"
        end
    end
end

function SpBoxPreviewView:GetPerData(data)
    local weight = data.weight * 100
    weight = string.format("%.2f", weight)
    return weight
end

function SpBoxPreviewView:AddHunJiangBtn(go, isOn, cardSid)
    require("CommonTipManager"):GetInstance():OpenTip(self.go_table.gameObject, cardSid)
end

return SpBoxPreviewView
