---按钮点击事件在这里派发
function SpBoxView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_autoLeft then
        --self:UpdateDrawPlayBtn(1 - self.playType)
    elseif go == self.go_table.aorbtn_upgrate then
        if self.upList then
            if self.upTimes == self.maxTimes then
                self.actTypeClass:OpenBox(_G.handler(self, self.UpdateView))
            else
                self.IsUpBox = true
                self.actTypeClass:UpgrateBox(self.upList, #self.upList == 5 and 2 or 1, _G.handler(self, self.UpdateView))
            end
        else
            self.IsUpBox = true
            self.actTypeClass:UpgrateBox(self.boxList, #self.boxList == 5 and 2 or 1, _G.handler(self, self.UpdateView))
        end
    elseif go == self.go_table.aorbtn_DrawOnce then
        if self.actTypeClass.open_num + 1 > self.actTypeClass.max_num then
            _G.PopWindowManager:GetInstance():ShowAllTips(130102)
            return
        end
        self.actTypeClass:BuyBox(1, _G.handler(self, self.UpdateView))
    elseif go == self.go_table.aorbtn_DrawTenTimes then
        if self.actTypeClass.open_num + 5 > self.actTypeClass.max_num then
            _G.PopWindowManager:GetInstance():ShowAllTips(130102)
            return
        end
        self.actTypeClass:BuyBox(5, _G.handler(self, self.UpdateView))
    elseif go == self.go_table.aorbtn_gift then
        local mainType = self.activity.cfg.info.front.main_type
        _G.GlobalInterface.JumpActivityByGM(10014, self.activity:GetJumpType(self.ActivityID), false, mainType)
    elseif go == self.go_table.aorbtn_List then
        self.actTypeClass:GetList(function(msg)
            if msg.ack == 1 then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpBoxAwardNameListView.Name, msg.log)
            end
        end)
    elseif go == self.go_table.aorbtn_Yulan then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpBoxPreviewView.Name, self.activity)
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 192)
    end
end

function SpBoxView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.UpdateView, self)
    self:RemoveAllListener()
    if self.timeShengYus then
        self.timeShengYus:Stop()
        self.timeShengYus = nil
    end
end

return SpBoxView
