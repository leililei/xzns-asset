function SpBoxView:UpdateDoTimes()
    self.go_table.aortext_daylimit.text = _G.GetLangPackValue(90034532011, self.actTypeClass.open_num,
        self.actTypeClass.max_num)
end

---倒计时
function SpBoxView:ZanDouTimer()
    local nowTime = _G.TimeUtil.GetServerUnixTime()
    local timeShengYu = self.activity.cfg.time.start_time + self.activity.cfg.time.run_time - nowTime
    if timeShengYu <= 0 then
        self.go_table.aortext_Timer.text = ""
        self:Close()
    else
        self.go_table.aortext_Timer.text =
            _G.GetLangPackValue(90029300004, _G.TimeUtil.TranslateSecondForStrMiaoHui(timeShengYu, 1))
    end
end

---加载招募消耗信息(图标和数量)
function SpBoxView:LoadConsumesInfos()
    --左边
    local leftIcon, leftNum, rightIcon, rightNum
    leftIcon = getCurrencyTypeIcon(self.coinId)
    leftNum = self.coinNum
    --右边
    rightIcon = getCurrencyTypeIcon(self.coinId)
    rightNum = 5 * self.coinNum
    self.go_table.aortext_PropLeftNumDesc.text =
        _G.GetLangPackValue(90028900013, _G.GameUtil.NumberToWordByLanguage(1))
    self.go_table.aortext_PropRightNumDesc.text =
        _G.GetLangPackValue(90028900013, _G.GameUtil.NumberToWordByLanguage(5))
    self.go_table.aortext_PropLeftNum.text = _G.tostring(leftNum)
    self.go_table.aortext_PropRightNum.text = _G.tostring(rightNum)

    self.go_table.aorrawimage_PropLeft:LoadImage(
        leftIcon,
        function(image)
            if image then
                image:SetActiveE(1)
            end
        end
    )
    self.go_table.aorrawimage_PropRight:LoadImage(
        rightIcon,
        function(image)
            if image then
                image:SetActiveE(1)
            end
        end
    )
end

