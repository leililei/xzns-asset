---@class SpBoxView : UIBaseView  下边栏菜单
---@field go_table RelicTeamInviteMeView_GoTable
local SpBoxView = _G.BaseClass("SpBoxView", _G.UIBaseView)
function SpBoxView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---获取代币类型图标
---@param id number
---@return string
local function getCurrencyTypeIcon(id)
    local d = _G.ConfigManager.currency_type_cfg[id]
    if d then
        return d.icon
    end
    return nil
end

local DrawPlayType = {
    Play = 0,
    Skip = 1
}

---界面的入口函数
function SpBoxView:OnCreate(activity)
    self.activity = activity
    self.ActivityID = activity.activityID
    self.actTypeClass = self.activity.typeClass
    self.playType = DrawPlayType.Play
    _G.PlayerPrefsManager.SetInt("SpBoxSkip", self.playType)

    self:ZanDouTimer()
    if self.timeShengYus == nil then
        self.timeShengYus = _G.TimerManager:GetInstance():GetTimer(1, self.ZanDouTimer, self, false, false, true)
        self.timeShengYus:Start()
    end
    local cfg = self.actTypeClass:GetBoxCfgBySid(self.actTypeClass.coinIndex[#self.actTypeClass.coinIndex])
    self.coinId = cfg.consume[1].type[1]
    self.coinNum = cfg.consume[1].type[2]
    self.resource = cfg.resource
    self.isInitUpEff = { false, false, false, false, false }
    self.isInitSingleUpEff = false
    self:UpdateView()
    --self:UpdateDrawPlayBtn()
    local res = { self.actTypeClass.coinIndex[#self.actTypeClass.coinIndex], self.coinId } --_G.ConfigManager.ui_cfg.SpBoxView.resources
    self.resourceTable =
        self:AddComponent(self.go_table.obj_GoldInfo, require("ResourceCompont").New(self.go_table.obj_GoldInfo, res))

    local res1 = { self.actTypeClass.coinIndex[#self.actTypeClass.coinIndex - 2], self.actTypeClass.coinIndex
        [#self.actTypeClass.coinIndex - 1] } --_G.ConfigManager.ui_cfg.SpBoxView.resources
    self.resourceTable1 =
        self:AddComponent(self.go_table.obj_GoldInfo1, require("ResourceCompont").New(self.go_table.obj_GoldInfo1, res1))

    local res2 = { self.actTypeClass.coinIndex[#self.actTypeClass.coinIndex - 4], self.actTypeClass.coinIndex
        [#self.actTypeClass.coinIndex - 3] } --_G.ConfigManager.ui_cfg.SpBoxView.resources
    self.resourceTable2 =
        self:AddComponent(self.go_table.obj_GoldInfo2, require("ResourceCompont").New(self.go_table.obj_GoldInfo2, res2))
    --self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))

    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.UpdateView, self)
end

function SpBoxView:FreshData()
    self.upList = self.actTypeClass:GetUpList()
    self.boxList = self.actTypeClass:GetBoxList()
    self.upTimes = self.actTypeClass:GetUpTimes()
    self.maxTimes = self.actTypeClass:GetMaxTimes()
end

function SpBoxView:UpdateView()
    self:FreshData()
    self:LoadConsumesInfos()
    if self.upTimes == self.maxTimes then
        self.go_table.aortext_free.text = _G.GetLangPackValue(92010080002)
    else
        self.go_table.aortext_free.text = _G.GetLangPackValue(9002050015)
    end
    if self.upList then
        self.go_table.obj_Draw:SetActiveE(0)
        self.go_table.aorbtn_upgrate:SetActiveE(1)
        if #self.upList == 5 then
            self.go_table.obj_box:SetActiveE(0)
            self.go_table.obj_iconGroup:SetActiveE(0)
            self.go_table.obj_boxGroup:SetActiveE(1)
            for i = 1, 5 do
                local boxname = self.actTypeClass:GetBoxSpriteBySid(self.upList[i])
                --LogError(boxname, "uplist")
                self.go_table["aorrawimage_box" .. i]:LoadImage(boxname)
                local effbg = self.go_table["obj_effbg" .. i]
                local eff = self.go_table["obj_eff" .. i]

                _G.UIUtils.RemoveChildren(effbg)
                _G.UIUtils.RemoveChildren(eff)

                local isPlay = self.playType == DrawPlayType.Play
                if isPlay then
                    if string.contains(boxname, "baoshi5") then
                        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_SpBoxView_hign,
                            eff,
                            function(trans)
                                if self:IsNil() then
                                    _G.DestroyObject(trans)
                                end
                            end
                        )
                        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_SpBoxView_hign_bg,
                            effbg,
                            function(trans)
                                if self:IsNil() then
                                    _G.DestroyObject(trans)
                                end
                            end
                        )
                    elseif string.contains(boxname, "baoshi4") then
                        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_SpBoxView_mid,
                            eff,
                            function(trans)
                                if self:IsNil() then
                                    _G.DestroyObject(trans)
                                end
                            end
                        )
                        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_SpBoxView_mid_BG,
                            effbg,
                            function(trans)
                                if self:IsNil() then
                                    _G.DestroyObject(trans)
                                end
                            end
                        )
                    else
                        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_SpBoxView_low,
                            eff,
                            function(trans)
                                if self:IsNil() then
                                    _G.DestroyObject(trans)
                                end
                            end
                        )
                    end


                    if self.isInitUpEff[i] or self.IsUpBox then
                        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_SpBoxView_up,
                            eff,
                            function(trans)
                                if self:IsNil() then
                                    _G.DestroyObject(trans)
                                end
                            end
