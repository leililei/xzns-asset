end
---获取礼包id
function ArenaFairModel:GetGiftId()
    if not self.curActivityClas and not self.curActivityClass:GetActivityID() then
        return 0
    end
    return self.curActivityClass:GetActivityID() * 10000 + 10014
end

---获取兑换活动id
function ArenaFairModel:GetExchangeId()
    return self.exchangeId
end
---检测活动是否开放
function ArenaFairModel:CheckIsOpen()
    return self.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Open
end

return ArenaFairModel
