local base = require "ActivitySynTypeBase"
local ActivitySynManager = require "ActivitySynManager"
---@class ArenaFairModel : ActivitySynTypeBase
---@field arenaClass ArenaSingleClassFair
local ArenaFairModel = _G.BaseClass("ArenaFairModel", base)

function ArenaFairModel:__init()
end
---获取GM数据
function ArenaFairModel:OnHandleGMData(info)
    self:SetSelfData(info)
end

function ArenaFairModel:ParseData(info)
    if self.arenaClass then
        local ArenaManager = require "ArenaManager"
        if not self.arenaClass then
            self.arenaClass = ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.fair)
        end
        local endTime = self.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Settlement)
        info.justice.info.end_time = endTime
        info.justice.info.open_time = info.justice.info.end_time + 864000
        self.arenaClass:OnReConnectData(info.justice.info)
    end
    base.ParseData(self)
end

---@param info activity.i_activity_self_info
function ArenaFairModel:SetSelfData(info)
    self:InitArenaClass(info)
    --self:InitGift(info)
    if self.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Settlement
    or self.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Close then
        self.curActivityClass.curState = 1
        self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
    end
    self.arenaClass:SetActivity(self)
    require "ArenaFairManager":GetInstance():SetActivity(self)
    require "ArenaFairManager":GetInstance():SetCoin(info.justice.info.coin)
end
---初始化公平竞技场
function ArenaFairModel:InitArenaClass(info)
    local ArenaManager = require "ArenaManager"
    if not self.arenaClass then
        self.arenaClass = ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.fair)
    end
    local endTime = self.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Settlement)
    info.justice.info.end_time = endTime
    info.justice.info.open_time = info.justice.info.end_time + 864000
    self.arenaClass:ParseData(info.justice.info)
end

function ArenaFairModel:InitFunction()
end
---更新公平竞技场数据
function ArenaFairModel:UpdateArenaClass(callback)
    if not self:CheckIsOpen() then
        if callback then
            callback()
        end
        require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.ArenaFairLogin.id)
        return
    end
    require "ActivitySynNet":GetInstance():InitActivity(
        self.curActivityClass:GetActivityID(),
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self:InitArenaClass(msg.activity[1].self_info)
            if callback then
                callback()
            end
        end
    )
end

---进入活动
function ArenaFairModel:OnEnterActivity()
    if self.curActivityClass:GetCurActivityState() == require("ActivitySynManager").State.Open then
        require "ArenaController":GetInstance():OpenMainView(require "ArenaManager".arenaType.fair)
        base.OnEnterActivity(self)
    else
        _G.GlobalInterface.JumpActivityByGM(10005, self.curActivityClass:GetJumpType())
    end
end

---初始化红点
function ArenaFairModel:InitRedPointTree()
    self.redpointTree = {{_G.ConfigManager.redpoint_cfg.ArenaFairLogin.id}}
end

---根据定义的红点序列获取红点ID(活动id*100+index)
---@param index number 红点类型序列号
---@return number 红点ID
function ArenaFairModel:GetRedpointIDByIndex(index)
    if index == 1 then
        return self.curActivityClass:GetActivityID() * 100 + 1
    else
        return _G.ConfigManager.redpoint_cfg.ArenaFairLogin.id
    end
end

