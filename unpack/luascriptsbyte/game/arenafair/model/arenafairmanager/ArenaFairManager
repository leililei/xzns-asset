---@class ArenaFairManager : Singleton	中文描述
local ArenaFairManager = _G.BaseClass("ArenaFairManager", _G.Singleton)
_G.ArenaFairManager = ArenaFairManager

---@return ArenaFairManager ArenaFairManager
function ArenaFairManager:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function ArenaFairManager:__init()
    self.coin = 0
    _G.Events:GetInstance():AddListener(_G.eArena.SetFairCoin, self.AddCoin, self)
end

---销毁对象时,析构函数
function ArenaFairManager:Dispose()
end
---设置活动
function ArenaFairManager:SetActivity(activity)
    self.activity = activity
end
---设置coin
function ArenaFairManager:SetCoin(coin)
    self.coin = coin
end
---增加代币
function ArenaFairManager:AddCoin(num)
    self.coin = self.coin + num
    local tmp = {}
    _G.table.insert(tmp, 103)
    _G.table.insert(tmp, num)
    _G.table.insert(tmp, self.coin)
    _G.Events:GetInstance():Broadcast(_G.eItemUpdata.Updata, {{type = tmp}})
end
---获取代币
function ArenaFairManager:GetCoin()
    return self.coin or 0
end
---兑换id
function ArenaFairManager:SetExchangeId(id)
    self.exchangeId = id
end
---获取兑换id
function ArenaFairManager:GetExchangeId()
   return self.exchangeId or 0
end

return ArenaFairManager
