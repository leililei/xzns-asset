---@class SeasonGiftPackItem
---@field private go_table View._obj_giftItem_GoTable GoTable
local SeasonGiftPackItem = _G.BaseClass("SeasonGiftPackItem")
local CommonTipManager = require("CommonTipManager"):GetInstance()

---__init构造函数
---@protect
function SeasonGiftPackItem:__init(cardRoot)
    self.root = cardRoot
    self.go_table = _G.GetAutoGoTable(self.root, handler(self, self.OnClickBtn))

    if self.go_table.scrollloophorizontal_prop then
        self.go_table.scrollloophorizontal_prop:InitItemData(0, _G.handler(self, self.RefreshPropItem))
    end
end

function SeasonGiftPackItem:RefreshPropItem(index,obj)
    local newIndex = index + 1
    --local id = obj:GetInstanceIDE()
    --local item = self.itemList[id]
    local tb = GetAutoGoTable(obj)
    UIUtils.RemoveChildren(tb.obj_propNode)
    tb.obj_maskNode:SetActiveE(self.isGet and 1 or 0)
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        self.data.cfg.goods[newIndex],
        tb.obj_propNode,
        function(item)
            if self.go_table == nil then
                DestroyObject(item)
                return
            end
            item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
            local rect = item.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
            rect:SetRectTransformSize(100, 100)
            --local grade, type = _G.StorageManager:GetInstance():GetItemGrade(item.sid, item.uid)
            --if type == _G.StorageType.Spiritual then
            --    grade = grade + 3
            --end
        end
    )
end

---OnClickBtn 点击按钮
---@param go table
---@param isOn boolean
---@protect
function SeasonGiftPackItem:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Buy then
        --购买
        if self.callback then
            self.callback(self.data)
        end
    elseif go == self.go_table.aorbtn_Claim then
        --领取
        if self.callback then
            self.callback(self.data)
        end
    elseif go == self.go_table.aorbtn_Collected then
        --已领取
        --if self.callback then
        --    self.callback(self.data)
        --end
    elseif go == self.go_table.aorbtn_Recommended then
        --推荐
        if self.callback then
            self.callback(self.data)
        end
    elseif go == self.go_table.aorbtn_reward1 then
        CommonTipManager:OpenTip(self.go_table.aorrawimage_propicon,self.reward1.sid)
    elseif go == self.go_table.aorbtn_reward2 then
        CommonTipManager:OpenTip(self.go_table.aorrawimage_propicon2,self.reward2.sid)
    end
end

---@param data GiftPackData
---@param callback function
function SeasonGiftPackItem:RefreshItem(data,callback)
    self.data = data
    self.callback = callback
    self.isGet = false --是否已领取

    self.go_table.aorrawimage_icon:LoadImage(data.cfg.icon)
    self.go_table.aortext_title.text = GetLangPackValue(data.cfg.name)

    ---@type PropData
    self.reward1 = _G.StorageManager:GetInstance():GetItemDataClassByCfg(self.data.cfg.goods[1])
    ---@type PropData
    self.reward2 =  _G.StorageManager:GetInstance():GetItemDataClassByCfg(self.data.cfg.goods[2])
    self.otherReward = {}
    local count = #self.data.cfg.goods
    for i = 3, count do
        table.insert(self.otherReward,self.data.cfg.goods[i])
    end

    local btnState= data:GetGiftState()
    if data.isCumulativeCharging then
        self.go_table.aorbtn_Buy:SetActiveE(0)
        self.go_table.aortext_des:SetActiveE(1)
        self.go_table.aortext_des.text = GetLangPackValue(data.cfg.describe,_G.GameUtil.RatioControl(data.cfg.conditions))
        self.go_table.aorbtn_soldout:SetActiveE(0)
        if btnState == 1 then
            self.go_table.aorbtn_Recommended:SetActiveE(1)
            self.go_table.aorbtn_Claim:SetActiveE(0)
            self.go_table.aorbtn_Collected:SetActiveE(0)
        elseif btnState == 2 then
            self.go_table.aorbtn_Recommended:SetActiveE(0)
            self.go_table.aorbtn_Claim:SetActiveE(1)
            self.go_table.aorbtn_Collected:SetActiveE(0)
        elseif btnState == 3 then
            self.go_table.aorbtn_Recommended:SetActiveE(0)
            self.go_table.aorbtn_Claim:SetActiveE(0)
            self.go_table.aorbtn_Collected:SetActiveE(1)
            self.isGet = true
        end
    else
        self.go_table.aorbtn_Claim:SetActiveE(0)
        self.go_table.aortext_des:SetActiveE(0)
        self.go_table.aorbtn_Collected:SetActiveE(0)
        self.go_table.aortext_Price.text = GetLangPackValue(90049200012,data:GetBuyPrice())
        if btnState == 1 then
            self.go_table.aorbtn_Buy:SetActiveE(1)
            self.go_table.aorbtn_Recommended:SetActiveE(1)
            self.go_table.aorbtn_soldout:SetActiveE(0)
        elseif btnState == 3 then
            self.go_table.aorbtn_Buy:SetActiveE(0)
            self.go_table.aorbtn_Recommended:SetActiveE(0)
            self.go_table.aorbtn_soldout:SetActiveE(1)
            self.isGet = true
        elseif btnState == 4 then
            self.go_table.aorbtn_Recommended:SetActiveE(0)
            self.go_table.aorbtn_soldout:SetActiveE(0)
            self.go_table.aorbtn_Buy:SetActiveE(1)
        end
    end

    local showCount = #self.otherReward
    if showCount > 3 and self.data.isCumulativeCharging then
        showCount = 3
    end

    if self.go_table.scrollloophorizontal_prop and showCount > 3  then
        self.go_table.obj_awards:SetActiveE(0)
        self.go_table.scrollloophorizontal_prop:SetActiveE(1)
        self.go_table.scrollloophorizontal_prop:UpdateCount(showCount)
    else
        self.go_table.obj_awards:SetActiveE(1)
        if self.go_table.scrollloophorizontal_prop then
            self.go_table.scrollloophorizontal_prop:SetActiveE(0)
        end

        self.go_table.aorrawimage_propicon:LoadImage(self.reward1:GetIconPath())
        self.go_table.aorrawimage_propicon2:LoadImage(self.reward2:GetIconPath())
        self.go_table.obj_maskNode1:SetActiveE(self.isGet and 1 or 0)
        self.go_table.obj_maskNode2:SetActiveE(self.isGet and 1 or 0)
        self.go_table.aorrawimage_propicon:SetActiveE(self.isGet and 1 or 0)
        self.go_table.obj_effNode1:SetActiveE(self.isGet and 0 or 1)

        local Amount = GameUtil.RatioControl(require("SeasonRecordRechargeModel"):GetInstance():GetRecordNum())
        local needAmount = GameUtil.RatioControl(self.data.cfg.conditions)
        self.go_table.aortext_progress.text = GetLangPackValue(90030400011,Amount,needAmount)
        self.go_table.aortext_rewardDes.text = string.format("%s x%s",self.reward1:GetName(), tostring(self.reward1:GetCount()):AddColor("F4E79E"))
        self.go_table.aortext_rewardDes2.text = string.format("%s x%s",self.reward2:GetName(), tostring(self.reward2:GetCount()):AddColor("F4E79E"))
        GameUtil.SetChildCount(self.go_table.obj_awards,showCount,function(obj, index)
            local tb = GetAutoGoTable(obj)
            UIUtils.RemoveChildren(tb.obj_propNode)
            tb.obj_maskNode:SetActiveE(self.isGet and 1 or 0)
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                    self.otherReward[index],
                    tb.obj_propNode,
                    function(item)
                        if self.go_table == nil then
                            DestroyObject(item)
                            return
                        end
                        item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                        local rect = item.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
                        rect:SetRectTransformSize(100, 100)
                        local grade, type = _G.StorageManager:GetInstance():GetItemGrade(item.sid, item.uid)
                        if type == _G.StorageType.Spiritual then
                            grade = grade + 3
                        end
                        --if type == _G.StorageType.Artifact or type == _G.StorageType.Spiritual and grade > 1 or grade >= 5 then
                        --    tb.obj_Effect:SetActiveE(1)
                        --    _G.UIUtils.LoadEffectByPath(
                        --            "UI/UI_effect/BaseItemWithCount_effect/ef_BaseItemWithCount_cheng",
                        --            tb.obj_Effect,
                        --            function(obj)
                        --                if _G.IsNil(self.go_table) then
                        --                    _G.DestroyObject(obj)
                        --                    return
                        --                end
                        --            end,
                        --            nil,
                        --            nil,
                        --            nil,
                        --            nil,
                        --            nil,
                        --            true
                        --    )
                        --else
                        --    tb.obj_Effect:SetActiveE(0)
                        --end
                    end
            )
        end)
    end
end

---@return SeasonGiftPackItem
return SeasonGiftPackItem