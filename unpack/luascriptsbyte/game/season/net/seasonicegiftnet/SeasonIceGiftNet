local base = require "BaseGameNet"
---@class SeasonIceGiftNet : BaseGameNet	通信协议
local SeasonIceGiftNet = _G.BaseClass("SeasonIceGiftNet", base)

---@return SeasonIceGiftNet SeasonIceGiftNet
function SeasonIceGiftNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求
---@param pbData table PB数据
---@param callback function 完成回调
function SeasonIceGiftNet:GetInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_season_sweep_info
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---完成Boss任务
function SeasonIceGiftNet:FinishTask(pbData, callback)
    local item = _G.ConfigManager.net_map.game_season_sweep_finish
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function SeasonIceGiftNet:CallBack(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type SeasonIceGiftNet
_G.SeasonIceGiftNet = SeasonIceGiftNet
return SeasonIceGiftNet
