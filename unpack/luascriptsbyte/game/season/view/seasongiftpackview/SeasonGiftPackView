---@class SeasonGiftPackView:UIBaseView
---@field private go_table SeasonGiftPackView_GoTable GoTable
local SeasonGiftPackView = _G.BaseClass("SeasonGiftPackView", _G.UIBaseView)
local GiftPackData = require("GiftPackData")
local SeasonGiftPackItem = require("SeasonGiftPackItem")
local SeasonPackItem = require("SeasonPackItem")


---@class SeasonGiftPackView.tagEnum
---@field FirstCharge
---@field GiftPackage

---@class SeasonGiftPackView.viewData
---@field viewTable SeasonGiftPackView._obj_teQuan_GoTable
---@field tagTable SeasonGiftPackView._toggle_firstcharge_GoTable
---@field gift1 SeasonGiftPackItem
---@field gift2 SeasonGiftPackItem
---@field looplist looplist

---@param selectTag SeasonGiftPackView.tagEnum
function SeasonGiftPackView:OnCreate(selectTag)
    self.SeasonGiftPackTag = {
        FirstCharge = "FirstCharge",
        GiftPackage = "GiftPackage"
    }
    self:InitData(selectTag)
    self:InitUI()
    self.go_table.toggle_firstcharge.isOn = false
    self.go_table.toggle_gift.isOn = false
    self.go_table.toggle_firstcharge.isOn = true
    if selectTag then
        self.CurSelectTag = selectTag
    end
    self:RefreshData()
    self:RefreshUI()
    --self:RefreshTag()
end

function SeasonGiftPackView:OnEnable()
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

function SeasonGiftPackView:OnDisable()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

function SeasonGiftPackView:InitData(selectTag)
    --self.model =
    ---@type table<SeasonGiftPackView.tagEnum,GiftPackData[]>
    self.GiftPackData = {}
    ---@type SeasonModel
    self.SeasonModel = require "SeasonModel":GetInstance()
    self.seasonId = self.SeasonModel:GetCurSeasonId()
    ---@type season_cfg
    self.cfg = _G.ConfigManager.season_cfg[self.seasonId]

    self.GiftModel = require("SuperValuGiftModel"):GetInstance()
    self.model_cfg = self.GiftModel.model_cfg

    self.CurSelectTag = self.SeasonGiftPackTag.FirstCharge
    if selectTag then
        self.CurSelectTag = selectTag
    end

    ---@type  table<SeasonGiftPackView.tagEnum,SeasonGiftPackView.viewData>
    self.tagBtnGoTables = {}

    local count = #self.model_cfg
    for i = 1, count do
        local giftType = self.SeasonGiftPackTag.GiftPackage
        local listData = self.GiftPackData[giftType]
        if listData == nil then
            self.GiftPackData[giftType] = {}
            listData = self.GiftPackData[giftType]
        end
        ---@type GiftPackData
        local data = GiftPackData.New()
        data:InitData(self.model_cfg[i].id)
        data:RefreshDataForModel()
        table.insert(listData, data)
    end
    count = #self.cfg.season_recharge[1]
    for i = 1, count do
        local giftType = self.SeasonGiftPackTag.FirstCharge
        local listData = self.GiftPackData[giftType]
        if listData == nil then
            self.GiftPackData[giftType] = {}
            listData = self.GiftPackData[giftType]
        end
        ---@type GiftPackData
        local data = GiftPackData.New()
        data:InitData_Charge(self.cfg.season_recharge[1][i])
        data:RefreshDataForModel()
        table.insert(listData, data)
    end

    ---@type SeasonPackItem[]
    self.itemList = {}
end

function SeasonGiftPackView:RefreshData()
    self.CurSelectView = self.tagBtnGoTables[self.CurSelectTag]
    self.curShowGifts = self.GiftPackData[self.CurSelectTag]

    if self.CurSelectTag == self.SeasonGiftPackTag.GiftPackage then
        local count = #self.curShowGifts
        local canpicklist = {}
        local canBuylist = {}
        local receivedlist = {}
        for i = 1, count do
            local state = self.curShowGifts[i]:GetGiftState()
            if state == 2 then
                table.insert(canpicklist, self.curShowGifts[i])
            elseif state == 4 then
                table.insert(canBuylist, self.curShowGifts[i])
            elseif state == 3 then
                table.insert(receivedlist, self.curShowGifts[i])
            end
        end
        self.curShowGifts = {}
        self:list_Add(self.curShowGifts, canpicklist)
        self:list_Add(self.curShowGifts, canBuylist)
        self:list_Add(self.curShowGifts, receivedlist)
    end
end

function SeasonGiftPackView:list_Add(list, Addlist)
    local count = #Addlist
    for i = 1, count do
        table.insert(list, Addlist[i])
    end
end

function SeasonGiftPackView:InitUI()
    GetAutoGoTable(self.transform, handler(self, self.OnlickBtn))
    ---@type SeasonGiftPackView._obj_teQuan_GoTable
    local tag1gotable = GetAutoGoTable(self.go_table.obj_teQuan)
    _G.GameUtil.SetUiHeXieMask(_G.GetAutoGoTable(tag1gotable.obj_giftItem))
    _G.GameUtil.SetUiHeXieMask(_G.GetAutoGoTable(tag1gotable.obj_giftItem2))
    self.tagBtnGoTables[self.SeasonGiftPackTag.FirstCharge] = {
        viewTable = tag1gotable,
        tagTable = GetAutoGoTable(self.go_table.toggle_firstcharge,
                _G.handlerbind(self, self.OnClickToggle,
                        self.SeasonGiftPackTag.FirstCharge, _G.handler(self, self.OnToggleBack))),
        gift1 = SeasonGiftPackItem.New(tag1gotable.obj_giftItem),
        gift2 = SeasonGiftPackItem.New(tag1gotable.obj_giftItem2),
    }
    ---@type SeasonGiftPackView._obj_teQuan2_GoTable
    local tag1gotable2 = GetAutoGoTable(self.go_table.obj_teQuan2)
    self.tagBtnGoTables[self.SeasonGiftPackTag.GiftPackage] = {
        viewTable = tag1gotable2,
        tagTable = GetAutoGoTable(self.go_table.toggle_gift,
                _G.handlerbind(self, self.OnClickToggle,
                        self.SeasonGiftPackTag.GiftPackage, _G.handler(self, self.OnToggleBack))),
        --gift1 = SeasonGiftPackItem.New(tag1gotable2.obj_giftItem),
        --gift2 = SeasonGiftPackItem.New(tag1gotable2.obj_giftItem2),
        looplist = tag1gotable2.scrollloopvectical_Pack
    }
    self.tagBtnGoTables[self.SeasonGiftPackTag.GiftPackage].looplist:InitItemData(0, _G.handler(self, self.RefreshSeasonPackItem))

    local resources = _G.ConfigManager.ui_cfg.MainView.resources
    if #resources > 0 then
        self:AddComponent(
                self.go_table.obj_GoldInfo,
                require("ResourceCompont").New(self.go_table.obj_GoldInfo, resources)
        )
    end
    self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))

    self.tagBtnGoTables[self.SeasonGiftPackTag.FirstCharge].tagTable.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.SeasonRecordRecharge.id)
    self.tagBtnGoTables[self.SeasonGiftPackTag.GiftPackage].tagTable.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.SuperValuGift.id)

    _G.PlayerPrefsManager.SetInt("SeasonRecordRecharge", require("SeasonModel"):GetInstance():GetCurSeasonId())
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SeasonRecordRecharge.id)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SuperValuGift.id)
end

--赛季礼包循环列表
function SeasonGiftPackView:RefreshSeasonPackItem(index, obj)
    local newIndex = index + 1
    local data = self.curShowGifts[newIndex]
    local id = obj:GetInstanceIDE()
    local item = self.itemList[id]
    if item == nil then
        item = SeasonPackItem.New(self, obj)
        self.itemList[id] = item
    end
    item:RefreshItem(data, handler(self, self.OnlickBuyOrGet))
end

function SeasonGiftPackView:onGetPackBack(data)

end

---@param data GiftPackData
function SeasonGiftPackView:OnlickBuyOrGet(data)
    if data.isCumulativeCharging then

        if data:IsCanBuy() == false then
            self.CurSelectTag = self.SeasonGiftPackTag.GiftPackage
            self:RefreshData()
            self:RefreshUI()
            return
        end
        --self.GiftModel.model_cfg
        require("SeasonRecordRechargeModel"):GetInstance():ReceiveAward(data.cfg.id, function()
            data:RefreshDataForModel()
            self:RefreshUI()
        end)
    else
        if data.cfg.type_1 == 2 then
            require("MonthlyModel"):GetInstance():BuyRmb(data.cfg.id, data.cfg.price_id, require("MallManager").MallType.monthCard)
            --回调OnMallCashListener()方法
        end
    end
end

--充值成功回调
function SeasonGiftPackView:OnMallCashListener()

    local list = self.GiftPackData[self.SeasonGiftPackTag.GiftPackage]
    for i, v in pairs(list) do
        v:RefreshDataForModel()
    end

    self:RefreshData()
    self:RefreshUI()
end

function SeasonGiftPackView:RefreshUI()
    self:RefreshTag()
    if self.curShowGifts == nil then
        return
    end
    if self.CurSelectTag == self.SeasonGiftPackTag.GiftPackage then
        self.CurSelectView.looplist:UpdateCount(#self.curShowGifts)
        GameUtil.SetCardUiSpineAnimation(self.CurSelectView.viewTable.obj_role_Node:GetChildE(0), "idle", true)
        --self.CurSelectView.looplist:UpdateAllItem()
    else
        self.CurSelectView.gift1:RefreshItem(self.curShowGifts[1], handler(self, self.OnlickBuyOrGet))
        if self.curShowGifts[2] then
            self.CurSelectView.gift2.go_table.transform:SetActiveE(1)
            self.CurSelectView.gift2:RefreshItem(self.curShowGifts[2], handler(self, self.OnlickBuyOrGet))
        else
            self.CurSelectView.gift2.go_table.transform:SetActiveE(0)
        end
    end
end

function SeasonGiftPackView:OnlickBtn(btn)
    if btn == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end
function SeasonGiftPackView:OnToggleBack()
    self:RefreshData()
    self:RefreshUI()
end

function SeasonGiftPackView:OnClickToggle(_, isOn, key, callback)
    local tb = self.tagBtnGoTables[key]
    tb.tagTable.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    tb.tagTable.aorimage_isOn:SetActiveE(isOn and 1 or 0)

    if isOn and key ~= self.CurSelectTag then
        self.CurSelectTag = key
        if callback then
            callback()
        end
    end
end
function SeasonGiftPackView:RefreshTag()
    for tag, data in pairs(self.tagBtnGoTables) do
        local isSelect = tag == self.CurSelectTag
        data.tagTable.aorimage_isOn:SetActiveE(isSelect and 1 or 0)
        data.tagTable.aorimage_isOff:SetActiveE(not isSelect and 1 or 0)
        data.viewTable.transform:SetActiveE(isSelect and 1 or 0)
    end
end

function SeasonGiftPackView:RefreshGiftItem(id)
    local season_recharge_cfg = ConfigManager.season_recharge_cfg
    local SeasonRecordRechargeModel = require("SeasonRecordRechargeModel")
    ---@type SeasonRecordRechargeView._obj_item_GoTable
    local tb = GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, id))
    ---@type season_recharge_cfg
    local cfg = season_recharge_cfg[id]
    tb.goods = cfg.goods
    local state = SeasonRecordRechargeModel:GetInstance():GetAwardState(id)
    tb.state = state
    tb.aorbtn_get:SetActiveE(state ~= AwardState.HasReceived and 1 or 0)
    tb.aorbtn_get:SetGray(state ~= AwardState.CanReceive)
    tb.obj_redpoint:SetActiveE(state == AwardState.CanReceive and 1 or 0)
    tb.aorimage_redpoint:SetActiveE(state == AwardState.CanReceive and 1 or 0)
    tb.aorimage_isGet:SetActiveE(state == AwardState.HasReceived and 1 or 0)
    local curPrice = _G.GameUtil.RatioControl(cfg.conditions)
    --tb.aortext_num.text = curPrice
    tb.aortext_num.text = GetLangPackValue(90038000003, curPrice)
    if tb.init then
        tb.scrollloophorizontal_award:UpdateCount(#cfg.goods)
    else
        tb.scrollloophorizontal_award:InitItemData(#cfg.goods, _G.handlerbind(self, self.RefreshAwardList, tb))
        tb.init = true
    end
    --_G.GameUtil.ReBuildRTF(tb.obj_aimText)
end

---@return SeasonGiftPackView
return SeasonGiftPackView