---@class SeasonBossView : UIBaseView	中文描述
---@field public go_table SeasonBossView_GoTable GoTable
---@field cfg season_boss_cfg
---@field cardList SeasonBossView._obj_item1_GoTable[]
local SeasonBossView = _G.BaseClass("SeasonBossView", _G.UIBaseView)
--_G.SeasonBossView = SeasonBossView

function SeasonBossView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SeasonBossView:OnCreate()
    self.cfg = require "SeasonBossModel":GetInstance().cfg
    self:InitView()
    self:AddListener(_G.eSeason.SeasonRefreshModel, self.RefreshView)
end
---初始化界面显示
function SeasonBossView:InitView()
    self:InitBoss()
    self:InitSkills()
    self:InitAddCard()
    self:UpdateDamages()
end
--region Boss
---更新Boss显示
function SeasonBossView:InitBoss()
    ---@type card_cfg
    local cfg = _G.ConfigManager.card_cfg[self.cfg.monster]
    if not cfg then
        ---@type monster_group_cfg
        local mg_cfg = _G.ConfigManager.monster_group_cfg[self.cfg.monster_group]
        for _, v in pairs(mg_cfg.DefaultDefenserSids[1]) do
            if v > 0 then
                cfg = _G.ConfigManager.monster_cfg[v]
                break
            end
        end
        if cfg then
            local cardCfg = _G.ConfigManager.card_cfg[cfg.CardID]
            if cardCfg then
                self.go_table.aorrawimage_boss:LoadImage(
                    cardCfg.Portrait,
                    function()
                        self.go_table.aorrawimage_boss:SetNativeSize()
                    end
                )
            end
        end
    else
        self.go_table.aorrawimage_boss:LoadImage(cfg.Portrait)
    end
    self.go_table.aorrawimage_title:LoadImage(self.cfg.monster_name)
    self.go_table.aortext_desc.text = _G.LangUtil.GetLangPackValue(self.cfg.desc)
end

--endregion

--region 技能
function SeasonBossView:InitSkills()
    for i = 1, 3 do
        ---@type SeasonBossView._obj_skill1_GoTable
        local tb = _G.GetAutoGoTable(self.go_table["obj_skill" .. i], _G.handlerbind(self, self.OnClickSkill, i))
        local id = self.cfg.skill[i]
        if id then
            ---@type card_skills_cfg
            local cfg = _G.ConfigManager.card_skills_cfg[id]
            tb.aorrawimage_icon:LoadImage(cfg.icon)
        end
    end
end

---点击技能
function SeasonBossView:OnClickSkill(_, _, index)
    require "CommonTipManager":GetInstance():OpenSkillTip(self.cfg.skill[index])
end
--endregion

--region 增伤
function SeasonBossView:InitAddCard()
    if not self.cardList then
        self.cardList = {}
    end

    for i = 1, 2 do
        if not self.cardList[i] then
            self.cardList[i] = _G.GetAutoGoTable(self.go_table["obj_item" .. i])
        end

        if self.cfg.cards_bonus[i] then
            if not self.cardList[i].card then
                _G.ItemCardFactory:GetInstance():GetItemCard(
                    _G.ItemCardFactory.itemCardType.CardAllItem,
                    self.cardList[i].obj_Root,
                    function(item)
                        if _G.IsNil(self.go_table) then
                            _G.DestroyObject(item.go_table.gameObject)
                            return
                        end
                        ---@type ItemCardAllView
                        self.cardList[i].card = item
                        self.cardList[i].card:Show(
                            self.cfg.cards_bonus[i],
                            _G.handlerbind(self, self.OnClickCard, self.cfg.cards_bonus[i])
                        )
                        self:UpdateAddCardUp(i)
                    end
                )
            else
                self.cardList[i].card:Show(
                    self.cfg.cards_bonus[i],
                    _G.handlerbind(self, self.OnClickCard, self.cfg.cards_bonus[i])
                )
                self:UpdateAddCardUp(i)
            end
            self.cardList[i].aortext_num.text =
                (_G.math.floor(_G.ConfigManager.discrete_cfg[105106][1][1] / 100)) .. "%"
            self.cardList[i].aortext_title.text = "[" .. _G.LangUtil.GetLangPackValue(self.cfg.title[i]) .. "]"
        else
            _G.GameUtil.SetActiveByCondition(self.cardList[i].gameObject, false)
        end
    end
end

function SeasonBossView:OnClickCard(_, sid)
    require "CommonTipManager":GetInstance():OpenCardTip(sid)
end

---更新卡牌显示
function SeasonBossView:UpdateAddCardUp(index)
    local id = self.cfg.cards_bonus[index]
    local sids = require "EmbattleModel":GetInstance():GetEmbattleSidsData(_G.EmbattleType.SeasonBoss)
    local isHave = false
    if sids then
        for _, v in pairs(sids) do
            if v == id then
                isHave = true
                break
            end
        end
    end
    self.cardList[index].aortext_title3.text = _G.string.format("（%s/1）", isHave and 1 or 0)
    _G.GameUtil.SetActiveByCondition(self.cardList[index].obj_put, isHave)
    self:CardSetGray(index, not isHave)
end

---置灰
function SeasonBossView:CardSetGray(index, isGray)
    local tb = self.cardList[index]
    tb.card.go_table.aorimage_ColorBg:SetGray(isGray)
    tb.card.go_table.aorimage_Icon:SetGray(isGray)
    tb.card.go_table.aorimage_diban:SetGray(isGray)
    tb.card.go_table.aorimage_Color:SetGray(isGray)
    tb.card.go_table.aorimage_renLing:SetGray(isGray)
    tb.card.go_table.aorimage_Elements:SetGray(isGray)
    for i = 1, 5 do
        tb.card.go_table["aorimage_huo" .. i]:SetGray(isGray)
    end
    tb.aorimage_up:SetGray(isGray)
    if isGray then
        tb.aortext_num.color = _G.ColorTools.FormatColorByString("9d9d9d")
    else
        tb.aortext_num.color = _G.ColorTools.FormatColorByString("5bdf99")
    end
end

--endregion
---更新造成伤害
function SeasonBossView:UpdateDamages()
    self.go_table.aortext_power.text =
        "最高伤害:" ..
        _G.string.AddColor(
            _G.GameUtil.NumberToUnitStrFight(require "SeasonBossModel":GetInstance().infoData.day_dps),
            "feae46"
        )
end

function SeasonBossView:OnFight()
    require "SeasonBossModel":GetInstance():OnChallenge()
end

---按钮点击事件在这里派发
function SeasonBossView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_rank then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SeasonBossRankView.Name)
    elseif go == self.go_table.aorbtn_task then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SeasonBossTaskView.Name)
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_fight then
        self:OnFight()
    elseif go == self.go_table.aorbtn_playWay then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 31)
    end
end
---刷新界面
function SeasonBossView:RefreshView(id)
    if id == _G.FunctionID.SeasonBoss then
        self.cfg = require "SeasonBossModel":GetInstance().cfg
        self:InitView()
    end
end

return SeasonBossView
