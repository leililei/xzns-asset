---@class SeasonBigGiftView : UIBaseView	中文描述
---@field public go_table SeasonBigGiftView_GoTable GoTable
local SeasonBigGiftView = _G.BaseClass("SeasonBigGiftView", _G.UIBaseView)

function SeasonBigGiftView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SeasonBigGiftView:OnCreate()
    self.go_table.aortext_title.text = _G.GetLangPackValue(90025500072, _G.GetPlayerName())
    local bigGift = require "SeasonModel":GetInstance():GetCfg().gift
    for _, v in pairs(bigGift) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(v, self.go_table.obj_items,function(item)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end)
    end

    local check = function(obj)
        if self:IsNil() then
            _G.UIUtils.RemoveEffect(obj)
        end
    end
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_SeasonBigGiftView_once, self.go_table.obj_eff, check)
    _G.DelayDo(0.75, function()
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_SeasonBigGiftView_chendi, self.go_table.obj_effBg, check)
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_SeasonBigGiftView_title, self.go_table.obj_effCover, check)
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_SeasonBigGiftView_dog, self.go_table.obj_effDog, check)
        self.go_table.obj_main:SetActiveE(1)
        _G.DelayDo(0.75, function()
            self.go_table.obj_content:SetActiveE(1)
        end)
    end)
end


---按钮点击事件在这里派发
function SeasonBigGiftView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_accept then
        require "SeasonModel":GetInstance():GetBigGift(function()
            self:Close()
        end)
    end
end

return SeasonBigGiftView
