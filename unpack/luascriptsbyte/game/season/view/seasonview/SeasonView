function SeasonView:UpdateButton()
    for i = 1, 8 do
        ---@type SeasonView._aorbtn_1_GoTable
        local systeId = self.cfg.system[i]
        local isShow, icon, onclick = SeasonModel:ShowExtraIcon(systeId)
        local tb = _G.GetAutoGoTable(self.go_table["aorbtn_" .. i], _G.handlerbind(self, self.ExtraOnclick, onclick))
        if systeId == 0 then
            tb.gameObject:SetActiveE(0)
        elseif systeId == _G.FunctionID.MaterialGift then
            tb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.MaterialGift.id,
                _G.MainFunctionItems.MaterialCard)
        else
            local id = SeasonModel:GetRedPointId(systeId) or 0
            --id为负数时设置为赛季红点的参数
            if id < 0 then
                tb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.FirstTest.id, -id)
            else
                tb.obj_redpoint:UpdateRedPointItemIDAndParam(id)
            end
            tb.aorbtn_extra:SetActiveE(isShow)
            if isShow == 1 then
                tb.aorrawimage_extra:LoadImage(icon)
            end
            if systeId == _G.FunctionID.SeasonTower then
                self:SetObj_seasonTowerTip(1,tb.gameObject)
                self:UpdateSeasonTowerTip()
            end
        end
    end
end

function SeasonView:UpdateSeasonTowerTip()
    local SeasonTowerModelIns = require("SeasonTowerModel"):GetInstance()

    if SeasonTowerModelIns:GetStageCfg() == nil then
        return
    end
    self.go_table.obj_seasonTowerTip:SetLocalPosition(-140, 22, 0)
    self:SetObj_seasonTowerTip(1)
    local curTowerId = SeasonTowerModelIns.curTowerId or 0
    local towerId = curTowerId > 0 and curTowerId or SeasonTowerModelIns:GetStageCfg().season_tower[1]
    if SeasonTowerModelIns:CheckCanOpenNextStage() then
        local nextStageCfg = _G.ConfigManager.season_tower_pools_cfg[SeasonTowerModelIns.stage + 1]
        local endTime = SeasonTowerModelIns:GetStartTime() + (nextStageCfg.time - 1) * 86400
        local time = _G.TimeUtil.GetServerUnixTime()
        if time >= endTime then
            towerId = nextStageCfg.season_tower[1]
        end
    end
    local cfg = _G.ConfigManager.season_tower_cfg[towerId]
    self.go_table.aortext_seasonTowerStage.text = _G.GetLangPackValue(90026100020, cfg.stage)
end

function SeasonView:ShowMaterialGiftBtn(tb, systeId)
    local _type = SeasonModel:GetCurSeasonId() == 1 and 1 or 3                                  ---ZHJH-5591 第二赛季临时处理
    local data = require("MaterialGiftModel"):GetInstance():GetGiftData(_type, true)
    if require("MaterialGiftModel"):GetInstance():CheckIsOpen(_type) or data.buyCount >= 7 then --买完也显示
        tb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.MaterialGift.id,
            _G.MainFunctionItems.MaterialCard)
        tb.aorbtn_extra:SetActiveE(0)
        ---@type function_open_cfg
        local cfg = _G.ConfigManager.function_open_cfg[systeId]
        tb.aortext_name.text = _G.GetLangPackValue(cfg.name)
        tb.aorimage_icon.SpriteName = self.cfg.main_button[1]
        tb.aorimage_icon:SetNativeSize()
        tb.aorimage_lock:SetActiveE(0)
    else
        tb.gameObject:SetActiveE(0)
    end
end

return SeasonView
