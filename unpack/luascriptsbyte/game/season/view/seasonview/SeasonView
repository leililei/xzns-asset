---@param tb SeasonView._aorbtn_roulette_GoTable
function SeasonView:SetUnitBtnGotable(systeId,tb,btnIcon)
    local id = SeasonModel:GetRedPointId(systeId) or 0
    local isShow, icon, onclick = SeasonModel:ShowExtraIcon(systeId)
    if id < 0 then
        tb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.FirstTest.id, -id)
        require("RedPointFirstTest"):CheckParams(-id)
    else
        tb.obj_redpoint:UpdateRedPointItemIDAndParam(id)
    end
    tb.aorbtn_extra:SetActiveE(isShow)
    if isShow == 1 then
        tb.aorrawimage_extra:LoadImage(icon)
    end
    ---@type function_open_cfg
    local cfg = _G.ConfigManager.function_open_cfg[systeId]
    tb.aortext_name.text = _G.GetLangPackValue(cfg.name)
    tb.aorrawimage_icon:LoadImage(btnIcon)
    tb.aorrawimage_icon:SetNativeSize()
    if EffectTb[systeId] then
        _G.UIUtils.LoadEffectByCfg(
            EffectTb[systeId],
            tb.gameObject,
            function(trans)
                if self:IsNil() then
                    _G.DestroyImmediate(trans)
                end
            end
        )
    end
end


function SeasonView:InitEffect()
    local check = function(obj)
        if self:IsNil() then
            _G.UIUtils.RemoveEffect(obj)
            return false
        end
        _G.table.insert(self.effectTb, obj)
        return true
    end

    for _, v in pairs(self.effectTb) do
        _G.DestroyObject(v)
    end
    for k, v in pairs(self.cfg.main_special_effect) do
        if #v > 0 then
            local cfg = _G.ConfigManager.ui_effect_cfg
            if #v == 1 and cfg[v[1]] then
                _G.UIUtils.LoadEffectByCfg(
                        cfg[v[1]],
                        self.go_table.obj_bgEff,
                        function(obj)
                            check(obj)
                        end)
            end
        end
    end
end

--- 加载绑定在spine骨骼上的特效，需要在spine加载后调用
---@param spineTrans UnityEngine.Transform spine对象
function SeasonView:LoadSpineEffect(spineTrans)
    local check = function(obj)
        if self:IsNil() then
            _G.UIUtils.RemoveEffect(obj)
            return false
        end
        _G.table.insert(self.effectTb, obj)
        return true
    end
    local spObj, bone, sg
    sg = spineTrans:GetChildE(0):GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
    for _, v in pairs(self.cfg.main_special_effect) do
        if #v > 0 then
            local cfg = _G.ConfigManager.ui_effect_cfg
            if #v == 2 and cfg[v[1]] then
                if v[2] then
                    spObj = _G.InstantiateObject(self.go_table.obj_spineEff, spineTrans)
                    bone = spObj:GetComponentE(_G.typeof(_G.CS.Spine.Unity.BoneFollowerGraphic))
                    bone.skeletonGraphic = sg
                    bone.boneName = v[2]
                else
                    if _G.AppSetting.DEBUG then
                        _G.LogError(v[1] .. " 特效没有设置绑定骨骼,请检查是否为spine的特效")
                    end
                    spObj = self.go_table.obj_bgEff
                end
                _G.UIUtils.LoadEffectByCfg(
                    cfg[v[1]],
                    spObj,
                    function(obj)
                        check(obj)
                    end)
            end
        end
    end
end

