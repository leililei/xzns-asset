end

---更新赛季事件
function SeasonView:UpdateTime()
    self.countDown = require "SeasonModel":GetInstance():GetTime().settlementTime - _G.TimeUtil.GetServerUnixTime()
    self:RefreshTime(0)
    if self.timer == nil then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.RefreshTime, self, false, false, true)
        self.timer:Start()
    end
end

function SeasonView:RefreshTime(elapsed)
    self.countDown = self.countDown - elapsed
    local time = _G.TimeUtil.TranslateSecondForStrMiaoHui(_G.Mathf.RoundToInt(self.countDown))
    if AppSetting.IsXzns then
        self.go_table.aortext_time.text = _G.GetLangPackValue(90025800003, time)
    else
        self.go_table.aortext_time.text = _G.GetLangPackValue(90025800003, _G.string.AddColor(time, "96CE51"))
    end
end

function SeasonView:RefreshPanel()
    self:UpdateSlider()
    for i = 1, 7 do
        self:UpdateAwardShow(i)
    end
end

function SeasonView:UpdateMidShow()
    self.go_table.aorrawimage_bg:LoadImage(
        self.cfg.main_background[1],
        function(raw)
            if self:IsNil() then
                _G.DestroyObject(raw)
                return
            end
            self.go_table.aorrawimage_bg:SetNativeSize()
            raw.Alpha = 1
            self.gameObject:SetActiveE(1)
        end
    )
    local preMBg = self.cfg.main_background_foreground[1]
    if preMBg and preMBg[1] ~= "0" then
        self.go_table.aorrawimage_midPreBg:LoadImage(preMBg[1], function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            self.go_table.aorrawimage_midPreBg:SetNativeSize()
            self.go_table.aorrawimage_midPreBg:SetLocalPosition(_G.tonumber(preMBg[2]), _G.tonumber(preMBg[3]),
                _G.tonumber(preMBg[4]))
            self.go_table.aorrawimage_midPreBg:SetLocalScaleXYZ(_G.tonumber(preMBg[5]))
        end)
    end
    local preBBg = self.cfg.main_background_foreground[2]
    if preBBg and preBBg[1] ~= "0" then
        self.go_table.aorrawimage_bottomPreBg:LoadImage(preBBg[1], function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            self.go_table.aorrawimage_bottomPreBg:SetNativeSize()
            self.go_table.aorrawimage_bottomPreBg:SetLocalPosition(_G.tonumber(preBBg[2]), _G.tonumber(preBBg[3]),
                _G.tonumber(preBBg[4]))
            self.go_table.aorrawimage_bottomPreBg:SetLocalScaleXYZ(_G.tonumber(preBBg[5]))
        end)
    end
    if not _G.table.isEmptyOrNil(self.cfg.main_spine) then
        _G.PoolsManager:GetInstance():Spawn(
            self.cfg.main_spine[1],
            _G.ePoolType.Temporary,
            self.go_table.aorrawimage_role,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                self.gameObject:SetActiveE(1)
                self:LoadSpineEffect(trans)
            end
        )
        self.go_table.aorrawimage_role:SetLocalPosition(
            self.cfg.main_spine_coefficient[1],
            self.cfg.main_spine_coefficient[2],
            self.cfg.main_spine_coefficient[3]
        )
        self.go_table.aorrawimage_role:SetLocalScaleXYZ(self.cfg.main_spine_coefficient[4])
    end
    if not _G.table.isEmptyOrNil(self.cfg.main_calligraphy) then
        self.go_table.aorrawimage_front:LoadImage(
            self.cfg.main_calligraphy[1],
            function(raw)
                if raw then
                    raw.Alpha = 1
                    self.gameObject:SetActiveE(1)
                    raw:SetNativeSize()
                end
            end
        )
        self.go_table.aorrawimage_front:SetLocalPosition(
            self.cfg.main_calligraphy_coefficient[1],
            self.cfg.main_calligraphy_coefficient[2],
            self.cfg.main_calligraphy_coefficient[3]
        )
        self.go_table.aorrawimage_front:SetLocalScaleXYZ(self.cfg.main_calligraphy_coefficient[4])
    else
        self.go_table.aorrawimage_front.Alpha = 0
    end
    -- self:PlayRoleAni()
end

