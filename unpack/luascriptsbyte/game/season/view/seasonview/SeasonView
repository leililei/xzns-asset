---@type SeasonModel
local SeasonModel
function SeasonView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eSeasonTower.SeasonTowerRefreshView, self.UpdateButton)
   
    self.gameObject:SetActiveE(0)
    if _G.AppSetting.IsXzns then
        local isShowVideo = require("VideoViewManager"):GetInstance():CheckSeasonVideo()
        self.go_table.aorbtn_PlayVideo:SetActiveE(isShowVideo == true and 1 or 0)
        if isShowVideo then
            require("VideoViewManager"):GetInstance():PlaySeasonVideo(true)
        end
    end
end

---界面的入口函数
---@param id number 打开功能界面
function SeasonView:OnCreate(id)
    if _G.AppSetting.IsXzns then
        _G.GameUtil.SetUiHeXieMask(self.go_table)
    end
    SeasonModel = require "SeasonModel":GetInstance()
    self.seasonId = SeasonModel:GetCurSeasonId()
    self.cfg = _G.ConfigManager.season_cfg[self.seasonId]
    self.effectTb = {}
    self:InitView()
    --self:AddListener(_G.eSeason.SeasonRefreshModel, self.RefreshPanel)
    if id then
        require "SeasonManager":GetInstance():OpenView(id)
    end

    if AppSetting.IsXzns then
        if self.cfg.timeColor then
            local count = #self.cfg.timeColor
            for i = 1, count do
                UIUtils.ChangeUIMethod(self.cfg.timeColor[i],self.go_table.aortext_time)
            end
        end
    end
end

---初始化界面
function SeasonView:InitView()
    self:UpdateTime()
    self:UpdateMidShow()
    --self:UpdateSlider()
    self:InitEffect()
    self:UpdateButton()
    self:InitBtn()
    -- require("SeasonSGiftModel"):GetInstance():PanDuan()
    self:AddListener(_G.eBattleState.RecordStart, self.Hide)
    self:AddListener(_G.eBattleState.RecordEnd, self.Show)
end

-- ---播放角色动画
function SeasonView:PlayRoleAni()
    local Tweening = _G.CS.DG.Tweening
    local y = self.cfg.main_spine_coefficient[2] or 0
    self.tweer =
        self.go_table.aorrawimage_role:DOLocalMoveY(y + 20, 1.5):SetEase(Tweening.Ease.InOutSine):SetLoops(
            -1,
            Tweening.LoopType.Yoyo
        )
end

function SeasonView:Hide()
    if self.gameObject:GetActiveSelf() == 0 then
        self.isHide = true
    end
    self.super.Hide(self)
end

function SeasonView:Show()
    if self.isHide then
        return
    end
    self.super.Show(self)
end

function SeasonView:InitBtn()
    local btnStyle = self.cfg.main_interface_title
    local fontSize = _G.tonumber(btnStyle[1][1])
    local outlineColor = _G.ColorTools.FormatColorByString(btnStyle[2][1])
    local colors = {}
    local alphas = {}
    for i = 3, #btnStyle do
        _G.table.insert(colors, btnStyle[i][1])
        _G.table.insert(alphas, btnStyle[i][2])
    end
    for i = 1, 8 do
        ---@type SeasonView._aorbtn_1_GoTable
        local systeId = self.cfg.system[i]
        if systeId then
            local isShow, icon, onclick = SeasonModel:ShowExtraIcon(systeId)
            local tb =
                _G.GetAutoGoTable(self.go_table["aorbtn_" .. i], _G.handlerbind(self, self.ExtraOnclick, onclick))
            if systeId == 0 then
                tb.gameObject:SetActiveE(0)
            elseif systeId == _G.FunctionID.MaterialGift then
                self:ShowMaterialGiftBtn(tb, systeId)
                tb.aortext_name.fontSize = fontSize
                tb.aortext_name:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor
                CommonTipManager:GetInstance():SetTextGradient(colors, alphas, tb.aortext_name)
            else
                local id = SeasonModel:GetRedPointId(systeId) or 0
                if id < 0 then
                    tb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.FirstTest.id, -id)
                    require("RedPointFirstTest"):CheckParams(-id)
                else
                    if AppSetting.IsXzns and systeId == _G.FunctionID.SuperValuGift then
                        tb.obj_redpoint:UpdateRedPointItemIDAndParam(ConfigManager.redpoint_cfg.SeasonGiftRedPoint.id)
                    else
                        tb.obj_redpoint:UpdateRedPointItemIDAndParam(id)
                    end
                end
                --if AppSetting.IsXzns then
                --    if systeId == _G.FunctionID.SuperValuGift or systeId == _G.FunctionID.SeasonRecordRecharge then
                --        tb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.SeasonGiftPackRed.id, -id)
                --    end
                --end
                tb.aorbtn_extra:SetActiveE(isShow)
                if isShow == 1 then
                    tb.aorrawimage_extra:LoadImage(icon)
                end
                ---@type function_open_cfg
                local cfg = _G.ConfigManager.function_open_cfg[systeId]
                tb.aortext_name.text = _G.GetLangPackValue(cfg.name)
                tb.aortext_name.fontSize = fontSize
                tb.aortext_name:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor
                CommonTipManager:GetInstance():SetTextGradient(colors, alphas, tb.aortext_name)
                if _G.AppSetting.IsXzns then
                    tb.aorimage_icon.SpriteName = (self.cfg.main_button[i] and #self.cfg.main_button[i] > 0) and
                            self.cfg.main_button[i] or self.cfg.main_button[1]
                else
                    tb.aorimage_icon.SpriteName = self.cfg.main_button[1]
                end
                tb.aorimage_icon:SetNativeSize()
                if EffectTb[systeId] then
                    _G.UIUtils.LoadEffectByCfg(
                        EffectTb[systeId],
                        tb.gameObject,
                        function(trans)
                            if self:IsNil() then
                                _G.DestroyImmediate(trans)
                            end
                        end
                    )
                end
                if systeId == _G.FunctionID.SeasonTower then
                    self:SetObj_seasonTowerTip(1,tb.gameObject)
                    self.go_table.aortext_seasonTowerStage:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor
                    CommonTipManager:GetInstance():SetTextGradient(colors, alphas, self.go_table.aortext_seasonTowerStage)
                    self:UpdateSeasonTowerTip()
                end
                tb.aorimage_lock:SetActiveE(_G.FunctionManager:GetInstance():CheckFunctionIsUnlock(systeId) and 0 or 1)
            end
        else
            self.go_table["aorbtn_" .. i]:SetActiveE(0)
        end
    end
    --local count = #self.cfg.system
    --if count < 9 then
    --    self.go_table.aorbtn_special:SetPosition(self.go_table.aorbtn_9:GetPosition())
    --else
    --    self.go_table.aorbtn_special:SetPosition(self.go_table.aorbtn_10:GetPosition())
    --end
    -- self.go_table.aorbtn_special:SetActiveE(require "SeasonModel":GetInstance():CheckSeasonSpecial() and 1 or 0)
    self.go_table.aorbtn_special:SetActiveE(0)
    if AppSetting.IsXzns and self.cfg.rouletteIcon then
        ---@type SeasonView._aorbtn_roulette_GoTable
        local tb = GetAutoGoTable(self.go_table.aorbtn_roulette,handler(self,self.OpenActivitiesFunc))
        self:SetUnitBtnGotable(self.cfg.rouletteFuncId,tb,self.cfg.rouletteIcon)
    end
end

