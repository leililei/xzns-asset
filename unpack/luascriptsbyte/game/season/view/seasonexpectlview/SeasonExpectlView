---@class SeasonExpectlView : UIBaseView	中文描述
---@field public go_table SeasonExpectlView_GoTable GoTable
---@field itemList table<number,BaseAwardNewItem>
local SeasonExpectlView = _G.BaseClass("SeasonExpectlView", _G.UIBaseView)
--_G.SeasonExpectlView = SeasonExpectlView

function SeasonExpectlView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SeasonExpectlView:OnCreate()
    self.itemList = {}
    self.data = require "SeasonModel":GetInstance():GetSeasonExpectData() or {}
    self:InitTime()
    self.isGet = require "SeasonModel":GetInstance():CheckSeasonExpectIsGet()
    local count = #self.data
    self.go_table.scrollloophorizontal_itemList:UpdateScrollRectWeight(
        count > 4 and 457 or 4 + (count - 1) * 23 + count * 96
    )
    self.go_table.scrollloophorizontal_itemList:InitItemData(#self.data, _G.handler(self, self.RefreshItem))
    self.go_table.aorbtn_get:SetActiveE(self.isGet and 0 or 1)
end

---初始化时间显示
function SeasonExpectlView:InitTime()
    local tb = _G.TimeUtil.TranslateSecond(require "SeasonModel":GetInstance():GetNextSeasonSeasonTimeLeft())
    if tb.day > 0 or (tb.hour == 23 and tb.min > 0 or tb.sec > 0) then
        if tb.hour > 0 or tb.min > 0 or tb.sec > 0 then
            tb.day = tb.day + 1
        end
        self.go_table.aortext_time.text =
            _G.LangUtil.GetLangPackValue(90025500027, _G.LangUtil.GetLangPackValue(90025500011, tb.day, ""))
    else
        if tb.min > 0 or tb.sec > 0 then
            tb.hour = tb.hour + 1
        end

        self.go_table.aortext_time.text =
            _G.LangUtil.GetLangPackValue(90025500027, _G.LangUtil.GetLangPackValue(90025500029, tb.hour))
    end
end

---刷新显示
---@param index number 下标
---@param obj UnityEngine.GameObject
function SeasonExpectlView:RefreshItem(index, obj)
    local id = obj:GetInstanceIDE()
    local item = self.itemList[id]
    if not item then
        item = require "BaseAwardNewItem".New(obj, nil, 96)
        self.itemList[id] = item
    end
    item:ShowWithID(self.data[index + 1])
    item.go_table.obj_mask:SetActiveE(self.isGet and 1 or 0)
end

---按钮点击事件在这里派发
function SeasonExpectlView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_get then
        require "SeasonModel":GetInstance():GetSeasonExpectAward(
            function(msg)
                if not _G.IsNil(msg) then
                    require "CommonTipManager".OpenCommonAwardView(msg)
                    self.isGet = true
                    self.go_table.aorbtn_get:SetActiveE(0)
                    self.go_table.scrollloophorizontal_itemList:UpdateAllItem()
                end
            end
        )
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    end
end

return SeasonExpectlView
