---@class SeasonSpecialView : UIBaseView	中文描述
---@field public go_table SeasonSpecialView_GoTable GoTable
---@field itemList BaseAwardNewItem[]
local SeasonSpecialView = _G.BaseClass("SeasonSpecialView", _G.UIBaseView)

function SeasonSpecialView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SeasonSpecialView:OnCreate(call)
    self.data = _G.ConfigManager.discrete_cfg[105109]
    self.itemList = {}
    local count = #self.data
    if count < 5 then
        self.go_table.scrollloopvectical_itemList:SetRectTransformSize(96 * count + 6 + 9 * (count - 1), 207.34)
    end
    self.go_table.scrollloopvectical_itemList:InitItemData(count, _G.handler(self, self.RefreshItem))
    self.call = call
end

---刷新显示
---@param index number 下标
---@param obj UnityEngine.GameObject
function SeasonSpecialView:RefreshItem(index, obj)
    local id = obj:GetInstanceIDE()
    local item = self.itemList[id]
    if not item then
        item = require "BaseAwardNewItem".New(obj, nil, 96)
        self.itemList[id] = item
    end
    item:ShowWithID(self.data[index + 1])
    item.go_table.obj_mask:SetActiveE(require "SeasonModel":GetInstance():CheckIsGetSpecialAward() and 1 or 0)
end

---按钮点击事件在这里派发
function SeasonSpecialView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.aorbtn_get then
        require "SeasonModel":GetInstance():GetSeasonSpecialAward(
            function(msg)
                self.go_table.scrollloopvectical_itemList:UpdateAllItem()
                require "CommonTipManager".OpenCommonAwardView(msg)
                if self.call then
                    self.call()
                end
                self:Close()
            end
        )
    end
end

return SeasonSpecialView
