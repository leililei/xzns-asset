---@class SeasonLoginView : UIBaseView
---@field public go_table SeasonLoginView_GoTable GoTable
---@field seasonCfg season_cfg
---@field cfg season_login_cfgse
local SeasonLoginView = _G.BaseClass("SeasonLoginView", _G.UIBaseView)

local model = require("SeasonModel"):GetInstance()

function SeasonLoginView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.eSeason.SeasonRefreshModel, self.InitView, self)
    self.go_table.aorbtn_Get:SetActiveE(0)
end

function SeasonLoginView:OnCreate(hideFun, openFun)
    if _G.AppSetting.IsXzns then
        _G.GameUtil.SetUiHeXieMask(self.go_table)
    end
    if hideFun then
        hideFun()
    end
    if openFun then
        self.openFun = openFun
    end
    self:InitView()
end

function SeasonLoginView:InitData()
    self.curSeason = model.infoData.id
    self.curPeriod = model:GetLoginPeriod()
    self.curDay = model.curDay
    self.seasonCfg = _G.ConfigManager.season_cfg[self.curSeason]
    self.cfg = _G.ConfigManager.season_login_cfg
    self.rewardCount = #self.seasonCfg.login // 7
    self.curPeriod = _G.math.min(self.curPeriod, self.rewardCount)
end

function SeasonLoginView:InitView()
    self:InitData()
    self.periodList = {}
    self.selectPeriod = 0
    local cfg = self.seasonCfg
    local pos = cfg.signin_background_coefficient
    self.go_table.scrollloophorizontal_Period:InitItemData(self.curPeriod, _G.handler(self, self.RefreshPeriod))
    self:SetPeriod(self.curPeriod)
    self.go_table.aorrawimage_Bg:LoadImage(cfg.signin_background[1])
    self.go_table.aorrawimage_Title:LoadImage(cfg.signin_title[1])
    _G.DelayFrameDo(
        function()
            self.go_table.aorrawimage_Title:SetNativeSize()
            self.go_table.aorrawimage_Bg:SetNativeSize()
            self.go_table.aorrawimage_Bg:SetLocalPosition(pos[1], pos[2], pos[3])
        end
    )
    if #cfg.signin_spine > 0 then
        _G.PoolsManager:GetInstance():Spawn(
            cfg.signin_spine[1],
            _G.ePoolType.Temporary,
            self.go_table.trans_SpineNode,
            function(trans)
                if self.go_table.gameObject == nil then
                    _G.DestroyObject(trans)
                    return
                end
                local spinePos = cfg.signin_spine_coefficient
                trans:SetLocalPosition(spinePos[1], spinePos[2], spinePos[3])
                trans:SetLocalScaleXYZ(spinePos[4])
                trans:SetLocalRotation(0, spinePos[5], 0)
            end
        )
    end
end

---加载期数页签
function SeasonLoginView:RefreshPeriod(index, obj)
    local newIndex = index + 1
    local tb
    if self.periodList[newIndex] then
        tb = self.periodList[newIndex]
    else
        tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickPeriod, newIndex))
        self.periodList[newIndex] = tb
    end
    local hasAward = self:GetAwardState(newIndex)
    tb.obj_redPoint:SetActiveE(hasAward and 1 or 0)
    tb.obj_On:SetActiveE(newIndex == self.selectPeriod and 1 or 0)
    tb.aorrawimage_OffIcon:LoadImage("ImagesH5/hSeasonLogin/ui_icon_n_1")
    tb.aorrawimage_OnIcon:LoadImage("ImagesH5/hSeasonLogin/ui_icon_c_1")
    tb.aortext_Name.text = _G.GetLangPackValue(90025500088, _G.GameUtil.NumberToChinese(newIndex))
    if AppSetting.IsXzns then
        tb.aortext_Name_On.text = _G.GetLangPackValue(90025500088, _G.GameUtil.NumberToChinese(newIndex))
    end
end

---更新按钮状态
function SeasonLoginView:UpdateBtn()
    local hasAward = self:GetAwardState(self.selectPeriod)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FirstTest.id, 274)
    self.periodList[self.selectPeriod].obj_redPoint:SetActiveE(hasAward and 1 or 0)
    self.go_table.obj_redPoint:SetActiveE(hasAward and 1 or 0)
    self.go_table.aorimage_Get:SetGray(not hasAward)
    self.go_table.aorimage_Get.color = _G.ColorTools.FormatColorByString(hasAward and "FFFFFF" or "A9A9A9")
    self.go_table.aortext_Get.color = _G.ColorTools.FormatColorByString(hasAward and "8C2D14" or "434343")
    if AppSetting.IsXzns then
        self.go_table.aorrawimage_btnImage:SetGray(not hasAward)
    end
end

---更新单个奖励显示
function SeasonLoginView:UpdateAward(index)
    local tb = _G.GetAutoGoTable(self.go_table["obj_Award_" .. index], _G.handlerbind(self, self.GetAllAward))
    local isGet = model:CheckGetLoginAward(self.startDay + index)
    local canGet = not isGet and self.curDay >= self.startDay + index
    tb.aorbtn_Click:SetActiveE(canGet and 1 or 0)
    tb.obj_isGet:SetActiveE(isGet and 1 or 0)
    tb.aortext_Day.text = _G.GetLangPackValue(90023800006, index)
    tb.obj_AwardRoot:ClearChildren()
    local item = require("BaseAwardNewItem").New(tb.obj_AwardRoot)
    item:ShowWithID(self.cfg[self.seasonCfg.login[(self.selectPeriod - 1) * 7 + index]].rewards[1])
    if canGet then
        tb.aortext_Day.text = _G.GetLangPackValue(90028500022)
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_kelingqukuang, item.gameObject)
        self.hasAward = true
    end

    if AppSetting.IsXzns then
        --tb.aortext_Day.text = _G.GetLangPackValue(90049200071, index)
        tb.aortext_DayNum.text = index
        local state = 0
        tb.aorimage_Bg.SpriteName = "ui_qdfl_bak_zi"
        self:SetGradient(tb,false)
        if isGet then
            state = 3
            tb.aortext_state.text = GetLangPackValue(90000010221)
            tb.aortext_state.color = _G.ColorTools.FormatColorByString("96f48a")
        elseif canGet then
            state = 2
            tb.aortext_state.text = GetLangPackValue(90028500022)
            tb.aorimage_Bg.SpriteName = "ui_qdfl_bak_cheng"
            self:SetGradient(tb,true)
            tb.aortext_state.color = _G.ColorTools.FormatColorByString("523210")
        else
            state = 1
            tb.aortext_state.text = GetLangPackValue(90000011299)
            tb.aortext_state.color = _G.ColorTools.FormatColorByString("ebf4fc")
        end
    end
end

function SeasonLoginView:SetGradient(tb,isf6dd77)
    if isf6dd77 then
        UIUtils.ChangeUIMethod({"4","f6dd77","ffffff"},tb.aortext_Day1)
        UIUtils.ChangeUIMethod({"4","f6dd77","ffffff"},tb.aortext_DayNum)
        UIUtils.ChangeUIMethod({"4","f6dd77","ffffff"},tb.aortext_Day3)
    else
        UIUtils.ChangeUIMethod({"4","92c8fb","ffffff"},tb.aortext_Day1)
        UIUtils.ChangeUIMethod({"4","92c8fb","ffffff"},tb.aortext_DayNum)
        UIUtils.ChangeUIMethod({"4","92c8fb","ffffff"},tb.aortext_Day3)
    end
end

---合并奖励
function SeasonLoginView:AddAward(source, new)
    local result = source
    local ItemDic = {}
    for k, v in pairs(source.award.item) do
        local type = v.type[1]
        if not ItemDic[type] then
            ItemDic[type] = k
        end
    end
    for _, v in pairs(new.award.item) do
        local type = v.type[1]
        if ItemDic[v.type[1]] then
            local Dic = ItemDic[type]
            local Item = result.award.item[Dic]
            result.award.item[Dic].type[2] = Item.type[2] + v.type[2]
            result.award.item[Dic].type[3] = Item.type[3] + v.type[2]
        else
            local count = #result.award.item + 1
            result.award.item[count] = {type = {}}
            for i = 1, 3 do
                table.insert(result.award.item[count].type, v.type[i])
            end
            ItemDic[type] = #result.award.item
        end
    end

    return result
end

---检测指定期数是否有可领取奖励
function SeasonLoginView:GetAwardState(period)
    local startDay = (period - 1) * 7
    for i = 1, 7 do
        if model:CheckCanTakeLoginAward(startDay + i) then
            return true
        end
    end
    return false
end

---一键领取
function SeasonLoginView:GetAllAward()
    if not self.hasAward then
        return
    end
    local canGet = {}
    for i = 1, 7 do
        if model:CheckCanTakeLoginAward(self.startDay + i) then
            _G.table.insert(canGet, self.startDay + i)
        end
    end
    if #canGet > 0 then
        require("SeasonNet"):GetInstance():GetSignReward(
            {index = canGet},
            function(msg)
                if msg.ack == 1 then
                    for _, _index in ipairs(canGet) do
                        model.signAward[_index] = true
                        self:UpdateAward(_index - self.startDay)
                    end
                    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                    self:UpdateBtn()
                end
            end
        )
    end
end

---切换期数
function SeasonLoginView:SetPeriod(period)
    if self.selectPeriod == period then
        return
    end
    if self.selectPeriod ~= 0 then
        self.periodList[self.selectPeriod].obj_On:SetActiveE(0)
    end
    self.selectPeriod = period
    self.periodList[period].obj_On:SetActiveE(1)
    self.hasAward = false
    self.startDay = (period - 1) * 7
    for i = 1, 7 do
        self:UpdateAward(i)
    end
    self.go_table.aorbtn_Get:SetActiveE(1)
    self:UpdateBtn()
end

function SeasonLoginView:OnClickPeriod(_, _, index)
    self:SetPeriod(index)
end

function SeasonLoginView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_Close" then
        self:Close()
        if self.openFun then
            self.openFun()
        end
    elseif name == "@_aorbtn_Get" then
        if not self.hasAward then
            _G.PopWindowManager:GetInstance():ShowAllTips(25)
            return
        else
            self:GetAllAward()
        end
    end
end

function SeasonLoginView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eSeason.SeasonRefreshModel, self.InitView, self)
end

return SeasonLoginView
