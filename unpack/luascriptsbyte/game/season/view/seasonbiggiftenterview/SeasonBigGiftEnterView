---@class SeasonBigGiftEnterView : UIBaseView	中文描述
---@field public go_table SeasonBigGiftEnterView_GoTable GoTable
local SeasonBigGiftEnterView = _G.BaseClass("SeasonBigGiftEnterView", _G.UIBaseView)

function SeasonBigGiftEnterView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.AnimationEvents.BigGiftEnterEnd, self.FinishAnim, self)
    self.Anim = self.go_table.transform:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
end

---界面的入口函数
function SeasonBigGiftEnterView:OnCreate()
    _G.AudioManager.PlayAudioByAudioCfgID(2029)
    local check = function(obj)
        if self:IsNil() then
            _G.UIUtils.RemoveEffect(obj)
            return false
        end
        return true
    end

    local cfg = require "SeasonModel":GetInstance():GetCfg()
    self.go_table.aorrawimage_title:LoadImage(
        cfg.calligraphy[1][1],
        function(trans)
            trans:SetNativeSize()
            trans:SetLocalPosition(cfg.calligraphy[2][1], cfg.calligraphy[2][2], cfg.calligraphy[2][3])
        end
    )

    local bgCfg = cfg.background
    self.go_table.aorrawimage_bgFire:LoadImage(
        bgCfg[4][1],
        function(trans)
            trans:SetNativeSize()
            trans:SetLocalPosition(bgCfg[4][2] or 0, bgCfg[4][3] or 0, bgCfg[4][4] or 0)
        end
    )
    local spineCfg = cfg.spine
    if not _G.string.IsNullOrEmpty(spineCfg[1]) then
        for i = 1, #spineCfg[1] do
            local effCfg = _G.ConfigManager.ui_spine_effect_cfg[spineCfg[1][i]]
            if effCfg then
                _G.UIUtils.LoadEffectByPath(
                    effCfg.Path,
                    self.go_table.obj_bgRole,
                    function(trans)
                        if not check(trans) then
                            return
                        end
                        trans:SetLocalPosition(spineCfg[i+1][1], spineCfg[i+1][2], spineCfg[i+1][3])
                        trans:SetLocalScaleXYZ(spineCfg[i+1][4])
                        local parent
                        for i = 1, #effCfg.special do
                            if #effCfg.special[i] == 1 then
                                parent = effCfg.hierarchy == 1 and self.go_table.obj_eff or self.go_table.obj_bgEff
                                _G.UIUtils.LoadEffectByCfg(
                                    _G.ConfigManager.ui_effect_cfg[effCfg.special[i][1]],
                                    parent,
                                    check
                                )
                            else
                                local spObj = _G.InstantiateObject(self.go_table.obj_spineEff, trans)
                                local bone = spObj:GetComponentE(_G.typeof(_G.CS.Spine.Unity.BoneFollowerGraphic))
                                bone.skeletonGraphic = trans:GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
                                bone.boneName = effCfg.special[i][2]
                                _G.UIUtils.LoadEffectByCfg(
                                    _G.ConfigManager.ui_effect_cfg[effCfg.special[i][1]],
                                    spObj,
                                    check
                                )
                            end
                        end
                    end
                )
            else
                _G.UIUtils.LoadEffectByPath(
                    spineCfg[1][i],
                    self.go_table.obj_bgRole,
                    function(trans)
                        if not check(trans) then
                            return
                        end
                        trans:SetLocalPosition(spineCfg[i+1][1], spineCfg[i+1][2], spineCfg[i+1][3])
                        trans:SetLocalScaleXYZ(spineCfg[i+1][4])
                    end
                )
            end
        end
    end
    if cfg.Name[3] then
        for _, v in pairs(cfg.Name[3]) do
            _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg[v], self.go_table.obj_bgEff, check)
        end
    end
end

---@private
function SeasonBigGiftEnterView:FinishAnim()
    if self.Anim then
        self.Anim:Play("loop")
    end
    _G.Events:GetInstance():RemoveListener(_G.AnimationEvents.BigGiftEnterEnd, self.FinishAnim, self)
end

---按钮点击事件在这里派发
function SeasonBigGiftEnterView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_start then
        self:Close()
        if require "SeasonModel":GetInstance():GetSeasonState() == _G.SeasonState.Settlement then
            _G.PopWindowManager:GetInstance():ShowAllTips(620101)
            return
        elseif require "SeasonModel":GetInstance():GetSeasonState() == _G.SeasonState.Open then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SeasonView.Name)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SeasonBigGiftView.Name)
        elseif require "SeasonModel":GetInstance():GetSeasonState() == _G.SeasonState.WaitNext then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SeasonExpectlView.Name)
        end
    end
end

return SeasonBigGiftEnterView
