---@class SeasonBossRankView : UIBaseView	中文描述
---@field public go_table WorldBossRankView_GoTable GoTable
---@field cfg boss_rank_cfg
---@field itemList SeasonBossRankView._obj_ListItem_GoTable[]
---@field Toggles SeasonBossRankView._toggle_rank_GoTable[]
---@field Rank SeasonBossRankView._obj_Rank_GoTable
---@field Reward  SeasonBossRankView._obj_Reward_GoTable
---@field rankList _obj_Rank._obj_rankItem_GoTable[]
---@field rewardList _obj_Rank._obj_rankItem_GoTable[]
---@field rewardList_Rank BaseAwardNewItem[]
---@field rewardList_Reward BaseAwardNewItem[]
local SeasonBossRankView = _G.BaseClass("SeasonBossRankView", _G.UIBaseView)
local rankEffect = {
    "Ef_ArenaTop1",
    "Ef_ArenaTop2",
    "Ef_ArenaTop3"
}
function SeasonBossRankView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.itemList = {}
    _G.GameUtil.SetActiveByCondition(self.gameObject, false)
end

---界面的入口函数
function SeasonBossRankView:OnCreate()
    self.playerUid = _G.PlayerModel:GetInstance():GetPlayerUid()
    self:InitToggle()
    self.go_table.toggle_rank.isOn = true
end

function SeasonBossRankView:InitToggle()
    self.Toggles = {}
    self.Toggles["Rank"] =
        _G.GetAutoGoTable(
        self.go_table.toggle_rank,
        _G.handlerbind(self, self.OnToggle, "Rank", _G.handler(self, self.OnRank))
    )
    self.Toggles["Reward"] =
        _G.GetAutoGoTable(
        self.go_table.toggle_reward,
        _G.handlerbind(self, self.OnToggle, "Reward", _G.handler(self, self.OnReward))
    )
end
---点击Togggle
function SeasonBossRankView:OnToggle(go, isOn, key, call)
    local tb = self.Toggles[key]
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOff, not isOn)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, isOn)
    if call then
        call(isOn)
    end
end

---排行
function SeasonBossRankView:OnRank(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Rank, isOn)
    if not isOn then
        return
    end
    if not self.Rank then
        self.Rank = _G.GetAutoGoTable(self.go_table.obj_Rank)
        self.RewardDatas = _G.table.toArray(_G.ConfigManager.season_boss_rank_cfg)
        _G.table.sort(
            self.RewardDatas,
            function(a, b)
                return a.id < b.id
            end
        )
        require "SeasonBossModel":GetInstance():GetRank(
            function()
                self.rankDatas = require "SeasonBossModel":GetInstance().rankList or {}
                self.rankList = {}
                self.rewardList_Rank = {}
                _G.GameUtil.SetActiveByCondition(self.Rank.obj_no, #self.rankDatas <= 0)
                _G.GameUtil.SetActiveByCondition(self.gameObject, true)
                self.Rank.scrollloopvectical_rankList:InitItemData(#self.rankDatas, _G.handler(self, self.RefreshRank))
            end
        )

        require "SeasonBossModel":GetInstance():GetPlayerRank(
            function()
                self:InitPlayer()
            end
        )
    end
end

---刷新排行
function SeasonBossRankView:RefreshRank(index, obj)
    local newindex = index + 1
    local instanceID = obj:GetInstanceIDE()
    if not self.rankList[instanceID] then
        self.rankList[instanceID] = _G.GetAutoGoTable(obj)
    -- self.rankList[instanceID].scrollloophorizontal_AwardList:InitItemData(
    --     0,
    --     _G.handlerbind(self, self.RefreshReward, self.rewardList_Rank, self.rankList[instanceID])
    -- )
    end
    local tb = self.rankList[instanceID]
    local data = self.rankDatas[newindex]
    tb.rankData = data
    tb.data = self:GetRankData(newindex)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_rankBg, newindex <= 3)
    _G.GameUtil.SetActiveByCondition(tb.obj_rankBg2, newindex > 3)
    if newindex <= 3 then
        tb.aorimage_rankBg.SpriteName = "tz_qjhs_di_0" .. (newindex + 1)
        tb.aorimage_rank.SpriteName = "tz_qjhs_phb_mingci_0" .. newindex
    else
        tb.aortext_rankNum.text = newindex
    end
    if tb.rankData.uid == self.playerUid then
        tb.aortext_name.text = _G.PlayerModel:GetInstance():GetName()
        tb.aorimage_portrait.SpriteName = _G.ConfigManager.player_portrait_cfg[data.portrait].portrait1
        tb.aorrawimage_frame:LoadImage(
            _G.ConfigManager.player_frame_cfg[_G.PlayerModel:GetInstance():GetCurFrame()].frame
        )
        tb.aortext_lv.text = "Lv." .. _G.PlayerModel:GetInstance():GetLevel()
        local icon = _G.SystemSettingManager.GetTitleIcon(_G.PlayerModel:GetInstance():GetTitle())
        if icon then
            tb.aorrawimage_sign:LoadImage(icon)
        else
            tb.aorrawimage_sign:LoadImage("")
        end
    else
        tb.aortext_name.text = data.name
        tb.aorimage_portrait.SpriteName = _G.ConfigManager.player_portrait_cfg[data.portrait].portrait1
        local icon = _G.SystemSettingManager.GetTitleIcon(data.title)
        if icon then
            tb.aorrawimage_sign:LoadImage(icon)
        else
            tb.aorrawimage_sign:LoadImage("")
        end
        tb.aortext_lv.text = "Lv." .. data.lv
    end
    tb.aortext_damage.text = _G.GameUtil.NumberToUnitStr(data.value)
    if not tb.list then
        tb.list = {}
    end
    if tb.data then
        self:ShowAward(tb, tb.obj_item, tb.data.rewards)
    end
end

function SeasonBossRankView:ShowAward(tb, obj, award)
    if not tb.list then
        tb.list = {}
    end
    local count = #tb.list
    local count2 = #award
    for i = 1, count do
        if i <= count2 then
            tb.list[i]:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(award[i]))
            _G.GameUtil.SetActiveByCondition(tb.list[i].gameObject, true)
        else
            _G.GameUtil.SetActiveByCondition(tb.list[i].gameObject, false)
        end
    end
    if count < count2 then
        for i = count + 1, count2 do
            local obj2 = _G.InstantiateObject(obj)
            obj2:SetParentE(tb.trans_Content)
            local item = require "BaseAwardNewItem".New(obj2, nil, 73, obj2:GetChildE(0))
            tb.list[i] = item
            local data = award[i]
            item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
        end
    end
end

function SeasonBossRankView:GetRankData(index)
    if index <= 0 then
        return
    end
    for _, v in ipairs(self.RewardDatas) do
        if index >= v.min_rank and index <= v.max_rank then
            return v
        end
    end
    return nil
end

---显示玩家排行
function SeasonBossRankView:InitPlayer()
    self.playerRank = require "SeasonBossModel":GetInstance().playerRank
    if not self.player then
        self.player = _G.GetAutoGoTable(self.Rank.obj_player)
    -- self.player.scrollloophorizontal_AwardList:InitItemData(
    --     0,
    --     _G.handlerbind(self, self.RefreshReward, self.rewardList_Rank, self.player)
    -- )
    end
    local tb = self.player
    local newindex = self.playerRank.index
    tb.data = self:GetRankData(newindex)
    if newindex == 0 then
        tb.aortext_rankNum.text = _G.LangUtil.GetLangPackValue(90022900040)
    else
        tb.aortext_rankNum.text = newindex
    end
    tb.aortext_name.text = _G.PlayerModel:GetInstance():GetName()
    tb.aorimage_portrait.SpriteName =
        _G.ConfigManager.player_portrait_cfg[_G.PlayerModel:GetInstance():GetRoleStyle()].portrait1
    tb.aorrawimage_frame:LoadImage(_G.ConfigManager.player_frame_cfg[_G.PlayerModel:GetInstance():GetCurFrame()].frame)
    tb.aortext_lv.text = "Lv." .. _G.PlayerModel:GetInstance():GetLevel()
    tb.aortext_damage.text = _G.GameUtil.NumberToUnitStr(_G.math.floor(self.playerRank.value))
    local icon = _G.SystemSettingManager.GetTitleIcon(_G.PlayerModel:GetInstance():GetTitle())
    if icon then
        tb.aorrawimage_sign:LoadImage(icon)
    else
        tb.aorrawimage_sign:LoadImage("")
    end
    if tb.data then
        self:ShowAward(tb, tb.obj_item, tb.data.rewards, tb.obj_item:GetChildE(0))
    else
        self:ShowAward(tb, tb.obj_item, {}, tb.obj_item:GetChildE(0))
    end
end
---刷新奖励
function SeasonBossRankView:RefreshReward(index, obj, list, tb)
    local newIndex = index + 1
    local instanceID = obj:GetInstanceIDE()
    local data = tb.data.reward_daily[newIndex]
    local item = list[instanceID]
    if not item then
        item = require "BaseAwardNewItem".New(obj, _G.handler(self, self.OnClickAward), 73, obj)
        list[instanceID] = item
    end
    item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))
end
---奖励
function SeasonBossRankView:OnReward(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Reward, isOn)
    if not isOn then
        return
    end
    if not self.Reward then
        self.Reward = _G.GetAutoGoTable(self.go_table.obj_Reward)
        self.Reward.aortext_content.text = _G.LangUtil.GetLangPackValue(91200002501)
        self.rewardList = {}
        self.rewardList_Reward = {}
        self.Reward.scrollloopvectical_itemList:InitItemData(#self.RewardDatas, _G.handler(self, self.RefreshReward2))
    end
end
---刷新奖励2
function SeasonBossRankView:RefreshReward2(index, obj)
    local newindex = index + 1
    local instanceID = obj:GetInstanceIDE()
    ---@type boss_rank_cfg
    local data = self.RewardDatas[newindex]
    if not self.rewardList[instanceID] then
        self.rewardList[instanceID] = _G.GetAutoGoTable(obj)
    end
    local tb = self.rewardList[instanceID]
    tb.data = data
    _G.GameUtil.SetActiveByCondition(tb.aorimage_rank, newindex <= 3)
    if newindex <= 3 then
        tb.aorimage_rank.SpriteName = "tz_qjhs_phb_mingci_0" .. newindex
        tb.aortext_rank.text = ""
    elseif data.min_rank == data.max_rank then
        tb.aortext_rank.text = newindex
    else
        tb.aortext_rank.text = _G.string.format("%s~%s", data.min_rank, data.max_rank)
    end
    if tb.data then
        self:ShowAward(tb, tb.obj_Award, tb.data.rewards)
    else
        self:ShowAward(tb, tb.obj_Award, {})
    end
end

---按钮点击事件在这里派发
function SeasonBossRankView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

return SeasonBossRankView
