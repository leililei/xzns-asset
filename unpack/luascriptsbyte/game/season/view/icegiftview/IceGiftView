local SeasonIceGiftModel = require "SeasonIceGiftModel"
---@class IceGiftView : UIBaseView	中文描述
---@field public go_table IceGiftView_GoTable GoTable
---@field cfg season_cfg
local IceGiftView = _G.BaseClass("IceGiftView", _G.UIBaseView)

local GetLangPackValue = _G.GetLangPackValue
function IceGiftView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function IceGiftView:OnCreate(hideFun, openFun)
    if hideFun then
        hideFun()
    end
    if openFun then
        self.openFun = openFun
    end
    self.Datas = {}
    self.ItemList = {}
    self.RewardItemList = {}
    self.RewardItemListMirror = {}
    self.BoxEffectList = {}
    self.LiuGuangEffectList = {}
    self:InitView()
end

function IceGiftView:OnDestroy()
    self.ItemList = nil
    self.RewardItemList = nil
    self.RewardItemListMirror = nil
    self.Datas = nil
    self.curIndex = nil
    self.CurIndex = nil
end

---初始化界面
function IceGiftView:InitView()
    SeasonIceGiftModel:GetInstance():RefreshRedPoint()
    self.Datas = SeasonIceGiftModel:GetInstance():GetTaskDatas()
    self.CurIndex = self:SetCurTaskingIndex() ---当前进行的最大index
    self.curIndex = self.CurIndex or 1

    self.CanGetList = {}
    for i = 1, #self.Datas do
        local iscantake = SeasonIceGiftModel:GetInstance():CheckIsCanTake(self.Datas[i].sid)

        if iscantake then
            table.insert(self.CanGetList, self.Datas[i])
        end
    end

    self.go_table.scrollloopvectical_itemList:InitItemData(#self.Datas, _G.handler(self, self.RefreshItem), self
        .curIndex)
end

function IceGiftView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    index = index + 1
    local data
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.ClickIce, index))
    self.ItemList[index] = tb
    data = self.Datas[index]

    tb.aortext_title.text = GetLangPackValue(data.Cfg.desc)

    local IsGet = SeasonIceGiftModel:GetInstance():CheckIsGet(data.sid)
    local iscantake = SeasonIceGiftModel:GetInstance():CheckIsCanTake(data.sid)

    if iscantake then
        -- 能够领取
        tb.aorbtn_get:SetActiveE(1)
        tb.aorbtn_go:SetActiveE(0)
        tb.aorimage_got:SetActiveE(0)
    elseif IsGet then
        -- 已经领取
        tb.aorbtn_get:SetActiveE(0)
        tb.aorbtn_go:SetActiveE(0)
        tb.aorimage_got:SetActiveE(1)
    else
        -- 没有完成
        tb.aorbtn_get:SetActiveE(0)
        tb.aorbtn_go:SetActiveE(1)
        tb.aorimage_got:SetActiveE(0)
        tb.aortext_limit.text = string.format("(%d/%d)", data.i_task.target[1], data.Cfg.count)
    end
    tb.obj_awards:RemoveAllChildren()
    for _, v in pairs(data.Cfg.reward) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            v,
            tb.obj_awards,
            function(item)
                if not tb.obj_awards then
                    _G.DestoryObject(item)
                    return
                end
                item:SetGou(IsGet)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                item.gameObject:SetLocalScaleXYZ(0.8)
            end)
    end
end

---计算当前正在进行的任务索引
function IceGiftView:SetCurTaskingIndex()
    local index = 0
    if table.isEmptyOrNil(self.Datas) then
        return nil
    else
        for k, v in pairs(self.Datas) do
            if v.i_task.state == _G.TaskEnum.ETaskState.Submited then
                if SeasonIceGiftModel:GetInstance():CheckIsCanTake(v.sid) then
                    break
                end
            elseif v.i_task.state == _G.TaskEnum.ETaskState.Claimed then
                break
            end
            index = index + 1
        end
        return index
    end
end

---按钮点击事件在这里派发
function IceGiftView:ClickIce(go, isOn, index)
    local name = go:GetName()
    if name == "@_aorbtn_get" then
        local sidList = {}
        for k, v in pairs(self.CanGetList) do
            _G.table.insert(sidList, v.sid)
        end
        SeasonIceGiftModel:GetInstance():FinishTask(sidList, function()
            if self:IsNil() then
               return 
            end
            if AppSetting.IsXzns then
                self.Datas = SeasonIceGiftModel:GetInstance():GetTaskDatas()
            end
            local index = self:SetCurTaskingIndex()
            self.go_table.scrollloopvectical_itemList:ScrollToIndex(index)
            self.go_table.scrollloopvectical_itemList:UpdateAllItem()
        end)
    elseif name == "@_aorbtn_go" then
        local link = self.Datas[index].Cfg.link
        if link > 0 then
            _G.JumpManager:GetInstance():Jump(
                link,
                function()
                    self:Close()
                    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SeasonView.Name)
                end
            )
        end
    end
end

---按钮点击事件在这里派发
function IceGiftView:OnClickBtn(go, isOn)
    if not self.isclick then
        if go == self.go_table.aorbtn_Back then
            self:Close()
            if self.openFun then
                self.openFun()
            end
        elseif go == self.go_table.aorbtn_way then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 44)
        end
    end
end

return IceGiftView
