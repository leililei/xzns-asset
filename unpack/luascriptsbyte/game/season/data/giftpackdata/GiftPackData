---@class GiftPackData 礼包数据
local GiftPackData = _G.BaseClass("GiftPackData")

---初始化礼包
function GiftPackData:InitData(cfgId)
    ---@type store_active_cfg|season_recharge_cfg
    self.cfg = nil
    self.isCumulativeCharging = false
    self.cfg = ConfigManager.store_active_cfg[cfgId]
    ---当前礼包的购买次数
    self.buyCount = 0
    ---最大购买次数
    self.MaxBuyCount = self.cfg.count_limit
end

---初始化累充礼包
function GiftPackData:InitData_Charge(id)
    ---@type season_recharge_cfg
    self.cfg = SimpleCopy(ConfigManager.season_recharge_cfg[id])
    self.isCumulativeCharging = true
    ---当前礼包的购买次数
    self.buyCount = 0
    ---最大购买次数
    self.MaxBuyCount = 1
end

function GiftPackData:RefreshServerData(buyCount)
    self.buyCount = buyCount
end

function GiftPackData:RefreshDataForModel()
    if self.isCumulativeCharging then
        if self.cfg == nil then
            self.buyCount = 1
            return
        end
        local curstate = require("SeasonRecordRechargeModel"):GetInstance():GetAwardState(self.cfg.id)
        if curstate == 3 then
            self.buyCount = 1
        end
    else
        local buyList = require("SuperValuGiftModel"):GetInstance().buyTimes
        if buyList and buyList[self.cfg.id] then
            self.buyCount = buyList[self.cfg.id]
        else
            self.buyCount = 0
        end
    end
    --local supmodel = require("SuperValuGiftModel"):GetInstance()
    --self.buyCount = supmodel:GetItemBuyTimes()
end

function GiftPackData:BuyGiftPack()
    self.buyCount = self.buyCount + 1
end

--是否否能购买
function GiftPackData:IsCanBuy()
    if self.cfg.conditions then
        local value = self.cfg
        local conditionType = 0
        if self.isCumulativeCharging then
            if _G.GlobalConditionManager.CheckMainEventCondition(GlobalConditionManager.ConditionType.CurSeasonAmount, {value.conditions}) == false then
                return false
            end
        else
            for i = 1, #value.conditions do
                if #value.conditions[i] > 1 then
                    local conditionParams = _G.DeepCopyCfgTable(value.conditions[i])
                    conditionType = conditionParams[1]
                    _G.table.remove(conditionParams, 1)
                    if _G.GlobalConditionManager.CheckMainEventCondition(conditionType, conditionParams) == false then
                        return false
                    end
                end
            end
        end
    end

    return true
end

---@return number 1:推荐(置灰) 2:可领取 3:已领取 4:可购买
function GiftPackData:GetGiftState()
    if self.buyCount >= self.MaxBuyCount  then
        return 3
    else
        if self.isCumulativeCharging then
            if self:IsCanPickUp() then
                return 2
            else
                return 1
            end
        else
            if self:IsCanBuy() then
                return 4
            elseif self:IsCanPickUp() then
                return 2
            else
                return 1
            end
        end
    end
end

