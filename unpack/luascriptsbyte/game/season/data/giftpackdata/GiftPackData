--是否能够领取
function GiftPackData:IsCanPickUp()
    if self.isCumulativeCharging then
        local value = self.cfg
        local conditionType = 0
        if _G.GlobalConditionManager.CheckMainEventCondition(GlobalConditionManager.ConditionType.CurSeasonAmount, {value.conditions}) == false then
            return false
        end
    else
        local store_gear_cfg = ConfigManager.store_gear_cfg[self.cfg.price_id]
        if store_gear_cfg.price ~= 0 then
            return false
        end
    end
    return true
end

