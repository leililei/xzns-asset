---@class SeasonBossTaskData : ActiveTaskBase	中文描述
---@field Cfg mission_extra_cfg
local SeasonBossTaskData = _G.BaseClass("SeasonBossTaskData", _G.ActiveTaskBase)
function SeasonBossTaskData:__init()
    self.call = _G.handler(self, self.RefreshRedPoint)
end
function SeasonBossTaskData:ParseData(task)
    self.i_task = task
    self.Cfg = _G.ConfigManager.mission_extra_cfg[task.sid]
    if self.taskEnumType == nil then
        self.taskEnumType = self.Cfg.condition[1][1]
        self.taskcontentparams = self.Cfg.condition[1]
    end
    self:CheckLock()
    self:CheckTaskState()
    self:CheckTaskTarget()
end

function SeasonBossTaskData:RefreshRedPoint()
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FirstBoss.id, 0)
end

return SeasonBossTaskData
