local base = require "ActivitySynTypeBase"
---@class HeroesGatheringSynModel:ActivitySynTypeBase
local HeroesGatheringSynModel = _G.BaseClass("HeroesGatheringSynModel", base)
local TimeUtil = _G.TimeUtil
local ActivitySynManager = require "ActivitySynManager"

--创建对象时,入口构造函数
function HeroesGatheringSynModel:__init()
    self.HeroesGatheringModel = require "HeroesGatheringModel":GetInstance()
    self.redPointId = _G.ConfigManager.redpoint_cfg.FirstGather.id
end

---销毁对象时,析构函数
function HeroesGatheringSynModel:Dispose()
end

---销毁对象时,析构函数
function HeroesGatheringSynModel:ParseData(data)
    base.ParseData(self)
    if data.award_list and _G.table.count(data.award_list) == 3 then
        self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
    end
end

---进入活动主体
function HeroesGatheringSynModel:OnEnterActivity()
    self.HeroesGatheringModel:OpenView(self.curActivityClass)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function HeroesGatheringSynModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.HeroesGatheringView.Name
end

---初始化红点
function HeroesGatheringSynModel:InitRedPointTree()
    self.redpointTree = {false}
end

---@param index number 红点类型序列号
---@return number 红点ID
function HeroesGatheringSynModel:GetRedpointIDByIndex(index)
    return self.redPointId
end

--region 子类重写
---从服务器拉取数据
function HeroesGatheringSynModel:GetDataFormServer()
    self.HeroesGatheringModel:GetDataToInf(_G.handler(self, self.ParseData))

    --self:ParseData()
end

---初始化功能逻辑
function HeroesGatheringSynModel:InitFunction()
    self.HeroesGatheringModel:InitFunction()
end

return HeroesGatheringSynModel