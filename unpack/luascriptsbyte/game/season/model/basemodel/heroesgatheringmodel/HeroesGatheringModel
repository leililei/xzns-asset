local WheelOfFortuneNet = require "WheelOfFortuneNet"
local base = require "SeasonBaseModel"
---@class HeroesGatheringModel:SeasonBaseModel
local HeroesGatheringModel = _G.BaseClass("HeroesGatheringModel", base)
---@return HeroesGatheringModel HeroesGatheringModel
function HeroesGatheringModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function HeroesGatheringModel:__init()
    --已领取的目标奖励
    self.award_lists = {}
    self.login_count = 0
    self.curFunctionOpenID = _G.FunctionID.HeroesGathering
    self.redPointId = _G.ConfigManager.redpoint_cfg.FirstGather.id
end

---销毁对象时,析构函数
function HeroesGatheringModel:Dispose()
end

--region 子类重写
---从服务器拉取数据
function HeroesGatheringModel:GetDataFormServer()
    self:GetDataToInf()

    --self:ParseData()
end

---初始化功能逻辑
function HeroesGatheringModel:InitFunction()
end
---获取首测信息
function HeroesGatheringModel:GetDataToInf(Call)
    WheelOfFortuneNet:GetInstance():AccessToInfo(
        function(data)
            if data.award_list ~= nil then
                self.award_lists = data.award_list
            else
                self.award_lists = {}
            end
            if data.login_count ~= nil then
                self.login_count = data.login_count
            end
            if Call ~= nil then
                Call(data)
            end
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FirstGather.id)
            self:ParseData()
        end
    )
end

---领取目标奖励
function HeroesGatheringModel:AddBlackrallyaward(num, Call)
    WheelOfFortuneNet:GetInstance():AddBlackrallyaward(
        num,
        function(data)
            if data.ack == 1 then
                _G.table.insert(self.award_lists, num.id)
                _G.StorageManager:GetInstance():ReceiveAwardData(data)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
                if Call ~= nil then
                    Call()
                end
            else
            end
        end
    )
end
---英雄集结红点
function HeroesGatheringModel:hongDian()
    local TipID = {
        [1] = 105401,
        [2] = 105402,
        [3] = 105407
    }

    for num = 1, 3 do
        local goal = _G.ConfigManager.discrete_cfg[TipID[num]]
        local LingQu = true
        for key, value in pairs(self.award_lists) do
            if value == TipID[num] then
                LingQu = false
            end
        end

        if num == 1 and LingQu then
            if require "AfkModel":GetInstance():CheckSectionIsPass(goal[1][2]) then
                return true
            end
        elseif num == 2 and LingQu then
            if self.login_count >= goal[1][1] then
                return true
            end
        elseif num == 3 and LingQu then
            if require "MonthlyModel":GetInstance():IsUnlockMonthCard(goal[1][2], 1) then
                return true
            end
        end
    end

    return false
end

function HeroesGatheringModel:OpenView(data)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.HeroesGatheringView.Name,data)
end

return HeroesGatheringModel
