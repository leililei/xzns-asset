local base = require "SeasonBaseModel"
---@class SeasonShopModel:SeasonBaseModel
local SeasonShopModel = _G.BaseClass("SeasonShopModel", base)
---类的构造函数
function SeasonShopModel:__init()
    self.curFunctionOpenID = _G.FunctionID.SeasonShop
end
function SeasonShopModel:GetDataFormServer()
    --local cfg = require "SeasonModel":GetInstance():GetCfg()
    require "ShopModel":GetInstance():GetShopInServer(_G.ShopID.PvpAllHeros, _G.handler(self, self.ParseData))
end
---类的析构函数
function SeasonShopModel:Dispose()
end
---检测功能是否开启
function SeasonShopModel:CheckIsOpen()
    local isOpenSeason = require "SeasonModel":GetInstance():GetSeasonState() == _G.SeasonState.Open
    local isunlock = FunctionManager:GetInstance():CheckFunctionIsUnlock(self.curFunctionOpenID)
    if isOpenSeason and isunlock then
        return true
    end
    return false
end
function SeasonShopModel:OpenView(hideFun, openFun, ...)
    require("ShopModel"):GetInstance():OpenShop(_G.ShopID.PvpAllHeros, hideFun, openFun)
end

return SeasonShopModel
