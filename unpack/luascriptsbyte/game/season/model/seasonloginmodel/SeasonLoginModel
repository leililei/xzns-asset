local SeasonBaseModel = require "SeasonBaseModel"
local SeasonLoginModel = _G.BaseClass("SeasonLoginModel", SeasonBaseModel)
---@return SeasonLoginModel SeasonLoginModel
function SeasonLoginModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function SeasonLoginModel:__init()
    self.curFunctionOpenID = 274
    self.redPointId = -274
    _G.Events:GetInstance():AddListener(_G.eSeason.SeasonOver, self.SeasonOver, self)
end

