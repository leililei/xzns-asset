---销毁对象时,析构函数
function SeasonLoginModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eSeason.SeasonOver, self.SeasonOver, self)
end

function SeasonLoginModel:SeasonOver()
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SeasonLoginView.Name)
end

return SeasonLoginModel
