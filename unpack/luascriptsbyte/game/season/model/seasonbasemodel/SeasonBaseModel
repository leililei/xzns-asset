---检测功能是否开启
function SeasonBaseModel:CheckIsOpen()
    return require "SeasonModel":GetInstance():CheckFunctionIsOpen(self.curFunctionOpenID or self.seasonId)
end

function SeasonBaseModel:CheckFunctionIsOpen()
    local isOpen = false
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.curFunctionOpenID) then
        isOpen = true
    else
        local cfg = _G.ConfigManager.function_open_cfg[self.curFunctionOpenID]
        if self.curFunctionOpenID == _G.FunctionID.SeasonTask then
            LogError("赛季任务没有正常开放")
        end
        if cfg and _G.FunctionManager:GetInstance():CheckCondition(cfg.condition_type, self.curFunctionOpenID) then
            isOpen = true
        end
    end
    return isOpen and self:CheckIsOpen()
end

---获取模块功能是否开放
---@return boolean 是否开放
function SeasonBaseModel:GetFunctionOpen()
    local createPlayer = _G.PlayerModel:GetInstance():CheckCreateRole()
    if self.curFunctionOpenID > 0 then
        if createPlayer then
            return self:CheckFunctionIsOpen()
        end
    end
    return createPlayer
end

