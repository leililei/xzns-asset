local SeasonBaseModel = require "SeasonBaseModel"
---@class SeasonIceGiftModel	中文描述
local SeasonIceGiftModel = _G.BaseClass("SeasonIceGiftModel", SeasonBaseModel)
local table = _G.table
---@return SeasonIceGiftModel SeasonIceGiftModel
function SeasonIceGiftModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function SeasonIceGiftModel:__init()
    self.curFunctionOpenID = 100
    self.redPointId = 30590205
end

---销毁对象时,析构函数
function SeasonIceGiftModel:Dispose()
end

--region 子类重写
---从服务器拉取数据
function SeasonIceGiftModel:GetDataFormServer()
    require "SeasonIceGiftNet":GetInstance():GetInfo(_G.handler(self, self.GetInfoCall))
end
---获取信息回调
---@param msg season.s2c_season_info
function SeasonIceGiftModel:GetInfoCall(msg)
    if msg.ack == 1 then
        self:ParseData(msg.info)
    else
        self.super.ParseData(self)
    end
end
---初始化功能逻辑
function SeasonIceGiftModel:InitFunction()
end
function SeasonIceGiftModel:Dispose()
    self.Data = nil
    self.MissionCfg = nil
    self.TaskDatas = nil
    self.finishTasks = nil
end
function SeasonIceGiftModel:ParseData(info)
    if not _G.table.isEmptyOrNil(self.TaskDatas) then
        for k, v in pairs(self.TaskDatas) do
            v:Dispose()
        end
    end
    self.Data = info
    self.MissionCfg = require "SeasonModel":GetInstance():GetCfg().mission_sweeping
    self.TaskDatas = {}
    self:InitTaskData()
    self:InitFinshTask()
    self.super.ParseData(self)
end

---初始化已完成任务
function SeasonIceGiftModel:InitFinshTask()
    self.finishTasks = {}
    if self.Data.finish_task then
        for _, v in pairs(self.Data.finish_task) do
            self.finishTasks[v] = true
            self.TaskDatas[v].i_task.target[1] = self.TaskDatas[v].i_task.count
            self.TaskDatas[v].i_task.state = _G.TaskEnum.ETaskState.Submited
        end
    end
end
function SeasonIceGiftModel:InitTaskData()
    local IceGiftTaskData = require "IceGiftTaskData"
    local count = #self.MissionCfg
    for i = 1, count do
        local task = self:GetTaskInfo(self.MissionCfg[i][1])
        if not task then
            task = {
                sid = self.MissionCfg[i][1],
                target = {
                    [1] = 0
                },
                showType = self.MissionCfg[i][2]
            }
        else
            task.showType = self.MissionCfg[i][2]
        end
        self.TaskDatas[self.MissionCfg[i][1]] = IceGiftTaskData.New(task)
    end
end
---检测是否完成
function SeasonIceGiftModel:CheckIsFinish(sid)
    return self.finishTasks[sid]
end
---检测是否可以领奖
function SeasonIceGiftModel:CheckIsCanTake(sid)
    if self:CheckIsGet(sid) then
        return false
    end
    if not self.TaskDatas[sid] then
        return false
    else
        return self.TaskDatas[sid].i_task.state == _G.TaskEnum.ETaskState.Submited
    end
end
function SeasonIceGiftModel:Reset()
    self.finishTasks = {}
    for k, v in pairs(self.TaskDatas) do
        v:Reset()
    end
end
---检测是否有可领奖
function SeasonIceGiftModel:IsCanTake()
    if table.isEmptyOrNil(self.TaskDatas) then
        return false
    end
    for _, v in pairs(self.TaskDatas) do
        if self:CheckIsCanTake(v.sid) then
            return true
        end
    end
    return false
end
---检测是否未领完
---@return boolean true 未领完
function SeasonIceGiftModel:IsNotAllFinish()
    if table.isEmptyOrNil(self.TaskDatas) then
        return false
    end
    for _, v in pairs(self.TaskDatas) do
        if not self:CheckIsFinish(v.sid) then
            return true
        end
    end
    return false
end
---检测是否已经领过奖
function SeasonIceGiftModel:CheckIsGet(sid)
    return self:CheckIsFinish(sid)
end

---完成任务
---@param data HellGuardTaskData
function SeasonIceGiftModel:FinishTask(sidList, callback)
    require "SeasonIceGiftNet":GetInstance():FinishTask(
        {sid = sidList, finish_type = 2},
        function(msg)
            if msg.award then
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.PopWindowManager:GetInstance():AddAwardPopQuene(msg)
            end

            for _, sid in pairs(sidList) do
                self.finishTasks[sid] = true
                self.TaskDatas[sid].i_task.state = _G.TaskEnum.ETaskState.Submited
                self.TaskDatas[sid]:CheckTaskState()
            end
            self:RefreshRedPoint()
            if callback then
                callback(msg)
            end
            _G.Events:GetInstance():Broadcast(_G.eSeasonTask.Action, {_G.SeasonTaskID.IceGift}, 1)
            --todo refreshRedPoint
        end
    )
end
---获取任务信息
function SeasonIceGiftModel:GetTaskInfo(sid)
    if not self.Data.task_info then
        return nil
    end
    for _, v in pairs(self.Data.task_info) do
        if v.sid == sid then
            return v
        end
    end
    return nil
end
---获取模块功能是否开放
---@return boolean 是否开放
function SeasonIceGiftModel:GetFunctionOpen()
    local createPlayer = _G.PlayerModel:GetInstance():CheckCreateRole()
    if self.curFunctionOpenID > 0 then
        if createPlayer then
            return _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.curFunctionOpenID) and self:CheckIsOpen()
        end
    end
    return createPlayer
end
---获取任务数据 外部
function SeasonIceGiftModel:GetTaskDatas()
    local taskArray = {}
    for _, v in pairs(self.TaskDatas) do
        _G.table.insert(taskArray, v)
    end
    _G.SortList(
        taskArray,
        function(data)
            return -data.sid
        end
    )
    if AppSetting.IsXzns then
        local count = #taskArray
        local callGet = {}
        local Unfinished = {}
        local Completed = {}
        for i = 1, count do
            local IsGet = self:CheckIsGet(taskArray[i].sid)
            local iscantake = self:CheckIsCanTake(taskArray[i].sid)
            local state = taskArray[i].i_task.state
            if iscantake then
                table.insert(callGet,taskArray[i])
            elseif IsGet then
                table.insert(Completed,taskArray[i])
            else
                table.insert(Unfinished,taskArray[i])
            end
        end
        taskArray = {}
        self:AddTable(taskArray,callGet)
        self:AddTable(taskArray,Unfinished)
        self:AddTable(taskArray,Completed)
    end

    return taskArray
end

function SeasonIceGiftModel:AddTable(tableo,Addtable)
    local count = #Addtable
    for i = 1, count do
        table.insert(tableo,Addtable[i])
    end
end

---更新任务数据
function SeasonIceGiftModel:UpdataTask(task)
    if not self.Data then
        return
    end
    local isUpdata = false
    if task == nil or task.sid == nil then
        return isUpdata
    end
    local mTask = self:GetTaskByTaskid(task.sid)
    if mTask == nil then
        return isUpdata
    end
    mTask:UpdataData(task)
    self:RefreshRedPoint()
    return true
end
---@return HellRoadTaskData
function SeasonIceGiftModel:GetTaskByTaskid(taskid)
    for _, v in pairs(self.TaskDatas) do
        if v.sid == taskid then
            return v
        end
    end
    return nil
end
