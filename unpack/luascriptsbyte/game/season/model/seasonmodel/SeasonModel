---初始化赛季状态
function SeasonModel:InitSeasonState()
    local time = _G.TimeUtil.GetServerUnixTime()
    self.state = _G.SeasonState.Open
    if time >= self.infoData.end_time and time < self.infoData.next_open_time then
        self.state = _G.SeasonState.WaitNext
    elseif
        _G.TimeUtil.GetDayBegin(self.infoData.end_time) - 86400 + self.settlementOffsetParams[1] * 3600 +
            self.settlementOffsetParams[2] * 60 +
            self.settlementOffsetParams[3] <
            time
     then
        self.state = _G.SeasonState.Settlement
    end
    self:InitSeasonDay()
end

---初始化赛季天数
function SeasonModel:InitSeasonDay()
    self.curDay = 0
    if self.state == _G.SeasonState.Open then
        self.curDay = (_G.TimeUtil.GetIntervalDayBySix(
                self.infoData.start_time,
                _G.TimeUtil.GetServerUnixTime()
        ) // 86400) + 1

        if AppSetting.IsXzns then
            local weekid = math.floor((self.curDay - 1)/self.loopPeriod) + 1
            ---当前助阵角色ID
            self.CurHelpOutRoleIds = self:GetCurCard_support()
            local loopid = weekid % #self.CurHelpOutRoleIds
            if loopid == 0 then
                loopid = #self.CurHelpOutRoleIds
            end
            self.CurHelpOutRoleId = self.CurHelpOutRoleIds[loopid]
            local season_cfg_boss = self:GetBossCfg()
            ---@type EmbattleSeasonBoss
            local item = require("EmbattleSeasonBoss").New(_G.EmbattleType.SeasonBoss, _G.EmbattleSaveType.server,  true,season_cfg_boss.monster_group)
            local lastHelpOutRoleId = self:GetLastHelpOutRoleId()
            if lastHelpOutRoleId == 0 then
                self:SetLastHelpOutRoleId(self.CurHelpOutRoleId)
                item:InitEmbattleData()
            elseif self.CurHelpOutRoleId ~= lastHelpOutRoleId then
                --重置阵容
                item:ResetLineup()
                self:SetLastHelpOutRoleId(self.CurHelpOutRoleId)
            end
        end
    end
end

---初始化登录奖励
function SeasonModel:InitSignAward()
    self.signAward = {}
    if self.signInfo.day_index then
        for i = 1, #self.signInfo.day_index do
            self.signAward[self.signInfo.day_index[i]] = true
        end
    end
end

---检测是否能领取登录奖励
---@param index number 天数
function SeasonModel:CheckCanTakeLoginAward(index)
    return self.curDay >= index and not self:CheckGetLoginAward(index)
end

---检测奖励是否领取
---@param index number 天数
function SeasonModel:CheckGetLoginAward(index)
    return self.signAward[index]
end

function SeasonModel:GetSeasonTime()
    return _G.TimeUtil.GetServerUnixTime(), self.infoData.start_time
end

function SeasonModel:GetLoginPeriod()
    if self.curDay > 0 then
        local inday=self.curDay%7
        if inday>0 then
            return (self.curDay // 7) + 1
        else
            return self.curDay // 7
        end
    else
        return 1
    end
end

function SeasonModel:GetSignReward(id, callback)
    require "SeasonNet":GetInstance():GetSignReward(
        {index = id},
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self.signAward[id] = true
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            if callback then
                callback()
            end
            require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FirstTest.id, 274)
        end
    )
end

---初始化计时器
function SeasonModel:InitTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if not self.cfg then
        return
    end
    if not self:CheckSeasonIsOpen() then
        return
    end
    local time = _G.TimeUtil.GetServerUnixTime()
    local tb = self.settlementOffsetParams
    self.timeData.settlementTime = self.infoData.end_time - _G.TimeUtil.GAME_DAY_TIME + tb[1] * 3600 + tb[2] * 60 + tb[3] - 86400
    local offset = self.timeData.settlementTime - time
    if offset <= 0 then
        self.state = _G.SeasonState.Settlement
        return
    end
    self.timer = _G.TimerManager:GetInstance():GetTimer(offset, self.TimerOver, self, true, false, true)
    self.timer:Start()
end

---首测结算中
function SeasonModel:TimerOver()
    self.timer:Stop()
    self.timer = nil
    self:OnSettlement()
    self.state = _G.SeasonState.Settlement
    self:ChangeMainShow()
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.FirstTest.id)
end

function SeasonModel:OnEndCall(_, call)
    self.count = self.count - 1
    if call then
        call()
    end
    if self.count == 0 then
        self:ParseData()
    else
        return
    end
    if self.isNewSeason then
        self:OnSeasonStart()
    else
        for _, v in pairs(modelInstance) do
            if v:CheckIsOpen() then
                v:RefreshRedPoint()
            end
        end
    end

    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.FirstTest.id)
end

