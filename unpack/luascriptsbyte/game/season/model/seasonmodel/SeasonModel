---获取结算期时长
---@return number
function SeasonModel:GetSettlementDuration()
    local cfg = _G.ConfigManager.discrete_cfg[105116]
    if not cfg then
        return 0
    end
    local hour, min, second = cfg[1][1] or 0, cfg[1][2] or 0, cfg[1][3] or 0
    return 86400 - hour * 3600 - min * 60 - second
end

---是否在结算期中
---@return boolean
function SeasonModel:IsSettlementTime()
    local sd = self:GetSettlementDuration()
    if sd <= 0 or sd >= 86400 then
        return false
    end
    local nowTime = _G.TimeUtil.GetServerUnixTime()
    --获取赛季结束时间
    local seasonTime = self:GetTime()
    local seasonEndTime = seasonTime.startTime + self:GetLoginPeriod() * 7 * 86400 --单个赛季固定7天???
    if seasonEndTime >= seasonTime.endTime then
        seasonEndTime = seasonTime.endTime
    end

    return nowTime >= seasonEndTime - sd
end

