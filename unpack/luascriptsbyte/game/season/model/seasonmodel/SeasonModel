---创建对象时,入口构造函数
function SeasonModel:__init()
    self.curFunctionOpenID = 59
    self.settlementOffsetParams = _G.ConfigManager.discrete_cfg[105104][1]
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.AddCoin, self)
    if AppSetting.IsXzns then
        ---@type 角色循环周期
        self.loopPeriod = _G.ConfigManager.discrete_cfg[122005][1][1]
    end
end

---销毁对象时,析构函数
function SeasonModel:Dispose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.AddCoin, self)
end

