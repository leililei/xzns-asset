---获取信息回调
---@param msg season.s2c_season_info
function SeasonModel:GetInfoCall(msg)
    self.isNewSeason = false
    if self.infoData and self.infoData.end_time ~= msg.end_time then
        self:OnSeasonEnd()
        self.isNewSeason = true
    end
    self.infoData = msg
    self.timeData = {
        startTime = msg.start_time,
        endTime = msg.end_time,
        nextStartTime = msg.next_open_time,
        settlementTime = 0
    }
    self.totalCoin = msg.role_info.total_coin
    self.cfg = _G.ConfigManager.season_cfg[msg.id]
    self:InitSeasonState()
    self:InitOpenSystem()
    self.count = 1 + _G.table.count(modelInstance)
    self:InitSeasonFunctionData()
    self:InitTimer()
    require "SeasonNet":GetInstance():GetSignInfo(_G.handler(self, self.GetSignInfo))
    self:ChangeMainShow()
    if self.reconnectEndCall then
        self.reconnectEndCall()
    end
end

function SeasonModel:ReConnect(endcall)
    if self.super.GetFunctionOpen(self) then
        self.reconnectEndCall = endcall
        self.isReConnect = true
        self:InitData()
    else
        if endcall then
            endcall()
        end
    end
end
---初始化赛季功能数据
function SeasonModel:InitSeasonFunctionData()
    if self:CheckSeasonIsOpen() then
        self.count = self.count + #modelInstance
        if self.isReConnect then
            for k, v in pairs(modelInstance) do
                if v:CheckIsOpen() then
                    v:ReConnect(_G.handler(self, self.OnEndCall))
                else
                    self:OnEndCall()
                end
            end
            self.isReConnect = false
        elseif self.OnSixUpdateTag then
            for k, v in pairs(modelInstance) do
                if v:CheckIsOpen() then
                    v:OnSixClockUpdate(_G.handler(self, self.OnEndCall))
                else
                    self:OnEndCall()
                end
            end
        else
            for k, v in pairs(modelInstance) do
                if v:CheckIsOpen() then
                    v:InitData(
                        _G.handlerbind(
                            self,
                            self.OnEndCall,
                            function()
                                if v.redPointId > 0 then
                                    local redId = v.redPointId
                                    require "RedPointManager":GetInstance():AddRedPointChild(
                                        _G.ConfigManager.redpoint_cfg.FirstTest.id,
                                        redId
                                    )
                                end
                            end
                        )
                    )
                else
                    self:OnEndCall()
                end
            end
        end
    else
        for _, _ in pairs(modelInstance) do
            self:OnEndCall()
        end
    end
end

