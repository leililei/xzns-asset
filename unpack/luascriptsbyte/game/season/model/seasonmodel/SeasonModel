---获取赛季期待奖励数据
function SeasonModel:GetSeasonExpectData()
    local tb = _G.TimeUtil.TranslateSecond(self:GetNextSeasonSeasonTimeLeft())
    if tb.hour > 0 or tb.min > 0 or tb.sec > 0 then
        tb.day = tb.day + 1
    end
    local sid = self.cfg.forward[tb.day]
    if not sid then
        return nil
    else
        return _G.ConfigManager.season_login_cfg[sid] and _G.ConfigManager.season_login_cfg[sid].rewards or {}
    end
end

