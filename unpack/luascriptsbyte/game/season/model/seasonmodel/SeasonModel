---检测当前赛季功能是否开放
---@param id number 共能id
function SeasonModel:CheckFunctionIsOpen(id)
    if not self.openSystem then
        self:InitOpenSystem()
    end
    if not self:CheckSeasonIsOpen() then
        return false
    end
    if id == 0 then
        return self.infoData.id == 1
    end
    if _G.table.isEmptyOrNil(self.openSystem) then
        return false
    end
    return self.openSystem[id] or false
end

