---销毁对象时,析构函数
function SeasonTaskActivityModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eSeason.SeasonOver, self.SeasonOver, self)
end

function SeasonTaskActivityModel:SeasonOver()
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DragonChessView.Name)
end

return SeasonTaskActivityModel
