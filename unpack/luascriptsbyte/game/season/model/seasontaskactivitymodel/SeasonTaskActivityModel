---打开界面
function SeasonTaskActivityModel:OpenView(hideFun, openFun, ...)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DragonChessView.Name)
end

function SeasonTaskActivityModel:CheckIsOpen()
    return false
end

function SeasonTaskActivityModel:CheckFunctionIsOpen()
    local isOpen = false
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.curFunctionOpenID) then
        isOpen = true
    else
        local cfg = _G.ConfigManager.function_open_cfg[self.curFunctionOpenID]
        if cfg and _G.FunctionManager:GetInstance():CheckCondition(cfg.condition_type, self.curFunctionOpenID) then
            isOpen = true
        end
    end
    return isOpen and self:CheckIsOpen()
end

