---@class IceGiftTaskData	中文描述
---@field  Cfg hell_guard_cfg
local IceGiftTaskData = _G.BaseClass("IceGiftTaskData", _G.ActiveTaskBase)
local mission_extra_cfg = _G.ConfigManager.mission_extra_cfg
---类的构造函数
function IceGiftTaskData:Init(data)
    self.MarkTaskType = _G.MarkTaskType.none
end
---类的析构函数
function IceGiftTaskData:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.ePlayAactionEvent.PlayAaction, self.OnAactionEnent, self)
    _G.Events:GetInstance():RemoveListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.OnEvent_CheckLock, self)
end
---@param data justice.proto
function IceGiftTaskData:ParseData(data)
    self.i_task = data
    self.sid = data.sid
    self.showType = data.showType
    self.Cfg = mission_extra_cfg[data.sid]
    self.type = self.Cfg.type_mission
    self.i_task.taskType = self.Cfg.condition[1][1]
    if self.taskEnumType == nil then
        self.taskEnumType = self.Cfg.condition[1][1]
        self.taskcontentparams = self.Cfg.condition[1]
    end
    if self.i_task.taskEnumType == nil then
        self.i_task.taskEnumType = self.Cfg.condition[1][1]
        self.i_task.taskcontentparams = self.Cfg.condition[1]
    end
    self:CheckLock()
    self:CheckTaskState()
    self:CheckTaskTarget()
end

--- 检测任务状态
function IceGiftTaskData:CheckTaskState()
    if self.i_task == nil then
        return
    end
    --- 防止 抽卡0/5 任务  十连   服务器记录10/5
    if self.i_task.target[1] >= self.Cfg.count then
        self.i_task.target[1] = self.Cfg.count
    end
    if self.i_task.state == _G.TaskEnum.ETaskState.Claimed then
        if self.i_task.target[1] >= self.Cfg.count then
        else
            --- 次数没达到 不算完成
            return
        end

        self.i_task.state = _G.TaskEnum.ETaskState.Submited
    end
end
function IceGiftTaskData:Reset()
    self.state = _G.TaskEnum.ETaskState.Claimed
    self.curValue = 0
end

return IceGiftTaskData
