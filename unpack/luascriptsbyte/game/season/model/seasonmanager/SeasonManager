---@class SeasonManager : Singleton	中文描述
local SeasonManager = _G.BaseClass("SeasonManager", _G.Singleton)

---@return SeasonManager SeasonManager
function SeasonManager:GetInstance()
    return self.super.GetInstance(self)
end

---打开功能界面
---@param hideFun fun() 隐藏赛季界面
---@param openFun fun() 显示隐藏界面
function SeasonManager:OpenView(id, ...)
    if not self.CheckSeasonIsOpen() then
        return
    end
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(id) then
        _G.FunctionManager:GetInstance():ShowFuncitonOpenTips(id)
        return
    end
    require "SeasonModel":GetInstance():OpenView(
        id,
        function()
            _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SeasonView.Name)
        end,
        function()
            _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.SeasonView.Name)
        end,
        ...
    )
end

---打开主界面
function SeasonManager:OpenMainView()
    if require "SeasonModel":GetInstance():GetSeasonState() == _G.SeasonState.Settlement then
        _G.PopWindowManager:GetInstance():ShowAllTips(620101)
        return
    elseif require "SeasonModel":GetInstance():GetSeasonState() == _G.SeasonState.Open then
        if require "SeasonModel":GetInstance():GetBigGiftIsNotAccept() then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SeasonBigGiftEnterView.Name)
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SeasonView.Name)
        end
    elseif require "SeasonModel":GetInstance():GetSeasonState() == _G.SeasonState.WaitNext then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SeasonExpectlView.Name)
    end
end

---关闭主界面
function SeasonManager:CloseMainView()
    if _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.SeasonView.Name) then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SeasonView.Name)
    end
end

---检测赛季是否开放
function SeasonManager.CheckSeasonIsOpen()
    return require "SeasonModel":GetInstance():CheckSeasonIsOpen()
end
---检测功能是否开放
---@param id number 功能是否开放
function SeasonManager.CheckFunctionIsOpen(id)
    return require "SeasonModel":GetInstance():CheckSeasonFucntionIsOpen(id)
end

---检测赛季是否结束
function SeasonManager.CheckSeasonIsEnd()
    return require "SeasonModel":GetInstance():GetSeasonState() < _G.SeasonState.WaitNext
end

---时间转换
---@param startTime number 起始时间 单位s
---@param duration number 持续时间 单位s
function SeasonManager:FormatTime(startTime, duration)
    local stime = _G.TimeUtil.GetDateTime(startTime)
    local etime = _G.TimeUtil.GetDateTime(startTime + duration)
    local str =
        _G.LangUtil.GetLangPackValue(
        90022500829,
        stime.year,
        stime.month,
        stime.day,
        string.format("%02d:%02d", stime.hour, stime.minute),
        etime.year,
        etime.month,
        etime.day,
        string.format("%02d:%02d", etime.hour, etime.minute)
    )
    return str
end
---获取主界面按钮icon
function SeasonManager:GetMainBtnIcon()
    if not require "SeasonModel":GetInstance():GetCfg() then
        return ""
    end
    if require "SeasonModel":GetInstance():GetSeasonState() == _G.SeasonState.WaitNext then
        return "ui_zjm_btn_saijiqidai"
    else
        local cfg = require "SeasonModel":GetInstance():GetCfg()
        return cfg.resources[1][2] or "ui_zjm_btn_saijiqidai"
    end
end

return SeasonManager
