    --     end
    -- )
end

function HeroGiftPackView:FreshHero()
    local data = StorageManager:GetItemDataClass(self.dataList.cardList[self.showIndex].k, 1)
    self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(data.cfg.Name)
    local posText
    local posId = data.cfg.card_position1
    if posId > 0 then
        posText = _G.GetLangPackValue(posId)
    end
    posId = data.cfg.card_position2
    if posId > 0 then
        posText = posText .. "/" .. _G.GetLangPackValue(posId)
    end

    --加载spine
    self.go_table.obj_spineRoot:ClearChildren()
    self.go_table.obj_spineRoot:SetLocalScaleXYZ(data.cfg.size2)
    local pos = data.cfg.pos_portrait
    self.go_table.obj_spineRoot:SetLocalPosition(pos[1], pos[2], pos[3])
    local cfg = require("CardInfoManager").GetCardSkin_ShowCfg(data.skin, data.sid)
    _G.PoolsManager:GetInstance():Spawn(
        cfg.ModelPathHi,
        _G.ePoolType.Temporary,
        self.go_table.obj_spineRoot,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
            GameUtil.SetCardUiSpineAnimation(trans, "idle", true)
        end
    )

    self.go_table.aortext_des.text = posText
    self.heroItem = require "ItemCardAllView".New(self.go_table.obj_headRoot:GetChildE(0))
    self.heroItem:ShowCardData(data, nil, false)
end

function HeroGiftPackView:ScrollToIndex()
    if self.Copz then
        _G.coroutine.stopwaiting(self.Copz)
        self.Copz = nil
    end
    ---不明原因的开协程（加一个引用以便销毁处理）
    ---镇魂街ZHJ-34446 Beta_1.0.0公测BuglistZHJ-34984
    ---【真机】【英雄成长礼包】快速切换页签时，低概率出现报错
    self.Copz = _G.DelayFrameDo(
        function()
            self.go_table.scrollloopvectical_PingZhi:ScrollToIndex(self.PingZhiZhi - 1 < 0 and 0 or
                (self.PingZhiZhi - 1))
        end
    )
end

