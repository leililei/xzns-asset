---讨伐中倒计时
function HeroGiftPackView:ZanDouTimer()
    local data = self.dataList

    local timeShengYu = data:StartTime() + data:RunTime() - _G.TimeUtil.GetServerUnixTime()
    if timeShengYu <= 0 and self.Tier then
        if self.Tier then
            self.Tier = false
            if self.timeShengYus ~= nil then
                self.timeShengYus:Stop()
                self.timeShengYus = nil
            end
            self:ShuNew()
        end
        self.go_table.aortext_Time.text = ""
    else
        self.go_table.aortext_Time.text = _G.GetLangPackValue(90000001110, _G.TimeUtil.TranslateSecondForStrMiaoHui(timeShengYu, 1))
    end
end

---魂将品质界面刷新
function HeroGiftPackView:PingZhi(index, obj)
    if index < 0 then
        return
    end
    local x = index + 1
    local dataList = self.dataList
    local data = dataList:itemType(1)[x]
    local HunJiangJieSuo = dataList:IsHeroGift(data)

    local Not = HunJiangJieSuo
    local tips = self.dataList:CradData() and 240306 or 690107
    local item = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.JiangLiLingQu, data, HunJiangJieSuo, tips, x))
    self.listIndexT[obj:GetInstanceIDE()] = x
    if data then
        local lingQu = dataList:Alist(data.sid)
        item.obj_item:ClearChildren()
        local insID1 = item.obj_item:GetInstanceIDE()
        self.normalAwardCreateFlag[insID1] = {}
        for key, value in pairs(data.normal_award) do
            if key == 1 then
                local id = value.type[1]
                local num = value.type[2]
                local func = function()
                    self.normalAwardCreateFlag[insID1][key] = true
                end
                self:CreateItem(id, num, item.obj_item, item.itemTrans, lingQu, nil, nil, HunJiangJieSuo, nil, func, key,
                    obj, x)
            end
        end
        item.aorbtn_MianFei:SetActiveE(0)
        item.aorbtn_MianFeiIs:SetActiveE(0)

        if lingQu then
            item.aorbtn_MianFeiIs:SetActiveE(1)
        else
            item.aorbtn_MianFei:SetActiveE(HunJiangJieSuo and 1 or 0)
            item.aorbtn_MianFei:SetGray(not HunJiangJieSuo)
        end

        local star, a = require "CardInfoManager":GetInstance():GetCardColorName(data.condition)
        local order, _ = require "CardInfoManager":GetInstance():GetOrderStarCount(data.condition)
        if a == 0 then
            item.aortext_XingJie.text = _G.GetLangPackValue(90029300057, _G.GetLangPackValue(star), a)
        else
            item.aortext_XingJie.text = _G.GetLangPackValue(90029300057, _G.GetLangPackValue(star), a)
        end
        item.aorimage_star.SpriteName = itemColorStarName[order]
        _G.GameUtil.SetPriceByChannel(data.price_id or data.price, item.aortext_GouMai)
        _G.GameUtil.AddDouYinIcon(item.aorbtn_GouMai, true, nil, nil, nil, data.price_id or data.price)

        item.aorbtn_GouMai:SetActiveE(0)
        item.aorimage_GouMaiYi:SetActiveE(0)

        local times = dataList:CardInfo(data.sid)
        if data.count_limit - times <= 0 then
            item.aorimage_GouMaiYi:SetActiveE(1)
            Not = false
        else
            --item.aorbtn_GouMai.interactable = HunJiangJieSuo
            item.aorbtn_GouMai:SetActiveE(1)
            item.aorbtn_GouMai:SetGray(not HunJiangJieSuo)
        end
        local num = data.count_limit - dataList:CardInfo(data.sid)
        local txt = num <= 0 and ("<color=#c12214>" .. num .. "</color>") or num
        item.aortext_XianGou.text = _G.GetLangPackValue(90029300058, txt, data.count_limit)
        -- if HunJiangJieSuo then
        --     --item.aorimage_GuanQuan:SetActiveE(1)
        --     item.aorimage_Mask:SetActiveE(0)
        -- else
        --     item.aorimage_Mask:SetActiveE(1)
        --     --item.aorimage_GuanQuan:SetActiveE(0)
        -- end
        -- local card = _G.ConfigManager.card_cfg[dataList.CradId]
        -- local CurCardItem = require("ItemCardAllView").New(item.trans_Root)
        -- item.aortext_XianGou.color = chooseHuiColor[HunJiangJieSuo and 2 or 1]
        item.aorbtn_GouMai:GetComponentE(_G.typeof(_G.CS.AorImage)).color = require("CardInfoManager").GetColorFromRGB(HunJiangJieSuo and "FFFFFF" or "A9A9A9")
        item.aortext_GouMai.color = chooseHuiColor[HunJiangJieSuo and 2 or 1]
        item.aortext_MianFei.color = chooseHuiColor[HunJiangJieSuo and 2 or 1]

        -- CurCardItem:Show(card.id, nil, data.condition[1].v)
        -- CurCardItem:HideOrShowStar(false)
        local insID2 = item.obj_Content:GetInstanceIDE()
        item.obj_Content:ClearChildren()
        self.payAwardCreateFlag[insID2] = {}
        if data.other_award and data.other_award[1] then
            local typeFlag = data.other_award[1].k
            local index = self.showIndex
            local ID = typeFlag == 1 and dataList.cardList[index].k or dataList.cardList[index].v
            self:item(1, item.obj_Content, item, data, Not, dataList, HunJiangJieSuo, ID, data.other_award[1].v, obj, x)
        end
        for key, value in pairs(data.pay_award) do
            self:item(key, item.obj_Content, item, data, Not, dataList, HunJiangJieSuo, nil, nil, obj, x)
        end
        -- item.scrollloophorizontal_Item:InitItemData(
        --     _G.table.count(data.pay_award),
        --     _G.handlerbind(self, self.item, data, Not)
        -- )
        --item.transform:SetSiblingIndexE(x - 1)
    end
    ---放置item到最后
    return item
end

---奖励领取
function HeroGiftPackView:JiangLiLingQu(go, isOn, data, HunJiangJieSuo, tip, x)
    local name = go:GetName()
    if name == "@_aorbtn_MianFei" then
        if HunJiangJieSuo then
            local function request()
                if self.viewType == 1 then
                    require "HeroGiftPackSynModel":GetInstance():JiangLiLingQu(
                        data.sid,
                        2,
                        function()
                            if self.BtnBool == 1 then
                                self.go_table.scrollloopvectical_PingZhi:UpdateItemSingle(x - 1)
                            else
                                self:HunJiangChengZhang()
                            end
                            self:NewXuanZhe()
                        end,
                        self.BiaoTi
                    )
                else
                    require "SeasonHeroGiftPackModel":GetInstance():JiangLiLingQu(
                        data.sid,
                        2,
                        function()
                            if self.BtnBool == 1 then
                                self.go_table.scrollloopvectical_PingZhi:UpdateItemSingle(x - 1)
                            else
                                self:HunJiangChengZhang()
                            end
                            self:NewXuanZhe()
                            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg
                                                                                   .SeasonHeroGiftPack.id)
                        end
                    )
                end
            end
            local curCardId = self.dataList.cardList[self.showIndex].k
            if curCardId ~= self.dataList.CradId then
                --更换选择的角色id(服务器记录的还是上一期的角色id)
                if self.viewType == 1 then
                    require "HeroGiftPackSynModel":GetInstance():Choose(
                        curCardId,
                        function()
                            self:NewXuanZhe()
                            request()
                        end,
                        self.BiaoTi
                    )
                else
                    require "SeasonHeroGiftPackModel":GetInstance():Choose(
                        curCardId,
                        function()
                            self:NewXuanZhe()
                            request()
                        end
                    )
                end
            else
                request()
            end
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(tip)
        end
    elseif name == "@_aorbtn_GouMai" then
        if HunJiangJieSuo then
            if self.viewType == 1 then
                require "HeroGiftPackSynModel":GetInstance():Mall(
                    data,
                    function()
                        if self.BtnBool == 1 then
                            self.go_table.scrollloopvectical_PingZhi:UpdateItemSingle(x - 1)
                        else
                            self:HunJiangChengZhang()
                        end
                        self:NewXuanZhe()
                    end,
                    self.BiaoTi
                )
            else
                require "SeasonHeroGiftPackModel":GetInstance():Mall(
                    data,
                    function()
                        if self.BtnBool == 1 then
                            self.go_table.scrollloopvectical_PingZhi:UpdateItemSingle(x - 1)
                        else
                            self:HunJiangChengZhang()
                        end
                        self:NewXuanZhe()
                    end
                )
            end
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(tip)
        end
    end
end

---购买奖励展示
function HeroGiftPackView:item(index, obj, item, data, eff, dataList, unlock, ID, NUM, listObj, listIndex)
    if index < 0 then
        return
    end
    local x = index

    local id = ID or data.pay_award[x].type[1]
    local num = NUM or data.pay_award[x].type[2]
    local lingQu = true
    local showIndex = 0
    if _G.AppSetting.IsXzns then
        if ID and x == 1 then
            for k, v in pairs(specialIndex) do
                if v == listIndex then
                    showIndex = k
                    break
                end
            end
        end
    end
    if data.count_limit - dataList:CardInfo(data.sid) > 0 then
        lingQu = false
    end
    local insID = obj:GetInstanceIDE()
    local func = function()
        self.payAwardCreateFlag[insID][index] = true
    end
    self:CreateItem(id, num, obj, item.ContentTrans, lingQu, nil, not unlock, nil, 0.9, func, index, listObj, listIndex, showIndex)
end

---创建物品节点
function HeroGiftPackView:CreateItem(Sid, number, Parent, gotabletrans, isGou, eff, lock, canGet, scale, call, awardIndex,
                                     listObj, listIndex, showIndex)
    if _G.IsNil(Parent) or Parent:GetctiveInHierarchy() == 0 then
        return
    end
    local loadobj = gotabletrans
    if not loadobj then
        loadobj = 1
        _G.StorageManager:GetInstance():GetItemBaseView(
            Sid,
            number,
            Parent,
            function(item)
                local insID = Parent:GetInstanceIDE()

                --- 原判断为生成的预制体存储在payAwardCreateFlag里 为防止原updateView刷新列表时重复生成 后已修正
                --- 现取消此判断
                if self.listIndexT[listObj:GetInstanceIDE()] ~= listIndex then
                    item.gameObject:DestroyObject()
                    return
                end
                loadobj = item
                item:SetGou(isGou)
                if not isGou and lock then
                    local obj
                    if AppSetting.IsXzns then
                        obj = _G.InstantiateObject(self.go_table.obj_lockXzns, item.gameObject)
                    else
                        obj = _G.InstantiateObject(self.go_table.obj_lock, item.gameObject)
                    end
                    obj:SetLocalPositionToZero()
                end
                if _G.AppSetting.IsXzns then
                    if showIndex and showIndex > 0 then
                        local tag = _G.InstantiateObject(
                            self.go_table.aorrawimage_SpecialTag, 
                            item.gameObject
                        ):GetComponentE(_G.typeof(_G.CS.AorRawImage))
                        tag:SetLocalPosition(-28, 52)
                        tag:LoadImage(
                        specialTag[showIndex],
                            function(img)
                                img:SetNativeSize()
                            end
                        )
                    end
                end
                item.gameObject:SetLocalScaleXYZ(scale or 1)
                _G.GameUtil.SetActiveByCondition(item.gameObject, true)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                if item.HideOrShowLevel then 
                    item:HideOrShowLevel(false)
                end 
                if item.HideOrShowSpEffect then 
                    item:HideOrShowSpEffect(false)
                end 
                if item.ShowCount then 
                    item:ShowCount(number)
                end
                if call then
                    call()
                end
                local effCfg, key = _G.StorageManager:GetInstance():GetCommonLightEffect(Sid)
                if eff then
                    _G.UIUtils.LoadEffectByCfg(effCfg, item.gameObject)
                end
                if canGet and not isGou then
                    _G.UIUtils.LoadEffectByCfg(
                        _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
                        item.gameObject,
                        function(tran)
                            --- 防止 异步后
                            if _G.IsNil(self.go_table.gameObject) then
                                tran:DestroyObject()
                                return
                            end

                            if tran ~= nil then
                                --tran:SetLocalScaleXYZ(0.8)
                                tran:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                            end
                        end
                    )
                end
            end
        )
    else
        if not _G.IsNumber(loadobj) then
            local item = loadobj
            item:SetGou(isGou)
            if not isGou and lock then
                local obj
                if AppSetting.IsXzns then
                    obj = _G.InstantiateObject(self.go_table.obj_lockXzns, item.gameObject)
                else
                    obj = _G.InstantiateObject(self.go_table.obj_lock, item.gameObject)
                end
                obj:SetLocalPositionToZero()
            end
            item.gameObject:SetLocalScaleXYZ(1)
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)

            local effCfg, key = _G.StorageManager:GetInstance():GetCommonLightEffect(Sid)
            if eff then
                _G.UIUtils.LoadEffectByCfg(effCfg, item.gameObject)
            end
            if canGet then
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
                    item.gameObject,
                    function(tran)
                        --- 防止 异步后
                        if _G.IsNil(self.go_table.gameObject) then
                            tran:DestroyObject()
                            return
                        end

                        if tran ~= nil then
                            --tran:SetLocalScaleXYZ(0.8)
                            tran:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                        end
                    end
                )
            end
        end
    end
end

