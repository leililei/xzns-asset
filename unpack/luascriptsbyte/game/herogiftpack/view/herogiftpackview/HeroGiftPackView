---标题刷新
function HeroGiftPackView:FreshList(index, obj)
    if index < 0 then
        return
    end
    local x = index + 1
    --local instanceID = obj:GetInstanceIDE()
    local item

    local data = require "HeroGiftPackSynModel":GetInstance():CradCfgList(x)

    if data ~= nil then
        local card = _G.ConfigManager.card_cfg[data:CradData()]
        item = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.ClickItemBtn, x))

        local CurCardItem = require("ItemCardAllView").New(item.trans_Root)

        CurCardItem:Show(card.id, nil, card.Star)
        CurCardItem:HideOrShowStar(false)

        if _G.TimeUtil.GetServerUnixTime() < data:StartTime() then
            if self.TimeList[x] == nil then
                self.TimeList[x] = _G.TimerManager:GetInstance():GetTimer(
                    data:StartTime() - _G.TimeUtil.GetServerUnixTime(),
                    self.ShuNew,
                    self,
                    false,
                    false,
                    true
                )
                self.TimeList[x]:Start()
            end

            item.gameObject:SetActiveE(0)
        elseif _G.TimeUtil.GetServerUnixTime() > data:StartTime() + data:RunTime() then
            item.gameObject:SetActiveE(0)
        else
            item.gameObject:SetActiveE(1)
        end
        if self.Til[x] then
            item = self.Til[x]
        else
            self.Til[x] = item
        end
        item.aortext_togDesc.text = data.title
    end
    return item
end

