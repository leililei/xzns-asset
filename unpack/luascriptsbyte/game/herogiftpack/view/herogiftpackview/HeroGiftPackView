function HeroGiftPackView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:Close()
        if self.openFun then
            self.openFun()
        end
    elseif name == "@_aorbtn_Quality" then
        -- body
        if self.BtnBool == 1 then
            return
        end
        self.BtnBool = 1
        self:BtnNew()
        self:HunJiangStar()
    elseif name == "@_aorbtn_GrowUp" then
        if self.BtnBool == 2 then
            return
        end
        self.BtnBool = 2
        self:BtnNew()
        self:HunJiangChengZhang()
    elseif name == "@_aorbtn_go" then
        local uiSP = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DrawUpMainView.Name)
        local ui = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SPDrawUpMainView.Name)
        if ui or uiSP then
            self:Close()
        else
            local link = 115001
            if link then
                if link ~= 0 then
                    if _G.ConfigManager.item_way_cfg[link] then
                        _G.JumpManager:GetInstance():Jump(link)
                    end
                else
                    _G.PopWindowManager:GetInstance():ShowAllTips(690102)
                end
            end
        end
    elseif name == "@_aorbtn_lock" then
        if self.dataList:CradData() then
            return
        end
        _G.PopWindowManager:GetInstance():ShowAllTips(
            690106,
            nil,
            _G.handlerbind(self, self.LockHero),
            nil,
            nil,
            nil,
            self.go_table.aortext_name.text
        )
    elseif name == "@_aorbtn_change" or name == "@_aorbtn_change2" then
        local cardT = {}
        for key, value in ipairs(self.dataList.cardList) do
            local data = _G.StorageManager:GetInstance():GetItemDataClass(value.k, 1)
            table.insert(cardT, data)
        end
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.HeroGiftPackSelectView.Name,
            cardT,
            self.showIndex,
            self.LockHero
        )
    end
end

function HeroGiftPackView:LockHero()
    if self.viewType == 1 then
        require "HeroGiftPackSynModel":GetInstance():Choose(
            self.dataList.cardList[self.showIndex].k,
            function()
                self:NewXuanZhe()
            end,
            self.BiaoTi
        )
    else
        require "SeasonHeroGiftPackModel":GetInstance():Choose(
            self.dataList.cardList[self.showIndex].k,
            function()
                self:NewXuanZhe()
            end
        )
    end
end

function HeroGiftPackView:OnStartClose()
    if self.timeShengYus ~= nil then
        self.timeShengYus:Stop()
        self.timeShengYus = nil
    end
end

function HeroGiftPackView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eHeroGiftPack.ParseData, self.ReConentPareData, self)
    if self.timeShengYus ~= nil then
        self.timeShengYus:Stop()
        self.timeShengYus = nil
    end
    for _, value in pairs(self.TimeList) do
        value:Stop()
    end
    if self.Co then
        _G.coroutine.stopwaiting(self.Co)
        self.Co = nil
    end
    if self.Copz then
        _G.coroutine.stopwaiting(self.Copz)
        self.Copz = nil
    end
end

---检查一下滑动时标签上的特效要不要显示
function HeroGiftPackView:CheckCurTilEff()
    self.curTilContentX, self.curTilContentY = self.go_table.obj_Content:GetAnchorPosition()
    if (self.curTil.aorimage_isOn:GetActiveSelf() == 1) then
        if
        (self.curTilContentY >= (100 * (self.BiaoTi - 1) + 20) or
            self.curTilContentY <= (-495 + 100 * (self.BiaoTi - 1)))
        then
            self.curTil.aorimage_isOn:SetActiveE(0)
        end
    elseif (self.curTil.aorimage_isOn:GetActiveSelf() == 0) then
        if
        (self.curTilContentY <= (100 * (self.BiaoTi - 1) + 20) and
            self.curTilContentY >= (-495 + 100 * (self.BiaoTi - 1)))
        then
            self.curTil.aorimage_isOn:SetActiveE(1)
        end
    end
end

