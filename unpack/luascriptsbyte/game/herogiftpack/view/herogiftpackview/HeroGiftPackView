---魂将品质刷新
function HeroGiftPackView:HunJiangStar()
    self.go_table.scrollloopvectical_PingZhi:SetActiveE(1)
    self.go_table.obj_ScrollView:SetActiveE(0)
    local dataList = self.dataList
    local count = _G.table.count(dataList:itemType(self.BtnBool))
    self.go_table.scrollloopvectical_PingZhi:UpdateCount(count)
    for i = 1, count do
        local data = dataList:itemType(1)[i]
        if data then
            local HunJiangJieSuo = dataList:IsHeroGift(data)
            local lingQu = dataList:Alist(data.sid)
            if HunJiangJieSuo == true and lingQu == false then
                self.go_table.scrollloopvectical_PingZhi:ScrollToIndex(i - 1)
                break
            end
        end
    end
    self.PingZhiZhi = 0
    for i = 1, _G.table.count(dataList:itemType(self.BtnBool)) do
        local data = dataList:itemType(1)[i]
        local HunJiangJieSuo = dataList:IsHeroGift(data)
        local lingQu = dataList:Alist(data.sid)
        if self.PingZhiZhi == 0 and HunJiangJieSuo and not lingQu then
            self.PingZhiZhi = i
        end
    end

    -- if self.Co then
