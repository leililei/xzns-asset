---播放动画
function HeroGiftPackSelectView:PlayAni()
    local Tweening = _G.CS.DG.Tweening
    self.tweer = self.go_table.obj_ring2:DOLocalMoveY(34, 1):SetEase(Tweening.Ease.InOutSine):SetLoops(
            -1,
            Tweening.LoopType.Yoyo
    )
end

function HeroGiftPackSelectView:OnClickItem(go, isOn, tb)
    local data = self.curCardData[tb.index]
    if self.selectCardId == data.sid then
        return
    end
    self.selectCardId = data.sid
    self.selectIndex = tb.index
    self.go_table.scrollloopvectical_CardList:UpdateAllItem()
    self:UpdateCardShow(data)
end

---按钮点击事件在这里派发
function HeroGiftPackSelectView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_enter then
        if self.cardId == self.selectCardId then
            self:Close()
        else
            local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.HeroGiftPackView.Name)
            if view then
                view.showIndex = self.selectIndex
                --view:ChooseHero(self.selectIndex)
                view:LockHero()
            end
            -- if self.callback then
            --     self.callback(self.selectIndex)
            -- end
            self:Close()
        end
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.aorbtn_showInfo then
        self:OnLongPress(self.selectCardId)
    else
        --self:OnToggle(go, isOn)
    end
end

function HeroGiftPackSelectView:OnStartClose()
    if self.tweer then
        self.tweer:Kill()
        self.tweer = nil
    end
end

return HeroGiftPackSelectView
