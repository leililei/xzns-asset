---刷新卡牌显示
function HeroGiftPackSelectView:RefreshList(index, obj)
    local instanceID = obj:GetInstanceIDE()
    local tb = self.itemList[instanceID]
    local data = self.curCardData[index + 1]
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickItem, tb))
        tb.item = require "ItemCardAllView".New(tb.obj_Root:GetChildE(0))
        self.itemList[instanceID] = tb
        tb.aorbtn_click.LongPress = true
        tb.aorbtn_click.onLongPress = _G.handlerbind(self, self.OnLongPress, data.sid)
    end
    tb.item:ShowCardData(data, nil, false)
    if data.sid == self.cardId then
        _G.GameUtil.SetActiveByCondition(tb.obj_use, true)
    else
        _G.GameUtil.SetActiveByCondition(tb.obj_use, false)
    end
    local isLock = data.uid == data.sid or data.uid == 0
    -- _G.GameUtil.SetActiveByCondition(tb.obj_mask, isLock)
    -- tb.item.go_table.aorimage_ColorBg:SetGray(isLock)
    -- tb.item.go_table.aorimage_Icon:SetGray(isLock)
    -- tb.item.go_table.aorimage_diban:SetGray(isLock)
    -- tb.item.go_table.aorimage_Color:SetGray(isLock)
    tb.index = index + 1
    -- _G.GameUtil.SetActiveByCondition(tb.item.go_table.aorimage_diban, false)
    _G.GameUtil.SetActiveByCondition(tb.obj_use, data.sid == self.selectCardId)
end

