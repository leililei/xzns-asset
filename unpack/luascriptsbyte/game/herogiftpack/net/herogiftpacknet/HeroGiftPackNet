---英雄升星礼包锁定英雄
---@param callback function 完成回调
---@param type number 1 限时招募升星礼包  2 赛季升星礼包
function HeroGiftPackNet:Choose(type, pbData, callback)
    local port,item
    if type == 1 then 
        item = _G.ConfigManager.net_map.game_activity_module_port_hero_gift_choose_card
    else 
        item = _G.ConfigManager.net_map.game_season_hero_gift_port_choose_card
    end
    port = base.Access(self, item, pbData, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

---赛季英雄升星礼包领取免费礼包
---@param callback function 完成回调
function HeroGiftPackNet:GetAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_season_hero_gift_port_award
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

---赛季英雄升星礼包获取信息
---@param callback function 完成回调
function HeroGiftPackNet:GetPackInfo(callback)
    local item = _G.ConfigManager.net_map.game_season_hero_gift_port_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function HeroGiftPackNet:Callback(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type HeroGiftPackNet
return HeroGiftPackNet
