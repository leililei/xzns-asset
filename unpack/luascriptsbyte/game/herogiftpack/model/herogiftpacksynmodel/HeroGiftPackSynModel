function HeroGiftPackSynModel:OnMallCashListener(data)
    if self.sid ~= nil and self.sid == data.sid then
        self:CardInfoJia(self.BiaoTi, self.sid)
        if self.call ~= nil then
            self.call()
        end
    end
end

function HeroGiftPackSynModel:HuoDongKaiQi(num)
    if num == nil then
        if self.activityList == nil then
            self.activityList = {}
        end
        for key, value in pairs(self.activityList) do
            if value ~= nil then
                local timeShengYu = value:StartTime() + value:RunTime() - _G.TimeUtil.GetServerUnixTime()
                if timeShengYu > 0 then
                    return true
                end
            -- body
            end
        end
    else
        local data = self:CradCfgList(num)
        if data ~= nil then
            local timeShengYu = data:StartTime() + data:RunTime() - _G.TimeUtil.GetServerUnixTime()
            if timeShengYu > 0 then
                return true
            end
        -- body
        end
    end

    return false
end

---根据子活动ID找到对应的活动id
---@param sub_type number 子活动ID
function HeroGiftPackSynModel:GetActivityByCardId(sub_type,main_type)
    if self.activityCradIdList == nil or self.activityCradIdList[sub_type] == nil or #self.activityCradIdList[sub_type] == 0 or self.activityCradIdList[sub_type][main_type] == nil then
        return nil
    else
        local data = self.activityList[self.activityListID[self.activityCradIdList[sub_type][main_type]]]
        return data
    end
end

function HeroGiftPackSynModel:RemoveActivityData(id)
    if not id then
        return
    end
    if self.activityList[id] then
        self.activityList[id] = nil
    end
    if self.activityListID[id] then
        self.activityListID[id] = nil
    end
end

--endregion
---销毁对象时,析构函数
function HeroGiftPackSynModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    _G.Events:GetInstance():RemoveListener(_G.eTalent.TalentActiveFinish, self.TianFvDengJi, self)
    _G.Events:GetInstance():RemoveListener(_G.eHunLianEvents.ActiveHunLian, self.HunLianDengJi, self)
    _G.Events:GetInstance():RemoveListener(_G.eHunLianEvents.UpLevelhHuiLian, self.HunLianDengJi, self)
end

function HeroGiftPackSynModel:GetSkinGiftData()
    for i = 1, #self.activityListID do
        local data = self:CradCfgList(i)
        local main_type = 1
        if data and data.curActivityClass and data.curActivityClass.cfg then
            main_type = data.curActivityClass.cfg.info.front.main_type
        end
        if main_type and main_type == 2 then
            return data
        end
    end
    return nil
end

return HeroGiftPackSynModel
