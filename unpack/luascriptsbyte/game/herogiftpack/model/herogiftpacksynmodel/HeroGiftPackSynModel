function HeroGiftPackSynModel:Choose(cardSid, call, BiaoTi)
    local data = self:CradCfgList(BiaoTi)

    require "HeroGiftPackNet":GetInstance():Choose(
        1,
        {activity_id = data:RetActivityID(), card_sid = cardSid},
        function(msg)
            if msg.ack == 1 then
                data:SetCardData(cardSid)
                data:FreshCanList(msg.can_list)
                local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.HeroGiftPackView.Name)
                if view then
                    view:ChooseHero()
                end
                if call ~= nil then
                    call()
                end
                --require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.AdvancedGift.id, data.sub_type)
                require("DrawUpMainModel"):GetInstance():RefreshAllHeroGiftRedPoint()
            end
        end
    )
end
---奖励领取（2是领取免费奖励，1是提交奖励
function HeroGiftPackSynModel:JiangLiLingQu(sid, num, call, BiaoTi)
    local data = self:CradCfgList(BiaoTi)

    if num == 2 then
        local isOpen = self:HuoDongKaiQi(BiaoTi)

        self.VipOpHeroGiftPacken = isOpen
        if not isOpen then
            _G.PopWindowManager:GetInstance():ShowAllTips(730102)
            return
        end
    end

    data.curActivityClass.typeClass:GetAward(
        {sid, num},
        function(msg)
            if msg.award then
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            end
            if call ~= nil then
                _G.table.insert(data.a_list, sid)
                if not data:CanAward(sid) then
                    _G.table.insert(data.can_list, sid)
                end
                --require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.AdvancedGift.id, data.sub_type)
                require("DrawUpMainModel"):GetInstance():RefreshAllHeroGiftRedPoint()
                call()
            end
        end
    )
end
