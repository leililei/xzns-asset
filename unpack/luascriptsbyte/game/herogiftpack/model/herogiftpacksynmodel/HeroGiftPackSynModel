---@field infoData HeroGiftPackData 好友助战信息数据
---@class HeroGiftPackSynModel : ActivitySynTypeBase	中文描述
local HeroGiftPackSynModel = _G.BaseClass("HeroGiftPackSynModel", _G.GameDataModelBase)

function HeroGiftPackSynModel:__init()
    ---活动id索引列表
    if self.activityListID == nil then
        self.activityListID = {}
    end

    ---活动数据保存字典，key值为活动id
    if self.activityList == nil then
        ---@type table<number,HeroGiftPackData>
        self.activityList = {}
    end
    ---活动数据保存字典，key值为英雄id
    if self.activityCradIdList == nil then
        self.activityCradIdList = {}
    end
end

---获取服务器数据
---@param activity activity_hero_gift.i_activity_hero_gift
---@param activity ActivitySynBase
function HeroGiftPackSynModel:SetSelfData(info, activity)
    ---活动id索引列表
    if self.activityListID == nil then
        self.activityListID = {}
    end

    ---活动数据保存字典，key值为活动id
    if self.activityList == nil then
        self.activityList = {}
    end
    ---活动数据保存字典，key值为英雄id
    if self.activityCradIdList == nil then
        self.activityCradIdList = {}
    end
    ---@type HeroGiftPackData
    local infoData = require "HeroGiftPackData".New(activity, info)
    infoData:Parse(activity, info)

    local sub_type = infoData:GetSubType()
    local ActivityID = infoData:RetActivityID()
    local main_type = infoData.curActivityClass.cfg.info.front.main_type
    if main_type == nil then
        main_type = 1
    end
    if self.activityList[ActivityID] == nil then
        self.activityList[ActivityID] = {}
        _G.table.insert(self.activityListID, ActivityID)

        local num = _G.table.count(self.activityListID)
        if  self.activityCradIdList[sub_type] == nil then
            self.activityCradIdList[sub_type]= {}
        end
        if self.activityCradIdList[sub_type][main_type] == nil then
            self.activityCradIdList[sub_type][main_type] = {}
        end
        self.activityCradIdList[sub_type][main_type] = num
    end
    self.activityList[ActivityID] = infoData

    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    _G.Events:GetInstance():AddListener(_G.eTalent.TalentActiveFinish, self.TianFvDengJi, self)
    _G.Events:GetInstance():AddListener(_G.eHunLianEvents.ActiveHunLian, self.HunLianDengJi, self)
    _G.Events:GetInstance():AddListener(_G.eHunLianEvents.UpLevelhHuiLian, self.HunLianDengJi, self)
    self:ReqMax()
    local biaoti = self.activityCradIdList[sub_type][main_type]
    if #infoData.cardList == 1 and not infoData:CradData() then
        self:Choose(infoData.cardList[1].k, nil, biaoti)
    end
    _G.Events:GetInstance():Broadcast(_G.eHeroGiftPack.ParseData)
end
---全部红点检测
function HeroGiftPackSynModel:ReqMax()
    for key, value in pairs(self.activityList) do
        local timeShengYu = value:StartTime() + value:RunTime() - _G.TimeUtil.GetServerUnixTime()
        local CradDataID = value:CradData()
        if timeShengYu > 0 and CradDataID then
            local card = _G.StorageManager:GetInstance():GetMaxStarCardBySid(CradDataID)
            if card ~= nil then
                self:StarDengJi(card.star, CradDataID)
            end

            local MaxTianFu = _G.StorageManager:GetInstance():GetMaxTianFuCardBySid(CradDataID)
            if MaxTianFu ~= nil then
                self:TianFvDengJi(CradDataID, _G.table.count(card.open_inborn))
            end
            local DengJi = _G.StorageManager:GetInstance():GetMaxHunLianCardBySid(CradDataID)
            if DengJi ~= nil then
                self:HunLianDengJi(CradDataID, DengJi.soulLink_lv)
            end
        end
    end
end

---根据id返回对应item数据
function HeroGiftPackSynModel:CradCfgList(id)
    return self.activityList[self.activityListID[id]]
end

---红点判断
function HeroGiftPackSynModel:HongDianCanAward()
    if self.activityList ~= nil then
        for key, value in pairs(self.activityList) do
            if value:HongDianCanAward() then
                return true
            end
        end
    end
    return false
end
---单个红点显示
function HeroGiftPackSynModel:HongDianCanAwardOne(Id)
    for key, value in pairs(self.WuJiang[self.WuJiangNum[Id]]) do
        if self:CanAward(value.sid) then
            if not self:Alist(value.sid) then
                return 1
            end
        end
    end
    return 0
end

---星级等级提升
function HeroGiftPackSynModel:StarDengJi(level, sid)
    local dataT = self:GetPackDataByCardSid(sid)
    if dataT == nil then
        return
    end
    local card = _G.StorageManager:GetInstance():GetMaxStarCardBySid(sid)
    if card == nil or card.star > level then
        return
    else
        for k, data in ipairs(dataT) do
            local sub_type = data:GetSubType()
            for key, value in pairs(data:itemType(1)) do
                if value.condition <= level then
                    if not data:CanAward(value.sid) and not data:Alist(value.sid) then
                        local main_type = data.curActivityClass.cfg.info.front.main_type
                        if main_type == nil then
                            main_type = 1
                        end
                        self:JiangLiLingQu(value.sid, 1, nil, self.activityCradIdList[sub_type][main_type])
                        _G.table.insert(data.can_list, value.sid)
                    --require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.AdvancedGift.id, sub_type)
                    end
                end
            end
        end
    end
end
---天赋等级提升
function HeroGiftPackSynModel:TianFvDengJi(sid, level)
    local dataT = self:GetPackDataByCardSid(sid)
    if dataT == nil then
        return
    end
    local card = _G.StorageManager:GetInstance():GetMaxTianFuCardBySid(sid)
    if card == nil or _G.table.count(card.open_inborn) > level then
        return
    else
        for k, data in ipairs(dataT) do
            for key, value in pairs(data:itemType(2)) do
                if value.condition <= level then
                    if not data:CanAward(value.sid) and not data:Alist(value.sid) then
                        local main_type = data.curActivityClass.cfg.info.front.main_type
                        if main_type == nil then
                            main_type = 1
                        end
                        self:JiangLiLingQu(value.sid, 1, nil, self.activityCradIdList[data:GetSubType()][main_type])

                        _G.table.insert(data.can_list, value.sid)
                    --require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.AdvancedGift.id, data:GetSubType())
                    end
                end
            end
        end
    end
end
---魂链等级提升
function HeroGiftPackSynModel:HunLianDengJi(sid, level)
    local dataT = self:GetPackDataByCardSid(sid)
    if dataT == nil then
        return
    end
    local card = _G.StorageManager:GetInstance():GetMaxHunLianCardBySid(sid)
    if card == nil or card.soulLink_lv > level then
        return
    else
        for k, data in ipairs(dataT) do
            for key, value in pairs(data:itemType(3)) do
                if value.condition <= level then
                    if not data:CanAward(value.sid) and not data:Alist(value.sid) then
                        local main_type = data.cfg.info.front.main_type
                        if main_type == nil then
                            main_type = 1
                        end
                        self:JiangLiLingQu(value.sid, 1, nil, self.activityCradIdList[data:GetSubType()][main_type])

                        _G.table.insert(data.can_list, value.sid)
                    --require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.AdvancedGift.id, data:GetSubType())
                    end
                end
            end
        end
    end
end

function HeroGiftPackSynModel:GetPackDataByCardSid(sid)
    local dataT
    for k, v in pairs(self.activityList) do
        if v:CradData() == sid then
            dataT = dataT or {}
            table.insert(dataT, v)
        end
    end
    return dataT
end

