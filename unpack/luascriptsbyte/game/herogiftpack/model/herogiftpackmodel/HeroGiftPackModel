function HeroGiftPackModel:__init()
    self.activityId = self.curActivityClass:GetActivityID()
    self.curActivityClass:AddStateChanged(self.OnActivityStateChanged, self)
end

function HeroGiftPackModel:OnActivityStateChanged(state)
    if state == ActivitySynManager.State.Close then
        require "HeroGiftPackSynModel":GetInstance():RemoveActivityData(self.activityId)
    end
end

