function SeasonHeroGiftPackModel:UpdateCardUpStar(star)
    if _G.PlayerPrefsManager.HasKey("SeasonHeroGiftMaxStar") then
        if _G.PlayerPrefsManager.GetInt("SeasonHeroGiftMaxStar") < star then
            self:ReqMax()
            require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SeasonHeroGiftPack.id)
        end
    end
end

function SeasonHeroGiftPackModel:AddOrRemoveCard(add, rem)
    if self.start_time == nil then
        return
    end
    if add then
        local star, card
        for uid, sid in pairs(add) do
            card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
            if card then
                if star == nil or star < card:GetStar() then
                    star = card:GetStar()
                end
            end
        end
        if star then
            self:UpdateCardUpStar(star)
        end
    end
end

