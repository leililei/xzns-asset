function SeasonHeroGiftPackModel:TimesNum(sid)
    for key, value in pairs(self.times) do
        if value.k == sid then
            return value.v
        end
    end
    return 0
end

---增加礼包）已经购买次数(没有返回0)
function SeasonHeroGiftPackModel:CardInfoJia(sid)
    for key, value in pairs(self.times) do
        if value.k == sid then
            value.v = value.v + 1
            return
        end
    end
    _G.table.insert(self.times, {k = sid, v = 1})
end
---红点判断
function SeasonHeroGiftPackModel:HongDianCanAward()
    --local CradDataID = self:CradData()
    --if not CradDataID then
    --    return true
    --end
    if _G.AppSetting.IsXzns then
        if self.isLogin then--每次登录都刷一次是否有可购买的礼包，有可购买礼包就显示红点
            if not _G.table.isEmptyOrNil(self.a_list) then
                for _, v in pairs(self.a_list) do
                    if self:CardInfo(v) == 0 then
                        return true
                    end
                end
            end
            if not _G.table.isEmptyOrNil(self.can_list) then
                for _, v in pairs(self.can_list) do
                    if self:CardInfo(v) == 0 then
                        return true
                    end
                end
            end
        end
        if not _G.table.isEmptyOrNil(self.item) then
            for key, value in pairs(self.item) do
                if self:CanAward(value.sid) then
                    if not self:Alist(value.sid) then
                        return true
                    end
                end
            end
        end
    else
        for key, value in pairs(self.item or {}) do
            if self:CanAward(value.sid) then
                if not self:Alist(value.sid) then
                    return true
                end
            end
        end
    end
    return false
end
