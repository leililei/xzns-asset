function SeasonHeroGiftPackModel:GetInfo()
    require "HeroGiftPackNet":GetInstance():GetPackInfo(_G.handler(self, self.GetInfoCall))
end

function SeasonHeroGiftPackModel:GetInfoCall(msg)
    self.item = {}
    local IdTable = _G.ConfigManager.season_cfg[require("SeasonModel"):GetInstance():GetCurSeasonId()].store_cards
    local cardTable = {}
    local cardTable1 = {}
    local artifactTable = {}
    for k, v in ipairs(IdTable[1] or {}) do 
        local temp = _G.SimpleCopy(_G.ConfigManager.store_cards_cfg[v])
        temp.con_type = 1
        temp.sid = temp.id
        temp.normal_award = {}
        temp.pay_award = {}
        for k1, v1 in ipairs(temp.rewards_normal) do 
            temp.normal_award[k1] = {type = v1}
        end
        for k2, v2 in ipairs(temp.rewards_pay) do
            temp.pay_award[k2] = {type = v2}
        end
        -- temp.normal_award = temp.rewards_normal
        -- temp.pay_award = temp.rewards_pay
        if temp.card and temp.card[1] then 
            temp.other_award = {}
            local type = _G.StorageManager:GetInstance():CheckSidType(temp.card[1][1])
            for i = 1, #temp.card do 
                if type == _G.StorageType.Card then
                    if #cardTable < #temp.card then 
                        table.insert(cardTable, temp.card[1][1])
                    end
                    if not temp.other_award[1] then 
                        table.insert(temp.other_award, {k = 1, v = temp.card[1][2]})
                    end
                else 
                    if #artifactTable < #temp.card then 
                        table.insert(artifactTable, temp.card[i][1])
                    end
                    if not temp.other_award[1] then 
                        table.insert(temp.other_award, {k = 2, v = temp.card[i][2]})
                    end
                end
            end
        end 
        if temp.condition_params and temp.condition_params[1] then 
            for i = 1, #temp.condition_params do 
                if #cardTable1 < #temp.condition_params then 
                    table.insert(cardTable1, temp.condition_params[i])
                end
            end
        end
        table.insert(self.item, temp)
    end 
    self.cardList = {}
    for i = 1, #cardTable1 do 
        table.insert(self.cardList, {k = cardTable1[i], v = artifactTable[i]})
    end
    ---持续时间
    local time = require "SeasonModel":GetInstance():GetTime()
    self.run_time = time.endTime - time.startTime
    ---开始时间
    self.start_time = time.startTime
    ---已经领取的免费奖励sid
    self.a_list = msg.a_list or {}
    ---购买次数
    self.times = msg.times or {}
    ----预完成的奖励sid
    self.can_list = msg.can_list or {}
    ---当前卡牌id
    if msg.choose_card and msg.choose_card ~= 0 then 
        self.CradId = msg.choose_card
    end
    self.itemListType = {}
    self:ItemListType()

    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    _G.Events:GetInstance():AddListener(_G.eTalent.TalentActiveFinish, self.TianFvDengJi, self)
    _G.Events:GetInstance():AddListener(_G.eHunLianEvents.ActiveHunLian, self.HunLianDengJi, self)
    _G.Events:GetInstance():AddListener(_G.eHunLianEvents.UpLevelhHuiLian, self.HunLianDengJi, self)
    _G.Events:GetInstance():AddListener(_G.eCard.CardUpStar, self.UpdateCardUpStar, self)
    self:ReqMax()
    _G.Events:GetInstance():Broadcast(_G.eHeroGiftPack.ParseData)
    --没有选定英雄的话默认选一个先
    if not self.CradId then 
        self:Choose(cardTable1[1])
    end
    if _G.AppSetting.IsXzns then
        self.isLogin = true
    end
    self:RefreshRedPoint()
    self.super.ParseData(self)
end

---刷新红点显示
function SeasonHeroGiftPackModel:RefreshRedPoint()
    if self.redPointId > 0 then
        require "RedPointManager":GetInstance():RefreshNode(self.redPointId)
    end
end

---全部红点检测
function SeasonHeroGiftPackModel:ReqMax()
    local timeShengYu = self:StartTime() + self:RunTime() - _G.TimeUtil.GetServerUnixTime()
    local CradDataID = self:CradData()
    if timeShengYu > 0 and CradDataID then
        local card = _G.StorageManager:GetInstance():GetMaxStarCardBySid(CradDataID)
        if card ~= nil then
            _G.PlayerPrefsManager.SetInt("SeasonHeroGiftMaxStar", card.star)
            self:StarDengJi(card.star, CradDataID)
        end

        local MaxTianFu = _G.StorageManager:GetInstance():GetMaxTianFuCardBySid(CradDataID)
        if MaxTianFu ~= nil then
            self:TianFvDengJi(CradDataID, _G.table.count(card.open_inborn))
        end
        local DengJi = _G.StorageManager:GetInstance():GetMaxHunLianCardBySid(CradDataID)
        if DengJi ~= nil then
            self:HunLianDengJi(CradDataID, DengJi.soulLink_lv)
        end
    end
end

function SeasonHeroGiftPackModel:Choose(cardSid, call)
    require "HeroGiftPackNet":GetInstance():Choose(
        2,
        {card_sid = cardSid},
        function(msg)
            if msg.ack == 1 then 
                self:SetCardData(cardSid)
                self.can_list = msg.can_list or {}
                local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.HeroGiftPackView.Name)
                if view then
                    view:ChooseHero()
                end
                if call ~= nil then
                    call()
                end
                --require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.AdvancedGift.id)
                require("DrawUpMainModel"):GetInstance():RefreshAllHeroGiftRedPoint()
                require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SeasonHeroGiftPack.id)
            end
        end
    )
end

---奖励领取（2是领取免费奖励，1是提交奖励
function SeasonHeroGiftPackModel:JiangLiLingQu(sid, num, call)
    if num == 2 then
        local timeShengYu = self:StartTime() + self:RunTime() - _G.TimeUtil.GetServerUnixTime()
        if timeShengYu < 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(730102)
            return
        end
    end

    require("HeroGiftPackNet"):GetInstance():GetAward(
        {sid = sid, type = num},
        function(msg)
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            if call ~= nil then
                _G.table.insert(self.a_list, sid)
                if not self:CanAward(sid) then
                    _G.table.insert(self.can_list, sid)
                end
                require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.AdvancedGift.id, self.sub_type)
                call()
            end
        end
    )
end

---星级等级提升
function SeasonHeroGiftPackModel:StarDengJi(level, sid)
    if self.CradId ~= sid then
        return 
    end
    local card = _G.StorageManager:GetInstance():GetMaxStarCardBySid(sid)
    if card == nil or card.star > level then
        return 
    end
    for key, value in pairs(self:itemType(1)) do
        if value.condition <= level then
            if not self:CanAward(value.sid) and not self:Alist(value.sid) then
                self:JiangLiLingQu(value.sid, 1)
                _G.table.insert(self.can_list, value.sid)
                require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.AdvancedGift.id)
            end
        end
    end
end
---天赋等级提升
function SeasonHeroGiftPackModel:TianFvDengJi(sid, level)
    if self.CradId ~= sid then
        return
    end
    local card = _G.StorageManager:GetInstance():GetMaxTianFuCardBySid(sid)
    if card == nil or _G.table.count(card.open_inborn) > level then
        return
    end
    for key, value in pairs(self:itemType(2)) do
        if value.condition <= level then
            if not self:CanAward(value.sid) and not self:Alist(value.sid)then
                self:JiangLiLingQu(value.sid, 1)

                _G.table.insert(self.can_list, value.sid)
                require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.AdvancedGift.id)
            end
        end
    end
end
---魂链等级提升
function SeasonHeroGiftPackModel:HunLianDengJi(sid, level)
    if self.CradId ~= sid then
        return
    end
    local card = _G.StorageManager:GetInstance():GetMaxHunLianCardBySid(sid)
    if card == nil or card.soulLink_lv > level then
        return
    end
    for key, value in pairs(self:itemType(3)) do
        if value.condition <= level then
            if not self:CanAward(value.sid)and not self:Alist(value.sid) then
                self:JiangLiLingQu(value.sid, 1)

                _G.table.insert(self.can_list, value.sid)
                require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.AdvancedGift.id)
            end
        end
    end
end
