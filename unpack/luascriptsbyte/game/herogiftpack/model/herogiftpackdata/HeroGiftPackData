---@class HeroGiftPackData	中文描述
local HeroGiftPackData = _G.BaseClass("HeroGiftPackData")

local IconImage = {
    [2] = "ui_sc_jj_tfjx_txt",
    [3] = "ui_sc_jj_hljf_txt"
}

---类的构造函数
function HeroGiftPackData:__init(data, info)
    self:Parse(data, info)
end

function HeroGiftPackData:Parse(data, info)
    self.curActivityClass = data
    --活动id
    self.activityID = data.activityID
    --标题名
    self.title = data.cfg.info.title
    --头像
    self.icon = data.cfg.info.icon
    ---持续时间
    self.run_time = data.cfg.time.run_time
    ---开始时间
    self.start_time = data.cfg.time.start_time
    self.item = {}
    self.item = info.hero_gift.item
    ---已经领取的免费奖励sid
    self.a_list = info.hero_gift.a_list or {}
    ---购买次数
    self.times = info.hero_gift.times or {}
    ----预完成的奖励sid
    self.can_list = info.hero_gift.can_list or {}
    ---当前卡牌id
    if info.hero_gift.choose_card ~= 0 then
        self.CradId = info.hero_gift.choose_card
    end
    self.cardList = info.hero_gift.card_list
    self.itemListType = {}
    self.ImageIcoe = {}
    self.sub_type = data.cfg.info.front.sub_type

    -- ZHJH-11051 GM活动的多语言调整需求
    local cfg
    for _, v in pairs(self.item) do
        cfg = _G.ConfigManager.store_gear_cfg[v.price]
        v.price = cfg and cfg.price or v.price
    end

    self:ItemListType()
end

---当前礼包购买次数
function HeroGiftPackData:TimesNum(sid)
    for key, value in pairs(self.times) do
        if value.k == sid then
            return value.v
        end
    end
    return 0
end

---增加礼包）已经购买次数(没有返回0)
function HeroGiftPackData:CardInfoJia(sid)
    for key, value in pairs(self.times) do
        if value.k == sid then
            value.v = value.v + 1
            return
        end
    end
    _G.table.insert(self.times, { k = sid, v = 1 })
end

---红点判断
function HeroGiftPackData:HongDianCanAward()
    if not self:CradData() then
        return true
    end
    for key, value in pairs(self.can_list) do
        if not self:Alist(value) then
            return true
        end
    end
    return false
end

---单个红点显示
function HeroGiftPackData:HongDianCanAwardOne(Id)
    for key, value in pairs(self.WuJiang[self.WuJiangNum[Id]]) do
        if self:CanAward(value.sid) then
            if not self:Alist(value.sid) then
                return 1
            end
        end
    end
    return 0
end

---单个红点显示
function HeroGiftPackData:HongDianCanAwardOne()
    if not self:CradData() then
        return 1
    end
    for key, value in pairs(self.item) do
        if self:CanAward(value.sid) then
            if not self:Alist(value.sid) then
                return 1
            end
        end
    end
    return 0
end

---返回是否可以领取预完成奖励
function HeroGiftPackData:CanAward(sid)
    for key, value in pairs(self.can_list) do
        if value == sid then
            return true
        end
    end
    return false
end

---单个魂将品质显示
function HeroGiftPackData:WuJiangXingjiAwardOne()
    for key, value in pairs(self.itemListType[1]) do
        if self:CanAward(value.sid) then
            if not self:Alist(value.sid) then
                return 1
            end
        end
    end
    return 0
end

---单个魂将成长显示
function HeroGiftPackData:WuJiangAwardOne(Id)
    for key, value in pairs(self.itemListType[2]) do
        if self:CanAward(value.sid) then
            if not self:Alist(value.sid) then
                return 1
            end
        end
    end
    for key, value in pairs(self.itemListType[3]) do
        if self:CanAward(value.sid) then
            if not self:Alist(value.sid) then
                return 1
            end
        end
    end
    return 0
end

---判断魂将是否已解锁(星级)
function HeroGiftPackData:IsHeroGift(data)
    --local data = self:itemType(sid)
    local WanCheng = self:CanAward(data.sid)
    if WanCheng then
        return WanCheng
    end
    if not self.CradId then
        return false
    end
    local card = _G.StorageManager:GetInstance():GetMaxStarCardBySid(self.CradId)
    if card == nil or data.condition > card.star then
        return false
    end
    return true
end

---判断魂将是否已解锁（天赋等级
function HeroGiftPackData:HunJiangtianFvStar(data)
    --local data = self:HunJiangPingZi(sid, number)
    local WanCheng = self:CanAward(data.sid)
    if WanCheng then
        return WanCheng
    end
    if not self.CradId then
        return false
    end
    local card = _G.StorageManager:GetInstance():GetMaxTianFuCardBySid(self.CradId)
    if card == nil or data.condition > _G.table.count(card.open_inborn) then
        return false
    end
    return true
end

---判断魂将是否已解锁（魂链等级
function HeroGiftPackData:HunJiangHunLian(data)
    --local data = self:HunJiangPingZi(sid, number)
    local WanCheng = self:CanAward(data.sid)
    if WanCheng then
        return WanCheng
    end
    if not self.CradId then
        return false
    end
    local card = _G.StorageManager:GetInstance():GetMaxHunLianCardBySid(self.CradId)
    if card == nil or data.condition > card.soulLink_lv then
        return false
    end
    return true
end

---返回是否已领取免费奖励
function HeroGiftPackData:Alist(sid)
    for key, value in pairs(self.a_list) do
        if value == sid then
            return true
        end
    end
    return false
end

---返回礼包）已经购买次数(没有返回0)
function HeroGiftPackData:CardInfo(sid)
    for key, value in pairs(self.times) do
        if value.k == sid then
            return value.v
        end
    end
    return 0
end

---魂将礼包分类（1，星级。2魂链，3天赋
function HeroGiftPackData:ItemListType()
    local t = 1
    for i = 1, _G.table.count(self.item) do
        if self.itemListType[self.item[i].con_type] == nil then
            self.itemListType[self.item[i].con_type] = {}
            if _G.table.count(self.itemListType) > 1 then
                if self.ImageIcoe[t] == nil then
                    self.ImageIcoe[t] = {}
                end
                self.ImageIcoe[t] = IconImage[self.item[i].con_type]
                self.ImageIcoe[t + 3] = self.item[i].con_type
                t = t + 1
            end
        end
        _G.table.insert(self.itemListType[self.item[i].con_type], self.item[i])
    end
end

---返回活动id
function HeroGiftPackData:RetActivityID()
    return self.activityID
end

---返回子活动id
function HeroGiftPackData:GetSubType()
    return self.sub_type
end

---返回现在礼包页面应该显示的英雄index
function HeroGiftPackData:GetNowIndex()
    if self.CradId then
        for key, value in ipairs(self.cardList) do
            if value.k == self.CradId then
                return key
            end
        end
    end
    return 1
end

---返回英雄id
function HeroGiftPackData:CradData()
    return self.CradId
end

---返回英雄id
function HeroGiftPackData:SetCardData(cardSid)
    self.CradId = cardSid
end

function HeroGiftPackData:FreshCanList(canList)
    self.can_list = canList or {}
end

---返回开始时间
function HeroGiftPackData:StartTime()
    if self.start_time then
        return self.start_time
    end
end

---返回持续时间
function HeroGiftPackData:RunTime()
    if self.run_time then
        return self.run_time
    end
end

function HeroGiftPackData:itemType(num)
    return self.itemListType[num] or {}
end

---类的析构函数
function HeroGiftPackData:Dispose()
end

return HeroGiftPackData
