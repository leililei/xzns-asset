---获取激活数量
function CombineModel:GetActiveCount(type)
    local index = 0
    if not self.infoData then
        return 0
    end
    if self.infoData.skills then
        ---@type combine_cfg
        local cfg

        for _, v in pairs(self.infoData.skills) do
            cfg = _G.ConfigManager.combine_cfg[v.k]
            if cfg.classify == type then
                index = index + 1
            end
        end
    end

    return index, #self.CombineDatas[type]
end
---检测技能是否能激活或者升级
function CombineModel:CheckSkillCanTakeOrActive(id)
    if not self.infoData then
        return false
    end
    local data = self:GetSingleData(id)
    ---ZHJ-20098【客户端】合击技红点显示规则优化
    -- return data.canActive or data.canUp
    return data.canActive
end
---登录检测技能是否可以升级
function CombineModel:CheckSkillCanUp()
    if not self.infoData then
        return false
    end
    local data
    for _, v in pairs(_G.ConfigManager.combine_cfg) do
        data = self:GetSingleData(v.id)
        if not self.onceUpRedPoint then
            if data.canUp then
                return true
            end
        end
        if data.canActive then
            return true
        end
    end
    return false
end
---获取合击技类型
function CombineModel:GetTypeWithSkillId(id)
    if not id or id <= 0 then
        return 1
    end
    for _, v in pairs(_G.ConfigManager.combine_cfg) do
        for _, v2 in pairs(v.skills) do
            if v2 == id then
                return v.classify
            end
        end
    end

    if _G.AppSetting.DEBUG then
        _G.Log("", "<color=red>" .. "combine_cfg not find id:" .. id .. "</color>")
    end
    return 1
end

function CombineModel:CheckSpecialCombine(id)
    return specialCombine[id]
end

function CombineModel:CheckIsPoint(type)
    for _, v in pairs(self.CombineDatas[type]) do
        if v.canActive or (v.canUp and not self.onceUpRedPoint) then
            return true
        end
    end
    return false
end
---获取所有的属性
function CombineModel:GetAllAttribute(isRefresh)
    if not self.attribute or isRefresh then
        local attributeManager = _G.AttributeClassManager:GetInstance()
        self.attribute = attributeManager:GetAttribtueClass()
        local cfgs = _G.ConfigManager.combine_cfg
        ---@type combine_cfg
        local cfg
        if self.skills then
            for k, v in pairs(self.skills) do
                cfg = cfgs[k]
                if cfg then
                    self.attribute:AddValueByName("atk", cfg.atk[v], nil, _G.AttCountType.other)
                    self.attribute:AddValueByName("bre", cfg.bre[v], nil, _G.AttCountType.other)
                    self.attribute:AddValueByName("def", cfg.def[v], nil, _G.AttCountType.other)
                    self.attribute:AddValueByName("max_hp", cfg.max_hp[v], nil, _G.AttCountType.other)
                end
            end
        end
        self.attributeChangeType = attributeManager:GetChangeAttrTypes(self.attribute)
    end

    return self.attribute, self.attributeChangeType
end

---获取属性加成
---@return AttributeClass
function CombineModel:GetAttribute(id)
    local attribute = _G.AttributeClassManager:GetInstance():GetAttribtueClass()
    local cfg = _G.ConfigManager.combine_cfg[id]
    local lv = self.skills[id] or 1
    if cfg then
        attribute:AddValueByName("atk", cfg.atk[lv])
        attribute:AddValueByName("bre", cfg.bre[lv])
        attribute:AddValueByName("def", cfg.def[lv])
        attribute:AddValueByName("max_hp", cfg.max_hp[lv])
        return attribute
    end
    return nil
end
---获取等级
function CombineModel:GetAllLevel()
    return self.AllLevel
end

return CombineModel
