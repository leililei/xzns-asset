local CombineData = require "CombineData"

---@class CombineModel : GameDataModelBase	中文描述
---@field CombineDatas CombineData[]
---@field infoData combine.s2c_combine_info
---@field AllLevel number 所有合击技等级
local CombineModel = _G.BaseClass("CombineModel", _G.GameDataModelBase)
local specialCombine = {
    [17029] = true,
    [17030] = true
}
---@return CombineModel
function CombineModel:GetInstance()
    return self.super.GetInstance(self)
end

function CombineModel:Dispose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---@return CombineModel CombineModel
function CombineModel:__init()
    self.curFunctionOpenID = 57
    _G.Events:GetInstance():AddListener(_G.ePlayAactionEvent.PlayAaction, self.RefreshRedPoint, self)
    self.AllLevel = 0
    ---登录检测可升级红点
    self.onceUpRedPoint = false
end

function CombineModel:SetOnceUpRedPoint()
    self.onceUpRedPoint = true
end
function CombineModel:RefreshRedPoint(id)
    if
        not id or
            (id and
                (id.XWasStar or id[1] == _G.ActiveTaskEnum.ConditionEnum.CardUpStar.count or
                    id[1] == _G.ActiveTaskEnum.ConditionEnum.CardLevel.assignCountAssignStar))
     then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.RefreshDataState, self, true, true, false)
        self.timer:Start()
    end
end
---刷新数据状态
function CombineModel:RefreshDataState()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:UpdateAllData()
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.MainCombine.id)
end

function CombineModel:GetDataFormServer()
    self:GetInfo()
end

---获取信息
function CombineModel:GetInfo(call)
    require "CombineNet":GetInstance():GetInfo(_G.handlerbind(self, self.GetInfoCall, call))
end

---获取信息回调
---@param data combine.s2c_combine_info
function CombineModel:GetInfoCall(data, call)
    self.infoData = data
    self:InitSkill()
    if self.CombineDatas then
        self:UpdateAllData()
    else
        self:InitDatas()
    end
    self:InitDefultCombineSkill()
    if call then
        call()
    end
    self:GetAllAttribute(true)
    self:ParseData(data)
end
local battleCombFunctionID = 67
---初始化功能逻辑
function CombineModel:InitFunction()
    --镇魂街ZHJ-13518
    --【客户端】战斗中合击自动施法功能解锁后，默认将自动开关打开
    local FunctionManagerIns = _G.FunctionManager:GetInstance()
    if not FunctionManagerIns:CheckFunctionIsUnlock(battleCombFunctionID) then
        _G.Events:GetInstance():AddListener(
            _G.eFunctionsStatus.OpenCfgFunctionId,
            self.OnCombineBattleBtnFunctionOpen,
            self
        )
    end
    self:GetAllAttribute(true)
    _G.StorageManager:GetInstance():DelayUpdateAllCardProp()

    for i = 1, 30 do
        _G.Events:GetInstance():Broadcast(
            _G.ePlayAactionEvent.PlayAaction,
            {_G.ActiveTaskEnum.ConditionEnum.Combine.levelNum, i},
            self:GetNumByLevel(i),
            nil,
            true
        )
    end
end
---当合击技自动释放功能解锁
function CombineModel:OnCombineBattleBtnFunctionOpen(id)
    if id == battleCombFunctionID then
        _G.Events:GetInstance():RemoveListener(
            _G.eFunctionsStatus.OpenCfgFunctionId,
            self.OnCombineBattleBtnFunctionOpen,
            self
        )
        _G.PlayerPrefsManager.SetInt("IsAutoJointSkill_", 1)
    end
end

---特殊合击技激活
function CombineModel:InitDefultCombineSkill()
    local IllustrationModel = require "IllustrationModel":GetInstance()
    for _, v in pairs(_G.ConfigManager.discrete_cfg[105002][1]) do
        local cfg = _G.ConfigManager.combine_cfg[v]
        if cfg then
            local canActive = true
            if not self:CheckIsActive(cfg.id) then
                for _, v in pairs(cfg.activation) do
                    if not IllustrationModel:HunjiangJieSuo(v) or IllustrationModel:GetCardMaxStar(v) < cfg.consume1[1] then
                        canActive = false
                        break
                    end
                end
                if canActive then
                    self:ActiveCombine(cfg.id)
                end
            end
        end
    end
end

function CombineModel:InitSkill()
    self.skills = {}
    self.AllLevel = 0
    if self.infoData.skills then
        _G.table.sort(
            self.infoData.skills,
            function(a, b)
                return a.k < b.k
            end
        )
        for i, v in ipairs(self.infoData.skills) do
            self.skills[v.k] = v.v
            self.AllLevel = self.AllLevel + v.v
        end
    end
end

---初始化数据
function CombineModel:InitDatas()
    self.CombineDatas = {}
    self.CombineDatas[0] = {}
    self.TCombineDatas = {}
    for _, v in pairs(_G.ConfigManager.combine_cfg) do
        if not self.CombineDatas[v.classify] then
            self.CombineDatas[v.classify] = {}
        end
        local data = CombineData.New()
        _G.table.insert(self.CombineDatas[0], data)
        _G.table.insert(self.CombineDatas[v.classify], data)
        data:ParseData(v, self:GetIsActive(v.id))
        self.TCombineDatas[v.id] = data
    end
    self:SortData()
    self:UpdatePoints()
end
---更新是否有新的点数
function CombineModel:UpdatePoints()
    self.points = {}
    if self.infoData.points then
        for _, v in ipairs(self.infoData.points) do
            if v.v > 0 then
                _G.table.insert(self.points, v)
            end
        end
    end
end

---更新合击技数据顺序
function CombineModel:SortData()
    for _, v in pairs(self.CombineDatas) do
        _G.table.sort(
            v,
            function(a, b)
                if a.canActive and b.canActive then
                    return a.id < b.id
                elseif not a.canActive and not b.canActive then
                    if a.isActive and b.isActive then
                        if a.canUp and b.canUp or (not a.canUp and not b.canUp) then
                            if a.level == b.level then
                                return a.id < b.id
                            else
                                return a.level > b.level
                            end
                        else
                            return a.canUp
                        end
                    elseif not a.isActive and not b.isActive then
                        return a.id < b.id
                    else
                        return a.isActive
                    end
                else
                    return a.canActive
                end
            end
        )
    end
end

---更新所有合击技状态
function CombineModel:UpdateAllData()
    if not self.CombineDatas then
        return
    end
    for _, v in pairs(self.CombineDatas) do
        for _2, v2 in pairs(v) do
            v2:UpdateData()
        end
    end
end

