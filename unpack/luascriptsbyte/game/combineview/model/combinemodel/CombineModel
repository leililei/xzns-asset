---激活合击技回调
function CombineModel:ActiveCombineCall(data, id, callback)
    if data.ack ~= 1 then
        return
    end
    if not self.infoData.skills then
        self.infoData.skills = {}
    end
    self.AllLevel = self.AllLevel + 1
    _G.table.insert(self.infoData.skills, {k = id, v = 1})
    self.skills[id] = 1
    self:UpdateSingleData(id)
    self:SortData()
    if callback then
        callback()
    end
    self:GetAllAttribute(true)
    _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.Combine)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.MainCombine.id, id)
    require "RoleTeamModel":GetInstance():UnlockCombine(id)
    _G.Events:GetInstance():Broadcast(
        _G.ePlayAactionEvent.PlayAaction,
        {
            _G.ActiveTaskEnum.ConditionEnum.Combine.count
        },
        self:GetActiveSkillCount(),
        false,
        true
    )
    -- _G.Events:GetInstance():Broadcast(_G.GlobalEvents.PlayerPowerChange)
end

---升级合击技回调
function CombineModel:UpCombineCall(data, id, callback)
    if data.ack ~= 1 then
        return
    end
    local temp = self:GetSingleData(id)
    if temp then
        local consume = temp.cfg.consume[temp.level]
        _G.StorageManager:GetInstance():ConsumeItem(consume[1], nil, consume[2])
    end
    local power = _G.StorageManager:GetInstance():GetPlayerPower()
    self.skills[id] = self.skills[id] + 1
    self.AllLevel = self.AllLevel + 1
    self:UpdateAllData()
    self:SortData()
    if callback then
        callback()
    end
    self:GetAllAttribute(true)
    _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.Combine)
    local offset = _G.StorageManager:GetInstance():GetPlayerPower() - power
    if offset > 0 then
        require "CommonTipManager".OpenPowerUpView(power, offset)
    end
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.MainCombine.id)
    -- _G.Events:GetInstance():Broadcast(_G.GlobalEvents.PlayerPowerChange)
end

---重置合击技
function CombineModel:ResetCombineCall(data, id, callback)
    if data.ack ~= 1 then
        return
    end
    _G.StorageManager:GetInstance():ConsumeItem(_G.ResPropID.Diamond, nil, _G.ConfigManager.discrete_cfg[104601][1][1])
    if data.award then
        _G.StorageManager:GetInstance():ReceiveAwardData(data)
        require "CommonTipManager".OpenCommonAwardView(data)
    end
    self.AllLevel = self.AllLevel - self.skills[id] + 1
    self.skills[id] = 1
    self:UpdateAllData()
    self:SortData()
    if callback then
        callback()
    end
    self:GetAllAttribute(true)
    _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.Combine)
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.MainCombine.id)
    -- _G.Events:GetInstance():Broadcast(_G.GlobalEvents.PlayerPowerChange)
end

