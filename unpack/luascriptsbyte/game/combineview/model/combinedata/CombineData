---@class CombineData	中文描述
---@field cfg combine_cfg
---@field isActive boolean 是否激活
---@field progress number 解锁进度
---@field level number 技能等级
---@field skillCfg card_skills_cfg
---@field desc number 技能介绍
local CombineData = _G.BaseClass("CombineData")

---类的构造函数
function CombineData:__init()
    self.cfg = nil
    self.progress = 0
    self.isActive = false
    self.level = 1
    self.maxLevel = 1
    self.skillCfg = nil
    self.canUp = false
    self.canActive = false
end

function CombineData:Dispose()
    self.cfg = nil
    self.progress = nil
    self.isActive = nil
    self.level = nil
    self.skillCfg = nil
    self.maxLevel = nil
    self.canUp = nil
    self.canActive = nil
end

---解析数据
function CombineData:ParseData(cfg, active)
    if not cfg then
        if _G.AppSetting.DEBUG then
            _G.LogError("CombineData cfg error")
        end
        return
    end
    self.id = cfg.id
    self.cfg = cfg
    self.isActive = active
    self:UpdateProgress()
    self.level = require "CombineModel":GetInstance():GetCombineLevel(self.id)

    self.skillCfg = _G.ConfigManager.card_skills_cfg[self.cfg.skills[self.level]]
    if _G.ConfigManager.card_skills_cfg[self.cfg.skills[1]] then
        self.desc = _G.ConfigManager.card_skills_cfg[self.cfg.skills[1]].describe1
    end

    self.maxLevel = #self.cfg.skills
    self.canActive = not self.isActive and self.progress == 1
    self.canUp = self:CheckCanUp()
end

---更新合击技解锁状态
function CombineData:UpdateProgress()
    local getTb = {}
    self.cardState = {}
    local IllustrationModel = require "IllustrationModel":GetInstance()
    for _, v in pairs(self.cfg.activation) do
        if IllustrationModel:HunjiangJieSuo(v) and IllustrationModel:GetCardMaxStar(v) >= self.cfg.consume1[1] then
            _G.table.insert(getTb, v)
            self.cardState[v] = true
        else
            self.cardState[v] = false
        end
    end

    if self.isActive then
        self.progress = 1
    else
        self.progress = #getTb / #self.cfg.activation
    end
end

---更新数据
function CombineData:UpdateData()
    self.level = require "CombineModel":GetInstance():GetCombineLevel(self.id)
    self.isActive = require "CombineModel":GetInstance():GetIsActive(self.id)
    self.skillCfg = _G.ConfigManager.card_skills_cfg[self.cfg.skills[self.level]]
    self:UpdateProgress()
    self.canActive = not self.isActive and self.progress == 1
    self.canUp = self:CheckCanUp()
end

---获取返还材料
function CombineData:GetResetMaterial()
    local tb = {}
    for i, v in ipairs(self.cfg.consume) do
        if i >= self.level then
            break
        end
        if not tb[v[1]] then
            tb[v[1]] = v
        end
        tb[v[1]][2] = tb[v[1]][2] + v[2]
    end
    return _G.table.toArray(tb)
end
---检测是否能升级
function CombineData:CheckCanUp()
    if not self.isActive then
        return false
    end
    if self.level + 1 > self.maxLevel then
        return false
    end
    if #self.cfg.consume > 0 then
        return _G.StorageManager:GetInstance():GetItemCountBySid(self.cfg.consume[self.level][1]) >=
            self.cfg.consume[self.level][2]
    else
        return true
    end
end
---获取卡牌状态
---@param id number 卡牌 sid
function CombineData:GetCardState(id)
    return self.cardState[id]
end
---获取已解锁的卡牌数
function CombineData:GetUnLockCardCount()
    if not self.cfg then
        return 0, 2
    end
    local count = 0
    for i, v in ipairs(self.cfg.activation) do
        if self.isActive then
            if self:CheckCardCondition(v) then
                count = count + 1
            end
        else
            if self:GetCardStateWithIndex(i) then
                count = count + 1
            end
        end
    end
    return count, #self.cfg.activation
end
---检测卡牌是否满足升级要求
function CombineData:CheckCardCondition(id)
    if self.isActive and self.level + 1 > self.maxLevel then
        return true
    end
    if self.isActive then
        return require "IllustrationModel":GetInstance():GetCardMaxStar(id) >= self.cfg.consume1[self.level + 1]
    else
        return require "IllustrationModel":GetInstance():GetCardMaxStar(id) >= self.cfg.consume1[1]
    end
end
---获取卡牌状态
---@param id number combine_cfg.activation 下标
function CombineData:GetCardStateWithIndex(index)
    local id = self.cfg.activation[index]
    if not id then
        if _G.AppSetting.DEBUG then
            _G.LogWarning("index don't exit")
        end
        return false
    end
    return self:GetCardState(id)
end
---获取显示的卡牌星级
function CombineData:GetCardStar()
    if not self.isActive then
        return self.cfg.consume1[1]
    end
    if self.level + 1 > self.maxLevel then
        return self.cfg.consume1[self.maxLevel]
    end
    return self.cfg.consume1[self.level + 1]
end
---是否满级
function CombineData:GetIsMax()
    if not self.isActive then
        return false
    end
    return self.level == self.maxLevel
end

function CombineData:GetSkillLevel()
    return self.skillCfg.level
end

return CombineData
