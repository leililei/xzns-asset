---@class CombineUpSkillView : UIBaseView	中文描述
---@field public go_table CombineUpSkillView_GoTable GoTable
local CombineUpSkillView = _G.BaseClass("CombineUpSkillView", _G.UIBaseView)
--_G.CombineUpSkillView = CombineUpSkillView

function CombineUpSkillView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param data CombineData
function CombineUpSkillView:OnCreate(data)
    self.data = data
    self:ShowSingleData(self.go_table.obj_last, data:GetSkillLevel() - 1, data.level - 1)
    self:ShowSingleData(self.go_table.obj_next, data:GetSkillLevel(), data.level)
    self.go_table.aorrawimage_icon:LoadImage(data.skillCfg.icon)
    self.canclick = false
    _G.DelayDo(
        0.9,
        function()
            self.canclick = true
        end
    )
end

function CombineUpSkillView:ShowSingleData(obj, skilllv, reallv)
    ---@type CombineUpSkillView._obj_last_GoTable
    local tb = _G.GetAutoGoTable(obj)
    local sid = self.data.cfg.skills[reallv]
    ---@type card_skills_cfg
    local cfg = _G.ConfigManager.card_skills_cfg[sid]
    tb.aortext_name.text =
        _G.LangUtil.GetLangPackValue(9002050018,
        _G.LangUtil.GetLangPackValue(cfg.name1) .. _G.string.AddColor(skilllv, "5bdf99")
    )
    tb.aortext_desc.text = _G.LangUtil.GetLangPackValue(cfg.describe1)
end

---按钮点击事件在这里派发
function CombineUpSkillView:OnClickBtn(go, isOn)
    if not self.canclick then
        return
    end
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end

return CombineUpSkillView
