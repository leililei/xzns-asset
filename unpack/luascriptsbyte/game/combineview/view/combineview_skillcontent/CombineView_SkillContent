---@class CombineView_SkillContent : Component	中文描述
---@field go_table CombineView._obj_SkillContent_GoTable
---@field ItemList CombineView_SkillItem[]
local CombineView_SkillContent = _G.BaseClass("CombineView_SkillContent", _G.Component)

function CombineView_SkillContent:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end
---创建对象时,入口构造函数
function CombineView_SkillContent:OnCreate(call)
    self.call = call
    self:InitItemList()
end
---初始化itemList
function CombineView_SkillContent:InitItemList()
    self.ItemList = {}
    for i = 1, 2 do
        self.ItemList[i] =
            self:AddComponent(self.go_table["obj_Skill" .. i], require "CombineView_SkillItem".New(self.call))
    end
end
---@param index  number 下标
---@param datas CombineData[]
function CombineView_SkillContent:Show(index, datas)
    for i, v in ipairs(self.ItemList) do
        v:Show(datas[i + index * 2])
    end
end

---销毁对象时,析构函数
function CombineView_SkillContent:OnDestroy()
end

return CombineView_SkillContent
