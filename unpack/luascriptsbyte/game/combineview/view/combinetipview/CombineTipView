---@class CombineTipView : UIBaseView	中文描述
---@field public go_table CombineTipView_GoTable GoTable
---@field data CombineData
local CombineTipView = _G.BaseClass("CombineTipView", _G.UIBaseView)

function CombineTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function CombineTipView:OnCreate(data)
    self.rect = self.go_table.obj_skillDescribe:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    self:Init(data)
end
---初始化界面
---@param data CombineData
function CombineTipView:Init(data)
    _G.GameUtil.SetActiveByCondition(self.gameObject, false)
    self.data = data
    local cfg = _G.ConfigManager.card_skills_cfg[data.cfg.skills[1]]
    local skillData = data.skillCfg
    self.count = 0
    self.skillCfg = _G.ConfigManager.card_skills_cfg
    --self.view:SetPos(self.rect, pos)
    --self.go_table.obj_skillDescribe:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform)):SetPivotPosition(1, 0)
    self.Skill = _G.GetAutoGoTable(self.go_table.obj_Skill)
    self.Skill.aorrawimage_skill:LoadImage(skillData.icon)

    self.SkillDesExText = self.go_table.obj_SkillDes:GetComponentE(_G.typeof(_G.CS.ExtendText))
    self.SkillDesExText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))

    if cfg.name1 > 0 and _G.LangUtil.GetLangPackValue(cfg.name1) then
        self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(cfg.name1)
    else
        self.go_table.aortext_name.text = ""
    end

    if cfg.describe1 > 0 and _G.LangUtil.GetLangPackValue(cfg.describe1) then
        if self.data.isActive then
            self.SkillDesExText.text = _G.LangUtil.GetLangPackValue(cfg.describe1)
        else
            self.SkillDesExText.text =
                _G.LangUtil.GetLangPackValue(cfg.describe1) ..
                _G.string.AddColor("（" .. _G.LangUtil.GetLangPackValue(90020300082, 1) .. "）", "ff5656")
        end
    else
        self.SkillDesExText.text = ""
    end

    self:UpdateSkillDes(self.data.cfg.skills, data.lv)

    self:UpdateLayout()
end
---更新技能描述
function CombineTipView:UpdateSkillDes(skillData, curLevel)
    local count = #skillData
    local f = "　"
    if count <= 1 then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_lineDown, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.scrollrect_content, false)
        _G.GameUtil.SetActiveByCondition(self.gameObject, true)
        return
    end
    local tb = {}
    local count2 = 1
    for i = 1, count do
        tb[skillData[i]] = skillData[i]
        if skillData[i] ~= skillData[1] and count2 == 1 then
            count2 = i
        end
    end

    tb = _G.table.toArray(tb)
    _G.table.sort(
        tb,
        function(a, b)
            return a < b
        end
    )
    local lv = _G.math.floor(self.data.level / count2) + 1
    local cfg
    local count3 = #tb
    for i = 2, count3 do
        _G.PoolsManager:GetInstance():Spawn(
            "UI/Common/CommonTipView/View/$_obj_skillItem",
            _G.ePoolType.Temporary,
            self.go_table.trans_content,
            function(trans)
                cfg = _G.ConfigManager.card_skills_cfg[tb[i]]
                local tb = _G.GetAutoGoTable(trans)
                local color = "76daf8"
                if i > lv then
                    color = "686989"
                end
                tb.SkillDesExText = tb.obj_upDes:GetComponentE(_G.typeof(_G.CS.ExtendText))
                tb.SkillDesExText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))
                -- tb.aortext_level.text =
                --     string.AddColor(string.format(_G.LangUtil.TryGetLangValue(90020600039), i), color)
                if i - lv == 1 and self.data.isActive then
                    tb.SkillDesExText.text =
                        _G.string.format(_G.LangUtil.GetLangPackValue(9002050018), cfg.level) ..
                        "：" ..
                            _G.string.AddColor(_G.LangUtil.TryGetLangValue(cfg.describe1), color) ..
                                _G.string.AddColor(
                                    "（" .. _G.LangUtil.GetLangPackValue(90020300082, (i - 1) * count2) .. "）",
                                    "ff5656"
                                )
                else
                    tb.SkillDesExText.text =
                        _G.string.AddColor(string.format(_G.LangUtil.TryGetLangValue(9002050018), i) .. "：", color) ..
                        _G.string.AddColor(_G.LangUtil.TryGetLangValue(cfg.describe1), color)
                end
                if i == count3 then
                    _G.GameUtil.SetActiveByCondition(self.gameObject, true)
                    _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(self.go_table.trans_content)
                    local sizeDelta = _G.Vector2.New(self.go_table.trans_content:GetRectTransformSizeDelta())
                    local x = self.go_table.scrollrect_content:GetRectTransformSizeDelta()
                    self.go_table.scrollrect_content:SetRectTransformSize(x, math.min(sizeDelta.y + 3, 174))
                    self.go_table.obj_GameObject:SetRectTransformSize(100, math.min(sizeDelta.y + 3, 174))
                    if sizeDelta.y <= 174 then
                        self.go_table.scrollrect_content.enabled = false
                    end
                    _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(self.go_table.trans_content2)
                    sizeDelta = _G.Vector2.New(self.go_table.trans_content2:GetRectTransformSizeDelta())
                    x = self.go_table.scrollrect_SkillDes:GetRectTransformSizeDelta()
                    self.go_table.scrollrect_SkillDes:SetRectTransformSize(x, math.min(sizeDelta.y + 3, 200))
                    if sizeDelta.y <= 200 then
                        self.go_table.scrollrect_SkillDes.enabled = false
                    end
                end
            end
        )
    end
    --  self.go_table.aortext_upDes.text = upDes
end

function CombineTipView:RemoveColor(str)
    local str1 = _G.string.gsub(str, "(<color=#(%w*)>)", "<color=#14874a>")
    return str1
end

---更新界面大小
function CombineTipView:UpdateLayout()
    self.count = self.count - 1
    if self.count >= 0 then
        return
    end
    self.AllRect = {}
    self.AllContentF = self.transform:GetComponentsInChildren(typeof(CS.UnityEngine.UI.ContentSizeFitter))
    for i = 0, self.AllContentF.Length do
        if i < self.AllContentF.Length then
            local rect = self.AllContentF[i]:GetComponentE(typeof(CS.UnityEngine.RectTransform))
            _G.table.insert(self.AllRect, rect)
        end
    end
    for i = 1, #self.AllRect do
        CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(self.AllRect[i])
    end
end
---按钮点击事件在这里派发
function CombineTipView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Close" then
        self:Close()
    end
end

---打开超链接
function CombineTipView:OnHrefClick(id, name, asa)
    local weight, height = self.rect:GetRectTransformWidthHeight()
    require("CommonTipManager"):GetInstance():OpenSkillHyper(tonumber(id), nil, weight, height)
end

return CombineTipView