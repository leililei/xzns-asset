local CombineSkillView = _G.BaseClass("CombineSkillView", _G.Component)
local AudioManager = _G.AudioManager
--_G.CombineSkillView = CombineSkillView
local UpMaterial = {109402, 109401}

local skillDescItemPath = "UI/CombineView/$_aortext_SkillDesc"
function CombineSkillView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    _G.AddViewBtnClick(self.gameObject, _G.handler(self, self.OnClickBtn))
    self.CardList = {}
    self.skillDesList = {}
end

function CombineSkillView:OnCreate(view)
    self.view = view
    self:InitEffect()
end

function CombineSkillView:InitEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_ListLevUp2,
        self.go_table.trans_effect3,
        function(obj)
            if _G.IsNil(self.gameObject) then
                _G.DestroyObject(obj)
                return
            end
            obj:SetLocalPosition(0, -130, 0)
        end
    )
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_ListLevUp2,
        self.go_table.trans_effect3,
        function(obj)
            if _G.IsNil(self.gameObject) then
                _G.DestroyObject(obj)
                return
            end
            obj:SetLocalPosition(0, -154, 0)
        end
    )
end

---界面的入口函数
---@param data CombineData
function CombineSkillView:Show(data)
    if not data then
        return
    end
    self.data = data
    self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(self.data.skillCfg.name1)
    if self.data.isActive then
        self:ShowUp(true)
    else
        self:ShowActive()
    end
    self:ShowAttribute()
    local isSpecial = require "CombineModel":GetInstance():CheckSpecialCombine(self.data.id)
    _G.GameUtil.SetActiveByCondition(
        self.go_table.obj_max,
        self.data.isActive and self.data.level >= self.data.maxLevel and not isSpecial
    )
    _G.GameUtil.SetActiveByCondition(
        self.go_table.aorbtn_action,
        not (self.data.isActive and self.data.level >= self.data.maxLevel)
    )
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_noUp, self.data.isActive and isSpecial)
    if not (self.data.isActive and self.data.level >= self.data.maxLevel) then
        self.go_table.aorbtn_action:SetGray(not (self.data.canUp or self.data.canActive))
        if self.data.canUp or self.data.canActive then
            self.go_table.aortext_label.color = _G.ColorTools.FormatColorByString("914801")
        else
            self.go_table.aortext_label.color = _G.ColorTools.FormatColorByString("3d3d3d")
        end
    end
    self.go_table.aortext_Desc.text = self:RemoveColor(_G.LangUtil.GetLangPackValue(self.data.desc))
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_reset, self.data.level > 1)
    self.go_table.trans_effect3:SetActiveE(0)
end

---显示卡牌
function CombineSkillView:ShowCard()
    self:InitSingleCard(1)
    self:InitSingleCard(2)
end

---更新单个卡牌
---@param index number 下标
function CombineSkillView:InitSingleCard(index)
    local tb = self.CardList[index]
    if not tb then
        tb = _G.GetAutoGoTable(self.activeTb["obj_card" .. index])
        self.CardList[index] = tb
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.CardAllItem,
            tb.obj_Root,
            function(item)
                tb.item = item
                item:Show(
                    self.data.cfg.activation[index],
                    _G.handlerbind(self, self.OnClickCard, self.data.cfg.activation[index]),
                    self.data:GetCardStar()
                )
                local cfg = _G.ConfigManager.card_cfg[self.data.cfg.activation[index]]
                if cfg then
                    tb.aortext_name.text = _G.LangUtil.GetLangPackValue(cfg.Name)
                end
                _G.GameUtil.SetActiveByCondition(item.go_table.obj_lvNode, false)
                _G.GameUtil.SetActiveByCondition(
                    tb.obj_mask,
                    not self.data:CheckCardCondition(self.data.cfg.activation[index])
                )
            end
        )
    else
        tb.item:Show(
            self.data.cfg.activation[index],
            _G.handlerbind(self, self.OnClickCard, self.data.cfg.activation[index]),
            self.data:GetCardStar()
        )
        local cfg = _G.ConfigManager.card_cfg[self.data.cfg.activation[index]]
        if cfg then
            tb.aortext_name.text = _G.LangUtil.GetLangPackValue(cfg.Name)
        end
        _G.GameUtil.SetActiveByCondition(tb.obj_mask, not self.data:CheckCardCondition(self.data.cfg.activation[index]))
    end
end
---点击卡牌
function CombineSkillView:OnClickCard(item, sid)
    if not self.data:CheckCardCondition(sid) then
        _G.PopWindowManager:GetInstance():ShowAllTips(580103)
    end
end

---显示技能效果
function CombineSkillView:ShowSkillDes()
    local tb = {}
    local count = 1
    for i = 1, #self.data.cfg.skills do
        tb[self.data.cfg.skills[i]] = self.data.cfg.skills[i]
        if self.data.cfg.skills[i] ~= self.data.cfg.skills[1] and count == 1 then
            count = i
        end
    end
    tb = _G.table.toArray(tb)
    _G.table.sort(
        tb,
        function(a, b)
            return a < b
        end
    )
    local lv = _G.math.floor(self.data.level / count) + 1
    local show = function(desGo_table, curLv, skillCfg)
        if curLv > lv then
            desGo_table.aortext_SkillDesc.text =
                _G.string.AddColor(
                _G.string.format(_G.LangUtil.GetLangPackValue(9002050018), curLv) ..
                    "：" .. self:RemoveColor(_G.LangUtil.GetLangPackValue(skillCfg.describe1)),
                "808199"
            ) .. _G.string.AddColor("(" .. _G.GetLangPackValue(90020300082, (curLv - 1) * count) .. ")", "b23929")
        else
            desGo_table.aortext_SkillDesc.text =
                _G.string.format(_G.LangUtil.GetLangPackValue(9002050018), curLv) ..
                "：" .. self:RemoveColor(_G.LangUtil.GetLangPackValue(skillCfg.describe1))
        end
        desGo_table.gameObject:SetActiveE(1)
    end
    for i, v in ipairs(self.skillDesList) do
        v.gameObject:SetActiveE(0)
    end
    for i, v in ipairs(tb) do
        local cfg = _G.ConfigManager.card_skills_cfg[v]
        if i > 1 then
            if not self.skillDesList[i - 1] then
                _G.PoolsManager:GetInstance():Spawn(
                    skillDescItemPath,
                    _G.ePoolType.Temporary,
                    self.upTb.trans_content,
                    function(trans)
                        self.skillDesList[i - 1] = _G.GetAutoGoTable(trans)
                        show(self.skillDesList[i - 1], i, cfg)
                    end
                )
            else
                show(self.skillDesList[i - 1], i, cfg)
            end
        else
            self.go_table.aortext_Desc.text = self:RemoveColor(_G.LangUtil.GetLangPackValue(self.data.desc))
        end
    end
end

function CombineSkillView:RemoveColor(str)
    local str1 = _G.string.gsub(str, "(<color=#(%w*)>)", "<color=#14874a>")
    return str1
end
---刷新描述显示
function CombineSkillView:RefreshSkillDes()
    for i, v in ipairs(self.data.cfg.skills) do
        local cfg = _G.ConfigManager.card_skills_cfg[v]
        if i > 1 then
            local tb = self.skillDesList[i]
            if i > self.data.level then
                tb.aortext_SkillDesc.text =
                    _G.string.AddColor(
                    _G.string.format(_G.LangUtil.GetLangPackValue(90020600039), cfg.level) ..
                        "：" .. self:RemoveColor(_G.LangUtil.GetLangPackValue(cfg.describe1)) .. "\n",
                    "808199"
                )
            else
                tb.aortext_SkillDesc.text =
                    _G.string.format(_G.LangUtil.GetLangPackValue(90020600039), cfg.level) ..
                    "：" .. self:RemoveColor(_G.LangUtil.GetLangPackValue(cfg.describe1)) .. "\n"
            end
        end
    end
end
---显示升级界面
function CombineSkillView:ShowUp(isChange)
    if not self.upTb then
        self.upTb = _G.GetAutoGoTable(self.go_table.obj_up)
    end
    self.go_table.obj_active:SetActiveE(0)
    self.go_table.obj_up:SetActiveE(1)
    self.go_table.aortext_label.text = _G.LangUtil.GetLangPackValue(90020300113)
    self:ChangeConsume()
    self.action = self.OnUp
    self.go_table.trans_Prop:SetLocalPosition(0, 4, 0)
    self:ShowSkillDes()
    if isChange then
        self.upTb.trans_content:SetAnchorPosition(0, 0)
    end
end

---显示激活界面
function CombineSkillView:ShowActive()
    if not self.activeTb then
        self.activeTb = _G.GetAutoGoTable(self.go_table.obj_active, _G.handler(self, self.OnClickBtn))
    end
    self.go_table.obj_active:SetActiveE(1)
    self.go_table.obj_up:SetActiveE(0)
    self.go_table.aortext_label.text = _G.LangUtil.GetLangPackValue(90023500003)
    self.action = self.OnActive
    self.activeTb.aortext_title2.text = _G.LangUtil.GetLangPackValue(90024900053)
    self:ShowCard()
    self:ShowCondition()
    self.go_table.trans_Prop:SetLocalPosition(0, -25, 0)
end
---更改消耗
---@param tb BaseItemData[]
function CombineSkillView:ChangeConsume()
    if not self.data.isActive or self.data.level >= self.data.maxLevel then
        _G.GameUtil.SetActiveByCondition(self.upTb.trans_Consume, false)
        return
    end
    _G.GameUtil.SetActiveByCondition(self.upTb.trans_Consume, true)
    if not self.ConsumeList then
        self.ConsumeList = {}
        for i = 1, 1 do
            self.ConsumeList[i] = _G.GetAutoGoTable(self.upTb["obj_consumeItem" .. i])
        end
    end
    local cfg = self.data.cfg.consume
    local tb = self.ConsumeList[1]
    if cfg[self.data.level] then
        tb.aorrawimage_icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(cfg[self.data.level][1]))
        if _G.StorageManager:GetInstance():GetItemCountBySid(cfg[self.data.level][1]) >= cfg[self.data.level][2] then
            tb.aortext_count.text = cfg[self.data.level][2]
        else
            tb.aortext_count.text = _G.string.AddColor(cfg[self.data.level][2], "ff5656")
        end
    end
end
---显示条件
function CombineSkillView:ShowCondition()
    if self.data.isActive then
        local name, star = require "CardInfoManager":GetInstance():GetCardColorName(self.data:GetCardStar())
        local count, all = self.data:GetUnLockCardCount()
        if self.data.level >= self.data.maxLevel then
            count = all
        end
        if star == 0 then
            self.activeTb.aortext_condition.text =
                _G.string.format(_G.LangUtil.GetLangPackValue(90024900047), _G.LangUtil.GetLangPackValue(name), star) ..
                _G.string.format("(%s/%s)", count, all)
        else
            self.activeTb.aortext_condition.text =
                _G.string.format(_G.LangUtil.GetLangPackValue(90024900034), _G.LangUtil.GetLangPackValue(name), star) ..
                _G.string.format("(%s/%s)", count, all)
        end
    else
        local count, all = self.data:GetUnLockCardCount()
        local name, star = require "CardInfoManager":GetInstance():GetCardColorName(self.data:GetCardStar())
        if star == 0 then
            self.activeTb.aortext_condition.text =
                _G.string.format(_G.LangUtil.GetLangPackValue(90024900048), _G.LangUtil.GetLangPackValue(name), star) ..
                _G.string.format("(%s/%s)", count, all)
        else
            self.activeTb.aortext_condition.text =
                _G.string.format(_G.LangUtil.GetLangPackValue(90024900033), _G.LangUtil.GetLangPackValue(name), star) ..
                _G.string.format("(%s/%s)", count, all)
        end
    end
end
---激活
function CombineSkillView:OnActive()
    if not self.data.canActive then
        _G.PopWindowManager:GetInstance():ShowAllTips(580101)
        return
    end
    AudioManager.PlayAudio(_G.AudioType.PlaySound, 2033)
    require "CombineModel":GetInstance():ActiveCombine(
        self.data.id,
        function()
            self:RefreshPanel()
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_mask, true)
            self:ShowActiveEffect(
                function()
                    _G.GameUtil.SetActiveByCondition(self.go_table.obj_mask, false)
                    _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.CombineUnLockSkillView.Name,
                        self.data
                    )
                end
            )

            _G.Events:GetInstance():Broadcast(
                _G.ePlayAactionEvent.PlayAaction,
                {_G.ActiveTaskEnum.ConditionEnum.Combine.levelNum, self.data.level},
                require "CombineModel":GetInstance():GetNumByLevel(self.data.level),
                nil,
                true
            )
        end
    )
end

---升级
function CombineSkillView:OnUp()
    if not self.data.canUp then
        if
            _G.StorageManager:GetInstance():CheckItem(
                self.data.cfg.consume[self.data.level][1],
                self.data.cfg.consume[self.data.level][2]
            )
         then
            _G.PopWindowManager:GetInstance():ShowAllTips(580102)
        else
            _G.GameUtil.FastUseChooseItem(
                UpMaterial,
                self.data.cfg.consume[self.data.level][1],
                self.data.cfg.consume[self.data.level][2],
                function()
                    require "CombineModel":GetInstance():UpdateAllData()
                    self:RefreshPanel()
                end
            )
        end
        return
    end
    local lv = self.data:GetSkillLevel()
    require "CombineModel":GetInstance():UpCombine(
        self.data.id,
        function()
            self.go_table.trans_effect3:SetActiveE(0)
            self.go_table.trans_effect3:SetActiveE(1)
            self:RefreshPanel()
            if lv ~= self.data:GetSkillLevel() then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CombineUpSkillView.Name, self.data)
            end

            _G.Events:GetInstance():Broadcast(
                _G.ePlayAactionEvent.PlayAaction,
                {_G.ActiveTaskEnum.ConditionEnum.Combine.levelNum, self.data.level},
                require "CombineModel":GetInstance():GetNumByLevel(self.data.level),
                nil,
                true
            )
        end
    )
end
---重置
function CombineSkillView:OnReset()
    local id = 580301
    ---@type tips_system_cfg
    local cfg = _G.ConfigManager.tips_system_cfg[id]
    if cfg then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.OptionDialogConsumeView.Name,
            {
                title = _G.LangUtil.GetLangPackValue(cfg.title),
                content = _G.string.format(
                    _G.LangUtil.GetLangPackValue(cfg.content),
                    _G.ConfigManager.discrete_cfg[104601][1][1]
                ),
                consume = _G.ResPropID.Diamond,
                consumeCount = _G.ConfigManager.discrete_cfg[104601][1][1],
                btns = {_G.LangUtil.GetLangPackValue(cfg.button2), _G.LangUtil.GetLangPackValue(cfg.button1)},
                callback = {
                    function()
                        require "CombineModel":GetInstance():ResetCombine(
                            self.data.id,
                            function()
                                self:RefreshPanel()
                            end
                        )
                    end
                }
            }
        )
    end
end
---刷新界面
function CombineSkillView:RefreshPanel()
    self:ShowUp()
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_reset, self.data.level > 1)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_max, self.data.level >= self.data.maxLevel)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_action, self.data.level < self.data.maxLevel)
    if not (self.data.isActive and self.data.level >= self.data.maxLevel) then
        self.go_table.aorbtn_action:SetGray(not (self.data.canUp or self.data.canActive))
        if self.data.canUp or self.data.canActive then
            self.go_table.aortext_label.color = _G.ColorTools.FormatColorByString("914801")
        else
            self.go_table.aortext_label.color = _G.ColorTools.FormatColorByString("3d3d3d")
        end
    end
    if self.view then
        self.view:RefreshPanel()
    end
    self:ShowAttribute()
end

---按钮点击事件在这里派发
function CombineSkillView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_reset then
        self:OnReset()
    elseif go == self.go_table.aorbtn_way then
    elseif go == self.go_table.aorbtn_action then
        if self.action then
            self.action(self)
        end
    elseif self.activeTb and go == self.activeTb.aorbtn_skill then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CombineTipView.Name, self.data)
    end
end

function CombineSkillView:ShowActiveEffect(call)
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.daozhaoshifang,
        self.go_table.trans_effect2,
        function(trans)
            local role1 = trans:GetChildE(3):GetChildE(0):GetChildE(0):GetComponentE(_G.typeof(_G.CS.AorRawImage))
            local role2 = trans:GetChildE(3):GetChildE(1):GetChildE(0):GetComponentE(_G.typeof(_G.CS.AorRawImage))
            role1:LoadImage("Images/Battle/Banner/" .. self.data.cfg.activation[1])
            role2:LoadImage("Images/Battle/Banner/" .. self.data.cfg.activation[2])
        end,
        function()
            if call then
                call()
            end
        end
    )
end
---显示属性加成
function CombineSkillView:ShowAttribute()
    local attribute = require "CombineModel":GetInstance():GetAttribute(self.data.id)
    if attribute then
        local prop = attribute:GetAttrByName()
        local showlist = {}

        for i, v in pairs(prop) do
            -- if v > 0 then
            table.insert(
                showlist,
                {
                    key = i,
                    sortid = _G.AttrType[i].sortid,
                    proptype = _G.AttrType[i].proptype,
                    des = _G.LangUtil.GetLangPackValue(_G.ConfigManager.type_attribute_cfg[_G.AttrType[i].ID].name),
                    percentage = _G.AttrType[i].percentage
                }
            )
        end
        _G.SortList(
            showlist,
            function(a)
                return -a.sortid
            end
        )
        for i = 1, #showlist do
            local data = showlist[i]
            local key = data.key
            local tb = _G.GetAutoGoTable(self.go_table["obj_prop" .. i])
            tb.aortext_name.text = data.des
            local num = prop[key]
            if data.percentage == 1 then
                num = num * 100
                num = _G.Mathf.RoundToInt(num)
                num = _G.tostring(num) .. "%"
                tb.aortext_value.text = num
            else
                tb.aortext_value.text = _G.tostring(num)
            end
        end
    end
end

return CombineSkillView
