---@class CombineView_SkillItem : Component	中文描述
---@field go_table CombineView._obj_Skill_GoTable
---@field data CombineData
---@field CardList _obj_SkillInfo._obj_card1_GoTable[]
---@field view CombineView
local CombineView_SkillItem = _G.BaseClass("CombineView_SkillItem", _G.Component)
local choose = {
    [1] = _G.Color(1, 1, 1, 1),
    [2] = _G.Color(1, 1, 1, 0.5)
}
function CombineView_SkillItem:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建对象时,入口构造函数
function CombineView_SkillItem:OnCreate(view, call)
    self.view = view
    self.call = call
    self.ani = self.gameObject:GetChildE(0):GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
end

---更新显示
---@param data CombineData
function CombineView_SkillItem:Show(data, isChoose)
    if not data then
        _G.GameUtil.SetActiveByCondition(self.gameObject, false)
        return
    end
    if self.data and self.data.id == data.id then
        self:ShowActionBtn()
        self:ShowLv()
        self:ShowLock()
    else
        self.data = data
        self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(self.data.skillCfg.name1)
        self.go_table.aorrawimage_icon:LoadImage("")
        self.go_table.aorrawimage_icon:LoadImage(self.data.skillCfg.icon)
        self:ShowActionBtn()
        self:ShowLv()
        self:ShowLock()
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_type, self.data.isActive)
    local languageId = _G.ConfigManager.battle_skill_cfg[self.data.skillCfg.skills[1]].Brief
    self.go_table.aortext_type1.text = _G.ConfigManager.language_package_cfg[languageId]
    _G.GameUtil.SetActiveByCondition(self.gameObject, true)
    self:ShowChoose(isChoose)
end
---显示选中特效
function CombineView_SkillItem:ShowChoose(isChoose)
    if not self.chooseeffect and isChoose then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_kejihuo_1,
            self.go_table.trans_Effect,
            function(trans)
                if _G.IsNil(self.go_table) then
                    _G.DestroyObject(trans)
                    return
                end
                self.chooseeffect = trans
                trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                _G.GameUtil.SetActiveByCondition(self.chooseeffect, isChoose)
            end
        )
    else
        if self.chooseeffect then
            _G.GameUtil.SetActiveByCondition(self.chooseeffect, isChoose)
        end
    end
    self.go_table.aorimage_bg.color = isChoose and choose[2] or choose[1]
end

---显示行为按钮
function CombineView_SkillItem:ShowActionBtn()
    if not self.activeEffect and self.data.canActive then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_kejihuo,
            self.go_table.obj_active,
            function(trans)
                self.activeEffect = trans
                trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                _G.GameUtil.SetActiveByCondition(self.activeEffect, self.data.canActive)
            end
        )
    else
        if self.activeEffect then
            _G.GameUtil.SetActiveByCondition(self.activeEffect, self.data.canActive)
        end
    end
    if self.data.isActive then
        if self.data:GetIsMax() then
            self.go_table.aorimage_bg.SpriteName = "ui_hejiji_frame_yimanji"
        else
            self.go_table.aorimage_bg.SpriteName = "ui_hejiji_frame_yijihuo"
        end
    else
        self.go_table.aorimage_bg.SpriteName = "ui_hejiji_frame_weijihuo"
    end

    _G.GameUtil.SetActiveByCondition(self.go_table.obj_active, self.data.canActive)
end
---显示等级
function CombineView_SkillItem:ShowLv()
    _G.GameUtil.SetActiveByCondition(
        self.go_table.obj_lv,
        self.data.isActive and not self.data:GetIsMax()
    )
    _G.GameUtil.SetActiveByCondition(
        self.go_table.obj_end,
        ---策划说不能升级的也改成已满级
        self.data.isActive and self.data:GetIsMax()
            --(self.data:GetIsMax() and not require "CombineModel":GetInstance():CheckSpecialCombine(self.data.id))
    )
    if not self.upEffect and self.data.canUp then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_keshengjijiantou,
            self.go_table.obj_up,
            function(trans)
                self.upEffect = trans
                trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                _G.GameUtil.SetActiveByCondition(self.upEffect, self.data.canUp)
            end
        )
    else
        if self.upEffect then
            _G.GameUtil.SetActiveByCondition(self.upEffect, self.data.canUp)
        end
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_up, self.data.canUp)
    self.go_table.aortext_lv.text = self.data.level
end
---显示未激活
function CombineView_SkillItem:ShowLock()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_mask, not self.data.isActive)
    _G.GameUtil.SetActiveByCondition(self.go_table.aortext_unLock, not self.data.isActive and not self.data.canActive)
end

function CombineView_SkillItem:OnClickBtn(go, isOn)
    self.view:SetCurData(self.data)
end

---销毁对象时,析构函数
function CombineView_SkillItem:OnDestroy()
end

return CombineView_SkillItem
