---@class CombineView : UIBaseView	中文描述
---@field public go_table CombineView_GoTable GoTable
---@field CombineDatas CombineData[]
---@field CombineItems CombineView_SkillItem[]
---@field SkillDesc CombineView._obj_skillDesc_GoTable
---@field CombineSkillView CombineSkillView
local CombineView = _G.BaseClass("CombineView", _G.UIBaseView)
-- _G.CombineView = CombineView

function CombineView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
function CombineView:OnDestroy()
    require "CombineModel":GetInstance():SetOnceUpRedPoint()
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.MainCombine.id)
end

---界面的入口函数
function CombineView:OnCreate(callback)
    self.callback = callback
    if not _G.table.isEmptyOrNil(_G.ConfigManager.main_function_cfg[5024].Display_condition) then
        if
            not _G.GlobalConditionManager.CheckCondition(
                _G.ConfigManager.main_function_cfg[5024].Display_condition[1],
                _G.ConfigManager.main_function_cfg[5024].Display_condition[2]
            )
         then
            _G.PopWindowManager:GetInstance():ShowAllTips(110125)
            self:Close()
            return
        end
    end
    self.isInit = true
    self:Init()
end

function CombineView:Init()
    local CombineModelIns = require "CombineModel":GetInstance()
    CombineModelIns:UpdateAllData()
    CombineModelIns:SortData()
    self.CombineItems = {}
    self.LhItems = {}
    self.toggle = {}
    self.InitTimer = {}
    self.curType = _G.CombineType.All
    self.CombineDatas = CombineModelIns:GetCombineData(self.curType)
    self.CombineData = self.CombineDatas[1]
    self.CombineSkillView = self:AddComponent(self.go_table.obj_SkillInfo, require "CombineSkillView".New(self))
    self.go_table.scrollloopvectical_SkillList:InitItemData(0, _G.handler(self, self.RefreshItem))
    self.go_table.scrollloopvectical_SkillList:DetectingSlippage(_G.handler(self, self.DetectingSlippageY))
    local typeCount = #_G.ConfigManager.discrete_cfg[105003][1]
    self.go_table.scrollloopvectical_ToggleList:InitItemData(typeCount, _G.handler(self, self.RefreshToggle))
    self:AddComponent(
        self.go_table.obj_gold,
        require("ResourceCompont").New(self.go_table.obj_gold, _G.ConfigManager.ui_cfg.CombineView.resources)
    )
end
---更新激活数量
function CombineView:UpdateCollectProgress()
    local count, all = require "CombineModel":GetInstance():GetActiveCount(self.curType)
    self.go_table.aortext_collect.text = _G.string.format("%s/%s", count, all)
end

function CombineView:DetectingSlippageY(num)
    if self.count <= 9 then
        return
    end
    _G.GameUtil.SetActiveByCondition(
        self.go_table.aorimage_arrow,
        _G.math.abs(645 - (_G.math.ceil(self.count / 3)) * 150) > _G.math.abs(num)
    )
end

function CombineView:RefreshToggle(index, obj)
    ---@type CombineView._toggle_0_GoTable
    local tb = _G.GetAutoGoTable(obj)
    self.toggle[index + 1] = tb
    tb.aortext_label.text = _G.LangUtil.GetLangPackValue(_G.ConfigManager.discrete_cfg[105003][1][index + 1])
    tb.aortext_label2.text = _G.LangUtil.GetLangPackValue(_G.ConfigManager.discrete_cfg[105003][1][index + 1])
    obj:SetName("$_toggle_" .. index)
    _G.AddViewBtnClick(obj, _G.handler(self, self.OnToggle))
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, false)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOff, true)
    if index == 0 then
        tb.toggle_0.isOn = true
    end
    self:RefreshRedPoint(index + 1)
    if self.isInit then
        _G.GameUtil.SetActiveByCondition(obj, false)
        local count = index + 1
        local timer = _G.TimerManager:GetInstance():GetTimer(1 * count, self.UpdateToggle, self, true, true, nil, obj)
        timer:Start()
        _G.table.insert(self.InitTimer, timer)
    end
end

function CombineView:UpdateToggle(obj)
    _G.GameUtil.SetActiveByCondition(obj, true)
end

---刷新技能显示
function CombineView:RefreshItem(index, obj)
    local instanceID = obj:GetInstanceIDE()
    if _G.AppSetting.IsShowTeach then
        obj:SetName(index)
    end
    local content = self.CombineItems[instanceID]
    if not content then
        content = self:AddComponent(obj, require "CombineView_SkillItem".New(self, _G.handler(self, self.RefreshPanel)))
        self.CombineItems[instanceID] = content
    end
    if self.isInit then
        _G.GameUtil.SetActiveByCondition(content.gameObject, false)
        local count = _G.math.floor(index / 3)
        local timer =
            _G.TimerManager:GetInstance():GetTimer(2 * count, self.UpdateItem, self, true, true, nil, content, index)
        timer:Start()
        _G.table.insert(self.InitTimer, timer)
    else
        content:Show(self.CombineDatas[index + 1], self.CombineDatas[index + 1].id == self.CombineData.id)
    end
    if not self.isInit then
        content.ani.enabled = false
        if not content.canvasG then
            content.canvasG = content.go_table.trans_content:GetComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup))
        end
        content.canvasG.alpha = 1
        content.go_table.trans_content:SetAnchorPosition(0, 0)
    end
end

function CombineView:UpdateItem(content, index)
    if not self.isInit then
        _G.GameUtil.SetActiveByCondition(content.gameObject, true)
        return
    end
    content:Show(self.CombineDatas[index + 1], self.CombineDatas[index + 1].id == self.CombineData.id)
    if not content.canvasG then
        content.canvasG = content.go_table.trans_content:GetComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup))
    end
    _G.GameUtil.SetActiveByCondition(content.gameObject, true)
end

function CombineView:RefreshPanel()
    self.isInit = false
    local count, all = require "CombineModel":GetInstance():GetActiveCount(self.curType)
    self.go_table.aortext_collect.text = _G.string.format("%s/%s", count, all)
    local count2 = #_G.ConfigManager.discrete_cfg[105003][1]
    for i = 1, count2 do
        self:RefreshRedPoint(i)
    end
    self.go_table.scrollloopvectical_SkillList:UpdateAllItem()
end

---重置技能
function CombineView:ResetSkill()
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.CombineResetView.Name,
        self.CombineData,
        function()
            require "CombineModel":GetInstance():ResetCombine(
                self.CombineData.id,
                function()
                    self.isInit = false
                    self.go_table.scrollloopvectical_SkillList:UpdateAllItem()
                    self:UpdateSkillDesc()
                end
            )
        end
    )
end

---激活合击技
function CombineView:OnActive()
    if not self.CombineData.isActive then
        require "CombineModel":GetInstance():ActiveCombine(
            self.CombineData.id,
            function()
                self.isInit = false
                self.go_table.scrollloopvectical_SkillList:UpdateAllItem()
                self:UpdateSkillDesc()
            end
        )
    else
        require "CombineModel":GetInstance():UpCombine(
            self.CombineData.id,
            function()
                self.isInit = false
                self.go_table.scrollloopvectical_SkillList:UpdateAllItem()
                self:UpdateSkillDesc()
            end
        )
    end
end

function CombineView:OnToggle(go, isOn)
    _G.AudioManager.PlayAudioByAudioCfgID(2003)
    local tb = _G.GetAutoGoTable(go)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, isOn)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOff, not isOn)
    if not isOn then
        return
    end
    local str = _G.string.split(go:GetName(), "$_toggle_")
    local type = _G.tonumber(str[2]) + 1
    if self.curType == type then
        return
    end
    self.curType = type
    if self.curType ~= 1 and self.isInit then
        self.isInit = false
    end
    self.CombineDatas = require "CombineModel":GetInstance():GetCombineData(self.curType)
    self.CombineData = self.CombineDatas[1]
    self.count = #self.CombineDatas
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_no, self.count <= 0)
    self.go_table.scrollloopvectical_SkillList:UpdateCount(self.count)
    self.CombineSkillView:Show(self.CombineData)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_arrow, self.count > 9)
    self:UpdateCollectProgress()
end
---刷新红点
function CombineView:RefreshRedPoint(id)
    if not id then
        id = self.curType
    end
    _G.GameUtil.SetActiveByCondition(
        self.toggle[id].obj_redpoint,
        require "CombineModel":GetInstance():CheckIsPoint(id)
    )
end

---按钮点击事件在这里派发
function CombineView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
        if self.callback then
            self.callback()
        end
    elseif go == self.go_table.aorbtn_PlayDescribe then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 28)
    elseif go == self.go_table.toggle_1 then
        self:OnToggle(go, isOn)
    elseif go == self.go_table.toggle_2 then
        self:OnToggle(go, isOn)
    elseif go == self.go_table.toggle_3 then
        self:OnToggle(go, isOn)
    elseif go == self.go_table.toggle_4 then
        self:OnToggle(go, isOn)
    elseif go == self.go_table.toggle_0 then
        self:OnToggle(go, isOn)
    end
end

function CombineView:SetCurData(data)
    self.CombineData = data
    self.isInit = false
    self.go_table.scrollloopvectical_SkillList:UpdateAllItem()
    self.CombineSkillView:Show(data)
end

function CombineView:OnStartClose()
    if not _G.table.isEmptyOrNil(self.InitTimer) then
        for _, v in pairs(self.InitTimer) do
            v:Stop()
        end
        self.InitTimer = nil
    end
end

return CombineView
