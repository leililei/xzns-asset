---@class CombineCollectView : UIBaseView	中文描述
---@field public go_table CombineCollectView_GoTable GoTable
---@field CombineItems CombineCollectView._obj_Item_GoTable[]
local CombineCollectView = _G.BaseClass("CombineCollectView", _G.UIBaseView)
--_G.CombineCollectView = CombineCollectView

function CombineCollectView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function CombineCollectView:OnCreate()
    self.data = require "CombineModel":GetInstance().points
    self.CombineItems = {}
    self.go_table.scrollloopvectical_cardList:InitItemData(
        _G.table.count(self.data),
        _G.handler(self, self.RefreshItem)
    )
    local value = 0
    for _, v in pairs(self.data) do
        value = value + v.v
    end
    self.go_table.aortext_num.text = value
end

function CombineCollectView:RefreshItem(index, obj)
    local instanceID = obj:GetInstanceIDE()
    local tb = self.CombineItems[instanceID]
    local data = self.data[index + 1]
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        self.CombineItems[instanceID] = tb
    end
    _G.ItemCardFactory:GetInstance():GetItemCard(
        _G.ItemCardFactory.itemCardType.CardAllItem,
        tb.obj_Root,
        function(item)
            item:Show(data.k, nil, require "IllustrationModel":GetInstance():GetCardMaxStar(data.k))
            _G.GameUtil.SetActiveByCondition(item.go_table.obj_lvNode, false)
        end
    )
    tb.aortext_num.text = "x " .. data.v
end

---按钮点击事件在这里派发
function CombineCollectView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    else
        require "CombineModel":GetInstance():GetCollect(
            function(data)
                if data.ack == 1 then
                    _G.StorageManager:GetInstance():ReceiveAwardData(data)
                    require "CommonTipManager".OpenCommonAwardView(data)
                    self:Close()
                end
            end
        )
    end
end

return CombineCollectView
