---@class CombineUnLockSkillView : UIBaseView	中文描述
---@field public go_table CombineUnLockSkillView_GoTable GoTable
local CombineUnLockSkillView = _G.BaseClass("CombineUnLockSkillView", _G.UIBaseView)
--_G.CombineUnLockSkillView = CombineUnLockSkillView
function CombineUnLockSkillView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param data CombineData
function CombineUnLockSkillView:OnCreate(data)
    self.go_table.aorrawimage_icon:LoadImage(data.skillCfg.icon)
    self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(data.skillCfg.name1)
    self.go_table.aortext_desc.text = _G.LangUtil.GetLangPackValue(data.desc)
    -- local languageId = _G.ConfigManager.battle_skill_cfg[data.skillCfg.skills[1]].Brief
    -- self.go_table.aortext_type1.text =_G.ConfigManager.language_package_cfg[languageId]
    -- self.go_table.aortext_type2.text =
    --     _G.LangUtil.GetLangPackValue(_G.ConfigManager.discrete_cfg[105003][1][data.cfg.classify])
    _G.GameUtil.ReBuildRTF(self.go_table.obj_Content)
    self.canclick = false
    _G.DelayDo(
        0.9,
        function()
            self.canclick = true
        end
    )
end

---按钮点击事件在这里派发
function CombineUnLockSkillView:OnClickBtn(go, isOn)
    if not self.canclick then
        return
    end
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end

return CombineUnLockSkillView
