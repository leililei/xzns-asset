---@class CombineResetView : UIBaseView	中文描述
---@field public go_table CombineResetView_GoTable GoTable
local CombineResetView = _G.BaseClass("CombineResetView", _G.UIBaseView)
--_G.CombineResetView = CombineResetView

local CS = _G.CS
local typeof = _G.typeof

function CombineResetView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param data CombineData 返还材料
---@param title string 描述
function CombineResetView:OnCreate(data, enterCall)
    self.go_table.aortext_ConsumeDes.text =
        _G.string.format("是否消耗%d钻石，重置合击技等级？", _G.ConfigManager.discrete_cfg[104601][1][1])
    local MaterialDatas = data:GetResetMaterial()
    for _, v in ipairs(MaterialDatas) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            v,
            self.go_table.obj_Root,
            function(item)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
        )
    end
    local data2 = _G.StorageManager:GetInstance():GetItemDataClass(_G.ResPropID.Diamond, 0)
    self.go_table.aorrawimage_DoneIcon:LoadImage(data2:GetIconPath())
    local allCount = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.ResProp, _G.ResPropID.Diamond)
    self.go_table.aortext_HaveNum.text = _G.GameUtil.NumberToUnitStr(_G.ConfigManager.discrete_cfg[104601][1][1])
    self.go_table.aortext_ConsumeNum.text = _G.GameUtil.NumberToUnitStr(allCount)
    self.enterCall = enterCall
end

---按钮点击事件在这里派发
function CombineResetView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Close then
        self:Close()
    elseif go == self.go_table.aorbtn_Cancel then
        self:Close()
    elseif go == self.go_table.aorbtn_Done then
        if self.enterCall then
            self.enterCall()
        end
        self:Close()
    end
end

return CombineResetView
