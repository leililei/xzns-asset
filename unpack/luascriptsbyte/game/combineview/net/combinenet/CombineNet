local base = require "BaseGameNet"

---@class CombineNet : BaseGameNet	通信协议
local CombineNet = _G.BaseClass("CombineNet", base)

---@return CombineNet CombineNet
function CombineNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---获取合击技信息
---@param pbData table PB数据
---@param callback function 完成回调
function CombineNet:GetInfo(callback)
    self:Send(self:GetEmptyPB(), _G.ConfigManager.net_map.game_combine_info, callback)
end

---重置合击技
function CombineNet:ResetCombine(pbData, callback)
    self:Send(pbData, _G.ConfigManager.net_map.game_combine_reset_combine, callback)
end

---升级合击技
function CombineNet:UpCombine(pbData, callback)
    self:Send(pbData, _G.ConfigManager.net_map.game_combine_up_combine, callback)
end

---领取星海值
function CombineNet:GetPoints(callback)
    self:Send(self:GetEmptyPB(), _G.ConfigManager.net_map.game_combine_get_all_points, callback)
end

---解锁合击技
function CombineNet:UnLockCombine(pbData, callback)
    self:Send(pbData, _G.ConfigManager.net_map.game_combine_unlock, callback)
end

---发送数据
function CombineNet:Send(pbData, item, callback)
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function CombineNet:CallBack(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type CombineNet
_G.CombineNet = CombineNet
return CombineNet
