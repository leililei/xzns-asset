---同部位是否更高评分的符文
---@param data DecorationData
function CardShowView_Right_Rune:HigherSocer(data)
    local decorationBar = self.cardData.DecorationBar
    local decoData = decorationBar[data.parts].decoration
    if _G.table.isEmptyOrNil(decoData) then
        return false
    end

    if decoData:GetPower() < data:GetPower() then
        return true
    end

    return false
end

---符文变更回调
function CardShowView_Right_Rune:OnChangeCall(isStren, power, offset)
    if isStren then
        self:RefreshWearItem()
    else
        self:RefreshView()
    end
    if isStren then
        self:ShowPropUpEffect()
    else
        local suit = self:IsWearASet()
        if suit ~= 0 and suit ~= 1 then
            local cfg = _G.ConfigManager.decoration_suit_cfg[suit]
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.View_WearASet.Name, cfg.icon,
                    _G.GetLangPackValue(cfg.name), function()
                        if offset and offset > 0 then
                            require "CommonTipManager".OpenPowerUpView(power, offset)
                        end
                        self:ShowPropUpEffect()
                    end)
        else
            self:ShowPropUpEffect()
        end
    end
end

function CardShowView_Right_Rune:LoadSpine(cfg)
    self.go_table.obj_spineRoot:ClearChildren()
    _G.PoolsManager:GetInstance():Spawn(
            cfg.ModelPathHi,
            _G.ePoolType.Temporary,
            self.go_table.obj_spineRoot,
            function(trans)
                if _G.IsNil(self.go_table.obj_spineRoot) then
                    _G.DestroyObject(trans)
                    return
                end
                local pos = cfg.pos_portrait
                self.go_table.obj_spineRoot:SetLocalPosition(pos[1], pos[2], pos[3])
                self.go_table.obj_spineRoot:SetLocalScaleXYZ(cfg.size2)
                if _G.AppSetting.IsXzns then
                    local spineCfg = _G.ConfigManager.card_show_cfg[cfg.id] or _G.ConfigManager.skin_cfg[cfg.id]
                    local idle = spineCfg.display_idle[1]
                    _G.GameUtil.SetCardUiSpineAnimation(trans, idle, true, cfg.id)
                end
            end
    )
end

