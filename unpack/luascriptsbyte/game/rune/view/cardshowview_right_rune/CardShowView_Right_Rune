    self.selectIndex = _G.DecorationPart.All
    ---次级弹窗
    self.selectIndex2 = _G.DecorationPart.All
    ---@type CardShowView_Right_Rune_GoTable
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self:GetWearItem()
    if _G.AppSetting.IsXzns then
        self:SetSortOrder()
        self:InitUI()
    end
    self.go_table.obj_illRedpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.RuneIllustrate.id)
    _G.Events:GetInstance():AddListener(_G.eRune.RuneRemove, self.RefreshRune, self)
    _G.Events:GetInstance():AddListener(_G.eRune.RestRuneAttr, self.RefreshRune, self)
    _G.Events:GetInstance():AddListener(_G.eRune.OneClickWear, self.OnChangeCall, self)
end

function CardShowView_Right_Rune:InitUI()
    self.curSelectPos = CardShowView_Right_Rune.PartPos.all
    self.curSelectSuit = nil

    ---@type table<CardShowView_Right_Rune.PartPos,CardShowView_Right_Rune._obj_posNode1_GoTable>
    self.posNodes = {}
    for i = 1, 5 do
        local item = self.go_table["obj_posNode" .. i]
        self.posNodes[i] = GetAutoGoTable(item, handlerbind(self, self.SetSelectPosNode, i))
    end
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.CardShowView.Name)
    if view then
        ---@type CardData
        self.tempCardData = view.CardData
        local cfg = _G.ConfigManager.decoration_cfg[self.tempCardData.cfg.rune_recommend[1][1]]
        self.curRecomSuitCfg = _G.ConfigManager.decoration_suit_cfg[cfg.suit]
    end
end

function CardShowView_Right_Rune:SetSelectPosNode(go, ison, index)
    self:OnClickItem2(nil, nil, CardShowView_Right_Rune.PosToPart[index])
end

function CardShowView_Right_Rune:SetSortOrder()
    local base = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.CardShowView.Name)
    if not base then
        base = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.PreviewCardShowView.Name)
    end
    if base then
        _G.UIUtils.SetCanvasSortingOrder(self.gameObject, base.gameObject)
