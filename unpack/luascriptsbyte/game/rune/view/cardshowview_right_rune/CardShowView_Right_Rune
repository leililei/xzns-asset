---属性变化飘字
function CardShowView_Right_Rune:ShowPropUpEffect()
    if self.lastCardRuneProp and self.lastCardData.uid == self.cardData.uid then
        _G.Events:GetInstance():Broadcast(_G.eCardShow.CardChangeProp, self.lastCardRuneProp)
    end
    self.lastCardRuneProp = _G.GameUtil.GetPropUpData(self.cardData)
    self.lastCardData = self.cardData
end

function CardShowView_Right_Rune:IsWearASet()
    local suit = 0
    for k, v in pairs(self.cardData.DecorationBar) do
        if table.isEmptyOrNil(v.decoration) then
            return 0
        else
            if suit == 0 then
                suit = v.decoration.suit
            elseif v.decoration.suit ~= suit then
                return 0
            end
        end
    end
    return suit
end

---按钮点击事件在这里派发
function CardShowView_Right_Rune:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_illustrate then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RuneIllustrationView.Name)
    elseif go == self.go_table.aorbtn_compose then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RuneDecomposeView.Name,
                function()
                    self:RefreshRune()
                end,
                self.cardData)
    elseif go == self.go_table.aorbtn_prop then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RunePropDetailsView.Name, self.cardData)
    elseif go == self.go_table.aorbtn_left then
        self.unfoldDropdown2 = false
        self.dropDownListView = nil
        self.dropDownListView2 = nil
        self.selectIndex = 0
        self.curSelectSuit = nil
        self:OnClick_CutoverRole(false)
    elseif go == self.go_table.aorbtn_right then
        self.unfoldDropdown2 = false
        self.dropDownListView = nil
        self.dropDownListView2 = nil
        self.selectIndex = 0
        self.curSelectSuit = nil
        self:OnClick_CutoverRole(true)
    elseif go == self.go_table.aorbtn_dropdown or go == self.go_table.aorbtn_dropdown1 then
        self.unfoldDropdown = not self.unfoldDropdown
        if self.unfoldDropdown == false then
            self.unfoldDropdown2 = false
            self.curSelectSuit = nil
            self:RefreshRuneList()
        end
        if AppSetting.IsXzns then
            self:RefreshLooplistType()
            self:RefreshSuitSelectView()
        end
        self:RefreshDropDwon()
    elseif go == self.go_table.aorbtn_reset or go == self.go_table.aorbtn_reset1 then
        local decoration = self.cardData.DecorationBar
        local canReset = false
        if decoration then
            for _, v in pairs(decoration) do
                if v.slotLevel and v.slotLevel > 0 then
                    canReset = true
                end
            end
        end
        if canReset then
            _G.PopWindowManager:GetInstance():ShowBtnWindowByToggle(1020003,
                    _G.handler(self, self.ResetSlot), nil, _G.handler(self, self.ResetSlot), true)
        end
    elseif go == self.go_table.aorbtn_strength then
        self:OnekeyStrength()
    elseif go == self.go_table.aorbtn_refresh then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RuneRefreshView.Name,
                function()
                    self:RefreshRune()
                end,
                self.cardData.uid)
    elseif go == self.go_table.aorbtn_CloseTips then
        self.unfoldDropdown = false
        self.unfoldDropdown2 = false
        self:RefreshDropDwon()
        self:RefreshRuneList()
    elseif go == self.go_table.aorbtn_strategystation then
        --打开攻略站
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.StrategyStationTipView.Name, {
            cardData = self.cardData,
        })
    elseif go == self.go_table.aorbtn_Recom then
        --推荐穿戴刻印
        self:OneTouchRecom()
    end
end

