---刷新穿戴的item
function CardShowView_Right_Rune:RefreshWearItem()
    ---@type table<number,DecorationData[]>
    local CurSuits = {}
    local curSuitNum = 0
    if self.cardData.DecorationBar then
        for part, v in pairs(self.cardData.DecorationBar) do
            self.wearItemList[part].obj_root:ClearChildren()
            if v and not _G.table.isEmptyOrNil(v.decoration) then
                self.wearItemList[part].obj_empty:SetActiveE(0)
                if _G.AppSetting.IsXzns then
                    ---@type DecorationData
                    local data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Decoration,
                            v.decoration.uid)
                    self.wearItemList[part].aorrawimage_icon:SetActiveE(1)
                    self.wearItemList[part].aorrawimage_icon:LoadImage(data.Icon)
                    self.wearItemList[part].obj_slotLevel:SetActiveE(1)
                    self.wearItemList[part].aortext_slotLevel.text = v.slotLevel
                    self.wearItemList[part].obj_level:SetActiveE(1)
                    self.wearItemList[part].aortext_level.text = "Lv." .. data.level
                    if CurSuits[data.suit] == nil then
                        CurSuits[data.suit] = {}
                        curSuitNum = curSuitNum + 1
                    end
                    table.insert(CurSuits[data.suit], data)

                    local bgSpriteName
                    if data.Grade <= 3 then
                        bgSpriteName = "ui_js_fw_tf_yuan_lan"
                    elseif data.Grade == 4 then
                        bgSpriteName = "ui_js_fw_tf_yuan_zi"
                    elseif data.Grade == 5 then
                        bgSpriteName = "ui_js_fw_tf_yuan_cheng"
                    elseif data.Grade == 6 then
                        bgSpriteName = "ui_js_fw_tf_yuan_hong"
                    elseif data.Grade >= 7 then
                        bgSpriteName = "ui_js_fw_tf_yuan_cai"
                    end
                    self.wearItemList[part].aorimage_bg.SpriteName = bgSpriteName
                    self.wearItemList[part].aorimage_bg:SetGray(false)

                    self.wearItemList[part].aorbtn_click.onClick:RemoveAllListeners()
                    self.wearItemList[part].aorbtn_click.onClick:AddListener(
                            function()
                                _G.UIManager:GetInstance():OpenWindow(
                                        _G.ConfigManager.ui_cfg.RuneTipView.Name,
                                        v.decoration,
                                        v.decoration.cfg,
                                        false,
                                        self.cardData,
                                        _G.handler(self, self.OnChangeCall),
                                        false,
                                        false,
                                        true
                                )
                            end
                    )
                else
                    _G.StorageManager:GetInstance():GetItemBaseViewNew(
                            { v.decoration.cfg.id },
                            self.wearItemList[part].obj_root,
                            function(tran)
                                if _G.IsNil(self.wearItemList[part].obj_root) then
                                    _G.DestroyObject(tran.gameObject)
                                    return
                                end
                                tran:ShowLevel(true)
                                tran:ShowSlotLevel(v.slotLevel and v.slotLevel > 0, v.slotLevel)
                            end,
                            function()
                                _G.UIManager:GetInstance():OpenWindow(
                                        _G.ConfigManager.ui_cfg.RuneTipView.Name,
                                        v.decoration,
                                        v.decoration.cfg,
                                        false,
                                        self.cardData,
                                        _G.handler(self, self.OnChangeCall),
                                        false,
                                        false,
                                        true
                                )
                            end,
                            v.decoration.uid
                    )
                end
            else
                self.wearItemList[part].obj_empty:SetActiveE(1)
                if _G.AppSetting.IsXzns then
                    self.wearItemList[part].obj_level:SetActiveE(0)
                    self.wearItemList[part].obj_slotLevel:SetActiveE(0)
                    self.wearItemList[part].aorrawimage_icon:SetActiveE(0)
                    self.wearItemList[part].aorimage_bg.SpriteName = "ui_js_fw_tf_yuan_zi"
                    self.wearItemList[part].aorimage_bg:SetGray(true)
                    self.wearItemList[part].aorbtn_click.onClick:RemoveAllListeners()
                    self.wearItemList[part].aorbtn_click.onClick:AddListener(
                            function()
                                _G.PopWindowManager:GetInstance():ShowAllTips(120312)
                            end
                    )
                end
            end
        end
    end

    if AppSetting.IsXzns then
        local suitDic = {}
        for _, v in pairs(self.cardData.DecorationBar) do
            if not _G.table.isEmptyOrNil(v) and v.decoration then
                suitDic[v.index] = v.decoration.suit
            end
        end
        local curShowTxt = GetLangPackValue(90032800165)
        local SuitBg = nil
        local txt = ""
        for _, suitId in ipairs(suitDic) do
            local datas = CurSuits[suitId]
            local suitNum = #datas
            if suitNum >= 2 then
                if txt == "" then
                    txt = string.format("%s(%s/4)", datas[1]:GetSuitName(), suitNum)
                    --else
                    --    txt = string.format("%s-%s(%s/4)",txt,datas[1]:GetSuitName(),suitNum)
                end
                if suitNum == 4 then
                    local curMinData = datas[1]
                    for i = 1, suitNum do
                        if curMinData.Grade > datas[i].Grade then
                            curMinData = datas[i]
                        end
                    end
                    SuitBg = curMinData:GetSuitBg()
                end
            end
        end
        if txt ~= "" then
            curShowTxt = txt
        end
        self.go_table.aortext_tip.text = curShowTxt
        if SuitBg then
            self.go_table.aorrawimage_suitbackground:SetActiveE(1)
            self.go_table.aorrawimage_suitbackground:LoadImage(SuitBg)
        else
            self.go_table.aorrawimage_suitbackground:SetActiveE(0)
        end
        self.go_table.aortext_Recomtip.text = GetLangPackValue(90032800166, GetLangPackValue(self.curRecomSuitCfg.name))
    end
end

---获取所有符文数据
function CardShowView_Right_Rune:GetRuneData()
    ---@type DecorationData[]
    local decorations = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Decoration)
    self.allDecorations = {}
    ---不同部位的数据
    self.otherDecoration = {}
    --- 套装分组
    self.suitDecoration = {}
    local professional = self.cardData:GetProfessional()

    if not _G.table.isEmptyOrNil(decorations) then
        local decorationParts = {}

        -- 分组：按 Grade 分组，再按 suit 分组 策划特殊规则：排序时用全部符文排序，显示时只显示未穿戴的
        for _, v in pairs(decorations) do
            if professional == v.Professional then
                if not decorationParts[v.suit] then
                    decorationParts[v.suit] = {}
                end
                local qgroup = decorationParts[v.suit]
                if not qgroup[v.parts] then
                    qgroup[v.parts] = {
                        parts = v.parts,
                        max_power = v:GetPower(),
                        items = { v }
                    }
                else
                    if v:GetPower() > qgroup[v.parts].max_power then
                        qgroup[v.parts].max_power = v:GetPower()
                    end
                    _G.table.insert(qgroup[v.parts].items, v)
                end

                if not self.suitDecoration[v.suit] then
                    -- self.suitDecoration[v.suit] = _G.ConfigManager.decoration_suit_cfg[v.suit].name
                    self.suitDecoration[v.suit] = v.suit
                end
            end
        end

        local testList = {}
        for k, v in pairs(self.suitDecoration) do
            table.insert(testList, v)
        end
        if AppSetting.IsXzns == false then
            table.insert(testList, 1, _G.DecorationPart.All)
        end
        self.suitDecoration = testList
        -- 获取所有品质，降序排列
        local qualities = {}
        for quality in pairs(decorationParts) do
            _G.table.insert(qualities, quality)
        end
        _G.table.sort(qualities, function(a, b)
            return a > b
        end)
        self.allDecorations[0] = {}

        for _, suit in ipairs(qualities) do
            local set_groups = {}
            for _, part in pairs(decorationParts[suit]) do
                _G.table.insert(set_groups, part)
            end

            -- 套装组按 max_power 降序排
            _G.table.sort(set_groups, function(a, b)
                return a.max_power > b.max_power
            end)

            -- 每组内部符文按 power 降序
            for _, group in ipairs(set_groups) do
                for _, item in ipairs(group.items) do
                    for _, v in pairs(PartList) do
                        if not self.allDecorations[v] then
                            self.allDecorations[v] = {}
                        end
                        if item.parts == v then
                            _G.table.insert(self.allDecorations[v], item)
                        end
                    end
                    _G.table.insert(self.allDecorations[0], item)

                    --- otherDecoration 此处由套装分类创建
                    --- self.otherDecoration ={ [1] = {...},[11] = {...} }
                    if not self.otherDecoration[item.suit] then
                        self.otherDecoration[item.suit] = {}
                        self.otherDecoration[item.suit][0] = {}
                    end

                    for _, v in pairs(PartList) do
                        if not self.otherDecoration[item.suit][v] then
                            self.otherDecoration[item.suit][v] = {}
                        end
                        if item.parts == v then
                            _G.table.insert(self.otherDecoration[item.suit][v], item)
                        end
                    end

                    _G.table.insert(self.otherDecoration[item.suit][0], item)
                end
            end
        end
    else
        self.allDecorations[0] = {}
        if AppSetting.IsXzns == false then
            table.insert(self.suitDecoration, 1, _G.DecorationPart.All)
        end
    end
end

---@param cardData CardData
function CardShowView_Right_Rune:ShowCardInfo(cardData, nowIndex, sumIndex)
    ---@type CardData
    self.cardData = cardData
    self.unfoldDropdown = false
    if nowIndex ~= nil then
        self.go_table.aorbtn_left:SetActiveE(nowIndex > 1 and 1 or 0)
    else
        self.go_table.aorbtn_left:SetActiveE(0)
    end
    if nowIndex ~= nil then
        self.go_table.aorbtn_right:SetActiveE(nowIndex ~= sumIndex and 1 or 0)
    else
        self.go_table.aorbtn_right:SetActiveE(0)
    end

    local CardInfoManager = require("CardInfoManager"):GetInstance()
    self.go_table.aorrawimage_bg:LoadImage(CardInfoManager:GetCardElementBg(cardData:GetElement()))
    --加载模型spine
    local skinid = (cardData.skinid and cardData.skinid ~= 0) and cardData.skinid or cardData.skin
    local cfg = CardInfoManager.GetCardSkin_ShowCfg(skinid, cardData.sid)
    self:LoadSpine(cfg)
    if _G.AppSetting.IsXzns then
        if cfg.pos_bg then
            self.go_table.aorrawimage_bg:LoadImage(cfg.pos_bg)
        end
        self.go_table.aortext_element.text = _G.GetLangPackValue(_G.ElementStrEnum[cardData.cfg.Elements])
    end

    --设定元素和职业图标
    CardInfoManager:SetElementsProfessionalSP(self.go_table.aorimage_element, cardData.cfg.Elements)
    ---卡牌名
    self.go_table.aortext_name.text = _G.GetLangPackValue(cardData.cfg.Name)
    -- 设置星级 最高5星 (不为阶级)
    local SpriteName
    for i = 1, 5 do
        SpriteName = CardInfoManager:GetHuoSpriteName(cardData.star, i)
        self.go_table["aorimage_star" .. i].SpriteName = SpriteName
        self.go_table["aorimage_star" .. i]:SetActiveE(SpriteName and 1 or 0)
    end

    if _G.AppSetting.IsXzns then
        self.go_table.aortext_desc.text = _G.GetLangPackValue(cardData.cfg.card_title)
    end

    self:GetRuneData()
    self:RefreshDropDwon()
    self:RefreshView()
    if table.isEmptyOrNil(self.lastCardData) or self.lastCardData.uid ~= self.cardData.uid then
        self:ShowPropUpEffect()
    end

    ---红点
    self.go_table.obj_strenRedpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.RuneStrength.id,
            self.cardData.uid)
    for i = 1, 4 do
        self.wearItemList[i].obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.DecorationSlot.id,
                self.cardData.uid * 10 + i)
    end
end

