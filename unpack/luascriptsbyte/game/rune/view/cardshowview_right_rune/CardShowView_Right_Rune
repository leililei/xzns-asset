function CardShowView_Right_Rune:RefreshRuneItem(index, obj)
    local data = self.runeList[index + 1]
    local tb = _G.GetAutoGoTable(obj)
    tb.obj_redpoint:SetActiveE(0)

    tb.obj_root:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
            { data.sid },
            tb.obj_root,
            function(tran)
                if _G.IsNil(tb.obj_root) then
                    _G.DestroyObject(tran.gameObject)
                    return
                end
                tran:ShowLevel(true)
                tran:ShowSlotLevel(false)
                ---同部位是否更高评分的符文
                tran:ShowUp(self:HigherSocer(data))
            end,
            function()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RuneTipView.Name,
                        data, data.cfg, false, self.cardData, _G.handler(self, self.OnChangeCall), false, false, true)
            end,
            data.uid
    )
end

function CardShowView_Right_Rune:RefreshRuneItem2(index, obj)
    ---@type number
    local id = self.suitDecoration[index + 1]
    ---@type CardShowView_Right_Rune._obj_runesItem_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem_Suit, index))
    tb.obj_redpoint:SetActiveE(0)

    local data = ConfigManager.decoration_suit_cfg[id]
    local professional = self.cardData:GetProfessional()

    local isrec = self.curRecomSuitCfg.id == id and 1 or 0
    tb.obj_RecNode:SetActiveE(isrec)

    if id == 1 then
        tb.aorrawimage_icon:LoadImage(professionalIconList[professional])
    else
        tb.aorrawimage_icon:LoadImage(data.icon2)
    end

    tb.aortext_name.text = GetLangPackValue(data.name)
    if self.suitPosTypeNums[id] and self.suitPosTypeNums[id].num then
        tb.aortext_Num.text = string.format("(%s/%s)", self.suitPosTypeNums[id].num, 4)
