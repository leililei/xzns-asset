function CardShowView_Right_Rune:RefreshLooplistType()
    self.go_table.scrollloophorizontal_selectList:SetActiveE(self.unfoldDropdown and 1 or 0)
    local count = self.runeList and #self.runeList or 0
    self.go_table.scrollloopvectical_runeList:SetActiveE((self.unfoldDropdown or count == 0) and 0 or 1)

    local count = #self.posNodes
    for i = 1, count do
        if CardShowView_Right_Rune.PosToPart[i] == self.selectIndex2 then
            self.posNodes[i].obj_selectNode:SetActiveE(1)
        else
            self.posNodes[i].obj_selectNode:SetActiveE(0)
        end
    end
end

--一键穿戴
function CardShowView_Right_Rune:OneTouchRecom()
    --一键穿戴推荐符文
    if self.isSeedIng then
        --_G.UIManager.GetInstance():ShowTips(GetLangPackValue(90033600002))
        return
    end
    local unlockRune = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Rune)
    if unlockRune == false then
        _G.PopWindowManager:GetInstance():ShowAllTips(1001, _G.GetLangPackValue(90033600008))
        return
    end
    self.isSeedIng = true
    local count = #self.tempCardData.cfg.rune_recommend[1]
    local useDatas = {}
    ---@type table<DecorationPart, table>
    local cardDatas = self.tempCardData.DecorationBar
    for i = 1, count do
        local sid = self.tempCardData.cfg.rune_recommend[1][i]
        local isHas = _G.StorageManager:GetInstance():IsHasEquipment(_G.StorageID.Decoration, sid)
        if isHas then
            ---@type DecorationData[]
            local decorationDatas = _G.StorageManager:GetInstance():GetDatasBySid(_G.StorageID.Decoration, sid)
            ---@type DecorationData
            local maxPowerData = nil
            for i, decorationData in pairs(decorationDatas) do
                if decorationData.cardUid == 0 then
                    if maxPowerData == nil then
                        maxPowerData = decorationData
                    else
                        if decorationData:GetPower() > maxPowerData:GetPower() then
                            maxPowerData = decorationData
                        end
                    end
                end
            end
            if maxPowerData then
                local curCardData = cardDatas[maxPowerData.parts]
                if curCardData and curCardData.decoration and curCardData.decoration.sid == sid and curCardData.decoration:GetPower() >= maxPowerData:GetPower() then
                    --最好的装备
                else
                    table.insert(useDatas, maxPowerData)
                end
            end
        end
    end
    if #useDatas == 0 then
        local unlockRune = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Rune)
        if unlockRune == false then
            _G.PopWindowManager:GetInstance():ShowAllTips(1001, _G.GetLangPackValue(90033600008))
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(1001, _G.GetLangPackValue(90033600007))
        end
        self.isSeedIng = false
        return
    end
    require("DecorationModel"):GetInstance():PutOnDecorations(
            self.tempCardData, useDatas, function(power, offset)
                --require "CommonTipManager".OpenPowerUpView(power, offset)
                _G.Events:GetInstance():Broadcast(_G.eRune.OneClickWear, false, power, offset)
                self:RefreshView()
            end
    )
    self.isSeedIng = false
end

return CardShowView_Right_Rune
