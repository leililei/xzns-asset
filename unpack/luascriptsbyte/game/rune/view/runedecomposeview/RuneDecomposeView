---@class RuneDecomposeView : UIBaseView    中文描述
---@field public go_table RuneDecomposeView_GoTable GoTable
local RuneDecomposeView = _G.BaseClass("RuneDecomposeView", _G.UIBaseView)

---符文的品质
local gradeList = {
    [1] = _G.RuneGradeEnum.bule,
    [2] = _G.RuneGradeEnum.purple,
    [3] = _G.RuneGradeEnum.orange,
    [4] = _G.RuneGradeEnum.red,
    [5] = _G.RuneGradeEnum.color
}

function RuneDecomposeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function RuneDecomposeView:OnCreate(OnChangeCall, cardData)
    self.OnChangeCall = OnChangeCall
    self.cardData = cardData
    self.cacheKey = "Rune_Decompose_List"
    self.select = {}
    self.selectUid = {}
    self:GetSelectRank()
    self:InitGradeItem()
    self:InitSlider()
    self:GetRuneData()
    self:RefreshListView()
end

function RuneDecomposeView:InitSlider()
    self.go_table.aortext_sliderLv.text = _G.GetLangPackValue(32001170403,1)
    self.sliderLv = 1
    local maxLv = require("RuneModel"):GetInstance():GetRuneMaxLv()
    self.go_table.slider_limitLv.maxValue = maxLv
    self.go_table.slider_limitLv.value = maxLv
    self:SliderLvChange(maxLv)
    self.go_table.slider_limitLv.onValueChanged:AddListener(_G.handler(self,self.SliderLvChange))
    _G.SetEventTrigger(self.go_table.slider_limitLv,"onUp",_G.handler(self,self.SliderDragEnd))
end

function RuneDecomposeView:SliderLvChange(value)
    local lv = _G.math.modf(value)
    lv = lv // 10
    if lv * 10 ~= self.sliderLv then
        if lv == 0 then
            self.sliderLv = 1
        else
            self.sliderLv = lv * 10
        end
        self.go_table.aortext_sliderLv.text = _G.GetLangPackValue(32001170403,self.sliderLv)
    end
end

function RuneDecomposeView:SliderDragEnd()
    self.go_table.slider_limitLv.value = self.sliderLv
    self.selectRuneList = _G.table.chooseToArray(self.runeList,function(_, v)
        if v.level <= self.sliderLv then
            return true
        end
        return false
    end)
    self:RefreshListView()
end

function RuneDecomposeView:GetRuneData()
    local decorations = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Decoration)
    self.runeList = {}
    self.selectRuneList = {}
    if not _G.table.isEmptyOrNil(decorations) then
        self.decorationParts = {}
        for _, v in pairs(decorations) do
            if not v.cardUid or v.cardUid == 0 then
                _G.table.insert(self.runeList, v)
            end
        end

        _G.SortList(self.runeList, function(data)
            ---规则1：按照符文品质进行排序，即彩＞红＞橙＞紫＞蓝
            ---规则2：同品质符文按照战力高低进行排序
            return data.Grade, data:GetPower()
        end)
        self.selectRuneList = self.runeList
    end
end

function RuneDecomposeView:RefreshListView()
    for _, v in ipairs(self.runeList) do

        if self.select[v.Grade] and v.level <= self.sliderLv then
            if not v.lock or v.lock == 0 then
                self.selectUid[v.uid] = v
            end
        else

            if self.selectUid[v.uid] then
                self.selectUid[v.uid] = nil
            end
        end
    end

    local count = self.selectRuneList and #self.selectRuneList or 0
    self.go_table.scrollloopvectical_Items:SetActiveE(count > 0 and 1 or 0)
    self.go_table.obj_noRune:SetActiveE(count > 0 and 0 or 1)
    if count > 0 then
        if not self.runeListView then
            self.go_table.scrollloopvectical_Items:InitItemData(count, _G.handler(self, self.RefreshRuneItem))
            self.runeListView = self.go_table.scrollloopvectical_Items
        else
            if self.lastRuneCount ~= count then
                self.runeListView:UpdateCount(count)
            else
                self.runeListView:UpdateAllItem()
            end
        end
    end
    self.lastRuneCount = count
    self:GetDecomposeition()
end

function RuneDecomposeView:RefreshRuneItem(index, obj)
    local data = self.selectRuneList[index + 1]
    local tb = _G.GetAutoGoTable(obj)
    _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickRuneItem, tb, data))
    tb.obj_select:SetActiveE(self.selectUid[data.uid] and 1 or 0)

    tb.obj_node:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        { data.sid },
        tb.obj_node,
        function(tran)
            if _G.IsNil(tb.obj_node) then
                _G.DestroyObject(tran.gameObject)
                return
            end

            tran:ShowLevel(true, data.level)
            tran:ShowSlotLevel(false)
        end
    )
    ---@type UnityEngine.UI.ScrollRect
    local scorll = self.go_table.scrollloopvectical_Items:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect))
    ---设置升级按钮 长按事件
    _G.SetEventTrigger(tb.aorbtn_click, "onDown", _G.handler(self, self.OnDownEvent))
    _G.SetEventTrigger(tb.aorbtn_click, "onDrag", function(s, event)
        scorll:OnDrag(event)
    end)
    _G.SetEventTrigger(tb.aorbtn_click, "onDragEnd", function(s, event)
        scorll:OnEndDrag(event)
    end)
    _G.SetEventTrigger(tb.aorbtn_click, "onDragBegin", function(s, event)
        self.isLongPress = false
        scorll:OnBeginDrag(event)
    end)
    tb.aorbtn_click.LongPress = true
    tb.aorbtn_click.onLongPress = _G.handlerbind(self, self.OnLongPressEvent, data)
end

--按下事件
function RuneDecomposeView:OnDownEvent()
    if self.isLongPress then
        return
    end
    self.isLongPress = true
end

---长按事件
function RuneDecomposeView:OnLongPressEvent(data)
    if self.isLongPress then
        self.isLongPress = false
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RuneTipView.Name,
            data, data.cfg, false, self.cardData, nil, nil, true)
    end
end

function RuneDecomposeView:OnClickRuneItem(_, _, itemGoTable, data)
    if self.selectUid[data.uid] then
        self.selectUid[data.uid] = nil
    else
        if not data.lock or data.lock == 0 then
            self.selectUid[data.uid] = data
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(1020004)
            return
        end
    end
    itemGoTable.obj_select:SetActiveE(self.selectUid[data.uid] and 1 or 0)
    self:GetDecomposeition()
end

function RuneDecomposeView:GetDecomposeition()
    local decomposeMaterial = {}
    local tempMaterial = {}

    local materialList
    local config = _G.ConfigManager.discrete_cfg[116128] or {}
    local maxResetNum = #config
    local rate = _G.ConfigManager.discrete_cfg[116130][1][1] / 10000
    for _, v in pairs(self.selectUid) do
        materialList = v:GetDecomposition()
        if materialList then
            for _, material in pairs(materialList) do
                local sid, num = material[1], material[2]
                if tempMaterial[sid] then
                    tempMaterial[sid] = tempMaterial[sid] + num
                else
                    tempMaterial[sid] = num
                end
            end
        end
        ---洗练的材料返还
        if v.resetNum and v.resetNum > 0 then
            local sid, num = config[1][1], 0
            for i = 1, v.resetNum do
                if config[i] then
                    sid = config[i][1]
                    num = num + config[i][2]
                elseif i > maxResetNum then
                    sid = config[maxResetNum][1]
                    num = num + config[maxResetNum][2]
                end
            end
            if tempMaterial[sid] then
                tempMaterial[sid] = tempMaterial[sid] + _G.Mathf.Floor(num * rate)
            else
                tempMaterial[sid] = _G.Mathf.Floor(num * rate)
            end
        end
    end

    for k, v in pairs(tempMaterial) do
        _G.table.insert(decomposeMaterial, { k, true, v, v, v })
    end
    if _G.table.isEmptyOrNil(decomposeMaterial) then
        self.go_table.obj_consume:SetActiveE(0)
        return
    end
    self.go_table.obj_consume:SetActiveE(1)
    if not self.ResConsume then
        self.ResConsume = self:AddComponent(
            self.go_table.obj_consume,
            require("ConsumeCompont").New(self.go_table.obj_consume, decomposeMaterial, nil, nil, true, AppSetting.IsXzns and {GroupParam=2} or {})
        )
    else
        self.ResConsume:RestRs(decomposeMaterial)
    end
end

---初始化品质item
function RuneDecomposeView:InitGradeItem()
    for i, v in pairs(gradeList) do
        self.go_table["aorimage_" .. i]:SetActiveE(self.select[v] and 1 or 0)
    end
end

function RuneDecomposeView:RefreshGradItem(index)
    if not self.select[gradeList[index]] then
        for i, v in pairs(gradeList) do
            if index >= i and not self.select[v] then
                self:OnChooseGrade(i, v)
            end
        end
    else
        self:OnChooseGrade(index, gradeList[index])
    end
    _G.PlayerPrefsManager.SetTable(self.cacheKey, self.select)
    self:RefreshListView()
end

function RuneDecomposeView:OnChooseGrade(index, grade)
    if self.select[grade] then
        self.go_table["aorimage_" .. index]:SetActiveE(0)
        self.select[grade] = nil
    else
        self.go_table["aorimage_" .. index]:SetActiveE(1)
        self.select[grade] = true
    end
end

---获取缓存的选中品质
function RuneDecomposeView:GetSelectRank()
    self.select = _G.PlayerPrefsManager.GetTable(self.cacheKey) or {}
end

---界面的销毁函数
function RuneDecomposeView:OnDestroy()
end

---分解
function RuneDecomposeView:OnDecompose(uids)
    require("DecorationModel"):GetInstance():Decompose(self.selectUid, uids, function()
        self.selectUid = {}
        self:GetRuneData()
        self:RefreshListView()
        if self.OnChangeCall then
            self.OnChangeCall()
        end
    end)
end

---按钮点击事件在这里派发
function RuneDecomposeView:OnClickBtn(go)
    if go == self.go_table.aorbtn_anyClose then
        self:Close()
    elseif go == self.go_table.aorbtn_1 then
        self:RefreshGradItem(1)
    elseif go == self.go_table.aorbtn_2 then
        self:RefreshGradItem(2)
    elseif go == self.go_table.aorbtn_3 then
        self:RefreshGradItem(3)
    elseif go == self.go_table.aorbtn_4 then
        self:RefreshGradItem(4)
    elseif go == self.go_table.aorbtn_5 then
        self:RefreshGradItem(5)
    elseif go == self.go_table.aorbtn_autoDecompose then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RuneAutoDecomposeSettingView.Name)
    elseif go == self.go_table.aorbtn_Decompose then
        local uids = {}
        local needShowTip = false
        if self.selectUid then
            for uid, v in pairs(self.selectUid) do
                _G.table.insert(uids, uid)
                if not needShowTip and v.Grade >= _G.RuneGradeEnum.orange then
                    needShowTip = true
                end
            end
        end
        if not _G.table.isEmptyOrNil(uids) then
            if needShowTip then
                _G.PopWindowManager:GetInstance():ShowBtnWindowByToggle(
                    1020002,
                    _G.handlerbind(self, self.OnDecompose, uids),
                    nil,
                    _G.handlerbind(self, self.OnDecompose, uids),
                    true
                )
            else
                self:OnDecompose(uids)
            end
        end
    end
end

return RuneDecomposeView
