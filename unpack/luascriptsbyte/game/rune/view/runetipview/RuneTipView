---@class RuneTipView : UIBaseView    中文描述
---@field public go_table RuneTipView_GoTable GoTable
local RuneTipView = _G.BaseClass("RuneTipView", _G.UIBaseView)

---基础属性
local baseAttribute = { "atk", "bre", "def", "max_hp" }
---激活的套装标题
local activeColor = "<color=#60a93b>%s</color>"
local attribute_cfg = _G.ConfigManager.attribute_cfg
---滑动区域最大滑动高度
local ScrollMaxHeight = 750
-- tip中item背景图路径，根据品阶不同
local ItemBgPath = {
    [3] = "ImagesH5/hCommon/ui_img_lanse",
    [4] = "ImagesH5/hCommon/ui_img_zise",
    [5] = "ImagesH5/hCommon/ui_img_chengse",
    [6] = "ImagesH5/hCommon/ui_img_hongse",
    [7] = "ImagesH5/hCommon/ui_img_caise"
}
-- tip中item背景特效，根据品阶不同
local ItemBgEffectPath = {
    [3] = "ef_TipView_lan",
    [4] = "ef_TipView_zi",
    [5] = "ef_TipView_cheng",
    [6] = "ef_TipView_hong",
    [7] = "ef_TipView_chai"
}
-- tip中道具名字的描边颜色
local TipTypeNameOutLineColor = {
    [3] = "0d1b52",
    [4] = "3b0444",
    [5] = "562e0d",
    [6] = "500707",
    [7] = "6f5fb6"
}
-- tip中item名称渐变色(从上到下)，根据品阶不同
local ItemTextGradient = {
    [3] = { "98dffa", "7278f2", 255, 255 },
    [4] = { "fa98de", "c872f2", 255, 255 },
    [5] = { "fca74f", "fd744f", 255, 255 },
    [6] = { "ffab96", "ff0f47", 255, 255 },
    [7] = { "fee4f3", "998bd9", 229, 255 }
}

function RuneTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OpenDialog, self)
end

---界面的入口函数
---@param data DecorationData 符文数据类,不是预览必须要传，要用来做逻辑判断
---@param cfg decoration_cfg 符文配置
---@param isPreview boolean 是否是预览
---@param cardData CardData 卡牌数据类
---@param isSecretRealm boolean 是否是大秘境特殊展示
---@param isInCardView boolean 是否在卡牌养成界面中打开
function RuneTipView:OnCreate(data, cfg, isPreview, cardData, OnChangeCall, isSecretRealm, isHideBtns, isInCardView)
    self.data = data
    self.cfg = cfg
    self.isPreview = isPreview
    self.isSecretRealm = isSecretRealm
    self.isHideBtns = isHideBtns
    self.cardData = cardData
    self.OnChangeCall = OnChangeCall
    self.isInCardView = isInCardView

    self.go_table.scrollHeight = 0
    self:RefreshLeftView()
    self:RefreshRightView()
    _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(
        self.go_table.obj_Content:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform)))
end

---刷新右边界面(弹窗右边是当前点击的tip，左边是当前穿戴的tip）
function RuneTipView:RefreshRightView()
    self:ShowInfo(self.go_table, self.cfg, self.data)
    self:ShowBaseProp(self.go_table, self.cfg, self.data)
    self:ShowEntryProp()
    self:ShowSuitList(self.go_table, self.cfg, self.data)
    self:ShowButton()

    ---修改滑动区域的高度
    self:SetScrollHeight(self.go_table)
end

---初始化切换按钮
function RuneTipView:InitBtn()
    local cur = -1
    self.DecorationBar = {}
    if not self.cardData then
        return
    end
    for _, v in pairs(self.cardData.DecorationBar) do
        if v.decoration then
            local decoration = v.decoration
            if #self.DecorationBar > 0 then
                decoration.pre = self.DecorationBar[#self.DecorationBar].parts
            end
            _G.table.insert(self.DecorationBar, { parts = decoration.parts })
            if decoration.parts == self.cfg.parts then
                cur = #self.DecorationBar
            end
        end
    end
    local amount = #self.DecorationBar
    for i = 1, amount do
        if i + 1 <= amount then
            self.DecorationBar[i].next = self.DecorationBar[i + 1].parts
        end
        if i > 1 then
            self.DecorationBar[i].pre = self.DecorationBar[i - 1].parts
        end
    end
    if amount > 0 then
        self.DecorationBar[1].pre = self.DecorationBar[amount].parts
        self.DecorationBar[amount].next = self.DecorationBar[1].parts
    end
    if cur > 0 and cur <= amount and self.DecorationBar[cur] then
        self.CurDecoration = self.DecorationBar[cur]
    end
    local showBtn = (amount > 1 and self.go_table.obj_leftPanel:GetctiveInHierarchy() == 0) and self.data.cardUid ~= 0 and self.isInCardView
    self.go_table.aorbtn_pre:SetActiveE(showBtn and 1 or 0)
    self.go_table.aorbtn_next:SetActiveE(showBtn and 1 or 0)
end

---刷新左边界面(弹窗右边是当前点击的tip，左边是当前穿戴的tip）
function RuneTipView:RefreshLeftView()
    local showPanel = false
    local decoData
    local slotLevel
    if not self.isPreview and (not self.isHideBtns) and self.data and self.cardData and self.cardData.DecorationBar then
        local DecorationBar = self.cardData.DecorationBar
        decoData = DecorationBar[self.cfg.parts] and DecorationBar[self.cfg.parts].decoration
        if decoData and decoData.uid ~= self.data.uid then
            slotLevel = DecorationBar[self.cfg.parts].slotLevel
            showPanel = true
        end
    end
    self.go_table.obj_leftPanel:SetActiveE(showPanel and 1 or 0)
    if showPanel and decoData then
        self.panelGotable = _G.GetAutoGoTable(self.go_table.obj_leftPanel)
        self.panelGotable.decoData = decoData
        self.panelGotable.scrollHeight = 0
        self.panelGotable.showPanel = true
        self.panelGotable.slotLevel = slotLevel

        ---设置界面信息
        self:ShowInfo(self.panelGotable, decoData.cfg, decoData, true)
        self:ShowBaseProp(self.panelGotable, decoData.cfg, decoData)
        self:ShowLeftEntryProp(self.panelGotable, decoData.cfg)
        self:ShowSuitList(self.panelGotable, decoData.cfg, decoData)

        ---修改滑动区域的高度
        self:SetScrollHeight(self.panelGotable)
    end
end

---设置滑动高度
function RuneTipView:SetScrollHeight(itemGoTable)
    local rootRect = _G.UIUtils.GetRectTrans(itemGoTable.obj_ScrollView)
    local x, _ = rootRect:GetRectTransformSizeDelta()
    rootRect:SetRectTransformSize(x, _G.Mathf.Min(itemGoTable.scrollHeight, ScrollMaxHeight))
    local scrollRect = itemGoTable.obj_ScrollView:GetComponentE(_G.typeof(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect)))
    scrollRect.vertical = itemGoTable.scrollHeight > ScrollMaxHeight
end

---修改滑动高度
function RuneTipView:ChangeScrollHeight(trans, itemGoTable)
    local rect = _G.UIUtils.GetRectTrans(trans)
    local _, y = rect:GetRectTransformSizeDelta()
    itemGoTable.scrollHeight = itemGoTable.scrollHeight + y
end

---切换当前已装备的符文
function RuneTipView:ChangeDecoration(type)
    if type == -1 then
        self.data = self.cardData.DecorationBar[self.CurDecoration.pre].decoration
    elseif type == 1 then
        self.data = self.cardData.DecorationBar[self.CurDecoration.next].decoration
    end
    self.cfg = self.data.cfg
    self.go_table.scrollHeight = 0
    self:RefreshRightView()
end

---设置弹出tip中的物品名称渐变颜色
---@param text AorText 道具名称文本组件
---@param grade number 道具品质
function RuneTipView:SetItemTextGradient(text, grade)
    if grade <= 0 or not ItemTextGradient[grade] then
        return
    end

    local colors = {
        ItemTextGradient[grade][1],
        ItemTextGradient[grade][2]
    }
    local alphas = {
        ItemTextGradient[grade][3],
        ItemTextGradient[grade][4]
    }
    require("CommonTipManager"):GetInstance():SetTextGradient(colors, alphas, text)
end

---设置信息
---@param itemGoTable table
---@param cfg decoration_cfg 符文配置
---@param decoData DecorationData 符文数据类
function RuneTipView:ShowInfo(itemGoTable, cfg, decoData, leftRune)
    itemGoTable.obj_root:RemoveAllChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        { cfg.id },
        itemGoTable.obj_root,
        function(tran)
            if self:IsNil() then
                _G.DestroyObject(tran.gameObject)
                return
            end

            local slotLv = 0
            if self.isPreview then
                ---预览显示固定的等级
                slotLv = cfg.level[2]
            else
                if self.panelGotable and self.panelGotable.slotLevel then
                    slotLv = self.panelGotable.slotLevel or 0
                else
                    if decoData and decoData.cardUid ~= 0 then
                        slotLv = decoData:GetSlotStrenLv()
                    end
                end
            end
            tran:ShowSlotLevel(slotLv ~= 0, slotLv)
            itemGoTable.itemLua = tran
        end,
        function()
        end
    )

    itemGoTable.aortext_name.text = _G.GetLangPackValue(cfg.name)
    ---名字描边
    itemGoTable.aortext_name:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = _G.ColorTools.FormatColorByString(TipTypeNameOutLineColor[cfg.grade])
    self:SetItemTextGradient(itemGoTable.aortext_name, cfg.grade)
    if self.isPreview and not decoData then
        ---预览显示固定的等级
        local level = cfg.level[1]
        itemGoTable.aortext_level.text = _G.GetLangPackValue(90032800017, level or 1)
    else
        itemGoTable.aortext_level.text = _G.GetLangPackValue(90032800017, decoData and decoData.level or 1)
    end

    if self.isSecretRealm then
        itemGoTable.aortext_level.text = ""
    end

    itemGoTable.aorimage_pro.SpriteName = _G.ProfessionalIcon[cfg.Professional]
    ---背景框
    itemGoTable.aorrawimage_bg:LoadImage(ItemBgPath[cfg.grade])
    ---边框特效
    local effectPath = ItemBgEffectPath[cfg.grade]
    itemGoTable.obj_effect:RemoveAllChildren()
    if effectPath then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[effectPath],
            itemGoTable.obj_effect,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                --itemGoTable.bgEffect = trans
            end
        )
    end

    itemGoTable.aortext_power:SetActiveE(self.isPreview and not decoData and 0 or 1)
    itemGoTable.aorimage_lock:SetActiveE((leftRune or self.isPreview) and 0 or 1)
    if itemGoTable.aorimage_up then
        itemGoTable.aorimage_up:SetActiveE(self.panelGotable and 1 or 0)
    end
    if not self.isPreview and decoData then
        local power = decoData:GetPower()
        if not self.cardData or decoData.cardUid ~= 0 and self.cardData.uid == decoData.cardUid or leftRune then
            power = _G.string.format("<color=#72c946>%s</color>", power)
        else
            local DecorationBar = self.cardData.DecorationBar
            local cardDecoData = DecorationBar[cfg.parts].decoration
            local upPath
            if not cardDecoData or decoData:GetPower() >= cardDecoData:GetPower() then
                power = _G.string.format("<color=#72c946>%s</color>", power)
                upPath = "0ui_icon_shangsheng"
            else
                power = _G.string.format("<color=#E33F3f>%s</color>", power)
                upPath = "0ui_icon_xiajiang"
            end

            if itemGoTable.aorimage_up then
                if not upPath then
                    itemGoTable.aorimage_up:SetActiveE(0)
                else
                    itemGoTable.aorimage_up.SpriteName = upPath
                end
            end
        end
        itemGoTable.aortext_power.text = _G.GetLangPackValue(90000010923, power)
    else
        local power1 = decoData and decoData:GetPower() or 0
        itemGoTable.aortext_power.text = _G.GetLangPackValue(90000010923, power1)
    end
    self:ShowLockStatus()
end

---上锁状态
function RuneTipView:ShowLockStatus()
    if not self.isPreview and self.data then
        self.go_table.aorimage_lock.SpriteName = self.data.lock == 1 and "ui_zb_icon_suo_02" or "ui_icon_ks"
    end
end

---基础属性(附加属性)
---@param itemGoTable table
---@param cfg decoration_cfg 符文配置
---@param decoData DecorationData 符文数据类
function RuneTipView:ShowBaseProp(itemGoTable, cfg, decoData)
    local list = {}
    for _, v in ipairs(baseAttribute) do
        if cfg[v] and cfg[v] > 0 then
            _G.table.insert(list, { key = v, value = cfg[v] })
        end
    end
    if _G.table.isEmptyOrNil(list) then
        itemGoTable.obj_prop:SetActiveE(0)
        return
    end

    self:ChangeScrollHeight(itemGoTable.obj_prop, itemGoTable)
    if not itemGoTable.propItemList then
        itemGoTable.propItemList = {}
    else
        for _, v in ipairs(itemGoTable.propItemList) do
            v.gameObject:SetActiveE(0)
        end
    end

    ---属性加成倍率
    local rate = 1
    if not self.isPreview and decoData then
        local slotLevel = 0
        if self.panelGotable and self.panelGotable.slotLevel then
            slotLevel = self.panelGotable.slotLevel or 0
        else
            if self.cardData then
                local dData = self.cardData.DecorationBar[cfg.parts]
                if dData and dData.decoration and dData.decoration.uid == decoData.uid then
                    slotLevel = dData and dData.slotLevel
                end
            end
        end
        rate = decoData:GetPropRate(slotLevel)
    end
    local obj, tb
    for i, v in ipairs(list) do
        if not itemGoTable.propItemList[i] then
            obj = _G.InstantiateObject(itemGoTable.obj_propItem, itemGoTable.obj_propGrid)
            tb = _G.GetAutoGoTable(obj)
            itemGoTable.propItemList[i] = tb
        else
            tb = itemGoTable.propItemList[i]
        end
        tb.gameObject:SetActiveE(1)
        tb.aortext_propName.text = _G.AttrType[v.key].des
        if self.isPreview and not self.data then
            tb.aortext_propNum.text = _G.GameUtil.NumberWY(v.value)
        else
            local value = _G.Mathf.RoundToInt(v.value * rate)
            tb.aortext_propNum.text = _G.GameUtil.NumberWY(value)
        end
    end
    _G.GameUtil.ReBuildRTF(itemGoTable.obj_prop)
end

---词条属性
function RuneTipView:ShowEntryProp()
    if not self.cfg.num_addition or self.cfg.num_addition <= 0 then
        self.go_table.obj_entryprop:SetActiveE(0)
        return
    end

    if self.isSecretRealm then
        self.go_table.obj_entryprop:SetActiveE(0)
        return
    end
    if not self.entryListView then
        self.go_table.scrollloopvectical_entry:InitItemData(self.cfg.num_addition,
            _G.handler(self, self.RefreshEntryItem))
        self.entryListView = self.go_table.scrollloopvectical_entry
    else
        self.entryListView:UpdateCount(self.cfg.num_addition)
        self.entryListView:UpdateAllItem()
    end
    self.entryListView:UpdateScrollRectHeight(self.cfg.num_addition * 48)
    local rect = _G.UIUtils.GetRectTrans(self.go_table.obj_entryprop)
    local x = 390
    local y = 95
    --local x, y = rect:GetRectTransformSizeDelta()
    rect:SetRectTransformSize(x, y + (self.cfg.num_addition - 1) * 48)
    self:ChangeScrollHeight(self.go_table.obj_entryprop, self.go_table)
end

function RuneTipView:RefreshEntryItem(index, obj)
    local tb = _G.GetAutoGoTable(obj)
    if self.isPreview or not self.data then
        tb.slider_prop.value = 0
        tb.aortext_name.text = _G.GetLangPackValue(90032800018)
        tb.aortext_num.text = ""
    else
        local name, num, max = self.data:GetTxtArea(index + 1)
        tb.aortext_name.text = _G.GetLangPackValue(name)
        tb.aortext_num.text = self:formatValue(num / 100)
        tb.slider_prop.value = num / max
    end
end

---左边面板的词条属性
---@param itemGoTable table
---@param cfg decoration_cfg 符文配置
function RuneTipView:ShowLeftEntryProp(itemGoTable, cfg)
    if not cfg.num_addition or cfg.num_addition <= 0 then
        itemGoTable.obj_entryprop:SetActiveE(0)
        return
    end

    if not itemGoTable.entryListView then
        itemGoTable.scrollloopvectical_entry:InitItemData(cfg.num_addition,
            _G.handler(self, self.RefreshLeftEntryItem))
        itemGoTable.entryListView = itemGoTable.scrollloopvectical_entry
    else
        itemGoTable.entryListView:UpdateAllItem()
    end
    itemGoTable.entryListView:UpdateScrollRectHeight(cfg.num_addition * 48)
    local rect = _G.UIUtils.GetRectTrans(itemGoTable.obj_entryprop)
    local x, y = rect:GetRectTransformSizeDelta()
    rect:SetRectTransformSize(x, y + (cfg.num_addition - 1) * 48)
    self:ChangeScrollHeight(itemGoTable.obj_entryprop, itemGoTable)
end

function RuneTipView:RefreshLeftEntryItem(index, obj)
    local tb = _G.GetAutoGoTable(obj)
    if self.isPreview and not self.panelGotable then
        tb.slider_prop.value = 0
        tb.aortext_name.text = _G.GetLangPackValue(90032800018)
        tb.aortext_num.text = ""
    else
        local name, num, max = self.panelGotable.decoData:GetTxtArea(index + 1)
        tb.aortext_name.text = _G.GetLangPackValue(name)
        tb.aortext_num.text = self:formatValue(num / 100)
        tb.slider_prop.value = num / max
    end
end

function RuneTipView:formatValue(value)
    local str = _G.string.format("+%.1f%%", value)
    return _G.string.match(str, "^(.-)%.?0*$")
end

---是否拥有该套装部位
function RuneTipView:HaveSuitPart(parts, decoData)
    if self.isPreview then
        return true
    end
    local bar = self.cardData and self.cardData.DecorationBar
    if not bar or not bar[parts] or not bar[parts].decoration then
        return false
    end
    if decoData then
        return bar[parts].decoration.suit == decoData.suit
    end
    return bar[parts].decoration.suit == self.cfg.suit
end

---套装列表
---@param itemGoTable table
---@param decorationCfg decoration_cfg 符文配置
---@param decoData DecorationData 符文数据类
function RuneTipView:ShowSuitList(itemGoTable, decorationCfg, decoData)
    local cfg = _G.ConfigManager.decoration_suit_cfg[decorationCfg.suit]
    ---和策划确认的规则：套装必现配att_suit2字段，没有配的都当做散件处理
    if cfg and not _G.table.isEmptyOrNil(cfg.att_suit2) then
        itemGoTable.obj_suitList:SetActiveE(1)
        itemGoTable.obj_suitEffect:SetActiveE(1)
        local suitName = _G.GetLangPackValue(cfg.name)
        if self.isPreview then
            ---预览固定显示当前选中的那条
            itemGoTable.aortext_suitTitle.text = suitName .. " (4/4)"
        elseif not decoData then
            itemGoTable.aortext_suitTitle.text = suitName .. " (0/4)"
        else
            local suitNum = require("RuneModel"):GetInstance():GetSuitNum(self.cardData, decoData)
            itemGoTable.aortext_suitTitle.text = suitName .. _G.string.format(" (%d/4)", suitNum)
        end
        itemGoTable.aorrawimage_suitFlag:LoadImage(cfg.icon)
        local suitName2 = cfg.name2
        for i = 1, 4 do
            if (self.isPreview and i == decorationCfg.parts) or self:HaveSuitPart(i, decoData) then
                itemGoTable["aortext_suitName" .. i].text = _G.string.format(activeColor,
                    _G.GetLangPackValue(suitName2[i]))
            else
                itemGoTable["aortext_suitName" .. i].text = _G.GetLangPackValue(suitName2[i])
            end
        end
        self:ShowSuitEffect(cfg.att_suit2, itemGoTable, decoData)
        self:ChangeScrollHeight(itemGoTable.obj_suitList, itemGoTable)
        self:ChangeScrollHeight(itemGoTable.obj_suitEffect, itemGoTable)
    else
        itemGoTable.obj_suitList:SetActiveE(0)
        itemGoTable.obj_suitEffect:SetActiveE(0)
    end
end

---套装效果
function RuneTipView:ShowSuitEffect(suit, itemGoTable, decoData)
    local obj
    local suitNum = require("RuneModel"):GetInstance():GetSuitNum(self.cardData, decoData)
    itemGoTable.obj_suitEffect:RemoveAllChildren()
    for _, v in ipairs(suit) do
        obj = _G.InstantiateObject(itemGoTable.obj_suitEffectItem, itemGoTable.obj_suitEffect)
        obj:SetActiveE(1)
        local tb = _G.GetAutoGoTable(obj)
        tb.aortext_suitIndex.text = _G.GetLangPackValue(90032800022, v[1])

        if attribute_cfg[v[2]] then
            if suitNum >= v[1] or self.isPreview then
                tb.aortext_desc.text = _G.string.format("<color=#60a93b>%s</color>",
                    _G.GetLangPackValue(attribute_cfg[v[2]].describe))
            else
                tb.aortext_desc.text = _G.GetLangPackValue(attribute_cfg[v[2]].describe)
            end
        else
            tb.aortext_desc.text = ""
        end
        _G.GameUtil.ReBuildRTF(tb.aortext_desc)
        _G.GameUtil.ReBuildRTF(obj)
    end
    _G.GameUtil.ReBuildRTF(itemGoTable.obj_suitEffect)
end

---按钮
function RuneTipView:ShowButton()
    self.go_table.obj_button:SetActiveE((self.isPreview or self.isHideBtns) and 0 or 1)
    self.go_table.aorbtn_lock:SetActiveE(self.isHideBtns and 0 or 1)
    if self.isPreview or self.isHideBtns then
        return
    end
    self:InitBtn()
    if self.panelGotable and self.panelGotable.showPanel then
        self.go_table.aorbtn_wear:SetActiveE(1)
        self.go_table.aorbtn_replace:SetActiveE(0)
        self.go_table.aorbtn_remove:SetActiveE(0)
        self.go_table.aorbtn_build:SetActiveE(0)
        self.go_table.aorbtn_destroy:SetActiveE(1)
        return
    end
    if not self.cardData then
        -- 没有穿戴指定对象
        self.go_table.aorbtn_wear:SetActiveE(0)
        self.go_table.aorbtn_replace:SetActiveE(0)
        self.go_table.aorbtn_remove:SetActiveE(0)
        self.go_table.aorbtn_build:SetActiveE(0)
        self.go_table.aorbtn_destroy:SetActiveE(1)
    elseif not self.data.cardUid or self.data.cardUid == 0 then
        ---当前符文未穿戴
        local parts = self.data.parts
        local decorationBar = self.cardData and self.cardData.DecorationBar or {}
        local isWear = decorationBar[parts] and not _G.table.isEmptyOrNil(decorationBar[parts].decoration)
        self.go_table.aorbtn_wear:SetActiveE(isWear and 0 or 1)
        self.go_table.aorbtn_replace:SetActiveE(isWear and 1 or 0)
        self.go_table.aorbtn_remove:SetActiveE(0)
        self.go_table.aorbtn_build:SetActiveE(0)
        self.go_table.aorbtn_destroy:SetActiveE(1)
    elseif self.isInCardView then
        -- 符文已穿戴，并且在卡牌养成中打开
        self.go_table.aorbtn_wear:SetActiveE(0)
        self.go_table.aorbtn_replace:SetActiveE(1)
        ---如果是自己穿戴的显示卸下和强化
        self.go_table.aorbtn_remove:SetActiveE(1)
        self.go_table.aorbtn_build:SetActiveE(1)
        self.go_table.aorbtn_destroy:SetActiveE(0)
        self:ShowStrenMaterial()
    else
        -- 在除了卡牌养成界面打开，不显示养成相关按钮
        self.go_table.obj_button:SetActiveE(0)
    end
    -- 判断当前槽位等级，如果到达最高级，则隐藏强化按钮
    local slotLevtl = self.CurDecoration and self.cardData.DecorationBar[self.CurDecoration.parts].slotLevel or nil
    if slotLevtl and require("RuneModel"):GetInstance():CheckIsRuneMaxLevel(slotLevtl) then
        self.go_table.aorbtn_build:SetActiveE(0)
    end
end

---强化材料
function RuneTipView:ShowStrenMaterial()
    local data = self.cardData.DecorationBar[self.cfg.parts]
    local id, num = require("RuneModel"):GetInstance():GetStrenMaterial(data.slotLevel or 0)
    self.go_table.aorrawimage_icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(id))

    local _, storageId = _G.StorageManager:GetInstance():CheckSidType(id)
    local haveCount = _G.StorageManager:GetInstance():GetItemCountByID(storageId, id)
    if haveCount >= num then
        self.go_table.aortext_materialNum.text = _G.string.format("<color=#96CE51>%s</color>/%s", haveCount, num)
    else
        self.go_table.aortext_materialNum.text = _G.string.format("<color=#E33F3f>%s</color>/%s", haveCount, num)
    end
end

function RuneTipView:OpenDialog(name)
    if name == _G.ConfigManager.ui_cfg.OptionDialogByToggleView.Name then
        ---@type OptionDialogByToggleView
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.OptionDialogByToggleView.Name)
        if view and (view.id == 1020002 or view.id == 1020011) then
            local param = {}
            local materialList, tempMaterial
            tempMaterial = {}
            materialList = self.data:GetDecomposition()
            if materialList then
                for _, material in pairs(materialList) do
                    local sid, num = material[1], material[2]
                    if tempMaterial[sid] then
                        tempMaterial[sid] = tempMaterial[sid] + num
                    else
                        tempMaterial[sid] = num
                    end
                end
            end
            for k, v in pairs(tempMaterial) do
                _G.table.insert(param, { content = v, sid = k })
            end
            view:ShowDown(param)
        end
    end
end

---界面的销毁函数
function RuneTipView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OpenDialog, self)
end

---按钮点击事件在这里派发
function RuneTipView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.aorbtn_destroy then
        if self.data.lock == 1 then
            _G.PopWindowManager:GetInstance():ShowAllTips(1020004)
            return
        end
        local func = function()
            require("DecorationModel"):GetInstance():Decompose(
                { [self.data.uid] = { sid = self.data.sid } },
                { self.data.uid },
                function()
                    if self.OnChangeCall then
                        self.OnChangeCall(false, 0, 0)
                    end
                    self:Close()
                end)
        end
        _G.PopWindowManager:GetInstance():ShowBtnWindowByToggle(self.data.Grade >= 5 and 1020002 or 1020011, func, nil, func, true)
    elseif go == self.go_table.aorbtn_wear then
        ---穿戴
        require("DecorationModel"):GetInstance():PutOnDecoration(
            self.cardData, self.cfg.parts, self.data, function(power, offset)
                self:Close()
                if self.OnChangeCall then
                    self.OnChangeCall(false, power, offset)
                end
            end
        )
    elseif go == self.go_table.aorbtn_remove then
        ---拆卸
        local decoData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Decoration, self.data.uid)
        require("DecorationModel"):GetInstance():TakeOffDecoration(
            self.cardData, self.cfg.parts, decoData, function()
                self:Close()
                if self.OnChangeCall then
                    self.OnChangeCall()
                end
            end
        )
    elseif go == self.go_table.aorbtn_replace then
        --替换时需要传卡牌身上的数据
        if self.data.cardUid == 0 or self.data.cardUid ~= self.cardData.uid then
            local decoData = self.cardData.DecorationBar[self.cfg.parts]
            if decoData and decoData.decoration then
                decoData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Decoration, decoData.decoration
                                                                                                          .uid)
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.RuneSubstituteView.Name,
                    self.cardData,
                    decoData,
                    self.OnChangeCall
                )
            end
        else
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.RuneSubstituteView.Name,
                self.cardData,
                self.data,
                self.OnChangeCall
            )
        end
        self:Close()
    elseif go == self.go_table.aorbtn_build then
        --强化
        if not self.cardData or not self.data then
            return
        end

        local data = self.cardData.DecorationBar[self.cfg.parts]
        if _G.table.isEmptyOrNil(data) then
            return
        end
        local canStren = require("RuneModel"):GetInstance():CheckCanStrength(self.cardData, data.slotLevel)
        if not canStren then
            if require("RuneModel"):GetInstance():CheckIsRuneMaxLevel(data.slotLevel) then
                _G.PopWindowManager:GetInstance():ShowAllTips(1020008)
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(1020012)
            end
            return
        end

        local id, num = require("RuneModel"):GetInstance():GetStrenMaterial(data.slotLevel or 1)
        if not _G.StorageManager:GetInstance():CheckItemNew(id, num) then
            self:Close()
            return
        end
        self.go_table.aorrawimage_icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(id))

        local slot = { { k = self.cfg.parts, v = data.slotLevel + 1 } }
        require("DecorationModel"):GetInstance():DecorationUp(self.cardData, slot, { { id, num } }, function()
            if self.go_table.itemLua then
                self.go_table.itemLua:ShowSlotLevel(true, data.slotLevel)
            end
            self:ShowBaseProp(self.go_table, self.cfg, self.data)
            self:ShowStrenMaterial()
            if self.OnChangeCall then
                self.OnChangeCall(true)
            end
        end)
    elseif go == self.go_table.aorbtn_lock then
        --上锁
        local type = self.data.lock == 0 and 1 or 0
        require("DecorationModel"):GetInstance():Lock(self.cardData, self.data, type, function()
            self:ShowLockStatus()
        end)
    elseif go == self.go_table.aorbtn_pre then
        if self.CurDecoration.pre then
            self:ChangeDecoration(-1)
        end
    elseif go == self.go_table.aorbtn_next then
        if self.CurDecoration.next then
            self:ChangeDecoration(1)
        end
    end
end

return RuneTipView
