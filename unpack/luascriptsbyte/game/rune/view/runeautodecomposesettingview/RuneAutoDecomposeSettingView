---@class RuneAutoDecomposeSettingView : UIBaseView	中文描述
---@field public go_table RuneAutoDecomposeSettingView_GoTable GoTable
local RuneAutoDecomposeSettingView = _G.BaseClass("RuneAutoDecomposeSettingView", _G.UIBaseView)

function RuneAutoDecomposeSettingView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function RuneAutoDecomposeSettingView:OnCreate()
    self.setting = _G.PlayerPrefsManager.GetTable(_G.PlayerPrefsKey.RuneAutoDecompose)
    if not self.setting or _G.TableIsEmpty(self.setting) then
        self.setting = {
            [3] = false,
            [4] = false,
            [5] = false,
            [6] = false
        }
    end
    self:InitView()
end

function RuneAutoDecomposeSettingView:InitView()
    for k, v in pairs(self.setting) do
        self.go_table["aorimage_" .. k]:SetActiveE(v and 1 or 0)
    end
end

function RuneAutoDecomposeSettingView:RefreshGradItem(index)
    if self.setting[index] then
        self.go_table["aorimage_" .. index]:SetActiveE(0)
        self.setting[index] = false
        return
    end
    -- 蓝色品质为3
    for i = 3, index do
        self.go_table["aorimage_" .. i]:SetActiveE(1)
        self.setting[i] = true
    end
end

---保存设置
function RuneAutoDecomposeSettingView:SaveSetting()
    _G.PlayerPrefsManager.SetTable(_G.PlayerPrefsKey.RuneAutoDecompose,self.setting)
end

---按钮点击事件在这里派发
function RuneAutoDecomposeSettingView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_closeView then
        self:Close()
    elseif go == self.go_table.aorbtn_3 then
        self:RefreshGradItem(3)
    elseif go == self.go_table.aorbtn_4 then
        self:RefreshGradItem(4)
    elseif go == self.go_table.aorbtn_5 then
        self:RefreshGradItem(5)
    elseif go == self.go_table.aorbtn_6 then
        self:RefreshGradItem(6)
    elseif go == self.go_table.aorbtn_save then
        self:SaveSetting()
        self:Close()
    end
end

return RuneAutoDecomposeSettingView