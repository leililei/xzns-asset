local SpoilsModel = require "SpoilsModel"

local base = require "EventViewBase"
---@class RuneDecorationUpView : UIBaseView    升星界面
---@field public go_table RuneDecorationUpView_GoTable GoTable
local RuneDecorationUpView = _G.BaseClass("RuneDecorationUpView", base)

function RuneDecorationUpView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function RuneDecorationUpView:OnCreate(cardData, oldattr, closeCall)
    self.cardData = cardData
    self.oldattr = oldattr
    self.closeCall = closeCall
    self:RefreshWearItem()
    self:ShowProp()

    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_shengxingchenggong,
        self.go_table.obj_Eff,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
        end
    )
end

---获得父物体画布
---@param obj UnityEngine.GameObject 子物体
function RuneDecorationUpView:GetParentCanvas(obj)
    local canvas = obj:GetComponentInParentE(_G.typeof(_G.Canvas))
    if not canvas.overrideSorting then
        return self:GetParentCanvas(canvas.transform)
    else
        return canvas
    end
end

---按钮点击事件在这里派发
function RuneDecorationUpView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
    	---关闭界面的时候刷一次红点
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RuneStrength.id, self.cardData.uid)
        ---关闭按钮
        self:Close()
        if self.closeCall then 
            self.closeCall()
        end
    end
end

function RuneDecorationUpView:ShowProp(data)
    local arrribute = self.cardData:GetDecorationProp()
    self.propList = {}

    local prop = { "atk", "max_hp", "bre", "def" }
    for _, v in ipairs(prop) do
        if _G.AttrType[v] then
            _G.table.insert(
                self.propList,
                {
                    name = _G.AttrType[v].des,
                    value = arrribute.attriOther[v],
                    oldvalue = self.oldattr.attriOther[v]
                }
            )
        end
    end

    for _, v in ipairs(self.propList) do
        local tran = _G.InstantiateObject(self.go_table.obj_BaseProp, self.go_table.obj_PropContent)
        if tran then
            local tb = _G.GetAutoGoTable(tran)
            tb.aortext_Name.text = v.name
            tb.aortext_oldValue.text = v.oldvalue
            tb.aortext_curValue.text = v.value
            tb.aortext_curValue.color = require "CardInfoManager".GetColorFromRGB("5ba4bd")
            tran:SetActiveE(1)
        end
    end
end

---刷新穿戴的item
function RuneDecorationUpView:RefreshWearItem()
    
    if not self.wearItemList then 
        self.wearItemList = {}
        local tb
        for i = 1, 4 do
            tb = _G.GetAutoGoTable(self.go_table["obj_wearItem" .. i])
            tb.aorimage_icon.SpriteName = _G.RunePartsEnum[i]
            self.wearItemList[i] = tb
        end
    end
    if self.cardData.DecorationBar then
        for part, v in pairs(self.cardData.DecorationBar) do
            self.wearItemList[part].obj_root:ClearChildren()
            if v and not _G.table.isEmptyOrNil(v.decoration) then
                self.wearItemList[part].obj_empty:SetActiveE(0)

                _G.StorageManager:GetInstance():GetItemBaseViewNew(
                    { v.decoration.cfg.id },
                    self.wearItemList[part].obj_root,
                    function(tran)
                        if _G.IsNil(self.wearItemList[part].obj_root) then
                            _G.DestroyObject(tran.gameObject)
                            return
                        end
                        tran:ShowLevel(true)
                        tran:ShowSlotLevel(v.slotLevel and v.slotLevel > 0, v.slotLevel)
                    end,
                    function()
                        _G.UIManager:GetInstance():OpenWindow(
                            _G.ConfigManager.ui_cfg.RuneTipView.Name,
                            v.decoration,
                            v.decoration.cfg,
                            false,
                            self.cardData,
                            _G.handler(self, self.OnChangeCall),
                            false,
                            false,
                            true
                        )
                    end,
                    v.decoration.uid
                )
            else
                self.wearItemList[part].obj_empty:SetActiveE(1)
            end
        end
    end
end

return RuneDecorationUpView
