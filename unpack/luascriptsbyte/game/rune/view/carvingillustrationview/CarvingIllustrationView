---@class CarvingIllustrationView : UIBaseView	中文描述
---@field public go_table CarvingIllustrationView_GoTable GoTable
local CarvingIllustrationView = _G.BaseClass("CarvingIllustrationView", _G.UIBaseView)

function CarvingIllustrationView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.looplist2_list:InitListView(0, _G.handler(self, self.RefreshListItem))
end

---界面的入口函数
function CarvingIllustrationView:OnCreate()
    self.profBtns = {
        self.go_table.aorbtn_pTK, --1
        self.go_table.aorbtn_pZS, --2
        self.go_table.aorbtn_pFS, --3
        self.go_table.aorbtn_pFZ, --4
        self.go_table.aorbtn_pYX  --5
    }
    self.profBtnRedPoint = {
        [_G.PlayerTreeID.tank] = self.go_table.obj_tkredpoint,
        [_G.PlayerTreeID.warrior] = self.go_table.obj_zsredpoint,
        [_G.PlayerTreeID.master] = self.go_table.obj_fsredpoint,
        [_G.PlayerTreeID.support] = self.go_table.obj_fzredpoint,
        [_G.PlayerTreeID.ranger] = self.go_table.obj_yxredpoint
    }
    self:GetData()
    _G.GameUtil.ReBuildRTF(self.go_table.obj_prof)

    for i = 1, 4 do
            self:ChangeByProf(i)
    end

    self:InitBtnRedpoint()
end

---初始化页签红点
function CarvingIllustrationView:InitBtnRedpoint()
    self.proRedPointNum = {}
    for pro, obj in pairs(self.profBtnRedPoint) do
        if not self.proRedPointNum[pro] then
            self.proRedPointNum[pro] = 0
        end
        if self.carvingPrefList[pro] then
            for id, _ in pairs(self.carvingPrefList[pro]) do
                local unlock, isAward = require("CarvingIllustrationModel"):GetInstance():IsUnlockIll(id)
                if unlock and not isAward then
                    self.proRedPointNum[pro] = self.proRedPointNum[pro] + 1
                end
            end
            obj:SetActiveE(self.proRedPointNum[pro] > 0 and 1 or 0)
        else
            obj:SetActiveE(0)
        end
    end
end

function CarvingIllustrationView:RefreshBtnRedPoint(pro)
    if not self.proRedPointNum[pro] then
        self.proRedPointNum[pro] = 0
    end
    if self.proRedPointNum[pro] > 0 then
        self.proRedPointNum[pro] = self.proRedPointNum[pro] - 1
    end
    self.profBtnRedPoint[pro]:SetActiveE(self.proRedPointNum[pro] > 0 and 1 or 0)
end

---获取数据
function CarvingIllustrationView:GetData()
    ---@type carving_cfg 符文的配置数据<parts, carving_cfg>
    self.allCarvingCfgList = {}
    ---@type table 符文的配置数据<parts, id>
    self.carvingPrefList = {}
    
    local cfg = _G.ConfigManager.carving_cfg
    for _, v in pairs(cfg) do
            if not self.allCarvingCfgList[v.parts] then
                self.allCarvingCfgList[v.parts] = {}
            end
            
            _G.table.insert(self.allCarvingCfgList[v.parts], v)

            if not self.carvingPrefList[v.parts] then
                self.carvingPrefList[v.parts] = {}
            end
            self.carvingPrefList[v.parts][v.id] = 1
    end

    ---套装内不同职业按品质排序
    for _, v in pairs(self.allCarvingCfgList) do
        for _, cfgs in pairs(v) do
            _G.SortList(cfgs, function(item)
                return item.grade, -item.parts
            end)
        end
    end
end

--初始化item
function CarvingIllustrationView:RefreshListItem(listView2, index)
    if index < 0 then
        return
    end
    local t_index = index + 1
    local item = listView2:NewListViewItem("$_obj_item")
    item:SetActiveE(1)

    self:SetItem(item, t_index)
    return item
end

function CarvingIllustrationView:SetItem(go, t_index)
    local item
    if not item then
        item = _G.GetAutoGoTable(go)
    end

    local v = self.allCarvingCfgList[self.curIndex][t_index]
    
    item.aorbtn_click.onClick:RemoveAllListeners()
    item.aorbtn_click.onClick:AddListener(
        _G.handlerbind(self, self.OnClickItem, item.aorbtn_click, v)
    )

    local unlock, isAward = require("CarvingIllustrationModel"):GetInstance():IsUnlockIll(v.id)
    item.aorimage_rank.SpriteName = _G.CarvingRankEnum[v.grade]
    item.aorimage_rank:SetGray(not unlock)
    item.aorrawimage_icon:LoadImage(
        v.icon,
        function(img)
            if self:IsNil() then
                return
            end
            img:SetGray(not unlock)
        end
    )

    item.obj_award:SetActiveE(unlock and not isAward and 1 or 0)
    if unlock and not isAward then
        ---默认显示第一个奖励
        local sid = v.reward[1] and v.reward[1][1]
        if sid then
            item.aorrawimage_award:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(sid))
        end
    end
    _G.GameUtil.ReBuildRTF(go.gameObject)
end

function CarvingIllustrationView:OnClickItem(go, cfg)
    local unlock, isAward = require("CarvingIllustrationModel"):GetInstance():IsUnlockIll(cfg.id)
    if unlock and not isAward then
        require("CarvingModel"):GetInstance():GetIllAward({ cfg.id }, function()
            self:ChangeByProf(self.curIndex, true)
            self:RefreshBtnRedPoint(cfg.Professional)
        end)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CarvingTipView.Name, nil, cfg, true)
    end
end

---刷新
function CarvingIllustrationView:ChangeByProf(index, forceUpdate)
    if (not index or (self.curIndex and index == self.curIndex)) and not forceUpdate then
        return
    end

    self.curIndex = index
    self.go_table.trans_pChoose:SetPositionByTarget(self.profBtns[index])
    local list = self.allCarvingCfgList[self.curIndex] or {}
    local IsEnd = false

        for i, v in ipairs(list) do
            local unlock, isAward = require("CarvingIllustrationModel"):GetInstance():IsUnlockIll(v.id)
            if unlock and not isAward then
                IsEnd = true
            end
        end

    local count = #list
    if not self.lastItemCount or self.lastItemCount ~= count then
        self.go_table.looplist2_list:SetListItemCount(#list)
    else
        self.go_table.looplist2_list:RefreshAllShownItem()
    end
    self.lastItemCount = count
end

---界面的销毁函数
function CarvingIllustrationView:OnDestroy()
end

---按钮点击事件在这里派发
function CarvingIllustrationView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close2 or go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_pTK then
        self:ChangeByProf(_G.CardProfType.Tank)
    elseif go == self.go_table.aorbtn_pZS then
        self:ChangeByProf(_G.CardProfType.Warrior)
    elseif go == self.go_table.aorbtn_pYX then
        self:ChangeByProf(_G.CardProfType.Ranger)
    elseif go == self.go_table.aorbtn_pFS then
        self:ChangeByProf(_G.CardProfType.Master)
    elseif go == self.go_table.aorbtn_pFZ then
        self:ChangeByProf(_G.CardProfType.Support)
    end
end

return CarvingIllustrationView
