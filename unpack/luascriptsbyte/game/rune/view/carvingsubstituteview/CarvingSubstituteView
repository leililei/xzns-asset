---@class CarvingSubstituteView : UIBaseView	中文描述
---@field public go_table CarvingSubstituteView_GoTable GoTable
local CarvingSubstituteView = _G.BaseClass("CarvingSubstituteView", _G.UIBaseView)

function CarvingSubstituteView:Awake()
    self.UiDic = {
        txt = {
            zl = _G.LangUtil.GetLangPackValue(90020400042),
            wcdzb = _G.LangUtil.GetLangPackValue(90032800040)
        }
    }
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param cardData CardData 卡牌数据
---@param carving CarvingData 符文数据类
function CarvingSubstituteView:OnCreate(cardData, carving, OnChangeCall)
    self.cardData = cardData
    self.carving = carving
    self.OnChangeCall = OnChangeCall
    local part = carving.parts
    if _G.table.isEmptyOrNil(cardData.CarvingBar[part]) then
        self.go_table.aortext_no:SetActiveE(1)
    else
        self.go_table.aortext_no:SetActiveE(0)
        ---没生成对象
        if self.CurItem_lua == nil then
            ---开始生成对象 并标记
            self.CurItem_lua = true
            _G.ItemFactory:GetInstance():GetItemCard(
                _G.ItemFactory.itemType.ItemCarvingBase,
                self.go_table.obj_KeXuanZho,
                function(itemLua)
                    if self:IsNil() then
                        return
                    end
                    self.CurItem_lua = itemLua
                    self:SetItem()
                end
            )
        elseif self.CurItem_lua ~= true then
            ---已生成对象
            self:SetItem()
        end
    end
    self:ShowLoopItem()
end

function CarvingSubstituteView:ShowLoopItem()
    local templist = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Carving)

    self.ItemDataList = {}
    local part = self.carving.parts
    for _, decoData in pairs(templist) do
        if decoData.parts == part and (decoData.cardUid == 0 or decoData.cardUid ~= self.cardData.uid) then
            _G.table.insert(self.ItemDataList, decoData)
        end
    end

    _G.SortList(
        self.ItemDataList,
        function(a)
            --装备列表的装备按照战斗力降序进行排序
            return a:GetPower(), -a.uid
        end
    )

    local count = #self.ItemDataList
    if count > 0 then
        self.go_table.obj_NoFriend:SetActiveE(0)
    else
        self.go_table.obj_NoFriend:SetActiveE(1)
    end
    if not self.listView then
        self.go_table.scrollloopvectical_list:InitItemData(count, _G.handler(self, self.RefreshList))
        self.listView = self.go_table.scrollloopvectical_list
    else
        self.go_table.scrollloopvectical_Equipment:UpdateCount(count)
    end
end

function CarvingSubstituteView:SetItem()
    if self.CurItem_lua == nil or self.CurItem_lua == true then
        return
    end

    self.go_table.aortext_Name.text = self.carving:GetName()
    self.go_table.aortext_power.text = self.UiDic.txt.zl .. _G.string.AddColor(self.carving:GetPower(), "dc4800")
    self.CurItem_lua:ShowData(self.carving, function()
        self:OnClikcItem(self.carving)
    end)
    self.CurItem_lua:ShowSlotLevel(false)
end

function CarvingSubstituteView:RefreshList(index, objGame)
    if index < 0 then
        return
    end

    local itemGoTable = _G.GetAutoGoTable(objGame)

    itemGoTable.CardIndex = index + 1
    itemGoTable.ItemData = nil
    itemGoTable.ItemData = self.ItemDataList[itemGoTable.CardIndex]

    ---没生成对象
    if itemGoTable.LuaDec == nil then
        ---开始生成对象 并标记
        itemGoTable.LuaDec = true

        _G.CarvingViewBase.Create(
            itemGoTable.ItemData,
            itemGoTable.obj_node,
            function(itemLua)
                if self:IsNil() then
                    return
                end
                itemGoTable.LuaDec = itemLua
                self:SetLoopItem(itemGoTable)
            end,
            function()
                self:OnClikcItem(itemGoTable.ItemData)
            end
        )
    elseif itemGoTable.LuaDec ~= true then
        ---已生成对象
        self:SetLoopItem(itemGoTable)
    end

    return objGame
end

function CarvingSubstituteView:SetLoopItem(itemGoTable)
    if itemGoTable == nil then
        return
    end

    ---@type ItemCarvingBase
    local lua = itemGoTable.LuaDec
    ---@type ItemCarvingBase
    local ItemData = itemGoTable.ItemData
    lua:ShowData(ItemData, function()
        self:OnClikcItem(ItemData)
    end)
    lua:ShowSlotLevel(false)
    itemGoTable.gameObject:SetName(ItemData.uid)

    local power = ItemData:GetPower()
    itemGoTable.aortext_power.text = self.UiDic.txt.zl .. power

    --region --------------------------------------up图标--------

    if self.CurItemData == nil then
        itemGoTable.aorimage_up:SetActiveE(0)
    else
        ---如果当前有装备
        if self.nowPower == nil then
            self.nowPower = self.CurItemData:GetPower()
        end
        ---如果大于当前装备战斗力 则显示up图标
        itemGoTable.aorimage_up:SetActiveE(self.nowPower < power and 1 or 0)
    end

    --endregion------------------------------------up图标--------

    itemGoTable.aortext_Name.text = ItemData:GetName()
    ---已被穿戴
    local isCard = ItemData.cardUid ~= 0
    if isCard then
        itemGoTable.aorimage_card.Alpha = 0
        local carddata = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, ItemData.cardUid)
        if carddata ~= nil then
            itemGoTable.aorimage_card.Alpha = 1
            itemGoTable.aorimage_card.SpriteName = carddata.cfg.Icon
        end

        itemGoTable.aortext_Done.text = _G.LangUtil.GetLangPackValue(90020400047)
    else
        itemGoTable.aortext_Done.text = _G.LangUtil.GetLangPackValue(90023400020)
    end

    itemGoTable.aorimage_cardbox:SetActiveE(isCard and 1 or 0)
    itemGoTable.aortext_tips:SetActiveE(isCard and 1 or 0)
    if itemGoTable.isAddBtn == nil then
        itemGoTable.aorbtn_Done.onClick:AddListener(_G.handlerbind(self, self.OnClick_Carving, itemGoTable))
        itemGoTable.isAddBtn = true
    end
end

function CarvingSubstituteView:OnClikcItem(ItemData)
    if ItemData then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CarvingTipView.Name, ItemData,
            ItemData.cfg, true)
    end
end

function CarvingSubstituteView:OnClick_Carving(itemGoTable)
    local ItemData = itemGoTable.ItemData
    require("CarvingModel"):GetInstance():PutOnCarving(
        self.cardData, self.carving.parts, ItemData, function(power, offset)
            self:Close()
            if self.OnChangeCall then
                self.OnChangeCall(false,power, offset)
            end
        end
    )
end

---界面的销毁函数
function CarvingSubstituteView:OnDestroy()
end

---按钮点击事件在这里派发
function CarvingSubstituteView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_CloseViewAny then
        self:Close()
    end
end

return CarvingSubstituteView
