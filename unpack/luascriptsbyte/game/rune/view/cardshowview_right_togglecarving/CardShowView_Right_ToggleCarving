---@class CardShowView_Right_ToggleCarving : Component    中文描述
local CardShowView_Right_ToggleCarving = _G.BaseClass("CardShowView_Right_ToggleCarving", _G.Component)

---四个位置（跟副本类型匹配）
local PartLangKey = {
    [_G.CarvingPart.All] = 90020200027,
    --1
    [_G.CarvingPart.One] = 90032810011,
    --2
    [_G.CarvingPart.Two] = 90032810012,
    --3
    [_G.CarvingPart.Three] = 90032810013,
    --4
    [_G.CarvingPart.Four] = 90032810014
}
---部位列表
local PartList = {
    _G.CarvingPart.One,
    _G.CarvingPart.Two,
    _G.CarvingPart.Three,
    _G.CarvingPart.Four
}

---创建对象时,入口构造函数
function CardShowView_Right_ToggleCarving:OnCreate()
    self.IsInit = false
    ---下拉列表
    self.selectIndex = _G.CarvingPart.All
    ---@type CardShowView_Right_ToggleCarving_GoTable
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))

    self:GetWearItem()

    _G.Events:GetInstance():AddListener(_G.eCarving.CarvingRemove, self.RefreshCarving, self)
    _G.Events:GetInstance():AddListener(_G.eCarving.RestCarvingAttr, self.RefreshCarving, self)
    _G.Events:GetInstance():AddListener(_G.eCarving.OneClickWear, self.OnChangeCall, self)
end

function CardShowView_Right_ToggleCarving:SetData(cardData, isrefresh)
    self.cardData = cardData

    if not self.IsInit or isrefresh then
        self:GetCarvingData()
        self:RefreshDropDwon()
        self:RefreshView()

        ---红点
        self.go_table.obj_strenRedpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.CarvingStrength.id,
            self.cardData.uid)
        for i = 1, 4 do
            self.wearItemList[i].obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.CarvingSlot.id,
                self.cardData.uid * 10 + i)
        end

        require("CarvingModel"):GetInstance().IsRebirth = false
        self.IsInit = true
    end
end

---获取穿戴item
function CardShowView_Right_ToggleCarving:GetWearItem()
    self.wearItemList = {}
    local tb
    for i = 1, 4 do
        tb = _G.GetAutoGoTable(self.go_table["obj_wearItem" .. i], _G.handlerbind(self, self.ClickOneCarving, i))
        if not _G.AppSetting.IsXzns then
            tb.aorimage_icon.SpriteName = _G.CarvingPartsEnum[i]
        end
        self.wearItemList[i] = tb
    end
end

---点击栏位
function CardShowView_Right_ToggleCarving:ClickOneCarving(obj, isOn, part)
    local isopen = require("CarvingModel"):GetInstance():CheckOpenByPart(part, self.cardData.star)
    if not isopen then
        _G.PopWindowManager:GetInstance():ShowAllTips(110113)
    end
end

---刷新穿戴的item
function CardShowView_Right_ToggleCarving:RefreshWearItem()
    if self.cardData.CarvingBar then
        for part, v in pairs(self.cardData.CarvingBar) do
            self.wearItemList[part].obj_root:ClearChildren()

            local isopen = require("CarvingModel"):GetInstance():CheckOpenByPart(part, self.cardData.star)
            _G.GameUtil.SetActiveByCondition(self.wearItemList[part].obj_suo, not isopen)

            if v and not _G.table.isEmptyOrNil(v.carving) then
                self.wearItemList[part].obj_empty:SetActiveE(0)
                if _G.AppSetting.IsXzns then
                    local data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Carving, v.carving.uid)
                    self.wearItemList[part].aorrawimage_icon:SetActiveE(1)
                    self.wearItemList[part].aorrawimage_icon:LoadImage(data.Icon)
                    self.wearItemList[part].obj_slotLevel:SetActiveE(1)
                    self.wearItemList[part].aortext_slotLevel.text = v.slotLevel
                    self.wearItemList[part].obj_level:SetActiveE(1)
                    self.wearItemList[part].aortext_level.text = "Lv." .. data.level

                    local bgSpriteName
                    if data.Grade <= 3 then
                        bgSpriteName = "ui_js_fw_tf_yuan_lan"
                    elseif data.Grade == 4 then
                        bgSpriteName = "ui_js_fw_tf_yuan_zi"
                    elseif data.Grade == 5 then
                        bgSpriteName = "ui_js_fw_tf_yuan_cheng"
                    elseif data.Grade == 6 then
                        bgSpriteName = "ui_js_fw_tf_yuan_hong"
                    elseif data.Grade >= 7 then
                        bgSpriteName = "ui_js_fw_tf_yuan_cai"
                    end
                    self.wearItemList[part].aorimage_bg.SpriteName = bgSpriteName
                    self.wearItemList[part].aorimage_bg:SetGray(false)

                    self.wearItemList[part].aorbtn_click.onClick:RemoveAllListeners()
                    self.wearItemList[part].aorbtn_click.onClick:AddListener(
                        function()
                            _G.UIManager:GetInstance():OpenWindow(
                                _G.ConfigManager.ui_cfg.CarvingTipView.Name,
                                v.carving,
                                v.carving.cfg,
                                false,
                                self.cardData,
                                _G.handler(self, self.OnChangeCall),
                                false,
                                false,
                                true
                            )
                        end
                    )
                else
                    _G.StorageManager:GetInstance():GetItemBaseViewNew(
                        { v.carving.cfg.id },
                        self.wearItemList[part].obj_root,
                        function(tran)
                            if _G.IsNil(self.wearItemList[part].obj_root) then
                                _G.DestroyObject(tran.gameObject)
                                return
                            end
                            tran:ShowLevel(true)
                            tran:ShowSlotLevel(v.slotLevel and v.slotLevel > 0, v.slotLevel)
                        end,
                        function()
                            _G.UIManager:GetInstance():OpenWindow(
                                _G.ConfigManager.ui_cfg.CarvingTipView.Name,
                                v.carving,
                                v.carving.cfg,
                                false,
                                self.cardData,
                                _G.handler(self, self.OnChangeCall),
                                false,
                                false,
                                true
                            )
                        end,
                        v.carving.uid
                    )
                end
            else
                self.wearItemList[part].obj_empty:SetActiveE(1)
                if _G.AppSetting.IsXzns then
                    self.wearItemList[part].obj_level:SetActiveE(0)
                    self.wearItemList[part].obj_slotLevel:SetActiveE(0)
                    self.wearItemList[part].aorrawimage_icon:SetActiveE(0)
                    self.wearItemList[part].aorimage_bg.SpriteName = "ui_js_fw_tf_yuan_zi"
                    self.wearItemList[part].aorimage_bg:SetGray(true)
                    self.wearItemList[part].aorbtn_click.onClick:RemoveAllListeners()
                    self.wearItemList[part].aorbtn_click.onClick:AddListener(
                        function()
                            _G.PopWindowManager:GetInstance():ShowAllTips(120312)
                        end
                    )
                end
            end
        end
    end
end

---获取所有符文数据
function CardShowView_Right_ToggleCarving:GetCarvingData()
    ---@type CarvingData[]
    local carvings = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Carving)
    self.allcarvings = {}
    ---不同部位的数据
    self.otherCarving = {}

    if not _G.table.isEmptyOrNil(carvings) then
        for _, v in pairs(carvings) do
            if not self.otherCarving[v.parts] then
                self.otherCarving[v.parts] = {
                    parts = v.parts,
                    max_power = v:GetPower(),
                    items = { v }
                }
            else
                if v:GetPower() > self.otherCarving[v.parts].max_power then
                    self.otherCarving[v.parts].max_power = v:GetPower()
                end
                _G.table.insert(self.otherCarving[v.parts].items, v)
            end
        end

        self.allcarvings = {}

        -- 每组内部符文按 power 降序
        for _, group in pairs(self.otherCarving) do
            for _, item in ipairs(group.items) do
                _G.table.insert(self.allcarvings, item)
            end
        end
    else
        self.allcarvings = {}
    end
end

--- 符文分解后刷新
function CardShowView_Right_ToggleCarving:RefreshCarving()
    self:GetCarvingData()
    self:RefreshView()
end

function CardShowView_Right_ToggleCarving:RefreshView()
    self:GetCarvingData()
    self:RefreshCarvingList()
    self:RefreshWearItem()
end

function CardShowView_Right_ToggleCarving:RefreshCarvingList()
    self.carvingList = {}

    local chociseList = require("CarvingModel"):GetInstance():GetChociseList()

    local cts = {}
    for i = 1, #chociseList do
        if chociseList[i] then
            local cfg = _G.ConfigManager.carving_filter_cfg[i]
            table.insert(cts, cfg.filter_id)
        end
    end

    local tempList = {}
    if _G.table.isEmptyOrNil(cts) then
        tempList = self.allcarvings or {}
    else
        for i = 1, #self.allcarvings do
            local ppnum = 0
            local attr = self.allcarvings[i].attr
            for k = 1, #cts do 
                for j = 1, #attr do
                    if false ~= table.indexof(cts[k], attr[j].attr_sid) then
                        ppnum = ppnum + 1
                        break
                    end
                end
            end
            if ppnum == #cts then
                table.insert(tempList, self.allcarvings[i])
            end
        end
    end

    for _, v in pairs(tempList) do
        if (not v.cardUid or v.cardUid == 0) then
            _G.table.insert(self.carvingList, v)
        end
    end
    _G.table.sort(self.carvingList, function(a, b)
        if a.Grade == b.Grade then
            if a:GetPower() == b:GetPower() then
                if a.level == b.level then
                    return a.uid > b.uid
                else
                    return a.level > b.level
                end
            else
                return a:GetPower() > b:GetPower()
            end
        else
            return a.Grade > b.Grade
        end
    end)
    local count = self.carvingList and #self.carvingList or 0
    self.go_table.scrollloopvectical_carvingList:SetActiveE(count > 0 and 1 or 0)
    self.go_table.obj_noCarving:SetActiveE(count > 0 and 0 or 1)
    if count > 0 then
        if not self.carvingListView then
            self.go_table.scrollloopvectical_carvingList:InitItemData(count, _G.handler(self, self.RefreshCarvingItem))
            self.carvingListView = self.go_table.scrollloopvectical_carvingList
        else
            if self.lastCarvingCount ~= count then
                self.carvingListView:UpdateCount(count)
            else
                self.carvingListView:UpdateAllItem()
            end
        end
    end
    self.lastCarvingCount = count
end

function CardShowView_Right_ToggleCarving:RefreshCarvingItem(index, obj)
    local data = self.carvingList[index + 1]
    local tb = _G.GetAutoGoTable(obj)
    tb.obj_redpoint:SetActiveE(0)

    tb.obj_root:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        { data.sid },
        tb.obj_root,
        function(tran)
            if _G.IsNil(tb.obj_root) then
                _G.DestroyObject(tran.gameObject)
                return
            end
            tran:ShowLevel(true)
            tran:ShowSlotLevel(false)
            ---同部位是否更高评分的符文
            tran:ShowUp(self:HigherSocer(data))
        end,
        function()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CarvingTipView.Name,
                data, data.cfg, false, self.cardData, _G.handler(self, self.OnChangeCall), false, false, true)
        end,
        data.uid
    )
end

---同部位是否更高评分的符文
---@param data CarvingData
function CardShowView_Right_ToggleCarving:HigherSocer(data)
    local CarvingBar = self.cardData.CarvingBar
    local decoData = CarvingBar[data.parts].carving
    if _G.table.isEmptyOrNil(decoData) then
        return false
    end

    if decoData:GetPower() < data:GetPower() then
        return true
    end

    return false
end

---符文变更回调
function CardShowView_Right_ToggleCarving:OnChangeCall(isStren, power, offset)
    if isStren then
        self:RefreshWearItem()
    else
        self:RefreshView()
    end
    if isStren then
        self:ShowPropUpEffect()
    else
        self:ShowPropUpEffect()
    end
end

---刷新下拉列表
function CardShowView_Right_ToggleCarving:RefreshDropDwon()
    self.go_table.obj_templateBg:SetActiveE(self.unfoldDropdown and 1 or 0)
    if self.selectIndex == _G.CarvingPart.All then
        self.go_table.aortext_label.text = _G.GetLangPackValue(PartLangKey[0])
    else
        self.go_table.aortext_label.text = _G.GetLangPackValue(PartLangKey[self.selectIndex])
    end
    if self.unfoldDropdown then
        if not self.dropDownListView then
            self.go_table.scrollloopvectical_dropdown:InitItemData(#self.otherCarving + 1,
                _G.handler(self, self.RefreshDropDownItem))
            self.dropDownListView = self.go_table.scrollloopvectical_dropdown
        else
            self.dropDownListView:UpdateAllItem()
        end
    end
    self.go_table.aorimage_arrow:SetEulerAngles(self.unfoldDropdown and 180 or 0, 0, 0)
end

function CardShowView_Right_ToggleCarving:RefreshDropDownItem(index, obj)
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, index))

    if index == _G.CarvingPart.All then
        tb.aortext_label.text = _G.GetLangPackValue(PartLangKey[0])
    else
        tb.aortext_label.text = _G.GetLangPackValue(PartLangKey[index])
    end
    local color = self.selectIndex == index and "8FBF50" or "ffffff"
    tb.aortext_label.color = require("CardInfoManager").GetColorFromRGB(color)
end

function CardShowView_Right_ToggleCarving:OnClickItem(_, _, index)
    -- if self.selectIndex and self.selectIndex == index then
    --     return
    -- end

    self.selectIndex = index
    self.unfoldDropdown = false
    self:RefreshDropDwon()
    self:RefreshCarvingList()
end

---一键强化
function CardShowView_Right_ToggleCarving:OnekeyStrength()
    local CarvingBar = self.cardData.CarvingBar
    if CarvingBar then
        local model = require("CarvingModel"):GetInstance()
        local slot = {}
        local cost = {}
        local cfg = _G.ConfigManager.carving_stren_cfg
        local haveCarving, canStrength = false, false
        local decoData
        -- 当前穿戴符文的最高等级和最低等级
        local curMaxSlotLevel = 0
        local curMinSlotLevel = 99999

        for k, v in pairs(CarvingBar) do
            if v.carving then
                if curMaxSlotLevel < v.slotLevel then
                    curMaxSlotLevel = v.slotLevel
                end
                if curMinSlotLevel >= v.slotLevel then
                    curMinSlotLevel = v.slotLevel
                end
            end
        end

        for _, v in pairs(PartList) do
            local data = CarvingBar[v]
            decoData = data and not _G.table.isEmptyOrNil(data.carving)
            if not haveCarving and decoData then
                haveCarving = true
            end
            if decoData and model:CheckCanStrength(self.cardData, data.slotLevel or 0)
                and cfg[data.slotLevel]
                and (curMinSlotLevel == curMaxSlotLevel or curMaxSlotLevel > data.slotLevel)
            then
                ---如果没有获取到配置表示已强化到最大等级
                local id, num = model:GetStrenMaterial(data.slotLevel or 0)
                local total = num
                if cost[id] then
                    total = total + cost[id]
                end

                if _G.StorageManager:GetInstance():CheckItem(id, total) then
                    cost[id] = total
                    _G.table.insert(slot, { k = v, v = data.slotLevel + 1 })
                end
                canStrength = true
            end
        end
        if not _G.table.isEmptyOrNil(slot) then
            local tempCost = {}
            for k, v in pairs(cost) do
                if not _G.StorageManager:GetInstance():CheckItemNew(k, v) then
                    _G.PopWindowManager:GetInstance():ShowAllTips(1020006)
                    return
                end
                _G.table.insert(tempCost, { k, v })
            end

            require("CarvingModel"):GetInstance():CarvingUp(self.cardData, slot, tempCost, function()
                self:RefreshWearItem()
                self:ShowPropUpEffect()
            end)
        else
            if canStrength then
                ---有符文且可以强化时，是材料不足
                _G.PopWindowManager:GetInstance():ShowAllTips(1020006)
            elseif haveCarving then
                ---有符文不能强化时，等级限制
                _G.PopWindowManager:GetInstance():ShowAllTips(1020008)
            end
        end
    end
end

function CardShowView_Right_ToggleCarving:ResetSlot()
    require("CarvingModel"):GetInstance():ResetSlot(self.cardData, function()
        self:RefreshWearItem()
        self:ShowPropUpEffect()
    end)
end

---属性变化飘字
function CardShowView_Right_ToggleCarving:ShowPropUpEffect()
    if self.lastCardCarvingProp and self.lastCardData.uid == self.cardData.uid then
        _G.Events:GetInstance():Broadcast(_G.eCardShow.CardChangeProp, self.lastCardCarvingProp)
    end
    self.lastCardCarvingProp = _G.GameUtil.GetPropUpData(self.cardData)
    self.lastCardData = self.cardData
end

---按钮点击事件在这里派发
function CardShowView_Right_ToggleCarving:OnClickBtn(go, isOn)
    local name = go:GetName()
    if go == self.go_table.aorbtn_compose then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CarvingDecomposeView.Name,
            function()
                self:RefreshCarving()
            end,
            self.cardData)
    -- elseif go == self.go_table.aorbtn_dropdown or go == self.go_table.aorbtn_dropdown1 then
    --     self.unfoldDropdown = not self.unfoldDropdown
    --     self:RefreshDropDwon()
    elseif go == self.go_table.aorbtn_chioseone then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CarvingChociseCtView.Name,
            function()
                self:RefreshCarving()
            end
        )
    elseif go == self.go_table.aorbtn_reset or go == self.go_table.aorbtn_reset1 then
        local carving = self.cardData.CarvingBar
        local canReset = false
        if carving then
            for _, v in pairs(carving) do
                if v.slotLevel and v.slotLevel > 0 then
                    canReset = true
                end
            end
        end
        if canReset then
            _G.PopWindowManager:GetInstance():ShowBtnWindowByToggle(1020003,
                _G.handler(self, self.ResetSlot), nil, _G.handler(self, self.ResetSlot), true)
        end
    elseif go == self.go_table.aorbtn_strength then
        self:OnekeyStrength()
    elseif go == self.go_table.aorbtn_CloseTips then
        self.unfoldDropdown = false
        self:RefreshDropDwon()
        self:RefreshCarvingList()
    end
end

---销毁对象时,析构函数
function CardShowView_Right_ToggleCarving:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eCarving.CarvingRemove, self.RefreshCarving, self)
    _G.Events:GetInstance():RemoveListener(_G.eCarving.RestCarvingAttr, self.RefreshCarving, self)
    _G.Events:GetInstance():RemoveListener(_G.eCarving.OneClickWear, self.OnChangeCall, self)
end

return CardShowView_Right_ToggleCarving
