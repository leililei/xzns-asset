---@class CarvingPropDetailsView : UIBaseView	中文描述
---@field public go_table CarvingPropDetailsView_GoTable GoTable
local CarvingPropDetailsView = _G.BaseClass("CarvingPropDetailsView", _G.UIBaseView)

function CarvingPropDetailsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param cardData CardData 卡牌数据类
function CarvingPropDetailsView:OnCreate(cardData)
    self.attribute = require("CarvingModel"):GetInstance():CalcCarvingProp(cardData)

    local count = #self.attribute
    if (count % 2) ~= 0 then
        count = count + 1
    end
    self.go_table.scrollloopvectical_list:InitItemData(count, _G.handler(self, self.RefreshListItem))
end

function CarvingPropDetailsView:RefreshListItem(index, obj)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj)
    local data = self.attribute[index]
    if data then
        tb.aortext_propName.text = _G.GetLangPackValue(data.name)
        if data.value_type then
            tb.aortext_num.text = self:formatValue(data.value * 100) .. "%"
        else
            tb.aortext_num.text = self:formatValue(data.value)
        end
    else
        tb.aortext_propName.text = ""
        tb.aortext_num.text = ""
    end
    tb.aorimage_bg:SetActiveE(((index + 1) % 4 == 0 or index % 4 == 0) and 1 or 0)
end

function CarvingPropDetailsView:formatValue(value)
    local str = _G.string.format("%.2f", value)
    return _G.string.match(str, "^(.-)%.?0*$")
end

---界面的销毁函数
function CarvingPropDetailsView:OnDestroy()
end

---按钮点击事件在这里派发
function CarvingPropDetailsView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

return CarvingPropDetailsView
