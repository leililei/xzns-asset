---一键强化
function CardShowView_Right_ToggleRune:OnekeyStrength()
    local decorationBar = self.cardData.DecorationBar
    if decorationBar then
        local model = require("RuneModel"):GetInstance()
        local slot = {}
        local cost = {}
        local cfg = _G.ConfigManager.decoration_stren_cfg
        local haveRune, canStrength = false, false
        local decoData
        -- 当前穿戴符文的最高等级和最低等级
        local curMaxSlotLevel = 0
        local curMinSlotLevel = 99999

        for k, v in pairs(decorationBar) do
            if v.decoration then
                if curMaxSlotLevel < v.slotLevel then
                    curMaxSlotLevel = v.slotLevel
                end
                if curMinSlotLevel >= v.slotLevel then
                    curMinSlotLevel = v.slotLevel
                end
            end
        end

        for _, v in pairs(PartList) do
            local data = decorationBar[v]
            decoData = data and not _G.table.isEmptyOrNil(data.decoration)
            if not haveRune and decoData then
                haveRune = true
            end
            if decoData and model:CheckCanStrength(self.cardData, data.slotLevel or 0)
                and cfg[data.slotLevel]
                and (curMinSlotLevel == curMaxSlotLevel or curMaxSlotLevel > data.slotLevel)
            then
                ---如果没有获取到配置表示已强化到最大等级
                local id, num = model:GetStrenMaterial(data.slotLevel or 0)
                local total = num
                if cost[id] then
                    total = total + cost[id]
                end

                if _G.StorageManager:GetInstance():CheckItem(id, total) then
                    cost[id] = total
                    _G.table.insert(slot, { k = v, v = data.slotLevel + 1 })
                end
                canStrength = true
            end
        end
        if not _G.table.isEmptyOrNil(slot) then
            local tempCost = {}
            for k, v in pairs(cost) do
                if not _G.StorageManager:GetInstance():CheckItemNew(k, v) then
                    _G.PopWindowManager:GetInstance():ShowAllTips(1020006)
                    return
                end
                _G.table.insert(tempCost, { k, v })
            end

            require("DecorationModel"):GetInstance():DecorationUp(self.cardData, slot, tempCost, function()
                self:RefreshWearItem()
                self:ShowPropUpEffect()
            end)
        else
            if canStrength then
                ---有符文且可以强化时，是材料不足
                _G.PopWindowManager:GetInstance():ShowAllTips(1020006)
            elseif haveRune then
                ---有符文不能强化时，等级限制
                _G.PopWindowManager:GetInstance():ShowAllTips(1020008)
            end
        end
    end
end

function CardShowView_Right_ToggleRune:ResetSlot()
    require("DecorationModel"):GetInstance():ResetSlot(self.cardData, function()
        self:RefreshWearItem()
        self:ShowPropUpEffect()
    end)
end

---属性变化飘字
function CardShowView_Right_ToggleRune:ShowPropUpEffect()
    if self.lastCardRuneProp and self.lastCardData.uid == self.cardData.uid then
        _G.Events:GetInstance():Broadcast(_G.eCardShow.CardChangeProp, self.lastCardRuneProp)
    end
    self.lastCardRuneProp = _G.GameUtil.GetPropUpData(self.cardData)
    self.lastCardData = self.cardData
end

function CardShowView_Right_ToggleRune:IsWearASet()
    local suit = 0
    for k, v in pairs(self.cardData.DecorationBar) do
        if table.isEmptyOrNil(v.decoration) then
            return 0
        else
            if suit == 0 then
                suit = v.decoration.suit
            elseif v.decoration.suit ~= suit then
                return 0
            end
        end
    end
    return suit
end

---按钮点击事件在这里派发
function CardShowView_Right_ToggleRune:OnClickBtn(go, isOn)
    local name = go:GetName()
    if go == self.go_table.aorbtn_compose then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RuneDecomposeView.Name,
            function()
                self:RefreshRune()
            end,
            self.cardData)
    elseif go == self.go_table.aorbtn_dropdown or go == self.go_table.aorbtn_dropdown1 then
        self.unfoldDropdown = not self.unfoldDropdown
        if self.unfoldDropdown == false then
            self.unfoldDropdown2 = false
        end
        self:RefreshDropDwon()
    elseif go == self.go_table.aorbtn_reset or go == self.go_table.aorbtn_reset1 then
        local decoration = self.cardData.DecorationBar
        local canReset = false
        if decoration then
            for _, v in pairs(decoration) do
                if v.slotLevel and v.slotLevel > 0 then
                    canReset = true
                end
            end
        end
        if canReset then
            _G.PopWindowManager:GetInstance():ShowBtnWindowByToggle(1020003,
                _G.handler(self, self.ResetSlot), nil, _G.handler(self, self.ResetSlot), true)
        end
    elseif go == self.go_table.aorbtn_strength then
        self:OnekeyStrength()
    elseif go == self.go_table.aorbtn_CloseTips then
        self.unfoldDropdown = false
        self.unfoldDropdown2 = false
        self:RefreshDropDwon()
        self:RefreshRuneList()
    end

    if name == "$_toggle_rune" then
        if isOn then
            self.RuneToggle.aortext_on:SetActiveE(1)
            self.go_table.gameObject:SetActiveE(1)
        else
            self.RuneToggle.aortext_on:SetActiveE(0)
            self.go_table.gameObject:SetActiveE(0)
        end
    end

    if name == "$_toggle_carving" then
        if isOn then
            self.CarvingToggle.aortext_on:SetActiveE(1)
            self.CarvingTb.gameObject:SetActiveE(1)
        else
            self.CarvingToggle.aortext_on:SetActiveE(0)
            self.CarvingTb.gameObject:SetActiveE(0)
        end
    end
end

