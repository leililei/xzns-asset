function CardShowView_Right_ToggleRune:RefreshDropDwon()
    self.go_table.obj_templateBg:SetActiveE(self.unfoldDropdown and 1 or 0)
    self.go_table.obj_templateBg2:SetActiveE(self.unfoldDropdown2 and 1 or 0)
    if self.suitDecoration[self.selectIndex + 1] == _G.DecorationPart.All then
        self.go_table.aortext_label.text = _G.GetLangPackValue(PartLangKey[0])
    else
        self.go_table.aortext_label.text = _G.GetLangPackValue(_G.ConfigManager.decoration_suit_cfg
            [self.suitDecoration[self.selectIndex + 1]].name)
    end
    if self.unfoldDropdown then
        if not self.dropDownListView then
            self.go_table.scrollloopvectical_dropdown:InitItemData(#self.suitDecoration,
                _G.handler(self, self.RefreshDropDownItem))
            self.dropDownListView = self.go_table.scrollloopvectical_dropdown
        else
            self.dropDownListView:UpdateAllItem()
        end

        if not self.dropDownListView2 then
            self.go_table.scrollloopvectical_dropdown2:InitItemData(5,
                _G.handler(self, self.RefreshDropDownItem2))
            self.dropDownListView2 = self.go_table.scrollloopvectical_dropdown2
        else
            self.dropDownListView2:UpdateAllItem()
        end
    end
    self.go_table.aorimage_arrow:SetEulerAngles(self.unfoldDropdown and 180 or 0, 0, 0)
end

