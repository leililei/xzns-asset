---@class CardShowView_Right_ToggleRune : Component    中文描述
local CardShowView_Right_ToggleRune = _G.BaseClass("CardShowView_Right_ToggleRune", _G.Component)

---四个部位
local PartLangKey = {
    [_G.DecorationPart.All] = 90020200027,
    --戒指
    [_G.DecorationPart.ring] = 90032800008,
    --项链
    [_G.DecorationPart.necklace] = 90032800005,
    --耳环
    [_G.DecorationPart.earring] = 90032800007,
    --披风
    [_G.DecorationPart.cloak] = 90032800006
}
---部位列表
local PartList = {
    _G.DecorationPart.ring,
    _G.DecorationPart.necklace,
    _G.DecorationPart.earring,
    _G.DecorationPart.cloak
}

---创建对象时,入口构造函数
function CardShowView_Right_ToggleRune:OnCreate()
    self.IsInit = false
    ---下拉列表
    self.selectIndex = _G.DecorationPart.All
    ---次级弹窗
    self.selectIndex2 = _G.DecorationPart.All
    ---@type CardShowView_Right_ToggleRune_GoTable
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))

    self:GetWearItem()

    _G.Events:GetInstance():AddListener(_G.eRune.RuneRemove, self.RefreshRune, self)
    _G.Events:GetInstance():AddListener(_G.eRune.RestRuneAttr, self.RefreshRune, self)
    _G.Events:GetInstance():AddListener(_G.eRune.OneClickWear, self.OnChangeCall, self)
end

function CardShowView_Right_ToggleRune:SetData(cardData, isrefresh)
    self.cardData = cardData

    if not self.IsInit or isrefresh then
        
        self:GetRuneData()
        self:RefreshDropDwon()
        self:RefreshView()

        ---红点
        self.go_table.obj_strenRedpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.RuneStrength.id,
            self.cardData.uid)
        for i = 1, 4 do
            self.wearItemList[i].obj_redpoint:UpdateRedPointItemIDAndParam(
                _G.ConfigManager.redpoint_cfg.DecorationSlot.id,
                self.cardData.uid * 10 + i)
        end

        require("DecorationModel"):GetInstance().IsRebirth = false

        self.IsInit = true
    end
end

---获取穿戴item
function CardShowView_Right_ToggleRune:GetWearItem()
    self.wearItemList = {}
    local tb
    for i = 1, 4 do
        tb = _G.GetAutoGoTable(self.go_table["obj_wearItem" .. i])
        if not _G.AppSetting.IsXzns then
            tb.aorimage_icon.SpriteName = _G.RunePartsEnum[i]
        end
        self.wearItemList[i] = tb
    end
end

---刷新穿戴的item
function CardShowView_Right_ToggleRune:RefreshWearItem()
    if self.cardData.DecorationBar then
        for part, v in pairs(self.cardData.DecorationBar) do
            self.wearItemList[part].obj_root:ClearChildren()
            if v and not _G.table.isEmptyOrNil(v.decoration) then
                self.wearItemList[part].obj_empty:SetActiveE(0)
                if _G.AppSetting.IsXzns then
                    local data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Decoration,
                        v.decoration.uid)
                    self.wearItemList[part].aorrawimage_icon:SetActiveE(1)
                    self.wearItemList[part].aorrawimage_icon:LoadImage(data.Icon)
                    self.wearItemList[part].obj_slotLevel:SetActiveE(1)
                    self.wearItemList[part].aortext_slotLevel.text = v.slotLevel
                    self.wearItemList[part].obj_level:SetActiveE(1)
                    self.wearItemList[part].aortext_level.text = "Lv." .. data.level

                    local bgSpriteName
                    if data.Grade <= 3 then
                        bgSpriteName = "ui_js_fw_tf_yuan_lan"
                    elseif data.Grade == 4 then
                        bgSpriteName = "ui_js_fw_tf_yuan_zi"
                    elseif data.Grade == 5 then
                        bgSpriteName = "ui_js_fw_tf_yuan_cheng"
                    elseif data.Grade == 6 then
                        bgSpriteName = "ui_js_fw_tf_yuan_hong"
                    elseif data.Grade >= 7 then
                        bgSpriteName = "ui_js_fw_tf_yuan_cai"
                    end
                    self.wearItemList[part].aorimage_bg.SpriteName = bgSpriteName
                    self.wearItemList[part].aorimage_bg:SetGray(false)

                    self.wearItemList[part].aorbtn_click.onClick:RemoveAllListeners()
                    self.wearItemList[part].aorbtn_click.onClick:AddListener(
                        function()
                            _G.UIManager:GetInstance():OpenWindow(
                                _G.ConfigManager.ui_cfg.RuneTipView.Name,
                                v.decoration,
                                v.decoration.cfg,
                                false,
                                self.cardData,
                                _G.handler(self, self.OnChangeCall),
                                false,
                                false,
                                true
                            )
                        end
                    )
                else
                    _G.StorageManager:GetInstance():GetItemBaseViewNew(
                        { v.decoration.cfg.id },
                        self.wearItemList[part].obj_root,
                        function(tran)
                            if _G.IsNil(self.wearItemList[part].obj_root) then
                                _G.DestroyObject(tran.gameObject)
                                return
                            end
                            tran:ShowLevel(true)
                            tran:ShowSlotLevel(v.slotLevel and v.slotLevel > 0, v.slotLevel)
                        end,
                        function()
                            _G.UIManager:GetInstance():OpenWindow(
                                _G.ConfigManager.ui_cfg.RuneTipView.Name,
                                v.decoration,
                                v.decoration.cfg,
                                false,
                                self.cardData,
                                _G.handler(self, self.OnChangeCall),
                                false,
                                false,
                                true
                            )
                        end,
                        v.decoration.uid
                    )
                end
            else
                self.wearItemList[part].obj_empty:SetActiveE(1)
                if _G.AppSetting.IsXzns then
                    self.wearItemList[part].obj_level:SetActiveE(0)
                    self.wearItemList[part].obj_slotLevel:SetActiveE(0)
                    self.wearItemList[part].aorrawimage_icon:SetActiveE(0)
                    self.wearItemList[part].aorimage_bg.SpriteName = "ui_js_fw_tf_yuan_zi"
                    self.wearItemList[part].aorimage_bg:SetGray(true)
                    self.wearItemList[part].aorbtn_click.onClick:RemoveAllListeners()
                    self.wearItemList[part].aorbtn_click.onClick:AddListener(
                        function()
                            _G.PopWindowManager:GetInstance():ShowAllTips(120312)
                        end
                    )
                end
            end
        end
    end

    if _G.AppSetting.IsXzns then
        local curShowTxt = GetLangPackValue(90032800165)
        local SuitBg = nil
        local txt = ""
        ---原始这个都没有地方赋值
        local CurSuits = {}
        for suitId, datas in pairs(CurSuits) do
            local suitNum = #datas
            if suitNum >= 2 then
                if txt == "" then
                    txt = string.format("%s(%s/4)", datas[1]:GetSuitName(), suitNum)
                    --else
                    --    txt = string.format("%s-%s(%s/4)",txt,datas[1]:GetSuitName(),suitNum)
                end
                if suitNum == 4 then
                    local curMinData = datas[1]
                    for i = 1, suitNum do
                        if curMinData.Grade > datas[i].Grade then
                            curMinData = datas[i]
                        end
                    end
                    SuitBg = curMinData:GetSuitBg()
                end
            end
        end
        if txt ~= "" then
            curShowTxt = txt
        end
        self.go_table.aortext_tip.text = curShowTxt
        if SuitBg then
            self.go_table.aorrawimage_suitbackground:SetActiveE(1)
            self.go_table.aorrawimage_suitbackground:LoadImage(SuitBg)
        else
            self.go_table.aorrawimage_suitbackground:SetActiveE(0)
        end
        self.go_table.aortext_Recomtip.text = GetLangPackValue(90032800166, GetLangPackValue(self.curRecomSuitCfg.name))
    end
end

---获取所有符文数据
function CardShowView_Right_ToggleRune:GetRuneData()
    ---@type DecorationData[]
    local decorations = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Decoration)
    self.allDecorations = {}
    ---不同部位的数据
    self.otherDecoration = {}
    --- 套装分组
    self.suitDecoration = {}
    local professional = self.cardData:GetProfessional()

    if not _G.table.isEmptyOrNil(decorations) then
        local decorationParts = {}

        -- 分组：按 Grade 分组，再按 suit 分组 策划特殊规则：排序时用全部符文排序，显示时只显示未穿戴的
        for _, v in pairs(decorations) do
            if professional == v.Professional then
                if not decorationParts[v.suit] then
                    decorationParts[v.suit] = {}
                end
                local qgroup = decorationParts[v.suit]
                if not qgroup[v.parts] then
                    qgroup[v.parts] = {
                        parts = v.parts,
                        max_power = v:GetPower(),
                        items = { v }
                    }
                else
                    if v:GetPower() > qgroup[v.parts].max_power then
                        qgroup[v.parts].max_power = v:GetPower()
                    end
                    _G.table.insert(qgroup[v.parts].items, v)
                end

                if not self.suitDecoration[v.suit] then
                    -- self.suitDecoration[v.suit] = _G.ConfigManager.decoration_suit_cfg[v.suit].name
                    self.suitDecoration[v.suit] = v.suit
                end
            end
        end

        local testList = {}
        for k, v in pairs(self.suitDecoration) do
            table.insert(testList, v)
        end
        table.insert(testList, 1, _G.DecorationPart.All)
        self.suitDecoration = testList
        -- 获取所有品质，降序排列
        local qualities = {}
        for quality in pairs(decorationParts) do
            _G.table.insert(qualities, quality)
        end
        _G.table.sort(qualities, function(a, b)
            return a > b
        end)
        self.allDecorations[0] = {}

        for _, suit in ipairs(qualities) do
            local set_groups = {}
            for _, part in pairs(decorationParts[suit]) do
                _G.table.insert(set_groups, part)
            end

            -- 套装组按 max_power 降序排
            _G.table.sort(set_groups, function(a, b)
                return a.max_power > b.max_power
            end)

            -- 每组内部符文按 power 降序
            for _, group in ipairs(set_groups) do
                for _, item in ipairs(group.items) do
                    for _, v in pairs(PartList) do
                        if not self.allDecorations[v] then
                            self.allDecorations[v] = {}
                        end
                        if item.parts == v then
                            _G.table.insert(self.allDecorations[v], item)
                        end
                    end
                    _G.table.insert(self.allDecorations[0], item)

                    --- otherDecoration 此处由套装分类创建
                    --- self.otherDecoration ={ [1] = {...},[11] = {...} }
                    if not self.otherDecoration[item.suit] then
                        self.otherDecoration[item.suit] = {}
                        self.otherDecoration[item.suit][0] = {}
                    end


                    for _, v in pairs(PartList) do
                        if not self.otherDecoration[item.suit][v] then
                            self.otherDecoration[item.suit][v] = {}
                        end
                        if item.parts == v then
                            _G.table.insert(self.otherDecoration[item.suit][v], item)
                        end
                    end



                    _G.table.insert(self.otherDecoration[item.suit][0], item)
                end
            end
        end
    else
        self.allDecorations[0] = {}
        table.insert(self.suitDecoration, 1, _G.DecorationPart.All)
    end
end

--- 符文分解后刷新
function CardShowView_Right_ToggleRune:RefreshRune()
    self:GetRuneData()
    self:RefreshView()
end

function CardShowView_Right_ToggleRune:RefreshView()
    self:GetRuneData()
    self:RefreshRuneList()
    self:RefreshWearItem()
end

function CardShowView_Right_ToggleRune:RefreshRuneList()
    local professional = self.cardData:GetProfessional()
    self.runeList = {}
    local tempList = {}
    if self.suitDecoration[self.selectIndex + 1] == _G.DecorationPart.All then
        tempList = self.allDecorations[self.selectIndex2] or {}
    else
        tempList = self.otherDecoration[self.suitDecoration[self.selectIndex + 1]][self.selectIndex2] or {}
    end

    for _, v in pairs(tempList) do
        if (not v.cardUid or v.cardUid == 0) and professional == v.cfg.Professional then
            _G.table.insert(self.runeList, v)
        end
    end
    _G.table.sort(self.runeList, function(a, b)
        if a.Grade == b.Grade then
            if a:GetPower() == b:GetPower() then
                if a.level == b.level then
                    return a.uid > b.uid
                else
                    return a.level > b.level
                end
            else
                return a:GetPower() > b:GetPower()
            end
        else
            return a.Grade > b.Grade
        end
    end)
    local count = self.runeList and #self.runeList or 0
    self.go_table.scrollloopvectical_runeList:SetActiveE(count > 0 and 1 or 0)
    self.go_table.obj_noRune:SetActiveE(count > 0 and 0 or 1)
    if count > 0 then
        if not self.runeListView then
            self.go_table.scrollloopvectical_runeList:InitItemData(count, _G.handler(self, self.RefreshRuneItem))
            self.runeListView = self.go_table.scrollloopvectical_runeList
        else
            if self.lastRuneCount ~= count then
                self.runeListView:UpdateCount(count)
            else
                self.runeListView:UpdateAllItem()
            end
        end
    end
    self.lastRuneCount = count
end

function CardShowView_Right_ToggleRune:RefreshRuneItem(index, obj)
    local data = self.runeList[index + 1]
    local tb = _G.GetAutoGoTable(obj)
    tb.obj_redpoint:SetActiveE(0)

    tb.obj_root:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        { data.sid },
        tb.obj_root,
        function(tran)
            if _G.IsNil(tb.obj_root) then
                _G.DestroyObject(tran.gameObject)
                return
            end
            tran:ShowLevel(true)
            tran:ShowSlotLevel(false)
            ---同部位是否更高评分的符文
            tran:ShowUp(self:HigherSocer(data))
        end,
        function()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RuneTipView.Name,
                data, data.cfg, false, self.cardData, _G.handler(self, self.OnChangeCall), false, false, true)
        end,
        data.uid
    )
end

---同部位是否更高评分的符文
---@param data DecorationData
function CardShowView_Right_ToggleRune:HigherSocer(data)
    local decorationBar = self.cardData.DecorationBar
    local decoData = decorationBar[data.parts].decoration
    if _G.table.isEmptyOrNil(decoData) then
        return false
    end

    if decoData:GetPower() < data:GetPower() then
        return true
    end

    return false
end

---符文变更回调
function CardShowView_Right_ToggleRune:OnChangeCall(isStren, power, offset)
    if isStren then
        self:RefreshWearItem()
    else
        self:RefreshView()
    end
    if isStren then
        self:ShowPropUpEffect()
    else
        local suit = self:IsWearASet()
        if suit ~= 0 and suit ~= 1 then
            local cfg = _G.ConfigManager.decoration_suit_cfg[suit]
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.View_WearASet.Name, cfg.icon,
                _G.GetLangPackValue(cfg.name), function()
                    if offset and offset > 0 then
                        require "CommonTipManager".OpenPowerUpView(power, offset)
                    end
                    self:ShowPropUpEffect()
                end)
        else
            self:ShowPropUpEffect()
        end
    end
end

