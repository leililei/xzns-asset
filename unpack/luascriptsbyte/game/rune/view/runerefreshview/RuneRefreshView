---获取所有符文数据
function RuneRefreshView:GetRuneData()
    local decorations = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Decoration)
    self.allDecorations = {}
    ---不同部位的数据
    self.otherDecoration = {}
    --- 套装分组
    self.suitDecoration = {}

    if not _G.table.isEmptyOrNil(decorations) then
        local decorationParts = {}

        -- 分组：按 Grade 分组，再按 suit 分组 策划特殊规则：排序时用全部符文排序，显示时只显示未穿戴的
        for _, v in pairs(decorations) do
            if v.Grade >= self.mingrade and not table.isEmptyOrNil(v.attr) then
                if not decorationParts[v.suit] then
                    decorationParts[v.suit] = {}
                end
                local qgroup = decorationParts[v.suit]
                if not qgroup[v.parts] then
                    qgroup[v.parts] = {
                        parts = v.parts,
                        max_power = v:GetPower(),
                        items = { v }
                    }
                else
                    if v:GetPower() > qgroup[v.parts].max_power then
                        qgroup[v.parts].max_power = v:GetPower()
                    end
                    _G.table.insert(qgroup[v.parts].items, v)
                end

                if not self.suitDecoration[v.suit] then
                    -- self.suitDecoration[v.suit] = _G.ConfigManager.decoration_suit_cfg[v.suit].name
                    self.suitDecoration[v.suit] = v.suit
                end
            end
        end

        local testList = {}
        for k, v in pairs(self.suitDecoration) do
            table.insert(testList, v)
        end
        table.insert(testList, 1, _G.DecorationPart.All)
        self.suitDecoration = testList
        -- 获取所有品质，降序排列
        local qualities = {}
        for quality in pairs(decorationParts) do
            _G.table.insert(qualities, quality)
        end
        _G.table.sort(qualities, function(a, b)
            return a > b
        end)
        self.allDecorations[0] = {}

        for _, suit in ipairs(qualities) do
            local set_groups = {}
            for _, part in pairs(decorationParts[suit]) do
                _G.table.insert(set_groups, part)
            end

            -- 套装组按 max_power 降序排
            _G.table.sort(set_groups, function(a, b)
                return a.max_power > b.max_power
            end)

            -- 每组内部符文按 power 降序
            for _, group in ipairs(set_groups) do
                _G.table.sort(group.items, function(a, b)
                    return a:GetPower() > b:GetPower()
                end)

                for _, item in ipairs(group.items) do
                    for _, v in pairs(PartList) do
                        if not self.allDecorations[v] then
                            self.allDecorations[v] = {}
                        end
                        if item.parts == v then
                            _G.table.insert(self.allDecorations[v], item)
                        end
                    end
                    _G.table.insert(self.allDecorations[0], item)

                    --- otherDecoration 此处由套装分类创建
                    --- self.otherDecoration ={ [1] = {...},[11] = {...} }
                    if not self.otherDecoration[item.suit] then
                        self.otherDecoration[item.suit] = {}
                        self.otherDecoration[item.suit][0] = {}
                    end

                    for _, v in pairs(PartList) do
                        if not self.otherDecoration[item.suit][v] then
                            self.otherDecoration[item.suit][v] = {}
                        end
                        if item.parts == v then
                            _G.table.insert(self.otherDecoration[item.suit][v], item)
                        end
                    end
                    _G.table.insert(self.otherDecoration[item.suit][0], item)
                end
            end
        end
    else
        self.allDecorations[0] = {}
        table.insert(self.suitDecoration, 1, _G.DecorationPart.All)
    end
end

