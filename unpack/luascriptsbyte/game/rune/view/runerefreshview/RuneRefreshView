    self:RefreshDropDwon()
    self:RefreshRuneList()
end

function RuneRefreshView:ShowAttrRefreshTipView(oldattr, newattr)
    local newattr = {}
    newattr.sid = self.selectdata.attr_cache[1].attr_sid
    newattr.value = self.selectdata.attr_cache[1].attr_value
    local oldattr = {}
    for k, v in pairs(self.selectdata.attr) do
        if v.index == self.selectdata.attr_cache[1].index then
            oldattr.sid = v.attr_sid
            oldattr.value = v.attr_value
        end
    end
    self.go_table.obj_attrefreshTipView:SetActiveE(1)
    local tagType, entryBol, valueBol = self:CheckAttrPerfect(nil, self.selectdata.attr_cache[1])
    if self.selectdata.cardUid ~= 0 and entryBol then 
        self.attrRefreshTipsTab.aorimage_tag1:SetActiveE(not valueBol and 1 or 0)
        self.attrRefreshTipsTab.aorimage_tag2:SetActiveE(valueBol and 1 or 0)
    else 
        self.attrRefreshTipsTab.aorimage_tag1:SetActiveE(0)
        self.attrRefreshTipsTab.aorimage_tag2:SetActiveE(0)
    end
    self:ShowAttrReItem(self.attrRefreshTipsTab.obj_oldattritem, oldattr)
    self:ShowAttrReItem(self.attrRefreshTipsTab.obj_newattritem2, newattr, 2)
    local tb = _G.GetAutoGoTable(self.attrRefreshTipsTab.obj_newattritem1, _G.handlerbind(self, self.OnClickChoose, 1)) 
    self.attrRefreshTipsTab.obj_isOn2:SetActiveE(1)
    self.attrRefreshTipsTab.obj_isOn1:SetActiveE(0)
    self.chooseType = 2
end

function RuneRefreshView:ShowAttrReItem(item, attr, type)
    local tb = _G.GetAutoGoTable(item, _G.handlerbind(self, self.OnClickChoose, type))
    local name, max
    ---@type decoration_add_cfg
    local decoration_add_cfgItem = _G.ConfigManager.decoration_add_cfg[attr.sid]
    if decoration_add_cfgItem ~= nil then
        name = decoration_add_cfgItem.name
        local nums = decoration_add_cfgItem.value
        max = nums[#nums]
    end
    tb.aortext_attr.text = _G.GetLangPackValue(name) .. self:formatValue(attr.value / 100)
    tb.slider_progress.value = attr.value / max
end

function RuneRefreshView:OnClickChoose(_, _, type)
    if not type then 
        return 
    end
    for i = 1, 2 do 
        self.attrRefreshTipsTab["obj_isOn" .. i]:SetActiveE(i == type and 1 or 0)
    end
    self.chooseType = type
end

function RuneRefreshView:OnClickRefreshTipBtn(go, isOn)
    if go == self.attrRefreshTipsTab.aorbtn_Right or go == self.attrRefreshTipsTab.aorbtn_Close then 
        require("DecorationModel"):GetInstance():ChooseRuneAttr(self.selectdata.uid, self.chooseType, function(msg)
            local _, StorageID = _G.StorageManager:GetInstance():CheckSidType(202060200)
            self:GetRuneData()
            local costdata = _G.StorageManager:GetInstance():GetDataByID(StorageID)[202060200]
            costdata.count = costdata.count - self.cost
            self.selectdata = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Decoration,
                self.selectdata.uid)
            local newatttr = {}
            for k, v in pairs(self.selectdata.attr) do
                if v.index == self.selectattrindex then
                    newatttr.sid = v.attr_sid
                    newatttr.value = v.attr_value
                end
            end
            self.selectdata.score = self.selectdata.scoreAttribute:CalculateArtifactPower()
            self:ShowRefreshRunePanel(true)
            self:refreshcallback()
            if self.selectdata.cardUid ~= 0 then 
                local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, self.selectdata.cardUid)
                cardData:UpdateDecorationData(msg.decorations[1])
            end
        end)
        self.go_table.obj_attrefreshTipView:SetActiveE(0)
    end
end

function RuneRefreshView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        if self.go_table.obj_refreshpanel:GetActiveSelf() == 1 then
            self:ShowRuneListPanel(true)
            self:ShowRefreshRunePanel(false)
        else
            self:Close()
        end
    elseif go == self.go_table.aorbtn_Refresh then
        if not self.selectdata then
            return
        end
        if self.selectattrindex == nil or self.selectattrindex == 0 then
            return
        end
        local _, StorageID = _G.StorageManager:GetInstance():CheckSidType(202060200)
        if self.cost > self.hasnum then

