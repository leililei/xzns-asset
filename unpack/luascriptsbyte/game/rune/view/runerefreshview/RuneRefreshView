function RuneRefreshView:RefreshRuneList()
    self.runeList = {}
    local tempList = {}
    if self.suitDecoration[self.selectIndex + 1] == _G.DecorationPart.All then
        tempList = self.allDecorations[self.selectIndex2] or {}
    else
        tempList = self.otherDecoration[self.suitDecoration[self.selectIndex + 1]][self.selectIndex2] or {}
    end

    self.runeList = tempList
    _G.table.sort(self.runeList, function(a, b)
        local isMeA = a.cardUid == self.cardUid and 3 or a.cardUid > 0 and 2 or 1
        local isMeB = b.cardUid == self.cardUid and 3 or b.cardUid > 0 and 2 or 1

        if isMeA == isMeB then
            if a.Grade == b.Grade then
                if a:GetPower() == b:GetPower() then
                    if a.level == b.level then
                        return a.uid > b.uid
                    else
                        return a.level > b.level
                    end
                else
                    return a:GetPower() > b:GetPower()
                end
            else
                return a.Grade > b.Grade
            end
        else
            return isMeA > isMeB
        end
    end)



    local count = self.runeList and #self.runeList or 0
    self.go_table.scrollloopvectical_runeList:SetActiveE(count > 0 and 1 or 0)
    self.go_table.obj_noRune:SetActiveE(count > 0 and 0 or 1)
    if count > 0 then
        if not self.runeListView then
            self.go_table.scrollloopvectical_runeList:InitItemData(count, _G.handler(self, self.RefreshRuneItem))
            self.runeListView = self.go_table.scrollloopvectical_runeList
        else
            if self.lastRuneCount ~= count then
                self.runeListView:UpdateCount(count)
            else
                self.runeListView:UpdateAllItem()
            end
        end
    end
    self.lastRuneCount = count
end

