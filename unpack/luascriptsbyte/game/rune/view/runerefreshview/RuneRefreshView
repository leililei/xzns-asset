    if self.selectdata.cardUid ~= 0 then 
        local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, self.selectdata.cardUid)
        self.showCardCfg = _G.ConfigManager.card_cfg[cardData.sid]
        table.sort(self.showAttrlist, function(a, b)
            local cardEntryA = 0
            local cardEntryB = 0
            for k, v in ipairs(self.showCardCfg.rune_entry[1] or {}) do 
                if self:CheckRuneAttrSameType(a, v) then 
                    cardEntryA = 1
                end
                if self:CheckRuneAttrSameType(b, v) then 
                    cardEntryB = 1
                end
            end
            if cardEntryA ~= cardEntryB then 
                return cardEntryA > cardEntryB 
            else 
                return a < b
            end
        end)
    end
    -- for i = 1, table.count(self.selectdata.attr) do
    --     if table.ContainsValue(self.showAttrlist, self.selectdata.attr[i].attr_sid) and index ~= self.selectdata.attr[i].index then
    --         table.removebyvalue(self.showAttrlist, self.selectdata.attr[i].attr_sid)
    --     end
    -- end
    local count = table.count(self.showAttrlist)
    if self.tipsViewAttrScroll then
        if self.attrTipsListcount == count then
            self.tipsViewAttrScroll:UpdateAllItem()
        else
            self.tipsViewAttrScroll:UpdateCount(count)
            self.attrTipsListcount = count
        end
    else
        tb.scrollloopvectical_refreshAttrList:InitItemData(count, function(index, obj)
            local otb = _G.GetAutoGoTable(obj)
            local attcfg = _G.ConfigManager.decoration_add_cfg[self.showAttrlist[index + 1]]
            otb.aortext_attr.text = _G.GetLangPackValue(attcfg.name)
            
            local entryBol, haveBol 
            if self.selectdata.cardUid ~= 0 then 
                for k, v in ipairs(self.showCardCfg.rune_entry[1] or {}) do 
                    if self:CheckRuneAttrSameType(self.showAttrlist[index + 1], v) then 
                        entryBol = true 
                        break
                    end
                end
                for i = 1, table.count(self.selectdata.attr) do
                    if self:CheckRuneAttrSameType(self.showAttrlist[index + 1], self.selectdata.attr[i].attr_sid) then 
                        haveBol = true 
                        break
                    end
                end
            end
            otb.aorimage_recom:SetActiveE((self.selectdata.cardUid ~= 0 and entryBol and _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.RuneShowTag, 1) == 1) and 1 or 0)
