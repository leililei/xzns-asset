function RuneRefreshView:CheckAttrPerfect(index, attrData)
    if self.selectdata.cardUid == 0 then 
        return 1, false, false 
    end
    local attr = attrData and attrData or self.selectdata.attr[index]
    local attrCfg = _G.ConfigManager.decoration_add_cfg[attr.attr_sid] 
    local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, self.selectdata.cardUid)
    local cardCfg = _G.ConfigManager.card_cfg[cardData.sid]
    local entryBol
    for k, v in ipairs(cardCfg.rune_entry[1] or {}) do 
        if self:CheckRuneAttrSameType(attr.attr_sid, v) then 
            entryBol = true 
            break
        end
    end
    local valueBol 
    local valueNum = #attrCfg.value
    if attr.attr_value > attrCfg.value[valueNum - 1] and attr.attr_value <= attrCfg.value[valueNum] then 
        valueBol = true 
    end
    if entryBol and valueBol then 
        return 2, entryBol, valueBol
    end 
    return 1, entryBol, valueBol
end

function RuneRefreshView:formatValue(value)
    local str = _G.string.format("+%.2f%%", value)
    return _G.string.match(str, "^(.-)%.?0*$")
end

