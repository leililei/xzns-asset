---@class CarvingTipView : UIBaseView    中文描述
---@field public go_table CarvingTipView_GoTable GoTable
local CarvingTipView = _G.BaseClass("CarvingTipView", _G.UIBaseView)

---基础属性
local baseAttribute = { "atk", "bre", "def", "max_hp" }
---滑动区域最大滑动高度
local ScrollMaxHeight = 750
-- tip中item背景图路径，根据品阶不同
local ItemBgPath = {
    [3] = "ImagesH5/hCommon/ui_img_lanse",
    [4] = "ImagesH5/hCommon/ui_img_zise",
    [5] = "ImagesH5/hCommon/ui_img_chengse",
    [6] = "ImagesH5/hCommon/ui_img_hongse",
    [7] = "ImagesH5/hCommon/ui_img_caise"
}
-- tip中item背景特效，根据品阶不同
local ItemBgEffectPath = {
    [3] = "ef_TipView_lan",
    [4] = "ef_TipView_zi",
    [5] = "ef_TipView_cheng",
    [6] = "ef_TipView_hong",
    [7] = "ef_TipView_chai"
}
-- tip中道具名字的描边颜色
local TipTypeNameOutLineColor = {
    [3] = "0d1b52",
    [4] = "3b0444",
    [5] = "562e0d",
    [6] = "500707",
    [7] = "6f5fb6"
}
-- tip中item名称渐变色(从上到下)，根据品阶不同
local ItemTextGradient = {
    [3] = { "98dffa", "7278f2", 255, 255 },
    [4] = { "fa98de", "c872f2", 255, 255 },
    [5] = { "fca74f", "fd744f", 255, 255 },
    [6] = { "ffab96", "ff0f47", 255, 255 },
    [7] = { "fee4f3", "998bd9", 229, 255 }
}

function CarvingTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OpenDialog, self)
end

---界面的入口函数
---@param data CarvingData 符文数据类,不是预览必须要传，要用来做逻辑判断
---@param cfg carving_cfg 符文配置
---@param isPreview boolean 是否是预览
---@param cardData CardData 卡牌数据类
---@param isSecretRealm boolean 是否是大秘境特殊展示
---@param isInCardView boolean 是否在卡牌养成界面中打开
function CarvingTipView:OnCreate(data, cfg, isPreview, cardData, OnChangeCall, isSecretRealm, isHideBtns, isInCardView)
    self.data = data
    self.cfg = cfg
    self.isPreview = isPreview
    self.isSecretRealm = isSecretRealm
    self.isHideBtns = isHideBtns
    self.cardData = cardData
    self.OnChangeCall = OnChangeCall
    self.isInCardView = isInCardView

    self.go_table.scrollHeight = 0
    self:RefreshLeftView()
    self:RefreshRightView()
    _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(
        self.go_table.obj_Content:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform)))
end

---刷新右边界面(弹窗右边是当前点击的tip，左边是当前穿戴的tip）
function CarvingTipView:RefreshRightView()
    self:ShowInfo(self.go_table, self.cfg, self.data)
    self:ShowBaseProp(self.go_table, self.cfg, self.data)
    self:ShowEntryProp()
    self:ShowButton()

    ---修改滑动区域的高度
    self:SetScrollHeight(self.go_table)
end

---初始化切换按钮
function CarvingTipView:InitBtn()
    local cur = -1
    self.CarvingBar = {}
    if not self.cardData then
        return
    end
    for _, v in pairs(self.cardData.CarvingBar) do
        if v.carving then
            local carving = v.carving
            if #self.CarvingBar > 0 then
                carving.pre = self.CarvingBar[#self.CarvingBar].parts
            end
            _G.table.insert(self.CarvingBar, { parts = carving.parts })
            if carving.parts == self.cfg.parts then
                cur = #self.CarvingBar
            end
        end
    end
    local amount = #self.CarvingBar
    for i = 1, amount do
        if i + 1 <= amount then
            self.CarvingBar[i].next = self.CarvingBar[i + 1].parts
        end
        if i > 1 then
            self.CarvingBar[i].pre = self.CarvingBar[i - 1].parts
        end
    end
    if amount > 0 then
        self.CarvingBar[1].pre = self.CarvingBar[amount].parts
        self.CarvingBar[amount].next = self.CarvingBar[1].parts
    end
    if cur > 0 and cur <= amount and self.CarvingBar[cur] then
        self.CurCarving = self.CarvingBar[cur]
    end
    local showBtn = (amount > 1 and self.go_table.obj_leftPanel:GetctiveInHierarchy() == 0) and self.data.cardUid ~= 0 and self.isInCardView
    self.go_table.aorbtn_pre:SetActiveE(showBtn and 1 or 0)
    self.go_table.aorbtn_next:SetActiveE(showBtn and 1 or 0)
end

---刷新左边界面(弹窗右边是当前点击的tip，左边是当前穿戴的tip）
function CarvingTipView:RefreshLeftView()
    local showPanel = false
    local cvData
    local slotLevel
    if not self.isPreview and (not self.isHideBtns) and self.data and self.cardData and self.cardData.CarvingBar then
        local CarvingBar = self.cardData.CarvingBar
        cvData = CarvingBar[self.cfg.parts] and CarvingBar[self.cfg.parts].carving
        if cvData and cvData.uid ~= self.data.uid then
            slotLevel = CarvingBar[self.cfg.parts].slotLevel
            showPanel = true
        end
    end
    self.go_table.obj_leftPanel:SetActiveE(showPanel and 1 or 0)
    if showPanel and cvData then
        self.panelGotable = _G.GetAutoGoTable(self.go_table.obj_leftPanel)
        self.panelGotable.cvData = cvData
        self.panelGotable.scrollHeight = 0
        self.panelGotable.showPanel = true
        self.panelGotable.slotLevel = slotLevel

        ---设置界面信息
        self:ShowInfo(self.panelGotable, cvData.cfg, cvData, true)
        self:ShowBaseProp(self.panelGotable, cvData.cfg, cvData)
        self:ShowLeftEntryProp(self.panelGotable, cvData.cfg, cvData)

        ---修改滑动区域的高度
        self:SetScrollHeight(self.panelGotable)
    end
end

---设置滑动高度
function CarvingTipView:SetScrollHeight(itemGoTable)
    local rootRect = _G.UIUtils.GetRectTrans(itemGoTable.obj_ScrollView)
    local x, _ = rootRect:GetRectTransformSizeDelta()
    rootRect:SetRectTransformSize(x, _G.Mathf.Min(itemGoTable.scrollHeight, ScrollMaxHeight))
    local scrollRect = itemGoTable.obj_ScrollView:GetComponentE(_G.typeof(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect)))
    scrollRect.vertical = itemGoTable.scrollHeight > ScrollMaxHeight
end

---修改滑动高度
function CarvingTipView:ChangeScrollHeight(trans, itemGoTable)
    local rect = _G.UIUtils.GetRectTrans(trans)
    local _, y = rect:GetRectTransformSizeDelta()
    itemGoTable.scrollHeight = itemGoTable.scrollHeight + y
end

---切换当前已装备的符文
function CarvingTipView:ChangeCarving(type)
    if type == -1 then
        self.data = self.cardData.CarvingBar[self.CurCarving.pre].carving
    elseif type == 1 then
        self.data = self.cardData.CarvingBar[self.CurCarving.next].carving
    end
    self.cfg = self.data.cfg
    self.go_table.scrollHeight = 0
    self:RefreshRightView()
end

---设置弹出tip中的物品名称渐变颜色
---@param text AorText 道具名称文本组件
---@param grade number 道具品质
function CarvingTipView:SetItemTextGradient(text, grade)
    if grade <= 0 or not ItemTextGradient[grade] then
        return
    end

    local colors = {
        ItemTextGradient[grade][1],
        ItemTextGradient[grade][2]
    }
    local alphas = {
        ItemTextGradient[grade][3],
        ItemTextGradient[grade][4]
    }
    require("CommonTipManager"):GetInstance():SetTextGradient(colors, alphas, text)
end

---设置信息
---@param itemGoTable table
---@param cfg carving_cfg 符文配置
---@param cvData CarvingData 符文数据类
function CarvingTipView:ShowInfo(itemGoTable, cfg, cvData, leftCarving)
    itemGoTable.obj_root:RemoveAllChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        { cfg.id },
        itemGoTable.obj_root,
        function(tran)
            if self:IsNil() then
                _G.DestroyObject(tran.gameObject)
                return
            end

            local slotLv = 0
            if self.isPreview then
                ---预览显示固定的等级
                slotLv = cfg.level[2]
            else
                if self.panelGotable and self.panelGotable.slotLevel then
                    slotLv = self.panelGotable.slotLevel or 0
                else
                    if cvData and cvData.cardUid ~= 0 then
                        slotLv = cvData:GetSlotStrenLv()
                    end
                end
            end
            tran:ShowSlotLevel(slotLv ~= 0, slotLv)
            itemGoTable.itemLua = tran
        end,
        function()
        end
    )

    itemGoTable.aortext_name.text = _G.GetLangPackValue(cfg.name)
    ---名字描边
    itemGoTable.aortext_name:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = _G.ColorTools.FormatColorByString(TipTypeNameOutLineColor[cfg.grade])
    self:SetItemTextGradient(itemGoTable.aortext_name, cfg.grade)
    if self.isPreview and not cvData then
        ---预览显示固定的等级
        local level = cfg.level[1]
        itemGoTable.aortext_level.text = _G.GetLangPackValue(90032800017, level or 1)
    else
        itemGoTable.aortext_level.text = _G.GetLangPackValue(90032800017, cvData and cvData.level or 1)
    end

    if self.isSecretRealm then
        itemGoTable.aortext_level.text = ""
    end

    --itemGoTable.aorimage_pro.SpriteName = _G.ProfessionalIcon[cfg.Professional]
    ---背景框
    itemGoTable.aorrawimage_bg:LoadImage(ItemBgPath[cfg.grade])
    ---边框特效
    local effectPath = ItemBgEffectPath[cfg.grade]
    itemGoTable.obj_effect:RemoveAllChildren()
    if effectPath then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[effectPath],
            itemGoTable.obj_effect,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                --itemGoTable.bgEffect = trans
            end
        )
    end

    itemGoTable.aortext_power:SetActiveE(self.isPreview and not cvData and 0 or 1)
    itemGoTable.aorimage_lock:SetActiveE((leftCarving or self.isPreview) and 0 or 1)
    if itemGoTable.aorimage_up then
        itemGoTable.aorimage_up:SetActiveE(self.panelGotable and 1 or 0)
    end
    if not self.isPreview and cvData then
        local power = cvData:GetAbyssalMaw()
        if not self.cardData or cvData.cardUid ~= 0 and self.cardData.uid == cvData.cardUid or leftCarving then
            power = _G.string.format("<color=#72c946>%s</color>", power)
        else
            local CarvingBar = self.cardData.CarvingBar
            local cardCvData = CarvingBar[cfg.parts].carving
            local upPath
            if not cardCvData or cvData:GetAbyssalMaw() >= cardCvData:GetAbyssalMaw() then
                power = _G.string.format("<color=#72c946>%s</color>", power)
                upPath = "0ui_icon_shangsheng"
            else
                power = _G.string.format("<color=#E33F3f>%s</color>", power)
                upPath = "0ui_icon_xiajiang"
            end

            if itemGoTable.aorimage_up then
                if not upPath then
                    itemGoTable.aorimage_up:SetActiveE(0)
                else
                    itemGoTable.aorimage_up.SpriteName = upPath
                end
            end
        end
        itemGoTable.aortext_power.text = "抗魔值：" .. power--_G.GetLangPackValue(90000010923, power)
    end
    self:ShowLockStatus()
end

---上锁状态
function CarvingTipView:ShowLockStatus()
    if not self.isPreview and self.data then
        self.go_table.aorimage_lock.SpriteName = self.data.lock == 1 and "ui_zb_icon_suo_02" or "ui_icon_ks"
    end
end

---基础属性(附加属性)
---@param itemGoTable table
---@param cfg carving_cfg 符文配置
---@param cvData CarvingData 符文数据类
function CarvingTipView:ShowBaseProp(itemGoTable, cfg, cvData)
    local list = {}
    for _, v in ipairs(baseAttribute) do
        if cfg[v] and cfg[v] > 0 then
            _G.table.insert(list, { key = v, value = cfg[v] })
        end
    end
    if _G.table.isEmptyOrNil(list) then
        itemGoTable.obj_prop:SetActiveE(0)
        return
    end

    self:ChangeScrollHeight(itemGoTable.obj_prop, itemGoTable)
    if not itemGoTable.propItemList then
        itemGoTable.propItemList = {}
    else
        for _, v in ipairs(itemGoTable.propItemList) do
            v.gameObject:SetActiveE(0)
        end
    end

    ---属性加成倍率
    local rate = 1
    if not self.isPreview and cvData then
        local slotLevel = 0
        if self.panelGotable and self.panelGotable.slotLevel then
            slotLevel = self.panelGotable.slotLevel or 0
        else
            if self.cardData then
                local dData = self.cardData.CarvingBar[cfg.parts]
                if dData and dData.carving and dData.carving.uid == cvData.uid then
                    slotLevel = dData and dData.slotLevel
                end
            end
        end
        rate = cvData:GetPropRate(slotLevel)
    end
    local obj, tb
    for i, v in ipairs(list) do
        if not itemGoTable.propItemList[i] then
            obj = _G.InstantiateObject(itemGoTable.obj_propItem, itemGoTable.obj_propGrid)
            tb = _G.GetAutoGoTable(obj)
            itemGoTable.propItemList[i] = tb
        else
            tb = itemGoTable.propItemList[i]
        end
        tb.gameObject:SetActiveE(1)
        tb.aortext_propName.text = _G.AttrType[v.key].des
        if self.isPreview and not self.data then
            tb.aortext_propNum.text = _G.GameUtil.NumberWY(v.value)
        else
            local value = _G.Mathf.RoundToInt(v.value * rate)
            tb.aortext_propNum.text = _G.GameUtil.NumberWY(value)
        end
    end
    _G.GameUtil.ReBuildRTF(itemGoTable.obj_prop)
end

---词条属性
function CarvingTipView:ShowEntryProp()
    if not self:GetNumAddition(self.cfg) or self:GetNumAddition(self.cfg) <= 0 then
        self.go_table.obj_entryprop:SetActiveE(0)
        return
    end

    if self.isSecretRealm then
        self.go_table.obj_entryprop:SetActiveE(0)
        return
    end
    if not self.entryListView then
        self.go_table.scrollloopvectical_entry:InitItemData(self:GetNumAddition(self.cfg),
            _G.handler(self, self.RefreshEntryItem))
        self.entryListView = self.go_table.scrollloopvectical_entry
    else
        self.entryListView:UpdateCount(self:GetNumAddition(self.cfg))
        self.entryListView:UpdateAllItem()
    end
    self.entryListView:UpdateScrollRectHeight(self:GetNumAddition(self.cfg) * 48)
    local rect = _G.UIUtils.GetRectTrans(self.go_table.obj_entryprop)
    local x = 390
    local y = 95
    --local x, y = rect:GetRectTransformSizeDelta()
    rect:SetRectTransformSize(x, y + (self:GetNumAddition(self.cfg) - 1) * 48)
    self:ChangeScrollHeight(self.go_table.obj_entryprop, self.go_table)
end

function CarvingTipView:RefreshEntryItem(index, obj)
    local tb = _G.GetAutoGoTable(obj)
    if self.isPreview or not self.data then
        tb.aortext_name.text = _G.GetLangPackValue(90032800018)
    else
        local name = self.data:GetAddName(index + 1)
        tb.aortext_name.text = name
    end
end

---左边面板的词条属性
---@param itemGoTable table
---@param cfg carving_cfg 符文配置
function CarvingTipView:ShowLeftEntryProp(itemGoTable, cfg, cvData)
    if not self:GetNumAddition1(cvData) or self:GetNumAddition1(cvData) <= 0 then
        itemGoTable.obj_entryprop:SetActiveE(0)
        return
    end

    if not itemGoTable.entryListView then
        itemGoTable.scrollloopvectical_entry:InitItemData(self:GetNumAddition1(cvData),
            _G.handlerbind(self, self.RefreshLeftEntryItem, cvData))
        itemGoTable.entryListView = itemGoTable.scrollloopvectical_entry
    else
        itemGoTable.entryListView:UpdateAllItem()
    end
    itemGoTable.entryListView:UpdateScrollRectHeight(self:GetNumAddition1(cvData) * 48)
    local rect = _G.UIUtils.GetRectTrans(itemGoTable.obj_entryprop)
    local x, y = rect:GetRectTransformSizeDelta()
    rect:SetRectTransformSize(x, y + (self:GetNumAddition1(cvData) - 1) * 48)
    self:ChangeScrollHeight(itemGoTable.obj_entryprop, itemGoTable)
end

function CarvingTipView:GetNumAddition(cfg)
    return #self.data.attr
end

function CarvingTipView:GetNumAddition1(cvData)
    return #cvData.attr
end

function CarvingTipView:RefreshLeftEntryItem(index, obj, cvData)
    local tb = _G.GetAutoGoTable(obj)
    if self.isPreview and not self.panelGotable then
        tb.aortext_name.text = _G.GetLangPackValue(90032800018)
    else
        local name = cvData:GetAddName(index + 1)
        tb.aortext_name.text = name
    end
end

function CarvingTipView:formatValue(value)
    local str = _G.string.format("+%.1f%%", value)
    return _G.string.match(str, "^(.-)%.?0*$")
end

---按钮
function CarvingTipView:ShowButton()
    self.go_table.obj_button:SetActiveE((self.isPreview or self.isHideBtns) and 0 or 1)
    self.go_table.aorbtn_lock:SetActiveE(self.isHideBtns and 0 or 1)
    if self.isPreview or self.isHideBtns then
        return
    end
    self:InitBtn()
    if self.panelGotable and self.panelGotable.showPanel then
        self.go_table.aorbtn_wear:SetActiveE(1)
        self.go_table.aorbtn_replace:SetActiveE(0)
        self.go_table.aorbtn_remove:SetActiveE(0)
        self.go_table.aorbtn_build:SetActiveE(1)
        self.go_table.aorbtn_destroy:SetActiveE(1)
        self:ShowStrenMaterial()
        return
    end
    if not self.cardData then
        -- 没有穿戴指定对象
        self.go_table.aorbtn_wear:SetActiveE(0)
        self.go_table.aorbtn_replace:SetActiveE(0)
        self.go_table.aorbtn_remove:SetActiveE(0)
        self.go_table.aorbtn_build:SetActiveE(1)
        self.go_table.aorbtn_destroy:SetActiveE(1)
        self:ShowStrenMaterial()
    elseif not self.data.cardUid or self.data.cardUid == 0 then
        ---当前符文未穿戴
        local parts = self.data.parts
        local carvingBar = self.cardData and self.cardData.CarvingBar or {}
        local isWear = carvingBar[parts] and not _G.table.isEmptyOrNil(carvingBar[parts].carving)
        self.go_table.aorbtn_wear:SetActiveE(isWear and 0 or 1)
        self.go_table.aorbtn_replace:SetActiveE(isWear and 1 or 0)
        self.go_table.aorbtn_remove:SetActiveE(0)
        self.go_table.aorbtn_build:SetActiveE(1)
        self.go_table.aorbtn_destroy:SetActiveE(1)
        self:ShowStrenMaterial()
    elseif self.isInCardView then
        -- 符文已穿戴，并且在卡牌养成中打开
        self.go_table.aorbtn_wear:SetActiveE(0)
        self.go_table.aorbtn_replace:SetActiveE(1)
        ---如果是自己穿戴的显示卸下和强化
        self.go_table.aorbtn_remove:SetActiveE(1)
        self.go_table.aorbtn_build:SetActiveE(1)
        self.go_table.aorbtn_destroy:SetActiveE(0)
        self:ShowStrenMaterial()
    else
        -- 在除了卡牌养成界面打开，不显示养成相关按钮
        self.go_table.obj_button:SetActiveE(0)
    end
    -- 判断当前槽位等级，如果到达最高级，则隐藏强化按钮
    local slotLevtl = self.CurCarving and self.cardData.CarvingBar[self.CurCarving.parts].slotLevel or nil
    if slotLevtl and require("CarvingModel"):GetInstance():CheckIsCarvingMaxLevel(slotLevtl) then
        self.go_table.aorbtn_build:SetActiveE(0)
    end
end

---强化材料
function CarvingTipView:ShowStrenMaterial()
    self.go_table.obj_material:SetActiveE(0)
    local data = self.cardData.CarvingBar[self.cfg.parts]
    local id, num = require("CarvingModel"):GetInstance():GetStrenMaterial(data.slotLevel or 0)
    self.go_table.aorrawimage_icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(id))

    local _, storageId = _G.StorageManager:GetInstance():CheckSidType(id)
    local haveCount = _G.StorageManager:GetInstance():GetItemCountByID(storageId, id)
    if haveCount >= num then
        self.go_table.aortext_materialNum.text = _G.string.format("<color=#96CE51>%s</color>/%s", haveCount, num)
    else
        self.go_table.aortext_materialNum.text = _G.string.format("<color=#E33F3f>%s</color>/%s", haveCount, num)
    end
end

function CarvingTipView:OpenDialog(name)
    if name == _G.ConfigManager.ui_cfg.OptionDialogByToggleView.Name then
        ---@type OptionDialogByToggleView
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.OptionDialogByToggleView.Name)
        if view and (view.id == 1020002 or view.id == 1020011) then
            local param = {}
            local materialList, tempMaterial
            tempMaterial = {}
            materialList = self.data:GetDecomposition()
            if materialList then
                for _, material in pairs(materialList) do
                    local sid, num = material[1], material[2]
                    if tempMaterial[sid] then
                        tempMaterial[sid] = tempMaterial[sid] + num
                    else
                        tempMaterial[sid] = num
                    end
                end
            end
            for k, v in pairs(tempMaterial) do
                _G.table.insert(param, { content = v, sid = k })
            end
            view:ShowDown(param)
        end
    end
end

---界面的销毁函数
function CarvingTipView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OpenDialog, self)
end

---按钮点击事件在这里派发
function CarvingTipView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.aorbtn_destroy then
        if self.data.lock == 1 then
            _G.PopWindowManager:GetInstance():ShowAllTips(1020004)
            return
        end
        local func = function()
            require("CarvingModel"):GetInstance():Decompose(
                { [self.data.uid] = { sid = self.data.sid } },
                { self.data.uid },
                function()
                    if self.OnChangeCall then
                        self.OnChangeCall(false, 0, 0)
                    end
                    self:Close()
                end)
        end
        _G.PopWindowManager:GetInstance():ShowBtnWindowByToggle(self.data.Grade >= 5 and 1020002 or 1020011, func, nil, func, true)
    elseif go == self.go_table.aorbtn_wear then

        local isopen = require("CarvingModel"):GetInstance():CheckOpenByPart(self.cfg.parts, self.cardData.star)
        if not isopen then
            _G.PopWindowManager:GetInstance():ShowAllTips(13)
            return
        end

        ---穿戴
        require("CarvingModel"):GetInstance():PutOnCarving(
            self.cardData, self.cfg.parts, self.data, function(power, offset)
                self:Close()
                if self.OnChangeCall then
                    self.OnChangeCall(false, power, offset)
                end
            end
        )
    elseif go == self.go_table.aorbtn_remove then
        ---拆卸
        local cvData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Carving, self.data.uid)
        require("CarvingModel"):GetInstance():TakeOffCarving(
            self.cardData, self.cfg.parts, cvData, function()
                self:Close()
                if self.OnChangeCall then
                    self.OnChangeCall()
                end
            end
        )
    elseif go == self.go_table.aorbtn_replace then
        --替换时需要传卡牌身上的数据
        if self.data.cardUid == 0 or self.data.cardUid ~= self.cardData.uid then
            local cvData = self.cardData.CarvingBar[self.cfg.parts]
            if cvData and cvData.carving then
                cvData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Carving, cvData.carving
                                                                                                          .uid)
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.CarvingSubstituteView.Name,
                    self.cardData,
                    cvData,
                    self.OnChangeCall
                )
            end
        else
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CarvingSubstituteView.Name,
                self.cardData,
                self.data,
                self.OnChangeCall
            )
        end
        self:Close()
    elseif go == self.go_table.aorbtn_build then
        --强化
        if not self.cardData or not self.data then
            return
        end

        self:Close()
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CarvingRefreshView.Name,
            function()
                --self.CarvingCompnent:RefreshCarving()
            end,
            self.cardData.uid,
            self.data,
            self.data.cardUid,
            self.cardData.CarvingBar
        )

        -- local data = self.cardData.CarvingBar[self.cfg.parts]
        -- if _G.table.isEmptyOrNil(data) then
        --     return
        -- end
        -- local canStren = require("CarvingModel"):GetInstance():CheckCanStrength(self.cardData, data.slotLevel)
        -- if not canStren then
        --     if require("CarvingModel"):GetInstance():CheckIsCarvingMaxLevel(data.slotLevel) then
        --         _G.PopWindowManager:GetInstance():ShowAllTips(1020008)
        --     else
        --         _G.PopWindowManager:GetInstance():ShowAllTips(1020012)
        --     end
        --     return
        -- end

        -- local id, num = require("CarvingModel"):GetInstance():GetStrenMaterial(data.slotLevel or 1)
        -- if not _G.StorageManager:GetInstance():CheckItemNew(id, num) then
        --     self:Close()
        --     return
        -- end
        -- self.go_table.aorrawimage_icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(id))

        -- local slot = { { k = self.cfg.parts, v = data.slotLevel + 1 } }
        -- require("CarvingModel"):GetInstance():CarvingUp(self.cardData, slot, { { id, num } }, function()
        --     if self.go_table.itemLua then
        --         self.go_table.itemLua:ShowSlotLevel(true, data.slotLevel)
        --     end
        --     self:ShowBaseProp(self.go_table, self.cfg, self.data)
        --     self:ShowStrenMaterial()
        --     if self.OnChangeCall then
        --         self.OnChangeCall(true)
        --     end
        -- end)
    elseif go == self.go_table.aorbtn_lock then
        --上锁
        local type = self.data.lock == 0 and 1 or 0
        require("CarvingModel"):GetInstance():Lock(self.cardData, self.data, type, function()
            self:ShowLockStatus()
        end)
    elseif go == self.go_table.aorbtn_pre then
        if self.CurCarving.pre then
            self:ChangeCarving(-1)
        end
    elseif go == self.go_table.aorbtn_next then
        if self.CurCarving.next then
            self:ChangeCarving(1)
        end
    end
end

return CarvingTipView
