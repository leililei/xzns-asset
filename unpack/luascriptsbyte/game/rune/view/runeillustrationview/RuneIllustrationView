---@class RuneIllustrationView : UIBaseView	中文描述
---@field public go_table RuneIllustrationView_GoTable GoTable
local RuneIllustrationView = _G.BaseClass("RuneIllustrationView", _G.UIBaseView)

function RuneIllustrationView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.looplist2_list:InitListView(0, _G.handler(self, self.RefreshListItem))
end

---界面的入口函数
function RuneIllustrationView:OnCreate()
    self.profBtns = {
        self.go_table.aorbtn_pTK, --1
        self.go_table.aorbtn_pZS, --2
        self.go_table.aorbtn_pFS, --3
        self.go_table.aorbtn_pFZ, --4
        self.go_table.aorbtn_pYX  --5
    }
    self.profBtnRedPoint = {
        [_G.PlayerTreeID.tank] = self.go_table.obj_tkredpoint,
        [_G.PlayerTreeID.warrior] = self.go_table.obj_zsredpoint,
        [_G.PlayerTreeID.master] = self.go_table.obj_fsredpoint,
        [_G.PlayerTreeID.support] = self.go_table.obj_fzredpoint,
        [_G.PlayerTreeID.ranger] = self.go_table.obj_yxredpoint
    }
    self:GetData()
    _G.GameUtil.ReBuildRTF(self.go_table.obj_prof)
    self.indexNum = 0

    for i = 1, 5 do
        if self.indexNum == 0 then
            self:ChangeByProf(i)
        end
    end

    self:InitBtnRedpoint()
end

---初始化页签红点
function RuneIllustrationView:InitBtnRedpoint()
    self.proRedPointNum = {}
    for pro, obj in pairs(self.profBtnRedPoint) do
        if not self.proRedPointNum[pro] then
            self.proRedPointNum[pro] = 0
        end
        if self.runePrefList[pro] then
            for id, _ in pairs(self.runePrefList[pro]) do
                local unlock, isAward = require("RuneIllustrationModel"):GetInstance():IsUnlockIll(id)
                if unlock and not isAward then
                    self.proRedPointNum[pro] = self.proRedPointNum[pro] + 1
                end
            end
            obj:SetActiveE(self.proRedPointNum[pro] > 0 and 1 or 0)
        else
            obj:SetActiveE(0)
        end
    end
end

function RuneIllustrationView:RefreshBtnRedPoint(pro)
    if not self.proRedPointNum[pro] then
        self.proRedPointNum[pro] = 0
    end
    if self.proRedPointNum[pro] > 0 then
        self.proRedPointNum[pro] = self.proRedPointNum[pro] - 1
    end
    self.profBtnRedPoint[pro]:SetActiveE(self.proRedPointNum[pro] > 0 and 1 or 0)
end

---获取数据
function RuneIllustrationView:GetData()
    ---@type decoration_suit_cfg 套装的配置数据
    self.allSuitData = {}
    ---@type decoration_cfg 符文的配置数据<suitId, decoration_cfg>
    self.allRuneCfgList = {}
    ---@type table 符文的配置数据<Professional, id>
    self.runePrefList = {}
    local suitCfg = _G.ConfigManager.decoration_suit_cfg
    local cfg = _G.ConfigManager.decoration_cfg
    for _, v in pairs(cfg) do
        if v.is_show == 1 then
            if not self.allRuneCfgList[v.suit] then
                self.allRuneCfgList[v.suit] = {}
                _G.table.insert(self.allSuitData, suitCfg[v.suit])
            end
            if not self.allRuneCfgList[v.suit][v.Professional] then
                self.allRuneCfgList[v.suit][v.Professional] = {}
            end
            _G.table.insert(self.allRuneCfgList[v.suit][v.Professional], v)

            if not self.runePrefList[v.Professional] then
                self.runePrefList[v.Professional] = {}
            end
            self.runePrefList[v.Professional][v.id] = 1
        end
    end
    _G.table.sort(
        self.allSuitData,
        function(a, b)
            return a.display_priority < b.display_priority
        end
    )
    ---套装内不同职业按品质排序
    for _, v in pairs(self.allRuneCfgList) do
        for _, cfgs in pairs(v) do
            _G.SortList(cfgs, function(item)
                return item.grade, -item.parts
            end)
        end
    end
end

--初始化item
function RuneIllustrationView:RefreshListItem(listView2, index)
    if index < 0 then
        return
    end
    local t_index = index + 1
    local item = listView2:NewListViewItem("$_obj_item")
    item:SetActiveE(1)

    self:SetItem(item, t_index)
    return item
end

function RuneIllustrationView:SetItem(go, t_index)
    if not self.suitItems then
        self.suitItems = {}
    end
    local item = self.suitItems[go:GetInstanceIDE()]
    if not item then
        item = _G.GetAutoGoTable(go)
        self.suitItems[go:GetInstanceIDE()] = item
    end
    local cfg = self.suitData[self.curIndex][t_index]
    item.aortext_name.text = _G.GetLangPackValue(cfg.name)

    local list = self.allRuneCfgList[cfg.id]
    list = list and list[self.curIndex] or {}
    if item.runeItemList then
        for _, v in ipairs(item.runeItemList) do
            v.gameObject:SetActiveE(0)
        end
    end
    item.runeItemList = item.runeItemList or {}
    local groupObj, obj

    for i, v in ipairs(list) do
        if item.runeItemList[i] then
            groupObj = item.runeItemList[i]
            groupObj.gameObject:SetActiveE(1)
        else
            obj = _G.InstantiateObject(item.obj_runItem, item.obj_runeGird)
            obj:SetActiveE(1)
            groupObj = _G.GetAutoGoTable(obj)
            item.runeItemList[i] = groupObj
        end
        groupObj.aorbtn_click.onClick:RemoveAllListeners()
        groupObj.aorbtn_click.onClick:AddListener(
            _G.handlerbind(self, self.OnClickItem, groupObj.aorbtn_click, v)
        )

        local unlock, isAward = require("RuneIllustrationModel"):GetInstance():IsUnlockIll(v.id)
        groupObj.aorimage_rank.SpriteName = _G.RuneRankEnum[v.grade]
        groupObj.aorimage_rank:SetGray(not unlock)
        groupObj.aorrawimage_icon:LoadImage(
            v.icon,
            function(img)
                if self:IsNil() then
                    return
                end
                img:SetGray(not unlock)
            end
        )

        groupObj.obj_award:SetActiveE(unlock and not isAward and 1 or 0)
        if unlock and not isAward then
            ---默认显示第一个奖励
            local sid = v.reward[1] and v.reward[1][1]
            if sid then
                groupObj.aorrawimage_award:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(sid))
            end
        end
    end
    _G.GameUtil.ReBuildRTF(item.obj_runeGird)
    _G.GameUtil.ReBuildRTF(go.gameObject)
    self.go_table.looplist2_list:OnItemSizeChanged(t_index - 1)
end

function RuneIllustrationView:OnClickItem(go, cfg)
    local unlock, isAward = require("RuneIllustrationModel"):GetInstance():IsUnlockIll(cfg.id)
    if unlock and not isAward then
        require("DecorationModel"):GetInstance():GetIllAward({ cfg.id }, function()
            self:ChangeByProf(self.curIndex, true)
            self:RefreshBtnRedPoint(cfg.Professional)
        end)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RuneTipView.Name, nil, cfg, true)
    end
end

---刷新
function RuneIllustrationView:ChangeByProf(index, forceUpdate)
    if (not index or (self.curIndex and index == self.curIndex)) and not forceUpdate then
        return
    end

    self.curIndex = index
    self.go_table.trans_pChoose:SetPositionByTarget(self.profBtns[index])
    if not self.suitData then
        self.suitData = {}
    end
    --- 定位到第一个有奖励的地方
    self.indexNum = 0

    if not self.suitData[index] then
        self.suitData[index] = {}
        for _, v in ipairs(self.allSuitData) do
            if self.allRuneCfgList[v.id] and self.allRuneCfgList[v.id][self.curIndex] then
                _G.table.insert(self.suitData[index], v)
            end
        end
    end


    local cfgs = self.suitData[self.curIndex]
    local IsEnd = false

    for key, value in ipairs(cfgs) do
        local list = self.allRuneCfgList[value.id]
        list = list and list[self.curIndex] or {}

        if not IsEnd then
            self.indexNum = self.indexNum + 1
            for i, v in ipairs(list) do
                local unlock, isAward = require("RuneIllustrationModel"):GetInstance():IsUnlockIll(v.id)
                if unlock and not isAward then
                    IsEnd = true
                end
            end
        end
    end

    if not IsEnd then
        self.indexNum = 0
    end

    local count = #self.suitData[index]
    if not self.lastItemCount or self.lastItemCount ~= count then
        self.go_table.looplist2_list:SetListItemCount(#self.suitData[index], true, false)
        if self.indexNum ~= 0 then
            self.go_table.looplist2_list:MovePanelToItemIndex(self.indexNum - 1)
        end
    else
        self.go_table.looplist2_list:RefreshAllShownItem()
        if self.indexNum ~= 0 then
            self.go_table.looplist2_list:MovePanelToItemIndex(self.indexNum - 1)
        end
    end
    self.lastItemCount = count
end

---界面的销毁函数
function RuneIllustrationView:OnDestroy()
end

---按钮点击事件在这里派发
function RuneIllustrationView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close2 or go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_pTK then
        self:ChangeByProf(_G.CardProfType.Tank)
    elseif go == self.go_table.aorbtn_pZS then
        self:ChangeByProf(_G.CardProfType.Warrior)
    elseif go == self.go_table.aorbtn_pYX then
        self:ChangeByProf(_G.CardProfType.Ranger)
    elseif go == self.go_table.aorbtn_pFS then
        self:ChangeByProf(_G.CardProfType.Master)
    elseif go == self.go_table.aorbtn_pFZ then
        self:ChangeByProf(_G.CardProfType.Support)
    end
end

return RuneIllustrationView
