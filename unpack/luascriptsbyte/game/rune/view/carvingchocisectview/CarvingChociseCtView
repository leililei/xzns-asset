end

function CarvingChociseCtView:OnClickAttrItem(obj, ison, index)
    local name = obj:GetName()
    if name == "@_aorbtn_bg" then
        if self:IsChoise(index) then
            require("CarvingModel"):GetInstance():SetChocise(index, false)
            self.ChociseList[index] = false
        else
            require("CarvingModel"):GetInstance():SetChocise(index, true)
            self.ChociseList[index] = true
        end

        local count = #_G.ConfigManager.carving_filter_cfg
        self.go_table.scrollloopvectical_AttrList:UpdateCount(count, 0, 0, 0)
    end
end

function CarvingChociseCtView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_Sure then
        self:Close()
        if self.callback then
            self.callback()
            self.callback = nil
        end
    elseif go == self.go_table.aorbtn_Cancel then
        require("CarvingModel"):GetInstance():SetChociseList(self.OldList)
        require("CarvingModel"):GetInstance().ChociseNum = self.OldChoiseNum
        self:Close()
    end
