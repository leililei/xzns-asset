function CarvingChociseCtView:ShowRefreshCarvingPanel()
    self.go_table.obj_refreshpanel:SetActiveE(1)
    
    local count = #_G.ConfigManager.carving_filter_cfg

    self.go_table.scrollloopvectical_AttrList:UpdateCount(count)
end

function CarvingChociseCtView:RefreAttrIterm(index, obj)
    local index = index + 1
    local table = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickAttrItem,index))
    
    local data = _G.ConfigManager.carving_filter_cfg[index]

    table.aortext_attr.text = _G.GetLangPackValue(data.filter_num)
    table.obj_isOn:SetActiveE(self:IsChoise(index) and 1 or 0)
    local isGray = false
    isGray = (require("CarvingModel"):GetInstance().ChociseNum >= self.MaxNum and not self:IsChoise(index))
    
    table.aorimage_bg:SetGray(isGray)
    table.aorbtn_bg.enabled = not isGray
end

