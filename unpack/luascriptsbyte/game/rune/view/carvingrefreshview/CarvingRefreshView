function CarvingRefreshView:ShowAttrReItem(item, attr, type)
    local tb = _G.GetAutoGoTable(item)
    local name = ""
    ---@type attribute_cfg
    local attrb = _G.ConfigManager.attribute_cfg[attr.value]
    if attrb ~= nil then
        local attrc = attrb.attribute
        if not _G.table.isEmptyOrNil(attrc) then
            for i =1,#attrc do
                local key = attrc[1][1]
                local value_type = tonumber(attrc[1][2])
                local value = tonumber(attrc[1][3])
                if value_type == 2 then
                    name = name ..  (_G.AttrType[key].des .. " ".. string.format("%d%%", math.max(1, math.floor(value / 100))))
                else
                    name = name ..  (_G.AttrType[key].des .. " ".. value)
                end
            end
        else
            name = _G.GetLangPackValue(attrb.describe)
        end
    end
    tb.aortext_attr.text = name
end

function CarvingRefreshView:OnClickRefreshTipBtn(go, isOn)
    if go == self.attrRefreshTipsTab.aorbtn_Right or go == self.attrRefreshTipsTab.aorbtn_Close then
        local chooseType
        if go == self.attrRefreshTipsTab.aorbtn_Right then
            chooseType = 2
        else
            chooseType = 1
        end
        require("CarvingModel"):GetInstance():ChooseCarvingAttr(self.selectdata.uid, chooseType, function(msg)
            local _, StorageID = _G.StorageManager:GetInstance():CheckSidType(202060200)
            local costdata = _G.StorageManager:GetInstance():GetDataByID(StorageID)[202060200]
            costdata.count = costdata.count - self.cost
            self.selectdata = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Carving,
                self.selectdata.uid)
            local newatttr = {}
            for k, v in pairs(self.selectdata.attr) do
                if v.index == self.selectattrindex then
                    newatttr.sid = v.attr_sid
                    newatttr.value = v.attr_value
                end
            end
            self.selectdata.score = self.selectdata.scoreAttribute:CalculateArtifactPower()
            self:ShowRefreshCarvingPanel()
            self:refreshcallback()
            if self.selectdata.cardUid ~= 0 then 
                local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, self.selectdata.cardUid)
                cardData:UpdateCarvingData(msg.carvings[1])
            end
        end)
        self.go_table.obj_attrefreshTipView:SetActiveE(0)
    end
end

function CarvingRefreshView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_Refresh then
        if not self.selectdata then
            return
        end
        if self.selectattrindex == nil or self.selectattrindex == 0 then
            return
        end
        local _, StorageID = _G.StorageManager:GetInstance():CheckSidType(202060200)
        if self.cost > self.hasnum then

        else
            require("CarvingModel"):GetInstance():RestCarvingAttr(self.selectdata.uid, self.selectattrindex, function()
                self.selectdata = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Carving,
                    self.selectdata.uid)
                self:ShowAttrRefreshTipView()
            end)
        end
    elseif go == self.go_table.aorbtn_doleft then
        self.chooseIndex = self.chooseIndex - 1
        self.selectdata =  self.CurList[self.chooseIndex].carving
        self:UpdateView()
    elseif go == self.go_table.aorbtn_doright then
        self.chooseIndex = self.chooseIndex + 1
        self.selectdata =  self.CurList[self.chooseIndex].carving
        self:UpdateView()
    end
end

return CarvingRefreshView
