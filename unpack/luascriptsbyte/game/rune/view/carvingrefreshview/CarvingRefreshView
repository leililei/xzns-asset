function CarvingRefreshView:ShowRefreshCarvingPanel()
    self.go_table.obj_refreshpanel:SetActiveE(1)
    
        self.go_table.obj_root:ClearChildren()
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            { self.selectdata.sid },
            self.go_table.obj_root,
            function(tran)
                if _G.IsNil(self.go_table.obj_root) then
                    _G.DestroyObject(tran.gameObject)
                    return
                end

                tran:ShowSlotLevel(false)
            end,
            function()
            end
        )
        self.attrlist = {}
        self.nowrefreshAttrNum = 0
        for i = 1, table.count(self.selectdata.attr) do
            if self.selectdata.attr[i].is_lock == 1 then
                self.nowrefreshAttrNum = self.nowrefreshAttrNum + 1
            end
        end
        self:SetRefreshAttrNum()
        self:SetCostNum()
        local count = table.count(self.selectdata.attr)
        if self.attrscroll then
            if self.attrcount == count then
                self.attrscroll:UpdateAllItem()
            else
                self.attrscroll:UpdateCount(count)
                self.attrcount = count
            end
        else
            self.go_table.scrollloopvectical_AttrList:InitItemData(count, _G.handler(self, self.RefreAttrIterm))
            self.attrscroll = self.go_table.scrollloopvectical_AttrList
            self.attrcount = count
        end
        if self.selectdata.attr_cache and self.selectdata.attr_cache[1] then 
            self:ShowAttrRefreshTipView()
        end
        self:SetRefreshBtnGray(self.selectattrindex == 0)
end

function CarvingRefreshView:RefreAttrIterm(index, obj)
    local table = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickAttrItem, self.selectdata.attr[index + 1]
        .index))
    self.attrlist[self.selectdata.attr[index + 1].index] = table
    
    local name = self.selectdata:GetAddName(index + 1)

    table.aortext_attr.text = name
    table.obj_isOn:SetActiveE(self.selectdata.attr[index + 1].index == self.selectattrindex and 1 or 0)
    local isGray = false
    if self.nowrefreshAttrNum == self.maxRefreshNum then
        isGray = self.selectdata.attr[index + 1].is_lock == 0
    end
    if self.selectdata.cfg.grade >= self.mingrade then
        table.aorimage_bg:SetGray(isGray)
        table.aorbtn_bg.enabled = not isGray
    else
        table.aorimage_bg:SetGray(true)
        table.aorbtn_bg.enabled = false
    end
end

function CarvingRefreshView:formatValue(value)
    local str = _G.string.format("+%.2f%%", value)
    return _G.string.match(str, "^(.-)%.?0*$")
end

function CarvingRefreshView:OnClickAttrItem(obj, ison, index)
    local name = obj:GetName()
    if name == "@_aorbtn_bg" then
        if self.selectdata.cfg.grade >= self.mingrade then
            local islock = false
            for i = 1, table.count(self.selectdata.attr) do
                if self.selectdata.attr[i].index == index and self.selectdata.attr[i].is_lock == 1 then
                    islock = true
                end
            end
            if self.nowrefreshAttrNum < self.maxRefreshNum or islock then
                self.selectattrindex = index
            else
                return
            end
            for k, v in pairs(self.attrlist) do
                self.attrlist[k].obj_isOn:SetActiveE(k == index and 1 or 0)
            end
            self:SetRefreshBtnGray(self.hasnum < self.cost)
        end
    end
end

function CarvingRefreshView:SetRefreshBtnGray(isgray)
    self.go_table.aorimage_refresh:SetGray(isgray)
    self.go_table.aortext_refresh.color = _G.ColorTools.FormatColorByString(isgray and "474747" or "8C2D14")
end

function CarvingRefreshView:SetCostNum()
    local _, StorageID = _G.StorageManager:GetInstance():CheckSidType(202060200)
    self.hasnum = _G.StorageManager:GetInstance():GetItemCountByID(StorageID, 202060200)
    if not self.costlist then
        self.costlist = _G.ConfigManager.discrete_cfg[116128]
    end
    if self.selectdata.resetNum >= table.count(self.costlist) then
        self.cost = self.costlist[table.count(self.costlist)][2]
    else
        self.cost = self.costlist[self.selectdata.resetNum + 1][2]
    end
    local str
    str = string.format("<color=#%s>%s</color>", self.cost > self.hasnum and "c02214" or "96ce51", self.hasnum)
    self.go_table.aortext_Cost.text = string.format("%s/%s", str, self.cost)
end

