function CarvingRefreshView:OnCreate(callBack, cardUid, selectdata, cvcarduid, CarvingBar)
    self.refreshcallback = callBack
    self.cardUid = cardUid
    self.selectdata = selectdata
    self.cvcarduid = cvcarduid
    self.CarvingBar = CarvingBar

    self.chooseIndex = 0
    self.CurList = {}

    self.num =  0
    for i = 1, #self.CarvingBar do
        if self.CarvingBar[i].carving then
            self.num = self.num + 1
            if self.CarvingBar[i].carving.uid == self.selectdata.uid then
                self.chooseIndex = self.num
            end
            self.CurList[self.num] = self.CarvingBar[i]
        end
    end

    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))

    self:UpdateView()
end

function CarvingRefreshView:UpdateView()
    if self.cvcarduid > 0 then
        if self.num > 1 then
            self.go_table.aorbtn_doleft:SetActiveE(0)
            self.go_table.aorbtn_doright:SetActiveE(0)
            if self.chooseIndex > 1 then
                self.go_table.aorbtn_doleft:SetActiveE(1)
            end
            if self.chooseIndex < self.num then
                self.go_table.aorbtn_doright:SetActiveE(1)
            end
        else
            self.go_table.aorbtn_doleft:SetActiveE(0)
            self.go_table.aorbtn_doright:SetActiveE(0)
        end
    else
        self.go_table.aorbtn_doleft:SetActiveE(0)
        self.go_table.aorbtn_doright:SetActiveE(0)
    end

    self.go_table.aortext_name.text = _G.GetLangPackValue(self.selectdata.cfg.name)
    self.go_table.aortext_kmz.text = "圣徽值：" .. self.selectdata:GetAbyssalMaw()

    local list = {}
    for _, v in ipairs(baseAttribute) do
        if self.selectdata.cfg[v] and self.selectdata.cfg[v] > 0 then
            _G.table.insert(list, { key = v, value = self.selectdata.cfg[v] })
        end
    end

    self.go_table.obj_propGrid:RemoveAllChildren()

    local obj, tb
    for i, v in ipairs(list) do
        obj = _G.InstantiateObject(self.go_table.obj_propItem, self.go_table.obj_propGrid)
        tb = _G.GetAutoGoTable(obj)
        
        tb.gameObject:SetActiveE(1)
        tb.aortext_propName.text = _G.AttrType[v.key].des
        tb.aortext_propNum.text = "+" .. _G.GameUtil.NumberWY(v.value)
    end

    self.attrRefreshTipsTab = _G.GetAutoGoTable(self.go_table.obj_attrefreshTipView,
        _G.handler(self, self.OnClickRefreshTipBtn))
    self.mingrade = _G.ConfigManager.discrete_cfg[140001][1][1]

    if self.selectdata.cfg.grade >= self.mingrade then
        self.go_table.aorbtn_Refresh:SetActiveE(1)
        self.go_table.aortext_refreshtips:SetActiveE(1)
        self.go_table.aortext_Cost:SetActiveE(1)
    else
        self.go_table.aorbtn_Refresh:SetActiveE(0)
        self.go_table.aortext_refreshtips:SetActiveE(0)
        self.go_table.aortext_Cost:SetActiveE(0)
    end
    
    local costData = _G.StorageManager:GetStorageItemData(202060200)
    self.go_table.aorrawimage_icon:LoadImage(costData.Icon)
    
    self.selectattrindex = 0
    self:ShowRefreshCarvingPanel()
end

