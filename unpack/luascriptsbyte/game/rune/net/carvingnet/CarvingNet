require "BaseGameNet"
---@class CarvingNet : BaseGameNet	通信协议 圣徽
local CarvingNet = _G.BaseClass("CarvingNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return CarvingNet CarvingNet
function CarvingNet:GetInstance()
    return self.super.super.GetInstance(self)
end

function CarvingNet:AddMessageListeners()
    self:AddMessageListener(_G.ConfigManager.net_map.send_carving_update.Cmd, self.P2CCarvingUpdate)
end

function CarvingNet:P2CCarvingUpdate(msg)
    require("CarvingModel"):GetInstance():P2CCarvingUpdate(msg)
end

---穿戴请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function CarvingNet:SetCarvingAccess(pbdata, callback)
    local item = _G.ConfigManager.net_map.game_carving_set_carving
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

