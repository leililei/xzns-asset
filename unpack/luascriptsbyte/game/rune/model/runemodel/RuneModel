---@class RuneModel : Singleton    中文描述
local RuneModel = _G.BaseClass("RuneModel", _G.GameDataModelBase)

---四个部位
local PartLangKey = {
    _G.DecorationPart.ring,
    --项链
    _G.DecorationPart.necklace,
    --耳环
    _G.DecorationPart.earring,
    --披风
    _G.DecorationPart.cloak
}

---@return RuneModel RuneModel
function RuneModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function RuneModel:__init()
end

---计算当前卡牌的所有符文属性
function RuneModel:CalcRuneProp(cardData)
    local attribute = {}

    ---临时缓存属性
    local tempProp, tempEntryProp = {}, {}
    local baseProp, entryProp
    if cardData and cardData.DecorationBar then
        for _, v in pairs(cardData.DecorationBar) do
            if v and not _G.table.isEmptyOrNil(v.decoration) then
                baseProp, entryProp = v.decoration:GetPropList(v.slotLevel or 0)
                ---合并属性
                self:MergeProp(tempProp, tempEntryProp, baseProp, entryProp)
            end
        end
    end
    for k, v in pairs(tempProp) do
        _G.table.insert(attribute, { key = k, value = v.value, name = v.name })
    end
    for k, v in pairs(tempEntryProp) do
        _G.table.insert(attribute, { key = k, value = v.value, name = v.name, value_type = v.value_type })
    end
    return attribute
end

function RuneModel:MergeProp(tempProp, tempEntryProp, baseProp, entryProp)
    if baseProp then
        for k, v in pairs(baseProp) do
            if not tempProp[k] then
                tempProp[k] = {
                    value = v.value,
                    name = v.name
                }
            else
                tempProp[k].value = tempProp[k].value + v.value
            end
        end
    end

    if entryProp then
        for k, v in pairs(entryProp) do
            if not tempEntryProp[k] then
                tempEntryProp[k] = v
            else
                tempEntryProp[k].value = tempEntryProp[k].value + v.value
            end
        end
    end
end

---检测是否可以强化,需要其他槽位都满足最低等级
---@param cardData CardData 卡牌数据类
---@param strengLv number 当前强化槽位的等级
---@return boolean
function RuneModel:CheckCanStrength(cardData, strengLv)
    if cardData and cardData.DecorationBar then
        local cfg = _G.ConfigManager.decoration_stren_cfg[strengLv]
        -- 通过下一等级是否存在配置，判断当前等级是否为最大等级
        if not cfg or not _G.ConfigManager.decoration_stren_cfg[strengLv + 1] then
            return false
        end

        local decoData
        local slotLevel
        local count = 0
        for _, v in ipairs(PartLangKey) do
            decoData = cardData.DecorationBar[v]
            slotLevel = decoData and decoData.slotLevel or 0
            if slotLevel < cfg.min_level then
                return false
            end
            count = count + 1
        end

        ---需要四个部位都装备了符文，且满足条件了才能强化
        return count == 4
    end
    return false
end

---获取套装数量
---@param cardData CardData 卡牌数据类
---@param decoData DecorationData 符文数据类
function RuneModel:GetSuitNum(cardData, decoData)
    local suitNum = 0
    if cardData and cardData.DecorationBar then
        for _, v in pairs(cardData.DecorationBar) do
            if v and not _G.table.isEmptyOrNil(v.decoration) and v.decoration.suit == decoData.suit then
                suitNum = suitNum + 1
            end
        end
    end
    return suitNum
end

---通过是否存在下一级的配置，判断符文槽位是否为最大等级
---@param lv number 当前等级
function RuneModel:CheckIsRuneMaxLevel(lv)
    if _G.ConfigManager.decoration_stren_cfg[lv + 1] then
        return false
    else
        return true
    end
end

---检测当前部位是否穿戴符文
---@param cardData CardData 卡牌数据类
---@param parts numbe 当前部位
function RuneModel:HaveWearSune(cardData, parts)
    if cardData and cardData.DecorationBar then
        for _, v in pairs(cardData.DecorationBar) do
            if v and not _G.table.isEmptyOrNil(v.decoration) and v.decoration.parts == parts then
                return true
            end
        end
    end
    return false
end

---获得新符文（被分解的符文需要移除）
function RuneModel:GetNewRune(data)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.DecorationSlot.id)
end

---获取符文最大等级
function RuneModel:GetRuneMaxLv()
    if not self.maxLv then
        self.maxLv = 2
        local cfg = _G.ConfigManager.decoration_level_cfg
        for _, v in pairs(cfg) do
            self.maxLv = _G.math.max(self.maxLv,v.level)
        end
    end
    return self.maxLv
end

---强化需要的材料
---@param slotLevel number 槽位强化等级
---@return number,number
function RuneModel:GetStrenMaterial(slotLevel)
    local cfg = _G.ConfigManager.decoration_stren_cfg
    ---当前等级累计消耗
    local curLvCost = cfg[slotLevel].cost
    local id, num = curLvCost[1], curLvCost[2]
    if slotLevel ~= 0 then
        local lastLvCost = cfg[slotLevel - 1].cost
        num = num - lastLvCost[2]
    end
    return id, num
end

---销毁对象时,析构函数
function RuneModel:Dispose()
end

return RuneModel
