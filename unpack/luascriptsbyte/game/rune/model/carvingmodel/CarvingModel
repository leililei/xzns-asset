---刻魂系统的红点添加 只检测首次(显示红点),其他不在显示红点
function CarvingModel:UpdateFirstRedpoint(card, parts)
    if card == nil then
        return
    end
    local param = card.uid * 10 + parts
    if not card.soulLink_sign then
        card.soulLink_sign = true
    end
    --刷新红点
    require("RedPointManager"):GetInstance():RefreshNode(
        _G.ConfigManager.redpoint_cfg.EngraveSoul.id,
        param
    )
end

function CarvingModel:CheckOpenByPart(part, star)
    local isopen = true
    local starcondition = _G.ConfigManager.discrete_cfg[140002][part][2]
    if star < starcondition then
        isopen = false
    end
    local showcondition = _G.ConfigManager.discrete_cfg[140005][part]

    if not _G.GlobalConditionManager.CheckCondition(showcondition[1], showcondition[2]) then
        isopen = false
    end

    return isopen
end

---销毁对象时,析构函数
function CarvingModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.ResUpdata, self)
end

return CarvingModel
