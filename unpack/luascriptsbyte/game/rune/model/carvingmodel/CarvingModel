    local count, suit_count = 0
    local storage = _G.StorageManager:GetInstance():GetDataStorageByID(_G.StorageID.Card)
    count = storage:GetCarvingUseCount()
    suit_count = storage:GetSuit_count_noSame()
    storage:SetCarvingUseCount(count - num)
    storage:SetCarvingSuitCount(2, uid)
    ---填写 消息数据类型
    count = storage:GetCarvingUseCount()
    --("饰品：增删改查..数量：" .. count)
    suit_count = storage:GetSuit_count_noSame()
    --("饰品：套装（穿戴） 不同数量" .. suit_count)

    _G.Events:GetInstance():Broadcast(
        _G.ePlayAactionEvent.PlayAaction,
        { _G.ActiveTaskEnum.ConditionEnum.Equipment.CarvingAllWearCount },
        count,
        nil,
        true
    )

    _G.Events:GetInstance():Broadcast(
        _G.ePlayAactionEvent.PlayAaction,
        { _G.ActiveTaskEnum.ConditionEnum.Equipment.CarvingSuit4Count },
        suit_count,
        nil,
        true
    )
end

---@private
function CarvingModel:ShowPowerAndUp(decoData)
    if decoData.cardUid ~= 0 then
        local power = _G.StorageManager:GetInstance():GetPlayerPower()
        local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, decoData.cardUid)
        require("CardInfoManager"):GetInstance():Updata_CardViewUpdataFun(card)
        if (_G.StorageManager:GetInstance():GetPlayerPower() - power) > 0 then
            require "CommonTipManager".OpenPowerUpView(power, _G.StorageManager:GetInstance():GetPlayerPower() - power)
        end
    end
end

---转换  根据出入的品质 获得对应的数据信息
---@param grade number 品质
---@param target table 需要转换的数据
function CarvingModel:GetGradeToValue(grade, target)
    if target == nil then
        return nil
    end
    local tmep = {}
    for i = 1, #target do
        local id = target[i][1]
        if tmep[id] == nil then
            tmep[id] = 0
        end
        tmep[id] = target[i][2]
    end
    if tmep[grade] then
        return tmep[grade]
    else
        return nil
    end
end

---获取套装数量
---@return number 数量
function CarvingModel:GetSuitCount(sid)
    local count = 0
    local dList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Carving)

    for _, v in pairs(dList) do
        if v.cfg.suit == sid then
            count = count + 1
        end
    end
    return count
end

function CarvingModel:GetUpLevelLimit(lv, grade)
    local cfg = _G.ConfigManager.carving_stren_cfg
    local limit = 0
    if lv == 0 then
        limit = 0
    elseif lv > 0 then
        if cfg[lv] then
            limit = self:GetGradeToValue(grade, cfg[lv].points_up)
        else
            limit = 0
        end
    end
    return limit
end

