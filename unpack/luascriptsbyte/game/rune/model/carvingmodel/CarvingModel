---分解符文
function CarvingModel:Decompose(selectUid, uids, callback, isNoTip)
    require("CarvingNet"):GetInstance():Decompose(
        { uids = uids },
        function(msg)
            if msg.ack ~= 1 then
                return
            end

            local StorageManager = _G.StorageManager:GetInstance()
            for uid, v in pairs(selectUid) do
                StorageManager:ConsumeItem(v.sid, uid, 1)
            end
            StorageManager:ReceiveAwardData(msg)
            if not isNoTip then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            end
            require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.CarvingSlot.id)
            if callback then
                callback(msg)
            end
        end
    )
end

---穿戴/替换符文(单个)
---@param cardData CardData 卡牌数据类
---@param index number 穿戴部位
---@param carvingData CarvingData 符文数据类
function CarvingModel:PutOnCarving(cardData, index, carvingData, call)
    if cardData == nil or cardData.uid == nil then
        _G.LogError("【容错】符文穿戴卡牌uid为空！")
        return 
    end
    if carvingData == nil or carvingData.uid == nil then
        _G.LogError("【容错】符文穿戴符文uid为空！")
        return 
    end
    local msg = { uid = cardData.uid, d_index = { { index = index, uid = carvingData.uid } } }
    require("CarvingNet"):GetInstance():SetCarvingAccess(
        msg,
        _G.handlerbind(self, self.PutOnCarvingSuc, cardData, index, carvingData, call)
    )
end

---穿戴/替换符文(多个)
---@param cardData CardData 卡牌数据类
---@param index number 穿戴部位
---@param carvingDatas CarvingData[] 符文数据类
function CarvingModel:PutOnCarvings(cardData, carvingDatas, call)
    if cardData == nil or cardData.uid == nil then
        _G.LogError("【容错】符文穿戴卡牌uid为空！")
        return
    end
    if carvingDatas == nil or carvingDatas[1] == nil or carvingDatas[1].uid == nil then
        _G.LogError("【容错】符文穿戴符文uid为空！")
        return
    end
    local count = #carvingDatas
    local msg = { uid = cardData.uid, d_index = {} }
    local indexs = {}
    for i = 1, count do
        local carvingData = carvingDatas[i]
        local index = carvingData.cfg.parts
        local msg_item = { index = index, uid = carvingData.uid }
        table.insert(msg.d_index, msg_item)
        table.insert(indexs, index)
    end
    require("CarvingNet"):GetInstance():SetCarvingAccess(
            msg,
            _G.handlerbind(self, self.PutOnCarvingSucs, cardData, indexs, carvingDatas, call)
    )
end

function CarvingModel:PutOnCarvingSucs(msg, cardData, indexs, carvingDatas, call)
    if msg.ack ~= 1 then
        return
    end

    local power = _G.StorageManager:GetInstance():GetPlayerPower()
    local count = #carvingDatas
    for i = 1, count do
        local carvingData = carvingDatas[i]
        self:PutOnCarvingSuc(msg, cardData, indexs[i], carvingData)
    end

    local offset = _G.StorageManager:GetInstance():GetPlayerPower() - power
    if offset > 0 and call then
        call(power, offset)
    end

end

--穿戴/替换符文回调
function CarvingModel:PutOnCarvingSuc(msg, cardData, index, carvingData, call)
    if msg.ack ~= 1 then
        return
    end
    local decoData = cardData.CarvingBar[index]
    local power = _G.StorageManager:GetInstance():GetPlayerPower()
    if _G.table.isEmptyOrNil(decoData) or _G.table.isEmptyOrNil(decoData.carving) then
        ---被替换的符文被其他卡牌穿戴，需要卸下穿戴的符文即可
        if carvingData.cardUid ~= 0 then
            local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, carvingData.cardUid)
            if card then
                decoData.carving = nil
            end
        end
    else
        ---替换符文,先把身上穿戴的符文卸下来
        local data = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Carving, decoData.carving.uid)
        if data then
            data:PutCard(0)
        end
        if carvingData.cardUid ~= 0 then
            ---被替换的符文在其他卡牌身上需要卸下来
            if carvingData.cardUid ~= cardData.uid then
                local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, carvingData.cardUid)
                if card then
                    card.CarvingBar[index].carving = nil
                end
            end
        end
    end

    decoData.carving = carvingData or {}
    if not decoData.slotLevel then
        decoData.slotLevel = 0
        decoData.index = index
    end
    carvingData:PutCard(cardData.uid)

    cardData:CalcNowSumProp(_G.AttrFunType.Carving)
    require("CardInfoManager"):GetInstance():Updata_CardViewUpdataFun(cardData, true)
    local offset = _G.StorageManager:GetInstance():GetPlayerPower() - power
    --if offset > 0 then
    --    require "CommonTipManager".OpenPowerUpView(power, offset)
    --end


    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.CarvingStrength.id)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.CarvingSlot.id)

    if call then
        call(power, offset)
    end
end

