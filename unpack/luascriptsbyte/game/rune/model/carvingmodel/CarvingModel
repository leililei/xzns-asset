---创建对象时,入口构造函数
function CarvingModel:__init()
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.ResUpdata, self)
    require("CarvingNet"):GetInstance():StartUp()

    self.ChociseList = {}

    self.ChociseNum = 0
    local count = #_G.ConfigManager.carving_filter_cfg

    for i = 1, count do
        self.ChociseList[i] = false
    end
end

function CarvingModel:SetChociseList(value)
    self.ChociseList = value
end

function CarvingModel:GetChociseList()
