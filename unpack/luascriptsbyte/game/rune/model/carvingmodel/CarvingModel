---获取符文最大等级
function CarvingModel:GetCarvingMaxLv()
    if not self.maxLv then
        self.maxLv = 2
        local cfg = _G.ConfigManager.carving_level_cfg
        for _, v in pairs(cfg) do
            self.maxLv = _G.math.max(self.maxLv,v.level)
        end
    end
    return self.maxLv
end

---强化需要的材料
---@param slotLevel number 槽位强化等级
---@return number,number
function CarvingModel:GetStrenMaterial(slotLevel)
    local cfg = _G.ConfigManager.carving_stren_cfg
    ---当前等级累计消耗
    local curLvCost = cfg[slotLevel].cost
    local id, num = curLvCost[1], curLvCost[2]
    if slotLevel ~= 0 then
        local lastLvCost = cfg[slotLevel - 1].cost
        num = num - lastLvCost[2]
    end
    return id, num
end

function CarvingModel:ResUpdata(data)
    if not self.materialId then
        ---强化材料每级都相同所以直接取一级的
        local cfg = _G.ConfigManager.carving_stren_cfg[1]
        self.materialId = cfg.cost[1]
    end
    for _, value in pairs(data) do
        local sid = value.type[1]

        if sid == self.materialId then
            require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.CarvingStrength
                                                                              .id)
            return
        end
    end
end

