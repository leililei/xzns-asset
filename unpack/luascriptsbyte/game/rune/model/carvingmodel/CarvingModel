end

function CarvingModel:SetChocise(index, choicise)
    self.ChociseList[index] = choicise
    if choicise then
        self.ChociseNum = self.ChociseNum + 1
    else
        self.ChociseNum = self.ChociseNum - 1
    end
end

---计算当前卡牌的所有符文属性
function CarvingModel:CalcCarvingProp(cardData)
    local attribute = {}

    ---临时缓存属性
    local tempProp, tempEntryProp = {}, {}
    local baseProp, entryProp
    if cardData and cardData.CarvingBar then
        for _, v in pairs(cardData.CarvingBar) do
            if v and not _G.table.isEmptyOrNil(v.carving) then
                baseProp, entryProp = v.carving:GetPropList(v.slotLevel or 0)
                ---合并属性
                self:MergeProp(tempProp, tempEntryProp, baseProp, entryProp)
            end
        end
    end
    for k, v in pairs(tempProp) do
        _G.table.insert(attribute, { key = k, value = v.value, name = v.name })
    end
    for k, v in pairs(tempEntryProp) do
        _G.table.insert(attribute, { key = k, value = v.value, name = v.name, value_type = v.value_type })
    end
    return attribute
end

function CarvingModel:MergeProp(tempProp, tempEntryProp, baseProp, entryProp)
    if baseProp then
        for k, v in pairs(baseProp) do
            if not tempProp[k] then
                tempProp[k] = {
                    value = v.value,
                    name = v.name
                }
            else
                tempProp[k].value = tempProp[k].value + v.value
            end
        end
    end

    if entryProp then
        for k, v in pairs(entryProp) do
            if not tempEntryProp[k] then
                tempEntryProp[k] = v
            else
                tempEntryProp[k].value = tempEntryProp[k].value + v.value
            end
        end
    end
end

---检测是否可以强化,需要其他槽位都满足最低等级
---@param cardData CardData 卡牌数据类
---@param strengLv number 当前强化槽位的等级
---@return boolean
function CarvingModel:CheckCanStrength(cardData, strengLv)
    if cardData and cardData.CarvingBar then
        local cfg = _G.ConfigManager.carving_stren_cfg[strengLv]
        -- 通过下一等级是否存在配置，判断当前等级是否为最大等级
        if not cfg or not _G.ConfigManager.carving_stren_cfg[strengLv + 1] then
            return false
        end

        local carvData
        local slotLevel
        local count = 0
        for _, v in ipairs(PartLangKey) do
            carvData = cardData.CarvingBar[v]
            slotLevel = carvData and carvData.slotLevel or 0
            if slotLevel < cfg.min_level then
                return false
            end
            count = count + 1
        end

        ---需要四个部位都装备了符文，且满足条件了才能强化
        return count == 4
    end
    return false
end

---获取套装数量
---@param cardData CardData 卡牌数据类
---@param carvData CarvingData 符文数据类
function CarvingModel:GetSuitNum(cardData, carvData)
    local suitNum = 0
    if cardData and cardData.CarvingBar then
        for _, v in pairs(cardData.CarvingBar) do
            if v and not _G.table.isEmptyOrNil(v.carving) and v.carving.suit == carvData.suit then
                suitNum = suitNum + 1
            end
        end
    end
    return suitNum
end

---通过是否存在下一级的配置，判断符文槽位是否为最大等级
---@param lv number 当前等级
function CarvingModel:CheckIsCarvingMaxLevel(lv)
    if _G.ConfigManager.carving_stren_cfg[lv + 1] then
        return false
    else
        return true
    end
end

---检测当前部位是否穿戴符文
---@param cardData CardData 卡牌数据类
---@param parts numbe 当前部位
function CarvingModel:HaveWearSune(cardData, parts)
    if cardData and cardData.CarvingBar then
        for _, v in pairs(cardData.CarvingBar) do
            if v and not _G.table.isEmptyOrNil(v.carving) and v.carving.parts == parts then
                return true
            end
        end
    end
    return false
end

