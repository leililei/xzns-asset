--卡牌重置/升星等操作回退符文都放到服务器上，客户端更新数据即可
function CarvingModel:P2CCarvingUpdate(msg)
    if msg.carving_update then
        local decoData
        local cardUid
        local StorageManager = _G.StorageManager:GetInstance()
        for _, v in pairs(msg.carving_update) do
            decoData = StorageManager:GetDatasByUid(_G.StorageID.Carving, v.uid)
            if decoData then
                if not cardUid then
                    cardUid = decoData.cardUid
                end
                decoData:Parse(v)
            end
        end

        ---重置卡牌上的数据
        if cardUid then
            local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, cardUid)
            if cardData then
                for _, v in pairs(cardData.CarvingBar) do
                    if v and v.carving then
                        v.carving = nil
                    end
                end
            end
        end

        self.IsRebirth = true
        require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.CarvingSlot.id)
    end
end

