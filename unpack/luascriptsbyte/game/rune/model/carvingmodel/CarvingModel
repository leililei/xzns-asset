    require("CardInfoManager"):GetInstance():Updata_CardViewUpdataFun(cardData, true)

    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.CarvingStrength.id, cardData.uid)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.CarvingSlot.id)

    if call then
        call()
    end
