---@class RuneIllustrationModel : GameDataModelBase	中文描述
local RuneIllustrationModel = _G.BaseClass("RuneIllustrationModel", _G.GameDataModelBase)

---@return RuneIllustrationModel RuneIllustrationModel
function RuneIllustrationModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function RuneIllustrationModel:__init()
    self.obtainedList = {}
end

---@param msg illustrations.s2c_illustrations_info
function RuneIllustrationModel:ParseData(msg)
    for _, v in pairs(msg) do
        self.obtainedList[v.sid] = v.is_award
    end
    self:RefreshRedPoint()
end

---是否解锁图鉴
function RuneIllustrationModel:IsUnlockIll(sid)
    local isAward = self.obtainedList[sid]
    return isAward, isAward and isAward == 1
end

---添加图鉴
function RuneIllustrationModel:AddIllustrate(sid)
    local cfg = _G.ConfigManager.decoration_cfg
    if not self.obtainedList[sid] and cfg[sid].is_show == 1 then
        self.obtainedList[sid] = 0
        self:RefreshRedPoint()
    end
end

---领取图鉴奖励
function RuneIllustrationModel:GetIllAward(sid)
    if self.obtainedList[sid] then
        self.obtainedList[sid] = 1
    end
end

---奖励红点
function RuneIllustrationModel:CheckAwardRedPoint()
    if self.obtainedList then
        for _, v in pairs(self.obtainedList) do
            if v == 0 then
                return 1
            end
        end
    end
    return 0
end

function RuneIllustrationModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RuneIllustrate.id)
end

---一键领取所有图鉴奖励
function RuneIllustrationModel:GetAllULockRune()
    local list = {}
    for sid, v in pairs(self.obtainedList) do
        if v == 0 then
            _G.table.insert(list, sid)
        end
    end
    return list
end

---销毁对象时,析构函数
function RuneIllustrationModel:Dispose()
    self.obtainedList = {}
end

return RuneIllustrationModel
