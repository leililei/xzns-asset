function TalentView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function TalentView:OnClickTalentBtn()
    local carddata = require "TalentModel":GetInstance().CardData
    if require("CardInfoManager"):GetInstance():IsMaxUpStar(carddata) then
        _G.PopWindowManager:GetInstance():ShowAllTips(780113)
        return
    end
    ---点击天赋点加号
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.GetItemTsWayView.Name,
        self.CurrencyCfg.id,
        require "TalentModel":GetInstance().CanUseTalent,
        carddata
    )
end

