function TalentView:OnCreate()
    self.Xiaodian = {
        _G.ConfigManager.ui_effect_cfg.ef_xiaotianfuguangxiao_yellow,
        _G.ConfigManager.ui_effect_cfg.ef_xiaotianfuguangxiao_red,
        _G.ConfigManager.ui_effect_cfg.ef_xiaotianfuguangxiao_blue,
        _G.ConfigManager.ui_effect_cfg.ef_xiaotianfuguangxiao_green,
        _G.ConfigManager.ui_effect_cfg.ef_xiaotianfuguangxiao_purple
    }

    self.Dadian = {
        _G.ConfigManager.ui_effect_cfg.ef_datianfuguangxiao_yellow,
        _G.ConfigManager.ui_effect_cfg.ef_datianfuguangxiao_red,
        _G.ConfigManager.ui_effect_cfg.ef_datianfuguangxiao_blue,
        _G.ConfigManager.ui_effect_cfg.ef_datianfuguangxiao_green,
        _G.ConfigManager.ui_effect_cfg.ef_datianfuguangxiao_purple
    }
    self.Efline = {
        _G.ConfigManager.ui_effect_cfg.ef_tianfulianxian_yellow,
        _G.ConfigManager.ui_effect_cfg.ef_tianfulianxian_red,
        _G.ConfigManager.ui_effect_cfg.ef_tianfulianxian_blue,
        _G.ConfigManager.ui_effect_cfg.ef_tianfulianxian_green,
        _G.ConfigManager.ui_effect_cfg.ef_tianfulianxian_purple
    }
    ---@type CardData
    local carddata = require "TalentModel":GetInstance().CardData
    self.CardUid = carddata.uid
    self.CardCfg = _G.ConfigManager.card_cfg[carddata.sid]
    self.Talent = self.CardCfg.talent
    self.isOpen = _G.ConfigManager.discrete_cfg[107401][1][1] <= carddata.star


    require "TalentModel":GetInstance().BigPoint = {}

    self.CurrencyCfg = _G.ConfigManager.currency_type_cfg[57]

    self.go_table.aorrawimage_mapIcon:LoadImage(diwens[self.CardCfg.Professional])
    self.go_table.aortext_lmName.text = _G.GetLangPackValue(names[self.CardCfg.Professional])

    self.LockEffects = {}

    self.PointObjs = {}
    self.LineObjs = {}

    self.go_table.obj_lineParent:SetActiveE(0)
    self.go_table.obj_itemParent:SetActiveE(0)

    if carddata.type == _G.CardType.Timer or require "TalentModel":GetInstance().isPreview then
        require "TalentModel":GetInstance():SetLocalInfo()
        self:BackInbornInfo(false)
    else
        self:AddComponent(
            self.go_table.obj_resourceRoot,
            require("ResourceCompont").New(
                self.go_table.obj_resourceRoot,
                {
                    202010301
                }
            )
        )

        require "TalentModel":GetInstance():GetTalentInfo(_G.handlerbind(self, self.BackInbornInfo, true))
    end

    self.go_table.obj_title:SetActiveE(self.isOpen and 1 or 0)
end

function TalentView:BackInbornInfo(showRes)
    self.ResGotable = _G.GetAutoGoTable(self.go_table.obj_talentInfo, _G.handler(self, self.OnClickTalentBtn))
    if showRes then
        self.ResGotable.aorrawimage_icon:LoadImage(self.CurrencyCfg.icon)
        self.ResGotable.aortext_num.text = require "TalentModel":GetInstance().CanUseTalent
        self.ResGotable.gameObject:SetActiveE(1)
    else
        self.ResGotable.gameObject:SetActiveE(0)
    end
    self:CreatePoint()

    local onePoint
    for _, value in pairs(self.PointObjs) do
        if value.index == 2 then
            onePoint = value
            break
        end
    end

    ---@type CardData
    local carddata = require "TalentModel":GetInstance().CardData
    if carddata.type ~= _G.CardType.Timer and not require "TalentModel":GetInstance().isPreview then
        if not self:IsCanUnlock(onePoint.befortt) then
            --self:ShowBeforLockEffect(onePoint.befortt)
            local info = self.PointObjs[onePoint.befortt[1]]
            self:ClickPoint(nil, nil, info.cfg.id)
        end
    end
end

---加载完成
function TalentView:CheckFinish()
    self.go_table.obj_lineParent:SetActiveE(1)
    self.go_table.obj_itemParent:SetActiveE(1)
end

function TalentView:CreatePoint()
    local index = 0
    local skillIndex = 0
    local total = 0
    for i = 1, #self.Talent do
        local befortt
        if i > 1 then
            befortt = self.Talent[i - 1]
        end
        local tt = self.Talent[i]
        total = total + #tt
        for j = 1, #tt do
            ---@type attribute_cfg
            local cfg = _G.ConfigManager.attribute_cfg[tt[j]]
            index = index + 1

            local isendpoint = (i == #self.Talent)

            local isOpen = require "TalentModel":GetInstance():CheckPointOpen(cfg.id)
            local point = self.go_table.obj_itemParent:GetChildE(index - 1)

            local pgotable = _G.GetAutoGoTable(point, _G.handlerbind(self, self.ClickPoint, cfg.id))

            ---属性点
            if cfg.skill <= 0 then
                pgotable.aorrawimage_openIcon:LoadImage(
                    cfg.icon,
                    function()
                        pgotable.aorimage_openDi.SpriteName = ditus[self.CardCfg.Professional]
                        ---最后一个点特殊化为PVP点，不修改颜色
                        if not isendpoint then
                            pgotable.aorrawimage_openIcon.color =
                                require("CardInfoManager").GetColorFromRGB(colors[self.CardCfg.Professional])
                        else
                            pgotable.aortext_openName.text = _G.GetLangPackValue(cfg.name)
                            pgotable.aorimage_signbg:SetActiveE(0)
                            table.insert(require "TalentModel":GetInstance().BigPoint, cfg.id)
                        end

                        self:CheckFinish(index, total)
                    end
                )
            else
                ---技能点
                ---@type card_skills_cfg
                local skillCfg = _G.ConfigManager.card_skills_cfg[cfg.skill]
                pgotable.aorrawimage_openIcon:LoadImage(
                    skillCfg.icon,
                    function()
                        self:CheckFinish(index, total)
                    end
                )
                pgotable.aortext_openName.text = _G.GetLangPackValue(skillCfg.name1)
                skillIndex = skillIndex + 1
                pgotable.aortext_sign.text = skillSign[skillIndex]

                table.insert(require "TalentModel":GetInstance().BigPoint, cfg.id)
            end

            _G.GameUtil.SetActiveByCondition(pgotable.obj_active, isOpen)
            if isOpen then
                if cfg.skill <= 0 then
                    if not isendpoint then
                        _G.UIUtils.LoadEffectByCfg(self.Xiaodian[self.CardCfg.Professional], pgotable.obj_active)
                    else
                        _G.UIUtils.LoadEffectByCfg(self.Dadian[self.CardCfg.Professional], pgotable.obj_active)
                    end
                else
                    _G.UIUtils.LoadEffectByCfg(self.Dadian[self.CardCfg.Professional], pgotable.obj_active)
                end
            end

            local info = {}
            info.gotable = pgotable
            info.index = index
            info.cfg = cfg
            info.befortt = befortt
            info.isendpoint = isendpoint
            info.skillIndex = skillIndex
            self.PointObjs[cfg.id] = info
        end
    end

    index = 0
    for i = 1, #self.Talent do
        if i + 1 > #self.Talent then
            break
        end
        local cur = self.Talent[i]
        local next = self.Talent[i + 1]
        for j = 1, #cur do
            for k = 1, #next do
                index = index + 1
                local log = cur[j] .. "-" .. next[k]

                if _G.AppSetting.DEBUG then
                    _G.Log(log, "当前连接的点")
                end
                local isOpen1 = require "TalentModel":GetInstance():CheckPointOpen(cur[j])
                local isOpen2 = require "TalentModel":GetInstance():CheckPointOpen(next[k])

                local line = self.go_table.obj_lineParent:GetChildE(index - 1)
                local lineGotable = _G.GetAutoGoTable(line)

                local isActive = isOpen1 and isOpen2
                _G.GameUtil.SetActiveByCondition(lineGotable.obj_openLineTrans, isActive)
                _G.GameUtil.SetActiveByCondition(lineGotable.obj_notOpenLineTrans, not isActive)

                lineGotable.aorimage_notOpenLineTrans.fillAmount = linelen[index]

                if isActive then
                    local soc = lineGotable.aorimage_notOpenLineTrans.fillAmount / 0.9
                    lineGotable.obj_openLineTrans:SetLocalScale(soc, soc)
                    _G.UIUtils.LoadEffectByCfg(
                        self.Efline[self.CardCfg.Professional],
                        lineGotable.obj_openLineTrans,
                        function(obj)
                            obj:SetAnchorPosition(0, 0)
                        end
                    )
                end

                local info = {}
                info.gotable = lineGotable
                info.index = index
                info.startp = cur[j]
                info.endp = next[k]
                self.LineObjs[index] = info
            end
        end
    end
end

function TalentView:MoveToLeftMiddle(point)
    local x, y, z = point:GetAnchorPosition()
    self.go_table.obj_Content:GetComponentE(typeof(CS.UnityEngine.RectTransform)):DOAnchorPosX(-(700 + x), 0.5)
end

function TalentView:ShowBeforLockEffect(beforTT)
    for i = 1, #beforTT do
        local info = self.PointObjs[beforTT[i]]
        if not info.isAddTipsEffect then
            info.isAddTipsEffect = true
            _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.Ef_yindaodianji, info.gotable.obj_lockeffect)
        end
        info.gotable.obj_lockeffect:SetActiveE(1)
        table.insert(self.LockEffects, beforTT[i])
    end
end

function TalentView:HideBeforLockEffect(beforTT)
    for i = 1, #beforTT do
        local info = self.PointObjs[beforTT[i]]
        info.gotable.obj_lockeffect:SetActiveE(0)
    end
end

---激活一个点位
function TalentView:ActivePoint(id)
    local info = self.PointObjs[id]
    info.gotable.obj_active:SetActiveE(1)
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_tianfudianjihuochenggong,
        info.gotable.obj_active,
        function()
            if info.cfg.skill <= 0 then
                if not info.isendpoint then
                    _G.UIUtils.LoadEffectByCfg(self.Xiaodian[self.CardCfg.Professional], info.gotable.obj_active)
                else
                    _G.UIUtils.LoadEffectByCfg(self.Dadian[self.CardCfg.Professional], info.gotable.obj_active)
                end
            else
                _G.UIUtils.LoadEffectByCfg(self.Dadian[self.CardCfg.Professional], info.gotable.obj_active)
            end
        end
    )
    require "TalentModel":GetInstance():ActivePoint(id, info.cfg.skill > 0)
end

---更新连线表现
function TalentView:UpdateLine(id)
    for i = 1, #self.LineObjs do
        local info = self.LineObjs[i]
        if info.startp == id then
            if require "TalentModel":GetInstance():CheckPointOpen(info.endp) then
                --连线OK，点亮连线
                info.gotable.obj_openLineTrans:SetActiveE(1)
                info.gotable.obj_notOpenLineTrans:SetActiveE(0)
                local soc = info.gotable.aorimage_notOpenLineTrans.fillAmount / 0.9
                info.gotable.obj_openLineTrans:SetLocalScale(soc, soc)

                _G.UIUtils.LoadEffectByCfg(
                    self.Efline[self.CardCfg.Professional],
                    info.gotable.obj_openLineTrans,
                    function(obj)
                        obj:SetAnchorPosition(0, 0, 0)
                    end
                )
            end
        elseif info.endp == id then
            if require "TalentModel":GetInstance():CheckPointOpen(info.startp) then
                --连线OK，点亮连线
                info.gotable.obj_openLineTrans:SetActiveE(1)
                info.gotable.obj_notOpenLineTrans:SetActiveE(0)
                local soc = info.gotable.aorimage_notOpenLineTrans.fillAmount / 0.9
                info.gotable.obj_openLineTrans:SetLocalScale(soc, soc)
                _G.UIUtils.LoadEffectByCfg(
                    self.Efline[self.CardCfg.Professional],
                    info.gotable.obj_openLineTrans,
                    function(obj)
                        obj:SetAnchorPosition(0, 0)
                    end
                )
            end
        end
    end
end

function TalentView:ClickPoint(go, isOn, id)
    if _G.AppSetting.DEBUG then
        _G.Log(id, "点击一个天赋点")
    end
    local info = self.PointObjs[id]

    require "TalentModel":GetInstance():UpdateLast()

    self:MoveToLeftMiddle(info.gotable.transform)

    if self.LockEffects then
        self:HideBeforLockEffect(self.LockEffects)
        self.LockEffects = {}
    end

    -- if not self:IsCanUnlock(info.befortt) then
    --     self:ShowBeforLockEffect(info.befortt)
    -- end

    if self.ChooseTalent then
        self.ChooseTalent:SetActiveE(0)
    end

    self.ChooseTalent = info.gotable.aorimage_choose
    self.ChooseTalent:SetActiveE(1)

    self.go_table.obj_active:SetActiveE(1)
    if nil == self.infoView then
        self.infoView =
        self:AddComponent(
            self.go_table.obj_active,
            require("TalentInfoView").New(self.go_table.obj_active, self.CardUid, self.CardCfg, info, self)
            )
    else
        self.infoView:OnUpdateView(self.CardUid, self.CardCfg, info)
    end
end

function TalentView:IsCanUnlock(beforTT)
    local canUnLock = false
    if nil == beforTT then
        return true
    end
    for i = 1, #beforTT do
        if require "TalentModel":GetInstance():CheckPointOpen(beforTT[i]) then
            canUnLock = true
            break
        end
    end
    return canUnLock
end

function TalentView:ActiveOne(id)
    self:ActivePoint(id)
    self:UpdateLine(id)
    self.ResGotable.aortext_num.text = require "TalentModel":GetInstance().CanUseTalent
end

