local TalentNet = require "TalentNet"
---@class TalentInfoView : Component	天赋信息界面
---@field public go_table TakeOutGameView_GoTable GoTable
---@field CardUid number 卡片UID
---@field CardCfg card_cfg 卡片配置
---@field Cfg attribute_cfg 属性配置
---@field CurrencyCfg currency_type_cfg 天赋点配置
---@field Item item_cfg 通用材料配置
local TalentInfoView = _G.BaseClass("TalentInfoView", _G.Component)

local icons = {
    "ui_lm_txt_shou",
    "ui_lm_txt_dou",
    "ui_lm_txt_shu",
    "ui_lm_txt_fu",
    "ui_lm_txt_xu"
}

local skillSign = {
    "I",
    "II"
}

---界面的入口函数
---@param talentView TalentView 天赋
function TalentInfoView:OnCreate(obj, cardUid, cardCfg, info, talentView)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.CardUid = cardUid
    self.CardCfg = cardCfg
    self.Cfg = info.cfg
    self.IsEndPoint = info.isendpoint
    self.BeforTT = info.befortt
    self.SkillIndex = info.skillIndex
    self.TalentView = talentView

    self.CurrencyCfg = _G.ConfigManager.currency_type_cfg[57]
    self.Item = _G.ConfigManager.item_cfg[202010301]

    self.ClickThis = false

    self.AttrItems = {self.go_table.aortext_attrName1, self.go_table.aortext_attrName2}

    _G.SetEventTrigger(obj, "onDown", _G.handler(self, self.OnPointDown))
    _G.SetEventTrigger(obj, "onUp", _G.handler(self, self.OnPointUp))
    --_G.Events:GetInstance():AddListener(_G.eSelectSystemCurrent.SelectCurrent, self.OnSelectCurrent, self)

    self:ShowInfo()
end

function TalentInfoView:OnSelectCurrent(systemCurrentName)
    local helpView = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name)
    local wayView = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name)
    local wayTsView = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.GetItemTsWayView.Name)
    if helpView or wayView or wayTsView then
        return
    end
    if systemCurrentName == "" then
        if not self.ClickThis then
            self.go_table.gameObject:SetActiveE(0)
            self.TalentView:BackTalentView()
        end
    end
end

function TalentInfoView:OnPointDown()
    self.ClickThis = true
end

function TalentInfoView:OnPointUp()
    self.ClickThis = false
end

function TalentInfoView:OnUpdateView(cardUid, cardCfg, info)
    self.CardUid = cardUid
    self.CardCfg = cardCfg
    self.Cfg = info.cfg
    self.IsEndPoint = info.isendpoint
    self.BeforTT = info.befortt
    self.SkillIndex = info.skillIndex
    self.go_table.gameObject:SetActiveE(1)
    self:ShowInfo()
end

function TalentInfoView:ShowInfo()
    self.go_table.aorimage_Icon.SpriteName = icons[self.CardCfg.Professional]
    self.go_table.aortext_Name = _G.GetLangPackValue(self.Cfg.name)

    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_attrhelp, self.IsEndPoint)

    if self.Cfg.skill > 0 then
        self.go_table.obj_skillparent:SetActiveE(1)
        ---@type card_skills_cfg
        local skillcfg = _G.ConfigManager.card_skills_cfg[self.Cfg.skill]
        self.go_table.aorrawimage_newicon:LoadImage(skillcfg.icon)
        self.go_table.aortext_newname.text = _G.GetLangPackValue(skillcfg.name1)
        self.go_table.aortext_newdesc.text = _G.GetLangPackValue(skillcfg.describe1)
        self.go_table.aortext_newsign.text = skillSign[self.SkillIndex]

        _G.GameUtil.ReBuildRTF(self.go_table.obj_newcont)
    else
        self.go_table.obj_skillparent:SetActiveE(0)
    end

    self:UpdateInfoView()

    if #self.Cfg.attribute > 0 then
        self.go_table.obj_attrparent:SetActiveE(1)

        self.go_table.aortext_attrInfo.text = _G.GetLangPackValue(self.Cfg.describe)

        self.go_table.aortext_attrsubtitle.text = _G.GetLangPackValue(self.Cfg.subtitle)

        for i = 1, #self.AttrItems do
            local tt = self.AttrItems[i]
            if i > #self.Cfg.attribute then
                tt:SetActiveE(0)
            else
                local data = self.Cfg.attribute[i]
                local attrKey = data[1]
                local attrName = _G.GetLangPackValue(_G.ConfigManager.type_attribute_cfg[_G.AttrType[attrKey].ID].name)
                local attrType = _G.tonumber(data[2])
                local attrValue = _G.tonumber(data[3])
                --local value = _G.AttributeClassManager:GetInstance():GetValueWithName(attrKey, attrType, attrValue)

                local ttvalue = tt:GetChildE(0):GetComponentE(_G.typeof(_G.CS.AorText))

                if attrType == 1 then
                    if _G.AttrType[attrKey].percentage == 1 then
                        ttvalue.text = "+" .. attrValue / 100 .. "%"
                    else
                        ttvalue.text = "+" .. attrValue
                    end
                else
                    ttvalue.text = "+" .. attrValue / 100 .. "%"
                end

                tt:SetActiveE(1)

                tt.text = attrName
            end
        end
    else
        self.go_table.obj_attrparent:SetActiveE(0)
    end
end

function TalentInfoView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eSelectSystemCurrent.SelectCurrent, self.OnSelectCurrent, self)
end

function TalentInfoView:IsCanUnlock()
    local canUnLock = false
    if nil == self.BeforTT then
        return true
    end
    for i = 1, #self.BeforTT do
        if require "TalentModel":GetInstance():CheckPointOpen(self.BeforTT[i]) then
            canUnLock = true
            break
        end
    end
    return canUnLock
end

---按钮点击事件在这里派发
function TalentInfoView:OnClickBtn(go)
    if go == self.go_table.aorbtn_Active then
        ---@type CardData
        local carddata = require "TalentModel":GetInstance().CardData
        if carddata.type == _G.CardType.Timer then
            _G.PopWindowManager:GetInstance():ShowAllTips(790101)
            ---不能解锁
            return
        end
        if require "TalentModel":GetInstance().isPreview then
            _G.PopWindowManager:GetInstance():ShowAllTips(800101)
            ---不能解锁
            return
        end
        if not self:IsCanUnlock() then
            _G.PopWindowManager:GetInstance():ShowAllTips(780110)
            ---不能解锁
            self.TalentView:ShowBeforLockEffect(self.BeforTT)
            self.go_table.gameObject:SetActiveE(0)
            self.TalentView:BackTalentView()
            return
        end
        --天赋点不够
        if self.CanUseTalent < self.NeedTalent then
            ---材料使用上限
            if
                require "TalentModel":GetInstance().UsedMatrialNum >=
                    require "TalentModel":GetInstance():MaxUseMatrialNum()
             then
                _G.PopWindowManager:GetInstance():ShowAllTips(
                    780112,
                    nil,
                    nil,
                    nil,
                    nil,
                    false,
                    require "TalentModel":GetInstance():MaxUseMatrialNum()
                )
                ---不能解锁
                return
            else
                if self.CurMatrialNum < self.NeedMatrial then
                    _G.PopWindowManager:GetInstance():ShowAllTips(780111)
                    ---不能解锁
                    return
                end
            end
        end

        --激活天赋点
        local msg = {}
        msg.card_uid = self.CardUid
        msg.tid = self.Cfg.id
        TalentNet:GetInstance():UnlockPoint(msg, _G.handler(self, self.ActiveOneTalent))
    elseif go == self.go_table.aorbtn_attrhelp then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 58)
    end
end

function TalentInfoView:UpdateInfoView()
    ---@type TalentModel
    local model = require "TalentModel":GetInstance()
    ---@type CardData
    local carddata = require "TalentModel":GetInstance().CardData
    if carddata.type == _G.CardType.Timer then
        self.go_table.aortext_swortj.text = _G.GetLangPackValue(90029000004)
        self.go_table.obj_notactive:SetActiveE(0)
        self.go_table.obj_actived:SetActiveE(0)
        self.go_table.obj_swortj:SetActiveE(1)
    elseif require "TalentModel":GetInstance().isPreview then
        self.go_table.aortext_swortj.text = _G.GetLangPackValue(90000010693)
        self.go_table.obj_notactive:SetActiveE(0)
        self.go_table.obj_actived:SetActiveE(0)
        self.go_table.obj_swortj:SetActiveE(1)
    else
        local isOpen = model:CheckPointOpen(self.Cfg.id)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_notactive, not isOpen)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_actived, isOpen)
        self.go_table.obj_swortj:SetActiveE(0)

        if carddata.star < _G.ConfigManager.discrete_cfg[107401][1][1] then
            self.go_table.obj_notactive:SetActiveE(0)
            self.go_table.aortext_notOpen:SetActiveE(1)
        else
            self.go_table.aortext_notOpen:SetActiveE(0)
        end
    end

    local mat1 = false
    local mat2 = false
    self.CanUseTalent = model.CanUseTalent
    self.NeedTalent = model:TalenNeedNum()
    self.go_table.aortext_mat1.text = self.NeedTalent
    if self.CanUseTalent >= self.NeedTalent then
        mat1 = true
        self.go_table.aortext_mat1.color = _G.Color.New(211 / 255, 215 / 255, 242 / 255, 1)
    else
        self.go_table.aortext_mat1.color = _G.Color.red
    end

    local sid, num = model:MaxMatrialNum()
    local matrialNum = _G.StorageManager:GetInstance():GetItemCountByID(102, sid)
    self.CurMatrialNum = matrialNum
    self.NeedMatrial = num

    self.go_table.aortext_mat2.text = num
    if matrialNum >= num then
        mat2 = true
        self.go_table.aortext_mat2.color = _G.Color.New(211 / 255, 215 / 255, 242 / 255, 1)
    else
        self.go_table.aortext_mat2.color = _G.Color.red
    end

    self.go_table.aorrawimage_lmnuminfo:LoadImage(self.CurrencyCfg.icon)
    self.go_table.aorrawimage_matrialnuminfo:LoadImage(self.Item.Icon)

    if mat1 then
        self.go_table.obj_lmnuminfo:SetActiveE(1)
        self.go_table.obj_matrialnuminfo:SetActiveE(0)
    else
        self.go_table.obj_lmnuminfo:SetActiveE(0)
        self.go_table.obj_matrialnuminfo:SetActiveE(1)
    end

    if mat1 or mat2 then
        self.go_table.aortext_Active.color = require("CardInfoManager").GetColorFromRGB("8F4602")
        self.go_table.aorbtn_Active:SetGray(false)
    else
        self.go_table.aortext_Active.color = require("CardInfoManager").GetColorFromRGB("5A5A5A")
        self.go_table.aorbtn_Active:SetGray(true)
    end

    _G.GameUtil.ReBuildRTF(self.go_table.aortext_mat1)
    _G.GameUtil.ReBuildRTF(self.go_table.aortext_mat2)
    _G.GameUtil.ReBuildRTF(self.go_table.obj_numinfo)
end

function TalentInfoView:ActiveOneTalent(msg)
    if msg.ack == 1 then
        if self.CanUseTalent >= self.NeedTalent then
            require "TalentModel":GetInstance():ConsumeTalent(self.NeedTalent)
        else
            local sid, num = require "TalentModel":GetInstance():MaxMatrialNum()
            _G.StorageManager:GetInstance():ConsumeItem(sid, 0, num)

            require "TalentModel":GetInstance():UpdateUseMatrial(num)
        end

        local bigPoint = require "TalentModel":GetInstance().BigPoint
        local bpIndex = 0
        for i = 1, #bigPoint do
            if bigPoint[i] == self.Cfg.id then
                bpIndex = i
                break
            end
        end

        self.go_table.gameObject:SetActiveE(0)
        self.TalentView:BackTalentView()

        self.TalentView:ActiveOne(self.Cfg.id)

        self:UpdateInfoView()
        if #self.Cfg.attribute > 0 then
            require "TalentModel":GetInstance():UpdateCard()
            _G.PopWindowManager:GetInstance():ShowAllTips(780109)
        end

        if self.Cfg.skill > 0 then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TalentActivateView.Name, self.Cfg.skill)
        end

        ---@type CardData
        local carddata = require "TalentModel":GetInstance().CardData
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.TalentButton.id, 666)
        require "RedPointManager":GetInstance():RefreshNode(
            _G.ConfigManager.redpoint_cfg.TalentCultivate.id,
            carddata.uid
        )

        _G.Events:GetInstance():Broadcast(_G.ChatViewEvents.ChatViewTianFv, carddata, bpIndex)

        _G.Events:GetInstance():Broadcast(_G.eTalent.TalentActiveFinish, carddata.sid, #carddata.open_inborn)
    end
end

return TalentInfoView
