---@class TalentActivateView : UIBaseView	中文描述
---@field public go_table TalentActivateView_GoTable GoTable
local TalentActivateView = _G.BaseClass("TalentActivateView", _G.UIBaseView)
--_G.TalentActivateView = TalentActivateView
function TalentActivateView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param data CombineData
function TalentActivateView:OnCreate(skill, closeCall)
    self.CloseCall = closeCall
    local cfg = _G.ConfigManager.card_skills_cfg[skill]
    if cfg then
        if not string.IsNullOrEmpty(cfg.icon) then
            self.go_table.aorrawimage_icon:LoadImage(cfg.icon)
        end
        self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(cfg.name1)
        self.go_table.aortext_desc.text = _G.LangUtil.GetLangPackValue(cfg.describe1)

        _G.GameUtil.ReBuildRTF(self.go_table.obj_Content)
        self.canclick = false
    end
    _G.DelayDo(
        0.9,
        function()
            self.canclick = true
        end
    )
end

---按钮点击事件在这里派发
function TalentActivateView:OnClickBtn(go, isOn)
    if not self.canclick then
        return
    end
    if go == self.go_table.aorbtn_close then
        if self.CloseCall then
            self.CloseCall()
        end
        self:Close()
    end
end

return TalentActivateView
