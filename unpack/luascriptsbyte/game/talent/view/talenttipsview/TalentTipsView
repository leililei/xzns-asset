local SkillTipView = require "SkillTipView"
---@class TalentTipsView : Component	中文描述
local TalentTipsView = _G.BaseClass("TalentTipsView", SkillTipView)

local CS = _G.CS
local typeof = _G.typeof

---创建对象时,入口构造函数
function TalentTipsView:OnCreate()
end

---销毁对象时,析构函数
function TalentTipsView:OnDestroy()
end

function TalentTipsView:Init(data, callFunction)
    self.go_table.aorrawimage_Skill:LoadImage(data.icon)
    self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(data.name1)
    self.skillDesEx = self.go_table.obj_SkillDes:GetComponentE(_G.typeof(_G.CS.ExtendText))
    self.skillDesEx.text = _G.LangUtil.GetLangPackValue(data.describe1)
    --self.go_table.aortext_SkillDes.text = _G.LangUtil.GetLangPackValue(data.describe1)
    self.go_table.aortext_skillDescribe:SetActiveE(0)
end
function TalentTipsView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Close then
        if self.callback then
            self.callback()
            self.callback = nil
        end
        self.view:CloseTip(_G.TipType.Talent)
    end
end
return TalentTipsView
