---@class TalentNet : BaseGameNet	卡片天赋
local TalentNet = _G.BaseClass("TalentNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return TalentNet TalentNet
function TalentNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---获取卡牌天赋信息
---@param pbData table PB数据
---@param callback function 完成回调
function TalentNet:GetInbornInfo(pbData, callback)
    local item = _G.ConfigManager.net_map.game_inborn_info
    local port = base.Access(self, item, pbData, _G.handler(self, self.GetSuccess))
    self.Call[port] = callback
end

--解锁卡牌天赋
---@param pbData table PB数据
---@param callback function 完成回调
function TalentNet:UnlockPoint(pbData, callback)
    local item = _G.ConfigManager.net_map.game_inborn_unlock
    local port = base.Access(self, item, pbData, _G.handler(self, self.GetSuccess))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function TalentNet:GetSuccess(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type TalentNet
return TalentNet
