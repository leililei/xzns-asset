local TalentNet = require "TalentNet"

local base = require "GameDataModelBase"

---@class TalentModel : GameDataModelBase	中文描述
---@field GetInstance fun():TalentModel
---@field CardData CardData 卡片信息
---@field CanseTalent number 卡牌可以使用的天赋点
---@field UsedMatrialNum number 卡牌身上已使用的材料数量
---@field OpenPoints number 卡牌已打开的天赋
local TalentModel = _G.BaseClass("TalentModel", base)

function TalentModel:__init()
    self.CardData = nil
    self.CanUseTalent = 0
    self.UsedMatrialNum = 0
    self.OpenPoints = {}
    self.BigPoint = {}
end

-- ---@return TalentModel TalentModel
-- function TalentModel:GetInstance()
--     return self.super.GetInstance(self)
-- end

function TalentModel:GetDataFormServer()
end

function TalentModel:ChooseCard(carddata, isPreview)
    self.CardData = carddata
    if nil == isPreview then
        self.isPreview = false
    else
        self.isPreview = isPreview
    end
    if not self.isPreview and self.CardData.type == _G.CardType.Normal then
        self.LastCardEquipProp = _G.GameUtil.GetPropUpData(self.CardData)
    end
    self.OpenPoints = self.CardData.open_inborn
end

function TalentModel:GetTalentInfo(back)
    self.Back = back
    local msg = {}
    msg.card_uid = self.CardData.uid
    TalentNet:GetInstance():GetInbornInfo(msg, _G.handler(self, self.BackInbornInfo))
end

function TalentModel:BackInbornInfo(msg)
    self.CanUseTalent = self.CardData.inborn_num
    self.UsedMatrialNum = msg.born.cost_num
    if self.Back then
        self.Back()
    end
end

function TalentModel:UpdateUseMatrial(num)
    self.UsedMatrialNum = self.UsedMatrialNum + num
    self.CardData.inborn_cost_num = self.CardData.inborn_cost_num + num
end

---试玩角色给一个默认值
function TalentModel:SetLocalInfo()
    self.CanUseTalent = 0
    self.UsedMatrialNum = 0
end

function TalentModel:UpdateCard()
    if not self.isPreview and self.CardData.type == _G.CardType.Normal then
        self.CardData:CalcNowSumProp()
        require("CardInfoManager"):GetInstance():Updata_CardViewUpdataFun(self.CardData, true, false)
        ---@type Params_View_PropUp
        local Params_View_PropUp = {}
        Params_View_PropUp.Posx = 0
        _G.UIUtils.ShowPropUp(self.CardData, self.LastCardEquipProp, nil, Params_View_PropUp)

        local offset = _G.StorageManager:GetInstance():GetPlayerPower() - self.PowerOffset
        if offset > 0 then
            require "CommonTipManager".OpenPowerUpView(self.PowerOffset, offset)
        end
    end
end

function TalentModel:UpdateLast()
    if not self.isPreview and self.CardData.type == _G.CardType.Normal then
        self.LastCardEquipProp = _G.GameUtil.GetPropUpData(self.CardData)
        self.PowerOffset = _G.StorageManager:GetInstance():GetPlayerPower()
    end
end

---消耗天赋点
function TalentModel:ConsumeTalent(num)
    self.CanUseTalent = self.CanUseTalent - num
    self.CardData.inborn_num = self.CardData.inborn_num - num
end

---激活一个点
---@param id number 激活的id
---@param isSkill boolean 是否是大点
function TalentModel:ActivePoint(id, isSkill)
    table.insert(self.OpenPoints, id)
    if isSkill then
        self.CardData.big_born_num = self.CardData.big_born_num + 1
    end
end

---检测点位激活情况
function TalentModel:CheckPointOpen(sid)
    if false == _G.table.indexof(self.OpenPoints, sid) then
        return false
    end
    return true
end

--每张卡牌可使用材料和材料数量上限
function TalentModel:MaxUseMatrialNum()
    local num = _G.ConfigManager.discrete_cfg[107402][1][1]
    return num
end

--每个天赋消耗的天赋点数
function TalentModel:TalenNeedNum()
    local num = _G.ConfigManager.discrete_cfg[107403][1][1]
    return num
end

--每个天赋可使用天赋材料和对应的数量
function TalentModel:MaxMatrialNum()
    local info = _G.ConfigManager.discrete_cfg[107404][1]
    local sid = info[1]
    local num = info[2]
    return sid, num
end

function TalentModel:AddOrRemoveOrChange(add, rem, change)
    --天赋红点
    local redpointmanager = require("RedPointManager"):GetInstance()
    if not _G.table.isEmptyOrNil(add) then
        for key, value in pairs(add) do
            redpointmanager:AddRedPointParam(_G.ConfigManager.redpoint_cfg.TalentCultivate.id, key)
        end
    end
    if not _G.table.isEmptyOrNil(rem) then
        for key, value in pairs(rem) do
            redpointmanager:RemoveRedPointParam(_G.ConfigManager.redpoint_cfg.TalentCultivate.id, key)
        end
    end
    if not _G.table.isEmptyOrNil(change) then
        for key, value in pairs(change) do
            redpointmanager:RefreshNode(_G.ConfigManager.redpoint_cfg.TalentCultivate.id, key)
        end
    end
end

---销毁对象时,析构函数
function TalentModel:Dispose()
end

return TalentModel
