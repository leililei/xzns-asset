local base = require("LimitedExchangeView")

---@class NationalDayExchangeView : LimitedExchangeView	中文描述
---@field public go_table NationalDayExchangeView_GoTable GoTable
local NationalDayExchangeView = _G.BaseClass("NationalDayExchangeView", base)

function NationalDayExchangeView:InitView(activity)
    base.InitView(self,activity)
    self.coinSid = self.activitySynModel:GetItemSidAndNum(self.itemDatas[1].consumes[1])
    self.go_table.aorrawimage_icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(self.coinSid))
    self.CloseRedPoint =
        _G.PlayerPrefsManager.GetInt("LimitTimeExchangeCloseRedPoint" .. self.activity:GetActivityID(), 0)
    self.go_table.aorimage_gou:SetActiveE(1 - self.CloseRedPoint)
    self.RTS = self.activity.cfg.time.start_time + self.activity.cfg.time.run_time - _G.GetNowUnixTime()
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimer, self, false, false, true)
    self.timer:Start()
    self:RefreshCoin()
    self:UpdateTimer(0)
    self:AddComponent(self.go_table.obj_playerInfo,require("PlayerComponent").New(self.go_table.obj_playerInfo))
end

function NationalDayExchangeView:RefreshView()
    base.RefreshView(self)
    self:RefreshCoin()
end

function NationalDayExchangeView:RefreshCoin()
    self.go_table.aortext_num.text = _G.StorageManager:GetInstance():GetOtherItemCountBySid(self.coinSid) or 0
end

function NationalDayExchangeView:RefreshItem(index, obj)
    local instanceId = obj:GetInstanceIDE()
    local x = index + 1
    obj:SetName(x)
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.ClickItemBtn, index + 1))
    if self.itemDatas[x] then
        tb.data = self.itemDatas[x]
        -- tb["_onclick"] = _G.handlerbind(self, self.ClickItemBtn, tb)
        -- self:CreateItem(tb, instanceId)
        tb.obj_itemRoot:RemoveAllChildren()
        for k, v in pairs(tb.data.award) do
            local sid, num = self.activitySynModel:GetItemSidAndNum(v)
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                { sid, num },
                tb.obj_itemRoot,
                function(tran)
                    if self:IsNil() then
                        _G.DestroyObject(tran)
                        return
                    end
                    tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                    tran:ShowEffectOrder(true)
                end
            )
        end
        tb.aortext_itemname.text = tb.data.name and _G.GetLangPackValue(tb.data.name) or ""
        tb.obj_SellOut:SetActiveE(tb.data.state ~= 1 and 1 or 0)
        tb.obj_get:SetActiveE(tb.data.state == 1 and 1 or 0)
        if tb.data.state == 1 then
            tb.aortext_num.text = _G.GetLangPackValue(90033900019, tb.data.exchangeTimes, tb.data.count_limit)
            local consume_sid, consume_num = self.activitySynModel:GetItemSidAndNum(tb.data.consumes[1])
            tb.aorrawimage_Material:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(consume_sid))
            tb.aortext_MaterialNum.text = _G.GameUtil.NumberToShopPrice(consume_num)
        end
    end
end

function NationalDayExchangeView:UpdateTimer(elapsed)
    self.RTS = self.RTS - elapsed
    if self.RTS <= 0 then
        self.timer:Stop()
        self.timer = nil
        self:Close()
        return
    end
    self.go_table.aortext_Timer.text = _G.TimeUtil.GiftPackGroupTime(self.RTS)
end

function NationalDayExchangeView:OpenTips()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 81)
end

function NationalDayExchangeView:ChangeToggle()
    self.go_table.aorimage_gou:SetActiveE(self.CloseRedPoint)
    self.CloseRedPoint = 1 - self.CloseRedPoint
    _G.PlayerPrefsManager.SetInt("LimitTimeExchangeCloseRedPoint" .. self.activity:GetActivityID(), self.CloseRedPoint)
    self.activitySynModel:RefreshRedPointExchange()
end

function NationalDayExchangeView:OnClickBtn(go)
    base.OnClickBtn(self,go)
    if go == self.go_table.aorbtn_toggle then
        self:ChangeToggle()
    end
end

function NationalDayExchangeView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return NationalDayExchangeView
