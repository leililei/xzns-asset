local ZoneRankModel = require "ZoneRankModel"
---@class LittleZoneRankView : Component    中文描述
---@field go_table _obj_littleZonePanel_GoTable
---@field ranks ZoneRankData[]
local LittleZoneRankView = _G.BaseClass("LittleZoneRankView", _G.Component)
local SpType = {
    None = 0, --通用
    Contribute = 1, --贡献
    MaxDmg = 2, --最高伤害
    Difficulty = 3, --难度
    KillNum = 4, --击杀数量
    PassDate = 5,
    --通关日期
    winRate = 6,
    --场数/胜场
    score = 7, --分数
    winRate2 = 8,
    --胜场/胜率
    DifficultyAndKillNUm = 9 --难度/击杀数量
}

local rankIconPath = {
    [1] = "0ui_icon_diyi",
    [2] = "0ui_icon_dier",
    [3] = "0ui_icon_disan",
}
local UIUtils = _G.UIUtils
local LangUtil = _G.LangUtil
local GetLangPackValue = _G.GetLangPackValue
function LittleZoneRankView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建对象时,入口构造函数
---@param id number
---@param sysType number 功能类型
---@param activityId number 活动id
---@param getrankFunc function 获取排行榜的方法
---@param isRefresh boolean 显示是否刷新
---@param call function 获取数据后回调
function LittleZoneRankView:OnCreate(sysType, activityId, isRefresh, call, IsDan, selfData)
    self.sysType = sysType
    self.activityId = activityId
    self.curPage = 1
    self.zone = 0
    self.call = call
    self.selfData = selfData
    ---@type rank_zone_cfg
    self.spCfg = _G.ConfigManager.rank_zone_cfg[sysType]
    self.IsDan = IsDan
    if IsDan then
        self.isOpenZone = false
    elseif activityId then
        self.isOpenZone = true
    else
        self.isOpenZone = ZoneRankModel:GetInstance():CheckIsOpen(sysType)
    end

    self.isRefresh = isRefresh
    if IsDan then
        self:RefreshRankDan()
    else
        self:RefreshRank()
    end
    self.nextPageNumList = {}
    for i = 1, 20 do
        if i * 100 > 2000 then
            break
        else
            self.nextPageNumList[i * 100] = true
        end
    end
    --local cfg = _G.ConfigManager.rank_zone_cfg[self.sysType]
    --if cfg then
    --    self.go_table.aortext_end.text = _G.GetLangPackValue(cfg.title[#cfg.title])
    --end
end

function LittleZoneRankView:Refresh(selfData)
    self.selfData = selfData
    if self.flag and self.flag == false then
        return
    end
    if self.IsDan then
        self:RefreshRankDan()
    else
        self:RefreshRank()
    end
end

---刷新排行榜
function LittleZoneRankView:RefreshRankDan(call)
    local rankSelf
    require("DrawUpMainModel"):GetInstance():SelfRank(
            self.activityId,
            function(mag)
                -- local msg = {index = mag.index, zone = mag.value, dan = 0}
                rankSelf = require "ZoneRankSingleSelfData".New(mag)
                rankSelf = self:CheckPlayerInfo(rankSelf)
                --rankSelf = require "ZoneRankSelfData".New(mag.index_info and mag.index_info or nil)
                ZoneRankModel:GetInstance():GetOutZoneSelfRankInfoDraw(
                        self.sysType,
                        self.activityId,
                        function(rankList)
                            if not _G.table.isEmptyOrNil(rankList) then
                                self.canNext = #rankList == 100
                            else
                                self.canNext = false
                            end
                            rankList = self:CheckRankList(rankList, rankSelf)
                            self:Show(rankList)
                            self:InitPlayer(rankSelf)
                            -- if call then
                            --     call(rankList)
                            -- elseif self.call then
                            --     self.call(rankList)
                            -- end
                            if call then
                                call(mag.index)
                            elseif self.call then
                                self.call(mag.index)
                            end
                        end
                )
            end
    )
end

---刷新排行榜
function LittleZoneRankView:RefreshRank(call)
    ZoneRankModel:GetInstance():GetOutZoneSelfRankInfo(
            self.sysType,
            self.activityId,
            function(rankSelf)
                self.playerInfo = self:CheckPlayerInfo(rankSelf)
                self.selectZone = rankSelf.zone or -1
                self.selectDan = rankSelf:GetDan() == 0 and 1 or rankSelf:GetDan()
                ZoneRankModel:GetInstance():GetOutZoneRankInfo(
                        self.sysType,
                        self.curPage,
                        self.selectZone,
                        self.activityId,
                        self.selectDan,
                        function(rankList)
                            if not _G.table.isEmptyOrNil(rankList) then
                                self.canNext = #rankList == 100
                            else
                                self.canNext = false
                            end
                            self:Show(rankList)
                            self:InitPlayer(self.playerInfo)
                            if call then
                                call(self.playerInfo)
                            elseif self.call then
                                self.call(self.playerInfo)
                            end
                        end
                )
            end
    )
end

function LittleZoneRankView:CheckPlayerInfo(data)
    if self.selfData then
        for k, v in ipairs(data.params) do
            if v ~= self.selfData[k] then
                data.params[k] = self.selfData[k]
            end
        end
    end
    return data
end

function LittleZoneRankView:CheckRankList(rankList, playerInfo)
    if self.selfData then
        local needCheck = false
        for k, v in ipairs(self.selfData) do
            if v ~= 0 then
                needCheck = true
                break
            end
        end
        if needCheck then
            local needRank = false
            local haveSelf = false
            for k, v in ipairs(rankList) do
                if v.role_info.uid == _G.PlayerModel:GetInstance().role_uid then
                    haveSelf = true
                    for k2, v2 in ipairs(v.params) do
                        if tonumber(v2) ~= tonumber(self.selfData[k2]) then
                            v.params = self.selfData
                            needRank = true
                            break
                        end
                    end
                    break
                end
            end
            if haveSelf == false then
                local selfData = require "ZoneRankData".New()
                selfData.params = self.selfData
                local playerModel = _G.PlayerModel:GetInstance()
                local playerData = {}
                playerData.frame = playerModel:GetCurFrame()
                playerData.style = playerModel:GetRoleStyle()
                playerData.uid = playerModel:GetPlayerUid()
                playerData.lv = playerModel:GetLevel()
                playerData.title = playerModel:GetTitle()
                playerData.name = playerModel:GetName()
                selfData.role_info = playerData
                selfData.rank = 0
                _G.table.insert(rankList, selfData)
                needRank = true
            end
            if needRank then
                _G.table.sort(rankList, function(a, b)
                    local aParams1 = tonumber(a.params[1])
                    local bParams1 = tonumber(b.params[1])
                    if aParams1 ~= bParams1 then
                        return aParams1 > bParams1
                    end
                    if #a.params > 1 then
                        local aParams2 = tonumber(a.params[2])
                        local bParams2 = tonumber(b.params[2])
                        if aParams2 ~= bParams2 then
                            return aParams2 > bParams2
                        end
                    end
                end)
                for k, v in ipairs(rankList) do
                    v.rank = k
                    if v.role_info.uid == _G.PlayerModel:GetInstance().role_uid then
                        playerInfo.rank = k
                    end
                end
            end
        end
    end
    return rankList
end

---显示界面
---@param msg zone.s2c_zone_rank_info
function LittleZoneRankView:Show(rankList)
    self.ranks = rankList or {}
    self:InitRank()
end

---初始化排行榜
function LittleZoneRankView:InitRank()
    --self.go_table.obj_nothing:SetActiveE(#self.ranks == 0 and 1 or 0)
    self.rankCount = #self.ranks == 0 and 3 or #self.ranks
    self.go_table.scrollloopvectical_rank:SetActiveE(1)

    if not self.rankInit then
        self.go_table.scrollloopvectical_rank:InitItemData(self.rankCount, _G.handler(self, self.RefreshRankItem))
        self.rankInit = true
    else
        self.go_table.scrollloopvectical_rank:UpdateCount(self.rankCount)
    end

    if self.isOpenZone then
        local zone = ZoneRankModel:GetInstance():GetDan(self.playerInfo.dan == 0 and 1 or self.playerInfo.dan)
        self.go_table.aortext_titleName.text = GetLangPackValue(90000010849, GetLangPackValue(zone[2]))
    else
        self.go_table.aortext_titleName.text = GetLangPackValue(90000010848)
    end
end
