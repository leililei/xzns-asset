    tb.aortext_rank.text = ""
    if tb.aortext_no then
        tb.aortext_no.text = ""
    end
    tb.aorimage_rank:SetActiveE(0)
    if index <= 3 then
        tb.aorimage_rank.SpriteName = rankIconPath[index]
        tb.aorimage_rank:SetNativeSize()
        tb.aorimage_rank:SetActiveE(1)
        for i = 1, 3 do
            if tb["aortext_rankNum" .. i] then
                tb["aortext_rankNum" .. i]:SetActiveE(i == index and 1 or 0)
            end
        end
    else
        tb.aortext_rank:SetActiveE(1)
