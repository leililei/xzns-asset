    --tb.aortext_name:SetLocalPosition(-22.9, 23.8, 0)
    --    tb.aortext_power.text = _G.GameUtil.NumberToUnitStrBag(data:GetPower())
    --else
    --    tb.obj_power:SetActiveE(0)
    --tb.aortext_name:SetLocalPosition(-22.9, 5, 0)
    --    tb.aortext_power.text = ""
    --end
    --tb.aortext_value.text = self:SpecialTextProcess(self.spCfg.text_type[2], data:GetParmams())
    --UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, roleInfo, 1, true, true)
