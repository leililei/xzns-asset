---点击item
function LittleZoneRankView:OnRankItemClick(go, isOn, roleInfo)
    local name = go:GetName()
    if name == "@_aorbtn_HeadClick" then
        if roleInfo.uid > 0 then
            if roleInfo.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.PopWindowManager:GetInstance():ShowAllTips(620109)
            else
                _G.SystemSettingManager:GetInstance():OpenView(roleInfo.uid)
            end
        end
    end
end

---按钮点击事件在这里派发
function LittleZoneRankView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeLeft then
        self:MovePanel(false)
    elseif go == self.go_table.aorbtn_openLeft then
        self:MovePanel(true)
    end
end

