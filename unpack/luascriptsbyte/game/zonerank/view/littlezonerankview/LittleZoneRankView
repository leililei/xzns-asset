---文本特殊处理
function LittleZoneRankView:SpecialTextProcess(type, params)
    local text
    local count = params and #params or 0
    if type == SpType.DifficultyAndKillNUm then
        if count < 1 then
            text = "0/0"
        else
            text = params[count - 1] .. "/" .. params[count]
        end
    elseif type == SpType.MaxDmg then
        text = _G.GameUtil.NumberToUnitStr(_G.tonumber(params[count]))
    else
        text = params[count]
    end
    return text
end

