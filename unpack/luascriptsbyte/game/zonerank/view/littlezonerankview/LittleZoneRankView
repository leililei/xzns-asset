function LittleZoneRankView:RefreshNexPage()
    self.curPage = self.curPage + 1
    ZoneRankModel:GetInstance():GetOutZoneRankInfo(
            self.sysType,
            self.curPage,
            self.selectZone,
            self.activityId,
            self.selectDan,
            function(rankList)
                if not _G.table.isEmptyOrNil(rankList) then
                    _G.table.insertto(self.ranks, rankList)
                    local count = #rankList
                    self.canNext = count == 100
                    self.rankCount = count + self.rankCount
                    self.go_table.scrollloopvectical_rank:UpdateCount(self.rankCount)
                else
                    self.canNext = false
                end
            end
    )
end

