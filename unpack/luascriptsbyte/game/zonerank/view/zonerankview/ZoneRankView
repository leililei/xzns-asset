local ZoneRankModel = require("ZoneRankModel")

---@class ZoneRankView : Component    中文描述
---@field public go_table _obj_zoneRank_GoTable GoTable
local ZoneRankView = _G.BaseClass("ZoneRankView", _G.Component)
local UIUtils = _G.UIUtils
local textType = _G.typeof(_G.CS.AorText)
local range = {-431, 450}
local infoLen = 280
local titleLen = 140
local SpType = {
    None = 0, --通用
    Contribute = 1, --贡献
    MaxDmg = 2, --最高伤害
    Difficulty = 3, --难度
    KillNum = 4, --击杀数量
    PassDate = 5, --通关日期
    winRate = 6,
    --场数/胜场
    score = 7, --分数
    winRate2 = 8, --胜场/胜率
    DifficultyAndKillNUm = 9 --难度/击杀数量
}

function ZoneRankView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function ZoneRankView:__init(transform, view)
    self.gameObject = transform
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    self.view = view
end

---界面的入口函数
function ZoneRankView:OnCreate()
end

---@private
function ZoneRankView:InitView(sysType, activityId, RewardDatas)
    self:IsBool()
    self.zones = ZoneRankModel:GetInstance().zoneIds
    self.sysType = sysType
    self.activityId = activityId
    self.rankInit = true
    self.zoneInit = true
    self.curPage = 1
    self.selectZone = 0
    self.selectDan = 0
    self.ShowPlay = ZoneRankModel:GetInstance():CheckShowPlay(self.sysType)
    self.isSingle = ZoneRankModel:GetInstance():CheckIsShowSingle(self.sysType)
    self.AllRewardDatas = RewardDatas
    self:GetInfo()
    self.nextPageNumList = {}
    ---@type rank_zone_cfg
    self.spCfg = _G.ConfigManager.rank_zone_cfg[sysType]
    for i = 1, 20 do
        if i * 100 > 2000 then
            break
        else
            self.nextPageNumList[i * 100] = true
        end
    end
    self.go_table.obj_tips:SetActiveE((self.spCfg.coefficient and self.spCfg.coefficient > 0) and 1 or 0)
end

---获取信息
function ZoneRankView:GetInfo()
    if not self.playerInfo then
        ---@param msg zone.s2c_zone_rank_index
        ZoneRankModel:GetInstance():GetZoneSelfRankInfo(
            self.sysType,
            self.activityId,
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                self.playerInfo = msg.index_info or {dan = 0, index = 0}
                self.selectDan = self.playerInfo.dan == 0 and 1 or self.playerInfo.dan
                self.selectZone = msg.index_info and msg.index_info.zone_id or -1
                if self.selectZone >= 0 then
                    ---@param msg2 zone.s2c_zone_rank_info
                    ZoneRankModel:GetInstance():GetZoneRankInfo(
                        self.sysType,
                        self.curPage,
                        self.selectZone,
                        self.activityId,
                        self.selectDan,
                        function(msg2)
                            if msg2.ack ~= 1 then
                                return
                            end
                            self.info = msg2.rank_info
                            if self.AllRewardDatas then
                                self.RewardDatas =
                                    self.isSingle and self.AllRewardDatas or self.AllRewardDatas[self.selectDan]
                            end

                            self:InitRank()
                            self:InitPlayer(self.playerInfo)
                            if self.info and self.info.ranks and #self.info.ranks == 100 then
                                self.canNext = true
                            else
                                self.canNext = false
                            end
                        end
                    )
                else
                    self.info = {}
                    if self.AllRewardDatas then
                        self.RewardDatas = self.isSingle and self.AllRewardDatas or self.AllRewardDatas[self.selectDan]
                    end

                    self:InitRank()
                    self:InitPlayer(self.playerInfo)
                    if self.info and self.info.ranks and #self.info.ranks == 100 then
                        self.canNext = true
                    else
                        self.canNext = false
                    end
                end
            end
        )
    else
        if self.selectZone < 0 then
            return
        end
        ---@param msg2 zone.s2c_zone_rank_info
        ZoneRankModel:GetInstance():GetZoneRankInfo(
            self.sysType,
            self.curPage,
            self.selectZone,
            self.activityId,
            self.selectDan,
            function(msg2)
                if msg2.ack ~= 1 then
                    return
                end
                self.info = msg2.rank_info
                if self.AllRewardDatas then
                    self.RewardDatas = self.isSingle and self.AllRewardDatas or self.AllRewardDatas[self.selectDan]
                end

                self:InitRank()
                if self.info and self.info.ranks and #self.info.ranks == 100 then
                    self.canNext = true
                else
                    self.canNext = false
                end
            end
        )
    end
end

---初始化排行榜
function ZoneRankView:InitRank()
    self.curZone = self.playerInfo.zone_id
    self.ranks = self.info.ranks or {}
    if self.selectZone == 0 then
        self.selectZone = self.curZone
    end

    self.go_table.aortext_curZone.text = _G.GetLangPackValue(90000010781, self.selectZone)
    local zone = ZoneRankModel:GetInstance():GetDan(self.selectDan)
    self.go_table.aortext_curDanZone.text = _G.GetLangPackValue(zone[2])
    self.go_table.aortext_dan.text = _G.GetLangPackValue(zone[2])
    self.go_table.obj_player:SetActiveE(
        (self.selectZone == self.curZone and self.selectDan == self.playerInfo.dan) and 1 or 0
    )
    self.go_table.scrollloopvectical_rankList:SetRectTransformSize(
        985.88,
        (self.selectZone == self.curZone and self.selectDan == self.playerInfo.dan) and 327.39 or 421.7
    )
    self.go_table.obj_no:SetActiveE(#self.ranks == 0 and 1 or 0)
    self.info.title = _G.ConfigManager.rank_zone_cfg[self.sysType].title
    if not self.posX then
        self.posX = {}
        local titleNum = self.info.title and #self.info.title or 0
        local unitLen = (range[2] - range[1]) / (titleNum + 1)
        for i = 2, titleNum do
            if i == 2 then
                self.go_table.aortext_title:SetLocalPosition(range[1] + unitLen, 0, 0)
                self.go_table.aortext_title.text = _G.GetLangPackValue(self.info.title[i])
                _G.table.insert(self.posX, range[1] + unitLen)
            else
                local obj = _G.InstantiateObject(self.go_table.aortext_title, self.go_table.obj_topBg)
                obj:SetLocalPosition(range[1] + (i + 0.5) * unitLen, 0, 0)
                obj:GetComponentE(textType).text = _G.GetLangPackValue(self.info.title[i])
                _G.table.insert(self.posX, range[1] + (i + 0.5) * unitLen)
            end
            if self.info.title[i] == 90024600033 then
                self.isReward = true
            end
        end
    end
    if #self.ranks > 0 then
        self.go_table.scrollloopvectical_rankList:SetActiveE(1)
        if self.rankInit then
            self.go_table.scrollloopvectical_rankList:InitItemData(#self.ranks, _G.handler(self, self.RefreshRankItem))
            self.rankInit = false
        else
            self.go_table.scrollloopvectical_rankList:UpdateCount(#self.ranks)
        end
    else
        self.go_table.scrollloopvectical_rankList:UpdateCount(0)
        self.go_table.scrollloopvectical_rankList:SetActiveE(0)
    end
end

---刷新大区item
function ZoneRankView:RefreshZoneItem(index, obj)
    index = index + 1
    ---@type _obj_zoneRank._obj_zoneItem_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnSelect, index))
    tb.aortext_zone.text = _G.GetLangPackValue(90000010781, index)
    if self.zones[index] == self.curZone then
        tb.obj_isMyZone:SetActiveE(1)
        tb.aortext_zone.color = _G.ColorTools.FormatColorByString("ffffff")
    else
        tb.obj_isMyZone:SetActiveE(0)
        tb.aortext_zone.color = _G.ColorTools.FormatColorByString("808199")
    end
end

---刷新排行榜item
function ZoneRankView:RefreshRankItem(index, obj)
    index = index + 1
    local roleInfo = self.ranks[index].role_info
    local rankInfo = self.ranks[index].rank_info
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnRankItemClick, roleInfo, self.ranks[index].p_id))
    _G.GameUtil.SetActiveByCondition(tb.aorimage_rankBg, index <= 3)
    _G.GameUtil.SetActiveByCondition(tb.obj_rankBg2, index > 3)
    if index <= 3 then
        tb.aorimage_rankBg.SpriteName = "tz_qjhs_di_0" .. (index + 1)
        tb.aorimage_rank.SpriteName = "tz_qjhs_phb_mingci_0" .. index
    else
        tb.aortext_rankNum.text = index
    end
    tb.index = index
    tb.aortext_name.text = roleInfo.name
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, roleInfo, 1, true, true, true)
    for i = 1, #self.posX do
        if i == 1 then
            tb.obj_itemInfo:SetLocalPosition(self.posX[1], 0, 0)
            tb.obj_itemInfo:SetActiveE(1)
        elseif i == 2 then
            tb.aortext_value:SetLocalPosition(self.posX[2], 0, 0)
            tb.aortext_value.text = self:SpecialTextProcess(self.spCfg.text_type[i], rankInfo[i - 1], rankInfo)
        else
            if not tb.otherVal then
                tb.otherVal = {}
            end
            if not tb.otherVal[i] then
                tb.otherVal[i] = _G.InstantiateObject(tb.aortext_value, tb.obj_content)
            end
            tb.otherVal[i]:SetLocalPosition(self.posX[i], 0, 0)
            tb.otherVal[i]:GetComponentE(textType).text =
                self:SpecialTextProcess(self.spCfg.text_type[i], rankInfo[i - 1], rankInfo)
        end
    end
    if self.canNext and self.nextPageNumList[index + 1] then
        self:GetNextPage()
    end
    tb.aorbtn_huifang:SetActiveE(self.ShowPlay and 1 or 0)
    if self.isReward then
        tb.trans_reward:SetActiveE(1)
        self:SpawnAward(tb.trans_reward, index, tb)
    else
        tb.trans_reward:SetActiveE(0)
    end
    if self.IsHuiFang and tb.aorbtn_huifang then
        tb.aorbtn_huifang:SetActiveE(0)
    end
end

---判断是否显示回放按钮
function ZoneRankView:IsBool()
    local EmbattleView = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.EmbattleView.Name)
    local BattleView = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    local ShowAwardWithButtonView =
        _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name)
    if EmbattleView or BattleView or ShowAwardWithButtonView then
        self.IsHuiFang = true
    end
end

---生成奖励
function ZoneRankView:SpawnAward(parent, index, tb)
    parent:ClearChildren()
    if self.RewardDatas then
        local datas
        for _, v in pairs(self.RewardDatas) do
            if index >= v.min_rank and index <= v.max_rank then
                datas = v.rewards
                break
            end
        end
        if datas then
            for i = 1, #datas do
                _G.StorageManager:GetInstance():GetItemBaseViewNew(
                    datas[i],
                    parent,
                    function(item)
                        if _G.IsNil(self.gameObject) or (tb and index ~= tb.index) then
                            _G.DestroyObject(item.go_table.gameObject)
                            return
                        end
                        item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                    end
                )
            end
        end
    end
end

function ZoneRankView:GetNextPage()
    self.curPage = self.curPage + 1
    ZoneRankModel:GetZoneRankInfo(
        self.sysType,
        self.curPage,
        self.selectZone,
        self.activityId,
        self.selectDan,
        function(msg2)
            if msg2.ack ~= 1 then
                return
            end
            if msg2.rank_info and msg2.rank_info.ranks then
                _G.table.insertto(self.ranks, msg2.rank_info.ranks)
                if #msg2.rank_info.ranks == 100 then
                    self.canNext = true
                else
                    self.canNext = false
                end
            else
                self.canNext = false
            end
            self.go_table.scrollloopvectical_rankList:UpdateCount(#self.ranks)
        end
    )
end

---初始化玩家自身栏（暂时弃用）
function ZoneRankView:InitPlayer(playerInfo)
    local tb =
        _G.GetAutoGoTable(
        self.go_table.obj_player,
        _G.handlerbind(self, self.OnRankItemClick, {uid = _G.PlayerModel:GetInstance():GetPlayerUid()})
    )
    if playerInfo.index == 0 then
        tb.aortext_rankNum.text = _G.LangUtil.GetLangPackValue(90022900040)
    else
        tb.aortext_rankNum.text = playerInfo.index
    end
    tb.aortext_name.text = _G.PlayerModel:GetInstance():GetName()
    local playerModel = _G.PlayerModel:GetInstance()
    local playerData = {}
    playerData.frame = playerModel:GetCurFrame()
    playerData.style = playerModel:GetRoleStyle()
    playerData.uid = playerModel:GetPlayerUid()
    playerData.lv = playerModel:GetLevel()
    playerData.title = playerModel:GetTitle()
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, playerData, 1, true, true, true)
    for i = 1, #self.posX do
        if i == 1 then
            tb.obj_playerInfo:SetLocalPosition(self.posX[1], 0, 0)
            tb.obj_playerInfo:SetActiveE(1)
        elseif i == 2 then
            tb.aortext_value:SetLocalPosition(self.posX[2], 0, 0)
            if playerInfo.rank_info and playerInfo.rank_info[i - 1] then
                tb.aortext_value.text =
                    self:SpecialTextProcess(self.spCfg.text_type[i], playerInfo.rank_info[i - 1], playerInfo.rank_info)
            else
                tb.aortext_value.text = self:SpecialTextProcess(self.spCfg.text_type[i], 0)
            end
        else
            if not tb.otherVal then
                tb.otherVal = {}
            end
            if not tb.otherVal[i] then
                tb.otherVal[i] = _G.InstantiateObject(tb.aortext_value, self.go_table.obj_player)
            end
            tb.otherVal[i]:SetLocalPosition(self.posX[i], 0, 0)
            if playerInfo.rank_info and playerInfo.rank_info[i - 1] then
                tb.otherVal[i]:GetComponentE(textType).text =
                    self:SpecialTextProcess(self.spCfg.text_type[i], playerInfo.rank_info[i - 1], playerInfo.rank_info)
            end
        end
    end
    if self.isReward then
        tb.trans_reward:SetActiveE(1)
        self:SpawnAward(tb.trans_reward, playerInfo.index)
    else
        tb.trans_reward:SetActiveE(0)
    end
end

---显示大区选择
function ZoneRankView:ShowSelect()
    if self.go_table.obj_isSelect:GetActiveSelf() == 0 then
        ---展开
        self.go_table.obj_isSelect:SetActiveE(1)
        self.go_table.aorimage_arrow:SetRotation(0, 0, 180)
        if self.zoneInit then
            self.go_table.scrollloopvectical_zone:InitItemData(#self.zones, _G.handler(self, self.RefreshZoneItem))
            self.zoneInit = false
        end
        if self.go_table.obj_isDanSelect:GetActiveSelf() == 1 then
            self.go_table.obj_isDanSelect:SetActiveE(0)
            self.go_table.aorimage_danArrow:SetRotation(0, 0, 0)
        end
    else
        ---合上
        self.go_table.obj_isSelect:SetActiveE(0)
        self.go_table.aorimage_arrow:SetRotation(0, 0, 0)
    end
end

---选择大区
function ZoneRankView:OnSelect(go, isOn, index)
    self:ShowSelect()
    if index ~= self.selectZone then
        self.selectZone = index
        self.curPage = 1
        self:GetInfo()
    end
end

---点击item
function ZoneRankView:OnRankItemClick(go, isOn, roleInfo, p_id)
    local name = go:GetName()
    if name == "@_aorbtn_HeadClick" then
        if roleInfo.uid > 0 then
            if roleInfo.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.PopWindowManager:GetInstance():ShowAllTips(620109)
            else
                _G.SystemSettingManager:GetInstance():OpenView(roleInfo.uid)
            end
        end
    elseif name == "@_aorbtn_huifang" then
        if p_id and p_id == 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(200307)
            return
        end
        require "ZoneRankModel":GetInstance():PlayerRecord(
            self.sysType,
            roleInfo.uid,
            function(msg)
                local damage, win =
                    _G.GameUtil.ShowStatisticsView(_G.BattleManager:GetInstance():GetStatisticsRecord(msg.fight_arg))
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name,
                    damage,
                    win,
                    function()
                    end,
                    nil,
                    nil,
                    1,
                    true,
                    msg.fight_arg
                )
            end
        )
    end
end

---界面的销毁函数
function ZoneRankView:OnDestroy()
end

---按钮点击事件在这里派发
function ZoneRankView:OnClickBtn(go)
    if go == self.go_table.aorbtn_arrow then
        self:ShowSelect()
    elseif go == self.go_table.aorbtn_danArrow then
        self:ShowDanSelect()
    end
end

function ZoneRankView:ShowDanSelect()
    if self.go_table.obj_isDanSelect:GetActiveSelf() == 0 then
        ---展开
        self.go_table.obj_isDanSelect:SetActiveE(1)
        self.go_table.aorimage_danArrow:SetRotation(0, 0, 180)
        if not self.zoneDanInit then
            self.zoneParams = ZoneRankModel:GetInstance().danParams
            self.go_table.scrollloopvectical_danZone:InitItemData(
                #self.zoneParams,
                _G.handler(self, self.RefreshDanZoneItem)
            )
            self.zoneDanInit = true
        end
        if self.go_table.obj_isSelect:GetActiveSelf() == 1 then
            self.go_table.obj_isSelect:SetActiveE(0)
            self.go_table.aorimage_arrow:SetRotation(0, 0, 0)
        end
    else
        ---合上
        self.go_table.obj_isDanSelect:SetActiveE(0)
        self.go_table.aorimage_danArrow:SetRotation(0, 0, 0)
    end
end

function ZoneRankView:RefreshDanZoneItem(index, obj)
    index = index + 1
    ---@type _obj_zoneRank._obj_zoneItem_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnSelectDan, index))
    tb.aortext_zone.text = _G.GetLangPackValue(self.zoneParams[index][2])
    if index == self.playerInfo.dan and self.selectZone == self.playerInfo.zone_id then
        tb.obj_isMyZone:SetActiveE(1)
        tb.aortext_zone.color = _G.ColorTools.FormatColorByString("ffffff")
    else
        tb.obj_isMyZone:SetActiveE(0)
        tb.aortext_zone.color = _G.ColorTools.FormatColorByString("808199")
    end
end

---选择大区
function ZoneRankView:OnSelectDan(go, isOn, index)
    self:ShowDanSelect()
    if index ~= self.selectDan then
        self.selectDan = index
        self.curPage = 1
        self:GetInfo()
    end
end

---文本特殊处理
function ZoneRankView:SpecialTextProcess(type, srcText, params)
    local text
    if type == SpType.None or type == nil then
        text = srcText
    elseif type == SpType.Contribute then
        text = _G.GameUtil.NumberToUnitStr(tonumber(srcText))
    elseif type == SpType.MaxDmg then
        text = _G.GameUtil.NumberToUnitStr(tonumber(srcText))
    elseif type == SpType.Difficulty then
        text = srcText
    elseif type == SpType.KillNum then
        text = srcText
    elseif type == SpType.PassDate then
        if _G.tonumber(srcText) > 0 then
            local time = _G.TimeUtil.GetDateTime(srcText)
            text =
                _G.string.format(
                "%s-%s-%s  %02d:%02d:%02d",
                time.year,
                time.month,
                time.day,
                time.hour,
                time.minute,
                time.second
            )
        else
            text = ""
        end
    elseif type == SpType.winRate then
        text = (_G.tonumber(srcText) / 100) .. "%"
    elseif type == SpType.score then
        text = srcText
    elseif type == SpType.winRate2 then
        text = (_G.tonumber(srcText) / 100) .. "%"
    elseif type == SpType.DifficultyAndKillNUm then
        if params then
            text = srcText .. "/" .. params[2]
        else
            if tonumber(srcText) == 0 then
                text = "0/0"
            else
                text = srcText
            end
        end
    end
    return text
end

function ZoneRankView:OnDisable()
    if self.go_table.obj_isSelect:GetActiveSelf() == 1 then
        self:ShowSelect()
    end

    if self.go_table.obj_isDanSelect:GetActiveSelf() == 1 then
        self:ShowDanSelect()
    end
end

return ZoneRankView
