local ZoneRankModel = require "ZoneRankModel"
---@class ZoneRankRewardView : Component	中文描述
local ZoneRankRewardView = _G.BaseClass("ZoneRankRewardView", _G.Component)

local iconDic = {
    [1] = "ui_icon_diyi",
    [2] = "ui_icon_dier",
    [3] = "ui_icon_disan"
}

function ZoneRankRewardView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self.rewardList = {}
end

function ZoneRankRewardView:InitView(sys_type, activity_id, data, content)
    self.sys_type = sys_type
    self.activity_id = activity_id

    self.AllReward = data
    self.content = content
    self.isSingle = ZoneRankModel:GetInstance():CheckIsShowSingle(self.sys_type)
    if not self.isSingle then
        self.go_table.obj_content:SetLocalPosition(0, -21, 0)
        self.go_table.obj_Select2:SetActiveE(1)
    else
        self.go_table.obj_content:SetLocalPositionToZero()
        self.go_table.obj_Select2:SetActiveE(0)
    end
    if not self.isSingle then
        ZoneRankModel:GetInstance():GetZoneSelfRankInfo(sys_type, activity_id, _G.handler(self, self.GetInfoCall))
    else
        self:GetInfoCall({})
    end
end

function ZoneRankRewardView:GetInfoCall(msg)
    if _G.IsNil(self.go_table) then
        return
    end
    self.playerInfo = msg.index_info or { dan = 0, index = 0 }
    self.selectDan = msg.index_info and msg.index_info.dan or 1
    if self.selectDan == 0 then
        self.selectDan = 1
    end
    self:InitPanel()
end

---@param msg zone.s2c_zone_rank_index
function ZoneRankRewardView:InitPanel()
    local zone = ZoneRankModel:GetInstance():GetDan(self.selectDan)
    self.go_table.aortext_curDanZone.text = _G.GetLangPackValue(zone[2])
    if self.isSingle then
        self.RewardDatas = self.AllReward
    else
        self.RewardDatas = self.AllReward[self.selectDan]
    end
    if not self.inited then
        self.go_table.scrollloopvectical_itemList:InitItemData(#self.RewardDatas, _G.handler(self, self.RefreshReward2))
        self.inited = true
    else
        self.go_table.scrollloopvectical_itemList:UpdateCount(#self.RewardDatas)
    end
    self.go_table.aortext_content.text = self.content
end

---刷新奖励2
function ZoneRankRewardView:RefreshReward2(index, obj)
    local newindex = index + 1
    local instanceID = obj:GetInstanceIDE()
    ---@type boss_rank_cfg
    local data = self.RewardDatas[newindex]
    if not self.rewardList[instanceID] then
        self.rewardList[instanceID] = _G.GetAutoGoTable(obj)
    end
    local tb = self.rewardList[instanceID]
    tb.data = data
    _G.GameUtil.SetActiveByCondition(tb.aorimage_rank, newindex <= 3 and data.max_rank == data.min_rank)
    if newindex <= 3 and data.max_rank == data.min_rank then
        tb.aorimage_rank.SpriteName = iconDic[newindex]
        tb.aorimage_rank:SetNativeSize()
        tb.aortext_rank.text = ""
        tb.aortext_rankNum.text = newindex
    elseif data.min_rank and data.min_rank == data.max_rank then
        tb.aortext_rank.text = newindex
    elseif data.ranks and data.ranks[1] and data.ranks[2] then
        tb.aortext_rank.text = _G.string.format("%s~%s", data.ranks[1], data.ranks[2])
    else
        tb.aortext_rank.text = _G.string.format("%s~%s", data.min_rank, data.max_rank)
    end
    if tb.data then
        self:ShowAward(tb, tb.obj_Award, tb.data.rewards or tb.data.reward_daily or tb.data.award)
    else
        self:ShowAward(tb, tb.obj_Award, {})
    end
end

function ZoneRankRewardView:ShowAward(tb, obj, award, parent)
    if not tb.list then
        tb.list = {}
    end
    local count = #tb.list
    local count2 = #award
    for i = 1, count do
        if i <= count2 then
            local data = award[i]
            if data.type then
                data = data.type
            end
            tb.list[i]:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))
            _G.GameUtil.SetActiveByCondition(tb.list[i].gameObject, true)
        else
            _G.GameUtil.SetActiveByCondition(tb.list[i].gameObject, false)
        end
    end
    if count < count2 then
        for i = count + 1, count2 do
            local obj2 = _G.InstantiateObject(obj)
            obj2:SetParentE(tb.trans_Content)
            local item = require "BaseAwardNewItem".New(obj2, nil, 73, obj2:GetChildE(0))
            tb.list[i] = item
            local data = award[i]
            if data.type then
                data = data.type
            end
            item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
        end
    end
end

function ZoneRankRewardView:ShowDanSelect()
    if self.go_table.obj_isDanSelect:GetActiveSelf() == 0 then
        ---展开
        self.go_table.obj_isDanSelect:SetActiveE(1)
        self.go_table.aorimage_danArrow:SetRotation(0, 0, 180)
        if not self.zoneDanInit then
            self.zoneParams = ZoneRankModel:GetInstance().danParams
            self.go_table.scrollloopvectical_danZone:InitItemData(
                #self.zoneParams,
                _G.handler(self, self.RefreshDanZoneItem)
            )
            self.zoneDanInit = true
        end
    else
        ---合上
        self.go_table.obj_isDanSelect:SetActiveE(0)
        self.go_table.aorimage_danArrow:SetRotation(0, 0, 0)
    end
end

function ZoneRankRewardView:RefreshDanZoneItem(index, obj)
    index = index + 1
    ---@type _obj_zoneRank._obj_zoneItem_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnSelectDan, index))
    tb.aortext_zone.text = _G.GetLangPackValue(self.zoneParams[index][2])
    if index == self.playerInfo.dan then
        tb.obj_isMyZone:SetActiveE(1)
        tb.aortext_zone.color = _G.ColorTools.FormatColorByString("ffffff")
    else
        tb.obj_isMyZone:SetActiveE(0)
        tb.aortext_zone.color = _G.ColorTools.FormatColorByString("808199")
    end
end

---选择大区
function ZoneRankRewardView:OnSelectDan(go, isOn, index)
    self:ShowDanSelect()
    if index ~= self.selectDan then
        self.selectDan = index
        self:InitPanel()
    end
end

---按钮点击事件在这里派发
function ZoneRankRewardView:OnClickBtn(go)
    if go == self.go_table.aorbtn_danArrow then
        self:ShowDanSelect()
    end
end

return ZoneRankRewardView
