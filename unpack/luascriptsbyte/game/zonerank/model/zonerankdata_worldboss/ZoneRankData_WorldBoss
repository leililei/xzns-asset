local base = require "ZoneRankData"
---@class ZoneRankData_WorldBoss:ZoneRankData
local ZoneRankData_WorldBoss = _G.BaseClass("ZoneRankData_WorldBoss", base)
function ZoneRankData_WorldBoss:ParseData(msg, index)
    self.rank = index
    self.params = {msg.value}
    self.role_info = {
        uid = msg.uid,
        name = msg.name,
        style = msg.portrait,
        frame = msg.frame,
        level = msg.lv,
        title = msg.title,
        point = msg.point
    }
end

return ZoneRankData_WorldBoss
