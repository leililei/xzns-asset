local ZoneRankNet = require("ZoneRankNet")
--local DrawUpPeakManager = require("DrawUpPeakManager"):GetInstance()

local base = require "GameDataModelBase"
---@class ZoneRankModel:GameDataModelBase	竞技场数据管理类
---@field GetInstance fun():ZoneRankModel
local ZoneRankModel = _G.BaseClass("ZoneRankModel", base)
local SysType = _G.ZoneRankType
local signleRankList = {
    [SysType.SeaonBoss] = {
        All = {"FirstTestNet", "GetBossRank", false, "rankers"},
        Player = {"FirstTestNet", "GetBossPlayerRank"},
        Data = "ZoneRankData_SeasonBoss"
    },
    [SysType.MonsterSiege] = {
        All = {"MonsterSiegeNet", "RankPlayerGongXZiang", "", "rank_info"},
        Player = "RankPlayerSelfGongXZiang",
        Data = "ZoneRankData_MonsterSigege"
    },
    [SysType.WorldBoss] = {
        All = {"LingRankNet", "GetRankAllInfos", {type = 10}, "rank"},
        Player = {"WorldBossNet", "GetPlayerRank"},
        Data = "ZoneRankData_WorldBoss"
    },
    [SysType.HellGuard] = {
        All = {"HellGuardNet", "GetRank", false, "guard_rank"},
        Player = {"HellGuardNet", "GetPlayerRank"},
        Data = "ZoneRankData_HellGuard",
        PlayerData = "ZoneRankSingleSelfData_HellGuard"
    }
}
local ShowPlay = {
    [SysType.MonsterSiege] = true,
    [SysType.SeaonBoss] = true,
    [SysType.Dungones] = true,
    [SysType.WorldBoss] = true,
    [SysType.BlackSource] = true
}

local recordMissTipId = 200307

---类的构造函数
function ZoneRankModel:__init()
    self.danParams = _G.ConfigManager.discrete_cfg[100118]
end

---类的析构函数
function ZoneRankModel:Dispose()
end

function ZoneRankModel:GetDataFormServer()
    self:ParseData()
end

function ZoneRankModel:ParseData()
    base.ParseData(self)
end

---@param sys_type number 功能类型1,祸乱之源 2,心魔幻境 3,锁心试炼 4,雪王来袭 5,守卫灵域 6,千机黑刹(停用) 7,黑暗本源 8,恶灵入侵
---@param page number 页数，一页100条，从1开始
---@param zone_id number 大区id，0为自己所在大区
---@param activity_id number 活动id，非GM功能不传
---@param dan number 段位
---@param callback function 回调
function ZoneRankModel:GetZoneRankInfo(sys_type, page, zone_id, activity_id, dan, callback)
    local pbData = {}
    pbData.sys_type = sys_type
    pbData.zone_id = zone_id or 0
    pbData.activity_id = activity_id
    pbData.page = page or 1
    pbData.dan = dan
    ZoneRankNet:GetInstance():GetZoneRankInfo(pbData, callback)
end

function ZoneRankModel:GetZoneSelfRankInfo(sys_type, activity_id, callback)
    local pbData = {}
    pbData.sys_type = sys_type
    pbData.activity_id = activity_id
    ZoneRankNet:GetInstance():GetZoneSelfRankInfo(pbData, callback)
end

function ZoneRankModel:GetZoneSelfRankInfoDrawUP(sys_type, activity_id, callback)
    local pbData = {}
    pbData.sys_type = sys_type
    pbData.activity_id = activity_id
    require("DrawUpMainModel"):GetInstance():GetRank(activity_id, callback)
end

---检查是否开启大区
function ZoneRankModel:CheckIsOpen(id)
    if id and _G.table.ContainsValue(_G.ConfigManager.discrete_cfg[100144][1], id) then
        return false 
    end
    local openTime = _G.ConfigManager.discrete_cfg[100109][1][1]
    return _G.TimeUtil.GetServerUnixTime() - _G.PlayerModel:GetInstance():GetServerOpenTime() > openTime
end
---获取界面的排行榜数据
function ZoneRankModel:GetOutZoneRankInfo(sys_type, page, zone_id, activity_id, dan, callback)
    local rankList
    if not self:CheckIsOpen(sys_type) and not activity_id and self:CheckIsShowSingle(sys_type) then
        if not signleRankList[sys_type] then
            return
        end
        local tb = signleRankList[sys_type]
        local instance = require(tb.All[1]):GetInstance()
        local getCall = function(msg)
            rankList = {}
            if msg[tb.All[4]] then
                local count = #msg[tb.All[4]]
                for i = 1, count do
                    rankList[i] = require(tb.Data).New(msg[tb.All[4]][i], i + (page - 1) * 100)
                end
            end
            if callback then
                callback(rankList)
            end
        end
        if tb.All[3] then
            instance[tb.All[2]](
                instance,
                tb.All[3],
                function(msg)
                    getCall(msg)
                end
            )
        else
            instance[tb.All[2]](
                instance,
                function(msg)
                    getCall(msg)
                end
            )
        end
    else
        if zone_id >= 0 then
            self:GetZoneRankInfo(
                sys_type,
                page,
                zone_id,
                activity_id,
                dan,
                function(msg)
                    if msg.ack ~= 1 then
                        return
                    end

                    if msg.rank_info then
                        if msg.rank_info.ranks then
                            rankList = {}
                            for i = 1, #msg.rank_info.ranks do
                                rankList[i] = require "ZoneRankData".New(msg.rank_info.ranks[i], i + (page - 1) * 100)
                            end
                        end
                    end
                    if callback then
                        callback(rankList)
                    end
                end
            )
        else
            if callback then
                callback({})
            end
        end
    end
end
function ZoneRankModel:GetOutZoneSelfRankInfoDraw(sys_type, activity_id, callback)
    local rankList
    local tb = signleRankList[_G.ZoneRankType.DrawUpPeak]

    self:GetZoneSelfRankInfoDrawUP(
        sys_type,
        activity_id,
        function(msg)
            if callback then
                rankList = {}

                if msg.ranks then
                    local count = #msg.ranks
                    for i = 1, count do
                        local mag = msg.ranks[i]
                        mag.rank_info = {mag.dps}
                        rankList[i] = require "ZoneRankData".New(mag, i + (0) * 100)

                        require("DrawUpMainModel"):GetInstance():SetrankList(activity_id, msg.ranks)
                    end
                end
                callback(rankList)
            end
        end
    )
end
function ZoneRankModel:GetOutZoneSelfRankInfo(sys_type, activity_id, callback)
    local rankSelf
    if not self:CheckIsOpen(sys_type) and not activity_id and self:CheckIsShowSingle(sys_type) then
        if not signleRankList[sys_type] then
            return
        end
        local tb = signleRankList[sys_type]
        local instance = require(tb.Player[1]):GetInstance()
        instance[tb.Player[2]](
            instance,
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                if tb.PlayerData then
                    rankSelf = require(tb.PlayerData).New(msg)
                else
                    rankSelf = require "ZoneRankSingleSelfData".New(msg)
                end

                if callback then
                    callback(rankSelf,msg)
                end
            end
        )
    else
        self:GetZoneSelfRankInfo(
            sys_type,
            activity_id,
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                rankSelf = require "ZoneRankSelfData".New(msg.index_info and msg.index_info or nil)
                if callback then
                    callback(rankSelf,msg)
                end
            end
        )
    end
end
---检测排行榜状态
function ZoneRankModel:CheckIsShowSingle(id)
    local cfg = _G.ConfigManager.rank_zone_cfg[id]
    if not id or not cfg then
        return true
    end
    return cfg.is_single == 1
end

---检测排行榜状态
function ZoneRankModel:CheckShowPlay(id)
    return ShowPlay[id]
end

---回放
function ZoneRankModel:PlayerRecord(sys, uid, call)
    local pbData = {}
    pbData.role_uid = uid
    pbData.sys_type = sys
    ZoneRankNet:GetInstance():PlayerRecord(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                if msg.ack == 139 then
                    _G.PopWindowManager:GetInstance():ShowAllTips(recordMissTipId)
                end
                return
            end
            if call then
                call(msg)
            end
        end
    )
end

---获取段位数据
function ZoneRankModel:GetDan(index)
    return self.danParams[index]
end

function ZoneRankModel.GetRewardPrefabPath()
    return "UIH5/ZoneRank/$_obj_RankReward"
end

--endregion
return ZoneRankModel
