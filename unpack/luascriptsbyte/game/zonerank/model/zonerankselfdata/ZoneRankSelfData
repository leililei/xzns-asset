local base = require "ZoneRankData"
---@class ZoneRankSelfData	:ZoneRankData
local ZoneRankSelfData = _G.BaseClass("ZoneRankSelfData", base)
---@param msg zone.i_rank_self
function ZoneRankSelfData:ParseData(msg)
    if not msg then
        msg = {index = 0, zone = -1, dan = 0}
    end
    self.rank = msg and msg.index or 0
    self.params = msg.rank_info or {0}
    self.zone = msg.zone_id
    self.dan = msg.dan
end

---获取玩家信息
---@return role.i_role
function ZoneRankSelfData:GetRoleInfo()
    if not self.role_info then
        self.role_info = _G.PlayerModel:GetInstance():GetIRroleTable()
    end
    return self.role_info
end
---获取段位
function ZoneRankSelfData:GetDan()
    return self.dan
end

return ZoneRankSelfData
