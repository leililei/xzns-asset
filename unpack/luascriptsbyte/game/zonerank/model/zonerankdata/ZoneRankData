---总榜排行信息
---@param msg zone.i_rank_info
---@param index number 排名
function ZoneRankData:ParseData(msg, index)
    if not msg then
        msg = {}
    end
    if not index then
        index = 0
    end
    self.rank = index
    self.params = msg.rank_info
    self.role_info = msg.role_info
end

---获取排行榜
function ZoneRankData:GetRank()
    return self.rank or 0
end

