local base = require "ZoneRankData"
---@class ZoneRankData_SeasonBoss:ZoneRankData
local ZoneRankData_SeasonBoss = _G.BaseClass("ZoneRankData_SeasonBoss", base)
---初始化排行榜数据
---@param msg
function ZoneRankData_SeasonBoss:ParseData(msg, index)
    self.rank = index
    self.params = {msg.value}
    self.otherParams = msg.values
    self.role_info = {
        uid = msg.uid,
        name = msg.name,
        style = msg.portrait,
        frame = msg.frame,
        level = msg.lv,
        power = msg.power,
        title = msg.title,
        point = msg.point
    }
end

return ZoneRankData_SeasonBoss
