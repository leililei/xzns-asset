local base = require("BaseGameNet")

---@class ZoneRankNet : BaseGameNet	通信协议
local ZoneRankNet = _G.BaseClass("ZoneRankNet", base)
---@return ZoneRankNet ZoneRankNet
function ZoneRankNet:GetInstance()
    return base.GetInstance(self)
end

function ZoneRankNet:GetZoneRankInfo(pbData, callback)
    local item = _G.ConfigManager.net_map.game_zone_rank_info
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

function ZoneRankNet:GetZoneSelfRankInfo(pbData, callback)
    local item = _G.ConfigManager.net_map.game_zone_rank_index
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

function ZoneRankNet:PlayerRecord(pbData, callback)
    local item = _G.ConfigManager.net_map.game_zone_playback
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---显示错误消息ack的tips
function ZoneRankNet:ShowErrorAckTips(ack)
    if ack == 139 then
        return
    end
    base.ShowErrorAckTips(self,ack)
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function ZoneRankNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return ZoneRankNet
