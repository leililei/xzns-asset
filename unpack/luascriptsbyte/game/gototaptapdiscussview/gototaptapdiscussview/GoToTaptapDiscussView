---@class GoToTaptapDiscussView : UIBaseView	tapatapa评论跳转界面
---@field public go_table GoToTaptapDiscussView_GoTable GoTable
local GoToTaptapDiscussView = _G.BaseClass("GoToTaptapDiscussView",_G.UIBaseView)
function GoToTaptapDiscussView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function GoToTaptapDiscussView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_confirm then
        _G.SDKManager:GetInstance():GoToTAPTAPDiscuss()
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.aorbtn_cancel then
        self:Close()
    end
end

---类的析构函数
function GoToTaptapDiscussView:Dispose()
end

return GoToTaptapDiscussView