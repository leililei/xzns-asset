local InviteNewPlayerModel = require "InviteNewPlayerModel"
local base = require "EventViewBase"
---@class InviteNewPlayerShareView : UIBaseView	中文描述
---@field public go_table InviteNewPlayerShareView_GoTable GoTable
local InviteNewPlayerShareView = _G.BaseClass("InviteNewPlayerShareView", base)

function InviteNewPlayerShareView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function InviteNewPlayerShareView:OnCreate(doneCall, closeCall)
    base.OnCreate(self, doneCall, closeCall)
    self:SetView()
end

function InviteNewPlayerShareView:SetView()
    --奖励
    local awards = _G.ConfigManager.discrete_cfg[109901]
    local getItem = function(_data, p)
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            _data,
            p,
            function(tran)
                tran.sid = _data[1]
                tran.gameObject:SetLocalPosition(0, 0, 0)
                tran.gameObject:SetRectTransformSize(0, 0)
                tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
            end,
            function(go)
                require "CommonTipManager":GetInstance():OpenTip(p, go.sid or go[1].sid)
            end
        )
    end
    for i = 1, self.go_table.obj_rootAward:GetChildCountE() do
        self.go_table.obj_rootAward:GetChildE(i - 1):DestroyObject()
    end
    for k, v in ipairs(awards) do
        getItem(v, self.go_table.obj_rootAward)
    end
    self.go_table.aortext_name.text =  _G.GetLangPackValue(90031800013, _G.PlayerModel:GetInstance():GetName())

    local server = _G.ServerManager:GetInstance():GetCurServer()
    self.go_table.aortext_server.text = server.ServerName
    self.go_table.aortext_number.text = InviteNewPlayerModel:GetInstance():GetSelfCode()
end

---按钮点击事件在这里派发
function InviteNewPlayerShareView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

return InviteNewPlayerShareView