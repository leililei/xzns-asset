local InviteNewPlayerModel = require "InviteNewPlayerModel"
local base = require "EventViewBase"
---@class InviteNewPlayerListView : UIBaseView	中文描述
---@field public go_table InviteNewPlayerListView_GoTable GoTable
local InviteNewPlayerListView = _G.BaseClass("InviteNewPlayerListView", base)

function InviteNewPlayerListView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function InviteNewPlayerListView:OnCreate(doneCall, closeCall)
    base.OnCreate(self, doneCall, closeCall)
    self:AddListener(_G.eInviteNewPlayer.RelieveBind, self.SetView)
    self.go_table.scrollloopvectical_memberList:InitItemData(0, _G.handler(self, self.RefreshItem))
    self.SociatyItemList = {}
    self:SetView()
    self.go_table.aorbtn_share:SetActiveE(_G.AppSetting.IsWeiXin and 1 or 0)
    self.go_table.aorbtn_copy:SetActiveE(_G.AppSetting.IsWeiXin and 0 or 1)

    if _G.SDKManager:GetInstance():CheckRusChannel() then
        self.go_table.aorbtn_share:SetActiveE(1)
        self.go_table.aorbtn_copy:SetActiveE(0)
    end
end

function InviteNewPlayerListView:SetView()
    --邀请人数
    local num = InviteNewPlayerModel:GetInstance():GetInviteMemberNum()
    self.go_table.aortext_inviteNum.text = _G.GetLangPackValue(90031900005,num)
    self.go_table.obj_IsNil:SetActiveE(num == 0 and 1 or 0)
    self.go_table.obj_have:SetActiveE(num > 0 and 1 or 0)
    if num == 0 then
        --邀请码
        local code = InviteNewPlayerModel:GetInstance():GetSelfCode()
        self.go_table.aortext_number.text = code
    else
        self:SetListView()
    end
end

function InviteNewPlayerListView:SetListView()
    self.memberList = InviteNewPlayerModel:GetInstance():GetBindRoles()
    self.go_table.scrollloopvectical_memberList:UpdateCount(#self.memberList)
end

function InviteNewPlayerListView:RefreshItem(index, item)
    if index < 0 then
        return
    end
    local id = item:GetInstanceIDE()
    local eIndex = index + 1
    local ctrl = self.SociatyItemList[id]
    if not ctrl then
        ctrl = _G.GetAutoGoTable(item)
        _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnItemClickBtn, ctrl))
        self.SociatyItemList[id] = ctrl
    end
    local data = self.memberList[eIndex]

    _G.UIUtils.SetPlayerHeadItemNew(ctrl.obj_HeadItemBase,data.role,0.65,true,false,true)
    ctrl.uid = data.role.uid
    ctrl.aortext_time.text = _G.TimeUtil.GetOfflineStateDesc(data.is_online)
    ctrl.aortext_server.text =  _G.GetLangPackValue(90020100025).. _G.ServerManager:GetInstance():GetServerNameByServerID(data.role.server_id)
    if data.role.afk then
        local cfg = _G.ConfigManager.afk_cfg[data.role.afk]
        if cfg then
            ctrl.aortext_jd.text = _G.GetLangPackValue(90020100026, cfg.chapter, cfg.section)
        else
            ctrl.aortext_jd.text = _G.GetLangPackValue(90020100026, 1, 1)
        end
    else
        ctrl.aortext_jd.text = _G.GetLangPackValue(90020100026, 1, 1)
    end
    ctrl.aortext_name.text = data.role.name
    ctrl.aortext_Power.text = _G.GameUtil.NumberToUnitStrFight(data.role.power)
end

function InviteNewPlayerListView:OnItemClickBtn(go, _, ctrl)
    if go == ctrl.aorbtn_cancel then
        InviteNewPlayerModel:GetInstance():BindCancel(ctrl.uid)
    end
end

---复制uid
function InviteNewPlayerListView:CopyUid()
    local code = InviteNewPlayerModel:GetInstance():GetSelfCode()
    if _G.AppSetting.IsWebGl then
        _G.GameUtil.CopyContent(code)
    else
        _G.GameUtil.CopyContent(code)
        _G.PopWindowManager:GetInstance():ShowAllTips(200105)
    end
end

---按钮点击事件在这里派发
function InviteNewPlayerListView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_closeView then
        self:Close()
    elseif go == self.go_table.aorbtn_share then
        if _G.SDKManager:GetInstance():CheckRusChannel() then
            --_G.SDKManager:GetInstance():ShareMultimedia("VK","rushare")
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ChooseRuChannelView.Name)
        else
            if _G.AppSetting.IsWeiXin then
                _G.SDKManager:GetInstance():Share()
            end
        end
    elseif go == self.go_table.aorbtn_copyId or go == self.go_table.aorbtn_copy then
        self:CopyUid()
    end
end

function InviteNewPlayerListView:Dispose()
    self:RemoveAllListener()
end

return InviteNewPlayerListView