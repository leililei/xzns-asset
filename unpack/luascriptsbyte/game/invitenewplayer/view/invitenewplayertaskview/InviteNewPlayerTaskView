function InviteNewPlayerTaskView:RefreshItem(index, item)
    if index < 0 then
        return
    end
    local id = item:GetInstanceIDE()
    local eIndex = index + 1
    local ctrl = self.SociatyItemList[id]
    if not ctrl then
        ctrl = _G.GetAutoGoTable(item)
        _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnItemClickBtn, ctrl))
        self.SociatyItemList[id] = ctrl
    end
    local data = self.taskList[eIndex]
    self:SetItem(ctrl, data)
end

function InviteNewPlayerTaskView:SetItem(ctrl, data)
    local awards = self.taskCfg[data.sid].reward

    for i = 1, ctrl.obj_awards:GetChildCountE() do
        ctrl.obj_awards:GetChildE(i - 1):DestroyObject()
    end

    local getItem = function(_data, p)
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            _data,
            p,
            function(tran)
                tran.sid = _data[1]
                tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                tran.gameObject:SetLocalScaleXYZ(0.8)
                local Quality = _G.StorageManager:GetInstance():GetItemQuality(_data[1])
                tran:ShowEffect(Quality >= 5)
            end,
            function(go)
                require "CommonTipManager":GetInstance():OpenTip(p, go.sid or go[1].sid)
            end
        )
    end

    for k, v in ipairs(awards) do
        getItem(v, ctrl.obj_awards)
    end

    local count = self.taskCfg[data.sid].count
    if count > 0 then
        if data.complete_times < count then
            ctrl.aortext_title.text = _G.GetLangPackValue(self.taskCfg[data.sid].desc) ..
                "(" .. ColorType[3] .. data.complete_times .. "</color>" .. "/" .. count .. ")"
        else
            ctrl.aortext_title.text = _G.GetLangPackValue(self.taskCfg[data.sid].desc) ..
                "(" .. data.complete_times .. "/" .. count .. ")"
        end
    else
        ctrl.aortext_title.text = _G.GetLangPackValue(self.taskCfg[data.sid].desc)
    end
    ctrl.sid = data.sid
    ctrl.aorimage_over:SetActiveE(0)
    ctrl.aorbtn_get:SetActiveE(0)
    ctrl.aorbtn_unGet:SetActiveE(0)
    if data.is_award == 1 then
        ctrl.aorbtn_get:SetActiveE(1)
    else
        if data.award_times == self.taskCfg[data.sid].number then
            ctrl.aorimage_over:SetActiveE(1)
        else
            ctrl.aorbtn_unGet:SetActiveE(1)
            ctrl.aorimage_unGet:SetGray(1)
        end
    end
    local maxNum = self.taskCfg[data.sid].number
    local curNum = maxNum - data.award_times
    local curStr
    if curNum < 1 then
        curNum = 0
        curStr = ColorType[1] .. curNum .. "</color>"
    else
        curStr = ColorType[2] .. curNum .. "</color>"
    end

    ctrl.aortext_limite.text = _G.GetLangPackValue(90031800008, curStr, maxNum)
end

function InviteNewPlayerTaskView:OnItemClickBtn(go, _, ctrl)
    if go == ctrl.aorbtn_get then
        InviteNewPlayerModel:GetInstance():GetAwards(ctrl.sid, 1)
    end
end

---复制uid
function InviteNewPlayerTaskView:CopyUid()
    local code = InviteNewPlayerModel:GetInstance():GetSelfCode()
    if _G.AppSetting.IsWebGl then
        _G.GameUtil.CopyContent(code)
    else
        _G.GameUtil.CopyContent(code)
        _G.PopWindowManager:GetInstance():ShowAllTips(200105)
    end
end

---按钮点击事件在这里派发
function InviteNewPlayerTaskView:OnClickBtn(go)
    if go == self.go_table.aorbtn_share then
        if _G.SDKManager:GetInstance():CheckRusChannel() then
            --_G.SDKManager:GetInstance():ShareMultimedia("VK","rushare")
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ChooseRuChannelView.Name)
        else
            if _G.AppSetting.IsWeiXin then
                _G.SDKManager:GetInstance():Share()
            end
        end
    elseif go == self.go_table.aorbtn_copy then
        self:CopyUid()
    elseif go == self.go_table.aorbtn_invite then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.InviteNewPlayerListView.Name)
    elseif go == self.go_table.aorbtn_copyId then
        self:CopyUid()
    end
end

function InviteNewPlayerTaskView:CloseView()
    self:Close()
end

function InviteNewPlayerTaskView:Dispose()
    self:RemoveAllListener()
end

return InviteNewPlayerTaskView
