end

---界面的入口函数
function InviteNewPlayerTaskView:OnCreate(doneCall, closeCall)
    if _G.AppSetting.IsXzns then
        ColorType = {
            "<color=#21801D>",
            "<color=#21801D>",
            "<color=#21801D>",
            "<color=#21801D>",
        }
    end
    base.OnCreate(self, doneCall, closeCall)
    self.SociatyItemList = {}
    self.taskCfg = _G.ConfigManager.recruit_new_cfg
    self:AddListener(_G.eInviteNewPlayer.TaskGetAwards, self.SetBottomView)
    self:AddListener(_G.eInviteNewPlayer.RelieveBind, self.SetTopView)
    self.go_table.scrollloopvectical_task:InitItemData(0, _G.handler(self, self.RefreshItem))
    InviteNewPlayerModel:GetInstance():GetDataToInf(function()
        self:SetTopView()
        self:SetBottomView()
        InviteNewPlayerModel:GetInstance():RefreshTaskRedPointValua()
        InviteNewPlayerModel:GetInstance():RefreshTaskRedPoint()

        self.go_table.aorbtn_share:SetActiveE(_G.AppSetting.IsWeiXin and 1 or 0)
        self.go_table.aorbtn_copy:SetActiveE(_G.AppSetting.IsWeiXin and 0 or 1)

        if _G.SDKManager:GetInstance():CheckRusChannel() then
            self.go_table.aorbtn_share:SetActiveE(1)
            self.go_table.aorbtn_copy:SetActiveE(0)
        end
    end)
end

