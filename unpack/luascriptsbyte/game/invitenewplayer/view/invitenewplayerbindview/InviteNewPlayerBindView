local InviteNewPlayerModel = require "InviteNewPlayerModel"

local base = require "EventViewBase"
---@class InviteNewPlayerBindView : UIBaseView	中文描述
---@field public go_table InviteNewPlayerBindView_GoTable GoTable
local InviteNewPlayerBindView = _G.BaseClass("InviteNewPlayerBindView", base)

function InviteNewPlayerBindView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function InviteNewPlayerBindView:OnCreate(doneCall, closeCall)
    base.OnCreate(self, doneCall, closeCall)
    _G.GameUtil.InputFieldCharacterLimitNew(self.go_table.input_num, 16)
    self:SetView()
    self:SetCode()
    InviteNewPlayerModel:GetInstance():RefreshBindRedPointValua()
    InviteNewPlayerModel:GetInstance():RefreshBindRedPoint()
end

function InviteNewPlayerBindView:SetView()
    self.go_table.aortext_desc.text = _G.GetLangPackValue(9002010027, _G.ConfigManager.discrete_cfg[109902][1][2])
    --奖励
    local awards = _G.ConfigManager.discrete_cfg[109901]
    local getItem = function(_data, p)
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            _data,
            p,
            function(tran)
                tran.sid = _data[1]
                tran.gameObject:SetLocalPosition(0, 0, 0)
                tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
            end,
            function(go)
                require "CommonTipManager":GetInstance():OpenTip(p, go.sid or go[1].sid)
            end
        )
    end
    for i = 1, self.go_table.obj_rootAward:GetChildCountE() do
        self.go_table.obj_rootAward:GetChildE(i - 1):DestroyObject()
    end
    for k, v in ipairs(awards) do
        getItem(v, self.go_table.obj_rootAward)
    end
end

function InviteNewPlayerBindView:SetCode()
    --邀请码
    local code = InviteNewPlayerModel:GetInstance():GetBindCode()
    self.go_table.input_num.enabled = code == ""
    self.go_table.aorbtn_bind:SetActiveE(code == "" and 1 or 0)
    self.go_table.obj_bind:SetActiveE(code == "" and 0 or 1)
    if code ~= "" then
        self.go_table.input_num.text = code
    end
end

---按钮点击事件在这里派发
function InviteNewPlayerBindView:OnClickBtn(go)
    if go == self.go_table.aorbtn_bind then
        InviteNewPlayerModel:GetInstance():Bind(self.go_table.input_num.text,
        function()
            self:SetCode()
        end)
    end
end

function InviteNewPlayerBindView:CloseView()
    self:Close()
end

return InviteNewPlayerBindView