local base = require("BaseGameNet")

---@class InviteNewPlayerNet : BaseGameNet	通信协议
local InviteNewPlayerNet = _G.BaseClass("InviteNewPlayerNet", base)
---@return InviteNewPlayerNet InviteNewPlayerNet
function InviteNewPlayerNet:GetInstance()
    return  base.GetInstance(self)
end

---监听推送
function InviteNewPlayerNet:AddMessageListeners()
    self:AddMessageListener(_G.ConfigManager.net_map.send_recruit_new_task.Cmd, self.P2CTaskChange)
end

---加入军团给所有已入会的人的推送
function InviteNewPlayerNet:P2CTaskChange(msg)
    local InviteNewPlayerModel = require("InviteNewPlayerModel")
    InviteNewPlayerModel:GetInstance():OnTaskChange(msg)
end

---请求信息
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function InviteNewPlayerNet:GetInfo(callback)
    local item = _G.ConfigManager.net_map.game_recruit_new_port_get_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---绑定
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function InviteNewPlayerNet:Bind(code, callback)
    local item = _G.ConfigManager.net_map.game_recruit_new_port_verification_code_bind
    local port = base.Access(self, item, {verification_code = code}, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---解绑
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function InviteNewPlayerNet:BindCancel(uid, callback)
    local item = _G.ConfigManager.net_map.game_recruit_new_port_relieve_bind
    local port = base.Access(self, item, {target_uid = uid}, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---领奖
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function InviteNewPlayerNet:GetAwards(sid, num, callback)
    local item = _G.ConfigManager.net_map.game_recruit_new_port_award
    local port = base.Access(self, item, {sid = sid, times = num}, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function InviteNewPlayerNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end


return InviteNewPlayerNet