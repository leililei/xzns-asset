local base = require "ActivitySynTypeBase"
---@class InviteNewPlayerTaskSynModel:ActivitySynTypeBase
local InviteNewPlayerTaskSynModel = _G.BaseClass("InviteNewPlayerTaskSynModel", base)
local TimeUtil = _G.TimeUtil
local ActivitySynManager = require "ActivitySynManager"

--创建对象时,入口构造函数
function InviteNewPlayerTaskSynModel:__init()
    self.InviteNewPlayerModel = require "InviteNewPlayerModel":GetInstance()
    self.InviteNewPlayerModel:SetTaskRedPoint(_G.handler(self, self.RefreshRedPoint))
    self.InviteNewPlayerModel:SetRefreshTaskRedPoint(_G.handler(self, self.SetRedPoint))
end

---销毁对象时,析构函数
function InviteNewPlayerTaskSynModel:Dispose()
end

---销毁对象时,析构函数
function InviteNewPlayerTaskSynModel:ParseData(data)
    base.ParseData(self)
    self:SetState()
end

function InviteNewPlayerTaskSynModel:SetState()
    if self.curActivityClass:GetCurActivityState() ~= ActivitySynManager.State.Close then
        if _G.TimeUtil.GetServerUnixTime() < _G.ConfigManager.discrete_cfg[109904][1][1] then
            self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
        end
    end
end

---进入活动主体
function InviteNewPlayerTaskSynModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.InviteNewPlayerTaskView.Name)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function InviteNewPlayerTaskSynModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.InviteNewPlayerTaskView.Name
end

