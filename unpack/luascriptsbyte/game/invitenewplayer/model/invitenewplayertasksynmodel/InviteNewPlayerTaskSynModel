function InviteNewPlayerTaskSynModel:SetRedPoint()
    _G.PlayerPrefsManager.SetInt("InviteNewPlayerTask_" .. self.curActivityClass:GetActivityID(), 1)
end

function InviteNewPlayerTaskSynModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end

function InviteNewPlayerTaskSynModel:CheckRedPoint()
    if not _G.table.ContainsValue(_G.ConfigManager.discrete_cfg[100317][1], _G.GameUtil:GetPlatform()) then
        return 0
    end
    local num = _G.PlayerPrefsManager.GetInt("InviteNewPlayerTask_" .. self.curActivityClass:GetActivityID(), 0)
    if num == 0 then
        return 1
    else
        return self.InviteNewPlayerModel:CheckTaskRed()
    end
end

---刷新奖励红点
function InviteNewPlayerTaskSynModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end
---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function InviteNewPlayerTaskSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end


