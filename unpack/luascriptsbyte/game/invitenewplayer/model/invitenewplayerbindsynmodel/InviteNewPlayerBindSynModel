local base = require "ActivitySynTypeBase"
---@class InviteNewPlayerBindSynModel:ActivitySynTypeBase
local InviteNewPlayerBindSynModel = _G.BaseClass("InviteNewPlayerBindSynModel", base)
local TimeUtil = _G.TimeUtil
local ActivitySynManager = require "ActivitySynManager"

--创建对象时,入口构造函数
function InviteNewPlayerBindSynModel:__init()
    self.InviteNewPlayerModel = require "InviteNewPlayerModel":GetInstance()
    self.InviteNewPlayerModel:SetBindRedPoint(_G.handler(self, self.RefreshRedPoint))
    self.InviteNewPlayerModel:SetRefreshBindRedPoint(_G.handler(self, self.SetRedPoint))
    _G.Events:GetInstance():AddListener(_G.ePlayerStatus.PlayerUpLevel, self.SetState, self)
end

---销毁对象时,析构函数
function InviteNewPlayerBindSynModel:Dispose()
end

---销毁对象时,析构函数
function InviteNewPlayerBindSynModel:ParseData(data)
    base.ParseData(self)
    self:SetState()
end

function InviteNewPlayerBindSynModel:SetState()
    local cfg = _G.ConfigManager.function_open_cfg[256]
    if self.curActivityClass:GetCurActivityState() ~= ActivitySynManager.State.Close then
        if _G.TimeUtil.GetServerUnixTime() < _G.ConfigManager.discrete_cfg[109904][1][1] then
            self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
        end
    end
    if _G.GlobalConditionManager.CheckConditionByArray(cfg.condition_type) then
        self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
    end
end

---进入活动主体
function InviteNewPlayerBindSynModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.InviteNewPlayerBindView.Name)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function InviteNewPlayerBindSynModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.InviteNewPlayerBindView.Name
end

function InviteNewPlayerBindSynModel:SetRedPoint()
    _G.PlayerPrefsManager.SetInt("InviteNewPlayerBind_" .. self.curActivityClass:GetActivityID(), 1)
end

function InviteNewPlayerBindSynModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end

function InviteNewPlayerBindSynModel:CheckRedPoint()
    if not _G.table.ContainsValue(_G.ConfigManager.discrete_cfg[100316][1], _G.GameUtil:GetPlatform()) then
        return 0
    end
    local num = _G.PlayerPrefsManager.GetInt("InviteNewPlayerBind_" .. self.curActivityClass:GetActivityID(), 0)
    return num == 0 and 1 or 0
end

---刷新奖励红点
function InviteNewPlayerBindSynModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end
---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function InviteNewPlayerBindSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

--region 子类重写
---从服务器拉取数据
function InviteNewPlayerBindSynModel:GetDataFormServer()
    if self.curActivityClass:GetCurActivityState() ~= ActivitySynManager.State.Close then
        self.InviteNewPlayerModel:GetDataToInf(_G.handler(self, self.ParseData))
    end

    --self:ParseData()
end

---初始化功能逻辑
function InviteNewPlayerBindSynModel:InitFunction()
    self.InviteNewPlayerModel:InitFunction()
end

return InviteNewPlayerBindSynModel