---获取任务
function InviteNewPlayerModel:GetTaskList()
    local cfg = _G.ConfigManager.recruit_new_cfg
    local topTask = {}
    local task = {}
    for k, v in ipairs(self.taskLists) do
        if cfg[v.sid].condition[1][1] == 1 then
            _G.table.insert(topTask, v)
        else
            _G.table.insert(task, v)
        end
    end
    _G.table.sort(task, function(a, b)
        if a.is_award ~= b.is_award then
            return a.is_award == 1
        end
        if (cfg[a.sid].number > a.award_times) ~= (cfg[b.sid].number > b.award_times) then
            return cfg[a.sid].number > a.award_times
        end
        return a.sid < b.sid
    end)
    _G.table.insert(task,1,topTask[1])
    return topTask, task
end

