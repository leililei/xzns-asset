function InviteNewPlayerModel:InitFunction()
end

---获取信息
function InviteNewPlayerModel:GetDataToInf(Call)
    InviteNewPlayerNet:GetInstance():GetInfo(
        function(data)
            if data.code ~= nil then
                self.selfCode = data.code
            else
                self.selfCode = ""
            end
            if data.target_code ~= nil then
                self.targetCode = data.target_code
            else
                self.targetCode = ""
            end
            if data.band_roles ~= nil then
                self.bindRoles = data.band_roles
            else
                self.bindRoles = {}
            end
            if data.tasks ~= nil then
                self.taskLists = data.tasks
            else
                self.taskLists = {}
            end
            if Call ~= nil then
                Call(data)
            end
            self:ParseData()
        end
    )
end

---绑定
function InviteNewPlayerModel:Bind(code, Call)
    InviteNewPlayerNet:GetInstance():Bind(code,
        function(data)
            if data.ack == 1 then
                self.targetCode = code
                _G.StorageManager:GetInstance():ReceiveAwardData(data)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data, nil, true)
                if Call ~= nil then
                    Call()
                end
            end
        end
    )
end

---解绑
function InviteNewPlayerModel:BindCancel(uid, Call)
    local function confirmFunc()
        InviteNewPlayerNet:GetInstance():BindCancel(uid,
        function(data)
            if data.ack == 1 then
                for k, v in ipairs(self.bindRoles) do
                    if v.role.uid == uid then
                        _G.table.remove(self.bindRoles, k)
                        break
                    end
                end
                _G.Events:GetInstance():Broadcast(_G.eInviteNewPlayer.RelieveBind)
                if Call ~= nil then
                    Call()
                end
            end
        end
    )
    end
    _G.PopWindowManager:GetInstance():ShowAllTips(6005, nil, confirmFunc)
end

---领奖
function InviteNewPlayerModel:GetAwards(sid, num, Call)
    InviteNewPlayerNet:GetInstance():GetAwards(sid, num,
        function(data)
            if data.ack == 1 then
                _G.StorageManager:GetInstance():ReceiveAwardData(data)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data, nil, true)
                for i = 1, #self.taskLists do
                    if self.taskLists[i].sid == sid then
                        self.taskLists[i] = data.task
                        break
                    end
                end
                self:RefreshTaskRedPoint()
                _G.Events:GetInstance():Broadcast(_G.eInviteNewPlayer.TaskGetAwards)
                if Call ~= nil then
                    Call(data)
                end
            end
        end
    )
end

---任务状态变更推送
function InviteNewPlayerModel:OnTaskChange(msg)
    local newTask = {}
    for k, v in ipairs(msg.tasks) do
        newTask[v.sid] = v
    end
    for i = 1, #self.taskLists do
        local sid = self.taskLists[i].sid
        if newTask[sid] then
            self.taskLists[i] = newTask[sid]
        end
    end
    if #msg.tasks > 0 then
        self:RefreshTaskRedPoint()
        _G.Events:GetInstance():Broadcast(_G.eInviteNewPlayer.TaskGetAwards)
    end
end

