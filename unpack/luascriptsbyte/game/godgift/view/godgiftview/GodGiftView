local ActivitySynManager = require "ActivitySynManager"
---@class GodGiftView : UIBaseView	中文描述
---@field public go_table GodGiftView_GoTable GoTable
---@field Icons GodGiftView._aorbtn_role1_GoTable[] 卡牌物体
---@field activity ActivitySynGMActivity 活动数据
---@field activityTypeCls GodGiftModel 活动类型数据
local GodGiftView = _G.BaseClass("GodGiftView", _G.UIBaseView)
--_G.GodGiftView = GodGiftView
local version = _G.ConfigManager.discrete_cfg[100108][1][1]
function GodGiftView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@field activity ActivitySynGMActivity 活动数据
function GodGiftView:OnCreate(activity)
    self.Icons = {}
    self:UpdateView(activity)
    self:UIEffect()
    self:AddListener(_G.eGodGift.RefreshAwardCount, self.UpdateCount)
    require "FreeGiftManager":GetInstance():Show(
       _G.FreeGiftID.GodGift,
       self.go_table.obj_freeGift,
       self.activity:GetActivityID()
    )
end

---特效更新(背景，标题，降神招募框)
function GodGiftView:UIEffect()
    local LoadEffectByCfg = _G.UIUtils.LoadEffectByCfg
    local RemoveEffect = _G.UIUtils.RemoveEffect
    local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
    local check = function(obj)
        if self:IsNil() then
            RemoveEffect(obj)
        end
    end
    LoadEffectByCfg(ui_effect_cfg.ef_GodGiftView_Title, self.go_table.trans_EfTitle, check)
    LoadEffectByCfg(ui_effect_cfg.ef_GodGiftView_Icon, self.go_table.aorrawimage_icon, check)
    LoadEffectByCfg(ui_effect_cfg.ef_GodGiftView_Bg, self.go_table.trans_EfBg)
end

---更新界面
---@field activity ActivitySynGMActivity 活动数据
function GodGiftView:UpdateView(activity)
    self.activity = activity
    self.activityTypeCls = self.activity:GetActivityTypeCls()
    if version == 2 then
        self.go_table.aortext_condition.text = self.activityTypeCls:GetCondition()
        self.go_table.obj_tips:SetActiveE(1)
    elseif version == 1 then
        self.go_table.aortext_condition:SetActiveE(0)
        self.go_table.obj_tips:SetActiveE(0)
    end
    self:UpdateTime()
    self:UpdateCount()
    self:UpdateIcon()
    self.go_table.aorrawimage_icon:LoadImage(
        _G.StorageManager:GetInstance():GetItemIcon(self.activityTypeCls:GetRewardSid())
    )
end

---更新时间
function GodGiftView:UpdateTime()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.startTime = self.activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Open)
    self.settlementTime = self.activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Settlement)
    self.endTime = self.activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    local startTime = _G.TimeUtil.GetDateTime(self.startTime)
    local settlementTime = _G.TimeUtil.GetDateTime(self.settlementTime)
    local endTime = _G.TimeUtil.GetDateTime(self.endTime)
    local text1 = _G.GetLangPackValue(90000010300,startTime.month,startTime.day,startTime.hour)
    .."-".. _G.GetLangPackValue(90000010300,settlementTime.month,settlementTime.day,settlementTime.hour)
    self.go_table.aortext_activityTime.text = _G.GetLangPackValue(90025800003,text1)
    local text2 = _G.GetLangPackValue(90000010300,settlementTime.month,settlementTime.day,settlementTime.hour)
    .."-".. _G.GetLangPackValue(90000010300,endTime.month,endTime.day,endTime.hour)
    self.go_table.aortext_settlementTime.text = _G.GetLangPackValue(90028010132,text2)
    if self.activity:GetCurActivityState() == ActivitySynManager.State.smch then
        self.endTime, self.RTS = self.activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
        if self.RTS <= 0 then
            return
        end
        local time = _G.TimeUtil.TransLateSMCH(self.RTS)
        self.go_table.aortext_getTime.text = _G.LangUtil.GetLangPackValue(90000001030, time)
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimerShow, self, false, false, true,false)
        self.timer:Start()
    end
    ---@type function_open_cfg
    local cfg = _G.ConfigManager.function_open_cfg[_G.FunctionID.GodDraw]
    ---@type afk_cfg
    local afkCfg = _G.ConfigManager.afk_cfg[cfg.condition_type[1][2]]
    self.go_table.aortext_godOpenTime.text =
        _G.LangUtil.GetLangPackValue(90000001038, cfg.condition_type[2][2], afkCfg.chapter, afkCfg.section)
    self:InitGiftBtn()
end

---更新计时显示
function GodGiftView:UpdateTimerShow(isShow,elapsed)
    if not isShow then
        self.RTS = self.RTS - elapsed
        if self.RTS <= 0 then
            if self.timer then
                self.timer:Stop()
                self.timer = nil
            end
            self.RTS = 0
        end
    end
    local time = _G.TimeUtil.TransLateSMCH(Mathf.RoundToInt(self.RTS))
    self.go_table.aortext_getTime.text = _G.LangUtil.GetLangPackValue(90000001030, time)
end
---更新头像
function GodGiftView:UpdateIcon()
    local check = function(obj)
        if self:IsNil() then
            _G.UIUtils.RemoveEffect(obj)
        end
    end
    for i = 1, 6 do
        if not self.Icons[i] then
            self.Icons[i] =
                _G.GetAutoGoTable(self.go_table["aorbtn_role" .. i], _G.handlerbind(self, self.OnClickIcon, i))
        end
        ---@type card_cfg
        local cfg = _G.ConfigManager.card_cfg[self.activityTypeCls:GetCardSid(i)]
        self.Icons[i].aorrawimage_role:LoadImage(cfg.Photo)
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_GodGiftView_Show,
            self.Icons[i].trans_EfIcon,
            check
        )
    end
end
---点击头像
function GodGiftView:OnClickIcon(_, _, index)
    require "CommonTipManager":GetInstance():OpenCardTip(self.activityTypeCls:GetCardSid(index))
end
---更新奖励数量
function GodGiftView:UpdateCount()
    self.go_table.aortext_getCount.text =
        _G.LangUtil.GetLangPackValue(90000001039, self.activityTypeCls:GetRewradCount())
end

---按钮点击事件在这里派发
function GodGiftView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_go then
        _G.JumpManager:GetInstance():Jump(108001)
    elseif go == self.go_table.aorbtn_icon then
        require "CommonTipManager":GetInstance():OpenTip(go, self.activityTypeCls:GetRewardSid())
    elseif go == self.go_table.aorbtn_way then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 52)
    elseif go == self.go_table.aorbtn_GetAward then
        self.activity.typeClass:GetCashAward(function()
            self.activity:ChangeState(ActivitySynManager.State.Close)
            local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ActivityView.Name)
            if view then
                view:Close()
            end
        end)
    end
end

function GodGiftView:CloseView()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:Close()
end

function GodGiftView:InitGiftBtn()
    if self.activity:GetCurActivityState() == ActivitySynManager.State.Open then
        self.go_table.aorbtn_go:SetActiveE(1)
        self.go_table.aorbtn_GetAward:SetActiveE(0)
    elseif self.activity:GetCurActivityState() == ActivitySynManager.State.smch then
        self.go_table.aorbtn_GetAward:SetActiveE(1)
        self.go_table.aorbtn_go:SetActiveE(0)
        self.go_table.obj_freeGift:SetActiveE(0)
    end
end

return GodGiftView
