local base = require "ActivitySynTypeBase"
local ActivitySynManager = require "ActivitySynManager"
---@class GodGiftModel:ActivitySynTypeBase
---@field info activity_cash_award.i_activity_cash_award
---@field isWait boolean 等待开启
local GodGiftModel = _G.BaseClass("GodGiftModel", base)
local version = _G.ConfigManager.discrete_cfg[100108][1][1]
---创建对象时,入口构造函数
function GodGiftModel:__init()
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    self.curActivityClass:AddStateChanged(self.StateChange, self)
end

---销毁对象时,析构函数
function GodGiftModel:Dispose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.timer2 then
        self.timer2:Stop()
        self.timer2 = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

---当状态改变
function GodGiftModel:StateChange(state)
    if state == ActivitySynManager.State.Open then
        require "FreeGiftManager":GetInstance():Add(
            _G.FreeGiftID.GodGift,
            self.info.day_a,
            function(call)
                require "ActivitySynNet":GetInstance():GetAward(
                    self.curActivityClass:GetActivityID(),
                    { 0 },
                    function(msg)
                        if call then
                            call(msg)
                        end
                    end
                )
            end,
            self:GetRedpointIDByIndex(1),
            self.curActivityClass:GetActivityID()
        )
    elseif state == ActivitySynManager.State.Settlement then
        local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.GodGiftView.Name)
        if self:GetRewradCount() > 0 then
            self.curActivityClass:ChangeState(ActivitySynManager.State.smch)
            if window then
                window.View:UpdateTime()
            end
        else
            self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
            if window then
                local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ActivityView.Name)
                if view then
                    view:Close()
                end
            end
        end
    else
        require "FreeGiftManager":GetInstance():Remove(_G.FreeGiftID.GodGift, self.curActivityClass:GetActivityID())
    end
    self:UpdateRedPoint()
end

---获取GM数据
function GodGiftModel:OnHandleGMData(info)
    self:ParseData(info)
end
---解析数据
function GodGiftModel:ParseData(info)
    self:SetSelfData(info)
    base.ParseData(self)
end

---@param info activity.i_activity_self_info
function GodGiftModel:SetSelfData(info)
    self.info = info.day_cash_award
    if self.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Settlement then
        if self.info.day_a then
            self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
            local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.GodGiftView.Name)
            if window then
                local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ActivityView.Name)
                if view then
                    view:Close()
                end
            end
        else
            self.curActivityClass:ChangeState(ActivitySynManager.State.smch)
        end
    elseif self.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Open then
        require "FreeGiftManager":GetInstance():Add(
            _G.FreeGiftID.GodGift,
            self.info.day_a,
            function(call)
                require "ActivitySynNet":GetInstance():GetAward(
                    self.curActivityClass:GetActivityID(),
                    { 1 },
                    function(msg)
                        if call then
                            call(msg)
                        end
                    end
                )
            end,
            self:GetRedpointIDByIndex(1),
            self.curActivityClass:GetActivityID()
        )
    end
    self:UpdateRedPoint()
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.GodGiftView.Name)
    if window then
        window.View:UpdateView(self.curActivityClass)
    end
    if not self.isSet and self.info.cash_num == 0 then
        self.isSet = true
        require("ActivitySynNet"):GetInstance():InitActivity(
            self.curActivityClass:GetActivityID(),
            _G.handler(self, self.UpdateInitData)
        )
    end
end

function GodGiftModel:UpdateInitData(msg)
    if msg.ack == 1 then
        self:OnHandleGMData(msg.activity[1].self_info)
    end
end
---更新充值金额

function GodGiftModel:InitFunction()
    if require "MallManager":GetInstance():GetCashRmb() == nil then
        return
    end
    if not self.isWait and require "MallManager":GetInstance():GetCashRmb() < self.info.cash_con then
        self.isWait = true
        self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
    end
end

---初始化红点
function GodGiftModel:InitRedPointTree()
    self.checkRedPointFunc = { self.CheckRedPoint }
    self.redpointTree = { { 2 }, false }
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function GodGiftModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

function GodGiftModel:UpdateRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

function GodGiftModel:CheckRedPoint()
    if self.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Open then
        if
        require "FreeGiftManager":GetInstance():CheckCanTake(
            _G.FreeGiftID.GodGift,
            self.curActivityClass:GetActivityID()
        )
        then
            return 1
        end
    else
        if not self.info.day_a then
            return 1
        end
    end
    return 0
end
---充值监听
---@param data store.p2c_store_cash
function GodGiftModel:OnMallCashListener(data)
    if self.curActivityClass:GetCurActivityState() ~= ActivitySynManager.State.Open and not self.isWait then
        return
    end
    if version == 1 then
        self.info.cash_num = self.info.cash_num + data.cash_rmb
    elseif version == 2 then
        self.info.cash_num = self.info.cash_num + data.base_rmb
    end
    if self.isWait then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.OnMallCashListenerCall, self, true, true, true)
        self.timer:Start()
    end
    _G.Events:GetInstance():Broadcast(_G.eGodGift.RefreshAwardCount)
end

function GodGiftModel:OnMallCashListenerCall()
    self.timer:Stop()
    self.timer = nil
    if require "MallManager":GetInstance():GetCashRmb() >= self.info.cash_con then
        self.isWait = nil
        self.curActivityClass:ChangeState(ActivitySynManager.State.Open)
    end
end
---获取累计奖励数量
function GodGiftModel:GetRewradCount()
    return _G.math.floor(self.info.cash_num / self.info.price)
end

function GodGiftModel:GetCondition()
    return self.info.price
end
---获取卡牌sid
---@param index number 下标1-6
function GodGiftModel:GetCardSid(index)
    if not index or index > 6 then
        index = 1
    end
    return self.info.sids[index] or self.info.sids[1]
end
---获取奖励sid
function GodGiftModel:GetRewardSid()
    return self.info.cash_award[1].type[1]
end

function GodGiftModel:OnEnterActivity()
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.GodGiftView.Name)
    if window then
        window.View:UpdateView(self.curActivityClass)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GodGiftView.Name, self.curActivityClass)
    end
    base.OnEnterActivity(self)
end

---获取界面名字
function GodGiftModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.GodGiftView.Name
end

function GodGiftModel:GetCashAward(callback)
    require "ActivitySynExtraNet":GetInstance():GetAward(
        self.curActivityClass:GetActivityID(),
        { 2 },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            require "CommonTipManager".OpenCommonAwardView(msg, callback)
            self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
            self.info.day_a = true
            require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
        end
    )
end

return GodGiftModel
