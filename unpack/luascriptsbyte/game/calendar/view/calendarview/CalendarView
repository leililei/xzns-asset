---@class CalendarView : UIBaseView	中文描述
---@field public go_table CalendarView_GoTable GoTable
local CalendarView = _G.BaseClass("CalendarView", _G.UIBaseView)

local positionX = {-292, -219, -148, -73.4, -0.6, 72.2, 145, 217.4}
local lenth = {80, 155, 229, 301, 374, 446, 518, 589}
local weekTab = {
        90010050322,90010050323,90010050324,90010050325,90010050326,90010050327,90010050328
    }
local CalendarModel = require "CalendarModel":GetInstance()
function CalendarView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function CalendarView:OnCreate()
    CalendarModel:RefreshRedPoint()
    self.curTime = _G.TimeUtil.GetServerUnixTime()
    self.toDay=_G.TimeUtil.GetIntervalDay(_G.PlayerModel:GetInstance():GetServerOpenTime(),self.curTime)+1
    if self.toDay> CalendarModel.today then
        CalendarModel.actList={}
        CalendarModel:InitList()
    end
    self.actList = CalendarModel:GetList()
    _G.table.sort(self.actList,function(a,b) return a.startDay<b.startDay  end)
    self:FreshDate()
    self.go_table.scrollloopvectical_itemList:InitItemData(#self.actList, _G.handler(self, self.RefreshItem))
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.FreshView, self)
end

function CalendarView:FreshView()
    self.actList = CalendarModel:GetList()
    _G.table.sort(self.actList,function(a,b) return a.startDay<b.startDay  end)
    self:FreshDate()
    self.go_table.scrollloopvectical_itemlist:UpdateAllItem()
end

function CalendarView:FreshDate()
    for i = 1, 8 do 
        local time = self.curTime + (i-1) * 86400
        local tb = _G.TimeUtil.date("*t", _G.TimeUtil.GetDayBegin(time))
        self.go_table["aortext_day" .. i].text = _G.GetLangPackValue(weekTab[tb.wday]) 
        self.go_table["aortext_date" .. i].text = string.format("%s.%s", tb.month, tb.day)
    end
end

function CalendarView:RefreshItem(index, go)
    if index < 0 then
        return
    end
    index = index + 1
    local info = self.actList[index]
    local tb = _G.GetAutoGoTable(go,_G.handlerbind(self, self.OpenTips,info))
    tb.aorimage_icon.SpriteName = string.IsNullOrEmpty(info.cfg.icon) and info.icon or info.cfg.icon
    local str=info.name
    if info.runDay==2  or (self.toDay+7-info.runDay)==2 then
        str=_G.string.utf8sub(str,1,2)
        str=str..".."
    elseif info.runDay==1 or (self.toDay+7-info.runDay)==2 then
        str=""
    end
    tb.aortext_title.text = str
    tb.aorbtn_act:SetRectTransformSize(lenth[ info.runDay], 68)
    tb.obj_act:SetRectTransformSize(lenth[ info.runDay], 68)
    local x, y, z = tb.obj_act:GetLocalPosition()
    tb.obj_act:SetLocalPosition(positionX[info.startDay<self.toDay and 1 or (info.startDay-self.toDay+1)], y, z)
    tb.aorimage_act.SpriteName = info.cfg.colour
    x, y, z = tb.obj_icon:GetLocalPosition()
    tb.obj_icon:SetLocalPosition(info.runDay <= 2 and 33 or 50, y, z)
    x,y = tb.aorbtn_act:GetRectTransformSize()
    tb.aortext_title:SetRectTransformSize(x - 100, 40)
    x, y, z = tb.aortext_title:GetLocalPosition()
    tb.aortext_title:SetLocalPosition(info.runDay == 2 and x-10 or x,y);
end

function CalendarView:OpenTips(go, bol, info)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CalendarTipsView.Name, info)
end

function CalendarView:CloseView()
    self:Close()
end

---按钮点击事件在这里派发
function CalendarView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_close then
        self:Close()
    end
end

function CalendarView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.FreshView, self)
end

return CalendarView