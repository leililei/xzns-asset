---@class CalendarTipsView : UIBaseView	中文描述
---@field public go_table CalendarTipsView_GoTable GoTable
local CalendarTipsView = _G.BaseClass("CalendarTipsView", _G.UIBaseView)
local CalendarModel = require "CalendarModel":GetInstance()
function CalendarTipsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function CalendarTipsView:OnCreate(info)
    self.info = info 
    self:FreshView()
end

function CalendarTipsView:FreshView()
    local curTime = _G.TimeUtil.GetServerUnixTime()
    local tb1 =  _G.TimeUtil.date("*t", self.info.startTime)
    local tb2 = _G.TimeUtil.date("*t", self.info.endTime)
    self.go_table.aorimage_icon.SpriteName = string.IsNullOrEmpty(self.info.cfg.icon) and self.info.icon or self.info.cfg.icon 
    self.go_table.aortext_des.text = _G.GetLangPackValue(self.info.cfg.desc)
    self.go_table.aortext_name.text = self.info.name
    local timeStr1 = _G.string.format("%02d:%02d", tb1.hour, tb1.min)
    local timeStr2 = _G.string.format("%02d:%02d", tb2.hour, tb2.min)
    self.go_table.aortext_time.text = string.format("%s.%s.%s %s - %s.%s.%s %s", tb1.year, tb1.month, tb1.day,timeStr1, tb2.year, tb2.month, tb2.day,timeStr2)
    self.go_table.obj_list:ClearChildren()
    for key, value in ipairs(self.info.cfg.rewards) do
        local Item=_G.InstantiateObject(self.go_table.obj_item,self.go_table.obj_list)
        local item = require "BaseAwardNewItem".New(Item, nil, 60)
        item:ShowWithID(value)
        item:ShowEffect( true ,0.7)
    end
    local bol = curTime > self.info.startTime and curTime < self.info.endTime
    --self.go_table.aorbtn_go:SetActiveE(bol and 1 or 0)
    --self.go_table.aortext_time1:SetActiveE(bol and 0 or 1)
    if self.info.endTime> curTime and self.info.startTime<=curTime then
        self.CountDown = self.info.endTime - curTime
        self.go_table.aortext_time1.text =
        _G.GetLangPackValue(
                90010050331,
                string.format("<color=#f1df89>%s</color>", _G.TimeUtil.TranslateSecondForStrAcientEvil(self.CountDown))
        )
        self.Timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateEndTime, self, false, false, true)
        self.Timer:Start()
    elseif self.info.startTime>curTime then
        ---该活动未开始
        self.CountDown = self.info.startTime - curTime
        self.go_table.aortext_time1.text =
        _G.GetLangPackValue(
                90010050330,
                string.format("<color=#f1df89>%s</color>", _G.TimeUtil.TranslateSecondForStrAcientEvil(self.CountDown))
        )
        self.Timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateStartTime, self, false, false, true)
        self.Timer:Start()
    elseif self.info.endTime<=curTime then
        self.go_table.aortext_time1.text =_G.GetLangPackValue(90026100053)
    end
end

function CalendarTipsView:UpdateStartTime(elapsed)
    self.CountDown = self.CountDown - elapsed
    self.go_table.aortext_time1.text =
    _G.GetLangPackValue(
            90010050330,
            string.format(
                    "<color=#f1df89>%s</color>",
                    _G.TimeUtil.TranslateSecondForStrAcientEvil(self.CountDown)
            )
    )
    if self.CountDown <= 0 then
        self.CountDown = self.info.endTime - _G.TimeUtil.GetServerUnixTime()
        self.go_table.aortext_time1.text =
        _G.GetLangPackValue(
                90010050331,
                string.format("<color=#f1df89>%s</color>", _G.TimeUtil.TranslateSecondForStrAcientEvil(self.CountDown))
        )
        self.Timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateEndTime, self, false, false, true)
        self.Timer:Start()
    end
end
function CalendarTipsView:UpdateEndTime(elapsed)
    self.CountDown = self.CountDown - elapsed
    self.go_table.aortext_time1.text =
    _G.GetLangPackValue(
            90010050331,
            string.format(
                    "<color=#f1df89>%s</color>",
                    _G.TimeUtil.TranslateSecondForStrAcientEvil(self.CountDown)
            )
    )
    if self.CountDown <= 0 then
        self.go_table.aortext_time1.text = GetLangPackValue(90026500028)
        if self.Timer then
            self.Timer:Stop()
            self.Timer = nil
        end
    end
end

function CalendarTipsView:CloseView()
    self:Close()
end

---按钮点击事件在这里派发
function CalendarTipsView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_close then
        if self.Timer then
            self.Timer:Stop()
        end
        self:Close()
    elseif go == self.go_table.aorbtn_go then 
        if self.info.cfg.link and self.info.cfg.link ~= 0 then 
            _G.JumpManager:GetInstance():Jump(self.info.cfg.link)
        else 
            if self.info.cfg.type == 2 then 
                _G.GlobalInterface.JumpActivityByCfg(self.info.id)
            else 
                _G.GlobalInterface.JumpActivityByGM(self.info.cfg.type_activity, self.info.cfg.sub_type)
            end
        end
    end
end

function CalendarTipsView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.FreshView, self)
end

return CalendarTipsView