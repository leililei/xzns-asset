---@class CalendarModel : Singleton	免费礼包
---@filed timer Timer 刷新倒计时
local CalendarModel = _G.BaseClass("CalendarModel", _G.Singleton)

function CalendarModel:__init()
    self.redPointId=_G.ConfigManager.redpoint_cfg.Calendar.id
    self.actList = {}
    self:InitList()
end
---释放
function CalendarModel:Dispose()
    self.actList = nil
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---@return CalendarModel CalendarModel
function CalendarModel:GetInstance()
    return self.super.GetInstance(self)
end
function CalendarModel:InitList()
    self.curTime = _G.TimeUtil.GetServerUnixTime()
    self.serverStartTime=_G.PlayerModel:GetInstance():GetServerOpenTime()
    self.today=_G.TimeUtil.GetIntervalDay(self.serverStartTime,self.curTime)+1
    local startTime,runTime,endTime,todayTime,serverRunTime
    todayTime=_G.TimeUtil.GetDayBegin(self.curTime)
    serverRunTime=todayTime-self.serverStartTime
    local cycle
    for k, v in pairs(_G.ConfigManager.activity_calendar_cfg) do
        runTime = v.time_duration
        if serverRunTime>v.time then
            --超过时间计算已结束活动轮数
            cycle=_G.math.floor( (serverRunTime-v.time)/(v.time_duration+v.time_interval))
            --计算当前轮数的开始时间
            startTime=self.serverStartTime+v.time+(v.time_duration+v.time_interval)*cycle
            --当前轮数
            cycle=cycle+1
        else
            startTime=v.time+self.serverStartTime
            cycle=1
        end
        endTime=startTime+runTime
        for i = 1, 8 do
            if (startTime>todayTime+691200 or  (cycle>v.num_cycle and v.num_cycle~=0)) then
                break
            end
            if (startTime>=todayTime and startTime<todayTime+691200) or (startTime<todayTime and endTime>todayTime) then
                local startDay = _G.TimeUtil.GetIntervalDay(self.serverStartTime,startTime)+1
                local endDay=_G.TimeUtil.GetIntervalDay(self.serverStartTime,endTime)
                local runDay =startTime>=todayTime and _G.TimeUtil.GetIntervalDay(startTime,endTime) or _G.TimeUtil.GetIntervalDay(todayTime,endTime)
                if endTime~=_G.TimeUtil.GetDayBegin(endTime) then
                    endDay=endDay+1
                    runDay=runDay+1
                end
                startDay = math.max(1, startDay)
                local T = {}
                T.icon = v.icon
                T.name = _G.GetLangPackValue(v.name)
                T.startDay = startDay
                T.runDay = runDay
                T.endDay=endDay
                T.startTime = startTime
                T.endTime = endTime
                T.cfg = v
                table.insert(self.actList, T)
            end
            startTime=endTime+v.time_interval
            endTime=startTime+runTime
            cycle= cycle+1
        end
    end
end

function CalendarModel:GetList()
    return self.actList 
end
function CalendarModel:RefreshRedPoint()
    local rolid = _G.PlayerModel:GetInstance():GetPlayerUid()
    local curTime,serverStartTime
    serverStartTime=_G.PlayerModel:GetInstance():GetServerOpenTime()
    curTime = _G.TimeUtil.GetServerUnixTime()
    local today=_G.TimeUtil.GetIntervalDay(serverStartTime,curTime)+1
    local lastday=_G.PlayerPrefsManager.GetInt("NewactTime" .. rolid)
    for i = 1, #self.actList do
        if self.actList[i].startDay==today and today>lastday then
            _G.PlayerPrefsManager.SetInt("NewactTime" .. rolid,today)
        end
    end
    require "RedPointManager":GetInstance():RefreshNode(self.redPointId)
end

return CalendarModel
