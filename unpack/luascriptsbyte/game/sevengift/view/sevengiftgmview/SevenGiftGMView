function SevenGiftGMView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SevenGiftGMView:OnCreate(FreshRedBol)
    self.nowGiftIndex = 1
    self.btnGoTable = {}
    self.chooseObj = {}
    self.itemTransDic = {}
    StorageManager = _G.StorageManager:GetInstance()
    SevenGiftGMSynModel = require "SevenGiftGMSynModel":GetInstance()
    for i = 1, 4 do
        self.btnGoTable[i] =
            _G.GetAutoGoTable(self.go_table["aorbtn_gift" .. i], _G.handlerbind(self, self.ClickBtn, i))
    end
    _G.GameUtil.AddDouYinIcon(self.go_table.aorbtn_buy, true)
    self:InitView(FreshRedBol)
end

function SevenGiftGMView:InitView(FreshRedBol)
    self.ActivityData = require "SevenGiftGMSynModel":GetInstance():GetOpenGift()
    if #self.ActivityData == 0 then
        self:Close()
        return
    end
    self.nowGiftIndex = self.nowGiftIndex <= #self.ActivityData and self.nowGiftIndex or 1
    if not FreshRedBol then
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.SevenGiftGMModel, _G.TimeUtil.GetServerUnixTime())
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedSevenGiftGM.id)
    end
    self:FreshBtn()

    local time = TimeUtil.TranslateSecondForDHMOrHMS(self.lastTime)
    self.go_table.aortext_time.text = GetLangPackValue(90028500004, time)
    --self:FreshView(self.nowGiftIndex <= #self.ActivityData and self.nowGiftIndex or 1)
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.TimerFunc, self, false)
    self.timer:Start()
end

function SevenGiftGMView:FreshBtn()
    if #self.ActivityData > 4 then
        self.go_table.obj_giftBtnGroup:SetActiveE(0)
        self.go_table.scrollloophorizontal_btn:SetActiveE(1)
        if not self.BtnListView then
            self.go_table.scrollloophorizontal_btn:InitItemData(#self.ActivityData, _G.handler(self, self.RefreshItem))
            self.BtnListView = self.go_table.scrollloophorizontal_btn
        else
            self.BtnListView:UpdateAllItem()
        end
        self.go_table.scrollloophorizontal_btn:ScrollToIndex(self.nowGiftIndex - 1)
        self:FreshView(self.nowGiftIndex)
    else
        self.go_table.obj_giftBtnGroup:SetActiveE(#self.ActivityData > 1 and 1 or 0)
        self.go_table.scrollloophorizontal_btn:SetActiveE(0)
        for i = 1, 4 do
            if i <= #self.ActivityData then
                -- self.btnGoTable[i].obj_redpoint:UpdateRedPointItemIDAndParam(
                --     _G.ConfigManager.redpoint_cfg.RedSevenGift.id,
                --     self.ActivityData[i].id
                -- )
                self.go_table["aorbtn_gift" .. i]:SetActiveE(1)
                self.btnGoTable[i].aortext_Day.text = _G.GetLangPackValue(self.ActivityData[i].gift_name)
                self.btnGoTable[i].aorimage_item.SpriteName = self.ActivityData[i].main_icon
            else
                self.go_table["aorbtn_gift" .. i]:SetActiveE(0)
            end
        end
        self:ClickBtn(nil, nil, self.nowGiftIndex)
    end
end

function SevenGiftGMView:RefreshItem(index, obj)
    index = index + 1
    local data = self.ActivityData[index]
    local tb = _G.GetAutoGoTable(obj)
    tb.aortext_Day.text = _G.GetLangPackValue(data.gift_name)
    tb.aorimage_item.SpriteName = data.main_icon
    local bol = self.nowGiftIndex == index
    tb.obj_choose:SetActiveE(bol and 1 or 0)
    tb.aorimage_bg:SetLocalScaleXYZ(bol and 1.2 or 1)
    if bol then
        self.chooseObj[1] = tb.aorimage_bg
        self.chooseObj[2] = tb.obj_choose
    end
    -- tb.obj_redpoint:UpdateRedPointItemIDAndParam(
    --     _G.ConfigManager.redpoint_cfg.RedSevenGift.id,
    --     data.id
    -- )
    tb.index = index
    _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickBtn1, tb))
end

function SevenGiftGMView:OnClickBtn1(go, isOn, tb)
    if tb.index == self.nowGiftIndex then
        return
    end
    if self.chooseObj[1] then
        self.chooseObj[1]:SetLocalScaleXYZ(1)
        self.chooseObj[2]:SetActiveE(0)
    end
    self.chooseObj[1] = tb.aorimage_bg
    self.chooseObj[2] = tb.obj_choose
    self.chooseObj[1]:SetLocalScaleXYZ(1.2)
    self.chooseObj[2]:SetActiveE(1)
    self:FreshView(tb.index)
end

function SevenGiftGMView:ClickBtn(go, isOn, index)
    for i = 1, 4 do
        self.btnGoTable[i].obj_choose:SetActiveE(i == index and 1 or 0)
        self.btnGoTable[i].aorimage_bg:SetLocalScaleXYZ(i == index and 1.2 or 1)
    end
    self:FreshView(index)
end

function SevenGiftGMView:FreshView(index)
    self.nowGiftIndex = index
    local data = self.ActivityData[index]
    self.lastTime = data.endTime - _G.TimeUtil.GetServerUnixTime()
    --SevenGiftGMSynModel:UpdateRedPoint(2, data.type)
    self.giftList = data.giftList
    self.buyList = data.buyList
    self.curDay = data.curDay
    self.type = data.type
    self.type1 = data.type1
    _G.PlayerPrefsManager.SetInt("SevenGiftGMSynModel_" .. data.id, _G.TimeUtil.GetServerUnixTime())
    --require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedSevenGift.id, data.id)
    self.go_table.aorrawimage_tittle:LoadImage(
        data.artistic_lettering[1],
        function(trans)
            if self:IsNil() then
                return
            end
            trans:SetLocalScaleXYZ(data.scaling_translation_2[1][4])
            trans:SetLocalPosition(
                data.scaling_translation_2[1][1],
                data.scaling_translation_2[1][2],
                data.scaling_translation_2[1][3]
            )
            trans:SetNativeSize()
        end
    )
    self.go_table.aorrawimage_tittle2:LoadImage(
        data.artistic_lettering[2],
        function(trans)
            if self:IsNil() then
                return
            end
            trans:SetLocalScaleXYZ(data.scaling_translation_2[2][4])
            trans:SetLocalPosition(
                data.scaling_translation_2[2][1],
                data.scaling_translation_2[2][2],
                data.scaling_translation_2[2][3]
            )
            trans:SetNativeSize()
        end
    )
    self.go_table.aorrawimage_center:LoadImage(
        data.product_art_resources,
        function(trans)
            trans:SetLocalScaleXYZ(data.scaling_translation_1[4])
            trans:SetLocalPosition(
                data.scaling_translation_1[1],
                data.scaling_translation_1[2],
                data.scaling_translation_1[3]
            )
            trans:SetNativeSize()
        end
    )

    local uiModel = _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.ui_model_1)
    self.go_table.obj_heros:SetActiveE(uiModel and 0 or 1)
    self.go_table.obj_specialheros:SetActiveE(uiModel and 1 or 0)
    if uiModel then
        for i = 1, 4 do
            if data.label_translation and data.label_translation[i] and not string.IsNullOrEmpty(data.label_name[i]) then
                if i == 1 then
                    if _G.table.count(data.label_translation) == 1 then
                        self.go_table["obj_nameS" .. i]:SetLocalPosition(-52, 315, 0)
                    else
                        self.go_table["obj_nameS" .. i]:SetLocalPosition(-26, 200, 0)
                    end 
                end
                self.go_table["aortext_nameS" .. i].text = _G.GetLangPackValue(data.label_name[i])
                self.go_table["obj_nameS" .. i]:SetActiveE(1)
            else
                self.go_table["obj_nameS" .. i]:SetActiveE(0)
            end
        end
    else
        for i = 1, 4 do
            if data.label_translation and not string.IsNullOrEmpty(data.label_name[i]) then
                self.go_table["obj_nameBg" .. i]:SetLocalPosition(
                    data.label_translation[i][1],
                    data.label_translation[i][2],
                    data.label_translation[i][3]
                )
                self.go_table["aortext_nameBg" .. i].text = _G.GetLangPackValue(data.label_name[i])
                self.go_table["obj_nameBg" .. i]:SetActiveE(1)
            else
                self.go_table["obj_nameBg" .. i]:SetActiveE(0)
            end
        end
    end
    self:InitDayList()
    self.go_table.aortext_limit.text = _G.GetLangPackValue(90022900063) .. _G.GetLangPackValue(90027000004, 1)
end

function SevenGiftGMView:TimerFunc(elapsed)
    self.lastTime = self.lastTime - elapsed
    if self.lastTime < 0 then
        self:InitView()
    else
        local time = TimeUtil.TranslateSecondForDHMOrHMS(self.lastTime)
        self.go_table.aortext_time.text = GetLangPackValue(90028500004, time)
    end
end

function SevenGiftGMView:InitDayList()
    self.DayTbList = {}
    local stars = _G.ConfigManager.discrete_cfg[119003][tonumber(self.type1[1])]
    local stars2 = _G.ConfigManager.discrete_cfg[119009][tonumber(self.type1[2])]
    local order, starCount
    local test, test2
    self.curIndedx = nil
    for i = 1, 7 do
        if self.giftList[i] then
            ---@type SevenGiftGMView._aorbtn_Day1_GoTable
            local tb = _G.GetAutoGoTable(self.go_table["aorbtn_Day" .. i], _G.handlerbind(self, self.OnClickDay, i))

            self.go_table["aorbtn_Day" .. i]:SetLocalPosition(
                posList[#self.giftList][i][1],
                posList[#self.giftList][i][2]
            )
            self.DayTbList[i] = tb
            tb.aortext_Day.text = GetLangPackValue(90023800019, i)

            tb.aorimage_item.SpriteName = typeIcon[self.type]
            local dataSid = self.giftList[i]
            local data = extraCfg[dataSid]
            if not self.buyList[dataSid] and not self.curIndedx then
                self.curIndedx = i
            end
            tb.aorimage_buy:SetActiveE(self.buyList[dataSid] and 1 or 0)
            tb.awardData = data
            -- if self.type == 1 then
            order, test = CardInfoManager:GetInstance():GetOrderStarCount(stars[i] or 5)
            starCount = stars2[i]
            tb.aorimage_bg.SpriteName = OrderName[order]
            -- else
            --     tb.aorimage_bg.SpriteName = "ui_qrcz_hongse_yxtxk"
            -- end
            for j = 1, 5 do
                -- if self.type == 1 then
                tb["aorimage_star" .. j]:SetActiveE(j <= starCount and 1 or 0)
                -- else
                --     tb["aorimage_star" .. j]:SetActiveE(0)
                -- end
            end
            self.go_table["aorbtn_Day" .. i]:SetActiveE(1)
            self.go_table["aorimage_pt" .. i]:SetActiveE(1)
        else
            self.go_table["aorbtn_Day" .. i]:SetActiveE(0)
            self.go_table["aorimage_pt" .. i]:SetActiveE(0)
        end
    end
    self:InitAwardItems()
end

function SevenGiftGMView:InitAwardItems()
    self.awardList = {}
    if not self.curIndedx then
        self.curIndedx = 1
    end
    for i = 1, 4 do
        local tb = _G.GetAutoGoTable(self.go_table["obj_item" .. i])
        self.awardList[i] = tb
    end
    self:ChangeSelect()
end

---界面的销毁函数
function SevenGiftGMView:OnDestroy()
end

---按钮点击事件在这里派发
function SevenGiftGMView:OnClickBtn(go)
    if go == self.go_table.aorbtn_buy then
        if self.curDay < self.curIndedx then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                3805,
                GetLangPackValue(90000011037, self.curIndedx - self.curDay)
            )
            return
        end
        local data = self.DayTbList[self.curIndedx]
        if self.buyList[data.awardData.id] then
            return
        end
        SevenGiftGMSynModel:BuyGift(
            extraCfg[self.giftList[self.curIndedx]],
            self.ActivityData[self.nowGiftIndex].id,
            _G.handler(self, self.BuyBack)
        )
    elseif go == self.go_table.aorbtn_next then
        self.curIndedx = self.curIndedx + 1
        self:ChangeSelect()
    elseif go == self.go_table.aorbtn_before then
        self.curIndedx = self.curIndedx - 1
        self:ChangeSelect()
    elseif go == self.go_table.aorbtn_closeView then
        self:CloseView()
    elseif go == self.go_table.aorbtn_anyclose then
        self:CloseView()
    end
end

function SevenGiftGMView:OnClickDay(go, isOn, index)
    if index == self.curIndedx then
        return
    end
    self.curIndedx = index
    self:ChangeSelect()
end

function SevenGiftGMView:ChangeSelect()
    if self.curIndedx == _G.table.count(self.giftList) then
        self.go_table.aorbtn_next:SetActiveE(0)
        self.go_table.aorbtn_before:SetActiveE(1)
    elseif self.curIndedx == 1 then
        self.go_table.aorbtn_before:SetActiveE(0)
        self.go_table.aorbtn_next:SetActiveE(1)
    else
        self.go_table.aorbtn_next:SetActiveE(1)
        self.go_table.aorbtn_before:SetActiveE(1)
    end
    if self.chooseEff then
        self.chooseEff:SetParentE(self.go_table["aorbtn_Day" .. self.curIndedx])
    end
    self.go_table.obj_choose:SetParentE(self.DayTbList[self.curIndedx].obj_choose)
    self.go_table.obj_choose:SetLocalPositionToZero()
    self.go_table.aorimage_curPt:SetParentE(self.go_table["aorimage_pt" .. self.curIndedx])
    self:UpdateItems()
end

function SevenGiftGMView:UpdateBuyBtn()
    local data = self.DayTbList[self.curIndedx]
    self.DayTbList[self.curIndedx].aorimage_buy:SetActiveE(0)
    if self.buyList[data.awardData.id] then
        self.DayTbList[self.curIndedx].aorimage_buy:SetActiveE(1)
        self.go_table.aorbtn_buy:SetGray(true)
        self.go_table.aortext_charge.color = require("CardInfoManager").GetColorFromRGB("414141")
        self.go_table.aortext_charge.text = GetLangPackValue(90022500421)
    elseif self.curDay < self.curIndedx then
        if self.go_table.aorbtn_buy:GetChildE(0):GetName() == "ObjDouYinIos" then
            self.go_table.aorbtn_buy:GetChildE(0):SetActiveE(0)
        end

        self.go_table.aorbtn_buy:SetGray(true)
        self.go_table.aortext_charge.color = require("CardInfoManager").GetColorFromRGB("414141")
        self.go_table.aortext_charge.text = GetLangPackValue(90000011037, self.curIndedx - self.curDay)
    else
        self.go_table.aorbtn_buy:SetGray(false)
        if _G.GameUtil.IsNotPlatformSpecial() then
            self.go_table.aortext_charge.color = require("CardInfoManager").GetColorFromRGB("815633")
        end
        _G.GameUtil.SetPriceByChannel(data.awardData.price_id, self.go_table.aortext_charge)
    end
end

function SevenGiftGMView:UpdateItems()
    self:UpdateBuyBtn()
    self.go_table.aortext_tips.text = _G.GetLangPackValue(90023800136, _G.GameUtil.NumberToChinese(self.curIndedx))
    local data = self.DayTbList[self.curIndedx]
    local lock = 0
    if self.curDay < self.curIndedx or self.buyList[data.awardData.id] then
        lock = 1
    end
    for i = 1, 4 do
        self.go_table["obj_item" .. i]:SetActiveE(0)
        local instanceID = self.go_table["obj_item" .. i]:GetInstanceIDE()
        if data.awardData.goods[i] then
            if not self.itemTransDic[instanceID] then
                self.itemTransDic[instanceID] = require "BaseAwardNewItem".New(self.go_table["obj_item" .. i])
            end
            self.itemTransDic[instanceID]:ShowWithID(data.awardData.goods[i])
            self.itemTransDic[instanceID].gameObject:SetLocalScaleXYZ(0.84)
            self.go_table["obj_item" .. i]:SetActiveE(1)
        end
    end
end

function SevenGiftGMView:LoadEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_jinshenghaoli,
        self.go_table.obj_lightEff,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
        end
    )
end

function SevenGiftGMView:BuyBack()
    self:UpdateItems()
end

function SevenGiftGMView:ShowTips(go, got, isOn, rewardsid)
    require("CommonTipManager"):GetInstance():OpenPropTip(go.gameObject, rewardsid)
end

function SevenGiftGMView:Dispose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

function SevenGiftGMView:CloseView()
    self:Close()
end

return SevenGiftGMView
