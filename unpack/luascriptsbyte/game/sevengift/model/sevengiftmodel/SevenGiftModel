function SevenGiftModel:GetOpenGift()
    self.OpenGift = {}
    for k, v in pairs(self.GiftList) do
        if v.state ~= StateType.close then
            local curTime = _G.TimeUtil.GetServerUnixTime()
            if v.endTime <= curTime + 1 then
                self.GiftList[k].state = StateType.close
            elseif curTime > v.startTime and curTime < v.endTime then
                self.GiftList[k].curDay = math.ceil((curTime - v.startTime) / 86400)
                if _G.GlobalConditionManager.CheckConditionByArray(v.condition_type) then
                    table.insert(self.OpenGift, self.GiftList[k])
                end
            end
        end
    end
    table.sort(
        self.OpenGift,
        function(a, b)
            return a.startTime > b.startTime
        end
    )
    if _G.AppSetting.IsXzns then--星座红点优化，每个可购买的页签都需要红点，点击后消除
        if _G.table.isEmptyOrNil(self.giftRedpoint) then
            self.giftRedpoint = {}
            for _, v in pairs(self.OpenGift) do
                self.giftRedpoint[v.id] = false
            end
        end
    end
    return self.OpenGift
end

function SevenGiftModel:GetNowIcon()
    self:GetOpenGift()
    if self.OpenGift[1] then
        return targetCfg[self.OpenGift[1].id].main_icon, targetCfg[self.OpenGift[1].id].gift_name
    end
    return "", 90023800138
end

function SevenGiftModel.CheckOneOpen()
    return #SevenGiftModel:GetInstance():GetOpenGift() > 0
end

---解析数据
---@param data table 服务器返回数据
function SevenGiftModel:ParseData()
    --_G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.InitGiftActive, self)
    --_G.Events:GetInstance():AddListener(_G.eMainViewShow.Fort, self.InitGiftActive1, self)
    --_G.Events:GetInstance():RemoveListener(_G.eAfkEvents.Pass, self.CheckOpen, self)
    self:GetOpenGift()
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RedSevenGift.id)
    for k, v in pairs(self.GiftList) do
        if v.state ~= StateType.close then
            local data = self.GiftList[v.id]
            data.buyCount = 0
            for k1, v1 in ipairs(v.giftList) do
                if require("MallNeverModel"):GetInstance():GetBuyTimes(v1) > 0 then
                    data.buyList[v1] = 1
                    data.buyCount = data.buyCount + 1
                elseif _G.AppSetting.IsXzns and data.curDay >= k1 then
                    if self.giftRedpoint[v.id] ~= nil then
                        self.giftRedpoint[v.id] = true
                    end
                end
            end
            -- _G.LogError(data.buyCount)
            -- _G.LogError(v.id)
            -- _G.LogError(_G.table.count(v.giftList))
            if data.buyCount == _G.table.count(v.giftList) then
                self:CloseActive(v.id)
            end
        end
    end
    if #self.OpenGift > 0 then
        _G.FunctionManager:GetInstance():OpenFunById(_G.MainFunctionItems.SevenGift)
    end
    if self.sendBuy then
        local data = {}
        data.award = {}
        data.award.item = self.curBuyGift.goods
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
        self.sendBuy = false
        if self.mallCall then
            self.mallCall()
        end
    end
    -- if not table.isEmptyOrNil(self.giftTimes) then
    --     self:StartTimer()
    -- end
    self:FreshView()
    self.initDataDoneTag = nil
    if self.endCallback then
        self.endCallback(self.__cname)
    end
    self.endCallback = nil
end

