---类的构造函数
function SevenGiftModel:__init()
    -- self.curFunctionOpenID = _G.FunctionID.MaterialGift
    self.GiftList = {}
    self.giftTimes = {}
    for k, v in pairs(targetCfg) do
        local data = {}
        data.id = v.id
        data.gift_name = v.gift_name
        data.product_art_resources = v.product_art_resources
        data.scaling_translation_1 = v.scaling_translation_1
        data.artistic_lettering = v.artistic_lettering
        data.scaling_translation_2 = v.scaling_translation_2
        data.label_translation = v.label_translation
        data.label_name = v.label_name
        data.main_icon = v.main_icon
        data.type = v.type
        data.type1 = v.type1 or 1
        data.giftList = v.store_extra
        data.continueTime = v.disappear
        data.state = StateType.unOpen
        data.condition_type = v.condition_type
        data.buyList = {}
        data.curDay = 0
        data.buyCount = 0
        data.startTime = _G.PlayerModel:GetInstance().open_time + (data.condition_type[1][2] - 1) * 86400
        data.endTime = data.startTime + (v.disappear * 86400)
        self.GiftList[data.id] = data
    end
    _G.Events:GetInstance():AddListener(_G.eAfkEvents.Pass, self.CheckOpen, self)
end

