    end
    return 0
end

function SevenGiftModel:TimerFunc(elapsed)
    for k, v in pairs(self.giftTimes) do
        v = v - elapsed
        v = Mathf.RoundToInt(v)
        self.giftTimes[k] = v
        if v <= 1 then
            self:CloseActive(k)
            self.giftTimes[k] = nil
            if table.isEmptyOrNil(self.giftTimes) then
                self:StopTimer()
            end
        else
            -- if self.GiftList[k].mainFunc then
            --     self.GiftList[k].mainFunc(v)
            -- end
            if self.GiftList[k].timerFunc then
                self.GiftList[k].timerFunc(v)
            end
        end
    end
end

---设置主界面按钮计时器（做了又不要了，留着免得他又要加）
function SevenGiftModel:SetMainTimer(tb, type)
    local list = self:GetGiftData(type)
    if list then
        list.mainFunc = function(v)
            local time = TimeUtil.TimeToString(v, 1)
            tb.aortext_time.text = time
        end
    end
end

function SevenGiftModel:StartTimer()
    if not self.timer then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.TimerFunc, self, false)
        self.timer:Start()
    end
end

function SevenGiftModel:StopTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

