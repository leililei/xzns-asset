end

---获取UI界面
---@param type number 礼包类型: 1.七日粉将(材料), 2.待定, 3.神兵礼包
---@return MaterialGiftView
function SevenGiftModel:GetWindow(type)
    local view = _G.UIManager:GetInstance():GetWindowCtrl(self:GetWindowName(type))
    if not view or view.type ~= type then
        return nil
    end
    return view
end

---获取UI界面
---@private
---@param type number 礼包类型: 1.七日粉将(材料), 2.待定, 3.神兵礼包
---@return string
function SevenGiftModel:GetWindowName(type)
    if type == 3 then
        return _G.ConfigManager.ui_cfg.MaterialArtifactGiftView.Name
    elseif type == 4 then
        return _G.ConfigManager.ui_cfg.MaterialPetGiftView.Name
    end
    return _G.ConfigManager.ui_cfg.MaterialGiftView.Name
end

---通过类型获取id
function SevenGiftModel:GetActivityId(type)
    if type == 1 then
        return _G.MainFunctionItems.MaterialCard
    elseif type == 2 then
        return _G.MainFunctionItems.MaterialLM
    elseif type == 4 then
        return _G.MainFunctionItems.MaterialPet
    end
    return _G.MainFunctionItems.MaterialCard
end

---刷新红点
function SevenGiftModel:UpdateRedPoint(value, type)
    local param = self:GetActivityId(type)
    _G.PlayerPrefsManager.SetInt("SevenGiftModel_" .. param, value)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.MaterialGift.id, param)
end

return SevenGiftModel
