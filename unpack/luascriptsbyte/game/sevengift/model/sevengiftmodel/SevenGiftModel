function SevenGiftModel:CheckOpen()
    local bol = true
    for k, v in pairs(self.GiftList) do
        if v.state == StateType.unOpen then
            if _G.GlobalConditionManager.CheckConditionByArray(v.condition_type) then
                local curTime = _G.TimeUtil.GetServerUnixTime()
                if curTime > v.startTime and curTime < v.endTime then
                    self:OpenActive(v.id)
                end
            end
            bol = false
        end
    end
    if bol then
        _G.Events:GetInstance():RemoveListener(_G.eAfkEvents.Pass, self.CheckOpen, self)
    end
end

function SevenGiftModel:CheckRedpoint(param)
    return self.giftRedpoint[param] == true and 1 or 0
end

function SevenGiftModel:FreshRedpoint(param)
    if self.giftRedpoint[param] == true then
        self.giftRedpoint[param] = false
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedSevenGift.id, param)
    end
end

---购买礼包
function SevenGiftModel:BuyGift(data, sid, callBack)
    self.curBuyGift = data
    self.curSid = sid
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    self.mallCall = callBack
    require("MallManager"):GetInstance():BuyActiveGift(data.price_id, nil, data.id)
end

function SevenGiftModel:OnMallCashListener(data)
    if data.sid == self.curBuyGift.id then
        local curGiftData = self.GiftList[self.curSid]
        curGiftData.buyList[data.sid] = 1
        curGiftData.buyCount = curGiftData.buyCount + 1

        if self.mallCall then
            self.mallCall()
            self.mallCall = nil
        end

        if curGiftData.buyCount == _G.table.count(curGiftData.giftList) then
            self:CloseActive(self.curSid)
        end
        _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    end
end

