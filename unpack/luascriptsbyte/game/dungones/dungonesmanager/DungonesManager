function DungonesManager:__init()
    self.iswin = true
    _G.Events:GetInstance():AddListener(_G.DungonesPlayState.DungonesStart, self.OnDungonesStart, self)
    _G.Events:GetInstance():AddListener(_G.DungonesPlayState.DungonesEnd, self.OnDungonesEnd, self)
    _G.Events:GetInstance():AddListener(_G.DungonesPlayState.RelicChooseEnd, self.OnRelicChooseEnd, self)
end

function DungonesManager:OnDungonesStart()
end

function DungonesManager:OnDungonesEnd()
    DungonesModel:GetInstance():InitData(_G.handlerbind(self, self.GetDungonesInfoBack))
end

function DungonesManager:OnRelicChooseEnd()
    DungonesModel:GetInstance():InitData(_G.handlerbind(self, self.GetDungonesInfoBack))
end

function DungonesManager:GetDungonesInfoBack()
    self:EnterDungones(true)
    local relicList = require "DungonesModel":GetInstance().RelicData
    if relicList then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.DungonesGetRelicView.Name,
            relicList,
            function()
                local runWin = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DungonesRuningView.Name)
                if runWin then
                    runWin.View:GetMementoCallBack()
                end
            end
        )
    end
    --最后一层刷新boss
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.DungonesAward.id)
end

---根据选中的难度 ，获取 dungeons_cfg 表中的 数据
function DungonesManager:GetShowList(difficulty)
    self.ShowList = {}
    for _, v in pairs(_G.ConfigManager.dungeons_cfg) do
        if 1 == v.layer and v.difficulty == difficulty then
            table.insert(self.ShowList, v)
        end
    end
    _G.SortList(
        self.ShowList,
        function(item)
            return -item.id
        end
    )
    return self.ShowList
end

--- 点击进入千机
function DungonesManager:EnterDungones(isEndEvent)
    if nil == isEndEvent then
        isEndEvent = false
    end
    local isTrue, _ = self:CheckFunctionIsUnlock(_G.FunctionID.Dungones)
    local difficulty = DungonesModel:GetInstance().DungonesInfo.difficulty
    if isTrue then
        self:GetShowList(difficulty)
        local dungLevel
        local haveUnselectedMementos, UnSection = DungonesModel:GetInstance():HaveUnselectedMementos()
        if DungonesModel:GetInstance().DungonesInfo.section == 0 then
            dungLevel = self.ShowList[1].id
        elseif haveUnselectedMementos then
            DungonesModel:GetInstance().DungonesInfo.sid = DungonesModel:GetInstance().DungonesInfo.section
            dungLevel = UnSection[1]
        else
            dungLevel = DungonesModel:GetInstance().DungonesInfo.section
        end
        ---@type dungeons_cfg
        local cfg = _G.ConfigManager.dungeons_cfg[dungLevel]
        if #cfg.after_section <= 0 then
            for key, value in pairs(_G.ConfigManager.dungeons_cfg) do
                ---找到下一关的起点
                --
                if _G.AppSetting.DEBUG then
                    _G.Log(cfg.layer + 1, "层数")
                end
                --
                if _G.AppSetting.DEBUG then
                    _G.Log(value.layer, "层数")
                end
                --
                if _G.AppSetting.DEBUG then
                    _G.Log(#cfg.event, "事件条数")
                end
                if value.difficulty == difficulty and cfg.layer + 1 == value.layer and #value.event <= 0 then
                    dungLevel = key
                    isEndEvent = false
                    break
                end
            end
        end
        self.CurDoDungCfg = _G.ConfigManager.dungeons_cfg[dungLevel]

        local runWin = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DungonesRuningView.Name)
        if runWin then
            runWin.View:UpdateView()
            if isEndEvent then
                runWin.View:MoveToNextBySid(
                    dungLevel,
                    function()
                        runWin.View:UpdateDisplay()
                        runWin.View:ShowHy()
                    end,
                    function()
                        runWin.View:UpdateCurPos()
                    end
                )
            end
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DungonesRuningView.Name, isEndEvent)
        end
    else
        if _G.AppSetting.DEBUG then
            _G.Log("千机没有开启")
        end
    end
end

