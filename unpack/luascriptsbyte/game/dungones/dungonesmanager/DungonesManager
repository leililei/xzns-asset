function DungonesManager:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.DungonesPlayState.DungonesStart, self.OnDungonesStart, self)
    _G.Events:GetInstance():RemoveListener(_G.DungonesPlayState.DungonesEnd, self.OnDungonesEnd, self)
    _G.Events:GetInstance():RemoveListener(_G.DungonesPlayState.RelicChooseEnd, self.OnRelicChooseEnd, self)
end

return DungonesManager
