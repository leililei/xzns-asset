---进入战斗
---@field atkSid number[] 进攻数据
function DungonesManager:EnterFight()
    local eventId = require "DungonesModel":GetInstance().CurEventId
    local eventCfg = _G.ConfigManager.adventure_cfg[eventId]
    
    local leftName = _G.PlayerModel:GetInstance():GetName()
    local rightName = eventCfg and _G.GetLangPackValue(eventCfg.name) or ""
    _G.BattleManager:GetInstance():EnterFight(_G.BattleControllerType.Dungones, leftName, rightName)
end

---跳过战斗直接显示结算页面
---@return void
function DungonesManager:SkipFight()
    local sid = require("DungonesModel"):GetInstance().CurEventId
    _G.BattleManager:GetInstance():SetInBattle(true)
    require("DungonesNet"):GetInstance():Fight(
        {sid = sid},
        function(msg)
            if not msg or msg.ack ~= 1 then
                _G.BattleManager:GetInstance():SetInBattle(false)
                return
            end
            --计算战斗结果
            _G.BattleManager:GetInstance():SetArgDataAutoCmd(msg.fight_arg)
            -- local record = _G.BattleManager:GetInstance():GetStatisticsRecord(msg.fight_arg)
            -- if not record or not record.result then
            --     _G.BattleManager:GetInstance():SetInBattle(false)
            --     return
            -- end

            ---@type BattleControllerDungones
            local controller = _G.require(_G.BattleControllerType.Dungones).New()
            controller.curFightState = 4 --设置战斗结束

            --对战双方名称
            local eventId = require "DungonesModel":GetInstance().CurEventId
            local eventCfg = _G.ConfigManager.adventure_cfg[eventId]
            controller.leftName = _G.PlayerModel:GetInstance():GetName()
            controller.rightName = eventCfg and _G.GetLangPackValue(eventCfg.name) or ""
            controller.fightArg = msg.fight_arg

            _G.BattleManager:GetInstance():SetArgData(msg.fight_arg)
            _G.BattleManager:GetInstance():SetStatisticsCached(nil)
            _G.BattleManager:GetInstance():SetBattleController(controller)
            --显示结算界面,
            controller:FightResultFunc({ skip = true })
        end
    )
end

---战斗胜利
function DungonesManager:FightWin(relicList)
    if relicList then
        require "DungonesModel":GetInstance().RelicData = relicList
    --_G.Events:GetInstance():Broadcast(_G.DungonesPlayState.DungonesEnd)
    end
    self.iswin = true
    self:ReturnUIPage(true)
end

---战斗失败
function DungonesManager:FightLose()
    self.iswin = false
    self:ReturnUIPage()
end

function DungonesManager:OnChallenge(id)
    require "DungonesModel":GetInstance():OnChallenge(id, _G.handler(self, self.EnterDungones))
end

---返回千机场景界面
function DungonesManager:ReturnUIPage(isWin)
    if nil == isWin then
        isWin = false
    end
    -- _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, false)
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DungonesMainEventView.Name)
    if window then
        window.View:Close()
    end
    window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DungonesRuningView.Name)
    if window then
        window.View:Show()
    end

    window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DungonesView.Name)
    if window then
        window.View:Show()
    end
    window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
    if window then
        window.View:Show()
    end
    local bossid = _G.ConfigManager.discrete_cfg[103404][1][1]
    if isWin and require "DungonesModel":GetInstance().CurEventId == bossid then
        local guild_bossid = _G.ConfigManager.adventure_cfg[bossid].event_params[1][1]
        local monsterid = _G.ConfigManager.guild_boss_cfg[guild_bossid].monster
        local monsterCfg = _G.ConfigManager.monster_cfg[monsterid]
        local cardCfg = _G.ConfigManager.card_cfg[monsterCfg.CardID]
        DungonesModel:GetInstance():GetRanKInfo(
            {type = 8},
            function()
                ---@type FightBossWinView_Params
                local data = {rankDatas = {}, playerRankData = {}}
                local rankDatas = DungonesModel:GetInstance().rank_all_player or {}
                if rankDatas then
                    for i = 1, #rankDatas do
                        data.rankDatas[i] = {rank = i, role = rankDatas[i]:GetRole(), value = rankDatas[i]:GetDamage()}
                        if rankDatas[i]:GetIsMySelf() then
                            data.playerRankData = {rank = i, value = rankDatas[i]:GetDamage()}
                        end
                    end
                end
                data.icon = cardCfg.Portrait
                data.name = _G.GetLangPackValue(monsterCfg.Name)
                data.type = _G.FightBossWinType.Dungones
                data.cardId = cardCfg.id
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FightBossWinView.Name, data)
            end
        )
    end
    _G.Events:GetInstance():Broadcast(_G.DungonesPlayState.DungonesEnd)
end

