---挑战小怪物碾压事件
---@param sid number 奇遇事件id
function DungonesManager:EnterYanYa(sid, call)
    local msg = {}
    msg.sid = sid
    require "DungonesNet":GetInstance():RoguelikeFastPass(
        msg,
        function(data)
            if data.ack ~= 1 then
                if call then
                    call(data)
                end
                return
            end
            --放入仓库
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CommonAwardView.Name,
                data,
                function()
                    local relicList = data.args
                    --self.iswin = true
                    self:FightWin(relicList)

                    if call then
                        call(data)
                    end
                end
            )
            _G.Events:GetInstance():Broadcast(_G.DungonesPlayState.DungonesEnd)
        end
    )
end

---进入布阵界面，准备战斗
---@param skipBattle boolean    @是否显示跳过战斗按钮
function DungonesManager:EnterEmbattle(skipBattle)
    --_G.UIManager:GetInstance():HideWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)
    local embattleType = _G.EmbattleType.dungones

    local team = require "DungonesModel":GetInstance().CurEventInfo.defender_team
    local fighter = {}
    if team then
        fighter = team[1].fights
    end
    local data = {}
    for i = 1, 5 do
        local isHas = false
        for j = 1, #fighter do
            local fi = fighter[j]
            if fi.index == i then
                _G.table.insert(
                    data,
                    {
                        uid = fi.uid,
                        sid = fi.sid,
                        level = fi.lv,
                        star = fi.star
                    }
                )
                isHas = true
                break
            end
        end
        if not isHas then
            _G.table.insert(data, {uid = 0, sid = 0, level = 0, star = 0, scale = 1})
        end
    end

    local groupId
    local bossid = _G.ConfigManager.discrete_cfg[103404][1][1]
    if require "DungonesModel":GetInstance().CurEventId == bossid then
        local guild_bossid = _G.ConfigManager.adventure_cfg[bossid].event_params[1][1]
        groupId = _G.ConfigManager.guild_boss_cfg[guild_bossid].monster_group
        local monsterid = _G.ConfigManager.guild_boss_cfg[guild_bossid].monster
        local cardsid = _G.ConfigManager.monster_cfg[monsterid].CardID
        local level = _G.ConfigManager.monster_cfg[monsterid].level
        local star = _G.ConfigManager.monster_cfg[monsterid].Stars
        data = {
            [1] = {
                uid = 0,
                sid = 0,
                level = 0,
                star = 0
            },
            [2] = {
                uid = 0,
                sid = 0,
                level = 0,
                star = 0
            },
            [3] = {
                uid = 0,
                sid = 0,
                level = 0,
                star = 0
            },
            [4] = {
                uid = 0,
                sid = 0,
                level = 0,
                star = 0
            },
            [5] = {
                uid = 0,
                sid = 0,
                level = 0,
                star = 0
            }
        }
        data[4] = {
            uid = monsterid,
            sid = cardsid,
            level = level,
            star = star
        }
    else
        groupId = _G.ConfigManager.discrete_cfg[103403][1][self.CurDoDungCfg.layer]
        if groupId == nil then
            groupId = 1020
        end
    end
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    require("EmbattleController"):GetInstance():OpenEmbattle(
        embattleType,
        _G.EmbattleSaveType.server,
        false,
        _G.EmbattleControllerItemType.dungones,
        _G.handler(self, self.ExitEmbattle),
        function(_, _, _skipBattle)
            if _skipBattle then
                self:SkipFight()
            else
                self:EnterFight()
            end
        end,
        groupId,
        data,
        skipBattle
    )
end

function DungonesManager:OnEmbattleViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DungonesMainEventView.Name)
        if window then
            window.View:Close()
        end
        window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.Dungeons_boos.Name)
        if window then
            window.View:Close()
        end
        window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DungonesRuningView.Name)
        if window then
            window.View:Hide()
        end
        window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DungonesView.Name)
        if window then
            window.View:Hide()
        end
        window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
        if window then
            window.View:Hide()
        end
        ---@type EmbattleNewView
        local embattleView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.EmbattleView.Name)
        if embattleView then
            local eventId = require "DungonesModel":GetInstance().CurEventId
            local eventCfg = _G.ConfigManager.adventure_cfg[eventId]
            embattleView:SetVsDescription(
                _G.PlayerModel:GetInstance():GetName(),
                eventCfg and _G.GetLangPackValue(eventCfg.name) or ""
            )
        end

        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    end
end

