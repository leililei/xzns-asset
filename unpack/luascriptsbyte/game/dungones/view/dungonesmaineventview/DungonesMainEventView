                function(data)
                    if data.ack ~= 1 then
                        ---如果出现某些卡过期此时需要重新判定阵容
                        local flag =
                            require "DungonesModel":GetInstance():CheckFastPass(
                            self.EventInfo.sid,
                            self.EventInfo.defender_team
                        )
                        _G.GameUtil.SetActiveByCondition(self.EmbattleGo.aorbtn_nianya, not flag)
                        return
                    end
                    require("DungonesModel"):GetInstance().DungonesInfo.sid = secid
                    if data.adventures then
                        require("DungonesModel"):GetInstance():DisposalDateAdventure(data.adventures)
                    end
                    self:Close()
                    require "DungonesModel":GetInstance():EnterYanYa(self.EventType, self.EventId, self.EventInfo)
                end
            )
        else
            self:Close()
            require "DungonesModel":GetInstance():EnterYanYa(self.EventType, self.EventId, self.EventInfo)
        end
    elseif go == self.EmbattleGo.aorbtn_close then
        self:Close()
    end
end

function DungonesMainEventView:OnClickFightHelpListBtn(go)
    if _G.AppSetting.DEBUG then
        _G.Log(go, "点击助战按钮事件")
    end
    if go == self.FightHelpListGo.aorbtn_Sure then
        if self.IsPreview then
            self:Close()
        else
            if not (self.HelpUid > 0) then
                _G.PopWindowManager:GetInstance():ShowAllTips(1714)
                return
            end
            local secid = self.EventInfo.section_sid
            local id = require("DungonesModel"):GetInstance().DungonesInfo.sid
            if id <= 0 then
                local msg = {}
                msg.sid = secid
                msg.eid = self.EventId
                msg.args = {self.HelpUid}
                if require("DungonesModel"):GetInstance().DungonesInfo.is_top == 1 then
                    require "DungonesModel":GetInstance():AdventureTop(
                        msg,
                        function(data)
                            if data.ack == 1 then
                                self:Close()
                                _G.Events:GetInstance():Broadcast(_G.DungonesPlayState.DungonesUntilEnd)
                            end
                        end
                    )
                else
                    require "DungonesNet":GetInstance():ChooseAdventure(
                        msg,
                        function(data)
                            if data.ack == 1 then
                                require("DungonesModel"):GetInstance().DungonesInfo.sid = secid
                                if data.adventures then
                                    require("DungonesModel"):GetInstance():DisposalDateAdventure(data.adventures)
                                end
                                ---@type roguelike.c2s_roguelike_adventure
                                local msg = {}
                                msg.sid = self.EventId
                                msg.args = {self.HelpUid}
                                require "DungonesNet":GetInstance():Adventure(
                                    msg,
                                    function(data)
                                        if data.ack == 1 then
                                            -- _G.StorageManager:GetInstance():AddDatasByData(
                                            --     _G.StorageID.Card,
                                            --     self.HelpData
                                            -- )
                                            self:Close()
                                            _G.Events:GetInstance():Broadcast(_G.DungonesPlayState.DungonesEnd)
                                        end
                                    end
                                )
                            end
                        end
                    )
                end
            else
                if require("DungonesModel"):GetInstance().DungonesInfo.is_top == 1 then
                    local msg = {}
                    msg.sid = secid
                    msg.eid = self.EventId
                    msg.args = {self.HelpUid}
                    require "DungonesModel":GetInstance():AdventureTop(
                        msg,
                        function(data)
                            if data.ack == 1 then
                                _G.StorageManager:GetInstance():ReceiveAwardData(data)
                                self:Close()
                                _G.Events:GetInstance():Broadcast(_G.DungonesPlayState.DungonesUntilEnd)
                            end
                        end
                    )
                else
                    ---@type roguelike.c2s_roguelike_adventure
                    local msg = {}
                    msg.sid = self.EventId
                    msg.args = {self.HelpUid}
                    require "DungonesNet":GetInstance():Adventure(
                        msg,
                        function(data)
                            if data.ack == 1 then
                                --_G.StorageManager:GetInstance():AddDatasByData(_G.StorageID.Card, self.HelpData)
                                self:Close()
                                _G.Events:GetInstance():Broadcast(_G.DungonesPlayState.DungonesEnd)
                            end
                        end
                    )
                end
            end
        end
    elseif go == self.FightHelpListGo.aorbtn_close then
        self:Close()
    end
end

