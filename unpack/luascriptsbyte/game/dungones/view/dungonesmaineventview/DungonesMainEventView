function DungonesMainEventView:ResItem(index, obj)
    if index < 0 then
        return
    end
    local id = obj:GetInstanceIDE()
    local data = self.AwardData[index]
    -- obj:SetName(id .. "_" .. data.sid)
    local tb = obj
    _G.StorageManager:GetInstance():GetItemBaseView(
        data.sid,
        data.number,
        tb,
        function(item)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            local data =
                require "PrivilegeManager":GetInstance():GetPrivilegeData({_G.PrivilegeType.Dungones.Coin, data.sid})
            if not _G.table.isEmptyOrNil(data) then
                _G.PoolsManager:GetInstance():Spawn(
                    "UIH5/Dungones/@_obj_add",
                    _G.ePoolType.Temporary,
                    item.go_table.transform,
                    function(trans)
                        trans:SetAnchorPosition(0, 0)
                    end
                )
            end
        end,
        function(go)
            self:OnBtnCallItem(go, data.sid)
        end
    )
end
