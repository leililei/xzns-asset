function DungonesMainEventView:ShowItemHeadInfo(item, card)
    item:ShowCardData(card, nil, nil, true)
    item.go_table.gameObject:SetLocalScale(0.7, 0.7, 1)
    if
    self.EventType == _G.DungonesEventType.nomal or self.EventType == _G.DungonesEventType.elite or
            self.EventType == _G.DungonesEventType.boss
    then
        item.go_table.aortext_level:SetActiveE(0)
        item.go_table.aorimage_professional:SetActiveE(0)
        item.go_table.aorimage_Elements:SetLocalScaleXYZ(2.3)
        item.go_table.aorimage_Elements:SetLocalPosition(-8, -34)
    end
end

---包装奖励数据
function DungonesMainEventView:UpdateAward()
    self.AwardData = {}
    local info = self.Cfg.rewards
    ---累计加成
    local notFight = require "DungonesModel":GetInstance().DungonesInfo.not_fight
    local scale = 1
    if notFight > 0 then
        scale = scale + notFight
    end
    for i = 1, #info do
        local data = {
            sid = info[i][1],
            count = info[i][2] * scale
        }
        local itemData = _G.StorageManager:GetInstance():GetItemDataClass(data.sid)
        itemData:Parse(data)
        itemData.number = data.count
        self.AwardData[i] = itemData
    end
end

---刷新奖励
---@param trans UnityEngine.Transform
---@param index number
function DungonesMainEventView:RefreshAward(trans, index)
    local data = self.AwardData[index]
    local instance = trans:GetInstanceIDE()
    if self.AwardItems[instance] == nil then
        self.AwardItems[instance] = require("BaseAwardItem").CreatAwardItem(trans, _G.handler(self, self.ClickAward))
    end
    self.AwardItems[instance]:UpdateItem(data, nil, true)
end

