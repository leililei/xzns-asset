function DungonesMainEventView:GetHPMP(uid)
    local isHas = false
    local data
    if self.EventInfo.defender_cards then
        local cards = self.EventInfo.defender_cards
        for i = 1, #cards do
            if cards[i].uid == uid then
                data = cards[i]
                isHas = true
                break
            end
        end
        --没有找到卡牌 代表死亡
        if not isHas then
            data = {
                uid = uid,
                hp = 0,
                mp = 0
            }
            return data
        end
    else
        data = {
            uid = uid,
            hp = 10000,
            mp = 0
        }
    end
    if not isHas then
        data = {
            uid = uid,
            hp = 10000,
            mp = 0
        }
    end
    return data
end

---助战
---@param index int 该数据的索引   0起始
function DungonesMainEventView:RefreshHelpCardItem(index, obj)
    if index < 0 then
        return
    end
    local data = self.EventInfo.aid_cards[index + 1]
    local card = _G.CardData.New()
    card:Parse(data)
    local rootGo
    rootGo =
        _G.GetAutoGoTable(
        obj,
        function(go)
            if go == rootGo.aorbtn_Choose then
                if self.IsPreview then
                    return
                end
                self.HelpUid = data.uid
                self.HelpData = data
                if self.ChooseHelpItem then
                    _G.GameUtil.SetActiveByCondition(self.ChooseHelpItem, false)
                end
                _G.GameUtil.SetActiveByCondition(rootGo.aorimage_choose, true)
                self.ChooseHelpItem = rootGo.aorimage_choose
            elseif go == rootGo.aorbtn_Look then
                _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.DungonesMainEventView.Name)
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.CommonIllustrationsH5View.Name,
                    data.sid,
                    function()
                        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.DungonesMainEventView.Name)
                    end,
                    true,
                    card
                )
            end
        end
    )
    _G.GameUtil.SetActiveByCondition(rootGo.aorimage_choose, false)
    card:OnInitMutuallyData(true)
    card:CalcNowSumProp()
    rootGo.aortext_Power.text = _G.GameUtil.NumberToUnitStrFight(card:GetPower())
    rootGo.aortext_ZhanLi.text = _G.LangUtil.GetLangPackValue(90021800041) .. ":"

    local card1 = _G.CardData.New()
    card1:Parse(
        {
            sid = data.sid,
            uid = data.uid,
            star = data.star,
            lv = data.lv,
            soul_state = data.soul_state,
            soul_chain_lv = data.soul_chain_lv,
            open_inborn = data.open_inborn
        }
    )
    rootGo.obj_ftRoot:ClearChildren()
    _G.ItemCardFactory:GetInstance():GetItemCard(
        _G.ItemCardFactory.itemCardType.CardAllItem,
        rootGo.obj_ftRoot,
        _G.handlerbind(self, self.ShowItemHeadInfo, card1)
    )
end

