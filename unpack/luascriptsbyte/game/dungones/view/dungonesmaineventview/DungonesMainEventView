---@field IsPreview boolean true 预览 false 正常
function DungonesMainEventView:OnCreate(...)
    local args = {...}

    self.EventType = args[1]
    self.EventId = args[2]
    self.EventInfo = args[3]
    self.IsPreview = args[4] or false
    if require "DungonesModel":GetInstance().DungonesInfo.is_top ~= 1 then
        require "DungonesModel":GetInstance():SetSectionIDEmbattleInfo(self.EventInfo)
    end

    if _G.AppSetting.DEBUG then
        _G.Log(args, "点击打开事件数据相关")
    end
    self:Init()
end

