function Dungeons_boos_rank_award:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function Dungeons_boos_rank_award:OnCreate()
    self:InitRankAward()
end

function Dungeons_boos_rank_award:InitRankAward()
    self:SetCfg()
    self:SetRankList()
end

---按钮点击事件在这里派发
function Dungeons_boos_rank_award:OnClickBtn(go, isOn)
    if _G.AppSetting.DEBUG then
        _G.Log(go, "点击千机按钮事件")
    end
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end
function Dungeons_boos_rank_award:SetCfg()
    local cfg = _G.ConfigManager.dungeons_boss_cfg
    local rank_award = {}
    for key, value in pairs(cfg) do
        _G.table.insert(rank_award, value)
    end
    _G.table.sort(
        rank_award,
        function(a, b)
            return a.id < b.id
        end
    )
    self.cfg = rank_award
end
function Dungeons_boos_rank_award:SetRankList()
    local row = #self.cfg
    if self.mList == nil then
        self.go_table.looplist2_paiming:InitListView(row, _G.handler(self, self.RefreshItem))
        self.mList = self.go_table.looplist2_paiming
    else
        self.go_table.looplist2_paiming:RefreshAllShownItem()
    end
end
function Dungeons_boos_rank_award:RefreshItem(listView2, index)
    if index < 0 then
        return
    end
    local item = listView2:NewListViewItem("$_obj_ListItem")
    local data = self.cfg[index + 1] or {}
    self:SetRankTiaoOne(item, data)
    return item
end
function Dungeons_boos_rank_award:SetRankTiaoOne(go, data)
    local tb = _G.GetAutoGoTable(go)
    if data == nil then
        _G.GameUtil.SetActiveByCondition(tb.gameObject, false)
        return
    end
    local mingcimin = data.min_rank
    local mingcimax = data.max_rank
    if mingcimin == mingcimax then
        _G.GameUtil.SetActiveByCondition(tb.aorimage_paiming, true)
        if mingcimin == 1 then
            tb.aorimage_paiming.SpriteName = "uui_tz_maoxian_shd_paiming1"
        elseif mingcimin == 2 then
            tb.aorimage_paiming.SpriteName = "uui_tz_maoxian_shd_paiming2"
        elseif mingcimin == 3 then
            tb.aorimage_paiming.SpriteName = "uui_tz_maoxian_shd_paiming3"
        end
        tb.aortext_rank_paiming.text = ""
    else
        _G.GameUtil.SetActiveByCondition(tb.aorimage_paiming, false)
        _G.GameUtil.SetActiveByCondition(tb.aortext_rank_paiming, true)
        tb.aortext_rank_paiming.text = _G.string.format(_G.LangUtil.GetLangPackValue(90022100071), mingcimin, mingcimax)
    end
    local reward = data.reward_daily
    --奖励
    self:SetReaward(tb, reward)
end
