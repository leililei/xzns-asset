local BaseAwardNewItem = require "BaseAwardNewItem"
---@class DungonesUntilTopAwardView : Component	中文描述
---@field go_table DungonesUntilTopAwardView_GoTable
local DungonesUntilTopAwardView = _G.BaseClass("DungonesUntilTopAwardView", _G.Component)
local GetLangPackValue = _G.GetLangPackValue

local LangIds = {
    progress = 90024600066
}

function DungonesUntilTopAwardView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建对象时,入口构造函数
---@param data roguelike.i_top_info
function DungonesUntilTopAwardView:OnCreate(data, call)
    self.awardDatas = _G.StorageManager:GetInstance():MergeAward(data)
    self.go_table.scrollloopvectical_itemList:InitItemData(#self.awardDatas, _G.handler(self, self.RefreshAward))
    self.call = call
    self.go_table.aortext_content.text =
        GetLangPackValue(
        LangIds.progress,
        data.mementos_choose_num,
        data.mementos_choose_num,
        #data.top_adventures,
        data.top_boss_num,
        data.top_boss_num
    )
end

function DungonesUntilTopAwardView:RefreshAward(index, obj)
    local tb = _G.GetAutoGoTable(obj)
    if not tb.item then
        tb.item = BaseAwardNewItem.New(obj, nil, 96, tb.trans_root)
    end
    tb.item:ShowWithID(self.awardDatas[index + 1])
end

---销毁对象时,析构函数
function DungonesUntilTopAwardView:OnDestroy()
end

function DungonesUntilTopAwardView:OnClickBtn(go)
    if go == self.go_table.aorbtn_event then
        if self.call then
            self.call()
        end
    end
end

return DungonesUntilTopAwardView
