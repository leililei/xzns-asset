---@class DungonesShopView : UIBaseView	千机黑煞 神秘商人
---@field public go_table DungonesShopView_GoTable GoTable
---@field ItemList DungonesShopView._obj_item_GoTable[]
local DungonesShopView = _G.BaseClass("DungonesShopView", _G.UIBaseView)
local GetLangPackValue = _G.GetLangPackValue
function DungonesShopView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.shoop_poolcfg = _G.ConfigManager.shop_pools_cfg
end

---界面的入口函数
---@param data roguelike.i_adventure
function DungonesShopView:OnCreate(data, isPreview)
    if nil == isPreview then
        self.IsPreview = false
    else
        self.IsPreview = isPreview
    end
    self.EventsInfos = data
    self.ItemList = {}
    self.section_sid = data.section_sid
    self.data = data.args
    self.sid = data.sid
    self.currsid = 0
    self.tb_sid_objs = {}
    self.buy = {}
    self.privilege = require "PrivilegeManager":GetInstance():GetPrivilegeData({_G.PrivilegeType.Dungones.Shop})
    self:AddComponent(
        self.go_table.obj_glod,
        require("ResourceCompont").New(self.go_table.obj_glod, _G.ConfigManager.ui_cfg.DungonesShopView.resources)
    )
    self.currsid = 0

    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_go, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_enter, not self.IsPreview)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_fangqi, not self.IsPreview)
    if not self.IsPreview then
        self:ChooseAdventure()
    end
    self:InitViewShop()
end

function DungonesShopView:InitViewShop()
    if self.data then
        local col = #self.data
        if self.shoplist == nil then
            self.shoplist =
                self.go_table.scrollloophorizontal_ShopList:InitItemData(col, _G.handler(self, self.RefreshList))
        else
            self.go_table.scrollloophorizontal_ShopList:UpdateCount(col)
        end
        self:SetName()
        self:SetIcon()
    else
        self.go_table.aortext_desc.text = GetLangPackValue(90022500408)
    end
end

function DungonesShopView:SetName()
    local cfg = _G.ConfigManager.adventure_cfg
    local name = cfg[self.sid].desc
    --self.go_table.aortext_name.text = GetLangPackValue(name)
    self.go_table.aortext_desc.text = GetLangPackValue(name)
end

function DungonesShopView:SetIcon()
    local cfg = _G.ConfigManager.adventure_cfg
    local icon = cfg[self.sid].icon
    self.go_table.aorrawimage_icon:LoadImage(icon)
    -- 镇魂街ZHJ-33365 【主任务】贪玩三测优化（7.10后）ZHJ-34888
    -- 客户端】千机黑煞-图标位置调整
    -- 调整神秘商人贩售窗口中的商人图标位置
    self.go_table.aorrawimage_icon:SetLocalPosition(0,0,0)
    self.go_table.aorrawimage_icon:SetLocalScaleXYZ(0.5)
end

---刷新界面显示
function DungonesShopView:RefreshList(index, obj)
    if index < 0 then
        return
    end
    local instanceID = obj:GetInstanceIDE()
    local tb = self.ItemList[instanceID]
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        self.ItemList[instanceID] = tb
        _G.AddViewBtnClick(tb.gameObject, _G.handlerbind(self, self.OnClickItem, tb))
    end
    tb.index = index + 1
    local sid = self.data[tb.index]
    --local itemid = self.shoop_poolcfg[sid].item[1]
    --local num = self.shoop_poolcfg[sid].item[2]
    local array = _G.GlobalInterface.GetNewTable(self.shoop_poolcfg[sid].item)
    local itemid = _G.table.remove(array, 1)
    local num = 0
    if #self.shoop_poolcfg[sid].item > 1 then
        num = _G.table.remove(array, 1)
    end
    local extend = array
    local data = _G.StorageManager:GetInstance():GetItemDataClass(itemid, num, extend)
    if not tb.item then
        self.tb_sid_objs[sid] = {}
        tb.item = require "BaseAwardNewItem".New(tb.obj_Root, nil, 96)
    end
    self.tb_sid_objs[sid] = tb

    local cfg = self.shoop_poolcfg[sid]
    if cfg then
        _G.GameUtil.SetActiveByCondition(tb.obj_discount1, cfg.discount > 0)
        if cfg.discount > 0 then
            local showvalue = math.modf(cfg.discount / 1000)
            if GameUtil.GetIsUseChinese() then
                tb.aortext_discountNum1La:SetActiveE(1)
                tb.aortext_discountNum2La:SetActiveE(1)
            else
                tb.aortext_discountNum1La:SetActiveE(0)
                tb.aortext_discountNum2La:SetActiveE(0)
                showvalue = 100 - showvalue * 10
                showvalue = "-" .. showvalue .. "%"
            end
            tb.aortext_discountNum1.text = showvalue
            tb.aortext_discountNum2.text = showvalue
        end
        tb.aortext_num.text = _G.GameUtil.NumberToUnitStr(cfg.price)
        local coinCfg = _G.ConfigManager.currency_type_cfg[cfg.currency_type]
        tb.aorrawimage_icon:LoadImage(coinCfg.icon)
    end
    _G.GameUtil.SetActiveByCondition(tb.obj_Mask, self:CheckIsBuy(sid))
    _G.GameUtil.SetActiveByCondition(tb.aorimage_chose, self:CheckIsBuy(sid))

    local _, type = _G.StorageManager:GetInstance():CheckSidType(itemid)
    if type == _G.StorageID.Equipment then
        if self.commendCards == nil then
            self.commendCards = require("CardResonanceModel"):GetInstance():GetAllPosCards()
        end
        tb.commendLis =
            require("EquipmentModel"):GetInstance():GetCommendCardsBySidAndEle(itemid, nil, self.commendCards)
        tb.item:Show(
            data,
            function()
                --tb.item.item:RefreshRedPoint(#tb.commendLis > 0)
            end
        )
    else
        tb.item:Show(data)
    end
end

---检测是否购买
function DungonesShopView:CheckIsBuy(sid)
    if _G.table.isEmptyOrNil(self.buy) then
        return false
    end
    for _, v in pairs(self.buy) do
        if v == sid then
            return true
        end
    end
    return false
end

---点击商品
function DungonesShopView:OnClickItem(go, ison, tb)
    local sid = self.data[tb.index]
    local name = go:GetName()
    if name == "@_aorbtn_click_tips" then
        if self.IsPreview then
            local itemid = self.shoop_poolcfg[sid].item[1]
            require "CommonTipManager":GetInstance():OpenTip(tb.gameObject, itemid, nil, nil, nil, tb.commendLis)
            return
        end
        if sid == self.currsid then
            local itemid = self.shoop_poolcfg[sid].item[1]
            require "CommonTipManager":GetInstance():OpenTip(tb.gameObject, itemid, nil, nil, nil, tb.commendLis)
            return
        end
        --选中框
        if self.tb_sid_objs[self.currsid] then
            self.tb_sid_objs[self.currsid].aorimage_chose:SetActiveE(0)
        end
        self.currsid = sid
        tb.aorimage_chose:SetActiveE(1)
    elseif name == "@_aorbtn_tishi" then ---ZHJH-4685隐藏提示按钮
        local itemid = self.shoop_poolcfg[sid].item[1]
        require "CommonTipManager":GetInstance():OpenTip(tb.gameObject, itemid, nil, nil, nil, tb.commendLis)
    end
end

function DungonesShopView:OpenTanchuang()
    _G.PopWindowManager:GetInstance():ShowAllTips(610302, nil, _G.handler(self, self.GiveUp))
end

---放弃
function DungonesShopView:GiveUp()
    local secid = self.section_sid
    local id = require("DungonesModel"):GetInstance().DungonesInfo.sid
    if require("DungonesModel"):GetInstance().DungonesInfo.is_top == 1 then
        local msg = {
            sid = secid,
            eid = self.sid,
            args = {},
            sign = 2
        }
        require "DungonesModel":GetInstance():AdventureTop(
            msg,
            function(data)
                if data.ack ~= 1 then
                    return
                end
                self:Close()
                _G.Events:GetInstance():Broadcast(_G.DungonesPlayState.DungonesUntilEnd)
            end
        )
    else
        local msg = {
            sid = self.sid,
            args = {},
            sign = 2
        }
        require "DungonesNet":GetInstance():Adventure(
            msg,
            function(data)
                if data.ack ~= 1 then
                    return
                end
                self:Close()
                _G.Events:GetInstance():Broadcast(_G.DungonesPlayState.DungonesEnd)
            end
        )
    end
end

function DungonesShopView:OnClickBuy()
    if self.currsid == 0 then
        return 0
    end
    local sid = self.currsid
    if self:CheckIsBuy(sid) then
        return
    end
    local cfg = _G.ConfigManager.shop_pools_cfg[sid]
    local coinCfg = _G.ConfigManager.currency_type_cfg[cfg.currency_type]
    if cfg then
        local name = _G.StorageManager:GetInstance():GetItemName(cfg.item[1])

        local content =
            GetLangPackValue(
            90022500409,
            _G.GameUtil.NumberToUnitStr(cfg.price),
            GetLangPackValue(coinCfg.name),
            "<color=#b23939>" .. name .. "</color>"
        )
        _G.PopWindowManager:GetInstance():ShowAllTips(
            2002,
            content,
            function()
                if require "DungonesModel":GetInstance().DungonesInfo.is_top == 1 then
                    local msg = {
                        sid = self.section_sid,
                        eid = self.sid,
                        args = {sid},
                        sign = 1
                    }

                    require "DungonesModel":GetInstance():AdventureTop(
                        msg,
                        function(data)
                            if data.ack ~= 1 then
                                return
                            end
                            _G.StorageManager:GetInstance():ConsumeItem(cfg.currency_type, 0, cfg.price)
                            require "CommonTipManager".OpenCommonAwardView(data)
                            _G.table.insert(self.buy, sid)
                            _G.GameUtil.SetActiveByCondition(self.tb_sid_objs[self.currsid].obj_Mask, true)
                            if #self.buy == #self.data then
                                self:GiveUp()
                            end
                        end
                    )
                else
                    local msg = {
                        sid = self.sid,
                        args = {sid},
                        sign = 1
                    }

                    require "DungonesNet":GetInstance():Adventure(
                        msg,
                        function(data)
                            if data.ack ~= 1 then
                                return
                            end
                            _G.StorageManager:GetInstance():ConsumeItem(cfg.currency_type, 0, cfg.price)
                            _G.StorageManager:GetInstance():ReceiveAwardData(data)
                            require "CommonTipManager".OpenCommonAwardView(data)
                            _G.table.insert(self.buy, sid)
                            _G.GameUtil.SetActiveByCondition(self.tb_sid_objs[self.currsid].obj_Mask, true)
                            if #self.buy == #self.data then
                                self:GiveUp()
                            end
                        end
                    )
                end
            end
        )
    end
end

---按钮点击事件在这里派发
function DungonesShopView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_enter then
        self:OnClickBuy()
    elseif go == self.go_table.aorbtn_close then
        if self.IsPreview then
            self:Close()
        elseif require "DungonesModel":GetInstance().DungonesInfo.is_top == 1 then
            if not _G.table.isEmptyOrNil(self.buy) then
                for i = 1, #self.buy do
                    for k, v in pairs(self.data) do
                        if v == self.buy[i] then
                            _G.table.remove(self.data, k)
                            break
                        end
                    end
                end
            end
            self:Close()
        else
            self:Close()
            require("DungonesManager"):GetInstance().iswin = false
            require("DungonesModel"):GetInstance().DungonesInfo.sid = self.section_sid
            _G.Events:GetInstance():Broadcast(_G.DungonesPlayState.DungonesEnd)
        end
    elseif go == self.go_table.aorbtn_fangqi then
        self:OpenTanchuang()
    end
end

--千机黑煞 神秘商人 锁事件（前往按钮）
function DungonesShopView:ChooseAdventure()
    local selectEventID = require "DungonesModel":GetInstance().DungonesInfo.sid
    local IsUntil = require("DungonesModel"):GetInstance().DungonesInfo.is_top == 1
    --没有选择事件
    if selectEventID == 0 then
        if not IsUntil then
            local msg1 = {}
            msg1.sid = self.EventsInfos.section_sid
            require "DungonesNet":GetInstance():ChooseAdventure(
                msg1,
                function(data)
                    if data.ack ~= 1 then
                        return
                    end
                    if data.adventures then
                        require("DungonesModel"):GetInstance():DisposalDateAdventure(data.adventures)
                    end
                    require "DungonesModel":GetInstance().DungonesInfo.sid = self.EventsInfos.section_sid
                    self:InitViewShop()
                end
            )
        end
    elseif self.EventsInfos.args then
        self:InitViewShop()
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(
            610305,
            nil,
            function()
                if IsUntil then
                    local msg = {
                        sid = self.section_sid,
                        eid = self.EventsInfos.sid,
                        args = {},
                        sign = 2
                    }
                    require "DungonesModel":GetInstance():AdventureTop(
                        msg,
                        function(data)
                            if data.ack ~= 1 then
                                return
                            end
                            self:Close()
                            _G.Events:GetInstance():Broadcast(_G.DungonesPlayState.DungonesUntilEnd)
                        end
                    )
                else
                    local msg = {
                        sid = self.EventsInfos.sid,
                        args = {},
                        sign = 2
                    }
                    require "DungonesNet":GetInstance():Adventure(
                        msg,
                        function(data)
                            if data.ack ~= 1 then
                                return
                            end
                            self:Close()
                            _G.Events:GetInstance():Broadcast(_G.DungonesPlayState.DungonesEnd)
                        end
                    )
                end
            end
        )
    end
end

return DungonesShopView
