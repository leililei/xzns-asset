local SettlementModel = require "SettlementModel"
local SettlementBaseView = require "SettlementBaseView"
---@class Dungeons_boss_win : SettlementBaseView	中文描述
---@field public go_table Dungeons_boss_win_GoTable GoTable
local Dungeons_boss_win = _G.BaseClass("Dungeons_boss_win", SettlementBaseView)
--_G.Dungeons_boss_win = Dungeons_boss_win

local CS = _G.CS
local typeof = _G.typeof

function Dungeons_boss_win:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function Dungeons_boss_win:OnCreateChild(awards, extraAward, damage, result, fightArg)
    self.awardCount = 0
    self.AwardData = awards or {}
    self.ExtraAward = extraAward or {}
    self.damage = result.damage or 0
    self.maxDamage = result.maxDamage or self.damage or 0
    self.re_uid = result and result.re_uid or nil
    self.reportType = result and result.reportType or 0
    self.otherInfo = result and result.otherInfo or nil
    self.fightArg = fightArg or nil

    self:ParseAward(self.AwardData, self.ExtraAward)
    self:SetAwardCount()
    self:UpdataNoAwardText()
    self:OpenEmbattleView()
    self:InitPanel()
    self.Scroll = self.go_table.obj_ScrollView:GetComponentE(typeof(CS.UnityEngine.UI.ScrollRect))
    self:InitV()
    _G.PlayerPrefsManager.SetTable(
        "FightBossWinDamage",
        {
            damage = damage,
            maxDamage = require("DungonesModel"):GetInstance().DungonesInfo.damage
        }
    )
end

function Dungeons_boss_win:OpenEmbattleView()
    local result = {}
    result.iSWin = true
    result.statistics = true
    result.btnDisplay = false
    --result.AwardData = self.AwardData
    result.hidePlayerInfo = true
    result.loadedEffect = _G.handler(self, self.LoadedEffectCall)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
    self:OnShowView(
        _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
        result,
        nil,
        nil,
        nil,
        self.fightArg and { self.fightArg } or nil
    )
end

---打开结算界面
---@param name string 结算界面名称
---@param result table 结算参数
function Dungeons_boss_win:OnShowView(name, ...)
    _G.UIManager:GetInstance():OpenWindow(name, nil, ...)
end

---监听界面
---@param name string 界面名称
function Dungeons_boss_win:OnUIOpened(name)
    if name == _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)

        ---@type ShowAwardWithButtonView
        self.ShowAwardWithButtonView = _G.UIManager:GetInstance():GetWindowCtrl(name)

        self.ShowAwardWithButtonView.go_table.aortext_tip:SetParentE(self.ShowAwardWithButtonView.go_table.obj_tips1)
        self.ShowAwardWithButtonView.go_table.aortext_tip:SetActiveE(1)
        self.ShowAwardWithButtonView.go_table.aortext_tip:DOFade(0, 1):SetLoops(-1, CS.DG.Tweening.LoopType.Yoyo)
        _G.UIManager:GetInstance():ChangeCanvasOrder(
            name,
            self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
        )
        self.ShowAwardWithButtonView.transform:SetParentE(self.go_table.trans_view)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_info, true)
    end
end

---监听界面
---@param name string 界面名称
function Dungeons_boss_win:OnUIClosed(name)
    if name == _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
        --self.ShowAwardWithButtonView:Close()
        --self:Close()
        --self.ShowAwardWithButtonView:CloseCall(SettlementModel.FunctionEnum.None)

        self:CloseCall(SettlementModel.FunctionEnum.None)
        _G.Events:GetInstance():Broadcast(_G.DungonesPlayState.DungonesEnd)
    end
end

function Dungeons_boss_win:InitPanel()
    self.go_table.aortext_damage.text = _G.GameUtil.NumberToUnitStrBag(self.damage, false)
    self.go_table.obj_new:SetActiveE(self.damage > self.maxDamage and 1 or 0)
    if self.maxDamage and self.damage < self.maxDamage then
        self.go_table.slider_damage.value = self.damage / self.maxDamage
    else
        self.go_table.slider_damage.value = 1
    end
    if AppSetting.IsXzns then
        self.go_table.aortext_maxdamage.text=string.format("<color=#FFB93F>%s</color>/%s",
        _G.GameUtil.NumberToUnitStrFight(self.damage),
        _G.GameUtil.NumberToUnitStrFight(self.maxDamage))
    end
end

function Dungeons_boss_win:UpdataNoAwardText()
    self.go_table.aortext_noawardtxt:SetActiveE(self.awardCount == 0 and 1 or 0)
end

---解析结算奖励
function Dungeons_boss_win:SetAwardCount()
    local count = 0
    local count1 = 0
    if self.AwardData and not _G.table.isEmptyOrNil(self.AwardData) then
        count = _G.table.count(self.AwardData)
    end
    if self.ExtraAward and not _G.table.isEmptyOrNil(self.ExtraAward) then
        count = _G.table.count(self.ExtraAward)
    end
    self.awardCount = count + count1
end

---初始化胜利界面加载特效
function Dungeons_boss_win:InitV()
    if self.awardCount > 0 then
        if self.AllItem == nil then
            self.AllItem = {}
        end
        self.CreateCount = 0
        self:ParseAward(self.AwardData, self.ExtraAward)
        self:CreateItem(self.Award)
    end
end

function Dungeons_boss_win:CreateItem(award)
    local awardItem
    if award and not _G.table.isEmptyOrNil(award) then
        for _, v in pairs(award) do
            local goTable
            awardItem = _G.InstantiateObject(self.go_table.obj_item, self.go_table.obj_AwardContent)
            _G.table.insert(self.AllItem, awardItem:GetComponentE(typeof(CS.UnityEngine.RectTransform)))
            goTable = _G.GetAutoGoTable(awardItem)
            goTable.sid = v._award[1]
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                v._award,
                goTable.obj_root,
                function(tran)
                    tran.gameObject:SetLocalPosition(0, 0, 0)
                    tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    self.CreateCount = self.CreateCount + 1
                    if _G.AppSetting.DEBUG then
                        _G.Log(self.CreateCount, "InitV,奖励个数")
                    end
                    if self.CreateCount == self.awardCount then
                        self:ShowAward()
                    end
                end,
                function()
                    self:ClickAward(goTable)
                end
            )
            _G.GameUtil.SetActiveByCondition(goTable.aorimage_extra, v._extra)
        end
    end
    if AppSetting.IsXzns then
        self.go_table.aortext_awardtitle:SetActiveE((award and not _G.TableIsEmpty(award)) and 1 or 0)
    end
end

function Dungeons_boss_win:ClickAward(goTable)
    local type = _G.StorageManager:GetInstance():CheckSidType(goTable.sid)
    if type == _G.StorageType.Card then
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnCommonIllustrationsViewShow, self)
    end
    require("CommonTipManager"):GetInstance():OpenTip(goTable.gameObject, goTable.sid)
end

function Dungeons_boss_win:OnCommonIllustrationsViewShow(name)
    if name == _G.ConfigManager.ui_cfg.CommonIllustrationsH5View.Name then
        _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnCommonIllustrationsViewShow, self)
    end
end

function Dungeons_boss_win:ParseAward(award, extraAward)
    self.Award = {}
    local Award = {}
    if award and not _G.table.isEmptyOrNil(award) then
        for k, v in pairs(award) do
            _G.table.insert(Award, {_award = v, _extra = false})
        end
    end
    if extraAward and not _G.table.isEmptyOrNil(extraAward) then
        for k, v in pairs(extraAward) do
            _G.table.insert(Award, {_award = v, _extra = true})
        end
    end
    if not _G.table.isEmptyOrNil(Award) then
        _G.SortList(
            Award,
            function(a)
                local storageID = _G.StorageManager:GetInstance():CheckSidType(a._award[1])
                local extra = a._extra and 0 or 1
                return storageID, a._award[1], extra
            end
        )
    end
    self.Award = Award
end

function Dungeons_boss_win:ShowAward()
    if not self.AllItem then
        return
    end
    if #self.AllItem > 8 then
        self.Scroll.vertical = true
    end
    for _, v in pairs(self.AllItem) do
        v:SetActiveE(1)
    end
end

---按钮点击事件在这里派发
function Dungeons_boss_win:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_BG" then
        self.ShowAwardWithButtonView:CloseCall(SettlementModel.FunctionEnum.None)
        self:CloseCall(SettlementModel.FunctionEnum.None)
        _G.Events:GetInstance():Broadcast(_G.DungonesPlayState.DungonesEnd)
    elseif name == "@_aorbtn_shenglitotal" then
        self:ShowStatisticsView()
    end
end

-- ---显示战斗消息
function Dungeons_boss_win:ShowStatisticsView()
    local data = _G.BattleManager:GetInstance():GetStatistics()

    if data.FighterInfo ~= nil then
        self.statisticsData = data.FighterInfo[1]
        for i, v in ipairs(data.FighterInfo) do
            if i > 1 then
                _G.table.insertto(self.statisticsData.Attacker, v.Attacker)
                _G.table.insertto(self.statisticsData.Defender, v.Defender)
            end
        end
    end
    self.statisticsMax = {DmgOut = 1, DmgIn = 1, HpRecover = 1, CreateGuard = 1}
    for i = 1, #self.statisticsData.Attacker do
        if self.statisticsMax.DmgOut < self.statisticsData.Attacker[i].DmgOut then
            self.statisticsMax.DmgOut = self.statisticsData.Attacker[i].DmgOut
        end

        if self.statisticsMax.DmgIn < self.statisticsData.Attacker[i].DmgIn then
            self.statisticsMax.DmgIn = self.statisticsData.Attacker[i].DmgIn
        end

        if self.statisticsMax.HpRecover < self.statisticsData.Attacker[i].HpRecover then
            self.statisticsMax.HpRecover = self.statisticsData.Attacker[i].HpRecover
        end
        if self.statisticsMax.CreateGuard < self.statisticsData.Attacker[i].CreateGuard then
            self.statisticsMax.CreateGuard = self.statisticsData.Attacker[i].CreateGuard
        end
    end
    for i = 1, #self.statisticsData.Defender do
        if self.statisticsMax.DmgOut < self.statisticsData.Defender[i].DmgOut then
            self.statisticsMax.DmgOut = self.statisticsData.Defender[i].DmgOut
        end

        if self.statisticsMax.DmgIn < self.statisticsData.Defender[i].DmgIn then
            self.statisticsMax.DmgIn = self.statisticsData.Defender[i].DmgIn
        end

        if self.statisticsMax.HpRecover < self.statisticsData.Defender[i].HpRecover then
            self.statisticsMax.HpRecover = self.statisticsData.Defender[i].HpRecover
        end
        if self.statisticsMax.CreateGuard < self.statisticsData.Defender[i].CreateGuard then
            self.statisticsMax.CreateGuard = self.statisticsData.Defender[i].CreateGuard
        end
    end
    self.CombMax = {DmgOut = 1, CreateGuard = 1, HpRecover = 1}
    for i = 1, #self.statisticsData.AtkCombineSkills[1] do
        if self.CombMax.DmgOut < self.statisticsData.AtkCombineSkills[1][i].DmgOut then
            self.CombMax.DmgOut = self.statisticsData.AtkCombineSkills[1][i].DmgOut
        end

        if self.CombMax.CreateGuard < self.statisticsData.AtkCombineSkills[1][i].CreateGuard then
            self.CombMax.CreateGuard = self.statisticsData.AtkCombineSkills[1][i].CreateGuard
        end

        if self.CombMax.HpRecover < self.statisticsData.AtkCombineSkills[1][i].HpRecover then
            self.CombMax.HpRecover = self.statisticsData.AtkCombineSkills[1][i].HpRecover
        end
    end
    for i = 1, #self.statisticsData.DefCombineSkills[1] do
        if self.CombMax.DmgOut < self.statisticsData.DefCombineSkills[1][i].DmgOut then
            self.CombMax.DmgOut = self.statisticsData.DefCombineSkills[1][i].DmgOut
        end

        if self.CombMax.CreateGuard < self.statisticsData.DefCombineSkills[1][i].CreateGuard then
            self.CombMax.CreateGuard = self.statisticsData.DefCombineSkills[1][i].CreateGuard
        end

        if self.CombMax.HpRecover < self.statisticsData.DefCombineSkills[1][i].HpRecover then
            self.CombMax.HpRecover = self.statisticsData.DefCombineSkills[1][i].HpRecover
        end
    end
    self.PetMax = {DmgOut = 1, CreateGuard = 1, HpRecover = 1}
    for j = 1, #self.statisticsData.AtkPetSkills[1] do
        if self.PetMax.DmgOut < self.statisticsData.AtkPetSkills[1][j].DmgOut then
            self.PetMax.DmgOut = self.statisticsData.AtkPetSkills[1][j].DmgOut
        end

        if self.PetMax.CreateGuard < self.statisticsData.AtkPetSkills[1][j].CreateGuard then
            self.PetMax.CreateGuard = self.statisticsData.AtkPetSkills[1][j].CreateGuard
        end

        if self.PetMax.HpRecover < self.statisticsData.AtkPetSkills[1][j].HpRecover then
            self.PetMax.HpRecover = self.statisticsData.AtkPetSkills[1][j].HpRecover
        end
    end
    for j = 1, #self.statisticsData.DefPetSkills[1] do
        if self.PetMax.DmgOut < self.statisticsData.DefPetSkills[1][j].DmgOut then
            self.PetMax.DmgOut = self.statisticsData.DefPetSkills[1][j].DmgOut
        end

        if self.PetMax.CreateGuard < self.statisticsData.DefPetSkills[1][j].CreateGuard then
            self.PetMax.CreateGuard = self.statisticsData.DefPetSkills[1][j].CreateGuard
        end

        if self.PetMax.HpRecover < self.statisticsData.DefPetSkills[1][j].HpRecover then
            self.PetMax.HpRecover = self.statisticsData.DefPetSkills[1][j].HpRecover
        end
    end
    -- end
    local damage = {}
    _G.table.insert(
        damage,
        {
            statisticsData = self.statisticsData,
            statisticsMax = self.statisticsMax,
            CombMax = self.CombMax,
            PetMax = self.PetMax
        }
    )
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name,
        damage,
        {0},
        function()
            if self.waitTimer ~= nil then
                self.waitTimer = _G.TimerManager:GetInstance():GetTimer(1, self.ShowWaitTime, self)
                self.waitTimer:Start()

                if _G.AppSetting.DEBUG then
                    _G.Log("<color=red>" .. "自动推图倒计时继续" .. "</color>")
                end
            end
        end,
        nil,
        self.otherInfo,
        1,
        nil,
        nil,
        nil,
        self.re_uid,
        self.reportType
    )
end

return Dungeons_boss_win
