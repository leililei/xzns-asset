local DungonesModel = require("DungonesModel")
---@class Dungones_question_view : UIBaseView	千机黑煞 答题
---@field public go_table Dungones_question_view_GoTable GoTable
local Dungones_question_view = _G.BaseClass("Dungones_question_view", _G.UIBaseView)

local one = 90024600016
local DaTi = 90024600022
local yulan = 90024600023
local JiangLi = 90024600024
local zuigao = 90024600025
local DangQian = 90024600026
function Dungones_question_view:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.model = DungonesModel:GetInstance()
    self.model:ResetHitRate_question()
    self.model:ResetHitCuowu_question()
end

---界面的入口函数
---@param data table 答题的数据
---@param ZhuangTai number 1正常，2，预览
---@field sids table 答题配置表的 sids
function Dungones_question_view:OnCreate(data, ZhuangTai, isPreview)
    self.Data = data
    self.curretSid = 1
    self.ZhuangTai = ZhuangTai
    if ZhuangTai == nil then
        self.ZhuangTai = 1
    end
    self.IsPreview = isPreview or false
    self.go_table.aortext_question_Da.text =
        _G.string.format(
        _G.LangUtil.GetLangPackValue(DaTi),
        self.model:GetHitRate_question(),
        self.model:GetHitCuowu_question()
    )
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_resolt, not self.IsPreview)
    self.go_table.aortext_question_Ci.text = _G.string.format(_G.LangUtil.GetLangPackValue(one), self.curretSid)

    self.sids = data.args or {}
    self.eventSid = data.sid
    self.cfg = _G.ConfigManager.questions_cfg
    self.select = 0
    self.select_tb = {}
    if self.ZhuangTai == 1 then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_view_resoult, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_View_question, true)
        self:SetName()
        self:SetIcon()
        self:SetQuestion_Des()
        self:UpDataQuestion()
    elseif self.ZhuangTai == 2 then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_view_resoult, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_View_question, false)
        self:SetHitRate_resoult()
    end
end

---按钮点击事件在这里派发
function Dungones_question_view:OnClickBtn(go, isOn)
    if _G.AppSetting.DEBUG then
        _G.Log(go, "点击千机按钮事件")
    end
    if go == self.go_table.aorbtn_close then
        -- if self.curretSid > #self.sids then
        --     _G.Events:GetInstance():Broadcast(_G.DungonesPlayState.DungonesEnd)
        -- end
        -- self:Close()
        if self.IsPreview then
            self:Close()
        else
            self:Close()
            if require("DungonesModel"):GetInstance().DungonesInfo.is_top == 1 then
                _G.Events:GetInstance():Broadcast(_G.DungonesPlayState.DungonesUntilEnd)
            else
                require("DungonesManager"):GetInstance().iswin = false
                require("DungonesModel"):GetInstance().DungonesInfo.sid = self.section_sid
                _G.Events:GetInstance():Broadcast(_G.DungonesPlayState.DungonesEnd)
            end
        end
    elseif go == self.go_table.aorbtn_anyClose then
        if self.IsPreview then
            self:Close()
        else
            self:Close()
            if require("DungonesModel"):GetInstance().DungonesInfo.section > 0 then
                require("DungonesManager"):GetInstance().iswin = false
                require("DungonesModel"):GetInstance().DungonesInfo.sid = self.section_sid
                _G.Events:GetInstance():Broadcast(_G.DungonesPlayState.DungonesEnd)
            end
        end
    elseif go == self.go_table.aorbtn_enter then
        -- self:EnterNextOnClick()
    elseif go == self.go_table.aorbtn_resolt then
        if self.IsPreview then
            self:Close()
        else
            if self.ZhuangTai == 1 then
                self:ResoultOnClick()
            elseif self.ZhuangTai == 2 then
                local secid = self.Data.section_sid
                local id = require("DungonesModel"):GetInstance().DungonesInfo.sid
                if id <= 0 then
                    ---@type roguelike.c2s_roguelike_choose
                    local msg = {}
                    msg.sid = secid
                    require "DungonesNet":GetInstance():ChooseAdventure(
                        msg,
                        function(data)
                            if data.ack == 1 then
                                _G.GameUtil.SetActiveByCondition(self.go_table.obj_view_resoult, false)
                                _G.GameUtil.SetActiveByCondition(self.go_table.obj_View_question, true)
                                require("DungonesModel"):GetInstance().DungonesInfo.sid = secid
                                self:OnCreate(self.Data, 1)
                                if data.adventures then
                                    require("DungonesModel"):GetInstance():DisposalDateAdventure(data.adventures)
                                end
                            end
                        end
                    )
                end
            end
        end
    elseif go == self.go_table.toggle_question_A then
        if isOn then
            self.select = 1
            self:EnterNextOnClick()
        -- self:SelectOnClick()
        end
    elseif go == self.go_table.toggle_question_B then
        if isOn then
            self.select = 2
            self:EnterNextOnClick()
        -- self:SelectOnClick()
        end
    elseif go == self.go_table.toggle_question_C then
        if isOn then
            self.select = 3
            self:EnterNextOnClick()
        -- self:SelectOnClick()
        end
    end
end

-- region 设置

function Dungones_question_view:SetName()
    local cfg = _G.ConfigManager.adventure_cfg
    local name = cfg[self.eventSid].name
    self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(name)
end
function Dungones_question_view:SetIcon()
    local cfg = _G.ConfigManager.adventure_cfg
    local icon = cfg[self.eventSid].icon
    self.go_table.aorrawimage_icon:LoadImage(icon)
end
-- 设置问题的描述
function Dungones_question_view:SetQuestion_Des()
    local sid = self.sids[self.curretSid]
    _G.table.insert(self.select_tb, sid)
    local dec = _G.LangUtil.GetLangPackValue(self.cfg[sid].questions or "")
    self.go_table.aortext_question_des.text = dec
end
-- 设置问题的 答案(选项)
function Dungones_question_view:SetQuestion_selct(go, num)
    local sid = self.sids[self.curretSid]
    local des_num = self.cfg[sid].answer1
    local tb = _G.GetAutoGoTable(go)
    local d = nil
    if num == 1 then
        des_num = self.cfg[sid].answer1
    elseif num == 2 then
        des_num = self.cfg[sid].answer2
    elseif num == 3 then
        des_num = self.cfg[sid].answer3
    end
    local des = _G.LangUtil.GetLangPackValue(des_num)
    tb.aortext_question_xulie_des.text = des
end
---更新问题、以及选项答案
function Dungones_question_view:UpDataQuestion()
    self.go_table.toggle_question_A.isOn = false
    self.go_table.toggle_question_B.isOn = false
    self.go_table.toggle_question_C.isOn = false
    local node = self.go_table.obj_QuestionNode
    for i = 1, 3 do
        self:SetQuestion_selct(node:GetChildE(i - 1), i)
    end
end
-- 设置结果
function Dungones_question_view:SetHitRate_resoult()
    local wenBen1, wenBen2, wenBen3
    local jiangLi1 = {}
    local cfg = _G.ConfigManager.adventure_cfg
    local questions = _G.ConfigManager.questions_cfg
    wenBen1 = cfg[self.eventSid].desc
    if self.ZhuangTai == 1 then
        wenBen2 = JiangLi
        wenBen3 = DangQian
        local jiangLi = self.model:GetAwardData()
        jiangLi1 = jiangLi.award
        self.go_table.obj_Content6:SetActiveE(1)
        self.go_table.obj_Content7:SetActiveE(0)
    else
        self.go_table.obj_Content6:SetActiveE(0)
        self.go_table.obj_Content7:SetActiveE(1)
        for key, value in pairs(self.Data.args) do
            _G.table.insert(jiangLi1, questions[value].reward_right)
        end
        -- jiangLi1 = cfg[self.eventSid].rewards
        wenBen2 = yulan
        wenBen3 = zuigao
    end
    self.go_table.aortext_question_desdawan.text = _G.LangUtil.GetLangPackValue(wenBen1)
    self.go_table.aortext_baifenbi.text = _G.LangUtil.GetLangPackValue(wenBen2)
    self.go_table.aortext_question_BiaoTi.text = _G.LangUtil.GetLangPackValue(wenBen3)

    for key, value in pairs(jiangLi1) do
        local data = value[1]
        if data == nil then
            return
        end
        local headTrans = self.go_table.obj_Content7
        if self.ZhuangTai == 1 then
            headTrans = self.go_table.obj_Content6
            self:ResItem(data.type, headTrans)
        else
            self:ResItem(data, headTrans)
        end
    end
end
function Dungones_question_view:ResItem(data, obj)
    local id = obj:GetInstanceIDE()

    local notFight = require "DungonesModel":GetInstance().DungonesInfo.not_fight
    local scale = 1
    if self.ZhuangTai == 2 and notFight > 0 then
        scale = scale + notFight
    end
    local tb = obj
    _G.StorageManager:GetInstance():GetItemBaseView(
        data[1],
        data[2] * scale,
        tb,
        function(item)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            local data = require "DungonesModel":GetInstance().DungonesInfo
            require "PrivilegeManager":GetInstance():GetPrivilegeData({_G.PrivilegeType.Dungones.Coin, data.sid})
        end,
        function(go)
            self:OnBtnCallItem(go, data[1])
        end
    )
end
---点击掉落物品
function Dungones_question_view:OnBtnCallItem(go, itemid)
    require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, itemid)
end
