-- region 点击事件

function Dungones_question_view:EnterNextOnClick()
    -- if self.select == 0 then
    --     _G.FloatTipsModel:GetInstance():Show("请选择答案")
    --     return
    -- end
    local cfg = self.cfg[self.sids[self.curretSid]]
    local resoult = cfg.right
    if self.select == resoult then
        self.model:SetHitRate_question(1)
    else
        self.model:SetHitCuo_question(1)
    end
    self.go_table.aortext_question_Da.text =
        _G.string.format(
        _G.LangUtil.GetLangPackValue(DaTi),
        self.model:GetHitRate_question(),
        self.curretSid - self.model:GetHitRate_question()
    )

    self.curretSid = self.curretSid + 1
    self.go_table.aortext_question_Ci.text = _G.string.format(_G.LangUtil.GetLangPackValue(one), self.curretSid)

    _G.table.insert(self.select_tb, self.select)
    -- 是不是 最后一个问题
    if self.curretSid > #self.sids then
        self:SendData()
    else
        self.select = 0
        self:SetQuestion_Des()
        self:UpDataQuestion()
    end
end
------结束答题
---@param pbData c2s_roguelike_adventure 向服务器发送的数据
---@field sid number 奇遇事件的id
---@field args table  答题{问题，答案}
function Dungones_question_view:SendData(pbData)
    local DungonesModel = require("DungonesModel"):GetInstance()
    if DungonesModel.DungonesInfo.section == 0 then
        local pbData = {}
        pbData.sid = self.Data.section_sid
        pbData.eid = self.eventSid
        pbData.args = self.select_tb
        require "DungonesModel":GetInstance():AdventureTop(
            pbData,
            function()
                local award = self.model:GetAwardData()
                if _G.table.isEmptyOrNil(award) then
                    --("....没有奖励：")
                else
                    -- 弹出奖励界面
                end
                -- 打开结束界面
                _G.GameUtil.SetActiveByCondition(self.go_table.obj_View_question, false)
                _G.GameUtil.SetActiveByCondition(self.go_table.obj_view_resoult, true)
                self:SetHitRate_resoult()
            end
        )
    else
        local pbData = {}
        pbData.sid = self.eventSid
        pbData.args = self.select_tb
        require("DungonesModel"):GetInstance():Adventure(
            pbData,
            function(data)
                local award = self.model:GetAwardData()
                if _G.table.isEmptyOrNil(award) then
                    --("....没有奖励：")
                else
                    -- 弹出奖励界面
                end
                -- 打开结束界面
                _G.GameUtil.SetActiveByCondition(self.go_table.obj_View_question, false)
                _G.GameUtil.SetActiveByCondition(self.go_table.obj_view_resoult, true)
                self:SetHitRate_resoult()
            end
        )
    end
end
---获得奖励
function Dungones_question_view:ResoultOnClick()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, self.model:GetAwardData())

    self:Close()
    _G.Events:GetInstance():Broadcast(_G.DungonesPlayState.DungonesEnd)
end
