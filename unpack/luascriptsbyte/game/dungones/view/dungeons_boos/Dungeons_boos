---按钮点击事件在这里派发
function Dungeons_boos:OnClickBtn(go, IsOn)
    if _G.AppSetting.DEBUG then
        _G.Log(go, "点击千机按钮事件")
    end
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_closeview then
        self:Close()
    elseif go == self.go_table.aorbtn_close_tips then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_PropTipView, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_close_tips, false)
    elseif go == self.go_table.aorbtn_privilege then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_PropTipView, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_close_tips, true)
        self:showTipsPrivelge()
    elseif go == self.go_table.aorbtn_tiaozhan then
        -- local num = self.model:GetChallengeBossNum()
        -- if num <= 0 then
        --     _G.PopWindowManager:GetInstance():ShowAllTips(610101)
        --     return
        -- end
        local secid = self.data.section_sid
        local id = require("DungonesModel"):GetInstance().DungonesInfo.sid
        if id <= 0 then
            ---@type roguelike.c2s_roguelike_choose
            local msg = {}
            msg.sid = secid
            require "DungonesNet":GetInstance():ChooseAdventure(
                msg,
                function(data)
                    if data.ack == 1 then
                        require("DungonesModel"):GetInstance().DungonesInfo.sid = secid
                        if data.adventures then
                            require("DungonesModel"):GetInstance():DisposalDateAdventure(data.adventures)
                        end
                        self:Fight()
                    end
                end
            )
        else
            self:Fight()
        end
    end
end

function Dungeons_boos:Fight()
    if _G.MainManager:GetInstance():IsFighting(true) then 
        return
    end
    --是否满足跳过战斗开启条件
    local showSkipBattle = self:IsShowSkipBattle()

    require("DungonesManager"):GetInstance():StartDungonesEndBoss(self.data, showSkipBattle)
end

---刷新跳过战斗状态
---@return void
function Dungeons_boos:RefreshSkipBattleState()
    --读取解锁配置并显示文本
    local params = _G.ConfigManager.discrete_cfg[115604]
    if not params then
        self.go_table.obj_skipBg:SetActiveE(0)
        return
    end
    local ok, content = require("DungonesModel"):GetInstance():CheckEndBossCanSkip()
    if ok then
        self.go_table.obj_skipBg:SetActiveE(0)
        return
    end
    if content then
        self.go_table.aortext_skipTip.text = content
    end
    self.go_table.obj_skipBg:SetActiveE(content and 1 or 0)
end
---是否显示跳过战斗按钮
---@return boolean
function Dungeons_boos:IsShowSkipBattle()
    local params = _G.ConfigManager.discrete_cfg[115604]
    if not params then
        return false
    end
    return require("DungonesModel"):GetInstance():CheckEndBossCanSkip()
end

