---藏品设置
function Dungeons_boos:SetCollection()
    --藏品id，仅一位
    local cid = _G.ConfigManager.discrete_cfg[103406][1][1]
    local isLock = require "CollectionModel":GetInstance():CheckIsLock(cid)
    ---@type collection_cfg
    local cfg = _G.ConfigManager.collection_cfg[cid]
    if cfg.is_display == 0 then
        self.go_table.obj_collection:SetActiveE(0)
        return
    else
        self.go_table.obj_collection:SetActiveE(1)
    end
    local iconImage = cfg.icon
    local name = _G.LangUtil.GetLangPackValue(cfg.name)
    local data = require "PrivilegeManager":GetInstance():GetPrivilegeDataNew({_G.PrivilegeType.Dungones.Damages})
    local index = 1
    local value = 0
    if not _G.table.isEmptyOrNil(data) then
        for i = 1, #cfg.privilege do
            ---@type privilege_cfg
            local privilege_cfg = _G.ConfigManager.privilege_cfg[cfg.privilege[i]]
            value = privilege_cfg.privilege[1][#privilege_cfg.privilege[1]] + value
            if privilege_cfg and value == data[1][2] then
                index = i
                break
            end
        end
    end
    local des = _G.ConfigManager.discrete_cfg[103408][1][index]
    self.go_table.aorrawimage_collectionicon:LoadImage(
        iconImage,
        function(tran)
            tran:SetNativeSize()
            if isLock then
                tran:SetGray(false)
                self.go_table.aortext_isactivate.text = _G.LangUtil.GetLangPackValue(25400000103)
            else
                tran:SetGray(true)
                self.go_table.aortext_isactivate.text = _G.LangUtil.GetLangPackValue(25400000104)
            end
        end
    )
    self.go_table.aortext_iconname.text = name
    self.go_table.aortext_collectiondes.text = _G.LangUtil.GetLangPackValue(des)
end

---初始化伤害加成
function Dungeons_boos:InitDamagesAdd()
    local data = require "PrivilegeManager":GetInstance():GetPrivilegeData({_G.PrivilegeType.Dungones.Damages})
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_privilege, not _G.table.isEmptyOrNil(data))
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_privilege, not _G.table.isEmptyOrNil(data))
    if _G.table.isEmptyOrNil(data) then
        self.go_table.aortext_add.text = "0%"
    else
        self.go_table.aortext_add.text = "" .. _G.math.floor(data[1] / 100) .. "%"
    end
end
