---设置boss技能
function Dungeons_boos:SetBossSkill()
    local cfg = _G.ConfigManager.guild_boss_cfg
    local skills = cfg[2].skill
    local node = self.go_table.obj_skill_node
    local card_skillCfg = _G.ConfigManager.card_skills_cfg
    for i = 1, 3 do
        local skillid = skills[i]
        local icon = card_skillCfg[skillid].icon
        self.go_table["aorrawimage_skill_" .. i]:LoadImage(icon)
        _G.SetEventTrigger(
            node:GetChildE(i - 1),
            "onClick",
            _G.handlerbind(self, self.TipsAttributeBtnOnClick, skillid)
        )
    end
end
function Dungeons_boos:TipsAttributeBtnOnClick(go, eventData, skillid)
    require "CommonTipManager":GetInstance():OpenSkillTip(skillid)
end
---设置boss的 对属性的伤害
function Dungeons_boos:SetBossAttSkill()
    local skills = self.data.args
    local card_skillCfg = _G.ConfigManager.card_skills_cfg
    for i = 1, #skills do
        local tb = _G.GetAutoGoTable(self.attSkill[i])
        local skilid = skills[i]
        local nameid = card_skillCfg[skilid].describe1
        tb.aortext_desc.text = GetLangPackValue(nameid)
        nameid = card_skillCfg[skilid].name1
        tb.aortext_name.text = GetLangPackValue(nameid)
        local icon = card_skillCfg[skilid].icon
        tb.aorrawimage_icon:LoadImage(icon)
    end
end
