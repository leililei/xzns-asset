---设置boss奖励
function Dungeons_boos:SetBossAward()
    local bossid = _G.ConfigManager.discrete_cfg[103404][1][1]
    local node = self.go_table.obj_rewardNode
    local cfg = _G.ConfigManager.adventure_cfg
    local rewards = cfg[bossid].rewards

    local cou = #rewards
    if self.go_table.obj_rewardNode:GetChildCountE() > 0 then
        for i = 1, self.go_table.obj_rewardNode:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_rewardNode:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    local notFight = require "DungonesModel":GetInstance().DungonesInfo.not_fight
    local scale = 1
    if notFight > 0 then
        scale = scale + notFight
    end
    local createItem, count = nil, 1
    createItem = function()
        _G.StorageManager:GetInstance():GetItemBaseView(
            rewards[count][1],
            rewards[count][2] * scale,
            self.go_table.obj_rewardNode,
            function(itemObj)
                local data =
                    require "PrivilegeManager":GetInstance():GetPrivilegeData(
                    {_G.PrivilegeType.Dungones.Coin, rewards[count][1]}
                )
                if not _G.table.isEmptyOrNil(data) then
                    _G.PoolsManager:GetInstance():Spawn(
                        "UIH5/Dungones/@_obj_add",
                        _G.ePoolType.Temporary,
                        itemObj.go_table.transform,
                        function(trans)
                            trans:SetAnchorPosition(0, 0)
                        end
                    )
                end
                count = count + 1
                itemObj.gameObject:SetLocalScaleXYZ(0.87)
                itemObj:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                if count <= #rewards then
                    createItem()
                end
            end,
            function(go)
                local sid = go.sid
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, sid)
            end
        )
    end
    createItem()
end
