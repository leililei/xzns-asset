    require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, itemid)
end

---设置boss技能
function DungonesView:SetBossSkill()
    local cfg = _G.ConfigManager.guild_boss_cfg
    local skills = cfg[2].skill
    local node = self.go_table.obj_skill_node
    local card_skillCfg = _G.ConfigManager.card_skills_cfg
    for i = 1, 3 do
        local skillid = skills[i]
        local icon = card_skillCfg[skillid].icon
        local childNode = node:GetChildE(i - 1)
        local rowimage = childNode:GetComponentE(_G.typeof(_G.CS.AorRawImage))
        rowimage:LoadImage(icon)
        _G.SetEventTrigger(
                node:GetChildE(i - 1),
                "onClick",
                _G.handlerbind(self, self.TipsAttributeBtnOnClick, skillid)
        )
    end
end

function DungonesView:TipsAttributeBtnOnClick(go, eventData, skillid)
    require "CommonTipManager":GetInstance():OpenSkillTip(skillid, nil, nil, false, go)
end

---更新按钮
function DungonesView:UpDateToggle(index, isOn)
    if index > self.Difficulty and isOn then
        return
    end
    local tb = self.Toggles[index]
    if not tb then
        return
    end
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOff, not isOn)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, isOn)
    _G.GameUtil.SetActiveByCondition(tb.obj_suo, not isOn)
    _G.GameUtil.SetActiveByCondition(tb.aortext_desc, not isOn)
    if tb.islock then
        tb.aortext_desc.text = GetLangPackValue(90022500410)
    end
end

---销毁对象时,析构函数
function DungonesView:OnDestroy()
    if nil ~= self.ResetTime then
        self.ResetTime:Stop()
        self.ResetTime = nil
    end
end

return DungonesView
