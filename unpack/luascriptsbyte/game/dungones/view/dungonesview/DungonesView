---视频切换到 界面 ，淡入淡出
function DungonesView:VideoCutUiView()
    local showTime = 1
    local colorRgb = nil
    colorRgb = { 0 / 255, 0 / 255, 0 / 255, 1 }
    self.BalckMaskView.go_table.aorrawimage_curtain.color = _G.Color.New(colorRgb[1], colorRgb[2], colorRgb[3], colorRgb[4])
    if self.TweenerIng ~= nil then
        self.TweenerIng:Kill(true)
        self.TweenerIng = nil
    end
    self.TweenerIng = self.BalckMaskView.go_table.aorrawimage_curtain:DOFade(0, showTime)
    self.TweenerIng:SetEase(_G.CS.DG.Tweening.Ease.InQuad)
    self.TweenerIng.onComplete = _G.handler(
            self,
            function()
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BlackCurtainView.Name)
                self.TweenerIng:Kill(true)
            end
    )
end

function DungonesView:InitToggle()
    local check = function(o)
        o:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
        if self:IsNil() then
            RemoveEffect(o)
        end
    end

    self.Toggles = {}
    for i = 1, 3 do
        self.Toggles[i] = _G.GetAutoGoTable(self.go_table["obj_" .. i], _G.handlerbind(self, self.OnClickToggle, i))
        _G.GameUtil.SetActiveByCondition(self.Toggles[i].obj_suo, i > self.Difficulty)
        local cfg = _G.ConfigManager.discrete_cfg[103405][difficulty[i]]
        self.Toggles[i].lockStr, self.Toggles[i].tips = _G.FunctionManager:GetInstance():GetStrWithType(cfg[1], cfg[2])
        self.Toggles[i].aortext_desc.text = self.Toggles[i].lockStr
        if cfg[1] == 4 then
            local cfg2 = _G.ConfigManager.afk_cfg[cfg[2]]
            if cfg2 then
                self.Toggles[i].aortext_desc.text = GetLangPackValue(90022900050, cfg2.chapter, cfg2.section)
            end
        end
        ---判断功能是否解锁
        self.Toggles[i].islock = false
        if _G.GlobalConditionManager.CheckCondition(cfg[1], cfg[2]) then
            self.Toggles[i].islock = true
            self.Toggles[i].aortext_desc.text = GetLangPackValue(90022500410)
            self.Toggles[i].aortext_desc:SetActiveE(0)
            _G.GameUtil.SetActiveByCondition(self.Toggles[i].obj_suo, false)
        else
            _G.GameUtil.SetActiveByCondition(self.Toggles[i].obj_suo, true)
        end
        if require "DungonesModel":GetInstance().DungonesInfo.difficulty > 0 then
            self.Toggles[i].aortext_desc:SetActiveE(1)
            _G.GameUtil.SetActiveByCondition(self.Toggles[i].obj_suo, true)
        else
            if i ~= self.curDifficulty and i <= self.Difficulty then
                if _G.PlayerPrefsManager.GetInt(PrefsKey .. i, 0) == 0 then
                    _G.PlayerPrefsManager.SetInt(PrefsKey .. i, 1)
                    if self.Toggles[i].obj_eff:GetChildCountE() > 0 then
                        self.Toggles[i].obj_eff:SetActiveE(0)
                        self.Toggles[i].obj_eff:SetActiveE(1)
                        -- else
                        --     _G.UIUtils.LoadEffectByCfg(
                        --         _G.ConfigManager.ui_effect_cfg.ef_fubentongyongjiesuo,
                        --         self.Toggles[i].obj_eff,
                        --         check
                        --     )
                    end
                    self.Toggles[i].aortext_desc:SetActiveE(1)
                    self.Toggles[i].obj_suo:SetActiveE(0)
                    self.Toggles[i].aortext_desc.text = GetLangPackValue(90022900062)
                    _G.DelayDo(
                            1.41,
                            function()
                                if self.Toggles then
                                    self.Toggles[i].aortext_desc:SetActiveE(0)
                                end
                            end
                    )
                end
            end
        end
    end
end

function DungonesView:OnClickToggle(go, isOn, index)
    if go == self.Toggles[index].aorbtn_click then
        if index <= self.Difficulty then
            if require "DungonesModel":GetInstance().DungonesInfo.difficulty == 0 then
                self.curDifficulty = index
                _G.GameUtil.SetActiveByCondition(self.Toggles[index].aorimage_isOn, true)
                _G.GameUtil.SetActiveByCondition(self.Toggles[index].aorimage_isOff, false)
            end
        else
            if self.Toggles[index].islock then
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(self.Toggles[index].tips, self.Toggles[index].lockStr)
            end
        end
    end
    if require "DungonesModel":GetInstance().DungonesInfo.difficulty > 0 then
        return
    end
    for i = 1, 3 do
        if i ~= self.curDifficulty then
            --self:UpDateToggle(i, false)
            local tb = self.Toggles[i]
            _G.GameUtil.SetActiveByCondition(tb.aorimage_isOff, true)
            _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, false)
            -- if self.Toggles[i].islock and i < self.curDifficulty then
            --     _G.GameUtil.SetActiveByCondition(tb.obj_suo, false)
            -- else
            --     _G.GameUtil.SetActiveByCondition(tb.obj_suo, true)
            -- end
        end
    end
end

function DungonesView:UpdateDisplay()
    local DungonesModel = require "DungonesModel":GetInstance()

    if _G.AppSetting.DEBUG then
        _G.Log(DungonesModel.DungonesInfo.next_reset_time, "服务千机重置时间")
    end

    if _G.AppSetting.DEBUG then
        _G.Log(_G.TimeUtil.GetServerUnixTime(), "当前服务器时间")
    end
    self.StartTime = DungonesModel.DungonesInfo.next_reset_time - _G.TimeUtil.GetServerUnixTime()
    self:OnDelaySecond()
    if table.isEmptyOrNil(self.ResetTime) then
        self.ResetTime = _G.TimerManager:GetInstance():GetTimer(1, self.OnDelaySecond, self, false)
        self.ResetTime:Start()
    end
    local data = require "DungonesModel":GetInstance():GetMySelfRank()
    local rank = data.player_mingci ~= 0 and data.player_mingci or _G.GetLangPackValue(90022900040)
    self.go_table.aortext_Damage.text = _G.GetLangPackValue(90022500606) .. _G.GameUtil.NumberToUnitStrBag(data.Damage)
    self.go_table.aortext_Rank.text = _G.GetLangPackValue(90024500012) .. ":" .. rank
end

---倒计时
function DungonesView:OnDelaySecond(elapsed)
    self.StartTime = self.StartTime - (elapsed or 1)
    if self.StartTime <= 0 then
        require("DungonesModel"):GetInstance().isTime = true
        self.StartTime = 0
        if not table.isEmptyOrNil(self.ResetTime) then
            self.ResetTime:Stop()
            self.ResetTime = nil
        end
        self.go_table.aortext_DownTime.text = _G.LangUtil.GetLangPackValue(90011611104)
    else
        self.go_table.aortext_DownTime.text = _G.LangUtil.TryGetLangValue(90000010101) .. ":" .. _G.TimeUtil.DungonesForStr(Mathf.RoundToInt(self.StartTime))
    end
end

