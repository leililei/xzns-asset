---初始化累计数
function DungonesView:InitAccumulative()
    local num = require "DungonesModel":GetInstance().DungonesInfo.not_fight
    if not _G.IsNil(num) then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_label, num > 0)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_label, false)
    end

    if num then
        self.go_table.aortext_num.text = GetLangPackValue(90000010102, num * 100)
    end
end

function DungonesView:CollectCallback()
    local pri_diff = require "DungonesModel":GetInstance().DungonesInfo.difficulty
    local maxDiff = 0
    for key, value in pairs(_G.ConfigManager.discrete_cfg[103405]) do
        if _G.GlobalConditionManager.CheckCondition(value[1], value[2]) and maxDiff < key then
            maxDiff = key
        end
    end
    if pri_diff then
        if pri_diff == 0 then
            self.Difficulty = maxDiff
        else
            self.Difficulty = pri_diff
        end
    else
        self.Difficulty = maxDiff
    end
    self:InitToggle()
    -- 1、默认给玩家选取最新解锁的难度
    self.curDifficulty = self.Difficulty
    if self.Difficulty == 0 then
        self.curDifficulty = 1
    end
    _G.GameUtil.SetActiveByCondition(self.Toggles[self.curDifficulty].aorimage_isOn, true)
    _G.GameUtil.SetActiveByCondition(self.Toggles[self.curDifficulty].aorimage_isOff, false)
    -- self.Toggles[self.curDifficulty]["obj_" .. self.curDifficulty].isOn = false
    -- self.Toggles[self.curDifficulty]["obj_" .. self.curDifficulty].isOn = true
end

---主要界面点击事件
function DungonesView:OnClickBtn(go, IsOn)
    if _G.AppSetting.DEBUG then
        _G.Log(go, "点击千机按钮事件")
    end
    if go == self.go_table.aorbtn_CloseView then
        -- local aidCards = require "DungonesModel":GetInstance().DungonesInfo.aid_cards
        -- if aidCards then
        --     for i = 1, #aidCards do
        --         _G.StorageManager:GetInstance():RemoveDatasBySid(_G.StorageID.Card, aidCards[i].uid)
        --     end
        -- end
        require("DungonesModel"):GetInstance():ClealAidCardEquip()
        require("DungonesModel"):GetInstance():NotificationChangePointHint()
        TrackingPointModel:GetInstance():CloseActTracking(self.viewName)
        self:Close()
    elseif go == self.go_table.aorbtn_Rank then
        local msg = {}
        msg.type = 8
        require("DungonesModel"):GetInstance():GetRanKInfo(
                msg,
                function(data)
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.Dungeons_boos_rank.Name, data)
                end
        )
    elseif go == self.go_table.aorbtn_Shop then
        require "ShopModel":GetInstance():OpenShop(_G.ShopID.Dungones)
    elseif go == self.go_table.aorbtn_Card then
        ---卡牌
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DungonesBagView.Name)
    elseif go == self.go_table.aorbtn_Relic then
        -- elseif go == self.go_table.aorbtn_Collection then
        --     ---藏品
        --     _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DungonesCollectionBagView.Name)
        ---遗物
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DungonesRelicView.Name)
    elseif go == self.go_table.aorbtn_tiaozhantips then
        --额外次数tips
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 34)
    elseif go == self.go_table.aorbtn_FightStart then
        ---进入场景
        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.Dungeons_boos.Name, nil)

        local DungonesModel = require "DungonesModel":GetInstance()
        if DungonesModel.DungonesInfo.status == 2 or self.StartTime <= 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(1710)
            return
        end
        if DungonesModel.DungonesInfo.difficulty > 0 then
            require "DungonesManager":GetInstance():EnterDungones()
        elseif self.Difficulty > 0 then
            --2、如果玩家在默认选择高难度关卡，却手动选择低难度关卡开始挑战时，会弹出tips提示挑战后难度无法更改
            if self.curDifficulty < self.Difficulty then
                _G.PopWindowManager:GetInstance():ShowAllTips(
                        610301,
                        nil,
                        function()
                            require "DungonesManager":GetInstance():OnChallenge(self.curDifficulty)
                            for i = 1, 3 do
                                if i ~= self.curDifficulty then
                                    self:UpDateToggle(i, false)
                                end
                            end
                        end,
                        function()
                        end,
                        nil,
                        nil,
                        GetLangPackValue(name[self.curDifficulty])
                )
            else
                require "DungonesManager":GetInstance():OnChallenge(self.curDifficulty)
                for i = 1, 3 do
                    if i ~= self.curDifficulty then
                        self:UpDateToggle(i, false)
                    end
                end
            end
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(self.Toggles[1].tips, self.Toggles[1].lockStr)
        end
    elseif go == self.go_table.aorbtn_help then
        ---打开玩法说明页面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 34)
    end
end

