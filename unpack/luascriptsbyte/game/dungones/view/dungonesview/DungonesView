function DungonesView:CollectionUnLockCall()
    self:ShowUnLockViewCallback()
end

function DungonesView:ShowUnLockView(sid)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DungonesCollectioUpView.Name)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DungonesCollectioUnLockView.Name)
    if sid % 100 > 1 then
        _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.DungonesCollectioUpView.Name,
                sid,
                _G.handler(self, self.ShowUnLockViewCallback)
        )
    else
        _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.DungonesCollectioUnLockView.Name,
                sid,
                _G.handler(self, self.ShowUnLockViewCallback)
        )
    end
end

function DungonesView:ShowUnLockViewCallback()
    if table.isEmptyOrNil(self.sidQue) then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DungonesCollectioUpView.Name)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DungonesCollectioUnLockView.Name)
        return
    end
    local sid = table.remove(self.sidQue, 1)
    if require "DungonesModel":GetInstance():CheckCollectionIsUnLock(sid) then
        self:ShowUnLockView(sid)
    else
        self:ShowUnLockViewCallback()
    end
end

---展示boss 掉落奖励
function DungonesView:ShowBossDiaoLuoReaward()
    local cfg = _G.ConfigManager.adventure_cfg
    local boosid = _G.ConfigManager.discrete_cfg[103404][1][1]
    self.rewards = cfg[boosid].rewards
    local count = #self.rewards
    if self.rewardsMaterial == nil then
        self.go_table.scrollloophorizontal_diaoluo:InitItemData(count, _G.handler(self, self.ResItem))
        self.rewardsMaterial = self.go_table.scrollloophorizontal_diaoluo
    end
end

function DungonesView:ResItem(index, obj)
    if index < 0 then
        return
    end
    local id = obj:GetInstanceIDE()
    local data = self.rewards[index + 1]
    obj:SetName(id .. "_" .. data[1])
    local tb = _G.GetAutoGoTable(obj)
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
            data,
            tb.obj_Node,
            function(item)
                item:SetPri(not table.isEmptyOrNil(self.Pri[data[1]]))
                --item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end,
            function(go)
                self:OnBtnCallItem(go, data[1])
            end
    )
end

