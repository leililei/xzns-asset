---界面的入口函数
function DungonesCollectionBagView:OnCreate()
    self.ItemList = {}
    self.index = 1
    self:InitData()
    self.desnode = {
        self.go_table.aortext_des1,
        self.go_table.aortext_des2,
        self.go_table.aortext_des3
    }
    self.go_table.scrollloopvectical_ItemList:InitItemData(#self.sidList, _G.handler(self, self.RefreshList))

    self:UpdatePanel()
end

function DungonesCollectionBagView:IniteCfg()
    local cfg = _G.ConfigManager.dungeons_item_cfg
    local list = {}
    for key, value in pairs(cfg) do
        if _G.table.isEmptyOrNil(list[value.group]) then
            list[value.group] = {}
            list[value.group].group = value.group
        end
        _G.table.insert(list[value.group], value.id)
    end
    -- 中间有断层
    local da = {}
    for _, val in pairs(list) do
        _G.table.insert(da, val)
    end
    SortList(
        da,
        function(d)
            return -d.group
        end
    )
    return da
end
