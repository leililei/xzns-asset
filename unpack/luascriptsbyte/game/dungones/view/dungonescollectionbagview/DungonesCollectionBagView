---查找最大的id （解锁的）
function DungonesCollectionBagView:CheckMaxLevel(index)
    local sids = self.sidList[index]
    local temp = {}
    local id = 0
    for i = 1, #sids do
        local unLockA = require "DungonesModel":GetInstance():CheckCollectionIsUnLock(sids[i])
        if unLockA then
            _G.table.insert(temp, sids[i])
        end
    end
    _G.table.sort(
        temp,
        function(a, b)
            return a > b
        end
    )
    if _G.table.isEmptyOrNil(temp) then
        id = sids[1]
    else
        id = temp[1]
    end
    return id
end

---刷新列表
function DungonesCollectionBagView:RefreshList(index, obj)
    if index < 0 then
        return
    end
    local instanceID = obj:GetInstanceIDE()
    local tb = self.ItemList[instanceID]
    local id = self:CheckMaxLevel(index + 1)
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickItem, tb, id))
    end
    tb.index = index + 1

    local cfg = _G.ConfigManager.dungeons_item_cfg[id]
    tb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.DungonesCollectionBagView.id, cfg.id)
    if cfg then
        tb.aorrawimage_Icon:LoadImage(cfg.icon)
        tb.aortext_name.text = GetLangPackValue(cfg.name) .. "  " .. GetLangPackValue(90020600039, cfg.level)
        tb.aortext_content.text = GetLangPackValue(cfg.desc)
    end
    _G.GameUtil.SetActiveByCondition(tb.obj_choose, tb.index == self.index)
end
---点击藏品
---@param id number 藏品id
function DungonesCollectionBagView:OnClickItem(go, isOn, tb, id)
    local index = self.index
    self.index = tb.index
    self.go_table.scrollloopvectical_ItemList:UpdateItemSingle(index - 1)
    self.go_table.scrollloopvectical_ItemList:UpdateItemSingle(tb.index - 1)
    local key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "Collection" .. id
    ---检测下 藏品是否解锁
    local unlock = require "DungonesModel":GetInstance():CheckCollectionIsUnLock(id)
    if unlock then
        if not _G.CS.WechatGameCore.PlayerPrefs.HasKey(key) then
            _G.CS.WechatGameCore.PlayerPrefs.SetInt(key, 0)
        end
    end
    ---设置下相同组的  其他藏品的id（没有点击 1级的藏品，但是已不在显示，红点会常在）
    local sids = self.sidList[self.index]
    for i = 1, #sids - 1 do
        if sids[i] < id then
            key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "Collection" .. sids[i]
            if not _G.CS.WechatGameCore.PlayerPrefs.HasKey(key) then
                _G.CS.WechatGameCore.PlayerPrefs.SetInt(key, 0)
            end
        end
    end
    self:UpdatePanel()
    --刷新 藏品红点
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(
        _G.ConfigManager.redpoint_cfg.DungonesCollectionBagView.id
    )
end
