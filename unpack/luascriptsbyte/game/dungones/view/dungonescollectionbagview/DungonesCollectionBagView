    local id = self:CheckMaxLevel(self.index)
    local cfg = _G.ConfigManager.dungeons_item_cfg[id]
    self.go_table.aortext_name.text = GetLangPackValue(cfg.name)
    self.go_table.aorrawimage_Icon:LoadImage(cfg.icon)
    local flag = true
    for i = 1, count do
        id = self.sidList[self.index][i]
        cfg = _G.ConfigManager.dungeons_item_cfg[id]
        local isLock = require "DungonesModel":GetInstance():CheckCollectionIsUnLock(cfg.id)
        local level = cfg.level
        local des = GetLangPackValue(cfg.desc)
        local str = ""
        if not isLock then
            local str1 = _G.FunctionManager:GetInstance():GetStrWithType(cfg.mission_extra[1], cfg.mission_extra[2])
            str =
                "<color=#686989>" ..
                GetLangPackValue(90020600039, level) .. "：" .. des .. "</color>。" .. "<color=#b23939>(" .. str1 .. ")</color>"
            flag = false
            if i > 1 then
                id = self.sidList[self.index][i - 1]
                cfg = _G.ConfigManager.dungeons_item_cfg[id]
                local isLock1 = require "DungonesModel":GetInstance():CheckCollectionIsUnLock(cfg.id)
                if not isLock1 then
                    str = "<color=#686989>" .. GetLangPackValue(90020600039, level) .. "：" .. des .. "</color>。"
                end
            end
        else
            str = "<color=#14874a>" .. GetLangPackValue(90020600039, level) .. "：" .. des .. "</color>"
        end
        self.desnode[i].text = str
    end

