function Dungeons_boos_rank:InitToggle()
    self.Toggles = {}
    self.Toggles["Rank"] = _G.GetAutoGoTable(
        self.go_table.toggle_rank,
        _G.handlerbind(self, self.OnToggle, "Rank", _G.handler(self, self.OnRank))
    )
    self.Toggles["Reward"] = _G.GetAutoGoTable(
        self.go_table.toggle_reward,
        _G.handlerbind(self, self.OnToggle, "Reward", _G.handler(self, self.OnReward))
    )
    self.go_table.toggle_zoneRank:SetActiveE(0)
    self:OnRank(true)
    local tb = self.Toggles["Rank"]
    tb.aorimage_isOff:SetActiveE(0)
    tb.aorimage_isOn:SetActiveE(1)
end

---点击Togggle
function Dungeons_boos_rank:OnToggle(go, isOn, key, call)
    local tb = self.Toggles[key]
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOff, not isOn)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, isOn)
    if call then
        call(isOn)
    end
end

