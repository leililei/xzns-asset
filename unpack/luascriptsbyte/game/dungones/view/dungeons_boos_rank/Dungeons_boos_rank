function Dungeons_boos_rank:GetRankData(index)
    if index <= 0 then
        return
    end
    for _, v in ipairs(self.RewardDatas) do
        if index >= v.min_rank and index <= v.max_rank then
            return v
        end
    end
    return nil
end

---显示玩家排行
function Dungeons_boos_rank:InitPlayer()
    self.playerRank = self.model:GetMySelfRank()
    if not self.player then
        self.player = _G.GetAutoGoTable(
            self.Rank.obj_player,
            _G.handlerbind(self, self.HeadClick, { rankData = { uid = _G.PlayerModel:GetInstance():GetPlayerUid() } })
        )
        -- self.player.scrollloophorizontal_AwardList:InitItemData(
        --     0,
        --     _G.handlerbind(self, self.RefreshReward, self.rewardList_Rank, self.player)
        -- )
    end
    local tb = self.player
    local newindex = self.playerRank.player_mingci
    tb.data = self:GetRankData(newindex)
    if newindex == 0 then
        tb.aortext_rankNum.text = GetLangPackValue(90022900040)
    else
        tb.aortext_rankNum.text = newindex
    end
    --tb.aortext_name.text = _G.PlayerModel:GetInstance():GetName()
    if newindex == 0 then
        tb.aorimage_rankBg:SetActiveE(0)
        tb.obj_rankNum:SetActiveE(1)
        tb.aortext_rankNum.text = GetLangPackValue(90022500400)
    elseif newindex <= 3 then
        tb.aorimage_rankBg:SetActiveE(1)
        tb.obj_rankNum:SetActiveE(0)
        tb.aorimage_rankBg.SpriteName = rankIconDic[newindex]
        tb.aortext_rank.text = newindex
        self:SetGradient(tb.aortext_rank, newindex)
        tb.aorimage_Bg.SpriteName = "ui_di_diban" .. newindex
        tb.aorimage_Bg:SetRectTransformSize(682, 120)
    else
        tb.aorimage_rankBg:SetActiveE(0)
        tb.obj_rankNum:SetActiveE(1)
        tb.aorimage_Bg.SpriteName = "TY_img_kuang"
        tb.aorimage_Bg:SetRectTransformSize(680, 118)
        tb.aortext_rankNum.text = newindex
    end
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, self.playerRank, 1, true, true, true)
    local damage = self.playerRank and self.playerRank.Damage or 0
    tb.aortext_damage.text = _G.GetLangPackValue(90029400153) .. _G.GameUtil.NumberToUnitStr(damage)
    if tb.data then
        self:ShowAward(tb, tb.obj_item, tb.data.reward_daily, tb.obj_item:GetChildE(0))
    else
        self:ShowAward(tb, tb.obj_item, {}, tb.obj_item:GetChildE(0))
    end
end

---显示前三
function Dungeons_boos_rank:InitTop()
    local rank = _G.GetAutoGoTable(self.go_table.obj_Rank)
    for i = 1, 3 do
        ---@type LingRankItemData
        local data = self.rankDatas[i]
        local tb = _G.GetAutoGoTable(rank["trans_rank" .. i])
        _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.DungonesRankItem .. i, tb)
        if data == nil then
            tb.obj_Score:SetActiveE(0)
            tb.obj_Power:SetActiveE(0)
            tb.aorrawimage_Empty:SetActiveE(1)
            tb.aortext_name.text = _G.GetLangPackValue(90000010159)
        else
            tb.obj_Score:SetActiveE(1)
            tb.obj_Power:SetActiveE(1)
            tb.aorrawimage_Empty:SetActiveE(0)
            tb.aortext_name.text = data.playerName
            tb.aortext_Score.text = _G.GameUtil.NumberToUnitStr(data.Damage)
            require("SystemSettingNet"):GetInstance():GetPlayerInfo(
                { uid = data.uid },
                function(msg)
                    if not msg.info then
                        return
                    end
                    tb.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(msg.info.power)
                    local cfg = require "CardCommentManager":GetInstance():CardData(msg.info.city_style_id, false)
                    local scale = cfg.size2
                    local pos = cfg.pos_portrait
                    tb.trans_role:ClearChildren()
                    local path = cfg.ModelPathHi
                    if _G.UIUtils.IsUseBattleSpine(_G.UseBattleSpine.RankView) then
                        path = _G.UIUtils.GetBattleSpine(cfg)
                        scale = cfg.size4
                        pos = { 0, 0, 0 }
                    end
                    _G.PoolsManager:GetInstance():Spawn(
                        path,
                        _G.ePoolType.Temporary,
                        nil,
                        function(trans)
                            if trans == nil then
                                if _G.AppSetting.DEBUG then
                                    _G.LogError("角色无法加载 path:" .. cfg.ModelPathHi .. "    CardInfoView LoadRoleScene")
                                end
                                return
                            end
                            if self:IsNil() then
                                _G.DestroyObject(trans)
                                return
                            end
                            trans:SetParentE(tb.trans_role)
                            trans:SetLocalPosition(pos[1], pos[2], pos[3])
                            trans:SetLocalScaleXYZ(scale)
                            local rolePoint = trans:GetComponentE(_G.typeof(_G.CS.RolePoint))
                            if rolePoint == nil then
                                rolePoint = trans:AddComponentE(_G.typeof(_G.CS.RolePoint))
                            end
                            --- 只有星座女神有神环
                            if _G.AppSetting.IsXzns then
                                local godHaloID = msg.info.god_halo
                                if godHaloID ~= 0 then
                                    local effCfg = _G.ConfigManager.god_halo_cfg[godHaloID].ui_effect_cfg
                                    --- 神环路径，父级路径(加载角色的下面)
                                    _G.UIUtils.LoadGodHalo(effCfg, trans, godHaloID)
                                end
                                if not table.isEmptyOrNil(msg.info.artifact_skin) then
                                    _G.UIUtils.LoadArtifacteffect(trans,nil,msg.info.artifact_skin[1],msg.info.artifact_skin[2])
                                end
                                local curLayout = self.go_table.transform:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
                                tb.trans_role:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder = curLayout + 10
                            end
                        end
                    )
                    self:UpdateTop3Title(tb, msg.info.title, i)
                end
            )
        end
    end
end

---生成称号
---@param item table
function Dungeons_boos_rank:UpdateTop3Title(tb, data, index)
    if data.sid == 0 then
        return
    end
    if self.curShowEffTitle == nil then
        self.curShowEffTitle = {}
    end
    local titleScale = _G.ConfigManager.discrete_cfg[100111] and _G.ConfigManager.discrete_cfg[100111][1][1] or 1
    local player_title = _G.ConfigManager.player_title_effect_cfg[data.sid]
    if player_title.type_title == 1 then
        tb.aorrawimage_title:LoadImage(player_title.title)
        tb.aorrawimage_title:SetActiveE(1)
        tb.aorrawimage_title:SetLocalScaleXYZ(0.29 * titleScale)
        tb.obj_titleEffect:RemoveAllChildren()
        self.curShowEffTitle[index] = nil
    elseif player_title.type_title == 2 then
        if self.curShowEffTitle[index] == nil or (self.curShowEffTitle[index] ~= nil and self.curShowEffTitle[index] ~= player_title.title) then
            tb.obj_titleEffect:RemoveAllChildren()
            self.curShowEffTitle[index] = player_title.title
            _G.UIUtils.LoadEffectTitleOrFrame(
                player_title.title,
                tb.obj_titleEffect,
                function(trans)
                    if self.curShowEffTitle[index] ~= player_title.title then
                        trans:DestroyObject()
                        return
                    end
                    local parClip = trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                    parClip.NeedCheck = true
                    parClip.CheckCount = 10
                    parClip.CheckOne = 3
                    trans:SetLocalScaleXYZ(titleScale)
                end
            )
        end
        tb.aorrawimage_title:SetActiveE(0)
    end
end

function Dungeons_boos_rank:SetGradient(obj, index)
    local gradient = obj:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient))
    -- local gradient = go
    local c1 = _G.ColorTools.FormatColorByString(Gradient[index][1])
    local c2 = _G.ColorTools.FormatColorByString(Gradient[index][2])
    local color1 = _G.CS.UnityEngine.GradientColorKey()
    local color2 = _G.CS.UnityEngine.GradientColorKey()
    color1.color = c1
    color1.time = 1
    color2.color = c2
    color2.time = 0

    local alpha1 = _G.CS.UnityEngine.GradientAlphaKey()
    local alpha2 = _G.CS.UnityEngine.GradientAlphaKey()

    alpha1.alpha = 255
    alpha1.time = 1
    alpha2.alpha = 255
    alpha2.time = 0

    gradient:GetGradient():SetKeys({ color1, color2 }, { alpha1, alpha2 })
end

---刷新奖励
function Dungeons_boos_rank:RefreshReward(index, obj, list, tb)
    local newIndex = index + 1
    local instanceID = obj:GetInstanceIDE()
    local data = tb.data.reward_daily[newIndex]
    local item = list[instanceID]
    if not item then
        item = require "BaseAwardNewItem".New(obj, _G.handler(self, self.OnClickAward), 73, obj)
        list[instanceID] = item
    end
    item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))
end

---奖励
function Dungeons_boos_rank:OnReward(isOn)
    self.go_table.aorrawimage_Bg:LoadImage("ImagesH5/hDungones/0_ui_bg_yjyzjiangli")
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Reward, isOn)
    if not isOn then
        return
    end
    if not self.ZoneRewardRank then
        _G.PoolsManager:GetInstance():Spawn(
            require "ZoneRankModel".GetRewardPrefabPath(),
            _G.ePoolType.Temporary,
            self.go_table.obj_Reward,
            function(trans)
                if self:IsNil() then
                    return
                end
                local view = self:AddComponent(trans.gameObject, require "ZoneRankRewardView".New(trans, self))
                view:InitView(_G.ZoneRankType.Dungones, nil, self.RewardDatas, GetLangPackValue(90024600030))
                self.ZoneRewardRank = view
            end
        )
    end
end

