---画线以及连到的节点
function DungonesRuningView:DrawOneLine(sid)
    local count = #self.ShowList
    local cfg = _G.ConfigManager.dungeons_cfg[sid]
    local cfg1 = self.ShowList[count - 1]
    local pos = self.CaPos[sid]
    local haveUnselectedMementon, unselectedInfo = DungonesModel:GetInstance():HaveUnselectedMementos()
    for i = 1, #cfg.after_section do
        local id = cfg.after_section[i]
        if self.Lines[id] then
            local posY = self.Lines[id].posY[1]
            local lineTran = self.Lines[id].line[1].transform

            local line = _G.InstantiateObject(self.go_table.obj_line, self.go_table.obj_lineParent)
            line:SetLocalPosition(pos.x, pos.y, 0)

            if i == 1 then
                line:SetEulerAngles(0, 0, 85)
            else
                line:SetEulerAngles(0, 0, 46)
            end
            if sid == cfg1.id and cfg1.layer ~= 3 then
                line:SetEulerAngles(0, 0, 60.5)
            end
            local lineGotable = _G.GetAutoGoTable(line)
            if _G.AppSetting.DEBUG then
                lineGotable.gameObject:SetName(sid .. ">>>" .. id)
            end
            local x, y, z = lineGotable.obj_endPoint:GetPosition()
            self.camera = _G.UIManager:GetInstance().UICamera
            local nx, ny = self.camera:WorldToScreenPointE(x, y, z)
            self.V2:Set(nx, ny)

            local _, outPos =
                self.Rtfuy.ScreenPointToLocalPointInRectangle(
                    self.ObjItem,
                    self.V2,
                    _G.UIManager:GetInstance().UICamera
                )

            self.Lines[id].item.transform:SetLocalPosition(outPos.x, outPos.y, 0)
            --self.Lines[id].item.aortext_info.text = "" -- id
            self.CaPos[id] = outPos

            if posY < outPos.y then
                lineTran:SetEulerAngles(0, 0, 85)
            else
                lineTran:SetEulerAngles(0, 0, 46)
            end

            table.insert(self.Lines[id].type, i)
            table.insert(self.Lines[id].line, lineGotable)
        else
            local line = _G.InstantiateObject(self.go_table.obj_line, self.go_table.obj_lineParent)
            line:SetLocalPosition(pos.x, pos.y, 0)

            if i == 1 then
                line:SetEulerAngles(0, 0, 85)
            else
                line:SetEulerAngles(0, 0, 46)
            end
            if sid == cfg1.id and cfg1.layer ~= 3 then
                line:SetEulerAngles(0, 0, 60.5)
            end
            local lineGotable = _G.GetAutoGoTable(line)
            if _G.AppSetting.DEBUG then
                lineGotable.gameObject:SetName(sid .. ">>>" .. id)
            end
            local x, y, z = lineGotable.obj_endPoint:GetPosition()
            self.camera = _G.UIManager:GetInstance().UICamera
            local nx, ny = self.camera:WorldToScreenPointE(x, y, z)
            self.V2:Set(nx, ny)

            local _, outPos =
                self.Rtfuy.ScreenPointToLocalPointInRectangle(
                    self.ObjItem,
                    self.V2,
                    _G.UIManager:GetInstance().UICamera
                )

            local item = _G.InstantiateObject(self.go_table.obj_itemDi, self.go_table.obj_itemParent)
            if i == count then
                --item:SetLocalPosition(out)
            else
                item:SetLocalPosition(outPos.x, outPos.y, 0)
            end
            local itemGotable = _G.GetAutoGoTable(item)
            --itemGotable.aortext_info.text = "" -- id
            if _G.AppSetting.DEBUG then
                itemGotable.gameObject:SetName("di>>>" .. id)
            end
            local itemInfo = _G.InstantiateObject(self.go_table.obj_item, itemGotable.transform)
            itemInfo:SetLocalPosition(0, 0, 0)
            local itemInfoGotable = _G.GetAutoGoTable(itemInfo, _G.handlerbind(self, self.ItemClick, id))
            -- UIUtils.IsNeedChangeUI(IsNeedChangeUI.DungonesRuningViewObj, itemInfoGotable)

            local info = DungonesModel:GetInstance():GetAdventureByLevel(id)
            local isChest = haveUnselectedMementon and id == DungonesModel:GetInstance().DungonesInfo.section
            if info then
                ---@type adventure_cfg
                local adv = _G.ConfigManager.adventure_cfg[info.sid]
                if isChest then
                    itemInfoGotable.aorrawimage_openIcon:LoadImage(
                        box,
                        function(image)
                            image:SetNativeSize()
                        end
                    )
                    itemInfoGotable.aorrawimage_missIcon:LoadImage(
                        box,
                        function(image)
                            image:SetNativeSize()
                        end
                    )
                    itemInfoGotable.aorimage_InfoBg:SetActiveE(0)
                else
                    itemInfoGotable.aorrawimage_openIcon:LoadImage(
                        adv.icon,
                        function(image)
                            image:SetNativeSize()
                        end
                    )
                    itemInfoGotable.aorrawimage_missIcon:LoadImage(
                        adv.icon,
                        function(image)
                            image:SetNativeSize()
                        end
                    )
                    if adv.name then
                        itemInfoGotable.aorimage_InfoBg:SetActiveE(1)
                        local lanId = _G.tonumber(adv.name)
                        itemInfoGotable.aortext_info.text = lanId and _G.GetLangPackValue(lanId) or ""
                    else
                        itemInfoGotable.aorimage_InfoBg:SetActiveE(0)
                    end
                    -- 镇魂街ZHJ-33365 【主任务】贪玩三测优化（7.10后）ZHJ-34888
                    -- 【客户端】千机黑煞-图标位置调整
                    -- 调整地图上的神秘商人的图标位置
                end
                self:UpdateIcon(adv, itemInfoGotable)
                local isFight =
                    adv.event_type == _G.DungonesEventType.nomal or adv.event_type == _G.DungonesEventType.elite or
                    adv.event_type == _G.DungonesEventType.boss
                if haveUnselectedMementon and id == DungonesModel:GetInstance().DungonesInfo.section then
                    isFight = false
                end
                --region 火焰特效 普通 =弱x无√ 精英 = 正常  层级boss、最终boss = 强
                _G.GameUtil.SetActiveByCondition(itemInfoGotable.obj_huonode, isFight)
                local huoyan_ruo, huoyan_nor, huoyan_qiang = false, false, false
                if adv.event_type == _G.DungonesEventType.boss or adv.event_type == _G.DungonesEventType.endboss then
                    huoyan_qiang = true
                elseif adv.event_type == _G.DungonesEventType.nomal then
                    huoyan_ruo = false
                    _G.GameUtil.SetActiveByCondition(itemInfoGotable.obj_huonode, false)
                elseif adv.event_type == _G.DungonesEventType.elite then
                    huoyan_nor = true
                end
                _G.GameUtil.SetActiveByCondition(itemInfoGotable.obj_huoyan_1, huoyan_ruo)
                _G.GameUtil.SetActiveByCondition(itemInfoGotable.obj_huoyan_2, huoyan_nor)
                _G.GameUtil.SetActiveByCondition(itemInfoGotable.obj_huoyan_3, huoyan_qiang)
                --endregion

                if isFight then
                    if info.defender_team then
                        local powerNum = info.defender_team[1].power
                        itemInfoGotable.aortext_Power.text = _G.GameUtil.NumberToUnitStrFight(powerNum)
                    else
                        itemInfoGotable.aortext_Power.text = ""
                    end
                end
                _G.GameUtil.SetActiveByCondition(itemInfoGotable.obj_power, isFight)
                _G.GameUtil.SetActiveByCondition(itemInfoGotable.aorimage_InfoBg, not isFight)
                if _G.ConfigManager.adventure_cfg[info.sid].event_type == _G.DungonesEventType.boxAward then
                    itemInfoGotable.aorimage_InfoBg:SetActiveE(0)
                end
            end

            if _G.AppSetting.DEBUG then
                itemInfoGotable.gameObject:SetName("info>>>" .. id)
            end

            self.Lines[id] = {
                type = { i },
                posY = { pos.y },
                line = { lineGotable },
                item = itemGotable,
                itemInfo = itemInfoGotable
            }
            self.CaPos[id] = outPos
        end
    end
end

---把点称动到对应接点
function DungonesRuningView:MoveToNextBySid(sid, back, moveBack)
    if not self.Lines[sid] then
        return
    end
    self.moveToX, self.moveToY, self.moveToZ = self.Lines[sid].item.transform:GetLocalPosition()
    if sid ~= self.lastSid then
        self.isMoving = true
        self.lastSid = sid
        self.ItemInfoGotable.trans_spine:SetActiveE(0)
        self:PlayDispearEff(function()
            self.ItemInfoGotable.transform:SetLocalPosition(self.moveToX, self.moveToY, self.moveToZ)
            self.ItemInfoGotable.trans_spine:SetActiveE(1)
            self.isMoving = false
            if moveBack then
                moveBack()
            end
        end)
    elseif not self.isMoving then
        self.ItemInfoGotable.trans_spine:SetActiveE(0)
        self.ItemInfoGotable.transform:SetLocalPosition(self.moveToX, self.moveToY, self.moveToZ)
        self.ItemInfoGotable.trans_spine:SetActiveE(1)
        if moveBack then
            moveBack()
        end
    end
    -- self.ItemInfoGotable.transform:DOLocalMove(x, y, z, 3):OnComplete(
    --     function()
    --         require("DungonesModel"):GetInstance().DungonesInfo.sid = 0
    --         back()
    --         _G.GameUtil.SetActiveByCondition(self.go_table.obj_moveMask, false)
    --     end
    -- )
    local flag = require "DungonesManager":GetInstance().iswin
    if flag then
        require("DungonesModel"):GetInstance().DungonesInfo.sid = 0
    end
    back()
end

function DungonesRuningView:PlayDispearEff(call)
    if not self.effDispear then
        self.effDispear = true
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_juesexiaoshi,
            self.ItemInfoGotable.obj_effect,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                self.effDispear = trans
                _G.DelayDo(0.333, _G.handlerbind(self, self.PlayAppearEff, call))
                _G.DelayDo(0.8, function()
                    if self:IsNil() then
                        return
                    end
                    if self.effDispear then
                        self.effDispear:SetActiveE(0)
                    end
                end)
            end
        )
    elseif self.effDispear ~= true then
        self.effDispear:SetActiveE(0)
        self.effDispear:SetActiveE(1)
        _G.DelayDo(0.333, _G.handlerbind(self, self.PlayAppearEff, call))
        _G.DelayDo(0.8, function()
            if self:IsNil() then
                return
            end
            if self.effDispear then
                self.effDispear:SetActiveE(0)
            end
        end)
    end
end

function DungonesRuningView:PlayAppearEff(call)
    if self:IsNil() or not self.ItemInfoGotable then
        return
    end
    if not self.effAppear then
        self.effAppear = true
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_juesechuxian,
            self.ItemInfoGotable.obj_effect,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                self.effAppear = trans
                if call then
                    call()
                end
                _G.DelayDo(3, function()
                    if self:IsNil() then
                        return
                    end
                    if self.effAppear then
                        self.effAppear:SetActiveE(0)
                    end
                end)
            end
        )
    elseif self.effAppear ~= true then
        self.effAppear:SetActiveE(0)
        self.effAppear:SetActiveE(1)
        if call then
            call()
        end
        _G.DelayDo(3, function()
            if self:IsNil() then
                return
            end
            if self.effAppear then
                self.effAppear:SetActiveE(0)
            end
        end)
    end
end

