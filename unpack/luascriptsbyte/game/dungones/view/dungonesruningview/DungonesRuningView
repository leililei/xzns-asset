            _G.GameUtil.SetActiveByCondition(self.Lines[sid].line[i].obj_openLineTrans, false)
            _G.GameUtil.SetActiveByCondition(self.Lines[sid].line[i].obj_passLineTrans, false)
            _G.GameUtil.SetActiveByCondition(self.Lines[sid].line[i].obj_notOpenLineTrans, true)
        end
    end

    if passNum <= 0 then
        _G.GameUtil.SetActiveByCondition(self.Lines[sid].itemInfo.obj_open, false)
        _G.GameUtil.SetActiveByCondition(self.Lines[sid].itemInfo.obj_miss, true)

        _G.GameUtil.SetActiveByCondition(self.Lines[sid].item.obj_open, false)
        _G.GameUtil.SetActiveByCondition(self.Lines[sid].item.obj_miss, true)
        -- --停止播放 下落动画
        -- local ani1 = self.Lines[sid].itemInfo.obj_miss:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
        -- if self.firstAni then
        --     ani1:SetActiveE(1)
        -- else
        --     ani1:SetActiveE(0)
        -- end
    end
end

---节点miss
function DungonesRuningView:MissEvent(cfgdata)
    local sid = cfgdata.id

    if _G.AppSetting.DEBUG then
        _G.Log(sid, "节点miss>>>>>>>>>>>>>>")
    end
    if nil == self.Lines[sid] then
        return
    end
    local info = DungonesModel:GetInstance():GetAdventureByLevel(sid)
    if info == nil then
        _G.GameUtil.SetActiveByCondition(self.Lines[sid].itemInfo.gameObject, false)
    else
        local team = DungonesModel:GetInstance():GetEnmeyTeam(info)
        --判断有没有 队伍数据，判断是不是 同组
        local cfg = require "DungonesManager":GetInstance().CurDoDungCfg
        if _G.table.isEmptyOrNil(team) then
            --判断是不是 层级boss
            local adv = _G.ConfigManager.adventure_cfg
            local adv_id = cfgdata.event[1][1]
            if adv[adv_id].event_type == _G.DungonesEventType.boss or adv[adv_id].event_type == _G.DungonesEventType.endboss then -- 3 是层级boss
                _G.GameUtil.SetActiveByCondition(self.Lines[sid].itemInfo.gameObject, true)
            else
                _G.GameUtil.SetActiveByCondition(self.Lines[sid].itemInfo.gameObject, false)
            end
        else
            if cfgdata.group <= cfg.group then
                _G.GameUtil.SetActiveByCondition(self.Lines[sid].itemInfo.gameObject, false)
            else
                --判断组是不是大于2
                if (cfgdata.group - cfg.group) > 2 then
                    _G.GameUtil.SetActiveByCondition(self.Lines[sid].itemInfo.gameObject, false)
                else
                    _G.GameUtil.SetActiveByCondition(self.Lines[sid].itemInfo.gameObject, true)
                end
            end
        end
    end

    _G.GameUtil.SetActiveByCondition(self.Lines[sid].itemInfo.obj_open, false)
    _G.GameUtil.SetActiveByCondition(self.Lines[sid].itemInfo.obj_miss, true)
    --停止播放 下落动画
    -- local ani = self.Lines[sid].itemInfo.obj_miss:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    -- if self.firstAni then
    --     ani.enabled = true
    -- else
    --     ani.enabled = false
    -- end
    _G.GameUtil.SetActiveByCondition(self.Lines[sid].item.obj_open, false)
    _G.GameUtil.SetActiveByCondition(self.Lines[sid].item.obj_miss, true)

    for i = 1, #self.Lines[sid].line do
        _G.GameUtil.SetActiveByCondition(self.Lines[sid].line[i].obj_openLineTrans, false)
        _G.GameUtil.SetActiveByCondition(self.Lines[sid].line[i].obj_passLineTrans, false)
        _G.GameUtil.SetActiveByCondition(self.Lines[sid].line[i].obj_notOpenLineTrans, true)
    end
end

function DungonesRuningView:GetMementoCallBack()
    local difficulty = DungonesModel:GetInstance().DungonesInfo.difficulty
    if self.Lines[DungonesModel:GetInstance().DungonesInfo.section] then
        _G.GameUtil.SetActiveByCondition(
            self.Lines[DungonesModel:GetInstance().DungonesInfo.section].itemInfo.obj_open,
            false
        )
    end
    if DungonesModel:GetInstance():CheckUnselectedMementoIsLastSectionByLayer() then
        local cfg = _G.ConfigManager.dungeons_cfg[DungonesModel:GetInstance().DungonesInfo.section]
        self:MoveToNextBySid(
            DungonesModel:GetInstance().DungonesInfo.section,
            function()
                _G.UIUtils.RemoveChildren(self.go_table.obj_itemParent)
                _G.UIUtils.RemoveChildren(self.go_table.obj_lineParent)
                _G.UIUtils.RemoveChildren(self.go_table.obj_mapParent)
                self.Lines = nil
                self.CaPos = nil
                require("DungonesModel"):GetInstance().DungonesInfo.sid = 0
                for key, value in pairs(_G.ConfigManager.dungeons_cfg) do
                    if difficulty == value.difficulty and cfg.layer + 1 == value.layer and #value.event <= 0 then
                        cfg = value
                        break
                    end
                end
                require "DungonesManager":GetInstance().CurDoDungCfg = cfg
                DungonesModel:GetInstance().DungonesInfo.unselected_mementos = nil
                DungonesModel:GetInstance().DungonesInfo.unselected_mementos_section = 0
                self:UpdateInfo()
                self:DrawLine()
                self:ShowHy()
            end,
            true
        )
    else
        self:MoveToNextBySid(
            DungonesModel:GetInstance().DungonesInfo.section,
            function()
                require "DungonesManager":GetInstance().CurDoDungCfg =
                    _G.ConfigManager.dungeons_cfg[DungonesModel:GetInstance().DungonesInfo.section]
                DungonesModel:GetInstance().DungonesInfo.unselected_mementos = nil
                DungonesModel:GetInstance().DungonesInfo.unselected_mementos_section = 0
                self:UpdateDisplay()
                self:ShowHy()
            end,
            function()
                self:UpdateCurPos()
            end
        )
    end
end

---点开事件
function DungonesRuningView:ItemClick(go, isOn, index)
    if require "DungonesModel":GetInstance().isTime then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            1708,
            nil,
            function()
                self:Close()
                require "DungonesManager":GetInstance():ReturnMian()
            end
        )
        return
    end
    local info = DungonesModel:GetInstance():GetAdventureByLevel(index)
    local selectEventID = DungonesModel:GetInstance().DungonesInfo.sid
    local finishSectionID = DungonesModel:GetInstance().DungonesInfo.section
    ---@type adventure_cfg
    local adv = _G.ConfigManager.adventure_cfg[info.sid]
    local sid = adv.id
    local name = go:GetName()
    local afterSection = _G.ConfigManager.dungeons_cfg[DungonesModel:GetInstance().DungonesInfo.section].after_section
    local isPreview = table.indexof(afterSection, info.section_sid) == false
    local haveUnselectedMementos, unselectedInfo = DungonesModel:GetInstance():HaveUnselectedMementos()
    local DoThing = function()
        if name == "@_aorbtn_clickOpen" then
            ---特殊处理 战斗结束退出游戏未领取遗物
            if DungonesModel:GetInstance():IsPassLevelByEventId(info.section_sid) and haveUnselectedMementos then
                if _G.table.isEmptyOrNil(unselectedInfo) then
                    return
                end
                local RelicData = unselectedInfo[2]
                if RelicData then
                    _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.DungonesGetRelicView.Name,
                        RelicData,
