---当事人
function DungonesRuningView:CreateCurItem(back)
    ---@type dungeons_cfg
    local cfg = require "DungonesManager":GetInstance().CurDoDungCfg
    local sid = cfg.id
    local section = DungonesModel:GetInstance().DungonesInfo.section
    local haveUnselectedMementos, UnSection = DungonesModel:GetInstance():HaveUnselectedMementos()
    if self.ItemInfoGotable then
        _G.DestroyObject(self.ItemInfoGotable.gameObject)
        self.lastSid = nil
        self.effAppear = nil
        self.effDispear = nil
        self.ItemInfoGotable = nil
    end
    if #cfg.event <= 0 and section ~= sid and not haveUnselectedMementos and not self.isShowUntil then
        ---@type roguelike.c2s_roguelike_choose
        local msg = {}
        msg.sid = sid
        require "DungonesNet":GetInstance():ChooseAdventure(
            msg,
            function(data)
                if data.ack == 1 then
                    DungonesModel:GetInstance().DungonesInfo.section = sid
                    if data.adventures then
                        require("DungonesModel"):GetInstance():DisposalDateAdventure(data.adventures)
                    end
                    local pos = self:GetPosBySid(sid)
                    local curItem = _G.InstantiateObject(self.go_table.obj_curItem, self.go_table.obj_itemParent)
                    -- local ani = curItem:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
                    -- ani:SetActiveE(0)
                    curItem:SetLocalPosition(pos.x, pos.y, 0)
                    self.moveToX = pos.x
                    self.moveToY = pos.y
                    self.moveToZ = 0
                    self.ItemInfoGotable = _G.GetAutoGoTable(curItem)
                    self:UpdatePlayerNode()

                    if _G.AppSetting.DEBUG then
                        self.ItemInfoGotable.gameObject:SetName("cur>>>" .. sid)
                    end
                    --ani:SetActiveE(1)
                    self:RefreshStarAfterEnemy(cfg)
                    back()
                end
            end
        )
    else
        local pos = self:GetPosBySid(sid)
        local curItem = _G.InstantiateObject(self.go_table.obj_curItem, self.go_table.obj_itemParent)
        -- local ani = curItem:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
        -- ani:SetActiveE(0)
        curItem:SetLocalPosition(pos.x, pos.y, 0)
        self.ItemInfoGotable = _G.GetAutoGoTable(curItem)
        if _G.AppSetting.DEBUG then
            self.ItemInfoGotable.gameObject:SetName("cur>>>" .. sid)
        end
        self:UpdatePlayerNode()
        --ani:SetActiveE(1)
        back()
    end
end

---动态怪 跳层刷新
function DungonesRuningView:RefreshStarAfterEnemy(curcfg)
    local haveUnselectedMementon, unselectedInfo = DungonesModel:GetInstance():HaveUnselectedMementos()
    ---当前怪物的 信息 刷新 后面两个界面 信息
    local afterSection
    if DungonesModel:GetInstance().DungonesInfo.section > 0 then
        afterSection = _G.ConfigManager.dungeons_cfg[DungonesModel:GetInstance().DungonesInfo.section].after_section
    end
    for i = 2, #self.ShowList do
        if self.ShowList[i].group <= curcfg.group then
        elseif (self.ShowList[i].group - curcfg.group) <= 2 then
            local event = self.ShowList[i].event
            local eventid = event[1][1]
            local cfg = _G.ConfigManager.adventure_cfg[eventid]
            if
                cfg.event_type == _G.DungonesEventType.nomal or cfg.event_type == _G.DungonesEventType.elite or
                cfg.event_type == _G.DungonesEventType.boss or
                cfg.event_type == _G.DungonesEventType.endboss
            then
                local id = self.ShowList[i].id
                if self.Lines[id] then
                    local itemInfoGotable = self.Lines[id].itemInfo
                    local info = DungonesModel:GetInstance():GetAdventureByLevel(id)
                    if info then
                        ---@type adventure_cfg
                        local adv = _G.ConfigManager.adventure_cfg[info.sid]
                        --local team = DungonesModel:GetInstance():GetEnmeyTeam(info)
                        if haveUnselectedMementon and id == DungonesModel:GetInstance().DungonesInfo.section then
                            itemInfoGotable.aorrawimage_openIcon:LoadImage(
                                box,
                                function(image)
                                    image:SetNativeSize()
                                end
                            )
                            itemInfoGotable.aorrawimage_missIcon:LoadImage(
                                box,
                                function(image)
                                    image:SetNativeSize()
                                end
                            )
                            itemInfoGotable.aorimage_InfoBg:SetActiveE(0)
                        else
                            if adv.name then
                                if adv.event_type == _G.DungonesEventType.endboss then
                                    itemInfoGotable.aorimage_InfoBg:SetActiveE(self.isPassBoss and 0 or 1)
                                end
                                local lanId = _G.tonumber(adv.name)
                                itemInfoGotable.aortext_info.text = lanId and _G.GetLangPackValue(lanId) or ""
                            else
                                itemInfoGotable.aorimage_InfoBg:SetActiveE(0)
                            end
                            itemInfoGotable.aorrawimage_openIcon:LoadImage(
                                adv.icon,
                                function(image)
                                    image:SetNativeSize()
                                end
                            )

                            itemInfoGotable.aorrawimage_missIcon:LoadImage(
                                adv.icon,
                                function(image)
                                    image:SetNativeSize()
                                end
                            )
                        end
                        self:UpdateIcon(adv, itemInfoGotable)
                        local isFight =
                            adv.event_type == _G.DungonesEventType.nomal or adv.event_type == _G.DungonesEventType.elite or
                            adv.event_type == _G.DungonesEventType.boss
                        if haveUnselectedMementon and id == DungonesModel:GetInstance().DungonesInfo.section then
                            isFight = false
                        end
                        local isNotPreview = afterSection and table.indexof(afterSection, info.section_sid)
                        itemInfoGotable.obj_power:SetActiveE((isFight and isNotPreview) and 1 or 0)
                        --_G.GameUtil.SetActiveByCondition(itemInfoGotable.aorimage_InfoBg, not isFight)
                        if isFight then
                            if info.defender_team then
                                local powerNum = info.defender_team[1].power
                                itemInfoGotable.aortext_Power.text = _G.GameUtil.NumberToUnitStrFight(powerNum)
                            else
                                itemInfoGotable.aortext_Power.text = ""
                            end
                        end
                    end
                end
            end
        end
    end
end

