---节点打开
function DungonesRuningView:OpenEvent(sid)
    if _G.AppSetting.DEBUG then
        _G.Log(sid, "节点打开>>>>>>>>>>>>>>")
    end
    if nil == self.Lines[sid] then
        return
    end

    _G.GameUtil.SetActiveByCondition(self.Lines[sid].itemInfo.gameObject, true)

    _G.GameUtil.SetActiveByCondition(self.Lines[sid].itemInfo.obj_open, true)
    _G.GameUtil.SetActiveByCondition(self.Lines[sid].itemInfo.obj_miss, false)
    _G.GameUtil.SetActiveByCondition(self.Lines[sid].itemInfo.aorbtn_clickOpen, true)

    local cfg = _G.ConfigManager.dungeons_cfg[sid]
    local isPassBoss = self.isPassBoss and
        _G.ConfigManager.adventure_cfg[cfg.event[1][1]].event_type == _G.DungonesEventType.endboss

    self.Lines[sid].itemInfo.obj_arrow:SetActiveE(isPassBoss and 0 or 1)
    self.Lines[sid].itemInfo.aorimage_InfoBg:SetActiveE(isPassBoss and 0 or 1)
    self.Lines[sid].itemInfo.obj_bossReFight:SetActiveE(isPassBoss and 1 or 0)
    self.Lines[sid].item.obj_eff:SetActiveE(1)

    _G.GameUtil.SetActiveByCondition(self.Lines[sid].item.obj_open, true)
    _G.GameUtil.SetActiveByCondition(self.Lines[sid].item.obj_miss, false)
    --停止播放 下落动画
    -- local ani = self.Lines[sid].itemInfo.obj_open:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    -- if self.firstAni then
    --     ani:SetActiveE(1)
    -- else
    --     ani:SetActiveE(0)
    -- end

    local passNum = 0

    for i = 1, #self.Lines[sid].line do
        local isPass = DungonesModel:GetInstance():IsPassLevelByEventId(cfg.pre_section[i])
        if isPass then
            passNum = passNum + 1
            _G.GameUtil.SetActiveByCondition(self.Lines[sid].line[i].obj_openLineTrans, true)
            _G.GameUtil.SetActiveByCondition(self.Lines[sid].line[i].obj_passLineTrans, false)
            _G.GameUtil.SetActiveByCondition(self.Lines[sid].line[i].obj_notOpenLineTrans, false)
