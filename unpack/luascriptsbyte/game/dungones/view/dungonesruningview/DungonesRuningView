---主要界面点击事件
function DungonesRuningView:OnClickBtn(go, _)
    if _G.AppSetting.DEBUG then
        _G.Log(go, "点击千机按钮事件")
    end
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
        require "DungonesManager":GetInstance():ReturnMian()
    elseif go == self.go_table.aorbtn_Rank then
        ---排行榜
        local msg = {}
        msg.type = 8
        require("DungonesModel"):GetInstance():GetRanKInfo(
            msg,
            function(data)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.Dungeons_boos_rank.Name, data)
            end
        )
    elseif go == self.go_table.aorbtn_Shop then
        ---商店
        require "ShopModel":GetInstance():OpenShop(_G.ShopID.Dungones)
    elseif go == self.go_table.aorbtn_Relic then
        ---遗物
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DungonesRelicView.Name)
    elseif go == self.go_table.aorbtn_Card then
        -- elseif go == self.go_table.aorbtn_Collection then
        --     ---藏品
        --     _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DungonesCollectionBagView.Name)
        ---卡牌
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DungonesBagView.Name)
    elseif go == self.go_table.aorbtn_TipsView then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_TipsView, false)
    elseif go == self.nextPanel.aorbtn_start then
        self.nextPanel.gameObject:SetActiveE(0)
        self.isShowUntil = false
        require "DungonesModel":GetInstance():InitData(
            function()
                self:CreateCurItem(
                    function()
                        _G.GameUtil.SetActiveByCondition(self.go_table.obj_lineParent, true)
                        _G.GameUtil.SetActiveByCondition(self.go_table.obj_itemParent, true)
                        self:UpdateDisplay()
                        self:UpdateCurPos()
                    end
                )
            end
        )
    elseif go == self.nextPanel.aorbtn_end then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            1711,
            nil,
            function()
                require "DungonesNet":GetInstance():ChooseTop(
                    function(msg)
                        _G.StorageManager:GetInstance():ReceiveAwardData(msg.top_info)
                        DungonesModel:GetInstance().DungonesInfo.is_top = 1
                        self.nextPanel.gameObject:SetActiveE(0)
                        --TODO伯放特效
                        require "CommonTipManager".OpenCommonAwardView(
                            msg.top_info,
                            function()
                                _G.UIManager:GetInstance():OpenWindow(
                                    _G.ConfigManager.ui_cfg.DungonesUntilTopView.Name,
                                    msg.top_info,
                                    function()
                                        self.isShowUntil = false
                                    end
                                )
                            end
                        )
                        _G.Events:GetInstance():Broadcast(_G.DungonesPlayState.DungonesEnd)
                        _G.Events:GetInstance():Broadcast(_G.BattlePassExpEvents.BPDungones, 1)
                        _G.Events:GetInstance():Broadcast(_G.BattlePassExpEvents.BPDungones, 2)
                    end
                )
            end
        )
    end
end

