---初始化魂玉甲虫
function DungonesRuningView:InitHy()
    self.hyData = require "PrivilegeManager":GetInstance():GetPrivilegeData({ _G.PrivilegeType.Dungones.Item })
    if #self.hyData > 0 then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_hy, true)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_hy, false)
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_lj, DungonesModel:GetInstance().DungonesInfo.not_fight > 0)
    self.go_table.aortext_content.text =
        _G.GetLangPackValue(
            90028300044,
            DungonesModel:GetInstance().DungonesInfo.not_fight,
            DungonesModel:GetInstance().DungonesInfo.not_fight
        )

    self:ShowHy()
end

---更新魂玉甲虫进度
function DungonesRuningView:UpdateProgress()
    if DungonesModel:GetInstance().DungonesInfo.section > 0 then
        ---@type dungeons_cfg
        local cfg = _G.ConfigManager.dungeons_cfg[DungonesModel:GetInstance().DungonesInfo.section]
        local count = DungonesModel:GetInstance().maxCount
        self.go_table.slider_progress.value =
            progress[cfg.layer] + (cfg.group / count) * (progress[cfg.layer + 1] - progress[cfg.layer])
    else
        self.go_table.slider_progress.value = 0
    end
end

