---更新奖励显示
function DungonesRuningView:UpdateAward()
    if not self.hyAwardList then
        self.hyAwardList = {}
    end
    ---@type dungeons_cfg
    local cfg = _G.ConfigManager.dungeons_cfg[DungonesModel:GetInstance().DungonesInfo.section]
    for i = 1, 3 do
        if not self.hyAwardList[i] then
            self.hyAwardList[i] =
                _G.GetAutoGoTable(self.go_table["obj_award" .. i], _G.handlerbind(self, self.OnClickAward, i))
        end
        if DungonesModel:GetInstance():CheckHyIsGet(i) then
            self.hyAwardList[i].aorimage_icon.SpriteName = 24 - i
        else
            if not cfg then
                self.hyAwardList[i].aorimage_icon.SpriteName = 14 - i
            else
                if i > cfg.layer then
                    self.hyAwardList[i].aorimage_icon.SpriteName = 14 - i
                elseif cfg.layer == i then
                    if i == 3 and DungonesModel:GetInstance().DungonesInfo.damage > 0 then
                        self.hyAwardList[i].aorimage_icon.SpriteName = 30 - i
                    elseif #cfg.after_section <= 0 then
                        self.hyAwardList[i].aorimage_icon.SpriteName = 30 - i
                    else
                        self.hyAwardList[i].aorimage_icon.SpriteName = 14 - i
                    end
                else
                    self.hyAwardList[i].aorimage_icon.SpriteName = 30 - i
                end
            end
        end
        self.hyAwardList[i].aorimage_icon:SetNativeSize()
    end
end

---查看魂玉奖励
function DungonesRuningView:OnClickNodeCheck(go, ison, index)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_TipsView, true)
    if not self.itemTable then
        self.itemTable = {}
    end
    for key, value in pairs(self.itemTable) do
        value.Despawn(value)
        self.itemTable[key] = nil
    end
    local x, y, z = go:GetPosition()
    self.go_table.obj_ItemTips:SetPosition(x, y, z)
    local NowItems = self.hyData
    local tf = self.go_table.obj_ItemTips:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    if not _G.IsNil(tf) then
        tf:SetSizeWithCurrentAnchors(_G.CS.UnityEngine.RectTransform.Axis.Horizontal, 100)
    end
    self:CareatItem(NowItems, self.go_table.obj_Parent, self.itemTable)
end

function DungonesRuningView:CareatItem(tb, Parent, itemTable)
    if _G.IsNil(Parent) or Parent:GetctiveInHierarchy() == 0 then
        return
    end
    local data = {}
    data.sid = tb[1]

    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        tb,
        Parent,
        function(item)
            item.gameObject:SetLocalScaleXYZ(0.9)
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            --endregion------------------------------------物品 特效 防止因异步加载 延迟导致显示错误--------

            table.insert(itemTable, item)
        end,
        function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data.sid)
        end
    )
end

---点击魂玉奖励
function DungonesRuningView:OnClickAward(go, _, index)
    ---@type dungeons_cfg
    local cfg = _G.ConfigManager.dungeons_cfg[DungonesModel:GetInstance().DungonesInfo.section]
    if not cfg then
        return
    end
    if cfg.layer < index then
        self:OnClickNodeCheck(go, _, index)
        return
    end
    if require "DungonesModel":GetInstance():CheckHyIsGet(index) then
        return
    end
    if cfg.layer == index then
        if cfg.layer == 3 then
            if require "DungonesModel":GetInstance().DungonesInfo.damage <= 0 then
                self:OnClickNodeCheck(go, _, index)
                return
            end
        else
            if #cfg.after_section > 0 then
                self:OnClickNodeCheck(go, _, index)
                return
            end
        end
    end
    local canGet = { false, false, false }
    local totalType = 0
    if (self.hyAwardList[1].aorimage_icon.SpriteName == "29") then
        canGet[1] = true
        totalType = totalType + 1
    end
    if (self.hyAwardList[2].aorimage_icon.SpriteName == "28") then
        canGet[2] = true
        totalType = totalType + 1
    end
    if (self.hyAwardList[3].aorimage_icon.SpriteName == "27") then
        canGet[3] = true
        totalType = totalType + 1
    end
    local maxCount = 0
    for i = 1, #canGet do
        if (canGet[i] == true) then
            maxCount = maxCount + 1
        end
    end
    local data = { award = { item = {}, overflow = {} } }
    for i = 1, #canGet do
        if (canGet[i] == true) then
            DungonesModel:GetInstance():GetHy(
                i,
                function(msg)
                    if msg.award.item then
                        _G.table.insertto(data.award.item, msg.award.item)
                    end
                    if msg.award.overflow then
                        _G.table.insertto(data.award.overflow, msg.award.overflow)
                    end

                    maxCount = maxCount - 1
                    if maxCount <= 0 then
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
                    end
                    self.hyAwardList[i].aorimage_icon.SpriteName = 24 - i
                    self.hyAwardList[i].aorimage_icon:SetNativeSize()
                end,
                totalType
            )
        end
    end
end

