    self.nextPanel = _G.GetAutoGoTable(self.go_table.obj_NextPanel, _G.handler(self, self.OnClickBtn))
    if AppSetting.IsXzns then
        local shoplist = require("ShopModel"):GetInstance():GetShopList()
        local show = 0
        for k, v in pairs(shoplist) do
            if v.id == 5 and v.show then
                show = 1
            end
        end
        self.go_table.aorbtn_Shop:SetActiveE(show)
    end
end

