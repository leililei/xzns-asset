---界面的入口函数
function DungonesRuningView:OnCreate(...)
    if DungonesModel:GetInstance().DungonesInfo.open_mementos then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.DungonesGetRelicView.Name,
            DungonesModel:GetInstance().DungonesInfo.open_mementos,
            nil,
            true
        )
    end
    self.firstAni = true
    local args = { ... }
    self.V2 = _G.Vector2.New(0, 0)
    self.Rtfuy = _G.CS.UnityEngine.RectTransformUtility
    self.ObjItem = self.go_table.obj_itemParent:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    self.difficulty = DungonesModel:GetInstance().DungonesInfo.difficulty
    self.isShowUntil =
        DungonesModel:GetInstance().DungonesInfo.max_difficulty >= self.difficulty and
        DungonesModel:GetInstance().DungonesInfo.is_top < 0 and
        _G.GlobalConditionManager.CheckConditionByArray(_G.ConfigManager.discrete_cfg[untilTopId])
    self:UpdateInfo()
    self:DrawLine()
    self:InitHy()
    self.firstAni = false
    local x, y, z = self.go_table.aorbtn_Relic:GetPosition()
    local nx, ny = self.camera:WorldToScreenPointE(x, y, z)
    self.pos_aorbtn_relic = { x = nx, y = ny }
    require "DungonesManager":GetInstance():SetRelicPostionToScreenPoint(self.pos_aorbtn_relic)
    if DungonesModel:GetInstance().DungonesInfo.is_top == 1 then
        require "DungonesNet":GetInstance():GetTopInfo(
            function(data)
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.DungonesUntilTopView.Name,
                    data.top_info,
                    function()
                        self.isShowUntil = false
                    end
                )
            end
        )
    else
        self.nextPanel.gameObject:SetActiveE(self.isShowUntil and 1 or 0)
    end
end

function DungonesRuningView:UpdateInfo()
    self.go_table.aortext_Progress.text =
        _G.LangUtil.GetLangPackValue(90023200002, require "DungonesManager":GetInstance().CurDoDungCfg.layer)
    -- .. "-" .. require"DungonesManager":GetInstance().CurDoDungCfg.room
end

function DungonesRuningView:DrawLine()
    local layer = require "DungonesManager":GetInstance().CurDoDungCfg.layer

    if _G.AppSetting.DEBUG then
        _G.Log(layer, "当前层>>>>>>>>>>>>>>>")
    end
    self.Layer = layer
    self.ShowList = {}
    local group = 0
    for _, v in pairs(_G.ConfigManager.dungeons_cfg) do
        if v.difficulty == self.difficulty and layer == v.layer then
            table.insert(self.ShowList, v)
            if v.group >= group then
                group = v.group
            end
        end
    end

    local sizetx, sizety =
        self.go_table.obj_ScrollView:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform)):GetRectTransformSize()

    self.Sizetx = sizetx

    if _G.AppSetting.DEBUG then
        _G.Log(sizetx .. ">>>>>>>" .. sizety, "滚动区域大小")
    end
    local allWidth = group * 260

    if _G.AppSetting.DEBUG then
        _G.Log(allWidth, "占用宽度空间")
    end

    local addMapNum = math.ceil(allWidth / 1560)

    if _G.AppSetting.DEBUG then
        _G.Log(addMapNum, "添加背景个数>>>")
    end

    --for i = 1, addMapNum do
    --    local curItem = _G.InstantiateObject(self.go_table.aorrawimage_map, self.go_table.obj_mapParent)
    --    curItem:SetLocalPosition((i - 1) * 1560, 0, 0)
    --    local got = _G.GetAutoGoTable(curItem)
    --    got.aorrawimage_map:LoadImage("ImagesH5/hDungones/bg")
    --end

    local width
    if allWidth > sizetx then
        width = allWidth + 320
    else
        width = sizetx
    end
    self.go_table.obj_Content:SetRectTransformSize(720, width)
    self.go_table.obj_bg:SetRectTransformSize(720, width)
    self.go_table.obj_lineParent:SetRectTransformSize(720, width)
    self.go_table.obj_itemParent:SetRectTransformSize(720, width)

    _G.SortList(
        self.ShowList,
        function(item)
            return -item.id
        end
    )

    if _G.AppSetting.DEBUG then
        _G.Log(self.ShowList, "当前层所有列表>>>>>>>>>>>")
    end
    self.Lines = {}
    self.CaPos = {}
    self.StartPosSid = self.ShowList[1].id
    self.CaPos[self.StartPosSid] = {
        x = 95,
        y = 100
    }

    self:DrawFirstPoint(self.StartPosSid)

    for i = 1, #self.ShowList do
        self:DrawOneLine(self.ShowList[i].id)
    end

    _G.GameUtil.SetActiveByCondition(self.go_table.obj_lineParent, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_itemParent, false)
    self:CreateCurItem(
        function()
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_lineParent, true)
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_itemParent, true)
            self:UpdateDisplay()
            self:UpdateCurPos()
        end
    )
end

function DungonesRuningView:UpdateCurPos()
    local group = require "DungonesManager":GetInstance().CurDoDungCfg.group
    local curLocation = group >= 1 and 170 + (230 * (group - 1)) or 0
    self.go_table.obj_Content:SetAnchorPosition(0, -curLocation)
end

function DungonesRuningView:UpdateDisplay()
    ---@type dungeons_cfg
    local cfg = require "DungonesManager":GetInstance().CurDoDungCfg
    self.isPassBoss = DungonesModel:GetInstance():GetPlayerDamage() > 0

    local sid = cfg.id
    self:PassEvent(sid)
    for i = 1, #self.ShowList do
        if self.ShowList[i].group <= cfg.group then
            local isPass = DungonesModel:GetInstance():IsPassLevelByEventId(self.ShowList[i].id)
            if isPass then
                self:PassEvent(self.ShowList[i].id)
            else
                self:MissEvent(self.ShowList[i])
            end
        elseif self.ShowList[i].group == cfg.group + 1 then
            if DungonesModel:GetInstance().DungonesInfo.sid > 0 then
                if self.ShowList[i].id == DungonesModel:GetInstance().DungonesInfo.sid then
                    self:OpenEvent(self.ShowList[i].id)
                else
                    self:MissEvent(self.ShowList[i])
                end
            else
                self:OpenEvent(self.ShowList[i].id)
            end
        elseif self.ShowList[i].group == cfg.group + 2 then
            self:NextGroupEvent(self.ShowList[i].id)
        else
            local event = DungonesModel:GetInstance():GetAdventureByLevel(self.ShowList[i].id)
            if event then
                ---@type adventure_cfg
                local advCfg = _G.ConfigManager.adventure_cfg[event.sid]
                if
                    advCfg.event_type == _G.DungonesEventType.nomal or advCfg.event_type == _G.DungonesEventType.elite or
                    advCfg.event_type == _G.DungonesEventType.boss or
                    advCfg.event_type == _G.DungonesEventType.endboss
                then
                    self:MissEvent(self.ShowList[i])
                else
                    self:NotOpenEvent(self.ShowList[i].id)
                end
            else
                self:MissEvent(self.ShowList[i])
            end
        end
    end
    self:UpdateView()
end

---跳关 （界面中 移动 刷新方法）
function DungonesRuningView:UpdateView()
    self:UpdateInfo()
    local cfg = require "DungonesManager":GetInstance().CurDoDungCfg
    ---跳关了
    if cfg.layer ~= self.Layer then
        _G.UIUtils.RemoveChildren(self.go_table.obj_itemParent)
        _G.UIUtils.RemoveChildren(self.go_table.obj_lineParent)
        self.Lines = nil
        self.CaPos = nil
        self:DrawLine()
        self:ShowHy()
        _G.Events:GetInstance():Broadcast(
            _G.ePlayAactionEvent.PlayAaction,
            { _G.ActiveTaskEnum.ConditionEnum.Dungones.DungonesLayer },
            1
        )
        --刷新 藏品红点
        require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.DungonesAward.id)
    else
        --判断是不是 boss
        local bossid = _G.ConfigManager.discrete_cfg[103404][1][1]
        local boss = cfg.after_section[1]
        if bossid == boss then
            self:DrawLine()
            self:ShowHy()
            _G.Events:GetInstance():Broadcast(
                _G.ePlayAactionEvent.PlayAaction,
                { _G.ActiveTaskEnum.ConditionEnum.Dungones.DungonesLayer },
                1
            )
        else
            self:RefreshStarAfterEnemy(cfg)
        end
    end
end

---更新玩家节点
function DungonesRuningView:UpdatePlayerNode()
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.DungonesPlayerNode, self.ItemInfoGotable)
    local spineCfg = require "CardCommentManager":GetInstance():CardData(
        _G.PlayerModel:GetInstance():GetRoleSid(),
        false
    )
    local isWearSkin, skinId = require("CardCommentManager"):GetInstance():CardWearSkin(spineCfg.id)
    local path = isWearSkin and _G.ConfigManager.skin_cfg[skinId].ModelPathHi or spineCfg.ModelPathHi
    local scale = spineCfg.size2
    local spinePos = spineCfg.pos_portrait
    self.ItemInfoGotable.trans_spine:ClearChildren()
    if _G.UIUtils.IsUseBattleSpine(_G.UseBattleSpine.RankView) then
        path = _G.UIUtils.GetBattleSpine(spineCfg)
        scale = spineCfg.size4
        spinePos = { 0, 0, 0 }
    end
    _G.PoolsManager:GetInstance():Spawn(
        path,
        _G.ePoolType.Temporary,
        nil,
        function(trans)
            if trans == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("角色无法加载 path:" .. spineCfg.ModelPathHi .. "    CardInfoView LoadRoleScene")
                end
                return
            end
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            trans:SetParentE(self.ItemInfoGotable.trans_spine)
            trans:SetLocalPosition(spinePos[1], spinePos[2], spinePos[3])
            trans:SetLocalScaleXYZ(scale)
            --- 只有星座女神有神环
            if _G.AppSetting.IsXzns then
                local godHaloID = _G.PlayerModel:GetInstance():IsCardWearGodHalo(spineCfg.card or spineCfg.id)
                if godHaloID ~= 0 then
                    local effCfg = _G.ConfigManager.god_halo_cfg[godHaloID].ui_effect_cfg
                    --- 神环路径，父级路径(加载角色的下面)
                    _G.UIUtils.LoadGodHalo(effCfg, trans, godHaloID)
                end
                _G.UIUtils.LoadArtifacteffect(trans, spineCfg.card or spineCfg.id,nil,nil)
            end
        end
    )
    self.ItemInfoGotable.aortext_info.text = _G.PlayerModel:GetInstance():GetName()
    -- UIUtils.IsNeedChangeUI(IsNeedChangeUI.DungonesRuningViewObj, self.ItemInfoGotable)
end

