---@class DungonesUntilTopEventView : Component	中文描述
---@field go_table DungonesUntilTopEventView_GoTable 界面数据
local DungonesUntilTopEventView = _G.BaseClass("DungonesUntilTopEventView", _G.Component)
local GetAutoGoTable = _G.GetAutoGoTable
local GetLangPackValue = _G.GetLangPackValue
function DungonesUntilTopEventView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建对象时,入口构造函数
---@param data roguelike.i_top_info
function DungonesUntilTopEventView:OnCreate(data, call)
    self:InitData(data)
    self.go_table.scrollloopvectical_itemList:InitItemData(#data.top_adventures, _G.handler(self, self.RefreshItem))
    _G.Events:GetInstance():AddListener(_G.DungonesPlayState.DungonesUntilEnd, self.OnEventEnd, self)
    self.call = call
end

---初始化数据
---@param data roguelike.i_top_info
function DungonesUntilTopEventView:InitData(data)
    self.adventrueDatas = {}
    local insert = _G.table.insert
    for _, v in pairs(data.top_adventures) do
        insert(self.adventrueDatas, {cfg = _G.ConfigManager.adventure_cfg[v.eid], info = v})
    end
    self:SortData()
end

function DungonesUntilTopEventView:SortData()
    _G.SortList(
        self.adventrueDatas,
        function(a)
            return -a.info.is_check, -a.info.sid
        end
    )
end

function DungonesUntilTopEventView:RefreshItem(index, obj)
    ---@type DungonesUntilTopEventView._obj_item_GoTable
    local tb = GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickEvent, index + 1))
    local data = self.adventrueDatas[index + 1]
    ---@type adventure_cfg
    tb.obj_isOver:SetActiveE(data.info.is_check)
    tb.aortext_name.text = GetLangPackValue(data.cfg.name)
    tb.aortext_des.text = GetLangPackValue(data.cfg.desc)
    tb.aorrawimage_icon:LoadImage(data.cfg.icon)
end

function DungonesUntilTopEventView:OnClickEvent(_, _, index)
    local data = self.adventrueDatas[index]
    if require "DungonesModel":GetInstance().isTime then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            1708,
            nil,
            function()
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DungonesUntilTopView.Name)
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DungonesRuningView.Name)
                require "DungonesManager":GetInstance():ReturnMian()
            end
        )
        return
    end
    if data.info.is_check == 1 then
        return
    end
    local cfg = _G.ConfigManager.adventure_cfg[data.info.eid]
    self.curData = data
    ---@type roguelike.i_adventure
    local info = {
        sid = data.info.eid,
        args = data.info.args,
        aid_cards = data.info.aid_cards,
        section_sid = data.info.sid
    }
    if cfg.event_type == _G.DungonesEventType.wiseMen then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.Dungones_question_view.Name, info)
    elseif cfg.event_type == _G.DungonesEventType.merchant then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DungonesShopView.Name, info)
    else
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.DungonesMainEventView.Name,
            data.info.e_type,
            data.info.eid,
            info
        )
    end
end
---完成事件
function DungonesUntilTopEventView:OnEventEnd()
    self.curData.info.is_check = 1
    self:SortData()
    self.go_table.scrollloopvectical_itemList:UpdateAllItem()
    self.curData = nil
end

---销毁对象时,析构函数
function DungonesUntilTopEventView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.DungonesPlayState.DungonesUntilEnd, self.OnEventEnd, self)
end

function DungonesUntilTopEventView:OnClickBtn(go, _)
    if go == self.go_table.aorbtn_event then
        if require "DungonesModel":GetInstance().isTime then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                1708,
                nil,
                function()
                    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DungonesUntilTopView.Name)
                    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DungonesRuningView.Name)
                    require "DungonesManager":GetInstance():ReturnMian()
                end
            )
            return
        end
        local isOver = true
        for _, v in pairs(self.adventrueDatas) do
            if v.info.is_check ~= 1 then
                isOver = false
                break
            end
        end
        local endFunc = function()
            require "DungonesNet":GetInstance():LeaveTop(
                function(msg)
                    if msg.ack ~= 1 then
                        return
                    end
                    if self.call then
                        self.call()
                    end
                end
            )
        end
        if isOver then
            endFunc()
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(
                1712,
                nil,
                function()
                    endFunc()
                end
            )
        end
    end
end

return DungonesUntilTopEventView
