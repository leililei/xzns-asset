---@class DungonesBagCardItem	中文描述
---@field item ItemCardBodySelectView
local DungonesBagCardItem = _G.BaseClass("DungonesBagCardItem")

---类的构造函数
function DungonesBagCardItem:__init(obj, callback)
    ---@type UnityEngine.GameObject
    self.gameObject = obj
    self.transform = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.callback = callback
end
---@param data CardData
function DungonesBagCardItem:Show(data, index, isSelect)
    local hpdata = require "DungonesModel":GetInstance():GetHPMP(data.uid)
    if not self.item then
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.BodyItem_select,
            self.go_table.obj_node,
            function(item)
                self.item = item
                item:ShowCardData(data, self.callback, true, index)
                _G.GameUtil.SetActiveByCondition(self.item.go_table.obj_deal, hpdata.hp <= 0)
                _G.GameUtil.SetActiveByCondition(self.item.go_table.aorimage_jue, hpdata.hp > 0)
                item.go_table.gameObject:SetLocalScaleXYZ(1)
                self.item:SetSelect(isSelect)
            end
        )
    else
        self.item:ShowCardData(data)
        self.item:SetSelect(isSelect)
        _G.GameUtil.SetActiveByCondition(self.item.go_table.obj_deal, hpdata.hp <= 0)
    end
    self.go_table.slider_hp.value = hpdata.hp / 10000
    --self.go_table.slider_mp.value = hpdata.mp / 1000
    --临时添加 红点
    self.go_table.trans_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.MineCardList.id, data.uid)
end

function DungonesBagCardItem:SetSelect(isSelect)
    if self.item then
        self.item:SetSelect(isSelect)
    end
end

function DungonesBagCardItem:OnClickBtn()
end

---类的析构函数
function DungonesBagCardItem:Dispose()
end

return DungonesBagCardItem
