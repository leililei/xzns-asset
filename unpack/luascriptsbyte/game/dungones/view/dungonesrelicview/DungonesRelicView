---@class DungonesRelicView : UIBaseView 中文描述
local DungonesRelicView = _G.BaseClass("DungonesRelicView", _G.UIBaseView)
local QiwuView = require "QiwuView"
function DungonesRelicView:Awake()
    self.Qiwu = _G.GetAutoGoTable(self.go_table.obj_qiwu, _G.handler(self, self.OnClickBtn))
    self.SingleQiwu = _G.GetAutoGoTable(self.go_table.obj_clickQiwu, _G.handler(self, self.OnClickQiWuBtn))
end
---界面的入口函数
function DungonesRelicView:OnCreate(...)
    self.IsFirst = true
    self.isPlayer = true
    self.istypeEnum = false
    self.args = {...}
    if self.args[2] then
        self.isPlayer = false
        self.cardteams = self.args[3]
    end
    if self.args[4] then
        self.istypeEnum = self.args[4] --是怪物攻城的 buff
        self.Qiwu.obj_title_qice:SetActiveE(1)
        self.Qiwu.obj_title_yiwu:SetActiveE(0)
        self.Qiwu.aortext_bottomdesc.text = _G.LangUtil.GetLangPackValue(90026500015)
    else
        self.Qiwu.aortext_bottomdesc.text = _G.LangUtil.GetLangPackValue(90024500001)
        self.Qiwu.obj_title_qice:SetActiveE(0)
        self.Qiwu.obj_title_yiwu:SetActiveE(1)
    end

    --self.content = self.Qiwu.obj_Content:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.GridLayoutGroup))
    self.SingleRectrans = self.SingleQiwu.looplist2_ItemList:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    --self.ScrollRect = self.Qiwu.scrollloopvectical_CardList2:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect))
    -- self.cardList2Rect =
    --     self.Qiwu.scrollloopvectical_CardList2:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    self.SingleContent = self.SingleQiwu.obj_Content:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    self:UpdateList()
    ---动画会影响关闭状态
     _G.DelayDo(
        1,
        function()
            --self.go_table.aorbtn_mask:SetActiveE(0)
            self.isOver = true
        end
    )
end
function DungonesRelicView:SetMask()
end

---更新显示
function DungonesRelicView:UpdateList()
    local model = require "DungonesModel"
    local list = {}
    local con = #self.args
    if con <= 0 then
        list = model:GetInstance().DungonesInfo.mementos
    else
        list = self.args[1]
    end
    if self.istypeEnum then
        list = self.args[1]
    end
    if list then
        self.MemenList = list
        _G.SortList(
            self.MemenList,
            function(id)
                ---@type mementos_cfg
                local cfg = _G.ConfigManager.mementos_cfg[id]
                return cfg.quality, cfg.id
            end
        )
        self.Qiwu.scrollloopvectical_CardList2:InitItemData(#self.MemenList, _G.handler(self, self.RefreshList))
        _G.GameUtil.SetActiveByCondition(self.Qiwu.aorrawimage_nil, #self.MemenList <= 0)
    else
        _G.GameUtil.SetActiveByCondition(self.Qiwu.aorrawimage_nil, true)
    end
end

---刷新列表
function DungonesRelicView:RefreshList(index, obj)
    if index < 0 then
        return
    end
    local id = self.MemenList[index + 1]
    ---@type mementos_cfg
    local cfg = _G.ConfigManager.mementos_cfg[id]
    local item = _G.GetAutoGoTable(obj)
    local tb_i = self:GetComponent(item.gameObject, QiwuView)
    if tb_i == nil then
        self:AddComponent(
            item.gameObject,
            QiwuView.New(cfg, item.obj_Root, _G.handlerbind(self, self.OnClickItemBtn, cfg))
        )
    else
        tb_i:Show(cfg, item.obj_Root, _G.handlerbind(self, self.OnClickItemBtn, cfg))
    end
    return obj
end
---根据{五行,职业,卡牌类型}获取所有战力最高的卡
---@param target table {五行,职业,卡牌类型}
---@return table 卡牌数组
function DungonesRelicView:GetMaxPowerCardByTarget(target)
    local CardList = self.cardteams
    local CardDatas = {}
    local cardData
    for _, v in pairs(CardList) do
        if
            (require "CardInfoManager":GetInstance():CheckMultiMatchCOP(v.cfg.Elements_new, target[1]) or target[1] == 0) and (v.cfg.Professional == target[2] or target[2] == 0) and
                (v.cfg.UnitType == target[3] or target[3] == 0)
         then
            --cardData = self:GetMaxPowerCardBySid(v)
            CardDatas[v.sid] = v
        end
    end
    return CardDatas
end
function DungonesRelicView:InitClickQiwu(cfg)
    if self.istypeEnum then
        return
    end
    for i = 1, self.SingleQiwu.obj_Root:GetChildCountE() do
        _G.PoolsManager:GetInstance():Despawn(self.SingleQiwu.obj_Root:GetChildE(0), _G.ePoolType.UIItem)
    end
    self.SingleContent:SetLocalPosition(0, 0, 0)
    self.CardLists = {}
    if self.isPlayer then
        self.Cards = _G.table.toArray(_G.StorageManager:GetInstance():GetMaxPowerCardByTarget(cfg.target))
    else
        self.Cards = _G.table.toArray(self:GetMaxPowerCardByTarget(cfg.target))
    end
    if #self.Cards > 0 then
        _G.SortList(
            self.Cards,
            function(card)
                return card.power
            end
        )
        local count = #self.Cards
        self.SingleQiwu.looplist2_ItemList:SetActiveE(1)
        self.SingleQiwu.aortext_nil:SetActiveE(0)
        if self.IsFirst then
            self.SingleQiwu.looplist2_ItemList:InitListView(0, _G.handler(self, self.RefreshCardList))
            self.IsFirst = false
        end
        if count == self.count then
            self.SingleQiwu.looplist2_ItemList:RefreshAllShownItem()
        else
            self.SingleQiwu.looplist2_ItemList:SetListItemCount(count, true)
            self.count = count
        end
        if #self.Cards < 4 then
            self.SingleRectrans:SetAnchorPosition(60 * (4 - #self.Cards) + 5, 0)
        else
            self.SingleRectrans:SetAnchorPosition(0, 0)
        end
    else
        self.SingleQiwu.looplist2_ItemList:SetActiveE(0)
        self.SingleQiwu.aortext_nil:SetActiveE(1)
    end
    self.SingleQiwu.gameObject:SetActiveE(1)
    local tb_i = self:GetComponent(self.SingleQiwu.gameObject, QiwuView)
    if tb_i == nil then
        self:AddComponent(self.SingleQiwu.gameObject, QiwuView.New(cfg, self.SingleQiwu.obj_Root, nil))
    else
        tb_i:Show(cfg, self.SingleQiwu.obj_Root, nil)
    end
end
function DungonesRelicView:RefreshCardList(listView2, index)
    if index < 0 then
        return
    end
    local list = self.Cards
    local item = listView2:NewListViewItem("$_obj_Item1")
    local tb = _G.GetAutoGoTable(item)
    local x = index + 1
    item:SetName(x)
    local sid = list[x]
    self:CreateItem(tb, sid)
    return item
end
function DungonesRelicView:CreateItem(tb, sid)
    for i = 1, tb.obj_Root:GetChildCountE() do
        _G.PoolsManager:GetInstance():Despawn(tb.obj_Root:GetChildE(0), _G.ePoolType.UIItem)
    end
    _G.ItemCardFactory:GetInstance():GetItemCard(
        _G.ItemCardFactory.itemCardType.CardAllItem,
        tb.obj_Root,
        function(item)
            item:ShowCardData(sid)
            _G.table.insert(self.CardLists, item)
        end
    )
end
--打开遗物点击
function DungonesRelicView:OnClickItemBtn(cfg)
    self:InitClickQiwu(cfg)
end

---主要界面点击事件
function DungonesRelicView:OnClickBtn(go, IsOn)
    if go == self.Qiwu.aorbtn_CloseView then
        self:Close()
    elseif go == self.Qiwu.aorbtn_close then
        self:Close()
    end
end
---选中单个遗物点击事件
function DungonesRelicView:OnClickQiWuBtn(go, IsOn)
    if go == self.SingleQiwu.aorbtn_CloseView then
        self.SingleQiwu.gameObject:SetActiveE(0)
    end
end
---销毁对象时,析构函数
function DungonesRelicView:OnDestroy()
end

function DungonesRelicView:EscClose()
    if self.isOver then
        if self.SingleQiwu.gameObject:GetActiveSelf() == 1 then
            self.SingleQiwu.gameObject:SetActiveE(0)
        else
            self:Close()
        end
    end
end

return DungonesRelicView
