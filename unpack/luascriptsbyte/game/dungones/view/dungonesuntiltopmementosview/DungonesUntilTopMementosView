---@class DungonesUntilTopMementosView : Component	中文描述
---@field go_table DungonesUntilTopMementosView_GoTable 界面数据
local DungonesUntilTopMementosView = _G.BaseClass("DungonesUntilTopMementosView", _G.Component)
local GetLangPackValue = _G.GetLangPackValue
local Key = "DungonesUntilTopMementosKey"

function DungonesUntilTopMementosView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self.PropertyIcon = {
        [1] = "ui_js_renlei_icon",
        [2] = "ui_js_shouren_icon",
        [3] = "ui_js_jingling_icon",
        [4] = "ui_js_wangling_icon",
        [5] = "ui_js_renlei_icon",
        [6] = "ui_js_chuanqi_icon",
        [16] = "ui_js_multi16",   --人神
        [26] = "ui_js_multi26",   --兽神
        [36] = "ui_js_multi36",    --精神
        [46] = "ui_js_multi46"     --亡神
    }
    self.ProfessionalIcon = _G.ProfessionalIcon
    self.Quanbu = {
        "ui_js_all_btn"
    }
    self.NameColors = {"14874a", "5d329d", "c95f00"}
end

---创建对象时,入口构造函数
---@param data roguelike.i_top_info
function DungonesUntilTopMementosView:OnCreate(data, call)
    self.maxCount = data.mementos_choose_num
    self.curIndex = data.choose_num + 1
    self.curDatas = data.mementos
    self.go_table.scrollloophorizontal_itemList:InitItemData(3, _G.handler(self, self.RefreshItem))
    self.call = call
    self.go_table.aortext_content.text = GetLangPackValue(90024600064, self.curIndex, self.maxCount)
end

function DungonesUntilTopMementosView:RefreshItem(index, obj)
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickMementos, index + 1))
    ---@type  mementos_cfg
    local cfg = _G.ConfigManager.mementos_cfg[self.curDatas[index + 1]]
    tb.aortext_desc.text = GetLangPackValue(cfg.desc)
    local SpriteName
    if cfg.target[1] ~= 0 then
        SpriteName = self.PropertyIcon[cfg.target[1]]
    elseif cfg.target[2] ~= 0 then
        SpriteName = self.ProfessionalIcon[cfg.target[2]]
    else
        SpriteName = self.Quanbu[1]
    end
    tb.aortext_name.text = _G.string.AddColor(_G.LangUtil.GetLangPackValue(cfg.name), self.NameColors[cfg.quality])
    tb.aorimage_property.SpriteName = SpriteName
    tb.aorrawimage_icon:LoadImage(cfg.icon)
end

function DungonesUntilTopMementosView:OnClickMementos(_, _, index)
    if require "DungonesModel":GetInstance().isTime then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            1708,
            nil,
            function()
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DungonesUntilTopView.Name)
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DungonesRuningView.Name)
                require "DungonesManager":GetInstance():ReturnMian()
            end
        )
        return
    end
    if self.isSend then
        return
    end
    self.isSend = true
    local msg = {m_id = {self.curDatas[index]}}
    require "DungonesNet":GetInstance():ChooseMementosTop(
        msg,
        function(data)
            self.isSend = false
            if data.ack ~= 1 then
                return
            end
            self.curIndex = self.curIndex + 1
            if self.curIndex > self.maxCount then
                self:OnEevent()
                return
            end
            self.curDatas = data.mementos
            self.go_table.scrollloophorizontal_itemList:UpdateAllItem()
            self.go_table.aortext_content.text = GetLangPackValue(90024600064, self.curIndex, self.maxCount)
        end
    )
end

function DungonesUntilTopMementosView:OnEevent()
    if self.call then
        self.call()
    end
end

function DungonesUntilTopMementosView:OnClickBtn(go)
    if go == self.go_table.aorbtn_event then
        _G.PopWindowManager:GetInstance():ShowAllTips(1713,nil,function ()
        if self.isSend then
            return
        end

        self.isSend = true
        require "DungonesNet":GetInstance():RandomMementosTop(
            function(data)
                self.isSend = false
                if data.ack ~= 1 then
                    return
                end
                self:OnEevent()
            end
        )
        end)

    end
end

return DungonesUntilTopMementosView
