---@class DungonesGetRelicView : UIBaseView 中文描述
---@field animators_qiwu UnityEngine.Animator[]
local DungonesGetRelicView = _G.BaseClass("DungonesGetRelicView", _G.UIBaseView)
local QiwuView = require "QiwuSelectView"

function DungonesGetRelicView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param RelicList RelicData 遗物table
---@param callback callback 选择后回调
function DungonesGetRelicView:OnCreate(...)
    local args = { ... }
    self.RelicList = args[1]
    self.callback = args[2]
    self.isOpen = args[3]
    self.NameColors = { "<color=#3d57aa>", "<color=#5d329d>", "<color=#c95f00>" }
    self:Init()
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_Sure, false)
    self.animator = self.go_table.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    self.first_ani = true
    self.point_relic = require "DungonesManager":GetInstance():GetRelicPostionToScreenPoint()
    self.outPosx, self.outPosy =
        _G.CS.UnityObjectExtends.ScreenPointToLocalPointInRectangle(
            _G.UIManager:GetInstance().UIRootRect,
            self.point_relic.x,
            self.point_relic.y,
            _G.UIManager:GetInstance().UICamera
        )
end

function DungonesGetRelicView:Init()
    self.Item1 = _G.GetAutoGoTable(self.go_table.obj_Item_1, _G.handlerbind(self, self.OnClickOneBtn, 1))
    self.Item2 = _G.GetAutoGoTable(self.go_table.obj_Item_2, _G.handlerbind(self, self.OnClickOneBtn, 2))
    self.Item3 = _G.GetAutoGoTable(self.go_table.obj_Item_3, _G.handlerbind(self, self.OnClickOneBtn, 3))
    local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
    local check = function(trans)
        if _G.IsNil(self.go_table) then
            _G.DestroyObject(trans)
        end
    end
    self.ItemList = { self.Item1, self.Item2, self.Item3 }
    self.items_qiwu = {}
    self.animators_qiwu = {}
    for index = 1, 3 do
        local id = self.RelicList[index]
        self.animators_qiwu[id] = {}
        self.items_qiwu[id] = {}
        ---@type mementos_cfg
        local cfg = _G.ConfigManager.mementos_cfg[id]
        local qiwu =
            self:AddComponent(
                self.ItemList[index].gameObject,
                QiwuView.New(
                    cfg,
                    self.ItemList[index].obj_Root,
                    _G.handlerbind(self, self.OnClickOneBtn, index),
                    function(ani, uieffectnode)
                        self.items_qiwu[id] = uieffectnode
                        self.animators_qiwu[id] = ani
                    end
                )
            )
        _G.UIUtils.LoadEffectByCfg(ui_effect_cfg.ef_SecretRealmSettlementView_xuanze,
            self.ItemList[index].obj_effectChoose, check)
    end
    self:InitOpenEffect()
end

function DungonesGetRelicView:InitOpenEffect()
    local check = function(trans)
        if _G.IsNil(self.go_table) then
            _G.DestroyObject(trans)
        end
    end
    local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
    _G.UIUtils.LoadEffectByCfg(ui_effect_cfg.ef_SecretRealmSettlementView_open, self.go_table.obj_effectOpen, check)
    _G.UIUtils.LoadEffectByCfg(ui_effect_cfg.ef_SecretRealmSettlementView_loop, self.go_table.obj_effectLoop, check)
    self.go_table.obj_effectOpen:SetActiveE(0)
    self.go_table.obj_effectLoop:SetActiveE(0)

    _G.DelayDo(
        0.133,
        function()
            if self:IsNil() then
                return
            end
            self.go_table.obj_effectOpen:SetActiveE(1)
        end
    )

    _G.DelayDo(
        0.266,
        function()
            if self:IsNil() then
                return
            end
            self.go_table.obj_effectLoop:SetActiveE(1)
        end
    )
end

function DungonesGetRelicView:OnClickOneBtn(index)
    if self.animators_qiwu[self.ChooseIndex] then
        self.items_qiwu[self.ChooseIndex].obj_uieffect:SetActiveE(0)
        self.ChooseMementos:SetLocalScale(0.84, 0.84, 1)
    end
    if self.ChooseMementos then
        self.ChooseMementos:SetLocalScale(0.84, 0.84, 1)
    end
    local id = self.RelicList[index]
    self.cur_index = index
    self.ChooseIndex = id
    self.items_qiwu[self.ChooseIndex].obj_uieffect:SetActiveE(1)
    --if self.first_ani then
    --    self.go_table.aorbtn_Sure:DOLocalMoveY(-360, 0.5):SetEase(_G.CS.DG.Tweening.Ease.Linear)
    --    self.first_ani = false
    --end
    self.ChooseMementos = self.ItemList[index].gameObject
    self.ChooseMementos:SetLocalScale(1, 1, 1)
    self.ChooseMementos:SetAsLastSiblingE()
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_Sure, true)
end

---主要界面点击事件
function DungonesGetRelicView:OnClickBtn(go, IsOn)
    if go == self.go_table.aorbtn_CloseView then
        -- self:Close()
    elseif go == self.go_table.aorbtn_Sure then
        for i= 1 ,3 do
            if i ~= self.cur_index then
                local CanvasGroup = self.ItemList[i].gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup))
                CanvasGroup.alpha = 1

                --- doFade第二个参数为从1变透明时间
                CanvasGroup:DOFade(0, 0.5):SetEase(_G.CS.DG.Tweening.Ease.Linear)
            else
                --- 参数为启动展示特效时间 目前为0.01
                _G.DelayDo(
                    0.01,
                    function()
                        if self:IsNil() then
                            return
                        end
                        self.ItemList[i].obj_effectChoose:SetActiveE(1)

                        --- 此数字为关闭界面的延时 也就是1秒后关闭
                        _G.DelayDo(
                            0.5,
                            function()
                                if self:IsNil() then
                                    return
                                end

                                if self.isOpen then
                                    -- ---@type roguelike.c2s_roguelike_choose_mementos
                                    -- local msg = {}
                                    -- msg.mementos = self.ChooseIndex
                                    require "DungonesModel":GetInstance():OpenChooseMementos(
                                        self.ChooseIndex,
                                        function(data)
                                            ---@type DG.Tweening.Sequence
                                            self.Sequence = _G.DOTween:Sequence()
                                            if self.waitPlayAni == nil then
                                                self.waitPlayAni = _G.coroutine.start(_G.handler(self,
                                                    self.CoOnProgressPlayAni))
                                            end
                                        end
                                    )
                                else
                                    ---@type roguelike.c2s_roguelike_choose_mementos
                                    local msg = {}
                                    msg.mementos = self.ChooseIndex
                                    require "DungonesNet":GetInstance():ChooseMementos(
                                        msg,
                                        function(data)
                                            ---@type DG.Tweening.Sequence
                                            self.Sequence = _G.DOTween:Sequence()
                                            if self.waitPlayAni == nil then
                                                self.waitPlayAni = _G.coroutine.start(_G.handler(self,
                                                    self.CoOnProgressPlayAni))
                                            end
                                            --遗物选择后加入增加战力
                                            self.MementosList = require "DungonesModel":GetInstance().MementosList
                                            _G.table.insert(self.MementosList, msg.mementos)
                                        end
                                    )
                                end
                            end
                        )
                    end
                )
            end
        end
    end
end

