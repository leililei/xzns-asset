---@class DungonesUntilTopView : UIBaseView	中文描述
---@field public go_table DungonesUntilTopView_GoTable GoTable
---@field infoData roguelike.i_top_info roguelike数据
---@field stepPanelList Component[] 所有步骤界面
local DungonesUntilTopView = _G.BaseClass("DungonesUntilTopView", _G.UIBaseView)
--_G.DungonesUntilTopView = DungonesUntilTopView
local stepList = {
    "DungonesUntilTopAwardView",
    "DungonesUntilTopMementosView",
    "DungonesUntilTopEventView"
}

function DungonesUntilTopView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param data roguelike.i_top_info
function DungonesUntilTopView:OnCreate(data, call)
    self.info = data
    self.stepPanelList = {}
    self.step = 1
    self.endStep = #stepList
    if self.info.choose_num == self.info.mementos_choose_num then
        self.step = 3
    elseif self.info.choose_num > 0 then
        self.step = 2
    end
    self:ShowView()
    self.call = call
end

function DungonesUntilTopView:ShowView()
    for i, v in pairs(self.stepPanelList) do
        if i ~= self.step then
            v.gameObject:SetActiveE(0)
        end
    end
    if not self.stepPanelList[self.step] then
        _G.PoolsManager:GetInstance():Spawn(
            "UIH5/Dungones/" .. stepList[self.step],
            _G.ePoolType.Temporary,
            self.transform,
            function(obj)
                if self:IsNil() then
                    _G.DestroyObject(obj)
                    return
                end
                self.stepPanelList[self.step] =
                    self:AddComponent(obj, require(stepList[self.step]).New(self.info, _G.handler(self, self.NextStep)))
            end
        )
    else
        self.stepPanelList[self.step].gameObject:SetActiveE(1)
    end
    self.go_table.slider_progress.value = (self.step - 1) / (self.endStep - 1)
end
---进入下一步骤
function DungonesUntilTopView:NextStep()
    self.step = self.step + 1
    if require "DungonesModel":GetInstance().isTime then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            1708,
            nil,
            function()
                self:Close()
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DungonesRuningView.Name)
                require "DungonesManager":GetInstance():ReturnMian()
            end
        )
        return
    end
    if self.step > self.endStep then
        require "DungonesModel":GetInstance().DungonesInfo.is_top = 2
        require "DungonesModel":GetInstance():GetDungonesInfo()
        --发送结算事件
        self:Close()
        if self.call then
            self.call()
        end
    else
        self:ShowView()
    end
end
return DungonesUntilTopView
