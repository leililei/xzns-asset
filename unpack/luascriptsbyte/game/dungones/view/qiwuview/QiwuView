---@class QiwuView : Component 中文描述
local QiwuView = _G.BaseClass("QiwuView", _G.Component)
function QiwuView:Awake()
    -- _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

local OrderBg = {
    "ImagesH5/hDungones/ui_qjhs_yw_fream_lan",
    "ImagesH5/hDungones/ui_qjhs_yw_fream_zi",
    "ImagesH5/hDungones/ui_qjhs_yw_fream_cheng"
}

---@param cfg table 奇物info
---@param parent UnityEngine.GameObject 父物体
---@param clickCall function 点击事件
function QiwuView:__init(cfg, parent, clickCall, othercall)
    self.ItemPath = "UIH5/Dungones/Qiwu"
    self.PropertyIcon = {
        [1] = "ui_js_renlei_icon",
        [2] = "ui_js_shouren_icon",
        [3] = "ui_js_jingling_icon",
        [4] = "ui_js_wangling_icon",
        [5] = "ui_js_renlei_icon",
        [6] = "ui_js_chuanqi_icon",
        [16] = "ui_js_multi16",   --人神
        [26] = "ui_js_multi26",   --兽神
        [36] = "ui_js_multi36",    --精神
        [46] = "ui_js_multi46"     --亡神
    }
    self.ProfessionalIcon = _G.ProfessionalIcon
    self.Quanbu = {
        "ui_js_all_btn"
    }
    self.NameColors = {"<color=#1461A8>", "<color=#612B8B>", "<color=#D2510B>"}
    self.cfg = cfg
    self.clickCall = clickCall
    self.othercall = othercall
    self.parent = parent
    self:Init()
end
function QiwuView:Show(cfg, parent, clickCall, othercall)
    self.cfg = cfg
    self.clickCall = clickCall
    self.othercall = othercall
    self.parent = parent
    self:Init()
end
function QiwuView:OnItemCardCall(trans, ref)
    self.gameObject = trans
    local item = _G.GetAutoGoTable(trans, _G.handlerbind(self, self.OnClickBtn, self.clickCall))
    self.go_table = item
    item.aortext_name.text =
        self.NameColors[self.cfg.quality] .. _G.LangUtil.GetLangPackValue(self.cfg.name) .. "</color>"
    if self.cfg.skills then
        local skillDesc = _G.ConfigManager.card_skills_cfg[self.cfg.skills].describe1
        item.aortext_desc.text = _G.LangUtil.GetLangPackValue(skillDesc)
    else
        item.aortext_desc.text = ""
    end
    item.aorrawimage_bg:LoadImage(OrderBg[self.cfg.quality])
    item.aorrawimage_icon:LoadImage(self.cfg.icon)
    local SpriteName
    if self.cfg.target[1] ~= 0 then
        SpriteName = self.PropertyIcon[self.cfg.target[1]]
    elseif self.cfg.target[2] ~= 0 then
        SpriteName = self.ProfessionalIcon[self.cfg.target[2]]
    else
        SpriteName = self.Quanbu[1]
    end
    item.aorimage_property.SpriteName = SpriteName
    self.animator = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    if self.othercall then
        self.othercall(self.animator, item)
    end
    _G.DelayDo(
        1,
        function()
            if not _G.IsNil(self.animator) then
                self.animator:SetBool("showNew", true)
            end
        end
    )
end
function QiwuView:Init()
    for i = 1, self.parent:GetChildCountE() do
        _G.PoolsManager:GetInstance():Despawn(self.parent:GetChildE(0), _G.ePoolType.UIItem)
    end
    _G.PoolsManager:GetInstance():Spawn(
        self.ItemPath,
        _G.ePoolType.UIItem,
        self.parent,
        _G.handler(self, self.OnItemCardCall)
    )
end
---主要界面点击事件
function QiwuView:OnClickBtn(go, IsOn, clickCall)
    if clickCall then
        clickCall()
    end
end

---销毁对象时,析构函数
function QiwuView:OnDestroy()
end
return QiwuView
