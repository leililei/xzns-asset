---@class DungonesNet : BaseGameNet	通信协议
local DungonesNet = _G.BaseClass("DungonesNet", require "BaseGameNet")
local base = require "BaseGameNet"

---@return DungonesNet DungonesNet
function DungonesNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求
---@param pbData table PB数据
---@param callback function 完成回调
function DungonesNet:GetInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_roguelike_info
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

