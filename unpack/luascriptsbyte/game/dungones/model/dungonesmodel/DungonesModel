function DungonesModel:AddPrivilege(id, isNotDispath)
    local cfg = _G.ConfigManager.dungeons_item_cfg[id]
    if cfg then
        require "PrivilegeManager":GetInstance():AddPrivilege(cfg.privilege[1], isNotDispath, true)
    end
end

