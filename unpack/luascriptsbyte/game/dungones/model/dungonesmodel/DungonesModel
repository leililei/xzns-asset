---检测千机是否有阵亡角色
function DungonesModel:CheckHpZero()
    local isHpZero = false
    if self.DungonesInfo and self.DungonesInfo.cards then
        local cards = self.DungonesInfo.cards
        for i = 1, #cards do
            local data = cards[i]
            if data and data.hp and data.hp <= 0 then
                isHpZero = true
            end
        end
    end

    return isHpZero
end

---检测藏品是否解锁
function DungonesModel:CheckCollectionIsUnLock(sid)
    if not self.CollectList then
        return false
    end
    return self.CollectList[sid]
end

function DungonesModel:UnLockCollection(tb, callback)
    require "DungonesNet":GetInstance():UnLockCollection(
        {
            dungeons_item = tb
        },
        _G.handlerbind(self, self.UnLockCollectionCall, tb, callback)
    )
end

function DungonesModel:UnLockCollectionCall(data, tb, callback)
    if data.ack ~= 1 then
        if callback then
            callback()
        end
        return
    end
    local count = #tb
    for i, v in ipairs(tb) do
        self.CollectList[v] = true
        if i == count then
            self:AddPrivilege(v)
        else
            self:AddPrivilege(v, false)
        end
    end
    if callback then
        callback()
    end
end

