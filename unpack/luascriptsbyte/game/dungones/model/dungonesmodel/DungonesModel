function DungonesModel:GetRanKInfo(msg, callback)
    self.rankpage = 8 --榜单类型
    self.rank_all_player = {}
    require("LingRankNet"):GetInstance():GetRankAllInfos(
        msg,
        function(data)
            self.rank_all_player = {}
            local rankIndex = self.myselfRank and self.myselfRank.player_mingci
