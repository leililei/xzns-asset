---当千机黑刹可以挑战时，增加提示红点 玩家只需要进入千机黑刹活动主界面一次，则本次登录不再提示
function DungonesModel:CheckRedPointHint()
    --检测千机是否开启
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(41) then
        return 0
    end
    --GM 创建号 检测下 关卡是否 达到
    local cfg = _G.ConfigManager.function_open_cfg[41]
    if not _G.GlobalConditionManager.CheckConditionByArray(cfg.condition_type) then
        return 0.
    end
    -- 检测本次登录是不是 进入了千机黑煞界面
    if self.isRedHint then
        return 0
    end
    --无数据
    if nil == self.DungonesInfo then
        return 0
    end
    --检测是否千机黑煞结算中
    if self.DungonesInfo.status then
    else
        return 0
    end
    if self.DungonesInfo.status == 2 then
        return 0
    end
    -- --检测未选择关卡
    if self.DungonesInfo.section == 0 then
        return 1
    end
    -- -- 千机黑煞 boss 是否挑战过
    -- local boss_num = _G.ConfigManager.discrete_cfg[103401][1][1]
    -- if self.DungonesInfo.fight_num < boss_num then
    --     return 0
    -- end
    --检测 选择了关卡
    local ShowList = {}
    ShowList = require "DungonesManager":GetInstance():GetShowList(self.DungonesInfo.difficulty)
    local section_max_id = ShowList[#ShowList]
    if self.DungonesInfo.section == section_max_id.id then
        return 0
    end
    if self.DungonesInfo.damage > 0 then
        return 0
    end
    return 1
end

