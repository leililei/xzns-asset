function DungonesModel:GetHPMPEmbattleEnemy(uid)
    local isHas = false
    local data
    if self.embattle_sectioninfo.defender_cards then
        local cards = self.embattle_sectioninfo.defender_cards
        for i = 1, #cards do
            if cards[i].uid == uid then
                data = cards[i]
                isHas = true
                break
            end
        end
        --没有找到卡牌 代表死亡
        if not isHas then
            data = {
                uid = uid,
                hp = 0,
                mp = 0
            }
            return data
        end
    else
        data = {
            uid = uid,
            hp = 10000,
            mp = 0
        }
    end
    if not isHas then
        data = {
            uid = uid,
            hp = 10000,
            mp = 0
        }
    end
    return data
end

