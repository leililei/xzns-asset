---boss 随机 技能
function DungonesModel:SetBossRandomSkill()
    local bossid = _G.ConfigManager.discrete_cfg[103404][1][1]
    local cfg = _G.ConfigManager.adventure_cfg
    local num = cfg[bossid].event_params[1][1] -- 技能个数
    local skills = cfg[bossid].event_params[2]
    for i = 1, #skills do
        local random = math.random(1, #skills)
        if _G.table.isEmptyOrNil(self.bossSkillRandom) then
            _G.table.insert(self.bossSkillRandom, random)
        else
            if random ~= self.bossSkillRandom[1] then
                _G.table.insert(self.bossSkillRandom, random)
            end
        end
        if #self.bossSkillRandom >= num then
            break
        end
    end
end

---拿千机数据
function DungonesModel:GetDungonesInfo(call)
    if require("DungonesManager"):GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Dungones) then
        local DungonesNet = require("DungonesNet")
        DungonesNet:GetInstance():GetInfo(_G.handlerbind(self, self.ParseData, call))
    else
        self:ParseData()
        if _G.AppSetting.DEBUG then
            _G.Log("<color=#ff0000>不满足公会开放等级，拿到不公会数据</color>")
        end
    end
end

function DungonesModel:GetServerData(call)
    if require("DungonesManager"):GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Dungones) then
        local DungonesNet = require("DungonesNet")
        DungonesNet:GetInstance():GetInfo(_G.handlerbind(self, self.ParseData, call))
    end
end

function DungonesModel:UpdateRebirth()
    local data = require "PrivilegeManager":GetInstance():GetPrivilegeData({_G.PrivilegeType.Dungones.Rebirth})
    if data[1] then
        self.rebirth = data[1] - self.DungonesInfo.rebirth
    else
        self.rebirth = 0
    end
end

---初始化遗物数据，用于战力数据加成显示
function DungonesModel:InitMementos(mementos)
    self.MementosList = {}
    for key, value in pairs(mementos) do
        _G.table.insert(self.MementosList, value)
    end
end

---外部调用方法,遗物战力加成
---@return num  number 遗物战力加持百分比
function DungonesModel:AddPower()
    if _G.table.isEmptyOrNil(self.MementosList) then
        return 0
    end
    local num = 0
    local cfg = _G.ConfigManager.mementos_cfg
    for key, value in pairs(self.MementosList) do
        --占据百分比计算
        local precent = tonumber(cfg[value].power_mul / 10000)
        num = num + precent
    end
    return num
end

---数据回调
---@param msg roguelike.s2c_roguelike_info 千机相关数据
function DungonesModel:ParseData(msg, call)
    if msg then
        if msg.status == 1 then
            self.isTime = false
        end
        if not _G.table.isEmptyOrNil(msg.mementos) then
            self:InitMementos(msg.mementos)
        end
        self.DungonesInfo = msg

        if _G.AppSetting.DEBUG then
            _G.Log(msg.status, "当前千机黑刹的开启状态是>>>>>>>")
        end
        if not self.DungonesInfo.is_top then
            self.DungonesInfo.is_top = -1
        end
        if self.DungonesInfo.adventures then
            _G.SortList(
                self.DungonesInfo.adventures,
                function(item)
                    return -item.section_sid
                end
            )
        else
            self.DungonesInfo.adventures = {}
        end
        --self:InitCollect()
        self:UpdateRebirth()
        self:InitHyAward()
        if self.DungonesInfo.adventures then
            for i = 1, #self.DungonesInfo.adventures do
                if _G.AppSetting.DEBUG then
                    _G.Log(self.DungonesInfo.adventures[i], "事件单条信息")
                end
            end
        end

        ---由引导配置触发式来完成调用，暂无需手动调用
        --镇魂街ZHJ-29489 【主任务】【0202】涉及程序单号ZHJ-29355
        --【客户端】千机黑刹阵亡条件
        -- local ishpz = self:CheckHpZero()
        -- if ishpz then
        --     _G.GuideManager:GetInstance():DoExternalPlay(guideId)
        -- end

        if _G.AppSetting.DEBUG then
            local main = _G.DeepCopy(msg)
            main.adventures = nil

            if _G.AppSetting.DEBUG then
                _G.Log(main, "主要信息")
            end
        end
    end
    self:InitPassCount()
    self:InitDungonesAidCards()
    self:InitDungonesCardBag()
    self.maxCount = 0
    if self.DungonesInfo.difficulty and self.DungonesInfo.difficulty > 0 and self.DungonesInfo.section > 0 then
        local cfg = _G.ConfigManager.dungeons_cfg[self.DungonesInfo.section]
        for _, v in pairs(_G.ConfigManager.dungeons_cfg) do
            if v.difficulty == self.DungonesInfo.difficulty and v.layer == cfg.layer and v.group > self.maxCount then
                self.maxCount = v.group
            end
        end
    else
        self.maxCount = #self.DungonesInfo.adventures
    end

    self.super.ParseData(self)
    if call then
        call()
    end
end

function DungonesModel:InitPassCount()
    self.passCountList = {}
    if self.DungonesInfo.pass_section then
        for _, v in pairs(self.DungonesInfo.pass_section) do
            self.passCountList[v] = true
        end
    end
end

---初始化援助的卡牌信息
function DungonesModel:InitDungonesAidCards()
    self.dungones_aid_cards = {}
    if self.DungonesInfo.aid_cards == nil then
        return
    end
    for i = 1, #self.DungonesInfo.aid_cards do
        local data = self.DungonesInfo.aid_cards[i]
        local card = _G.CardData.New()
        card:Parse(data)
        card:OnInitMutuallyData(true)
        _G.table.insert(self.dungones_aid_cards, card)
    end
end

---清理援助卡牌身上的装备（从 equipmodel.PartsList 中删除）
function DungonesModel:ClealAidCardEquip()
    if self.dungones_aid_cards then
        for i = 1, #self.dungones_aid_cards do
            local card = self.dungones_aid_cards[i]
            for key, equip in pairs(card.EquipBar) do
                if not table.isEmptyOrNil(equip) then
                    --("清楚助战的卡牌的装备")
                    require("EquipmentModel"):GetInstance():SubPartsList(equip, card.uid)
                end
            end
        end
    end
end

---是否在结算中或者没开
function DungonesModel:IsSettle()
    if nil == self.DungonesInfo then
        return true
    end
    return self.DungonesInfo.next_reset_time <= _G.TimeUtil.GetServerUnixTime() and
        _G.TimeUtil.GetServerUnixTime() <=
            self.DungonesInfo.next_reset_time + _G.ConfigManager.discrete_cfg[103402][1][1]
end

function DungonesModel:InitDungonesCardBag()
    self.dungones_card_bag = {}
    for i = 1, #self.dungones_aid_cards do
        _G.table.insert(self.dungones_card_bag, self.dungones_aid_cards[i])
    end
    local cardslist = _G.StorageManager:GetInstance():GetCardDataSortList()
    for i = 1, #cardslist do
        _G.table.insert(self.dungones_card_bag, cardslist[i])
    end
end

function DungonesModel:GetDungonesCardBag()
    return self.dungones_card_bag
end

---初始化藏品
function DungonesModel:InitCollect()
    self.CollectList = {}
    if self.DungonesInfo.item then
        local count = #self.DungonesInfo.item
        for i, v in ipairs(self.DungonesInfo.item) do
            self.CollectList[v] = true
            if not self.isInitPrivilege then
                if i == count then
                    self:AddPrivilege(v)
                else
                    self:AddPrivilege(v, false)
                end
            end
        end
    end
    self.isInitPrivilege = true
end

