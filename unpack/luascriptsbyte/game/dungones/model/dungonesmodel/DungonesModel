---是否通关关卡
function DungonesModel:IsPassLevelByEventId(sid)
    ---@type dungeons_cfg
    local cfg = _G.ConfigManager.dungeons_cfg[sid]
    ---如果是起点就默认通过了
    if #cfg.event <= 0 then
        return true
    end
    if self:CheckUnselectedMementoIsLastSectionByLayer() then
        if sid == self.DungonesInfo.unselected_mementos_section then
            return true
        end
    end
    return self.passCountList[sid]
