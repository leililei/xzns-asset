            return true
        end
    end
    return false
end

---检测跳过开启的通关次数条件是否达成
function DungonesModel:CheckEndBossCanSkip()
    local passNumCon = _G.ConfigManager.discrete_cfg[120015][1][1]
    if self.DungonesInfo.pass_times < passNumCon then
        return false, _G.GetLangPackValue(90024500016, passNumCon)
    end
    local params = _G.ConfigManager.discrete_cfg[115604]
    local unlock, content = _G.GlobalConditionManager.CheckConditionArraysCustomUnlockTip(params)
    return unlock, content
