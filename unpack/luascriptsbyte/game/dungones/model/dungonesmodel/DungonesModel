---检测挑战事件 是否可以碾压
function DungonesModel:CheckFastPass(CurEventId, defender_team)
    local eventtype = _G.ConfigManager.adventure_cfg[CurEventId].event_type
    if eventtype == _G.DungonesEventType.boss then
        return true
    end
    local EmbattleModelIns = require("EmbattleModel"):GetInstance()
    local EmbattleData = EmbattleModelIns:GetEmbattleData(_G.EmbattleType.dungones) or {}
    local mpower = 0
    local isEmptyOrNil = _G.table.isEmptyOrNil
    if not _G.table.isEmptyOrNil(EmbattleData) then
        local itemType = require(_G.EmbattleControllerItemType.dungones)
        local item = itemType.New(_G.EmbattleType.dungones)
        mpower = item:GetMyEmbattlePower(1)
        ---检测任务阵容是否需要改变
        local StorageManager = _G.StorageManager:GetInstance()
        local data
        for i, v in pairs(EmbattleData) do
            if v > 0 then
                data = StorageManager:GetDatasByUid(_G.StorageID.Card, v)
                if isEmptyOrNil(data) and not self:CheckIsDungonesCard(v) then
                    EmbattleData[i] = 0
                end
            end
        end
    end
    local epower = defender_team[1].power or 0
    if mpower < epower then
        EmbattleModelIns:SaveEmbattleDataNew(
            _G.EmbattleType.dungones,
            function()
                return false
            end,
            0,
            false,
            EmbattleData
        )
        return true
    else
        local StorageManager = _G.StorageManager:GetInstance()
        local isChange = false
        if EmbattleModelIns:CheckEmbattleData(_G.EmbattleType.dungones) then
            --问题：第一次进入千机黑煞，服务器没有布阵数据，需要发送布阵数据
            --当玩家战斗力超过当前守卫时，按钮变成碾压，点击碾压则直接获取该关卡奖励 ZHJ-14342【客户端】千机黑刹系统优化

            local data
            for i, v in pairs(EmbattleData) do
                if v > 0 then
                    data = StorageManager:GetDatasByUid(_G.StorageID.Card, v)
                    if isEmptyOrNil(data) and not self:CheckIsDungonesCard(v) then
                        EmbattleData[i] = 0
                        isChange = true
                    end
                end
            end
        else
            EmbattleData = EmbattleModelIns:GetEmbattleData(_G.EmbattleType.AFKOnly)
            local data
            for i, v in pairs(EmbattleData) do
                if v > 0 then
                    data = StorageManager:GetDatasByUid(_G.StorageID.Card, v)
                    if isEmptyOrNil(data) then
                        EmbattleData[i] = 0
                        isChange = true
                    end
                end
            end
        end
        EmbattleModelIns:SaveEmbattleDataNew(
            _G.EmbattleType.dungones,
            function()
                return false
            end,
            0,
            false,
            EmbattleData
        )
    end
end

