---怪物的 动态数据 进行整理
---@param adventures table 动态怪物数据（战斗）
---@field  adventure i_adventure 事件信息 section_sid ==  关卡id sid == 事件id
function DungonesModel:DisposalDateAdventure(adventures)
    if _G.table.isEmptyOrNil(adventures) then
        --
        if _G.AppSetting.DEBUG then
            _G.Log("<color=#ff0000>千机黑煞动态怪物数据是个  空 </color>")
        end
    end
    if self.DungonesInfo.adventures then
        for i = 1, #adventures do
            local adve, index = self:GetAdventureByLevel(adventures[i].section_sid)
            if adve then
                self.DungonesInfo.adventures[index] = adventures[i]
            end
        end
    else
        self.DungonesInfo.adventures = {}
        self.DungonesInfo.adventures = adventures
    end
end

