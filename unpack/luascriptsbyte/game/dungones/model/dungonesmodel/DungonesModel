--region 对外接口 点击排行回放
---@param playerName? string 左侧显示的玩家名称(如不传则取战报中名称)
---@param monsterName? string 右侧显示的名称
function DungonesModel:PlayRankHuiFang(rankid, playeruid, call, playerName, monsterName)
    local msg = {}
    msg.type = rankid
    msg.uid = playeruid
    require "LingRankNet":GetInstance():GetRankReport(
        msg,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            --左边显示的名称
            local leftName, rightName = "", ""
            if playerName and #playerName > 0 then
                leftName = playerName
            elseif msg and msg.arg then
                leftName = msg.arg.attacker_team[1].name
            end

            --右边显示的名称
            if monsterName and #monsterName > 0 then
                rightName = monsterName
            elseif rankid == 8 then
                --千机黑煞
                local bossEventIdCfg = _G.ConfigManager.discrete_cfg[103404]
                local bossEventCfg = bossEventIdCfg and _G.ConfigManager.adventure_cfg[bossEventIdCfg[1][1]] or nil
                if bossEventCfg then
                    rightName = _G.GetLangPackValue(bossEventCfg.name)
                else
                    rightName = _G.GetLangPackValue(90024500010) --策划说boss名字写死语言表id
                end
            elseif rankid == 18 then
                --赛季boss
                local rightNameId = require("FirstTestBossModel"):GetInstance():GetSeasonBossName()
                rightName = rightNameId and rightNameId > 0 and _G.GetLangPackValue(rightNameId) or ""
            elseif rankid == 4 then
                --龙之试炼(右边为多个boss的名称)
                rightName = require("WorldBossManager"):GetInstance():GetBossName()
            end

            self.fight_arg = msg.arg
            self:UpdateData1(_G.BattleManager:GetInstance():GetStatisticsRecord(msg.arg), leftName, rightName)
            if call then
                call()
            end
        end
    )
end

