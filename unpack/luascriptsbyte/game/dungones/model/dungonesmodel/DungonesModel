---放置挂机通过 检测藏品是否可以激活
function DungonesModel:AfkPassLockCollecion()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(41) then
        return
    end
    if not self.CollectList then
        return
    end
    if self.DungonesInfo then
        if self.DungonesInfo.status == 2 then
            return
        end
    end
    local cfgs = _G.ConfigManager.dungeons_item_cfg
    local keys = _G.table.keys(cfgs)
    _G.table.sort(
        keys,
        function(a, b)
            return a < b
        end
    )
    local count = #keys
    local sidQue = {}
    for i = 1, count do
        local cfg = _G.ConfigManager.dungeons_item_cfg[keys[i]]
        if
            not DungonesModel:CheckCollectionIsUnLock(keys[i]) and not _G.table.isEmptyOrNil(cfg.mission_extra) and
                _G.GlobalConditionManager.CheckCondition(cfg.mission_extra[1], cfg.mission_extra[2])
         then
            _G.table.insert(sidQue, keys[i])
        end
    end
    if #sidQue > 0 then
        self:UnLockCollection(sidQue)
    end
end

