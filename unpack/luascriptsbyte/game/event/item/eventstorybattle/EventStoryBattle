---@class EventStoryBattle	中文描述
---@field cfg main_event_cfg
local EventStoryBattle = _G.BaseClass("EventStoryBattle", _G.EventBase)

---类的构造函数
function EventStoryBattle:__init()
end

---类的析构函数
function EventStoryBattle:Dispose()
end

function EventStoryBattle:CheckStart()
    if not self:CheckLocal() then
        self:PlayTips()
        if self.doneCallback then
            self.doneCallback(false, true)
        end
        return
    end
    _G.EventBase.CheckStart(self)
end
function EventStoryBattle:Doing()
    self.curState = _G.EventItemState.Doing
    ---判断战斗事件是否配置了场景怪的id，如果不为nil则通过怪去触发战斗
    if self.cfg.complete_params[2] ~= nil then
        ---@type WorldEnemyItem
        local enemyItem =
            _G.WorldManager:GetInstance():GetCurWorld():GetItemInfo(tonumber(self.cfg.complete_params[2][1]))
        if enemyItem then
            enemyItem:OnInteractedStoryEnd()
        end
    else
        _G.BattleManager:GetInstance():EnterFight(
            _G.BattleControllerType.event,
            self.cfg.ID,
            _G.handler(self, self.End)
        )
    end
end

function EventStoryBattle:End(success)
    if success then
        _G.EventBase.End(self, success)
    else
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
        self.curState = _G.EventItemState.Pause
        if self.doneCallback then
            self.doneCallback(false, true)
        end
    end
end

return EventStoryBattle
