---类的构造函数
function EventGameMazeGridData:__init()
    self.gridid = 0
    self.grid_pos_map = {x = 0, y = 0}
    self.gird_pos_unity = {x = 0, y = 0}
    self.Maze_Grid_type = _G.GameGridEnum_Maze.groundgrid
    self.Maze_move_type = _G.GameGrid_Maze_Move_Enum.move
    self.maze_click_type = _G.GameGrid_Maze_Click_Enum.noonClick
    self.f_distance = 0
    self.g_distance = 0
    self.parent_node = {}
    self.h_distance = 0
    self.icon = {}
end
---类的析构函数
function EventGameMazeGridData:Dispose()
end

function EventGameMazeGridData:ParseInitMsg(data)
    self:SetMazeGridId(data.id)
    self:SetMazeGridPosMap(data.map.x, data.map.y)
    self:SetMazeGridPosUnity(data.u_unity.x, data.u_unity.y)
    self:SetMazeGridType(data.gridtype)
    self:SetMazeMoveType(data.movetype)
    self:SetMazeClickType(data.clicktype)
    --self.SetParentNode(data.parent)
end
