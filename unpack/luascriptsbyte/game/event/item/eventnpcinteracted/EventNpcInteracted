local base = require "EventBase"
---@class EventNpcInteracted	中文描述
local EventNpcInteracted = _G.BaseClass("EventNpcInteracted", base)

---类的构造函数
function EventNpcInteracted:__init()
    self.curStoryIndex = 0
end

---类的析构函数
function EventNpcInteracted:Dispose()
    self.storyIDs = nil
    self.curStoryIndex = nil
end

function EventNpcInteracted:Doing()
    self.curState = _G.EventItemState.Doing
    if not self.storyIDs then
        self.storyIDs = _G.DeepCopyCfgTable(self.cfg.complete_params)
    end
    self:PlayStory(self.storyIDs)
end
---播放剧情
---@param storyIDs table 剧情组(二维数组)
function EventNpcInteracted:PlayStory(storyIDs)
    local player = _G.WorldManager:GetInstance():GetCurWorldPlayer()
    player:SetTransformLock(true)
    self.curStoryIndex = self.curStoryIndex + 1
    local index = 1
    local playstory
    playstory = function()
        if storyIDs[self.curStoryIndex][index] then
            _G.AutomaticPlayStory.PlayStoryByID(
                _G.tonumber(storyIDs[self.curStoryIndex][index]),
                function()
                    index = index + 1
                    playstory()
                end
            )
        else
            player:SetTransformLock(false)
            if self.curStoryIndex == #self.storyIDs then
                self.curState = _G.EventItemState.Done
                self:End(true)
            else
                self:End(false)
            end
        end
    end
    playstory()
end

return EventNpcInteracted
