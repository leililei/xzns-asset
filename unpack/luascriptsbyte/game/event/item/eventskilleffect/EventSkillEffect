local base = require "EventNpcInteracted"
---@class EventSkillEffect	中文描述
local EventSkillEffect = _G.BaseClass("EventSkillEffect", base)
---被砸中的间隔时间
local hurtInterveTime = 0.5
---类的构造函数
function EventSkillEffect:__init()
    self.isfail = nil
end

---类的析构函数
function EventSkillEffect:Dispose()
    self.hurtTimes = nil
    self.isfail = nil
    self.hurtCount = nil
    self.per = nil
    self.hurtTimer = nil
end

function EventSkillEffect:Doing()
    self.isfail = self.isfail ~= nil and self.isfail or false
    self.curState = _G.EventItemState.Doing
    local storyIDs = _G.DeepCopyCfgTable(self.cfg.complete_params)
    local timesAndPer = _G.table.remove(storyIDs, 1)
    self.hurtTimes = 0
    self.hurtCount = _G.tonumber(timesAndPer[1])
    self.per = timesAndPer[2] and _G.tonumber(timesAndPer[2]) or 0
    _G.Events:GetInstance():AddListener(_G.WorldItemManager.ItemEvent.skillEffectHurt, self.OnPlayerHurt, self)
    _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name):ShowTouchOnly(true)
    self:PlayStory(storyIDs)
end

function EventSkillEffect:PlayStory(storyIDs)
    local index = 1
    local count = 0
    local playstory
    playstory = function()
        local isPlayStory = false
        for i = 1, #storyIDs do
            if storyIDs[i][index] then
                count = count + 1
                isPlayStory = true
                _G.AutomaticPlayStory.PlayStoryByID(
                    _G.tonumber(storyIDs[i][index]),
                    function()
                        if self.isfail then
                            return
                        end
                        count = count - 1
                        if count <= 0 then
                            index = index + 1
                            playstory()
                        end
                    end
                )
            end
        end
        if not isPlayStory and count <= 0 then
            _G.Events:GetInstance():RemoveListener(
                _G.WorldItemManager.ItemEvent.skillEffectHurt,
                self.OnPlayerHurt,
                self
            )
            self.curState = _G.EventItemState.Done
            _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name):ShowTouchOnly(false)
            self:End(true)
        end
    end
    playstory()
end

function EventSkillEffect:OnHurtInterveTimeCall()
    self.hurtTimer = nil
end

function EventSkillEffect:OnPlayerHurt()
    if self.hurtTimer then
        return
    end
    self.hurtTimer = _G.TimerManager:GetInstance():GetTimer(hurtInterveTime, self.OnHurtInterveTimeCall, self, true)
    self.hurtTimer:Start()
    self.hurtTimes = self.hurtTimes + 1
    if self.per > 0 then
        _G.UIManager:GetInstance():OpenWindow(
            "EventRecoverHpView",
            {-self.per / 100},
            (self.hurtTimes - 1) * self.per / 100
        )
        return
    end
    if self.hurtTimes >= self.hurtCount then
        _G.Events:GetInstance():RemoveListener(_G.WorldItemManager.ItemEvent.skillEffectHurt, self.OnPlayerHurt, self)
        self.isfail = true
        _G.StoryManager:GetInstance():StorySkipNoCall()
        self.curState = _G.EventItemState.Done
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
            false,
            nil,
            function()
                _G.ChapterRoomManager:GetInstance():ResetCurRoom()
            end,
            false
        )
        self:End(false)
    end
end

function EventSkillEffect:End(success)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
    if self.per > 0 or success then
        if _G.PlayerModel:GetInstance():CheckCreateRole() then
            require("EventNet"):GetInstance():AccessDoneEvent(
                self.cfg.ID,
                _G.handler(self, self.EndEvent),
                self.hurtTimes
            )
        else
            self:EndEvent({})
        end
    else
        self.curState = _G.EventItemState.Pause
    end
end

function EventSkillEffect:EndEvent(msg)
    _G.ChapterRoomManager:GetInstance():SetCardBaseData(msg.cards)
    -- if self.per > 0 then
    --     _G.UIManager:GetInstance():OpenWindow("EventRecoverHpView", {-self.hurtTimes * self.per / 100})
    -- end
    base.EndEvent(self, msg)
end

return EventSkillEffect
