require "EventViewBase"

---@class EventOpenView	中文描述
local EventOpenView = _G.BaseClass("EventOpenView", _G.EventBase)

---类的构造函数
function EventOpenView:__init()
end

---类的析构函数
function EventOpenView:Dispose()
end

function EventOpenView:Doing()
    self.curState = _G.EventItemState.Doing
    local viewName = self.cfg.complete_params[1][1]
    local params = _G.DeepCopyCfgTable(self.cfg.complete_params)
    _G.table.remove(params, 1)
    _G.UIManager:GetInstance():OpenWindow(
        viewName,
        _G.handler(self, self.DoneEvent),
        _G.handler(self, self.CloseView),
        params
    )
end

function EventOpenView:CloseView()
    if self.curState == _G.EventItemState.Done then
        self:End(true)
    else
        self.curState = _G.EventItemState.Pause
        self:End(false)
    end
end

function EventOpenView:DoneEvent()
    self.curState = _G.EventItemState.Done
end

return EventOpenView
