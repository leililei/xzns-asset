require "BaseGameNet"

---@class EventNet : BaseGameNet	通信协议
local EventNet = _G.BaseClass("EventNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return EventNet EventNet
function EventNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function EventNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    if callback then
        self.Call[port] = callback
    end
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function EventNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

-----接收事件
---@param sid number 事件sid
---@param callback function 回调方法
function EventNet:AccessAcceptEvent(sid, callback)
    self:Access(_G.ConfigManager.net_map.game_instance_accept_event, {sid = sid}, callback)
end

------完成事件
---@param sid number 事件sid
---@param callback function 回调方法
---@param num number number参数
function EventNet:AccessDoneEvent(sid, callback, num)
    local port = self:Access(_G.ConfigManager.net_map.game_instance_event, {sid = sid, args = num}, callback)
end
---@type EventNet
return EventNet
