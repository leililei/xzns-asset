---@class EventBase	中文描述
---@field cfg main_event_cfg
local EventBase = _G.BaseClass("EventBase")
_G.EventBase = EventBase

---类的构造函数
function EventBase:__init()
    self.curState = _G.EventItemState.UnAccept
end

---类的析构函数
function EventBase:Dispose()
end

function EventBase:Init(cfg, doneCall)
    self.cfg = cfg
    self.doneCallback = doneCall
    if self.curState < _G.EventItemState.Accept then
        self:CheckStart()
    end
end
-----本地检测
---@return boolean 是否可以接受
function EventBase:CheckLocal()
    return _G.GlobalConditionManager.CheckConditionArrays(self.cfg.trigger_params)
end

function EventBase:PlayTips()
    if #self.cfg.tips_interaction > 1 then
        if self.cfg.tips_interaction[1] == 2 then
            _G.PopWindowManager:GetInstance():ShowAllTips(self.cfg.tips_interaction[2])
        else
            _G.AutomaticPlayStory.PlayStoryByID(self.cfg.tips_interaction[2])
        end
    end
end

-----检测开始
function EventBase:CheckStart()
    if not self:CheckLocal() then
        self:PlayTips()
        if self.doneCallback then
            self.doneCallback(false)
        end
        return
    end
    local function startevent()
        self.curState = _G.EventItemState.Accept
        self:Start()
    end
    if self.curState == _G.EventItemState.Pause then
        startevent()
    else
        if _G.PlayerModel:GetInstance():CheckCreateRole() then
            require("EventNet"):GetInstance():AccessAcceptEvent(
                self.cfg.ID,
                function(msg)
                    if msg.ack == 1 then
                        startevent()
                    else
                        self:PlayTips()
                    end
                end
            )
        else
            startevent()
        end
    end
end

function EventBase:Start()
    if self.curState == _G.EventItemState.Doing then
        return
    end
    if not _G.table.isEmptyOrNil(self.cfg.default_bubbles_plot) then
        local cfg = _G.DeepCopyCfgTable(self.cfg.default_bubbles_plot)
        local npcID
        local npc
        for _, v in pairs(cfg) do
            npcID = _G.table.remove(v, 1)
            npc = _G.WorldManager:GetInstance():GetCurWorld():GetItemInfo(npcID)
            if npc then
                npc.BubblesIsOn = false
                npc:CheckNormalBubbles(v, 105003, npc)
            end
        end
    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
    local player = _G.WorldManager:GetInstance():GetCurWorldPlayer()
    player:NavInterruptMove()
    if self.curState < _G.EventItemState.Pause and self.cfg.complete_before > 0 then
        local storyAction = _G.AutomaticPlayStory.New()
        storyAction:Play(self.cfg.complete_before, _G.handler(self, self.Doing))
    else
        self:Doing()
    end
end

function EventBase:End(success)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
    if success then
        if _G.PlayerModel:GetInstance():CheckCreateRole() then
            require("EventNet"):GetInstance():AccessDoneEvent(self.cfg.ID, _G.handler(self, self.EndEvent))
        else
            self:EndEvent({})
        end
    else
        self.curState = _G.EventItemState.Pause
        if self.doneCallback then
            self.doneCallback(false)
        end
    end
end

function EventBase:EndEvent(msg)
    _G.EventManager:GetInstance():SetEventDone(self.cfg.ID, false)
    if self.cfg.complete_plot > 0 then
        local player = _G.WorldManager:GetInstance():GetCurWorldPlayer()
        player:SetTransformLock(true)
        _G.AutomaticPlayStory.PlayStoryByID(self.cfg.complete_plot, _G.handler(self, self.EventCompletePlotEndCall))
    else
        self:EventCompletePlotEndCall()
    end
    self.curState = _G.EventItemState.UnAccept
    if not _G.table.isEmptyOrNil(msg.award) and not _G.table.isEmptyOrNil(msg.award.item) then
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
        require("CommonTipManager"):GetInstance():OpenDropTip(msg)
        _G.ChapterRoomManager:GetInstance():SaveSectionAward(_G.StorageManager:GetInstance():MergeAward(msg))
    end
    if msg.cards then
        _G.ChapterRoomManager:GetInstance():SetCardBaseData(msg.cards)
    end
    if not _G.table.isEmptyOrNil(self.cfg.default_bubbles_plot_after) then
        local cfg = _G.DeepCopyCfgTable(self.cfg.default_bubbles_plot_after)
        local npcID
        local npc
        for _, v in pairs(cfg) do
            npcID = _G.table.remove(v, 1)
            npc = _G.WorldManager:GetInstance():GetCurWorld():GetItemInfo(npcID)
            if npc then
                npc.BubblesIsOn = false
                npc:CheckNormalBubbles(v, 105003, npc)
            end
        end
    end
end

function EventBase:EventCompletePlotEndCall()
    local player = _G.WorldManager:GetInstance():GetCurWorldPlayer()
    player:SetTransformLock(false)
    if self.doneCallback then
        self.doneCallback(true)
    end
    if self.cfg.finish_plot > 0 then
        _G.AutomaticPlayStory.PlayStoryByID(self.cfg.finish_plot)
    end
end

-----实际的执行逻辑函数，由子类重写
function EventBase:Doing()
    self.curState = _G.EventItemState.Doing
end

--region 创建事件对象

local EventItemScriptName = {
    [16] = "EventNpcInteracted",
    [17] = "EventOpenView",
    [18] = "EventStoryBattle",
    [19] = "EventSkillEffect",
    [20] = "EventOpenView"
}
local function CreateEventItem(_type, cfg, doneCall)
    if EventItemScriptName[_type] then
        local script = require(EventItemScriptName[_type]).New()
        script:Init(cfg, doneCall)
        return script
    end
    return nil
end

function EventBase.Create(id, doneCall)
    if not id or _G.type(id) ~= "number" then
        if _G.AppSetting.DEBUG then
            _G.LogError("传入的事件id错误,请检查 id = " .. (id and id or "nil"))
        end
        return
    end
    local cfg = _G.ConfigManager.main_event_cfg[id]
    if not cfg then
        if _G.AppSetting.DEBUG then
            _G.LogError("未找到对应的事件，ID=" .. id)
        end
        return
    end
    local script = CreateEventItem(cfg.event_type, cfg, doneCall)
    if script then
        return script
    end

    if _G.AppSetting.DEBUG then
        _G.LogError("对应类型的事件没有实现功能，请检查配置类型是否正确!或者咨询程序是否实现该事件类型功能")
    end
    return nil
end

--endregion

return EventBase
