require "EventNet"
require "EventViewBase"
require "EventBase"

local EventDoneListenerKey = "EventDoneListenerKey"

---@class EventManager : Singleton	中文描述
local EventManager = _G.BaseClass("EventManager", _G.Singleton)
_G.EventManager = EventManager

---@return EventManager EventManager
function EventManager:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function EventManager:__init()
    self.eventTable = {}
    self.eventDoneIDTable = {}
    self.eventTemporaryDoneIDTable = {}
end

---销毁对象时,析构函数
function EventManager:Dispose()
    self.eventTable = nil
    self.eventDoneIDTable = nil
end

--region 对外接口

function EventManager:InitEventData(data)
    if data and #data > 0 then
        for i = 1, #data do
            self:SetEventDone(data[i], true)
        end
    end
end

-----开始事件
---@param id number 事件ID
---@param doneCall function 事件完成回调方法
---@return boolean 是否成功开始事件
function EventManager:StartEvent(id, doneCall)
    if self.eventDoneIDTable[id] or self.eventTemporaryDoneIDTable[id] then
        return false
    end
    if self.eventTable and self.eventTable[id] then
        self.eventTable[id]:CheckStart()
        return true
    end
    local item = _G.EventBase.Create(id, doneCall)
    if item then
        self.eventTable[id] = item
        return true
    end
    return false
end

-----设置完成事件
---@param id number 事件ID
function EventManager:SetEventDone(id, istemporary)
    if istemporary then
        self.eventTemporaryDoneIDTable[id] = _G.EventItemState.Done
    else
        self.eventDoneIDTable[id] = _G.EventItemState.Done
    end

    _G.Events:GetInstance():Broadcast(EventDoneListenerKey, id)
end
-----获取事件是否完成
---@param id number 事件ID
---@return boolean 是否完成
function EventManager:GetEventDone(id)
    local done = self.eventDoneIDTable[id] and self.eventDoneIDTable[id] == _G.EventItemState.Done or false
    if not done then
        done =
            self.eventTemporaryDoneIDTable[id] and self.eventTemporaryDoneIDTable[id] == _G.EventItemState.Done or false
    end
    return done
end

---清理事件数据
---@param 变量名 变量类型 中文描述
---@return 变量类型 中文描述
function EventManager:ClearEventData()
    self.eventTemporaryDoneIDTable = {}
    self.eventTable = {}
    self.eventDoneIDTable = {}
end

--- 添加事件完成监听
---@param func function 响应函数
---@param obj table 包含响应函数的Lua对象，参数2必须为为参数3的成员方法
function EventManager:AddEventDoneListener(func, obj)
    _G.Events:GetInstance():AddListener(EventDoneListenerKey, func, obj)
end

--- 移除事件完成监听
---@param func function 响应函数
---@param obj table 包含响应函数的Lua对象，参数2必须为为参数3的成员方法
function EventManager:RemoveEventDoneListener(func, obj)
    _G.Events:GetInstance():RemoveListener(EventDoneListenerKey, func, obj)
end
--endregion
