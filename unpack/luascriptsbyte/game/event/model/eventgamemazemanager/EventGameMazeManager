---@class EventGameMazeManager : Singleton	中文描述
local EventGameMazeManager = _G.BaseClass("EventGameMazeManager", _G.GameDataModelBase)
_G.EventGameMazeManager = EventGameMazeManager

local CS = _G.CS
local typeof = _G.typeof

---销毁对象时,析构函数
function EventGameMazeManager:Dispose()
end
function EventGameMazeManager:GetDataFormServer()
    self.super.ParseData(self)
end
---初始化
---初始化地图，有几张地图，当前地图id
function EventGameMazeManager:InitMapData(id_lists, call)
    local id = id_lists[1]
    require("EventGameMazeMap"):GetInstance():SetMaxMapLimit(#id_lists)
    require("EventGameMazeMap"):GetInstance().mapid_lists = id_lists
    require("EventGameMazeMap"):GetInstance().isfirst = true
    id = tonumber(id)
    self:InitMap(id)
end
---@param id table 地图id
---@param call function 回调刷新界面
function EventGameMazeManager:InitMap(id, call)
    require("Map_A_star"):GetInstance():InitMap(id)
    if call then
        call()
    end
end
function EventGameMazeManager:FindRoads(startGrid, endGrid)
    -- if endGrid:GetMazeGridType() == _G.GameGridEnum_Maze.destination then
    --     return
    -- end
    local roads = {}
    local mapstart_pos = startGrid:GetMazeGridPosMap()
    local mapend_pos = endGrid:GetMazeGridPosMap()
    roads = require("Map_A_star"):GetInstance():FindRoad(mapstart_pos, mapend_pos)
    --self:ResetMapDataStart(startGrid, endGrid)
    return roads
end
---重新设置起点
function EventGameMazeManager:ResetMapDataStart(OreStart, RestStart)
    local mapData = require("EventGameMazeMap"):GetInstance().mapData
    local pos = OreStart:GetMazeGridPosMap()
    local gridData = mapData[pos.x][pos.y]
    gridData:SetMazeGridType(_G.GameGridEnum_Maze.groundgrid1)
    pos = RestStart:GetMazeGridPosMap()
    gridData = mapData[pos.x][pos.y]
    gridData:SetMazeGridType(_G.GameGridEnum_Maze.startgrid)
    gridData:SetMazeClickType(_G.GameGrid_Maze_Click_Enum.bukeyi)
end
return EventGameMazeManager
