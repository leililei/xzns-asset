---@class EventViewBase : UIBaseView	中文描述
---@field public go_table EventViewBase_GoTable GoTable
local EventViewBase = _G.BaseClass("EventViewBase", _G.UIBaseView)

function EventViewBase:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function EventViewBase:OnCreate(doneCall, closeCall)
    self.doneCallback = doneCall
    self.closeCallback = closeCall
end

---按钮点击事件在这里派发
function EventViewBase:OnClickBtn(go)
end

-----事件完成调用(由子类根据具体的逻辑调用)
function EventViewBase:OnEventDone()
    if self.doneCallback then
        self.doneCallback()
    end
end

function EventViewBase:Close()
    _G.UIBaseView.Close(self)
    if self.closeCallback then
        self.closeCallback()
    end
end

return EventViewBase
