local base = require "EventViewBase"
---@class EventSealHighView : EventViewBase	中文描述
---@field public go_table EventSealHighView_GoTable GoTable
local EventSealHighView = _G.BaseClass("EventSealView", base)

function EventSealHighView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.objEffects = {
        self.go_table.aorbtn_left,
        self.go_table.aorbtn_right,
        self.go_table.aorbtn_up,
        self.go_table.aorbtn_down
    }
end

function EventSealHighView:OnEnable()
    self.click = true
    self.go_table.obj_seal:SetActiveE(1)
    if not _G.IsNil(self.step1EffectObj) then
        self.step1EffectObj:DestroyObject()
    end
    self.curWordIndex = 1
    self.curRandomWord = {}
    local words = {1, 2, 3, 4}
    local index = 0
    for i = 1, 3 do
        index = _G.Mathf.Random(1, #words)
        _G.table.insert(self.curRandomWord, _G.table.remove(words, index))
    end
    _G.table.insert(self.curRandomWord, _G.table.remove(words, 1))
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.EventEffect_sifu02,
        self.go_table.obj_bgParent,
        function(trans)
            self:RandomWordClick()
        end
    )
end

function EventSealHighView:OnDisable()
    if not _G.IsNil(self.step1EffectObj) then
        self.step1EffectObj:DestroyObject()
    end
    if self.clickTimer then
        _G.coroutine.stopwaiting(self.clickTimer)
    end
    self.clickTimer = nil
    for i = 1, #self.objEffects do
        self.objEffects[i]:DisposeChildren()
    end
end

local clickfunction = {
    ["exit"] = function(self)
        self:Close()
    end,
    ["right"] = function(self)
        self:ClickWords(2)
    end,
    ["left"] = function(self)
        self:ClickWords(1)
    end,
    ["up"] = function(self)
        self:ClickWords(3)
    end,
    ["down"] = function(self)
        self:ClickWords(4)
    end
}
---按钮点击事件在这里派发
function EventSealHighView:OnClickBtn(go)
    local name = _G.string.replace(go:GetName(), "@_aorbtn_", "")
    if clickfunction[name] then
        clickfunction[name](self)
    end
end
function EventSealHighView:RandomWordClick()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.EventEffect_sifu05,
        self.objEffects[self.curRandomWord[self.curWordIndex]]
    )
end
function EventSealHighView:ClickWords(dir)
    if dir ~= self.curRandomWord[self.curWordIndex] then
        _G.PopWindowManager:GetInstance():ShowAllTips(1001, "请按照正确的顺序点击")
        return
    end
    local parent = self.objEffects[self.curRandomWord[self.curWordIndex]]
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.EventEffect_sifu04,
        parent,
        function()
            parent:GetChildE(0):Dispose()
            self.curWordIndex = self.curWordIndex + 1
            if self.curWordIndex > #self.objEffects then
                self:OnEventDone()
                self:ShowEffectDrop()
            else
                self:RandomWordClick()
            end
        end
    )
end
function EventSealHighView:ShowEffectHalf()
    self.click = false
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.EventEffect_sifu01,
        self.transform,
        function(trans)
            self.step1EffectObj = trans
            self.go_table.obj_seal:SetActiveE(0)
            self.clickTimer =
                _G.DelayDo(
                0.5,
                function()
                    self.clickTimer = nil
                    self.click = true
                end
            )
        end
    )
end

function EventSealHighView:ShowEffectDrop()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.EventEffect_sifu03,
        self.transform,
        function()
            self.go_table.obj_seal:SetActiveE(0)
        end,
        function()
            self:Close()
        end
    )
end

return EventSealHighView
