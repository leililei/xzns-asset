local base = require "EventViewBase"
---@class EventGhostHView : UIBaseView	中文描述
---@field public go_table EventGhostHView_GoTable GoTable
local EventGhostHView = _G.BaseClass("EventGhostHView", base)
--_G.EventGhostHView = EventGhostHView

local CS = _G.CS
local typeof = _G.typeof

local startPicName = "ui_wanfa_font_kaishi"
local stopPicName = "ui_wanfa_font_tingzhi"
local gearStartPosX = -234.5
local gearEndPosX = 322.5
---暂定刷新间隔是0.04秒(即25帧)
local updateFrameTime = 0.04
local challengeTimesLanguageKey = 90000000802
local rodTransPath = "effect/jiguanshu_01_item_01"
local rodTransParentName = "rodParent"

local animatorName = {
    ["huaru"] = "a_zhanshitiaohuaru",
    ["huachu"] = "a_zhanshitiaohuachu"
}

function EventGhostHView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    local x, y, z = self.go_table.obj_Gear:GetLocalPosition()
    self.gearPosition = {x = x, y = y, z = z}
    self.rangeRectTransform = self.go_table.obj_Range:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    self.barAnimator = self.go_table.trans_bar:GetComponentE(typeof(CS.UnityEngine.Animator))
    self.barAnimator.enabled = false
    self.rotateScripts = {}
    local EffectScript_GameObjectTransform = typeof(CS.EffectScript_GameObjectTransform)
    self.rotateScripts[1] = self.go_table.obj_Gear:GetComponentE(EffectScript_GameObjectTransform)
    self.rotateScripts[2] = self.go_table.aorbtn_Start:GetComponentE(EffectScript_GameObjectTransform)
    self.rotateScripts[3] = self.go_table.trans_gear:GetComponentE(EffectScript_GameObjectTransform)
    self:RotateGear(false)
end

---界面的入口函数
function EventGhostHView:OnCreate(doneCall, closeCall, params)
    base.OnCreate(self, doneCall, closeCall)
    self.challengeTimes = _G.tonumber(params[1][1])
    self.speeds = {}
    for i = 1, #params[2] do
        self.speeds[i] = ((gearEndPosX - gearStartPosX) / _G.tonumber(params[2][i])) * updateFrameTime
    end
    self.ranges = {}
    for i = 1, #params[3] do
        self.ranges[i] = _G.tonumber(params[3][i])
    end
    self.rodRotateAngles = {}
    for i = 1, #params[4] do
        self.rodRotateAngles[i] = 360 - _G.tonumber(params[4][i])
    end
    self.rodRotateSpeed = (360 * updateFrameTime) / _G.tonumber(params[5][1])
    self.rodAngles = -_G.Vector3(0, 0, _G.tonumber(params[6][1]))
    self:Reset()
    self:CreateEffect()
end
function EventGhostHView:OnDestroy()
    if not _G.IsNil(self.rodModel) then
        _G.UIUtils.RemoveEffect(self.rodModel, _G.ConfigManager.ui_effect_cfg.EventEffect_jiguan01.DispoeType)
    end
    self.rodModel = nil
    _G.UIUtils.Set3DUICameraDepth(_G.UIUtils.ModelCameraDepth.low)
end
---按钮点击事件在这里派发
function EventGhostHView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_Start" then
        if self.isPlayEffect then
            return
        end
        if self.curBtnType == 0 then
            if self.curStep > #self.ranges then
                return
            end
            self:StartUpdate()
        else
            self:EndUpdate()
        end
    elseif name == "@_aorbtn_close" then
        if self.updateTimer then
            self.updateTimer:Stop()
        end
        if self.rotateTimer then
            self.rotateTimer:Stop()
        end
        self:Close()
    end
end

---齿轮转动
---@param rotate boolean 是否转动
function EventGhostHView:RotateGear(rotate)
    for i = 1, #self.rotateScripts do
        self.rotateScripts[i].enabled = rotate
    end
end

function EventGhostHView:CreateEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.MapEventGhostEffect,
        self.transform,
        function(trans)
            self.rodModel = trans
            self.rodTrans = trans:FindE(rodTransParentName)
            if _G.IsNil(self.rodTrans) then
                self.rodTrans = _G.GameObject(rodTransParentName)
                self.rodTrans:SetParentE(trans)
                self.rodTrans:SetLocalEulerAngles(0, 0, 0)
                local rod = trans:FindE(rodTransPath)
                local x, y, z = rod:GetLocalPosition()
                self.rodTrans:SetLocalPosition(x, y, z)
                rod:SetParentE(self.rodTrans)
            end
            self.rodTrans:SetLocalEulerAngles(self.rodAngles.x, self.rodAngles.y, self.rodAngles.z)
        end
    )
    _G.UIUtils.Set3DUICameraDepth(_G.UIUtils.ModelCameraDepth.middle)
end

function EventGhostHView:UpdateView()
    self.gearPosition.x = gearStartPosX
    self.go_table.obj_Gear:SetLocalPosition(self.gearPosition.x, self.gearPosition.y, self.gearPosition.z)
    local _, sizeY = self.rangeRectTransform:GetRectTransformSizeDelta()
    self.rangeRectTransform:SetRectTransformSize(self.ranges[self.curStep], sizeY)
end

function EventGhostHView:Update()
    self.gearPosition.x = self.curDirect * self.speeds[self.curStep] + self.gearPosition.x
    if self.gearPosition.x >= gearEndPosX then
        self.gearPosition.x = gearEndPosX
        self.curDirect = -self.curDirect
    elseif self.gearPosition.x <= gearStartPosX then
        self.gearPosition.x = gearStartPosX
        self.curDirect = -self.curDirect
    end
    self.go_table.obj_Gear:SetLocalPosition(self.gearPosition.x, self.gearPosition.y, self.gearPosition.z)
end

function EventGhostHView:StartUpdate()
    self:UpdateView()
    if not self.barAnimator.enabled then
        self.barAnimator.enabled = true
    end
    self.barAnimator:Play(animatorName.huaru)
    self:RotateGear(true)
    if not self.updateTimer then
        self.updateTimer = _G.TimerManager:GetInstance():GetTimer(updateFrameTime, self.Update, self)
    end
    self.updateTimer:Start()
    self.curBtnType = 1
    self.go_table.aorimage_Word.SpriteName = stopPicName
end
function EventGhostHView:EndUpdate()
    if self.updateTimer then
        self.updateTimer:Pause()
    end
    self:RotateGear(false)
    self.curBtnType = 0
    self.go_table.aorimage_Word.SpriteName = startPicName
    local gearX = self.go_table.obj_Gear:GetLocalPosition()
    local rangeX = self.go_table.obj_Range:GetLocalPosition()
    local distance = _G.Mathf.Abs(gearX - rangeX)
    if distance * 2 <= self.ranges[self.curStep] then
        self:Victory()
    else
        self:Fail()
    end
end

function EventGhostHView:Fail()
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.MapEventFailEffect, self.rodTrans:GetParent())
    self.failTimes = self.failTimes + 1
    self.go_table.aortext_Times.text =
        _G.string.format(_G.LangUtil.GetLangPackValue(challengeTimesLanguageKey), self.challengeTimes - self.failTimes)
    if self.failTimes >= self.challengeTimes then
        local closeFail
        closeFail = function(self, name)
            if name == _G.ConfigManager.ui_cfg.EventChallengeFailView.Name then
                self:Close()
                _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, closeFail, self)
            end
        end
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, closeFail, self)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.EventChallengeFailView.Name)
    end
end

function EventGhostHView:Victory()
    self:PlayEffect()
end

function EventGhostHView:PlayEffect()
    if not self.rotateTimer then
        self.rotateTimer = _G.TimerManager:GetInstance():GetTimer(updateFrameTime, self.RotateRod, self)
    end
    if self.curStep < #self.ranges then
        self.barAnimator:Play(animatorName.huachu)
    end
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.MapEventSucceedEffect,
        self.rodTrans:GetParent(),
        nil,
        function()
            if self.curStep > #self.ranges then
                self:Close()
            end
        end
    )
    self.isPlayEffect = true
    self.rotateTimer:Start()
end

function EventGhostHView:RotateRod()
    self.rodAngles.z = self.rodAngles.z - self.rodRotateSpeed
    if self.rodAngles.z < 0 then
        self.rodAngles.z = self.rodAngles.z + 360
    end
    if _G.Mathf.Abs(self.rodAngles.z - self.rodRotateAngles[self.curStep]) < self.rodRotateSpeed then
        self.rodAngles.z = self.rodRotateAngles[self.curStep]
        self.rotateTimer:Pause()
        self.curStep = self.curStep + 1
        self.isPlayEffect = false
        if self.curStep > #self.ranges then
            self:OnEventDone()
        end
    end
    self.rodTrans:SetLocalEulerAngles(self.rodAngles.x, self.rodAngles.y, self.rodAngles.z)
end

function EventGhostHView:Reset()
    self.curBtnType = 0
    self.curDirect = 1
    self.curStep = 1
    self.failTimes = 0
    self:UpdateView()
    self.go_table.aorimage_Word.SpriteName = startPicName
    self.go_table.aortext_Times.text =
        _G.string.format(_G.LangUtil.GetLangPackValue(challengeTimesLanguageKey), self.challengeTimes)
end

return EventGhostHView
