    _G.PoolsManager:GetInstance():Spawn(
        obj_box,
        _G.ePoolType.UIItem,
        self.go_table.obj_box,
        function(item)
            item:SetName("box")
            item:SetLocalPosition(pos.x, pos.y, 0)
            self.box[grid:GetMazeGridId()] = item
        end
