--生成 路径图
function EventGameMazeView:SetRoadImage(pos, grid, grid2)
    _G.PoolsManager:GetInstance():Spawn(
        obj_lujing,
        _G.ePoolType.UIItem,
        self.go_table.obj_roadflag,
        function(item)
            item:SetName(grid:GetMazeGridId())
            item:SetLocalPosition(pos.x, pos.y, 0)
            if _G.table.isEmptyOrNil(grid2) then
            else
                -- local go = self.item_grids_list[grid2:GetMazeGridId()]
                -- item.transform:LookAt(go.transform)
                local posmap1 = grid:GetMazeGridPosMap()
                local posmap2 = grid2:GetMazeGridPosMap()
                if posmap1.x == posmap2.x and posmap1.y > posmap2.y then
                    item:SetLocalEulerAngles(0, 0, 180)
                elseif posmap1.x == posmap2.x and posmap1.y < posmap2.y then
                    item:SetLocalEulerAngles(0, 0, 0)
                elseif posmap1.x > posmap2.x and posmap1.y == posmap2.y then
                    item:SetLocalEulerAngles(0, 0, 90)
                elseif posmap1.x < posmap2.x and posmap1.y == posmap2.y then
                    item:SetLocalEulerAngles(0, 0, -90)
                end
            end
        end
    )
end
---生成地图
function EventGameMazeView:InitMap()
    local width, height = self.go_table.obj_map:GetRectTransformWidthHeight()
    local origin = {}
    origin.x = width / 2
    origin.y = height / 2
    local row = #self.map
    for i = 1, row do
        local tempMap = self.map[i]
        for j = 1, #tempMap do
            local data = tempMap[j]
            _G.PoolsManager:GetInstance():Spawn(
                obj_grid,
                _G.ePoolType.UIItem,
                self.go_table.obj_map_bg_grid,
                function(item)
                    local id = data:GetMazeGridId()
                    item:SetName(id)
                    local tb = _G.GetAutoGoTable(item)
                    tb.aorimage_gridicon.SpriteName = data:GetImageIcon()
                    tb.aorimage_gridicon:SetNativeSize()
                    tb.aorbtn_grid.onClick:RemoveAllListeners()
                    tb.aorbtn_grid.onClick:AddListener(_G.handlerbind(self, self.OnClickGrid, item, data))
                    _G.GameUtil.SetActiveByCondition(tb.aorbtn_grid, data:GetMazeClickType() == 1 and true or false)
                    -- local mapxy = data:GetMazeGridPosMap()
                    -- local w, d = tb.aorimage_gridicon:GetRectTransformWidthHeight()
                    -- local x = ((-origin.x) + w * mapxy.y) - 39
                    -- local y = (origin.y - d * mapxy.x) + 39
                    local pos = data:GetMazeGridPosUnity()
                    --data:SetMazeGridPosUnity(x, y)
                    item:SetLocalPosition(pos.x, pos.y, 0)
                    self.item_grids_list[id] = item
                end
            )
        end
    end
end
