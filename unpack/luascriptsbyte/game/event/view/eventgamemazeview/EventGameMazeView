function EventGameMazeView:OnClickGrid(item, gridData)
    self.tragetGraid = gridData
    self.roads = {}
    if
        gridData:GetMazeGridType() == _G.GameGridEnum_Maze.wallgrid1 or
            gridData:GetMazeGridType() == _G.GameGridEnum_Maze.wallgrid2 or
            gridData:GetMazeGridType() == _G.GameGridEnum_Maze.wallgrid3
     then
        _G.FloatTipsModel:GetInstance():Show("点击的是墙体")
        return
    elseif gridData:GetMazeGridType() == _G.GameGridEnum_Maze.startgrid then
        _G.FloatTipsModel:GetInstance():Show("点击的是自己")
        return
    end
    self.roads = require("EventGameMazeManager"):GetInstance():FindRoads(self.starGrid, gridData)
    if _G.table.isEmptyOrNil(self.roads) then
        _G.FloatTipsModel:Show("没有路径，可选择")
        return
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_mask, true)
    self:SetBoxNum()
    local roads_num = #self.roads
    self:MoveNext(roads_num)
    self.starGrid = gridData
end
function EventGameMazeView:MoveNext(roads_num)
    if roads_num <= 0 then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_mask, false)
        return true
    end

    local id = self.roads[roads_num]:GetMazeGridId()
    local ite = self.item_grids_list[id]
    local target_x, target_y, target_z = ite:GetPosition()
    self.start_palyer:DoMove(
        target_x,
        target_y,
        target_z,
        function()
            local flag = self:CheckMoveGridEnum(roads_num, self.roads[roads_num])
            if flag then
                return
            end
            roads_num = roads_num - 1
            self:MoveNext(roads_num)
        end,
        0.5
    )
end
function EventGameMazeView:CheckMoveGridEnum(roads_num, grid)
    --判断是不是 到达终点
    if grid:GetMazeGridType() == _G.GameGridEnum_Maze.destination then
        self.fistFlag = false
        local number = EventGameMazeMap:GetInstance():GetBoxNum()
        local count = _G.table.count(self.box)
        if number >= count then
            --判断是不是 最后一个关卡
            self.map_num = self.map_num + 1
            if self.map_num >= EventGameMazeMap:GetInstance():GetMapMaxLimit() then
                _G.FloatTipsModel:GetInstance():Show("最后一个关卡，游戏胜利")
                self:Close()
            else
                _G.GameUtil.SetActiveByCondition(self.go_table.obj_roadflag, false)
                EventGameMazeMap:GetInstance().boxnum = 0
                EventGameMazeMap:GetInstance().isfirst = false
                self.currentid = self.mapid_lists[self.map_num + 1]
                self.currentid = tonumber(self.currentid)
                require("EventGameMazeManager"):GetInstance():InitMap(
                    self.currentid,
                    function()
                        self:DisposeAllNodes()
                        self:UpDataView()
                    end
                )
            end
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(
                110115,
                nil,
                function()
                    require("EventGameMazeManager"):GetInstance():InitMap(
                        self.currentid,
                        function()
                            self:DisposeAllNodes()
                            self:UpDataView()
                        end
                    )
                end,
                function()
                    self:Close()
                end
            )
        end
        return true
    end
    --判断是不红色的 格子
    if grid:GetMazeGridType() == _G.GameGridEnum_Maze.redgridgrid then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            110116,
            nil,
            function()
                require("EventGameMazeManager"):GetInstance():InitMap(
                    self.currentid,
                    function()
                        self:DisposeAllNodes()
                        self:UpDataView()
                    end
                )
            end,
            function()
                self:Close()
            end
        )
        return true
    end
    --判断是不是 宝箱
    if grid:GetMazeGridType() == _G.GameGridEnum_Maze.yellowgrid then
        local count = self.box[grid:GetMazeGridId()]:GetChildCountE()
        local node = self.box[grid:GetMazeGridId()]:GetChildE(count - 1)
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_baoxiangxiaoguo,
            node,
            function(tran)
            end,
            function()
                grid:SetMazeGridType(_G.GameGridEnum_Maze.groundgrid1)
                self.box[grid:GetMazeGridId()]:SetActiveE(0)
            end
        )
    -- grid:SetMazeGridType(_G.GameGridEnum_Maze.groundgrid1)
    -- self.box[grid:GetMazeGridId()]:SetActiveE(0)
    end
    --判断 是否 移动到点击位置
    if grid:GetMazeClickType() == _G.GameGrid_Maze_Click_Enum.keyi then
        require("EventGameMazeManager"):GetInstance():ResetMapDataStart(self.starGrid, self.tragetGraid)
    end

    return false
end

function EventGameMazeView:DisposeAllNodes()
    --清楚地图数据
    self:DisposeAllNodeInfo(self.go_table.obj_map_bg_grid)
    --清楚宝箱
    self:DisposeAllNodeInfo(self.go_table.obj_box)
    --清楚敌人
    self:DisposeAllNodeInfo(self.go_table.obj_enmeny)
    --清楚玩家
    self:DisposeAllNodeInfo(self.go_table.obj_player)
end
function EventGameMazeView:DisposeAllNodeInfo(allnode)
    local node = allnode
    if node:GetChildCountE() > 0 then
        for i = 1, node:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(node:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
end

function EventGameMazeView:UpDataView()
    self.map = EventGameMazeMap:GetInstance():GetMap()
    self.currentid = EventGameMazeMap:GetInstance():GetMapid()
    self.start_palyer = {}
    self.starGrid = {}
    self.box = {}
    self.item_grids_list = {}
    self.hongseArena = {}

    self.boxnum = EventGameMazeMap:GetInstance():GetBoxNum() or 0
    self:SetBgAlpa()
    self:SetBoxNum()
    self:InitMap()
    self:InitSatrtAndBoxAndEmeny()
    self.tragetGraid = {}
    self.starGrid = EventGameMazeMap:GetInstance():GetMapStart()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_mask, false)
end

function EventGameMazeView:FirstFindRoad()
    if not self.fistFlag then
        return
    end
    local temp = {}
    local qigrid = EventGameMazeMap:GetInstance():GetMapStart()
    local targetGrad1 = {}
    local raods = {}
    for i = 1, #self.hongseArena do
        targetGrad1 = {}
        targetGrad1 = self.hongseArena[i]
        raods = {}
        raods = require("EventGameMazeManager"):GetInstance():FindRoads(qigrid, targetGrad1)
        _G.table.insert(raods, qigrid)
        for j = #raods, 1, -1 do
            if j == 1 then
                break
            end
            raods[j]:SetParentNode({})
            --_G.table.insert(temp, raods[j])
            local unitypos = raods[j]:GetMazeGridPosUnity()
            self:SetRoadImage(unitypos, raods[j], raods[j - 1])
        end
        --require("EventGameMazeManager"):GetInstance():ResetMapDataStart(qigrid, targetGrad1)
        targetGrad1:SetMazeClickType(_G.GameGrid_Maze_Click_Enum.bukeyi)
        qigrid = targetGrad1
    end
    targetGrad1 = EventGameMazeMap:GetInstance().mapend
    raods = {}
    raods = require("EventGameMazeManager"):GetInstance():FindRoads(qigrid, targetGrad1)
    targetGrad1:SetMazeClickType(_G.GameGrid_Maze_Click_Enum.bukeyi)
    _G.table.insert(raods, qigrid)
    for j = #raods, 1, -1 do
        if j == 1 then
            break
        end
        raods[j]:SetParentNode({})
        local unitypos = raods[j]:GetMazeGridPosUnity()
        self:SetRoadImage(unitypos, raods[j], raods[j - 1])
    end
end

return EventGameMazeView
