local EventGameMazeMap = require("EventGameMazeMap")
local base = require "EventViewBase"
local obj_grid = "UI/EventView/$_obj_grid"
local obj_root_player = "UI/EventView/$_obj_root_player"
local obj_root_hongse = "UI/EventView/$_obj_root_hongse"
local obj_box = "UI/EventView/$_obj_box"
local obj_lujing = "UI/EventView/@_obj_lujing"
---@class EventGameMazeView : UIBaseView	中文描述
---@field public go_table EventGameMazeView_GoTable GoTable
local EventGameMazeView = _G.BaseClass("EventGameMazeView", base)

function EventGameMazeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.fistFlag = true
end

---界面的入口函数
---@param params table 一笔画游戏数据表
function EventGameMazeView:OnCreate(doneCall, closeCall, params)
    base.OnCreate(self, doneCall, closeCall)
    require("EventGameMazeManager"):GetInstance():InitMapData(params[1])
    self.mapid_lists = EventGameMazeMap:GetInstance().mapid_lists
    self.map_num = 0
    self:UpDataView()
    self:FirstFindRoad()
end
function EventGameMazeView:Dispose()
    self.map = nil
    self.currentid = nil
    self.map_num = nil
    self.start_palyer = nil
    self.box = nil
    self.item_grids_list = nil
    self.boxnum = nil
    self.tragetGraid = nil
    self.hongseArena = nil
    self:DisposeAllNodes()
end
---按钮点击事件在这里派发
function EventGameMazeView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            110117,
            nil,
            function()
                require("EventGameMazeManager"):GetInstance():InitMap(
                    self.currentid,
                    function()
                        self:DisposeAllNodes()
                        self:UpDataView()
                    end
                )
            end,
            function()
                self:Close()
            end
        )
    end
end
--设置宝箱个数
function EventGameMazeView:SetBoxNum()
    self.go_table.aortext_BoxNum.text = "x" .. EventGameMazeMap:GetInstance():GetBoxNum()
end
---设置 背景颜色
function EventGameMazeView:SetBgAlpa()
    self.go_table.aorrawimage_gridBg.Alpha = 204
end
function EventGameMazeView:InitSatrtAndBoxAndEmeny()
    local raw = #self.map
    for i = 1, raw do
        local tempMap = self.map[i]
        for j = 1, #tempMap do
            local griddata = tempMap[j]
            local unitypos = griddata:GetMazeGridPosUnity()
            if griddata:GetMazeGridType() == _G.GameGridEnum_Maze.redgridgrid then
                self:SetRedEmeny(unitypos)
            elseif griddata:GetMazeGridType() == _G.GameGridEnum_Maze.yellowgrid then
                self:SetBoxAward(unitypos, tempMap[j])
                _G.table.insert(self.hongseArena, tempMap[j])
            elseif griddata:GetMazeGridType() == _G.GameGridEnum_Maze.startgrid then
                self:SpawnStar(unitypos)
            elseif griddata:GetMazeGridType() == _G.GameGridEnum_Maze.boxgrid then
                self:SetBoxAward(unitypos, tempMap[j])
                _G.table.insert(self.hongseArena, tempMap[j])
            end
        end
    end
end
---在起点生成 人物
function EventGameMazeView:SpawnStar(pos)
    _G.PoolsManager:GetInstance():Spawn(
        obj_root_player,
        _G.ePoolType.UIItem,
        self.go_table.obj_player,
        function(item)
            item:SetName("palyer")
            item:SetLocalPosition(pos.x, pos.y, 0)
            self.start_palyer = item
        end
    )
end
---生成黄色区域宝箱
