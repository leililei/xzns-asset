--region

local barSpeed = 0.008
local EventRecoverHpItem = _G.BaseClass("EventRecoverHpItem")

function EventRecoverHpItem:__init(obj, doneCall, index)
    self.gameObject = obj
    self.animationDoneCall = doneCall
    self.index = index
    self.go_table = _G.GetAutoGoTable(obj)
end
function EventRecoverHpItem:DisPose()
    self.gameObject = nil
    self.animationDoneCall = nil
    self.index = nil
    self.go_table = nil
    self.dir = nil
    self.bPer = nil
    self.aPer = nil
end
---显示血量恢复
---@param sid number 卡牌sid
---@param recover number 恢复量 (-1-1 百分比 >1 具体值)
---@param data table 卡牌数据
---@param beforePer number 展示前的百分比
function EventRecoverHpItem:Show(sid, recover, data, beforePer)
    if sid > 0 then
        self.gameObject:SetActiveE(1)
        beforePer = beforePer or 0
        ---@type card_cfg
        local cfg = _G.ConfigManager.card_cfg[sid]
        if cfg then
            self.go_table.aorimage_icon.SpriteName = cfg.Icon
        end
        data = data or {Hp = 1, MaxHp = 1}
        data.Hp = data.Hp - data.MaxHp * beforePer
        local curper = data.Hp / data.MaxHp
        self:ShowBar(curper, (_G.Mathf.Abs(recover) <= 1) and (curper + recover) or ((curper + recover) / data.MaxHp))
    else
        self.gameObject:SetActiveE(0)
    end
end
local pos = _G.Vector3.unity_vector3.zero
---函数功能注释
---@param bPer number 恢复前血量比
---@param aPer number 恢复后血量比
function EventRecoverHpItem:ShowBar(bPer, aPer)
    if aPer > 1 then
        aPer = 1
    elseif aPer < 0 then
        aPer = 0
    end
    self.bPer = bPer
    self.aPer = aPer
    barSpeed = Mathf.Abs(bPer - aPer) * 0.016
    self.dir = aPer > bPer and 1 or -1
    self.go_table.aorimage_before:SetRectTransformSize(Mathf.Floor(bPer * 100), 8)

    if self.dir > 0 then
        self.go_table.aorimage_after:SetRectTransformSize(Mathf.Floor(aPer * 100), 8)
        self.go_table.aorimage_after.SpriteName = "ui-jb-bar-xutiao03"
    else
        self.go_table.aorimage_after:SetRectTransformSize(Mathf.Floor(bPer * 100), 8)
        self.go_table.aorimage_after.SpriteName = "ui-jb-bar-xutiao01"
    end
end
function EventRecoverHpItem:BarAnimation()
    if self.gameObject:GetActiveSelf() == 0 and not self.dir then
        if self.animationDoneCall then
            self.animationDoneCall(self.index)
        end
        return
    end
    self.bPer = self.bPer + (barSpeed * self.dir)
    if self.dir >= 1 then
        if self.bPer - self.aPer >= 0 then
            self.bPer = self.aPer
            if self.animationDoneCall then
                self.animationDoneCall(self.index)
            end
        end
    elseif self.bPer - self.aPer <= 0 then
        self.bPer = self.aPer
        if self.animationDoneCall then
            self.animationDoneCall(self.index)
        end
    end
    self.go_table.aorimage_before:SetRectTransformSize(Mathf.Floor(self.bPer * 100), 8)
end
--endregion

---@class EventRecoverHpView : UIBaseView	中文描述
---@field public go_table EventRecoverHpView_GoTable GoTable
local EventRecoverHpView = _G.BaseClass("EventRecoverHpView", _G.UIBaseView)

function EventRecoverHpView:Awake()
    self.itemList = {}
    self.playBarHandler = _G.handler(self, self.PlayBarDone)
    self.itemList[1] = EventRecoverHpItem.New(self.go_table.obj_item1, self.playBarHandler, 1)
    self.itemList[2] = EventRecoverHpItem.New(self.go_table.obj_item2, self.playBarHandler, 2)
    self.itemList[3] = EventRecoverHpItem.New(self.go_table.obj_item3, self.playBarHandler, 3)
    self.itemList[4] = EventRecoverHpItem.New(self.go_table.obj_item4, self.playBarHandler, 4)
    self.itemList[5] = EventRecoverHpItem.New(self.go_table.obj_item5, self.playBarHandler, 5)
end

---界面的入口函数
---@param params number|table 血量变化百分比|数值(百分比)组
---@param beforePer number 展示前的百分比
function EventRecoverHpView:OnCreate(params, beforePer)
    self.recoverHpValue = nil
    self.recoverHpPer = nil
    self.beforePer = beforePer
    if #params > 1 then
        self.recoverHpValue = params
    else
        self.recoverHpPer = _G.tonumber(params[1])
    end
end

function EventRecoverHpView:OnEnable()
    _G.MainManager:GetInstance():ShowTagShrink(false)
    local embattle = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.section)
    local ChapterRoomManagerIns = _G.ChapterRoomManager:GetInstance()
    local StorageManagerIns = _G.StorageManager:GetInstance()
    local storageID = _G.StorageID.Card
    for i = 1, #embattle do
        if embattle[i] > 0 then
            if ChapterRoomManagerIns:GetCardBaseData(embattle[i]) <= 0 then
                embattle[i] = 0
            else
                embattle[i] = StorageManagerIns:GetItemDataByID(storageID, embattle[i]).sid
            end
        end
    end
    for i = 1, #embattle do
        self.itemList[i]:Show(
            embattle[i],
            self.recoverHpPer or _G.tonumber(self.recoverHpValue[i]),
            nil,
            self.beforePer
        )
    end
    local player = _G.WorldManager:GetInstance():GetCurWorldPlayer()
    if self.recoverHpPer > 0 then
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.RegainEffect_jlsx, player.Transform)
    end
    self.barItemIndex = {}
    self.barPlayTimer = _G.TimerManager:GetInstance():GetTimer(0.04, self.PlayBar, self)
    self.barPlayTimer:Start()
end
function EventRecoverHpView:OnDisable()
    _G.MainManager:GetInstance():ShowTagShrink(true)
    if self.barPlayTimer then
        self.barPlayTimer:Stop()
    end
    self.barPlayTimer = nil
    for i = 1, #self.itemList do
        self.itemList[i]:Dispose()
    end
    self.itemList = nil
    self.recoverHpValue = nil
    self.recoverHpPer = nil
    self.playBarHandler = nil
end
function EventRecoverHpView:PlayBar()
    local fresh = false
    for i = 1, #self.itemList do
        if not self.barItemIndex[i] then
            self.itemList[i]:BarAnimation()
            fresh = true
        end
    end
    if not fresh then
        if self.barPlayTimer then
            self.barPlayTimer:Stop()
        end
        self.barPlayTimer = nil
        self:Close()
    end
end
function EventRecoverHpView:PlayBarDone(index)
    self.barItemIndex[index] = true
end

return EventRecoverHpView
