--region 局部定义
local rotateRange = {45, -45}
---勺子转动的速度 1秒转动的角度
local rotateSpeed = 30
local scoreRange = {3, -14}
local btnOpenIconName = "ui_bz_btn_zhandou"
local btnOpenTextName = "ui-jbpr-txt-kh"
local btnCloseIconName = "ui_bz_btn_zhandou"
local btnCloseTextName = "ui-jbpr-txt-gh"
local spoonWinIcon = "ui-jbpr-icon-shaozi01"
local spoonFailIcon = "ui-jbpr-icon-shaozi02"
local wordWinIcon = "ui-jbpr-txt-jue"
local wordFailIcon = "ui-jbpr-txt-fan"
local bgWinIcon = "ui-jq-bar-04"
local bgFailIcon = "ui-jq-bar-01"
local leftRawImage = {
    win = "Images/EventCooking/ui-jbpr-img-hl03",
    fail = "Images/EventCooking/ui-jbpr-img-hl01",
    normal = "Images/EventCooking/ui-jbpr-img-hl02"
}
local rightRawImage = {
    win = "Images/EventCooking/ui-jbpr-img-cxl03",
    fail = "Images/EventCooking/ui-jbpr-img-cxl02",
    normal = "Images/EventCooking/ui-jbpr-img-cxl01"
}
local dialoguePos = {
    left = {x = -397, y = 131},
    right = {x = 537, y = 183}
}
local emjioType = {
    win = "win",
    fail = "fail",
    noamal = "normal"
}
---表情气泡，内容填多语言ID
local emjioDialogue = {
    ---普通
    normal = {
        left = {90034010103, 90034010104},
        right = {90034010103, 90034010104}
    },
    ---胜利
    win = {
        left = {90034010105, 90034010106,90034010107},
        right = {90034010105, 90034010106,90034010107}
    },
    ---失败
    fail = {
        left = {90034010101, 90034010102,90034010108},
        right = {90034010101, 90034010102,90034010108}
    }
}
--endregion
local base = require "EventViewBase"
---@class EventCookingView : UIBaseView	中文描述
---@field public go_table EventCookingView_GoTable GoTable
local EventCookingView = _G.BaseClass("EventCookingView", base)

function EventCookingView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function EventCookingView:OnCreate(doneCall, closeCall)
    base.OnCreate(self, doneCall, closeCall)
    self.resultImage = {
        self.go_table.aorimage_resultBg1,
        self.go_table.aorimage_resultIcon1,
        self.go_table.aorimage_resultText1,
        self.go_table.aorimage_resultBg2,
        self.go_table.aorimage_resultIcon2,
        self.go_table.aorimage_resultText2,
        self.go_table.aorimage_resultBg3,
        self.go_table.aorimage_resultIcon3,
        self.go_table.aorimage_resultText3
    }
    self.curAngles = rotateRange[1]
    self.go_table.trans_spoon:SetLocalEulerAngles(0, 0, self.curAngles)
    self.openfire = false
    self.result = {nil, nil, nil}
    self:ShowDialogue(emjioType.noamal)
    self.ani_index = 1
    self.uieffectnode = {
        [1] = self.go_table.obj_uieffect1,
        [2] = self.go_table.obj_uieffect2,
        [3] = self.go_table.obj_uieffect3
    }
end
function EventCookingView:OnDestroy()
    self.result = nil
    self.curAngles = nil
    self.curState = nil
    self.result = nil
    self.resultImage = nil
    self.openfire = nil
    self.curEmjioState = nil
    if self.textTimer then
        self.textTimer:Stop()
    end
    self.textTimer = nil
end
---按钮点击事件在这里派发
function EventCookingView:OnClickBtn(go)
    if go == self.go_table.aorbtn_exit then
        self:Close()
    elseif go == self.go_table.aorbtn_play then
        if self.openfire then
            self:CloseFire()
            self.ani_index = self.ani_index + 1
        else
            self:OpenFire()
        end
    end
end
---展示表情对话
---@param state emjioType 状态
function EventCookingView:ShowDialogue(state)
    if state == self.curEmjioState then
        return
    end
    self.curEmjioState = state
    self.go_table.aorrawimage_left:LoadImage(
        leftRawImage[state],
        function()
            self.go_table.aorrawimage_left:SetNativeSize()
        end
    )
    self.go_table.aorrawimage_right:LoadImage(
        rightRawImage[state],
        function()
            self.go_table.aorrawimage_right:SetNativeSize()
        end
    )
    local left = _G.Mathf.Random(0, 1) == 0
    local pos
    local dialogue
    if left then
        pos = dialoguePos.left
        dialogue = emjioDialogue[state].left
    else
        pos = dialoguePos.right
        dialogue = emjioDialogue[state].right
    end
    self.go_table.trans_text:SetLocalPosition(pos.x, pos.y, 0)
    dialogue = dialogue[_G.Mathf.Random(1, #dialogue)]
    self.go_table.aortext_text.text = _G.GetLangPackValue(dialogue)
    _G.GameUtil.SetActiveByCondition(self.go_table.trans_text, true)
    if self.textTimer then
        self.textTimer:Stop()
    end
    self.textTimer = _G.TimerManager:GetInstance():GetTimer(2, self.OnTextHideCall, self, true)
    self.textTimer:Start()
end
function EventCookingView:OnTextHideCall()
    _G.GameUtil.SetActiveByCondition(self.go_table.trans_text, false)
    self.textTimer = nil
end
---开火
function EventCookingView:OpenFire()
    self.go_table.aorimage_btnBG.SpriteName = btnCloseIconName
    self.go_table.aorimage_btnTXT.SpriteName = btnCloseTextName
    self:ShowDialogue(emjioType.noamal)
    self.curAngles = rotateRange[1]
    self.go_table.trans_spoon:SetLocalEulerAngles(0, 0, self.curAngles)
    self.curRotateDir = -1
    self.curIndex = self.curIndex and self.curIndex + 1 or 1
    self.openfire = true
    _G.UpdateManager:GetInstance():AddUpdate(self.RotateSpoon, self)
end
---关火
function EventCookingView:CloseFire()
    _G.UpdateManager:GetInstance():RemoveUpdate(self.RotateSpoon, self)
    self.go_table.aorimage_btnBG.SpriteName = btnOpenIconName
    self.go_table.aorimage_btnTXT.SpriteName = btnOpenTextName
    self.openfire = false
    if self.curAngles <= scoreRange[1] and self.curAngles >= scoreRange[2] then
        self:SetResult(true)
    else
        self:SetResult(false)
    end
end
---转动勺子
function EventCookingView:RotateSpoon()
    self.curAngles = self.curAngles + self.curRotateDir * rotateSpeed * _G.Time.deltaTime
    if self.curAngles < rotateRange[2] then
        self.curRotateDir = 1
        self.curAngles = rotateRange[2]
    elseif self.curAngles > rotateRange[1] then
        self.curRotateDir = -1
        self.curAngles = rotateRange[1]
    end
    self.go_table.trans_spoon:SetLocalEulerAngles(0, 0, self.curAngles)
end
---设置结果
function EventCookingView:SetResult(win)
    self.result[self.curIndex] = win
    local cfg = _G.ConfigManager.ui_effect_cfg
    local effcfg = {}
    if win then
        self:ShowDialogue(emjioType.win)
        effcfg = cfg["ef_jue"]
    else
        effcfg = cfg["ef_fan"]
        self:ShowDialogue(emjioType.fail)
    end
    _G.UIUtils.LoadEffectByCfg(effcfg, self.uieffectnode[self.curIndex])
    self.resultImage[self.curIndex * 3].SpriteName = win and wordWinIcon or wordFailIcon
    self.resultImage[self.curIndex * 3 - 1].SpriteName = win and spoonWinIcon or spoonFailIcon
    self.resultImage[self.curIndex * 3 - 2].SpriteName = win and bgWinIcon or bgFailIcon
    _G.GameUtil.SetActiveByCondition(self.resultImage[self.curIndex * 3], true)
    _G.GameUtil.SetActiveByCondition(self.resultImage[self.curIndex * 3 - 1], true)
    _G.GameUtil.SetActiveByCondition(self.resultImage[self.curIndex * 3 - 2], true)
    if self.curIndex == 3 then
        win = false
        self.curSettlementViewName = _G.ConfigManager.ui_cfg.EventCookingFailView.Name
        local image = {left = leftRawImage.fail, right = rightRawImage.fail}
        local dialogue = emjioDialogue.fail
        for i = 1, 3 do
            if self.result[i] then
                if win then --胜利
                    self:OnEventDone()
                    self.curSettlementViewName = _G.ConfigManager.ui_cfg.EventCookingSuccessView.Name
                    dialogue = emjioDialogue.win
                    image.left = leftRawImage.win
                    image.right = rightRawImage.win
                    break
                else
                    win = true
                end
            end
        end
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnSettlementViewClosed, self)

        _G.UIManager:GetInstance():OpenWindow(self.curSettlementViewName, image, dialogue, self.result)
    end
end
---当结算界面关闭调用
function EventCookingView:OnSettlementViewClosed(name)
    if name == self.curSettlementViewName then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnSettlementViewClosed, self)
        self:Close()
    end
end

return EventCookingView
