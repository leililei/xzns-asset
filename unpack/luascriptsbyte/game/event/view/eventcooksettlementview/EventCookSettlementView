local spoonWinIcon = "ui-jbpr-icon-shaozi01"
local spoonFailIcon = "ui-jbpr-icon-shaozi02"
local wordWinIcon = "ui-jbpr-txt-jue"
local wordFailIcon = "ui-jbpr-txt-fan"
local dialoguePos = {
    left = {x = -393, y = 103},
    right = {x = 601, y = 167}
}
---@class EventCookSettlementView : UIBaseView	中文描述
---@field public go_table EventCookSettlementView_GoTable GoTable
local EventCookSettlementView = _G.BaseClass("EventCookSettlementView", _G.UIBaseView)

function EventCookSettlementView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.resultImage = {
        self.go_table.aorimage_resultIcon1,
        self.go_table.aorimage_resultText1,
        self.go_table.aorimage_resultIcon2,
        self.go_table.aorimage_resultText2,
        self.go_table.aorimage_resultIcon3,
        self.go_table.aorimage_resultText3
    }
end

---界面的入口函数
---@param image table 表情图片名称
---@param dialogue table 表情气泡
---@param result table 结果
function EventCookSettlementView:OnCreate(image, dialogue, result)
    self.go_table.aorrawimage_left:LoadImage(image.left)
    self.go_table.aorrawimage_right:LoadImage(image.right)
    for i = 1, #result do
        self.resultImage[i * 2].SpriteName = result[i] and wordWinIcon or wordFailIcon
        self.resultImage[i * 2 - 1].SpriteName = result[i] and spoonWinIcon or spoonFailIcon
    end
    local left = _G.Mathf.Random(0, 1) == 0
    local pos
    if left then
        dialogue = dialogue.left
        pos = dialoguePos.left
    else
        dialogue = dialogue.right
        pos = dialoguePos.right
    end
    self.go_table.trans_text:SetLocalPosition(pos.x, pos.y, 0)
    dialogue = dialogue[_G.Mathf.Random(1, #dialogue)]
    self.go_table.aortext_text.text = _G.GetLangPackValue(dialogue)
    _G.GameUtil.SetActiveByCondition(self.go_table.trans_text, true)
    self.textTimer = _G.TimerManager:GetInstance():GetTimer(2, self.OnTextHideCall, self, true)
    self.textTimer:Start()
end
function EventCookSettlementView:OnDestroy()
    self.resultImage = nil
    if self.textTimer then
        self.textTimer:Stop()
    end
end

---按钮点击事件在这里派发
function EventCookSettlementView:OnClickBtn(go)
    self:Close()
end

function EventCookSettlementView:OnTextHideCall()
    _G.GameUtil.SetActiveByCondition(self.go_table.trans_text, false)
    self.textTimer = nil
end

return EventCookSettlementView
