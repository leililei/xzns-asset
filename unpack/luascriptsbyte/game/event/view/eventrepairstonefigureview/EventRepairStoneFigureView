local base = require "EventViewBase"
---@class EventRepairStoneFigureView : UIBaseView	中文描述
---@field public go_table EventRepairStoneFigureView_GoTable GoTable
local EventRepairStoneFigureView = _G.BaseClass("EventRepairStoneFigureView", base)

---未激活的图片alpha值
local deactiveAlpha = 0.26
---滑动旋转1°的距离
local rotateAngleDistance = 5
function EventRepairStoneFigureView:Awake()
    _G.UIUtils.Set3DUICameraDepth(_G.UIUtils.ModelCameraDepth.middle)
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.SetEventTrigger(self.go_table.aorbtn_1, "onDown", _G.handler(self, self.OnDown1))
    _G.SetEventTrigger(self.go_table.aorbtn_1, "onDrag", _G.handler(self, self.OnDrag1))
    _G.SetEventTrigger(self.go_table.aorbtn_1, "onUp", _G.handler(self, self.OnUp1))
    _G.SetEventTrigger(self.go_table.aorbtn_2, "onDown", _G.handler(self, self.OnDown2))
    _G.SetEventTrigger(self.go_table.aorbtn_2, "onDrag", _G.handler(self, self.OnDrag2))
    _G.SetEventTrigger(self.go_table.aorbtn_2, "onUp", _G.handler(self, self.OnUp2))
    _G.SetEventTrigger(self.go_table.aorbtn_3, "onDown", _G.handler(self, self.OnDown3))
    _G.SetEventTrigger(self.go_table.aorbtn_3, "onDrag", _G.handler(self, self.OnDrag3))
    _G.SetEventTrigger(self.go_table.aorbtn_3, "onUp", _G.handler(self, self.OnUp3))
    _G.SetEventTrigger(self.go_table.aorbtn_bg, "onDrag", _G.handler(self, self.OnDragBG))
    local aorImageType = _G.typeof(_G.CS.AorImage)
    self.btnImage = {
        self.go_table.aorbtn_1:GetComponentE(aorImageType),
        self.go_table.aorbtn_2:GetComponentE(aorImageType),
        self.go_table.aorbtn_3:GetComponentE(aorImageType)
    }
end

---界面的入口函数
---@param params table 参数(1.事件组 2.模型组 3.碰撞框名称组)
function EventRepairStoneFigureView:OnCreate(doneCall, closeCall, params)
    base.OnCreate(self, doneCall, closeCall)
    self.events = params[1]
    for i = 1, #self.events do
        self.events[i] = _G.tonumber(self.events[i])
    end
    self.models = params[2]
    self.colliders = params[3]
    self.effects = {}
    self.eventDone = false
    self.curRotateY = 0
    self.curChooseEffect = nil
    self.curChooseIndex = 0
    self.modelPosZ = 0
    self:InitBaseModel()
    self:InitBtnState()
end
function EventRepairStoneFigureView:OnDestroy()
    self.models = nil
    self.colliders = nil
    self.events = nil
    self.eventDone = nil
    self.curRotateY = nil
    self.curChooseEffect = nil
    self.curChooseIndex = nil
    self.effects = nil
    self.modelPosZ = nil
    _G.DestroyObject(self.baseModelObj)
    self.baseModelObj = nil
    self.baseModelTrans = nil
    _G.UIUtils.Set3DUICameraDepth(_G.UIUtils.ModelCameraDepth.low)
end
--region 按钮
---按钮点击事件在这里派发
function EventRepairStoneFigureView:OnClickBtn(go)
    if go == self.go_table.aorbtn_help then
    elseif go == self.go_table.aorbtn_CloseView then
        if not self.baseModelObj then
            return
        end
        self:Close()
    elseif go == self.go_table.aorbtn_bg then
        if self.eventDone then
            self:Close()
        end
    end
end
function EventRepairStoneFigureView:OnDown1(go, ed)
    self:OnDown(go, ed, 1)
end
function EventRepairStoneFigureView:OnDown2(go, ed)
    self:OnDown(go, ed, 2)
end
function EventRepairStoneFigureView:OnDown3(go, ed)
    self:OnDown(go, ed, 3)
end
function EventRepairStoneFigureView:OnDrag1(go, ed)
    self:OnDrag(go, ed, 1)
end
function EventRepairStoneFigureView:OnDrag2(go, ed)
    self:OnDrag(go, ed, 2)
end
function EventRepairStoneFigureView:OnDrag3(go, ed)
    self:OnDrag(go, ed, 3)
end
function EventRepairStoneFigureView:OnDragBG(go, ed)
    self:OnDrag(go, ed, 0)
end
function EventRepairStoneFigureView:OnUp1(go, ed)
    self:OnUp(go, ed, 1)
end
function EventRepairStoneFigureView:OnUp2(go, ed)
    self:OnUp(go, ed, 2)
end
function EventRepairStoneFigureView:OnUp3(go, ed)
    self:OnUp(go, ed, 3)
end
---按下
function EventRepairStoneFigureView:OnDown(go, ed, index)
    if self:CheckBtn(index) and self.curChooseIndex ~= index then
        self.curChooseIndex = index
        if self.effects[index] then
            self:OnCreateModelCall(self.effects[index], index)
        else
            _G.UIUtils.CreateEffectIn3DUICamera(
                _G.ConfigManager.ui_effect_cfg[self.models[index]],
                _G.handlerbind(self, self.OnCreateModelCall, index)
            )
        end
    end
end
---拖动
function EventRepairStoneFigureView:OnDrag(go, ed, index)
    if index == 0 then
        self.curRotateY = self.curRotateY - (ed.delta.x / rotateAngleDistance)
        self.baseModelObj:SetLocalEulerAngles(0, self.curRotateY, 0)
        return
    end
    if index == self.curChooseIndex and self.curChooseEffect then
        _G.CS.UIUtils.SetWorldLocalPosByUIPos(_G.UIUtils.Get3DUICamera(), self.modelPosZ, self.curChooseEffect)
    end
end
---松开
function EventRepairStoneFigureView:OnUp(go, ed, index)
    if index == self.curChooseIndex and self.curChooseEffect then
        local obj = _G.UIUtils.GetGameObjectByRay()
        if _G.IsNil(obj) then
            self.curChooseEffect:SetActiveE(0)
        else
            if obj:GetName() == self.colliders[index] then
                _G.UIUtils.RemoveEffect(
                    self.curChooseEffect,
                    1,
                    function()
                        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg[self.models[index]], obj)
                        self.models[index] = nil
                        if _G.table.isEmptyOrNil(self.models) then
                            self:EventDone()
                        end
                    end
                )
            else
                self.curChooseEffect:SetActiveE(0)
            end
        end
        self.curChooseEffect = nil
    end
    self.curChooseIndex = 0
end
--endregion
---初始化基础模型
function EventRepairStoneFigureView:InitBaseModel()
    local cfg = _G.ConfigManager.ui_effect_cfg[self.models[#self.models]]
    self.models[#self.models] = nil
    _G.UIUtils.CreateEffectIn3DUICamera(
        cfg,
        function(trans)
            local root = _G.GameObject("StoneModel")
            root:SetParentE(trans:GetParent())
            local x, y, z = trans:GetLocalPosition()
            root:SetLocalPosition(x, y, z)
            self.baseModelObj = root
            self.baseModelTrans = trans
            self.modelPosZ = z
            trans:SetParentE(root, 1)
        end
    )
end
---初始化按钮状态
function EventRepairStoneFigureView:InitBtnState()
    local EventManager = _G.EventManager:GetInstance()
    for i = 1, #self.events do
        if not EventManager:GetEventDone(self.events[i]) then
            self.btnImage[i].Alpha = deactiveAlpha
        end
    end
end
---检测按钮状态
---@param index number 按钮序列号
---@return boolean 是否可点击
function EventRepairStoneFigureView:CheckBtn(index)
    if not self.models[index] then
        return false
    end
    -- if not _G.EventManager:GetInstance():GetEventDone(self.events[index]) then
    --     --暂未获得该部件tips
    --     _G.PopWindowManager:GetInstance():ShowAllTips(110114)
    --     return false
    -- end
    return true
end
---当模型创建完成回调
---@param trans UnityEngine.Transform 模型
---@param index number 序列号
function EventRepairStoneFigureView:OnCreateModelCall(trans, index)
    if self.curChooseIndex == index then
        self.curChooseEffect = trans
        trans:SetActiveE(1)
    else
        trans:SetActiveE(0)
    end
    self.effects[index] = trans
    _G.CS.UIUtils.SetWorldLocalPosByUIPos(_G.UIUtils.Get3DUICamera(), self.modelPosZ, self.curChooseEffect)
end
---完成事件
function EventRepairStoneFigureView:EventDone()
    self:OnEventDone()
    self.curRotateY = 0
    self.baseModelObj:SetLocalEulerAngles(0, 0, 0)
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.shixianggui_opne_2,
        self.baseModelTrans,
        function(trans)
            trans:SetLayer(_G.UIUtils.Get3DUICamera():GetLayer())
        end,
        function()
            self.eventDone = true
            --点击屏幕继续
            self.go_table.aortext_help.text = _G.GetLangPackValue(90000000918)
        end
    )
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.shixianggui_open_1,
        self.baseModelTrans,
        function(trans)
            trans:SetLayer(_G.UIUtils.Get3DUICamera():GetLayer())
        end
    )
end

return EventRepairStoneFigureView
