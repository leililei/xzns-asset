local base = require "EventViewBase"
---@class EventSealView : UIBaseView	中文描述
---@field public go_table EventSealView_GoTable GoTable
local EventSealView = _G.BaseClass("EventSealView", base)

function EventSealView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.EventEffect_sifu02, self.go_table.obj_bgParent)
end

function EventSealView:OnEnable()
    self.step = 0
    self.click = true
    self.go_table.obj_seal:SetActiveE(1)
    if not _G.IsNil(self.step1EffectObj) then
        self.step1EffectObj:DestroyObject()
    end
end

function EventSealView:OnDisable()
    if not _G.IsNil(self.step1EffectObj) then
        self.step1EffectObj:DestroyObject()
    end
    if self.clickTimer then
        _G.coroutine.stopwaiting(self.clickTimer)
    end
    self.clickTimer = nil
end

---按钮点击事件在这里派发
function EventSealView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_seal" then
        if self.click then
            if self.step == 0 then
                self:ShowEffectHalf()
            elseif self.step == 1 then
                self:ShowEffectDrop()
            end
        end
    elseif name == "@_aorbtn_exit" then
        self:Close()
    end
end

function EventSealView:ShowEffectHalf()
    self.click = false
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.EventEffect_sifu01,
        self.transform,
        function(trans)
            self.step1EffectObj = trans
            self.go_table.obj_seal:SetActiveE(0)
            self.clickTimer =
                _G.DelayDo(
                0.5,
                function()
                    self.clickTimer = nil
                    self.click = true
                end
            )
        end
    )
    self.step = self.step + 1
end

function EventSealView:ShowEffectDrop()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.EventEffect_sifu03,
        self.transform,
        function()
            if not _G.IsNil(self.step1EffectObj) then
                self.step1EffectObj:DestroyObject()
            end
            self.step1EffectObj = nil
        end,
        function()
            self:OnEventDone()
            self:Close()
        end
    )
    self.step = self.step + 1
end

return EventSealView
