local base = require "EventViewBase"
---@class EventGhostVView : UIBaseView	中文描述
---@field public go_table EventGhostVView_GoTable GoTable
local EventGhostVView = _G.BaseClass("EventGhostVView", base)
--_G.EventGhostVView = EventGhostVView

local CS = _G.CS
local typeof = _G.typeof

local RODSTARTANGLE = -20
local RODENDANGLE = 90
---暂定刷新间隔是0.04秒(即25帧)
local UPDATEFRAMETIME = 0.04
local GEARSTARTPOSY = -147
local GEARENDPOSY = 218
local RODTRANSPATH = "effect/jiguanshu_01_item_01"
local RODTRANSPARENTNAME = "rodParent"

function EventGhostVView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    local x, y, z = self.go_table.obj_Gear:GetLocalPosition()
    self.gearPosition = {x = x, y = y, z = z}
    self.gearPosition.y = GEARSTARTPOSY
    self.go_table.obj_Gear:SetLocalPosition(self.gearPosition.x, self.gearPosition.y, self.gearPosition.z)
    self.rotateScripts = {}
    local EffectScriptType = typeof(CS.EffectScript_GameObjectTransform)
    self.rotateScripts[1] = self.go_table.obj_Gear:GetComponentE(EffectScriptType)
    self.rotateScripts[2] = self.go_table.aorimage_Start:GetComponentE(EffectScriptType)
    self.rotateScripts[3] = self.go_table.aorimage_gear:GetComponentE(EffectScriptType)
    self:RotateGear(false)
end

---界面的入口函数
function EventGhostVView:OnCreate(doneCall, closeCall, params)
    base.OnCreate(self, doneCall, closeCall)
    _G.SetEventTrigger(self.go_table.aorimage_Start, "onDown", _G.handler(self, self.OnDown))
    _G.SetEventTrigger(self.go_table.aorimage_Start, "onUp", _G.handler(self, self.OnUp))
    self.startAngle = 360 - _G.tonumber(params[4][1])
    if self.startAngle > 360 then
        self.startAngle = self.startAngle - 360
    end
    self.rodAngles = _G.Vector3(0, 0, self.startAngle)
    self.endAngle = 360 - _G.tonumber(params[4][2])
    local range =
        self.endAngle > self.startAngle and (self.endAngle - self.startAngle) or (360 - self.startAngle + self.endAngle)
    self.addAngleSpeed = (range * UPDATEFRAMETIME) / _G.tonumber(params[2][1])
    self.minusAngleSpeed = (range * UPDATEFRAMETIME) / _G.tonumber(params[2][2])
    self.addSpeed = ((GEARENDPOSY - GEARSTARTPOSY) * UPDATEFRAMETIME) / _G.tonumber(params[1][1])
    self.minusSpeed = -((GEARENDPOSY - GEARSTARTPOSY) * UPDATEFRAMETIME) / _G.tonumber(params[1][2])
    self.range = _G.tonumber(params[3][1])
    self.curSpeed = 0
    self.updateTimer = _G.TimerManager:GetInstance():GetTimer(UPDATEFRAMETIME, self.Update, self)
    self.updateTimer:Start()
    self:CreateEffect()
end

function EventGhostVView:OnDestroy()
    if not _G.IsNil(self.rodModel) then
        _G.UIUtils.RemoveEffect(self.rodModel, _G.ConfigManager.ui_effect_cfg.EventEffect_jiguan01.DispoeType)
    end
    self.rodModel = nil
    _G.UIUtils.Set3DUICameraDepth(_G.UIUtils.ModelCameraDepth.low)
end
---按钮点击事件在这里派发
function EventGhostVView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_close" then
        if self.updateTimer then
            self.updateTimer:Stop()
        end
        self:Close()
    end
end

---齿轮转动
---@param rotate boolean 是否转动
function EventGhostVView:RotateGear(rotate)
    for i = 1, #self.rotateScripts do
        self.rotateScripts[i].enabled = rotate
    end
end

function EventGhostVView:CreateEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.MapEventGhostEffect,
        self.transform,
        function(trans)
            self.rodModel = trans
            self.rodTrans = trans:FindE(RODTRANSPARENTNAME)
            if _G.IsNil(self.rodTrans) then
                self.rodTrans = _G.GameObject(RODTRANSPARENTNAME)
                self.rodTrans:SetParentE(trans)
                self.rodTrans:SetLocalEulerAngles(0, 0, 0)
                local rod = trans:FindE(RODTRANSPATH)
                local x, y, z = rod:GetLocalPosition()
                self.rodTrans:SetLocalPosition(x, y, z)
                rod:SetParentE(self.rodTrans)
            end
            self.rodTrans:SetLocalEulerAngles(self.rodAngles.x, self.rodAngles.y, self.rodAngles.z)
        end
    )
    _G.UIUtils.Set3DUICameraDepth(_G.UIUtils.ModelCameraDepth.middle)
end

function EventGhostVView:Update()
    if self.curSpeed == 0 then
        return
    end
    self.gearPosition.y = self.gearPosition.y + self.curSpeed
    if self.gearPosition.y <= GEARSTARTPOSY then
        self.gearPosition.y = GEARSTARTPOSY
    elseif self.gearPosition.y >= GEARENDPOSY then
        self.gearPosition.y = GEARENDPOSY
    end
    self.go_table.obj_Gear:SetLocalPosition(self.gearPosition.x, self.gearPosition.y, self.gearPosition.z)
    local rangeX, rangeY = self.go_table.obj_Range:GetLocalPosition()
    if _G.Mathf.Abs(self.gearPosition.y - rangeY) * 2 <= self.range then
        self:UpdateRod(true)
    else
        self:UpdateRod(false)
    end
end

function EventGhostVView:UpdateRod(add)
    if add then
        self.rodAngles.z = self.rodAngles.z - self.addAngleSpeed
        if self.rodAngles.z < 0 then
            self.rodAngles.z = self.rodAngles.z + 360
        end
        self.rodTrans:SetLocalEulerAngles(self.rodAngles.x, self.rodAngles.y, self.rodAngles.z)
        if _G.Mathf.Abs(self.endAngle - self.rodAngles.z) <= self.addAngleSpeed then
            self:PlayEffect()
        end
    else
        self.rodAngles.z = self.rodAngles.z + self.minusAngleSpeed
        if self.rodAngles.z > 360 then
            self.rodAngles.z = self.rodAngles.z - 360
        end
        if _G.Mathf.Abs(self.rodAngles.z - self.startAngle) <= self.minusAngleSpeed then
            self.rodAngles.z = self.startAngle
        end
        self.rodTrans:SetLocalEulerAngles(self.rodAngles.x, self.rodAngles.y, self.rodAngles.z)
    end
end
function EventGhostVView:PlayEffect()
    if self.updateTimer then
        self.updateTimer:Stop()
    end
    self:OnEventDone()

    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.MapEventSucceedEffect,
        self.rodTrans:GetParent(),
        nil,
        _G.handler(self, self.Close)
    )
end
function EventGhostVView:OnDown()
    self:RotateGear(true)
    self.curSpeed = self.addSpeed
end

function EventGhostVView:OnUp()
    self:RotateGear(false)
    self.curSpeed = self.minusSpeed
end

return EventGhostVView
