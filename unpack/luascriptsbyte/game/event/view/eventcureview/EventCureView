function EventCureClickItem:Show(doneCall, closeCall)
    if self.go_table == nil then
        return
    end
    if not self.anim then
        self.anim = self.go_table.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    else
        self.go_table.aorimage_tag:SetActiveE(0)
        self.anim.enabled = false
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Eff, false)
    self.clickDone = false
    self.onDoneCall = doneCall
    self.onCloseCall = closeCall
    self.time = MinBtnData[CurGameIndex].LiveTime
    self.curScale = 1
    self.go_table.trans_scale:SetLocalScale(self.curScale, self.curScale, 1)
    self.scaleTimer = _G.TimerManager:GetInstance():GetTimer(scaleTime, self.OnScaleUpdateCall, self)
    self.scaleTimer:Start()
end
---缩放
function EventCureClickItem:OnScaleUpdateCall(elapsed)
    if MinBtnData[CurGameIndex] == nil then
        return
    end
    self.time = self.time - elapsed
    self.curScale = scaleValue + (1 - scaleValue) * (Mathf.RoundToInt(self.time) / MinBtnData[CurGameIndex].LiveTime)
    -- self.go_table.trans_scale:SetLocalScale(self.curScale, self.curScale, 1)
    if self.time <= 0 then
        self:SetResult(false)
    end
end
---设置结果
---@param perfect boolean 是否完美
function EventCureClickItem:SetResult(perfect, isClick)
    if self.IsSet then
        return
    end
    self.IsSet = true
    if perfect == nil then
        perfect = false
        if self.time <= MinBtnData[CurGameIndex].LiveTime * MinBtnData[CurGameIndex].TimeRatio then
            perfect = true
        end
    end
    if self.scaleTimer ~= nil then
        self.scaleTimer:Stop()
        self.scaleTimer = nil
    end
    if isClick then
        self:loadBombEff(perfect)
    else
        LianjiCount = 0
    end
    if GameType == 2 then
        _G.Events:GetInstance():Broadcast(ListenerEnum, LianjiCount, perfect)
    end
    -- self.go_table.aorimage_tag.SpriteName = perfect and resultTag[GameType].perfect or resultTag[GameType].normal
    self.go_table.aorimage_tag:SetNativeSize()
    -- self.go_table.aorimage_tag:SetActiveE(1)
    if not self.anim then
        self.anim = self.go_table.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    else
        self.anim.enabled = true
    end
    if self.onDoneCall then
        self.onDoneCall(self)
    end
    self.scaleTimer1 = _G.TimerManager:GetInstance():GetTimer(MinBtnData[CurGameIndex].StayTime, self.Close, self, true)
    self.scaleTimer1:Start()
end
---结束消失
function EventCureClickItem:Close()
    self.IsSet = false
    if self.go_table.aorbtn_click then
        self.go_table.aorbtn_click:SetActiveE(1)
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Eff, false)
    self:OnPutItem()
    if self.onCloseCall then
        self.onCloseCall(self)
    end
    if self.scaleTimer1 then
        self.scaleTimer1:Stop()
        self.scaleTimer1 = nil
    end
end
