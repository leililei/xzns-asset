function EventCureGameBase:OnPlayCall()
    if self.showTimer then
        self.showTimer:Stop()
        self.showTimer = nil
    end
    self.showTimer = _G.TimerManager:GetInstance():GetTimer(MinBtnData[CurGameIndex].IntervalTime, self.ShowItem, self)
    self.showTimer:Start()
    self:ShowItem()
end
---展示圈 间隔时间调用
function EventCureGameBase:ShowItem()
    if self.curPosIndex > #self.playData then
        if self.showTimer then
            self.showTimer:Stop()
            self.showTimer = nil
        end
        return
    end
    self:OnShowItem()
    self.curPosIndex = self.curPosIndex + 2
end
