local EventCureItemPool = _G.BaseClass("EventCureItemPool")
function EventCureItemPool:__init()
    self.itemPool = {{}, {}, {}}
    self.itemCls = {EventCureClickItem, EventCureDragItem, EventCureDragClickItem}
end
function EventCureItemPool:Dispose()
    for i = 1, #self.itemPool do
        if self.itemPool[i] then
            for j = 1, #self.itemPool[i] do
                self.itemPool[i][j]:Dispose()
            end
        end
    end
    self.itemPool = nil
    self.itemObj = nil
    self.itemCls = nil
    self.getRoot = nil
    self.putRoot = nil
end
function EventCureItemPool:SetObj(obj1, obj2, obj3)
    self.itemObj = {obj1, obj2, obj3}
end
function EventCureItemPool:GetItem(t)
    local item
    if #self.itemPool[t] > 0 then
        item = remove(self.itemPool[t])
        item.gameObject:SetParentE(self.getRoot)
    else
        item = self.itemCls[t].New(_G.InstantiateObject(self.itemObj[t], self.getRoot))
    end
    return item
end
function EventCureItemPool:PutItem(t, item)
    _G.table.insert(self.itemPool[t], item)
    item.gameObject:SetParentE(self.putRoot)
end
function EventCureItemPool:SetParent(getRT, putRT)
    self.getRoot = getRT
    self.putRoot = putRT
end
