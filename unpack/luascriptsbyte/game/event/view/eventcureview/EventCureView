---@param data table min_button配置ID{{"id","type","typeCls"}} type ==0 为剧情 type==1 为庙会
function EventCureView:OnCreate(doneCall, closeCall, data)
    if _G.AppSetting.ArraignedType == _G.ArraignedStartType.Music then
        data = {{20203, 2}}
    end
    local id
    self.StartAnim = self.go_table.aorbtn_start:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    -- self.ResultHoriGroup = self.go_table.obj_Txt:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.HorizontalLayoutGroup))
    base.OnCreate(self, doneCall, closeCall)
    gameData = {}
    if not _G.table.isEmptyOrNil(data) then
        id = _G.tonumber(data[1] and data[1][1] or nil)
        GameType = _G.tonumber(data[1] and data[1][2] or 1)
        self.typeCls = data[1] and data[1][3] or nil
        self:InitCfgData(id)
    end
    self.onGameEnd = _G.handler(self, self.OnGameEnd)
    if GameType == 1 then
        self.BgContent = _G.GetAutoGoTable(self.go_table.obj_xindiantu)
    elseif GameType == 2 then
        self.BgContent = _G.GetAutoGoTable(self.go_table.obj_yinfu)
    end
    -- _G.GameUtil.SetActiveByCondition(self.go_table.obj_fanhui, GameType == 2)
    self.gameTimesImage = {
        self.BgContent.aorimage_bar1,
        self.BgContent.aorimage_bar2,
        self.BgContent.aorimage_bar3,
        self.BgContent.aorimage_bar4
    }
    self.typeClass = {
        EventCureClickClass.New(self.onGameEnd),
        EventCureDragClass.New(self.onGameEnd, self.go_table.trans_root)
    }
    EventCureItemPoolInstance:SetObj(
        self.go_table.obj_itemClick,
        self.go_table.obj_itemDrag,
        self.go_table.obj_dragClick
    )
    EventCureItemPoolInstance:SetParent(self.go_table.trans_root, self.go_table.trans_hide)
    self.go_table.aortext_Score.text = MScore
    self.go_table.aortext_Slider.text = "0%"
    self:DoGameStart()
end

---按钮点击事件在这里派发
function EventCureView:OnClickBtn(go)
    if go == self.go_table.aorbtn_start then
        self:DoGameStart()
    elseif go == self.go_table.aorbtn_Close or go == self.go_table.aorbtn_CloseView then
        if _G.AppSetting.ArraignedType == _G.ArraignedStartType.Music then
            self:Reset()
            self.go_table.obj_GameEnd:SetActiveE(0)
            self:DoGameStart()
            return
        end
        _G.Events:GetInstance():Broadcast(GameDied)
        self:Close()
    elseif go == self.go_table.aorbtn_restart then
        self:Reset()
        self.go_table.obj_GameEnd:SetActiveE(0)
        self:DoGameStart()
    elseif go == self.go_table.aorbtn_pause then
        if not self.curGameData then 
            self:Close()
            return 
        end
        if self.GameStart then
            self.curPlayIndex = #self.curGameData.game + 1
            self.curGameIndex = #gameData + 1
            self:OnGameEnd()
        end
    end
end

function EventCureView:DoGameStart()
    if not self.GameStart then
        _G.Events:GetInstance():AddListener(ListenerEnum, self.DisposeResourceAndCreate, self)
        self.curGameIndex = 1
        self.StartAnim.enabled = true
        self.countDownNum = 3
        self:UpdateCountDown()
        self.countdown = _G.TimerManager:GetInstance():GetTimer(1, self.ShowCountdown, self, false, false, true)
        self.countdown:Start()
    end
end

function EventCureView:UpdateCountDown()
    if self.countDownNum and self.countDownNum > 0 then
        self.go_table.aorimage_countDown.SpriteName = "ui_hbdj_djs_" .. self.countDownNum
        self.go_table.aorimage_countDown:SetActiveE(1)
    elseif self.countDownNum and self.countDownNum <= 0 then
        self.go_table.aorimage_countDown:SetActiveE(0)
    end
end

function EventCureView:ShowCountdown()
    self.countDownNum = self.countDownNum - 1
    if self:IsNil() then
        return
    end
    if self.countDownNum <= 0 then
        self.GameStart = true
        self.go_table.obj_mask:SetActiveE(0)
        self.countdown:Stop()
        -- _G.GameUtil.SetActiveByCondition(self.go_table.obj_yinfu, GameType == 2)
        -- _G.GameUtil.SetActiveByCondition(self.go_table.obj_xindiantu, GameType == 1)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_Score, GameType == 2)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_start, false)
        self:PlayGame()
    end
    self:UpdateCountDown()
end


function EventCureView:CreateNum(num)
    local item = _G.InstantiateObject(self.go_table.aorimage_num, self.go_table.obj_lianjiContent)
    item:GetComponentE(_G.typeof(_G.CS.AorImage)).SpriteName = numImage .. num
    if not self.NumList then
        self.NumList = {}
    end
    _G.table.insert(self.NumList, item)
end
function EventCureView:DisposeResourceAndCreate(count, perfect)
    -- if self.go_table.aorimage_Rate.SpriteName ~= CurLevelImage then
    --     _G.GameUtil.SetActiveByCondition(self.go_table.obj_Score, false)
    --     _G.GameUtil.SetActiveByCondition(self.go_table.obj_Score, true)
    -- end
    -- self.go_table.aorimage_Rate.SpriteName = CurLevelImage
    self.go_table.aortext_Score.text = MScore
    self.go_table.aorimage_Progress.fillAmount = MScore / MaxScore
    if self.NumList then
        for k, v in pairs(self.NumList) do
            v:DestroyObject()
        end
    end
    if count < 2 or not perfect then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_lianji, false)
        return
    end
    local str = tostring(count)
    local len = string.len(count)
    local numlist = {}
    for i = 1, len do
        table.insert(numlist, string.sub(str, i, i))
    end
    -- for k, v in pairs(numlist) do
    --     self:CreateNum(tonumber(v))
    -- end
    -- _G.GameUtil.SetActiveByCondition(self.go_table.obj_lianji, false)
    -- _G.GameUtil.SetActiveByCondition(self.go_table.obj_lianji, true)
    self.go_table.obj_fireEff:SetActiveE(0)
    self.go_table.obj_fireEff:SetActiveE(1)
end
---初始化配置数据
---@param id number min_button配置ID
function EventCureView:InitCfgData(id)
    local cfg = _G.ConfigManager.min_button_cfg[id]
    if not cfg then
        return
    end
    if not _G.string.IsNullOrEmpty(cfg.Fragment_image) then
        self.go_table.aorrawimage_bg:LoadImage(cfg.Fragment_image)
    end
    local minBtnEventCfgs = _G.ConfigManager.min_button_event_cfg
    ComputeMaxScore(cfg)
    local mbtCfg
    local index = 1
    for i = 1, #cfg.EventID do
        mbtCfg = minBtnEventCfgs[cfg.EventID[i]]
        if mbtCfg then
            if not gameData[index] then
                gameData[index] = {story = 0, game = nil}
            end
            gameData[index].ID = mbtCfg.ID
            gameData[index].story = mbtCfg.StoryID
            gameData[index].game = _G.DeepCopyCfgTable(mbtCfg.IntervalPos)
            if not MinBtnData[index] then
                MinBtnData[index] = {}
            end
            MinBtnData[index].StayTime = mbtCfg.StayTime
            MinBtnData[index].GameStartTime = mbtCfg.GameStartTime
            MinBtnData[index].IntervalTime = mbtCfg.IntervalTime
            MinBtnData[index].LiveTime = mbtCfg.LiveTime
            MinBtnData[index].TimeRatio = mbtCfg.TimeRatio
            MinBtnData[index].fraction = mbtCfg.fraction
            index = index + 1
        end
    end
end
function EventCureView:PlayGame()
    self.curGameData = _G.DeepCopy(gameData[self.curGameIndex])
    self.curPlayIndex = 1
    -- self:LoadEffect(BgContentEffPath[GameType], self.gameTimesImage[self.curGameIndex])
    self.gameTimesImage[self.curGameIndex]:GetComponentE(_G.typeof(_G.CS.AorImage)).enabled = false
    self.go_table.slider_progress.value = self.curGameIndex / 4
    self.go_table.aortext_Slider.text = self.curGameIndex * 25 .. "%"
    self:OnPlay()
end
function EventCureView:OnPlay()
    local t = remove(self.curGameData.game[self.curPlayIndex], 1)
    self.typeClass[t]:Play(self.curGameData.game[self.curPlayIndex])
end
function EventCureView:OnGameEnd()
    if _G.AppSetting.IsXzns and not self.GameStart or self:IsNil() then
        return
    end
    if self.curGameData.story > 0 then
        _G.AutomaticPlayStory.PlayStoryByID(self.curGameData.story, _G.handler(self, self.OnGameEnd))
        self.curGameData.story = 0
        return
    end
    self.curPlayIndex = self.curPlayIndex + 1
    if self.curPlayIndex > #self.curGameData.game then
        CurGameIndex = self.curGameIndex + 1
        self.curGameIndex = self.curGameIndex + 1
        if self.curGameIndex > #gameData then
            CurGameIndex = #gameData
            self:OnEventDone()
            if GameType == 2 then
                if self.go_table.obj_GameEnd:GetActiveSelf() == 1 then 
                    return 
                end
                self:ShowResult()
            elseif GameType == 1 then
                self:Close()
            end
        else
            self:PlayGame()
        end
    else
        self:OnPlay()
    end
end
function EventCureView:LoadEffect(path, parent, call, loadcall)
    _G.UIUtils.LoadEffectByCfg(
        path,
        parent,
        function(tran)
            if loadcall then
                loadcall()
            end
        end,
        function()
            if call then
                call()
            end
        end
    )
end
local scoreUpTime = 1
function EventCureView:DoScoreUp(score)
    local _score = 0
    while _score < MScore - score do
        _score = _score + score
        if self:IsNil() then
            return
        end
        self.go_table.aortext_turnScore.text = _score
        _G.coroutine.waitforendofframe()
    end
    if self:IsNil() then
        return
    end
    self.go_table.aortext_turnScore.text = MScore
    _G.coroutine.waitforendofframe()
end
function EventCureView:ShowResult()
    local fundScore = math.floor(MScore / 30)
    -- self.ResultHoriGroup.enabled = false
    self.go_table.aortext_turnScore.text = MScore
    -- self.ResultHoriGroup.enabled = true
    self.go_table.aorimage_Result.SpriteName = CurLevelImage
    self.go_table.obj_GameEnd:SetActiveE(1)
    self:Submit(MScore)
    self.ScoreCo = _G.coroutine.start(_G.handlerbind(self, self.DoScoreUp, fundScore))
    _G.DelayDo(
        1,
        function()
            if self:IsNil() then
                return
            end
            self.go_table.aorimage_Result:SetActiveE(1)
            self.go_table.aorbtn_Close:SetActiveE(1)
        end
    )
end
function EventCureView:Submit(MScore)
    if _G.AppSetting.ArraignedType == _G.ArraignedStartType.Music then
        return
    end
    if self.typeCls.curActivityClass:GetTypeId() == 10070 then
        self.typeCls:Finish(
            MScore,
            function()
                if self.doneCallback then 
                    self.doneCallback()
                end
            end
        )
    elseif self.typeCls.Mscore < MScore then
        self.typeCls:SubmitScore(
            MScore,
            function()
                self.typeCls:SetNewRankData(
                    MScore,
                    function()
                        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.TempleView.Name)
                        if view then
                            view:SetData()
                        end
                        self.typeCls:RefreshRedPointTemple()
                    end
                )
            end
        )
    end
end

function EventCureView:Reset()
    self.go_table.obj_GameEnd:SetActiveE(0)
    self.curGameIndex = 1
    CurGameIndex = 1
    MScore = 0
    LianjiCount = 0
    self.go_table.obj_lianji:SetActiveE(0)
    SetLevelByScore()
    self.go_table.aorimage_Result.SpriteName = CurLevelImage
    self.go_table.aortext_Score.text = MScore
    self.go_table.aorimage_Progress.fillAmount = MScore / MaxScore
    self.go_table.aortext_Slider.text = "0%"
    self.go_table.slider_progress.value = 0
    self.GameStart = false
end

function EventCureView:OnDestroy()
    if self.ScoreCo ~= nil then
        _G.coroutine.stopwaiting(self.ScoreCo)
        self.ScoreCo = nil
    end
    self.curGameIndex = nil
    self.typeClass = nil
    self.curPlayIndex = nil
    gameData = nil
    _G.Events:GetInstance():RemoveListener(ListenerEnum, self.DisposeResourceAndCreate, self)
    gameData = nil
    GameType = 2
    MinBtnData = {}
    CurGameIndex = 1
    MScore = 0
    MaxScore = 0
    LianjiCount = 0
    CurLevelImage = LevelImage[1]
end
return EventCureView
