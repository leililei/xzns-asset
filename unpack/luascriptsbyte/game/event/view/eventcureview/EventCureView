    self.playData = data
    self.itemCount = #data * 0.5
    self.curPosIndex = 1
    if self.showTimer then
        self.showTimer:Stop()
        self.showTimer = nil
    end
    self.showTimer =
        _G.TimerManager:GetInstance():GetTimer(MinBtnData[CurGameIndex].GameStartTime, self.OnPlayCall, self, true)
    self.showTimer:Start()
