---展示
---@param x number 下一个节点的x坐标
---@param y number 下一个节点的y坐标
function EventCureDragItem:Show(doneCall, closeCall, index, x, y)
    if not self.anim then
        self.anim = self.go_table.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    else
        self.go_table.aorimage_tag:SetActiveE(0)
        self.anim.enabled = false
    end
    EventCureClickItem.Show(self, doneCall, closeCall)
    self.curIndex = index
    _G.GameUtil.SetActiveByCondition(self.go_table.trans_arrow, x ~= nil)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_point, x == nil)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_line, x ~= nil)
    --计算箭头朝向
    if x == nil then
        return
    end
    local angle, dis = self:ComputePointAngleAndDistance(x, y)
    if angle then
        self.go_table.obj_Line:SetLocalEulerAngles(0, 0, angle)
    end
    if dis then
        self.temp_co = _G.coroutine.start(_G.handlerbind(self, self.SetLinePos, dis))
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_line, true)
    end
end
function EventCureDragItem:SetLinePos(dis)
    local add = dis / (MinBtnData[CurGameIndex].IntervalTime * 30)
    local _dis = dis
    local realDis = 0
    while realDis < _dis do
        realDis = realDis + add
        self.go_table.obj_line:SetRectTransformSize(realDis, 60)
        _G.coroutine.waitforendofframe()
    end
    _G.coroutine.waitforendofframe()
end
function EventCureDragItem:Close()
    self.go_table.obj_Line:SetLocalEulerAngles(0, 0, 0)
    self.super.Close(self)
end
---@param x 下个点的x坐标
---@param y 下个点的y坐标
---@return angle dis 角度和长度
function EventCureDragItem:ComputePointAngleAndDistance(x, y)
    if x == nil then
        return
    end
    local myX, myY, myZ = self.gameObject:GetLocalPosition()
    local offX, offY
    local angle = 0
    local dis = 0
    offX = myX - x
    offY = myY - y
    dis = math.sqrt((offX) * (offX) + (offY) * (offY))
    angle = math.atan((offY / offX)) * 180 / math.pi
    if offX >= 0 then
        if angle >= 0 then
            angle = math.abs(angle) - 180
        else
            angle = 180 - math.abs(angle)
        end
    end
    return angle, dis
end
