local ComputeMaxScore = function(cfg)
    local mbtCfg
    local lianjiCount = 0
    local extra = 0
    for i = 1, #cfg.EventID do
        mbtCfg = _G.ConfigManager.min_button_event_cfg[cfg.EventID[i]]
        if mbtCfg then
            local click = not _G.table.isEmptyOrNil(mbtCfg.fraction) and mbtCfg.fraction[1] or 0
            local drag = not _G.table.isEmptyOrNil(mbtCfg.fraction) and mbtCfg.fraction[2] or 0
            for k, v in pairs(mbtCfg.IntervalPos) do
                lianjiCount = lianjiCount + (#v - 1) / 2
                if v[1] == 1 then
                    MaxScore = MaxScore + click * ((#v - 1) / 2)
                elseif v[1] == 2 then
                    MaxScore = MaxScore + drag * ((#v - 1) / 2)
                end
            end
        end
    end
    for i = 1, lianjiCount / 3 do
        extra = extra + LianjiInfo[2] * i
    end
    MaxScore = math.floor(extra + MaxScore)
end
local SetLevelByScore = function()
    for i = #levelInfo, 1, -1 do
        if MScore >= levelInfo[i] then
            CurLevelImage = LevelImage[i]
            return
        end
    end
end
---type true click false drag
local SetTotalScore = function(type)
    local extra = 0
    local click =
        not _G.table.isEmptyOrNil(MinBtnData[CurGameIndex].fraction) and MinBtnData[CurGameIndex].fraction[1] or 0
    local drag =
        not _G.table.isEmptyOrNil(MinBtnData[CurGameIndex].fraction) and MinBtnData[CurGameIndex].fraction[2] or 0
    if LianjiCount % LianjiInfo[1] == 0 then
        extra = LianjiInfo[2] * (LianjiCount / LianjiInfo[1])
    end
    if type then
        MScore = click + MScore
    else
        MScore = drag + MScore
    end
    MScore = math.floor(extra + MScore)
end
