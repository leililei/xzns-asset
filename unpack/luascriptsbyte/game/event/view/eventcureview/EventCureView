function EventCureDragClass:OnShowItem()
    if self.curPosIndex == 1 then
        self.dragItem = EventCureItemPoolInstance:GetItem(itemtype.dragClick)
        self.dragItem.gameObject:SetLocalPosition(
            self.playData[self.curPosIndex],
            self.playData[self.curPosIndex + 1],
            0
        )
        self.dragItem:SetDragCall(self.onDragBegin, self.onDrag, self.onDragEnd, self.onDown)
    end
    local item = EventCureItemPoolInstance:GetItem(itemtype.drag)
    item.gameObject:SetLocalPosition(self.playData[self.curPosIndex], self.playData[self.curPosIndex + 1], 0)
    item:Show(
        self.onItemDoneCall,
        self.onItemCloseCall,
        (self.curPosIndex + 1) * 0.5,
        self.playData[self.curPosIndex + 2],
        self.playData[self.curPosIndex + 3]
    )
    self.dragItemList[(self.curPosIndex + 1) * 0.5] = item
end
