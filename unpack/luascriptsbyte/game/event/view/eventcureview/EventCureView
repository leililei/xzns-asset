function EventCureDragClass:OnItemPressDown()
    if self.dragItemList[1] then
        self.dragItemList[1]:SetResult(nil, true)
    end
    self.curCheckIndex = 2
    self.pressDown = true
end
function EventCureDragClass:OnItemDragBegin(ed)
    local ret, uipos =
        CS.UnityEngine.RectTransformUtility.ScreenPointToLocalPointInRectangle(
        self.rectRoot,
        ed.position,
        _G.UIManager:GetInstance().UICamera
    )
    if self.curMousePos then
        self.curMousePos.x = uipos.x
        self.curMousePos.y = uipos.y
    else
        self.curMousePos = {x = uipos.x, y = uipos.y}
    end
    self.widthScale = _G.AppSetting.CONFIG_SCREEN_HEIGHT / _G.AppSetting.SCREEN_HEIGHT * _G.AppSetting.SCREEN_WIDTH
end
function EventCureDragClass:OnItemDrag(ed)
    self.curMousePos.x = self.curMousePos.x + ed.delta.x / _G.AppSetting.SCREEN_WIDTH * self.widthScale
    self.curMousePos.y =
        self.curMousePos.y + ed.delta.y / _G.AppSetting.SCREEN_HEIGHT * _G.AppSetting.CONFIG_SCREEN_HEIGHT
    if self.dragItemList[self.curCheckIndex] then
        if
            _G.Mathf.Abs(self.playData[self.curCheckIndex * 2] - self.curMousePos.y) < 75 and
                _G.Mathf.Abs(self.playData[self.curCheckIndex * 2 - 1] - self.curMousePos.x) < 75
         then
            self.dragItemList[self.curCheckIndex]:SetResult(nil, true)
            self.curCheckIndex = self.curCheckIndex + 1
        end
    end
end
function EventCureDragClass:OnItemDragEnd(ed)
    if not self.pressDown then
        return
    end
    self:OnGameEnd()
end
function EventCureDragClass:OnGameEnd()
    self.pressDown = nil
    if self.dragItem then
        self.dragItem:OnPutItem()
        self.dragItem = nil
    end
end
