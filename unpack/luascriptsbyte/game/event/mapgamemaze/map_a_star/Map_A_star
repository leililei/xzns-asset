local EventGameMazeMap = require("EventGameMazeMap")
local EventGameMazeGridData = require("EventGameMazeGridData")
---@class Map_A_star : Singleton	中文描述
local Map_A_star = _G.BaseClass("Map_A_star", _G.Singleton)
_G.Map_A_star = Map_A_star

local CS = _G.CS
local typeof = _G.typeof

---@return Map_A_star Map_A_star
function Map_A_star:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
---@field openList table 开启的列表
---@field closeList table 关闭的列表
---@field boundx number  地图边界 x
---@field boundy number  地图边界 y
function Map_A_star:__init()
    self.openList = {}
    self.closeList = {}
    self.boundx = 0
    self.boundy = 0
    self.map = {}
end
---销毁对象时,析构函数
function Map_A_star:Dispose()
    self.openList = nil
    self.closeList = nil
end
---初始化地图
---@param id number 地图 id
function Map_A_star:InitMap(id)
    self.map = {}
    self.isfirst = EventGameMazeMap:GetInstance().isfirst
    EventGameMazeMap:GetInstance():InitMap(id)
    self.map = EventGameMazeMap:GetInstance():GetMap(id)
    -- EventGameMazeMap:GetInstance():SetMapStart(mapstart)
    -- EventGameMazeMap:GetInstance():SetMapEnd(mapend)
    self.boundy = EventGameMazeMap:GetInstance():GetMapBoundary_x()
    self.boundx = EventGameMazeMap:GetInstance():GetMapBoundary_y()
end
---查找路径
---@param mapstar table 地图的起点的x，y
---@param mapend table 地图的终点x,y
function Map_A_star:FindRoad(mapstart, mapEnd)
    --点是不是处于地图范围内
    if _G.table.isEmptyOrNil(self.map) then
        _G.FloatTipsModel:GetInstance():Show("地图数据是空")
        return nil
    end
    --起点是不是终点
    if mapstart.x <= 0 or mapstart.x > self.boundx or mapstart.y < 0 or mapstart.y > self.boundy then
        _G.FloatTipsModel:GetInstance():Show("起点，位于地图 之外")
        return nil
    end
    if mapEnd.x <= 0 or mapEnd.x > self.boundx or mapEnd.y <= 0 or mapEnd.y > self.boundy then
        _G.FloatTipsModel:GetInstance():Show("终点，位于地图 之外")
        return nil
    end
    self.openList = {}
    self.closeList = {}
    local farter = self.map[mapstart.x][mapstart.y]
    farter:SetParentNode({})
    local target = self.map[mapEnd.x][mapEnd.y]
    target:SetMazeClickType(_G.GameGrid_Maze_Click_Enum.keyi)
    _G.table.insert(self.closeList, farter)
    while true do
        --四方向查找
        --上
        self:CheckNode(mapstart.x - 1, mapstart.y, 1, farter, target)
        --下
        self:CheckNode(mapstart.x + 1, mapstart.y, 1, farter, target)
        --左
        self:CheckNode(mapstart.x, mapstart.y - 1, 1, farter, target)
        --右
        self:CheckNode(mapstart.x, mapstart.y + 1, 1, farter, target)
        --判断f 最小值
        _G.table.sort(
            self.openList,
            function(a, b)
                return a:GetMazeFinalDistance() < b:GetMazeFinalDistance()
            end
        )
        if _G.table.isEmptyOrNil(self.openList) then
            _G.FloatTipsModel:GetInstance():Show("死路")
            return nil
        end
        local node = self.openList[1]
        _G.table.insert(self.closeList, node)
        _G.table.remove(self.openList, 1)
        if node:GetMazeClickType() == _G.GameGrid_Maze_Click_Enum.keyi then
            return self:GetMoveRoad(node)
        end
        mapstart = node:GetMazeGridPosMap()
        farter = node
    end
    return nil
end

---检测点 是否 是合法，判断
function Map_A_star:CheckNode(x, y, g, farter, endnode)
    --local map_grid = EventGameMazeGridData.New()
    --检测是否 超出了边界
    if x <= 0 or x > self.boundx or y <= 0 or y > self.boundy then
        return
    end
    local map_grid = self.map[x][y]
    --判断是否阻挡
    if
        map_grid:GetMazeGridType() == _G.GameGridEnum_Maze.wallgrid1 or
            map_grid:GetMazeGridType() == _G.GameGridEnum_Maze.wallgrid2 or
            map_grid:GetMazeGridType() == _G.GameGridEnum_Maze.wallgrid3
     then
        return
    end
    if self.isfirst and map_grid:GetMazeGridType() == _G.GameGridEnum_Maze.redgridgrid then
        return
    end
    --判断是不是在openlist 中
    if not _G.table.isEmptyOrNil(self.openList) then
        for key, value in pairs(self.openList) do
            if map_grid:GetMazeGridId() == value:GetMazeGridId() then
                return
            end
        end
    end
    if not _G.table.isEmptyOrNil(self.closeList) then
        for key, value in pairs(self.closeList) do
            if map_grid:GetMazeGridId() == value:GetMazeGridId() then
                return
            end
        end
    end
    local g = farter:GetMazeStartDistance() + g
    local h =
        (endnode:GetMazeGridPosMap().x - map_grid:GetMazeGridPosMap().x) +
        (endnode:GetMazeGridPosMap().y - map_grid:GetMazeGridPosMap().y)
    local f = g + h
    map_grid:SetMazeFinalDistance(f)
    map_grid:SetMazeStartDistance(g)
    map_grid:SetParentNode(farter)
    _G.table.insert(self.openList, map_grid)
end
---可行走的路径
function Map_A_star:GetMoveRoad(node)
    local roads = {}
    local temp = node
    while not _G.table.isEmptyOrNil(temp:GetParentNode()) do
        _G.table.insert(roads, temp)
        if temp:GetMazeGridType() == _G.GameGridEnum_Maze.yellowgrid then
            local num = EventGameMazeMap:GetInstance().boxnum
            num = num + 1
            EventGameMazeMap:GetInstance().boxnum = num
        end
        temp = temp:GetParentNode()
    end
    return roads
end

return Map_A_star
