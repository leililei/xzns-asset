---初始化地图,可以走配置文件
function EventGameMazeMap:InitMap(id)
    self.boxnum = 0
    self.mapData = {}
    self.mapstart = {}
    self.mapend = {}
    local origin = {}
    origin.x = 937.89 / 2
    origin.y = 391.41 / 2
    self:SetMapId(id)
    local mincfg = _G.ConfigManager.min_step_cfg
    local temp1 = {}
    for key, value in pairs(mincfg[id].event) do
        _G.table.insert(temp1, value)
    end
    local maps_row_cals = {}
    for i = 1, #temp1 do
        local cal = temp1[i][1]
        local row = temp1[i][2]
        local value = temp1[i][3]
        local te = {}
        te[cal] = value
        if _G.table.isEmptyOrNil(maps_row_cals[row]) then
            maps_row_cals[row] = {}
        end
        _G.table.insert(maps_row_cals[row], value)
    end
    local rows_num = #maps_row_cals
    local cfg = _G.ConfigManager.min_step_event_cfg
    for i = 1, rows_num do
        local cols = #maps_row_cals[i]
        local temp = {}
        for j = 1, cols do
            local map_temp = maps_row_cals[i][j]
            local gridNode = EventGameMazeGridData.New()
            local data = {
                id = (i - 1) * 12 + j,
                map = {x = i, y = j},
                u_unity = {x = 0, y = 0},
                gridtype = 0,
                movetype = _G.GameGrid_Maze_Move_Enum.move,
                clicktype = _G.GameGrid_Maze_Click_Enum.bukeyi
            }
            gridNode:ParseInitMsg(data)

            local type = cfg[map_temp]
            local icon = type.icon
            --if type.event_type == _G.GameGridEnum_Maze.groundgrid1 then
            --gridNode:SetMazeMoveType(_G.GameGrid_Maze_Move_Enum.nomove)
            -- if type.event_type == _G.GameGridEnum_Maze.boxgrid then
            --     icon = "ui_jqwf_caodi_01"
            if type.event_type == _G.GameGridEnum_Maze.destination then
                self.mapend = gridNode
            elseif type.event_type == _G.GameGridEnum_Maze.startgrid then
                self.mapstart = gridNode
                icon = "ui_jqwf_caodi_01"
            elseif type.event_type == _G.GameGridEnum_Maze.yellowgrid then
                --self.boxnum = self.boxnum + 1
                icon = "ui_jqwf_caodi_01"
            elseif type.event_type == _G.GameGridEnum_Maze.redgridgrid then
                icon = "ui_jqwf_caodi_01"
            end
            gridNode:SetMazeGridType(type.event_type)
            gridNode:SetImageIcon(icon)
            local x = ((-origin.x) + 78 * j) - 39
            local y = (origin.y - 78 * i) + 39
            gridNode:SetMazeGridPosUnity(x, y)
            temp[j] = gridNode
        end
        self.mapData[i] = temp
    end
end
