local base = require "ActivitySynTypeBase"
local ActivitySynManager = require "ActivitySynManager"
---@class ActivityRechargeDBackDjqSynModel :ActivitySynTypeBase 首充代金券奖励
local ActivityRechargeDBackDjqSynModel = _G.BaseClass("ActivityRechargeDBackDjqSynModel", base)

---类的构造函数
---@param activity ActivitySynGMActivity
function ActivityRechargeDBackDjqSynModel:__init(activity)
    activity:AddStateChanged(self.OnActivityStateChanged, self)
end

function ActivityRechargeDBackDjqSynModel:OnActivityStateChanged(state)
    if state == ActivitySynManager.State.Close then
        self:UpdateRedpoint()
    end
end

---类的析构函数
function ActivityRechargeDBackDjqSynModel:Dispose()
end

---获取数据
function ActivityRechargeDBackDjqSynModel:OnHandleGMData(info)
    --LogError(info)
    self:SetSelfData(info)
    base.ParseData(self)
end

function ActivityRechargeDBackDjqSynModel:ParseData(data)
    self:SetSelfData(data)
    base.ParseData(self)
end

function ActivityRechargeDBackDjqSynModel:SetSelfData(info)
    local subType = self.curActivityClass:GetJumpType()

    self.endTime = self.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)

    if info == nil or info.cash_first == nil then
        if _G.AppSetting.DEBUG then
            _G.Log("配置信息为空, 代金券首充奖励")
        end
        return
    end
    local cfg
    self.infocfg = info.cash_first.gifts or {}
    for _, v in pairs(self.infocfg) do
        if _G.tonumber(v.name) then
            v.name = _G.LangUtil.GetLangPackValue(_G.tonumber(v.name))
        end
    end
    --self.times = info.times or {} --{sid,num} --礼包购买次数
    self.times_buy = {}
    if info.cash_first.times ~= nil then
        for i = 1, #info.cash_first.times do
            local buy = info.cash_first.times[i]
            -- if self.times_buy[buy.k] == nil then
            --     self.times_buy[buy.k] = 0
            -- end
            self.times_buy[buy.k] = buy.v
        end
    end
end

---
---@protected
function ActivityRechargeDBackDjqSynModel:CheckState()
    ---@type MainOpenViewFunItem
    local MainOpenViewFunItem = {}
    MainOpenViewFunItem.OpenViewFun = function()
        local windowName = _G.ConfigManager.ui_cfg.RechargeDBackDjqView.Name
        local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.RechargeDBackDjqView.Name)
        if window then
            window.View:UpdateView(self.curActivityClass)
        else
            _G.UIManager:GetInstance():OpenWindow(windowName, self.curActivityClass)
        end
    end
    _G.MainManager:GetInstance():AddMainFunQueue(MainOpenViewFunItem, _G.MainViewShowOrder.RechargeDBackDjq)
end

function ActivityRechargeDBackDjqSynModel:InitFunction()
    self:CheckState()
    
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
    local View = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.RechargeDBackDjqView.Name)
    if View then
        View:UpdateView(self.curActivityClass)
    end
end

function ActivityRechargeDBackDjqSynModel:CheckRed()
    local num = _G.PlayerPrefsManager.GetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "RechargeDBackDjq", 0)
    if num == 0 then
        return 1
    else
        local time = num
        local time2 = self:GetTime()
        return time < time2 and 1 or 0
    end
end

function ActivityRechargeDBackDjqSynModel:GetTime()
    local time = _G.TimeUtil.GetServerUnixTime()
    local data = _G.TimeUtil.GetDateTime(time)
    if data.hour < _G.TimeUtil.GAME_DAY_HOUR then
        return _G.TimeUtil.GetDayBegin(time - _G.TimeUtil.GAME_DAY_TIME) + _G.TimeUtil.GAME_DAY_TIME
    else
        return _G.TimeUtil.GetDayBegin(time) + _G.TimeUtil.GAME_DAY_TIME
    end
end

