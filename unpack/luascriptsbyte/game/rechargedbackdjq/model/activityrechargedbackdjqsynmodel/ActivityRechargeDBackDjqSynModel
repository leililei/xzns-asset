function ActivityRechargeDBackDjqSynModel:OnGetMainViewName()
    local view = _G.ConfigManager.ui_cfg.RechargeDBackDjqView.Name
    return view
end

function ActivityRechargeDBackDjqSynModel:OnSixClockUpdate(endcall)
    base.OnSixClockUpdate(self, endcall)
end

---获取动态的商场数据  购买的次数
---@param sid number 礼包sid
function ActivityRechargeDBackDjqSynModel:GetItemBuyTimes(sid)
    if self.times_buy and self.times_buy[sid] then
        return self.times_buy[sid]
    else
        return 0
    end
end

---设置购买的id
---@param sid number 充值成功
function ActivityRechargeDBackDjqSynModel:SetItemBuyTimes(sid)
    if self.times_buy and self.times_buy[sid] then
        self.times_buy[sid] = self.times_buy[sid] + 1
    else
        self.times_buy[sid] = 1
    end
end

---充值
function ActivityRechargeDBackDjqSynModel:Pay(giftinfo, call)
    --清除之前的购买回调(如果玩家取消了支付OnMallCashListener接口将不会回调)
    self.mallCall = nil

    local activity_id = self.curActivityClass.realActivityId and self.curActivityClass.realActivityId or
        self.curActivityClass:GetActivityID()
    if giftinfo.price == 0 then
        require "ActivitySynNet":GetInstance():GetAward(
            activity_id,
            { giftinfo.sid },
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                if call then
                    self:SetItemBuyTimes(giftinfo.sid)
                    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                    self:UpdateRedpoint()
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                    call(msg)
                end
            end
        )
    else
        if giftinfo.consume_type == 0 then
            _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
            require "MallManager":GetInstance():BuyActiveGift(giftinfo.price, activity_id, giftinfo.sid, false)
            self.PaySid = giftinfo.sid
            self.mallCall = call
        else
            self:BuyRes(activity_id, giftinfo, call)
        end
    end
end

---初始化红点
function ActivityRechargeDBackDjqSynModel:InitRedPointTree()
    self.checkRedPointFunc = { self.CheckFreeGift }
    self.redpointTree = { false, false }
end

---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function ActivityRechargeDBackDjqSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

function ActivityRechargeDBackDjqSynModel:UpdateRedpoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

---是否 每日的首次登录
function ActivityRechargeDBackDjqSynModel:CheckFreeGift()
    return self:CheckRed()
    --return 0
end

---@param data store.p2c_store_cash
function ActivityRechargeDBackDjqSynModel:OnMallCashListener(data)
    if self.mallCall then
        self:SetItemBuyTimes(self.PaySid)
        self.mallCall()
        self.mallCall = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

---获取活动结束时间
function ActivityRechargeDBackDjqSynModel:GetEndTime()
    return self.curActivityClass.cfg.time.start_time + self.curActivityClass.cfg.time.run_time
end

function ActivityRechargeDBackDjqSynModel:IsShowBtn()
    return true
end

---资源购买礼包
function ActivityRechargeDBackDjqSynModel:BuyRes(activity_id, giftinfo, call)
    local num = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.ResProp, _G.ResPropID.Diamond)
    if num < giftinfo.price then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ResPropID.Diamond)
        return
    end
    require "ActivitySynNet":GetInstance():BuyGift(
        activity_id,
        giftinfo.sid,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            if call then
                self:SetItemBuyTimes(giftinfo.sid)
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                self:UpdateRedpoint()
                if giftinfo.consume_type then
                    _G.StorageManager:GetInstance():ConsumeItem(giftinfo.consume_type, 0, giftinfo.price)
                end
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                call(msg)
            end
        end
    )
end

return ActivityRechargeDBackDjqSynModel
