---@protected
function ActivityRechargeDBackDjqSynModel:ChangeLoginRed()
    _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "RechargeDBackDjq", self:GetTime())
    self:UpdateRedpoint()
end

function ActivityRechargeDBackDjqSynModel:OnEnterActivity()
    local window, windowName
   
