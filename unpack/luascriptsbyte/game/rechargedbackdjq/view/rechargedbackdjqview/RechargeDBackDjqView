local MallManager = require("MallManager")

---@class RechargeDBackDjqView : UIBaseView    中文描述
---@field public go_table DrawUpPackView_GoTable GoTable
---@field model_data activity_cash_gift.i_cash_gift[]
local RechargeDBackDjqView = _G.BaseClass("RechargeDBackDjqView", _G.UIBaseView)

function RechargeDBackDjqView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    ---可购买文本显示时的次数
    self.limitTimesCond = _G.ConfigManager.discrete_cfg[106208][1][1]

    self.go_table.scrollloopvectical_ItemList:InitItemData(0, _G.handler(self, self.OnRefreshLoopListItem))
end

---界面的入口函数
function RechargeDBackDjqView:OnCreate(data)
    self.data = data
    --LogError(self.data)
    --LogError(self.data.typeClass.infocfg)
    --LogError(self.data.typeClass.times_buy)
    self:UpdateView(data)

    self.time = self.data.typeClass:GetEndTime() - _G.TimeUtil.GetServerUnixTime()
    self.go_table.aortext_time.text = _G.GetLangPackValue(90000000988) .. _G.TimeUtil.TransLateSMCH(self.time) --剩余时间
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)          --用于更新剩余时间
    self.timer:Start()

    UIUtils.LoadEffectByCfg(ConfigManager.ui_effect_cfg.ef_sc_daijinquan,self.go_table.obj_effNode,function(obj)
        if self:IsNil() then
            _G.UIUtils.RemoveEffect(obj)
        end
    end)
end

---更新时间
function RechargeDBackDjqView:UpdateTime(elapsed)
    if not self.go_table or self.time <= 0 then
        self:StopTimer()
        if self.time <= 0 then
            self:Close()
        end
        return
    end
    self.time = self.time - elapsed
    local time = _G.TimeUtil.TransLateSMCH(_G.Mathf.RoundToInt(self.time))
    self.go_table.aortext_time.text = _G.GetLangPackValue(90000000988) .. time
end

---停止计时器
function RechargeDBackDjqView:StopTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

function RechargeDBackDjqView:OnRefreshLoopListItem(i, item)
    if i < 0 then
        return
    end

    local index = i + 1

    local info = self.data.typeClass.infocfg[index]
    local tb = _G.GetAutoGoTable(item, _G.handlerbind(self, self.OnClickAwardBtn, index))

    local final = _G.GameUtil.SetPriceByChannel(info.price)
    tb.aortext_Num.text = final

    if info.count > 0 then
        tb.obj_limit:SetActiveE(1)
        local limittimes = info.count - self.data.typeClass:GetItemBuyTimes(info.sid)
        if limittimes < 1 then
            limittimes = 0
        end
        --LogError(limittimes)
        tb.aortext_limit.text = _G.GetLangPackValue(90050000003, limittimes)
        if limittimes > 0 then
            tb.obj_giveaway:SetActiveE(1)
            tb.obj_limit:SetActiveE(1)
            tb.aorbtn_gotopay:SetActiveE(0)
            tb.aorbtn_pay:SetActiveE(1)
        else
            tb.obj_giveaway:SetActiveE(0)
            tb.obj_limit:SetActiveE(0)
            tb.aorbtn_gotopay:SetActiveE(1)
            tb.aorbtn_pay:SetActiveE(0)
        end
    else
        tb.obj_limit:SetActiveE(0)
    end

    tb.aortext_BaiFenBi.text = info.first_award[1].type[2]

    tb.aortext_ItemName.text = info.name
    tb.aorimage_icon.SpriteName = info.icon
end

function RechargeDBackDjqView:OnClickAwardBtn(obj, isOn, index)
    local name = obj:GetName()
    if name == "@_aorbtn_pay" then
        local info = self.data.typeClass.infocfg[index]

        if info.count > 0 then
            local limittimes = info.count - self.data.typeClass:GetItemBuyTimes(info.sid)

            if limittimes > 0 then
                self.data.typeClass:Pay(info, function()
                    self.go_table.scrollloopvectical_ItemList:UpdateCount(#self.data.typeClass.infocfg)
                end)
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(310117)
            end
        else
            self.data.typeClass:Pay(info, function()
                self.go_table.scrollloopvectical_ItemList:UpdateCount(#self.data.typeClass.infocfg)
            end)
        end
    elseif name == "@_aorbtn_gotopay" then
        _G.JumpManager:GetInstance():Jump(213001)
    end
end

function RechargeDBackDjqView:UpdateView(data)
    self.go_table.scrollloopvectical_ItemList:UpdateCount(#self.data.typeClass.infocfg)
end

---按钮点击事件在这里派发
function RechargeDBackDjqView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_close" or name == "@_aorbtn_CloseView" or name == "@_aorbtn_sure" then
        self:Close()
    end
end

function RechargeDBackDjqView:OnDestroy()
    self:StopTimer()
end

return RechargeDBackDjqView
