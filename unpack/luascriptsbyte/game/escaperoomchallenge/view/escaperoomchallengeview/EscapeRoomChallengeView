local EscapeRoomChallengeView = _G.BaseClass("EscapeRoomChallengeView", _G.UIBaseView)

function EscapeRoomChallengeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function EscapeRoomChallengeView:OnCreate(activity)
    ---@type EscapeRoomChallengeSynModel
    self.activity = activity
    -- _G.UIUtils.LoadEffectByCfg(
    --     _G.ConfigManager.ui_effect_cfg.ef_zhokasaoguang_effect,
    --     self.go_table.obj_eff,
    --     function(trans)
    --         if self:IsNil() then
    --             _G.DestroyObject(trans)
    --         end
    --     end
    -- )
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_tuiguandatiaozhan,
        self.go_table.obj_titleEffect,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
        end
    )
    self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(
        activity:GetRedpointIDByIndex(2)
    )

    self.AwardTbs = {}
    self.AwardItems = {}
    self:InitView()
    self:UpdateView()

    _G.Events:GetInstance():AddListener(_G.eEscapeRoomChallenge.UpdateView, self.UpdateView, self)
end

function EscapeRoomChallengeView:InitView()
    self.awardCfg = self.activity:GetAwardList()
    self.elapsedTime = self.activity.curActivityClass.cfg.time.start_time +
        self.activity.curActivityClass.cfg.time.run_time - _G.TimeUtil.GetServerUnixTime()
    self:UpdateTime(0)

    if nil == self.timer then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.timer:Start()
    end
    self.go_table.aortext_des.text = _G.GetLangPackValue(33100000305)
    -- local iconCfg = self.activity.curActivityClass.cfg.info.front.precast
    -- if iconCfg then
    --     local parts = self:split(iconCfg, "*")
    --     self.go_table.aorrawimage_person:LoadImage(parts[1])
    --     local position = { tonumber(parts[2]), tonumber(parts[3]), tonumber(parts[4]) }
    --     self.go_table.aorrawimage_person:SetLocalPosition(position[1], position[2], position[3])
    -- end
    local index = 0
    for k, v in pairs(self.awardCfg) do
        index = index + 1
        local award = v.base_award[1].type
        local item = self.go_table["obj_item" .. index]
        local tb = _G.GetAutoGoTable(item, _G.handlerbind(self, self.OnClickAward, v.sid))
        tb.index = index
        self.AwardTbs[index] = tb
        tb.aortext_dayText.text = _G.GetLangPackValue(90023800006, index)
        local isGet = self.activity:CheckIsGet(v.sid)
        local canGet = self.activity:CheckCanGet(v.sid)
        local sid = award[1] == 0 and award[4] or award[1]
        local count = award[1] == 0 and award[5] or award[2]
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            { sid, count },
            tb.obj_dayPos,
            function(trans)
                if self:IsNil() then
                    return
                end
                trans:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                trans:SetGou(isGet)
                trans:ShowEffect(not isGet)
                self.AwardItems[tb.index] = trans
            end
        )
        if k==7 then
            _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_zhongjidajiang,
            tb.obj_effect
            )
        end
        tb.obj_effNode:SetLocalScale(1.4, 1.4, 1)
        tb.obj_effNode:RemoveAllChildren()
        if canGet then
            UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_daojukuang_cheng, tb.obj_effNode, function(obj)
                if self.go_table == nil then
                    DestroyObject(obj)
                end
            end)
        end
        if isGet then
            tb.obj_isget:SetActiveE(1)
            tb.obj_effNode:SetActiveE(0)
        else
            tb.obj_isget:SetActiveE(0)
        end
    end

    if self.activity.data.free_award_cfg and self.activity.data.free_award_cfg[1] then
        self.freeReward = self.activity.data.free_award_cfg[1]
        self.isGetFreeReward = self.activity.data.free_award
        local award = self.freeReward.type
        local sid = award[1] == 0 and award[4] or award[1]
        self.freeRewardCount = award[1] == 0 and award[5] or award[2]
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemCommonBase,
            self.go_table.obj_itemNode,
            function(itemLua)
                if _G.IsNil(self.go_table == nil) then
                    _G.ItemFactory:GetInstance():SetItemCard(itemLua)
                    return
                end
                if itemLua then
                    ---@type ItemCommonBase
                    self.freeItem = itemLua
                    itemLua:ShowData(sid)
                    itemLua:SetIconScale(0.8)
                    self.freeItem.go_table.aorrawimage_Icon:SetGray(self.isGetFreeReward)
                end
            end
        )
    end
end

