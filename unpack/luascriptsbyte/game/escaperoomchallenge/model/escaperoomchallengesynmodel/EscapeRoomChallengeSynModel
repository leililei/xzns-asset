local base = require("ActivitySynTypeBase")

---@class EscapeRoomChallengeSynModel : ActivitySynTypeBase	中文描述
local EscapeRoomChallengeSynModel = _G.BaseClass("EscapeRoomChallengeSynModel", base)

---类的构造函数
function EscapeRoomChallengeSynModel:__init()
    _G.Events:GetInstance():AddListener(_G.eEscapeRoomChallenge.AfkPass, self.AfkPassUpdate, self)
end

function EscapeRoomChallengeSynModel:OnHandleGMData(data)
    self:SetSelfInfo(data.afk_award)
    base.ParseData(self)
end

function EscapeRoomChallengeSynModel:SetSelfInfo(data)
    self.award_cfg = data.award_cfg or {}
    self.award_list = data.award_list or {}
    self.free_award_cfg = data.free_award_cfg
    self.free_award = data.free_award
    self.target_cfg = data.target_cfg
    self.afk_num = data.afk_num
    self.award_num = data.award_num
    ---@type activity_afk_award.i_activity_afk_award
    self.data = data
    _G.SortList(self.award_cfg, function(item)
        return -item.sid
    end)
    _G.Events:GetInstance():Broadcast(_G.eEscapeRoomChallenge.UpdateView)
    require "RedPointManager":GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
    require "RedPointManager":GetInstance():RefreshNode(self:GetRedpointIDByIndex(2))
end

function EscapeRoomChallengeSynModel:AfkPassUpdate()
    local notcan = self.afk_num < self.target_cfg

    self.afk_num = self.afk_num + 1
    if self.afk_num >= self.target_cfg then
        if notcan then
            self.award_num = self.award_num + 1
            require "RedPointManager":GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
        else
            ---已达标
        end
    end
end

---进入活动主体
function EscapeRoomChallengeSynModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.EscapeRoomChallengeView.Name, self)
end

function EscapeRoomChallengeSynModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.EscapeRoomChallengeView.Name
end

function EscapeRoomChallengeSynModel:IsShowBtn()
    return true
end

---初始化红点树
function EscapeRoomChallengeSynModel:InitRedPointTree()
    self.checkRedPointFunc = { self.CheckRedPoint , self.CheckRedPointWeekFreeGift}
    self.redpointTree = { false, false }
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function EscapeRoomChallengeSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---检查红点
function EscapeRoomChallengeSynModel:CheckRedPoint()
    if self:CheckRedPointWeekFreeGift() == 1 then
        return 1
    end
    if self:GetIsCanGetReward() == 1 then
        return 1
    end
    return 0
end

--可领取红点
function EscapeRoomChallengeSynModel:GetIsCanGetReward()
    for i = 1, #self.award_cfg do
        if not self:CheckIsGet(self.award_cfg[i].sid) and i <= self.award_num then
            return 1
        end
    end
    return 0
end

--免费礼包
function EscapeRoomChallengeSynModel:CheckRedPointWeekFreeGift()
    if self.data.free_award == true or (self.data.free_award_cfg == nil or self.data.free_award_cfg[1] == nil) then
        return 0
    end
    return 1
end

--region 外部接口

function EscapeRoomChallengeSynModel:GetAwardList()
    return self.award_cfg
end

--- 检测是否已经领取
function EscapeRoomChallengeSynModel:CheckIsGet(id)
    return _G.table.ContainsValue(self.award_list, id)
end

---检测是否能够领取
function EscapeRoomChallengeSynModel:CheckCanGet(index)
    if self:CheckIsGet(index) then
        return false
    end
    return self.award_num >= index
end

function EscapeRoomChallengeSynModel:GetAward(callback)
    self:GetActivityAward(
        { 1 },
        function(msg)
            for i = 1, #self.award_cfg do
                if not self:CheckIsGet(self.award_cfg[i].sid) and i <= self.award_num then
                    _G.table.insert(self.award_list, self.award_cfg[i].sid)
                end
            end
            require "RedPointManager":GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
            if callback then
                callback(msg)
            end
        end
    )
end

function EscapeRoomChallengeSynModel:GetFreeReward(callback)
    if self.data.free_award == true then
        return
    end
    self:GetActivityAward(
        { 2 },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self.data.free_award = true
            require "RedPointManager":GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
            require "RedPointManager":GetInstance():RefreshNode(self:GetRedpointIDByIndex(2))
            if callback then
                callback(msg)
            end
        end
    )
end

--endregion

---类的析构函数
function EscapeRoomChallengeSynModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eEscapeRoomChallenge.AfkPass, self.AfkPassUpdate, self)
end

return EscapeRoomChallengeSynModel
