function PopUpGiftBagView:InitAward(id)
    self:ShowAward(id)
end

---显示礼包内容
---@param id number 传入礼包id
function PopUpGiftBagView:ShowAward(id)
    local awards = _G.ConfigManager.store_extra_cfg[id].goods

    self.PopInfo = self.CurPosInfo[self.CurChoosePage]

    local is_buy = self.PopInfo.buy_list[1].is_buy
    self.AllTrans = {}

    if _G.AppSetting.DEBUG then
        _G.Log(id, "显示礼包内容id>>>>>>>>>>")
    end

    for i = 1, #awards do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            awards[i],
            self.go_table.obj_Content,
            function(tran)
                tran:ShowName(false)
                tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                local got = _G.GetAutoGoTable(tran.gameObject)
                got.aortext_Number.color = _G.Color.New(255 / 255, 255 / 255, 255 / 255, 1)
                --镇魂街ZHJ-24440 【0629】【主任务】涉及程序单号ZHJ-24524
                --【客户端】弹出礼包道具特效优化
                -- if i == 2 then
                --     tran:ShowEffectOrder(not is_buy)
                -- end
                --镇魂街ZHJ-31230 【主任务】beta_0.2.0_jttw贪玩三测ZHJ-33249
                --【客户端】弹出礼包-特效添加
                local grade, type = _G.StorageManager:GetInstance():GetItemGrade(awards[i][1])
                if grade > 4 then
                    tran:ShowEffectOrder(not is_buy)
                end
                table.insert(self.AllTrans, tran)
            end
        )
    end
end

---选择页签时刷新奖励
function PopUpGiftBagView:ClearAward()
    for i = 1, #self.AllTrans do
        self.AllTrans[i]:RemoveOredrEffect()
    end

    --清空
    for i = 1, self.go_table.obj_Content:GetChildCountE() do
        _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_Content:GetChildE(0), _G.ePoolType.UIItem)
    end
end

---充值回调
function PopUpGiftBagView:OnCashListener(data)
    ---更新数据然后判断剩余礼包长度
    PopUpGiftBagModel:GetInstance():OnCashListener(data)
    local popLen = #PopUpGiftBagModel:GetInstance().CurPop

    ---如果没有礼包就把界面关掉，反之则刷新界面
    if popLen < 1 then
        self:Close()
    else
        local sid = data.sid
        local id = self.PopInfo.buy_list[1].sid
        if sid == id then
            self.go_table.aorbtn_buy:SetGray(true)
            self.go_table.aortext_buy.text = _G.GetLangPackValue(90022500421)
            self.go_table.aortext_buy.color = _G.ColorTools.FormatColorByString(colorType[2])
            for i = 1, #self.AllTrans do
                self.AllTrans[i]:RemoveOredrEffect()
            end
        end

        for i = 1, #self.CurPosInfo do
            local info = self.CurPosInfo[i]
            if info.buy_list[1].sid == sid then
                info.buy_list[1].is_buy = true
                break
            end
        end
    end
end

function PopUpGiftBagView:UpdatePage(isLeft)
    if isLeft then
        self.CurChoosePage = self.CurChoosePage - 1
        if self.CurChoosePage < 1 then
            self.CurChoosePage = #self.CurPosInfo
        end
    else
        self.CurChoosePage = self.CurChoosePage + 1
        if self.CurChoosePage > #self.CurPosInfo then
            self.CurChoosePage = 1
        end
    end

    --self:UpBtnState()
    self:UpdateCurViewByPage()
end

function PopUpGiftBagView:OnStartClose()
    PopUpGiftBagModel:GetInstance():SignLastTime()
end

