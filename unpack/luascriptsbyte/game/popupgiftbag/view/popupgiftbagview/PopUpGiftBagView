function PopUpGiftBagView:UpdateCurViewByPage()
    self.PopInfo = self.CurPosInfo[self.CurChoosePage]
    if nil == self.PopInfo then
        _G.PopWindowManager:GetInstance():ShowAllTips(690103)
        return
    end

    self:ClearAward()

    -- --刷新时间
    local times = self.PopInfo.end_time - _G.TimeUtil.GetServerUnixTime()
    --刷新放置奖励展示
    if _G.AppSetting.IsXzns then
        self.go_table.aortext_timedown1.text = _G.GetLangPackValue(90028900002,_G.TimeUtil.TimeToString(times, 1))
    else
        self.go_table.aortext_timedown1.text = _G.TimeUtil.TimeToString(times, 1)
    end
    self:UpdateStateDisplay()

    self:UpdateQp()

    if _G.CS.Launcher.Inst.IsSDK then
        local json = _G.Table2Json(
            {
                role_uid = _G.PlayerModel:GetInstance().role_uid,
                role_level = _G.PlayerModel:GetInstance():GetLevel(),
                role_vip = _G.PlayerModel:GetInstance().vipLv,
                server_id = tostring(_G.ServerManager:GetInstance().CurServer.ServerID),
                channel_id = _G.ServerManager:GetInstance().AppInfo.Platform,
                phone_device = tostring(_G.ServerManager:GetInstance().AppInfo.DeviceID),
                user_type = 1,
                record_time = _G.TimeUtil.GetServerUnixTime(),
                gift_id = self.PopInfo.buy_list[1].sid
            }
        )
        if _G.AppSetting.DEBUG then
            _G.Log(json, "弹出礼包左右切换数数打点")
        end
        _G.SDKManager:GetInstance():DoShushuData_track("enter_pushgift_interface", json)
    end
end

function PopUpGiftBagView:UpdateStateDisplay()
    if self.CurChooseInfo then
        self.CurChooseInfo.obj_diandi:SetActiveE(1)
        self.CurChooseInfo.obj_dianl:SetActiveE(0)
    end

    --标签高亮刷新
    self.CurChooseInfo = self.ItemList[self.CurChoosePage]

    self.CurChooseInfo.obj_diandi:SetActiveE(0)
    self.CurChooseInfo.obj_dianl:SetActiveE(1)

    local cfg = _G.ConfigManager.store_extra_cfg[self.PopInfo.buy_list[1].sid]
    local a, b = math.modf(cfg.discount / 100)
    self.go_table.aortext_cost.text = (a)
    self:InitAward(self.PopInfo.buy_list[1].sid)

    self.go_table.aortext_lbName.text = _G.GetLangPackValue(cfg.name)

    local is_buy = self.PopInfo.buy_list[1].is_buy

    if is_buy then
        self.go_table.aorbtn_buy:SetGray(true)
        self.go_table.aortext_buy.text = _G.GetLangPackValue(90022500421)
        self.go_table.aortext_buy.color = _G.ColorTools.FormatColorByString(colorType[2])
    else
        self.go_table.aorbtn_buy:SetGray(false)
        if _G.GameUtil.IsNotPlatformSpecial() then
            self.go_table.aortext_buy.color = _G.ColorTools.FormatColorByString(colorType[1])
        end
        _G.GameUtil.SetPriceByChannel(cfg.price_id, self.go_table.aortext_buy)
    end
end

--按钮点击事件派发
function PopUpGiftBagView:OnClickBtn(go, isOn)
    local name = go:GetName()

    if name == "@_aorbtn_left" then
        self:UpdatePage(true)
    elseif name == "@_aorbtn_right" then
        self:UpdatePage(false)
    elseif name == "@_aorbtn_buy" then
        --点击购买按钮通过现金购买获得奖励
        local id = self.PopInfo.buy_list[1].sid
        if self.PopInfo.buy_list[1].is_buy == false then
            ---@type store_extra_cfg
            local cfg = _G.ConfigManager.store_extra_cfg[id]
            require("MallManager"):GetInstance():BuyActiveGift(cfg.price_id, nil, cfg.id)
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(690101)
        end
    elseif name == "@_aorbtn_closeView" or name == "@_aorbtn_Close" then
        self:Close()
    end
end

return PopUpGiftBagView
