local PopUpGiftBagView = _G.BaseClass("PopUpGiftBagView", _G.UIBaseView)

local colorType = {
    "8C2D14",
    "474747"
}

function PopUpGiftBagView:Awake()
    PopUpGiftBagModel = require "PopUpGiftBagModel"
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.Giftbattle.id)

    --_G.Events:GetInstance():AddListener(_G.AnimationEvents.AEPopup, self.ViewAnimationFinish, self)
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnCashListener, self)

    PopUpGiftBagModel:GetInstance():SignLastTime()
    _G.GameUtil.AddDouYinIcon(self.go_table.aorbtn_buy, true)
    if _G.AppSetting.IsXzns then
        colorType[1] = "50341d"
    end
end

