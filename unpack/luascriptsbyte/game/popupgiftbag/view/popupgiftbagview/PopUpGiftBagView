---更新界面
function PopUpGiftBagView:UpdateView()
    local id = self.PopInfo.sid
    local isBuy = PopUpGiftBagModel:GetInstance():GetIsBuyBySid(id)
    if isBuy then
        self.PopInfo.buy_list[1].is_buy = true
        self.go_table.aorbtn_buy:SetGray(true)
        self.go_table.aortext_buy.text = _G.GetLangPackValue(90022500421)
        self.go_table.aortext_buy.color = _G.ColorTools.FormatColorByString(colorType[2])
        for i = 1, #self.AllTrans do
            self.AllTrans[i]:RemoveOredrEffect()
        end
    end
end

---特效生成
function PopUpGiftBagView:CreatEffect()
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_jiantou_L, self.go_table.aorbtn_left)
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_jiantou_R, self.go_table.aorbtn_right)
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_Bg, self.go_table.aorrawimage_Spine)
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_title, self.go_table.trans_effectTitle)
end

---界面入口
function PopUpGiftBagView:OnCreate()
    self.go_table.obj_allcontent:SetActiveE(0)
    if #PopUpGiftBagModel:GetInstance().CurPop > 0 then
        if PopUpGiftBagModel:GetInstance():IsHaveNeedDo() then
            _G.Events:GetInstance():AddListener(_G.ePopGiftEvent.PopUpByView, self.GetMsg, self)
            PopUpGiftBagModel:GetInstance():StartPopup()
        else
            self:GetMsg(true)
        end
    else
        _G.Events:GetInstance():AddListener(_G.ePopGiftEvent.PopUpByView, self.GetMsg, self)
        PopUpGiftBagModel:GetInstance():StartPopup()
    end
    self.go_table.aortext_CloseText:DOFade(0.2, 1):SetLoops(-1, _G.CS.DG.Tweening.LoopType.Yoyo)
end

---打开界面触发弹出，并且回调
function PopUpGiftBagView:GetMsg(isGetData)
    if isGetData then
        self.CurChoosePage = 1
        self.CurChooseInfo = nil

        PopUpGiftBagModel:GetInstance().IsOpen = true

        self.CurPosInfo = _G.DeepCopy(PopUpGiftBagModel:GetInstance().CurPop)

        _G.SortList(
            self.CurPosInfo,
            function(a)
                return -a.sid
            end
        )

        for i = 1, #self.CurPosInfo do
            if not PopUpGiftBagModel:GetInstance():IsLook(self.CurPosInfo[i].sid) then
                self.CurChoosePage = i
            end
        end

        for i = 1, #self.CurPosInfo do
            PopUpGiftBagModel:GetInstance():SetIsLook(self.CurPosInfo[i].sid)
        end

        self:InitView()
        ---ZHJH-1693【弹出礼包】有弹出礼包的报错，error提示“加载了不存在的资源路径” 屏蔽特效
        --self:CreatEffect()
    else
        self:Close()
    end
end

function PopUpGiftBagView:Stop_CloseTimer()
    if self.Timers ~= nil then
        self.Timers:Stop()
        self.Timers = nil
    end
end

---类的析构函数
function PopUpGiftBagView:OnDestroy()
    PopUpGiftBagModel = nil
    _G.Events:GetInstance():RemoveListener(_G.ePopGiftEvent.PopUpByView, self.GetMsg, self)
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnCashListener, self)
    self:Stop_CloseTimer()
end

---初始化界面
function PopUpGiftBagView:InitView()
    self.go_table.obj_allcontent:SetActiveE(1)
    self.PopInfo = self.CurPosInfo[self.CurChoosePage]

    self.ItemList = {}

    self.SpineList = {}

    for _ = 1, #self.CurPosInfo do
        local itemTemp = _G.InstantiateObject(self.go_table.obj_dianpage, self.go_table.obj_dlContent)
        local item = _G.GetAutoGoTable(itemTemp)
        table.insert(self.ItemList, item)
    end

    self:TimeCutDown()
    --self:UpBtnState()
    self:UpdateStateDisplay()
    self:UpdateQp()

    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_left, #self.CurPosInfo > 1)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_right, #self.CurPosInfo > 1)

    --_G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg[self.PopCfg.store_spine], self.go_table.obj_spine)

    -- self.go_table.aorrawimage_Spine:LoadImage(
    --     self.PopCfg.store_icon,
    --     function(tran)
    --         tran:SetNativeSize()
    --         tran:SetLocalPosition(_G.SafeUnpack(self.PopCfg.pos))
    --         tran:SetLocalScaleXYZ(self.PopCfg.scale)
    --     end
    -- )

    if _G.CS.Launcher.Inst.IsSDK then
        local json = _G.Table2Json(
            {
                role_uid = _G.PlayerModel:GetInstance().role_uid,
                role_level = _G.PlayerModel:GetInstance():GetLevel(),
                role_vip = _G.PlayerModel:GetInstance().vipLv,
                server_id = tostring(_G.ServerManager:GetInstance().CurServer.Sid),
                channel_id = _G.ServerManager:GetInstance().AppInfo.Platform,
                phone_device = tostring(_G.ServerManager:GetInstance().AppInfo.DeviceID),
                user_type = 1,
                record_time = _G.TimeUtil.GetServerUnixTime(),
                gift_id = self.PopInfo.buy_list[1].sid
            }
        )
        if _G.AppSetting.DEBUG then
            _G.Log(json, "弹出礼包数数打点")
        end
        _G.SDKManager:GetInstance():DoShushuData_track("enter_pushgift_interface", json)
    end
end

function PopUpGiftBagView:SpineLoaded(obj, spine)
    _G.GameUtil.SetActiveByCondition(obj, spine == self.PopCfg.store_icon)
    self.SpineList[self.PopCfg.store_icon] = obj
end

function PopUpGiftBagView:UpdateQp()
    ---@type store_pop_cfg
    self.PopCfg = _G.ConfigManager.store_pop_cfg[self.PopInfo.sid]

    for key, value in pairs(self.SpineList) do
        value:SetActiveE(0)
    end

    if _G.AppSetting.IsXzns then
        self.go_table.aorrawimage_role:LoadImage(self.PopCfg.store_icon,function(tran)
            if self:IsNil() then
                return
            end
            tran:SetLocalPosition(_G.table.unpack(self.PopCfg.pos))
            tran:SetLocalScaleXYZ(self.PopCfg.scale)
            tran:SetNativeSize()
        end)
    else
        local spine = self.SpineList[self.PopCfg.store_icon]
        if spine then
            if spine ~= true then
                spine:SetActiveE(1)
            end
        else
            self.SpineList[self.PopCfg.store_icon] = true
            -- _G.UIUtils.RemoveChildren(self.go_table.obj_spine)
            local path = self.PopCfg.store_icon
            _G.PoolsManager:GetInstance():Spawn(
                path,
                _G.ePoolType.Temporary,
                self.go_table.obj_spine,
                function(trans)
                    if self:IsNil() then
                        _G.DestroyObject(trans)
                    end
                    trans:SetLocalPosition(self.PopCfg.pos[1], self.PopCfg.pos[2], self.PopCfg.pos[3])
                    trans:SetLocalScaleXYZ(self.PopCfg.scale)
                    self:SpineLoaded(trans, path)
                end
            )
        end
    end

    local str = _G.ConfigManager.language_package_cfg[self.PopCfg.store_doc]
    local num = _G.GameUtil.GetStringCharNum(str)
    if num <= 0 then
        self.go_table.aortext_qipao.text = str
    else
        local qpStr
        if self.PopCfg.conditions[1][1] == _G.PopUpConditionType.Afk then
            local curSection = self.PopCfg.conditions[1][2]
            local cfgSec = _G.ConfigManager.afk_cfg[curSection]
            qpStr = string.format("%s-%s", cfgSec.chapter, cfgSec.section)
        elseif
            self.PopCfg.conditions[1][1] == _G.PopUpConditionType.Tower or
            self.PopCfg.conditions[1][1] == _G.PopUpConditionType.ElementTower
        then
            local curC = self.PopCfg.conditions[1][2]
            local cfg = _G.ConfigManager.tower_cfg[curC]
            qpStr = cfg.layer
        elseif self.PopCfg.conditions[1][1] == _G.PopUpConditionType.StarCompass then
            local curC = self.PopCfg.conditions[1][2]
            local cfg = _G.ConfigManager.prof_tree_level_cfg[curC]
            qpStr = cfg.level
        else
            qpStr = self.PopCfg.conditions[1][2]
        end

        self.go_table.aortext_qipao.text = _G.string.format(str, qpStr)
    end
end

---限时礼包倒计时初始化
function PopUpGiftBagView:TimeCutDown()
    if self.PopInfo ~= nil then
        local times = self.PopInfo.end_time - _G.TimeUtil.GetServerUnixTime()
        if _G.AppSetting.IsXzns then
            self.go_table.aortext_timedown1.text = _G.GetLangPackValue(90028900002,_G.TimeUtil.TimeToString(times, 1))
        else
            self.go_table.aortext_timedown1.text = _G.TimeUtil.TimeToString(times, 1)
        end
        self:Stop_CloseTimer()
        self.Timers = _G.TimerManager:GetInstance():GetTimer(
            1,
            self.ShowTime,
            --self.ShowTime,
            self,
            false,
            false,
            true
        -- self.go_table.aortext_timedown1
        )
        self.Timers:Start()
    end
end

---刷新倒计时
function PopUpGiftBagView:ShowTime(_, text)
    local time = self.PopInfo.end_time - _G.TimeUtil.GetServerUnixTime()
    if _G.AppSetting.IsXzns then
        self.go_table.aortext_timedown1.text = _G.GetLangPackValue(90028900002,_G.TimeUtil.TimeToString(time, 1))
    else
        self.go_table.aortext_timedown1.text = _G.TimeUtil.TimeToString(time, 1)
    end
    if time <= 0 then
        self:Stop_CloseTimer()
        self:Close()
    end
end

