end

---检测当前死魂塔层数是否符合弹出礼包条件
---@param Did number 当前死魂塔层数ID
---@param layer number 当前快速挑战跳过层数
function PopUpGiftBagModel:IsArriveDeadTower(did, layer)
    local ids = {}
    if nil ~= layer then
        local len = did + layer - 1
        for i = did + 1, len do
            table.insert(ids, i)
        end
    else
        table.insert(ids, did)
    end

    for id, v in pairs(_G.ConfigManager.store_pop_cfg) do
        local sid = v.conditions[1][2]
        local type = v.conditions[1][1]
        if type == _G.PopUpConditionType.Tower then
            if false ~= _G.table.indexof(ids, sid) then
                self:CheckChapterAndAddId(v, id)
            end
        end
    end
end

