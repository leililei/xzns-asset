---检测礼包状态
function PopUpGiftBagModel:CheckIsShow()
    local show = false
    for _, v in pairs(self.CurPop) do
        local times = v.end_time - _G.TimeUtil.GetServerUnixTime()
        if times > 0 then
            if v.buy_list[1].is_buy == false then
                show = true
            end
        end
    end
    return show
end

---触发礼包
---@param id number 弹出礼包id
function PopUpGiftBagModel:GetReward(id, callback)
    ---@type store_pop.c2s_store_pop
    local msg = {}
    msg.sid = id
    PopUpGiftBagNet:GetInstance():GetAward(
        msg,
        function(msg)
            if callback then
                callback(msg)
            end
        end
    )
end

---检测红点
function PopUpGiftBagModel:CheckRedPoint()
    if self:CheckIsShow() then
        return not self.IsOpen
    end

    return false
end

