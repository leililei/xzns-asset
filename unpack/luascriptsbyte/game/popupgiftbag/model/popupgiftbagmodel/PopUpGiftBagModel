---更新当前可弹数据
function PopUpGiftBagModel:UpdateData(isInit)
    self.CurPop = {}
    if nil == self.msg.bag_list then
        return
    end
    local time = 0
    local id = 0
    for i = 1, #self.msg.bag_list do
        local info = self.msg.bag_list[i]
        local times = info.end_time
        local is_buy = info.buy_list[1].is_buy
        if (times - _G.TimeUtil.GetServerUnixTime()) > 0 then
            if not is_buy then
                if time <= 0 or time > times then
                    time = times
                    id = info.sid
                end
                table.insert(self.CurPop, info)
            end
        end
    end
    self.MinEndTimes = time
    self.CurId = id
    self.IsOkTime = (time - _G.TimeUtil.GetServerUnixTime()) > 0

    if _G.AppSetting.DEBUG then
        _G.Log(self.CurPop, "弹出礼包当前数据")
    end
    self:TimeCutDown()
    if not isInit then
        _G.FunctionManager:GetInstance():OpenFunById(_G.MainFunctionItems.PopGift)
    end
end

---弹出礼包主界面倒计时初始化
---@param text 主界面时间文本
function PopUpGiftBagModel:TimeCutDown()
    local cfg = _G.ConfigManager.function_open_cfg[76]
    local Open = _G.GlobalConditionManager.CheckConditionByArray(cfg.condition_type)
    if Open and PopUpGiftBagModel:GetInstance():CheckIsShow() then
        if self.PopUpGiftTimers == nil then
            self.PopUpGiftTimers =
                _G.TimerManager:GetInstance():GetTimer(1, self.ShowPopUpTime, self, false, false, true)
            self.PopUpGiftTimers:Start()
        end
    else
        _G.DelayFrameDo(
            function()
                _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.PopGift)
            end
        )
    end
end

---刷新倒计时
function PopUpGiftBagModel:ShowPopUpTime()
    if self.IsOkTime then
        local times = self.MinEndTimes - _G.TimeUtil.GetServerUnixTime()
        self.TimeFormat = times
        if times <= 0 then
            --更新礼包时间为0后刷新列表
            self:UpdateData()
            --如果是最后一个到期的礼包就结束计时
            if #self.CurPop <= 0 then
                if self.PopUpGiftTimers then
                    self.PopUpGiftTimers:Stop()
                    self.PopUpGiftTimers = nil
                end
                _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.PopGift)
            end
        --else
        --    _G.Events:GetInstance():Broadcast(_G.ePopGiftEvent.ShowMainPopTime)
        end
    end
end

---检测即将弹出的礼包中是否存在同组唯一
function PopUpGiftBagModel:CheckNeedDoHasIsOnly(id)
    ---@type store_pop_cfg
    local cfg = _G.ConfigManager.store_pop_cfg[id]
    if cfg.isonly then
        for i = 1, #self.NeedDo do
            ---@type store_pop_cfg
            local ncfg = _G.ConfigManager.store_pop_cfg[self.NeedDo[i]]
            if ncfg and ncfg.type_conditions == cfg.type_conditions then
                return true
            end
        end
    end
    return false
end

---添加一个id
function PopUpGiftBagModel:AddTodoID(id)
    local isAdd = false
    if not self.IsGetData then
        return false
    end
    if self.msg.open_sids then
        if
            false == _G.table.indexof(self.NeedDo, id) and false == self:CheckOpenSids(id) and
                false == self:CheckNeedDoHasIsOnly(id)
         then
            table.insert(self.NeedDo, id)
            isAdd = true
        end
    else
        if false == _G.table.indexof(self.NeedDo, id) and false == self:CheckNeedDoHasIsOnly(id) then
            table.insert(self.NeedDo, id)
            isAdd = true
        end
    end
    return isAdd
end

---获得当前已开礼包的时间
function PopUpGiftBagModel:GetOpenSids(id)
    ---@type store_pop_cfg
    local cfg = _G.ConfigManager.store_pop_cfg[id]
    if cfg.isonly then
        if self.msg.open_sids then
            for i = 1, #self.msg.open_sids do
                local info = self.msg.open_sids[i]
                ---@type store_pop_cfg
                local ocfg = _G.ConfigManager.store_pop_cfg[info.sid]
                if ocfg and (ocfg.id == id or ocfg.type_conditions == cfg.type_conditions) then
                    return info.start_time
                end
            end
        end
    else
        if self.msg.open_sids then
            for i = 1, #self.msg.open_sids do
                local info = self.msg.open_sids[i]
                if info.sid == id then
                    return info.start_time
                end
            end
        end
    end
    return 0
end

---检测礼包id是否循环
function PopUpGiftBagModel:CheckDeleteOpenSids(id)
    if self.msg.open_sids then
        for i = 1, #self.msg.open_sids do
            local info = self.msg.open_sids[i]
            if info.sid == id then
                table.remove(self.msg.open_sids, i)
                break
            end
        end
    end
end

---检测礼包id是否触发过
function PopUpGiftBagModel:CheckOpenSids(id)
    ---@type store_pop_cfg
    local cfg = _G.ConfigManager.store_pop_cfg[id]
    if cfg.isonly then
        if self.msg.open_sids then
            for i = 1, #self.msg.open_sids do
                local info = self.msg.open_sids[i]
                ---@type store_pop_cfg
                local ocfg = _G.ConfigManager.store_pop_cfg[info.sid]
                if ocfg and (ocfg.id == id or ocfg.type_conditions == cfg.type_conditions) then
                    return true
                end
            end
        end
    else
        if self.msg.open_sids then
            for i = 1, #self.msg.open_sids do
                local info = self.msg.open_sids[i]
                if info.sid == id then
                    return true
                end
            end
        end
    end
    return false
end

