---检测当前玩家等级是否符合弹出礼包条件
---@param levelbefor number 玩家等级
---@param level number 玩家等级
function PopUpGiftBagModel:IsPlayerLevel(levelbefor, level)
    local isNew = false
    for id, v in pairs(_G.ConfigManager.store_pop_cfg) do
        local clevel = v.conditions[1][2]
        local type = v.conditions[1][1]
        if levelbefor < clevel and clevel <= level and type == _G.PopUpConditionType.PlayerLevel then
            isNew = self:CheckChapterAndAddId(v, id)
        end
    end

    if isNew then
        self:MainViewEnable()
    end
end

---检测每日卡片招募达到星级
---@param levelbefor number 玩家等级
---@param level number 玩家等级
function PopUpGiftBagModel:IsRecruitCard(item)
    local conditions = _G.ConfigManager.discrete_cfg[104508]
    for i = 1, #conditions do
        local ttype = conditions[i][1]
        local id = conditions[i][2]

        if not _G.GlobalConditionManager.CheckCondition(ttype, id) then
            if _G.AppSetting.DEBUG then
                _G.Log(id, "检测每日卡片招募达到星级时条件不满足，类型是>>>>" .. ttype .. "条件参数是>>>>")
            end
            return
        end
    end

    local isNew = false
    for i = 1, #item do
        local info = item[i].type
        ---@type card_cfg
        local cfg = _G.ConfigManager.card_cfg[info[1]]
        for id, v in pairs(_G.ConfigManager.store_pop_cfg) do
            local order = v.conditions[1][2]
            local type = v.conditions[1][1]
            if order == cfg.Order and type == _G.PopUpConditionType.RecruitCard then
                isNew = self:CheckChapterAndAddId(v, id)
            end
        end
    end

    if isNew then
        self:MainViewEnable()
    end
end

