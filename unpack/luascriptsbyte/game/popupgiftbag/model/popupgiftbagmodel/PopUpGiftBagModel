---判断是否已经触发过了
function PopUpGiftBagModel:IsInOpen(sid)
    if nil == self.msg.open_sids then
        --没有东西
        return false
    else
        if false == self:CheckOpenSids(sid) then
            return false
        else
            return true
        end
    end
end

---检测条件
function PopUpGiftBagModel:CheckCfgCondition()
    local afkId = require "AfkModel":GetInstance().LastSid
    local towerId = require "DeadsoulTowerModel":GetInstance().LandFloor
    local stoneLevel = 0 ---命令大厅
    local playerLevel = _G.PlayerModel:GetInstance():GetLevel()
    local loginDay = _G.PlayerModel:GetInstance():DayCount()
    local meanCash = (require("MallManager"):GetInstance():GetCashRmb() or 0) / loginDay

    if _G.AppSetting.DEBUG then
        _G.Log(afkId, "当前放置id")
    end

    if _G.AppSetting.DEBUG then
        _G.Log(towerId, "当前死魂塔层数ID")
    end

    if _G.AppSetting.DEBUG then
        _G.Log(stoneLevel, "当前共鸣等级")
    end

    if _G.AppSetting.DEBUG then
        _G.Log(playerLevel, "当前玩家等级")
    end
    for id, v in pairs(_G.ConfigManager.store_pop_cfg) do
        local sid = v.conditions[1][2]
        local type = v.conditions[1][1]
        local canCheck = false
        local isOpen = self:IsInOpen(id)

        if not isOpen then
            if type == _G.PopUpConditionType.Afk and afkId >= sid then
                canCheck = true
            elseif type == _G.PopUpConditionType.Tower and towerId >= sid then
                canCheck = true
            elseif type == _G.PopUpConditionType.StoneLevel and stoneLevel >= sid then
                canCheck = true
            elseif type == _G.PopUpConditionType.PlayerLevel and playerLevel >= sid then
                canCheck = true
            elseif type == _G.PopUpConditionType.ActiveCash  then
                -- 策划要求alpha屏蔽
                -- if sid == 1 and meanCash >= _G.ConfigManager.discrete_cfg[104507][1][1] then
                --     canCheck = true
                -- elseif sid == 0 and meanCash <= _G.ConfigManager.discrete_cfg[104507][1][1] then
                --     canCheck = true
                -- end
            end
        end
        if canCheck then
            local chapterOK = true
            for i = 1, #v.afk_chapter do
                local info = v.afk_chapter[i]
                if not _G.GlobalConditionManager.CheckCondition(info[1], info[2]) then
                    chapterOK = false
                    break
                end
            end
            if chapterOK then
                if v.cycle_time > 0 then
                    self:CheckCycleTime(v)
                    self:AddTodoID(id)
                else
                    self:AddTodoID(id)
                end
            end
        end
    end

    if _G.AppSetting.DEBUG then
        _G.Log(self.NeedDo, "检测数据")
    end
end

