---@class PopUpGiftBagModel : GameDataModelBase
---@field GetInstance fun():PopUpGiftBagModel
local PopUpGiftBagModel = _G.BaseClass("PopUpGiftBagModel", _G.GameDataModelBase)
---@return PopUpGiftBagModel PopUpGiftBagModel

local PopUpGiftBagNet = require "PopUpGiftBagNet"
function PopUpGiftBagModel:__init()
    self.IsOkTime = false
    self.IsOpen = false
    self.CurPop = {}
    self.NeedDo = {}
    self.PopList = {}
    self.msg = {}
    self.MinEndTimes = 0
    self.TimeFormat = 0
    self.IsGetData = false
    self.LastOpenTime = nil
    _G.Events:GetInstance():AddListener(_G.MianViewState.MainViewEnable, self.MainViewEnable, self)
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnCashListener, self)
    self.Looked = {}
end

---是否符合重新打开的条件
function PopUpGiftBagModel:IsAccordWithOpenAginCD()
    if self.LastOpenTime == nil then
        return false
    end
    local cd = _G.ConfigManager.discrete_cfg[104510][1][1]
    if _G.TimeUtil.GetServerUnixTime() - self.LastOpenTime > cd then
        return true
    end
    return false
end

---设置一个上次打开的时间
function PopUpGiftBagModel:SignLastTime()
    self.LastOpenTime = _G.TimeUtil.GetServerUnixTime()
end

function PopUpGiftBagModel:SetIsLook(id)
    if false == _G.table.indexof(self.Looked, id) then
        table.insert(self.Looked, id)
    end
end

function PopUpGiftBagModel:IsLook(id)
    if false == _G.table.indexof(self.Looked, id) then
        return false
    end
    return true
end

function PopUpGiftBagModel:MainViewEnable()
    if _G.PlayerModel:GetInstance():CheckCreateRole() then
        self:CheckShowNeedDo()
    end
end

function PopUpGiftBagModel:GetIsBuyBySid(sid)
    local isBuy
    if self.msg and self.msg.bag_list then
        for i = 1, #self.msg.bag_list do
            local info = self.msg.bag_list[i]
            if sid == info.sid then
                isBuy = info.buy_list[1].is_buy
                break
            end
        end
    end
    return isBuy
end

function PopUpGiftBagModel:OnCashListener(data)
    local sid = 0
    if self.msg and self.msg.bag_list then
        for i = 1, #self.msg.bag_list do
            local info = self.msg.bag_list[i]
            local infotemp = _G.ConfigManager.store_pop_cfg[info.sid]
            local has = false
            for k = 1, #infotemp.store_extra do
                if infotemp.store_extra[k][1] == data.sid then
                    has = true
                    break
                end
            end
            if has then
                sid = info.sid
                break
            end
        end
    end
    if sid > 0 then
        self:ChangeData(sid)
        self:UpdateData()
    end
end

---检测可以执行的礼包
function PopUpGiftBagModel:CheckShowNeedDo()
    if _G.AppSetting.IsArraigned then
        ---提审状态下不弹礼包
        return
    end
    if #self.NeedDo > 0 then
        local isPop = true

        for i = 1, #self.NeedDo do
            if nil == self.PopList[self.NeedDo[i]] then
                isPop = false
                break
            end
        end

        if false == isPop then
            local MainOpenViewFunItem = {}
            MainOpenViewFunItem.OpenViewFun = _G.handler(self, self.OpenBagView)
            _G.MainManager:GetInstance():AddMainFunQueue(MainOpenViewFunItem, _G.MainViewShowOrder.PopUpGiftBag)
        end

        for i = 1, #self.NeedDo do
            self.PopList[self.NeedDo[i]] = true
        end
    else
        if self:IsAccordWithOpenAginCD() then
            if #self.CurPop <= 0 then
                if _G.AppSetting.DEBUG then
                    _G.Log("弹出礼包重弹检测没有礼包了")
                end
                return
            end
            if not (_G.MainManager:GetInstance().isInMainView and _G.MainManager:GetInstance():IsMain()) then
                if _G.AppSetting.DEBUG then
                    _G.Log("弹出礼包重弹检测不在主界面")
                end
                return
            end
            local MainOpenViewFunItem = {}
            MainOpenViewFunItem.OpenViewFun = _G.handler(self, self.OpenBagView)
            _G.MainManager:GetInstance():AddMainFunQueue(MainOpenViewFunItem, _G.MainViewShowOrder.PopUpGiftBag)
        end
    end
end

function PopUpGiftBagModel:OpenBagView()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.PopUpGiftBagView.Name)
end

---检测是否有需要触发的id
function PopUpGiftBagModel:IsHaveNeedDo()
    return #self.NeedDo > 0
end

---开始Pop（界面打开开始，目的是界面打开才开始计时）
function PopUpGiftBagModel:StartPopup()
    if #self.NeedDo > 0 then
        self.NeedDoIndex = 0
        for i = 1, #self.NeedDo do
            self:GetReward(self.NeedDo[i], _G.handler(self, self.NeedDoCallBack))
        end
    else
        _G.Events:GetInstance():Broadcast(_G.ePopGiftEvent.PopUpByView, false)
    end
end

---回调协议
function PopUpGiftBagModel:NeedDoCallBack(msgSign)
    if msgSign.ack == 1 then
        if nil == self.msg.bag_list then
            self.msg.bag_list = {}
        end

        if nil == self.msg.open_sids then
            self.msg.open_sids = {}
        end

        table.insert(self.msg.bag_list, msgSign.bag)

        local info = {}
        info.start_time = _G.TimeUtil.GetServerUnixTime()
        info.sid = msgSign.bag.sid

        table.insert(self.msg.open_sids, info)

        table.removebyvalue(self.UnlockList, msgSign.bag.sid)

        self.NeedDoIndex = self.NeedDoIndex + 1
        if self.NeedDoIndex >= #self.NeedDo then
            ---所有弹出礼包触发完成
            self:UpdateData()

            _G.Events:GetInstance():Broadcast(_G.ePopGiftEvent.PopUpByView, true)
            self.NeedDo = {}
        end
    else
        _G.Events:GetInstance():Broadcast(_G.ePopGiftEvent.PopUpByView, false)
    end
end

---@return PopUpGiftBagModel PopUpGiftBagModel
function PopUpGiftBagModel:GetInstance()
    return self.super.GetInstance(self)
end

function PopUpGiftBagModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.MianViewState.MainViewEnable, self.MainViewEnable, self)
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnCashListener, self)
    if self.Timers then
        self.Timers:Stop()
        self.Timers = nil
    end
end

function PopUpGiftBagModel:GetDataFormServer()
    PopUpGiftBagNet:GetInstance():GetPopAwardInfos(_G.handler(self, self.ParseData))
end

function PopUpGiftBagModel:ParseData(msg)
    self.msg = msg
    self.IsGetData = true
    self.UnlockList = self.msg.unlock_sids or {}
    for i = 1, #self.UnlockList do
        local ncfg = _G.ConfigManager.store_pop_cfg[self.UnlockList[i]]
        if ncfg then
            table.insert(self.NeedDo, self.UnlockList[i])
        end
    end
    self.msg.unlock_sids = {}
    self.UnlockList = {}
    self.super.ParseData(self)
    self:UpdateData(true)
    self:CheckCfgCondition()
    self:CheckShowNeedDo()
end

function PopUpGiftBagModel:InitFunction()
    _G.FunctionManager:GetInstance():OpenFunById(_G.MainFunctionItems.PopGift)
end

