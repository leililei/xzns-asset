---检查条件并添加id
function PopUpGiftBagModel:CheckChapterAndAddId(v, id)
    local chapterOK = true
    for i = 1, #v.afk_chapter do
        local info = v.afk_chapter[i]
        if not _G.GlobalConditionManager.CheckCondition(info[1], info[2]) then
            chapterOK = false
            break
        end
    end
    if chapterOK then
        local isAdd
        if v.cycle_time > 0 then
            self:CheckCycleTime(v)
            isAdd = self:AddTodoID(id)
        else
            isAdd = self:AddTodoID(id)
        end
        if isAdd then
            local msg = {}
            msg.sid = id
            PopUpGiftBagNet:GetInstance():SetUnlockAward(msg)
            return true
        end
    end
    return false
end

---检测循环
function PopUpGiftBagModel:CheckCycleTime(cfg)
    if cfg.cycle_time > 0 then
        ---类型唯一
        if cfg.isonly then
            ---判断时间是否满足循环
            if (_G.TimeUtil.GetServerUnixTime() - self:GetOpenSids(cfg.id)) > cfg.cycle_time then
                for did, dv in pairs(_G.ConfigManager.store_pop_cfg) do
                    if dv.type_conditions == cfg.type_conditions then
                        self:CheckDeleteOpenSids(did)
                    end
                end
            end
        else
            ---判断时间是否满足循环
            if (_G.TimeUtil.GetServerUnixTime() - self:GetOpenSids(cfg.id)) > cfg.cycle_time then
                self:CheckDeleteOpenSids(cfg.id)
            end
        end
    end
end

