function PopUpGiftBagModel:ParseDataRe(msg, endcall)
    if endcall then
        endcall()
    end
    self.msg = msg
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.PopUpGiftBagView.Name)
    if window then
        window.View:UpdateView()
    end
end

