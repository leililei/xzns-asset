function PopUpGiftBagModel.IsShowMainFunction()
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(76) and PopUpGiftBagModel:GetInstance():CheckIsShow() then
        --("_____________________________________界面打开")
        return true
    else
        --("_____________________________________界面关闭")
        return false
    end
