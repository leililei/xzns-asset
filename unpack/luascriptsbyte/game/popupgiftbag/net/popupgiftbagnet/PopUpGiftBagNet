---@class PopUpGiftBagNet : BaseGameNet
---@field GetInstance fun():PopUpGiftBagNet
local PopUpGiftBagNet = _G.BaseClass("PopUpGiftBagNet", require "BaseGameNet")
local base = require "BaseGameNet"
---@return PopUpGiftBagNet PopUpGiftBagNet

function PopUpGiftBagNet:GetInstance()
    return base.GetInstance(self)
end

---请求 弹出礼包奖励信息
---@param pbData table PB数据
---@param callback function 完成回调
---@field s2c_game_store_pop_info 返回的信息数组
function PopUpGiftBagNet:GetPopAwardInfos(callback)
    local item = _G.ConfigManager.net_map.game_store_pop_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.SuccessCall))
    self.Call[port] = callback
end

---触发礼包
---@param pbData table PB数据
---@param callback function 完成回调
---@field s2c_game_store_pop 返回的信息数组
function PopUpGiftBagNet:GetAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_store_pop
    local port = base.Access(self, item, pbData, _G.handler(self, self.SuccessCall))
    self.Call[port] = callback
end

---标记待触发礼包
---@param pbData table PB数据
---@param callback function 完成回调
---@field s2c_game_store_pop 返回的信息数组
function PopUpGiftBagNet:SetUnlockAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_store_unlock
    local port = base.Access(self, item, pbData, _G.handler(self, self.SuccessCall))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function PopUpGiftBagNet:SuccessCall(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return PopUpGiftBagNet
