local base = require "BaseGameNet"

---@class DayTotalTopUpNet : BaseGameNet	通信协议
local DayTotalTopUpNet = _G.BaseClass("DayTotalTopUpNet", base)

---@return DayTotalTopUpNet DayTotalTopUpNet
function DayTotalTopUpNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---领取累充奖励
---@param pbData activity_treasure_house.c2s_award PB数据
---@param callback function 完成回调
function DayTotalTopUpNet:GetCashAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_treasure_house_port_award
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function DayTotalTopUpNet:Callback(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type DayTotalTopUpNet
_G.DayTotalTopUpNet = DayTotalTopUpNet
return DayTotalTopUpNet
