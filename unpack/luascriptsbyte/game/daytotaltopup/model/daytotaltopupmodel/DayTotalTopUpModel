local ActivitySynManager = require "ActivitySynManager"
local base = require "ActivitySynTypeBase"
---@class DayTotalTopUpModel : ActivitySynTypeBase 塔罗牌
local DayTotalTopUpModel = _G.BaseClass("DayTotalTopUpModel", base)

function DayTotalTopUpModel:__init(activity)
    self.curActivityClass:AddStateChanged(_G.handler(self, self.OnActivityStateChanged), self)
    base.__init(self, activity)

    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

function DayTotalTopUpModel:OnMallCashListener(data)
    if data.cash_rmb and data.cash_rmb > 0 then
        if self.Info then
            if nil == self.Info.cash_info then
                self.Info.cash_info = {}
            end

            local isPayed = false
            for i = 1, #self.Info.cash_info do
                if self.Info.cash_info[i].day == self.Info.cash_sid then
                    isPayed = true
                    break
                end
            end
            if not isPayed then
                local datac = {}
                datac.cash = data.cash_rmb
                datac.day = self.Info.cash_sid
                table.insert(self.Info.cash_info, datac)
            else
                for i = 1, #self.Info.cash_info do
                    if self.Info.cash_info[i].day == self.Info.cash_sid then
                        self.Info.cash_info[i].cash = self.Info.cash_info[i].cash + data.cash_rmb
                    end
                end
            end

            self:RefreshRedPoint()
        end
    end
end

function DayTotalTopUpModel:ReConnect()
    self:GetInfo(
        function()
            self:RefreshRedPoint()
        end
    )
end

function DayTotalTopUpModel:GetGetCon(cashnum)
    if self.Info then
        if nil == self.Info.cash_info then
            return false
        end

        for i = 1, #self.Info.cash_info do
            if self.Info.cash_info[i].day == self.Info.cash_sid then
                if nil ~= self.Info.cash_info[i].get_con then
                    local index = table.indexof(self.Info.cash_info[i].get_con, cashnum)
                    if index ~= false then
                        return true
                    end
                end
                break
            end
        end

        return false
    end
end

function DayTotalTopUpModel:AddGetCon(cashnum)
    if self.Info then
        if nil == self.Info.cash_info then
            self.Info.cash_info = {}
        end

        local payIndex = 0
        for i = 1, #self.Info.cash_info do
            if self.Info.cash_info[i].day == self.Info.cash_sid then
                payIndex = i
                break
            end
        end
        if payIndex > 0 then
            if nil == self.Info.cash_info[payIndex].get_con then
                self.Info.cash_info[payIndex].get_con = {}
            end

            table.insert(self.Info.cash_info[payIndex].get_con, cashnum)
        end
    end
end

---进入活动主体
function DayTotalTopUpModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DayTotalTopUpView.Name, self.Info.main_type)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function DayTotalTopUpModel:OnActivityStateChanged(_, state)
    if state == ActivitySynManager.State.Close then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DayTotalTopUpView.Name)
        if view then
            view:Close()
        end
        --活动已关闭
        _G.PopWindowManager:GetInstance():ShowAllTips(930101)
    end
end

function DayTotalTopUpModel:GetInfo(call)
    self.CallBack = call
    require("ActivitySynNet"):GetInstance():InitActivity(
        self.curActivityClass:GetActivityID(),
        _G.handler(self, self.UpdateInitData)
    )
end
function DayTotalTopUpModel:UpdateInitData(msg)
    if msg.ack == 1 then
        self:OnHandleGMData(msg.activity[1].self_info)
    end
end

---获取GM数据
---@param info activity.i_activity_self_info
function DayTotalTopUpModel:OnHandleGMData(info)
    self:ParseData(info)
end

---解析数据
function DayTotalTopUpModel:ParseData(info)
    self:SetSelfData(info)
    base.ParseData(self)
end

---初始化数据
---@param info activity.i_activity_self_info
function DayTotalTopUpModel:SetSelfData(info)
    self.Info = info.day_total_cash
    if _G.AppSetting.DEBUG then
        _G.Log(self.Info, "每日累充数据")
    end
    require "DayTotalTopUpManager":GetInstance():SetData(self)

    self.SyTime = self:GetTime()
    if self.SyTime > 0 then
        if nil == self.SyTime then
            self.SyTimer = _G.TimerManager:GetInstance():GetTimer(1, self.GoSyTime, self, false, false, true)
            self.SyTimer:Start()
        end
    end

    self:RefreshRedPoint()

    if self.CallBack then
        self.CallBack()
        self.CallBack = nil
    end
end

function DayTotalTopUpModel:GoSyTime(elapsed)
    self.SyTime = self.SyTime - elapsed
    if self.SyTime <= 0 then
        self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
        self.SyTimer:Stop()
        self.SyTimer = nil
    end
end

---剩余时间计算
function DayTotalTopUpModel:GetTime()
    local timeShengYu = 0
    if self.curActivityClass and self.curActivityClass.cfg then
        timeShengYu =
            self.curActivityClass.cfg.time.start_time + self.curActivityClass.cfg.time.run_time -
            _G.TimeUtil.GetServerUnixTime()
    end
    return timeShengYu
end

---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function DayTotalTopUpModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end

---检测活动条件（没开到大奖并且有券）
function DayTotalTopUpModel:CheckRedPoint()
    if self.Info then
        self.CurDay = self.Info.cash_sid
        self.CurPay = 0
        if self.Info.cash_info then
            for i = 1, #self.Info.cash_info do
                if self.Info.cash_info[i].day == self.Info.cash_sid then
                    self.CurPay = self.Info.cash_info[i].cash
                    break
                end
            end
        end
        local dayInfo = self.Info.item[self.Info.cash_sid]

        self.OneCashNum = dayInfo.ca[1].cash_num
        self.TwoCashNum = dayInfo.ca[2].cash_num
        local isgou30 = self:GetGetCon(self.OneCashNum)
        local isgou68 = self:GetGetCon(self.TwoCashNum)
        if self.OneCashNum > 0 then
            local isCanGet =
                (self.CurPay >= self.OneCashNum and not isgou30) or (self.CurPay >= self.TwoCashNum and not isgou68)
            if isCanGet then
                return 1
            end
        else
            local isCanGet = (self.CurPay >= self.TwoCashNum and not isgou68)
            if isCanGet then
                return 1
            end
        end
    end
    return 0
end

---刷新奖励红点
function DayTotalTopUpModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end
---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function DayTotalTopUpModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

function DayTotalTopUpModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    if self.curActivityClass then
        self.curActivityClass:RemoveStateChanged(_G.handler(self, self.OnActivityStateChanged), self)
    end
    if self.SyTimer then
        self.SyTimer:Stop()
        self.SyTimer = nil
    end
    base.Dispose(self)
end

