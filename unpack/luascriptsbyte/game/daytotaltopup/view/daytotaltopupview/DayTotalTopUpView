local DayTotalTopUpManager = require "DayTotalTopUpManager"

---@class DayTotalTopUpView : UIBaseView	中文描述
---@field public go_table DayTotalTopUpView_GoTable GoTable
---@field activity ActivitySynGMActivity 活动信息
---@field activityCls PenglaiTreasureHouseModel 活动数据
local DayTotalTopUpView = _G.BaseClass("DayTotalTopUpView", _G.UIBaseView)

function DayTotalTopUpView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param activity ActivitySynGMActivity 活动信息
function DayTotalTopUpView:OnCreate(main_type)
    self.PlThClass = DayTotalTopUpManager:GetInstance():GetData(main_type)

    self:UpdateView()
end

---更新界面
function DayTotalTopUpView:UpdateView()
    self.EndTime = self.PlThClass:GetTime()

    local front = self.PlThClass.curActivityClass.cfg.info.front
    if _G.AppSetting.DEBUG then
        _G.Log(front)
    end

    local show = front.gift_group_show
    if show then
        for _, img in pairs(show.images) do
            if img.index == 1 then
                self.go_table.aorrawimage_title:LoadImage(
                    img.path,
                    function(trans)
                        if self:IsNil() then
                            _G.DestroyObject(trans)
                            return
                        end
                        self.go_table.aorrawimage_title:SetNativeSize()
                        self.go_table.aorrawimage_title:SetLocalScaleXYZ(img.size / 10000)
                        local pos = _G.string.split(img.xyz, "#")
                        self.go_table.aorrawimage_title:SetLocalPosition(
                            _G.tonumber(pos[1]),
                            _G.tonumber(pos[2]),
                            _G.tonumber(pos[3])
                        )
                    end
                )
            elseif img.index == 2 then
                self.go_table.aorrawimage_icon:LoadImage(
                    img.path,
                    function(trans)
                        if self:IsNil() then
                            _G.DestroyObject(trans)
                            return
                        end
                        trans:SetNativeSize()
                        trans:SetLocalScaleXYZ(img.size / 10000)
                        local pos = _G.string.split(img.xyz, "#")
                        trans:SetLocalPosition(_G.tonumber(pos[1]), _G.tonumber(pos[2]), _G.tonumber(pos[3]))
                    end
                )
            end
        end
    end

    --取活动结束时间
    if nil == self.timer then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.timer:Start()
    end
    self:UpdateTime(0)
    self.CurDay = self.PlThClass.Info.cash_sid
    self.CurPay = 0
    self:CheckCurCashByDay()

    local dayInfo = self.PlThClass.Info.item[self.CurDay]
    self.g30 = dayInfo.ca[1].award or {}
    self.g68 = dayInfo.ca[2].award or {}

    self.OneCashNum = dayInfo.ca[1].cash_num
    self.TwoCashNum = dayInfo.ca[2].cash_num

    _G.GameUtil.SetActiveByCondition(self.go_table.obj_onepress, self.OneCashNum > 0)

    self:UpdateQiPao()
    local oneFinalPrice = require "MallManager":GetInstance():GetFinalPrice(self.OneCashNum)
    local tweFinalPrice = require "MallManager":GetInstance():GetFinalPrice(self.TwoCashNum)

    self.go_table.aortext_onecash.text =
        "<color=#784f33>累充</color><size=30>" ..
        "<color=#c2733e>" .. math.floor(oneFinalPrice / 100) .. "</color></size><color=#784f33>元可领取</color>"
    self.go_table.aortext_twocash.text =
        "<color=#784f33>累充</color><size=30>" ..
        "<color=#c2733e>" .. math.floor(tweFinalPrice / 100) .. "</color></size><color=#784f33>元可领取</color>"

    if self.OneCashNum > 0 then
        if self.CurPay <= self.OneCashNum then
            self:SetTaskItemjd(self.go_table.aorimage_jd, self.CurPay, self.OneCashNum)
        else
            self:SetTaskItemjdred(
                self.go_table.aorimage_jd,
                self.CurPay - self.OneCashNum,
                self.TwoCashNum - self.OneCashNum
            )
        end
    else
        self:SetTaskItemjdOnlyTwo(self.go_table.aorimage_jd, self.CurPay, self.TwoCashNum)
    end
    self:UpdateGoods()
end

function DayTotalTopUpView:CheckCurCashByDay()
    if self.PlThClass.Info.cash_info then
        for i = 1, #self.PlThClass.Info.cash_info do
            if self.PlThClass.Info.cash_info[i].day == self.CurDay then
                self.CurPay = self.PlThClass.Info.cash_info[i].cash
                break
            end
        end
    end
end

function DayTotalTopUpView:UpdateQiPao()
    if self.CurPay >= self.TwoCashNum then
        --self.go_table.aorimage_qipao:SetActiveE(1)
        local isgou30 = self.PlThClass:GetGetCon(self.OneCashNum)
        if self.OneCashNum <= 0 then
            isgou30 = true
        end
        local isgou68 = self.PlThClass:GetGetCon(self.TwoCashNum)
        if isgou30 and isgou68 then
            self.go_table.aortext_needcash.text = _G.GetLangPackValue(90020800068)
        else
            self.go_table.aortext_needcash.text = _G.GetLangPackValue(90020800067)
        end
    else
        --self.go_table.aorimage_qipao:SetActiveE(1)
        self.NeedNum =
            self.CurPay >= self.OneCashNum and self.TwoCashNum or self.OneCashNum
        self.go_table.aortext_needcash.text = _G.GetLangPackValue(90020800066, math.floor(self.CurPay / 100),
            math.floor(self.NeedNum / 100))
    end
end

function DayTotalTopUpView:UpdateGoods()
    local isgou30 = self.PlThClass:GetGetCon(self.OneCashNum)
    local isgou68 = self.PlThClass:GetGetCon(self.TwoCashNum)

    if self.OneCashNum <= 0 then
        isgou30 = true
    end


    local grid1 = self.go_table.obj_good30:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.GridLayoutGroup))
    local grid2 = self.go_table.obj_good68:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.GridLayoutGroup))

    local scale1 = 0.65
    local scale2 = 0.65
    self.go_table.aorrawimage_good30Center:LoadImage(_G.StorageManager:GetInstance():GetStorageItemData(self.g30[1].type
        [1]).Icon)
    self.go_table.aorrawimage_good68Center:LoadImage(_G.StorageManager:GetInstance():GetStorageItemData(self.g68[1].type
        [1]).Icon)
    if #self.g30 <= 2 then
        grid1.constraintCount = 1
        grid1.spacing = _G.Vector2(15, -26)
        scale1 = 0.8
    else
        grid1.spacing = _G.Vector2(-4.28, -4.7)
    end

    if #self.g68 <= 2 then
        grid2.constraintCount = 1
        grid2.spacing = _G.Vector2(15, -26)
        scale2 = 0.8
    else
        grid2.spacing = _G.Vector2(-4.28, -4.7)
    end
    self.g30Ef = {}

  _G.UIUtils.RemoveChildren(self.go_table.obj_good30)
    _G.UIUtils.RemoveChildren(self.go_table.obj_good30Line1)
    _G.UIUtils.RemoveChildren(self.go_table.obj_good30Line2)
    for i = 1, #self.g30 do
        local parent = self.go_table.obj_good30
        if #self.g30 == 3 and i <= 2 then
            parent = self.go_table.obj_good30Line1
        elseif #self.g30 == 3 and i > 2 then
            parent = self.go_table.obj_good30Line2
        end

        _G.StorageManager:GetInstance():GetItemBaseView(
            self.g30[i].type[1],
            self.g30[i].type[2],
            parent,
            function(tran)
                tran.gameObject:SetLocalPosition(0, 0, 0)
                tran.gameObject:SetLocalScaleXYZ(scale1)
                tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                if tran.SetGou then
                    tran:SetGou(isgou30)
                end
                if not isgou30 and self.CurPay >= self.OneCashNum then
                    _G.UIUtils.LoadEffectByCfg(
                        _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
                        tran.gameObject,
                        function(tran)
                            --- 防止 异步后
                            if _G.IsNil(self.go_table.gameObject) then
                                tran:DestroyObject()
                                return
                            end
                            self.g30Ef[i] = tran
                            if tran ~= nil then
                                tran:SetLocalScaleXYZ(1)
                                tran:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                            end
                        end
                    )
                else
                    if self.g30Ef[i] then
                        self.g30Ef[i]:SetActiveE(0)
                    end
                end
                self.Trans30 = tran
            end,
            function(go)
                if isgou30 then
                    return
                end
                self:On30Click(go)
            end
        )
    end

    self.g68Ef = {}

    _G.UIUtils.RemoveChildren(self.go_table.obj_good68)
    _G.UIUtils.RemoveChildren(self.go_table.obj_good68Line1)
    _G.UIUtils.RemoveChildren(self.go_table.obj_good68Line2)
    for i = 1, #self.g68 do

           local parent = self.go_table.obj_good68
        if #self.g68 == 3 and i <= 2 then
            parent = self.go_table.obj_good68Line1
        elseif #self.g68 == 3 and i > 2 then
            parent = self.go_table.obj_good68Line2
        end

        _G.StorageManager:GetInstance():GetItemBaseView(
            self.g68[i].type[1],
            self.g68[i].type[2],
            parent,
            function(tran)
                tran.gameObject:SetLocalPosition(0, 0, 0)
                tran.gameObject:SetLocalScaleXYZ(scale2)
                tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                if tran.SetGou then
                    tran:SetGou(isgou68)
                end
                if not isgou68 and self.CurPay >= self.TwoCashNum then
                    _G.UIUtils.LoadEffectByCfg(
                        _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
                        tran.gameObject,
                        function(tran)
                            --- 防止 异步后
                            if _G.IsNil(self.go_table.gameObject) then
                                tran:DestroyObject()
                                return
                            end
                            self.g68Ef[i] = tran
                            if tran ~= nil then
                                tran:SetLocalScaleXYZ(1)
                                tran:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                            end
                        end
                    )
                else
                    if self.g68Ef[i] then
                        self.g68Ef[i]:SetActiveE(0)
                    end
                end
                self.Trans68 = tran
            end,
            function(go)
                if isgou68 then
                    return
                end
                self:On68Click(go)
            end
        )
    end
end

function DayTotalTopUpView:On30Click(go)
    if self.CurPay < self.OneCashNum then
        require "CommonTipManager":GetInstance():OpenTip(self.go_table.obj_good30, go.sid or go[1].sid)
    else
        local params = {}

        table.insert(params, self.CurDay)
        table.insert(params, self.OneCashNum)

        if #params > 0 then
            require("ActivitySynNet"):GetInstance():GetAward(
                self.PlThClass.curActivityClass:GetActivityID(),
                params,
                function(data)
                    if data.ack ~= 1 then
                        return
                    end
                    _G.StorageManager:GetInstance():ReceiveAwardData(data)
                    _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.CommonAwardView.Name,
                        data
                    )

                    if self.Trans30 then
                        -- self.Trans30:ShowEffect(false)
                    end

                    self.PlThClass:AddGetCon(self.OneCashNum)
                    self:UpdateGoods()
                    self:UpdateQiPao()
                    self.PlThClass:RefreshRedPoint()
                end
            )
        end
    end
end

function DayTotalTopUpView:On68Click(go)
    if self.CurPay < self.TwoCashNum then
        require "CommonTipManager":GetInstance():OpenTip(self.go_table.obj_good30, go.sid or go[1].sid)
    else
        local params = {}
        table.insert(params, self.CurDay)
        table.insert(params, self.TwoCashNum)
        if #params > 0 then
            require("ActivitySynNet"):GetInstance():GetAward(
                self.PlThClass.curActivityClass:GetActivityID(),
                params,
                function(data)
                    if data.ack ~= 1 then
                        return
                    end
                    _G.StorageManager:GetInstance():ReceiveAwardData(data)
                    _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.CommonAwardView.Name,
                        data
                    )
                    if self.Trans68 then
                        -- self.Trans68:ShowEffect(false)
                    end
                    self.PlThClass:AddGetCon(self.TwoCashNum)
                    self:UpdateGoods()
                    self:UpdateQiPao()
                    self.PlThClass:RefreshRedPoint()
                end
            )
        end
    end
end

---设置任务进度
function DayTotalTopUpView:SetTaskItemjdred(aorimage, value, loopValue_Max)
    local w = value / loopValue_Max
    if w > 1 then
        w = 1
    end
    aorimage:SetRectTransformSize(value > 0 and (300 + w * (300)) or 0, 19)
end

---设置任务进度
function DayTotalTopUpView:SetTaskItemjd(aorimage, value, loopValue_Max)
    local w = value / loopValue_Max
    if w > 1 then
        w = 1
    end
    aorimage:SetRectTransformSize(value > 0 and w * (300) or 0, 19)
end

---设置任务进度
function DayTotalTopUpView:SetTaskItemjdOnlyTwo(aorimage, value, loopValue_Max)
    local w = value / loopValue_Max
    if w > 1 then
        w = 1
    end
    aorimage:SetRectTransformSize(value > 0 and w * (600) or 0, 19)
end

---更新时间
function DayTotalTopUpView:UpdateTime(fix)
    if self.EndTime <= 0 then
        self.go_table.aortext_time.text = _G.LangUtil.GetLangPackValue(90026100053)
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        return
    else
        self.EndTime = self.EndTime - fix
        local time = _G.TimeUtil.TransDayHourMineMiao(self.EndTime)
        self.go_table.aortext_time.text = time
    end
end

---点击功能
function DayTotalTopUpView:OnClickItem(_, _, index)
    self.activityCls:EnterActivityWithIndex(index)
end

---按钮点击事件在这里派发
function DayTotalTopUpView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_closeView then
        self:Close()
    elseif go == self.go_table.aorbtn_pay then
        ---充值
        _G.JumpManager:GetInstance():Jump(159002)
    end
end

---购买完成
function DayTotalTopUpView:OnBuyCall()
end

function DayTotalTopUpView:OnStartClose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return DayTotalTopUpView
