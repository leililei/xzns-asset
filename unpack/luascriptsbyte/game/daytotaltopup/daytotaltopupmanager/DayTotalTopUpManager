---@class DayTotalTopUpManager : Singleton	中文描述
local DayTotalTopUpManager = _G.BaseClass("DayTotalTopUpManager", _G.Singleton)

---@return DayTotalTopUpManager DayTotalTopUpManager
function DayTotalTopUpManager:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function DayTotalTopUpManager:__init()
    self.PlThClass = {}
end

---获取GM数据
function DayTotalTopUpManager:GetData(main_type)
    if self.PlThClass and self.PlThClass[main_type] then
        if self.PlThClass[main_type]:GetTime() > 0 then
            return self.PlThClass[main_type]
        end
    end
    return nil
end

---设置GM数据
function DayTotalTopUpManager:SetData(class)
    if nil == class.Info.main_type then
        class.Info.main_type = 1
    end
    self.PlThClass[class.Info.main_type] = class
end

function DayTotalTopUpManager:Dispose()
end

return DayTotalTopUpManager
