---@class AIHelperModel : GameDataModelBase
---@field GetInstance fun():AIHelperModel
---@field tagDatas AIHelperTagData[]                        @左侧标签数据列表
---@field moduleDatas table<number, AIHelperModuleBase[]>   @右侧模块数据列表
local AIHelperModel = _G.BaseClass("AIHelperModel", _G.GameDataModelBase)

function AIHelperModel:__init()
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.OnSixClockUpdateCallback, self)
end
function AIHelperModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.OnSixClockUpdateCallback, self)
end

---六点刷新更新红点
function AIHelperModel:OnSixClockUpdateCallback()
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.AIHelper.id)
end

---获取左侧标签栏数据列表
---@return AIHelperTagData[]
function AIHelperModel:GetTagData()
    if self.tagDatas then
        return self.tagDatas
    end

    ---@type tab<number, AIHelperTagData>
    local tags = {}
    for _, cfg in pairs(_G.ConfigManager.ai_quick_cfg) do
        local tag = tags[cfg.type1]
        if not tag then
            tag = {
                type = cfg.type1,
                name = cfg.type_name,
                enable = true,
                children = {}
            }
            tags[cfg.type1] = tag
        end
        table.insert(tag.children, cfg)
    end

    self.tagDatas = _G.table.toArray(tags)
    --请期待更多新功能
    --table.insert(
    --    self.tagDatas,
    --    {
    --        type = 99999,
    --        name = 90028010115,
    --        enable = false,
    --        children = {}
    --    }
    --)
    return self.tagDatas
end

---获取右侧模块数据列表
---@param type number 标签类型
---@return AIHelperModuleBase[]
function AIHelperModel:GetModules(type)
    local modules = self.moduleDatas and self.moduleDatas[type] or nil
    if modules then
        return modules
    end

    --创建module实例列表
    modules = {}
    for _, cfg in pairs(_G.ConfigManager.ai_quick_cfg) do
        if cfg.type1 == type then
            ---@type AIHelperModuleBase
            local module
            if cfg.script and #cfg.script > 0 then
                module = require(cfg.script).New(cfg)
            else
                --仅显示基础信息, 不做任何逻辑操作
                module = require("AIHelperModuleEmpty").New(cfg)
            end
            if module then
                module:Reset()
                table.insert(modules, module)
            end
        end
    end

    --按照id从小到大排序
    table.sort(
        modules,
        function(a, b)
            return a.cfg.id < b.cfg.id
        end
    )

    --保存缓存
    if not self.moduleDatas then
        self.moduleDatas = {}
    end
    self.moduleDatas[type] = modules
    return modules
end
---重置所有模块状态
---@return void
function AIHelperModel:ResetModules()
    if not self.moduleDatas then
        return
    end
    for _, modules in pairs(self.moduleDatas) do
        for _, module in pairs(modules) do
            module:Reset()
        end
    end
end
---删除所有模块实例
---@return void
function AIHelperModel:ClearModules()
    self.moduleDatas = nil
end

