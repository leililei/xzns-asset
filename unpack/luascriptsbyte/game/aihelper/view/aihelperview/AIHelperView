local TagSelected, TagUnselected =
    _G.CS.UnityEngine.Color.white,
    _G.CS.UnityEngine.Color(0x7f / 255, 0x57 / 255, 0x4b / 255)

---@class AIHelperView : UIBaseView	    @AI助手页面
---@field go_table AIHelperView_GoTable
---@field model AIHelperModel
---@field tagIndex number                                           @当前选中tag标签的序号
---@field tagStateChanging boolean                                  @是否正在修改tag标签状态
---@field tagDatas AIHelperTagData[]                                @标签数据列表
---@field tagItems AIHelperView._obj_tagItem_GoTable[]              @标签节点列表
---@field moduleDatas AIHelperModuleBase[]                          @模块数据列表
---@field moduleItems AIHelperView._obj_listItem_GoTable[]          @模块节点列表
---@field options AIHelperOptions
local AIHelperView = _G.BaseClass("AIHelperView", _G.UIBaseView)
function AIHelperView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function AIHelperView:OnDestroy()
    self:RemoveAllListener()
end

---@param options AIHelperOptions
function AIHelperView:OnCreate(options)
    self:Init()

    self.options = type(options) == "table" and options or {}
    if self.options.mock == nil then
        self.options.mock = true
    end

    self.model = require("AIHelperModel"):GetInstance()
    self.model:ResetModules()

    self:LoadTags()
    self.tagIndex = 1
    self:LoadModuleView()

    if #self.tagDatas == 1 then
        --只有一个标签的时候, 不显示下边栏标签
        self.go_table.scrollloophorizontal_tag:UpdateCount(0)
        --隐藏当前页执行按钮
        self.go_table.aorbtn_execute:SetActiveE(0)
    else
        self.go_table.scrollloophorizontal_tag:UpdateCount(#self.tagDatas)
    end

    --以六点作为刷新时刻(更新红点状态)
    local timestamp = _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
    _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "AIHelper", timestamp)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.AIHelper.id)
end

function AIHelperView:Init()
    self.go_table.obj_tagItem:SetActiveE(0)
    self.go_table.obj_listItem:SetActiveE(0)

    self.go_table.scrollloophorizontal_tag:InitItemData(0, _G.handler(self, self.RefreshTagItem))
    self.go_table.scrollloopvectical_list:InitItemData(0, _G.handler(self, self.RefreshModuleItem))
end

---加载左侧标签
---@return void
function AIHelperView:LoadTags()
    self.tagDatas = {}
    local tags = self.model:GetTagData()
    for i = 1, #tags do
        local validate = not tags[i].enable
        local modules = self.model:GetModules(tags[i].type)
        if modules then
            for j = 1, #modules do
                if modules[j]:IsEnabled() then
                    validate = true
                    break
                end
            end
        end
        if validate then
            table.insert(self.tagDatas, tags[i])
        end
    end
end

---加载右侧功能模块
---@return void
function AIHelperView:LoadModuleView()
    self.moduleDatas = {}

    local tag = self.tagDatas[self.tagIndex]
    local modules = self.model:GetModules(tag.type)
    if modules then
        for _, m in ipairs(modules) do
            if m:IsEnabled() then
                if m.SetMock then
                    m:SetMock(self.options.mock)
                end
                table.insert(self.moduleDatas, m)
            end
        end
    end

    self.go_table.scrollloopvectical_list:UpdateCount(#self.moduleDatas)
end

---刷新左边标签栏列表
---@param index number 序号下标, C#从0开始lua从1开始
---@param obj GameObject    节点实例
function AIHelperView:RefreshTagItem(index, obj)
    if not self.tagItems then
        self.tagItems = {}
    end
    local item = self.tagItems[obj:GetInstanceIDE()]
    if not item then
        item = _G.GetAutoGoTable(obj)
        item.toggle = obj:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle))
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickTagBtn, item))
        self.tagItems[obj:GetInstanceIDE()] = item
    end

    index = index + 1
    --显示Tag数据
    local data = self.tagDatas[index]
    local isOn = index == self.tagIndex
    self.tagStateChanging = true
    item.index = index
    item.aortext_name.text = _G.GetLangPackValue(data.name)
    item.aortext_nameOn.text = _G.GetLangPackValue(data.name)
    --item.aortext_name.color = isOn and TagSelected or TagUnselected
    item.toggle.isOn = isOn
    item.toggle.enabled = data.enable
    item.aorimage_off:SetActiveE(isOn and 0 or 1)
    item.aorimage_on:SetActiveE(isOn and 1 or 0)
    item.aortext_name:SetActiveE(isOn and 0 or 1)
    item.aortext_nameOn:SetActiveE(isOn and 1 or 0)
    self.tagStateChanging = false
end

---刷新右边模块列表
---@param index number 序号下标, C#从0开始lua从1开始
---@param obj GameObject    节点实例
function AIHelperView:RefreshModuleItem(index, obj)
    if not self.moduleItems then
        self.moduleItems = {}
    end
    local item = self.moduleItems[obj:GetInstanceIDE()]
    if not item then
        item = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickModuleBtn, item))
        item.aorinputfield_number.onEndEdit:AddListener(
            _G.handlerbind(self, self.OnClickModuleInput, item.aorinputfield_number, item)
        )
        self.moduleItems[obj:GetInstanceIDE()] = item
    end

    index = index + 1
    --显示module设置
    local module = self.moduleDatas[index]
    item.module = module
    item.changing = true
    module:ShowSettings(item)
    item.changing = false
end

---开始执行模块
---@param all boolean   执行所有模块(false表示执行当前页签的模块)
---@return void
function AIHelperView:ExecuteModules(all)
    ---@type number[]
    local types = {}
    if all then
        for _, tag in ipairs(self.tagDatas) do
            table.insert(types, tag.type)
        end
    else
        local tag = self.tagDatas[self.tagIndex]
        if tag then
            table.insert(types, tag.type)
        end
    end

    ---@type AIHelperModuleBase[]
    local modules = {}
    for _, type in ipairs(types) do
        for _, m in ipairs(self.model:GetModules(type) or {}) do
            if m:IsEnabled() and m:IsExecute() then
                table.insert(modules, m)
            end
        end
    end
    --开始执行模块
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.AIHelperExecuteView.Name, modules, self.options)
    if #modules > 0 then
        --self.model:ClearModules()   --清除实例
        --延迟关闭页面
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.DelayCloseSelf)
    end
end

---延迟关闭自身面板
---@return void
function AIHelperView:DelayCloseSelf(name)
    if name ~= _G.ConfigManager.ui_cfg.AIHelperExecuteView.Name then
        return
    end
    self:RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.DelayCloseSelf)

    self:Close()
end

---处理Tag按钮事件
---@param item AIHelperView._obj_tagItem_GoTable|{index:number}
function AIHelperView:OnClickTagBtn(go, isOn, item)
    --item.aortext_name.color = isOn and TagSelected or TagUnselected
    if self.tagStateChanging or not isOn then
        return
    end
    self.tagIndex = item.index or 1
    self:LoadModuleView()

    self.go_table.scrollloophorizontal_tag:UpdateAllItem()
end

---处理module设置按钮事件
---@param item AIHelperView._obj_listItem_GoTable|{module:AIHelperModuleBase, changing: boolean }
function AIHelperView:OnClickModuleBtn(go, isOn, item)
    if not item.module or item.changing then
        return
    end
    item.module:OnSettingsBtn(item, go, isOn)
end

---处理module设置Input输入事件
---@param item AIHelperView._obj_listItem_GoTable|{module:AIHelperModuleBase, changing: boolean }
function AIHelperView:OnClickModuleInput(text, go, item)
    if not item.module or item.changing then
        return
    end
    item.module:OnSettingsInput(item, go, text)
end

---处理按钮事件
function AIHelperView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close1 then
        self:Close()
    elseif go == self.go_table.aorbtn_execute then
        self:ExecuteModules(false)
    elseif go == self.go_table.aorbtn_all then
        self:ExecuteModules(true)
    end
end

--region    -----------------------类型定义----------------------

---@class AIHelperOptions    @AI助手设置项
---@field continue boolean              @失败后继续执行模块
---@field interval number               @执行间隔, 单位秒
---@field unfreeze boolean              @解除执行限制(不检查日常任务完成状态)
---@field mock boolean                  @模拟开启/关闭选项(默认: true)

--endregion

return AIHelperView
