local base = require("AIHelperModuleBaseNumberMock")

---@class AIHelperModuleFirstTestBoss : AIHelperModuleBaseNumberMock	    @AI助手-祸乱之源
---@field index number                  @已执行次数
---@field dps number                    @今日已挑战的最高伤害值(0表示未挑战)
local AIHelperModuleFirstTestBoss = _G.BaseClass("AIHelperModuleFirstTestBoss", base)

---是否显示此模块(功能是否开启)
function AIHelperModuleFirstTestBoss:IsEnabled()
    if not base.IsEnabled(self) then
        return false
    end
    return true
end

---是否满足模块使用条件
function AIHelperModuleFirstTestBoss:IsActive()
    return self.index <= self.number
end

---重置状态
function AIHelperModuleFirstTestBoss:Reset()
    base.Reset(self)
    self.index = 1
    self.dps = 0
end

---获取状态(可能为异步请求数据)
function AIHelperModuleFirstTestBoss:Check(callback)
    self.index = 1

    --获取今日造成的dps
    local model = require("FirstTestBossModel"):GetInstance()
    self.dps = model.infoData and model.infoData.day_dps or 0

    if callback then
        callback(true)
    end
end

---获取当前执行状态
function AIHelperModuleFirstTestBoss:GetExecuteState()
    return {
        total = self.number,
        index = self.index
    }
end

---执行逻辑
function AIHelperModuleFirstTestBoss:Execute(callback)
    if self.dps > 0 then
        if callback then
            callback(false, self:CreateFailureResults(self.cfg.fail_tip))
        end
        return
    end

    ---检测是否正在战斗中
    if _G.MainManager:GetInstance():IsFighting(false) then
        if callback then
            callback(false, self:CreateFailureResults(90028010143, _G.GetLangPackValue(self.cfg.name)))
        end
        return
    end

    ---是否在结算期中
    if require("FirstTestBossModel"):GetInstance():IsSettlementTime() then
        if callback then
            callback(false, self:CreateFailureResults(90025800012))
        end
        return
    end

    self.index = self.index + 1

    ---@type FirstTestBossModel
    local model = require("FirstTestBossModel"):GetInstance()
    ---@type EmbattleModel
    local embattleModel = require("EmbattleModel"):GetInstance()

    local function response(success, results)
        if not callback then
            return
        end
        callback(success, results)
    end

    --检测布阵是否为空
    if not embattleModel:CheckBattle(_G.EmbattleType.SeasonBoss) then
        response(false, nil)
        return
    end

    --发起战斗结算
    local function fightResult(data)
        require("BattleNet"):GetInstance():NpcPVEFightResult(
            data,
            function(msg)
                if msg.md5_error == "1" then
                    _G.PopWindowManager:GetInstance():ShowAllTips(44)
                    _G.BattleManager:GetInstance():SaveLogNew()
                elseif msg.md5_error == "2" then
                    _G.BattleManager:GetInstance():SaveLogNew()
                end
                if not msg or msg.ack ~= 1 then
                    response(false, nil)
                    return
                end

                --获取奖励
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)

                --获取dps信息
                local dps = msg.atk_dps
                local lastMaxDps = model.infoData.max_dps
                if dps then
                    model:UpdateDamages(dps)
                end

                --发送事件
                _G.Events:GetInstance():Broadcast(_G.eSeasonTask.Action, {_G.SeasonTaskID.SeasonBossDamage}, dps, true)
                _G.Events:GetInstance():Broadcast(_G.eSeasonTask.Action, {_G.SeasonTaskID.SeasonBoss}, 1)

                local maxCfg, maxNextCfg = model:GetCurAndNextDamageLevelCfg()

                msg.dps = dps --本轮伤害值
                msg.lastMaxDps = lastMaxDps --历史最高伤害值
                msg.level = maxCfg and maxCfg.lv or 1 --当前等级
                msg.nextMaxDps = maxNextCfg and maxNextCfg.require or 0 --下一级需要的伤害值
                response(true, msg)
            end
        )
    end
    --发起战斗请求
    local function fightBegin()
        require("FirstTestNet"):GetInstance():FightBoss(
            function(msg)
                if not msg or msg.ack ~= 1 then
                    response(false, nil)
                    return
                end

                --计算战斗结果
                -- _G.BattleManager:GetInstance():SetArgDataAutoCmd(msg.args)
                -- local record = _G.BattleManager:GetInstance():GetStatisticsRecord(msg.args)
                -- if not record or not record.result then
                --     response(false, nil)
                --     return
                -- end
                local tab = nil
                --发起战斗结算
                fightResult(tab)
            end
        )
    end
    ---更新布阵阵容
    ---@param embattleId number 布阵id
    local function updateEmbattle(embattleId)
        embattleModel:SaveEmbattleDataNew(
            embattleId,
            function(respCode)
                if respCode ~= 0 then
                    response(false, nil)
                    return
                end
                fightBegin()
            end,
            _G.EmbattleSaveType.server,
            true,
            nil
        )
    end

    updateEmbattle(_G.EmbattleType.SeasonBoss)
end

---显示执行状态
function AIHelperModuleFirstTestBoss:ShowExecutingState(item, state, results)
    base.ShowExecutingState(self, item, state, results)
    if not self.mock then
        item.aortext_tip.text = state and (state.index .. "/" .. state.total) or ""
    end
end

---显示执行结束UI状态
---@param results public.s2c_common_ack
function AIHelperModuleFirstTestBoss:ShowExecuteResult(item, success, results)
    base.ShowExecuteResult(self, item, success, results)
    if not success or not results then
        return
    end

    item.scrollloophorizontal_award:SetActiveE(0)
    item.obj_damage:SetActiveE(1)
    --设置展示信息
    local dps, lastMaxDps, level, nextMaxDps = results.dps, results.lastMaxDps, results.level, results.nextMaxDps
    item.obj_damageNew:SetActiveE(dps > lastMaxDps and 1 or 0)
    item.aortext_damageLevel.text = _G.GetLangPackValue(90000011081, level)
    item.aortext_damage.text =
        nextMaxDps <= 0 and _G.GameUtil.NumberToUnitStrFight(dps) or
        (_G.GameUtil.NumberToUnitStrFight(dps) .. "/" .. _G.GameUtil.NumberToUnitStrFight(nextMaxDps))
    item.slider_damage.value = (nextMaxDps <= 0 or dps > nextMaxDps) and 1 or dps / nextMaxDps
end

return AIHelperModuleFirstTestBoss
