local base = require("AIHelperModuleBaseNumberMock")
local AIHelperModuleAFKQuick = require("AIHelperModuleAFKQuick")

---@class AIHelperModuleAFKQuickFree : AIHelperModuleBaseNumberMock	    @AI助手-AFK放置快速挂机(免费)
---@field count number                  @剩余免费次数
local AIHelperModuleAFKQuickFree = _G.BaseClass("AIHelperModuleAFKQuickFree", base)

---是否满足模块使用条件
function AIHelperModuleAFKQuickFree:IsActive()
    return self.index <= self.number and self.count > 0
end

---获取Number范围
function AIHelperModuleAFKQuickFree:GetCountRange()
    local count = require("AfkModel"):GetInstance():GetFreeRewardTime()
    if count > 0 then
        return 0, count
    end
    return 0, 1
end

---重置状态
function AIHelperModuleAFKQuickFree:Reset()
    base.Reset(self)
    self.index = 1
    self.count = 1
end

---获取状态(可能为异步请求数据)
function AIHelperModuleAFKQuickFree:Check(callback)
    self.index = 1
    self.count = require("AfkModel"):GetInstance():GetFreeRewardTime()
    if callback then
        callback(true)
    end
end

---执行逻辑
function AIHelperModuleAFKQuickFree:Execute(callback)
    self.index = self.index + 1
    self.count = self.count - 1

    require("AfkModel"):GetInstance():GetQuickAfkAward(
        1, --使用免费次数(也代表魂玉次数)
        function(msg)
            --刷新红点状态
            require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.AfkQuick.id)
            --刷新界面状态
            _G.MainManager:GetInstance():RefreshAfkBoxTip()

            if callback then
                callback(true, msg)
            end
        end
    )
end

---显示执行结束UI状态
---@param results public.s2c_common_ack
function AIHelperModuleAFKQuickFree:ShowExecuteResult(item, success, results)
    base.ShowExecuteResult(self, item, success, results)
    if not success then
        return
    end
    AIHelperModuleAFKQuick.SetAfkAwardExtraFlags(results, "jsxt_pic_zhongzu_wenhao")
    self.Util.ShowAwardListOfMsg(item, results)
end

---隐藏执行结束UI状态(此时可以回收一些外部节点)
function AIHelperModuleAFKQuickFree:HideExecuteResult(item, results)
    base.HideExecuteResult(self, item.resutls)
    self.Util.HideAwardListOfMsg(item, results)
end

return AIHelperModuleAFKQuickFree
