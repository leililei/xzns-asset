local base = require("AIHelperModuleBaseSelect")

---@class AIHelperModuleFriends : AIHelperModuleBaseSelect	    @AI助手-一键赠领友情点
---@field completed boolean             @是否已完成
---@field count number                  @剩余执行次数
local AIHelperModuleFriends = _G.BaseClass("AIHelperModuleFriends", base)

---是否满足模块使用条件
function AIHelperModuleFriends:IsActive()
    return self.count and self.count > 0
end

---重置状态
function AIHelperModuleFriends:Reset()
    base.Reset(self)
    self.completed = false
    self.count = 1
end
---获取状态(可能为异步请求数据)
function AIHelperModuleFriends:Check(callback)
    local a_uid, g_uid = self:GetFriendsState()

    self.completed = not a_uid and not g_uid
    if callback then
        callback(true)
    end
end
---执行逻辑
function AIHelperModuleFriends:Execute(callback)
    if self.completed or not self.count or self.count <= 0 then
        if callback then
            callback(false, self:CreateFailureResults(self.cfg.fail_tip))
        end
        return
    end

    self.completed = true
    self.count = (self.count or 0) - 1
    local a_uid, g_uid = self:GetFriendsState()
    local pbData = {a_uid = a_uid, g_uid = g_uid}
    require("FriendsNet"):GetInstance():GiveFriendshipAccess(
        pbData,
        function(msg)
            --接收奖励数据
            --_G.StorageManager:GetInstance():ReceiveAwardData(msg)
            --刷新红点状态
            --require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FriendApplication.id)

            --处理数据缓存(数据奖励丶红点)
            require("FriendManager"):GetInstance():GetFriendShip(msg, pbData)

            if callback then
                --计算是否成功
                local acceptAnyOk, sendAnyOk = false, false
                if msg.a_result then
                    for _, v in pairs(msg.a_result) do
                        if v.ack == 1 then
                            acceptAnyOk = true
                            break
                        end
                    end
                end
                if msg.g_result then
                    for _, v in pairs(msg.g_result) do
                        if v.ack == 1 then
                            sendAnyOk = true
                            break
                        end
                    end
                end
                callback(acceptAnyOk or sendAnyOk, (acceptAnyOk or sendAnyOk) and msg or nil)
            end
        end
    )
end

---显示执行结束UI状态
---@param results public.s2c_common_ack
function AIHelperModuleFriends:ShowExecuteResult(item, success, results)
    base.ShowExecuteResult(self, item, success, results)
    if not success then
        return
    end
    self.Util.ShowAwardListOfMsg(item, results)
    item.aortext_tip.text = _G.GetLangPackValue(90000011423)
end
---隐藏执行结束UI状态(此时可以回收一些外部节点)
function AIHelperModuleFriends:HideExecuteResult(item, results)
    base.HideExecuteResult(self, item.resutls)
    self.Util.HideAwardListOfMsg(item, results)
end

---获取好友赠领状态
---@return number[],number[]    待领取的角色, 待赠送的角色
function AIHelperModuleFriends:GetFriendsState()
    --检查是否存在未处理的角色
    ---@type number[]
    local a_uid, g_uid = {}, {}

    local list = require("FriendManager"):GetInstance():GetFriendList()
    for _, v in pairs(list) do
        if v.accept == 1 then
            table.insert(a_uid, v.uid)
        end
        if v.send == 0 then
            table.insert(g_uid, v.uid)
        end
    end

    if #a_uid == 0 then
        a_uid = nil
    end
    if #g_uid == 0 then
        g_uid = nil
    end
    return a_uid, g_uid
end

return AIHelperModuleFriends
