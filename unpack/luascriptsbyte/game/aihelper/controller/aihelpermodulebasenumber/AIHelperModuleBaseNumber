local base = require("AIHelperModuleBase")

---@class AIHelperModuleBaseNumber : AIHelperModuleBase
---@field number boolean                            @执行此模块的次数
local AIHelperModuleBaseNumber = _G.BaseClass("AIHelperModuleBaseNumber", base)

function AIHelperModuleBaseNumber:__init()
    self.number = self:ReadSettings(1)
    if type(self.number) ~= "number" then
        self.number = 1
    end
end

---是否执行此模块
function AIHelperModuleBaseNumber:IsExecute()
    return self.number and self.number > 0
end

---执行前的设置UI状态
function AIHelperModuleBaseNumber:ShowSettings(item)
    base.ShowSettings(self, item)
    self:SetSettingsType(item, self.Types.Number)

    self:CheckCountRange()
    self:ShowSettingsCount(item)
end
---监听设置点击事件
function AIHelperModuleBaseNumber:OnSettingsBtn(item, go, _)
    if go == item.aorbtn_add1 then
        self.number = self.number + 1
    elseif go == item.aorbtn_add10 then
        self.number = self.number + 10
    elseif go == item.aorbtn_sub1 then
        self.number = self.number - 1
    elseif go == item.aorbtn_sub10 then
        self.number = self.number - 10
    end
    self:CheckCountRange()
    self:ShowSettingsCount(item)

    self:SaveSettings(self.number)
end
---监听设置Input输入事件
function AIHelperModuleBaseNumber:OnSettingsInput(item, _, text)
    local num = tonumber(text)
    if type(num) == "number" then
        self.number = num
        self:CheckCountRange()

        self:SaveSettings(self.number)
    end

    self:ShowSettingsCount(item)
end

---获取Number范围
---@return number,number    @最小值,最大值
function AIHelperModuleBaseNumber:GetCountRange()
    return 0, 9999
end
---检查Number是否超出范围限制
---@return void
function AIHelperModuleBaseNumber:CheckCountRange()
    local min, max = self:GetCountRange()
    if self.number < min then
        self.number = min
    elseif self.number > max then
        self.number = max
    end
end
---通知number状态发生变化
---@param item AIHelperView._obj_listItem_GoTable
function AIHelperModuleBaseNumber:ShowSettingsCount(item)
    item.aorinputfield_number.text = tostring(self.number)
end

return AIHelperModuleBaseNumber
