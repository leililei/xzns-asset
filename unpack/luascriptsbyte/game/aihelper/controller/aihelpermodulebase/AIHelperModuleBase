---@class AIHelperModuleUtil
local AIHelperModuleUtil = _G.BaseClass("AIHelperModuleBase")

---显示奖励列表
---@param item AIHelperExecuteView._obj_listItem_GoTable
---@param awardDatas number[][]|{extra:string}[]
---@param force boolean                         @强制重新刷新数据
function AIHelperModuleUtil.ShowAwardList(item, awardDatas, force)
    if not awardDatas then
        return
    end
    --如果数据源相同, 是否重新加载数据源
    if awardDatas == item.awardDatas and not force then
        return
    end

    local awardItems = {}
    item.awardItems = awardItems
    item.awardDatas = awardDatas

    if not item.__initAwardList then
        item.__initAwardList = true

        item.parentItems = {}
        item.scrollloophorizontal_award:InitItemData(
            #awardDatas,
            function(index, trans)
                ---@type _obj_listItem._obj_awardItem_GoTable|{data:any,item:ItemViewBase}
                local pItem = item.parentItems[trans:GetInstanceIDE()]
                if not pItem then
                    pItem = _G.GetAutoGoTable(trans)
                    item.parentItems[trans:GetInstanceIDE()] = pItem
                end

                --获取数据
                local awardData = item.awardDatas and item.awardDatas[index + 1] --C#序号从0开始, lua序号从1开始
                --奖励增益标志
                local extra = awardData and awardData.extra
                pItem.aorimage_extra:SetActiveE(extra and 1 or 0)
                if extra and type(extra) == "string" then
                    pItem.aorimage_extra.SpriteName = extra
                    pItem.aorimage_extra:SetNativeSize()
                end
                --检查数据源是否相同, 相同则不重复创建
                if pItem.data and pItem.item then
                    if pItem.data == awardData then
                        return
                    end
                    --销毁或回收已创建的实例
                    AIHelperModuleUtil.DespawnItemBaseView(pItem.item)
                    pItem.item = nil
                end
                pItem.data = awardData
                if not awardData then
                    return
                end
                --加载奖励节点
                _G.StorageManager:GetInstance():GetItemBaseViewNew(
                    awardData,
                    pItem.obj_itemRoot,
                    function(awardItem)
                        if not awardItem or not awardItem.gameObject and awardItem.gameObject:IsNull() then
                            return
                        end

                        --检查是否有效的加载回调
                        --如果pItem.data不一致, 则表示已被之后的加载覆盖
                        --如果item.awardItems为空, 则表示节点已清空
                        --如果parent为空, 则表示界面已被销毁
                        if awardData ~= pItem.data or not item.awardItems or _G.IsNil(trans) then
                            AIHelperModuleUtil.DespawnItemBaseView(awardItem)
                            return
                        end
                        awardItem.gameObject:SetLocalScaleXYZ(1)
                        awardItem:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)

                        pItem.item = awardItem
                        table.insert(item.awardItems, awardItem)
                    end
                )
            end
        )
    else
        item.scrollloophorizontal_award:UpdateCount(#awardDatas)
    end

    AIHelperModuleUtil.ChangeScrollRectRaycastTarget(item)
end

---回收奖励列表
---@param item AIHelperExecuteView._obj_listItem_GoTable
---@param awardDatas number[][]
function AIHelperModuleUtil.HideAwardList(item, awardDatas)
    if not item.awardItems or awardDatas and item.awardDatas ~= awardDatas then
        return
    end

    local awardItems = item.awardItems
    item.awardItems = nil
    item.awardDatas = nil
    for _, awardItem in ipairs(awardItems) do
        AIHelperModuleUtil.DespawnItemBaseView(awardItem)
    end

    if item.parentItems then
        for _, pItem in pairs(item.parentItems) do
            pItem.data = nil
            pItem.item = nil
        end
    end
end

---显示奖励列表
---@param item AIHelperExecuteView._obj_listItem_GoTable
---@param msg {extraFlags:table<any,string>}|public.s2c_common_ack            @消息结构, extraFlags额外的奖励标志
function AIHelperModuleUtil.ShowAwardListOfMsg(item, msg)
    if not msg or not msg.award then
        return
    end
    local awardDatas = msg.__awardDatas
    if not awardDatas then
        awardDatas = {}

        local extraFlags = msg.extraFlags
        for k, v in pairs(msg.award.item) do
            local params = v.type
            --对装备奖励进行特殊处理, 只取sid丶number丶elements作展示
            --sid|uid|number|elements|..., 彩色装备会传更多信息
            if #params >= 4 and _G.StorageManager:GetInstance():CheckSidType(params[1]) == _G.StorageType.Equipment then
                params = { params[1], params[3], params[4] }
            end
            params.extra = extraFlags and extraFlags[k] or nil
            table.insert(awardDatas, params)
        end
        msg.__awardDatas = awardDatas
    end

    AIHelperModuleUtil.ShowAwardList(item, awardDatas)
end

---回收奖励列表
---@param item AIHelperExecuteView._obj_listItem_GoTable
---@param msg public.s2c_common_ack             @消息结构
function AIHelperModuleUtil.HideAwardListOfMsg(item, msg)
    if not msg then
        AIHelperModuleUtil.HideAwardList(item, nil)
    elseif msg.__awardDatas then
        AIHelperModuleUtil.HideAwardList(item, msg.__awardDatas)
    end
end

---回收一个(物品)奖励节点
---@private
---@param item ItemViewBase|any
---@return void
function AIHelperModuleUtil.DespawnItemBaseView(item)
    if not item or not item.gameObject or item.gameObject:IsNull() then
        return
    end
    --尝试调用实例声明的Despawn静态方法回收节点
    if item.Despawn then
        --awardItem.gameObject:SetLocalScale(1, 1, 1)
        --awardItem.Despawn(awardItem)

        --ItemViewBase.DestroyObject无法正常使用
        --应处理成回收复用节点, 但暂时没找到对应的方法, 需要新的实现?
        _G.DestroyObject(item.gameObject)
    else
        _G.DestroyObject(item.gameObject)
    end
end

---根据content宽度, 决定是否禁用ScrollLoopHorizontal的事件响应
---@private
---@param item AIHelperExecuteView._obj_listItem_GoTable
function AIHelperModuleUtil.ChangeScrollRectRaycastTarget(item)
    if not item or item.__disable then
        return
    end

    ---@type UnityEngine.UI.ScrollRect
    local scrollRect = item.__scrollRect
    if not scrollRect then
        scrollRect = item.scrollloophorizontal_award:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect))
        item.__scrollRect = scrollRect

        if not scrollRect or scrollRect:IsNull() then
            item.__disable = true
            return
        end
    end
    ---@type UnityEngine.UI.Graphic
    local scrollRectGraphic = item.__scrollRectGraphic
    if not scrollRectGraphic then
        scrollRectGraphic = scrollRect.viewport:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Graphic))
        item.__scrollRectGraphic = scrollRectGraphic

        if not scrollRectGraphic or scrollRectGraphic:IsNull() then
            item.__disable = true
            return
        end
    end

    --立即同步节点大小信息, 如果视图可以显示全部物品则禁用滑动
    _G.GameUtil.ReBuildRTF(item.scrollloophorizontal_award)

    local cWidth = scrollRect.content:GetRectTransformWidthHeight()
    local vWidth = scrollRect.viewport:GetRectTransformWidthHeight()
    scrollRectGraphic.raycastTarget = cWidth >= vWidth
end

--endregion

---@class AIHelperModuleBase 	    AI助手功能模块
---@field cfg ai_quick_cfg                      @模块对应的配置文件
---@field Types SettingTypes
---@field Util AIHelperModuleUtil
local AIHelperModuleBase = _G.BaseClass("AIHelperModuleBase")

---@param cfg ai_quick_cfg
function AIHelperModuleBase:__init(cfg)
    self.cfg = cfg
    self.Types = SettingTypes
    self.Util = AIHelperModuleUtil
end

--region  ----------------存储IO------------------

---保存状态(以__cname作为存储key)
---@generic T
---@param value T
---@return void
function AIHelperModuleBase:SaveSettings(value)
    _G.PlayerPrefsManager.SetTable(self.__cname, { value = value })
end

---读取状态(以__cname作为存储key, 默认返回nil)
---@generic T
---@param defaultValue T
---@return T
function AIHelperModuleBase:ReadSettings(defaultValue)
    local state = _G.PlayerPrefsManager.GetTable(self.__cname)
    if not state then
        return defaultValue
    end
    return state.value
end

---删除状态(以__cname作为存储key)
---@return void
function AIHelperModuleBase:DeleteSettings()
    _G.PlayerPrefsManager.DeleteKey(self.__cname)
end

--endregion

--region  ----------------数据/状态接口------------------

---是否显示此模块(功能是否开启)
---@return bool
function AIHelperModuleBase:IsEnabled()
    local functionId = self.cfg.function_id
    if functionId and functionId > 0 then
        return _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(functionId)
    end
    return true
end

---是否执行此模块(用户设置开启或次数)
---@return bool
function AIHelperModuleBase:IsExecute()
    return false
end

---是否满足模块使用条件(是否满足执行条件/次数)
---@return bool
function AIHelperModuleBase:IsActive()
    return false
end

---检测关联的日常任务是否已完成或待领取
---@param tasks table<number, ActiveTaskBase>   任务映射列表
---@return bool
function AIHelperModuleBase:IsCompletedTask(tasks)
    local taskId = self.cfg.task
    if not taskId or taskId <= 0 then
        return false
    end
    local task = tasks[taskId]
    if not task then
        return false
    end

    return task.i_task.state ~= _G.TaskEnum.ETaskState.Executing and task.i_task.state ~= _G.TaskEnum.ETaskState.Claimed
end

--endregion

--region  ----------------逻辑接口------------------

---重置状态
---@return void
function AIHelperModuleBase:Reset()
end

---获取状态(可能为异步请求数据)
---@param callback fun(ok: boolean):void 执行完成后的回调function(是否成功)
---@return void
function AIHelperModuleBase:Check(callback)
    if callback then
        callback(true)
    end
end

---获取当前执行状态
---@return any
function AIHelperModuleBase:GetExecuteState()
    return nil
end

---获取执行延迟时间(单位: 秒)
---@return number
function AIHelperModuleBase:GetExecuteDelay()
    return 0
end

---执行逻辑
---@param callback fun(success: boolean, results: any):void 执行完成后的回调function(是否成功, 数据结果|失败tip)
---@return void
function AIHelperModuleBase:Execute(callback)
    if callback then
        callback(true, nil)
    end
end

--endregion

--region  ----------------UI接口------------------

---显示执行前的设置UI状态
---@param item AIHelperView._obj_listItem_GoTable
---@return void
function AIHelperModuleBase:ShowSettings(item)
    if _G.AppSetting.DEBUG then
        item.gameObject:SetName(self.cfg.id .. " | " .. self.__cname)
    end
    item.aortext_title.text = _G.GetLangPackValue(self.cfg.name)
end

---设置设置UI类型
---@param item AIHelperView._obj_listItem_GoTable
---@param type number
---@return void
function AIHelperModuleBase:SetSettingsType(item, type)
    item.obj_select:SetActiveE(isType(type, SettingTypes.Select) and 1 or 0)
    item.obj_number:SetActiveE(isType(type, SettingTypes.Number) and 1 or 0)
    item.obj_tip:SetActiveE(isType(type, SettingTypes.Tip) and 1 or 0)
end

---监听设置点击事件
---@param item AIHelperView._obj_listItem_GoTable
---@param go UnityEngine.GameObject|UnityEngine.Component
---@param isOn boolean
function AIHelperModuleBase:OnSettingsBtn(item, go, isOn)
end

---监听设置Input输入事件
---@param item AIHelperView._obj_listItem_GoTable
---@param go UnityEngine.Component
---@param text string
function AIHelperModuleBase:OnSettingsInput(item, go, text)
end

---显示执行中的UI状态
---@param item AIHelperExecuteView._obj_listItem_GoTable
---@return void
function AIHelperModuleBase:ShowExecuting(item)
    item.obj_executing:SetActiveE(1)
    item.obj_failure:SetActiveE(0)
    item.obj_success:SetActiveE(0)
    item.obj_damage:SetActiveE(0)
    item.scrollloophorizontal_award:SetActiveE(0)
    item.aortext_failure:SetActiveE(0)
end

---显示执行状态
---@param item AIHelperExecuteView._obj_listItem_GoTable
---@param state any                 @当前执行状态
---@param results any               @执行结果数据
function AIHelperModuleBase:ShowExecutingState(item, state, results)
    if _G.AppSetting.DEBUG then
        item.gameObject:SetName(self.cfg.id .. " | " .. self.__cname)
    end
    item.aortext_title.text = self:GetExecuteTitle(state)
    item.obj_tipNew:SetActiveE(0)
end

---显示执行结束UI状态
---@param item AIHelperExecuteView._obj_listItem_GoTable
---@param success 执行是否成功       @执行是否成功
---@param results any               @执行结果数据
---@return void
function AIHelperModuleBase:ShowExecuteResult(item, success, results)
    item.obj_executing:SetActiveE(0)
    item.obj_success:SetActiveE(success and not results and 1 or 0)
    item.scrollloophorizontal_award:SetActiveE(success and results and 1 or 0)
    item.obj_damage:SetActiveE(0)

    --失败结果展示
    local showFailureTip = not success and results and type(results.tip) == "number"
    item.obj_failure:SetActiveE(not success and not showFailureTip and 1 or 0)
    item.aortext_failure:SetActiveE(not success and showFailureTip and 1 or 0)
    if showFailureTip then
        item.aortext_failure.text = results.tipParams and
            _G.GetLangPackValue(results.tip, table.unpack(results.tipParams)) or
            _G.GetLangPackValue(results.tip)
    end
end

---隐藏执行结束UI状态(此时可以回收一些外部节点)
---@param item AIHelperExecuteView._obj_listItem_GoTable
---@param results any               @执行结果数据
---@return void
function AIHelperModuleBase:HideExecuteResult(item, results)
end

---获取当前执行标题
---@param state any                 @当前执行状态
---@return string
function AIHelperModuleBase:GetExecuteTitle(state)
    return _G.GetLangPackValue(self.cfg.title)
end

---获取当前状态的失败提示(IsActive不满足条件)
---@return {tip:number}
function AIHelperModuleBase:GetCurrentFailureResults()
    return self:CreateFailureResults(1)
end

---创建失败提示
---@param id number     提示tip或者类型: 1无可执行任务(默认), 2日常任务已完成
---@return {tip:number}
function AIHelperModuleBase:CreateFailureResults(id, ...)
    if not id then
        id = 1
    end
    if id < 100 then
        if id == 1 then
            id = 90000011390
        elseif id == 2 then
            id = 90000011424
        end
    end
    return {
        tip = id,
        tipParams = { ... }
    }
end

--endregion

return AIHelperModuleBase
