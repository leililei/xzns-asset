--region    ----------------------全局变量定义------------------------

---@class SettingTypes
---@field Select number     开关类型
---@field Number number     选数字类型
---@field Tip number        tip状态
---
---@type SettingTypes
local SettingTypes = {
    Select = 1,
    Number = 2,
    Tip = 4
}
---是否为目标类型
---@param type number       当前type数值
---@param target number     目标type
---@return boolean
local function isType(type, target)
    if type <= 0 then
        return false
    end
    return (type & target) == target
end

--endregion

