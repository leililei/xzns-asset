local base = require("AIHelperModuleBaseSelect")

---@class AIHelperModuleCardDevelop : AIHelperModuleBaseSelect	    @AI助手-英雄一键进阶
---@field hasQuickUpStar boolean                @是否可一键进阶
---@field count number                          @剩余执行次数
local AIHelperModuleCardDevelop = _G.BaseClass("AIHelperModuleCardDevelop", base)

---是否满足模块使用条件
function AIHelperModuleCardDevelop:IsActive()
    return self.count and self.count > 0
end

---重置状态
function AIHelperModuleCardDevelop:Reset()
    base.Reset(self)
    self.hasQuickUpStar = true
    self.count = 1
end

---获取状态(可能为异步请求数据)
function AIHelperModuleCardDevelop:Check(callback)
    local cardList = require("CardInfoManager"):GetInstance():GetSortUpStarAll(nil, true)
    self.hasQuickUpStar = cardList and #cardList > 0
    if callback then
        callback(true)
    end
end

---执行逻辑
function AIHelperModuleCardDevelop:Execute(callback)
    if not self.hasQuickUpStar or not self.count or self.count <= 0 then
        if callback then
            callback(false, self:CreateFailureResults(self.cfg.fail_tip))
        end
        return
    end

    self.hasQuickUpStar = false
    self.count = (self.count or 0) - 1
    local function response(success, results)
        if not callback then
            return
        end
        callback(success, results)
    end
    local manager = require("CardInfoManager"):GetInstance()
    if manager:CheckAutoCardDevelop() then
        manager:AutoCardDevelop(response)
    else
        response(false, nil)
    end
end

---显示执行结束UI状态
---@param results public.s2c_common_ack
function AIHelperModuleCardDevelop:ShowExecuteResult(item, success, results)
    base.ShowExecuteResult(self, item, success, results)
    if not success then
        return
    end
    self.Util.ShowAwardListOfMsg(item, results)
end

---隐藏执行结束UI状态(此时可以回收一些外部节点)
function AIHelperModuleCardDevelop:HideExecuteResult(item, results)
    base.HideExecuteResult(self, item.resutls)
    self.Util.HideAwardListOfMsg(item, results)
end

return AIHelperModuleCardDevelop
