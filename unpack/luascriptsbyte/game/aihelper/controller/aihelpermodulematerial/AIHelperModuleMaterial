---通关楼层限制(至少通关此楼层才开启扫荡)
local PassFloorLimit = 30

local base = require("AIHelperModuleBaseNumberMock")

---@class AIHelperModuleMaterial : AIHelperModuleBaseNumberMock	    @AI助手-试炼副本
---@field systemId number               @功能id: 102幻境修行, 101猎金狂潮, 105星魂试炼, 103兵备演武
---@field index number                  @已执行次数
---@field count number                  @剩余扫荡次数
local AIHelperModuleMaterial = _G.BaseClass("AIHelperModuleMaterial", base)

function AIHelperModuleMaterial:__init()
    self.systemId = self.cfg.script_parameter and self.cfg.script_parameter[1] or 0
end

---是否显示此模块(功能是否开启)
function AIHelperModuleMaterial:IsEnabled()
    if not base.IsEnabled(self) then
        return false
    end
    if not self.systemId or self.systemId <= 0 then
        return false
    end

    local controller = require("SystemMaterialController"):GetInstance()
    --检查model是否已初始化
    --ZHJ-35558【AI助手】开启材料副本后，打开助手报错
    local model = controller:GetModel(self.systemId)
    if not model then
        return false
    end
    --检查是否已通关最高层
    -- local allData = controller:GetDatas(self.systemId)
    -- if allData then
    --     local maxFloorId = controller:GetMaterailIDBySidAndFloor(self.systemId, _G.table.count(allData))
    --     local maxData = allData[maxFloorId]
    --     if not maxData or maxData.isLock or maxData.isHide then
    --         return false
    --     end
    -- end
    --检查是否通关最低层数限制
    if controller:GetCurChallengeFloor(self.systemId) <= 1 or
        not controller:CheckIsPass(self.systemId, PassFloorLimit)
    then
        return false
    end
    return true
end

---是否满足模块使用条件
function AIHelperModuleMaterial:IsActive()
    return self.index <= self.number and self.count > 0
end

---获取Number范围
function AIHelperModuleMaterial:GetCountRange()
    return 0, 10
end

---重置状态
function AIHelperModuleMaterial:Reset()
    base.Reset(self)
    self.index = 1
    self.count = 2
end

---获取状态(可能为异步请求数据)
function AIHelperModuleMaterial:Check(callback)
    self.index = 1

    --获取剩余扫荡次数且至少通关一次
    local controller = require("SystemMaterialController"):GetInstance()
    if not controller:CheckIsPass(self.systemId, 1) then
        --未通关时, 在Execute中返回失败提示
        --self.count = 0
        self.count = 1
    else
        self.count = controller:GetTImesAndCount(self.systemId)
    end

    if callback then
        callback(true)
    end
end

---获取当前执行状态
function AIHelperModuleMaterial:GetExecuteState()
    local controller = require("SystemMaterialController"):GetInstance()
    --获取当前扫荡层数
    local curFloor = controller:GetCurChallengeFloor(self.systemId)
    if curFloor > 1 and not controller:CheckIsPass(self.systemId, 1) then
        curFloor = curFloor - 1
    end

    return {
        total = self.number,
        index = self.index,
        floor = curFloor
    }
end

---执行逻辑
function AIHelperModuleMaterial:Execute(callback)
    local controller = require("SystemMaterialController"):GetInstance()

    --一层都没通关过
    if not controller:CheckIsPass(self.systemId, 1) then
        if callback then
            callback(false, self:CreateFailureResults(self.cfg.fail_tip))
        end
        return
    end
    --检查是否已通关最高层
    -- local allData = controller:GetDatas(self.systemId)
    -- if allData then
    --     local maxFloorId = controller:GetMaterailIDBySidAndFloor(self.systemId, _G.table.count(allData))
    --     local maxData = allData[maxFloorId]
    --     if not maxData or maxData.isLock or maxData.isHide then
    --         if callback then
    --             callback(false, self:CreateFailureResults(self.cfg.fail_tip))
    --         end
    --         return
    --     end
    -- end
    --检查是否通关最低层数限制
    if controller:GetCurChallengeFloor(self.systemId) <= 1 or
        not controller:CheckIsPass(self.systemId, PassFloorLimit)
    then
        if callback then
            callback(false, self:CreateFailureResults(self.cfg.fail_tip))
        end
        return
    end

    self.index = self.index + 1
    self.count = self.count - 1

    --发起扫荡请求
    controller:OnSweep(
        self.systemId,
        1,
        function(msg)
            if callback then
                callback(msg and msg.ack == 1, msg)
            end
        end,
        true
    )
end

---显示执行状态
function AIHelperModuleMaterial:ShowExecutingState(item, state, results)
    base.ShowExecutingState(self, item, state, results)
    item.aortext_title.text = _G.GetLangPackValue(self.cfg.title, state and state.floor or 1)
    if not self.mock then
        item.aortext_tip.text = state and (state.index .. "/" .. state.total) or ""
    end
end

---显示执行结束UI状态
---@param results public.s2c_common_ack
function AIHelperModuleMaterial:ShowExecuteResult(item, success, results)
    base.ShowExecuteResult(self, item, success, results)
    if not success then
        return
    end
    self.Util.ShowAwardListOfMsg(item, results)
end

---隐藏执行结束UI状态(此时可以回收一些外部节点)
function AIHelperModuleMaterial:HideExecuteResult(item, results)
    base.HideExecuteResult(self, item.resutls)
    self.Util.HideAwardListOfMsg(item, results)
end

---获取当前执行标题
function AIHelperModuleMaterial:GetExecuteTitle(state)
    if state and state.floor then
        return _G.GetLangPackValue(self.cfg.title, state.floor)
    end
    return base.GetExecuteTitle(self, state)
end

return AIHelperModuleMaterial
