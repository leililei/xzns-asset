local base = require("AIHelperModuleBaseSelect")

---@class AIHelperModuleSign : AIHelperModuleBaseSelect	    @AI助手-签到/活跃补给/皇家补给
---@field type number                           @类型 1:活跃补给 2:皇家补给
---@field count number                          @执行次数
---@field hasAward boolean                      @是否有可领取的奖励
---@field activity ActivitySynCfgActivity       @活动实例
---@field activityCls MoreDaySignModel          @活动实例
local AIHelperModuleSign = _G.BaseClass("AIHelperModuleSign", base)
function AIHelperModuleSign:__init()
    self.type = self.cfg.script_parameter and self.cfg.script_parameter[1] or 1
end

---是否显示此模块(功能是否开启)
function AIHelperModuleSign:IsEnabled()
    local activityManager = require("ActivitySynEnterManager"):GetInstance()
    local tag = _G.ConfigManager.ui_cfg.FuliView.Name
    if not activityManager.activityPagesInfoTab or not activityManager.activityPagesInfoTab[tag] then
        return false
    end

    self.activity = nil
    self.activityCls = nil
    ---@param activity ActivitySynCfgActivity
    for _, activity in ipairs(activityManager.activityPagesInfoTab[tag]) do
        if activity:GetActivityID() == 1011701 then --签到活动id
            self.activity = activity
            self.activityCls = activity:GetActivityTypeCls()
            break
        end
    end
    if not self.activityCls then
        return false
    end

    if self.type == _G.MoreDaySignType.Cash and not self.activityCls:CheckIsBuy() then
        return false
    end
    return true
end

---是否满足模块使用条件
function AIHelperModuleSign:IsActive()
    return self.count > 0
end

---重置状态
---@return void
function AIHelperModuleSign:Reset()
    base.Reset(self)
    self.hasAward = true
    self.count = 1
end

---获取状态(可能为异步请求数据)
function AIHelperModuleSign:Check(callback)
    self.hasAward = self:CheckAward()
    self.count = 1
    base.Check(self, callback)
end

---执行逻辑
function AIHelperModuleSign:Execute(callback)
    self.count = self.count - 1
    if not self.hasAward or not self.activity or not self:CheckAward() then
        if callback then
            callback(false, self:CreateFailureResults(self.cfg.fail_tip))
        end
        return
    end

    self.hasAward = false --不要再继续执行
    self.activityCls:GetAward(self.type, nil, function(msg)
        if callback then
            if not msg or msg.ack ~= 1 then
                callback(false, self:CreateFailureResults(self.cfg.fail_tip))
            else
                callback(true, msg)
            end
        end
    end, true)
end

---显示执行结束UI状态
---@param results public.s2c_common_ack
function AIHelperModuleSign:ShowExecuteResult(item, success, results)
    base.ShowExecuteResult(self, item, success, results)
    if not success then
        return
    end
    self.Util.ShowAwardListOfMsg(item, results)
end

---隐藏执行结束UI状态(此时可以回收一些外部节点)
function AIHelperModuleSign:HideExecuteResult(item, results)
    base.HideExecuteResult(self, item.resutls)
    self.Util.HideAwardListOfMsg(item, results)
end

---检查是否可以领取奖励
function AIHelperModuleSign:CheckAward()
    if not self.activityCls then
        return false
    end
    ---检测付费状态
    if self.type == _G.MoreDaySignType.Cash and not self.activityCls:CheckIsBuy() then
        return false
    end
    --检测领取状态
    if _G.table.isEmptyOrNil(self.activityCls:GetCanGetIndex(self.type)) then
        return false
    end
    return true
end

return AIHelperModuleSign
