local base = require("AIHelperModuleBaseSelect")

---@class AIHelperModuleAFKAward : AIHelperModuleBaseSelect	    @AI助手-AFK放置冒险挂机奖励
---@field hasAward boolean                      @是否有可领取的奖励
---@field count number                  @剩余执行次数
local AIHelperModuleAFKAward = _G.BaseClass("AIHelperModuleAFKAward", base)

---是否满足模块使用条件
function AIHelperModuleAFKAward:IsActive()
    return self.count and self.count > 0
end

---重置状态
---@return void
function AIHelperModuleAFKAward:Reset()
    base.Reset(self)
    self.hasAward = true
    self.count = 1
end
---获取状态(可能为异步请求数据)
function AIHelperModuleAFKAward:Check(callback)
    self.hasAward = false
    require("AfkModel"):GetInstance():CheckAfkAward(
        function(_, msg)
            local ok = msg and msg.ack == 1
            if ok and msg.award and #msg.award.item > 0 then
                self.hasAward = true
            end
            if callback then
                callback(true)
            end
        end
    )
end
---执行逻辑
function AIHelperModuleAFKAward:Execute(callback)
    if not self.hasAward or not self.count or self.count <= 0 then
        if callback then
            callback(false, self:CreateFailureResults(self.cfg.fail_tip))
        end
        return
    end

    self.hasAward = false --不要再继续执行
    self.count = (self.count or 0) - 1
    require("AfkModel"):GetInstance():GetAfkAward(
        function(msg)
            local success = msg and msg.ack == 1
            if success then
                --清除AFK挂机奖励缓存, 更新主界面UI
                ---@type MainView
                local mainView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name)
                if mainView and mainView:IsToggled("afk") then
                    mainView:UpdateView()
                end
            end

            if callback then
                callback(success, msg)
            end
        end,
        true
    )
end

---显示执行结束UI状态
---@param results public.s2c_common_ack
function AIHelperModuleAFKAward:ShowExecuteResult(item, success, results)
    base.ShowExecuteResult(self, item, success, results)
    if not success then
        return
    end
    self.Util.ShowAwardListOfMsg(item, results)
end
---隐藏执行结束UI状态(此时可以回收一些外部节点)
function AIHelperModuleAFKAward:HideExecuteResult(item, results)
    base.HideExecuteResult(self, item.resutls)
    self.Util.HideAwardListOfMsg(item, results)
end

return AIHelperModuleAFKAward
