local base = require("AIHelperModuleBase")

---@class AIHelperModuleBaseSelect : AIHelperModuleBase
---@field selected boolean                           @是否需要执行此模块
local AIHelperModuleBaseSelect = _G.BaseClass("AIHelperModuleBaseSelect", base)

function AIHelperModuleBaseSelect:__init()
    self.selected = self:ReadSettings(true)
    if self.selected == nil then
        self.selected = false
    elseif type(self.selected) ~= "boolean" then
        self.selected = true
    end
end

---是否执行此模块
function AIHelperModuleBaseSelect:IsExecute()
    return self.selected
end

---执行前的设置UI状态
function AIHelperModuleBaseSelect:ShowSettings(item)
    base.ShowSettings(self, item)
    self:SetSettingsType(item, self.Types.Select)

    item.toggle_enable.isOn = not (not self.selected)
    item.toggle_disable.isOn = not self.selected
end
---监听设置点击事件
function AIHelperModuleBaseSelect:OnSettingsBtn(item, go, isOn)
    if not isOn then
        return
    end
    if go == item.toggle_enable then
        self.selected = true
    elseif go == item.toggle_disable then
        self.selected = false
    end
    self:SaveSettings(self.selected)
end

---显示执行状态
function AIHelperModuleBaseSelect:ShowExecutingState(item, state, results)
    base.ShowExecutingState(self, item, state, results)
    item.aortext_tip.text = ""
end

return AIHelperModuleBaseSelect
