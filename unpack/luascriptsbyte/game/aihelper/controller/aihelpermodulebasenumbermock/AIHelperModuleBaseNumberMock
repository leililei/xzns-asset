local base = require("AIHelperModuleBaseNumber")

---@class AIHelperModuleBaseNumberMock : AIHelperModuleBaseNumber
---@field number boolean                            @执行此模块的次数
---@field mock boolean                              @是否启用此模块的mock模式, 模拟开启/关闭选项
local AIHelperModuleBaseNumberMock = _G.BaseClass("AIHelperModuleBaseNumberMock", base)

function AIHelperModuleBaseNumberMock:__init()
    self.mock = true
    self.number = self:ReadSettings(1)
    if type(self.number) ~= "number" then
        self.number = 1
    end
end

---设置mock开关
---@param enable boolean
function AIHelperModuleBaseNumberMock:SetMock(enable)
    self.mock = enable
    --默认使用最大次数
    if enable and self.number and self.number > 0 then
        local _, max = self:GetCountRange()
        self.number = math.max(max, 1)
    end
end

---重置状态
function AIHelperModuleBaseNumberMock:Reset()
    base.Reset(self)
    self.mock = true
    self:SetMock(true)
end
---获取Number范围
function AIHelperModuleBaseNumberMock:GetCountRange()
    if self.mock then
        return 0, 1
    end
    return base.GetCountRange(self)
end

---执行前的设置UI状态
function AIHelperModuleBaseNumberMock:ShowSettings(item)
    base.ShowSettings(self, item)

    if self.mock then
        self:SetSettingsType(item, self.Types.Select)

        item.toggle_enable.isOn = self.number > 0
        item.toggle_disable.isOn = self.number <= 0
    end
end
---显示执行状态
function AIHelperModuleBaseNumberMock:ShowExecutingState(item, state, results)
    base.ShowExecutingState(self, item, state, results)
    if self.mock then
        item.aortext_tip.text = ""
    end
end
---监听设置点击事件
function AIHelperModuleBaseNumberMock:OnSettingsBtn(item, go, isOn)
    if self.mock then
        if not isOn then
            return
        end
        if go == item.toggle_enable then
            local _, max = self:GetCountRange()
            self.number = math.max(max, 1)
        elseif go == item.toggle_disable then
            self.number = 0
        end
        self:CheckCountRange()
        self:ShowSettingsCount(item)

        self:SaveSettings(self.number)
    else
        base.OnSettingsBtn(self, item, go, isOn)
    end
end

return AIHelperModuleBaseNumberMock
