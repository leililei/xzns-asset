local base = require("AIHelperModuleBaseSelect")

---@class AIHelperModuleSociatyGloryAward : AIHelperModuleBaseSelect	    @AI助手-公会捐献
---@field hasAward boolean                          @是否可以领取奖励
---@field count number                              @剩余执行次数
local AIHelperModuleSociatyGloryAward = _G.BaseClass("AIHelperModuleSociatyGloryAward", base)


---是否显示此模块(功能是否开启)
function AIHelperModuleSociatyGloryAward:IsEnabled()
    if not base.IsEnabled(self) then
        return false
    end
    --检查是否加入了公会
    if not require("SociatyManager"):GetInstance():HasSociaty() then
        return false
    end
    return true
end

---是否满足模块使用条件
function AIHelperModuleSociatyGloryAward:IsActive()
    return self.count and self.count > 0
end

---重置状态
---@return void
function AIHelperModuleSociatyGloryAward:Reset()
    base.Reset(self)
    self.hasAward = true
    self.count = 1
end

---获取状态(可能为异步请求数据)
function AIHelperModuleSociatyGloryAward:Check(callback)
    self.hasAward = false

    ---重新拉取公会数据
    local model = require("SociatyModel"):GetInstance()
    if model.SociatyRoleSelf then
        self:CheckAward()
        if callback then
            callback(true)
        end
    else
        model:InitData(function()
            self:CheckAward()
            if callback then
                callback(true)
            end
        end)
    end
end

---执行逻辑
function AIHelperModuleSociatyGloryAward:Execute(callback)
    if not self.hasAward then
        if callback then
            callback(false, self:CreateFailureResults(self.cfg.fail_tip))
        end
        return
    end
    self.hasAward = false --不要再继续执行
    self.count = (self.count or 0) - 1

    require("SociatyNet"):GetInstance():GetReward(function(msg)
        if not msg or msg.ack ~= 1 then
            if callback then
                callback(false, nil)
            end
            return
        end

        ---更新缓存信息
        local model = require("SociatyModel"):GetInstance()
        if model.SociatyRoleSelf then
            model.SociatyRoleSelf.wages = 1
        end
        --获取奖励
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
        --刷新红点信息
        require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.GuildGlory.id)

        if callback then
            callback(true, msg)
        end
    end)
end

---显示执行结束UI状态
---@param results public.s2c_common_ack
function AIHelperModuleSociatyGloryAward:ShowExecuteResult(item, success, results)
    base.ShowExecuteResult(self, item, success, results)
    if not success then
        return
    end
    self.Util.ShowAwardListOfMsg(item, results)
end

---隐藏执行结束UI状态(此时可以回收一些外部节点)
function AIHelperModuleSociatyGloryAward:HideExecuteResult(item, results)
    base.HideExecuteResult(self, item.resutls)
    self.Util.HideAwardListOfMsg(item, results)
end

---检查当前是否可领取奖励
---@return void
function AIHelperModuleSociatyGloryAward:CheckAward()
    self.hasAward = not require("SociatyModel"):GetInstance():IsGetReward()
end

return AIHelperModuleSociatyGloryAward
