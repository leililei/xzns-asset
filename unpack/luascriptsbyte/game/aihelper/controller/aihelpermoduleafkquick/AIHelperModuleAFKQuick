---扫荡券ID
local TicketId = 203030701

local base = require("AIHelperModuleBaseNumber")

---@class AIHelperModuleAFKQuick : AIHelperModuleBaseNumber	    @AI助手-AFK放置快速挂机(付费)
---@field index number                  @已执行次数
---@field hasFreeAward boolean          @是否有免费次数
---@field ticketNum number              @拥有的卡券数量
---@field diamondNum number             @可用的魂玉次数
local AIHelperModuleAFKQuick = _G.BaseClass("AIHelperModuleAFKQuick", base)

function AIHelperModuleAFKQuick:__init()
    self.number = self:ReadSettings(0)
    if type(self.number) ~= "number" then
        self.number = 0
    end
end

function AIHelperModuleAFKQuick:IsEnabled()
    if not base.IsEnabled(self) then
        return false
    end

    --有挂机券, 则显示
    -- local ticketNum = _G.StorageManager:GetInstance():GetItemCountBySid(TicketId)
    -- if ticketNum >= 0 then
    --     return true
    -- end
    --使用魂玉且有免费次数时, 不显示
    local freeNum = require("AfkModel"):GetInstance():GetFreeRewardTime()
    if freeNum > 0 then
        return false
    end
    return true
end

---是否满足模块使用条件
function AIHelperModuleAFKQuick:IsActive()
    --有免费次数时, 不允许使用付费次数
    if self.hasFreeAward then
        return false
    end
    return self.index <= self.number and (self.ticketNum > 0 or self.diamondNum > 0)
end

---获取Number范围
function AIHelperModuleAFKQuick:GetCountRange()
    if self.ticketNum > 0 then
        return 0, self.ticketNum
    end
    return 0, self.diamondNum
end

---重置状态
function AIHelperModuleAFKQuick:Reset()
    base.Reset(self)
    self.index = 1
    self.hasFreeAward = false
    self.ticketNum = _G.StorageManager:GetInstance():GetItemCountBySid(TicketId)
    self.diamondNum = require("AfkModel"):GetInstance():GetRewardTime()
end

---获取状态(可能为异步请求数据)
function AIHelperModuleAFKQuick:Check(callback)
    self:Reset()
    self.hasFreeAward = require("AfkModel"):GetInstance():GetFreeRewardTime() > 0
    self.ticketNum = _G.StorageManager:GetInstance():GetItemCountBySid(TicketId)
    self.diamondNum = require("AfkModel"):GetInstance():GetRewardTime()

    if callback then
        callback(true)
    end
end

---获取当前执行状态
function AIHelperModuleAFKQuick:GetExecuteState()
    return {
        total = self.number,
        index = self.index
    }
end

---执行逻辑
function AIHelperModuleAFKQuick:Execute(callback)
    self.index = self.index + 1

    --1使用魂玉, 2使用卡券
    local type = self.ticketNum <= 0 and 1 or 2

    local function response(success, results)
        if not callback then
            return
        end
        callback(success, results)
    end

    if self.ticketNum > 0 then
        self.ticketNum = self.ticketNum - 1
    else
        self.diamondNum = self.diamondNum - 1
        --检查魂玉是否充足
        local model = require("AfkModel"):GetInstance()
        if not model.RewardConsume then
            response(false, nil)
            return
        end
        local index = model.RewardTime + model:GetFreeRewardTime() + 1
        local maxIndex = #model.RewardConsume
        local consumeNum = model.RewardConsume[index > maxIndex and maxIndex or index]
        if not _G.StorageManager:GetInstance():CheckItem(_G.ResPropID.Diamond, consumeNum) then
            response(false, nil)
            return
        end
    end

    require("AfkModel"):GetInstance():GetQuickAfkAward(
        type,
        function(msg)
            --刷新红点状态
            require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.AfkQuick.id)
            --刷新界面状态
            _G.MainManager:GetInstance():RefreshAfkBoxTip()
            response(true, msg)
        end
    )
end

---执行前的设置UI状态
function AIHelperModuleAFKQuick:ShowSettings(item)
    base.ShowSettings(self, item)

    self:SetSettingsType(item, self.Types.Number | self.Types.Tip)
    item.aortext_tipPrefix:SetActiveE(1)
    item.aortext_tipSuffix:SetActiveE(1)
    item.aorrawimage_tipIcon:SetActiveE(1)
end

---显示执行状态
function AIHelperModuleAFKQuick:ShowExecutingState(item, state, results)
    base.ShowExecutingState(self, item, state, results)
    item.aortext_tip.text = state and (state.index .. "/" .. state.total) or ""
end

---通知number状态发生变化
function AIHelperModuleAFKQuick:ShowSettingsCount(item)
    base.ShowSettingsCount(self, item)

    --显示消耗信息
    local consumeIcon, consumeNum
    if self.ticketNum > 0 then
        consumeIcon = _G.StorageManager:GetInstance():GetStorageItemData(TicketId).Icon
        consumeNum = self.number
    else
        local data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.ResProp, _G.ResPropID.Diamond)
        consumeIcon = not data and "" or data.cfg.icon or data.cfg.Icon
        consumeNum = 0
        --计算消耗魂玉数量
        local model = require("AfkModel"):GetInstance()
        if model.RewardConsume then
            local baseIndex = model.RewardTime + model:GetFreeRewardTime()
            local maxIndex = #model.RewardConsume
            for i = 1, self.number do
                local index = baseIndex + i
                consumeNum = consumeNum + model.RewardConsume[index > maxIndex and maxIndex or index]
            end
        end
    end
    item.aortext_tipPrefix.text = _G.GetLangPackValue(90000011391)
    item.aortext_tipSuffix.text = tostring(consumeNum)
    item.aorrawimage_tipIcon:LoadImage(consumeIcon)
end

---显示执行结束UI状态
---@param results public.s2c_common_ack
function AIHelperModuleAFKQuick:ShowExecuteResult(item, success, results)
    base.ShowExecuteResult(self, item, success, results)
    if not success then
        return
    end
    AIHelperModuleAFKQuick.SetAfkAwardExtraFlags(results, "jsxt_pic_zhongzu_wenhao")
    self.Util.ShowAwardListOfMsg(item, results)
end

---隐藏执行结束UI状态(此时可以回收一些外部节点)
function AIHelperModuleAFKQuick:HideExecuteResult(item, results)
    base.HideExecuteResult(self, item.resutls)
    self.Util.HideAwardListOfMsg(item, results)
end

---设置奖励奖励标志位
---@param results public.s2c_common_ack
---@param flag string
function AIHelperModuleAFKQuick.SetAfkAwardExtraFlags(msg, flag)
    if not msg or not msg.award or msg.extraFlags then
        return
    end
    local extraData = require("AfkModel"):GetInstance():GetCurAfkQuickAwawrd()
    if not extraData or not extraData[1] then
        return
    end

    local extraFlags = msg.extraFlags
    if not extraFlags then
        extraFlags = {}
        msg.extraFlags = extraFlags
    end

    --获取sid对应最小数量的节点
    ---@type table<number,{k:number,v:any,num:number}>
    local uniqueAwardList = {}
    for k, v in pairs(msg.award.item) do
        local sid, num = v.type[1], v.type[2]
        if not uniqueAwardList[sid] then
            uniqueAwardList[sid] = { k = k, v = v, num = num }
        elseif num < uniqueAwardList[sid].num then
            local data = uniqueAwardList[sid]
            data.k = k
            data.v = v
            data.num = num
        end
    end

    --设置标志位
    for _, v in pairs(extraData[1]) do
        local on, sid = v[1], v[2]
        if on and uniqueAwardList[sid] then
            extraFlags[uniqueAwardList[sid].k] = flag
        end
    end
end

return AIHelperModuleAFKQuick
