local base = require("BaseGameNet")

---@class HeroicIconNet : BaseGameNet    通信协议
local HeroicIconNet = _G.BaseClass("HeroicIconNet", base)
---@return HeroicIconNet HeroicIconNet
function HeroicIconNet:GetInstance()
    return base.GetInstance(self)
end

---获取圣像信息
function HeroicIconNet:GetInfo(callback)
    local item = _G.ConfigManager.net_map.game_heroic_icon_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.Callback))
    self.Call[port] = callback
end

