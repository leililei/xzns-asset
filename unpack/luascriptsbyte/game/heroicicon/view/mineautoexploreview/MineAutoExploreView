---@class MineAutoExploreView : UIBaseView	中文描述
---@field public go_table MineAutoExploreView_GoTable GoTable
---@field activityTypeCls MoreDaySignModel 活动类型数据
local MineAutoExploreView = _G.BaseClass("MineAutoExploreView", _G.UIBaseView)
--_G.MineAutoExploreView = MineAutoExploreView
local GetLangPackValue = _G.GetLangPackValue
local langugageColor = { 
    _G.GetLangPackValue(90036000573),
    _G.GetLangPackValue(90036000572),
    _G.GetLangPackValue(90036000571),
    _G.GetLangPackValue(90036000570)
}
function MineAutoExploreView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param activity ActivitySynGMActivity 活动数据
function MineAutoExploreView:OnCreate(msg, call)
    self.call = call
    self.msg = msg
    self.awardData = _G.StorageManager:GetInstance():MergeAwardList(self.msg.award.item)
    self:UpdateView()
end

---更新界面
function MineAutoExploreView:UpdateView()
    self.go_table.scrollloopvectical_itemList:InitItemData(0, _G.handler(self, self.RefreshItem))
    self.go_table.scrollloopvectical_itemList:UpdateCount(#self.awardData)
    table.sort(self.msg.type_list, function(a, b)
        return a.key > b.key
    end)
    local desTxt = _G.GetLangPackValue(90036000569)
    for i = 1, #self.msg.type_list do 
        if i == 1 then 
            desTxt = desTxt .. string.format(langugageColor[self.msg.type_list[i].key], self.msg.type_list[i].value) 
        else 
            desTxt = desTxt .. string.format("," ..langugageColor[self.msg.type_list[i].key], self.msg.type_list[i].value) 
        end
    end
    self.go_table.aortext_des.text = desTxt
end

---刷新物体
---@param index number 下标
---@param obj UnityEngine.GameObject 物体
function MineAutoExploreView:RefreshItem(index, obj)
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        self.awardData[index + 1],
        obj,
        function(item)
            item.gameObject:SetLocalScaleXYZ(0.9)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            item:ShowEffect(true)
        end,
        function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject,
            self.awardData[index + 1][1])
        end
    )
end

---按钮点击事件在这里派发
function MineAutoExploreView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_getAll or go == self.go_table.aorbtn_close then
        if self.call then 
            self.call()
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, self.msg)
        self:Close()
    end
end

---关闭界面
function MineAutoExploreView:CloseView()
    self:Close()
end

return MineAutoExploreView
