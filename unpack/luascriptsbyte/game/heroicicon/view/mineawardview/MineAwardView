---@class MineAwardView : UIBaseView	中文描述
---@field public go_table MineAwardView_GoTable GoTable
local MineAwardView = _G.BaseClass("MineAwardView", _G.UIBaseView)

local title={
    [1]=90036000558,
    [2]=90036000559,
    [3]=90036000560,
    [4]=90036000561
}
local awardTypebgName={
    [1]={spritename="ui_biaoqian_hong",name=90036000564},
    [2]={spritename="ui_biaoqian_zi",name=90036000563},
    [3]={spritename="ui_biaoqian_lv",name=90036000562},

}
function MineAwardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MineAwardView:OnCreate()
    if not _G.AppSetting.IsXzns then
        self.HeroicIconModel = require "HeroicIconModel":GetInstance()
        self:FreshData()
        self:UpdateView()
    else
        self.level = require("HeroicMineModelSg"):GetInstance():GetLevel()
        local cfgs = _G.ConfigManager.heroic_icons_ruins_cfg
        for k, cfg in pairs(cfgs) do
            local item = _G.InstantiateObject(self.go_table.obj_item, self.go_table.obj_content)
            local tb = _G.GetAutoGoTable(item)
            if _G.AppSetting.IsXzns then
                tb.aortext_title.text = _G.GetLangPackValue(90000012096, _G.GameUtil.NumberToChinese(k))
            else
                tb.aortext_title.text = _G.GetLangPackValue(92010700030, _G.GameUtil.NumberToChinese(k))
            end
            for _, v in pairs(cfg.reward_publicity) do
                local award = _G.InstantiateObject(self.go_table.obj_award, tb.obj_award)
                local awardTb = _G.GetAutoGoTable(award)
                if v[3] == 0 then
                    awardTb.aorimage_des:SetActiveE(0)
                elseif v[3] == 1 then
                    if _G.AppSetting.IsXzns then
                        awardTb.aortext_des.color = _G.ColorTools.FormatColorByString("FF9B5E")
                    else
                        awardTb.aorimage_des.SpriteName = "ui_mq_mqtc_hsd"
                    end
                    awardTb.aortext_des.text = _G.GetLangPackValue(90036000564)
                elseif v[3] == 2 then
                    if _G.AppSetting.IsXzns then
                        awardTb.aortext_des.color = _G.ColorTools.FormatColorByString("A36EC5")
                    else
                        awardTb.aorimage_des.SpriteName = "ui_mq_mqtc_zsd"
                    end
                    awardTb.aortext_des.text = _G.GetLangPackValue(90036000563)
                elseif v[3] == 3 then
                        if _G.AppSetting.IsXzns then
                        awardTb.aortext_des.color = _G.ColorTools.FormatColorByString("45A3BB")
                    else
                        awardTb.aorimage_des.SpriteName = "ui_mq_mqtc_lsd"
                    end
                    awardTb.aortext_des.text = _G.GetLangPackValue(90036000562)
                end
                _G.StorageManager:GetInstance():GetItemBaseViewNew(
                    { v[1], v[2] },
                    awardTb.obj_root,
                    function(trans)
                        if self:IsNil() then
                            return
                        end
                    end
                )
            end
            if k == 5 then
                for level, v in pairs(cfg.show) do
                    local award = _G.InstantiateObject(self.go_table.obj_award, tb.obj_award)
                    local awardTb = _G.GetAutoGoTable(award)
                    awardTb.aorimage_des:SetActiveE(0)
                    awardTb.aortext_lock:SetActiveE(1)
                    if self.level >= level then
                        awardTb.aortext_lock.text = _G.GetLangPackValue(90100000006)
                        awardTb.aortext_lock.color = _G.ColorTools.FormatColorByString("216b20")
                    else
                        -- awardTb.aorimage_mask:SetActiveE(1)
                        if _G.AppSetting.IsXzns then
                            awardTb.aortext_lock.text = _G.GetLangPackValue(90033405007, level)
                        else
                            awardTb.aortext_lock.text = _G.GetLangPackValue(92010700031, level)
                        end
                        awardTb.aortext_lock.color = _G.ColorTools.FormatColorByString("94280c")
                    end
                    _G.StorageManager:GetInstance():GetItemBaseViewNew(
                        { v, 1 },
                        awardTb.obj_root
                    )
                end
            end
        end
    end
end

function MineAwardView:OnDestroy()
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
function MineAwardView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close1 then
        self:Close()
    elseif go == self.go_table.aorbtn_left then 
        self.nowMineCfg = _G.ConfigManager.heroic_icons_mine_cfg[self.nowMineCfg.lower_mines]
        self:UpdateView()
    elseif go == self.go_table.aorbtn_right then 
        self.nowMineCfg = _G.ConfigManager.heroic_icons_mine_cfg[self.nowMineCfg.upgrade_mine]
        self:UpdateView()
    elseif go == self.go_table.aorbtn_GetUnlockAward then 
        local msg = {}
        msg.sid = {self.maps.sid}
        self.HeroicIconModel:LockAward(msg, function(msg)
            if msg.ack == 1 then 
                self.map_mark  = self.HeroicIconModel:GetMapMark()
                self.go_table.aorbtn_GetUnlockAward:SetActiveE(0)
            end
        end)
    end
end


---刷新数据
function MineAwardView:FreshData()
    self.maps = self.HeroicIconModel:GetMaps()
    self.map_mark  = self.HeroicIconModel:GetMapMark()
    self.nowMineCfg = _G.ConfigManager.heroic_icons_mine_cfg[self.maps.sid]
end

function MineAwardView:UpdateView()
    self.go_table.aorbtn_left:SetActiveE(self.nowMineCfg.lower_mines ~= 0 and 1 or 0)
    self.go_table.aorbtn_right:SetActiveE(self.nowMineCfg.upgrade_mine ~= 0 and 1 or 0)
    local star = self.nowMineCfg.id % 10
    local nowStar = self.maps.sid % 10
    self.go_table.aortext_nowLevel:SetActiveE(star == nowStar and 1 or 0)
    self.go_table.aortext_condition:SetActiveE(star > nowStar and 1 or 0)
    if star == nowStar then 
        self.go_table.aorbtn_GetUnlockAward:SetActiveE((_G.table.ContainsValue(self.map_mark, self.maps.sid) or not self.nowMineCfg.unlock_rewards[1]) and 0 or 1)
    else 
        self.go_table.aorbtn_GetUnlockAward:SetActiveE(0)
    end
    if self.nowMineCfg.condition_type[1] and self.nowMineCfg.condition_type[1][2] then 
        self.go_table.aortext_condition.text = _G.GetLangPackValue(90036000004, self.nowMineCfg.condition_type[1][2] or 0)
    end
    self.go_table.aortext_name.text = _G.GetLangPackValue(self.nowMineCfg.name)
    for i = 1, 4 do 
        self.go_table["obj_star" .. i]:SetActiveE(i <= star and 1 or 0)
    end
    if self.awardDic==nil then
        self.awardDic={}
        for i = 1, #title do
            local obj=_G.InstantiateObject(self.go_table.obj_awardorder,self.go_table.obj_content)
            local tb=_G.GetAutoGoTable(obj)
            tb.aortext_title.text=_G.GetLangPackValue(title[i])
            self.awardDic[i]=tb
            obj:SetActiveE(0)
        end
    else
        for i = 1,  #self.awardDic do
            self.awardDic[i].gameObject:SetActiveE(0)
        end
    end
    for i = 1, #self.awardDic do
        local awardList=self:GetnowMineCfgAwardBuyIndex(i)
        self.awardDic[i].gameObject:SetActiveE((awardList and #awardList>0) and 1 or 0)
        if awardList and #awardList>0 then
            local tb=self.awardDic[i]
            local count=#awardList
            local rect = tb.gameObject:GetComponentE(typeof(_G.CS.UnityEngine.RectTransform))
            local x,y = rect:GetRectTransformSizeDelta()
            local hight=90
            if count%4>0 then
                hight=hight+(count//4+1)*120+(count//4>0 and (count//4)*10 or 0)
            else
                hight=hight+(count//4)*120+(count//4>1 and (count//4-1)*10 or 0)
            end
            rect:SetRectTransformSize(x, hight)
            tb.obj_Content:ClearChildren()

            for j = 1, #awardList do
                local itemobj=_G.InstantiateObject(self.go_table.obj_awarditem,tb.obj_Content)
                itemobj:SetActiveE(1)
                local itemtb=_G.GetAutoGoTable(itemobj)
                if awardList[j].award[3]~=0  and awardTypebgName[awardList[j].award[3]] then
                    itemtb.aortext_type.text=GetLangPackValue(awardTypebgName[awardList[j].award[3]].name)
                    itemtb.aorimage_type.SpriteName=awardTypebgName[awardList[j].award[3]].spritename
                else
                    itemtb.aortext_type:SetActiveE(0)
                    itemtb.aorimage_type:SetActiveE(0)
                end
                _G.StorageManager:GetInstance():GetItemBaseView(
                        awardList[j].award[1],
                        0,
                        itemtb.obj_item,
                        function(item)
                            if _G.IsNil(self.go_table) then
                                _G.DestroyObject(item.go_table.gameObject)
                                return
                            end
                            item.go_table.gameObject:SetLocalScaleXYZ(0.8)
                            --item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                        end
                )
            end
        end
    end
end
function MineAwardView:GetSortAwardList(awardList)
    local awardlist={}
    for i = 1, #awardList do
        local sortid={}
        if awardList[i][1] > 1000 then
            sortid = awardList[i][1]
            repeat
                sortid = sortid / 10
            until sortid < 1000
            local a, b = math.modf(sortid)
            sortid = a
        else
            sortid = awardList[i][1]
        end
        if sortid<100 then
            table.insert(awardlist,{award=awardList[i],order=_G.ConfigManager.currency_type_cfg[awardList[i][1]].Quality})
        elseif sortid>= 202 then
            table.insert(awardlist,{award=awardList[i],order=_G.ConfigManager.item_cfg[awardList[i][1]].Quality})
        end
    end
    table.sort(awardlist,function(a,b)
        if a.award[3]==b.award[3] then
            return a.order>b.order
        else
            return a.award[3]>b.award[3]
        end
    end)
    return awardlist
end
function MineAwardView:GetnowMineCfgAwardBuyIndex(index)
    local awardList={}
    if index==1 then
        awardList = self.nowMineCfg.reward_publicity_4
    elseif index==2 then
        awardList = self.nowMineCfg.reward_publicity_3
    elseif index==3 then
        awardList = self.nowMineCfg.reward_publicity_2
    elseif index==4 then
        awardList = self.nowMineCfg.reward_publicity_1
    end
    return self:GetSortAwardList(awardList)
end

return MineAwardView
