---@class HeroicIconDetailView : UIBaseView  下边栏菜单
---@field go_table HeroicIconDetailView_GoTable
local HeroicIconDetailView = _G.BaseClass("HeroicIconDetailView", _G.UIBaseView)
local HeroicIconModel
local iconNameBg = {
    "ImagesH5/hHeroicIcon/ui_yxsx_kp_name_zi",
    "ImagesH5/hHeroicIcon/ui_yxsx_kp_name_zi",
    "ImagesH5/hHeroicIcon/ui_yxsx_kp_name_zi",
    "ImagesH5/hHeroicIcon/ui_yxsx_kp_name_zi",
    "ImagesH5/hHeroicIcon/ui_yxsx_kp_name_cheng",
    "ImagesH5/hHeroicIcon/ui_yxsx_kp_name_hong",
    "ImagesH5/hHeroicIcon/ui_yxsx_kp_name_cai"
}

local upItem = {
    202150100, 202150200, 202150300, 202150400
}
local expCfg = _G.ConfigManager.discrete_cfg[128002]

function HeroicIconDetailView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function HeroicIconDetailView:OnCreate(data, upCall, tipsBol, args)
    self.data = data
    self.upCall = upCall
    self.tipsBol = tipsBol
    
    if _G.AppSetting.IsXzns then
        self.display = true
    end

    self.go_table.aorbtn_right:SetActiveE(0)
    self.go_table.aorbtn_left:SetActiveE(0)
    if args then
        self.dataAll = args.dataAll
        for i = 1, # self.dataAll do
            if data.id == self.dataAll[i].id then
                self.dataIndex = i
            end
        end

        if not args then
            self.dataIndex = args.index
        end
        
        if self.dataIndex ~= #self.dataAll then
            self.go_table.aorbtn_right:SetActiveE(1)
        end

        if self.dataIndex ~= 1 then
            self.go_table.aorbtn_left:SetActiveE(1)
        end
    end

    HeroicIconModel = require "HeroicIconModel":GetInstance()
    if _G.AppSetting.IsXzns then
        self.lvTable = HeroicIconModel:GetAllChangeSkillLv()
    end
    self:UpdateView()
    self.UiDic = {
        ---触发升级时间
        uplvTime = 0,
        ---升级间隔 s (防止 响应长按并响应点击 防止连点)
        uplvjg = 0.1
    }
    self.go_table.longStarCount = 3
    if not tipsBol then 
        self.totalCanUpNum = HeroicIconModel:GetTotalLevelCanUp(self.data.id)
        if _G.AppSetting.IsXzns then
            if HeroicIconModel:GetHeroicIconBySid(self.data.id) and self.totalCanUpNum > 0 then 
                local curTime = _G.TimeUtil.GetServerUnixTime()
                local value = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.HeroicIconLvUpRed, curTime - 86400)
                if _G.TimeUtil.GetDayBySix(value) ~= TimeUtil.GetDayBySix(curTime) then
                    _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.HeroicIconLvUpRed, curTime)
                    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.HeroicIconIconLvUp.id)
                end
            end
        end
    end
    _G.SetEventTrigger(self.go_table.aorbtn_up, "onDown", _G.handler(self, self.onDown_Uplv))
    _G.SetEventTrigger(self.go_table.aorbtn_up, "onLongPress", _G.handler(self, self.onLongPressS_Uplv))
    _G.SetEventTrigger(self.go_table.aorbtn_up, "onUp", _G.handler(self, self.onUp_Uplv))
    --_G.SetEventTrigger(self.go_table.aorbtn_up, "onExit", _G.handler(self, self.onUp_Uplv))
end

function HeroicIconDetailView:onDown_Uplv(go, eventData)
    if _G.AppSetting.DEBUG then
        _G.Log("按下升级按钮")
    end
    if _G.TimeUtil.GetServerUnixTime() - self.UiDic.uplvTime < self.UiDic.uplvjg then
        if _G.AppSetting.DEBUG then
            _G.Log("升级", "<color=red>" .. " onDown_Uplv == 升级按下" .. "</color>")
        end
        return
    end

    if _G.AppSetting.DEBUG then
        _G.Log("按下升级并且满足设定点击间隔时间")
    end
    ---开始长按 倒计时计数 (防止与点击重复  )
    self.go_table.longStarCount = 3
    --- 是否可以继续长按触发升级
    self.go_table.IsLongDown = true
    ---长按升级数
    self.go_table.longUpCount = 0
    self.totalCanUpNum = HeroicIconModel:GetTotalLevelCanUp(self.data.id)
end

function HeroicIconDetailView:onLongPressS_Uplv(go)
    if _G.AppSetting.DEBUG then
        _G.Log("长按触发")
    end
    if self.go_table.longStarCount > 0 then
        self.go_table.longStarCount = self.go_table.longStarCount - 1

        if _G.AppSetting.DEBUG then
            _G.Log("升级", "<color=red>" .. " onLongPressS_Uplv == 1" .. "</color>")
        end
        return
    end
    if self.go_table.IsLongDown == false then
        if _G.AppSetting.DEBUG then
            _G.Log("升级", "<color=red>" .. " onLongPressS_Uplv == 2" .. "</color>")
        end
        return
    end
    
    local num = math.min(self.nowCanUpNum, self.totalCanUpNum)
    if self.go_table.longUpCount < num then
        self.go_table.longUpCount = self.go_table.longUpCount + 1
        if _G.AppSetting.IsXzns then
            self.go_table.obj_upEff:SetActiveE(0)
            self.go_table.obj_upEff:SetActiveE(1)
        end
    else
        self.go_table.longUpCount = num
    end
    local nextLv, needLv = HeroicIconModel:GetHeroicIconSkillNextLv(self.info.level)

    if self.go_table.longUpCount >= needLv then
        self.go_table.longUpCount = needLv
    end
    self.go_table.aortext_level.text = string.format("Lv.%s", self.info.level + self.go_table.longUpCount)
end

function HeroicIconDetailView:onUp_Uplv(go)
    if _G.TimeUtil.GetServerUnixTime() - self.UiDic.uplvTime < self.UiDic.uplvjg then
        if _G.AppSetting.DEBUG then
            _G.Log("升级", "<color=red>" .. " onUp_Uplv == 升级时间检测" .. "</color>")
        end
        return
    end
    if self.go_table.IsLongDown == false then
        if _G.AppSetting.DEBUG then
            _G.Log("升级", "<color=red>" .. " onUp_Uplv == IsLongDown（是否长按）升级时间检测" .. "</color>")
        end
        return
    end
    if self.go_table.longStarCount > 0 then
        self.go_table.longStarCount = self.go_table.longStarCount - 1
        if self.totalCanUpNum < 1 then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, upItem[1])
            return
        end

        self.Power = _G.StorageManager:GetInstance():GetPlayerPower()
        local msg = {}
        msg.sid = self.data.id
        msg.consume = HeroicIconModel:GetConsumeItemByUpLevel(self.data.id, 1)
        self.lastLevel = self.info.level
        HeroicIconModel:HeroicUpLevel(msg, _G.handler(self, self.UpdateView))
    else
        if self.totalCanUpNum < 1 then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, upItem[1])
            return
        end
        self.Power = _G.StorageManager:GetInstance():GetPlayerPower()
        local msg = {}
        msg.sid = self.data.id
        msg.consume = HeroicIconModel:GetConsumeItemByUpLevel(self.data.id, math.max(self.go_table.longUpCount, 1))
        self.lastLevel = self.info.level
        HeroicIconModel:HeroicUpLevel(msg, _G.handler(self, self.UpdateView))
    end
    if _G.AppSetting.IsXzns then
        self.go_table.obj_upEff:SetActiveE(0)
        self.go_table.obj_upEff:SetActiveE(1)
    end
    self.go_table.IsLongDown = false
    self.go_table.longUpCount = 0
    self.totalCanUpNum = 0
    self.nowCanUpNum = 0
    self.UiDic.uplvTime = _G.TimeUtil.GetServerUnixTime()
end

---刷新数据
function HeroicIconDetailView:FreshData()
    -- self.heroic_icons = HeroicIconModel:GetHeroicIcons()
    -- self.sortedIconCfg = HeroicIconModel:GetSortedIconCfg()
    if not self.tipsBol then
        self.info = HeroicIconModel:GetHeroicIconBySid(self.data.id)
    end
end

function HeroicIconDetailView:UpdateView()
    if self:IsNil() then
        return
    end
    self:FreshData()
    local level = self.info and self.info.level or 1
    if self.info and  self.info.level then
        local nextLv, needLv = HeroicIconModel:GetHeroicIconSkillNextLv(self.info.level)
        if needLv > 1 then 
            self.nowCanUpNum = needLv - 1
        elseif needLv == 1 then 
            local _, newNeedLv = HeroicIconModel:GetHeroicIconSkillNextLv(self.info.level + needLv)
            if newNeedLv > 0 then 
                self.nowCanUpNum = needLv + newNeedLv - 1
            else 
                self.nowCanUpNum = needLv
            end
        end
    end
    local attrCfg, privilegeCfg = HeroicIconModel:GetHeroicIconSkill(self.data.id, level)
    local levelCfg = _G.ConfigManager.heroic_icons_level_cfg[level]
    local nextLevelCfg = _G.ConfigManager.heroic_icons_level_cfg[level + 1]
    self.go_table.aortext_skill1.text = _G.GetLangPackValue(attrCfg[1].describe)
    if attrCfg[2] then
        self.go_table.aortext_skill2.text = _G.GetLangPackValue(attrCfg[2].describe)
    else
        self.go_table.aortext_skill2.text = _G.GetLangPackValue(privilegeCfg.desc)
    end
    self.go_table.aortext_attr1.text = _G.GameUtil.NumberToUnitStr(_G.Mathf.RoundToInt(self.data.atk * levelCfg.att_growth / 10000))
    self.go_table.aortext_attr2.text = _G.GameUtil.NumberToUnitStr(_G.Mathf.RoundToInt(self.data.bre * levelCfg.att_growth / 10000))
    self.go_table.aortext_attr3.text = _G.GameUtil.NumberToUnitStr(_G.Mathf.RoundToInt(self.data.def * levelCfg.att_growth / 10000))
    self.go_table.aortext_attr4.text = _G.GameUtil.NumberToUnitStr(_G.Mathf.RoundToInt(self.data.max_hp * levelCfg.att_growth /
        10000))
    if self.info then
        local maxBol = HeroicIconModel:CheckIconMaxLevel(self.data.id)
        self.go_table.aortext_level.text = string.format("Lv.%s", self.info.level)
        self.go_table.aortext_unlock:SetActiveE(0)
        if not _G.AppSetting.IsXzns then
            self.go_table.obj_funUnlock:SetActiveE(0)
        end
        if maxBol then
            self.go_table.aortext_exp.text = "max"
            self.go_table.aortext_nextLv:SetActiveE(0)
            self.go_table.obj_up:SetActiveE(0)
            self.go_table.slider_progress.value = 1
            if _G.AppSetting.IsXzns then
                self.go_table.aortext_condition.text = ""
            end
        else
            local nextLv, needLv = HeroicIconModel:GetHeroicIconSkillNextLv(self.info.level)
            self:FreshUpObj()
            self.go_table.slider_progress.value = self.info.exp / (nextLevelCfg.exp - levelCfg.exp)
            self.go_table.aortext_exp.text = string.format("<color=#c02214>%s</color>/%s<color=#0FBE3C>(+%s)</color>",
                self.info.exp, (nextLevelCfg.exp - levelCfg.exp), expCfg[self.nowItemIndex][2])
            self.go_table.aortext_nextLv:SetActiveE(1)
            self.go_table.obj_up:SetActiveE(1)
            if _G.AppSetting.IsXzns then
                for _, v in pairs(self.lvTable) do
                    if v > self.info.level then
                        if _G.AppSetting.IsXzns then
                            self.go_table.aortext_condition.text = _G.GetLangPackValue(90000012094,v - self.info.level)
                        else
                            self.go_table.aortext_condition.text = _G.GetLangPackValue(90036000001,v - self.info.level)
                        end
                        break
                    end
                end
            end

            if needLv ~= 0 then
                self.go_table.aortext_nextLv.text = _G.GetLangPackValue(90036000001, needLv)
                if attrCfg[1].subtitle and attrCfg[1].subtitle ~= 0 then
                    self.go_table.aortext_skill1.text = string.format("%s(%s)", self.go_table.aortext_skill1.text,
                        _G.GetLangPackValue(attrCfg[1].subtitle))
                end
                if attrCfg[2] then
                    if attrCfg[2].subtitle and attrCfg[2].subtitle ~= 0 then
                        self.go_table.aortext_skill2.text = string.format("%s(%s)", self.go_table.aortext_skill2.text,
                            _G.GetLangPackValue(attrCfg[2].subtitle))
                    end
                else
                    if privilegeCfg.desc1 and privilegeCfg.desc1 ~= 0 then
                        self.go_table.aortext_skill2.text = string.format("%s(%s)", self.go_table.aortext_skill2.text,
                            _G.GetLangPackValue(privilegeCfg.desc1))
                    end
                end
            else
                self.go_table.aortext_nextLv:SetActiveE(0)
            end
        end
    else
        if _G.AppSetting.IsXzns then
            local str, taskInfo
            if self.data.open_conditions[1] then
                taskInfo = HeroicIconModel:GetTaskByTaskid(self.data.open_conditions[1][1])
                local count, target = taskInfo:GetCount()
                str = string.format("<color=red>(%d/%d)</color>", target, count)
            end
            self.go_table.aortext_unlock.text = self.data.open_conditions[1] and
                (_G.GetLangPackValue(taskInfo.Cfg.desc) .. str) or ""
            self.go_table.aortext_unlock:SetActiveE(1)
        else
            if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.HeroicIcon) then
                self.go_table.aortext_unlock:SetActiveE(1)
                self.go_table.obj_funUnlock:SetActiveE(0)
                local str, taskInfo
                if self.data.open_conditions[1] then
                    taskInfo = HeroicIconModel:GetTaskByTaskid(self.data.open_conditions[1][1])
                    local count, target = taskInfo:GetCount()
                    str = string.format("<color=red>(%d/%d)</color>", target, count)
                end
                self.go_table.aortext_unlock.text = self.data.open_conditions[1] and
                    (_G.GetLangPackValue(taskInfo.Cfg.desc) .. str) or ""
            else
                self.go_table.aortext_unlock:SetActiveE(0)
                self.go_table.obj_funUnlock:SetActiveE(1)
                local cfg =  _G.ConfigManager.function_open_cfg[_G.FunctionID.HeroicIcon]
                if cfg.condition_type[1][1] == _G.FunctionTouchType.ServerTime then
                    local day = cfg.condition_type[1][2]
                    local delta = (day - 1) * 86400 - (_G.TimeUtil.GetServerUnixTime() - _G.PlayerModel:GetInstance().open_time)
                    self.go_table.aortext_funUnlockTip1.text = _G.GetLangPackValue(90036000566, day)
                    self.go_table.aortext_funUnlockTip2.text = _G.GetLangPackValue(90036000567, _G.TimeUtil.TranslateDayForStr(delta))
                else 
                    --容错
                    local content = _G.FunctionManager:GetInstance():GetTipsStr(_G.FunctionID.HeroicIcon)
                    self.go_table.aortext_funUnlockTip1.text = ""
                    self.go_table.aortext_funUnlockTip2.text = content
                end
            end
        end
        self.go_table.aortext_level.text = "Lv.1"
        self.go_table.aortext_nextLv:SetActiveE(0)
        self.go_table.slider_progress.value = 0
        self.go_table.aortext_exp.text = string.format("<color=#c02214>%s</color>/%s", 0,
            (nextLevelCfg.exp - levelCfg.exp))
        self.go_table.aortext_nextLv:SetActiveE(0)
        self.go_table.obj_up:SetActiveE(0)
    end

    self.go_table.obj_lock:SetActiveE(not self.info and 1 or 0)
    self.go_table.obj_unlock:SetActiveE(self.info and 1 or 0)
    self.go_table.aortext_name.text = _G.GetLangPackValue(self.data.name)
    if not _G.AppSetting.IsXzns then
        self.go_table.aorrawimage_bg:LoadImage(
            iconNameBg[self.data.grade],
            function(tran)
                if self:IsNil() then
                    tran:DestroyObject()
                    return
                end
                tran:SetNativeSize()
            end
        )
    end
    if _G.AppSetting.IsXzns then
        if _G.string.IsNullOrEmpty(self.data.spine_image) then
            self.go_table.obj_spine:SetActiveE(0)
            self.go_table.aorrawimage_icon:SetActiveE(1)
            self.go_table.aorrawimage_icon:LoadImage(
                self.data.hero_image,
                function(tran)
                    if self:IsNil() then
                        tran:DestroyObject()
                        return
                    end
                    tran:SetNativeSize()
                end
            )
        else
            self.go_table.obj_spine:ClearChildren()
            self.go_table.obj_spine:SetActiveE(1)
            self.go_table.aorrawimage_icon:SetActiveE(0)
            _G.PoolsManager:GetInstance():Spawn(
                self.data.spine_image,
                _G.ePoolType.Temporary,
                self.go_table.obj_spine,
                function (obj)
                    if self:IsNil() then
                        _G.PoolsManager:GetInstance():Despawn(obj,_G.ePoolType.Temporary)
                        return
                    end
                    _G.GameUtil.SetCardUiSpineAnimation(obj, "idle", true)
                end
            )
        end
    else
        self.go_table.aorrawimage_icon:LoadImage(
            self.data.hero_image,
            function(tran)
                if self:IsNil() then
                    tran:DestroyObject()
                    return
                end
                tran:SetNativeSize()
            end
        )
    end
    if self.Power then
        self:ShowPowerUp()
    end

    if self.lastLevel then
        local nextLv = HeroicIconModel:GetHeroicIconSkillNextLv(self.lastLevel)

        if self.info.level >= nextLv then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.HeroicIconStarUpView.Name, self.info.sid)
        end
    end
    if _G.AppSetting.IsXzns then
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.HeroicIconMineTeamLevelSG.id)
    end
end

function HeroicIconDetailView:ShowPowerUp()
    ---临时等级提升不显示战力变化
    _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.HeroicIcon)
    local newPower = _G.StorageManager:GetInstance():GetPlayerPower()
    local offset = newPower - self.Power
    if offset > 0 then
        require "CommonTipManager".OpenPowerUpView(self.Power, offset)
    end
    self.Power = newPower
end

function HeroicIconDetailView:FreshUpObj()
    local tempIndex
    local index = self.nowItemIndex
    self.nowItemIndex = nil
    for i = 1, 4 do
        self.go_table["obj_item" .. i]:ClearChildren()
        local _, storageId = _G.StorageManager:GetInstance():CheckSidType(upItem[i])
        local count = _G.StorageManager:GetInstance():GetItemCountByID(storageId, upItem[i])
        if count > 0 and not tempIndex then
            tempIndex = i
        end
        if index and index == i and count > 0 then
            self.nowItemIndex = i
        end
        _G.StorageManager:GetInstance():GetItemBaseView(
            upItem[i],
            count,
            self.go_table["obj_item" .. i],
            function(item)
                if _G.IsNil(self.go_table) then
                    _G.DestroyObject(item.go_table.gameObject)
                    return
                end
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
        )
    end
    tempIndex = tempIndex and tempIndex or 1
    self.nowItemIndex = self.nowItemIndex or tempIndex
    for i = 1, 4 do
        self.go_table["obj_itemChoose" .. i]:SetActiveE(self.nowItemIndex == i and 1 or 0)
    end
end

---按钮点击事件在这里派发
function HeroicIconDetailView:OnClickBtn(go, isOn)
    for i = 1, 4 do
        if go == self.go_table["aorbtn_item" .. i] then
            self.nowItemIndex = i
            local level = self.info and self.info.level or 1
            local levelCfg = _G.ConfigManager.heroic_icons_level_cfg[level]
            local nextLevelCfg = _G.ConfigManager.heroic_icons_level_cfg[level + 1]
            local maxBol = HeroicIconModel:CheckIconMaxLevel(self.data.id)
            if not maxBol then
                self.go_table.aortext_exp.text = string.format(
                    "<color=#c02214>%s</color>/%s<color=#0FBE3C>(+%s)</color>", self.info.exp,
                    (nextLevelCfg.exp - levelCfg.exp), expCfg[self.nowItemIndex][2])
            end
            for j = 1, 4 do
                self.go_table["obj_itemChoose" .. j]:SetActiveE(self.nowItemIndex == j and 1 or 0)
            end
            return
        end
    end
    if go == self.go_table.aorbtn_close then
        self:Close()
        local upBol = HeroicIconModel:GetUpLvBol()
        if upBol and self.upCall then
            self.upCall()
        end
        HeroicIconModel:SetUpLvBol(false)
    elseif go == self.go_table.aorbtn_useItem then
        if self.nowItemIndex then
            local _, storageId = _G.StorageManager:GetInstance():CheckSidType(upItem[self.nowItemIndex])
            local count = _G.StorageManager:GetInstance():GetItemCountByID(storageId, upItem[self.nowItemIndex])
            if count > 0 then
                self.Power = _G.StorageManager:GetInstance():GetPlayerPower()
                local msg = {}
                msg.sid = self.data.id
                msg.consume = { { k = upItem[self.nowItemIndex], v = 1 } }
                self.lastLevel = self.info.level
                HeroicIconModel:HeroicUpLevel(msg, _G.handler(self, self.UpdateView))
                if _G.AppSetting.IsXzns then
                    self.go_table.obj_upEff:SetActiveE(0)
                    self.go_table.obj_upEff:SetActiveE(1)
                end
            else
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name,
                    upItem[self.nowItemIndex])
            end
        end
    elseif go == self.go_table.aorbtn_tips then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.HeroicIconPreView.Name, self.data,
            self.info and self.info.level or 1)
        -- elseif go == self.go_table.aorbtn_up then
        --     if HeroicIconModel:GetTotalLevelCanUp(self.data.id) < 1 then
        --         _G.PopWindowManager:GetInstance():ShowAllTips(1002) --to do
        --         return
        --     end
        --     local msg = {}
        --     msg.sid = self.data.id
        --     msg.consume = HeroicIconModel:GetConsumeItemByUpLevel(self.data.id, 1)
        --     HeroicIconModel:HeroicUpLevel(msg, _G.handler(self, self.UpdateView))
    elseif go == self.go_table.aorbtn_right then
        if self.dataIndex + 1 <= #self.dataAll then
            self.data = self.dataAll[self.dataIndex + 1]
            self.dataIndex = self.dataIndex + 1
            self:UpdateView()
        end
        self.go_table.aorbtn_right:SetActiveE(self.dataIndex == #self.dataAll and 0 or 1)
        self.go_table.aorbtn_left:SetActiveE(self.dataIndex == 1 and 0 or 1)
    elseif go == self.go_table.aorbtn_left then
        if self.dataIndex - 1 > 0 then
            self.data = self.dataAll[self.dataIndex - 1]
            self.dataIndex = self.dataIndex - 1
            self:UpdateView()
        end
        self.go_table.aorbtn_right:SetActiveE(self.dataIndex == #self.dataAll and 0 or 1)
        self.go_table.aorbtn_left:SetActiveE(self.dataIndex == 1 and 0 or 1)
    elseif go == self.go_table.aorbtn_display then
        self.display = not self.display
        if _G.AppSetting.IsXzns then
            -- self.go_table.obj_display:SetActiveE(self.display and 1 or 0)
            self.go_table.aorimage_display.SpriteName = self.display and "ui_ycns_icon_yc" or "ui_ycns_icon_wyc"
        end
    elseif go == self.go_table.aorbtn_AttrDetail then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TeamHallAttrHeroicPanel.Name)
    end
end

function HeroicIconDetailView:OnDestroy()
    self:RemoveAllListener()
end

return HeroicIconDetailView
