---监听Toggle点击事件
---@param key string
---@param callback function
function HeroicIconToggleView:OnClickToggle(_, isOn, key, callback)
    local tb = self.toggles[key]
    local view = self.views[key]
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    self.curToggle = key

    --节点显隐
    if view and view ~= 0 then
        view.gameObject:SetActiveE(isOn and 1 or 0)
    end

    if isOn and callback then
        callback()
    end
end

function HeroicIconToggleView:OnHeroicIcon()
    local view
    if _G.AppSetting.IsXzns then
        view = self.views.heroic
    else
        view = self.views.heroicIcon
    end
    if not view then
        if _G.AppSetting.IsXzns then
            self.views.heroic = 0
        else
            self.views.heroicIcon = 0
        end
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.HeroicIconView.Name)
    elseif view ~= 0 then
        view:UpdateView()
    end
end

function HeroicIconToggleView:OnMine()
    local view = self.views.mine
    if not view then
        self.views.mine = 0
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
        --_G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.RelicTeamView.Name)
        if _G.AppSetting.IsXzns then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.HeroicMineViewSG.Name)
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.HeroicMineView.Name)
        end
    elseif view ~= 0 then
        view:UpdateView()
    end
end

---加载界面
function HeroicIconToggleView:OnUIOpened(name)
    local UIname
    if _G.AppSetting.IsXzns then
        UIname = _G.ConfigManager.ui_cfg.HeroicMineViewSG.Name
    else
        UIname = _G.ConfigManager.ui_cfg.HeroicMineView.Name
    end
    ---@type string
    local key
    if name == _G.ConfigManager.ui_cfg.HeroicIconView.Name then
        if _G.AppSetting.IsXzns then
            key = "heroic"  
        else
            key = "heroicIcon"  
        end
    elseif name == UIname then
        key = "mine"
    end
    if not key then 
        return
    end
    self:RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)

    local view = _G.UIManager:GetInstance():GetWindowCtrl(name)
    if self:IsNil() then
        view:Close()
        return
    end
    view.transform:SetParentE(self.go_table.obj_view)
    _G.UIManager:GetInstance():ChangeCanvasOrder(
        name,
        self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 1
    )
    self.views[key] = view
    if self.curToggle ~= key then
        view:Hide()
    end
end

---按钮点击事件在这里派发
function HeroicIconToggleView:Close()
    self.super.Close(self)
    --关闭内嵌页面
    if self.views then
        for _, view in pairs(self.views) do
            if type(view) ~= "number" then 
                view:Close()
            end
        end
        self.views = nil
    end
end

---按钮点击事件在这里派发
function HeroicIconToggleView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end

return HeroicIconToggleView
