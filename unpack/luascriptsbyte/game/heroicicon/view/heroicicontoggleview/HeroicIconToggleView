---@class HeroicIconToggleView : UIBaseView  下边栏菜单
---@field go_table RelicTeamToggleView_GoTable
---@field toggles table<string,HeroicIconToggleView._toggle_reset_GoTable> 切换按钮
---@field curToggle string  @当前选中的界面
---@field views table<string, number|Component|UIBaseView> @界面实例
local HeroicIconToggleView = _G.BaseClass("HeroicIconToggleView", _G.UIBaseView)
local RelicTeamModel
local keyName = {
    [1] = "heroicIcon", 
    [2] = "mine",
}

function HeroicIconToggleView:Awake()
    if _G.AppSetting.IsXzns then
        keyName[1] = "heroic"
    end
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function HeroicIconToggleView:UpdateView()
    if self.views then
        for _, view in pairs(self.views) do
            if view ~= 0 and view.gameObject:GetActiveSelf() == 1 and view.UpdateView then 
                view:UpdateView()
            end 
        end
    end
end

---界面的入口函数
---@param toggleIndex number|string|nil 切换界面的索引
function HeroicIconToggleView:OnCreate(toggleIndex)
    self:InitToggles()
    self:InitTogglesFunctionUnlock()
    ---@type string
    local key
    if type(toggleIndex) == "string" then
        key = toggleIndex
    elseif type(toggleIndex) == "number" then
        key = keyName[toggleIndex]
    end
    key = key or self:GetDefaultToggleKey()
    local tog = self.go_table["toggle_" .. key]
    if not tog then
        tog = _G.AppSetting.IsXzns and self.go_table.toggle_heroic or self.go_table.toggle_heroicIcon
    end
    if tog then
        tog.isOn = false
        tog.isOn = true
    end
end

function HeroicIconToggleView:SwitchToggle(toggleName)
    if self.curToggle ~= toggleName then 
        local tog = self.go_table["toggle_" .. toggleName]
        if tog then
            tog.isOn = false
            tog.isOn = true
        end
    end
end

function HeroicIconToggleView:OnDestroy()
    self:RemoveAllListener()
    self.views = nil 
end

---根据功能获取当前可打开的toggle节点
function HeroicIconToggleView:GetDefaultToggleKey()
    if _G.AppSetting.IsXzns then
        return "heroic"
    else
        return "heroicIcon"
    end
end

function HeroicIconToggleView:InitToggles()
    self.views = {}
    self.toggles = {
        mine = _G.GetAutoGoTable(
            self.go_table.toggle_mine,
            _G.handlerbind(self, self.OnClickToggle, "mine", _G.handler(self, self.OnMine))
        ),
    }
    if _G.AppSetting.IsXzns then
        self.toggles.heroic = _G.GetAutoGoTable(
            self.go_table.toggle_heroic,
            _G.handlerbind(self, self.OnClickToggle, "heroic", _G.handler(self, self.OnHeroicIcon))
        )
    else
        self.toggles.heroicIcon = _G.GetAutoGoTable(
            self.go_table.toggle_heroicIcon,
            _G.handlerbind(self, self.OnClickToggle, "heroicIcon", _G.handler(self, self.OnHeroicIcon))
        )
    end
end

