---@class HeroicIconBuild : UIBaseView	中文描述
---@field public go_table HeroicIconBuild_GoTable GoTable
local HeroicIconBuild = _G.BaseClass("HeroicIconBuild", _G.UIBaseView)

function HeroicIconBuild:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function HeroicIconBuild:OnCreate(ruin, call)
    ---@type HeroicMineModelSg
    self.model = require("HeroicMineModelSg"):GetInstance()
    self.ruin = ruin
    self.call = call
    self.restore = self.model:GetRestore()
    self.go_table.aorrawimage_Icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(ruin.showAward.type[1]),
        function(trans)
            if self:IsNil() or not trans then
                return
            end
            trans:SetNativeSize()
        end)
    self.go_table.aortext_name.text = _G.GetLangPackValue(90025500012, ruin.level) ..
        _G.StorageManager:GetInstance():GetItemName(ruin.showAward.type[1])
    for _, v in pairs(ruin.award) do
        if v.type[1] ~= 88 then
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                { v.type[1], v.type[2] },
                self.go_table.obj_content,
                function(trans)
                    if self:IsNil() then
                        return
                    end
                    trans:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                end
            )
        end
    end
    local temp = require("PrivilegeManager"):GetInstance():GetPrivilegeDataNew({ _G.PrivilegeType.Heroic.ruinTime })
    self.ruinTimePrivilege = 0
    for _, v in pairs(temp) do
        self.ruinTimePrivilege = self.ruinTimePrivilege + v[2]
    end

    self.teamNum = self.model:GetTeamNum()
    self.useTeamNum = #self.model:GetStartRuinList()
    if _G.AppSetting.IsXzns then
        self.go_table.aortext_teamNum.text = _G.GetLangPackValue(90036000612, self.teamNum - self.useTeamNum) .. "\n" .. _G.GetLangPackValue(90036000613, self.teamNum)
    else
        self.go_table.aortext_teamNum.text = _G.GetLangPackValue(92010700028, self.teamNum - self.useTeamNum, self.teamNum)
    end

    if ruin.overTime > _G.TimeUtil.GetServerUnixTime() then
        self.go_table.aorbtn_tansuo:SetActiveE(0)
        self.RST = ruin.overTime - _G.TimeUtil.GetServerUnixTime()
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.timer:Start()
        self:UpdateTime(0)
    else
        local cfg = _G.ConfigManager.heroic_icons_ruins_cfg[ruin.level]
        local langid = _G.AppSetting.IsXzns and 90000012093 or 92010700029
        self.go_table.aortext_time.text = _G.GetLangPackValue(langid,
            _G.TimeUtil.TranslateSecondForStrMiaoHui(_G.math.floor(cfg.time * (1 - self.ruinTimePrivilege / 10000))))
        self.go_table.aorbtn_tansuo:SetActiveE(1)
    end
end

function HeroicIconBuild:UpdateTime(elapsed)
    self.RST = self.RST - elapsed
    if self.RST <= 0 then
        self.timer:Stop()
        self.timer = nil
        self:Close()
        return
    end
    local langid = _G.AppSetting.IsXzns and 90000012093 or 92010700029
    self.go_table.aortext_time.text = _G.GetLangPackValue(langid, _G.TimeUtil.TranslateSecondForStrMiaoHui(self.RST))
end

---界面的销毁函数
function HeroicIconBuild:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---按钮点击事件在这里派发
function HeroicIconBuild:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_tansuo then
        if self.useTeamNum < self.teamNum then
            if self.restore > 0 then
                require("HeroicMineModelSg"):GetInstance():RuinStart(self.ruin.sid, function()
                    _G.PopWindowManager:GetInstance():ShowAllTips(1250014)
                    if self.call then
                        self.call()
                    end
                    self:Close()
                end)
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(1250006)
            end
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(1250007)
        end
    end
end

return HeroicIconBuild
