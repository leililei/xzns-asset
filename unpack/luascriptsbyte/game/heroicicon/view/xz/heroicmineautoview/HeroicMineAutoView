---@class HeroicMineAutoView : UIBaseView	中文描述
---@field public go_table HeroicMineAutoView_GoTable GoTable
local HeroicMineAutoView = _G.BaseClass("HeroicMineAutoView", _G.UIBaseView)

local HeroicMineAutoAwardLevel = "HeroicMineAutoAwardLevel"
local HeroicMineAutoAward = "HeroicMineAutoAward"

function HeroicMineAutoView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function HeroicMineAutoView:OnCreate(autoCall)
    self.minNum = _G.ConfigManager.discrete_cfg[304009][1][1]
    self.autoCall = autoCall
    self.selectLevel = _G.PlayerPrefsManager.GetTable(HeroicMineAutoAwardLevel, false) or {}
    self.selectAward = _G.PlayerPrefsManager.GetTable(HeroicMineAutoAward, false) or {}

    self.showAwardList = {}
    for k, v in pairs(_G.ConfigManager.heroic_icons_ruins_cfg) do
        if k ~= 5 then
            for _, id in pairs(v.drop) do
                local awards = _G.ConfigManager.drop_cfg[id].content1
                for _, award in pairs(awards) do
                    if not self.showAwardList[award[1]] then
                        self.showAwardList[award[1]] = {}
                    end
                    self.showAwardList[award[1]][k] = award
                end
            end
        end
    end

    self.showDataList = {}
    for k, v in pairs(self.showAwardList) do
        _G.table.insert(self.showDataList, { sid = k, level = v })
    end

    self.selectNum = #self.showDataList
    _G.table.walk(
        self.showDataList,
        function(k, v)
            if self.selectAward[v.sid] == false then
                self.selectNum = self.selectNum - 1
            end
        end
    )

    self.go_table.scrollloopvectical_item:InitItemData(#self.showDataList, _G.handler(self, self.RefreshItem))
    local teamLevel = require("HeroicMineModelSg"):GetInstance():GetLevel()
    if teamLevel < 4 then
        self.go_table.aorbtn_auto:SetGray(true)
        self.go_table.aorbtn_auto.interactable = false
    else
        self.go_table.aortext_tip:SetActiveE(0)
    end
end

function HeroicMineAutoView:RefreshItem(index, obj)
    index = index + 1
    local data = self.showDataList[index]
    local level = self:GetAwardLevel(data.sid)
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnItemClick, data))
    tb.aortext_name.text = _G.StorageManager:GetInstance():GetItemName(data.sid)
    tb.aortext_level.text = _G.GetLangPackValue(9002010022, level)
    tb.toggle_select:SetIsOnWithoutNotify(self.selectAward[data.sid] ~= false)
    tb.aorbtn_plus:SetGray(level == 4 and true or false)
    tb.aorbtn_sub:SetGray(level == 1 and true or false)

    if not tb.item then
        tb.item = true
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemBaseWithCount,
            tb.obj_root,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                tb.item = trans
                trans:Show(data.level[level][1], nil, data.level[level][2])
            end
        )
    elseif tb.item ~= true then
        tb.item:Show(data.level[level][1], nil, data.level[level][2])
    end
end

function HeroicMineAutoView:OnItemClick(go, isOn, data)
    local name = go:GetName()
    if name == "@_aorbtn_plus" then
        self:SetAwardLevel(data.sid, self:GetAwardLevel(data.sid) + 1)
        self.go_table.scrollloopvectical_item:UpdateAllItem()
    elseif name == "@_aorbtn_sub" then
        self:SetAwardLevel(data.sid, self:GetAwardLevel(data.sid) - 1)
        self.go_table.scrollloopvectical_item:UpdateAllItem()
    elseif name == "$_toggle_select" then
        if not isOn then
            if self.selectNum <= self.minNum then
                go:SetIsOnWithoutNotify(true)
                _G.PopWindowManager:GetInstance():ShowAllTips(1250011)
                return
            end
        end
        local change
        if isOn and self.selectAward[data.sid] == false then
            change = true
            self.selectNum = self.selectNum + 1
        elseif not isOn and self.selectAward[data.sid] ~= false then
            change = true
            self.selectNum = self.selectNum - 1
        end
        if change then
            self.selectAward[data.sid] = isOn
            _G.PlayerPrefsManager.SetTable(HeroicMineAutoAward, self.selectAward)
        end
    end
end

function HeroicMineAutoView:GetAwardLevel(sid)
    local outLevel = self.selectLevel[sid]
    if outLevel then
        return outLevel
    else
        outLevel = 3
    end
    local tempLevel
    if self.showAwardList[sid] then
        for k, v in pairs(self.showAwardList[sid]) do
            tempLevel = k
            if k == outLevel then
                break
            end
        end
        outLevel = tempLevel
    else
        return 1
    end
    return outLevel
end

function HeroicMineAutoView:SetAwardLevel(sid, level)
    if self.showAwardList[sid] then
        for k, _ in pairs(self.showAwardList[sid]) do
            if k == level then
                self.selectLevel[sid] = level
                _G.PlayerPrefsManager.SetTable(HeroicMineAutoAwardLevel, self.selectLevel)
                return
            end
        end
    end
end

---按钮点击事件在这里派发
function HeroicMineAutoView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_tip then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 219)
    elseif go == self.go_table.aorbtn_auto then
        ---@type HeroicMineModelSg
        local model = require("HeroicMineModelSg"):GetInstance()
        local team = model:GetTeamNum() - #model:GetStartRuinList()
        local restore = model:GetRestore()
        local ruins = model:GetRuinDataList()
        if team <= 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(1250010)
            return
        end
        if restore <= 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(1250009)
            return
        end
        self:Auto(team, restore, ruins, { diamondTime = 0, diamondCount = 0 }, function()
            if self.autoCall then
                self.autoCall()
            end
            self:Close()
        end)
    end
end

function HeroicMineAutoView:Auto(team, restore, ruins, refreshData, call)
    if team <= 0 or restore <= 0 then
        if refreshData.diamondTime > 0 then
            local content = _G.GetLangPackValue(_G.ConfigManager.tips_system_cfg[1250008].content,
                refreshData.diamondTime, refreshData.diamondCount)
            _G.PopWindowManager:GetInstance():ShowAllTips(1250008, content)
        end
        if call then
            call()
        end
        return
    end
    -- 提前遍历一遍，优先派遣5级
    for k, v in pairs(ruins) do
        if v.ruinState == require("RuinData").RuinState.Free and v.level == 5 then
            require("HeroicMineModelSg"):GetInstance():RuinStart(v.sid, function()
                team = team - 1
                restore = restore - 1
                self:Auto(team, restore, ruins, refreshData, call)
            end)
            return
        end
    end

    local isFree = false
    for _, v in pairs(ruins) do
        if v.ruinState == require("RuinData").RuinState.Free then
            isFree = true
            if self.selectAward[v.showAward.type[1]] ~= false and (self.selectLevel[v.showAward.type[1]] or 3) <= v.level then
                require("HeroicMineModelSg"):GetInstance():RuinStart(v.sid, function()
                    team = team - 1
                    restore = restore - 1
                    self:Auto(team, restore, ruins, refreshData, call)
                end)
                return
            end
        end
    end
    if isFree then
        local items = _G.ConfigManager.discrete_cfg[304008][1]
        local freeCount = require("HeroicMineModelSg"):GetInstance():GetFreeRefeashNum()
        if freeCount > 0 or _G.StorageManager:GetInstance():CheckItem(items[1], items[2]) then
            require("HeroicMineModelSg"):GetInstance():RefreashRuin(function()
                refreshData.diamondTime = refreshData.diamondTime + 1
                if freeCount <= 0 then
                    refreshData.diamondCount = refreshData.diamondCount + items[2]
                end
                local model = require("HeroicMineModelSg"):GetInstance()
                local team = model:GetTeamNum() - #model:GetStartRuinList()
                local restore = model:GetRestore()
                local ruins = model:GetRuinDataList()
                self:Auto(team, restore, ruins, refreshData, call)
            end)
        else
            -- 钻石不足
            _G.PopWindowManager:GetInstance():ShowAllTips(230303)
            if call then
                call()
            end
        end
    else
        if call then
            call()
        end
    end
end

return HeroicMineAutoView
