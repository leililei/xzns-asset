---@class HeroicIconTeamLevel : UIBaseView	中文描述
---@field public go_table HeroicIconTeamLevel_GoTable GoTable
local HeroicIconTeamLevel = _G.BaseClass("HeroicIconTeamLevel", _G.UIBaseView)

function HeroicIconTeamLevel:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.AddViewBtnClick(self.go_table.obj_score, _G.handler(self, self.OnScoreClick))
    self.go_table.obj_score:SetActiveE(0)
end

---界面的入口函数
function HeroicIconTeamLevel:OnCreate()
    ---@type HeroicMineModelSg
    self.model = require("HeroicMineModelSg"):GetInstance()
    self.maxLevel = self.model:GetMaxLevel()
    local temp = require("PrivilegeManager"):GetInstance():GetPrivilegeDataNew({ _G.PrivilegeType.Heroic.ruinTime })
    self.ruinTimePrivilege = 0
    for _, v in pairs(temp) do
        self.ruinTimePrivilege = self.ruinTimePrivilege + v[2]
    end

    local tb = _G.GetAutoGoTable(self.go_table.obj_score)
    for _, v in pairs(_G.ConfigManager.heroic_icons_ruins_cfg) do
        tb["aortext_des" .. v.id].text = _G.GetLangPackValue(92010700040, v.id, v.exp)
    end
    _G.SetEventTrigger(self.go_table.aorbtn_tips,"onDrag",_G.handler(self, self.OnDrag))
    self:UpdateView()
end

function HeroicIconTeamLevel:OnDrag(_,data)
    _G.LogError(data)
    local pos = data.position
    self.go_table.aorbtn_tips:SetPosition(pos.x,pos.y)
end

function HeroicIconTeamLevel:UpdateView()
    self.level = self.model:GetLevel()
    local num = self.model:GetMaxAwardRefreshNum()
    local cfg = _G.ConfigManager.heroic_icons_team_cfg[self.level]
    if _G.AppSetting.IsXzns then
        self.go_table.aortext_times.text = _G.GetLangPackValue(90000012098, cfg.re_new[5][3] - num, cfg.re_new[5][3])
    else
        self.go_table.aortext_times.text = _G.GetLangPackValue(92010700022, cfg.re_new[5][3] - num, cfg.re_new[5][3])
    end

    self.go_table.aortext_nowLevel.text = _G.GetLangPackValue(90033901008) .. _G.GetLangPackValue(9002010022, self.level)
    local cfg = _G.ConfigManager.heroic_icons_team_cfg[self.level]
    local sum = 0
    for _, v in pairs(cfg.re_new) do
        sum = sum + v[2]
    end
    for _, v in pairs(cfg.re_new) do
        self.go_table["aortext_per" .. v[1] .. 1].text = _G.string.format("%.2f", v[2] / sum * 100) .. "%"
        if _G.AppSetting.IsXzns then
            self.go_table["aortext_level" .. v[1]].text = _G.GetLangPackValue(90000012096, v[1])
        else
            self.go_table["aortext_level" .. v[1]].text = _G.GetLangPackValue(92010700030, v[1])
        end
    end

    if self.level >= self.maxLevel then
        self.go_table.aortext_nextLevel:SetActiveE(0)
        self.go_table.aortext_per12:SetActiveE(0)
        self.go_table.aortext_per22:SetActiveE(0)
        self.go_table.aortext_per32:SetActiveE(0)
        self.go_table.aortext_per42:SetActiveE(0)
        self.go_table.aortext_per52:SetActiveE(0)
        self.go_table.obj_up:SetActiveE(0)
    else
        self.go_table.aortext_nextLevel.text = _G.GetLangPackValue(90033901009) ..
            _G.GetLangPackValue(9002010022, self.level + 1)
        cfg = _G.ConfigManager.heroic_icons_team_cfg[self.level + 1]
        sum = 0
        for _, v in pairs(cfg.re_new) do
            sum = sum + v[2]
        end
        for _, v in pairs(cfg.re_new) do
            self.go_table["aortext_per" .. v[1] .. 2].text = _G.string.format("%.2f", v[2] / sum * 100) .. "%"
        end
        local nextCfg = _G.ConfigManager.heroic_icons_team_cfg[self.level + 1]
        if _G.AppSetting.IsXzns then
            local count = require("HeroicIconModel"):GetInstance():GetIconTotalLevel()
            local str = count < nextCfg.exp and _G.string.format("<color=#ac4e39>%s</color>", count) or count
            self.go_table.aortext_score.text = _G.GetLangPackValue(90000012099, str, nextCfg.exp)
            self.go_table.aorbtn_upgrade:SetGray(count < nextCfg.exp)
        else
            local count = _G.StorageManager:GetInstance():GetItemCountBySid(nextCfg.exp[1])
            self.go_table.aortext_score.text = _G.GetLangPackValue(92010700023, count, nextCfg.exp[2])
            self.go_table.aorbtn_upgrade:SetGray(count < nextCfg.exp[2])
        end
        self.endTime = self.model:GetUpLevelEndTime()
    end


    self.go_table.obj_content:ClearChildren()
    for k, v in pairs(_G.ConfigManager.heroic_icons_ruins_cfg[5].show) do
        local item = _G.InstantiateObject(self.go_table.obj_award, self.go_table.obj_content)
        local tb = _G.GetAutoGoTable(item)
        if self.level >= k then
            tb.aortext_conditon.text = _G.GetLangPackValue(90026500035)
            tb.aortext_conditon.color = _G.ColorTools.FormatColorByString("116427")
        else
            tb.aortext_conditon.text = _G.GetLangPackValue(90033405007, k)
            tb.aortext_conditon.color = _G.ColorTools.FormatColorByString("c64238")
        end
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            { v, 1 },
            tb.obj_root,
            function(trans)
                if self:IsNil() then
                    return
                end
            end
        )
    end
end

---按钮点击事件在这里派发
function HeroicIconTeamLevel:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_upgrade then
        local cfg = _G.ConfigManager.heroic_icons_team_cfg[self.level]
        if _G.AppSetting.IsXzns then
            require("HeroicMineModelSg"):GetInstance():UpLevel_xz(
                function(msg)
                    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                    self:UpdateView()
                end
            )
        else
            if _G.StorageManager:GetInstance():CheckItem(88, cfg.exp) then
                require("HeroicMineModelSg"):GetInstance():UpLevel(
                    function(msg)
                        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                        self:UpdateView()
                    end
                )
            end
        end
    elseif go == self.go_table.aorbtn_tips then
        self.go_table.obj_score:SetActiveE(1)
    end
end

function HeroicIconTeamLevel:OnScoreClick()
    self.go_table.obj_score:SetActiveE(0)
end

return HeroicIconTeamLevel
