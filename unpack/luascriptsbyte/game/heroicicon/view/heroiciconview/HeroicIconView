function HeroicIconView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function HeroicIconView:OnCreate()
    HeroicIconModel = require "HeroicIconModel":GetInstance()

    if _G.AppSetting.IsXzns then
        self.BgPath = {
            [4] = "ImagesH5/hHeroicIcon/ui_ycns_diban_nv_zi",
            [5] = "ImagesH5/hHeroicIcon/ui_ycns_diban_nv_cheng",
            [6] = "ImagesH5/hHeroicIcon/ui_ycns_diban_nv_hong",
            [7] = "ImagesH5/hHeroicIcon/ui_ycns_diban_nv_cai",
        }
    end
    self:UpdateView()
end

---刷新数据
function HeroicIconView:FreshData()
    self.heroic_icons = HeroicIconModel:GetHeroicIcons()
    self.sortedIconCfg = {}
    for k, v in ipairs(HeroicIconModel:GetSortedIconCfg()) do
        local info = HeroicIconModel:GetHeroicIconBySid(v.id)
        if v.get_display ~= 1 or info then
            table.insert(self.sortedIconCfg, v)
        end
    end
end

function HeroicIconView:UpdateView()
    if self:IsNil() then
        return
    end
    self:FreshData()
    if not self.init then
        self.go_table.scrollloopvectical_iconList:InitItemData(0, _G.handler(self, self.RefreshList))
        self.go_table.scrollloopvectical_iconList:UpdateCount(#self.sortedIconCfg)
        self.init = true
    else
        self.go_table.scrollloopvectical_iconList:UpdateCount(#self.sortedIconCfg)
        self.go_table.scrollloopvectical_iconList:UpdateAllItem()
    end
    for k, v in ipairs(self.sortedIconCfg) do
        local info = HeroicIconModel:GetHeroicIconBySid(v.id)
        if info and info.level == 0 then
            self.go_table.scrollloopvectical_iconList:ScrollToIndex(k - 1)
        end
    end
    if _G.AppSetting.IsXzns then
        self.go_table.aortext_totalLv.text = _G.GetLangPackValue(90036000007, HeroicIconModel:GetIconTotalLevel())
    else
        self.go_table.aortext_totalLv.text = _G.GetLangPackValue(90036000007, "96ce51", HeroicIconModel:GetIconTotalLevel())
    end
end

function HeroicIconView:RefreshList(index, obj)
    local data = self.sortedIconCfg[index + 1]
    local info = HeroicIconModel:GetHeroicIconBySid(data.id)

    local IsFinishTaskBol = false
    local canFinishTaskBol = false
    local unlockBol = false
    if info and info.level > 0 then
        unlockBol = true
    end
    if info and info.level == 0 then
        IsFinishTaskBol = true
    end
    if HeroicIconModel:GetTaskCanFinish(data.id) then
        canFinishTaskBol = true
    end


    -- if info and info.level == 0 then
    --     canGetBol = true
    --     IsFinishTaskBol = true
    -- end


    local tb = _G.GetAutoGoTable(obj)
    if _G.AppSetting.IsXzns then
        local txtColor,nameColor,levelColor
        if data.grade == 4 then
            nameColor = _G.ColorTools.FormatColorByString("560e84")
            levelColor = _G.ColorTools.FormatColorByString("7551b0")
        elseif data.grade == 5 then
            nameColor = _G.ColorTools.FormatColorByString("80420b")
            levelColor = _G.ColorTools.FormatColorByString("89491a")
        elseif data.grade == 6 then
            nameColor = _G.ColorTools.FormatColorByString("84210e")
            levelColor = _G.ColorTools.FormatColorByString("b05351")
        elseif data.grade == 7 then
            nameColor = _G.ColorTools.FormatColorByString("84210e")
            levelColor = _G.ColorTools.FormatColorByString("b05351")
        end
        tb.aorrawimage_bg:LoadImage(self.BgPath[data.grade])
        tb.aortext_name.color = nameColor
        tb.aortext_lv.color = levelColor
        tb.aorrawimage_icon.color = _G.ColorTools.FormatColorByString(not unlockBol and "7f7f7f" or "ffffff")
        tb.aorrawimage_icon:SetLocalPosition(data.icon_coefficient[1], data.icon_coefficient[2], data.icon_coefficient[3])
        tb.aorrawimage_icon:SetLocalScale(data.icon_coefficient[4], data.icon_coefficient[5], data.icon_coefficient[6])
        tb.aorrawimage_unlock:SetActiveE(not unlockBol and 1 or 0)
    end
    tb["_onclick"] = _G.handlerbind(self, self.ClickItemBtn, tb, index)
    tb.aortext_name.text = (not _G.AppSetting.IsXzns and not info) and _G.GetLangPackValue(90036000009) or _G.GetLangPackValue(data.name)
    if not _G.AppSetting.IsXzns then
        tb.aorrawimage_nameBg:LoadImage(
            iconNameBg[data.grade],
            function(tran)
                if self:IsNil() then
                    tran:DestroyObject()
                    return
                end
                tran:SetNativeSize()
            end
        )
        tb.aorimage_lvBg.SpriteName = iconLvBg[data.grade]
    end
    tb.aorrawimage_icon:LoadImage(
        _G.AppSetting.IsXzns and data.icon or data.hero_image,
        function(tran)
            if self:IsNil() then
                tran:DestroyObject()
                return
            end
            tran:SetNativeSize()
            if not _G.AppSetting.IsXzns then
                tran:SetLocalScaleXYZ(1.1)
            end
        end
    )
    if not _G.AppSetting.IsXzns then
        if tb.obj_effectRoot:GetChildCountE() == 0 then
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_HeroicIconView_unlock_loop,
                tb.obj_effectRoot,
                function(trans)
                    if self:IsNil() or tb.obj_effectRoot:GetChildCountE() > 1 then
                        _G.DestroyObject(trans)
                        return
                    end
                    trans:SetLocalPositionToZero()
                    trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                end
            )
        end
        tb.aorrawimage_2:SetGray(not unlockBol)
    end
    -- tb.aorimage_lvBg:SetGray(not info)
    -- tb.aorrawimage_nameBg:SetGray(not info)
    -- tb.aorrawimage_icon:SetGray(not info)
    -- tb.aorrawimage_bg:SetGray(not info)
    tb.aorbtn_unlockShow:SetActiveE((not unlockBol and not canFinishTaskBol and not IsFinishTaskBol) and 1 or 0)
    tb.aorbtn_unlock:SetActiveE((not unlockBol and (canFinishTaskBol or IsFinishTaskBol)) and 1 or 0)
    tb.aortext_3:SetActiveE((not unlockBol and not canFinishTaskBol and not IsFinishTaskBol) and 1 or 0)
    tb.aorrawimage_3:SetActiveE((not unlockBol and not canFinishTaskBol and not IsFinishTaskBol) and 1 or 0)
    tb.aorimage_bg:SetActiveE((not unlockBol and not canFinishTaskBol and not IsFinishTaskBol) and 1 or 0)
    tb.aorrawimage_3:LoadImage(
        data.icon,
        function(tran)
            if self:IsNil() then
                tran:DestroyObject()
                return
            end
            -- tran:SetNativeSize()
        end
    )


    local str, taskInfo
    if data.open_conditions[1] then
        taskInfo = HeroicIconModel:GetTaskByTaskid(data.open_conditions[1][1])
        local count, target = taskInfo:GetCount()
        if _G.AppSetting.IsXzns then
            str = string.format("<color=#e75344>(%d/%d)</color>", target, count)
        else
            str = string.format("<color=red>(%d/%d)</color>", target, count)
        end
        -- if not unlockBol then
        --     str = string.format("<color=green>(%d/%d)</color>", target, count)
        -- end
    end

    tb.aorimage_bg.SpriteName = _G.EquipItemIconName[data.grade]

    tb.aortext_3.text = data.open_conditions[1] and
        (_G.GetLangPackValue(taskInfo.Cfg.desc) .. str) or ""
    if not info or (info and info.level == 0) then
        tb.obj_lv:SetActiveE(0)
        local attrCfg, privilegeCfg = HeroicIconModel:GetHeroicIconSkill(data.id, 1)
        tb.aortext_skill1.text = _G.GetLangPackValue(attrCfg[1].describe)
        if #attrCfg > 1 then
            tb.aortext_skill2.text = _G.GetLangPackValue(attrCfg[2].describe)
        else
            tb.aortext_skill2.text = _G.GetLangPackValue(privilegeCfg.desc)
        end
    else
        tb.obj_lv:SetActiveE(1)
        if _G.AppSetting.IsXzns then
            tb.aortext_lv.text = _G.GetLangPackValue(90033800028, info.level)
            require("CommonTipManager"):GetInstance():SetItemTextGradient(tb.aortext_lv, data.grade)
        else
            tb.aortext_lv.text = info.level
        end
        tb.aortext_skill1.text = _G.GetLangPackValue(info.attrCfg[1].describe)
        if #info.attrCfg > 1 then
            tb.aortext_skill2.text = _G.GetLangPackValue(info.attrCfg[2].describe)
        else
            tb.aortext_skill2.text = _G.GetLangPackValue(info.privilegeCfg.desc)
        end
    end
    if _G.AppSetting.IsXzns then
        tb.obj_redpoint:UpdateRedPointItemIDAndParam(
            _G.ConfigManager.redpoint_cfg.HeroicIconIconLvUp.id,
            data.id
        )
    end
end

function HeroicIconView:ClickItemBtn(go, isOn, tb, index)
    local args = {}
    args.dataAll = {}
    args.index = index + 1
    local showData = {}
    if not _G.AppSetting.IsXzns then

        for i = 1, #self.sortedIconCfg do
            local info = HeroicIconModel:GetHeroicIconBySid(self.sortedIconCfg[i].id)
            if info and info.level ~= 0 then
                table.insert(showData, self.sortedIconCfg[i])
            end
        end

        args.dataAll = showData
    else
        args.dataAll = self.sortedIconCfg
    end
    if go == tb.aorbtn_unlock then
        local data = self.sortedIconCfg[index + 1]
        local info = HeroicIconModel:GetHeroicIconBySid(data.id)
        local msgTask = {}
        if info or not data.open_conditions[1] then
            local msg = {}
            msg.sid = data.id
            msg.consume = {}

            HeroicIconModel:HeroicUpLevel(msg, function(msg, pbData)
                if not self.power then
                    self.power = { [data.id] = _G.StorageManager:GetInstance():GetPlayerPower() }
                else
                    self.power[data.id] = _G.StorageManager:GetInstance():GetPlayerPower()
                end
                self:HeroicUpLevelCallBack(msg, pbData, tb.gameObject, index)
            end)
        else
            msgTask.task = { data.open_conditions[1][1] }
            msgTask.finish_type = 2
            HeroicIconModel:HeroicFinishTask(msgTask, function(msg)
                local msg = {}
                msg.sid = data.id
                msg.consume = {}
                if not self.power then
                    self.power = { [msg.sid] = _G.StorageManager:GetInstance():GetPlayerPower() }
                else
                    self.power[msg.sid] = _G.StorageManager:GetInstance():GetPlayerPower()
                end
                HeroicIconModel:HeroicUpLevel(msg, function(msg, pbData)
                    self:HeroicUpLevelCallBack(msg, pbData, tb.gameObject, index)
                end)
            end)
        end
    elseif go == tb.aorbtn_Item then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.HeroicIconDetailView.Name,
            self.sortedIconCfg[index + 1], _G.handler(self, self.UpdateView), nil, args)
    elseif go == tb.aorbtn_unlockShow then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.HeroicIconDetailView.Name,
            self.sortedIconCfg[index + 1], _G.handler(self, self.UpdateView), nil, args)
    end
end

function HeroicIconView:HeroicUpLevelCallBack(msg, pbData, go, index)
    if msg.ack == 1 then
        local info = HeroicIconModel:GetHeroicIconBySid(pbData.sid)
        if info.level == 1 then
            if not _G.AppSetting.IsXzns then
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.ef_HeroicIconView_unlock,
                    go,
                    function(trans)
                        if self:IsNil() then
                            _G.DestroyObject(trans)
                            return
                        end
                        trans:SetLocalPositionToZero()
                        trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                    end,
                    function()
                        if msg.award then
                            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                        end
                    end
                )
            else
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.HeroicIconIconLvUp.id, pbData.sid)
            end
        end
        if self.power and self.power[pbData.sid] then
            _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.HeroicIcon)
            local newPower = _G.StorageManager:GetInstance():GetPlayerPower()
            local offset = newPower - self.power[pbData.sid]
            if offset > 0 then
                require "CommonTipManager".OpenPowerUpView(self.power[pbData.sid], offset)
            end
            self.power[pbData.sid] = newPower
        end
        self:RefreshList(index, go)
    end
end

---按钮点击事件在这里派发
function HeroicIconView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_tips then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 175)
    elseif go == self.go_table.aorbtn_AttrDetail then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TeamHallAttrHeroicPanel.Name)
    end
end

function HeroicIconView:OnDestroy()
    self:RemoveAllListener()
end

return HeroicIconView
