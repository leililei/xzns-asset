local HeroicIconModel = require "HeroicIconModel":GetInstance()

local base = require "EventViewBase"
---@class HeroicIconStarUpView : UIBaseView    灵兽升星界面
---@field public go_table HeroicIconStarUpView_GoTable GoTable
local HeroicIconStarUpView = _G.BaseClass("HeroicIconStarUpView", base)

function HeroicIconStarUpView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function HeroicIconStarUpView:OnCreate(sid)
    self.data = HeroicIconModel:GetHeroicIconBySid(sid)
    self.Cfg = _G.ConfigManager.heroic_icons_cfg[sid]

    --self:InitbgCanvasSortingOrder()
    self:ShowProp()
    self:ShowBtn()
    self.go_table.aorrawimage_icon1:LoadImage(
        self.Cfg.hero_image,
        function(trans)
            if not self.go_table then
                _G.DestroyObject(trans)
                return
            end
            trans:SetNativeSize()
        end)
    if not _G.AppSetting.IsXzns then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_shengxingchenggong,
            self.go_table.obj_Eff,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
            end
        )
    end
end

---按钮点击事件在这里派发
function HeroicIconStarUpView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        ---关闭按钮
        self:Close()
    end
end

function HeroicIconStarUpView:ShowProp()
    local level = self.data and self.data.level or 1
    self.go_table.aortext_level1.text = "Lv." .. level
    local attrCfg1, privilegeCfg1 = HeroicIconModel:GetHeroicIconSkill(self.data.sid, level)
    local attrCfg2, privilegeCfg2 = HeroicIconModel:GetHeroicIconSkill(self.data.sid, level - 1)
    local levelCfg1 = _G.ConfigManager.heroic_icons_level_cfg[level]
    local levelCfg2 = _G.ConfigManager.heroic_icons_level_cfg[level - 1]

    self.go_table.aortext_skill1.text = _G.GetLangPackValue(attrCfg2[1].describe)
    self.go_table.aortext_skill1Value.text = _G.GetLangPackValue(attrCfg1[1].describe)
    if attrCfg2[2] then
        self.go_table.aortext_skill2.text = _G.GetLangPackValue(attrCfg2[2].describe)
        self.go_table.aortext_skill2Value.text = _G.GetLangPackValue(attrCfg1[2].describe)
    else
        self.go_table.aortext_skill2.text = _G.GetLangPackValue(privilegeCfg2.desc)
        self.go_table.aortext_skill2Value.text = _G.GetLangPackValue(privilegeCfg1.desc)
    end

    local data = { self.Cfg.atk, self.Cfg.bre, self.Cfg.def, self.Cfg.max_hp }

    for i = 1, 4 do
        local tb = _G.GetAutoGoTable(self.go_table["obj_BaseProp" .. i])
        tb.aortext_oldValue.text = _G.GameUtil.NumberToUnitStr(math.ceil(data[i] * levelCfg2.att_growth / 10000))
        tb.aortext_curValue.text = _G.GameUtil.NumberToUnitStr(math.ceil(data[i] * levelCfg1.att_growth / 10000))
    end
end

---@private
function HeroicIconStarUpView:ShowBtn()
    if self.btn == nil then
        self.go_table.obj_Btn:SetActiveE(0)
        return
    end
    if self.btn.left then
        self.go_table.aorbtn_left:SetActiveE(1)
        self.go_table.aortext_BtnLeftName.text = self.btn.left.name
    end
    if self.btn.middle then
        self.go_table.aorbtn_middle:SetActiveE(1)
        self.go_table.aortext_BtnMiddleName.text = self.btn.middle.name
    end
    if self.btn.right then
        self.go_table.aorbtn_right:SetActiveE(1)
        self.go_table.aortext_BtnRightName.text = self.btn.right.name
    end
end

function HeroicIconStarUpView:InitbgCanvasSortingOrder()
    local canvas = self.go_table.obj_bg:GetComponentE(_G.typeof(_G.Canvas))
    local parentcanvas = self:GetParentCanvas(self.go_table.obj_bg)
    canvas.sortingOrder = canvas.sortingOrder + parentcanvas.sortingOrder
end

---获得父物体画布
---@param obj UnityEngine.GameObject 子物体
function HeroicIconStarUpView:GetParentCanvas(obj)
    local canvas = obj:GetComponentInParentE(_G.typeof(_G.Canvas))
    if not canvas.overrideSorting then
        return self:GetParentCanvas(canvas.transform)
    else
        return canvas
    end
end

return HeroicIconStarUpView
