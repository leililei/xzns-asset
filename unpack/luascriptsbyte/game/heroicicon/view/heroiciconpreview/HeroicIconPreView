---@class HeroicIconPreView : UIBaseView  下边栏菜单
---@field go_table HeroicIconPreView_GoTable
local HeroicIconPreView = _G.BaseClass("HeroicIconPreView", _G.UIBaseView)
local HeroicIconModel

function HeroicIconPreView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function HeroicIconPreView:OnCreate(data, lv)
    self.data = data 
    self.level = lv
    HeroicIconModel = require "HeroicIconModel":GetInstance()
    self.lvTable = HeroicIconModel:GetAllChangeSkillLv()
    self.nowIndex = #self.lvTable
    self.nowLv = self.lvTable[self.nowIndex]
    for k, v in ipairs(self.lvTable) do 
        if v > self.level then 
            self.nowLv = v
            self.nowIndex = k
            break
        end
    end
    self:UpdateView()
end

---刷新数据
function HeroicIconPreView:FreshData()
    -- self.heroic_icons = HeroicIconModel:GetHeroicIcons()
    -- self.sortedIconCfg = HeroicIconModel:GetSortedIconCfg()
    self.info = HeroicIconModel:GetHeroicIconBySid(self.data.id)
end

function HeroicIconPreView:UpdateView()
    self:FreshData()
    self.go_table.aorbtn_left:SetActiveE(self.nowIndex ~= 1 and 1 or 0)
    self.go_table.aorbtn_right:SetActiveE(self.nowIndex ~= #self.lvTable and 1 or 0)
    self.go_table.aortext_level.text = string.format("Lv.%s", self.nowLv) 
    local attrCfg, privilegeCfg = HeroicIconModel:GetHeroicIconSkill(self.data.id, self.nowLv)
    self.go_table.aortext_skill1.text = _G.GetLangPackValue(attrCfg[1].describe)
    if attrCfg[2] then 
        self.go_table.aortext_skill2.text = _G.GetLangPackValue(attrCfg[2].describe)
    else 
        self.go_table.aortext_skill2.text = _G.GetLangPackValue(privilegeCfg.desc)
    end
end

---按钮点击事件在这里派发
function HeroicIconPreView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_left then 
        self.nowIndex = self.nowIndex - 1
        self.nowLv = self.lvTable[self.nowIndex]
        self:UpdateView()
    elseif go == self.go_table.aorbtn_right then 
        self.nowIndex = self.nowIndex + 1
        self.nowLv = self.lvTable[self.nowIndex]
        self:UpdateView()
    end
end

function HeroicIconPreView:OnDestroy()
    self:RemoveAllListener()
end

return HeroicIconPreView
