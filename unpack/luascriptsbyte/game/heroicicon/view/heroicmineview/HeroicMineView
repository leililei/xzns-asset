---@class HeroicMineView : UIBaseView  下边栏菜单
---@field go_table HeroicMineView_GoTable
local HeroicMineView = _G.BaseClass("HeroicMineView", _G.UIBaseView)
local HeroicIconModel
local hallImaName = {

}

local itemScale = {
    [0] = 1,
    [1] = 0.9,
    [2] = 0.6,
    [3] = 0.7,
    [4] = 0.8
}

local mineEffect = {
    _G.ConfigManager.ui_effect_cfg.ef_HeroicMainView_hall_lan,
    _G.ConfigManager.ui_effect_cfg.ef_HeroicMainView_hall_zi,
    _G.ConfigManager.ui_effect_cfg.ef_HeroicMainView_hall_jin,
    _G.ConfigManager.ui_effect_cfg.ef_HeroicMainView_hall_hong
}

function HeroicMineView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eLimitePrivilege.LimitePrivilegeChange, self.UpdateView, self)
end

---界面的入口函数
function HeroicMineView:OnCreate()
    self:UpdateView()
    require("HeroicIconModel"):GetInstance():GetInfo()
    if HeroicIconModel:CheckMinePrivilegeFirstPop() then 
        self:OnClickBtn(self.go_table.aorbtn_privilege)
    end
end

---刷新数据
function HeroicMineView:FreshData()
    HeroicIconModel = require "HeroicIconModel":GetInstance()
    self.maps = HeroicIconModel:GetMaps()
    self.map_mark  = HeroicIconModel:GetMapMark()
    self.mineCfg = _G.ConfigManager.heroic_icons_mine_cfg[self.maps.sid]
end

function HeroicMineView:UpdateView()
    self.canUpBol = false 
    self:FreshData()
    if HeroicIconModel:CheckCanAutoGet() then
        HeroicIconModel:AutoHangupAward(_G.handler(self, self.UpdateView))
    end
    local cfg = _G.ConfigManager.store_month_cfg[405007]
    if not cfg.display or cfg.display == 0 or _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(cfg.display) then
        self.go_table.aorbtn_privilege:SetActiveE(1)
    else 
        self.go_table.aorbtn_privilege:SetActiveE(0)
    end
    self.canGetBol = false
    self.go_table.aortext_title.text = _G.GetLangPackValue(self.mineCfg.name)
    self.go_table.aorrawimage_Bg:LoadImage(
        self.mineCfg.icon,
        function(tran)
            if self:IsNil() then
                tran:DestroyObject()
                return
            end
            --tran:SetNativeSize()
        end
    )
    for i = 1, 10 do 
        self:RefreshList(i)
    end
    --self.go_table.aorbtn_GetUnlockAward:SetActiveE((_G.table.ContainsValue(self.map_mark, self.maps.sid) or not self.mineCfg.unlock_rewards[1]) and 0 or 1)
    local star = self.maps.sid % 10
    for i = 1, 4 do 
        self.go_table["obj_star" .. i]:SetActiveE(i <= star and 1 or 0)
    end
    local privilegeData1 = require "PrivilegeManager":GetInstance():GetPrivilegeDataNew({_G.PrivilegeType.HeroicIconMine.ExploreTime})
    local privilegeData2 = require "PrivilegeManager":GetInstance():GetPrivilegeDataNew({_G.PrivilegeType.HeroicIconMine.MineAwardRatio})
    self.go_table.obj_skill:SetActiveE(0)
    if not table.isEmptyOrNil(privilegeData1) then
        self.go_table.obj_skill:SetActiveE(1)
        self.go_table.obj_skill1:SetActiveE(1)
        self.go_table.aortext_skill1.text = _G.GetLangPackValue(90036000024, privilegeData1[1][2] / 100)
    else 
        self.go_table.obj_skill1:SetActiveE(0)
    end
    if not table.isEmptyOrNil(privilegeData2) then
        self.go_table.obj_skill:SetActiveE(1)
        self.go_table.obj_skill2:SetActiveE(1)
        self.go_table.aortext_skill2.text = _G.GetLangPackValue(90036000025, privilegeData2[1][2] / 100)
    else 
        self.go_table.obj_skill2:SetActiveE(0)
    end
    if self.mineCfg.upgrade_mine ~= 0 then 
        self.go_table.obj_upgrateMine:SetActiveE(1)
        local iconTotalLevel = HeroicIconModel:GetIconTotalLevel()
        local nextMineCfg = _G.ConfigManager.heroic_icons_mine_cfg[self.mineCfg.upgrade_mine]
        self.canUpBol = _G.GlobalConditionManager.CheckConditionByArray(nextMineCfg.condition_type)
        local color = self.canUpBol and "96ce51" or "c02214"
        self.go_table.aortext_upgrate.text = _G.GetLangPackValue(90036000002, color, iconTotalLevel, nextMineCfg.condition_type[1][2])
        if self.canUpBol then 
            --self.go_table.aorbtn_upgrate.enabled = true
            self.go_table.aorbtn_upgrate:SetGray(false)
            self.go_table.aortext_upgrateBtn.color = _G.ColorTools.FormatColorByString("8C2D14")
            --self.go_table.aortext_upgrate.text = _G.GetLangPackValue(90033500052)
        else 
            --self.go_table.aorbtn_upgrate.enabled = false
            self.go_table.aorbtn_upgrate:SetGray(true)
            self.go_table.aortext_upgrateBtn.color = _G.Color.black
            --self.go_table.aortext_upgrate.text = _G.GetLangPackValue(90033500052)
        end
    else 
        self.go_table.obj_upgrateMine:SetActiveE(0)
    end
    if self.canUpBol then 
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MineUpgrateView.Name, _G.handler(self, self.UpdateView))
    end
    local privilegeBol = HeroicIconModel:CheckMineAutoPri()
    self.go_table.obj_privilege:SetActiveE(privilegeBol and 1 or 0)
    self.go_table.aortext_heroic:SetActiveE(privilegeBol and 0 or 1)
end

function HeroicMineView:RefreshList(index)
    local tb = _G.GetAutoGoTable(self.go_table["obj_hall" .. index])
    local info = HeroicIconModel:GetMineByIndex(index)
    if info then 
        tb.gameObject:SetActiveE(1)
        tb["_onclick"] = _G.handlerbind(self, self.ClickItemBtn, tb, index)
        local hallCfg = _G.ConfigManager.heroic_icons_fruit_cfg[info.sid]
        tb.aorrawimage_hall:LoadImage(
            hallCfg.icon,
            function(tran)
                if self:IsNil() then
                    tran:DestroyObject()
                    return
                end
                tran:SetNativeSize()
                tran:SetLocalScaleXYZ(itemScale[info.sid % 10] or 1)
            end
        )
        local lastTime = info.finish_time - _G.TimeUtil.GetServerUnixTime()
        if lastTime >= 0 then 
            tb.obj_canGet:SetActiveE(0)
            tb.slider_progress:SetActiveE(1)
            self.lastTime = lastTime
            self.needTime =  info.finish_time -  info.start_time
            self.timeTb = tb
            if self.timer then
                self.timer:Stop()
                self.timer = nil
            end
            self.timeTb.aortext_time.text = _G.TimeUtil.TimeToString(self.lastTime, 1)
            self.timeTb.slider_progress.value = 1 - self.lastTime / self.needTime
            self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimer, self, false, false, true)
            self.timer:Start()
            --self:UpdateTimer()
        else
            tb.obj_canGet:SetActiveE(1)
            tb.slider_progress:SetActiveE(0)
        end
        tb.aorrawimage_hall:ClearChildren()
        _G.UIUtils.LoadEffectByCfg(
            mineEffect[hallCfg.id % 10],
            tb.aorrawimage_hall,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                trans:SetLocalPositionToZero()
                trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
            end
        ) 
    else
        tb.aorrawimage_hall:ClearChildren()
        tb.aorrawimage_hall:LoadImage(
            "ImagesH5/hHeroicIcon/ui_ygsx_lk_kd_kong",
            function(tran)
                if self:IsNil() then
                    tran:DestroyObject()
                    return
                end
                tran:SetNativeSize()
                tran:SetLocalScaleXYZ(1)
            end
        )
        tb.obj_canGet:SetActiveE(0)
        tb.slider_progress:SetActiveE(0)
    end
end

function HeroicMineView:ClickItemBtn(go, isOn, tb, index)
    if go == tb.aorbtn_Get then
        if HeroicIconModel:CheckCanGetMineHangAward() then 
            HeroicIconModel:HangupAward(_G.handler(self, self.UpdateView))
        else 
            _G.PopWindowManager:GetInstance():ShowAllTips(1120003) 
        end
    end
end

function HeroicMineView:UpdateTimer()
    -- local index = #self.maps.mines
    -- self.lastTime = info.finish_time - _G.TimeUtil.GetServerUnixTime()
    local index, time = HeroicIconModel:GetLatestMineAwardIndex()
    self.lastTime = time - _G.TimeUtil.GetServerUnixTime()
    self.timeTb.aortext_time.text = _G.TimeUtil.TimeToString(self.lastTime, 1)
    self.timeTb.slider_progress.value = 1 - self.lastTime / self.needTime
    if self.lastTime < 0 then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        self.timeTb.obj_canGet:SetActiveE(1)
        self.timeTb.slider_progress:SetActiveE(0)
        --HeroicIconModel:GetInfo(_G.handler(self, self.UpdateView))
    end
end

function HeroicMineView:AnimOut(zoomOutCall, zoomInCall)
    if self:IsNil() then
        return
    end
    local transforView = _G.UIManager:GetInstance():GetWindowCtrl(
        _G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name
    )
    if transforView then
        transforView:Show()
        transforView:SetAction(
            "zoom_out",
            function()
                if zoomOutCall then
                    zoomOutCall()
                end
                self:AnimIn(zoomInCall)
            end
        )
    else
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name,
            "zoom_out",
            function()
                if zoomOutCall then
                    zoomOutCall()
                end
                self:AnimIn(zoomInCall)
            end
        )
    end
end

function HeroicMineView:AnimIn(callBack)
    _G.DelayDo(0.1, function()
        local transforView = _G.UIManager:GetInstance():GetWindowCtrl(
            _G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name
        )
        if transforView then
            transforView:Show()
            transforView:SetAction(
                "zoom_in",
                function()
                    if callBack then
                        callBack()
                    end
                    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name)
                end
            )
        else
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name,
                "zoom_in",
                function()
                    if callBack then
                        callBack()
                    end
                    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name)
                end
            )
        end
    end)
end

function HeroicMineView:UpdateCallBack()
    self:AnimOut(_G.handler(self, self.UpdateView))
end

---按钮点击事件在这里派发
function HeroicMineView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_GetHallAward then 
        if HeroicIconModel:CheckCanGetMineHangAward() then 
            HeroicIconModel:HangupAward(_G.handler(self, self.UpdateView))
        else 
            _G.PopWindowManager:GetInstance():ShowAllTips(1120003) 
        end
    elseif go == self.go_table.aorbtn_GetUnlockAward then 
        local msg = {}
        msg.sid = {self.maps.sid}
        HeroicIconModel:LockAward(msg, function(msg)
            if msg.ack == 1 then 
                self.map_mark  = HeroicIconModel:GetMapMark()
                self.go_table.aorbtn_GetUnlockAward:SetActiveE(0)
            end
        end)
    elseif go == self.go_table.aorbtn_tips then 
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 175)
    elseif go == self.go_table.aorbtn_upgrate then 
        -- local msg = {}
        -- msg.sid = self.maps.sid
        -- HeroicIconModel:MineUpStar(msg, function(msg)
        --     if msg.ack == 1 then 
        --         self:UpdateView()
        --     end 
        -- end)
        if not self.canUpBol then 
            _G.PopWindowManager:GetInstance():ShowAllTips(1120001) 
            return 
        end
        if HeroicIconModel:CheckMineUnlockAwardRedPoint() then 
            _G.PopWindowManager:GetInstance():ShowAllTips(1120002) 
            return 
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MineUpgrateView.Name, _G.handler(self, self.UpdateCallBack))
    elseif go == self.go_table.aorbtn_showAward then 
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MineAwardView.Name)
    elseif go == self.go_table.aorbtn_privilege then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LimitedTimePrivilegeView.Name, 405007)
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.HeroicMinePrivilegeClick, 1)
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.HeroicMinePrivilegeFirstPop, 1)
        local day = _G.TimeUtil.GetTotalDayBy201611()
        local endDay = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.HeroicMinePrivilegeDay, 0)
        if endDay ~= 0 and day >= endDay + 1 then 
            _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.HeroicMinePrivilegeDay, 0)
        end
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.HeroicIconMinePrivilege.id)
    end
end

function HeroicMineView:OnDestroy()
    self:RemoveAllListener()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return HeroicMineView
