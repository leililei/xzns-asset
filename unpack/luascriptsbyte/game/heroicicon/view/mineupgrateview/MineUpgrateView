---@class MineUpgrateView : UIBaseView  下边栏菜单
---@field go_table MineUpgrateView_GoTable
local MineUpgrateView = _G.BaseClass("MineUpgrateView", _G.UIBaseView)
local HeroicIconModel

function MineUpgrateView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MineUpgrateView:OnCreate(call)
    self.call = call 
    HeroicIconModel = require "HeroicIconModel":GetInstance()
    self:UpdateView()
end

---刷新数据
function MineUpgrateView:FreshData()
    self.maps = HeroicIconModel:GetMaps()
    self.mineCfg = _G.ConfigManager.heroic_icons_mine_cfg[self.maps.sid]
end

function MineUpgrateView:UpdateView()
    self:FreshData()
    self.go_table.obj_newItem1:ClearChildren()
    for k, v in ipairs(self.mineCfg.new_increase) do 
        local _, storageId = _G.StorageManager:GetInstance():CheckSidType(v)
        _G.StorageManager:GetInstance():GetItemBaseView(
            v,
            0,
            self.go_table.obj_newItem1,
            function(item)
                if _G.IsNil(self.go_table) then
                    _G.DestroyObject(item.go_table.gameObject)
                    return
                end
                item.go_table.gameObject:SetLocalScaleXYZ(0.8)
                item:ShowNumText(false)
            end
        )
    end
    self.go_table.obj_newItem2:ClearChildren()
    for k, v in ipairs(self.mineCfg.increase_odds) do 
        local _, storageId = _G.StorageManager:GetInstance():CheckSidType(v)
        _G.StorageManager:GetInstance():GetItemBaseView(
            v,
            0,
            self.go_table.obj_newItem2,
            function(item)
                if _G.IsNil(self.go_table) then
                    _G.DestroyObject(item.go_table.gameObject)
                    return
                end
                item.go_table.gameObject:SetLocalScaleXYZ(0.8)
                item:ShowNumText(false)
                local rtf_Tmp = self.go_table.obj_node:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
                _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(rtf_Tmp)
            end
        )
    end
end

---按钮点击事件在这里派发
function MineUpgrateView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close1 then
        self:Close()
    elseif go == self.go_table.aorbtn_comfirm then 
        if HeroicIconModel:CheckMineUnlockAwardRedPoint() then 
            _G.PopWindowManager:GetInstance():ShowAllTips(1120002) 
            return 
        end
        local msg = {}
        msg.sid = self.maps.sid
        HeroicIconModel:MineUpStar(msg, function(msg)
            if msg.ack == 1 and self.call then 
                self.call()
                self:Close()
            end 
        end)
    end
end

function MineUpgrateView:OnDestroy()
    self:RemoveAllListener()
end

return MineUpgrateView
