local HeroicIconNet = require("HeroicIconNet")

local base = _G.GameDataModelBase
---@class HeroicIconModel : GameDataModelBase
local HeroicIconModel = _G.BaseClass("HeroicIconModel", base)
local heroic_icons_cfg
local heroic_icons_fruit_cfg
local heroic_icons_level_cfg
local heroic_icons_mine_cfg
local upItem = {
    202150100, 202150200, 202150300, 202150400
}

---@return HeroicIconModel HeroicIconModel
function HeroicIconModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function HeroicIconModel:__init()
    self.curFunctionOpenID = _G.FunctionID.HeroicIcon
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.OnSixClockUpdateCallback, self)
    if _G.AppSetting.IsXzns then
        _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.OnResUpdate, self)
    end
    self.initBol = false
    heroic_icons_cfg = _G.ConfigManager.heroic_icons_cfg
    heroic_icons_fruit_cfg = _G.ConfigManager.heroic_icons_fruit_cfg
    heroic_icons_level_cfg = _G.ConfigManager.heroic_icons_level_cfg
    heroic_icons_mine_cfg = _G.ConfigManager.heroic_icons_mine_cfg
    self.heroic_icons = self.heroic_icons or {}
end

---从服务器拉取数据
function HeroicIconModel:GetDataFormServer()
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.HeroicIcon) then
        HeroicIconNet:GetInstance():GetInfo(_G.handler(self, self.ParseData))
    else
        self.super.ParseData(self)
    end
end

function HeroicIconModel:GetInfo(callBack)
    HeroicIconNet:GetInstance():GetInfo(function(msg)
        self:ParseData(msg)
        if callBack then
            callBack(msg)
        end
    end)
end

function HeroicIconModel:OnResUpdate(data)
    local needRefresh = false
    for _, v in pairs(data) do
        if _G.table.ContainsValue(upItem, v.type[1]) then 
            needRefresh = true
            break
        end
    end
    if needRefresh then
        require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.HeroicIconIconLvUp.id)
    end
end

function HeroicIconModel:UpdataTask(task)
    local isUpdata = false
    if task == nil or task.sid == nil then
        return isUpdata
    end
    local mTask = self:GetTaskByTaskid(task.sid)
    if mTask == nil then
        return isUpdata
    end
    mTask:UpdataData(task)

    return true
end

function HeroicIconModel:GetTaskByTaskid(sid)
    if self.tasks then 
        for i = 1, #self.tasks do
            if sid == self.tasks[i].i_task.sid then
                return self.tasks[i]
            end
        end
    end

    return nil
end

function HeroicIconModel:ParseData(msg)
    --if msg.ack == 1 then
    self.heroic_icons = msg.heroic_icons or {}
    self.maps = msg.maps or {}
    self.maps.mines = self.maps.mines or {}
    self.map_mark = msg.map_mark or {}

    local tasks = msg.task or {}
    local finish_task = msg.finish_task or {}
    self.tasks = {}
    if _G.AppSetting.IsXzns then
        require("HeroicMineModelSg"):GetInstance():ParseData(msg.ruins_info)
    end
    for i = 1, #tasks do
        local ActiveTaskBase = require("HeroicIconTaskData").New(tasks[i], function(data)

        end)

        table.insert(self.tasks, ActiveTaskBase)
    end

    for i = 1, #finish_task do
        local args = {}
        args.sid = finish_task[i]
        args.state = _G.TaskEnum.ETaskState.Claimed
        args.target = { 1 }
        local ActiveTaskBase = require("HeroicIconTaskData").New(args, function(data)

        end)

        table.insert(self.tasks, ActiveTaskBase)
    end

    
    for k, v in ipairs(self.heroic_icons) do
        if v.level > 0 then
            self:FreshHeroicIconSkill(v.sid, 0, v.level, true)
        end
    end
    self.mineNum = #self.maps.mines
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.mineNum > 0 then
        local index, time = self:GetLatestMineAwardIndex()
        local lastTime = time - _G.TimeUtil.GetServerUnixTime()
        if lastTime > 0 then
            self.lastTime = lastTime
            self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimer, self, false, false, true)
            self.timer:Start()
        else
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.HeroicIconMineAward.id)
        end
    end
    if not _G.AppSetting.IsXzns then
        local day = _G.TimeUtil.GetTotalDayBy201611()
        local endDay = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.HeroicMinePrivilegeDay, 0)
        if endDay ~= 0 and day >= endDay + 1 then 
            _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.HeroicMinePrivilegeClick, 0)
        end
        local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.HeroicMineView.Name)
        if ctrl then
            ctrl:UpdateView()
        end
    end
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.HeroicIconMineUnlockAward.id)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.HeroicIconIconUnlock.id)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.HeroicIconMineUpgrate.id)
    if not _G.AppSetting.IsXzns then
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.HeroicIconMinePrivilege.id)
    end
    self.super.ParseData(self)
    --拉数据的时候更新词条（self.initBol用来防止跨天特权词条重复加载）
    self.initBol = true
end

--添加圣像数据
function HeroicIconModel:AddHeroicIcon(sid)
    for k, v in ipairs(self.heroic_icons or {}) do
        if v.sid == sid then
            return
        end
    end
    table.insert(self.heroic_icons, { sid = sid, level = 0, exp = 0 })
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.HeroicIconIconUnlock.id)
end

--获取倒计时矿的下标和时间
function HeroicIconModel:GetLatestMineAwardIndex()
    local time = 0 
    local index
    for k, v in ipairs(self.maps.mines) do 
        if v.finish_time > time then 
            index = k 
            time = v.finish_time
        end
    end
    return index, time 
end

--根据index获取矿数据
function HeroicIconModel:GetMineByIndex(index)
    for k, v in ipairs(self.maps.mines) do 
        if v.index == index then 
            return v
        end
    end
end

--检查矿山能否领挖矿奖励
function HeroicIconModel:CheckCanGetMineHangAward()
    if not _G.AppSetting.IsXzns then
        for k, v in ipairs(self.maps.mines) do
            if v.finish_time - _G.TimeUtil.GetServerUnixTime() <= 0 then
                return true
            end
        end
    end
    return false
end

--检查有无圣像可解锁
function HeroicIconModel:CheckUnlockHeroicIconRedPoint()
    for k, v in pairs(_G.ConfigManager.heroic_icons_cfg) do 
        local info = self:GetHeroicIconBySid(v.id)
        if info and info.level == 0 then 
            return true
        end
        if not info and self:GetTaskCanFinish(v.id) then 
            return true
        end
    end 
    return false
end

--检查挖矿奖励是否已满
function HeroicIconModel:CheckMineAwardRedPoint()
    if not _G.AppSetting.IsXzns then
        local mineNum = #self.maps.mines
        if mineNum == 10 then
            local lastTime = self.maps.mines[mineNum].finish_time - _G.TimeUtil.GetServerUnixTime()
            if lastTime < 0 then
                return true
            end
        end
    end
    return false
end

--检查能否升级矿山
function HeroicIconModel:CheckMineUpgrateRedPoint()
    if not _G.AppSetting.IsXzns then
        self.mineCfg = _G.ConfigManager.heroic_icons_mine_cfg[self.maps.sid]
        if self.mineCfg.upgrade_mine and self.mineCfg.upgrade_mine ~= 0 then
            local nextMineCfg = _G.ConfigManager.heroic_icons_mine_cfg[self.mineCfg.upgrade_mine]
            return _G.GlobalConditionManager.CheckConditionByArray(nextMineCfg.condition_type)
        end
    end
    return false
end

--检查矿山特权红点
function HeroicIconModel:CheckMinePrivilegeRedPoint()
    local cfg = _G.ConfigManager.store_month_cfg[405007]
    if not cfg then 
        return false
    end
    local day = _G.TimeUtil.GetTotalDayBy201611()
    local endDay = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.HeroicMinePrivilegeDay, 0)
    local clickFlag = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.HeroicMinePrivilegeClick, 0)
    if endDay == 0 then 
        if cfg and not cfg.display or cfg.display == 0 or _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(cfg.display) then
            return clickFlag == 0
        end
    else 
        if day >= endDay + 1 and clickFlag == 0 then 
            return true
        end
    end
    return false
end

--检查矿山特权首次弹出
function HeroicIconModel:CheckMinePrivilegeFirstPop()
    local cfg = _G.ConfigManager.store_month_cfg[405007]
    if not cfg then 
        return false
    end
    if cfg.display and cfg.display ~= 0 and not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(cfg.display) then
        return false 
    end
    local endDay = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.HeroicMinePrivilegeDay, 0)
    local firstFlag = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.HeroicMinePrivilegeFirstPop, 0)
    return endDay == 0 and firstFlag == 0
end

