--获取排序后的圣像配置列表
function HeroicIconModel:GetSortedIconCfg()
    self.sortedIconCfg = self.sortedIconCfg or _G.table.toArray(_G.ConfigManager.heroic_icons_cfg)
    table.sort(self.sortedIconCfg, function(a, b)
        local infoA = self:GetHeroicIconBySid(a.id)
        local infoB = self:GetHeroicIconBySid(b.id)
        local unlockBolA = 0
        local canFinishTaskBolA = self:GetTaskCanFinish(a.id)
        if (infoA and infoA.level >= 0) or canFinishTaskBolA then 
            unlockBolA = 1
        end
        local unlockBolB = 0
        local canFinishTaskBolB = self:GetTaskCanFinish(b.id)
        if (infoB and infoB.level >= 0) or canFinishTaskBolB then 
            unlockBolB = 1
        end
        if unlockBolA ~= unlockBolB then 
            return unlockBolA > unlockBolB
        end
        return a.sort < b.sort
    end)
    return self.sortedIconCfg
end

