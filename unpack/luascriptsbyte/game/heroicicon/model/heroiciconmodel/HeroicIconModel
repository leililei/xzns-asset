--刷新圣像的特权
function HeroicIconModel:FreshHeroicIconSkill(sid, oldLv, newLv, getInfoBol)
    local iconCfg = heroic_icons_cfg[sid]
    local iconInfo = self:GetHeroicIconBySid(sid)
    local newSkillLv1, newSkillLv2
    newSkillLv1 = heroic_icons_level_cfg[newLv].level_skill[1]
    newSkillLv2 = heroic_icons_level_cfg[newLv].level_skill[2]
    iconInfo.attrCfg = {}
    iconInfo.attrCfg[1] = _G.ConfigManager.attribute_cfg[iconCfg.skill_1_id[1][newSkillLv1]]
    if #iconCfg.skill_1_id == 1 then
        --有特权词条，要把旧特权清除，添加新特权
        if oldLv == 0 or heroic_icons_level_cfg[oldLv].level_skill[2] ~= newSkillLv2 then
            --拉数据的时候更新词条（self.initBol用来防止跨天特权词条重复加载）
            if iconInfo.privilegeCfg and ((not getInfoBol) or (not self.initBol)) then
                require("PrivilegeManager"):GetInstance():RemovePrivilege(iconInfo.privilegeCfg.id)
            end
            iconInfo.privilegeCfg = _G.ConfigManager.privilege_cfg[iconCfg.skill_2_id[newSkillLv2]]
            if (not getInfoBol) or (not self.initBol) then
                require("PrivilegeManager"):GetInstance():AddPrivilege(iconInfo.privilegeCfg.id)
            end
            -- if iconInfo.privilegeCfg.id == _G.PrivilegeType.HeroicIconMine.ExploreTime and getInfoBol then

            -- end
        end
    else
        iconInfo.attrCfg[2] = _G.ConfigManager.attribute_cfg[iconCfg.skill_1_id[2][newSkillLv2]]
    end
end

--获取圣像的属性词条配置，特权词条配置
function HeroicIconModel:GetHeroicIconSkill(sid, lv)
    lv = lv or 1
    local index1 = heroic_icons_level_cfg[lv].level_skill[1]
    local index2 = heroic_icons_level_cfg[lv].level_skill[2]
    local iconCfg = heroic_icons_cfg[sid]
    local attrCfg = {}
    local privilegeCfg = {}
    attrCfg[1] = _G.ConfigManager.attribute_cfg[iconCfg.skill_1_id[1][index1]]
    if #iconCfg.skill_1_id == 1 then
        privilegeCfg = _G.ConfigManager.privilege_cfg[iconCfg.skill_2_id[index2]]
    else
        attrCfg[2] = _G.ConfigManager.attribute_cfg[iconCfg.skill_1_id[2][index2]]
    end
    return attrCfg, privilegeCfg
end

function HeroicIconModel:GetAllOtherProp()
    local allProp = { atk = 0, bre = 0, def = 0, max_hp = 0 }
    local cfg = {}
    local levelCfg = {}
    for k, v in ipairs(self.heroic_icons) do
        cfg= heroic_icons_cfg[v.sid]
        if v.level>0 then
            levelCfg=heroic_icons_level_cfg[v.level]
            allProp.atk=allProp.atk+math.ceil(cfg.atk * levelCfg.att_growth / 10000)
            allProp.bre=allProp.bre+math.ceil(cfg.bre * levelCfg.att_growth / 10000)
            allProp.def=allProp.def+math.ceil(cfg.def * levelCfg.att_growth / 10000)
            allProp.max_hp=allProp.max_hp+math.ceil(cfg.max_hp * levelCfg.att_growth / 10000)
        end
    end
    return allProp
end

function HeroicIconModel:GetAllAttribute()
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local attribute = AttributeClassManager:GetAttribtueClass()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.HeroicIcon) then
        local changeAttrTypes = AttributeClassManager:GetChangeAttrTypes(attribute)
        return attribute, changeAttrTypes
    end
    local prop = self:GetAllOtherProp()
    for k, v in pairs(prop) do
        attribute:AddValueByName(k, v, false, _G.AttCountType.other)
    end
    local cfg = {}
    local levelCfg = {}
    local attribute_cfg=_G.ConfigManager.attribute_cfg
    local attrcfg={}
    for k, v in ipairs(self.heroic_icons) do
        cfg= heroic_icons_cfg[v.sid]
        if v.level>0 then
            levelCfg=heroic_icons_level_cfg[v.level]
            for i = 1, #cfg.skill_1_id do
                attrcfg=attribute_cfg[cfg.skill_1_id[i][levelCfg.level_skill[i]]]
                if attrcfg then
                    local value = AttributeClassManager:GetValueWithName(attrcfg.attribute[1][1], tonumber(attrcfg.attribute[1][3]), tonumber(attrcfg.attribute[1][2]))
                    attribute:AddValueByName(attrcfg.attribute[1][1], value, false, tonumber(attrcfg.attribute[1][2]))
                end
            end
        end
    end
    local changeAttrTypes = _G.AttributeClassManager:GetInstance():GetChangeAttrTypes(attribute)
    return attribute, changeAttrTypes
end

--检查圣像是否已满级
function HeroicIconModel:CheckIconMaxLevel(sid)
    local iconInfo = self:GetHeroicIconBySid(sid)
    if iconInfo and not heroic_icons_level_cfg[iconInfo.level + 1] then
        return true
    end
    return false
end

--获取圣像下一阶段的等级，对应等级差，对应第几个词条
function HeroicIconModel:GetHeroicIconSkillNextLv(lv)
    local index1 = heroic_icons_level_cfg[lv].level_skill[1]
    local index2 = heroic_icons_level_cfg[lv].level_skill[2]
    local num = #heroic_icons_level_cfg - lv
    for i = 1, num do
        local newLv = lv + i
        if heroic_icons_level_cfg[newLv].level_skill[1] ~= index1 then
            return newLv, i, 1
        end
        if heroic_icons_level_cfg[newLv].level_skill[2] ~= index2 then
            return newLv, i, 2
        end
    end
    return lv, 0, 0
end

--获取所有阶段提升的等级列表
function HeroicIconModel:GetAllChangeSkillLv()
    local num = #heroic_icons_level_cfg
    local lvTable = {}
    local nowLv = 1
    local index
    for i = 1, num do
        nowLv, index = self:GetHeroicIconSkillNextLv(nowLv)
        if index ~= 0 then
            table.insert(lvTable, nowLv)
        else
            break
        end
    end
    return lvTable
end

--获取矿洞需要挖矿时间
function HeroicIconModel:GetHallNeedTime(sid)
    local hallCfg = _G.ConfigManager.heroic_icons_fruit_cfg[sid]
    local time = hallCfg.time
    return time
end

--获取圣像总等级
function HeroicIconModel:GetIconTotalLevel()
    local lv = 0
    for k, v in ipairs(self.heroic_icons or {}) do
        lv = lv + v.level
    end
    return lv
end

--获取现有道具可以升级对应圣像到多少级
function HeroicIconModel:GetTotalLevelCanUp(sid)
    local totalExp = 0
    local totalLevel = 0
    for i = 1, 4 do
        local _, storageId = _G.StorageManager:GetInstance():CheckSidType(upItem[i])
        local count = _G.StorageManager:GetInstance():GetItemCountByID(storageId, upItem[i])
        totalExp = totalExp + self:CalItemExp({ { k = upItem[i], v = count } })
    end
    local info = self:GetHeroicIconBySid(sid)
    if info then
        local tempExp = info.exp + totalExp + heroic_icons_level_cfg[info.level].exp
        local num = #heroic_icons_level_cfg - info.level
        for i = 1, num do
            if tempExp > heroic_icons_level_cfg[info.level + i].exp then 
                totalLevel = i
            else 
                break
            end
        end
    end
    return totalLevel
end

--获取将对应圣像升upLv级需要的道具列表
function HeroicIconModel:GetConsumeItemByUpLevel(sid, upLv)
    local info = self:GetHeroicIconBySid(sid)
    local tempExp = info.exp
    local tempLv = info.level
    local totalNeedExp = 0
    local consumeItem = {}
    local finalLv = _G.math.min(tempLv + upLv, #heroic_icons_level_cfg)
    totalNeedExp = heroic_icons_level_cfg[finalLv].exp - heroic_icons_level_cfg[tempLv].exp - info.exp
    -- for i = 1, upLv do
    --     if heroic_icons_level_cfg[tempLv + i] then
    --         totalNeedExp = totalNeedExp +
    --             (heroic_icons_level_cfg[tempLv + 1].exp - heroic_icons_level_cfg[tempLv].exp - tempExp)
    --         tempExp = 0
    --         tempLv = tempLv + 1
    --     end
    -- end
    for i = 1, 4 do
        local _, storageId = _G.StorageManager:GetInstance():CheckSidType(upItem[i])
        local count = _G.StorageManager:GetInstance():GetItemCountByID(storageId, upItem[i])
        if totalNeedExp > 0 then
            local exp = self:CalItemExp({ { k = upItem[i], v = 1 } })
            for j = 1, count do
                totalNeedExp = totalNeedExp - exp
                if totalNeedExp <= 0 or j == count then
                    table.insert(consumeItem, { k = upItem[i], v = j })
                    break
                end
            end
        end
    end
    return consumeItem
end

