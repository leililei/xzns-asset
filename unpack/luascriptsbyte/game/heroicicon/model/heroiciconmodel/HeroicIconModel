function HeroicIconModel:UpdateTimer()
    local index, time = self:GetLatestMineAwardIndex()
    self.lastTime = time - _G.TimeUtil.GetServerUnixTime()
    if self.lastTime < 0 then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        if self.maps.mines then
            if #self.maps.mines == 10 then
                --最后一个矿满了刷红点
                require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.HeroicIconMineAward
                    .id)
            else
                --前面的矿满了拉数据刷新新一个矿
                _G.DelayDo(2.5, function()
                    self:GetInfo()
                end)
                
            end
        end
    end
end

