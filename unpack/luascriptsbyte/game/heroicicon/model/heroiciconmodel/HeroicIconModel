function HeroicIconModel:GetHeroicIconBySid(sid)
    for k, v in ipairs(self.heroic_icons or {}) do
        if v.sid == sid then
            return v
        end
    end
end

--增加圣像经验
function HeroicIconModel:AddHeroicIconExp(sid, expNum)
    local info = self:GetHeroicIconBySid(sid)
    if info then
        info.exp = info.exp + expNum
        local oldLv = info.level
        local num = #heroic_icons_level_cfg - info.level
        for i = 1, num do
            if heroic_icons_level_cfg[info.level + 1] then
                local needExp = heroic_icons_level_cfg[info.level + 1].exp - heroic_icons_level_cfg[info.level].exp
                if info.exp >= needExp then
                    info.level = info.level + 1
                    info.exp = info.exp - needExp
                else
                    break
                end
            else
                break
            end
        end
        local newLv = info.level
        if newLv ~= oldLv then
            self.upLvBol = true
            self:FreshHeroicIconSkill(sid, oldLv, newLv)
        end
    end
end

