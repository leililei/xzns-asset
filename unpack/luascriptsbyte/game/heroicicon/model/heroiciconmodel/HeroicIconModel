    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.HeroicIconToggleView.Name)
end

---销毁对象时,析构函数
function HeroicIconModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.OnSixClockUpdateCallback, self)
    if _G.AppSetting.IsXzns then
        _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.OnResUpdate, self)
    end
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.initBol = nil
end

return HeroicIconModel
