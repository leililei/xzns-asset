function HeroicIconModel:HeroicFinishTask(pbData, callback)
    HeroicIconNet:GetInstance():FinishTask(pbData, function(msg)
        if msg.ack == 1 then
            if msg.award then
                self:AddHeroicIcon(msg.award.item[1].type[1])
            end
            if callback then
                callback(msg)
            end
        end
    end)
end

function HeroicIconModel:GetTaskCanFinish(ID)
    local cfg = _G.ConfigManager.heroic_icons_cfg[ID]
    for i = 1, #self.tasks do
        if cfg.open_conditions[1] and cfg.open_conditions[1][1] == self.tasks[i].i_task.sid then
            return self.tasks[i].i_task.state == _G.TaskEnum.ETaskState.Submited
        end
    end
    return false
end

function HeroicIconModel:SetTask(data)
    for i = 1, #self.tasks do
        if data[1].sid == self.tasks[i].i_task.sid then
            self.tasks[i].i_task.state = data[1].state
        end
    end
end

---圣像升级(激活)
function HeroicIconModel:HeroicUpLevel(pbData, callback)
    HeroicIconNet:GetInstance():HeroicUpLevel(pbData, function(msg)
        if msg.ack == 1 then
            local info = self:GetHeroicIconBySid(pbData.sid)
            if info.level == 0 then
                self:FreshHeroicIconSkill(pbData.sid, 0, 1)
                info.level = 1
                require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.HeroicIconIconUnlock
                    .id)
            else
                if msg.award then
                    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                end
                self:AddHeroicIconExp(pbData.sid, self:CalItemExp(pbData.consume))
                for i = 1, #pbData.consume do
                    _G.StorageManager:GetInstance():ConsumeItem(pbData.consume[i].k, nil, pbData.consume[i].v)
                end
            end
        end
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.HeroicIconMineUpgrate.id)
        if callback then
            callback(msg, pbData)
        end
    end)
end

