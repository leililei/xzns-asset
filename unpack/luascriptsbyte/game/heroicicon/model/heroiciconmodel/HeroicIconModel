--根据传入的道具列表（kv结构）计算总共的圣像经验
function HeroicIconModel:CalItemExp(itemList)
    local exp = 0
    local T = _G.ConfigManager.discrete_cfg[128002]
    for k, v in ipairs(itemList) do
        for i = 1, #T do
            if T[i][1] == v.k then
                exp = exp + T[i][2] * v.v
                break
            end
        end
    end
    return exp
end

