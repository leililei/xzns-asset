local NormalAwardSid

---@class RuinData
local RuinData = _G.BaseClass("RuinData")

RuinData.RuinState = {
    Free = "Free",
    Start = "Start",
    Cd = "Cd",
    Get = "Get"
}

function RuinData:InitCfg()
    NormalAwardSid = {}
    local ruins = _G.ConfigManager.heroic_icons_ruins_cfg
    local dropCfg = _G.ConfigManager.drop_cfg
    for _, ruin in pairs(ruins) do
        for _, id in pairs(ruin.drop) do
            for _, v in pairs(dropCfg[id].fixed_drop) do
                if not NormalAwardSid[ruin.id] then
                    NormalAwardSid[ruin.id] = {}
                end
                NormalAwardSid[ruin.id][v[1]] = true
            end
        end
    end
end

function RuinData:__init(data)
    self.sid = data.sid
    self.level = data.level
    self.overTime = data.time
    self.cd = data.cd
    self.award = data.award
    self.overCall = {}
    self.cdOverCall = {}
    self.showAward = nil
    if not NormalAwardSid then
        self:InitCfg()
    end
    for _, v in pairs(self.award) do
        if not NormalAwardSid[self.level][v.type[1]] then
            self.showAward = v
            break
        end
    end
    if self.showAward == nil then
        self.showAward = self.award[1]
    end
    self:CheckState()
end

function RuinData:ResetData(data)
    self.sid = data.sid
    self.level = data.level
    self.overTime = data.time
    self.cd = data.cd
    self.award = data.award
    self.showAward = nil
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    for _, v in pairs(self.award) do
        if not NormalAwardSid[self.level][v.type[1]] then
            self.showAward = v
            break
        end
    end
    if self.showAward == nil then
        self.showAward = self.award[1]
    end
    self:CheckState()
end

function RuinData:CheckState()
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    if self.overTime ~= 0 then
        if self.overTime > serverTime then
            self.ruinState = RuinData.RuinState.Start
            self.timer = _G.TimerManager:GetInstance():GetTimer(self.overTime - serverTime, self.Over, self, false, false,
                true)
            self.timer:Start()
        elseif self.cd > serverTime then
            self.ruinState = RuinData.RuinState.Get
            self.timer = _G.TimerManager:GetInstance():GetTimer(self.cd - serverTime, self.CdOver, self, false, false,
                true)
            self.timer:Start()
        else
            self.ruinState = RuinData.RuinState.Get
        end
    else
        if self.cd > serverTime then
            self.ruinState = RuinData.RuinState.Cd
            self.timer = _G.TimerManager:GetInstance():GetTimer(self.cd - serverTime, self.CdOver, self, false, false,
                true)
            self.timer:Start()
        else
            self.ruinState = RuinData.RuinState.Free
        end
    end
end

function RuinData:CheckOver()
    if self.cd == 0 or self.cd <= _G.TimeUtil.GetServerUnixTime() then
        return true
    end
    return false
end

---注册派遣结束回调
function RuinData:AddOverCall(key, call)
    self.overCall[key] = call
end

---移除派遣结束回调
function RuinData:RemoveOverCall(key)
    self.overCall[key] = nil
end

---移除所有派遣结束回调
function RuinData:RemoveAllOverCall()
    self.overCall = {}
end

---注册cd结束回调
function RuinData:AddCdOverCall(key, call)
    self.cdOverCall[key] = call
end

---移除cd结束回调
function RuinData:RemoveCdOverCall(key)
    self.cdOverCall[key] = nil
end

---移除所有cd结束回调
function RuinData:RemoveAllCdOverCall()
    self.cdOverCall = {}
end

function RuinData:Start(msg)
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end

    self.ruinState = RuinData.RuinState.Start

    self.overTime = msg.time
    self.cd = msg.cd
    self.timer = _G.TimerManager:GetInstance():GetTimer(self.overTime - _G.TimeUtil.GetServerUnixTime(), self.Over, self,
        false, false, true)
    self.timer:Start()
end

---派遣结束，进入cd
function RuinData:Over()
    for _, v in pairs(self.overCall) do
        v()
    end
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.ruinState = RuinData.RuinState.Get
    self.timer = _G.TimerManager:GetInstance():GetTimer(self.cd - _G.TimeUtil.GetServerUnixTime(), self.CdOver, self,
        false, false, true)
    self.timer:Start()
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.HeroicIconMineSG.id)
end

---cd结束，进入可派遣阶段
function RuinData:CdOver()
    for _, v in pairs(self.cdOverCall) do
        v()
    end
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.ruinState == RuinData.RuinState.Get then
        self.cd = 0
        self.overTime = 0
    elseif self.ruinState == RuinData.RuinState.Cd then
        self.ruinState = RuinData.RuinState.Free
    end
end

function RuinData:Dispose()
    self.cdOverCall = nil
    self.overCall = nil
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return RuinData