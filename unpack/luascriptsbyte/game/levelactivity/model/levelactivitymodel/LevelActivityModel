local LevelActivityNet = require "LevelActivityNet"

---@class LevelActivityModel : Singleton 等级活到
local LevelActivityModel = _G.BaseClass("LevelActivityModel", _G.GameDataModelBase)

---@return LevelActivityModel LevelActivityModel
function LevelActivityModel:GetInstance()
    return self.super.GetInstance(self)
end

function LevelActivityModel:GetInfo(callback)
    LevelActivityNet:GetInstance():GetInfo(_G.handlerbind(self, self.GetInfoCall, callback))
end
---@param data level_activity.s2c_level_activity_info
function LevelActivityModel:GetInfoCall(data, callback)
    self.sids = data.sids
    if callback then
        callback()
    end
end

---领取奖励
function LevelActivityModel:GetReward(sid, callback)
    LevelActivityNet:GetInstance():GetAward({sid = sid}, _G.handlerbind(self, self.GetRewardCall, sid, callback))
end

---领取奖励回调
function LevelActivityModel:GetRewardCall(data, sid, callback)
    if data.ack ~= 1 then
        return
    end
    _G.StorageManager:GetInstance():ReceiveAwardData(data)
    require "CommonTipManager".OpenCommonAwardView(data)
    if not self.sids then
        self.sids = {}
    end
    _G.table.insert(self.sids, sid)
    self:RefreshRedPoint()
    if callback then
        callback()
    end
end

---检测是否已全部领取
function LevelActivityModel:CheckIsFinish()
    if not self.sids then
        return false
    end
    return _G.table.count(_G.ConfigManager.level_activity_cfg) <= #self.sids
end

---检测该等级奖励是否领取
function LevelActivityModel:CheckLvIsGet(sid)
    if not self.sids then
        return false
    end
    for _, v in pairs(self.sids) do
        if v == sid then
            return true
        end
    end
    return false
end

--region 对外接口 红点
---活动检测红点
function LevelActivityModel:CheckeRedPointLevelActive()
    --检测是否 有可以领取得奖励
    local cfg = _G.ConfigManager.level_activity_cfg
    local playerLevel = _G.PlayerModel:GetInstance():GetLevel()
    local temp = {}
    for key, value in pairs(cfg) do
        if value.level <= playerLevel then
            _G.table.insert(temp, value.id)
        end
    end
    if _G.table.isEmptyOrNil(temp) then
        return 0
    end
    if not self.sids then
        return 1
    end
    for i = 1, #temp do
        local flag = false
        for j = 1, #self.sids do
            if temp[i] == self.sids[j] then
                flag = true
                break
            end
        end
        if not flag then
            return 1
        end
    end
    return 0
end
--endregion
---设置红点刷新
function LevelActivityModel:SetFreshRedPoint(RefreshRedPointCall)
    self.RefreshRedPointCall = RefreshRedPointCall
end
function LevelActivityModel:RefreshRedPoint()
    if self.RefreshRedPointCall ~= nil then
        self.RefreshRedPointCall()
    end
end
return LevelActivityModel
