local base = require "ActivitySynTypeBase"
---@class LevelActivitySynModel : ActivitySynTypeBase	中文描述
local LevelActivitySynModel = _G.BaseClass("LevelActivitySynModel", base)
-- _G.LevelActivitySynModel = LevelActivitySynModel

-- local CS = _G.CS
-- local typeof = _G.typeof

---创建对象时,入口构造函数
function LevelActivitySynModel:__init()
    self.LevelActivityModel = require "LevelActivityModel":GetInstance()
    self.LevelActivityModel:SetFreshRedPoint(_G.handler(self, self.RefreshRedPoint))
end

--- 网络请求初始化
function LevelActivitySynModel:GetDataFormServer()
    self.LevelActivityModel:GetInfo(_G.handler(self, self.ParseData))
end
---数据解析完成
function LevelActivitySynModel:ParseData()
    base.ParseData(self)
end
function LevelActivitySynModel:InitFunction()
    self.LevelActivityModel:InitFunction()
    if self.LevelActivityModel:CheckIsFinish() then
        self.curActivityClass:ChangeState(require "ActivitySynManager".State.Close)
    end
end
---进入活动主体
function LevelActivitySynModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LevelActivityView.Name,self.curActivityClass)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end
function LevelActivitySynModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.LevelActivityView.Name
end
---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function LevelActivitySynModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end
function LevelActivitySynModel:CheckRedPoint()
    return self.LevelActivityModel:CheckeRedPointLevelActive()
end
---刷新奖励红点
function LevelActivitySynModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function LevelActivitySynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end
--endregion

--endregion
---销毁对象时,析构函数
function LevelActivitySynModel:Dispose()
end

return LevelActivitySynModel
