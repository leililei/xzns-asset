---@class LevelActivityNet : BaseGameNet	通信协议
local LevelActivityNet = _G.BaseClass("LevelActivityNet", require "BaseGameNet")
local base = require "BaseGameNet"

---@return LevelActivityNet LevelActivityNet
function LevelActivityNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---获取等级福利信息
---@param pbData table PB数据
---@param callback function 完成回调
function LevelActivityNet:GetInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_level_activity_info
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---领取奖励
function LevelActivityNet:GetAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_level_activity_gate
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function LevelActivityNet:CallBack(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type LevelActivityNet
_G.LevelActivityNet = LevelActivityNet
return LevelActivityNet
