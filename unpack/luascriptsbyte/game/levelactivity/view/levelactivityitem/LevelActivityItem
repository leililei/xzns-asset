    end]]
    self.go_table.aorbtn_notReach:SetGray(notReach)
    self.go_table.obj_uieffect:RemoveAllChildren()
    -- if canGet then
    --     _G.DelayFrameDo(function()
    --         self:LoadEff(self.cfg)
    --     end)
    -- end
end

function LevelActivityItem:LoadEff(cfg,Parent)
    local effCfg = _G.StorageManager:GetInstance():GetCommonLightEffect(cfg[1])
    if effCfg then
        _G.UIUtils.LoadEffectByCfg(
            effCfg,
            Parent,
            function(trans)
                if not _G.IsNil(trans) then
                    trans:RequireComponentE(_G.typeof(_G.CS.UIParticleOrderChange))
                end
            end
        )
    end
end

---物品内容选中显示
function LevelActivityItem:tanQuanDianJi(data, Parent)
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            data,
            Parent,
            function(item)
                item.gameObject:SetLocalScaleXYZ(1)
                _G.GameUtil.SetActiveByCondition(item.gameObject, true)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                item.gameObject:SetLocalPosition(0, 0, 0)
                -- self.item[insId] = item
                item:SetGou(self.isGet)
                if self.isGet then
                    _G.GameUtil.SetActiveByCondition(self.go_table.obj_uieffect, false)
                else
                    _G.GameUtil.SetActiveByCondition(self.go_table.obj_uieffect, not self.isLock)
                end
                if item.SetGradeNew then
                    item:SetGradeNew(false)
                end
                item.gameObject:SetRectTransformSize(88,88)
                self:LoadEff(data,item.gameObject)
            end,
            function(go, isOn)
                if not self.isGet and not self.isLock then
                    self:GetReward()
                else
                    if go.gameObject then
                        require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data[1])
                    else
                        require("CommonTipManager"):GetInstance():OpenTip(go[1].gameObject, data[1])
                    end
                end
            end
        )
end
function LevelActivityItem:OnClickBtn(go, isOn)
    if not self.isGet and not self.isLock then
        self:GetReward()
        return
    end
    if go == self.go_table.aorbtn_onIcon then
        local type = _G.StorageManager:GetInstance():CheckSidType(self.cfg.reward[1][1])
        if type == _G.StorageType.Card then
            _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.FuliView.Name)
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CommonIllustrationsH5View.Name,
                self.cfg.reward[1][1],
                function()
                    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.FuliView.Name)
                end
            )
        else
            require "CommonTipManager":GetInstance():OpenTip(go.gameObject, self.cfg.reward[1][1])
        end
    else
    end
end

function LevelActivityItem:GetReward()

    require "LevelActivityModel":GetInstance():GetReward(
        self.cfg.id,
        function()
            self.isGet = true
            self:UpdatePanel()
            self.getCall()
            -- _G.GameUtil.SetActiveByCondition(self.go_table.obj_lock, self.isGet)
        end
    )
end

---类的析构函数
function LevelActivityItem:Dispose()
end

return LevelActivityItem
