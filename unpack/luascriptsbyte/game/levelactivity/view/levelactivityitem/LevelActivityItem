---@class LevelActivityItem	中文描述
local LevelActivityItem = _G.BaseClass("LevelActivityItem")

---类的构造函数
function LevelActivityItem:__init(obj,getCall)
    self.getCall = getCall
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end

---@param cfg level_activity_cfg
function LevelActivityItem:Show(cfg, index)
    --_G.GameUtil.SetActiveByCondition(self.go_table.obj_di1, true)

    self.item = {}
    self.canGet = false
    self.isLock = cfg.level > _G.PlayerModel:GetInstance():GetLevel()
    self.isGet = require "LevelActivityModel":GetInstance():CheckLvIsGet(cfg.id)
    self.cfg = cfg
    self:UpdatePanel()
end

function LevelActivityItem:UpdatePanel()
    --local type = _G.StorageManager:GetInstance():CheckSidType(data.sid)

    --_G.GameUtil.SetActiveByCondition(self.go_table.aorimage_icon, self.isLock)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_uieffect, not self.isLock)
    --self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(data.cfg.Name or data.cfg.name)
    self.go_table.aortext_lv.text = _G.LangUtil.GetLangPackValue(32001170401,self.cfg.level) .. "(" .. _G.PlayerModel:GetInstance():GetLevel() .. "/" .. self.cfg.level .. ")"

    self.canGet = (not self.isGet) and (not self.isLock)
    local notReach = (not self.isGet) and self.isLock
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_click, self.canGet)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_notReach, notReach)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_isGet,  self.isGet)

    self.go_table.obj_Root:ClearChildren()
    for k, v in pairs(self.cfg.reward) do
        self:tanQuanDianJi(v, self.go_table.obj_Root)
    end

