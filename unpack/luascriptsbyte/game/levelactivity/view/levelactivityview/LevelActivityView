local LevelActivityItem = require "LevelActivityItem"
---@class LevelActivityView : UIBaseView	中文描述
---@field public go_table LevelActivityView_GoTable GoTable
---@field itemList LevelActivityItem[]
local LevelActivityView = _G.BaseClass("LevelActivityView", _G.UIBaseView)

function LevelActivityView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function LevelActivityView:OnCreate(activity)
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.LevelActivityView, self.go_table)
    self.itemList = {}
    self.activity=activity
    self.cfgCount = _G.table.count(_G.ConfigManager.level_activity_cfg) - 1
    self.maxCfg = _G.ConfigManager.level_activity_cfg[self.cfgCount + 1]
    self.go_table.scrollloopvectical_rankList:InitItemData(0, _G.handler(self,self.RefreshItem))
    self:UpdateList()
    self.playerLevel = _G.PlayerModel:GetInstance():GetLevel()
    self.go_table.aortext_lv.text = _G.GetLangPackValue(32001170403,self.playerLevel)
    --self.item = {}
    self:MaxXiaShi()
end

---@param listview2 SuperScrollView.LoopListView2
function LevelActivityView:RefreshItem(index,obj)
    local newIndex = index + 1
    local cfg = self.cfgs[newIndex]
    local id = obj:GetInstanceIDE()
    local item = self.itemList[id]
    if not item then
        item = LevelActivityItem.New(obj, _G.handler(self, self.GetCall))
        self.itemList[id] = item
    end
    item:Show(cfg, newIndex)
end

--最后一个物品单独显示
function LevelActivityView:MaxXiaShi()
    self.go_table.obj_Root:ClearChildren()
    self.isLock = self.maxCfg.level > _G.PlayerModel:GetInstance():GetLevel()
    self.isGet = require "LevelActivityModel":GetInstance():CheckLvIsGet(self.maxCfg.id)
    local canGet = (not self.isGet) and (not self.isLock)
    local notReach = (not self.isGet) and self.isLock
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_lingqu, canGet)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_notReach, notReach)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_isGet,  self.isGet)
    self.go_table.aorbtn_notReach:SetGray(notReach)
    --_G.GameUtil.SetActiveByCondition(self.go_table.aorimage_icon, self.isLock)
    --if self.isLock then
    --    _G.GameUtil.SetActiveByCondition(self.go_table.obj_uieffect, false)
    --else
    --    _G.GameUtil.SetActiveByCondition(self.go_table.obj_uieffect, not self.isGet)
    --end
    self.go_table.aortext_Level.text = _G.LangUtil.GetLangPackValue(32001170402, self.maxCfg.level)

    for i = 1, #self.maxCfg.reward do
        self:XianSHi(self.maxCfg.reward[i], self.go_table.obj_Root)
    end
end
---物品内容选中显示
function LevelActivityView:XianSHi(data, Parent)
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        data,
        Parent,
        function(item)
            item.gameObject:SetLocalScaleXYZ(1.2)
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            --item.gameObject:SetLocalPosition(0, 0, 0)
            item:SetGou(self.isGet)
            --self.item = item
        end,
        function(go, isOn)
            if not self.isGet and not self.isLock then
                self:PanDuan()
            else
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data[1])
            end
        end
    )
end

---初始化进度条
function LevelActivityView:InitSlider()
    self.go_table.aortext_lv.text = self.playerLevel
    -- self.go_table.aorlooplist_sliderItem:StartUpdataDragInfo(
    --     _G.table.count(self.cfgs),
    --     _G.handler(self, self.RefreshSliderItem)
    -- )
    local maxValue = 128.5 + (self.cfgCount - 1) * 96
    --self.go_table.slider_progress.maxValue =maxValue
    local value = 0
    if self.playerLevel < self.cfgs[1].level then
        value = 50 + self.playerLevel * (68.5 / self.cfgs[1].level)
    elseif self.playerLevel >= self.cfgs[#self.cfgs].level then
        value = maxValue
    else
        local per, count = self:GetNextLevel()
        value = 128.5 + (count - 1) * 96 + per
    end
    --self.go_table.slider_progress.value =value
    --self.go_table.slider_progress:SetRectTransformSize(maxValue, 64)
end

function LevelActivityView:GetNextLevel()
    local lastLevel = 0
    local nextLevel = 0
    local count = 0
    for i = 1, self.cfgCount do
        if self.playerLevel < self.cfgs[i].level then
            nextLevel = self.cfgs[i].level
            break
        else
            count = i
            lastLevel = self.cfgs[i].level
        end
    end
    return 96 / (nextLevel - lastLevel) * (self.playerLevel - lastLevel), count
end

function LevelActivityView:RefreshSliderItem(trans, index)
    local tb = _G.GetAutoGoTable(trans)
    local data = self.cfgs[index + 1]
    tb.aortext_lv.text = data.level
    _G.GameUtil.SetActiveByCondition(tb.obj_off, data.level <= self.playerLevel)
    _G.GameUtil.SetActiveByCondition(tb.obj_on, data.level > self.playerLevel)
end

function LevelActivityView:PanDuan()
    self.isLock = self.maxCfg.level > _G.PlayerModel:GetInstance():GetLevel()
    self.isGet = require "LevelActivityModel":GetInstance():CheckLvIsGet(self.maxCfg.id)

    if not self.isGet and not self.isLock then
        require "LevelActivityModel":GetInstance():GetReward(
            self.maxCfg.id,
            function()
                self.isGet = true
                self:MaxXiaShi()
                --self.item:SetGou(self.isGet)
                --if self.isLock then
                --    _G.GameUtil.SetActiveByCondition(self.go_table.obj_uieffect, false)
                --else
                --    _G.GameUtil.SetActiveByCondition(self.go_table.obj_uieffect, not self.isGet)
                --end
                self:GetCall()
                -- _G.GameUtil.SetActiveByCondition(self.go_table.obj_lock, self.isGet)
            end
        )
    end
end

function LevelActivityView:UpdateList()
    local cfgs = {}
    local index = 1
    local cfg = _G.ConfigManager.level_activity_cfg
    for i = 1, #cfg do
        if cfg[i].id ~= #cfg then
            cfgs[index] = cfg[i]
            index = index + 1
        end
    end
    _G.SortList(
            cfgs,
            function(v)
                local type = 0
                if require "LevelActivityModel":GetInstance():CheckLvIsGet(v.id) then
                    type = -99
                else
                    type = 99
                end
                return type, -v.id
            end
    )
    self.cfgs = cfgs
    self.go_table.scrollloopvectical_rankList:UpdateCount(self.cfgCount)
end

function LevelActivityView:GetCall()
    self:UpdateList()
    if require "LevelActivityModel":GetInstance():CheckIsFinish() then
        self.activity:ChangeState(require "ActivitySynManager".State.Close)
     end
end

---按钮点击事件在这里派发
function LevelActivityView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_lingqu then
        self:PanDuan()
    end
end
function LevelActivityView:CloseView()
    self:Close()
end
return LevelActivityView
