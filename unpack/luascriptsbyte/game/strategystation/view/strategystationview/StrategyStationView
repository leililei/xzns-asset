local StrategyStationModel = require("StrategyStationModel")
local CommonTipManager = require("CommonTipManager")

---@class StrategyStationView : UIBaseView    中文描述
---@field public go_table StrategyStationView_GoTable GoTable
---@field orderLis StrategyStationView._obj_num1_GoTable[]
local StrategyStationView = _G.BaseClass("StrategyStationView", _G.UIBaseView)

local GetAutoGoTable = _G.GetAutoGoTable
local GetLangPackValue = _G.GetLangPackValue
local ConfigManager = _G.ConfigManager
local table = _G.table
local handler = _G.handler
local handlerbind = _G.handlerbind
local strategy_station_cfg = ConfigManager.strategy_station_cfg
local discrete_cfg = ConfigManager.discrete_cfg

local url =
    "https://zhjtwdl-chat.opop113.com:1443/ls/home?uid=%s&head=101_s&robotId=1535108524338155522"

local discreteID = {
    TagName = 112001,
    TagSort = 112002,
    Awards = 112003
}
local artTypePic = {
    "ui_sc_lb_biaoqian04_tag", --热门
    "ui_sc_lb_biaoqian05_tag", --精华
    "ui_sc_lb_biaoqian03_tag" --推荐
}
local artTypeText = {
    GetLangPackValue(90030500001), --热门
    GetLangPackValue(90030500002), --精华
    GetLangPackValue(90030500003) --推荐
}

function StrategyStationView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function StrategyStationView:OnCreate()
    self.tagId = discrete_cfg[discreteID.TagSort][1]
    self.tagDic = {}
    for _, v in pairs(discrete_cfg[discreteID.TagName]) do
        self.tagDic[v[1]] = {}
        self.tagDic[v[1]].name = GetLangPackValue(v[2])
        self.tagDic[v[1]].articles = {}
    end
    for _, v in pairs(strategy_station_cfg) do
        if self.tagDic[v.group] then
            self.tagDic[v.group].articles[v.page] = v
        end
    end
    self.curOrder = StrategyStationModel:GetInstance():GetInputDic()
    self:InitView()
    _G.PlayerPrefsManager.SetInt("StrategyStation", _G.TimeUtil.GetDayBegin(_G.TimeUtil.GetServerUnixTime()))
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.StrategyStation.id)
    -- self:LoadEffect()
end

function StrategyStationView:LoadEffect()
    local check = function(trans)
        if self:IsNil() then
            _G.DestroyObject(trans)
        end
    end
    _G.UIUtils.LoadEffectByCfg(ConfigManager.ui_effect_cfg.ef_StrategyStationView_Bg, self.go_table.obj_view, check)
end

---初始化页面
function StrategyStationView:InitView()
    self.curTag = 1
    self.curTagId = self.tagId[self.curTag]
    self.awards = discrete_cfg[discreteID.Awards]
    self.orderLis = {}
    for i = 1, 4 do
        self.orderLis[i] = GetAutoGoTable(self.go_table["obj_num" .. i], handler(self, self.OnClickNum))
        -- self.orderLis[i].input_Num.onEndEdit:AddListener(_G.handlerbind(self, self.OnEndEditorDeclarationOen, i))
        -- self.orderLis[i].input_Num.onValueChanged:AddListener(_G.handlerbind(self, self.OnValueChanged, i))
    end
    -- self.go_table.scrollloopvectical_tag:InitItemData(#self.tagId, _G.handler(self, self.RefreshTag))
    -- self.go_table.scrollloopvectical_strategy:InitItemData(0, _G.handler(self, self.RefreshArticle))
    self:UpdateView()
    self:UpdateOrder()
end

function StrategyStationView:UpdateView()
    self.go_table.scrollloopvectical_strategy:UpdateCount(#self.tagDic[self.curTagId].articles)
end

function StrategyStationView:UpdateOrder()
    local isAward = StrategyStationModel:GetInstance():CheckIsAward()
    local knowIdx = StrategyStationModel:GetInstance().index
    local canInput
    for i = 1, 4 do
        canInput = not isAward and knowIdx ~= i
        -- self.orderLis[i].input_Num:SetActiveE(canInput and 1 or 0)
        -- self.orderLis[i].aortext_num:SetActiveE(canInput and 0 or 1)
        self.orderLis[i].aorimage_light:SetActiveE(canInput and 0 or 1)
        if not canInput then
            self.orderLis[i].aortext_num.text = StrategyStationModel:GetInstance():GetNumByIndex(i)
        else
            self.orderLis[i].aortext_num.text = ""
        end
    end
    self.go_table.aorimage_box.SpriteName = isAward and "ui_zjm_btn_baoxiang2" or "ui_zjm_btn_baoxiang1"
    self.go_table.aorimage_boxMask:SetActiveE(isAward and 1 or 0)
end

function StrategyStationView:RefreshTag(index, obj)
    index = index + 1
    ---@type StrategyStationView._obj_tagItem_GoTable
    local tb = GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickTag, index))
    tb.aortext_title.text = self.tagDic[self.tagId[index]].name
    local color = index == self.curTag and "70450e" or "d4d5ed"
    tb.aorimage_isOn:SetActiveE(index == self.curTag and 1 or 0)
    tb.aortext_title.color = _G.ColorTools.FormatColorByString(color)
end

function StrategyStationView:RefreshArticle(index, obj)
    index = index + 1
    local cfg = self.tagDic[self.curTagId].articles[index]
    if cfg == nil then
        return
    end
    ---@type StrategyStationView._obj_strategyItem_GoTable
    local tb = GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickArticle, cfg.desc))
    if cfg.Type1 > 0 then
        tb.aorimage_hot:SetActiveE(1)
        tb.aortext_hot.text = artTypeText[cfg.Type1]
        tb.aorimage_hot.SpriteName = artTypePic[cfg.Type1]
    else
        tb.aortext_hot.text = ""
        tb.aorimage_hot:SetActiveE(0)
    end
    tb.aorrawimage_title.Alpha = 0
    tb.aorrawimage_title:LoadImage(
        cfg.picture,
        function(trans)
            trans:SetNativeSize()
        end
    )
end

function StrategyStationView:RefreshAward(index, obj)
    index = index + 1
    local data = self.awards[index]
    local sid = data[1]
    local tb = GetAutoGoTable(obj)
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        data,
        obj,
        function(item)
            item.gameObject:SetLocalScaleXYZ(0.7955)
            item.gameObject:SetActiveE(1)
            -- item:SetGou(isGou)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end,
        function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, sid)
        end
    )
end

---输入框结束监听，弃用
function StrategyStationView:OnEndEditorDeclarationOen(num, index)
    if table.count(self.curOrder) == 4 then
        if StrategyStationModel:GetInstance():CheckOrder(self.curOrder) then
            StrategyStationModel:GetInstance():GetAward(self.curOrder, _G.handler(self, self.UpdateOrder))
        else
            for i = 1, 4 do
                if i ~= StrategyStationModel:GetInstance().index then
                    self.orderLis[i].input_Num.text = ""
                end
            end
            self.curOrder = StrategyStationModel:GetInstance():GetInputDic()
            _G.PopWindowManager:GetInstance():ShowAllTips(911101)
        end
    end
end

---输入框输入监听，弃用
function StrategyStationView:OnValueChanged(num, index)
    if num == "-" then
        self.orderLis[index].input_Num.text = ""
        return
    end
    if num ~= "" then
        self.curOrder[index] = _G.tonumber(num)
        local nextIdx = self:FindNextEmptyIndex(index)
        if nextIdx then
            self.orderLis[index].input_Num:DeactivateInputField()
            self.orderLis[nextIdx].input_Num:ActivateInputField()
        end
    end
end

function StrategyStationView:FindNextEmptyIndex(index)
    local nextIdx
    for i = 1, 4 do
        nextIdx = index + i
        if nextIdx > 4 then
            nextIdx = nextIdx - 4
        end
        if self.curOrder[nextIdx] == nil then
            return nextIdx
        end
    end
    return nil
end

---点击密令数字
function StrategyStationView:OnClickNum()
    _G.LogError("11111111111")
    if StrategyStationModel:GetInstance():CheckIsAward() then
        return
    end
    _G.UIManager:GetInstance():OpenWindow(
        ConfigManager.ui_cfg.StrategyStationKeyboardView.Name,
        _G.handler(self, self.UpdateOrder)
    )
end

function StrategyStationView:OnClickArticle(go, isOn, url)
    _G.SDKManager:GetInstance():DoykOpenUrl(url)
end

function StrategyStationView:OnClickTag(go, isOn, index)
    if index == self.curTag then
        return
    end
    self.curTag = index
    self.curTagId = self.tagId[self.curTag]
    self:UpdateView()
    self.go_table.scrollloopvectical_tag:UpdateAllItem()
end

---打开客服面板
function StrategyStationView:OpenServiceAi()
    local str =
        _G.string.format(
        url,
        _G.tostring(_G.PlayerModel:GetInstance():GetPlayerUid())
    )
    if _G.AppSetting.DEBUG then
        _G.Log(str, "智能助手地址")
    end
    _G.SDKManager:GetInstance():DoykOpenUrl(str)
end

---按钮点击事件在这里派发
function StrategyStationView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 107)
    elseif go == self.go_table.aorbtn_help1 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 109)
    elseif go == self.go_table.aorbtn_assistant then
        self:OpenServiceAi()
    elseif go == self.go_table.aorbtn_box then
        self.go_table.aorbtn_TipsView:SetActiveE(1)
        if not self.awardInit then
            self.go_table.scrollloopvectical_award:InitItemData(#self.awards, _G.handler(self, self.RefreshAward))
            self.awardInit = true
        end
    elseif go == self.go_table.aorbtn_TipsView then
        self.go_table.aorbtn_TipsView:SetActiveE(0)
    end
end

---@private
function StrategyStationView:OnDestroy()
end

return StrategyStationView
