local ItemCardBodySelectView = require("ItemCardBodySelectView")
local JewelryRecommendItem = require("JewelryRecommendItem")
local RuneRecommendItem = require("RuneRecommendItem")

---@class StrategyStationTipView : UIBaseView 窗口
---@field private go_table StrategyStationTipView_GoTable GoTable
local StrategyStationTipView = BaseClass("StrategyStationTipView",_G.UIBaseView)

local equipmentType = {
    90000300105,
    90000300205,
    90000300305
}
local equipmentIcon = {
    "ui_zbsx_liliang_icom",
    "ui_zbsx_xunjie_icom",
    "ui_zbsx_zhili_icom"
}

function StrategyStationTipView:__init()

end

---@class StrategyStationTipView.OpenData
---@field public cardData CardData 英雄数据
---@field public isShowBtn boolean 是否显示一键穿戴按钮

function StrategyStationTipView:OnCreate(msg)
    self:InitData(msg)
    self:RefreshData()
    self:InitUI()
    self:RefreshUI()
end

---@param msg StrategyStationTipView.OpenData
function StrategyStationTipView:InitData(msg)
    self.msg = msg

    self.CardData = msg.cardData

    ---@type CardData[]
    local CardDataSortList = _G.StorageManager:GetInstance():GetCardDataSortList()
    local count = #CardDataSortList
    if msg.isShowBtn ~= nil then
        self.isHasCard = msg.isShowBtn
    else
        --是否拥有角色卡
        self.isHasCard = false
        for i = 1, count do
            if CardDataSortList[i].sid == self.CardData.sid then
                self.isHasCard = true
                break
            end
        end
    end
end

function StrategyStationTipView:RefreshData()

end

function StrategyStationTipView:InitUI()
    self.go_table = _G.GetAutoGoTable(self.gameObject,handler(self,self.onClick))

    ---@type ItemCardBodySelectView
    self.cardItem = ItemCardBodySelectView.New(self.go_table.obj_cardItem)
    ---@type JewelryRecommendItem
    self.jewelryRecommendItem = JewelryRecommendItem.New(self.go_table.obj_RewardViewItem1,self)
    ---@type RuneRecommendItem
    self.runeRecommendItem = RuneRecommendItem.New(self.go_table.obj_RewardViewItem2,self)
end

function StrategyStationTipView:RefreshUI()
    self.cardItem:ShowCardData(self.CardData)

    require("CardInfoManager"):GetInstance():SetElementsProfessionalSP(
            self.go_table.aorimage_equipment,
            self.CardData.cfg.Elements_new,
            self.go_table.aorimage_profession,
            self.CardData.cfg.Professional
    )
    self.go_table.aortext_profession.text = _G.GetLangPackValue(_G.ProfessionalStrEnum[self.CardData.cfg.Professional])
    self.go_table.aortext_equipment.text = _G.GetLangPackValue(equipmentType[self.CardData.cfg.EquipmentType])
    self.go_table.aorimage_equipment.SpriteName = equipmentIcon[self.CardData.cfg.EquipmentType]

    local posText
    local posId = self.CardData.cfg.card_position1
    if posId > 0 then
        posText = _G.GetLangPackValue(posId)
    end
    posId = self.CardData.cfg.card_position2
    if posId > 0 then
        posText = posText .. "/" .. _G.GetLangPackValue(posId)
    end
    self.go_table.aortext_position.text = posText

    self.go_table.aortext_heroDes.text = GetLangPackValue(self.CardData.cfg.desc)

    self.jewelryRecommendItem:RefreshItem(self.CardData)
    self.runeRecommendItem:RefreshItem(self.CardData)
    GameUtil.ReBuildRTF(self.go_table.obj_RewardViewItem1)
    GameUtil.ReBuildRTF(self.go_table.obj_RewardViewItem2)
    GameUtil.ReBuildRTF(self.go_table.obj_Content)
end

function StrategyStationTipView:onClick(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end

---@return StrategyStationTipView
return StrategyStationTipView