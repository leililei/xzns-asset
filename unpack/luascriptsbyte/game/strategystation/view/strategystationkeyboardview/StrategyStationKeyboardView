local StrategyStationModel = require("StrategyStationModel")

---@class StrategyStationKeyboardView : UIBaseView    中文描述
---@field public go_table StrategyStationKeyboardView_GoTable GoTable
---@field orderLis StrategyStationKeyboardView._obj_num1_GoTable[]
local StrategyStationKeyboardView = _G.BaseClass("StrategyStationKeyboardView", _G.UIBaseView)

local GetAutoGoTable = _G.GetAutoGoTable
local handler = _G.handler
local discrete_cfg = ConfigManager.discrete_cfg


local discreteID = {
    TagName = 112001,
    TagSort = 112002,
    Awards = 112003
}
function StrategyStationKeyboardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function StrategyStationKeyboardView:OnCreate(callback)
    self.callback = callback
    self.curOrder = StrategyStationModel:GetInstance():GetInputDic()
    self:InitView()
end

---初始化页面
function StrategyStationKeyboardView:InitView()
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.StrategyStationKeyboardView, self.go_table)
    self.awards = discrete_cfg[discreteID.Awards]
    self.go_table.aorbtn_TipsView:SetActiveE(0)

    self.orderLis = {}
    for i = 1, 4 do
        self.orderLis[i] = GetAutoGoTable(self.go_table["obj_num" .. i])
    end
    --- 对话ID下标
    self.index = 0
    self:UpdateOrder()
    self:InitEffAndAnimetion()
    self:ShowTalkPop()
     _G.PlayerPrefsManager.SetString(tostring(_G.PlayerModel:GetInstance().role_uid) ..
        "RedPointFriendsShare",_G.TimeUtil.GetServerUnixTime())
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedPointFriendsShare.id)

end

function StrategyStationKeyboardView:ShowTalkPop(emData)
    if self.IsDoingTalk then
        return
    end

    self.IsDoingTalk = true

    self.index = self.index + 1

    if self.index > #_G.ConfigManager.discrete_cfg[112004][1] then
        self.index = 1
    end

    local txtID = _G.ConfigManager.discrete_cfg[112004][1][self.index]
    local knowIdx = StrategyStationModel:GetInstance().index

    if self.index == 1 then
        self.go_table.aortext_show.text = GetLangPackValue(txtID,
            StrategyStationModel:GetInstance():GetNumByIndex(knowIdx))
    else
        self.go_table.aortext_show.text = GetLangPackValue(txtID)
    end

    _G.DelayDo(5, function()
        if self:IsNil() then
            return
        end
        self.IsDoingTalk = false
        self:ShowTalkPop()
    end)
end

function StrategyStationKeyboardView:InitEffAndAnimetion()
    if not _G.UIUtils.IsHaveChange(_G.IsNeedChangeUI.StrategyStationKeyboardView, "obj_prf") then
        _G.UIUtils.LoadEffectByPath(
                "WX_Role/Animation_UI/Honglongmizang_UI/prf_Honglongmizang_UI_ui",
                self.go_table.obj_prf,
                function(trans)

                end
        )
    end
end

function StrategyStationKeyboardView:RefreshAward(index, obj)
    index = index + 1
    local data = self.awards[index]
    local sid = data[1]
    local tb = GetAutoGoTable(obj)
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        data,
        obj,
        function(item)
            item.gameObject:SetLocalScaleXYZ(1)
            item.gameObject:SetActiveE(1)
            -- item:SetGou(isGou)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end,
        function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, sid)
        end
    )
end

function StrategyStationKeyboardView:UpdateOrder()
    local isAward = StrategyStationModel:GetInstance():CheckIsAward()
    local knowIdx = StrategyStationModel:GetInstance().index
    local canInput
    for i = 1, 4 do
        canInput = not isAward and knowIdx ~= i
        self.orderLis[i].aorimage_light:SetActiveE(canInput and 0 or 1)
        if not canInput then
            self.orderLis[i].aortext_num.text = StrategyStationModel:GetInstance():GetNumByIndex(i)
        else
            self.orderLis[i].aortext_num.text = ""
        end
    end
    self.go_table.aorimage_box.SpriteName = isAward and "ui_hd_sqdlw_icon_bx_3" or "ui_hd_sqdlw_icon_bx_1"
    self.go_table.aorimage_boxMask:SetActiveE(isAward and 1 or 0)
end

function StrategyStationKeyboardView:Input(num)
    local index = self:FindFirstEmptyIndex()
    if index then
        self.orderLis[index].aortext_num.text = num
        self.curOrder[index] = num
        if _G.AppSetting.IsXzns then--星座输入后颜色改变
            self.orderLis[index].aortext_num.color = _G.ColorTools.FormatColorByString("754911")
        end
    end
end

function StrategyStationKeyboardView:FindFirstEmptyIndex()
    for i = 1, 4 do
        if self.curOrder[i] == nil then
            return i
        end
    end
    return nil
end

function StrategyStationKeyboardView:OnGetAwardCall()
    if self.callback then
        self.callback()
    end
    self:Close()
end

---按钮点击事件在这里派发
function StrategyStationKeyboardView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_closeView then
        self:Close()
    elseif go == self.go_table.aorbtn_cancel then
        self:Close()
    elseif go == self.go_table.aorbtn_sure then
        if StrategyStationModel:GetInstance():CheckOrder(self.curOrder) then
            StrategyStationModel:GetInstance():GetAward(self.curOrder, _G.handler(self, self.OnGetAwardCall))
        else
            for i = 1, 4 do
                if i ~= StrategyStationModel:GetInstance().index then
                    self.orderLis[i].aortext_num.text = ""
                end
            end
            self.curOrder = StrategyStationModel:GetInstance():GetInputDic()
            _G.PopWindowManager:GetInstance():ShowAllTips(911101)
        end
    elseif go == self.go_table.aorbtn_box then
        self.go_table.aorbtn_TipsView:SetActiveE(1)
        if not self.awardInit then
            self.go_table.scrollloopvectical_award:InitItemData(#self.awards, _G.handler(self, self.RefreshAward))
            self.awardInit = true
        end
    elseif go == self.go_table.aorbtn_TipsView then
        self.go_table.aorbtn_TipsView:SetActiveE(0)
    elseif go == self.go_table.aorbtn_SendShare then
        local channel = require("ChatManager"):GetInstance():IsUnLock(1) and 1 or 2
        if channel == 2 then--如果全服频道没开启需要额外判断一下本服有没有开
            local isUnlock, str = require("ChatManager"):GetInstance():IsUnLock(2)
            if not isUnlock then
                _G.PopWindowManager:GetInstance():ShowAllTips(1, str)
                return
            end
        end
        StrategyStationModel:GetInstance():SendShare(function(data)
            local json = StrategyStationModel:GetInstance():GetChatStr()
            ---@type chat.c2s_chat dsd
            local param = {}
            param.channel = channel
            param.content = json
            param.f_uid = 0
            param.type = 7
            param.voice = 0
            param.share_id = ""

            ---@type ClintSendChatInfo ---本地自己的消息 先显示 忽略服务器广播 防止延迟
            local msg = {}
            msg.channel = channel
            msg.n_content = json
            msg.f_uid = 0
            msg.type = 7
            msg.voice = 0
            msg.share_id = ""
            msg, _ = require("ChatManager"):GetInstance():GetNewChatInfo(msg)
            require("ChatViewNet"):GetInstance():SendCHAT(
                param,
                _G.handlerbind(self, self.CallSendChat, msg)
            )
        end)
    else
        local name = go:GetName()
        local len = _G.string.len(name)
        local num = _G.tonumber(name:sub(len, len))
        if num then
            self:Input(num)
        end
    end
end

function StrategyStationKeyboardView:CallSendChat(param, msg)
    if param.ack == 1 then
        _G.PopWindowManager:GetInstance():ShowAllTips(411)
        --- 以服务器返回的内容为准  (违禁字 处理后)
        if not _G.IsNil(param.content) and not string.IsNullOrEmpty(param.content) then
            msg.chat.n_content = param.content
        end
        if not _G.IsNil(param.time) then
            msg.chat.time = param.time
        end
        require("ChatManager"):GetInstance():P2C_NewChat(msg)
        StrategyStationModel:GetInstance():AddChatViewCloseCall()
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ChatView.Name, _G.ChatType.system)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.FriendsView.Name)
        self:Close()
    end
end

---@private
function StrategyStationKeyboardView:OnDestroy()
end

return StrategyStationKeyboardView
