local StrategyStationNet = require("StrategyStationNet")

local base = _G.GameDataModelBase
---@class StrategyStationModel : GameDataModelBase
---@field taskList table<number, table<number, StrategyStationTaskData>>
local StrategyStationModel = _G.BaseClass("StrategyStationModel", base)

local table = _G.table

---@return StrategyStationModel StrategyStationModel
function StrategyStationModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function StrategyStationModel:__init()
    self.curFunctionOpenID = _G.FunctionID.StrategyStation
end

---从服务器拉取数据
function StrategyStationModel:GetDataFormServer()
    self:GetInfo()
end

function StrategyStationModel:GetInfo()
    StrategyStationNet:GetInstance():GetInfo(_G.handler(self, self.ParseData))
end

---@param msg strategy_station.s2c_info
function StrategyStationModel:ParseData(msg)
    
    self.order = msg.order
    self.index = msg.index
    self.isAward = msg.is_award
    self.super.ParseData(self)
end

---是否已领奖
function StrategyStationModel:CheckIsAward()
    return self.isAward == 1
end

function StrategyStationModel:CheckOrder(order)
    local num = 0
    for k, v in pairs(order) do
        if k ~= self.index and v == self.order[k] then
            num = num + 1
        end
    end
    return num == 3
end

function StrategyStationModel:GetChatStr()
    local table = {order = self.order,index =self.index}

    return  _G.Table2Json(table)
end

function StrategyStationModel:GetNumByIndex(index)
    return self.order[index]
end

function StrategyStationModel:SendShare(callback)
    StrategyStationNet:GetInstance():SendShare(callback)
end


function StrategyStationModel:GetInputDic()
    local dic = {}
    dic[self.index] = self.order[self.index]
    return dic
end

function StrategyStationModel:GetAward(order, call)
    local pbData = {order = order}
    StrategyStationNet:GetInstance():GetAward(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self.isAward = 1
            require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.StrategyStation.id)
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            if call then
                call()
            end
        end
    )
end

function StrategyStationModel:CheckRedPoint()
    if _G.TimeUtil.GetDayBegin(_G.TimeUtil.GetServerUnixTime()) == _G.PlayerPrefsManager.GetInt("StrategyStation") then
        return false
    end
    if not self:CheckIsAward() then
        return true
    end
    return false
end

function StrategyStationModel:RefreshRedPoint(param)
    -- require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.StrategyStation.id)
end

function StrategyStationModel.CheckMainViewBtn()
    return require("StrategyStationModel"):GetInstance():CheckMainViewBtnInner()
end

function StrategyStationModel:CheckMainViewBtnInner()
    return true
end

function StrategyStationModel:OnSixClockUpdate(endcall)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.StrategyStation.id)
    base.OnSixClockUpdate(self, endcall)
end

function StrategyStationModel:AddChatViewCloseCall()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
end

function StrategyStationModel:OnUIOpened(name)
    if name == _G.ConfigManager.ui_cfg.ChatView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
        local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ChatView.Name)
        if ctrl then
            ctrl:SetCloseCallback(
                function()
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.StrategyStationKeyboardView.Name)
                end
            )
        end
    end
end

---销毁对象时,析构函数
function StrategyStationModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
end

return StrategyStationModel
