---@class JewelryRecommendItem:LuaUIItem
---@field private go_table RecommendedView._obj_RewardViewItem1_GoTable GoTable
local JewelryRecommendItem = _G.BaseClass("JewelryRecommendItem")

---__init构造函数
---@protect
function JewelryRecommendItem:__init(cardRoot,view)
    self.root = cardRoot
    ---@type StrategyStationTipView
    self.view = view
    self.cardData = view.CardData
    self.go_table = _G.GetAutoGoTable(self.root, _G.handler(self, self.OnClickBtn))

    ---@type _obj_RewardViewItem1._obj_Recommended1_GoTable
    self.obj_Recommended1 = _G.GetAutoGoTable(self.go_table.obj_Recommended1,_G.handler(self, self.OnClickBtn))
    ---@type _obj_RewardViewItem1._obj_Recommended2_GoTable
    self.obj_Recommended2 = _G.GetAutoGoTable(self.go_table.obj_Recommended2,_G.handler(self, self.OnClickBtn))

    ---@type table<number, SpiritualData> 仓库数据 <uid, SpiritualData>
    self.SpiritualDataList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Spiritual)

    self.obj_Recommended1.aorbtn_wearable:SetActiveE(self.view.isHasCard and 1 or 0)
    self.obj_Recommended2.aorbtn_wearable:SetActiveE(self.view.isHasCard and 1 or 0)
    self.isCanWear1 = false
    self.isCanWear2 = false

    self.itemList = {}
    ---@table<number,table<number,number>>
    self.UseIngItemMark = {}
    self.obj_Recommended1.looplist2_looplist:InitListView(0, _G.handler(self, self.RefreshSectionItem1))
    self.obj_Recommended2.looplist2_looplist:InitListView(0, _G.handler(self, self.RefreshSectionItem2))
end

function JewelryRecommendItem:RefreshSectionItem1(listView2, index)
    local obj = listView2:NewListViewItem("$_obj_itemNode")
    local newIndex = index + 1
    local sid = self.jewelryDataList[1].ids[newIndex]
    local id = obj:GetInstanceIDE()
    local item = self.itemList[id]
    if item == nil then
        item = obj
        self.itemList[id] = item
    end
    self.UseIngItemMark[id] = {}
    self.UseIngItemMark[id][newIndex] = true
    self:RefreshPropItem(item,sid,1,newIndex,id)
    return obj
end

function JewelryRecommendItem:RefreshSectionItem2(listView2, index)
    local obj = listView2:NewListViewItem("$_obj_itemNode")
    local newIndex = index + 1
    local sid = self.jewelryDataList[2].ids[newIndex]
    local id = obj:GetInstanceIDE()
    local item = self.itemList[id]
    if item == nil then
        item = obj
        self.itemList[id] = item
    end
    self.UseIngItemMark[id] = {}
    self.UseIngItemMark[id][newIndex] = true
    self:RefreshPropItem(item,sid,2,newIndex,id)
    return obj
end

function JewelryRecommendItem:RefreshPropItem(obj,sid,type,newIndex,objId)
    local isHas = _G.StorageManager:GetInstance():IsHasEquipment(_G.StorageID.Spiritual,sid)
    ---@type _obj_Recommended2._obj_itemNode_GoTable
    local gotable = _G.GetAutoGoTable(obj)
    if isHas then
        if type == 1 then
            self.isCanWear1 = true
        elseif type == 2 then
            self.isCanWear2 = true
        end
        gotable.aortext_have.text = _G.ColorTools.GetRichtext("00721d",_G.GetLangPackValue(90033600003))
    else
        gotable.aortext_have.text =  _G.ColorTools.GetRichtext("c02214",_G.GetLangPackValue(90000011211))
    end
    gotable.obj_propNode:RemoveAllChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
            { sid },
            gotable.obj_propNode,
            _G.handlerbind(self, self.LoadCompBack, newIndex,objId)
    )
end

function JewelryRecommendItem:LoadCompBack(item,newIndex,objId)
    if _G.IsNil(self.go_table) or self.UseIngItemMark[objId][newIndex] == nil then
        _G.DestroyObject(item.gameObject)
        return
    end
    ---@type ItemSpiritualBase
    item:ShowLevel(false)
    item:HideLevel()
    --tran:ShowEffectOrder(true)
    item.gameObject:SetLocalScaleXYZ(0.7)
    --tran:ShowSlotLevel(false)
end

---OnClickBtn 点击按钮
---@param go table
---@param isOn boolean
---@protect
function JewelryRecommendItem:OnClickBtn(go, isOn)
    if go == self.obj_Recommended1.aorbtn_wearable then
        --一键穿戴新手推荐饰品
        if self.isCanWear1 then
            self:OneClickWear(self.jewelryDataList[1].ids)
        else
            if self.cardData.star < _G.ConfigManager.discrete_cfg[114001][1][1] then
                _G.PopWindowManager:GetInstance():ShowAllTips(1001,_G.GetLangPackValue(90033600008))
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(1001,_G.GetLangPackValue(90033600006))
            end
        end
    elseif go == self.obj_Recommended2.aorbtn_wearable then
        --一键穿戴暴力输出饰品
        if self.isCanWear2 then
            self:OneClickWear(self.jewelryDataList[2].ids)
        else
            if self.cardData.star < _G.ConfigManager.discrete_cfg[114001][1][1] then
                _G.PopWindowManager:GetInstance():ShowAllTips(1001,_G.GetLangPackValue(90033600008))
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(1001,_G.GetLangPackValue(90033600006))
            end
        end
    end
end

function JewelryRecommendItem:OneClickWear(ids)
    local SpiritualModel = require("SpiritualModel"):GetInstance()

    if table.isEmptyOrNil(self.data.SpiritualBar) then
        self:SeedData(ids)
    else
        local StorageManager = _G.StorageManager:GetInstance()
        SpiritualModel:OneKeyDetachSpiritual(
            self.data,
            false,
            function(data)
                StorageManager:TakeOffMultiSpiritual(self.data.SpiritualBar)
                self:SeedData(ids)
            end
        )
    end

    --self:SeedData(ids)
end

function JewelryRecommendItem:SeedData(ids)
    local unlockData = _G.ConfigManager.discrete_cfg[114001] or {}
    local indexList = unlockData[1] or {}
    local cardStar = self.data.star
    ---@type SpiritualData[]
    local wearSpiritualData = {}
    local count = #ids

    --可装备饰品列表
    ---@type SpiritualData[]
    local EquippedDatas = {}
    ---@type table<number, SpiritualData>
    local EquippedDict = {}
    local StorageManager = _G.StorageManager:GetInstance()
    for i = 1, count do
        local id = ids[i]
        ---@type SpiritualData[]
        local Datas = StorageManager:GetDatasBySid(_G.StorageID.Spiritual, id)
        ---@type SpiritualData
        local maxPowerData = nil
        for _, data in pairs(Datas) do
            if data.cardUid == 0 then
                if maxPowerData == nil then
                    maxPowerData = data
                elseif data:GetPower() > maxPowerData:GetPower() then
                    maxPowerData = data
                end
            end
        end

        if maxPowerData then
            table.insert(EquippedDatas, maxPowerData)
            EquippedDict[maxPowerData.sid] = maxPowerData
        end
    end

    table.sort(EquippedDatas, function(a, b)
        local aPower = a:GetPower()
        local bPower = b:GetPower()
        if aPower == bPower then
            return a.uid < b.uid
        else
            return aPower > bPower
        end
    end)

    --count = #self.data.SpiritualBar
    --local NotChangeSlots = {}
    --for i = 1, count do
    --    local id = self.data.SpiritualBar[i].sid
    --    if EquippedDict[id] and EquippedDict[id]:GetPower() <= self.data.SpiritualBar[i]:GetPower() then
    --        EquippedDict[id] = nil
    --        NotChangeSlots[i] = true
    --    end
    --end

    count = #indexList
    local wearMsg = {}
    local SetIndexDict = {}
    local Index = 1
    local EquippedCount = #EquippedDatas
    --local list = {}
    --for i, v in pairs(EquippedDict) do
    --    table.insert(list,v)
    --end
    --
    --local SlotId = 1
    --for i = 1, count do
    --    local unlockStart = indexList[i]
    --    if unlockStart <= cardStar and EquippedCount >= Index then
    --        if NotChangeSlots[SlotId] == nil then
    --            local existUid = list[i].uid
    --            if existUid == nil then
    --                Index = Index + 1
    --            else
    --                local existData = StorageManager:GetItemDataByID(_G.StorageID.Spiritual, existUid)
    --                Index = Index + 1
    --                table.insert(wearMsg,{index = i, uid = existData.uid})
    --                SetIndexDict[SlotId] = true
    --                wearSpiritualData[SlotId] = existData
    --            end
    --        end
    --    else
    --        break
    --    end
    --end
    
    for i = 1, count do
        local unlockStart = indexList[i]
        if unlockStart <= cardStar and EquippedCount >= Index then
            local existUid = EquippedDatas[Index].uid
            if existUid == nil then
                Index = Index + 1
            else
                local existData = StorageManager:GetItemDataByID(_G.StorageID.Spiritual, existUid)
                Index = Index + 1
                table.insert(wearMsg,{index = i, uid = existData.uid})
                SetIndexDict[i] = true
                wearSpiritualData[i] = existData
            end
        else
            break
        end
    end
    local cardData = self.data
    if #wearMsg > 0 then
        local pbData = { uid = self.data.uid, msg = wearMsg }
        self:PutOn(pbData, function()
            -- 卸下旧装备
            --if not table.isEmptyOrNil(cardData.SpiritualBar) then
            --    local needTakeDatas = {}
            --
            --    local count = #cardData.SpiritualBar
            --    for i = 1, count do
            --        if SetIndexDict[i] then
            --            table.insert(needTakeDatas,cardData.SpiritualBar[i])
            --        end
            --    end
            --    StorageManager:TakeOffMultiSpiritual(needTakeDatas)
            --end

            -- 绑定新装备
            for index, data in pairs(wearSpiritualData) do
                if data.uid == data.sid then
                    local newMsg = data.GetMsg(data)
                    newMsg.cardUid = cardData.uid
                    newMsg.index = index
                    cardData:SaveSpiritualData({ spiritual = { newMsg } })
                    StorageManager:PutOnSpiritual(newMsg)
                    StorageManager:ConsumeSpiritual(data.uid, 1)
                else
                    data:BindCard(cardData.uid, index)
                    cardData:PutOnSpiritual(data)
                    StorageManager:PutOnSpiritual(data)
                end
            end
            cardData:CalcNowSumProp()
            _G.Events:GetInstance():Broadcast(_G.eCardResonance.CRSEquipmentRefresh,self.data)
            require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.SpiritualPage.id)
            self.view:Close()
        end)
    else
        if self.cardData.star < _G.ConfigManager.discrete_cfg[114001][1][1] then
            _G.PopWindowManager:GetInstance():ShowAllTips(1001,_G.GetLangPackValue(90033600008))
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(1001,_G.GetLangPackValue(90033600006))
        end
    end
end


---穿戴灵契(穿戴 卸下 替换都是通过该协议交互)
function JewelryRecommendItem:PutOn(pbData, callback)
    SpiritualNet:GetInstance():PutOn(
            pbData,
            function(msg)
                if msg.ack ~= 1 then
                    return
                end

                if callback then
                    callback(msg)
                end
            end
    )
end

---@class JewelryRecommendItem.jewelryData
---@field ids number[]
---@field tip string
---@field type number 1:新手推荐 2:暴力输出

---InitItem item赋值
---@public
---@param data CardData
function JewelryRecommendItem:RefreshItem(data)
    self.data = data
    self.isCanWear1 = false
    self.isCanWear2 = false

    ---@type JewelryRecommendItem.jewelryData[]
    self.jewelryDataList = {}

    local count = #data.cfg.jewelry_recommend
    for i = 1, count do
        local ids = data.cfg.jewelry_recommend[i]
        local tip = data.cfg.jewelry_title[i]
        self.jewelryDataList[i] = {
            ids = ids,
            tip = tip,
            type = i
        }
    end

    for i = 1, 2 do
        ---@type _obj_RewardViewItem1._obj_Recommended1_GoTable
        local obj_Recommended = self["obj_Recommended" .. i]
        obj_Recommended.looplist2_looplist:SetListItemCount(#self.jewelryDataList[i].ids, true)
        obj_Recommended.aortext_tip.text = GetLangPackValue(self.jewelryDataList[i].tip)
    end

end

---@return JewelryRecommendItem
return JewelryRecommendItem