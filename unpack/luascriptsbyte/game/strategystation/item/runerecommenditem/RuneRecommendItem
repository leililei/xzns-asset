local DecorationData = require("DecorationData")

---@class RuneRecommendItem:LuaUIItem
---@field private go_table RecommendedView._obj_RewardViewItem2_GoTable GoTable
local RuneRecommendItem = _G.BaseClass("RuneRecommendItem")

---__init构造函数
---@protect
function RuneRecommendItem:__init(cardRoot,view)
    self.root = cardRoot
    ---@type StrategyStationTipView
    self.view = view
    self.go_table = _G.GetAutoGoTable(self.root, _G.handler(self, self.OnClickBtn))

    ---@type _obj_RewardViewItem1._obj_Recommended1_GoTable
    self.obj_Recommended1 = _G.GetAutoGoTable(self.go_table.obj_Recommended1,_G. handler(self, self.OnClickBtn))
    ---@type _obj_RewardViewItem2._obj_Recommended3_GoTable
    self.obj_Recommended3 = _G.GetAutoGoTable(self.go_table.obj_Recommended3)

    self.obj_Recommended1.aorbtn_wearable:SetActiveE(self.view.isHasCard and 1 or 0)

    self.itemList = {}
    self.obj_Recommended1.looplist2_looplist:InitListView(0, _G.handler(self, self.RefreshSectionItem1))
end

function RuneRecommendItem:RefreshSectionItem1(listView2, index)
    local obj = listView2:NewListViewItem("$_obj_itemNode")
    local newIndex = index + 1
    local sid = self.jewelryData.ids[newIndex]
    local id = obj:GetInstanceIDE()
    local item = self.itemList[id]
    if item == nil then
        item = obj
        self.itemList[id] = item
    end
    self:RefreshPropItem(item,sid)
    return obj
end

function RuneRecommendItem:RefreshPropItem(obj,sid)
    local isHas = _G.StorageManager:GetInstance():IsHasEquipment(_G.StorageID.Decoration,sid)
    ---@type _obj_Recommended2._obj_itemNode_GoTable
    local gotable = _G.GetAutoGoTable(obj)
    if isHas then
        gotable.aortext_have.text = _G.ColorTools.GetRichtext("00721d",_G.GetLangPackValue(90033600003))
    else
        gotable.aortext_have.text =  _G.ColorTools.GetRichtext("c02214",_G.GetLangPackValue(90000011211))
    end
    _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemDecorationBase,
            gotable.obj_propNode,
            --handlerbind(self,self.ItemDecorationBaseLoadComp,sid)
            function(item)
                self:ItemDecorationBaseLoadComp(item,sid)
            end
    )
end

---OnClickBtn 点击按钮
---@param go table
---@param isOn boolean
---@protect
function RuneRecommendItem:OnClickBtn(go, isOn)
    if go == self.obj_Recommended1.aorbtn_wearable then
        --一键穿戴推荐符文
        if self.isSeedIng then
            --_G.UIManager.GetInstance():ShowTips(GetLangPackValue(90033600002))
            return
        end
        local unlockRune = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Rune)
        if unlockRune == false then
            _G.PopWindowManager:GetInstance():ShowAllTips(1001,_G.GetLangPackValue(90033600008))
            return
        end
        self.isSeedIng = true
        local count = #self.jewelryData.ids
        local useDatas = {}
        ---@type table<DecorationPart, table>
        local cardDatas = self.data.DecorationBar
        for i = 1, count do
            local sid = self.jewelryData.ids[i]
            local isHas = _G.StorageManager:GetInstance():IsHasEquipment(_G.StorageID.Decoration,sid)
            if isHas then
                ---@type DecorationData[]
                local decorationDatas = _G.StorageManager:GetInstance():GetDatasBySid(_G.StorageID.Decoration,sid)
                ---@type DecorationData
                local maxPowerData = nil
                for i, decorationData in pairs(decorationDatas) do
                    if decorationData.cardUid == 0 then
                        if maxPowerData == nil then
                            maxPowerData = decorationData
                        else
                            if decorationData:GetPower() > maxPowerData:GetPower() then
                                maxPowerData = decorationData
                            end
                        end
                    end
                end
                if maxPowerData then
                    local curCardData = cardDatas[maxPowerData.parts]
                    if curCardData and curCardData.decoration and curCardData.decoration.sid == sid and curCardData.decoration:GetPower() >= maxPowerData:GetPower() then
                        --最好的装备
                    else
                        table.insert(useDatas, maxPowerData)
                    end
                end
            end
        end
        if #useDatas == 0 then
            local unlockRune = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Rune)
            if unlockRune == false then
                _G.PopWindowManager:GetInstance():ShowAllTips(1001,_G.GetLangPackValue(90033600008))
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(1001,_G.GetLangPackValue(90033600007))
            end
            self.isSeedIng = false
            return
        end
        require("DecorationModel"):GetInstance():PutOnDecorations(
                self.data, useDatas, function(power, offset)
                    --require "CommonTipManager".OpenPowerUpView(power, offset)
                    _G.Events:GetInstance():Broadcast(_G.eRune.OneClickWear,false,power,offset)
                    self.view:Close()
                end
        )
        self.isSeedIng = false
    end
end

---InitItem item赋值
---@public
---@param data CardData
function RuneRecommendItem:RefreshItem(data)
    self.data = data

    ---@type JewelryRecommendItem.jewelryData
    self.jewelryData = {}
    local ids = data.cfg.rune_recommend[1]
    local tip = data.cfg.rune_title[1]
    self.jewelryData = {
        ids = ids,
        tip = tip,
        type = 1
    }

    self.obj_Recommended1.looplist2_looplist:SetListItemCount(#self.jewelryData.ids, true)
    self.obj_Recommended1.aortext_tip.text = _G.GetLangPackValue(self.jewelryData.tip)

    local cfg = _G.ConfigManager.decoration_cfg[self.jewelryData.ids[1]]
    local decoration_suit_cfg = _G.ConfigManager.decoration_suit_cfg[cfg.suit]
    local attribute_cfg = _G.ConfigManager.attribute_cfg
    _G.GameUtil.SetChildCount(self.obj_Recommended3.obj_propNode,#decoration_suit_cfg.att_suit2,function(obj,index)
        local data = decoration_suit_cfg.att_suit2[index]

        ---@type _obj_Recommended3._obj_desNode_GoTable
        local item = _G.GetAutoGoTable(obj)
        item.aortext_name.text = _G.GetLangPackValue(90032800022,data[1]) .. ":"
        if attribute_cfg[data[2]] then
            item.aortext_des.text = _G.GetLangPackValue(attribute_cfg[data[2]].describe)
        else
            item.aortext_des.text = ""
        end
        _G.GameUtil.ReBuildRTF(item.aortext_des)
        _G.GameUtil.ReBuildRTF(item.transform)
    end)
    _G.GameUtil.ReBuildRTF(self.go_table.obj_Root)
end

---@param StorageID StorageID
function RuneRecommendItem.IsHasEquipment(StorageID,sid)
    local proplist = _G.StorageManager:GetInstance():GetDatasBySid(StorageID,sid)
    local isHas = false
    for i, v in pairs(proplist) do
        isHas = true
        break
    end
    return isHas
end

---@param item
function RuneRecommendItem:ItemDecorationBaseLoadComp(item,sid)
    if _G.IsNil(self.go_table) then
        _G.DestroyObject(item.gameObject)
        return
    end
    if item == nil or IsNumber(item) or sid == nil then
        return
    end

    ---@type ItemDecorationBase
    local lua = item
    lua.gameObject:SetLocalScaleXYZ(0.7)

    ---@type DecorationData
    local itemData = DecorationData.New()
    if _G.ConfigManager.decoration_cfg[sid] == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("decoration_cfg没有此id" .. sid)
        end
        return
    end
    itemData:ParseInitMsg({ sid = sid} )

    lua:ShowData(itemData)
    lua:ShowLevel(false)
    lua:ShowSlotLevel(false)
    lua:ShowRoleHead(false)
    lua.gameObject:SetActiveE(1)
end

---@return RuneRecommendItem
return RuneRecommendItem