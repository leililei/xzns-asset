local base = require("BaseGameNet")

---@class StrategyStationNet : BaseGameNet	通信协议
local StrategyStationNet = _G.BaseClass("StrategyStationNet", base)
---@return StrategyStationNet StrategyStationNet
function StrategyStationNet:GetInstance()
    return base.GetInstance(self)
end

---获取信息
function StrategyStationNet:GetInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_strategy_station_info
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---完成任务/领奖
function StrategyStationNet:GetAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_strategy_station_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

function StrategyStationNet:SendShare(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_strategy_station_share
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function StrategyStationNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return StrategyStationNet
