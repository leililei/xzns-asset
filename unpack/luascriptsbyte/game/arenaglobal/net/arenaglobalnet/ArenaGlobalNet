local base = require("BaseGameNet")

---@class ArenaGlobalNet : BaseGameNet	通信协议
local ArenaGlobalNet = _G.BaseClass("ArenaGlobalNet", base)
---@return ArenaGlobalNet ArenaGlobalNet
function ArenaGlobalNet:GetInstance()
    return base.GetInstance(self)
end

---拉取信息
function ArenaGlobalNet:GetInfo(callback)
    local item = _G.ConfigManager.net_map.game_arena_global_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.Callback))
    self.Call[port] = callback
end

