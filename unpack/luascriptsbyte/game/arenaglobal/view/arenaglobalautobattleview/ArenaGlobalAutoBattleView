local ArenaGlobalModel = require("ArenaGlobalModel")
---@class ArenaGlobalAutoBattleView : UIBaseView    中文描述
---@field public go_table ArenaGlobalAutoBattleView_GoTable GoTable
local ArenaGlobalAutoBattleView = _G.BaseClass("ArenaGlobalAutoBattleView", _G.UIBaseView)

---构造函数
---@protected
function ArenaGlobalAutoBattleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArenaGlobalAutoBattleView:OnCreate(index)
    self.activity = ArenaGlobalModel:GetInstance():GetActivity()
    self.activityID = self.activity.activityID
    -- local index = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.ArenaGlobalAutoFightTag, 0)
    -- if index == 0 then
    --     index = 1
    -- end
    self.Toggle = self.go_table["toggle_tag" .. index]:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle))
    self.Toggle.isOn = true
    self.chooseIndex = index

    local ticketId = _G.ConfigManager.discrete_cfg[127117][1][1]
    self.fightMaxNum =
        ArenaGlobalModel:GetInstance():GetFreeFightTimes() + _G.StorageManager:GetInstance():GetItemCountBySid(ticketId)
    self.propUseNum = self.fightMaxNum
    self.go_table.input_useNum.onEndEdit:AddListener(_G.handler(self, self.OnEndEditorDeclaration))
    self:SetPropUseInfo()

    self.stopType = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.ArenaGlobalAutoStopType, 1)
    self.go_table["toggle_con" .. self.stopType].isOn = true
    ---@type ArenaGlobalAutoBattleView._toggle_con2_GoTable
    self.failNumTb = _G.GetAutoGoTable(self.go_table.toggle_con2, _G.handler(self, self.OnClickFail))
    self.failNumTb.input_useNum.onEndEdit:AddListener(_G.handler(self, self.OnEndEditorFailNum))
    self.failNum = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.ArenaGlobalAutoFailNum, 1)
    self:SetFailNum()
    self.rankNumTb = _G.GetAutoGoTable(self.go_table.toggle_con3, _G.handler(self, self.OnClickRank))
    self.rankNumTb.input_useNum.onEndEdit:AddListener(_G.handler(self, self.OnEndEditorRankNum))
    self.rankNum = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.ArenaGlobalAutoRankNum, 1)
    self:SetRankNum()
end

function ArenaGlobalAutoBattleView:SetPropUseInfo()
    self.go_table.input_useNum.text = self.propUseNum
end

function ArenaGlobalAutoBattleView:OnEndEditorDeclaration(input)
    if not tonumber(input) then
        input = self.propUseNum
    end
    local num = tonumber(input)
    local max = self.fightMaxNum
    local min = 1
    self.propUseNum = _G.Mathf.Clamp(num, min, max)
    self:SetPropUseInfo()
end

function ArenaGlobalAutoBattleView:SetFailNum()
    self.failNumTb.input_useNum.text = self.failNum
end

function ArenaGlobalAutoBattleView:OnEndEditorFailNum(input)
    if not tonumber(input) then
        input = self.failNum
    end
    local num = tonumber(input)
    self.failNum = _G.Mathf.Clamp(num, 1, 999)
    self:SetFailNum()
end

function ArenaGlobalAutoBattleView:SetRankNum()
    self.rankNumTb.input_useNum.text = self.rankNum
end

function ArenaGlobalAutoBattleView:OnEndEditorRankNum(input)
    if not tonumber(input) then
        input = self.rankNum
    end
    local num = tonumber(input)
    self.rankNum = _G.Mathf.Clamp(num, 1, 999)
    self:SetRankNum()
end

---界面的销毁函数
function ArenaGlobalAutoBattleView:OnDestroy()
end

function ArenaGlobalAutoBattleView:OnClickFail(go)
    if go == self.failNumTb.aorbtn_propSub then
        if self.failNum > 1 then
            self.failNum = self.failNum - 1
            self:SetFailNum()
        end
    elseif go == self.failNumTb.aorbtn_propAdd then
        self.failNum = self.failNum + 1
        self:SetFailNum()
    end
end

function ArenaGlobalAutoBattleView:OnClickRank(go)
    if go == self.rankNumTb.aorbtn_propSub then
        if self.rankNum > 1 then
            self.rankNum = self.rankNum - 1
            self:SetRankNum()
        end
    elseif go == self.rankNumTb.aorbtn_propAdd then
        self.rankNum = self.rankNum + 1
        self:SetRankNum()
    end
end

---按钮点击事件在这里派发
function ArenaGlobalAutoBattleView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeView then
        self:Close()
    elseif go == self.go_table.toggle_tag1 then
        self.chooseIndex = 1
    elseif go == self.go_table.toggle_tag2 then
        self.chooseIndex = 2
    elseif go == self.go_table.toggle_tag3 then
        self.chooseIndex = 3
    elseif go == self.go_table.toggle_tag4 then
        self.chooseIndex = 4
    elseif go == self.go_table.toggle_tag5 then
        self.chooseIndex = 5
    elseif go == self.go_table.toggle_con1 then
        self.stopType = 1
    elseif go == self.go_table.toggle_con2 then
        self.stopType = 2
    elseif go == self.go_table.toggle_con3 then
        self.stopType = 3
    elseif go == self.go_table.aorbtn_propSub then
        if self.propUseNum > 1 then
            self.propUseNum = self.propUseNum - 1
            self:SetPropUseInfo()
        end
    elseif go == self.go_table.aorbtn_propAdd then
        if self.propUseNum < self.fightMaxNum then
            self.propUseNum = self.propUseNum + 1
            self:SetPropUseInfo()
        end
    elseif go == self.go_table.aorbtn_propMax then
        self.propUseNum = self.fightMaxNum
        self:SetPropUseInfo()
    elseif go == self.go_table.aorbtn_battle then
        -- _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.ArenaGlobalAutoFightTag, self.chooseIndex)
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.ArenaGlobalAutoStopType, self.stopType)
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.ArenaGlobalAutoFailNum, self.failNum)
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.ArenaGlobalAutoRankNum, self.rankNum)
        local stopCon = {type = self.stopType, limit = 0}
        if self.stopType == 2 then
            stopCon.limit = self.failNum
        elseif self.stopType == 3 then
            stopCon.limit = self.rankNum
        end
        ArenaGlobalModel:GetInstance():AutoBattleAll(self.chooseIndex, self.propUseNum, stopCon)
        self:Close()
    elseif go == self.go_table.aorbtn_embattle then
        local cfg = ArenaGlobalModel:GetInstance():GetCurDanCfg()
        ArenaGlobalModel:GetInstance():OpenAttack(cfg.team)
    end
end

return ArenaGlobalAutoBattleView
