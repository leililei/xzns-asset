---@class ArenaGlobalFaceView : UIBaseView	中文描述
---@field go_table SociatyMazeFaceView_GoTable
local ArenaGlobalFaceView = _G.BaseClass("ArenaGlobalFaceView", _G.UIBaseView)

function ArenaGlobalFaceView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建对象时,入口构造函数
function ArenaGlobalFaceView:OnCreate()
    local sTime, _ = require("ArenaGlobalModel"):GetInstance():GetStartTime()
    _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.ArenaGlobalFace, sTime)
end

function ArenaGlobalFaceView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_goto then
        local activity = require("ArenaGlobalModel"):GetInstance().activity
        if activity then
            activity.typeClass:OnEnterActivity()
        end
        self:Close()
    end
end

---销毁对象时,析构函数
function ArenaGlobalFaceView:OnDestroy()
end

return ArenaGlobalFaceView
