local ArenaGlobalModel = require("ArenaGlobalModel")
local SettlementBaseView = require "SettlementBaseView"
---@class ArenaGlobalSettlementVictoryView : UIBaseView	中文描述
---@field public go_table ArenaGlobalSettlementVictoryView_GoTable GoTable
local ArenaGlobalSettlementVictoryView = _G.BaseClass("ArenaGlobalSettlementVictoryView", SettlementBaseView)
local UIUtils = _G.UIUtils
---界面的入口函数
function ArenaGlobalSettlementVictoryView:OnCreateChild(data, fightMsg, enemyData)
    self.fightMsg = fightMsg
    self.otherInfo = data.otherInfo or data.enemy
    self.re_uid = data.re_uid
    self.mvpCardSid = data.MvpCardSid
    self.reportType = data.reportType
    self.mvpData = data.mvpData
    self.hideCombBtn = data.hideCombBtn
    self.hidePetBtn = data.hidePetBtn
    self.award = {}
    if data.data and data.data.award then
        for _, v in pairs(data.data.award.item) do
            _G.table.insert(self.award, v.type)
        end
    end
    self:ShowData(fightMsg.report, enemyData)
    self:OpenEmbattleView()
    local auto = ArenaGlobalModel:GetInstance():GetAutoBattle()
    self.go_table.obj_autobutton:SetActiveE(auto and 1 or 0)
    if auto then
        local AutoNextTimeID = 100216
        local time = _G.ConfigManager.discrete_cfg[AutoNextTimeID][1][1]
        self.waitTime = time
        self.waitTimer = _G.TimerManager:GetInstance():GetTimer(1, self.ShowWaitTime, self)
        self.waitTimer:Start()
    end
end

function ArenaGlobalSettlementVictoryView:OpenEmbattleView()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    local result = {}
    result.iSWin = true
    result.statistics = ArenaGlobalModel:GetInstance().fightMsg.fight_arg ~= nil
    result.otherInfo = self.otherInfo
    result.re_uid = self.re_uid
    result.reportType = self.reportType
    result.hideCombBtn = self.hideCombBtn
    result.hidePetBtn = self.hidePetBtn
    result.AwardData = self.award
    result.hidePlayerInfo = true
    result.MvpCardSid = self.mvpCardSid
    self:OnShowView(
        _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
        function(id)
            if ArenaGlobalModel:GetInstance():GetAutoBattle() then
                if self.click == nil then
                    if self.waitTimer ~= nil then
                        self.waitTimer:Stop()
                        self.waitTimer = nil
                    end
                    ArenaGlobalModel:GetInstance():AutoBattle()
                    self:CloseCall(require("SettlementModel").FunctionEnum.None)
                end
            end
            if self.callback then
                self.callback(id)
                self.callback = nil
            end
        end,
        result
    )
end

--倒计时
function ArenaGlobalSettlementVictoryView:ShowWaitTime(elapsed)
    self.go_table.aortext_autoNext.text = string.format(_G.GetLangPackValue(90033400116), _G.Mathf.RoundToInt(self.waitTime))
    self.waitTime = self.waitTime - elapsed
    if self.waitTime < 0 then
        self.click = true
        ArenaGlobalModel:GetInstance():AutoBattle()
        self:CloseCall(require("SettlementModel").FunctionEnum.None)
        if self.waitTimer ~= nil then
            self.waitTimer:Stop()
            self.waitTimer = nil
        end
    end
end

---按钮点击事件在这里派发
function ArenaGlobalSettlementVictoryView:OnClickBtn(go)
    self.click = true
    if self.waitTimer ~= nil then
        self.waitTimer:Stop()
        self.waitTimer = nil
    end
    if go == self.go_table.aorbtn_sure then
        ArenaGlobalModel:GetInstance():CancelAutoBattle()
        self:CloseCall(require("SettlementModel").FunctionEnum.None)
    elseif go == self.go_table.aorbtn_ContinueFight then
        ArenaGlobalModel:GetInstance():AutoBattle()
        self:CloseCall(require("SettlementModel").FunctionEnum.None)
    else
        self:CloseCall(require("SettlementModel").FunctionEnum.None)
    end
end

function ArenaGlobalSettlementVictoryView:ShowData(report, eData)
    local PlayerModelIns = _G.PlayerModel:GetInstance()

    self.go_table.aortext_mScore.text = require("ArenaGlobalModel"):GetInstance():GetScore()
    self.go_table.aortext_mScoreAdd.text = string.format("+%d", report.a_score)

    local danCfg = require("ArenaGlobalModel"):GetInstance():GetCurDanCfg()
    local enemyScore = _G.Mathf.Max(eData.score - report.d_score, danCfg.base_score)
    self.go_table.aortext_eScore.text = enemyScore
    self.go_table.aortext_eScoreAdd.text = string.format("-%d", report.d_score)

    local style = PlayerModelIns:GetRoleStyle()
    local frame = PlayerModelIns:GetCurFrame()
    UIUtils.SetPlayerHeadItemNew(
        self.go_table.obj_mHeadItemBase,
        {style = style, frame = frame},
        1,
        true,
        false,
        false,
        function()
        end
    )
    UIUtils.SetPlayerHeadItemNew(
        self.go_table.obj_eHeadItemBase,
        {style = eData.style, frame = eData.frame},
        1,
        true,
        false,
        false,
        function()
        end
    )
    -- self.otherInfo.garray = self:SetEnemyInfo(data.enemy.garray)
end

---监听界面
---@param name string 界面名称
function ArenaGlobalSettlementVictoryView:OnUIOpened(name)
    if name == _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
        self.ShowAwardWithButtonView = _G.UIManager:GetInstance():GetWindowCtrl(name)

        self.ShowAwardWithButtonView.go_table.aortext_tip:SetParentE(self.ShowAwardWithButtonView.go_table.obj_tips1)
        _G.UIManager:GetInstance():ChangeCanvasOrder(
            name,
            self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 1
        )
        self.ShowAwardWithButtonView.transform:SetParentE(self.go_table.trans_view)
        self.go_table.obj_info:SetActiveE(1)
    -- CommonTipManager:GetInstance().OpenCommonAwardView(self.award)
    end
end

---打开结算界面
---@param name string 结算界面名称
---@param result table 结算参数
function ArenaGlobalSettlementVictoryView:OnShowView(name, OnSettlementEndCall, result)
    _G.UIManager:GetInstance():OpenWindow(
        name,
        OnSettlementEndCall,
        result,
        nil,
        nil,
        nil,
        nil,--{self.fightMsg.fight_arg},
        self.mvpData
    )
end

---监听界面
---@param name string 界面名称
function ArenaGlobalSettlementVictoryView:OnUIClosed(name)
    if name == _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
        self:Close()
    end
end

function ArenaGlobalSettlementVictoryView:EscClose()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name)
    if view then
        view:CloseCall(_G.SettlementModel.FunctionEnum.None)
    end
    ArenaGlobalModel:GetInstance():CancelAutoBattle()
end

function ArenaGlobalSettlementVictoryView:OnDestroy()
    if self.waitTimer ~= nil then
        self.waitTimer:Stop()
        self.waitTimer = nil
    end
end

return ArenaGlobalSettlementVictoryView
