---@class ArenaGlobalAwardView : UIBaseView    中文描述
---@field public go_table ArenaGlobalView_GoTable GoTable
local ArenaGlobalAwardView = _G.BaseClass("ArenaGlobalAwardView", _G.UIBaseView)

function ArenaGlobalAwardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArenaGlobalAwardView:OnCreate(activityClass)
    self.activityClass = activityClass
    self.typeClass = activityClass.typeClass
    self:InitToggle()
    self:InitView()
end

---初始化页面
function ArenaGlobalAwardView:InitView()
end

function ArenaGlobalAwardView:InitToggle()
    self.toggles = {
        orderHall = _G.GetAutoGoTable(
            self.go_table.toggle_orderHall,
            _G.handlerbind(self, self.OnClickToggle, "orderHall", _G.handler(self, self.OnOrderHall))
        ),
        cardRecharge = _G.GetAutoGoTable(
            self.go_table.toggle_cardRecharge,
            _G.handlerbind(self, self.OnClickToggle, "cardRecharge", _G.handler(self, self.OnCardRecharge))
        )
    }
end

---按钮点击事件在这里派发
function ArenaGlobalAwardView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

---@private
function ArenaGlobalAwardView:OnDestroy()
end

return ArenaGlobalAwardView
