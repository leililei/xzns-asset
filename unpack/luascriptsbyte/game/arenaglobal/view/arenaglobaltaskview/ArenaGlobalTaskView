function ArenaGlobalTaskView:UpdateView()
    self.taskawardlocalsize = 0.8
    _G.SortList(
        self.taskData,
        function(item)
            -- 已领取
            if ArenaGlobalModel:GetInstance():CheckTaskIsFinish(item.i_task.sid) then
                return 0, -item.i_task.sid
            end
            -- 可领取
            if item.i_task.state == _G.TaskEnum.ETaskState.Submited then
                return 9, -item.i_task.sid
            end
            -- 没完成
            return 1, -item.i_task.sid
        end
    )
    -- self.go_table.aortext_tip:SetActiveE(self.showTip and 1 or 0)
    -- self.go_table.scrollloopvectical_itemList:SetRectTransformOffset(-300, 200, 300, self.showTip and -186 or -158) --158 186
    if not self.initScroll then
        self.initScroll = true
        self.go_table.scrollloopvectical_Group:InitItemData(#self.taskData, _G.handler(self, self.RefreshItem))
    else
        self.go_table.scrollloopvectical_Group:UpdateAllItem()
    end
    self:RefreshDaJiangList()
end

function ArenaGlobalTaskView:RefreshItem(index, obj)
    index = index + 1
    local data = self.taskData[index]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnItemClick, index))
    tb.obj_items:ClearChildren()
    tb.aortext_info.text = _G.GetLangPackValue(data.Cfg.desc, data.Cfg.count)
    if data.i_task.state == _G.TaskEnum.ETaskState.Submited then
        tb.aortext_jd.text = _G.string.format("(%s/%s)", data.Cfg.count, data.Cfg.count)
        local isGet = ArenaGlobalModel:GetInstance():CheckTaskIsFinish(data.Cfg.id)
        tb.aorbtn_get:SetActiveE(isGet and 0 or 1)
        tb.aorbtn_way:SetActiveE(0)
        tb.aorimage_get:SetActiveE(1)
        tb.aorimage_over:SetActiveE(isGet and 1 or 0)
    else
        tb.aortext_jd.text = _G.string.format("(%s/%s)", data.i_task.target[1], data.Cfg.count)
        tb.aorbtn_get:SetActiveE(0)
        tb.aorimage_get:SetActiveE(1)
        tb.aorbtn_way:SetActiveE(1)
        if data.Cfg.link and data.Cfg.link ~= 0 then
            tb.aorbtn_way:SetGray(false)
            tb.aortext_label.text = _G.LangUtil.GetLangPackValue(90022200010)
            tb.aorbtn_way.interactable = true
        else
            if AppSetting.IsXzns then
                tb.aorbtn_way:SetGray(false)
            else
                tb.aorbtn_way:SetGray(true)
            end
            tb.aortext_label.text = _G.LangUtil.GetLangPackValue(90020400086)
            tb.aorbtn_way.interactable = false
        end
        tb.aorimage_over:SetActiveE(0)
    end

    for i = 1, #data.Cfg.reward do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            data.Cfg.reward[i],
            tb.obj_items,
            function(tran)
                tran.gameObject:SetLocalScaleXYZ(self.taskawardlocalsize and self.taskawardlocalsize or 0.7)
                if data.Cfg.reward[i][2] > 1 then
                    tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                else
                    tran:ShowNumText(false)
                end
                tran:SetGou(ArenaGlobalModel:GetInstance():CheckTaskIsFinish(data.Cfg.id))
                if tran.ShowEffectOrder and tran.cfg then
                    tran:ShowEffectOrder(tran.cfg.ef_item == 1 and true or false)
                end
            end
        )
    end
end

function ArenaGlobalTaskView:UpdateTime(elapsed)
    self.countDown = self.countDown - elapsed
    if self.countDown < 0 then
        self.countDown = 0
    end
    self.go_table.aortext_tip.text =
        _G.GetLangPackValue(90033404077, _G.TimeUtil.TimeToStringHMS(_G.Mathf.RoundToInt(self.countDown)))
    if self.countDown == 0 then
        self:InitTaskData()
        self:UpdateView()
    end
end

function ArenaGlobalTaskView:OnItemClick(go, _, index)
    local name = go:GetName()
    local data = self.taskData[index]
    if name == "@_aorbtn_get" then
        local ids = ArenaGlobalModel:GetInstance():GetAllCanFinishTask()
        ArenaGlobalModel:GetInstance():FinishTask(
            ids,
            function()
                self:UpdateView()
            end
        )
    elseif name == "@_aorbtn_go" then
    -- _G.JumpManager:GetInstance():Jump(data.Cfg.link, nil)
    end
end

function ArenaGlobalTaskView:RefreshDaJiangList()
    self.dajiangList = {}
    for k, v in pairs(self.taskData) do
        if #v.Cfg.prize > 0 then
            _G.table.insert(self.dajiangList, {sid = v.Cfg.id, target = v.Cfg.count, award = v.Cfg.reward[1]})
        end
    end
    self:SortDaJiangList()
    if self.DajiangScroll then
        self.DajiangScroll:UpdateAllItem()
    else
        self.go_table.scrollloophorizontal_dajianglist:InitItemData(
            _G.table.count(self.dajiangList),
            _G.handler(self, self.RefreshdajiangItem)
        )
        self.DajiangScroll = self.go_table.scrollloophorizontal_dajianglist
    end
end
function ArenaGlobalTaskView:RefreshdajiangItem(index, obj)
    local data = self.dajiangList[index + 1]
    local tb = _G.GetAutoGoTable(obj)
    tb.aortext_round.text = _G.GetLangPackValue(90033400076, data.target)
    tb.obj_item:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        data.award,
        tb.obj_item,
        function(tran)
            tran.gameObject:SetLocalScaleXYZ(0.95)
            if data.award[2] > 1 then
                tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
            else
                tran:ShowNumText(false)
            end
            tran:SetGou(ArenaGlobalModel:GetInstance():CheckTaskIsFinish(data.sid))
            if tran.ShowEffectOrder and tran.cfg then
                tran:ShowEffectOrder(tran.cfg.ef_item == 1 and true or false)
            end
        end
    )
end

function ArenaGlobalTaskView:SortDaJiangList()
    table.sort(
        self.dajiangList,
        function(a, b)
            return a.target < b.target
        end
    )
end

function ArenaGlobalTaskView:OnReconnect()
    self:InitTaskData()
    self:UpdateView()
end

---界面的销毁函数
function ArenaGlobalTaskView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
function ArenaGlobalTaskView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_Close then
        self:Close()
    end
end

return ArenaGlobalTaskView
