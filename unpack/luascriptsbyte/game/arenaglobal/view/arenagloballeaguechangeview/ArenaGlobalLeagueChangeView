local ArenaGlobalModel = require("ArenaGlobalModel")

---@class ArenaGlobalLeagueChangeView : UIBaseView	中文描述
---@field go_table ArenaGlobalLeagueChangeView_GoTable
local ArenaGlobalLeagueChangeView = _G.BaseClass("ArenaGlobalLeagueChangeView", _G.UIBaseView)

function ArenaGlobalLeagueChangeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建对象时,入口构造函数
function ArenaGlobalLeagueChangeView:OnCreate()
    self.cfg = ArenaGlobalModel:GetInstance():GetCurDanCfg()
    self.awards = self.cfg.layer_rewards
    self.go_table.toggle_noTip.isOn = false
    self:InitView()
    self:LoadEffect()
end

function ArenaGlobalLeagueChangeView:InitView()
    self.go_table.aortext_rankName.text = _G.GetLangPackValue(self.cfg.name)
    self.go_table.aortext_rankAndPoints.text = _G.GetLangPackValue(90033404123, ArenaGlobalModel:GetInstance().lastRank,
        ArenaGlobalModel:GetInstance().peakScore,
        ArenaGlobalModel:GetInstance().lastPointsAdd)
    self.go_table.aortext_tip.text = ""
    self.go_table.aortext_rankAndPoints.text = _G.GetLangPackValue(90033404123, ArenaGlobalModel:GetInstance().lastRank,
        ArenaGlobalModel:GetInstance().peakScore,
        ArenaGlobalModel:GetInstance().lastPointsAdd)
    ArenaGlobalModel:GetInstance():GetRankData(
        1,
        1,
        function(rankData)
            local limit1, limit2, layer = ArenaGlobalModel:GetInstance():GetRankLimit(rankData.r_num)
            if layer[1][1] == 0 then --保级
                self.go_table.aortext_tip.text = _G.GetLangPackValue(90033404089, limit2 - 1)
            else
                self.go_table.aortext_tip.text = _G.GetLangPackValue(90033404088, limit1)
            end
        end
    )

    self.go_table.aorrawimage_rankIcon:LoadImage(
        self.cfg.rank,
        function()
            if self:IsNil() then
                return
            end
            self.go_table.aorrawimage_rankIcon:SetNativeSize()
        end
    )

    self.ungetAwards = ArenaGlobalModel:GetInstance():GetUngetDayAward()
    self.curItemEff = {}
    local obj
    for i = 1, #self.awards do
        obj = _G.InstantiateObject(self.go_table.obj_awardItem, self.go_table.obj_award)
        obj:SetActiveE(1)
        self:RefreshItem(i, obj)
    end

    if #self.ungetAwards > 1 then
        self.go_table.obj_dayAward:SetActiveE(1)
        ---@type ArenaGlobalLeagueChangeView._obj_danAward_GoTable
        local tb
        local cfg, obj1
        for i = 1, #self.ungetAwards - 1 do
            cfg = _G.ConfigManager.arena_global_league_cfg[self.ungetAwards[i]]
            obj = _G.InstantiateObject(self.go_table.obj_danAward, self.go_table.obj_awardContent)
            obj:SetActiveE(1)
            tb = _G.GetAutoGoTable(obj)
            tb.aortext_danName.text = _G.GetLangPackValue(cfg.name)
            for j = 1, #cfg.layer_rewards do
                obj1 = _G.InstantiateObject(self.go_table.obj_awardItemLayout, tb.obj_award)
                obj1:SetActiveE(1)
                self:RefreshItem(j, obj1, cfg.layer_rewards[j])
            end
            if i < #self.ungetAwards - 1 then
                obj1 = _G.InstantiateObject(self.go_table.obj_blank, self.go_table.obj_awardContent)
                obj1:SetActiveE(1)
            end
        end
        _G.DelayFrameDo(
            function()
                local w, _ = self.go_table.obj_awardContent:GetRectTransformSize()
                local x, y, z = self.go_table.obj_awardContent:GetLocalPosition()
                if w > 600 then
                    self.go_table.obj_awardContent:SetLocalPosition(x + (w - 600) // 2, y, 0)
                end
            end
        )
    else
        self.go_table.obj_dayAward:SetActiveE(0)
    end
    local lastDan = ArenaGlobalModel:GetInstance():GetLastDan()
    if lastDan == 0 then
        self.go_table.aorrawimage_title:LoadImage("ImagesH5/hArenaGlobal/ui_dwzs_bt")
        self.go_table.aorrawimage_awardsBg:LoadImage("ImagesH5/hArenaGlobal/ui_dwzs_dk")
        self.go_table.aorrawimage_awardsBg2:LoadImage("ImagesH5/hArenaGlobal/ui_dwzs_dk")
    elseif lastDan < self.cfg.id then
        self.go_table.aorrawimage_title:LoadImage("ImagesH5/hArenaGlobal/ui_dwjs_bt")
        self.go_table.aorrawimage_awardsBg:LoadImage("ImagesH5/hArenaGlobal/ui_dwjs_dk")
        self.go_table.aorrawimage_awardsBg2:LoadImage("ImagesH5/hArenaGlobal/ui_dwjs_dk")
    elseif lastDan > self.cfg.id then
        self.go_table.aorrawimage_title:LoadImage("ImagesH5/hArenaGlobal/ui_dwjs_bt")
        self.go_table.aorrawimage_awardsBg:LoadImage("ImagesH5/hArenaGlobal/ui_dwjs_dk")
        self.go_table.aorrawimage_awardsBg2:LoadImage("ImagesH5/hArenaGlobal/ui_dwjs_dk")
    else
        self.go_table.aorrawimage_title:LoadImage("ImagesH5/hArenaGlobal/ui_dwjs_bt")
        self.go_table.aorrawimage_awardsBg:LoadImage("ImagesH5/hArenaGlobal/ui_dwjs_dk")
        self.go_table.aorrawimage_awardsBg2:LoadImage("ImagesH5/hArenaGlobal/ui_dwjs_dk")
    end
end

---掉落奖励道具刷新
function ArenaGlobalLeagueChangeView:RefreshItem(index, obj, award)
    obj:SetName(index)
    local tb = _G.GetAutoGoTable(obj)
    local isCur = award == nil
    award = award or self.awards[index]
    local sid = award[1]
    local num = award[2]
    local type = self:GetItemType(sid)
    _G.ItemFactory:GetInstance():GetItemCard(
        type,
        tb.obj_award,
        function(item)
            item:Show(
                sid,
                function()
                    if #self.ungetAwards > 0 then
                        self.ungetAwards = {}
                        ArenaGlobalModel:GetInstance():GetDayAward(
                            function()
                                for _, v in pairs(self.curItemEff) do
                                    v:SetActiveE(0)
                                end
                            end
                        )
                    else
                        require("CommonTipManager"):GetInstance():OpenTip(obj, sid)
                    end
                end,
                num
            )
            if isCur and #self.ungetAwards > 0 then
                -- if item.SetGradeNew then
                --     item:SetGradeNew()
                -- end
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
                    item.gameObject,
                    function(trans)
                        if self:IsNil() then
                            return
                        end
                        _G.table.insert(self.curItemEff, trans)
                    end
                )
            end
        end
    )
end

---获得item类型
function ArenaGlobalLeagueChangeView:GetItemType(sid)
    local storageType = _G.StorageManager:GetInstance():CheckSidType(sid)
    if storageType == _G.StorageType.Equipment then
        -- 装备
        return _G.ItemFactory.itemType.ItemEquipmentBase
    elseif storageType == _G.StorageType.Decoration then
        -- 饰品/刻魂
        return _G.ItemFactory.itemType.ItemDecorationBase
    elseif storageType == _G.StorageType.Card then
        -- 卡牌碎片
        return _G.ItemFactory.itemType.ItemDebrisBase
    elseif storageType == _G.StorageType.Artifact then
        -- 神器
        return _G.ItemFactory.itemType.ItemArtifactBase
    elseif storageType == _G.StorageType.Spiritual then
        -- 灵契
        return _G.ItemFactory.itemType.ItemSpiritualBase
    else
        -- 基础item
        return _G.ItemFactory.itemType.ItemBaseWithCount
    end
end

function ArenaGlobalLeagueChangeView:LoadEffect()
    _G.DelayDo(
        0.25,
        function()
            if self:IsNil() then
                return
            end
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_jinsheng_stageentry,
                self.go_table.aorrawimage_rankIcon,
                function(trans)
                    if self:IsNil() then
                        _G.UIUtils.RemoveEffect(trans)
                        return
                    end
                end
            )
        end
    )
    --23帧
    _G.DelayDo(
        0.759,
        function()
            if self:IsNil() then
                return
            end
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_jinsheng_rankpermanent,
                self.go_table.obj_eff,
                function(trans)
                    if self:IsNil() then
                        _G.UIUtils.RemoveEffect(trans)
                        return
                    end
                end
            )
        end
    )
end

function ArenaGlobalLeagueChangeView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end

function ArenaGlobalLeagueChangeView:OnStartClose()
    -- if self.go_table.toggle_noTip.isOn then
    local today = _G.TimeUtil.GetDayBegin(_G.TimeUtil.GetServerUnixTime())
    _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.ArenaGlobalLeagueChange, today)
    -- end
    if #self.ungetAwards > 0 then
        self.ungetAwards = {}
        ArenaGlobalModel:GetInstance():GetDayAward()
    end
end

---销毁对象时,析构函数
function ArenaGlobalLeagueChangeView:OnDestroy()
end

return ArenaGlobalLeagueChangeView
