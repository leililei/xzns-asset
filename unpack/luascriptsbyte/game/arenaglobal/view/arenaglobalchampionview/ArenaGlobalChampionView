local ArenaGlobalModel = require "ArenaGlobalModel"
local CardUtils = require "CardUtils"

---@class ArenaGlobalChampionView : UIBaseView	中文描述
local ArenaGlobalChampionView = _G.BaseClass("ArenaGlobalChampionView", _G.UIBaseView)

function ArenaGlobalChampionView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArenaGlobalChampionView:OnCreate(curRankData)
    self.curRankData = curRankData
    self.Time = ArenaGlobalModel:GetInstance().EggEndTime and
        ArenaGlobalModel:GetInstance().EggEndTime - _G.TimeUtil.GetServerUnixTime() or 0

    self.Timer = _G.TimerManager:GetInstance():GetTimer(1, self.OnTimeRemaining, self, false)
    self.Timer:Start()

    self:InitEffct()
    self:InitView()
    self:UpdateIcon()
end

function ArenaGlobalChampionView:UpdateIcon()
    local icon
    if not ArenaGlobalModel:GetInstance().EggAwardFlag then
        icon = "ImagesH5/nAFK/ui_box1"
        self.go_table.obj_redpoint:SetActiveE(1)
    else
        icon = "ImagesH5/nAFK/ui_box3"
        self.go_table.obj_redpoint:SetActiveE(0)
    end
    self.go_table.aorrawimage_box:LoadImage(icon)
end

function ArenaGlobalChampionView:OnTimeRemaining(elapsed)
    self.Time = self.Time - elapsed
    if self.Time > 0 then
        local t = _G.TimeUtil.TranslateSecond(self.Time)
        self.go_table.aortext_time.text = _G.GetLangPackValue(90033500133, t.day, t.hour, t.min)
    else
        self:Close()
    end
end

function ArenaGlobalChampionView:InitEffct()
    local tbOur = _G.GetAutoGoTable(self.go_table.obj_fameHallOur)

    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_SociatyMobaGuessView_our,
        tbOur.obj_ourEff,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
        end
    )
end

function ArenaGlobalChampionView:InitView()
    self:InitFameHall()
end

---名人堂
---@param msg guild.s2c_other_guild_pos_info
function ArenaGlobalChampionView:InitFameHall()
    ---@type ArenaGlobalChampionView._obj_fameHallOur_GoTable|ArenaGlobalChampionView._obj_fameHallEnemy_GoTable
    local tb = _G.GetAutoGoTable(self.go_table.obj_fameHallOur)
    local cfg = _G.ConfigManager.player_portrait_cfg
    if self.curRankData.rank[1] then 
        local icon = "ImagesH5/zRoles/" ..  cfg[self.curRankData.rank[1].style].portrait1
        tb.aortext_sociatyName.text = self.curRankData.rank[1].name
        self.go_table.aortext_tips.text = _G.GetLangPackValue(90033406004, self.curRankData.rank[1].name)
        tb.aorrawimage_icon:LoadImage(icon)
    end
    self:CreateRole(tb.obj_player1, self.curRankData.rank[1])
    self:CreateRole(tb.obj_player2, self.curRankData.rank[2])
    self:CreateRole(tb.obj_player3, self.curRankData.rank[3])
    self:CreateRole(tb.obj_player4, self.curRankData.rank[4])
    self:CreateRole(tb.obj_player5, self.curRankData.rank[5])
end

function ArenaGlobalChampionView:CreateRole(obj, role)
    if role then
        ---@type _obj_fameHallOur._obj_player1_GoTable
        local playerTb = _G.GetAutoGoTable(obj)
        playerTb.aortext_name.text = role.name
        playerTb.aortext_power.text = _G.GameUtil.NumberToUnitWord(role.power)
        -- playerTb.aorimage_official.SpriteName = officialBg[pos]
        -- playerTb.aortext_offName.text = _G.GetLangPackValue(_G.ConfigManager.guild_position_cfg[pos].name)
        -- playerTb.aortext_offName.color = officialColor[pos]
        -- playerTb.aortext_offName:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = officialOutlineColor[1]
        local cfg = require("CardInfoManager").GetCardSkin_ShowCfg(nil, role.city_style_id)
        local path = cfg.ModelPathHi
        local scale = cfg.size2
        if AppSetting.IsXzns then
            path = _G.UIUtils.GetBattleSpine(cfg)
            scale = cfg.size2
        end
        _G.PoolsManager:GetInstance():Spawn(
            path,
            _G.ePoolType.Temporary,
            playerTb.obj_spine,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                end
                trans:SetLocalScaleXYZ(scale)
                CardUtils.LoadGod_halo(trans,nil,role)
                if not table.isEmptyOrNil(role.artifact_skin) then
                    _G.UIUtils.LoadArtifacteffect(trans,nil,role.artifact_skin[1],role.artifact_skin[2])
                end
            end
        )
    else
        obj:SetActiveE(0)
    end
end

---按钮点击事件在这里派发
function ArenaGlobalChampionView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_AwardBox then
        ---点击领取宝箱
        if not ArenaGlobalModel:GetInstance().EggAwardFlag then
            ArenaGlobalModel:GetInstance():GetEggAward(function()
                self:UpdateIcon()
            end)
        end
    end
end

function ArenaGlobalChampionView:OnStartClose()
    if self.Timer then
        self.Timer:Stop()
        self.Timer = nil
    end
end

function ArenaGlobalChampionView:Dispose()
end

return ArenaGlobalChampionView
