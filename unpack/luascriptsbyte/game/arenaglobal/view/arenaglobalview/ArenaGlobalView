        return
    end
    local data = self.rankData.rank[index]
    if data then
        _G.SystemSettingManager:GetInstance():OpenView(data.uid)
    end
end

function ArenaGlobalView:RefreshRewardNode()
    ---@type arena_global_league_cfg
    self.curCfg = _G.ConfigManager.arena_global_league_cfg[self.curSelectPos]
    self.itemList = {}
    self.go_table.scrollloophorizontal_awards:UpdateCount(#self.curCfg.layer_rewards)
    self.go_table.scrollloophorizontal_awards:UpdateAllItem()
    local playCfg = _G.ConfigManager.arena_global_league_cfg[self.playCurPos]
    local curBgIndex = playCfg.id
    if self.curSelectToggle == self.toggleItems.battle then
        self.go_table.aorrawimage_bg:LoadImage(playCfg.background)
    elseif self.state == _G.ArenaGlobalState.Battle then
        self.go_table.aorrawimage_bg:LoadImage(playCfg.background)
        local day = 5 - ArenaGlobalModel:GetInstance():GetBattleDay()
        if day < 1 then
            day = 1
        elseif day > 5 then
            day = 5
        end
        local dayCfg = _G.ConfigManager.arena_global_league_cfg[day]
        self.go_table.aorrawimage_bg:LoadImage(dayCfg.background)
        curBgIndex = dayCfg.id
    else
        self.go_table.aorrawimage_bg:LoadImage(playCfg.background)
    end
    self:SetEffBgNode(self.go_table.obj_EffNode1,curBgIndex)
    self:SetEffBgNode(self.go_table.obj_EffNode2,curBgIndex)

    self.go_table.aorrawimage_stageIcon:LoadImage(self.curCfg.rank)
    self.go_table.aortext_stageName.text = GetLangPackValue(self.curCfg.name)
    self.go_table.obj_curState:SetActiveE(self.curCfg.id == playCfg.id and 1 or 0)

    if self.curSelectPos == 1 then
        self.go_table.aorbtn_left:SetActiveE(0)
        self.go_table.aorbtn_right:SetActiveE(1)
    elseif self.curSelectPos == #ConfigManager.arena_global_league_cfg then
        self.go_table.aorbtn_left:SetActiveE(1)
        self.go_table.aorbtn_right:SetActiveE(0)
    else
        self.go_table.aorbtn_left:SetActiveE(1)
        self.go_table.aorbtn_right:SetActiveE(1)
    end
end

