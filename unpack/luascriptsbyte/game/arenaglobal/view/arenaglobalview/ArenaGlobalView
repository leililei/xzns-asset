function ArenaGlobalView:UpdateState()
    local state, nextStateTime = ArenaGlobalModel:GetInstance():GetState()
    if state == _G.ArenaGlobalState.Prepare then
        -- self.go_table.aortext_state.text =  _G.GetLangPackValue(90033400021)
        self.go_table.aorimage_state.SpriteName = "ui_zgzf_txt_bzq"
    elseif state == _G.ArenaGlobalState.Battle then
        -- self.go_table.aortext_state.text =  _G.GetLangPackValue(90033400021)
        self.go_table.aorimage_state.SpriteName = "ui_zgzf_txt_tzq"
    else
        self.go_table.aorimage_state.SpriteName = "ui_zgzf_txt_jsq"
    end
    self.nextStateTime = nextStateTime
end

function ArenaGlobalView:UpdateMinState()
    local state, nextStateTime = ArenaGlobalModel:GetInstance():GetState()
    if state == _G.ArenaGlobalState.Prepare then
        self.minLangId = 90033404070
        self.nextMinStateTime = nextStateTime
    elseif state == _G.ArenaGlobalState.Settlement then
        self.minLangId = 90033404073
        self.nextMinStateTime = nextStateTime
        if nextStateTime <= 0 then
            self:Close()
            return true
        end
    else
        local sec = _G.TimeUtil.GetSecondsOfDay()
        local startT = ArenaGlobalModel:GetInstance().fightStartSec
        local endT = ArenaGlobalModel:GetInstance().fightEndSec
        if sec < startT then --开战前
            self.minLangId = 90033404071
            self.nextMinStateTime = startT - sec
        elseif sec < endT then --战斗中
            self.minLangId = 90033404072
            self.nextMinStateTime = endT - sec
        elseif nextStateTime < 86400 then --最后一天战斗结束
            self.minLangId = 90033404073
            self.nextMinStateTime = ArenaGlobalModel:GetInstance():GetEndTime() - _G.TimeUtil.GetServerUnixTime()
        else --明天还有新的战斗
            self.minLangId = 90033404071
            self.nextMinStateTime = 86400 - sec + startT
        end
    end
end

function ArenaGlobalView:UpdateView()
    self.leagueCfg = ArenaGlobalModel:GetInstance():GetCurDanCfg()
    local isBattle = ArenaGlobalModel:GetInstance():CheckShowBattle()
    local state = ArenaGlobalModel:GetInstance():GetState()
    local apply = ArenaGlobalModel:GetInstance():CheckHasApply()
    local showTag = (state ~= _G.ArenaGlobalState.Prepare and apply) and 1 or 0
    self.toggleItems["report"]:SetActiveE(showTag)
    self.toggleItems["rank"]:SetActiveE(showTag)
    self.toggleItems["embattle"]:SetActiveE(showTag)
    local showApply = not apply and state ~= _G.ArenaGlobalState.Settlement
    self.go_table.obj_Apply:SetActiveE(showApply and 1 or 0)
    self.go_table.obj_Prepare:SetActiveE((not showApply and not isBattle) and 1 or 0)
    local showBattleView = not showApply and isBattle
    self.go_table.obj_Battle:SetActiveE(showBattleView and 1 or 0)
    self.go_table.aortext_countDown:SetLocalPosition(1, showBattleView and -140 or -188)
    self.go_table.aortext_countDownMin:SetActiveE(showBattleView and 0 or 1)
    self.go_table.aortext_countDownBottom:SetActiveE(showBattleView and 1 or 0)
    self.go_table.aorimage_state:SetActiveE(showBattleView and 0 or 1)

    local showskip, skiprank, skipscore, skipname = ArenaGlobalModel:GetInstance():GetSkipInfo(ArenaGlobalModel
        :GetInstance().dan)
    if AppSetting.IsXzns then

    else
        self.go_table.aortext_showcanskip.text = _G.GetLangPackValue(90033404122, skiprank, skipscore,
                _G.GetLangPackValue(skipname))

        self.go_table.aortext_showcanskip:SetActiveE((showBattleView and showskip) and 1 or 0)
    end

    self.go_table.aortext_countDown:SetActiveE(1)
    if state ~= _G.ArenaGlobalState.Prepare then
        self.go_table.aorimage_title.SpriteName = self.leagueCfg.art
    else
        self.go_table.aorimage_title.SpriteName = "ui_jsbl_txt_jsbl"
    end
    self.go_table.aorimage_title:SetNativeSize()

    if not self.peakReport then
        ArenaGlobalNet:GetInstance():GetPeakReport(
            function(msg)
                self.peakReport = msg.logs or {}
                if self.go_table then
                    self.go_table.aorbtn_reportPeak:SetActiveE(showTag and #self.peakReport > 0 and 1 or 0)
                end
            end
        )
    end
    if showApply then
        if not self.applyLua then
            if self.gameObject:GetActiveSelf() == 0 then
                self.needUpdate = true
                return
            end
            ---@type ArenaGlobalApplyPanel
            self.applyLua =
                self:AddComponent(
                self.go_table.obj_Apply,
                require("ArenaGlobalApplyPanel").New(self, self.go_table.obj_Apply, self.activity,self)
            )
        end
    elseif isBattle then
        if not self.battleLua then
            if self.gameObject:GetActiveSelf() == 0 then
                self.needUpdate = true
                return
            end
            ---@type ArenaGlobalBattlePanel
            self.battleLua =
                self:AddComponent(
                    self.go_table.obj_Battle,
                    require("ArenaGlobalBattlePanel").New(self, self.go_table.obj_Battle, self.activity,self)
                )
        end
    else
        if not self.prepareLua then
            if self.gameObject:GetActiveSelf() == 0 then
                self.needUpdate = true
                return
            end
            ---@type ArenaGlobalPreparePanel
            self.prepareLua =
                self:AddComponent(
                    self.go_table.obj_Prepare,
                    require("ArenaGlobalPreparePanel").New(self, self.go_table.obj_Prepare, self.activity)
                )
        else
            self.prepareLua:UpdateView()
        end
    end

    if AppSetting.IsXzns then
        self:UpdateView_xzns()
    end
end

