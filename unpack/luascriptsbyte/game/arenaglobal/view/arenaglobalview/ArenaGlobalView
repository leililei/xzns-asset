---@param msg arena_global.p2c_log_notice
function ArenaGlobalView:OnNewLog(msg)
    for _, v in pairs(msg.log) do
        if v.type == 1 then --连胜
            -- _G.PopWindowManager:GetInstance():ShowAllTips(1080201, nil, nil, nil, nil, nil, v.args[1], v.args[3])
            v.content = _G.GetLangPackValue(90033404041, v.args[1], v.args[3])
            if _G.tonumber(v.args[3]) >= 20 then
                _G.table.insert(self.winLog[1], v)
            else
                _G.table.insert(self.winLog[3], v)
            end
        elseif v.type == 2 then --终结
            v.content = _G.GetLangPackValue(90033404042, v.args[1], v.args[2])
            _G.table.insert(self.winLog[2], v)
            -- _G.PopWindowManager:GetInstance():ShowAllTips(1080202, nil, nil, nil, nil, nil, v.args[1], v.args[2])
        end
    end
    for i = 1, 3 do
        if self.go_table["obj_itemLog" .. i]:GetActiveSelf() ~= 1 then
            self:SetWinBroadcastView(i)
        end
    end
end

