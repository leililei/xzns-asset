            self.battleLua =
            self:AddComponent(
                    self.go_table.obj_Battle,
                    require("ArenaGlobalBattlePanel").New(self, self.go_table.obj_Battle, self.activity,self)
            )
        end
        self.battleLua:RefreshUI()
    elseif self.curSelectToggle == self.toggleItems.settlement then
        if not self.settlementLua then
            ---@type ArenaGlobalSettlementPanel
