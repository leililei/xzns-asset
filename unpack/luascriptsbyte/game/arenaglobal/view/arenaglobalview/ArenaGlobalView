            self.go_table.toggle_report,
            _G.handlerbind(self, self.OnClickToggle, "report", _G.handler(self, self.OnReport))
        ),
        rank = _G.GetAutoGoTable(
            self.go_table.toggle_rank,
            _G.handlerbind(self, self.OnClickToggle, "rank", _G.handler(self, self.OnRank))
        ),
        gift = _G.GetAutoGoTable(
            self.go_table.toggle_gift,
            _G.handlerbind(self, self.OnClickToggle, "gift", _G.handler(self, self.OnGift))
        )
    }
    if AppSetting.IsXzns then
        self.toggleItems["battle"] = self.go_table.toggle_battle
        self.toggles["battle"] = _G.GetAutoGoTable(
                self.go_table.toggle_battle,
