function ArenaGlobalView:CheckShowLeagueView()
    if ArenaGlobalModel:GetInstance().hasShowLeague then
        return
    end
    if ArenaGlobalModel:GetInstance():CheckHasApply() then
        local today = _G.TimeUtil.GetDayBegin(_G.TimeUtil.GetServerUnixTime())
        if today ~= _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.ArenaGlobalLeagueChange) then
            local state, nextStateTime = ArenaGlobalModel:GetInstance():GetState()
            if state == _G.ArenaGlobalState.Battle then
                local gSettle, fSettle = ArenaGlobalModel:GetInstance():CheckIsSettle(state)
                if not (gSettle or fSettle) then
                    ArenaGlobalModel:GetInstance().hasShowLeague = true
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaGlobalLeagueChangeView.Name)
                end
            end
        end
    end
end

