        report = self.go_table.toggle_report,
        rank = self.go_table.toggle_rank,
        gift = self.go_table.toggle_gift
    }
    self.toggles = {
        main = _G.GetAutoGoTable(
            self.go_table.toggle_main,
            _G.handlerbind(self, self.OnClickToggle, "main", _G.handler(self, self.OnMain))
        ),
        award = _G.GetAutoGoTable(
            self.go_table.toggle_award,
            _G.handlerbind(self, self.OnClickToggle, "award", _G.handler(self, self.OnAward))
