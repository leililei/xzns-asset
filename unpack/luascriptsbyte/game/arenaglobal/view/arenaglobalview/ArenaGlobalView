function ArenaGlobalView:ScrollingView(isup,call)
    if self.isAnim then
        return
    end
    self.isAnim = true
    self.go_table.obj_hideNode:SetActiveE(0)
    local target = {}
    if isup then
        target = {0,-573,0}
    else
        target = {0,594,0}
    end
    local x,y,z = self.go_table.aorrawimage_bg:GetLocalPosition()
    self.go_table.obj_setBgEff:SetActiveE(0)
    self.go_table.obj_setBgEff:SetActiveE(1)
    self.doTween = _G.DOTween.To(
            function()
                return y
            end,
            function(x)
                self.go_table.aorrawimage_bg:SetLocalPosition(0,x,0)
            end,
            target[2],
            0.2
    )
    self.doTween:SetEase(_G.CS.DG.Tweening.Ease.Linear)
    self.doTween:SetLoops(-1, _G.CS.DG.Tweening.LoopType.Restart)
    self.doTween:OnStepComplete(
        function()
            self.isAnim = false
            if self.doTween then
                self.doTween:Kill()
                self.doTween = nil
            end
            self.go_table.aorrawimage_bg:SetLocalPosition(0,target[2],0)
            self.go_table.obj_hideNode:SetActiveE(1)
            if call then
                call()
            end
            self:UpdateView_xzns()
        end
    )
end

function ArenaGlobalView:CancelToggled(key)
    if not self.befTogKey or self.befTogKey == key then
        self.befTogKey = "main"
    end
    self.toggles[key].aorimage_isOn:SetActiveE(0)
    self.toggles[key].aorimage_isOff:SetActiveE(1)
    self:ShowBattleView(function()
        --self.toggleItems.battle.isOn = false
        self.toggleItems.battle.isOn = true
    end,function()
        self.toggles[self.befTogKey].aorimage_isOn:SetActiveE(1)
        self.toggles[self.befTogKey].aorimage_isOff:SetActiveE(0)
        self.toggleItems[self.befTogKey]:SetIsOnWithoutNotify(true)
        self.toggleItems[self.befTogKey].isOn = false
        self.toggleItems[self.befTogKey].isOn = true
    end)
end

function ArenaGlobalView:ShowBattleView(call,failCall)
    if AppSetting.IsXzns then
        if self.curSelectToggle == self.toggleItems.battle and self.showBattleView  then
            if call then
                call()
            end
            self:ScrollingView(false,function()
                self.curSelectToggle = self.toggleItems.battle
            end)
            self.curSelectToggle.isOn = false
            self.curSelectToggle.isOn = true
        elseif self.curSelectToggle == self.toggleItems.settlement then
            self.toggleItems.settlement.isOn = false
            self.toggleItems.settlement.isOn = true
        else
            if failCall then
                failCall()
            end
        end
    else
        if failCall then
            failCall()
        end
    end
end

function ArenaGlobalView:SetTaskAward()
    local itemData = ArenaGlobalModel:GetInstance():GetNextAward()
    if itemData then
        local target = ArenaGlobalModel:GetInstance():GetTotalFightTimes()
        if target > itemData.Cfg.count then
            target = itemData.Cfg.count
        end
        self.go_table.obj_taskAwardRoot:RemoveAllChildren()
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            itemData.Cfg.reward[1],
            self.go_table.obj_taskAwardRoot,
            function(tran)
                tran.gameObject:SetLocalScaleXYZ(0.7)
                if itemData.Cfg.reward[1][2] > 1 then
                    tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                else
                    tran:ShowNumText(false)
                end
                if tran.ShowEffectOrder and tran.cfg then
                    tran:ShowEffectOrder(tran.cfg.ef_item == 1 and true or false)
                end
            end
        )
        local w = target / itemData.Cfg.count
        if w > 1 then
            w = 1
        end
        local height = 20
        if AppSetting.IsXzns then
            height = 15
        end
        self.go_table.aorimage_awardBar:SetRectTransformSize(target > 0 and w * (87) or 0, height)
        self.go_table.aortext_taskAward.text = target .. "/" .. itemData.Cfg.count
    end
end

