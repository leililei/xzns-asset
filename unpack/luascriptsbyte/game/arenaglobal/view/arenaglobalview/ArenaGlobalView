function ArenaGlobalView:InitData()
    if AppSetting.IsXzns then
        self.curSelectPos = ArenaGlobalModel:GetInstance():GetDan()
        if self.curSelectPos == 0 then
            self.curSelectPos = 1
        end
        self.playCurPos = self.curSelectPos

        ---@type ArenaGlobalView._obj_Apply_GoTable
        self.obj_Apply = GetAutoGoTable(self.go_table.obj_Apply)
        ---@type ArenaGlobalView._obj_Battle_GoTable
        self.obj_Battle = GetAutoGoTable(self.go_table.obj_Battle)
        ---@type ArenaGlobalView._obj_Prepare_GoTable
        self.obj_Present = GetAutoGoTable(self.go_table.obj_Present)
        self.top3 = {
            _G.GetAutoGoTable(self.obj_Apply.obj_info1, _G.handlerbind(self, self.OnClickTop3, 1)),
            _G.GetAutoGoTable(self.obj_Apply.obj_info2, _G.handlerbind(self, self.OnClickTop3, 2)),
            _G.GetAutoGoTable(self.obj_Apply.obj_info3, _G.handlerbind(self, self.OnClickTop3, 3))
        }
        self:GetRankData()

        self:InitCurSelectToggle()
        self.go_table.scrollloophorizontal_awards:InitItemData(0, _G.handler(self, self.RefreshRewardItem))
    end
end

function ArenaGlobalView:GetRankData()
    local isBattle = ArenaGlobalModel:GetInstance():CheckShowBattle()
    self.state = ArenaGlobalModel:GetInstance():GetState()
    local apply = ArenaGlobalModel:GetInstance():CheckHasApply()
    local showApply = not apply and self.state ~= _G.ArenaGlobalState.Settlement
    self.showBattleView = not showApply and isBattle
    self:UpdateTop3()
    local showTag = (self.state ~= _G.ArenaGlobalState.Prepare)
    if showTag then
        ArenaGlobalModel:GetInstance():GetRankData(2, 1, _G.handler(self, self.UpdateTop3))
    end
end

