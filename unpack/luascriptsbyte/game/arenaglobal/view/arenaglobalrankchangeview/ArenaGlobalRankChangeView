local ArenaGlobalModel = require("ArenaGlobalModel")

---@class ArenaGlobalRankChangeView : UIBaseView	中文描述
---@field go_table ArenaGlobalRankChangeView_GoTable
local ArenaGlobalRankChangeView = _G.BaseClass("ArenaGlobalRankChangeView", _G.UIBaseView)

function ArenaGlobalRankChangeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建对象时,入口构造函数
function ArenaGlobalRankChangeView:OnCreate(oldNum, newNum, rankNum)
    self.go_table.aortext_oldRank.text = oldNum
    self.go_table.aortext_nowRank.text = newNum
    local limit1, limit2, layer = ArenaGlobalModel:GetInstance():GetRankLimit(rankNum)
    local state = ArenaGlobalModel:GetInstance():GetRankState(layer, limit1, limit2, newNum)
    local stateStr = ""
    if state == 1 then
        stateStr = _G.GetLangPackValue(90033404027)
    elseif state == 2 then
        stateStr = _G.GetLangPackValue(90033404028)
    elseif state == 3 then
        stateStr = _G.GetLangPackValue(90033404029)
    end
    local numStr = _G.string.AddColor(newNum, "FFDBAD")
    stateStr = _G.string.AddColor(stateStr, "E5BB3A")
    self.go_table.aortext_curRank.text = _G.GetLangPackValue(90033404120, numStr .. stateStr)
    if newNum < oldNum then
        self.go_table.aorimage_arrow.SpriteName = "ui_srjs_sl_icon"
        self.go_table.aorimage_arrow:SetLocalEulerAngles(0, 0, -90)
    else
        self.go_table.aorimage_arrow.SpriteName = "ui_srjs_sb_icon4"
        self.go_table.aorimage_arrow:SetLocalEulerAngles(0, 0, 90)
    end
end

function ArenaGlobalRankChangeView:InitView()
    
end
function ArenaGlobalRankChangeView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end

function ArenaGlobalRankChangeView:OnStartClose()
end

---销毁对象时,析构函数
function ArenaGlobalRankChangeView:OnDestroy()
end

return ArenaGlobalRankChangeView
