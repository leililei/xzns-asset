local CommonTipManager = require("CommonTipManager")
local ArenaGlobalNet = require("ArenaGlobalNet")

---@class ArenaGlobalReportDetailView : UIBaseView    中文描述
---@field public go_table ArenaGlobalReportDetailView_GoTable GoTable
---@field public reportData arena_global.i_global_fight_report GoTable
local ArenaGlobalReportDetailView = _G.BaseClass("ArenaGlobalReportDetailView", _G.UIBaseView)

local Alphas = {"255", "255"}
local Colors = {
    Win = {"FFE465", "FFFFFF"},
    Lose = {"8096C7", "FFFFFF"}
}

function ArenaGlobalReportDetailView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArenaGlobalReportDetailView:OnCreate(uid, aName, dName)
    self.uid = uid
    self.aName = aName
    self.dName = dName
    local pbData = {log_uid = uid}
    ArenaGlobalNet:GetInstance():FightReport(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self.reportData = msg.report
            self:InitView()
        end
    )
end

---初始化页面
function ArenaGlobalReportDetailView:InitView()
    self.teamAtk = {}
    self.teamDef = {}
    if self.reportData.a_team then
        for _, v in pairs(self.reportData.a_team) do
            self.teamAtk[v.index] = v
        end
    end
    if self.reportData.d_team then
        for _, v in pairs(self.reportData.d_team) do
            self.teamDef[v.index] = v
        end
    end
    for i = 1, 5 do
        if not self.teamAtk[i] then
            self.teamAtk[i] = self:CreateEmptyTeam(i)
        end
        if not self.teamDef[i] then
            self.teamDef[i] = self:CreateEmptyTeam(i)
        end
    end
    self.reportsLis = self.reportData.reports or {}
    self.go_table.aortext_empty:SetActiveE(#self.reportsLis == 0 and 1 or 0)
    self.go_table.scrollloopvectical_report:InitItemData(#self.reportsLis, _G.handler(self, self.RefreshReportItem))
end

function ArenaGlobalReportDetailView:CreateEmptyTeam(index)
    local team = {power = 0, index = index, card = {}}
    for i = 1, 5 do
        team.card[i] = {
            sid = 0,
            star = 0,
            lv = 0,
            index = i
        }
    end
    return team
end

function ArenaGlobalReportDetailView:RefreshReportItem(index, obj)
    index = index + 1
    ---@type arena_global.i_global_fight
    local data = self.reportsLis[index]
    ---@type ArenaGlobalReportDetailView._obj_reportItem_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickReport, index))
    tb.aortext_title.text = _G.GetLangPackValue(90031700039, _G.GameUtil.NumberToWordByLanguage(index))
    if AppSetting.IsXzns then
        tb.aorimage_win:SetActiveE(data.win and 1 or 0)
        tb.aorimage_failure:SetActiveE(data.win and 0 or 1)
    else
        tb.aortext_win.text = _G.GetLangPackValue(data.win and 90021800510 or 90021800511)
        CommonTipManager:GetInstance():SetTextGradient(data.win and Colors.Win or Colors.Lose, Alphas, tb.aortext_win)
    end
    self:ShowTeam(tb.obj_left, self.teamAtk[data.a_index], self.aName, data.a_cards)
    self:ShowTeam(tb.obj_right, self.teamDef[data.d_index], self.dName, data.d_cards)
end

---@param team arena_global.i_report_team
function ArenaGlobalReportDetailView:ShowTeam(obj, team, name, cardState)
    ---@type _obj_reportItem._obj_left_GoTable
    local tb = _G.GetAutoGoTable(obj)
    if not tb.cards then
        tb.cards = {}
    end
    tb.aortext_name.text = name
    local card
    for i = 1, 5 do
        card = team.card[i]
        if card and card.sid > 0 then
            tb["aorimage_mask" .. i]:SetActiveE((cardState and cardState[i] and cardState[i].hp == 0) and 1 or 0)
            if tb.cards[i] then
                tb.cards[i]:Show(card.sid, nil, card.star, card.level)
            else
                _G.ItemCardFactory:GetInstance():GetItemCard(
                    _G.ItemCardFactory.itemCardType.levelItem,
                    tb["trans_card" .. i],
                    _G.handlerbind(self, self.OnCardLoadedCall, tb, i, card)
                )
            end
        else
            tb["aorimage_mask" .. i]:SetActiveE(0)
            if tb.cards[i] then
                tb.cards[i].gameObject:SetActiveE(0)
            end
        end
    end
end

function ArenaGlobalReportDetailView:OnCardLoadedCall(item, tb, index, card)
    tb.cards[index] = item
    tb.cards[index]:Show(card.sid, nil, card.star, card.level)
end

function ArenaGlobalReportDetailView:OnClickReport(go, isOn, index)
    self.curIndex = index
    local pbData = {log_uid = self.uid, r_index = index}
    ArenaGlobalNet:GetInstance():ReportFightArgs(pbData, _G.handler(self, self.OnReplayReportCall))
end

function ArenaGlobalReportDetailView:OnReplayReportCall(msg)
    if msg.ack ~= 1 then
        return
    end
    self.fight_arg = msg.fight_arg
    local battleInfo = _G.BattleManager:GetInstance():GetStatisticsRecord(msg.fight_arg)
    self:UpdateData(battleInfo)
end

---@param data table 伤害数据
function ArenaGlobalReportDetailView:UpdateData(data)
    if not data then
        _G.PopWindowManager:GetInstance():ShowAllTips(540302)
        return
    end
    self.maxCount = _G.table.count(data.FighterInfo)
    self.PveData = self:InitData(data)

    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name,
        self.PveData,
        {self.reportsLis[self.curIndex].win and 0 or 1},
        nil,
        nil,
        nil,
        1,
        true,
        self.fight_arg,
        nil,
        nil, --战报uid暂不支持分享
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        { self.aName, self.dName }
    )
end

function ArenaGlobalReportDetailView:InitData(data)
    local tb = {}
    for i = 1, self.maxCount do
        local tempData = data.FighterInfo[i]
        local temp = {}
        temp.AtkUid = data.AtkUid
        temp.DefUid = data.DefUid
        temp.statisticsMax = {DmgOut = 1, DmgIn = 1, HpRecover = 1, CreateGuard = 1}
        temp.statisticsData = tempData
        for j = 1, #tempData.Attacker do
            if temp.statisticsMax.DmgOut < tempData.Attacker[j].DmgOut then
                temp.statisticsMax.DmgOut = tempData.Attacker[j].DmgOut
            end

            if temp.statisticsMax.DmgIn < tempData.Attacker[j].DmgIn then
                temp.statisticsMax.DmgIn = tempData.Attacker[j].DmgIn
            end

            if temp.statisticsMax.HpRecover < tempData.Attacker[j].HpRecover then
                temp.statisticsMax.HpRecover = tempData.Attacker[j].HpRecover
            end
            if temp.statisticsMax.CreateGuard < tempData.Attacker[j].CreateGuard then
                temp.statisticsMax.CreateGuard = tempData.Attacker[j].CreateGuard
            end
        end
        for j = 1, #tempData.Defender do
            if temp.statisticsMax.DmgOut < tempData.Defender[j].DmgOut then
                temp.statisticsMax.DmgOut = tempData.Defender[j].DmgOut
            end

            if temp.statisticsMax.DmgIn < tempData.Defender[j].DmgIn then
                temp.statisticsMax.DmgIn = tempData.Defender[j].DmgIn
            end

            if temp.statisticsMax.HpRecover < tempData.Defender[j].HpRecover then
                temp.statisticsMax.HpRecover = tempData.Defender[j].HpRecover
            end
            if temp.statisticsMax.CreateGuard < tempData.Defender[j].CreateGuard then
                temp.statisticsMax.CreateGuard = tempData.Defender[j].CreateGuard
            end
        end
        temp.CombMax = {DmgOut = 1, CreateGuard = 1, HpRecover = 1}
        for j = 1, #tempData.AtkCombineSkills[1] do
            if temp.CombMax.DmgOut < tempData.AtkCombineSkills[1][j].DmgOut then
                temp.CombMax.DmgOut = tempData.AtkCombineSkills[1][j].DmgOut
            end

            if temp.CombMax.CreateGuard < tempData.AtkCombineSkills[1][j].CreateGuard then
                temp.CombMax.CreateGuard = tempData.AtkCombineSkills[1][j].CreateGuard
            end

            if temp.CombMax.HpRecover < tempData.AtkCombineSkills[1][j].HpRecover then
                temp.CombMax.HpRecover = tempData.AtkCombineSkills[1][j].HpRecover
            end
        end
        for j = 1, #tempData.DefCombineSkills[1] do
            if temp.CombMax.DmgOut < tempData.DefCombineSkills[1][j].DmgOut then
                temp.CombMax.DmgOut = tempData.DefCombineSkills[1][j].DmgOut
            end

            if temp.CombMax.CreateGuard < tempData.DefCombineSkills[1][j].CreateGuard then
                temp.CombMax.CreateGuard = tempData.DefCombineSkills[1][j].CreateGuard
            end

            if temp.CombMax.HpRecover < tempData.DefCombineSkills[1][j].HpRecover then
                temp.CombMax.HpRecover = tempData.DefCombineSkills[1][j].HpRecover
            end
        end
        temp.PetMax = {DmgOut = 1, CreateGuard = 1, HpRecover = 1}
        for j = 1, #tempData.AtkPetSkills[1] do
            if temp.PetMax.DmgOut < tempData.AtkPetSkills[1][j].DmgOut then
                temp.PetMax.DmgOut = tempData.AtkPetSkills[1][j].DmgOut
            end

            if temp.PetMax.CreateGuard < tempData.AtkPetSkills[1][j].CreateGuard then
                temp.PetMax.CreateGuard = tempData.AtkPetSkills[1][j].CreateGuard
            end

            if temp.PetMax.HpRecover < tempData.AtkPetSkills[1][j].HpRecover then
                temp.PetMax.HpRecover = tempData.AtkPetSkills[1][j].HpRecover
            end
        end
        for j = 1, #tempData.DefPetSkills[1] do
            if temp.PetMax.DmgOut < tempData.DefPetSkills[1][j].DmgOut then
                temp.PetMax.DmgOut = tempData.DefPetSkills[1][j].DmgOut
            end

            if temp.PetMax.CreateGuard < tempData.DefPetSkills[1][j].CreateGuard then
                temp.PetMax.CreateGuard = tempData.DefPetSkills[1][j].CreateGuard
            end

            if temp.PetMax.HpRecover < tempData.DefPetSkills[1][j].HpRecover then
                temp.PetMax.HpRecover = tempData.DefPetSkills[1][j].HpRecover
            end
        end
        temp.TeamIndex = tempData.TeamIndex
        _G.table.insert(tb, temp)
    end
    return tb
end

---按钮点击事件在这里派发
function ArenaGlobalReportDetailView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_closeView then
        self:Close()
    end
end

---@private
function ArenaGlobalReportDetailView:OnDestroy()
end

return ArenaGlobalReportDetailView
