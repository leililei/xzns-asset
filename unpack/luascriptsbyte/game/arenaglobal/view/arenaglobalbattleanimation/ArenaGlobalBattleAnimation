local ArenaGlobalModel = require("ArenaGlobalModel")
---@class ArenaGlobalBattleAnimation : UIBaseView    中文描述
---@field public go_table ArenaGlobalBattleAnimation_GoTable GoTable
local ArenaGlobalBattleAnimation = _G.BaseClass("ArenaGlobalBattleAnimation", _G.UIBaseView)

---构造函数
---@protected
function ArenaGlobalBattleAnimation:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eArenaGlobal.ArenaGlobalFightEnd, self.SetEnd)
end

---界面的入口函数
---@param battleInfo arena_global.i_enemy
function ArenaGlobalBattleAnimation:OnCreate(battleInfo)
    --有可能服务器返回太快导致界面打开前就出了战斗结果
    if not ArenaGlobalModel:GetInstance().isRequestFighting then
        self:Close()
    end
    self.battleInfo = battleInfo
    if not self.timer then
        self.timer = _G.TimerManager:GetInstance():GetTimer(50, self.UpdateTimer, self, true, false, true)
        self.timer:Start()
    end
    self:InitView()
    self:LoadEffect()
end

function ArenaGlobalBattleAnimation:LoadEffect()
    local check = function(trans)
        if self:IsNil() then
            _G.DestroyObject(trans)
        end
    end
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_zhangezhengfeng_yijiantiaozhan,
        self.go_table.obj_effect,
        check
    )
end

function ArenaGlobalBattleAnimation:UpdateTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:Close()
end

---
---@protected
function ArenaGlobalBattleAnimation:InitView()
    if self.battleInfo then
        for i = 1, 3 do
            local cfg = require "CardCommentManager":GetInstance():CardData(self.battleInfo.city_style_id, false)
            self:LoadRoleModel(cfg, i)
        end
    end
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.prf_Mulading_zg,
        self.go_table.obj_left,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
            --self.leftAnimator = trans:GetComponentInChildrenE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
            --self.leftAnimator.AnimationState:Complete("+", _G.handler(self, self.AnimationFinish))
        end
    )
end

---加载单个角色
---@param view table 视图
---@param rolepath string 模型路径
---@param posIndex number 摆放的位置
---@param data activity_dispatch.i_target_role 玩家信息
function ArenaGlobalBattleAnimation:LoadRoleModel(cfg, posIndex, data)
    if cfg then
        _G.PoolsManager:GetInstance():Spawn(
            cfg.ModelPathHi,
            _G.ePoolType.Temporary,
            nil,
            function(trans)
                if trans == nil then
                    if _G.AppSetting.DEBUG then
                        _G.LogError("角色无法加载 path:" .. cfg.ModelPathHi .. "    CardInfoView LoadRoleScene")
                    end
                    return
                end
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                trans:SetParentE(self.go_table["obj_anemy_" .. posIndex])
                --trans:SetParentE(self.go_table.obj_right)
                trans:SetLocalPosition(0, 0, 0)
                trans:SetLocalScaleXYZ(1)
            end
        )
    end
end

---
---@protected
function ArenaGlobalBattleAnimation:SetEnd(msg)
    self.msg = msg
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:OpenResultView()
end

function ArenaGlobalBattleAnimation:AnimationFinish()
    if self.msg and self.tag == nil then
        self.tag = true
        self.leftAnimator.AnimationState:Complete("-", _G.handler(self, self.OpenResultView))
        if self.msg.winner ~= nil and self.msg.winner == true then
            self:OpenResultView()
        elseif self.msg.winner ~= nil and self.msg.winner == false then
            self.leftAnimator.AnimationState:SetAnimation(0, "zhange_lose", true)
            self.rightAnimator.AnimationState:Complete("+", _G.handler(self, self.Finish))
            self.rightAnimator.AnimationState:SetAnimation(0, "zhange_win", true)
        else
            self:Close()
        end
    end
end

