    -- local viewBattle = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ActivityDispatchBattleView.Name)

    -- if viewBattle ~= nil then
    --     ArenaGlobalModel:GetInstance():ReturnPanel()
    -- end
    -- _G.UIManager:GetInstance():OpenWindow(
    --     _G.ConfigManager.ui_cfg.ActivityDispatchAllBattleResultView.Name,
    --     function()
    --         -- ActivityDispatchModel:GetInstance():ReturnPanel()
    --     end,
    --     self.msg
    -- )
    self:Close()
end

function ArenaGlobalBattleAnimation:Finish()
    if self.num == nil then
        self.num = 0
    end
    self.num = self.num + 1
    if self.num >= 2 then
        self:OpenResultView()
    end
end

---界面的销毁函数
function ArenaGlobalBattleAnimation:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
function ArenaGlobalBattleAnimation:OnClickBtn(go)
end

return ArenaGlobalBattleAnimation
