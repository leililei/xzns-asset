local EmbattleController = require("EmbattleController")

---@class ArenaGlobalEmbattleView : UIBaseView    中文描述
---@field public go_table ArenaGlobalEmbattleView_GoTable GoTable
local ArenaGlobalEmbattleView = _G.BaseClass("ArenaGlobalEmbattleView", _G.UIBaseView)

function ArenaGlobalEmbattleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArenaGlobalEmbattleView:OnCreate(exitCall, battleCall, data, enemy, num, isDef, index)
    self.onExitCall = exitCall
    self.onBattleCall = battleCall
    self.data = data
    self.enemy = enemy
    self.num = num
    self.isDef = isDef
    self.index = index
    self:OpenEmbattleView()
end

function ArenaGlobalEmbattleView:OnDestroy()
    self.maxsid = nil
    self.onExitCall = nil
    self.onBattleCall = nil
end

function ArenaGlobalEmbattleView:OnClickBtn(go)
    if go == self.go_table.aorbtn_applayToDef then
        local item = EmbattleController:GetInstance():GetCurEmbattleItem()
        if item == nil then
            return
        end
        local tipId = self.isDef and 1080012 or 1080013
        _G.PopWindowManager:GetInstance():ShowAllTips(
            tipId,
            nil,
            function()
                if item.SaveEmbattleToAnother then
                    item:SaveEmbattleToAnother()
                end
            end,
            function()
            end
        )
    end
end

function ArenaGlobalEmbattleView:OpenEmbattleView()
    local danCfg = require("ArenaGlobalModel"):GetInstance():GetCurDanCfg()
    local num = self.num or danCfg.team
    local tb = {}
    for i = 1, num do
        tb[i] = i
    end
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    require("EmbattleController"):GetInstance():OpenEmbattle(
        tb,
        _G.EmbattleSaveType.server,
        false,
        self.isDef and _G.EmbattleControllerItemType.ArenaGlobalDefend or
            _G.EmbattleControllerItemType.ArenaGlobalAttack,
        _G.handler(self, self.OnExitCall),
        _G.handler(self, self.OnBattleCall),
        danCfg.battle_scene,
        self.enemy,
        self.data and self.data.name,
        self.data,
        self.index
    )
end

function ArenaGlobalEmbattleView:OnExitCall()
    self:Close()
    if self.onExitCall then
        self.onExitCall()
        self.onExitCall = nil
    end
end

function ArenaGlobalEmbattleView:OnBattleCall()
    if self.onBattleCall then
        self.onBattleCall(self.data)
        self.onBattleCall = nil
    end
    if self.enemy == nil then
        _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
        _G.UIManager:GetInstance():SetWorldSceneHideTimes(-1)
    end
    self:Close()
end

---监听界面打开
---@param name string 界面名称
function ArenaGlobalEmbattleView:OnEmbattleViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
        ---@type EmbattleNewView
        self.embattleView = _G.UIManager:GetInstance():GetWindowCtrl(name)
        --设置对阵信息
        _G.UIManager:GetInstance():ChangeCanvasOrder(
            name,
            self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
        )
        self.embattleView.transform:SetParentE(self.go_table.trans_view)
        self.embattleView:SetEffLoadCall(
            function()
                self.go_table.aorbtn_applayToDef:SetActiveE(0)
            end
        )
        self.embattleView:SetQuitCallback(_G.handler(self, self.CheckQuitEmbattle))
        self.embattleView.onBtnFuncRun = false
    end
end

function ArenaGlobalEmbattleView:CheckQuitEmbattle(call)
    local item = EmbattleController:GetInstance():GetCurEmbattleItem()
    local dan = item:GetEmbattleTypeCount()
    if _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.ArenaGlobalAutoSaveEmbattle) ~= dan then
        item:SaveEmbattle(
            function()
                _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.ArenaGlobalAutoSaveEmbattle, dan)
                call(true)
            end
        )
    else
        call(true)
    end
end

return ArenaGlobalEmbattleView
