local CommonTipManager = require("CommonTipManager")
local ArenaGlobalModel = require("ArenaGlobalModel")
local ArenaGlobalNet = require("ArenaGlobalNet")

---@class ArenaGlobalReportView : UIBaseView    中文描述
---@field public go_table ArenaGlobalReportView_GoTable GoTable
local ArenaGlobalReportView = _G.BaseClass("ArenaGlobalReportView", _G.UIBaseView)

function ArenaGlobalReportView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

local Alphas = {"255", "255"}
local Colors = {
    Win = {"FFE465", "FFFFFF"},
    Lose = {"8096C7", "FFFFFF"}
}
local Tag = {
    Win = "0ui_img_shengliqi",
    Lose = "0ui_img_shibai"
}
local Tag1 = {
    Win = "ui_dscj_zbjm_qzh",
    Lose = "ui_dscj_zbjm_qzl"
}
local Tag2 = {
    Win = "ui_dscj_zbjm_sl",
    Lose = "ui_dscj_zbjm_sb"
}
local Arrow = {
    Win = "0ui_icon_shangsheng",
    Lose = "0ui_icon_xiajiang"
}

---界面的入口函数
function ArenaGlobalReportView:OnCreate(isPeak, activityClass)
    -- self.activityClass = activityClass
    -- self.typeClass = activityClass.typeClass
    self.name = _G.PlayerModel:GetInstance():GetName()
    self.go_table.obj_peak:SetActiveE(0)
    self.go_table.obj_self:SetActiveE(0)
    self:InitToggle()
    self:InitView()
    self.go_table.obj_emptySelf:SetActiveE(0)
    self.go_table.obj_emptyPeak:SetActiveE(0)
    if isPeak then
        self.go_table.toggle_peak.isOn = false
        self.go_table.toggle_peak.isOn = true
    else
        self.go_table.toggle_self.isOn = false
        self.go_table.toggle_self.isOn = true
    end
    self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))
end

---初始化页面
function ArenaGlobalReportView:InitView()
end

function ArenaGlobalReportView:InitToggle()
    self.toggles = {
        peak = _G.GetAutoGoTable(
            self.go_table.toggle_peak,
            _G.handlerbind(self, self.OnClickToggle, "peak", _G.handler(self, self.OnPeak))
        ),
        mySelf = _G.GetAutoGoTable(
            self.go_table.toggle_self,
            _G.handlerbind(self, self.OnClickToggle, "mySelf", _G.handler(self, self.OnMySelf))
        )
    }
end

function ArenaGlobalReportView:OnClickToggle(go, isOn, key, call)
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if call then
        call(isOn)
    end
end

function ArenaGlobalReportView:OnPeak(isOn)
    self.go_table.obj_peak:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    self:UpdatePeakReport()
end

function ArenaGlobalReportView:OnMySelf(isOn)
    self.go_table.obj_self:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    self:UpdateSelfReport()
end

function ArenaGlobalReportView:UpdatePeakReport()
    if self.peakReport then
        return
    end
    self.peakReport = true
    ArenaGlobalNet:GetInstance():GetPeakReport(
        function(msg)
            self.peakReport = msg.logs or {}
            if not self.peakInit then
                self.peakInit = true
                self.go_table.scrollloopvectical_peakReport:InitItemData(
                    #self.peakReport,
                    _G.handler(self, self.RefreshPeakItem)
                )
            else
                self.go_table.scrollloopvectical_peakReport:UpdateCount(#self.peakReport)
            end
            self.go_table.obj_emptyPeak:SetActiveE(#self.peakReport == 0 and 1 or 0)
        end
    )
end

function ArenaGlobalReportView:RefreshPeakItem(index, obj)
    index = index + 1
    ---@type arena_global.i_peak_log
    local data = self.peakReport[index]
    ---@type ArenaGlobalReportView._obj_peakReportItem_GoTable
    local tb =
        _G.GetAutoGoTable(
        obj,
        _G.handlerbind(self, self.OnClickReport, data.r_uid, data.atk_role.name, data.def_role.name)
    )
    tb.aortext_nameLeft.text = data.atk_role.name
    tb.aortext_nameRight.text = data.def_role.name
    tb.aortext_stateLeft.text = _G.GetLangPackValue(data.win and 90021800510 or 90021800511)
    tb.aortext_stateRight.text = _G.GetLangPackValue(data.win and 90021800511 or 90021800510)
    if AppSetting.IsXzns then
        tb.aorimage_leftState.SpriteName = data.win and Tag2[1] or Tag2[2]
        tb.aorimage_rightState.SpriteName = data.win and Tag2[2] or Tag2[1]
    end
    CommonTipManager:GetInstance():SetTextGradient(data.win and Colors.Win or Colors.Lose, Alphas, tb.aortext_stateLeft)
    CommonTipManager:GetInstance():SetTextGradient(
        data.win and Colors.Lose or Colors.Win,
        Alphas,
        tb.aortext_stateRight
    )
    tb.obj_bg:SetLocalEulerAngles(0, 0, data.win and 0 or 180)
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemLeft, data.atk_role, 1, true, true, true)
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemRight, data.def_role, 1, true, true, true)
end

function ArenaGlobalReportView:UpdateSelfReport()
    if self.selfReport and not ArenaGlobalModel:GetInstance():CheckHasNewReport() then
        return
    end
    self.selfReport = true
    ArenaGlobalNet:GetInstance():GetSelfReport(
        function(msg)
            self.selfReport = msg.log or {}
            if not self.selfInit then
                self.selfInit = true
                self.go_table.scrollloopvectical_selfReport:InitItemData(
                    #self.selfReport,
                    _G.handler(self, self.RefreshSelfItem)
                )
            else
                self.go_table.scrollloopvectical_selfReport:UpdateCount(#self.selfReport)
            end
            self.go_table.obj_emptySelf:SetActiveE(#self.selfReport == 0 and 1 or 0)
            ArenaGlobalModel:GetInstance():SetHasNewReport()
        end
    )
end

function ArenaGlobalReportView:RefreshSelfItem(index, obj)
    index = index + 1
    ---@type arena_global.i_fight_log
    local data = self.selfReport[index]
    local aName, dName
    if data.f_type == 1 then --1进攻2防守
        aName = self.name
        dName = data.r_info.name
    else
        aName = data.r_info.name
        dName = self.name
    end
    ---@type ArenaGlobalReportView._obj_selfReportItem_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickReport, data.log_uid, aName, dName))
    local bgIcon = data.win and Tag.Win or Tag.Lose
    if AppSetting.IsXzns then
        bgIcon = data.win and Tag1.Win or Tag1.Lose
        tb.aorimage_resultTag2.SpriteName = data.win and Tag2.Win or Tag2.Lose
    end
    tb.aorimage_resultTag.SpriteName = bgIcon
    tb.aorimage_arrow.SpriteName = data.win and Arrow.Win or Arrow.Lose
    tb.aortext_name.text = data.r_info.name
    if data.add_score == 0 then
        tb.aorimage_arrow:SetActiveE(0)
        tb.aortext_score.text = _G.GetLangPackValue(90033404093) .. data.score
    else
        tb.aorimage_arrow:SetActiveE(1)
        local add = _G.string.AddColor((data.win and " +" or " -") .. data.add_score, data.win and "00721D" or "C02214")
        tb.aortext_score.text = _G.GetLangPackValue(90033404093) .. data.score .. add
    end
    tb.aortext_time.text = self:TranslateTime(data.f_time)
    tb.aortext_timeFight.text = _G.TimeUtil.date("%m-%d %H:%M:%S", data.f_time)
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data.r_info, 1, true, true, true)
end

function ArenaGlobalReportView:TranslateTime(time)
    local servertime = _G.TimeUtil.GetServerUnixTime()
    time = _G.TimeUtil.TranslateSecond(servertime - time)
    if time.day > 0 then
        time.day = time.day > 30 and 30 or time.day
        return _G.string.format(_G.LangUtil.GetLangPackValue(90022100085), time.day)
    end
    if time.hour > 0 then
        return _G.string.format(_G.LangUtil.GetLangPackValue(90022100086), time.hour)
    end
    time.min = time.min > 0 and time.min or 1
    return _G.string.format(_G.LangUtil.GetLangPackValue(90022100083), time.min)
end

function ArenaGlobalReportView:OnClickReport(go, isOn, uid, aName, dName)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaGlobalReportDetailView.Name, uid, aName, dName)
end

---按钮点击事件在这里派发
function ArenaGlobalReportView:OnClickBtn(go, isOn)
end

---@private
function ArenaGlobalReportView:OnDestroy()
end

return ArenaGlobalReportView
