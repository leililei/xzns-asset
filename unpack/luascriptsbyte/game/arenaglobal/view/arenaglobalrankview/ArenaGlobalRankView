local ArenaGlobalModel = require("ArenaGlobalModel")
local RankUtils = require("RankUtils")
local CardUtils = require("CardUtils")

---@class ArenaGlobalRankView : UIBaseView    中文描述
---@field public go_table ArenaGlobalRankView_GoTable GoTable
local ArenaGlobalRankView = _G.BaseClass("ArenaGlobalRankView", _G.UIBaseView)

function ArenaGlobalRankView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.stateName = {
        "ui_jsbl_grph_jjq",
        "ui_jsbl_grph_bjq",
        "ui_jsbl_grph_jj"
    }
    self.stateText = {
        _G.GetLangPackValue(90033404090),
        _G.GetLangPackValue(90033404091),
        _G.GetLangPackValue(90033404092)
    }
    self.stateColor = {
        { _G.ColorTools.FormatColorByString("FFFAAD"), _G.ColorTools.FormatColorByString("0E5105") },
        { _G.ColorTools.FormatColorByString("FFDBAD"), _G.ColorTools.FormatColorByString("6A3505") },
        { _G.ColorTools.FormatColorByString("DCD5EA"), _G.ColorTools.FormatColorByString("241A30") }
    }

    self.stateNameSkip = "ui_jsbl_grph_yj"
    if AppSetting.IsXzns then
        self.stateName = {
            "ui_phjm_jj",
            "ui_phjm_bj",
            "ui_phjm_jianj"
        }
        self.stateNameSkip = "ui_phjm_jj"
    end
    self.stateTextSkip = _G.GetLangPackValue(90033404124)
    self.stateColorSkip = { _G.ColorTools.FormatColorByString("FFFAAD"), _G.ColorTools.FormatColorByString("0E5105") }
end

---界面的入口函数
function ArenaGlobalRankView:OnCreate()
    --self:InitUI()
end

function ArenaGlobalRankView:InitUI()
    if self.isInit == nil then
        self.top3 = {
            _G.GetAutoGoTable(self.go_table.obj_info1, _G.handlerbind(self, self.OnClickTop3, 1)),
            _G.GetAutoGoTable(self.go_table.obj_info2, _G.handlerbind(self, self.OnClickTop3, 2)),
            _G.GetAutoGoTable(self.go_table.obj_info3, _G.handlerbind(self, self.OnClickTop3, 3))
        }
        self.tbType = { _G.GetAutoGoTable(self.go_table.obj_self), _G.GetAutoGoTable(self.go_table.obj_peak) }
        self.listInit = {}
        self.uid = _G.PlayerModel:GetInstance():GetPlayerUid()
        self:InitToggle()
        self:InitView()
        if ArenaGlobalModel:GetInstance():CheckApplyAndGroup() then
            self.go_table.toggle_dan.isOn = false
            self.go_table.toggle_dan.isOn = true
        else
            self.go_table.toggle_peak.isOn = false
            self.go_table.toggle_peak.isOn = true
        end
        --self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))
        self.isInit = true
    end
end

--重置界面层级 由ArenaGlobalView控制层级后再刷新界面，防止称号层级错误
function ArenaGlobalRankView:ResetLayout(layout)
    local canvas = self.go_table.transform:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
    canvas.sortingOrder = layout
    if self.isInit then

    else
        self:InitUI()
    end
    if self.PlayerComponent == nil then
        self.PlayerComponent = self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))
    end
end

---初始化页面
function ArenaGlobalRankView:InitView()
    self:UpdatePageText()
end

function ArenaGlobalRankView:UpdatePageText()
    local cfg = ArenaGlobalModel:GetInstance():GetCurDanCfg()
    if not self.pageTxt then
        ---@type ArenaGlobalRankView._toggle_dan_GoTable
        local tb = _G.GetAutoGoTable(self.go_table.toggle_dan)
        self.pageTxt = { tb.aortext_isOn, tb.aortext_isOff }
    end
    local danName = _G.GetLangPackValue(cfg.name)
    local name = _G.GetLangPackValue(90033404031, danName)
    self.pageTxt[1].text = name
    self.pageTxt[2].text = name
    self.go_table.aortext_dan.text = danName
    if ArenaGlobalModel:GetInstance().danGroup == 0 then
        self.go_table.aortext_danGroup:SetActiveE(0)
    else
        self.go_table.aortext_danGroup:SetActiveE(1)
        self.go_table.aortext_danGroup.text = "（" ..
                _G.GetLangPackValue(90033404094, ArenaGlobalModel:GetInstance().danGroup) .. "）"
    end
end

function ArenaGlobalRankView:InitToggle()
    self.toggles = {
        dan = _G.GetAutoGoTable(
            self.go_table.toggle_dan,
            _G.handlerbind(self, self.OnClickToggle, "dan", _G.handler(self, self.OnDanRank))
        ),
        peak = _G.GetAutoGoTable(
            self.go_table.toggle_peak,
            _G.handlerbind(self, self.OnClickToggle, "peak", _G.handler(self, self.OnPeakRank))
        )
    }
end

function ArenaGlobalRankView:OnClickToggle(go, isOn, key, call)
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if call then
        call(isOn)
    end
end

function ArenaGlobalRankView:OnDanRank(isOn)
    self.go_table.obj_self:SetActiveE(isOn and 1 or 0)
    self.go_table.obj_peak:SetActiveE(isOn and 0 or 1)
    if not isOn then
        return
    end
    self.curType = 1
    local canS, canP = ArenaGlobalModel:GetInstance():CheckCanRequestRank()
    if not ArenaGlobalModel:GetInstance():CheckApplyAndGroup() then
        self.go_table.toggle_peak.isOn = true
        _G.PopWindowManager:GetInstance():ShowAllTips(canS and 5304 or 1080203)
        return
    end
    if not canS then
        _G.PopWindowManager:GetInstance():ShowAllTips(1080203)
        self.go_table.toggle_peak.isOn = true
        return
    end
    if self.danFirst then
        ArenaGlobalModel:GetInstance():GetRankData(1, 1, _G.handlerbind(self, self.RefreshRank, 1))
    else
        self.danFirst = true
        self.danCfg = ArenaGlobalModel:GetInstance():GetCurDanCfg()
        ArenaGlobalModel:GetInstance():ClearRankData(1)
        ArenaGlobalModel:GetInstance():GetRankData(1, 1, _G.handlerbind(self, self.RefreshRank, 1, true))
    end
end

function ArenaGlobalRankView:OnPeakRank(isOn)
    self.go_table.obj_peak:SetActiveE(isOn and 1 or 0)
    self.go_table.obj_self:SetActiveE(isOn and 0 or 1)
    if not isOn then
        return
    end
    self.curType = 2
    ArenaGlobalModel:GetInstance():GetRankData(2, 1, _G.handlerbind(self, self.RefreshRank, 2))
end

---@param rankData arena_global.s2c_global_rank
function ArenaGlobalRankView:RefreshRank(rankData, type, newData)
    self.rankData = rankData
    if self.curType == 1 then
        self.limit1, self.limit2, self.layer = ArenaGlobalModel:GetInstance():GetRankLimit(rankData.r_num)
    end
    local num = #self.rankData.rank
    if type == 2 then
        num = _G.Mathf.Max(num, 3)
    end
    if not self.listInit[type] then
        self.tbType[type].scrollloopvectical_rankList:InitItemData(
            num,
            _G.handler(self, self.RefreshItem)
        )
        self.listInit[type] = true
    else
        self.tbType[type].scrollloopvectical_rankList:UpdateCount(num)
    end
    self:UpdateTop3()
    self:RefreshSelfRank(type)
    if newData then
        _G.Events:GetInstance():Broadcast(_G.eArenaGlobal.ArenaGlobalRankRefresh, rankData)
    end
    self.isRefresh = true
end

function ArenaGlobalRankView:UpdateRank()
    if self.go_table.toggle_dan.isOn then
        self.danCfg = ArenaGlobalModel:GetInstance():GetCurDanCfg()
        ArenaGlobalModel:GetInstance():ClearRankData(1)
        ArenaGlobalModel:GetInstance():GetRankData(1, 1, _G.handlerbind(self, self.RefreshRank, 1, true))
    end
    self:UpdatePageText()
end

function ArenaGlobalRankView:RefreshItem(index, obj)
    index = index + 1
    ---@type _obj_self._obj_rankItem_GoTable
    local tb = _G.GetAutoGoTable(obj)
    local data = self.rankData.rank[index]
    -- RankUtils.SetRankItemBgIcon(tb.aorimage_bg, index)
    if index <= 3 then
        tb.aortext_rank:SetActiveE(0)
        tb.aorimage_rank3:SetActiveE(1)
        RankUtils.SetTop3RankStyle(index, tb.aorimage_rank3, tb.aortext_rank3)
    else
        tb.aortext_rank:SetActiveE(1)
        tb.aorimage_rank3:SetActiveE(0)
        tb.aortext_rank.text = index
    end
    if data == nil then
        tb.obj_content:SetActiveE(0)
        tb.obj_noBody:SetActiveE(1)
        return
    end
    tb.obj_content:SetActiveE(1)
    tb.obj_noBody:SetActiveE(0)

    tb.aortext_name.text = data.name
    tb.aortext_desc.text = data.score
    local roleData = data
    if data.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
        roleData = _G.PlayerModel:GetInstance():GetIRroleTable()
    end
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, roleData, 0.7, true, true, true)
    if self.curType == 1 then
        tb.aortext_add.text = self:GetDanPeakScore(index)
        local canskip = ArenaGlobalModel:GetInstance():CheckCanSkip(
            ArenaGlobalModel:GetInstance().dan, index, data.score)
        if canskip then
            tb.aorimage_state.SpriteName = self.stateNameSkip
            tb.aortext_state.text = self.stateTextSkip
            tb.aortext_state.color = self.stateColorSkip[1]
            tb.aortext_state:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = self.stateColorSkip[2]
            RankUtils.SetRankItemBgIcon(tb.aorimage_bg, 2)
        else
            local state = ArenaGlobalModel:GetInstance():GetRankState(self.layer, self.limit1, self.limit2, index)
            tb.aorimage_state.SpriteName = self.stateName[state]
            tb.aortext_state.text = self.stateText[state]
            tb.aortext_state.color = self.stateColor[state][1]
            tb.aortext_state:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = self.stateColor[state][2]
            if state == 1 then
                RankUtils.SetRankItemBgIcon(tb.aorimage_bg, 1)
            elseif state == 2 then
                RankUtils.SetRankItemBgIcon(tb.aorimage_bg, 3)
            else
                RankUtils.SetRankItemBgIcon(tb.aorimage_bg, 4)
            end
        end
        if data.uid == self.uid then
            tb.aorimage_state:SetActiveE(ArenaGlobalModel:GetInstance():CheckMinFightTimes() and 1 or 0)
        else
            tb.aorimage_state:SetActiveE(1)
        end
    else
        RankUtils.SetRankItemBgIcon(tb.aorimage_bg, index)
    end
end

function ArenaGlobalRankView:GetDanPeakScore(index)
    if self.danCfg == nil then
        return 0
    end
    for _, v in pairs(self.danCfg.points_rank) do
        if index >= v[1] and index <= v[2] then
            return v[3]
        end
    end
end

function ArenaGlobalRankView:RefreshSelfRank(type)
    self.tbType[type].obj_selfRoot:SetActiveE(1)
    local tb = _G.GetAutoGoTable(self.tbType[type].obj_selfRank)
    local rank = self.rankData.rank_num
    if rank == 0 then
        tb.obj_noRank:SetActiveE(1)
        tb.aortext_rank:SetActiveE(0)
        tb.aorimage_rank3:SetActiveE(0)
    elseif rank <= 3 then
        tb.obj_noRank:SetActiveE(0)
        tb.aortext_rank:SetActiveE(0)
        tb.aorimage_rank3:SetActiveE(1)
        RankUtils.SetTop3RankStyle(rank, tb.aorimage_rank3, tb.aortext_rank3)
    else
        tb.obj_noRank:SetActiveE(0)
        tb.aortext_rank:SetActiveE(1)
        tb.aorimage_rank3:SetActiveE(0)
        tb.aortext_rank.text = rank
    end
    tb.aortext_name.text = _G.PlayerModel:GetInstance():GetName()
    
    if type == 1 then
        local score = ArenaGlobalModel:GetInstance():GetScore()
        tb.aortext_desc.text = score
        tb.aortext_add.text = rank == 0 and 0 or self:GetDanPeakScore(rank)

        local canskip = ArenaGlobalModel:GetInstance():CheckCanSkip(
            ArenaGlobalModel:GetInstance().dan, rank, score)
        if canskip then
            tb.aorimage_state.SpriteName = self.stateNameSkip
            tb.aortext_state.text = self.stateTextSkip
            tb.aortext_state.color = self.stateColorSkip[1]
            tb.aortext_state:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = self.stateColorSkip[2]
        else
            local state = ArenaGlobalModel:GetInstance():GetRankState(self.layer, self.limit1, self.limit2, rank)
            tb.aorimage_state.SpriteName = self.stateName[state]
            tb.aorimage_state:SetActiveE(ArenaGlobalModel:GetInstance():CheckMinFightTimes() and 1 or 0)
            tb.aortext_state.text = self.stateText[state]
            tb.aortext_state:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = self.stateColor[state][2]
        end
    else
        local score = ArenaGlobalModel:GetInstance():GetPeakScore()
        tb.aortext_desc.text = score
    end
    local roleData = _G.PlayerModel:GetInstance():GetIRroleTable()
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, roleData, 0.7, true, true, true)
end

function ArenaGlobalRankView:UpdateTop3()
    for i = 1, 3 do
        self:ShowTopRank(i)
    end
end

function ArenaGlobalRankView:ShowTopRank(index)
    ---@type _obj_Battle._obj_info1_GoTable
    local tb = self.top3[index]
    local data = self.rankData.rank[index]
    tb.trans_role:ClearChildren()
    if data then
        tb.aorrawimage_norole:SetActiveE(0)
        tb.aortext_name.text = data.name
        local cfg = require "CardCommentManager":GetInstance():CardData(data.city_style_id, false)
        self:LoadRoleModel(tb, cfg,data)
        self:ShowTitle(tb, data.title)
    else
        tb.aorrawimage_norole:SetActiveE(1)
        tb.aortext_name.text = _G.GetLangPackValue(90000010159)
        self:ShowTitle(tb, nil)
    end
end

---@param cfg card_cfg
function ArenaGlobalRankView:LoadRoleModel(tb, cfg,data)
    local scale = cfg.size2
    local pos = cfg.pos_portrait
    local path = _G.UIUtils.GetBattleSpine(cfg, _G.UseBattleSpine.RankView)
    if _G.UIUtils.IsUseBattleSpine(_G.UseBattleSpine.RankView) then
        scale = cfg.size4
        pos = { 0, 0, 0 }
    end
    _G.PoolsManager:GetInstance():Spawn(
        path,
        _G.ePoolType.Temporary,
        tb.trans_role,
        function(trans)
            if trans == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("角色无法加载 path:" .. path .. "    CardInfoView LoadRoleScene")
                end
                return
            end
            if self.go_table == nil then
                _G.DestroyObject(trans)
                return
            end
            trans:SetLocalPosition(pos[1], pos[2], pos[3])
            trans:SetLocalScaleXYZ(scale)
            CardUtils.LoadGod_halo(trans,nil,data)
            if not table.isEmptyOrNil(data.artifact_skin) then
                _G.UIUtils.LoadArtifacteffect(trans,nil,data.artifact_skin[1],data.artifact_skin[2])
            end
        end
    )
end

function ArenaGlobalRankView:ShowTitle(tb, data)
    tb.obj_titleEffect:RemoveAllChildren()
    if data == nil or data.sid == 0 then
        tb.aorrawimage_title:SetActiveE(0)
        return
    end
    local titleScale = _G.ConfigManager.discrete_cfg[100111][1][1]
    local player_title = _G.ConfigManager.player_title_effect_cfg[data.sid]
    if player_title.type_title == 1 then
        tb.aorrawimage_title:LoadImage(player_title.title)
        tb.aorrawimage_title:SetActiveE(1)
        tb.aorrawimage_title:SetLocalScaleXYZ(0.29 * titleScale)
    elseif player_title.type_title == 2 then
        _G.UIUtils.LoadEffectTitleOrFrame(
            player_title.title,
            tb.obj_titleEffect,
            function(trans)
                if self.go_table == nil then
                    _G.DestroyObject(trans)
                    return
                end
                local parClip = trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                parClip.NeedCheck = true
                parClip.CheckCount = 10
                parClip.CheckOne = 3
                trans:SetLocalScaleXYZ(titleScale)
            end
        )
        tb.aorrawimage_title:SetActiveE(0)
    end
end

function ArenaGlobalRankView:OnClickTop3(go, isOn, index)
    local data = self.rankData.rank[index]
    if data then
        _G.SystemSettingManager:GetInstance():OpenView(data.uid)
    end
end

---按钮点击事件在这里派发
function ArenaGlobalRankView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_help then
        if self.go_table.toggle_dan.isOn then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 181)
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 180)
        end
    end
end

