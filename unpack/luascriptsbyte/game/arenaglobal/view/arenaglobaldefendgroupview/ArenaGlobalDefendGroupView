local ArenaGlobalModel = require("ArenaGlobalModel")
local EmbattleModel = require "EmbattleModel"

--region单个编组
local ArenaGlobalDefendGroupItem = _G.BaseClass("ArenaGlobalDefendGroupItem")

local Level = 300

function ArenaGlobalDefendGroupItem:__init(obj, onChoose, unlock, petUnlock, onClear)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.onChooseCall = onChoose
    self.onClearCall = onClear
    self.unLock = unlock
    self.petSkillUnlock = petUnlock
    self.cardDic = {
        self.go_table.trans_card1,
        self.go_table.trans_card2,
        self.go_table.trans_card3,
        self.go_table.trans_card4,
        self.go_table.trans_card5
    }
    self.cardItems = {false, false, false, false, false}
end
function ArenaGlobalDefendGroupItem:Dispose()
    self.go_table = nil
    self.onChooseCall = nil
    self.index = nil
    self.cardDic = nil
end
function ArenaGlobalDefendGroupItem:OnClickBtn(go)
    self:EditEmbattle()
end

function ArenaGlobalDefendGroupItem:OnSkillBtnClick(index)
    if self.unLock[index] > 0 then
        local afkCfg = _G.ConfigManager.afk_cfg[self.unLock[index]]
        _G.PopWindowManager:GetInstance():ShowAllTips(140116, nil, nil, nil, nil, nil, afkCfg.chapter, afkCfg.section)
        return
    end
    self:EditEmbattle()
end

---展示布阵
---@param index number 序列号
---@param item EmbattleItemGroup 布阵对象
function ArenaGlobalDefendGroupItem:Show(garry, index)
    self.index = index
    self.garry = garry
    -- self.onSkillCloseHandler = _G.handler(self, self.OnCombCloseCall)
    self.onCardCallHandler = _G.handler(self, self.OnCardCall)
    self.go_table.aortext_NO.text = _G.GetLangPackValue(90033404056, _G.GameUtil.NumberToWordByLanguage(index))
    self:SetCombineItem(garry.pet)
    self:ShowCard()
end

---设置宠物技
function ArenaGlobalDefendGroupItem:SetCombineItem(pet)
    local petItem, petCfg, skillId, cfgt, cfg, petData, star
    for i = 1, 3 do
        petItem = _G.GetAutoGoTable(self.go_table["obj_petSkills" .. i])
        if self.petSkillUnlock[i] then
            petItem.obj_lock:SetActiveE(0)
            if pet[i] and pet[i] > 0 then
                petData = require("PetModel"):GetInstance():GetPet(pet[i])
                -- petItem.aortext_name.text = _G.GetLangPackValue(petCfg.Name)
                -- petItem.aorimage_bg.SpriteName = PetOrderFrame[petCfg.Order]
                petItem.aorrawimage_icon:SetActiveE(1)
                petItem.obj_type:SetActiveE(1)
                petCfg = _G.ConfigManager.pet_cfg[pet[i]]
                skillId = petCfg.skill_id[1]
                cfgt = _G.ConfigManager.card_skills_cfg[skillId]
                cfg = cfgt and _G.ConfigManager.battle_skill_cfg[cfgt.skills[1]]
                petItem.aorrawimage_icon:LoadImage(cfg and cfg.Icon or "")
                petItem.obj_empty:SetActiveE(0)
                petItem.aortext_type.text = _G.ConfigManager.language_package_cfg[cfg.Brief]
            else
                petItem.aorrawimage_icon:SetActiveE(0)
                petItem.obj_type:SetActiveE(0)
                petItem.obj_empty:SetActiveE(1)
            end
        else
            petItem.obj_lock:SetActiveE(1)
            petItem.obj_type:SetActiveE(0)
            petItem.obj_empty:SetActiveE(0)
        end

        star = petData and petData.star or 0
        for j = 1, 5 do
            petItem["obj_star" .. j]:SetActiveE(star >= j and 1 or 0)
        end
    end
end

---展示卡牌
function ArenaGlobalDefendGroupItem:ShowCard()
    self.sumPower = 0
    self.cardData = self.garry.sits
    self.cardIndex = 1
    self:HandleCardOneByOne()
end
function ArenaGlobalDefendGroupItem:HandleCardOneByOne()
    if self.cardIndex > #self.cardData then
        self.cardData = nil
        self.cardIndex = nil
        self.go_table.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(self.sumPower)
        return
    end
    local uid = self.cardData[self.cardIndex]
    local data
    if uid > 0 then
        data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
    end
    if data then
        self.sumPower = self.sumPower + data:GetPowerByLevel(Level)
        local card = self.cardItems[self.cardIndex]
        if card then
            card.gameObject:SetActiveE(1)
            local skin

            if data and data.skin ~= 0 then
                skin = true
            else
                skin = false
            end
            card:Show(
                data.sid,
                nil,
                data.star,
                Level,
                nil,
                data.soulLink_lv,
                skin,
                data.soulLink_IsActivate,
                data.open_inborn
            )
            self.cardIndex = self.cardIndex + 1
            self:HandleCardOneByOne()
        else
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.levelItem,
                self.cardDic[self.cardIndex],
                self.onCardCallHandler
            )
        end
    else
        if self.cardItems[self.cardIndex] then
            self.cardItems[self.cardIndex].gameObject:SetActiveE(0)
        end
        self.cardIndex = self.cardIndex + 1
        self:HandleCardOneByOne()
    end
end

function ArenaGlobalDefendGroupItem:OnCardCall(card)
    self.cardItems[self.cardIndex] = card
    card.transform:SetLocalPositionToZero()
    local uid = self.cardData[self.cardIndex]
    local caradata = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
    local skin

    if caradata and caradata.skin ~= 0 then
        skin = true
    else
        skin = false
    end
    self.cardItems[self.cardIndex]:Show(
        caradata.sid,
        nil,
        caradata.star,
        Level,
        nil,
        caradata.soulLink_lv,
        skin,
        caradata.soulLink_IsActivate,
        caradata.open_inborn
    )
    self.cardIndex = self.cardIndex + 1
    self:HandleCardOneByOne()
end

---使用编队
function ArenaGlobalDefendGroupItem:UseEmbattle()
    self.onChooseCall(self.index)
end

---打开合击技
function ArenaGlobalDefendGroupItem:OpenCombSkillView()
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.EmbattleCombineSkillView.Name,
        self.combSkill,
        self.onSkillCloseHandler
    )
end

---当合击技界面关闭
---@param data table 合击技ID
function ArenaGlobalDefendGroupItem:OnCombCloseCall(data)
    self.combSkill = data
    self:ShowSkill()
end

---编辑编队
function ArenaGlobalDefendGroupItem:EditEmbattle()
    self.onChooseCall(self.index, true)
end

function ArenaGlobalDefendGroupItem:CheckEmpty()
    for _, v in pairs(self.garry.sits) do
        if v > 0 then
            return false
        end
    end
    for _, v in pairs(self.garry.pet) do
        if v > 0 then
            return false
        end
    end
    for _, v in pairs(self.garry.skill_index) do
        if v > 0 then
            return false
        end
    end
    return true
end

--endregion

---@class ArenaGlobalDefendGroupView : UIBaseView    中文描述
---@field public go_table ArenaGlobalDefendGroupView_GoTable GoTable
local ArenaGlobalDefendGroupView = _G.BaseClass("ArenaGlobalDefendGroupView", _G.UIBaseView)

function ArenaGlobalDefendGroupView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---@param clearCall function 销毁布阵类回调
function ArenaGlobalDefendGroupView:OnCreate(embattleItem, embattleIndex, call, clearCall)
    self.curEmbattleItem = embattleItem
    self.curEmbattleIndex = embattleIndex
    self.closeCall = call
    self.clearCall = clearCall
    self.itemChooseHandler = _G.handler(self, self.OnGroupChoose)
    self.groupItems = {}
    self.skillUnLockTag = {false, false, false}
    for i = 1, #self.skillUnLockTag do
        if EmbattleModel:GetInstance():CheckSkillPosUnLock(i) then
            self.skillUnLockTag[i] = 0
        else
            self.skillUnLockTag[i] = EmbattleModel:GetInstance():GetSkillPosUnLockParam(i)
        end
    end
    self.petUnlockStates = {}
    for i = 1, 3 do
        self.petUnlockStates[i] = EmbattleModel:GetInstance():CheckPetSkillPosUnLock(i)
    end
    self:InitToggles()
    self.defGarray = {}
    self:UpdateDefGarray()
    self.toggleItem[self.curGroup].isOn = false
    self.toggleItem[self.curGroup].isOn = true
    self.go_table.scrollloopvectical_group:InitItemData(self.curGroup, _G.handler(self, self.OnGroupItemCall))
    self.listInit = true
end

function ArenaGlobalDefendGroupView:UpdateDefGarray(force)
    if not self.defGarray[self.curGroup] or force then
        self.defGarray[self.curGroup] = {}
        for i = 1, self.curGroup do
            self.defGarray[self.curGroup][i] = ArenaGlobalModel:GetInstance():GetDefendGarray(self.curGroup, i)
            if self.defGarray[self.curGroup][i] == nil then
                self.defGarray[self.curGroup][i] = {
                    id = self.curGroup * 100 + i,
                    sits = {0, 0, 0, 0, 0},
                    skill_index = {0, 0, 0},
                    pet = {0, 0, 0}
                }
            end
        end
    end
end

function ArenaGlobalDefendGroupView:InitToggles()
    self.toggleItem = {
        self.go_table.toggle_1,
        self.go_table.toggle_2,
        self.go_table.toggle_3,
        self.go_table.toggle_4,
        self.go_table.toggle_5
    }
    self.toggles = {}
    for i = 1, 5 do
        self.toggles[i] = _G.GetAutoGoTable(self.toggleItem[i], _G.handlerbind(self, self.OnClickToggle, i))
    end
    self.curGroup = 1
end

function ArenaGlobalDefendGroupView:OnClickToggle(go, isOn, key)
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if isOn then
        self.curGroup = key
        self:OnGroupChange()
    end
end

function ArenaGlobalDefendGroupView:OnGroupChange()
    if not self.listInit then
        return
    end
    self:UpdateDefGarray()
    self.go_table.scrollloopvectical_group:UpdateCount(self.curGroup)
    self.go_table.scrollloopvectical_group:ScrollToTop()
end

function ArenaGlobalDefendGroupView:RefreshCurList()
    self:UpdateDefGarray(true)
    self.go_table.scrollloopvectical_group:UpdateAllItem()
end

function ArenaGlobalDefendGroupView:OnDestroy()
    self:RemoveAllListener()
    self.closeCall = nil
    self.itemChooseHandler = nil
    self.groupItems = nil
    if self.clearCall then
        self.clearCall()
    end
    self.clearCall = nil
end

---按钮点击事件在这里派发
function ArenaGlobalDefendGroupView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_closeView then
        self:Close()
    elseif go == self.go_table.aorbtn_applyTo then
        local tipId = 1080012
        _G.PopWindowManager:GetInstance():ShowAllTips(
            tipId,
            nil,
            function()
                local garrys = {}
                for i = 1, self.curGroup do
                    garrys[i] = self.defGarray[self.curGroup][i]
                end
                require "ArenaGlobalModel":GetInstance():SaveAttackGarray(
                    self.curGroup,
                    garrys,
                    function()
                        _G.PopWindowManager:GetInstance():ShowAllTips(1080014)
                    end
                )
            end,
            function()
            end
        )
    elseif go == self.go_table.aorbtn_embattle then
        self:OnGroupChoose()
    end
end

function ArenaGlobalDefendGroupView:OnGroupItemCall(index, obj)
    local insID = obj:GetInstanceID()
    local item = self.groupItems[insID]
    if not item then
        item =
            ArenaGlobalDefendGroupItem.New(
            obj,
            self.itemChooseHandler,
            self.skillUnLockTag,
            self.petUnlockStates,
            _G.handler(self, self.RefreshCurList)
        )
        self.groupItems[insID] = item
    end
    index = index + 1
    item:Show(self.defGarray[self.curGroup][index], index)
end

---选择编队
---@param index number 编队序列
---@param edit boolean 是否编辑
---@return 变量类型 中文描述
function ArenaGlobalDefendGroupView:OnGroupChoose(index, edit)
    ArenaGlobalModel:GetInstance():OpenDefence(
        self.curGroup,
        index,
        function()
            self:Show()
            self:RefreshCurList()
        end
    )
    self:Hide()
end

return ArenaGlobalDefendGroupView
