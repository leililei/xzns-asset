local ArenaGlobalModel = require("ArenaGlobalModel")
local ArenaGlobalNet = require("ArenaGlobalNet")

---@class ArenaGlobalApplyPanel : UIBaseView 英雄面板
---@field go_table ArenaGlobalView._obj_Apply_GoTable
---@field roleList role.i_role[]
local ArenaGlobalApplyPanel = _G.BaseClass("ArenaGlobalApplyPanel", _G.UIBaseView)

local headScale = {
    [1] = 0.8,
    [2] = 0.74,
    [3] = 0.74,
    [4] = 0.68,
    [5] = 0.68
}

local index = {
    [1] = 4,
    [2] = 2,
    [3] = 1,
    [4] = 3,
    [5] = 5
}

local index2 = {
    [1] = 1,
    [2] = 3,
    [3] = 5,
    [4] = 4,
    [5] = 2
}

function ArenaGlobalApplyPanel:__init(parent, obj, activityClass,view)
    self.parent = parent
    self.activity = activityClass
    self.typeClass = activityClass.typeClass
    self.view = view
    self.roleList = {}
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.headTb = _G.GetAutoGoTable(self.go_table.obj_camp1)
end

function ArenaGlobalApplyPanel:OnCreate()
    self:AddListener(_G.AnimationEvents.ActivityDispatchSignUp, self.PlayAnimation, self)
    self:InitView()
end

function ArenaGlobalApplyPanel:InitView()
    self.headIndex = 0
    local pbData = {page = 1}
    -- ArenaGlobalNet:GetInstance():GetApplyRole(pbData, _G.handler(self, self.ShowHead))
    ArenaGlobalNet:GetInstance():GetApplyRole(pbData, _G.handler(self, self.GetApplyRoleEnd))
    self.go_table.obj_root:SetActiveE(0)
    self.go_table.obj_redpointTask:UpdateRedPointItemIDAndParam(self.typeClass:GetRedpointIDByIndex(5))
    self:UpdateView()
end

function ArenaGlobalApplyPanel:UpdateView()
end

function ArenaGlobalApplyPanel:GetApplyRoleEnd(msg)
    if msg.ack ~= 1 then
        return
    end
    self.roleList = msg.role_info or {}
end

function ArenaGlobalApplyPanel:ShowHead(msg)
    if msg.ack ~= 1 then
        self.headTb.obj_headParent:SetActiveE(0)
        return
    end

    self.roleList = msg.role_info or {}
    self.headTb.obj_headParent:SetActiveE(#self.roleList > 0 and 1 or 0)
    self.isPlayAnimation = #self.roleList > 1
    if self.isPlayAnimation then
        self.headIndex = #self.roleList - 2
    end
    self:SetHeadAnimation()
end

function ArenaGlobalApplyPanel:SetHeadAnimation()
    self.headIndex = self.headIndex + 1
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    local goTable = self.headTb
    for i = 1, 5 do
        local headIndex = self.isPlayAnimation == false and index2 or index
        local obj = goTable["obj_head" .. headIndex[i]]
        local j = i + self.headIndex - 1
        if j >= #self.roleList and self.isPlayAnimation == true then
            j = j % #self.roleList
            if j == 0 then
                j = #self.roleList
            end
        end
        if self.isPlayAnimation == false then
            j = i
        end
        local data1 = self.roleList[j]
        obj:SetActiveE(data1 ~= nil and 1 or 0)
        if data1 ~= nil then
            _G.UIUtils.SetPlayerHeadItemNew(obj, data1, headScale[i], true, true, true)
            if i == 1 then
                goTable.aortext_name.text = data1.name
            end
        end
    end
    if #self.roleList > 1 and self.headIndex > 1 then
        for j = 1, 2 do
            local obj = goTable["obj_headAdd" .. j]
            local index = j == 1 and self.headIndex + 1 or self.headIndex - 1
            if index >= #self.roleList and self.isPlayAnimation == true then
                index = index % #self.roleList
                if index == 0 then
                    index = #self.roleList
                end
            end
            local data1 = self.roleList[index]
            if data1 ~= nil then
                _G.UIUtils.SetPlayerHeadItemNew(obj, data1, headScale[j == 1 and 1 or 5], true, true, true)
            end
        end
    end
    if self.headIndex == 1 and self.isPlayAnimation then
        if not self.timer then
            self.timer = _G.TimerManager:GetInstance():GetTimer(2, self.SetHeadAnimation, self, true, false, true)
            self.timer:Start()
        end
    elseif self.isPlayAnimation then
        if self.AnimComponent == nil then
            self.AnimComponent = self.go_table.obj_root:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
        end
        self.AnimComponent:Play("Ani_ActivityDispatchSignUpView_1")
    end
end

function ArenaGlobalApplyPanel:PlayAnimation()
    self.AnimComponent:Play("New State")
    if not self.timer then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.SetHeadAnimation, self, true, false, true)
        self.timer:Start()
    end
end

---按钮点击事件在这里派发
function ArenaGlobalApplyPanel:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_signUp then
        local state = ArenaGlobalModel:GetInstance():GetState()
        local isSettle = ArenaGlobalModel:GetInstance():CheckIsSettle()
        if isSettle or state == _G.ArenaGlobalState.Settlement then
            if _G.AppSetting.DEBUG then
                _G.LogError("当前阶段无法报名")
            end
            return
        end
        ArenaGlobalModel:GetInstance():Apply(
                function()
                    if self:IsNil() then
                        return
                    end
                    self.go_table.aorbtn_signUp:SetActiveE(0)
                end
        )
    elseif go == self.go_table.aorbtn_task then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaGlobalTaskView.Name)
    elseif go == self.go_table.aorbtn_rank then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaGlobalCampPlayerView.Name, self.roleList)
    elseif go == self.go_table.aorbtn_embattle then
        -- _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaGlobalDefendGroupView.Name)
        local cfg = ArenaGlobalModel:GetInstance():GetCurDanCfg()
        ArenaGlobalModel:GetInstance():OpenDefence(cfg.team, 1)
    elseif go == self.go_table.aorbtn_layArray then
        self.view:OnEmbattle("embattle",true)
    elseif go == self.go_table.aorbtn_battleMsg then
        self.view:OnReport("report",true)
    end
end

function ArenaGlobalApplyPanel:RefreshUI()
    local isHasApply = ArenaGlobalModel:GetInstance():CheckHasApply()
    self.go_table.aorbtn_signUp:SetActiveE(isHasApply and 0 or 1)
    self.go_table.obj_messageNode:SetActiveE(isHasApply and 1 or 0)
    local isBattle = ArenaGlobalModel:GetInstance():CheckShowBattle()
    self.go_table.obj_messageNode:SetActiveE(isBattle and 1 or 0)
    local isShowEmbattle = isHasApply and not isBattle  or false
    self.go_table.aorbtn_embattle:SetActiveE(isShowEmbattle and 1 or 0)
    self.state = ArenaGlobalModel:GetInstance():GetState()
    local apply = ArenaGlobalModel:GetInstance():CheckHasApply()
    local showTag = (self.state ~= _G.ArenaGlobalState.Prepare and apply)
    local groupIng,isCheck = ArenaGlobalModel:GetInstance():CheckIsSettle()
    if showTag and isCheck == false then
        self:UpdatePeak()
        self:UpdateScore()
        self:UpdatePower()
        ArenaGlobalModel:GetInstance():GetRankData(1, 1, _G.handler(self, self.UpdateRank))
    end
end

function ArenaGlobalApplyPanel:UpdatePeak()
    --ZHJH-15478巅峰积分换成段位
    local danCfg = ArenaGlobalModel:GetInstance():GetCurDanCfg()
    local showtxt = _G.GetLangPackValue(90033404010, _G.string.AddColor(_G.GetLangPackValue(danCfg.name), "EEC398"))
    if AppSetting.IsXzns then
        showtxt = _G.GetLangPackValue(90033404010,_G.GetLangPackValue(danCfg.name))
    end
    self.go_table.aortext_serverArea.text = showtxt
end

function ArenaGlobalApplyPanel:UpdateScore()
    local showtxt = _G.GetLangPackValue(90033404013, _G.string.AddColor(ArenaGlobalModel:GetInstance():GetScore(), "EEC398"))
    if AppSetting.IsXzns then
        showtxt = _G.GetLangPackValue(90033404013, ArenaGlobalModel:GetInstance():GetScore())
    end
    self.go_table.aortext_myScore.text = showtxt
end

function ArenaGlobalApplyPanel:UpdatePower()
    self.go_table.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(ArenaGlobalModel:GetInstance():CalTeamPower())
end

function ArenaGlobalApplyPanel:UpdateRank(data)
    self.rankData = data
    local danCfg = ArenaGlobalModel:GetInstance():GetCurDanCfg()
    local layer = danCfg.layer
    if self.rankData.rank_num == 0 then
        self.go_table.aortext_myRank.text = _G.GetLangPackValue(90022900040)
        if not ArenaGlobalModel:GetInstance():CheckMinFightTimes() then
            self.go_table.aortext_rankState.text = ""
            return
        end
        if layer[2][1] == 10000 then --无人降级
            self.go_table.aortext_rankState.text = _G.GetLangPackValue(90033404028) --保级
        else
            self.go_table.aortext_rankState.text = _G.GetLangPackValue(90033404029) --降级
        end
    else
        local showtxt = _G.string.AddColor(self.rankData.rank_num, "EEC398")
        if AppSetting.IsXzns then
            showtxt = self.rankData.rank_num
        end

        self.go_table.aortext_myRank.text = _G.GetLangPackValue(90033404011, showtxt)
        if not ArenaGlobalModel:GetInstance():CheckMinFightTimes() then
            self.go_table.aortext_rankState.text = ""
            return
        end
        local limit = self.rankData.r_num * layer[1][1] // 10000
        limit = _G.Mathf.Max(limit, layer[1][2])
        if self.rankData.rank_num <= limit or self.rankData.r_num == 1 or self.rankData.r_num <= layer[1][2] then
            if layer[1][1] == 0 then --无人晋级
                self.go_table.aortext_rankState.text = _G.GetLangPackValue(90033404028) --保级
            else
                self.go_table.aortext_rankState.text = _G.GetLangPackValue(90033404027) --晋级
            end
        else
            limit = self.rankData.r_num * layer[2][1] // 10000
            limit = _G.Mathf.Max(limit, self.rankData.r_num - layer[2][2] + 1)
            if self.rankData.rank_num >= limit and layer[2][1] < 10000 then
                self.go_table.aortext_rankState.text = _G.GetLangPackValue(90033404029) --降级
            else
                self.go_table.aortext_rankState.text = _G.GetLangPackValue(90033404028) --保级
            end
        end
    end
end

function ArenaGlobalApplyPanel:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:RemoveAllListener()
end

return ArenaGlobalApplyPanel
