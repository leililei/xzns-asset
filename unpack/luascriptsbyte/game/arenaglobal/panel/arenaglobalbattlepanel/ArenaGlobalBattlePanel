local ArenaGlobalModel = require("ArenaGlobalModel")
local ArenaGlobalNet = require("ArenaGlobalNet")

---@class ArenaGlobalBattlePanel : UIBaseView 英雄面板
---@field go_table ArenaGlobalView._obj_Battle_GoTable
---@field leagueCfg arena_global_league_cfg
local ArenaGlobalBattlePanel = _G.BaseClass("ArenaGlobalBattlePanel", _G.UIBaseView)

function ArenaGlobalBattlePanel:__init(parent, obj, activityClass,view)
    self.parent = parent
    self.activity = activityClass
    self.typeClass = activityClass.typeClass
    ---@type ArenaGlobalView
    self.view = view
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.curLoadIngRole = {}
    self.enemys = {
        _G.GetAutoGoTable(self.go_table.obj_enemy1, _G.handlerbind(self, self.OnClickEnemy, 1)),
        _G.GetAutoGoTable(self.go_table.obj_enemy2, _G.handlerbind(self, self.OnClickEnemy, 2)),
        _G.GetAutoGoTable(self.go_table.obj_enemy3, _G.handlerbind(self, self.OnClickEnemy, 3)),
        _G.GetAutoGoTable(self.go_table.obj_enemy4, _G.handlerbind(self, self.OnClickEnemy, 4)),
        _G.GetAutoGoTable(self.go_table.obj_enemy5, _G.handlerbind(self, self.OnClickEnemy, 5))
    }
    self.top3 = {
        _G.GetAutoGoTable(self.go_table.obj_info1, _G.handlerbind(self, self.OnClickTop3, 1)),
        _G.GetAutoGoTable(self.go_table.obj_info2, _G.handlerbind(self, self.OnClickTop3, 2)),
        _G.GetAutoGoTable(self.go_table.obj_info3, _G.handlerbind(self, self.OnClickTop3, 3))
    }

    if AppSetting.IsXzns then
        local res = {}
        _G.table.insert(res, _G.ConfigManager.discrete_cfg[127117][1][1])
        -- self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, res))
        self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, res))
    end
end

function ArenaGlobalBattlePanel:OnCreate()
    self.leagueCfg = _G.ConfigManager.arena_global_league_cfg[1]
    self.consumeCfg = _G.ConfigManager.discrete_cfg[127108]
    self:InitView()
    self:AddListener(_G.eArenaGlobal.ArenaGlobalFightSettleEnd, self.OnBattleEnd)
    self:AddListener(_G.eArenaGlobal.ArenaGlobalScoreChange, self.OnBeAttacked)
    self:AddListener(_G.eArenaGlobal.ArenaGlobalAtkEmbattleChange, self.UpdatePower)
    self:AddListener(_G.eArenaGlobal.ArenaGlobalRankRefresh, self.UpdateTop3)
    self:AddListener(_G.eArenaGlobal.ArenaGlobalSetAuto, self.SetAutoBtn)
end

function ArenaGlobalBattlePanel:InitView()
    self.go_table.aortext_myRank.text = ""
    self.go_table.aortext_rankState.text = ""
    -- self:UpdateConsumeNum()
    self:UpdatePeak()
    self:UpdateScore()
    self:UpdatePower()
    self:UpdateFreeTimes()
    local times = ArenaGlobalModel:GetInstance():GetRefreshTimes()
    if times == 0 then
        self:RefreshEnemy()
    else
        self:UpdateEmemy()
    end
    local activity =
        require "ActivitySynManager":GetInstance():GetChildAcitivity(10014, self.activity:GetJumpType(self.ActivityID))
    if activity then
        self.go_table.obj_redpointGift:UpdateRedPointItemIDAndParam(
            activity:GetActivityTypeCls():GetRedpointIDByIndex(1)
        )
        self.go_table.aorbtn_gift:SetActiveE(1)
    else
        self.go_table.aorbtn_gift:SetActiveE(0)
    end
    self.go_table.obj_redpointTask:UpdateRedPointItemIDAndParam(self.typeClass:GetRedpointIDByIndex(5))
    -- self.go_table.toggle_skip.isOn = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.ArenaGlobalOutSkip) == 1
    local times = ArenaGlobalModel:GetInstance():GetTotalFightTimes()
    local delta = _G.ConfigManager.discrete_cfg[127118][1][1] - times
    self.go_table.toggle_auto.isOn =
        delta <= 0 and _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.ArenaGlobalAutoFight) == 1
    if AppSetting.IsXzns then
        local groupIng,isCheck = ArenaGlobalModel:GetInstance():CheckIsSettle()
        if ArenaGlobalModel:GetInstance():CheckHasApply() and isCheck == false then
            ArenaGlobalModel:GetInstance():GetRankData(1, 1, _G.handler(self, self.UpdateTop3))
        end
    else
        self:LoadEffect()
        ArenaGlobalModel:GetInstance():GetRankData(1, 1, _G.handler(self, self.UpdateTop3))
    end
end

function ArenaGlobalBattlePanel:RefreshUI()
    self:InitView()
end

function ArenaGlobalBattlePanel:UpdateEmemy()
    self.go_table.obj_enemys:SetActiveE(1)
    self.enemyInfo = ArenaGlobalModel:GetInstance():GetEnemyInfo()
    for i = 1, 5 do
        self:ShowEnemy(i)
    end
end

function ArenaGlobalBattlePanel:UpdateScore()
    local showtxt = _G.GetLangPackValue(90033404013, _G.string.AddColor(ArenaGlobalModel:GetInstance():GetScore(), "EEC398"))
    if AppSetting.IsXzns then
        showtxt = _G.GetLangPackValue(90033404013, ArenaGlobalModel:GetInstance():GetScore())
    end
    self.go_table.aortext_myScore.text = showtxt
end

function ArenaGlobalBattlePanel:UpdatePower()
    self.go_table.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(ArenaGlobalModel:GetInstance():CalTeamPower())
end

function ArenaGlobalBattlePanel:UpdateFreeTimes()
    local max = _G.ConfigManager.discrete_cfg[127106][1][2]
    local cur = ArenaGlobalModel:GetInstance():GetFreeFightTimes()
    self.go_table.aortext_freeTimes.text = _G.GetLangPackValue(90033404040) .. cur .. "/" .. max
end

function ArenaGlobalBattlePanel:UpdateConsumeNum()
    local times = ArenaGlobalModel:GetInstance():GetRefreshTimes()
    if times == 0 then
        times = 1
    end
    local index = _G.Mathf.Min(times, #self.consumeCfg)
    local icon = _G.StorageManager:GetInstance():GetItemIcon(self.consumeCfg[index][1])
    self.go_table.aorrawimage_consumeIcon:LoadImage(icon)
    self.go_table.aortext_consumeNum.text = "x" .. self.consumeCfg[index][2]
end

function ArenaGlobalBattlePanel:UpdateRank()
    local danCfg = ArenaGlobalModel:GetInstance():GetCurDanCfg()
    local layer = danCfg.layer
    if self.rankData.rank_num == 0 then
        self.go_table.aortext_myRank.text = _G.GetLangPackValue(90022900040)
        if not ArenaGlobalModel:GetInstance():CheckMinFightTimes() then
            self.go_table.aortext_rankState.text = ""
            return
        end
        if layer[2][1] == 10000 then                                                --无人降级
            self.go_table.aortext_rankState.text = _G.GetLangPackValue(90033404028) --保级
        else
            self.go_table.aortext_rankState.text = _G.GetLangPackValue(90033404029) --降级
        end
    else
        local showtxt = _G.string.AddColor(self.rankData.rank_num, "EEC398")
        if AppSetting.IsXzns then
            showtxt = self.rankData.rank_num
        end

        self.go_table.aortext_myRank.text = _G.GetLangPackValue(90033404011, showtxt)
        if not ArenaGlobalModel:GetInstance():CheckMinFightTimes() then
            self.go_table.aortext_rankState.text = ""
            return
        end
        local limit = self.rankData.r_num * layer[1][1] // 10000
        limit = _G.Mathf.Max(limit, layer[1][2])
        if self.rankData.rank_num <= limit or self.rankData.r_num == 1 or self.rankData.r_num <= layer[1][2] then
            if layer[1][1] == 0 then                                                    --无人晋级
                self.go_table.aortext_rankState.text = _G.GetLangPackValue(90033404028) --保级
            else
                self.go_table.aortext_rankState.text = _G.GetLangPackValue(90033404027) --晋级
            end
        else
            limit = self.rankData.r_num * layer[2][1] // 10000
            limit = _G.Mathf.Max(limit, self.rankData.r_num - layer[2][2] + 1)
            if self.rankData.rank_num >= limit and layer[2][1] < 10000 then
                self.go_table.aortext_rankState.text = _G.GetLangPackValue(90033404029) --降级
            else
                self.go_table.aortext_rankState.text = _G.GetLangPackValue(90033404028) --保级
            end
        end

        local canskip = ArenaGlobalModel:GetInstance():CheckCanSkip(
            ArenaGlobalModel:GetInstance().dan, self.rankData.rank_num, ArenaGlobalModel:GetInstance():GetScore())
        if canskip then
            self.go_table.aortext_rankState.text = _G.GetLangPackValue(90033404125) --越级
        end
    end
    local today = _G.TimeUtil.GetDayBegin(_G.TimeUtil.GetServerUnixTime())
    local saveTb = { time = today, rank = self.rankData.rank_num }
    _G.PlayerPrefsManager.SetTable(_G.PlayerPrefsKey.ArenaGlobalLastRank, saveTb)
end

function ArenaGlobalBattlePanel:ShowEnemy(index)
    ---@type _obj_Battle._obj_enemy1_GoTable
    local tb = self.enemys[index]
    local data = self.enemyInfo[index]
    if data == nil then
        tb.gameObject:SetActiveE(0)
        return
    end
    tb.gameObject:SetActiveE(1)
    -- _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data, 0.5, true, true, false)
    tb.aortext_name.text = data.name
    tb.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(data.power)
    tb.aortext_winScore.text = _G.GetLangPackValue(90033404039, self.leagueCfg.vic_scores[index][1])
    if data.win_count >= 5 then
        tb.aorimage_overkill:SetActiveE(1)
        tb.aortext_overkill.text = data.win_count
    else
        tb.aorimage_overkill:SetActiveE(0)
    end
    tb.trans_role:ClearChildren()
    local cfg = require "CardCommentManager":GetInstance():CardData(data.city_style_id, false)
    self:LoadRoleModel(tb, cfg,data,index)
    self:ShowRefreshEff(tb)
end

function ArenaGlobalBattlePanel:UpdateTop3(rankData)
    self.rankData = rankData
    self:CheckShowRankChange()
    self:UpdateRank()
    self:UpdatePeak()
    if AppSetting.IsXzns then

    else
        for i = 1, 3 do
            self:ShowTopRank(i)
        end
    end
end

function ArenaGlobalBattlePanel:UpdatePeak()
    local peakScore = ""
    if AppSetting.IsXzns then
        peakScore = ArenaGlobalModel:GetInstance():GetPeakScore()
    else
        peakScore = _G.string.AddColor(ArenaGlobalModel:GetInstance():GetPeakScore(), "EEC398")
    end
    if self.rankData == nil then
        self.go_table.aortext_serverArea.text = _G.GetLangPackValue(90033404069, peakScore)
        return
    end
    local danCfg = ArenaGlobalModel:GetInstance():GetCurDanCfg()
    local add = 0
    local rank = self.rankData.rank_num or 0
    for _, v in pairs(danCfg.points_rank) do
        if rank >= v[1] and rank <= v[2] then
            add = v[3]
            break
        end
    end
    if add == 0 then
        add = ""
    else
        if AppSetting.IsXzns then
            add = _G.string.format(" (+%s)", add)
        else
            add = _G.string.AddColor(_G.string.format(" (+%s)", add), "96CE51")
        end
    end
    self.go_table.aortext_serverArea.text = _G.GetLangPackValue(90033404069, peakScore .. add)
end

function ArenaGlobalBattlePanel:ShowTopRank(index)
    ---@type _obj_Battle._obj_info1_GoTable
    local tb = self.top3[index]
    local data = self.rankData.rank[index]
    tb.trans_role:ClearChildren()
    if data then
        tb.aorrawimage_norole:SetActiveE(0)
        tb.aortext_name.text = data.name
        local cfg = require "CardCommentManager":GetInstance():CardData(data.city_style_id, false)
        self:LoadRoleModel(tb, cfg,data,index)
        self:ShowTitle(tb, data.title)
    else
        tb.aorrawimage_norole:SetActiveE(1)
        tb.aortext_name.text = _G.GetLangPackValue(90000010159)
        self:ShowTitle(tb, nil)
    end
end

function ArenaGlobalBattlePanel:LoadRoleModel(tb, cfg,data,index)
    local scale = cfg.size2
    local pos = cfg.pos_portrait
    local path = _G.UIUtils.GetBattleSpine(cfg, _G.UseBattleSpine.RankView)
    if _G.UIUtils.IsUseBattleSpine(_G.UseBattleSpine.RankView) then
        scale = cfg.size4
        pos = { 0, 0, 0 }
    end
    if self.curLoadIngRole == nil then
        self.curLoadIngRole = {}
    end
    self.curLoadIngRole[index] = cfg
    _G.PoolsManager:GetInstance():Spawn(
        path,
        _G.ePoolType.Temporary,
        tb.trans_role,
        handlerbind(self,self.LoadCompBack,index,cfg,data)
    )
end

function ArenaGlobalBattlePanel:LoadCompBack(trans,path,index,cfg,data)
    local scale = cfg.size2
    local pos = cfg.pos_portrait
    local path = _G.UIUtils.GetBattleSpine(cfg, _G.UseBattleSpine.RankView)
    if _G.UIUtils.IsUseBattleSpine(_G.UseBattleSpine.RankView) then
        scale = cfg.size4
        pos = { 0, 0, 0 }
    end
    if trans == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("角色无法加载 path:" .. path .. "    CardInfoView LoadRoleScene")
        end
        return
    end
    if self.go_table == nil or self.curLoadIngRole[index] ~= cfg then
        _G.DestroyObject(trans)
        return
    end
    trans:SetLocalPosition(pos[1], pos[2], pos[3])
    trans:SetLocalScaleXYZ(scale)
    if not table.isEmptyOrNil(data.artifact_skin) then
        _G.UIUtils.LoadArtifacteffect(trans,nil,data.artifact_skin[1],data.artifact_skin[2])
    end
end

function ArenaGlobalBattlePanel:ShowTitle(tb, data)
    tb.obj_titleEffect:RemoveAllChildren()
    if data == nil or data.sid == 0 then
        tb.aorrawimage_title:SetActiveE(0)
        return
    end
    local titleScale = _G.ConfigManager.discrete_cfg[100111][1][1]
    local player_title = _G.ConfigManager.player_title_effect_cfg[data.sid]
    if player_title.type_title == 1 then
        tb.aorrawimage_title:LoadImage(player_title.title)
        tb.aorrawimage_title:SetActiveE(1)
        tb.aorrawimage_title:SetLocalScaleXYZ(0.29 * titleScale)
    elseif player_title.type_title == 2 then
        _G.UIUtils.LoadEffectTitleOrFrame(
            player_title.title,
            tb.obj_titleEffect,
            function(trans)
                if self.go_table == nil then
                    _G.DestroyObject(trans)
                    return
                end
                local parClip = trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                parClip.NeedCheck = true
                parClip.CheckCount = 10
                parClip.CheckOne = 3
                trans:SetLocalScaleXYZ(titleScale)
            end
        )
        tb.aorrawimage_title:SetActiveE(0)
    end
end

function ArenaGlobalBattlePanel:OnClickTop3(go, isOn, index)
    local data = self.rankData.rank[index]
    if data then
        _G.SystemSettingManager:GetInstance():OpenView(data.uid)
    end
end

function ArenaGlobalBattlePanel:OnClickEnemy(go, isOn, index)
    ---@type arena_global.i_enemy
    local data = self.enemyInfo[index]
    if data == nil then
        return
    end
    if _G.MainManager:GetInstance():IsFighting(true) then
        return
    end
    if ArenaGlobalModel:GetInstance():GetAutoBattle() then
        return
    end
    local hasTimes, isFree = ArenaGlobalModel:GetInstance():CheckFightProp()
    if not hasTimes then
        local activity =
            require("ActivitySynManager"):GetInstance():GetChildAcitivity(
                10014,
                self.activity:GetJumpType(self.activityID)
            )
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GiftPackGMCommonView.Name, activity, 2)
        return
    end
    --默认跳过，按钮作连战用
    -- if self.go_table.toggle_skip.isOn then
    -- ArenaGlobalModel:GetInstance():EnterFight(data, true)
    if self.go_table.toggle_auto.isOn then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaGlobalAutoBattleView.Name, index)
    else
        ArenaGlobalModel:GetInstance():Challenge(data, _G.handlerbind(self, self.PlayAni, data))
    end
end

---@param data arena_global.i_enemy
function ArenaGlobalBattlePanel:PlayAni(data)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaGlobalBattleAnimation.Name, data)
end

function ArenaGlobalBattlePanel:RefreshEnemy()
    ArenaGlobalModel:GetInstance():RefreshEnemy(
        function(msg)
            -- self:UpdateConsumeNum()
            self:UpdateEmemy()
        end
    )
end

function ArenaGlobalBattlePanel:LoadEffect()
    local effCfg
    for i = 1, 3 do
        effCfg =
            i == 1 and _G.ConfigManager.ui_effect_cfg.ef_jinsheng_advancedrole or
            _G.ConfigManager.ui_effect_cfg.ef_jinsheng_character
        _G.UIUtils.LoadEffectByCfg(
            effCfg,
            self.go_table["obj_eff" .. i],
            function(trans)
                if self:IsNil() then
                    _G.UIUtils.RemoveEffect(trans)
                    return
                end
            end
        )
    end
end

function ArenaGlobalBattlePanel:ShowRefreshEff(tb)
    if tb.eff == nil then
        tb.eff = true
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_jinsheng_refresh,
            tb.obj_eff,
            function(trans)
                if self:IsNil() then
                    _G.UIUtils.RemoveEffect(trans)
                    return
                end
                trans:SetLocalPosition(0, -20, 0)
                tb.eff = trans
            end
        )
    elseif tb.eff ~= true then
        tb.eff:SetActiveE(0)
        tb.eff:SetActiveE(1)
    end
end

function ArenaGlobalBattlePanel:OnBattleEnd()
    self:UpdateScore()
    self:UpdatePower()
    self:UpdateEmemy()
    self:UpdateFreeTimes()
    if self.rankData then
        self:UpdateRank()
        self:UpdatePeak()
    end
end

function ArenaGlobalBattlePanel:OnBeAttacked()
    self:UpdateScore()
    if self.rankData then
        self:UpdateRank()
    end
end

function ArenaGlobalBattlePanel:SetAutoBtn(isAuto)
    self.go_table.aorbtn_cancelAuto:SetActiveE(isAuto and 1 or 0)
end

---按钮点击事件在这里派发
function ArenaGlobalBattlePanel:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_task then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaGlobalTaskView.Name)
    elseif go == self.go_table.aorbtn_gift then
        local activity =
            require("ActivitySynManager"):GetInstance():GetChildAcitivity(
                10014,
                self.activity:GetJumpType(self.activityID)
            )
        ---@type GiftPackGMCommonView
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GiftPackGMCommonView.Name, activity, 2)
    elseif go == self.go_table.aorbtn_refresh then
        -- self:RefreshEnemy()
        local times = ArenaGlobalModel:GetInstance():GetRefreshTimes()
        if times == 0 then
            times = 1
        end
        local index = _G.Mathf.Min(times, #self.consumeCfg)
        local name = _G.StorageManager:GetInstance():GetItemName(self.consumeCfg[index][1])
        local num = self.consumeCfg[index][2]
        _G.PopWindowManager:GetInstance():ShowBtnWindowByToggle(
            1080208,
            _G.handler(self, self.RefreshEnemy),
            nil,
            nil,
            nil,
            num .. name
        )
    elseif go == self.go_table.aorbtn_jumpRank then
        self.parent.toggleItems["rank"].isOn = true
    elseif go == self.go_table.toggle_skip then
        if isOn then
            local times = ArenaGlobalModel:GetInstance():GetTotalFightTimes()
            local delta = _G.ConfigManager.discrete_cfg[127118][1][1] - times
            if delta > 0 then
                self.go_table.toggle_skip.isOn = false
                _G.PopWindowManager:GetInstance():ShowAllTips(1080207, nil, nil, nil, nil, nil, delta)
                return
            end
        end
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.ArenaGlobalOutSkip, isOn and 1 or 0)
    elseif go == self.go_table.toggle_auto then
        if isOn then
            local times = ArenaGlobalModel:GetInstance():GetTotalFightTimes()
            local delta = _G.ConfigManager.discrete_cfg[127118][1][1] - times
            if delta > 0 then
                self.go_table.toggle_auto.isOn = false
                _G.PopWindowManager:GetInstance():ShowAllTips(1080207, nil, nil, nil, nil, nil, delta)
                return
            end
        else
            ArenaGlobalModel:GetInstance():CancelAutoBattle()
        end
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.ArenaGlobalAutoFight, isOn and 1 or 0)
    elseif go == self.go_table.aorbtn_layArray then
        self.view:OnEmbattle("embattle",true)
    elseif go == self.go_table.aorbtn_battleMsg then
        self.view:OnReport("report",true)
    end
end

function ArenaGlobalBattlePanel:CheckShowRankChange()
    if self.showRankChange then
        return
    end
    self.showRankChange = true
    local saveTb = _G.PlayerPrefsManager.GetTable(_G.PlayerPrefsKey.ArenaGlobalLastRank)
    if _G.table.isEmptyOrNil(saveTb) then
        return
    end
    if self.rankData.rank_num == 0 or self.rankData.rank_num == saveTb.rank then
        return
    end
    local today = _G.TimeUtil.GetDayBegin(_G.TimeUtil.GetServerUnixTime())
    if today ~= saveTb.time then
        return
    end
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ArenaGlobalRankChangeView.Name,
        saveTb.rank,
        self.rankData.rank_num,
        self.rankData.r_num
    )
end

function ArenaGlobalBattlePanel:OnDestroy()
    self:RemoveAllListener()
end

return ArenaGlobalBattlePanel
