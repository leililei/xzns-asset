local ArenaGlobalModel = require("ArenaGlobalModel")

---@class ArenaGlobalPreparePanel : UIBaseView 英雄面板
---@field go_table ArenaGlobalView._obj_Prepare_GoTable
local ArenaGlobalPreparePanel = _G.BaseClass("ArenaGlobalPreparePanel", _G.UIBaseView)

function ArenaGlobalPreparePanel:__init(parent, obj, activityClass)
    self.parent = parent
    self.activity = activityClass
    self.typeClass = activityClass.typeClass
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.leagues = {
        _G.GetAutoGoTable(self.go_table.obj_league1),
        _G.GetAutoGoTable(self.go_table.obj_league2),
        _G.GetAutoGoTable(self.go_table.obj_league3),
        _G.GetAutoGoTable(self.go_table.obj_league4),
        _G.GetAutoGoTable(self.go_table.obj_league5)
    }
    self.bgList = {
        [_G.ArenaGlobalState.Prepare] = "ImagesH5/hArenaGlobal/ui_jsbl_bmjm_bg",
        [_G.ArenaGlobalState.Battle] = "ImagesH5/hArenaGlobal/ui_jsbl_bmjm_bg", -- 容错
        [_G.ArenaGlobalState.Settlement] = "ImagesH5/hArenaGlobal/ui_jsbl_jsjm_bg"
    }
end

function ArenaGlobalPreparePanel:OnCreate()
    self:InitView()
end

function ArenaGlobalPreparePanel:InitView()
    local hasApply = ArenaGlobalModel:GetInstance():CheckHasApply()
    -- local state = ArenaGlobalModel:GetInstance():GetState()
    -- local isSettle = ArenaGlobalModel:GetInstance():CheckIsSettle()
    -- self.go_table.aorbtn_signUp:SetActiveE((hasApply or isSettle or state == _G.ArenaGlobalState.Settlement) and 0 or 1)
    self.go_table.aorbtn_signUp:SetActiveE(0)
    self.go_table.aorbtn_embattle:SetActiveE(hasApply and 1 or 0)
    self.dan = ArenaGlobalModel:GetInstance():GetDan()
    for i = 1, #self.leagues do
        self:ShowLeague(i)
    end
    self.go_table.obj_redpointEmbattle:UpdateRedPointItemIDAndParam(self.typeClass:GetRedpointIDByIndex(4))
    self.go_table.obj_redpointTask:UpdateRedPointItemIDAndParam(self.typeClass:GetRedpointIDByIndex(5))
    self:UpdateView()
    self:LoadCurBuildEffect()
end

function ArenaGlobalPreparePanel:UpdateView()
    local state = ArenaGlobalModel:GetInstance():GetState()
    self.go_table.aorrawimage_bg:LoadImage(self.bgList[state])
end

function ArenaGlobalPreparePanel:ShowLeague(id)
    ---@type arena_global_league_cfg
    local cfg = _G.ConfigManager.arena_global_league_cfg[id]
    ---@type _obj_Prepare._obj_league1_GoTable
    local tb = self.leagues[id]
    tb.aortext_name.text = _G.GetLangPackValue(cfg.name)
    --tb.aorrawimage_icon:LoadImage(
    --    cfg.icon,
    --    function()
    --        if self:IsNil() then
    --            return
    --        end
    --        tb.aorrawimage_icon:SetNativeSize()
    --    end
    --)
    tb.obj_isCur:SetActiveE(id == self.dan and 1 or 0)
    tb.scrollloophorizontal_awards:InitItemData(
        #cfg.layer_rewards,
        _G.handlerbind(self, self.RefreshAwardItem, cfg.layer_rewards)
    )
end

function ArenaGlobalPreparePanel:UpdateLeague()
    local tb
    for i = 1, #self.leagues do
        tb = self.leagues[i]
        tb.obj_isCur:SetActiveE(i == self.dan and 1 or 0)
    end
    self:LoadCurBuildEffect()
end

function ArenaGlobalPreparePanel:RefreshAwardItem(index, obj, awards)
    index = index + 1
    local award = awards[index]
    local tb = _G.GetAutoGoTable(obj)
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        award,
        tb.obj_award,
        function(trans)
            trans:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
            trans:ShowEffectOrder(true)
        end
    )
end

function ArenaGlobalPreparePanel:LoadCurBuildEffect()
    local delta = 0.15
    if not self.curBuildEff then
        self.curBuildEff = true
        _G.DelayDo(
            delta * self.dan,
            function()
                if self:IsNil() then
                    return
                end
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.ef_jinsheng_currentrank,
                    self.leagues[self.dan].obj_eff,
                    function(trans)
                        if self:IsNil() then
                            _G.UIUtils.RemoveEffect(trans)
                            return
                        end
                        self.curBuildEff = trans
                        self.curBuildEff:SetParentE(self.leagues[self.dan].obj_eff)
                    end
                )
            end
        )
    elseif self.curBuildEff ~= true then
        self.curBuildEff:SetParentE(self.leagues[self.dan].obj_eff)
    end
    if not self.lineEff then
        self.lineEff = {}
    end
    for i = 1, 4 do
        if self.dan > i and not self.lineEff[i] then
            self.lineEff[i] = true
            local index = i
            _G.DelayDo(
                delta * i,
                function()
                    if self:IsNil() then
                        return
                    end
                    _G.UIUtils.LoadEffectByCfg(
                        _G.ConfigManager.ui_effect_cfg.ef_jinsheng_line,
                        self.go_table["obj_effLine" .. i],
                        function(trans)
                            if self:IsNil() then
                                _G.UIUtils.RemoveEffect(trans)
                                return
                            end
                            self.lineEff[index] = trans
                            self.lineEff[index]:SetActiveE(self.dan > index and 1 or 0)
                        end
                    )
                end
            )
        elseif self.lineEff[i] and self.lineEff[i] ~= true then
            self.lineEff[i]:SetActiveE(self.dan > i and 1 or 0)
        end
    end
end

---按钮点击事件在这里派发
function ArenaGlobalPreparePanel:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_embattle then
        -- _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaGlobalDefendGroupView.Name)
        local cfg = ArenaGlobalModel:GetInstance():GetCurDanCfg()
        ArenaGlobalModel:GetInstance():OpenDefence(cfg.team, 1)
    elseif go == self.go_table.aorbtn_task then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaGlobalTaskView.Name)
    end
end

function ArenaGlobalPreparePanel:OnDestroy()
end

return ArenaGlobalPreparePanel
