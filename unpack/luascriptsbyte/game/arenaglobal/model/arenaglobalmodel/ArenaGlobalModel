function ArenaGlobalModel:FinishTask(sids, call)
    local pbData = { sids = sids }
    ArenaGlobalNet:GetInstance():FinishTask(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            for _, v in pairs(msg.f_sid) do
                self.finishTaskList[v] = true
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            self:RefreshActivityRedPoint(5)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            if call then
                call()
            end
        end
    )
end

---获取所有可完成的任务
function ArenaGlobalModel:GetAllCanFinishTask()
    local taskIds = {}
    if self.taskList then
        local startTime = self:GetStartTime()
        local now = _G.TimeUtil.GetServerUnixTime()
        local day = _G.TimeUtil.GetIntervalDayBySix1(startTime, now) + 1
        for _, v in pairs(self.taskList) do
            if v.i_task.state == _G.TaskEnum.ETaskState.Submited and not self:CheckTaskIsFinish(v.i_task.sid) then
                if day >= v.Cfg.day then
                    _G.table.insert(taskIds, v.i_task.sid)
                end
            end
        end
    end
    return taskIds
end

function ArenaGlobalModel:GetNextAward()
    local tasks =
        _G.table.chooseToArray(
            self.taskList,
            function(i, data)
                return data.Cfg.condition[1][1] == 2 and #data.Cfg.prize > 0
            end
        )
    _G.table.sort(
        tasks,
        function(a, b)
            return a.Cfg.condition[1][2] < b.Cfg.condition[1][2]
        end
    )
    for _, v in pairs(tasks) do
        if self.totalTimes < v.Cfg.condition[1][2] then
            return v
        end
    end
    return tasks[#tasks]
end

---状态与时间能否挑战
function ArenaGlobalModel:CheckCanFight()
    if self:GetState() ~= _G.ArenaGlobalState.Battle then
        return false
    end
    if not self:CheckApplyAndGroup() then
        return false
    end
    local sec = _G.TimeUtil.GetSecondsOfDay()
    local isGroupIng,isBattleset = self:CheckIsSettle()
    if sec < self.fightStartSec or sec >= self.fightEndSec or isBattleset or isGroupIng then
        return false
    end
    return true
end

---@return boolean, boolean 是否可挑战，是否消耗免费次数
function ArenaGlobalModel:CheckFightProp()
    local isFree = self:CheckHasFreeTimes()
    local sid = _G.ConfigManager.discrete_cfg[127117][1][1]
    if not isFree then
        if self.refreshTodayTimes > 0 then
            if not _G.StorageManager:GetInstance():CheckItem(sid, 1) then
                return false, false
            end
        end
        return true, false
    end
    return true, true
end

function ArenaGlobalModel:Challenge(data, call)
    if not self:CheckCanFight() then
        _G.PopWindowManager:GetInstance():ShowAllTips(1080204)
        return
    end
    local hasTimes, isFree = self:CheckFightProp()
    if not hasTimes then
        return
    end
    local pbData = { uid = data.uid }
    ArenaGlobalNet:GetInstance():GetEnemyArray(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
            local team = msg.team or {}
            local enemy = {}
            for _, v in pairs(team) do
                enemy[v.index % 100] = v
            end
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.ArenaGlobalEmbattleView.Name,
                _G.handler(self, self.ExitEmbattle),
                _G.handlerbind(self, self.EnterFight, false, call),
                data,
                enemy
            )
        end
    )
end

---战斗，爽！
---@param uid number 对手uid
---@param skip number 1跳过2不跳过
function ArenaGlobalModel:EnterFight(data, skip, call)
    if not self:CheckCanFight() then
        _G.PopWindowManager:GetInstance():ShowAllTips(1080204)
        self:ExitEmbattle()
        _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
        if self:GetAutoBattle() then
            self:CancelAutoBattle()
        end
        return
    end
    local hasTimes, isFree = self:CheckFightProp()
    if not hasTimes then
        if self:GetAutoBattle() then
            self:CancelAutoBattle()
        end
        return
    end
    ---c_type 1免费次数2道具 skip and 1 or 2 改为故定发2，有fight_arg
    local pbData = { uid = data.uid, f_type = 2, c_type = isFree and 1 or 2 }
    if not skip then --正常布阵战斗
        local embattleItem = require("EmbattleController"):GetInstance():GetCurEmbattleItem()
        skip = embattleItem and embattleItem:IsSkipBattle()
        skip = true --默认跳过
    else            --外部跳过
        local cls = _G.EmbattleControllerItemType.ArenaGlobalAttack
        local danCfg = self:GetCurDanCfg()
        local num = danCfg.team
        local tb = {}
        for i = 1, num do
            tb[i] = i
        end
        local embattleItem = require(cls).New(tb, _G.EmbattleSaveType.server, false)
        if not embattleItem:CheckBattle() then
            _G.PopWindowManager:GetInstance():ShowAllTips(140107)
            return
        else
            embattleItem:SaveEmbattle(
                function()
                    self.bufferData = {
                        data = data,
                        skip = skip,
                        isFree = isFree,
                    }
                    ArenaGlobalNet:GetInstance():Fight(pbData, _G.handlerbind(self, self.BattleInitiated, data, skip, isFree))
                    if call then
                        call()
                    end
                end
            )
            return
        end
    end
    _G.BattleManager:GetInstance():SetInBattle(true)
    self.isRequestFighting = true
    self.bufferData = {
        data = data,
        skip = skip,
        isFree = isFree
    }
    ArenaGlobalNet:GetInstance():Fight(pbData, _G.handlerbind(self, self.BattleInitiated, data, skip, isFree))
    if call then
        call()
    end
end

--战斗发起回调
function ArenaGlobalModel:BattleInitiated(msg, data, isSkip, isFree)
    if msg and msg.ack ~= 1 then
        self:ExitEmbattle()
        _G.BattleManager:GetInstance():SetInBattle(false)
        if self:GetAutoBattle() then
            self:CancelAutoBattle()
        end
        return
    end
    self.timerBattle = _G.DelayDo(60,function()
        --强制请求战斗结果 针对没收到战斗推送的情况
        self:GetBattleResults()
    end)
end

function ArenaGlobalModel:GetBattleResults()
    if self.timerBattle then
        _G.coroutine.stopwaiting(self.timerBattle)
        self.timerBattle = nil
    end
    if self.bufferData == nil then
        return
    end
    ArenaGlobalNet:GetInstance():GetBattleResults(nil, _G.handlerbind(self, self.FightCall, self.bufferData.data, self.bufferData.skip, self.bufferData.isFree))
end

---@param msg arena_global.s2c_global_fight 战斗完成回调
function ArenaGlobalModel:FightCall(msg, data, isSkip, isFree)
    if self.timerBattle then
        _G.coroutine.stopwaiting(self.timerBattle)
        self.timerBattle = nil
    end
    self.isRequestFighting = false
    if msg.ack ~= 1 then
        self:ExitEmbattle()
        _G.BattleManager:GetInstance():SetInBattle(false)
        if self:GetAutoBattle() then
            self:CancelAutoBattle()
        end
        return
    end
    self.hasNewReport = true
    if msg.enemy then
        self.enemyInfo = msg.enemy
    elseif not msg.report.a_win then
        for _, v in pairs(self.enemyInfo) do
            if data.uid == v.uid then
                v.win_count = v.win_count + 1
                break
            end
        end
    end
    self.score = self.score + msg.report.a_score
    self.totalTimes = self.totalTimes + 1
    self.todayTimes = self.todayTimes + 1
    self:UpdateRankData()
    if isFree then
        self.fightTimes = self.fightTimes - 1
        self:RefreshActivityRedPoint(3)
    else
        local sid = _G.ConfigManager.discrete_cfg[127117][1][1]
        _G.StorageManager:GetInstance():ConsumeItem(sid, nil, 1)
    end
    for _, v in pairs(self.taskList) do
        if v.i_task.state ~= _G.TaskEnum.ETaskState.Completed then
            v.i_task.target[1] = v.i_task.target[1] + 1
            v:UpdataData()
        end
    end
    self.fightMsg = msg
    self.fightIndex = 1
    if self:GetAutoBattle() then
        local rankNum = self.rankData and self.rankData[1].rank_num or 0
        self.autoFightNum = self.autoFightNum - 1
        local time = _G.TimeUtil.GetDayBegin(_G.TimeUtil.GetServerUnixTime())
        if self.autoFightNum <= 0 then
            self:CancelAutoBattle()
        elseif rankNum == 1 and _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.ArenaGlobalAutoRankOne) ~= time then
            _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.ArenaGlobalAutoRankOne, time)
            self:CancelAutoBattle()
            _G.PopWindowManager:GetInstance():ShowAllTips(1080209)
        elseif self.stopCon.type == 3 then
            if rankNum <= self.stopCon.limit then
                self:CancelAutoBattle()
            end
        elseif self.stopCon.type == 2 then
            if not msg.report.a_win then
                self.stopCon.limit = self.stopCon.limit - 1
                if self.stopCon.limit <= 0 then
                    self:CancelAutoBattle()
                end
            end
        end
    end
    self:RefreshActivityRedPoint(5)
    if isSkip or not msg.fight_arg then
        self:ExitEmbattle()
        if _G.AppSetting.DEBUG and (not isSkip and not msg.fight_arg) then
            _G.LogError("【容错打印】没有战报，对方空阵容或战斗服异常，直接显示结算")
        end
        self.fightCount = 0
        local settleData = { MvpCardSid = self:GetFakeMvpSid(), re_uid = msg.report_uid }
        self.curBattleController = _G.require(_G.BattleControllerType.ArenaGlobal).New()
        self.curBattleController.FightResult = msg
        _G.BattleManager:GetInstance():SetBattleController(self.curBattleController)
        if msg.fight_arg then
            _G.BattleManager:GetInstance():SetArgData(msg.fight_arg)
        end
        self.curBattleController:StartSettlement(
            _G.SettlementModel.SettlementType.ArenaGlobal,
            settleData,
            nil,
            msg.fight_arg,
            data
        )
    else
        self.fightCount = #msg.report.reports
        _G.BattleManager:GetInstance():SetArgData(msg.fight_arg)
        _G.BattleManager:GetInstance():EnterFight(_G.BattleControllerType.ArenaGlobal, msg.fight_arg, data, true)
    end
    _G.Events:GetInstance():Broadcast(_G.eArenaGlobal.ArenaGlobalFightEnd)
end

function ArenaGlobalModel:AutoBattleAll(fightIndex, fightNum, stopCon)
    self.autoFight = true
    self.autoFightIndex = fightIndex
    self.autoFightNum = fightNum
    self.stopCon = stopCon
    self.reqFightNum = 0
    _G.Events:GetInstance():Broadcast(_G.eArenaGlobal.ArenaGlobalSetAuto, true)
    self:AutoBattle()
end

function ArenaGlobalModel:AutoBattle()
    if not self:GetAutoBattle() then
        return
    end
    if self.autoFightNum <= 0 then
        return
    end
    local data = self.enemyInfo[self.autoFightIndex]
    if data == nil then
        data = self.enemyInfo[1]
        if _G.AppSetting.DEBUG then
            _G.LogError("当前自动选择的位置没有对手，已自动切换其他位置对手")
        end
    end
    if data == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("当前无可挑战对手, 已停止自动战斗")
        end
        self:CancelAutoBattle()
        return
    end
    self:EnterFight(data, true)
end

function ArenaGlobalModel:CancelAutoBattle()
    self.autoFight = false
    self.autoFightNum = 0
    _G.Events:GetInstance():Broadcast(_G.eArenaGlobal.ArenaGlobalSetAuto, false)
end

function ArenaGlobalModel:OnSettleFail()
    if self:GetAutoBattle() then
        if self.stopCon.type == 2 then
            self.stopCon.limit = self.stopCon.limit - 1
            if self.stopCon.limit <= 0 then
                self:CancelAutoBattle()
            end
        end
    end
end

