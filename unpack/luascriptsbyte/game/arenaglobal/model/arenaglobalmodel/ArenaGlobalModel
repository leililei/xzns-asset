function ArenaGlobalModel:CheckInEggAwrdStatus()
    local nowTime = _G.TimeUtil.GetServerUnixTime()
    if self.activity and self.EggEndTime and self.endTime < nowTime and self.EggEndTime > nowTime then
        return true
    end
    return false
end

---获取结算后全服奖励
function ArenaGlobalModel:GetEggAward(callback)
    require "ActivitySynNet":GetInstance():GetAward(
        self.activity:GetActivityID(),
        {},
        function(msg)
            if msg.ack == 1 then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                self.EggAwardFlag = true
                if callback then
                    callback()
                end
                self:RefreshActivityRedPoint(6)
            end
        end
    )
end

function ArenaGlobalModel:DelayToGetInfo()
    if not self.retryTimes then
        self.retryTimes = 0
    end
    self.retryTimes = self.retryTimes + 1
    if self.retryTimes > 5 then
        if _G.AppSetting.DEBUG then
            _G.LogError("晋升堡垒请求5次服务器仍未初始化完成,不再重新请求")
        end
        return
    end
    _G.DelayDo(30, _G.handler(self, self.GetInfo))
end

