---检测报名或分组状态（未报名或未分组无法刷新和战斗）
function ArenaGlobalModel:CheckApplyAndGroup()
    if not self:CheckHasApply() then
        if _G.AppSetting.DEBUG then
            _G.LogError("【非报错打印】晋升堡垒未报名")
        end
        return false
    end
    if self.danGroup == 0 then
        if _G.AppSetting.DEBUG then
            _G.LogError("【结算时间内请无视】未分组，无法刷新（联系服务器查明原因）")
        end
        return false
    end
    return true
end

---刷新对手信息(首次刷新无消耗)
function ArenaGlobalModel:RefreshEnemy(call)
    if not self:CheckApplyAndGroup() then
        if call then
            call()
        end
        return
    end
    local consume
    if self.refreshTodayTimes > 0 then
        consume = self:GetRefreshConsume()
        if not _G.StorageManager:GetInstance():CheckItemNew(consume[1], consume[2]) then
            if call then
                call()
            end
            return
        end
    end
    ArenaGlobalNet:GetInstance():RefreshEnemy(
        function(msg)
            if msg.ack ~= 1 then
                if call then
                    call(msg)
                end
                return
            end
            self.enemyInfo = msg.enemy
            if self.refreshTodayTimes > 0 and consume then
                _G.StorageManager:GetInstance():ConsumeItem(consume[1], nil, consume[2])
            end
            self.refreshTodayTimes = self.refreshTodayTimes + 1
            if call then
                call(msg)
            end
        end
    )
end

function ArenaGlobalModel:GetRefreshConsume()
    if self.refreshTodayTimes == 0 then
        return {}
    end
    local cfg = _G.ConfigManager.discrete_cfg[127108]
    return cfg[self.refreshTodayTimes] or cfg[#cfg]
end

