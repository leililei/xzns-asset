    local flag = true
    if self.defArray[num] then
        for i = 1, num do
            if self.defArray[num][i] and self.defArray[num][i].sits then
                for j, uid in pairs(self.defArray[num][i].sits) do
                    if uid > 0 then
                        flag = false
                        break
                    end
                end
            end
        end
    end
    return flag
end

function ArenaGlobalModel:CalTeamPower()
    local danCfg = self:GetCurDanCfg()
    local power = 0
    local level = 300
    local card, team, sits
    for i = 1, danCfg.team do
        team = self:GetAttackGarray(danCfg.id, i)
        if team then
            sits = team.sits
            for j = 1, #sits do
                if sits[j] > 0 then
                    card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, sits[j])
                    if card then
                        power = power + card:GetPowerByLevel(level)
                    end
                end
            end
        end
    end
    return power
end

