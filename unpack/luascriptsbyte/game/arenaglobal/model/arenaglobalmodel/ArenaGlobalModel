    local state = self:GetState()
    if state ~= _G.ArenaGlobalState.Battle then
        return false
    end
    -- local settle = _G.ConfigManager.discrete_cfg[127116]
    local sec = _G.TimeUtil.GetSecondsOfDay()
    if sec < self.fightStartSec or sec >= self.fightEndSec then
        return false
    end
    return true
end

