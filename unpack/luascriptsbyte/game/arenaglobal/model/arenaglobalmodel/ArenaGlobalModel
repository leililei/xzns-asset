function ArenaGlobalModel:GetFakeMvpSid()
    --local array = self:GetAttackGarray(self:GetCurDanCfg().team, 1)
    local array = self:GetAttackGarray(self.dan, 1)
    if not array then
        return
    end
    for _, uid in pairs(array.sits or {}) do
        if uid > 0 then
            local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
            if card then
                return card.sid
            end
        end
    end
end

function ArenaGlobalModel:CheckFightNext()
    if self.fightIndex >= self.fightCount then
        return false
    end
    return true
end

function ArenaGlobalModel:FightNext(data, call)
    local uid = self.fightMsg.report_uid
    local pbData = { log_uid = uid, r_index = self.fightIndex + 1 }
    ArenaGlobalNet:GetInstance():ReportFightArgs(
        pbData,
        function(msg)
            if call then
                call(msg)
            end
            if msg.ack ~= 1 then
                if _G.AppSetting.DEBUG then
                    _G.LogError("【容错打印】获取后续场次战报异常，直接显示结算")
                end
                return
            end
            self.fightIndex = self.fightIndex + 1
            _G.BattleManager:GetInstance():DestroyBattle()
            _G.BattleManager:GetInstance():SetArgData(msg.fight_arg)
            _G.BattleManager:GetInstance():EnterFight(_G.BattleControllerType.ArenaGlobal, msg.fight_arg, data)
        end
    )
end

