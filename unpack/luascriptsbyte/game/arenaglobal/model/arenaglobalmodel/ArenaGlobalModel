function ArenaGlobalModel:CheckRedPointEmbattle()
    local array, flag
    local isGroupIng,isBattleset = self:CheckIsSettle()
    if isBattleset or isGroupIng then
        return 0
    end
    local cfg = self:GetCurDanCfg()
    -- for t = 1, 5 do
    for i = 1, cfg.team do
        array = self:GetDefendGarray(cfg.id, i)
        if array == nil or array.sits == nil then
            return 1
        end
        flag = true
        for j = 1, #array.sits do
            if array.sits[j] > 0 then
                flag = false
            end
        end
        if flag then
            return 1
        end
    end
    -- end
    return 0
end

function ArenaGlobalModel:CheckRedPointTask()
    local isGroupIng,isBattleset = self:CheckIsSettle()
    if isGroupIng or isBattleset then
        return 0
    end
    return #self:GetAllCanFinishTask() > 0 and 1 or 0
