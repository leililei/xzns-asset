---@param type number 1段位分组2巅峰
function ArenaGlobalModel:GetRankData(type, page, call)
    page = page or 1
    if self.rankData[type] == nil then
        self:GetRank(type, page, call)
    else
        if call then
            call(self.rankData[type])
        end
    end
end

function ArenaGlobalModel:UpdateRankData()
    if not self.rankData[1] then
        return
    end
    local selfData
    local rank = self.rankData[1].rank
    if self.rankData[1].rank_num > 0 and #rank >= self.rankData[1].rank_num then
        selfData = _G.table.remove(rank, self.rankData[1].rank_num)
    else
        selfData = _G.PlayerModel:GetInstance():GetIRroleTable(true)
    end
    selfData.score = self.score
    local index = 1
    for i = 1, #rank do
        if self.score < rank[i].score then
            index = i + 1
        else
            break
        end
    end
    _G.table.insert(rank, index, selfData)
    self.rankData[1].rank_num = index
end

function ArenaGlobalModel:ClearRankData(type)
    if type == nil then
        self.rankData = {}
    else
        self.rankData[type] = nil
    end
end

---@return boolean, boolean 个人榜，巅峰榜
function ArenaGlobalModel:CheckCanRequestRank()
    local state = self:GetState()
    if state == _G.ArenaGlobalState.Prepare then
        return false, false
    end
    if state == _G.ArenaGlobalState.Settlement then
        return false, true
    end
    local gSettle, fSettle = self:CheckIsSettle(state)
    if gSettle then
        return false, false
    elseif fSettle then
        return false, true
    end
    return true, true
end

---获取晋级/降级线
function ArenaGlobalModel:GetRankLimit(rankNum)
    local danCfg = ArenaGlobalModel:GetInstance():GetCurDanCfg()
    local layer = danCfg.layer
    if rankNum == 0 then
        if layer[2][1] == 10000 then --无人降级
            return 0, 1, layer       --保级
        else
            return 0, 0, layer       --降级
        end
    else
        local limit1 = rankNum * layer[1][1] // 10000
        limit1 = _G.Mathf.Max(limit1, layer[1][2])
        local limit2 = rankNum * layer[2][1] // 10000
        limit2 = _G.Mathf.Max(limit2, rankNum - layer[2][2] + 1)
        return limit1, limit2, layer
    end
end

---获取段位状态
---@return number 1晋级2保级3降级
function ArenaGlobalModel:GetRankState(layer, limit1, limit2, rankNum)
    if rankNum == 0 then
        if layer[2][1] == 10000 then
            return 2
        else
            return 3
        end
    else
        if rankNum <= limit1 or rankNum == 1 or rankNum <= layer[1][2] then
            if layer[1][1] == 0 then --无人晋级
                return 2
            else
                return 1
            end
        else
            if rankNum >= limit2 and layer[2][1] < 10000 then
                return 3
            else
                return 2
            end
        end
    end
end

---是否在结算时间(服务器分组)
---@return boolean 服务器分组中，服务器战斗结算中, 结算结束的时间
function ArenaGlobalModel:CheckIsSettle(state)
    state = state or self:GetState()
    if state == _G.ArenaGlobalState.Prepare then
        return false, false, 0
    end
    local cfg = _G.ConfigManager.discrete_cfg[127116]
    local startT = cfg[1][1] * 3600 + cfg[1][2] * 60
    local endT = cfg[2][1] * 3600 + cfg[2][2] * 60
    local sec = _G.TimeUtil.GetSecondsOfDay()
    if sec >= startT and sec <= endT then
        return true, false, endT - sec
    elseif sec >= self.fightEndSec then
        return false, true, startT + 86400 - sec
    elseif sec < startT then
        return false, true, startT - sec
    end
    return false, false, 0
end

---@param msg arena_global.i_global_info
function ArenaGlobalModel:InitTaskData(msg)
    local taskIds = _G.ConfigManager.discrete_cfg[127101][1]
    self:ClearTask()
    self.taskList = {}
    self.finishTaskList = {}
    local day_col = msg.day_col or {}
    local taskCurr = {}
    for _, v in pairs(day_col) do
        taskCurr[v.type[1]] = v.value
        if v.type[1] == 2 then     --总挑战次数
            self.totalTimes = v.value
        elseif v.type[1] == 1 then --今日挑战次数
            self.todayTimes = v.value
        end
    end
    ---@type arena_global_task_cfg
    local taskCfg
    for _, v in pairs(taskIds) do
        taskCfg = _G.ConfigManager.arena_global_task_cfg[v]
        self.taskList[v] =
            ArenaGlobalTaskData.New(
                { sid = v, target = { taskCurr[taskCfg.condition[1][1]] or 0 }, state = _G.TaskEnum.ETaskState.Claimed },
                function()
                    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.StroePassMission
                        .id)
                end
            )
    end
    if msg.finish_task then
        local iTask
        for _, v in pairs(msg.finish_task) do
            iTask = { sid = v, state = _G.TaskEnum.ETaskState.Submited, target = { 0 } }
            self.taskList[v] = ArenaGlobalTaskData.New(iTask, nil)
            self.finishTaskList[v] = true
        end
    end
end

function ArenaGlobalModel:ClearTask()
    if self.taskList == nil then
        return
    end
    for _, v in pairs(self.taskList) do
        v:Dispose()
    end
    self.taskList = nil
    self.finishTaskList = nil
end

