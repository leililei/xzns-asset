---@param msg arena_global.s2c_arena_global_info
function ArenaGlobalModel:ParseData(msg, call)
    if msg.ack ~= 1 then
        self.super.ParseData(self)
        if call then
            call()
        end
        if msg.ack == 5301 then
            self:DelayToGetInfo()
        else
            if self.activity then
                self.activity:ChangeState(require("ActivitySynManager").State.Close)
            end
        end
        return
    end
    local eggTime = 0
    if self.activity then
        eggTime = self.activity.cfg.time.get_time
    end
    local pubInfo = msg.pub
    self.startTime = pubInfo.start_timer
    self.endTime = pubInfo.end_time - eggTime
    self.maxDan = pubInfo.max_dan or 0
    self.EggEndTime = msg.pub.end_time
    if pubInfo.end_time < _G.TimeUtil.GetServerUnixTime() then
        if self.activity then
            self.activity:ChangeState(require("ActivitySynManager").State.Close)
        end
        if call then
            call()
        end
        return
    end
    self.joinTime = pubInfo.join_time
    self.fightTime = pubInfo.fight_time

    local info = msg.global_info
    if info == nil then --活动在线同步，服务器尚未初始化完成
        self:DelayToGetInfo()
        if call then
            call()
        end
        return
    end
    self.EggAwardFlag = info.easter_egg
    self.retryTimes = 0
    self.dan = info.dan
    self.danGroup = info.dan_group
    self.score = info.score
    self.peakScore = info.rank_score
    self.refreshTodayTimes = info.re_num
    self.lastRefreshTime = info.re_time
    self.enemyInfo = info.enemy
    self.fightTimes = info.fight_time or 0
    self.ungetDayAward = info.dan_day_award or {}
    self.lastDan = info.last_dan or 0
    self.lastRank = info.last_index or 0
    self.lastPointsAdd = info.last_add_score or 0

    self.atkArray = {}
    self.defArray = {}
    if info.a_array then
        for _, v in pairs(info.a_array) do
            self.atkArray[v.dan] = {}
            if v.garrays then
                for _, team in pairs(v.garrays) do
                    self.atkArray[v.dan][team.id % 100] = team
                end
            end
        end
    end
    if info.d_array then
        for _, v in pairs(info.d_array) do
            self.defArray[v.dan] = {}
            if v.garrays then
                for _, team in pairs(v.garrays) do
                    self.defArray[v.dan][team.id % 100] = team
                end
            end
        end
    end
    self.totalTimes = 0
    self.todayTimes = 0
    self:InitTaskData(msg.global_info)

    if _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.ArenaGlobalFace) ~= self.startTime and not self.hasAddFace and not self:CheckInEggAwrdStatus() then
        self.hasAddFace = true
        local MainOpenViewFunItem = {}
        MainOpenViewFunItem.OpenViewFun = function()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaGlobalFaceView.Name)
        end
        _G.MainManager:GetInstance():AddMainFunQueue(MainOpenViewFunItem, _G.MainViewShowOrder.ArenaGlobal)
    end

    if call then
        call()
    end
    _G.Events:GetInstance():Broadcast(_G.eArenaGlobal.ArenaGlobalInfo)
    local gSettle, fSettle, time = self:CheckIsSettle()
    if (gSettle or fSettle) and time > 0 then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        self.timer = _G.TimerManager:GetInstance():GetTimer(time, self.OnGetInfo, self, true, false, true)
        self.timer:Start()
    end
    --在线新功能开放, redId带params时AddRedPointChild无法正常刷新父节点, 此处手动刷新一下
    --require "RedPointManager":GetInstance():RefreshNodeByAllParams(self.activity:GetActivityTypeCls():GetRedpointIDByIndex(1))
end

---判断是不是能越级
---@param dan number 段位
function ArenaGlobalModel:GetSkipInfo(dan)
    if dan == 0 then
        return false, 0, 0, 0
    end
    local cfg = _G.ConfigManager.arena_global_league_cfg[dan]
    if nil == cfg.openskip or cfg.openskip == 0 then
        return false, 0, 0, 0
    end
    if self.maxDan >= cfg.openskip then
        local srank = 0
        local sscore = 0
        for i = 1, #cfg.skip do
            local key = cfg.skip[i][1]
            local v1 = cfg.skip[i][2]
            local v2 = cfg.skip[i][3]
            if key == 1 then
                srank = v2
            elseif key == 2 then
                sscore = v1
            end
        end
        local scfg = _G.ConfigManager.arena_global_league_cfg[cfg.openskip + 1]
        return true, srank, sscore, scfg.name
    end
    return false, 0, 0, 0
end

---判断是不是能越级
---@param dan number 段位
---@param rank number 排名
---@param score number 积分
function ArenaGlobalModel:CheckCanSkip(dan, rank, score)
    if dan == 0 then
        return false
    end
    local cfg = _G.ConfigManager.arena_global_league_cfg[dan]
    if nil == cfg.openskip or cfg.openskip == 0 then
        return false
    end
    if self.maxDan >= cfg.openskip then
        local skipnum = 0
        for i = 1, #cfg.skip do
            local key = cfg.skip[i][1]
            local v1 = cfg.skip[i][2]
            local v2 = cfg.skip[i][3]
            if key == 1 then
                if rank >= v1 and rank <= v2 then
                    skipnum = skipnum + 1
                end
            elseif key == 2 then
                if score >= v1 then
                    skipnum = skipnum + 1
                end
            end
        end
        if skipnum >= #cfg.skip then
            return true
        end
    end
    return false
end

