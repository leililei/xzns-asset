function ArenaGlobalModel:GetState()
    local now = _G.TimeUtil.GetServerUnixTime()
    if self.startTime == nil then
        return _G.ArenaGlobalState.Settlement
    end
    local limit = self.startTime + self.joinTime
    if now < limit then
        return _G.ArenaGlobalState.Prepare, limit - now
    end
    limit = limit + self.fightTime
    if now < limit then
        return _G.ArenaGlobalState.Battle, limit - now
    end
    return _G.ArenaGlobalState.Settlement, self.endTime - now
end

function ArenaGlobalModel:GetBattleDay()
    local now = _G.TimeUtil.GetServerUnixTime()
    local limit = self.startTime + self.joinTime
    if now < limit then
        return 1
    end
    limit = limit + self.fightTime
    if now < limit then
        local left = limit - now
        return TimeUtil.TranslateSecond(left).day
    end
    return 1
end

