        return self.atkArray[num]
    end
    return self.atkArray[num] and self.atkArray[num][index] or nil
end

function ArenaGlobalModel:GetDefendGarray(num, index)
    if index == nil then
        return self.defArray[num]
    end
    return self.defArray[num] and self.defArray[num][index] or nil
end

function ArenaGlobalModel:CheckAttackEmpty(num)
    local flag = true
    if self.atkArray[num] then
        for i = 1, num do
            if self.atkArray[num][i] and self.atkArray[num][i].sits then
                for j, uid in pairs(self.atkArray[num][i].sits) do
                    if uid > 0 then
                        flag = false
                        break
                    end
                end
            end
        end
    end
    return flag
end

