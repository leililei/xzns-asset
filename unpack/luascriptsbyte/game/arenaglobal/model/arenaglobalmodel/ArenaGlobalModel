---@param msg arena_global.p2c_def_fight
function ArenaGlobalModel:SetHasNewReport(msg)
    if msg then
        self.score = msg.n_score
        self.hasNewReport = true
        self:UpdateRankData()
        if msg.del_score > 0 then
            local time = _G.TimeUtil.GetDayBegin(_G.TimeUtil.GetServerUnixTime())
            _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.ArenaGlobalDefence, time)
            _G.Events:GetInstance():Broadcast(_G.eArenaGlobal.ArenaGlobalScoreChange)
        end
    else
        self.hasNewReport = false
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.ArenaGlobalDefence, 0)
    end
    self:RefreshActivityRedPoint(2)
end

