local ArenaGlobalModel = require("ArenaGlobalModel")
local ActivitySynManager = require "ActivitySynManager"

local base = require "ActivitySynTypeBase"
---@class ArenaGlobalSynModel : ActivitySynTypeBase	中文描述
local ArenaGlobalSynModel = _G.BaseClass("ArenaGlobalSynModel", base)

function ArenaGlobalSynModel:OnHandleGMData(msg)
    self:ParseData(msg)
end

---@param msg activity.i_activity_self_info
function ArenaGlobalSynModel:ParseData(msg)
    ArenaGlobalModel:GetInstance():SetActivity(self.curActivityClass, self.curActivityClass.activityID)
    local endTime = self.curActivityClass.cfg.time.start_time + self.curActivityClass.cfg.time.run_time + self.curActivityClass.cfg.time.get_time
    ---如果即将超时去拿去数据，就直接关闭
    if _G.TimeUtil.GetServerUnixTime() > endTime - 2 then
        self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
        base.ParseData(self)
    else
        ArenaGlobalModel:GetInstance():GetInfo(
            function()
                base.ParseData(self)
            end
        )
    end
end

---进入活动主体
function ArenaGlobalSynModel:OnEnterActivity()
    if ArenaGlobalModel:GetInstance():CheckInEggAwrdStatus() then
        ArenaGlobalModel:GetInstance():GetRankData(2, 1,
            function(rankData)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaGlobalChampionView.Name, rankData)
            end
        )
        return
    end
    if ArenaGlobalModel:GetInstance():GetStartTime() == nil then
        _G.PopWindowManager:GetInstance():ShowAllTips(1080205)
        return
    end
    if ArenaGlobalModel:GetInstance().retryTimes > 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(1080205)
        return
    end
    if ArenaGlobalModel:GetInstance():CheckIsSettle() then
        _G.PopWindowManager:GetInstance():ShowAllTips(1080203)
        return
    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaGlobalView.Name, self.curActivityClass)
end

function ArenaGlobalSynModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.ArenaGlobalView.Name
end

---绑定子活动
function ArenaGlobalSynModel:GetOtherActivityRedPointIds()
    return { 10014 }
end

function ArenaGlobalSynModel:OnEmbattleOpened(name)
    if name ~= _G.ConfigManager.ui_cfg.EmbattleView.Name then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleOpened, self)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ArenaGlobalView.Name)
end

---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function ArenaGlobalSynModel:InitRedPointTree()
    --挑战次数, 防守失败，首次达到段位x
    self.checkRedPointFunc = {
        self.CheckRedPointEmpty,
        self.CheckRedPointReport,   --2
        self.CheckRedPointFight,    --3
        self.CheckRedPointEmbattle, --4
        self.CheckRedPointTask,     --5
        self.CheckRedPointEggAward  --6
    }
    self.redpointTree = { { 2, 3, 4, 5, 6 }, false, { 4, 5 }, false, false, false }
end

function ArenaGlobalSynModel:CheckRedPointEmpty()
    return 0
end

function ArenaGlobalSynModel:CheckRedPointFight()
    return ArenaGlobalModel:GetInstance():CheckRedPointFight()
end

function ArenaGlobalSynModel:CheckRedPointReport()
    local time = _G.TimeUtil.GetDayBegin(_G.TimeUtil.GetServerUnixTime())
    return _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.ArenaGlobalDefence) == time and 1 or 0
end

function ArenaGlobalSynModel:CheckRedPointTask()
    return ArenaGlobalModel:GetInstance():CheckRedPointTask()
end

function ArenaGlobalSynModel:CheckRedPointEmbattle()
    if ArenaGlobalModel:GetInstance():CheckInEggAwrdStatus() then
        return 0
    end
    return ArenaGlobalModel:GetInstance():CheckRedPointEmbattle()
end

function ArenaGlobalSynModel:CheckRedPointEggAward()
    if ArenaGlobalModel:GetInstance():CheckInEggAwrdStatus() then
        if not ArenaGlobalModel:GetInstance().EggAwardFlag then
            return 1
        end
    end
    return 0
end

---刷新红点
function ArenaGlobalSynModel:RefreshRedPoint(param)
    param = param or 1
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(param))
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function ArenaGlobalSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---销毁对象时,析构函数
function ArenaGlobalSynModel:Dispose()
end

return ArenaGlobalSynModel
