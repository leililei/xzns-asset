local ActivityDispatchModel = require("ActivityDispatchModel")
---@class ActivityDispatchBattleAnimation : UIBaseView    中文描述
---@field public go_table ActivityDispatchBattleAnimation_GoTable GoTable
local ActivityDispatchBattleAnimation = _G.BaseClass("ActivityDispatchBattleAnimation", _G.UIBaseView)

---构造函数
---@protected
function ActivityDispatchBattleAnimation:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eActivityDispatch.FightAllEnd, self.SetEnd)
end

---界面的入口函数
function ActivityDispatchBattleAnimation:OnCreate()
    if not self.timer then
        self.timer = _G.TimerManager:GetInstance():GetTimer(50, self.UpdateTimer, self, true, false, true)
        self.timer:Start()
    end
    self:InitView()
    self:LoadEffect()
end

function ActivityDispatchBattleAnimation:LoadEffect()
    if _G.AppSetting.IsXzns then
        return
    end
    local check = function(trans)
        if self:IsNil() then
            _G.DestroyObject(trans)
        end
    end
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_zhangezhengfeng_yijiantiaozhan, self.go_table
                                                                                                     .obj_effect, check)
end

function ActivityDispatchBattleAnimation:UpdateTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:Close()
end

---
---@protected
function ActivityDispatchBattleAnimation:InitView()
    local battleInfo = ActivityDispatchModel:GetInstance():GetBattleInfo()
    if self.battleInfo == nil or (self.battleInfo ~= nil and self.battleInfo.round ~= battleInfo.round) then
        self.battleInfo = battleInfo
        if _G.table.isEmptyOrNil(self.battleInfo) then
            self:Close()
            return
        end
        for i = 1, 3 do
            local data = self.battleInfo.enemy[i]
            if data then
                local cfg = require "CardCommentManager":GetInstance():CardData(data.role_info.city_style_id, false)
                self:LoadRoleModel(cfg, i, data)
            end
        end
    end
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.prf_Mulading_zg,
        self.go_table.obj_left,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
            --self.leftAnimator = trans:GetComponentInChildrenE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
            --self.leftAnimator.AnimationState:Complete("+", _G.handler(self, self.AnimationFinish))
        end
    )
end

---加载单个角色
---@param view table 视图
---@param rolepath string 模型路径
---@param posIndex number 摆放的位置
---@param data activity_dispatch.i_target_role 玩家信息
function ActivityDispatchBattleAnimation:LoadRoleModel(cfg, posIndex, data)
    if cfg then
        local path = _G.UIUtils.GetBattleSpine(cfg, _G.UseBattleSpine.RankView)
        _G.PoolsManager:GetInstance():Spawn(
            path,
            _G.ePoolType.Temporary,
            nil,
            function(trans)
                if trans == nil then
                    if _G.AppSetting.DEBUG then
                        _G.LogError("角色无法加载 path:" .. cfg.ModelPathHi .. "    CardInfoView LoadRoleScene")
                    end
                    return
                end
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                trans:SetParentE(self.go_table["obj_anemy_" .. posIndex])
                --trans:SetParentE(self.go_table.obj_right)
                trans:SetLocalPosition(0, 0, 0)
                trans:SetLocalScaleXYZ(1)
            end
        )
    end
end

---
---@protected
function ActivityDispatchBattleAnimation:SetEnd(msg)
    self.msg = msg
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:OpenResultView()
end

function ActivityDispatchBattleAnimation:AnimationFinish()
    if self.msg and self.tag == nil then
        self.tag = true
        self.leftAnimator.AnimationState:Complete("-", _G.handler(self, self.OpenResultView))
        if self.msg.winner ~= nil and self.msg.winner == true then
            self:OpenResultView()
        elseif self.msg.winner ~= nil and self.msg.winner == false then
            self.leftAnimator.AnimationState:SetAnimation(0, "zhange_lose", true);
            self.rightAnimator.AnimationState:Complete("+", _G.handler(self, self.Finish))
            self.rightAnimator.AnimationState:SetAnimation(0, "zhange_win", true);
        else
            self:Close()
        end
    end
end

function ActivityDispatchBattleAnimation:OpenResultView()
    local viewBattle = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ActivityDispatchBattleView
                                                                  .Name)

    if viewBattle ~= nil then
        ActivityDispatchModel:GetInstance():ReturnPanel()
    end
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ActivityDispatchAllBattleResultView.Name,
        function()
            -- ActivityDispatchModel:GetInstance():ReturnPanel()
        end,
        self.msg
    )
    self:Close()
end

function ActivityDispatchBattleAnimation:Finish()
    if self.num == nil then
        self.num = 0
    end
    self.num = self.num + 1
    if self.num >= 2 then
        self:OpenResultView()
    end
end

---界面的销毁函数
function ActivityDispatchBattleAnimation:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
function ActivityDispatchBattleAnimation:OnClickBtn(go)
end

return ActivityDispatchBattleAnimation
