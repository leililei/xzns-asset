local ActivityDispatchModel = require("ActivityDispatchModel")
---@class ActivityDispatchEmbattleNewView : UIBaseView    中文描述
---@field public go_table ActivityDispatchEmbattleNewView_GoTable GoTable
local ActivityDispatchEmbattleNewView = _G.BaseClass("ActivityDispatchEmbattleNewView", _G.UIBaseView)

function ActivityDispatchEmbattleNewView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ActivityDispatchEmbattleNewView:OnCreate(embattletype, itemType, exit, battle, isDefenceEmbattle, arrays)
    self.onExitCall = exit
    self.onBattleCall = battle
    self.isDefenceEmbattle = isDefenceEmbattle
    self.embattletype = embattletype

    self.itemType = itemType
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    require("EmbattleController"):GetInstance():OpenEmbattle(
        embattletype,
        _G.EmbattleSaveType.server,
        nil,
        itemType,
        _G.handler(self, self.OnExitCall),
        _G.handler(self, self.OnBattleCall),
        _G.ConfigManager.activity_pvp_cfg[101].battle_scene,
        arrays
    )
end

function ActivityDispatchEmbattleNewView:OnDestroy()
    self.onExitCall = nil
end

---监听界面打开
---@param name string 界面名称
function ActivityDispatchEmbattleNewView:OnEmbattleViewOpened(name)
    ActivityDispatchModel:GetInstance():OnEmbattleOpened(name)
end

function ActivityDispatchEmbattleNewView:OnBattleCall()
    self:Close()
    if self.onBattleCall then
        self.onBattleCall()
    end
end

function ActivityDispatchEmbattleNewView:OnExitCall()
    self:Close()
    if self.onExitCall then
        self.onExitCall()
    end
end

---按钮点击事件在这里派发
function ActivityDispatchEmbattleNewView:OnClickBtn(go)
    if go == self.go_table.aorbtn_copy then
        local id = self.isDefenceEmbattle == true and 1080012 or 1080013
        ---@type EmbattleModel
        local embattleModel = require("EmbattleModel"):GetInstance()
        local embattleIds = {}
        if not self.isDefenceEmbattle == true then
            embattleIds = { _G.EmbattleType.ActivityDispatchAttack1, _G.EmbattleType.ActivityDispatchAttack2, _G
                .EmbattleType.ActivityDispatchAttack3 }
        else
            embattleIds = { _G.EmbattleType.ActivityDispatchDefence1, _G.EmbattleType.ActivityDispatchDefence2, _G
                .EmbattleType.ActivityDispatchDefence3 }
        end
        local cardDataList = require("EmbattleController"):GetInstance():GetCurEmbattleItem()
        ---更新布阵阵容
        ---@param embattleId number 布阵id
        local function updateEmbattle(embattleId, data)
            embattleModel:SaveEmbattleDataNew(
                embattleId,
                function(respCode)

                end,
                _G.EmbattleSaveType.server,
                true,
                data
            )
        end

        --- 三套阵容都同步过去
        for i = 1, #embattleIds do
            local cardList = {}
            for j = 1, #cardDataList:GetEmbattleData(i) do
                table.insert(cardList, cardDataList:GetEmbattleData(i)[j].uid)
            end
            updateEmbattle(embattleIds[i], cardList)
        end

        _G.PopWindowManager:GetInstance():ShowAllTips(
            id,
            nil,
            function()
                local itemType = require(self.itemType)
                local types = self.embattletype
                local typesCopy
                if self.isDefenceEmbattle == true then
                    typesCopy = { _G.EmbattleType.ActivityDispatchAttack1, _G.EmbattleType.ActivityDispatchAttack2, _G
                        .EmbattleType.ActivityDispatchAttack3 }
                else
                    typesCopy = { _G.EmbattleType.ActivityDispatchDefence1, _G.EmbattleType.ActivityDispatchDefence2, _G
                        .EmbattleType.ActivityDispatchDefence3 }
                end
                local item = itemType.New(types, _G.EmbattleSaveType.server, nil,
                    _G.ConfigManager.activity_pvp_cfg[101].battle_scene)
                item:Copy(typesCopy)
                _G.PopWindowManager:GetInstance():ShowAllTips(1080014)
            end,
            nil
        )
    end
end

return ActivityDispatchEmbattleNewView
