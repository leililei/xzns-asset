local RankUtils = require("RankUtils")

---@class RewardPreviewView : UIBaseView 窗口 奖励预览通用界面
---@field private go_table RewardPreviewFullView_GoTable GoTable
---@field LoadPanelDict table<RewardPreviewView.BtnTag,_obj_btnItem_GoTable>
local RewardPreviewView = _G.BaseClass("RewardPreviewView", _G.UIBaseView)

----@class RewardPreviewView.BtnTag
RewardPreviewView.BtnTag = {
    WinLosReward = 1,
    IndividualReward = 2,
    AllianceReward = 3,
    ClanReward = 4
}


function RewardPreviewView:__init()

end

---@class RewardPreviewView.OpenData
---@field uiPath string 界面路径
---@field luaName string 界面类名
---@field tagName string 标签名

---@class RewardPreviewView.OpenBaseRankData
---@field uiPath string 界面路径
---@field luaName string 界面类名
---@field tagName string 标签名
---@field datas table
---@field myRank number
---@field myRrankValue number
---@field myRankValueStr number
---@field ItemLua string
---@field config system_rank_cfg|arena_rank_cfg
---@field configStartId number
---@field configEndId number
---@field isShowPlayRankNode number 是否显示玩家排行节点
---@field RankType RankUtils.RankType 排行榜类型

function RewardPreviewView:OnCreate(OpenDatas,selectTag,tipStr,resource)
    self:InitData(OpenDatas,selectTag,tipStr,resource)
    self:RefreshData()
    self:InitUI()
    --self:RefreshUI()
end

function RewardPreviewView:OnDestroy()
    self.LoadPanelDict = nil
end

---@param OpenDatas RewardPreviewView.OpenData[]
function RewardPreviewView:InitData(OpenDatas,selectTag,tipStr,resource)

    ---@type RewardPreviewView.OpenData[]|RewardPreviewView.OpenBaseRankData[]
    self.OpenDatas = OpenDatas
    self.resource = resource

    ---@type RewardPreviewView.BtnTag
    self.CurSelectTag = RewardPreviewView.BtnTag.WinLosReward

    ---@type table<RewardPreviewView.BtnTag,RewardPreviewBaseView>
    self.LoadPanelDict = {}

    ---@type table<RewardPreviewView.BtnTag,_obj_btnItem_GoTable>
    self.LoadBtnNodeDict = {}

    self.IsLoadComp = false
    self.AsLoadCount = 0
    self.IsInitComp_InitUI = false
    self.tipStr = tipStr or 90021000020

    self.tagBtnPath = "UIH5/ActivityDispatch/ActivityDispatchBonusPreview/Item/ActivityDispBtnItem"

    if selectTag then
        self.CurSelectTag = selectTag or self.CurSelectTag
    end
end

function RewardPreviewView:RefreshData()

end

function RewardPreviewView:InitUI()

    self.go_table = GetAutoGoTable(self.transform,handler(self,self.onlick))
    if self.go_table.aortext_bonusPreview then
        self.go_table.aortext_bonusPreview.text = GetLangPackValue(self.tipStr)
    end

    local parent = self.go_table.obj_btnNode

    local tagCount = #self.OpenDatas
    for i = 1, tagCount do
        self.AsLoadCount = self.AsLoadCount + 1
        _G.PoolsManager:GetInstance():Spawn(
            self.tagBtnPath,
            ePoolType.UIItem,
            parent,
            handlerbind(self,self.OnTagBtnLoadComp,i)
        )
    end

    local curPanel = self.OpenDatas[self.CurSelectTag].uiPath
    parent = self.go_table.obj_PersonalInterfacePanel
    if self.LoadPanelDict[self.CurSelectTag] == nil then
        self.AsLoadCount = self.AsLoadCount + 1
        _G.PoolsManager:GetInstance():Spawn(
            curPanel,
            ePoolType.UIItem,
            parent,
            function(obj)
                if self.go_table == nil then
                    DestroyObject(obj)
                    return
                end

                obj:SetActiveE(1)
                self.LoadPanelDict[self.CurSelectTag] = require(self.OpenDatas[self.CurSelectTag].luaName).New(obj)
                self.LoadPanelDict[self.CurSelectTag]:InitData(self.OpenDatas[self.CurSelectTag])
                self.AsLoadCount = self.AsLoadCount - 1
                if self.AsLoadCount == 0 and self.IsInitComp_InitUI then
                    self:RefreshUI()
                end
        end)
    end

    self.IsInitComp_InitUI = true

    local resources = self.resource
    if resources and #resources > 0 then
        self:AddComponent(
                self.go_table.obj_GoldInfo,
                require("ResourceCompont").New(self.go_table.obj_GoldInfo, resources)
        )
    end
    self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))

    --RankUtils.GetMyRank(self.OpenDatas[self.CurSelectTag].uiPath,)

end

function RewardPreviewView:OnTagBtnLoadComp(obj,_,i)
    if self.go_table == nil then
        DestroyObject(obj)
        return
    end

    obj:SetActiveE(1)
    self.LoadBtnNodeDict[i] = GetAutoGoTable(obj,handlerbind(self,self.SetTabId,i))
    self.LoadBtnNodeDict[i].aortext_nameN.text = GetLangPackValue(self.OpenDatas[i].tagName)
    self.LoadBtnNodeDict[i].aortext_nameS.text = GetLangPackValue(self.OpenDatas[i].tagName)
    self.AsLoadCount = self.AsLoadCount - 1
    if self.AsLoadCount == 0 and self.IsInitComp_InitUI then
        self:RefreshUI()
    end
end

function RewardPreviewView:RefershUIPanel(callbask)
    local curPanel = self.OpenDatas[self.CurSelectTag].uiPath
    local parent = self.go_table.obj_PersonalInterfacePanel
    if self.LoadPanelDict[self.CurSelectTag] == nil then
        _G.PoolsManager:GetInstance():Spawn(
            curPanel,
            ePoolType.UIItem,
            parent,
            function(obj)
                if self.go_table == nil then
                    DestroyObject(obj)
                    return
                end

                obj:SetActiveE(1)
                self.LoadPanelDict[self.CurSelectTag] = require(self.OpenDatas[self.CurSelectTag].luaName).New(obj)
                self.LoadPanelDict[self.CurSelectTag]:InitData(self.OpenDatas[self.CurSelectTag])
                if callbask then
                    callbask()
                end
            end)
    else
        if callbask then
            callbask()
        end
    end
end

function RewardPreviewView:SetTabId(item,_, id)
    if self.CurSelectTag == id then
        return
    end
    self.CurSelectTag = id
    self:RefershUIPanel(function()
        self:RefreshUI()
    end)
end

function RewardPreviewView:RefreshUI()
    self:RefreshTagBtn()

    for k,v in pairs(self.LoadPanelDict) do
        v.go_table.gameObject:SetActiveE(k == self.CurSelectTag and 1 or 0)
    end

    self.LoadPanelDict[self.CurSelectTag]:RefreshData()
    self.LoadPanelDict[self.CurSelectTag]:RefreshVIew()
end

function RewardPreviewView:RefreshTagBtn()
    for k,v in pairs(self.LoadBtnNodeDict) do
        v.obj_choose:SetActiveE(k == self.CurSelectTag and 1 or 0)
    end
end

function RewardPreviewView:onlick(go)
    if go == self.go_table.aorbtn_Close or go == self.go_table.aorbtn_Close1 then
        self:Close()
    end
end


---@return RewardPreviewView
return RewardPreviewView