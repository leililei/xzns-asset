local ActiveDisRewardItem = require("ActiveDisRewardItem")

---@class RewardPreviewBaseView 奖励预览界面基类
---@field go_table RewardPreviewBaseView_GoTable
local RewardPreviewBaseView = _G.BaseClass("RewardPreviewBaseView")

function RewardPreviewBaseView:__init(obj)
    self.go_table = GetAutoGoTable(obj,self.onLick)
end

function RewardPreviewBaseView:OnRefreshContent(listView2, index)
    local newIndex = index + 1
    local cfg = self.cfgs[newIndex]

    local rewardCount = #cfg.rewards
    local itemName = "$_obj_ActiveDisRewardItem1"
    if rewardCount > 5 and rewardCount < 10 then
        itemName = "$_obj_ActiveDisRewardItem2"
    elseif rewardCount > 10 then
        itemName = "$_obj_ActiveDisRewardItem3"
    end
    local item = listView2:NewListViewItem(itemName)
    ---@type ActiveDisRewardItem
    local itemLua = self.ItemLua.New(item, _G.handler(self, self.GetCall))
    itemLua:RefreshItem(cfg, newIndex)
    _G.GameUtil.ReBuildRTF(item)

    return item
end

---@param listview2 SuperScrollView.LoopListView2
function RewardPreviewBaseView:RefreshItem(index,obj)
    local newIndex = index + 1
    local cfg = self.cfgs[newIndex]
    local id = obj:GetInstanceIDE()
    local item = self.itemList[id]
    if not item then
        item = self.ItemLua.New(obj, _G.handler(self, self.GetCall))
        self.itemList[id] = item
    end
    item:RefreshItem(cfg, newIndex)
end

function RewardPreviewBaseView:GetCall(data)

end

---@param data RewardPreviewView.OpenData|RewardPreviewView.OpenBaseRankData
function RewardPreviewBaseView:InitData(data)
    self.data = data
    ---@type ActiveDisRewardItem[]
    self.itemList = {}
    self:InitLoopList()

    if self.data.ItemLua then
        ---@type ActiveDisRewardItem
        self.ItemLua = require(self.data.ItemLua)
    else
        self.ItemLua = require("ActiveDisRewardItem")
    end

    self:InitCfgData()
end

function RewardPreviewBaseView:InitLoopList()
    if self.go_table.looplist2_propT then
        self.go_table.looplist2_propT:InitListView(0, _G.handler(self, self.OnRefreshContent))
    end
end

function RewardPreviewBaseView:InitCfgData()
    ---@type system_rank_cfg[]|arena_rank_cfg[]
    self.cfgs = {}

    if self.data.config then
        local cfg = self.data.config
        for id, v in pairs(cfg) do
            if id >= self.data.configStartId and id <= self.data.configEndId then
                table.insert(self.cfgs, v)
            end
        end
    else
        local cfg = _G.ConfigManager.system_rank_cfg
        for id, v in pairs(cfg) do
            if id >= 1000001 and id <= 1000006 then
                --部落排行榜奖励
            elseif id >= 1000011 and id <= 1000017 then
                --联盟排名奖励
            elseif id >= 1000021 and id <= 1000027 then
                --个人排名奖励
                table.insert(self.cfgs, v)
            end
        end
    end

    table.sort(self.cfgs, function(a, b)
        return a.max_rank < b.max_rank
    end)
end

function RewardPreviewBaseView:RefreshData()

end

function RewardPreviewBaseView:RefreshVIew()
    if self.cfgs == nil then
        return
    end
    --self.go_table.scrollloopvectical_rankList:UpdateCount(#self.cfgs)
    --self.go_table.scrollloopvectical_rankList:UpdateAllItem()

    self:RefreshLoopList()

    self:RefreshMyRankAndMilitaryMerit()
end

function RewardPreviewBaseView:RefreshLoopList()
    self.go_table.looplist2_propT:SetListItemCount(#self.cfgs)
end

function RewardPreviewBaseView:RefreshMyRankAndMilitaryMerit()
    if self.data == nil or self.data.myRank == nil then
        return
    end
    if self.go_table.aortext_myRank then
        self.go_table.aortext_myRank.text = GetLangPackValue(90029300023,self.data.myRank)
    end
    if self.go_table.aortext_Military then
        self.go_table.aortext_Military.text = GetLangPackValue(self.data.myRankValueStr,self.data.myRrankValue)
    end
end

function RewardPreviewBaseView:onLick(go)

end

---@param cfg arena_rank_cfg
function RewardPreviewBaseView:GetShowCfgRewardList(cfg)
    local awards = {}
    local type, sid
    if cfg == nil then
        return awards
    end
    for _, a in pairs(cfg.reward_daily) do
        _G.table.insert(awards, a)
    end
    if not _G.table.isEmptyOrNil(cfg.reward_appearance) then
        for _, eff in pairs(cfg.reward_appearance) do
            type = eff[1]
            sid = _G.tostring(eff[2])
            for k, item in pairs(_G.ConfigManager.item_cfg) do
                if item.UseType == type and item.UseParameter[1][1] == sid then
                    _G.table.insert(awards, {item.ID, 1})
                    break
                end
            end
        end
    end

    table.sort(awards,function(a,b)
        local aQuality = StorageManager:GetInstance():GetItemQuality(a[1])
        local bQuality = StorageManager:GetInstance():GetItemQuality(b[1])
        if aQuality and bQuality then
            if aQuality == bQuality then
                return a[1] > b[1]
            end
            return aQuality < bQuality
        else
            return a[1] > b[1]
        end
    end)
    return awards
end


---@return RewardPreviewBaseView
return RewardPreviewBaseView