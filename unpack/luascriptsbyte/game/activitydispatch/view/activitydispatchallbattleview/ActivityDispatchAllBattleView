local ActivityDispatchModel = require("ActivityDispatchModel")
---@class ActivityDispatchAllBattleView : UIBaseView    中文描述
---@field public go_table ActivityDispatchAllBattleView_GoTable GoTable
local ActivityDispatchAllBattleView = _G.BaseClass("ActivityDispatchAllBattleView", _G.UIBaseView)

---构造函数
---@protected
function ActivityDispatchAllBattleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ActivityDispatchAllBattleView:OnCreate()
    self.activity = ActivityDispatchModel:GetInstance():GetActivity()
    self.activityID = self.activity.activityID
    local index = ActivityDispatchModel:GetInstance():GetAllFightTag()
    if index == 0 then
        index = 1
    end
    self.Toggle = self.go_table["toggle_tag" .. index]:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle))
    self.Toggle.isOn = true
    self.chooseIndex = index
end

---界面的销毁函数
function ActivityDispatchAllBattleView:OnDestroy()
end

---按钮点击事件在这里派发
function ActivityDispatchAllBattleView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeView then
        self:Close()
    elseif go == self.go_table.toggle_tag1 then
        self.chooseIndex = 1
    elseif go == self.go_table.toggle_tag2 then
        self.chooseIndex = 2
    elseif go == self.go_table.toggle_tag3 then
        self.chooseIndex = 3
    elseif go == self.go_table.aorbtn_battle then
        ActivityDispatchModel:GetInstance():SetAllFightTag(self.chooseIndex)
        ActivityDispatchModel:GetInstance():BattleAll(
            self.chooseIndex,
            function(msg)
                if msg.ack == 1 then
                    self:Close()
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityDispatchBattleAnimation.Name)
                end
            end)
    end
end

return ActivityDispatchAllBattleView