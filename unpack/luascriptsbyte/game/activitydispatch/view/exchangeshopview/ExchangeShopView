function ExchangeShopView:RefreshUI()
    --self.aortext_Timer.text = TimeUtil.TimeToString(self.TypeCls.changeStateTime,1)
    if self.rewardList == nil then
        return
    end
    self:RefreshData()
    self.go_table.scrollloopvectical_ItemList:UpdateCount(#self.rewardList)
end

function ExchangeShopView:UpdateTimeShow(show, elapsed)
    if not show then
        self.RTS = self.RTS - elapsed
    end
    self.go_table.aortext_Timer.text = _G.TimeUtil.TimeToString(_G.Mathf.RoundToInt(self.RTS), 1)
    if self.RTS <= 0 then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        --self:Close()
    end
end

