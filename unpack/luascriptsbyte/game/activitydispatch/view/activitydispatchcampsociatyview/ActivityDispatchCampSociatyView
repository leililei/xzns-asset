---@class ActivityDispatchCampSociatyView : UIBaseView    中文描述
---@field public go_table ActivityDispatchCampSociatyView_GoTable GoTable
local ActivityDispatchCampSociatyView = _G.BaseClass("ActivityDispatchCampSociatyView", _G.Component)

local IconName = {
    [1] = "0ui_icon_diyi",
    [2] = "0ui_icon_dier",
    [3] = "0ui_icon_disan",
}

local Gradient = {
    [1] = { "FFCB28", "ffffff", "110802" },
    [2] = { "E930FF", "ffffff", "110802" },
    [3] = { "1F7296", "ffffff", "110802" },
}

---构造函数
---@protected
function ActivityDispatchCampSociatyView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ActivityDispatchCampSociatyView:OnCreate(data)
    self.SociatyItemList = {}
    self:Show(data)
end

function ActivityDispatchCampSociatyView:Show(data)
    self.ItemList = {}
    self.Ranks = data.guilds or {}
    _G.table.sort(self.Ranks, function(a, b)
        return a.power > b.power
    end)
    local len = #self.Ranks
    self.go_table.scrollloopvectical_memberList:InitItemData(len, _G.handler(self, self.OnRefreshLoopListItem))
    self:SetSelfInfo()
end

function ActivityDispatchCampSociatyView:SetSelfInfo()
    local data = require("SociatyModel"):GetInstance().SociatySelf
    self.go_table.obj_selfRank:SetActiveE(data ~= nil and 1 or 0)
    if data then
        local selfRankNum = 100000
        local selfScore = 0
        for k, v in ipairs(self.Ranks) do
            if v.uid == data.Uid then
                selfRankNum = k
                selfScore = v.number
                break
            end
        end
        if self.selfRank == nil then
            self.selfRank = _G.GetAutoGoTable(self.go_table.obj_selfRank)
        end
        self.selfRank.aorrawimage_Icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.Banner].portrait)
        self.selfRank.aortext_name.text = data.Name
        self.selfRank.aortext_num.text = selfScore == 0 and "" or selfScore
        if selfRankNum ~= 100000 then
            self.selfRank.aortext_rank.text = selfRankNum
        end
        self.selfRank.aortext_rank:SetActiveE(selfRankNum == 100000 and 0 or 1)
        self.selfRank.aortext_nil:SetActiveE(selfRankNum == 100000 and 1 or 0)
    end
end

function ActivityDispatchCampSociatyView:OnRefreshLoopListItem(i, item)
    if i < 0 then
        return
    end

    local eIndex = i + 1
    local id = item:GetInstanceIDE()
    ---@type SociatyRankView._obj_SociatyItem_GoTable
    local ctrl = self.SociatyItemList[id]
    if not ctrl then
        ctrl = _G.GetAutoGoTable(item)
        _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnItemClickBtn, ctrl))
        self.SociatyItemList[id] = ctrl
    end
    ctrl.index = eIndex
    local data = self.Ranks[eIndex]
    if data then
        ctrl.aorrawimage_Icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.banner].portrait)
        ctrl.aortext_name.text = data.name
        ctrl.aortext_president.text = data.president_name
        ctrl.aortext_level.text = _G.LangUtil.GetLangPackValue(9002010022, data.level)
        ctrl.aortext_num.text = data.number
        ctrl.aorimage_rankBg:SetActiveE(eIndex <= 3 and 1 or 0)
        ctrl.aortext_Rank:SetActiveE(eIndex <= 3 and 1 or 0)
        ctrl.obj_rankBg2:SetActiveE(eIndex <= 3 and 0 or 1)
        local power = data.power or 0
        ctrl.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(power)
        self:SetItemRankInfo(ctrl, eIndex)
    end
    return item
end

function ActivityDispatchCampSociatyView:SetItemRankInfo(go, index)
    local ctrl = go
    local eIndex = index
    if eIndex <= 3 then
        ctrl.aorimage_rankBg.SpriteName = IconName[eIndex]

        ctrl.aortext_Rank.text = eIndex
        local gradient = ctrl.aortext_Rank:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient))
        local c1 = _G.ColorTools.FormatColorByString(Gradient[eIndex][1])
        local c2 = _G.ColorTools.FormatColorByString(Gradient[eIndex][2])
        local color1 = _G.CS.UnityEngine.GradientColorKey()
        local color2 = _G.CS.UnityEngine.GradientColorKey()
        color1.color = c1
        color1.time = 1
        color2.color = c2
        color2.time = 0

        local alpha1 = _G.CS.UnityEngine.GradientAlphaKey()
        local alpha2 = _G.CS.UnityEngine.GradientAlphaKey()

        alpha1.alpha = 255
        alpha1.time = 1
        alpha2.alpha = 255
        alpha2.time = 0

        gradient:GetGradient():SetKeys({ color1, color2 }, { alpha1, alpha2 })
    elseif eIndex == 100000 then
        ctrl.aortext_rankNum.text = _G.ConfigManager.language_package_cfg[90022900040]
    else
        ctrl.aortext_rankNum.text = eIndex
    end
end

---界面的销毁函数
function ActivityDispatchCampSociatyView:OnDestroy()
end

---按钮点击事件在这里派发
function ActivityDispatchCampSociatyView:OnClickBtn(go)
end

return ActivityDispatchCampSociatyView