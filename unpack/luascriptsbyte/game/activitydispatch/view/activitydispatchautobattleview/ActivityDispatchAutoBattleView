local ActivityDispatchModel = require("ActivityDispatchModel")
---@class ActivityDispatchAutoBattleView : UIBaseView    中文描述
---@field public go_table ActivityDispatchAutoBattleView_GoTable GoTable
local ActivityDispatchAutoBattleView = _G.BaseClass("ActivityDispatchAutoBattleView", _G.UIBaseView)
local ticketId = 203031201
---构造函数
---@protected
function ActivityDispatchAutoBattleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ActivityDispatchAutoBattleView:OnCreate()
    self.activity = ActivityDispatchModel:GetInstance():GetActivity()
    self.activityID = self.activity.activityID
    local index = ActivityDispatchModel:GetInstance():GetAllFightTag()
    if index == 0 then
        index = 1
    end
    self.Toggle = self.go_table["toggle_tag" .. index]:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle))
    self.Toggle.isOn = true
    self.chooseIndex = index

    local indexChoose = ActivityDispatchModel:GetInstance():GetChooseBuffTag()
    if indexChoose == 0 then
        indexChoose = 1
    end
    self.ToggleChoose = self.go_table["toggle_buff" .. indexChoose]:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle))
    self.ToggleChoose.isOn = true
    self.chooseBuffIndex = indexChoose
    
    self.fightMaxNum = ActivityDispatchModel:GetInstance():GetFightNum() + _G.StorageManager:GetInstance():GetItemCountBySid(ticketId)
    self.propUseNum = self.fightMaxNum
    self.go_table.input_useNum.onEndEdit:AddListener(_G.handler(self, self.OnEndEditorDeclaration))
    self:SetPropUseInfo()
    self.toggles = {}
    self.buffs = ActivityDispatchModel:GetInstance():GetBuffInfo()
    for i = 1, 3 do
        self.toggles[i] = _G.GetAutoGoTable(self.go_table["toggle_buff" .. i])
        if i > 1 then
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                { _G.ResPropID.Diamond, self.buffs[i].value },
                self.toggles[i].obj_root,
                function(tran)
                    if self.go_table == nil then
                        _G.DestroyObject(tran)
                    end
                    tran.gameObject:SetLocalScaleXYZ(1)
                    tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                end
            )
        end
        local cfg = _G.ConfigManager.mementos_cfg[self.buffs[i].key]
        self.toggles[i].aortext_text.text = _G.GetLangPackValue(cfg.desc)
    end
end

function ActivityDispatchAutoBattleView:SetPropUseInfo()
    self.go_table.input_useNum.text = self.propUseNum
end

function ActivityDispatchAutoBattleView:OnEndEditorDeclaration(input)
    if not tonumber(input) then
        input = self.propUseNum
    end
    local num = tonumber(input)
    local max = self.fightMaxNum
    local min = 1
    self.propUseNum = _G.Mathf.Clamp(num, min, max)
    self:SetPropUseInfo()
end

---界面的销毁函数
function ActivityDispatchAutoBattleView:OnDestroy()
end

---按钮点击事件在这里派发
function ActivityDispatchAutoBattleView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeView then
        self:Close()
    elseif go == self.go_table.toggle_tag1 then
        self.chooseIndex = 1
    elseif go == self.go_table.toggle_tag2 then
        self.chooseIndex = 2
    elseif go == self.go_table.toggle_tag3 then
        self.chooseIndex = 3
    elseif go == self.go_table.toggle_buff1 then
        self.chooseBuffIndex = 1
    elseif go == self.go_table.toggle_buff2 then
        self.chooseBuffIndex = 2
    elseif go == self.go_table.toggle_buff3 then
        self.chooseBuffIndex = 3
    elseif go == self.go_table.aorbtn_propSub then
        if self.propUseNum > 1 then
            self.propUseNum = self.propUseNum - 1
            self:SetPropUseInfo()
        end
    elseif go == self.go_table.aorbtn_propAdd then
        if self.propUseNum < self.fightMaxNum then
            self.propUseNum = self.propUseNum + 1
            self:SetPropUseInfo()
        end
    elseif go == self.go_table.aorbtn_propMax then
        self.propUseNum = self.fightMaxNum
        self:SetPropUseInfo()
    elseif go == self.go_table.aorbtn_battle then
        local itemType = require(_G.EmbattleControllerItemType.ActivityDispatchAttack)
        local item = itemType.New({ _G.EmbattleType.ActivityDispatchAttack1, _G.EmbattleType.ActivityDispatchAttack2, _G.EmbattleType.ActivityDispatchAttack3 }, _G.EmbattleSaveType.server, nil, _G.ConfigManager.activity_pvp_cfg[101].battle_scene)
        local mpower = 0
        for i = 1, 3 do
            mpower = mpower + item:GetMyEmbattlePower(i, true)
        end
        if mpower == 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(8207)
        else
            ActivityDispatchModel:GetInstance():SetAllFightTag(self.chooseIndex)
            ActivityDispatchModel:GetInstance():AutoBattleAll(self.chooseBuffIndex, self.chooseIndex, self.propUseNum)
            self:Close()
        end
    elseif go == self.go_table.aorbtn_embattle then
        ActivityDispatchModel:GetInstance():OpenAttackEmbattle()
    end
end

return ActivityDispatchAutoBattleView