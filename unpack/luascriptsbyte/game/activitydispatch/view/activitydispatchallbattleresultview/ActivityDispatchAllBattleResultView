local ActivityDispatchModel = require("ActivityDispatchModel")
local CommonTipManager = require("CommonTipManager")
local SettlementBaseView = require "SettlementBaseView"
---@class ActivityDispatchAllBattleResultView : UIBaseView    中文描述
---@field public go_table ActivityDispatchAllBattleResultView_GoTable GoTable
local ActivityDispatchAllBattleResultView = _G.BaseClass("ActivityDispatchAllBattleResultView", SettlementBaseView)
local UIUtils = _G.UIUtils
local AutoNextTimeID = 100216           --自动推图时间
---界面的入口函数
function ActivityDispatchAllBattleResultView:OnCreateChild(data)
    self.result = data
    self:ShowData(data)
    self:OpenEmbattleView()
    self.go_table.obj_autobutton:SetActiveE((data.auto ~= nil and data.auto == true) and 1 or 0)
    if data.auto then
        local time = _G.ConfigManager.discrete_cfg[AutoNextTimeID][1][1]
        self.waitTime = time
        self.waitTimer = _G.TimerManager:GetInstance():GetTimer(1, self.ShowWaitTime, self)
        self.waitTimer:Start()
    end
end

function ActivityDispatchAllBattleResultView:OpenEmbattleView()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    local itemType = require(_G.EmbattleControllerItemType.ActivityDispatchAttack)
    local item = itemType.New({ _G.EmbattleType.ActivityDispatchAttack1, _G.EmbattleType.ActivityDispatchAttack2, _G.EmbattleType.ActivityDispatchAttack3 }, _G.EmbattleSaveType.server, nil, _G.ConfigManager.activity_pvp_cfg[101].battle_scene)
    local dataAll = item:GetAllEmbattleData()
    local cardList = {}
    for index = 1, 3 do
        local data = dataAll[index]
        for i = 1, #data do
            if data[i].uid > 0 then
                _G.table.insert(cardList, data[i].sid)
            end
        end
    end
    local chooseIndex = math.random(#cardList)
    local result = {}
    result.iSWin = self.result.winner
    result.statistics = false
    result.AwardData = _G.StorageManager:GetInstance():MergeAward(self.result)
    result.hidePlayerInfo = true
    result.MvpCardSid = cardList[chooseIndex]
    self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, function(id)
        if self.result.auto == true then
            if self.click == nil then
                if self.waitTimer ~= nil then
                    self.waitTimer:Stop()
                    self.waitTimer = nil
                end
                ActivityDispatchModel:GetInstance():AutoBattle()
                self:CloseCall(require("SettlementModel").FunctionEnum.None)
            end
        end
        if self.callback then
            self.callback(id)
            self.callback = nil
        end
    end, result)
end

---按钮点击事件在这里派发
function ActivityDispatchAllBattleResultView:OnClickBtn(go)
    self.click = true
    if self.waitTimer ~= nil then
        self.waitTimer:Stop()
        self.waitTimer = nil
    end
    if go == self.go_table.aorbtn_sure then
        ActivityDispatchModel:GetInstance():CancelAuto()
        self:CloseCall(require("SettlementModel").FunctionEnum.None)
    elseif go == self.go_table.aorbtn_ContinueFight then
        ActivityDispatchModel:GetInstance():AutoBattle()
        self:CloseCall(require("SettlementModel").FunctionEnum.None)
    else
        self:CloseCall(require("SettlementModel").FunctionEnum.None)
    end
end

--倒计时
function ActivityDispatchAllBattleResultView:ShowWaitTime(elapsed)
    self.go_table.aortext_autoNext.text = string.format(_G.GetLangPackValue(90033400116), _G.Mathf.RoundToInt(self.waitTime))
    self.waitTime = self.waitTime - elapsed
    if self.waitTime < 0 then
        self.click = true
        ActivityDispatchModel:GetInstance():AutoBattle()
        self:CloseCall(require("SettlementModel").FunctionEnum.None)
        if self.waitTimer ~= nil then
            self.waitTimer:Stop()
            self.waitTimer = nil
        end
    end
end

function ActivityDispatchAllBattleResultView:ShowData(data)
    local score = self.result.score and tonumber(self.result.score) or 0
    self.go_table.aortext_mScoreAdd:SetActiveE(score >= 0 and 1 or 0)
    self.go_table.aortext_mScoreAdd2:SetActiveE(score >= 0 and 0 or 1)
    if score >= 0 then
        self.go_table.aortext_mScoreAdd.text = string.format("+%d", score)
    else
        self.go_table.aortext_mScoreAdd2.text = score
    end
    local win_num = self.result.win_num or 0
    --连胜
    self.go_table.aortext_winNum.text = _G.GetLangPackValue(90032100052, win_num)
    --描述
    self.go_table.aortext_des.text = _G.GetLangPackValue(90033400046, win_num)
end

---监听界面
---@param name string 界面名称
function ActivityDispatchAllBattleResultView:OnUIOpened(name)
    if name == _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
        self.ShowAwardWithButtonView = _G.UIManager:GetInstance():GetWindowCtrl(name)

        self.ShowAwardWithButtonView.go_table.aortext_tip:SetParentE(self.ShowAwardWithButtonView.go_table.obj_tips1)
        _G.UIManager:GetInstance():ChangeCanvasOrder(
            name,
            self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 1
        )
        self.ShowAwardWithButtonView.transform:SetParentE(self.go_table.trans_view)
        self.go_table.obj_info:SetActiveE(1)
        -- CommonTipManager:GetInstance().OpenCommonAwardView(self.award)
    end
end

---打开结算界面
---@param name string 结算界面名称
---@param result table 结算参数
function ActivityDispatchAllBattleResultView:OnShowView(name, OnSettlementEndCall, result)
    _G.UIManager:GetInstance():OpenWindow(name, OnSettlementEndCall, result, nil, nil, nil, nil, self.mvpData)
end

---监听界面
---@param name string 界面名称
function ActivityDispatchAllBattleResultView:OnUIClosed(name)
    if name == _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
        self:Close()
    end
end

function ActivityDispatchAllBattleResultView:EscClose()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name)
    if view then
        view:CloseCall(_G.SettlementModel.FunctionEnum.None)
    end
end

function ActivityDispatchAllBattleResultView:OnDestroy()
    if self.waitTimer ~= nil then
        self.waitTimer:Stop()
        self.waitTimer = nil
    end
end

return ActivityDispatchAllBattleResultView
