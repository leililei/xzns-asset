local ActivityDispatchModel = require("ActivityDispatchModel")
---@class ActivityDispatchBattleReportView : UIBaseView    中文描述
---@field public go_table ActivityDispatchBattleReportView_GoTable GoTable
local ActivityDispatchBattleReportView = _G.BaseClass("ActivityDispatchBattleReportView", _G.UIBaseView)

---构造函数
---@protected
function ActivityDispatchBattleReportView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ActivityDispatchBattleReportView:OnCreate()
    self.logList = {}
    self.ItemList = {}
    if self.BtnNodeList == nil then
        self.BtnNodeList = {}
        for i = 1, 2 do
            self.BtnNodeList[i] = _G.GetAutoGoTable(self.go_table["obj_tag" .. i], _G.handlerbind(self, self.SetTag, i))
        end
    end
    self:SetTag(nil, nil, 1)
    self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))
end

---
---@protected
function ActivityDispatchBattleReportView:SetView()
    if self.logList[self.curIndex] == nil then
        require("ActivityDispatchNet"):GetInstance():GetReport(
            { type = self.curIndex },
            function(msg)
                self.logList[self.curIndex] = msg.report or {}
                _G.table.sort(self.logList[self.curIndex], function(a, b)
                    return a.time > b.time
                end)
                self:SetListView()
            end
        )
    else
        self:SetListView()
    end
end

---
---@protected
function ActivityDispatchBattleReportView:SetListView()
    if self.init == nil then
        self.go_table.scrollloopvectical_list:InitItemData(#self.logList[self.curIndex], _G.handler(self, self.OnRefreshLoopListItem))
        self.init = true
    else
        self.go_table.scrollloopvectical_list:UpdateCount(#self.logList[self.curIndex])
    end
    self.go_table.obj_nil:SetActiveE(#self.logList[self.curIndex] > 0 and 0 or 1)
end

function ActivityDispatchBattleReportView:OnRefreshLoopListItem(i, item)
    if i < 0 then
        return
    end
    local eIndex = i + 1
    local id = item:GetInstanceIDE()
    local ctrl = self.ItemList[id]
    local data = self.logList[self.curIndex][eIndex]
    if not ctrl then
        ctrl = _G.GetAutoGoTable(item)
        _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnClickItemBtn, ctrl))
        self.ItemList[id] = ctrl
    end
    ctrl.index = eIndex
    ctrl.uid = data.report_group_uid
    local roleName = data.role_info.uid > 999999 and data.role_info.name or _G.GetLangPackValue(data.role_info.name)
    ctrl.aortext_name.text = roleName
    _G.UIUtils.SetPlayerHeadItemNew(ctrl.obj_head, data.role_info, 1, true, true, true)
    if data.report_type == 0 then
        ctrl.aortext_desc.text = _G.GetLangPackValue(90033400032, roleName, data.win_num)
    else
        local score = tonumber(data.score)
        if score >= 0 then
            ctrl.aortext_desc.text = _G.GetLangPackValue(90033400058, roleName)
        else
            ctrl.aortext_desc.text = _G.GetLangPackValue(90033400057, roleName, score * -1)
        end
    end
    ctrl.aorbtn_info:SetActiveE((data.report_type == 0 and self.curIndex == 1) and 1 or 0)
    local time = _G.TimeUtil.GetDateTime(data.time)
    ctrl.aortext_time.text = time.month .. "-" .. time.day .. " " .. string.format("%02d:%02d:%02d", time.hour, time.minute, time.second)
    return item
end

function ActivityDispatchBattleReportView:OnClickItemBtn(_, _, ctrl)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityDispatchBattleReportDetailView.Name, ctrl.uid)
end

function ActivityDispatchBattleReportView:SetTag(_, _, index)
    self.curIndex = index
    self:RefreshTagBtn()
    self:SetView()
end

function ActivityDispatchBattleReportView:RefreshTagBtn()
    for k, item in pairs(self.BtnNodeList) do
        item.obj_selectNode:SetActiveE(k == self.curIndex and 1 or 0)
        item.obj_normalNode:SetActiveE(k == self.curIndex and 0 or 1)
    end
end

---界面的销毁函数
function ActivityDispatchBattleReportView:OnDestroy()
end

---按钮点击事件在这里派发
function ActivityDispatchBattleReportView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_log1 then
        self:SetTag(go, isOn, 1)
    elseif go == self.go_table.aorbtn_log2 then
        self:SetTag(go, isOn, 2)
    end
end

return ActivityDispatchBattleReportView