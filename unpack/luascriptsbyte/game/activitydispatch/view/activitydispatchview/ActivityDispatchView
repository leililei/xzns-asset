---监听Toggle点击事件
---@param key string
---@param callback function
function ActivityDispatchView:OnClickToggle(_, isOn, key)
    local tb = self.toggles[key]
    local view = self.views[key]
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    local lastToggle = self.curToggle
    self.curToggle = key

    --节点显隐
    if view then
        if self.curToggle == 4 and isOn then
            RankUtils.ClearAllRankData()
            if view.RefreshData then
                view:RefreshData()
            end
        elseif self.curToggle == 5 and isOn then
            view:RefreshUI()
        elseif self.curToggle == 1 and isOn and lastToggle then
            self:GetWinBroadcastData()
            local data = require("RecordRankModel"):GetInstance():GetRankData(96)
            if data:GetMyRank() ~= nil then
                ActivityDispatchModel:GetInstance().selfRank = data:GetMyRank()
                self:SetRank()
            end
        end
        view.gameObject:SetActiveE(isOn and 1 or 0)
    end

    if isOn then
        if _G.AppSetting.IsXzns then
            self.go_table.obj_goldInfo:SetActiveE((self.curToggle == 1) and 1 or 0)
        end
        self:OpenView()
        self:CloseScrollerView()
    end
end

function ActivityDispatchView:OpenView()
    local view = self.views[self.curToggle]
    self.openView = viewName[self.curToggle]
    if not view then
        if self.curToggle == 2 then
            _G.UIManager:GetInstance():OpenWindow(self.openView)
        elseif self.curToggle == 3 then
            --奖励
            local rankStr = RankUtils.RankStrDefault.MilitaryIndustry
            local model = require("ActivityDispatchModel"):GetInstance()
            local Scope = model:GetRankAwardCfgIdScope(96)
            --local campType = ActivityDispatchModel:GetInstance():GetCampType()
            --local campRankType = campType == 1 and 97 or 98
            --local id = campType == 1 and 12 or 8
            local Scope2 = model:GetRankAwardCfgIdScope(97)

            -----@type RewardPreviewView.OpenData[]
            local OpenData = {--TODO 排行榜 常量
                RankUtils.GetData(11, ActivityDispatchModel:GetInstance():GetSelfRank(), ActivityDispatchModel:GetInstance():GetScore(), rankStr, nil, _G.ConfigManager.arena_rank_cfg, Scope.min, Scope.max, 1),
                RankUtils.GetData(12, 0, 0, rankStr, nil, _G.ConfigManager.arena_rank_cfg, Scope2.min, Scope2.max, 1, 97),
                --RankUtils.GetData(1),
            }

            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RewardPreviewFullView.Name, OpenData, 1)
        elseif self.curToggle == 4 then
            --排行
            local model = require("RecordRankModel"):GetInstance()
            RankUtils.ClearAllRankData()
            local isHas = require("SociatyManager"):GetInstance():HasSociaty()
            local RankDatas = {
                model:GetRankData(RankUtils.RankType.BattleSongPersonalPoints),
                model:GetRankData(RankUtils.RankType.BattleSongAllianceTeam),
            }
            if isHas then
                _G.table.insert(RankDatas, model:GetRankData(RankUtils.RankType.BattleSongHordeSquad))
            end
            _G.UIManager:GetInstance():OpenWindow(self.openView, RankDatas, RankUtils.RankType.BattleSongPersonalPoints)
        elseif self.curToggle == 5 then
            --兑换
            ActivityDispatchModel:GetInstance():OpenExchange()
            if self.stage ~= 4 then
                _G.PlayerPrefsManager.SetInt("LimitTimeExchangeCloseRedPoint" .. self.activityExchange:GetActivityID(), 1)
            else
                _G.PlayerPrefsManager.SetInt("LimitTimeExchangeCloseRedPoint" .. self.activityExchange:GetActivityID(), 0)
            end
            self.openView = self.activityExchange:GetActivityTypeCls():OnGetMainViewName()
            _G.GlobalInterface.JumpActivityByGM(10005, self.activity:GetJumpType(self.activityID))
        end
    else
        if self.curToggle == 2 then
            local view = _G.UIManager:GetInstance():GetWindowCtrl(self.openView)
            if view then
                view.logList = {}
                view:SetView()
            end
        end
    end
end

function ActivityDispatchView:OnUIOpen(name)
    if name ~= self.openView then
        return
    end

    if name == _G.ConfigManager.ui_cfg.RewardPreviewFullView.Name then
        ActivityDispatchModel:GetInstance():ChangeAwardShowRed()
    end

    _G.UIManager:GetInstance():ChangeCanvasOrder(
        self.openView,
        self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 10
    )
    self.views[self.curToggle] = _G.UIManager:GetInstance():GetWindowCtrl(name)
    self.views[self.curToggle].transform:SetParentE(self.go_table.obj_windows)
    self.views[self.curToggle].transform:SetAsLastSiblingE()
end

