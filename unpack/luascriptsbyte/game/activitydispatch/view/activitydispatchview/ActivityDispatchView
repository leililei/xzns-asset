function ActivityDispatchView:GetWinBroadcastData()
    ActivityDispatchModel:GetInstance():GetWinBroadcast(function(data)
        self.winLog = data
        for i = 1, 3 do
            if self.winLog[i] ~= nil then
                self:SetWinBroadcastView(i)
            end
        end
    end)
    self.broadCastTime = 0
end

