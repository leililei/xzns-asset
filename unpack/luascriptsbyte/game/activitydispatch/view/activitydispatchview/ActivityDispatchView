function ActivityDispatchView:InitView()
    --进攻时间
    --local fightTime = ActivityDispatchModel:GetInstance():GetFightTime()
    --self.go_table.aortext_timeAttack.text = _G.GetLangPackValue(90033400002, _G.Mathf.Floor(fightTime.key / 3600), _G.Mathf.Floor(fightTime.value / 3600))
    --我的军功
    self:SetScore()
    --我的排名
    self:SetRank()
    --挑战次数
    self:SetFightNum()
    --cd时间
    self:UpdateFightNumChange()
    --阶段信息
    self:SetStageInfo()
    --红点绑定
    --战令
    local activity = ActivitySynManager:GetInstance():GetChildAcitivity(10027, self.activity:GetJumpType(self.activityID))
    if activity then
        self.go_table.obj_redpointBattlePass:UpdateRedPointItemIDAndParam(activity:GetActivityTypeCls():GetRedpointIDByIndex(1))
    end
    --礼包
    local activity = ActivitySynManager:GetInstance():GetChildAcitivity(10014, self.activity:GetJumpType(self.activityID))
    if activity then
        self.go_table.obj_redpointGift:UpdateRedPointItemIDAndParam(activity:GetActivityTypeCls():GetRedpointIDByIndex(1))
    end
    self.go_table.aorbtn_gift:SetActiveE(activity and 1 or 0)
    --统帅赠礼
    self.go_table.obj_redpointChampionAward:UpdateRedPointItemIDAndParam(self.activity:GetActivityTypeCls():GetRedpointIDByIndex(5))
    --兑换
    self.activityExchange = ActivitySynManager:GetInstance():GetChildAcitivity(10005, self.activity:GetJumpType(self.activityID))
    if self.activityExchange then
        self.toggles[5].obj_redpoint:UpdateRedPointItemIDAndParam(self.activityExchange:GetActivityTypeCls():GetRedpointIDByIndex(1))
    end
    if self.stage ~= 4 then
        if ActivityDispatchModel:GetInstance():GetOpenExchange() then
            _G.PlayerPrefsManager.SetInt("LimitTimeExchangeCloseRedPoint" .. self.activityExchange:GetActivityID(), 1)
        else
            _G.PlayerPrefsManager.SetInt("LimitTimeExchangeCloseRedPoint" .. self.activityExchange:GetActivityID(), 0)
        end
    else
        _G.PlayerPrefsManager.SetInt("LimitTimeExchangeCloseRedPoint" .. self.activityExchange:GetActivityID(), 0)
    end
    self.go_table.toggle_tag5:SetActiveE(self.activityExchange and 1 or 0)
    --统帅赠礼
    self.go_table.obj_redpointChampionAward:UpdateRedPointItemIDAndParam(self.activity:GetActivityTypeCls():GetRedpointIDByIndex(5))
    --分享
    self.go_table.obj_redpointShare:UpdateRedPointItemIDAndParam(self.activity:GetActivityTypeCls():GetRedpointIDByIndex(3))
    --任务奖励
    local activitys2 = require "ActivitySynManager":GetInstance():GetChildAcitivity(
        10007,
        self.activity:GetJumpType(self.activity.activityID)
    )
    if activitys2 then
        self.go_table.obj_redpointTaskAward:UpdateRedPointItemIDAndParam(
            activitys2:GetActivityTypeCls():GetRedpointIDByIndex(1)
        )
    end
    self.go_table.obj_redpointBattle:UpdateRedPointItemIDAndParam(self.activity:GetActivityTypeCls():GetRedpointIDByIndex(4))
    self.go_table.obj_redpointEmbattle:UpdateRedPointItemIDAndParam(self.activity:GetActivityTypeCls():GetRedpointIDByIndex(6))
    self.toggles[3].obj_redpoint:UpdateRedPointItemIDAndParam(self.activity:GetActivityTypeCls():GetRedpointIDByIndex(2))
    self:SetShareInfo()
end

function ActivityDispatchView:SetShareInfo()
    local shareNum, shareLimit = ActivityDispatchModel:GetInstance():GetShareInfo()
    self.go_table.aortext_shareNum.text = (shareLimit - shareNum) .. "/" .. shareLimit
end

---累充任务大奖显示
function ActivityDispatchView:SetTaskAward()
    local itemData = ActivityDispatchModel:GetInstance():GetNextAward()
    if itemData then
        local target = ActivityDispatchModel:GetInstance():GetHisFightNum()
        if target > itemData.Cfg.count then
            target = itemData.Cfg.count
        end
        self.go_table.obj_taskAwardRoot:RemoveAllChildren()
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            itemData.Cfg.reward[1].type,
            self.go_table.obj_taskAwardRoot,
            function(tran)
                tran.gameObject:SetLocalScaleXYZ(0.7)
                if itemData.Cfg.reward[1].type[2] > 1 then
                    tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                else
                    tran:ShowNumText(false)
                end
                if tran.ShowEffectOrder and tran.cfg then
                    tran:ShowEffectOrder(tran.cfg.ef_item == 1 and true or false)
                end
            end
        )
        local w = target / itemData.Cfg.count
        if w > 1 then
            w = 1
        end
        self.go_table.aorimage_awardBar:SetRectTransformSize(target > 0 and w * (_G.AppSetting.IsXzns and 71 or 87) or 0, _G.AppSetting.IsXzns and 16 or 20)
        self.go_table.aortext_taskAward.text = target .. "/" .. itemData.Cfg.count
    end
end

---设置阶段信息
function ActivityDispatchView:SetStageInfo()
    self.stage, self.stageEndTime = ActivityDispatchModel:GetInstance():GetStateInfo()
    if self.stage ~= 4 then
        self.endTime = self.enrollEndTime
    end
    self.go_table.aortext_dispatchTime:SetActiveE(self.stage == 3 and 1 or 0)
    self.go_table.aortext_fightNumCd:SetActiveE(self.stage == 2 and 1 or 0)
    self.go_table.aortext_fightNum:SetActiveE(self.stage == 2 and 1 or 0)
    self.go_table.aorimage_title.SpriteName = self.stage == 4 and "ui_zgzf_txt_jsq" or "ui_zgzf_txt_tzq"
    self.go_table.obj_desBg:SetActiveE(self.stage == 4 and 0 or 1)
    --兑换
    if self.activityExchange then
        if self.stage ~= 4 then
            if ActivityDispatchModel:GetInstance():GetOpenExchange() then
                _G.PlayerPrefsManager.SetInt("LimitTimeExchangeCloseRedPoint" .. self.activityExchange:GetActivityID(), 1)
            else
                _G.PlayerPrefsManager.SetInt("LimitTimeExchangeCloseRedPoint" .. self.activityExchange:GetActivityID(), 0)
            end
        else
            _G.PlayerPrefsManager.SetInt("LimitTimeExchangeCloseRedPoint" .. self.activityExchange:GetActivityID(), 0)
        end
    end
end

---开始时间~结束时间  (日月)
function ActivityDispatchView:InitActivityTime()
    local starTime = self.activity.cfg.time.start_time
    local start = _G.TimeUtil.GetDateTime(starTime)
    local endt = _G.TimeUtil.GetDateTime(starTime + self.activity.cfg.time.run_time)
    local color = "<color=#96ce51>"
    if _G.AppSetting.IsXzns then
        color = "<color=#febc48>"
    end
    self.go_table.aortext_time2.text = _G.GetLangPackValue(
        90025800003, color .. string.format("%s</color>", _G.GetLangPackValue(90032100011, start.month, start.day) .. " " .. string.format("%02d:%02d:%02d", start.hour, start.minute, start.second) .. "~" .. _G.GetLangPackValue(90032100011, endt.month, endt.day) .. " " .. string.format("%02d:%02d:%02d", endt.hour, endt.minute, endt.second)))
end

function ActivityDispatchView:UpdateTimer()
    local time = self.endTime - _G.TimeUtil.GetServerUnixTime()
    self.broadCastTime = self.broadCastTime + 1
    self.go_table.aortext_time.text = _G.GetLangPackValue(90000011689, _G.TimeUtil.TranslateSecondForStr(time))
    if self.broadCastTime > 600 then
        self:GetWinBroadcastData()
    end
    if time <= 0 then
        self.timer:Stop()
        self.timer = nil
        return
    end
    self:UpdateDispatchTimer()
    self:UpdateFightNumChange()
end

---派遣时间
function ActivityDispatchView:UpdateDispatchTimer()
    if self.stage == 3 then
        local time = self.stageEndTime - _G.TimeUtil.GetServerUnixTime()
        if time <= 0 then
            self.go_table.aortext_dispatchTime.text = ""
            self.go_table.aortext_dispatchTime:SetActiveE(0)
        end
        self.go_table.aortext_dispatchTime.text = _G.GetLangPackValue(90033400007, _G.TimeUtil.TranslateSecondForStr(time))
    end
end

---次数恢复时间
function ActivityDispatchView:UpdateFightNumChange()
    if self.stage == 2 then
        if self.fightNum == self.fightTimesCfg.key then
            self.go_table.aortext_fightNumCd.text = _G.GetLangPackValue(90033400109)
            self.go_table.aortext_fightNum.text = _G.GetLangPackValue(90033401030, self.fightNum .. "/" .. self.fightTimesCfg.key)
        else
            self.fightcd = ActivityDispatchModel:GetInstance():GetFightCd()
            local serverTime = _G.TimeUtil.GetServerUnixTime()
            self.go_table.aortext_fightNumCd.text = _G.GetLangPackValue(90033400091, _G.TimeUtil.TranslateSecondForStr(self.fightTimesCfg.value - (serverTime - self.fightcd)))
            self.fightNum = ActivityDispatchModel:GetInstance():GetFightNum()
            self.go_table.aortext_fightNum.text = _G.GetLangPackValue(90033401030, self.fightNum .. "/" .. self.fightTimesCfg.key)
        end
    end
end

---界面的销毁函数
function ActivityDispatchView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:RemoveAllListener()
    self:CloseScrollerView()
    --关闭内嵌页面
    if self.views then
        for k, view in pairs(self.views) do
            if k ~= 1 then
                view:Close()
            end
        end
        self.views = nil
    end
end

---按钮点击事件在这里派发
function ActivityDispatchView:OnClickBtn(go)
    if go ~= self.go_table.aorbtn_share then
        self:CloseScrollerView()
    end
    if go == self.go_table.aorbtn_CloseView then
        if self.curToggle ~= 1 then
            self.go_table.toggle_tag1.isOn = true
            return
        end
        self:Close()
        --关闭内嵌页面
        if self.views then
            for k, view in pairs(self.views) do
                if k ~= 1 then
                    view:Close()
                end
            end
            self.views = nil
        end
    elseif go == self.go_table.aorbtn_info then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 166)
    elseif go == self.go_table.aorbtn_gift then
        --打开礼包界面
        local activity = ActivitySynManager:GetInstance():GetChildAcitivity(10014,
            self.activity:GetJumpType(self.activityID))
        local giftView = 
            _G.AppSetting.IsXzns and _G.ConfigManager.ui_cfg.ActivityDispatchGiftPackView.Name or
            _G.ConfigManager.ui_cfg.GiftPackGMCommonView.Name
        _G.UIManager:GetInstance():OpenWindow(giftView, activity, 2)
    elseif go == self.go_table.aorbtn_championAward then
        --打开统帅赠礼界面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityDispatchChampionView.Name)
    elseif go == self.go_table.aorbtn_taskAward then
        --打开限时任务界面
        _G.GlobalInterface.JumpActivityByGM(10007, self.activity:GetJumpType(self.activity.activityID))
    elseif go == self.go_table.aorbtn_log then
        --打开战报界面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityDispatchBattleReportView.Name)
    elseif go == self.go_table.aorbtn_embattle then
        --打开布阵界面
        ActivityDispatchModel:GetInstance():OpenDefenceEmbattle()
    elseif go == self.go_table.aorbtn_share then
        --分享
        ActivityDispatchModel:GetInstance():ShareActivity()
    elseif go == self.go_table.aorbtn_battle then
        --战斗
        local auto = ActivityDispatchModel:GetInstance():GetFightAuto() == 1 and true or false
        if ActivityDispatchModel:GetInstance():GetHaveBattleInfo() and auto == false then
            --打开挑战界面
            if ActivityDispatchModel:GetInstance():GetBattleIng() == false then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityDispatchBattleView.Name)
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(1080005)
            end
            -- elseif ActivityDispatchModel:GetInstance():GetHaveBattleInfo() and auto == true then
            --     _G.PopWindowManager:GetInstance():ShowAllTips(1080004)
        else
            if self.stage == 2 then
                if self.fightNum > 0 or _G.StorageManager:GetInstance():GetItemCountBySid(ticketId) > 0 then
                    if auto == false then
                        --打开选buff界面
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityDispatchChooseBuffView.Name)
                    else
                        if _G.BattleManager:GetInstance():CheckInBattle() then
                            _G.PopWindowManager:GetInstance():ShowAllTips(1080009)
                            return
                        end
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityDispatchAutoBattleView.Name)
                    end
                else
                    _G.PopWindowManager:GetInstance():ShowAllTips(1080003)
                    local activity = ActivitySynManager:GetInstance():GetChildAcitivity(10014,
                        self.activity:GetJumpType(self.activityID))
                    if _G.AppSetting.IsXzns then
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityDispatchGiftPackView.Name, activity, 2)
                    else
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GiftPackGMCommonView.Name, activity, 2)
                    end
                end
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(8204)
            end
        end
    elseif go == self.go_table.aorbtn_battleAuto then
        if ActivityDispatchModel:GetInstance():GetHaveBattleInfo() then
            _G.PopWindowManager:GetInstance():ShowAllTips(1080004)
        else
            if self.stage == 2 then
                if self.fightNum > 0 or _G.StorageManager:GetInstance():GetItemCountBySid(ticketId) > 0 then
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityDispatchAutoBattleView.Name)
                else
                    _G.PopWindowManager:GetInstance():ShowAllTips(1080003)
                end
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(8204)
            end
        end
    elseif go == self.go_table.aorbtn_cancelAuto then
        ActivityDispatchModel:GetInstance():CancelAuto()
    elseif go == self.go_table.aorbtn_serverList then
        require("ActivityDispatchNet"):GetInstance():GetServerList(
            { activity_id = self.activityID },
            function(data)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicTeamServerListView.Name, data)
            end
        )
    end
end

return ActivityDispatchView