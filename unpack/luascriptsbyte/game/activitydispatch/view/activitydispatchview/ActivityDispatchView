---@protected
function ActivityDispatchView:SetHeadView(index)
    local num = #self.campInfo[1] > 10 and 10 or #self.campInfo[1]
    local list = ActivityDispatchModel:GetInstance():GetRandomNumbers(#self.campInfo[1], num)
    for j = 1, 10 do
        if self.teamObj[index][j] == nil then
            self.teamObj[index][j] = _G.GetAutoGoTable(self.teamObj[index]["obj_item" .. j])
        end
        self.teamObj[index][j].obj_HeadItemBase:SetActiveE(num >= j and 1 or 0)
        self.teamObj[index][j].obj_bg:SetActiveE(num >= j and 1 or 0)
        if num >= j then
            local data = self.campInfo[1][list[j]]
            _G.UIUtils.SetPlayerHeadItemNew(self.teamObj[index][j].obj_HeadItemBase, data, 1, true, false, false)
            self.teamObj[index][j].aortext_name.text = data.name
        end
    end
end

