---构造函数
---@protected
function ActivityDispatchView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eActivityDispatch.StageChange, self.SetStageInfo)
    self:AddListener(_G.eActivityDispatch.FightNumChange, self.SetFightNum)
    self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpen, self)
    self:AddListener(_G.AnimationEvents.ActivityDispatchMove, self.ShowAnimation, self)
    self:AddListener(_G.eActivityDispatch.ShareChat, self.SetShareInfo)
    self:AddListener(_G.eActivityDispatch.ScoreChange, self.SetScore)
    self:AddListener(_G.eActivityDispatch.SetAuto, self.SetAutoBtn)
    --self:AddListener(_G.AnimationEvents.ActivityDispatchMain, self.LoadUiEffect, self)
    self:AddListener(_G.AnimationEvents.ActivityDispatchBroadcast1, self.PlayWinBroadcast1, self)
    self:AddListener(_G.AnimationEvents.ActivityDispatchBroadcast2, self.PlayWinBroadcast2, self)
    self:AddListener(_G.AnimationEvents.ActivityDispatchBroadcast3, self.PlayWinBroadcast3, self)
end

---界面的入口函数
function ActivityDispatchView:OnCreate()
    self.activity = ActivityDispatchModel:GetInstance():GetActivity()
    self.activityID = self.activity.activityID
    self.activityCls = self.activity:GetActivityTypeCls()
    self.endTime = self.activity.cfg.time.start_time + self.activity.cfg.time.run_time
    self.enrollEndTime = self.activity.cfg.time.start_time + ActivityDispatchModel:GetInstance():GetEnrollEndTime()
    self.toggles = {}
    self.WinBroadcastItem = {}
    self.views = { [1] = { gameObject = self.go_table.obj_mainView } }
    for i = 1, 6 do
        self.toggles[i] = _G.GetAutoGoTable(self.go_table["toggle_tag" .. i], _G.handlerbind(self, self.OnClickToggle, i))
    end
    self:InitView()
    self:InitActivityTime()
    self.broadCastTime = 0
    self:UpdateTimer()
    if not self.timer then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimer, self, false, false, true)
        self.timer:Start()
    end
    self:OnClickToggle(nil, true, 1)
    local resources = _G.ConfigManager.ui_cfg.ActivityDispatchView.resources
    if #resources > 0 then
        self:AddComponent(
            self.go_table.obj_goldInfo,
            require("ResourceCompont").New(self.go_table.obj_goldInfo, resources)
        )
    end
    self:LoadEffect()
    self.teamObj = {}
    self.campInfo = {}
    self:ShowAnimation()
    --自动战斗
    self.Toggle = self.go_table.toggle_autoBattle:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle))
    self.isOn = ActivityDispatchModel:GetInstance():GetFightAuto()
    self.Toggle.isOn = self.isOn == 1 and true or false
    self.Toggle.onValueChanged:AddListener(_G.handler(self, self.OnToggleChanged))
    self:SetAutoBtn()
    --self:GetWinBroadcastData()
    self.go_table.obj_serverList:GetComponentE(_G.typeof(_G.CS.ExtendText)).text = string.format("<%s@1>", _G.GetLangPackValue(90033500130))
end

function ActivityDispatchView:OnEnable()
    if self.go_table.obj_mainView:GetActiveSelf() == 1 then
        self:GetWinBroadcastData()
    end
end

