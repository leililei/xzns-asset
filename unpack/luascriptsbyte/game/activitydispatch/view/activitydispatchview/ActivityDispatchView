---@protected
function ActivityDispatchView:SetWinBroadcastView(type)
    self.go_table["obj_itemLog" .. type]:SetActiveE(0)
    if self.winLog[type][1] ~= nil then
        local data = _G.DeepCopy(self.winLog[type][1])
        _G.table.remove(self.winLog[type], 1)
        self.go_table["obj_itemLog" .. type]:SetActiveE(1)
        if self.WinBroadcastItem[type] == nil then
            self.WinBroadcastItem[type] = _G.GetAutoGoTable(self.go_table["obj_itemLog" .. type])
        end
        local goTable = self.WinBroadcastItem[type]
        goTable.aortext_des.text = _G.GetLangPackValue(txtBroadcast[type], data.name, data.win_num)
        _G.UIUtils.SetPlayerHeadItemNew(
                goTable.obj_HeadItemBase, 
                { style = data.style, frame = data.frame, title = { sid = data.title } }, 
                _G.AppSetting.IsXzns and 0.8 or 0.7, 
                true, 
                true, 
                true)
    end
end

--toggle监听
function ActivityDispatchView:OnToggleChanged(isOn)
    if self.Toggle.isOn then
        local hisFightNum = ActivityDispatchModel:GetInstance():GetHisFightNum()
        if condition > hisFightNum then
            self.Toggle.isOn = false
            local str = _G.LangUtil.GetLangPackValue(_G.ConfigManager.tips_system_cfg[1080008].content, condition - hisFightNum)
            _G.PopWindowManager:GetInstance():ShowAllTips(1080008, str)
            return
        end
        -- if ActivityDispatchModel:GetInstance():GetHaveBattleInfo() then
        --     self.Toggle.isOn = false
        --     _G.PopWindowManager:GetInstance():ShowAllTips(1080004)
        -- else
        --     ActivityDispatchModel:GetInstance():SetFightAuto(true)
        -- end
        ActivityDispatchModel:GetInstance():SetFightAuto(true)
    else
        ActivityDispatchModel:GetInstance():SetFightAuto(false)
        if ActivityDispatchModel:GetInstance():GetAllBattleAuto() == true then
            ActivityDispatchModel:GetInstance():CancelAuto()
        end
    end
end

