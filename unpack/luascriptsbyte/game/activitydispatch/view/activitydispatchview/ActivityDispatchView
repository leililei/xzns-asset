function ActivityDispatchView:ShowAnimation()
    if self.AnimComponent == nil then
        self.AnimComponent = self.go_table.obj_mainView:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    end
    for i = 1, 2 do
        if self.teamObj and self.teamObj[i] == nil then
            self.teamObj[i] = _G.GetAutoGoTable(self.go_table["obj_team" .. teamObjType[i]])
        end
        if self.campInfo[1] == nil then
            require("ActivityDispatchNet"):GetInstance():GetRank(
                { activity_id = self.activityID },
                function(data)
                    self.campInfo[1] = data.role_info or {}
                    self:SetHeadView(i)
                end
            )
        else
            self:SetHeadView(i)
        end
    end
    --self.AnimComponent:Play("")
end

