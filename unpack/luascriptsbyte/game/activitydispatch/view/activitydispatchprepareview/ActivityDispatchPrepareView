local RankUtils = require("RankUtils")
local ActivityDispatchModel = require("ActivityDispatchModel")
---@class ActivityDispatchPrepareView : UIBaseView    中文描述
---@field public go_table ActivityDispatchPrepareView_GoTable GoTable
local ActivityDispatchPrepareView = _G.BaseClass("ActivityDispatchPrepareView", _G.UIBaseView)

local viewName = {
    [2] = _G.ConfigManager.ui_cfg.RewardPreviewFullView.Name
}

---构造函数
---@protected
function ActivityDispatchPrepareView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eActivityDispatch.StageChange, self.SetStageInfo)
    self:AddListener(_G.eActivityDispatch.ShareChat, self.SetShareInfo)
    self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpen, self)
end

---界面的入口函数
function ActivityDispatchPrepareView:OnCreate()
    self.activity = ActivityDispatchModel:GetInstance():GetActivity()
    self.activityID = self.activity.activityID
    self.toggles = {}
    self.views = { [1] = { gameObject = self.go_table.obj_root } }
    for i = 1, 2 do
        self.toggles[i] = _G.GetAutoGoTable(self.go_table["toggle_tag" .. i], _G.handlerbind(self, self.OnClickToggle, i))
    end
    self:InitView()
    self.stage, self.stageEndTime = ActivityDispatchModel:GetInstance():GetStateInfo()
    self:UpdateTimer()
    if not self.timer then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimer, self, false, false, true)
        self.timer:Start()
    end
    self.toggles[2].obj_redpoint:UpdateRedPointItemIDAndParam(self.activity:GetActivityTypeCls():GetRedpointIDByIndex(2))
    self:OnClickToggle(nil, true, 1)
end

---监听Toggle点击事件
---@param key string
---@param callback function
function ActivityDispatchPrepareView:OnClickToggle(_, isOn, key)
    local tb = self.toggles[key]
    local view = self.views[key]
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    self.curToggle = key

    --节点显隐
    if view then
        view.gameObject:SetActiveE(isOn and 1 or 0)
    end

    if isOn then
        self:OpenView()
    end
end

function ActivityDispatchPrepareView:OpenView()
    local view = self.views[self.curToggle]
    if not view then
        self.openView = viewName[self.curToggle]
        if self.curToggle == 2 then
            --奖励
            local rankStr = RankUtils.RankStrDefault.MilitaryIndustry
            local model = require("ActivityDispatchModel"):GetInstance()
            local Scope = model:GetRankAwardCfgIdScope(96)
            local campType = ActivityDispatchModel:GetInstance():GetCampType()
            local campRankType = campType == 1 and 97 or 98
            local id = campType == 1 and 12 or 8
            local Scope2 = model:GetRankAwardCfgIdScope(campRankType)

            -----@type RewardPreviewView.OpenData[]
            local OpenData = {--TODO 排行榜 常量
                RankUtils.GetData(11, ActivityDispatchModel:GetInstance():GetSelfRank(), ActivityDispatchModel:GetInstance():GetScore(), rankStr, nil, _G.ConfigManager.arena_rank_cfg, Scope.min, Scope.max, 1),
                RankUtils.GetData(id, ActivityDispatchModel:GetInstance():GetSelfRank(), ActivityDispatchModel:GetInstance():GetScore(), rankStr, nil, _G.ConfigManager.arena_rank_cfg, Scope2.min, Scope2.max, 1),
                RankUtils.GetData(1),
            }

            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RewardPreviewFullView.Name, OpenData, 1)
        end
    end
end

function ActivityDispatchPrepareView:OnUIOpen(name)
    if name ~= self.openView then
        return
    end
    if name == _G.ConfigManager.ui_cfg.RewardPreviewFullView.Name then
        ActivityDispatchModel:GetInstance():ChangeAwardShowRed()
    end
    _G.UIManager:GetInstance():ChangeCanvasOrder(
        self.openView,
        self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 10
    )
    self.views[self.curToggle] = _G.UIManager:GetInstance():GetWindowCtrl(name)
    self.views[self.curToggle].transform:SetParentE(self.go_table.obj_windows)
    self.views[self.curToggle].transform:SetAsLastSiblingE()
end

function ActivityDispatchPrepareView:InitView()
    --本期阵营
    local path = ActivityDispatchModel:GetInstance():GetCampImagePath()
    self.go_table.aorrawimage_camp:LoadImage(path)
    --宣言
    _G.GameUtil.InputFieldCharacterLimitNew(self.go_table.input_notice, 30)
    local notice = ActivityDispatchModel:GetInstance():GetNotice()
    self.go_table.input_notice.text = notice == "" and _G.GetLangPackValue(90033400023) or notice
    self.go_table.input_notice.onEndEdit:AddListener(_G.handler(self, self.OnEndEditorDeclaration))
    self.go_table.aortext_desShare.text = _G.GetLangPackValue(90033400024)
    self:SetShareInfo()
    --红点绑定
    self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(self.activity:GetActivityTypeCls():GetRedpointIDByIndex(6))
    self.go_table.obj_redpointShare:UpdateRedPointItemIDAndParam(self.activity:GetActivityTypeCls():GetRedpointIDByIndex(3))
end

---
---@protected
function ActivityDispatchPrepareView:SetShareInfo()
    local shareNum, shareLimit = ActivityDispatchModel:GetInstance():GetShareInfo()
    self.go_table.aortext_shareNum.text = (shareLimit - shareNum) .. "/" .. shareLimit
end

---编辑宣言
---@param input string
function ActivityDispatchPrepareView:OnEndEditorDeclaration(input)
    self.go_table.input_notice.text = input
    ActivityDispatchModel:GetInstance():SetNotice(input)
end

function ActivityDispatchPrepareView:UpdateTimer()
    local time = self.stageEndTime - _G.TimeUtil.GetServerUnixTime()
    if time <= 0 then
        self.timer:Stop()
        self.timer = nil
        return
    end
    self.go_table.aortext_time.text = _G.GetLangPackValue(90033400098, _G.TimeUtil.TranslateSecondForStr(time))
end

---设置阶段信息
function ActivityDispatchPrepareView:SetStageInfo()
    local stage, stageEndTime = ActivityDispatchModel:GetInstance():GetStateInfo()
    if stage ~= 1 then
        ActivityDispatchModel:GetInstance():OpenView()
        self:Close()
    end
end

---界面的销毁函数
function ActivityDispatchPrepareView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
function ActivityDispatchPrepareView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        if self.curToggle == 2 then
            self.go_table.toggle_tag1.isOn = true
            return
        end
        self:Close()
    elseif go == self.go_table.aorbtn_info then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 166)
    elseif go == self.go_table.aorbtn_share then
        --分享
        ActivityDispatchModel:GetInstance():ShareActivity()
    elseif go == self.go_table.aorbtn_camp then
        --打开报名界面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityDispatchSignUpView.Name)
    elseif go == self.go_table.aorbtn_embattle then
        --打开布阵界面
        ActivityDispatchModel:GetInstance():OpenDefenceEmbattle()
    end
end

return ActivityDispatchPrepareView