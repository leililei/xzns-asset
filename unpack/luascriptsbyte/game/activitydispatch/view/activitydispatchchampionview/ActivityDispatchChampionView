local ActivityDispatchModel = require("ActivityDispatchModel")
---@class ActivityDispatchChampionView : UIBaseView    中文描述
---@field public go_table ActivityDispatchChampionView_GoTable GoTable
local ActivityDispatchChampionView = _G.BaseClass("ActivityDispatchChampionView", _G.UIBaseView)

local boximage = {
    "ImagesH5/hActivityDispatch/ui_zgzf_tszl_baoxiang_1",
    "ImagesH5/hActivityDispatch/ui_zgzf_tszl_baoxiang_2",
    "ImagesH5/hActivityDispatch/ui_zgzf_tszl_baoxiang_3",
    "ImagesH5/hActivityDispatch/ui_zgzf_tszl_baoxiang_4"
}

---构造函数
---@protected
function ActivityDispatchChampionView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.AnimationEvents.ActivityDispatchBoxChange, self.InitBoxView, self)
end

---界面的入口函数
function ActivityDispatchChampionView:OnCreate()
    ActivityDispatchModel:GetInstance():GetChampionInfo(function(msg)
        self.data = msg
        self:InitView()
        ActivityDispatchModel:GetInstance():ChangeChampionAwardRed()
    end)
end

function ActivityDispatchChampionView:InitView()
    --形象
    if self.data.role_info == nil then
        self.data.role_info = {}
        self.data.role_info.city_style_id = _G.PlayerModel:GetInstance():GetRoleSid()
        self.data.role_info.name = _G.PlayerModel:GetInstance():GetName()
    end
    local cfg = require "CardCommentManager":GetInstance():CardData(self.data.role_info.city_style_id, false)
    local useBattle = _G.UIUtils.IsUseBattleSpine(_G.UseBattleSpine.RankView)
    local path = _G.UIUtils.GetBattleSpine(cfg, _G.UseBattleSpine.RankView)
    self:LoadRoleModel(path, useBattle and cfg.size2 or cfg.size4)
    self.go_table.aortext_name.text = self.data.role_info.name
    --气泡
    --local name = _G.GetLangPackValue(90033400028, ActivityDispatchModel:GetInstance():GetCampName())
    --self.go_table.aortext_tips.text = name
    self:InitBoxView()
    --战报滚动
    local logs = self.data.logs
    if logs and #logs > 0 then
        local logData = {}
        --for i, v in ipairs(logs) do
        --    _G.table.insert(logData, _G.GetLangPackValue(90033400027, v.value1, v.value2, ActivityDispatchModel:GetInstance():GetCampName(v.value3), v.value4))
        --end
        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ScrollerFunctionPanelView.Name, logData, 500)
        _G.table.sort(logs, function(a, b)
            return a.value5 > b.value5
        end)
        for i, v in ipairs(logs) do
            local obj = _G.InstantiateObject(self.go_table.aortext_log, self.go_table.obj_Content)
            obj:SetActiveE(1)
            local goTable = _G.GetAutoGoTable(obj)
            goTable.aortext_log.text = _G.GetLangPackValue(90033400027, v.value1, v.value2, v.value3)
            local time = _G.TimeUtil.GetDateTime(v.value5)
            goTable.aortext_time.text = string.format("%02d:%02d:%02d", time.hour, time.minute, time.second)
        end
    end
    self.go_table.obj_logBg:SetActiveE((logs and #logs > 0) and 1 or 0)
    local isHas = require("SociatyManager"):GetInstance():HasSociaty()
    self.go_table.aorbtn_openBox:SetActiveE(isHas == true and 1 or 0)
    self.go_table.obj_nil:SetActiveE(isHas == false and 1 or 0)
    self.go_table.aortext_openNumTotle:SetActiveE(isHas == false and 0 or 1)
end

function ActivityDispatchChampionView:InitBoxView()
    --宝箱图片
    local v = _G.ConfigManager.discrete_cfg[125223][1]
    local boxOpenNum = ActivityDispatchModel:GetInstance():GetBoxNum()
    local boxNum = ActivityDispatchModel:GetInstance():GetBoxNumTotal()
    local path
    if boxNum < v[1] then
        path = boximage[1]
    elseif boxNum >= v[1] and boxNum < v[2] then
        path = boximage[2]
    elseif boxNum >= v[2] and boxNum < v[3] then
        path = boximage[3]
    else
        path = boximage[4]
    end
    self.go_table.aorrawimage_box:LoadImage(path)
    --宝箱数量
    self.go_table.aortext_boxNum.text = "x" .. boxNum
    --开启数量
    self.boxOpenMax = _G.ConfigManager.discrete_cfg[125230][1][1]

    local leftOpenNum = self.boxOpenMax - boxOpenNum
    local openBox = boxNum > leftOpenNum and leftOpenNum or boxNum
    self.boxOpenLimite = _G.ConfigManager.discrete_cfg[125214][1][1]
    self.openBox = openBox > self.boxOpenLimite and self.boxOpenLimite or openBox
    self.go_table.aorbtn_openBox:SetGray(boxNum == 0 or self.openBox == 0)
    if boxNum == 0 then
        self.go_table.aortext_openBoxNum.text = _G.GetLangPackValue(90032700054)
        self.go_table.aortext_openBoxNum.color = _G.Color.New(67 / 255, 64 / 255, 73 / 255, 1)
    elseif self.openBox == 0 then
        self.go_table.aortext_openBoxNum.text = _G.GetLangPackValue(90033400092)
        self.go_table.aortext_openBoxNum.color = _G.Color.New(67 / 255, 64 / 255, 73 / 255, 1)
    else
        local num = self.openBox > 0 and self.openBox or 0
        self.go_table.aortext_openBoxNum.text = _G.GetLangPackValue(90033400030, num)
        self.go_table.aortext_openBoxNum.color = _G.Color.New(145 / 255, 72 / 255, 1 / 255, 1)
    end
    --已开启数量
    self.go_table.aortext_openNumTotle.text = _G.GetLangPackValue(90033400031, (self.data.day_box_num or 0) .. "/" .. self.boxOpenMax)
end

---加载单个角色
---@param view table 视图
---@param rolepath string 模型路径
---@param posType number 摆放的位置
function ActivityDispatchChampionView:LoadRoleModel(rolepath, scale)
    ---@type RecordRankListView._obj_info1_GoTable
    _G.PoolsManager:GetInstance():Spawn(
        rolepath,
        _G.ePoolType.Temporary,
        nil,
        function(trans)
            if trans == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("角色无法加载 path:" .. rolepath .. "    CardInfoView LoadRoleScene")
                end
                return
            end
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            trans:SetParentE(self.go_table.obj_roleRoot)
            trans:SetLocalPosition(0, 0, 0)
            trans:SetLocalScaleXYZ(scale)
        end
    )
end

---tips
function ActivityDispatchChampionView:SetTipsView(isShow)
    self.go_table.obj_TipView:SetActiveE(isShow and 1 or 0)
    if self.TipView == nil then
        self.TipView = _G.GetAutoGoTable(self.go_table.obj_TipView, _G.handlerbind(self, function()
            self.go_table.obj_TipView:SetActiveE(0)
        end))
        local dropId = _G.ConfigManager.discrete_cfg[125215][1][1]
        self.boxAwardPool = _G.ConfigManager.drop_cfg[dropId].content1
        self.TipView.scrollloopvectical_item:InitItemData(#self.boxAwardPool, _G.handler(self, self.RefreshList))
    end
end

function ActivityDispatchChampionView:RefreshList(index, obj)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj)
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        self.boxAwardPool[index],
        tb.obj_item,
        function(item)
            item.gameObject:SetLocalPosition(0, 0, 0)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end)
end

---界面的销毁函数
function ActivityDispatchChampionView:OnDestroy()
    self:RemoveAllListener()
end

function ActivityDispatchChampionView:CloseScrollerView()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ScrollerFunctionPanelView.Name)
    if view then
        view:Close()
    end
end

---按钮点击事件在这里派发
function ActivityDispatchChampionView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:CloseScrollerView()
        self:Close()
    elseif go == self.go_table.aorbtn_info then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 185)
    elseif go == self.go_table.aorbtn_boxAward or go == self.go_table.aorbtn_boxImage then
        --奖励预览
        self:SetTipsView(true)
    elseif go == self.go_table.aorbtn_openBox then
        --开启宝箱
        if self.openBox == 0 then
            return
        end
        local num = self.openBox > 0 and self.openBox or 0
        ActivityDispatchModel:GetInstance():GetChampionAward(num, function(msg)
            if msg.ack ~= 1 then
                self.data.faction_box_num = 0
                self:InitBoxView()
                return
            end
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg, nil, true)
            --self.data.faction_box_num = self.data.faction_box_num - num
            self:InitBoxView()
        end)
    elseif go == self.go_table.aorbtn_log then
        --战报
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityDispatchBattleReportView.Name)
    end
end

return ActivityDispatchChampionView