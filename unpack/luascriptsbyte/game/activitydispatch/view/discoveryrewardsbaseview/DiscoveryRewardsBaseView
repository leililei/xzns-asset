function DiscoveryRewardsBaseView:RefreshItem(index,obj)
    local newIndex = index + 1
    local cfg = self.cfgs[newIndex]
    local id = obj:GetInstanceIDE()
    ---@type DiscoveryRewardItem
    local item = self.itemList[id]
    if not item then
        item = DiscoveryRewardItem.New(obj, _G.handler(self, self.GetCall))
        self.itemList[id] = item
    end
