local ActivityDispatchModel = require("ActivityDispatchModel")
---@class ActivityDispatchBattleReportDetailView : UIBaseView    中文描述
local base = require "SpiritualRealmReportView"
---@field public go_table ActivityDispatchBattleReportDetailView_GoTable GoTable
local ActivityDispatchBattleReportDetailView = _G.BaseClass("ActivityDispatchBattleReportDetailView", base)

---界面的入口函数
function ActivityDispatchBattleReportDetailView:OnCreate(uid)
    self.itemTransDic = {}
    self.go_table.scrollloopvectical_report:InitItemData(0, _G.handler(self, self.RefreshItem))
    require("ActivityDispatchNet"):GetInstance():GetReportDetail(
        { report_group_uid = uid },
        _G.handler(self, self.ShowReport))
end

---@param list arena_peak.s2c_arena_peak_report
function ActivityDispatchBattleReportDetailView:ShowReport(data)
    if data.ack == 1 then
        self.reportList = data.report_detail or {}
    else
        self.reportList = {}
    end
    -- _G.table.sort(self.reportList, function(a, b)
    --     return a.time > b.time
    -- end)
    for i, v in ipairs(self.reportList) do
        v.index = i
        v.strType = 1
    end

    local count = #self.reportList or 0
    self.go_table.obj_emptybg:SetActiveE(count == 0 and 1 or 0)
    self.go_table.scrollloopvectical_report:UpdateCount(count)
end

return ActivityDispatchBattleReportDetailView