function ActivityDispatchAwardShowPanel:RefreshDaJiangList()
    self.dajiangList={}
    for k,v in pairs(self.taskDatas) do
        if v.Cfg.page==1 then
            table.insert(self.dajiangList,{sid=v.Cfg.id,target=v.Cfg.count,award=v.Cfg.reward[1]})
        end
    end
    self:SortDaJiangList()
    if self.DajiangScroll then
        self.DajiangScroll:UpdateAllItem()
    else
        self.go_table.scrollloophorizontal_dajianglist:InitItemData(table.count(self.dajiangList), _G.handler(self, self.RefreshdajiangItem))
        self.DajiangScroll=self.go_table.scrollloophorizontal_dajianglist
    end
