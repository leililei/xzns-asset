function ActivityDispatchAwardShowPanel:RefreshdajiangItem(index,obj)
    local data=self.dajiangList[index+1]
    local tb=_G.GetAutoGoTable(obj)
    tb.aortext_round.text=_G.GetLangPackValue(self.taskDes or 90033400076,data.target)
    tb.obj_item:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
            data.award.type,
            tb.obj_item,
            function(tran)
                tran.gameObject:SetLocalScaleXYZ(0.95)
                if data.award.type[2] > 1 then
                    tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                else
                    tran:ShowNumText(false)
                end
                tran:SetGou(self.activityCls:CheckIsGet(data.sid))
                if tran.ShowEffectOrder and tran.cfg then
                    tran:ShowEffectOrder(tran.cfg.ef_item == 1 and true or false)
                end
            end
    )
end

function ActivityDispatchAwardShowPanel:SortDaJiangList()
    table.sort(self.dajiangList,function(a, b)
        return a.target<b.target
    end)
end
