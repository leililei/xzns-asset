function ActiveDisRewardItem:ClearRewardNode()
    local parent = self:PropParentNode()
    local childCount = parent:GetChildCountE()
    if childCount > 0 then
        for i = 1, childCount do
            local obj = parent:GetChildE(i - 1)
            if obj ~= nil then
                DestroyObject(obj)
            end
        end
    end
end

