---@param data system_rank_cfg|arena_rank_cfg
function ActiveDisRewardItem:RefreshItem(data,index)
    self.data = data
    self.index = index

    if index <= 3 then
        self.go_table.aortext_ranking.text = GetLangPackValue(90022100031,index)
    else
        self.go_table.aortext_ranking.text = GetLangPackValue(90022100031,string.format("%d~%d",data.min_rank,data.max_rank))
    end

    self:RefreshRewardNode()
end

function ActiveDisRewardItem:RefreshRewardNode()
    if self.isLoadIng then
        return
    end
    self.isLoadIng = true
    self.AsCount = 0
    self.AddCountComp = false
    local rewards = self:GetRewardList()
    local length = #rewards
    self:ClearRewardNode()
    for i = 1, length do
        self.AsCount = self.AsCount + 1
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
                rewards[i],
                self:PropParentNode(),
                function(tran)
                    if self.go_table == nil then
                        DestroyObject(tran)
                    end
                    self:SetRewardItem(tran)
                    self.AsCount = self.AsCount - 1
                    if self.AsCount == 0 and self.AddCountComp then
                        self.isLoadIng = false
                        GameUtil.ReBuildRTF(self:PropParentNode())
                    end
                end
        )
    end
    self.AddCountComp = true
end

