function DiscoveryRewardItem:LoopLoad(Index,maxIndex)
    local rewards = self.data.rewards[Index]
    local reward = {
        rewards[1],
        0,
        0
    }

    _G.StorageManager:GetInstance():GetItemBaseViewNew(
            reward,
            self.go_table.obj_Root,
            function(tran)
                if self.go_table == nil then
                    DestroyObject(tran)
                end
                tran.gameObject:SetLocalScaleXYZ(0.7)
                tran:ShowNumText(false)
                Index = Index + 1
                if Index <= maxIndex then
                    _G.DelayDo(0.1,function()
                        if self.go_table == nil then
                            DestroyObject(tran.gameObject)
                            return
                        end
                        self:LoopLoad(Index,maxIndex)
                    end)
                else
                    self.isLoadIng = false
                end
            end
    )
end



