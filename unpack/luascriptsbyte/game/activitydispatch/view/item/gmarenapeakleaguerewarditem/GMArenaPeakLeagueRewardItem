    self.go_table.aortext_rank.text = _G.GetLangPackValue(data.name)
    if data.rank_con > 0 then 
        self.go_table.aortext_condition.text = _G.GetLangPackValue(90049800052, data.min_score) .. _G.GetLangPackValue(90049800053, data.rank_con)
