local PersonalRankRewardItem = BaseClass("PersonalRankRewardItem",ActiveDisRewardItem)

---__init构造函数
---@protect
function PersonalRankRewardItem:__init(cardRoot)
    self.root = cardRoot
    self.go_table = GetAutoGoTable(self.root, handler(self, self.OnClickBtn))
    --self.go_table.scrollloophorizontal_reard:InitItemData(0,handlerbind(self, self.OnRefreshContent))
    self.go_table.looplist2_looplist:InitListView(0,handlerbind(self, self.OnRefreshLoopItem))

    if self.go_table.obj_SpecialRankNode then
        ---@type _obj_SpecialRankNode_GoTable
        self.SpecialRankNode = GetAutoGoTable(self.go_table.obj_SpecialRankNode)
    end
    ---@type UnityEngine.Transform[]
    self.propItemList = {}
    ---@type ItemViewBase[]|BaseAwardNewItem[]
    self.itemViewBaseList = {}
    self.isSetLoopNum = false
end

---@param data system_rank_cfg
function PersonalRankRewardItem:RefreshItem(data,index)
    self.data = data
    self.index = index

    RankUtils.SetRankItemBgIcon(self.go_table.aorimage_bg,index)
    if index <= 3 then
        --RankUtils.SetObj_SpecialRankNode(self.SpecialRankNode,index)
        self.go_table.aortext_rank.text = string.format("%d-%d",data.min_rank,data.max_rank)
    end
    if self.data.min_rank == self.data.max_rank then
        self.go_table.aortext_rank.text = GetLangPackValue(90022100031, data.min_rank)
    else
        self.go_table.aortext_rank.text = GetLangPackValue(90022100071, data.min_rank,data.max_rank)
    end
    GameUtil.ReBuildRTF(self.go_table.obj_nameNode)

    self:RefreshRewardNode()
end

