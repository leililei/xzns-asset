function PersonalRankRewardItem:RefreshRewardNode()
    local count = #self:GetRewardList()
    if count > 6 then
        self.go_table.looplist2_looplist:SetActiveE(1)
        self.go_table.obj_list2:SetActiveE(0)
        self.go_table.looplist2_looplist:SetListItemCount(count, true)
    else
        self.go_table.looplist2_looplist:SetActiveE(0)
        self.go_table.obj_list2:SetActiveE(1)
        GameUtil.SetChildCount(self.go_table.obj_autoNode, count,function(obj,index)
            obj:SetActiveE(1)
            local reward = self:GetRewardData(index)
            self:RefreshRewardItem(obj,reward)
        end)
    end
end

function PersonalRankRewardItem:RefreshRewardItem(parent,rewardData)
    local instanceID = parent:GetInstanceIDE()
    local item = self.itemViewBaseList[instanceID]
    if item == nil then
        parent:RemoveAllChildren() --立刻清除消耗性能
        --_G.StorageManager:GetInstance():GetItemBaseViewNew(rewardData,parent,handlerbind(self, self.PropLoadComp,instanceID))
        item = require("BaseAwardNewItem").New(parent,nil,nil,parent)
        self.itemViewBaseList[instanceID] = item
    end
    item:ShowWithID(rewardData,nil,handlerbind(self, self.PropLoadComp,instanceID))
end

function PersonalRankRewardItem:OnRefreshLoopItem(listView2, index)
    local obj = listView2:NewListViewItem("$_obj_ListItem")
    local instanceID = obj:GetInstanceIDE()
    local item = self.propItemList[instanceID]
    if item == nil then
        item = obj
        self.propItemList[instanceID] = item
    end
    local reward = self:GetRewardData(index + 1)
    self:RefreshRewardItem(obj,reward)
    return obj
end

function PersonalRankRewardItem:OnClickItem(reward)
    if self.go_table then
        require "CommonTipManager":GetInstance():OpenTip(
                self.go_table.gameObject,
                reward[1]
        )
    end
end

function PersonalRankRewardItem:OnRefreshContent(index,obj)
    local newIndex = index + 1
    local reward = self:GetRewardData(newIndex)
    local instanceID = obj:GetInstanceIDE()
    local tb = self.propItemList[instanceID]
    if tb == nil then
        tb = obj
        self.propItemList[instanceID] = tb
    end
    tb:RemoveAllChildren() --立刻清除消耗性能
    _G.StorageManager:GetInstance():GetItemBaseViewNew(reward,obj,handlerbind(self, self.PropLoadComp,instanceID))
end

