-------------------------------------------------------------------------region require赋值区

local BattleSongRankRewardView = require("BattleSongRankRewardView")
local RankUtils = require("RankUtils")

---@class ArenaGlobalRankRewardView : BattleSongRankRewardView 窗口
---@field private go_table PersonalRankFullView_GoTable GoTable
---@field private super BattleSongRankRewardView GoTable
local ArenaGlobalRankRewardView = _G.BaseClass("ArenaGlobalRankRewardView", BattleSongRankRewardView)

function ArenaGlobalRankRewardView:RefreshMyRankAndMilitaryMerit()
    self.go_table.aortext_rankTitle2.text = _G.GetLangPackValue(90033404034)
    self.selfNode.aortext_rankTip.text = _G.GetLangPackValue(90022100036)
    self.selfNode.aortext_rank.text = ""
    self.selfNode.obj_noRank:SetActiveE(0)
    local sRank, pRank = require("ArenaGlobalModel"):GetInstance():CheckCanRequestRank()
    if pRank then
        require("ArenaGlobalModel"):GetInstance():GetRankData(2, 1, _G.handler(self, self.OnGetRankDataEnd))
    else
        self:OnGetRankDataEnd({rank_num = 0})
    end

    self.selfNode.aortext_Military:SetActiveE(0)
    --self:RefreshRewardNode()
end

function ArenaGlobalRankRewardView:OnGetRankDataEnd(data)
    if data.rank_num == 0 then
        self.selfNode.aortext_rank:SetActiveE(0)
        self.selfNode.obj_noRank:SetActiveE(1)
        self.selfNode.aortext_rank.text = _G.GetLangPackValue(90022900040)
    else
        self.selfNode.aortext_rank:SetActiveE(1)
        self.selfNode.aortext_rank.text = data.rank_num
    end
    self.rank = data.rank_num
    ---@type table[]
    self.myRankReward = self:GetShowCfgRewardList(self:GetMyRankReward())
    if self.myRankReward == nil then
        self.rewardCount = 0
        self.selfNode.looplist2_reard:SetListItemCount(0, true)
        return
    end
    self.rewardCount = #self.myRankReward
    self.selfNode.looplist2_reard:SetListItemCount(self.rewardCount, true)
end

---@return arena_rank_cfg
function ArenaGlobalRankRewardView:GetMyRankReward()
    for i, v in ipairs(self.cfgs) do
        if v.min_rank <= self.rank and v.max_rank >= self.rank then
            return v
        end
    end
    return nil
end

---@return ArenaGlobalRankRewardView
return ArenaGlobalRankRewardView
