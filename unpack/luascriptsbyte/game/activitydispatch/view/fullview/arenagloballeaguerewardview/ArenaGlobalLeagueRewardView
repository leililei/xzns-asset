local RankUtils = require("RankUtils")

local base = require("BattleSongRankRewardView")

---@class ArenaGlobalLeagueRewardView : BattleSongRankRewardView 窗口
---@field private go_table PersonalRankFullView_GoTable GoTable
---@field private super BattleSongRankRewardView GoTable
local ArenaGlobalLeagueRewardView = _G.BaseClass("ArenaGlobalLeagueRewardView", base)

function ArenaGlobalLeagueRewardView:InitCfgData()
    self.selfNode = _G.GetAutoGoTable(self.go_table.obj_selfNode)
    self.selfNode.looplist2_reard:InitListView(0, _G.handler(self, self.OnRefreshRewardList))
    self.cfgs = {}
    for _, v in pairs(_G.ConfigManager.arena_global_league_cfg) do
        _G.table.insert(self.cfgs, v)
    end
    _G.SortList(
        self.cfgs,
        function(a)
            return a.base_score, -a.id
        end
    )
    self.go_table.aortext_rankTitle2.text = _G.GetLangPackValue(90033404035)
end

function ArenaGlobalLeagueRewardView:OnRefreshContent(listView2, index)
    local newIndex = index + 1
    local cfg = self.cfgs[newIndex]
    local itemName = "$_obj_RewardItem"
    local item = listView2:NewListViewItem(itemName)
    ---@type ActiveDisRewardItem
    local itemLua = self.ItemLua.New(item, _G.handler(self, self.GetCall))
    itemLua:RefreshItem(cfg, newIndex)
    -- _G.GameUtil.ReBuildRTF(item)
    return item
end

function ArenaGlobalLeagueRewardView:RefreshMyRankAndMilitaryMerit()
    self.selfNode.aortext_Military:SetActiveE(0)
    local cfg = require("ArenaGlobalModel"):GetInstance():GetCurDanCfg()
    self.selfNode.aortext_rankTip.text = _G.GetLangPackValue(90023300074)
    self.selfNode.aortext_rank.text = _G.GetLangPackValue(cfg.name)
    self.selfNode.aortext_rank.color = _G.ColorTools.FormatColorByString(cfg.color)
    self.selfNode.aorrawimage_rankIcon:LoadImage(
        cfg.rank,
        function()
            if self.go_table == nil then
                return
            end
            self.selfNode.aorrawimage_rankIcon:SetNativeSize()
        end
    )
    -- self.selfNode.obj_noRank:SetActiveE(1)

    self.myRankReward = cfg.layer_rewards
    if self.myRankReward == nil then
        self.rewardCount = 0
        self.selfNode.looplist2_reard:SetListItemCount(0, true)
        return
    end
    self.rewardCount = #self.myRankReward
    self.selfNode.looplist2_reard:SetListItemCount(self.rewardCount, true)
end

return ArenaGlobalLeagueRewardView
