local ActivityDispatchModel = require("ActivityDispatchModel")
---@class WinnerLoserRewardFullView : UIBaseView    中文描述
---@field public go_table WinnerLoserRewardFullView_GoTable GoTable
local WinnerLoserRewardFullView = _G.BaseClass("WinnerLoserRewardFullView", require("RewardPreviewBaseView"))

function WinnerLoserRewardFullView:InitCfgData()
    self.campItems = {}
    self.winReward = _G.ConfigManager.discrete_cfg[125208]
    self.loseReward = _G.ConfigManager.discrete_cfg[125209]
    self.go_table.looplist2_reard:InitListView(#self.winReward, handlerbind(self, self.OnRefreshContent, 1))
    self.go_table.looplist2_reard2:InitListView(#self.loseReward, handlerbind(self, self.OnRefreshContent, 2))
end

function WinnerLoserRewardFullView:OnRefreshContent(listView2, index, type)
    ---@type UnityEngine.Transform
    local item = listView2:NewListViewItem("$_obj_ListItem")
    local newIndex = index + 1
    local reward = type == 1 and self.winReward[newIndex] or self.loseReward[newIndex]
    item:RemoveAllChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        reward,
        item,
        function(tran)
            if self.go_table == nil then
                _G.DestroyObject(tran)
            end
            tran.gameObject:SetLocalScaleXYZ(0.8)
            tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
        end
    )
    _G.GameUtil.ReBuildRTF(item)
    return item
end

function WinnerLoserRewardFullView:RefreshVIew()
    local campInfo = ActivityDispatchModel:GetInstance():GetCampInfo()
    local curCamp = ActivityDispatchModel:GetInstance():GetCampType()
    local camptype = campInfo[1].faction_score > campInfo[2].faction_score and 1 or 2
    for i = 1, 2 do
        if self.campItems[i] == nil then
            self.campItems[i] = _G.GetAutoGoTable(self.go_table["obj_camp" .. i])
            local city_style_id = _G.ConfigManager.discrete_cfg[125224][1][i]
            local cfg = require "CardCommentManager":GetInstance():CardData(city_style_id, false)
            self:LoadRoleModel(cfg, i)
        end
        local goTable = self.campItems[i]
        local data = campInfo[i]
        goTable.aortext_score.text = _G.GetLangPackValue(90033400042) .. _G.GameUtil.NumberToUnitStrFight(data.faction_score)
        local scale = (camptype == i or campInfo[camptype].faction_score == 0) and 1 or campInfo[i].faction_score / campInfo[camptype].faction_score
        goTable.aorimage_camp:SetLocalScaleXYZ(scale, 1, 1)
        goTable.obj_tag:SetActiveE(curCamp == i and 1 or 0)
    end
    self.go_table.obj_tag1:SetActiveE(curCamp == camptype and 1 or 0)
    self.go_table.obj_tag2:SetActiveE(curCamp == camptype and 0 or 1)
end

---加载单个角色
---@param view table 视图
---@param rolepath string 模型路径
---@param posIndex number 摆放的位置
function WinnerLoserRewardFullView:LoadRoleModel(cfg, posIndex)
    if cfg then
        _G.PoolsManager:GetInstance():Spawn(
            cfg.ModelPathHi,
            _G.ePoolType.Temporary,
            nil,
            function(trans)
                if trans == nil then
                    if _G.AppSetting.DEBUG then
                        _G.LogError("角色无法加载 path:" .. cfg.ModelPathHi .. "    CardInfoView LoadRoleScene")
                    end
                    return
                end
                if self.go_table == nil then
                    _G.DestroyObject(trans)
                    return
                end
                trans:SetParentE(self.campItems[posIndex].obj_root)
                trans:SetLocalPosition(0, 0, 0)
                trans:SetLocalScaleXYZ(cfg.size4)
            end
        )
    end
end

return WinnerLoserRewardFullView