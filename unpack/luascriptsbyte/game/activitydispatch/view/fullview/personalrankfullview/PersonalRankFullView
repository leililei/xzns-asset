local RewardPreviewBaseView = require("RewardPreviewBaseView")
local RankUtils = require("RankUtils")

---@class PersonalRankFullView:RewardPreviewBaseView 奖励预览全屏界面 (个人和联盟通用)
---@field private go_table PersonalRankFullView_GoTable GoTable
---@field private super RewardPreviewBaseView
local PersonalRankFullView = BaseClass("PersonalRankFullView", RewardPreviewBaseView)

function PersonalRankFullView:InitCfgData()
    self.loopItemBuffer = {}
    self.loopItemLuaBuffer = {}
    PersonalRankFullView.super.InitCfgData(self)
    ---@type PersonalRankFullView._obj_selfNode_GoTable
    self.selfNode = GetAutoGoTable(self.go_table.obj_selfNode)

    self.go_table.obj_selfRoot:SetActiveE(self.data.isShowPlayRankNode)
    if self.data.isShowPlayRankNode == 0 then
        self.go_table.rect_rankList:SetRectTransformOffset(2, 200.5, 2, -207.8)
    else
        --self.go_table.scrollloopvectical_rankList:SetRectTransformSize(720,207)
    end
    if self.data.myRank == 0 and self.data.RankType ~= nil and self.data.isShowPlayRankNode == 1 then
        local model = require("RecordRankModel"):GetInstance()
        model:GetListInfo(self.data.RankType, function()
            ---@type ArchaeoIntegralRankData
            local CurRankData = model:GetRankData(self.data.RankType)
            self.data.myRank = CurRankData:GetMyRank()
            self.data.myRrankValue = CurRankData:GetMyIntegral()
            self:RefreshMyRankAndMilitaryMerit()
        end)
        --RankUtils.GetMyRank(self.data.RankType,function(data)
        --    self.data.myRank = data.index
        --    self.data.myRrankValue = data.value
        --    self:RefreshMyRankAndMilitaryMerit()
        --end)
    end
    if self.data.id == 11 then
        self.go_table.aortext_rankTitle2.text = _G.GetLangPackValue(90033400127)
    elseif self.data.id == 12 then
        self.go_table.aortext_rankTitle2.text = _G.GetLangPackValue(90033400128)
    elseif self.data.id == 20 then
        self.go_table.aortext_rankTitle2.text = _G.GetLangPackValue(90049900032)
    end
end

function PersonalRankFullView:RefreshVIew()
    if self.cfgs == nil then
        return
    end
    self:RefreshLoopList()
    if self.data.myRank == 0 and self.data.RankType ~= nil and self.data.isShowPlayRankNode == 1 then
    else
        self:RefreshMyRankAndMilitaryMerit()
    end
end

function PersonalRankFullView:InitLoopList()
    self.go_table.looplist2_rankList:InitListView(0, _G.handler(self, self.OnRefreshContent))
end

function PersonalRankFullView:OnRefreshContent(listView2, index)
    local newIndex = index + 1
    local cfg = self.cfgs[newIndex]
    local reward_appearance = cfg.reward_appearance
    local itemName = "$_obj_RewardItem2"
    if reward_appearance and reward_appearance[1] and reward_appearance[1][1] == 13 then
        --是有称号的奖励
        itemName = "$_obj_RewardItem"
    end

    local obj = listView2:NewListViewItem(itemName)
    local id = obj:GetInstanceIDE()
    local item = self.loopItemBuffer[id]
    ---@type ActiveDisRewardItem
    local ItemLua = self.loopItemLuaBuffer[id]
    if item == nil then
        item = obj
        self.loopItemBuffer[id] = item
        ItemLua = self.ItemLua.New(obj, _G.handler(self, self.GetCall))
        ---@type ActiveDisRewardItem[]
        self.loopItemLuaBuffer[id] = ItemLua
    end
    ItemLua:RefreshItem(cfg, newIndex)
    return item
end

function PersonalRankFullView:RefreshLoopList()
    self.go_table.looplist2_rankList:SetListItemCount(#self.cfgs)
end

function PersonalRankFullView:RefreshMyRankAndMilitaryMerit()
    if self.data == nil or self.data.myRank == nil or self.data.myRank == 0 then
        self.selfNode.aortext_rank:SetActiveE(0)
        self.selfNode.obj_noRank:SetActiveE(1)
        return
    end
    self.selfNode.aortext_rank:SetActiveE(1)
    self.selfNode.obj_noRank:SetActiveE(0)

    self.selfNode.aortext_rank.text = self.data.myRank
    self.selfNode.aortext_Military.text = GetLangPackValue(self.data.myRankValueStr, self.data.myRrankValue)
end

---@return PersonalRankFullView
return PersonalRankFullView