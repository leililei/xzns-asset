local RankUtils = require("RankUtils")

local base = require("BattleSongRankRewardView")

---@class GMArenaPeakLeagueRewardView : BattleSongRankRewardView 窗口
---@field private go_table PersonalRankFullView_GoTable GoTable
---@field private super BattleSongRankRewardView GoTable
local GMArenaPeakLeagueRewardView = _G.BaseClass("GMArenaPeakLeagueRewardView", base)

function GMArenaPeakLeagueRewardView:InitCfgData()
    self.loopItemBuffer = {}
    self.loopItemLuaBuffer = {}
    self.selfNode = _G.GetAutoGoTable(self.go_table.obj_selfNode)
    self.selfNode.looplist2_reard:InitListView(0, _G.handler(self, self.OnRefreshRewardList))
    self.cfgs = {}
    for _, v in pairs(_G.ConfigManager.arena_peak_league_cfg) do
        _G.table.insert(self.cfgs, v)
    end
    _G.SortList(
        self.cfgs,
        function(a)
            return a.min_score, -a.id
        end
    )
    self.go_table.aortext_rankTitle2.text = _G.GetLangPackValue(90049800037)
end

function GMArenaPeakLeagueRewardView:OnRefreshContent(listView2, index)
    local newIndex = index + 1
    local cfg = self.cfgs[newIndex]
    local reward_appearance = cfg.reward_appearance
    local itemName = "$_obj_RewardItem"

    local obj = listView2:NewListViewItem(itemName)
    local id = obj:GetInstanceIDE()
    local item = self.loopItemBuffer[id]
    ---@type ActiveDisRewardItem
    local ItemLua = self.loopItemLuaBuffer[id]
    if item == nil then
        item = obj
        self.loopItemBuffer[id] = item
        ItemLua = self.ItemLua.New(obj, _G.handler(self, self.GetCall))
        ---@type ActiveDisRewardItem[]
        self.loopItemLuaBuffer[id] = ItemLua
    end
    ItemLua:RefreshItem(cfg, newIndex)
    return item
end

function GMArenaPeakLeagueRewardView:RefreshMyRankAndMilitaryMerit()
    self.selfNode.aortext_Military:SetActiveE(0)
    local cfg = require("GMArenaPeakModel"):GetInstance():GetCurDanCfg()
    self.selfNode.aortext_rankTip.text = _G.GetLangPackValue(90023300074)
    self.selfNode.aortext_rank.text = _G.GetLangPackValue(cfg.name)
    --self.selfNode.aortext_rank.color = _G.ColorTools.FormatColorByString(cfg.color)
    self.selfNode.aorrawimage_rankIcon:LoadImage(
        cfg.icon,
        function()
            if self.go_table == nil then
                return
            end
            self.selfNode.aorrawimage_rankIcon:SetNativeSize()
        end
    )
    -- self.selfNode.obj_noRank:SetActiveE(1)

    self.myRankReward = require("GMArenaPeakModel"):GetInstance():GetCurAndNextDanAward()
    if self.myRankReward == nil then
        self.rewardCount = 0
        self.selfNode.looplist2_reard:SetListItemCount(0, true)
        return
    end
    self.myRankReward = _G.table.reverseTable(self.myRankReward)
    self.rewardCount = #self.myRankReward
    self.selfNode.looplist2_reard:SetListItemCount(self.rewardCount, true)
end

return GMArenaPeakLeagueRewardView
