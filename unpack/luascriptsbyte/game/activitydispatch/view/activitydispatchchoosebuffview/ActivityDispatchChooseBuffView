local ActivityDispatchModel = require("ActivityDispatchModel")
local QiwuView = require "QiwuView"
---@class ActivityDispatchChooseBuffView : UIBaseView    中文描述
---@field public go_table ActivityDispatchChooseBuffView_GoTable GoTable
local ActivityDispatchChooseBuffView = _G.BaseClass("ActivityDispatchChooseBuffView", _G.UIBaseView)

---构造函数
---@protected
function ActivityDispatchChooseBuffView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ActivityDispatchChooseBuffView:OnCreate()
    self.activity = ActivityDispatchModel:GetInstance():GetActivity()
    self.activityID = self.activity.activityID
    self.ItemList = {}
    self.buffs = ActivityDispatchModel:GetInstance():GetBuffInfo()
    self:InitView()
    local resources = _G.ConfigManager.ui_cfg.ActivityDispatchChooseBuffView.resources
    if #resources > 0 then
        self:AddComponent(
            self.go_table.obj_goldInfo,
            require("ResourceCompont").New(self.go_table.obj_goldInfo, resources)
        )
    end
end

function ActivityDispatchChooseBuffView:InitView()
    self.items_qiwu = {}
    self.animators_qiwu = {}
    for index = 1, 3 do
        local data = self.buffs[index]
        if self.ItemList[index] == nil then
            self.ItemList[index] = _G.GetAutoGoTable(self.go_table["obj_item" .. index], _G.handlerbind(self, self.OnClickItemBtn, index))
            ---@type mementos_cfg
            local cfg = _G.ConfigManager.mementos_cfg[data.key]
            self.ItemList[index].aorrawimage_buffIcon:LoadImage(cfg.icon)
            self.ItemList[index].aortext_des.text = _G.GetLangPackValue(cfg.desc)
            self.ItemList[index].aortext_cost:SetActiveE(data.value == 0 and 0 or 1)
            local count = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.ResProp, _G.ResPropID.Diamond)
            self.ItemList[index].aortext_cost.text = count >= data.value and data.value or string.format("<color=#c02214>%s</color>", data.value)
            self.ItemList[index].aortext_buy.text = data.value == 0 and _G.GetLangPackValue(90021600022) or _G.GetLangPackValue(90028300135)
        end
    end
end

function ActivityDispatchChooseBuffView:OnClickItemBtn(_, _, index)
    ActivityDispatchModel:GetInstance():ChooseBuff(index, function(msg)
        if msg.ack ~= 1 then
            return
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityDispatchBattleView.Name)
        self:Close()
    end)
end

---界面的销毁函数
function ActivityDispatchChooseBuffView:OnDestroy()
end

---按钮点击事件在这里派发
function ActivityDispatchChooseBuffView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end

return ActivityDispatchChooseBuffView