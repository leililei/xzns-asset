local ActivityDispatchModel = require("ActivityDispatchModel")
---@class ActivityDispatchCampPlayerView : UIBaseView    中文描述
---@field public go_table ActivityDispatchCampPlayerView_GoTable GoTable
local ActivityDispatchCampPlayerView = _G.BaseClass("ActivityDispatchCampPlayerView", _G.UIBaseView)

local IconName = {
    [1] = "0ui_icon_diyi",
    [2] = "0ui_icon_dier",
    [3] = "0ui_icon_disan",
}

local Gradient = {
    [1] = { "FFCB28", "ffffff", "110802" },
    [2] = { "E930FF", "ffffff", "110802" },
    [3] = { "1F7296", "ffffff", "110802" },
}

---构造函数
---@protected
function ActivityDispatchCampPlayerView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ActivityDispatchCampPlayerView:OnCreate()
    self.activity = ActivityDispatchModel:GetInstance():GetActivity()
    self.activityID = self.activity.activityID
    self.dataList = {}
    if self.BtnNodeList == nil then
        self.BtnNodeList = {}
        for i = 1, 2 do
            self.BtnNodeList[i] = _G.GetAutoGoTable(self.go_table["aorbtn_tag" .. i], _G.handlerbind(self, self.SetTag, i))
        end
    end
    self.go_table.aortext_des.text = _G.GetLangPackValue(90033400051)
    self:SetTag(nil, nil, 1)
end

function ActivityDispatchCampPlayerView:SetTag(_, _, index)
    self.curIndex = index
    self:RefreshTagBtn()
    self:SetView()
end

function ActivityDispatchCampPlayerView:RefreshTagBtn()
    for k, item in pairs(self.BtnNodeList) do
        item.aorimage_red:SetActiveE(k == self.curIndex and 1 or 0)
        item.aorimage_black:SetActiveE(k == self.curIndex and 0 or 1)
    end
end

function ActivityDispatchCampPlayerView:SetView()
    self.go_table.obj_baseWindow:SetActiveE(self.curIndex == 1 and 1 or 0)
    self.go_table.obj_sociatyWindow:SetActiveE(self.curIndex == 2 and 1 or 0)
    if self.dataList[self.curIndex] == nil then
        if self.curIndex == 1 then
            require("ActivityDispatchNet"):GetInstance():GetRank(
                { activity_id = self.activityID },
                function(data)
                    self.dataList[self.curIndex] = data
                    self:Show(data)
                end
            )
        else
            require("ActivityDispatchNet"):GetInstance():GetSociatyRank(
                { page = 1 },
                function(data)
                    self.dataList[self.curIndex] = data
                    if not self.SociatyRankView then
                        self.SociatyRankView = self:AddComponent(self.go_table.obj_sociatyWindow, require "ActivityDispatchCampSociatyView".New(data))
                    end
                end
            )
        end
    end
end

function ActivityDispatchCampPlayerView:Show(data)
    self.ItemList = {}
    self.Ranks = data.role_info or {}
    _G.table.sort(self.Ranks, function(a, b)
        return a.power > b.power
    end)
    local len = #self.Ranks
    self.go_table.scrollloopvectical_memberList:InitItemData(len, _G.handler(self, self.OnRefreshLoopListItem))
    self:SetSelfInfo()
end

function ActivityDispatchCampPlayerView:SetSelfInfo()
    if self.selfRank == nil then
        self.selfRank = _G.GetAutoGoTable(self.go_table.obj_selfRank)
    end
    local selfRankNum = 100000
    local power = _G.PlayerModel:GetInstance():GetCorePower()
    if power == nil or power == 0 then
        power = _G.StorageManager:GetInstance():GetPlayerPower()
    end
    local uid = _G.PlayerModel:GetInstance():GetPlayerUid()
    for k, v in ipairs(self.Ranks) do
        if v.uid == uid then
            selfRankNum = k
            power = v.power
            break
        end
    end
    if selfRankNum == 100000 then
        for k, v in ipairs(self.Ranks) do
            if v.power < power then
                selfRankNum = k
                power = v.power
                break
            end
        end
    end
    if selfRankNum == 100000 and #self.Ranks < _G.ConfigManager.discrete_cfg[125210][1][1] then
        selfRankNum = #self.Ranks + 1
    end
    self.selfRank.aortext_name.text = _G.PlayerModel:GetInstance():GetName()
    self.selfRank.aortext_desc.text = _G.GameUtil.NumberToUnitStr(power)
    if selfRankNum ~= 100000 then
        self.selfRank.aortext_rank.text = selfRankNum
    end
    self.selfRank.aortext_rank:SetActiveE(selfRankNum == 100000 and 0 or 1)
    self.selfRank.aortext_nil:SetActiveE(selfRankNum == 100000 and 1 or 0)
    _G.UIUtils.SetPlayerHeadItemNew(self.selfRank.obj_head, _G.PlayerModel:GetInstance():GetIRroleTable(), 1, true, true, true)
end

function ActivityDispatchCampPlayerView:OnRefreshLoopListItem(i, item)
    if i < 0 then
        return
    end

    local eIndex = i + 1
    local id = item:GetInstanceIDE()
    local ctrl = self.ItemList[id]
    if not ctrl then
        ctrl = _G.GetAutoGoTable(item)
        self.ItemList[id] = ctrl
    end
    ctrl.index = eIndex
    local data = self.Ranks[eIndex]
    if data then
        ctrl.aortext_name.text = data.name
        ctrl.aorimage_rankBg:SetActiveE(eIndex <= 3 and 1 or 0)
        ctrl.aortext_Rank:SetActiveE(eIndex <= 3 and 1 or 0)
        ctrl.aortext_rank:SetActiveE(eIndex <= 3 and 0 or 1)
        self:SetItemRankInfo(ctrl, eIndex)
        if eIndex <= 3 then
            ctrl.aorimage_bg:SetActiveE(1)
            ctrl.aorimage_bg.SpriteName = "ui_diban" .. eIndex
        else
            ctrl.aorimage_bg:SetActiveE(0)
        end
        ctrl.aortext_desc.text = _G.GameUtil.NumberToUnitStrFight(data.power)
        _G.UIUtils.SetPlayerHeadItemNew(ctrl.obj_head, data, 1, true, true, true)
    end
    return item
end

function ActivityDispatchCampPlayerView:SetItemRankInfo(go, index)
    local ctrl = go
    local eIndex = index
    if eIndex <= 3 then
        ctrl.aorimage_rankBg.SpriteName = IconName[eIndex]

        ctrl.aortext_Rank.text = eIndex
        local gradient = ctrl.aortext_Rank:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient))
        local c1 = _G.ColorTools.FormatColorByString(Gradient[eIndex][1])
        local c2 = _G.ColorTools.FormatColorByString(Gradient[eIndex][2])
        local color1 = _G.CS.UnityEngine.GradientColorKey()
        local color2 = _G.CS.UnityEngine.GradientColorKey()
        color1.color = c1
        color1.time = 1
        color2.color = c2
        color2.time = 0

        local alpha1 = _G.CS.UnityEngine.GradientAlphaKey()
        local alpha2 = _G.CS.UnityEngine.GradientAlphaKey()

        alpha1.alpha = 255
        alpha1.time = 1
        alpha2.alpha = 255
        alpha2.time = 0

        gradient:GetGradient():SetKeys({ color1, color2 }, { alpha1, alpha2 })
    elseif eIndex == 100000 then
        ctrl.aortext_rank.text = _G.ConfigManager.language_package_cfg[90022900040]
    else
        ctrl.aortext_rank.text = eIndex
    end
end

---界面的销毁函数
function ActivityDispatchCampPlayerView:OnDestroy()
end

---按钮点击事件在这里派发
function ActivityDispatchCampPlayerView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Close or go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.aorbtn_log1 then
        self:SetTag(go, isOn, 1)
    elseif go == self.go_table.aorbtn_log2 then
        self:SetTag(go, isOn, 2)
    end
end

return ActivityDispatchCampPlayerView