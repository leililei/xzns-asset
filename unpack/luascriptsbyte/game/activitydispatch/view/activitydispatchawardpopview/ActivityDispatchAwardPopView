local ActivityDispatchModel = require("ActivityDispatchModel")
local RankUtils = require("RankUtils")
---@class ActivityDispatchAwardPopView : UIBaseView    中文描述
---@field public go_table ActivityDispatchAwardPopView_GoTable GoTable
local ActivityDispatchAwardPopView = _G.BaseClass("ActivityDispatchAwardPopView", _G.UIBaseView)

---构造函数
---@protected
function ActivityDispatchAwardPopView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.CurSelectRankType = 96
end

---界面的入口函数
function ActivityDispatchAwardPopView:OnCreate()
    self.activity = ActivityDispatchModel:GetInstance():GetActivity()
    self.isGet = ActivityDispatchModel:GetInstance():GetEasterEgg()
    self.Time = self.activity.cfg.time.start_time + self.activity.cfg.time.run_time + self.activity.cfg.time.get_time - _G.TimeUtil.GetServerUnixTime()

    if self.Time > 0 then
        self.Timer = _G.TimerManager:GetInstance():GetTimer(1, self.OnTimeRemaining, self, false)
        self.Timer:Start()
    end
    self:OnTimeRemaining(0)

    self:InitEffct()
    self:InitView()
    self:UpdateIcon()
end

function ActivityDispatchAwardPopView:UpdateIcon()
    local icon
    if self.isGet == false then
        icon = "ImagesH5/nAFK/ui_box1"
    else
        icon = "ImagesH5/hSociatyMaze/ui_box2"
    end
    self.go_table.aorrawimage_box:LoadImage(icon)
    self.go_table.obj_redpoint:SetActiveE(self.isGet == false and 1 or 0)
end

function ActivityDispatchAwardPopView:OnTimeRemaining(elapsed)
    self.Time = self.Time - elapsed
    if self.Time > 0 then
        local t = _G.TimeUtil.TranslateSecond(self.Time)
        self.go_table.aortext_time.text = _G.GetLangPackValue(90033500133, t.day, t.hour, t.min)
    else
        self:Close()
    end
end

function ActivityDispatchAwardPopView:InitEffct()
    local tbOur = _G.GetAutoGoTable(self.go_table.obj_fameHallOur)

    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_SociatyMobaGuessView_our,
        tbOur.obj_ourEff,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
        end
    )
end

function ActivityDispatchAwardPopView:InitView()
    self.model = require("RecordRankModel"):GetInstance()
    self.model:GetListInfo(self.CurSelectRankType, function()
        self.CurRankData = self.model:GetRankData(self.CurSelectRankType)
        self:InitFameHall()
    end)
end

---名人堂
---@param msg guild.s2c_other_guild_pos_info
function ActivityDispatchAwardPopView:InitFameHall()
    local tb = _G.GetAutoGoTable(self.go_table.obj_fameHallOur)
    local name = self.CurRankData.listRankDatas[1].playData.name
    tb.aortext_sociatyName.text = name
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase,
        RankUtils.i_record_rankToi_role(self.CurRankData.listRankDatas[1].playData)
    , 0.7, true, true, true)
    self.go_table.aortext_tip.text = _G.GetLangPackValue(90033406002, name)
    --tb.aorrawimage_icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[msg.banner].portrait)
    for i = 1, 5 do
        local data = self.CurRankData.listRankDatas[i]
        tb["obj_player" .. i]:SetActiveE(data ~= nil and 1 or 0)
        if data ~= nil then
            self:CreateRole(tb["obj_player" .. i], self.CurRankData.listRankDatas[i].playData)
        end
    end
end

function ActivityDispatchAwardPopView:CreateRole(obj, role)
    if role then
        ---@type _obj_fameHallOur._obj_player1_GoTable
        local playerTb = _G.GetAutoGoTable(obj)
        local pos = role.pos
        playerTb.aortext_name.text = role.name
        playerTb.aortext_power.text = _G.GameUtil.NumberToUnitWord(role.power)
        --playerTb.aorimage_official.SpriteName = officialBg[pos]
        --playerTb.aortext_offName.text = _G.GetLangPackValue(_G.ConfigManager.guild_position_cfg[pos].name)
        --playerTb.aortext_offName.color = officialColor[pos]
        --playerTb.aortext_offName:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = officialOutlineColor[1]
        local cfg = require("CardInfoManager").GetCardSkin_ShowCfg(nil, role.city_style_id)
        local path = _G.UIUtils.GetBattleSpine(cfg, _G.UseBattleSpine.RankView)
        _G.PoolsManager:GetInstance():Spawn(
            path,
            _G.ePoolType.Temporary,
            playerTb.obj_spine,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                end
                trans:SetLocalScaleXYZ(cfg.size2)
                if not table.isEmptyOrNil(role.artifact_skin) then
                    _G.UIUtils.LoadArtifacteffect(trans,nil,role.artifact_skin[1],role.artifact_skin[2])
                end
            end
        )
    else
        obj:SetActiveE(0)
    end
end

---界面的销毁函数
function ActivityDispatchAwardPopView:OnDestroy()
end

---按钮点击事件在这里派发
function ActivityDispatchAwardPopView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_AwardBox then
        if self.isGet == true then
            return
        end
        ActivityDispatchModel:GetInstance():GetEasterEggAward(function()
            self.isGet = ActivityDispatchModel:GetInstance():GetEasterEgg()
            self:UpdateIcon()
        end)
    end
end

function ActivityDispatchAwardPopView:OnStartClose()
    if self.Timer then
        self.Timer:Stop()
        self.Timer = nil
    end
end

return ActivityDispatchAwardPopView