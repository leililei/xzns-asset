local ActivitySynManager = require "ActivitySynManager"
local RankUtils = require("RankUtils")
local ActivityDispatchModel = require("ActivityDispatchModel")
---@class ActivityDispatchSignUpView : UIBaseView    中文描述
---@field public go_table ActivityDispatchSignUpView_GoTable GoTable
local ActivityDispatchSignUpView = _G.BaseClass("ActivityDispatchSignUpView", _G.UIBaseView)
local headScale = {
    [1] = 0.8,
    [2] = 0.74,
    [3] = 0.74,
    [4] = 0.68,
    [5] = 0.68
}

local index = {
    [1] = 4,
    [2] = 2,
    [3] = 1,
    [4] = 3,
    [5] = 5
}

local index2 = {
    [1] = 1,
    [2] = 3,
    [3] = 5,
    [4] = 4,
    [5] = 2
}

local viewName = {
    [2] = _G.ConfigManager.ui_cfg.RewardPreviewFullView.Name,
    [3] = _G.ConfigManager.ui_cfg.ExchangeShopView.Name
}

---构造函数
---@protected
function ActivityDispatchSignUpView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.headIndex = 0
    self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpen, self)
    self:AddListener(_G.AnimationEvents.ActivityDispatchSignUp, self.PlayAnimation, self)
    self:AddListener(_G.eActivityDispatch.StageChange, self.SetStageInfo)
    self:AddListener(_G.eActivityDispatch.ShareChat, self.SetShareInfo)
end

---界面的入口函数
function ActivityDispatchSignUpView:OnCreate()
    self.activity = ActivityDispatchModel:GetInstance():GetActivity()
    self.activityID = self.activity.activityID

    self.campItems = {}
    self.headItem = {}
    self.toggles = {}
    self.views = { [1] = { gameObject = self.go_table.obj_root } }
    for i = 1, 3 do
        self.toggles[i] = _G.GetAutoGoTable(self.go_table["toggle_tag" .. i], _G.handlerbind(self, self.OnClickToggle, i))
    end
    UIUtils.IsNeedChangeUI(IsNeedChangeUI.ActivityDispatchSignUpViewToggle,self.toggles[3])
    self.stage, self.stageEndTime = ActivityDispatchModel:GetInstance():GetStateInfo()
    self:SetTimeTxt()
    --兑换
    self.activityExchange = ActivitySynManager:GetInstance():GetChildAcitivity(10005, self.activity:GetJumpType(self.activityID))
    self:InitActivityTime()
    self:InitCampView()
    --播弹幕
    --self.go_table.obj_redpointAward:UpdateRedPointItemIDAndParam(self.activity:GetActivityTypeCls():GetRedpointIDByIndex(2))
    self.toggles[2].obj_redpoint:UpdateRedPointItemIDAndParam(self.activity:GetActivityTypeCls():GetRedpointIDByIndex(2))
    self.go_table.obj_redpointShare:UpdateRedPointItemIDAndParam(self.activity:GetActivityTypeCls():GetRedpointIDByIndex(3))
    self:OnClickToggle(nil, true, 1)
    self:SetTaskAward()
    self.go_table.obj_serverList:GetComponentE(_G.typeof(_G.CS.ExtendText)).text = string.format("<%s@1>", _G.GetLangPackValue(90033500130))
end

---
---@protected
function ActivityDispatchSignUpView:SetTimeTxt()
    if self.stage == 1 then
        self.endTime = self.stageEndTime
        self.timeTxt = 90033400125
    else
        self.endTime = self.activity.cfg.time.start_time + self.activity.cfg.time.run_time
        self.timeTxt = 90000011689
    end
    local img
    if self.stage == 4 then
        img = "ui_zgzf_txt_jsq"
    elseif self.stage == 1 then
        img = "ui_zgzf_txt_bzq"
    else
        img = "ui_zgzf_txt_tzq"
    end
    self.go_table.aorimage_title2.SpriteName = img
end

function ActivityDispatchSignUpView:SetShareInfo()
    local shareNum, shareLimit = ActivityDispatchModel:GetInstance():GetShareInfo()
    self.go_table.aortext_shareNum.text = (shareLimit - shareNum) .. "/" .. shareLimit
end

---设置阶段信息
function ActivityDispatchSignUpView:SetStageInfo()
    self.stage, self.stageEndTime = ActivityDispatchModel:GetInstance():GetStateInfo()
    local enrollTime = ActivityDispatchModel:GetInstance():GetEnrollTime()
    if self.stage ~= 1 and enrollTime ~= 0 then
        ActivityDispatchModel:GetInstance():OpenView()
        self:Close()
    else
        self:SetTimeTxt()
    end
end

---监听Toggle点击事件
---@param key string
---@param callback function
function ActivityDispatchSignUpView:OnClickToggle(_, isOn, key)
    local tb = self.toggles[key]
    local view = self.views[key]
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    self.curToggle = key

    --节点显隐
    if view then
        view.gameObject:SetActiveE(isOn and 1 or 0)
    end

    if isOn then
        self:OpenView()
    end
end

function ActivityDispatchSignUpView:OpenView()
    local view = self.views[self.curToggle]
    if not view then
        self.openView = viewName[self.curToggle]
        if self.curToggle == 2 then
            --奖励
            local rankStr = RankUtils.RankStrDefault.MilitaryIndustry
            local model = require("ActivityDispatchModel"):GetInstance()
            local Scope = model:GetRankAwardCfgIdScope(96)
            local Scope2 = model:GetRankAwardCfgIdScope(97)
            local Scope3 = model:GetRankAwardCfgIdScope(98)
            -----@type RewardPreviewView.OpenData[]
            local OpenData = {
                RankUtils.GetData(11, 1, 1000, rankStr, nil, _G.ConfigManager.arena_rank_cfg, Scope.min, Scope.max, 0),
                RankUtils.GetData(12, 1, 1000, rankStr, nil, _G.ConfigManager.arena_rank_cfg, Scope2.min, Scope2.max, 0),
                --RankUtils.GetData(8, 1, 1000, rankStr, nil, _G.ConfigManager.arena_rank_cfg, Scope3.min, Scope3.max, 0),
            }
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RewardPreviewFullView.Name, OpenData, 1)

            ActivityDispatchModel:GetInstance():ChangeAwardShowRed()
        elseif self.curToggle == 3 then
            --兑换
            self.openView = self.activityExchange:GetActivityTypeCls():OnGetMainViewName()
            _G.GlobalInterface.JumpActivityByGM(10005, self.activity:GetJumpType(self.activityID))
        end
    end
end

function ActivityDispatchSignUpView:OnUIOpen(name)
    if name ~= self.openView then
        return
    end
    if name == _G.ConfigManager.ui_cfg.RewardPreviewFullView.Name then
        ActivityDispatchModel:GetInstance():ChangeAwardShowRed()
    end
    _G.UIManager:GetInstance():ChangeCanvasOrder(
        self.openView,
        self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 10
    )
    self.views[self.curToggle] = _G.UIManager:GetInstance():GetWindowCtrl(name)
    self.views[self.curToggle].transform:SetParentE(self.go_table.obj_windows)
    self.views[self.curToggle].transform:SetAsLastSiblingE()
end

---开始时间~结束时间  (日月)
function ActivityDispatchSignUpView:InitActivityTime()
    local starTime = self.activity.cfg.time.start_time
    local start = _G.TimeUtil.GetDateTime(starTime)
    local endt = _G.TimeUtil.GetDateTime(starTime + self.activity.cfg.time.run_time)
    local color = "<color=#96ce51>"
    if _G.AppSetting.IsXzns then
        color = "<color=#72ef9c>"
    end
    self.go_table.aortext_time.text = _G.GetLangPackValue(
        90025800003, color .. string.format("%s</color>", _G.GetLangPackValue(90032100011, start.month, start.day) .. " " .. string.format("%02d:%02d:%02d", start.hour, start.minute, start.second) .. "~" .. _G.GetLangPackValue(90032100011, endt.month, endt.day) .. " " .. string.format("%02d:%02d:%02d", endt.hour, endt.minute, endt.second)))
    self:UpdateTimer()
    if not self.timer2 then
        self.timer2 = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimer, self, false, false, true)
        self.timer2:Start()
    end
end

function ActivityDispatchSignUpView:UpdateTimer()
    local time = self.stageEndTime - _G.TimeUtil.GetServerUnixTime()
    if time <= 0 then
        self.timer2:Stop()
        self.timer2 = nil
        return
    end
    self.go_table.aortext_time2.text = _G.GetLangPackValue(self.timeTxt, _G.TimeUtil.TranslateSecondForStr(time))
end

---初始化界面
function ActivityDispatchSignUpView:InitCampView()
    local enrollTime = ActivityDispatchModel:GetInstance():GetEnrollTime()
    --for i = 1, 2 do
    local i = 1
    if self.campItems[i] == nil then
        self.campItems[i] = _G.GetAutoGoTable(self.go_table["obj_camp" .. i], _G.handlerbind(self, self.OnClickCampItem, i))
    end
    local goTable = self.campItems[i]
    goTable.aorbtn_embattle:SetActiveE(enrollTime == 0 and 0 or 1)
    goTable.aorbtn_embattle2:SetActiveE(enrollTime == 0 and 0 or 1)
    goTable.aorbtn_signUp:SetActiveE(enrollTime == 0 and 1 or 0)
    if self.roleList == nil then
        require("ActivityDispatchNet"):GetInstance():GetRank(
            { activity_id = self.activityID },
            function(data)
                self.roleList = data or {}
                if not _G.AppSetting.IsXzns then
                    goTable.obj_headParent:SetActiveE(data.role_info and 1 or 0)
                end
                --end
                self.isPlayAnimation = self.roleList and self.roleList.role_info and #self.roleList.role_info > 1
                if self.isPlayAnimation then
                    self.headIndex = #self.roleList.role_info - 2
                end
                self:SetHeadAnimation()
            end
        )
    end
    if enrollTime ~= 0 then
        goTable.obj_redpointEmbattle:UpdateRedPointItemIDAndParam(self.activity:GetActivityTypeCls():GetRedpointIDByIndex(6))
        self:SetShareInfo()
    end
    self.go_table.aorbtn_share:SetActiveE(0)
end

---累充任务大奖显示
function ActivityDispatchSignUpView:SetTaskAward()
    local itemData = ActivityDispatchModel:GetInstance():GetNextAward()
    if itemData then
        local target = ActivityDispatchModel:GetInstance():GetHisFightNum()
        if target > itemData.Cfg.count then
            target = itemData.Cfg.count
        end
        self.go_table.obj_taskAwardRoot:RemoveAllChildren()
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            itemData.Cfg.reward[1].type,
            self.go_table.obj_taskAwardRoot,
            function(tran)
                tran.gameObject:SetLocalScaleXYZ(0.7)
                if itemData.Cfg.reward[1].type[2] > 1 then
                    tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                else
                    tran:ShowNumText(false)
                end
                if tran.ShowEffectOrder and tran.cfg then
                    tran:ShowEffectOrder(tran.cfg.ef_item == 1 and true or false)
                end
            end
        )
        local w = target / itemData.Cfg.count
        if w > 1 then
            w = 1
        end
        if _G.AppSetting.IsXzns then
            self.go_table.aorimage_awardBar:SetRectTransformSize(target > 0 and w * (71) or 0, 15)
        else
            self.go_table.aorimage_awardBar:SetRectTransformSize(target > 0 and w * (87) or 0, 20)
        end
        self.go_table.aortext_taskAward.text = target .. "/" .. itemData.Cfg.count
    end
end

function ActivityDispatchSignUpView:SetHeadAnimation()
    self.headIndex = self.headIndex + 1
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    for k = 1, 1 do
        local data = self.roleList
        local goTable = self.campItems[k]
        if data.role_info ~= nil then
            for i = 1, 5 do
                local headIndex = self.isPlayAnimation == false and index2 or index
                local obj = goTable["obj_head" .. headIndex[i]]
                local j = i + self.headIndex - 1
                if j >= #data.role_info and self.isPlayAnimation == true then
                    j = j % #data.role_info
                    if j == 0 then
                        j = #data.role_info
                    end
                end
                if self.isPlayAnimation == false then
                    j = i
                end
                local data = data.role_info[j]
                obj:SetActiveE(data ~= nil and 1 or 0)
                if data ~= nil then
                    _G.UIUtils.SetPlayerHeadItemNew(obj, data, headScale[i], true, true, true)
                end
                if i == 1 then
                    goTable.aortext_name.text = data.name
                end
            end
            if #data.role_info > 1 and self.headIndex > 1 then
                for j = 1, 2 do
                    local obj = goTable["obj_headAdd" .. j]
                    local index = j == 1 and self.headIndex + 1 or self.headIndex - 1
                    if index >= #data.role_info and self.isPlayAnimation == true then
                        index = index % #data.role_info
                        if index == 0 then
                            index = #data.role_info
                        end
                    end
                    local data = data.role_info[index]
                    if data ~= nil then
                        _G.UIUtils.SetPlayerHeadItemNew(obj, data, headScale[j == 1 and 1 or 5], true, true, true)
                    end
                end
            end
        end
    end
    if self.headIndex == 1 and self.isPlayAnimation then
        if not self.timer then
            self.timer = _G.TimerManager:GetInstance():GetTimer(2, self.SetHeadAnimation, self, true, false, true)
            self.timer:Start()
        end
    elseif self.isPlayAnimation then
        if self.AnimComponent == nil then
            self.AnimComponent = self.go_table.obj_root:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
        end
        self.AnimComponent:Play("Ani_ActivityDispatchSignUpView_1")
    end
end

function ActivityDispatchSignUpView:PlayAnimation()
    self.AnimComponent:Play("New State")
    if not self.timer then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.SetHeadAnimation, self, true, false, true)
        self.timer:Start()
    end
end

function ActivityDispatchSignUpView:OnClickCampItem(go, isOn, type)
    local name = go:GetName()
    if name == "@_aorbtn_signUp" then
        ActivityDispatchModel:GetInstance():Enroll(function()
            local stage, _ = ActivityDispatchModel:GetInstance():GetStateInfo()
            if stage == 1 then
                --self.roleList = nil
                self:InitCampView()
            else
                ActivityDispatchModel:GetInstance():OpenView()
                self:Close()
            end
        end)
    elseif name == "@_aorbtn_rank" then
        --打开势力名单界面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityDispatchCampPlayerView.Name)
    elseif name == "@_aorbtn_embattle" then
        ActivityDispatchModel:GetInstance():OpenDefenceEmbattle()
    elseif name == "@_aorbtn_embattle2" then
        ActivityDispatchModel:GetInstance():OpenAttackEmbattle()
    end
end

---界面的销毁函数
function ActivityDispatchSignUpView:OnDestroy()
    if self.moveChatWindowTimer then
        self.moveChatWindowTimer:Stop()
        self.moveChatWindowTimer = nil
    end
    if self.onResetChatTimer then
        self.onResetChatTimer:Stop()
        self.onResetChatTimer = nil
    end
    --local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.RewardPreviewFullView.Name)
    --if view then
    --    view:Close()
    --    return
    --end
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.timer2 then
        self.timer2:Stop()
        self.timer2 = nil
    end
    --关闭内嵌页面
    if self.views then
        for k, view in pairs(self.views) do
            if k ~= 1 then
                view:Close()
            end
        end
        self.views = nil
    end
end

---按钮点击事件在这里派发
function ActivityDispatchSignUpView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        if self.curToggle ~= 1 then
            self.go_table.toggle_tag1.isOn = true
            return
        end
        self:Close()
    elseif go == self.go_table.aorbtn_info then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 166)
    elseif go == self.go_table.aorbtn_award then
        --打开奖励界面
        local rankStr = RankUtils.RankStrDefault.MilitaryIndustry
        local model = require("ActivityDispatchModel"):GetInstance()
        local Scope = model:GetRankAwardCfgIdScope(96)
        local Scope2 = model:GetRankAwardCfgIdScope(97)
        local Scope3 = model:GetRankAwardCfgIdScope(98)
        -----@type RewardPreviewView.OpenData[]
        local OpenData = {
            RankUtils.GetData(11, 1, 1000, rankStr, nil, _G.ConfigManager.arena_rank_cfg, Scope.min, Scope.max, 0),
            RankUtils.GetData(12, 1, 1000, rankStr, nil, _G.ConfigManager.arena_rank_cfg, Scope2.min, Scope2.max, 0),
            RankUtils.GetData(8, 1, 1000, rankStr, nil, _G.ConfigManager.arena_rank_cfg, Scope3.min, Scope3.max, 0),
        }
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RewardPreviewFullView.Name, OpenData, 1)

        ActivityDispatchModel:GetInstance():ChangeAwardShowRed()
        self.go_table.obj_root:SetActiveE(0)
    elseif go == self.go_table.aorbtn_share then
        --分享
        local isHas = require("SociatyManager"):GetInstance():HasSociaty()
        if isHas == true then
            ActivityDispatchModel:GetInstance():ShareActivity()
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(1080006)
        end
    elseif go == self.go_table.aorbtn_taskAward then
        --打开限时任务界面
        _G.GlobalInterface.JumpActivityByGM(10007, self.activity:GetJumpType(self.activity.activityID))
    elseif go == self.go_table.aorbtn_serverList then
        require("ActivityDispatchNet"):GetInstance():GetServerList(
            { activity_id = self.activityID },
            function(data)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicTeamServerListView.Name, data)
            end
        )
    end
end

return ActivityDispatchSignUpView