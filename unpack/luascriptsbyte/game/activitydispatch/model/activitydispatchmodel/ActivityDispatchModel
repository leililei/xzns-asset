function ActivityDispatchModel:AttackCall(msg)
    if msg.ack == 1 then
        if msg.award then
            local otherAward = { award = { item = {} } }
            local newAward = { award = { item = {} } }
            for _, v in pairs(msg.award.item) do
                if v.type[1] == 74 then
                    _G.Events:GetInstance():Broadcast(_G.eArena.SetDrawUp, { v.type[1], v.type[2] })
                    _G.table.insert(newAward.award.item, v)
                else
                    _G.table.insert(newAward.award.item, v)
                    _G.table.insert(otherAward.award.item, v)
                end
            end
            if not _G.table.isEmptyOrNil(otherAward.award.item) then
                _G.StorageManager:GetInstance():ReceiveAwardData(otherAward)
            end
            msg.award = newAward.award
        end
        --_G.WorldManager:GetInstance():DespawnRoleParent()
        -- _G.StorageManager:GetInstance():ReceiveAwardData(_data)
        if msg.score then
            self.score = self.score + tonumber(msg.score)
            _G.Events:GetInstance():Broadcast(_G.eActivityDispatch.ScoreChange)
        end
        local result = msg --_data.winner or false
        --self.battleInfo.round = self.battleInfo.round + 1
        if msg.next_battle == nil then
            result.win_num = msg.winner[1] == true and self.battleInfo.round or self.battleInfo.round - 1
        end
        self.battleInfo = msg.next_battle
        self:ReplaceName()
        --if msg.winner[1] == true and self.battleInfo then
        --    _G.Events:GetInstance():Broadcast(_G.eActivityDispatch.BattleInfoChange)
        --end
        self.result = result
        local skip = self:GetFightSkip()
        if skip == 1 then
            _G.BattleManager:GetInstance():SetArgData(msg.fight_arg)
            self.curBattleController = _G.require(_G.BattleControllerType.ActivityDispatch).New()
            _G.BattleManager:GetInstance():SetBattleController(self.curBattleController)
            self.curBattleController:StartSettlement(
                _G.SettlementModel.SettlementType.ActivityDispatch,
                result)
        else
            _G.BattleManager:GetInstance():SetArgData(msg.fight_arg)
            _G.BattleManager:GetInstance():EnterFight(_G.BattleControllerType.ActivityDispatch, result,
                self.battlePlayerData)
        end
    end
end

