function ActivityDispatchModel:GetNextAward()
    local activity = ActivitySynManager:GetInstance():GetChildAcitivity(10007,
        self.curActivityClass:GetJumpType(self.curActivityClass.activityID))
    if activity then
        local list = activity.typeClass:GetTaskListByPage(1)
        _G.table.sort(list, function(a, b)
            return a.Cfg.count < b.Cfg.count
        end)
        for _, v in ipairs(list) do
            if v.Cfg.page == 1 and self.hisFightNum < v.Cfg.count then
                return v
            end
        end
        return list[#list]
    end
end

