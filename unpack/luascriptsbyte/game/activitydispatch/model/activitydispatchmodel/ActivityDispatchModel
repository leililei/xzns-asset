---点击挑战
function ActivityDispatchModel:BattleClick(data)
    if _G.BattleManager:GetInstance():CheckInBattle() then
        _G.PopWindowManager:GetInstance():ShowAllTips(1080009)
        return
    end
    self.battlePlayerData = data
    if self.stage == 2 then
        if self:GetFightSkip() == 1 then
            self:Fight(true)
        else
            ActivityDispatchNet:GetInstance():GetEnemyEmbattleData(
                { activity_id = self.curActivityClass.activityID, difficulty = self.battlePlayerData.difficulty },
                _G.handler(self, self.OpenAttackEmbattle)
            )
        end
    else
        --休战
        _G.PopWindowManager:GetInstance():ShowAllTips(8204)
    end
end

---打开攻击布阵
function ActivityDispatchModel:OpenAttackEmbattle(data)
    if data then
        if data.ack ~= 1 then
            return
        end
        self.DefenceEmbattle = false
        _G.table.sort(data.arrays, function(a, b)
