function ActivityDispatchModel:AutoBattle()
    if self:GetHaveBattleInfo() then
        self:BattleAll(self.autoFightIndex,
            function(msg)
            end)
        return
    end
    if self.autoFightNum > 0 then
        ActivityDispatchModel:GetInstance():ChooseBuff(self.autoBuffIndex, function(msg)
            if msg.ack ~= 1 then
                self:CancelAuto()
                return
            end
            self.autoFightNum = self.autoFightNum - 1
            ActivityDispatchModel:GetInstance():BattleAll(
                self.autoFightIndex,
                function(msg)
                end)
        end)
    end
end

