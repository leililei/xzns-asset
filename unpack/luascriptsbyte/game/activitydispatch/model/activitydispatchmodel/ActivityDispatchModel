---选择buff
function ActivityDispatchModel:ChooseBuff(index, call)
    self:SetChooseBuffTag(index)
    ActivityDispatchNet:GetInstance():ChooseBuff(
        { buff_id = self.buffs[index].key, activity_id = self.curActivityClass.activityID },
        function(msg)
            if msg.ack == 1 then
                if self.battleInfo == nil then
                    self.battleInfo = {}
                end
                self.battleInfo.buffs = { self.buffs[index].key }
                self.battleInfo.enemy = msg.next_enemy
                self.battleInfo.round = msg.round
                self.battleInfo.stiff = 0
                self:ReplaceName()
                if self.fight == 0 then
                    _G.StorageManager:GetInstance():ConsumeItem(ticketId, nil, 1)
                end

                self.fight = msg.fight_times
                self.fightCd = msg.fight_cd
                self.hisFightNum = self.hisFightNum + 1
                self:SetFightNumTimer()
                _G.Events:GetInstance():Broadcast(_G.eActivityDispatch.FightNumChange)
                self.curActivityClass.typeClass:UpdateRedpoint(4)
                _G.StorageManager:GetInstance():ConsumeItem(_G.ResPropID.Diamond, nil, self.buffs[index].value)
            end
            if call then
                call(msg)
            end
        end
    )
end

