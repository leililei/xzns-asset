---获取配置排名奖励id范围
---@param rankType number 96全服 97部落 98联盟
function ActivityDispatchModel:GetRankAwardCfgIdScope(rankType)
    local Scope = {
        min = math.maxinteger,
        max = 0,
    }
    local count = #self.rankAwardCfg
    for i = 1, count do
        ---@type activity_tarot.i_rank_award
        local cfg = self.rankAwardCfg[i]
        if cfg.rank_type == rankType then
            local count1 = #cfg.rank_sid
            for j = 1, count1 do
                local id = cfg.rank_sid[j]
                if id > Scope.max then
                    Scope.max = id
                end
                if id < Scope.min then
                    Scope.min = id
                end
            end
            return Scope
        end
    end
    return Scope
end

