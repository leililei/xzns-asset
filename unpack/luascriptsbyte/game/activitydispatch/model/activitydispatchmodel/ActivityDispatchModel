---分享活动
function ActivityDispatchModel:ShareActivity()
    if self.shareNum >= self.shareLimit then
        return
    end
    ---分享公会
    local data = {}
    --data.type = self.campType
    --data.notice = self.notice
    local dataStr = _G.Table2Json(data)

    ---@type chat.c2s_chat dsd
    local param = {}
    param.channel = 3
    param.content = dataStr
    param.f_uid = 0
    param.type = 8
    param.voice = 0
    param.share_id = ""

    ---@type ClintSendChatInfo ---本地自己的消息 先显示 忽略服务器广播 防止延迟
    local msg = {}
    msg.channel = 3
    msg.n_content = dataStr
    msg.f_uid = 0
    msg.type = 8
    msg.voice = 0
    msg.share_id = ""
    msg, _ = require("ChatManager"):GetInstance():GetNewChatInfo(msg)
    require("ChatViewNet"):GetInstance():SendCHAT(param, _G.handlerbind(self, self.CallSendChat, msg))
end

function ActivityDispatchModel:CallSendChat(param, msg)
    if param.ack == 1 then
        _G.PopWindowManager:GetInstance():ShowAllTips(411)
        --- 以服务器返回的内容为准  (违禁字 处理后)
        if not _G.IsNil(param.content) and not string.IsNullOrEmpty(param.content) then
            msg.chat.n_content = param.content
        end
        if not _G.IsNil(param.time) then
            msg.chat.time = param.time
        end
        require("ChatManager"):GetInstance():P2C_NewChat(msg)
        if self.shareNum < self.shareAwardLimit then
            self:GetShareAward()
        end
        self.shareNum = self.shareNum + 1
        _G.Events:GetInstance():Broadcast(_G.eActivityDispatch.ShareChat)
    end
end

