---解析简要信息
---@param msg activity_dispatch.i_activity_dispatch_brief
function ActivityDispatchModel:ParseSimpleData(msg, activity)
    self.stage = msg.stage
    --self.campType = msg.faction_id or 0
    self.fight = msg.fight_times
    self.fightCd = msg.fight_cd
    self.shareNum = msg.share_num
    self.enrollTime = msg.enroll_time or 0
    self.hisFightNum = msg.his_fight_times or 0
    self.boxNumTotal = msg.box_num or 0
    self.boxNum = msg.role_box or 0
    if msg.other_info then
        self.shareLimit = msg.other_info.share_limit or 0
        self.shareAwardLimit = msg.other_info.share_award_limit or 0
        self.shareAward = msg.other_info.share_award
        self.fightTimesCfg = msg.other_info.fight_times_cfg
        self.buffs = msg.other_info.buffs
        self.fightTime = msg.other_info.day_fight_time
        self.rankAwardCfg = msg.other_info.rank_award_cfg
        self.enrollEndTime = msg.other_info.enroll_end_time
    end
    self.coins = {}
    local list = { 74 }
    for i, v in ipairs(list) do
        self.coins[v] = 0
    end
    if msg.coin then
        for i, v in ipairs(msg.coin) do
            self.coins[v.key] = v.value
        end
    end
    self.hisCoinNum = msg.his_coin_num or 0
    self.curActivityClass = activity
    self:SetFightNumTimer()
    if _G.TimeUtil.GetServerUnixTime() >= 
        self.curActivityClass.cfg.time.start_time + self.curActivityClass.cfg.time.run_time
    then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ActivityDispatchView.Name)
    end
end

---解析详细信息
---@param msg activity_dispatch.s2c_activity_dispatch_get_detail_info
function ActivityDispatchModel:ParseData(msg)
    self.data = msg
    self.stage = msg.pub_info.stage
    self.stageEndTime = msg.pub_info.end_time
    self.campInfo = {}
    --for i, v in ipairs(msg.pub_info.faction_info) do
    --    self.campInfo[v.faction_id] = v
    --end
    --self.logList = msg.pub_info.logs

    if msg.self_info then
        --self.campType = msg.self_info.faction_id or 0
        self.score = msg.self_info.score or 0
        self.shareNum = msg.self_info.share_num or 0
        self.notice = msg.self_info.notice == "" and _G.GetLangPackValue(90033400023) or msg.self_info.notice
        self.selfRank = msg.self_info.rank or 0
        self.boxNum = msg.self_info.box_num or 0
        self.battleInfo = msg.self_info.battle_info
        self:ReplaceName()
        if self.fight ~= msg.self_info.fight_times then
            self.fight = msg.self_info.fight_times or 0
            self.fightCd = msg.self_info.fight_cd or 0
            self:SetFightNumTimer()
        end
        self.easter_egg = msg.self_info.easter_egg
    end
    for i = 1, 5 do
        self.curActivityClass.typeClass:UpdateRedpoint(i)
    end
end

