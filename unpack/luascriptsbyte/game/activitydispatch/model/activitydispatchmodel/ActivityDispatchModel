---更新战斗结果的缓存数据
---@param msg activity_dispatch.p2c_dispatch_fight_result 战斗结果
---@param clearCache boolean 是否清除缓存
function ActivityDispatchModel:UpdateFightCache(msg, clearCache)
    if clearCache then
        if self.fightDataCace then
            self.fightDataCace.score = 0
            self.fightDataCace.win_num = 0
        end
        return
    end

    if not self.fightDataCace then
        self.fightDataCace = { score = tonumber(msg.score), win_num = msg.win_num }
        return
    end
    self.fightDataCace.score = (self.fightDataCace.score or 0) + (tonumber(msg.score or 0))
    self.fightDataCace.win_num = (self.fightDataCace.win_num or 0) + (msg.win_num or 0)
end

function ActivityDispatchModel:UpdateFightMsg(msg)
    if self.fightDataCace then
        msg.score = tonumber(msg.score + (self.fightDataCace.score or 0))
        msg.win_num = (msg.win_num or 0) + (self.fightDataCace.win_num or 0)
        self:UpdateFightCache(nil, true)
    end
    return msg
end

---@param msg activity_dispatch.p2c_dispatch_fight_all 一键挑战结果推送
function ActivityDispatchModel:P2CFightAll(msg)
    if msg.ack ~= 1 then
        self:UpdateFightCache(msg)
        self:FightReStartTimer()
        if self.reqFightNum < self.reqFightMaxTimes then
            return
        end
        _G.PopWindowManager:GetInstance():ShowAllTips(msg.ack)
    else
        self.reqFightNum = 0
    end

    if self.reqFightNum >= 3 then
        self.reqFightNum = 0
    end
    msg = self:UpdateFightMsg(msg)

    self.battleInfo = msg.next_battle

    if msg.award then
        local otherAward = { award = { item = {} } }
        local newAward = { award = { item = {} } }
        for _, v in pairs(msg.award.item) do
            if v.type[1] == 74 then
                _G.Events:GetInstance():Broadcast(_G.eArena.SetDrawUp, { v.type[1], v.type[2] })
                _G.table.insert(newAward.award.item, v)
            else
                _G.table.insert(newAward.award.item, v)
                _G.table.insert(otherAward.award.item, v)
            end
        end
        if not _G.table.isEmptyOrNil(otherAward.award.item) then
            _G.StorageManager:GetInstance():ReceiveAwardData(otherAward)
        end
        msg.award = newAward.award
    end

    if msg.score then
        self.score = self.score + tonumber(msg.score)
        _G.Events:GetInstance():Broadcast(_G.eActivityDispatch.ScoreChange)
    end
    self.battleIng = false
    _G.BattleManager:GetInstance():DestroyBattle()
    _G.BattleManager:GetInstance():SetInBattle(false)

    _G.Events:GetInstance():Broadcast(_G.eActivityDispatch.FightAllEnd, msg)
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ActivityDispatchBattleAnimation.Name)
    if view == nil then
        msg.auto = self.autoFight == true and self.autoFightNum > 0 and self.stage == 2
        local viewBattle = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ActivityDispatchBattleView.Name)

        if viewBattle ~= nil then
            self:ReturnPanel()
        end

        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ActivityDispatchAllBattleResultView.Name,
            function()
                if self.autoFightNum == 0 or self.stage ~= 2 then
                    self:CancelAuto()
                end
                -- if self.autoFight == false then
                --     self:ReturnPanel()
                -- end
            end,
            msg
        )
    end
end

