---@protected
function ActivityDispatchModel:SetFightNumTimer()
    if self.enrollTime ~= 0 and (self.stage == 2 or self.stage == 3) then
        if not self.timer and self.fight < self.fightTimesCfg.key then
            self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.CalculateFight, self, false, false, true)
            self.timer:Start()
        end
    else
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
    end
end

---计算挑战次数
function ActivityDispatchModel:CalculateFight()
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    local interval = serverTime - self.fightCd
    if interval > self.fightTimesCfg.value then
        self.fight = self.fight + interval // self.fightTimesCfg.value
        self.fightCd = serverTime - interval % self.fightTimesCfg.value
        if self.fight >= self.fightTimesCfg.key then
            --达到上限
            self.fight = self.fightTimesCfg.key
            if self.timer then
                self.timer:Stop()
                self.timer = nil
            end
        end
    end
end

--获取不重复的随机数
function ActivityDispatchModel:GetRandomNumbers(num, count)
    local numbers = {}
    for i = 1, num do
        table.insert(numbers, i)
    end

    local shuffledNumbers = {}
    while #shuffledNumbers < count do
        local index = math.random(#numbers)
        table.insert(shuffledNumbers, numbers[index])
        table.remove(numbers, index)
    end
    return shuffledNumbers
end

---打开界面
function ActivityDispatchModel:OpenView()
    self:GetInfo(function()
        local endTime = self.curActivityClass.cfg.time.start_time + self.curActivityClass.cfg.time.run_time
        if _G.TimeUtil.GetServerUnixTime() > endTime then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityDispatchAwardPopView.Name)
        else
            if self.enrollTime == 0 then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityDispatchSignUpView.Name)
            elseif self.stage == 1 then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityDispatchSignUpView.Name)
            elseif self.battleInfo and self.battleIng == false then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityDispatchBattleView.Name)
            else
                local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ActivityDispatchView.Name)
                if view then
                    view:Show()
                    view:SetRank()
                else
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityDispatchView.Name)
                end
            end
        end
    end)
end

