---领取奖励
function ActivityDispatchAwardTaskData:GetAward(ids, call)
    require "DrawUpBattlePassTaskNet":GetInstance():GetAward(
        { activity_id = self.curActivityClass:GetActivityID(), task_sid = ids, finish_type = 2 },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            for _, v in pairs(ids) do
                if not msg.award or not msg.award.item then
                    msg.award = { item = {} }
                end
                self.activity.finishTask[v] = true
            end
            require "CommonTipManager".OpenCommonAwardView(msg)
            self.activity:RefreshRedPoint()
            if call then
                call()
            end
        end
    )
end
