---进入活动
function ActivityDispatchAwardTaskData:OnEnterActivity()
    local toggleTab = {
        {
            tasktype = _G.eActiveTaskType.CycleTask,
            title = _G.GetLangPackValue(90033400081),
            PanelView = _G.eActiveTaskPanelLua.ActivityDispatchAwardShowPanel,
