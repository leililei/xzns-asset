local ActivitySynManager = require "ActivitySynManager"
local ActivityDispatchModel = require("ActivityDispatchModel")
local base = require "ActivitySynTypeBase"
---@class ActivityDispatchSynModel : ActivitySynTypeBase    中文描述
local ActivityDispatchSynModel = _G.BaseClass("ActivityDispatchSynModel", base)

function ActivityDispatchSynModel:__init()
    self.curActivityClass:AddStateChanged(self.StateChanged, self)
end

function ActivityDispatchSynModel:OnHandleGMData(msg)
    self:ParseData(msg)
end

---@param msg activity_dispatch.i_activity_dispatch_brief
function ActivityDispatchSynModel:ParseData(msg)
    ActivityDispatchModel:GetInstance():ParseSimpleData(msg.activity_dispatch_brief, self.curActivityClass)
    base.ParseData(self)
end

---进入活动主体
function ActivityDispatchSynModel:OnEnterActivity()
    ActivityDispatchModel:GetInstance():OpenView()
end

function ActivityDispatchSynModel:StateChanged(state)
    if state == ActivitySynManager.State.Close then
        ActivityDispatchModel:GetInstance():CloseView()
    elseif state == ActivitySynManager.State.Settlement then
        self:UpdateRedpoint(1)
    end
end

---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function ActivityDispatchSynModel:InitRedPointTree()
    self.checkRedPointFunc = {
        self.CheckRedPoint,
        self.CheckAwardShow,
        self.CheckShareAward,
        self.CheckBattleMax,
        self.CheckChampionAward,
        self.CheckDefenceEmbattle
    }
    self.redpointTree = { { 2, 3, 4, 5, 6 }, false, false, false, false, false }
end

function ActivityDispatchSynModel:CheckRedPoint()
    if self:CheckSignUp() == 1 then
        return 1
    end
    return 0
end

---检测是否报名
function ActivityDispatchSynModel:CheckSignUp()
    if ActivityDispatchModel:GetInstance():IsAwardTime() == true then
        return 0
    end
    return ActivityDispatchModel:GetInstance():CheckSignUp() and 1 or 0
end

---检测耀之巅按钮红点
function ActivityDispatchSynModel:CheckAwardShow()
    if ActivityDispatchModel:GetInstance():IsAwardTime() == true then
        return 0
    end
    return ActivityDispatchModel:GetInstance():CheckAwardShow() and 1 or 0
end

---检测分享奖励红点
function ActivityDispatchSynModel:CheckShareAward()
    return 0
end

---检测布阵提示
function ActivityDispatchSynModel:CheckBattleMax()
    if ActivityDispatchModel:GetInstance():IsAwardTime() == true then
        return 0
    end
    return ActivityDispatchModel:GetInstance():CheckBattleMax() and 1 or 0
end

---检测阵容有空位显示红点
function ActivityDispatchSynModel:CheckDefenceEmbattle()
    if ActivityDispatchModel:GetInstance():IsAwardTime() == true then
        return 0
    end
    return ActivityDispatchModel:GetInstance():CheckDefenceEmbattle() and 1 or 0
end

---检测统帅赠礼战利品宝箱红点
function ActivityDispatchSynModel:CheckChampionAward()
    if ActivityDispatchModel:GetInstance():IsAwardTime() == true then
        return 0
    end
    return ActivityDispatchModel:GetInstance():CheckChampionAward() and 1 or 0
end

---绑定子活动
function ActivityDispatchSynModel:GetOtherActivityRedPointIds()
    if ActivityDispatchModel:GetInstance().stage == 1 then--报名期没有礼包和兑换的入口，不刷对应红点
        return { 10007 }
    end
    return { 10007, 10014, 10005 }
end

---刷新红点
function ActivityDispatchSynModel:UpdateRedpoint(index)
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(index))
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function ActivityDispatchSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

function ActivityDispatchSynModel:JumpFunction()
    --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityDispatchView.Name)
    ActivityDispatchModel:GetInstance():OpenView()
end

---销毁对象时,析构函数
function ActivityDispatchSynModel:Dispose()
    if self.curActivityClass then
        self.curActivityClass:RemoveStateChanged(_G.handler(self, self.StateChanged), self)
    end
end

return ActivityDispatchSynModel
