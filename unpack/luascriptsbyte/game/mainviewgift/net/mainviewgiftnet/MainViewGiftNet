local base = require("BaseGameNet")

---@class MainViewGiftNet : BaseGameNet	通信协议
local MainViewGiftNet = _G.BaseClass("MainViewGiftNet", base)
---@return MainViewGiftNet MainViewGiftNet
function MainViewGiftNet:GetInstance()
    return  base.GetInstance(self)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function MainViewGiftNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function MainViewGiftNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

function MainViewGiftNet:GetInfo(callback)
    local item = _G.ConfigManager.net_map.game_city_gift_info
    local port = base.Access(self, item, "", _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

---领取礼包
function MainViewGiftNet:GetAward(data, callback)
    local item = _G.ConfigManager.net_map.game_city_gift_award
    local port = base.Access(self, item,data, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

return MainViewGiftNet