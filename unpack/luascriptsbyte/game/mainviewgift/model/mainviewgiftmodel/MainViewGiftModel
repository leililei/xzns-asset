---@class MainViewGiftModel : GameDataModelBase	中文描述
---@param type number 礼物状态
---@param npc_id number 对话NPC
---@param conv_id number 对话组ID
---@param last_time number 上次礼物领取时间
local base = _G.GameDataModelBase
local MainViewGiftModel = _G.BaseClass("MainViewGiftModel",base)
function MainViewGiftModel:GetInstance()
    return self.super.GetInstance(self)
end

---从服务器拉取数据
function MainViewGiftModel:GetDataFormServer()
    self:GetInfo()
end

--region 获取Info
function MainViewGiftModel:GetInfo()
    require("MainViewGiftNet"):GetInstance():GetInfo(_G.handler(self, self.ParseData))
end

function MainViewGiftModel:ParseData(data)
    self.type = data.type
    self.npc_sid = data.npc_id or 0
    self.conv_id = data.conv_id or 0
    self.last_time = data.last_time
    self.usedTimes = data.num
    if self.npc_uid and self.npc_uid ~= 0 then
        self:SetGiftNpcTip()
    end
    if self.type == 0 then
        self:SetBurial()
    end
    base.ParseData(self)
end

function MainViewGiftModel:OnSixClockUpdate(endcall)
    self.oldNpc = self.npc_uid
    base.OnSixClockUpdate(self,endcall)
end

---类的构造函数
function MainViewGiftModel:__init()
    self.curFunctionOpenID = 140
    local discrete_cfg = _G.ConfigManager.discrete_cfg
    self.BurialTime = discrete_cfg[108401][1][1]
    self.BurialTimes = discrete_cfg[108402][1][1]
    self.oldNpc = 0
end

---类的析构函数
function MainViewGiftModel:Dispose()
    self:StopTimer()
end

---设置礼物冷却
function MainViewGiftModel:SetBurial()
    if self.BurialTimes > self.usedTimes then
        local time = _G.TimeUtil.GetServerUnixTime()
        if self.last_time + self.BurialTime < time then
            self:GetInfo()
            self:StopTimer()
        else
            self.BurialTimer = _G.TimerManager:GetInstance():GetTimer(
                self.BurialTime + self.last_time + 1 - time,
                self.SetBurial,
                self,
                true
                )
            self.BurialTimer:Start()
        end
    end
end

---停止计时
function MainViewGiftModel:StopTimer()
    if self.BurialTimer then
        self.BurialTimer:Stop()
        self.BurialTimer = nil
    end
end

---获得当前可领取礼物的npcId
function MainViewGiftModel:GetCurNpc()
    return self.npc_uid
end

---领取奖励
---@param data table 奖励类型type,下标index
---@param callBack function 领奖回调
function MainViewGiftModel:GetAward(data,callBack)
    self.CallBack = callBack
    require("MainViewGiftNet"):GetInstance():GetAward({type = data.type,conv_index = data.index},_G.handler(self,self.GetAwardCallBack))
end

function MainViewGiftModel:GetAwardCallBack(msg)
    if msg.ack ~= 1 then
        return
    end
    local data = msg
    _G.StorageManager:GetInstance():ReceiveAwardData(data)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data,function()
        if msg.lucky_conv and msg.lucky_conv ~= 0 then
            if self.CallBack then
                self.CallBack(true,msg.lucky_conv)
                self.CallBack = nil
            end
        else
            self.npc_sid = 0
            self.npc_uid = 0
            self.conv_id = 0
            self.type = 0
            self.usedTimes = self.usedTimes + 1
            self.last_time = _G.TimeUtil.GetServerUnixTime()
            self:SetBurial()
            if self.CallBack then
                self.CallBack(false)
                self.CallBack = nil
            end
        end
    end)
end

function MainViewGiftModel:GoToGiftNpc()
    local world =  _G.WorldManager:GetInstance():GetCurWorld()
    local giftNpc = world.AllWorldItems[self.npc_uid]
    giftNpc:OnClick()
end

function MainViewGiftModel:SetGiftNpcTip()
    if self.oldNpc ~= 0 then
        _G.WorldUtils.UpdateWorldItemTip(self.oldNpc)
    end
    _G.WorldUtils.UpdateWorldItemTip(self.npc_uid)
    _G.Events:GetInstance():Broadcast(_G.eFunctionsStatus.NewFunction, self.npc_uid)
end

return MainViewGiftModel