local base = require "BaseGameNet"

---@class PenglaiTreasureHouseNet : BaseGameNet	通信协议
local PenglaiTreasureHouseNet = _G.BaseClass("PenglaiTreasureHouseNet", base)

---@return PenglaiTreasureHouseNet PenglaiTreasureHouseNet
function PenglaiTreasureHouseNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---可选奖励格位选择奖励
---@param pbData activity_treasure_house.c2s_choose PB数据
---@param callback function 完成回调
function PenglaiTreasureHouseNet:ChooseAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_treasure_house_port_choose
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

---抽取奖励(只有单抽)
---@param pbData activity_treasure_house.c2s_draw PB数据
---@param callback function 完成回调
function PenglaiTreasureHouseNet:GetAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_treasure_house_port_draw
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

---领取累充奖励
---@param pbData activity_treasure_house.c2s_award PB数据
---@param callback function 完成回调
function PenglaiTreasureHouseNet:GetCashAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_treasure_house_port_award
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function PenglaiTreasureHouseNet:Callback(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type PenglaiTreasureHouseNet
_G.PenglaiTreasureHouseNet = PenglaiTreasureHouseNet
return PenglaiTreasureHouseNet
