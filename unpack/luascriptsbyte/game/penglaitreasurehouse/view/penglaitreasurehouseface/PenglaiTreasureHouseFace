local PenglaiTreasureHouseNet = require "PenglaiTreasureHouseNet"
local PenglaiTreasureHouseManager = require "PenglaiTreasureHouseManager"
---@class PenglaiTreasureHouseFace : Component	中文描述
---@field Cfg treasure_cell_cfg 当前奖励配置
---@field Index number 当前层
---@field FaceIndex number 当前位置索引
local PenglaiTreasureHouseFace = _G.BaseClass("PenglaiTreasureHouseFace", _G.Component)

---创建对象时,入口构造函数
function PenglaiTreasureHouseFace:OnCreate(obj, cellid, view)
    self.View = view
    self.Cfg = _G.ConfigManager.treasure_cell_cfg[cellid]
    self.go_table = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.ClickCardFace))
    self.FaceId = 0
    self.FaceNum = 0

    self.PlThClass = PenglaiTreasureHouseManager:GetInstance():GetData()

    self:UpdateChooseId()

    self:CreateItem()
    self:SetChoose()
    self:ShowState()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_jiahao,
        self.go_table.obj_addeffect,
        function(trans)
            if _G.IsNil(self.go_table.obj_addeffect) then
                trans:DestroyObject()
                return
            end
        end
    )
end

function PenglaiTreasureHouseFace:UpdateFaceInfo(cellid)
    self.Cfg = _G.ConfigManager.treasure_cell_cfg[cellid]
    self.FaceId = 0
    self.FaceNum = 0

    self.PlThClass = PenglaiTreasureHouseManager:GetInstance():GetData()

    self:UpdateChooseId()

    self:CreateItem()
    self:SetChoose()
    self:ShowState()
end

function PenglaiTreasureHouseFace:UpdateChooseId()
    if #self.Cfg.reward > 1 then
        local cif = self.PlThClass.Info.choose_info
        if cif then
            for i = 1, #cif do
                if cif[i].sid == self.Cfg.id and cif[i].index > 0 then
                    self.FaceId = self.Cfg.reward[cif[i].index][1]
                    self.FaceNum = self.Cfg.reward[cif[i].index][2]
                end
            end
        end
    else
        self.FaceId = self.Cfg.reward[1][1]
        self.FaceNum = self.Cfg.reward[1][2]
    end
end

---是否为可选格子
function PenglaiTreasureHouseFace:IsCanChoose()
    for i = 1, #self.PlThClass.Info.choose_info do
        if self.PlThClass.Info.choose_info[i].sid == self.Cfg.id then
            return true
        end
    end
    return false
end

function PenglaiTreasureHouseFace:ShowState()
    if self.Cfg.layer_change == 4 then
        self.go_table.aorimage_top:SetActiveE(1)
    elseif self.Cfg.layer_change == 3 then
        self.go_table.aorimage_two:SetActiveE(1)
    elseif self.Cfg.layer_change == 2 then
        self.go_table.aorimage_one:SetActiveE(1)
    end

    if #self.Cfg.reward > 1 then
        self.go_table.aorbtn_change:SetActiveE(1)
        self.go_table.aorbtn_changedi:SetActiveE(1)
    end
end

function PenglaiTreasureHouseFace:HideChoose()
    self.go_table.aorimage_choose:SetActiveE(0)
end

function PenglaiTreasureHouseFace:ShowChoose()
    self.go_table.aorimage_choose:SetActiveE(1)
end

function PenglaiTreasureHouseFace:SetChoose()
    if self.Cfg.layer_change ~= 2 and self.Cfg.layer_change ~= 3 then
        if self.PlThClass.Info.award then
            for i = 1, #self.PlThClass.Info.award do
                if self.PlThClass.Info.award[i] == self.Cfg.id then
                    self.go_table.aorimage_isget:SetActiveE(1)
                end
            end
        end
    end
end

---展示奖励并确定要跳的层级
function PenglaiTreasureHouseFace:ShowAward(back)
    if back then
        if self.Cfg.layer_change == 1 then
            back(-1)
        elseif self.Cfg.layer_change == 2 then
            back(1)
        elseif self.Cfg.layer_change == 3 then
            back(2)
        else
            back(0)
        end
    end
end

---点击上面
function PenglaiTreasureHouseFace:ClickCardFace(go, isOn)
    if _G.AppSetting.DEBUG then
        _G.Log(self.Cfg, "当前格子信息")
    end
    -- if self.PlThClass.Info.draw_times > 0 then
    --     if _G.AppSetting.DEBUG then
    --         _G.Log("抽卡过程中无法重新选择奖励")
    --     end
    --     return
    -- end
    if go == self.go_table.aorbtn_change or go == self.go_table.aorbtn_changedi then
        if  self.View.LDing then
            
            return
        end
        if self.go_table.aorimage_isget:GetActiveSelf()==0 then
            _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.PenglaiTreasureHouseSelectView.Name,
                    self.Cfg,
                    _G.handler(self, self.ChooseBack)
            )
        else
            self.go_table.LoadTans:OnClickBtn()
        end
    end
end

function PenglaiTreasureHouseFace:ChooseBack(index)
    self:UpdateChooseId()
    self:CreateItem()
end

---创建物品
function PenglaiTreasureHouseFace:CreateItem()
    if self.FaceId > 0 then
        self.go_table.obj_addeffect:SetActiveE(0)
        self.go_table.obj_itemnode:SetActiveE(1)
        if not self.go_table.LoadTans then
            self.go_table.LoadTans = 1
            _G.StorageManager:GetInstance():GetItemBaseView(
                self.FaceId,
                self.FaceNum,
                self.go_table.obj_itemnode,
                function(item)
                    self.go_table.LoadTans = item
                    item.gameObject:SetLocalScaleXYZ(0.8)
                    _G.GameUtil.SetActiveByCondition(item.gameObject, true)
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    local grade, type = _G.StorageManager:GetInstance():GetItemGrade(self.FaceId)
                    if grade >= 6 then
                        item:ShowEffect(true)
                    else
                        item:ShowOrHideEffect(false)
                    end
                end
            )
        else
            if not _G.IsNumber(self.go_table.LoadTans) then
                local item = self.go_table.LoadTans
                local newdata = _G.StorageManager:GetInstance():GetItemDataClassByCfg({ self.FaceId, self.FaceNum })
                item:UpdateData(item.gameObject, newdata)
                item.gameObject:SetLocalScaleXYZ(0.8)
                _G.GameUtil.SetActiveByCondition(item.gameObject, true)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                local grade, type = _G.StorageManager:GetInstance():GetItemGrade(self.FaceId)
                if grade >= 6 then
                    item:ShowEffect(true)
                else
                    item:ShowOrHideEffect(false)
                end
            end
        end
    else
        self.go_table.obj_addeffect:SetActiveE(1)
        self.go_table.obj_itemnode:SetActiveE(0)
    end
end

function PenglaiTreasureHouseFace:Reset()
    self.go_table.aorimage_top:SetActiveE(0)
    self.go_table.aorimage_two:SetActiveE(0)
    self.go_table.aorimage_one:SetActiveE(0)
    self.go_table.aorbtn_change:SetActiveE(0)
    self.go_table.aorbtn_changedi:SetActiveE(0)
    self.go_table.aorimage_choose:SetActiveE(0)
    self.go_table.aorimage_isget:SetActiveE(0)
    self.go_table.obj_itemnode:SetActiveE(0)
end

---销毁对象时,析构函数
function PenglaiTreasureHouseFace:OnDestroy()
    if self.DtRotate then
        self.DtRotate:Kill()
        self.DtRotate = nil
    end
    if self.DtMove then
        self.DtMove:Kill()
        self.DtMove = nil
    end
end

return PenglaiTreasureHouseFace
