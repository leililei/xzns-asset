local PenglaiTreasureHouseManager = require "PenglaiTreasureHouseManager"
local ColorType = {
    "ui-ghck-icon-hui",
    "ui-ghck-icon-hui",
    "ui-ghck-icon-lan",
    "ui-ghck-icon-zi",
    "ui-ghck-icon-cheng",
    "ui-ghck-icon-hong",
    "",
    "ui-ghck-icon-cai"
}

---@class PenglaiTreasureHouseSelectView : UIBaseView    中文描述
---@field public go_table PenglaiTreasureHouseSelectView_GoTable GoTable
---@field PlThClass PenglaiTreasureHouseModel
---@field CurAward {sid, num} 当前奖励
---@field CurTerm number 当前轮次
---@field AwardList PenglaiTreasureHouseSelectAwardList[]
---@field Cfg treasure_cell_cfg 奖励配置
local PenglaiTreasureHouseSelectView = _G.BaseClass("PenglaiTreasureHouseSelectView", _G.UIBaseView)

function PenglaiTreasureHouseSelectView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function PenglaiTreasureHouseSelectView:OnCreate(cfg, callback)
    self.Cfg = cfg
    self.PlThClass = PenglaiTreasureHouseManager:GetInstance():GetData()
    self.CurAward = {}
    self.ChooseId = self.CurAward[1] or 0
    self.ChooseTerm = 1
    self.CurTerm = 1
    self.AwardList = {}
    self.Callback = callback
    local tempReInfo = {}
    for i = 1, #self.Cfg.reward do
        local z = self.Cfg.reward[i][3]
        if nil == tempReInfo[z] then
            tempReInfo[z] = {}
            tempReInfo[z].z = z
            tempReInfo[z].info = {}
        end
        local info = {}
        info.index = i
        info.sid = self.Cfg.id
        info.z = z
        info.zinfo = self.Cfg.reward[i]
        table.insert(tempReInfo[z].info, info)
    end

    self.ReInfo = table.toArray(tempReInfo)
    table.sort(
            self.ReInfo,
            function(a, b)
                return a.z < b.z
            end
    )

    self:UpdateAward()
    self.go_table.scrollloopvectical_ItemList:InitItemData(#self.ReInfo, _G.handler(self, self.RefreshItem))
    local cif = self.PlThClass.Info.choose_info
    if cif then
        for i = 1, #cif do
            if cif[i].sid == self.Cfg.id and cif[i].index > 0 then
                local award = self.Cfg.reward[cif[i].index]
                self:OnClickItem(nil, cif[i].index, award[1], award[2])
            end
        end
    end
    self.go_table.obj_setItem:SetActiveE(0)
    self.ShowItemDelay = _G.DelayDo(0.5, _G.handler(self, self.ShowItem))
    local choosescTerm = 1
    local choosescIndex = 1
    for i = 1, #self.ReInfo do
        if self.PlThClass.Info.round >= self.ReInfo[i].z then
            local AwardData = self.ReInfo[i].info
            local isCanChoose = true
            for j = 1, 4 do
                if AwardData[j] then
                    local count = AwardData[j].zinfo[4]

                    local useTimes = self:GetUseTimes(AwardData[j].sid, AwardData[j].index)
                    if (count - useTimes) <= 0 then
                        isCanChoose = false
                    end
                end
            end

            if choosescTerm < self.ReInfo[i].z then
                choosescTerm = self.ReInfo[i].z
                if isCanChoose then
                    choosescIndex = i
                end
            end
        end
    end
    self.go_table.scrollloopvectical_ItemList:ScrollToIndex(choosescIndex - 1)
end

---获取物品已选择次数
function PenglaiTreasureHouseSelectView:GetUseTimes(sid, index)
    if self.PlThClass.Info.choose_info then
        for k = 1, #self.PlThClass.Info.choose_info do
            local ci = self.PlThClass.Info.choose_info[k]
            if ci.sid == sid and ci.already_num then
                for i = 1, #ci.already_num do
                    if ci.already_num[i].k == index then
                        return ci.already_num[i].v
                    end
                end
            end
        end
    end
    return 0
end

function PenglaiTreasureHouseSelectView:ShowItem()
    self.go_table.obj_setItem:SetActiveE(1)
end

---刷新奖励
function PenglaiTreasureHouseSelectView:RefreshItem(index, obj)
    local instanceID = obj:GetInstanceIDE()
    local item = self.AwardList[instanceID]
    local awardData = self.ReInfo[index + 1].info
    if not item then
        item = self:AddComponent(
                obj,
                require "PenglaiTreasureHouseSelectAwardList".New(awardData, _G.handler(self, self.OnClickItem))
        )
        self.AwardList[instanceID] = item
    else
        self.AwardList[instanceID]:UpdateAward(awardData)
    end
    self.AwardList[instanceID]:Show()
end

---点击奖励
function PenglaiTreasureHouseSelectView:OnClickItem(go, index, id, num, data)
    --self.go_table.scrollloopvectical_ItemList:UpdateItemSingle(self.curFloor - 1)

    if self.Cfg.id == self.ChooseSid and index == self.ChooseIndex and go then
        require "CommonTipManager":GetInstance():OpenPropTip(go, data)
        return
    end
    self.ChooseSid = self.Cfg.id
    self.ChooseIndex = index
    self.CurAward = { id, num }
    self:UpdateAward()
    for _, value in pairs(self.AwardList) do
        value:SetChoose(self.ChooseIndex)
    end
end

---更新奖励显示
function PenglaiTreasureHouseSelectView:UpdateAward()
    if #self.CurAward <= 0 then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_setItem, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_add, true)
        return
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_add, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_setItem, true)

    local cfg = _G.ConfigManager.item_cfg[self.ChooseId]
    if cfg then
        local showElement = cfg.Type1 == 6 or cfg.Type1 == 13 or cfg.Type1 == _G.ItemCfgType.PetChip
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_element, showElement)
        if showElement then
            self.go_table.aorimage_element.SpriteName = ColorType[cfg.Quality]
        end
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_element, false)
    end

    local item = require "BaseAwardNewItem".New(self.go_table.obj_setItem, nil, 130, self.go_table.obj_setItem)
    local data = { self.CurAward[1], self.CurAward[2] }
    --self.itemLua[index]:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))
    item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))
    self.go_table.obj_setItem:SetLocalScaleXYZ(1.15)
    -- self.go_table.aorrawimage_icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(self.CurAward[1]))
    -- _G.UIUtils.SetItemNum(self.go_table, self.CurAward[2])
end

---按钮点击事件在这里派发
function PenglaiTreasureHouseSelectView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_cancel then
        self:Close()
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_enter then
        if nil == self.ChooseIndex then
            _G.PopWindowManager:GetInstance():ShowAllTips(930102)
            return
        end
        local msg = {}
        msg.sid = self.Cfg.id
        msg.activity_id = self.PlThClass.curActivityClass.activityID
        msg.index = self.ChooseIndex
        require "PenglaiTreasureHouseNet":GetInstance():ChooseAward(
                msg,
                function(data)
                    if data.ack == 1 then
                        PenglaiTreasureHouseManager:GetInstance():AddChooseId(msg.sid, msg.index)

                        if self.Callback then
                            self.Callback()
                        end
                        self:Close()
                    end
                end
        )
    end
end

function PenglaiTreasureHouseSelectView:OnDestroy()
    if self.ShowItemDelay ~= nil then
        _G.coroutine.stopwaiting(self.ShowItemDelay)
        self.ShowItemDelay = nil
    end
end

return PenglaiTreasureHouseSelectView
