local PenglaiTreasureHouseManager = require "PenglaiTreasureHouseManager"
local PenglaiTreasureHouseNet = require "PenglaiTreasureHouseNet"

---@class PenglaiLTLQView : UIBaseView	中文描述
---@field public go_table PenglaiLTLQView_GoTable GoTable
local PenglaiLTLQView = _G.BaseClass("PenglaiLTLQView", _G.UIBaseView)

function PenglaiLTLQView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param activity ActivitySynGMActivity 活动信息
function PenglaiLTLQView:OnCreate(activity)
    self.PlThClass = activity
    self:UpdateTime()
    self:UpdateInfo()
    -- _G.PlayerPrefsManager.SetInt(
    --     tostring(_G.PlayerModel:GetInstance().role_uid) .. "PengLaiShowTime",
    --     _G.TimeUtil.GetServerUnixTime()
    -- )
    -- require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.TreasureRebate.id)
    -- self.PlThClass:RefreshRedPoint()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_miyaoyintu,
        self.go_table.obj_effect,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
        end
    )
end
function PenglaiLTLQView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer=nil
    end
end

function PenglaiLTLQView:UpdateInfo()
    local isCanGet = self.PlThClass:GetRebate().old_cash_num > 0 and self.PlThClass:GetRebate().is_award == 0
    local cashNum = isCanGet and
            self.PlThClass:GetRebate().old_cash_num or
            self.PlThClass:GetRebate().cash_num
    cashNum = _G.GameUtil.RatioControl(cashNum)
    local ratio = 10000
    local ratioCfg = _G.ConfigManager.discrete_cfg[104451] --中国版返现比例 # 海外版返现比例
    if ratioCfg then
        ratio = _G.GameUtil.GetIsUseChinese() and ratioCfg[1][1] or ratioCfg[1][2]
    end
    local awardNum = math.floor(_G.GameUtil.RatioControl(cashNum * ratio, 1000))
    --钻石比率需要*10
    self.go_table.aortext_desc1.text = _G.GetLangPackValue(90032000005, _G.GameUtil.RatioControl(ratio, 100))
    self.go_table.aortext_getnum.text = awardNum
    if isCanGet then
        self.go_table.aortext_desc2.text =
            _G.GetLangPackValue(90032000008, cashNum)
        self.go_table.aortext_desc3.text = _G.GetLangPackValue(90032000009)
        self.go_table.aorbtn_getaward:SetActiveE(1)
        self.go_table.aorbtn_gotopay:SetActiveE(0)
    else
        self.go_table.aortext_desc2.text =
            _G.GetLangPackValue(90032000006, cashNum)
        self.go_table.aortext_desc3.text = _G.GetLangPackValue(90032000007)
        self.go_table.aorbtn_getaward:SetActiveE(0)
        self.go_table.aorbtn_gotopay:SetActiveE(1)
    end
end

---更新赛季事件
function PenglaiLTLQView:UpdateTime()
    self.countDown = self.PlThClass.curActivityClass.cfg.time.start_time + self.PlThClass.curActivityClass.cfg.time.run_time - _G.TimeUtil.GetServerUnixTime()
    self:RefreshTime(0)
    if self.timer == nil then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.RefreshTime, self, false, false, true)
        self.timer:Start()
    end
end

function PenglaiLTLQView:RefreshTime(elapsed)
    self.countDown = self.countDown - elapsed
    local time = _G.TimeUtil.TranslateSecondForStrMiaoHui(_G.Mathf.RoundToInt(self.countDown))
    if self.go_table then
        self.go_table.aortext_time.text = _G.GetLangPackValue(90000011044, _G.string.AddColor(time, "96CE51"))
    end
end


---按钮点击事件在这里派发
function PenglaiLTLQView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_closeview then
        self:Close()
    elseif go == self.go_table.aorbtn_gotopay then
        _G.JumpManager:GetInstance():Jump(213001)
    elseif go == self.go_table.aorbtn_getaward then
        -- local msg = {}
        -- msg.activity_id = self.PlThClass.curActivityClass.activityID
        -- PenglaiTreasureHouseNet:GetInstance():GetCashAward(msg, _G.handler(self, self.CashAwardBack))

        self.PlThClass:GetCashAward(
            function()
                local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ActivityView.Name)
                if view then
                    view:Close()
                end
                self:UpdateInfo()
            end
        )
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 141)
    end
end

function PenglaiLTLQView:CashAwardBack(msg)
    if msg.ack == 1 then
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
        self.PlThClass.Info.old_cash_num = 0
        self.PlThClass.Info.is_award = 1
        self:UpdateInfo()
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.TreasureRebate.id)
    end
end

function PenglaiLTLQView:OnStartClose()
end

return PenglaiLTLQView
