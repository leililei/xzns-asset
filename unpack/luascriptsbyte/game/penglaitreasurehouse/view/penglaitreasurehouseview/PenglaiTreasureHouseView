---按钮点击事件在这里派发
function PenglaiTreasureHouseView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 170)
    elseif go == self.go_table.aorbtn_getaward then
        if self.CurRound > self.TotalRound then
            _G.PopWindowManager:GetInstance():ShowAllTips(980102)
            return
        end

        local number = _G.StorageManager:GetInstance():GetItemCountBySid(self.PlThClass.Info.gm_cfg.item_sid)

        if number < self.ConsumeTimes then
            if _G.AppSetting.DEBUG then
                _G.Log("数量不足")
            end
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.ItemBuyView.Name,
                10011,
                _G.handler(self, self.OnBuyCall), self.ConsumeTimes - number
            )
            return
        end
        local needNum = 0
        local hasNum = 0
        local chooseId = 0

        local cfg = _G.ConfigManager.treasure_cell_cfg
        local poolInfo = self.PlThClass.Info.gm_cfg.pool_info
        local cif = self.PlThClass.Info.choose_info
        if poolInfo then
            for _, info in pairs(poolInfo) do
                if info.cell_list then
                    for _, id in ipairs(info.cell_list) do
                        if cfg[id] and cfg[id].reward and #cfg[id].reward > 1 then
                            needNum = needNum + 1
                            if cif then
                                local isHave = false
                                for i = 1, #cif do
                                    if cif[i].sid == id and cif[i].index > 0 then
                                        hasNum = hasNum + 1
                                        isHave = true
                                        break
                                    end
                                end

                                if not isHave then
                                    if chooseId == 0 then
                                        chooseId = id
                                    end
                                end
                            else
                                if chooseId == 0 then
                                    chooseId = id
                                end
                            end
                        end
                    end
                end
            end
        end

        if hasNum < needNum then
            if _G.AppSetting.DEBUG then
                _G.Log("还有可选奖励未选择")
            end

            local layer, index = self:CheckCellId(chooseId)
       
            local face = self.AllFaces[layer][index]
            _G.PopWindowManager:GetInstance():ShowAllTips(980101)

            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.PenglaiTreasureHouseSelectView.Name,
                _G.ConfigManager.treasure_cell_cfg[chooseId],
                _G.handler(self, function()
                    face:ChooseBack()
                end)
            )
            return
        end

        if self.LDing then
            if _G.AppSetting.DEBUG then
                _G.Log("抽奖中，请等待结果")
            end
            return
        end
        self.LDing = true
        ---抽奖
        local msg = {}
        msg.activity_id = self.PlThClass.curActivityClass.activityID
        msg.type = 1
        PenglaiTreasureHouseNet:GetInstance():GetAward(msg, _G.handler(self, self.SendLuckyDraw))
    elseif go == self.go_table.aorbtn_getawardonekey then
        if self.CurRound > self.TotalRound then
            _G.PopWindowManager:GetInstance():ShowAllTips(980102)
            return
        end

        local number = _G.StorageManager:GetInstance():GetItemCountBySid(self.PlThClass.Info.gm_cfg.item_sid)
        local consume = self:GetTenConsume()

        if number < consume then
