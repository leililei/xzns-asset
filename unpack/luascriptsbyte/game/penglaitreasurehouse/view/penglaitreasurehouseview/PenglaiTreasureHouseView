---判断是否显示
function PenglaiTreasureHouseView:UpdateRedPointItem()
    local activity =
        require "ActivitySynManager":GetInstance():GetChildAcitivity(
            10014,
            self.PlThClass.curActivityClass:GetJumpType(self.PlThClass.curActivityClass.activityID)
        )
    if activity then
        self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(
            activity:GetActivityTypeCls():GetRedpointIDByIndex(1)
        )

        self.go_table.aorbtn_gift:SetActiveE(1)
    else
        self.go_table.aorbtn_gift:SetActiveE(0)
    end
end

function PenglaiTreasureHouseView:SpecialHandling(sid)
    if sid == self.PlThClass.Info.gm_cfg.item_sid then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ItemBuyView.Name,
            10011,
            _G.handler(self, self.OnBuyCall)
        )
        return true
    else
        return false
    end
end

