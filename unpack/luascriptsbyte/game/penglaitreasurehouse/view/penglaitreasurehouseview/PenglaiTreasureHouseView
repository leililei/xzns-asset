    self.PlThClass:RefreshRedPoint()
end

---请求结果然后开始抽奖
function PenglaiTreasureHouseView:SendLuckyDrawOneKey(msg)
    if msg.ack == 1 then
        self.LuckyDrawSid = msg.sid
        self.LuckyDrawAward = msg
        _G.StorageManager:GetInstance():ConsumeItem(self.PlThClass.Info.gm_cfg.item_sid, nil, msg.consume)
        _G.StorageManager:GetInstance():ReceiveAwardData(self.LuckyDrawAward)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, self.LuckyDrawAward)

        self.PlThClass:GetInfo(
            function()
                self:UpdateFaceInfo()
                for i = 1, #self.AllFaces do
                    local faces = self.AllFaces[i]
                    local info = self.ItemCfgs[i]
                    for j = 1, #faces do
                        faces[j]:Reset()
                        faces[j]:UpdateFaceInfo(info.cell_list[j])
                    end
                end
                self:ClearCurLayerEff()
                self.CurLayerEff = self.Layers[self.CurLayer]
                self.CurLayerEff:SetActiveE(1)
                self.LDing = false
                self.PlThClass:RefreshRedPoint()
                self:LoadLayerEffect()
            end
        )
    else
        self.LDing = false
    end
end

---请求结果然后开始抽奖
function PenglaiTreasureHouseView:SendLuckyDraw(msg)
    if msg.ack == 1 then
        self.LuckyDrawSid = msg.sid
        self.LuckyDrawAward = msg
        _G.StorageManager:GetInstance():ConsumeItem(self.PlThClass.Info.gm_cfg.item_sid, nil, self.ConsumeTimes)
        self:StartLuckyDraw()
    else
        self.LDing = false
    end
end

---开始抽奖
function PenglaiTreasureHouseView:StartLuckyDraw()
    if self.CurLayer == self.TotalLayer then
        _G.StorageManager:GetInstance():ReceiveAwardData(self.LuckyDrawAward)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, self.LuckyDrawAward)
        --顶层不再做表现直接结算进入一轮
        local luckDrawIndex = 0
        local curAllFaces = self.AllFaces[self.CurLayer]
        for i = 1, #curAllFaces do
            local faces = curAllFaces[i]
            if faces.Cfg.id == self.LuckyDrawSid then
                luckDrawIndex = i
                break
            end
        end
        if luckDrawIndex <= 0 then
            if _G.AppSetting.DEBUG then
                _G.LogError("未找到适配的格子信息")
            end
            return
        end
        self.CurFace = curAllFaces[luckDrawIndex]
        if self.CurFace then
            PenglaiTreasureHouseManager:GetInstance():AddAwardSid(self.CurFace.Cfg.id)
            self.CurFace:SetChoose()
            self.CurFace:HideChoose()
            self.CurFace = nil
        end
        self:ClearCurLayerEff()
        self.CurRound = self.CurRound + 1
        self.PlThClass.Info.round = self.CurRound
        if self.CurRound > self.TotalRound then
            self.LDing = false
            if _G.AppSetting.DEBUG then
                _G.Log("已完成最终轮次")
            end
            self.PlThClass:RefreshRedPoint()
            return
        end
        self.PlThClass:GetInfo(
            function()
                self:UpdateFaceInfo()
                for i = 1, #self.AllFaces do
                    local faces = self.AllFaces[i]
                    local info = self.ItemCfgs[i]
                    for j = 1, #faces do
                        faces[j]:Reset()
                        faces[j]:UpdateFaceInfo(info.cell_list[j])
                    end
                end
                self.LDing = false
                self.PlThClass:RefreshRedPoint()
            end
        )
        return
    else
        self.CurLayerEff = self.Layers[self.CurLayer]
        self.CurLayerEff:SetActiveE(1)
        self:LoadLayerEffect()
        self.LDIndex = 1
        self.LDTotal = #self.AllFaces[self.CurLayer]
        self.LDTimes = 0
        self.DiDa = 0
        self.Speed = 1
        self.IsOver = false
        if not self.StopAnimation then
            if nil == self.LDTimer then
                self.LDTimer =
                    _G.TimerManager:GetInstance():GetTimer(0.03, self.LDTimerCallBack, self, false, false, true)
                self.LDTimer:Start()
            end
        else
            local len = #self.AllFaces[self.CurLayer]
            for i = 1, len do
                if self.AllFaces[self.CurLayer][i].Cfg.id == self.LuckyDrawSid then
                    self.LDIndex = i
                    break
                end
            end
            self.CurFace = self.AllFaces[self.CurLayer][self.LDIndex]
            self:DoOver()
        end
    end
end

function PenglaiTreasureHouseView:DoOver()
    if self.LDTimer then
        self.LDTimer:Stop()
        self.LDTimer = nil
    end
    self.CurFace:ShowAward(
        function(al)
            _G.StorageManager:GetInstance():ReceiveAwardData(self.LuckyDrawAward)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, self.LuckyDrawAward)
            if self.CurLayer == self.TotalLayer then
                ---本轮结束进入下一轮
                if self.CurFace then
                    self.CurFace:HideChoose()
                    self.CurFace = nil
                end
                self:ClearCurLayerEff()
                self.CurRound = self.CurRound + 1
                self.PlThClass.Info.round = self.CurRound
                if self.CurRound > self.TotalRound then
                    if _G.AppSetting.DEBUG then
                        _G.Log("已完成最终轮次")
                    end
                    self.PlThClass:RefreshRedPoint()
                    return
                end

                self.PlThClass:GetInfo(
                    function()
                        self:UpdateFaceInfo()
                        for i = 1, #self.AllFaces do
                            local faces = self.AllFaces[i]
                            local info = self.ItemCfgs[i]
                            for j = 1, #faces do
                                faces[j]:Reset()
                                faces[j]:UpdateFaceInfo(info.cell_list[j])
                            end
                        end
                        self.PlThClass:RefreshRedPoint()
                    end
                )
                return
            end

            if _G.AppSetting.DEBUG then
                _G.Log(self.CurLayer, "当前层数")
                _G.Log(al, "上升层数")
            end
            self.CurLayer = self.CurLayer + al

            if self.CurLayer < 1 then
                self.CurLayer = 1
            end
            self.PlThClass.Info.pool_index = self.CurLayer
            if _G.AppSetting.DEBUG then
                _G.Log(self.CurLayer, "跳转到达层数")
            end
            PenglaiTreasureHouseManager:GetInstance():AddAwardSid(self.CurFace.Cfg.id)
            self.CurFace:SetChoose()
            self:GotoNextLayer()
            self.PlThClass.Info.draw_times = self.PlThClass.Info.draw_times + 1
            self:UpdateConsumeTimes()
            self.LDing = false
            self.PlThClass:RefreshRedPoint()
        end
    )
end

---计时
function PenglaiTreasureHouseView:LDTimerCallBack()
    self.DiDa = self.DiDa + 1
    if self.IsOver then
        if self.DiDa > 30 then
            self:DoOver()
        end
    else
        if self.DiDa >= self.Speed then
            self.DiDa = 0
            self:DoNextFace()
        end
    end
end

---进入下一个节点
function PenglaiTreasureHouseView:DoNextFace()
    if self.CurFace then
        self.CurFace:HideChoose()
        self.CurFace = nil
    end
    self.LDIndex = self.LDIndex + 1
    if self.LDIndex > self.LDTotal then
        self.LDIndex = 1
    end
    self.CurFace = self.AllFaces[self.CurLayer][self.LDIndex]
    self.CurFace:ShowChoose()
    self.LDTimes = self.LDTimes + 1
    if self.Speed >= 10 then
        ---稳定速度至到本轮定位奖励位置
        self.Speed = 10
        if self.CurFace.Cfg.id == self.LuckyDrawSid then
            self.DiDa = 0
            self.Speed = 99999

            self.IsOver = true
        end
    elseif self.Speed > 5 then
        ---一轮快速降速
        if math.floor(self.LDTimes / self.LDTotal) * 2 >= 1 then
            self.Speed = self.Speed + 5
        end
    else
        ---两轮缓慢降速
        if math.floor(self.LDTimes / self.LDTotal) >= 3 then
            self.Speed = self.Speed + 0.5
        end
    end
end

---进入一层
function PenglaiTreasureHouseView:GotoNextLayer()
    if self.CurFace then
        self.CurFace:HideChoose()
        self.CurFace = nil
    end
    self:ClearCurLayerEff()
    self.CurLayerEff = self.Layers[self.CurLayer]
    self.CurLayerEff:SetActiveE(1)
    self:LoadLayerEffect()
end

function PenglaiTreasureHouseView:ClearCurLayerEff()
    if self.CurLayerEff then
        self.CurLayerEff:SetActiveE(0)
        self.CurLayerEff:RemoveAllChildren()
        self.CurLayerEff = nil
    end
end

function PenglaiTreasureHouseView:OnStartClose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.LDTimer then
        self.LDTimer:Stop()
        self.LDTimer = nil
    end

    ---如果有动画并且还有执行中就被关闭处理一下数据
    if not self.StopAnimation and self.LDing then
        local luckDrawIndex = 0
        local curAllFaces = self.AllFaces[self.CurLayer]
        for i = 1, #curAllFaces do
            local faces = curAllFaces[i]
            if faces.Cfg.id == self.LuckyDrawSid then
                luckDrawIndex = i
                break
            end
        end
        if luckDrawIndex <= 0 then
            if _G.AppSetting.DEBUG then
                _G.LogError("未找到适配的格子信息")
            end
            return
        end
        self.CurFace = curAllFaces[luckDrawIndex]
        self.CurFace:ShowAward(
            function(al)
                _G.StorageManager:GetInstance():ReceiveAwardData(self.LuckyDrawAward)
                if self.CurLayer == self.TotalLayer then
                    ---本轮结束进入下一轮
                    self.CurRound = self.CurRound + 1
                    self.PlThClass.Info.round = self.CurRound
                    if self.CurRound > self.TotalRound then
                        self.PlThClass:RefreshRedPoint()
                        return
                    end

                    self.PlThClass:GetInfo(
                        function()
                            self.PlThClass:RefreshRedPoint()
                        end
                    )

                    return
                end

                self.CurLayer = self.CurLayer + al

                if self.CurLayer < 1 then
                    self.CurLayer = 1
                end
                self.PlThClass.Info.pool_index = self.CurLayer

                PenglaiTreasureHouseManager:GetInstance():AddAwardSid(self.CurFace.Cfg.id)
                self.PlThClass.Info.draw_times = self.PlThClass.Info.draw_times + 1

                self.PlThClass:RefreshRedPoint()
            end
        )
    end
end

return PenglaiTreasureHouseView
