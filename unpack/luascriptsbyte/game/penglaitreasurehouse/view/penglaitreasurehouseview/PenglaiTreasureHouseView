---更新轮显示
function PenglaiTreasureHouseView:UpdateRound()
    self.go_table.toggle_noanimation:SetActiveE(self.CurRound >= _G.ConfigManager.discrete_cfg[104404][1][1] and 1 or 0)
    self.go_table.toggle_rightBtn:SetActiveE(self.CurRound >= _G.ConfigManager.discrete_cfg[104405][1][1] and 1 or 0)
    self.go_table.obj_getaward2:SetActiveE(self.CurRound >= _G.ConfigManager.discrete_cfg[104406][1][1] and 1 or 0)

    if self.CurRound > self.TotalRound then
        self.go_table.aortext_lunchi.text = _G.GetLangPackValue(90031400007, string.format("%s/%s", self.TotalRound, self.TotalRound))
    else
        self.go_table.aortext_lunchi.text = _G.GetLangPackValue(90031400007, string.format("%s/%s", self.CurRound, self.TotalRound))
    end
end

---更新抽奖次数递增消耗
function PenglaiTreasureHouseView:UpdateConsumeTimes()
    self.ConsumeTimes = self:GetConsume(self.PlThClass.Info.draw_times + 1)

    local number = _G.StorageManager:GetInstance():GetItemCountBySid(self.PlThClass.Info.gm_cfg.item_sid)


    if _G.PlayerPrefsManager.GetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "PenglaiTreasureHouseViewRightBtnIsOn") == 1 then
        self.go_table.toggle_rightBtn.isOn = true
        self.go_table.aortext_rightText.text = _G.LangUtil.GetLangPackValue(90000011749)
        self.go_table.aorrawimage_Prop2:SetActiveE(0)
        self.go_table.aortext_PropNum2:SetActiveE(0)
    else
        self.go_table.toggle_rightBtn.isOn = false
        self.go_table.aortext_PropNum.text = self.ConsumeTimes
        self.go_table.aorrawimage_Prop2:SetActiveE(1)
        self.go_table.aortext_PropNum2:SetActiveE(1)
        local consume, num = self:GetTenConsume()
        self.go_table.aortext_PropNum2.text = consume
        self.go_table.aortext_rightText.text = _G.GetLangPackValue(90028900013,
            _G.GameUtil.NumberToWordByLanguage(num))
    end
end

---更新界面
function PenglaiTreasureHouseView:UpdateView()
    local icon = _G.StorageManager:GetInstance():GetItemIcon(self.PlThClass.Info.gm_cfg.item_sid)
    self.go_table.aorrawimage_Prop:LoadImage(icon)
    self.go_table.aorrawimage_Prop2:LoadImage(icon)
    self.EndTime = self.PlThClass:GetTime()
    --取活动结束时间
    if nil == self.timer then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.timer:Start()
    end
    self:UpdateTime(0)
end

---更新时间
function PenglaiTreasureHouseView:UpdateTime(fix)
    if self.EndTime <= 0 then
        self.go_table.aortext_time.text = _G.LangUtil.GetLangPackValue(90026100053)
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        return
    else
        self.EndTime = self.EndTime - fix
        local time =
            _G.LangUtil.GetLangPackValue(90022500595) .. _G.TimeUtil.TranslateSecondForStrSixVsSix(self.EndTime)
        self.go_table.aortext_time.text = time
    end
end

function PenglaiTreasureHouseView:GetConsume(index)
    if index > #self.PlThClass.Info.gm_cfg.consume_times then
        return self.PlThClass.Info.gm_cfg.consume_times[#self.PlThClass.Info.gm_cfg.consume_times]
    else
        return self.PlThClass.Info.gm_cfg.consume_times[index]
    end
end

function PenglaiTreasureHouseView:GetTenConsume()
    local nowIndex = self.PlThClass.Info.draw_times
    local totalNum = 0
    local itemNum = _G.StorageManager:GetInstance():GetItemCountBySid(self.PlThClass.Info.gm_cfg.item_sid)
    local isPreview = itemNum < self:GetConsume(nowIndex + 1)
    for i = 1, 10 do
        local newIndex = nowIndex + i
        local count = self:GetConsume(newIndex)
        if totalNum + count > itemNum and not isPreview then
            return totalNum, i - 1
        end
        totalNum = totalNum + count
    end
    return totalNum, 10
end

