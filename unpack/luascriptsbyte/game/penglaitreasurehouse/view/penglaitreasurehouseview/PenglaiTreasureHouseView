--- 传入格子ID 检测格子在第几层第几个
function PenglaiTreasureHouseView:CheckCellId(id)
    local layer = 0
    local index = 0
    for i = 1, #self.ItemCfgs do
        for j = 1, #self.ItemCfgs[i].cell_list do
            if id == self.ItemCfgs[i].cell_list[j] then
                layer = i
                index = j
            end
        end
    end

    return layer, index
end

