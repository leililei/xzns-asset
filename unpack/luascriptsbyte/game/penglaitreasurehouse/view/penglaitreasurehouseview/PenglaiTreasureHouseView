        end
        local needNum = 0
        local hasNum = 0
        local chooseId = 0
        local cfg = _G.ConfigManager.treasure_cell_cfg
        local poolInfo = self.PlThClass.Info.gm_cfg.pool_info
        local cif = self.PlThClass.Info.choose_info or {}
        if poolInfo then
            for _, info in pairs(poolInfo) do
                if info.cell_list then
                    for _, id in ipairs(info.cell_list) do
                        if cfg[id] and cfg[id].reward and #cfg[id].reward > 1 then
                            needNum = needNum + 1
                            if cif then
                                local isHave = false
                                for i = 1, #cif do
