function PenglaiPackView:itemOnClickBtn(go, isOn, giftinfo)
    if not self.data:CheckActivityInteractable() then
        return
    end
    self.cashData = giftinfo
    self.typeClass:Chongzhi(
        giftinfo,
        function()
            if self:IsNil() then
                return
            end
            --这里保留一个回调处理领奖
            self:UpDateScorllView()
            if not self.typeClass:CheckOtherConditionExtra() then
                self.data:ChangeState(1) -- 改变状态 关闭
            end
        end
    )
end

function PenglaiPackView:UpDateScorllView()
    self.listData = {}
    local list = {}
    for i, v in ipairs(self.model_data) do
        local buy_num = self.typeClass:GetItemBuyTimes(v.id or v.sid, v.type_reset)
        local limit = v.count_limit or v.count
        if buy_num ~= limit then
            _G.table.insert(self.listData, v)
        else
            _G.table.insert(list, v)
        end
    end
    for i, v in ipairs(list) do
        _G.table.insert(self.listData, v)
    end

    self.index = 0

    if self.mlistView2 == nil then
        self.go_table.looplist2_item:InitListView(table.count(self.listData), _G.handler(self, self.RefreshItem))
        self.mlistView2 = self.go_table.looplist2_item
    else
        -- self.mlistView2:SetListItemCount(table.count(self.model_data), true)
        self.mlistView2:RefreshAllShownItem()
    end

    if self.mScorll ~= nil then

        self.go_table.scrollloopvectical_top:UpdateAllItem()
    else

        self.go_table.scrollloopvectical_top:InitItemData(#self.model_dataTop, _G.handler(self, self.RefreshListTop))
        self.mScorll = self.go_table.scrollloopvectical_top
    end
end

function PenglaiPackView:RefreshListTop(index, objGame)
    if index < 0 then
        return
    end
    local data = self.model_dataTop[1]
    local itemGoTable = _G.GetAutoGoTable(objGame, _G.handlerbind(self, self.itemOnClickBtn, data))

    itemGoTable.obj_special:SetActiveE(1)
    _G.GameUtil.AddDouYinIcon(itemGoTable.aorbtn_btnBuy, true)

    local node = itemGoTable.obj_Root
    if node:GetChildCountE() > 0 then
        for i = 1, node:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(node:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    for i = 1, #data.goods do
        local award = data.goods[i]
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            award,
            node,
            function(item)
                item.gameObject:SetLocalScale(0.8, 0.8, 0.8)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                local cfg = item.cfg or item.data.cfg
                item:ShowEffectOrder(cfg.ef_item == 1 and true or false)
                if item.SetGradeNew then
                    item:SetGradeNew(false)
                end
            end,
            function(go, isOn)
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, award[1])
            end
        )
    end

    ---@type number 付费礼包存储在Model中, 免费礼包存储在MallManager中, 需要单独处理
    local buyCount
    --if data.price > 0 then
    --    buyCount = DrawModel:GetInstance():GetGiftBuyCount(data.id)
    --else
    buyCount = self.typeClass:GetItemBuyTimes(data.id or data.sid, data.type_reset)
    --end
    itemGoTable.aortext_name.text = _G.GetLangPackValue(data.name)
    local restCount = data.count - buyCount
    itemGoTable.aortext_limit.text = _G.GetLangPackValue(utils.getLanguageId(data.type_reset, restCount <= 0), restCount, data.count)

    if restCount <= 0 then
        itemGoTable.obj_sellOut:SetActiveE(1)
        itemGoTable.aorbtn_btnBuy:SetActiveE(0)
        itemGoTable.obj_free:SetActiveE(0)
        itemGoTable.obj_price:SetActiveE(0)
        itemGoTable.aortext_rmb:SetActiveE(0)
        itemGoTable.aorbtn_btnBuy:SetGray(true)
        itemGoTable.aorbtn_btnBuy.enabled = true
    else
        itemGoTable.obj_sellOut:SetActiveE(0)
        itemGoTable.aorbtn_btnBuy:SetActiveE(1)
        itemGoTable.obj_free:SetActiveE(data.price <= 0 and 1 or 0)
        itemGoTable.aorbtn_btnBuy:SetGray(false)
        itemGoTable.aorbtn_btnBuy.enabled = true
        itemGoTable.aortext_rmb:SetActiveE(data.consume_type == 0 and 1 or 0)
        itemGoTable.obj_price:SetActiveE(data.consume_type == 0 and 0 or 1)
        if data.consume_type == 0 then
            -- if _G.GameUtil.IsNotPlatformSpecial() then
            --     ---如果是海外版本用多语言美元符号，反之国服使用元作为单位
            --     if _G.AppSetting.IsOverseas then
            --         itemGoTable.aortext_rmb.text = _G.GetLangPackValue(90000010807) ..
            --             _G.GameUtil.RatioControl(data.price)
            --     else
            --         itemGoTable.aortext_rmb.text = _G.GetLangPackValue(90000010819, _G.GameUtil.RatioControl(data.price))
            --     end
            -- else
            --     itemGoTable.aortext_rmb.text = _G.GameUtil.PlatformPrice(data.price)
            -- end
            _G.GameUtil.SetPriceByChannel(data.price, itemGoTable.aortext_rmb)
        elseif data.price > 0 then
            itemGoTable.aorrawimage_price:SetActiveE(1)
            itemGoTable.aorrawimage_price:LoadImage(_G.ConfigManager.currency_type_cfg[_G.ResPropID.Diamond].icon)
            itemGoTable.aortext_price.text = tostring(data.price)
        else
            itemGoTable.aorrawimage_price:SetActiveE(0)
            itemGoTable.aortext_price.text = _G.GetLangPackValue(90030800004)
        end

        itemGoTable.aorimage_discount:SetActiveE(data.original ~= 0 and 1 or 0)
        -- if data.original ~= 0 then
        --     itemGoTable.aortext_discount.text = _G.GetLangPackValue(90028800006,
        --         string.format("%.1f", (data.price / data.original) * 10))
        -- end
    end
end

