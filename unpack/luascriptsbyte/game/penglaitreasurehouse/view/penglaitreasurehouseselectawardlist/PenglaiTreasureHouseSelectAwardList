local PenglaiTreasureHouseManager = require "PenglaiTreasureHouseManager"
---@class PenglaiTreasureHouseSelectAwardList : Component	中文描述
---@field go_table SecretSelectView._obj_Item_GoTable
---@field awardList BaseAwardNewItem[]
local PenglaiTreasureHouseSelectAwardList = _G.BaseClass("PenglaiTreasureHouseSelectAwardList", _G.Component)

function PenglaiTreasureHouseSelectAwardList:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建对象时,入口构造函数
function PenglaiTreasureHouseSelectAwardList:OnCreate(data, chooseBack)
    self.data = data
    self.term = self.data[1].z
    self.chooseId = 0
    self.chooseBack = chooseBack
    self.PlThClass = PenglaiTreasureHouseManager:GetInstance():GetData()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.StartCloseUI, self.StartCloseView, self)
    self:InitAwardList()
end

function PenglaiTreasureHouseSelectAwardList:UpdateAward(data)
    self.data = data
    self.term = self.data[1].z
end

function PenglaiTreasureHouseSelectAwardList:Show()
    self.go_table.aortext_title.text =
        _G.string.format(_G.LangUtil.GetLangPackValue(90031400007, _G.GameUtil.NumberToChinese(self.term)))
    self:ShowAwarList()
    if self.PlThClass.Info.round < self.term then
        self.go_table.aortext_condition:SetActiveE(1)
        self.go_table.aortext_condition.text = _G.GetLangPackValue(90024700009,
            self.term - self.PlThClass.Info.round)
    else
        self.go_table.aortext_condition:SetActiveE(0)
    end
end

---更新奖励列表显示
function PenglaiTreasureHouseSelectAwardList:ShowAwarList()
    for i = 1, 4 do
        if self.data[i] then
            local id = self.data[i].zinfo[1]
            local num = self.data[i].zinfo[2]

            local count = self.data[i].zinfo[4]

            local data = _G.StorageManager:GetInstance():GetItemDataClass(id, num)
            self.awardList[i]:Show(data)
            _G.GameUtil.SetActiveByCondition(self.awardList[i].go_table.obj_choose, self.data[i].index == self.chooseIndex)

            local useTimes = self:GetUseTimes(self.data[i].sid, self.data[i].index)

            if self.PlThClass.Info.round < self.term then
                self.awardList[i].go_table.aortext_Num:SetActiveE(0)
            elseif count < 100 then
                self.awardList[i].go_table.aortext_Num:SetActiveE(1)
                if (count - useTimes) > 0 then
                    self.awardList[i].go_table.aortext_Num.text = _G.GetLangPackValue(90022501068) .. (count - useTimes)
                    --.. "/" .. count

                    local grade, type = _G.StorageManager:GetInstance():GetItemGrade(id)
                    if grade > 3 then
                        self.awardList[i]:ShowEffect(true, 0.8)
                    end
                else
                    --_G.GameUtil.SetActiveByCondition(self.awardList[i].go_table.obj_notimes, true)
                    self.awardList[i].go_table.aortext_Num.text = _G.GetLangPackValue(90032000010, (count - useTimes))
                end
            else
                self.awardList[i].go_table.aortext_Num.text = _G.GetLangPackValue(90032000011)
            end

            _G.GameUtil.SetActiveByCondition(self.awardList[i].gameObject, true)
        else
            _G.GameUtil.SetActiveByCondition(self.awardList[i].gameObject, false)
        end
    end
end

---获取物品已选择次数
function PenglaiTreasureHouseSelectAwardList:GetUseTimes(sid, index)
    if self.PlThClass.Info.choose_info then
        for k = 1, #self.PlThClass.Info.choose_info do
            local ci = self.PlThClass.Info.choose_info[k]
            if ci.sid == sid and ci.already_num then
                for i = 1, #ci.already_num do
                    if ci.already_num[i].k == index then
                        return ci.already_num[i].v
                    end
                end
            end
        end
    end
    return 0
end

---初始化奖励列表
function PenglaiTreasureHouseSelectAwardList:InitAwardList()
    self.awardList = {}
    for i = 1, 4 do
        self.awardList[i] =
            require "BaseAwardNewItem".New(
                self.go_table["obj_award" .. i],
                _G.handlerbind(self, self.OnClickAward, i),
                72,
                nil
            )
    end
end

---选择奖励
function PenglaiTreasureHouseSelectAwardList:OnClickAward(item, i)
    local id = self.data[i].zinfo[1]
    local num = self.data[i].zinfo[2]
    local useTimes = self:GetUseTimes(self.data[i].sid, self.data[i].index)

    local count = self.data[i].zinfo[4]
    if useTimes >= count then
        --LogError("次数已使用完")
        _G.PopWindowManager:GetInstance():ShowAllTips(930104)
        return
    end
    if self.PlThClass.Info.round < self.term then
        --LogError("还未达到对应轮次，无法选择")
        _G.PopWindowManager:GetInstance():ShowAllTips(930105)
        require("CommonTipManager"):GetInstance():OpenPropTip(self.gameObject, self.data[i].zinfo[1])
        return
    end
    self.chooseBack(item.gameObject, self.data[i].index, id, num, self.data[i].zinfo[1])
end

function PenglaiTreasureHouseSelectAwardList:StartCloseView(name)
    if name == _G.ConfigManager.ui_cfg.CommonTipView.Name then
        for i = 1, #self.awardList do
            self.awardList[i]:OnUpPressBigAward()
        end
    end
end

function PenglaiTreasureHouseSelectAwardList:OnLongAward(index)
    require("CommonTipManager"):GetInstance():OpenPropTip(self.gameObject, self.data[index].zinfo[1])
end

function PenglaiTreasureHouseSelectAwardList:SetChoose(chooseIndex)
    self.chooseIndex = chooseIndex
    for i = 1, #self.data do
        if self.data[i] then
            _G.GameUtil.SetActiveByCondition(self.awardList[i].go_table.obj_choose, self.data[i].index == chooseIndex)
        end
    end
end

---销毁对象时,析构函数
function PenglaiTreasureHouseSelectAwardList:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.StartCloseUI, self.StartCloseView, self)
end

function PenglaiTreasureHouseSelectAwardList:OnClickBtn(go, isOn)
    -- body
end

return PenglaiTreasureHouseSelectAwardList
