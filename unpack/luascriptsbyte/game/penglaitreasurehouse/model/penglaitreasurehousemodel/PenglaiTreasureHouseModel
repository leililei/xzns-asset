local ActivitySynManager = require "ActivitySynManager"
local base = require "ActivitySynTypeBase"
---@class PenglaiTreasureHouseModel : ActivitySynTypeBase 塔罗牌
local PenglaiTreasureHouseModel = _G.BaseClass("PenglaiTreasureHouseModel", base)

function PenglaiTreasureHouseModel:__init(activity)
    self.curActivityClass:AddStateChanged(_G.handler(self, self.OnActivityStateChanged), self)
    base.__init(self, activity)

    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

function PenglaiTreasureHouseModel:OnMallCashListener(data)
    if data.cash_rmb and data.cash_rmb > 0 then
        if self.Info and self.Info.cash_num then
            self.Info.cash_num = self.Info.cash_num + data.cash_rmb
        end
    end
end

---进入活动主体
function PenglaiTreasureHouseModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.PenglaiTreasureHouseView.Name, self.activity)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function PenglaiTreasureHouseModel:OnActivityStateChanged(_, state)
    if state == ActivitySynManager.State.Close then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.PenglaiTreasureHouseView.Name)
        if view then
            view:Close()
        end
        --活动已关闭
        _G.PopWindowManager:GetInstance():ShowAllTips(930101)
    end
end

function PenglaiTreasureHouseModel:GetInfo(call)
    self.CallBack = call
    require("ActivitySynNet"):GetInstance():InitActivity(
        self.curActivityClass:GetActivityID(),
        _G.handler(self, self.UpdateInitData)
    )
end
function PenglaiTreasureHouseModel:UpdateInitData(msg)
    if msg.ack == 1 then
        self:OnHandleGMData(msg.activity[1].self_info)
    end
end

---获取GM数据
---@param info activity.i_activity_self_info
function PenglaiTreasureHouseModel:OnHandleGMData(info)
    self:ParseData(info)
end

---解析数据
function PenglaiTreasureHouseModel:ParseData(info)
    self:SetSelfData(info)
    base.ParseData(self)
end

---获取活动代币id
function PenglaiTreasureHouseModel:GetCoinId()
    return self.Info.cfg_info.coin_id
end

---获取活动代币数量
function PenglaiTreasureHouseModel:GetCoinNum()
    return self.Info.coin
end

---初始化数据
---@param info activity.i_activity_self_info
function PenglaiTreasureHouseModel:SetSelfData(info)
    self.Info = info.treasure_house
    if _G.AppSetting.DEBUG then
        _G.Log(self.Info, "蓬莱宝库完整数据")
        _G.Log(self.Info.round, "蓬莱宝库当前轮次")
        _G.Log(self.Info.draw_times, "蓬莱宝库已抽取次数")
        _G.Log(self.Info.pool_index, "蓬莱宝库当前奖池index")
    end
    require "PenglaiTreasureHouseManager":GetInstance():SetData(self)

    self.SyTime = self:GetTime()
    if self.SyTime > 0 then
        if nil == self.SyTime then
            self.SyTimer = _G.TimerManager:GetInstance():GetTimer(1, self.GoSyTime, self, false, false, true)
            self.SyTimer:Start()
        end
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.TreasureRebate.id)
        -- self:RefreshRedPoint()
    end

    if self.CallBack then
        self.CallBack()
        self.CallBack = nil
    end
end

function PenglaiTreasureHouseModel:GoSyTime(elapsed)
    self.SyTime = self.SyTime - elapsed
    if self.SyTime <= 0 then
        self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
        self.SyTimer:Stop()
        self.SyTimer = nil
    end
end

---剩余时间计算
function PenglaiTreasureHouseModel:GetTime()
    local timeShengYu = 0
    if self.curActivityClass and self.curActivityClass.cfg then
        timeShengYu =
            self.curActivityClass.cfg.time.start_time + self.curActivityClass.cfg.time.run_time -
            _G.TimeUtil.GetServerUnixTime()
    end
    return timeShengYu
end

---绑定子活动
function PenglaiTreasureHouseModel:GetOtherActivityRedPointIds()
    return {10014}
end

---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function PenglaiTreasureHouseModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end

---检测活动条件（没开到大奖并且有券）
function PenglaiTreasureHouseModel:CheckRedPoint()
    if self.Info then
        local consumeTimes
        if self.Info.draw_times + 1 > #self.Info.gm_cfg.consume_times then
            consumeTimes = self.Info.gm_cfg.consume_times[#self.Info.gm_cfg.consume_times]
        else
            consumeTimes = self.Info.gm_cfg.consume_times[self.Info.draw_times + 1]
        end
        local number = _G.StorageManager:GetInstance():GetItemCountBySid(self.Info.gm_cfg.item_sid)
        ---如果没有完成所有轮次并抽卡资源大于需求资源
        if self.Info.round <= self.Info.gm_cfg.round and number >= consumeTimes then
            return 1
        end

    end
    return 0
end

---刷新奖励红点
function PenglaiTreasureHouseModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end
---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function PenglaiTreasureHouseModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then

        return self.checkRedPointFunc[index](self)
    end
    return 0
end

function PenglaiTreasureHouseModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    if self.curActivityClass then
        self.curActivityClass:RemoveStateChanged(_G.handler(self, self.OnActivityStateChanged), self)
    end
    if self.SyTimer then
        self.SyTimer:Stop()
        self.SyTimer = nil
    end
    base.Dispose(self)
end

return PenglaiTreasureHouseModel
