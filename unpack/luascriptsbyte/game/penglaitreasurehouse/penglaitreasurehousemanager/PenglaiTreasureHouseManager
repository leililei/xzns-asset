---@class PenglaiTreasureHouseManager : Singleton	中文描述
---@field PlThClass PenglaiTreasureHouseModel 塔罗牌数据
local PenglaiTreasureHouseManager = _G.BaseClass("PenglaiTreasureHouseManager", _G.Singleton)

---@return PenglaiTreasureHouseManager PenglaiTreasureHouseManager
function PenglaiTreasureHouseManager:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function PenglaiTreasureHouseManager:__init()
    self.rankAwardList = {}
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.UIClosed, self)
end

function PenglaiTreasureHouseManager:UIClosed(name)
    if name == _G.ConfigManager.ui_cfg.TarotPackView.Name then
        local view = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.TarotView.Name)
        if nil == view then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TarotView.Name)
        end
    end
end

---获取GM数据
function PenglaiTreasureHouseManager:GetData()
    if self.PlThClass and self.PlThClass:GetTime() > 0 then
        return self.PlThClass
    end
    return nil
end

---设置GM数据
function PenglaiTreasureHouseManager:SetData(class)
    self.PlThClass = class
end

function PenglaiTreasureHouseManager:GetTotalTimes()
    if self.PlThClass then
        return self.PlThClass.Info.all_time
    end
end

---添加一个可选奖励选中id
function PenglaiTreasureHouseManager:AddChooseId(sid, index)
    if self.PlThClass then
        if nil == self.PlThClass.Info.choose_info then
            self.PlThClass.Info.choose_info = {}
        end
        local info = {}
        info.index = index
        info.sid = sid
        table.insert(self.PlThClass.Info.choose_info, info)
    end
end

---添加一个已获得奖励
function PenglaiTreasureHouseManager:AddAwardSid(sid)
    if self.PlThClass then
        if nil == self.PlThClass.Info.award then
            self.PlThClass.Info.award = {}
        end
        table.insert(self.PlThClass.Info.award, sid)
    end
end

function PenglaiTreasureHouseManager:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.UIClosed, self)
end

return PenglaiTreasureHouseManager
