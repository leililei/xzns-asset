---完成任务
function DrawUpMaindata:ChessAward(id, call, num, nums)
    local data = {}
    data.activity_id = self.HeroTrialDataActivityID
    data.finish_type = num
    data.sids = id

    if #id < 1 then
        if call ~= nil then
            call()
        end
        return
    end
    require "DrawUpPeakNet":GetInstance():GetHeroTrialFinish(
        data,
        function(msg)
            if _G.table.count(id) > 1 then
                for _, value in pairs(id) do
                    self:IsFinishTask(value)
                end
                self.task_infoId = {}
            else
                for _, value in pairs(id) do
                    local index = nil
                    for k, v in pairs(self.task_infoId) do
                        if v == value then
                            index = k
                        end
                    end
                    if index then
                        table.remove(self.task_infoId, index)
                    end
                    self:IsFinishTask(value)
                end
            end

            if msg.ack ~= 1 then
                return
            end

            --self.is_award = 1

            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            if nums > 0 then
                _G.table.insert(msg.award.item, {type = {self.coinId, nums}})
                self:AddCoin(nums)
            end
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            self.HeroTrialData:RefreshRedPoint()

            if call ~= nil then
                call()
            end
        end
    )
end

---已完成添加
function DrawUpMaindata:IsFinishTask(id)
    if self.self_info == nil then
        self.self_info = {}
        self.self_info.finish_task = {}
    end

    if self.self_info.day_task_state == nil then
        self.self_info.day_task_state = {}
    end
    if self.self_info.line_task_state == nil then
        self.self_info.line_task_state = {}
    end

    for _, value in pairs(self.taskOne) do
        if value.id == id then
            value.i_task.state = _G.TaskEnum.ETaskState.Completed
            _G.table.insert(self.self_info.day_task_state, {k = id, v = 2})
        end
    end
    for _, value in pairs(self.taskTwo) do
        if value.id == id then
            value.i_task.state = _G.TaskEnum.ETaskState.Completed
            _G.table.insert(self.self_info.line_task_state, {k = id, v = 2})
        end
    end
end

