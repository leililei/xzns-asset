--任务注册
function DrawUpMaindata:ArenaPeakTask()
    self.taskOne = {}
    self.taskTwo = {}
    self.task_infoId = {}

    for _, value in pairs(self.task_info) do
        local states = _G.TaskEnum.ETaskState.Claimed

        local target
        if self:GetFinish_taskTask(value.type, value.id) then
            states = _G.TaskEnum.ETaskState.Completed
        end

        if value.type == 1 then
            local data = {}
            --此区缺少类型id
            for k, v in pairs(value.condition) do
                if k < _G.table.count(value.condition) then
                    _G.table.insert(data, v)
                end
            end
            target = self:IsWeek_curr(data)

            local taskDatas =
                require "DrawUpPeakTaskData".New(
                {
                    sid = value.type,
                    target = {target},
                    state = states,
                    cfg = value,
                    id = data,
                    info = self.ActivityID_hero_trial,
                    Type = 1
                }
            )
            _G.table.insert(self.taskOne, taskDatas)
        elseif value.type == 2 then
            local data = {}
            for k, v in pairs(value.condition) do
                if k < _G.table.count(value.condition) then
                    _G.table.insert(data, v)
                end
            end
            target = self:IsSeason_curr(data)
            -- target = self:IsSeason_curr(value.condition)

            local taskDatas =
                require "DrawUpPeakTaskData".New(
                {
                    sid = value.type,
                    target = {target},
                    state = states,
                    cfg = value,
                    info = self.ActivityID_hero_trial,
                    id = data,
                    Type = 2
                }
            )
            _G.table.insert(self.taskTwo, taskDatas)
        -- body
        end
    end
end

-- 当比赛成功时的回调函数
function DrawUpMaindata:OnMatchSuccessCall(msg)
    -- 如果活动ID不匹配，则返回
    if self.HeroTrialDataActivityID ~= msg.activity_id then
        return
    end
    -- 如果每日任务当前信息为空，则初始化为一个空表
    if self.self_info.day_task_curr == nil then
        self.self_info.day_task_curr = {}
    end
    -- 处理每日任务当前信息
    if msg.day_task_curr then
        for _, value in pairs(msg.day_task_curr) do
            local bool = true
            for k, v in pairs(self.self_info.day_task_curr) do
                -- 如果类型相同，则更新当前信息
                if _G.table.sameByCount(value.type, v.type) then
                    self.self_info.day_task_curr[k] = value
                    bool = false
                end
            end
            -- 如果类型不同，则插入新的当前信息
            if bool then
                _G.table.insert(self.self_info.day_task_curr, value)
            end
            self:OnDayCurr(value)
        end
    end
    -- 如果线路任务当前信息为空，则初始化为一个空表
    if self.self_info.line_task_curr == nil then
        self.self_info.line_task_curr = {}
    end
    -- 处理线路任务当前信息
    if msg.line_task_curr then
        for _, value in pairs(msg.line_task_curr) do
            local bool = true
            for k, v in pairs(self.self_info.line_task_curr) do
                -- 如果类型相同，则更新当前信息
                if _G.table.sameByCount(value.type, v.type) then
                    self.self_info.line_task_curr[k] = value
                    bool = false
                end
            end
            -- 如果类型不同，则插入新的当前信息
            if bool then
                _G.table.insert(self.self_info.line_task_curr, value)
            end
            self:Onseason_curr(value)
        end
    end
    -- 刷新红点
    self.HeroTrialData:RefreshRedPoint()
end

