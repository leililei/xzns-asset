-- 查询当前进度
function DrawUpMaindata:QueryProgress(id, num)
    local progress = 0
    if self.self_info == nil then
        return progress
    end

    if self.self_info.buff_task_curr ~= nil and id == 2 then
        for _, value in pairs(self.self_info.buff_task_curr) do
            if value.k == id then
                if value.v == 1 then
                    progress = 1
                end
            end
        end
    end
    if id == 1 then
        local star = require "IllustrationModel":GetInstance():GetCardMaxStar(self:GetCard_sid())
        if star >= num then
            progress = 1
        end
    end

    return progress
end

---查询当前id是否已领取奖励
function DrawUpMaindata:GetFinish_taskTask(type, id)
    local Task = {}
    if type == 1 then
        if self.self_info == nil or self.self_info.day_task_state == nil then
            return false
        end
        Task = self.self_info.day_task_state
    elseif type == 2 then
        if self.self_info == nil or self.self_info.line_task_state == nil then
            return false
        end
        Task = self.self_info.line_task_state
    end

    for _, value in pairs(Task) do
        if id == value.k and value.v == 2 then
            return true
        end
    end
    return false
end

