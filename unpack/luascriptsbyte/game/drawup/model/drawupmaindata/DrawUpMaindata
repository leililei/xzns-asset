end

---创建对象时,入口构造函数

function DrawUpMaindata:__init(data, info)
    _G.Events:GetInstance():AddListener(_G.eArena.SetDrawUp, self.AddCoins, self)
    _G.Events:GetInstance():AddListener(
        _G.ConfigManager.net_map.hero_trial_task_curr.Cmd,
        self.OnMatchSuccessCall,
        self
    )
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.hero_trial_rank_award.Cmd, self.RankAward, self)
    self:SetSelfData(data, info)
end

function DrawUpMaindata:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eArena.SetDrawUp, self.AddCoins, self)
    _G.Events:GetInstance():RemoveListener(
        _G.ConfigManager.net_map.hero_trial_task_curr.Cmd,
        self.OnMatchSuccessCall,
        self
    )
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.hero_trial_rank_award.Cmd, self.RankAward, self)
end

function DrawUpMaindata:RankAward(msg)
    if msg == nil then
        return
    end

    if msg.con_id ~= self.coinId then
        return
    end
    self:AddCoin(msg.add_coin)
end

--- 添加金币
--- @param data table 包含金币数据的表
function DrawUpMaindata:AddCoins(data)
    if data[1] == self.coinId then
        self:AddCoin(data[2])
    end
    if self.activity and self.activity.typeClass then--在礼包界面跨天刷新会导致没有更新到活动数据，加个容错
        self.activity.typeClass:RefreshRedPoint()
    end
end

function DrawUpMaindata:SetSelfData(activity, info)
    self.self_infoId = {}
    self.activity = activity
    self.info = info
    --GM配置
    self.cfg = info.cfg
    ---当前抽卡活动id
    self.Id = info.cfg.sid
    --当前保底累积次数limited_item
    self.times = info.times or {}
    --总招募次数
    self.total_times = info.total_times or 0
    ---今日抽卡次数
    self.daY_times = info.daY_times or 0
    self.ActivityID = activity.activityID
    --已领取招募次数奖励
    self.award = info.award or {}
    --心愿单卡牌sid
    self.wish_card = info.wish_card or 0

    --招募卷数量
    self.prop_num = info.prop_num or 0
    local coinId = 106 --默认值
    if self.cfg.coin_type and not _G.string.IsNullOrEmpty(self.cfg.coin_type) then
        coinId = _G.tonumber(self.cfg.coin_type)
    end
    self:SetCoin(self.prop_num, coinId)
    ---持续时间
    self.run_time = activity.cfg.time.run_time
    ---开始时间
    self.start_time = activity.cfg.time.start_time
    ---赛季奖励
    self.limited_roller_cfg = _G.ConfigManager.limited_roller_cfg[self.Id]
    --角色spine
    self.role_spine = info.cfg.role_spine
    ---角色拍脸图
    self.word = info.cfg.word
    ---拍脸图特效
    self.word_effects = info.cfg.word_effects
    ---拍脸图特效位置
    self.word_dev = info.cfg.word_dev
    ---限时道具及其权重（卡牌id）
    self.limited_itemId = self.limited_roller_cfg.limited_item
    local sid = self.limited_itemId[1][1]
    self.spBol = _G.ConfigManager.card_cfg[sid].Order == 7
    --ZHJH-8378 如果有多个可选项不默认选择
    if self.wish_card <= 0 and (#self.limited_itemId == 1 or self.spBol) then
        --如果没有选心愿角色默认选中第一个
        self.wish_card = self.limited_itemId[1][1]
    end

    -- require "RedPointManager:GetInstance()":GetInstance():AddRedPointChild(1030, self.activity.typeClass:GetRedpointIDByIndex(1))

    ---当前概率提升
    -- self.guaranteed_init = _G.ConfigManager.limited_roller_cfg.limited_roller_cfg[self.Id].guaranteed_init

    local data = _G.ConfigManager.limited_roller_cfg[info.cfg.sid]
    if not data and _G.AppSetting.DEBUG then
        _G.LogError("invaild limited_roller_cfg.id=" .. info.cfg.sid)
    end
    ---已使用魂玉召唤次数
    self.diamond_times = info.diamond_times or 0
    ---总共可使用魂玉次数(配置表丶服务器数据总和, 暂无服务器数据)
    self.diamond_total_times = data and data.count_diamond or 0
    ---魂玉单抽消耗数量
    self.diamond_consume_num = data and data.ticket_2[1] or 0
end

---剩余保底次数
function DrawUpMaindata:GetLeftGuaranteed()
    local initTimes = self.limited_roller_cfg.guaranteed_init
    if self.total_times < initTimes then
        ---初次保底
        return initTimes - self.times
    end

    return self.limited_roller_cfg.pseudo - self.times
end

