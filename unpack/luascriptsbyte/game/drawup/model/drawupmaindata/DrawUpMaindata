function DrawUpMaindata:Role_SpineParse()
    --角色ID|跳转ID|背景#坐标|角色名称|spine#坐标#缩放|美术字路径#坐标
    if self.word == nil or self.word == "Test" then
        return
    end

    self.role_spineList = {}
    self.role_spineList.int = 2
    local dev = _G.string.split(self.word, "|")
    for key, value in pairs(dev) do
        if key == 1 then
            self.role_spineList.id = _G.tonumber(value)
        elseif key == 2 then
            self.role_spineList.jump_id = _G.tonumber(value)
        elseif key == 3 then
            self.role_spineList.bg = value
        elseif key == 4 then
            if _G.tonumber(value) then
                self.role_spineList.name = _G.LangUtil.GetLangPackValue(_G.tonumber(value))
            else
                self.role_spineList.name = value
            end
        elseif key == 5 then
            self.role_spineList.spice = value
        elseif key == 6 then
            self.role_spineList.slogan = value
        end
    end
    self.role_spineList.word_effects = self.word_effects
    self.role_spineList.word_dev = self.word_dev
    return self.role_spineList
end

