function DrawUpMaindata:ReadyFight()
    local fighterSids = require("EmbattleModel"):GetInstance():GetEmbattleSidsData(_G.EmbattleType.DrawUpPeak)
    local is = true
    for key, value in pairs(fighterSids) do
        if value == self:GetCard_sid() then
            is = false
            self:AddQueryProgress(1)
        end
    end
    if is then
        self:AddQueryProgress(0)
    end
end

---进入战斗
---@return void
function DrawUpMaindata:EnterFight()
    self:ReadyFight()
    local fight = {activity_id = self.HeroTrialDataActivityID}
    _G.BattleManager:GetInstance():EnterFight(_G.BattleControllerType.DrawUpPeak, fight, self.ActivityID)
end

---跳过战斗直接显示结算页面
---@return void
function DrawUpMaindata:SkipFight()
    self:ReadyFight()
    _G.BattleManager:GetInstance():SetInBattle(true)
    local pbData = {activity_id = self.HeroTrialDataActivityID}
    require("DrawUpPeakNet"):GetInstance():GetHeroTrial(
        pbData,
        function(msg)
            if not msg or msg.ack ~= 1 then
                _G.BattleManager:GetInstance():SetInBattle(false)
                return
            end
            --计算战斗结果
            _G.BattleManager:GetInstance():SetArgDataAutoCmd(msg.fight_arg)
            local record = _G.BattleManager:GetInstance():GetStatisticsRecord(msg.fight_arg)
            if not record or not record.result then
                _G.BattleManager:GetInstance():SetInBattle(false)
                return
            end

            ---@type BattleControllerDrawUpPeak
            local controller = _G.require(_G.BattleControllerType.DrawUpPeak).New()
            controller.ActivityID = self.ActivityID --设置活动id参数
            controller.curFightState = 4 --设置战斗结束

            _G.BattleManager:GetInstance():SetArgData(msg.fight_arg)
            _G.BattleManager:GetInstance():SetStatisticsCached(record)
            _G.BattleManager:GetInstance():SetBattleController(controller)
            --显示结算界面
            controller:FightResultFunc(record.result)
        end
    )
end

