    local key =
        _G.PlayerModel:GetInstance():GetPlayerUid() ..
        "DrawUpBattlePass" .. self.curActivityClass:GetActivityID() .. endTime
    ---首次开启
    if _G.PlayerPrefsManager.GetInt(key) ~= 1 then
        return 1
    end
    --ZHJH5ZHJH-12810 国庆节活动ZHJH-13792
    --【国庆活动】战令红点消不掉
    -- 加速按钮默认关闭了，先把红点逻辑注销
    -- local delta = _G.ConfigManager.discrete_cfg[108601][1][1]
    -- ---加速按钮开启
    -- if _G.PlayerPrefsManager.GetInt(key .. "Add") ~= 1 and _G.TimeUtil.GetServerUnixTime() >= endTime - delta * 86400 then
    --     return 1
    -- end
    return 0
end

function TenOneGMBattlePassData:SetOnSixUpdateCall(name, callback)
    if not self.onSixUpdateCall then
        self.onSixUpdateCall = {}
    end
    self.onSixUpdateCall[name] = callback
end

function TenOneGMBattlePassData:GetJumpModelType()
    return self.typeID or 10027
end

function TenOneGMBattlePassData:GetCoinId()
    return require "TenOneModel":GetInstance():GetCoinId(self:GetActivityID())
end

function TenOneGMBattlePassData:GetTitle()
    return "ui_sqtj_sqbd_txt"
end

function TenOneGMBattlePassData:InitJump()
    self.GetJumpType =
        require "ActivitySynManager":GetInstance():GetChildAcitivity(
        self:GetJumpModelType(),
        self.curActivityClass:GetJumpType(),
        self.curActivityClass:GetMainType()
    )
    if self.GetJumpType then
        self.ActivityID = self.GetJumpType.activityID
        require "TenOneModel":GetInstance():ParseData(self.ActivityID, self.msg, self.activity)
    end
end

return TenOneGMBattlePassData
