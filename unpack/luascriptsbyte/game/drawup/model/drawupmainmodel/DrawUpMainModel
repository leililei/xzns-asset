        _G.PopWindowManager:GetInstance():ShowAllTips(870102)

        return
    end
    data.activity.typeClass:GetAward(
        {num},
        function(msg)
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            self:InAward(ActivityID, num)
            data.activity.typeClass:RefreshRedPoint()
            if call ~= nil then
                call()
            end
        end
    )
end

