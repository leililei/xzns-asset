function DrawUpMainModel:SetSelfData(info, activity)
    ---活动数据保存字典，key值为活动id
    if self.activityList == nil then
        self.activityList = {}
    end
    if self.activityIDList == nil then
        self.activityIDList = {}
    end
    local infoData = require "DrawUpMaindata".New(activity, info)
    -- infoData:Parse(activity, info)
    local ActivityID = infoData:RetActivityID()
    if not self.activityList[ActivityID] then
        self.activityList[ActivityID] = infoData
    else
        self.activityList[ActivityID]:SetSelfData(activity, info)
    end
    local coinId = 106 --默认值
    if infoData.cfg.coin_type and not _G.string.IsNullOrEmpty(infoData.cfg.coin_type) then
        coinId = _G.tonumber(infoData.cfg.coin_type)
    end
    local window = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DrawUpMainView.Name)
    if window then
        if window.goldT then
            window.goldT:ResRefresh()
        end
        window:Shuaxing()
    end
    self.infoData = infoData
    if require "DemoModel":GetInstance().cards then
        self:InitFunction()
    end
    --require "DrawUpCoinModel":GetInstance():SetCoin(ActivityID, infoData.prop_num, coinId)

    -- require "RedPointManager":GetInstance():AddRedPointChild(1030, self.activity.typeClass:GetRedpointIDByIndex(1))

    ---当前概率提升
    -- self.guaranteed_init = _G.ConfigManager.limited_roller_cfg.limited_roller_cfg[self.Id].guaranteed_init
end

function DrawUpMainModel:InitFunction()
    if self.infoData and self.infoData.info.card_trial then
        local card = self.infoData.info.card_trial
        if not self.infoData.info.card_trial.uid then--卡牌数据可能在数组里，加个容错取数组里的数据
            card = card[1]
        end
        require "DemoModel":GetInstance():AddCard(card)
    end
end

