---抽卡
---@param ActivityID number 活动ID
---@param consumeType number _1活动代币 2魂玉
function DrawUpMainModel:DrawCard(ActivityID, consumeType, num, type, call, IsEff)
    local data = self.activityList[ActivityID]

    if self:GetTime(ActivityID) <= 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(870102)
        return
    end

    if self:GetdaY_times(ActivityID) + num > data.limited_roller_cfg.limit_daily then
        _G.PopWindowManager:GetInstance():ShowAllTips(130102)
        return
    end
    local list = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    if _G.table.count(list) + num > _G.StorageManager:GetInstance():GetStorageCapacity(_G.StorageID.Card) then
        _G.PopWindowManager:GetInstance():ShowAllTips(130101)
        return
    end

    require("DrawUpMainModel"):GetInstance().JianGe = true

    local msg = {}
    msg.activity_id = ActivityID
    msg.consume_type = consumeType
    msg.draw_times = num
    require "DrawUpMainNet":GetInstance():GetModuleExecuteAccess(
        msg,
        _G.handlerbind(self, self.DrawCardSuc, consumeType, num, type, call, IsEff, ActivityID)
    )
end

---抽卡返回
---@param consumeType number _1活动代币 2魂玉
function DrawUpMainModel:DrawCardSuc(data, consumeType, num, type, call, IsEff, ActivityID)
    require("DrawUpMainModel"):GetInstance().JianGe = false
    if data.ack ~= 1 then
        return
    end
    local datas = self.activityList[ActivityID]

    if consumeType == _G.DrawConsumeType.token then
        --消耗招募券
        require "DrawUpCoinModel":GetInstance():AddCoin(ActivityID, -num)
    elseif consumeType == _G.DrawConsumeType.diamond then
        --消耗魂玉
        local consumeNum = self:GetDiamondConsume(ActivityID, num)
        if type == _G.DrawType.TenTimes then
            local limited_roller_cfg = require "DrawUpMainModel":GetInstance():Getlimited_roller_cfg(ActivityID)
            local discount = limited_roller_cfg.ticket_discount[1]
            if nil ~= discount then
                consumeNum = _G.Mathf.Floor(consumeNum * discount / 10000)
            end
        end
        self:AddDiamondTimes(ActivityID, num)
        _G.StorageManager:GetInstance():ConsumeItem(_G.ResPropID.Diamond, 0, consumeNum)
    end

    self.total_times = self:AddTotalTimes(ActivityID, num)
    self.daY_times = self:AdddaY_times(ActivityID, num)

    datas.activity.typeClass:RefreshRedPoint()
    ---策划需求，抽到大奖就清零，肯定会被骂的
    --self.times = self:AddTimes(ActivityID, num)
    local Elements = 0
    local is = nil
    local cardCfg = _G.ConfigManager.card_cfg
    local crad = 1
    if data.award.item ~= nil then
        for k, v in ipairs(data.award.item) do
            self.times = self:AddTimes(ActivityID, 1)
            local _, Type = _G.StorageManager:GetInstance():CheckSidType(v.type[1])
            if Type and Type == _G.StorageID.Card then
                Elements = cardCfg[v.type[1]].Elements
                is = v.type
                self:AddTimes(ActivityID, -self.times)
                crad = 2
            end
        end
    end
    if is then
        if not require "IllustrationModel":GetInstance():HunjiangJieSuo(is[1]) then
            --require "IllustrationModel":GetInstance().NewChoKa[is[1]] = false

            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.DrawResultRoleView.Name,
                cardCfg[is[1]],
                function()
                    IsEff(
                        crad,
                        function()
                            _G.UIManager:GetInstance():OpenWindow(
                                _G.ConfigManager.ui_cfg.CommonAwardView.Name,
                                data,
                                nil,
                                true
                            )
                        end,
                        Elements
                    )
                end,
                is[3]
            )
        else
            IsEff(
                crad,
                function()
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data, nil, true)
                end,
                Elements
            )
        end
    else
        IsEff(
            crad,
            function()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data, nil, true)
            end,
            Elements
        )
    end
    _G.StorageManager:GetInstance():ReceiveAwardData(data)
    if data.award.overflow ~= nil then
        datas.activity:OnReConnect()
        _G.PopWindowManager:GetInstance():ShowAllTips(380104)
    else
        if call ~= nil then
            call(num)
        end
    end
    -- if data.award.item ~= nil then
