function DrawUpMainModel:GetIdRde()
    if self.activityList == nil or _G.table.count(self.activityList) <= 0 then
        return 0
    end
    for key, value in pairs(self.activityList) do
        local data = value:RetActivityID()
        if not self.activityIDList[data] then
            -- body
            local time = _G.PlayerPrefsManager.GetInt("DrawUpMainModel" .. data)
            if
                time == 0 or
                    _G.PlayerPrefsManager.GetInt("DrawUpMainModel" .. data) ~=
                        _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
             then
                return data
            end
        end
    end
    return 0
end

