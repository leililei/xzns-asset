---设置心愿卡牌
---@param ActivityID number 活动id
---@param sid number 卡牌sid
---@param callback function 回调
function DrawUpMainModel:SetWishCard(ActivityID, sid, callback)
    local pbData = {activity_id = ActivityID, card_sid = sid}
    require("DrawUpMainNet"):GetInstance():SetWishCard(
        pbData,
        function(msg)
            if msg.ack == 1 then
                local data = self.activityList[ActivityID]
                data:SetWishAward(sid)
                if callback then
                    callback()
                end
            end
        end
    )
end

function DrawUpMainModel:RefreshAllHeroGiftRedPoint()
    if self.activityList == nil then
        return
    end
    for _, v in pairs(self.activityList) do
        if v.activity and v.activity.typeClass then
            v.activity.typeClass:RefreshRedPoint(2)
            v.activity.typeClass:RefreshRedPoint(5)
        end
    end
end

function DrawUpMainModel:RemoveActivityData(id)
    if id and self.activityList[id] then
        self.activityList[id]:Dispose()
        self.activityList[id] = nil
    end
end
