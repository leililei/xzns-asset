function DrawUpMainGmModel:CheckRedPoint()
    if self.activity then
        return require "DrawUpMainModel":GetInstance():HongDian(self.activity.activityID)
    end
    return 0
end

function DrawUpMainGmModel:CheckHeroGiftRedPoint()
    if self.activity then
        return require "DrawUpMainModel":GetInstance():RedPointHeroGift(self.activity.activityID,1)
    end
    return 0
end

function DrawUpMainGmModel:CheckHeroSkillRedPoint()
    if self.activity then
        return _G.PlayerPrefsManager.GetInt("HeroSkillRedPoint" .. self.activity.activityID, 1)
    end
    return 0
end

function DrawUpMainGmModel:CheckWishRedPoint()
    if self.activity then
        local sid = require "DrawUpMainModel":GetInstance():GetItemId(self.activity.activityID)
        return sid == 0 and 1 or 0
    end
    return 0
end

function DrawUpMainGmModel:GetSkinGiftData()
    ---@type HeroGiftPackSynModel
    local model = require "HeroGiftPackSynModel":GetInstance()
end

function DrawUpMainGmModel:CheckSkinGiftRedPoint()
    if self.activity then
        ---@type HeroGiftPackSynModel
        local model = require "HeroGiftPackSynModel":GetInstance()
        ---@type HeroGiftPackData
        local dataList = model:GetSkinGiftData()

        if dataList then
            local data = dataList.item[1]
            local isReceived = dataList:Alist(data.sid)
            local data = dataList.item[1]
            local itemId = data.normal_award[1].type[1]
            local itemcfg = ConfigManager.item_cfg[itemId]
            local skinId = tonumber(itemcfg.UseParameter[1][1])
            local skincfg = ConfigManager.skin_cfg[skinId]
            local cardcfg = ConfigManager.card_cfg[skincfg.card]
            local card = _G.StorageManager:GetInstance():GetMaxStarCardBySid(cardcfg.id)
            if card and isReceived == false and data.condition <= card.star then
                return 1
            elseif self.dressRedLogin == true and isReceived == false then
                return 1
            end
        end
        return 0
    end
    return 0
end


---刷新奖励红点
function DrawUpMainGmModel:RefreshRedPoint(param)
    param = param or 1
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(param))
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function DrawUpMainGmModel:CheckRedPointNumChild(index, _)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---设置主界面“新”字样式
function DrawUpMainGmModel:SetNewTb(go_table)
    go_table.aorimage_new:SetActiveE(1)
end

