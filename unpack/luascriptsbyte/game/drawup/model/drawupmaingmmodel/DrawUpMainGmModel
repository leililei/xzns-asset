local base = require "ActivitySynTypeBase"
---@class DrawUpMainGmModel : ActivitySynTypeBase	中文描述
local DrawUpMainGmModel = _G.BaseClass("DrawUpMainGmModel", base)

function DrawUpMainGmModel:__init()
    self.activityId = self.curActivityClass:GetActivityID()
    self.curActivityClass:AddStateChanged(self.OnActivityStateChanged, self)
end

function DrawUpMainGmModel:OnActivityStateChanged(state)
    if state == require "ActivitySynManager".State.Close then
        require "DrawUpMainModel":GetInstance():RemoveActivityData(self.activityId)
    end
end

function DrawUpMainGmModel:OnHandleGMData(info)
    self:ParseData(info)
end

function DrawUpMainGmModel:ParseData(info)
    self.activity = self.curActivityClass
    self.dressRedLogin = true
    require "DrawUpMainModel":GetInstance():SetSelfData(info.lucky_draw, self.curActivityClass)
    base.ParseData(self)
end

---进入活动主体
function DrawUpMainGmModel:OnEnterActivity()
    self.limited_item = require "DrawUpMainModel":GetInstance():Getlimited_itemId(self.activityId)
    local sid = self.limited_item[1][1]
    local cardcfg = _G.ConfigManager.card_cfg[sid]
    if cardcfg.Order == 7 then 
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SPDrawUpMainView.Name, self.activity)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DrawUpMainView.Name, self.activity)
    end
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function DrawUpMainGmModel:AddCoin(num)
    require "DrawUpMainModel":GetInstance():AddCoin(self.activityId, num)
end

function DrawUpMainGmModel:OnGetMainViewName()
    self.limited_item = require "DrawUpMainModel":GetInstance():Getlimited_itemId(self.activityId)
    local sid = self.limited_item[1][1]
    local cardcfg = _G.ConfigManager.card_cfg[sid]
    if cardcfg.Order == 7 then 
        return _G.ConfigManager.ui_cfg.SPDrawUpMainView.Name
    else
        return _G.ConfigManager.ui_cfg.DrawUpMainView.Name
    end
end

---领取奖励
---@param callback function 回调
function DrawUpMainGmModel:GetAward(index, callback)
    self:GetActivityAward(index, callback)
end

function DrawUpMainGmModel:GetOtherActivityRedPointIds()
    return {10027, 10007, 10014, 10030, 10088}
end

