---@class DrawUpBattlePassTaskInfoData	限时招募
local DrawUpBattlePassTaskInfoData = _G.BaseClass("DrawUpBattlePassTaskInfoData", _G.LogicClass)

function DrawUpBattlePassTaskInfoData:__init(activity)
    self.activity = activity
    self.curActivityClass = self.activity.curActivityClass
end
---进入活动
function DrawUpBattlePassTaskInfoData:OnEnterActivity()
    if _G.AppSetting.IsXzns and self.curActivityClass.cfg.info.front.main_type == 7 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DrawUpTaskView.Name, self.curActivityClass)
        return
    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DrawUpBattlePassTaskView.Name, self.curActivityClass)
end
---领取奖励
function DrawUpBattlePassTaskInfoData:GetAward(ids,call,type_id)
    require "DrawUpBattlePassTaskNet":GetInstance():GetAward(
        {activity_id = self.curActivityClass:GetActivityID(), task_sid = ids, finish_type = 2},
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            local GetJumpType =
                require "ActivitySynManager":GetInstance():GetChildAcitivity(self:GetJumpModelType(), self.curActivityClass:GetJumpType())
            if GetJumpType == nil then
                GetJumpType =
                require "ActivitySynManager":GetInstance():GetChildAcitivity(type_id, self.curActivityClass:GetJumpType())
            end
            local ActivityID = GetJumpType:GetActivityID()
            local exp = 0
            local coin = 0
            for _, v in pairs(ids) do
                local task = self.activity:GetTaskData(v)
                if not msg.award or not msg.award.item then
                    msg.award = {item = {}}
                end
                if task.Cfg.other_award[2] then
                    local coinId = require "DrawUpCoinModel":GetInstance():GetCoinId(ActivityID)
                    local tb = _G.StorageManager:GetInstance():SimulationAward(coinId, task.Cfg.other_award[2].num)
                    _G.table.insert(msg.award.item, {type = tb})
                    coin = coin + task.Cfg.other_award[2].num
                end
                if task.Cfg.other_award[1] then
                    exp = exp + task.Cfg.other_award[1].num
                end

                self.activity.finishTask[v] = true
            end
            require "CommonTipManager".OpenCommonAwardView(msg)
            self.activity:RefreshRedPoint()
            require "DrawUpCoinModel":GetInstance():AddCoin(ActivityID, coin)
            require "DrawUpMainModel":GetInstance():AddExp(ActivityID, exp)

            if call then
                call()
            end
        end
    )
end
function DrawUpBattlePassTaskInfoData:GetJumpModelType()
    return 10028
end
return DrawUpBattlePassTaskInfoData
