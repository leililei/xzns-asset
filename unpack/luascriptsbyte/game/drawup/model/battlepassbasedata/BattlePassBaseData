--- 原BattlePassData 走DrawUpMainModel逻辑
--- 现将其从中分离出来，使得能够独立执行逻辑

---@class BattlePassBaseData : LogicClass	中文描述
local BattlePassBaseData = _G.BaseClass("BattlePassBaseData", _G.LogicClass)

---类的构造函数
function BattlePassBaseData:__init(activity)
    self.activity = activity
    self.curActivityClass = self.activity.curActivityClass
end

---获取GM数据
function BattlePassBaseData:OnHandleGMData(info)
    self:ParseData(info)
end

---@param msg activity.i_activity_self_info
function BattlePassBaseData:ParseData(msg)
    self.BattlePassinfo = msg.battle
    self.BattlePasscfgLis = self.BattlePassinfo.cfg_list
    self.BattlePasssid = self.BattlePasscfgLis.sid
    self.BattlePassfreeAwards = {}
    self.BattlePasspayAwards = {}
    if self.BattlePassinfo.free_award_list then
        for i = 1, #self.BattlePassinfo.free_award_list do
            self:SetAward(self.BattlePassinfo.free_award_list[i], false)
        end
    end
    if self.BattlePassinfo.pay_award_list then
        for i = 1, #self.BattlePassinfo.pay_award_list do
            self:SetAward(self.BattlePassinfo.pay_award_list[i], true)
        end
    end
    if self.onSixUpdateCall then
        for _, call in pairs(self.onSixUpdateCall) do
            call()
        end
    end
end

function BattlePassBaseData:SetAward(id, isUp)
    if isUp then
        self.BattlePasspayAwards[id] = true
    else
        self.BattlePassfreeAwards[id] = true
    end
end

---是否购买高级战令
function BattlePassBaseData:GetIsUp()
    return self.BattlePassinfo.is_up == 1
end

---购买高级战令
function BattlePassBaseData:BuyUp()
    require("MallManager"):GetInstance():BuyActiveGift(
        self.BattlePassinfo.price,
        self.activity:GetActivityID(),
        self.BattlePassinfo.sid
    )
end

---一键领取
function BattlePassBaseData:GetAwardAll(unclaimed, callback)
    if unclaimed == nil then
        unclaimed = self:FindAllUnclaimedRewards() or {}
    end
    if #unclaimed == 0 then
        return
    end
    local pbData = {activity_id = self.activity:GetActivityID(), award_list = unclaimed}
    require("DrawUpBattlePassNet"):GetInstance():GetAward(
        pbData,
        function(data)
            if data.ack == 1 then
                _G.StorageManager:GetInstance():ReceiveAwardData(data)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
                for _, v in pairs(unclaimed) do
                    if v.type == 1 then
                        self.BattlePasspayAwards[v.a_id] = true
                    else
                        self.BattlePassfreeAwards[v.a_id] = true
                    end
                end
                self:RefreshRedPoint()
                if callback then
                    callback(data)
                end
            end
        end
    )
end

---领取奖励
function BattlePassBaseData:GetAward(id, isUp, callback)
    require("DrawUpBattlePassNet"):GetInstance():GetAward(
        {
            activity_id = self.activity:GetActivityID(),
            award_list = {{type = isUp and 1 or 0, a_id = id}}
        },
        function(data)
            if data.ack ~= 1 then
                return
            end
            if callback then
                callback()
            end
        end
    )
end

---该奖励是否已领取
function BattlePassBaseData:IsAward(id, isUp)
    if isUp then
        return self.BattlePassfreeAwards[id] and true or false
    else
        return self.BattlePasspayAwards[id] and true or false
    end
end

---设置奖励已领取
function BattlePassBaseData:SetAward(id, isUp)
    if isUp then
        self.BattlePasspayAwards[id] = true
    else
        self.BattlePassfreeAwards[id] = true
    end
end

---查找所有未领取奖励
function BattlePassBaseData:FindAllUnclaimedRewards()
    ---@type limited_battlecon_cfg
    local item
    local unclaimed = {}
    local sum = 0
    for _, id in pairs(self.BattlePasscfgLis.award_id_list) do
        item = _G.ConfigManager.limited_battlecon_cfg[id]
        if self.BattlePassinfo.battle_exp >= sum then
            if not self.BattlePassfreeAwards[id] then
                _G.table.insert(unclaimed, {type = 0, a_id = id})
            end
            if self:GetIsUp() and not self.BattlePasspayAwards[id] then
                _G.table.insert(unclaimed, {type = 1, a_id = id})
            end
        else
            break
        end
    end
    return unclaimed
end

function BattlePassBaseData:GetAwardList()
    return self.BattlePasscfgLis.award_id_list
end

--- 获取配置列表
function BattlePassBaseData:Getcfg_list()
    return self.BattlePasscfgLis
end
--- 获取经验
function BattlePassBaseData:Getbattle_exp()
    return self.BattlePassinfo.battle_exp
end
--- 获取兑换经验
function BattlePassBaseData:Getex_change()
    return self.BattlePassinfo.ex_change
end

function BattlePassBaseData:SetOnSixUpdateCall(name, callback)
    if not self.onSixUpdateCall then
        self.onSixUpdateCall = {}
    end
    self.onSixUpdateCall[name] = callback
end

---获取第一个可领奖励的下标
function BattlePassBaseData:GetFirstAwardIndex()
    local lv = self:GetLvAndCurLvExp()
    for i = 1, lv do
        if self:IsAward(i,true) then
            return i
        end
    end
    return 1
end

---获得当前战令等级和进度以及下一级的进度
function BattlePassBaseData:GetLvAndCurLvExp()
    ---@type limited_battlecon_cfg
    local cfg = _G.ConfigManager.limited_battlecon_cfg
    local item
    local sum, lv, curIndex, maxExp = 0, 0, 0, 0
    for i = 1, #self.BattlePasscfgLis.award_id_list do
        item = cfg[self.BattlePasscfgLis.award_id_list[i]]
        sum = sum + item.conditions[1]
        maxExp = item.conditions[1]
        if self.BattlePassinfo.battle_exp >= sum then
            lv = item.level
            curIndex = i
        else
            sum = sum - item.conditions[1]
            break
        end
    end
    local curExp = self.BattlePassinfo.battle_exp - sum
    return lv, curExp, maxExp
end

--region 子类重写
function BattlePassBaseData:OnEnterActivity()
    if _G.AppSetting.DEBUG then
        _G.LogError("没有重写OnEnterActivity方法，请在子类中实现")
    end
end

---检测红点
function BattlePassBaseData:CheckRedPoint()
    ---可领奖
    if not _G.table.isEmptyOrNil(self:FindAllUnclaimedRewards()) then
        return 1
    end
    local endTime, _ = self.curActivityClass:GetActivityDeadLineByCondition(require("ActivitySynManager").State.Close)
    local key =
        _G.PlayerModel:GetInstance():GetPlayerUid() ..
        "BattlePass" .. self.curActivityClass:GetActivityID() .. endTime
    ---首次开启
    if _G.PlayerPrefsManager.GetInt(key) ~= 1 then
        return 1
    end
end

