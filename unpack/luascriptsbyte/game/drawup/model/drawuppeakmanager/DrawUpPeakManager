local base = require "ActivitySynTypeBase"
local DrawUpPeakNet = require "DrawUpPeakNet"
local ActivitySynManager = require("ActivitySynManager")
local DrawUpBattlePassManager = require("DrawUpBattlePassManager")
local RedPointManager = require("RedPointManager"):GetInstance()
---@class DrawUpPeakManager : ActivitySynTypeBase
---	中文描述
local DrawUpPeakManager = _G.BaseClass("DrawUpPeakManager", base)

---获取GM数据
function DrawUpPeakManager:OnHandleGMData(info)
    self:ParseData(info)
end

---@param msg activity_hero_trial.i_activity_hero_trial
function DrawUpPeakManager:ParseData(msg)
    self.GetJumpType =
        require "ActivitySynManager":GetInstance():GetChildAcitivity(10028, self.curActivityClass:GetJumpType())
    self.ActivityID = self.GetJumpType.activityID
    require "DrawUpMainModel":GetInstance():HeroTrialParseData(self.ActivityID, msg, self)

    base.ParseData(self)
    if self.onSixUpdateCall then
        for key, call in pairs(self.onSixUpdateCall) do
            call()
        end
    end

    --更新红点状态
    self:RefreshRedPoint()
end

---主界面不显示
function DrawUpPeakManager:IsShowBtn(ActivityID)
    return false
end

---进入活动
function DrawUpPeakManager:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DrawUpPeakView.Name, self)
    base.OnEnterActivity(self)
end

---初始化红点
function DrawUpPeakManager:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function DrawUpPeakManager:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---刷新红点
function DrawUpPeakManager:RefreshRedPoint()
    RedPointManager:RefreshNode(self:GetRedpointIDByIndex(1))
end

---检测红点
function DrawUpPeakManager:CheckRedPoint()
    local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DrawUpPeakView.Name)
    if ctrl then
        ctrl:HongDian()
    end
    ---可领奖
    local num = require("DrawUpMainModel"):GetInstance():TaskInfoId(self.ActivityID)
    if #num >= 1 then
        return 1
    end

    ---检测是否进入过试炼页面
    if not self:IsMarkPeakViewRedPoint() then
        return 1
    end

    --local activity = require "ActivitySynManager":GetInstance():GetChildAcitivity(10007, self.curActivityClass:GetJumpType())
    --if activity then
    --    return activity:GetActivityTypeCls():CheckRedPoint()
    --end
    return 0
end

---标记红点已完成(试炼战斗)
---@return void
function DrawUpPeakManager:MarkPeakViewRedPoint()
    --以六点作为刷新时刻
    local timestamp = _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
    _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "EnterPeakView", timestamp)
    local activityClass = ActivitySynManager:GetInstance():GetChildAcitivity(10030, self.curActivityClass:GetJumpType())
    activityClass:GetActivityTypeCls():RefreshRedPoint()
end
---检测今日是否已标记(试炼战斗)红点
---@return boolean
function DrawUpPeakManager:IsMarkPeakViewRedPoint()
    --以六点作为刷新时刻
    --策划说即使试炼页面已经打开, 仍显示红点
    local timestamp = _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
    ---是否进入过界面
    local enterPeakViewStatus =
        _G.PlayerPrefsManager.GetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "EnterPeakView", 0)
    return enterPeakViewStatus == timestamp
end

---检测活动是否开放
function DrawUpPeakManager:CheckIsOpen()
    return self.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Open
end

function DrawUpPeakManager:SetOnSixUpdateCall(name, callback)
    if not self.onSixUpdateCall then
        self.onSixUpdateCall = {}
    end
    self.onSixUpdateCall[name] = callback
end

---获取活动id
function DrawUpPeakManager:GetActivityID()
    return self.curActivityClass:GetActivityID()
end

function DrawUpPeakManager:CheckActivityOpened()
    if self.curActivityClass:GetCurActivityState() == require("ActivitySynManager").State.Notice then
        --TODO:提示活动开启时间
        return false
    end
    return self.curActivityClass:GetCurActivityState() == require("ActivitySynManager").State.Open
end

---@private
function DrawUpPeakManager:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

return DrawUpPeakManager
