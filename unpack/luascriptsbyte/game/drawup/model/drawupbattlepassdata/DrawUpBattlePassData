    self.curActivityClass = self.activity.curActivityClass
end
---获取GM数据
function DrawUpBattlePassData:OnHandleGMData(info)
    self:ParseData(info)
end

---@param msg activity.i_activity_self_info
function DrawUpBattlePassData:ParseData(msg)
    self.msg = msg
    self:InitJump()
    if self.onSixUpdateCall then
        for key, call in pairs(self.onSixUpdateCall) do
            call()
        end
    end
end

