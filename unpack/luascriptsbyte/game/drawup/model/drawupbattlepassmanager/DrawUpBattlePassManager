---@class DrawUpBattlePassManager : Singleton    中文描述
local DrawUpBattlePassManager = _G.BaseClass("DrawUpBattlePassManager", _G.Singleton)

---@return DrawUpBattlePassManager DrawUpBattlePassManager
function DrawUpBattlePassManager:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function DrawUpBattlePassManager:__init()
    self.activityList = {}
end

---销毁对象时,析构函数
function DrawUpBattlePassManager:Dispose()
end

---设置活动
function DrawUpBattlePassManager:SetActivity(activity)
    self.activityList[activity.curActivityClass:GetActivityID()] = activity
end

---@private
function DrawUpBattlePassManager:GetActivity(activityID)
    if activityID then
        return self.activityList[activityID]
    else
        for _, v in pairs(self.activityList) do
            return v
        end
    end
    return nil
end

return DrawUpBattlePassManager
