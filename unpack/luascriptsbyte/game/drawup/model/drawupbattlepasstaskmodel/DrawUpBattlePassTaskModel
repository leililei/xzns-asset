local ActivitySynManager = require "ActivitySynManager"
local base = require "ActivitySynTypeBase"
---@class DrawUpBattlePassTaskModel:ActivitySynTypeBase
---@field info activity_task.i_activity_task
---@field taskList DrawUpBattlePassTaskData[] 任务数据
---@field infoData DrawUpBattlePassTaskInfoData 任务相关信息
local DrawUpBattlePassTaskModel = _G.BaseClass("DrawUpBattlePassTaskModel", base)
local TaskData = require "DrawUpBattlePassTaskData"

local DataType = {
    [1] = "DrawUpBattlePassTaskInfoData",
    [2] = "ArtifactBattlePassTaskInfoData",
    [3] = "PetBattlePassTaskInfoData",
    [4] = "TarotPassTaskInfoData",
    [5] = "FestivalTaskInfoData",
    [6] = "JoinActivityBattlePassTaskInfoData",
    [7] = "IceFestivalTaskInfoData",
    [8] = "SpiritualDrawTaskInfoData",
    [9] = "MiniGameTaskInfoData",
    [10] = "ActivityDispatchAwardTaskData",
    [11] = "GloryAssemblyTaskData",
    [12] = "LuckyTryTaskInfoData",
    [13] = "LuckyTryTaskInfoData",
    [15] = "FlyingChessTaskInfoData",
    [15] = "GMArenaPeakAwardTaskData",
    [16] = "GMActivityTourGuessTaskData"
}

function DrawUpBattlePassTaskModel:__init()
    self.curActivityClass:AddStateChanged(self.StateChanged, self)
end

function DrawUpBattlePassTaskModel:StateChanged(state)
    if state == ActivitySynManager.State.Close then
        if self.info.main_type == 10 then
            self.infoData:OnCloseActivity()
        end
    end
end

---@param info activity.i_activity_self_info
function DrawUpBattlePassTaskModel:OnHandleGMData(info)
    self:ParseData(info)
    self:RefreshRedPoint()
end

---@param info activity.i_activity_self_info
function DrawUpBattlePassTaskModel:ParseData(info)
    self.pageTask = {}
    self:SetSelfData(info)
    base.ParseData(self)
    _G.Events:GetInstance():Broadcast(_G.eDrawUpBattlePass.DrawUpBattlePassRefeshTask)
end

---@param info activity.i_activity_self_info
function DrawUpBattlePassTaskModel:SetSelfData(info)
    self.info = info.task
    if not self.infoData then
        self.infoData = require(DataType[info.task.main_type]).New(self)
    end
    self:InitTaskList()
    base.ParseData(self)
end

function DrawUpBattlePassTaskModel:GetPrecastData()
    if not self.curActivityClass.cfg.info.front.precast then
        return {}
    else
        local path = self.curActivityClass.cfg.info.front.precast
        return _G.string.split(path, "#")
    end
end

--- 获取界面人物路径
function DrawUpBattlePassTaskModel:GetRolePath()
    if not self.rolePath then
        if not self.curActivityClass.cfg.info.front.precast then
            self.rolePath = ""
        else
            local path = self.curActivityClass.cfg.info.front.precast
            local paths = _G.string.split(path, "#")
            self.rolePath = paths[1] or ""
        end
    end
    return self.rolePath
end

--- 获取界面美术字路径
function DrawUpBattlePassTaskModel:GetTitlePath()
    if not self.titlePath then
        if not self.curActivityClass.cfg.info.front.precast then
            self.titlePath = ""
        else
            local path = self.curActivityClass.cfg.info.front.precast
            local paths = _G.string.split(path, "#")
            self.titlePath = paths[2] or ""
        end
    end
    return self.titlePath
end

---初始化任务列表
function DrawUpBattlePassTaskModel:InitTaskList()
    if self.taskList then
        for _, v in pairs(self.taskList) do
            v:Dispose()
        end
    end
    self.taskType = {}
    self.taskList = {}
    self.cfgs = {}
    if self.info.task_daily then
        for _, v in pairs(self.info.task_daily) do
            self.cfgs[v.sid] = self:SwapCfg(v)
            self.taskType[v.sid] = 1
        end
    end
    if self.info.task then
        for _, v in pairs(self.info.task) do
            self.cfgs[v.sid] = self:SwapCfg(v)
            self.taskType[v.sid] = 2
        end
    end
    if self.info.task_curr then
        for _, v in pairs(self.info.task_curr) do
            v.activity = self
            _G.table.insert(self.taskList, TaskData.New(v, function()
                self:RefreshRedPoint()
            end, _G.MarkTaskType.DrawUpBattlePass))
        end
    end
    self.finishTask = {}
    if self.info.finish_task then
        for _, v in pairs(self.info.finish_task) do
            _G.table.insert(self.taskList, TaskData.New({
                sid = v,
                state = _G.TaskEnum.ETaskState.Submited,
                activity = self,
                target = {999}
            }, nil, _G.MarkTaskType.DrawUpBattlePass))
            self.finishTask[v] = true
        end
    end
    self.allPage = self:GetAllPage()
end

---配置转换
---@param data activity_task.i_task_activity
function DrawUpBattlePassTaskModel:SwapCfg(data)
    local cfg = {}
    cfg.id = data.sid
    if _G.tonumber(data.name) then
        cfg.name = _G.LangUtil.GetLangPackValue(_G.tonumber(data.name))
    else
        cfg.name = data.name
    end
    if _G.tonumber(data.desc) then
        cfg.desc = _G.LangUtil.GetLangPackValue(_G.tonumber(data.desc))
    else
        cfg.desc = data.desc
    end
    cfg.type_calculate = data.type_calculate
    local tb = {}
    for _, v in pairs(data.complete) do
        _G.table.insert(tb, v.con)
    end
    cfg.condition = tb
    cfg.count = data.count
    cfg.link = data.link
    cfg.reward = data.award or {}
    if data.other_award and data.other_award[2] then
        local coinId = 106 -- 默认值
        if data.other_award[3] then
            coinId = data.other_award[3].num
        end
        _G.table.insert(cfg.reward, {
            type = {coinId, data.other_award[2].num}
        })
    end

    cfg.other_award = data.other_award
    cfg.page = data.page
    cfg.function_open = 0
    return cfg
end

---获取配置
function DrawUpBattlePassTaskModel:GetCfg(id)
    return self.cfgs[id]
end

---接收主题任务推送
---@param taskinfo task.i_task
function DrawUpBattlePassTaskModel:UpdateTask(taskinfo)
    if not self.cfgs[taskinfo.sid] then
        return
    end
    ---@type DrawUpBattlePassTaskData
    local task = self:GetTaskData(taskinfo.sid)
    if not task then
        return
    end
    task:UpdataData(taskinfo)
end

---领取奖励
function DrawUpBattlePassTaskModel:GetAward(ids, call)
    if self.curActivityClass:GetCurActivityState() == require"ActivitySynManager".State.Close then
        _G.PopWindowManager:GetInstance():ShowAllTips(840103)
        return
    end
    self.infoData:GetAward(ids, call, self.curActivityClass.cfg.info.type)
end

---检测奖励是否领取
function DrawUpBattlePassTaskModel:CheckIsGet(sid)
    return self.finishTask[sid]
end

-- 获取任务总轮次
function DrawUpBattlePassTaskModel:GetAllPage()
    if self.allPage then
        return self.allPage
    end
    local num = 1
    for k, v in ipairs(self.taskList) do
        if self.cfgs[v.i_task.sid].page > num then
            num = self.cfgs[v.i_task.sid].page
        end
    end
    return num
end

-- 根据轮次获取任务列表
function DrawUpBattlePassTaskModel:GetTaskListByPage(page)
    self.pageTask = self.pageTask or {}
    if self.pageTask[page] then
        return self.pageTask[page]
    end
    self.pageTask[page] = {}
    for k, v in ipairs(self.taskList) do
        if self.cfgs[v.i_task.sid].page == page then
            table.insert(self.pageTask[page], v)
        end
    end
    return self.pageTask[page]
end

-- 任务当前轮次
function DrawUpBattlePassTaskModel:GetNowPage()
    local total = self:GetAllPage()
    for i = 1, total do
        for k, v in ipairs(self:GetTaskListByPage(i)) do
            if not self.finishTask[v.i_task.sid] then
                return i
            end
        end
    end
    return total
end

function DrawUpBattlePassTaskModel:GetNextTarget()
    local list = self:GetTaskListByPage(self:GetNowPage())

    local curList = {}
    for _, v in ipairs(list) do
        table.insert(curList, v)
    end

    table.sort(curList, function(a, b)
        return a.Cfg.count < b.Cfg.count
    end)

    for _, v in ipairs(curList) do
        if v.i_task.target[1] < v.Cfg.count then
            return v.Cfg.count - v.i_task.target[1]
        end
    end
    return 0
end

---获取任务数据
---@param id number 任务id
---@return DrawUpBattlePassTaskData
function DrawUpBattlePassTaskModel:GetTaskData(id)
    local task
    for _, v in pairs(self.taskList) do
        if v.Cfg.id == id then
            task = v
            break
        end
    end
    return task
end

function DrawUpBattlePassTaskModel:OnEnterActivity()
    self.infoData:OnEnterActivity()
    base.OnEnterActivity(self)
end

---获取所有任务数据
function DrawUpBattlePassTaskModel:GetAllTaskDatas()
    return self.taskList
end

---根据任务类型获取任务数据
---@param type number 类型 1.每日任务 2.活动任务
function DrawUpBattlePassTaskModel:GetTaskDatasByType(type)
    local list = {}
    for _, v in pairs(self.taskList) do
        if self.taskType[v.Cfg.id] == type then
            _G.table.insert(list, v)
        end
    end
    return list
end

---初始化红点
function DrawUpBattlePassTaskModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint, self.CheckRedPointDailyTask, self.CheckRedPointCycleTask}
    self.redpointTree = {{2, 3}, false, false}
end

---检测红点
function DrawUpBattlePassTaskModel:CheckRedPoint()
    local state = _G.TaskEnum.ETaskState.Submited
    for _, v in pairs(self.taskList) do
        if v.i_task.state == state and not self:CheckIsGet(v.i_task.sid) then
            return 1
        end
    end
    return 0
end

function DrawUpBattlePassTaskModel:CheckRedPointDailyTask()
    local state = _G.TaskEnum.ETaskState.Submited
    local list = self:GetTaskDatasByType(1)
    for _, v in pairs(list) do
        if v.i_task.state == state and not self:CheckIsGet(v.i_task.sid) then
            return 1
        end
    end
    return 0
end

function DrawUpBattlePassTaskModel:CheckRedPointCycleTask()
    local state = _G.TaskEnum.ETaskState.Submited
    local list = self:GetTaskDatasByType(2)
    for _, v in pairs(list) do
        if v.i_task.state == state and not self:CheckIsGet(v.i_task.sid) then
            return 1
        end
    end
    return 0
end

function DrawUpBattlePassTaskModel:GetOtherActivityRedPointIds()
    if _G.AppSetting.IsXzns and self.curActivityClass.cfg.info.front.main_type == 7 then
        return {10014}
    end
    return {}
end

---获取可以领取的任务列表
function DrawUpBattlePassTaskModel:GetCankTaskList()
    local tb = {}
    local insert = _G.table.insert
    local state = _G.TaskEnum.ETaskState.Submited
    for _, v in pairs(self.taskList) do
        if v.i_task.state == state and not self:CheckIsGet(v.i_task.sid) then
            insert(tb, v.i_task.sid)
        end
    end
    return tb
end

---检查是否所有任务已完成
function DrawUpBattlePassTaskModel:CheckTaskOver()
    local tb = {}
    local insert = _G.table.insert
    local state = _G.TaskEnum.ETaskState.Completed
    for _, v in pairs(self.taskList) do
        if v.i_task.state == state and self:CheckIsGet(v.i_task.sid) then
            return true
        end
    end
    return false
end

---获取当前轮次可以领取的任务列表
function DrawUpBattlePassTaskModel:GetCankTaskListByPage()
    local tb = {}
    local insert = _G.table.insert
    local state = _G.TaskEnum.ETaskState.Submited
    local nowPage = self:GetNowPage()
    for _, v in pairs(self.taskList) do
        if v.i_task.state == state and not self:CheckIsGet(v.i_task.sid) then
            if self.cfgs[v.i_task.sid].page == nowPage then
                insert(tb, v.i_task.sid)
            end
        end
    end
    return tb
end

---刷新红点
function DrawUpBattlePassTaskModel:RefreshRedPoint()
    -- 刷新子节点
    if self.redpointTree and self.redpointTree[1] and type(self.redpointTree[1]) == "table" then
        for _, childRedpointId in ipairs(self.redpointTree[1]) do
            require("RedPointManager"):GetInstance():RefreshNode(childRedpointId)
        end
    end
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function DrawUpBattlePassTaskModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

function DrawUpBattlePassTaskModel:IsShowBtn()
    if _G.AppSetting.IsXzns and self.curActivityClass.cfg.info.front.main_type == 7 then -- 冲刺助力任务需要显示在主界面上
        return true
    end
    return false
end

function DrawUpBattlePassTaskModel:GetJumpModelType()
    return self.infoData:GetJumpModelType()
end

---销毁对象时,析构函数
function DrawUpBattlePassTaskModel:Dispose()
    if self.curActivityClass then
        self.curActivityClass:RemoveStateChanged(_G.handler(self, self.StateChanged), self)
    end
end

return DrawUpBattlePassTaskModel
