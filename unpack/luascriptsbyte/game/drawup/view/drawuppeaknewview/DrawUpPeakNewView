---@class DrawUpPeakNewView : UIBaseView    中文描述
---@field public go_table DrawUpPeakNewView_GoTable GoTable
local DrawUpPeakNewView = _G.BaseClass("DrawUpPeakNewView", _G.UIBaseView)
local DrawUpMainModel = require("DrawUpMainModel")
local ConfigManager = _G.ConfigManager

function DrawUpPeakNewView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function DrawUpPeakNewView:OnCreate()
    self:SetRoleDate()
end

---获取赛季立绘数据
function DrawUpPeakNewView:SetRoleDate()
    self.seasonID = DrawUpMainModel:GetInstance():GetIdRde()
    if self.seasonID == 0 then
        self:Close()
    end
    self.Role_SpineParse = DrawUpMainModel:GetInstance():Role_SpineParse(self.seasonID)
    if self.Role_SpineParse == nil or self.Role_SpineParse.id == nil then
        self:Close()
    end
    DrawUpMainModel:GetInstance():AddIdRde(self.seasonID)
    ---@type card_cfg
    local cfg = _G.ConfigManager.card_cfg[self.Role_SpineParse.id]
    if cfg == nil then
        return
    end

    local ElementEnum = {
        [1] = "ui_js_renlei_icon",
        [2] = "ui_js_shouren_icon",
        [3] = "ui_js_jingling_icon",
        [4] = "ui_js_wangling_icon",
        [6] = "ui_js_chuanqi_icon",
        [16] = "ui_js_multi16", --人神
        [26] = "ui_js_multi26", --兽神
        [36] = "ui_js_multi36", --精神
        [46] = "ui_js_multi46"  --亡神
    }
    local orderDic = {
        [1] = "ui_js_b_icon",
        [2] = "ui_js_a_icon",
        [3] = "ui_js_s_icon",
        [4] = "ui_js_splus_icon",
        [5] = "ui_js_splus_icon",
        [6] = "ui_js_splus_icon",
        [7] = "ui_js_sp_icon",
    }
    local CardGradeFlag = {
        [0] = "ui_xszm_plt_icon_hexin",
        [1] = "ui_xszm_plt_icon_tianzai",
        [2] = "ui_xszm_plt_icon_juntan",
        [3] = "ui_xszm_plt_icon_julong",
        [4] = "ui_xszm_plt_icon_gushen",
        [5] = "ui_xszm_plt_icon_linxiu",
        [6] = "ui_xszm_plt_icon_zhigao"
    }

    self.go_table.aorimage_tip.SpriteName = ElementEnum[cfg.Elements]
    self.go_table.aorimage_Order.SpriteName = orderDic[cfg.Order]
    local iconName = ""
    if cfg.Order == 5 then
        iconName = CardGradeFlag[0]
    elseif cfg.Order > 5 then
        local cfg = require "CardCommentManager":GetInstance():CardData(cfg.id, false)
        iconName = CardGradeFlag[cfg.Organization or 0]
        if cfg.Order == 7 then
            self:LoadSPEffect()
        end
    end
    UIUtils.SetUIModel(self.go_table.aorimage_type, self.go_table.aorimage_type, self.go_table.aorimage_type2,
            self.go_table.aorimage_type, iconName)

    local pos = {}
    _G.table.insert(pos, _G.string.split(self.Role_SpineParse.bg, "#")[1])
    _G.table.insert(pos, _G.tonumber(_G.string.split(self.Role_SpineParse.bg, "#")[2]))
    _G.table.insert(pos, _G.tonumber(_G.string.split(self.Role_SpineParse.bg, "#")[3]))
    _G.table.insert(pos, _G.tonumber(_G.string.split(self.Role_SpineParse.bg, "#")[4]))
    --背景路径
    self.go_table.aorrawimage_BG:LoadImage(
            pos[1],
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                trans:SetNativeSize()
            end
    )
    self.go_table.aorrawimage_BG:SetLocalPosition(pos[2], pos[3], pos[4])

    pos = {}
    local slogan = _G.string.split(self.Role_SpineParse.slogan, "#")
    _G.table.insert(pos, slogan[1])
    _G.table.insert(pos, _G.tonumber(slogan[2]))
    _G.table.insert(pos, _G.tonumber(slogan[3]))
    _G.table.insert(pos, _G.tonumber(slogan[4]))
    --slogan
    self.go_table.aorrawimage_slogan:LoadImage(
            pos[1],
            function(trans)
                if self:IsNil() then
                    return
                end
                trans:SetNativeSize()
            end
    )
    self.go_table.aorrawimage_slogan:SetLocalPosition(pos[2], pos[3], pos[4])
    --角色名字
    self.go_table.aortext_name.text = self.Role_SpineParse.name

    -- local Tweening = _G.CS.DG.Tweening
    -- local x, y, z = self.go_table.obj_role:GetLocalPosition()
    -- self.tweer =
    --     self.go_table.obj_role:DOLocalMoveY(y + 20, 1.5):SetEase(Tweening.Ease.InOutSine):SetLoops(
    --         -1,
    --         Tweening.LoopType.Yoyo
    --     )
    -- self:RoleShow_SetSkill(self.go_table, self.Role_SpineParse.id)
    pos = {}
    local spice = _G.string.split(self.Role_SpineParse.spice, "#")
    _G.table.insert(pos, spice[1])
    _G.table.insert(pos, _G.tonumber(spice[2]))
    _G.table.insert(pos, _G.tonumber(spice[3]))
    _G.table.insert(pos, _G.tonumber(spice[4]))
    _G.table.insert(pos, _G.tonumber(spice[5]))
    self.go_table.obj_role:DisposeChildren()
    local roleScale = pos[5]
    _G.UIUtils.LoadEffectByPath(pos[1], self.go_table.obj_role, function(trans)
        GameUtil.SetCardUiSpineAnimation(trans, "idle", true)
    end)
    self.go_table.obj_role:SetLocalPosition(pos[2], pos[3], pos[4])
    self.go_table.obj_role:SetLocalScale(roleScale, roleScale, roleScale)

    if self.Role_SpineParse.word_effects then
        local effctPos = {}
        local p = _G.string.split(self.Role_SpineParse.word_dev, "#")
        _G.table.insert(effctPos, _G.tonumber(p[1]))
        _G.table.insert(effctPos, _G.tonumber(p[2]))
        _G.table.insert(effctPos, _G.tonumber(p[3]))
        _G.UIUtils.LoadEffectByPath(self.Role_SpineParse.word_effects, self.go_table.obj_role,
                function(item)
                    item:AddComponentE(_G.typeof(_G.CS.UIParticleOrderChange))
                end,
                nil, nil, effctPos)
    end
end

function DrawUpPeakNewView:RoleShow_SetSkill(go_table, sid)
    local card_skills_cfg = _G.ConfigManager.card_skills_cfg

    ---技能obj索引
    local ObjIndex = 00
    local SetFun = function(skill_i)
        local skillid = sid + skill_i * 100 + 1
        local skillCfg = card_skills_cfg[skillid]
        if skillCfg ~= nil then
            ObjIndex = ObjIndex + 1

            if ObjIndex == 1 then
                ---如果解锁了 第一个技能是怒气技
                local nuqi = go_table.aorimage_nuqi
                if nuqi then
                    _G.GameUtil.SetActiveByCondition(nuqi, skillCfg.skill_pos == 1)
                end
            end
            go_table["aorrawimage_SkillIcon (" .. ObjIndex .. ")"]:LoadImage(skillCfg.icon)
            -- go_table["aorrawimage_SkillType (" .. ObjIndex .. ")"]:LoadImage(skillCfg.skill_type)
            go_table["aorimage_Skill (" .. ObjIndex .. ")"]:SetActiveE(1)
            _G.SetEventTrigger(
                    go_table["aorimage_Skill (" .. ObjIndex .. ")"],
                    "onClick",
                    _G.handlerbind(self, self.RoleShow_SkillTips, skillid)
            )
        end
    end
    SetFun(1)

    SetFun(3)
    SetFun(4)
    SetFun(5)

    ObjIndex = ObjIndex + 1
    for i = ObjIndex, 4 do
        ---隐藏无技能 按钮
        go_table["aorimage_Skill (" .. i .. ")"]:SetActiveE(0)
    end
end

function DrawUpPeakNewView:LoadSPEffect()
    self.go_table.aorimage_Order:ClearChildren()
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_ItemCardBodyBaseViewSP_bg,
            self.go_table.aorimage_Order,
            function(trans)
                trans:SetLocalScaleXYZ(1)
            end
    )
    self.go_table.aorimage_type:ClearChildren()
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_ItemCardBodyBaseViewSPtitle1_bg,
            self.go_table.aorimage_type,
            function(trans)
                trans:SetLocalScaleXYZ(2)
                trans:SetLocalPosition(0, 11.7)
            end
    )
end

function DrawUpPeakNewView:RoleShow_SkillTips(_, _, skillId)
    require("CommonTipManager"):GetInstance():OpenSkillTip(skillId)
end

---@private
function DrawUpPeakNewView:OnDisable()
end

---界面的销毁函数
function DrawUpPeakNewView:OnDestroy()
end

---按钮点击事件在这里派发
function DrawUpPeakNewView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeView then
        self.seasonID = DrawUpMainModel:GetInstance():GetIdRde()
        if self.seasonID ~= 0 then
            self:SetRoleDate()
        else
            self:Close()
        end
    elseif go == self.go_table.aorbtn_skip then
        local activity = require("ActivitySynManager"):GetInstance():GetActivityClass(self.seasonID)
        if activity then
            _G.GlobalInterface.JumpActivityByGM(activity:GetTypeId(), activity:GetJumpType())
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(650104)
        end
        self:Close()
    end

    if self.go_table.toggle_eject.isOn then
        _G.PlayerPrefsManager.SetInt("DrawUpMainModel" .. self.seasonID,
                _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime()))
    end
end

return DrawUpPeakNewView
