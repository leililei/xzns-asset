---资源加载
function DrawUpGMBattlePassView:AddRest()
    self.resKey = {
        AddExp = "UIH5/DrawUp/SeasonLvView_AddExp"
    }

    if self.prb_AddExp == nil then
        self:AddResToList(self.resKey.AddExp, _G.UIResType.pool, self.resKey.AddExp, nil, self.go_table.obj_view)
    end
end

function DrawUpGMBattlePassView:SetData()
    local sc = self.ResList[self.resKey.AddExp]
    if sc ~= nil then
        self.prb_AddExp = sc
    end
    local sortOrder = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
    self.prb_AddExp:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder = sortOrder + 40
    self.lua_AddExp = require("DrawUpBattlePassView_AddExp").New(self.prb_AddExp, self)
    self.lua_AddExp:Hide()
    self:UpdateView()
    self.activity:RefreshRedPoint()
end

function DrawUpGMBattlePassView:UpdateView()
    self.lua_AddExp:Hide()
    self.isUp = self.activity:GetIsUp(self.ActivityID)
    ---当前等级 初始0级
    self.lv, self.exp, self.maxExp = self:GetLvExp(self.activity:Getbattle_exp(self.ActivityID))
    self.go_table.obj_senior:SetActiveE(self.isUp and 0 or 1)

    local isShowAddExpBtn = _G.TimeUtil.GetServerUnixTime() >= self.AddBtnTime
    if isShowAddExpBtn then
        _G.PlayerPrefsManager.SetInt(self.key .. "Add", 1)
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_add, isShowAddExpBtn)
    if self.XianSiJiang == nil then
        self.XianSiJiang = -1
    end
    self.go_table.aorbtn_getExp:SetActiveE(0)
    self.go_table.aorbtn_help:SetActiveE(0)

    ---true显示一键领取
    self.unclaimed = self.activity:FindAllUnclaimedRewards(self.ActivityID)
    self.isKeyGet = #self.unclaimed > 0
    --_G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_oneKey, self.isKeyGet)
    self.go_table.aorbtn_oneKey:SetActiveE(0)
    self.go_table.aorbtn_oneKey:SetGray(not self.isKeyGet)
    self.go_table.aorbtn_oneKey:GetComponentE(_G.typeof(_G.CS.AorImage)).color = _G.ColorTools.FormatColorByString(not self.isKeyGet and "A9A9A9" or "FFFFFF")
    self.go_table.aortext_oneKey.color = _G.ColorTools.FormatColorByString(not self.isKeyGet and "434343" or "8C2D14")
    self.showDelay = true
    local jumpIndex = self:FindFirstAwardIndex()
    if self.P_LoopInit == nil then
        self.go_table.scrollloopvectical_items:InitItemData(#self.countCfgArr, _G.handler(self, self.RefreshList),
            jumpIndex)
        --self.go_table.scrollloopvectical_items:SetContentPosChangeCall(_G.handler(self, self.onValueChanged))
        self.P_LoopInit = true
    else
        self.go_table.scrollloopvectical_items:UpdateAllItem(#self.countCfgArr, jumpIndex)
    end

    self.go_table.scrollloopvectical_items:SetRectTransformOffset(10, self.isUp and 14 or 110, 0, -57)
end

function DrawUpGMBattlePassView:FindFirstAwardIndex()
    local maxIndex = self.isUp and #self.countCfgArr - 4 or #self.countCfgArr - 3
    local index = self:GetFirstAwardIndex(self.lv, self.countCfgArr)
    return index > maxIndex and maxIndex - 1 or index - 1
end

function DrawUpGMBattlePassView:GetFirstAwardIndex(lv, awardList)
    local cfg
    local index = 1
    for i = 1, #awardList do
        cfg = awardList[i]
        if lv >= cfg.level then
            if not self.activity:IsAward(self.ActivityID, cfg.id, false) then
                return i
            elseif self.isUp and not self.activity:IsAward(self.ActivityID, cfg.id, true) then
                return i
            else
                index = i
            end
        end
    end
    return index
end

function DrawUpGMBattlePassView:SetTimeEnd()
    local subTime = self.endTime - _G.TimeUtil.GetServerUnixTime()
    if subTime <= 0 then
        if self.TimerEnd ~= nil then
            self.TimerEnd:Stop()
            self.TimerEnd = nil
        end
        --_G.PopWindowManager:GetInstance():ShowAllTips(620101)
        self:CloseView()
        return
    end
    local _t = _G.TimeUtil.TranslateSecond(subTime)
    local day = _t.day
    local timeStr = string.format("%02d:%02d:%02d", _t.hour, _t.min, _t.sec)
    if self:IsNil() then
        return
    end
    if self.go_table then
        self.go_table.aortext_hdcqsj.text = GetLangPackValue(90029300004, GetLangPackValue(self.UiDic.day, day, timeStr))
    end
end

function DrawUpGMBattlePassView:RefreshList(index, objGame, isPrize)
    if index < 0 then
        return
    end
    index = index + 1
    local data = self.countCfgArr[index]
    local itemGoTable = _G.GetAutoGoTable(objGame)
    objGame:SetName(index)
    if not table.ContainsValue(self.itemList, objGame) then
        table.insert(self.itemList, objGame)
    end
    for i = 1, #self.itemList do
        _G.SortList(
            self.itemList,
            function(a)
                return -a:GetName()
            end
        )
        self.itemList[i]:SetSiblingIndexE(i)
    end
    -- if itemGoTable.addClick == nil then
    --     itemGoTable.aorbtn_get1.onClick:AddListener(
    --         _G.handlerbind(self, self.OnClick_GetItem, itemGoTable, false, index)
    --     )
    --     itemGoTable.aorbtn_get2.onClick:AddListener(
    --         _G.handlerbind(self, self.OnClick_GetItem, itemGoTable, true, index)
    --     )
    --     itemGoTable.addClick = true
    -- end
    local freeState, payState
    local lvEnough = self.lv >= data.level
    itemGoTable.data = data
    itemGoTable.ispass = self.lv >= data.level
    itemGoTable.isPrize = isPrize

    itemGoTable.isGet1 = self.activity:IsAward(self.ActivityID, data.id, false)
    itemGoTable.isGet2 = self.activity:IsAward(self.ActivityID, data.id, true)
    freeState = lvEnough and ItemState.Unlock or ItemState.Lock
    payState = (lvEnough and self.isUp) and ItemState.Unlock or ItemState.Lock
    itemGoTable.freeState = itemGoTable.isGet1 and ItemState.Received or freeState
    itemGoTable.payState = itemGoTable.isGet2 and ItemState.Received or payState

    local rewards = _G.StorageManager:GetInstance():ResoveActivityAwardCfg(data.rewards_normal)
    if not itemGoTable.item1 then
        itemGoTable.item1 = BaseAwardNewItem.New(itemGoTable.obj_item1, _G.handlerbind(self, self.OnClickAward, itemGoTable, false), 88,
            itemGoTable.obj_item1)
    end
    itemGoTable.item1:ShowWithID(rewards[1], nil, _G.handlerbind(self, self.itemLoadedCall, itemGoTable, false, 1))

    rewards = _G.StorageManager:GetInstance():ResoveActivityAwardCfg(data.rewards_pay)
    rewards = rewards[1]
    if not itemGoTable.item2 then
        itemGoTable.item2 = BaseAwardNewItem.New(
            itemGoTable.obj_item21,
            _G.handlerbind(self, self.OnClickAward, itemGoTable, true),
            88,
            itemGoTable.obj_item21
        )
    end
    itemGoTable.item2:ShowWithID(rewards, nil, _G.handlerbind(self, self.itemLoadedCall, itemGoTable, true, 21))

    rewards = data.rewards_pay
    rewards = rewards[2]

    local isHave2 = rewards ~= nil
    _G.GameUtil.SetActiveByCondition(itemGoTable.obj_item22, isHave2)
    if isHave2 then
        if not itemGoTable.item3 then
            itemGoTable.item3 = BaseAwardNewItem.New(
                itemGoTable.obj_item22,
                _G.handlerbind(self, self.OnClickAward, itemGoTable),
                88,
                itemGoTable.obj_item22
            )
        end
        itemGoTable.item3:ShowWithID(rewards, nil, _G.handlerbind(self, self.itemLoadedCall, itemGoTable, true, 22))
    end

    ---是否显示第二个
    itemGoTable.obj_gou22:SetActiveE(rewards and 1 or 0)
    itemGoTable.obj_suo22:SetActiveE(rewards and 1 or 0)
    local isGet1 = itemGoTable.freeState == ItemState.Unlock
    local isGet2 = itemGoTable.payState == ItemState.Unlock
    local Got1 = itemGoTable.freeState == ItemState.Received
    local Got2 = itemGoTable.payState == ItemState.Received
    ---已领打勾
    itemGoTable.obj_gou1:SetActiveE(Got1 and 1 or 0)
    itemGoTable.obj_gou2:SetActiveE(Got2 and 1 or 0)
    ---可领

    itemGoTable.aorimage_get:SetActiveE(0)
    itemGoTable.aorbtn_get.onClick:RemoveAllListeners()
    itemGoTable.aorbtn_get:SetActiveE(1)
    itemGoTable.aorimage_getaward.color = _G.ColorTools.FormatColorByString("FFFFFF")
    if (isGet2 or isGet1) then
        -- 可领取
        itemGoTable.aorimage_getaward.SpriteName = "ui_ty_kuang_00"
        itemGoTable.aorimage_getaward:SetGray(false)
        itemGoTable.aortext_text.text = _G.GetLangPackValue(90027500003)
        itemGoTable.aortext_text.color = _G.ColorTools.FormatColorByString("8C2D14")
        itemGoTable.aorbtn_get.onClick:AddListener(_G.handlerbind(self, self.OnClick_yjlq))
    elseif Got1 and not Got2 then
        --  普通奖励领取，但是没有氪金
        itemGoTable.aorimage_getaward.SpriteName = "ui_ty_kuang_00"
        itemGoTable.aorimage_getaward:SetGray(false)
        itemGoTable.aortext_text.text = _G.GetLangPackValue(90025200011)
        itemGoTable.aortext_text.color = _G.ColorTools.FormatColorByString("8C2D14")
        itemGoTable.aorbtn_get.onClick:AddListener(_G.handler(self, self.ShowBuyTips))
    elseif Got1 and Got2 then
        -- 奖励都被领取
        itemGoTable.aorbtn_get:SetActiveE(0)
        itemGoTable.aorimage_get:SetActiveE(1)
    elseif not isGet1 and not isGet2 then
        -- 都不能领取（没有达到条件）
        itemGoTable.aorimage_getaward.SpriteName = "ui_ty_kuang_00"
        itemGoTable.aorimage_getaward:SetGray(true)
        itemGoTable.aorimage_getaward.color = _G.ColorTools.FormatColorByString("A9A9A9")

        itemGoTable.aortext_text.text = _G.GetLangPackValue(90020400086)
        itemGoTable.aortext_text.color = _G.ColorTools.FormatColorByString("434343")
    end
    itemGoTable.aortext_lv.text = GetLangPackValue(self.UiDic.zldj, data.level)
    --进度条
    itemGoTable.aorimage_DayBar:SetActiveE(BoolToNumber(index ~= 1))
    if data.level - 1 < self.lv then
        itemGoTable.aorimage_dayBar:SetLocalScale(1, 1, 1)
    elseif data.level - 1 == self.lv then
        itemGoTable.aorimage_dayBar:SetLocalScale(1, self.exp / self.maxExp, 1)
    else
        itemGoTable.aorimage_dayBar:SetLocalScale(1, 0, 1)
    end
    return objGame
end

function DrawUpGMBattlePassView:OnClickAward(item, tb, isBuy)
    local state = isBuy and tb.payState or tb.freeState
    local canReceived = state == ItemState.Unlock
    if canReceived then
        self.activity:GetAwardAll(self.ActivityID, self.unclaimed, _G.handler(self, self.UpdateView))
    else
        if item.go_table then
            require "CommonTipManager":GetInstance():OpenTip(item.go_table.gameObject, item.data.sid)
        else
            require "CommonTipManager":GetInstance():OpenTip(item.gameObject, item.data.sid)
        end
    end
end

---@private
function DrawUpGMBattlePassView:onValueChanged()
    local long = false
    local x, y, z = self.go_table.obj_Content:GetAnchorPosition()
    local lv = self.mark[1] or 0
    for i = 1, #self.mark - 1 do
        if i == #self.mark - 1 then
            if x < self.mark[i + 1] * -119 + 749 then
                self.go_table.obj_nextItem:SetActiveE(0)
                long = true
            else
                self.go_table.obj_nextItem:SetActiveE(1)
            end
        end
        if x < self.mark[i] * -119 + 630 then
            lv = self.mark[i + 1]
        end
    end
    if lv > 0 then
        self:RefreshList(lv - 1, self.go_table.obj_nextItem, true)
    else
        self.go_table.obj_nextItem:SetActiveE(0)
        long = true
    end
    self.go_table.scrollloopvectical_items:SetRectTransformSize(long and 707.97 or 573.6, 358.85)
end

---获取item延迟展示时间
---@private
---@param index number item索引
function DrawUpGMBattlePassView:GetDelayTime(index)
    ---动态加载组件0.133秒出现一个每个延后0.033秒第七个需要间隔0.066秒
    return 0.1 + index * 0.033 + (index > 6 and 1 or 0) * 0.033
end

---@param isBuy boolean true是豪华奖励
---@param itemLua BaseAwardNewItem 奖励脚本
function DrawUpGMBattlePassView:itemLoadedCall(itemLua, tb, isBuy, suf)
    ---@type ItemViewBase
    local lua = itemLua.item
    if itemLua.type ~= _G.StorageType.Card then
        lua:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
    else
        itemLua.item.gameObject:SetLocalScaleXYZ(0.846)
    end

    local state = isBuy and tb.payState or tb.freeState
    local isShowEffect = state == ItemState.Unlock

    if itemLua.type ~= _G.StorageType.Card then
        itemLua:ShowEffect(false)
        if isShowEffect then
            lua:ShowEffect()
        else
            lua:ShowOrHideEffect(false)
        end
    else
        --itemLua:ShowEffect(isShowEffect)
    end
    local effNode = "eff" .. suf
    if tb[effNode] == nil then
        if isShowEffect then
            tb[effNode] = true
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
                tb["obj_Eff" .. suf],
                function(tran)
                    if _G.IsNil(self.go_table.gameObject) then
                        tran:DestroyObject()
                        return
                    end
                    tran:SetActiveE(isShowEffect and 1 or 0)
                    tb[effNode] = tran
                end
            )
        end
    elseif tb[effNode] ~= true then
        tb[effNode]:SetActiveE(isShowEffect and 1 or 0)
    end
end

---@return  number,number,number  等级, 当前经验, 最大经验
function DrawUpGMBattlePassView:GetLvExp(sumexp)
    local lv = 0
    local max = 0
    local exp = 0
    local cfginfo
    for i = 1, #self.countCfgArr do
        cfginfo = self.countCfgArr[i]
        local subexp = cfginfo.conditions[1]
        if subexp == nil then
            if _G.AppSetting.DEBUG then
                _G.LogError("未配置经验 limited_battlecon_cfg." .. cfginfo.id)
            end
            subexp = 0
            sumexp = 0
        end
        if sumexp >= subexp then
            sumexp = sumexp - subexp
            lv = cfginfo.level
        else
            exp = sumexp
            max = subexp
            break
        end
    end

    return lv, exp, max
end

