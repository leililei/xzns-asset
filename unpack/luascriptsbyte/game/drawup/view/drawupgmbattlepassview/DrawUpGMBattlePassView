local BaseAwardNewItem = require("BaseAwardNewItem")
local ActivitySynManager = require("ActivitySynManager")
local DrawUpCoinModel = require("DrawUpCoinModel")

---@class DrawUpGMBattlePassView : UIBaseView    中文描述
---@field public go_table DrawUpGMBattlePassView_GoTable GoTable
---@field activity TenOneModel
local DrawUpGMBattlePassView = _G.BaseClass("DrawUpGMBattlePassView", _G.UIBaseView)

local GetLangPackValue = _G.GetLangPackValue
local ItemState = {
    Lock = 1, --未解锁
    Unlock = 2, --可领取
    Received = 3 --已领取
}

function DrawUpGMBattlePassView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.UiDic = {
        --- %s天%s
        day = 90025500011,
        exp = "%d/%d",
        --- %s级
        zldj = 90025500012
    }
    self.itemList = {}
end

---@class params_DrawUpGMBattlePassView Data

---界面的入口函数
---@param activity TenOneModel
function DrawUpGMBattlePassView:OnCreate(activity)
    -- _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.DrawUpGMBattlePassView, self.go_table)
    self.activity = activity
    self.GetJumpType = require "ActivitySynManager":GetInstance():GetChildAcitivity(
        activity:GetJumpModelType(),
        activity.curActivityClass:GetJumpType(),
        activity.curActivityClass:GetMainType()
    )
    self.ActivityID = self.GetJumpType:GetActivityID()
    self.coinId = self.activity:GetCoinId()

    self:InitViewInfo()
    self:InitView()
    --self:UIEffect()
    self:AddRest()
    self:InitToggle()
    self.ResLoadCompleteCall = _G.handlerbind(self, self.SetData)
    _G.GameUtil.AddDouYinIcon(self.go_table.aorbtn_buy, true)
end

function DrawUpGMBattlePassView:InitToggle()
    local mainType = self.GetJumpType.cfg.info.front.main_type
    self.taskActivity = require "ActivitySynManager":GetInstance():GetChildAcitivity(10007, self.GetJumpType:GetJumpType(self.activityID),
        mainType)
    if not self.taskActivity then
        self.go_table.toggle_battlePass:SetActiveE(0)
        self.go_table.toggle_task:SetActiveE(0)
        return
    end
    self.toggles = {
        battlePass = _G.GetAutoGoTable(
            self.go_table.toggle_battlePass,
            _G.handlerbind(self, self.OnClickToggle, "battlePass", _G.handler(self, self.OnBattlePass))
        ),
        task = _G.GetAutoGoTable(
            self.go_table.toggle_task,
            _G.handlerbind(self, self.OnClickToggle, "task", _G.handler(self, self.OnTask))
        )
    }
    self.toggles["task"].obj_redpointTask:UpdateRedPointItemIDAndParam(
        self.taskActivity:GetActivityTypeCls():GetRedpointIDByIndex(1)
    )
    self.toggles["battlePass"].obj_redpointBp:UpdateRedPointItemIDAndParam(
        self.activity.curActivityClass:GetActivityTypeCls():GetRedpointIDByIndex(1)
    )
end

function DrawUpGMBattlePassView:OnClickToggle(go, isOn, key, call)
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if call then
        call(isOn)
    end
end

function DrawUpGMBattlePassView:OnBattlePass(isOn)
    self.go_table.obj_bpPanel:SetActiveE(isOn and 1 or 0)
    if isOn then
        self:UpdateView()
    end
end

function DrawUpGMBattlePassView:OnTask(isOn)
    self.go_table.obj_taskPanel:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    if not self.taskInit then
        self.taskInit = true
        _G.PoolsManager:GetInstance():Spawn(
            "UIH5/DrawUp/$_obj_BattlePassTaskView",
            _G.ePoolType.UIItem,
            self.go_table.obj_taskPanel,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                self.taskLua = self:AddComponent(trans, require("BattlePassTaskPanel").New(trans, self.taskActivity, self))
            end
        )
    end
end

function DrawUpGMBattlePassView:FreshView()
    self:InitView()
    self:AddRest()
    self.ResLoadCompleteCall = _G.handlerbind(self, self.SetData)
end

---@private
function DrawUpGMBattlePassView:InitView()
    self.isUp = self.activity:GetIsUp(self.ActivityID)

    -- self.go_table.toggle_battlePass:SetActiveE(0)
    -- self.go_table.toggle_task:SetActiveE(0)

    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["@_aorbtn_getExp"] = self.OnClick_GetExp,
        ["@_aorbtn_add"] = self.OnClick_AddExp,
        ["@_aorbtn_buy"] = self.ShowBuyTips,
        ["@_aorbtn_oneKey"] = self.OnClick_yjlq,
        ["@_aorbtn_help"] = self.OnClick_help,
        -- [self.go_table.aorbtn_btn:GetName()] = self.ShowBuyTips,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    ---本赛季战令id
    self.id = self.activity:Getsid(self.ActivityID)
    ---@type i_battle_cfg
    self.cfg = self.activity:Getcfg_list(self.ActivityID)

    _G.GameUtil.SetPriceByChannel(self.cfg.price, self.go_table.aortext_rmb)

    self.endTime = self.activity.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)

    local delta = _G.ConfigManager.discrete_cfg[108601][1][1]
    self.AddBtnTime = self.endTime - delta * 86400

    self:SetTimeEnd()
    self.TimerEnd = _G.TimerManager:GetInstance():GetTimer(1, self.SetTimeEnd, self, false, false)
    self.TimerEnd:Start()

    self.conIds = self.cfg.award_id_list
    self.mark = {}
    local limited_battlecon_cfg = _G.ConfigManager.limited_battlecon_cfg
    ---@type limited_battlecon_cfg[]
    self.countCfgArr = {}
    ---@type limited_battlecon_cfg
    local cfgItem
    local tempItem
    local id
    for i = 1, #self.conIds do
        id = self.conIds[i]
        if id == nil or id == 0 then
            if _G.AppSetting.DEBUG then
                _G.LogError(" 配置id 无效  limited_battlecon_cfg.content id:" .. tostring(id))
            end
            cfgItem = nil
        else
            cfgItem = limited_battlecon_cfg[self.conIds[i]]
        end
        if cfgItem then
            tempItem = {
                id = cfgItem.id,
                level = cfgItem.level,
                conditions = cfgItem.conditions,
                rewards_normal = {},
                rewards_pay = {},
                mark = cfgItem.mark
            }
            for _, v in pairs(cfgItem.rewards_free_item) do
                _G.table.insert(tempItem.rewards_normal, v)
            end
            if cfgItem.rewards_free_cur > 0 then
                _G.table.insert(tempItem.rewards_normal, { self.coinId, cfgItem.rewards_free_cur })
            end
            for _, v in pairs(cfgItem.rewards_pay) do
                _G.table.insert(tempItem.rewards_pay, v)
            end
            if cfgItem.rewards_pay_cur > 0 then
                _G.table.insert(tempItem.rewards_pay, { self.coinId, cfgItem.rewards_pay_cur })
            end
            table.insert(self.countCfgArr, tempItem)
            if cfgItem.mark == 1 then
                _G.table.insert(self.mark, cfgItem.level)
            end
        end
    end

    _G.GameUtil.SetActiveByCondition(self.go_table.obj_item, false)

    if not self.isUp then
        self:ShowBuyItemAll()
    end

    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)

    self.key = _G.PlayerModel:GetInstance():GetPlayerUid() ..
        "DrawUpBattlePass" .. self.activity.curActivityClass:GetActivityID() .. self.endTime
    _G.PlayerPrefsManager.SetInt(self.key, 1)

    if self.go_table.obj_cardSpine then
        self.go_table.obj_cardSpine:ClearChildren()
        local cfg = require("CardInfoManager").GetCardSkin_ShowCfg(0, 111050000)
        _G.PoolsManager:GetInstance():Spawn(
            cfg.ModelPathHi,
            _G.ePoolType.Temporary,
            self.go_table.obj_cardSpine,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                end
            end
        )
    end
end

---初始化界面信息
---@private
function DrawUpGMBattlePassView:InitViewInfo()
    if not self.activity or not self.activity.curActivityClass then
        return
    end
    ---@type activity.i_activity
    local cfg = self.activity.curActivityClass.cfg
    if not cfg then
        return
    end
    --弹窗标题
    self.go_table.aortext_title.text = cfg.info.name
    if not cfg or not cfg.info.front or not cfg.info.front.precast then
        return
    end
    --描述文本
    local cfgs = _G.string.split(cfg.info.front.precast, "#")
    cfgs[1] = cfgs[1] and tonumber(cfgs[1])
    cfgs[2] = cfgs[2] and tonumber(cfgs[2])
    cfgs[3] = cfgs[3] and tonumber(cfgs[3])
    if cfgs[3] and cfgs[3] > 0 then
        self.go_table.obj_title:SetActiveE(1)
        self.go_table.obj_title2:SetActiveE(0)
        self.go_table.aortext_des.text = GetLangPackValue(cfgs[3])
    else
        self.go_table.obj_title:SetActiveE(0)
        self.go_table.obj_title2:SetActiveE(1)
    end
    if cfgs[1] and cfgs[1] > 0 then
        self.go_table.aortext_rebate.text = GetLangPackValue(cfgs[1])
        self.go_table.aortext_rebate1.text = GetLangPackValue(cfgs[1])
    end
    if cfgs[2] and cfgs[2] > 0 then
        self.go_table.aortext_rebateText.text = GetLangPackValue(cfgs[2])
        self.go_table.aortext_rebateText1.text = GetLangPackValue(cfgs[2])
    end
    --背景图片
    if cfgs[4] then
        self.go_table.aorrawimage_topBg:LoadImage(cfgs[4])
    end
end

