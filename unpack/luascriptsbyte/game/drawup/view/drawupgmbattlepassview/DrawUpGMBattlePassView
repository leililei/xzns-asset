function DrawUpGMBattlePassView:ShowBuyItemAll()
    local ItemDic = {}
    local payAward = self.cfg.award or {}
    for _, v in pairs(payAward) do
        if ItemDic[v.sid] == nil then
            ItemDic[v.sid] = v.num
        else
            ItemDic[v.sid] = ItemDic[v.sid] + v.num
        end
    end
    local sid, num
    for i = 1, #self.countCfgArr do
        for j = 1, #self.countCfgArr[i].rewards_pay do
            sid = self.countCfgArr[i].rewards_pay[j][1]
            num = self.countCfgArr[i].rewards_pay[j][2]
            if sid == 0 and #self.countCfgArr[i].rewards_pay[j] >= 5 then
                sid = self.countCfgArr[i].rewards_pay[j][4]
                num = self.countCfgArr[i].rewards_pay[j][5]
            end
            ItemDic[sid] = (ItemDic[sid] or 0) + num
        end
    end
    self.allRewards = {}
    for k, v in pairs(ItemDic) do
        _G.table.insert(self.allRewards, { k, v })
    end
    table.sort(self.allRewards, function(a, b)
        return a[1] < b[1]
    end)
    self.go_table.scrollloophorizontal_seniorAward:InitItemData(
        #self.allRewards,
        _G.handler(self, self.RefreshSeniorItem)
    )
end

