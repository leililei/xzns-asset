---@class DressingRoomView : UIBaseView 窗口
---@field private go_table DressingRoomView_GoTable GoTable
local DressingRoomView = BaseClass("DressingRoomView",_G.UIBaseView)
local CardCommentManager = require "CardCommentManager":GetInstance()

function DressingRoomView:__init()

end

function DressingRoomView:OnCreate(activity)
    self:InitData(activity)
    self:RefreshData()
    self:InitUI()
    self:RefreshUI()
end

function DressingRoomView:InitData(activity)
    self.activity = activity
    self.activity.typeClass.dressRedLogin = false
    self.activity.typeClass:RefreshRedPoint(5)
    ---@type HeroGiftPackSynModel
    self.model = require "HeroGiftPackSynModel":GetInstance()
    self.BiaoTi =  1
    ---@type HeroGiftPackData
    self.dataList = self.model:CradCfgList(self.BiaoTi)
    for i = 1, #self.model.activityListID do
        local data = self.model:CradCfgList(i)
        local main_type = 1
        if data.curActivityClass.cfg then
            main_type = data.curActivityClass.cfg.info.front.main_type
        end
        if main_type and main_type == 2 then
            self.dataList = data
            self.BiaoTi = i
        end
    end
    
    self.data = self.dataList.item[1]
    self.itemId = self.data.normal_award[1].type[1]
    self.itemcfg = ConfigManager.item_cfg[self.itemId]
    self.skinId = tonumber(self.itemcfg.UseParameter[1][1])
    self.skincfg = ConfigManager.skin_cfg[self.skinId]
    self.cardcfg = ConfigManager.card_cfg[self.skincfg.card]
    self.AllPropItemDic = {}
    self.go_table.aorbtn_btn:SetActiveE(0)
    if self.dataList.CradId == nil then
        self.model:Choose(
            self.cardcfg.id,
            function()
                self:RefreshData()
                self.go_table.aorbtn_btn:SetActiveE(1)
            end,
            self.BiaoTi
        )
    else
        self.go_table.aorbtn_btn:SetActiveE(1)
    end
end

function DressingRoomView:RefreshData()
    self.isReceived = self.dataList:Alist(self.data.sid)
    self.isCanGet =  self.dataList:IsHeroGift(self.data)
end

function DressingRoomView:InitUI()
    self.go_table = _G.GetAutoGoTable(self.gameObject,handler(self,self.onClick))
    self:InitSpine()
end

function DressingRoomView:InitSpine()

    self.go_table.obj_cardSpine:ClearChildren()

    _G.PoolsManager:GetInstance():Spawn(
            self.skincfg.ModelPathHi,
            _G.ePoolType.Temporary,
            self.go_table.obj_cardSpine,
            function(trans)
                if not self.go_table then
                    _G.DestroyObject(trans)
                    return
                end
                trans.gameObject:SetLocalPosition(_G.table.unpack(self.skincfg.pos_portrait))
                trans.gameObject:SetLocalScaleXYZ(self.skincfg.size2)
                _G.PoolsManager:GetInstance():Spawn(
                        "UIH5_xzns/Common/@_obj_SpineClick",
                        _G.ePoolType.UIItem,
                        self.go_table.obj_cardSpine:GetParent(),
                        function(tran)
                            if not self.go_table then
                                _G.PoolsManager:GetInstance():Despawn(tran, _G.ePoolType.UIItem)
                                return
                            end
                            local index = self.go_table.obj_cardSpine:GetSiblingIndexE()
                            tran:SetSiblingIndexE(index + 1)
                            self.go_table.obj_SpineClick = tran
                            tran:SetRectTransformSize(720, 1280)
                            local SpineClick = require("SpineClick").New(tran, trans, 0, 0, self.skincfg.id)
                            self.go_table.SpineClick = SpineClick
                            self.go_table.SpineClick.gameObject:SetActiveE(_G.GameUtil.CheckSkinOverlap(self.skinId) and 0 or 1)
                        end
                )
                self.spineTrans = trans
                local idle = self.skincfg.display_idle[1]
                _G.GameUtil.SetCardUiSpineAnimation(self.spineTrans, idle, true, self.skinId)
                
                --local count = self.go_table.obj_cardSpine:GetChildCountE()
                --if count > 1 then
                --    for i = 1, count do
                --        local obj = self.go_table.obj_cardSpine:GetChildE(i - 1)
                --        obj:SetActiveE(obj:GetName() == self.pathName and 1 or 0)
                --    end
                --end
            end
    )

    self.go_table.obj_miniSpine:ClearChildren()
    if self.cardcfg.Order == 1 then
        self.go_table.obj_miniSpine:SetActiveE(0)
    else
        self.go_table.obj_miniSpine:SetActiveE(1)
        local path = self.skincfg.spine and self.skincfg.spine[1] or self.skincfg.ModelPathHi
        _G.PoolsManager:GetInstance():Spawn(
                path,
                _G.ePoolType.Temporary,
                self.go_table.obj_miniSpine,
                function(obj)
                    if not self.go_table then
                        _G.DestroyObject(obj)
                        return
                    end
                    obj:SetLocalScaleXYZ(self.cardcfg.size6 or 1.2)
                    local sg = obj:GetChildE(0):GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
                    sg.AnimationState:SetAnimation(0, "stand_2", true)
                end
        )
    end
end

function DressingRoomView:RefreshUI()
    local data, skin = CardCommentManager:CardData(self.skinId, true)
    self.go_table.aortext_name.text = _G.GetLangPackValue(self.skincfg.name)
    self.go_table.aortext_name2.text = GetLangPackValue(self.cardcfg.Name)
    self.go_table.aortext_skinName2.text = GetLangPackValue(self.skincfg.name)
    self.go_table.aortext_desc.text = _G.GetLangPackValue(data.card_title)
    self.go_table.aorimage_order.SpriteName = require("CardInfoManager"):GetInstance():GetCardOrderZi(self.cardcfg.Order)
    local isGray = self.isReceived or not self.isCanGet
    self.go_table.obj_Redpoint:SetActiveE(isGray and 0 or 1)
    self.go_table.aorbtn_btn:SetGray(isGray)
    self.go_table.aortext_btn.color = _G.ColorTools.FormatColorByString(isGray and "434343" or "50351E")
    local noAtt = true
    if self.skincfg.base_att and #self.skincfg.base_att > 0 then
        noAtt = false
        --self:ShowProp(Card.base_att)
        self.go_table.obj_AllProp:SetActiveE(1)
        self.go_table.obj_WearEffect:SetActiveE(1)
        self.go_table.obj_AllProp:ClearChildren()
        self:ShowProp(self.skincfg.base_att, self.go_table.obj_AllProp, self.AllPropItemDic)
    else
        self.go_table.obj_AllProp:SetActiveE(0)
        self.go_table.obj_WearEffect:SetActiveE(0)
    end
    ---现在后端没有全队加成，暂时屏蔽
    if self.skincfg.team_base_att and #self.skincfg.team_base_att > 0 then
        noAtt = false
        self.go_table.obj_AllProp2:SetActiveE(1)
        self.go_table.obj_TeamEffect:SetActiveE(1)
        self.go_table.obj_AllProp2:ClearChildren()
        self:ShowProp(self.skincfg.team_base_att, self.go_table.obj_AllProp2, self.AllPropItemDic)
    else
        self.go_table.obj_AllProp2:SetActiveE(0)
        self.go_table.obj_TeamEffect:SetActiveE(0)
    end
    self.go_table.aortext_tips:SetActiveE(noAtt and 1 or 0)
    --self.CardData:SetSkin(self.NowPutSkinIndex)
    if self.isReceived then
        self.go_table.aortext_btn.text = GetLangPackValue(90023800011)
    else
        self.go_table.aortext_btn.text = GetLangPackValue(90023800054)
    end
    if self.spineTrans then
        local idle = self.skincfg.display_idle[1]
        if _G.AppSetting.HeXieLevel > 0 and self.isReceived then
            _G.GameUtil.SetCardUiSpineAnimation(self.spineTrans, idle, false, self.skinId)
        else
            local sg = self.spineTrans:GetChildE(0):GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
            sg.AnimationState:SetAnimation(0, idle, true)
        end
    end
    if self.go_table.SpineClick then
        self.go_table.SpineClick.gameObject:SetActiveE((_G.GameUtil.CheckSkinOverlap(self.skinId) and not self.isReceived) and 0 or 1)
    end
end

function DressingRoomView:onClick(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_btn then
        --领取奖励
        self:GetReward()
    elseif self.go_table.aorbtn_hideUI == go then
        self:HideUI()
    elseif self.go_table.aorbtn_showUI == go then
        self:ShowUI()
    end
end

function DressingRoomView:GetReward()
    if self.isReceived then
        return
    end
    if self.isCanGet == false then
        _G.PopWindowManager:GetInstance():ShowAllTips(240306)
        return
    end
    local function request()
        self.model:JiangLiLingQu(
                self.data.sid,
                2,
                function()
                    self:RefreshData()
                    self:RefreshUI()
                end,
                self.BiaoTi
        )
    end
    local curCardId = self.cardcfg.id
    if curCardId ~= self.dataList.CradId then
        --更换选择的角色id(服务器记录的还是上一期的角色id)
        self.model:Choose(
                curCardId,
                function()
                    request()
                end,
                self.BiaoTi
        )
    else
        request()
    end
end

function DressingRoomView:ShowProp(additions, parent, dic)
    ------ local scale = self.CurArrayData:GetStarAllAttr()
    local len = #additions

    local obj, num

    for i, v in pairs(additions) do
        ---生成属性条

        obj = _G.InstantiateObject(self.go_table.obj_propItem, parent)
        --local obj = _G.GetAutoGoTable(tb)

        -- _G.table.insert(dic, obj)

        num = _G.tonumber(v[3])
        num = _G.AttributeClassManager:GetInstance():GetShowProp(v[1], v[2], num, 0.01, 1)
        self:SetProp(
                obj,
                _G.LangUtil.GetLangPackValue(_G.ConfigManager.type_attribute_cfg[_G.AttrType[v[1]].ID].name),
                num
        )
        obj:SetActiveE(1)
    end
    len = len + 1
    for i = len, #dic do
        dic[i]:SetActiveE(0)
    end
end

function DressingRoomView:SetProp(obj, name, num)
    local go_table = _G.GetAutoGoTable(obj)
    go_table.aortext_strenName.text = _G.tostring(name)
    go_table.aortext_strenNum.text = "+" .. _G.tostring(num)
end

function DressingRoomView:HideUI()
    self.go_table.obj_view:SetActiveE(0)
    self.go_table.aorbtn_showUI:SetActiveE(1)
end

function DressingRoomView:ShowUI()
    self.go_table.obj_view:SetActiveE(1)
    self.go_table.aorbtn_showUI:SetActiveE(0)
end

---@return DressingRoomView
return DressingRoomView