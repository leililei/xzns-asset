function DrawUpBossRankView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.itemList = {}
    self:AddListener(_G.eBattleState.RecordStart, self.RecordStart)
    self:AddListener(_G.eBattleState.RecordEnd, self.RecordEnd)
end

function DrawUpBossRankView:RecordStart()
    self:Hide()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.DrawUpBossRankView.Name)
end

function DrawUpBossRankView:RecordEnd()
    self:Show()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.DrawUpBossRankView.Name)
end

---界面的入口函数
function DrawUpBossRankView:OnCreate(typeId, RewardDatas, resourcesId)
    self.typeId = typeId
    self.RewardData = RewardDatas
    self.resourcesId = resourcesId
    _G.table.sort(
        self.RewardData,
        function(a, b)
            return a.sid < b.sid
        end
    )
    self.RewardDatas = {}
    for i = 1, #self.RewardData do
        local cfg = {}
        self.RewardDatas[i] = self.RewardData[i]
        for key, value in pairs(self.RewardData[i].award) do
            if value.type[1] ~= self.resourcesId then
                _G.table.insert(cfg, value)
            end
        end
        if self.RewardData[i].coin > 0 then
            _G.table.insert(cfg, { type = { self.resourcesId, self.RewardData[i].coin } })
        end
        self.RewardDatas[i].award = cfg
    end


    self:InitToggle()
    if self.go_table.toggle_zoneRank:GetActiveSelf() == 1 then
        self.go_table.toggle_zoneRank.isOn = true
    else
        self.go_table.toggle_rank.isOn = true
    end
    ---排行回放 不会关闭 挑战界面
    -- local DrawUpPeakView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DrawUpPeakView.Name)
    -- if DrawUpPeakView then
    --     DrawUpPeakView:Hide()
    -- end
end

function DrawUpBossRankView:InitToggle()
    self.Toggles = {}
    self.Toggles["Rank"] =
        _G.GetAutoGoTable(
            self.go_table.toggle_rank,
            _G.handlerbind(self, self.OnToggle, "Rank", _G.handler(self, self.OnRank))
        )
    self.Toggles["Reward"] =
        _G.GetAutoGoTable(
            self.go_table.toggle_reward,
            _G.handlerbind(self, self.OnToggle, "Reward", _G.handler(self, self.OnReward))
        )
    if false then
        self.go_table.toggle_zoneRank:SetActiveE(1)
        self.Toggles["ZoneRank"] =
            _G.GetAutoGoTable(
                self.go_table.toggle_zoneRank,
                _G.handlerbind(self, self.OnToggle, "ZoneRank", _G.handler(self, self.OnZoneRank))
            )
    else
        self.go_table.toggle_zoneRank:SetActiveE(0)
    end
    self.go_table.toggle_rank:SetActiveE(
        require "ZoneRankModel":GetInstance():CheckIsShowSingle(_G.ZoneRankType.DrawUpPeak) and 1 or 0
    )
end

---点击Togggle
function DrawUpBossRankView:OnToggle(go, isOn, key, call)
    local tb = self.Toggles[key]
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOff, not isOn)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, isOn)
    if call then
        call(isOn)
    end
end

---大区排行
function DrawUpBossRankView:OnZoneRank(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_ZoneRank, isOn)
    if not isOn then
        return
    end
    if not self.ZoneRank then
        local name = "UI/ZoneRank/$_obj_zoneRank"
        _G.PoolsManager:GetInstance():Spawn(
            name,
            _G.ePoolType.Temporary,
            self.go_table.obj_ZoneRank,
            function(trans)
                _G.GameUtil.SetActiveByCondition(trans, true)
                local view = self:AddComponent(trans.gameObject, require "ZoneRankView".New(trans, self))
                view:InitView(_G.ZoneRankType.DrawUpPeak, self.typeId)
                self.ZoneRank = view
            end
        )
    end
end

---排行
function DrawUpBossRankView:OnRank(isOn)
    -- _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)

    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Rank, isOn)
    if not isOn then
        return
    end
    if not self.Rank then
        self.Rank = _G.GetAutoGoTable(self.go_table.obj_Rank)
        -- _G.GameUtil.SetActiveByCondition(self.Rank.obj_yiwu, false)
        self.rankDatas = require("DrawUpMainModel"):GetInstance():GetrankList(self.typeId) or {}

        self.rankList = {}
        self.rewardList_Rank = {}
        self.Rank.scrollloopvectical_rankList:InitItemData(#self.rankDatas, _G.handler(self, self.RefreshRank))
        _G.GameUtil.SetActiveByCondition(self.Rank.obj_no, #self.rankDatas <= 0)
        self:InitPlayer()
    end
end

---刷新排行
function DrawUpBossRankView:RefreshRank(index, obj)
    local newindex = index + 1
    local instanceID = obj:GetInstanceIDE()
    local tb1 = self.rankList[instanceID]
    if not self.rankList[instanceID] then
        tb1 = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.RankItemClick, tb1))
        self.rankList[instanceID] = tb1
        -- self.rankList[instanceID].scrollloophorizontal_AwardList:InitItemData(
        --     0,
        --     _G.handlerbind(self, self.RefreshReward, self.rewardList_Rank, self.rankList[instanceID])
        -- )
    end
    local tb = self.rankList[instanceID]
    local data = self.rankDatas[newindex]
    tb.rankData = data
    tb.data = self:GetRankData(newindex)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_rankBg, newindex <= 3)
    _G.GameUtil.SetActiveByCondition(tb.obj_rankBg2, newindex > 3)
    if newindex <= 3 then
        tb.aorimage_rankBg.SpriteName = "tz_qjhs_di_0" .. (newindex + 1)
        tb.aorimage_rank.SpriteName = "tz_qjhs_phb_mingci_0" .. newindex
    else
        tb.aortext_rankNum.text = newindex
    end
    tb.aortext_name.text = data.role_info.name
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data.role_info, 1, true, true, true)
    tb.aortext_damage.text = _G.GameUtil.NumberToUnitStr(data.dps)
    if not tb.list then
        tb.list = {}
    end
    tb.aorbtn_yiwu:SetActiveE(0)
    tb.aorbtn_huifang:SetActiveE(0)
    -- if tb.data then
    --     self:ShowAward(tb, tb.obj_item, tb.data.reward_daily)
    -- else
    --     self:ShowAward(tb, tb.obj_item, {})
    -- end
    self:ShowTeam(tb.trans_cardnode, data.array)
end

function DrawUpBossRankView:ShowTeam(parent, data)
    if parent:GetChildCountE() > 0 then
        for i = 1, parent:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(parent:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    local teamcard = data
    for i = 1, 5 do
        if teamcard[i] then
            local data = teamcard[i]
            -- _G.StorageManager:GetInstance():GetItemBaseView(
            --     teamcard[i].sid,
            --     nil,
            --     parent,
            --     function(item)
            --         --item:Show(data)
            --     end
            -- )
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.ItemCardStorageView,
                parent,
                function(item)
                    if _G.IsNil(parent) then
                        _G.PoolsManager:GetInstance():Despawn(item, _G.ePoolType.UIItem)
                        return
                    end
                    item:Show(data.sid, nil, data.star, data.soul_lv, data.level)
                end
            )
        end
    end
end

function DrawUpBossRankView:RankItemClick(go, ref, tb)
    local data = tb.rankData
    local name = go:GetName()
    if name == "@_aorbtn_HeadClick" then
        if data.uid > 0 then
            if data.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.PopWindowManager:GetInstance():ShowAllTips(620109)
            else
                _G.SystemSettingManager:GetInstance():OpenView(data.uid)
            end
        end
    elseif name == "@_aorbtn_huifang" then
        require "DungonesModel":GetInstance():PlayRankHuiFang(10, data.uid)
    end
end

function DrawUpBossRankView:ShowAward(tb, obj, award, parent)
    if not tb.list then
        tb.list = {}
    end
    local count = #tb.list
    local count2 = #award or 0
    for i = 1, count do
        if i <= count2 then
            tb.list[i]:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(award[i]))
            _G.GameUtil.SetActiveByCondition(tb.list[i].gameObject, true)
        else
            _G.GameUtil.SetActiveByCondition(tb.list[i].gameObject, false)
        end
    end
    if count < count2 then
        for i = count + 1, count2 do
            local obj2 = _G.InstantiateObject(obj)
            obj2:SetParentE(tb.trans_Content)
            local item = require "BaseAwardNewItem".New(obj2, nil, 73, obj2:GetChildE(0))
            tb.list[i] = item
            local data = award[i].type
            item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
        end
    end
end

function DrawUpBossRankView:GetRankData(index)
    if index <= 0 then
        return
    end
    for _, v in ipairs(self.RewardDatas) do
        if index >= v.ranks[1] and index <= (v.ranks[2] or v.ranks[1]) then
            return v
        end
    end
    return nil
end

---显示玩家排行
function DrawUpBossRankView:InitPlayer()
    self.playerRank = require("DrawUpMainModel"):GetInstance():playerRank(self.typeId)
    if not self.player then
        self.player =
            _G.GetAutoGoTable(
                self.Rank.obj_player,
                _G.handlerbind(self, self.RankItemClick,
                    { rankData = { uid = _G.PlayerModel:GetInstance():GetPlayerUid() } })
            )
        -- self.player.scrollloophorizontal_AwardList:InitItemData(
        --     0,
        --     _G.handlerbind(self, self.RefreshReward, self.rewardList_Rank, self.player)
        -- )
    end
    local tb = self.player
    local newindex = self.playerRank.index
    tb.data = self:GetRankData(newindex)
    if newindex == 0 then
        tb.aortext_rankNum.text = _G.LangUtil.GetLangPackValue(90022900040)
    else
        tb.aortext_rankNum.text = newindex
    end
    local playerModel = _G.PlayerModel:GetInstance()
    local playerData = {}
    tb.aortext_name.text = playerModel:GetName()
    playerData.frame = playerModel:GetCurFrame()
    playerData.style = playerModel:GetRoleStyle()
    playerData.uid = playerModel:GetPlayerUid()
    playerData.lv = playerModel:GetLevel()
    playerData.title = playerModel:GetTitle()
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, playerData, 1, true, true, true)
    tb.aortext_damage.text = _G.GameUtil.NumberToUnitStr(self.playerRank.value)
    if tb.data then
        self:ShowAward(tb, tb.obj_item, tb.data.award, tb.obj_item:GetChildE(0))
    else
        self:ShowAward(tb, tb.obj_item, {}, tb.obj_item:GetChildE(0))
    end
end

---刷新奖励
function DrawUpBossRankView:RefreshReward(index, obj, list, tb)
    local newIndex = index + 1
    local instanceID = obj:GetInstanceIDE()
    local data = tb.data.reward_daily[newIndex]
    local item = list[instanceID]
    if not item then
        item = require "BaseAwardNewItem".New(obj, _G.handler(self, self.OnClickAward), 73, obj)
        list[instanceID] = item
    end
    item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))
end

---奖励
function DrawUpBossRankView:OnReward(isOn)
    -- _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)

    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Reward, isOn)
    if not isOn then
        return
    end
    local str = _G.LangUtil.GetLangPackValue(90029300021)
    if not self.ZoneRewardRank then
        _G.PoolsManager:GetInstance():Spawn(
            require "ZoneRankModel".GetRewardPrefabPath(),
            _G.ePoolType.Temporary,
            self.go_table.obj_Reward,
            function(trans)
                if self:IsNil() then
                    return
                end
                local view = self:AddComponent(trans.gameObject, require "ZoneRankRewardView".New(trans, self))
                view:InitView(_G.ZoneRankType.DrawUpPeak, nil, self.RewardDatas, str)

                self.ZoneRewardRank = view
            end
        )
    end
end

---刷新奖励2
function DrawUpBossRankView:RefreshReward2(index, obj)
    local newindex = index + 1
    local instanceID = obj:GetInstanceIDE()
    ---@type boss_rank_cfg
    local data = self.RewardDatas[newindex]
    if not self.rewardList[instanceID] then
        self.rewardList[instanceID] = _G.GetAutoGoTable(obj)
        -- self.rewardList[instanceID].scrollloophorizontal_AwardList:InitItemData(
        --     0,
        --     _G.handlerbind(self, self.RefreshReward, self.rewardList_Rank, self.rewardList[instanceID])
        -- )
    end
    local tb = self.rewardList[instanceID]
    tb.data = data
    _G.GameUtil.SetActiveByCondition(tb.aorimage_rank, newindex <= 3)
    if newindex <= 3 then
        tb.aorimage_rank.SpriteName = "tz_qjhs_phb_mingci_0" .. newindex
        tb.aortext_rank.text = ""
    elseif data.min_rank == data.max_rank then
        tb.aortext_rank.text = newindex
    else
        tb.aortext_rank.text = _G.string.format("%s~%s", data.min_rank, data.max_rank)
    end
    if tb.data then
        self:ShowAward(tb, tb.obj_Award, tb.data.reward_daily)
    else
        self:ShowAward(tb, tb.obj_Award, {})
    end
end

---按钮点击事件在这里派发
function DrawUpBossRankView:OnClickBtn(go, isOn)
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)

    if go == self.go_table.aorbtn_close then
        self:Close()
        ---排行回放 不会关闭 挑战界面
        local DrawUpPeakView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DrawUpPeakView.Name)
        if DrawUpPeakView then
            DrawUpPeakView:Show()
        end
        local window = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DrawUpBossRankView.Name)
        if window then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DrawUpBossRankView.Name)
        end
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
        ---排行回放 不会关闭 挑战界面
        local DrawUpPeakView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DrawUpPeakView.Name)
        if DrawUpPeakView then
            DrawUpPeakView:Show()
        end
        local window = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DrawUpBossRankView.Name)
        if window then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DrawUpBossRankView.Name)
        end
    end
end

return DrawUpBossRankView
