---点击抽卡按钮
function DrawUpMainView:DrawCard(type)
    if require("DrawUpMainModel"):GetInstance().JianGe then
        return
    end
    if #self.limited_item > 1 and self.wish_card == 0 then
        self:ShowGuide()
        return
    end

    local model = require("DrawUpMainModel"):GetInstance()
    --获取拥有的招募券数量
    local coinNum = require "DrawUpMainModel":GetInstance():GetPropNum(self.ActivityID)
    --获取魂玉召唤总次数
    local totalTimes = model:GetDiamondTotalTimes(self.ActivityID)
    local remainTimes = totalTimes - model:GetDiamondTimes(self.ActivityID)

    local tens = coinNum >= 10 and 10 or coinNum

    local num = type == 1 and 1 or (tens > 0 and tens or 10)
    local num1 = type == 1 and 1 or 10
    local list = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    if _G.table.count(list) + num > _G.StorageManager:GetInstance():GetStorageCapacity(_G.StorageID.Card) then
        _G.PopWindowManager:GetInstance():ShowAllTips(langugageId.CardBagIsFull)
        return
    end

    ---@type number 消耗模式: 1活动代币 2魂玉
    local consumeType
    local consumeNum = 0
    if coinNum >= num or totalTimes == 0 or remainTimes < num1 then
        --检查招募券数量
        if coinNum < num then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.coinId)
            return
        end
        consumeType = _G.DrawConsumeType.token
    else
        --检查魂玉数量
        consumeNum = model:GetDiamondConsume(self.ActivityID, num)
        if type == _G.DrawType.TenTimes then
            local limited_roller_cfg = require "DrawUpMainModel":GetInstance():Getlimited_roller_cfg(self.ActivityID)
            local discount = limited_roller_cfg.ticket_discount[1]
            if nil ~= discount then
                consumeNum = _G.Mathf.Floor(consumeNum * discount / 10000)
            end
        end
        local ownNum = _G.StorageManager:GetInstance():GetItemCountBySid(_G.ResPropID.Diamond)
        if ownNum < consumeNum then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ResPropID.Diamond)
            return
        end
        consumeType = _G.DrawConsumeType.diamond
    end

    if consumeType == _G.DrawConsumeType.diamond then
        _G.PopWindowManager:GetInstance():ShowBtnWindowByToggle(
            630,
            function()
                require "IllustrationModel":GetInstance().NewChoKa = {}
                require("DrawUpMainModel"):GetInstance():DrawCard(
                    self.ActivityID,
                    consumeType,
                    num,
                    type,
                    _G.handler(self, self.Shuaxing),
                    _G.handlerbind(self, self.IsEff)
                )
            end,
            function()
            end,
            nil,
            true,
            consumeNum,
            num, 
            _G.GetLangPackValue(_G.ConfigManager.currency_type_client_cfg[self.coinId].name),
            num
        )
    else
        require "IllustrationModel":GetInstance().NewChoKa = {}
        require("DrawUpMainModel"):GetInstance():DrawCard(
                self.ActivityID,
                consumeType,
                num,
                type,
                _G.handler(self, self.Shuaxing),
                _G.handlerbind(self, self.IsEff)
        )
    end
end

---特效显示隐藏
function DrawUpMainView:IsEff(num, call, Elements)
    self.var = self.go_table.aorimage_onceLan
    local it = _G.ConfigManager.ui_effect_cfg["ef_DrawUpMainView_once_lan"].LifeTime

    if num == 1 then
        self.go_table.aorimage_onceLan:SetActiveE(1)
    elseif num == 2 then
        if Elements >= 6 then
            it = _G.ConfigManager.ui_effect_cfg["ef_DrawUpMainView_once_jin"].LifeTime

            self.go_table.aorimage_onceJin:SetActiveE(1)
            self.var = self.go_table.aorimage_onceJin
        else
            it = _G.ConfigManager.ui_effect_cfg["ef_DrawUpMainView_once_zi"].LifeTime

            self.go_table.aorimage_onceZi:SetActiveE(1)
            self.var = self.go_table.aorimage_onceZi
        end
    end
    if self.eff == nil then
        self.eff = _G.TimerManager:GetInstance():GetTimer(it, self.EffClose, self, false, false, true, call)
        self.eff:Start()
    end
end

function DrawUpMainView:EffClose(call)
    if self.eff then
        self.eff:Stop()
        self.eff = nil
    end
    if self.var then
        self.var:SetActiveE(0)
    end
    if call then
        require("DrawUpMainModel"):GetInstance().JianGe = false

        call()
    end
end

function DrawUpMainView:Dispose()
    self.Anim = nil

    if self.taskTipTimer then
        self.taskTipTimer:Stop()
        self.taskTipTimer = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.ResUpdate, self)
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.ResRefresh, self.ResUpdate, self)
end

