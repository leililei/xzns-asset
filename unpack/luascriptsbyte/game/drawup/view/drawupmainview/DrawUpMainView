---加载招募消耗信息(图标和数量)
function DrawUpMainView:LoadConsumesInfos()
    local model = require("DrawUpMainModel"):GetInstance()

    --获取招募券数量
    local coinNum = model:GetPropNum(self.ActivityID)
    --获取魂玉召唤总次数
    local totalTimes = model:GetDiamondTotalTimes(self.ActivityID)
    local remainTimes = totalTimes - model:GetDiamondTimes(self.ActivityID)

    local isdiamod = false
    --左边
    local leftIcon, leftNum, rightIcon, rightNum
    if coinNum >= 1 or totalTimes == 0 or remainTimes < 1 then
        leftNum = 1
        leftIcon = getCurrencyTypeIcon(self.coinId)
    else
        leftNum = model:GetDiamondConsume(self.ActivityID, 1)
        leftIcon = _G.StorageManager:GetInstance():GetItemIcon(_G.ResPropID.Diamond)
        isdiamod = true
    end
    --右边
    if coinNum >= 1 or totalTimes == 0 or remainTimes < 10 then
        if coinNum >= 10 then
            rightNum = 10
        else
            rightNum = coinNum > 0 and coinNum or 10
        end
        rightIcon = getCurrencyTypeIcon(self.coinId)
    else
        rightNum = model:GetDiamondConsume(self.ActivityID, 10)
        rightIcon = _G.StorageManager:GetInstance():GetItemIcon(_G.ResPropID.Diamond)
        isdiamod = true
    end

    if isdiamod then
        self.go_table.aortext_PropRightNumDesc.text = _G.GetLangPackValue(90000011229, GameUtil.NumberToWordByLanguage(10))
    else
        self.go_table.aortext_PropRightNumDesc.text = _G.GetLangPackValue(90000011229, GameUtil.NumberToWordByLanguage(rightNum))
    end
    self.go_table.aortext_PropLeftNum.text = tostring(leftNum)
    self.go_table.aortext_PropRightNum.text = tostring(rightNum)

    if isdiamod then
        --local model = require("DrawUpMainModel"):GetInstance()
        local usedTimes = model:GetDiamondTimes(self.ActivityID)
        --local totalTimes = model:GetDiamondTotalTimes(self.ActivityID)
        local remain = totalTimes - usedTimes

        local limited_roller_cfg = model:Getlimited_roller_cfg(self.ActivityID)
        local discount = limited_roller_cfg.ticket_discount[1]
        if nil ~= discount and remain >= 10 then
            self.go_table.aortext_PropRightNum.text = string.format("%.0f", rightNum * discount / 10000)
        end
    end

    self.go_table.aorrawimage_PropLeft:LoadImage(
            leftIcon,
            function(image)
                if image then
                    image:SetActiveE(1)
                end
            end
    )
    self.go_table.aorrawimage_PropRight:LoadImage(
            rightIcon,
            function(image)
                if image then
                    image:SetActiveE(1)
                end
            end
    )
end

