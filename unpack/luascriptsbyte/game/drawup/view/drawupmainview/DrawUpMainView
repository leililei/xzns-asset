                            function(image)
                                if image ~= nil then
                                    image:SetActiveE(1)
                                    image:SetNativeSize()
                                end
                            end
                    )
                elseif k == 2 then
                    self.go_table.aorrawimage_Card:LoadImage(
                            v,
                            function(image)
                                if image ~= nil then
                                    image:SetActiveE(1)
                                    image:SetNativeSize()
                                end
                            end
                    )
                end
            end
        end

        if GetCfgData.background_effects ~= "test" then
            local dev = _G.string.split(GetCfgData.background_effects, "#")
            self.go_table.aorrawimage_di:RemoveAllChildren()
            for key, value in pairs(dev) do
                _G.UIUtils.LoadEffectByPath(value, self.go_table.aorrawimage_di,
                        function(item)
                            item:AddComponentE(_G.typeof(_G.CS.UIParticleOrderChange))
                        end)
            end
        end


        -- 特效配置逻辑
        -- pos_dev字段里 每个特效位置用|分割
        -- 每个特效位置里的字段用$分割，分割后第一个填的是坐标（坐标用#分割）就是绝对值坐标位置，第一个是骨骼点名字就是骨骼位置（骨骼名不能是数字）
        -- 绝对值坐标位置的后面可以填一个数字代表缩放 （可填可不填）
        -- 骨骼坐标后面可以填一个坐标（坐标用#分割）（可填可不填），代表相对骨骼点偏移，坐标后面可以填一个数字代表缩放（可填可不填，如果要填也要填前面的偏移坐标）
        -- 示例 "0#0#0$2|bone3$0#0#0$2"
        if GetCfgData.pos ~= "test" and GetCfgData.pos ~= "" and id == self.limited_item[1][1] then
            self.spineEffPos = {}

            if GetCfgData.pos_dev ~= "test" then
