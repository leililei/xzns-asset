        ---添加要显示的货币或者资源
        local resources = _G.ConfigManager.ui_cfg.DrawUpMainView.resources
        local newResource = {}
        for i = 1, #resources do
            if resources[i] == 106 then
                newResource[i] = DrawUpCoinModel:GetInstance():GetCoinId(self.ActivityID)
            else
                newResource[i] = resources[i]
            end
        end
        if #newResource > 0 then
            self.goldT = self:AddComponent(
                    self.go_table.obj_GoldInfo,
                    require("ResourceCompont").New(self.go_table.obj_GoldInfo, newResource)
            )
