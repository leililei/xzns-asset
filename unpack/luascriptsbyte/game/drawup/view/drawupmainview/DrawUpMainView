    _G.PlayerPrefsManager.SetInt(
            "DrawUpMainViewkaiguan" .. require "DrawUpMainModel":GetInstance():GetCfgId(self.ActivityID),
            1
    )
    self.activity.typeClass:RefreshRedPoint(self.ActivityID)

    self.giftActivity = HeroGiftPackSynModel:GetInstance():GetActivityByCardId(self.activity:GetJumpType(self.ActivityID), 1)

