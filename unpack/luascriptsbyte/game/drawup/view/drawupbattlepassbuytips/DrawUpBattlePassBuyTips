---@class DrawUpBattlePassBuyTips	中文描述
local DrawUpBattlePassBuyTips = _G.BaseClass("DrawUpBattlePassBuyTips", _G.Component)

local GetLangPackValue = _G.GetLangPackValue
local ActivitySynManager = require("ActivitySynManager")

---类的构造函数
---@param Params_FundBuyTips Params_FundBuyTips
function DrawUpBattlePassBuyTips:__init(obj, Params_FundBuyTips)
    self.okFun = Params_FundBuyTips.okFun
    self.activityId = Params_FundBuyTips.activityId
    self.closeFun = Params_FundBuyTips.ActivityID
    self.price = Params_FundBuyTips.price or 0
    self.goods = Params_FundBuyTips.goods or {}
    self.content = Params_FundBuyTips.content
    self.name = Params_FundBuyTips.name or ""
    self.nowLevel = Params_FundBuyTips.nowLevel

    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self:Init()
end
function DrawUpBattlePassBuyTips:Parse(Params_FundBuyTips)
    self.okFun = Params_FundBuyTips.okFun
    self.closeFun = Params_FundBuyTips.closeFun
    self.activityId = Params_FundBuyTips.activityId
    self.goods = Params_FundBuyTips.goods or {}
    self.price = Params_FundBuyTips.price or 0
    self.content = Params_FundBuyTips.content
    self.name = Params_FundBuyTips.name or ""
    self.nowLevel = Params_FundBuyTips.nowLevel
    self:Init()
    self:Hide()
end

function DrawUpBattlePassBuyTips:Init()
    --刷新时间
    local activity = require("ActivitySynManager"):GetInstance():GetActivityClass(self.activityId)
    self.typeClass = activity.typeClass
    self.countDown = activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Close) - _G.TimeUtil.GetServerUnixTime()
    self:UpdateTime(0)
    self:StopTimer()
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()

    self:LoadSpine()

    local info = _G.LoginManager:GetInstance():GetGooglePayInfoByPrice(self.price)
    if info then
        self.go_table.aortext_rmb.text = info.formattedPrice
    else
        ---如果是海外版本用多语言美元符号，反之国服使用元作为单位
        if _G.AppSetting.IsOverseas then
            self.go_table.aortext_rmb.text =
                GetLangPackValue(90000010807) .. GetLangPackValue(90025500017, _G.GameUtil.RatioControl(self.price))
        else
            self.go_table.aortext_rmb.text =
                GetLangPackValue(90025500017, GetLangPackValue(90000010819, _G.GameUtil.RatioControl(self.price)))
        end
    end

    --self.go_table.aortext_name.text = self.name
    if self.content == nil then
        if _G.AppSetting.DEBUG then
            _G.Log("", "<color=red>" .. "参数有误 奖励为空" .. "</color>")
        end
        return
    end

    ---总计获得
    ---{ sid=num, }
    local rewardsSumDic = {}
    ---立即获得
    local rewardsDic = {}
    local payAward = self.goods or {}
    for _, v in pairs(payAward) do
        if rewardsDic[v.sid] == nil then
            rewardsDic[v.sid] = v.num
        else
            rewardsDic[v.sid] = rewardsDic[v.sid] + v.num
        end
    end
    -- ---购买立即奖励钻石
    -- rewardsDic[self.goods[1][1]] = self.goods[1][2]

    local sid, num, cfgid, isPass
    ---@type store_battle_content_cfg
    local cfgInfo
    for i = 1, #self.content do
        isPass = self.nowLevel and self.nowLevel >= self.content[i].level
        --isPass = _G.GlobalConditionManager.CheckCondition(cfgInfo.conditions[1], cfgInfo.conditions[2])
        for j = 1, #self.content[i].rewards_pay do
            local data = self.content[i].rewards_pay[j]
            sid = data[1]
            num = data[2]
            if data[4] and data[5] then
                sid = data[4]
                num = data[5]
            end

            if rewardsSumDic[sid] == nil then
                rewardsSumDic[sid] = num
            else
                rewardsSumDic[sid] = rewardsSumDic[sid] + num
            end

            if isPass then
                if rewardsDic[sid] == nil then
                    rewardsDic[sid] = num
                else
                    rewardsDic[sid] = rewardsDic[sid] + num
                end
            end
        end
    end

    -- for sid, num in pairs(rewardsSumDic) do
    --     _G.StorageManager:GetInstance():GetItem(self.go_table.obj_item1, sid, num, _G.handler(self, self.itemCall))
    -- end

    -- for sid, num in pairs(rewardsDic) do
    --     _G.StorageManager:GetInstance():GetItem(self.go_table.obj_item2, sid, num, _G.handler(self, self.itemCall))
    -- end
    self.go_table.obj_item1:RemoveAllChildren()
    for awardSid, awardNum in pairs(rewardsDic) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew({[1]=awardSid,[2]=awardNum},self.go_table.obj_item1,_G.handler(self, self.itemCall))
    end
    
    if _G.table.count(rewardsSumDic) >= 5 then
        self.go_table.obj_item2:SetPivotPosition(0,0.5)
    end
    self.go_table.obj_item2:RemoveAllChildren()
    local i = 0
    for awardSid, awardNum in pairs(rewardsSumDic) do
        -- i = i + 1
        -- if i > 4 then
        --     break
        -- end
        _G.StorageManager:GetInstance():GetItemBaseViewNew({[1]=awardSid,[2]=awardNum},self.go_table.obj_item2,_G.handler(self, self.itemCall))
    end
    
end

function DrawUpBattlePassBuyTips:StopTimer()
    if self.timer then
       self.timer:Stop()
       self.timer = nil 
    end
end

function DrawUpBattlePassBuyTips:UpdateTime(elapsed)
    self.countDown = self.countDown - elapsed
    if self.countDown < 0 then
        self.countDown = 0
    end
    if self.go_table == nil then
        return
    end
    local time = _G.Mathf.RoundToInt(self.countDown)
    self.go_table.aortext_time.text =
    GetLangPackValue(90028900002, _G.string.AddColor(_G.TimeUtil.TransDayHourMineMiao(time), "69fa3c"))
end

function DrawUpBattlePassBuyTips:LoadSpine()
    if not self.spine then 
        local cfg = _G.ConfigManager.card_cfg[116040000]
        _G.PoolsManager:GetInstance():Spawn(
            cfg.ModelPathHi,
            _G.ePoolType.UIItem,
            self.go_table.obj_spine,
            function(trans)
                if not self.go_table then
                    _G.DestroyObject(trans)
                    return
                end
                self.spine = trans
                trans:SetLocalScaleXYZ(cfg.size2)     
                trans:SetLocalPosition(_G.table.unpack(cfg.pos_portrait))
            end
        )
    end
end

function DrawUpBattlePassBuyTips:Show()
    self.gameObject:SetActiveE(1)
end
function DrawUpBattlePassBuyTips:Hide()
    self.gameObject:SetActiveE(0)
end

function DrawUpBattlePassBuyTips:UpdateNowLevel(nowLevel)
    self.nowLevel = nowLevel
    self:Init()
end

function DrawUpBattlePassBuyTips:itemCall(itemLua)

    ---@type ItemViewBase
    local lua = itemLua
    lua.gameObject:SetLocalScaleXYZ(0.9)
    lua:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
    lua:ShowEffectOrder(true)
end

function DrawUpBattlePassBuyTips:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_btn then
        if self.okFun then
            self.okFun()
        end
        self:Hide()
    elseif go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close2 then
        if self.closeFun then
            self.closeFun()
        end
        self:Hide()
    end
end

---类的析构函数
function DrawUpBattlePassBuyTips:Dispose()
    self:StopTimer()
end

return DrawUpBattlePassBuyTips
