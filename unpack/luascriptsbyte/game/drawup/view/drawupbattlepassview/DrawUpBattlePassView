---@private
function DrawUpBattlePassView:InitView()
    self.isUp = self.activity:GetIsUp(self.ActivityID)
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["@_aorbtn_getExp"] = self.OnClick_GetExp,
        ["@_aorbtn_add"] = self.OnClick_AddExp,
        ["@_aorbtn_buy"] = self.ShowBuyTips,
        ["@_aorbtn_oneKey"] = self.OnClick_yjlq,
        ["@_aorbtn_help"] = self.OnClick_help,
        -- [self.go_table.aorbtn_btn:GetName()] = self.ShowBuyTips,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    ---本赛季战令id
    self.id = self.activity:Getsid(self.ActivityID)

    ---@type i_battle_cfg
    self.cfg = self.activity:Getcfg_list(self.ActivityID)

    _G.GameUtil.SetPriceByChannel(self.cfg.price, self.go_table.aortext_rmb)

    self.endTime = self.activity.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)

    local delta = _G.ConfigManager.discrete_cfg[108601][1][1]
    self.AddBtnTime = self.endTime - delta * 86400

    self:SetTimeEnd()
    self.TimerEnd = _G.TimerManager:GetInstance():GetTimer(1, self.SetTimeEnd, self, false, false)
    self.TimerEnd:Start()

    self.conIds = self.cfg.award_id_list
    self.mark = {}
    local limited_battlecon_cfg = _G.ConfigManager.limited_battlecon_cfg
    ---@type limited_battlecon_cfg[]
    self.countCfgArr = {}
    ---@type limited_battlecon_cfg
    local cfgItem
    local tempItem
    local id
    for i = 1, #self.conIds do
        id = self.conIds[i]
        if id == nil or id == 0 then
            if _G.AppSetting.DEBUG then
                _G.LogError(" 配置id 无效  limited_battlecon_cfg.content id:" .. tostring(id))
            end
            cfgItem = nil
        else
            cfgItem = limited_battlecon_cfg[self.conIds[i]]
        end
        if cfgItem then
            tempItem = {
                id = cfgItem.id,
                level = cfgItem.level,
                conditions = cfgItem.conditions,
                rewards_normal = {},
                rewards_pay = {},
                mark = cfgItem.mark
            }
            for _, v in pairs(cfgItem.rewards_free_item) do
                _G.table.insert(tempItem.rewards_normal, v)
            end
            if cfgItem.rewards_free_cur > 0 then
                _G.table.insert(tempItem.rewards_normal, { self.coinId, cfgItem.rewards_free_cur })
            end
            for _, v in pairs(cfgItem.rewards_pay) do
                _G.table.insert(tempItem.rewards_pay, v)
            end
            if cfgItem.rewards_pay_cur > 0 then
                _G.table.insert(tempItem.rewards_pay, { self.coinId, cfgItem.rewards_pay_cur })
            end
            table.insert(self.countCfgArr, tempItem)
            if cfgItem.mark == 1 then
                _G.table.insert(self.mark, cfgItem.level)
            end
        end
    end

    _G.GameUtil.SetActiveByCondition(self.go_table.obj_item, false)

    -- if not self.isUp then
    --     self:ShowBuyItemAll()
    -- end

    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)

    self.key = _G.PlayerModel:GetInstance():GetPlayerUid() ..
        "DrawUpBattlePass" .. self.activity.curActivityClass:GetActivityID() .. self.endTime
    _G.PlayerPrefsManager.SetInt(self.key, 1)

    local res = _G.ConfigManager.ui_cfg.DrawUpBattlePassView.resources
    local newResource = {}
    for i = 1, #res do
        if res[i] == 106 then
            newResource[i] = DrawUpCoinModel:GetInstance():GetCoinId(self.ActivityID)
        else
            newResource[i] = res[i]
        end
    end
    --标题
    -- local title = self.activity:GetTitle()
    -- if not _G.string.IsNullOrEmpty(title) then
    --     self.go_table.aorimage_title.SpriteName = title
    --     self.go_table.aorimage_title:SetNativeSize()
    -- end
    if not self.goldT then
        self.goldT = self:AddComponent(
            self.go_table.obj_GoldInfo,
            require("ResourceCompont").New(self.go_table.obj_GoldInfo, newResource)
        )
    end

    self.go_table.obj_cardSpine:ClearChildren()
    local cfg = require("CardInfoManager").GetCardSkin_ShowCfg(0, 111050000)
    _G.PoolsManager:GetInstance():Spawn(
        cfg.ModelPathHi,
        _G.ePoolType.Temporary,
        self.go_table.obj_cardSpine,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
            GameUtil.SetCardUiSpineAnimation(trans, "idle", true)
        end
    )
    if not self.playerHead then
        self.playerHead = self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))
    end
end

