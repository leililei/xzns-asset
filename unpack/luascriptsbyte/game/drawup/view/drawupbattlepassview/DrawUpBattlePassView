function DrawUpBattlePassView:ShowBuyItemAll()
    local ItemDic = {}
    local payAward = self.cfg.award or {}
    for _, v in pairs(payAward) do
        if ItemDic[v.sid] == nil then
            ItemDic[v.sid] = v.num
        else
            ItemDic[v.sid] = ItemDic[v.sid] + v.num
        end
    end
    local sid
    for i = 1, #self.countCfgArr do
        for j = 1, #self.countCfgArr[i].rewards_pay do
            sid = self.countCfgArr[i].rewards_pay[j][1]
            if ItemDic[sid] == nil then
                ItemDic[sid] = self.countCfgArr[i].rewards_pay[j][2]
            else
                ItemDic[sid] = ItemDic[sid] + self.countCfgArr[i].rewards_pay[j][2]
            end
        end
    end
    self.allRewards = {}
    for k, v in pairs(ItemDic) do
        _G.table.insert(self.allRewards, { k, v })
    end
    self.go_table.scrollloopvectical_seniorAward:InitItemData(
        #self.allRewards,
        _G.handler(self, self.RefreshSeniorItem)
    )
end

