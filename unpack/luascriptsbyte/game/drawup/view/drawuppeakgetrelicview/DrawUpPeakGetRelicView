function DrawUpPeakGetRelicView:Init()
    self.Item1 = _G.GetAutoGoTable(self.go_table.obj_Item_1)
    self.Item2 = _G.GetAutoGoTable(self.go_table.obj_Item_2)
    self.Item3 = _G.GetAutoGoTable(self.go_table.obj_Item_3)

    self.ItemList = {self.Item1, self.Item2, self.Item3}
    self.items_qiwu = {}
    self.animators_qiwu = {}
    for index = 1, 3 do
        local id = self.RelicList[index]
        self.animators_qiwu[id] = {}
        self.items_qiwu[id] = {}
        ---@type mementos_cfg
        local cfg = _G.ConfigManager.mementos_cfg[id]
        local qiwu =
            self:AddComponent(
            self.ItemList[index].gameObject,
            QiwuView.New(
                cfg,
                self.ItemList[index].obj_Root,
                function()
                end,
                function(ani, uieffectnode)
                end
            )
        )
    end
end

---主要界面点击事件
function DrawUpPeakGetRelicView:OnClickBtn(go, IsOn)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_Sure then
        self:Close()
    end
end
function DrawUpPeakGetRelicView:CoOnProgressPlayAni()
    -- self.items_qiwu[self.ChooseIndex].aortext_name:SetActiveE(0) --隐藏字体
    self.items_qiwu[self.ChooseIndex].obj_uieffect:SetActiveE(0) --隐藏特效
    self.animators_qiwu[self.ChooseIndex]:Play("a_qiwu_xuanzhongqueding")
    self.go_table.aorbtn_Sure:DOLocalMoveY(-260, 0.5):SetEase(_G.CS.DG.Tweening.Ease.Linear)
    _G.coroutine.waitforseconds(0.5)
    --self.animators_qiwu[self.ChooseIndex]:SetInteger("queding", 0)
    for key, value in pairs(self.animators_qiwu) do
        if key == self.ChooseIndex then
        else
            value:Play("a_qiwu_quit")
        end
    end
    self.ChooseMementos:DOLocalMove(self.outPosx, self.outPosy, 0, 0.5):SetEase(_G.CS.DG.Tweening.Ease.Linear)
    self.ChooseMementos:DOScale(0, 0, 0, 0.6)
    -- _G.coroutine.waitforseconds(0.3)
    -- self.animators_qiwu[self.ChooseIndex]:Play("a_qiwu_quit")
    _G.coroutine.waitforseconds(0.6)
    self:Close()
    require "DungonesModel":GetInstance():AddMementos(self.ChooseIndex)
    require "DungonesModel":GetInstance().RelicData = nil
    if self.callback ~= nil then
        self.callback()
    end
end
