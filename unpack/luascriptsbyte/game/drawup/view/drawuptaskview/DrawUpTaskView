---@class DrawUpTaskView : UIBaseView	中文描述
---@field public go_table DrawUpTaskView_GoTable GoTable
---@field activity ActivitySynBase
---@field activityCls DrawUpBattlePassTaskModel
---@field otherActivityCls DrawUpBattlePassModel
local DrawUpTaskView = _G.BaseClass("DrawUpTaskView", _G.UIBaseView)
--_G.DrawUpTaskView = DrawUpTaskView

function DrawUpTaskView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eDrawUpBattlePass.DrawUpBattlePassRefeshTask, self.RefreshTask)
    self:InitToggle()
end

---界面的入口函数
function DrawUpTaskView:OnCreate(activity)
    self.activity = activity
    self.activityCls = self.activity:GetActivityTypeCls()
    self.GetJumpType = require "ActivitySynManager":GetInstance():GetChildAcitivity(self.activityCls:GetJumpModelType(), self.activity:GetJumpType())
    self.ActivityID = self.GetJumpType.activityID
    self.otherActivityCls =
        require "ActivitySynManager":GetInstance():GetChildAcitivity(10027, self.activity:GetJumpType())
        :GetActivityTypeCls()
    local GiftActivity= require "ActivitySynManager":GetInstance():GetChildAcitivity(10014, self.activity:GetJumpType())
    self.GiftActivityCls = GiftActivity and GiftActivity:GetActivityTypeCls() or nil
    self.isInited = false
    self:UpdateView()
    self.go_table.toggle_task.isOn=false
    self.go_table.toggle_task.isOn=true
    self.go_table.obj_togglelist:SetActiveE(self.GiftActivityCls==nil and 0 or 1)
    self.endTime = self.activity.cfg.time.start_time + self.activity.cfg.time.run_time
    if self.Timer == nil then
        self:UpdateTime()
        self.Timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.Timer:Start()
    end
    self.isInited = true
    self.giftRedpoint = require("RedPointManager"):GetInstance().nodeTable[self.activityCls:GetRedpointIDByIndex(1)].child[3]
    self.toggles["gift"].obj_redpoint:UpdateRedPointItemIDAndParam(self.giftRedpoint)
end

function DrawUpTaskView:InitToggle()
    self.toggles={}
    self.toggles["gift"] = _G.GetAutoGoTable(
            self.go_table.toggle_gift,
            _G.handlerbind(self, self.OnClickToggle,"gift", _G.handler(self, self.SelectToggle))
    )
    self.toggles["task"] = _G.GetAutoGoTable(
            self.go_table.toggle_task,
            _G.handlerbind(self, self.OnClickToggle, "task", _G.handler(self, self.SelectToggle))
    )
end
function DrawUpTaskView:OnClickToggle(_, isOn, key, call)
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if call and isOn then
        call(key)
    end
end
function DrawUpTaskView:SelectToggle(key)
    self.go_table.obj_giftview:SetActiveE(key=="gift" and 1 or 0)
    self.go_table.obj_panel:SetActiveE(key=="task" and 1 or 0)
    if key=="gift" then
        if self.giftpanel==nil then
            self.giftpanel = require("DrawUpPackPanel").New(self.go_table.obj_giftview,self.GiftActivityCls.curActivityClass,2)
            self:AddComponent(self.go_table.obj_giftview,self.giftpanel)
        end
    end
end
---更新界面
function DrawUpTaskView:UpdateView()
    self:RefreshTask()
    self.go_table.aortext_des.text = self.activity.cfg.info.description
end

function DrawUpTaskView:UpdateTime()
    local endTime = self.endTime
    if not self.go_table then
        return
    end
    if _G.TimeUtil.GetServerUnixTime() <= endTime then
        local timeStr = ""
        local t = _G.TimeUtil.TranslateSecond(endTime - _G.TimeUtil.GetServerUnixTime())
        if t.day > 0 then
            timeStr = _G.string.format(_G.LangUtil.GetLangPackValue(90022100001), t.day, t.hour)
        else
            timeStr = _G.string.format(_G.LangUtil.GetLangPackValue(90021800030), t.hour, t.min, t.sec)
        end
        self.go_table.aortext_time.text = _G.GetLangPackValue(90000010360, string.format("<color=#74ec9c>%s</color>", timeStr))
    else
        self:Close()
    end
end
---任务刷新
function DrawUpTaskView:RefreshTask()
    self.alltaskDatas = self.activityCls:GetAllTaskDatas()
    self:SortTask()
    self.go_table.aortext_page.text=GetLangPackValue(90020800053,self.curpage,#self.taskDatas)
    if not self.isInited then
        self.go_table.scrollloopvectical_Group:InitItemData(#self.taskDatas[self.curpage], _G.handler(self, self.RefreshTaskItem))
    else
        self.go_table.scrollloopvectical_Group:UpdateCount(#self.taskDatas[self.curpage])
    end
end

function DrawUpTaskView:RefreshTaskItem(index, obj)
    ---@type DrawUpTaskView._obj_item_GoTable
    local go_table = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickTask, index + 1))
    go_table.obj_items:ClearChildren()
    local data = self.taskDatas[self.curpage][index + 1]
    if data.i_task.state == _G.TaskEnum.ETaskState.Submited then
        go_table.aortext_info.text = data.Cfg.desc .. _G.string.format("(%s/%s)", data.Cfg.count, data.Cfg.count)
        local isGet = self.activityCls:CheckIsGet(data.Cfg.id)
        go_table.aorbtn_get:SetActiveE(isGet and 0 or 1)
        go_table.aorbtn_way:SetActiveE(0)
        go_table.aorimage_get:SetActiveE(1)
        go_table.aorimage_over:SetActiveE(isGet and 1 or 0)
    else
        go_table.aortext_info.text = data.Cfg.desc .. _G.string.format("(%s/%s)", data.i_task.target[1], data.Cfg.count)
        go_table.aorbtn_get:SetActiveE(0)
        go_table.aorimage_get:SetActiveE(1)
        go_table.aorbtn_way:SetActiveE(1)
        if data.Cfg.link and data.Cfg.link ~= 0 then
            go_table.aorbtn_way:SetGray(false)
            go_table.aortext_label.text = _G.LangUtil.GetLangPackValue(90022200010)
            go_table.aorbtn_way.interactable = true
        else
            go_table.aorbtn_way:SetGray(true)
            go_table.aortext_label.text = _G.LangUtil.GetLangPackValue(90020400086)
            go_table.aorbtn_way.interactable = false
        end
        go_table.aorimage_over:SetActiveE(0)
    end

    for i = 1, #data.Cfg.reward do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            data.Cfg.reward[i].type,
            go_table.obj_items,
            function(tran)
                tran.gameObject:SetLocalScaleXYZ(1)
                if data.Cfg.reward[i].type[2] > 1 then
                    tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                else
                    tran:ShowNumText(false)
                end
                tran:SetGou(self.activityCls:CheckIsGet(data.Cfg.id))
                if tran.ShowEffectOrder and tran.cfg then
                    tran:ShowEffectOrder(tran.cfg.ef_item == 1 and true or false)
                end
            end
        )
    end
end

---设置任务进度
function DrawUpTaskView:SetTaskItemjd(aorimage, value, loopValue_Max)
    local w = value / loopValue_Max
    if w > 1 then
        w = 1
    end
    aorimage:SetRectTransformSize(value > 0 and w * (186) or 0, 14)
end

---点击任务
function DrawUpTaskView:OnClickTask(go, isOn, index)
    local name = go:GetName()
    local data = self.taskDatas[self.curpage][index]
    if name == "@_aorbtn_get" then
        local ids = {}
        for _, data in pairs(self.taskDatas[self.curpage]) do
            if data.i_task.state == _G.TaskEnum.ETaskState.Submited and
                not self.activityCls:CheckIsGet(data.Cfg.id) then
                table.insert(ids, data.i_task.sid)
            end
        end
        self.activityCls:GetAward(ids, function()
            self:UpdateView()
        end)
    elseif name == "@_aorbtn_way" then
        ---策划需求（跳转到对应的界面（专门针对跳当前页面设置（黄东要求，紫薯提议！）
        -- if 162001 == data.Cfg.link then
        --     self:Close()
        --     return
        -- end

        _G.JumpManager:GetInstance():Jump(data.Cfg.link, nil)
    end
end

---经验刷新
function DrawUpTaskView:RefreshExp()
    local level, exp, maxExp, nextAward, isMax = self.otherActivityCls:GetLvAndNextAward(self.ActivityID)
    --self.go_table.aortext_lv.text = level
    if isMax then
        self.go_table.aortext_exp.text = _G.GetLangPackValue(90021700023)
        self.go_table.slider_expSlider.value = 1
        self.go_table.aortext_next.text = _G.GetLangPackValue(90029300006)
    else
        --self.go_table.aortext_exp.text = _G.GetLangPackValue(90029300007, maxExp - exp)
        self.go_table.slider_expSlider.value = exp / maxExp
        self.go_table.aortext_next.text = _G.GetLangPackValue(90029300008)
    end
    self:UpdateNextLvAward(level, nextAward, isMax)
end

function DrawUpTaskView:SortTask()
    self.taskDatas={}
    local page=0
    self.curpage=1
    for i = 1, #self.alltaskDatas do
        page=self.alltaskDatas[i].Cfg.page
        if self.taskDatas[page] then
            table.insert(self.taskDatas[page],self.alltaskDatas[i])
        else
            self.taskDatas[page]={}
            table.insert(self.taskDatas[page],self.alltaskDatas[i])
        end
        self.curpage=self.curpage<self.alltaskDatas[i].Cfg.page and self.alltaskDatas[i].Cfg.page or self.curpage
    end
    for i = 1, #self.taskDatas do
        for j = 1, #self.taskDatas[i] do
            if self.activityCls:CheckIsGet(self.taskDatas[i][j].Cfg.id)==nil then
                self.curpage=self.taskDatas[i][j].Cfg.page<self.curpage and self.taskDatas[i][j].Cfg.page or self.curpage
            end
        end
    end
    ---@param data DrawUpBattlePassTaskData
    for i = 1, #self.taskDatas do
        _G.SortList(
                self.taskDatas[i],
                function(data)
                    local index = 1
                    if data.i_task.state == _G.TaskEnum.ETaskState.Submited then
                        index = 2
                        if self.activityCls:CheckIsGet(data.i_task.sid) then
                            index = -1
                        end
                    end
                    return index, -data.i_task.sid
                end
        )
    end
end

---更新下一等级可获得奖励
function DrawUpTaskView:UpdateNextLvAward(level, nextAward, isMax)
    if self.level and self.level == level and not isMax then
        return
    end
    self.level = level
    self.go_table.obj_normalPos:ClearChildren()
    self.go_table.obj_cashlPos:ClearChildren()
    for i = 1, #nextAward.free do
        local tb = nextAward.free[i]
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            tb,
            self.go_table.obj_normalPos,
            function(item)
                if self:IsNil() then
                    _G.DestroyObject(item.go_table.gameObject)
                    return
                end
                item.go_table.gameObject:SetRectTransformSize(88, 88)
                if isMax then
                    item:SetGou(true)
                end
                if tb[2] > 1 then
                    item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                else
                    item:ShowNumText(false)
                end
                if item.ShowEffectOrder then
                    item:ShowEffectOrder(item.cfg.ef_item == 1 and true or false)
                end
            end
        )
    end
    for i = 1, #nextAward.pay do
        local tb = nextAward.pay[i]
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            tb,
            self.go_table.obj_cashlPos,
            function(item)
                if self:IsNil() then
                    _G.DestroyObject(item.go_table.gameObject)
                    return
                end
                item.go_table.gameObject:SetRectTransformSize(88, 88)
                if isMax then
                    item:SetGou(true)
                end
                if tb[2] > 1 then
                    item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                else
                    item:ShowNumText(false)
                end
                if item.ShowEffectOrder then
                    item:ShowEffectOrder(item.cfg.ef_item == 1 and true or false)
                end
            end
        )
    end
end

---按钮点击事件在这里派发
function DrawUpTaskView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        require("RedPointManager"):GetInstance():RefreshNode(self.activityCls:GetRedpointIDByIndex(1))
        self:Close()
    elseif go == self.go_table.aorbtn_getAll then
        local getTaskList = self.activityCls:GetCankTaskList()
        self.activityCls:GetAward(
            getTaskList,
            function()
                self:UpdateView()
            end
        )
    end
end

function DrawUpTaskView:Dispose()
    if self.Timer then
        self.Timer:Stop()
        self.Timer = nil
    end
end

return DrawUpTaskView
