---@class BattlePassTaskPanel : Component	中文描述
local BattlePassTaskPanel = _G.BaseClass("BattlePassTaskPanel", _G.Component)

---创建对象时,入口构造函数
function BattlePassTaskPanel:OnCreate(obj, activity, mParentView)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.activity = activity
    self.activityCls = activity:GetActivityTypeCls()
    self.mParentView = mParentView
    self.endTime = self.activity:GetActivityDeadLineByCondition(require("ActivitySynManager").State.Close)
    self:InitView()
    self:InitPrecast()

    self:SetActivityTimer()
    self.activityTimer = _G.TimerManager:GetInstance():GetTimer(1, self.SetActivityTimer, self, false, false)
    self.activityTimer:Start()
end

function BattlePassTaskPanel:StopTimer()
    if self.activityTimer then
       self.activityTimer:Stop()
       self.activityTimer = nil 
    end
end

function BattlePassTaskPanel:SetActivityTimer()
    local subTime = self.endTime - _G.TimeUtil.GetServerUnixTime()
    if subTime > 0 then
        local _t = _G.TimeUtil.TranslateSecond(subTime)
        local day = _t.day
        local timeStr = string.format("%02d:%02d:%02d", _t.hour, _t.min, _t.sec)
        self.go_table.aortext_countDown.text = _G.GetLangPackValue(90029300004, _G.GetLangPackValue(90025500011, day, timeStr))
    else
        self:StopTimer()
    end
end

function BattlePassTaskPanel:InitView()
    self.taskDatas = self.activityCls:GetAllTaskDatas()
    self:SortTask()
    if not self.groupListView then
        self.go_table.scrollloopvectical_Group:InitItemData(#self.taskDatas, _G.handler(self, self.RefreshTaskItem))
        self.groupListView = self.go_table.scrollloopvectical_Group
    else
        self.groupListView:UpdateCount(#self.taskDatas)
    end
end

function BattlePassTaskPanel:InitPrecast()
    local data = self.activityCls:GetPrecastData()
    if data[1] then
        self.go_table.aortext_des1.text = _G.GetLangPackValue(data[1])
    end
    if data[2] then
        self.go_table.aortext_des2.text = _G.GetLangPackValue(data[2])
    end
    if data[3] then
        self.go_table.aortext_des3.text = _G.GetLangPackValue(data[3])
    end
    if data[4] then
        self.go_table.aorrawimage_topBg:LoadImage(data[4])
    end
end

function BattlePassTaskPanel:RefreshTaskItem(index, obj)
    local task = self.taskDatas[index + 1]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickTask, task))
    local curNum = task.i_task.target[1]
    tb.slider_progress.value = curNum / task.Cfg.count
    tb.aortext_Slider.text = curNum .. "/" .. task.Cfg.count
    local isGet
    if task.i_task.state == _G.TaskEnum.ETaskState.Submited then
        tb.aortext_name.text = task.Cfg.desc .. _G.string.format("(%s/%s)", task.Cfg.count, task.Cfg.count)
        isGet = self.activityCls:CheckIsGet(task.i_task.sid)
        tb.aorbtn_unGet:SetActiveE(0)
        tb.aorbtn_get:SetActiveE(isGet and 0 or 1)
        tb.obj_complete:SetActiveE(isGet and 1 or 0)
    else
        tb.aortext_name.text = task.Cfg.desc .. _G.string.format("(%s/%s)", task.i_task.target[1], task.Cfg.count)
        tb.aorbtn_unGet:SetActiveE(1)
        tb.aorbtn_get:SetActiveE(0)
        tb.obj_complete:SetActiveE(0)
    end
    tb.obj_items:ClearChildren()
    tb.aortext_labelNum.text = task.Cfg.other_award[1].num
    for i, v in ipairs(task.Cfg.reward) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            task.Cfg.reward[i].type,
            tb.obj_items,
            function(tran)
                tran.gameObject:SetLocalScaleXYZ(0.8)
                if task.Cfg.reward[i].type[2] > 1 then
                    tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                else
                    tran:ShowNumText(false)
                end
                tran:SetGou(self.activityCls:CheckIsGet(task.Cfg.id))
                if tran.ShowEffectOrder and tran.cfg then
                    tran:ShowEffectOrder(tran.cfg.ef_item == 1 and true or false)
                end
            end
        )
    end
end

function BattlePassTaskPanel:SortTask()
    ---@param data DrawUpBattlePassTaskData
    _G.SortList(
        self.taskDatas,
        function(data)
            local index = 1
            if data.i_task.state == _G.TaskEnum.ETaskState.Submited then
                index = 2
                if self.activityCls:CheckIsGet(data.i_task.sid) then
                    index = -1
                end
            end
            return index, -data.i_task.sid
        end
    )
end

---点击任务
function BattlePassTaskPanel:OnClickTask(go, isOn, task)
    local name = go:GetName()
    if name == "@_aorbtn_get" then
        local ids = {}
        for _, data in pairs(self.taskDatas) do
            if data.i_task.state == _G.TaskEnum.ETaskState.Submited and
                not self.activityCls:CheckIsGet(data.Cfg.id) then
                table.insert(ids, data.i_task.sid)
            end
        end
        self.activityCls:GetAward(ids, function()
            self:InitView()
        end)
    elseif name == "@_aorbtn_unGet" then
        _G.JumpManager:GetInstance():Jump(task.Cfg.link, nil)
    end
end

function BattlePassTaskPanel:OnClickBtn(go, isOn)
end

---销毁对象时,析构函数
function BattlePassTaskPanel:Dispose()
    self:StopTimer()
end

return BattlePassTaskPanel
