---@class DrawUpBattlePassView_AddExp	中文描述
local DrawUpBattlePassView_AddExp = _G.BaseClass("DrawUpBattlePassView_AddExp")

--local CS = _G.CS
--local typeof = _G.typeof

---类的构造函数
---@param mParentView DrawUpBattlePassView
function DrawUpBattlePassView_AddExp:__init(obj, mParentView)
    self.gameObject = obj
    self.mParentView = mParentView
    self.GetJumpType =
        require "ActivitySynManager":GetInstance():GetChildAcitivity(
            mParentView.activity:GetJumpModelType(),
            mParentView.activity.curActivityClass:GetJumpType()
        )
    self.ActivityID = self.GetJumpType.activityID
    local parameters = self.mParentView.activity:Getex_change(self.ActivityID)
    --- 2 (105102 2#1 赛季战令经验购买（魂玉#赛季战令经验）)
    self.moneyRate = parameters[1] / parameters[2]

    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    ---中间 所有item
    self.go_table.scrollloophorizontal_item:InitItemData(0, _G.handler(self, self.RefreshList))
    self.ItemDataType = {
        ---物品数据 所属类型
        PropData = 1,
        EquipmentItem = 2,
        DecorationData = 3,
        Card = 4
    }
    self.ItemDataTypeDic = {
        ---判断物品数据 所属类型
        ["PropData"] = self.ItemDataType.PropData,
        ["EquipmentItem"] = self.ItemDataType.EquipmentItem,
        ["DecorationData"] = self.ItemDataType.DecorationData,
        ["CardData"] = self.ItemDataType.Card
    }
    --self.itemLua = {}
end

function DrawUpBattlePassView_AddExp:Show(lv, max, exp)
    self.lv = lv
    self.max = max
    self.lvCount = 1
    self.exp = exp
    self:ShowLvNum(self.lvCount)

    _G.GameUtil.SetActiveByCondition(self.gameObject, true)
end

function DrawUpBattlePassView_AddExp:Hide()
    _G.GameUtil.SetActiveByCondition(self.gameObject, false)
end

function DrawUpBattlePassView_AddExp:SumMoney()
    local itemDic = {}

    local sumLv = self.lv + self.lvCount
    local countCfgArr = self.mParentView.countCfgArr

    local sum = 0
    local exp, info, sid, num
    for i = self.lv + 1, sumLv do
        info = countCfgArr[i]
        exp = info.conditions[1]
        sum = sum + exp

        for j = 1, #info.rewards_normal do
            sid = info.rewards_normal[j][1]
            num = info.rewards_normal[j][2]
            if itemDic[sid] == nil then
                itemDic[sid] = 0
            end
            itemDic[sid] = itemDic[sid] + num
        end
        if self.mParentView.isUp then
            for j = 1, #info.rewards_pay do
                sid = info.rewards_pay[j][1]
                num = info.rewards_pay[j][2]
                if itemDic[sid] == nil then
                    itemDic[sid] = 0
                end
                itemDic[sid] = itemDic[sid] + num
            end
        end
    end
    sum = _G.GameUtil.FormatNum(sum)
    if sumLv == self.max then
        sum = sum - self.exp
    end
    self.sumExp = sum
    self.Money = _G.math.ceil(sum * self.moneyRate)
    self.go_table.aortext_count.text = self.Money

    self.ItemDataAllList = {}

    for _sid, _num in pairs(itemDic) do
        table.insert(self.ItemDataAllList, _G.StorageManager:GetInstance():GetItemDataClass(_sid, _num))
    end
    self:ShowItem()
end

function DrawUpBattlePassView_AddExp:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self:Hide()
    elseif go == self.go_table.aorbtn_add then
        self:OnClick_Add()
    elseif go == self.go_table.aorbtn_sub then
        self:OnClick_Sub()
    elseif go == self.go_table.aorbtn_max then
        self:OnClick_Max()
    elseif go == self.go_table.aorbtn_Done then
        self:OnClick_BuyExp()
    end
end

--region --------------------------------------lvCount--------

function DrawUpBattlePassView_AddExp:ShowLvNum()
    self.go_table.aortext_num.text = self.lvCount
    self.go_table.aortext_lv1.text = self.lv
    self.go_table.aortext_lv2.text = self.lv + self.lvCount
    self:SumMoney()
end

function DrawUpBattlePassView_AddExp:OnClick_Add()
    local sub = self.max - self.lv
    if self.lvCount == sub then
        return
    end
    self.lvCount = self.lvCount + 1
    self:ShowLvNum()
end

function DrawUpBattlePassView_AddExp:OnClick_Sub()
    if self.lvCount == 1 then
        return
    end
    self.lvCount = self.lvCount - 1
    self:ShowLvNum()
end

function DrawUpBattlePassView_AddExp:OnClick_Max()
    local sub = self.max - self.lv
    if self.lvCount == sub then
        return
    end
    self.lvCount = sub
    self:ShowLvNum()
end

--endregion------------------------------------lvCount--------

--region --------------------------------------Item--------

function DrawUpBattlePassView_AddExp:ShowItem()
    local nowCount = #self.ItemDataAllList
    if nowCount > 0 then
        local weight = 80 * nowCount + 15.5 * (nowCount - 1)
        self.go_table.scrollloophorizontal_item:SetRectTransformSize(_G.Mathf.Min(weight, 745), 105.52)
    end
    if self.OldCount ~= nowCount then
        self.go_table.scrollloophorizontal_item:UpdateCount(nowCount)
        self.OldCount = nowCount
    else
        self.go_table.scrollloophorizontal_item:UpdateAllItem()
    end
end

function DrawUpBattlePassView_AddExp:RefreshList(index, objGame)
    index = index + 1
    local itemData = self.ItemDataAllList[index]
    local itemGoTable = _G.GetAutoGoTable(objGame)
    itemGoTable.itemData = itemData
    itemGoTable.DataIndex = index
    --if not self.itemLua[index] then
    --    self.itemLua[index]  = require "BaseAwardNewItem".New(itemGoTable.obj_item, nil, 100, itemGoTable.obj_item)
    --end
    itemGoTable.obj_item:ClearChildren()
    local item = require "BaseAwardNewItem".New(itemGoTable.obj_item, nil, 100, itemGoTable.obj_item)
    local data = { itemData.sid, itemData.count }
    --self.itemLua[index]:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))
    item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))
    return objGame
end

function DrawUpBattlePassView_AddExp:GetItemDataType(itemData)
    if itemData == nil then
        return 0
    end
    return self.ItemDataTypeDic[itemData.__cname] or 0
end

--endregion------------------------------------Item--------

function DrawUpBattlePassView_AddExp:OnClick_BuyExp()
    if _G.StorageManager:GetInstance():CheckItem(_G.ResPropID.Diamond, self.Money) == false then
        _G.PopWindowManager:GetInstance():ShowAllTips(230303)
        return
    end
    self.mParentView.activity:GetBuyExp(
        self.ActivityID,
        self.sumExp,
        self.Money,
        function(data)
            if self.mParentView then
                self.mParentView:UpdateView()
            end
        end
    )
end

---类的析构函数
function DrawUpBattlePassView_AddExp:Dispose()
end

return DrawUpBattlePassView_AddExp
