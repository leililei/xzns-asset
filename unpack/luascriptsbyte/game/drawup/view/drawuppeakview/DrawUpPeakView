function DrawUpPeakView:CalculatePowerIncrease()
    local power = DrawUpMainModel:GetInstance():GetI_buff_info(self.ActivityID)

    local num = 0
    for i = 1, 2 do
        local data = power[i]
        if data == nil then
            self.go_table["obj_text" .. i]:SetActiveE(0)
        else
            local str  = "<color=#ff5555>" .. _G.LangUtil.GetLangPackValue(90023300110) .. "</color>"
            local str1 = DrawUpMainModel:GetInstance():QueryProgress(self.ActivityID, data.type, data.aim)
            --self.go_table["aorimage_mask" .. i]:SetActiveE(1)
            if str1 == 1 then
                str = "<color=#5bdf99>" .. _G.LangUtil.GetLangPackValue(90022500355) .. "</color>"
                --self.go_table["aorimage_mask" .. i]:SetActiveE(0)
                num = num + data.addition
            end
            self.go_table["obj_text" .. i]:SetActiveE(1)
            self.go_table["aortext_text" .. i].text = i.."."..data.describe .. data.addition .. "%(" .. str .. ")"
            local star = require "IllustrationModel":GetInstance():GetCardMaxStar(DrawUpMainModel:GetInstance()
                :GetCard_sid(self.ActivityID))
            if star == 0 then
                star = 4
            end

            --_G.ItemCardFactory:GetInstance():GetItemCard(
            --    _G.ItemCardFactory.itemCardType.baseItem,
            --    self.go_table["obj_raw" .. i],
            --    function(item)
            --        item:Show(DrawUpMainModel:GetInstance()
            --            :GetCard_sid(self.ActivityID), nil,
            --            star)
            --    end
            --)
        end
    end
    if num > 0 then
        self.go_table.aorimage_xiao:SetActiveE(1)
        self.go_table.aortext_Jia.text = _G.LangUtil.GetLangPackValue(90029300024, num)
    else
        self.go_table.aorimage_xiao:SetActiveE(0)
    end
end

---奖励列表刷新
function DrawUpPeakView:RefreshCurList(index, obj)
    index = index + 1
    local instanceID = obj:GetInstanceIDE()
    local item = self.itemList[instanceID]
    if not item then
        item = require "BaseAwardNewItem".New(obj, nil, 73, obj)
        self.itemList[instanceID] = item
    end
    item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(self.dataList[index]))
end

function DrawUpPeakView:RefreshSkills()
    self.preview_skill = DrawUpMainModel:GetInstance():Getboss_combine(self.ActivityID)
    -- if _G.ConfigManager.monster_group_cfg[skill] == nil then
    --     return
    -- end
    -- local DefaultDefenserSids = _G.ConfigManager.monster_group_cfg[skill].DefaultDefenserSids[1]

    -- local skin = 0
    -- for key, value in pairs(DefaultDefenserSids) do
    --     if value ~= 0 then
    --         skin = _G.ConfigManager.monster_cfg[value].Skill_id
    --     end
