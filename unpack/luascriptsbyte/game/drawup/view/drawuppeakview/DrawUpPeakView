function DrawUpPeakView:OnClickSkill(_, _, item)
    require "CommonTipManager":GetInstance():OpenSkillTip(item.cfg.id)
end

function DrawUpPeakView:Support()
    local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DrawUpBossRankView.Name)
    if ctrl then
        _G.UIManager:GetInstance():CloseWindow(
            _G.ConfigManager.ui_cfg.DrawUpBossRankView.Name
        )
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.DrawUpBossRankView.Name,
            self.ActivityID,
            self.reward_season,
            self.resourcesId
        )
    end
end

function DrawUpPeakView:OnClickBtn(go, _)
    local name = go:GetName()
    if name == "@_aorbtn_close" then
        self:Close()
    elseif name == "@_aorbtn_support" then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.DrawUpBossRankView.Name,
            self.ActivityID,
            self.reward_season,
            self.resourcesId
        )
        -- local data = DrawUpMainModel:GetInstance():Getbuff(self.ActivityID)
    elseif name == "@_aorbtn_shop" then
        local data = DrawUpMainModel:GetInstance():Getbuff(self.ActivityID)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DrawUpPeakGetRelicView.Name, data)
    elseif name == "@_aorbtn_task" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DrawUpPeakTaskView.Name, self.ActivityID)
    elseif name == "@_aorbtn_fight" then
        -- if self:InitTime() then
        --     _G.PopWindowManager:GetInstance():ShowAllTips(910101)

        --     return
        -- end

        --是否满足跳过战斗开启条件
        local showSkipBattle = self:IsShowSkipBattle()

        require "DrawUpMainModel":GetInstance():OnFightBoss(
            self.ActivityID,
            _G.handler(self, self.ExitEmbattle),
            _G.handler(self, self.HideWindow),
            showSkipBattle
        )
    elseif name == "@_aorbtn_help" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 79)
    end
end

---刷新跳过战斗状态
---@return void
function DrawUpPeakView:RefreshSkipBattleState()
    --读取解锁配置并显示文本
    local params = _G.ConfigManager.discrete_cfg[115606]
    if not params then
        self.go_table.obj_skipBg:SetActiveE(0)
        return
    end
    local ok, content = _G.GlobalConditionManager.CheckConditionArraysCustomUnlockTip(params)
    if ok then
        self.go_table.obj_skipBg:SetActiveE(0)
        return
    end
    if content then
        self.go_table.aortext_skipTip.text = content
    end
    self.go_table.obj_skipBg:SetActiveE(content and 1 or 0)
end
---是否显示跳过战斗按钮
---@return boolean
function DrawUpPeakView:IsShowSkipBattle()
    local params = _G.ConfigManager.discrete_cfg[115606]
    if not params then
        return false
    end
    local ok = _G.GlobalConditionManager.CheckConditionArrays(params)
    return ok
end

function DrawUpPeakView:HideWindow()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.DrawUpMainView.Name)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.DrawUpPeakView.Name)
end

---红点刷新
function DrawUpPeakView:HongDian()
    --任务红点
    local num = DrawUpMainModel:GetInstance():TaskInfoId(self.ActivityID)
    if #num >= 1 then
        self.go_table.obj_redpointTask:SetActiveE(1)
    else
        self.go_table.obj_redpointTask:SetActiveE(0)
    end

    --战斗红点
    if
        self.activityTypeCls and self.activityTypeCls.IsMarkPeakViewRedPoint and
            not self.activityTypeCls:IsMarkPeakViewRedPoint()
     then
        self.go_table.obj_redpointFight:SetActiveE(1)
    else
        self.go_table.obj_redpointFight:SetActiveE(0)
    end
end

---初始化时间
function DrawUpPeakView:InitTime()
    local time = _G.TimeUtil.GetSecondsOfDayOf6Hour()
    if time < 0 and time + 3600 > 0 then
        return true
    end
    return false
end

---退出战斗
function DrawUpPeakView:ExitEmbattle()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.DrawUpMainView.Name)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.DrawUpPeakView.Name)
    --  _G.Events:GetInstance():Broadcast("WorldBossUpdate")
end

function DrawUpPeakView:OnDestroy()
    if self.timeShengYus then
        self.timeShengYus:Stop()
    end
    if self.tweer then
        self.tweer:Kill()
        self.tweer = nil
    end
    if self.refreshViewTimer then
        self.refreshViewTimer:Stop()
        self.refreshViewTimer = nil
    end
end

return DrawUpPeakView
