local DrawUpPeakView = _G.BaseClass("DrawUpPeakView", _G.UIBaseView)

--- 构造函数
function DrawUpPeakView:ctor()
    self.itemList = nil
    self.dataList = nil
    self.ActivityID = nil
    self.resourcesId = nil
    self.preview_skill = nil
    self.reward_season = nil
    self.Skills = nil
    self.timeShengYus = nil
end

function DrawUpPeakView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    --添加倒计时定时器(跳过战斗解锁可配置时间)
    if not self:IsShowSkipBattle() then
        self.refreshViewTimer =
            _G.TimerManager:GetInstance():GetTimer(1, self.RefreshSkipBattleState, self, false, true)
        self.refreshViewTimer:Start()
    end
end

---界面的入口函数
function DrawUpPeakView:OnCreate(activity, _)
    self.itemList = {}
    self.GetJumpType =
        require "ActivitySynManager":GetInstance():GetChildAcitivity(10028, activity.curActivityClass:GetJumpType())
    self.ActivityID = self.GetJumpType.activityID
    --self.TypeID = TypeID
    self.resourcesId = DrawUpCoinModel:GetInstance():GetCoinId(self.ActivityID)
    ---判断物品是否存在并且是可见状态（显示各种货币）
    if not _G.IsNil(self.go_table.obj_GoldInfo) and self.go_table.obj_GoldInfo:GetctiveInHierarchy() == 1 then
        ---添加要显示的货币或者资源
        local resources = _G.ConfigManager.ui_cfg.DrawUpPeakView.resources
        local newResource = {}
        for i = 1, #resources do
            if resources[i] == self.resourcesId then
                newResource[i] = self.resourcesId
            else
                newResource[i] = resources[i]
            end
        end
        if #newResource > 0 then
            self:AddComponent(
                self.go_table.obj_GoldInfo,
                require("ResourceCompont").New(self.go_table.obj_GoldInfo, newResource)
            )
        end
    end
    --self.go_table.scrollloopvectical_curAward:InitItemData(0, _G.handler(self, self.RefreshCurList))
    self.rankPanel =
        self:AddComponent(
            self.go_table.obj_littleZonePanel,
            require "LittleZoneRankView".New(
                _G.ZoneRankType.DrawUpPeak,
                self.ActivityID,
                nil,
                _G.handlerbind(self, self.ReshCurList),
                true
            )
        )
     if self.rankPanel then
         self.rankPanel:RefreshRank()
     end
    self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))
    self:ReshCurBg()
    self:RefreshSkills()
    self:CalculatePowerIncrease()
    self:RefreshSkipBattleState()

    -- 修改为战斗后标记
    -- if activity.MarkPeakViewRedPoint then
    --     activity:MarkPeakViewRedPoint()
    -- elseif _G.AppSetting.DEBUG then
    --     _G.LogError("试炼红点标记方法不存在")
    -- end

    local activityClass =
        require "ActivitySynManager":GetInstance():GetChildAcitivity(10030, activity.curActivityClass:GetJumpType())
    self.activityTypeCls = activityClass:GetActivityTypeCls()

    self:HongDian()
end

---BG刷新
function DrawUpPeakView:ReshCurBg()
    local image = DrawUpMainModel:GetInstance():GetBoss_info(self.ActivityID)
    if image ~= nil and image ~= "test" then
        local pos = {}

        local dev = _G.string.split(image, "|")
        local e = _G.tonumber(dev[4]) or 1
        for k, v in pairs(dev) do
            if k == 1 then
                self.go_table.aorrawimage_bg:SetActiveE(0)
                self.go_table.obj_Bg:SetActiveE(0)
                if e == 1 then
                    self.go_table.aorrawimage_bg:SetActiveE(1)
                    --立绘图片更新
                    self.go_table.aorrawimage_bg:LoadImage(
                        v,
                        function(image)
                            if image ~= nil then
                                image:SetActiveE(1)
                                image:SetNativeSize()
                            end
                        end
                    )
                    self:PlayRoleAni()
                elseif e == 2 then
                    self.go_table.obj_Bg:SetActiveE(1)
                    _G.PoolsManager:GetInstance():Spawn(
                        v,
                        _G.ePoolType.UIItem,
                        self.go_table.obj_Bg,
                        function(tran)
                            if self:IsNil() then
                                tran:DestroyObject()
                                return
                            end
                        end
                    )
                end
                ---立绘图片更新
                -- self.go_table.obj_Bg:LoadImage(
                --     v,
                --     function(image)
                --         if image ~= nil then
                --             image:SetActiveE(1)
                --             image:SetNativeSize()
                --         end
                --     end
                -- )
            elseif k == 2 then
                _G.table.insert(pos, _G.tonumber(_G.string.split(v, "#")[1]))
                _G.table.insert(pos, _G.tonumber(_G.string.split(v, "#")[2]))
                _G.table.insert(pos, _G.tonumber(_G.string.split(v, "#")[3]))
                if e == 1 then
                    self.go_table.aorrawimage_bg:SetLocalPosition(pos[1], pos[2], pos[3])
                elseif e == 2 then
                    self.go_table.obj_Bg:SetLocalPosition(pos[1], pos[2], pos[3])
                end
            elseif k == 3 then
                if e == 1 then
                    self.go_table.aorrawimage_bg:SetLocalScaleXYZ(_G.tonumber(v))
                elseif e == 2 then
                    self.go_table.obj_Bg:SetLocalScaleXYZ(_G.tonumber(v))
                end
                --_G.table.insert(pos, _G.tonumber(v))
            end
        end
    else
        self.go_table.obj_Bg:SetActiveE(0)
    end
end

function DrawUpPeakView:PlayRoleAni()
    local Tweening = _G.CS.DG.Tweening
    local x, y, z = self.go_table.aorrawimage_bg:GetLocalPosition()
    self.tweer =
        self.go_table.aorrawimage_bg:DOLocalMoveY(y - 3, 1.5):SetEase(Tweening.Ease.InOutSine):SetLoops(
            -1,
            Tweening.LoopType.Yoyo
        )
end

