local DrawUpMainModel = require("DrawUpMainModel")
---@class DrawUpMainSelectView : UIBaseView	限时招募心愿角色选择界面
---@field public go_table DrawUpMainSelectView_GoTable GoTable
---@field DrawUpMainModel DrawUpMainModel
local DrawUpMainSelectView = _G.BaseClass("DrawUpMainSelectView", _G.UIBaseView)

local table = _G.table
--1-坦克；2-战士；3-法师；4-辅助；5-游侠
local IconType = _G.ProfessionalIcon

local ProDic = {
    [1] = "ui_zy_tanke_icom",
    [2] = "ui_zy_zhanshi_icom",
    [3] = "ui_zy_fashi_icom",
    [4] = "ui_zy_fuzhu_icom",
    [5] = "ui_zy_youxia_icom"
}

function DrawUpMainSelectView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param activityID number 活动id
---@param callback function 回调函数
function DrawUpMainSelectView:OnCreate(activityID, callback, spBol)
    self.callback = callback
    self.activityID = activityID
    self.spBol = spBol
    ---当前选中的卡牌sid
    self.cardId = DrawUpMainModel:GetInstance():GetItemId(activityID)
    ---在选择解决新选中的卡牌sid
    self.selectCardId = self.cardId ~= 0 and self.cardId or DrawUpMainModel:GetInstance():Getlimited_itemId(activityID)[1][1]
    ---缓存所有的卡牌数据
    self.CardData = {}
    ---当前选中五行属性(0是全部)
    self.curElement = 0
    self.itemList = {}
    self:InitSelectData()
    self:PlayAni()
end

---初始化可选择数据
function DrawUpMainSelectView:InitSelectData()
    local limitedId = DrawUpMainModel:GetInstance():Getlimited_itemId(self.activityID)
    local StorageManager = _G.StorageManager:GetInstance()
    local cardData = {}
    for _, v in ipairs(limitedId) do
        if v[3] > 0 then
            local data = StorageManager:GetMaxStarCardBySid(v[1])
            if not data then
                data = StorageManager:GetItemDataClass(v[1], 1)
            end
            table.insert(cardData, data)
        end
    end
    local max = _G.ConfigManager.discrete_cfg[103704][1][1]
    _G.SortList(
        cardData,
        function(a)
            local god = a:GetElement() == _G.CardElementType.God and 1 or 0
            local isCur = a.sid == self.selectCardId and 1 or 0
            local haveCard = a.sid ~= a.uid and 1 or 0
            local isMax = a.star < max and 1 or 0
            return isCur, isMax, god, haveCard, a.sid
        end
    )
    self.CardData[0] = cardData
    self.curCardData = cardData
    if self.selectCardId and self.selectCardId > 0 then
        self:UpdateCardShow(self.curCardData[1])
    end
    self.go_table.scrollloopvectical_CardList:InitItemData(
        #self.CardData[self.curElement],
        _G.handler(self, self.RefreshList)
    )
end

---更新卡牌显示
---@param data CardData 卡牌数据
function DrawUpMainSelectView:UpdateCardShow(data)
    local path = data.cfg.ModelPathHi
    local pos = data.cfg.pos_portrait
    local scale = data.cfg.size2

    if _G.AppSetting.IsXzns then
        if self.cardItem then
            self.cardItem:Show(data)
        else
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.baseBodyItem,
                self.go_table.obj_Root,
                function(trans)
                    if not self.go_table or self.cardItem then
                        _G.DestroyImmediate(trans)
                        return
                    end
                    self.cardItem = trans
                    trans:Show(data)
                    trans.go_table.obj_lvNode:SetActiveE(0)
                end
            )
        end
    else
        self.go_table.aorimage_Professisonal.SpriteName = IconType[data.cfg.Professional]
        self.go_table.aorimage_ProfessisonalSP.SpriteName = IconType[data.cfg.Professional]
        self.go_table.trans_CardSpine:ClearChildren()
        local x, y, z = self.go_table.trans_CardSpine:GetLocalPosition()
        _G.PoolsManager:GetInstance():Spawn(
                path,
                _G.ePoolType.Temporary,
                self.go_table.trans_CardSpine,
                function(trans)
                    if self:IsNil() then
                        _G.DestroyObject(trans)
                    end
                    trans:SetLocalPosition(x + pos[1], y + pos[2], z + pos[3])
                    trans:SetLocalScale(scale, scale, scale)
                end
        )

        local num = DrawUpMainModel:GetInstance():GetLeftGuaranteed(self.activityID) or 0
        self.go_table.aortext_num.text = num
        self.go_table.aortext_name2.text = _G.LangUtil.GetLangPackValue(data.cfg.Name)
        self.go_table.aortext_numSP.text = num
        self.go_table.aortext_name2SP.text = _G.LangUtil.GetLangPackValue(data.cfg.Name)
        -- self.go_table.aorimage_Element.SpriteName = ProDic[data.cfg.Professional]
        self.go_table.aorrawimage_bg:SetActiveE(self.spBol and 0 or 1)
        self.go_table.aorrawimage_bgSP:SetActiveE(self.spBol and 1 or 0)
        if self.spBol then 
            self.go_table.aorimage_Orderzi:ClearChildren()
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_ItemCardBodyBaseViewSP_bg,
                self.go_table.aorimage_Orderzi,
                function(trans)
                    trans:SetLocalScaleXYZ(1)
                end
            )
        end
    end
end

---设置成功回调
function DrawUpMainSelectView:OnSetWishSucessCall()
    if self.callback then
        self.callback(self.selectCardId)
    end
end

---刷新卡牌显示
function DrawUpMainSelectView:RefreshList(index, obj)
    local instanceID = obj:GetInstanceIDE()
    local tb = self.itemList[instanceID]
    local data = self.curCardData[index + 1]
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickItem, tb))
        tb.item = require "ItemCardAllView".New(tb.obj_node:GetChildE(0))
        self.itemList[instanceID] = tb
        tb.aorbtn_click.LongPress = true
        tb.aorbtn_click.onLongPress = _G.handlerbind(self, self.OnLongPress, tb)
    end
    tb.item:ShowCardData(data, nil, false)
    tb.index = index + 1
    _G.GameUtil.SetActiveByCondition(tb.obj_gou, data.sid == self.selectCardId)
    tb.aorimage_Icon.SpriteName = IconType[data.cfg.Professional]
    tb.aortext_tip.text = _G.ConfigManager.language_package_cfg[data.cfg.recommend_doc[1]]
end

function DrawUpMainSelectView:OnClickItem(go, isOn, tb)
    local data = self.curCardData[tb.index]
    self.selectCardId = data.sid
    local pan = false
    if tb.obj_gou:GetActiveSelf() == 1 then 
        return 
    end
    if self.selectCardId then
        local id = _G.tonumber(data.sid)
        pan = _G.StorageManager:GetInstance():GetIDMax(id, id)
    end
    if pan then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            622,
            nil,
            function()
                self.go_table.scrollloopvectical_CardList:UpdateAllItem()
                self:UpdateCardShow(data)
            end
        )
    else
        self.go_table.scrollloopvectical_CardList:UpdateAllItem()
        self:UpdateCardShow(data)
    end
end

---Toggle点击事件
function DrawUpMainSelectView:OnToggle(go, isOn)
    local name = go:GetName()
    if not _G.string.contains(name, "toggle") then
        return
    end
    local str = _G.string.replace(name, "$_toggle_", "")
    local element = _G.tonumber(str)
    if element == 5 then
        element = 6
    end
    if not self.CardData[element] then
        local tb = {}
        for _, v in pairs(self.CardData[0]) do
            if require "CardInfoManager":GetInstance():CheckMultiMatchCOP(v.cfg.Elements_new, element) then
                _G.table.insert(tb, v)
            end
        end
        self.CardData[element] = tb
    end
    self.curElement = element
    self.curCardData = self.CardData[element]
    self.go_table.scrollloopvectical_CardList:UpdateCount(#self.curCardData)
end

---界面的销毁函数
function DrawUpMainSelectView:OnDestroy()
    self.callback = nil
    if self.tweer then
        self.tweer:Kill()
        self.tweer = nil
    end
end

---按钮点击事件在这里派发
function DrawUpMainSelectView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_closeView then
        self:Close()
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_enter then
        DrawUpMainModel:GetInstance():SetWishCard(
                self.activityID,
                self.selectCardId,
                function()
                    self:OnSetWishSucessCall()
                    self:Close()
                end
        )
    elseif go == self.go_table.aorbtn_detail then
        require("CommonTipManager"):GetInstance():OpenCardTip(self.selectCardId, self.selectCardId)
    else
        self:OnToggle(go, isOn)
    end
end

---播放动画
function DrawUpMainSelectView:PlayAni()
    local Tweening = _G.CS.DG.Tweening
    self.tweer =
        self.go_table.obj_ring2:DOLocalMoveY(34, 1):SetEase(Tweening.Ease.InOutSine):SetLoops(
        -1,
        Tweening.LoopType.Yoyo
    )
end

return DrawUpMainSelectView