---@class DrawUpBattlePassTaskView : UIBaseView	中文描述
---@field public go_table DrawUpBattlePassTaskView_GoTable GoTable
---@field activity ActivitySynBase
---@field activityCls DrawUpBattlePassTaskModel
---@field otherActivityCls DrawUpBattlePassModel
local DrawUpBattlePassTaskView = _G.BaseClass("DrawUpBattlePassTaskView", _G.UIBaseView)
--_G.DrawUpBattlePassTaskView = DrawUpBattlePassTaskView

function DrawUpBattlePassTaskView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eDrawUpBattlePass.DrawUpBattlePassRefeshTask, self.RefreshTask)
end

---界面的入口函数
function DrawUpBattlePassTaskView:OnCreate(activity)
    self.activity = activity
    self.activityCls = self.activity:GetActivityTypeCls()
    self.GetJumpType = require "ActivitySynManager":GetInstance():GetChildAcitivity(self.activityCls:GetJumpModelType(), self.activity:GetJumpType())
    self.ActivityID = self.GetJumpType.activityID
    self.otherActivityCls =
        require "ActivitySynManager":GetInstance():GetChildAcitivity(10027, self.activity:GetJumpType())
        :GetActivityTypeCls(

        )
    self.isInited = false
    self:UpdateView()
    self.isInited = true
end

---更新界面
function DrawUpBattlePassTaskView:UpdateView()
    self:RefreshTask()
    self:RefreshExp()
    local getTaskList = self.activityCls:GetCankTaskList()
    self.go_table.aorbtn_getAll:SetActiveE(#getTaskList >= 2 and 1 or 0)
end

---任务刷新
function DrawUpBattlePassTaskView:RefreshTask()
    self.taskDatas = self.activityCls:GetAllTaskDatas()
    self:SortTask()
    if not self.isInited then
        self.go_table.scrollloopvectical_Group:InitItemData(#self.taskDatas, _G.handler(self, self.RefreshTaskItem))
    else
        self.go_table.scrollloopvectical_Group:UpdateCount(#self.taskDatas)
    end
end

function DrawUpBattlePassTaskView:RefreshTaskItem(index, obj)
    ---@type DrawUpBattlePassTaskView._obj_item_GoTable
    local go_table = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickTask, index + 1))
    go_table.obj_items:ClearChildren()
    local data = self.taskDatas[index + 1]
    --go_table.aortext_hzExp.text = data.Cfg.other_award[1].num
    if data.i_task.state == _G.TaskEnum.ETaskState.Submited then
        --self:SetTaskItemjd(go_table.aorimage_jd, data.Cfg.count, data.Cfg.count)
        --go_table.aortext_jd.text = _G.string.format("(%s/%s)", data.Cfg.count, data.Cfg.count)
        go_table.aortext_info.text = data.Cfg.desc .. _G.string.format("(%s/%s)", data.Cfg.count, data.Cfg.count)
        local isGet = self.activityCls:CheckIsGet(data.Cfg.id)
        go_table.aorbtn_get:SetActiveE(isGet and 0 or 1)
        go_table.aorbtn_way:SetActiveE(0)
        go_table.aorimage_get:SetActiveE(1)
        go_table.aorimage_over:SetActiveE(isGet and 1 or 0)
    else
        --self:SetTaskItemjd(go_table.aorimage_jd, data.i_task.target[1], data.Cfg.count)
        --go_table.aortext_jd.text = _G.string.format("(%s/%s)", data.i_task.target[1], data.Cfg.count)
        go_table.aortext_info.text = data.Cfg.desc .. _G.string.format("(%s/%s)", data.i_task.target[1], data.Cfg.count)
        go_table.aorbtn_get:SetActiveE(0)
        go_table.aorimage_get:SetActiveE(1)
        go_table.aorbtn_way:SetActiveE(1)
        --if data.Cfg.link and data.Cfg.link ~= 0 then
        if data.Cfg.link and data.Cfg.link ~= 0 then
            go_table.aorbtn_way:SetGray(false)
            go_table.aortext_label.text = _G.LangUtil.GetLangPackValue(90022200010)
            go_table.aorbtn_way.interactable = true
        else
            go_table.aorbtn_way:SetGray(true)
            go_table.aortext_label.text = _G.LangUtil.GetLangPackValue(90020400086)
            go_table.aorbtn_way.interactable = false
        end
        go_table.aorimage_over:SetActiveE(0)
    end

    for i = 1, #data.Cfg.reward do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            data.Cfg.reward[i].type,
            go_table.obj_items,
            function(tran)
                tran.gameObject:SetLocalScaleXYZ(0.8)
                if data.Cfg.reward[i].type[2] > 1 then
                    tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                else
                    tran:ShowNumText(false)
                end
                tran:SetGou(self.activityCls:CheckIsGet(data.Cfg.id))
                if tran.ShowEffectOrder and tran.cfg then
                    tran:ShowEffectOrder(tran.cfg.ef_item == 1 and true or false)
                end
            end
        )
    end
end

---设置任务进度
function DrawUpBattlePassTaskView:SetTaskItemjd(aorimage, value, loopValue_Max)
    local w = value / loopValue_Max
    if w > 1 then
        w = 1
    end
    aorimage:SetRectTransformSize(value > 0 and w * (186) or 0, 14)
end

---点击任务
function DrawUpBattlePassTaskView:OnClickTask(go, isOn, index)
    local name = go:GetName()
    local data = self.taskDatas[index]
    if name == "@_aorbtn_get" then
        local ids = {}
        for _, data in pairs(self.taskDatas) do
            if data.i_task.state == _G.TaskEnum.ETaskState.Submited and
                not self.activityCls:CheckIsGet(data.Cfg.id) then
                table.insert(ids, data.i_task.sid)
            end
        end
        self.activityCls:GetAward(ids, function()
            self:UpdateView()
        end)
    elseif name == "@_aorbtn_way" then
        ---策划需求（跳转到对应的界面（专门针对跳当前页面设置（黄东要求，紫薯提议！）
        -- if 162001 == data.Cfg.link then
        --     self:Close()
        --     return
        -- end

        _G.JumpManager:GetInstance():Jump(data.Cfg.link, nil)
    end
end

---经验刷新
function DrawUpBattlePassTaskView:RefreshExp()
    local level, exp, maxExp, nextAward, isMax = self.otherActivityCls:GetLvAndNextAward(self.ActivityID)
    self.go_table.aortext_lv.text = level
    if isMax then
        self.go_table.aortext_exp.text = _G.GetLangPackValue(90021700023)
        self.go_table.slider_expSlider.value = 1
        self.go_table.aortext_next.text = _G.GetLangPackValue(90029300006)
    else
        self.go_table.aortext_exp.text = _G.GetLangPackValue(90029300007, maxExp - exp)
        self.go_table.slider_expSlider.value = exp / maxExp
        self.go_table.aortext_next.text = _G.GetLangPackValue(90029300008)
    end
    self:UpdateNextLvAward(level, nextAward, isMax)
end

function DrawUpBattlePassTaskView:SortTask()
    ---@param data DrawUpBattlePassTaskData
    _G.SortList(
        self.taskDatas,
        function(data)
            local index = 1
            if data.i_task.state == _G.TaskEnum.ETaskState.Submited then
                index = 2
                if self.activityCls:CheckIsGet(data.i_task.sid) then
                    index = -1
                end
            end
            return index, -data.i_task.sid
        end
    )
end

---更新下一等级可获得奖励
function DrawUpBattlePassTaskView:UpdateNextLvAward(level, nextAward, isMax)
    if self.level and self.level == level and not isMax then
        return
    end
    self.level = level
    self.go_table.obj_normalPos:ClearChildren()
    self.go_table.obj_cashlPos:ClearChildren()
    for i = 1, #nextAward.free do
        local tb = nextAward.free[i]
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            tb,
            self.go_table.obj_normalPos,
            function(item)
                if self:IsNil() then
                    _G.DestroyObject(item.go_table.gameObject)
                    return
                end
                item.go_table.gameObject:SetRectTransformSize(88, 88)
                if isMax then
                    item:SetGou(true)
                end
                if tb[2] > 1 then
                    item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                else
                    item:ShowNumText(false)
                end
                if item.ShowEffectOrder then
                    item:ShowEffectOrder(item.cfg.ef_item == 1 and true or false)
                end
            end
        )
    end
    for i = 1, #nextAward.pay do
        local tb = nextAward.pay[i]
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            tb,
            self.go_table.obj_cashlPos,
            function(item)
                if self:IsNil() then
                    _G.DestroyObject(item.go_table.gameObject)
                    return
                end
                item.go_table.gameObject:SetRectTransformSize(88, 88)
                if isMax then
                    item:SetGou(true)
                end
                if tb[2] > 1 then
                    item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                else
                    item:ShowNumText(false)
                end
                if item.ShowEffectOrder then
                    item:ShowEffectOrder(item.cfg.ef_item == 1 and true or false)
                end
            end
        )
    end
end

---按钮点击事件在这里派发
function DrawUpBattlePassTaskView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.aorbtn_getAll then
        local getTaskList = self.activityCls:GetCankTaskList()
        self.activityCls:GetAward(
            getTaskList,
            function()
                self:UpdateView()
            end
        )
    end
end

return DrawUpBattlePassTaskView
