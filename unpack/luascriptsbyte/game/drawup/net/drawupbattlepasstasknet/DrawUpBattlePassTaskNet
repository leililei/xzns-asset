local base = require "BaseGameNet"

---@class DrawUpBattlePassTaskNet : BaseGameNet	通信协议
local DrawUpBattlePassTaskNet = _G.BaseClass("DrawUpBattlePassTaskNet", base)

---@return DrawUpBattlePassTaskNet DrawUpBattlePassTaskNet
function DrawUpBattlePassTaskNet:GetInstance()
    return self.super.super.GetInstance(self)
end

function DrawUpBattlePassTaskNet:SendNetMsg(pbData, callback, net_cfg)
    local port = base.Access(self, net_cfg, pbData, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

---请求
---@param pbData table PB数据
---@param callback function 完成回调
function DrawUpBattlePassTaskNet:GetAward(pbData, callback)
    if pbData.activity_id == nil then
        _G.LogError("【容错】GM战令任务领取奖励 活动id为空！")
        return
    end
    if _G.table.isEmptyOrNil(pbData.task_sid) then
        _G.LogError("【容错】GM战令任务领取奖励 任务列表为空！")
        return
    end
    self:SendNetMsg(pbData,callback,_G.ConfigManager.net_map.game_activity_module_port_activity_task_finish)
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function DrawUpBattlePassTaskNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type DrawUpBattlePassTaskNet
_G.DrawUpBattlePassTaskNet = DrawUpBattlePassTaskNet
return DrawUpBattlePassTaskNet
