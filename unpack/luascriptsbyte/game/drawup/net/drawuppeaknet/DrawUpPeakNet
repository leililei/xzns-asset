local base = require("BaseGameNet")

---@class DrawUpPeakNet : BaseGameNet    通信协议
local DrawUpPeakNet = _G.BaseClass("DrawUpPeakNet", base)
---@return DrawUpPeakNet DrawUpPeakNet
function DrawUpPeakNet:GetInstance()
    return base.GetInstance(self)
end

---战斗
function DrawUpPeakNet:GetHeroTrial(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_module_hero_fight
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---描述：完成任务
function DrawUpPeakNet:GetHeroTrialFinish(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_module_hero_finish
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

-- ---描述：每日排行结算奖励
function DrawUpPeakNet:GetHeroTrialRankAward(data)
    if _G.IsNil(data) then
        return
    end
end
---个人排行榜数据
---@param callback function 回调
function DrawUpPeakNet:SelfRank(sid, callback)
    local item = _G.ConfigManager.net_map.game_rank_get_rank_num
    local port = base.Access(self, item, {type = sid}, _G.handler(self, self.Callback))
    self.Call[port] = callback
end
---获取挑战列表敌人信息
function DrawUpPeakNet:GetEnemyData(pbData, callback)
    local item = _G.ConfigManager.net_map.game_rank_hero_trial
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end
---添加所有后端主动推的网络消息监听接口
function DrawUpPeakNet:AddMessageListeners()
end
---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function DrawUpPeakNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return DrawUpPeakNet
