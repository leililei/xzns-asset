local base = require("BaseGameNet")

---@class DrawUpBattlePassNet : BaseGameNet    通信协议
local DrawUpBattlePassNet = _G.BaseClass("DrawUpBattlePassNet", base)
---@return DrawUpBattlePassNet DrawUpBattlePassNet
function DrawUpBattlePassNet:GetInstance()
    return base.GetInstance(self)
end

---确认选择应援队伍
function DrawUpBattlePassNet:GetAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_module_battle_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---确认选择应援队伍
function DrawUpBattlePassNet:GetBuyExp(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_module_battle_buy_exp
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function DrawUpBattlePassNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return DrawUpBattlePassNet