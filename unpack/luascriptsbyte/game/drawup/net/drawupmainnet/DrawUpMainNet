local base = require "BaseGameNet"

---@class DrawUpMainNet : BaseGameNet	通信协议
local DrawUpMainNet = _G.BaseClass("DrawUpMainNet", base)

---查询玩家抽卡数据
---@param pbData table PB数据
---@param callback function 完成回调
function DrawUpMainNet:GetModuleExecuteAccess(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_module_execute
    local port = base.Access(self, item, pbData, _G.handler(self, self.AccessCall))
    self.Call[port] = callback
end

---设置心愿卡牌
---@param pbData table PB数据
---@param callback function 完成回调
function DrawUpMainNet:SetWishCard(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_module_set_card
    local port = base.Access(self, item, pbData, _G.handler(self, self.AccessCall))
    self.Call[port] = callback
end


---获取招募排名
---@param callback fun(msg:rank.s2c_rank_activity_lucky_draw,delayRanks:number) delayRanks:不满足条件时后推名次
function DrawUpMainNet:GetRank(callback, activityId)
    ---前三排名最少抽卡数
    local rank3 = _G.ConfigManager.discrete_cfg[108603][1][1]

    local port = self:Access(_G.ConfigManager.net_map.game_rank_activity_lucky_draw, { page = 1, id = activityId }, _G.handler(self, self.AccessCall))
    ---@param msg rank.s2c_rank_activity_lucky_draw
    self.Call[port] = function(msg)
        local delayRanks = 0
        msg.ranks = msg.ranks or {}
        for i = 1, #msg.ranks do
            local rankItem = msg.ranks[i]
            if i <= 3 and rankItem.draw_times < rank3 and delayRanks <= 0 then
                delayRanks = 4 - i
            end
            msg.ranks[i].rank = i + delayRanks
        end
        if callback then
            callback(msg, delayRanks)
        end
    end
end

---获取个人排名
---@param delayRanks number 延迟排名，不足200抽时不进前三，所以后续排名都需要后退
function DrawUpMainNet:GetSelfRank(callback, activityId, delayRanks)
    local port = self:Access(_G.ConfigManager.net_map.game_rank_get_rank_num, { type = activityId }, _G.handler(self, self.AccessCall))
    ---@param msg rank.s2c_get_rank_num
    self.Call[port] = function(msg)
        if msg.ack ~= 1 then
            return
        end
        local myScore = msg.value
        local myRank = msg.index
        ---前三排名最少抽卡数
        local rank3 = _G.ConfigManager.discrete_cfg[108603][1][1]
        if myScore < rank3 and myRank > 0 then
            msg.index = myRank + delayRanks
        end
        if callback then
            callback(msg)
        end
    end
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function DrawUpMainNet:AccessCall(port, data, error)
    if error then
        return
    end

    if _G.AppSetting.DEBUG then
        _G.Log(data.ack)
    end
    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type DrawUpMainNet

return DrawUpMainNet
