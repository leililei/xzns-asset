---@class RequestSubscribeNet : BaseGameNet	通信协议
local RequestSubscribeNet = _G.BaseClass("RequestSubscribeNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return RequestSubscribeNet RequestSubscribeNet
function RequestSubscribeNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---获取订阅状态信息
---@param callback function 完成回调
function RequestSubscribeNet:GetInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_app_push_get
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---设置订阅信息
---@param pbData app_push.c2s_app_push_onoff PB数据
---@param callback function 完成回调
function RequestSubscribeNet:SetState(pbData, callback)
    local item = _G.ConfigManager.net_map.game_app_push_onoff
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
    return port
end

---微信订阅
------@param pbData wx.subscribe.c2s_wx_subscribe PB数据
---@param callback function 完成回调
function RequestSubscribeNet:WXSubscribe(pbData, callback)
    local item = _G.ConfigManager.net_map.game_wx_subscribe
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function RequestSubscribeNet:CallBack(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type RequestSubscribeNet
return RequestSubscribeNet
