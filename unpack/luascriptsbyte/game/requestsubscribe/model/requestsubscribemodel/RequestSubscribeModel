require "ReedCatkinsNet"
---@class RequestSubscribeModel    订阅设置
local RequestSubscribeModel = _G.BaseClass("RequestSubscribeModel", _G.GameDataModelBase)
---@return RequestSubscribeModel RequestSubscribeModel
function RequestSubscribeModel:GetInstance()
    return self.super.GetInstance(self)
end

---类的构造函数
function RequestSubscribeModel:__init()
    self.CurSubscribeState = { 0, 0, 0, 0 }
    if AppSetting.IsXzns then
        local platform = _G.tonumber(_G.SDKManager:GetInstance():GetChannelId())
        local needpf = _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.pushNotification, platform)
        if not needpf then
            return
        end
        local tb=_G.GameUtil.GetFunctionData(_G.FunctionBlock.receiveMessages, platform)
        self.CurSubscribeState={}
        self.calliddic={}
        self.CurModelIds={}
        for i = 1, #tb do
            self.CurModelIds[tonumber(tb[i][1])]=tb[i][2]
            self.CurSubscribeState[tonumber(tb[i][1])]=0
            self.calliddic[i]=tonumber(tb[i][1])
        end
    else
        self.CurModelIds = {
            "Dm7OQhUano9fhU9BaxNx4jkWcj6PrgA49LtQ4haBKfU",
            "dlbfma7SlyEj2Gka9tIOM2F52FD45QyFsNYEgH85ck8",
            "yggfV8AvZcFW62p366cKptrC58_R6mN4Hb17gvIt6w8",
            "JFUKpCGiMKuHH9xSLXH6ZYPXW16giWtjfcsirFKA62I"
        }
    end
end
function RequestSubscribeModel:GetCurModelId(index)
    if AppSetting.IsXzns then
        return self.CurModelIds[index]
    else
        return self.CurModelIds[index]
    end
end
function RequestSubscribeModel:GetNewCallid(callid)
    if AppSetting.IsXzns then
        return self.calliddic[callid]
    else
        return callid
    end
    
end

function RequestSubscribeModel:DoRS(callId)
    if _G.AppSetting.DEBUG then
        _G.Log(_G.AppSetting.IsEditor, "订阅判断是不是编辑器")
        _G.Log(_G.AppSetting.IsWeiXin, "订阅判断是不是微信")
    end
    if not _G.AppSetting.IsWeiXin then
        return
    end
    local platform = _G.tonumber(_G.SDKManager:GetInstance():GetChannelId())
    if AppSetting.IsXzns then
        local needpf = _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.pushNotification, platform)
        if _G.AppSetting.DEBUG then
            _G.Log(platform, "渠道id")
            _G.Log(needpf, "配置表订阅要求渠道是否开启")
        end
        if not needpf then
            return
        end
    else
        local needpf = _G.ConfigManager.discrete_cfg[124012][1][1]
        if _G.AppSetting.DEBUG then
            _G.Log(platform, "渠道id")
            _G.Log(needpf, "配置表订阅要求渠道id")
        end
        if platform ~= needpf then
            return
        end
    end
    if _G.AppSetting.DEBUG then
        _G.Log(callId, "订阅触发类型")
    end
    local rsNet = require "RequestSubscribeNet":GetInstance()
    local checksub = self:CheckNeedSendSubscribe(callId)
    if _G.AppSetting.DEBUG then
        _G.Log(checksub, "订阅界面是否满足每日刷新")
    end
    if checksub then
        local mdata = {}
        if AppSetting.IsXzns then
            callId = self:GetNewCallid(callId)
        end
        mdata.tmplId = self:GetCurModelId(callId)
        _G.SDKManager:GetInstance():SendExtend(
                "requestSubscribeMessageArray",
                function(bol, data)
                    if _G.AppSetting.DEBUG then
                        _G.Log(bol, "订阅信息设置回调消息1")
                        _G.Log(data, "订阅信息设置回调消息2")
                    end
                    if bol and data then
                        if _G.AppSetting.DEBUG then
                            _G.Log(data.ids, "订阅信息设置回调消息3")
                            _G.Log(mdata.tmplId, "订阅信息设置回调消息4")
                        end
                        if data.ids then
                            local accept = data.ids[mdata.tmplId]
                            if _G.AppSetting.DEBUG then
                                _G.Log(accept, "订阅信息设置回调消息5")
                            end
                            if accept == "accept" then
                                local msg = {}
                                msg.req = {
                                    k = callId,
                                    v = 1
                                }
                                rsNet:SetState(
                                        msg,
                                        function(msgs)
                                            if msgs.ack == 1 then
                                                self.CurSubscribeState[callId] = 1
                                            end
                                        end
                                )

                                local msgwx = {}
                                msgwx.ids = { callId }
                                rsNet:WXSubscribe(msgwx)
                            end
                        end
                    end
                end,
                mdata
        )
    end
end

---类的析构函数
function RequestSubscribeModel:Dispose()
    self.CurSubscribeState = nil
end

function RequestSubscribeModel:GetDataFormServer()
    self:GetInfo()
end

---更新选中状态
function RequestSubscribeModel:UpdateSubscribe(id, gou)
    self.CurSubscribeState[id] = gou and 1 or 0
end

---获取信息回调
---@param msg app_push.s2c_app_push_info_list
function RequestSubscribeModel:GetInfoCall(msg, callback)
    local list = msg.list
    if list then
        for i = 1, #list do
            local info = list[i]
            self.CurSubscribeState[info.id] = info.onoff[1]
        end
    end
    self:ParseData()
    if callback then
        callback()
    end
end

---获取订阅信息
function RequestSubscribeModel:GetInfo(callback)
    require("RequestSubscribeNet"):GetInstance():GetInfo(_G.handlerbind(self, self.GetInfoCall, callback))
end

function RequestSubscribeModel:OnSixClockUpdate(endcall)
    self.super.OnSixClockUpdate(self, endcall)
end

---获取条目状态
function RequestSubscribeModel:GetStateById(id)
    local state = self.CurSubscribeState[id]
    if nil == state then
        if _G.AppSetting.DEBUG then
            _G.LogError(state, "订阅条目id异常")
        end
        return 0
    end
    return state
end

---检查对应功能订阅是否可以发送
function RequestSubscribeModel:CheckNeedSendSubscribe(id)
    local timestamp = _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
    local enterView = _G.PlayerPrefsManager.GetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "WXSubscribe" .. id, 0)
    if enterView ~= timestamp then
        --刷新时刻并调起wx订阅
        --local timestamp = _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
        _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "WXSubscribe" .. id, timestamp)
        return true
    end
    return false
end

function RequestSubscribeModel:ReConnect(call)
    self:InitData(call)
end

return RequestSubscribeModel
