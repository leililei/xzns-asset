local RequestSubscribeModel = require "RequestSubscribeModel"
---@class RequestSubscribeView : UIBaseView    中文描述
---@field public go_table RequestSubscribeView_GoTable GoTable
local RequestSubscribeView = _G.BaseClass("RequestSubscribeView", _G.UIBaseView)

function RequestSubscribeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function RequestSubscribeView:OnCreate()
    local togs = { self.go_table.toggle_gj, self.go_table.toggle_as, self.go_table.toggle_ss, self.go_table.toggle_kj }
    self.FirstSet = {
        { "$_toggle_gj", 0 },
        { "$_toggle_as", 0 },
        { "$_toggle_ss", 0 },
        { "$_toggle_kj", 0 }
    }
    local len = table.count(RequestSubscribeModel:GetInstance().CurSubscribeState)
    for i = 1, len do
        local callid=RequestSubscribeModel:GetInstance():GetNewCallid(i)
        local istrue = RequestSubscribeModel:GetInstance().CurSubscribeState[callid] == 1
        self.FirstSet[i][2] = istrue and 1 or 0
        togs[i].isOn = istrue
    end
end

--选择订阅条目
function RequestSubscribeView:DoChooseSubscribe(modelid, id, isOn)
    local rsNet = require "RequestSubscribeNet":GetInstance()
    if isOn then
        local checksub = RequestSubscribeModel:GetInstance():CheckNeedSendSubscribe(id)
        if _G.AppSetting.DEBUG then
            _G.Log(checksub, "订阅界面是否满足每日刷新")
        end
        if checksub then
            local mdata = {}
            mdata.tmplId = modelid
            _G.SDKManager:GetInstance():SendExtend(
                "requestSubscribeMessageArray",
                function(bol, data)
                    if _G.AppSetting.DEBUG then
                        _G.Log(bol, "订阅信息设置回调消息1")
                        _G.Log(data, "订阅信息设置回调消息2")
                    end
                    if bol then
                        local msg = {}
                        msg.req = {
                            k = id,
                            v = 1
                        }
                        rsNet:SetState(
                            msg,
                            function(msgs)
                                if msgs.ack == 1 then
                                    self:UpdateSubscribe(id, true)
                                end
                            end
                        )
                        local accept = data.ids[mdata.tmplId]
                        if _G.AppSetting.DEBUG then
                            _G.Log(data.ids, "订阅信息设置回调消息3")
                            _G.Log(mdata.tmplId, "订阅信息设置回调消息4")
                            _G.Log(accept, "订阅信息设置回调消息5")
                        end
                        if accept == "accept" then
                            local msgwx = {}
                            msgwx.ids = { id }
                            rsNet:WXSubscribe(msgwx)
                        end
                    end
                end,
                mdata
            )
        end
    else
        local msg = {}
        msg.req = {
            k = id,
            v = 0
        }
        rsNet:SetState(
            msg,
            function(msgs)
                if msgs.ack == 1 then
                    self:UpdateSubscribe(id, false)
                end
            end
        )
    end
end

---更新选中状态
function RequestSubscribeView:UpdateSubscribe(id, gou)
    RequestSubscribeModel:GetInstance():UpdateSubscribe(id, gou)
end

---按钮点击事件在这里派发
function RequestSubscribeView:OnClickBtn(go, isOn)
    local name = go:GetName()

    if _G.AppSetting.DEBUG then
        _G.Log(name, "订阅界面响应事件")
    end

    if _G.string.contains(name, "$_toggle") then
        local gotable = _G.GetAutoGoTable(go)
        _G.GameUtil.SetActiveByCondition(gotable.aorimage_onpoint, isOn)
    end

    for i = 1, #self.FirstSet do
        if self.FirstSet[i][1] == name then
            if self.FirstSet[i][2] == 1 then
                self.FirstSet[i][2] = 0
                return
            end
        end
    end

    ---1、挂机状态满8小时提示领取

    --2、奥山之战开战提醒

    --3、悬赏栏可领取提示

    --4、公会砍价  每日21点时判断价格是否低于200钻且玩家未购买
    if name == "$_toggle_gj" then
        local callid=RequestSubscribeModel:GetInstance():GetNewCallid(1)
        self:DoChooseSubscribe(RequestSubscribeModel:GetInstance():GetCurModelId(callid), callid, isOn)
    elseif name == "$_toggle_as" then
        local callid=RequestSubscribeModel:GetInstance():GetNewCallid(2)
        self:DoChooseSubscribe(RequestSubscribeModel:GetInstance():GetCurModelId(callid), callid, isOn)
    elseif name == "$_toggle_ss" then
        local callid=RequestSubscribeModel:GetInstance():GetNewCallid(3)
        self:DoChooseSubscribe(RequestSubscribeModel:GetInstance():GetCurModelId(callid), callid, isOn)
    elseif name == "$_toggle_kj" then
        local callid=RequestSubscribeModel:GetInstance():GetNewCallid(4)
        self:DoChooseSubscribe(RequestSubscribeModel:GetInstance():GetCurModelId(callid), callid, isOn)
    elseif name == "@_aorbtn_back" or name == "@_aorbtn_backx" then
        self:CloseView()
    elseif name == "@_aorbtn_dy" then
        if _G.AppSetting.DEBUG then
            _G.Log(name, "订阅按钮模拟点击生效")
        end
    end
end

---关闭界面
function RequestSubscribeView:CloseView()
    self:Close()
end

return RequestSubscribeView
