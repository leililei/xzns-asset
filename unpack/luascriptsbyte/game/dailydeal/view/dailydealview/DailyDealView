---@class DailyDealView : UIBaseView	中文描述
---@field public go_table DailyDealView_GoTable GoTable
local DailyDealView = _G.BaseClass("DailyDealView", _G.UIBaseView)
local DailyDealModel = require "DailyDealModel":GetInstance()
local GetLangPackValue = _G.GetLangPackValue
local StorageManager = _G.StorageManager:GetInstance()
local CS = _G.CS
local StoreCfg = _G.ConfigManager.store_gear_cfg
function DailyDealView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function DailyDealView:OnCreate()
    self.GiftItemList = {}
    self.cfg = {}
    self.BuyAllData = {}
    self.canBuyAll = true
    self.canTakeAll = false
    self.ItemList = {}
    self.createIndex = DailyDealModel:GetCreateIndex()
    self:Init()
end

function DailyDealView:Init()
    self.cfg = DailyDealModel:GetGiftCfg()
    self.BuyAllData = DailyDealModel:GetBuyAllData()
    self.canBuyAll = DailyDealModel:CanBuyALL()
    self.buyTimes = DailyDealModel:GetBuyAllTimes()
    self.canTakeAll = DailyDealModel:CanTakeALL()
    self:InitBuyAll()
    self:ShowGrid()
    self:ShowEffect()
end

function DailyDealView:InitBuyAll()
    if self.canBuyAll or self.buyTimes > 0 then
        self.go_table.aorbtn_getAll:SetActiveE(1)
        self.go_table.obj_tip2:SetActiveE(1)
    else
        self.go_table.aorbtn_getAll:SetActiveE(0)
        self.go_table.obj_tip2:SetActiveE(0)
    end
    self.go_table.aortext_getall:SetActiveE(self.buyTimes > 0 and 1 or 0)
    self.go_table.aortext_buyall:SetActiveE(self.buyTimes > 0 and 0 or 1)
    self.go_table.obj_discount:SetActiveE(self.buyTimes > 0 and 0 or 1)
    self.go_table.aortext_discount.text = GetLangPackValue(90028800006, self.BuyAllData.Discount / 1000)
    --local gearCfg = StoreCfg[self.BuyAllData.price]
    local info = _G.LoginManager:GetInstance():GetGooglePayInfoByPrice(self.BuyAllData.price)
    if info ~= nil then
        self.go_table.aortext_buyall.text = info.formattedPrice
    else
        if _G.AppSetting.IsOverseas then
            self.go_table.aortext_buyall.text =
                GetLangPackValue(90000010807) .. GetLangPackValue(90028800004, _G.GameUtil.RatioControl(self.BuyAllData.price))
        else
            self.go_table.aortext_buyall.text =
                GetLangPackValue(90028800004, GetLangPackValue(90000010819, _G.GameUtil.RatioControl(self.BuyAllData.price)))
        end
    end
    self.go_table.aortext_getall.text = GetLangPackValue(90028800005, self.buyTimes)
end

---@private
function DailyDealView:ShowEffect()
    local LoadEffectByCfg = _G.UIUtils.LoadEffectByCfg
    local RemoveEffect = _G.UIUtils.RemoveEffect
    local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
    local function loadDone(effect)
        if self:IsNil() then
            RemoveEffect(effect)
        end
    end
    LoadEffectByCfg(ui_effect_cfg.ef_DailyDealView_title, self.go_table.obj_UIEffect, loadDone)
    LoadEffectByCfg(ui_effect_cfg.ef_DailyDealView_bg, self.go_table.obj_UIEffect, loadDone)
end

---界面的销毁函数
function DailyDealView:OnDestroy()
end

---按钮点击事件在这里派发
function DailyDealView:OnClickBtn(go)
    if go == self.go_table.aorbtn_getAll and self.canBuyAll and self.buyTimes <= 0 then
        DailyDealModel:Buy(self.BuyAllData.sid)
    end
end

function DailyDealView:OnClickGift(go, isOn, cfg)
    local name = go:GetName()
    if name == "@_aorbtn_get" then
        if cfg.isFree then
            DailyDealModel:GetFreeAward(
                {cfg.sid},
                function()
                    self:Init()
                end
            )
        elseif self.canTakeAll and not cfg.isFree then
            DailyDealModel:GetAllAward(
                self.BuyAllData.awardData,
                function()
                    self:Init()
                end
            )
        else
            DailyDealModel:Buy(cfg.sid)
        end
    end
end

function DailyDealView:ShowGrid()
    local cfg, item, goods, isBuy, tb
    for i = 1, 4 do
        local count = 0
        if self.createIndex[i] then
            cfg = self.cfg[self.createIndex[i].id]
            if cfg then
                if not self.GiftItemList[i] then
                    item = _G.InstantiateObject(self.go_table.obj_item, self.go_table.obj_Grid)
                    self.GiftItemList[i] = item
                end
                tb = _G.GetAutoGoTable(self.GiftItemList[i], _G.handlerbind(self, self.OnClickGift, cfg))
                tb.aortext_tittle.text = GetLangPackValue(cfg.name)
                isBuy = DailyDealModel:CheckGiftIsBuy(cfg.sid)
                if cfg.isFree then
                    tb.aortext_get.text = GetLangPackValue(90028800002)
                    tb.obj_limit:SetActiveE(0)
                else
                    tb.obj_limit:SetActiveE(1)
                    if self.buyTimes > 0 then
                        tb.aortext_get.text = GetLangPackValue(90000010016)
                    else
                        --local gearCfg = StoreCfg[cfg.price]
                        local info = _G.LoginManager:GetInstance():GetGooglePayInfoByPrice(cfg.price)
                        if info ~= nil then
                            tb.aortext_get.text = info.formattedPrice
                        else
                            if _G.AppSetting.IsOverseas then
                                tb.aortext_get.text =
                                    GetLangPackValue(90000010807) .. _G.GameUtil.RatioControl(cfg.price)
                            else
                                tb.aortext_get.text =
                                    GetLangPackValue(90000010819, _G.GameUtil.RatioControl(cfg.price))
                            end
                        end
                    end
                end
                goods = cfg.goods
                tb.aorbtn_get:SetActiveE(1)
                tb.obj_mask:SetActiveE(isBuy and 1 or 0)
                if not _G.table.isEmptyOrNil(goods) then
                    for j = 1, 2 do
                        count = count + 1
                        if goods[j] then
                            if not self.ItemList[i] then
                                self.ItemList[i] = {}
                            end
                            if not self.ItemList[i][j] then
                                local array = {goods[j][1], goods[j][2]}
                                StorageManager:GetItemBaseViewNew(
                                    array,
                                    tb.obj_itemRoot,
                                    function(tran)
                                        tran.gameObject:SetLocalScaleXYZ(0.83)
                                        tran:SetGou(isBuy)
                                        tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                                        self.ItemList[i][j] = tran
                                    end
                                )
                            else
                                self.ItemList[i][j]:SetGou(isBuy)
                            end
                        end
                    end
                end
                tb["obj_itemRoot"]:GetComponentE(typeof(CS.UnityEngine.UI.GridLayoutGroup)).enabled = false
                tb["obj_itemRoot"]:GetComponentE(typeof(CS.UnityEngine.UI.GridLayoutGroup)).enabled = true
            end
        else
            if self.GiftItemList[i] then
                self.GiftItemList[i].gameObject:SetActiveE(0)
            end
        end
    end
end

function DailyDealView:CloseView()
    self:Close()
end

return DailyDealView
