---@class DailyDealModel : GameDataModelBase
local DailyDealModel = _G.BaseClass("DailyDealModel", _G.GameDataModelBase)
local store_day_cfg = _G.ConfigManager.store_day_cfg
---创建对象时,入口构造函数
function DailyDealModel:__init()
    self.wasTaken = {}
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    --_G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.OnSixUpdate, self)
end

function DailyDealModel:GetInstance()
    return self.super.GetInstance(self)
end

function DailyDealModel:InitCfg()
    self.buyTimes = 0
    self.Cfg = {}
    self.CreateIndex = {}
    self.freeGiftId = 0
    self.BuyAllData = {}
    local data
    for k, v in pairs(store_day_cfg) do
        if v.type_1 == 2 then
            self.BuyAllData.sid = v.id
            self.BuyAllData.awardData = v.store_id
            self.BuyAllData.price = v.price
            self.BuyAllData.IsFirstCharge = v.first_charge
            self.BuyAllData.Discount = v.discount
        else
            data = {}
            data.sid = v.id
            data.name = v.name
            data.displayPriority = v.display_priority
            data.goods = v.goods
            data.isFree = v.price == 0
            if v.price == 0 then
                self.freeGiftId = v.id
            end
            data.price = v.price
            data.IsFirstCharge = v.first_charge
            self.Cfg[v.id] = data
            _G.table.insert(self.CreateIndex, {id = v.id, display_priority = v.display_priority})
        end
    end
    _G.SortList(
        self.CreateIndex,
        function(a)
            return -a.display_priority
        end
    )
end
function DailyDealModel:GetInfo(callback)
    self:InitCfg()
    require "DailyDealNet":GetInstance():GetInfo(_G.handlerbind(self, self.ParseData, callback))
end

function DailyDealModel:ReConnect(endcall)
    self.reconnectEndCall = endcall
    self:GetInfo()
end

function DailyDealModel:ParseData(data, callback)
    self.wasTaken = {}
    if data.buy_day then
        self.buyTimes = data.buy_day
    end
    if data.times then
        for _, v in pairs(data.times) do
            self.wasTaken[v.k] = 1
        end
        if
            self.wasTaken[self.BuyAllData.awardData[1]] and self.wasTaken[self.BuyAllData.awardData[2]] and
                self.wasTaken[self.BuyAllData.awardData[3]]
         then
            self.buyTimes = self.buyTimes - 1
        end
    end
    self:RefreshRedPoint()
    self:RefreshView()
    if callback then
        callback()
    end
    if self.reconnectEndCall then
        self.reconnectEndCall()
    end
end

---领取免费礼包
function DailyDealModel:GetFreeAward(sid, call)
    require "DailyDealNet":GetInstance():GetAward(sid, _G.handlerbind(self, self.GetFreeAwardSuccess, call))
end

---领取付费礼包
function DailyDealModel:GetAllAward(sid, call)
    require "DailyDealNet":GetInstance():GetAward(sid, _G.handlerbind(self, self.GetAllAwardSuccess, call))
end

function DailyDealModel:GetFreeAwardSuccess(msg, call)
    if msg.ack ~= 1 then
        return
    end
    self.wasTaken[self.freeGiftId] = 1
    self:RefreshRedPoint()
    if call then
        call()
    end
    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
    require "CommonTipManager".OpenCommonAwardView(msg)
end

function DailyDealModel:GetAllAwardSuccess(msg, call)
    if msg.ack ~= 1 then
        return
    end
    self:RefreshRedPoint()
    self.buyTimes = self.buyTimes - 1
    for _, v in pairs(self.BuyAllData.awardData) do
        self.wasTaken[v] = 1
    end
    if call then
        call()
    end
    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
    require "CommonTipManager".OpenCommonAwardView(msg)
end

function DailyDealModel:OnMallCashListener(data)
    local cfg = store_day_cfg[data.sid]
    if cfg ~= nil then
        if data.sid == self.BuyAllData.sid then
            self.buyTimes = self.buyTimes + 7
        else
            self.wasTaken[data.sid] = 1
        end
        self:RefreshView()
        self:RefreshRedPoint()
    end
end

function DailyDealModel:SetFreshRedPoint(RefreshRedPointCall)
    self.RefreshRedPointCall = RefreshRedPointCall
end

function DailyDealModel:RefreshRedPoint()
    if self.RefreshRedPointCall ~= nil then
        self.RefreshRedPointCall()
    end
end

---销毁对象时,析构函数
function DailyDealModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    --_G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.OnSixUpdate, self)
end

---刷新界面
function DailyDealModel:RefreshView()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DailyDealView.Name)
    if view then
        view:Init()
    end
end

---获得礼包列表先后
function DailyDealModel:GetCreateIndex()
    return self.CreateIndex
end

function DailyDealModel:GetBuyAllData()
    return self.BuyAllData
end

--购买
function DailyDealModel:Buy(sid)
    local cfg = store_day_cfg[sid]
    if cfg ~= nil then
        require("MallManager"):GetInstance():BuyActiveGift(cfg.price, nil, cfg.id)
    end
end

function DailyDealModel:GetGiftCfg()
    return self.Cfg
end

function DailyDealModel:CheckRed()
    if not self.wasTaken[self.freeGiftId] then
        return 1
    elseif self.buyTimes > 0 and self:CanTakeALL() then
        return 1
    end
    return 0
end

---获得礼包列表先后
function DailyDealModel:GetCreateIndex()
    return self.CreateIndex
end

function DailyDealModel:GetBuyAllData()
    return self.BuyAllData
end

function DailyDealModel:GetBuyAllTimes()
    return self.buyTimes
end

function DailyDealModel:CheckGiftIsBuy(sid)
    for k, v in pairs(self.wasTaken) do
        if sid == k then
            return true
        end
    end
    return false
end

function DailyDealModel:CanBuyALL()
    for k, v in pairs(self.wasTaken) do
        if k == self.BuyAllData.awardData[1] then
            return false
        elseif k == self.BuyAllData.awardData[2] then
            return false
        elseif k == self.BuyAllData.awardData[3] then
            return false
        end
    end
    return true
end

function DailyDealModel:CanTakeALL()
    if self.buyTimes <= 0 then
        return false
    end
    for k, v in pairs(self.wasTaken) do
        if k == self.BuyAllData.awardData[1] then
            return false
        elseif k == self.BuyAllData.awardData[2] then
            return false
        elseif k == self.BuyAllData.awardData[3] then
            return false
        end
    end
    return true
end

