local base = require "ActivitySynTypeBase"
---@class DailyDealSynModel : ActivitySynTypeBase	中文描述
local DailyDealSynModel = _G.BaseClass("DailyDealSynModel", base)
-- _G.DailyDealSynModel = DailyDealSynModel

-- local CS = _G.CS
-- local typeof = _G.typeof

---创建对象时,入口构造函数
function DailyDealSynModel:__init()
    self.DailyDealModel = require "DailyDealModel":GetInstance()
    self.DailyDealModel:SetFreshRedPoint(_G.handler(self, self.RefreshRedPoint))
end

--- 网络请求初始化
function DailyDealSynModel:GetDataFormServer()
    self.DailyDealModel:GetInfo(_G.handler(self, self.ParseData))
end

---数据解析完成
function DailyDealSynModel:ParseData()
    base.ParseData(self)
end

function DailyDealSynModel:InitFunction()
    self.DailyDealModel:InitFunction()
end

---进入活动主体
function DailyDealSynModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DailyDealView.Name)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function DailyDealSynModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.DailyDealView.Name
end

---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function DailyDealSynModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end

function DailyDealSynModel:CheckRedPoint()
    return self.DailyDealModel:CheckRed()
end

---刷新奖励红点
function DailyDealSynModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function DailyDealSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end
--endregion

---销毁对象时,析构函数
function DailyDealSynModel:Dispose()
end

function DailyDealSynModel:ReConnect(endcall)
    self.DailyDealModel:ReConnect(endcall)
end
return DailyDealSynModel