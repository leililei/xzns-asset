local base = require("BaseGameNet")

---@class DailyDealNet : BaseGameNet	通信协议
local DailyDealNet = _G.BaseClass("DailyDealNet", base)
---@return DailyDealNet DailyDealNet
function DailyDealNet:GetInstance()
    return  base.GetInstance(self)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function DailyDealNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function DailyDealNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

function DailyDealNet:GetInfo(callback)
    local item = _G.ConfigManager.net_map.game_store_day_info
    local port = base.Access(self, item, "", _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

---领取礼包
function DailyDealNet:GetAward(Sids, callback)
    local array = {}
    array.sids ={}
    for _,v in pairs(Sids) do
        array.sids[_] = v
    end
    local item = _G.ConfigManager.net_map.game_store_day_award
    local port = base.Access(self, item,array, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

return DailyDealNet