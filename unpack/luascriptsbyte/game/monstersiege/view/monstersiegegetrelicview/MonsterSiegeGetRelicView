---@class MonsterSiegeGetRelicView : UIBaseView	中文描述
---@field public go_table MonsterSiegeGetRelicView_GoTable GoTable
local MonsterSiegeGetRelicView = _G.BaseClass("MonsterSiegeGetRelicView", _G.UIBaseView)
local refreshLanguageId = 90026500037
local GetLangPackValue = _G.GetLangPackValue
function MonsterSiegeGetRelicView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MonsterSiegeGetRelicView:OnCreate()
    self.activie = require "MonsterSiegeManager":GetInstance():GetActivity()
    self.PropertyIcon = {
        [1] = "ui_js_renlei_icon",
        [2] = "ui_js_shouren_icon",
        [3] = "ui_js_jingling_icon",
        [4] = "ui_js_wangling_icon",
        [5] = "ui_js_renlei_icon",
        [6] = "ui_js_chuanqi_icon",
        [16] = "ui_js_multi16",   --人神
        [26] = "ui_js_multi26",   --兽神
        [36] = "ui_js_multi36",    --精神
        [46] = "ui_js_multi46"     --亡神
    }
    self.Quanbu = {
        "ui_js_all_btn"
    }
    self.ProfessionalIcon = _G.ProfessionalIcon
    self.NameColors = {"14874a", "5d329d", "c95f00"}
    self.anim = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    self:InitView()
end

---按钮点击事件在这里派发
function MonsterSiegeGetRelicView:OnClickBtn(go)
    if go == self.go_table.aorbtn_Sure then
        if self.isRefresh then
            return
        end
        self.activie.typeClass:EnterBuff(
            function()
                self:PlayCloseAnim(0)
                self:PlayCloseAnim(1)
            end
        )
    elseif go == self.go_table.aorbtn_Refresh then
        if self.isRefresh then
            return
        end
        self.isRefresh = true
        self.activie.typeClass:RefreshBuff(
            function(ack)
                self.isRefresh = false
                if not ack then
                    return
                end
                self.anim:Play("a_MonsterSiegeGetRelicView_open", 0, 0)
                self:InitView()
            end
        )
    end
end

---关闭动画
function MonsterSiegeGetRelicView:PlayCloseAnim(param)
    if param == 0 then
        local exitTranx, exitTrany, _ = self.go_table.aorbtn_exit.gameObject:GetLocalPosition()
        local name = "obj_Item_"
        for i = 1, 5 do
            local item = self.go_table[name .. i]
            local tb = _G.GetAutoGoTable(item, _G.handlerbind(self, i))
            _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_Monstertrail, tb.obj_efClose)
        end
        if self.anim ~= nil then
            self.anim:Play("a_MonsterSiegeGetRelicView_close")
        end
        for j = 1, 5 do
            local item = self.go_table[name .. j]
            local tb = _G.GetAutoGoTable(item, _G.handlerbind(self, j))
            local objMove = tb.gameObject
            objMove:DOLocalMove(exitTranx, exitTrany + 120, 0, 0.6):SetEase(_G.CS.DG.Tweening.Ease.Linear)
        end
    else
        _G.DelayDo(
            0.45,
            function()
                if _G.IsNil(self.go_table) then
                    return
                end
                _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_MonsterReaction, self.go_table.aorbtn_exit)
            end
        )
        _G.DelayDo(
            0.8,
            function()
                self:Close()
            end
        )
    end
end

function MonsterSiegeGetRelicView:InitView()
    self.buff_list = _G.DeepCopy(self.activie.typeClass:GetRandomBuffList())
    local count = #self.buff_list
    self.item_list = {
        self.go_table.obj_Item_1,
        self.go_table.obj_Item_2,
        self.go_table.obj_Item_3,
        self.go_table.obj_Item_4,
        self.go_table.obj_Item_5
    }
    local cfg
    _G.SortList(
        self.buff_list,
        function(id)
            cfg = _G.ConfigManager.mementos_cfg[id]
            return cfg.quality, cfg.id
        end
    )
    for i = 1, #self.item_list do
        local tb = _G.GetAutoGoTable(self.item_list[i])
        self:SetOne(tb, count, i)
    end
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_BgShow, self.go_table.obj_efBgShow)
    local count = self.activie.typeClass:GetRefreshNum()
    self.go_table.aortext_refreshNum.text = GetLangPackValue(refreshLanguageId, count)
    self.go_table.aorbtn_Refresh:SetGray(count <= 0)
    self.go_table.aorbtn_Refresh.enabled = count > 0
end
function MonsterSiegeGetRelicView:SetOne(tb, count, index)
    if index <= count then
        tb.obj_Qiwu:SetActiveE(1)
        tb.obj_Gray:SetActiveE(0)
        local tb_nor = _G.GetAutoGoTable(tb.obj_Qiwu)
        local cfg = _G.ConfigManager.mementos_cfg[self.buff_list[index]]
        tb_nor.aortext_name.text =
            _G.string.AddColor(_G.LangUtil.GetLangPackValue(cfg.name), self.NameColors[cfg.quality])
        tb_nor.aortext_desc.text = _G.LangUtil.GetLangPackValue(cfg.desc)
        local SpriteName
        if cfg.target[1] ~= 0 then
            SpriteName = self.PropertyIcon[cfg.target[1]]
        elseif cfg.target[2] ~= 0 then
            SpriteName = self.ProfessionalIcon[cfg.target[2]]
        else
            SpriteName = self.Quanbu[1]
        end
        tb_nor.aorimage_property.SpriteName = SpriteName
        tb_nor.aorrawimage_icon:LoadImage(cfg.icon)
    else
        tb.obj_Qiwu:SetActiveE(0)
        tb.obj_Gray:SetActiveE(1)
        -- tb.aorrawimage_icon1:SetGray(true)
        tb.aortext_desc1.text = _G.LangUtil.GetLangPackValue(90026500006, index)
    end
end
return MonsterSiegeGetRelicView
