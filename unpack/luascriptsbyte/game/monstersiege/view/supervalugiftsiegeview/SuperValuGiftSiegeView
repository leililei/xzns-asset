local SuperValuGiftSiegeView = _G.BaseClass("SuperValuGiftSiegeView", _G.UIBaseView)
local ActivitySynManager = require "ActivitySynManager"

function SuperValuGiftSiegeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    ---可购买文本显示时的次数
    self.limitTimesCond = _G.ConfigManager.discrete_cfg[106208][1][1]
end

---界面的入口函数
---@param type_enum number 1 = 配置表中  2 = Gm(创建)
function SuperValuGiftSiegeView:OnCreate(data, type_enum)
    self.isInited = false
    self:InitView(data, type_enum)
    self:UIEffect()
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

function SuperValuGiftSiegeView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.CountDownTime = nil
end

