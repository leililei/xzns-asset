    self:UIEffect()
end

---特效
function SuperValuGiftSiegeView:UIEffect()
    local LoadEffectByCfg = _G.UIUtils.LoadEffectByCfg
    local RemoveEffect = _G.UIUtils.RemoveEffect
    local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
    local check = function(obj)
        if self:IsNil() then
            RemoveEffect(obj)
        end
    end
    --LoadEffectByCfg(ui_effect_cfg.prf_qianji, self.go_table.trans_spine, check)
    local lihuiPath, isImage = self.typeClass:GetLiHuiPath()
    _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_role, lihuiPath and isImage)
    _G.GameUtil.SetActiveByCondition(self.go_table.trans_spine, lihuiPath and not isImage)
    if not _G.string.IsNullOrEmpty(lihuiPath) then
        local scale = self.typeClass:GetLiHuiScale()
        local pos = self.typeClass:GetLiHuiPos()
        if isImage then
            self.go_table.aorrawimage_role:LoadImage(
                lihuiPath,
                function(image)
                    image:SetNativeSize()
                    image:SetLocalPosition(pos[1], pos[2], pos[3])
                    image:SetLocalScaleXYZ(scale)
                end
            )
        else
            _G.PoolsManager:GetInstance():Spawn(
                lihuiPath,
                _G.ePoolType.UIItem,
                self.go_table.trans_spine,
                function(tran)
                    if self:IsNil() then
                        tran:DestroyObject()
                        return
                    end
                    tran:SetLocalPosition(pos[1], pos[2], pos[3])
                    tran:SetLocalScaleXYZ(scale)
                end
            )
        end
    end
    --LoadEffectByCfg(ui_effect_cfg.ef_beijingguangxiao, self.go_table.obj_uieffect_bg, check)
    --LoadEffectByCfg(ui_effect_cfg.ef_liuguangziti, self.go_table.obj_uieffect_font, check)
    --LoadEffectByCfg(ui_effect_cfg.ef_baoxiangguangxiao, self.go_table.obj_uieffect_box, check)
    --LoadEffectByCfg(ui_effect_cfg.ef_piaodailiuguang, self.go_table.obj_uieffect_saoguagn, check)
end
