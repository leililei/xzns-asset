function SuperValuGiftSiegeView:UpDateScorllView()
    _G.SortList(
        self.model_data,
        function(data)
            local num = 10
            local buy_num = self.typeClass:GetItemBuyTimes(data.id or data.sid, data.type_reset)
            local limit = data.count_limit or data.count
            --local paixu = data.display_priority or data.price
            -- if self.type_enum == 2 then
            --     limit = data.count
            --     paixu = data.price
            -- end
            if buy_num == limit then
                num = 9
            end
            return num, -data.sid
        end
    )

    self.index = 0
    if self.mScorll == nil then
        self.go_table.scrollloopvectical_item:InitItemData(#self.model_data, _G.handler(self, self.RefreshItem))
        self.mScorll = self.go_table.scrollloopvectical_item
    else
        self.mScorll:UpdateAllItem()
    end

    if not self.isInited then
        _G.DelayDo(
            0.1,
            function()
                self.isInited = true
            end
        )
    end
end
---刷新展示的卡牌
function SuperValuGiftSiegeView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    local item = obj
    item:SetName(index + 1)
    local data = self.model_data[index + 1]
    local tb = _G.GetAutoGoTable(item, _G.handlerbind(self, self.itemOnClickBtn, data))
    tb.aortext_price.text = math.floor(data.discount * 0.0001 * 100) .. "%"
    if data.price == 0 then
        tb.aortext_buy1.text = _G.TryGetLangValue(90023900001)
        tb.aortext_buy.text = ""
    elseif data.consume_type == 0 then
        tb.aortext_buy1.text = ""
        _G.GameUtil.SetPriceByChannel(data.price, tb.aortext_buy)
    else
        tb.aortext_buy1.text = ""
        tb.aortext_buy.text = data.price
        local item = _G.StorageManager:GetInstance():GetItemDataClassByCfg({data.consume_type, data.price})
        if item then
            tb.aorrawimage_icon:LoadImage(item.Icon)
        end
    end
    tb.aortext_giftname.text = data.name
    local limit = data.count_limit
    if self.type_enum == 2 then
        limit = data.count
    end
    local buy_num = self.typeClass:GetItemBuyTimes(data.id or data.sid, data.type_reset)
    if limit - buy_num > self.limitTimesCond then
        tb.aortext_buylimitnum:SetActiveE(0)
     else
         tb.aortext_buylimitnum:SetActiveE(1)
         tb.aortext_buylimitnum.text = _G.LangUtil.TryGetLangValue(90021600042, limit - buy_num)
     end
    --购买次数
    _G.GameUtil.SetActiveByCondition(tb.aortext_buy, not (buy_num == limit))
    _G.GameUtil.SetActiveByCondition(tb.aorbtn_buy, not (buy_num == limit))
    _G.GameUtil.SetActiveByCondition(tb.obj_gray, buy_num == limit)
    tb.aorrawimage_icon:SetActiveE(data.consume_type == 0 and 0 or 1)
    tb.aorimage_Gray:SetGray(buy_num == limit)
    local awrad = data.goods
    if tb.obj_AwradNode:GetChildCountE() > 0 then
        for i = 1, tb.obj_AwradNode:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(tb.obj_AwradNode:GetChildE(0), _G.ePoolType.UIItem)
        end
    end

    for j = 1, #awrad do
        _G.StorageManager:GetInstance():GetItemBaseView(
            awrad[j][1],
            awrad[j][2],
            tb.obj_AwradNode,
            function(item)
                --self.itemaward_lua[index + 1] = item
                item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                local rect = item.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
                rect:SetRectTransformSize(100, 100)
                item:ShowEffectOrder(item.cfg.ef_item == 1 and true or false)
            end
            -- function()
            --     self:OnClickItem(self.itemaward_lua[index + 1].gameObject, data[1])
            -- end
        )
    end
    if not self.aniTb then
        self.aniTb = {}
    end
    if not self.aniTb[obj:GetInstanceIDE()] then
        self.aniTb[obj:GetInstanceIDE()] = obj:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    end
    _G.GameUtil.SetActiveByCondition(obj, false)
    if not self.isInited then
        self.index = self.index + 1
        self:DelayDo(
            0.3 * self.index,
            function()
                if _G.IsNil(obj) then
                    return
                end
                _G.GameUtil.SetActiveByCondition(obj, true)
            end
        )
    else
        if self.closeAni then
            self.aniTb[obj:GetInstanceIDE()].enabled = false
        end
        _G.GameUtil.SetActiveByCondition(obj, true)
    end

    return item
end

function SuperValuGiftSiegeView:OnDisable()
    if not self.closeAni then
        self.closeAni = true
        if self.aniTb then
            for _, v in pairs(self.aniTb) do
                v.enabled = false
                local _, y = v:GetAnchorPosition()
                v:SetAnchorPosition(0, y)
                v:GetComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup)).alpha = 1
            end
        end
    end
end
function SuperValuGiftSiegeView:DelayDo(time, call)
    if not self.DelayTb then
        self.DelayTb = {}
    end
    self.DelayTb[call] =
        _G.DelayDo(
        time,
        function()
            self.DelayTb[call] = nil
            call()
        end
    )
end
function SuperValuGiftSiegeView:itemOnClickBtn(go, isOn, giftinfo)
    if not self.data:CheckActivityInteractable() then
        return
    end
    self.cashData = giftinfo
    self.typeClass:Chongzhi(
        giftinfo,
        function()
            if self:IsNil() then
                return
            end
            --这里保留一个回调处理领奖
            self:UpDateScorllView()
            if not self.typeClass:CheckOtherConditionExtra() then
                self.data:ChangeState(1) -- 改变状态 关闭
            end
        end
    )
end

function SuperValuGiftSiegeView:OnMallCashListener(data)
    self:UpDateScorllView()
    if not self.typeClass:CheckOtherConditionExtra() then
        self.data:ChangeState(1) -- 改变状态 关闭
    end
    -- self.cashData = nil
end

return SuperValuGiftSiegeView
