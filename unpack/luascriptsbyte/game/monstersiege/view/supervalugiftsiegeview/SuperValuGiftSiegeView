function SuperValuGiftSiegeView:InitTime()
    --self.go_table.obj_time:SetActiveE(1)
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    local GetLangPackValue = _G.LangUtil.GetLangPackValue
    local MainActive
    local jumpId = self.data.cfg.info.front.sub_type or 0
    local CoinSid = self.data.typeClass.coinId
    if CoinSid == 109 then ---灵弈对决
        MainActive = ActivitySynManager:GetInstance():GetChildAcitivity(10029,jumpId)
    elseif CoinSid == 104 then ---竞猜
        MainActive = ActivitySynManager:GetInstance():GetChildAcitivity(10004,jumpId)
    elseif CoinSid == 101 then ---恶灵入侵
        MainActive = ActivitySynManager:GetInstance():GetChildAcitivity(10012,jumpId)
    elseif CoinSid == 103 then ---公平竞技场
        MainActive = ActivitySynManager:GetInstance():GetChildAcitivity(10023,jumpId)
    end
    if not MainActive then
        MainActive = self.data
    end
    local startTime, _ = self.data:GetActivityDeadLineByCondition(ActivitySynManager.State.Open)
    local settlementTime, _ = MainActive:GetActivityDeadLineByCondition(ActivitySynManager.State.Settlement)
    local endTime, countdown = self.data:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    self.StartTime = _G.TimeUtil.GetDateTime(startTime)
    self.SettlementTime = _G.TimeUtil.GetDateTime(settlementTime)
    self.EndTime = _G.TimeUtil.GetDateTime(endTime)
    local text1 = GetLangPackValue(90000010300,self.StartTime.month,self.StartTime.day,self.StartTime.hour)
    .."-".. GetLangPackValue(90000010300,self.SettlementTime.month,self.SettlementTime.day,self.SettlementTime.hour)
    self.go_table.aortext_activityTime.text = GetLangPackValue(90025800003,text1)
    local text2 = GetLangPackValue(90000010300,self.StartTime.month,self.StartTime.day,self.StartTime.hour)
    .."-".. GetLangPackValue(90000010300,self.EndTime.month,self.EndTime.day,self.EndTime.hour)
    self.go_table.aortext_settlementTime.text = GetLangPackValue(90000010888,text2)

end

---刷新
function SuperValuGiftSiegeView:UpdateView(data, type_enum)
