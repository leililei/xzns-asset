---初始化view
---@param data ActivitySynGMActivity
function SuperValuGiftSiegeView:InitView(data, type_enum)
    if type_enum then
        self.type_enum = type_enum
    else
        self.type_enum = 1
    end
    self.go_table.scrollloopvectical_item:SetActiveE(1)
    --self.go_table.aorrawimage_wenzi:SetActiveE(0)
    --self.model_data = data.typeClass.model_cfg
    self.model_data = data.typeClass:GetModelCfgByCondition()
    self.typeClass = data.typeClass
    self.data = data
    self.obj_list = {
        item = {}
    }
    if not _G.string.IsNullOrEmpty(data.cfg.info.icon) then
        self.go_table.aorrawimage_wenzi1:LoadImage(
            "Images/" .. data.cfg.info.icon,
            function(raw)
                raw:SetNativeSize()
            end
        )
    end
    self:UpDateScorllView()
    self:InitTime()
end

