---@class MonsterSiegeTaskView : UIBaseView	中文描述
---@field public go_table MonsterSiegeTaskView_GoTable GoTable
local MonsterSiegeTaskView = _G.BaseClass("MonsterSiegeTaskView", _G.UIBaseView)

local awardenum = {
    none = 0, -- 未完成状态
    normal = 1, --完成未领取状态
    already_received = 2 --已领取状态
}

function MonsterSiegeTaskView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MonsterSiegeTaskView:OnCreate()
    self.taskList = {}
    self.taskData = require "MonsterSiegeTaskModel":GetInstance().alltask
    self:SortTask()
    self.go_table.scrollloopvectical_taskList:InitItemData(#self.taskData, _G.handler(self, self.RefreshTask))
end
function MonsterSiegeTaskView:UpdateView()
    self.taskList = {}
    self.taskData = require "MonsterSiegeTaskModel":GetInstance().alltask
    self:SortTask()
    self.go_table.scrollloopvectical_taskList:UpdateCount(#self.taskData)
end
---按钮点击事件在这里派发
function MonsterSiegeTaskView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end
---点击领取奖励
---@param tb FirstTestBossTaskView._obj_task_GoTable
function MonsterSiegeTaskView:OnClickTask(_, _, tb)
    local taskData = self.taskData[tb.index]
    require "MonsterSiegeTaskModel":GetInstance():OnClickReceived(
        {taskData.Cfg.id},
        function(data)
            self:SortTask()
            self.go_table.scrollloopvectical_taskList:UpdateAllItem()
        end
    )
end

---刷新奖励
function MonsterSiegeTaskView:RefreshTask(index, obj)
    local id = obj:GetInstanceIDE()
    local tb = self.taskList[id]
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickTask, tb))
        self.taskList[id] = tb
        tb.awardList = {}
        tb.scrollloophorizontal_awardList:InitItemData(0, _G.handlerbind(self, self.RefreshAward, tb))
    end
    local data = self.taskData[index + 1]
    tb.index = index + 1
    tb.aortext_name.text = _G.LangUtil.GetLangPackValue(data.Cfg.desc, data.Cfg.count)
    if data:GetAwardState() == awardenum.normal or data:GetAwardState() == awardenum.already_received then
        tb.slider_progress.value = 1
        tb.aortext_Slider.text = data.Cfg.count .. "/" .. data.Cfg.count
    else
        tb.slider_progress.value = data:GetTaskFinshNumber() / data.Cfg.count
        tb.aortext_Slider.text = data:GetTaskFinshNumber() .. "/" .. data.Cfg.count
    end
    tb.aorbtn_get:SetActiveE(data:GetAwardState() == awardenum.normal and 1 or 0)
    tb.obj_unGet:SetActiveE(data:GetAwardState() == awardenum.none and 1 or 0)
    tb.obj_complete:SetActiveE(data:GetAwardState() == awardenum.already_received and 1 or 0) --完成
    local count = #data:GetReward()
    tb.scrollloophorizontal_awardList:UpdateScrollRectWeight(count <= 1 and 94 or 255)
    tb.scrollloophorizontal_awardList:UpdateCount(count)
end
---显示奖励
---@param tb  FirstTestBossTaskView._obj_task_GoTable
function MonsterSiegeTaskView:RefreshAward(index, obj, tb)
    local id = obj:GetInstanceIDE()
    local item = tb.awardList[id]
    if not item then
        item = require "BaseAwardNewItem".New(obj, nil, 74)
        tb.awardList[id] = item
    end
    local taskData = self.taskData[tb.index]
    local awardData = taskData:GetReward()[index + 1]
    local data = _G.StorageManager:GetInstance():GetItemDataClassByCfg(awardData)
    item:Show(data)
    item.go_table.obj_gou:SetActiveE(taskData:GetAwardState() == awardenum.already_received and 1 or 0)
end
--排序
function MonsterSiegeTaskView:SortTask()
    SortList(
        self.taskData,
        function(a)
            local num = 10
            if a:GetAwardState() == 0 then
                num = 8
            elseif a:GetAwardState() == 2 then
                num = 5
            end
            return num, -a.sid
        end
    )
end

return MonsterSiegeTaskView
