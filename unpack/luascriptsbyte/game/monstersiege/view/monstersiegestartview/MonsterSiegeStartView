---@class MonsterSiegeStartView : UIBaseView	中文描述
---@field public go_table MonsterSiegeStartView_GoTable GoTable
local MonsterSiegeStartView = _G.BaseClass("MonsterSiegeStartView", _G.UIBaseView)

function MonsterSiegeStartView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MonsterSiegeStartView:OnCreate(activity)
    self.activity = activity
    self:SetEffect()
    self:SetTime()
end
---析构函数
function MonsterSiegeStartView:OnDispose()
end

---加载特效
function MonsterSiegeStartView:SetEffect()
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_Bg_bowen_loop, self.go_table.obj_efBowen)
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_Bg_huo_loop, self.go_table.obj_efHuo)
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_Eyes_loop, self.go_table.obj_efEye)
end

function MonsterSiegeStartView:SetTime()
    local ActivitySynManager = require"ActivitySynManager":GetInstance()
    local GetLangPackValue = _G.GetLangPackValue
    local startTime, _ = self.activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Open)
    local settlementTime, _ = self.activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Settlement)
    self.StartTime = _G.TimeUtil.GetDateTime(startTime)
    self.SettlementTime = _G.TimeUtil.GetDateTime(settlementTime)
    local text1 = GetLangPackValue(90000010300,self.StartTime.month,self.StartTime.day,self.StartTime.hour)
    .."-".. GetLangPackValue(90000010300,self.SettlementTime.month,self.SettlementTime.day,self.SettlementTime.hour)
    self.go_table.aortext_times.text = GetLangPackValue(90025800003,text1)
end

