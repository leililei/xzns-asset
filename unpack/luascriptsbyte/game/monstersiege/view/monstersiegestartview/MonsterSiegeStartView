---按钮点击事件在这里派发
function MonsterSiegeStartView:OnClickBtn(go)
    if go == self.go_table.aorbtn_star then
        self:OnClickStart()
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

function MonsterSiegeStartView:CloseView()
    self:Close()
end
---开始按钮
function MonsterSiegeStartView:OnClickStart()
    ---获得下个人积分排行榜
    self.activity.typeClass:RankPlayerGongXZiang(
        function()
            self:Close()
            --获得下怪物动态数据
            self.activity.typeClass:GetActivityModule(
                function()
                    --进入场景
                    require "MonsterSiegeManager":GetInstance():EnterScence(
                        function()
                            require "MonsterSiegeManager":GetInstance():OpenMainSiegeView(self.activity)
                        end
                    )
                end
            )
        end
    )
end

function MonsterSiegeStartView:CloseView()
    self:Close()
end

return MonsterSiegeStartView
