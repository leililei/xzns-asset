---@class MainSiegeView : UIBaseView	中文描述
---@field public go_table MainSiegeView_GoTable GoTable
---@field refreshViewTimer Timer        @界面刷新定时器
local MainSiegeView = _G.BaseClass("MainSiegeView", _G.UIBaseView)
local MonsterSiegeManager = require "MonsterSiegeManager":GetInstance()
function MainSiegeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.MoveCtrl = nil
    self.cooling = 0
    self.cooling_limit = 30

    --添加倒计时定时器(跳过战斗解锁可配置时间)
    if not self:IsShowSkipBattle() then
        self.refreshViewTimer =
            _G.TimerManager:GetInstance():GetTimer(1, self.RefreshSkipBattleState, self, false, true)
        self.refreshViewTimer:Start()
    end
end

---界面的入口函数
function MainSiegeView:OnCreate(activity)
    self.isqipao = false
    self.activity = activity
    self:SetRankView()
    self:SetJindutiao()
    self:SetLevel()
    self.go_table.aorrawimage_bg.raycastTarget = false
    --- 摇杆图标
    self.CurrentWorld = _G.WorldManager:GetInstance():GetCurWorld()
    self.MoveCtrl = self.go_table.rect_MoveCtrl:GetComponentE(_G.typeof(_G.CS.WorldTouch))
    self.MoveCtrl.cam = self.CurrentWorld.WorldSetting.SceneCamera.UniCam
    self.rect = self.go_table.obj_RectBG:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    self.PlayerUid = _G.PlayerModel:GetInstance().role_uid
    self.RTS = self.activity.changeStateTime
    self:BindDrag()
    self:PaoMadeng()
    if self.timer ~= nil then
        self.timer:Stop()
        self.timer = nil
    end
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.PaoMadeng, self, false, false, true)
    self.timer:Start()
    ---设置排行红点
    self:SetRedpointTask()

    self:RefreshSkipBattleState()
end
---设置任务红点
function MainSiegeView:SetRedpointTask()
    self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(self.activity.typeClass.redpointTree[1][1])
end
---设置进度条
function MainSiegeView:SetJindutiao()
    local Max = self.activity.cfg.time.run_time
    local time = self.activity:GetChangeStateTime()
    local num = time / Max
    self.go_table.aorimage_Fill.fillAmount = num
end
function MainSiegeView:OnDestroy()
    if self.timer ~= nil then
        self.timer:Stop()
        self.timer = nil
    end
    self.MoveCtrl = nil
    self.rect = nil
    _G.CS.WorldTouch.OnDragBegin = nil
    _G.CS.WorldTouch.OnDragEnd = nil
    _G.CS.WorldTouch.OnDragMove = nil
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name)
    if view then
        view:BindDrag()
    end

    if self.refreshViewTimer then
        self.refreshViewTimer:Stop()
        self.refreshViewTimer = nil
    end
end
function MainSiegeView:SetRankView()
    local tran = self.go_table.obj_littleZonePanel
    self.rank_cl = self:AddComponent(tran, require("LittleZoneRankView").New(_G.ZoneRankType.MonsterSiege, self.activity:GetActivityID(),true,nil,nil,self:GetSelfRankData()))
end

function MainSiegeView:GetSelfRankData()
    return {require "MonsterSiegeManager":GetInstance():GetDps()}
end

---刷新跳过战斗状态
---@return void
function MainSiegeView:RefreshSkipBattleState()
    --读取解锁配置并显示文本
    local params = _G.ConfigManager.discrete_cfg[115602]
    if not params then
        self.go_table.obj_skipBg:SetActiveE(0)
        return
    end
    local ok, content = _G.GlobalConditionManager.CheckConditionArraysCustomUnlockTip(params)
    if ok then
        self.go_table.obj_skipBg:SetActiveE(0)
        return
    end
    if content then
        self.go_table.aortext_skipTip.text = content
    end
    self.go_table.obj_skipBg:SetActiveE(content and 1 or 0)
end
---是否显示跳过战斗按钮
---@return boolean
function MainSiegeView:IsShowSkipBattle()
    local params = _G.ConfigManager.discrete_cfg[115602]
    if not params then
        return false
    end
    local ok = _G.GlobalConditionManager.CheckConditionArrays(params)
    return ok
end

---跑马灯
function MainSiegeView:PaoMadeng(elapsed)
    self.RTS = self.RTS - (elapsed or 1) 
    if self.RTS <= 1 then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        if not _G.BattleManager:GetInstance():CheckInBattle() then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                730102,
                nil,
                function()
                    self:Close()
                    local wind = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.EmbattleView.Name)
                    if wind then
                        wind.View:QuitEmbattle()
                    end
                    MonsterSiegeManager:ExitSection()
                end
            )
        end

        return
    end
    self.cooling = self.cooling + 1
    if self.cooling >= self.cooling_limit then
        ---@type LingRankItemData
        local msg = self.activity.typeClass:GetPaoMadengMsg()
        if msg then
            local count =
                _G.LangUtil.GetLangPackValue(
                90026500001,
                msg:GetPlayerName(),
                _G.GameUtil.NumberToUnitStr(msg:GetDamage())
            )
            _G.ScrollerManager:GetInstance():AddLocalScroller(count)
        end
        self.cooling = 0
    end
end

function MainSiegeView:OnEnable()
    if self.RTS <= 1 then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            730102,
            nil,
            function()
                self:Close()
                local wind = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.EmbattleView.Name)
                if wind then
                    wind.View:QuitEmbattle()
                end
                MonsterSiegeManager:ExitSection()
            end
        )
    end
end

---按钮点击事件在这里派发
function MainSiegeView:OnClickBtn(go)
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.WorldItemInteractedView.Name)
    if window then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.WorldItemInteractedView.Name)
    end
    if go == self.go_table.aorbtn_fight then
        self:EneterEmbattle()
    elseif go == self.go_table.aorbtn_close then
        --self.activity.typeClass:CloseSetRedPoint()
        MonsterSiegeManager:ExitSection(
            function()
                self:Close()
            end
        )
    elseif go == self.go_table.aorbtn_bag then
        self:Hide()
        --背包
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BagNewView.Name)
    elseif go == self.go_table.aorbtn_team then
        --团队
        self:Hide()
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ZhenRongView.Name,
            function()
                local MainView = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.MainView.Name)
                if MainView then
                    MainView.View:Hide()
                end
                self:Show()
            end
        )
    elseif go == self.go_table.aorbtn_role then
        self:Hide()
        --角色
        _G.MainManager:GetInstance():OpenMainViewToggle("card")
    elseif go == self.go_table.aorbtn_hejiji then
        if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(57) then
            _G.FunctionManager:GetInstance():ShowFuncitonOpenTips(57)
            return
        end
        --合击技
        self:Hide()
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CombineView.Name,
            function()
                self:Show()
            end
        )
    elseif go == self.go_table.aorbtn_duihuan then
        --兑换
        local jumpid = require "MonsterSiegeManager":GetInstance():GetJumpActivityID()
        if jumpid > 0 and require "ActivitySynManager":GetInstance():CheckActivityOpened(jumpid) then
            -- MonsterSiegeManager:ExitSection(
            --     function()
            --         self:Close()
            --     end
            -- )z
            _G.GlobalInterface.JumpActivityByGM(10005, self.activity:GetJumpType(), true) --Type -- sub--type
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(730101)
        end
    elseif go == self.go_table.aorbtn_task then
        --任务
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MonsterSiegeTaskView.Name)
    elseif go == self.go_table.aorbtn_rank then
        --排行
        self.activity.typeClass:UpdateRank(
            function()
                --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MonsterSiegeRankView.Name)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonRankView.Name, _G.CommonRankType.MonsterSiege)
            end
        )
    elseif go == self.go_table.aorbtn_award then
        --奖励
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SiegeRankView.Name)
    elseif go == self.go_table.aorbtn_qipao then
        -- self.isqipao = not self.isqipao
        -- self:SHowHideQiPao()
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MonsterSiegeLevelView.Name, self.activity)
    elseif go == self.go_table.aorbtn_way then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 49)
    end
end
