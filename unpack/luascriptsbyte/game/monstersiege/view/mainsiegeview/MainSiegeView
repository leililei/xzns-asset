function MainSiegeView:CloseView()
    self:Close()
end
function MainSiegeView:SetLevel()
    local lastLv = _G.PlayerPrefsManager.GetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "MainSiegeViewLv")
    if lastLv == 0 then
        local lv = self.activity.typeClass:GetLevel()
        _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "MainSiegeViewLv", lv)
    end
    local lv = self.activity.typeClass:GetLevel()
    if lv > lastLv and lastLv ~= 0 then
        _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "MainSiegeViewLv", lv)
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_listlevup_once, self.go_table.obj_efBg)
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_jiantou_loop, self.go_table.obj_efJiantou)
    end
    self.go_table.aortext_level.text = _G.LangUtil.GetLangPackValue(90026500003, lv)
    self.go_table.aortext_DialogueContent.text = _G.LangUtil.GetLangPackValue(90026500004, lv)
end
---刷新界面
function MainSiegeView:UpdateView()
    self:SetLevel()
    if self.rank_cl then
        self.rank_cl:Refresh(self:GetSelfRankData())
    end
end
---测试进入布阵
function MainSiegeView:EneterEmbattle()
    if _G.AppSetting.DEBUG then
        _G.Log("进入战斗", "怪物攻城")
    end
    self.activity.typeClass:EnterEmbattle()
end

-----------------------  摇杆 ---------------------------
function MainSiegeView:BindDrag()
    _G.CS.WorldTouch.OnDragBegin = function()
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_rect, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.rect_bg, true)
        _G.Events:GetInstance():Broadcast(_G.eNav.NavInterruptMove, self.PlayerUid)
        self.CurrentWorld.WorldPlayer:SetClickTarget()
        self.CurrentWorld.WorldPlayer:NavInterruptMove()
        self.CurrentWorld.WorldPlayer:Move(1)
    end

    _G.CS.WorldTouch.OnDragEnd = function()
        self:InitMoveCtrl()
    end

    _G.CS.WorldTouch.OnDragMove = function()
        self.rect:SetEulerAngles(0, 0, -self.MoveCtrl.TouchAngle)
        self.CurrentWorld.WorldPlayer:SetDirection(self.MoveCtrl.TouchAngle)
    end
end
function MainSiegeView:InitMoveCtrl()
    self.rect:SetEulerAngles(0, 0, 0)
    _G.GameUtil.SetActiveByCondition(self.go_table.rect_bg, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_rect, true)
    self.CurrentWorld.WorldPlayer:NavInterruptMove()
end
return MainSiegeView
