local MonsterSiegeRankAward = _G.BaseClass("MonsterSiegeRankAward", _G.UIBaseView)

function MonsterSiegeRankAward:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MonsterSiegeRankAward:OnCreate()
    self.active = require "MonsterSiegeManager":GetInstance():GetActivity()
    self:InitToggle()
    self.go_table.toggle_rank.isOn = true
end
function MonsterSiegeRankAward:InitToggle()
    self.Toggles = {}
    self.Toggles["Rank"] =
        _G.GetAutoGoTable(
        self.go_table.toggle_rank,
        _G.handlerbind(self, self.OnToggle, "Rank", _G.handler(self, self.SelcetRankData))
    )
    self.Toggles["Reward"] =
        _G.GetAutoGoTable(
        self.go_table.toggle_reward,
        _G.handlerbind(self, self.OnToggle, "Reward", _G.handler(self, self.SelcetRankData))
    )
end
---点击Togggle
function MonsterSiegeRankAward:OnToggle(go, isOn, key, call)
    local tb = self.Toggles[key]
    local num = 1
    if key == "Rank" then
        num = 1
    else
        num = 2
    end
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOff, not isOn)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, isOn)
    if call then
        call(isOn, num)
    end
end

---按钮点击事件在这里派发
function MonsterSiegeRankAward:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

