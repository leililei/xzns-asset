---@class MainSiegeEmbattleView : UIBaseView	中文描述
---@field public go_table MainSiegeEmbattleView GoTable
local MainSiegeEmbattleView = _G.BaseClass("MainSiegeEmbattleView", _G.UIBaseView)

function MainSiegeEmbattleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
---界面的入口函数
---@param type_enum number 1 = 死魂塔 2 = 恶灵入侵
function MainSiegeEmbattleView:OnCreate(embattleType, exitCall, battleCall, flagQiCe, isRandom_buff, skipBattle)
    self.activie = require "MonsterSiegeManager":GetInstance():GetActivity()
    self.onExitCall = exitCall
    self.embattleType = embattleType
    self.onBattleCall = battleCall
    ---是否启用跳过战斗
    ---@type boolean
    self.skipBattle = skipBattle or false
    self:OpenEmbattleView()
    self.go_table.aorbtn_qice:SetActiveE(flagQiCe and 1 or 0)
    if flagQiCe then
        if isRandom_buff then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MonsterSiegeGetRelicView.Name)
        end
        self.go_table.aorbtn_qice:DOLocalMoveY(0, 0.5):SetEase(_G.CS.DG.Tweening.Ease.Linear)
        self.go_table.aorimage_qice:DOFade(1, 0.5)
        ---boss关显示观众
        self:ShowAudience()
    end
end
function MainSiegeEmbattleView:ShowAudience()
    local data = self.activie.typeClass:GetAudienceData()
    require "BattleDamageRankManager":GetInstance():InitData(data)
    require "BattleAudienceManager":GetInstance():InitData(data)
    require "BattleAudienceManager":GetInstance():ShowAudience()
end

function MainSiegeEmbattleView:OnDestroy()
    self.onExitCall = nil
    self.onBattleCall = nil
end

function MainSiegeEmbattleView:OpenEmbattleView()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpenedSiege, self)
    local embattleType = _G.EmbattleType.MonsterSiege
    local groupId = _G.ConfigManager.discrete_cfg[106507][1][1]
    local data = require "MonsterSiegeManager":GetInstance():OpenEmMonsterData()
    require("EmbattleController"):GetInstance():OpenEmbattle(
        embattleType,
        _G.EmbattleSaveType.server,
        false,
        _G.EmbattleControllerItemType.MonsterSiege,
        _G.handler(self, self.OnExitCall),
        _G.handler(self, self.OnBattleCall),
        groupId,
        data,
        self.skipBattle
    )
end

function MainSiegeEmbattleView:OnExitCall()
    self:Close()
    if self.onExitCall then
        self.onExitCall()
        self.onExitCall = nil
    end
end
function MainSiegeEmbattleView:OnBattleCall(...)
    if self.onBattleCall then
        self.onBattleCall(...)
        self.onBattleCall = nil
    end
end

function MainSiegeEmbattleView:OnEmbattleViewOpenedSiege(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
        local embattleView = _G.UIManager:GetInstance():GetWindowCtrl(name)
        embattleView:SetEffLoadCall(
            function()
                if self.go_table then
                    self.go_table.aorbtn_qice:DOLocalMoveY(-100, 0.5):SetEase(_G.CS.DG.Tweening.Ease.Linear)
                end
            end
        )
    end
end
function MainSiegeEmbattleView:OnClickBtn(go)
    if go == self.go_table.aorbtn_qice1 then
        local buff_list = self.activie.typeClass:GetBuffList()
        local data = {
            params = buff_list
        }
        local cardteams = _G.StorageManager:GetInstance():GetCardDataSortList()
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.DungonesRelicView.Name,
            data.params,
            true,
            cardteams,
            true
        )
    end
end
return MainSiegeEmbattleView
