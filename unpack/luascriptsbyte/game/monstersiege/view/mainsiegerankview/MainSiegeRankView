---@class MainSiegeRankView : Component	个人积分排行,公会积分排行
---@field go_table _obj_RankPanel._obj_rank_GoTable
local MainSiegeRankView = _G.BaseClass("MainSiegeRankView", _G.Component)
local rankEnum = {
    player = 1,
    guild = 2
}
local LangUtil = _G.LangUtil
local UIUtils = _G.UIUtils
---创建对象时,入口构造函数
function MainSiegeRankView:OnCreate(obj, activie)
    self.gameObject = obj
    self.transform = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.Animator = obj:GetParent():GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    self.rank_type = rankEnum.player
    self.rank_btn_obj = {
        [rankEnum.player] = self.go_table.obj_btn_1,
        [rankEnum.guild] = self.go_table.obj_btn_2
    }
    self.activity = activie
    self:Show()
    self:AddListener(_G.eSociatyEvent.BeKicked, self.UpdateGuild)
    self:AddListener(_G.eMonsterSiege.RefreshRank, self.RefreshRank)
end

function MainSiegeRankView:UpdateGuild()
    if self.rank_type == rankEnum.guild then
        self.activity.typeClass:RankGuild(
            function()
                self:SetShowRankInfo(rankEnum.guild)
            end
        )
    end
end
---更新排行榜
function MainSiegeRankView:RefreshRank()
    _G.DelayDo(
        2,
        function()
            if _G.IsNil(self.gameObject) then
                return
            end
            if self.rank_type == rankEnum.guild then
                self.activity.typeClass:RankGuild(
                    function()
                        self:SetShowRankInfo(rankEnum.guild, true)
                    end
                )
            else
                self.activity.typeClass:RankPlayerGongXZiang(
                    function()
                        self:SetShowRankInfo(rankEnum.player, true)
                    end
                )
            end
        end
    )
end

---销毁对象时,析构函数
function MainSiegeRankView:OnDestroy()
end
function MainSiegeRankView:Show()
    self:SetMingziInfo()
    self:SetRankData()
end
function MainSiegeRankView:UpdateRank()
    self:SetShowRankInfo(rankEnum.player)
    self.rank_type = rankEnum.player
    self:Show()
end
---按钮点击事件在这里派发
function MainSiegeRankView:OnClickBtn(go)
    if go == self.go_table.aorbtn_yq_1 then
        --个人积分排行
        self.activity.typeClass:RankPlayerGongXZiang(
            function()
                self:SetShowRankInfo(rankEnum.player)
            end
        )
    elseif go == self.go_table.aorbtn_yq_2 then
        --公会积分排行
        self.activity.typeClass:RankGuild(
            function()
                --("公会积分排行")
                self:SetShowRankInfo(rankEnum.guild)
            end
        )
    elseif go == self.go_table.aorbtn_closeLeft then
        self:MovePanel(false)
    elseif go == self.go_table.aorbtn_openLeft then
        self:MovePanel(true)
    end
end
function MainSiegeRankView:MovePanel(flag)
    -- local num = 0
    -- if flag then
    --     num = 638
    -- else
    --     num = 270
    -- end
    -- self.go_table.gameObject:DOLocalMoveX(
    --     num,
    --     1,
    --     function()
    --         self.go_table.aorbtn_closeLeft:SetActiveE(flag and 1 or 0)
    --         self.go_table.aorbtn_openLeft:SetActiveE((not flag) and 1 or 0)
    --     end
    -- )
    local animClipName = flag and "a_LefetPanel_open" or "a_LefetPanel_close"
    _G.Events:GetInstance():AddListener(_G.AnimationEvents.SiegeRankAnim, self.ViewAnimationFinish, self)
    self.go_table.obj_ShowPanel:SetActiveE(flag and 1 or 0)
    self.go_table.obj_hideRank:SetActiveE((not flag) and 1 or 0)
    if flag then
        self.activity.typeClass:RankPlayerGongXZiang(
            function()
                self:SetShowRankInfo(rankEnum.player, true)
            end
        )
    end
    self.Animator:Play(animClipName)
end

function MainSiegeRankView:ViewAnimationFinish()
    self.go_table.obj_ShowPanel:SetActiveE(0)
    self.go_table.obj_ShowPanel:SetActiveE(1)
    _G.Events:GetInstance():RemoveListener(_G.AnimationEvents.SiegeRankAnim, self.ViewAnimationFinish, self)
    --self.go_table.scrollloopvectical_boxList:AddLocalPosition(0,-20,0)
end
---标题
function MainSiegeRankView:SetMingziInfo()
    if self.rank_type == rankEnum.player then
        self.go_table.aortext_name.text = LangUtil.GetLangPackValue(90028300078)
    else
        self.go_table.aortext_name.text = LangUtil.GetLangPackValue(90028300079)
    end
end
---设置点击得button
function MainSiegeRankView:SetRankBtn(flag)
    local tb = _G.GetAutoGoTable(self.rank_btn_obj[self.rank_type])
    tb.obj_nor:SetActiveE(flag and 1 or 0)
    tb.obj_gray:SetActiveE((not flag) and 1 or 0)
end
---设置排行榜数据
function MainSiegeRankView:SetRankData()
    if self.rank_type == rankEnum.player then
        self.rank_lists_player = self.activity.typeClass.all_rank_player_jifen or {}
        self.go_table.scrollloopvectical_rank:SetActiveE(1)
        self.go_table.scrollloopvectical_rank_Guild:SetActiveE(0)
        self.go_table.obj_rank_guild:SetActiveE(0)
        self.go_table.obj_rankplayer:SetActiveE(1)
        self:InitPlayer()
        self:SetRankScrollPlayer()
        self:CheckNothing(self.rank_lists_player)
    else
        self.go_table.scrollloopvectical_rank:SetActiveE(0)
        self.go_table.scrollloopvectical_rank_Guild:SetActiveE(1)
        self.go_table.obj_rank_guild:SetActiveE(1)
        self.go_table.obj_rankplayer:SetActiveE(0)
        self.rank_lists_guild = self.activity.typeClass.guidlRank_lists or {}
        self:InitGuildRank()
        self:SetRankScrollGuild()
        self:CheckNothing(self.rank_lists_guild)
    end
end
---设置视图
function MainSiegeRankView:SetRankScrollPlayer()
    if self.rank_type == rankEnum.player then
        if self.p_Scroll == nil then
            self.go_table.scrollloopvectical_rank:InitItemData(
                #self.rank_lists_player,
                _G.handler(self, self.RefreshPlayerRank)
            )
            self.p_Scroll = self.go_table.scrollloopvectical_rank
        else
            self.go_table.scrollloopvectical_rank:UpdateCount(#self.rank_lists_player)
        end
    end
end
function MainSiegeRankView:SetRankScrollGuild()
    if self.rank_type == rankEnum.guild then
        if self.p_Scroll_guild == nil then
            self.go_table.scrollloopvectical_rank_Guild:InitItemData(
                #self.rank_lists_guild,
                _G.handler(self, self.RefreshGuildRank)
            )
            self.p_Scroll_guild = self.go_table.scrollloopvectical_rank_Guild
        else
            self.go_table.scrollloopvectical_rank_Guild:UpdateCount(#self.rank_lists_guild)
        end
    end
end
----------------------------------  个人积分  -------------------------------
function MainSiegeRankView:InitPlayer()
    local playerdata = self.activity.typeClass:GetPlayerJifen()
    local tb = _G.GetAutoGoTable(self.go_table.obj_rankplayer)
    self:SetDataPlayerScorll(tb, playerdata, playerdata.player_mingci)
end
function MainSiegeRankView:SetDataPlayerScorll(tb, data, ind)
    ---名词
    ---clear
    tb.aorimage_rank:SetActiveE(0)
    tb.aortext_rank.text = ""
    if tb.aortext_no then
        tb.aortext_no.text = ""
    end
    if tb.obj_selfplayer then
        tb.obj_selfplayer:SetActiveE(0)
    end

    if data.player_mingci == 0 then
        tb.aortext_rank.text = "" --_G.LangUtil.GetLangPackValue(90022900040)
    elseif data.player_mingci <= 3 then
        tb.aorimage_rank.SpriteName = "tz_qjhs_phb_mingci_0" .. ind
        tb.aorimage_rank:SetActiveE(1)
    else
        tb.aortext_rank.text = data.player_mingci
        if tb.obj_selfplayer then
            tb.obj_selfplayer:SetActiveE(1)
        end
    end
    if tb.aortext_no and data.player_mingci == 0 then
        tb.aortext_no.text = LangUtil.GetLangPackValue(90026500029)
    end
    tb.aortext_name.text = data.playerName
    tb.aortext_power.text = _G.GameUtil.NumberToUnitStrBag(data.params)
    tb.aortext_value.text = data:GetDamage()
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase,data,1,true,true)
end
function MainSiegeRankView:RefreshPlayerRank(index, obj)
    if index < 0 then
        return
    end
    local ind = index + 1
    local tb = _G.GetAutoGoTable(obj)
    local data = self.rank_lists_player[ind]
    self:SetDataPlayerScorll(tb, data, ind)
end
------------------------------------ 公会积分 ---------------------------
function MainSiegeRankView:RefreshGuildRank(index, obj)
    if index < 0 then
        return
    end
    local ind = index + 1
    local tb = _G.GetAutoGoTable(obj)
    local data = self.rank_lists_guild[ind]
    self:SetDataGuildScorll(tb, data, ind)
end
function MainSiegeRankView:SetDataGuildScorll(tb, data, ind)
    tb.aorimage_rank:SetActiveE(0)
    tb.aortext_rank.text = ""
    --清空数据
    if tb.aortext_no1 then
        tb.aortext_no1.text = ""
    end
    if tb.aortext_no then
        tb.aortext_no.text = ""
    end
    if tb.obj_selfGuild then
        tb.obj_selfGuild:SetActiveE(0)
    end
    --tb.aortext_no.text = ""
    if data.mingci == 0 then
        if tb.aortext_no1 then
            tb.aortext_no1.text = LangUtil.GetLangPackValue(90026100008)
        end
    elseif data.mingci == -1 then -- 有公会未上榜
        tb.aortext_no.text = ""
        if tb.aortext_no then
            tb.aortext_no.text = LangUtil.GetLangPackValue(90026500029)
        end
    elseif data.mingci <= 3 then
        tb.aorimage_rank.SpriteName = "tz_qjhs_phb_mingci_0" .. ind
        tb.aorimage_rank:SetActiveE(1)
    else
        tb.aortext_rank.text = data.mingci
        if tb.obj_selfGuild then
            tb.obj_selfGuild:SetActiveE(1)
        end
    end

    tb.aortext_value.text = data.num --贡献值
    tb.aortext_name.text = data.name
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase,data,1,true,true)
end
function MainSiegeRankView:InitGuildRank()
    local guild = self.activity.typeClass:GetGuildSelf()
    local tb = _G.GetAutoGoTable(self.go_table.obj_rank_guild)
    self:SetDataGuildScorll(tb, guild, guild.mingci)
end
---检测是否显示数据
function MainSiegeRankView:CheckNothing(rankdata)
    local flag = false
    if _G.table.isEmptyOrNil(rankdata) then
        flag = true
    end
    self.go_table.obj_nothing:SetActiveE(flag and 1 or 0)
end
---显示 排行信息
---@param enum number 1 = 个人积分排行，2公会积分
---@param isForce boolean 是否强制设置
function MainSiegeRankView:SetShowRankInfo(enum, isForce)
    if not isForce and self.rank_type == enum then
        return
    end
    self:SetRankBtn(false)
    self.rank_type = enum
    self:SetRankBtn(true)
    self:Show()
end

return MainSiegeRankView
