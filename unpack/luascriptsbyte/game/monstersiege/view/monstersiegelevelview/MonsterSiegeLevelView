---@class MonsterSiegeLevelView : UIBaseView	中文描述
---@field public go_table MonsterSiegeLevelView_GoTable GoTable
---@field activity ActivitySynBase
---@field activityCls MonsterSiegeModel
local MonsterSiegeLevelView = _G.BaseClass("MonsterSiegeLevelView", _G.UIBaseView)
--_G.MonsterSiegeLevelView = MonsterSiegeLevelView
local ImagePath = {
    "ImagesH5/hmementos/shushendekuizeng",
    "ImagesH5/hmementos/shengmingzhihua",
    "ImagesH5/hmementos/huimiezhichui",
    "ImagesH5/hmementos/posuizhiji",
    "ImagesH5/hmementos/rongyaojufu"
}
function MonsterSiegeLevelView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---
function MonsterSiegeLevelView:OnCreate(activity)
    self.activity = activity
    self.activityCls = self.activity:GetActivityTypeCls()
    self.lv = self.activityCls:GetLevel()
    self.go_table.scrollloophorizontal_List:InitItemData(5, _G.handler(self, self.RefreshLevelItem))
end

function MonsterSiegeLevelView:RefreshLevelItem(index, obj)
    if index < 0 then
        return
    end
    ---@type MonsterSiegeLevelView._obj_levelItem_GoTable
    local tb = _G.GetAutoGoTable(obj)
    local newIndex = index + 1
    tb.aorrawimage_icon:LoadImage(ImagePath[newIndex])
    if newIndex > self.lv then
        tb.aorimage_bg1:SetGray(true)
        tb.aorimage_bg2:SetGray(true)
        tb.aortext_desc.text =_G.GetLangPackValue(90026500036,newIndex)
        tb.aortext_lock.text = _G.GetLangPackValue(90026500034)
    else
        tb.aorimage_bg1:SetGray(false)
        tb.aorimage_bg2:SetGray(false)
        tb.aortext_desc.text = _G.GetLangPackValue(90026500033)
        tb.aortext_lock.text = _G.GetLangPackValue(90026500035)
    end
    tb.aortext_name.text = _G.GetLangPackValue(90026500014) .. "·" .. _G.GameUtil.NumberToChinese(newIndex)
end

---按钮点击事件在这里派发
function MonsterSiegeLevelView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close1 then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

return MonsterSiegeLevelView
