---@field rewardList_Reward BaseAwardNewItem[]
local MonsterSiegeRankView = _G.BaseClass("MonsterSiegeRankView", _G.UIBaseView)
--_G.Dungeons_boos_rank = Dungeons_boos_rank
local GetLangPackValue = _G.GetLangPackValue
local rankEffect = {
    "Ef_ArenaTop1",
    "Ef_ArenaTop2",
    "Ef_ArenaTop3"
}
local UIUtils = _G.UIUtils
function MonsterSiegeRankView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.model = require "DungonesModel":GetInstance()
    self.activie = require "MonsterSiegeManager":GetInstance():GetActivity()
    self.itemList = {}
end

---界面的入口函数
function MonsterSiegeRankView:OnCreate()
    self.RewardDatas = self.activie.typeClass:GetRankRewardPersonData()
    self:InitToggle()
    if self.go_table.toggle_zoneRank:GetActiveSelf() == 1 then
        self.go_table.toggle_zoneRank.isOn = true
    else
        self.go_table.toggle_rank.isOn = true
    end
end

function MonsterSiegeRankView:InitToggle()
    self.Toggles = {}
    self.Toggles["Rank"] =
        _G.GetAutoGoTable(
        self.go_table.toggle_rank,
        _G.handlerbind(self, self.OnToggle, "Rank", _G.handler(self, self.OnRank))
    )
    self.go_table.toggle_reward:SetActiveE(0)
    if require "ZoneRankModel":GetInstance():CheckIsOpen(_G.ZoneRankType.MonsterSiege) then
        self.go_table.toggle_zoneRank:SetLocalPosition(16, -51, 0)
        self.go_table.toggle_zoneRank:SetActiveE(1)
        self.Toggles["ZoneRank"] =
            _G.GetAutoGoTable(
            self.go_table.toggle_zoneRank,
            _G.handlerbind(self, self.OnToggle, "ZoneRank", _G.handler(self, self.OnZoneRank))
        )
    else
        self.go_table.toggle_zoneRank:SetActiveE(0)
    end
    self.go_table.toggle_rank:SetActiveE(
        require "ZoneRankModel":GetInstance():CheckIsShowSingle((_G.ZoneRankType.MonsterSiege)) and 1 or 0
    )
end
---点击Togggle
function MonsterSiegeRankView:OnToggle(go, isOn, key, call)
    local tb = self.Toggles[key]
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOff, not isOn)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, isOn)
    if call then
        call(isOn)
    end
end

---刷新排行显示
---@param listView2 SuperScrollView.LoopListView2
function MonsterSiegeRankView:RefrshItem(listView2, index)
    local newIndex = index + 1
    local item = listView2:NewListViewItem("$_obj_ListItem")
    local instance = item:GetInstanceIDE()
    if not self.itemList[instance] then
        self.itemList[instance] = _G.GetAutoGoTable(item, _G.handler(self, self.OnClickAward))
        self.itemList[instance].itemList = {}
        self.itemList[instance].itemCount = 0
    end
    local tb = self.itemList[instance]
    local data = self.cfg[newIndex]
    tb.aorimage_rankIcon:DisposeChildren()
    if data.min_rank <= 3 and data.min_rank == data.max_rank then
        _G.GameUtil.SetActiveByCondition(tb.aorimage_rankIcon, true)
        tb.aortext_rankItem.text = ""
        tb.aorimage_rankIcon.SpriteName = "uui_tz_maoxian_shd_paiming" .. data.min_rank
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg[rankEffect[data.min_rank]], tb.aorimage_rankIcon)
    else
        _G.GameUtil.SetActiveByCondition(tb.aorimage_rankIcon, false)
        tb.aortext_rankItem.text = GetLangPackValue(90022500407, data.min_rank, data.max_rank)
    end
    local count = #data.reward_daily
    local curItemCount = tb.itemCount
    if count > curItemCount then
        for i = curItemCount + 1, count do
            _G.ItemFactory:GetInstance():GetItemCard(
                _G.ItemFactory.itemType.ItemBaseWiFthCount,
                tb.trans_content,
                function(tran)
                    tb.itemCount = tb.itemCount + 1
                    tb.itemList[i] = item
                    tran:Show(data.reward_daily[i][1], nil, data.reward_daily[i][2])
                end
            )
        end
    else
        for i = 1, curItemCount do
            if i <= count then
                _G.GameUtil.SetActiveByCondition(tb.itemList[i].go_table.gameObject, true)
                tb.itemList[i]:Show(data.reward_daily[i][1], nil, data.reward_daily[i][2])
            else
                _G.GameUtil.SetActiveByCondition(tb.itemList[i].go_table.gameObject, false)
            end
        end
    end
    return item
end

---大区排行
function MonsterSiegeRankView:OnZoneRank(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_ZoneRank, isOn)
    if not isOn then
        return
    end
    if not self.ZoneRank then
        local name = "UI/ZoneRank/$_obj_zoneRank"
        _G.PoolsManager:GetInstance():Spawn(
            name,
            _G.ePoolType.Temporary,
            self.go_table.obj_ZoneRank,
            function(trans)
                _G.GameUtil.SetActiveByCondition(trans, true)
                local view = self:AddComponent(trans.gameObject, require "ZoneRankView".New(trans, self))
                view:InitView(_G.ZoneRankType.MonsterSiege, self.activie:GetActivityID())
                self.ZoneRank = view
            end
        )
    end
end

---排行
function MonsterSiegeRankView:OnRank(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Rank, isOn)
    if not isOn then
        return
    end
    if not self.Rank then
        self.Rank = _G.GetAutoGoTable(self.go_table.obj_Rank)
        _G.GameUtil.SetActiveByCondition(self.Rank.aortext_yiwu, true)
        self.Rank.aortext_yiwu.text = _G.LangUtil.GetLangPackValue(90026500014)
        self.rankDatas = self.activie.typeClass.rank_all_player or {}
        self.rankList = {}
        self.rewardList_Rank = {}
        self.Rank.scrollloopvectical_rankList:InitItemData(#self.rankDatas, _G.handler(self, self.RefreshRank))
        _G.GameUtil.SetActiveByCondition(self.Rank.obj_no, #self.rankDatas <= 0)
        self:InitPlayer()
    end
end

function MonsterSiegeRankView:UpdateView()
    if self.Rank then
        self.rankDatas = self.activie.typeClass.rank_all_player or {}
        self.rankList = {}
        self.rewardList_Rank = {}
        self.Rank.scrollloopvectical_rankList:UpdateCount(#self.rankDatas)
        _G.GameUtil.SetActiveByCondition(self.Rank.obj_no, #self.rankDatas <= 0)
        self:InitPlayer()
    end
end
function MonsterSiegeRankView:HeadClick(go, ref, tb)
    local data = tb.rankData
    local name = go:GetName()
    if name == "@_aorbtn_HeadClick" then
        if data.uid and data.uid > 0 then
            if data.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.PopWindowManager:GetInstance():ShowAllTips(620109)
            else
                _G.SystemSettingManager:GetInstance():OpenView(data.uid, 600)
            end
        end
    elseif name == "@_aorbtn_qice" then
        if data.uid and data.uid > 0 then
            if data.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                local cardteams = _G.StorageManager:GetInstance():GetCardDataSortList()
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.DungonesRelicView.Name,
                    data.params,
                    true,
                    cardteams,
                    true
                )
            else
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.DungonesRelicView.Name,
                    data.params,
                    true,
                    data.teamcards,
                    true
                )
            end
        end
    elseif name == "@_aorbtn_huifang" then
        --- 70 = 恶灵入侵
        require "DungonesModel":GetInstance():PlayRankHuiFang(70, data.uid)
    end
end
---刷新排行
function MonsterSiegeRankView:RefreshRank(index, obj)
    local newindex = index + 1
    local instanceID = obj:GetInstanceIDE()
    local tb1 = self.rankList[instanceID]
    if not self.rankList[instanceID] then
        tb1 = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.HeadClick, tb1))
        self.rankList[instanceID] = tb1
    end
    local tb = self.rankList[instanceID]
    local data = self.rankDatas[newindex]
    tb.rankData = data

    tb.aorbtn_qice:SetActiveE(1)
    tb.aorbtn_yiwu:SetActiveE(0)

    --tb.data = self:GetRankData(newindex)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_rankBg, newindex <= 3)
    _G.GameUtil.SetActiveByCondition(tb.obj_rankBg2, newindex > 3)
    if data.player_mingci <= 3 then
        tb.aorimage_rankBg.SpriteName = "tz_qjhs_di_0" .. (newindex + 1)
        tb.aorimage_rank.SpriteName = "tz_qjhs_phb_mingci_0" .. newindex
    else
        tb.aortext_rankNum.text = data.player_mingci
    end
    tb.aortext_name.text = data.playerName
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data, 1, true, true)
    tb.aortext_damage.text = _G.GameUtil.NumberToUnitStr(data.Damage)
    if not tb.list then
        tb.list = {}
    end
    self:ShowTeam(tb.trans_cardnode, data)
end
function MonsterSiegeRankView:ShowTeam(parent, data)
    if parent:GetChildCountE() > 0 then
        for i = 1, parent:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(parent:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    local teamcard = data:GetTeamCard()
    if teamcard then
        for i = 1, 5 do
            if teamcard[i] then
                local data = teamcard[i]
                _G.ItemCardFactory:GetInstance():GetItemCard(
                    _G.ItemCardFactory.itemCardType.ItemCardStorageView,
                    parent,
                    function(item)
                        item:Show(data.sid, nil, data.star, data.soulLink_lv, data.lv, data.uid, true, data.soulLink_IsActivate, data.open_inborn)
                    end
                )
            end
        end
    end
end

function MonsterSiegeRankView:ShowAward(tb, obj, award, parent)
    if not tb.list then
        tb.list = {}
    end
    local count = #tb.list
    local count2 = #award
    for i = 1, count do
        if i <= count2 then
            tb.list[i]:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(award[i]))
            _G.GameUtil.SetActiveByCondition(tb.list[i].gameObject, true)
        else
            _G.GameUtil.SetActiveByCondition(tb.list[i].gameObject, false)
        end
    end
    if count < count2 then
        for i = count + 1, count2 do
            local obj2 = _G.InstantiateObject(obj)
            obj2:SetParentE(tb.trans_Content)
            local item = require "BaseAwardNewItem".New(obj2, nil, 73, obj2:GetChildE(0))
            tb.list[i] = item
            local data = award[i]
            item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
        end
    end
end

function MonsterSiegeRankView:GetRankData(index)
    if index <= 0 then
        return nil
    end
    for _, v in ipairs(self.RewardDatas) do
        if index >= v.min_rank and index <= v.max_rank then
            return v
        end
    end
    return nil
end

---显示玩家排行
function MonsterSiegeRankView:InitPlayer()
    self.playerRank = self.activie.typeClass:GetPlayerSelf()
    if not self.player then
        self.player =
            _G.GetAutoGoTable(
            self.Rank.obj_player,
            _G.handlerbind(self, self.HeadClick, {rankData = {uid = _G.PlayerModel:GetInstance():GetPlayerUid()}})
        )
    end
    local tb = self.player
    local newindex = self.playerRank.player_mingci
    tb.data = self:GetRankData(newindex)
    if newindex == 0 then
        tb.aortext_rankNum.text = GetLangPackValue(90022900040)
        local dps = self.activie.typeClass:GetDps()
        tb.aortext_damage.text = _G.GameUtil.NumberToUnitStr(dps)
    else
        tb.aortext_rankNum.text = newindex
        tb.aortext_damage.text = _G.GameUtil.NumberToUnitStr(self.playerRank.Damage)
    end
    tb.aortext_name.text = _G.PlayerModel:GetInstance():GetName()
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, self.playerRank, 1, true, true)
    if tb.data then
        self:ShowAward(tb, tb.obj_item, tb.data.rewards, tb.obj_item:GetChildE(0))
    else
        self:ShowAward(tb, tb.obj_item, {}, tb.obj_item:GetChildE(0))
    end
end
---刷新奖励
function MonsterSiegeRankView:RefreshReward(index, obj, list, tb)
    local newIndex = index + 1
    local instanceID = obj:GetInstanceIDE()
    local data = tb.data.reward_daily[newIndex]
    local item = list[instanceID]
    if not item then
        item = require "BaseAwardNewItem".New(obj, _G.handler(self, self.OnClickAward), 73, obj)
        list[instanceID] = item
    end
    item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))
end
---按钮点击事件在这里派发
function MonsterSiegeRankView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

return MonsterSiegeRankView
