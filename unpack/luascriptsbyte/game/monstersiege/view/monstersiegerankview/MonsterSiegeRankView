---@class Dungeons_boos_rank : UIBaseView	中文描述
---@field public go_table WorldBossRankView_GoTable GoTable
---@field cfg boss_rank_cfg
---@field itemList Dungeons_boos_rank._obj_ListItem_GoTable[]
---@field Toggles Dungeons_boos_rank._toggle_rank_GoTable[]
---@field Rank Dungeons_boos_rank._obj_Rank_GoTable
---@field Reward  Dungeons_boos_rank._obj_Reward_GoTable
---@field rankList _obj_Rank._obj_rankItem_GoTable[]
---@field rewardList _obj_Rank._obj_rankItem_GoTable[]
