local base = require("BaseGameNet")

---@class MonsterSiegeNet : BaseGameNet	通信协议
local MonsterSiegeNet = _G.BaseClass("MonsterSiegeNet", base)
---@return MonsterSiegeNet MonsterSiegeNet
function MonsterSiegeNet:GetInstance()
    return base.GetInstance(self)
end

---完成任务
---输入：c2s_activity_siege_finish
function MonsterSiegeNet:FinishTask(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_module_finish
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallReceive))
    self.Call[port] = callback
end
---随机buff
function MonsterSiegeNet:RandomBuff(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_module_buff
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallReceive))
    self.Call[port] = callback
end

---挑战
function MonsterSiegeNet:SiegeFight(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_module_fight
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallReceive))
    self.Call[port] = callback
    return port
end
---排行信息 (公会贡献排行榜)
function MonsterSiegeNet:RankGuild(callback)
    local pbData = {page = 1}
    local item = _G.ConfigManager.net_map.game_rank_rank_guild_siege
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallReceive))
    self.Call[port] = callback
end

