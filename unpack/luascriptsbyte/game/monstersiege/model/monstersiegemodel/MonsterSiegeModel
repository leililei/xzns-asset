function MonsterSiegeModel:SetPaomadeng()
    for _, v in pairs(self.rank_all_player) do
        if self.old_all_playes[v:GetPalyerUid()] then
            if self.old_all_playes[v:GetPalyerUid()]:GetPlayermingCi() > v:GetPlayermingCi() then
                self.old_all_playes[v:GetPalyerUid()] = v
                _G.table.insert(self.msg_paoma, v)
            end
        else
            self.old_all_playes[v:GetPalyerUid()] = v
            _G.table.insert(self.msg_paoma, v)
        end
    end
end

