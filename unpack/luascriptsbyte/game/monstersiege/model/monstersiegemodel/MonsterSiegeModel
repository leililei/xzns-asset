    _G.CS.WechatGameCore.PlayerPrefs.SetInt(key, 0)
    MonsterSiegeManager:GetInstance():InitActivityClass(self.curActivityClass)
    self:UpdateRedpoint()
    --MonsterSiegeManager:GetInstance():EnterScence()
