---@param msg activity.i_activity_self_info 活动信息
function MonsterSiegeModel:InitDataSiege(msg)
    self.f_lv = msg.f_lv or 1 -- 集结等级 (已代表怪物的sid)
    require "MonsterSiegeTaskModel":GetInstance():initTaskAll(msg)
    self.buff_list = msg.buff_list or {} --已获取的buff
    self.coin_num = msg.coin_num or {} --活动币数量
    require "MonsterSiegeManager":GetInstance():Clear()
    require "MonsterSiegeManager":GetInstance():SetCoinActivity(msg.coin_num)
    --self.cards_team = msg.cards --动态怪数据
    self.dam = msg.dam --今日贡献
    self.guild_dam = msg.guild_dam --所在公会得贡献值(有公会才发)
    self.dps = msg.dps --今日最高伤害
    self.playerself = {}
    self.refreshNum = self.maxRefreshNum - msg.refresh_times
    self.random_buff_list = msg.random_buff_list or {}
    -- self:SetMonsterID(self.f_lv)
    local time = _G.TimeUtil.GetSixClockTimer()
    if time == 0 or _G.math.abs(86400 - time) <= 1 then
        if self.curActivityClass:GetCurActivityState() == require "ActivitySynManager".State.Close then
            return
        end
        self.timer =
            _G.TimerManager:GetInstance():GetTimer(
            60,
            self.TestGetInfo,
            self,
            true,
            false,
            true,
            function()
                _G.Events:GetInstance():Broadcast(_G.eMonsterSiege.RefreshRank)
            end
        )
        self.timer:Start()
    end
end
