---个人积分榜(所有数据信息)
function MonsterSiegeModel:RankPlayerGongXZiang(callback)
    local count = 2
    require "MonsterSiegeNet":GetInstance():RankPlayerGongXZiang(
        function(data)
            self.all_rank_player_jifen = {}
            self:SetAllRankJifen(data)
            count = count - 1
            if count <= 0 then
                if callback then
                    callback()
                end
            end
        end
    )
    require "MonsterSiegeNet":GetInstance():RankPlayerSelfGongXZiang(
        function(data)
            self.player_jifen_rank = nil
            count = count - 1
            local itemData = self:GetSelfRankData()
            local power = _G.StorageManager:GetInstance():GetPlayerPower()
            itemData:SetDamage(data.value)
            itemData:SetParams(power)
            itemData:SetPlayerMingCi(data.index)
            self:SetPlayerSelf(itemData, 2)
            if count <= 0 then
                if callback then
                    callback()
                end
            end
        end
    )
end

