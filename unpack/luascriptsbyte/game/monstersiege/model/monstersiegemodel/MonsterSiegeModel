---挑战
function MonsterSiegeModel:SiegeFight(call)
    local msg = {
        id = self:GetActivieID(),
        sid = self:GetMonsterID()
    }
    local port =
        require "MonsterSiegeNet":GetInstance():SiegeFight(
        msg,
        function(data)
            if call then
                call(data)
            end
        end
    )
    _G.BattleManager:GetInstance():AddLuaNetEvent(port)
end

---随机buff (在布阵后 ，战斗开始前，会有一个 buff 播放动画)
function MonsterSiegeModel:RandomBuff(call)
    if _G.table.isEmptyOrNil(self.random_buff_list) then
        local msg = {
            id = self:GetActivieID()
        }
        require "MonsterSiegeNet":GetInstance():RandomBuff(
            msg,
            function(data)
                if data.ack ~= 1 then
                    return
                end
                self.refreshNum = self.refreshNum - 1
                self.random_buff_list = data.buff_id
                self:EnterEmbattleView()
            end
        )
    else
        self:EnterEmbattleView()
    end
end
---刷新buff
function MonsterSiegeModel:RefreshBuff(call)
    local msg = {
        id = self:GetActivieID()
    }
    require "MonsterSiegeNet":GetInstance():RandomBuff(
        msg,
        function(data)
            if data.ack ~= 1 then
                if call then
                    call(false)
                end
                return
            end
            self.refreshNum = self.refreshNum - 1
            self.random_buff_list = data.buff_id
            if call then
                call(true)
            end
        end
    )
end
---获取刷新次数
function MonsterSiegeModel:GetRefreshNum()
    return self.refreshNum
end
---重置刷新次数
function MonsterSiegeModel:ResetRefreshNum()
    self.refreshNum = self.maxRefreshNum
end
---确认buff
function MonsterSiegeModel:EnterBuff(call)
    local msg = {
        id = self:GetActivieID()
    }
    require "MonsterSiegeNet":GetInstance():EnterBuff(
        msg,
        function(data)
            if data.ack ~= 1 then
                return
            end
            self.buff_list = self.random_buff_list
            self.random_buff_list = {}
            self:ResetRefreshNum()
            if call then
                call()
            end
        end
    )
end
return MonsterSiegeModel
