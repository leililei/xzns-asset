---查抄动态怪物的数据
---@param sid number 怪物sid
function MonsterSiegeModel:CheckMonsterDy(sid)
    local data = {}
    if self.cards_team then
        for i = 1, #self.cards_team do
            if self.cards_team[i].sid == sid then
                data = self.cards_team[i]
                return true, data
            end
        end
    end
    return false
end
function MonsterSiegeModel:OpenEmMonsterData()
    if self.cards_team == nil then
        if _G.AppSetting.DEBUG then
            _G.Log("动态怪的 数据是空 ", "怪物攻城")
        end
        return
    end
    local flag, data = self:CheckMonsterDy(self:GetMonsterID())
    local da = {}
    if flag then
        local team = data.cards[1].fights
        for i = 1, #team do
            if da[i] == nil then
                da[i] = {}
            end
            da[i] = {
                uid = team[i].uid,
                sid = team[i].sid,
                level = team[i].lv,
                star = team[i].star
            }
        end
    else
        local siege_cfg = _G.ConfigManager.siege_cfg[self:GetMonsterID()]
        local monsterid = _G.ConfigManager.guild_boss_cfg[siege_cfg.event_params[1]].monster
        local cardsid = _G.ConfigManager.monster_cfg[monsterid].CardID
        local level = _G.ConfigManager.monster_cfg[monsterid].Level
        local star = _G.ConfigManager.monster_cfg[monsterid].Stars
        da = {
            [1] = {
                uid = 0,
                sid = 0,
                level = 0,
                star = 0
            },
            [2] = {
                uid = 0,
                sid = 0,
                level = 0,
                star = 0
            },
            [3] = {
                uid = 0,
                sid = 0,
                level = 0,
                star = 0
            },
            [4] = {
                uid = 0,
                sid = 0,
                level = 0,
                star = 0
            },
            [5] = {
                uid = 0,
                sid = 0,
                level = 0,
                star = 0
            }
        }
        da[4] = {
            uid = monsterid,
            sid = cardsid,
            level = level,
            star = star
        }
    end

    return da
end
function MonsterSiegeModel:EnterEmbattleView()
    --是否满足跳过战斗开启条件
    local params = _G.ConfigManager.discrete_cfg[115602]
    local showSkipBattle = params and _G.GlobalConditionManager.CheckConditionArrays(params)

    local embattleType = _G.EmbattleType.MonsterSiege
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.MainSiegeEmbattleView.Name,
        embattleType,
        _G.handler(self, self.ExitEmbattle),
        function(_, _, _skipBattle)
            if _skipBattle then
                self:SkipFight()
            else
                self:EnterFight()
            end
        end,
        self:GetMonsterID() == bossid,
        self.isRandom_buff,
        showSkipBattle
    )
end
function MonsterSiegeModel:OnEmbattleViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.MainSiegeEmbattleView.Name then
        local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.MainSiegeView.Name)
        if window then
            window.View:Hide()
        end
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    end
end
---退出布阵
function MonsterSiegeModel:ExitEmbattle()
    if _G.AppSetting.DEBUG then
        _G.Log("退出布阵", "怪物攻城")
    end
    require "BattleAudienceManager":GetInstance():ClearAudiences()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.MainSiegeView.Name)
    if window then
        window.View:Show()
    end
end

---进入战斗
function MonsterSiegeModel:EnterFight()
    if _G.AppSetting.DEBUG then
        _G.Log("进入战斗", "怪物攻城")
    end
    _G.BattleManager:GetInstance():EnterFight(_G.BattleControllerType.MonsterSiege, self:GetDps())
end
---跳过战斗直接显示结算页面
---@return void
function MonsterSiegeModel:SkipFight()
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.MainSiegeEmbattleView.Name)
    local pbData = {
        id = self:GetActivieID(),
        sid = self:GetMonsterID()
    }
    _G.BattleManager:GetInstance():SetInBattle(true)
    require "MonsterSiegeNet":GetInstance():SiegeFight(
        pbData,
        function(msg)
            if not msg or msg.ack ~= 1 then
                _G.BattleManager:GetInstance():SetInBattle(false)
                return
            end
            --计算战斗结果
            _G.BattleManager:GetInstance():SetArgDataAutoCmd(msg.fight_arg)
            local record = _G.BattleManager:GetInstance():GetStatisticsRecord(msg.fight_arg)
            if not record or not record.result then
                _G.BattleManager:GetInstance():SetInBattle(false)
                return
            end

            ---@type BattleControllerMonsterSiege
            local controller = _G.require(_G.BattleControllerType.MonsterSiege).New()
            controller.curFightState = 4 --设置战斗结束

            _G.BattleManager:GetInstance():SetArgData(msg.fight_arg)
            _G.BattleManager:GetInstance():SetStatisticsCached(record)
            _G.BattleManager:GetInstance():SetBattleController(controller)
            --显示结算界面
            controller:FightResultFunc(record.result)
        end
    )
end

