---@param type number 1 战报,2 = 贡献值
function MonsterSiegeModel:SetRankAllPlayer(data, rankID, type, tb)
    local temp = data or {}
    if _G.table.isEmptyOrNil(temp) then
        return
    end
    local uid = _G.PlayerModel:GetInstance():GetPlayerUid()
    for i = 1, #temp do
        local d_temp = temp[i]
        if type and type == 2 then
            d_temp = temp[i].role_info
        end
        local itemData = RankItemData.New()
        itemData:Parse()
        itemData:SetTypeRankID(rankID) --榜单类型
        itemData:SetPlayerName(d_temp.name)
        itemData:Setplaye_level(d_temp.lv)
        itemData:SetPlayerFrame(d_temp.frame)
        itemData:SetPlayerHead(d_temp.portrait or d_temp.style)
        itemData:SetPlayerUid(d_temp.uid)
        if type and type == 2 then
            itemData:SetDamage(temp[i].num) --贡献值
            itemData:SetParams(d_temp.power)
        else
            itemData:SetDamage(d_temp.value)
            itemData:SetTeamCard(d_temp.sids[1].sids)
            itemData:SetParams(d_temp.params)
        end
        -- ZHJ-20337【客户端】恶灵入侵BOSS展示观众调整
        itemData:SetHaloSid(d_temp.halo)
        itemData:SetCityStyle(d_temp.city_style)
        itemData:SetSign(d_temp.title)
        itemData:SetisRank(true)
        itemData:SetPlayerMingCi(i)
        itemData:SetSnapShotTitle(d_temp.snapshot_title)
        itemData:SetSnapShotHalo(d_temp.snapshot_halo)
        if uid == d_temp.uid then
            itemData:SetIsMySelf(true)
            self:SetPlayerSelf(itemData, type)
        else
            itemData:SetIsMySelf(false)
        end
        _G.table.insert(tb, itemData)
    end
end

function MonsterSiegeModel:SetPlayerSelf(itemdata, type)
    if type and type == 2 then
        self.player_jifen_rank = itemdata
    else
        self.playerself = itemdata
    end
end
