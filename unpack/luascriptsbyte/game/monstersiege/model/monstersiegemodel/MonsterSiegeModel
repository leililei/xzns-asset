---检测排行的数据
function MonsterSiegeModel:CheckRankAward()
    local alltask = require "MonsterSiegeTaskModel":GetInstance().alltask
    local flag = false
    if alltask then
        for i = 1, #alltask do
            --任务未完成或未领取奖励
            if alltask[i]:GetAwardState() ~= 2 then
                flag = true
                break
            end
        end
    end
    return flag and 1 or 0
end
---检测逻辑 1、当活动开启时，入口界面的按钮有右上角出现红点，点击后消失
---2、活动持续时间内，每日时间刷新时，主界面右上角出现。点击进入后消失
function MonsterSiegeModel:CheckFirstLogin()
    local key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "monstersiege"
    if _G.CS.WechatGameCore.PlayerPrefs.HasKey(key) then
        if _G.CS.WechatGameCore.PlayerPrefs.GetInt(key) == 1 then
            return 1
        else
            return 0
        end
    else
        return 1
    end
end
