--ZHJ-20337【客户端】恶灵入侵BOSS展示观众调整
function MonsterSiegeModel:GetAudienceData()
    local audienceData = {}
    local data
    local proportion = _G.ConfigManager.discrete_cfg[106502]
    if #self.rank_all_player > 0 then
        local tempArray = _G.GlobalInterface.GetNewArray(self.rank_all_player)
        for i = #tempArray, 1, -1 do
            if tempArray[i]:GetPalyerUid() == _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.table.remove(tempArray, i)
            end
        end
        local num = #tempArray
        if num <= 3 then
            for i = 1, num do
                data = {}
                data.name = tempArray[i]:GetPlayerName()
                data.style = tempArray[i]:GetPlayerHeadSid()
                data.city_style = tempArray[i]:GetCityStyle()
                data.num = tempArray[i]:GetDamage()
                data.lv = tempArray[i]:GetPlayerLevel()
                data.halo = tempArray[i]:GetHaloSid()
                data.title = tempArray[i]:GetPlayerTitle()
                data.frame = tempArray[i]:GetCurFrameSid()
                _G.table.insert(audienceData, data)
            end
        else
            local one, two, three =
                Mathf.Ceil(num * proportion[1][1] / 10000),
                Mathf.Ceil(num * proportion[1][2] / 10000),
                Mathf.Floor(num * proportion[1][3] / 10000)
            local indexs = {Mathf.Random(1, one), Mathf.Random(one + 1, two), Mathf.Random(two + 1, three)}
            for i = 1, #indexs do
                data = {}
                data.name = tempArray[indexs[i]]:GetPlayerName()
                data.style = tempArray[indexs[i]]:GetPlayerHeadSid()
                data.num = tempArray[indexs[i]]:GetDamage()
                data.city_style = tempArray[i]:GetCityStyle()
                data.lv = tempArray[indexs[i]]:GetPlayerLevel()
                data.halo = tempArray[indexs[i]]:GetHaloSid()
                data.title = tempArray[indexs[i]]:GetPlayerTitle()
                data.frame = tempArray[indexs[i]]:GetCurFrameSid()
                _G.table.insert(audienceData, data)
            end
        end
    end
    if _G.table.isEmptyOrNil(audienceData) then
        return nil
    end
    return audienceData
end
