function MonsterSiegeModel:OnEnterActivity()
    if self.curActivityClass:GetCurActivityState() == 4 or self.curActivityClass:GetCurActivityState() == 1 then
        _G.GlobalInterface.JumpActivityByGM(10005, self.curActivityClass:GetJumpType())
        --_G.FloatTipsModel:GetInstance():Show("活动结算时间")
        return
    end
