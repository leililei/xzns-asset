---@param type number 1= 战报得排行，2 = 积分得排行
function MonsterSiegeModel:SetPlayer(type)
    local uid = _G.PlayerModel:GetInstance():GetPlayerUid()
    local frame = _G.PlayerModel:GetInstance():GetCurFrame()
    local level = _G.PlayerModel:GetInstance():GetLevel()
    local name = _G.PlayerModel:GetInstance():GetName()
    local portrait = _G.PlayerModel:GetInstance():GetRoleStyle()
    local title = _G.PlayerModel:GetInstance():GetTitle()
    local power = _G.StorageManager:GetInstance():GetPlayerPower()
    local itemData = RankItemData.New()
    itemData:Parse()
    itemData:SetPlayerName(name)
    itemData:SetPlayerFrame(frame)
    itemData:SetSign(title)
    itemData:Setplaye_level(level)
    itemData:SetPlayerHead(portrait)
    local damage = self:GetDps()
    if type == 2 then
        damage = self:GetPlayerDam()
        itemData:SetDamage(damage)
        itemData:SetParams(power)
    else
        itemData:SetDamage(damage)
    end
    itemData:SetisRank(false)
    itemData:SetPlayerUid(uid)
    itemData:SetIsMySelf(true)
    itemData:SetPlayerMingCi(0)
    return itemData
end
