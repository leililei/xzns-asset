--初始化数据
function MonsterSiegeModel:InitFunction()
    self:InitDataSiege(self.info.siege)
    self:SetRedpointLogin()
    self:UpdateRedpoint()
    local wind = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.MainSiegeView.Name)
    if wind then
        self.player_jifen_rank = nil
        self.playerself = nil
        self:RankPlayerGongXZiang(
            function()
                wind.View:UpdateView()
                self:UpdateRank(
                    function()
                        local wind1 =
                            _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.MonsterSiegeRankView.Name)
                        if wind1 then
                            wind1.View:UpdateView()
                        end
                    end
                )
            end
        )
    end
    ---结算时间 关闭
    if self.curActivityClass:GetCurActivityState() == 4 or self.curActivityClass:GetCurActivityState() == 1 then
        self.curActivityClass.curState = 1
        self.curActivityClass:ChangeState(1)
    end
end
function MonsterSiegeModel:SetRedpointLogin()
    local nowtime = _G.TimeUtil.GetServerUnixTime()
    local tb = _G.TimeUtil.GetDateTime(nowtime)
    local flag = true
    if tb.hour < _G.TimeUtil.GAME_DAY_HOUR then
        flag = false
    end
    local key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "monstersiege_time"
    if _G.CS.WechatGameCore.PlayerPrefs.HasKey(key) then
        local login_time = _G.CS.WechatGameCore.PlayerPrefs.GetInt(key)
        if _G.TimeUtil.CheckTheSameDay(login_time, nowtime) then
        else
            if flag then
                --检测是否 还有未充值的
                _G.CS.WechatGameCore.PlayerPrefs.SetInt(key, nowtime)
                local key2 = tostring(_G.PlayerModel:GetInstance().role_uid) .. "monstersiege"
                _G.CS.WechatGameCore.PlayerPrefs.SetInt(key2, 1)
            end
        end
    else
        _G.CS.WechatGameCore.PlayerPrefs.SetInt(key, nowtime)
        local key1 = tostring(_G.PlayerModel:GetInstance().role_uid) .. "monstersiege"
        _G.CS.WechatGameCore.PlayerPrefs.SetInt(key1, 1)
    end
end

