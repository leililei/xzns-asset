    --_G.world
    ---从新获取下info 信息
    self:TestGetInfo(
        function()
            --刷新 （测试数据）
            --self:SetMonsterID(self.cur_monsterID + 1)
            --刷新界面
            _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
            local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.MainSiegeView.Name)
            if window then
                window.View:UpdateView()
                window.View:Show()
                if isWin and self:GetMonsterID() == bossid then
                    local siege_cfg = _G.ConfigManager.siege_cfg[self:GetMonsterID()]
                    local monsterId = _G.ConfigManager.guild_boss_cfg[siege_cfg.event_params[1]].monster
                    local monsterCfg = _G.ConfigManager.monster_cfg[monsterId]

                    _G.GlobalInterface.OpenFightBossWinView(
                        _G.FightBossWinType.MonsterSiege,
                        nil,
                        nil,
                        _G.ConfigManager.card_cfg[monsterCfg.CardID].Portrait,
                        _G.GetLangPackValue(monsterCfg.Name),
                        _G.ZoneRankType.MonsterSiege,
                        self:GetActivieID(),
                        monsterCfg.CardID
                    )
                end
            end
        end
    )
end
