---个人奖励道具数据
function MonsterSiegeModel:GetRankRewardPersonData()
    if not self.rewardPerDatas then
        self.rewardPerDatas = {}
        local array = _G.ConfigManager.discrete_cfg[106503][1]
        for _, v in pairs(array) do
            local tb = _G.SimpleCopy(_G.ConfigManager.system_rank_cfg[v])
            tb.rewards = _G.GlobalInterface.GetNewArray(tb.rewards)
            if tb.rewards_remove > 0 then
                _G.table.insert(tb.rewards, {101, tb.rewards_remove})
            end

            _G.table.insert(self.rewardPerDatas, tb)
        end
        _G.SortList(
            self.rewardPerDatas,
            function(a)
                return -a.id
            end
        )
    end

    return self.rewardPerDatas
end

