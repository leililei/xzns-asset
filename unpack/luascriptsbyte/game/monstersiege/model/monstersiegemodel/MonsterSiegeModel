---测试代码 获取 info信息
------@field  data  achieve.s2c_achieve_info  ack = 是否成功 ，activity = 信息
function MonsterSiegeModel:TestGetInfo(call)
    require "ActivitySynNet":GetInstance():InitActivity(
        self:GetActivieID(),
        function(data)
            if data.ack ~= 1 then
                if _G.AppSetting.DEBUG then
                    _G.Log("活动信息为空")
                end
                return
            end
            ---@field  activity activity.i_activity
            ---@field  info activity.i_activity_info 活动公共信息
            ---@field  time activity.i_activity_time 活动时间
            ---@field  self_info activity.i_activity_self_info 活动独立信息
            local msg = data.activity[1].self_info.siege
            self:InitDataSiege(msg)
            self:UpdateRedpoint()
            self:UpdateRank()
            self:RankPlayerGongXZiang(
                function()
                    if call then
                        call()
                    end
                end
            )
        end
    )
end
