function MonsterSiegeModel:GetPlayerJifen()
    if self.player_jifen_rank ~= nil then
        return self.player_jifen_rank
    end
    ---没在榜单上
    self.player_jifen_rank = {}
    self.player_jifen_rank = self:SetPlayer(2)
    return self.player_jifen_rank
