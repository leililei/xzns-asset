---@class MonsterSiegeTaskModel : Singleton	怪物攻城 任务model
local MonsterSiegeTaskModel = _G.BaseClass("MonsterSiegeTaskModel", _G.Singleton)

---@return MonsterSiegeTaskModel MonsterSiegeTaskModel
function MonsterSiegeTaskModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function MonsterSiegeTaskModel:__init()
    self.alltask = {}
end

---销毁对象时,析构函数
function MonsterSiegeTaskModel:Dispose()
end
---初始化所有数据信息
---@field task_info task  t_type = 任务类型  t_curr = 2 任务进度
function MonsterSiegeTaskModel:initTaskAll(msg)
    self.alltask = {}
    self.finsh_task = {} --已完成的任务
    self.task_info = {} --任务数据的统计
    self.finsh_task = msg.finish_task
    self.task_info = msg.task_info
    self:NeatenData()
end
function MonsterSiegeTaskModel:NeatenData()
    local cfg = _G.ConfigManager.siege_mission_cfg
    for _, task in pairs(cfg) do
        local taksdata = MonsterSiegeTaskData.New()
        taksdata:ParseData({sid = task.id})
        local flag = false
        --查看已完成的任务
        if self.finsh_task == nil then
            flag = false
        else
            flag = false
            for i = 1, #self.finsh_task do
                if task.id == self.finsh_task[i] then --任务已完成
                    flag = true
                    break
                end
            end
        end
        ---查看任务进度
        if flag then
            taksdata:SetFinshNumber(task.count)
            taksdata:SetAwardState(awardenum.already_received)
        else
            if self.task_info == nil then
                taksdata:SetFinshNumber(0)
            else
                taksdata:SetFinshNumber(0)
                for i = 1, #self.task_info do
                    if self.task_info[i].t_type == task.condition[1][1] then
                        taksdata:SetFinshNumber(self.task_info[i].t_curr)
                        break
                    end
                end
            end
        end
        --查看任务进度
        _G.table.insert(self.alltask, taksdata)
    end
    ---刷新界面
    local wind = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.MonsterSiegeTaskView.Name)
    if wind then
        wind.View:UpdateView()
    end
end

---改变数据信息(胜利,失败不管)  外部接口boss 胜利调用
function MonsterSiegeTaskModel:ChangeSiegeTaskData(sid)
    local task_info = self:CheckSigeTask(sid)
    if task_info == nil then
        if _G.AppSetting.DEBUG then
            _G.Log("查找数据 空")
        end
        return
    end
    local flag = task_info:SetFinshNumber(1)
    --刷新红点
    if flag then
        require "MonsterSiegeManager":GetInstance():UpdateAwardRedpoint()
    end
end
----------------------  服务器数据交互 ----------------------------
---领取奖励
---@param sids table 领取奖励 （一键领取，单个领取）
function MonsterSiegeTaskModel:OnClickReceived(sids, call)
    local active = require "MonsterSiegeManager":GetInstance():GetActivity()
    local msg = {
        sid = sids,
        id = active:GetActivityID()
    }
    require "MonsterSiegeNet":GetInstance():FinishTask(
        msg,
        function(data)
            if data.ack ~= 1 then
                return
            end
            local reward_coin, gongxiang_num = 0, 0
            for i = 1, #sids do
                local task_info = self:CheckSigeTask(sids[i])
                task_info:SetAwardState(awardenum.already_received)
                require "MonsterSiegeManager":GetInstance():SetCoinActivity(task_info.Cfg.reward_coin)
                reward_coin = task_info.Cfg.reward_coin + reward_coin
                gongxiang_num = task_info.Cfg.reward_dam + gongxiang_num
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            local item = {
                type = {
                    101,
                    reward_coin
                }
            }
            local item1 = {
                type = {
                    102,
                    gongxiang_num
                }
            }
            if item then
                _G.table.insert(data.award.item, item)
                _G.table.insert(data.award.item, item1)
            end
            require "MonsterSiegeManager":GetInstance():GetActivity().typeClass:AddPlayerDam(gongxiang_num)
            --奖励
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CommonAwardView.Name,
                data,
                function()
                    _G.PlayerModel:GetInstance():ShowRoleLvUpAward()
                end
            )
            ---刷新排行榜
            _G.Events:GetInstance():Broadcast(_G.eMonsterSiege.RefreshRank)
            ---刷新红点
            require "MonsterSiegeManager":GetInstance():UpdateAwardRedpoint()
            if call then
                call()
            end
        end
    )
end
