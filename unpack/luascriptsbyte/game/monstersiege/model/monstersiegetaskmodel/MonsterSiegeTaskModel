--region 辅助方法
---查找任务
---@param sid number 怪物攻城 sid
function MonsterSiegeTaskModel:CheckSigeTask(sid)
    if self.alltask then
        for i = 1, #self.alltask do
            if self.alltask[i].sid == sid then
                return self.alltask[i]
            end
        end
    end
    return nil
end
---检测红点 任务有完成可领取 奖励时刷新红点
function MonsterSiegeTaskModel:CheckRedPoint()
    if _G.table.isEmptyOrNil(self.alltask) then
        return false
    end
    for i = 1, #self.alltask do
        if self.alltask[i]:GetAwardState() == awardenum.normal then
            return true
        end
    end
    return false
end
--endregion
return MonsterSiegeTaskModel
