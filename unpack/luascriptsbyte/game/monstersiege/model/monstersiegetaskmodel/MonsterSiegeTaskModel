---@class MonsterSiegeTaskModel	中文描述
local MonsterSiegeTaskData = _G.BaseClass("MonsterSiegeTaskModel")

local awardenum = {
    none = 0, -- 未完成状态
    normal = 1, --完成未领取状态
    already_received = 2 --已领取状态
}

---类的构造函数
function MonsterSiegeTaskData:__init()
end

---类的析构函数
function MonsterSiegeTaskData:Dispose()
end

---@param data table 传入的数据
---@field sid number 任务id
---@field cfg table  配置信息
function MonsterSiegeTaskData:ParseData(data)
    self.sid = data.sid or 1001
    local cfg = _G.ConfigManager.siege_mission_cfg[data.sid]
    self.Cfg = cfg
    self.finshnumber = data.finshnumber or 0
    self.awardstate = awardenum.none
end

function MonsterSiegeTaskData:SetFinshNumber(num)
    --已完成的任务、已领取
    if self:GetAwardState() ~= awardenum.none then
        return false
    end
    self.finshnumber = self.finshnumber + num
    return self:ChangeAwardState()
end

---获得任务的完成的次数
function MonsterSiegeTaskData:GetTaskFinshNumber()
    return self.finshnumber
end
---获得最大完成次数
function MonsterSiegeTaskData:GetMaxNumber()
    return self.Cfg.condition[1][2]
end
---获得奖励（reward and 任务贡献度 ）
function MonsterSiegeTaskData:GetReward()
    local award = {}
    for i = 1, #self.Cfg.reward do
        _G.table.insert(award, self.Cfg.reward[i])
    end
    local data = {
        {101, self.Cfg.reward_coin}, -- currency_type_client_cfg 101
        {102, self.Cfg.reward_dam} -- currency_type_client_cfg 102 配置表
    }
    _G.table.insertto(award, data)

    return award
end
---获得贡献值
function MonsterSiegeTaskData:GetRewardDam()
    return self.Cfg.reward_dam
end
---获得代币
function MonsterSiegeTaskData:GetRewardCoin()
    return self.Cfg.reward_coin
end
---获得贡献值
function MonsterSiegeTaskData:GetContribution()
    return self.Cfg.reward_num
end
---设置 奖励状态
function MonsterSiegeTaskData:SetAwardState(state)
    if state == nil then
        self.awardstate = awardenum.none
    else
        self.awardstate = state
    end
end
---改变奖励的状态 (未完成的任务)
function MonsterSiegeTaskData:ChangeAwardState()
    if self.finshnumber >= self:GetMaxNumber() then
        self:SetAwardState(awardenum.normal)
        self.finshnumber = self:GetMaxNumber()
        return true
    end
    return false
end
---获得奖励的状态
function MonsterSiegeTaskData:GetAwardState()
    return self.awardstate
end
