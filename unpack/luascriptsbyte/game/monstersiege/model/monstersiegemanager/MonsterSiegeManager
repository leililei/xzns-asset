---@class MonsterSiegeManager : Singleton	中文描述
local MonsterSiegeManager = _G.BaseClass("MonsterSiegeManager", _G.Singleton)

---@return MonsterSiegeManager MonsterSiegeManager
function MonsterSiegeManager:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function MonsterSiegeManager:__init()
    self.activity = {}
    self.ScenceId = 801 --主城场景
    self.activity_coin = 0
    self.monsterid_model = 1
end

---销毁对象时,析构函数
function MonsterSiegeManager:Dispose()
end

---动态创建模型( MapData_801 )
function MonsterSiegeManager:DynamicCreateModel()
    local datas = {}
    local discrete_cfg = _G.ConfigManager.discrete_cfg[106508]
    local cfg = _G.ConfigManager.siege_cfg
    for _, value in pairs(cfg) do
        local i = value.id
        if value.id == 10 then
            i = #discrete_cfg
        end
        local pos = discrete_cfg[i]
        local da = {
            InitPoint = {
                [1] = {
                    ["p_x"] = pos[1],
                    ["p_y"] = pos[2],
                    ["p_z"] = pos[3],
                    ["r_x"] = 0,
                    ["r_y"] = pos[4],
                    ["r_z"] = 0,
                    ["s_x"] = 1,
                    ["s_y"] = 1,
                    ["s_z"] = 1
                }
            },
            IsMove = false,
            IsInShadow = false,
            IsHidden = false,
            EnterFightId = value.id, ---代表 得是 配置表中 怪物得id
            Sid = value.obj_adv,
            Uid = 700000527 + value.id,
            RoutePoints = {}
        }
        _G.table.insert(datas, da)
    end
    SortList(
        datas,
        function(da)
            return -da.EnterFightId
        end
    )
    return datas
end

function MonsterSiegeManager:InitActivityClass(activity)
    self.activity = activity
end
function MonsterSiegeManager:GetActivity()
    return self.activity
end
function MonsterSiegeManager:Clear()
    self.activity_coin = 0
end
---设置跳转活动的id
function MonsterSiegeManager:SetJumpActivityID(id)
    self.jumpid = id
end
function MonsterSiegeManager:GetJumpActivityID()
    return self.jumpid or 0
end
---活动代币的数量
function MonsterSiegeManager:SetCoinActivity(coinnum)
    self.activity_coin = self.activity_coin + coinnum
    local tmp = {}
    _G.table.insert(tmp, 101)
    _G.table.insert(tmp, coinnum)
    _G.table.insert(tmp, self.activity_coin)
    _G.Events:GetInstance():Broadcast(_G.eItemUpdata.Updata, {{type = tmp}})
end
function MonsterSiegeManager:GetCoinActivity()
    return self.activity_coin
end
---刷新奖励红点
function MonsterSiegeManager:UpdateAwardRedpoint()
    self.activity.typeClass:UpdateRedpoint()
end
---挑战
function MonsterSiegeManager:SiegeFight(call)
    self.activity.typeClass:SiegeFight(call)
end
---进入战斗
---@param monsterid number siege_cfg 配置表中 怪物id
function MonsterSiegeManager:EnterEmbattle(monsterid)
    if monsterid then
        if monsterid == 10 then ---boss = 10 Id
            self.activity.typeClass:SetMonsterID(monsterid)
        else
            self.activity.typeClass:SetMonsterID(self.activity.typeClass:GetLevel())
        end
        self.monsterid_model = monsterid
    end
    local mon_id = self.activity.typeClass:GetMonsterID()
    self.activity.typeClass:EnterEmbattle(mon_id)
end
---退出战斗
function MonsterSiegeManager:ExitEmbattle()
    self.activity.typeClass:ExitEmbattle()
end
---更新数据
function MonsterSiegeManager:FightEndUpdate(isWin)
    --五行塔 , 达到次数没有打开 主城
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    self.activity.typeClass:FightEndUpdate(isWin)
end

---检测(角色界面) 是否开启了 恶灵入侵
function MonsterSiegeManager:CheckMainSiegeView()
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.MainSiegeView.Name)
    if window then
        window.View:Show()
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    end
end
---------------------------  进入场景   ---------------------------
function MonsterSiegeManager:OpenMainSiegeView(activity)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MainSiegeView.Name, activity)
end

---进入场景
function MonsterSiegeManager:EnterScence(callback)
    if self.activity:GetCurActivityState() == require("ActivitySynManager").State.Settlement then
        _G.PopWindowManager:GetInstance():ShowAllTips(4016)
        return
    else
        _G.WorldManager:GetInstance():EnterWorld(
            self.ScenceId,
            function()
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
                _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
                if callback then
                    callback(true)
                end
            end
        )
    end
    --_G.PlayerModel:GetInstance():SetCurCitySid(self.ScenceId)
end
---动态怪物数据
function MonsterSiegeManager:OpenEmMonsterData()
    return self.activity.typeClass:OpenEmMonsterData()
end
function MonsterSiegeManager:ExitSection(callback)
    if _G.AppSetting.DEBUG then
        _G.Log("退出场景", "怪物攻城")
    end
    local cursId = 300
    --_G.PlayerModel:GetInstance():SetCurCitySid(cursId)
    _G.WorldManager:GetInstance():EnterWorld(
        cursId,
        function()
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
            if callback then
                callback(true)
            end
        end
    )
end

function MonsterSiegeManager:SetDps(dps)
    self.activity.typeClass:SetDps(dps)
end

function MonsterSiegeManager:GetDps(dps)
    return self.activity.typeClass:GetDps()
end
---检测是否为boss战
function MonsterSiegeManager:CheckIsBoss()
    return self.monsterid_model==10
end
return MonsterSiegeManager
