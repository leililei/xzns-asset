---@protected
function TrainSuperValuModelGM:CheckState()
    if self.coinType == 9 and self:CheckSoldout() then
        self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
    end

    if self.coinType == 9 and not self:CheckSoldout() then
        ---@type MainOpenViewFunItem
        local MainOpenViewFunItem = {}
        MainOpenViewFunItem.OpenViewFun = function()
            local windowName = _G.ConfigManager.ui_cfg.PushSkinGiftView.Name
            local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.PushSkinGiftView.Name)
            if window then
                window.View:UpdateView(self.curActivityClass, 2)
            else
                _G.UIManager:GetInstance():OpenWindow(windowName, self.curActivityClass, 2)
            end
        end
        _G.MainManager:GetInstance():AddMainFunQueue(MainOpenViewFunItem, _G.MainViewShowOrder.GiftPackGroup)
    end
end

