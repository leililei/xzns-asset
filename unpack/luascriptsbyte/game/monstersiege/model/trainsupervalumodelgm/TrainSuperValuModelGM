        local login_time = _G.CS.WechatGameCore.PlayerPrefs.GetInt(key)
        if _G.TimeUtil.CheckTheSameDay(login_time, nowtime) then
        else
            --检测是否 还有未充值的
            if self:CheckOtherConditionExtra() then
                _G.CS.WechatGameCore.PlayerPrefs.SetInt(key, nowtime)
                local key2 = tostring(_G.PlayerModel:GetInstance().role_uid) .. "SuperValuGift"
                _G.CS.WechatGameCore.PlayerPrefs.SetInt(key2, 1)
