---充值
function TrainSuperValuModelGM:Chongzhi(giftinfo, call)
    --清除之前的购买回调(如果玩家取消了支付OnMallCashListener接口将不会回调)
    self.mallCall = nil

    local activity_id = self.curActivityClass.realActivityId and self.curActivityClass.realActivityId or
        self.curActivityClass:GetActivityID()
    if giftinfo.price == 0 then
        require "ActivitySynNet":GetInstance():GetAward(
            activity_id,
            { giftinfo.sid },
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                if call then
                    self:SetItemBuyTimes(giftinfo.sid)
                    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                    for _, v in pairs(giftinfo.goods) do
                        if v[1] == self.coinId then
                            _G.table.insert(msg.award.item, { type = v })
                            break
                        end
                    end
                    self:SetCoin(giftinfo.sid)
                    self:UpdateRedpoint()
                    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, buyAudioID)
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                    call(msg)
                end
            end
        )
    else
        if giftinfo.consume_type == 0 then
            _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
            local tb = {}
            for _, v in pairs(giftinfo.goods) do
                if v[1] == self.coinId then
                    tb[1] = { type = v }
                    break
                end
            end
            require "MallManager":GetInstance():BuyActiveGift(giftinfo.price, activity_id, giftinfo.sid, tb)
            self.mallCall = call
        else
            self:BuyRes(activity_id, giftinfo, call)
        end
    end
end

