---获取动态的商场数据  购买的次数
function TrainSuperValuModelGM:InitDynamicData()
    for i = 1, #self.model_cfg do
        local data = self.model_cfg[i]
        self.coinType = self.model_cfg[i].coin_type
        self:ChangeCoinID()
        data.goods = {}
        ---恶灵入侵代币
        if data.siege_coin and data.siege_coin > 0 then
            local da = {
                self.coinId, -- 配置 currency_type_client_cfg  101
                --资源表中的
                data.siege_coin
            }

            _G.table.insert(data.goods, da)
        end
        ---普通奖励
        if data.award then
            for i = 1, #data.award do
                _G.table.insert(data.goods, data.award[i].type)
            end
        end
    end
end

