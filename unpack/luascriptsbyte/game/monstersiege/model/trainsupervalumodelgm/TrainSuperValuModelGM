function TrainSuperValuModelGM:CheckFirstLogin()
    --("刷新红点-----------超值礼包")
    ---检测功能是否开启
    local flag = require "ActivitySynManager":GetInstance():CheckActivityConditionExtra(self.curActivityClass
        :GetActivityID())
    if not flag then
        return 0
    end
    local key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "SuperValuGift"
    if _G.CS.WechatGameCore.PlayerPrefs.HasKey(key) then
        if _G.CS.WechatGameCore.PlayerPrefs.GetInt(key) == 1 then
            return 1
        else
            return 0
        end
    else
        return 1
    end
    --return 1
end

