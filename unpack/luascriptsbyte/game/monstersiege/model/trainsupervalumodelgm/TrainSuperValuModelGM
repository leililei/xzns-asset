---@protected
function TrainSuperValuModelGM:CheckSoldout()
    local model_data = self:GetModelCfgByCondition()
    local isSoldout = true
    for i = 1, #model_data do
        local data = model_data[i]
        local limit = data.count
        local buy_num = self:GetItemBuyTimes(data.id or data.sid, data.type_reset)
        if limit ~= buy_num then
            isSoldout = false
            break
        end
    end
    return isSoldout
end

function TrainSuperValuModelGM:CheckGiftRed()
    --local isSoldout = self:CheckSoldout()
    --if isSoldout == true then
    --    return 0
    --end

    local num = _G.PlayerPrefsManager.GetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "PushSkinGiftView", 0)
    if num == 0 then
        return 1
    else
        local time = num
        local time2 = self:GetTime()
        return time < time2 and 1 or 0
    end
end

function TrainSuperValuModelGM:GetTime()
    local time = _G.TimeUtil.GetServerUnixTime()
    local data = _G.TimeUtil.GetDateTime(time)
    if data.hour < _G.TimeUtil.GAME_DAY_HOUR then
        return _G.TimeUtil.GetDayBegin(time - _G.TimeUtil.GAME_DAY_TIME) + _G.TimeUtil.GAME_DAY_TIME
    else
        return _G.TimeUtil.GetDayBegin(time) + _G.TimeUtil.GAME_DAY_TIME
    end
end

