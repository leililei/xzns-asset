    end
end

---物品id
---@param sid number 礼包id
function TrainSuperValuModelGM:SetCoin(sid)
    local data = {
        type = {
            [1] = self.coinId
        }
    }

    for i = 1, #self.model_cfg do
        if self.model_cfg[i].sid == sid then
            data.type[2] = self.model_cfg[i].siege_coin
            if self.coinType > 0 then
                if self.coinId == 103 then
                    _G.Events:GetInstance():Broadcast(_G.eArena.SetFairCoin, data.type[2])
                elseif self.coinId == 104 then
                    _G.Events:GetInstance():Broadcast(_G.eArena.SetGuessCoin, data.type[2])
                elseif self.coinId == 101 then
                    require "MonsterSiegeManager":GetInstance():SetCoinActivity(data.type[2])
                elseif self.coinId == 109 then
                    _G.Events:GetInstance():Broadcast(_G.eArena.SetSixVsSix, data.type[2])
                elseif self.coinType == 4 then
                    _G.Events:GetInstance():Broadcast(_G.eArena.SetDrawUp, data.type)
                elseif self.coinType == 5 then
                    _G.Events:GetInstance():Broadcast(_G.eArena.SetDrawUp, data.type)
                elseif self.coinType == 7 or self.coinType == 11 or self.coinType == 14 then
                    _G.Events:GetInstance():Broadcast(_G.eArena.SetDrawUp, data.type)
                elseif self.coinType == 8 then
                    require "TarotManager":GetInstance():AddCoin(data.type[2])
                end
            end
            return data
        end
    end
    return nil
end

