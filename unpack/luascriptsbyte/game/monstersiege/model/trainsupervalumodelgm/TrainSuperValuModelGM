---数据类 静态数据类
function TrainSuperValuModelGM:InitModelData()
    self.model_cfg = {}
    self.FreeGift = {}
    --local cfg = _G.ConfigManager.store_active_cfg
    -- for key, value in pairs(cfg) do
    --     if value.type_1 == 2 then
    --         _G.table.insert(self.model_cfg, value)
    --     end
    -- end
    for i = 1, #self.infocfg do
        local data = {}
        data = self.infocfg[i]
        if data.price == 0 then
            self.FreeGift = { sid = data.sid, count = data.count }
            if data.special then
                self.LiHuiSpine = data.special and string.trim(data.special) or nil
            end
        end
        _G.table.insert(self.model_cfg, self.infocfg[i])
    end
    self.model_cfg = _G.table.toArray(self.model_cfg)
end

---过滤掉不显示的礼包
function TrainSuperValuModelGM:GetModelCfgByCondition(ActivityID)
    local modelCfg = {}
    local checkArray
    for i = 1, #self.infocfg do
        checkArray = {}
        if self.infocfg[i].display_con then
            for _, v in pairs(self.infocfg[i].display_con) do
                _G.table.insert(checkArray, { v.k, v.v })
            end
        end
        if _G.GlobalConditionManager.CheckConditionByArray(checkArray) then
            _G.table.insert(modelCfg, self.infocfg[i])
        end
    end
    return modelCfg
end

