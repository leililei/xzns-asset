---类的构造函数
---@param activity ActivitySynGMActivity
function TrainSuperValuModelGM:__init(activity)
    self.FirstLogin = false
    activity:AddStateChanged(self.OnActivityStateChanged, self)
end

function TrainSuperValuModelGM:OnActivityStateChanged(state)
    if state == ActivitySynManager.State.Close then
        self:UpdateRedpoint()
        if self.coinType == 0 then
            --刷新主城上方界面按钮
            _G.MainManager:GetInstance():SetForShowGodSpecialGift(false)
            _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.GodSpecialGift)
        end
    end
end

