function TrainSuperValuModelGM:ChangeCoinID()
    if self.coinType == 1 then
        self.coinId = 104
    elseif self.coinType == 2 then
        self.coinId = 101
    elseif self.coinType == 3 then
        self.coinId = 103
    elseif self.coinType == 4 then
        self.coinId = 106
    elseif self.coinType == 6 then
        self.coinId = 109
    elseif self.coinType == 7 then
        self.coinId = 115
    elseif self.coinType == 8 then
        self.coinId = 117
    elseif self.coinType == 11 then
        local activity = require "ActivitySynManager":GetInstance():GetChildAcitivity(10044,
            self.curActivityClass:GetJumpType(self.curActivityClass.activityId))
        if activity then
            self.coinId = require "JointActivityDrawUpModel":GetInstance():GetCoinId(activity.activityID)
        end
    end
end

function TrainSuperValuModelGM:CheckOtherConditionExtra()
    local flag = false
    for i = 1, #self.model_cfg do
        local data = self.model_cfg[i]
        local buy_num = self:GetItemBuyTimes(data.sid, data.type_reset)
        if buy_num ~= data.count_limit then
            flag = true
            break
        end
    end
    return flag
end

