function TrainSuperValuModelGM:SetSelfData(info)
    self.type_num = 2 --GM（同一个界面，2 = 是GM 1 = 配置）
    local subType = self.curActivityClass:GetJumpType()
    self.coinId = 101
    if subType and coinSubList[subType] then
        self.coinId = coinSubList[subType]
    end
    --self.type = info.cash_gift.type ---公平竞技场类型
    --self.coinId = self.type and 103 or 101
    if info == nil or info.cash_gift == nil then
        if _G.AppSetting.DEBUG then
            _G.Log("配置信息为空", "恶灵入侵")
        end
        return
    end
    local cfg
    self.infocfg = info.cash_gift.gifts or {}
    for _, v in pairs(self.infocfg) do
        if _G.tonumber(v.name) then
            v.name = _G.LangUtil.GetLangPackValue(_G.tonumber(v.name))
        end
    end
    --self.times = info.times or {} --{sid,num} --礼包购买次数
    self.times_buy = {}
    if info.cash_gift.times ~= nil then
        for i = 1, #info.cash_gift.times do
            local buy = info.cash_gift.times[i]
            -- if self.times_buy[buy.k] == nil then
            --     self.times_buy[buy.k] = 0
            -- end
            self.times_buy[buy.k] = buy.v
        end
    end
    self.LiHuiPath = (info.cash_gift.pos ~= nil and info.cash_gift.pos ~= "") and string.trim(info.cash_gift.pos) or nil
    if info.cash_gift.dev then
        local pos = {}
        local scale = 1
        local dev = string.split(info.cash_gift.dev, "#")
        for _, v in pairs(dev) do
            if string.contains(v, "|") then
                scale = string.split(v, "|")[2]
                table.insert(pos, tonumber(string.split(v, "|")[1]))
            else
                table.insert(pos, tonumber(v))
            end
        end
        self.LiHuiPos = pos
        self.LihuiScale = tonumber(scale)
    end
end

