---是否 每日的首次登录
function TrainSuperValuModelGM:CheckFreeGift()
    local sub_type = self.curActivityClass:GetJumpType()
    if self.coinType == 9 then
        return self:CheckGiftRed()
    elseif sub_type == 100083 then
        local model = require("ArenaGlobalModel"):GetInstance()
        local isCanFight = model:CheckCanFight()
        if isCanFight == false then
            return 0
        else
            local flag = require "ActivitySynManager":GetInstance():CheckActivityConditionExtra(self.curActivityClass:GetActivityID())
            if not flag then
                return 0
            end
            if not _G.table.isEmptyOrNil(self.FreeGift) then
                local buy_num = self:GetItemBuyTimes(self.FreeGift.sid)
                if self.FreeGift.count > buy_num then
                    return 1
                else
                    return 0
                end
            else
                return 0
            end
        end
    else
        local flag = require "ActivitySynManager":GetInstance():CheckActivityConditionExtra(self.curActivityClass
            :GetActivityID())
        if not flag then
            return 0
        end
        if not _G.table.isEmptyOrNil(self.FreeGift) then
            local buy_num = self:GetItemBuyTimes(self.FreeGift.sid)
            if self.FreeGift.count > buy_num then
                return 1
            else
                return 0
            end
        else
            return 0
        end
    end
end

---@param data store.p2c_store_cash
function TrainSuperValuModelGM:OnMallCashListener(data)
    if not self.model_cfg then
        return
    end
    if self.mallCall then
        self.mallCall()
        self.mallCall = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

