---@protected
function TrainSuperValuModelGM:ChangeLoginRed()
    _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "PushSkinGiftView", self:GetTime())
    self:UpdateRedpoint()
end

function TrainSuperValuModelGM:IsShowBtn()
    if
        self.coinType == 4 or self.coinType == 5 or self.coinType == 0 or self.coinType == 7 or self.coinType == 8 or
        self.coinType == 10 or self.coinType == 11
    then
        return false
    end
    return true
end

---资源购买礼包
function TrainSuperValuModelGM:BuyRes(activity_id, giftinfo, call)
    local num = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.ResProp, _G.ResPropID.Diamond)
    if num < giftinfo.price then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ResPropID.Diamond)
        return
    end
    require "ActivitySynNet":GetInstance():BuyGift(
        activity_id,
        giftinfo.sid,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            if call then
                self:SetItemBuyTimes(giftinfo.sid)
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                for _, v in pairs(giftinfo.goods) do
                    if v[1] == self.coinId then
                        _G.table.insert(msg.award.item, { type = v })
                        break
                    end
                end
                self:SetCoin(giftinfo.sid)
                self:UpdateRedpoint()
                if giftinfo.consume_type then
                    _G.StorageManager:GetInstance():ConsumeItem(giftinfo.consume_type, 0, giftinfo.price)
                end
                _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, buyAudioID)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                call(msg)
            end
        end
    )
end

return TrainSuperValuModelGM
