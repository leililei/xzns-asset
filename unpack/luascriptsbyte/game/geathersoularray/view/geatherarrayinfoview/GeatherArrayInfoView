local GeatherSoulArrayModel = require("GeatherSoulArrayModel")

local GetLangPackValue = _G.GetLangPackValue
local card_skills_cfg = _G.ConfigManager.card_skills_cfg
local GeatherArrayEmbattle = _G.BaseClass("GeatherArrayEmbattle", _G.Component)
function GeatherArrayEmbattle:__init(obj)
    self.CardItemList = {}
    self.go_table = _G.GetAutoGoTable(obj)
    self.GetCardItem = {}
end
local eff = {
    [105] = "ef_julingfazhen_green",
    [104] = "ef_julingfazhen_bule",
    [103] = "ef_julingfazhen_purple",
    [102] = "ef_julingfazhen_red",
    [101] = "ef_julingfazhen_yellow"
}
function GeatherArrayEmbattle:UpdateView(arrayId)
    self.CurArrayData = require "GeatherSoulArrayModel":GetInstance():GetArrayInfo(arrayId)
    for i = 1, 5 do
        self:GetCard(self.go_table["obj_CardItem" .. i], i)
    end
    self.go_table.aorrawimage_arrayIcon:LoadImage(
        self.CurArrayData.Cfg.image,
        function(image)
            image:SetNativeSize()
        end
    )
    self.go_table.obj_eff:ClearChildren()
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg[eff[arrayId]], self.go_table.obj_eff)
    self.nextIndex, self.nextLv = GeatherSoulArrayModel:GetInstance():GetNextUnlockArrayPos(arrayId)
end
---@param index number 槽位id
function GeatherArrayEmbattle:GetCard(go, index)
    local arrayid = self.CurArrayData.Cfg.id
    local tb = _G.GetAutoGoTable(go, _G.handlerbind(self, self.OnClickBtn, index))
    local isUnlockPos, isCanEmbattle = require "GeatherSoulArrayModel":GetInstance():CheckEmbattle(arrayid, index)
    if isUnlockPos == false then
        require "GeatherSoulArrayModel":GetInstance().effDanCi = false
    end
    if index == self.nextIndex and isUnlockPos and require "GeatherSoulArrayModel":GetInstance().effDanCi then
        tb.obj_effUnlock:ClearChildren()
        require "GeatherSoulArrayModel":GetInstance().effDanCi = false
    end

    -- require "GeatherSoulArrayModel":GetInstance().effDanCi = false

    _G.GameUtil.SetActiveByCondition(tb.aorimage_suo, not isUnlockPos)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_jia, isCanEmbattle)
    _G.GameUtil.SetActiveByCondition(tb.obj_card, isUnlockPos and not isCanEmbattle)
    if isUnlockPos and not isCanEmbattle then
        local card = self.CardItemList[index]
        if not card then
            card = require("ItemCardAllView").New(tb.obj_card)
        end
        local carddata =
            _G.StorageManager:GetInstance():GetItemDataByID(
            _G.StorageID.Card,
            require "GeatherSoulArrayModel":GetInstance():GetCardByArrayIndex(arrayid, index)
        )
        card:ShowCardData(carddata, nil, true, true)
    end
    self.GetCardItem[index] = tb
end

function GeatherArrayEmbattle:OnClickBtn(go, isOn, index)
    local isUnlockPos, isCanEmbattle, level =
        require "GeatherSoulArrayModel":GetInstance():CheckEmbattle(self.CurArrayData.Cfg.id, index)
    if isUnlockPos then
        if isCanEmbattle then
            local y = index
            for i = 5, 1, -1 do
                local isUnlockPoss, isCanEmbattles, level =
                    require "GeatherSoulArrayModel":GetInstance():CheckEmbattle(self.CurArrayData.Cfg.id, i)
                if isUnlockPoss then
                    if isCanEmbattles then
                        y = i
                    end
                end
            end
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.GeatherSoulArraySelectCardView.Name,
                self.CurArrayData.Cfg.id,
                function(uid)
                    ---上阵
                    require "GeatherSoulArrayModel":GetInstance():SetCard(
                        uid,
                        self.CurArrayData.Cfg.id,
                        y,
                        self.CurArrayData.Cfg.id,
                        function()
                            self:UpdateView(self.CurArrayData.Cfg.id)
                            self.GetCardItem[index].obj_eff:SetActiveE(0)
                            self.GetCardItem[index].obj_eff:SetActiveE(1)

                            _G.PopWindowManager:GetInstance():ShowAllTips(780106)
                        end
                    )
                end
            )
        else
            local card =
                _G.StorageManager:GetInstance():GetItemDataByID(
                _G.StorageID.Card,
                require "GeatherSoulArrayModel":GetInstance():GetCardByArrayIndex(self.CurArrayData.Cfg.id, index)
            )
            _G.PopWindowManager:GetInstance():ShowAllTips(
                780101,
                _G.GetLangPackValue(90000010522, _G.GetLangPackValue(card.cfg.Name)),
                function()
                    ---下阵
                    require "GeatherSoulArrayModel":GetInstance():SetCard(
                        require "GeatherSoulArrayModel":GetInstance():GetCardByArrayIndex(
                            self.CurArrayData.Cfg.id,
                            index
                        ),
                        self.CurArrayData.Cfg.id,
                        index,
                        0,
                        function()
                            self:UpdateView(self.CurArrayData.Cfg.id)
                        end
                    )
                end
            )
        end
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(
            780102,
            _G.GetLangPackValue(90000010523, _G.GetLangPackValue(self.CurArrayData.Cfg.name), level)
        )
    end
end
local GeatherArrayInfo = _G.BaseClass("GeatherArrayInfo", _G.Component)
function GeatherArrayInfo:__init(obj)
    self.Type = {Level = 1, TuPo = 2}
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.UiDic = {
        ---触发升级时间
        uplvTime = 0,
        ---升级间隔 s (防止 响应长按并响应点击 防止连点)
        uplvjg = 0.2
    }

    ---按下多久 触发长按
    self.DownClickLimit = 2
    ---按下多久 触发一次 事件
    self.DownTimeClickTimeLimit = 0.3
    ---设置升级按钮 长按事件
    _G.SetEventTrigger(self.go_table.aorbtn_upLevel, "onDown", _G.handler(self, self.onDown_Uplv))
    self.go_table.aorbtn_upLevel.LongPress = true
    self.go_table.aorbtn_upLevel.onLongPress = _G.handler(self, self.onLongPressS_Uplv)
    -- _G.SetEventTrigger(self.go_table.aorbtn_upLevel, "onLongPress", _G.handler(self, self.onLongPressS_Uplv))
    _G.SetEventTrigger(self.go_table.aorbtn_upLevel, "onUp", _G.handlerbind(self, self.onUp_Uplv, 0, true))
end
--初始化
function GeatherArrayInfo:onDown_Uplv()
    if os.time() - self.UiDic.uplvTime < self.UiDic.uplvjg then
        return
    end
    self.nextIndex, self.nextLv = GeatherSoulArrayModel:GetInstance():GetNextUnlockArrayPos(self.arrayId)
    self.DengDai = false
    self.DownClickTime = 0
    self.jishi = 0
    self.numberlevel = 0
    self.upLvLock = false
    self.shortOne = true
end
--计算时间
function GeatherArrayInfo:onLongPressS_Uplv()
    self.isLongPress = true
    if self.DengDai then
        ---dengdai
    else
        self.DownClickTime = self.DownClickTime + 1
        if self.DownClickTime > self.DownClickLimit then
            if (self.CurArrayData:GetLevel() + self.numberlevel) > self.CurArrayData.Cfg.max_level then
                return
            end
            self.jishi = self.jishi + 0.10
            if self.jishi > self.DownTimeClickTimeLimit then
                self.numberlevel = self.numberlevel + 1
                local level = self.CurArrayData:GetLevel() + self.numberlevel
                local aimLv = self.nextLv or self.CurArrayData.Cfg.max_level
                local res, count =
                    require "GeatherSoulArrayModel":GetInstance():CheckItem(
                    self.CurArrayData:GetLevelMaterialByLevel(level, true)
                )
                if not res then
                    self.DengDai = true
                    --- 中断并提交 之前
                    self:onUp_Uplv(nil, nil, 1)
                    return
                end
                self:LongPressUI(level)
                if level < aimLv then
                    self.DengDai = false
                else
                    self.DengDai = true
                    --- 中断并提交 之前
                    self:onUp_Uplv()
                    return
                end
                self.jishi = 0
            end
        end
    end
end

---升级
---@num number 等级修正值
---@isOnUp boolean 是否是按键抬起trigger触发
function GeatherArrayInfo:onUp_Uplv(_, _, num, isOnUp)
    if os.time() - self.UiDic.uplvTime < self.UiDic.uplvjg then
        return
    end
    ---防止到节点触发升级和按键抬起重复升级
    if self.upLvLock then
        return
    end
    self.upLvLock = true
    if isOnUp then
        self.isLongPress = false
    end
    local nums = 0
    local level = 1
    if self.DownClickTime > self.DownClickLimit then
        if num ~= nil then
            nums = num
        end
        level = self.numberlevel - nums
        if level == 0 then
            level = 1
        end
    else
        level = 1
    end
    if (self.CurArrayData:GetLevel() + self.numberlevel) > self.CurArrayData.Cfg.max_level then
        level = self.CurArrayData.Cfg.max_level - self.CurArrayData:GetLevel()
    end
    ---及时清零，防止重复计算
    self.numberlevel = 0
    if not self.CurArrayData:IsMaxLevel() then
        local unlockPos = self.CurArrayData:GetUnlockPosCount()
        local res, count, id =
            require "GeatherSoulArrayModel":GetInstance():CheckItem(self.CurArrayData:GetLevelMaterial())
        if not res and level == 1 then
            local material = self.CurArrayData:GetLevelMaterial()
            if not _G.table.isEmptyOrNil(material) then
                if id then
                    local CompoundList = require "GeatherSoulArrayModel":GetInstance():CheckCompound(id, count)
                    if CompoundList and not _G.table.isEmptyOrNil(CompoundList) then
                        _G.UIManager:GetInstance():OpenWindow(
                            _G.ConfigManager.ui_cfg.GeatherSoulArrayAutoCompoundView.Name,
                            material,
                            CompoundList,
                            count,
                            function(call)
                                require "GeatherSoulArrayModel":GetInstance():LevelUp(
                                    self.CurArrayData.Cfg.id,
                                    level,
                                    self.shortOne,
                                    function()
                                        -- local _unlockPos = self.CurArrayData:GetUnlockPosCount()
                                        -- if unlockPos < _unlockPos then
                                        local view =
                                            _G.UIManager:GetInstance():GetWindowCtrl(
                                            _G.ConfigManager.ui_cfg.GeatherArrayInfoView.Name
                                        )
                                        -- if view and view.ViewLua then
                                        --     view.left:UpdateView(self.CurArrayData.Cfg.id)
                                        -- end
                                        if view then
                                            require "GeatherSoulArrayModel":GetInstance().effDanCi = true

                                            view:UpdateView(self.CurArrayData.Cfg.id)
                                        end
                                        -- end
                                        -- self:UpdateView(self.CurArrayData.Cfg.id)
                                        if call then
                                            call()
                                        end
                                    end
                                )
                            end
                        )
                    else
                        if not _G.table.isEmptyOrNil(material) then
                            ---打开资源获取界面
                            for i = 1, #material do
                                _G.GameUtil.FastUseChooseItem(
                                    {109502, 109501},
                                    material[i][1],
                                    material[i][2],
                                    function()
                                        self:ShowTypeView()
                                    end
                                )
                                break
                            end
                        end
                    end
                end
            end
        else
            require "GeatherSoulArrayModel":GetInstance():LevelUp(
                self.CurArrayData.Cfg.id,
                level,
                self.shortOne,
                function()
                    -- local _unlockPos = self.CurArrayData:GetUnlockPosCount()
                    -- if unlockPos < _unlockPos then
                    local view =
                        _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.GeatherArrayInfoView.Name)
                    -- if view and view.ViewLua then
                    --     view.ViewLua.left:UpdateView(self.CurArrayData.Cfg.id)
                    -- end
                    if view then
                        require "GeatherSoulArrayModel":GetInstance().effDanCi = true
                        view:UpdateView(self.CurArrayData.Cfg.id)
                    end
                    self.go_table.obj_LV:SetActiveE(0)
                    self.go_table.obj_LV:SetActiveE(1)
                    -- end
                    -- self:UpdateView(self.CurArrayData.Cfg.id)
                end
            )
        end
    end
    self.UiDic.uplvTime = os.time()
end
function GeatherArrayInfo:UpdateView(arrayId, type)
    self.arrayId = arrayId
    self.CurArrayData = require "GeatherSoulArrayModel":GetInstance():GetArrayInfo(arrayId)
    if type then
        if self.CurType == type then
            return
        end
        self.CurType = type
    else
        if not self.CurType then
            self.CurType = self.Type.Level
        end
    end
    self:ShowTypeView()
    self:ShowCommon()

    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.GeatherArrayInfoView.Name)
    if view then
        view:ShowResetBtn()
    end
end
function GeatherArrayInfo:LongPressUI(level)
    self.shortOne = false
    self.upLvLock = false
    self.go_table.aortext_level.text = GetLangPackValue(90021800050) .. level
    self:ShowProp(self.CurArrayData:GetLevelAllAttrByLevel(level), self.go_table.obj_AllProp, self.AllPropItemDic)
    self:ShowProp(self.CurArrayData:GetLevelSelectAttrByLevel(level), self.go_table.obj_ArrayProp, self.CardPropItemDic)
    local materials = self.CurArrayData:GetLevelMaterialByLevel(level, true)
    if #materials >= 1 then
        for k, v in pairs(materials) do
            _G.StorageManager:GetInstance():ConsumeItem(v[1], 0, v[2])
        end
    end
    self.go_table.obj_LV:SetActiveE(0)
    self.go_table.obj_LV:SetActiveE(1)
    self:ShowMaterial(
        self.Type.Level,
        self.go_table.obj_MaterialLevelUp,
        self.CurArrayData:GetLevelMaterialByLevel(level)
    )

    --self.CurArrayDatas[self.CurArrayData.Cfg.id]:GetLevelMaterial()

    ---升级
    self.go_table.aortext_levelUpTxt.text = GetLangPackValue(9002050015)
    self.go_table.aorbtn_upLevel.enabled = true
end
---通用展示
function GeatherArrayInfo:ShowCommon()
    self.go_table.aorimage_name.SpriteName = self.CurArrayData.Cfg.name_Image
    self.go_table.aortext_level.text = GetLangPackValue(90021800050) .. self.CurArrayData:GetLevel()
    --- 设置星级图片
    for i = 1, 5 do
        if i <= self.CurArrayData.Cfg.max_star then
            _G.GameUtil.SetActiveByCondition(self.go_table["aorimage_fire" .. i], true)
            self.go_table["aorimage_fire" .. i]:SetGray(i > self.CurArrayData:GetStar())
        else
            _G.GameUtil.SetActiveByCondition(self.go_table["aorimage_fire" .. i], false)
        end
    end
end

---展示对应等级界面和突破界面
function GeatherArrayInfo:ShowTypeView()
    self.go_table.obj_LV:SetActiveE(0)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_level, self.CurType == self.Type.Level)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_tupo, self.CurType == self.Type.TuPo)
    if self.AllPropItemDic == nil then
        self.AllPropItemDic = {}
    end
    if self.CardPropItemDic == nil then
        self.CardPropItemDic = {}
    end
    local skillID = self.CurArrayData:GetStarSkill()
    if skillID and card_skills_cfg[skillID] then
        if not _G.string.IsNullOrEmpty(card_skills_cfg[skillID].icon) then
            self.go_table.aorrawimage_arraySkillName:LoadImage(card_skills_cfg[skillID].icon)
        end
    -- self.go_table.aortext_skillName.text = GetLangPackValue(card_skills_cfg[skillID].name1)
    -- self.go_table.aortext_skillDesc.text = GetLangPackValue(card_skills_cfg[skillID].describe1)
    end
    if self.CurType == self.Type.Level then
        self:ShowProp(self.CurArrayData:GetLevelAllAttr(), self.go_table.obj_AllProp, self.AllPropItemDic)
        self:ShowProp(self.CurArrayData:GetLevelSelectAttr(), self.go_table.obj_ArrayProp, self.CardPropItemDic)
        local limit, pos
        for i = 1, #self.CurArrayData.Cfg.condition_level do
            if not require "GeatherSoulArrayModel":GetInstance():GetCurArrayPosIsUnlock(self.CurArrayData.Cfg.id, i) then
                limit = self.CurArrayData.Cfg.condition_level[i]
                pos = i
                break
            end
        end
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_tips, limit)
        if limit then
            self.go_table.aortext_tips.text = GetLangPackValue(90000010524, limit, pos)
        end
        if not self.CurArrayData:IsMaxLevel() then
            self.go_table.obj_MaterialLevelUp:SetActiveE(1)
            self:ShowMaterial(1, self.go_table.obj_MaterialLevelUp, self.CurArrayData:GetLevelMaterial())
            ---升级
            self.go_table.aortext_levelUpTxt.text = GetLangPackValue(9002050015)
            self.go_table.aorbtn_upLevel.enabled = true
        else
            self.go_table.obj_MaterialLevelUp:SetActiveE(0)
            ---已达最大等级
            self.go_table.aortext_levelUpTxt.text = GetLangPackValue(90020300106)
            self.go_table.aorbtn_upLevel.enabled = false
        end
    else
        --end
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_tips, not self.CurArrayData:IsMaxStar())

        if not self.CurArrayData:IsMaxStar() then
            self.go_table.obj_MaterialTuPo:SetActiveE(1)
            self:ShowMaterial(2, self.go_table.obj_MaterialTuPo, self.CurArrayData:GetStarMaterial())
            ---突破
            self.go_table.aortext_tips.text = GetLangPackValue(90000001082)
            self.go_table.aortext_tupoTxt.text = GetLangPackValue(90020400036)
            self.go_table.aorbtn_tupo.enabled = true
        else
            self.go_table.obj_MaterialTuPo:SetActiveE(0)
            ---已达最大星级
            self.go_table.aortext_tupoTxt.text = GetLangPackValue(9002050021)
            self.go_table.aorbtn_tupo.enabled = false
        end

        if self.go_table.obj_SkillViewScroll:GetChildCountE() > 0 then
            for i = 1, self.go_table.obj_SkillViewScroll:GetChildCountE() do
                _G.DestroyObject(self.go_table.obj_SkillViewScroll:GetChildE(i - 1))
            end
        end
        --if not self.CurArrayData:IsMaxStar() then
        local skillObj, tb, skillId
        for i = 1, self.CurArrayData.Cfg.max_star + 1 do
            skillObj = _G.InstantiateObject(self.go_table.obj_skill, self.go_table.obj_SkillViewScroll)
            tb = _G.GetAutoGoTable(skillObj)
            local index = i - 1
            skillId = self.CurArrayData:GetSkillByStar(index)
            if card_skills_cfg[skillId] then
                tb.aortext_des.text = GetLangPackValue(card_skills_cfg[skillId].describe1)
            end
            if index == self.CurArrayData:GetStar() then
                tb.aortext_des.color = _G.Color.New(162 / 255, 169 / 255, 218 / 255, 1)
            else
                tb.aortext_des.color = _G.Color.New(104 / 255, 105 / 255, 137 / 255, 1)
            end
            if index > 0 then
                tb.obj_Star:SetActiveE(1)
                --- 设置星级图片
                for j = 1, 5 do
                    if j <= index then
                        _G.GameUtil.SetActiveByCondition(tb["aorimage_fire" .. j], true)
                    else
                        _G.GameUtil.SetActiveByCondition(tb["aorimage_fire" .. j], false)
                    end
                    if index > self.CurArrayData:GetStar() then
                        tb["obj_eff" .. j]:SetActiveE(0)
                    else
                        tb["obj_eff" .. j]:SetActiveE(1)
                    end
                    --_G.GameUtil.SetActiveByCondition(tb["obj_eff" .. j], (not j > self.CurArrayData:GetStar()))
                end
            else
                tb.obj_Star:SetActiveE(0)
            end
        end
        _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(
            self.go_table.obj_SkillViewScroll:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
        )
    end
    _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(
        self.go_table.obj_Scroll:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    )
    self.go_table.obj_Scroll:SetLocalPosition(0, 0, 0)
    if self.CurType == self.Type.TuPo then
        local count = self.go_table.obj_SkillViewScroll:GetChildCountE()
        local child = self.go_table.obj_SkillViewScroll:GetChildE(count - 6 + self.CurArrayData:GetStar())
        local offsetX, offsetY = child:GetLocalPosition()
        _G.DelayDo(
            0.001,
            function()
                ---不知道为什么在切换法阵时，不加延迟会导致可能出现无法正确SetLocalPosition
                self.go_table.obj_Scroll:SetLocalPosition(0, -offsetY, 0)
            end
        )
    end
    --self.go_table.obj_Scroll:SetLocalPosition(0, (self.CurArrayData:GetStar() - 1) * 85, 0)
end
function GeatherArrayInfo:ShowMaterial(type, parent, cfg)
    if cfg then
        local subList = {}
        for k, v in pairs(cfg) do
            _G.table.insert(subList, {v[1], false, v[2]})
        end
        if type == self.Type.Level then
            if not self.LevelMaterial then
                ---@type Params_ConsumeCompont
                local data = {}
                data.textColorType = 3
                self.LevelMaterial =
                    self:AddComponent(parent, require("ConsumeCompont").New(parent, nil, nil, nil, true, data))
                if self.LevelMaterial ~= nil then
                    self.LevelMaterial:RestRs(subList)
                end
            end
            self.LevelMaterial:RestRs(subList)
        elseif type == self.Type.TuPo then
            if not self.StarMaterial then
                ---@type Params_ConsumeCompont
                local data = {}
                data.textColorType = 3
                self.StarMaterial =
                    self:AddComponent(parent, require("ConsumeCompont").New(parent, subList, nil, nil, true, data))
            end
            if self.StarMaterial ~= nil then
                self.StarMaterial:RestRs(subList)
            end
        end
    end
end
function GeatherArrayInfo:ShowProp(additions, parent, dic)
    local scale = self.CurArrayData:GetStarAllAttr()
    local len = #additions

    local obj, num

    for i, v in pairs(additions) do
        ---生成属性条
        if dic[i] == nil then
            obj = _G.InstantiateObject(self.go_table.obj_propItem, parent)
            table.insert(dic, obj)
        else
            obj = dic[i]
        end
        num = tonumber(v[3]) * scale
        num = _G.AttributeClassManager:GetInstance():GetShowProp(v[1], v[2], num, 0.000001)
        self:SetProp(
            obj,
            _G.LangUtil.GetLangPackValue(_G.ConfigManager.type_attribute_cfg[_G.AttrType[v[1]].ID].name),
            num
        )
        obj:SetActiveE(1)
    end
    len = len + 1
    for i = len, #dic do
        dic[i]:SetActiveE(0)
    end
end

function GeatherArrayInfo:SetProp(obj, name, num)
    local go_table = _G.GetAutoGoTable(obj)
    go_table.aortext_strenName.text = tostring(name)
    go_table.aortext_strenNum.text = "+" .. tostring(num)
end
function GeatherArrayInfo:ShowStar()
    --- 设置星级图片
    for i = 1, 5 do
        if i <= self.CurArrayData.Cfg.max_star then
            _G.GameUtil.SetActiveByCondition(self.go_table["aorimage_fire" .. i], true)
            self.go_table["aorimage_fire" .. i]:SetGray(i <= self.CurArrayData:GetStar())
        else
            _G.GameUtil.SetActiveByCondition(self.go_table["aorimage_fire" .. i], false)
        end
    end
end
function GeatherArrayInfo:OnClickBtn(go, isOn)
