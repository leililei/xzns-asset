---@class GeatherArrayInfoView : UIBaseView    中文描述
---@field public go_table GeatherArrayInfoView_GoTable GoTable
local GeatherArrayInfoView = _G.BaseClass("GeatherArrayInfoView", _G.UIBaseView)
function GeatherArrayInfoView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.ViewLua = {
        left = self:AddComponent(self.go_table.obj_left, GeatherArrayEmbattle.New(self.go_table.obj_left)),
        right = self:AddComponent(self.go_table.obj_right, GeatherArrayInfo.New(self.go_table.obj_right))
    }
end
---界面的入口函数
---@param arrayId number 阵法id
function GeatherArrayInfoView:OnCreate(arrayId)
    self.Model = require "GeatherSoulArrayModel":GetInstance()
    self.CurArrayId = arrayId
    self.CurType = 1 ---等级:1星级:2
    self:InitPos()
    self:InitView()
    self:ShowArrow()
    self:RootUP()
end
---材料满足侧边标题显示
function GeatherArrayInfoView:RootUP()
    self.CurArrayData = self.Model:GetArrayInfo(self.CurArrayId)

    local res, count, id = self.Model:CheckItem(self.CurArrayData:GetLevelMaterial())

    self.go_table.aorimage_LevelUpBtnRed:SetActiveE(not res and 0 or 1)
    res, count, id = self.Model:CheckItem(self.CurArrayData:GetStarMaterial())
    self.go_table.aorimage_TuPoBtnRed:SetActiveE(not res and 0 or 1)
    local condition = self.CurArrayData:IsMaxLevel()

    if condition then
        self.go_table.aorimage_LevelUpBtnRed:SetActiveE(0)
    end
    condition = self.CurArrayData:IsMaxStar()
    if condition then
        self.go_table.aorimage_TuPoBtnRed:SetActiveE(0)
    else
        local Level = self.CurArrayData:StarUpConditionByLevel()
        if not Level then
            self.go_table.aorimage_TuPoBtnRed:SetActiveE(0)
        end
    end
end
---初始化界面
function GeatherArrayInfoView:InitView(arrayid)
    if arrayid then
        self.CurArrayId = arrayid
    end
    self:UpdateView()
end
function GeatherArrayInfoView:UpdateView()
    for k, v in pairs(self.ViewLua) do
        v:UpdateView(self.CurArrayId)
    end
    self.ResourceList = self.Model:GetCurArrayResourceList(self.CurArrayId, self.CurType)
    if self.resource == nil then
        self.resource =
            self:AddComponent(
            self.go_table.obj_resourceRoot,
            require("ResourceCompont").New(self.go_table.obj_resourceRoot, self.ResourceList)
        )
    else
        self.resource:RestRs(self.ResourceList)
    end
    self:ShowArrow()
    self.go_table.aorbtn_LevelUp:GetComponentE(_G.typeof(_G.CS.AorImage)).SpriteName =
        self.CurType == 1 and btnData.on.SpriteName or btnData.off.SpriteName
    self.go_table.aorbtn_TuPo:GetComponentE(_G.typeof(_G.CS.AorImage)).SpriteName =
        self.CurType == 2 and btnData.on.SpriteName or btnData.off.SpriteName
    self.go_table.aortext_LevelUp.color = self.CurType == 1 and btnData.on.Color or btnData.off.Color
    self.go_table.aortext_TuPo.color = self.CurType == 2 and btnData.on.Color or btnData.off.Color
    self:ShowResetBtn()
    self:RootUP()
end
---显示重置按钮
function GeatherArrayInfoView:ShowResetBtn()
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_Reset, self.Model:IsCanReset(self.CurArrayId))
end
---改变按钮状态
function GeatherArrayInfoView:ChangeBtnUI()
    ---修改资源
    self.ResourceList = self.Model:GetCurArrayResourceList(self.CurArrayId, self.CurType)
    if self.resource == nil then
        self.resource =
            self:AddComponent(
            self.go_table.obj_resourceRoot,
            require("ResourceCompont").New(self.go_table.obj_resourceRoot, self.ResourceList)
        )
    else
        self.resource:RestRs(self.ResourceList)
    end
    self.go_table.aorbtn_LevelUp:GetComponentE(_G.typeof(_G.CS.AorImage)).SpriteName =
        self.CurType == 1 and btnData.on.SpriteName or btnData.off.SpriteName
    self.go_table.aorbtn_TuPo:GetComponentE(_G.typeof(_G.CS.AorImage)).SpriteName =
        self.CurType == 2 and btnData.on.SpriteName or btnData.off.SpriteName
    self.go_table.aortext_LevelUp.color = self.CurType == 1 and btnData.on.Color or btnData.off.Color
    self.go_table.aortext_TuPo.color = self.CurType == 2 and btnData.on.Color or btnData.off.Color
end
---初始化阵法位置顺序
function GeatherArrayInfoView:InitPos()
    self.UnlockArray = {}
    local arrays = self.Model:GetArrayCfg()
    if arrays then
        for i = 1, #arrays do
            if self.Model:GetArrayUnlock(arrays[i].id) then
                _G.table.insert(self.UnlockArray, arrays[i].id)
            end
            if arrays[i].id == self.CurArrayId then
                self.CurIndex = #self.UnlockArray
            end
        end
    end
end
---显示箭头
function GeatherArrayInfoView:ShowArrow()
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_left, self.UnlockArray[self.CurIndex - 1])
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_right, self.UnlockArray[self.CurIndex + 1])
end
---根据索引找对应的阵法id
---@return number index
---@return number arrayId
function GeatherArrayInfoView:GetArrayId(index)
    local totalcount = #self.UnlockArray
    if index > totalcount then
        index = index % totalcount
    end
    return index, self.UnlockArray[index]
end
---切换阵法
---@return number arrayId
function GeatherArrayInfoView:ChangeArray(index)
    local _index, arrayid = self:GetArrayId(index)
    self.CurIndex = _index
    self:InitView(arrayid)
end
function GeatherArrayInfoView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.GeatherSoulArraySelectView.Name)

        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.GeatherSoulArraySelectView.Name)
        if view then
            view:InitView()
        end
        self:Close()
    elseif name == "@_aorbtn_help" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 56)
    elseif name == "@_aorbtn_Reset" then
        --重置
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.GeatherSoulArrayResetView.Name,
            self.CurArrayId,
            function()
                self:UpdateView()
            end
        )
    elseif name == "@_aorbtn_left" then
        --向左
        self:ChangeArray(self.CurIndex - 1)
    elseif name == "@_aorbtn_right" then
        --向右
        self:ChangeArray(self.CurIndex + 1)
    elseif name == "@_aorbtn_LevelUp" then
        --升级页签
        if self.CurType ~= 1 then
            self.CurType = 1
            self:ChangeBtnUI()
            self.ViewLua.right:UpdateView(self.CurArrayId, 1)
        end
    elseif name == "@_aorbtn_TuPo" then
        --突破页签
        if self.CurType ~= 2 then
            self.CurType = 2
            self:ChangeBtnUI()
            self.ViewLua.right:UpdateView(self.CurArrayId, 2)
        end
    end
end

function GeatherArrayInfoView:OnDestroy()
end

return GeatherArrayInfoView
