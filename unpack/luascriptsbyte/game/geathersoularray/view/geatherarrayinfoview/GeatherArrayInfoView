                                                _G.ConfigManager.ui_cfg.GeatherArrayInfoView.Name
                                            )
                                            -- if view and view.ViewLua then
                                            --     view.ViewLua.left:UpdateView(self.CurArrayData.Cfg.id)
                                            -- end
                                            if view then
                                                require "GeatherSoulArrayModel":GetInstance().effDanCi = true
                                                view:UpdateView(self.CurArrayData.Cfg.id)
                                            end

                                            -- end
                                            -- self:UpdateView(self.CurArrayData.Cfg.id)
                                            if call then
                                                call()
                                            end
                                        end
                                    )
                                end
                            )
                        else
                            if not _G.table.isEmptyOrNil(material) then
                                ---打开资源获取界面
                                for i = 1, #material do
                                    _G.StorageManager:GetInstance():CheckItemNew(material[i][1], material[i][2])
                                    break
                                end
                            end
                        end
                    end
                end
            else
                if self.isLongPress then
                    return
                end
                require "GeatherSoulArrayModel":GetInstance():LevelUp(
                    self.CurArrayData.Cfg.id,
                    1,
                    true,
                    function()
                        -- local _unlockPos = self.CurArrayData:GetUnlockPosCount()
                        -- if unlockPos < _unlockPos then
                        local view =
                            _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.GeatherArrayInfoView.Name)
                        -- if view and view.ViewLua then
                        --     view.ViewLua.left:UpdateView(self.CurArrayData.Cfg.id)
                        -- end
                        if view then
                            require "GeatherSoulArrayModel":GetInstance().effDanCi = true
                            view:UpdateView(self.CurArrayData.Cfg.id)
                        end

                        -- end
                        -- self:UpdateView(self.CurArrayData.Cfg.id)
                    end
                )
            end
        end
        self.UiDic.uplvTime = os.time()
    elseif name == "@_aorbtn_tupo" then
        if not self.CurArrayData:IsMaxStar() then
            require "GeatherSoulArrayModel":GetInstance():StarUp(
                self.CurArrayData.Cfg.id,
                function()
                    self:UpdateView(self.CurArrayData.Cfg.id)
                    local view =
                        _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.GeatherArrayInfoView.Name)
                    if view then
                        view:RootUP()
                    end
                end
            )
        end
    end
