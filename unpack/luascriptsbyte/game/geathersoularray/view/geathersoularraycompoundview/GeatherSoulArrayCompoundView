---@class GeatherSoulArrayCompoundView : UIBaseView	中文描述
---@field public go_table GeatherSoulArrayCompoundView_GoTable GoTable
local GeatherSoulArrayCompoundView = _G.BaseClass("GeatherSoulArrayCompoundView", _G.UIBaseView)
local GetLangPackValue = _G.GetLangPackValue
function GeatherSoulArrayCompoundView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
---界面的入口函数
function GeatherSoulArrayCompoundView:OnCreate()
    self.Coins = {}
    self.CompoundCfg = require "GeatherSoulArrayModel":GetInstance():GetCompoundCfg()
    local item, tb, coin
    for k, v in pairs(self.CompoundCfg) do
        item = _G.InstantiateObject(self.go_table.obj_functionItem, self.go_table.obj_function)
        tb = _G.GetAutoGoTable(item)
        self:CreateItem(v.Need, tb.obj_lowerRoot)
        self:CreateItem({k, v.Count}, tb.obj_nextRoot)
        tb.aortext_lowerDesc.text = self:GetDesc(v.Need[1])
        tb.aortext_nextDesc.text = self:GetDesc(k)
        if not self.Coins[v.Need[1]] then
            self.Coins[v.Need[1]] = true
            self:CreateCoin(v.Need[1])
        end
        if not self.Coins[k] then
            self.Coins[k] = true
            self:CreateCoin(k)
        end
    end
end
function GeatherSoulArrayCompoundView:CreateCoin(sid)
    local cfg = _G.StorageManager:GetInstance():GetItemDataClass(sid)
    local coin = _G.InstantiateObject(self.go_table.obj_coin, self.go_table.obj_coins)
    local tb = _G.GetAutoGoTable(coin)
    if not string.IsNullOrEmpty(cfg:GetIconPath()) then
        tb.aorrawimage_coin:LoadImage(
            cfg:GetIconPath(),
            function(image)
                image:SetNativeSize()
            end
        )
    end
    local type, id = _G.StorageManager:GetInstance():CheckSidType(sid)
    local count = _G.StorageManager:GetInstance():GetItemCountByID(id, sid)
    tb.aortext_coinCount.text = "X" .. count
end
---@return string desc
function GeatherSoulArrayCompoundView:GetDesc(sid)
    local type, id, data
    type, id = _G.StorageManager:GetInstance():CheckSidType(sid)
    data = _G.StorageManager:GetInstance():GetItemDataByID(id, sid)
    if data then
        return data:GetName()
    else
        return _G.LangUtil.GetLangPackValue(_G.ConfigManager.item_cfg[sid].Name)
    end
end
function GeatherSoulArrayCompoundView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:Close()
    end
end
function GeatherSoulArrayCompoundView:CreateItem(data, parent)
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        data,
        parent,
        function(tran)
            tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end
    )
end
function GeatherSoulArrayCompoundView:OnDestroy()
end

return GeatherSoulArrayCompoundView
