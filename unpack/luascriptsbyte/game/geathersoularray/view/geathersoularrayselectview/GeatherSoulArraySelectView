---@class GeatherSoulArraySelectView : UIBaseView    中文描述
---@field public go_table GeatherSoulArraySelectView_GoTable GoTable
local GeatherSoulArraySelectView = _G.BaseClass("GeatherSoulArraySelectView", _G.UIBaseView)
local GetLangPackValue = _G.GetLangPackValue
local card_skills_cfg = _G.ConfigManager.card_skills_cfg
function GeatherSoulArraySelectView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.looplist2_ArrayList:InitListView(0, _G.handler(self, self.FreshList))
end

local eff = {
    [105] = "ef_julingfazhen_green",
    [104] = "ef_julingfazhen_bule",
    [103] = "ef_julingfazhen_purple",
    [102] = "ef_julingfazhen_red",
    [101] = "ef_julingfazhen_yellow"
}
local effFaZhen = {
    [105] = "ef_julingfazhen_green_fazhen",
    [104] = "ef_julingfazhen_bule_fazhen",
    [103] = "ef_julingfazhen_purple_fazhen",
    [102] = "ef_julingfazhen_red_fazhen",
    [101] = "ef_julingfazhen_yellow_fazhen"
}

---界面的入口函数
---@param data activityPagesInfoTab
---@field Cfg formation_s_cfg[]
---@field model GeatherSoulArrayModel
---@field CardItemList GeatherSoulArraySelectView._obj_CardItem_GoTable[]
function GeatherSoulArraySelectView:OnCreate()
    self.ArrayItemList = {}
    self.Model = require "GeatherSoulArrayModel":GetInstance()
    self.Cfg = self.Model:GetArrayCfg()
    _G.DelayFrameDo(
        function()
            self:InitView()
            self.Model:RefreshRedPoint({3})
        end
    )
end

function GeatherSoulArraySelectView:GetArrayInfo(arrayid)
    return self.Model:GetArrayInfo(arrayid)
end

function GeatherSoulArraySelectView:InitView()
    self.CardItemList = {}
    if not self.ArrayCount then
        self.go_table.looplist2_ArrayList:SetListItemCount(#self.Cfg, true)
        self.ArrayCount = #self.Cfg
    else
        self.go_table.looplist2_ArrayList:RefreshAllShownItem()
    end
end

function GeatherSoulArraySelectView:FreshList(obj, index)
    if index < 0 then
        return
    end
    local item = obj:NewListViewItem("$_obj_Array")
    -- if index == 0 or index == self.ListCount - 1 then
    --     item = obj:NewListViewItem("$_obj_EmptySpace")
    -- else
    local x = index + 1
    local cfg = self.Cfg[x]
    item:SetName(cfg.id)
    local data = self:GetArrayInfo(cfg.id)
    local tb = _G.GetAutoGoTable(item, _G.handlerbind(self, self.ClickArrayBtn, cfg.id, x))
    self.ArrayItemList[x] = tb
    ---设置标题
    tb.aorimage_Name.SpriteName = cfg.name_Image

    --- 设置星级图片
    for i = 1, 5 do
        if i <= cfg.max_star then
            _G.GameUtil.SetActiveByCondition(tb["aorimage_fire" .. i], true)
            tb["aorimage_fire" .. i]:SetGray(i > data:GetStar())
        else
            _G.GameUtil.SetActiveByCondition(tb["aorimage_fire" .. i], false)
        end
    end
    ---法阵图标设置
    tb.aorrawimage_ArrayIcon:LoadImage(cfg.image)
    tb.obj_eff:ClearChildren()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg[effFaZhen[cfg.id]],
        tb.obj_eff,
        function(trans)
            trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
        end
    )
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg[eff[cfg.id]],
        tb.obj_eff,
        function(trans)
            trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
        end
    )
    ---阵法技能
    if card_skills_cfg[data:GetStarSkill()] then
        tb.aorrawimage_skill:LoadImage(card_skills_cfg[data:GetStarSkill()].icon)
    else
        tb.aorrawimage_skill.Alpha = 0
    end
    local unlock = data:IsUnlock(cfg.id)
    local CanUnlock = self.Model:CheckArrayCanUnlock(cfg.id)
    _G.GameUtil.SetActiveByCondition(tb.obj_Lock, not unlock)
    _G.GameUtil.SetActiveByCondition(tb.obj_UnLock, unlock)
    --_G.GameUtil.SetActiveByCondition(tb.obj_title, unlock)
    _G.GameUtil.SetActiveByCondition(tb.obj_title, false)
    _G.GameUtil.SetActiveByCondition(tb.obj_lockDes, not unlock and not CanUnlock)
    _G.GameUtil.SetActiveByCondition(tb.aorbtn_unlock, not unlock and CanUnlock)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_Up, self.Model:CanBuild(cfg.id))
    tb.obj_unlockRed:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.GeatherArrayUnlock.id, cfg.id)
    if unlock then
        ---法阵等级文本
        tb.aortext_Title.text = GetLangPackValue(90021800050) .. data:GetLevel()
        self:ShowCard(tb, cfg.id)
    else
        tb.aortext_Des.text = GetLangPackValue(cfg.way)
    end
    ---TODO 绿色提升图标显示 根据是否可突破是否可升级显示

    ---主界面显示阵法技能描述 ZHJ-26105
    ---先获取当前阵法的星级数，然后获取星级数对应的技能描述文本
    ---再将文本设置到右边的文本框中（不管阵法有没有解锁）

    if (data:GetStar() > 0) then
        tb.aortext_RightSkillDes.text = GetLangPackValue(card_skills_cfg[data:GetSkillByStar(data:GetStar())].describe1)
    else
        tb.aortext_RightSkillDes.text = GetLangPackValue(card_skills_cfg[data:GetSkillByStar(0)].describe1)
    end
    tb.gameObject:SetActiveE(0)
    _G.DelayDo(
        0.0667 * index,
        function()
            tb.gameObject:SetActiveE(1)
        end
    )
    return item
end

---展示阵法卡牌
---@param go gameobject 卡牌节点
---@param arrayId number 阵法id
function GeatherSoulArraySelectView:ShowCard(go, arrayId)
    self.CardItemList[arrayId] = {}
    for i = 1, 5 do
        local cardGo = self.CardItemList[arrayId][i]
        if not cardGo then
            cardGo = _G.GetAutoGoTable(go["obj_CardItem" .. i], _G.handlerbind(self, self.ClickCard, arrayId, i))
            self.CardItemList[arrayId][i] = cardGo
        end
        ---是否解锁,是否可上阵
        local isUnlockPos, isCanEmbattle = self.Model:CheckEmbattle(arrayId, i)
        _G.GameUtil.SetActiveByCondition(cardGo.aorimage_suo, not isUnlockPos)
        _G.GameUtil.SetActiveByCondition(cardGo.aorimage_jia, isCanEmbattle)
        _G.GameUtil.SetActiveByCondition(cardGo.obj_card, isUnlockPos and not isCanEmbattle)
        if isUnlockPos and not isCanEmbattle then
            local card = require("ItemCardAllView").New(cardGo.obj_card)
            local carddata =
                _G.StorageManager:GetInstance():GetItemDataByID(
                _G.StorageID.Card,
                self.Model:GetCardByArrayIndex(arrayId, i)
            )
            card:ShowCardData(carddata, nil, true, true)
        end
    end
end

---点击阵容卡牌
---@param arrayId number 阵法id
---@param index number 槽位
function GeatherSoulArraySelectView:ClickCard(go, isOn, arrayid, index)
    local isUnlockPos, isCanEmbattle, level = self.Model:CheckEmbattle(arrayid, index)
    if isUnlockPos then
        if isCanEmbattle then
            local y = index
            for i = 5, 1, -1 do
                local isUnlockPoss, isCanEmbattles, level =
                    require "GeatherSoulArrayModel":GetInstance():CheckEmbattle(arrayid, i)
                if isUnlockPoss then
                    if isCanEmbattles then
                        y = i
                    end
                end
            end
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.GeatherSoulArraySelectCardView.Name,
                arrayid,
                function(uid)
                    ---上阵
                    self.Model:SetCard(
                        uid,
                        arrayid,
                        y,
                        arrayid,
                        ---@param _arrayid number 已上阵的移除
                        function(_arrayid, _index)
                            if _arrayid and _index then
                                _G.GameUtil.SetActiveByCondition(
                                    self.CardItemList[_arrayid][_index].aorimage_suo,
                                    false
                                )
                                _G.GameUtil.SetActiveByCondition(self.CardItemList[_arrayid][_index].aorimage_jia, true)
                                _G.GameUtil.SetActiveByCondition(self.CardItemList[_arrayid][_index].obj_card, false)
                            end
                            _G.GameUtil.SetActiveByCondition(self.CardItemList[arrayid][y].aorimage_suo, false)
                            _G.GameUtil.SetActiveByCondition(self.CardItemList[arrayid][y].aorimage_jia, false)
                            _G.GameUtil.SetActiveByCondition(self.CardItemList[arrayid][y].obj_card, true)
                            local card = require("ItemCardAllView").New(self.CardItemList[arrayid][y].obj_card)
                            local carddata = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
                            card:ShowCardData(carddata, nil, true, true)
                            _G.PopWindowManager:GetInstance():ShowAllTips(780106)
                        end
                    )
                end
            )
        else
            local card =
                _G.StorageManager:GetInstance():GetItemDataByID(
                _G.StorageID.Card,
                self.Model:GetCardByArrayIndex(arrayid, index)
            )
            _G.PopWindowManager:GetInstance():ShowAllTips(
                780101,
                _G.GetLangPackValue(90000010522, _G.GetLangPackValue(card.cfg.Name)),
                function()
                    ---下阵
                    self.Model:SetCard(
                        self.Model:GetCardByArrayIndex(arrayid, index),
                        arrayid,
                        index,
                        0,
                        function()
                            _G.GameUtil.SetActiveByCondition(self.CardItemList[arrayid][index].aorimage_suo, false)
                            _G.GameUtil.SetActiveByCondition(self.CardItemList[arrayid][index].aorimage_jia, true)
                            _G.GameUtil.SetActiveByCondition(self.CardItemList[arrayid][index].obj_card, false)
                        end
                    )
                end
            )
        end
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(
            780102,
            _G.GetLangPackValue(90000010523, _G.GetLangPackValue(self.Model:GetArrayInfo(arrayid).Cfg.name), level)
        )
    end
end

---@param arrayId number 阵容id
function GeatherSoulArraySelectView:ClickArrayBtn(go, isOn, arrayId, index)
    local data = self:GetArrayInfo(arrayId)
    local name = go:GetName()
    if name == "@_aorbtn_skillClick" then
        require("CommonTipManager"):GetInstance():OpenGeatherSoulSkillTip(data)
    elseif name == "@_aorbtn_click" then
        if data:IsUnlock() then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GeatherArrayInfoView.Name, arrayId)
            _G.DelayDo(
                0.1,
                function()
                    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.GeatherSoulArraySelectView.Name)
                end
            )
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(780102, GetLangPackValue(data.Cfg.way))
        end
    elseif name == "@_aorbtn_unlock" then
        self.Model:UnlockArray(
            arrayId,
            function()
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.GeatherActivateView.Name,
                    arrayId,
                    function()
                        self.ArrayItemList[index].obj_Lock:SetActiveE(0)
                        self.ArrayItemList[index].obj_UnLock:SetActiveE(1)
                        self:ShowCard(self.ArrayItemList[index], arrayId)
                        self.ArrayItemList[index].aortext_Title.text = GetLangPackValue(90021800050) .. 1
                        --self.ArrayItemList[index].obj_title:SetActiveE(1)
                        _G.GameUtil.SetActiveByCondition(
                            self.ArrayItemList[index].aorimage_Up,
                            self.Model:CanBuild(self.Cfg[index].id)
                        )
                    end
                )
            end
        )
    end
end

function GeatherSoulArraySelectView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:Close()
    elseif name == "@_aorbtn_help" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 56)
    end
end

function GeatherSoulArraySelectView:OnDestroy()
end

return GeatherSoulArraySelectView
