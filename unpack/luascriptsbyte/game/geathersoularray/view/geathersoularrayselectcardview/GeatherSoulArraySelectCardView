---@class GeatherSoulArraySelectCardView : UIBaseView	中文描述
---@field public go_table GeatherSoulArraySelectCardView_GoTable GoTable
local GeatherSoulArraySelectCardView = _G.BaseClass("GeatherSoulArraySelectCardView", _G.UIBaseView)
local GeatherSoulArrayModel = require "GeatherSoulArrayModel"
local CS = _G.CS
local typeof = _G.typeof
local card_cfg = _G.ConfigManager.card_cfg
function GeatherSoulArraySelectCardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_close2"] = self.Close,
        ["@_aorbtn_close"] = self.Close,
        ["@_aorbtn_queding"] = self.Select,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    self.go_table.scrollloopvectical_CardBag:InitItemData(0, _G.handler(self, self.RefreshBagItem))
    self.ElementTb = _G.GetAutoGoTable(self.go_table.obj_Elements, _G.handler(self, self.OnClickElement))
end

---界面的入口函数
function GeatherSoulArraySelectCardView:OnCreate(arrayid, closecall)
    self.CloseCall = closecall
    self.CardItemList = {}
    local Cardlist = _G.StorageManager:GetInstance():GetMaxPowerCards()
    ---五行卡牌表
    self.cardList = {}
    ---所有卡牌表
    self.CardList = {}

    for k, v in pairs(Cardlist) do
        if not self.cardList[v:GetElement()] then
            self.cardList[v:GetElement()] = {}
        end
        if not (GeatherSoulArrayModel:GetInstance():CheckInArray(v.uid) == arrayid) then
            _G.table.insert(self.cardList[v:GetElement()], v)
            _G.table.insert(self.CardList, v)
        end
    end
    for key, value in pairs(self.cardList) do
        _G.SortList(
            self.cardList[key],
            function(data)
                local power = data:GetPower()
                local star = data.star
                data:GetStar()
                local level = data:GetLevel()
                return power, level, star, data.uid
            end
        )
    end

    _G.SortList(
        self.CardList,
        function(data)
            local power = data:GetPower()
            local star = data.star
            data:GetStar()
            local level = data:GetLevel()
            return power, level, star, data.uid
        end
    )
    for i = 1, #self.CardList do
        if not GeatherSoulArrayModel:GetInstance():CheckInArray(self.CardList[i].uid) then
            self.CurSelectCard = self.CardList[i].uid
            break
        end
    end
    self.ElementTb.toggle_0.isOn = true
end

---点击元素
function GeatherSoulArraySelectCardView:OnClickElement(go, isOn)
    ---当前循环列表选中index
    self.curSelectIndex = 0
    if not isOn then
        return
    end
    local name = go:GetName()
    local s_type = _G.string.replace(name, "$_toggle_", "")
    local type = _G.tonumber(s_type)
    local cardlist
    if type == self.Index then
        return
    else
        self.Index = type
    end
    if self.Index == 0 then
        cardlist = self.CardList
    else
        cardlist = self.cardList[self.Index]
    end
    if cardlist and #cardlist > 0 then
        if self.count ~= #cardlist then
            self.go_table.scrollloopvectical_CardBag:UpdateCount(#cardlist)
            self.count = #cardlist
        else
            self.go_table.scrollloopvectical_CardBag:UpdateAllItem()
        end
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(320114)
        self.go_table.scrollloopvectical_CardBag:UpdateAllItem()
    end
    self.go_table.aorbtn_queding.enabled = self.CurSelectCard and true or false
    self.go_table.aorbtn_queding:SetGray(self.CurSelectCard == nil)
    self.ElementTb["toggle_" .. self.Index].isOn = true
end
function GeatherSoulArraySelectCardView:RefreshBagItem(index, obj)
    local x = index + 1
    local instanceID = obj:GetInstanceIDE()
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.ClickCard, instanceID))
    local cardlist
    if self.Index == 0 then
        cardlist = self.CardList
    else
        cardlist = self.cardList[self.Index]
    end
    if cardlist then
        if not self.CardItemList[instanceID] then
            self.CardItemList[instanceID] = {}
            local lua = require("ItemCardBodyBaseView").New(tb.obj_node)
            self.CardItemList[instanceID].lua = lua
            self.CardItemList[instanceID].tb = tb
        else
            self.CardItemList[instanceID].tb.gameObject:SetActiveE(1)
        end
        self.CardItemList[instanceID].uid = cardlist[x].uid
        obj:SetName(cardlist[x].sid)
        self.CardItemList[instanceID].lua:ShowCardData(cardlist[x], nil, true)
        self.CardItemList[instanceID].lua.gameObject:SetName(cardlist[x].sid)
        if cardlist[x].uid == self.CurSelectCard then
            self.curSelectIndex = instanceID
        end
        local arrayid, index = GeatherSoulArrayModel:GetInstance():CheckInArray(cardlist[x].uid)
        _G.GameUtil.SetActiveByCondition(tb.obj_mask, cardlist[x].uid == self.CurSelectCard or arrayid)
        _G.GameUtil.SetActiveByCondition(tb.aorimage_gou, cardlist[x].uid == self.CurSelectCard)
        _G.GameUtil.SetActiveByCondition(tb.obj_isSet, arrayid and cardlist[x].uid ~= self.CurSelectCard)
        if arrayid then
            local skill = GeatherSoulArrayModel:GetInstance().CurArrayDatas[arrayid]:GetStarSkill()
            if _G.ConfigManager.card_skills_cfg[skill] then
                if not string.IsNullOrEmpty(_G.ConfigManager.card_skills_cfg[skill].icon) then
                    tb.aorrawimage_skill:LoadImage(
                        _G.ConfigManager.card_skills_cfg[skill].icon,
                        function(image)
                            image:SetNativeSize()
                        end
                    )
                end
            end
        end
    else
        if self.CardItemList[instanceID] then
            self.CardItemList[instanceID].tb.gameObject:SetActiveE(0)
        end
    end
end
function GeatherSoulArraySelectCardView:ClickCard(go, isOn, instanceID)
    if self.curSelectIndex ~= 0 then
        if self.curSelectIndex ~= instanceID then
            _G.GameUtil.SetActiveByCondition(self.CardItemList[self.curSelectIndex].tb.obj_mask, false)
        else
            return
        end
    end
    ---取消选择已上阵 恢复已上阵蒙版
    if self.CardItemList[self.curSelectIndex] then
        local arrayid, index =
            GeatherSoulArrayModel:GetInstance():CheckInArray(self.CardItemList[self.curSelectIndex].uid)
        if arrayid then
            local tb = self.CardItemList[self.curSelectIndex].tb
            _G.GameUtil.SetActiveByCondition(tb.obj_mask, true)
            _G.GameUtil.SetActiveByCondition(tb.aorimage_gou, false)
            _G.GameUtil.SetActiveByCondition(tb.obj_isSet, arrayid)
            local skill = GeatherSoulArrayModel:GetInstance().CurArrayDatas[arrayid]:GetStarSkill()
            if _G.ConfigManager.card_skills_cfg[skill] then
                if not string.IsNullOrEmpty(_G.ConfigManager.card_skills_cfg[skill].icon) then
                    tb.aorrawimage_skill:LoadImage(
                        _G.ConfigManager.card_skills_cfg[skill].icon,
                        function(image)
                            image:SetNativeSize()
                        end
                    )
                end
            end
        end
    end
    self.curSelectIndex = instanceID
    self.CurSelectCard = self.CardItemList[instanceID].uid
    _G.GameUtil.SetActiveByCondition(self.CardItemList[instanceID].tb.obj_mask, true)
    _G.GameUtil.SetActiveByCondition(self.CardItemList[instanceID].tb.aorimage_gou, true)
    _G.GameUtil.SetActiveByCondition(self.CardItemList[instanceID].tb.obj_isSet, false)
    self.go_table.aorbtn_queding.enabled = self.CurSelectCard and true or false
    self.go_table.aorbtn_queding:SetGray(self.CurSelectCard == nil)
end
function GeatherSoulArraySelectCardView:Select()
    if not self.CurSelectCard then
        self:Close()
    else
        if self.CloseCall then
            self.CloseCall(self.CurSelectCard)
        end
        self:Close()
    end
end
--region 点击
---按钮点击事件在这里派发
function GeatherSoulArraySelectCardView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end
return GeatherSoulArraySelectCardView
