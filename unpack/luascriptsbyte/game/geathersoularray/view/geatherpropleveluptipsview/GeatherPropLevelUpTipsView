---@class GeatherPropLevelUpTipsView : UIBaseView	卡牌升级解锁技能 提示界面
---@field public go_table GeatherPropLevelUpTipsView_GoTable GoTable
local GeatherPropLevelUpTipsView = _G.BaseClass("GeatherPropLevelUpTipsView", _G.UIBaseView)
--_G.GeatherPropLevelUpTipsView = GeatherPropLevelUpTipsView

local CS = _G.CS
local typeof = _G.typeof

function GeatherPropLevelUpTipsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.OnClick_Close,
        ["@_aorbtn_bossSkillbtn"] = self.OnClick_Skill,
        ["@_aorbtn_Done"] = self.OnClick_Done,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }

    self.ConstDic = {
        lvtext = "Lv.%s"
    }
end

---@field skillID number 提升的技能id
---@field subList table 消耗资源
---@field Call function<boolean> true点击了确定
---@class params_GeatherPropLevelUpTipsView

---界面的入口函数
---@param Data params_GeatherPropLevelUpTipsView
function GeatherPropLevelUpTipsView:OnCreate(Data)
    -- self.Data = Data
    self.skillId = Data.skillID
    self.Call = Data.Call
    self.subList = Data.subList
    self:SetData()
    _G.AudioManager.PlayAudioByAudioCfgID(2005)
end
function GeatherPropLevelUpTipsView:SetData()
    local islock = true
    -- if self.go_table.ResConsume == nil then
    --     self.go_table.ResConsume =
    --         self:AddComponent(
    --         self.go_table.obj_consume,
    --         require("ConsumeCompont").New(self.go_table.obj_consume, self.subList, nil, nil, true)
    --     )
    -- else
    --     self.go_table.ResConsume:RestRs(self.subList)
    -- end

    local skillcfg = _G.ConfigManager.card_skills_cfg[self.skillId]
    if skillcfg ~= nil then
        self:SetSkillLock()
    end
    self.go_table.aortext_TitleName.text = _G.LangUtil.GetLangPackValue(90020600037)
end

function GeatherPropLevelUpTipsView:SetSkillLock()
    local skillcfg = _G.ConfigManager.card_skills_cfg[self.skillId]
    local go = _G.GetAutoGoTable(self.go_table.obj_skillLock, _G.handler(self, self.OnClickBtn))

    require("CardInfoManager").LoadRawImage(go.aorrawimage_skill, skillcfg.icon)
    go.aortext_name.text = _G.LangUtil.GetLangPackValue(skillcfg.name1)
    go.aorimage_nuqi:SetActiveE(skillcfg.skill_pos == 1 and 1 or 0)
    go.aorbtn_bossSkillbtn:GetParent():SetName(tostring(self.skillId))
end

--region --------------------------------------点击事件--------

function GeatherPropLevelUpTipsView:OnClick_Skill(go, isOn, name)
    local skillid = go:GetParent():GetName()
    skillid = tonumber(skillid)
    if skillid ~= nil then
        require("CommonTipManager"):GetInstance():OpenSkillTip(skillid)
    end
end
function GeatherPropLevelUpTipsView:OnClick_Done(go, isOn, name)
    self:CloseView(true)
end
function GeatherPropLevelUpTipsView:OnClick_Close(go, isOn, name)
    self:CloseView()
end

--endregion

function GeatherPropLevelUpTipsView:CloseView(isTrue)
    if self.Call ~= nil then
        self.Call(isTrue)
    end
    self:Close()
end

---按钮点击事件在这里派发
function GeatherPropLevelUpTipsView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

return GeatherPropLevelUpTipsView
