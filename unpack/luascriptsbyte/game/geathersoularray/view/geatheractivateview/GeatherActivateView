---@class GeatherActivateView : UIBaseView	中文描述
---@field public go_table GeatherActivateView_GoTable GoTable
local GeatherActivateView = _G.BaseClass("GeatherActivateView", _G.UIBaseView)
--_G.GeatherActivateView = GeatherActivateView
function GeatherActivateView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param data CombineData
function GeatherActivateView:OnCreate(arrayid, closeCall)
    local data = require "GeatherSoulArrayModel":GetInstance():GetArrayInfo(arrayid)
    local skill = data:GetStarSkill()
    self.CloseCall = closeCall
    local cfg = _G.ConfigManager.card_skills_cfg[skill]
    if cfg then
        if not string.IsNullOrEmpty(cfg.icon) then
            self.go_table.aorrawimage_icon:LoadImage(cfg.icon)
        end
        self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(cfg.name1)
        self.go_table.aortext_desc.text = _G.LangUtil.GetLangPackValue(cfg.describe1)
        self.canclick = false
    end
    _G.DelayDo(
        0.9,
        function()
            self.canclick = true
        end
    )
end
function GeatherActivateView:EscClose()
    self:Close()
end
---按钮点击事件在这里派发
function GeatherActivateView:OnClickBtn(go, isOn)
    if not self.canclick then
        return
    end
    if go == self.go_table.aorbtn_close then
        if self.CloseCall then
            self.CloseCall()
        end
        self:Close()
    end
end

return GeatherActivateView
