---@class GeatherPropLevelUpView : UIBaseView	卡牌属性等级提升
---@field public go_table GeatherPropLevelUpView_GoTable GoTable
local GeatherPropLevelUpView = _G.BaseClass("GeatherPropLevelUpView", _G.UIBaseView)
--_G.GeatherPropLevelUpView = GeatherPropLevelUpView

local CS = _G.CS
local typeof = _G.typeof

function GeatherPropLevelUpView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["@_aorbtn_bossSkillbtn"] = self.OnClick_Skill,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }

    self.ConstDic = {
        lvstr = "Lv. <color=#95e7ff>%s</color>"
    }

    self.go_table_skill = _G.GetAutoGoTable(self.go_table.obj_skillLock, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function GeatherPropLevelUpView:OnCreate(Data)
    self.ArrayId = Data.arrayId
    self.starL = Data.starL
    self.starR = Data.starR
    self:SetData(Data)
end

function GeatherPropLevelUpView:SetData()
    self:ShowLv()
    self:ShowProp()
    self:SetSkill()
    _G.AudioManager.PlayAudioByAudioCfgID(2024)
end

function GeatherPropLevelUpView:ShowLv()
    self.go_table.aortext_LvL.text = _G.string.format(self.starL)
    self.go_table.aortext_LvR.text = _G.string.format(self.starR)
end

function GeatherPropLevelUpView:ShowProp()
    local PropL = require "GeatherSoulArrayModel":GetInstance():ClaAllTeamAttributeByStar(self.starL, self.ArrayId)
    local PropR = require "GeatherSoulArrayModel":GetInstance():ClaAllTeamAttributeByStar(self.starR, self.ArrayId)

    local showlist = {
        _G.AttrType.max_hp,
        _G.AttrType.atk,
        _G.AttrType.def,
        _G.AttrType.bre
    }

    local go_name = "obj_prop (%s)"
    ---@param value AttrTypeInfo
    for i, value in pairs(showlist) do
        local name = _G.string.format(go_name, i)
        local obj = self.go_table[name]
        if obj ~= nil then
            local go = _G.GetAutoGoTable(obj)
            local numL = PropL.attriOther[value.key]
            local numR = PropR.attriOther[value.key]
            self:SetProp(go, value.des, numL, numR)
        end
    end
end
function GeatherPropLevelUpView:SetProp(go, name, numL, numR)
    go.aortext_nameL.text = name
    go.aortext_nameR.text = name
    if numL then
        go.aortext_numL.text = _G.Mathf.Floor(numL)
    end
    if numR then
        go.aortext_numR.text = _G.Mathf.Floor(numR)
    end
end

function GeatherPropLevelUpView:SetSkill()
    ---@type params_CheckCardLvUpSkill

    local arrayData = require "GeatherSoulArrayModel":GetInstance():GetArrayInfo(self.ArrayId)
    local SkillId = arrayData:GetStarSkill()
    if SkillId ~= nil then
        local go = self.go_table_skill
        -- local isjs = true
        local skillcfg = _G.ConfigManager.card_skills_cfg[SkillId]
        local islock = false
        if skillcfg ~= nil then
            islock = skillcfg.level == 1
            self.go_table.aorimage_shen:SetActiveE(islock and 1 or 0)
        end

        if skillcfg ~= nil then
            require("CardInfoManager").LoadRawImage(go.aorrawimage_skill, skillcfg.icon)
            --go.aortext_skilllevel.text = _G.tostring(skillcfg.level)
            go.aorimage_nuqi:SetActiveE(skillcfg.skill_pos == 1 and 1 or 0)
            go.aorbtn_bossSkillbtn:GetParent():SetName(_G.tostring(self.skillId))
        end
    end
end

---按钮点击事件在这里派发
function GeatherPropLevelUpView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

function GeatherPropLevelUpView:OnClick_Skill(go)
    local skillid = go:GetParent():GetName()
    skillid = _G.tonumber(skillid)
    if skillid ~= nil then
        require("CommonTipManager"):GetInstance():OpenSkillTip(skillid)
    end
end

function GeatherPropLevelUpView:CloseView()
    self:Close()
end

return GeatherPropLevelUpView
