local SkillTipView = require "SkillTipView"
local SkillTipModel = require "SkillTipModel"
---@class GeatherSoulArrayTipsView : Component	中文描述
---@field go_table _obj_GeatherSoulArrayTipsView_GoTable
local GeatherSoulArrayTipsView = _G.BaseClass("GeatherSoulArrayTipsView", SkillTipView)

local CS = _G.CS
local typeof = _G.typeof
local GetLangPackValue = _G.GetLangPackValue
local GetAutoGoTable = _G.GetAutoGoTable

---创建对象时,入口构造函数
function GeatherSoulArrayTipsView:OnCreate()
end

---销毁对象时,析构函数
function GeatherSoulArrayTipsView:OnDestroy()
end

---@param data GeatherArrayBaseData
function GeatherSoulArrayTipsView:Init(data, callFunction)
    ---@type formation_s_cfg
    local cfg = data.Cfg
    local lv = data:GetLevel()
    self.go_table.aorrawimage_icon:LoadImage(cfg.image)
    self.go_table.aortext_name.text = GetLangPackValue(cfg.name)
    self.go_table.aortext_level.text = GetLangPackValue(90021800050) .. lv
    for i = 1, 5 do
        self.go_table["aorimage_fire" .. i]:SetGray(i > data:GetStar())
    end
    local skill = SkillTipModel.New()
    skill:Init(data:GetStarSkill())
    self.go_table.aortext_SkillDes.text = GetLangPackValue(skill.skillData[1].describe1)

    local allAttr = data:GetLevelAllAttrByLevel(lv)
    local selectAttr = data:GetLevelSelectAttrByLevel(lv)
    local scale = data:GetStarAllAttr()

    local num ,attr, tb
    for i = 1, 4 do
        attr = allAttr[i]
        num = tonumber(attr[3]) * scale
        num = _G.AttributeClassManager:GetInstance():GetShowProp(attr[1], attr[2], num, 0.000001)
        tb = GetAutoGoTable(self.go_table["obj_prop"..i])
        tb.aortext_name.text = GetLangPackValue(_G.ConfigManager.type_attribute_cfg[_G.AttrType[attr[1]].ID].name)
        tb.aortext_value.text = num
    end
    for i = 5, 6 do
        attr = selectAttr[i - 4]
        num = tonumber(attr[3]) * scale
        num = _G.AttributeClassManager:GetInstance():GetShowProp(attr[1], attr[2], num, 0.000001)
        tb = GetAutoGoTable(self.go_table["obj_prop"..i])
        tb.aortext_name.text = GetLangPackValue(_G.ConfigManager.type_attribute_cfg[_G.AttrType[attr[1]].ID].name)
        tb.aortext_value.text = num
    end

end
function GeatherSoulArrayTipsView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Close then
        if self.callback then
            self.callback()
            self.callback = nil
        end
        self.view:CloseTip(_G.TipType.GeatherSoulArray)
    end
end
return GeatherSoulArrayTipsView
