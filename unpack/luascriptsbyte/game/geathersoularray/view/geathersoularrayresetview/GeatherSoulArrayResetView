---@class GeatherSoulArrayResetView : UIBaseView	中文描述
---@field public go_table GeatherSoulArrayResetView_GoTable GoTable
local GeatherSoulArrayResetView = _G.BaseClass("GeatherSoulArrayResetView", _G.UIBaseView)
function GeatherSoulArrayResetView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
---界面的入口函数
---@param arrayId number 阵法id
function GeatherSoulArrayResetView:OnCreate(arrayId, closeCall)
    self.CloseCall = closeCall
    self.Model = require "GeatherSoulArrayModel":GetInstance()
    self.CurArrayData = self.Model:GetArrayInfo(arrayId)
    self.Time = self.Model:GetResetTime()
    self:InitView()
end
---初始化界面
function GeatherSoulArrayResetView:InitView()
    self.go_table.aorrawimage_arrayIcon:LoadImage(
        self.CurArrayData.Cfg.image,
        function(image)
            image:SetNativeSize()
        end
    )
    self:RefreshView()
    local level = self.CurArrayData:GetLevel()
    local star = self.CurArrayData:GetStar()
    local itemArr = {}
    local temp = {}
    temp = self.CurArrayData:GetMaterialByLevel(level)
    if not _G.table.isEmptyOrNil(temp) then
        for k, v in pairs(temp) do
            if not itemArr[v[1]] then
                itemArr[v[1]] = v[2]
            else
                itemArr[v[1]] = itemArr[v[1]] + v[2]
            end
        end
    end
    temp = self.CurArrayData:GetMaterialByStar(star)
    if not _G.table.isEmptyOrNil(temp) then
        for k, v in pairs(temp) do
            if not itemArr[v[1]] then
                itemArr[v[1]] = v[2]
            else
                itemArr[v[1]] = itemArr[v[1]] + v[2]
            end
        end
    end
    if not _G.table.isEmptyOrNil(itemArr) then
        for k, v in pairs(itemArr) do
            _G.StorageManager:GetInstance():GetItemBaseView(
                k,
                v,
                self.go_table.obj_items,
                function(tran)
                    tran.gameObject:SetRectTransformSize(88, 88)
                    tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
            )
        end
    end
end
function GeatherSoulArrayResetView:RefreshView()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    local res, time = self.Model:CanRest()
    self.countdown = time
    self.go_table.aorbtn_reset:SetGray(not res)
    if not res then
        self.go_table.aortext_reset.color = _G.Color.New(67 / 255, 64 / 255, 73 / 255, 1)
    else
        self.go_table.aortext_reset.color = _G.Color.New(145 / 255, 72 / 255, 1 / 255, 1)
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.aortext_countdown, not res)
    if not res then
        local _time = _G.TimeUtil.TranslateSecond(self.countdown)
        local str = ""
        if _time.day > 0 then
            str = _G.GetLangPackValue(90028010120, _time.day, _time.hour, _time.min)
        elseif _time.hour > 0 then
            str = _G.GetLangPackValue(90028010121, _time.hour, _time.min)
        else
            str = _G.GetLangPackValue(90028010122, _time.min, _time.sec)
        end
        self.go_table.aortext_countdown.text = _G.GetLangPackValue(90000001085) .. str
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false)
        self.timer:Start()
    end
end
function GeatherSoulArrayResetView:UpdateTime(elapsed)
    self.countdown = self.countdown - elapsed
    if self.countdown <= 0 then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        self:RefreshView()
    else
        local time = _G.TimeUtil.TranslateSecond(Mathf.RoundToInt(self.countdown))
        local str = ""
        if time.day > 0 then
            str = _G.GetLangPackValue(90028010120, time.day, time.hour, time.min)
        elseif time.hour > 0 then
            str = _G.GetLangPackValue(90028010121, time.hour, time.min)
        else
            str = _G.GetLangPackValue(90028010122, time.min, time.sec)
        end

        self.go_table.aortext_countdown.text = _G.GetLangPackValue(90000001085) .. str
    end
end
function GeatherSoulArrayResetView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_close2" then
        self:Close()
    elseif name == "@_aorbtn_reset" then --重置
        if self.Model:CanRest() then
            self.Model:Reset(
                self.CurArrayData.Cfg.id,
                function()
                    if self.CloseCall then
                        self.CloseCall()
                    end
                    self:Close()
                end
            )
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(780105)
        end
    end
end
function GeatherSoulArrayResetView:EscClose()
    self:Close()
end
function GeatherSoulArrayResetView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return GeatherSoulArrayResetView
