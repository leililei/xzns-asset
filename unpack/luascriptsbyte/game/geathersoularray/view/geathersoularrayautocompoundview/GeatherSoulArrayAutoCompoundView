---@class GeatherSoulArrayAutoCompoundView : UIBaseView	中文描述
---@field public go_table GeatherSoulArrayAutoCompoundView_GoTable GoTable
local GeatherSoulArrayAutoCompoundView = _G.BaseClass("GeatherSoulArrayAutoCompoundView", _G.UIBaseView)
local GetLangPackValue = _G.GetLangPackValue
local exchange_cfg = _G.ConfigManager.exchange_cfg
function GeatherSoulArrayAutoCompoundView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
---界面的入口函数
---@param material formation_s_level_cfg.material
---@param table compoundList 合成公式 <exchange_cfg.id,count>
function GeatherSoulArrayAutoCompoundView:OnCreate(material, compoundList, count, callback)
    self.CompoundList = compoundList
    self.SureCall = callback
    for k, v in pairs(compoundList) do
        if v.consumeCount > 0 then
            self:CreateCoin(v.consumeSid, v.consumeCount)
        end
    end
    local cfg = _G.StorageManager:GetInstance():GetItemDataClass(material[1][1])
    self.go_table.aortext_text.text = GetLangPackValue(90000001088)
    self.go_table.aortext_text1.text = GetLangPackValue(90000001089, count)
    if not _G.string.IsNullOrEmpty(cfg:GetIconPath()) then
        self.go_table.aorrawimage_image:LoadImage(cfg:GetIconPath())
    end
end
function GeatherSoulArrayAutoCompoundView:CreateCoin(sid, count)
    local cfg = _G.StorageManager:GetInstance():GetItemDataClass(sid)
    local coin = _G.InstantiateObject(self.go_table.obj_coin, self.go_table.obj_coins)
    local tb = _G.GetAutoGoTable(coin)
    if not _G.string.IsNullOrEmpty(cfg:GetIconPath()) then
        tb.aorrawimage_coin:LoadImage(
            cfg:GetIconPath(),
            function(image)
                image:SetNativeSize()
            end
        )
    end
    tb.aortext_coinCount.text = "X" .. count
end
function GeatherSoulArrayAutoCompoundView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_close" or name == "@_aorbtn_2" then
        self:Close()
    elseif name == "@_aorbtn_1" then
        require "GeatherSoulArrayModel":GetInstance():Exchange(
            self.CompoundList,
            function()
                if self.SureCall then
                    self.SureCall(_G.handler(self, self.Close))
                end
            end
        )
    end
end
function GeatherSoulArrayAutoCompoundView:OnDestroy()
end

return GeatherSoulArrayAutoCompoundView
