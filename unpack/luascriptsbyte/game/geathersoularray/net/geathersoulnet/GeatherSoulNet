local base = require "BaseGameNet"
---@class GeatherSoulNet : BaseGameNet	通信协议
local GeatherSoulNet = _G.BaseClass("GeatherSoulNet", base)

---@return GeatherSoulNet GeatherSoulNet
function GeatherSoulNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求信息
---@param callback function 完成回调
function GeatherSoulNet:GetInfo(callback)
    local item = _G.ConfigManager.net_map.game_formation_s_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end
---设置卡牌上下阵
---@param callback function 完成回调
function GeatherSoulNet:SetCard(pb, callback)
    local item = _G.ConfigManager.net_map.game_formation_s_set
    local port = base.Access(self, item, pb, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end
---解锁聚灵法阵
---@param callback function 完成回调
function GeatherSoulNet:UnlockArray(sid, callback)
    local item = _G.ConfigManager.net_map.game_formation_s_unlock
    local port = base.Access(self, item, {sid = sid}, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end
---聚灵法阵升级
---@param callback function 完成回调
function GeatherSoulNet:LevelUp(sid, lv, callback)
    local item = _G.ConfigManager.net_map.game_formation_s_up_level
    local port = base.Access(self, item, {sid = sid, up_lv = lv}, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end
---聚灵法阵升星
---@param callback function 完成回调
function GeatherSoulNet:StarUp(sid, callback)
    local item = _G.ConfigManager.net_map.game_formation_s_up_star
    local port = base.Access(self, item, {sid = sid}, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end
---聚灵法阵重置
---@param callback function 完成回调
function GeatherSoulNet:Reset(sid, callback)
    local item = _G.ConfigManager.net_map.game_formation_s_reset
    local port = base.Access(self, item, {sid = sid}, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end
---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function GeatherSoulNet:Callback(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type GeatherSoulNet
return GeatherSoulNet
