function GeatherSoulArrayModel:OnItemUpdate(data)
    for _, value in pairs(data) do
        local sid = value.type[1]
        if self:CheckTupoMaterialInArray(sid) then
            self.MaterTupoPoint = true
            self:RefreshRedPoint({ 2 })
        elseif self:CheckFormationMaterialInArray(sid) then
            local id = 0
            for k, v in pairs(self.ArrayCfg) do
                if v.material_active[1] == sid then
                    id = k
                end
            end
            self:RefreshRedPoint({ 1 }, id)
        end
    end
end

---红点刷新 1.解锁红点 2突破红点 3.登录红点
---@param type number[]
function GeatherSoulArrayModel:RefreshRedPoint(type, arrayid)
    if type and not _G.table.isEmptyOrNil(type) then
        for k, v in pairs(type) do
            if v == 1 then --1.解锁红点
                require "RedPointManager":GetInstance():RefreshNode(
                    _G.ConfigManager.redpoint_cfg.GeatherArrayUnlock.id,
                    arrayid
                )
            elseif v == 2 then -- 2突破红点
                require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GeatherArrayTupo.id)
            elseif v == 3 then -- 3.登录红点
                require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GeatherArrayLogin.id)
            end
        end
    end
end

---@private
function GeatherSoulArrayModel:BroadcastTaskEnum(enum, sid)
    ---解锁X个聚灵法阵
    if enum == 0 or enum == _G.ActiveTaskEnum.ConditionEnum.GeatherSoul.UnlockNum then
        if sid == 0 then
            local unlockNum = 0
            for _, v in pairs(self.CurArrayDatas) do
                if v:IsUnlock() then
                    unlockNum = unlockNum + 1
                end
            end
            _G.Events:GetInstance():Broadcast(
                _G.ePlayAactionEvent.PlayAaction,
                { _G.ActiveTaskEnum.ConditionEnum.GeatherSoul.UnlockNum },
                unlockNum,
                false,
                true
            )
        end
    end
    ---指定XX法阵上阵N角色
    if enum == 0 or enum == _G.ActiveTaskEnum.ConditionEnum.GeatherSoul.ArrayUpCardNum then
        local cardNum = 0
        if sid == 0 then
            for _, v in pairs(self.ArrayUidGroups) do
                if #v > cardNum then
                    cardNum = #v
                end
            end
        else
            cardNum = #self.ArrayUidGroups[sid]
        end
        _G.Events:GetInstance():Broadcast(
            _G.ePlayAactionEvent.PlayAaction,
            {
                _G.ActiveTaskEnum.ConditionEnum.GeatherSoul.ArrayUpCardNum,
                sid == 0 and _G.PlayerTreeID.none or sid
            },
            cardNum,
            false,
            true
        )
    end
    ---解锁指定聚灵法阵
    if enum == 0 or enum == _G.ActiveTaskEnum.ConditionEnum.GeatherSoul.UnlockArray then
        if sid ~= 0 and self.CurArrayDatas[sid]:IsUnlock() then
            _G.Events:GetInstance():Broadcast(
                _G.ePlayAactionEvent.PlayAaction,
                {
                    _G.ActiveTaskEnum.ConditionEnum.GeatherSoul.UnlockArray,
                    sid
                },
                1,
                false,
                true
            )
        end
    end
    ---XX法阵达到N级
    if enum == 0 or enum == _G.ActiveTaskEnum.ConditionEnum.GeatherSoul.ArrayLevel then
        local arrayLv = 0
        if sid == 0 then
            for _, v in pairs(self.CurArrayDatas) do
                if v:GetLevel() > arrayLv then
                    arrayLv = v:GetLevel()
                end
            end
        else
            arrayLv = self.CurArrayDatas[sid]:GetLevel()
        end
        _G.Events:GetInstance():Broadcast(
            _G.ePlayAactionEvent.PlayAaction,
            {
                _G.ActiveTaskEnum.ConditionEnum.GeatherSoul.ArrayLevel,
                sid == 0 and _G.PlayerTreeID.none or sid
            },
            arrayLv,
            false,
            true
        )
    end
end

