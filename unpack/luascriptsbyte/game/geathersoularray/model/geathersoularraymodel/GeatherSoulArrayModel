function GeatherSoulArrayModel:GetDataFormServer()
    require "GeatherSoulNet":GetInstance():GetInfo(_G.handler(self, self.ParseData))
end

function GeatherSoulArrayModel:ParseData(msg)
    if msg then
        if msg.f then
            for k, v in pairs(msg.f) do
                self.CurArrayDatas[v.sid]:SetUnlock()
                self.CurArrayDatas[v.sid]:SetLevel(v.level)
                self.CurArrayDatas[v.sid]:SetStar(v.star)
                if v.uids then
                    self.ArrayUidGroups[v.sid] = v.uids
                end
            end
        end
        if msg.reset_cd then
            self.ResetCd = msg.reset_cd
        end
    end
    self.super.ParseData(self)

    self:BroadcastTaskEnum(0, 0)
    for k, _ in pairs(self.CurArrayDatas) do
        self:BroadcastTaskEnum(0, k)
    end
    self:GetAllAttrByOnce(true)
end

---初始化阵法等级和星级配置
function GeatherSoulArrayModel:InitCfg()
    for k, v in pairs(formation_s_level_cfg) do
        if not self.LevelCfg[v.formation_s] then
            self.LevelCfg[v.formation_s] = {}
        end
        self.LevelCfg[v.formation_s][v.level] = {
            id = v.id,
            arrayId = v.formation_s,
            need = v.material,
            allAttr = v.att_all,
            selectAttr = v.att_select
        }
    end
    for k, v in pairs(formation_s_star_cfg) do
        if not self.StarCfg[v.formation_s] then
            self.StarCfg[v.formation_s] = {}
        end
        self.StarCfg[v.formation_s][v.star + 1] = {
            id = v.id,
            arrayId = v.formation_s,
            need = v.materials,
            allAttr = v.attribute,
            skills = v.skills,
            condition = v.level_condition
        }
        for i = 1, #v.materials do
            if not self.TupoMaterialArrayIdMap[v.materials[i][1]] then
                self.TupoMaterialArrayIdMap[v.materials[i][1]] = true
            end
        end
    end
    ---初始化阵法属性数据
    for k, v in pairs(self.ArrayCfg) do
        self.CurArrayDatas[v.id] = require "GeatherArrayBaseData".New(v)
        self.ArrayUidGroups[v.id] = {}
        ---建立映射
        self.ItemIdArrayMap[v.material_active[1]] = v.id
    end
    ---初始化阵法等级合成公式
    local scale = 1
    for i = _G.table.count(CompoundItem), 1, -1 do
        ---缓存最低可合成道具id 方便向上检索
        if not self.CompoundItemIdMap[exchangeCfg[CompoundItem[i]].need_item[1][1]] then
            self.CompoundItemIdMap[exchangeCfg[CompoundItem[i]].need_item[1][1]] = {}
        end
        if not self.CompoundItemIdMap[exchangeCfg[CompoundItem[i]].get_item[1][1]] then
            self.CompoundItemIdMap[exchangeCfg[CompoundItem[i]].get_item[1][1]] = {}
        end
        self.CompoundItemIdMap[exchangeCfg[CompoundItem[i]].need_item[1][1]].next =
            exchangeCfg[CompoundItem[i]].get_item[1][1]

        self.CompoundItemIdMap[exchangeCfg[CompoundItem[i]].get_item[1][1]].lower =
            exchangeCfg[CompoundItem[i]].need_item[1][1]
        scale = scale * exchangeCfg[CompoundItem[i]].need_item[1][2]
        self.CompoundCfg[exchangeCfg[CompoundItem[i]].get_item[1][1]] = {
            Need = {
                exchangeCfg[CompoundItem[i]].need_item[1][1],
                exchangeCfg[CompoundItem[i]].need_item[1][2]
            },
            Count = exchangeCfg[CompoundItem[i]].get_item[1][2],
            Unit = scale,
            Id = exchangeCfg[CompoundItem[i]].id
        }
    end
end

