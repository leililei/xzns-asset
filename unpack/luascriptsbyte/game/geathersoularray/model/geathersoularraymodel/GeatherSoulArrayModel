---@return number,number 下标，等级
function GeatherSoulArrayModel:GetNextUnlockArrayPos(arrayId)
    local level = self.CurArrayDatas[arrayId]:GetLevel()
    if level >= self.ArrayCfg[arrayId].condition_level[#self.ArrayCfg[arrayId].condition_level] then
        return nil, nil
    end
    local index = 1
    local aimLv = 1
    for i = 1, #self.ArrayCfg[arrayId].condition_level do
        index = i
        aimLv = self.ArrayCfg[arrayId].condition_level[i]
        if level < aimLv then
            break
        end
    end
    return index, aimLv
end

