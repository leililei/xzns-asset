---根据星级返回当前属性
---@param arrayId number 阵法id
---@param type number 加成类型 全队==1
function GeatherSoulArrayModel:GetLevel_attByStar(arrayId, star)
    local Level_att = {}
    local cfg = self.CurArrayDatas[arrayId]:GetLevelAllAttr()
    if not cfg then
        return nil
    end
    ---是否有星级加成
    local scale = self:GetStar_attByStar(arrayId, star)
    for i = 1, #cfg do
        local temp = {}
        temp.key = cfg[i][1]
        temp.type = cfg[i][2]
        temp.value = cfg[i][3] * scale * 0.0001
        table.insert(Level_att, temp)
    end
    --self:SortDispaly_Priority(Level_att)
    return Level_att
end

---当前等级属性
---@param arrayId number 阵法id
---@param type number 加成类型 全队==1 阵内==2
function GeatherSoulArrayModel:GetLevel_att(arrayId, type)
    local Level_att = {}
    local cfg
    if type == 1 then
        cfg = self.CurArrayDatas[arrayId]:GetLevelAllAttr()
    elseif type == 2 then
        cfg = self.CurArrayDatas[arrayId]:GetLevelSelectAttr()
    end
    if not cfg then
        return nil
    end
    ---是否有星级加成
    local scale = self:GetStar_att(arrayId)
    for i = 1, #cfg do
        local temp = {}
        temp.key = cfg[i][1]
        temp.type = cfg[i][2]
        temp.value = cfg[i][3] * scale * 0.0001
        table.insert(Level_att, temp)
    end
    --self:SortDispaly_Priority(Level_att)
    return Level_att
end

--region 计算属性值
---计算全队加成
function GeatherSoulArrayModel:ClaAllTeamAttribute(attr)
    for k, v in pairs(self.CurArrayDatas) do
        if v:IsUnlock() then
            self:CalAttributeBase(attr, self:GetLevel_att(k, 1))
        end
    end
end

---根据星级计算全队加成
---@return table attr
function GeatherSoulArrayModel:ClaAllTeamAttributeByStar(star, ArrayId)
    local attr = _G.AttributeClassManager:GetInstance():GetAttribtueClass()
    for k, v in pairs(self.CurArrayDatas) do
        if k == ArrayId then
            self:CalAttributeBase(attr, self:GetLevel_attByStar(k, star))
        end
    end
    return attr
end

---计算阵内卡牌加成
function GeatherSoulArrayModel:ClaUidCardAttribute(attr, arrayId)
    self:CalAttributeBase(attr, self:GetLevel_att(arrayId, 2))
end

function GeatherSoulArrayModel:CalAttributeBase(attr, _att)
    if not _G.table.isEmptyOrNil(_att) then
        for i = 1, #_att do
            if _G.tonumber(_att[i].type) == 1 then
                attr:AddValueByName(
                    _att[i].key,
                    _G.AttributeClassManager:GetInstance():GetValueWithName(
                        _att[i].key,
                        _att[i].value,
                        _G.tonumber(_att[i].type)
                    ),
                    nil,
                    _G.AttCountType.other
                )
            else
                attr:AddValueByName(
                    _att[i].key,
                    _G.AttributeClassManager:GetInstance():GetValueWithName(
                        _att[i].key,
                        _att[i].value,
                        _G.tonumber(_att[i].type)
                    ),
                    nil,
                    _G.tonumber(_att[i].type)
                )
            end
        end
    end
    return attr
end

