---排序 type_attribute display_priority
function GeatherSoulArrayModel:SortDispaly_Priority(attList)
    table.sort(
        attList,
        function(a, b)
            if _G.AttrType[a.key].sortid < _G.AttrType[b.key].sortid then
                return true
            end
            return false
        end
    )
end

---检测卡牌是否在阵法内
---@param uid number 卡牌uid
---@return  number 所在阵法id
---@return  number 所在槽位id
function GeatherSoulArrayModel:CheckInArray(uid)
    if not _G.table.isEmptyOrNil(self.ArrayUidGroups) then
        for k, v in pairs(self.ArrayUidGroups) do
            for i = 1, #v do
                if v[i].value == uid then
                    return k, v[i].key
                end
            end
        end
    end
    return nil
end

---当前阵法槽位是否解锁,是否可上阵
---@param arrayid number 阵法id
---@param index number 槽位
---@return boolean 是否解锁
---@return boolean 是否可上阵
function GeatherSoulArrayModel:CheckEmbattle(arrayid, index)
    local res, level = self:GetCurArrayPosIsUnlock(arrayid, index)
    if res then
        return true, not self:GetCardByArrayIndex(arrayid, index)
    else
        return false, false, level
    end
end

--- 吃卡
---@param cards table<number> 卡牌uid数组
---@param call function 回调
function GeatherSoulArrayModel:OneKeyOffChiKa(cards, call)
    if cards ~= nil then
        local arrayId, index
        for _, v in pairs(cards) do
            arrayId, index = self:CheckInArray(v)
            if arrayId then
                for i = 1, #self.ArrayUidGroups[arrayId] do
                    if self.ArrayUidGroups[arrayId][i].value == v then
                        _G.table.remove(self.ArrayUidGroups[arrayId], i)
                    end
                end
            end
        end
    end
    if call then
        call()
    end
end

