---计算是否可以合成,以及向上合成 当前道具不足情况下
---@param id number 道具id
---@param count number 需要道具数量
---@return boolean 是否可以合成
---@return table {exchange_cfg.id,canExchangeCount 可以兑换几次}
function GeatherSoulArrayModel:CheckCompound(id, count)
    local total = count
    local NeedItem = {}
    ---@param compounditem  table<id,unit> 合成目标{id,unit}
    ---@param _count number 需要合成数量
    ---@return boolean 是否可以合成
    ---@return number 能够兑换几次
    local CheckCountFunc = function(compounditem, _count, Unit)
        local sid = compounditem.id
        local _, storageId = _G.StorageManager:GetInstance():CheckSidType(sid)
        local myCount = _G.StorageManager:GetInstance():GetItemCountByID(storageId, sid)
        if myCount >= _count then
            local num = _count / Unit
            if num > 1 then
                num = _G.Mathf.Floor(num)
            else
                num = _G.Mathf.Ceil(num)
            end
            return true, num
        else
            return false, _G.Mathf.Floor(myCount / 5)
        end
    end
    ---检测是否还有子合成道具
    ---@param targetid number 当前道具id
    ---@return boolean 是否有子兑换道具
    ---@return table[] id,unit 子道具id,兑换单位unit(ex:unit ==1/5:每5个子道具,可兑换1个当前道具)
    local GetCompoundData = function(targetid)
        if self.CompoundCfg[targetid] then
            local need = self.CompoundCfg[targetid].Need
            return true, {
                id = need[1],
                unit = (self.CompoundCfg[targetid].Count / need[2]),
                Unit = self.CompoundCfg[targetid].Unit,
                exchangeId = self.CompoundCfg[targetid].Id,
                nextId = self.CompoundItemIdMap[targetid].lower,
                count = self.CompoundCfg[targetid].Count
            }
        else
            return false
        end
    end
    if self.CompoundCfg[id] then
        local res, data = GetCompoundData(id, 5)
        local next = 5
        if res then
            local check, canExchangeCount = CheckCountFunc(data, 5 * total, 5)
            if check then
                _G.table.insert(
                    NeedItem,
                    {
                        exchangeId = data.exchangeId,
                        count = canExchangeCount,
                        consumeCount = _G.Mathf.Floor(5 * canExchangeCount),
                        consumeSid = data.id
                    }
                )
                return NeedItem
            end
            while not check do
                _G.table.insert(
                    NeedItem,
                    {
                        exchangeId = data.exchangeId,
                        count = canExchangeCount,
                        consumeCount = _G.Mathf.Floor(5 * canExchangeCount),
                        consumeSid = data.id
                    }
                )
                res, data = GetCompoundData(data.nextId)
                if not res then
                    break
                else
                    total = 5 * (5 * (count - canExchangeCount))
                    check, canExchangeCount = CheckCountFunc(data, total, 5 * next)
                    _G.table.insert(
                        NeedItem,
                        {
                            exchangeId = 40003,
                            count = _G.Mathf.Floor(canExchangeCount),
                            consumeCount = _G.Mathf.Floor(total),
                            consumeSid = data.id
                        }
                    )
                    if check then
                        return NeedItem
                    else
                        return nil
                    end
                end
            end
            if check then
                return NeedItem
            end
        end
    end
    return nil
end

---阵法是否可以解锁
---@param sid number 阵法id
---@return boolean
function GeatherSoulArrayModel:CheckArrayCanUnlock(arrayid)
    local item = self.ArrayCfg[arrayid].material_active
    if #item > 0 then
        local _, storageId = _G.StorageManager:GetInstance():CheckSidType(item[1])
        local myCount = _G.StorageManager:GetInstance():GetItemCountByID(storageId, item[1])
        return myCount >= item[2]
    else
        return true
    end
end

---阵法解锁
---@param sid number 阵法id
function GeatherSoulArrayModel:UnlockArray(arrayid, callback)
    local item = self.ArrayCfg[arrayid].material_active
    require "GeatherSoulNet":GetInstance():UnlockArray(
        arrayid,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self.CurArrayDatas[arrayid]:SetUnlock()
            self:RefreshRedPoint({ 1, 2, 3 }, arrayid)
            self:GetAllAttrByOnce(true)
            self:UpdateCardProp(true)
            _G.StorageManager:GetInstance():ConsumeItem(item[1], 0, item[2])

            if callback then
                callback()
            end

            self:BroadcastTaskEnum(_G.ActiveTaskEnum.ConditionEnum.GeatherSoul.UnlockNum, 0)
            self:BroadcastTaskEnum(_G.ActiveTaskEnum.ConditionEnum.GeatherSoul.UnlockArray, arrayid)
        end
    )
end

---卡牌上下阵
---@param uid number 卡牌uid
---@param arrayid number 阵法id
---@param index number 阵法槽位
---@param type number f_sid
function GeatherSoulArrayModel:SetCard(uid, arrayid, index, type, callback)
    require "GeatherSoulNet":GetInstance():SetCard(
        { c_uid = uid, f_sid = type, index = index },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            local _arrayid, _index
            if type > 0 then
                _arrayid, _index = self:CheckInArray(uid)
                ---如果已上阵 则先移除对应阵法中
                if _arrayid then
                    for i = 1, #self.ArrayUidGroups[_arrayid] do
                        if self.ArrayUidGroups[_arrayid][i].value == uid then
                            _G.table.remove(self.ArrayUidGroups[_arrayid], i)
                            break
                        end
                    end
                end
                _G.table.insert(self.ArrayUidGroups[arrayid], { key = index, value = uid })
            else
                for i = 1, #self.ArrayUidGroups[arrayid] do
                    if self.ArrayUidGroups[arrayid][i].value == uid then
                        _G.table.remove(self.ArrayUidGroups[arrayid], i)
                        break
                    end
                end
            end
            local cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
            if cardData then
                cardData:CalcNowSumProp()
            end
            self:BroadcastTaskEnum(_G.ActiveTaskEnum.ConditionEnum.GeatherSoul.ArrayUpCardNum, arrayid)
            self:BroadcastTaskEnum(_G.ActiveTaskEnum.ConditionEnum.GeatherSoul.ArrayUpCardNum, 0)
            if callback then
                callback(_arrayid, _index)
            end
        end
    )
end

---刷新卡牌战力
---@param boolean showPowerUp 是否显示战力提升界面
function GeatherSoulArrayModel:UpdateCardProp(showPowerUp)
    if showPowerUp then
        local power = _G.StorageManager:GetInstance():GetPlayerPower()
        _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.GeatherSoul)
