---获取当前阵法对应槽位是否解锁
---@param arrayId number 阵法id
---@return boolean 是否解锁
function GeatherSoulArrayModel:GetCurArrayPosIsUnlock(arrayId, index)
    local level = self.CurArrayDatas[arrayId]:GetLevel()
    local _index = 1
    for i = 1, #self.ArrayCfg[arrayId].condition_level do
        if level >= self.ArrayCfg[arrayId].condition_level[i] then
            _index = i
        end
    end
    if _index >= index then
        return true
    else
        return false, self.ArrayCfg[arrayId].condition_level[index]
    end
end

---获取当前阵法解锁槽位数量
---@param arrayId number 阵法id
---@return number 解锁数量
function GeatherSoulArrayModel:GetCurArrayUnlockNum(arrayId)
    local level = self.CurArrayDatas[arrayId]:GetLevel()
    local count = 0
    for i = 1, #self.ArrayCfg[arrayId].condition_level do
        if level >= self.ArrayCfg[arrayId].condition_level[i] then
            count = count + 1
        end
    end
    return count
end

