end

---检测资源消耗
---@param material number[][] formation_s_level_cfg&formation_s_star_cfg .material
---@return boolean
---@return number 差几个
function GeatherSoulArrayModel:CheckItem(material)
    local res = {}
    if not _G.table.isEmptyOrNil(material) then
        for k, v in pairs(material) do
            if not _G.StorageManager:GetInstance():CheckItem(v[1], v[2]) then
                local _, storageId = _G.StorageManager:GetInstance():CheckSidType(v[1])
                local myCount = _G.StorageManager:GetInstance():GetItemCountByID(storageId, v[1])
                if self.CompoundItemIdMap[v[1]] then
                    _G.table.insert(res, { res = false, id = v[1], count = v[2] - myCount, isCompound = true })
                else
                    return false
                end
            end
        end
        if #res <= 0 then
            return true
        else
            for k, v in pairs(res) do
                if v.isCompound then
                    return false, v.count, v.id
                end
            end
            return false
        end
    else
        return true
    end
end

---合并道具
function GeatherSoulArrayModel:Exchange(compoundList, callback)
    self.CompoundParseCount = #compoundList
    for i = _G.table.count(compoundList), 1, -1 do
        if compoundList[i].count <= 0 then
            self.CompoundParseCount = self.CompoundParseCount - 1
        else
            _G.StorageManager:GetInstance():PropBuy(
                compoundList[i].exchangeId,
                compoundList[i].count,
                1,
                function(msg)
                    if msg.ack == 1 then
                        self.CompoundParseCount = self.CompoundParseCount - 1
                        if self.CompoundParseCount <= 0 then
                            if callback then
                                callback()
                            end
                        end
                    end
                end
            )
        end
    end
end

---阵法升级
---@param sid number 阵法id
---@param lv number 升级数量
---@param shortOne boolean 是否是短按升级
function GeatherSoulArrayModel:LevelUp(sid, lv, shortOne, callback)
    require "GeatherSoulNet":GetInstance():LevelUp(
        sid,
        lv,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            if lv == 1 and shortOne then
                local materials = self.CurArrayDatas[sid]:GetLevelMaterial()
                if #materials >= 1 then
                    for k, v in pairs(materials) do
                        _G.StorageManager:GetInstance():ConsumeItem(v[1], 0, v[2])
                    end
                end
            end

            require "PopUpGiftBagModel":GetInstance():IsRankofMatrix(
                self.CurArrayDatas[sid]:GetLevel(),
                self.CurArrayDatas[sid]:GetLevel() + lv
            )

            self.CurArrayDatas[sid]:SetLevel(self.CurArrayDatas[sid]:GetLevel() + lv)

            self:GetAllAttrByOnce(true)
            self:UpdateCardProp(true)
            self:BroadcastTaskEnum(_G.ActiveTaskEnum.ConditionEnum.GeatherSoul.ArrayLevel, sid)
            self:BroadcastTaskEnum(_G.ActiveTaskEnum.ConditionEnum.GeatherSoul.ArrayLevel, 0)
            if callback then
                callback()
            end
        end
    )
end

---阵法升星
---@param sid number 阵法id
function GeatherSoulArrayModel:StarUp(sid, callback)
    local material = self.CurArrayDatas[sid]:GetStarMaterial()
    if self:CheckItem(material) then
        if self.CurArrayDatas[sid]:StarUpConditionByLevel() then
            self:CheckSkillUnlockShow(
                sid,
                material,
                function(call)
                    require "GeatherSoulNet":GetInstance():StarUp(
                        sid,
                        function(msg)
                            if msg.ack ~= 1 then
                                return
                            end
                            for i = 1, #material do
                                _G.StorageManager:GetInstance():ConsumeItem(material[i][1], 0, material[i][2])
                            end
                            self.CurArrayDatas[sid]:SetStar(self.CurArrayDatas[sid]:GetStar() + 1)
                            if call then
                                call(sid)
                            end
                            self:GetAllAttrByOnce(true)
                            self:UpdateCardProp(true)
                            self:RefreshRedPoint({ 2 })
                            if callback then
                                callback()
                            end
                        end
                    )
                end
            )
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(
                780104,
                _G.GetLangPackValue(90000010525, self.CurArrayDatas[sid]:GetStarCondition())
            )
        end
    else
        if not _G.table.isEmptyOrNil(material) then
            ---打开资源获取界面
            for i = 1, #material do
                _G.StorageManager:GetInstance():CheckItemNew(material[i][1], material[i][2])
                break
            end
        end
    end
end

