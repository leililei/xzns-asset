---当前是否可加强属性 用于显示提升按钮
---@return boolean 是否可强化
function GeatherSoulArrayModel:CanBuild(arrayId)
    if self.CurArrayDatas[arrayId]:IsUnlock() then
        local level = self:CanBuildLevel(arrayId)
        local star = self:CanBuildStar(arrayId)
        return level or star
    end
    return false
end

---当前等级页签是否可加强属性 用于显示提升按钮或红点
---@return boolean 是否可强化
function GeatherSoulArrayModel:CanBuildLevel(arrayId)
    if not self.CurArrayDatas[arrayId]:IsMaxLevel() then
        return self:CheckItem(self.CurArrayDatas[arrayId]:GetLevelMaterial())
    end
    return false
end

---当前等级页签是否可加强属性 用于显示提升按钮或红点
---@return boolean 是否可强化
function GeatherSoulArrayModel:CanBuildStar(arrayId)
    if not self.CurArrayDatas[arrayId]:IsMaxStar() then
        local material = self.CurArrayDatas[arrayId]:GetStarMaterial()
        for k, v in pairs(material) do
            if not _G.StorageManager:GetInstance():CheckItem(v[1], v[2]) then
                return false
            end
        end
    end
    if not self.CurArrayDatas[arrayId]:IsMaxStar() and self.CurArrayDatas[arrayId]:GetStarCondition() then
        return true
    end
    return false
end

