---1、每次登陆时，若升级和升星有提升箭头则在主界面团队按钮以及聚灵阵法入口处显示红点；进入聚灵阵法后该红点消失
---ZHJ-25909改需求为：每周一登陆时，若升级和升星有提升箭头则在主界面团队按钮以及聚灵阵法入口处显示红点；进入聚灵阵法后该红点消失
function GeatherSoulArrayModel:CheckLoginRedPoint()
    local curLoginWeek = _G.TimeUtil.GetDateTime(_G.TimeUtil.GetServerUnixTime()).week
    local curLoginDay = _G.TimeUtil.GetDateTime(_G.TimeUtil.GetServerUnixTime()).day
    local curLoginHour = _G.TimeUtil.GetDateTime(_G.TimeUtil.GetServerUnixTime()).hour
    if (curLoginWeek == 1 and
            _G.TimeUtil.GetDateTime(_G.TimeUtil.GetServerUnixTime()).hour >= 6 and
            _G.PlayerPrefsManager.GetInt("Week1EnterGeatherSoulArray") == 0) then
        _G.PlayerPrefsManager.SetInt("GeatherSoulArrayLastDay", curLoginDay)
        _G.PlayerPrefsManager.SetInt("GeatherSoulArrayNeedDay", 8 - curLoginWeek)
        for k, v in pairs(self.CurArrayDatas) do
            if v:IsUnlock() then
                if self:CanBuild(v.Cfg.id) then
                    return true
                end
            end
        end
    end

    if (curLoginWeek ~= 1) then
        if (curLoginWeek == 2) then
            if (curLoginHour >= 6) then
                _G.PlayerPrefsManager.SetInt("Week1EnterGeatherSoulArray", 0)
            end
        else
            _G.PlayerPrefsManager.SetInt("Week1EnterGeatherSoulArray", 0)
        end
    end
    local NeedDay = _G.PlayerPrefsManager.GetInt("GeatherSoulArrayNeedDay")
    local lastLoginDay = _G.PlayerPrefsManager.GetInt("GeatherSoulArrayLastDay")
    if (lastLoginDay > 0) then
        if (math.abs(curLoginDay - lastLoginDay) >= NeedDay) then
            _G.PlayerPrefsManager.SetInt("OtherWeekEnterGeatherSoulArray", 0)
        end
    end
    if (curLoginWeek ~= 1 and _G.PlayerPrefsManager.GetInt("OtherWeekEnterGeatherSoulArray") == 0) then
        _G.PlayerPrefsManager.SetInt("GeatherSoulArrayLastDay", curLoginDay)
        _G.PlayerPrefsManager.SetInt("GeatherSoulArrayNeedDay", 8 - curLoginWeek)
        _G.PlayerPrefsManager.SetInt("OtherWeekEnterGeatherSoulArray", 1)
        for k, v in pairs(self.CurArrayDatas) do
            if v:IsUnlock() then
                if self:CanBuild(v.Cfg.id) then
                    return true
                end
            end
        end
    end
    return false
end

