---阵法重置
---@param sid number 阵法id
function GeatherSoulArrayModel:Reset(sid, callback)
    require "GeatherSoulNet":GetInstance():Reset(
        sid,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            if msg.award then
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                require "CommonTipManager".OpenCommonAwardView(msg)
            end
            self.CurArrayDatas[sid]:Reset()
            self.ArrayUidGroups[sid] = {}
            self:GetAllAttrByOnce(true)
            self:UpdateCardProp(false)
            self:RefreshRedPoint({ 2 })
            self.ResetCd = _G.TimeUtil.GetServerUnixTime()
            if callback then
                callback()
            end
        end
    )
end

