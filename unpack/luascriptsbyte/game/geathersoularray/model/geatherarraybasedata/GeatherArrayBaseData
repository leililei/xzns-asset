---@class GeatherArrayBaseData	中文描述
local GeatherArrayBaseData = _G.BaseClass("GeatherArrayBaseData")

local CS = _G.CS
local typeof = _G.typeof
local GetLangPackValue = _G.GetLangPackValue
local GeatherSoulArrayModel = require "GeatherSoulArrayModel"
---类的构造函数
---@field Level number 阵法星级
---@field Star number 阵法星级
---@field Cfg table 阵法配置
---@field id number 阵法id
function GeatherArrayBaseData:__init(arrayCfg)
    self.Cfg = arrayCfg
    self.Level = 1
    self.Unlock = false
    self.Star = 0
end

---设置阵法属性等级
function GeatherArrayBaseData:SetLevel(level)
    if not level then
        return
    end
    if not self:IsMaxLevel() then
        self.Level = level
    end
end
---设置阵法属性等级
function GeatherArrayBaseData:SetStar(star)
    if not star then
        return
    end
    if not self:IsMaxStar() then
        self.Star = star
    end
end

---阵法属性等级
function GeatherArrayBaseData:GetLevel()
    return self.Level
end

---阵法属性等级
function GeatherArrayBaseData:GetStar()
    return self.Star
end
---阵法等级是否最大
function GeatherArrayBaseData:IsMaxLevel()
    return self.Level >= self.Cfg.max_level
end
---阵法是否满星
function GeatherArrayBaseData:IsMaxStar()
    return self.Star >= self.Cfg.max_star
end
---阵法重置
function GeatherArrayBaseData:Reset()
    self.Level, self.Star = 1, 0
end
---获取对应阵法等级全队属性加成
function GeatherArrayBaseData:GetLevelAllAttrByLevel(level)
    return GeatherSoulArrayModel:GetInstance().LevelCfg[self.Cfg.id][level].allAttr
end
---获取对应阵法等级属性加成
function GeatherArrayBaseData:GetLevelSelectAttrByLevel(level)
    return GeatherSoulArrayModel:GetInstance().LevelCfg[self.Cfg.id][level].selectAttr
end
---获取阵法等级全队属性加成
function GeatherArrayBaseData:GetLevelAllAttr()
    return GeatherSoulArrayModel:GetInstance().LevelCfg[self.Cfg.id][self.Level].allAttr
end
---获取阵法等级属性加成
function GeatherArrayBaseData:GetLevelSelectAttr()
    return GeatherSoulArrayModel:GetInstance().LevelCfg[self.Cfg.id][self.Level].selectAttr
end
---获取阵法星级属性加成 星级+1 是因为星级数组从1开始 故{1=0星级,2=1星级,3=2星级,4=3星级,5=4星级,6=5星级}
function GeatherArrayBaseData:GetStarAllAttr()
    return GeatherSoulArrayModel:GetInstance().StarCfg[self.Cfg.id][self.Star + 1].allAttr
end
---获取阵法星级属性加成 星级+1 是因为星级数组从1开始 故{1=0星级,2=1星级,3=2星级,4=3星级,5=4星级,6=5星级}
function GeatherArrayBaseData:GetStarAllAttrByStar(star)
    return GeatherSoulArrayModel:GetInstance().StarCfg[self.Cfg.id][star + 1].allAttr
end
---获取阵法星级对应技能
function GeatherArrayBaseData:GetStarSkill()
    return GeatherSoulArrayModel:GetInstance().StarCfg[self.Cfg.id][self.Star + 1].skills
end
---获取阵法对应星级技能
function GeatherArrayBaseData:GetSkillByStar(star)
    if GeatherSoulArrayModel:GetInstance().StarCfg[self.Cfg.id][star + 1] then
        return GeatherSoulArrayModel:GetInstance().StarCfg[self.Cfg.id][star + 1].skills
    end
    return nil
end
---获取下一等级阵法星级资源道具
function GeatherArrayBaseData:GetStarMaterial()
    if self:IsMaxStar() then
        return GeatherSoulArrayModel:GetInstance().StarCfg[self.Cfg.id][self.Star + 1].need
    else
        return self:GetMatrial(self:GetMaterialByStar(self.Star), self:GetMaterialByStar(self.Star + 1))
    end
end
---获取下一等级阵法等级资源道具 如果满级则返回最大等级资源
function GeatherArrayBaseData:GetLevelMaterial()
    if self:IsMaxLevel() then
        return GeatherSoulArrayModel:GetInstance().LevelCfg[self.Cfg.id][self.Level].need
    else
        return self:GetMatrial(self:GetMaterialByLevel(self.Level), self:GetMaterialByLevel(self.Level + 1))
    end
end
---region 长按升级显示用
---@param level number 等级
---@param ignoreMaxLv boolean 为true时满级依旧返回该级消耗（不知道为什么满级要返回总消耗，先这么处理）
function GeatherArrayBaseData:GetLevelMaterialByLevel(level, ignoreMaxLv)
    if level < self.Cfg.max_level or ignoreMaxLv then
        return self:GetMatrial(self:GetMaterialByLevel(level - 1), self:GetMaterialByLevel(level))
    else
        return GeatherSoulArrayModel:GetInstance().LevelCfg[self.Cfg.id][self.Cfg.max_level].need
    end
end
---获取对应阵法星级资源道具
function GeatherArrayBaseData:GetMaterialByStar(star)
    return GeatherSoulArrayModel:GetInstance().StarCfg[self.Cfg.id][star + 1].need
end
---获取对应阵法等级资源道具
function GeatherArrayBaseData:GetMaterialByLevel(level)
    return GeatherSoulArrayModel:GetInstance().LevelCfg[self.Cfg.id][level].need
end
---升星是否满足对应等级条件
function GeatherArrayBaseData:StarUpConditionByLevel()
    return self.Level >= GeatherSoulArrayModel:GetInstance().StarCfg[self.Cfg.id][self.Star + 2].condition
end
---升星对应等级条件
function GeatherArrayBaseData:GetStarCondition()
    return GeatherSoulArrayModel:GetInstance().StarCfg[self.Cfg.id][self.Star + 2].condition
end
---当前解锁槽位数量
function GeatherArrayBaseData:GetUnlockPosCount()
    local _index = 0
    for i = 1, #self.Cfg.condition_level do
        if self.Level >= self.Cfg.condition_level[i] then
            _index = _index + 1
        end
    end
    return _index
end
---设置解锁
function GeatherArrayBaseData:SetUnlock()
    self.Unlock = true
end
---是否解锁
function GeatherArrayBaseData:IsUnlock()
    return self.Unlock
end
---类的析构函数
function GeatherArrayBaseData:Dispose()
    self.Cfg = nil
    self.Level = nil
    self.Star = nil
    self.Unlock = nil
end
function GeatherArrayBaseData:GetMatrial(lower, curr)
    local cur = {}
    local temp = {}
    if #curr > 0 then
        for k, v in pairs(curr) do
            if not cur[v[1]] then
                cur[v[1]] = v[2]
            else
                cur[v[1]] = cur[v[1]] + v[2]
            end
        end
    end
    if #lower > 0 then
        for k, v in pairs(lower) do
            if cur[v[1]] then
                cur[v[1]] = cur[v[1]] - v[2]
                if cur[v[1]] <= 0 then
                    cur[v[1]] = nil
                end
            end
        end
    end
    if not _G.table.isEmptyOrNil(cur) then
        for k, v in pairs(cur) do
            _G.table.insert(temp, {k, v})
        end
    end
    return temp
end
return GeatherArrayBaseData
