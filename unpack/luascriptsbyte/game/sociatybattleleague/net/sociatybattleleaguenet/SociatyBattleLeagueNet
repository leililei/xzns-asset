local base = require "BaseGameNet"
---@class SociatyBattleLeagueNet : BaseGameNet	通信协议
local SociatyBattleLeagueNet = _G.BaseClass("SociatyBattleLeagueNet", base)

---添加所有后端主动推的网络消息监听接口
function SociatyBattleLeagueNet:AddMessageListeners()
    self:AddMessageListener(_G.ConfigManager.net_map.guild_league_send_log.Cmd, self.OnP2CLog)
    self:AddMessageListener(_G.ConfigManager.net_map.guild_league_send_station.Cmd, self.OnP2CCampsite)
    self:AddMessageListener(_G.ConfigManager.net_map.guild_league_send_sign_station.Cmd, self.OnP2CMark)
    self:AddMessageListener(_G.ConfigManager.net_map.guild_league_season_effect_change.Cmd, self.OnP2CEffectChange)
end

---@return SociatyBattleLeagueNet SociatyBattleLeagueNet
function SociatyBattleLeagueNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---发送信息
function SociatyBattleLeagueNet:SendMsg(pbData, item, callback)
    if not pbData then
        pbData = self:GetEmptyPB()
    end
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求
---@param pbData table PB数据
---@param callback function 完成回调
function SociatyBattleLeagueNet:GetInfo(pbData, callback)
    self:SendMsg(pbData, _G.ConfigManager.net_map.game_guild_league_info, callback)
end

function SociatyBattleLeagueNet:GetLastRank(pbData, callback)
