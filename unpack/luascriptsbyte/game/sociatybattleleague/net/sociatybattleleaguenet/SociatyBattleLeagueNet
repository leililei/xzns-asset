---集火推送
---@param msg guild_fight.p2c_guild_fight_send_sign_station
function SociatyBattleLeagueNet:OnP2CMark(msg)
    require "SociatyBattleLeagueModel":GetInstance():SetMark(msg.b_id)
end

---龙魂|传送门推送
---@param msg guild_fight.p2c_guild_league_send_season_effect_change
function SociatyBattleLeagueNet:OnP2CEffectChange(msg)
    if not _G.table.isEmptyOrNil(msg.season_effect_7_info) then
        require "SociatyBattleLeagueModel":GetInstance():SetLastChaos(msg.guild_uid, msg.season_effect_7_info)
    end

    if not _G.table.isEmptyOrNil(msg.season_effect_9_info) then
        require "SociatyBattleLeagueModel":GetInstance():SetPortal(msg.guild_uid, msg.season_effect_9_info)
    end
end

---驻地变化推送
---@param msg guild_fight.p2c_guild_fight_send_station
function SociatyBattleLeagueNet:OnP2CCampsite(msg)
    require "SociatyBattleLeagueModel":GetInstance():OnCampsiteChangeData(msg)
end

---战斗日志推送
---@param msg guild_fight.p2c_guild_fight_send_log
function SociatyBattleLeagueNet:OnP2CLog(msg)
    require "SociatyBattleLeagueModel":GetInstance():AddLog(msg)
end

