function SociatyBattleLeagueModel:CheckIsGroupFirstDay()
    if self.StageState == _G.SociatyBattleLeagueStageState.BattleGroup then
        if _G.TimeUtil.CheckTheSameDay(self.StartTime, _G.TimeUtil.GetServerUnixTime()) then
            return true
        end
    end
    return false
end

---获取指定阶段开始时间
function SociatyBattleLeagueModel:GetDateBeginByStageState(stageState)
    local cfg = _G.ConfigManager.discrete_cfg[115901][1]
    local beginTime = self.StartTime
    if self.StageState > stageState then
        for i = stageState, self.StageState - 1 do
            beginTime = beginTime - 86400 * cfg[i]
        end
    elseif self.StageState < stageState then
        for i = self.StageState, stageState - 1 do
            beginTime = beginTime + 86400 * cfg[i]
        end
    end
    return beginTime
end

---某场次是否已经开始或结束（日期在今天及之前：已开始过, 或在今天之前：已结束）
---@param isEnd boolean true检测已结束，false检测已开始
function SociatyBattleLeagueModel:CheckIndexHasBeginOrIsEnd(index, isEnd, winTag)
    local idxState = self:GetIndexState(index, winTag)
    if self.StageState > idxState then
        return true
    end
    local time = self:GetDateBeginByStageState(idxState)
    if idxState == _G.SociatyBattleLeagueStageState.BattleGroup and index > 4 then
        time = time + 86400
    end
    if isEnd then
        time = time + 86400
    end
    return _G.TimeUtil.GetServerUnixTime() >= time
end

