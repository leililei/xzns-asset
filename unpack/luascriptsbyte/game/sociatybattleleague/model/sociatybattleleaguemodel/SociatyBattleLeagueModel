---查看其它公会
function SociatyBattleLeagueModel:LookBattleData(guildUid, otherGuildUid, call)
    local msg = {
        self_uid = otherGuildUid,
        uid = guildUid
    }

    self.SelfLastChaosTemp = {}
    self.EnemyLastChaosTemp = {}

    self.SelfPortalTemp = {}
    self.EnemyPortalTemp = {}

    require "SociatyBattleLeagueNet":GetInstance():GetBattleInfo(
        msg,
        function(data)
            for _, v in ipairs(data.battlefields) do
                if v.battlefield then
                    if v.guild == otherGuildUid then
                        self.mySociatyBattleDataTemp.score = v.guild_score
                        self.mySociatyBattleDataTemp:ParseBattleData(v)
                        self.SelfLastChaosTemp[v.guild] = v.season_effect_7_info

                        self.SelfPortalTemp[v.guild] = v.season_effect_9_info
                    else
                        self.enemySociatyBattleDataTemp.score = v.guild_score
                        self.enemySociatyBattleDataTemp:ParseBattleData(v)
                        self.EnemyLastChaosTemp[v.guild] = v.season_effect_7_info

                        self.EnemyPortalTemp[v.guild] = v.season_effect_9_info
                    end
                else
                    if _G.AppSetting.DEBUG then
                        _G.LogError("查询对战公会战场信息失败")
                    end
                end
            end
            call()
        end
    )
end

