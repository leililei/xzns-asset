---获取信息回调
---@param msg guild_league.s2c_guild_league_end_award_info
function SociatyBattleLeagueModel:GetEggInfoCall(msg, isnextday)
    if msg.ack == 1 then
        self.EggAwardFlag = msg.award_flag       --玩家是否领奖
        self.EggEndTimestamp = msg.end_time or 0 -- 彩蛋结束时间
        if self.EggEndTimestamp > 0 then
            self.EggEndTime = self.EggEndTimestamp - _G.TimeUtil.GetServerUnixTime()
        else
            self.EggEndTime = 0
        end
        self.EggSession = msg.session --第几届联赛(依据主战区)


        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GuildLeaguesettlement.id)
        --if isnextday then
        if self.EggEndTime and self.EggEndTime > 0 then
            _G.FunctionManager:GetInstance():OpenFunById(_G.MainFunctionItems.LeagueEgg)

            if not self.ChampionPoped then
                ---@type MainOpenViewFunItem
                local MainOpenViewFunItem = {}
                MainOpenViewFunItem.OpenViewFun = function()
                    ---跨服奥山彩蛋
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleLeagueChampionView.Name)
                end
                _G.MainManager:GetInstance():AddMainFunQueue(MainOpenViewFunItem, _G.MainViewShowOrder.LeagueChampion)

                self.ChampionPoped = true
            end
        end
        --end
        if self.EggEndTime and self.EggEndTime > 0 then
            self.EggTimer = _G.TimerManager:GetInstance():GetTimer(1, self.OnEggTimerOver, self, false)
            self.EggTimer:Start()
        end
    end
end

---彩蛋倒计时
function SociatyBattleLeagueModel:OnEggTimerOver(elapsed)
    self.EggEndTime = self.EggEndTime - elapsed
    if (self.EggEndTimestamp - _G.TimeUtil.GetServerUnixTime()) <= 0 then
        self.EggTimer:Stop()
        self.EggTimer = nil
        _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.LeagueEgg)
    end
end



