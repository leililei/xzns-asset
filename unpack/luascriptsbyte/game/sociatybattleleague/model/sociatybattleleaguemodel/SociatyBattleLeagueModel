function SociatyBattleLeagueModel:OnMark(uid, id, call)
    self.tempMark = self.markid
    SociatyBattleLeagueNet:GetInstance():Mark(
        {
            guild_uid = uid,
            b_id = id
        },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self:SetMark(id, true)
            if call then
                call()
            end
        end
    )
end

---检测是否被标记
---@param id number 驻地id
function SociatyBattleLeagueModel:CheckIsMark(id)
    return self.markid == id
end

---集火推送
---@param id number 驻地id
---@param isSelf boolean 是否是自己操作
function SociatyBattleLeagueModel:SetMark(id, isSelf)
    local last = self.markid or -1
    if self.tempMark == id then
        self.markid = -1
    else
        self.markid = id
    end
    self.tempMark = nil
    if not isSelf then
        _G.Events:GetInstance():Broadcast(_G.eSociatyBattleLeague.SociatyBattleMarkLeague, self.markid, last)
    else
        _G.Events:GetInstance():Broadcast(_G.eSociatyBattleLeague.SociatyBattleMarkSelfLeague, self.markid, last)
    end
end

---龙魂驻地推送
---@param guildid number 公会id
---@param info table --赛季效果-枚举6-[龙魂据点转移次数,龙魂据点id]
function SociatyBattleLeagueModel:SetLastChaos(guildid, info)
    local isself = self.SelfLastChaos[guildid]
    local isenemy = self.EnemyLastChaos[guildid]
    if not isself and not isenemy then
        return
    end
    if isself then
        self.SelfLastChaos[guildid] = info
        _G.Events:GetInstance():Broadcast(_G.eSociatyBattleLeague.SociatyBattleLastChaosLeague, guildid, info, true)
    else
        self.EnemyOldLastChaos[guildid] = { self.EnemyLastChaos[guildid][1], self.EnemyLastChaos[guildid][2] }
        self.EnemyLastChaos[guildid] = info
        _G.Events:GetInstance():Broadcast(_G.eSociatyBattleLeague.SociatyBattleLastChaosLeague, guildid, info, false)
    end
end

