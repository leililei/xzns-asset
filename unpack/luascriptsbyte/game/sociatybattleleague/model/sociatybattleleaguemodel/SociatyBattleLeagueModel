---获取所有战场数据
function SociatyBattleLeagueModel:GetAllBattleData(call)
    if nil == self.mySociatyBattleData or nil == self.enemySociatyBattleData then
        call()
        return
    end
    self:GetBattleData(
        {
            self_uid = self.mySociatyBattleData.sociatyData.guild_uid,
            uid = self.enemySociatyBattleData.sociatyData.guild_uid
        },
        function()
            call()
        end
