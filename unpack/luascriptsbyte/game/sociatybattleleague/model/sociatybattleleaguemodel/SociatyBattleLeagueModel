---初始化赛程信息
---@param matchInfo guild_league.i_guild_match_info[]
function SociatyBattleLeagueModel:InitCourseInfo(matchInfo, failMatchInfo)
    if matchInfo ~= nil then
        for _, v in pairs(matchInfo) do
            local info = v
            if nil == info.guild_b then
                info.guild_b = {
                    guild_uid = 0,   --公会uid
                    guild_name = "", --公会名字
                    server_id = 0,   --公会所在服务器
                    banner = 1001,   --公会徽章
                    guild_power = 0  --公会战力
                }
            end
            self.courseInfo[v.index] = info
        end
    end

    if failMatchInfo ~= nil then
        for _, v in pairs(failMatchInfo) do
            local info = v
            if nil == info.guild_b then
                info.guild_b = {
                    guild_uid = 0,   --公会uid
                    guild_name = "", --公会名字
                    server_id = 0,   --公会所在服务器
                    banner = 1001,   --公会徽章
                    guild_power = 0  --公会战力
                }
            end
            self.courseFailInfo[v.index] = info
        end
    end
end

---初始化竞猜信息
---@param guessInfo guild_league.i_guess_info
function SociatyBattleLeagueModel:InitGuessInfo(guessInfo, failGuessInfo)
    if guessInfo ~= nil then
        for _, v in pairs(guessInfo) do
            self.guessInfo[v.index] = v
        end
    end
    if failGuessInfo ~= nil then
        for _, v in pairs(failGuessInfo) do
            self.guessFailInfo[v.index] = v
        end
    end
end

