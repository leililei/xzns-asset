function SociatyBattleLeagueModel:CheckIsFirst()
    if self:GetStageState() == _G.SociatyBattleLeagueStageState.None then
        return false
    end
    local activity = require "ActivitySynManager":GetInstance():GetActivityWithTypeId(10011)
    if activity == nil then
        return false
    end
    if _G.PlayerPrefsManager.HasKey("SociatyBattleLeagueGift") then
        local time = _G.PlayerPrefsManager.GetInt("SociatyBattleLeagueGift", 0)
        local time2 = self:GetTime()
        self.isFirst = time < time2
    else
        self.isFirst = true
    end
    return self.isFirst
end

function SociatyBattleLeagueModel:ChangeIsFirst()
    if self:GetStageState() ~= _G.SociatyBattleLeagueStageState.None then
        if self.isFirst then
            self.isFirst = false
            _G.PlayerPrefsManager.SetInt("SociatyBattleLeagueGift", self:GetTime())
        end
    end
end

function SociatyBattleLeagueModel:GetTime()
    local time = _G.TimeUtil.GetServerUnixTime()
    local data = _G.TimeUtil.GetDateTime(time)
    if data.hour < _G.TimeUtil.GAME_DAY_HOUR then
        return _G.TimeUtil.GetDayBegin(time - _G.TimeUtil.GAME_DAY_TIME) + _G.TimeUtil.GAME_DAY_TIME
    else
        return _G.TimeUtil.GetDayBegin(time) + _G.TimeUtil.GAME_DAY_TIME
    end
end

