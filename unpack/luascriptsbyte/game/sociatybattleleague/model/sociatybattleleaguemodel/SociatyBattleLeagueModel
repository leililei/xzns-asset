    for _, v in pairs(msg.log) do
        _G.table.insert(self.LogList, v)
        --_G.table.insert(self.newLog, v)
        _G.Events:GetInstance():Broadcast(_G.eSociatyBattleLeague.SociatyBattleLogLeague, v)
        --- 跑马灯
        local tab = self:FormatLogChat(v)
        _G.PopWindowManager:GetInstance():ShowAllTips(33, tab.n_content)
    end
end

---获取日志
function SociatyBattleLeagueModel:GetLog()
    return self.LogList or {}
end

--- 获取主界面聊天格式日志
function SociatyBattleLeagueModel:GetChatLog()
    local chat = {}
    if not self.LogList then
        return chat
    end
    for i = 1, #self.LogList do
        chat[i] = self:FormatLogChat(_G.DeepCopy(self.LogList[i]))
    end
    return chat
end

function SociatyBattleLeagueModel:FormatLogChat(log)
    local tab = {}
    tab.time = log.time
    tab.reportid = log.id
    tab.role_info = { uid = 0 }
    tab.union_id = log.guild_uid
    tab.args = log.args
    tab.type = _G.ChatInfoType.system
    local titleLang = log.guild_uid == self.sociatyUid and 90021800336 or 90021800337
    tab.unionbattle = _G.LangUtil.GetLangPackValue(titleLang)
    local content, color = require "SociatyBattleLeagueManager".GetLogContent(log)
    tab.n_content = _G.string.AddColor(content, color)
    return tab
end

