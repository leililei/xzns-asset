---获取竞猜状态
---@param index number 场次
function SociatyBattleLeagueModel:GetGuessState(index, winTag)
    local info
    if winTag == 1 then
        info = self.guessInfo[index]
    else
        info = self.guessFailInfo[index]
    end
    local idxState = self:GetIndexState(index, winTag)
    if info == nil then
        if idxState < self.StageState then
            return _G.SociatyBattleLeagueGuessState.NotParticipating --未参与
        elseif idxState > self.StageState then
            return _G.SociatyBattleLeagueGuessState.Matching
        else
            if self:CheckIndexHasBeginOrIsEnd(index, true, winTag) then
                return _G.SociatyBattleLeagueGuessState.NotParticipating
            elseif self.State == _G.SociatyBattleLeagueState.Guess then
                if not self:CheckIndexHasBeginOrIsEnd(index, nil, winTag) then
                    return _G.SociatyBattleLeagueGuessState.Matching
                end
                return _G.SociatyBattleLeagueGuessState.Guess
            elseif self.State == _G.SociatyBattleLeagueState.Battle then
                return _G.SociatyBattleLeagueGuessState.InBattle
            elseif self.State == _G.SociatyBattleLeagueState.Settlement then
                return _G.SociatyBattleLeagueGuessState.NotParticipating --未参与
            else
                return _G.SociatyBattleLeagueGuessState.Matching
            end
        end
    else
        local courseInfo
        if winTag == 1 then
            courseInfo = self.courseInfo[index]
        else
            courseInfo = self.courseFailInfo[index]
        end
        if nil == courseInfo then
            return _G.SociatyBattleLeagueGuessState.Matching
        end
        if idxState == self.StageState and courseInfo.win_uid == 0 then
            if self.State == _G.SociatyBattleLeagueState.Guess or self.State == _G.SociatyBattleLeagueState.Battle then
                return _G.SociatyBattleLeagueGuessState.InBattle
            end
        end
        if courseInfo.win_uid == info.guild_uid then --猜对了
            if info.is_get == 1 then
                return _G.SociatyBattleLeagueGuessState.SucReceived
            else
                return _G.SociatyBattleLeagueGuessState.SucUnclaimed
            end
        else
            if info.is_get == 1 then
                return _G.SociatyBattleLeagueGuessState.FailReceived
            else
                return _G.SociatyBattleLeagueGuessState.FailUnclaimed
            end
        end
    end
end

---获取场次状态
---@param index number 场次
function SociatyBattleLeagueModel:GetIndexState(index, winTag)
    if winTag == nil then
        winTag = 1
    end
    if winTag == 1 then
        if index < 9 then
            return _G.SociatyBattleLeagueStageState.BattleGroup
        elseif index < 13 then
            return _G.SociatyBattleLeagueStageState.BattleElimination
        elseif index < 15 then
            return _G.SociatyBattleLeagueStageState.BattleSemifinal
        elseif index == 15 then
            return _G.SociatyBattleLeagueStageState.BattleWin2To1
        elseif index == 16 then
            return _G.SociatyBattleLeagueStageState.battleChampion
        end
    else
        if index < 3 then
            return _G.SociatyBattleLeagueStageState.BattleSemifinal
        elseif index < 5 then
            return _G.SociatyBattleLeagueStageState.BattleWin2To1
        elseif index == 5 then
            return _G.SociatyBattleLeagueStageState.BattleFail2To1
        elseif index == 6 then
            return _G.SociatyBattleLeagueStageState.BattleThirdplace
        end
    end
end

