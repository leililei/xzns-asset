---初始化时间
---@param beforBattle boolean 是否为战前
function SociatyBattleLeagueModel:InitTime(beforBattle)
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end

    local totalTime

    if beforBattle then
        totalTime = self.EndTime - _G.TimeUtil.GetServerUnixTime()
        self.nexTime = self.EndTime
    else
        local time = _G.TimeUtil.GetServerUnixTime()
        local startTime = _G.TimeUtil.GetDayBegin(time)

        self.State = _G.SociatyBattleLeagueState.None
        self.nexTime = 0
        local timeParams = _G.ConfigManager.discrete_cfg[DiscreteIDs.Time]
        ---0点开始算差值时间，用来判断是否在阶段范围内
        local czTime = time - startTime
        local isCur = false
        for k, v in ipairs(timeParams) do
            if v[2] * 3600 <= czTime and v[3] * 3600 > czTime then
                self.State = v[1]
                if timeParams[k + 1] then
                    self.nexTime = startTime + timeParams[k + 1][2] * 3600
                end
                self.startTime = startTime + v[2] * 3600
                break
            end
            if v[3] * 3600 > czTime then
                isCur = true
            end
        end
        if self.nexTime <= 0 then
            if isCur then
                timeParams = _G.ConfigManager.discrete_cfg[DiscreteIDs.Time]
                self.nexTime = startTime + timeParams[1][2] * 3600
                self.startTime = startTime
            else
                timeParams = _G.ConfigManager.discrete_cfg[DiscreteIDs.Time]
                self.nexTime = startTime + 86400 + timeParams[1][2] * 3600
                self.startTime = startTime + 86400
            end
        end
        if self.State == _G.SociatyBattleLeagueState.None then
            self.State = _G.SociatyBattleLeagueState.Match
        end
        totalTime = self.nexTime - time
    end

    if _G.AppSetting.DEBUG then
        _G.Log(self.StageState, "当前阶段状态")
        _G.Log(totalTime, "进入下一个阶段或者进程需要的时间")
    end

    if totalTime < 0 then
        if _G.AppSetting.DEBUG then
            _G.LogError(totalTime, "阶段时间异常了")
        end
        return
    end

    self.timer = _G.TimerManager:GetInstance():GetTimer(totalTime + 1, self.OnTimerOver, self, true)
    self.timer:Start()
end

