---初始化匹配信息
---@param msg guild_fight.i_guild_match_info
function SociatyBattleLeagueModel:InitMatchInfo(msg)
    if not msg then
        self.curDay = 0
        return
    end
    self.IsMatched = true
    --self.isApply = true
    for _, v in ipairs(msg) do
        if v.guild_uid ~= self.sociatyUid then
            if not self.enemySociatyBattleData then
                self.enemySociatyBattleData = require "SociatyBattleLeagueData".New()
            end
            self.enemySociatyBattleData:ParseSociatyData(v)
        else
            if not self.mySociatyBattleData then
                self.mySociatyBattleData = require "SociatyBattleLeagueData".New()
            end
            self.mySociatyBattleData:ParseSociatyData(v)
        end
    end

    if not self.enemySociatyBattleData then
        self.enemySociatyBattleData = require "SociatyBattleLeagueData".New()
        self.enemySociatyBattleData:ParseSociatyData(
            {
                guild_uid = 0,             --公会uid
                guild_server = 0,          --公会服务器
                guild_name = "",           --公会名字
                guild_power = 0,           --公会战力
                guild_role_num = 0,        --公会人数
                guild_station_num = 6,     --公会驻地剩余数量
                guild_score = 0,           --本次战场公会积分
                banner = 1001,             --公会徽章
                guild_president_name = "", --公会会长名字
                join_list = 0              --参赛玩家uid
            }
        )
    end

    local time = _G.TimeUtil.GetServerUnixTime()
    local startTime = _G.TimeUtil.GetDayBegin(time)
    self.battleTime = startTime + _G.TimeUtil.GAME_DAY_TIME
    self.curDay = math.min(_G.TimeUtil.GetIntervalDay(self.battleTime, _G.TimeUtil.GetServerUnixTime()) + 1, 3)
end

