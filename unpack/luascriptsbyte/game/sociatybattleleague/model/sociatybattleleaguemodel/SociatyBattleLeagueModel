---解析数据
---@param msg guild_league.s2c_guild_league_info
function SociatyBattleLeagueModel:ParseData(msg)
    self.CurSession = msg.session
    self.IsLeagueOpen = msg.is_open or -1
    if msg.ack == 1 then
        ---事件未到不能初始化
        local pub_info = msg.pub_info
        self.courseInfo = {}
        self.courseFailInfo = {}
        self.guessInfo = {}
        self.guessFailInfo = {}
        if nil == pub_info then
            self.super.ParseData(self)
            return
        end

        self.StageState = pub_info.state
        self.StartTime = pub_info.start_time
        self.EndTime = pub_info.end_time
        self.SeasonId = pub_info.season_id

        ---@type guild_league_season_effect_cfg
        local cfg = self:GetSeasonCfg()
        ---测试代码
        --cfg = _G.ConfigManager.guild_league_season_effect_cfg[5]
        if cfg then
            local misty = table.indexof(cfg.store_battle_pass, 5)
            if misty ~= false then
                self.MistyEffect = true
                self.MistyTimes = cfg.UseParameter[misty][1]
            end

            local soliddefense = table.indexof(cfg.store_battle_pass, 8)
            if soliddefense ~= false then
                self.SolidDefense = true
                self.SolidDefenseAdd = cfg.UseParameter[soliddefense][2] or 0
            end
            self.TeamNumber = cfg.teamnumber or self.maxPutNum
            self.PrepareBg = cfg.Prepare_bg or "ImagesH5/hSociatyBattleLeague/ui_kfas_xb_bg"
        end

        if self.StageState < _G.SociatyBattleLeagueStageState.BattleGroup then
            self.BeforBattle = true
        else
            self.BeforBattle = false
        end
        self:InitTime(self.BeforBattle)
        self.sociatyUid = require "SociatyManager":GetInstance():GetGuildUid()

        self:InitRoleFightInfo(msg.role_info)

        self:InitMatchInfo(pub_info.detail_info)

        self:InitNormalCfg(self.StageState - 2)

        self:InitCourseInfo(pub_info.match_info, pub_info.fail_match_info)
        self:InitLog()
        self:InitBattleAward()
        if msg.math_info then
            self:GetDefendGarrayData(
                function()
                    require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                        _G.ConfigManager.redpoint_cfg[RedPointKey.GuildLeagueTeam].id
                    )
                    require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                        _G.ConfigManager.redpoint_cfg[RedPointKey.GuildLeagueFirst].id
                    )
                    require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                        _G.ConfigManager.redpoint_cfg[RedPointKey.GuildLeagueAward].id
                    )
                end
            )
        else
            require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg[RedPointKey.GuildLeagueTeam].id
            )
            require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg[RedPointKey.GuildLeagueFirst].id
            )
            require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg[RedPointKey.GuildLeagueAward].id
            )
        end
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GuildLeagueGuess.id)
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GuildLeagueGuess.id, 1)
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GuildLeagueGuess.id, 2)
        _G.SystemSettingManager:GetInstance():GetOtherPlayerData(
            _G.PlayerModel:GetInstance():GetPlayerUid(),
            function(msg2)
                self.background_id = msg2.background_id
            end
        )
        _G.Events:GetInstance():Broadcast(_G.eSociatyBattleLeague.ScoiatyBattleChallengeNumLeague)
        _G.Events:GetInstance():Broadcast(_G.eSociatyBattleLeague.SociatyBattleStateLeague)
    else
        if _G.AppSetting.DEBUG then
            _G.LogWarning(msg, "联赛信息协议回调异常")
        end
    end
    self.super.ParseData(self)
end

