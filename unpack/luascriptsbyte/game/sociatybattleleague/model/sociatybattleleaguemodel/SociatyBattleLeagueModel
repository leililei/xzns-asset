---获取下一个结算的时间
function SociatyBattleLeagueModel:GetNextSettlementTime()
    local day = 0
    local time = _G.TimeUtil.GetServerUnixTime()
    local dayBeginTime = _G.TimeUtil.GetDayBegin(time)
    local settlementTime = 0
    --for i = 1, 2 do
    local weekParam = _G.ConfigManager.discrete_cfg[DiscreteIDs.Time]
    if weekParam then
        for k, v in ipairs(weekParam) do
            if v[1] == _G.SociatyBattleLeagueState.Settlement then
                if time < dayBeginTime + v[2] * 3600 + day * 86400 then
                    settlementTime = v[2] * 3600
                    break
                end
            end
        end
        -- if settlementTime > 0 then
        --     break
        -- else
        --     day = day + 1
        -- end
    end
    --end
    local ret = dayBeginTime + day * 86400 + settlementTime
    return ret
end

