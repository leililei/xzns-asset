---检测竞猜奖励可领取 / 可竞猜
function SociatyBattleLeagueModel:CheckGuessAwardUnclaimed(winTag)
    if winTag == nil then
        winTag = 1
    end
    local data = winTag == 1 and self.guessInfo or self.guessFailInfo
    if data == nil then
        return false
    end
    local guessState
    if data then
        for k, v in pairs(data) do
            guessState = self:GetGuessState(v.index, winTag)
            if
                guessState == _G.SociatyBattleLeagueGuessState.SucUnclaimed or
                guessState == _G.SociatyBattleLeagueGuessState.FailUnclaimed
            then
                return true
            end
        end
    end
    return self:CheckCanGuess(winTag)
end

---可竞猜
function SociatyBattleLeagueModel:CheckCanGuess(winTag)
    local data = winTag == 1 and self.courseInfo or self.courseFailInfo
    local dataGuess = winTag == 1 and self.guessInfo or self.guessFailInfo
    for _, v in pairs(data) do
        ---这里判断一下匹配出的公会有没有轮空
        if v.guild_a.guild_uid > 0 and v.guild_b and v.guild_b.guild_uid > 0 then
            local index = v.index
            local idxState = self:GetIndexState(index, winTag)
            local cfg = self:GetGuessCfgById(idxState).gear[1]
            if
                dataGuess[index] == nil and self:GetGuessState(index, winTag) == _G.SociatyBattleLeagueGuessState.Guess and
                _G.StorageManager:GetInstance():CheckItem(cfg[1], cfg[2]) == true
            then
                return true
            end
        end
    end
    return false
end

