---竞猜
function SociatyBattleLeagueModel:DoGuess(index, uid, cls, call, type)
    local pbData = { index = index, guild_uid = uid, class = cls, type = type }
    local idxState = SociatyBattleLeagueModel:GetInstance():GetIndexState(index, type)
    local cfg = self:GetGuessCfgById(idxState)

    local sid = cfg.gear[cls][1]
    local num = cfg.gear[cls][2]
    if not _G.StorageManager:GetInstance():CheckItem(sid, num) then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, sid)
        return
    end
    SociatyBattleLeagueNet:GetInstance():Guess(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ConsumeItem(sid, nil, num)
            if type == 1 then
                self.guessInfo[index] = {
                    index = index,
                    guild_uid = uid,
                    class = cls,
                    is_get = 0
                }
            else
                self.guessFailInfo[index] = {
                    index = index,
                    guild_uid = uid,
                    class = cls,
                    is_get = 0
                }
            end
            require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GuildLeagueGuess.id)
            require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GuildLeagueGuess.id, 1)
            require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GuildLeagueGuess.id, 2)
            if call then
                call()
            end
        end
    )
end

