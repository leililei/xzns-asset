local base = require "SociatyBattleLeagueCampsiteBaseData"
---@class SociatyBattleLeagueEmbattleData	: SociatyBattleLeagueCampsiteBaseData 公会战编队数据
---@field id number 驻地id
---@field cfg guild_battle_campsite_cfg 驻地配置
---@field isCampsite boolean 是否是驻地
---@field role role.i_role 玩家信息
local SociatyBattleLeagueEmbattleData = _G.BaseClass("SociatyBattleLeagueEmbattleData", base)

---初始化玩家信息
---@param msg guild_fight.i_battlefield 驻地信息
function SociatyBattleLeagueEmbattleData:InitRoleInfo(msg)
    if not msg or not msg.role_uid or msg.role_uid < 1000000000 then
        self.isCampsite = false
        return
    end
    self.isCampsite = true
    base.InitRoleInfo(self, msg)
end
---更换玩家信息
---@field role role.i_role 玩家信息
function SociatyBattleLeagueEmbattleData:ChangeRoleInfo(msg)
    if not msg then
        self.isCampsite = false
        return
    end
    if msg.role_uid then
        self:InitRoleInfo(msg)
    else
        self.isCampsite = true
        self.role = _G.DeepCopy(msg)
    end
end

---获取玩家信息
function SociatyBattleLeagueEmbattleData:GetRoleInfo()
    if not self.isCampsite then
        return
    end
    return self.role
end

---检测是否有玩家驻守
function SociatyBattleLeagueEmbattleData:CheckHaveRole()
    return self.isCampsite
end

return SociatyBattleLeagueEmbattleData
