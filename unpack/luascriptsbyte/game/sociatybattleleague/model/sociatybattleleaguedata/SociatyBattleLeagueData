local SociatyBattleLeagueModel = require "SociatyBattleLeagueModel"

---@class SociatyBattleLeagueData	公会战公会数据
---@field score number 积分
---@field sociatyData guild_fight.i_guild_f 公会信息
---@field campsiteDic SociatyBattleLeagueCampsiteData[] 实际驻地信息
---@field embattleCampsiteDic SociatyBattleLeagueEmbattleData[] 布阵驻地信息
---@field embattleRoleDic number[] 编队玩家
---@field embattleRolePosDic number[] 编队玩家所在的驻地
---@field buffList number[] buff列表
---@field activeBufttList number[] 激活buff列表
---@field surviveNum number 存活数
---@field maxNum number 塔总数
local SociatyBattleLeagueData = _G.BaseClass("SociatyBattleLeagueData", _G.LogicClass)
local maxNum = #_G.ConfigManager.guild_league_campsite_cfg

---解析公会数据
---@param msg guild_fight.i_guild_f 公会数据
function SociatyBattleLeagueData:ParseSociatyData(msg)
    self.sociatyData = msg
    self.score = msg.guild_score or 0
    self.surviveNum = maxNum
    self.allScore = msg.guild_season_score or 0
    if self.sociatyData.guild_uid < 10000000000 then
        self.sociatyData.guild_name = _G.GetLangPackValue(self.sociatyData.guild_name)
        self.sociatyData.guild_president_name = _G.GetLangPackValue(self.sociatyData.guild_president_name)
    end
    self.maxHp = 0
    for _, v in pairs(_G.ConfigManager.guild_league_campsite_cfg) do
        self.maxHp = self.maxHp + v.hp
    end
    self.hp = 0
end

---解析战场数据
---@param msg guild_fight.s2c_guild_fight_battlefield_info
function SociatyBattleLeagueData:ParseBattleData(msg)
    self:InitBuff()
    self:InitCampsiteDatas(msg.battlefield)
end

---获取公会信息
---@return guild_fight.i_guild_f
function SociatyBattleLeagueData:GetSociatyInfoData()
    return self.sociatyData
end

--region 积分

---获取积分
function SociatyBattleLeagueData:GetSorce()
    return self.score or 0
end

---获取赛季积分
function SociatyBattleLeagueData:GetAllSorce()
    return self.score or 0
end

---增加积分
---@param result boolean 是否胜利
---@param isDefend boolean 是否防守
function SociatyBattleLeagueData:AddSorce(score)
    self.score = Mathf.RoundToInt(self.score + score)
    -- * SociatyBattleLeagueModel:GetInstance():GetBoost())
    self.allScore = Mathf.RoundToInt(self.allScore + score)
    -- * SociatyBattleLeagueModel:GetInstance():GetBoost())
end

---获取胜利或失败后获得的积分
---@param id number 驻地id
---@param isDefend boolean 是否防守
---@param result boolean[] 每一句的结果
---@param endResult boolean 是否胜利
function SociatyBattleLeagueData:GetChangeScoreNum(id, result, isDefend)
    local winNum = 0
    for _, v in pairs(result) do
        if isDefend then
            if not v then
                winNum = winNum + 1
            end
        else
            if v then
                winNum = winNum + 1
            end
        end
    end
    local isWin = winNum > #result - winNum
    local cfg = _G.ConfigManager.guild_league_campsite_cfg[id]
    if not cfg then
        return
    end
    if isDefend then
        if isWin then
            return cfg.def_points
        end
        return 0
    else
        -- return _G.Mathf.RoundToInt(cfg.points[winNum + 1][1] * (1 + cfg.points[winNum + 1][2] / 10000))
        return cfg.points[winNum + 1][1]
    end
end

--endregion

--region 驻地信息

---初始化驻地信息
---@param msg guild_fight.i_battlefield[] 驻地信息
function SociatyBattleLeagueData:InitCampsiteDatas(msg)
    if not self.campsiteDic then
        self.campsiteDic = {}
    end
    self.surviveNum = maxNum
    self.hp = 0
    local class = require "SociatyBattleLeagueCampsiteData"
    for _, v in ipairs(msg) do
        if not self.campsiteDic[v.b_id] then
            self.campsiteDic[v.b_id] = class.New()
        end
        self.campsiteDic[v.b_id]:ParseData(v)
        if v.is_breach == 1 then
            self:AddActiveBuff(self.campsiteDic[v.b_id]:GetBuff())
            self.surviveNum = self.surviveNum - 1
        else
            self.hp = self.hp + v.blood
        end
    end
end

function SociatyBattleLeagueData:GetCampsiteDic()
    return self.campsiteDic
end

---获取驻地信息
---@return SociatyBattleLeagueCampsiteData
function SociatyBattleLeagueData:GetCampsiteData(id)
    if not self.campsiteDic then
        return
    end
    return self.campsiteDic[id]
end

---获取编队驻地
function SociatyBattleLeagueData:GetEmbattleCampsiteDic()
    return self.embattleCampsiteDic
end

---获取编队驻地数据
function SociatyBattleLeagueData:GetEmbattleCampsiteData(id)
    return self.embattleCampsiteDic[id]
end

---进攻结果
---@return number 积分
function SociatyBattleLeagueData:SetAttackResult(id, result, isAllZero)
    local changeScore = self:GetChangeScoreNum(id, result)
    if isAllZero then
        changeScore = math.floor(changeScore * _G.ConfigManager.discrete_cfg[101684][1][1] / 10000)
    end
    self:AddSorce(changeScore)
    return changeScore --* SociatyBattleLeagueModel:GetInstance():GetBoost()
end

---防御结果
---@return number 改变的血量
function SociatyBattleLeagueData:SetDefendResult(id, result, addsorce)
    local campsiteData = self:GetCampsiteData(id)
    if campsiteData then
        local curHp = campsiteData:GetHp()
        local changeHp, changeBaseHp = campsiteData:ChangeHp(result)
        self.hp = self.hp - _G.math.min(changeHp, curHp)
        if addsorce then
            self:AddSorce(self:GetChangeScoreNum(id, result, true))
        end
        campsiteData:ChangeAttackTimes()
        self:ChangeHpCall(campsiteData)
        return changeHp, changeBaseHp
    end
    return 0, 0
end

---设置推送驻地状态改变
---@params msg guild_fight.p2c_guild_fight_send_station
function SociatyBattleLeagueData:SetP2CCampsiteChange(msg)
    local campsiteData = self:GetCampsiteData(msg.station.b_id)
    if campsiteData then
        self.hp = self.hp - (campsiteData:GetHp() - msg.station.hp)
        campsiteData:ParseChange(msg)
        self:AddSorce(self:GetChangeScoreNum(msg.station.b_id, msg.station.winner, true))
        self:ChangeHpCall(campsiteData)
    end
    return false
end

---改变驻地血量后的回调
function SociatyBattleLeagueData:ChangeHpCall(campsiteData)
    if campsiteData:GetState() == _G.SociatyBattleCampsiteState.Destory then
        if campsiteData:GetBuff() > 0 then
            self:AddActiveBuff(campsiteData:GetBuff())
        end
        self.surviveNum = self.surviveNum - 1
    end
end

--endregion

--region Buff

---获取
function SociatyBattleLeagueData:InitBuff()
    local insert = _G.table.insert
    if not self.buffList then
        self.buffList = {}
        self.activeBufttList = {}
        for _, v in ipairs(_G.ConfigManager.guild_league_campsite_cfg) do
            if v.effect > 0 then
                insert(self.buffList, v.effect)
            end
        end
    end
end

---获取buff列表
function SociatyBattleLeagueData:GetBuffList()
    return self.buffList
end

---添加buff
function SociatyBattleLeagueData:AddActiveBuff(buffId)
    if buffId and buffId > 0 then
        self.activeBufttList[buffId] = true
    end
end

---检测buff是否激活
function SociatyBattleLeagueData:CheckBuffIsActive(buffId)
    if not buffId or buffId <= 0 then
        return false
    end
    return self.activeBufttList[buffId]
end

--endregion

--region 布阵

---更改布阵
---@return boolean 是否更改成功
function SociatyBattleLeagueData:ChangeCampsite()
    local state = require "SociatyBattleManager":GetInstance():GetState()
    --处于战斗中驻地无法更改，此时布阵数据和阵地数据不一致
    if state == _G.SociatyBattleLeagueState.Battle then
        return false
    end
    for _, v in ipairs(self.campsiteDic) do
        v:ParseData(v.id, self.embattleCampsiteDic[v.id]:GetMsg())
    end
    return true
end

--endregion

--region 编队

---初始化编队
---@param msg guild_fight.s2c_guild_fight_guild_role_battlefield 编队信息
function SociatyBattleLeagueData:InitEmbattle(msg)
    self:InitEmbattleData(msg.battlefield)
    self:InitEmbattleRoleData(msg.role_battlefield_list)
end

---初始化编队据点数据
---@param datas guild_fight.i_battlefield[] 编队据点数据
function SociatyBattleLeagueData:InitEmbattleData(datas)
    if not self.embattleCampsiteDic then
        self.embattleCampsiteDic = {}
    end
    local tb = {}
    self.embattleRoleDic = {}
    if datas then
        for _, v in ipairs(datas) do
            tb[v.b_id] = v
        end
    else
        for _, v in ipairs(_G.ConfigManager.guild_league_campsite_cfg) do
            tb[v.id] = self.campsiteDic[v.id]:GetMsg()
        end
    end
    local class = require "SociatyBattleLeagueEmbattleData"
    for _, v in ipairs(_G.ConfigManager.guild_league_campsite_cfg) do
        if not self.embattleCampsiteDic[v.id] then
            self.embattleCampsiteDic[v.id] = class.New()
        end
        if tb[v.id] then
            self.embattleCampsiteDic[v.id]:ParseData(tb[v.id])
            self.embattleRoleDic[tb[v.id].role_uid] = v.id
        else
            self.embattleCampsiteDic[v.id]:ParseData({b_id = v.id})
        end
    end
end

---初始化可驻地的玩家数据
---@param datas guild_fight.i_role_battlefield[] 玩家数据
function SociatyBattleLeagueData:InitEmbattleRoleData(datas)
    self.embattleRolePreList = datas
end

---获取可编队玩家数据
---@return guild_fight.i_role_battlefield[]
function SociatyBattleLeagueData:GetEmbattleRoleData()
    return self.embattleRolePreList
end

---检测玩家驻守id
function SociatyBattleLeagueData:GetEmbattleInCampsiteId(id)
    return self.embattleRoleDic[id] or 0
end

---设置玩家编队驻守
---@param data guild_fight.i_role_battlefield
function SociatyBattleLeagueData:SetEmabttleCampsite(id, data)
    local campsiteData = self:GetEmbattleCampsiteData(id)
    if campsiteData then
        local role = campsiteData:GetRoleInfo()
        if data then
            local curId = self:GetEmbattleInCampsiteId(data.role_uid)
            if curId > 0 then
                local otherCampsiteData = self:GetEmbattleCampsiteData(curId)
                otherCampsiteData:ChangeRoleInfo(role)
                if role then
                    self.embattleRoleDic[role.uid] = curId
                end
            else
                if role then
                    self.embattleRoleDic[role.uid] = nil
                end
            end
            self.embattleRoleDic[data.role_uid] = campsiteData.id
        else
            if role then
                self.embattleRoleDic[role.uid] = nil
            end
        end
        campsiteData:ChangeRoleInfo(data)
        return campsiteData.id
    end
    return -1
end

---获取剩余据点数量
function SociatyBattleLeagueData:GetSurviveNum()
    return self.surviveNum
end

---获取最大据点数量
function SociatyBattleLeagueData:GetMaxNum()
    return maxNum
end

function SociatyBattleLeagueData:GetMaxHp()
    return self.maxHp
end

function SociatyBattleLeagueData:GetHp()
    return self.hp
end

function SociatyBattleLeagueData:GetUid()
    return self.sociatyData.guild_uid
end

--endregion
return SociatyBattleLeagueData
