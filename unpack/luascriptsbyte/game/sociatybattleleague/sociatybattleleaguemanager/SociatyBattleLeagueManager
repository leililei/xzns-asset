---进入公会联赛
---@return number 1为独立开启时间未达成,2function配置未达成
function SociatyBattleLeagueManager:Enter(call)
    ---@type SociatyBattleLeagueStageState
    local stageState = self:GetStageState()
    if stageState == _G.SociatyBattleLeagueStageState.None then
        ---未开启
        if _G.AppSetting.DEBUG then
            _G.Log("<color=red><size=20>联赛未开启</size></color>")
        end
        ---如果赛季大于0，就可以查看历届联赛信息
        if self:GetCurSession() > 0 then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleLeagueTopRankView.Name)
        end
        return 2
    elseif
        stageState == _G.SociatyBattleLeagueStageState.Select or
            stageState == _G.SociatyBattleLeagueStageState.Preparing
     then
        ---选拔和备战
        ---todo 打开联赛公会排行界面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleLeaguePrepareView.Name)
        return
    elseif stageState == _G.SociatyBattleLeagueStageState.End then
        ---联赛结束
        if _G.AppSetting.DEBUG then
            _G.Log("<color=red><size=20>联赛已结束</size></color>")
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleLeagueTopRankView.Name)
        return
    end

    ---@type SociatyBattleLeagueState
    local state = self:GetState()
    if state == _G.SociatyBattleLeagueState.None then
        return 1
    end

    ---没参与的玩家只能进竞猜界面
    if not SociatyBattleLeagueModel.IsJoin then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleLeagueGuessNormalView.Name)
    else
        if state == _G.SociatyBattleLeagueState.Guess or state == _G.SociatyBattleLeagueState.Battle then
            SociatyBattleLeagueModel:GetAllBattleData(
                function()
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleLeagueMainView.Name)
                    if call then
                        call()
                    end
                end
            )
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleLeagueMainView.Name)
            if call then
                call()
            end
        end
    end

    if state == _G.SociatyBattleLeagueState.Battle then
        SociatyBattleLeagueModel:RefreshEnterRedPoint()
    end
end

function SociatyBattleLeagueManager:CheckOpenSkillShowView()
    if not SociatyBattleLeagueModel.IsJoin then
        return
    end
    local index = _G.PlayerPrefsManager.GetInt("SociatyBattleLeagueSkillShowViewPop", 0)
    local SeasonId = SociatyBattleLeagueModel:GetSeasonId()
    if index < SeasonId then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleLeagueSkillShowView.Name, false)
    end
end

---是否可以踢人
function SociatyBattleLeagueManager:CheckCanKickOutState()
    local stageState = self:GetStageState()
    if stageState > _G.SociatyBattleLeagueStageState.Preparing and stageState < _G.SociatyBattleLeagueStageState.End then
        return false
    end
    return true
end

---是否可以退出
function SociatyBattleLeagueManager:CheckCanQuitState()
    local stageState = self:GetStageState()
    if stageState >= _G.SociatyBattleLeagueStageState.BattleGroup and stageState < _G.SociatyBattleLeagueStageState.End then
        if require("SociatyBattleLeagueModel"):GetInstance().IsMatched then
            return false
        end
    end
    return true
end

---是否可以解散
function SociatyBattleLeagueManager:CheckCanBreakUpState()
    local stageState = self:GetStageState()
    if stageState >= _G.SociatyBattleLeagueStageState.Preparing and stageState < _G.SociatyBattleLeagueStageState.End then
        if require("SociatyBattleLeagueModel"):GetInstance().IsMatched then
            return false
        end
    end
    return true
end

---查看战场信息
function SociatyBattleLeagueManager:LookBattleData(data, call)
    local guildUid = data.guild_a.guild_uid
    local otherGuildUid = data.guild_b.guild_uid
    SociatyBattleLeagueModel:InitLookDataTemp(data.guild_a, data.guild_b)
    SociatyBattleLeagueModel:LookBattleData(
        guildUid,
        otherGuildUid,
        function()
            local sblmv =
                _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SociatyBattleLeagueMainView.Name)
            if sblmv then
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SociatyBattleLeagueMainView.Name)
            end

            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleLeagueMainView.Name, true)
            if call then
                call()
            end
        end
    )
end

