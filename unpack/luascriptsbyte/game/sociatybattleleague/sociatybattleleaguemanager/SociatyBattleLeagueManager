---获取战报内容
---@param data guild_fight.i_log
function SociatyBattleLeagueManager.GetLogContent(data)
    if _G.table.isEmptyOrNil(data) then
        return ""
    end
    ---@type guild_battle_report_cfg
    local cfg = _G.ConfigManager.guild_battle_report_cfg[data.id]
    local tb = _G.DeepCopy(data.args)
    if cfg then
        for i = 1, #cfg.trigger do
            if cfg.trigger[i] == 3 then
                local tempCfg = _G.ConfigManager.guild_battle_campsite_cfg[_G.tonumber(data.args[i])]
                if tempCfg then
                    tb[i] = _G.LangUtil.GetLangPackValue(tempCfg.name)
                end
            elseif cfg.trigger[i] == 2 then
                local lpcid = tonumber(data.args[i])
                if lpcid == nil then
                    tb[i] = data.args[i]
                else
                    local value = _G.ConfigManager.language_package_cfg[lpcid]
                    if value then
                        tb[i] = _G.LangUtil.GetLangPackValue(lpcid)
                    else
                        tb[i] = data.args[i]
                    end
                end
            end
        end
    end

    if cfg then
        return _G.GetLangPackValue(cfg.language, _G.SafeUnpack(tb)), data.guild_uid ==
            require "SociatyManager":GetInstance():GetGuildUid() and
            "1796DD" or
            "ff5555"
    else
        return ""
    end
end

---获取战报内容
---@param data guild_fight.i_log
function SociatyBattleLeagueManager.GetHpImage(hp)
    if hp > 0.99 then
        return "ui_zd_xt_ls"
    elseif hp > 0.5 then
        return "ui_zd_xt_ls"
    elseif hp > 0.25 then
        return "ui_zd_xt_cs"
    else
        return "ui_zd_xt_hs"
    end
end

---检测驻地是否被攻破
---@param type SociatyBattleCampsiteType 按类型筛选，如果传空就是所有驻地
---@param isSelf boolean 是否为自己
function SociatyBattleLeagueManager:CheckCampsiteZero(type, isSelf)
    if nil == isSelf then
        isSelf = false
    end
    local sociatyBattleData
    if isSelf then
        sociatyBattleData = SociatyBattleLeagueModel:GetSelfScoaityData()
    else
        sociatyBattleData = SociatyBattleLeagueModel:GetEnemySociatyData()
    end
    local embattleCampsiteDatas = sociatyBattleData:GetCampsiteDic()
    local isAllZero = true
    if embattleCampsiteDatas then
        for _, v in pairs(embattleCampsiteDatas) do
            if nil == type then
                if v:GetHp() > 0 then
                    isAllZero = false
                    break
                end
            elseif v:GetType() == type then
                if v:GetHp() > 0 then
                    isAllZero = false
                    break
                end
            end
        end
    else
        isAllZero = false
    end
    return isAllZero
end

---检测当前时间是否过了12点
function SociatyBattleLeagueManager:CheckTime12()
    local date = _G.TimeUtil.GetDateTime(_G.TimeUtil.GetServerUnixTime())
    return date.hour >= 12
end

