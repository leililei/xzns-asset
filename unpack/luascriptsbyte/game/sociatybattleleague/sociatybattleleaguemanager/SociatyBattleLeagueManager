---测试战斗
---@param msg guild_fight.s2c_guild_fight_fight 战场驻地
---@param noSkip boolean 禁用跳过
function SociatyBattleLeagueManager:AttackCall(msg, isSp, data, noSkip)
    if msg.ack ~= 1 or not msg.fight_arg then
        self:ExitEmbattle2()
        return
    end
    self.fightMsg = msg
    if msg.attack_time then
        SociatyBattleLeagueModel:SetAttackTime(msg.attack_time)
        SociatyBattleLeagueModel:BattleEnd(msg.winner)
    end
    if msg.award then
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
    end
    if isSp then
        self:ExitEmbattle2()
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ChatDefultRootView.Name)
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.SociatyBattleResultView.Name,
            nil,
            msg.fight_arg,
            msg.winner,
            true
        )
    else
        _G.BattleManager:GetInstance():SetArgData(msg.fight_arg)
        _G.BattleManager:GetInstance():EnterFight(_G.BattleControllerType.SociatyBattleLeague, msg.fight_arg, data, noSkip)
    end
end

