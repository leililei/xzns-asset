--region 战斗
function SociatyBattleLeagueManager:Fight(uid, data, isTest, isMistyEffectIng)
    self.isTestFight = isTest
    if not isTest then
        if SociatyBattleLeagueModel:GetChallengeNum() <= 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(250127)
            return
        end
        if not SociatyBattleLeagueModel:CheckCampsiteCanAttack(uid, data.id) then
            _G.PopWindowManager:GetInstance():ShowAllTips(250122)
            return
        end
    end
    SociatyBattleLeagueModel:GetAttackArray(
        function()
            local num = SociatyBattleLeagueModel:GetNormalCfg().team_number
            local tb = {}
            for i = 1, num do
                tb[i] = i
            end
            self.attackCampsiteId = data.id
            _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
            require("EmbattleController"):GetInstance():OpenEmbattle(
                tb,
                _G.EmbattleSaveType.temporary,
                false,
                _G.EmbattleControllerItemType.SociatyBattleLeagueAttack,
                _G.handler(self, self.ExitEmbattle),
                _G.handlerbind(self, self.EnterFight, uid, data, isTest),
                500000001,
                SociatyBattleLeagueModel:GetEnemyData(uid, data.id),
                isMistyEffectIng
            )
        end
    )
end

---退出战斗
function SociatyBattleLeagueManager:ExitEmbattle(isBattle)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.SociatyBattleLeagueCampsiteView.Name)
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
end

---监听界面打开
---@param name string 界面名称
function SociatyBattleLeagueManager:OnEmbattleViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SociatyBattleLeagueCampsiteView.Name)
        ---@type EmbattleNewView
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.EmbattleView.Name)
        view:SetBattleStartCheckCall(
            function()
                if self:CheckIsTestFight() then
                    return true
                end
                if
                    not SociatyBattleLeagueModel:CheckCampsiteCanAttack(
                        SociatyBattleLeagueModel:GetEnemySociatyData():GetSociatyInfoData().guild_uid,
                        self.attackCampsiteId
                    )
                 then
                    _G.PopWindowManager:GetInstance():ShowAllTips(250122)
                    return
                end

                local isAllZero = self:CheckCampsiteZero()
                ---如果全部驻地都攻破就不判断血量
                if not isAllZero then
                    if
                        SociatyBattleLeagueModel:GetEnemySociatyData():GetCampsiteData(self.attackCampsiteId):GetHp() <=
                            0
                     then
                        _G.PopWindowManager:GetInstance():ShowAllTips(250123)
                        return
                    end
                end
                return true
            end
        )
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    end
end
