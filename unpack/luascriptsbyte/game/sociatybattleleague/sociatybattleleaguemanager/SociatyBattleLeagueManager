    local ctrl1 = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SociatyBattleLeagueMainView.Name)
    local ctrl2 =
        _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SociatyBattleLeagueGuessNormalView.Name)
    if ctrl1 or ctrl2 then
        return
    end
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SociatyBattleLeagueBarrageView.Name)
end

