function SociatyBattleLeagueCoursePanel:MoveToFirstUnclaimedIndex()
    if not self.showGuess then
        return
    end
    local guess
    local idx = 0
    for k, v in pairs(self.courseInfo) do
        if not v.isTitle then
            guess = self.guessInfo[v.index]
            if guess and guess.is_get == 0 then
                idx = k - 1
                break
            end
        end
    end
    if idx > 1 then
        self.mlistView:MovePanelToItemIndex(idx)
    end
end

---是否是下一场
function SociatyBattleLeagueCoursePanel:Show(isNext, isGroup, isWinTag)
    self:InitData(isNext, isGroup, isWinTag)
    self:UpdateScorllView()
end

function SociatyBattleLeagueCoursePanel:UpdateScorllView()
    self.sociatyUid = require("SociatyModel"):GetInstance().SociatySelf.Uid
    if self.mlistView == nil then
        self.go_table.looplist2_item:InitListView(#self.courseInfo, _G.handler(self, self.RefreshItem))
        self.mlistView = self.go_table.looplist2_item
        self:MoveToFirstUnclaimedIndex()
    else
        self.mlistView:SetListItemCount(#self.courseInfo, true)
        self.mlistView:RefreshAllShownItem()
    end
    self:UpdateTips()
end

---小组赛提示信息
function SociatyBattleLeagueCoursePanel:UpdateTips()
    if self.go_table.aortext_tips then
        self.go_table.aortext_tips:SetActiveE(0)
        if (SociatyBattleLeagueModel:GetInstance():GetStageState() ~= _G.SociatyBattleLeagueStageState.BattleGroup) then
            return
        end
        if not SociatyBattleLeagueModel:GetInstance().mySociatyBattleData then
            self.go_table.aortext_tips:SetActiveE(1)
            self.go_table.aortext_tips.text = _G.GetLangPackValue(90032800129)
        elseif not self.inList then
            self.go_table.aortext_tips:SetActiveE(1)
            self.go_table.aortext_tips.text = _G.GetLangPackValue(90032800128)
        end
    end
end

---@param listView2 SuperScrollView.LoopListView2
---@param index number
function SociatyBattleLeagueCoursePanel:RefreshItem(listView2, index)
    index = index + 1
    local data = self.courseInfo[index]
    local obj
    if data.isTitle then
        obj = listView2:NewListViewItem("$_obj_item")
        self:ShowTitle(obj, data)
    else
        obj = listView2:NewListViewItem("$_obj_item2")
        self:ShowCourse(obj, data)
    end
    return obj
end

function SociatyBattleLeagueCoursePanel:ShowTitle(obj, data)
    ---@type _obj_course._obj_item_GoTable
    local tb = _G.GetAutoGoTable(obj)
    local time = SociatyBattleLeagueModel:GetInstance():GetDateBeginByStageState(data.stageState)
    if data.index == 8.5 then
        time = time + 86400
    elseif data.index == 0.1 then
        if SociatyBattleLeagueModel:GetInstance():CheckIsGroupFirstDay() then
            time = time + 86400
        end
    end
    local date = _G.TimeUtil.GetDateTime(time)
    if data.index == 4.5 and self.winTag == 1 then
        tb.aortext_title.text =
            _G.GetLangPackValue(90032100011, date.month, date.day) .. " " .. self["titleName" .. self.winTag].Group1
    else
        tb.aortext_title.text =
            _G.GetLangPackValue(90032100011, date.month, date.day) ..
            " " .. self["titleName" .. self.winTag][data.stageState]
    end
end

---@param data guild_league.i_guild_match_info
function SociatyBattleLeagueCoursePanel:ShowCourse(obj, data)
    ---@type _obj_course._obj_item2_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickCourse, data))
    local state
    state = SociatyBattleLeagueModel:GetInstance():GetGuessState(data.index, self.winTag)
    local idxState = SociatyBattleLeagueModel:GetInstance():GetIndexState(data.index, self.winTag)

    ---轮空判定
    local isLK = false
    if data.guild_a.guild_uid == 0 or data.guild_b.guild_uid == 0 then
        isLK = true
    end

    self:ShowSociaty(tb.obj_left, data.guild_a, data, state, idxState, isLK)
    self:ShowSociaty(tb.obj_right, data.guild_b, data, state, idxState, isLK)

    local isBye = data.guild_a.guild_uid == 0 or data.guild_b.guild_uid == 0
    if self.showGuess then
        local isGuess =
            state == GS.SucReceived or state == GS.SucUnclaimed or state == GS.FailReceived or state == GS.FailUnclaimed
        local isWin = state == GS.SucReceived or state == GS.SucUnclaimed
        local isLose = state == GS.FailReceived or state == GS.FailUnclaimed
        tb.aorrawimage_box:SetActiveE(isGuess and 1 or 0)
        tb.aorrawimage_box:LoadImage(
            (state == GS.SucUnclaimed or state == GS.FailUnclaimed) and self.boxState.close or self.boxState.open
        )
        if isWin then
            tb.aorrawimage_guessRes:LoadImage("ImagesH5/hSociatyBattleLeague/ui_kfas_fcswjjc_txt_jccg")
        elseif isLose then
            tb.aorrawimage_guessRes:LoadImage("ImagesH5/hSociatyBattleLeague/ui_kfas_fcswjjc_txt_jcsb")
        end
        tb.aorrawimage_guessRes:SetActiveE(isGuess and 1 or 0)
        tb.aortext_isEnd:SetActiveE(state == GS.NotParticipating and 1 or 0)
    else
        tb.aortext_isEnd:SetActiveE(state > GS.InBattle and 1 or 0)
        tb.aorrawimage_box:SetActiveE(0)
        tb.aorrawimage_guessRes:SetActiveE(0)
    end
    tb.aorrawimage_fighting:SetActiveE((state == GS.Matching or state == GS.Guess or state == GS.InBattle) and 1 or 0)
    if self.guessType == 3 then
        tb.aorrawimage_fighting:SetLocalPosition(0, 20, 0)
    else
        tb.aorrawimage_fighting:SetLocalPosition(0, state == GS.Matching and 0 or 56)
    end
    tb.aorimage_matching:SetActiveE(0)
    local isMine = self.sociatyUid == data.guild_a.guild_uid or self.sociatyUid == data.guild_b.guild_uid
    if isMine and not self.inList then
        self.inList = isMine
    end
    if data.guild_a.isFake or data.guild_b.isFake then
        tb.aorbtn_enter:SetActiveE(0)
    else
        tb.aorbtn_enter:SetActiveE(
            ((state == GS.Guess or state == GS.InBattle) and not isMine and not isBye) and 1 or 0
        )
    end
end

---@param gData guild_league.i_guild_brief
function SociatyBattleLeagueCoursePanel:ShowSociaty(obj, gData, data, state, idxState, isLK)
    local index = data.index
    ---@type _obj_item2._obj_left_GoTable|_obj_item2._obj_right_GoTable
    local tb =
        _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickGuess, data, gData.guild_uid, index, idxState, isLK))
    if gData.guild_uid == 0 then
        tb.aortext_name.text = "本场轮空"
        tb.aortext_serverName.text = ""
        tb.aortext_power.text = ""
        tb.aorrawimage_icon:LoadImage(nil)
    else
        --LogError(gData.guild_name)
        --LogError(_G.tonumber(gData.guild_name))
        tb.aortext_name.text = _G.tonumber(gData.guild_name) and _G.GetLangPackValue(gData.guild_name) or gData.guild_name
        local severname
        if gData.isFake then
            severname = "???"
        else
            severname = _G.ServerManager:GetInstance():GetServerNameByServerID(gData.server_id)
        end
        tb.aortext_serverName.text = severname or self:GetInSeverName()
        tb.aortext_power.text =
            _G.GetLangPackValue(90032100009) ..
            (gData.isFake and "???" or _G.GameUtil.NumberToUnitStr(gData.guild_power))
        tb.aorrawimage_icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[gData.banner].portrait)
    end
    local courseInfo = self.courseInfoSrc[index] or {win_uid = 0}
    tb.aorimage_winOrFail:SetActiveE(courseInfo.win_uid > 0 and 1 or 0)
    tb.aorimage_winOrFail.SpriteName = courseInfo.win_uid == gData.guild_uid and "0ui_img_shengliqi" or "0ui_img_shibai"
    if tb.obj_failBg then
        tb.obj_failBg:SetActiveE(
            ((courseInfo.win_uid ~= 0 and courseInfo.win_uid ~= gData.guild_uid) or gData.isFake) and 1 or 0
        )
    end
    if self.showGuess then
        tb.aorbtn_guess:SetActiveE((state == GS.Guess and not isLK) and 1 or 0)
        local isGuess =
            (self.guessInfo[index] and self.guessInfo[index].guild_uid == gData.guild_uid and
            (state >= GS.Guess and state <= GS.FailReceived))
        local unGuess = self.guessInfo[index] == nil and state == GS.InBattle
        tb.aorimage_isGuessed:SetActiveE(isGuess and 1 or 0)
        --tb.aorimage_isGuessed.SpriteName = isGuess and "ui_hjdj_icon_yijingcai" or "ui_hjdj_icon_weijingcai"
        tb.aortext_odds:SetActiveE(state == GS.Guess and 1 or 0)
        local cfg = SociatyBattleLeagueModel:GetInstance():GetGuessCfgById(idxState)
        local odds = cfg.win_odds // 10000
        tb.aortext_odds.text = _G.GetLangPackValue(90032100018, odds)
    end

