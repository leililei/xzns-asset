function SociatyBattleLeagueCoursePanel:OnClickBetting(go, isOn, cls)
    if self.curUid == nil or self.curIdx == nil then
        return
    end
    SociatyBattleLeagueModel:GetInstance():DoGuess(
        self.curIdx,
        self.curUid,
        cls,
        _G.handler(self, self.GuessCall),
        self.winTag
    )
end

function SociatyBattleLeagueCoursePanel:GuessCall()
    self.go_table.obj_betting:SetActiveE(0)
    ---@type guild_league.i_guild_match_info
    local info = self.courseInfoSrc[self.curIdx]
    local isLeft = self.curUid == info.guild_a.guild_uid
    local lanId = isLeft and 90032100038 or 90032100037
    local sName = isLeft and info.guild_a.guild_name or info.guild_b.guild_name
    local param = {
        type = 1,
        content = _G.GetLangPackValue(lanId, _G.PlayerModel:GetInstance():GetName(), sName)
    }
    SociatyBattleLeagueModel:GetInstance():OnBarrageSendCall(param)
    self.curUid = nil
    self.curIdx = nil
    self.mlistView:RefreshAllShownItem()
end

---获取内网服务器信息
function SociatyBattleLeagueCoursePanel:GetInSeverName()
    local list = {}
    local curServer = _G.ServerManager:GetInstance().CurServer
    for _, v in pairs(_G.ConfigManager.server_list_cfg) do
        if v.ServerID == self.data.server_id then
            _G.table.insert(list, v)
        end
    end
    local count = #list
    if count == 0 or count > 1 then
        return curServer.ServerName
    else
        return list[1].ServerName
    end
end

function SociatyBattleLeagueCoursePanel:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_hideBetting then
        self.go_table.obj_betting:SetActiveE(0)
    end
end

