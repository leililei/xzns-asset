    --             end
    --             tb.eff = trans
    --         end
    --     )
    -- end
end

function SociatyBattleLeagueCoursePanel:OnClickCourse(go, isOn, data)
    local name = go:GetName()
    if name == "@_aorbtn_enter" then
        require("SociatyBattleLeagueManager"):GetInstance():LookBattleData(data)
    elseif name == "@_aorbtn_getAward" then
        SociatyBattleLeagueModel:GetInstance():GetGuessAward(
            {data.index},
            function()
                self.mlistView:RefreshAllShownItem()
                self:MoveToFirstUnclaimedIndex()
            end,
            self.winTag
        )
    end
end

