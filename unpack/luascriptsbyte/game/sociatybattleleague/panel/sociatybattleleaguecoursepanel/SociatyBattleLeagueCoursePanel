---@param isNext 是否本轮比赛
---@param isGroup 是否仅小组赛
function SociatyBattleLeagueCoursePanel:InitData(isNext, isGroup, winTag)
    self.winTag = winTag
    if self.winTag == nil then
        self.winTag = 1
    end
    self.inList = false
    self.guessInfo = SociatyBattleLeagueModel:GetInstance():GetGuessInfo(self.winTag)
    self.courseInfoSrc = SociatyBattleLeagueModel:GetInstance():GetCourseInfo(self.winTag)
    local courseInfo =
        _G.table.chooseToArray(
        self.courseInfoSrc,
        function(_, info)
            return SociatyBattleLeagueModel:GetInstance():CheckIndexHasBeginOrIsEnd(info.index, nil, self.winTag)
        end
    )
    local startStageState = _G.SociatyBattleLeagueStageState.BattleGroup
    local stageState = SociatyBattleLeagueModel:GetInstance():GetStageState()
    if stageState > _G.SociatyBattleLeagueStageState.BattleGroup and (not isGroup) then
        --startStageState = _G.SociatyBattleLeagueStageState.BattleElimination
        if winTag == 1 then
            courseInfo =
                _G.table.chooseToArray(
                self.courseInfoSrc,
                function(_, info)
                    return SociatyBattleLeagueModel:GetInstance():CheckIndexHasBeginOrIsEnd(
                        info.index,
                        nil,
                        self.winTag
                    ) and SociatyBattleLeagueModel:GetInstance():GetIndexState(info.index) >= startStageState
                end
            )
        end
    end
    if stageState > _G.SociatyBattleLeagueStageState.Preparing then
        if stageState > _G.SociatyBattleLeagueStageState.battleChampion then
            stageState = _G.SociatyBattleLeagueStageState.battleChampion
        end
        if isGroup then
            if stageState > _G.SociatyBattleLeagueStageState.BattleGroup then
                stageState = _G.SociatyBattleLeagueStageState.BattleGroup
            end
            courseInfo =
                _G.table.chooseToArray(
                courseInfo,
                function(_, info)
                    return SociatyBattleLeagueModel:GetInstance():GetIndexState(info.index) == stageState
                end
            )
        end
        if isNext then
            courseInfo =
                _G.table.chooseToArray(
                courseInfo,
                function(_, info)
                    return SociatyBattleLeagueModel:GetInstance():GetIndexState(info.index) == stageState and
                        not SociatyBattleLeagueModel:GetInstance():CheckIndexHasBeginOrIsEnd(
                            info.index,
                            true,
                            self.winTag
                        )
                end
            )
            startStageState = stageState
        end
        for i = startStageState, stageState do
            if i == _G.SociatyBattleLeagueStageState.BattleGroup and self.winTag == 1 then
                if not (isNext and not SociatyBattleLeagueModel:GetInstance():CheckIsGroupFirstDay()) then
                    _G.table.insert(
                        courseInfo,
                        {index = self["stageIndex" .. self.winTag].Group1, stageState = i, isTitle = true}
                    )
                end
                local time = SociatyBattleLeagueModel:GetInstance():GetDateBeginByStageState(i)
                if _G.TimeUtil.GetServerUnixTime() - time >= 86400 then
                    _G.table.insert(
                        courseInfo,
                        {index = self["stageIndex" .. self.winTag][i], stageState = i, isTitle = true}
                    )
                elseif isGroup then
                    self:CreateFakeGroupData(courseInfo, i)
                end
            else
                if self["stageIndex" .. self.winTag][i] then
                    _G.table.insert(
                        courseInfo,
                        {index = self["stageIndex" .. self.winTag][i], stageState = i, isTitle = true}
                    )
                end
            end
        end
        _G.table.sort(
            courseInfo,
            function(a, b)
                return a.index > b.index
            end
        )
        self.courseInfo = courseInfo
    else
        self.courseInfo = {}
    end
end

