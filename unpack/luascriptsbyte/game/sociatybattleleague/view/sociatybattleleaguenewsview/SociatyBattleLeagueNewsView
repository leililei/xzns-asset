---@class SociatyBattleLeagueNewsView : UIBaseView	中文描述
---@field public go_table SociatyBattleNewsView_GoTable GoTable
---@field private memberPanel SociatyBattleNews_MemberPanel 成员显示
---@field private newsPanel SociatyBattleNews_NewsPanel 新闻显示
local SociatyBattleLeagueNewsView = _G.BaseClass("SociatyBattleLeagueNewsView", _G.UIBaseView)
--_G.SociatyBattleLeagueNewsView = SociatyBattleLeagueNewsView

function SociatyBattleLeagueNewsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyBattleLeagueNewsView:OnCreate()
    self.go_table.toggle_member.isOn = true
end

function SociatyBattleLeagueNewsView:OnMember(isOn)
    self:ShowToggles(self.go_table.toggle_member, isOn)
    self.go_table.obj_member:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    if not self.memberPanel then
        self.memberPanel = self:AddComponent(self.go_table.obj_member, require "SociatyBattleLeagueNews_MemberPanel".New())
    end
    self.memberPanel:ShowView()
end

function SociatyBattleLeagueNewsView:OnNews(isOn)
    self:ShowToggles(self.go_table.toggle_news, isOn)
    self.go_table.obj_news:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    if not self.newsPanel then
        self.newsPanel = self:AddComponent(self.go_table.obj_news, require "SociatyBattleLeagueNews_NewsPanel".New())
    end
    self.newsPanel:ShowView()
end
---显示标签
function SociatyBattleLeagueNewsView:ShowToggles(obj, isOn)
    local item = _G.GetAutoGoTable(obj)
    item.aorimage_isOn:SetActiveE(isOn and 1 or 0)
end

---按钮点击事件在这里派发
function SociatyBattleLeagueNewsView:OnClickBtn(go, isOn)
    if go == self.go_table.toggle_member then
        self:OnMember(isOn)
    elseif go == self.go_table.toggle_news then
        self:OnNews(isOn)
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

return SociatyBattleLeagueNewsView
