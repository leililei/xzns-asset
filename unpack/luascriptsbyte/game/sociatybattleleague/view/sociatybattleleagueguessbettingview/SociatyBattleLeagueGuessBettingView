---@class SociatyBattleLeagueGuessBettingView : UIBaseView	中文描述
---@field public go_table SociatyBattleLeagueGuessBettingView_GoTable GoTable
---@field public data guild_league.i_guild_match_info
local SociatyBattleLeagueGuessBettingView = _G.BaseClass("SociatyBattleLeagueGuessBettingView", _G.UIBaseView)

function SociatyBattleLeagueGuessBettingView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyBattleLeagueGuessBettingView:OnCreate(data, cfg, index, winTag, call)
    self.data = data
    self.cfg = cfg
    self.index = index
    self.winTag = winTag
    self.call = call
    self.left = _G.GetAutoGoTable(self.go_table.obj_left, _G.handlerbind(self, self.OnClickGuess, 1))
    self.right = _G.GetAutoGoTable(self.go_table.obj_right, _G.handlerbind(self, self.OnClickGuess, 2))
    self:InitView()
    local res = _G.ConfigManager.ui_cfg.SociatyBattleLeagueGuessBettingView.resources
    self:AddComponent(self.go_table.obj_gold, require("ResourceCompont").New(self.go_table.obj_gold, res))
end

function SociatyBattleLeagueGuessBettingView:InitView()
    self:ShowSociaty(self.left, self.data.guild_a)
    self:ShowSociaty(self.right, self.data.guild_b)
    self.left.aortext_rating.text = ""
    self.right.aortext_rating.text = ""
    local pbData = {type_list = {{key = self.winTag == 1 and 1 or 2, value = self.index}}}
    require("SociatyBattleLeagueNet"):GetInstance():GetGuessRate(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            local guessData = msg.guess_list[1].guess_list or {}
            local left, right = 0, 0
            for _, v in pairs(guessData) do
                if v.key == self.data.guild_a.guild_uid then
                    left = v.value
                elseif v.key == self.data.guild_b.guild_uid then
                    right = v.value
                end
            end
            local total = left + right
            if total == 0 then
                self.left.aortext_rating.text = "0%"
                self.right.aortext_rating.text = "0%"
            else
                self.left.aortext_rating.text = _G.string.format("%.1f%%", 100 * left / total)
                self.right.aortext_rating.text = _G.string.format("%.1f%%", 100 * right / total)
            end
        end
    )
end

function SociatyBattleLeagueGuessBettingView:ShowSociaty(tb, gData)
    tb.aortext_name.text = _G.tonumber(gData.guild_name) and _G.GetLangPackValue(gData.guild_name) or gData.guild_name
    local severname = _G.ServerManager:GetInstance():GetServerNameByServerID(gData.server_id)
    tb.aortext_serverName.text = severname or self:GetInSeverName(gData.server_id)
    tb.aorrawimage_icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[gData.banner].portrait)
    tb.aorrawimage_costIcon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(self.cfg.gear[1][1]))
    tb.aortext_num.text = self.cfg.gear[1][2]
end

---获取内网服务器信息
function SociatyBattleLeagueGuessBettingView:GetInSeverName(id)
    local list = {}
    local curServer = _G.ServerManager:GetInstance().CurServer
    for _, v in pairs(_G.ConfigManager.server_list_cfg) do
        if v.ServerID == id then
            _G.table.insert(list, v)
        end
    end
    local count = #list
    if count == 0 or count > 1 then
        return curServer.ServerName
    else
        return list[1].ServerName
    end
end

function SociatyBattleLeagueGuessBettingView:OnClickGuess(go, isOn, index)
    local uid
    if index == 1 then
        uid = self.data.guild_a.guild_uid
    else
        uid = self.data.guild_b.guild_uid
    end
    require("SociatyBattleLeagueModel"):GetInstance():DoGuess(
        self.index,
        uid,
        1,
        function()
            if self.call then
                self.call()
            end
            self:Close()
        end,
        self.winTag
    )
end

---按钮点击事件在这里派发
function SociatyBattleLeagueGuessBettingView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end

---界面的销毁函数
function SociatyBattleLeagueGuessBettingView:OnDestroy()
end

return SociatyBattleLeagueGuessBettingView
