---@class SociatyBattleLeagueRankView : UIBaseView	中文描述
---@field public go_table SociatyBattleLeagueRankView_GoTable GoTable
local SociatyBattleLeagueRankView = _G.BaseClass("SociatyBattleLeagueRankView", _G.UIBaseView)

local stateAndIndex = {
    [1] = {3, 1},
    [2] = {3, 2},
    [3] = {4, 1},
    [4] = {5, 1},
    [5] = {6, 1},
    [6] = {7, 1},
    [7] = {8, 1},
    [8] = {9, 1}
}

function SociatyBattleLeagueRankView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.stateAndStr = {
        [1] = _G.GetLangPackValue(90032100019),
        [2] = _G.GetLangPackValue(90032100020),
        [3] = _G.GetLangPackValue(90032100046),
        [4] = _G.GetLangPackValue(90032100047),
        [5] = _G.GetLangPackValue(90032100048),
        [6] = _G.GetLangPackValue(90032100022),
        [7] = _G.GetLangPackValue(90032100023),
        [8] = _G.GetLangPackValue(90032100024)
    }
end

---界面的入口函数
function SociatyBattleLeagueRankView:OnCreate()
    self.rankDatas = {}
    self.rankSelf = {}
    self.curIndex = 1

    local SociatyBattleLeagueModel = require "SociatyBattleLeagueModel":GetInstance()
    local SociatyBattleLeagueManager = require "SociatyBattleLeagueManager":GetInstance()

    if
        SociatyBattleLeagueManager:GetStageState() >= _G.SociatyBattleLeagueStageState.BattleGroup and
            SociatyBattleLeagueManager:GetStageState() < _G.SociatyBattleLeagueStageState.End
     then
        if SociatyBattleLeagueManager:GetStageState() == _G.SociatyBattleLeagueStageState.BattleGroup then
            if SociatyBattleLeagueModel:CheckIsGroupFirstDay() then
                self.curIndex = 1
            else
                self.curIndex = 2
            end
        else
            self.curIndex = SociatyBattleLeagueManager:GetStageState() - 1
        end
    end

    if nil == stateAndIndex[self.curIndex] then
        self.curIndex = 1
    end
    self.go_table.scrollloopvectical_rankList:InitItemData(0, _G.handler(self, self.RefreshRank))
    self.go_table.aortext_curDanZone.text = self.stateAndStr[self.curIndex]
    self:GetSeasonRank()
end

---显示赛季选择
function SociatyBattleLeagueRankView:ShowSelect()
    if self.go_table.obj_isDanSelect:GetActiveSelf() == 0 then
        ---展开
        self.go_table.obj_isDanSelect:SetActiveE(1)
        self.go_table.aorimage_danArrow:SetRotation(0, 0, 180)
        if not self.selectInit then
            self.go_table.scrollloopvectical_danZone:InitItemData(
                #stateAndIndex,
                _G.handler(self, self.RefreshSeasonItem)
            )
            self.selectInit = true
        else
            self.go_table.scrollloopvectical_danZone:UpdateCount(#stateAndIndex)
        end
    else
        ---合上
        self.go_table.obj_isDanSelect:SetActiveE(0)
        self.go_table.aorimage_danArrow:SetRotation(0, 0, 0)
    end
end

---显示前三名公会信息
function SociatyBattleLeagueRankView:ShowTopRank(data, rank)
    local topItem = _G.GetAutoGoTable(self.go_table["obj_info" .. rank])
    topItem.aortext_name.text = data.guild_name
    topItem.obj_score:SetActiveE(1)
    topItem.obj_Banner:SetActiveE(1)
    topItem.aortext_score.text = _G.GetLangPackValue(90000010438, data.guild_score)
    topItem.aorrawimage_Icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.banner].portrait)
end

---刷新大区item
function SociatyBattleLeagueRankView:RefreshSeasonItem(index, obj)
    index = index + 1
    ---@type _obj_zoneRank._obj_zoneItem_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnSelect, index))
    tb.aortext_zone.text = self.stateAndStr[index]
    if index == self.curIndex then
        tb.obj_isMyZone:SetActiveE(1)
        tb.aortext_zone.color = _G.ColorTools.FormatColorByString("ffffff")
    else
        tb.obj_isMyZone:SetActiveE(0)
        tb.aortext_zone.color = _G.ColorTools.FormatColorByString("808199")
    end
end

---选择赛季
function SociatyBattleLeagueRankView:OnSelect(go, isOn, index)
    self:ShowSelect()
    if index ~= self.curIndex then
        self.curIndex = index
        self:GetSeasonRank()
        self.go_table.aortext_curDanZone.text = self.stateAndStr[self.curIndex]
    end
end

function SociatyBattleLeagueRankView:GetSeasonRank()
    if not self.rankDatas[self.curIndex] then
        require "SociatyBattleLeagueNet":GetInstance():GetRank(
            {state = stateAndIndex[self.curIndex][1], index = stateAndIndex[self.curIndex][2]},
            function(msg)
                self.rankDatas[self.curIndex] = msg.ranks or {}
                self.rankSelf[self.curIndex] = msg.self_guild
                self:UpdateRankView()
            end
        )
    else
        self:UpdateRankView()
    end
end

function SociatyBattleLeagueRankView:UpdateRankView()
    self.go_table.scrollloopvectical_rankList:UpdateCount(#self.rankDatas[self.curIndex])
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_no, #self.rankDatas[self.curIndex] <= 0)
    local uid = require("SociatyModel"):GetInstance().SociatySelf.Uid
    local index = -1
    for i, v in ipairs(self.rankDatas[self.curIndex]) do
        if v.guild_uid == uid then
            index = i - 1
        end
    end
    self:RefreshRank(index, self.go_table.obj_player, true)
end

function SociatyBattleLeagueRankView:RefreshRank(index, obj, isSelf)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj)
    local data
    if index == 0 then
        tb.aortext_rankNum.text = _G.GetLangPackValue(90022900040)
        data = self.rankSelf[self.curIndex]
    else
        data = self.rankDatas[self.curIndex][index]

        --if tb.aorimage_rankBg then
        --    tb.aorimage_rankBg:SetActiveE(index <= 3 and 1 or 0)
        --end
        if tb.obj_rankBg2 then
            tb.obj_rankBg2:SetActiveE(index <= 3 and 0 or 1)
        end
        if (not isSelf) and index <= 3 then
            tb.aorimage_rankBg.SpriteName = "ui_diban" .. index
            tb.aorimage_rankBg:SetRectTransformSize(690, 120)
            self:ShowTopRank(data, index)
        else
            tb.aortext_rankNum.text = index
            tb.aorimage_rankBg.SpriteName = "TY_img_kuang"
            tb.aorimage_rankBg:SetRectTransformSize(680, 112)
        end
    end
    if data then
        tb.aortext_name.text = data.guild_name
        tb.aortext_power.text = _G.GetLangPackValue(90032100009) .. _G.GameUtil.NumberToUnitWord(data.guild_power)
        tb.aortext_score.text = data.guild_score
        tb.aorrawimage_icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.banner].portrait)
        tb.aortext_server.text =
            _G.GetLangPackValue(90032100010, _G.ServerManager:GetInstance():GetServerNameByServerID(data.server_id))
        tb.obj_iconbg:SetActiveE(1)
    else
        tb.aortext_name.text = ""
        tb.aortext_power.text = ""
        tb.aortext_score.text = ""
        tb.aorrawimage_icon:LoadImage(nil)
        tb.aortext_server.text = ""
        tb.obj_iconbg:SetActiveE(0)
    end
end

---界面的销毁函数
function SociatyBattleLeagueRankView:OnDestroy()
end

---按钮点击事件在这里派发
function SociatyBattleLeagueRankView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.aorbtn_danArrow then
        self:ShowSelect()
    end
end

return SociatyBattleLeagueRankView
