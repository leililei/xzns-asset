---@class SocaityBattleLeagueBoxAwardPreView : UIBaseView	中文描述
---@field public go_table SocaityBattleLeagueBoxAwardPreView_GoTable GoTable
local SocaityBattleLeagueBoxAwardPreView = _G.BaseClass("SocaityBattleLeagueBoxAwardPreView", _G.UIBaseView)
local limitedCfg = _G.ConfigManager.limited_roller_cfg
--_G.SocaityBattleLeagueBoxAwardPreView = SocaityBattleLeagueBoxAwardPreView
function SocaityBattleLeagueBoxAwardPreView:Awake()
    self.AwardDatas = {}
    self.itemList = {}
    self.weight = 0
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param sid number 奖池idp
function SocaityBattleLeagueBoxAwardPreView:OnCreate(pre, isGet)
    for k, v in pairs(pre) do
        local item = {}
        item.sid = v[3]
        item.num = 1
        table.insert(self.AwardDatas, item)
    end

    self.go_table.scrollloopvectical_AwardList:InitItemData(#self.AwardDatas, _G.handler(self, self.RefreshList))
end
---刷新显示
function SocaityBattleLeagueBoxAwardPreView:RefreshList(index, obj)
    local instanceID = obj:GetInstanceIDE()
    local tb = self.itemList[instanceID]
    local data = self.AwardDatas[index + 1]
    if not data then
        return
    end
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        self.itemList[instanceID] = tb
        ---@type BaseAwardNewItem
        tb.item = require "BaseAwardNewItem".New(tb.obj_Root, _G.handler(self, self.OnClickItem), 88)
    end
    ---@param item BaseAwardNewItem
    tb.item:ShowWithID(
        {data.sid, data.num},
        nil,
        function(item)
            if item.item.HideOrShowStar then
                item.item:HideOrShowStar(false)
            end
            item:ShowEffect(data.Grand)
        end
    )
    -- local name = _G.StorageManager:GetInstance():GetItemName(data.award[1].sid)
    -- tb.aortext_name.text = _G.LangUtil.GetLangPackValue(name)
    --tb.aortext_probNum.text = self:GetPerData(index + 1) .. "%"
end

---点击奖励
function SocaityBattleLeagueBoxAwardPreView:OnClickItem(item)
    require "CommonTipManager":GetInstance():OpenTip(item.gameObject, item.data.sid)
end

---按钮点击事件在这里派发
function SocaityBattleLeagueBoxAwardPreView:OnClickBtn(go, isOn)
    self:Close()
end

