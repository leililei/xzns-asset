local SociatyBattleLeagueModel = require("SociatyBattleLeagueModel")

---@class SociatyBattleLeagueGuessCompeteView : UIBaseView	中文描述
---@field public go_table SociatyBattleLeagueGuessCompeteView_GoTable GoTable
local SociatyBattleLeagueGuessCompeteView = _G.BaseClass("SociatyBattleLeagueGuessCompeteView", _G.UIBaseView)

function SociatyBattleLeagueGuessCompeteView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyBattleLeagueGuessCompeteView:OnCreate()
    local res = _G.ConfigManager.ui_cfg.SociatyBattleLeagueGuessCompeteView.resources
    self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, res))
    self.cPanel =
        self:AddComponent(
        self.go_table.obj_course,
        require("SociatyBattleLeagueCoursePanel").New(self.go_table.obj_course, true, 2)
    )
    self.winTag = 1
    self.go_table.toggle_all.isOn = true
    local stageState = SociatyBattleLeagueModel:GetInstance():GetStageState()
    if stageState == _G.SociatyBattleLeagueStageState.BattleGroup then
        self.go_table.toggle_fail:SetActiveE(0)
        self.go_table.toggle_win:SetActiveE(0)
    end
    if stageState == _G.SociatyBattleLeagueStageState.BattleElimination then
        self.go_table.toggle_fail:SetActiveE(0)
        self.go_table.toggle_win:SetActiveE(1)
    end
end

---刷新
function SociatyBattleLeagueGuessCompeteView:UpdateView()
end

function SociatyBattleLeagueGuessCompeteView:OnAll(isOn)
    self:ShowToggles(self.go_table.toggle_all, isOn)
    if not isOn then
        return
    end
    self.allTag = 1
    self:SetView()
end

function SociatyBattleLeagueGuessCompeteView:OnNext(isOn)
    self:ShowToggles(self.go_table.toggle_next, isOn)
    if not isOn then
        return
    end
    self.allTag = 2
    self:SetView()
end

function SociatyBattleLeagueGuessCompeteView:OnWin(isOn)
    self:ShowToggles(self.go_table.toggle_win, isOn)
    if not isOn then
        return
    end
    self.winTag = 1
    self:SetView()
end

function SociatyBattleLeagueGuessCompeteView:OnFail(isOn)
    self:ShowToggles(self.go_table.toggle_fail, isOn)
    if not isOn then
        return
    end
    self.winTag = 2
    self:SetView()
end

function SociatyBattleLeagueGuessCompeteView:SetView()
    self.cPanel:Show(self.allTag == 2, nil, self.winTag)
end

---显示标签
function SociatyBattleLeagueGuessCompeteView:ShowToggles(obj, isOn)
    local item = _G.GetAutoGoTable(obj)
    item.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    -- obj:SetActiveE(isOn and 1 or 0)
end

function SociatyBattleLeagueGuessCompeteView:OnStartClose()
    local somain = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SociatyBattleLeagueMainView.Name)
    if nil == somain then
        if SociatyBattleLeagueModel:GetInstance().IsJoin then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleLeagueMainView.Name)
        end
    end
end

---按钮点击事件在这里派发
function SociatyBattleLeagueGuessCompeteView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.toggle_all then
        self:OnAll(isOn)
    elseif go == self.go_table.toggle_next then
        self:OnNext(isOn)
    elseif go == self.go_table.toggle_win then
        self:OnWin(isOn)
    elseif go == self.go_table.toggle_fail then
        self:OnFail(isOn)
    end
end

---界面的销毁函数
function SociatyBattleLeagueGuessCompeteView:OnDestroy()
end

return SociatyBattleLeagueGuessCompeteView
