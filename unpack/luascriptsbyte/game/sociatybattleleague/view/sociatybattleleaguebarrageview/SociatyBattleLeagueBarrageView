local SociatyBattleLeagueModel = require("SociatyBattleLeagueModel")

---@class SociatyBattleLeagueBarrageView : UIBaseView	中文描述
---@field public go_table SociatyBattleLeagueBarrageView_GoTable GoTable
local SociatyBattleLeagueBarrageView = _G.BaseClass("SociatyBattleLeagueBarrageView", _G.UIBaseView)

function SociatyBattleLeagueBarrageView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

local moveChatWindowRange = {-1305, 435}
local bulletFormatStr = "<img=%s>%s"
local bulletChatFormatStr = "<color=#f6d257>%s</color>"
local dis = _G.ConfigManager.discrete_cfg[105723][1][1]

---界面的入口函数
function SociatyBattleLeagueBarrageView:OnCreate()
    self.moveChatWindowX = moveChatWindowRange[2]
    self.moveChatWindowSpeed = _G.ConfigManager.discrete_cfg[108310][1][1] * moveChatWindowRange[2]
    self.chatMsgMaxCount = _G.ConfigManager.discrete_cfg[108311][1][1]
    self.chatState = _G.PlayerPrefsManager.GetInt("SociatyBattleLeagueBarrageShow", 1)
    self.chatWindowItem = {
        self.go_table.aorimgtext_1,
        self.go_table.aorimgtext_2,
        self.go_table.aorimgtext_3,
        self.go_table.aorimgtext_4,
        self.go_table.aorimgtext_5,
        self.go_table.aorimgtext_6
    }
    self:ShowChatWindow(self.chatState == 1)
    if self.chatState ~= 1 then
        SociatyBattleLeagueModel:GetInstance():GetBulletInfo()
    end
    self:AddListener(_G.eSociatyBattleLeague.SociatyBattleBarrageStateChangeLeague, self.ShowChatWindow)
end

--region ------------- 弹幕相关 -------------
---是否打开弹幕
---@param show boolean 是否打开弹幕
function SociatyBattleLeagueBarrageView:ShowChatWindow(show)
    self.chatMsgList = {}
    if show then
        self.go_table.trans_chatWindow:SetActiveE(1)
        if _G.table.isEmptyOrNil(self.chatMsgList) then
            SociatyBattleLeagueModel:GetInstance():GetBulletInfo(_G.handler(self, self.OnGetChatDataCall))
        else
            self:MoveChatWindow(true)
        end
    else
        self.go_table.trans_chatWindow:SetActiveE(0)
        self:MoveChatWindow(false)
    end
end
function SociatyBattleLeagueBarrageView:MoveChatWindow(move)
    if move then
        if self.moveChatWindowTimer then
            self.moveChatWindowTimer:Resume()
        else
            self.moveChatWindowTimer =
                _G.TimerManager:GetInstance():GetTimer(1, self.OnChatWindowMove, self, false, true)
            self.moveChatWindowTimer:Start()
        end
    else
        if self.moveChatWindowTimer then
            self.moveChatWindowTimer:Pause()
        end
        if self.onResetChatTimer then
            self.onResetChatTimer:Stop()
            self.onResetChatTimer = nil
        end
    end
end

function SociatyBattleLeagueBarrageView:UpdateChatWindowView()
    if self.resetChatWindowTag then
        --TODO:延时等待 然后开启新的循环
        self.curShowChatIndex = 1
        self.resetChatWindowTag = false
        self.onResetChatTimer =
            _G.TimerManager:GetInstance():GetTimer(
            _G.ConfigManager.discrete_cfg[105719][1][1],
            self.OnResetChatWindow,
            self,
            true
        )
        if self.moveChatWindowTimer then
            self.moveChatWindowTimer:Pause()
        end
        self.onResetChatTimer:Start()
    end
    local data, cfg
    -- local cfgs = _G.ConfigManager.bullet_chat_cfg
    local cfgs = require("ChatManager"):GetInstance():Phiz_GetEvenAll(12)
    local format = _G.string.format
    local name
    for i = 1, 6 do
        data = self.chatMsgList[self.curShowChatIndex]
        if data then
            local text = ""
            name = data.role.name
            name = name .. ":"
            name = format("<color=#76daf8>%s</color>", name)
            if data.type == 2 then
                if cfgs[data.sid] then
                    cfg = cfgs[data.sid]
                    local iconStr = cfg.icon == "" and "" or format(bulletFormatStr, cfg.icon, name)
                    if data.role.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                        text = iconStr .. _G.GetLangPackValue(cfg.content[2])
                    else
                        text = iconStr .. _G.GetLangPackValue(cfg.content[1])
                    end
                end
            else
                if data.role.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                    text = name .. data.content
                    text = format(bulletChatFormatStr, text)
                else
                    text = name .. data.content
                end
            end
            if i > 3 then
                local x, y, z = self.chatWindowItem[i - 3]:GetLocalPosition()
                self.chatWindowItem[i]:SetLocalPosition(x + dis, y, z)
            end

            self.chatWindowItem[i].text = text
        end
        self.curShowChatIndex = self.curShowChatIndex + 1
        if self.curShowChatIndex > #self.chatMsgList then
            self.curShowChatIndex = 1
            self.resetChatWindowTag = true
            if #self.chatMsgList < 6 then
                break
            end
        end
    end
end
function SociatyBattleLeagueBarrageView:OnGetChatDataCall(info)
    self.chatMsgList = SociatyBattleLeagueModel:GetInstance():GetChatMsgList()
    self.curShowChatIndex = 1
    self:UpdateChatWindowView()
    self:MoveChatWindow(true)
end

function SociatyBattleLeagueBarrageView:OnResetChatWindow()
    if self:IsNil() then
        return
    end
    if self.moveChatWindowTimer then
        self.moveChatWindowTimer:Resume()
    end
end

function SociatyBattleLeagueBarrageView:OnChatWindowMove()
    if self:IsNil() then
        return
    end
    self.moveChatWindowX = self.moveChatWindowX - _G.Time.deltaTime * self.moveChatWindowSpeed
    if self.moveChatWindowX < moveChatWindowRange[1] then
        self.moveChatWindowX = moveChatWindowRange[2]
        --TODO:展示下一轮
        self:UpdateChatWindowView()
    end
    self.go_table.trans_chatWindow:SetLocalPosition(self.moveChatWindowX, 0, 0)
end

--endregion -----------  end -----------

function SociatyBattleLeagueBarrageView:OnEnable()
    if self.onDIsablePauseTag then
        if self.moveChatWindowTimer then
            self.moveChatWindowTimer:Resume()
            self.onDIsablePauseTag = nil
        end
    end
    if self.onResetChatTimer then
        self.onResetChatTimer:Resume()
    end
end

function SociatyBattleLeagueBarrageView:OnDisable()
    if self.onResetChatTimer then
        self.onResetChatTimer:Pause()
    end
    if self.moveChatWindowTimer then
        self.moveChatWindowTimer:Pause()
        self.onDIsablePauseTag = true
    end
end

---@private
function SociatyBattleLeagueBarrageView:OnDestroy()
    if self.onResetChatTimer then
        self.onResetChatTimer:Stop()
        self.onResetChatTimer = nil
    end
    if self.moveChatWindowTimer then
        self.moveChatWindowTimer:Stop()
        self.moveChatWindowTimer = nil
    end
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:RemoveListener(_G.eSociatyBattleLeague.SociatyBattleBarrageStateChangeLeague, self.ShowChatWindow)
end

return SociatyBattleLeagueBarrageView
