---@class SociatyBattleLeagueDefRecordView : UIBaseView	中文描述
---@field public go_table SociatyBattleDefRecordView_GoTable GoTable
local SociatyBattleLeagueDefRecordView = _G.BaseClass("SociatyBattleLeagueDefRecordView", _G.UIBaseView)

function SociatyBattleLeagueDefRecordView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

local GetAutoGoTable = _G.GetAutoGoTable
local handlerbind = _G.handlerbind

---界面的入口函数
function SociatyBattleLeagueDefRecordView:OnCreate(data)
    self.go_table.aortext_record.text = "111"
    for i = 1, 3 do
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.ItemCardStorageView,
            self.go_table["obj_card" .. i],
            function(item)
                item:Show(data[i], nil, 24, nil, 300, nil, false)
            end
        )
    end
    self.go_table.scrollloopvectical_playerList:InitItemData(0, self.RefreshList)
end

function SociatyBattleLeagueDefRecordView:RefreshList(index, obj)
    index = index + 1
    ---@type SociatyBattleLeagueDefRecordView._obj_playerItem_GoTable
    local tb = GetAutoGoTable(obj, handlerbind(self, self.OnClickItem, index))
    local data
    tb.obj_player:SetActiveE(self.curPage == 1 and 1 or 0)
    tb.obj_array:SetActiveE(self.curPage == 2 and 1 or 0)
    tb.aortext_record.text = "111"
    _G.UIUtils.SetPlayerHeadItemNew(
        tb.obj_HeadItemBase,
        {uid = data.role_uid, style = data.style, frame = data.frame},
        nil,
        true,
        nil
    )
    tb.aortext_name.text = "111"
    tb.aortext_server.text = "111"
end

function SociatyBattleLeagueDefRecordView:OnClickItem(go, isOn, index)
end

---按钮点击事件在这里派发
function SociatyBattleLeagueDefRecordView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

return SociatyBattleLeagueDefRecordView
