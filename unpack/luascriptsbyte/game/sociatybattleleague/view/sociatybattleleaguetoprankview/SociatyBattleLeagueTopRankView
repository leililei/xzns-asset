---显示赛季选择
function SociatyBattleLeagueTopRankView:ShowSelect()
    if self.go_table.obj_isDanSelect:GetActiveSelf() == 0 then
        ---展开
        self.go_table.obj_isDanSelect:SetActiveE(1)
        self.go_table.aorimage_danArrow:SetRotation(0, 0, 180)
        if not self.selectInit then
            self.go_table.scrollloopvectical_danZone:InitItemData(
                #self.seasonLis,
                _G.handler(self, self.RefreshSeasonItem)
            )
            self.selectInit = true
        else
            self.go_table.scrollloopvectical_danZone:UpdateAllItem()
        end
    else
        ---合上
        self.go_table.obj_isDanSelect:SetActiveE(0)
        self.go_table.aorimage_danArrow:SetRotation(0, 0, 0)
    end
end

---刷新大区item
function SociatyBattleLeagueTopRankView:RefreshSeasonItem(index, obj)
    index = index + 1
    ---@type _obj_zoneRank._obj_zoneItem_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnSelect, index))
    tb.aortext_zone.text = _G.GetLangPackValue(90029400052, index)
    if self.seasonLis[index] == self.curIndex then
        tb.obj_isMyZone:SetActiveE(1)
        tb.aortext_zone.color = _G.ColorTools.FormatColorByString("ffffff")
    else
        tb.obj_isMyZone:SetActiveE(0)
        tb.aortext_zone.color = _G.ColorTools.FormatColorByString("808199")
    end
end

---选择赛季
function SociatyBattleLeagueTopRankView:OnSelect(go, isOn, index)
    self:ShowSelect()
    if index ~= self.curIndex then
        self.curIndex = index
        self:GetSeasonRank()
    end
end

function SociatyBattleLeagueTopRankView:GetSeasonRank()
    if self.stageState == _G.SociatyBattleLeagueStageState.None and self.Session > 1 then
        --ZHJH5ZHJH-11359 【Alpha】BuglistZHJH-13535
        --【跨服奥山】当前赛季结束后，进入功能未显示当前赛季排名及奖励排行
    else
        --后端说打完会成None状态，实际上End状态不会发，多加个判断
        if (not self.isEnd and self.stageState ~= _G.SociatyBattleLeagueStageState.None) and self.curIndex == self.Session then --还没打完结算，显示虚位以待
            local falsedata = {}
            for i = 1, 16 do
                local info = {}
                table.insert(falsedata, info)
            end
            self.rankDatas[self.curIndex] = falsedata
            self.awardSeaId =
                (self.SeasonId and self.SeasonId > 0) and self.SeasonId or self.curIndex
            self:UpdateRankView()
            --self:ShowEmpty()
            return
        end
    end
    if not self.rankDatas[self.curIndex] then
        SociatyBattleLeagueNet:GetInstance():GetLastRank(
            { session = self.curIndex },
            function(msg)
                local falsedata = {}
                for i = 1, 16 do
                    local info = {}
                    table.insert(falsedata, info)
                end
                self.rankDatas[self.curIndex] = msg.ranks or falsedata
                self.awardSeaId =
                    (msg.season_cfg_sid and msg.season_cfg_sid > 0) and msg.season_cfg_sid or self.curIndex
                self:UpdateRankView()
            end
        )
    else
        self:UpdateRankView()
    end
end

function SociatyBattleLeagueTopRankView:UpdateRankView()
    self:InitTopView()
    self:SetReward()
    local num = #self.rankDatas[self.curIndex]
    self.go_table.aortext_empty:SetActiveE(num == 0 and 1 or 0)
    self.go_table.scrollloopvectical_rankList:SetActiveE(num > 0 and 1 or 0)
    self.go_table.scrollloopvectical_rankList:UpdateCount(num)
    self.go_table.aortext_curDanZone.text = _G.GetLangPackValue(90029400052, self.curIndex)
end

