---奖励数据
function SociatyBattleLeagueTopRankView:SetReward()
    local theId = self.awardSeaId and self.awardSeaId or self.curIndex
    local rankids = _G.ConfigManager.guild_league_season_cfg[theId].rank
    self.dataRewards = {}
    for i, v in ipairs(rankids) do
        local cfg = _G.ConfigManager.arena_rank_cfg[v]
        for i2 = cfg.min_rank, cfg.max_rank do
            _G.table.insert(self.dataRewards, cfg.reward_daily)
        end
    end
end

function SociatyBattleLeagueTopRankView:RefreshRank(index, obj)
    index = index + 1
    local data = self.rankDatas[self.curIndex][index]
    local instanceID = obj:GetInstanceIDE()
    local tb
    if data.guild_uid then
        tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickRank, data.guild_uid))
        --tb.aorimage_rankBg:SetActiveE(index <= 3 and 1 or 0)
        tb.obj_rankBg2:SetActiveE(index <= 3 and 0 or 1)
        for i = 1, 3 do
            tb["obj_rank" .. i]:SetActiveE(i == index and 1 or 0)
        end
        if index <= 3 then
            tb.aorimage_rankBg.SpriteName = "ui_diban" .. index
            tb.aorimage_rankBg:SetRectTransformSize(690, 140)
        else
            tb.aorimage_rankBg.SpriteName = "TY_img_kuang"
            tb.aorimage_rankBg:SetRectTransformSize(680, 134)
            tb.aortext_rankNum.text = index
        end
        tb.aortext_name.text = data.guild_name
        tb.aortext_power.text = _G.GetLangPackValue(90032100009) .. _G.GameUtil.NumberToUnitWord(data.guild_power)
        tb.aorrawimage_icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.banner].portrait)
        tb.aortext_server.text =
            _G.GetLangPackValue(90032100010, _G.ServerManager:GetInstance():GetServerNameByServerID(data.server_id))
    else
        tb = _G.GetAutoGoTable(obj)
        tb.obj_rankBg2:SetActiveE(index <= 3 and 0 or 1)
        for i = 1, 3 do
            tb["obj_rank" .. i]:SetActiveE(i == index and 1 or 0)
        end
        if index <= 3 then
            tb.aorimage_rankBg.SpriteName = "ui_diban" .. index
            tb.aorimage_rankBg:SetRectTransformSize(690, 140)
        else
            tb.aorimage_rankBg.SpriteName = "TY_img_kuang"
            tb.aorimage_rankBg:SetRectTransformSize(680, 134)
            tb.aortext_rankNum.text = index
        end
        tb.aorrawimage_icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[1001].portrait)
        tb.aortext_server.text = "      " .. _G.GetLangPackValue(90000010159)
    end
    local v = self.dataRewards[index][1]
    tb.v = v
    local item = self.DifficultyItems[instanceID]
    if not item then
        item =
            require "BaseAwardNewItem".New(
                tb.obj_award,
                _G.handler(
                    self,
                    function()
                        require "CommonTipManager":GetInstance():OpenTip(tb.obj_award, tb.v[1])
                    end
                ),
                88,
                tb.obj_award
            )
        self.DifficultyItems[instanceID] = item
    end
    local dataReward = _G.StorageManager:GetInstance():GetItemDataClass(tb.v[1], tb.v[2])
    item:Show(dataReward)
end

function SociatyBattleLeagueTopRankView:InitTopView()
    for i = 1, 3 do
        local item = _G.GetAutoGoTable(self.go_table["obj_rank" .. i])
        if self.rankDatas[self.curIndex][i] then
            local data = self.rankDatas[self.curIndex][i]
            if data.guild_uid then
                item.aorrawimage_SociatyIcon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.banner].portrait)
                item.aortext_name.text = data.guild_name
            else
                item.aortext_name.text = _G.GetLangPackValue(90000010159)
            end
        end
    end
end

