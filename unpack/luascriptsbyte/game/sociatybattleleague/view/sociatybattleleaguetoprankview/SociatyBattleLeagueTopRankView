function SociatyBattleLeagueTopRankView:OnDestroy()
end

function SociatyBattleLeagueTopRankView:OnClickRank(go, isOn, uid)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyInfoPreviewView.Name, uid)
end

---按钮点击事件在这里派发
function SociatyBattleLeagueTopRankView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_danArrow then
        -- self:ShowSelect()
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 147)
    end
end

return SociatyBattleLeagueTopRankView
