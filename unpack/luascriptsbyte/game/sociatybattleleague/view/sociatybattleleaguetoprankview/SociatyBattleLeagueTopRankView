local SociatyBattleLeagueNet = require "SociatyBattleLeagueNet"
local SociatyBattleLeagueModel = require "SociatyBattleLeagueModel"
---@class SociatyBattleLeagueTopRankView : UIBaseView	中文描述
---@field public go_table SociatyBattleLeagueTopRankView_GoTable GoTable
local SociatyBattleLeagueTopRankView = _G.BaseClass("SociatyBattleLeagueTopRankView", _G.UIBaseView)

function SociatyBattleLeagueTopRankView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyBattleLeagueTopRankView:OnCreate()
    self.rankDatas = {}
    self.DifficultyItems = {}
    self.seasonLis = {}
    self.Session = SociatyBattleLeagueModel:GetInstance().CurSession
    self.SeasonId = SociatyBattleLeagueModel:GetInstance().SeasonId
    self.stageState = SociatyBattleLeagueModel:GetInstance():GetStageState()
    self.isEnd = self.stageState == _G.SociatyBattleLeagueStageState.End
    if not self.isEnd then
        if self.stageState == _G.SociatyBattleLeagueStageState.None then
            --ZHJH5ZHJH-11359 【Alpha】BuglistZHJH-13535
            --【跨服奥山】当前赛季结束后，进入功能未显示当前赛季排名及奖励排行
        else
            self.Session = self.Session + 1
        end
    end
    if self.Session == 0 then
        return
    end
    self.curIndex = self.Session
    for i = 1, self.Session do
        _G.table.insert(self.seasonLis, i)
    end
    self.go_table.scrollloopvectical_rankList:InitItemData(0, _G.handler(self, self.RefreshRank))
    self.go_table.aortext_curDanZone.text = _G.GetLangPackValue(90029400052, self.curIndex)
    self:GetSeasonRank()
    --self:LoadEffect()
end

