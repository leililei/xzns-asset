local SociatyBattleLeagueModel = require("SociatyBattleLeagueModel")

---@class SociatyBattleLeagueCourseView : UIBaseView	中文描述
---@field public go_table SociatyBattleLeagueCourseView_GoTable GoTable
local SociatyBattleLeagueCourseView = _G.BaseClass("SociatyBattleLeagueCourseView", _G.UIBaseView)

function SociatyBattleLeagueCourseView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

local CPState = _G.SociatyBattleLeagueCoursePosState

---界面的入口函数
function SociatyBattleLeagueCourseView:OnCreate()
    self.sliderNum = { 0, 0.244, 0.616, 1 }
    self.go_table.obj_course:SetActiveE(0)
    self.go_table.obj_knockout:SetActiveE(0)
    self.knockoutTable = {
        _G.GetAutoGoTable(self.go_table.obj_eight),
        _G.GetAutoGoTable(self.go_table.obj_four),
        _G.GetAutoGoTable(self.go_table.obj_third),
        _G.GetAutoGoTable(self.go_table.obj_champion)
    }
    local stage = SociatyBattleLeagueModel:GetInstance():GetStageState()
    if stage > _G.SociatyBattleLeagueStageState.BattleGroup then
        self:OnKnockout(true)
        self.go_table.toggle_knockout.isOn = true
    else
        self:OnGroup(true)
        self.go_table.toggle_group.isOn = true
    end
    --self:LoadEffect()
end

function SociatyBattleLeagueCourseView:LoadEffect()
    local tb = _G.GetAutoGoTable(self.go_table.obj_node10)
    local check = function(trans)
        if self:IsNil() then
            _G.DestroyObject(trans)
        end
    end
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_SociatyBattleLeagueCourseView_loop,
        tb.obj_effect,
        check
    )
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_SociatyBattleLeagueCourseView_front,
        tb.obj_effect,
        check
    )
end

function SociatyBattleLeagueCourseView:OnGroup(isOn)
    self:ShowToggles(self.go_table.toggle_group, isOn)
    self.go_table.obj_course:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    if self.cPanel == nil then
        self.cPanel =
            self:AddComponent(
                self.go_table.obj_course,
                require("SociatyBattleLeagueCoursePanel").New(self.go_table.obj_course, false, 3)
            )
        self.cPanel:Show(nil, true)
    end
end

function SociatyBattleLeagueCourseView:OnKnockout(isOn)
    self:ShowToggles(self.go_table.toggle_knockout, isOn)
    self.go_table.obj_knockout:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    if not self.knockoutInit then
        self:ShowKnockout()
        self.knockoutInit = true
    end
end

function SociatyBattleLeagueCourseView:ShowKnockout()
    local stageState = SociatyBattleLeagueModel:GetInstance():GetStageState()
    local stageIndex = 1
    if stageState <= _G.SociatyBattleLeagueStageState.BattleElimination then
        self.go_table.slider_course.value = 0
    elseif stageState >= _G.SociatyBattleLeagueStageState.battleChampion then
        stageIndex = 4
        self.go_table.slider_course.value = 1
    elseif stageState < _G.SociatyBattleLeagueStageState.BattleFail2To1 then
        self.go_table.slider_course.value = self.sliderNum[1]
    elseif stageState < _G.SociatyBattleLeagueStageState.BattleThirdplace then
        stageIndex = 2
        self.go_table.slider_course.value = self.sliderNum[2]
    elseif stageState < _G.SociatyBattleLeagueStageState.battleChampion then
        stageIndex = 3
        self.go_table.slider_course.value = self.sliderNum[3]
    end
    local time, date
    local stage = {
        _G.SociatyBattleLeagueStageState.BattleElimination,
        _G.SociatyBattleLeagueStageState.BattleFail2To1,
        _G.SociatyBattleLeagueStageState.BattleThirdplace,
        _G.SociatyBattleLeagueStageState.battleChampion
    }

    self.courseItem = {}
    for i = 1, 4 do
        local tb = _G.GetAutoGoTable(self.go_table["obj_course" .. i], _G.handlerbind(self, self.OnClickCourse, i))
        time = SociatyBattleLeagueModel:GetInstance():GetDateBeginByStageState(stage[i])
        date = _G.TimeUtil.GetDateTime(time)
        tb.aortext_date.text = _G.GetLangPackValue(90032100011, date.month, date.day)
        self.courseItem[i] = tb
    end

    self.courseInfo = SociatyBattleLeagueModel:GetInstance():GetCourseInfo()
    self.courseFailInfo = SociatyBattleLeagueModel:GetInstance():GetCourseInfo(2)
    self:ShowCourse(stageIndex)
end

---初始化八强赛
function SociatyBattleLeagueCourseView:InitEight()
    local tb = self.knockoutTable[1]
    for i = 1, 8 do
        self:ShowNode(tb["obj_node8" .. i], i, true)
    end
    for i = 1, 4 do
        self:ShowNode(tb["obj_node4" .. i], i + 8)
    end
    for i = 1, 2 do
        self:ShowNodeL(tb["obj_nodeL8" .. (i * 2 - 1)], i, true)
        self:ShowNodeL(tb["obj_nodeL8" .. i * 2], i, false)
    end
    for i = 1, 2 do
        self:ShowNode(tb["obj_nodeL" .. i], i, false, false, nil, false)
    end
    self:ShowNodeL(tb["obj_nodeL42"], 3, false)
    self:ShowNodeL(tb["obj_nodeL44"], 4, false)
end

---初始化四强赛
function SociatyBattleLeagueCourseView:InitFour()
    local tb = self.knockoutTable[2]
    for i = 1, 4 do
        self:ShowNode(tb["obj_node4" .. i], i + 8)
    end
    for i = 1, 2 do
        self:ShowNode(tb["obj_node2" .. i], i + 12)
    end
    for i = 3, 5 do
        self:ShowNode(tb["obj_nodeL" .. i], i, false, false, nil, false)
    end
    self:ShowNodeL(tb["obj_nodeL12"], 6, false)
end

---初始化季军赛
function SociatyBattleLeagueCourseView:InitThird()
    local tb = self.knockoutTable[3]
    self:ShowNode(tb["obj_nodeL5"], 5, true, false, false, false, 6, false)
    self:ShowNode(tb["obj_nodeL12"], 15, true, false, true, nil, 6, false)
    self:ShowNode(tb.obj_node10, 6, false, true, false, true)
    self:RefreshThirdTips(tb)
end

---刷新季军赛提示
function SociatyBattleLeagueCourseView:RefreshThirdTips(tb)
    tb.aortext_thirdtips.text = _G.GetLangPackValue(90032100080)

    local info = self.courseFailInfo[6]
    if info and info.win_uid > 0 then
        local cState = SociatyBattleLeagueModel:GetInstance():GetCoursePosState(6, true)
        local data = cState == CPState.LeftWin and info.guild_a or info.guild_b
        local loser = cState == CPState.LeftWin and info.guild_b or info.guild_a
        tb.aortext_thirdtips.text = _G.GetLangPackValue(90032100081, data.guild_name, loser.guild_name)
    end
end

---初始化冠军赛
function SociatyBattleLeagueCourseView:InitChampion()
    local tb = self.knockoutTable[4]
    self:ShowNode(tb.obj_node12, 15, true, false, false, nil, 16, 1)
    self:ShowNode(tb["obj_nodeL6"], 6, false, false, nil, false, 16, 1)
    self:ShowNode(tb.obj_node10, 16, false, true)
end

function SociatyBattleLeagueCourseView:InitAll()
    ---胜利组
    for i = 1, 8 do
        self:ShowNode(self.go_table["obj_node8" .. i], i, true)
    end
    for i = 1, 4 do
        self:ShowNode(self.go_table["obj_node4" .. i], i + 8)
    end
    for i = 1, 2 do
        self:ShowNode(self.go_table["obj_node2" .. i], i + 12)
    end
    -- for i = 1, 2 do
    --     self:ShowNode(self.go_table["obj_node2" .. i + 2], i + 12, true, false, true)
    -- end
    self:ShowNode(self.go_table.obj_node10, 16, false, true)
    self:ShowNode(self.go_table.obj_node12, 15)
    ---失败组
    for i = 1, 6 do
        self:ShowNode(self.go_table["obj_nodeL" .. i], i, false, false, nil, false)
    end
    for i = 1, 2 do
        self:ShowNodeL(self.go_table["obj_nodeL8" .. (i * 2 - 1)], i, true)
        self:ShowNodeL(self.go_table["obj_nodeL8" .. i * 2], i, false)
    end
    self:ShowNodeL(self.go_table["obj_nodeL42"], 3, false)
    self:ShowNodeL(self.go_table["obj_nodeL44"], 4, false)
    self:ShowNodeL(self.go_table["obj_nodeL12"], 6, false)
end

---失败组
function SociatyBattleLeagueCourseView:ShowNodeL(obj, index, isLeft)
    local tb = _G.GetAutoGoTable(obj)
    local info = self.courseFailInfo[index]
    tb.obj_inBattle:SetActiveE(0)
    tb.obj_sociaty:SetActiveE(1)
    tb.aorrawimage_icon:SetActiveE(info and 1 or 0)
    tb.aorimage_pending:SetActiveE(info and 0 or 1)
    if info then
        local data = isLeft and info.guild_a or info.guild_b
        tb.aortext_name.text = data.guild_name
        tb.aorrawimage_icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.banner].portrait)
    else
        tb.aortext_name.text = _G.GetLangPackValue(90000010159)
    end
end

function SociatyBattleLeagueCourseView:ShowNode(obj, index, isLeaf, isRoot, isLoser, winTag, wlIdx, wlTag)
    ---@type SociatyBattleLeagueCourseView._obj_node21_GoTable
    local tb = _G.GetAutoGoTable(obj)
    if winTag == nil then
        winTag = 1
    end
    local cState = SociatyBattleLeagueModel:GetInstance():GetCoursePosState(index, winTag)
    local isEnd = cState == CPState.LeftWin or cState == CPState.RightWin
    if index == 16 or (index == 6 and isRoot) then
        tb.obj_inBattle:SetActiveE(0)
        tb.obj_sociaty:SetActiveE(0)
        tb.aorrawimage_icon:SetActiveE(0)
        tb.aorimage_pending:SetActiveE(1)
    else
        tb.obj_inBattle:SetActiveE((cState == CPState.InBattle and not isLeaf) and 1 or 0)
        tb.obj_sociaty:SetActiveE(((cState == CPState.InBattle and not isLeaf) or (isRoot and not isEnd)) and 0 or 1)
        tb.aorrawimage_icon:SetActiveE(cState == CPState.BePending and 0 or 1)
        tb.aorimage_pending:SetActiveE(cState == CPState.BePending and 1 or 0)
    end
    tb.aortext_name.text = (cState == CPState.BePending and not isRoot) and _G.GetLangPackValue(90000010159) or ""
    if tb.obj_lightLine then
        tb.obj_lightLine:SetActiveE(isEnd and 1 or 0)
        tb.obj_lightLine:SetLocalScale(cState == CPState.RightWin and -1 or 1, winTag and 1 or -1, 1)
    end
    if isEnd then
        local info
        if index < 9 and winTag == 1 then --前8场乱序，得从父节点找
            info = self:GetLeafNodeInfo(index)
            if info == nil then           --四强还没匹配，无信息
                tb.aorimage_pending:SetActiveE(1)
                tb.aorrawimage_icon:SetActiveE(0)
                tb.aortext_name.text = _G.GetLangPackValue(90000010159)
                return
            end
            cState = SociatyBattleLeagueModel:GetInstance():GetCoursePosState(info.index, winTag)
        else
            if winTag == 1 then
                info = self.courseInfo[index]
            else
                info = self.courseFailInfo[index]
            end
        end
        if info then
            local data
            if isLoser then
                data = cState == CPState.LeftWin and info.guild_b or info.guild_a
            else
                data = cState == CPState.LeftWin and info.guild_a or info.guild_b
            end
            tb.aortext_name.text = data.guild_name
            tb.aorrawimage_icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.banner].portrait)

            if tb.obj_winLine then
                local nextInfo
                if wlTag == 1 then
                    nextInfo = self.courseInfo[wlIdx]
                else
                    nextInfo = self.courseFailInfo[wlIdx]
                end
                tb.obj_winLine:SetActiveE((nextInfo and nextInfo.win_uid == info.win_uid) and 1 or 0)
            end
        end
    else
        if index < 9 and winTag == 1 then --小组赛正在进行，无信息
            tb.aorimage_pending:SetActiveE(1)
            tb.aorrawimage_icon:SetActiveE(0)
            tb.aortext_name.text = _G.GetLangPackValue(90000010159)
        end
    end
end

function SociatyBattleLeagueCourseView:GetLeafNodeInfo(index, winTag)
    local pInfo = self.courseInfo[8 + (index + 1) // 2]
    local info
    if pInfo then
        for i = 1, 8 do
            info = self.courseInfo[i]
            if index % 2 == 1 and info.win_uid == pInfo.guild_a.guild_uid then
                return info
            elseif index % 2 == 0 and info.win_uid == pInfo.guild_b.guild_uid then
                return info
            end
        end
    end
end

function SociatyBattleLeagueCourseView:OnStartClose()
    local somain = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SociatyBattleLeagueMainView.Name)
    if nil == somain then
        if SociatyBattleLeagueModel:GetInstance().IsJoin then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleLeagueMainView.Name)
        end
    end
end

---显示标签
function SociatyBattleLeagueCourseView:ShowToggles(obj, isOn)
    local item = _G.GetAutoGoTable(obj)
    item.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    item.aortext_label.color = _G.ColorTools.FormatColorByString(isOn and "400E0E" or "c6b69d")
end

function SociatyBattleLeagueCourseView:ShowCourse(index)
    for i = 1, 4 do
        self.knockoutTable[i].gameObject:SetActiveE(index == i and 1 or 0)
        self.courseItem[i].aorimage_bg.SpriteName = index == i and "ui_kfas_sc_tts_di1" or "ui_kfas_sc_tts_di2"
        self.courseItem[i].aorimage_select:SetActiveE(index == i and 1 or 0)
    end
    if index == 1 and not self.eightInit then
        self:InitEight()
        self.eightInit = true
    elseif index == 2 and not self.fourInit then
        self:InitFour()
        self.fourInit = true
    elseif index == 3 and not self.thirdInit then
        self:InitThird()
        self.thirdInit = true
    elseif index == 4 and not self.championInit then
        self:InitChampion()
        self.championInit = true
    end
end

function SociatyBattleLeagueCourseView:OnClickCourse(go, isOn, index)
    self:ShowCourse(index)
end

---按钮点击事件在这里派发
function SociatyBattleLeagueCourseView:OnClickBtn(go, isOn)
    if go == self.go_table.toggle_group then
        self:OnGroup(isOn)
    elseif go == self.go_table.toggle_knockout then
        self:OnKnockout(isOn)
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    end
end

return SociatyBattleLeagueCourseView
