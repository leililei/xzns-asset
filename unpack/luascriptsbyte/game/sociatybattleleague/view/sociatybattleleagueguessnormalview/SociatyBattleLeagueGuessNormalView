local SociatyBattleLeagueModel = require("SociatyBattleLeagueModel")

---@class SociatyBattleLeagueGuessNormalView : UIBaseView	中文描述
---@field public go_table SociatyBattleLeagueGuessNormalView_GoTable GoTable
local SociatyBattleLeagueGuessNormalView = _G.BaseClass("SociatyBattleLeagueGuessNormalView", _G.UIBaseView)

function SociatyBattleLeagueGuessNormalView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyBattleLeagueGuessNormalView:OnCreate()
    self.index = 1
    local res = _G.ConfigManager.ui_cfg.SociatyBattleLeagueGuessNormalView.resources
    self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, res))
    self.go_table.aorbtn_award:SetActiveE(SociatyBattleLeagueModel:GetInstance():CheckJoinInHistory() and 1 or 0)
    self.cPanel =
        self:AddComponent(
        self.go_table.obj_course,
        require("SociatyBattleLeagueCoursePanel").New(self.go_table.obj_course, true, 1)
    )
    self.cPanel:Show(nil, nil, self.index)
    self:UpdateChatState()
    self:AddListener(_G.eSociatyBattleLeague.SociatyBattleBarrageStateChangeLeague, self.UpdateChatState)
    --_G.UIUtils.LoadEffectByCfg(
    --    _G.ConfigManager.ui_effect_cfg.ef_SociatyBattleLeagueGuessNormalView_bg_loop,
    --    self.go_table.obj_eff,
    --    function(trans)
    --        if self:IsNil() then
    --            _G.DestroyObject(trans)
    --            return
    --        end
    --    end
    --)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleLeagueBarrageView.Name)
    local activity = require "ActivitySynManager":GetInstance():GetActivityWithTypeId(10011)
    self.go_table.aorbtn_gift:SetActiveE(activity ~= nil and 1 or 0)
    local stageState = SociatyBattleLeagueModel:GetInstance():GetStageState()
    if stageState == _G.SociatyBattleLeagueStageState.BattleGroup then
        self.go_table.toggle_fail:SetActiveE(0)
        self.go_table.toggle_win:SetActiveE(0)
    end
    if stageState == _G.SociatyBattleLeagueStageState.BattleElimination then
        self.go_table.toggle_fail:SetActiveE(0)
        self.go_table.toggle_win:SetActiveE(1)
    end
end

function SociatyBattleLeagueGuessNormalView:ChangeChatState()
    local wind = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SociatyBattleLeagueBarrageView.Name)
    if wind then
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.SociatyBattleLeagueBarrageView.Name)
    end
    self.chatState = 1 - self.chatState
    _G.PlayerPrefsManager.SetInt("SociatyBattleLeagueBarrageShow", self.chatState)
    _G.Events:GetInstance():Broadcast(
        _G.eSociatyBattleLeague.SociatyBattleBarrageStateChangeLeague,
        self.chatState == 1
    )
end

function SociatyBattleLeagueGuessNormalView:UpdateChatState()
    self.chatState = _G.PlayerPrefsManager.GetInt("SociatyBattleLeagueBarrageShow", 1)
    self.go_table.aorbtn_chatOpen:SetActiveE(self.chatState == 1 and 1 or 0)
    self.go_table.aorbtn_chatClose:SetActiveE(self.chatState == 1 and 0 or 1)
end

function SociatyBattleLeagueGuessNormalView:OnDestroy()
    self:RemoveListener(_G.eSociatyBattleLeague.SociatyBattleBarrageStateChangeLeague, self.UpdateChatState)
    require "SociatyBattleLeagueManager":GetInstance():TryToCloseBarrageView()
end

function SociatyBattleLeagueGuessNormalView:OnWin(isOn)
    self:ShowToggles(self.go_table.toggle_win, isOn)
    if not isOn then
        return
    end
    self.index = 1
    self:SetView()
end

function SociatyBattleLeagueGuessNormalView:OnFail(isOn)
    self:ShowToggles(self.go_table.toggle_fail, isOn)
    if not isOn then
        return
    end
    self.index = 2
    self:SetView()
end

function SociatyBattleLeagueGuessNormalView:SetView()
    self.cPanel:Show(nil, nil, self.index)
end

---显示标签
function SociatyBattleLeagueGuessNormalView:ShowToggles(obj, isOn)
    local item = _G.GetAutoGoTable(obj)
    item.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    -- obj:SetActiveE(isOn and 1 or 0)
end

---按钮点击事件在这里派发
function SociatyBattleLeagueGuessNormalView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        require("SociatyBattleLeagueModel"):GetInstance():UpdateGuessIcon()
        self:Close()
    elseif go == self.go_table.aorbtn_course then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleLeagueCourseView.Name)
    elseif go == self.go_table.aorbtn_rank then
        -- _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleLeagueRankView.Name)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleLeagueTopRankView.Name)
    elseif go == self.go_table.aorbtn_award then
        if not SociatyBattleLeagueModel:GetInstance():CheckJoinInHistory() then
            return
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleLeaguePassView.Name)
    elseif go == self.go_table.aorbtn_chat then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleLeagueChatView.Name)
    elseif go == self.go_table.aorbtn_chatOpen then
        self:ChangeChatState()
    elseif go == self.go_table.aorbtn_chatClose then
        self:ChangeChatState()
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 147)
    elseif go == self.go_table.toggle_win then
        self:OnWin(isOn)
    elseif go == self.go_table.toggle_fail then
        self:OnFail(isOn)
    elseif go == self.go_table.aorbtn_gift then
        --礼包
        SociatyBattleLeagueModel:GetInstance():OpenGiftView()
    end
end

return SociatyBattleLeagueGuessNormalView
