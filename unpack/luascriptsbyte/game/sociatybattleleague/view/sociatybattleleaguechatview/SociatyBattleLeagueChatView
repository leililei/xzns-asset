local SociatyBattleLeagueModel = require("SociatyBattleLeagueModel")

---@class SociatyBattleLeagueChatView : UIBaseView	公会战聊天窗口
---@field private go_table SociatyBattleLeagueChatView_GoTable  go_table
---@field private chatView ChatView     聊天窗口
---@field logs guild_fight.i_log[]
local SociatyBattleLeagueChatView = _G.BaseClass("SociatyBattleLeagueChatView", _G.UIBaseView)

function SociatyBattleLeagueChatView:Awake()
    ---工会站集火公告 每个字时间(用于x移动)
    self.topinfoInterval = 0.01
    self:AddListener(_G.eSociatyEvent.BeKicked, self.OnBeKicked)
    self:AddListener(_G.eSociatyBattleLeague.SociatyBattleStateLeague, self.ChangeState)

    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpened, self)
end

function SociatyBattleLeagueChatView:OnCreate(isJoin)
    local barrageData = SociatyBattleLeagueModel:GetInstance():CreateBarrageData()
    local cType = isJoin and _G.ChatType.unionbattleleague or _G.ChatType.leagueevents
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ChatView.Name,
        cType,
        barrageData,
        _G.handler(self, self.OnChatCall)
    )
end

function SociatyBattleLeagueChatView:OnChatCall(params, callback)
    SociatyBattleLeagueModel:GetInstance():OnBarrageSendCall(params, callback)
end

function SociatyBattleLeagueChatView:Dispose()
    self:RemoveListener(_G.eSociatyEvent.BeKicked, self.OnBeKicked)
    self:RemoveListener(_G.eSociatyBattleLeague.SociatyBattleStateLeague, self.ChangeState)
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpened, self)
end

---监听打开的窗口名称
---@param name string
function SociatyBattleLeagueChatView:OnViewOpened(name)
    if name ~= _G.ConfigManager.ui_cfg.ChatView.Name then
        return
    end
    ---@type ChatView
    self.chatView = _G.UIManager:GetInstance():GetWindowCtrl(name)
    if not self.chatView or _G.IsNil(self.gameObject) then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpened, self)

    self.chatView.transform:SetParentE(self.gameObject)

    self.aorGraphic = self.chatView.gameObject:GetComponentE(_G.typeof(_G.CS.AorGraphicRaycaster))
    self.aorGraphic.TargetCamera = _G.UIManager:GetInstance().UICamera
    --self.chatView:SetUnionLeagueMode()
    self.chatView:SetCloseCallback(_G.handler(self, self.Close))
end
---关闭聊天窗口
function SociatyBattleLeagueChatView:CloseChatView()
    if not self.chatView then
        return
    end
    self.chatView:Close()
end

---被踢出
function SociatyBattleLeagueChatView:OnBeKicked(uid)
    if uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
        self:CloseChatView()
        self:Close()
    end
end

function SociatyBattleLeagueChatView:ChangeState()
    if require "SociatyBattleLeagueModel":GetInstance():GetState() ~= _G.SociatyBattleLeagueState.Battle then
        self:CloseChatView()
        self:Close()
    end
end

return SociatyBattleLeagueChatView
