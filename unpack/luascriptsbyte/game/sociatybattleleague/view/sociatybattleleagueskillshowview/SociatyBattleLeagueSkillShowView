---@class SociatyBattleLeagueSkillShowView : UIBaseView	中文描述
---@field public go_table SociatyBattleLeagueSkillShowView_GoTable GoTable
local SociatyBattleLeagueSkillShowView = _G.BaseClass("SociatyBattleLeagueSkillShowView", _G.UIBaseView)

function SociatyBattleLeagueSkillShowView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyBattleLeagueSkillShowView:OnCreate(effectRed, effectRedType)
    self.effectRed = effectRed
    if self.effectRed == nil then
        self.effectRed = true
    end
    self.effectRedType = effectRedType
    if self.effectRedType == nil then
        self.effectRedType = 1
    end
    self:Show()
end

function SociatyBattleLeagueSkillShowView:Show()
    local cfg = require "SociatyBattleLeagueModel":GetInstance():GetSeasonCfg()
    --角色spine
    if cfg.spine[1] then
        self.go_table.aorrawimage_bg:LoadImage(cfg.spine[1][1], function(trans)
            if self:IsNil() then
                return
            end
            self.go_table.aorrawimage_bg:SetNativeSize()
        end)
    end
    if cfg.spine[2] and cfg.spine[2][1] and not _G.string.IsNullOrEmpty(cfg.spine[2][1]) then
        _G.UIUtils.LoadEffectByPath(
            cfg.spine[2][1],
            self.go_table.obj_root,
            function(transform)
                if _G.IsNil(self.go_table.obj_root) then
                    transform:DestroyObject()
                    return
                end
                -- transform:SetAsFirstSiblingE()
                -- --隐藏默认节点
                -- self.go_table.obj_defaultEffect:SetActiveE(0)
            end,
            nil,
            nil,
            {cfg.spine[2][2],cfg.spine[2][3],cfg.spine[2][4]},
            cfg.spine[2][5]
        )
    end
    --标题美术字
    if cfg.spine[3] then
        self.go_table.aorrawimage_title:LoadImage(cfg.spine[3][1])
    end
    --技能图标
    if cfg.spine[4] then
        self.go_table.aorrawimage_skill:LoadImage(cfg.spine[4][1])
    end
    --1级技能名称
    if cfg.skilltxt[1] then
        self.go_table.aortext_skillName.text = _G.GetLangPackValue(cfg.skilltxt[1])
    end
    --2级技能名称
    if cfg.skilltxt[2] then
        self.go_table.aortext_skillDes.text = _G.GetLangPackValue(cfg.skilltxt[2])
    end
    --技能描述
    if cfg.skilltxt[3] then
        self.go_table.aortext_skillDes2.text = _G.GetLangPackValue(cfg.skilltxt[3])
    end

    _G.PlayerPrefsManager.SetInt("SociatyBattleLeagueSkillShowViewPop", cfg.id)
    if self.effectRed then
        local SeasonId = require "SociatyBattleLeagueModel":GetInstance():GetSeasonId()
        _G.PlayerPrefsManager.SetInt("SociatyBattleLeagueSkillShowViewRed"..self.effectRedType, SeasonId)
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SociatyBattleLeagueSkillEffect.id, self.effectRedType)
    end
end

---界面的销毁函数
function SociatyBattleLeagueSkillShowView:OnDestroy()
end

---按钮点击事件在这里派发
function SociatyBattleLeagueSkillShowView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close1 then
        self:Close()
    end
end

return SociatyBattleLeagueSkillShowView