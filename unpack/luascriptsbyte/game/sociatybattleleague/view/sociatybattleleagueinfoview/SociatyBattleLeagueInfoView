local SociatyBattleLeagueModel = require "SociatyBattleLeagueModel"
---@class SociatyBattleLeagueInfoView : UIBaseView	中文描述
---@field public go_table SociatyBattleLeagueInfoView_GoTable GoTable
local SociatyBattleLeagueInfoView = _G.BaseClass("SociatyBattleLeagueInfoView", _G.UIBaseView)

function SociatyBattleLeagueInfoView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyBattleLeagueInfoView:OnCreate()
    self:InitView()
end

function SociatyBattleLeagueInfoView:InitView()
    local datas = _G.ConfigManager.discrete_cfg[115912][1]
    for i,v in ipairs(datas) do
        local obj = _G.InstantiateObject(self.go_table.aortext_des, self.go_table.obj_root)
        obj:SetActiveE(1)
        local go_table = _G.GetAutoGoTable(obj)
        local str = _G.GetLangPackValue(v)
        if i == 1 then
            self.Session = SociatyBattleLeagueModel:GetInstance().CurSession
            if self.Session == nil then
                self.Session = 0
            end
            str = _G.GetLangPackValue(v, _G.GameUtil.NumberToWordByLanguage(self.Session + 1))
        end
        go_table.aortext_des.text = str
    end
end

---界面的销毁函数
function SociatyBattleLeagueInfoView:OnDestroy()
end

---按钮点击事件在这里派发
function SociatyBattleLeagueInfoView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

return SociatyBattleLeagueInfoView