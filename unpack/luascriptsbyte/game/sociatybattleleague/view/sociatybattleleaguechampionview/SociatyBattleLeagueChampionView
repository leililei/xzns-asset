local SociatyModel = require("SociatyModel")
local SociatyBattleLeagueNet = require "SociatyBattleLeagueNet"
local SociatyBattleLeagueModel = require "SociatyBattleLeagueModel"

---@class SociatyBattleLeagueChampionView : UIBaseView	中文描述
---@field public go_table SociatyBattleLeagueChampionView_GoTable GoTable
local SociatyBattleLeagueChampionView = _G.BaseClass("SociatyBattleLeagueChampionView", _G.UIBaseView)

local officialBg = {
    "ui_gh_mrt_hzq",
    "ui_gh_mrt_fhzq",
    "ui_gh_mrt_zlb"
}

local officialColor = {
    _G.ColorTools.FormatColorByString("FFE486"),
    _G.ColorTools.FormatColorByString("F4E1FF"),
    _G.ColorTools.FormatColorByString("EBF7FF")
}

local officialOutlineColor = {
    _G.ColorTools.FormatColorByString("640707"),
    _G.ColorTools.FormatColorByString("3A056B"),
    _G.ColorTools.FormatColorByString("070E64")
}

function SociatyBattleLeagueChampionView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyBattleLeagueChampionView:OnCreate()
    self.Time = SociatyBattleLeagueModel:GetInstance().EggEndTime and SociatyBattleLeagueModel:GetInstance().EggEndTime or
        0

    if self.Time > 0 then
        self.Timer = _G.TimerManager:GetInstance():GetTimer(1, self.OnTimeRemaining, self, false)
        self.Timer:Start()
    end
    self:OnTimeRemaining(0)

    self:InitEffct()
    self:InitView()
    self:UpdateIcon()
end

function SociatyBattleLeagueChampionView:UpdateIcon()
    local icon
    if not SociatyBattleLeagueModel:GetInstance().EggAwardFlag then
        icon = "ImagesH5/nAFK/ui_box1"
    else
        icon = "ImagesH5/nAFK/ui_box3"
    end
    self.go_table.aorrawimage_box:LoadImage(icon)
end

function SociatyBattleLeagueChampionView:OnTimeRemaining(elapsed)
    self.Time = self.Time - elapsed
    if self.Time > 0 then
        local t = _G.TimeUtil.TranslateSecond(self.Time)
        self.go_table.aortext_time.text = _G.GetLangPackValue(90033500133, t.day, t.hour, t.min)
    else
        self:Close()
    end
end

function SociatyBattleLeagueChampionView:InitEffct()
    local tbOur = _G.GetAutoGoTable(self.go_table.obj_fameHallOur)

    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_SociatyMobaGuessView_our,
        tbOur.obj_ourEff,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
        end
    )
end

function SociatyBattleLeagueChampionView:InitView()
    SociatyBattleLeagueNet:GetInstance():GetLastRank(
        { session = SociatyBattleLeagueModel:GetInstance().EggSession or 1 },
        function(msg)
            if msg.ack == 1 then
                local sociatyUid = msg.ranks[1].guild_uid
                SociatyModel:GetInstance():GetOtherStatueInfo(sociatyUid, _G.handlerbind(self, self.InitFameHall, true))
            end
        end
    )
end

---名人堂
---@param msg guild.s2c_other_guild_pos_info
function SociatyBattleLeagueChampionView:InitFameHall(msg)
    if msg.ack ~= 1 then
        return
    end
    local allRoles = msg.roles or {}
    local roles = { [1] = {}, [2] = {}, [3] = {} }
    for _, v in pairs(allRoles) do
        _G.table.insert(roles[v.pos], v)
    end
    ---@type SociatyBattleLeagueChampionView._obj_fameHallOur_GoTable|SociatyBattleLeagueChampionView._obj_fameHallEnemy_GoTable
    local tb = _G.GetAutoGoTable(self.go_table.obj_fameHallOur)
    tb.aortext_sociatyName.text = msg.name
    tb.aorrawimage_icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[msg.banner].portrait)
    self:CreateRole(tb.obj_player1, roles[1][1])
    self:CreateRole(tb.obj_player2, roles[2][1])
    self:CreateRole(tb.obj_player3, roles[2][2])
    self:CreateRole(tb.obj_player4, roles[3][1])
    self:CreateRole(tb.obj_player5, roles[3][2])

    self.go_table.aortext_tips.text = _G.GetLangPackValue(90033406001, msg.name)
end

function SociatyBattleLeagueChampionView:CreateRole(obj, role)
    if role then
        ---@type _obj_fameHallOur._obj_player1_GoTable
        local playerTb = _G.GetAutoGoTable(obj)
        local pos = role.pos
        playerTb.aortext_name.text = role.role.name
        playerTb.aortext_power.text = _G.GameUtil.NumberToUnitWord(role.role.power)
        playerTb.aorimage_official.SpriteName = officialBg[pos]
        playerTb.aortext_offName.text = _G.GetLangPackValue(_G.ConfigManager.guild_position_cfg[pos].name)
        playerTb.aortext_offName.color = officialColor[pos]
        playerTb.aortext_offName:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = officialOutlineColor[1]
        local cfg = require("CardInfoManager").GetCardSkin_ShowCfg(nil, role.role.city_style_id)
        local path = cfg.ModelPathHi
        local scale = cfg.size2
        if _G.UIUtils.IsUseBattleSpine(_G.UseBattleSpine.RankView) then
            path = _G.UIUtils.GetBattleSpine(cfg)
            scale = cfg.size2
        end
        _G.PoolsManager:GetInstance():Spawn(
            path,
            _G.ePoolType.Temporary,
            playerTb.obj_spine,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                end
                trans:SetLocalScaleXYZ(scale)
                if not table.isEmptyOrNil(role.artifact_skin) then
                    _G.UIUtils.LoadArtifacteffect(trans,nil,role.artifact_skin[1],role.artifact_skin[2])
                end
            end
        )
    else
        obj:SetActiveE(0)
    end
end

---按钮点击事件在这里派发
function SociatyBattleLeagueChampionView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_AwardBox then
        local con = _G.ConfigManager.discrete_cfg[125303]
        if _G.GlobalConditionManager.CheckConditionArrays(con) then
            ---点击领取宝箱
            if not SociatyBattleLeagueModel:GetInstance().EggAwardFlag then
                SociatyBattleLeagueModel:GetInstance():GetEggAward(function()
                    self:UpdateIcon()
                end)
            end
        else
            local _, tip1 = _G.GlobalConditionManager.GetTipsText(table.unpack(condition[1]))
            local _, tip2 = _G.GlobalConditionManager.GetTipsText(table.unpack(condition[2]))

            _G.PopWindowManager:GetInstance():ShowAllTips(250159, _G.GetLangPackValue(90030700022)..":".. tip1..",".. tip2)
        end
    end
end

function SociatyBattleLeagueChampionView:OnStartClose()
    if self.Timer then
        self.Timer:Stop()
        self.Timer = nil
    end
end

function SociatyBattleLeagueChampionView:Dispose()
end

return SociatyBattleLeagueChampionView
