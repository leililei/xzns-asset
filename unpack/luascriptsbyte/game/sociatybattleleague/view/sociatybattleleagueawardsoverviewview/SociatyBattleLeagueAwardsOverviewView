---@class SociatyBattleLeagueAwardsOverviewView : UIBaseView    中文描述
---@field public go_table SociatyBattleLeagueAwardsOverviewView_GoTable GoTable
local SociatyBattleLeagueAwardsOverviewView = _G.BaseClass("SociatyBattleLeagueAwardsOverviewView", _G.UIBaseView)

local BaseAwardItem = require "BaseAwardNewItem"

function SociatyBattleLeagueAwardsOverviewView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyBattleLeagueAwardsOverviewView:OnCreate()
    self.curRank = require "SociatyBattleModel":GetNormalCfg()
    if not self.curRank then
        self.curRank = 1
    end
    self.cfg = _G.ConfigManager.guild_battle_normal_cfg
    self.count = #self.cfg
    self:InitRank()
    --local len = #_G.ConfigManager.guild_league_normal_cfg
    --self.go_table.scrollloopvectical_mainList:InitItemData(len, _G.handler(self, self.RefreshTask))
end

---初始化段位列表
function SociatyBattleLeagueAwardsOverviewView:InitRank()
    if not self.curRank or self.curRank < 1 then
        self.curRank = 1
    elseif self.curRank > self.count then
        self.curRank = self.count
    end
    self.go_table.aorbtn_Left:SetActiveE(0)
    self.go_table.obj_LeftRank:SetActiveE(0)
    self.go_table.aorbtn_Right:SetActiveE(0)
    self.go_table.obj_RightRank:SetActiveE(0)
    if self.curRank > 1 then
        self:UpdateRank(_G.GetAutoGoTable(self.go_table.obj_LeftRank), self.curRank - 1)
        self.go_table.aorbtn_Left:SetActiveE(1)
        self.go_table.obj_LeftRank:SetActiveE(1)
    end
    self:UpdateRank(_G.GetAutoGoTable(self.go_table.obj_CurRank), self.curRank)
    self:RefreshTask(self.curRank)
    if self.curRank < self.count then
        self:UpdateRank(_G.GetAutoGoTable(self.go_table.obj_RightRank), self.curRank + 1)
        self.go_table.aorbtn_Right:SetActiveE(1)
        self.go_table.obj_RightRank:SetActiveE(1)
    end
end

---刷新单个段位
function SociatyBattleLeagueAwardsOverviewView:UpdateRank(tb, index)
    local data = _G.ConfigManager.guild_battle_normal_cfg[index]
    tb.aorrawimage_Icon:LoadImage(data.icon)
    tb.aortext_Name.text = _G.GetLangPackValue(data.art)
    tb.aortext_Score.text = _G.GetLangPackValue(90021800509, data.min, data.max)
end

---刷新任务
function SociatyBattleLeagueAwardsOverviewView:RefreshTask(index, obj)
    ---@type guild_battle_normal_cfg
    local info = _G.ConfigManager.guild_battle_normal_cfg[index]

    self.go_table.scrollloophorizontal_awardListWin:InitItemData(#info.win_rewards, _G.handlerbind(self, self.RefreshAward, info))
    self.go_table.scrollloophorizontal_awardListLose:InitItemData(#info.lose_rewards, _G.handlerbind(self, self.RefreshAward1, info))
end

function SociatyBattleLeagueAwardsOverviewView:OnClickItemBtn(go, isOn)
end

function SociatyBattleLeagueAwardsOverviewView:RefreshAward(index, obj, info)
    local item = BaseAwardItem.New(obj, nil, 66)
    item:ShowWithID(info.win_rewards[index + 1])
end

function SociatyBattleLeagueAwardsOverviewView:RefreshAward1(index, obj, info)
    local item = BaseAwardItem.New(obj, nil, 66)
    item:ShowWithID(info.lose_rewards[index + 1])
end

function SociatyBattleLeagueAwardsOverviewView:OnStartClose()
end

---按钮点击事件在这里派发
function SociatyBattleLeagueAwardsOverviewView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_Left then
        self.curRank = self.curRank - 1
        self:InitRank()
    elseif go == self.go_table.aorbtn_Right then
        self.curRank = self.curRank + 1
        self:InitRank()
    end
end

return SociatyBattleLeagueAwardsOverviewView
