        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    -- elseif go == self.go_table.toggle_battle then
    --     self:OnBattle(isOn)
    -- elseif go == self.go_table.toggle_gx then
    --     self:OnGx(isOn)
