function SociatyBattleLeaguePassView:OnBattle(isOn)
    --self:ShowToggles(self.go_table.toggle_battle, isOn)
    self.go_table.obj_battle:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    if not self.battlePanel then
        self.battlePanel = self:AddComponent(self.go_table.obj_battle, require "SociatyBattleLeaguePass_BattlePanel".New())
    end
    self.battlePanel:ShowView()
end

