        [4] = _G.GetLangPackValue(90032100046),
        [5] = _G.GetLangPackValue(90032100047),
        [6] = _G.GetLangPackValue(90032100048),
        [7] = _G.GetLangPackValue(90032100022),
        [8] = _G.GetLangPackValue(90032100023),
        [9] = _G.GetLangPackValue(90032100024)
