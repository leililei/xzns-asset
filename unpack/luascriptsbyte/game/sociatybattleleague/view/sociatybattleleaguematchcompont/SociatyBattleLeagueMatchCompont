function SociatyBattleLeagueMatchCompont:SetApplyBtnGray(isGray)
    self.go_table.aorbtn_signUp:SetGray(isGray)
    self.go_table.aorbtn_signUp.enabled = not isGray
end

function SociatyBattleLeagueMatchCompont:SetJianProgress()
    local SociatyBattleLeagueModel = require "SociatyBattleLeagueModel":GetInstance()
    local time = SociatyBattleLeagueModel:GetNextSettlementTime()
    local day = math.min(_G.TimeUtil.GetIntervalDay(_G.TimeUtil.GetServerUnixTime(), time) + 1, 3)
    local curDay = SociatyBattleLeagueModel:GetCurDay()
    if curDay ~= nil and curDay > 0 then
        self.go_table.aorimage_progress:SetLocalScale(progress[day][curDay], 1, 1)
    end
end

function SociatyBattleLeagueMatchCompont:ShowAward()
    local normalCfg = require "SociatyBattleLeagueModel":GetInstance():GetNormalCfg()
    local winRewards = {}
    for i = 1, #normalCfg.win_rewards do
        local award = {normalCfg.win_rewards[i][1], normalCfg.win_rewards[i][2]}
        table.insert(winRewards, award)
    end
    local node = self.go_table.trans_winContent
    if node:GetChildCountE() > 0 then
        for i = 1, node:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(node:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    for i = 1, #winRewards do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            winRewards[i],
            node,
            function(item)
                item.gameObject:SetLocalScale(0.8, 0.8, 0.8)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end,
            function(go, isOn)
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, winRewards[i][1])
            end
        )
    end

    local loseRewards = {}
    for i = 1, #normalCfg.lose_rewards do
        local award = {normalCfg.lose_rewards[i][1], normalCfg.lose_rewards[i][2]}
        table.insert(loseRewards, award)
    end
    node = self.go_table.trans_loseContent
    if node:GetChildCountE() > 0 then
        for i = 1, node:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(node:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    for i = 1, #loseRewards do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            loseRewards[i],
            node,
            function(item)
                item.gameObject:SetLocalScale(0.8, 0.8, 0.8)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end,
            function(go, isOn)
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, loseRewards[i][1])
            end
        )
    end
end

function SociatyBattleLeagueMatchCompont:OnClickBtn(go, isOn, viewName)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:CloseView()
    elseif name == "@_aorbtn_help" then
        ---打开玩法说明页面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 164)
    end
end

function SociatyBattleLeagueMatchCompont:StartBattleTimer()
    self.BattleShowTime = require "SociatyBattleLeagueModel":GetInstance():GetEndTime()
    self.battleTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateBattleTime, self, false, false, true)
    self.battleTimer:Start()
end

function SociatyBattleLeagueMatchCompont:UpdateBattleTime()
    local time = self.BattleShowTime - _G.TimeUtil.GetServerUnixTime()
    if time <= 0 then
        time = 0
        self:UpdateTime()
    end
    self.go_table.aortext_stateTime.text = _G.TimeUtil.TransLateSMCH(time)
end

function SociatyBattleLeagueMatchCompont:StopAllTimer()
    if self.battleTimer then
        self.battleTimer:Stop()
        self.battleTimer = nil
    end
end

function SociatyBattleLeagueMatchCompont:EscClose()
    self:CloseView()
end

function SociatyBattleLeagueMatchCompont:CloseView()
    self:Close()
end

function SociatyBattleLeagueMatchCompont:OnDestroy()
    self:StopAllTimer()
end

return SociatyBattleLeagueMatchCompont
