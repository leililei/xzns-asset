function SociatyBattleLeagueMatchCompont:LoadEffect()
    local ck = function (trans)
        if self.go_table == nil then
            _G.DestroyObject(trans)
        end
    end
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_shandian, self.go_table.obj_vsEff, ck)
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_vsguang, self.go_table.obj_vsEff, ck)
end

function SociatyBattleLeagueMatchCompont:UpdateTime()
    local SociatyBattleLeagueModel = require "SociatyBattleLeagueModel":GetInstance()

    if SociatyBattleLeagueModel:GetSelfScoaityData() ~= nil then
        local SociatyBattleLeagueManager = require "SociatyBattleLeagueManager":GetInstance()
        self.go_table.aortext_stageDesc.text = _G.GetLangPackValue(90021800265, SociatyBattleLeagueModel:GetCurDay())
        if SociatyBattleLeagueManager:GetState() == _G.SociatyBattleLeagueState.Battle then
            if SociatyBattleLeagueManager:GetStageState() == _G.SociatyBattleLeagueStageState.BattleGroup then
                if SociatyBattleLeagueModel:CheckIsGroupFirstDay() then
                    self.go_table.aortext_stageTimeDesc.text =
                        self.stateAndStr[SociatyBattleLeagueManager:GetStageState()][1] .. _G.GetLangPackValue(90032100077)
                else
                    self.go_table.aortext_stageTimeDesc.text =
                        self.stateAndStr[SociatyBattleLeagueManager:GetStageState()][2] .. _G.GetLangPackValue(90032100077)
                end
            else
                self.go_table.aortext_stageTimeDesc.text =
                    self.stateAndStr[SociatyBattleLeagueManager:GetStageState()] .. _G.GetLangPackValue(90032100077)
            end
        elseif SociatyBattleLeagueManager:GetState() == _G.SociatyBattleLeagueState.Settlement then
            self.go_table.aortext_stageTimeDesc.text = _G.GetLangPackValue(90032100040)
        else
            if SociatyBattleLeagueManager:GetStageState() == _G.SociatyBattleLeagueStageState.BattleGroup then
                if SociatyBattleLeagueModel:CheckIsGroupFirstDay() then
                    self.go_table.aortext_stageTimeDesc.text =
                        self.stateAndStr[SociatyBattleLeagueManager:GetStageState()][1] .. _G.GetLangPackValue(90032100076)
                else
                    self.go_table.aortext_stageTimeDesc.text =
                        self.stateAndStr[SociatyBattleLeagueManager:GetStageState()][2] .. _G.GetLangPackValue(90032100076)
                end
            else
                self.go_table.aortext_stageTimeDesc.text =
                    self.stateAndStr[SociatyBattleLeagueManager:GetStageState()] .. _G.GetLangPackValue(90032100076)
            end
        end
    end
    self.BattleShowTime = require "SociatyBattleLeagueModel":GetInstance():GetEndTime()
end

