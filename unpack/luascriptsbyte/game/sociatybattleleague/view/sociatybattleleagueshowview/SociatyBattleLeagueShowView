---@class SociatyBattleLeagueShowView : UIBaseView	中文描述
---@field public go_table SociatyBattleLeagueShowView_GoTable GoTable
local SociatyBattleLeagueShowView = _G.BaseClass("SociatyBattleLeagueShowView", _G.UIBaseView)

function SociatyBattleLeagueShowView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyBattleLeagueShowView:OnCreate()
    self.go_table.toggle_reject.isOn = false
    self:Show()
end

function SociatyBattleLeagueShowView:Show()
    local cfg = require "SociatyBattleLeagueModel":GetInstance():GetSeasonCfg()
    --角色spine
    if cfg.background[2] and cfg.background[2][1] and not _G.string.IsNullOrEmpty(cfg.background[2][1]) then
        _G.UIUtils.LoadEffectByPath(
            cfg.background[2][1],
            self.go_table.obj_root,
            function(transform)
                if _G.IsNil(self.go_table.obj_root) then
                    transform:DestroyObject()
                    return
                end
                -- transform:SetAsFirstSiblingE()
                -- --隐藏默认节点
                -- self.go_table.obj_defaultEffect:SetActiveE(0)
            end,
            nil,
            nil,
            {cfg.background[2][2],cfg.background[2][3],cfg.background[2][4]},
            cfg.background[2][5]
        )
    end
    --标题
    if cfg.background[3] and cfg.background[3][1] then
        self.go_table.aortext_title.text = _G.GetLangPackValue(tonumber(cfg.background[3][1]))
        if cfg.background[3][2] and cfg.background[3][3] then
            require("CommonTipManager"):GetInstance():SetTextGradient(
                    {cfg.background[3][2], cfg.background[3][3]},
                    {1, 1},
                    self.go_table.aortext_title
            )
        end
    end
    --技能图标
    if cfg.background[1] and cfg.background[1][1] then
        self.go_table.aorrawimage_bg:LoadImage(
                cfg.background[1][1],
                function(image)
                    image:SetNativeSize()
                end)
    end
end


---界面的销毁函数
function SociatyBattleLeagueShowView:OnDestroy()
end

---按钮点击事件在这里派发
function SociatyBattleLeagueShowView:OnClickBtn(go)
    local function close()
        if self.go_table.toggle_reject.isOn then
            _G.PlayerPrefsManager.SetInt(
                "SociatyBattleLeagueShowView" .. tostring(_G.PlayerModel:GetInstance().role_uid),
                _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
            )
        end
        self:Close()
    end
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close1 then
        close()
    elseif go == self.go_table.aorbtn_get then
        local stageState = require "SociatyBattleLeagueModel":GetInstance():GetStageState()
        local curSession = require "SociatyBattleLeagueManager":GetInstance():GetCurSession()

        if stageState == _G.SociatyBattleLeagueStageState.None or stageState == _G.SociatyBattleLeagueStageState.End then
            if curSession <= 0 then
                return
            end
        end
        require("SociatyBattleLeagueManager"):GetInstance():Enter()
        close()
    end
end

return SociatyBattleLeagueShowView