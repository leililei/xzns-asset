---显示界面
---@param data SociatyBattleLeagueCampsiteData
function SociatyBattleLeagueCampsiteView:ShowView(data, isSelf)
    self.data = data
    self.embattleDatas = data:GetEmbattleDatas() or {}
    self.normalcfg = require "SociatyBattleLeagueModel":GetInstance():GetNormalCfg()
    self.isSelf = isSelf

    local isMistyEffect = require "SociatyBattleLeagueModel":GetInstance().MistyEffect
    local mistyTimes = require "SociatyBattleLeagueModel":GetInstance().MistyTimes
    if self.IsTemp then
        self.MistyEffectIng = isMistyEffect and self.data:GetAttackTimes() < mistyTimes
    else
        self.MistyEffectIng = isMistyEffect and not self.isSelf and self.data:GetAttackTimes() < mistyTimes
    end

    self:UpdateRole()

    self.go_table.scrollloopvectical_arrayList:UpdateCount(self.normalcfg.team_number)
    --self.go_table.aorrawimage_dan.Alpha = 0
    --require "ArenaPeakModel":GetInstance():ShowDan(self.gameObject, 0, nil, false, data:GetArenaPeakDan())
    self:ShowBtn()
    self:UpdateChallengeNum()

    self:UpdateSolid()
    self:UpdateGx()
    self:UpdateHp()
end

function SociatyBattleLeagueCampsiteView:UpdateSolid()
    local isSolidDefense = require "SociatyBattleLeagueModel":GetInstance().SolidDefense
    local solidDefenseAdd = require "SociatyBattleLeagueModel":GetInstance().SolidDefenseAdd
    if not self.IsTemp then
        if isSolidDefense and not self.isSelf then
            local atttimes = SociatyBattleLeagueModel:GetInstance().maxChallengeNum - SociatyBattleLeagueModel:GetInstance():GetChallengeNum()
            if self.go_table.aortext_soliddefense then
                self.go_table.aortext_soliddefense.text = _G.GetLangPackValue(90036102022, atttimes * (solidDefenseAdd)/100 .. "%")
            end
        else
            if self.go_table.aortext_soliddefense then
                self.go_table.aortext_soliddefense.text = ""
            end
        end
    else
        if self.go_table.aortext_soliddefense then
            self.go_table.aortext_soliddefense.text = ""
        end
    end
end

function SociatyBattleLeagueCampsiteView:UpdateRole()
    local role = _G.DeepCopy(self.data:GetRoleInfo())

    ---判断是不是有迷雾
    if self.MistyEffectIng then
        role.style = 0
        role.frame = 0
        role.uid = 0
        self.go_table.aortext_name.text = "???"
        self.go_table.aortext_power.text = "???"
    else
        self.go_table.aortext_name.text = role.name
        local power = 0
        for i, v in ipairs(self.embattleDatas) do
            if i <= self.normalcfg.team_number then
                power = power + (v.power or 0)
            end
        end
        self.power = power
        self.go_table.aortext_power.text = _G.GameUtil.NumberToUnitStrBag(power)
    end
    _G.UIUtils.SetPlayerHeadItemNew(self.go_table.obj_HeadItemBase, role, nil, true, nil, nil)
end

---初始化场景
function SociatyBattleLeagueCampsiteView:InitScene()
    self.player_scene_cfg =
        _G.ConfigManager.player_scene_cfg[require "SociatyBattleLeagueModel":GetInstance().background_id]
    _G.PoolsManager:GetInstance():Spawn(
    -- self.player_scene_cfg.prefab,
        "Scenes/sp_gonghuizhan/Export/prf_sp_gonghuizhan",
        --"Scenes/sp_gonghuizhengba/Export/sp_gonghuizhengba",
        _G.ePoolType.Temporary,
        nil,
        function(obj)
            if self:IsNil() then
                _G.DestroyObject(obj)
                return
            end
            self.scene = obj
            local environment = obj:GetComponentInChildren(_G.typeof(_G.CS.FrameWork.Environment.EnvironmentSetting))
            if environment then
                environment.SceneCamera.fieldOfView = 35 * _G.CS.Launcher.Inst.FovScale
            end
            self.camera = environment.SceneCamera
            self:LoadSceneEffect()
            self:OnClickItem(nil, nil, 1)
        end
    )
end

---显示模型
function SociatyBattleLeagueCampsiteView:ShowRoles(index)
    if self.MistyEffectIng then
        return
    end
    local datas = self.embattleDatas[index]
    if not self.roleList then
        self.roleList = {}
    end
    for _, v in pairs(self.roleList) do
        v:Dispose()
    end
    local pos = 0
    self.curTitle = 1
    local loadCount = 0
    for i = 1, #datas.card_list do
        if loadCount < 3 then--只加载三个模型，五人队只显示前三个
            ---@type skin_cfg
            local cfg = require "CardCommentManager":GetInstance():CardData(datas.card_list[i].card_sid, true)
            if cfg then
                loadCount = loadCount + 1
                pos = pos + 1
                local params = _G.ConfigManager.discrete_cfg[101646 + pos - 1]
                self:InitTitle(cfg.Name)
                ---@param obj UnityEngine.GameObject
                self.roleList[i] =
                    require "CardInfoManager".GetRole(
                        _G.AppSetting.IsXzns and _G.UIUtils.GetBattleSpine(cfg) or cfg.ModelPathHi,
                        _G.ePoolType.Temporary,
                        self.go_table.trans_Card,
                        _G.RoleEffTypeEnum.Fight,
                        function(obj)
                            if self:IsNil() then
                                return
                            end
                            if not self.roleList[i] then
                                self.roleList[i] = { item = obj }
                            else
                                if not self.roleList[i].item then
                                    self.roleList[i].item = obj
                                end
                            end
                            --obj:SetParentE(self.scene.transform)
                            local carShowcfg = _G.ConfigManager.card_show_cfg[cfg.id]
                            local size = carShowcfg and carShowcfg.size2 or
                                _G.ConfigManager.card_cfg[datas.card_list[i].card_sid].size2
                            obj:SetLocalPosition(params[1][1], params[1][2], params[1][3])
                            if _G.AppSetting.IsXzns then
                                obj:SetLocalScaleXYZ(1)
                            else
                                obj:SetLocalScaleXYZ(size * params[1][4])
                            end
                            obj:SetLocalEulerAngles(params[2][1], params[2][2], params[2][3])
                        if not table.isEmptyOrNil(datas.card_list[i].artifact_skin) then
                            _G.UIUtils.LoadArtifacteffect(obj,nil,datas.card_list[i].artifact_skin[1],datas.card_list[i].artifact_skin[2])
                        end
                            _G.DelayFrameDo(
                                function()
                                    if self:IsNil() then
                                        return
                                    end
                                    --self:ShowHalo(obj, datas.card_list[i].halo_sid, i)
                                end
                            )
                        end
                    )
                --else
                -- LogError(datas.card_list[i].card_sid)
            end
        end
    end
end

---初始化头顶名称位置
---@param deltaY number Y轴便宜值
function SociatyBattleLeagueCampsiteView:SetTitlePos(title, index)
    if not _G.IsNil(title) then
        local x, y, z = self:GetHeadPoint(index)
        if x then
            --local deltaY = _G.ConfigManager.discrete_cfg[103501][1][1]
            --  local x1, y1, z1 = self.sceneTrans:GetPosition()
            --local s = self.Title.transform:GetLocalScale()
            local pos = {}
            pos.x = x + 0.1
            pos.z = z
            pos.y = y + 0.15
            local scale = self.roleList[index].item:GetLocalScale()
            title:SetLocalScaleXYZ(1.2 / scale)
            title:SetLocalPositionToZero()
            title:SetPosition(pos.x, pos.y, pos.z)
            local lookAt = title:GetComponentE(_G.typeof(_G.CS.LookAtTarget))
            if _G.IsNil(lookAt) then
                lookAt = title:AddComponentE(_G.typeof(_G.CS.LookAtTarget))
            end

            lookAt:SetData(self.camera.transform, self.roleList[index].item)
        end
    end
end

---获取头部坐标
function SociatyBattleLeagueCampsiteView:GetHeadPoint(index)
    if not self.roleList[index] or not self.roleList[index].item then
        return
    end
    local RolePoint = self.roleList[index].item:GetComponentE(_G.typeof(_G.CS.RolePoint))
    if _G.IsNil(RolePoint) then
        return nil
    end
    --if _G.IsNil(self.RolePoint.Point_Hp) then
    if _G.IsNil(RolePoint.Point_Head) then
        return nil
    else
        return RolePoint.Point_Head:GetPosition()
    end
    -- end
    --return self.RolePoint.Point_Hp:GetPosition()
end

---加载场景特效
function SociatyBattleLeagueCampsiteView:LoadSceneEffect()
    if self.effectTb then
        for _, v in pairs(self.effectTb) do
            _G.DestroyObject(v)
        end
    end

    self.effectTb = {}
    ---@type player_scene_cfg
    local cfg = self.player_scene_cfg
    for _, v in pairs(cfg.effect) do
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[v],
            self.scene,
            function(obj)
                if self:IsNil() or v.ID ~= self.data.background_id then
                    _G.DestroyObject(obj)
                    return
                end
                _G.table.insert(self.effectTb, obj)
            end
        )
    end
end

---初始化名字
function SociatyBattleLeagueCampsiteView:InitTitle(name)
    if self.go_table["aortext_name" .. self.curTitle] then
        self.go_table["aortext_name" .. self.curTitle].text = _G.GetLangPackValue(name)
    end
    if self.go_table["aorimage_nameBg" .. self.curTitle] then
        self.go_table["aorimage_nameBg" .. self.curTitle]:SetActiveE(1)
    end
    self.curTitle = self.curTitle + 1
end

function SociatyBattleLeagueCampsiteView:ShowDesignation(parent, title, i)
    if not title then
        title = 0
    end
    if not self.Designation then
        self.Designation = {}
    end
    if self.Designation[i] then
        _G.DestroyObject(self.Designation[i])
    end
    if _G.IsNil(parent) then
        return
    end
    local cfg = _G.ConfigManager.player_title_effect_cfg[title]
    local go_table = _G.GetAutoGoTable(parent)
    if cfg then
        if cfg.type_title == 1 then
            go_table.aorrawimage_Title:LoadImage(
                cfg.title,
                function(trans)
                    go_table.aorrawimage_Title:SetNativeSize()
                end
            )
            go_table.aorrawimage_Title:SetActiveE(1)
            go_table.aorrawimage_Title:SetLocalScaleXYZ(0.003)
        else
            go_table.aorrawimage_Title:SetActiveE(0)
            _G.UIUtils.LoadEffectTitleOrFrame(
                cfg.title,
                go_table.obj_effect,
                function(trans)
                    if _G.IsNil(self:IsNil()) then
                        _G.DestroyObject(trans)
                        return
                    end
                    local effScript = trans:GetComponentE(_G.typeof(_G.CS.EffectLevel))
                    if not _G.IsNil(effScript) then
                        effScript:SetIsShow(true)
                    end
                    trans:SetLayerAndChild(30)
                    trans:SetLocalScaleXYZ(_G.ConfigManager.discrete_cfg[103902][1][1] * 0.003)
                end
            )
        end
    elseif title <= 0 then
        go_table.aorrawimage_Title:SetActiveE(0)
        go_table.aorrawimage_Title:SetLocalScaleXYZ(_G.ConfigManager.discrete_cfg[103902][1][1] * 0.003)
    end
end

function SociatyBattleLeagueCampsiteView:ShowHalo(parent, title, i)
    if not self.Halo then
        self.Halo = {}
    end
    if not title then
        title = 0
    end
    if not _G.IsNil(self.Halo[i]) then
        _G.DestroyObject(self.Halo[i])
    end

    local cfg = _G.ConfigManager.player_halo_effect_cfg[title]
    if cfg then
        _G.PoolsManager:GetInstance():Spawn(
            cfg.halo,
            _G.ePoolType.World,
            parent,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                if nil == self.roleList[i].item then
                    _G.DestroyObject(trans)
                    return
                end
                self.Halo[i] = trans
                local RolePoint = self.roleList[i].item:GetComponentE(_G.typeof(_G.CS.RolePoint))
                if cfg.type_halo == 2 then
                    trans:SetParentE(RolePoint.Point_Chest)
                else
                    if not _G.IsNil(RolePoint) and not _G.IsNil(RolePoint.Point_Shadow) then
                        trans:SetParentE(RolePoint.Point_Shadow)
                    else
                        trans:SetParentE(self.roleList[i].item)
                    end
                    trans:SetLocalPosition(0, 0.01, 0)
                    trans:SetLocalScaleXYZ(_G.ConfigManager.discrete_cfg[103901][1][1])
                end
                trans:SetEulerAngles(0, 0, 0)
                trans:AddComponentE(_G.typeof(_G.CS.KeepRotate))
                local effScript = trans:GetComponentE(_G.typeof(_G.CS.EffectLevel))
                if not _G.IsNil(effScript) then
                    effScript:SetIsShow(true)
                end
            end
        )
    end
end

function SociatyBattleLeagueCampsiteView:RecycleRoles()
    if self.roleList then
        for _, v in pairs(self.roleList) do
            v:Dispose()
        end
    end
    if self.itemTitleList then
        for _, v in pairs(self.itemTitleList) do
            v:Dispose()
        end
    end
    if self.Halo then
        for _, v in pairs(self.Halo) do
            _G.DestroyObject(v)
        end
    end
    if self.Designation then
        for _, v in pairs(self.Designation) do
            _G.DestroyObject(v)
        end
    end
end

function SociatyBattleLeagueCampsiteView:RefreshItem(index, obj)
    ---@type SociatyBattleLeagueCampsiteView._obj_item_GoTable
    local item = GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, index + 1))
    self.itemList[index + 1] = item
    item.aorimage_Choose:SetActiveE(index + 1 == self.chooseIndex and 1 or 0)
    item.aortext_num.text = _G.GetLangPackValue(90021800275, index + 1)
    ---@type guild_fight.i_array
    local datas = self.embattleDatas[index + 1]
    if self.MistyEffectIng then
        item.aortext_power.text = "???"
    else
        item.aortext_power.text = _G.GameUtil.NumberToUnitStrBag(datas.power)
    end
    local isMistyEffect = require "SociatyBattleLeagueModel":GetInstance().MistyEffect
    if isMistyEffect then
        _G.UIUtils.RemoveChildren(item.trans_content)
    end
    local count = _G.table.count(datas)
    if item.trans_content:GetChildCountE() > 0 then
        item.trans_content:ClearChildren()
    end
    if not item.cardList then
        item.cardList = {}
    end
    for i = 1, count do
        if self.MistyEffectIng then
            local data = datas.card_list[i]
            if data then
                if data.card_sid > 0 then
                    _G.ItemCardFactory:GetInstance():GetItemCard(
                        _G.ItemCardFactory.itemCardType.CardAllItem,
                        item.trans_content,
                        function(card)
                            item.cardList[i] = card
                            card:Show(0, nil, 0, 0, 0, nil, 0, 0, 0)
                        end
                    )
                end
            end
        else
            local data = datas.card_list[i]
            if data then
                if data.card_sid > 0 then
                    ---@param card ItemCardAllView
                    _G.ItemCardFactory:GetInstance():GetItemCard(
                        _G.ItemCardFactory.itemCardType.CardAllItem,
                        item.trans_content,
                        function(card)
                            item.cardList[i] = card
                            card:Show(
                                data.card_sid,
                                nil,
                                data.star,
                                data.soul_lv,
                                data.card_lv,
                                nil,
                                data.card_sid,
                                data.soul_state,
                                data.born_skill_num
                            )
                        end
                    )
                else
                    -- if item.cardList[i] then
                    --     item.cardList[i]:Show(
                    --         data.card_sid,
                    --         nil,
                    --         data.star,
                    --         data.soul_lv,
                    --         data.card_lv,
                    --         nil,
                    --         data.card_sid,
                    --         data.soul_state,
                    --         data.born_skill_num
                    --     )
                    --     item.cardList[i].gameObject:SetActiveE(1)
                    -- end
                    if item.cardList[i] then
                        item.cardList[i].gameObject:SetActiveE(0)
                    end
                end
            else
                if item.cardList[i] then
                    item.cardList[i].gameObject:SetActiveE(0)
                end
            end
        end
    end
    if index + 1 == #self.embattleDatas then
        self.go_table.scrollloopvectical_arrayList:ScrollToTop()
    end
end

function SociatyBattleLeagueCampsiteView:OnClickItem(_, _, index)
    if self.chooseIndex == index then
        return
    end
    if self.itemList[self.chooseIndex] then
        self.itemList[self.chooseIndex].aorimage_Choose:SetActiveE(0)
    end
    self.chooseIndex = index
    if self.itemList[index] then
        self.itemList[index].aorimage_Choose:SetActiveE(1)
    end
    for i = 1, 3 do
        self.go_table["aorimage_nameBg" .. i]:SetActiveE(0)
    end
    self:ShowRoles(index)
end

---更新挑战次数
function SociatyBattleLeagueCampsiteView:UpdateChallengeNum()
    if self:IsNil() or _G.IsNil(self.go_table.aortext_challengeNum) then
        return
    end
    self.go_table.aortext_challengeNum.text =
        SociatyBattleLeagueModel:GetInstance():GetChallengeNum() ..
        "/" .. SociatyBattleLeagueModel:GetInstance().maxChallengeNum
end

---更新挑战次数
function SociatyBattleLeagueCampsiteView:UpdateGx()
    self.go_table.aortext_gx.text = _G.GameUtil.NumberToUnitStrBag(math.floor(SociatyBattleLeagueModel:GetInstance()
        :GetSorce()))
end

function SociatyBattleLeagueCampsiteView:UpdateHp()
    local value = self.data:GetHp() / self.data.cfg.hp
    self.go_table.slider_hp.value = value
    --self.go_table.aorimage_fill.SpriteName = require "SociatyBattleLeagueManager".GetHpImage(value)
end

---战后刷新
function SociatyBattleLeagueCampsiteView:BattleRefresh()
    self:UpdateChallengeNum()
    self:UpdateSolid()
    self:UpdateGx()
    self:ShowBtn()
    self:UpdateHp()

    local isMistyEffect = require "SociatyBattleLeagueModel":GetInstance().MistyEffect
    local mistyTimes = require "SociatyBattleLeagueModel":GetInstance().MistyTimes
    local mistyEffectIng = isMistyEffect and not self.isSelf and self.data:GetAttackTimes() < mistyTimes
    if mistyEffectIng ~= self.MistyEffectIng then
        self.MistyEffectIng = mistyEffectIng
        self:UpdateRole()
        self.go_table.scrollloopvectical_arrayList:UpdateCount(self.normalcfg.team_number)
        self:ShowRoles(self.chooseIndex)
    end
end

---更新按钮显示
function SociatyBattleLeagueCampsiteView:ShowBtn()
    if self.isSelf then
        self.go_table.aorrawimage_start:SetActiveE(0)
        self.go_table.aorrawimage_test:SetActiveE(1)
    else
        self.go_table.aorrawimage_start:SetActiveE(1)
        self.go_table.aorrawimage_test:SetActiveE(0)
    end
    if self.isNotAttack then
        self.go_table.aorbtn_battle:SetActiveE(0)
    end

    if self.IsTemp then
        self.go_table.aorbtn_record:SetActiveE(0)
        self.go_table.aorbtn_battle:SetActiveE(0)
    end
    self.go_table.aorbtn_attack:SetActiveE(0)
end

---进攻
function SociatyBattleLeagueCampsiteView:OnAttack()
    if not self.isSelf then
        if require "SociatyBattleLeagueModel":GetInstance():GetState() ~= _G.SociatyBattleLeagueState.Battle then
            _G.PopWindowManager:GetInstance():ShowAllTips(250126, "非战斗时间，不能开战")
            self:DoClose()
            return
        end
    end
    if _G.MainManager:GetInstance():IsFighting(true) then
        return
    end
    if self.isSelf then
        require "SociatyBattleLeagueManager":GetInstance():Fight(
            SociatyBattleLeagueModel:GetInstance():GetSelfScoaityData():GetSociatyInfoData().guild_uid,
            self.data,
            true,
            false
        )
    else
        if self.data:GetHp() <= 0 then
            local isAllZero = require("SociatyBattleLeagueManager"):GetInstance():CheckCampsiteZero()

            ---判断是否为全驻地攻破
            if isAllZero then
                require "SociatyBattleLeagueManager":GetInstance():Fight(
                    SociatyBattleLeagueModel:GetInstance():GetEnemySociatyData():GetSociatyInfoData().guild_uid,
                    self.data,
                    false,
                    self.MistyEffectIng
                )
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(250137)
                return
            end
        else
            if self.data:GetType() == _G.SociatyBattleCampsiteType.Main then
                local isAllZero =
                    require("SociatyBattleLeagueManager"):GetInstance():CheckCampsiteZero(
                        _G.SociatyBattleCampsiteType.Importance
                    )

                ---判断是否为重要驻地都攻破
                if isAllZero then
                    require "SociatyBattleLeagueManager":GetInstance():Fight(
                        SociatyBattleLeagueModel:GetInstance():GetEnemySociatyData():GetSociatyInfoData().guild_uid,
                        self.data,
                        false,
                        self.MistyEffectIng
                    )
                else
                    if _G.AppSetting.DEBUG then
                        _G.Log("重要驻地未全攻破，不能攻主城")
                    end
                    _G.PopWindowManager:GetInstance():ShowAllTips(250138)
                end
            else
                require "SociatyBattleLeagueManager":GetInstance():Fight(
                    SociatyBattleLeagueModel:GetInstance():GetEnemySociatyData():GetSociatyInfoData().guild_uid,
                    self.data,
                    false,
                    self.MistyEffectIng
                )
            end
        end
    end
end

---按钮点击事件在这里派发
function SociatyBattleLeagueCampsiteView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:DoClose()
    elseif go == self.go_table.aorbtn_battle then
        if not self.isSelf then
            if not require "SociatyBattleLeagueManager":GetInstance():CheckTime12() then
                _G.PopWindowManager:GetInstance():ShowAllTips(1001, _G.GetLangPackValue(90021800547))
                return
            end
            if self.data:GetRoleInfo().uid == _G.PlayerModel:GetInstance().role_uid then
                _G.PopWindowManager:GetInstance():ShowAllTips(250311)
                return
            end
        end
        self:OnAttack()
    elseif go == self.go_table.aorbtn_record then
        local roleInfo = _G.DeepCopy(self.data:GetRoleInfo())
        roleInfo.arena_peak_dan = self.data:GetArenaPeakDan()
        local uid1 = SociatyBattleLeagueModel:GetInstance():GetEnemySociatyData():GetUid()
        local uid2 = require "SociatyManager":GetInstance():GetGuildUid()
        if not self.isSelf then
            uid1, uid2 = uid2, uid1
        end
        SociatyBattleLeagueModel:GetInstance():GetFightRecord(
            uid1,
            uid2,
            self.data.id,
            function(msg)
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.SociatyBattleLeagueMessageView.Name,
                    msg,
                    roleInfo,
                    false,
                    self.power,
                    self.isSelf,
                    self.MistyEffectIng
                )
            end
        )
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 164)
    elseif go == self.go_table.aorbtn_effect then
        --赛季效果
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleLeagueSkillShowView.Name)
    end
end

