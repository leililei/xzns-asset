---@class SociatyBattleLeagueResultView : UIBaseView	中文描述
---@field public go_table SociatyBattleResultView_GoTable GoTable
---@field fightArgs fight.i_fight_arg 战斗参数
local SociatyBattleLeagueResultView = _G.BaseClass("SociatyBattleLeagueResultView", _G.UIBaseView)
--_G.SociatyBattleLeagueResultView = SociatyBattleLeagueResultView
local GetAutoGoTable = _G.GetAutoGoTable
function SociatyBattleLeagueResultView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param msg fight.i_fight_arg 战斗参数
---@param result boolean[] 战斗结果
function SociatyBattleLeagueResultView:OnCreate(call, msg, result, isSp, resultData)
    self.fightArgs = msg
    self.result = result or {true, true, true}
    self.call = call
    self.otherInfo = resultData and resultData.otherInfo or nil
    self.re_uid = resultData and resultData.re_uid or nil
    self.reportType = resultData and resultData.reportType or 0

    self:ShowResult(result)
    self.go_table.scrollloopvectical_arrayList:InitItemData(#msg.attacker_team, _G.handler(self, self.RefreshItem))
    if require "SociatyBattleLeagueManager":GetInstance():CheckIsTestFight() then
        self.go_table.obj_award:SetActiveE(0)
        self.go_table.aortext_title.text = _G.GetLangPackValue(90032100041, self.WinNum, 0, 0, 0)
    else
        local sociatyDatas = require "SociatyBattleLeagueModel":GetInstance():GetEnemySociatyData()
        local campsiteData =
            sociatyDatas:GetCampsiteData(require "SociatyBattleLeagueManager":GetInstance().attackCampsiteId)
        self:ShowAward(campsiteData, result)
        local hp = require "SociatyBattleLeagueModel":GetInstance().changeHp or 0
        local baseHp = require "SociatyBattleLeagueModel":GetInstance().changeBaseHp or 0
        local score = require "SociatyBattleLeagueModel":GetInstance().changeScore or 0
        self.go_table.aortext_title.text =
            _G.GetLangPackValue(90021800521, self.WinNum, baseHp, hp - baseHp, _G.math.floor(score))
    end
    self.go_table.aorbtn_statistics:SetActiveE(isSp and 0 or 1)
end

---显示阵容
function SociatyBattleLeagueResultView:RefreshItem(index, obj)
    ---@type SociatyBattleLeagueResultView._obj_item_GoTable
    local item = GetAutoGoTable(obj)
    self:ShowTeamCard(self.fightArgs.attacker_team, item.obj_my, index)
    self:ShowTeamCard(self.fightArgs.defender_team, item.obj_enemy, index)
    local isWin = self.result[index + 1]
    item.obj_resultF:SetActiveE(isWin and 0 or 1)
    item.obj_resultV:SetActiveE(isWin and 1 or 0)
    item.aorrawimage_di:SetActiveE(index % 2 == 0 and 0 or 1)
end

---显示队伍卡牌
---@param team  fight.i_fight_team[] 队伍数据
function SociatyBattleLeagueResultView:ShowTeamCard(team, obj, index)
    local datas = team[index + 1]
    ---@type _obj_item._obj_my_GoTable
    local item = GetAutoGoTable(obj)
    if not item.cardList then
        item.cardList = {}
    end
    local count = datas.fights and #datas.fights or 0
    if count < #item.cardList then
        count = #item.cardList
    end
    for i = 1, count do
        self:SetCardShow(item.cardList, i, datas.fights and datas.fights[i] or nil, item["obj_play"..i])
    end
    item.aortext_array.text = _G.GetLangPackValue(90021800275, index + 1)
    item.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(datas.power)
end

---显示卡牌
function SociatyBattleLeagueResultView:SetCardShow(itemList, index, data, parent)
    if data then
        if not itemList[index] then
            ---@param card ItemCardAllView
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.CardAllItem,
                parent,
                function(card)
                    itemList[index] = card
                    card:Show(
                        data.sid,
                        nil,
                        data.star,
                        data.soul_chain_lv,
                        data.lv,
                        data.sid,
                        data.soul_state,
                        data.uid,
                        self:GetTalentsNum(data.sid, data.skills)
                    )
                end
            )
        else
            itemList[index]:Show(
                data.sid,
                nil,
                data.star,
                data.soul_chain_lv,
                data.lv,
                data.sid,
                data.soul_state,
                data.uid,
                self:GetTalentsNum(data.sid, data.skills)
            )
            itemList[index].gameObject:SetActiveE(1)
        end
    else
        if itemList[index] then
            itemList[index].gameObject:SetActiveE(0)
        end
    end
end

---获取激活大天赋数量
---@param sid number 卡牌sid
---@param skills table fight_arg中的卡牌技能组
---@return number 激活的大天赋数量
function SociatyBattleLeagueResultView:GetTalentsNum(sid, skills)
    local cfg = _G.ConfigManager.card_cfg[sid]
    if cfg == nil then
        return 0
    end
    local attrCfg = _G.ConfigManager.attribute_cfg
    local tCfg
    local num = 0
    for i, node in pairs(cfg.talent) do
        for j, talent in pairs(node) do
            tCfg = attrCfg[talent]
            if tCfg.skill > 0 and _G.table.ContainsValue(skills, tCfg.skill) then
                num = num + 1
            end
        end
    end
    return num
end

---显示奖励
---@param campsiteData SociatyBattleLeagueCampsiteData
function SociatyBattleLeagueResultView:ShowAward(campsiteData, result)
    local isZero = require "SociatyBattleLeagueModel":GetInstance().isZero
    local cfg = campsiteData.cfg
    if isZero then
        local loseCfg = cfg.lose_reward
        local award = {}
        for _, v in pairs(loseCfg) do
            award[v[1]] = 0
        end
        for i = 1, #result do
            if result[i] then
                award[loseCfg[1][1]] = award[loseCfg[1][1]] + loseCfg[1][2]
            else
                award[loseCfg[2][1]] = award[loseCfg[2][1]] + loseCfg[2][2]
            end
        end
        self.awardList = {}
        for k, v in pairs(award) do
            _G.table.insert(self.awardList, {k, v})
        end
    else
        self.awardList = cfg.reward
    end
    local per = campsiteData:GetReduceHpPer(self.result)
    for _, v in ipairs(self.awardList) do
        local obj = _G.InstantiateObject(self.go_table.obj_awardItem, self.go_table.obj_award)
        ---@type SociatyBattleLeagueResultView._obj_awardItem_GoTable
        local go_table = _G.GetAutoGoTable(obj)
        go_table.aorrawimage_icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(v[1]))
        if isZero then
            go_table.aortext_num.text = _G.GameUtil.NumberToUnitStrBag(v[2])
        else
            go_table.aortext_num.text = _G.GameUtil.NumberToUnitStrBag(Mathf.RoundToInt(v[2] * per))
        end
        obj:SetActiveE(1)
    end
end

---显示结果
---@param result boolean[] 结果
function SociatyBattleLeagueResultView:ShowResult(result)
    self.WinNum = 0
    if result then
        for i = 1, #result do
            if result[i] then
                self.WinNum = self.WinNum + 1
            end
        end
        self.isWin = self.WinNum > #result - self.WinNum
    end
    self.go_table.obj_resultV:SetActiveE(self.isWin and 1 or 0)
    self.go_table.obj_resultF:SetActiveE(self.isWin and 0 or 1)
end

---显示战报
function SociatyBattleLeagueResultView:OnShowStatistics()
    local damage, win =
        _G.GameUtil.ShowStatisticsView(_G.BattleManager:GetInstance():GetStatisticsRecord(self.fightArgs))

    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name,
        damage,
        self:SetWintable(),
        nil,
        nil,
        self.otherInfo,
        nil,
        false,
        self.fightArgs,
        nil,
        self.re_uid,
        self.reportType
    )
end

--设置战斗结果
function SociatyBattleLeagueResultView:SetWintable()
    local array = {}
    for i = 1, #self.result do
        if self.result[i] then
            _G.table.insert(array, 0)
        else
            _G.table.insert(array, 1)
        end
    end
    return array
end

---按钮点击事件在这里派发
function SociatyBattleLeagueResultView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        if self.call then
            self.call(_G.SettlementModel.FunctionEnum.None)
        end
        self:Close()
    elseif go == self.go_table.aorbtn_statistics then
        self:OnShowStatistics()
    end
end

return SociatyBattleLeagueResultView
