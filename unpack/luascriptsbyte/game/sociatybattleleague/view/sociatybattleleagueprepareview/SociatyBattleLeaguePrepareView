local SociatyBattleLeagueModel = require "SociatyBattleLeagueModel"
local SociatyBattleLeagueNet = require "SociatyBattleLeagueNet"
---@class SociatyBattleLeaguePrepareView : UIBaseView	中文描述
---@field public go_table SociatyBattleLeaguePrepareView_GoTable GoTable
---@field public rankList i_guild_rank[] 中文描述
local SociatyBattleLeaguePrepareView = _G.BaseClass("SociatyBattleLeaguePrepareView", _G.UIBaseView)

function SociatyBattleLeaguePrepareView:Awake()
    self.rankList = {}
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eSociatyBattleLeague.SociatyBattleStateLeague, self.ChangeState)
end

---界面的入口函数
function SociatyBattleLeaguePrepareView:OnCreate()
    self:InitView()
end

function SociatyBattleLeaguePrepareView:ChangeState()
    self.State = SociatyBattleLeagueModel:GetInstance():GetStageState()
    if self.State > 2 then
        self:Close()

        require("SociatyBattleLeagueManager"):GetInstance():Enter()
    end
end

function SociatyBattleLeaguePrepareView:InitView()
    self.Session = SociatyBattleLeagueModel:GetInstance().CurSession
    self.SeasonId = SociatyBattleLeagueModel:GetInstance().SeasonId
    self.endTimeStr =
        _G.string.AddColor(_G.GetLangPackValue(90032100004), "D2510B") ..
        " " .. _G.string.AddColor(_G.GetLangPackValue(90032100005), "DED4B1")
    self:SetTime()
    self:SetRank()
    self:SetReward()
    local titleCfg = _G.ConfigManager.guild_league_season_effect_cfg[self.SeasonId].prepareforwar
    if #titleCfg > 0 then
        local titlePath = titleCfg[1][1]
        local possacle = titleCfg[2]
        self.go_table.aorrawimage_title:LoadImage(titlePath)
        self.go_table.aorrawimage_title:SetLocalPosition(
            tonumber(possacle[1]),
            tonumber(possacle[2]),
            tonumber(possacle[3])
        )
        self.go_table.aorrawimage_title:SetLocalScaleXYZ(tonumber(possacle[4]))
    end
    self.go_table.aortext_desc.text =
        _G.GetLangPackValue(90032100007, _G.GameUtil.NumberToWordByLanguage(self.SeasonId))
    --self.go_table.aorbtn_Rank:SetActiveE(self.Session == 0 and 0 or 1)
    self.go_table.aorbtn_gift:SetActiveE(0) --原activityid 10011

    local uiModel = _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.ui_model_1)
    self.go_table.obj_tag:SetActiveE(uiModel and 0 or 1)
    self.go_table.obj_tag1:SetActiveE(uiModel and 1 or 0)

    self.go_table.aorrawimage_Bg:LoadImage(SociatyBattleLeagueModel:GetInstance().PrepareBg)
end

---显示时间更新
function SociatyBattleLeaguePrepareView:SetTime()
    self.State = SociatyBattleLeagueModel:GetInstance():GetStageState()
    self.time = SociatyBattleLeagueModel:GetInstance().EndTime - _G.TimeUtil.GetServerUnixTime()
    self.go_table.obj_start:SetActiveE(self.State == 1 and 1 or 0)
    self.go_table.obj_end:SetActiveE(self.State == 2 and 1 or 0)
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.State == 2 then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.timer:Start()
        self:UpdateTime(0)
    else
        -- self:UpdateTime(0)
        self.timer = _G.TimerManager:GetInstance():GetTimer(self.time, self.UpdateTime, self, false, false, true)
        self.timer:Start()
    end
end

---排行
function SociatyBattleLeaguePrepareView:SetRank()
    SociatyBattleLeagueNet:GetInstance():GetRank(
        {state = 1, index = 0},
        function(data)
            self.rankList = data.ranks or {}
            self.rankSelf = data.self_guild
            local num = _G.Mathf.Max(#self.rankList, 3)
            if not self.isInit then
                self.go_table.scrollloopvectical_rankList:InitItemData(num, _G.handler(self, self.RefreshRank))
                self.isInit = true
            else
                self.go_table.scrollloopvectical_rankList:UpdateCount(num)
            end
            local uid = require("SociatyModel"):GetInstance().SociatySelf.Uid
            local index = -1
            for i, v in ipairs(self.rankList) do
                if v.guild_uid == uid then
                    index = i - 1
                end
            end
            self:RefreshRank(index, self.go_table.obj_player, true)
            self.go_table.obj_NoNum:SetActiveE(0)
        end
    )
end

function SociatyBattleLeaguePrepareView:RefreshRank(index, obj, isSelf)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj)
    _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickRank, tb))
    local data
    if index == 0 then
        --tb.aorimage_rankBg:SetActiveE(0)
        tb.aortext_rank.text = _G.GetLangPackValue(90022900040)
        tb.aortext_rank:SetActiveE(isSelf and 1 or 0)
        tb.obj_noBody:SetActiveE(1)
        data = self.rankSelf
    else
        data = self.rankList[index]
        --tb.aorimage_rankBg:SetActiveE(index <= 3 and 1 or 0)
        tb.aortext_rank:SetActiveE(index <= 3 and 0 or 1)
        for i = 1, 3 do
            tb["obj_rank" .. i]:SetActiveE(i == index and 1 or 0)
        end
        if index <= 3 then
            tb.aorimage_rankBg.SpriteName = "ui_diban" .. index
            tb.aorimage_rankBg:SetRectTransformSize(690, isSelf and 124 or 122)
        else
            tb.aortext_rank.text = index
            if isSelf then
                tb.aorimage_rankBg.SpriteName = "ui_di_dikuang"
                tb.aorimage_rankBg:SetRectTransformSize(682, 116)
            else
                tb.aorimage_rankBg.SpriteName = "TY_img_kuang"
                tb.aorimage_rankBg:SetRectTransformSize(680, 116)
            end
        end
    end
    if data then
        tb.obj_noBody:SetActiveE(0)
        tb.obj_content:SetActiveE(1)
        tb.aortext_name.text = data.guild_name
        tb.aortext_power.text = _G.GameUtil.NumberToUnitWord(data.guild_power)
        tb.aortext_score.text = data.guild_score
        tb.aorrawimage_guildIcon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.banner].portrait)
        tb.aortext_server.text =
            _G.GetLangPackValue(90032100010, _G.ServerManager:GetInstance():GetServerNameByServerID(data.server_id))
        tb.uid = data.guild_uid
    else
        tb.obj_noBody:SetActiveE(1)
        tb.obj_content:SetActiveE(0)
    end
end

function SociatyBattleLeaguePrepareView:SetEndTime()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.time = 0
    self.go_table.aortext_time.text = self.endTimeStr .. _G.TimeUtil.GiftPackGroupTime(_G.Mathf.RoundToInt(self.time))
end

function SociatyBattleLeaguePrepareView:UpdateTime(elapsed)
    self.time = self.time - elapsed
    if self.time <= 0 then
        self:SetEndTime()
    else
        self.go_table.aortext_time.text =
            self.endTimeStr .. _G.TimeUtil.GiftPackGroupTime(_G.Mathf.RoundToInt(self.time))
    end
end

---奖励展示
function SociatyBattleLeaguePrepareView:SetReward()
    local rankids = _G.ConfigManager.guild_league_season_cfg[self.SeasonId].rank
    local rewards = {}
    for i, v in ipairs(rankids) do
        _G.table.insert(rewards, _G.ConfigManager.arena_rank_cfg[v].reward_daily[1])
    end
    for i = 1, #rewards do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            rewards[i],
            self.go_table["obj_itemRoot" .. i],
            function(item)
                if _G.IsNil(self.go_table) then
                    _G.DestroyObject(item.gameObject)
                    return
                end
                if item.ShowNumText then
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
            end
        )
    end
end

function SociatyBattleLeaguePrepareView:OnStartClose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---界面的销毁函数
function SociatyBattleLeaguePrepareView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

function SociatyBattleLeaguePrepareView:OnClickRank(go, isOn, tb)
    if tb.uid then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyInfoPreviewView.Name, tb.uid)
    end
end

---按钮点击事件在这里派发
function SociatyBattleLeaguePrepareView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_Rank then
        --排行
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleLeagueTopRankView.Name)
    elseif go == self.go_table.aorbtn_rule then
        --规则
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleLeagueInfoView.Name)
    elseif go == self.go_table.aorbtn_gift then
        --礼包
        SociatyBattleLeagueModel:GetInstance():OpenGiftView()
        self:Close()
    end
end

return SociatyBattleLeaguePrepareView
