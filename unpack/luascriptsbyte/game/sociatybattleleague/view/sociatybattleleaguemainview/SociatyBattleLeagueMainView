---关闭buff界面
function SociatyBattleLeagueMainView:CloseBuff()
    self.go_table.obj_buffList:SetActiveE(0)
    self.go_table.obj_clickBuffOther:SetActiveE(0)
end

function SociatyBattleLeagueMainView:OnStartClose()
    if self.portalTimer then
        self.portalTimer:Stop()
        self.portalTimer = nil
    end
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.timer1 then
        self.timer1:Stop()
        self.timer1 = nil
    end
    if self.tweer then
        self.tweer:Kill()
        self.tweer = nil
    end
    self:RemoveListener(_G.eSociatyBattleLeague.SociatyBattleBarrageStateChangeLeague, self.UpdateChatState)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ArenaPanelView.Name)
end

function SociatyBattleLeagueMainView:OnDestroy()
    require "SociatyBattleLeagueManager":GetInstance():TryToCloseBarrageView()
end

function SociatyBattleLeagueMainView:OnDisable()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SociatyBattleLeagueBarrageView.Name)
end

function SociatyBattleLeagueMainView:OnEnable()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.SociatyBattleLeagueBarrageView.Name)
end

return SociatyBattleLeagueMainView
