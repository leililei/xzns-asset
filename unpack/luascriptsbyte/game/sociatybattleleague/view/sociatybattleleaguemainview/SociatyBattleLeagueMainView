---点击据点
function SociatyBattleLeagueMainView:OnClickCampsite(go, _, id)
    local name = go:GetName()
    if name == "@_aorbtn_box" then
        local isGet = require "SociatyBattleLeagueModel":GetInstance():CheckBoxAward(id)
        local campsite = self.curCampsiteSociatyData:GetCampsiteData(id)

        if not isGet and campsite:GetHp() <= 0 then
            --TODO 点击宝箱领取
            local msg = {}
            msg.b_id = id
            require "SociatyBattleLeagueNet":GetInstance():GetBoxAward(
                msg,
                function(data)
                    if data.ack == 1 then
                        self.campsiteItemDic[id].aorimage_boxget:SetActiveE(1)
                        require "SociatyBattleLeagueModel":GetInstance().AwardBoxList[id] = true
                        _G.StorageManager:GetInstance():ReceiveAwardData(data)
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
                        self:UpdateSingleCampsite(id)
                        self:UpdateBoxInfo()
                    end
                end
            )
        else
            if campsite:GetHp() > 0 then
                _G.PopWindowManager:GetInstance():ShowAllTips(1001, _G.GetLangPackValue(90021800546))
            elseif isGet then
                _G.PopWindowManager:GetInstance():ShowAllTips(250158)
            end

            -- local pre
            -- for i = 1, #self.BoxCampsiteId do
            --     if self.BoxCampsiteId[i].id == id then
            --         pre = self.BoxCampsiteId[i].preview
            --     end
            -- end

            -- _G.UIManager:GetInstance():OpenWindow(
            --     _G.ConfigManager.ui_cfg.SocaityBattleLeagueBoxAwardPreView.Name,
            --     pre,
            --     isGet
            -- )
        end
    elseif name == "@_aorbtn_click" then
        local data = self.curCampsiteSociatyData:GetCampsiteData(id)

        if self.IsTemp then
            SociatyBattleLeagueModel:GetInstance():GetCampsiteDataTemp(
                self.curCampsiteSociatyData:GetSociatyInfoData().guild_uid,
                id,
                data:GetRoleInfo().uid,
                self.isSelf,
                function()
                    _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.SociatyBattleLeagueCampsiteView.Name,
                        data,
                        self.isSelf,
                        false,
                        self.IsTemp
                    )
                end
            )
        else
            if self.isMark then
                if data:GetType() == _G.SociatyBattleCampsiteType.Main then
                    local isAllZero = true

                    if not self.IsTemp then
                        require("SociatyBattleLeagueManager"):GetInstance():CheckCampsiteZero(
                            _G.SociatyBattleCampsiteType.Importance
                        )
                    end
                    if not isAllZero then
                        _G.PopWindowManager:GetInstance():ShowAllTips(250140)
                        return
                    end
                end
                if data:GetHp() > 0 then
                    SociatyBattleLeagueModel:GetInstance():OnMark(
                        self.enemySociatyData:GetSociatyInfoData().guild_uid,
                        id,
                        function()
                            self.isMark = false
                            self:UpdateCampsite()
                            if not self.isSelf and not SociatyBattleLeagueModel:GetInstance():CheckIsMark(id) then
                                _G.PopWindowManager:GetInstance():ShowAllTips(250139)
                            end
                        end
                    )
                end
            else
                self.curCampsiteId = id
                SociatyBattleLeagueModel:GetInstance():GetCampsiteData(
                    self.curCampsiteSociatyData:GetSociatyInfoData().guild_uid,
                    id,
                    data:GetRoleInfo().uid,
                    function()
                        _G.UIManager:GetInstance():OpenWindow(
                            _G.ConfigManager.ui_cfg.SociatyBattleLeagueCampsiteView.Name,
                            data,
                            self.isSelf,
                            false,
                            self.IsTemp
                        )
                    end
                )
            end
        end
    end
end

