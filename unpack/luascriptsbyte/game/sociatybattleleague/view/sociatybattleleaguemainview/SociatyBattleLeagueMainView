end

function SociatyBattleLeagueMainView:GetMoveEnd(isEnd)
    local x, y = self.go_table.trans_content:GetParent():GetRectTransformSize()
    local width = 1600 - y / 2
    local move = 0
    if not self.isSelf then
        local id = SociatyBattleLeagueModel:GetInstance().markid or 0
        if id > 0 then
            local campsite = self.curCampsiteSociatyData:GetCampsiteData(id)
            if campsite and campsite:GetHp() > 0 then
                local pos = tonumber(campsite.cfg.coordinate[2])
                if pos + 1600 > width / 2 then
                    move = 1600 + pos - width / 2 - 100
                else
                    move = 0
                end
            end
        end
    end
    return -move
end

