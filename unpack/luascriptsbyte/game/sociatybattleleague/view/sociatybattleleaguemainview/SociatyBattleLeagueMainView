function SociatyBattleLeagueMainView:SetMistySeasonEffect()
    local isMistyEffect = require "SociatyBattleLeagueModel":GetInstance().MistyEffect
    local mistyEffectIng = false
    if self.IsTemp then
        mistyEffectIng = isMistyEffect
    else
        mistyEffectIng = isMistyEffect and not self.isSelf
    end

    ---判断是不是有迷雾
    if mistyEffectIng then
        self.go_table.obj_MistyEffectBG:SetActiveE(1)
        if not self.go_table.mistyeffbg then
            self.go_table.mistyeffbg = 1
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_season_mist,
                self.go_table.obj_MistyEffectBG,
                function(obj)
                    if self:IsNil() then
                        _G.DestroyObject(obj)
                        return
                    end
                    self.go_table.mistyeffbg = obj
                end
            )
        end
    else
        self.go_table.obj_MistyEffectBG:SetActiveE(0)
    end

    local isSolidDefense = require "SociatyBattleLeagueModel":GetInstance().SolidDefense
    local solidDefense = false
    if self.IsTemp then
        solidDefense = isSolidDefense
    else
        solidDefense = isSolidDefense and not self.isSelf
    end

    ---判断是不是有迷雾
    if solidDefense then
        self.go_table.obj_soliddefenseeff:SetActiveE(1)
        if not self.go_table.solidDefense then
            self.go_table.solidDefense = 1
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_season_black,
                self.go_table.obj_soliddefenseeff,
                function(obj)
                    if self:IsNil() then
                        _G.DestroyObject(obj)
                        return
                    end
                    self.go_table.solidDefense = obj
                end
            )
        end
    else
        self.go_table.obj_soliddefenseeff:SetActiveE(0)
    end
end

---初始化数据
function SociatyBattleLeagueMainView:InitData()
    if self.IsTemp then
        self.selfSociatyData = SociatyBattleLeagueModel:GetInstance():GetSelfScoaityDataTemp()
        self.enemySociatyData = SociatyBattleLeagueModel:GetInstance():GetEnemySociatyDataTemp()
    else
        self.selfSociatyData = SociatyBattleLeagueModel:GetInstance():GetSelfScoaityData()
        self.enemySociatyData = SociatyBattleLeagueModel:GetInstance():GetEnemySociatyData()
    end
    self.curCampsiteSociatyData = self.isSelf and self.selfSociatyData or self.enemySociatyData
