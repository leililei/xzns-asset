        SociatyBattleLeagueModel:GetInstance():GetChallengeNum() ..
        "/" .. SociatyBattleLeagueModel:GetInstance().maxChallengeNum
end

function SociatyBattleLeagueMainView:BattleRefresh()
    self:UpdateGx()
    self:UpdateChallengeNum()
    self:UpdateSociaty()
    self:UpdateBuff()
    if self.go_table.obj_buff:GetActiveSelf() == 1 then
        self:OnBuff()
    end
    if self.curCampsiteId then
        self:UpdateSingleCampsite(self.curCampsiteId)
    end
    self:UpdateBoxInfo()
    self:UpdatePortal()

    local mainId = 1
    for key, value in pairs(_G.ConfigManager.guild_battle_campsite_cfg) do
        if value.type == _G.SociatyBattleCampsiteType.Main then
            mainId = key
            break
        end
    end
    ---刷新一下主城锁
    self:UpdateSingleCampsite(mainId)
end

