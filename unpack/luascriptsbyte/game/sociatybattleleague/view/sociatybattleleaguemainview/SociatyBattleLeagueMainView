---更新buff
function SociatyBattleLeagueMainView:UpdateBuff()
    self.buffDatas = self.selfSociatyData:GetBuffList()

    if not self.buffItemList then
        self.buffItemList = {}
        for i = 1, 3 do
            self.buffItemList[i] =
                _G.GetAutoGoTable(self.go_table["obj_skill" .. i], _G.handler(self, self.OnClickBuff))
        end
    end
    if nil == self.buffDatas then
        return
    end
    ---@type card_skills_cfg
    local cfg
    for i, v in ipairs(self.buffItemList) do
        cfg = _G.ConfigManager.card_skills_cfg[self.buffDatas[i]]
        if cfg then
            self.buffItemList[i].aorrawimage_icon:LoadImage(cfg.icon)
        end
        if self.enemySociatyData:CheckBuffIsActive(self.buffDatas[i]) then
            self.buffItemList[i].obj_mask:SetActiveE(1)
        else
            self.buffItemList[i].obj_mask:SetActiveE(0)
        end
    end
end

