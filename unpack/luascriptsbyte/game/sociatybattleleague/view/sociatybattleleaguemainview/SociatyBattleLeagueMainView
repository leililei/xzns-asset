function SociatyBattleLeagueMainView:UpdatePortal()
    if SociatyBattleLeagueModel:GetInstance():CheckPortalSeason() then
        self.PortalSyTime = 0
        local time = SociatyBattleLeagueModel:GetInstance():GetPortalTime(self.isSelf, self.IsTemp)
        if time > 0 and (time - _G.TimeUtil.GetServerUnixTime()) > 0 then
            self.PortalSyTime = time - _G.TimeUtil.GetServerUnixTime()
        end
        
        self.go_table.aorbtn_portal:SetActiveE(1)

        if self.PortalSyTime > 0 then
            self:ShowPortalNotDedel(false)
            local time = _G.GetLangPackValue(90032100104, TimeToString(self.PortalSyTime, 2))
            self.go_table.aortext_portaltime.text = time
            if self.portalTimer then
                self.portalTimer:Stop()
                self.portalTimer = nil
            end
            self.portalTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdatePortalTime, self, false, false, true)
            self.portalTimer:Start()
        else
            self.go_table.aortext_portaltime.text = _G.GetLangPackValue(90032100103)
            self:ShowPortalNotDedel(true)
        end
    else
        self.go_table.aorbtn_portal:SetActiveE(0)
    end
end

