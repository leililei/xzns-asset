---更改
function SociatyBattleLeagueMainView:OnChange()
    self.isSelf = not self.isSelf
    if self.tweer then
        self.tweer:Kill()
        self.tweer = nil
    end
    self:InitData()
    self:UpdateCampsite()
    self:UpdateBoxInfo()
    self:UpdatePortal()
    self:UpdateBtnShow()
    self:InitBattleEffect()
    local pos = self:GetMoveEnd(true)
    if not self.ScrollRect then
        self.ScrollRect =
            self.go_table.trans_content:GetParent():GetParent():GetComponentE(
                _G.typeof(_G.CS.UnityEngine.UI.ScrollRect)
            )
    end
    self.ScrollRect:StopMovement()
    --self.go_table.trans_content:SetAnchorPosition(-pos, 0, 0)
