    self.tweer = self.go_table.trans_content:DOAnchorPosX(0, 0.3 * math.abs(pos - x) / 1600)
    self.tweer.onComplete = function()
        self.tweer = nil
    end
end

---获取排行数据
function SociatyBattleLeagueMainView:OnGetRankInfo()
    require "SociatyBattleLeagueModel":GetInstance():GetRoleRank(
        function(msg)
            if msg.ack == 1 then
                self.totalScore = 0
                self.MySelfRankInfo = {}
                self.MySelfRankInfo.index = 0
                self.MySelfRankInfo.score = 0

                if nil == msg.rank then
                    msg.rank = {}
                end
                for i = 1, #msg.rank do
                    if msg.rank[i] then
                        if msg.rank[i].uid == _G.PlayerModel:GetInstance().role_uid then
                            self.MySelfRankInfo = msg.rank[i]
                            self.MySelfRankInfo.index = i
                        end
                        self.totalScore = self.totalScore + msg.rank[i].score
                    end
                end
                self:UpdateRank(msg)
            end
        end
    )
end

---刷新开牌排行榜展示
---@param rankPb rank.s2c_rank_activity_lucky_draw
function SociatyBattleLeagueMainView:UpdateRank(rankPb)
    ---@type DrawUpMainView._obj_myrankItem_GoTable
    local myGoTable = _G.GetAutoGoTable(self.go_table.obj_myrankItem)
    local playerModel = _G.PlayerModel:GetInstance()
    myGoTable.aortext_rankname.text = playerModel:GetName()
    local myRank = self.MySelfRankInfo.index
    if myRank >= 1 and myRank <= 3 then
        myGoTable.aorimage_rankIcon:SetActiveE(1)
        myGoTable.aortext_rankscore:SetActiveE(0)
        myGoTable.aortext_rankno:SetActiveE(0)
        myGoTable.aorimage_rankIcon:LoadSprite(string.format("tz_qjhs_phb_mingci_0%d", myRank))
    elseif self.MySelfRankInfo.score == 0 then
        myGoTable.aorimage_rankIcon:SetActiveE(0)
        myGoTable.aortext_rankscore:SetActiveE(0)
        myGoTable.aortext_rankno:SetActiveE(1)
    else
        myGoTable.aorimage_rankIcon:SetActiveE(0)
        myGoTable.aortext_rankscore:SetActiveE(1)
        myGoTable.aortext_rankno:SetActiveE(0)
        myGoTable.aortext_rankscore.text = (myRank == 0 or myRank > 1000) and "1000+" or myRank
    end

    if self.totalScore > 0 then
        myGoTable.aortext_rankbl.text =
            "积分占比:" .. _G.string.format("%.0f%%", self.MySelfRankInfo.score / self.totalScore * 100)
    else
        myGoTable.aortext_rankbl.text = ""
    end

    if rankPb and rankPb.rank then
        self.rankInfo = rankPb
    else
        self.rankInfo = { rank = {} }
    end
    if not self.rankScroll then
        self.go_table.scrollloopvectical_rankList:InitItemData(3, _G.handler(self, self.UpdateRankItem))
        self.rankScroll = self.go_table.scrollloopvectical_rankList
    else
        self.rankScroll:UpdateCount(3)
    end
end

function SociatyBattleLeagueMainView:UpdateRankItem(csIndex, obj)
    if csIndex < 0 then
        return
    end
    local luaIndex = csIndex + 1
    ---@type DrawUpMainView._obj_rankItem_GoTable
    local goTable = _G.GetAutoGoTable(obj)
    local rankInfo = self.rankInfo.rank[luaIndex]
    local posRank = luaIndex
    if posRank >= 1 and posRank <= 3 then
        goTable.aortext_rankscore:SetActiveE(0)
        goTable.aorimage_rankIcon:SetActiveE(1)
        goTable.aorimage_rankIcon:LoadSprite(string.format("tz_qjhs_phb_mingci_0%d", posRank))
    else
        goTable.aorimage_rankIcon:SetActiveE(0)
        goTable.aortext_rankscore:SetActiveE(1)
        goTable.aortext_rankscore.text = _G.GetLangPackValue(90023300031, posRank)
    end
    if rankInfo and rankInfo.uid > 0 and self.totalScore > 0 then
        goTable.aortext_rankname.text = rankInfo.name
        goTable.aortext_rankbl.text = "积分占比:" .. _G.string.format("%.0f%%", rankInfo.score / self.totalScore * 100)
    else
        goTable.aortext_rankname.text = _G.GetLangPackValue(90022300109)
        goTable.aortext_rankbl.text = ""
    end
end

---展示积分奖励
function SociatyBattleLeagueMainView:OnShowScoreAward()
    if self.ScoreAwardToggle == nil then
        self.ScoreAwardToggle = {}
        for i = 1, 3 do
            self.ScoreAwardToggle[i] = _G.GetAutoGoTable(self.go_table["aorbtn_type" .. i])
        end
    end
    for i = 1, 3 do
        self.ScoreAwardToggle[i].aorimage_isOn:SetActiveE(self.ScoreAwardIndex == i and 1 or 0)
    end
    if self.ScoreAward == nil then
        self.ScoreAward = {}
        for _, v in pairs(_G.ConfigManager.guild_league_campsite_cfg) do
            if self.ScoreAward[v.type] == nil then
                self.ScoreAward[v.type] = v.points
            end
        end
    end
    if not self.scoreScroll then
        self.go_table.scrollloopvectical_scoreAward:InitItemData(
            #self.ScoreAward[self.ScoreAwardType[self.ScoreAwardIndex]],
            _G.handler(self, self.UpdateScoreAwardItem)
        )
        self.scoreScroll = self.go_table.scrollloopvectical_scoreAward
    else
        self.scoreScroll:UpdateCount(#self.ScoreAward[self.ScoreAwardType[self.ScoreAwardIndex]])
    end
end

function SociatyBattleLeagueMainView:UpdateScoreAwardItem(csIndex, obj)
    if csIndex < 0 then
        return
    end
    ---@type DrawUpMainView._obj_scoreItem_GoTable
    local goTable = _G.GetAutoGoTable(obj)
    local scoreInfo = self.ScoreAward[self.ScoreAwardType[self.ScoreAwardIndex]]
    local index = #scoreInfo - csIndex
    local data = scoreInfo[index]
    goTable.aortext_name.text = _G.GetLangPackValue(90032100052, (index - 1))
    goTable.aortext_score.text = data[1] .. _G.GetLangPackValue(90001004301)
end

