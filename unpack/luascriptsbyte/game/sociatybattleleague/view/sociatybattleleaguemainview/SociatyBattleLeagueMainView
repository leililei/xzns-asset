---显示buff
function SociatyBattleLeagueMainView:OnBuff()
    if not self.buffDetilItemList then
        self.buffDetilItemList = {}
    end
    ---@type card_skills_cfg
    local cfg
    for i, v in ipairs(self.buffDatas) do
        if not self.buffDetilItemList[i] then
            self.buffDetilItemList[i] =
                _G.GetAutoGoTable(_G.InstantiateObject(self.go_table.obj_buff, self.go_table.trans_bg))
            cfg = _G.ConfigManager.card_skills_cfg[v]
            if cfg then
                self.buffDetilItemList[i].aorrawimage_icon:LoadImage(cfg.icon)
                self.buffDetilItemList[i].aortext_name.text = _G.GetLangPackValue(cfg.name1)
                self.buffDetilItemList[i].aortext_content.text = _G.GetLangPackValue(cfg.describe1)
            end

            self.buffDetilItemList[i].gameObject:SetActiveE(1)
        end
        if self.enemySociatyData:CheckBuffIsActive(v) then
            self.buffDetilItemList[i].aortext_state.text = _G.string.AddColor(GetLangPackValue(90021800319), "ff5656")
        else
            self.buffDetilItemList[i].aortext_state.text = GetLangPackValue(90021800320)
        end
    end
    self.go_table.obj_buffList:SetActiveE(1)
    self.go_table.obj_clickBuffOther:SetActiveE(1)
end

