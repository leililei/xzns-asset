---转盘
function WheelOfFortuneView:Move(index_sure, call)
    if self.TimeMove ~= nil then
        self.TimeMove:Stop()
    end
    local StarCount = _G.table.count(self.pool)
    if self.index == 0 then
        self.index = _G.math.random(1, StarCount)
    end

    self.index = index_sure - 100
    ---根据服务器随的五行 1-6  与显示最终结果的误差
    local diff = -self.index + (index_sure - 100)
    ---一开始全闪次数
    ---最大切换次数
    local MaxCount = StarCount * 3 + diff
    ---开始减速次数
    local subCount = StarCount * 2 + 5 + diff
    local intervalTime = 0.1
    local interval = 0
    local Count = 0

    self.TimeMove =
        _G.TimerManager:GetInstance():GetFixedTimer(
        intervalTime,
        function()
            if Count == MaxCount then
                self.TimeMove:Stop()
                call()
                return
            end

            if Count > subCount and interval < intervalTime * (Count - subCount) then
                interval = interval + intervalTime
                return
            end
            interval = 0
            Count = Count + 1

            self.index = self.index + 1
            if self.index > StarCount then
                self.index = 1
            end
            self:SetShowElementMask(self.index)
        end,
        self,
        false,
        false
    )
    self.TimeMove:Start()
end
---显示亮起
function WheelOfFortuneView:SetShowElementMask(element)
    for i = 1, #self.selectMaskEleArr do
        self.selectMaskEleArr[i].aorimage_Leimask:SetActiveE(i ~= element and 0 or 1)
    end
end

--抽奖显示
function WheelOfFortuneView:ChouKaNum(num)
    local rmb = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.ResProp, self.ticket[1])
    if self.ticket[2] * num <= rmb then
        -- body
        self.Interactablebooi = false
        self:BianSe()
        WheelOfFortuneModel:ZhaoMu(
            {draw_num = num},
            function(data)
                _G.StorageManager:GetInstance():ConsumeItem(self.ticket[1], nil, self.ticket[2] * num)
                self.go_table.aorbtn_mask:SetActiveE(1)
                self:Move(
                    data.draw_id[1],
                    function()
                        require("RedPointManager"):GetInstance():RefreshNode(
                            _G.ConfigManager.redpoint_cfg.WheelOfFortune.id
                        )
                        _G.StorageManager:GetInstance():ReceiveAwardData(data)
                        _G.UIManager:GetInstance():OpenWindow(
                            _G.ConfigManager.ui_cfg.CommonAwardView.Name,
                            data,
                            nil,
                            true
                        )
                        self:HongDianXianShi()
                        self.Interactablebooi = true
                        self:BianSe()
                        self.go_table.aorbtn_mask:SetActiveE(0)
                    end
                )
                WheelOfFortuneModel.draw_num = WheelOfFortuneModel.draw_num + num
                self:XianShiNew()
            end
        )
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(620104)
    end
end

function WheelOfFortuneView:CloseVideo()
    if self.TimeMove ~= nil then
        self.TimeMove:Stop()
    end
end

---界面的入口函数
function WheelOfFortuneView:Create()
    self.Createbooi = false
    self.itemList = {}
    self.go_table.scrollloopvectical_AwardList:InitItemData(#self.pool, _G.handler(self, self.RefreshList))
    --self.go_table.scrollloopvectical_AwardList:UpdateCount(#self.pool)
end

function WheelOfFortuneView:RefreshList(index, obj)
    local instanceID = obj:GetInstanceIDE()
    local tb = _G.GetAutoGoTable(obj)
    local data = self.season_turntable_con_cfg[self.pool[index + 1][1]]
    if not data then
        return
    end
    self:tanQuanDian(data.item, obj)
    tb.aortext_probNum.text = (self.pool[index + 1][2] / 100) .. "%"
end

---物品内容选中显示
function WheelOfFortuneView:tanQuanDian(data, Parent)
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        data,
        Parent,
        function(item)
            item.gameObject:SetLocalScaleXYZ(1)
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
            item:SetGrade(true)

            -- _G.DelayDo(
            --     1,
            --     function()
            --         -- body
            --     end
            -- )
            item.gameObject:SetLocalPosition(0, 15, 0)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end,
        function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data[1])
        end
    )
end

function WheelOfFortuneView:BianSe()
    self.go_table.aorbtn_choJiang_10.enabled = self.Interactablebooi
    self.go_table.aorbtn_choJiang_1.enabled = self.Interactablebooi
    --self.go_table.aorbtn_choJiang_10.interactable = self.Interactablebooi
    --self.go_table.aorbtn_choJiang_1.interactable = self.Interactablebooi
end

---按钮点击事件在这里派发
function WheelOfFortuneView:OnClickBtn(go, isOn)
    if go == nil then
        return
    end
    local name = go:GetName()

    if name == "@_aorbtn_Close" then
        if self.TimeMove ~= nil then
            self.TimeMove:Stop()
        end
        self:Close()
    elseif name == "@_aorbtn_gailv" then
        self.go_table.aorbtn_shadow:SetActiveE(1)

        if self.Createbooi then
            self:Create()
        end
    elseif name == "@_aorbtn_close" then
        self.go_table.aorbtn_shadow:SetActiveE(0)
    elseif name == "@_aorbtn_choJiang_10" then
        local rmb = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.ResProp, self.ticket[1])

        local num = 10
        if num > rmb then
            num = rmb
        end
        if num <= 1 then
            _G.PopWindowManager:GetInstance():ShowAllTips(620104)
            return
        end
        self:ChouKaNum(num)
    elseif name == "@_aorbtn_choJiang_1" then
        self:ChouKaNum(1)
    end
end

return WheelOfFortuneView
