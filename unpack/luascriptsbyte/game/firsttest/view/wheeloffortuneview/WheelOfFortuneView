function WheelOfFortuneView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    if not _G.IsNil(self.go_table.obj_GoldInfo) and self.go_table.obj_GoldInfo:GetctiveInHierarchy() == 1 then
        self:AddComponent(
            self.go_table.obj_GoldInfo,
            require("ResourceCompont").New(
                self.go_table.obj_GoldInfo,
                _G.ConfigManager.ui_cfg.WheelOfFortuneView.resources
            )
        )
    end
    local ID = require "SeasonModel":GetInstance():GetCurSeasonId() + 100
    self.season_turntable_cfg = _G.ConfigManager.season_turntable_cfg
    --转盘目标奖励
    self.rewards_goal = self.season_turntable_cfg[ID].rewards_goal
    --内容库(内容id#权重）
    self.pool = self.season_turntable_cfg[ID].pool
    --单抽消耗道具和数量
    self.ticket = self.season_turntable_cfg[ID].ticket
    ---底部七个按钮接口
    self.item = {}
    self.selectEleArr = {}
    self.selectMaskEleArr = {}
    ---当前亮起属性
    self.index = 0
    ---服务器随的属性
    self.index_sure = 0
    self.season_turntable_con_cfg = _G.ConfigManager.season_turntable_con_cfg
    self.season_turntable_goal_cfg = _G.ConfigManager.season_turntable_goal_cfg
    -- WheelOfFortuneModel:GetDataFormServer(_G.handler(self, self.XianShiNew))
    self:XianShiNew()
    self:ShengChengitem()
    self:HongDianXianShi()
    self.Createbooi = true
    self.Interactablebooi = true
end

--显示刷新
function WheelOfFortuneView:XianShiNew()
    self.go_table.aortext_num.text = WheelOfFortuneModel.draw_num
    self:JinDu()

    self:LiBaoNew()
end

---进度条显示
function WheelOfFortuneView:JinDu()
    local maxNum = self.season_turntable_goal_cfg[self.rewards_goal[_G.table.count(self.rewards_goal)]].times

    if WheelOfFortuneModel.draw_num == 0 then
        self.go_table.aorimage_activeSchedule:SetRectTransformSize(0, 7)
    elseif WheelOfFortuneModel.draw_num < maxNum then
        --self.go_table.slider_progress.value = _G.math.min(WheelOfFortuneModel.draw_num / maxNum, 2)
        self:JinDuXianShi(maxNum, WheelOfFortuneModel.draw_num)
    elseif WheelOfFortuneModel.draw_num >= maxNum * (WheelOfFortuneModel.cost_num + 1) then
        -- self.go_table.slider_progress.value = 1
        self.go_table.aorimage_activeSchedule:SetRectTransformSize(850, 7)
    else
        -- self.go_table.slider_progress.value =
        --     _G.math.min( / maxNum, 2)
        self:JinDuXianShi(maxNum, _G.math.modf(WheelOfFortuneModel.draw_num % maxNum))
    end
end

---进度值判断
function WheelOfFortuneView:JinDuXianShi(maxNums, draw_num)
    local xianshi = 0
    local num = 101
    local maxNum = 102
    local xians = true
    local i = 1
    if draw_num < self.season_turntable_goal_cfg[num].times then
        draw_num = self.season_turntable_goal_cfg[num].times
    end
    for key, value in pairs(self.rewards_goal) do
        if self.season_turntable_goal_cfg[value].times > draw_num and xians then
            num = value - 1
            maxNum = value
            i = key - 1
            xians = false
        elseif self.season_turntable_goal_cfg[self.rewards_goal[_G.table.count(self.rewards_goal)]].times == draw_num then
            num = value
            maxNum = value
            i = key
        end
    end
    local ChaMax = self.season_turntable_goal_cfg[maxNum].times - self.season_turntable_goal_cfg[num].times

    local cha = draw_num - self.season_turntable_goal_cfg[num].times
    if num == 101 then
        xianshi = cha / ChaMax * 100
    elseif num > 103 then
        xianshi = cha / ChaMax * 100
    else
        xianshi = cha / ChaMax * 150
    end
    xianshi = xianshi + ((i - 1) * 150)
    self.go_table.aorimage_activeSchedule:SetRectTransformSize(xianshi, 7)
end

--底部礼包刷新
function WheelOfFortuneView:LiBaoNew()
    for i = 1, 7 do
        local uid = self.rewards_goal[i]

        if self.item[i] == nil then
            local name = "obj_award"

            local goal = self.season_turntable_goal_cfg[uid]
            local item = self.go_table[name .. i]

            local tb = _G.GetAutoGoTable(item, _G.handlerbind(self, self.ButDian, i))

            self.item[i] = tb
            tb.aortext_day.text = goal.times .. _G.ConfigManager.language_package_cfg[90025800011]
            tb.aortext_num.text = goal.rewards[1][2]
            local icon
            if _G.ConfigManager.item_cfg[goal.rewards[1][1]] ~= nil then
                icon = _G.ConfigManager.item_cfg[goal.rewards[1][1]].Icon
            else
                icon = _G.ConfigManager.currency_type_cfg[goal.rewards[1][1]].icon
            end
            tb.aorrawimage_icon:LoadImage(
                icon,
                function(image)
                    if image then
                        image:SetActiveE(1)
                    end
                end
            )

            self:XunaZhoLingQu(tb, uid)
        else
            self:XunaZhoLingQu(self.item[i], uid)
        end
    end
end
--选中光圈和已领取
function WheelOfFortuneView:XunaZhoLingQu(tb, id)
    local maxNum = self.season_turntable_goal_cfg[self.rewards_goal[_G.table.count(self.rewards_goal)]].times
    local draw_num = WheelOfFortuneModel.draw_num - (WheelOfFortuneModel.cost_num * maxNum)
    local goal = self.season_turntable_goal_cfg[id]

    tb.obj_gou:SetActiveE(0)
    tb.aorimage_pan:SetActiveE(0)
    if self:ListPanDuna(id) then
        tb.obj_gou:SetActiveE(1)
        tb.aortext_day.text = goal.times .. _G.ConfigManager.language_package_cfg[90025800011]
    elseif draw_num >= self.season_turntable_goal_cfg[id].times then
        tb.aorimage_pan:SetActiveE(1)
        tb.aortext_day.text =
            "<color=#fede88>" .. goal.times .. _G.ConfigManager.language_package_cfg[90025800011] .. "</color>"
    end
end

---底部按钮点击
function WheelOfFortuneView:ButDian(_, _, index)
    if self.Interactablebooi then
        -- body

        local maxNum = self.season_turntable_goal_cfg[self.rewards_goal[_G.table.count(self.rewards_goal)]].times
        local draw_num = WheelOfFortuneModel.draw_num - (WheelOfFortuneModel.cost_num * maxNum)
        local uid = self.rewards_goal[index]
        local tb = self.item[index]
        if not self:ListPanDuna(uid) and draw_num >= self.season_turntable_goal_cfg[uid].times then
            WheelOfFortuneModel:LingQuaward(
                {id = uid},
                function()
                    if _G.table.count(WheelOfFortuneModel.award_list) >= _G.table.count(self.rewards_goal) then
                        WheelOfFortuneModel.award_list = {}
                        WheelOfFortuneModel.cost_num = WheelOfFortuneModel.cost_num + 1
                        self:XianShiNew()
                    else
                        self:XunaZhoLingQu(tb, uid)
                    end
                    require("RedPointManager"):GetInstance():RefreshNode(
                        _G.ConfigManager.redpoint_cfg.WheelOfFortune.id
                    )
                end
            )
        else
            require("CommonTipManager"):GetInstance():OpenTip(
                tb.gameObject,
                self.season_turntable_goal_cfg[uid].rewards[1][1]
            )
        end
    end
end

function WheelOfFortuneView:ListPanDuna(num)
    for key, value in pairs(WheelOfFortuneModel.award_list) do
        if value == num then
            return true
        end
    end

    return false
end

---生成转盘
function WheelOfFortuneView:ShengChengitem()
    local name = "obj_xuanzhong_"
    for i = 1, 10 do
        local item = self.go_table[name .. i]

        local tb = _G.GetAutoGoTable(item, _G.handlerbind(self, self.ButDianzhuanPan, i))
        if self.pool[i] == nil then
            tb.gameObject:SetActiveE(0)
        else
            local uid = self.pool[i][1]

            local goal = self.season_turntable_con_cfg[uid]

            self.selectMaskEleArr[i] = tb
            tb.aorimage_Leimask:SetActiveE(0)
            tb.obj_eff:SetActiveE(0)
            if goal.order == 1 then
                tb.obj_eff:SetActiveE(1)
            end
            tb.aortext_num.text = goal.item[2]
            local icon
            if _G.ConfigManager.item_cfg[goal.item[1]] ~= nil then
                icon = _G.ConfigManager.item_cfg[goal.item[1]].Icon
            else
                icon = _G.ConfigManager.currency_type_cfg[goal.item[1]].icon
            end
            tb.aorrawimage_Lei:LoadImage(
                icon,
                function(image)
                    if image then
                        image:SetActiveE(1)
                    end
                end
            )
        end
    end

    local images = _G.ConfigManager.currency_type_cfg[self.ticket[1]].icon
    self.go_table.aorrawimage_PropRight1:LoadImage(
        images,
        function(image)
            if image then
                image:SetActiveE(1)
            end
        end
    )
    self.go_table.aorrawimage_PropRight10:LoadImage(
        images,
        function(image)
            if image then
                image:SetActiveE(1)
            end
        end
    )
    self.go_table.aortext_time.text =
        require "SeasonManager":GetInstance():FormatTime(
        require "SeasonModel":GetInstance().timeData.startTime,
        _G.ConfigManager.season_cfg[require "SeasonModel":GetInstance():GetCurSeasonId()].duration * 86400
    )
end
