function PingDingLingYu:GetHeadPoint()
    if _G.IsNil(self.RolePoint) then
        return nil
    end
    if _G.IsNil(self.RolePoint.Point_Hp) then
        if _G.IsNil(self.RolePoint.Point_Head) then
            return nil
        else
            return self.RolePoint.Point_Head:GetPosition()
        end
    end
    return self.RolePoint.Point_Hp:GetPosition()
end
function PingDingLingYu:RefreshList(index, obj)
    if index < 0 then
        return
    end
    local x = index + 1
    local Data = self.Info[x]
    local itemGoTable = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.ClickChapter, x, obj))
    itemGoTable.Data = Data
    itemGoTable.Index = x
    if not self.ItemList[x] then
        self.ItemList[x] = itemGoTable
    end
    self:SetParent(x ~= self.Index, itemGoTable)
    self:SetAward(itemGoTable)
    return obj
end
function PingDingLingYu:SetAward(goTable)
    local data = goTable.Data
    local afkCfg = _G.ConfigManager.afk_cfg[rank_cfg[data.sid].params]
    goTable.aorimage_boss.SpriteName = BossIconPath .. data.boss_preview
    _G.GameUtil.SetActiveByCondition(goTable.aorimage_stDone, data.all_award > 0)
    goTable.aortext_ChapterName.text = _G.LangUtil.GetLangPackValue(90025800004, afkCfg.chapter)
    goTable.aortext_Section.text = afkCfg.chapter .. "-" .. afkCfg.section
    goTable.obj_redpoint:UpdateRedPointItemIDAndParam(self.activity.typeClass:GetRedpointIDByIndex(2), data.sid)
end
---@param type boolean true st false qt
---@param data activity_afk_cfg.rewards_all or activity_afk_cfg.rewards_first
---@param state GetState
function PingDingLingYu:CreateItem(data, parent, state, type)
    if _G.table.isEmptyOrNil(data) then
        return
    end
    if parent:GetChildCountE() > 0 then
        for i = 1, parent:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(parent:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    for k, v in pairs(data) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            v,
            parent,
            function(item)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                if item.SetGradeNew then
                    item:SetGradeNew(false)
                end
            end,
            function(go, isOn)
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, v[1])
            end
        )
    end
    if type then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_isSted, state == 3)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_isStGet, state == 2)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_stGet, state == 1 or state == 0)
        if state == 0 then
            self.go_table.aortext_StTxt.text = _G.LangUtil.GetLangPackValue(90025800006)
            self.go_table.aorbtn_stGet:SetGray(true)
            self.go_table.aortext_StTxt.color = GetBtnColor.notU.textColor
        elseif state == 1 then
            self.go_table.aortext_StTxt.text = _G.LangUtil.GetLangPackValue(90000010016)
            self.go_table.aorbtn_stGet:SetGray(false)
            self.go_table.aortext_StTxt.color = GetBtnColor.Get.textColor
        end
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_isQtGet, state == 2)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_qtGet, state == 1 or state == 0)

        if state == 0 then
            self.go_table.aortext_QtTxt.text = _G.LangUtil.GetLangPackValue(90025800006)
            self.go_table.aorbtn_qtGet:SetGray(true)
            self.go_table.aortext_QtTxt.color = GetBtnColor.no.textColor
        elseif state == 1 then
            self.go_table.aortext_QtTxt.text = _G.LangUtil.GetLangPackValue(90000010016)
            self.go_table.aorbtn_qtGet:SetGray(false)
            self.go_table.aortext_QtTxt.color = GetBtnColor.Get.textColor
        end
    end
end
function PingDingLingYu:ClickChapter(go, ref, index, obj)
    if self.Index == index then
        return
    end
    self:SetParent(true, self.ItemList[self.Index])
    self.Index = index
    local tb = _G.GetAutoGoTable(obj)
    self:SetParent(false, tb)
    self:SetAwardInfo()
    self:CreateRole()
end
---@param type boolean  normal true big false
function PingDingLingYu:SetParent(_type, tb)
    if not tb then
        return
    end
    local info = _type and ItemSize.normal or ItemSize.big
    tb.obj_bg:SetRectTransformSize(info.x, info.y)
    tb.aortext_ChapterName.color = info.ChapterColor
    tb.aortext_Section.color = info.SectionColor
    tb.obj_root:SetLocalScaleXYZ(info.scale)
    if not _type then
        tb.transform:SetAsLastSiblingE()
    end
end

---@param elapsed number
function PingDingLingYu:XianShiTime(elapsed)
    self.residueTime = self.residueTime - elapsed
    local time = Mathf.RoundToInt(self.residueTime)
    if self.residueTime <= 0 then
        if self.Timer_end ~= nil then
            self.Timer_end:Stop()
            self.Timer_end = nil
        end
        return
    end
    self.go_table.aortext_Time.text = _G.TimeUtil.TransDayHourMineMiao(self.residueTime)
end
function PingDingLingYu:DisposeReource()
    if self.roleTrans then
        _G.PoolsManager:GetInstance():Despawn(self.roleTrans, _G.ePoolType.Temporary)
    end
    _G.PoolsManager:GetInstance():Despawn(self.sceneTrans, _G.ePoolType.Temporary)
end
function PingDingLingYu:CloseView()
    if self.Timer_end ~= nil then
        self.Timer_end:Stop()
        self.Timer_end = nil
    end
    self:Close()
end
function PingDingLingYu:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:Close()
    elseif name == "@_aorbtn_stGet" then
        if self.data.role_award == 1 then
            require "PingDingLingYuModel":GetInstance():GetAward(
                self.Index,
                1,
                function()
                    self.go_table.aorbtn_stGet:SetActiveE(0)
                    self.go_table.aorimage_isStGet:SetActiveE(1)
                end
            )
        end
    elseif name == "@_aorbtn_qtGet" then
        if self.data.all_award == 1 then
            require "PingDingLingYuModel":GetInstance():GetAward(
                self.Index,
                2,
                function()
                    self.go_table.aorbtn_qtGet:SetActiveE(0)
                    self.go_table.aorimage_isQtGet:SetActiveE(1)
                end
            )
        end
    end
end
function PingDingLingYu:OnDisable()
    if self.sceneTrans then
        _G.GameUtil.SetActiveByCondition(self.sceneTrans, false)
    end
end
function PingDingLingYu:OnEnable()
    if self.sceneTrans then
        _G.GameUtil.SetActiveByCondition(self.sceneTrans, true)
        _G.GraphicsManager.Instance:UpdateMainCameraPosImmediate()
    end
end
return PingDingLingYu
