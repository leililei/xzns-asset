--加载角色
function PingDingLingYu:LoadRoleScene(rolepath, callback)
    self:RoleRecycle()
    require("CardInfoManager").GetRole(
        rolepath,
        _G.ePoolType.Temporary,
        self.sceneTrans,
        _G.RoleEffTypeEnum.Main,
        function(trans)
            if trans == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("角色无法加载 path:" .. rolepath .. "    CardInfoself LoadRoleScene")
                end
                return
            end
            if _G.IsNil(self.go_table) or self.CardData == nil or rolepath ~= self.CardData.ModelPathHi then
                _G.DestroyObject(trans)
                return
            end

            self.AnimComponent = _G.RoleAnimatorController.GetOrCreateAnimatorController(trans)
            _G.GameUtil.SetActiveByCondition(trans, false)
            trans:SetParentE(self.sceneTrans)

            trans:SetLocalPosition(0, 8000, 0)
            self.roleTrans = trans

            local card_show_cfg = _G.ConfigManager.card_show_cfg
            local myCard_show_cfg = card_show_cfg[self.CardData.id]
            local Scale = 1
            if myCard_show_cfg == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("card_show_cfg 未找到配置 sid:" .. self.CardData.id)
                end
            else
                self.myCard_show_cfg = myCard_show_cfg

                -- --设置  缩放
                Scale = myCard_show_cfg.Size1 > 0 and myCard_show_cfg.Size1 or 1
            end

            trans:SetLocalScaleXYZ(Scale)
            self.RolePoint = trans:GetComponentE(_G.typeof(_G.CS.RolePoint))
            if self.RolePoint then
                self.bip = self.RolePoint.Point_Chest
            else
                self.RolePoint = trans:AddComponentE(_G.typeof(_G.CS.RolePoint))
                self.RolePoint:FindAll()
                self.bip = self.RolePoint.Point_Chest
            end
            self:InitRotPos()
            if callback then
                callback(trans)
            end
        end
    )
end
function PingDingLingYu:RoleRecycle()
    if not _G.IsNil(self.roleTrans) then
        self:InitRotPos(true)
        if self.Timer_InitCard ~= nil then
            _G.coroutine.stopwaiting(self.Timer_InitCard)
            self.Timer_InitCard = nil
        end
        self.EfCardSid = 0
        self.EfDic = {}
        self.myCard_show_cfg = nil
        --如果之前对象有 则销毁之前的回调
        if self.AnimComponent ~= nil then
            _G.AnimatorPlayEndCallback.RemoveCallback(self.AnimComponent:GetInstanceIDE())
            self.AnimComponent = nil
        end
        if self.ActionEffArr ~= nil then
            for i = #self.ActionEffArr, 1, -1 do
                local efftran = table.remove(self.ActionEffArr, i)
                if _G.IsNil(efftran) == false then
                    _G.UIUtils.RemoveEffect(efftran, 1)
                end
            end
        end
        if self.ActionEffTempArr ~= nil then
            for i = #self.ActionEffTempArr, 1, -1 do
                local efftran = table.remove(self.ActionEffTempArr, i)
                if _G.IsNil(efftran) == false then
                    _G.UIUtils.RemoveEffect(efftran, 1)
                end
            end
        end
        self:ClearAudio()
        if self.LinesPath ~= nil then
            _G.AudioManager.Dialogue_StopPath(self.LinesPath)
        end
        self.IsPlayLines = false

        if self.roleTrans ~= nil then
            require("CardInfoManager").DelRole(self.roleTrans, _G.ePoolType.UIItem)
        end
        self.roleTrans = nil
    end
end
function PingDingLingYu:ClearAudio()
    if self.ActionAudioArr ~= nil then
        for path, value in pairs(self.ActionAudioArr) do
            _G.AudioManager.StopSoundByPath(path)
            self.ActionAudioArr[path] = nil
        end
    end
end
---@param soundCfg string 台词路径
function PingDingLingYu:AniPlay(name, effAll, isCall, audioCfg, soundPath)
    if self.AnimComponent ~= nil and self.IsAniPlaying == true or self.myCard_show_cfg == nil then
        return
    end

    local isHaveAni = self.AnimComponent:isHaveAni(name)
    if isHaveAni == false then
        name = self.myCard_show_cfg.display_idle
    end

    local nowPlayName = self.AnimComponent:getNowPlayName()
    if nowPlayName == name then
        return
    end
    -- --- 如果是第一次进入idle 则播场景特效
    -- if name == self.myCard_show_cfg.display_idle then
    --     self:LoadActionEff(self.myCard_show_cfg.display_alltime_ef)
    -- end

    self.oldAniName = name
    self.AnimComponent:Play(name, isCall)
    if _G.string.contains(name, "idle") == false then
        self.IsAniPlaying = true
    end

    --- 播音效
    self:ClearAudio()
    if _G.string.IsNullOrEmpty(audioCfg) == false then
        local path = audioCfg
        if path ~= nil then
            self.ActionAudioArr[path] = true
            _G.AudioManager.Dialogue_PlayPath(path)
        end
    end
    if _G.string.IsNullOrEmpty(soundPath) == false then
        local path = soundPath
        if path ~= nil then
            ---当前是否在播放
            self.IsPlayLines = true
            self.LinesPath = path
            _G.AudioManager.PlayPathBackFun(path, _G.handler(self, self.PlayLinesCallBack))
        end
    end

    --self:LoadActionEff(effAll)
end
function PingDingLingYu:PlayLinesCallBack()
    self.IsPlayLines = false
end
function PingDingLingYu:LoadActionEff(idArr)
    if idArr == nil or #idArr == 0 then
        return
    end

    local effcfg = _G.ConfigManager.card_effect_cfg

    for i = 1, #idArr do
        local id = idArr[i]
        local myEff = effcfg[id]
        if myEff == nil then
            if _G.AppSetting.DEBUG then
                _G.LogError(" card_effect_cfg 未找到id: " .. tostring(id))
            end
        else
            self:LoadFunc(myEff, self.sceneTrans)
        end
    end
end

---@param cfg card_effect_cfg
function PingDingLingYu:LoadFunc(cfg, parent, loadedCall)
    if self.roleTrans == nil then
        return
    end

    local pos = cfg.pos or {0, 0, 0}
    local scale = cfg.scale > 0 and cfg.scale or 1
    --region --------------------------------------当前特效 要隐藏的其他特效--------
    if #cfg.ef_false > 0 then
        for i = #cfg.ef_false, 1, -1 do
            local tranPath = cfg.ef_false[i]
            local efobj = self.roleTrans:FindE(tranPath)
            if efobj ~= nil then
                _G.GameUtil.SetActiveByCondition(efobj, false)
            end
        end
    end
    --endregion

    --region --------------------------------------如果加载过 或者本身有这特效--------
    local efTran = self.EfDic[cfg.id]
    if efTran ~= nil then
        ---  特效要隐藏在显示  确保动画重播
        _G.GameUtil.SetActiveByCondition(efTran, false)
        _G.GameUtil.SetActiveByCondition(efTran, true)
    else
        if string.IsNullOrEmpty(cfg.ef_point) == false then
            if cfg.ef_point == "1" then
                parent = self.roleTrans
            else
                parent = self.roleTrans:FindE(cfg.ef_point)
                if parent == nil then
                    if _G.AppSetting.DEBUG then
                        _G.LogError(cfg.id .. " 挂点路径未找到: " .. cfg.ef_point)
                    end
                    return
                end
            end
        end
        local efName
        if _G.string.contains(cfg.Ef_Path, "/") then
            efName = _G.string.split2tbl(cfg.Ef_Path, "/")
            efName = efName[#efName]
            local efobj = parent:FindE(efName)
            if _G.IsNil(efobj) == false then
                efobj:SetLocalPosition(pos[1], pos[2], pos[3])
                efobj:SetLocalScaleXYZ(scale)
                _G.GameUtil.SetActiveByCondition(efobj, false)
                _G.GameUtil.SetActiveByCondition(efobj, true)
                self.EfDic[cfg.id] = efobj
                if loadedCall ~= nil then
                    loadedCall()
                end
                --endregion
                return
            end
        end
        --- 否则 加载
        _G.UIUtils.LoadEffectByPath(
            cfg.Ef_Path,
            parent,
            function(tran)
                if cfg.lifeTime == 0 then
                    table.insert(self.ActionEffArr, tran)
                else
                    table.insert(self.ActionEffTempArr, tran)
                end
                self.EfDic[cfg.id] = tran
                if loadedCall ~= nil then
                    loadedCall()
                end
            end,
            nil,
            0,
            pos,
            scale,
            1,
            true
        )
    end
end
function PingDingLingYu:InitRotPos(isDel)
    if _G.IsNil(self.roleTrans) then
        return
    end

    self.EfDic = {}
    self.IsAniPlaying = false
    if self.co2 then
        self.entr = false
        _G.coroutine.stopwaiting(self.co2)
        self.co2 = nil
    end
    self.roleTrans:SetLocalEulerAngles(0, 0, 0)
    if isDel == true then
        -- --设置  缩放
        self.roleTrans:SetLocalScale(1, 1, 1)
    else
        --播放一次 初始化 RoleAnimatorController.cs--> animationTime
        _G.GameUtil.SetActiveByCondition(self.roleTrans, true)
        if self.myCard_show_cfg ~= nil and not string.IsNullOrEmpty(self.myCard_show_cfg.display_entr) then
            self.entr = true
            self.co2 = _G.coroutine.start(_G.handlerbind(self, self.CoTitleAndHolePosition))
        else
            --- 否则默认播放 idle配置
            self:PlayAniCallBack()
        end
        _G.AnimatorPlayEndCallback.AddCallback(
            self.AnimComponent:GetInstanceIDE(),
            _G.handler(self, self.PlayAniCallBack)
        )

        self.Timer_InitCard =
            _G.DelayFrameDo(
            function()
                local pos = {}
                if self.myCard_show_cfg ~= nil then
                    pos = self.myCard_show_cfg.pos
                end

                local x, y, z = pos[1] or 0, pos[2] or 0, pos[3] or 0
                if self.roleTrans ~= nil then
                    self.roleTrans:SetLocalPosition(x, y, z)
                end
            end
        )
    end
end
function PingDingLingYu:PlayAniCallBack(isShow)
    if _G.IsNil(self.roleTrans) or _G.IsNil(self.AnimComponent) then
        return
    end
    if self.co2 then
        _G.coroutine.stopwaiting(self.co2)
        self.entr = false
    end
    if self:IsNil() then
        return
    end
    self.IsAniPlaying = false
    --播放一次 初始化 RoleAnimatorController.cs--> animationTime
    if self.myCard_show_cfg ~= nil and not _G.string.IsNullOrEmpty(self.myCard_show_cfg.display_idle) then
        self:AniPlay(self.myCard_show_cfg.display_idle, self.myCard_show_cfg.display_idle_ef, true, nil, nil)
    end
end

function PingDingLingYu:LoadRole()
    self.data = self.Info[self.Index]
    ---@type skin_cfg
    self.CardData = require "CardCommentManager":GetInstance():GetCfgs(self.data.city_style)
    if self.sceneTrans == nil then
        self.sceneTrans = self.ResList["sceneTrans"]
        local environment =
            self.sceneTrans:GetComponentInChildren(_G.typeof(_G.CS.FrameWork.Environment.EnvironmentSetting))
        environment.SceneCamera.fieldOfView = 30 * _G.CS.Launcher.Inst.FovScale
        ---设置初始相机
        self.ControlCamera = _G.GraphicsManager.Instance.CurrentVisualCamera

        if self.CardData then
            self:LoadRoleScene(
                self.CardData.ModelPathHi,
                function(roleTrans)
                    self:SapwnTitle(_G.ConfigManager.player_title_effect_cfg[self.Info[self.Index].title])
                    self:SpawnHalo(_G.ConfigManager.player_halo_effect_cfg[self.Info[self.Index].halo_sid])
                    self:Init()
                end
            )
        else
            self:Init()
        end
    end
end
---生成光环
function PingDingLingYu:SpawnHalo(HaloData)
    if not _G.IsNil(self.Halo) then
        _G.PoolsManager:GetInstance():Despawn(self.Halo, _G.ePoolType.Temporary)
        self.Halo = nil
        self.curHalo = nil
    end
    if HaloData then
        self.curHalo = HaloData
        _G.PoolsManager:GetInstance():Spawn(
            HaloData.halo,
            _G.ePoolType.Temporary,
            self.roleTrans,
            function(trans)
                if _G.IsNil(self.roleTrans) then
                    _G.DestroyObject(trans)
                    return
                end
                self.Halo = trans
                self:SetHaloPos(HaloData.type_halo)
            end
        )
    end
end
---设置光环位置
function PingDingLingYu:SetHaloPos(type)
    if not _G.IsNil(self.Halo.gameObject) then
        if type == 2 then
            self.Halo:SetParentE(self.RolePoint.Point_Chest)
        else
            local scale = self.Halo:GetParent():GetLocalScale()
            self.Halo:SetLocalScaleXYZ(_G.ConfigManager.discrete_cfg[103901][1][1] / scale)
        end
        self.Halo:GetChildE(0):SetActiveE(1)
        self.Halo:SetEulerAngles(0, 0, 0)
        self.Halo:SetLocalPositionToZero()
    end
end

