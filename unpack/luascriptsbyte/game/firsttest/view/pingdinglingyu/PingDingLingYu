---@param deltaY number Y轴便宜值
function PingDingLingYu:SetTitlePos()
    if not _G.IsNil(self.Title.gameObject) then
        local x, y, z = self:GetHeadPoint()
        if x then
            local deltaY = _G.ConfigManager.discrete_cfg[103501][1][1]
            --  local x1, y1, z1 = self.sceneTrans:GetPosition()
            local s = self.Title.transform:GetLocalScale()
            local pos = {}
            pos.x = 0
            pos.z = 0
            pos.y = y + 0.1
            local scale = self.roleTrans:GetLocalScale()
            self.Title.gameObject:SetLocalScaleXYZ(0.8 / scale)
            self.Title.transform:SetPosition(pos.x, pos.y, pos.z)
            _G.WorldManager:GetInstance().CurrentWorld.WorldSetting:TranLookAtCamera(
                self.Title.transform,
                self.roleTrans
            )
            if not self.offsetTB[self.data.city_style] then
                local _1, y2, _2 = self.Title.gameObject:GetPosition()
                local _, y4 = self.bip:GetPosition()
                self.offsetTB[self.data.city_style] = y2 - y4
            end
            self.offset = self.offsetTB[self.data.city_style]
        end
    end
end
function PingDingLingYu:CoTitleAndHolePosition()
    if _G.IsNil(self.bip) then
        return
    end
    self:AniPlay(
        self.myCard_show_cfg.display_entr,
        self.myCard_show_cfg.display_entr_ef,
        true,
        self.myCard_show_cfg.audio_enter,
        self.myCard_show_cfg.sound_enter
    )
    local type = nil
    if self.Halo then
        type = self.curHalo.type_halo
    end
    while self.entr do
        if self:IsNil() then
            return
        end
        local x, y, z = self.bip:GetPosition()
        if self.Title then
            self.Title.gameObject:SetPosition(x, y + self.offset, z)
        end

        if self.Halo then
            if not type then
                type = self.curHalo.type_halo
            end
            if type == 1 then
                self.Halo.gameObject:SetPosition(x, 0, z)
            end
        end
        _G.coroutine.waitforendofframe()
    end
end

