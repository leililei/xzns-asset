---生成称号
function PingDingLingYu:SapwnTitle(titleData)
    if self.Title then
        _G.DestroyObject(self.Title.gameObject)
        self.Title = nil
    end
    _G.PoolsManager:GetInstance():Spawn(
        "CommonPrefab/World/Common_TitleWithDesignation",
        _G.ePoolType.Temporary,
        self.roleTrans,
        function(trans)
            local go_table = _G.GetAutoGoTable(trans)
            go_table.aortext_TextName:SetActiveE(0)
            go_table.aorimage_NameBg:SetActiveE(0)
            if not go_table.Canvas then
                go_table.Canvas = go_table.gameObject:AddComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
            end
            self.Title = go_table
            self:SetTitlePos()
            _G.GameUtil.SetActiveByCondition(go_table.aorrawimage_Title, titleData)
            if titleData then
                if titleData.type_title == 1 then
                    go_table.aorrawimage_Title:LoadImage(
                        titleData.icon,
                        function()
                            go_table.aorrawimage_Title:SetNativeSize()
                            go_table.aorrawimage_Title:SetLocalScaleXYZ(
                                _G.ConfigManager.discrete_cfg[103902][1][1] * 0.0045
                            )
                        end
                    )
                else
                    _G.UIUtils.LoadEffectTitleOrFrame(
                        titleData.title,
                        self.Title.gameObject,
                        function(trans)
                            if self:IsNil() then
                                _G.DestroyObject(trans)
                                return
                            end
                            trans:SetLayerAndChild(30)
                            self.Title.item = trans
                            local x, y, z = self.Title.aorrawimage_Title:GetPosition()
                            trans:SetPosition(x, y + 0.2, z)
                            self.Title.item:SetLocalScaleXYZ(_G.ConfigManager.discrete_cfg[103902][1][1] * 0.0045)
                            _G.GameUtil.SetActiveByCondition(trans, true)
                        end
                    )
                end
            end
        end
    )
end
