---按钮点击事件在这里派发
function FirstTestBossRankView:OnClickBtn(go, isOn)
    if self.inited then
        _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)
    end
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.aorbtn_Reward then
        self:OnReward(true)
    elseif go == self.Reward.aorbtn_Close or go == self.Reward.aorbtn_CloseBtn then
        self.go_table.obj_Reward:SetActiveE(0)
        self:OnRank(true)
    end
end

return FirstTestBossRankView
