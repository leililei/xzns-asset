            local data = teamcard[i]
            -- _G.StorageManager:GetInstance():GetItemBaseView(
            --     teamcard[i].sid,
            --     nil,
            --     parent,
            --     function(item)
            --         --item:Show(data)
            --     end
            -- )
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.ItemCardStorageView,
