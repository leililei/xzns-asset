    playerData.style = playerModel:GetRoleStyle()
    playerData.uid = playerModel:GetPlayerUid()
    playerData.lv = playerModel:GetLevel()
    playerData.title = playerModel:GetTitle()
    tb.aortext_damage.text = _G.GameUtil.NumberToUnitStr(require "FirstTestBossModel":GetInstance().infoData.day_dps)
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, playerData, 1, true, true, true)
