function FirstTestBossRankView:ShowAward(tb, obj, award)
    if not tb.list then
        tb.list = {}
    end
    local count = #tb.list
    local count2 = #award
    for i = 1, count do
        if i <= count2 then
            tb.list[i]:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(award[i]))
            _G.GameUtil.SetActiveByCondition(tb.list[i].gameObject, true)
        else
            _G.GameUtil.SetActiveByCondition(tb.list[i].gameObject, false)
        end
    end
    if count < count2 then
        for i = count + 1, count2 do
            local obj2 = _G.InstantiateObject(obj)
            obj2:SetParentE(tb.trans_Content)
            local item = require "BaseAwardNewItem".New(obj2, nil, 73, obj2:GetChildE(0))
            tb.list[i] = item
            local data = award[i]
            item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
        end
    end
end

function FirstTestBossRankView:GetRankData(index)
    if index <= 0 then
        return
    end
    for _, v in ipairs(self.RewardDatas) do
        if index >= v.min_rank and index <= v.max_rank then
            return v
        end
    end
    return nil
end

