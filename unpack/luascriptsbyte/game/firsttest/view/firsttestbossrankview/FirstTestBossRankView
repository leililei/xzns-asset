---刷新奖励
function FirstTestBossRankView:RefreshReward(index, obj, list, tb)
    local newIndex = index + 1
    local instanceID = obj:GetInstanceIDE()
    local data = tb.data.reward_daily[newIndex]
    local item = list[instanceID]
    if not item then
        item = require "BaseAwardNewItem".New(obj, _G.handler(self, self.OnClickAward), 73, obj)
        list[instanceID] = item
    end
    item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))
end

