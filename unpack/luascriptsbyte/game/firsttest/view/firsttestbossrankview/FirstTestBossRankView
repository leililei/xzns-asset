        self.player =
            _G.GetAutoGoTable(
                self.Rank.obj_player,
                _G.handlerbind(self, self.HeadClick, { rankData = { uid = _G.PlayerModel:GetInstance():GetPlayerUid(), name = _G.PlayerModel:GetInstance().role_name  } })
            )
        -- self.player.scrollloophorizontal_AwardList:InitItemData(
        --     0,
        --     _G.handlerbind(self, self.RefreshReward, self.rewardList_Rank, self.player)
        -- )
