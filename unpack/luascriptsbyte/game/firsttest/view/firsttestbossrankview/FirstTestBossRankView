local UIUtils = _G.UIUtils
function FirstTestBossRankView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.itemList = {}
    _G.GameUtil.SetActiveByCondition(self.gameObject, false)
end

---界面的入口函数
function FirstTestBossRankView:OnCreate()
    self.playerUid = _G.PlayerModel:GetInstance():GetPlayerUid()
    self:AddListener(_G.eBattleState.RecordEnd, self.OnRecordEnd)
    self:AddListener(_G.eBattleState.RecordStart, self.OnRecordStart)
    self:AddListener(_G.eSeason.SeasonRefreshModel, self.RefreshRankView)
    self:InitBg()
    self.RewardDatas = _G.table.toArray(_G.ConfigManager.season_boss_rank_cfg)
    _G.table.sort(
        self.RewardDatas,
        function(a, b)
            return a.id < b.id
        end
    )
    self:OnRank(true)
    --self:InitToggle()
    self.inited = true
    self:IsBool()
    self.Reward = _G.GetAutoGoTable(self.go_table.obj_Reward, _G.handler(self, self.OnClickBtn))
end

function FirstTestBossRankView:InitBg()
    local cfg = require "FirstTestBossModel":GetInstance().cfg.background
    if cfg and #cfg > 0 then
        self.go_table.aorrawimage_Bg:LoadImage(cfg)
    end
end

