        call(isOn)
    end
end

---判断是否显示回放按钮
function FirstTestBossRankView:IsBool()
    local EmbattleView = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.EmbattleView.Name)
    local BattleView = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    local ShowAwardWithButtonView = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg
        .ShowAwardWithButtonView.Name)
    if EmbattleView or BattleView or ShowAwardWithButtonView then
        self.IsHuiFang = true
    end
end

---大区排行
function FirstTestBossRankView:OnZoneRank(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_ZoneRank, isOn)
    if not isOn then
        return
    end
    if not self.ZoneRank then
        local name = "UI/ZoneRank/$_obj_zoneRank"
        _G.PoolsManager:GetInstance():Spawn(
            name,
            _G.ePoolType.Temporary,
            self.go_table.obj_ZoneRank,
            function(trans)
                _G.GameUtil.SetActiveByCondition(self.gameObject, true)
                _G.GameUtil.SetActiveByCondition(trans, true)
                local view = self:AddComponent(trans.gameObject, require "ZoneRankView".New(trans, self))
                view:InitView(_G.ZoneRankType.SeaonBoss, nil)
                self.ZoneRank = view
            end
        )
    end
end

---排行
function FirstTestBossRankView:OnRank(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Rank, isOn)
    if not isOn then
        return
    end
    self.go_table.obj_BottomBar:SetActiveE(1)
    if not self.Rank then
        self.go_table.obj_Reward:SetActiveE(0)
        self.Rank = _G.GetAutoGoTable(self.go_table.obj_Rank)
        self.rankList = {}
        self.rewardList_Rank = {}
        require "FirstTestBossModel":GetInstance():GetRank1(
            function()
                self.rankDatas = require "DungonesModel":GetInstance().rank_all_player or {}
                _G.GameUtil.SetActiveByCondition(self.Rank.obj_no, #self.rankDatas <= 0)
                _G.GameUtil.SetActiveByCondition(self.gameObject, true)
                self.Rank.scrollloopvectical_rankList:InitItemData(#self.rankDatas, _G.handler(self, self.RefreshRank))
            end
        )

        require "FirstTestBossModel":GetInstance():GetPlayerRank(
            function()
                self:InitPlayer()
            end
        )
        local cfg = require("SeasonModel"):GetInstance():GetBossCfg()
        if cfg.monster_spine and #cfg.monster_spine > 0 then
            _G.PoolsManager:GetInstance():Spawn(
                    cfg.monster_spine,
                    _G.ePoolType.Temporary,
                    self.Rank.trans_Spine,
                    function(trans)
                        if not self.Rank then
                            _G.DestroyObject(trans)
                            return
                        end
                        local pos = cfg.monster_spine_coefficient
                        trans:SetLocalScaleXYZ(pos[4])
                        trans:SetLocalPosition(pos[1], pos[2], pos[3])
                        trans:SetLocalRotation(0, pos[5], 0)
                    end
            )
        end
    end
end

function FirstTestBossRankView:RefreshRankView()
    require "FirstTestBossModel":GetInstance():GetRank1(
        function()
            self.rankDatas = require "DungonesModel":GetInstance().rank_all_player or {}
            _G.GameUtil.SetActiveByCondition(self.Rank.obj_no, #self.rankDatas <= 0)
            self.Rank.scrollloopvectical_rankList:UpdateCount(#self.rankDatas)
        end
    )
    require "FirstTestBossModel":GetInstance():GetPlayerRank(
        function()
            self:InitPlayer()
        end
    )
    if self.ZoneRank then
        self.ZoneRank:RefreshRank()
    end
end

function FirstTestBossRankView:HeadClick(go, ref, tb)
    local data = tb.rankData
    local name = go:GetName()
    if name == "@_aorbtn_HeadClick" then
        if data.uid and data.uid > 0 then
            if data.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.PopWindowManager:GetInstance():ShowAllTips(620109)
            else
                _G.SystemSettingManager:GetInstance():OpenView(data.uid)
            end
        end
    elseif name == "@_aorbtn_huifang" then
        --赛季boss名称
        -- local rightNameId = require("FirstTestBossModel"):GetInstance():GetSeasonBossName()
        -- local monsterName = rightNameId and rightNameId > 0 and _G.GetLangPackValue(rightNameId) or ""
        if data["GetPlayerName"] then
            require "DungonesModel":GetInstance():PlayRankHuiFang(18, data.uid, nil, data:GetPlayerName())
        else
            require "DungonesModel":GetInstance():PlayRankHuiFang(18, data.uid, nil, data.name)
        end
    end
end

function FirstTestBossRankView:OnRecordStart()
    require "FirstTestBossModel":GetInstance().isChallenge = true
end

function FirstTestBossRankView:OnRecordEnd()
    require "FirstTestBossModel":GetInstance().isChallenge = false
    if not require "SeasonManager".CheckSeasonIsOpen() then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.FirstTestBossView.Name)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SeasonView.Name)
        if
            _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.FirstTestBossRankView.Name) and
            _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name)
        then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name)
        end
        self:Close()
    end
end

---刷新排行
function FirstTestBossRankView:RefreshRank(index, obj)
    local newindex = index + 1
    local instanceID = obj:GetInstanceIDE()
    local tb = self.rankList[instanceID]
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.HeadClick, tb))
        self.rankList[instanceID] = tb
        -- self.rankList[instanceID].scrollloophorizontal_AwardList:InitItemData(
        --     0,
        --     _G.handlerbind(self, self.RefreshReward, self.rewardList_Rank, self.rankList[instanceID])
        -- )
    end
    local data = self.rankDatas[newindex]
    tb.rankData = data
    tb.data = self:GetRankData(newindex)
    --_G.GameUtil.SetActiveByCondition(tb.obj_rankBg2, newindex > 3)
    if newindex <= 3 then
        tb.aortext_rankNum:SetActiveE(0)
        tb.aorimage_rankBg.SpriteName = "ui_diban" .. newindex
        tb.aorimage_rankBg:SetRectTransformSize(688, 128)
    else
        tb.aortext_rankNum:SetActiveE(1)
        if AppSetting.IsXzns then
            tb.aorimage_rankBg.SpriteName = "TY_img_kuang"
        else
            tb.aorimage_rankBg.SpriteName = "TY_img_kuang".. newindex
        end
        tb.aorimage_rankBg:SetRectTransformSize(680, 120)
        tb.aortext_rankNum.text = newindex
    end
    for i = 1, 3 do
        tb["obj_rank" .. i]:SetActiveE(i == newindex and 1 or 0)
    end
    if tb.rankData.uid == self.playerUid then
        local playerModel = _G.PlayerModel:GetInstance()
        local playerData = {}
        playerData.frame = playerModel:GetCurFrame()
        playerData.style = playerModel:GetRoleStyle()
        playerData.uid = playerModel:GetPlayerUid()
        playerData.lv = playerModel:GetLevel()
        playerData.title = playerModel:GetTitle()
        UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, playerData, 1, true, true, true)
        tb.aortext_name.text = playerModel:GetName()
    else
        tb.aortext_name.text = data.playerName
        UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data, 1, true, true, true)
    end
    tb.aortext_damage.text = _G.GameUtil.NumberToUnitStr(data.values[2] or 0)
    tb.aortext_difficulty.text = _G.GameUtil.FormatRomeNum(data.values[1] or 1)
    if not tb.list then
        tb.list = {}
    end
    -- if tb.data then
    --     self:ShowAward(tb, tb.obj_item, tb.data.rewards)
    -- end
    if self.IsHuiFang and tb.aorbtn_huifang then
        tb.aorbtn_huifang:SetActiveE(0)
    end
    --self:ShowTeam(tb.trans_cardnode, data)
end

function FirstTestBossRankView:ShowTeam(parent, data)
