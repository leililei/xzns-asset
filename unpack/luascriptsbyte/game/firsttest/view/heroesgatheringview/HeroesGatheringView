local HeroesGatheringModel = require "HeroesGatheringModel":GetInstance()
local HeroesGatheringView = _G.BaseClass("HeroesGatheringView", _G.UIBaseView)
local ActivitySynManager = require "ActivitySynManager"

local TipID = {
    [1] = 105401,
    [2] = 105402,
    [3] = 105407
}
local LangID = {
    [1] = 90025500045,
    [2] = 90025500046,
    [3] = 90025500047,
    [4] = 90025500048
}
local ButID = {
    --未达成
    [1] = 90020400086,
    --可领取
    [2] = 90000000122,
    --已领取
    [3] = 90000010221,
    --可领取
    [4] = 90022200010
}

local ButImage = {
    --未达成
    [1] = "ui_btzl_btn_02",
    --可领取
    [2] = "UI_xfjj_bt_normal-",
    --已领取
    [3] = "UI_xfjj_ylq_bak"
}

function HeroesGatheringView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.ZuangTai = false
    self.go_table.scrollloopvectical_List:InitItemData(0, _G.handler(self, self.ItemDataAll_Index))
    HeroesGatheringModel:GetDataToInf(_G.handler(self, self.XianShiNew))
end

---界面的入口函数
---@param activity ActivitySynGMActivity
function HeroesGatheringView:OnCreate(activity)
    self.typeClass = activity
    self.endTime = self.typeClass:GetActivityDeadLineByCondition(require"ActivitySynManager":GetInstance().State.Close)
    self.typeClass:GetChangeStateTime()
    self.residueTime = self.endTime - _G.TimeUtil.GetServerUnixTime()
    self:XianShiTime(0)
    self.Tiemr_end = _G.TimerManager:GetInstance():GetTimer(1, self.XianShiTime, self, false, false)
    self.Tiemr_end:Start()
end
---
function HeroesGatheringView:XianShiNew(mag)
    --活动开启后，累计登录时间
    self.login_count = mag.login_count or 0
    --已被领取的
    self.award_list = mag.award_list or {}
    self.YiShengCheng = {}
    self.go_table.scrollloopvectical_List:UpdateCount(3)
end

function HeroesGatheringView:ItemDataAll_Index(index, listView2)
    if index < 0 then
        return
    end
    local indexs = index + 1
    local data = _G.ConfigManager.discrete_cfg[TipID[indexs]]

    local gotable = _G.GetAutoGoTable(listView2, _G.handlerbind(self, self.But, indexs))
    gotable.aortext_JinDuZanShi:SetActiveE(0)
    gotable.aorimage_XianShi:SetActiveE(0)
    gotable.aorbtn_LingQu:SetActiveE(0)
    gotable.aorimage_Mask:SetActiveE(0)
    gotable.aorimage_XianShi:SetGray(false)
    --描述
    local anniu, butImage
    if indexs == 1 then
        anniu =
            _G.string.format(
            _G.LangUtil.GetLangPackValue(LangID[1]),
            _G.ConfigManager.afk_cfg[data[1][2]].chapter,
            _G.ConfigManager.afk_cfg[data[1][2]].section
        )
        if _G.GlobalConditionManager.CheckCondition(data[1][1], data[1][2]) then
            gotable.aorimage_XianShi:SetActiveE(1)
            if self:LingQuZuanTai(TipID[indexs]) then
                gotable.aorimage_XianShi.SpriteName = ButImage[3]
                gotable.aortext_AnNiu:SetActiveE(0)
                gotable.aortext_AnNiu.text = _G.LangUtil.GetLangPackValue(ButID[3])
                gotable.aorimage_Mask:SetActiveE(1)
            else
                gotable.aorimage_XianShi.SpriteName = ButImage[2]
                gotable.aortext_AnNiu.text = _G.LangUtil.GetLangPackValue(ButID[2])

                gotable.aorbtn_LingQu:SetActiveE(1)
            end
        else
            gotable.aortext_JinDuZanShi:SetActiveE(1)
            local GetCurSection = _G.ConfigManager.afk_cfg[require "AfkModel":GetInstance():GetCurSection()].pre_section
            if GetCurSection == nil or GetCurSection == 0 then
                GetCurSection = require "AfkModel":GetInstance():GetCurSection()
            end
            gotable.aortext_JinDuZanShi.text =
                _G.string.format(
                _G.LangUtil.GetLangPackValue(LangID[4]),
                _G.ConfigManager.afk_cfg[GetCurSection].chapter,
                _G.ConfigManager.afk_cfg[GetCurSection].section
            )
        end
    elseif indexs == 2 then
        anniu = _G.LangUtil.GetLangPackValue(LangID[2])
        gotable.aorimage_XianShi:SetActiveE(1)

        if self.login_count < data[1][1] then
            gotable.aorimage_XianShi.SpriteName = ButImage[2]

            gotable.aorimage_XianShi:SetGray(true)
            gotable.aortext_AnNiu.text = _G.LangUtil.GetLangPackValue(ButID[1])
        else
            if self:LingQuZuanTai(TipID[indexs]) then
                gotable.aorimage_XianShi.SpriteName = ButImage[3]
                gotable.aortext_AnNiu:SetActiveE(0)

                gotable.aortext_AnNiu.text = _G.LangUtil.GetLangPackValue(ButID[3])
                gotable.aorimage_Mask:SetActiveE(1)
            else
                gotable.aorimage_XianShi.SpriteName = ButImage[2]
                gotable.aortext_AnNiu.text = _G.LangUtil.GetLangPackValue(ButID[2])

                gotable.aorbtn_LingQu:SetActiveE(1)
            end
        end
    elseif indexs == 3 then
        anniu = _G.LangUtil.GetLangPackValue(LangID[3])
        gotable.aorimage_XianShi:SetActiveE(1)

        if require "MonthlyModel":GetInstance():IsUnlockMonthCard(data[1][2], 1) then
            if self:LingQuZuanTai(TipID[indexs]) then
                gotable.aorimage_XianShi.SpriteName = ButImage[3]
                gotable.aortext_AnNiu:SetActiveE(0)

                gotable.aortext_AnNiu.text = _G.LangUtil.GetLangPackValue(ButID[3])
                gotable.aorimage_Mask:SetActiveE(1)
            else
                gotable.aorimage_XianShi.SpriteName = ButImage[2]
                gotable.aortext_AnNiu.text = _G.LangUtil.GetLangPackValue(ButID[2])

                gotable.aorbtn_LingQu:SetActiveE(1)
            end
        else
            gotable.aorimage_XianShi.SpriteName = ButImage[1]
            gotable.aortext_AnNiu.text = _G.LangUtil.GetLangPackValue(ButID[4])
            self.ZuangTai = true
            gotable.aorbtn_LingQu:SetActiveE(1)
        end
    end
    self:tanQuanDian(data[2], false, gotable.obj_Item, indexs)
    gotable.aorimage_XianShi:SetNativeSize()
    gotable.aortext_TiaoJian.text = anniu

    -- gotable.aorimage_playerIcon.SpriteName = _G.ConfigManager.player_portrait_cfg[data.style].portrait1
    -- gotable.aortext_Lv.text = data.level
    -- gotable.aortext_power.text = require("BountyGroupModel"):GetInstance().NumberToUnitStr_CardFightNum(data.power)
    -- gotable.aortext_name.text = data.name
    return gotable
end
---物品内容选中显示
function HeroesGatheringView:tanQuanDian(data, isGou, Parent, insId)
    if self.YiShengCheng[insId] ~= nil then
        self.YiShengCheng[insId]:ShowWithID(data)
    else
        self.YiShengCheng[insId] =
            require "BaseAwardNewItem".New(
            Parent,
            function(item)
                require("CommonTipManager"):GetInstance():OpenTip(item.go_table.gameObject, data[1])
            end,
            nil,
            Parent
        )
        self.YiShengCheng[insId]:ShowWithID(data)
    end
end
function HeroesGatheringView:But(_, _, Uid)
    if Uid == 3 and self.ZuangTai then
        --require("ShopController"):GetInstance():OpenUIWindow(_G.ShopViewEnum.yueka, 2)
        --item_way_cfg 月卡id148001，策划说配死2023.1.30
        _G.JumpManager:GetInstance():Jump(148001)
        require "SeasonManager":GetInstance():CloseMainView()
        self:Close()
        return
    end
    self.residueTime = self.endTime - _G.TimeUtil.GetServerUnixTime()
    if self.residueTime <= 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(650104)
        return
    end
    HeroesGatheringModel:AddBlackrallyaward(
        {id = TipID[Uid]},
        function()
            self:XianShiBool(Uid)
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FirstGather.id)
            if _G.table.count(HeroesGatheringModel.award_lists) == 3 then
                self.typeClass:ChangeState(ActivitySynManager.State.Close)
            end
        end
    )
end

function HeroesGatheringView:XianShiBool(id)
    self.go_table.scrollloopvectical_List:UpdateCount(3)
end

function HeroesGatheringView:XianShiTime(elapsed)
    self.residueTime = self.residueTime - elapsed
    local time = Mathf.RoundToInt(self.residueTime)
    -- self.residueTime = self.endTime - _G.TimeUtil.GetServerUnixTime()
    if self.residueTime <= 0 then
        if self.Tiemr_end ~= nil then
            self.Tiemr_end:Stop()
            self.Tiemr_end = nil
        end
        -- self:CloseView()
        return
    end

    self.go_table.aortext_Time.text =
        _G.string.format(
        _G.LangUtil.GetLangPackValue(90025500051),
        _G.TimeUtil.TranslateSecondForStr(time)
    )
end

---领取状态判断
function HeroesGatheringView:LingQuZuanTai(id)
    for key, value in pairs(HeroesGatheringModel.award_lists) do
        if value == id then
            return true
        end
    end
    return false
end

---按钮点击事件在这里派发
function HeroesGatheringView:OnClickBtn(go, isOn)
    if go == nil then
        return
    end
    local name = go:GetName()

    if name == "@_aorbtn_Close" then
        self:CloseView()
    end
end

function HeroesGatheringView:CloseView()
    if self.Tiemr_end ~= nil then
        self.Tiemr_end:Stop()
        self.Tiemr_end = nil
    end
    self:Close()
end


return HeroesGatheringView
