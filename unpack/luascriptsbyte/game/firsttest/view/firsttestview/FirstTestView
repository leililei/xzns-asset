---@class FirstTestView : UIBaseView	中文描述
---@field public go_table FirstTestView_GoTable GoTable
---@field awardList FirstTestView._obj_award_GoTable[]
---@field cfg season_cfg
local FirstTestView = _G.BaseClass("FirstTestView", _G.UIBaseView)
local fontColor = {
    [1] = "ffffff",
    [2] = "f2cd99"
}
function FirstTestView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function FirstTestView:OnCreate(id)
    self.seasonId = require "FirstTestModel":GetInstance():GetCurSeasonId()
    self.cfg = _G.ConfigManager.season_cfg[self.seasonId]
    self:InitView()
    _G.Events:GetInstance():AddListener(_G.eSeason.SeasonRefreshModel, self.RefreshPanel, self)
    self.btns = {
        [60] = self.go_table.aorbtn_boss,
        [63] = self.go_table.aorbtn_depot,
        [71] = self.go_table.aorbtn_md,
        [72] = self.go_table.aorbtn_hero,
        [_G.FunctionID.HellGuard] = self.go_table.aorbtn_king,
        [94] = self.go_table.aorbtn_ly
    }
    if id then
        self:OnClickBtn(self.btns[id])
    end
end
---初始化界面
function FirstTestView:InitView()
    self:InitAwardList()
    self:UpdateTime()
    self:UpdateSlider()
    self:InitEffect()
end

function FirstTestView:InitEffect()
    if self.effectTb then
        for _, v in pairs(self.effectTb) do
            _G.DestroyObject(v)
        end
    else
        self.effectTb = {}
    end
    for _, v in pairs(self.cfg.Name) do
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[v],
            self.transform,
            function(obj)
                if self:IsNil() then
                    _G.DestroyObject(obj)
                else
                    _G.table.insert(self.effectTb, obj)
                end
            end
        )
    end
end

function FirstTestView:RefreshPanel()
    self:UpdateSlider()
    for i = 1, 7 do
        self:UpdateAwardShow(i)
    end
end
---更新赛季事件
function FirstTestView:UpdateTime()
    self.go_table.aorrawimage_bg:LoadImage(self.cfg.background)

    self.go_table.aortext_time.text =
        require "FirstTestModel":GetInstance():FormatTime(
        require "FirstTestModel":GetInstance().infoData.start_time,
        self.cfg.duration * 86400
    )
end

---初始化奖励
function FirstTestView:InitAwardList()
    self.awardList = {}
    for i = 1, 7 do
        self.awardList[i] =
            _G.GetAutoGoTable(self.go_table["obj_award" .. i], _G.handlerbind(self, self.OnClickAward, i))
        self:UpdateAwardShow(i)
    end
end
---更新进度
function FirstTestView:UpdateSlider()
    self.go_table.slider_progress.value = (require "FirstTestModel":GetInstance().curDay - 1) / 6
end
---更新奖励显示
function FirstTestView:UpdateAwardShow(index)
    local tb = self.awardList[index]
    local color = fontColor[1]
    ---@type season_login_cfg
    local cfg = _G.ConfigManager.season_login_cfg[self.seasonId * 100 + index]
    _G.GameUtil.SetActiveByCondition(tb.obj_gou, false)

    if index < 7 then
        if require "FirstTestModel":GetInstance():CheckGetLoginAward(cfg.id) then
            _G.GameUtil.SetActiveByCondition(tb.obj_gou, true)
            tb.aorimage_bg.SpriteName = "ui_sj_pic_kuang01"
        elseif require "FirstTestModel":GetInstance():CheckCanTakeLoginAward(cfg.id) then
            _G.GameUtil.SetActiveByCondition(tb.obj_gou, false)
            tb.aorimage_bg.SpriteName = "ui_sj_pic_kuang02"
            color = fontColor[2]
        else
            tb.aorimage_bg.SpriteName = "ui_sj_pic_kuang01"
        end
    else
        if require "FirstTestModel":GetInstance():CheckGetLoginAward(cfg.id) then
            _G.GameUtil.SetActiveByCondition(tb.obj_gou, true)
        elseif require "FirstTestModel":GetInstance():CheckCanTakeLoginAward(cfg.id) then
            _G.GameUtil.SetActiveByCondition(tb.obj_gou, false)
            color = fontColor[2]
        end
    end
    _G.UIUtils.SetItemNum(tb, cfg.rewards[1][2], "X")
    -- tb.aortext_num.text = "x" .. cfg.rewards[1][2]
    tb.aorrawimage_icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(cfg.rewards[1][1]))
    tb.aortext_day.text =
        _G.string.AddColor(
        _G.string.format(_G.LangUtil.GetLangPackValue(90023800019), _G.GameUtil.NumberToChinese(cfg.day)),
        color
    )
    if not tb.effect then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_FirstTestView_loop,
            tb.trans_effect,
            function(trans)
                tb.effect = trans
            end
        )
    end
    _G.GameUtil.SetActiveByCondition(
        tb.trans_effect,
        require "FirstTestModel":GetInstance():CheckCanTakeLoginAward(cfg.id)
    )
end

---点击奖励
function FirstTestView:OnClickAward(go, isOn, index)
    local cfg = _G.ConfigManager.season_login_cfg[self.seasonId * 100 + index]
    if require "FirstTestModel":GetInstance():CheckCanTakeLoginAward(cfg.id) then
        require "FirstTestModel":GetInstance():GetSignReward(
            cfg.id,
            function()
                self:UpdateAwardShow(index)
            end
        )
    else
        require "CommonTipManager":GetInstance():OpenTip(go, cfg.rewards[1][1])
    end
end

---按钮点击事件在这里派发
function FirstTestView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_seasonTable then
        --临时添加赛季转盘入口，ZHJ-17472【客户端】新赛季-赛季转盘
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SeasonTurntableView.Name)
    elseif go == self.go_table.aorbtn_boss then ---Boss
        if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(60) then
            _G.FunctionManager:GetInstance():ShowFuncitonOpenTips(60)
            return
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FirstTestBossView.Name)
    elseif go == self.go_table.aorbtn_depot then ---Boss
        if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(63) then
            _G.FunctionManager:GetInstance():ShowFuncitonOpenTips(63)
            return
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WheelOfFortuneView.Name)
    elseif go == self.go_table.aorbtn_ly then ---Boss
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.PingDingLingYu.Name,
            function()
                self:Hide()
            end,
            function()
                if self.gameObject:GetActiveSelf() == 0 then
                    self:Show()
                end
            end
        )
    elseif go == self.go_table.aorbtn_md then ---Boss
        if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(71) then
            _G.FunctionManager:GetInstance():ShowFuncitonOpenTips(71)
            return
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.HeroesGatheringView.Name)
    elseif go == self.go_table.aorbtn_king then
        if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.HellGuard) then
            _G.FunctionManager:GetInstance():ShowFuncitonOpenTips(_G.FunctionID.HellGuard)
            return
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.HellGuardView.Name)
    elseif go == self.go_table.aorbtn_hero then
        if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(72) then
            _G.FunctionManager:GetInstance():ShowFuncitonOpenTips(72)
            return
        end
        self:Hide()
        require("AllHeroesBattleManager"):GetInstance():OpenMainView(
            function()
                self:Show()
            end
        )
    end
end

function FirstTestView:OnStartClose()
    _G.Events:GetInstance():RemoveListener(_G.eSeason.SeasonRefreshModel, self.RefreshPanel, self)
end

return FirstTestView
