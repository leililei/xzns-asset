function FirstTestBossView:RefreshSkill(index, obj)
    local x = index + 1
    local id = self.bossCfg.skill[x]
    if id and id > 0 then
        local cfg = _G.ConfigManager.card_skills_cfg[id]
        if cfg then
            local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.ClickSkill, cfg.id))
            tb.aorrawimage_skill:LoadImage(cfg.icon)
        end
    else
        _G.GameUtil.SetActiveByCondition(obj, false)
    end
end
