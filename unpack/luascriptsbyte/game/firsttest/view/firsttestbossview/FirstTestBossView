function FirstTestBossView:UpdateTimer()
    local refreshTime = _G.TimeUtil.TranslateSecond(_G.TimeUtil.GetSixClockTimer())
    self:RefreshActiveTime()
    if self.nextTurnTime then
        local activeTime = _G.TimeUtil.TransDayHourMineMiao(self.nextTurnTime - _G.TimeUtil.GetServerUnixTime())
        self.go_table.obj_ActiveTime:SetActiveE(1)
        self.go_table.aortext_ActiveTime.text = _G.GetLangPackValue(90028500004,  "<color=#96CE51>" .. activeTime .. "</color>")
    else
        self.go_table.obj_ActiveTime:SetActiveE(0)
    end
    self.go_table.aortext_RefreshTime.text = _G.GetLangPackValue(90025500091) ..
            "<color=#96CE51>" .. refreshTime.hour .. ":" .. refreshTime.min .. ":" .. refreshTime.sec .. "</color>"
    local isSettlement = require("FirstTestBossModel"):GetInstance():IsSettlementTime()
    self.go_table.aorbtn_fight:SetGray(isSettlement)
end

---初始化排行榜
function FirstTestBossView:InitRankList()
    self.rankDatas = require "FirstTestBossModel":GetInstance().rankList or {}
    local count = #self.rankDatas
    if count > 10 then
        count = 10
    elseif count < 3 then
        count = 3
    end
    --self.go_table.scrollloopvectical_rank:UpdateCount(count)
    self.playerInited = false
    self.go_table.scrollloopvectical_rank:InitItemData(count, _G.handler(self, self.RefreshItem))
    if not self.isinited then
        _G.GameUtil.SetActiveByCondition(self.go_table.gameObject, true)
    end
    self.isinited = true

    local isSettlement = require("FirstTestBossModel"):GetInstance():IsSettlementTime()
    self.go_table.aorbtn_fight:SetGray(isSettlement)
end
---刷新排行
function FirstTestBossView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    index = index + 1
    local instanceID = obj:GetInstanceIDE()
    if not self.itemTransDic[instanceID] then
        self.itemTransDic[instanceID] = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.HeadClick, self.itemTransDic[instanceID]))
    end
    self:ShowRankItem(self.itemTransDic[instanceID], self.rankDatas[index], index)
end
function FirstTestBossView:HeadClick(go, ref, tb)
    local name = go:GetName()
    if name == "@_aorbtn_HeadClick" then
        local data = tb.data
        if data.uid and data.uid > 0 then
            if data.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.PopWindowManager:GetInstance():ShowAllTips(620109)
            else
                _G.SystemSettingManager:GetInstance():OpenView(data.uid)
            end
        end
    end
end
function FirstTestBossView:ShowRankItem(tb, data, index)
    tb.data = data
    if index <= 3 then
        --tb.aorimage_rank:SetActiveE(1)
        tb.aortext_rank:SetActiveE(1)
        tb.aortext_rank.text = index
        --tb.aorimage_rank.SpriteName = string.format("tz_qjhs_phb_mingci_0%d", index)
    else
        --tb.aorimage_rank:SetActiveE(0)
        tb.aortext_rank:SetActiveE(1)
        tb.aortext_rank.text = index
    end
    _G.GameUtil.SetActiveByCondition(tb.aortext_no, not data and index <= 3)
    if data then
        if data.name == _G.PlayerModel:GetInstance():GetName() then
            data.index = index
            self:InitPlayer(data)
        end
        _G.GameUtil.SetActiveByCondition(tb.obj_content, true)
        tb.aortext_name.text = data.name
        tb.aortext_difficulty.text = _G.GameUtil.FormatRomeNum(data.values[1] or 1)
        tb.aortext_value.text = _G.GameUtil.NumberToUnitStrBag(data.values[2])
        tb.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(data.power)
        UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, tb.data, 0.5, true)
    else
        _G.GameUtil.SetActiveByCondition(tb.obj_content, false)
    end
end

function FirstTestBossView:InitPlayer(data)
    local tb = _G.GetAutoGoTable(self.go_table.obj_rankplayer)
    if not data or not data.index then
        tb.obj_difficulty:SetActiveE(0)
        tb.aortext_value.text = data and data.values[2] or 0
        tb.aortext_rank.text = _G.GetLangPackValue(90022900040)
        return
    end
    tb.obj_difficulty:SetActiveE(1)
    tb.aortext_difficulty.text = _G.GameUtil.FormatRomeNum(data.values[1] or 1)
    tb.aortext_value:SetActiveE(1)
    tb.aortext_value.text = _G.GameUtil.NumberToUnitStrBag(data.values[2])
    if data.index >= 1 and data.index <= 10 then
        tb.aortext_rank.text = data.index
    else
        tb.aortext_rank.text = _G.GetLangPackValue(90022900040)
    end
end

---刷新跳过战斗状态
---@return void
function FirstTestBossView:RefreshSkipBattleState()
    --读取解锁配置并显示文本
    local params = _G.ConfigManager.discrete_cfg[115601]
    if not params then
        self.go_table.obj_skipBg:SetActiveE(0)
        return
    end
    local ok, content = _G.GlobalConditionManager.CheckConditionArraysCustomUnlockTip(params)
    if ok then
        self.go_table.obj_skipBg:SetActiveE(0)
        return
    end
    if content then
        self.go_table.aortext_skipTip.text = content
    end
    self.go_table.obj_skipBg:SetActiveE(content and 1 or 0)
end
---是否显示跳过战斗按钮
---@return boolean
function FirstTestBossView:IsShowSkipBattle()
    local params = _G.ConfigManager.discrete_cfg[115601]
    if not params then
        return false
    end
    local ok = _G.GlobalConditionManager.CheckConditionArrays(params)
    return ok
end

