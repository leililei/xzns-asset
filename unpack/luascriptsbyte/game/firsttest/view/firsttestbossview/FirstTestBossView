function FirstTestBossView:ChangeScroll(pos)
    if pos.y <= 0.2 then
        self.go_table.aorimage_arrow:SetEulerAngles(0, 0, 0)
    else
        self.go_table.aorimage_arrow:SetEulerAngles(0, 0, -180)
    end
end
function FirstTestBossView:LoadSkillCall(skillTrans)
    self.SkillTrans = skillTrans:GetComponentE(_G.typeof(_G.CS.ScrollLoopVertical))
    self.SkillTrans:InitItemData(#self.bossCfg.skill, _G.handler(self, self.RefreshSkill))
end
