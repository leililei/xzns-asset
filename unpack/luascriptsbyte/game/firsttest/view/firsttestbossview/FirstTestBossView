---按钮点击事件在这里派发
function FirstTestBossView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_rank then
        -- elseif go == self.go_table.aorbtn_task then
        --     _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FirstTestBossTaskView.Name)
        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FirstTestBossRankView.Name)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FirstTestBossRankView.Name)
    elseif go == self.go_table.aorbtn_close then
        TrackingPointModel:GetInstance():CloseActTracking(self.viewName)
        self:Close()
        if self.openFun then
            self.openFun()
        end
    elseif go == self.go_table.aorbtn_fight then
        if require("FirstTestBossModel"):GetInstance():IsSettlementTime() then
            _G.PopWindowManager:GetInstance():ShowAllTips(620105)
            return
        end
        self:OnFight()
    elseif go == self.go_table.aorbtn_way then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 31)
    elseif go == self.go_table.aorbtn_info then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FirstTestBossInfoView.Name)
    elseif go == self.go_table.aorbtn_clickTZ then
        self.go_table.obj_teZhengContent:SetActiveE(0)
        self.go_table.aorbtn_clickZhanKai:SetActiveE(1)
        self:RefreshZhanKai()
    elseif go == self.go_table.aorbtn_clickZhanKai then
        self.go_table.obj_teZhengContent:SetActiveE(1)
        self.go_table.aorbtn_clickZhanKai:SetActiveE(0)
        self:RefreshTeZheng()
    elseif go == self.go_table.aorbtn_award then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FirstTestAwardView.Name)
    end
end

function FirstTestBossView:RefreshActiveTime()
    local SeasonModel = require "SeasonModel":GetInstance()
    local seasonStartTime = SeasonModel:GetTime().startTime
    local nextTurnTime = SeasonModel:GetLoginPeriod() * 7 * 86400 + seasonStartTime
    if nextTurnTime >= SeasonModel:GetTime().endTime then
        nextTurnTime = SeasonModel:GetTime().endTime - 3600 --最后一个周期赛季结算
    end
    self.nextTurnTime = nextTurnTime
    return true
end

function FirstTestBossView:RefreshTZAll()
    if not self:RefreshActiveTime() then
        self.go_table.obj_teZhengContent:SetActiveE(0)
        self.go_table.obj_zhanKaiContent:SetActiveE(0)
        self.go_table.aorbtn_clickZhanKai:SetActiveE(0)
        return
    end
    if self.go_table.obj_teZhengContent:GetActiveSelf() == 1 then
        self:RefreshTeZheng()
    else
        self:RefreshZhanKai()
    end
end

function FirstTestBossView:RefreshTeZheng()
    local childCount = self.go_table.obj_TZ_zheDie:GetChildCountE()
    if childCount >= #self.mementos then
        for i = 1, #self.mementos do
            local go = self.go_table.obj_TZ_zheDie:GetChildE(i - 1)
            go:SetActiveE(1)
            self:RefreshZheDieItem(go, self.mementos[i])
        end
        for i = #self.mementos + 1, childCount do
            local go = self.go_table.obj_TZ_zheDie:GetChildE(i - 1)
            go:SetActiveE(0)
        end
    else
        for i = 1, childCount do
            local go = self.go_table.obj_TZ_zheDie:GetChildE(i - 1)
            go:SetActiveE(1)
            self:RefreshZheDieItem(go, self.mementos[i])
        end
        for i = childCount + 1, #self.mementos do
            local obj = _G.InstantiateObject(self.go_table.obj_zheDieItem, self.go_table.obj_TZ_zheDie)
            obj:SetActiveE(1)
            self:RefreshZheDieItem(obj, self.mementos[i])
        end
    end
end

function FirstTestBossView:RefreshZheDieItem(obj, memento_id)
    local go_table = _G.GetAutoGoTable(obj)
    local mementos_cfg = _G.ConfigManager.mementos_cfg[memento_id]
    go_table.aorrawimage_icon:LoadImage(mementos_cfg.icon)
    go_table.aortext_name.text = _G.GetLangPackValue(mementos_cfg.name)
end

function FirstTestBossView:RefreshZhanKai()
    local childCount = self.go_table.obj_zhanKaiBg:GetChildCountE() - 1
    if childCount >= #self.mementos then
        for i = 1, #self.mementos do
            local go = self.go_table.obj_zhanKaiBg:GetChildE(i)
            go:SetActiveE(1)
            self:RefreshZhanKaiItem(go, self.mementos[i])
        end
        for i = #self.mementos + 1, childCount do
            local go = self.go_table.obj_zhanKaiBg:GetChildE(i)
            go:SetActiveE(0)
        end
    else
        for i = 1, childCount do
            local go = self.go_table.obj_zhanKaiBg:GetChildE(i)
            go:SetActiveE(1)
            self:RefreshZhanKaiItem(go, self.mementos[i])
        end
        for i = childCount + 1, #self.mementos do
            local obj = _G.InstantiateObject(self.go_table.obj_zhanKaiItem, self.go_table.obj_zhanKaiBg)
            obj:SetActiveE(1)
            self:RefreshZhanKaiItem(obj, self.mementos[i])
        end
    end
    -- local x,y,z = self.go_table.obj_zhanKaiBg:GetLocalPosition()
    -- self.go_table.obj_zhanKaiBg:SetLocalPosition(x, -38.64 + 24.62 * (#self.mementos - 1), z)
end

function FirstTestBossView:RefreshZhanKaiItem(obj, memento_id)
    local go_table = _G.GetAutoGoTable(obj)
    local mementos_cfg = _G.ConfigManager.mementos_cfg[memento_id]
    go_table.aorrawimage_icon:LoadImage(mementos_cfg.icon)
    go_table.aortext_desc.text = _G.GetLangPackValue(mementos_cfg.desc)
end


---刷新界面
function FirstTestBossView:RefreshView(id)
    if id == _G.FunctionID.SeasonBoss then
        self.cfg = require "FirstTestBossModel":GetInstance().cfg
        self:InitView()
    end
end

function FirstTestBossView:OnEnable()
    self:UpdateDamages()
end

function FirstTestBossView:OnDestroy()
    if self.Timer ~= nil then
        self.Timer:Stop()
    end
    self.Timer = nil
    if self.MementosTimer ~= nil then
        self.MementosTimer:Stop()
    end
    self.MementosTimer = nil

    if self.refreshViewTimer then
        self.refreshViewTimer:Stop()
        self.refreshViewTimer = nil
    end
end

return FirstTestBossView
