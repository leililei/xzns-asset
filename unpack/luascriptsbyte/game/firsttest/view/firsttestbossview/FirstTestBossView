function FirstTestBossView:InitDamageList()
    self.damageRankList = require "FirstTestBossModel":GetInstance():GetDamageAwardList()
    self.damageRankItem = {}
    self.maxDamage = require "FirstTestBossModel":GetInstance():GetDayDamage()
    self.go_table.scrollloophorizontal_DamageList:InitItemData(#self.damageRankList, _G.handler(self, self.RefreshDamage))
end

function FirstTestBossView:RefreshDamage(index, obj)
    local newIndex = index + 1
    if not self.damageRankItem[newIndex] then
        self.damageRankItem[newIndex] = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickDamage))
    end
    self:UpdateSingleDamage(newIndex)
end

function FirstTestBossView:UpdateSingleDamage(index)
    if not self.damageRankItem[index] then
        return
    end
    local lastDamage = 0
    local cfg = _G.ConfigManager.season_boss_reward_cfg[self.damageRankList[index]]
    if index > 1 then
        lastDamage = _G.ConfigManager.season_boss_reward_cfg[self.damageRankList[index - 1]].require
    end
    local nowDamage = cfg.require
    self.damageRankItem[index].aortext_Damage.text = _G.GameUtil.NumberToUnitStrFight(nowDamage)
    if self.maxDamage == 0 then
        self.damageRankItem[index].slider_Progress.value = 0
    elseif self.maxDamage >= nowDamage then
        self.damageRankItem[index].slider_Progress.value = 1
    else
        self.damageRankItem[index].slider_Progress.value = (self.maxDamage - lastDamage) / (nowDamage - lastDamage)
    end
    local isGet = require("FirstTestBossModel"):GetInstance():CheckAwardIsGet(self.damageRankList[index])
    local canGet = not isGet and self.maxDamage >= nowDamage
    self.damageRankItem[index].aorbtn_Click:SetActiveE(canGet and 1 or 0)
    self.damageRankItem[index].obj_Eff:SetActiveE(canGet and not isGet and 1 or 0)
    self.damageRankItem[index].obj_isGet:SetActiveE(isGet and 1 or 0)
    self.damageRankItem[index].obj_Root:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
            cfg.rewards[1],
            self.damageRankItem[index].obj_Root,
            function(item)
                if self:IsNil() then
                    _G.DestroyObject(item.gameObject)
                    return
                end
                if self.damageRankItem[index].obj_Root:GetChildCountE() > 1 then
                    _G.DestroyObject(self.damageRankItem[index].obj_Root:GetChildE(0))
                end
                item.go_table.obj_uieffect:ClearChildren()
                if canGet and not isGet then
                    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_kelingqukuang, item.go_table.obj_uieffect)
                end
                if item.ShowNumText then
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
            end
    )
end

function FirstTestBossView:InitAddHero()
    local count = #self.bossCfg.cards_bonus
    local cardId = self.bossCfg.cards_bonus[1][1]
    local unlock = require "IllustrationModel":GetInstance():GetCardMaxStar(cardId) >= self.bossCfg.cards_bonus[1][3]
    _G.StorageManager:GetInstance():GetItemBaseView(
            self.bossCfg.cards_bonus[1][1],
            1,
            self.go_table.trans_Root,
            function(item)
                if self:IsNil() then
                    _G.DestroyImmediate(item.gameObject)
                    return
                end
                item:SetGray(unlock and 0 or 1)
                item:ShowLv(false)
            end
    )
    if AppSetting.IsXzns then
        self.cardTypeEnum = {
            [1] = "ui_zy_tanke_icom",
            [2] = "ui_zy_zhanshi_icom",
            [3] = "ui_zy_fashi_icom",
            [4] = "ui_zy_fuzhu_icom",
            [5] = "ui_zy_youxia_icom"
        }
        local cfg = require("SeasonModel"):GetInstance():GetBossCfg()
        ---@type EmbattleSeasonBoss
        self.Embattleitem = require("EmbattleSeasonBoss").New(_G.EmbattleType.SeasonBoss, _G.EmbattleSaveType.server,  true,cfg.monster_group)
        self.Embattleitem:InitEmbattleData()
    end
    for i = 1, count do
        local unlockSkill = false
        if AppSetting.IsXzns then
            local star = self.bossCfg.cards_bonus[i][3]
            local Professional = self.bossCfg.cards_bonus[i][4]
            self.go_table.trans_Root:SetActiveE(0)
            self.go_table.aorimage_Occupation:SetActiveE(1)
            self.go_table.aorimage_Occupation.SpriteName = self.cardTypeEnum[Professional]
            --local CardStorage = _G.StorageManager:GetInstance():GetDataStorageByID(_G.StorageID.Card)
            for k, v in pairs(self.Embattleitem.curEmbattleData) do
                local cfg = ConfigManager.card_cfg[v.sid]
                if cfg and cfg.Professional == Professional and v.star >= star then
                    unlockSkill = true
                    break
                end
            end

            --for sid, v in pairs(self.Embattleitem.curSids) do
            --    ---@type CardData[]
            --    local cardDatas = CardStorage:GetCardsBySid(sid)
            --    local count = #cardDatas
            --    if cardDatas and count > 0 then
            --        for i = 1, count do
            --            local cardData = cardDatas[i]
            --            if cardData and cardData.cfg.Professional == Professional and cardData.star >= star then
            --                unlockSkill = true
            --                break
            --            end
            --        end
            --    end
            --end
        else
            unlockSkill = require "IllustrationModel":GetInstance():GetCardMaxStar(cardId) >= self.bossCfg.cards_bonus[i][3]
        end
        local obj = _G.InstantiateObject(self.go_table.obj_addHeroItem, self.go_table.trans_Content)
        obj:SetActiveE(1)
        local go_table = _G.GetAutoGoTable(obj)
        --go_table.aortext_title.text = _G.GetLangPackValue(self.bossCfg.title[1])
        ---@type card_skills_cfg
        local cfg = _G.ConfigManager.card_skills_cfg[self.bossCfg.cards_bonus[i][2]]
        if cfg and self.bossCfg.title[i] then
            local notUnlockcol = "EEC398"
            local unlockcol="888888"
            if AppSetting.IsXzns then
                notUnlockcol = "ffffff"
                unlockcol="959595"
            end
            go_table.aortext_content.color = _G.ColorTools.FormatColorByString(unlockSkill and notUnlockcol or unlockcol)
            go_table.aortext_content.text = _G.GetLangPackValue(self.bossCfg.title[i])
            go_table.aortext_LockState.text = unlockSkill and "<color=#96CE51>(" .. _G.GetLangPackValue(90020400085) .. ")</color>" or
                    "<color=#CE5151>(" .. _G.GetLangPackValue(90020400086) .. ")</color>"
        end
    end
