    self:RefreshSkipBattleState()
    self.Timer = _G.TimerManager:GetInstance():GetTimer(
            1,
            self.UpdateTimer,
            self,
            false,
            false,
            false
    )
    self.Timer:Start()
    UIUtils.SetUIModel(self.go_table.aorimage_titlebg,nil,self.go_table.aorimage_titlebg2)
end
