---更新技能显示
function FirstTestBossInfoView:ShowSkill()
    self.go_table.scrollloopvectical_SkillList:UpdateCount(#self.cfg.skill)
    local cfg = require("SeasonModel"):GetInstance():GetBossCfg()
    if cfg.monster_spine and #cfg.monster_spine > 0 then
        _G.PoolsManager:GetInstance():Spawn(
                cfg.monster_spine,
                _G.ePoolType.Temporary,
                self.go_table.aorrawimage_monster,
                function(trans)
                    if not self.go_table then
                        _G.DestroyObject(trans)
                        return
                    end
                    local pos = cfg.monster_spine_coefficient
                    trans:SetLocalScaleXYZ(pos[4])
                    trans:SetLocalPosition(pos[1], pos[2], pos[3])
                    trans:SetLocalRotation(0, pos[5], 0)
                end
        )
    end
end

function FirstTestBossInfoView:RefreshSkill(index, obj)
    local id = obj:GetInstanceIDE()
    local tb = self.skillList[id]
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        self.skillList[id] = tb
    end
    self:ShowSingleSkill(tb, index + 1)
end

---更新单个技能显示
---@param tb FirstTestBossInfoView._obj_skill1_GoTable
function FirstTestBossInfoView:ShowSingleSkill(tb, index)
    local id = self.cfg.skill[index]
    if id and id > 0 then
        local cfg = _G.ConfigManager.card_skills_cfg[id]
        if cfg then
            tb.aorrawimage_icon:LoadImage(cfg.icon)
            tb.aortext_type.text = _G.ConfigManager.language_package_cfg[cfg.brief]
            tb.aortext_name.text = _G.LangUtil.GetLangPackValue(cfg.name1)
            tb.DesExText = tb.obj_des:GetComponentE(_G.typeof(_G.CS.ExtendText))
            tb.DesExText.text = _G.LangUtil.GetLangPackValue(cfg.describe1)
            tb.DesExText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))
            --tb.aortext_des.text = _G.LangUtil.GetLangPackValue(cfg.describe1)
        end
        _G.GameUtil.SetActiveByCondition(tb.gameObject, true)
    else
        _G.GameUtil.SetActiveByCondition(tb.gameObject, false)
    end
end

---点击超链接
function FirstTestBossInfoView:OnHrefClick(id, name, asa)
    require("CommonTipManager"):GetInstance():OpenSkillHyper(_G.tonumber(id), nil, 0, 800)
end

