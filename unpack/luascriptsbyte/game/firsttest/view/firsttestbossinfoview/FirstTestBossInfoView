---按钮点击事件在这里派发
function FirstTestBossInfoView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_left then
        self:ChangePage(-1)
    elseif go == self.go_table.aorbtn_right then
        self:ChangePage(1)
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

return FirstTestBossInfoView
