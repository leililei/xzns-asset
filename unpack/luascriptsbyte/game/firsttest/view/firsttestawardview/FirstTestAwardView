local FirstTestBossModel = require("FirstTestBossModel")

---@class FirstTestAwardView : UIBaseView	中文描述
---@field public go_table FirstTestAwardView_GoTable GoTable

local FirstTestAwardView = _G.BaseClass("FirstTestAwardView", _G.UIBaseView)

function FirstTestAwardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function FirstTestAwardView:OnCreate()
    self.awardLis = FirstTestBossModel:GetInstance():GetDamageAwardList()
    self:InitView()
end

function FirstTestAwardView:InitView()
    local FirstTestBossModelIns = require "FirstTestBossModel":GetInstance()

    local canGetAwardSidList = FirstTestBossModelIns:GetAwardAllCanGet()
    ---@type table<number,season_boss_reward_cfg>
    local cfgList = {}
    for _, sid in ipairs(canGetAwardSidList) do
        local cfg = _G.ConfigManager.season_boss_reward_cfg[sid]
        if cfg then
            table.insert(cfgList, cfg)
        end
    end

    local noLevel = #cfgList == 0
    local totalRewards = {}
    if not noLevel then
        for _, config in ipairs(cfgList) do
            local rewards = config.rewards
            for i = 1, #rewards do
                local rewardInfo = rewards[i]
                local sid = rewardInfo[1]
                local count = rewardInfo[2]
                if not totalRewards[i] then
                    totalRewards[i] = {}
                end

                if not totalRewards[i][1] or totalRewards[i][1] ~= sid then
                    totalRewards[i][1] = sid
                    totalRewards[i][2] = count
                else
                    totalRewards[i][2] = totalRewards[i][2] + count
                end
            end
        end
    end

    local nowCfg, nextCfg = FirstTestBossModelIns:GetCurAndNextDamageLevelCfg()
    self.damage = FirstTestBossModelIns:GetMaxDamage()
    self.go_table.aortext_level.text =
        _G.GetLangPackValue(90025500078) .. self:GetLevelStr(nil == nowCfg and 0 or nowCfg.lv)
    self.go_table.aortext_damage.text =
        _G.GetLangPackValue(90025500079) .. self:GetDmgStr(_G.GameUtil.NumberToUnitStrFight(self.damage))

    --镇魂街ZHJ-31230 【主任务】beta_0.2.0_jttw贪玩三测ZHJ-33240
    --【客户端】祸乱之源-评级奖励文本显示优化
    local cfg = _G.ConfigManager.season_boss_reward_cfg[self.awardLis[#self.awardLis]]
    if self.damage >= cfg.require and #canGetAwardSidList <= 0 then
        self.go_table.aortext_gotoTip:SetActiveE(1)
        self.go_table.aortext_gotoTip.text = _G.GetLangPackValue(90025500087)
        self.go_table.aorbtn_goto:SetActiveE(0)
    else
        self.go_table.aortext_gotoTip:SetActiveE(noLevel and 1 or 0)
        self.go_table.aortext_gotoTip.text = _G.GetLangPackValue(90025500080)
        self.go_table.aorbtn_goto:SetActiveE(noLevel and 1 or 0)
    end
    self.go_table.aorbtn_get:SetActiveE(noLevel and 0 or 1)
    local isGray = not FirstTestBossModelIns:AwardHasCanGet()
    self.go_table.aorbtn_get:SetGray(isGray)

    if noLevel then
        self.go_table.aortext_label.color = _G.ColorTools.FormatColorByString("414141")
    else
        self.go_table.aortext_label.color = _G.ColorTools.FormatColorByString("914800")
    end

    if not noLevel then
        local rewards = totalRewards
        for _, v in pairs(rewards) do
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                v,
                self.go_table.obj_award,
                function(item)
                    if self:IsNil() then
                        _G.DestroyObject(item.gameObject)
                        return
                    end
                    -- item:SetGou(self.curLayerCfg.id > cfg.id or self.isMaxLayer)
                    if item.ShowNumText then
                        item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    end
                    item.gameObject:SetRectTransformSize(88, 88)
                    -- item.gameObject:SetLocalScaleXYZ(0.68)
                end
            )
        end
    end
    self.go_table.scrollloopvectical_awardList:InitItemData(#self.awardLis, _G.handler(self, self.RefreshList))

    --列表默认跳转到可领取奖励的位置, 若无奖励可领则跳转当前评级等级位置
    local jumpIndex, jumpLevelIndex = -1, -1
    for index, id in ipairs(self.awardLis) do
        local cfg = _G.ConfigManager.season_boss_reward_cfg[id]
        if self.damage < cfg.require then
            break
        end
        jumpLevelIndex = index
        if not FirstTestBossModel:GetInstance():CheckAwardIsGet(cfg.id) then
            jumpIndex = index
            break
        end
    end
    if jumpIndex <= 0 then
        jumpIndex = jumpLevelIndex
    end
    if jumpIndex > 0 then
        --C#下标从0开始
        self.go_table.scrollloopvectical_awardList:ScrollToIndex(jumpIndex - 1)
    end
end

function FirstTestAwardView:RefreshList(index, obj)
    index = index + 1
    ---@type FirstTestAwardView._obj_awardItem_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, index))
    ---@type season_boss_reward_cfg
    local cfg = _G.ConfigManager.season_boss_reward_cfg[self.awardLis[index]]
    tb.aortext_level.text = _G.GetLangPackValue(90025500078) .. self:GetLevelStr(cfg.lv)
    tb.aortext_damage.text =
        _G.GetLangPackValue(90025500079) .. self:GetDmgStr(_G.GameUtil.NumberToUnitStrFight(cfg.require))
    local canGet = self.damage >= cfg.require
    local isGet = FirstTestBossModel:GetInstance():CheckAwardIsGet(cfg.id)
    tb.aorbtn_get:SetActiveE(isGet and 0 or 1)
    tb.aorbtn_get:SetGray(not canGet)
    if canGet then
        tb.aortext_label.color = _G.ColorTools.FormatColorByString("914800")
    else
        tb.aortext_label.color = _G.ColorTools.FormatColorByString("414141")
    end
    tb.aorimage_complete:SetActiveE(isGet and 1 or 0)
    tb.obj_award:ClearChildren()
    local rewards = cfg.rewards
    for _, v in pairs(rewards) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            v,
            tb.obj_award,
            function(item)
                if self:IsNil() then
                    _G.DestroyObject(item.gameObject)
                    return
                end
                item:SetGou(isGet)
                if item.ShowNumText then
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
                item.gameObject:SetRectTransformSize(88, 88)
                -- item.gameObject:SetLocalScaleXYZ(0.68)
            end
        )
    end
end

function FirstTestAwardView:GetLevelStr(level)
    return "<size=28><color=#c95f00>" .. level .. "</color></size>"
end

function FirstTestAwardView:GetDmgStr(damage)
    return "<color=#6a738f>" .. damage .. "</color>"
end

function FirstTestAwardView:OnClickItem(go, isOn, index)
    local sid = self.awardLis[index]
    if not require "FirstTestBossModel":GetInstance():CheckAwardCanGet(sid) then
        return
    end
    FirstTestBossModel:GetInstance():GetDamageAward(
        {sid},
        function()
            self.go_table.aorbtn_get:SetGray(not require "FirstTestBossModel":GetInstance():AwardHasCanGet())
            self.go_table.scrollloopvectical_awardList:UpdateAllItem()
            self.go_table.aortext_label.color = _G.ColorTools.FormatColorByString("414141")
        end
    )
end

function FirstTestAwardView:GetAllAward()
    require "FirstTestBossModel":GetInstance():GetAllDamageAward(
        function()
            self.go_table.aorbtn_get:SetGray(true)
            self.go_table.scrollloopvectical_awardList:UpdateAllItem()
        end
    )
end

---按钮点击事件在这里派发
function FirstTestAwardView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.aorbtn_goto then
        self:Close()
        local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.FirstTestBossView.Name)
        if ctrl then
            ctrl:OnFight()
        end
    elseif go == self.go_table.aorbtn_get then
        self:GetAllAward()
    end
end

return FirstTestAwardView
