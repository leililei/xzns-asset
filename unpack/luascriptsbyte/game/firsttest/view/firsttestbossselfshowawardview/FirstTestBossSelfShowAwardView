---监听界面
---@param name string 界面名称
function FirstTestBossSelfShowAwardView:OnUIClosed(name)
    if name == _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name then
        if self.callback then
            self.callback()
        end
        if self.call then
            self.call(require "SettlementModel".FunctionEnum.None)
        end
        self:Close()
    end
end

function FirstTestBossSelfShowAwardView:InitPanel()
    local cfg, nextCfg = require "FirstTestBossModel":GetInstance():GetCurAndNextDamageLevelCfg(self.damages)
    local maxCfg, maxNextCfg = require "FirstTestBossModel":GetInstance():GetCurAndNextDamageLevelCfg()
    -- local damage = require "FirstTestBossModel":GetInstance():GetMaxDamage()
    local isMax = cfg and cfg.id == nextCfg.id or false
    self.go_table.slider_damage.value = isMax and 1 or self.damages / maxNextCfg.require
    self.go_table.aortext_damageLv.text = _G.GetLangPackValue(90000011081, maxCfg and maxCfg.lv or 0)
    self.go_table.aortext_damage.text =
        _G.GameUtil.NumberToUnitStrFight(self.damages) .. "/" .. _G.GameUtil.NumberToUnitStrFight(maxNextCfg.require)
    self.go_table.obj_new:SetActiveE(self.damages > self.maxDamage and 1 or 0)

    local dayDamage = require("FirstTestBossModel"):GetInstance():GetDayDamage() or 0
    local haveNextIndex = require("FirstTestBossModel"):GetInstance():CheckNextIndex()
    self.go_table.obj_difficulty:SetActiveE(haveNextIndex and dayDamage >= maxNextCfg.require and 1 or 0)
    if haveNextIndex and dayDamage >= maxNextCfg.require then
        local index = require("FirstTestBossModel"):GetInstance().infoData.index or 1
        self.go_table.aortext_difficulty.text = _G.GameUtil.FormatRomeNum(index + 1)
    end
end

---解析结算奖励
function FirstTestBossSelfShowAwardView:SetAwardCount()
    local count = 0
    local count1 = 0
    if self.AwardData and not _G.table.isEmptyOrNil(self.AwardData) then
        count = _G.table.count(self.AwardData)
    end
    if self.ExtraAward and not _G.table.isEmptyOrNil(self.ExtraAward) then
        count = _G.table.count(self.ExtraAward)
    end
    self.awardCount = count + count1
    if self.awardCount <= 0 then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_ScrollView, false)
    end
end

---初始化胜利界面加载特效
function FirstTestBossSelfShowAwardView:InitV()
    if self.awardCount > 0 then
        if self.AllItem == nil then
            self.AllItem = {}
        end
        self.CreateCount = 0
        self:ParseAward(self.AwardData, self.ExtraAward)
        self:SortAward()
        self:CreateItem(self.Award)
    end
end

---奖励排序
function FirstTestBossSelfShowAwardView:SortAward()
    local StorageManager = _G.StorageManager:GetInstance()
    local StorageType = _G.StorageType
    _G.SortList(
        self.Award,
        function(data)
            local sid = data._award[1]
            local type = StorageManager:CheckSidType(sid)
            local grade = StorageManager:GetItemGrade(sid)
            local order = 1
            if type == StorageType.Equipment then
                order = 3
            elseif type == StorageType.Prop or type == StorageType.Material then
                order = 2
            end
            return order, grade, -sid
        end
    )
end

function FirstTestBossSelfShowAwardView:CreateItem(award)
    local awardItem
    if award and not _G.table.isEmptyOrNil(award) then
        local count = #award
        for i = 1, count do
            local goTable
            awardItem = _G.InstantiateObject(self.go_table.obj_item, self.go_table.obj_AwardContent)
            _G.table.insert(self.AllItem, awardItem:GetComponentE(typeof(CS.UnityEngine.RectTransform)))
            goTable = _G.GetAutoGoTable(awardItem)
            goTable.sid = award[i]._award[1]
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                award[i]._award,
                goTable.obj_root,
                function(tran)
                    tran.gameObject:SetLocalPosition(0, 0, 0)
                    tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    self.CreateCount = self.CreateCount + 1
                    if _G.AppSetting.DEBUG then
                        _G.Log(self.CreateCount, "InitV,奖励个数")
                    end
                    if self.CreateCount == self.awardCount then
                        self:ShowAward()
                    end
                    tran.gameObject:SetActiveE(1)
                end,
                function()
                    self:ClickAward(goTable)
                end
            )
            awardItem:SetActiveE(1)
            _G.GameUtil.SetActiveByCondition(goTable.aorimage_extra, award[i]._extra)
        end
    end
end

function FirstTestBossSelfShowAwardView:ClickAward(goTable)
    local type = _G.StorageManager:GetInstance():CheckSidType(goTable.sid)
    if type == _G.StorageType.Card then
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnCommonIllustrationsViewShow, self)
    end
    require("CommonTipManager"):GetInstance():OpenTip(goTable.gameObject, goTable.sid)
end

function FirstTestBossSelfShowAwardView:OnCommonIllustrationsViewShow(name)
    if name == _G.ConfigManager.ui_cfg.CommonIllustrationsH5View.Name then
        _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnCommonIllustrationsViewShow, self)
    end
end

function FirstTestBossSelfShowAwardView:ParseAward(award, extraAward)
    self.Award = {}
    local Award = {}
    if award and not _G.table.isEmptyOrNil(award) then
        for k, v in pairs(award) do
            _G.table.insert(Award, {_award = v, _extra = false})
        end
    end
    if extraAward and not _G.table.isEmptyOrNil(extraAward) then
        for k, v in pairs(extraAward) do
            _G.table.insert(Award, {_award = v, _extra = true})
        end
    end
    if not _G.table.isEmptyOrNil(Award) then
        _G.SortList(
            Award,
            function(a)
                local storageID = _G.StorageManager:GetInstance():CheckSidType(a._award[1])
                local extra = a._extra and 0 or 1
                return storageID, a._award[1], extra
            end
        )
    end
    self.Award = Award
end

function FirstTestBossSelfShowAwardView:ShowAward()
    if not self.AllItem then
        return
    end
    if #self.AllItem > 8 then
        self.Scroll.vertical = true
    end
    for _, v in pairs(self.AllItem) do
        v:SetActiveE(1)
    end
end

---按钮点击事件在这里派发
function FirstTestBossSelfShowAwardView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_BG" or name == "@_aorbtn_back" then
        local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name)
        if ctrl then
            ctrl:CloseCall(require "SettlementModel".FunctionEnum.None)
        end
        if self.callback then
            self.callback()
        end
        if self.call then
            self.call(require "SettlementModel".FunctionEnum.None)
        end
        self:Close()
    elseif name == "@_aorbtn_static" then
        self:ShowStatisticsView()
    end
end

---显示战斗消息
function FirstTestBossSelfShowAwardView:ShowStatisticsView()
    local data = _G.BattleManager:GetInstance():GetStatistics()
    local count = #data.FighterInfo
    local damage = {}

    local win = {}

    for i = 1, count do
        local statisticsData = data.FighterInfo[i]
        local statisticsMax = {DmgOut = 1, DmgIn = 1, HpRecover = 1, CreateGuard = 1}
        for j = 1, #statisticsData.Attacker do
            if statisticsMax.DmgOut < statisticsData.Attacker[j].DmgOut then
                statisticsMax.DmgOut = statisticsData.Attacker[j].DmgOut
            end

            if statisticsMax.DmgIn < statisticsData.Attacker[j].DmgIn then
                statisticsMax.DmgIn = statisticsData.Attacker[j].DmgIn
            end

            if statisticsMax.HpRecover < statisticsData.Attacker[j].HpRecover then
                statisticsMax.HpRecover = statisticsData.Attacker[j].HpRecover
            end
            if statisticsMax.CreateGuard < statisticsData.Attacker[j].CreateGuard then
                statisticsMax.CreateGuard = statisticsData.Attacker[j].CreateGuard
            end
        end
        for j = 1, #statisticsData.Defender do
            if statisticsMax.DmgOut < statisticsData.Defender[j].DmgOut then
                statisticsMax.DmgOut = statisticsData.Defender[j].DmgOut
            end

            if statisticsMax.DmgIn < statisticsData.Defender[j].DmgIn then
                statisticsMax.DmgIn = statisticsData.Defender[j].DmgIn
            end

            if statisticsMax.HpRecover < statisticsData.Defender[j].HpRecover then
                statisticsMax.HpRecover = statisticsData.Defender[j].HpRecover
            end
            if statisticsMax.CreateGuard < statisticsData.Defender[j].CreateGuard then
                statisticsMax.CreateGuard = statisticsData.Defender[j].CreateGuard
            end
        end
        local CombMax = {DmgOut = 1, CreateGuard = 1, HpRecover = 1}
        for j = 1, #statisticsData.AtkCombineSkills[1] do
            if CombMax.DmgOut < statisticsData.AtkCombineSkills[1][j].DmgOut then
                CombMax.DmgOut = statisticsData.AtkCombineSkills[1][j].DmgOut
            end

            if CombMax.CreateGuard < statisticsData.AtkCombineSkills[1][j].CreateGuard then
                CombMax.CreateGuard = statisticsData.AtkCombineSkills[1][j].CreateGuard
            end

            if CombMax.HpRecover < statisticsData.AtkCombineSkills[1][j].HpRecover then
                CombMax.HpRecover = statisticsData.AtkCombineSkills[1][j].HpRecover
            end
        end
        for j = 1, #statisticsData.DefCombineSkills[1] do
            if CombMax.DmgOut < statisticsData.DefCombineSkills[1][j].DmgOut then
                CombMax.DmgOut = statisticsData.DefCombineSkills[1][j].DmgOut
            end

            if CombMax.CreateGuard < statisticsData.DefCombineSkills[1][j].CreateGuard then
                CombMax.CreateGuard = statisticsData.DefCombineSkills[1][j].CreateGuard
            end

            if CombMax.HpRecover < statisticsData.DefCombineSkills[1][j].HpRecover then
                CombMax.HpRecover = statisticsData.DefCombineSkills[1][j].HpRecover
            end
        end
        local PetMax = {DmgOut = 1, CreateGuard = 1, HpRecover = 1}
        for j = 1, #statisticsData.AtkPetSkills[1] do
            if PetMax.DmgOut < statisticsData.AtkPetSkills[1][j].DmgOut then
                PetMax.DmgOut = statisticsData.AtkPetSkills[1][j].DmgOut
            end

            if PetMax.CreateGuard < statisticsData.AtkPetSkills[1][j].CreateGuard then
                PetMax.CreateGuard = statisticsData.AtkPetSkills[1][j].CreateGuard
            end

            if PetMax.HpRecover < statisticsData.AtkPetSkills[1][j].HpRecover then
                PetMax.HpRecover = statisticsData.AtkPetSkills[1][j].HpRecover
            end
        end
        for j = 1, #statisticsData.DefPetSkills[1] do
            if PetMax.DmgOut < statisticsData.DefPetSkills[1][j].DmgOut then
                PetMax.DmgOut = statisticsData.DefPetSkills[1][j].DmgOut
            end

            if PetMax.CreateGuard < statisticsData.DefPetSkills[1][j].CreateGuard then
                PetMax.CreateGuard = statisticsData.DefPetSkills[1][j].CreateGuard
            end

            if PetMax.HpRecover < statisticsData.DefPetSkills[1][j].HpRecover then
                PetMax.HpRecover = statisticsData.DefPetSkills[1][j].HpRecover
            end
        end
        _G.table.insert(
            damage,
            {statisticsData = statisticsData, statisticsMax = statisticsMax, CombMax = CombMax, PetMax = PetMax}
        )
        _G.table.insert(win, 0)
    end
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name,
        damage,
        win,
        function()
            if self.waitTimer ~= nil then
                self.waitTimer = _G.TimerManager:GetInstance():GetTimer(1, self.ShowWaitTime, self)
                self.waitTimer:Start()

                if _G.AppSetting.DEBUG then
                    _G.Log("<color=red>" .. "自动推图倒计时继续" .. "</color>")
                end
            end
        end,
        nil,
        self.otherInfo,
        1,
        false,
        nil,
        nil,
        self.re_uid,
        self.reportType
    )
end

function FirstTestBossSelfShowAwardView:OnRecordStart()
    self:Hide()
end

function FirstTestBossSelfShowAwardView:OnRecordEnd()
    self:Show()
end

function FirstTestBossSelfShowAwardView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
    if self.ShowAwardWithButtonView then
        self.ShowAwardWithButtonView:Close()
        self.ShowAwardWithButtonView = nil
    end
end

return FirstTestBossSelfShowAwardView
