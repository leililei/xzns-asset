function FirstTestBossSelfShowAwardView:OpenEmbattleView()
    local result = {}
    result.iSWin = true
    result.statistics = true
    result.btnDisplay = true
    result.back = true
    result.loadedEffect = _G.handler(self, self.LoadedEffectCall)
    result.AwardData = self.AwardData
    result.hidePlayerInfo = true
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
    self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
end

