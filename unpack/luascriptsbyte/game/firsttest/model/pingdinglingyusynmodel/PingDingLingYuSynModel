local base = require "ActivitySynTypeBase"
---@class PingDingLingYuSynModel : ActivitySynTypeBase	中文描述
local PingDingLingYuSynModel = _G.BaseClass("PingDingLingYuSynModel", base)
-- _G.PingDingLingYuSynModel = PingDingLingYuSynModel
-- local CS = _G.CS
-- local typeof = _G.typeof

---创建对象时,入口构造函数
function PingDingLingYuSynModel:__init()
    self.PingDingLingYuModel = require "PingDingLingYuModel":GetInstance()
    self.PingDingLingYuModel:SetFreshRedPoint(_G.handler(self, self.RefreshRedPoint))
end

--- 网络请求初始化
function PingDingLingYuSynModel:GetDataFormServer()
    self.PingDingLingYuModel:GetInfo(_G.handler(self, self.ParseData))
end
---数据解析完成
function PingDingLingYuSynModel:ParseData()
    base.ParseData(self)
end
function PingDingLingYuSynModel:InitFunction()
    self.PingDingLingYuModel:InitFunction()
end
---进入活动主体
function PingDingLingYuSynModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.PingDingLingYu.Name, self.curActivityClass)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end
function PingDingLingYuSynModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.PingDingLingYu.Name
end
---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function PingDingLingYuSynModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint, self.CheckRedPointByParams}
    self.redpointTree = {{2}, false}
end
function PingDingLingYuSynModel:CheckRedPoint()
    local cfg = _G.ConfigManager.activity_afk_cfg
    local result
    for k, v in pairs(cfg) do
        result = self.PingDingLingYuModel:ComputeHaveBox(v.conditions)
        if result then
            return 1
        end
    end
    return 0
end
function PingDingLingYuSynModel:CheckRedPointByParams(param)
    return self.PingDingLingYuModel:ComputeHaveBox(param) == true and 1 or 0
end
---刷新奖励红点
function PingDingLingYuSynModel:RefreshRedPoint(type, param)
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(type), param)
end
---获取所有参数
function PingDingLingYuSynModel:GetRedPointParams()
    local temp = {}
    local cfg = _G.ConfigManager.activity_afk_cfg
    for k, v in pairs(cfg) do
        _G.table.insert(temp, v.conditions)
    end
    return temp
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function PingDingLingYuSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self, param)
    end
    return 0
end
