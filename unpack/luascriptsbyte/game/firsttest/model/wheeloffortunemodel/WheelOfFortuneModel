local WheelOfFortuneNet = require "WheelOfFortuneNet"
local base = require "SeasonBaseModel"
---@class WheelOfFortuneModel: SeasonBaseModel
local WheelOfFortuneModel = _G.BaseClass("WheelOfFortuneModel", base)

function WheelOfFortuneModel:__init()
    self.endCallback = nil
    --功能开启判断
    self.curFunctionOpenID = 59
    ---累计招募次数
    self.draw_num = 0
    --已消耗累计招募次数
    self.cost_num = 0
    --已领取的目标奖励
    self.award_list = {}

    self.redPointId = _G.ConfigManager.redpoint_cfg.WheelOfFortune.id
end

---@return WheelOfFortuneModel WheelOfFortuneModel
function WheelOfFortuneModel:GetInstance()
    return self.super.GetInstance(self)
end
---获取招募信息
function WheelOfFortuneModel:GetDataFormServer(Call)
    WheelOfFortuneNet:GetInstance():AccessToMap(
        function(data)
            if data.draw_num ~= nil then
                self.draw_num = data.draw_num
            end
            if data.cost_num ~= nil then
                self.cost_num = data.cost_num
            end
            if data.award_list ~= nil then
                self.award_list = data.award_list
            else
                self.award_list = {}
            end
            if Call ~= nil then
                Call()
            end
            self:ParseData()
        end
    )
    self:GetDataToInf()
end

---招募
function WheelOfFortuneModel:ZhaoMu(num, Call)
    WheelOfFortuneNet:GetInstance():AddBlackListAccess(
        num,
        function(data)
            if data.ack == 1 then
                if Call ~= nil then
                    Call(data)
                end
            else
            end
        end
    )
end

---领取目标奖励
function WheelOfFortuneModel:LingQuaward(num, Call)
    WheelOfFortuneNet:GetInstance():AddBlackListaward(
        num,
        function(data)
            if data.ack == 1 then
                _G.table.insert(self.award_list, num.id)
                _G.StorageManager:GetInstance():ReceiveAwardData(data)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
                if Call ~= nil then
                    Call()
                end
            else
            end
        end
    )
end

---幸运转盘红点
function WheelOfFortuneModel:WheelhongDian()
    local rmb = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.ResProp, _G.ResPropID.Lucky_coin)
    if rmb >= _G.ConfigManager.season_turntable_cfg[101].ticket[2] * 10 then
        return true
    end

    local num = 0
    for i = 101, 107 do
        if
            _G.ConfigManager.season_turntable_goal_cfg[i].times <=
                self.draw_num - (self.cost_num * _G.ConfigManager.season_turntable_goal_cfg[107].times)
         then
            num = num + 1
        end
    end
    if num > _G.table.count(self.award_list) then
        return true
    end

    return false
end

function WheelOfFortuneModel:OnSettlement()
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.WheelOfFortuneView.Name)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.HeroesGatheringView.Name)
end

function WheelOfFortuneModel:OpenView()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WheelOfFortuneView.Name)
end

return WheelOfFortuneModel
