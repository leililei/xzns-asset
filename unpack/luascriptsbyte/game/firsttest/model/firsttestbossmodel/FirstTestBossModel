---获取所有可领取奖励sid
function FirstTestBossModel:GetAwardAllCanGet()
    local sidLis = {}
    local season_boss_reward_cfg = _G.ConfigManager.season_boss_reward_cfg
    local cfg
    for _, v in pairs(self:GetDamageAwardList()) do
        cfg = season_boss_reward_cfg[v]
        if self.infoData.day_dps and self.infoData.day_dps >= cfg.require and not self:CheckAwardIsGet(v) then
            _G.table.insert(sidLis, v)
        end
    end
    return sidLis
end

---是否有可领取的奖励
function FirstTestBossModel:AwardHasCanGet()
    return #self:GetAwardAllCanGet() > 0
end

---获取结算期时长
---@return number
function FirstTestBossModel:GetSettlementDuration()
    local cfg = _G.ConfigManager.discrete_cfg[105116]
    if not cfg then
        return 0
    end
    local hour, min, second = cfg[1][1] or 0, cfg[1][2] or 0, cfg[1][3] or 0
    return 86400 - hour * 3600 - min * 60 - second
end

---是否在结算期中
---@return boolean
function FirstTestBossModel:IsSettlementTime()
    local sd = self:GetSettlementDuration()
    if sd <= 0 or sd >= 86400 then
        return false
    end
    local nowTime = _G.TimeUtil.GetServerUnixTime()
    local endTime = _G.TimeUtil.GetDayBegin(nowTime) + 86400 - sd --战斗期结束时间
    return nowTime >= endTime
end

return FirstTestBossModel
