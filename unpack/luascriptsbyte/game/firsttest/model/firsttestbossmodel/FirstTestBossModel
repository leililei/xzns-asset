---更新伤害
function FirstTestBossModel:UpdateDamages(damage)
    if not damage then
        return
    end
    self.isFirst = false
    if damage > self.infoData.day_dps then
        self.infoData.day_dps = damage
    end
    if self.infoData.all_dps and damage > self.infoData.all_dps then
        self.infoData.all_dps = damage
    end
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FirstBossLv.id)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FirstBoss.id, 1)
    _G.Events:GetInstance():Broadcast(_G.eSeason.SeasonRefreshModel, self.curFunctionOpenID)
end

---更新任务
function FirstTestBossModel:UpdataTask(task)
    if not self.isOpen then
        return
    end
    local isUpdata = false

    if task == nil or task.sid == nil then
        return isUpdata
    end
    local mTask = self:GetTask(task.sid)
    if mTask == nil or not mTask.i_task then
        return isUpdata
    end
    mTask:UpdataData(task)
    return true
end

---获取任务
function FirstTestBossModel:GetTask(id)
    return self.taskList2[id]
end

---检测是否有可领取的任务
function FirstTestBossModel:CheckCanTakeTask()
    for _, v in pairs(self.taskList) do
        if v.i_task.state == _G.TaskEnum.ETaskState.Submited then
            return true
        end
    end
    return false
end

