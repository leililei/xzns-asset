---跳过战斗直接显示结算页面
function FirstTestBossModel:SkipFight()
    --发起战斗结算并显示结算界面
    ---@type BattleControllerFirstTestBoss
    local controller = _G.require(_G.BattleControllerType.FirstTestBoss).New()
    controller.curFightState = 4 --设置战斗结束

    ---对战双方名称
    local bossNameId = self:GetSeasonBossName()
    controller.leftName = _G.PlayerModel:GetInstance():GetName()
    controller.rightName = bossNameId and bossNameId > 0 and _G.GetLangPackValue(bossNameId) or ""

    --检查赛季是否已结束
    if not require "SeasonManager".CheckSeasonIsOpen() then
        _G.PopWindowManager:GetInstance():ShowAllTips(620105)
        controller:QuitToMainWorld()
        return
    end

    --发起战斗结算
    _G.BattleManager:GetInstance():SetInBattle(true)
    require("FirstTestNet"):GetInstance():FightBoss(
        function(msg)
            if not msg or msg.ack ~= 1 then
                _G.BattleManager:GetInstance():SetInBattle(false)
                return
            end
            --计算战斗结果
            -- _G.BattleManager:GetInstance():SetArgDataAutoCmd(msg.args)
            -- local record = _G.BattleManager:GetInstance():GetStatisticsRecord(msg.args)
            -- if not record or not record.result then
            --     _G.BattleManager:GetInstance():SetInBattle(false)
            --     return
            -- end

            _G.BattleManager:GetInstance():SetArgData(msg.args)
            _G.BattleManager:GetInstance():SetStatisticsCached(nil)
            _G.BattleManager:GetInstance():SetBattleController(controller)

            --显示结算界面
            controller.curFightState = 4 --设置战斗结束
            controller:OnFightMsgCall(msg)
            controller:FightResultFunc(nil)
        end
    )
end

