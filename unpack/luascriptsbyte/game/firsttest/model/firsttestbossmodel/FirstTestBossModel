---获取最高伤害
function FirstTestBossModel:GetDayDamage()
    if self.infoData.day_dps == 0 and self.infoData.award then
        self.infoData.award = {}
    end
    return self.infoData.day_dps
end

---获取赛季最高伤害
function FirstTestBossModel:GetMaxDamage()
    return self.infoData.all_dps and self.infoData.all_dps or 0
end

---检查奖励是否已领取
function FirstTestBossModel:CheckAwardIsGet(id)
    if self.infoData.award == nil then
        return false
    end
    return _G.table.ContainsValue(self.infoData.award, id)
end

function FirstTestBossModel:CheckAwardCanGet(id)
    if self:CheckAwardIsGet(id) then
        return false
    else
        local cfg = _G.ConfigManager.season_boss_reward_cfg[id]
        return self:GetMaxDamage() >= cfg.require
    end
end

function FirstTestBossModel:GetDamageAwardList()
    local rewards = self.cfg.rank_reward2 or {}
    if not rewards[self.infoData.index] then
        if _G.AppSetting.DEBUG then
            _G.LogError("season_boss_cfg表的rank_reward2找不到对应的配置, index: " .. tostring(self.infoData.index))
        end
        return rewards[1] or {}
    end
    return rewards[self.infoData.index]
end

---是否有下一个阶段
function FirstTestBossModel:CheckNextIndex()
    local rewards = self:GetDamageAwardList()
    if self.infoData and self.infoData.index and rewards[self.infoData.index + 1] then
        return true
    end

    return false
end

function FirstTestBossModel:GetCurAndNextDamageLevelCfg(damage)
    local season_boss_reward_cfg = _G.ConfigManager.season_boss_reward_cfg
    damage = damage or self:GetMaxDamage()
    local id, cfg, curCfg
    for _, id in ipairs(self:GetDamageAwardList()) do
        cfg = season_boss_reward_cfg[id]
        if damage >= cfg.require then
            curCfg = cfg
        else
            break
        end
    end
    return curCfg, cfg
end

function FirstTestBossModel:GetDamageAward(sidLis, call)
    local pbData = {sid_list = sidLis}
    require("FirstTestNet"):GetInstance():GetDamageAward(
        pbData,
        function(msg)
            if msg.ack == 1 then
                if not self.infoData.award then
                    self.infoData.award = {}
                end
                for _, id in pairs(sidLis) do
                    _G.table.insert(self.infoData.award, id)
                end
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FirstBossLv.id)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                if call then
                    call()
                end
            end
        end
    )
end

