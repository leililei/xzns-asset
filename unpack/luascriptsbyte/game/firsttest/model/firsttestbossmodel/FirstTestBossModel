        if embattleView then
            local bossNameId = self:GetSeasonBossName()
            local bossName = bossNameId and bossNameId > 0 and _G.GetLangPackValue(bossNameId) or ""
            embattleView:SetVsDescription(
                _G.PlayerModel:GetInstance():GetName(),
                bossName
            )
        end
    end
end

