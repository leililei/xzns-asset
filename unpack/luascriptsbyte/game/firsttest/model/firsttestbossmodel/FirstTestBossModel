        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SeasonView.Name)
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.FirstTestBossView.Name)

