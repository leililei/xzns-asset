function FirstTestBossModel:InitTaskList()
    self.taskList = {}
    self.taskList2 = {}
    if self.infoData.task then
        for i, v in ipairs(self.infoData.task) do
            self.taskList[i] = require "SeasonBossTaskData".New(v, nil, _G.MarkTaskType.SeasonBoss)
            self.taskList2[v.sid] = self.taskList[i]
        end
    end
    if self.infoData.finish then
        for _, v in pairs(self.infoData.finish) do
            local task = {sid = v, state = _G.TaskEnum.ETaskState.Completed, target = {[1] = 999}}
            local data = require "SeasonBossTaskData".New(task, nil, _G.MarkTaskType.SeasonBoss)
            _G.table.insert(self.taskList, data)
            self.taskList2[v] = data
        end
    end
end

---获取赛季boss名称
---@return number   语言表id
function FirstTestBossModel:GetSeasonBossName()
    if not self.cfg then
        return 0
    end
    local cfg = _G.ConfigManager.card_cfg[self.cfg.monster]
    if cfg then
        return cfg.Name
    end
    ---@type monster_group_cfg
    local mgCfg = _G.ConfigManager.monster_group_cfg[self.cfg.monster_group]
    if not mgCfg then
        return 0
    end
    for _, sid in pairs(mgCfg.DefaultDefenserSids[1]) do
        local cfg = sid > 0 and _G.ConfigManager.monster_cfg[sid]
        if cfg then
            return cfg.Name
        end
    end
    return 0
end

--region  挑战
---@param skipBattle boolean 是否展示跳过战斗
function FirstTestBossModel:OnChallenge(skipBattle)
    if not require "SeasonManager".CheckSeasonIsOpen() then
        _G.PopWindowManager:GetInstance():ShowAllTips(620105)
        return
    end
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    require "EmbattleController":GetInstance():OpenEmbattle(
        _G.EmbattleType.SeasonBoss,
        _G.EmbattleSaveType.server,
        true,
        _G.EmbattleControllerItemType.seasonBoss,
        _G.handler(self, self.OnExitFight),
        function(_, _, _skipBattle)
            if _skipBattle then
                self:SkipFight()
            else
                self:OnFight()
            end
        end,
        self.cfg.monster_group,
        skipBattle
    )
end

