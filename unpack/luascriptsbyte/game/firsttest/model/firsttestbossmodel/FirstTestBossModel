---更换界面
function FirstTestBossModel:ReturnPanel(isWin)
    self.isChallenge = false
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.SeasonView.Name)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.FirstTestBossView.Name)
    if not require "SeasonManager".CheckSeasonIsOpen() then
        if
            _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.FirstTestBossRankView.Name) and
                _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name)
         then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name)
        end
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.FirstTestBossView.Name)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.FirstTestBossRankView.Name)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.FirstTestBossTaskView.Name)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SeasonView.Name)
    else
        if isWin then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.FirstTestBossView.Name)
            local monsterCfg = _G.ConfigManager.monster_cfg[self.cfg.monster]
            _G.GlobalInterface.OpenFightBossWinView(
                _G.FightBossWinType.SeasonBoss,
                nil,
                nil,
                _G.ConfigManager.card_cfg[monsterCfg.CardID].Portrait,
                _G.GetLangPackValue(monsterCfg.Name),
                _G.ZoneRankType.SeaonBoss,
                    nil,
                monsterCfg.CardID
            )
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FirstTestBossView.Name)
        end
    end
end

