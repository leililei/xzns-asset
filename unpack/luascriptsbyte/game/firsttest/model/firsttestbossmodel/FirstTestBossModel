end

function FirstTestBossModel:ChangeIsFirst()
    if self.isFirst then
        self.isFirst = false
        _G.PlayerPrefsManager.SetInt(Key, self:GetTime())
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FirstBoss.id, 1)
    end
end

function FirstTestBossModel:OnSettlement()
    if not self.isChallenge then
        if
            _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.FirstTestBossRankView.Name) and
                _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name)
         then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name)
        end
        if
            _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.FirstTestBossView.Name) and
                _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.EmbattleView.Name)
         then
            ---@type EmbattleNewView
            local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.EmbattleView.Name)
            ctrl:QuitEmbattle()
        end
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.FirstTestBossView.Name)

        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.FirstTestBossTaskView.Name)

        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.FirstTestBossRankView.Name)
    end
end

function FirstTestBossModel:GetTime()
    local time = _G.TimeUtil.GetServerUnixTime()
    local data = _G.TimeUtil.GetDateTime(time)
    if data.hour < _G.TimeUtil.GAME_DAY_HOUR then
        return _G.TimeUtil.GetDayBegin(time - _G.TimeUtil.GAME_DAY_TIME) + _G.TimeUtil.GAME_DAY_TIME
    else
        return _G.TimeUtil.GetDayBegin(time) + _G.TimeUtil.GAME_DAY_TIME
    end
end

