---检测红点
function FirstTestBossModel:CheckRedPoint(id)
    if id == 0 then
        return self:CheckCanTakeTask()
    elseif id == 1 then
        if self:IsSettlementTime() then
            return false
        end
        return self.isFirst
    end
end

