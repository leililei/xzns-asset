local base = require "GameDataModelBase"
local PingDingLingYuNet = require "PingDingLingYuNet"
local LingRankModel = require "LingRankModel":GetInstance()
---@class PingDingLingYuModel : GameDataModelBase
local PingDingLingYuModel = _G.BaseClass("PingDingLingYuModel", base)
---创建对象时,入口构造函数
function PingDingLingYuModel:__init()
    --self.redPointId = _G.ConfigManager.redpoint_cfg.FirstChapter.id
end
function PingDingLingYuModel:GetInstance()
    return self.super.GetInstance(self)
end

-- function PingDingLingYuModel:GetDataFormServer()
--     self:GetInfo()
-- end

function PingDingLingYuModel:GetInfo(callback)
    ---首通索引
    self.StIndex = 0
    self.callback = callback
    self.Info = {}
    self.Data = {}
    self.PingDingLingYuAwardList = {}
    PingDingLingYuNet:GetInstance():GetInfo(_G.handler(self, self.GetInfoCall))
end

---设置红点刷新
function PingDingLingYuModel:SetFreshRedPoint(RefreshRedPointCall)
    self.RefreshRedPointCall = RefreshRedPointCall
end
function PingDingLingYuModel:RefreshRedPoint(type, param)
    if self.RefreshRedPointCall ~= nil then
        self.RefreshRedPointCall(type, param)
    end
end
---@param msg s2c_activity_recruiting_info
function PingDingLingYuModel:GetInfoCall(msg)
    --任务状态 0 进度不够  1 已领取
    if not _G.table.isEmptyOrNil(msg) then
        for k, v in pairs(msg.info) do
            self.Info[v.sid] = v
        end
    end
    for _, v in pairs(_G.ConfigManager.activity_afk_cfg) do
        self.PingDingLingYuAwardList[v.conditions] = {}
        self.PingDingLingYuAwardList[v.conditions].id = v.id
        self.PingDingLingYuAwardList[v.conditions].conditions = v.conditions
        self.PingDingLingYuAwardList[v.conditions].rewards_first = v.rewards_first
        self.PingDingLingYuAwardList[v.conditions].rewards_all = v.rewards_all
        self.PingDingLingYuAwardList[v.conditions].boss_preview = v.boss_preview
    end
    self:GetSectionInfo()
end
function PingDingLingYuModel:GetSectionInfo()
    LingRankModel:GetDataFormSeverRankNodeInfo(_G.type_rank_enum.guanka, _G.handler(self, self.GetLinlRankNode), 1)
end
function PingDingLingYuModel:GetLinlRankNode()
    if LingRankModel.rankNode then
        self.RankNode = LingRankModel.rankNode.rankList
    end
    local id
    for k, v in pairs(self.RankNode) do
        if self.PingDingLingYuAwardList[v.sid] then
            id = self.PingDingLingYuAwardList[v.sid].id
            if not self.Data[id] then
                self.Data[id] = {}
            end
            self.Data[id].boss_preview = self.PingDingLingYuAwardList[v.sid].boss_preview
            self.Data[id].power = v.powar
            self.Data[id].uid = v.uid
            self.Data[id].playerName = v.playerName
            self.Data[id].title = v.snapshot_title
            self.Data[id].sid = v.sid
            self.Data[id].city_style = v.city_style
            self.Data[id].halo_sid = v.snapshot_halo
            self.Data[id].role_award = v.state > 0 and 1 or 0
            self.Data[id].all_award = v.state > 0 and 1 or 0
            ---state 0未领取 1 可领取 2已领取 3被领取
            if v.state > 0 then
                if self.Info[id] then
                    if _G.PlayerModel:GetInstance():GetPlayerUid() == v.uid then
                        self.Data[id].role_award = self.Info[id].role_award > 0 and 2 or 1
                    else
                        self.Data[id].role_award = self.Info[id].role_award > 0 and 2 or 3
                    end
                    self.Data[id].all_award = self.Info[id].all_award > 0 and 2 or 1
                else
                    if _G.PlayerModel:GetInstance():GetPlayerUid() == v.uid then
                        self.Data[id].role_award = 1
                    else
                        self.Data[id].role_award = 3
                    end
                    self.Data[id].all_award = 1
                end
                if self.StIndex == 0 then
                    self.StIndex = id
                elseif self.StIndex < id then
                    self.StIndex = id
                end
            else
                self.Data[id].all_award = 0
                self.Data[id].role_award = 0
            end
            self.Data[id].rewards_first = self.PingDingLingYuAwardList[v.sid].rewards_first
            self.Data[id].rewards_all = self.PingDingLingYuAwardList[v.sid].rewards_all
        end
        self:RefreshRedPoint(2,self.Data[id].sid)
    end
    if self.callback then
        self.callback()
    end
end
function PingDingLingYuModel:GetAward(id, type, callback)
    PingDingLingYuNet:GetInstance():GetAward(
        id,
        type,
        function(data)
            if data.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            require "CommonTipManager".OpenCommonAwardView(data)
            if type == 1 then
                self.Data[id].role_award = 2
            else
                self.Data[id].all_award = 2
            end
            self:RefreshRedPoint(2, self.Data[id].sid)
            if callback then
                callback()
            end
        end
    )
end
function PingDingLingYuModel:GetCurListIndex()
    local redIndex = self:GetViewShowIndex()
    if redIndex > 0 then
        return redIndex
    elseif self.StIndex > 0 then
        return self.StIndex
    else
        return 1
    end
end
function PingDingLingYuModel:GetViewShowIndex()
    if _G.table.isEmptyOrNil(self.Data) then
        return 0
    end
    for k, v in pairs(self.Data) do
        if v.role_award == 1 or v.all_award == 1 then
            return k
        end
    end
    return 0
end
function PingDingLingYuModel:ComputeHaveBox(sid)
    if _G.table.isEmptyOrNil(self.Data) then
        return false
    end
    for k, v in pairs(self.Data) do
        if v.sid == sid then
            if v.role_award == 1 or v.all_award == 1 then
                return true
            end
        end
    end
    return false
end
function PingDingLingYuModel:Dispose()
end
return PingDingLingYuModel
