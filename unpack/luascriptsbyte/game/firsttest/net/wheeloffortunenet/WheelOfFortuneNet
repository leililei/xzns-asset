---@class WheelOfFortuneNet : BaseGameNet 通信协议
local WheelOfFortuneNet = _G.BaseClass("WheelOfFortuneNet", require("BaseGameNet"))
local base = require("BaseGameNet")
---@return WheelOfFortuneNet WheelOfFortuneNet
function WheelOfFortuneNet:GetInstance()
    return self.super.super.GetInstance(self)
end

--获取幸运转盘信息
---@param callback function 回调方法
function WheelOfFortuneNet:AccessToMap(callback)
    local item = _G.ConfigManager.net_map.game_turntable_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.AccessCall))
    self.Call[port] = callback
end
---抽奖
---@param pbData table PB数据
---@param callback function 完成回调
function WheelOfFortuneNet:AddBlackListAccess(pbData, callback)
    local item = _G.ConfigManager.net_map.game_turntable_draw
    local port = base.Access(self, item, pbData, _G.handler(self, self.AccessCall))
    self.Call[port] = callback
end

---领取目标奖励
---@param pbData table PB数据
---@param callback function 完成回调
function WheelOfFortuneNet:AddBlackListaward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_turntable_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.AccessCall))
    self.Call[port] = callback
end

--获取幸运转盘信息
---@param callback function 回调方法
function WheelOfFortuneNet:AccessToInfo(callback)
    local item = _G.ConfigManager.net_map.game_hero_rally_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.AccessCall))
    self.Call[port] = callback
end

---领取目标奖励
---@param pbData table PB数据
---@param callback function 完成回调
function WheelOfFortuneNet:AddBlackrallyaward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_hero_rally_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.AccessCall))
    self.Call[port] = callback
end
---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function WheelOfFortuneNet:AccessCall(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type WheelOfFortuneNet
return WheelOfFortuneNet
