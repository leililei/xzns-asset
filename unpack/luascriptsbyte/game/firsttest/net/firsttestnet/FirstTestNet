local base = require "BaseGameNet"
---@class FirstTestNet : BaseGameNet	通信协议
local FirstTestNet = _G.BaseClass("FirstTestNet", base)

---@return FirstTestNet FirstTestNet
function FirstTestNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求
---@param pbData table PB数据
---@param callback function 完成回调
function FirstTestNet:GetInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_season_port_info
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end
