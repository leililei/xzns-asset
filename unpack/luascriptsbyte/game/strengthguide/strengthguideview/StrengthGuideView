---@class StrengthGuideView : UIBaseView	中文描述
---@field public go_table StrengthGuideView_GoTable GoTable
local StrengthGuideView = _G.BaseClass("StrengthGuideView", _G.UIBaseView)

local TabType = {
    --功能预览
    FuncPreview = 1,
    --变强
    Strength = 2
}

function StrengthGuideView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eSixUpdate.SixClockUpdate, self.RefreshView)
end

---界面的入口函数
function StrengthGuideView:OnCreate(index)
    ---页签索引，默认选中功能预告
    self.toggleIndex = index or TabType.FuncPreview
    self:InitToggleTab()
     --如果预告奖励全领了就不显示这个页签了 ZHJH-5063
    if require("StrengthGuideModel"):GetInstance():CheckPreviewOver() then 
        self.go_table.toggle_func:SetActiveE(0)
        self.toggleIndex = TabType.Strength
    end
    self:OnClickToggle(self.toggles[self.toggleIndex], true, self.toggleIndex)
end

---底部页签
function StrengthGuideView:InitToggleTab()
    self.toggles = {
        [TabType.Strength] = _G.GetAutoGoTable(
            self.go_table.toggle_strength,
            _G.handlerbind(self, self.OnClickToggle, TabType.Strength)
        ),
        [TabType.FuncPreview] = _G.GetAutoGoTable(
            self.go_table.toggle_func,
            _G.handlerbind(self, self.OnClickToggle, TabType.FuncPreview)
        )
    }
end

function StrengthGuideView:OnClickToggle(go, isOn, index)
    if self.toggleIndex then
        local tb = self.toggles[self.toggleIndex]
        tb.aorimage_isOn:SetActiveE(self.toggleIndex == index and 1 or 0)
        tb.aorimage_isOff:SetActiveE(self.toggleIndex == index and 0 or 1)
    end
    local tb = self.toggles[index]
    tb.aorimage_isOn:SetActiveE(1)
    tb.aorimage_isOff:SetActiveE(0)

    if isOn then
        self.toggleIndex = index
        if index == TabType.Strength then
            require("StrengthGuideModel"):GetInstance():RefreshRedPoint()
        end
        self:RefreshView()
    end
end

function StrengthGuideView:RefreshView()
    self.go_table.obj_strengthPanel:SetActiveE(self.toggleIndex == TabType.Strength and 1 or 0)
    self.go_table.obj_funcPanel:SetActiveE(self.toggleIndex == TabType.FuncPreview and 1 or 0)

    if self.toggleIndex == TabType.Strength then
        self.strengthData = require("StrengthGuideModel"):GetInstance():GetStrengthData()
        if not self.listView then
            self.go_table.scrollloopvectical_itemList:InitItemData(#self.strengthData,
                _G.handler(self, self.OnRefreshItem))
            self.listView = self.go_table.scrollloopvectical_itemList
        else
            self.listView:UpdateCount(#self.strengthData)
        end
        self.go_table.aortext_title.text = _G.GetLangPackValue(18900000090)
    elseif self.toggleIndex == TabType.FuncPreview then
        if not self.funcPreview then
            self.funcPreview = require("StrengthGuideModel"):GetInstance():GetFuncPreview()
        end

        self:GetReceivedList()
        self:GetUnlockFuncList()
        _G.SortList(
            self.funcPreview,
            function(data)
                local order = 1
                if self.receivedFuncList[data.Id] then
                    order = 0
                elseif self.unlockFuncList[data.Id] then
                    order = 2
                end
                return order, -data.sort
            end
        )
        if not self.funcListView then
            self.go_table.scrollloopvectical_func:InitItemData(#self.funcPreview,
                _G.handler(self, self.OnFuncPreviewItem))
            self.funcListView = self.go_table.scrollloopvectical_func
        else
            self.funcListView:UpdateCount(#self.funcPreview)
        end
        self.go_table.aortext_title.text = _G.GetLangPackValue(90022900085)
    end
end

---转换已领取奖励的列表
function StrengthGuideView:GetReceivedList()
    local PlayerModel = _G.PlayerModel:GetInstance()
    self.receivedFuncList = {}
    if PlayerModel.function_preview_award then
        for _, id in ipairs(PlayerModel.function_preview_award) do
            if not self.receivedFuncList[id] then
                self.receivedFuncList[id] = true
            end
        end
    end
end

---已解锁功能
function StrengthGuideView:GetUnlockFuncList()
    local FunctionManager = _G.FunctionManager:GetInstance()
    self.unlockFuncList = {}
    for _, v in ipairs(self.funcPreview) do
        if not self.unlockFuncList[v.Id] and FunctionManager:CheckFunctionIsUnlock(v.Id) then
            self.unlockFuncList[v.Id] = true
        end
    end
end

---获取

function StrengthGuideView:OnRefreshItem(index, obj)
    local data = self.strengthData[index + 1]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, data))
    tb.aortext_title.text = _G.GetLangPackValue(data.name)
    --tb.SkillDesExText = tb.obj_desc:GetComponentE(_G.typeof(_G.CS.ExtendText))
    --tb.SkillDesExText.text = _G.GetLangPackValue(data.desc)
    tb.aortext_desc.text = _G.GetLangPackValue(data.desc)
    tb.aorimage_icon.SpriteName = data.icon
    tb.aortext_getText.text = _G.GetLangPackValue(90022600038)
end

function StrengthGuideView:OnClickItem(_, _, data)
    if data.button_function and data.button_function[1] then
        if data.button_function[1] == "1" then
            _G.JumpManager:GetInstance():Jump(_G.tonumber(data.button_function[2]))
        elseif data.button_function[1] == "2" then
            local viewName = data.button_function[2]
            if viewName == _G.ConfigManager.ui_cfg.InitialView.Name then
                _G.UIManager:GetInstance():OpenWindow(viewName, nil, nil, _G.tonumber(data.button_function[3]))
            elseif viewName == _G.ConfigManager.ui_cfg.DrawGiftPackToggleView.Name then
				--打开英雄集结活动里的礼包
                _G.UIManager:GetInstance():OpenWindow(viewName, nil,  100313, 2)
            else
                _G.UIManager:GetInstance():OpenWindow(viewName)
            end
            self:Close()
        elseif data.button_function[1] == "3" then
            ---类型3作为特殊类型使用
            if data.button_function[2] == "AfkAward" then
                require "AfkModel":GetInstance():CheckAfkAward(
                    function(time, data)
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetawardView.Name, time, data)
                    end
                )
            end
        end
    end
end

function StrengthGuideView:OnFuncPreviewItem(index, obj)
    local data = self.funcPreview[index + 1]
    local tb = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickFuncPreview))
    tb.aortext_title.text = _G.GetLangPackValue(data.name)
    local isUnlock = self.unlockFuncList[data.Id]
    tb.aorimage_icon.SpriteName = data.icon
    if isUnlock then
        tb.aortext_desc.text = _G.GetLangPackValue(90026500035)
    else
        tb.aortext_desc.text = _G.string.format("<color=#8C1906>%s</color>", _G.GetLangPackValue(data.describe))
    end

    tb.obj_award:RemoveAllChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        data.reward,
        tb.obj_award,
        function(item)
            if self:IsNil() then
                _G.DestroyObject(item)
                return
            end

            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            item:SetGou(self.receivedFuncList[data.Id])
        end
    )
    if isUnlock and not self.receivedFuncList[data.Id] then
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_kelingqukuang, tb.obj_award)
        tb.aorbtn_click:SetActiveE(1)
    else
        tb.aorbtn_click:SetActiveE(0)
    end
end

function StrengthGuideView:OnClickFuncPreview(_, _)
    local list = {}
    for _, v in pairs(self.funcPreview) do
        if self.unlockFuncList[v.Id] and not self.receivedFuncList[v.Id] then
           _G.table.insert(list, v.Id)
        end
    end
    require("PlayerInfoNet"):GetInstance():GetFuncPreview(
        {sids = list},
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.PopWindowManager:GetInstance():AddAwardPopQuene(msg)
            _G.PlayerModel:GetInstance():AddFuncPreview(list)
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FuncPreview.id)
            self:RefreshView()
        end
    )
end

---界面的销毁函数
function StrengthGuideView:OnDestroy()
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
function StrengthGuideView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

return StrengthGuideView
