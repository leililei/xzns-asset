---@class StrengthGuideModel : Singleton	中文描述
local StrengthGuideModel = _G.BaseClass("StrengthGuideModel", _G.Singleton)
_G.StrengthGuideModel = StrengthGuideModel

---@return StrengthGuideModel StrengthGuideModel
function StrengthGuideModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function StrengthGuideModel:__init()
    ---@type table 类型列表
    self.typeList = {}
    ---@type table<type_title, power_up> 安装类型缓存数据
    self.strengthData = {}
    ---功能解锁
    self.unlockFunction = {}
    ---功能预览
    self.functionPreview = {}

    local cfg = _G.ConfigManager.power_up
    for _, v in pairs(cfg) do
        if not self.strengthData[v.type_title] then
           self.strengthData[v.type_title] = {} 
        end
        if not _G.table.indexof(self.typeList, v.type_title) then
            _G.table.insert(self.typeList, v.type_title)
        end

        _G.table.insert(self.strengthData[v.type_title], v)
    end

    local previewCfg = _G.ConfigManager.function_preview_cfg
    for _, v in pairs(previewCfg) do
        _G.table.insert(self.functionPreview, v)
    end
    
    ---排序
    _G.SortList(
        self.typeList,
        function(type)
            return -type
        end
    )
    for _, v in pairs(self.strengthData) do
        _G.SortList(v, function(data)
            return -data.id
        end)
    end
end

---新功能解锁,配了的功能才刷新红点
function StrengthGuideModel:FunOpen(mainFunid)
    if mainFunid and (_G.ConfigManager.function_preview_cfg[mainFunid] or mainFunid == 276) then
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FuncPreview.id)
    end
end

--region 变强
---获取类型列表
function StrengthGuideModel:GetTypeList()
    return self.typeList
end

---获取变强引导的显示数据
---@return table
function StrengthGuideModel:GetStrengthData()
    local dataList = {}
    if self.typeList then
        for _, type in ipairs(self.typeList) do
            local data = self:CheckUnlockFunByType(type)
            if data then
                _G.table.insert(dataList, data)
            end
        end
    end
    return dataList
end

---类型1是活动，活动检查是否开启和结束
function StrengthGuideModel:CheckActivity(config)
    if not self:CheckFuncCond(config) then
       return false 
    end

    ---首充
    if config.recharge then
        local cashData = require("InitialManager"):GetInstance().cashData
        if not cashData[config.recharge] then
            return true
        end
    end

    ---英雄集结活动
    if config.id == 104 then
        ---新手制胜礼包
        -- local model = require("NoviceGiftPackModel"):GetInstance()
        -- if model.seasonId and _G.TimeUtil.GetServerUnixTime() < model:GetEndTime() then
        --     return true
        -- end

        local data = require "ActivitySynManager":GetInstance():GetChildAcitivity(10014, 100313)
        local actEndTime = 0
        if data then
            actEndTime = data.cfg.time.start_time + data.cfg.time.run_time
        end
        local bol = actEndTime ~= 0 and _G.TimeUtil.GetServerUnixTime() <= actEndTime
        return bol
    end

    return false
end

---检查功能是否解锁
function StrengthGuideModel:CheckFuncCond(config)
    if not self.unlockFunction[config.desc] then
        local unlock = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(config.function_id)
        self.unlockFunction[config.desc] = unlock
    end

    return self.unlockFunction[config.desc]
end

---检查入口是否开启
function StrengthGuideModel:CheckOpenFunction()
    for _, v in pairs(self.strengthData) do
        if self:CheckFuncCond(v) and (v.type_title ~= 1 or self:CheckActivity(v)) then
            return true
        end
    end

    return false
end

---检测该类型的功能是否解锁
function StrengthGuideModel:CheckUnlockFunByType(type)
    local data = self.strengthData[type] or {}
    local unlockFunction
    for _, v in ipairs(data) do
        ---@type number 类型1是表示活动，活动结束或未开启都不显示 
        if v.type_title == 1 then
            if self:CheckActivity(v) then
                return v
            end
        else
            unlockFunction = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(v.function_id)
            if unlockFunction then
                return v
            end
        end
    end
    return
end

---跳转活动
function StrengthGuideModel:JumpInitialView(id)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.InitialView.Name, nil, true, id)
end

---新手制胜礼包
function StrengthGuideModel:JumpNoviceGiftPackView()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.JumpNoviceGiftPackView.Name)
end

---检测红点
function StrengthGuideModel:CheckRedPoint()
    local status = _G.PlayerPrefsManager.GetInt("_StrengthGuideModel", 0)
    return status == 0 and 1 or 0
end

---刷新红点
function StrengthGuideModel:RefreshRedPoint()
    local status = _G.PlayerPrefsManager.GetInt("_StrengthGuideModel", 0)
    if status == 0 then
        _G.PlayerPrefsManager.SetInt("_StrengthGuideModel", 1)
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.StrengthGuide.id)
    end
end
--endregion

--region 功能预览
function StrengthGuideModel:GetFuncPreview()
    return self.functionPreview or {}
end

function StrengthGuideModel:CheckFuncRedPoint()
    local award = _G.PlayerModel:GetInstance().function_preview_award or {}
    local FunctionManager = _G.FunctionManager:GetInstance()
    for _, v in pairs(self.functionPreview) do
        if FunctionManager:CheckFunctionIsUnlock(v.Id) and not _G.table.indexof(award, v.Id) then
            return 1
        end
    end
    return 0
end

--功能预览奖励是否全领取了
function StrengthGuideModel:CheckPreviewOver()
    local award = _G.PlayerModel:GetInstance().function_preview_award or {}
    local FunctionManager = _G.FunctionManager:GetInstance()
    for _, v in pairs(self.functionPreview) do
        if not _G.table.indexof(award, v.Id) then
            return false
        end
    end
    return true
end

--endregion

---销毁对象时,析构函数
function StrengthGuideModel:Dispose()
end

return StrengthGuideModel