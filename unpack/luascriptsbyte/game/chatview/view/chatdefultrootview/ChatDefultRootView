---@class ChatDefultRootView : UIBaseView	中文描述
---@field public go_table ChatDefultRootView_GoTable GoTable
local ChatDefultRootView = _G.BaseClass("ChatDefultRootView", _G.UIBaseView)
--_G.ChatDefultRootView = ChatDefultRootView
local isDefult
function ChatDefultRootView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param pos table {x=0,y=0} 坐标
function ChatDefultRootView:OnCreate(pos)
    self:AddMinChatItem(_G.MainManager:GetInstance():GetLastChat())
    _G.Events:GetInstance():AddListener(_G.eChatStatus.MainNewChat, self.OnAddMinChatItem, self)
    -- self:SetChatRootPos(pos)
    self:AddListener(_G.VideoPlayState.PlayStart, self.OnHide)
    self:AddListener(_G.VideoPlayState.PlayEnd, self.OnShow)
    self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnWindowChange)
    self:AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnWindowChange)
    self:AddListener(_G.eUIManagerStatus.OnUIHide, self.OnWindowChange)
    self:AddListener(_G.eUIManagerStatus.OnUIShow, self.OnWindowChange)
    self:AddListener(_G.MianViewState.MainViewChangeTab, self.OnWindowChange)

    self.layer = _G.UIManager:GetInstance().TopLayer
    self.canvas = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
    ---@type AorGraphicRaycaster
    self.aorGraphic = self.gameObject:GetComponentE(_G.typeof(_G.CS.AorGraphicRaycaster))
    local chatView = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.ChatView.Name)
    if chatView then
        local canvas = chatView.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
        self.charOrder = canvas.sortingOrder - 100
        self.canvas.sortingOrder = self.charOrder
    else
        self.charOrder = self.canvas.sortingOrder
    end

    self:OnWindowChange()
end

function ChatDefultRootView:OnDestroy()
    self:RemoveAllListener()
end

---设置聊天框位置
function ChatDefultRootView:SetChatRootPos(pos)
    if _G.table.isEmptyOrNil(pos) or not pos.x then
        return
    end
    self.go_table.obj_minChatView:SetAnchorPosition(pos.x, pos.y)
end

---按钮点击事件在这里派发
function ChatDefultRootView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_chatView then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ChatView.Name, self.mainType or _G.ChatType
            .world)
    end
end

---有新聊天信息
---@param data chat.i_chat PB数据
function ChatDefultRootView:OnAddMinChatItem(data)
    if data.type == _G.ChatInfoType.time then
        return
    end
    ---是否显示该频道消息
    local isshow = require("ChatManager"):GetInstance():GetMainHasPindao(data.channel)
    local isUnlock = require("ChatManager"):GetInstance():IsUnLock(data.channel)
    if isshow and isUnlock then
        ---拉黑后不显示消息
        if require("FriendManager"):GetInstance():CheckInBlackList(data.role_info.uid) then
            return
        end
        local pindao = data.channel
        local content = ""
        if data.n_content then
        end

        if data.type == 3 then
            local datafx = _G.Json2Table(data.n_content)
            if datafx.shareType == 1 then
                ---公会
                content = self:NameAddColor(data.role_info.name) .. _G.GetLangPackValue(90000001051)
            elseif datafx.shareType == 2 then
                --战报
                content = self:NameAddColor(data.role_info.name) .. _G.GetLangPackValue(90000001054)
            elseif datafx.shareType == 3 then
                --卡片
                content = self:NameAddColor(data.role_info.name) .. _G.GetLangPackValue(90000001053)
            elseif datafx.shareType == 4 then
                --阵容
                content = self:NameAddColor(data.role_info.name) .. _G.GetLangPackValue(90000001052)
            end
        elseif data.type == _G.ChatInfoType.Push then
            --分享
            content = _G.GetLangPackValue(9002060029)
            pindao = 5
        elseif data.type == _G.ChatInfoType.ShowCultivationPride then
            content = self:NameAddColor(data.role_info.name) .. _G.GetLangPackValue(9002060025)
        elseif data.type == _G.ChatInfoType.PlayerEmoji then
            local str = _G.ConfigManager.expression_cfg[_G.tonumber(data.n_content)]
            if str then
                content = self:NameAddColor(data.role_info.name) .. str.key
            else
                content = self:NameAddColor(data.role_info.name) .. _G.string.removeRichTextSpecal(data.n_content)
            end
        else
            content = self:NameAddColor(data.role_info.name) .. _G.string.removeRichTextSpecal(data.n_content)
        end
        if data.time == nil then
            self.mainTime = _G.TimeUtil.GetServerUnixTime()
            self.mainType = pindao
        elseif self.mainTime == nil then
            self.mainTime = data.time
            self.mainType = pindao
        elseif self.mainTime < data.time then
            self.mainTime = data.time
            self.mainType = pindao
        else
            return
        end
        self:AddMinChatItem(pindao, content)
    end
end

function ChatDefultRootView:AddMinChatItem(pindao, content)
    if pindao == nil then
        return
    end
    if _G.IsNil(self.go_table.obj_minChatItem, self.go_table.obj_minChat) then
        return
    end
    self.mainType = pindao
    local item, goTable

    ---当前主界面小聊天消息队列
    if self.nowMinChatAll == nil then
        self.nowMinChatAll = {}
    end
    if #self.nowMinChatAll >= 3 then
        _G.GameUtil.SetActiveByCondition(self.nowMinChatAll[1], false)
        self.nowMinChatAll[1]:DestroyObject()
        _G.table.remove(self.nowMinChatAll, 1)
    end
    item = _G.InstantiateObject(self.go_table.obj_minChatItem, self.go_table.obj_minChat)
    goTable = _G.GetAutoGoTable(item)

    if pindao == _G.ChatType.world then
        goTable.aortext_pindao.text =
            "<color=#36C959>[" .. _G.ConfigManager.language_package_cfg[9002060002] .. "]</color>"
    elseif pindao == _G.ChatType.system then
        goTable.aortext_pindao.text =
            "<color=#F7972F>[" .. _G.ConfigManager.language_package_cfg[9002060001] .. "]</color>"
    elseif pindao == _G.ChatType.selfWorld then
        goTable.aortext_pindao.text =
            "<color=#c27ef6>{" .. _G.ConfigManager.language_package_cfg[9002060003] .. "}</color>"
    elseif pindao == _G.ChatType.union then
        goTable.aortext_pindao.text =
            "<color=#c73c34>{" .. _G.ConfigManager.language_package_cfg[90010050081] .. "}</color>"
    elseif pindao == _G.ChatType.team then
        goTable.aortext_pindao.text =
            "<color=#68a0f4>{" .. _G.ConfigManager.language_package_cfg[9002060005] .. "}</color>"
    elseif pindao == _G.ChatType.privateChat then
        goTable.aortext_pindao.text =
            "<color=#68a0f4>{" .. _G.ConfigManager.language_package_cfg[90020600025] .. "}</color>"
    elseif pindao == _G.ChatType.unionbattle then
        goTable.aortext_pindao.text =
        "<color=#68a0f4>{" .. _G.ConfigManager.language_package_cfg[90010050081] .. "}</color>"
    end
    -- if goTable.ExtendText == nil then
    --     goTable.ExtendText = goTable.obj_info:GetComponentE(_G.typeof(_G.CS.ExtendText))
    -- end
    -- if goTable.ExtendText ~= nil then
    --     goTable.ExtendText.text = content
    --     goTable.ExtendText.OnHrefClick:AddListener(_G.handler(self, self.OnHrefClick2))
    -- end
    goTable.aortext_info.text = content
    self.ChatTypeId = pindao
    _G.table.insert(self.nowMinChatAll, item)
    _G.GameUtil.SetActiveByCondition(item, true)
end

---给名字加上颜色
function ChatDefultRootView:NameAddColor(str)
    return "<color=#85b7e6>" .. str .. "：</color>"
end

function ChatDefultRootView:OnStartClose()
    _G.Events:GetInstance():RemoveListener(_G.eChatStatus.MainNewChat, self.OnAddMinChatItem, self)
end

function ChatDefultRootView:InitScreen()
    if not isDefult then
        isDefult =
            _G.AppSetting.CONFIG_SCREEN_WIDTH / _G.AppSetting.CONFIG_SCREEN_HEIGHT ==
            _G.AppSetting.SCREEN_WIDTH / _G.AppSetting.SCREEN_HEIGHT
    end
    self.go_table.obj_minChatView:SetRectTransformSize(isDefult and 303 or 378, 0)
end

---更改层级
function ChatDefultRootView:ResetScreen()
    self.go_table.obj_minChatView:SetRectTransformSize(378, 0)
end

---更改层级
function ChatDefultRootView:ChangeLayer()
    if self.layer == _G.UIManager:GetInstance().TopLayer then
        self.gameObject:SetParentE(_G.UIManager:GetInstance().NormalLayer)
        self.canvas.sortingOrder = 1030
        self.layer = _G.UIManager:GetInstance().NormalLayer
        self.aorGraphic.TargetCamera = _G.UIManager:GetInstance().UICamera
    else
        self.gameObject:SetParentE(_G.UIManager:GetInstance().TopLayer)
        self.canvas.sortingOrder = self.charOrder
        self.layer = _G.UIManager:GetInstance().NormalLayer
        self.aorGraphic.TargetCamera = _G.UIManager:GetInstance().UICameraTop
    end
    self.gameObject:SetAnchorPosition(0, 0)
end

---窗口变化事件
---@protected
---@return void
function ChatDefultRootView:OnWindowChange()
    local ctrl = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    local isShow = ctrl and ctrl.View and ctrl.Active
    self.go_table.obj_minChatView:SetActiveE(isShow and 1 or 0)
end

return ChatDefultRootView
