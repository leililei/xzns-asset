function ChatView:GetBattleReportParams(params)
    if not params or type(params.n_content) ~= "string" then
        return nil
    end
    local data = _G.Json2Table(params.n_content)
    local func = data and (BattleReportParamsFunc[data.bct] or BattleReportParamsDefaultFunc)
    if not func then
        return
    end
    return func(data)
end

---有新聊天信息
---@param param chat.i_chat PB数据
function ChatView:OnAddMinChatItem(param)
    if self.isHide then
        self.hasNew = true
    end
    local ChatList
    ---该频道对应的 聊天窗口 looplist.name
    -- local nowChatAorname
    for key, value in pairs(self.ChatypeIndex) do
        --添加对应频道的消息
        if value == param.channel then
            if value == _G.ChatType.privateChat then
                local sendUid = param.role_info.uid
                ---如果是我自己发送的  看我发送给谁的消息
                if param.is_self == 1 then
                    sendUid = param.f_uid
                end
                ChatList = self:GetChatList(key, sendUid)
            else
                ChatList = self:GetChatList(key)
            end
            table.insert(ChatList, param)
            --nowChatAorname = key
            break
        end
    end
    local t_DataCount = #ChatList
    --如果 之前的消息 不是显示最新的 就显示新消息提示
    local t_oldIndex = t_DataCount - 1

    local maxcount = self.ChatSaveCountDic[param.channel]

    --数据最多200条
    -- if t_DataCount > maxcount then
    --     --删除多余旧数据
    --     table.remove(ChatList, 1)
    --     t_DataCount = maxcount
    -- end

    ---如果当前不是 该消息频道
    if self.ChatypeIndex[self.nowChatlooplist:GetName()] ~= param.channel then
        return
    end
    require "ChatManager":GetInstance():SetIsRead(param.channel, false)
    -- --索引是从0开始的 +1 与当前总条数同步
    local t_nowIndex = self.nowChatlooplist:GetViewShowMaxIndex() + 1
    --如果当前不是显示最新消息
    if t_nowIndex < t_oldIndex then
        --只有非时间消息  才未读计数
        if param.type ~= _G.ChatInfoType.time then
            self.now_liaotianCount = self.now_liaotianCount + 1
        end
        self.nowChatlooplist:SetListItemCount(t_DataCount)
        --未读消息 条数text设置
        self:Set_newchattmp()
        -- 新消息提示显示
        self:isShow_aorbtn_newchatbg(true)
    else
        self.now_liaotianCount = 0
        self:isShow_aorbtn_newchatbg(false)
