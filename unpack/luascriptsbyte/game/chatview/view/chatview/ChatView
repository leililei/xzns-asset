    local m_Textinfo = goTable.obj_Textinfo:GetComponentE(typeof(CS.ExtendText))
    local outLine = goTable.obj_Textinfo:GetComponentE(typeof(CS.TextOutline))

    goTable.m_Textinfo = m_Textinfo
    goTable.m_Textinfo.text = params.n_content
    goTable.aortext_title.text = params.unionbattle and params.unionbattle or _G.LangUtil.GetLangPackValue(90021100040)
    -- goTable.m_Textinfo.text =
    --     "<color=#ffffff>\u{00A0}\u{00A0}" ..
    --     _G.LangUtil.GetLangPackValue(90021100040) .. "</color>\u{00A0}\u{00A0}\u{00A0}" .. params.n_content
    --标记 该item 已添加过事件
    if goTable.OnHrefClick == nil then
        goTable.OnHrefClick = true
        --超链接监听 防止重复
        goTable.m_Textinfo.OnHrefClick:AddListener(_G.handler(self, self.OnHrefClick2))
        --     goTable.obj_Textinfo.z_GifM = self.gameObject:GetComponentE(typeof(CS.zGifManger))
        --     goTable.obj_Textinfo:SetzGif()
    end
    if goTable.aorbtn_XuanZho then
        goTable.aorbtn_XuanZho:SetActiveE(0)
    end
    if goTable.aorbtn_fuzhi then
        goTable.aorbtn_fuzhi:SetActiveE(0)
    end
    if params.reportid then
        local gbrc = _G.ConfigManager.guild_battle_report_cfg[params.reportid]
        --TODO 根据表字段判断是否显示背景
        if gbrc.special ~= "" then
            outLine.enabled = true
            goTable.aorrawimage_logbg:SetActiveE(1)
            --TODO 显示对应背景
            goTable.aorrawimage_logbg:LoadImage(gbrc.special)
            _G.GameUtil.ReBuildRTF(goTable.obj_Textinfo)
            local x, y = goTable.obj_Textinfo:GetRectTransformSize()
            local title = goTable.aortext_title.text
            local color = title == _G.GetLangPackValue(90021800336) and "1461A8" or "E60000"
            goTable.aortext_title.text = "<color=#" .. color .. ">【" .. title .. "】</color>"
            goTable.aorimage_TitleBg.color = _G.ColorTools.FormatColorByString("FFFFFF00")
            goTable.obj_bg:GetComponentE(_G.typeof(_G.CS.AorImage)).color = _G.ColorTools.FormatColorByString("FFFFFF00")
            goTable.aorimage_TitleBg:SetLocalPosition(8, -24)
            goTable.aorrawimage_logbg:SetLocalPosition(276, 7)
            goTable.aorrawimage_logbg:SetRectTransformSize(552, y + 40)
        else
            outLine.enabled = false
            goTable.aorrawimage_logbg:SetActiveE(0)
            goTable.aorimage_TitleBg:SetLocalPosition(-2, -43)
            goTable.aorimage_TitleBg.color = _G.ColorTools.FormatColorByString("FFFFFFFF")
            goTable.obj_bg:GetComponentE(_G.typeof(_G.CS.AorImage)).color = _G.ColorTools.FormatColorByString("FFFFFFFF")
        end
    end
    local rtf_Tmp = goTable.obj_bg:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    local tf = item:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(rtf_Tmp)
    local x, y = rtf_Tmp:GetRectTransformSizeDelta()
    tf:SetSizeWithCurrentAnchors(CS.UnityEngine.RectTransform.Axis.Vertical, y)
end

---发送消息 网络回调
---@param param chat.s2c_chat PB数据
function ChatView:CallSendChat(param, msg)
    if _G.IsNil(param) or _G.IsNil(param.ack) then
        _G.PopWindowManager:GetInstance():ShowAllTips(160105)
        return
    end
    if param.ack == 1 then
        require("ChatManager"):GetInstance():SetPinDaoSendTime(self:GetNowPindao())

        self:Start_sendTimer(require("ChatManager"):GetInstance():GetPinDaoSendTime(self:GetNowPindao(), true))
        if self.MyChannelRecordStrArr ~= nil then
            require("ChatManager"):GetInstance().SaveMyChannelRecordKey(self.MyChannelRecordStrArr)
        end

        --- 以服务器返回的内容为准  (违禁字 处理后)
        if not _G.IsNil(param.content) and not string.IsNullOrEmpty(param.content) then
            msg.chat.n_content = param.content
        end
        if not _G.IsNil(param.time) then
            msg.chat.time = param.time
        end
        require("ChatManager"):GetInstance():P2C_NewChat(msg)
        -- elseif param.ack == "chat_open_fun_condition" then
        --     _G.PopWindowManager:GetInstance():ShowAllTips(160106)
        -- elseif param.ack == "chat_content_none" then
        --     _G.PopWindowManager:GetInstance():ShowAllTips(160107)
        -- elseif param.ack == "chat_size_limit" then
        --     _G.PopWindowManager:GetInstance():ShowAllTips(160108)
        -- elseif param.ack == "chat_channel_error" then
        --     _G.PopWindowManager:GetInstance():ShowAllTips(160109)
        -- elseif param.ack == "chat_time_err" then
        --     _G.PopWindowManager:GetInstance():ShowAllTips(160110)
        -- else
        --     _G.PopWindowManager:GetInstance():ShowAllTips(1001, param.ack)
    end
    self.MyChannelRecordStrArr = nil
end

