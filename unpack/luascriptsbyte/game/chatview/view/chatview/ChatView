            if require "ActivityDispatchModel":GetInstance():GetActivity() ~= nil then
                require "ActivityDispatchModel":GetInstance():JumpView()
                self:Close()
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(650104)
            end
        end
    end
    ---分享功能取独立数据
    if params.type == _G.ChatInfoType.share then
        if self:InBattle() then
            _G.PopWindowManager:GetInstance():ShowAllTips(415)
            return
        end
        if self:InPeakMatching() then
            return
        end
        local data = _G.Json2Table(params.n_content)
        if name == "@_aorbtn_ghjion" then
