        temp.DefUid = data.DefUid
        temp.statisticsMax = { DmgOut = 1, DmgIn = 1, HpRecover = 1, CreateGuard = 1 }
        temp.statisticsData = tempData
        for o = 1, #tempData.Attacker do
            if temp.statisticsMax.DmgOut < tempData.Attacker[o].DmgOut then
                temp.statisticsMax.DmgOut = tempData.Attacker[o].DmgOut
            end

            if temp.statisticsMax.DmgIn < tempData.Attacker[o].DmgIn then
