function ChatView:SendFun(num)
    local nowSendStr = self.go_table.input_input.text
    nowSendStr = nowSendStr and _G.string.removeRichTextSpecal(nowSendStr) or nil
    if not nowSendStr or nowSendStr == "" then
        _G.PopWindowManager:GetInstance():ShowAllTips(160102)
        return
    end
    if require("ChatManager"):GetInstance():GetPinDaoSendTime(self:GetNowPindao()) > 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(160111)
        return
    end
    if self:GetNowPindao() == _G.ChatType.world and require("ChatManager"):GetInstance().zone_id == 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(418)

        return
    end
    local strarr = require("ChatManager"):GetInstance().GetMyChannelRecordInfo()
    table.insert(strarr, nowSendStr)
    --local isRepeat = _G.CSTextUtils.CheckedSimilarStr(strarr)
    -- if isRepeat == true then
    --     _G.PopWindowManager:GetInstance():ShowAllTips(160104)
    --     return
    -- end
    self.MyChannelRecordStrArr = strarr

    self:OnClick_send(num)
    self.go_table.input_input.textComponent.rectTransform:SetAnchorPosition(0, 0)
    self.go_table.input_input.text = ""
end

