---聊天窗口显示时 统一设置
function ChatView:SetShowView(chatlooplist)
    chatlooplist:SetAsLastSiblingE()

    local childCount = self.go_table.obj_LoopListGroup:GetChildCountE()
    if childCount > 0 then
        --隐藏其他聊天
        for i = 1, childCount - 1 do
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_LoopListGroup:GetChildE(i - 1), false)
        end
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_LoopListGroup:GetChildE(childCount - 1), true)
    end

    if chatlooplist == self.go_table.looplist2_leagueevents then
        self.go_table.aorbtn_emoji:SetActiveE(0)
    else
        self.go_table.aorbtn_emoji:SetActiveE(1)
    end

    self.nowChatlooplist = chatlooplist
    self:UpDataChatView()

    self:isShow_aorbtn_newchatbg(false)
    self:Start_sendTimer(require("ChatManager"):GetInstance():GetPinDaoSendTime(self:GetNowPindao()))
    self:isShow_obj_EmojiView(false)
    self:isShow_obj_EmojiViewevents(false)
    self:isShow_obj_EmojiViewLeagueevents(false)
    self.go_table.obj_empty:SetActiveE(0)
end

function ChatView:UpDataChatView()
    local ChatList = self:GetChatList(self.nowChatlooplist:GetName())
    local len = #ChatList
    if self.nowChatlooplist:GetName() == "$_looplist2_events" then
        _G.GameUtil.InputFieldCharacterLimitNew(self.go_table.input_input, _G.ConfigManager.discrete_cfg[105720][1][1])
        self.go_table.aortext_Placeholder.text = _G.ConfigManager.language_package_cfg[90020300188]
    else
        _G.GameUtil.InputFieldCharacterLimitNew(self.go_table.input_input, 60)
        self.go_table.aortext_Placeholder.text = _G.ConfigManager.language_package_cfg[9002060007]
    end

    ---如果公会没了，不显示公会曾经的内容
    if self.nowChatlooplist:GetName() == "$_looplist2_union" then
        if not require("SociatyManager"):GetInstance():HasSociaty() then
            len = 0
        end
    end
    self.nowLen = len
    if self.updateDelayCor then
        _G.coroutine.stopwaiting(self.updateDelayCor)
        self.updateDelayCor = nil
    end
    self.updateDelayCor = _G.DelayFrameDo(
        function()
            if self:IsNil() then
                return
            end
            self.nowChatlooplist:SetListItemCount(len)
            --显示最新消息
            self.nowChatlooplist:MovePanelToItemIndex(len)
        end
    )
end

---获取聊天记录
function ChatView:GetChatList(chatlooplistName, privateUid)
    local chattype = self.ChatypeIndex[chatlooplistName]
    return self:GetChatListByType(chattype, privateUid)
end

function ChatView:GetChatListByType(chatType, privateUid)
    if privateUid == nil then
        privateUid = self.Zjsl_NowUid
    end
    if self.itemTransDic[chatType] == nil then
        self.itemTransDic[chatType] = {}
    end
    if chatType == _G.ChatType.privateChat and privateUid ~= nil then
        if self.itemTransDic[chatType][privateUid] == nil then
            self.itemTransDic[chatType][privateUid] = {}
        end
        return self.itemTransDic[chatType][privateUid]
    end
    return self.itemTransDic[chatType]
end

function ChatView:OnClick_send(num)
    self:isShow_obj_EmojiView(false)
    self:isShow_obj_EmojiViewevents(false)
    self:isShow_obj_EmojiViewLeagueevents(false)

    ---@type chat.c2s_chat dsd
    local param = {}
    param.channel = self:GetNowPindao()
    --local rwLater = _G.CS.DenyWordModel.Instance:ReplaceWord(self.go_table.input_input.text)
    --
    -- if _G.AppSetting.DEBUG then
    --     _G.Log(rwLater, "全局消息屏蔽完成后??????????")
    -- end
    param.content = self.go_table.input_input.text
    param.f_uid = param.channel == _G.ChatType.privateChat and self.Zjsl_NowUid or 0
    --_G.PlayerModel:GetInstance().role_uid

    param.voice = 0

    ---@type ClintSendChatInfo 本地自己的消息 先显示 忽略服务器广播 防止延迟
    local msg = {}
    msg.channel = param.channel
    msg.n_content = param.content
    msg.f_uid = param.f_uid
    if num ~= nil then
        msg.type = num
        param.type = num
    else
        msg.type = 1
        param.type = 1
    end
    local tipsid
    msg, tipsid = require("ChatManager"):GetInstance():GetNewChatInfo(msg)

    if msg == nil then
        return _G.PopWindowManager:GetInstance():ShowAllTips(tipsid)
    end

    if param.channel == _G.ChatType.events or param.channel == _G.ChatType.leagueevents then
        -- require("ChatViewNet"):GetInstance():FriendSendCHAT(param, _G.handlerbind(self, self.CallSendChat, msg))
        if self.foun ~= nil then
            self.foun(param, _G.handlerbind(self, self.CallSendChat, msg))
        end
    else
        local scene
        if param.channel == _G.ChatType.privateChat then
            scene="5"
        else
            scene="4"
        end
        _G.GameUtil.SecCheck(param.content, scene,function()
            require("ChatViewNet"):GetInstance():SendCHAT(param, _G.handlerbind(self, self.CallSendChat, msg))
        end)
    end
end

