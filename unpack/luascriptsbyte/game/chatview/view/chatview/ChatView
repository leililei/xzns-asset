function ChatView:Private_Init()
    self.go_Private = _G.GetAutoGoTable(self.go_table.obj_private, _G.handler(self, self.OnClick_Private))
    self.go_Private.obj_item:SetActiveE(0)
    self.go_table.obj_private:SetActiveE(0)

    if self.Sworn then
        self:SetSwornMode()
        self.go_Private.aorbtn_addPrivate:SetActiveE(0)
        self.Zjsl_NowUid = self.Sworn
        self.go_table.toggle_floatMessages:SetActiveE(0)

        --单独显示盟约玩家头像
        local msg = {}
        msg.uid = self.Sworn
        require("SystemSettingNet"):GetInstance():GetPlayerInfo(
            msg,
            function(data)
                local tFriendData = require("FriendData").New()
                tFriendData:Init(data.info)
                tFriendData.uid = self.Sworn
                local obj = _G.InstantiateObject(self.go_Private.obj_item, self.go_Private.obj_roles)
                local tb = _G.GetAutoGoTable(obj)
                UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, tFriendData, 0.65, true, false, false, nil)
                tb.aortext_name.text = tFriendData.name
                tb.aorimage_on:SetActiveE(1)
                tb.aorbtn_close:SetActiveE(self.Sworn and 0 or 1)
                obj:SetLocalPosition(-234, 0)
                obj:SetActiveE(1)

                local time = _G.TimeUtil.GetServerUnixTime()
                require("FriendManager"):GetInstance():RedDotnil(self.Zjsl_NowUid, time)
                require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.PrivateChat.id)
            end
        )
    else
        self:UpdatePriviteUids()
        self.go_Private.aorbtn_addPrivate.onClick:AddListener(
            function()
                if not self.PinDaoUnlockDic[_G.ChatType.privateChat].tipsStr then
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ChatPrivateView.Name, self)
                end
            end
        )
    end
end

