            elseif teamInfo and teamInfo.uid then
                _G.PopWindowManager:GetInstance():ShowAllTips(5202)
                return
            elseif not teamBol then
                _G.PopWindowManager:GetInstance():ShowAllTips(5209)
                return
            end

            ---申请加入古神队伍
            ---@type guild.c2s_guild_request
            local msg = {}
            msg.uid = { data.uid }
            local requestFunc = function()
                RelicTeamModel:RequestTeam(
                    msg,
                    function(_msg)
                        if _msg.ack == 1 then
                            if _G.AppSetting.DEBUG then
                                _G.Log("申请加入古神遗迹队伍成功")
                            end
                            if _msg.team then
                                --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicTeamToggleView.Name, "team")
                                _G.JumpManager:GetInstance():Jump(218001)
                            else
                                go:SetGray(true)
                                go.enabled = false
                                local text = go:GetChildE(0):GetComponentE(_G.typeof(_G.CS.AorText))
                                text.text = _G.GetLangPackValue(90100000115)
                                text.color = _G.Color.black
                            end
                        elseif _msg.ack == 5206 then
                            goTable.aortext_memberNum = "(3/3)"
                            go:SetGray(true)
                            go.enabled = false
                            local text = go:GetChildE(0):GetComponentE(_G.typeof(_G.CS.AorText))
                            text.color = _G.Color.black
                        else
                            go:SetGray(true)
                            go.enabled = false
                            local text = go:GetChildE(0):GetComponentE(_G.typeof(_G.CS.AorText))
                            text.color = _G.Color.black
                        end
                    end)
            end
            if not camp or camp == 0 then
                local T = { camp = 1 }
                RelicTeamModel:ChooseCamp(T, function()
                    requestFunc()
                end)
            else
