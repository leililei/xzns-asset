---界面的入口函数
---@  number _G.ChatType默认打开界面
function ChatView:OnCreate(ChatType, dataList, foun, DianJi, Sworn, privateUid)
    --初始化战斗回放参数方法: 全局仅做一次
    if not BattleReportParamsFunc then
        BattleReportParamsFunc = {
            [_G.BattleControllerType.afkChallenge] = function(data)
                if not data.myname or not data.fzsid then
                    return BattleReportParamsDefaultFunc(data)
                end
                ---@type afk_cfg
                local afkCfg = _G.ConfigManager.afk_cfg[data.fzsid]
                if not afkCfg then
                    return BattleReportParamsDefaultFunc(data)
                end
                local afkNameCfg, afkNameId = afkCfg, 0
                while afkNameCfg and afkNameCfg.chapter == afkCfg.chapter do
                    if afkNameCfg.section == 1 or afkNameCfg.Name and #afkNameCfg.Name > 0 then
                        afkNameId = afkNameCfg.Name[1][1]
                        break
                    else
                        afkNameCfg = _G.ConfigManager.afk_cfg[afkNameCfg.pre_section]
                    end
                end
                local afkName
                if afkNameId > 0 then
                    afkName = string.format("%s  %d-%d", _G.GetLangPackValue(afkNameId), afkCfg.chapter, afkCfg.section)
                else
                    afkName = string.format("%d-%d", afkCfg.chapter, afkCfg.section)
                end
                return { tostring(data.myname), afkName }
            end
        }
    end

    if ChatType == nil then
        ChatType = _G.ChatType.world
    end
    if ChatType == _G.ChatType.world and not require("ChatManager"):GetInstance():IsUnLock(_G.ChatType.world) then
        ChatType = _G.ChatType.selfWorld
    end
    self.dataList = dataList or {}
    self.foun = foun
    self.DianJi = DianJi
    self.Sworn = Sworn
    self.tempUids = {}
    if privateUid then
        self:SetPrivateUid(privateUid)
    end
    self:IsBool()
    ---@class ChatView_PinDaoUnlockDic

    ---@type table<number,ChatView_PinDaoUnlockDic_data>
    self.PinDaoUnlockDic = {}
    for _, pindao in pairs(_G.ChatType) do
        ---@field tipsStr string tipsStr
        ---@field isUnlock bool true 频道解锁
        ---@class ChatView_PinDaoUnlockDic_data
        local data = {
            isUnlock = nil,
            tipsStr = nil
        }
        data.isUnlock, data.tipsStr = require("ChatManager"):GetInstance():IsUnLock(pindao)

        self.PinDaoUnlockDic[pindao] = data
    end
    --- 发送间隔 剩余时间
    self.SendTime = -1
    self.StaticEmojiList = nil
    --本地储存聊天消息
    self.itemTransDic = {}
    --  self.go_table.looplist2_system
    self.nowChatlooplist = self.go_table.looplist2_world
    --频道对应  looplist2_name(窗口频道) ----  _G.ChatType(聊天频道枚举)
    self.ChatypeIndex = {}
    --获取全局最新聊天频道所有消息
    self.ChatInfoAll = require("ChatManager"):GetInstance():GetChatInfoAll()
    self:AddUnionBattleLeagueLog()
    self:initlooplist(self.go_table.looplist2_world, _G.ChatType.world)
    self:initlooplist(self.go_table.looplist2_system, _G.ChatType.system)
    self:initlooplist(self.go_table.looplist2_self, _G.ChatType.selfWorld)
    self:initlooplist(self.go_table.looplist2_union, _G.ChatType.union)
    self:initlooplist(self.go_table.looplist2_private, _G.ChatType.privateChat)
    self:initlooplist(self.go_table.looplist2_unionbattle, _G.ChatType.unionbattle)
    self:initlooplist(self.go_table.looplist2_unionMoba, _G.ChatType.unionMoba)
    self:initlooplist(self.go_table.looplist2_unionbattleleague, _G.ChatType.unionbattleleague)
    self:initlooplist(self.go_table.looplist2_leagueevents, _G.ChatType.leagueevents)
    self:Private_Init()
    self:AddUnionBattleLog()
    self:AddUnionMobaLog(ChatType)

    -- self:initlooplist(self.go_table.looplist2_unionMoba, _G.ChatType.unionMoba)
    -- self:initlooplist(self.go_table.looplist2_events, _G.ChatType.events)
    -----------------------------------------------------------------------↓↓↓默认选中系统聊天窗口↓↓
    self.go_table.toggle_events:SetActiveE(0)
    if require("SociatyManager"):GetInstance():HasSociaty() then
        self.go_table.toggle_unionbattle:SetActiveE(self:CheckUnionBattleLog() and 1 or 0)
    else
        self.go_table.toggle_unionbattle:SetActiveE(0)
    end
    if require("SociatyManager"):GetInstance():HasSociaty() then
        self.go_table.toggle_unionbattleleague:SetActiveE(self:CheckUnionBattleLeagueLog() and 1 or 0)
    else
        self.go_table.toggle_unionbattleleague:SetActiveE(0)
    end
    self.go_table.toggle_unionMoba:SetActiveE(ChatType == _G.ChatType.unionMoba and 1 or 0)
    self.go_table.toggle_leagueevents:SetActiveE(
        (ChatType == _G.ChatType.leagueevents or ChatType == _G.ChatType.unionbattleleague) and 1 or 0
    )
    self.chatType = ChatType
    if ChatType ~= nil then
        --self:ViewWorld(false)
        if ChatType == _G.ChatType.privateChat then
            self.go_table.toggle_private.isOn = true
        elseif ChatType == _G.ChatType.system then
            self.go_table.toggle_system.isOn = true
            self:SetShowView(self.go_table.looplist2_system)
            self:isShow_obj_EmojiView(false)
            self:isShow_obj_EmojiViewevents(false)
            self:ViewSysTem(true)
        elseif ChatType == _G.ChatType.world then
            self.go_table.toggle_world.isOn = true
        elseif ChatType == _G.ChatType.selfWorld then
            self.go_table.toggle_selfworld.isOn = true
        elseif ChatType == _G.ChatType.union then
            self.go_table.toggle_union.isOn = true
        elseif ChatType == _G.ChatType.unionbattle then
            self.go_table.toggle_unionbattle.isOn = true
        elseif ChatType == _G.ChatType.unionbattleleague then
            self.go_table.toggle_unionbattleleague.isOn = true
            self:LeagueEvents_init()
            --self:SetShowView(self.go_table.looplist2_unionbattleleague)
            self:ViewUnionBattleLeague(true)
        elseif ChatType == _G.ChatType.unionMoba then
            self.go_table.toggle_unionMoba.isOn = true
        elseif ChatType == _G.ChatType.events or ChatType == _G.ChatType.support then
            self.go_table.toggle_events:SetActiveE(1)
            self.go_table.toggle_events.isOn = true
            self:Events_init()
            self:ViewEvents(true, dataList, foun, DianJi)
            self:SetShowView(self.go_table.looplist2_events)
        elseif ChatType == _G.ChatType.leagueevents then
            self.go_table.toggle_unionbattleleague:SetActiveE(0)
            self.go_table.toggle_leagueevents:SetActiveE(1)
            self.go_table.toggle_leagueevents.isOn = true
            self.go_table.aorbtn_emoji:SetActiveE(0)
            self:LeagueEvents_init()
            --self:SetShowView(self.go_table.looplist2_leagueevents)
            self:ViewLeagueEvents(true, dataList, foun, DianJi)
        end
    else
        self:ViewWorld(true)
        self:SetShowView(self.go_table.looplist2_world)
    end
    -----------------------------------------------------------------------↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑

    if not self.IsAddEvents then
        _G.Events:GetInstance():AddListener(_G.eChatStatus.newChat, self.OnAddMinChatItem, self)
        _G.Events:GetInstance():AddListener(_G.eChatStatus.DelChat, self.UpdateChatInfoAll, self)
        self.IsAddEvents = true
    end

    self.chatSendTIME = require("ChatManager"):GetInstance().chatSendTIME
    -- self:Start_sendTimer(require("ChatManager"):GetInstance():GetPinDaoSendTime(self:GetNowPindao()))

    ---未读消息记录
    self.now_liaotianCount = 0
    -- self.go_table.aortext_newchattmp:SetOutlineWidth(0.8)

    ---消息最大条数
    self.ChatSaveCountDic = require("ChatManager"):GetInstance().ChatSaveCountDic
end

