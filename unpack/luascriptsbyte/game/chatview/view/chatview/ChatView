---初始化聊天视图
function ChatView:initlooplist(chatlooplist, nowChatType)
    self.ChatypeIndex[chatlooplist:GetName()] = nowChatType
    if _G.ChatType.events == nowChatType then
        self.itemTransDic[nowChatType] = self.dataList
    elseif _G.ChatType.leagueevents == nowChatType then
        self.itemTransDic[nowChatType] = self.dataList
    elseif _G.ChatType.selfWorld == nowChatType and self.ChatInfoAll[nowChatType] then
        local list = {}
        local count = #self.ChatInfoAll[nowChatType]
        local SeasonModel = require "SeasonModel":GetInstance()
        for i = 1, count do
            local params = self.ChatInfoAll[nowChatType][i]
            if _G.tonumber(params.n_content[1]) then
                local type = _G.tonumber(params.n_content[1])
                if type == 3 then
                    if SeasonModel:CheckSeasonFucntionIsOpen(80) then
                        table.insert(list, params)
                    end
                elseif type == 2 then
                    if SeasonModel:CheckSeasonFucntionIsOpen(4) then
                        table.insert(list, params)
                    end
                elseif type == 4 then
                    if SeasonModel:CheckSeasonFucntionIsOpen(75) then
                        table.insert(list, params)
                    end
                elseif type == 5 then
                    if SeasonModel:CheckSeasonFucntionIsOpen(135) then
                        table.insert(list, params)
                    end
                elseif type == 1 then
                    if SeasonModel:CheckSeasonFucntionIsOpen(60) then
                        table.insert(list, params)
                    end
                else
                    table.insert(list, params)
                end
            else
                table.insert(list, params)
            end
        end
        self.itemTransDic[nowChatType] = list
    else
        self.itemTransDic[nowChatType] = self.ChatInfoAll[nowChatType]
    end
    chatlooplist:InitListView(0, _G.handlerbind(self, self.RefreshItem, chatlooplist))
    --chatlooplist:RefreshAllShownItem()
    chatlooplist.mOnEndDrag:AddListener(_G.handler(self, self.OnDragEnd_liaotian))
end

--初始化聊天iitem
function ChatView:RefreshItem(listView2, index, chatlooplist)
    if index < 0 then
        return
    end
    local t_index = index + 1

    local t_nowitemTransDic = self:GetChatList(chatlooplist:GetName())
    if t_index <= #t_nowitemTransDic then
        local item
        local shareType
        local params = t_nowitemTransDic[t_index]

        if
            params.channel == _G.ChatType.events or params.channel == _G.ChatType.support or
            params.channel == _G.ChatType.leagueevents
        then
            -- 如果是自己发的消息 则需要居右
            local isMe = _G.PlayerModel:GetInstance().role_uid == params.role_info.uid
            if isMe then
                item = listView2:NewListViewItem("$_obj_chatR")
            else
                item = listView2:NewListViewItem("$_obj_chat")
            end
            self:inititem(item, t_nowitemTransDic, t_index)
            return item
        end
        if params.type == _G.ChatInfoType.time then
            item = listView2:NewListViewItem("$_obj_time")
        elseif params.type == _G.ChatInfoType.system then
            item = listView2:NewListViewItem("$_obj_chat_system")
        elseif params.type == _G.ChatInfoType.ShowCultivationPride then
            item = listView2:NewListViewItem("$_obj_chat_ShowCultivationPride")
        elseif params.type == _G.ChatInfoType.Push then
            item = listView2:NewListViewItem("$_obj_chat_Push")
        elseif params.type == _G.ChatInfoType.share then
            local data = _G.Json2Table(params.n_content)
            local isMe = _G.PlayerModel:GetInstance().role_uid == params.role_info.uid
            shareType = data.shareType
            if shareType == _G.ChatShareType.Card then
                if isMe then
                    item = listView2:NewListViewItem("$_obj_shareCardR")
                else
                    item = listView2:NewListViewItem("$_obj_shareCard")
                end
            elseif shareType == _G.ChatShareType.Guild then
                if isMe then
                    item = listView2:NewListViewItem("$_obj_shareSociatyR")
                else
                    item = listView2:NewListViewItem("$_obj_shareSociaty")
                end
            elseif shareType == _G.ChatShareType.Battle then
                if isMe then
                    item = listView2:NewListViewItem("$_obj_shareReportR")
                else
                    item = listView2:NewListViewItem("$_obj_shareReport")
                end
            end
        elseif params.type == _G.ChatInfoType.StrategyStation then
            local isMe = _G.PlayerModel:GetInstance().role_uid == params.role_info.uid

            if isMe then
                item = listView2:NewListViewItem("$_obj_StrategyStationR")
            else
                item = listView2:NewListViewItem("$_obj_StrategyStation")
            end
        elseif params.type == _G.ChatInfoType.MaidAcademy then
            local isMe = _G.PlayerModel:GetInstance().role_uid == params.role_info.uid

            if isMe then
                item = listView2:NewListViewItem("$_obj_shareMaidAcademyR")
            else
                item = listView2:NewListViewItem("$_obj_shareMaidAcademy")
            end
        elseif params.type == _G.ChatInfoType.ActivityDispatch then
            local isMe = _G.PlayerModel:GetInstance().role_uid == params.role_info.uid
            if isMe then
                item = listView2:NewListViewItem("$_obj_shareActivityDispatchR")
            else
                item = listView2:NewListViewItem("$_obj_shareActivityDispatch")
            end
        elseif params.type == _G.ChatInfoType.RelicTeam then
            local isMe = _G.PlayerModel:GetInstance().role_uid == params.role_info.uid
            if isMe then
                item = listView2:NewListViewItem("$_obj_shareRelicTeamR")
            else
                item = listView2:NewListViewItem("$_obj_shareRelicTeam")
            end
        elseif params.type == _G.ChatInfoType.GuildImpeach then
            local isMe = _G.PlayerModel:GetInstance().role_uid == params.role_info.uid
            if isMe then
                item = listView2:NewListViewItem("$_obj_shareSociatyImpeachR")
            else
                item = listView2:NewListViewItem("$_obj_shareSociatyImpeach")
            end
        elseif params.type == _G.ChatInfoType.GuildMoba then
            local isMe = _G.PlayerModel:GetInstance().role_uid == params.role_info.uid
            if isMe then
                item = listView2:NewListViewItem("$_obj_shareSociatyMobaR")
            else
                item = listView2:NewListViewItem("$_obj_shareSociatyMoba")
            end
        else
            -- 如果是自己发的消息 则需要居右
            local isMe = _G.PlayerModel:GetInstance().role_uid == params.role_info.uid
            if isMe then
                item = listView2:NewListViewItem("$_obj_chatR")
            else
                item = listView2:NewListViewItem("$_obj_chat")
            end
        end
        if item == nil then
            if _G.AppSetting.DEBUG then
                _G.LogError("item==nil ChatView:RefreshItem() 聊天错误的消息类型type=" .. params.type)
            end
            return
        end
        self:inititem(item, t_nowitemTransDic, t_index, shareType)
        _G.GameUtil.ReBuildRTF(item)
        return item
    end
    return nil
end

---初始化 静态表情
function ChatView:RefreshItem_StaticEmoji(trans, index)
    if self.StaticEmojiList == nil then
        self.StaticEmojiList = {}
    end
    local tblIndex = index + 1
    if not self.StaticEmojiList[tblIndex] then
        local go_table = _G.GetAutoGoTable(
            trans,
            function(btn, isOn)
                self:OnClick_EmojiView1(btn, isOn)
            end
        )
        local t_AorImage = trans:GetComponentE(typeof(CS.AorImage))
        ---精灵图片序列
        local sprname = index + 1
        if sprname < 10 then
            sprname = "0" .. sprname
        end
        t_AorImage.SpriteName = "biaoqing" .. sprname
        self.StaticEmojiList[tblIndex] = go_table
    end
end

function ChatView:OnClick_EmojiView1(btn, _)
    local str = "[#" .. btn:GetName() .. "]"
    local newstr = self.go_table.input_input.text .. str
    if string.len(newstr) > 60 then
        _G.PopWindowManager:GetInstance():ShowAllTips(160101)
    elseif string.len(newstr) > _G.ConfigManager.discrete_cfg[105720] and self:GetNowPindao() == _G.ChatType.selfWorld then
        _G.PopWindowManager:GetInstance():ShowAllTips(160101)
    else
        self.go_table.input_input.text = newstr
        self.go_table.input_input:MoveTextEnd(false)
    end

    self:isShow_obj_EmojiViewLeagueevents(false)
    self:isShow_obj_EmojiViewevents(false)
    self:isShow_obj_EmojiView(false)
end

