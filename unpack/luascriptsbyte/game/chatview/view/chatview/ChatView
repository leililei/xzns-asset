function ChatView:OnEnable()
    if not self.IsAddEvents then
        _G.Events:GetInstance():AddListener(_G.eChatStatus.newChat, self.OnAddMinChatItem, self)
        _G.Events:GetInstance():AddListener(_G.eChatStatus.DelChat, self.UpdateChatInfoAll, self)
        self.IsAddEvents = true
    end
    if self.hasNew and self.nowChatlooplist then
        self.hasNew = false
        self.isHide = false
        _G.DelayFrameDo(
            function()
                if self:IsNil() then
                    return
                end
                self.nowChatlooplist:RefreshAllShownItem()
                self.nowChatlooplist:MovePanelToItemIndex(self.nowLen)
                self:isShow_aorbtn_newchatbg(false)
            end
        )
    end
end

function ChatView:OnDisable()
    if self.timersend ~= nil then
        _G.coroutine.stopwaiting(self.timersend)
        self.timersend = nil
    end
    if self.updateDelayCor then
        _G.coroutine.stopwaiting(self.updateDelayCor)
        self.updateDelayCor = nil
    end
    self.isHide = true
end

function ChatView:OnDestroy()
    ---ZHJ-22091 查看分享卡牌时收到新信息，退回聊天未显示
    if self.IsAddEvents then
        _G.Events:GetInstance():RemoveListener(_G.eChatStatus.newChat, self.OnAddMinChatItem, self)
        _G.Events:GetInstance():RemoveListener(_G.eChatStatus.DelChat, self.UpdateChatInfoAll, self)
        self.IsAddEvents = false
    end
    self:RemoveListener(_G.eSociatyBattle.SociatyBattleLog, self.AddUnionBattleLog)
    self:RemoveListener(_G.eSociatyBattleLeague.SociatyBattleLogLeague, self.AddUnionBattleLeagueLog)
    self:RemoveListener(_G.eSociatyMobaBattle.SociatyMobaLog, self.AddUnionMobaLog)
end

---是否在战斗或者布阵中
function ChatView:InBattle()
    if
        _G.BattleManager:GetInstance():CheckInBattle() or
        _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.EmbattleView.Name) or
        _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name) or
        _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.SixVsSixEmbattleView.Name) or
        require("AfkBattleManager"):GetInstance():CheckOpeningEmbattle()
    then
        return true
    end
    return false
end

---是否在巅峰演武中
function ChatView:InPeakMatching()
    local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ArenaPeakView.Name)
    local ctrl1 = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.GMArenaPeakView.Name)
    local ctrl2 = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.GMArenaPeakBPView.Name)
    if ctrl or ctrl1 or ctrl2 then
        _G.PopWindowManager:GetInstance():ShowAllTips(880117)
        return true
        --if ctrl.isMatching then
        --end
    end

    return false
end

