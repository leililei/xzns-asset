function ChatView:ClickZROne(_, i, uid, share_id, cardData)
    if self:InBattle() then
        _G.PopWindowManager:GetInstance():ShowAllTips(415)
        return
    end
    if self:InPeakMatching() then
        return
    end
    ---@type share.c2s_share_get
    local msg = {}
    msg.role_uid = uid
    msg.share_id = share_id
    require "ChatViewNet":GetInstance():GetShareDetail(msg, _G.handlerbind(self, self.ShareDetailBackZr, i, cardData))
end

function ChatView:ShareDetailBackZr(msg, index, cardData)
    local cardsmsg = {}
    for i = 1, #cardData do
        local value = cardData[i]
        if msg.cards then
            for j = 1, #msg.cards do
                local mc = msg.cards[j]
                if mc.sid == value.sid then
                    table.insert(cardsmsg, mc)
                    break
                end
            end
        end
    end

    local cards = {}
    for i = 1, #cardsmsg do
        local mc = cardsmsg[i]
        local cardmc = _G.CardData.New()
        cardmc:Parse(
            {
                sid = mc.sid,
                uid = mc.uid,
                star = mc.star,
                lv = mc.lv,
                soul_chain_lv = mc.soul_chain_lv or 0,
                soul_state = mc.soul_state or 0,
                open_inborn = mc.open_inborn or {}
            }
        )
        cardmc:SaveDecorationData(mc, true)
        --cardmc:OnInitMutuallyData()
        table.insert(cards, cardmc)
    end

    local card = cards[index]
    if card then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CommonIllustrationsH5View.Name,
            card.sid,
            nil,
            nil,
            card,
            nil,
            cards,
            true,
            index
        )
    end
end

function ChatView:SetCard(lua, CardData, click)
    if CardData ~= nil then
        CardData.skinIs = false
        lua:ShowCardData(CardData, click, false, true)
        lua:HideOrShowLevel(true)
        --_G.GameUtil.SetActiveByCondition(lua.go_table.aorimage_black, false)
    end
end

function ChatView:SetCardColor(star, colorDi)
    local colorType
    if star >= 11 then
        colorType = 6
    elseif star >= 6 then
        colorType = 5
    elseif star >= 5 then
        colorType = 4
    elseif star >= 4 then
        colorType = 3
    elseif star >= 3 then
        colorType = 2
    else
        colorType = 1
    end
    if colorDi then
        colorDi.SpriteName = itemColorDiIconName[colorType]
    end
end

