function ChatView:ClickHead(go, _, uid, params, goTable)
    local name = go:GetName()
    if name == "@_aorbtn_HeadClick" then
        -- body
        if self:InBattle() then
            _G.PopWindowManager:GetInstance():ShowAllTips(415)
            return
        end
        if self:InPeakMatching() then
            return
        end
        if uid > 0 then
            if uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.PopWindowManager:GetInstance():ShowAllTips(620109)
            else
                _G.SystemSettingManager:GetInstance():OpenView(uid)
            end
        end
    elseif name == "@_aorbtn_XuanZho" then
        self.fuZi = 1
        self.itemgo = goTable
        self.go_table.aorbtn_CloseFuZhi:SetActiveE(self.fuZi)
        goTable.aorbtn_fuzhi:SetActiveE(self.fuZi)
        return
    elseif name == "@_aorbtn_fuzhi" then
        self.fuZi = 0
        self.go_table.aorbtn_CloseFuZhi:SetActiveE(self.fuZi)
        goTable.aorbtn_fuzhi:SetActiveE(self.fuZi)
        _G.PopWindowManager:GetInstance():ShowAllTips(417)

        local m_Textinfo = goTable.obj_Textinfo:GetComponentE(typeof(CS.ExtendText))
        self:InputText(m_Textinfo.text)
        return
    end
    if params.type == _G.ChatInfoType.GuildImpeach then
        if name == "@_aorbtn_gotoimpeach" then
            local SociatyModel = require "SociatyModel":GetInstance()
            local chairData = SociatyModel.SociatySelf.GetMemberModule():GetChairman()
            if chairData.OfflineTime > 0 and _G.TimeUtil.GetServerUnixTime() - chairData.OfflineTime > 86400 then
                SociatyModel:GetImpeachInfo(
                    function()
                        ---公会弹劾
                        _G.JumpManager:GetInstance():Jump(117004)
                    end
                )
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(4601)
            end
        end
    end
    if params.type == _G.ChatInfoType.GuildMoba then
        if name == "@_aorbtn_mobaEmbattle" then
            if not require("SociatyManager"):GetInstance():HasSociaty() then
                return
            end
            local weekDay = _G.TimeUtil.GetWeekDay()
            local model = require("SociatyMobaModel"):GetInstance()
            local battleState = model:GetMobaBattleStage()
            if model:IsShowSettleView(weekDay, battleState) then
                if battleState == model:GetInstance().SociatyMobaBattleState.SeasonSettlement then
                    _G.PopWindowManager:GetInstance():ShowAllTips(950125)
                    return
                end
            elseif model:IsShowSettleResultView() then
                _G.PopWindowManager:GetInstance():ShowAllTips(950125)
                return
            end
            _G.JumpManager:GetInstance():Jump(217001)
        end
    end
    if params.type == 9 then
        if name == "@_aorbtn_relicTeamJoin" then
            if self:InBattle() then
                _G.PopWindowManager:GetInstance():ShowAllTips(415)
                return
            end
            local RelicTeamModel = require "RelicTeamModel":GetInstance()
            local data = _G.Json2Table(params.n_content)
            local camp = RelicTeamModel:GetCamp()
            local teamInfo = RelicTeamModel:GetTeamInfo()
            local status = RelicTeamModel:GetStatusAndNextTimeLine()
            local teamBol = status == RelicTeamModel.relicStatus.team
            if _G.PlayerModel:GetInstance():GetCorePower() < data.join_power then
                _G.PopWindowManager:GetInstance():ShowAllTips(5215)
                return
                -- elseif not camp or camp == 0 then
                --     _G.PopWindowManager:GetInstance():ShowAllTips(5212)
                --     return
                -- elseif camp ~= data.camp then
                --     _G.PopWindowManager:GetInstance():ShowAllTips(5212, _G.GetLangPackValue(90033500170))
