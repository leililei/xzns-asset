---玩家信息
---@param params chat.i_chat
function ChatView:ChatItme_Chat(item, goTable, params, index)
    local chatlist = self:GetChatList(self.nowChatlooplist:GetName())
    local old = chatlist[index - 1]
    local timeStr = nil
    if not old or (params.time - old.time) > 300 then
        local isNowday = _G.TimeUtil.CheckTheSameDay(params.time, _G.TimeUtil.GetServerUnixTime())
        local tTime = math.floor(params.time)
        if isNowday then
            timeStr = _G.TimeUtil.date("%H:%M", tTime)
        else
            timeStr = _G.TimeUtil.date("%Y-%m-%d  %H:%M", tTime)
        end
    end
    if goTable.aorbtn_XuanZho then
        goTable.aorbtn_XuanZho:SetActiveE(0)
    end
    --用名字的rt宽度做标准
    local rtf_Tmp
    local txtstr = ""
    goTable.aortext_time.text = timeStr or ""
    --名字
    goTable.aortext_name.text = params.role_info.name
    --信息
    local m_Textinfo = goTable.obj_Textinfo:GetComponentE(typeof(CS.ExtendText))
    goTable.m_Textinfo = m_Textinfo
    goTable.aorrawimage_phiz:ClearChildren()
    goTable.aorrawimage_phiz:SetActiveE(0)
    ---@type  expression_cfg
    goTable.aorimage_phiz:SetActiveE(params.type == _G.ChatInfoType.PlayerEmoji and 1 or 0)
    goTable.obj_bg:SetActiveE(params.type == _G.ChatInfoType.PlayerEmoji and 0 or 1)
    if params.type == _G.ChatInfoType.PlayerEmoji then
        rtf_Tmp = goTable.obj_bg:GetComponentE(typeof(CS.UnityEngine.RectTransform))
        m_Textinfo.text = txtstr
        if _G.PlayerModel:GetInstance().role_uid ~= params.role_info.uid then
            goTable.aorbtn_XuanZho:SetActiveE(1)
        end
        ---@type  expression_cfg
        local expression_cfg = require("ChatManager"):GetInstance():Phiz_Get(_G.tonumber(params.n_content))
        goTable.Params_phizPath = nil
        if expression_cfg ~= nil then
            goTable.Params_phizPath = expression_cfg.img_path
            if expression_cfg.gif == 0 then
                goTable.aorrawimage_phiz:ClearChildren()
                goTable.aorrawimage_phiz:LoadImage(
                    goTable.Params_phizPath,
                    function(image)
                        if image then
                            image:SetNativeSize()
                        end
                    end
                )
            elseif expression_cfg.gif == 1 then
                goTable.aorrawimage_phiz.Alpha = 0
                goTable.aorrawimage_phiz:ClearChildren()
                _G.UIUtils.LoadEffectByPath(goTable.Params_phizPath, goTable.aorrawimage_phiz, nil, nil, nil, { 0, -110 })
            end
        end
    else
        --超链接监听 防止重复
        m_Textinfo.text = _G.string.removeRichTextSpecal(params.n_content)
        if _G.PlayerModel:GetInstance().role_uid ~= params.role_info.uid then
            goTable.aorbtn_XuanZho:SetActiveE(1)
        end
    end
    _G.GameUtil.SetActiveByCondition(goTable.aorrawimage_phiz, params.type == _G.ChatInfoType.PlayerEmoji)
    UIUtils.SetPlayerHeadItemNew(
        goTable.obj_HeadItemBase,
        params.role_info,
        0.8,
        true,
        true,
        false,
        function()
            local tb = _G.GetAutoGoTable(goTable.obj_HeadItemBase)
            self:ClickHead(tb.aorbtn_HeadClick, nil, params.role_info.uid, params)
        end
    )

    local tf = item:GetComponentE(typeof(CS.UnityEngine.RectTransform))

    ----如果显示了时间
    local offset = 70
    if timeStr then
        ---将信息显示往下移 空出时间的显示位置
        offset = offset + 30
        goTable.obj_node:SetAnchorPosition(0, -30)
    else
        goTable.obj_node:SetAnchorPosition(0, 0)
    end
    local chatFrameSid = DefaultChatFrameSid
    if params.chat_frame then
        if params.chat_frame[2] == 0 or params.chat_frame[2] > _G.TimeUtil.GetServerUnixTime() then
            if params.chat_frame[1] ~= 0 then
                chatFrameSid = params.chat_frame[1]
            end
        end
    end
    local chatFrameCfg = _G.ConfigManager.player_bubble_cfg[chatFrameSid]
    goTable.obj_phizFrameEff:ClearChildren()
    goTable.obj_frameEff:ClearChildren()
    local parent
    if params.type == _G.ChatInfoType.PlayerEmoji then
        rtf_Tmp = goTable.aorimage_phiz:GetComponentE(typeof(CS.UnityEngine.RectTransform))
        goTable.aorimage_phiz.SpriteName = chatFrameCfg.bubble
        parent = goTable.obj_phizFrameEff
    else
        rtf_Tmp = goTable.obj_bg:GetComponentE(typeof(CS.UnityEngine.RectTransform))
        goTable.aorimage_bg.SpriteName = chatFrameCfg.bubble
        CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(rtf_Tmp)
        parent = goTable.obj_frameEff
    end
    local _, rh = rtf_Tmp:GetRectTransformWidthHeight()
    tf:SetSizeWithCurrentAnchors(CS.UnityEngine.RectTransform.Axis.Vertical, rh + offset)
    -----------------------------------------------------------------------   气泡随文字 动态大小
    if not _G.table.isEmptyOrNil(chatFrameCfg.bubble_effect) and not goTable.isLoadingEff then
        goTable.isLoadingEff = true
        _G.UIUtils.LoadEffectByPath(
            chatFrameCfg.bubble_effect[1][1],
            parent,
            function(trans)
                if self:IsNil() then
                    _G.UIUtils.RemoveEffect(trans)
                    return
                end
                goTable.isLoadingEff = false
                local parClip = trans:AddComponentE(typeof(CS.ParticleClipRect))
                parClip.NeedCheck = true
                parClip.CheckCount = 10
                parClip.CheckOne = 3
            end,
            nil,
            nil,
            nil,
            nil,
            nil,
            true
        )
    end
    -----------------------------------------------------------------------   气泡框文本颜色
    local contentColor = "22811A" --default color
    if chatFrameCfg and not _G.table.isEmptyOrNil(chatFrameCfg.font_color) then
        contentColor = chatFrameCfg.font_color[1][1]
    end
    m_Textinfo.color = _G.ColorTools.FormatColorByString(contentColor)
end

