function ChatView:SociatyTopInfo()
    self:SociatyTopInfo_StopDoTween()
    if _G.IsNil(self.go_table) then
        return
    end
    self.go_table.aortext_goals:SetAnchorPosition(500, 0)

    ---@type UnityEngine.RectTransform
    local rect = self.go_table.aortext_goals.rectTransform
    local rw, _ = rect:GetRectTransformWidthHeight()
    local width = 500 + rw
    self.go_table.aortext_goals:SetAnchorPosition(width, 0)
    local rowTime = width * self.topinfoInterval

