function ChatView:UpdataPrivateList()
    --盟约界面聊天不显示其他私聊
    if self.Sworn then
        return
    end

    self:UpdatePriviteUids()
    local Zjsl_GetUidInfos = self.ChatManager:Zjsl_GetUidInfos()
    if not self.Zjsl_PlayInfoDic then
        self.Zjsl_PlayInfoDic = Zjsl_GetUidInfos
    end

    local leninfo = _G.table.count(self.Zjsl_PlayInfoDic)
    self.go_Private.scrollloophorizontal_private:SetActiveE(leninfo > 0 and 1 or 0)

    if leninfo > 0 then
        local len = _G.Mathf.Min(_G.ConfigManager.discrete_cfg[101004][1][1], _G.table.count(self.Zjsl_GetUids))
        if self.go_Private.InitList == nil then
            self.go_Private.scrollloophorizontal_private:InitItemData(len, _G.handler(self, self.Private_RefreshList))
            self.go_Private.InitList = true
        else
            self.go_Private.scrollloophorizontal_private:UpdateCount(
                len,
                0,
                0,
                self.Zjsl_NowUid == self.Zjsl_GetUids[1] and 1 or 0
            )
        end
    end
end

function ChatView:UpdatePriviteUids()
    local Zjsl_GetUids = self.ChatManager:Zjsl_GetUids()
    self.Zjsl_GetUids = {}
    local time = _G.TimeUtil.GetServerUnixTime() - 604800
    local hasExpireChat = false --是否有已过期的聊天
    local data
    for _, v in pairs(Zjsl_GetUids) do
        data = self:GetChatListByType(_G.ChatType.privateChat, v)
        if (not _G.table.isEmptyOrNil(data) and data[#data].time > time) or self.tempUids[v] then
            _G.table.insert(self.Zjsl_GetUids, v)
        else
            hasExpireChat = true
            require("FriendManager"):GetInstance():RedDotnil(v, time)
        end
    end
    if not self.Zjsl_NowUid and self.Zjsl_GetUids[1] then
        self.Zjsl_NowUid = self.Zjsl_GetUids[1]
    end
    if hasExpireChat then
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.PrivateChat.id)
    end
end

function ChatView:Private_RefreshList(index, objGame)
    if index < 0 then
        return
    end
    ---@type FriendData
    local data = self.Zjsl_PlayInfoDic[self.Zjsl_GetUids[index + 1]]
    local itemGoTable = _G.GetAutoGoTable(objGame, _G.handlerbind(self, self.OnClickPrivateItem, data))
    itemGoTable.data = data
    UIUtils.SetPlayerHeadItemNew(itemGoTable.obj_HeadItemBase, data, 0.65, true, false, false, nil)
    --名字
    itemGoTable.aortext_name.text = data.name
    ---选中
    itemGoTable.aorimage_on:SetActiveE(data.uid == self.Zjsl_NowUid and 1 or 0)

    if data.uid == self.Zjsl_NowUid then
        local time = _G.TimeUtil.GetServerUnixTime()
        require("FriendManager"):GetInstance():RedDotnil(self.Zjsl_NowUid, time)
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.PrivateChat.id)
    end
    -- if itemGoTable.isClick == nil then
    --     itemGoTable.aorbtn_click.onClick:AddListener(_G.handlerbind(self, self.OnClick_SelectPlay, itemGoTable))
    --     itemGoTable.isClick = true
    -- end

    return objGame
end

function ChatView:OnClickPrivateItem(go, _, data)
    local name = go:GetName()
    if name == "@_aorbtn_click" then
        self:OnClick_SelectPlay(data)
    elseif name == "@_aorbtn_close" then
        require("ChatManager"):GetInstance():DeleteFriendChat(
            data.uid,
            function()
                if data.uid == self.Zjsl_NowUid then
                    self.Zjsl_NowUid = nil
                end
                self:UpdataPrivateList()
                self:UpDataChatView()
                self:ViewPrivate(true)
            end
        )
    end
end

function ChatView:OnClick_SelectPlay(data)
    -- local data = itemGoTable.data
    self.Zjsl_NowUid = data.uid
    local time = _G.TimeUtil.GetServerUnixTime()
    require("FriendManager"):GetInstance():RedDotnil(self.Zjsl_NowUid, time)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.PrivateChat.id)

    self:UpDataChatView()
    self:ViewPrivate(true)
    self:UpdataPrivateList()
end

