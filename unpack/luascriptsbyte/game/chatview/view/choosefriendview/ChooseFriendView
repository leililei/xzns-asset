---@class ChooseFriendView : UIBaseView    在线好友界面
---@field public go_table ChatView_GoTable GoTable
local ChooseFriendView = _G.BaseClass("ChooseFriendView", _G.UIBaseView)

function ChooseFriendView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@  number _G.ChatType默认打开界面
function ChooseFriendView:OnCreate(callback)
    self.ChooseIndex = 1
    self.CallBack = callback
    self.ChooseObj = nil
    self.ObjList = {}

    require("FriendManager"):GetInstance():GetFriendListInServer(
        function(list)
            self:UpdateFriendList(list)
        end
    )
end

----更新好友界面
function ChooseFriendView:UpdateFriendList(listtemp)
    ---过滤在线
    self.FriendList = {}
    for _, v in pairs(listtemp) do
        if v.time <= 0 then
            _G.table.insert(self.FriendList, v)
        end
    end

    if _G.table.isEmptyOrNil(self.FriendList) then
        self.go_table.aortext_FriendNum:SetActiveE(0)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_NoFriend, true)
        self.go_table.aorbtn_qx:SetActiveE(0)
        self.go_table.aorbtn_share:SetActiveE(0)
    else
        local curLen = table.count(self.FriendList)
        self.go_table.aortext_FriendNum:SetActiveE(1)
        self.go_table.aortext_FriendNum.text = _G.GetLangPackValue(90021800518, curLen)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_NoFriend, false)
        self.go_table.aorbtn_qx:SetActiveE(1)
        self.go_table.aorbtn_share:SetActiveE(1)
        _G.table.sort(
            self.FriendList,
            function(a, b)
                if a.time == 0 and b.time ~= 0 then
                    return true
                elseif b.time == 0 then
                    return false
                end
                return a.time > b.time
            end
        )

        self.go_table.scrollloopvectical_FriendList:InitItemData(curLen, _G.handler(self, self.RefreshFriendList))
    end
end

---更新单个好友
function ChooseFriendView:RefreshFriendList(index, obj)
    if index < 0 then
        return
    end
    local x = index + 1

    local data = self.FriendList[x]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnFriendListClick, x))
    tb.aortext_Name.text = data.name
    ---TODO预留跨区
    local power = data.power
    tb.aortext_Power.text = _G.GameUtil.NumberToUnitStrFight(power)
    
    local zb1_portrait = _G.ConfigManager.player_portrait_cfg[data.style]
    if zb1_portrait then
        tb.aorimage_icon.SpriteName = zb1_portrait.portrait1
    end
    local zb1_frame_cfg = _G.ConfigManager.player_frame_cfg[data.frame]
    if zb1_frame_cfg ~= nil then
        tb.aorrawimage_frame:LoadImage(zb1_frame_cfg.frame)
    end
    if x == self.ChooseIndex then
        self.ChooseObj = tb
    end
    tb.aorimage_Light:SetActiveE(x == self.ChooseIndex and 1 or 0)
    self.ObjList[x] = tb
end

function ChooseFriendView:OnFriendListClick(go, isOn, mindex)
    if _G.AppSetting.DEBUG then
        _G.Log(mindex, "选中一个好友")
    end
    self.ChooseIndex = mindex
    self.ChooseObj.aorimage_Light:SetActiveE(0)
    self.ChooseObj = self.ObjList[mindex]
    self.ChooseObj.aorimage_Light:SetActiveE(1)
end

function ChooseFriendView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_Close" then
        self:Close()
    elseif name == "@_aorbtn_qx" then
        self:Close()
    elseif name == "@_aorbtn_share" then
        if self.CallBack then
            local data = self.FriendList[self.ChooseIndex]
            self.CallBack(4, data.uid)
        end
        self:Close()
    end
end

return ChooseFriendView
