---@class ChooseChannelView : UIBaseView    分享到界面
---@field public go_table ChatView_GoTable GoTable
local ChooseChannelView = _G.BaseClass("ChooseChannelView", _G.UIBaseView)

function ChooseChannelView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param callback function 回调
---@param type number 类型，默认不传1，2女仆特殊界面
function ChooseChannelView:OnCreate(callback, type)
    self.CallBack = callback
    self.Type = type or 1
end

function ChooseChannelView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_backGround" then
        self:Close()
    elseif name == "@_aorbtn_world" then
        if _G.AppSetting.DEBUG then
            _G.Log("点击发送到世界")
        end
        local isUnlock, dataStr = require("ChatManager"):GetInstance():IsUnLock(1)
        if not isUnlock then
            _G.PopWindowManager:GetInstance():ShowAllTips(410, dataStr)
            return
        end
        if self.CallBack then
            self.CallBack(1)
        end
        self:Close()
    elseif name == "@_aorbtn_gh" then
        if _G.AppSetting.DEBUG then
            _G.Log("点击发送到公会")
        end
        if not require("SociatyManager"):GetInstance():HasSociaty() then
            _G.PopWindowManager:GetInstance():ShowAllTips(802)
            return
        end
        if self.CallBack then
            self.CallBack(3)
        end
        self:Close()
    elseif name == "@_aorbtn_firend" then
        if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(55) then
            _G.PopWindowManager:GetInstance():ShowAllTips(716)
            return
        end

        if _G.AppSetting.DEBUG then
            _G.Log("点击发送到好友")
        end
        if self.Type == 2 then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MaidCooperPrivateView.Name, self.CallBack)
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ChooseFriendView.Name, self.CallBack)
        end
        self:Close()
    end
end

return ChooseChannelView
