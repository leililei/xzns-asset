function ChatManager:Phiz_CallSendChat(msg)
    --解锁表情
    self.ExpressionUnlock = msg.unlock or {}
    --喜欢的表情
    self.ExpressionLike = msg.like or {}
    --战斗设置表情
    self.ExpressionFight_expression = msg.fight_expression or {}
end

---返回当前id是否被选中
function ChatManager:GetPhiz_CallSendChat(id)
    local data = 0
    for key, value in pairs(self.ExpressionFight_expression) do
        if value.sid == id then
            data = 1
        end
    end
    return data
end

---返回当前id是否被选中
function ChatManager:GetPhiz_CallSendChatID(id)
    local data = 0
    for key, value in pairs(self.ExpressionFight_expression) do
        if value.type == id then
            data = value.sid
        end
    end
    return data
end

---返回当前战斗表情
function ChatManager:GetPhiz_DataID()
    local data = {}
    for key, value in pairs(self.PhizDic) do
        if self:GetPhiz_CallSendChatID(value.id) ~= 0 then
            _G.table.insert(data, value)
        end
    end
    return data
end

---设置当前战斗表情
function ChatManager:SaveDataID(index, id, callback)
    local id1 = 0
    local index2 = 0
    for key, value in pairs(self.ExpressionFight_expression) do
        if value.type == index then
            if value.sid == id then
                return
            elseif value.sid == 0 then
                id1 = 0
            else
                id1 = value.sid
            end
        end
        if value.sid == id then
            if value.type == index then
                return
            else
                index2 = value.type
            end
        end
    end
    local msg = { type = index, sid = id }
    local fight_expression = {}
    fight_expression.fight_expression = { msg }
    if index2 ~= 0 then
        _G.table.insert(fight_expression.fight_expression, { type = index2, sid = id1 })
    end
    require("ChatViewNet"):GetInstance():GetExpressionFightExpression(
        fight_expression,
        function()
            if callback then
                for key, value in pairs(fight_expression.fight_expression) do
                    local i = true
                    for k, v in pairs(self.ExpressionFight_expression) do
                        if value.type == v.type then
                            v.sid = value.sid
                            i = false
                        end
                    end
                    if i then
                        _G.table.insert(self.ExpressionFight_expression, value)
                    end
                end
                callback()
            end
        end
    )
end

---解锁表情
---@param expressionKey string 表情关键字
---@return boolean 是否解锁
function ChatManager:ExpressionUnlocked(expressionKey)
    local Is = true
    for key, value in pairs(self.ExpressionUnlock or {}) do
        if value == expressionKey then
            Is = false
        end
    end
    if Is then
        _G.table.insert(self.ExpressionUnlock, expressionKey)
        self:GetExpressionUnlockRep()
        _G.table.insert(self.ExpressionUnlockRep, expressionKey)
        _G.PlayerPrefsManager.SetTable("ExpressionUnlockRep", self.ExpressionUnlockRep)
        --刷新红点
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RankList.id)
    end
end

function ChatManager:DeleteFriendChat(uid, callback)
    require("ChatViewNet"):GetInstance():DeleteFriendChat(
        { f_uid = uid },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self:Zjsl_DelUid(uid)
            if self.zjsl_PlayInfoDic[uid] then
                self.zjsl_PlayInfoDic[uid] = nil
            end
            if callback then
                callback()
            end
        end
    )
end

