    _G.table.removebyvalue(zjsl_uids, uid)
    ---添加在顶
    table.insert(zjsl_uids, 1, uid)
    if #zjsl_uids > self.UiDic.zjslMaxCount then
        _G.table.remove(zjsl_uids, self.UiDic.zjslMaxCount + 1)
    end

    _G.PlayerPrefsManager.SetTable("zjsl_uids", zjsl_uids)

    if not isNewMsg then
        ---新消息不刷新界面，客户端派发的_G.eChatStatus.newChat已经触发了刷新，不需要重复刷新
        local uiname = _G.ConfigManager.ui_cfg.ChatView.Name
        if _G.UIManager:GetInstance():IsActiveWindow(uiname) then
            local view = _G.UIManager:GetInstance():GetWindowCtrl(uiname)
            view:Private_Open(isNewMsg)
        end
    end
