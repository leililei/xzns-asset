function ChatManager:P2C_NewChat(data)
    if data == nil then
        return
    end

    data = self:NewChatProcess(data)
    if data.channel ~= _G.ChatType.events and data.channel ~= _G.ChatType.leagueevents then
        if data.type == _G.ChatInfoType.StrategyStation then
            data.channel = _G.ChatType.system
        end
        _G.Events:GetInstance():Broadcast(_G.eChatStatus.MainNewChat, data)
        _G.MainManager:GetInstance():OnAddMinChatItem(data)
    end
    self:AddChatInfo(data.channel, data)
end

