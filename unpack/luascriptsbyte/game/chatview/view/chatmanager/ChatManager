function ChatManager:DelChatByUid(uid, channel)
    if channel == _G.ChatType.privateChat then
        if self.Chat_InfoAll[channel] == nil or self.Chat_InfoAll[channel][uid] == nil then
            return
        end
        self.Chat_InfoAll[channel][uid] = nil
