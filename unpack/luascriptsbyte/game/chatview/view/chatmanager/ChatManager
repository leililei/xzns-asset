function ChatManager:GetChatInfoIndex(pindao, index)
    local nowInfo = self:GetChatInfoByPingDao(pindao)
    if #nowInfo <= 0 then
        return nil
    elseif index == -1 then
        return nowInfo[#nowInfo]
    end
    return nowInfo[1]
