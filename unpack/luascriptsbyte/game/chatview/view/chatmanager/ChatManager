---检测是否可以分享
---@param uid number 玩家或者公会uid
function ChatManager:CheckIsCanShare(type, uid, call)
    if not self.shareList then
        self.shareList = {}
    end
    local time = _G.TimeUtil.GetServerUnixTime()
    local param = _G.ConfigManager.discrete_cfg[106902][1]
    local check = function(data)
        if time < data.time + param[1] * 3600 and data.num >= param[2] then
            local timeData = _G.TimeUtil.TranslateSecond(data.time + param[1] * 3600 - time)
            ---@type tips_system_cfg
            local tips = _G.ConfigManager.tips_system_cfg[shareTipsId]
            local str = ""
            if timeData.hour > 0 then
                str = _G.GetLangPackValue(tips.content, _G.GetLangPackValue(90025500029, timeData.hour))
            elseif timeData.min > 0 then
                str = _G.GetLangPackValue(tips.content, _G.GetLangPackValue(90000010394, timeData.min))
            else
                str = _G.GetLangPackValue(tips.content, _G.GetLangPackValue(90000010394, 1))
            end
            _G.PopWindowManager:GetInstance():ShowAllTips(shareTipsId, str)
        else
            if call then
                call()
            end
        end
    end
    ---@type share.s2c_share_limit
    local data = self.shareList[type]
    if not data then
        require "ChatViewNet":GetInstance():GetShareLimit(
            { uid = uid, share_type = type },
            function(msg)
                self.shareList[type] = msg
                check(msg)
            end
        )
    elseif not (time < data.time + param[1] * 3600 and data.num >= param[2]) then
        require "ChatViewNet":GetInstance():GetShareLimit(
            { uid = uid, share_type = type },
            function(msg)
                self.shareList[type] = msg
                check(msg)
            end
        )
    else
        check(data)
    end
end

