---检测有无渠道条件替换
function ChatManager:CheckPlatformCondition(value)
    --ZHJH5ZHJH-8086 【7月版本】程序主单号ZHJH-9432
    --【客户端】支付宝-聊天频道开启条件判断调整(同样也支持其他渠道替换聊天条件,条件目前只支持单条件)
    local platform = _G.tonumber(_G.SDKManager:GetInstance():GetChannelId())
    if _G.AppSetting.DEBUG then
        _G.Log(platform, "聊天频道判断渠道id")
    end

    ---先判断是否有渠道并取出渠道聊天条件信息
    local newCondition
    ---ZHJH-13445新的条件配在function_block_cfg，以前的离散配置先不管，这里取不到再取离散
    local pCfg = _G.ConfigManager.function_block_cfg[platform]
    for _, v in pairs(pCfg.chat) do
        if v[1] == value then
            newCondition = {v[2], v[3]}
            if _G.AppSetting.DEBUG then
                _G.Log(newCondition, "聊天频道替换新条件")
                _G.Log(value, "聊天频道")
            end
            return newCondition
        end
    end

    local newDId
    local info = _G.ConfigManager.discrete_cfg[126105]
    for i = 1, #info do
        local pf = info[i]
        if pf[1] == platform then
            newDId = pf[2]
            break
        end
    end
    
    if newDId then
        ---匹配聊天频道并替换条件
        info = _G.ConfigManager.discrete_cfg[newDId]
        for i = 1, #info do
            local condition = info[i]
            if condition[1] == value then
                ---需要多条件可在此处新增解析
                newCondition = { condition[2], condition[3] }
                break
            end
        end
    end

    if _G.AppSetting.DEBUG and newCondition then
        _G.Log(newCondition, "聊天频道替换新条件")
        _G.Log(value, "聊天频道")
    end
    return newCondition
end

