---信息内容 格式化  [#1] 表情(1:表情序号)    超链接[uid#文字]
function ChatManager:chatInfoFormat(content, isMain)
    if string.IsNullOrEmpty(content) then
        return ""
    end
    if isMain ~= true then
        --表情   [#5]  -->  <sprite=5>
        content = string.gsub(
            content,
            "%[#%d+%]",
            function(s)
                return self:SpriteFormat(string.sub(s, 3, #s - 1))
            end
        )
    end
    --超链接   [151#方天画戟]  -->  <sprite=5>
    content = string.gsub(
        content,
        -- "%[%-?%d+#.+]",
        "%[[A-Za-z0-9]+#[A-Za-z0-9]+]",
        function(s)
            local jinIndex = string.find(s, "#")
            return self:LinkFormat(string.sub(s, 2, jinIndex - 1), string.sub(s, jinIndex + 1, #s - 1))
        end
    )
    return content
    -- body
end

