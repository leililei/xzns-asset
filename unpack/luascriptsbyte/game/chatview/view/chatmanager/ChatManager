    ---查询记数
    self.zjsl_SeekPlayinfoCount = #uids

    local SystemSettingNet = require("SystemSettingNet"):GetInstance()
    if #uids > 0 then
        for i = 1, #uids do
            local uid = uids[i]
            if uid > 0 then
                local msg = {}
                msg.uid = uid
                SystemSettingNet:GetPlayerInfo(msg, _G.handlerbind(self, self.Zjsl_SeekPlayinfoSuc, uid, call))
            end
        end
    else
        if call then
            call()
        end
    end
end

