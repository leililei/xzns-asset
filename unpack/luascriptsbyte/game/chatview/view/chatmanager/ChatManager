--解析 聊天内容信息 消息   content[1] 为类型  0玩家消息
function ChatManager:Parsing_content(content)
    if _G.IsTable(content) then
        local contentType = tonumber(content[1])

        if contentType == 0 then
            return content[2]
        else
            table.remove(content, 1)
            return _G.LangUtil.GetLangPackValue(contentType, _G.SafeUnpack(content)) or ""
        end
    end
    return content
end

--获取 新版 聊天结构 (防止服务器改动结构)  用于发给服务器
---@param ChatInfo ClintSendChatInfo
---@return chat.i_chat nil,TipsId
function ChatManager:GetNewChatInfo(ChatInfo)
    ---@field channel number            频道
    ---@field n_content string           内容
    ---@field time  number               发送时间
    ---@field voice number               是否语音
    ---@field type  number               类型
    ---@field f_uid number               对象uid
    ---@field name string               发送者名字
    ---@field r_level   number          发送者等级
    ---@field r_uid number              发送者uid
    ---@field style number              发送者头像
    ---@field power number              发送者战力
    ---@field frame number              发送者头像框
    ---@field is_self number               是自己1
    ---@field title role.i_effect              没称号0

    ---@class  ClintSendChatInfo

    ---@type role.i_role
    local roleinfo = {}
    roleinfo.uid = ChatInfo.r_uid or _G.PlayerModel:GetInstance().role_uid
    roleinfo.name = ChatInfo.name or _G.PlayerModel:GetInstance().role_name      ---玩家名字
    roleinfo.style = ChatInfo.style or _G.PlayerModel:GetInstance().role_style   ---头像
    roleinfo.level = ChatInfo.r_level or _G.PlayerModel:GetInstance():GetLevel() ---等级
    roleinfo.power = ChatInfo.power or _G.PlayerModel:GetInstance().power        ---战力
    roleinfo.frame = ChatInfo.frame or _G.PlayerModel:GetInstance().frame        ---头像框
    roleinfo.title = ChatInfo.title or _G.PlayerModel:GetInstance():GetTitle()   ---称号

    ---@type chat.i_chat
    local msg = {}
    msg.channel = ChatInfo.channel or _G.ChatType.world                            ---聊天频道
    msg.voice = ChatInfo.voice or 0                                                ---是否语音 0：非语音  1：语音
    msg.type = ChatInfo.type or _G.ChatInfoType.chat                               ---类型 ： 1:玩家  2:系统 3 :分享
    msg.time = ChatInfo.time or _G.TimeUtil.GetServerUnixTime()                    ---时间
    msg.n_content = { "0", ChatInfo.n_content or "" }                              ---聊天内容
    msg.f_uid = ChatInfo.f_uid                                                     ---对象uid（私聊用）
    msg.share_id = ChatInfo.share_id
    msg.role_info = roleinfo                                                       ---角色信息
    msg.is_self = roleinfo.uid == _G.PlayerModel:GetInstance().role_uid and 1 or 0 --是否是自己 1 是自己
    msg.share_type = ChatInfo.share_type or 0
    msg.uid = ChatInfo.uid
    if msg.is_self then
        local chatFrame = _G.PlayerModel:GetInstance():GetChatFrame()
        msg.chat_frame = { chatFrame.sid, chatFrame.end_time }
    else
        msg.chat_frame = { 0, 0 }
    end
    ---工會uid

    return self:CheckContent(msg)
end

---检测聊天内容合法
---@param   msg chat.i_chat
function ChatManager:CheckContent(msg)
    local content = msg.n_content[2]
    content = string.trim(content)
    if string.IsNullOrEmpty(content) then
        return nil, 160102
    else
        msg.n_content[2] = content
        return { chat = msg }
    end
end

