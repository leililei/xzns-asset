function ChatManager:GetNewChatInfoData(shareType, card, k, v)
    local data = {}
    data.shareType = shareType
    data.shareType_1 = k
    data.shareType_2 = v
    data.dfname = card.cfg.Name
    if card.skin and card.skin ~= 0 then
        data.sid = card.skin
    else
        data.sid = card.sid
    end
    data.uid = card.uid
    data.star = card.star
    data.lv = card.lv
    data.type = card.type
    data.soul_chain_lv = card.soulLink_lv
    data.soul_state = card.soulLink_IsActivate
    data.big_born_num = card.big_born_num

    local dataStr = _G.Table2Json(data)

    ---@type chat.c2s_chat dsd
    local param = {}
    param.channel = _G.ChatType.union
    param.content = dataStr
    param.f_uid = nil
    param.type = _G.ChatInfoType.ShowCultivationPride
    param.voice = 0
    param.share_id = 0

    ---@type ClintSendChatInfo ---本地自己的消息 先显示 忽略服务器广播 防止延迟
    local msg = {}
    msg.channel = _G.ChatType.union
    msg.n_content = dataStr
    msg.f_uid = nil
    msg.type = _G.ChatInfoType.ShowCultivationPride
    msg.voice = 0
    msg.share_id = 0
    msg = require("ChatManager"):GetInstance():GetNewChatInfo(msg)
    require("ChatViewNet"):GetInstance():SendCHAT(param, _G.handlerbind(self, self.CallSendChat, msg))
end

function ChatManager:CallSendChat(param, msg)
    if param.ack == 1 then
        --  _G.PopWindowManager:GetInstance():ShowAllTips(411)
        --- 以服务器返回的内容为准  (违禁字 处理后)
        if not _G.IsNil(param.content) and not string.IsNullOrEmpty(param.content) then
            msg.chat.n_content = param.content
        end
        if not _G.IsNil(param.time) then
            msg.chat.time = param.time
        end
        require("ChatManager"):GetInstance():P2C_NewChat(msg)
    end
end

