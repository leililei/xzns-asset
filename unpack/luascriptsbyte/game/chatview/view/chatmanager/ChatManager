function ChatManager:CallGetRecentChat(Data, call)
    ---@type chat.private_chat[]
    local chatArr = Data.chat_list
    if chatArr ~= nil then
        ---清空
        self.Chat_InfoAll[_G.ChatType.privateChat] = {}

        for i = #chatArr, 1, -1 do
            local chat = chatArr[i]
            local uid = chat.f_uid
            ---@type chat.i_chat[]
            local chatlist = chat.list
            if chatlist and #chatlist > 0 then
                for i = #chatlist, 1, -1 do
                    local data = chatlist[i]
                    self:P2C_NewChat(data)
                end
            end
        end
    end
    if call then
        call()
    end
end

function ChatManager:CheckPrivateChat()
    local list = self.Chat_InfoAll[_G.ChatType.privateChat]
    local time = _G.TimeUtil.GetServerUnixTime()
    local IntervalTime = _G.ConfigManager.discrete_cfg[100305][1][1]
    for uid, chat in pairs(list) do
        for i, v in pairs(chat) do
            if v.time + IntervalTime < time then
                list[uid][i] = nil
            end
        end
    end
end

