--- 获取发送时间间隔
---@param isSend boolean true 返回发送间隔时间  false 返回距离上次发送间隔
function ChatManager:GetPinDaoSendTime(pindao, isSend)
    local time = self.chatSendTIMEDic[pindao]
    if time == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(" ChatManager:GetPinDaoSendTime 参数有误 " .. pindao)
        end
        return 0
    end

    local chatSendTIME = self:GetPinDaoSendCfg(pindao)
    local sub = _G.TimeUtil.GetServerUnixTime() - time
    local timeLeft = chatSendTIME - sub
    if timeLeft < 0 then
        if isSend then
            timeLeft = chatSendTIME
        else
            timeLeft = 0
        end
    end
    return timeLeft
end

