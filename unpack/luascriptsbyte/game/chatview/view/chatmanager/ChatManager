---检测某个频道是否开启
function ChatManager:CheckChannelConditionByType(chatType, showTip)
    local con = self:CheckPlatformCondition(chatType)
    if not con then
        con = _G.ConfigManager.chat_cfg[chatType].chat_open
    end
    local unlock, tipId, content = _G.GlobalConditionManager.CheckConditionArrays({con})
    if showTip and tipId then
        _G.PopWindowManager:GetInstance():ShowAllTips(tipId, content)
    end
    return unlock
end

