---获取玩家 聊天记录
---@return chat.i_chat or nil
function ChatManager:GetChatPrivateByUID(uid, callback)
    local nowInfo = self:GetChatInfoByPingDao(_G.ChatType.privateChat)

    local function returnFun()
        if callback ~= nil then
            return callback(
            --   uid,
                nowInfo[uid]
            )
        end
    end

    if not _G.IsNil(nowInfo) and not _G.IsNil(nowInfo[uid]) then
        returnFun()
        return
    end

    local infoArr = self.GetFriendChatRecord(uid)
    if #infoArr > 0 then
        nowInfo[uid] = infoArr
    end
    returnFun()
end

