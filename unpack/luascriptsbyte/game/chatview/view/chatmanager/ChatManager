---@param data chat.i_chat
function ChatManager:AddChatInfo(pindao, data)
    ---发送者id
    local sendUid = data.role_info.uid
    local isinBlackList = require("FriendManager"):GetInstance():CheckInBlackList(sendUid)
    ---拉黑后不显示消息
    if isinBlackList then
        return
    end
    if self.ChatCoroutineIingQueue == nil then
        self.ChatCoroutineIingQueue = _G.Queue.new()
    end
    _G.Queue.pushright(self.ChatCoroutineIingQueue, { pindao, data })

    if self.coroutine_Chat == nil then
        self.coroutine_Chat = _G.coroutine.start(_G.handler(self, self.ChatCoroutine))
    end
end

function ChatManager:_AddChatInfo(pindao, data)
    local nowInfo = self.Chat_InfoAll[pindao]

    local maxcount = self.ChatSaveCountDic[pindao]
    ---如果是私聊
    if pindao == _G.ChatType.privateChat then
        if _G.IsNil(nowInfo) then
            self.Chat_InfoAll[pindao] = {}
        end
        nowInfo = self.Chat_InfoAll[pindao]

        ---以对方uid为key
        ---发送者id
        local sendUid = data.role_info.uid
        ---如果是我自己发送的  看我发送给谁的消息
        if data.is_self == 1 then
            sendUid = data.f_uid
        else
            require("FriendManager"):GetInstance():MsgToMe(sendUid, data.time)
        end

        if _G.IsNil(nowInfo[sendUid]) then
            nowInfo[sendUid] = {}
        end

        local old = nowInfo[sendUid][#nowInfo[sendUid]]
        if old then
            if old.time == data.time then
                return
            end
        end
        table.insert(nowInfo[sendUid], data)
        --最大条数
        local del = #nowInfo[sendUid] - maxcount
        if del > 0 then
            for i = 1, del do
                table.remove(nowInfo[sendUid], 1)
            end
        end

        self:Zjsl_PushUid(sendUid, true)

        self.SaveFriendChatRecord(sendUid, nowInfo[sendUid])
        self:SetIsRead(pindao, true)
        _G.Events:GetInstance():Broadcast(_G.eChatStatus.newChat, data)
    else
        if data.role_info and data.role_info.uid == _G.PlayerModel:GetInstance().role_uid then
            ---  防止系统广播出自己刚发送的消息 (自己在聊天频道发送的消息已立即增加)
            local old = self.oldSendDic[pindao]
            if old then
                if old.time == data.time then
                    return
                end
            else
                self.oldSendDic[pindao] = {}
            end
            self.oldSendDic[pindao].content = data.n_content
            self.oldSendDic[pindao].time = data.time
        end

        table.insert(nowInfo, data)
        --最大条数
        local del = #nowInfo - maxcount
        if del > 0 then
            for i = 1, del do
                table.remove(nowInfo, 1)
            end
        end
        self:SetIsRead(pindao, true)
        _G.Events:GetInstance():Broadcast(_G.eChatStatus.newChat, data)
    end
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.Chat.id, pindao)
end

--region --------------------------------------协程 队列解析新聊天--------
function ChatManager:ChatCoroutine()
    while self.ChatCoroutineIingQueue.first <= self.ChatCoroutineIingQueue.last do
        for i = 1, 5 do
            local data = _G.Queue.popleft(self.ChatCoroutineIingQueue)
            if data ~= nil then
                self:_AddChatInfo(data[1], data[2])
            end
            if self.ChatCoroutineIingQueue.first > self.ChatCoroutineIingQueue.last then
                break
            end
        end
        _G.coroutine.yield()
    end
    self.coroutine_Chat = nil
end

--endregion------------------------------------协程 队列解析新聊天--------

---获取对应频道 单条消息
