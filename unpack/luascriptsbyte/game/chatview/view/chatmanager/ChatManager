function ChatManager:IsUnLock(pindao)
    local data = self.chat_openDic[pindao]

    if data ~= true then
        if data == nil then
            self.chat_openDic[pindao] = true
        else
            local isUnlock = _G.GlobalConditionManager.CheckCondition(data[1], data[2])
            --- 如果解锁了 就保存解锁

            if isUnlock == true then
                if _G.ChatType.union == pindao and not require "SociatyManager":GetInstance():HasSociaty() then
                    return false, _G.FunctionManager:GetInstance():GetStrWithType(data[1], data[2], true)
                end
                self.chat_openDic[pindao] = true
            else
                if data[1] == 9 then
                    local ct = _G.TimeUtil.GetDayBySix(_G.PlayerModel:GetInstance():GetCreateRoleTime())
                    ct = _G.TimeUtil.TranslateSecond(ct + (data[2] - 1) * 86400 - _G.TimeUtil.GetServerUnixTime())
                    local timeStr
                    if ct.day > 0 then
                        timeStr = _G.GetLangPackValue(90022100001, ct.day, ct.hour)
                    elseif ct.hour > 1 then
                        timeStr = _G.GetLangPackValue(90025500029, ct.hour)
                    else
                        timeStr = _G.GetLangPackValue(90025500029, 1)
                    end
                    if pindao == _G.ChatType.world then
                        return false, _G.GetLangPackValue(90000011114, timeStr)
                    elseif pindao == _G.ChatType.union then
                        return false, _G.GetLangPackValue(90000011356, timeStr)
                    elseif pindao == _G.ChatType.privateChat then
                        return false, _G.GetLangPackValue(90000011357, timeStr)
                    end
                end
                return false, _G.FunctionManager:GetInstance():GetStrWithType(data[1], data[2], true)
            end
        end
    end
    return self.chat_openDic[pindao]
end

