function ChatManager:Zjsl_SeekPlayinfoSuc(data, uid, call)
    if data.ack ~= 1 then
        return
    end
    self.zjsl_SeekPlayinfoCount = self.zjsl_SeekPlayinfoCount - 1
    -- if data.ack == 1 then
    --     for _, v in pairs(data.friend) do
    --         local tFriendData = require("FriendData").New()
    --         tFriendData:Init(v)
    --         self:Zjsl_SetUidInfo(v.uid, tFriendData)
