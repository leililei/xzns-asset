---通过chatID删除聊天记录
function ChatManager:DelChatByChatID(chatID, channel)
    local myUid = _G.PlayerModel:GetInstance():GetPlayerUid()
    if channel == _G.ChatType.privateChat then
        if self.Chat_InfoAll[channel] == nil then
            return
        end
        for uid, chatList in pairs(self.Chat_InfoAll[channel]) do
            for i = #chatList, 1, -1 do
                if chatList[i].chat_id == chatID and chatList[i].role_info.uid ~= myUid then
                    _G.table.remove(chatList, i)
                end
            end
        end
    else
        local chatList = self.Chat_InfoAll[channel]
        for i = #chatList, 1, -1 do
            if chatList[i].chat_id == chatID and chatList[i].role_info.uid ~= myUid then
                _G.table.remove(chatList, i)
            end
        end
    end
end

