local InviteNewPlayerModel = require "InviteNewPlayerModel"
---@class ChooseRuChannelView : UIBaseView    分享到界面
---@field public go_table ChatView_GoTable GoTable
local ChooseRuChannelView = _G.BaseClass("ChooseRuChannelView", _G.UIBaseView)

local icons = {
    FACEBOOK = "ImagesH5/hCommon/facebook",
    VK = "ImagesH5/hCommon/vk",
    TELEGRAM = "ImagesH5/hCommon/telegram",
    DISCORD = "ImagesH5/hCommon/discord"
}

local txts = {
    FACEBOOK = 90000011838,
    VK = 90000011839,
    TELEGRAM = 90000011838,
    DISCORD = 90000011840
}

local iostxts = {
    FACEBOOK = 90000011838,
    VK = 90000011842,
    TELEGRAM = 90000011843,
    DISCORD = 90000011844
}

function ChooseRuChannelView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@  number _G.ChatType默认打开界面
function ChooseRuChannelView:OnCreate()
    self.Invitationcode = InviteNewPlayerModel:GetInstance():GetSelfCode()
    if _G.AppSetting.DEBUG then
        _G.LogError("获取饿罗斯分享类型列表2")
    end
    _G.SDKManager:GetInstance():SendGetShareTypes(_G.handler(self, self.ShareTypesCallBack))
end

function ChooseRuChannelView:ShareTypesCallBack(b, info)
    if nil == self.go_table then
        return
    end
    if _G.AppSetting.DEBUG then
        _G.Log(info,
            "<color=red><size=18>饿罗斯分享类型列表2</size></color>"
        )
    end
    _G.LoginManager:GetInstance().RuChannelInfo = info

    self.RCInfo = info
    --测试
    --self.RCInfo.shareTypes = {"FACEBOOK","VK","TELEGRAM","DISCORD"}
    self.go_table.obj_item1:SetActiveE(0)
    self.go_table.obj_item2:SetActiveE(0)
    self.go_table.obj_item3:SetActiveE(0)
    self.go_table.obj_item4:SetActiveE(0)
    if self.RCInfo and self.RCInfo.shareTypes then
        for i = 1, #self.RCInfo.shareTypes do
            ---facebook暂时不开放
            if i <= 4 and self.RCInfo.shareTypes[i] ~= "FACEBOOK" then
                self.go_table["obj_item" .. i]:SetActiveE(1)
                self.go_table["aortext_name" .. i].text = self.RCInfo.shareTypes[i]
                self.go_table["aorrawimage_icon" .. i]:LoadImage(icons[self.RCInfo.shareTypes[i]])
            end
        end
    end
end

function ChooseRuChannelView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_backGround" then
        self:Close()
    elseif name == "@_aorbtn_share1" then
        local type = self.RCInfo.shareTypes[1]
        self:ShareMultimedia(type, self.Invitationcode, "https://legion.totorogames.com")
    elseif name == "@_aorbtn_share2" then
        local type = self.RCInfo.shareTypes[2]
        self:ShareMultimedia(type, self.Invitationcode, "https://legion.totorogames.com")
    elseif name == "@_aorbtn_share3" then
        local type = self.RCInfo.shareTypes[3]
        self:ShareMultimedia(type, self.Invitationcode, "https://legion.totorogames.com")
    elseif name == "@_aorbtn_share4" then
        local type = self.RCInfo.shareTypes[4]
        self:ShareMultimedia(type, self.Invitationcode, "https://legion.totorogames.com")
    end
end

function ChooseRuChannelView:ShareMultimedia(type, content, link)
    if _G.AppSetting.IsIos then
        if _G.tostring(type) == "VK" or _G.tostring(type) == "TELEGRAM" then
            _G.SDKManager:GetInstance():ShareMultimedia(type, 1,
                _G.GetLangPackValue(iostxts[type], content), link)
        else
            _G.SDKManager:GetInstance():ShareMultimedia(type, 3,
                _G.GetLangPackValue(txts[type], content), "")
        end
    else
        _G.SDKManager:GetInstance():ShareMultimedia(type, 3,
            _G.GetLangPackValue(txts[type], content), "")
    end
end

return ChooseRuChannelView
