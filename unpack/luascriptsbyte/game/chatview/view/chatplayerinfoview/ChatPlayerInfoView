---@class ChatPlayerInfoView : UIBaseView    聊天界面
---@field public go_table ChatPlayerInfoView_GoTable GoTable
local ChatPlayerInfoView = _G.BaseClass("ChatPlayerInfoView", _G.UIBaseView)
--_G.ChatPlayerInfoView = ChatPlayerInfoView
local UIUtils = _G.UIUtils
local CS = _G.CS
local typeof = _G.typeof
function ChatPlayerInfoView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.toggles = {}
    self.toggles[1] = _G.GetAutoGoTable(self.go_table.toggle_1)
    self.toggles[2] = _G.GetAutoGoTable(self.go_table.toggle_2)
    self.obj_Item = {}
    self.obj_Item[1] = _G.GetAutoGoTable(self.go_table.obj_Item1, _G.handlerbind(self, self.ItemBtn, 1))
    self.obj_Item[2] = _G.GetAutoGoTable(self.go_table.obj_Item2, _G.handlerbind(self, self.ItemBtn, 2))
    self.obj_Item[3] = _G.GetAutoGoTable(self.go_table.obj_Item3, _G.handlerbind(self, self.ItemBtn, 3))
    self.obj_Item[4] = _G.GetAutoGoTable(self.go_table.obj_Item4, _G.handlerbind(self, self.ItemBtn, 4))
    self.Phiz_initID = 1
    self.Phiz_XuanZhongID = 1
    self:initNew()
end

function ChatPlayerInfoView:ItemBtn(go, _, num)
    self.Phiz_XuanZhongID = num
    self:ItemNew()
end

function ChatPlayerInfoView:initNew()
    self:OnToggle(self.Phiz_initID)
    self:ItemNew()
end

-- 当切换Toggle时的回调函数
-- @param index 切换的索引值
function ChatPlayerInfoView:OnToggle(index)
    self.Phiz_initID = index
    self:Phiz_init()
    for i = 1, #self.toggles do
        if self.Phiz_initID == i then
            self.toggles[i].aorimage_isOff:SetActiveE(0)
            self.toggles[i].aortext_isOff:SetActiveE(0)
            self.toggles[i].aorimage_isOn:SetActiveE(1)
            self.toggles[i].aortext_isOn:SetActiveE(1)
        else
            self.toggles[i].aorimage_isOff:SetActiveE(1)
            self.toggles[i].aortext_isOff:SetActiveE(1)
            self.toggles[i].aorimage_isOn:SetActiveE(0)
            self.toggles[i].aortext_isOn:SetActiveE(0)
        end
    end
    if self.Phiz_initID == 2 and #self.PhizArr <= 0 then
        self.go_table.aorimage_kong:SetActiveE(1)
    else
        self.go_table.aorimage_kong:SetActiveE(0)
    end
end

-- 初始化表情数据
function ChatPlayerInfoView:Phiz_init()
    if self.Phiz_initID == 1 then
        self.PhizArr = require("ChatManager"):GetInstance():Phiz_GetAll()
        self.PhizArr = _G.table.values(self.PhizArr)
    elseif self.Phiz_initID == 2 then
        self.PhizArr = require("ChatManager"):GetInstance():Phiz_GetGif()
        self.PhizArr = _G.table.values(self.PhizArr)
        _G.SortList(
            self.PhizArr,
            function(a)
                local num = require("ChatManager"):GetInstance():GetPhiz_ChatData(a.id)

                return num, -a.id
            end
        )
    end


    if self.phiz == nil then
        self.phiz = true
        self.go_table.scrollloopvectical_phiz:InitItemData(#self.PhizArr, _G.handler(self, self.RefreshList_phiz))
    else
        if self.MaxPhiz == #self.PhizArr then
            self.go_table.scrollloopvectical_phiz:UpdateAllItem()
        else
            self.go_table.scrollloopvectical_phiz:UpdateCount(#self.PhizArr)
        end
        self.MaxPhiz = #self.PhizArr
    end
end

function ChatPlayerInfoView:RefreshList_phiz(index, objGame)
    if index < 0 then
        return
    end
    ---@type expression_cfg
    local cfg = self.PhizArr[index + 1]
    local itemGoTable = _G.GetAutoGoTable(objGame, _G.handlerbind(self, self.OnClick_phiz, cfg))
    itemGoTable.Phiz_id = cfg.id
    local is = require("ChatManager"):GetInstance():GetPhiz_CallSendChat(cfg.id)
    itemGoTable.aorimage_Hei:SetActiveE(is)
    if cfg.gif == 0 then
        itemGoTable.aorrawimage_icon:SetActiveE(1)
        itemGoTable.obj_spine:SetActiveE(0)
        itemGoTable.aorrawimage_icon.Alpha = 0
        itemGoTable.aorrawimage_icon:LoadImage(cfg.img_path)
    elseif cfg.gif == 1 then
        itemGoTable.aorrawimage_icon:SetActiveE(0)
        itemGoTable.obj_spine:SetActiveE(1)
        itemGoTable.obj_spine:ClearChildren()
        _G.UIUtils.LoadEffectByPath(cfg.img_path, itemGoTable.obj_spine)
    end

    return objGame
end

function ChatPlayerInfoView:OnClick_phiz(go, _, itemGoTable)
    local Phiz_id = itemGoTable.id

    ---@type expression_cfg
    local cfg = _G.ConfigManager.expression_cfg[Phiz_id]
    if cfg ~= nil then
        require("ChatManager"):GetInstance():SaveDataID(self.Phiz_XuanZhongID, cfg.id,
            _G.handler(self, self.initNew))
    end
end

function ChatPlayerInfoView:ItemNew()
    local is = true
    for key, value in pairs(self.obj_Item) do
        local id = require("ChatManager"):GetInstance():GetPhiz_CallSendChatID(key)

        if id == 0 then
            if is then
                is = false
                self.Phiz_XuanZhongID = key
            end

            value.aorrawimage_icon:SetActiveE(0)
            value.obj_spine:SetActiveE(0)
        else
            local cfg = _G.ConfigManager.expression_cfg[id]
            if cfg.gif == 0 then
                value.aorrawimage_icon:SetActiveE(1)
                value.obj_spine:SetActiveE(0)
                value.aorrawimage_icon.Alpha = 0
                value.aorrawimage_icon:LoadImage(cfg.img_path, function()
                    value.aorrawimage_icon:SetNativeSize()
                end)
            elseif cfg.gif == 1 then
                value.aorrawimage_icon:SetActiveE(0)
                value.obj_spine:SetActiveE(1)
                value.obj_spine:ClearChildren()
                _G.UIUtils.LoadEffectByPath(cfg.img_path, value.obj_spine)
            end
        end
    end
    for key, value in pairs(self.obj_Item) do
        if self.Phiz_XuanZhongID == key then
            value.aorimage_xuanzhong:SetActiveE(1)
        else
            value.aorimage_xuanzhong:SetActiveE(0)
        end
    end
end

-- 点击按钮的回调函数
-- @param go 点击的游戏对象
-- @param isOn 按钮是否被选中
function ChatPlayerInfoView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "$_toggle_1" then
        self:OnToggle(1)
    elseif name == "$_toggle_2" then
        self:OnToggle(2)
    elseif name == "@_aorbtn_shadow" then
        self:Close()
    elseif name == "@_aorbtn_close" then
        self:Close()
    end
end

return ChatPlayerInfoView
