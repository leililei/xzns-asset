---@class ChatPrivateView : UIBaseView	中文描述
---@field public go_table ChatPrivateView_GoTable GoTable
local ChatPrivateView = _G.BaseClass("ChatPrivateView", _G.UIBaseView)

function ChatPrivateView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ChatPrivateView:OnCreate(parent)
    self.parent = parent
    local friendList = require("FriendManager"):GetInstance():GetFriendList()
    self.friendList = _G.table.values(friendList)
    local friendCount = #self.friendList
    if friendCount > 0 then
        _G.table.sort(
            self.friendList,
            function(a, b)
                if a.time == 0 or b.time == 0 then
                    return a.time < b.time
                end
                return a.time > b.time
            end
        )
    end
    self.go_table.scrollloopvectical_friend:InitItemData(friendCount, _G.handler(self, self.RefreshListItem))
    self.go_table.aortext_num.text = friendCount .. "/" .. _G.ConfigManager.discrete_cfg[100301][1][1]
end

function ChatPrivateView:RefreshListItem(index, obj)
    local data = self.friendList[index + 1]
    local tb = _G.GetAutoGoTable(obj, _G._G.handlerbind(self, self.OnClickItem, data))
    tb.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(data.power)
    tb.aortext_name.text = data.name
    if not data.time or data.time == 0 then
        _G.GameUtil.SetActiveByCondition(tb.aortext_Offline, false)
        _G.GameUtil.SetActiveByCondition(tb.aortext_Online, true)
    else
        local time = _G.TimeUtil.GetServerUnixTime() - data.time
        if time < 60 then
            tb.aortext_Offline.text = _G.GetLangPackValue(90022500384)
        else
            time = time / 60
            if time < 60 then
                tb.aortext_Offline.text = _G.math.floor(time) .. _G.GetLangPackValue(90022500387)
            else
                time = time / 60
                if time < 24 then
                    tb.aortext_Offline.text = _G.math.floor(time) .. _G.GetLangPackValue(90022500388)
                else
                    time = time / 24
                    if time < 30 then
                        tb.aortext_Offline.text = _G.math.floor(time) .. _G.GetLangPackValue(90022500389)
                    else
                        tb.aortext_Offline.text = _G.GetLangPackValue(90022500390)
                    end
                end
            end
        end
        _G.GameUtil.SetActiveByCondition(tb.aortext_Offline, true)
        _G.GameUtil.SetActiveByCondition(tb.aortext_Online, false)
    end
    local PlayerHeadItem = {}
    PlayerHeadItem.frame = data.frame
    PlayerHeadItem.lv = data.lv
    PlayerHeadItem.style = data.style
    PlayerHeadItem.sid = _G.ConfigManager.player_portrait_cfg[data.style].ID
    PlayerHeadItem.title = data.title
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, PlayerHeadItem, 1, true, true, true)
end

function ChatPrivateView:OnClickItem(_, _, data)
    require("ChatManager"):GetInstance():Zjsl_OpenView(data.uid)
    if self.parent then
        self.parent:SetPrivateUid(data.uid)
    end
    self:Close()
end

---界面的销毁函数
function ChatPrivateView:OnDestroy()
end

---按钮点击事件在这里派发
function ChatPrivateView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_colse then
        self:Close()
    end
end

return ChatPrivateView
