local ChatViewNet = _G.BaseClass("ChatViewNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return ChatViewNet ChatViewNet
function ChatViewNet:GetInstance()
    return self.super.super.GetInstance(self)
end

function ChatViewNet:__init()
end

---添加所有后端主动推的网络消息监听接口
function ChatViewNet:AddMessageListeners()
    self:AddMessageListener(_G.ConfigManager.net_map.chat.Cmd, self.P2C_CallCHAT)
    self:AddMessageListener(_G.ConfigManager.net_map.del_chat_info.Cmd, self.P2C_CallDelCHAT)
end

---后端主动推送的聊天数据
---@param data chat.p2c_chat PB数据
function ChatViewNet:P2C_CallCHAT(data)
    if _G.IsNil(data) or _G.IsNil(data.list) then
        return
    end

    if self.rolename == nil then
        self.rolename = _G.PlayerModel:GetInstance():GetName()
    end

    for key, value in pairs(data.list) do
        if
            value.type == 2 and value.channel == 3 and value.n_content[1] == "90021800084" and
            value.n_content[2] == self.rolename
        then
            ---- 自己加入公会 服务器会推送自己加入  前端拉取的公会历史消息已包含  不处理此推送
        else
            value = require("ChatManager"):GetInstance():NewChatProcess(value, true) --解析为真实消息内容
            --_G.Events:GetInstance():Broadcast(_G.eChatStatus.MainNewChat, value)

            require("ChatManager"):GetInstance():P2C_NewChat(value)
        end
    end
end

---后端主动推送删除聊天
---@param data chat.p2c_del_chat
function ChatViewNet:P2C_CallDelCHAT(data)
    require("ChatManager"):GetInstance():P2C_DelChat(data)
end

---请求
---@param pbData table PB数据
---@param callback function 完成回调
function ChatViewNet:SendCHAT(pbData, callback)
    local item = _G.ConfigManager.net_map.game_chat
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallCHAT))
    self.Call[port] = callback
end

