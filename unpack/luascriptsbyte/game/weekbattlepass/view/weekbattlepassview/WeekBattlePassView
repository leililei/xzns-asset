---@class WeekBattlePassView : UIBaseView    中文描述
---@field public go_table WeekBattlePassView_GoTable GoTable
local WeekBattlePassView = _G.BaseClass("WeekBattlePassView", _G.UIBaseView)

---构造函数
---@protected
function WeekBattlePassView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function WeekBattlePassView:OnCreate(activity)
    self.activity = activity
    self.activitySynModel = self.activity:GetActivityTypeCls()
    self:InitView()
end

function WeekBattlePassView:InitView()
    self.activitySynModel:ChangeOpenViewRed()
    self.RTS = self.activity.cfg.time.start_time + self.activity.cfg.time.run_time - _G.GetNowUnixTime()
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimer, self, false, false, true)
    self.timer:Start()
    self:SetGiftState()
    self:UpdateTimer(0)
    self:InitLoopList()
    -- local times = _G.TimeUtil.GetDateTime(self.activity.cfg.time.start_time + self.activity.cfg.time.run_time)
    --self.go_table.aortext_des.text = _G.GetLangPackValue(92010090003, times.month, times.day)
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_WeekBattlePassView_bg,
        self.go_table.obj_effect1,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
        end
    )
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_WeekBattlePassView_qizhi,
        self.go_table.obj_effect2,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
        end
    )
end

function WeekBattlePassView:UpdateTimer(elapsed)
    self.RTS = self.RTS - elapsed
    if self.RTS <= 0 then
        self.timer:Stop()
        self.timer = nil
        self:Close()
        return
    end
    self.go_table.aortext_countDown.text = _G.GetLangPackValue(90027600008, _G.TimeUtil.GiftPackGroupTime(self.RTS))
end

---
---@protected
function WeekBattlePassView:SetGiftState()
    self.state = self.activitySynModel:GetGiftState()
    if self.state == 0 then
        local giftCfg = self.activitySynModel:GetGiftCfg()
        _G.GameUtil.SetPriceByChannel(giftCfg.price, self.go_table.aortext_charge)
        _G.GameUtil.AddDouYinIcon(self.go_table.aorbtn_buy, true)
    else
        local isGet = self.activitySynModel:CheckGetAward()
        if isGet == 1 then
            self.go_table.aortext_charge.text = _G.GetLangPackValue(90025500018)
            self.go_table.aortext_charge.color = require("CardInfoManager").GetColorFromRGB("815633")
        else
            self.go_table.aortext_charge.text = _G.GetLangPackValue(90028300117)
            self.go_table.aortext_charge.color = require("CardInfoManager").GetColorFromRGB("414141")
        end
        self.go_table.aorbtn_buy:SetGray(isGet == 0)
    end
end

function WeekBattlePassView:InitLoopList()
    self.awardCfg = self.activitySynModel:GetAwardCfg()
    if self.Init == nil then
        self.go_table.looplist2_awardList:InitListView(#self.awardCfg, _G.handler(self, self.OnRefreshContent))
        self.Init = true
    else
        self.go_table.looplist2_awardList:RefreshAllShownItem()
    end
end

function WeekBattlePassView:OnRefreshContent(listView2, index)
    local newIndex = index + 1
    local data = self.awardCfg[newIndex]
    local itemName = "$_obj_RewardItem2"
    local effect = _G.ConfigManager.ui_effect_cfg.ef_WeekBattlePassView_xiaokuang
    if tonumber(data.args) == 1 then
        --是有称号的奖励
        itemName = "$_obj_RewardItem"
        effect = _G.ConfigManager.ui_effect_cfg.ef_WeekBattlePassView_kuang
    end

    local obj = listView2:NewListViewItem(itemName)
    local go_table = _G.GetAutoGoTable(obj)
    _G.UIUtils.RemoveChildren(go_table.obj_itemRoot)
    for i = 1, #data.award do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            data.award[i].type,
            go_table.obj_itemRoot,
            function(tran)
                tran.gameObject:SetLocalScaleXYZ(1)
                tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                tran:SetGou(self.activitySynModel:CheckIsGet(data.sid))
                if tran.ShowEffectOrder and tran.cfg then
                    tran:ShowEffectOrder(tran.cfg.ef_item == 1 and true or false)
                end
            end
        )
    end

    local isGet = self.activitySynModel:CheckIsGet(data.sid)
    if _G.AppSetting.IsXzns then
        go_table.aortext_des.color = require("CardInfoManager").GetColorFromRGB(isGet and "414141" or "50351E")
    end
    if isGet == false then
        local isCanGet = self.activitySynModel:CheckCanGetAward(data)
        if isCanGet == true then
            if self.state == 0 then
                go_table.aortext_des.text = _G.GetLangPackValue(90023800127)
                go_table.obj_effect:SetActiveE(0)
            else
                go_table.aortext_des.text = _G.GetLangPackValue(90028300116)
                go_table.obj_effect:SetActiveE(1)
                _G.UIUtils.RemoveChildren(go_table.obj_effect)
                _G.UIUtils.LoadEffectByCfg(
                    effect,
                    go_table.obj_effect,
                    function(trans)
                        if self:IsNil() then
                            _G.DestroyObject(trans)
                        end
                        trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                    end
                )
            end
        else
            go_table.obj_effect:SetActiveE(0)
            if go_table.aortext_des2 then
                local times = _G.TimeUtil.GetDateTime(self.activity.cfg.time.start_time + (data.week - 1) * 604800)
                go_table.aortext_des.text = ""
                go_table.aortext_des2.text = _G.GetLangPackValue(92010090004, times.month, times.day)
            end
        end
        if go_table.obj_nameNode then
            go_table.obj_nameNode:SetActiveE(isCanGet == true and 1 or 0)
        end
        if go_table.obj_Lock then
            go_table.obj_Lock:SetActiveE(isCanGet == true and 0 or 1)
        end
    else
        if go_table.obj_nameNode then
            go_table.obj_nameNode:SetActiveE(1)
        end
        if go_table.obj_Lock then
            go_table.obj_Lock:SetActiveE(0)
        end
        go_table.aortext_des.text = _G.GetLangPackValue(90028300117)
    end

    return obj
end

---界面的销毁函数
function WeekBattlePassView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---按钮点击事件在这里派发
function WeekBattlePassView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_tips then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 199)
    elseif go == self.go_table.aorbtn_buy then
        if self.state == 0 then
            self.activitySynModel:BuyGift(function()
                self:SetGiftState()
                self:InitLoopList()
            end)
        else
            local isGet = self.activitySynModel:CheckGetAward()
            if isGet == 1 then
                local list = {}
                for i, v in ipairs(self.awardCfg) do
                    if self.activitySynModel:CheckCanGetAward(v) and not self.activitySynModel:CheckIsGet(v.sid) then
                        _G.table.insert(list, v.sid)
                    end
                end
                self.activitySynModel:GetAward(list, function()
                    self:SetGiftState()
                    self:InitLoopList()
                end)
            else
                self.activitySynModel:UpdateRedPoint(1)
            end
        end
    end

    if self.go_table.toggle_eject.isOn then
        _G.PlayerPrefsManager.SetInt("WeekBattlePass",
            _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime()))
    else
        _G.PlayerPrefsManager.SetInt("WeekBattlePass", 0)
    end
end

return WeekBattlePassView
