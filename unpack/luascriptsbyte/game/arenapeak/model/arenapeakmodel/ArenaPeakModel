---创建对象时,入口构造函数
function ArenaPeakModel:__init()
    self.curFunctionOpenID = 138
    self.monsterGroup = 500000003
    self.dayOpenCfg = ConfigManager.discrete_cfg[108101]
    if #self.dayOpenCfg % 2 == 1 and _G.AppSetting.DEBUG then
        _G.LogError("离散表108101开启阶段时间配置有误！")
    end
    self.waitFriday = false
    ---@type arena_peak_league_cfg[]
    local leagueCfg = ConfigManager.arena_peak_league_cfg
    self.kingID = 1
    self.masterID = 0
    for i = 1, #leagueCfg do
        if leagueCfg[i].id > self.kingID then
            self.kingID = leagueCfg[i].id
            self.masterID = leagueCfg[i - 1].id
        end
    end
    local EventsIns = _G.Events:GetInstance()
    local net_map = _G.ConfigManager.net_map
    EventsIns:AddListener(net_map.arena_peak_task_curr.Cmd, self.OnMatchSuccessCall, self)
    _G.Events:GetInstance():AddListener(
        _G.ConfigManager.net_map.arena_peak_request_sparring.Cmd,
        self.OnRequestSparring,
        self
    )
    _G.Events:GetInstance():AddListener(_G.ePlayAactionEvent.PlayAaction, self.CombineChange, self)
    _G.Events:GetInstance():AddListener(_G.eCardStorage.AddCardData, self.AddCardCount, self)
    _G.Events:GetInstance():AddListener(_G.eCardStorage.RemoveCardData, self.ReduceCardCount, self)
end

