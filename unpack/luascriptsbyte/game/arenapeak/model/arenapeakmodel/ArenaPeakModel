---获取开启时间文本
function ArenaPeakModel:GetOpenTimeStr()
    local str
    local kingCfg = ConfigManager.discrete_cfg[108131][1]
    if self.danID == kingCfg[1] then
        str = _G.string.format("%02d:00~%02d:00", kingCfg[2], kingCfg[3])
    else
        str = ""
        for i = 1, #self.dayOpenCfg do
            if i % 2 == 1 then
                if i == 1 then
                    str = str .. _G.string.format("%02d:%02d", self.dayOpenCfg[i][1], self.dayOpenCfg[i][2])
                else
                    str = str .. _G.string.format("\n%02d:%02d", self.dayOpenCfg[i][1], self.dayOpenCfg[i][2])
                end
            else
