function ArenaPeakModel:GetDayStartTimeAndEndTime()
    local startT = self.dayOpenCfg[1]
    local endT = self.dayOpenCfg[#self.dayOpenCfg]
    local startTime = startT[1] * 3600 + startT[2] * 60 + startT[3]
    local endTime = endT[1] * 3600 + endT[2] * 60 + endT[3]
    return startTime, endTime
end

---获取每日开启时间段
function ArenaPeakModel:GetDayOpenTimeArray()
    local timeArray = {}
    local time
    for i = 1, #self.dayOpenCfg do
        time = self.dayOpenCfg[i]
        _G.table.insert(timeArray, time[1] * 3600 + time[2] * 60 + time[3])
    end
    return timeArray
end

---检测当前是否在挑战时间内/能否挑战
---@return number 注0.开放时间内，-1.赛季关闭，1.未开始，2.已休战
function ArenaPeakModel:CheckInOpenTime()
    if self:CheckSeasonIsOpen() then
        local timeArray = self:GetDayOpenTimeArray()
        local now = TimeUtil.GetSecondsOfDay()
        if now < timeArray[1] then
            if now > _G.TimeUtil.GAME_DAY_TIME then
                return 1, 880104
            end
            return 2, 880102
        elseif now >= timeArray[#timeArray] then
            return 2, 880102
        else
            for i = 2, #timeArray - 1 do
                if now < timeArray[i] then
                    if i % 2 == 0 then
                        return 0, nil
                    else
                        return 3, 880104
                    end
                end
            end
            return 0, nil
        end
    end
    return -1, nil
end

---检测是否满足王者时间
---@return boolean, boolean 满足段位，满足时间
function ArenaPeakModel:CheckInKingOpenTime()
    local cfg = ConfigManager.discrete_cfg[108131][1]
    if self.danID == cfg[1] then
        local now = TimeUtil.GetSecondsOfDay()
        if now >= cfg[2] * 3600 and now < cfg[3] * 3600 then
            return true, true
        end
        return true, false
    end
    return false, false
end

