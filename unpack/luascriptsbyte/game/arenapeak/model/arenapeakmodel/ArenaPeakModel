---@private
function ArenaPeakModel:BroadcastTaskEnum(enum)
    ---进行X次巅峰演武战斗
    if enum == 0 or enum == _G.ActiveTaskEnum.ConditionEnum.ArenaPeak.FightNum then
        _G.Events:GetInstance():Broadcast(
            _G.ePlayAactionEvent.PlayAaction,
            { _G.ActiveTaskEnum.ConditionEnum.ArenaPeak.FightNum },
            1
        )
    end
    ---巅峰演武获胜X场
    if enum == 0 or enum == _G.ActiveTaskEnum.ConditionEnum.ArenaPeak.WinNum then
        _G.Events:GetInstance():Broadcast(
            _G.ePlayAactionEvent.PlayAaction,
            { _G.ActiveTaskEnum.ConditionEnum.ArenaPeak.WinNum },
            1
        )
    end
    ---使用支援角色进行X次巅峰演武战斗
    if enum == 0 or enum == _G.ActiveTaskEnum.ConditionEnum.ArenaPeak.SupportNum then
        _G.Events:GetInstance():Broadcast(
            _G.ePlayAactionEvent.PlayAaction,
            { _G.ActiveTaskEnum.ConditionEnum.ArenaPeak.SupportNum },
            1
        )
    end
end

