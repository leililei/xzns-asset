---根据积分获取段位配置
---@param score number 积分
---@return arena_peak_league_cfg 段位配置
function ArenaPeakModel:GetDanCfgByScore(score)
    for key, cfg in pairs(ConfigManager.arena_peak_league_cfg) do
        if score >= cfg.min_score and score <= cfg.max_score then
            return cfg
        end
    end
    return nil
end

---根据积分获取段位配置（做王者判断）
---@param score number 积分
---@return arena_peak_league_cfg 段位配置
function ArenaPeakModel:GetDanCfgByScoreAndKing(score, isKing)
    if isKing then
        return ConfigManager.arena_peak_league_cfg[self.kingID]
    end
    for key, cfg in pairs(ConfigManager.arena_peak_league_cfg) do
        if score >= cfg.min_score and score <= cfg.max_score then
            -- if cfg.id == self.kingID then
            --     return ConfigManager.arena_peak_league_cfg[self.masterID]
            -- end
            return cfg
        end
    end
    return nil
end

---根据段位id获取段位配置
---@param id number 段位id
---@return arena_peak_league_cfg 段位配置
function ArenaPeakModel:GetDanCfgByID(id)
    return ConfigManager.arena_peak_league_cfg[id]
end

---获取当前段位配置
---@return arena_peak_league_cfg 当前段位配置
function ArenaPeakModel:GetCurDanCfg()
    return self:GetDanCfgByID(self.danID)
end

---获取下一段位配置
---@return arena_peak_league_cfg 下一段位配置
function ArenaPeakModel:GetNextDanCfg()
    return self:GetDanCfgByID(self.danID + 1)
end

---获取当前段位和下一段位的奖励
---@return number[][],number[][]
function ArenaPeakModel:GetCurAndNextDanAward()
    local cfg = self:GetCfg()
    local rewards = cfg.reward_season
    local curID, nextID
    for _, v in pairs(rewards) do
        if v[1] == self.danID then
            curID = v[2]
        elseif v[1] == self.danID + 1 then
            nextID = v[2]
        end
    end
    local curAwards = arena_peak_tier_cfg[curID].reward_season
    local nextAwards
    if nextID then
        nextAwards = arena_peak_tier_cfg[nextID].reward_season
    end
    return curAwards, nextAwards
end

---检查该段位id是否为王者
---@return boolean 是否是王者
function ArenaPeakModel:CheckDanIsKing(danID)
    return danID == self.kingID
end

---是否达到指定段位，并返回指定段位配置
---@return boolean,arena_peak_league_cfg 是否达到，指定段位配置
function ArenaPeakModel:GetAchieveDan(danID)
    if self.hisDan == nil then
        self.hisDan = 0
    end
    local achieve = self.hisDan >= danID and true or false
    return achieve, ConfigManager.arena_peak_league_cfg[danID]
end

---根据积分返回星星数量、图片
---@return number,string 段位星数，段位星图标
function ArenaPeakModel:GetStarByScore(score)
    for key, cfg in pairs(ConfigManager.arena_peak_league_cfg) do
        if score >= cfg.min_score and score <= cfg.max_score then
            local art = cfg.art == "" and self:GetDefaultStarImage() or cfg.art
            return cfg.quantity, art
        end
    end
    return nil, nil
end

---获取默认星星图片
---@return string 默认星星图片（黑）
function ArenaPeakModel:GetDefaultStarImage()
    return "ui_dfyw_xingxing_weidianliang"
end


---展示段位（配置只有新手和王者段位只显示大图标，其它段位则只显示星星）
---@param obj _obj_my._obj_dan_GoTable 巅峰演武相关界面段位展示obj
---@param score number 积分
---@param always boolean 是否始终展示大图标
---@param isKing boolean 是否是王者
---@param dan boolean 段位（可选）
function ArenaPeakModel:ShowDan(obj, score, always, isKing, dan)
    local cfg
    if dan then
        cfg = ConfigManager.arena_peak_league_cfg[dan]
    else
        cfg = self:GetDanCfgByScoreAndKing(score, isKing)
    end
    if not cfg then
        return
    end
    local tb = _G.GetAutoGoTable(obj)
    for i = 1, 3 do
        if i <= cfg.quantity then
            tb["aorimage_star" .. i].SpriteName = cfg.art
        else
            tb["aorimage_star" .. i].SpriteName = self:GetDefaultStarImage()
        end
    end
    local special = cfg.quantity <= 0 and cfg.id ~= 1
    if always or special then
        tb.aorrawimage_dan:LoadImage(
                cfg.icon,
                function(trans)
                    trans.Alpha = 1
                end
        )
    end

    tb.obj_star:SetActiveE(special and 0 or 1)
end


