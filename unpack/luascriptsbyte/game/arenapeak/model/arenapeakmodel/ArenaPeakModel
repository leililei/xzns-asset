            --self:BroadcastTaskEnum(_G.ActiveTaskEnum.ConditionEnum.ArenaPeak.WinNum)
        end
        local newCfg = self:GetDanCfgByScoreAndKing(self.score, self.isKing)
        if newCfg.id > self.danID then
