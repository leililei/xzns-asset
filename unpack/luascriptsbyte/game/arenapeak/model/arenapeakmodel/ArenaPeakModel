        end
        self.danCfg = newCfg
        self.danID = newCfg.id
        self.isKing = self.danID == self.kingID
        self:UpdateHistoryMaxDanID()
        --if self.useSupport then
        --    self:BroadcastTaskEnum(_G.ActiveTaskEnum.ConditionEnum.ArenaPeak.SupportNum)
