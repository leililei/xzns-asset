---战后增加荣誉勋章
---@param msg arena_peak.s2c_arena_peak_fight
function ArenaPeakModel:AddCoin(msg)
    if self.coin == nil then --理论上不会为nil,这里容错预防
        self.coin = 0
        if _G.AppSetting.DEBUG then
            _G.LogError("请检查巅峰演武货币为何没初始化！")
        end
    end
    if msg.award and msg.award.item then
        for _, v in pairs(msg.award.item) do
            if v.type[1] == 19 then
                self.coin = self.coin + v.type[2]
            end
        end
    end
end

