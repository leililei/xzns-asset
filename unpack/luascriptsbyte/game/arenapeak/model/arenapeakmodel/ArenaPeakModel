---销毁对象时,析构函数
function ArenaPeakModel:Dispose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.mainTimer then
        self.mainTimer:Stop()
        self.mainTimer = nil
    end
    if self.do1 then
        _G.coroutine.stopwaiting(self.do1)
        self.do1 = nil
    end
    if self.do2 then
        _G.coroutine.stopwaiting(self.do2)
        self.do2 = nil
    end
    _G.Events:GetInstance():RemoveListener(
            _G.ConfigManager.net_map.arena_peak_request_sparring.Cmd,
            self.OnRequestSparring,
            self
    )
    _G.Events:GetInstance():RemoveListener(_G.ePlayAactionEvent.PlayAaction, self.CombineChange, self)
    _G.Events:GetInstance():RemoveListener(_G.eCardStorage.AddCardData, self.AddCardCount, self)
    _G.Events:GetInstance():RemoveListener(_G.eCardStorage.RemoveCardData, self.ReduceCardCount, self)
    self.super.Dispose(self)
end

---判断是否弹出巅峰演武新赛季
function ArenaPeakModel:NewSeasonFrame()
    if self:IsWaitFriday() then--是否需要等到周五（首次周五开启）
        return false
    elseif self:CheckSeasonIsOpen() and self.seasonState == 1 then --0等待 1开放
        if _G.table.count(self:GetCfg().eff_path) < 2 then --未配置皮肤
            return false
        end
        return true
    else
        return false
    end
end

