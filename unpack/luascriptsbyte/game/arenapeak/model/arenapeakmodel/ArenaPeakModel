---获取本赛季结束时间
---@return number 赛季结束时间
function ArenaPeakModel:GetEndTime()
    local cfg = ConfigManager.arena_peak_cfg[self.seasonID]
    if cfg then
        return self.seasonStartTime + cfg.duration * 86400
    end
    return 0
end

---获取结算开始时间（什么时候开始结算）
---@return number 结算开始时间（具体日期时间戳）
function ArenaPeakModel:GetSettlementStartTime()
    local startTime, endTime = self:GetDayStartTimeAndEndTime()
    local cfg = ConfigManager.arena_peak_cfg[self.seasonID]
    if cfg then
        return self.seasonStartTime + cfg.duration * 86400 - 108000 + endTime
    end
    return 0
end

---获取距离开始结算还有多少时间（倒计时）
---@return number 距离结算开始的时间（若功能未开放则为0）
function ArenaPeakModel:GetStartSettlementTime()
    if self:CheckSeasonIsOpen() then
        local startTime, endTime = self:GetDayStartTimeAndEndTime()
        return self:GetEndTime() - TimeUtil.GetServerUnixTime() - (86400 - endTime + _G.TimeUtil.GAME_DAY_TIME)
    end
    return 0
end

---赛季是否进行中(含结算期)
---@return boolean 赛季是否正在进行
function ArenaPeakModel:CheckSeasonIsOpen()
    return TimeUtil.GetServerUnixTime() - self:GetEndTime() < 0
end

---剩余结算时间（非结算中则为0）
---@return number 剩余结算时间
function ArenaPeakModel:GetSettlementTime()
    if self.waitFriday then
        return 0
    end
    if self.seasonID == nil then
        return 0
    end
    local peakCfg = ConfigManager.arena_peak_cfg
    local startTime, endTime = self:GetDayStartTimeAndEndTime()
    local state, tipsID = self:CheckInOpenTime()
    local now = TimeUtil.GetServerUnixTime()
    if self.seasonID > 1 then
        if TimeUtil.GetIntervalDay(now, self.seasonStartTime) == 0 and state == 1 then --新赛季第一天
            return startTime - TimeUtil.GetSecondsOfDay()
        elseif now < self.seasonStartTime then
            return self.seasonStartTime - now + startTime - _G.TimeUtil.GAME_DAY_TIME
        end
    end
    local cfg = peakCfg[self.seasonID]
    local delta = now - self.seasonStartTime
    if delta > (cfg.duration - 1) * 86400 and delta <= cfg.duration * 86400 then --最后一天
        if state == 2 then
            if cfg.interval == 0 then
                local daySec = TimeUtil.GetSecondsOfDay()
                if daySec > endTime then
                    return startTime + 86400 - daySec
                else
                    return startTime - daySec
                end
            else
                return (cfg.interval + cfg.duration) * 86400 - delta
            end
        end
    elseif delta > cfg.duration * 86400 then
        if cfg.interval == 0 then
            return self.seasonStartTime + cfg.duration * 86400 + startTime - _G.TimeUtil.GAME_DAY_TIME - now
        else
            return self.seasonStartTime + (cfg.duration + cfg.interval) * 86400 - now
        end
    end
    return 0
end

---获取当日和当日积分和代币上限
---@return number, number, number 第x天，积分上限，代币上限
function ArenaPeakModel:GetScoreAndMedalMax()
    local day = TimeUtil.GetInterValDayByGame(self.seasonStartTime, TimeUtil.GetServerUnixTime()) + 1
    ---@type arena_peak_restrict_cfg
    local cfg = ConfigManager.arena_peak_restrict_cfg[day]
    if cfg then
        return day, cfg.score, cfg.rewards[2]
    end
    return day, 0, 0
end

