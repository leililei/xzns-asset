    if not self:CheckSeasonIsOpen() or self.seasonState == 0 then
        return false
    end
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.curFunctionOpenID) then
        return false
    end
    for i = 1, 3 do
        local count, all = require "CombineModel":GetInstance():GetActiveCount(i)
        if count == 0 then
