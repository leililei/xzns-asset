---解析基本信息
---@param msg arena_peak.s2c_arena_peak_info
function ArenaPeakModel:ParseData(msg)
    self.hisDan = 1
    self.waitFriday = false
    if msg.is_open then
        self.waitFriday = true
        self:TryToDestroyRoom()
    else
        local sInfo = msg.info
        self.seasonID = sInfo.season_id
        self.seasonStartTime = sInfo.season_start_time
        self.seasonState = sInfo.season_state --0等待 1开放
        self.supportList = sInfo.season_support or {} --周免支援角色
        self.taskInfoId = {}
        --self:InitSupportCards()
        if self.seasonState == 1 then
            local info = msg.role_info
            self.score = info.score
            self.isKing = info.is_king
            self.danCfg = self:GetDanCfgByScoreAndKing(self.score, self.isKing)
            self.danID = self.danCfg.id or 0
            self.rankNum = info.rank_num
            self.rankTimes = info.rank_times
            self.totalNum = info.fights[1]
            self.winNum = info.fights[2]
            self.hisDan = info.his_dan
            self.coin = info.coin
            self.taskInfo = info.task_info
            if info.state == 1 then --匹配中，则退出匹配
                ArenaPeakNet:GetInstance():QuitMatch()
            elseif info.state == 2 then --对局中，则重连回房间
                local embattleItem = require("EmbattleController"):GetInstance():GetCurEmbattleItem()
                local peakView = UIManager:GetInstance():GetWindowCtrl(ConfigManager.ui_cfg.ArenaPeakView.Name)
                if embattleItem then
                    ArenaPeakNet:GetInstance():GetRoomInfo(
                        function(data)
                            if data.ack == 1 then
                                local ctrl =
                                    UIManager:GetInstance():GetWindowCtrl(ConfigManager.ui_cfg.ArenaPeakBPView.Name)
                                if ctrl then
                                    ctrl:InitView(data.room_info)
                                end
                            end
                        end
                    )
                elseif peakView then
                    self:UpdateAllSupportAttr()
                    ArenaPeakNet:GetInstance():GetRoomInfo(
                        function(data)
                            if data.ack == 1 then
                                peakView:CloseOtherView()
                                self:OnChallenge(data.room_info)
                            end
                        end
                    )
                else
                    _G.Events:GetInstance():AddListener(_G.eScene.EnterWorldOver, self.OnWorldLoadOver, self)
                end
            elseif info.state == 0 then --正常状态
                self:TryToDestroyRoom()
            end
            local ctrl = UIManager:GetInstance():GetWindowCtrl(ConfigManager.ui_cfg.ArenaPeakView.Name)
            if ctrl then --断线重连主页面处理
                ctrl:CancelMatch()
                ctrl:InitView()
            end
            self:ArenaPeakTask()
            ctrl = UIManager:GetInstance():GetWindowCtrl(ConfigManager.ui_cfg.ArenaPeakTaskView.Name)
            if ctrl then --断线重连任务界面处理
                ctrl:ItemNew()
            end
            if self.timer then
                self.timer:Stop()
                self.timer = nil
            end
            local settleStartTime = self:GetSettlementStartTime() - TimeUtil.GetServerUnixTime()
            if settleStartTime > 0 then
                self.timer =
                    _G.TimerManager:GetInstance():GetTimer(
                    settleStartTime,
                    self.EnterSettlement,
                    self,
                    true,
                    false,
                    true
                )
                self.timer:Start()
            end
            self:InitSupportCards()
            self:CreateMainViewTimer()
        else
            self:TryToDestroyRoom()
            if self.timer then
                self.timer:Stop()
                self.timer = nil
            end
            local settleTime = self:GetSettlementTime()
            if settleTime > 0 then
                self.timer =
                    _G.TimerManager:GetInstance():GetTimer(settleTime, self.GetDataFormServer, self, true, false, true)
                self.timer:Start()
            end
        end
        require "ShopModel":GetInstance():GetShopInServer(_G.ShopID.ArenaPeak)
    end
    self:RefreshAllRedPoint()
    self.isOpen = self:CheckIsOpen()
    self.super.ParseData(self)
end

