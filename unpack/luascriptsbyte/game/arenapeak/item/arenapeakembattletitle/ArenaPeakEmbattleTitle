--region ===============角色头顶信息Item=======================
local ArenaPeakEmbattleTitle = _G.BaseClass("ArenaPeakEmbattleTitle")
local elementType = _G.CardElementType
local elementImageName = {
    [elementType.Thunder] = "ui_js_renlei_icon",
    [elementType.Wind] = "ui_js_shouren_icon",
    [elementType.Water] = "ui_js_jingling_icon",
    [elementType.Fire] = "ui_js_wangling_icon",
    [elementType.Earth] = "ui_js_chuanqi_icon",
    [elementType.God] = "ui_js_chuanqi_icon",
    [elementType.ui_js_multi16] = "ui_js_multi16",
    [elementType.ui_js_multi26] = "ui_js_multi26",
    [elementType.ui_js_multi36] = "ui_js_multi36",
    [elementType.ui_js_multi46] = "ui_js_multi46"
}
function ArenaPeakEmbattleTitle:__init(obj)
    self.transform = obj
    self.go_table = _G.GetAutoGoTable(obj)
end

function ArenaPeakEmbattleTitle:Dispose()
    self.transform = nil
    self.go_table = nil
end

---

---展示信息
---@param sid number 卡牌SID
---@param lv number 卡牌等级
---@param isEnemy boolean 是否是敌人
function ArenaPeakEmbattleTitle:Show(sid, lv, uid, cardData, isEnemy)
    if sid > 0 then
        self.transform:SetActiveE(1)
        self.go_table.aortext_level.text = lv
        local cfg = require "CardCommentManager":GetInstance():CardData(sid, false)

        if cfg then
            self.go_table.aorimage_element.SpriteName = elementImageName[require "CardInfoManager":GetInstance():GetElementsKey(cfg.Elements_new)]

            --- 有uid且没有附加神器参数的 走正常己方阵容判断
            if not isEnemy then
                local caradata = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
                for i = 1, 3 do
                    if self.go_table["aorimage_bg" .. i] then
                        self.go_table["aorimage_bg" .. i]:SetActiveE(0)
                    end
                end
                if caradata == nil then
                    caradata = cardData
                end
                if caradata and not _G.table.isEmptyOrNil(caradata.ArtifactBar) then
                    if self.ArtifactItem == nil then
                        ---@param item ItemArtifactEmbattle
                        _G.ItemFactory:GetInstance():GetItemCard(
                                _G.ItemFactory.itemType.ItemArtifactEmbattle,
                                self.go_table.obj_artifactRoot,
                                function(item)
                                    if self.go_table == nil or item == nil then
                                        return
                                    end
                                    item.go_table.aorbtn_Click:SetActiveE(0)
                                    item.gameObject:SetLocalScaleXYZ(0.5)
                                    self.ArtifactItem = item
                                    self.ArtifactItem:ShowData(caradata.ArtifactBar)
                                    self.ArtifactItem:EmbattleShow()
                                end
                        )
                    else
                        self.ArtifactItem:ShowData(caradata.ArtifactBar)
                        self.ArtifactItem:EmbattleShow()
                    end

                    if self.go_table.obj_artifactRoot then
                        self.go_table.obj_artifactRoot:SetActiveE(1)
                    end
                    local artifactCfg = _G.ConfigManager.artifact_cfg[caradata.ArtifactBar.sid]
                    if artifactCfg.card_id == sid then
                        if self.go_table["aorimage_bg3"] then
                            self.go_table["aorimage_bg3"]:SetActiveE(1)
                        end
                    else
                        if self.go_table["aorimage_bg2"] then
                            self.go_table["aorimage_bg2"]:SetActiveE(1)
                        end
                    end
                else
                    if self.go_table.obj_artifactRoot then
                        self.go_table.obj_artifactRoot:SetActiveE(0)
                    end
                    if self.go_table["aorimage_bg1"] then
                        self.go_table["aorimage_bg1"]:SetActiveE(1)
                    end
                end
            else
                if cardData and cardData.artifact and cardData.artifact.sid then
                    local artifactData = _G.ArtifactData.New()
                    artifactData:ParseInitMsg({
                        sid = cardData.artifact.sid,
                        star = cardData.artifact.star,
                        level = cardData.artifact.level
                    })

                    if self.ArtifactItem == nil then
                        ---@param item ItemArtifactEmbattle
                        _G.ItemFactory:GetInstance():GetItemCard(
                                _G.ItemFactory.itemType.ItemArtifactEmbattle,
                                self.go_table.obj_artifactRoot,
                                function(item)
                                    if self.go_table == nil or item == nil then
                                        return
                                    end
                                    item.go_table.aorbtn_Click:SetActiveE(0)
                                    item.gameObject:SetLocalScaleXYZ(0.5)
                                    self.ArtifactItem = item
                                    self.ArtifactItem:ShowData(artifactData)
                                    self.ArtifactItem:EmbattleShow()
                                end
                        )
                    else
                        self.ArtifactItem:ShowData(artifactData)
                        self.ArtifactItem:EmbattleShow()
                    end

                    if self.go_table.obj_artifactRoot then
                        self.go_table.obj_artifactRoot:SetActiveE(1)
                    end
                    local artifactCfg = _G.ConfigManager.artifact_cfg[cardData.artifact.sid]
                    if artifactCfg.card_id == sid then
                        if self.go_table["aorimage_bg3"] then
                            self.go_table["aorimage_bg3"]:SetActiveE(1)
                        end
                    else
                        if self.go_table["aorimage_bg2"] then
                            self.go_table["aorimage_bg2"]:SetActiveE(1)
                        end
                    end
                else
                    if self.go_table.obj_artifactRoot then
                        self.go_table.obj_artifactRoot:SetActiveE(0)
                    end
                end
            end
        end
    else
        self.transform:SetActiveE(0)
    end
end

---设置魂链和天赋
---@param soulLinkLv number 魂链等级，如果为-1则未激活
---@param talents number|table 天赋（大天赋数量或者天赋列表）
function ArenaPeakEmbattleTitle:SetSoulLinkAndTalent(soulLinkLv, talents)
    self.go_table.obj_soulAndTalent:SetActiveE(1)
    require("CardInfoManager"):GetInstance():SetSoulLinkAndTalent(self.go_table, soulLinkLv, talents)
end

---展示boss标签
---@param show boolean 是否展示
function ArenaPeakEmbattleTitle:ShowBossTag(show)
    if not self.go_table.obj_boss then
        return
    end
    self.go_table.obj_boss:SetActiveE(show and 1 or 0)
end

return ArenaPeakEmbattleTitle
