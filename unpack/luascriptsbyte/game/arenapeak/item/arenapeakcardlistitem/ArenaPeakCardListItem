local ArenaPeakModel = require("ArenaPeakModel"):GetInstance()

---@class ArenaPeakCardListItem    中文描述
---@field public go_table ArenaPeakBPView._obj_cardItem_GoTable
local ArenaPeakCardListItem = _G.BaseClass("ArenaPeakCardListItem", _G.Component)

local CS = _G.CS
local typeof = _G.typeof

---类的构造函数
---@field data ArenaPeakData
function ArenaPeakCardListItem:__init(obj, callback)
    self.callback = callback
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end

function ArenaPeakCardListItem:Show(index, card, type)
    self.index = index
    self.type = type
    ---@type ItemCardAllView
    local cardItem = require("ItemCardAllView").New(self.go_table.obj_card)

    cardItem:ShowCardData(card, nil, true, true)
    cardItem:ShowLevel(300)
    self.go_table.aorimage_trial:SetActiveE(card.isSupport and 1 or 0)
    self:ShowMaskOrGou()
end

---@private
function ArenaPeakCardListItem:ShowMaskOrGou()
    self.go_table.aorimage_mask:SetActiveE(self.type ~= 2 and 1 or 0)
    self.go_table.aorimage_gou:SetActiveE(self.type == 1 and 1 or 0)
end

---@private
function ArenaPeakCardListItem:OnClickBtn(go)
    if self.callback then
        self.callback(self.index, self.type)
    end
end

---类的析构函数
function ArenaPeakCardListItem:Dispose()
end

return ArenaPeakCardListItem
