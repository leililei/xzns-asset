local base = require("BaseGameNet")

---@class ArenaPeakNet : BaseGameNet    通信协议
local ArenaPeakNet = _G.BaseClass("ArenaPeakNet", base)
---@return ArenaPeakNet ArenaPeakNet
function ArenaPeakNet:GetInstance()
    return base.GetInstance(self)
end

---获取信息
function ArenaPeakNet:GetInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_arena_peak_info
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

