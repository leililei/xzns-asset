local ArenaPeakModel = require("ArenaPeakModel")
local ArenaPeakNet = require("ArenaPeakNet")

---@class ArenaPeakDuelView : UIBaseView    中文描述
---@field public go_table ArenaPeakDuelView_GoTable GoTable
---@field duelInfo arena_peak.s2c_arena_peak_sparring_info
---@field noticeInfo arena_peak.s2c_arena_peak_sparring_notify
local ArenaPeakDuelView = _G.BaseClass("ArenaPeakDuelView", _G.UIBaseView)

local GetLangPackValue = _G.GetLangPackValue
local ConfigManager = _G.ConfigManager
local UIManager = _G.UIManager:GetInstance()
local GetAutoGoTable = _G.GetAutoGoTable
local SetActiveByCondition = _G.GameUtil.SetActiveByCondition
local TimeUtil = _G.TimeUtil
local UIUtils = _G.UIUtils

function ArenaPeakDuelView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArenaPeakDuelView:OnCreate(id)
    self:ShowPage(id or 1)
    self.duelInit = false
    self.noticeInit = false
    ---@type _obj_List._obj_awardItem_GoTable[]
    self.duelList = {}
    ---@type _obj_List._obj_awardItem_GoTable[]
    self.noticeList = {}
    self.duelingID = {}
    self.duelTimeOut = _G.ConfigManager.discrete_cfg[108105][1][2]
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.arena_peak_sparring.Cmd, self.OnSparring, self)
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.arena_peak_request_sparring.Cmd, self.OnRequestSparring, self)
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()
end

---@private
function ArenaPeakDuelView:ShowPage(id)
    self.curPage = id
    self.go_table.obj_choose1:SetActiveE(id == 1 and 1 or 0)
    self.go_table.obj_choose2:SetActiveE(id == 2 and 1 or 0)
    self.go_table.obj_List:SetActiveE(id == 1 and 1 or 0 )
    self.go_table.obj_Notice:SetActiveE(id == 2 and 1 or 0 )
    if id == 1 then
        ArenaPeakNet:GetInstance():GetSparringList(_G.handler(self, self.InitDuelView))
    elseif id == 2 then
        ArenaPeakNet:GetInstance():GetSparringNotice(_G.handler(self, self.InitNoticeView))
    end
end

---@private
function ArenaPeakDuelView:InitDuelView(msg)
    self.duelingID = {}
    self.duelInfo = msg
    if not self.duelInfo.info then
        self.duelInfo.info = {}
    end
    ---@type ArenaPeakDuelView._obj_List_GoTable
    local tb = GetAutoGoTable(self.go_table.obj_List)
    tb.obj_empty:SetActiveE(#self.duelInfo.info == 0 and 1 or 0)
    if not self.duelInit then
        tb.scrollloopvectical_list:InitItemData(0, _G.handler(self, self.RefreshDuelItem))
        self.duelInit = true
    end
    if self.duelInfo.request_role_uid then
        for i = 1, #self.duelInfo.request_role_uid do
            self.duelingID[self.duelInfo.request_role_uid[i].role_uid] = self.duelInfo.request_role_uid[i].time
        end
    end
    tb.scrollloopvectical_list:UpdateCount(#self.duelInfo.info)
end

---@private
function ArenaPeakDuelView:InitNoticeView(msg)
    self.noticeInfo = msg.sparring_notify_list or {}
    ---@type ArenaPeakDuelView._obj_Notice_GoTable
    local tb = GetAutoGoTable(self.go_table.obj_Notice)
    tb.obj_empty:SetActiveE(#self.noticeInfo == 0 and 1 or 0)
    if not self.noticeInit then
        tb.scrollloopvectical_list:InitItemData(0, _G.handler(self, self.RefreshNoticeItem))
        self.noticeInit = true
    end
    tb.scrollloopvectical_list:UpdateCount(#self.noticeInfo)
end

---@private
function ArenaPeakDuelView:RefreshDuelItem(index, obj)
    index = index +1
    local id = obj:GetInstanceIDE()
    local uid = self.duelInfo.info[index].role_info.uid
    ---@type _obj_List._obj_awardItem_GoTable
	local tb = GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickDuelItem, id, uid))
    tb.uid = uid
    self.duelList[uid] = tb
    local info = self.duelInfo.info[index]
    tb.aortext_score.text = info.score
    tb.aortext_name.text = info.role_info.name
    local isReq = self:CheckUidIsRequesting(info.role_info.uid)
    tb.aorbtn_duel:SetActiveE(isReq and 0 or 1)
    tb.obj_wait:SetActiveE(isReq and 1 or 0)
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, info.role_info, 1, true, true, true)
    ArenaPeakModel:GetInstance():ShowDan(tb.obj_dan, info.score, false, info.is_king > 0)
end

---@private
function ArenaPeakDuelView:RefreshNoticeItem(index, obj)
    index = index + 1
    local id = obj:GetInstanceIDE()
    ---@type _obj_List._obj_awardItem_GoTable
    local tb = GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickNoticeItem, id, index))
    self.noticeList[id] = tb
    local info = self.noticeInfo[index]
    tb.aortext_score.text = info.score
    tb.aortext_name.text = info.role_info.name
    local time = _G.TimeUtil.GetServerUnixTime() - info.time
    if time < 60 then
        tb.aortext_time.text = ""
    else
        tb.aortext_time.text = GetLangPackValue(90022100083 ,_G.TimeUtil.TranslateSecond(time).min)
    end
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, info.role_info, 1, true, true, true)
    ArenaPeakModel:GetInstance():ShowDan(tb.obj_dan, info.score, false, info.is_king > 0)
end

---@private
function ArenaPeakDuelView:OnClickDuelItem(go, isOn, id, uid)
    local name = go:GetName()
    --local uid = self.duelInfo.info[index].role_info.uid
    if name == "@_aorbtn_chat" then
        require("ChatManager"):GetInstance():Zjsl_OpenView(uid)
    elseif name == "@_aorbtn_duel" then
        self.duelList[uid].aorbtn_duel:SetActiveE(0)
        self.duelList[uid].obj_wait:SetActiveE(1)
        local pbData = {role_uid = uid}
        ArenaPeakNet:GetInstance():RequestSparring(pbData, function(msg)
            if msg.ack == 1 then
                --self:AddIsRequesting(uid)
                self.duelingID[uid] = _G.TimeUtil.GetServerUnixTime()
            else
                self.duelList[uid].aorbtn_duel:SetActiveE(1)
                self.duelList[uid].obj_wait:SetActiveE(0)
            end
        end)
    end
end

---@private
function ArenaPeakDuelView:OnClickNoticeItem(go, isOn, id, index)
    local name = go:GetName()
    local uid = self.noticeInfo[index].role_info.uid
    if name == "@_aorbtn_sure" then
        local pbData = {role_uid = uid, type = 1}
        ArenaPeakNet:GetInstance():AnswerSparring(pbData, function(msg)
            if msg.is_ok == 1 then
                self:EnterRoom()
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(880109)
                self.noticeInfo[index] = nil
                self.noticeInfo = _G.table.toArray(self.noticeInfo)
                local tb = GetAutoGoTable(self.go_table.obj_Notice)
                tb.obj_empty:SetActiveE(#self.noticeInfo == 0 and 1 or 0)
                tb.scrollloopvectical_list:UpdateCount(#self.noticeInfo)
                --self:ShowPage(2)
            end
        end)
    elseif name == "@_aorbtn_cancle" then
        local pbData = {role_uid = uid, type = 0}
        ArenaPeakNet:GetInstance():AnswerSparring(pbData, function()
            self.noticeInfo[index] = nil
            self.noticeInfo = _G.table.toArray(self.noticeInfo)
            local tb = GetAutoGoTable(self.go_table.obj_Notice)
            tb.scrollloopvectical_list:UpdateCount(#self.noticeInfo)
        end)
    end
end

---@private
function ArenaPeakDuelView:CheckUidIsRequesting(uid)
    for k, v in pairs(self.duelingID) do
        if k == uid then
            return true
        end
    end
    return false
end

---@private
function ArenaPeakDuelView:OnSparring(msg)
    if msg.type == 1 then --同意
        self:EnterRoom()
    else
        for _, v in pairs(self.duelList) do
            if v.uid == msg.role_uid then
                v.aorbtn_duel:SetActiveE(1)
                v.obj_wait:SetActiveE(0)
            end
        end
    end
end

function ArenaPeakDuelView:OnRequestSparring(msg)
    if self.curPage == 2 then
        ArenaPeakNet:GetInstance():GetSparringNotice(_G.handler(self, self.InitNoticeView))
    end
end

---@private
function ArenaPeakDuelView:EnterRoom()
    ArenaPeakNet:GetInstance():GetRoomInfo(function(info)
        if info.ack == 1 then
            UIManager:OpenWindow(ConfigManager.ui_cfg.ArenaPeakMateView.Name, info.room_info)
            self:Close()
        end
    end)
end

---@private
function ArenaPeakDuelView:UpdateTime()
    local now = _G.TimeUtil.GetServerUnixTime()
    for uid, v in pairs(self.duelingID) do
        if now - v > self.duelTimeOut then
            self.duelList[uid].aorbtn_duel:SetActiveE(1)
            self.duelList[uid].obj_wait:SetActiveE(0)
            self.duelingID[uid] = nil
            _G.PopWindowManager:GetInstance():ShowAllTips(880110)
        end
    end
end

---界面的销毁函数
function ArenaPeakDuelView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    ArenaPeakNet:GetInstance():ExitSparring()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.arena_peak_sparring.Cmd, self.OnSparring, self)
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.arena_peak_request_sparring.Cmd, self.OnRequestSparring, self)
end

---按钮点击事件在这里派发
function ArenaPeakDuelView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_bg then
        self:Close()
    elseif go == self.go_table.aorbtn_rank then
        self:ShowPage(1)
    elseif go == self.go_table.aorbtn_award then
        self:ShowPage(2)
    end
end

return ArenaPeakDuelView