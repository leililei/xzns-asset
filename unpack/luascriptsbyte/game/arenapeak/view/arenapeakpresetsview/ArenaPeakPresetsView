local ArenaPeakModel = require("ArenaPeakModel")

---@class ArenaPeakPresetsView : UIBaseView	巅峰演武预设界面
---@field public go_table ArenaPeakPresetsView_GoTable GoTable
---@field public chooseTb ArenaPeakPresetsView._obj_Choose_GoTable GoTable
---@field public banTb ArenaPeakPresetsView._obj_Ban_GoTable GoTable
---@field public combineTb ArenaPeakPresetsView._obj_Combine_GoTable GoTable
local ArenaPeakPresetsView = _G.BaseClass("ArenaPeakPresetsView", _G.UIBaseView)

function ArenaPeakPresetsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

local elementType = _G.CardElementType
local profType = _G.CardProfType
local equipmentType = _G.EquipmentProfessional

local PriorityBg = {
    "ui_dfyw_ys_1_btn",
    "ui_dfyw_ys_2_btn",
    "ui_dfyw_ys_3_btn",
    "ui_dfyw_ys_ty_btn"
}

local RankBgName = {
    "tz_qjhs_di_02",
    "tz_qjhs_di_03",
    "tz_qjhs_di_04"
}

local RankIconName = {
    "tz_qjhs_phb_mingci_01",
    "tz_qjhs_phb_mingci_02",
    "tz_qjhs_phb_mingci_03"
}
local Keys = {
    PreChoose = "ArenaPeakPresetsChoose",
    PreBan = "ArenaPeakPresetsBan",
    PreCombine = "ArenaPeakPresetsCombine"
}

local widthScale = _G.AppSetting.CONFIG_SCREEN_HEIGHT / _G.AppSetting.SCREEN_HEIGHT * _G.AppSetting.SCREEN_WIDTH

---界面的入口函数
function ArenaPeakPresetsView:OnCreate()
    self:InitToggle()
    self:InitData()
    self.go_table.toggle_choose.isOn = true
end

function ArenaPeakPresetsView:InitData()
    self.preChoose = _G.PlayerPrefsManager.GetTable(Keys.PreChoose)
    if not self.preChoose then
        self.preChoose = {}
        for i = 1, 12 do
            self.preChoose[i] = 0
        end
    end
    self.preBan = _G.PlayerPrefsManager.GetTable(Keys.PreBan)
    if not self.preBan then
        self.preBan = {}
        for i = 1, 5 do
            self.preBan[i] = 0
        end
    end
    self.preCombine = _G.PlayerPrefsManager.GetTable(Keys.PreCombine)
    if not self.preCombine then
        self.preCombine = {0, 0, 0}
    end
end

function ArenaPeakPresetsView:InitToggle()
    self.toggles = {}
    self.toggles["choose"] =
        _G.GetAutoGoTable(
        self.go_table.toggle_choose,
        _G.handlerbind(self, self.OnToggle, "choose", _G.handler(self, self.OnChoose))
    )
    self.toggles["ban"] =
        _G.GetAutoGoTable(
        self.go_table.toggle_ban,
        _G.handlerbind(self, self.OnToggle, "ban", _G.handler(self, self.OnBan))
    )
    self.toggles["combine"] =
        _G.GetAutoGoTable(
        self.go_table.toggle_combine,
        _G.handlerbind(self, self.OnToggle, "combine", _G.handler(self, self.OnCombine))
    )
end

---点击Togggle
function ArenaPeakPresetsView:OnToggle(go, isOn, key, call)
    local tb = self.toggles[key]
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    if call then
        call(isOn)
    end
end

function ArenaPeakPresetsView:OnChoose(isOn)
    self.go_table.obj_Choose:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    self.curPage = 1
    if self.chooseTb == nil then
        self.chooseTb = _G.GetAutoGoTable(self.go_table.obj_Choose, _G.handler(self, self.OnClickChoose))

        self.embattle =
            require("EmbattleItemArenaPeak").New(_G.EmbattleType.ArenaPeak, _G.EmbattleSaveType.temporary, true)
        self.cards = self.embattle:GetCardList()
        _G.table.sort(self.cards, _G.handler(self, self.SortCardList))

        self.chooseItems = {}
        local obj, tb
        for i = 1, 12 do
            obj = _G.InstantiateObject(self.chooseTb.obj_presetItem, self.chooseTb.obj_presets)
            obj:SetActiveE(1)
            tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickChooseItem, i))
            if i > 3 then
                tb.aorimage_bottomBg.SpriteName = PriorityBg[4]
                tb.aortext_rank.text = i
                tb.aorimage_rank:SetActiveE(0)
            else
                tb.aorimage_bottomBg.SpriteName = PriorityBg[i]
                tb.aorimage_rank.SpriteName = RankIconName[i]
                tb.aortext_rank:SetActiveE(0)
            end
            if self.preChoose[i] > 0 then
                local card = self:GetEmbattleCardData(self.preChoose[i])
                if card == nil then
                    self.preChoose[i] = 0
                else
                    self:ShowPresetsCard(tb, card)
                end
            end

            _G.SetEventTrigger(tb.aorbtn_choose, "onDragBegin", _G.handlerbind(self, self.OnDragBegin, i))
            _G.SetEventTrigger(tb.aorbtn_choose, "onDrag", _G.handlerbind(self, self.OnDrag, tb.obj_card))
            _G.SetEventTrigger(tb.aorbtn_choose, "onDragEnd", _G.handlerbind(self, self.OnDragEnd, i))
            self.chooseItems[i] = tb
        end

        self.curCards = self.cards
        self.chooseTb.scrollloopvectical_card:InitItemData(#self.curCards, _G.handler(self, self.RefreshChooseCardItem))

        self.curCElement = elementType.None
        self.curCEquipment = 0
        self.curCProf = profType.None
        self.elementCBtns = {
            self.chooseTb.aorbtn_all,
            self.chooseTb.aorbtn_lei,
            self.chooseTb.aorbtn_feng,
            self.chooseTb.aorbtn_shui,
            self.chooseTb.aorbtn_huo,
            self.chooseTb.aorbtn_tu,
            self.chooseTb.aorbtn_shen
        }
        self.profCBtns = {
            self.chooseTb.aorbtn_pAll,
            self.chooseTb.aorbtn_pTK, --1
            self.chooseTb.aorbtn_pZS, --2
            self.chooseTb.aorbtn_pFS, --3
            self.chooseTb.aorbtn_pFZ, --4
            self.chooseTb.aorbtn_pYX --5
        }
        self.equipmentCBtns = {
            self.chooseTb.aorbtn_eAll,
            self.chooseTb.aorbtn_eLiliang,
            self.chooseTb.aorbtn_eMinjie,
            self.chooseTb.aorbtn_eZhili
        }

        self:GetStatisticsData(
            function()
                if self:IsNil() then
                    return
                end
                self:SortCardInfoByWinRate()
                self.chooseTb.scrollloopvectical_rank:InitItemData(
                    #self.cardInfo,
                    _G.handler(self, self.RefreshChooseRankItem)
                )
            end
        )
    else
        self:GetStatisticsData(
            function()
                if self:IsNil() then
                    return
                end
                self:SortCardInfoByWinRate(self.winReverse)
            end
        )
    end
end

function ArenaPeakPresetsView:OnBan(isOn)
    self.go_table.obj_Ban:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    self.curPage = 2
    if self.banTb == nil then
        self.banTb = _G.GetAutoGoTable(self.go_table.obj_Ban, _G.handler(self, self.OnClickBan))
        local card_cfg = _G.ConfigManager.card_cfg
        self.banItems = {}
        local obj, tb
        for i = 1, 5 do
            obj = _G.InstantiateObject(self.banTb.obj_presetItem, self.banTb.obj_presets)
            obj:SetActiveE(1)
            tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickBanItem, i))
            if i > 3 then
                tb.aorimage_bottomBg.SpriteName = PriorityBg[4]
                tb.aortext_rank.text = i
                tb.aorimage_rank:SetActiveE(0)
            else
                tb.aorimage_bottomBg.SpriteName = PriorityBg[i]
                tb.aorimage_rank.SpriteName = RankIconName[i]
                tb.aortext_rank:SetActiveE(0)
            end
            if self.preBan[i] > 0 then
                self:ShowPresetsCard(tb, card_cfg[self.preBan[i]])
            end

            _G.SetEventTrigger(tb.aorbtn_choose, "onDragBegin", _G.handlerbind(self, self.OnDragBegin, i))
            _G.SetEventTrigger(tb.aorbtn_choose, "onDrag", _G.handlerbind(self, self.OnDrag, tb.obj_card))
            _G.SetEventTrigger(tb.aorbtn_choose, "onDragEnd", _G.handlerbind(self, self.OnDragEnd, i))
            self.banItems[i] = tb
        end
        self.ills = {}
        ---@type card_cfg
        local cfg
        for k, v in pairs(_G.ConfigManager.illustrations_card_cfg) do
            cfg = card_cfg[k]
            if cfg.Order >= 3 then
                _G.table.insert(self.ills, cfg)
            end
        end
        _G.table.sort(self.ills, _G.handler(self, self.SortCardIllList))
        self.curIlls = self.ills
        self.banTb.scrollloopvectical_card:InitItemData(#self.curIlls, _G.handler(self, self.RefreshBanCardItem))

        self.curBElement = elementType.None
        self.curBEquipment = 0
        self.curBProf = profType.None

        self.elementBBtns = {
            self.banTb.aorbtn_all,
            self.banTb.aorbtn_lei,
            self.banTb.aorbtn_feng,
            self.banTb.aorbtn_shui,
            self.banTb.aorbtn_huo,
            self.banTb.aorbtn_tu,
            self.banTb.aorbtn_shen
        }
        self.profBBtns = {
            self.banTb.aorbtn_pAll,
            self.banTb.aorbtn_pTK, --1
            self.banTb.aorbtn_pZS, --2
            self.banTb.aorbtn_pFS, --3
            self.banTb.aorbtn_pFZ, --4
            self.banTb.aorbtn_pYX --5
        }
        self.equipmentBBtns = {
            self.banTb.aorbtn_eAll,
            self.banTb.aorbtn_eLiliang,
            self.banTb.aorbtn_eMinjie,
            self.banTb.aorbtn_eZhili
        }

        self:GetStatisticsData(
            function()
                if self:IsNil() then
                    return
                end
                self:SortCardInfoByBanRate()
                self.banTb.scrollloopvectical_rank:InitItemData(
                    #self.cardInfo,
                    _G.handler(self, self.RefreshBanRankItem)
                )
            end
        )
    else
        self:GetStatisticsData(
            function()
                if self:IsNil() then
                    return
                end
                self:SortCardInfoByBanRate(self.banReverse)
            end
        )
    end
end

function ArenaPeakPresetsView:OnCombine(isOn)
    self.go_table.obj_Combine:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    self.curPage = 3
    if self.combineTb == nil then
        self.combineTb = _G.GetAutoGoTable(self.go_table.obj_Combine, _G.handler(self, self.OnClickCombine))
        self.combineTb.scrollloopvectical_combine:InitItemData(0, _G.handler(self, self.RefreshCombineItem))

        self.combineToggles = {
            _G.GetAutoGoTable(self.combineTb.toggle_type1),
            _G.GetAutoGoTable(self.combineTb.toggle_type2),
            _G.GetAutoGoTable(self.combineTb.toggle_type3)
        }

        self.combineItems = {
            _G.GetAutoGoTable(self.combineTb.obj_combine1, _G.handlerbind(self, self.OnClickCurCombineItem, 1)),
            _G.GetAutoGoTable(self.combineTb.obj_combine2, _G.handlerbind(self, self.OnClickCurCombineItem, 2)),
            _G.GetAutoGoTable(self.combineTb.obj_combine3, _G.handlerbind(self, self.OnClickCurCombineItem, 3))
        }

        for i = 1, 3 do
            self:ShowSingleCombine(self.combineItems[i], self.preCombine[i])
        end

        local allCombineDatas = require("CombineModel"):GetInstance().CombineDatas
        self.combineDatas = {}
        for k, v in pairs(allCombineDatas) do
            if k ~= 0 then
                self.combineDatas[k] =
                    _G.table.chooseToArray(
                    v,
                    function(_, data)
                        return data.isActive
                    end
                )
            end
        end

        self.combineTb.toggle_type1.isOn = true
        self:ShowCombineDetail(self.combineDatas[self.curCombineType][1])
    end
end

function ArenaPeakPresetsView:OnDragBegin(go, ed, index)
    if self.curPage == 1 then
        if self.preChoose[index] == 0 then
            return
        end
        self.isDrag = true
        self.chooseItems[index].obj_card:SetParentE(self.chooseTb.trans_drag, 1)
    else
        if self.preBan[index] == 0 then
            return
        end
        self.isDrag = true
        self.banItems[index].obj_card:SetParentE(self.banTb.trans_drag, 1)
    end
end

function ArenaPeakPresetsView:OnDrag(go, ed, card)
    if self.isDrag then
        card:AddLocalPosition(
            ed.delta.x / _G.AppSetting.SCREEN_WIDTH * widthScale,
            ed.delta.y / _G.AppSetting.SCREEN_HEIGHT * _G.AppSetting.CONFIG_SCREEN_HEIGHT,
            0
        )
    end
end

function ArenaPeakPresetsView:OnDragEnd(go, ed, index)
    if not self.isDrag then
        return
    end
    self.isDrag = false
    local overlap
    if self.curPage == 1 then
        for i = 1, #self.chooseItems do
            if i ~= index then
                overlap =
                    _G.CS.UIUtils.ChecklocalPositionInRect(
                    self.chooseItems[index].obj_card,
                    self.chooseItems[i].gameObject,
                    false
                )
                if overlap then
                    local uid = self.preChoose[index]
                    self.preChoose[index] = self.preChoose[i]
                    self.preChoose[i] = uid
                    local data
                    if self.preChoose[index] > 0 then
                        data = self:GetEmbattleCardData(self.preChoose[index])
                    end
                    self:ShowPresetsCard(self.chooseItems[index], data)
                    data = nil
                    if self.preChoose[i] > 0 then
                        data = self:GetEmbattleCardData(self.preChoose[i])
                    end
                    self:ShowPresetsCard(self.chooseItems[i], data)
                    break
                end
            end
        end
        self.chooseItems[index].obj_card:SetLocalPositionToZero()
        self.chooseItems[index].obj_card:SetParentE(self.chooseItems[index].obj_cardNode)
    else
        for i = 1, #self.banItems do
            if i ~= index then
                overlap =
                    _G.CS.UIUtils.ChecklocalPositionInRect(
                    self.banItems[index].obj_card,
                    self.banItems[i].gameObject,
                    false
                )
                if overlap then
                    local uid = self.preBan[index]
                    self.preBan[index] = self.preBan[i]
                    self.preBan[i] = uid
                    local data
                    if self.preBan[index] > 0 then
                        data = _G.ConfigManager.card_cfg[self.preBan[index]]
                    end
                    self:ShowPresetsCard(self.banItems[index], data)
                    data = nil
                    if self.preBan[i] > 0 then
                        data = _G.ConfigManager.card_cfg[self.preBan[i]]
                    end
                    self:ShowPresetsCard(self.banItems[i], data)
                    break
                end
            end
        end
        self.banItems[index].obj_card:SetLocalPositionToZero()
        self.banItems[index].obj_card:SetParentE(self.banItems[index].obj_cardNode)
    end
end

function ArenaPeakPresetsView:GetEmbattleCardData(uid)
    for _, v in pairs(self.cards) do
        if v.uid == uid then
            return v
        end
    end
end

function ArenaPeakPresetsView:GetStatisticsData(call)
    if self.cardInfo then
        if call then
            call()
        end
    else
        local pbData = {season_id = ArenaPeakModel:GetInstance():GetCurSeasonID(), duan_id = 0}
        require "ArenaPeakNet":GetInstance():GetCardUseRate(
            pbData,
            function(msg)
                self.cardInfo = msg.card_info or {}
                if call then
                    call()
                end
            end
        )
    end
end

function ArenaPeakPresetsView:SortCardInfoByWinRate(reverse)
    self.winReverse = reverse
    if reverse then
        _G.table.sort(
            self.cardInfo,
            function(a, b)
                if a.win_rate ~= b.win_rate then
                    return a.win_rate < b.win_rate
                end
                return a.card_sid < b.card_sid
            end
        )
    else
        _G.table.sort(
            self.cardInfo,
            function(a, b)
                if a.win_rate ~= b.win_rate then
                    return a.win_rate > b.win_rate
                end
                return a.card_sid < b.card_sid
            end
        )
    end
end

function ArenaPeakPresetsView:SortCardInfoByBanRate(reverse)
    self.banReverse = reverse
    if reverse then
        _G.table.sort(
            self.cardInfo,
            function(a, b)
                if a.ban_rate ~= b.ban_rate then
                    return a.ban_rate < b.ban_rate
                end
                return a.card_sid < b.card_sid
            end
        )
    else
        _G.table.sort(
            self.cardInfo,
            function(a, b)
                if a.ban_rate ~= b.ban_rate then
                    return a.ban_rate > b.ban_rate
                end
                return a.card_sid < b.card_sid
            end
        )
    end
end

--region ------------- 筛选 -------------

function ArenaPeakPresetsView:SortCardList(a, b)
    local power1 = a:GetPower()
    local power2 = b:GetPower()
    if power1 == power2 then
        if a:GetStar() == b:GetStar() then
            if a.sid == b.sid then
                return _G.table.ContainsValue(self.preChoose, a.uid)
            else
                return a.sid > b.sid
            end
        else
            return a:GetStar() > b:GetStar()
        end
    else
        return power1 > power2
    end
end

function ArenaPeakPresetsView:SortCardIllList(a, b)
    return _G.ConfigManager.illustrations_card_cfg[a.id].display_priority <
        _G.ConfigManager.illustrations_card_cfg[b.id].display_priority
end

function ArenaPeakPresetsView:ChangeListType(t)
    if self.curPage == 1 then
        if t ~= self.curCElement then
            self.curCElement = t
            self.chooseTb.trans_choose:SetPositionByTarget(self.elementCBtns[t + 1])
            self:UpdateCardList()
        end
    else
        if t ~= self.curBElement then
            self.curBElement = t
            self.banTb.trans_choose:SetPositionByTarget(self.elementBBtns[t + 1])
            self:UpdateCardIllList()
        end
    end
end
function ArenaPeakPresetsView:ChangeProfListType(t)
    if self.curPage == 1 then
        if t ~= self.curCProf then
            self.curCProf = t
            self.chooseTb.trans_pChoose:SetPositionByTarget(self.profCBtns[t + 1])
            self:UpdateCardList()
        elseif self.curCProf ~= profType.None then
            self.curCProf = profType.None
            self.chooseTb.trans_pChoose:SetPositionByTarget(self.profCBtns[profType.None + 1])
            self:UpdateCardList()
        end
    else
        if t ~= self.curBProf then
            self.curBProf = t
            self.banTb.trans_pChoose:SetPositionByTarget(self.profBBtns[t + 1])
            self:UpdateCardIllList()
        elseif self.curBProf ~= profType.None then
            self.curBProf = profType.None
            self.banTb.trans_pChoose:SetPositionByTarget(self.profBBtns[profType.None + 1])
            self:UpdateCardIllList()
        end
    end
end
function ArenaPeakPresetsView:ChangeEquipmentListType(t)
    if self.curPage == 1 then
        if t ~= self.curCEquipment then
            self.curCEquipment = t
            self.chooseTb.trans_eChoose:SetPositionByTarget(self.equipmentCBtns[t + 1])
            self:UpdateCardList()
        elseif self.curCEquipment ~= 0 then
            self.curCEquipment = 0
            self.chooseTb.trans_eChoose:SetPositionByTarget(self.equipmentCBtns[1])
            self:UpdateCardList()
        end
    else
        if t ~= self.curBEquipment then
            self.curBEquipment = t
            self.banTb.trans_eChoose:SetPositionByTarget(self.equipmentBBtns[t + 1])
            self:UpdateCardIllList()
        elseif self.curBEquipment ~= 0 then
            self.curBEquipment = 0
            self.banTb.trans_eChoose:SetPositionByTarget(self.equipmentBBtns[1])
            self:UpdateCardIllList()
        end
    end
end

function ArenaPeakPresetsView:ShowTypeList(show)
    if self.curPage == 1 then
        self.showCTag = show
        self.chooseTb.obj_equipment:SetActiveE(show and 1 or 0)
        self.chooseTb.obj_prof:SetActiveE(show and 1 or 0)
        self.chooseTb.aorbtn_typeList:SetEulerAngles(0, 0, show and -90 or 90)
        self.chooseTb.aorbtn_typeList:SetAnchorPosition(0, show and 96 or 0)
    else
        self.showBTag = show
        self.banTb.obj_equipment:SetActiveE(show and 1 or 0)
        self.banTb.obj_prof:SetActiveE(show and 1 or 0)
        self.banTb.aorbtn_typeList:SetEulerAngles(0, 0, show and -90 or 90)
        self.banTb.aorbtn_typeList:SetAnchorPosition(0, show and 96 or 0)
    end
end

--endregion ----------- 筛选 end -----------

function ArenaPeakPresetsView:ShowPresetsCard(tb, card)
    tb.obj_card:SetActiveE(card ~= nil and 1 or 0)
    if card == nil then
        return
    end
    if self.curPage == 1 then
        if tb.card then
            if tb.card ~= true then
                tb.card:ShowCardData(card, nil, true, true)
            end
        else
            tb.card = true
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.CardAllItem,
                tb.obj_card,
                function(item)
                    tb.card = item
                    item:ShowCardData(card, nil, true, true)
                end
            )
        end
    else
        if tb.card then
            if tb.card ~= true then
                tb.card:Show(card.id, nil, 24, nil, 300)
            end
        else
            tb.card = true
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.CardAllItem,
                tb.obj_card,
                function(item)
                    tb.card = item
                    item:Show(card.id, nil, 24, nil, 300)
                end
            )
        end
    end
end

--region ------------- 预设选择 -------------

function ArenaPeakPresetsView:RefreshChooseCardItem(index, obj)
    index = index + 1
    local cardData = self.curCards[index]
    ---@type _obj_Choose._obj_cardItem_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickChooseCardItem, index, cardData))
    if tb.card then
        if tb.card ~= true then
            tb.card:ShowCardData(cardData, nil, true, true)
        end
    else
        tb.card = true
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.CardAllItem,
            tb.obj_card,
            function(item)
                tb.card = item
                item:ShowCardData(cardData, nil, true, true)
            end
        )
    end
    tb.aorimage_mask:SetActiveE(_G.table.ContainsValue(self.preChoose, cardData.uid) and 1 or 0)
end

function ArenaPeakPresetsView:UpdateCardList()
    self.curCards = {}
    for _, v in pairs(self.cards) do
        if v:GetElement() == self.curCElement or self.curCElement == elementType.None then
            if v.cfg.EquipmentType == self.curCEquipment or self.curCEquipment == 0 then
                if v.cfg.Professional == self.curCProf or self.curCProf == profType.None then
                    _G.table.insert(self.curCards, v)
                end
            end
        end
    end
