end

function ArenaPeakPresetsView:ShowCombineDetail(data)
    local tb = _G.GetAutoGoTable(self.combineTb.obj_curCombine)
    self:ShowSingleCombine(tb, data.id)
    tb.aortext_name.text = _G.GetLangPackValue(data.skillCfg.name1)
    self.combineTb.aortext_des.text = self:RemoveColor(_G.GetLangPackValue(data.desc))
    self:UpdateSkillDes(data)
end

function ArenaPeakPresetsView:UpdateSkillDes(data)
    local skillData = data.cfg.skills
    local count = #skillData
    if not self.skills then
        self.skills = {}
    end
    for _, v in pairs(self.skills) do
        v:SetActiveE(0)
    end
    if count <= 1 then
        return
    end
    local tb = {}
    local count2 = 1
    for i = 1, count do
        tb[skillData[i]] = skillData[i]
        if skillData[i] ~= skillData[1] and count2 == 1 then
            count2 = i
        end
    end

    tb = _G.table.toArray(tb)
    _G.table.sort(
        tb,
        function(a, b)
            return a < b
        end
    )
    local lv = _G.math.floor(data.level / count2) + 1
    local cfg, color
    local count3 = #tb
    for i = 2, count3 do
        if not self.skills[i] then
            local obj = _G.InstantiateObject(self.combineTb.aortext_stage, self.combineTb.obj_stageContent)
            self.skills[i] = obj:GetComponentE(_G.typeof(_G.CS.AorText))
        end
        self.skills[i]:SetActiveE(1)
        cfg = _G.ConfigManager.card_skills_cfg[tb[i]]
        color = i > lv and "808199" or "515268"
        -- self.skills[i].text = _G.GetLangPackValue(9002050018, i) .. _G.GetLangPackValue(cfg.describe1)
        if i > lv then
            self.skills[i].text =
                _G.string.AddColor(
                _G.GetLangPackValue(9002050018, cfg.level) ..
                    "：" .. self:RemoveColor(_G.GetLangPackValue(cfg.describe1)),
                color
            ) .. _G.string.AddColor("(" .. _G.GetLangPackValue(90020300082, (cfg.level - 1) * count2) .. ")", "b23929")
        else
            self.skills[i].text =
                _G.string.AddColor(
                _G.GetLangPackValue(9002050018, cfg.level) ..
                    "：" .. self:RemoveColor(_G.GetLangPackValue(cfg.describe1)),
                color
            )
        end
    end
    _G.GameUtil.ReBuildRTF(self.combineTb.obj_stageContent)
end

function ArenaPeakPresetsView:RemoveColor(str)
    local str1 = _G.string.gsub(str, "(<color=#(%w*)>)", "<color=#14874a>")
    return str1
end

