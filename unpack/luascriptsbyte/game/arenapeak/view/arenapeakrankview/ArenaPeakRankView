local ArenaPeakModel = require("ArenaPeakModel")
local RankView = require "ArenaPeakRank_RankView"
local RewardView = require "ArenaPeakRank_RewardView"
local HallView = require "ArenaPeakRank_HallView"

---@class ArenaPeakRankView : UIBaseView    中文描述
---@field public go_table ArenaPeakRankView_GoTable GoTable
---@field curModel number 当前模式(1排位赛2友谊赛)
local ArenaPeakRankView = _G.BaseClass("ArenaPeakRankView", _G.UIBaseView)

local GetAutoGoTable = _G.GetAutoGoTable

function ArenaPeakRankView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function ArenaPeakRankView:OnCreate()
    if ArenaPeakModel:GetInstance():GetCurSeasonID() <= 1 then
        self.go_table.toggle_rank.isOn = true
        self.go_table.toggle_hall:SetActiveE(0)
    else
        self.go_table.toggle_hall.isOn = true
    end
end

function ArenaPeakRankView:OnHall(isOn)
    self.go_table.obj_Hall:SetActiveE(isOn and 1 or 0)
    self:ChangeToggle(self.go_table.toggle_hall, isOn)
    if not isOn then
        return
    end
    if not self.HallView then
        self.HallView = self:AddComponent(self.go_table.obj_Hall, HallView.New())
        self.HallView:UpdateView()
    end
end
---点击排行
function ArenaPeakRankView:OnRank(isOn)
    self.go_table.obj_Rank:SetActiveE(isOn and 1 or 0)
    self:ChangeToggle(self.go_table.toggle_rank, isOn)
    if not isOn then
        return
    end
    if not self.RankView then
        self.RankView = self:AddComponent(self.go_table.obj_Rank, RankView.New())
        self.RankView:UpdateView()
    end
end
---点击奖励
function ArenaPeakRankView:OnReward(isOn)
    self.go_table.obj_Reward:SetActiveE(isOn and 1 or 0)
    self:ChangeToggle(self.go_table.toggle_reward, isOn)
    if not isOn then
        return
    end
    if not self.RewardView then
        self.RewardView = self:AddComponent(self.go_table.obj_Reward, RewardView.New())
        self.RewardView:UpdateView()
    end
end

function ArenaPeakRankView:ChangeToggle(toggle, isOn)
    local tb = GetAutoGoTable(toggle)
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
end

---按钮点击事件在这里派发
function ArenaPeakRankView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.toggle_hall then
        self:OnHall(isOn)
    elseif go == self.go_table.toggle_rank then
        self:OnRank(isOn)
    elseif go == self.go_table.toggle_reward then
        self:OnReward(isOn)
    end
end

return ArenaPeakRankView
