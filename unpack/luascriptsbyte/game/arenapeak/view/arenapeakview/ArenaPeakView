---@private
function ArenaPeakView:OnUIClosed(uiName)
    if uiName == ConfigManager.ui_cfg.ChatView.Name then
        self.go_table.obj_minChatView:SetActiveE(1)
    elseif uiName == ConfigManager.ui_cfg.ArenaPeakDuelView.Name then
        self.curModel = 1
        self:UpdateToggle()
    end
end

---@private
function ArenaPeakView:OnDisable()
    if self.isMatching and not self.isCanceling then
        self.isCanceling = true
        self:QuitMatch()
    end
end

---界面的销毁函数
function ArenaPeakView:OnDestroy()
    if self.isMatching and not self.isCanceling then
        self.isCanceling = true
        self:QuitMatch()
    end
    self:CloseOtherView()
    Events:GetInstance():RemoveListener(net_map.arena_peak_match_ok.Cmd, self.OnMatchOK, self)
    Events:GetInstance():RemoveListener(net_map.arena_peak_match_fail.Cmd, self.OnMatchFailed, self)
    Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
    Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.UpdateView, self)
    Events:GetInstance():RemoveListener(_G.eArenaPeak.AutoNext, self.AutoNext, self)
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.timerMatch then
        self.timerMatch:Stop()
        self.timerMatch = nil
    end
end

---按钮点击事件在这里派发
function ArenaPeakView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_fight then
        if self.curModel == 1 then
            if ArenaPeakModel:GetInstance():GetTodayLastTimes() <= 0 then
                _G.PopWindowManager:GetInstance():ShowAllTips(880105)
                return
            end
            local state, tipsID = ArenaPeakModel:GetInstance():CheckInOpenTime()
            if state ~= 0 then
                if tipsID then
                    _G.PopWindowManager:GetInstance():ShowAllTips(tipsID)
                end
                return
            end
            local isKing, inKingTime = ArenaPeakModel:GetInstance():CheckInKingOpenTime()
            if isKing and not inKingTime then
                _G.PopWindowManager:GetInstance():ShowAllTips(880124)
                return
            end
            if not self.isMatching then
                if self.go_table.toggle_hosting.isOn == true and self:CheckPresetPosEmpty() then
                    _G.PopWindowManager:GetInstance():ShowBtnWindowByToggle(
                        880128,
                        function()
                            UIManager:GetInstance():OpenWindow(ConfigManager.ui_cfg.ArenaPeakPresetsView.Name)
                        end,
                        _G.handler(self, self.StartMatch),
                        _G.handler(self, self.StartMatch)
                    )
                else
                    self:StartMatch()
                end
            else
                self:QuitMatch()
            end
        else
            UIManager:GetInstance():OpenWindow(ConfigManager.ui_cfg.ArenaPeakDuelView.Name)
        end
    elseif go == self.go_table.aorbtn_support then
        UIManager:GetInstance():OpenWindow(ConfigManager.ui_cfg.ArenaPeakSupView.Name)
    elseif go == self.go_table.aorbtn_rank then
        -- UIManager:GetInstance():OpenWindow(ConfigManager.ui_cfg.ArenaPeakRankView.Name)
        UIManager:GetInstance():OpenWindow(ConfigManager.ui_cfg.CommonRankView.Name, _G.CommonRankType.ArenaPeak)
    elseif go == self.go_table.aorbtn_shop then
        UIManager:GetInstance():OpenWindow(ConfigManager.ui_cfg.ShopView.Name, 7)
    elseif go == self.go_table.aorbtn_report then
        UIManager:GetInstance():OpenWindow(ConfigManager.ui_cfg.ArenaPeakReportView.Name)
    elseif go == self.go_table.aorbtn_task then
        UIManager:GetInstance():OpenWindow(ConfigManager.ui_cfg.ArenaPeakTaskView.Name)
    elseif go == self.go_table.aorbtn_close then
        self:Close()
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaPanelView.Name)
    elseif go == self.go_table.aorbtn_help then
        UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 72)
    elseif go == self.go_table.aorbtn_qualifying then
        if self.curModel ~= 1 then
            self.curModel = 1
            self:UpdateToggle()
        end
    elseif go == self.go_table.aorbtn_friendly then
        if self.curModel ~= 2 then
            self.curModel = 2
            self:UpdateToggle()
        end
        UIManager:GetInstance():OpenWindow(ConfigManager.ui_cfg.ArenaPeakDuelView.Name)
    elseif go == self.go_table.aorbtn_chatView then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_minChatView, false)
        UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ChatView.Name, _G.ChatType.world)
    elseif go == self.go_table.aorbtn_group then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenPeakGroupStatisticsView.Name)
    elseif go == self.go_table.aorbtn_medalHelp then
        self:ShowMedalHelp()
    elseif go == self.go_table.aorbtn_closeMedalTip then
        self:ShowMedalHelp()
    elseif go == self.go_table.aorbtn_presets then
        if HostingLimit > ArenaPeakModel:GetInstance():GetTotalNum() then
            _G.PopWindowManager:GetInstance():ShowAllTips(880123)
            return
        end
        UIManager:GetInstance():OpenWindow(ConfigManager.ui_cfg.ArenaPeakPresetsView.Name)
    elseif go == self.go_table.toggle_hosting then
        local noArray = true
        local preChoose = _G.PlayerPrefsManager.GetTable("ArenaPeakPresetsChoose")
        if preChoose then
            for _, v in pairs(preChoose) do
                if v > 0 then
                    noArray = false
                    break
                end
            end
        end
        if noArray then
            self.go_table.toggle_hosting.isOn = false
            _G.PopWindowManager:GetInstance():ShowAllTips(880125)
            return
        end
        -- 获取 代币的获得信息，判断是否达到上限
        if ArenaPeakModel:GetInstance():IsCoinLimit() and not ArenaPeakModel:GetInstance().isKing then
            self.go_table.toggle_hosting.isOn = false
            _G.PopWindowManager:GetInstance():ShowAllTips(880127)
            return
        end
        _G.PlayerPrefsManager.SetInt(HostingKey, isOn and 1 or 0)
    end
end

return ArenaPeakView
