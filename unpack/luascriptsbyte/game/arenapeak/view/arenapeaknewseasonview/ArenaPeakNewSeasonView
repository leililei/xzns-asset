---@class ArenaPeakNewSeasonView : UIBaseView    中文描述
---@field public go_table ArenaPeakNewSeasonView_GoTable GoTable
------@field curModel number 当前模式(1排位赛2友谊赛)
local ArenaPeakNewSeasonView = _G.BaseClass("ArenaPeakNewSeasonView", _G.UIBaseView)
local ArenaPeakModel = require("ArenaPeakModel")
local ConfigManager = _G.ConfigManager

function ArenaPeakNewSeasonView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArenaPeakNewSeasonView:OnCreate()
    self:SetRoleDate()
end

---获取赛季立绘数据
function ArenaPeakNewSeasonView:SetRoleDate()
    local seasonID = ArenaPeakModel:GetInstance():GetCurSeasonID()
    if seasonID == 0 then
        seasonID = 1
    end
    ---@type arena_peak_cfg
    local cfg = _G.ConfigManager.arena_peak_cfg[seasonID]
    --立绘路径
    self.go_table.aorrawimage_role:LoadImage(
        cfg.portrait,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            trans:SetNativeSize()
        end
    )

    --位置
    local x = cfg.shifting[1]
    local y = cfg.shifting[2]
    local z = cfg.shifting[3]
    self.go_table.aorrawimage_role:SetLocalPosition(x, y, z)

    --大小缩放
    local roleScale = cfg.scale / 10000
    self.go_table.aorrawimage_role:SetLocalScale(roleScale, roleScale, roleScale)

    local check = function(trans)
        if self:IsNil() then
            _G.DestroyObject(trans)
        end
    end
    local titleEff = cfg.eff_path[1]
    if titleEff then
        _G.UIUtils.LoadEffectByCfg(ConfigManager.ui_effect_cfg[titleEff], self.go_table.aorrawimage_title, check)
    end
    local roleEff = cfg.eff_path[2]
    if roleEff then
        _G.UIUtils.LoadEffectByCfg(ConfigManager.ui_effect_cfg[roleEff], self.go_table.obj_effRole, check)
    end

    local Tweening = _G.CS.DG.Tweening
    local x, y, z = self.go_table.obj_role:GetLocalPosition()
    self.tweer =
        self.go_table.obj_role:DOLocalMoveY(y + 20, 1.5):SetEase(Tweening.Ease.InOutSine):SetLoops(
        -1,
        Tweening.LoopType.Yoyo
    )
end

---@private
function ArenaPeakNewSeasonView:OnDisable()
end

---界面的销毁函数
function ArenaPeakNewSeasonView:OnDestroy()
end

---按钮点击事件在这里派发
function ArenaPeakNewSeasonView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeView then
        self:Close()
    elseif go == self.go_table.aorbtn_skip then
        _G.JumpManager:GetInstance():Jump(163001)
    end

    if self.go_table.toggle_eject.isOn then
        _G.PlayerPrefsManager.SetInt("ArenaPeakNewSeason", _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime()))
    end
end

return ArenaPeakNewSeasonView
