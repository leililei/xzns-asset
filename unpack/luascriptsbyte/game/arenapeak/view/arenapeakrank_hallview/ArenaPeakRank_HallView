local ArenaPeakModel = require "ArenaPeakModel"
---@class ArenaPeakRank_HallView : Component	中文描述
---@field go_table ArenaPeakRankView._obj_Hall_GoTable
---@param hallList arena_peak.i_palace_hall[]
local ArenaPeakRank_HallView = _G.BaseClass("ArenaPeakRank_HallView", _G.Component)
local seasonId = 90029400052
local GetLangPackValue = _G.GetLangPackValue
function ArenaPeakRank_HallView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self.seasonId = ArenaPeakModel:GetInstance():GetCurSeasonID()
    self.curId = self.seasonId - 1
    self.isSelect = false
end
function ArenaPeakRank_HallView:UpdateView()
    ---@param data arena_peak.s2c_arena_peak_palace_hall
    require "ArenaPeakNet":GetInstance():GetPalaceHall(
        function(data)
            self.hallList = data.info or {}
            _G.table.sort(
                self.hallList,
                function(v1, v2)
                    return v1.s_id > v2.s_id
                end
            )
            self:UpdateHallItems()
            self.go_table.aortext_curZone.text = GetLangPackValue(seasonId, self.curId)
        end
    )
end

function ArenaPeakRank_HallView:RefreshSeasonItem(index, obj)
    local data = self.hallList[index + 1]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickSeason, data.s_id))

    tb.aortext_zone.text = GetLangPackValue(seasonId, data.s_id)
end

function ArenaPeakRank_HallView:OnClickSeason(_, _, id)
    self.curId = id
    self.go_table.aortext_curZone.text = GetLangPackValue(seasonId, self.curId)
    self:UpdateHallItems()
    self:OnClickArrow()
end

function ArenaPeakRank_HallView:UpdateHallItems()
    local data = self.hallList[self.seasonId - self.curId]
    for i = 1, 3 do
        local tb = _G.GetAutoGoTable(self.go_table["obj_top" .. i])
        if self.curId == 0 or not data or not data.ranks or not data.ranks[i] then
            tb.gameObject:SetActiveE(0)
        else
            local cfg = ArenaPeakModel:GetInstance():GetDanCfgByScore(data.ranks[i].score, false)
          
            if data.ranks[i].is_king then
                tb.aorrawimage_icon:LoadImage(cfg.icon)
                tb.obj_star:SetActiveE(0)
            else
                cfg = ArenaPeakModel:GetInstance():GetDanCfgByScoreAndKing(data.ranks[i].score, false)
                tb.aorrawimage_icon:LoadImage(cfg.icon)
                tb.obj_star:SetActiveE(1)
                for j = 1, 3 do
                    if j > cfg.quantity then
                        tb["aorimage_star" .. i].SpriteName = ArenaPeakModel:GetInstance():GetDefaultStarImage()
                    else
                        tb["aorimage_star" .. i].SpriteName = cfg.art
                    end
                end
            end

            tb.aortext_name.text = data.ranks[i].role_info.name
            tb.aortext_score.text = GetLangPackValue(90000010438, data.ranks[i].score)
            tb.aortext_server.text = self:GetInSeverName(data.ranks[i].role_info.server_id)
            tb.aortext_rank.text = _G.GetLangPackValue(cfg.name)
            _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data.ranks[i].role_info, 1, true)
            tb.gameObject:SetActiveE(1)
        end
    end
    self.go_table.obj_no:SetActiveE(self.curId == 0 and 1 or 0)
    self.go_table.obj_Select:SetActiveE(self.curId == 0 and 0 or 1)
end

---获取内网服务器信息
function ArenaPeakRank_HallView:GetInSeverName(id)
    local list = {}
    local curServer = _G.ServerManager:GetInstance().CurServer
    for _, v in pairs(_G.ConfigManager.server_list_cfg) do
        if v.ServerID == id then
            _G.table.insert(list, v)
        end
    end
    local count = #list
    if count == 0 or count > 1 then
        return curServer.ServerName
    else
        return list[1].ServerName
    end
end
---点击箭头
function ArenaPeakRank_HallView:OnClickArrow()
    self.isSelect = not self.isSelect
    self.go_table.obj_isSelect:SetActiveE(self.isSelect and 1 or 0)
    self.go_table.aorimage_arrow:SetLocalScaleXYZ(self.isSelect and -1 or 1)
    if self.isSelect then
        if not self.inited then
            self.go_table.scrollloopvectical_zone:InitItemData(#self.hallList, _G.handler(self, self.RefreshSeasonItem))
            self.inited = true
        else
            self.go_table.scrollloopvectical_zone:ScrollToTop()
        end
    end
end

function ArenaPeakRank_HallView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_arrow then
        self:OnClickArrow()
    end
end

return ArenaPeakRank_HallView
