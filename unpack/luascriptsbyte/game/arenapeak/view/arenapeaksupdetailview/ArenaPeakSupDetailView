---@private
function ArenaPeakSupDetailView:OnClickSkill(go, isOn, skillId)
    local card_skills_cfg = _G.ConfigManager.card_skills_cfg[skillId]
    require("CommonTipManager"):GetInstance():OpenSkillTip(
        skillId,
        nil,
        card_skills_cfg.condition_star > self.cardData.lv
    )
end

---@private
function ArenaPeakSupDetailView:OnClickSoulChain(go, isOn, index)
    local level = index * 5 - 5
    local att_or_skill = CardHunLianModel:GetInstance().SoulLink_Level_Cfg
    local sid, ActiveType
    for i = 1, #att_or_skill do
        if level == att_or_skill[i].level then
            sid = att_or_skill[i].activeDataID
            ActiveType = att_or_skill[i].ActiveType
            break
        end
    end
    --require "CommonTipManager":GetInstance():OpenAttributeTip(go, sid, nil, 2)
    require("CardHunLianManger"):GetInstance():ShowAttributeTips(
        go,
        self.cardSid,
        index * 5 - 5,
        true,
        self.cardData.soulLink_lv
    )
end

---@private
function ArenaPeakSupDetailView:OnClickTalent(go, isOn, id)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.CommonTipView.Name,
        _G.TipType.Talent,
        self.talentData[id]
    )
end

---@private
function ArenaPeakSupDetailView:OnClickDecoration(go, isOn, index)
    local sid = self.cardData.DecorationBar[index].sid
    require("CommonTipManager"):GetInstance():OpenDecorationTips(go, sid)
end

function ArenaPeakSupDetailView:OnClickSpiritual(go, isOn, index)
    local spiritualData = self.cardData.SpiritualBar[index]
    _G.UIManager:GetInstance():OpenWindow(ConfigManager.ui_cfg.CommonTipView.Name, _G.TipType.Spiritual, spiritualData)
end

---设置饰品item
---@param part DecorationPart 饰品位置枚举
---@param dData DecorationData 饰品数据类
---@param isShow boolean 是否显示
function ArenaPeakSupDetailView:SetDecorationBarByPart(part, dData, isShow)
    if isShow then
        _G.GameUtil.SetActiveByCondition((self.EquipDecoration[part].transform), true)
        self.EquipDecoration[part].aorrawimage_Icon:LoadImage(dData.Icon)
        self.EquipDecoration[part].aorimage_Color.SpriteName = dData:GetDecorationJiaoBiaoImage()
        if dData.streng > 0 then
            self.EquipDecoration[part].aortext_Lv.text = "+" .. dData.streng
        else
            self.EquipDecoration[part].aortext_Lv.text = ""
        end
    else
        _G.GameUtil.SetActiveByCondition((self.EquipDecoration[part].transform), false)
    end
end

