---按钮点击事件在这里派发
function ArenaPeakSupDetailView:OnClickBtn(go)
    if go == self.go_table.aorbtn_TipsClose then
        self:CloseTips()
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

return ArenaPeakSupDetailView
