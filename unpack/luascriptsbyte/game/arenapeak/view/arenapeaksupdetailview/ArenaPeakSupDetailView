---界面的入口函数
---@param cardData CardData
function ArenaPeakSupDetailView:OnCreate(cardData)
    cardData:OnInitMutuallyData(true)
    cardData:CalcNowSumProp()
    self.cardData = cardData
    self.cardSid = cardData.sid
    local prop = self.cardData.NowSumProp
    self.go_table.aortext_cardName.text = GetLangPackValue(cardData.cfg.Name)
    self.go_table.aortext_power.text = GetLangPackValue(90000000404, _G.GameUtil.NumberToUnitWord(cardData.power))
    local card = ItemCardAllView.New(self.go_table.obj_card)
    card:ShowCardData(cardData, nil, false, true)
    card:ShowLevel(cardData.lv)
    self:ShowProp(prop)
    --装备饰品
    self.EquipDecoration = {
        [_G.DecorationPart.ring] = _G.GetAutoGoTable(
            self.go_table.obj_shipin1,
            _G.handlerbind(self, self.OnClickDecoration, 1)
        ),
        [_G.DecorationPart.necklace] = _G.GetAutoGoTable(
            self.go_table.obj_shipin2,
            _G.handlerbind(self, self.OnClickDecoration, 2)
        ),
        [_G.DecorationPart.earring] = _G.GetAutoGoTable(
            self.go_table.obj_shipin3,
            _G.handlerbind(self, self.OnClickDecoration, 3)
        ),
        [_G.DecorationPart.cloak] = _G.GetAutoGoTable(
            self.go_table.obj_shipin4,
            _G.handlerbind(self, self.OnClickDecoration, 4)
        )
    }
    self:InitOther()
end

---设置属性
---@param data AttributeClass
function ArenaPeakSupDetailView:ShowProp(data)
    if not data then
        if _G.AppSetting.DEBUG then
            _G.LogError(" ArenaPeakSupDetailView:ShowProp 无属性")
        end
        self:Close()
        return
    end
    --- 忽略  (不显示)
    local ignore = {
        ---雷伤增加
        [_G.AttrType.thd_dmg.key] = true,
        ---雷伤减免
        [_G.AttrType.thd_d_r.key] = true,
        ---风伤增加
        [_G.AttrType.air_dmg.key] = true,
        ---风伤减免
        [_G.AttrType.air_d_r.key] = true,
        ---水伤增加
        [_G.AttrType.water_dmg.key] = true,
        ---水伤减免
        [_G.AttrType.water_d_r.key] = true,
        ---火伤增加
        [_G.AttrType.fire_dmg.key] = true,
        ---火伤减免
        [_G.AttrType.fire_d_r.key] = true,
        ---土伤增加
        [_G.AttrType.earth_dmg.key] = true,
        ---土伤减免
        [_G.AttrType.earth_d_r.key] = true
    }
    local prop = data:GetAttrByName()
    local showlist = {}
    for i, v in pairs(prop) do
        -- if v > 0 then
        if _G.AttrType[i] then
            table.insert(
                showlist,
                {
                    key = i,
                    ID = _G.AttrType[i].ID,
                    sortid = _G.AttrType[i].sortid,
                    proptype = _G.AttrType[i].proptype,
                    icon = _G.AttrType[i].icon,
                    des = _G.AttrType[i].des,
                    percentage = _G.AttrType[i].percentage
                }
            )
        end

        -- end
    end
    _G.SortList(
        showlist,
        function(a)
            return -a.sortid
        end
    )

    for _, v in pairs(showlist) do
        local key = v.key
        if ignore[key] == nil then
            local parent
            if v.proptype == 1 then
                parent = self.go_table.obj_PropContent
            else
                parent = self.go_table.obj_PropContentSec
            end
            if parent ~= nil then
                local tran = _G.InstantiateObject(self.go_table.obj_BaseProp, parent)
                if tran then
                    local tb = _G.GetAutoGoTable(tran)
                    tb.aorrawimage_icon:LoadImage(v.icon)
                    tb.aortext_Name.text = v.des
                    tb.aorbtn_Click.onClick:AddListener(
                        _G.handlerbind(self, self.OnClickPropDetail, tb.aorbtn_Click, v.ID)
                    )
                    local num = prop[key]
                    if v.percentage == 1 then
                        num = num * 100
                        num = _G.Mathf.RoundToInt(num)
                        num = tostring(num) .. "%"
                        tb.aortext_Num.text = num
                    else
                        tb.aortext_Num.text = tostring(num)
                    end
                end
            end
        end
    end
end

function ArenaPeakSupDetailView:CloseTips()
    self.go_table.aorbtn_TipsClose:SetActiveE(0)
    self.go_table.obj_TipsBg:SetActiveE(0)
end

function ArenaPeakSupDetailView:OnClickPropDetail(go, sid)
    self.go_table.aorbtn_TipsClose:SetActiveE(1)
    self.go_table.obj_TipsBg:SetActiveE(1)
    local x, y, z = go:GetPosition()
    self.go_table.obj_TipsBg:SetPosition(x + 5, y, z)
    self.go_table.aortext_Tips.text = _G.LangUtil.GetLangPackValue(_G.ConfigManager.type_attribute_cfg[sid].desc)
    _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(
        self.go_table.aortext_Tips:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    )
end

