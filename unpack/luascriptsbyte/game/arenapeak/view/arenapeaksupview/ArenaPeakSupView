---@private
function ArenaPeakSupView:UpdateSkill()
    local skillId, skillCfg ,lv
    for i = 1, 5 do
        if i ~= 2 then
            skillId = self.cardData.Skills["skill_" .. i]
            if skillId == 0 then
                skillId = self.cardSid + i * 100 + 1
                --skillId = skillId * -1
            end
            skillCfg = _G.ConfigManager.card_skills_cfg[skillId]
            local tb = _G.GetAutoGoTable(self.go_table["obj_skill" .. i], _G.handlerbind(self, self.OnClickSkill, skillId))
            _G.GameUtil.SetActiveByCondition(tb.aorimage_nuqi, skillCfg.skill_pos == 1)
            tb.aortext_skilllevel.text = skillCfg.level
            require("CardInfoManager").LoadRawImage(tb.aorrawimage_skill, skillCfg.icon)
        end
    end
end

