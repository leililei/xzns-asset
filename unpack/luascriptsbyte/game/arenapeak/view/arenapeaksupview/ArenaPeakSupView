function ArenaPeakSupView:OnStartClose()
    self:ClearSound()
    --if self.co2 then
    --    _G.coroutine.stopwaiting(self.co2)
    --    self.co2 = nil
    --end
    self:RoleRecycle()
    if self.AnimComponent then
        self.AnimComponent = _G.RoleAnimatorController.GetOrCreateAnimatorController(self.roleTrans)
        self.AnimComponent.animator.cullingMode = self.state
    end
    _G.PoolsManager:GetInstance():ClearPoolAll(_G.ePoolType.Temporary)
    if self.camera then
        self:ResetCameraPos(true)
        self.camera.targetTexture = nil
        self.CPostProcessLayer.enabled = false
        self.mainCPostProcessLayer.enabled = true
        _G.DestroyObject(self.camera.gameObject)
    end
    if self.scene then
        _G.DestroyObject(self.scene)
    end
    if self.texture then
        _G.CS.FrameWork.Graphic.Utility.RenderTextureUtility.Release(self.texture)
        self.texture = nil
    end
    _G.GraphicsManager.Instance.MainCamera.enabled = true
end

