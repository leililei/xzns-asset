--加载角色
local function LoadRoleScene(view, rolepath, callback)
    view:RoleRecycle()
    view.cancelSpawnItem =
    require("CardInfoManager").GetRole(
            rolepath,
            _G.ePoolType.Temporary,
            view.sceneTrans,
            _G.RoleEffTypeEnum.RoleShow,
            function(trans)
                if trans == nil then
                    if _G.AppSetting.DEBUG then
                        _G.LogError("角色无法加载 path:" .. rolepath .. "    CardInfoView LoadRoleScene")
                    end
                    return
                end
                local parent = view.sceneTrans
                local environment = parent:GetComponentInChildren(_G.typeof(_G.CS.FrameWork.Environment.EnvironmentSetting))
                if environment then
                    environment.SceneCamera.fieldOfView = 30 * _G.CS.Launcher.Inst.FovScale
                end
                trans:SetParentE(view.sceneTrans)
                trans:SetLocalPosition(1000, 0, 0)
                local card_show_cfg = _G.ConfigManager.card_show_cfg
                local myCard_show_cfg = card_show_cfg[view.curRoleData.cfg.id]
                local Scale = 0.9
                if myCard_show_cfg == nil then
                    if _G.AppSetting.DEBUG then
                        _G.LogError("card_show_cfg 未找到配置 sid:" .. view.curRoleData.cfg.id)
                    end
                else
                    --设置  缩放
                    Scale = (myCard_show_cfg.Size1 > 0 and myCard_show_cfg.Size1 or 1) * 0.9
                end
                trans:SetLocalScale(Scale, Scale, Scale)

                view.roleTrans = trans
                view.RolePoint = trans:GetComponentE(_G.typeof(_G.CS.RolePoint))
                if view.RolePoint then
                    view.bip = view.RolePoint.Point_Chest
                    view.head = view.RolePoint.Point_Head
                else
                    view.RolePoint = trans:AddComponentE(_G.typeof(_G.CS.RolePoint))
                    view.RolePoint:FindAll()
                    view.bip = view.RolePoint.Point_Chest
                    view.head = view.RolePoint.Point_Head
                end

                view.AnimComponent = _G.RoleAnimatorController.GetOrCreateAnimatorController(view.roleTrans)
                view.state = view.AnimComponent.animator.cullingMode
                view.AnimComponent.animator.cullingMode = _G.CS.UnityEngine.AnimatorCullingMode.AlwaysAnimate
                trans:SetActiveE(0)
                trans:SetActiveE(1)
                if callback then
                    callback(trans)
                end
            end
    )
end

