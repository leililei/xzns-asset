---检测按下
---@param go UnityEngine.GameObject 按钮对象
function ArenaPeakBPView:OnDragBtnPressDown(go, ed)
    if self.step ~= Step.Array or self.myTurnFinish then
        return
    end
    if self.onBtnFuncRun then
        return
    end
    if self.isRecommend then
        return
    end
    if self.curDragModelIndex and self.curDragModelIndex > 0 then
        return
    end
    for i = 1, #self.moveBtns do
        if self.moveBtns[i]:GetActiveSelf() == 1 then
            if go == self.moveBtns[i] then
                if not self.modelDataArray[i].tran then
                    return
                end
                --镇魂特训 (固定阵容不可移动)
                local flag, num = self.curEmbattleItem:CheckCardHandle(self.modelDataArray[i].uid)
                if not flag then
                    if num == 1 then
                        return
                    end
                end
                self.curDragModelIndex = i
                self.dragHit, self.dragPosX, self.dragPosY, self.dragPosZ =
                    _G.CS.UIUtils.GetWorldPosByScreenPointInMainCamera(
                    self.centerPos[1],
                    self.centerPos[2],
                    self.centerPos[3]
                )
                if self.dragHit then
                    self:ShowDragTips(true, i)
                    self:SetModelPos(i, self.dragPosX, self.dragPosY, self.dragPosZ)
                    self.moveEffectTrans:SetActiveE(1)
                    local pos = self.modelDataArray[i].pos
                    self.moveEffectTrans:SetPosition(pos[1], pos[2], pos[3])
                end
                break
            end
        end
    end
end

