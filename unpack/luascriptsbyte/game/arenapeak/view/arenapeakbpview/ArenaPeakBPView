        for i = 1, #self.combSkillUnLock[index] do
            if self.combSkillUnLock[index][i] and not EmbattleModelIns:GetCombineSkillOpenEffectPlay(i) then
                EmbattleModelIns:SetCombineSkillOpenEffectPlay(i)
