---超时自动操作
function ArenaPeakBPView:AutoEnsure(isHosting)
    if not self:IsMyTurn() or self.myTurnFinish or self.ready then
        return
    end
    if self.step < Step.Ban then
        local indexes = self:CalIndexByStep()
        local simpleRoomCard, roomCard, card, pos
        for i = 1, #indexes do
            if not self.curChoose[i] then
                pos = indexes[i]
                card = self:AutoChooseCard(i)
                simpleRoomCard = self:CreateSimpleRoomCard(card, pos)
                roomCard = self:CreateRoomCard(card, pos)
                self.curChoose[i] = simpleRoomCard
                self.myCards[pos] = card.uid
                self.curEmbattleItem:SetEmbattleDataSingle(pos, card.uid)
                self.cardItems[pos]:Show(roomCard, false, false)
            end
            self:UpdateCardList()
            if roomCard then
                self:PlayCardSound(roomCard.card_sid)
            end
        end
        if card then
            self:GetPortraitBySid(card.sid, card.skin)
        end
    elseif self.step == Step.Ban then
        self:AutoSetBan()
        for i = 7, 12 do
            self.cardItems[i]:ShowBan(self.eyBan + 6 == i)
        end
    elseif self.step == Step.Array then
        self:AutoSetArray()
    elseif self.step == Step.Combine then
        local skills = self.curEmbattleItem:OtherGroupSkillListNew(self.curEmbattleIndex)
        local type = 1
        local combineCfg = ConfigManager.combine_cfg
        if self.combineMy[1] ~= 0 then
            if self.eyTurnFinish then
                self:ReadyToFight()
            end
            return
        end
        for i = 1, #self.myCombine do
            if self.myCombine[i] == 0 then
                type = i
                break
            end
        end
        for i = 1, #skills do
            if combineCfg[skills[i][1]].classify == type then
                self.myCombine[type] = skills[i][1]
                self.combSkillUnLock[1][type] = combineCfg[skills[i][1]].skills[skills[i][2]]
                type = type + 1
            end
            if type > 3 then
                break
            end
        end
        local pbData = {combine_list = self.myCombine}
        ArenaPeakNet:GetInstance():EnsureCombine(
            pbData,
            function(msg)
                if msg.ack == 1 then
                    self.myTurnFinish = true
                    self:ShowCombSkill()
                    if self.combineView then
                        self.combineView:AddListenerCloseCall(nil)
                        --TODO:3个合击技都确定完 则关闭合击技能界面
                        self.combineView:Close()
                        self.combineView = nil
                    end
                    if msg.room_info then
                        self:InitView(msg.room_info, true)
                        return
                    end
                    if self.eyTurnFinish then
                        self:ReadyToFight()
                    end
                else
                    _G.PopWindowManager:GetInstance():ShowAllTips(880122)
                    self:SetFightBtnGray(true)
                end
            end
        )
        return
    end
    self.handleType = isHosting and 0 or 1
    self:OnClickBtn(self.go_table.aorbtn_sure, true, not isHosting)
    --if self.step < Step.Ban then
    --    ArenaPeakNet:GetInstance():TimeOut(
    --            function()
    --                self.myPunish = true
    --            end
    --    )
    --end
end

function ArenaPeakBPView:HasChoose(sid)
    for _, v in pairs(self.curChoose) do
        if sid == v.card_sid then
            return true
        end
    end
    return false
end

function ArenaPeakBPView:ChooseCardByPower(i)
    local card
    for j = i, #self.sortDic[2] do
        card = self.cardList[self.sortDic[2][j]]
        if not self:HasChoose(card.sid) then
            return card
        end
    end
end

function ArenaPeakBPView:AutoChooseCard(i)
    if self.isHosting then
        local card
        for _, uid in pairs(self.preChoose) do
            if uid > 0 then
                for j = 1, #self.sortDic[2] do
                    card = self.cardList[self.sortDic[2][j]]
                    if card.uid == uid then
                        return card
                    end
                end
            end
        end
        return self:ChooseCardByPower(i)
    else
        return self:ChooseCardByPower(i)
    end
end

function ArenaPeakBPView:AutoSetBan()
    if self.isHosting then
        for i, bSid in pairs(self.preBan) do
            for j, sid in pairs(self.eyCards) do
                if bSid == sid then
                    self.eyBan = j
                    return
                end
            end
        end
        self.eyBan = 1
    else
        self.eyBan = 1
    end
end

function ArenaPeakBPView:AutoSetArray()
    if self.isHosting then
        local array = self:GetArray()
        local sitsData = {}
        for _, v in pairs(array) do
            _G.table.insert(sitsData, self:FindCardByUid(v))
        end
        _G.table.sort(
            sitsData,
            function(a, b)
                if a.cfg.Distance ~= b.cfg.Distance then
                    return a.cfg.Distance < b.cfg.Distance
                end
                local pwa = a:GetPower()
                local pwb = b:GetPower()
                if pwa ~= pwb then
                    return pwa > pwb
                end
                return a.sid > b.sid
            end
        )
        for i = 1, #sitsData do
            if array[i] ~= sitsData[i].uid then
                self.curEmbattleItem:ClearEmbattle()
                for j = 1, #sitsData do
                    self.curEmbattleItem:SetEmbattleDataSingle(j, sitsData[j].uid)
                end
                self.initAllRoleModel = false
                self:UpdateAllModel()
                break
            end
        end
    end
end

