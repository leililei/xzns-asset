function ArenaPeakBPView:LoadRoleModel(dic, call, index)
    local role = _G.BattleManager:GetInstance():GetCacheRole(dic.sid, index < defaultEmbattleCount)
    if role then
        role:SetParentE(self.sceneRoot)
        if dic.gray then
            self:SetModelGray(index)
            dic.gray = nil
        end
        call(role)
    else
        self.Role[index] =
            require("CardInfoManager").GetRole(
            dic.path,
            _G.ePoolType.Static,
            self.sceneRoot,
            _G.RoleEffTypeEnum.Fight,
            function(role)
                if ArenaPeakBPView == nil then
                    self.Role[index]:Dispose()
                end
                call(role)
                if dic.gray then
                    self:SetModelGray(index)
                    dic.gray = nil
                end
            end
        )
    end
