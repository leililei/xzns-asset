---是否是我的操作轮次
function ArenaPeakBPView:IsMyTurn()
    local remainder = self.isFirst and 1 or 0
    return self.step >= Step.Ban or self.step % 2 == remainder
end

---获取当前阶段待选择角色栏位下标
function ArenaPeakBPView:GetCurIndexes()
    self.curIndexes = {}
    if self.step < Step.Ban then
        self.curIndexes = self:CalIndexByStep()
        if not self:IsMyTurn() then
            for i = 1, #self.curIndexes do
                self.curIndexes[i] = self.curIndexes[i] + 6
            end
        end
    end
end

