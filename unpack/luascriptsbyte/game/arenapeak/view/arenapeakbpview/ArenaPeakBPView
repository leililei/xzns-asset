---@private
function ArenaPeakBPView:InitView(roomInfo, isSend)
    self.cacheCardSids = EmbattleController:GetInstance():GetCacheCardSids()
    self.info = roomInfo
    self.beforeStep = self.step
    self.step = roomInfo.step
    self.isFirst = roomInfo.is_first
    self.my = roomInfo.is_first and "a" or "b"
    self.ey = roomInfo.is_first and "b" or "a"
    self.myCardsInfo = roomInfo["choose_card_" .. self.my] or {}
    self.eyCardsInfo = roomInfo["choose_card_" .. self.ey] or {}
    _G.table.sort(
        self.myCardsInfo,
        function(a, b)
            return a.index < b.index
        end
    )
    _G.table.sort(
        self.eyCardsInfo,
        function(a, b)
            return a.index < b.index
        end
    )
    self.myCards = {0, 0, 0, 0, 0, 0}
    self.eyCards = {0, 0, 0, 0, 0, 0}
    self.eyCardSkin = {0, 0, 0, 0, 0, 0}
    for i = 1, #self.myCardsInfo do
        self.myCards[self.myCardsInfo[i].index] = self.myCardsInfo[i].card_uid
        if self.myCardsInfo[i].card_uid == self.myCardsInfo[i].card_sid then
            ArenaPeakModel:GetInstance():SetUseSupport(true)
        end
    end
    for i = 1, #self.eyCardsInfo do
        self.eyCards[self.eyCardsInfo[i].index] = self.eyCardsInfo[i].card_sid
        self.eyCardSkin[self.eyCardsInfo[i].index] = self.eyCardsInfo[i].skin_id
    end
    self.mySits = roomInfo["sits_" .. self.my]
    self.eySits = roomInfo["sits_" .. self.ey]
    self.myBan = roomInfo["ban_index_" .. self.my] or 0
    self.eyBanInfo = roomInfo["ban_index_" .. self.ey] or 0 --存储服务器ban人数据
    self.eyBan = self.eyBanInfo
    self.combineMy = roomInfo["combine_" .. self.my] or {0, 0, 0}
    for i = 1, #self.combineMy do
        if self.combineMy[i] ~= 0 then
            self.combSkillUnLock[1][i] = ConfigManager.combine_cfg[self.combineMy[i]].skills[1]
        end
    end
    self.combineEy = roomInfo["combine_" .. self.ey] or {0, 0, 0}
    for i = 1, #self.combineEy do
        if self.combineEy[i] ~= 0 then
            self.combSkillUnLock[2][i] = ConfigManager.combine_cfg[self.combineEy[i]].skills[1]
        end
    end
    self:ShowRole(self.go_table.obj_my, roomInfo["role_info_" .. self.my])
    self:ShowRole(self.go_table.obj_enemy, roomInfo["role_info_" .. self.ey])
    self.curChoose = {}
    self.cardList = self.curEmbattleItem:GetCardList()
    if not self.modelInit then
        self:InitModelPos()
        self.modelInit = true
    end
    self.handleType = 0
    self:ShowByStep(isSend)
end

---根据阶段显示
function ArenaPeakBPView:ShowByStep(isSend)
    ---检测敌我当前状态（是否受到惩罚与是否回合结束）
    self:InitAllState()
    local timeOutRole = self.info.time_out_role or {}
    for _, v in pairs(timeOutRole) do
        if v == self.uid then
            self.myPunish = true
        else
            self.eyPunish = true
        end
    end
    self.myTurnFinish = self:CalMyTurnFinish()

    ---刷新两侧角色
    if self.eyBanTemp > 0 and self.eyBan == 0 then
        self.eyBan = self.eyBanTemp
    end
    self:GetCurIndexes()
    local showEff, showBan, cardInfo, reshow
    local isBaning = self.step == Step.Ban and self.eyBan == 0 and self.eyBanTemp == 0
    for i = 1, 12 do
        showEff = table.ContainsValue(self.curIndexes, i)
        reshow = false
        if isBaning and i > 6 then
            reshow = true
            showEff = false
        end
        showBan = i == self.myBan or (self.eyBan > 0 and i == self.eyBan + 6)
        cardInfo = i <= 6 and self.myCardsInfo[i] or self.eyCardsInfo[i - 6]
        self.cardItems[i]:Show(cardInfo, showEff, showBan, i > 6)
        if reshow then
            self.cardItems[i]:ReshowEffect()
        end
    end

    ---服务器自动选择播放台词
    if isSend and self.step < Step.Ban then
        local index = 0
        local sid, skinId
        if self:IsMyTurn() then
            for i = 1, #self.eyCardsInfo do
                if self.eyCardsInfo[i].index > index then
                    index = self.eyCardsInfo[i].index
                    if self.playCardsSound and not self.playCardsSound[index] then
                        sid = self.eyCardsInfo[i].card_sid
                        skinId = self.eyCardsInfo[i].skin_id
                    end
                end
            end
        else
            for i = 1, #self.myCardsInfo do
                if self.myCardsInfo[i].index > index then
                    index = self.myCardsInfo[i].index
                    if self.playCardsSound and not self.playCardsSound[index] then
                        sid = self.myCardsInfo[i].card_sid
                        skinId = self.myCardsInfo[i].skin_id
                    end
                end
            end
        end
        if sid then
            self:PlayCardSound(sid)
            self:GetPortraitBySid(sid, skinId)
        end
    end
    self.playCardsSound = {}
    ---显示合击技
    self:ShowCombSkill()
    ---启动计时器
    if self.step ~= self.beforeStep then
        local curTurnTime = self:GetStepTime()
        self.countDown = _G.Mathf.Floor(curTurnTime - (TimeUtil.GetServerUnixTime() - self.info.state_start_time))
        -- local limit = 29
        -- if self.step < Step.Ban then
        --     if (self:IsMyTurn() and self.myPunish) or (not self:IsMyTurn() and self.eyPunish) then
        --         limit = 15
        --     end
        -- end
        -- if self.countDown > limit then
        --     self.countDown = limit
        -- end
        self.go_table.aortext_times.text = self.countDown
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.timer:Start()
    end
    ---刷新布阵与模型
    if self.mySits then --一定是在布阵或合击技阶段
        local array = self:GetArray()
        for i = 1, #self.mySits do
            if array[i] ~= self.mySits[i] then
                self.curEmbattleItem:ClearEmbattle()
                for j = 1, #self.mySits do
                    self.curEmbattleItem:SetEmbattleDataSingle(j, self.mySits[j])
                end
                self.initAllRoleModel = false
                self:UpdateAllModel()
                break
            end
        end
    else
        local array, count = self:GetCurArray()
        local noError = true
        if self.myBan > 0 then
            if table.ContainsValue(array, self.myCards[self.myBan]) then
                noError = false
            end
        end
        if not (self.step == Step.Array and count == 5 and noError) then --保证重连正确的前提下，不会覆写已调整但未确定的布阵
            self:ResetEmbattleData()
        end
    end

    ---部分图片与特效显示
    if self.step > Step.Ban then
        self.go_table.aorrawimage_showRole:SetActiveE(0)
        self.go_table.aorimage_banRole:SetActiveE(0)
        self.go_table.obj_bg:SetActiveE(0)
    end

    ---阶段特殊处理，包含敌方回合状态
    if self.step == Step.Ban then
        if self.myBan > 0 then
            self.eyTurnFinish = true
        end
    elseif self.step == Step.Array then
        if self.eySits then
            self.eyTurnFinish = true
        end
        if isSend and not self.playCloud then
            self.playCloud = true
            self.go_table.aorbtn_sure.enabled = false
            self.go_table.obj_cloudEff:SetActiveE(1)
            _G.DelayDo(
                2,
                function()
                    if self:IsNil() then
                        return
                    end
                    _G.DelayDo(
                        3,
                        function()
                            if self:IsNil() then
                                return
                            end
                            self.go_table.aorbtn_sure.enabled = true
                        end
                    )
                    self.go_table.obj_cloudEff:SetActiveE(0)
                    self.go_table.obj_cloudEff1:SetActiveE(1)
                    self:UpdateAllModel()
                end
            )
        else
            self:UpdateAllModel()
        end
    elseif self.step == Step.Combine then
        if self.combSkillUnLock[2][1] > 0 then
            self.eyTurnFinish = true
        end
        if self.myTurnFinish and self.eyTurnFinish then
            self:ReadyToFight()
        elseif self.combineView == nil and self.myCombine == nil then
            self:OpenCombineView()
        end
        self.go_table.aorbtn_giveUp:SetActiveE(0)
    end
    if not self:IsMyTurn() or (self:IsMyTurn() and self.myTurnFinish) then
        self:SetFightBtnGray(true)
    else
        self:SetFightBtnGray(false)
    end
    ---刷新卡牌列表
    self:UpdateCardList()
    ---刷新顶部描述
    self:UpdateTurnDescribe()
    if self.effHand then
        self.effHand:SetActiveE(0)
    end
end

