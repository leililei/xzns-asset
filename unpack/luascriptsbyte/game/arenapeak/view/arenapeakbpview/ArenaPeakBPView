---刷新当前展示卡牌顺序
function ArenaPeakBPView:UpdateCardList()
    self.sortDic = {
        [1] = {}, --已选择
        [2] = {}, --常规
        [3] = {}, --同名
        [4] = {} --敌方已选择
    }
    local card, joinCheck
    local count = 0
    for i = 1, #self.cardList do
        joinCheck = false
        card = self.cardList[i]
        if require "CardInfoManager":GetInstance():CheckMultiMatch(self.chooseElementType , card.cfg.Elements_new) or self.chooseElementType == 0 then
            if self.chooseEquipmentType == card.cfg.EquipmentType or self.chooseEquipmentType == 0 then
                if self.chooseProfType == card.cfg.Professional or self.chooseProfType == 0 then
                    joinCheck = true
                end
            end
        end
        if joinCheck then
            count = count + 1
            if self.curEmbattleItem:CheckUidInEmbattle(card.uid) then
                table.insert(self.sortDic[1], i)
            elseif self.curEmbattleItem:CheckSidInEmbattle(card.sid) then
                table.insert(self.sortDic[3], i)
            elseif _G.table.ContainsValue(self.eyCards, card.sid) then
                table.insert(self.sortDic[4], i)
            else
                table.insert(self.sortDic[2], i)
            end
        end
    end
    self.go_table.scrollloophorizontal_card:UpdateCount(count)
end

---@private
function ArenaPeakBPView:RefreshList(index, obj)
    index = index + 1
    local id = obj:GetInstanceID()
    if not self.cardItemList[id] then
        self.cardItemList[id] = ArenaPeakCardListItem.New(obj, _G.handler(self, self.OnClickCard))
    end
    local idx = index
    local type = 2
    ---@type CardData
    local card
    local idxVal = 0
    for i = 1, #self.sortDic do
        if idx <= #self.sortDic[i] then
            type = i
            idxVal = self.sortDic[i][idx]
            card = self.cardList[idxVal]
            break
        else
            idx = idx - #self.sortDic[i]
        end
    end
    self.cardItemList[id]:Show(idxVal, card, type)
end

