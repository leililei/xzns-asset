                if dic.path then
                    self:LoadRoleModel(dic, call, index)
                else
                    call()
                end
                --         end
                --     )
            end
        )
    else
        if dic.path then
            self:LoadRoleModel(dic, call, index)
        else
            call()
        end
    end
