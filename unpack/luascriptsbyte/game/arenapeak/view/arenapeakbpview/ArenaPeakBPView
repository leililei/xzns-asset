---刷新时间
function ArenaPeakBPView:UpdateTime(elapsed)
    if self.countDown > 0 then
        self.countDown = self.countDown - elapsed
        self.go_table.aortext_times.text = Mathf.RoundToInt(self.countDown)
        if self.isHosting then
            self:HostingRandomEnsure()
        end
    elseif self.countDown <= 0 then
        if not self:IsNil() then
            self:AutoEnsure()
            self.countDown = -1
        end
    end
end

--region ------------- 托管 -------------
function ArenaPeakBPView:HostingRandomEnsure()
    local curStepTime = self:GetStepTime()
    if not curStepTime then
        return
    end
    local delta = curStepTime - Mathf.RoundToInt(self.countDown)
    if delta == 0 then
        return
    end
    if self.step == Step.Combine then
        if self.combineView then
            if delta > 0 and delta % 2 == 0 then
                if self.autoCombineType == nil then
                    self.autoCombineType = 1
                end
                if self.autoCombineType > 3 then
                    return
                end
                if self.myCombine[self.autoCombineType] == 0 then
                    local sid = self.preCombine[self.autoCombineType]
                    if sid == 0 then
                        local combineCfg = ConfigManager.combine_cfg
                        local skills = self.curEmbattleItem:OtherGroupSkillListNew(self.curEmbattleIndex)
                        for i = 1, #skills do
                            if combineCfg[skills[i][1]].classify == self.autoCombineType then
                                sid = skills[i][1]
                                break
                            end
                        end
                    end
                    self.combineView:EquipSkill(self.autoCombineType, sid)
                end
                self.autoCombineType = self.autoCombineType + 1
            end
        end
    else
        if delta >= 1 then
            self:AutoEnsure(true)
        end
    end
end
