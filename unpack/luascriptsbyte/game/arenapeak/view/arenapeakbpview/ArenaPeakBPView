---计算当前阶段选人位置
function ArenaPeakBPView:CalIndexByStep()
    local indexes = {}
    if self.step == Step.Choose1 then
        indexes = {1}
    elseif self.step == Step.Choose2 then
        indexes = {1, 2}
    elseif self.step == Step.Choose3 then
        indexes = {2, 3}
    elseif self.step == Step.Choose4 then
        indexes = {3, 4}
    elseif self.step == Step.Choose5 then
        indexes = {4, 5}
    elseif self.step == Step.Choose6 then
        indexes = {5, 6}
    elseif self.step == Step.Choose7 then
        indexes = {6}
    end
    return indexes
    --return self.step + self.step % 2 - 1
end

---点击卡牌列表的卡牌
function ArenaPeakBPView:OnClickCard(index, type)
    if self.step < Step.Ban and self:IsMyTurn() then
        local indexes = self:CalIndexByStep()
        local card = self.cardList[index]
        if type == 1 then
            --已上阵
            local pos = self:CheckCardPos(card.uid)
            local idx = _G.table.indexof(indexes, pos)
            if idx then
                --下阵处理
                self.curChoose[idx] = nil
                self.myCards[pos] = 0
                self.curEmbattleItem:SetEmbattleDataSingle(pos, card.uid)
                self.cardItems[pos]:Show(nil, true, false)
                --self:ChangeModel(pos)
                self:UpdateCardList()
                self.go_table.aorrawimage_showRole.Alpha = 0
                local roomCard = self:CreateSimpleRoomCard(card, pos)
                ArenaPeakNet:GetInstance():ChooseCard({cards = {roomCard}, type = 0})
                self:UpdateTurnDescribe()
                self.playCardsSound[pos] = false
                if #indexes == 2 and self.myCards[indexes[3 - idx]] == 0 then
                    self.cardItems[pos]:ReshowEffect()
                    self.cardItems[indexes[3 - idx]]:ReshowEffect()
                end
                if _G.table.count(self.curChoose) < #self:CalIndexByStep() then
                    self.effHand:SetActiveE(0)
                end
            end
        elseif type == 2 then
            --可上阵
            local pos = self:CheckEmptyPos(indexes)
            local idx = _G.table.indexof(indexes, pos)
            local roomCard = self:CreateRoomCard(card, pos)
            local simpleRoomCard = self:CreateSimpleRoomCard(card, pos)
            self.curChoose[idx] = simpleRoomCard
            self.myCards[pos] = card.uid
            self.curEmbattleItem:SetEmbattleDataSingle(pos, card.uid)
            self.cardItems[pos]:Show(roomCard, false, false)
            --self:ChangeModel(pos, self.cardList[index])
            self:UpdateCardList()
            self:GetPortraitBySid(card.sid, card.skin)
            ArenaPeakNet:GetInstance():ChooseCard({cards = {simpleRoomCard}, type = 1})
            self:UpdateTurnDescribe()
            self:PlayCardSound(card.sid)
            self.playCardsSound[pos] = true
            if _G.table.count(self.curChoose) == #self:CalIndexByStep() then
                self.effHand:SetActiveE(1)
            end
        elseif type == 3 then
            --同名卡
        elseif type == 4 then
        --敌方已上阵
        end
    end
end

