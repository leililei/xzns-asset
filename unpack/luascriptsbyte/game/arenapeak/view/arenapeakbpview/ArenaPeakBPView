        if self.combineView then
            self.combineView:AddListenerCombineEnter(_G.handler(self, self.OnCombineSkillEquip))
            self.combineView:AddListenerIsEquipSkill(_G.handler(self, self.OnCheckEquipSkill))
            self.combineView:AddListenerCloseCall(
                function()
                    _G.PopWindowManager:GetInstance():ShowAllTips(880114)
                end
            )
