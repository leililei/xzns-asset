---按钮点击事件在这里派发
function ArenaPeakBPView:OnClickBtn(go, isOn, isAuto)
    if go == self.go_table.aorbtn_sure then
        if not self:IsMyTurn() or self.myTurnFinish then
            return
        end
        if self.step < Step.Ban then
            if _G.table.count(self.curChoose) < #self:CalIndexByStep() then
                _G.PopWindowManager:GetInstance():ShowAllTips(880111)
            else
                local pbData = {cards = self.curChoose, handle_type = self.handleType}
                local step = self.step
                self.myTurnFinish = true
                if self.effHand then
                    self.effHand:SetActiveE(0)
                end
                ArenaPeakNet:GetInstance():EnsureCard(
                    pbData,
                    function(msg)
                        if not isAuto then
                            self.myPunish = false
                        end
                        if self.step == step then
                            if msg.ack == 1 then
                                for _, v in pairs(self.curChoose) do
                                    if v.card_sid == v.card_uid then
                                        ArenaPeakModel:GetInstance():SetUseSupport(true)
                                    end
                                end
                                self:ChangeStep()
                                if self.step < Step.Ban then
                                    self:SetFightBtnGray(true)
                                end
                            else
                                --self.myTurnFinish = false
                                _G.PopWindowManager:GetInstance():ShowAllTips(880122)
                                self:SetFightBtnGray(true)
                            end
                        end
                    end
                )
            end
        elseif self.step == Step.Ban and not self.myTurnFinish then
            if self.eyBan <= 0 then
                _G.PopWindowManager:GetInstance():ShowAllTips(880112)
                return
            end
            self.myTurnFinish = true
            self.effHand:SetActiveE(0)
            local pbData = {card_index = self.eyBan, handle_type = self.handleType}
            ArenaPeakNet:GetInstance():BanCard(
                pbData,
                function(msg)
                    if self.step == Step.Ban then
                        if msg.ack == 1 then
                            if not isAuto then
                                self.myPunish = false
                            end
                            if msg.room_info then
                                self:InitView(msg.room_info, true)
                                return
                            end
                            self.eyBanInfo = self.eyBan
                            self:UpdateTurnDescribe()
                            if self.myBan > 0 then
                                self:ChangeStep()
                            else
                                self:SetFightBtnGray(true)
                            end
                        else
                            --self.myTurnFinish = false
                            _G.PopWindowManager:GetInstance():ShowAllTips(880122)
                            self:SetFightBtnGray(true)
                        end
                    end
                end
            )
        elseif self.step == Step.Array and not self.myTurnFinish then
            self.myTurnFinish = true
            local pbData = {sits = self:GetArray(), handle_type = self.handleType}
            ArenaPeakNet:GetInstance():EnsureArray(
                pbData,
                function(msg)
                    if self.step == Step.Array then
                        if msg.ack == 1 then
                            if not isAuto then
                                self.myPunish = false
                            end
                            if msg.room_info then
                                self:InitView(msg.room_info, true)
                                return
                            end
                            self:UpdateTurnDescribe()
                            if self.eyTurnFinish then
                                self:ChangeStep()
                            else
                                self:SetFightBtnGray(true)
                            end
                        else
                            --self.myTurnFinish = false
                            _G.PopWindowManager:GetInstance():ShowAllTips(880122)
                            self:SetFightBtnGray(true)
                        end
                    end
                end
            )
        elseif self.step == Step.Combine then
        --if self.canEnterFight then
        --    self.enterFight = true
        --    self:OnBattleClick()
        --end
        end
    elseif go == self.go_table.aorbtn_giveUp then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            880121,
            nil,
            function()
                ArenaPeakNet:GetInstance():GiveUp(
                    function(msg)
                        if msg.ack == 1 then
                            ArenaPeakModel:GetInstance():FightHandler(msg)
                            self:ReturnPanelView()
                            self:QuitEmbattle()
                            UIManager:GetInstance():OpenWindow(
                                _G.ConfigManager.ui_cfg.ArenaPeakSettlementView.Name,
                                function()
                                    ArenaPeakModel:GetInstance():ReturnPanel(self.isHosting)
                                end,
                                msg
                            )
                        --local settlement = require("SettlementArenaPeak").New(nil, nil, nil, msg)
                        --settlement:ShowView()
                        end
                    end
                )
            end
        )
    elseif go == self.go_table.aorbtn_lei then
        self:ChangeEleListType(elementType.Thunder)
    elseif go == self.go_table.aorbtn_feng then
        self:ChangeEleListType(elementType.Wind)
    elseif go == self.go_table.aorbtn_shui then
        self:ChangeEleListType(elementType.Water)
    elseif go == self.go_table.aorbtn_huo then
        self:ChangeEleListType(elementType.Fire)
    elseif go == self.go_table.aorbtn_tu then
        self:ChangeEleListType(elementType.Earth)
    elseif go == self.go_table.aorbtn_shen then
        self:ChangeEleListType(elementType.God)
    elseif go == self.go_table.aorbtn_all then
        self:ChangeEleListType(elementType.None)
    elseif go == self.go_table.aorbtn_pAll then
        self:ChangeProfListType(profType.None)
    elseif go == self.go_table.aorbtn_pTK then
        self:ChangeProfListType(profType.Tank)
    elseif go == self.go_table.aorbtn_pZS then
        self:ChangeProfListType(profType.Warrior)
    elseif go == self.go_table.aorbtn_pFS then
        self:ChangeProfListType(profType.Master)
    elseif go == self.go_table.aorbtn_pFZ then
        self:ChangeProfListType(profType.Support)
    elseif go == self.go_table.aorbtn_pYX then
        self:ChangeProfListType(profType.Ranger)
    elseif go == self.go_table.aorbtn_eAll then
        self:ChangeEquipmentListType(0)
    elseif go == self.go_table.aorbtn_eLiliang then
        self:ChangeEquipmentListType(equipmentType.Plank)
    elseif go == self.go_table.aorbtn_eMinjie then
        self:ChangeEquipmentListType(equipmentType.Coat)
    elseif go == self.go_table.aorbtn_eZhili then
        self:ChangeEquipmentListType(equipmentType.Cloth)
    elseif go == self.go_table.aorbtn_typeList then
        self:ShowTypeList(not self.showTypeListTag)
    elseif go == self.go_table.aorbtn_cancelHosting then
        self.go_table.obj_hosting:SetActiveE(0)
        self.isHosting = false
        ArenaPeakModel:GetInstance():SetHosting(self.isHosting)
    end
end

---@private
function ArenaPeakBPView:OnBattleClick()
    _G.AudioManager.PlayAudioByAudioCfgID(2045)
    local EmbattleControllerIns = EmbattleController:GetInstance()
    EmbattleControllerIns.curEmbattleItem = self.curEmbattleItem
    EmbattleControllerIns:OnEmbattleBattle(
        function()
            _G.UIManager:GetInstance():SetWorldSceneHideTimes(-1)
            local root = _G.WorldManager:GetInstance():GetRoleParent()
            local cacheModel = self.curEmbattleItem:GetCacheModelInBattle()
            if not _G.IsNil(self.curSceneTrans) then
                if cacheModel then
                    self.curSceneTrans:SetParentE(root, 1)
                end
                self.curSceneTrans = nil
            end
            if cacheModel then
                local card
                local RemoveEffect = _G.UIUtils.RemoveEffect
                for i = 1, #self.modelDataArray do
                    card = self.modelDataArray[i]
                    if card and card.tran and not _G.IsNil(card.tran) then
                        card.tran:SetParentE(root, 1)
                        card.tran:ClearDragEff()
                        card.tran = nil
                    end
                    if card and card.effect and not _G.IsNil(card.effect) then
                        RemoveEffect(card.effect, 0)
                        card.effect = nil
                    end
                    -- if card and card.shadow and not _G.IsNil(card.shadow) then
                    --     card.shadow:SetParentE(root, 1)
                    --     EmbattleControllerIns:AddEmbattleEffect(card.shadow)
                    -- end
                end
            end
            if self.curEmbattleItem:GetShowSkip() and self.go_table.toggle_skip.isOn then
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ChatDefultRootView.Name)
            end
            self.sceneRoot:Dispose()
            self:Close()
        end,
        function()
            self.onBtnFuncRun = false
        end
    )
end

return ArenaPeakBPView
