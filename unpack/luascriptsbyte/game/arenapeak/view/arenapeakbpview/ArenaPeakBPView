---拖动
function ArenaPeakBPView:OnDragBtnDrag()
    if self.step ~= Step.Array or self.myTurnFinish then
        return
    end
    if self.onBtnFuncRun then
        return
    end
    if self.isRecommend then
        return
    end
    if not self.curDragModelIndex or self.curDragModelIndex == 0 then
        return
    end

    self.dragHit, self.dragPosX, self.dragPosY, self.dragPosZ =
        _G.CS.UIUtils.GetWorldPosByScreenPointInMainCamera(self.centerPos[1], self.centerPos[2], self.centerPos[3])
    if self.dragHit then
        self:SetModelPos(self.curDragModelIndex, self.dragPosX, self.dragPosY, self.dragPosZ)
        for i = 1, #self.moveBtns do
            if self.moveBtns[i]:GetActiveSelf() == 1 and CheckMousePointInRect(self.moveBtns[i]) then
                -- 拖动到位置上
                self.moveEffectTrans:SetActiveE(1)
                local pos = self.modelDataArray[i].pos
                self.moveEffectTrans:SetPosition(pos[1], pos[2], pos[3])
                return
            end
        end
        self.moveEffectTrans:SetActiveE(0)
    end
end
---检测松开
---@param go UnityEngine.GameObject 按钮对象
function ArenaPeakBPView:OnDragBtnPressUp(go, ed)
    if self.step ~= Step.Array or self.myTurnFinish then
        return
    end
    if self.onBtnFuncRun then
        return
    end
    if self.isRecommend then
        return
    end
    ---是否是引导对应步骤
    local isGuide10013 =
        _G.AppSetting.IsShowTeach and _G.GuideManager:GetInstance().IsGuideing and
        _G.GuideManager:GetInstance().CurGuideId == 10013
    if isGuide10013 then
        if self.IsGuideDrag then
            self.curDragModelIndex = 2
        else
            self.curDragModelIndex = 0
        end
    end
    if not self.curDragModelIndex or self.curDragModelIndex == 0 then
        return
    end
    self:ShowDragTips(false, self.curDragModelIndex)
    local curDic = self.modelDataArray[self.curDragModelIndex]
    local dragPos = 0
    if isGuide10013 then
        dragPos = 3
    else
        for i = 1, #self.moveBtns do
            if
                i ~= self.curDragModelIndex and self.moveBtns[i]:GetActiveSelf() == 1 and
                    CheckMousePointInRect(self.moveBtns[i])
             then
                -- 拖动到别的位置上
                dragPos = i
                break
            end
        end
    end
    if dragPos > 0 then
        _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)
        local dic = self.modelDataArray[dragPos]
        if dic.tran then
            -- 交换
            -- tran = curDic.shadow
            -- curDic.shadow = dic.shadow
            -- dic.shadow = tran
            local tran = curDic.tran
            curDic.tran = dic.tran
            dic.tran = tran
            curDic.sid = curDic.sid + dic.sid
            dic.sid = curDic.sid - dic.sid
            curDic.sid = curDic.sid - dic.sid
            curDic.uid = curDic.uid + dic.uid
            dic.uid = curDic.uid - dic.uid
            curDic.uid = curDic.uid - dic.uid
            curDic.lv = curDic.lv + dic.lv
            dic.lv = curDic.lv - dic.lv
            curDic.lv = curDic.lv - dic.lv
            tran = curDic.head
            curDic.head = dic.head
            dic.head = tran
            tran = curDic.effect
            curDic.effect = dic.effect
            dic.effect = tran
            local soulLinkLv = curDic.soulLinkLv
            curDic.soulLinkLv = dic.soulLinkLv
            dic.soulLinkLv = soulLinkLv
            local talents = curDic.talents
            curDic.talents = dic.talents
            dic.talents = talents
        else
            -- 在此上阵
            dic.tran = curDic.tran
            dic.sid = curDic.sid
            dic.lv = curDic.lv
            dic.head = curDic.head
            dic.uid = curDic.uid
            local tran = dic.effect
            dic.effect = curDic.effect
            curDic.effect = tran
            dic.soulLinkLv = curDic.soulLinkLv
            dic.talents = curDic.talents
            -- tran = dic.shadow
            -- dic.shadow = curDic.shadow
            -- curDic.shadow = tran
            curDic.tran = nil
            curDic.sid = 0
            curDic.lv = 0
            curDic.uid = 0
            curDic.head = nil
            curDic.soulLinkLv = -1
            curDic.talents = nil
        end
        local pos = dic.pos
        self:SetModelPos(dragPos, pos[1], pos[2], pos[3])
        dic.effect:SetPosition(pos[1], pos[2], pos[3])
        --dic.shadow:SetPosition(pos[1], pos[2], pos[3])
        pos = curDic.pos
        self:SetModelPos(self.curDragModelIndex, pos[1], pos[2], pos[3])
        curDic.effect:SetPosition(pos[1], pos[2], pos[3])
        --curDic.shadow:SetPosition(pos[1], pos[2], pos[3])
        self.modelTitleTable[dragPos]:Show(dic.sid, dic.lv)
        self.modelTitleTable[self.curDragModelIndex]:Show(curDic.sid, curDic.lv)
        self.modelTitleTable[dragPos]:SetSoulLinkAndTalent(dic.soulLinkLv, dic.talents)
        self.modelTitleTable[self.curDragModelIndex]:SetSoulLinkAndTalent(curDic.soulLinkLv, curDic.talents)
        -- 数据交换
        self.curEmbattleItem:ChangeCardPos(dragPos, self.curDragModelIndex, self.curEmbattleIndex)
        self.curDragModelIndex = 0
        return
    end
    local pos = curDic.pos
    self:SetModelPos(self.curDragModelIndex, pos[1], pos[2], pos[3])
    self.curDragModelIndex = 0
end

function ArenaPeakBPView:OnClick(go, ed)
    if not self.isRecommend then
        return
    end
    local str = _G.string.replace(go:GetName(), "@_aorbtn_move", "")
    local num = _G.tonumber(str)
    local data = self.modelDataArray[num]
    if data and data.sid > 0 then
        local recordCardData = self.curEmbattleItem:GetRecordCardData(data.sid)
        ---系统推荐不点开
        if recordCardData ~= nil and recordCardData.uid ~= nil then
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CommonOtherIllustrationsView.Name,
                recordCardData,
                function()
                    self.camera =
                        self.curSceneTrans:FindE("Environment/Parent/Main Camera"):GetComponentE(
                        _G.typeof(_G.CS.FrameWork.Graphic.VisualCamera)
                    )
                    self.interpolation = self.camera.Interpolation
                    self.camera.Interpolation = 0
                end
            )
        end
    end
end

function ArenaPeakBPView:SetModelPos(index, x, y, z)
    local dic = self.modelDataArray[index]
    if dic.tran then
        dic.tran:SetPosition(x, y, z)
    end
    if not _G.IsNil(dic.head) then
        x, y = _G.CS.UIUtils.WorldPointToLocalPointInRect(dic.head, self.go_table.rect_moveRoot)
        x = x < -290 and -290 or x
        x = x > 290 and 290 or x
        self.modelTitleTable[index].transform:SetLocalPosition(x, y, 0)
        if self.showDtagTipsTag then
            x, y, z = self.modelTitleTable[index].transform:GetLocalPosition()
            self.go_table.trans_tips:SetLocalPosition(x, y, z)
        end
    end
end

