function ArenaPeakBPView:OnCombineSkillEquip(index)
    if not self.equipSkillIndex then
        self.equipSkillIndex = {false, false, false}
    end
    self.equipSkillIndex[index] = true
    local change, data, curActive
    for i = 1, #self.equipSkillIndex do
        if not self.equipSkillIndex[i] then
            change = true
            --TODO:切换对应页签
            self.combineView:ChangeCurCombineType(i)
            break
        end
    end
    if not change then
        if self.ready then
            return
        end
        --self.go_table.obj_shadow:SetActiveE(1)
        local pbData = {combine_list = self.myCombine}
        for i = 1, #self.myCombine do
            if self.myCombine[i] == 0 then
                self.equipSkillIndex[i] = false
                self.combineView:ChangeCurCombineType(i)
                return
            end
        end
        ArenaPeakNet:GetInstance():EnsureCombine(
            pbData,
            function(msg)
                if msg.ack == 1 then
                    self.myTurnFinish = true
                    if self.combineView then
                        self.combineView:AddListenerCloseCall(nil)
                        --TODO:3个合击技都确定完 则关闭合击技能界面
                        self.combineView:Close()
                        self.combineView = nil
                    end
                    if msg.room_info then
                        self:InitView(msg.room_info, true)
                        return
                    end
                    if self.eyTurnFinish then
                        self:ReadyToFight()
                    end
                    self:UpdateTurnDescribe()
                else
                    --ArenaPeakModel:GetInstance():TryToDestroyRoom()
                    _G.PopWindowManager:GetInstance():ShowAllTips(880122)
                    self:SetFightBtnGray(true)
                end
            end
        )
    end
end

function ArenaPeakBPView:OnCheckEquipSkill(data, index, call)
    data[index].tag = 1
    --TODO:修改数据
    self.myCombine[index] = data[index].id
    self.combSkillUnLock[1][index] = data[index].cskillID
    self.curEmbattleItem:SetCombSkillData(data)
    call(true, index)
end

