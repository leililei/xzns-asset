---@param 变量名 变量类型 中文描述
function ArenaPeakBPView:ShowDragTips(show, index)
    self.showDtagTipsTag = show
    if show then
        self.go_table.trans_tips:SetActiveE(1)
        ---镇魂特训
        if
            self.curEmbattleItem.curEmbattleType ==
                (_G.EmbattleType.trainBattle + require "TrainingModel":GetInstance().Embattle_sectionId)
         then
            local MonsterCfg = _G.ConfigManager.monster_cfg[self.modelDataArray[index].uid]
            local TryGetLangValue = _G.TryGetLangValue
            self.go_table_tips.aortext_name.text = TryGetLangValue(MonsterCfg.Name)
            self.go_table_tips.aortext_power.text =
                _G.string.format(_G.GetLangPackValue(90024900045), _G.GameUtil.NumberToUnitWord(MonsterCfg.Power))
            local Cardcfg = require "CardCommentManager":GetInstance():CardData(MonsterCfg.CardID, true)
            local cfg = _G.ConfigManager.type_professional_cfg[Cardcfg.Professional]
            self.go_table_tips.aortext_profession.text = TryGetLangValue(cfg.name)
            setsprite(self.go_table_tips.aorimage_profession, cfg.icon2)
        else
            local card = self.curEmbattleItem:GetCardData(self.modelDataArray[index].uid)
            --  _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, self.modelDataArray[index].uid)
            if card then
                local TryGetLangValue = _G.TryGetLangValue
                self.go_table_tips.aortext_name.text = TryGetLangValue(card.cfg.Name)
                self.go_table_tips.aortext_power.text =
                    _G.string.format(_G.GetLangPackValue(90024900045), _G.GameUtil.NumberToUnitWord(card:GetPower()))
                local cfg = _G.ConfigManager.type_professional_cfg[card.cfg.Professional]
                self.go_table_tips.aortext_profession.text = TryGetLangValue(cfg.name)
                setsprite(self.go_table_tips.aorimage_profession, cfg.icon2)
            end
        end
        local dic = self.modelDataArray[index]
        if dic and dic.tran then
            dic.tran:ShowDragEff(255, 255, 255, 1, 4)
        end
    else
        if self.moveEffectTrans then
            self.moveEffectTrans:SetActiveE(0)
        end
        self.go_table.trans_tips:SetActiveE(0)
        local dic = self.modelDataArray[index]
        if dic and dic.tran then
            dic.tran:HideDragEff()
        end
    end
end

