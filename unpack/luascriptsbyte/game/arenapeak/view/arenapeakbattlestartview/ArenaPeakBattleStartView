local ArenaPeakModelIns = require("ArenaPeakModel"):GetInstance()

---@class ArenaPeakBattleStartView : UIBaseView	中文描述
---@field public go_table ArenaPeakBattleStartView_GoTable GoTable
local ArenaPeakBattleStartView = _G.BaseClass("ArenaPeakBattleStartView", _G.UIBaseView)

local GetLangPackValue = _G.GetLangPackValue
local GetAutoGoTable = _G.GetAutoGoTable
local UIUtils = _G.UIUtils

function ArenaPeakBattleStartView:Awake()
end

---界面的入口函数
function ArenaPeakBattleStartView:OnCreate(call, roomInfo)
    self:ShowEnterView(call)
    local my = roomInfo.is_first and "a" or "b"
    local ey = roomInfo.is_first and "b" or "a"
    self:ShowRole(self.go_table.obj_mine, roomInfo["role_info_" .. my])
    self:ShowRole(self.go_table.obj_enemy, roomInfo["role_info_" .. ey])
    self:InitEffect()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpened, self)
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.arena_peak_error.Cmd, self.OnPeakError, self)
end

---界面的销毁函数
function ArenaPeakBattleStartView:OnDestroy()
end

function ArenaPeakBattleStartView:InitEffect()
    local LoadEffectByCfg = _G.UIUtils.LoadEffectByCfg
    local RemoveEffect = _G.UIUtils.RemoveEffect
    local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
    local function loadDone(effect)
        if self:IsNil() then
            RemoveEffect(effect)
        end
    end
    LoadEffectByCfg(ui_effect_cfg.ef_ArenaFairAcceptViewbg, self.go_table.trans_effect, loadDone)
    LoadEffectByCfg(ui_effect_cfg.ef_ArenaFairAcceptView_open, self.go_table.trans_common, loadDone)
    LoadEffectByCfg(ui_effect_cfg.ef_ArenaPeakBattleStartView_once, self.go_table.trans_common, loadDone)
end

---@param info arena_peak.i_room_role
function ArenaPeakBattleStartView:ShowRole(obj, info)
    ---@type ArenaPeakBattleStartView._obj_mine_GoTable|ArenaPeakBattleStartView._obj_enemy_GoTable
    local tb = GetAutoGoTable(obj)
    tb.aortext_name.text = info.role_name
    tb.aortext_guild.text = GetLangPackValue(90022500401, info.guild_name ~= "" and info.guild_name or GetLangPackValue(90021300086))
    tb.aortext_score.text = info.score
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, info, 0.7, true, false, false)
    ArenaPeakModelIns:ShowDan(tb.obj_dan, info.score, false, ArenaPeakModelIns:CheckDanIsKing(info.dan))
end

function ArenaPeakBattleStartView:ShowEnterView(call)
    _G.AudioManager.PlayAudioByAudioCfgID(2050)
    self.time = 3
    local imageName = {
        "ui_gpjjc_role_djs1",
        "ui_gpjjc_role_djs2"
    }
    local animator = self.transform:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    animator:Play("ani_ArenaPeakBattleStartView")
    self.Timer =
    _G.TimerManager:GetInstance():GetTimer(
            1,
            self.TimerFunc,
            self,
            false,
            false,
            false,
            imageName,
            animator,
            call
    )
    self.Timer:Start()
end

function ArenaPeakBattleStartView:TimerFunc(imageName,animator,call,elapsed)
    if self:IsNil() then
        return
    end
    self.time = self.time - elapsed
    local timeToInt = Mathf.RoundToInt(self.time)
    if self.time > 0 then
        _G.AudioManager.PlayAudioByAudioCfgID(2050)
        self.go_table.aorimage_num.SpriteName = imageName[timeToInt]
    elseif timeToInt == 0 then
        animator.enabled = false
        local LoadEffectByCfg = _G.UIUtils.LoadEffectByCfg
        local RemoveEffect = _G.UIUtils.RemoveEffect
        local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
        local function loadDone(effect)
            if self:IsNil() then
                RemoveEffect(effect)
            end
        end
        LoadEffectByCfg(ui_effect_cfg.ef_ArenaFairAcceptViewtitle, self.go_table.trans_common, loadDone)
        self.go_table.obj_enter:SetActiveE(0)
        self.go_table.obj_v:SetActiveE(1)
        self.go_table.obj_s:SetActiveE(1)
    else
        self.Timer:Stop()
        self.Timer = nil
        if call then
            call()
        end
        _G.DelayDo(1, function()
            if not self:IsNil() then
                self:Close()
            end
        end)
    end
end

---@private
function ArenaPeakBattleStartView:OnViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.LoadingView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpened, self)
        self:Close()
    end
end

function ArenaPeakBattleStartView:OnPeakError()
    self.peakError = true
    if self.Timer then
        self.Timer:Stop()
        self.Timer = nil
    end
    self:Close()
end

function ArenaPeakBattleStartView:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpened, self)
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.arena_peak_error.Cmd, self.OnPeakError, self)
end

return ArenaPeakBattleStartView
