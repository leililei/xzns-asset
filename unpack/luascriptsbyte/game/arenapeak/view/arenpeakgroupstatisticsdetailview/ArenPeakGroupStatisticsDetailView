---@class ArenPeakGroupStatisticsDetailView : UIBaseView	中文描述
---@field public go_table ArenPeakGroupStatisticsDetailView_GoTable GoTable
---@field data card_use_rate.i_peak_card 卡牌使用情况
local ArenPeakGroupStatisticsDetailView = _G.BaseClass("ArenPeakGroupStatisticsDetailView", _G.UIBaseView)
--_G.ArenPeakGroupStatisticsDetailView = ArenPeakGroupStatisticsDetailView
local GetLangPackValue = _G.GetLangPackValue
local GetAutoGoTable = _G.GetAutoGoTable

function ArenPeakGroupStatisticsDetailView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param data card_use_rate.i_peak_card
function ArenPeakGroupStatisticsDetailView:OnCreate(data)
    self.data = data
    if not self.data.details then
        self.data.details = {}
    end
    _G.table.sort(
        self.data.details,
        function(a, b)
            return a.details_rank < b.details_rank
        end
    )
    self.go_table.scrollloopvectical_rankList:InitItemData(0, _G.handler(self, self.RefreshRankItem))
    -- if _G.AppSetting.IsOverseas then
    --     self.go_table.obj_kh:SetLocalPosition(108, 0, 0)
    --     self.go_table.obj_zf:SetActiveE(1)
    -- else
    --     self.go_table.obj_kh:SetLocalPositionToZero()
    --     self.go_table.obj_zf:SetActiveE(0)
    -- end
    self.go_table.obj_kh:SetLocalPositionToZero()
    self.go_table.obj_zf:SetActiveE(0)
    self.sortCondition = {win = 1}
    self:ShowView()
end

function ArenPeakGroupStatisticsDetailView:ShowView()
    self:ShowCard()
    self:ShowRecommond()
    self.go_table.scrollloopvectical_rankList:UpdateCount(#self.data.details)
    self.go_table.obj_no:SetActiveE(_G.table.isEmptyOrNil(self.data.details) and 1 or 0)
end
---显示推荐刻魂
function ArenPeakGroupStatisticsDetailView:ShowRecommond()
    local data = self.data.details[1]
    local cfg = _G.ConfigManager.decoration_suit_cfg[data.decoration]
    -- if _G.AppSetting.IsOverseas then
    --     ---@type decoration_cfg
    --     local cfg2 = _G.ConfigManager.formation_s_cfg[data.formation]
    --     self.go_table.aortext_recommond.text = GetLangPackValue(cfg.name) .. "/" .. GetLangPackValue(cfg2.name)
    -- else
    --     self.go_table.aortext_recommond.text = GetLangPackValue(cfg.name)
    -- end
    self.go_table.aortext_recommond.text = GetLangPackValue(cfg.name)
end
---显示卡牌
function ArenPeakGroupStatisticsDetailView:ShowCard()
    if not self.card then
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            {self.data.card_sid, 1},
            self.go_table.trans_card,
            function(item)
                ---@type ItemCardBaseView
                self.card = item
                self.card.mItemCardAllView:Show(self.data.card_sid, nil, 24)
                self.card:ShowLv(false)
            end,
            function()
            end
        )
    else
        self.card.mItemCardAllView:Show(self.data.card_sid, nil, 24)
    end
end

function ArenPeakGroupStatisticsDetailView:RefreshRankItem(index, obj)
    ---@type ArenPeakGroupStatisticsDetailView._obj_rankItem_GoTable
    local tb = GetAutoGoTable(obj)
    local data = self.data.details[index + 1]
    tb.index = index + 1
    tb.aorimage_rankBg:SetActiveE(tb.index <= 3 and 1 or 0)
    tb.obj_rankBg2:SetActiveE(tb.index > 3 and 1 or 0)
    if tb.index <= 3 then
        tb.aorimage_rankBg.SpriteName = "tz_qjhs_di_0" .. tb.index + 1
        tb.aorimage_rank.SpriteName = "tz_qjhs_phb_mingci_0" .. tb.index
    else
        tb.aortext_rankNum.text = tb.index
    end

    local cfg = _G.ConfigManager.decoration_suit_cfg[data.decoration]

    if not tb.kh then
        ---@type _obj_rankItem._obj_kh_GoTable
        tb.kh = GetAutoGoTable(tb.obj_kh, _G.handlerbind(self, self.OnClickKH, tb))
        -- if _G.AppSetting.IsOverseas then
        --     tb.obj_kh:SetLocalPosition(-108, 0, 0)
        --     tb.obj_zf:SetActiveE(1)
        -- else
        --     tb.obj_kh:SetLocalPositionToZero()
        --     tb.obj_zf:SetActiveE(0)
        -- end
        tb.obj_kh:SetLocalPositionToZero()
        tb.obj_zf:SetActiveE(0)
    end
    tb.kh.aorrawimage_Icon:LoadImage(cfg.icon)
    -- if _G.AppSetting.IsOverseas then
    --     local formationCfg = _G.ConfigManager.formation_s_cfg[data.formation]
    --     if not tb.zf then
    --         tb.zf = GetAutoGoTable(tb.obj_zf, _G.handlerbind(self, self.OnClickZF, tb))
    --     end
    --     tb.kh.aorrawimage_Icon:LoadImage(formationCfg.image)
    -- end
    tb.aortext_winRate.text = data.win_rate / 100 .. "%/" .. data.play_num
end

function ArenPeakGroupStatisticsDetailView:OnClickKH(go, _, tb)
    local sid = self.data.details[tb.index].decoration
    for _, v in pairs(_G.ConfigManager.decoration_cfg) do
        if v.suit == sid and v.parts == 3 and v.grade > 6 then
            sid = v.id
            break
        end
    end
    require "CommonTipManager":GetInstance():OpenDecorationTips(go, sid)
end

function ArenPeakGroupStatisticsDetailView:OnClickZF(go, _, tb)
    -- ArenPeakGroupStatisticsDetailView
    require "CommonTipManager":GetInstance():OpenTip(go, self.data.details[tb.index].formation)
end

---按钮点击事件在这里派发
function ArenPeakGroupStatisticsDetailView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.aorbtn_win then
        self:OnClickSort()
    end
end

function ArenPeakGroupStatisticsDetailView:OnClickSort()
    local _, _, z = self.go_table.aorimage_win:GetLocalEulerAngles()
    self.go_table.aorimage_win:SetEulerAngles(0, 0, z == 180 and 0 or 180)
    self.sortCondition.win = self.sortCondition.win * -1
    ---@param data card_use_rate.i_peak_card_details
    _G.SortList(
        self.data.details,
        function(data)
            return data.win_rate * self.sortCondition.win, data.details_rank
        end
    )
    self.go_table.scrollloopvectical_rankList:UpdateCount(#self.data.details)
end

return ArenPeakGroupStatisticsDetailView
