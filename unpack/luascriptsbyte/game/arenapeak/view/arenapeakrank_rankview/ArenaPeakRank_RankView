---@class ArenaPeakRank_RankView : Component	中文描述
---@field go_table ArenaPeakRankView._obj_Rank_GoTable
local ArenaPeakRank_RankView = _G.BaseClass("ArenaPeakRank_RankView", _G.Component)
local ArenaPeakModel = require "ArenaPeakModel"
local CS = _G.CS
local typeof = _G.typeof
local UIUtils = _G.UIUtils
local GetAutoGoTable = _G.GetAutoGoTable
local format = _G.string.format
local unLight = "ui_dfyw_xingxing_weidianliang"
local GetLangPackValue = _G.GetLangPackValue

local languageIds = {
    --胜率
    Rate = 90029400033,
    ---未上榜,
    UnRank = 90022900040,
    ---战报
    Battle = 90029400054,
    ---胜利
    Win = 90029400055,
    ---失败
    Fail = 90029400056
}
function ArenaPeakRank_RankView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self.minKingScore = 0
    self.DaShiScore = 0
    local cfgs = _G.ConfigManager.arena_peak_league_cfg
    for i = 1, #cfgs do
        if cfgs[i].rank_con > 0 then
            self.minKingScore = cfgs[i].min_score
            self.DaShiScore = cfgs[i - 1].min_score
        end
    end
end

---更新界面
function ArenaPeakRank_RankView:UpdateView()
    ---@param data arena_peak.s2c_arena_peak_rank
    require "ArenaPeakNet":GetInstance():GetRank(
        function(data)
            self.rankList = data.rank_list or {}
            if not self.inited then
                self.go_table.scrollloopvectical_rankList:InitItemData(
                    #self.rankList,
                    _G.handler(self, self.RefreshRankItem)
                )
                self.inited = true
            else
                self.go_table.scrollloopvectical_rankList:UpdateCount(#self.rankList)
            end
            self.go_table.obj_no:SetActiveE(#self.rankList == 0 and 1 or 0)
            --self:InitPlayer(data.rank_num)
        end
    )
end
---刷新排行榜
function ArenaPeakRank_RankView:RefreshRankItem(index, obj)
    ---@type _obj_Rank._obj_rankItem_GoTable
    local tb = GetAutoGoTable(obj)
    index = index + 1
    tb.aorimage_rankBg:SetActiveE(index <= 3 and 1 or 0)
    tb.obj_rankBg2:SetActiveE(index <= 3 and 0 or 1)
    if index <= 3 then
        tb.aorimage_rankBg.SpriteName = "tz_qjhs_di_0" .. (index + 1)
        tb.aorimage_rank.SpriteName = "tz_qjhs_phb_mingci_0" .. index
    else
        tb.aortext_rankNum.text = index
    end
    local data = self.rankList[index]
    tb.aortext_name.text = data.role_info.name
    tb.aortext_score.text = data.score
    if data.fights[1] == 0 then
        tb.aortext_winRate.text = GetLangPackValue(languageIds.Rate) .. "0%"
    else
        tb.aortext_winRate.text =
            GetLangPackValue(languageIds.Rate) ..
            _G.GameUtil.FormatNum(_G.math.floor(data.fights[2] / data.fights[1] * 1000) / 10) .. "%"
    end

    tb.aortext_kda.text =
        GetLangPackValue(languageIds.Battle, data.fights[1]) ..
        " " ..
            GetLangPackValue(languageIds.Win, data.fights[2]) ..
                " " .. GetLangPackValue(languageIds.Fail, data.fights[1] - data.fights[2])

    if data.is_king then
        tb.aorrawimage_icon:SetActiveE(1)
        tb.obj_star:SetActiveE(0)
        local cfg = ArenaPeakModel:GetInstance():GetDanCfgByScore(data.score)
        if cfg then
            tb.aorrawimage_icon:LoadImage(
                cfg.icon,
                function(raw)
                    if raw then
                        raw:SetNativeSize()
                    end
                end
            )
        end
    else
        tb.aorrawimage_icon:SetActiveE(0)
        tb.obj_star:SetActiveE(1)
        local score = data.score >= self.minKingScore and self.DaShiScore or data.score
        local quantity, art = ArenaPeakModel:GetInstance():GetStarByScore(score)
        if quantity then
            for i = 1, 3 do
                if i > quantity then
                    tb["aorimage_star" .. i].SpriteName = ArenaPeakModel:GetInstance():GetDefaultStarImage()
                else
                    tb["aorimage_star" .. i].SpriteName = art
                end
            end
        end
    end
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data.role_info, 1, true, false, false)
end

function ArenaPeakRank_RankView:InitPlayer(index)
    ---@type _obj_Rank._obj_rankItem_GoTable
    local tb = GetAutoGoTable(self.go_table.obj_player)
    if index == 0 then
        tb.aortext_rankNum.text = _G.LangUtil.GetLangPackValue(languageIds.UnRank)
    else
        tb.aortext_rankNum.text = index
    end
    local data = _G.PlayerModel:GetInstance():GetIRroleTable()
    tb.aortext_name.text = data.name
    tb.aortext_score.text = ArenaPeakModel:GetInstance():GetScore()
    local totalNum = ArenaPeakModel:GetInstance():GetTotalNum()
    local winNum = ArenaPeakModel:GetInstance():GetWinNum()
    local rate = totalNum == 0 and 0 or _G.math.floor(winNum / totalNum * 1000) / 10
    tb.aortext_winRate.text = GetLangPackValue(languageIds.Rate) .. _G.GameUtil.FormatNum(rate) .. "%"
    tb.aortext_kda.text =
        GetLangPackValue(languageIds.Battle, totalNum) ..
        " " .. GetLangPackValue(languageIds.Win, winNum) .. " " .. GetLangPackValue(languageIds.Fail, totalNum - winNum)
    local quantity, art = ArenaPeakModel:GetInstance():GetStarByScore(ArenaPeakModel:GetInstance():GetScore())
    if quantity then
        for i = 1, 3 do
            if i > quantity then
                tb["aorimage_star" .. i].SpriteName = art
            else
                tb["aorimage_star" .. i].SpriteName = unLight
            end
        end
    end
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data, 1, true, true, false)
end

