local ArenaPeakModel = require "ArenaPeakModel"
---@class ArenaPeakRank_RewardView : Component	中文描述
---@field go_table ArenaPeakRankView._obj_Reward_GoTable
local ArenaPeakRank_RewardView = _G.BaseClass("ArenaPeakRank_RewardView", _G.Component)

local CS = _G.CS
local typeof = _G.typeof
local GetAutoGoTable = _G.GetAutoGoTable
local GetLangPackValue = _G.GetLangPackValue
local unLight = "ui_dfyw_xingxing_weidianliang"
local kingId = 90029400057
function ArenaPeakRank_RewardView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, self.OnClickBtn)
end

---创建对象时,入口构造函数
function ArenaPeakRank_RewardView:OnCreate()
end

function ArenaPeakRank_RewardView:UpdateView()
    self.stageId = ArenaPeakModel:GetInstance().danID
    self.rewardList = _G.ConfigManager.arena_peak_league_cfg
    self.rewards = {}
    local seasonCfg = ArenaPeakModel:GetInstance():GetCfg()
    for _, v in pairs(seasonCfg.reward_season) do
        self.rewards[v[1]] = v[2]
    end
    self.count = #self.rewardList
    self.go_table.scrollloopvectical_itemList:InitItemData(self.count, _G.handler(self, self.RefreshAwardItem))
end

function ArenaPeakRank_RewardView:RefreshAwardItem(index, obj)
    ---@type _obj_Reward._obj_item_GoTable
    local tb = GetAutoGoTable(obj)
    local cfg = self.rewardList[self.count - index]
    tb.aortext_rank.text = GetLangPackValue(cfg.name)
    tb.aortext_score.text = cfg.min_score
    if cfg.rank_con > 0 then
        tb.obj_star:SetActiveE(0)
        tb.aortext_score.text =cfg.min_score .. "\n" .. GetLangPackValue(kingId, cfg.rank_con)
    else
        tb.obj_star:SetActiveE(1)
        local quantity, art = ArenaPeakModel:GetInstance():GetStarByScore(cfg.min_score)
        if quantity then
            for i = 1, 3 do
                if i > quantity then
                    tb["aorimage_star" .. i].SpriteName = ArenaPeakModel:GetInstance():GetDefaultStarImage()
                else
                    tb["aorimage_star" .. i].SpriteName = art
                end
            end
        end
    end
    tb.aorrawimage_icon:LoadImage(
        cfg.icon,
        function(raw)
            if raw then
                raw:SetNativeSize()
            end
        end
    )
    tb.trans_Content:ClearChildren()
    local rewards = _G.ConfigManager.arena_peak_tier_cfg[self.rewards[self.count - index]].reward_season
    for i = 1, #rewards do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            rewards[i],
            tb.trans_Content,
            function(item)
                if _G.IsNil(self.go_table) then
                    _G.DestroyObject(item.gameObject)
                    return
                end
                if item.ShowNumText then
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
            end
        )
    end
    tb.obj_cur:SetActiveE(self.stageId == cfg.id and 1 or 0)
end

---销毁对象时,析构函数
function ArenaPeakRank_RewardView:OnDestroy()
end

function ArenaPeakRank_RewardView:OnClickBtn()
end

return ArenaPeakRank_RewardView
