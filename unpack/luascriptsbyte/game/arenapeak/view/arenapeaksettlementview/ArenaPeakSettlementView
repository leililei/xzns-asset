local ArenaPeakModel = require("ArenaPeakModel")
local ArenaPeakNet = require("ArenaPeakNet")
local SettlementModel = require "SettlementModel"
local SettlementBaseView = require "SettlementBaseView"
---@class ArenaPeakSettlementView : UIBaseView    中文描述
---@field public go_table ArenaPeakSettlementView_GoTable GoTable
local ArenaPeakSettlementView = _G.BaseClass("ArenaPeakSettlementView", SettlementBaseView)

local GetAutoGoTable = _G.GetAutoGoTable
local UIUtils = _G.UIUtils

function ArenaPeakSettlementView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param result arena_peak.s2c_arena_peak_fight|arena_peak.s2c_arena_peak_give_up
function ArenaPeakSettlementView:OnCreateChild(result)
    self.data = result
    self.fight_arg = result.fight_arg
    self.result = result.reports
    self.isWin = result.reports.winner
    self.playback_uid = result.reports.playback_uid
    self.reportType = 7
    self:InitView()
    if result.award then
        local today, scoreLimit, medalLimit = ArenaPeakModel:GetInstance():GetScoreAndMedalMax()
        local medalNum = ArenaPeakModel:GetInstance():GetCoin()
        local content = _G.GetLangPackValue(90029400105, medalNum, medalLimit)
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CommonAwardView.Name,
            result,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            content
        )
    end
    if self.playback_uid ~= 0 then
        ArenaPeakNet:GetInstance():Playback(
            {playback_uid = self.playback_uid},
            function(msg)
                if msg.ack == 1 then
                    self.roomInfo = msg.room_info
                end
            end
        )
    end
    local isHosting = ArenaPeakModel:GetInstance():GetHosting()
    if isHosting then
        self.countDown = 3
        self.go_table.aortext_tip.text = _G.GetLangPackValue(90029400196, _G.Mathf.RoundToInt(self.countDown))
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.timer:Start()
        _G.DelayDo(
            1,
            function()
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name)
            end
        )
    else
        self.go_table.aortext_tip.text = _G.GetLangPackValue(90027000010)
    end
end

---更新时间
function ArenaPeakSettlementView:UpdateTime(elapsed)
    if self:IsNil() then
        return
    end
    if self.countDown <= 0 then
        self:CloseCall(SettlementModel.FunctionEnum.None)
        return
    end
    self.countDown = self.countDown - elapsed
    self.go_table.aortext_tip.text = _G.GetLangPackValue(90029400196, _G.Mathf.RoundToInt(self.countDown))
end

---@private
function ArenaPeakSettlementView:InitView()
    local PlayerModel = _G.PlayerModel:GetInstance()
    local CardInfoManager = require("CardInfoManager")
    self.go_table.aorbtn_statistics:SetActiveE(self.playback_uid == 0 and 0 or 1)
    self.go_table.obj_win:SetActiveE(self.isWin and 1 or 0)
    self.go_table.obj_lose:SetActiveE(self.isWin and 0 or 1)
    ---@type ArenaPeakSettlementView._obj_mine_GoTable
    local tbMy = GetAutoGoTable(self.go_table.obj_mine)
    ---@type ArenaPeakSettlementView._obj_enemy_GoTable
    local tbEnemy = GetAutoGoTable(self.go_table.obj_enemy)
    local info = {}
    info.style = PlayerModel:GetRoleStyle()
    info.frame = PlayerModel:GetCurFrame()
    info.title = PlayerModel:GetTitle()
    UIUtils.SetPlayerHeadItemNew(tbEnemy.obj_HeadItemBase, self.result, 0.65, true, true, false)
    UIUtils.SetPlayerHeadItemNew(tbMy.obj_HeadItemBase, info, 0.65, true, true, false)
    tbEnemy.aortext_name.text = self.result.role_name
    tbEnemy.aortext_score.text = self.result.rival_new_score
    tbMy.aortext_name.text = PlayerModel:GetName()
    tbMy.aortext_score.text = self.result.new_score
    if self.isWin then
        tbEnemy.aortext_change.text = "-" .. self.result.rival_score
        tbEnemy.aortext_change.color = CardInfoManager.GetColorFromRGB("FF6969")
        tbEnemy.aorimage_Arrow.SpriteName = "ui_srjs_sb_icon4"
        tbMy.aortext_change.text = "+" .. self.result.score
        tbMy.aortext_change.color = CardInfoManager.GetColorFromRGB("7AD578")
        tbMy.aorimage_Arrow.SpriteName = "ui_srjs_sl_icon"
    else
        tbEnemy.aortext_change.text = "+" .. self.result.rival_score
        tbEnemy.aortext_change.color = CardInfoManager.GetColorFromRGB("7AD578")
        tbEnemy.aorimage_Arrow.SpriteName = "ui_srjs_sl_icon"
        tbMy.aortext_change.text = "-" .. self.result.score
        tbMy.aortext_change.color = CardInfoManager.GetColorFromRGB("FF6969")
        tbMy.aorimage_Arrow.SpriteName = "ui_srjs_sb_icon4"
    end
    local rivalIsKing = ArenaPeakModel:GetInstance():CheckDanIsKing(self.result.rival_dan)
    local isKing = ArenaPeakModel:GetInstance():CheckDanIsKing(self.result.dan)
    ArenaPeakModel:GetInstance():ShowDan(tbEnemy.obj_dan, self.result.rival_new_score, false, rivalIsKing)
    ArenaPeakModel:GetInstance():ShowDan(tbMy.obj_dan, self.result.new_score, false, isKing)
    self:UpdateData(_G.BattleManager:GetInstance():GetStatisticsRecord(self.fight_arg))
    UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_Arenahuoxing,
        self.go_table.obj_eff,
        function(trans1)
            if self:IsNil() then
                UIUtils.RemoveEffect(trans1)
                return
            end
        end
    )
end

local SetOtherPlayer = function(data)
    local otherPlayer = {}
    otherPlayer.frame = data.frame
    otherPlayer.name = data.role_name
    otherPlayer.lv = data.role_lv
    otherPlayer.style = data.style
    otherPlayer.title = data.title
    return otherPlayer
end

function ArenaPeakSettlementView:InitData(data)
    local tb = {}
    for i = 1, self.maxCount do
        local tempData = data.FighterInfo[i]
        local temp = {}
        temp.AtkUid = data.AtkUid
        temp.DefUid = data.DefUid
        temp.statisticsMax = {DmgOut = 1, DmgIn = 1, HpRecover = 1, CreateGuard = 1}
        temp.statisticsData = tempData
        for j = 1, #tempData.Attacker do
            if temp.statisticsMax.DmgOut < tempData.Attacker[j].DmgOut then
                temp.statisticsMax.DmgOut = tempData.Attacker[j].DmgOut
            end

            if temp.statisticsMax.DmgIn < tempData.Attacker[j].DmgIn then
                temp.statisticsMax.DmgIn = tempData.Attacker[j].DmgIn
            end

            if temp.statisticsMax.HpRecover < tempData.Attacker[j].HpRecover then
                temp.statisticsMax.HpRecover = tempData.Attacker[j].HpRecover
            end
            if temp.statisticsMax.CreateGuard < tempData.Attacker[j].CreateGuard then
                temp.statisticsMax.CreateGuard = tempData.Attacker[j].CreateGuard
            end
        end
        for j = 1, #tempData.Defender do
            if temp.statisticsMax.DmgOut < tempData.Defender[j].DmgOut then
                temp.statisticsMax.DmgOut = tempData.Defender[j].DmgOut
            end

            if temp.statisticsMax.DmgIn < tempData.Defender[j].DmgIn then
                temp.statisticsMax.DmgIn = tempData.Defender[j].DmgIn
            end

            if temp.statisticsMax.HpRecover < tempData.Defender[j].HpRecover then
                temp.statisticsMax.HpRecover = tempData.Defender[j].HpRecover
            end
            if temp.statisticsMax.CreateGuard < tempData.Defender[j].CreateGuard then
                temp.statisticsMax.CreateGuard = tempData.Defender[j].CreateGuard
            end
        end
        temp.CombMax = {DmgOut = 1, CreateGuard = 1, HpRecover = 1}
        for j = 1, #tempData.AtkCombineSkills[1] do
            if temp.CombMax.DmgOut < tempData.AtkCombineSkills[1][j].DmgOut then
                temp.CombMax.DmgOut = tempData.AtkCombineSkills[1][j].DmgOut
            end

            if temp.CombMax.CreateGuard < tempData.AtkCombineSkills[1][j].CreateGuard then
                temp.CombMax.CreateGuard = tempData.AtkCombineSkills[1][j].CreateGuard
            end

            if temp.CombMax.HpRecover < tempData.AtkCombineSkills[1][j].HpRecover then
                temp.CombMax.HpRecover = tempData.AtkCombineSkills[1][j].HpRecover
            end
        end
        for j = 1, #tempData.DefCombineSkills[1] do
            if temp.CombMax.DmgOut < tempData.DefCombineSkills[1][j].DmgOut then
                temp.CombMax.DmgOut = tempData.DefCombineSkills[1][j].DmgOut
            end

            if temp.CombMax.CreateGuard < tempData.DefCombineSkills[1][j].CreateGuard then
                temp.CombMax.CreateGuard = tempData.DefCombineSkills[1][j].CreateGuard
            end

            if temp.CombMax.HpRecover < tempData.DefCombineSkills[1][j].HpRecover then
                temp.CombMax.HpRecover = tempData.DefCombineSkills[1][j].HpRecover
            end
        end
        temp.PetMax = {DmgOut = 1, CreateGuard = 1, HpRecover = 1}
        for j = 1, #tempData.AtkPetSkills[1] do
            if temp.PetMax.DmgOut < tempData.AtkPetSkills[1][j].DmgOut then
                temp.PetMax.DmgOut = tempData.AtkPetSkills[1][j].DmgOut
            end

            if temp.PetMax.CreateGuard < tempData.AtkPetSkills[1][j].CreateGuard then
                temp.PetMax.CreateGuard = tempData.AtkPetSkills[1][j].CreateGuard
            end

            if temp.PetMax.HpRecover < tempData.AtkPetSkills[1][j].HpRecover then
                temp.PetMax.HpRecover = tempData.AtkPetSkills[1][j].HpRecover
            end
        end
        for j = 1, #tempData.DefPetSkills[1] do
            if temp.PetMax.DmgOut < tempData.DefPetSkills[1][j].DmgOut then
                temp.PetMax.DmgOut = tempData.DefPetSkills[1][j].DmgOut
            end

            if temp.PetMax.CreateGuard < tempData.DefPetSkills[1][j].CreateGuard then
                temp.PetMax.CreateGuard = tempData.DefPetSkills[1][j].CreateGuard
            end

            if temp.PetMax.HpRecover < tempData.DefPetSkills[1][j].HpRecover then
                temp.PetMax.HpRecover = tempData.DefPetSkills[1][j].HpRecover
            end
        end
        temp.TeamIndex = tempData.TeamIndex
        _G.table.insert(tb, temp)
    end
    return tb
end

---@param data table 伤害数据
function ArenaPeakSettlementView:UpdateData(data)
    if not data then
        _G.PopWindowManager:GetInstance():ShowAllTips(540302)
        return
    end
    if not self.roomInfo then
        return
    end
    self.winnerTable = self.result.winner and {0} or {1}
    self.otherPlayer = SetOtherPlayer(self.result)
    self.maxCount = _G.table.count(data.FighterInfo)
    self.PveData = self:InitData(data)
    self:GetMvp()
end

---@private
function ArenaPeakSettlementView:PlayBPReply(callback)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaPeakPlaybackView.Name, self.roomInfo, callback)
end

function ArenaPeakSettlementView:GetMvp()
    local dataList = self.PveData.statisticsData.Attacker
    if dataList ~= nil then
        local score = 0
        local index = 0
        for i = 1, #dataList do
            local data = dataList[i]
            local count = data.CreateGuard + data.DmgIn + data.DmgOut + data.HpRecover
            if count > score then
                score = count
                index = i
            end
        end
        if index ~= 0 then
            local cardData = dataList[index]
            local rolePath = _G.ConfigManager.card_cfg[cardData.sid].ModelPathHi
            require("CardInfoManager").GetRole(
                    rolePath,
                    _G.ePoolType.UIItem,
                    self.go_table.trans_Mvp,
                    _G.RoleEffTypeEnum.RoleShow,
                    function(trans)
                        if trans == nil then
                            if _G.AppSetting.DEBUG then
                                _G.LogError("角色无法加载 path:" .. rolePath .. "    CardInfoself LoadRoleScene")
                            end
                            return
                        end
                        local myCard_show_cfg =
                        _G.ConfigManager.card_show_cfg[cardData.skin] or
                                _G.ConfigManager.card_show_cfg[cardData.sid]
                        if myCard_show_cfg == nil then
                            if _G.AppSetting.DEBUG then
                                _G.LogError("card_show_cfg 未找到配置 sid:" .. cardData.sid)
                            end
                        end

                        -- --设置  缩放
                        local scale = myCard_show_cfg and myCard_show_cfg.size4 or 1
                        trans:SetLocalScaleXYZ(scale)
                    end
            )
        end
    end
end

---界面的销毁函数
function ArenaPeakSettlementView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---按钮点击事件在这里派发
function ArenaPeakSettlementView:OnClickBtn(go)
    if go == self.go_table.aorbtn_bg or go == self.go_table.aorbtn_close then
        self:CloseCall(SettlementModel.FunctionEnum.None)
    elseif go == self.go_table.aorbtn_statistics then
        _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name,
                self.PveData,
                self.winnerTable,
                nil,
                nil,
                self.otherPlayer,
                1,
                true,
                self.fight_arg,
                nil,
                {self.playback_uid},
                self.reportType,
                nil,
                nil,
                nil,
                nil,
                nil,
                nil,
                nil,
                true,
                _G.handler(self, self.PlayBPReply)
        )
    end
end

return ArenaPeakSettlementView
