--region 普通竞技场
local resultArrow = {
    win = "ui_js_kehun_frame_shengjitishi",
    lose = "ui_js_kehun_frame_shengjitishi2"
}
local scoreStr = {win = "+%d", lose = "-%d", zero = "%d"}
function ArenaPeakReportItem:OnShow(data)
    self.reportType = 7

    self.winnertable = data.winner and {0} or {1}
    local format = _G.string.format
    if self.winner then
        self.go_table.aortext_score.text =
            format(
            _G.LangUtil.GetLangPackValue(90022100040),
            data.score == 0 and format(scoreStr.zero, data.score) or format(scoreStr.win, data.score)
        )
    else
        self.go_table.aortext_score.text =
            format(
            _G.LangUtil.GetLangPackValue(90022100090),
            data.score == 0 and format(scoreStr.zero, data.score) or format(scoreStr.lose, data.score)
        )
    end
    self.go_table.aortext_name.text = data.role_name
    self.go_table.aorimage_arrow.SpriteName = self.winner and resultArrow.win or resultArrow.lose
end

--endregion
---@class ArenaPeakReportView : UIBaseView	中文描述
---@field public go_table ArenaPeakReportPanelView_GoTable GoTable
local ArenaPeakReportView = _G.BaseClass("ArenaPeakReportView", _G.UIBaseView)

function ArenaPeakReportView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
end

---界面的入口函数
function ArenaPeakReportView:OnCreate(sid)
    self.itemTransDic = {}
    self.go_table.scrollloopvectical_report:InitItemData(0, _G.handler(self, self.RefreshItem))
    ArenaPeakNet:GetInstance():GetReport(_G.handler(self, self.ShowReport))
    self:AddListener(_G.eBattleState.RecordStart, self.OnRecordStart)
    self:AddListener(_G.eBattleState.RecordEnd, self.OnRecordEnd)
end

function ArenaPeakReportView:OnRecordStart()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ArenaPanelView.Name)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ArenaPeakView.Name)
end
function ArenaPeakReportView:OnRecordEnd()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ArenaPanelView.Name)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ArenaPeakView.Name)
end
function ArenaPeakReportView:OnDestroy()
    if self.itemTransDic then
        for _, value in pairs(self.itemTransDic) do
            value:Dispose()
        end
    end
end
---按钮点击事件在这里派发
function ArenaPeakReportView:OnClickBtn(go)
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
    self:Close()
end
---@param list arena_peak.s2c_arena_peak_report
function ArenaPeakReportView:ShowReport(list)
    if list.ack ~= 1 then
        self:Close()
        return
    end
    self.reportList = list.reports or {}
    local count = #self.reportList or 0
    self.go_table.obj_emptybg:SetActiveE(count == 0 and 1 or 0)
    self.go_table.scrollloopvectical_report:UpdateCount(count)
end

function ArenaPeakReportView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    local instanceID = obj:GetInstanceIDE()
    if not self.itemTransDic[instanceID] then
        self.itemTransDic[instanceID] = ArenaPeakReportItem.New(obj)
    end
    index = index + 1
    self.itemTransDic[instanceID]:Show(self.reportList[index])
end
return ArenaPeakReportView
