---@param info arena_peak.i_room_role
function ArenaPeakMateView:ShowRole(obj, info)
    ---@type ArenaPeakMateView._obj_mine_GoTable|ArenaPeakMateView._obj_enemy_GoTable
    local tb = GetAutoGoTable(obj)
    tb.aortext_name.text = info.role_name
    tb.aortext_guild.text =
        GetLangPackValue(90022500401, info.guild_name ~= "" and info.guild_name or GetLangPackValue(90021300086))
    tb.aortext_score.text = info.score
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, info, 0.7, true, true, false)
    ArenaPeakModelIns:ShowDan(tb.obj_dan, info.score, true, ArenaPeakModelIns:CheckDanIsKing(info.dan))
end

---@private
function ArenaPeakMateView:UpdateTime(elapsed)
    self.countDown = self.countDown - elapsed
    if self.countDown <= 0 then
        self.go_table.aortext_countDown.text = ""
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        --self:Close()
        ArenaPeakModelIns:OnChallenge(self.roomInfo)
    elseif self.countDown <= 3 then
        self.go_table.aortext_countDown:SetActiveE(1)
        self.go_table.aortext_countDown.text = math.ceil(self.countDown)
        self.go_table.obj_vs:SetActiveE(0)
        self.go_table.obj_eff1:SetActiveE(0)
        self.numAni:Play("a_Middle_once")
        _G.AudioManager.PlayAudioByAudioCfgID(2050)
        _G.DelayDo(
            0.133,
            function()
                self.go_table.obj_eff1:SetActiveE(1)
            end
        )
    end
end

---@private
function ArenaPeakMateView:OnBPViewOpened(name)
    if name == ConfigManager.ui_cfg.ArenaPeakBPView.Name then
        self:Close()
    end
end

---界面的销毁函数
function ArenaPeakMateView:OnDestroy()
    EventsIns:RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnBPViewOpened, self)
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---按钮点击事件在这里派发
function ArenaPeakMateView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end

return ArenaPeakMateView
