local ArenaPeakModel = require("ArenaPeakModel")
local ArenaPeakModelIns = ArenaPeakModel:GetInstance()

---@class ArenaPeakPromotionView : UIBaseView    中文描述
---@field public go_table ArenaPeakPromotionView_GoTable GoTable
---@field curModel number 当前模式(1排位赛2友谊赛)
local ArenaPeakPromotionView = _G.BaseClass("ArenaPeakPromotionView", _G.UIBaseView)
local UIUtils = _G.UIUtils

function ArenaPeakPromotionView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArenaPeakPromotionView:OnCreate(score, isKing)
    ArenaPeakModelIns:ShowDan(self.go_table.obj_dan, score, true, isKing)
    self:ShowEffect()
end

---显示特效
function ArenaPeakPromotionView:ShowEffect()
    self.isLoad = true
    UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_ArenaPeakPromotionView_once,
        self.go_table.trans_mid,
        function(obj)
            if self:IsNil() then
                UIUtils.RemoveEffect(obj)
                return
            end
        end,
        function(obj)
            UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_ArenaPeakPromotionView_chendi,
                self.go_table.trans_mid,
                function(obj)
                    if self:IsNil() then
                        UIUtils.RemoveEffect(obj)
                        return
                    end
                    self.effect = obj
                end
            )
        end
    )
    UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_ArenaPeakPromotionView_title,
        self.go_table.trans_top,
        function(obj)
            if self:IsNil() then
                UIUtils.RemoveEffect(obj)
                return
            end
        end
    )
end

---界面的销毁函数
function ArenaPeakPromotionView:OnDestroy()
end

---按钮点击事件在这里派发
function ArenaPeakPromotionView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

return ArenaPeakPromotionView
