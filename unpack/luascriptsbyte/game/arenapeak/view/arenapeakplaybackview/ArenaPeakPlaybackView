local ArenaPeakModel = require("ArenaPeakModel")

---@class ArenaPeakPlaybackView : UIBaseView    中文描述
---@field public go_table ArenaPeakPlaybackView_GoTable GoTable
---@field roomInfo arena_peak.i_room
---@field tbMy ArenaPeakPlaybackView._obj_mine_GoTable
---@field tbEy ArenaPeakPlaybackView._obj_enemy_GoTable
---@field myCardsInfo arena_peak.i_room_card[] 我方卡牌详细信息
---@field eyCardsInfo arena_peak.i_room_card[] 敌方卡牌详细信息
local ArenaPeakPlaybackView = _G.BaseClass("ArenaPeakPlaybackView", _G.UIBaseView)

local GetLangPackValue = _G.GetLangPackValue
local ConfigManager = _G.ConfigManager
local UIManager = _G.UIManager:GetInstance()
local GetAutoGoTable = _G.GetAutoGoTable
local SetActiveByCondition = _G.GameUtil.SetActiveByCondition
local TimeUtil = _G.TimeUtil
local UIUtils = _G.UIUtils
local Step = ArenaPeakModel.Step

function ArenaPeakPlaybackView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArenaPeakPlaybackView:OnCreate(roomInfo, callback)
    self.callback = callback
    self.roomInfo = roomInfo
    self.isFirst = roomInfo.is_first
    self.my = roomInfo.is_first and "a" or "b"
    self.ey = roomInfo.is_first and "b" or "a"
    self.myCardsInfo = roomInfo["choose_card_" .. self.my] or {}
    self.eyCardsInfo = roomInfo["choose_card_" .. self.ey] or {}
    self.myCardItems = {}
    self.eyCardItems = {}
    self.combSkillUnLock = {
        [1] = {0, 0, 0},
        [2] = {0, 0, 0}
    }
    self.combineIndex = 1
    _G.table.sort(
        self.myCardsInfo,
        function(a, b)
            return a.index < b.index
        end
    )
    _G.table.sort(
        self.eyCardsInfo,
        function(a, b)
            return a.index < b.index
        end
    )
    self.step = 1
    self:InitView()
    self:FirstStepEffect()
    self.timer = _G.TimerManager:GetInstance():GetTimer(3, self.ShowByStep, self, true, false, true)
    self.timer:Start()
end

---@private
function ArenaPeakPlaybackView:InitView()
    self.tbMy = GetAutoGoTable(self.go_table.obj_mine)
    self.tbEy = GetAutoGoTable(self.go_table.obj_enemy)
    self:ShowRole(self.tbMy, self.my)
    self:ShowRole(self.tbEy, self.ey)
    self:InitCombSkill()
    self:ShowCombSkill()
end

---@private
---@param tb ArenaPeakPlaybackView._obj_mine_GoTable
function ArenaPeakPlaybackView:ShowRole(tb, ab)
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, self.roomInfo["role_info_" .. ab], 0.7, true, true, false)
    local isKing = ArenaPeakModel:GetInstance():CheckDanIsKing(self.roomInfo["role_info_" .. ab].dan)
    ArenaPeakModel:GetInstance():ShowDan(tb.obj_dan, self.roomInfo["role_info_" .. ab].score, false, isKing)
    tb.aortext_name.text = self.roomInfo["role_info_" .. ab].role_name
    tb.aortext_score.text = self.roomInfo["role_info_" .. ab].score
end

---@private
function ArenaPeakPlaybackView:FirstStepEffect()
    local indexes = {1}
    local obj
    for _, v in pairs(indexes) do
        if self:IsMyTurn() then
            obj = self.tbMy["obj_eff" .. v]
        else
            obj = self.tbEy["obj_eff" .. v]
        end
        UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_ArenaPeakBPView_daitianjia,
            obj,
            function(trans)
                if self:IsNil() then
                    UIUtils.RemoveEffect(trans)
                    return
                end
            end
        )
    end
    UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_ArenaPeakPlaybackViewBG,
        self.go_table.obj_midEff,
        function(trans)
            if self:IsNil() then
                UIUtils.RemoveEffect(trans)
                return
            end
        end
    )
end

---@private
function ArenaPeakPlaybackView:ShowByStep()
    local check = function(trans)
        if self:IsNil() then
            UIUtils.RemoveEffect(trans)
            return
        end
    end
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    ---@type ItemCardAllView
    local cardItem
    ---@type arena_peak.i_room_card
    local card
    local waitTime = 3
    if self.step < Step.Ban then
        local indexes = self:GetIndexByStep()
        local obj
        for _, v in pairs(indexes) do
            if self:IsMyTurn() then
                cardItem = require("ItemCardAllView").New(self.tbMy["obj_card" .. v])
                card = self.myCardsInfo[v]
                self.myCardItems[v] = cardItem
                self.tbMy["obj_card" .. v]:SetActiveE(1)
                obj = self.tbMy["obj_eff" .. v]
            else
                cardItem = require("ItemCardAllView").New(self.tbEy["obj_card" .. v])
                card = self.eyCardsInfo[v]
                self.eyCardItems[v] = cardItem
                self.tbEy["obj_card" .. v]:SetActiveE(1)
                obj = self.tbEy["obj_eff" .. v]
            end
            cardItem.skinId = card.skin_id

            if card.skin_id and card.skin_id ~= 0 then
                cardItem:Show(card.skin_id, nil, card.card_star, card.soul_lv, card.card_lv, 0, true, card.soul_state, card.born_skill_num)
            else
                cardItem:Show(card.card_sid, nil, card.card_star, card.soul_lv, card.card_lv, 0, false, card.soul_state, card.born_skill_num)
            end

            obj:ClearChildren()
            UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_shangzhenchenggong, obj, check)
            UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_ArenaPeakPlaybackView_icon, obj, check)
        end
        if self.step < Step.Ban - 1 then
            indexes = self:GetIndexByNextStep()
            for _, v in pairs(indexes) do
                if self:IsMyTurn() then
                    obj = self.tbEy["obj_eff" .. v]
                else
                    obj = self.tbMy["obj_eff" .. v]
                end
                UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_ArenaPeakBPView_daitianjia, obj, check)
            end
        end
    elseif self.step == Step.Ban then
        self.myCardItems[self.roomInfo["ban_index_" .. self.my]].go_table.obj_ban:SetActiveE(1)
        self.eyCardItems[self.roomInfo["ban_index_" .. self.ey]].go_table.obj_ban:SetActiveE(1)
    elseif self.step == Step.Array then
        self.tbMy["obj_card" .. 3]:SetActiveE(0)
        self.tbEy["obj_card" .. 3]:SetActiveE(0)
        self.tbMy.aorimage_cardBg3:SetActiveE(0)
        self.tbEy.aorimage_cardBg3:SetActiveE(0)
        local index
        for i = 1, 5 do
            index = i
            if i > 2 then
                index = index + 1
            end
            card = self:GetRoomCardByID(self.roomInfo["sits_" .. self.my][i], true)

            if card.skin_id and card.skin_id ~= 0 then
                self.myCardItems[index]:Show(card.skin_id, nil, card.card_star, card.soul_lv, card.card_lv, 0, true, card.soul_state, card.born_skill_num)
            else
                self.myCardItems[index]:Show(card.card_sid, nil, card.card_star, card.soul_lv, card.card_lv, 0, false, card.soul_state, card.born_skill_num)
            end
            --   self.myCardItems[index]:Show(card.card_sid, nil, card.card_star, 0, card.card_lv, nil, skin)
            self.myCardItems[index].go_table.obj_ban:SetActiveE(0)
            card = self:GetRoomCardByID(self.roomInfo["sits_" .. self.ey][i], false)
            if card.skin_id and card.skin_id ~= 0 then
                self.eyCardItems[index]:Show(card.skin_id, nil, card.card_star, card.soul_lv, card.card_lv, 0, true, card.soul_state, card.born_skill_num)
            else
                self.eyCardItems[index]:Show(card.card_sid, nil, card.card_star, card.soul_lv, card.card_lv, 0, false, card.soul_state, card.born_skill_num)
            end
            -- self.eyCardItems[index]:Show(card.card_sid, nil, card.card_star, 0, card.card_lv, nil, skin)
            self.eyCardItems[index].go_table.obj_ban:SetActiveE(0)
        end
    elseif self.step == Step.Combine then
        self.timerComb = _G.TimerManager:GetInstance():GetTimer(1, self.AddCombine, self, false, false, true)
        self.timerComb:Start()
        self.step = self.step + 1
        return
    elseif self.step == Step.Ready then
        self.countDownTime = 3
        self.go_table.obj_vs:SetActiveE(0)
        self.go_table.aortext_countDown.text = self.countDownTime
        self.timerComb = _G.TimerManager:GetInstance():GetTimer(1, self.CountDown, self, false, false, true)
        self.timerComb:Start()
        self.step = self.step + 1
        return
    elseif self.step == Step.Ready + 1 then
        if self.callback then
            self.callback()
        end
        self:Close()
        return
    end
    self.step = self.step + 1
    self.timer = _G.TimerManager:GetInstance():GetTimer(waitTime, self.ShowByStep, self, true, false, true)
    self.timer:Start()
end

---@private
function ArenaPeakPlaybackView:GetRoomCardByID(id, isMy)
    local cardInfo = isMy and self.myCardsInfo or self.eyCardsInfo
    for _, v in pairs(cardInfo) do
        if id == v.card_sid or id == v.card_uid then
            return v
        end
    end
    return nil
end

---@private
function ArenaPeakPlaybackView:GetIndexByStep()
    local indexes = {}
    if self.step == Step.Choose1 then
        indexes = {1}
    elseif self.step == Step.Choose2 then
        indexes = {1, 2}
    elseif self.step == Step.Choose3 then
        indexes = {2, 3}
    elseif self.step == Step.Choose4 then
        indexes = {3, 4}
    elseif self.step == Step.Choose5 then
        indexes = {4, 5}
    elseif self.step == Step.Choose6 then
        indexes = {5, 6}
    elseif self.step == Step.Choose7 then
        indexes = {6}
    end
    return indexes
end

---@private
function ArenaPeakPlaybackView:GetIndexByNextStep()
    local indexes = {}
    if self.step == Step.Choose1 then
        indexes = {1, 2}
    elseif self.step == Step.Choose2 then
        indexes = {2, 3}
    elseif self.step == Step.Choose3 then
        indexes = {3, 4}
    elseif self.step == Step.Choose4 then
        indexes = {4, 5}
    elseif self.step == Step.Choose5 then
        indexes = {5, 6}
    elseif self.step == Step.Choose6 then
        indexes = {6}
    end
    return indexes
end

---是否是我的操作轮次
function ArenaPeakPlaybackView:IsMyTurn()
    local remainder = self.isFirst and 1 or 0
    return self.step >= Step.Ban or self.step % 2 == remainder
end

---@private
function ArenaPeakPlaybackView:AddCombine()
    for i = 1, self.combineIndex do
        if i > 3 then
            break
        end
        self.combSkillUnLock[1][i] = ConfigManager.combine_cfg[self.roomInfo["combine_" .. self.my][i]].skills[1]
        self.combSkillUnLock[2][i] = ConfigManager.combine_cfg[self.roomInfo["combine_" .. self.ey][i]].skills[1]
    end
    self.combineIndex = self.combineIndex + 1
    self:ShowCombSkill()
    if self.combineIndex > 3 then
        if self.timerComb then
            self.timerComb:Stop()
            self.timerComb = nil
        end
        self:ShowByStep()
    end
end

---@private
function ArenaPeakPlaybackView:CountDown()
    self.countDownTime = self.countDownTime - 1
    if self.countDownTime == 0 then
        self:ShowByStep()
        return
    end
    self.go_table.aortext_countDown.text = self.countDownTime
end

---初始化合击技
