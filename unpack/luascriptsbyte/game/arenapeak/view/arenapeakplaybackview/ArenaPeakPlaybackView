        self.go_table_skill = GetAutoGoTable(tb[i].obj_combSkill)
        self.skillItems[i] = {
            {
                btngo = self.go_table_skill.aorbtn_1,
                go = self.go_table_skill.obj_combGO1,
                icon = self.go_table_skill.aorrawimage_icon1,
                text = self.go_table_skill.aortext_type1,
                lock = self.go_table_skill.obj_lock1,
                redpoint = self.go_table_skill.obj_redpoint1,
                typeText = self.go_table_skill.aortext_type11,
                typeObj = self.go_table_skill.obj_type1,
                condition = self.go_table_skill.aortext_condition1
            },
            {
                btngo = self.go_table_skill.aorbtn_2,
                go = self.go_table_skill.obj_combGO2,
                icon = self.go_table_skill.aorrawimage_icon2,
                text = self.go_table_skill.aortext_type2,
                lock = self.go_table_skill.obj_lock2,
                redpoint = self.go_table_skill.obj_redpoint2,
                typeText = self.go_table_skill.aortext_type21,
                typeObj = self.go_table_skill.obj_type2,
                condition = self.go_table_skill.aortext_condition2
            },
            {
                btngo = self.go_table_skill.aorbtn_3,
                go = self.go_table_skill.obj_combGO3,
                icon = self.go_table_skill.aorrawimage_icon3,
                text = self.go_table_skill.aortext_type3,
                lock = self.go_table_skill.obj_lock3,
                redpoint = self.go_table_skill.obj_redpoint3,
                typeText = self.go_table_skill.aortext_type31,
                typeObj = self.go_table_skill.obj_type3,
                condition = self.go_table_skill.aortext_condition3
            }
        }
    end
end

---合击技技能显示
function ArenaPeakPlaybackView:ShowCombSkill()
    local cfg, lv, id
    for index = 1, 2 do
        for i = 1, 3 do
            if self.combSkillUnLock[index][i] then
                self.skillItems[index][i].lock:SetActiveE(0)
                self.skillItems[index][i].typeObj:SetActiveE(1)
                if self.combSkillUnLock[index][i] > 0 then
                    self.skillItems[index][i].go:SetActiveE(1)
                    cfg = ConfigManager.card_skills_cfg[self.combSkillUnLock[index][i]]
                    self.skillItems[index][i].icon:LoadImage(
                        cfg.icon,
                        function(rawimage)
                            rawimage:SetNativeSize()
                        end
                    )
                    cfg = ConfigManager.battle_skill_cfg[cfg.skills[1]]
                    self.skillItems[index][i].text.text = ConfigManager.language_package_cfg[cfg.Brief]
                    self.skillItems[index][i].redpoint:SetActiveE(0)
                else
                    self.skillItems[index][i].go:SetActiveE(0)
                    _G.GameUtil.SetActiveByCondition(self.skillItems[index][i].redpoint, false)
                end
                self.skillItems[index][i].typeText.text = GetLangPackValue(ConfigManager.discrete_cfg[105003][1][i])
            else
                self.skillItems[index][i].go:SetActiveE(0)
                self.skillItems[index][i].lock:SetActiveE(1)
                self.skillItems[index][i].redpoint:SetActiveE(0)
                self.skillItems[index][i].typeObj:SetActiveE(0)
                self.skillItems[index][i].condition:SetActiveE(0)
            end
        end
    end
end

---界面的销毁函数
function ArenaPeakPlaybackView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.timerComb then
        self.timerComb:Stop()
        self.timerComb = nil
    end
end

---按钮点击事件在这里派发
function ArenaPeakPlaybackView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close2 then
        if self.step == Step.Ready then
            self.combineIndex = 3
            self:AddCombine()
        else
            self:ShowByStep()
        end
    end
end

return ArenaPeakPlaybackView
