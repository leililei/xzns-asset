local JoinActivityDrawUpBattlePassData = require("JoinActivityDrawUpBattlePassData")
local ActivitySynManager = require("ActivitySynManager")

---@class JoinActivityDrawUpBattlePassData2: JoinActivityDrawUpBattlePassData    中文描述
local JoinActivityDrawUpBattlePassData2 = _G.BaseClass(
    "JoinActivityDrawUpBattlePassData2",
    JoinActivityDrawUpBattlePassData
)

---进入活动
function JoinActivityDrawUpBattlePassData2:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DrawUpGMBattlePassView.Name, self.activity)
end

---检测红点
function JoinActivityDrawUpBattlePassData2:CheckRedPoint()
    ---可领奖
    if not _G.table.isEmptyOrNil(self:FindAllUnclaimedRewards(self:GetActivityID())) then
        return 1
    end
    local endTime, _ = self.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    local key = _G.PlayerModel:GetInstance():GetPlayerUid() ..
        "DrawUpBattlePass" .. self.curActivityClass:GetActivityID() .. endTime
    ---首次开启
    if _G.PlayerPrefsManager.GetInt(key) ~= 1 then
        return 1
    end
    return 0
end

return JoinActivityDrawUpBattlePassData2
