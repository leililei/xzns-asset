---@class JointActivityData : LogicClass	中文描述
local JointActivityData = _G.BaseClass("JointActivityData", _G.LogicClass)

function JointActivityData:__init(info, activity)
    self:ParseSignData(info, activity)
end

function JointActivityData:GetActivityID()
    return self.activityId
end

--region 签到相关
---解析签到活动的数据
---@param info activity_sign.i_activity_sign
---@param activityClass ActivitySynBase
function JointActivityData:ParseSignData(info, activityClass)
    self.signActivity = activityClass
    self.activityId = activityClass:GetActivityID()
    --已领取的奖励id
    self.signIdList = info.sign.g_sids or {}
    --奖励item信息
    self.signItem = info.sign.item or {}
    for _, v in pairs(self.signItem) do
        if v.other_a then
            if not v.award then
                v.award = {}
            end
            for _, v2 in pairs(v.other_a) do
                _G.table.insert(v.award, { type = { v2.c_id, v2.num } })
            end
        end
    end
    ---@field type 1根据玩家累计登录天数签到 2根据活动开始时间
    self.loginDay = info.sign.login_days or 0
    if info.sign.type == 2 then
        local startTime = activityClass.cfg.time.start_time
        self.loginDay = _G.math.ceil((_G.TimeUtil.GetServerUnixTime() - startTime) / 86400)
    end
end

---获取签到数据
function JointActivityData:GetSignItem()
    return self.signItem
end

---已领取的奖励id列表
function JointActivityData:GetSignIdList()
    return self.signIdList
end

---签到登录天数
function JointActivityData:GetSignLoginDay()
    return self.loginDay
end

---领取签到奖励
function JointActivityData:GetSignAward(data, callback)
    self.signActivity.typeClass:GetAward(data.sid, function(msg)
        if msg.ack ~= 1 then
            return
        end
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
        if data.other_a then
            if not msg.award then
                msg.award = {}
            end
            if not msg.award.item then
                msg.award.item = {}
            end
            for _, v in ipairs(data.other_a) do
                local tb = _G.StorageManager:GetInstance():SimulationAward(v.c_id, v.num)
                _G.table.insert(msg.award.item, { type = tb })
                _G.Events:GetInstance():Broadcast(_G.eArena.SetDrawUp, { v.c_id, v.num })
            end
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
        _G.table.insert(self.signIdList, data.sid)
        self.signActivity.typeClass:RefreshRedPoint()
        if callback then
            callback()
        end
    end)
end

--endregion 签到相关结束

---销毁对象时,析构函数
function JointActivityData:Dispose()
end

return JointActivityData
