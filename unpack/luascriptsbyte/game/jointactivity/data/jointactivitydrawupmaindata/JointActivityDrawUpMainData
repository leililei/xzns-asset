function JointActivityDrawUpMainData:AddCoins(data)
    if self.coinId and data[1] == self.coinId then
        self:AddCoin(data[2])

        self.activity.typeClass:RefreshRedPoint()
    end
end

---剩余保底次数
function JointActivityDrawUpMainData:GetLeftGuaranteed()
    local initTimes = self.limited_roller_cfg.guaranteed_init
    if self.total_times < initTimes then
       ---初次保底
       return initTimes - self.times
    end

    return self.limited_roller_cfg.pseudo - self.times
end

