---自身活动代币增加（如锻造豪礼）
function JointActivityDrawUpMainData:SetMallCoin(giftId)
    local data = {
        type = {
            [1] = self.coinId
        }
    }
    for _, v in pairs(self.limited_roller_cfg.rewards_goods) do
        if v[1] == giftId then
            data.type[2] = v[2]
            break
        end
    end
    _G.Events:GetInstance():Broadcast(_G.eArena.SetDrawUp, data.type)
    return data
end

