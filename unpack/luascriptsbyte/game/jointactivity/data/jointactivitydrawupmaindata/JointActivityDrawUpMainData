local RedPointManager = require("RedPointManager")

---@class JointActivityDrawUpMainData : Component	中文描述
local JointActivityDrawUpMainData = _G.BaseClass("JointActivityDrawUpMainData", _G.LogicClass)

function JointActivityDrawUpMainData:__init(activity, info)
    _G.Events:GetInstance():AddListener(_G.eArena.SetDrawUp, self.AddCoins, self)
    self:ParseData(activity, info)
end

function JointActivityDrawUpMainData:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eArena.SetDrawUp, self.AddCoins, self)
end

---@param info table 活动数据
function JointActivityDrawUpMainData:ParseData(activity, info)
    self.activity = activity
    self.activityID = activity.activityID
    self.info = info
    ---GM配置
    self.cfg = info.cfg
    ---当前保底累积次数
    self.times = info.times or 0
    ---当天招募次数
    self.day_times = info.day_times or 0
    ---总招募次数
    self.total_times = info.total_times or 0
    ---已领取招募次数奖励
    self.award = info.award or {}
    ---招募卷数量
    self.prop_num = info.prop_num or 0
    local coinId = 106
    if self.cfg.coin_type and not _G.string.IsNullOrEmpty(self.cfg.coin_type) then
        coinId = _G.tonumber(self.cfg.coin_type)
    end
    self:SetCoin(self.prop_num, coinId)
    ---累抽礼包购买记录
    local cash_gift = info.cash_gift or {}
    self.cashGift = {}
    for k, v in pairs(cash_gift) do
        self.cashGift[v.k] = v.v
    end

    ---当前抽卡活动id
    self.Id = info.cfg.pool_sid
    self.limited_roller_cfg = _G.ConfigManager.limited_roller_cfg[self.Id]
    --灵兽spine
    self.role_spine = info.cfg.role_spine
    ---限时道具及其权重（卡牌id）
    self.limited_itemId = self.limited_roller_cfg.limited_item
    ---心愿灵兽
    self.wish_prop = info.wish_prop
    if self.wish_prop == nil then
        --如果没有选心愿灵兽默认选中第一个
        self.wish_prop = self.limited_itemId[1]
    end

    ---已使用魂玉召唤次数
    self.diamond_times = info.diamond_times or 0
    ---总共可使用魂玉次数(配置表丶服务器数据总和, 暂无服务器数据)
    self.diamond_total_times = self.limited_roller_cfg and self.limited_roller_cfg.count_diamond or 0
    ---魂玉单抽消耗数量
    self.diamond_consume_num = self.limited_roller_cfg and self.limited_roller_cfg.ticket_2[1] or 0
    ---排行榜类型
    self.rank_type = info.cfg.rank_type
    ---持续时间
    self.run_time = activity.cfg.time.run_time
    ---开始时间
    self.start_time = activity.cfg.time.start_time
end

