function JointActivityDrawUpMainData:Role_SpineParse()
    --角色id|跳转id|拍脸背景图路径+资源名称#X坐标#Y坐标#Z坐标|角色名称路径+资源名称#X坐标
    --#Y坐标#Z坐标|名称底框路径+资源名称#X坐标#Y坐标#Z坐标|
    --slogan文本“<color=#C95F00>玄秘机巧，尽在一心</color>”
    if self.role_spine == nil or self.role_spine == "Test" then
        return
    end

    self.role_spineList = {}
    self.role_spineList.int = 2
    local dev = _G.string.split(self.role_spine, "|")
    for key, value in pairs(dev) do
        if key == 1 then
            self.role_spineList.id = _G.tonumber(value)
        elseif key == 2 then
            self.role_spineList.jump_id = _G.tonumber(value)
        elseif key == 3 then
            self.role_spineList.bg = value
        elseif key == 4 then
            self.role_spineList.role = value
        elseif key == 5 then
            self.role_spineList.name = value
        elseif key == 6 then
            self.role_spineList.slogan = value
        elseif key == 7 then
            self.role_spineList.spice = value
        end
    end
    return self.role_spineList
end

