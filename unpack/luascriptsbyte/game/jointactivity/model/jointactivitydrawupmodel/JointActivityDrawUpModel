---设置心愿
function JointActivityDrawUpModel:SetWish(activityId, sid, qz, callback)
    local curqz = qz or 1
    local pbData = {
        activity_id = activityId,
        wish_prop = {sid, curqz}
    }
    require("JointActivityNet"):GetInstance():SetWish(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
               return
            end

            local activityData = self.activityList[activityId]
            if activityData then
                activityData:SetWish({sid, curqz})
            end
            if callback then
                callback()
            end
        end
    )
end

---抽卡
---@param consumeType number 1活动代币 2魂玉
---@param drawTimes number 抽奖次数
function JointActivityDrawUpModel:DrawCard(activityId, consumeType, drawTimes, callback, IsEff)
    if self:GetTime(activityId) <= 0 then
        ---活动已结束
        _G.PopWindowManager:GetInstance():ShowAllTips(870102)
        return
    end

    local data = self.activityList[activityId]
    if self:GetDayTimes(activityId) + drawTimes > data.limited_roller_cfg.limit_daily then
        _G.PopWindowManager:GetInstance():ShowAllTips(130102)
        return
    end

    require("JointActivityDrawUpModel"):GetInstance().InDrawing = true
    local pbData = {activity_id = activityId, draw_times = drawTimes, consume_type = consumeType}
    require("JointActivityNet"):GetInstance():ActivityDrawExecute(pbData, function(data)
        require("JointActivityDrawUpModel"):GetInstance().InDrawing = false
        if data.ack ~= 1 then
            return
        end
        self:DrawSucceessCall(activityId, consumeType, drawTimes, data, callback, IsEff)
    end)
end

---抽奖成功回调
function JointActivityDrawUpModel:DrawSucceessCall(activityId, consumeType, drawTimes, data, callback, IsEff)
    if consumeType == _G.DrawConsumeType.token then
        self:AddCoin(activityId, -drawTimes)
    elseif consumeType == _G.DrawConsumeType.diamond then
        --消耗魂玉
        local consumeNum = self:GetDiamondConsume(activityId, drawTimes)
        if drawTimes == 10 then
            local limited_roller_cfg = self:Getlimited_roller_cfg(activityId)
            local discount = limited_roller_cfg.ticket_discount[1]
            if discount then
                consumeNum = _G.Mathf.Floor(consumeNum * discount / 10000)
            end
        end
        self:AddDiamondTimes(activityId, drawTimes)
        _G.StorageManager:GetInstance():ConsumeItem(_G.ResPropID.Diamond, 0, consumeNum)
    end

    self:AddTotalTimes(activityId, drawTimes)
    self:AddDayTimes(activityId, drawTimes)
    ---判断是否抽到大奖
    local activityData = self.activityList[activityId]
    local isBigAward
    local times = activityData.times
    if activityData and data.times then
        if data.times ~= times + drawTimes then
            isBigAward = true
        end   
        activityData.times = data.times --:AddTimes(drawTimes)
        -- end
    end
    if activityData then
        activityData.activity.typeClass:RefreshRedPoint()
        activityData.activity.typeClass:RefreshRedPoint(2)
    end
    if data.award then
        IsEff(
                drawTimes,
                function()
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data, nil, true)
                end,
                data.award.item,
                isBigAward
        )
    end
    _G.StorageManager:GetInstance():ReceiveAwardData(data)
    --发起事件广播
    local poolId = self:GetCfgId(activityId)
    _G.Events:GetInstance():Broadcast(
        _G.ePlayAactionEvent.PlayAaction,
        {
            _G.ActiveTaskEnum.ConditionEnum.JointActivity.LimiteDraw,
            poolId
        },
        drawTimes
    )

    if callback then
        callback(data)
    end
end

