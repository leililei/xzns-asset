---检查锻造豪礼红点
function JointActivityDrawUpModel:PackGiftRedPoint(ActivityID)
    if not ActivityID or not self.activityList[ActivityID] then
        return 0
    end

    local data = self.activityList[ActivityID]
    local rewards_count = data.limited_roller_cfg.rewards_count

    for key, value in pairs(rewards_count) do
        local total_times = self:GetTotalTimes(ActivityID)
        if not self:IsReceiveAward(ActivityID, key) and value <= total_times then
            return 1
        end
    end
    return 0
end

---检查是否可以十连抽
function JointActivityDrawUpModel:CheckActivityRedPoint(activityId)
    if not activityId or not self.activityList[activityId] then
        return 0
    end

    if self:GetPropNum(activityId) >= 10 then
        return 1
    end

    return 0
end

