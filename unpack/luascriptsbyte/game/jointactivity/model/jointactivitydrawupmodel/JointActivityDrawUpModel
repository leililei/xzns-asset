---解析活动数据
function JointActivityDrawUpModel:ParseActivityData(info, activity)
    if not self.activityList then
        self.activityList = {}
    end

    local ActivityID = activity.activityID
    if not self.activityList[ActivityID] then
        local infoData = require "JointActivityDrawUpMainData".New(activity, info)
        self.activityList[ActivityID] = infoData
    else
        self.activityList[ActivityID]:ParseData(activity, info)
    end
end

