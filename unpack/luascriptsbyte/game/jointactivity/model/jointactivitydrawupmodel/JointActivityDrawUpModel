---获取总抽取次数的红点参数
function JointActivityDrawUpModel:GetAllTimeRedPointParm(activityID)
    local cfg=self.activityList[activityID]:Getlimited_roller_cfg()
    local param={}
    for i = 1, #cfg.rewards_item do
        table.insert(param,i)
    end
    return param
end

---根据活动id和参数获取从抽取次数奖励的红点
function JointActivityDrawUpModel:GetAllTimeRedPointBuyParm(activityID,param)
    local cfg=self.activityList[activityID]:Getlimited_roller_cfg()
    local numTotle = self:GetTotalTimes(activityID)
    if param then
        local isGet = self:IsReceiveAward(activityID, param)
        local score = cfg.rewards_count[param]
        local canGet = not isGet and numTotle >= score
        return canGet and 1 or 0
    else
        local isGet=false
        local score=0
        local canGet=false
        for i = 1, #cfg.rewards_item do
            isGet = self:IsReceiveAward(activityID, i)
            score = cfg.rewards_count[i]
            canGet = not isGet and numTotle >= score
            if canGet then
                return 1
            end
        end
        return 0
    end
end

