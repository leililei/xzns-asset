---六点刷新
function JointActivityDrawUpModel:OnSixClockUpdate(enccall)
    --重置魂玉召唤次数
    if self.activityList then
        for _, v in pairs(self.activityList) do
            v.diamond_times = 0
        end
        local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.PetDrawUpMainView.Name)
        if window and window.View and not window.View:IsNil() then
            window.View:LoadDiamondTimes()
            window.View:LoadConsumesInfos()
        end
    end

    _G.GameDataModelBase.OnSixClockUpdate(self, enccall)
end

