local base = require "ActivitySynTypeBase"
---@class JointActivityDrawUpMainGmModel : ActivitySynTypeBase    中文描述
local JointActivityDrawUpMainGmModel = _G.BaseClass("JointActivityDrawUpMainGmModel", base)

function JointActivityDrawUpMainGmModel:OnHandleGMData(info)
    self:ParseData(info)
end

function JointActivityDrawUpMainGmModel:ParseData(info)
    self.activity = self.curActivityClass
    require "JointActivityDrawUpModel":GetInstance():ParseActivityData(info.limited_draw, self.curActivityClass)
    base.ParseData(self)
end

---进入活动主体
function JointActivityDrawUpMainGmModel:OnEnterActivity()
    -- local coinId = require "JointActivityDrawUpModel":GetInstance():GetCoinId(self.activity.activityID)
    -- if coinId == 124 then
    --     _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.JointActivityDrawUpView.Name, self.activity)
    -- elseif coinId == 128 then
    --     _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.IceFestivalDrawUpView.Name, self.activity)
    -- end
    local _type = require("JointActivityModel"):GetInstance():GetJointActivityType()
    local subType = self.curActivityClass:GetJumpType()
    if _type == _G.JointActivityType.SummerFire then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SummerFireDrawUpView.Name, self.activity)
    elseif _type == _G.JointActivityType.NationalDay then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FestivalDrawUpView.Name, self.activity)
    elseif _type == _G.JointActivityType.MTLink1 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ChieftainTreasuryView.Name, self.activity)
    elseif _type == _G.JointActivityType.Easter then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.EasterDrawUpView.Name, self.activity)
    elseif _type and _type >= _G.JointActivityType.MTLink1 and _type <= _G.JointActivityType.MTLink5 then
        if _type == _G.JointActivityType.MTLink3 then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MTFestivalThreeDrawUpView.Name, self.activity)
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MTFestivalDrawUpView.Name, self.activity)
        end
    elseif _type == _G.JointActivityType.WinterVeil then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WinterVeilDrawUpView.Name, self.activity)
    elseif _type == _G.JointActivityType.SpringFestivalActivities then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TreasureBlissView.Name, self.activity)
    elseif _type == _G.JointActivityType.SpringFestival or _type == _G.JointActivityType.SpringFestivalActivities2 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpringFestivalDrawUpView.Name, self.activity)
    elseif subType == 100209 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LabourDayDrawCardView.Name, self.activity)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.IceFestivalDrawUpView.Name, self.activity)
    end
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

