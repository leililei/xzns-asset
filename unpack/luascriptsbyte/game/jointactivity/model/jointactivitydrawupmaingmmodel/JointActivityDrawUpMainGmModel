---@return table MallManager监听充值回调需要展示活动代币获得
function JointActivityDrawUpMainGmModel:SetCoin(giftId)
    return require "JointActivityDrawUpModel":GetInstance():SetMallCoin(self.activity.activityID, giftId)
end

---礼包购买次数增加
function JointActivityDrawUpMainGmModel:SetItemBuyTimes(giftId)
    require "JointActivityDrawUpModel":GetInstance():AddPackGiftBuyTimes(self.activity.activityID, giftId)
end

function JointActivityDrawUpMainGmModel:IsShowBtn()
    local sub_type = self.curActivityClass:GetJumpType()
    if sub_type == 100209 then
        return true
    end
    return false
end

---获取是否允许使用代币
function JointActivityDrawUpMainGmModel:GetIsUseCoin()
    local _type = require("JointActivityModel"):GetInstance():GetJointActivityType()
    if _type == _G.JointActivityType.NationalDay or _type == _G.JointActivityType.WinterVeil then
        return false
    end
    return true
end

function JointActivityDrawUpMainGmModel:GetResourceCoin()
    local _type = require("JointActivityModel"):GetInstance():GetJointActivityType()
    if _type == _G.JointActivityType.NationalDay then
        return _G.ConfigManager.ui_cfg.FestivalDrawUpView.resources
    elseif _type == _G.JointActivityType.WinterVeil then
        return _G.ConfigManager.ui_cfg.WinterVeilDrawUpView.resources
    elseif _type == _G.JointActivityType.MTLink1 or _type == _G.JointActivityType.MTLink5 then
        return _G.ConfigManager.ui_cfg.ChieftainTreasuryView.resources
    end
    return _G.ConfigManager.ui_cfg.IceFestivalDrawUpView.resources
end

function JointActivityDrawUpMainGmModel:AddCoin(num)
    require "JointActivityDrawUpModel":GetInstance():AddCoin(self.activity.activityID, num)
end

function JointActivityDrawUpMainGmModel:GetPoolId()
    local cfg = require("JointActivityDrawUpModel"):GetInstance():Getlimited_roller_cfg(self.activityID)
    return cfg and cfg.id or 0
end

