---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function JointActivityDrawUpMainGmModel:InitRedPointTree()
    self.checkRedPointFunc = { self.CheckRedPoint, self.CheckRedPointPackGift, self.CheckRedPointBattlePass }
    self.redpointTree = {
        { 2, 3 },
        false,
        { 4 }, --将index=4, 挂在index=3下
        false, --用于挂载战令丶战令任务
    }
end

function JointActivityDrawUpMainGmModel:LaterInitFunction()
    local parentRedpointId = self:GetRedpointIDByIndex(4)
    local activityManager = require("ActivitySynManager"):GetInstance()
    local redpointMamanger = require("RedPointManager"):GetInstance()

    --初始化战令和战令任务红点(战令和战令任务, 合并成一个红点)
    local battlePassActivity = activityManager:GetChildAcitivity(
        10027,
        self.activity:GetJumpType(),
        self.activity:GetMainType()
    )
    if battlePassActivity then
        redpointMamanger:AddRedPointChild(
            parentRedpointId,
            battlePassActivity:GetActivityTypeCls():GetRedpointIDByIndex(1)
        )
    end
    local taskActivity = activityManager:GetChildAcitivity(
        10007,
        self.activity:GetJumpType(),
        self.activity:GetMainType()
    )
    if taskActivity then
        redpointMamanger:AddRedPointChild(
            parentRedpointId,
            taskActivity:GetActivityTypeCls():GetRedpointIDByIndex(1)
        )
    end
    --礼包
    local giftActivity = activityManager:GetChildAcitivity(
        10014,
        self.activity:GetJumpType(),
        self.activity:GetMainType()
    )
    if taskActivity then
        redpointMamanger:AddRedPointChild(
            self:GetRedpointIDByIndex(1),
            giftActivity:GetActivityTypeCls():GetRedpointIDByIndex(1)
        )
    end
    --礼包
    local giftWeekActivity = activityManager:GetChildAcitivity(
        10088,
        self.activity:GetJumpType(),
        self.activity:GetMainType()
    )
    if giftWeekActivity then
        redpointMamanger:AddRedPointChild(
            self:GetRedpointIDByIndex(1),
            giftWeekActivity:GetActivityTypeCls():GetRedpointIDByIndex(1)
        )
    end
end

function JointActivityDrawUpMainGmModel:CheckRedPoint()
    if self.activity then
        return require "JointActivityDrawUpModel":GetInstance():CheckActivityRedPoint(self.activity.activityID)
    end
    return 0
end

---礼包红点
function JointActivityDrawUpMainGmModel:CheckRedPointPackGift()
    if self.activity then
        return require "JointActivityDrawUpModel":GetInstance():GetAllTimeRedPointBuyParm(self.activity.activityID)
    end
    return 0
end

function JointActivityDrawUpMainGmModel:CheckRedPointBattlePass()
    return 0
end

function JointActivityDrawUpMainGmModel:GetRedPointParamsChild(index, param)
    if index == 2 then
        return require "JointActivityDrawUpModel":GetInstance():GetAllTimeRedPointParm(self.activity.activityID, param)
    end
end

---刷新奖励红点
function JointActivityDrawUpMainGmModel:RefreshRedPoint(param)
    local redpointManager = require("RedPointManager"):GetInstance()

    if not param or param <= 0 then
        --刷新所有红点
        for i = #self.redpointTree, 1, -1 do
            redpointManager:RefreshNode(self:GetRedpointIDByIndex(i))
        end
    else
        redpointManager:RefreshNode(self:GetRedpointIDByIndex(param))
    end
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function JointActivityDrawUpMainGmModel:CheckRedPointNumChild(index, _)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

