---@class JointActivityModel : Singleton	中文描述
local JointActivityModel = _G.BaseClass("JointActivityModel", _G.GameDataModelBase)
_G.JointActivityModel = JointActivityModel

---@return JointActivityModel JointActivityModel
function JointActivityModel:GetInstance()
    return self.super.GetInstance(self)
end

--region 签到相关
---解析签到的数据
function JointActivityModel:ParseSignData(info, curActivityClass)
    if not self.activityList then
        self.activityList = {}
    end

    local infoData = require("JointActivityData").New(info, curActivityClass)
    local activityId = curActivityClass:GetActivityID()
    if not self.activityList[activityId] then
        self.activityList[activityId] = infoData
    end
end

---获取签到数据
function JointActivityModel:GetSignItem(activityId)
    local infoData = self.activityList[activityId]
    if not infoData then
        return {}
    end
    return infoData:GetSignItem()
end

---已领取的奖励id列表
function JointActivityModel:GetSignIdList(activityId)
    local infoData = self.activityList[activityId]
    if not infoData then
        return {}
    end
    return infoData:GetSignIdList()
end

---签到状态
---@return number 0不可领取，1可领取，2已领取
function JointActivityModel:GetSignAwardState(activityId, id)
    local loginDay = self:GetSignLoginDay(activityId)
    if loginDay < id then
        return 0
    end
    local data = self:GetSignIdList(activityId)
    return _G.table.indexof(data, id) and 2 or 1
end

---签到登录天数
function JointActivityModel:GetSignLoginDay(activityId)
    local infoData = self.activityList[activityId]
    if not infoData then
        return 0
    end
    return infoData:GetSignLoginDay()
end

---签到红点
function JointActivityModel:CheckSignRedPoint(curActivityClass)
    local activityData = self.activityList[curActivityClass.activityID]
    if not activityData then
        return false
    end
    local loginDay = activityData:GetSignLoginDay()
    local data = activityData:GetSignIdList()
    for _, v in pairs(activityData:GetSignItem()) do
        if v.sid <= loginDay and not _G.table.indexof(data, v.sid) then
            return true
        end
    end
    return false
end

---领取签到奖励
function JointActivityModel:GetSignAward(activityId, data, callback)
    local infoData = self.activityList[activityId]
    if not infoData then
        return
    end
    return infoData:GetSignAward(data, callback)
end

--endregion

---主活动的类型
function JointActivityModel:GetMainActivityType()
    return 10043
end

---设置当前打开的活动壳子类型
function JointActivityModel:SetJointActivityType(_type)
    self.curJointActivityType = _type
end

function JointActivityModel:GetJointActivityType()
    return self.curJointActivityType
end

--region 服务器通讯协议
--endregion

---销毁对象时,析构函数
function JointActivityModel:Dispose()
    if self.activityList then
        for _, v in pairs(self.activityList) do
            v:Dispose()
        end
        self.activityList = nil
    end
end

---移除活动
function JointActivityModel:RemoveActivity(activityID)
    if self.activityList[activityID] then
        self.activityList[activityID]:Dispose()
        self.activityList[activityID] = nil
    end
end

return JointActivityModel
