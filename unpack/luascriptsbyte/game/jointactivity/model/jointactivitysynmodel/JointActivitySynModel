local base = require "ActivitySynTypeBase"
local ActivitySynManager = require "ActivitySynManager"
---@field model FestivalActivityModel
---@class JointActivitySynModel:ActivitySynTypeBase    联动活动
local JointActivitySynModel = _G.BaseClass("JointActivitySynModel", base)
_G.JointActivitySynModel = JointActivitySynModel

local parentRedPointT = {
    [_G.ActivitySubType.Spiritual] = _G.ConfigManager.redpoint_cfg.SpiritualCall.id,
    [_G.ActivitySubType.Draw] = _G.ConfigManager.redpoint_cfg.MainDraw.id,
    [_G.ActivitySubType.Artifact] = _G.ConfigManager.redpoint_cfg.MainArtifactFurnace.id,
    [_G.ActivitySubType.Pet] = _G.ConfigManager.redpoint_cfg.PetDrawButton.id,
}

---类的构造函数
function JointActivitySynModel:__init()
    -- self.activityType 转移到 _G.JointActivityType
    self.viewName = {
        [1] = _G.ConfigManager.ui_cfg.JointActivityView.Name,
        [2] = _G.ConfigManager.ui_cfg.IceFestivalActivityView.Name,
        [3] = _G.ConfigManager.ui_cfg.DrawGiftPackToggleView.Name,
        [4] = _G.ConfigManager.ui_cfg.SummerFireActivityView.Name,
        [5] = _G.ConfigManager.ui_cfg.FestivalMainView.Name,
        [11] = _G.ConfigManager.ui_cfg.TavernPartyToggleView.Name,
        [12] = _G.ConfigManager.ui_cfg.SpringFestivalMainView.Name,
        [14] = _G.ConfigManager.ui_cfg.SpringFestivalTavernPartyToggleView.Name,
        [18] = _G.ConfigManager.ui_cfg.WinterFestivalMainView.Name,
        [19] = _G.ConfigManager.ui_cfg.WishTempleToggleView.Name,
        [20] = _G.ConfigManager.ui_cfg.EasterMainView.Name,
        [21] = _G.ConfigManager.ui_cfg.LabourDayFestivalMainView.Name,
        [23] = _G.ConfigManager.ui_cfg.BathhouseGiftToggleView.Name,
    }
    self.model = require("FestivalActivityModel"):GetInstance()
    _G.Events:GetInstance():AddListener(self.curActivityClass.regiestStateChangedStr, self.StateChanged, self)
end

function JointActivitySynModel:StateChanged(state)
    if state == ActivitySynManager.State.Close then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(self.viewName[self.type])
        if view then
            view:OnCloseActivity(self.curActivityClass:GetActivityID())
        end
    end
    self:CheckBtns()
end

---
---@protected
function JointActivitySynModel:CheckBtns()
    if self.type == 3 and self.curActivityClass:GetJumpType() == 100314 then
        require "SpiritualDrawModel":GetInstance():SetBtnCloseCountdown()
    end
end

---获取GM数据
function JointActivitySynModel:OnHandleGMData(info)
    self:ParseData(info)
    self:CheckBtns()
end

---解析数据
function JointActivitySynModel:ParseData(info)
    self.activity = self.curActivityClass
    self.type = info.shell and info.shell.activity_type or 1
    self.CoinList = {}
    if info.shell and info.shell.coin_list then
        for i = 1, #info.shell.coin_list do
            self.model:SetCoin(self.activity.activityID, info.shell.coin_list[i], true)
        end
    end
    base.ParseData(self)
end

---增加门票
function JointActivitySynModel:SetCoin(data)
    self.model:SetCoin(self.activity.activityID, data)
end

---获取门票
function JointActivitySynModel:GetCoin(data)
    return self.model:GetCoin(data)
end

function JointActivitySynModel:CheckActivityOpened()
    local state = self.curActivityClass:GetCurActivityState()
    if state == require("ActivitySynManager").State.Notice then
        return false
    end
    return state == require("ActivitySynManager").State.Open
end

---进入活动主体
function JointActivitySynModel:OnEnterActivity()
    require("JointActivityModel"):GetInstance():SetJointActivityType(self.type)
    _G.UIManager:GetInstance():OpenWindow(self.viewName[self.type], self.activity, self.curActivityClass:GetJumpType())
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function JointActivitySynModel:GetType()
    return self.type
end

function JointActivitySynModel:OnGetMainViewName()
    return self.viewName[self.type]
end

---子活动列表
function JointActivitySynModel:GetOtherActivityRedPointIds()
    if self.type == _G.JointActivityType.DrawAccelerate then
        require "RedPointManager":GetInstance():AddRedPointChild(parentRedPointT[self.activity:GetJumpType()], self:GetRedpointIDByIndex(1))
        return { 10007, 10014 }
    elseif self.type == _G.JointActivityType.JointActivity then
        return { 10042, 10044, 10010, 10045 }
    elseif self.type == _G.JointActivityType.NationalDay then
        return { 10010, 10041, 10048, 10065, 10064, 10044 }
    elseif self.type == _G.JointActivityType.MTLink1 then
        return { 10032, 10065, 10044 }
    elseif self.type == _G.JointActivityType.MTLink2 then
        return { 10048, 10044, 10041 }
    elseif self.type == _G.JointActivityType.MTLink3 then
        return { 10069, 10070, 10071 }
    elseif self.type == _G.JointActivityType.Easter then
        if _G.AppSetting.IsXzns then
            return { 10010, 10046, 10042, 10044, 10039, 10070, 10064 }
        else
            return { 10010, 10046, 10042, 10044, 10039 }
        end
    elseif self.type == _G.JointActivityType.MTLink4 then
        return { 10048, 10068, 10070, 10072 }
    elseif self.type == _G.JointActivityType.MTLink5 then
        return { 10065, 10073, 10044 }
    elseif self.type == _G.JointActivityType.TavernParty or self.type == _G.JointActivityType.SpringFestivalTavernParty then
        return { 10007, 10014, 10048 }
    elseif self.type == _G.JointActivityType.SpringFestival then
        return { 10007,10010, 10044, 10048, 10064, 10065, 10070, 10087 }
    elseif self.type == _G.JointActivityType.WishTemple then
        return { 10007, 10014, 10048 }
    elseif self.type == _G.JointActivityType.WinterVeil then
        return { 10010, 10041, 10048, 10065, 10064, 10044 }
    elseif self.type ==_G.JointActivityType.LabourDay then
        return { 10010, 10048, 10044, 10094, 10095 }
    end
    return { 10010, 10046, 10042, 10044, 10039 }
end

---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function JointActivitySynModel:InitRedPointTree()
    self.checkRedPointFunc = { self.CheckRedPoint }
    self.redpointTree = { false }
end

function JointActivitySynModel:CheckRedPoint()
    return 0
end

---检测红点
---@param index number 红点类型序列号
---@return number 红点数量
function JointActivitySynModel:CheckRedPointNumChild(index)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---刷新奖励红点
function JointActivitySynModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

---类的析构函数
function JointActivitySynModel:Dispose()
    if self.curActivityClass then
        _G.Events:GetInstance():RemoveListener(self.curActivityClass.regiestStateChangedStr, self.StateChanged, self)
    end
end

return JointActivitySynModel
