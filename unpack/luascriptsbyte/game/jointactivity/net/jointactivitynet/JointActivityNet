local base = require("BaseGameNet")

---@class JointActivityNet : BaseGameNet	通信协议
local JointActivityNet = _G.BaseClass("JointActivityNet", base)
---@return JointActivityNet JointActivityNet
function JointActivityNet:GetInstance()
    return  base.GetInstance(self)
end

---竞猜下注
---@param pbdata table 发送数据
---@param callback function 回调方法
function JointActivityNet:GuessBet(pbdata, callBack)
    self:Access(_G.ConfigManager.net_map.game_activity_guess_2_port_bet, pbdata, callBack)
end

---获取下注公告信息
---@param pbdata table 发送数据
---@param callback function 回调方法
function JointActivityNet:GetBetInfo(pbdata, callBack)
    self:Access(_G.ConfigManager.net_map.game_activity_guess_2_port_bet_info, pbdata, callBack)
end

---竞猜奖励
---@param pbdata table 发送数据
---@param callback function 回调方法
function JointActivityNet:GetGuessAward(pbdata, callBack)
    self:Access(_G.ConfigManager.net_map.game_activity_guess_2_port_guess_award, pbdata, callBack)
end

---发生聊天或者弹幕
---@param pbdata table 发送数据
---@param callback function 回调方法
function JointActivityNet:SendGuessBullet(pbdata, callBack)
    self:Access(_G.ConfigManager.net_map.game_activity_guess_2_port_bullet, pbdata, callBack)
end

---获取弹幕信息
---@param pbdata table 发送数据
---@param callback function 回调方法
function JointActivityNet:GetBulletInfo(pbdata, callBack)
    self:Access(_G.ConfigManager.net_map.game_activity_guess_2_port_bullet_info, pbdata, callBack)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function JointActivityNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---设置心愿
function JointActivityNet:SetWish(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_limited_draw_port_set_wish_pet
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---召唤
function JointActivityNet:ActivityDrawExecute(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_limited_draw_port_execute
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function JointActivityNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end


return JointActivityNet