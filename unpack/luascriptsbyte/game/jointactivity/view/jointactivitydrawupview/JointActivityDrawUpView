---加载招募消耗信息
function JointActivityDrawUpView:LoadConsumesInfos()
    ---获取代币数量
    local coinNum = JointActivityDrawUpModel:GetInstance():GetPropNum(self.activityID)
    ---获取魂玉召唤次数
    local totalTimes = JointActivityDrawUpModel:GetInstance():GetDiamondTotalTimes(self.activityID)
    local usedTimes = JointActivityDrawUpModel:GetInstance():GetDiamondTimes(self.activityID)
    local remainTimes = totalTimes - usedTimes

    local isUseDiamode = false
    local leftIcon, leftNum, rightNum, rightIcon
    ---单抽
    if coinNum >= 1 or totalTimes == 0 or remainTimes < 1 then
        leftNum = 1
        leftIcon = self:getCurrencyTypeIcon(self.coinId)
    else
        leftNum = JointActivityDrawUpModel:GetInstance():GetDiamondConsume(self.activityID, 1)
        leftIcon = _G.StorageManager:GetInstance():GetItemIcon(_G.ResPropID.Diamond)

        isUseDiamode = true
    end

    ---多抽
    self.go_table.aortext_PropRightNum.text = ""
    if coinNum >= 1 or totalTimes == 0 or remainTimes < 10 then
        if coinNum >= 10 then
            rightNum = 10
        else
            rightNum = coinNum > 0 and coinNum or 10
        end
        rightIcon = self:getCurrencyTypeIcon(self.coinId)
    else
        rightNum = JointActivityDrawUpModel:GetInstance():GetDiamondConsume(self.activityID, 10)
        rightIcon = _G.StorageManager:GetInstance():GetItemIcon(_G.ResPropID.Diamond)
        isUseDiamode = true
    end
    self.go_table.aortext_PropLeftNum.text = leftNum

    if isUseDiamode then
        self.drawConsumeType = _G.DrawConsumeType.diamond
        self.go_table.aortext_PropRightNumDesc.text =
            _G.GetLangPackValue(90032200099, _G.GameUtil.NumberToWordByLanguage(10))
    else
        self.drawConsumeType = _G.DrawConsumeType.token
        self.go_table.aortext_PropRightNumDesc.text =
            _G.GetLangPackValue(90032200099, _G.GameUtil.NumberToWordByLanguage(rightNum))
    end

    if isUseDiamode then
        local limited_roller_cfg = JointActivityDrawUpModel:GetInstance():Getlimited_roller_cfg(self.activityID)
        local discount = limited_roller_cfg.ticket_discount[1]
        if discount and remainTimes >= 10 then
            self.go_table.aortext_PropRightNum.text = _G.string.format("%.0f", rightNum * discount / 10000)
            ---使用魂玉时的折扣
            self.go_table.obj_discount:SetActiveE(1)
            self.go_table.aortext_discount.text =
                _G.GetLangPackValue(90028800006, _G.string.format("%.1f", discount / 10000 * 10))
        else
            self.go_table.aortext_PropRightNum.text = rightNum
            self.go_table.obj_discount:SetActiveE(0)
        end
    else
        self.go_table.obj_discount:SetActiveE(0)
        self.go_table.aortext_PropRightNum.text = rightNum
    end
    self.go_table.obj_hongDian:SetActiveE(coinNum >= 10 and 1 or 0)
    self.go_table.aorrawimage_PropLeft:LoadImage(
        leftIcon,
        function(image)
            if image then
                image:SetActiveE(1)
            end
        end
    )
    self.go_table.aorrawimage_PropRight:LoadImage(
        rightIcon,
        function(image)
            if image then
                image:SetActiveE(1)
            end
        end
    )
end

---加载魂玉召唤次数信息
function JointActivityDrawUpView:LoadDiamondTimes()
    --获取魂玉召唤次数信息
    local usedTimes = JointActivityDrawUpModel:GetInstance():GetDiamondTimes(self.activityID)
    local totalTimes = JointActivityDrawUpModel:GetInstance():GetDiamondTotalTimes(self.activityID)
    self.go_table.obj_diamondTimes:SetActiveE(totalTimes > 0 and 1 or 0)
    if totalTimes <= 0 then
        return
    end

    local remain = totalTimes - usedTimes
    self.go_table.aortext_remainDiamondTimes.text = _G.GetLangPackValue(90022300102, remain .. "/" .. totalTimes)
end

---概率提升显示
function JointActivityDrawUpView:SetTipInfo()
    local GetTotalTimes = JointActivityDrawUpModel:GetInstance():GetTotalTimes(self.activityID)
    local limited_roller_cfg = JointActivityDrawUpModel:GetInstance():Getlimited_roller_cfg(self.activityID)
    local Max = limited_roller_cfg.guaranteed_init

    if GetTotalTimes >= Max then
        Max = limited_roller_cfg.pseudo
    end
    local sid = JointActivityDrawUpModel:GetInstance():GetItemId(self.activityID)
    self.go_table.aortext_Num.text =
        _G.GetLangPackValue(
        langugageId.GaiLv,
        Max - JointActivityDrawUpModel:GetInstance():GetTimes(self.activityID),
        _G.GetLangPackValue(_G.ConfigManager.card_cfg[sid].Name)
    )
    self.go_table.aortext_drawNumT.text = JointActivityDrawUpModel:GetInstance():GetTotalTimes(self.activityID)
end

function JointActivityDrawUpView:DrawCard(type)
    if JointActivityDrawUpModel:GetInstance().InDrawing then
       return
    end

    --获取拥有的代币数量
    local coinNum = JointActivityDrawUpModel:GetInstance():GetPropNum(self.activityID)
    local num = 0
    if self.drawConsumeType == _G.DrawConsumeType.diamond then
        num = type == _G.DrawType.once and 1 or 10
    else
        local ten = coinNum >= 10 and 10 or coinNum
        num = type == _G.DrawType.once and 1 or (ten > 0 and ten or 10)
    end

    --获取魂玉召唤总次数
    local totalTimes = JointActivityDrawUpModel:GetInstance():GetDiamondTotalTimes(self.activityID)
    local remainTimes = totalTimes - JointActivityDrawUpModel:GetInstance():GetDiamondTimes(self.activityID)

    ---@type number 消耗模式: 1活动代币 2魂玉
    local consumeType = nil
    local consumeNum = 0
    if coinNum >= num or totalTimes == 0 or remainTimes < num then
        --检查招募券数量
        if coinNum < num then
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.GetItemWayView.Name,
                JointActivityDrawUpModel:GetInstance():GetCoinId(self.activityID)
            )
            return
        end
        consumeType = _G.DrawConsumeType.token
    else
        --检查魂玉数量
        consumeNum = JointActivityDrawUpModel:GetInstance():GetDiamondConsume(self.activityID, num)
        if type == _G.DrawType.TenTimes then
            local limited_roller_cfg = JointActivityDrawUpModel:GetInstance():Getlimited_roller_cfg(self.activityID)
            local discount = limited_roller_cfg.ticket_discount[1]
            if discount then
                consumeNum = _G.Mathf.Floor(consumeNum * discount / 10000)
            end
        end
        local ownNum = _G.StorageManager:GetInstance():GetItemCountBySid(_G.ResPropID.Diamond)
        if ownNum < consumeNum then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ResPropID.Diamond)
            return
        end
        consumeType = _G.DrawConsumeType.diamond
    end
    if num > 0 then
        if consumeType == _G.DrawConsumeType.diamond then
            _G.PopWindowManager:GetInstance():ShowDrawWindowByToggle(
                340605,
                _G.DrawRollerType.JointActivity,
                JointActivityDrawUpModel:GetInstance():GetCfgId(self.activityID),
                num,
                consumeNum,
                function()
                    JointActivityDrawUpModel:GetInstance():DrawCard(
                        self.activityID,
                        consumeType,
                        num,
                        _G.handler(self, self.RefreshView),
                        _G.handlerbind(self, self.IsEff)
                    )
                end,
                function()
                end
            )
        else
            JointActivityDrawUpModel:GetInstance():DrawCard(
                self.activityID,
                consumeType,
                num,
                _G.handler(self, self.RefreshView),
                _G.handlerbind(self, self.IsEff)
            )
        end
    end
end

--奖池
function JointActivityDrawUpView:SetRewardPoolView()
    local pool = JointActivityDrawUpModel:GetInstance():Getlimited_roller_cfg(self.activityID).pool
    for i = 1, 12 do
        local data = pool[i]
        local go_table = _G.GetAutoGoTable(self.go_table["obj_item"..i])
        self:SetRewardItem(go_table, data)
    end
end

---奖励
function JointActivityDrawUpView:SetRewardView()
    self.numTotle = JointActivityDrawUpModel:GetInstance():GetTotalTimes(self.activityID)
    if self.InitRewardList == nil then
        self.go_table.scrollloopvectical_reward:InitItemData(#self.rewards_goods, _G.handler(self, self.OnRefreshLoopListItem))
        self.InitRewardList = true
        self.go_table.scrollloopvectical_reward:ScrollToIndex(#self.rewards_goods - 1)
    else
        self.go_table.scrollloopvectical_reward:UpdateAllItem()
    end
end

function JointActivityDrawUpView:OnRefreshLoopListItem(i, item)
    if i < 0 then
        return
    end
    local eIndex = i + 1
    local side = eIndex % 2
    if side == 0 then
        side = 2
    end
    local id = item:GetInstanceIDE()
    local ctrl = self.rewardItemList[id]
    if (not ctrl) or (ctrl and ctrl[side] == nil) then
        ctrl = _G.GetAutoGoTable(item)
        ctrl[side] = _G.GetAutoGoTable(ctrl["obj_itemReward"..side])
        _G.AddViewBtnClick(ctrl["obj_itemReward"..side], _G.handlerbind(self, self.OnClickAwardBtn, ctrl))
        self.rewardItemList[id] = ctrl
    end
    ctrl.index = eIndex
    ctrl["obj_itemReward"..1]:SetActiveE(side == 1 and 1 or 0)
    ctrl["obj_itemReward"..2]:SetActiveE(side == 2 and 1 or 0)
    local go_table = ctrl[side]
    -- go_table.aortext_num.text = self.rewards_goods[eIndex][2]
    go_table.aortext_numDraw.text = _G.GetLangPackValue(90032200013, self.rewards_count[#self.rewards_count - i])
    local isGet = JointActivityDrawUpModel:GetInstance():IsReceiveAward(self.activityID, #self.rewards_count - i)
    go_table.obj_mask:SetActiveE(isGet and 1 or 0)
    local score = self.rewards_count[#self.rewards_count - i]
    local canGet = not isGet and self.numTotle >= score
    go_table.obj_eff:SetActiveE(canGet and 1 or 0)
    if canGet and go_table.eff == nil then
        local effect = _G.ConfigManager.ui_effect_cfg.ef_JointActivityDrawUpView_kuang
        _G.UIUtils.LoadEffectByCfg(
            effect,
            go_table.obj_eff,
            function(trans)
                trans:SetLocalScaleXYZ(1)
                go_table.eff = trans
            end
        )
    end
    go_table.aorbtn_click:SetActiveE((not isGet) and 1 or 0)
    self:SetRewardItem(go_table, self.rewards_goods[#self.rewards_goods - i])
    go_table.obj_line:SetActiveE(eIndex == 1 and 0 or 1)
    return item
end

---奖励点击
function JointActivityDrawUpView:OnClickAwardBtn(_, _, tb)
    local index = #self.rewards_count - tb.index + 1
    -- 判断是否满足领取条件
    local score = self.rewards_count[index]
    local isGet = JointActivityDrawUpModel:GetInstance():IsReceiveAward(self.activityID, index)
    if self.numTotle >= score and not isGet then
        self.activityCls:GetAward(
            {index},
            function(msg)
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                JointActivityDrawUpModel:GetInstance():InAward(self.activityID, index)
                self:SetRewardView()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg, nil, true)
            end
        )
    else
        require "CommonTipManager":GetInstance():OpenTip(tb.gameObject, self.rewards_goods[index][1])
    end
end

---奖励item
function JointActivityDrawUpView:SetRewardItem(go_table, data, call)
    local sid = data[1]
    local icon, quality = self:GetItemQuality(sid)
    go_table.aorimage_bg.SpriteName = iconQualityBg[quality]
    go_table.aortext_num.text = data[2]
    if _G.ConfigManager.card_cfg[sid] ~= nil then
        if go_table.obj_role then
            go_table.obj_role:SetActiveE(1)
        end
        if go_table.obj_item then
            go_table.obj_item:SetActiveE(0)
        end
        go_table.aorrawimage_role:LoadImage(icon, function ()
        if call then
            call()
        end
    end)
    else
        if go_table.obj_role then
            go_table.obj_role:SetActiveE(0)
        end
        if go_table.obj_item then
            go_table.obj_item:SetActiveE(1)
        end
        go_table.aorrawimage_icon:LoadImage(icon, function ()
        if call then
            call()
        end
    end)
    end
end

---函数功能注释
---@param 变量名 变量类型 中文描述
---@return 变量类型 中文描述
function JointActivityDrawUpView:GetItemQuality(sid)
    local icon
    local quality
    if _G.ConfigManager.item_cfg[sid] ~= nil then
        icon = _G.ConfigManager.item_cfg[sid].Icon
        quality = _G.ConfigManager.item_cfg[sid].Quality
    elseif _G.ConfigManager.artifact_cfg[sid] ~= nil then
        icon = _G.ConfigManager.artifact_cfg[sid].Icon
        quality = _G.ConfigManager.artifact_cfg[sid].Order
    elseif _G.ConfigManager.card_cfg[sid] ~= nil then
        icon = _G.ConfigManager.card_cfg[sid].Photo
        quality = _G.ConfigManager.card_cfg[sid].Order
    elseif _G.ConfigManager.spiritual_cfg[sid] ~= nil then
        icon = _G.ConfigManager.spiritual_cfg[sid].Icon
        quality = _G.ConfigManager.spiritual_cfg[sid].Order
    else
        icon = _G.ConfigManager.currency_type_cfg[sid].icon
        quality = _G.ConfigManager.currency_type_cfg[sid].Quality
    end
    return icon, quality
end

---特效显示隐藏
function JointActivityDrawUpView:IsEff(num, call, award)
    if self.playType == DrawPlayType.Play and (not self.eff) then
        self.effAutoAni.enabled = true
        self.go_table.obj_Draw:SetActiveE(0)
        self.go_table.obj_Draw:SetActiveE(1)
        self.eff = _G.TimerManager:GetInstance():GetTimer(2, self.EffClose, self, false, false, true, call, award)
        self.eff:Start()
    else
        if call then
            call()
        end
    end
end

function JointActivityDrawUpView:EffClose(call, award)
    if self.eff then
        self.eff:Stop()
        self.eff = nil
    end
    local go_table = _G.GetAutoGoTable(self.go_table.obj_itemResult)
    if call then
        call()
    end
    self.awardData = {}
    local showData
    if #award > 1 then
        self.isNotMerge = true
        for i,v in ipairs(award) do
            self:ParseSimpleAward(v)
        end
        showData = {
            [1] = self.awardData[1].sid,
            [2] = self.awardData[1].number
        }
    else
        showData = award[1].type
    end
    self:SetRewardItem(go_table, showData, function ()
        self.go_table.obj_itemResult:SetActiveE(1)
    end)
end

---更新动画播放按钮
---@param type DrawPlayType
function JointActivityDrawUpView:UpdateDrawPlayBtn(type)
    if type == nil then
        self.playType = _G.PlayerPrefsManager.GetInt("JointActivityDrawSkip")
        if self.playType == nil then
            self.playType = DrawPlayType.Play
        end
    else
        self.playType = type
    end
    _G.PlayerPrefsManager.SetInt("JointActivityDrawSkip", self.playType)
    local isPlay = self.playType == DrawPlayType.Play
    self.go_table.aorimage_auto.gameObject:SetLocalPosition(isPlay and 20 or -20, 0, 0)
    self.go_table.aortext_wenzi.text =
        _G.ConfigManager.language_package_cfg[isPlay and DrawPlayText.Open or DrawPlayText.Close]
    self.go_table.aorrawimage_skip:SetActiveE(isPlay and 1 or 0)
end

function JointActivityDrawUpView:ParseSimpleAward(data)
    local itemType = data.type or data
    if itemType[1] ~= nil then
        local type = _G.StorageManager:GetInstance():CheckSidType(itemType[1])
        if type == _G.StorageType.Card then
            table.insert(
                self.awardData,
                {
                    sid = itemType[1],
                    uid = itemType[2],
                    star = itemType[3],
                    number = 1,
                    type = 1,
                    quality = 1,
                    ispri = itemType.ispri,
                    skinIs = self.skinIs
                }
            )
        elseif type == _G.StorageType.Equipment or type == _G.StorageType.Decoration then
            --武器品质
            if type == _G.StorageType.Equipment then
                local len = itemType[3] or 1
                for i = 1, len do
                    table.insert(
                        self.awardData,
                        {
                            sid = itemType[1],
                            uid = itemType[2],
                            number = 1,
                            type = 1,
                            quality = 1,
                            ispri = itemType.ispri
                        }
                    )
                end
            else
                --刻魂品质
                table.insert(
                    self.awardData,
                    {sid = itemType[1], uid = itemType[2], number = 1, type = 1, quality = 1, ispri = itemType.ispri}
                )
            end
        elseif type == _G.StorageType.Artifact then
            table.insert(self.awardData, {sid = itemType[1], uid = itemType[2], number = itemType[3]})
        elseif type == _G.StorageType.Spiritual then
            for i = 1, itemType[3] do
                _G.table.insert(self.awardData, {sid = itemType[1], uid = itemType[2], number = 1})
            end
        else
            local addNum = itemType[2] or itemType[3]
            if self.isNotMerge then
                -- (self.awardData)
                -- ("没有合并奖励时的奖励队列")
                table.insert(
                    self.awardData,
                    {sid = itemType[1], number = addNum, type = 1, quality = 1, ispri = itemType.ispri}
                )
            else
                -- ("合并后的奖励队列")
                -- (self.awardData)
                if self.checkAward[itemType[1]] == nil then
                    table.insert(
                        self.awardData,
                        {sid = itemType[1], number = addNum, type = 1, quality = 1, ispri = itemType.ispri}
                    )
                    self.checkAward[itemType[1]] = self.awardData[#self.awardData]
                else
                    self.checkAward[itemType[1]].number = self.checkAward[itemType[1]].number + addNum
                end
            end
        end
        --type=1,卡牌，type=2，神器，type=3,货币，type=4,道具，type=5,装备，type=6，刻魂, type=7,灵契
        for i = 1, #self.awardData do
            ---取sid前三位判断是什么类型
            self.SortSid = {}
            if self.awardData[i].sid > _G.ItemSidJudgeSection.ResPropMax then
                self.SortSid = self.awardData[i].sid
                repeat
                    self.SortSid = self.SortSid / 10
                until self.SortSid < 1000
                local a, b = math.modf(self.SortSid)
                self.SortSid = a
            else
                self.SortSid = self.awardData[i].sid
            end
            if self.awardData[i].sid <= _G.ItemSidJudgeSection.ResPropMax then
                --self.awardData.type=2，货币资源
                self.awardData[i].type = TypeEnum.Currency
            elseif self.SortSid >= 100 and self.awardData[i].sid <= 200 then
                --self.awardData.type=1，卡牌
                self.awardData[i].type = TypeEnum.Card
            elseif self.SortSid == 201 then
                --self.awardData.type=4，装备
                self.awardData[i].type = TypeEnum.Equipment
            elseif self.SortSid == 251 then
                self.awardData[i].type = TypeEnum.Decoration
            elseif self.SortSid == 255 then --神器
                self.awardData[i].type = TypeEnum.Artifact
            elseif self.SortSid == 256 then
                ---灵契
                self.awardData[i].type = TypeEnum.Spiritual
            elseif self.SortSid >= 202 then
                --self.awardData.type=3，道具
                self.awardData[i].type = TypeEnum.Prop
            --self.awardData.type=5,刻魂
            end
        end
        --获取品质
        for i = 1, #self.awardData do
            local list = self.awardData[i]
            if list.type == TypeEnum.Card then
                if currencySids[list.sid] then
                    list.type = TypeEnum.Prop
                    self.awardData[i].quality = _G.ConfigManager.currency_type_client_cfg[list.sid].quality
                else
                    self.awardData[i].quality = _G.ConfigManager.card_cfg[list.sid].Order
                end
            elseif list.type == TypeEnum.Currency then
                if currencySids[list.sid] then
                    list.type = TypeEnum.Prop
                    self.awardData[i].quality = _G.ConfigManager.currency_type_client_cfg[list.sid].quality
                else
                    self.awardData[i].quality = _G.ConfigManager.currency_type_cfg[list.sid].Quality
                end
            elseif list.type == TypeEnum.Prop then
                self.awardData[i].quality = _G.ConfigManager.item_cfg[list.sid].Quality
            elseif list.type == TypeEnum.Equipment then
                self.awardData[i].quality = _G.ConfigManager.equipment_cfg[list.sid].grade
            elseif list.type == TypeEnum.Decoration then
                self.awardData[i].quality = _G.ConfigManager.decoration_cfg[list.sid].grade
            elseif list.type == TypeEnum.Artifact then
                self.awardData[i].quality = _G.ConfigManager.artifact_cfg[list.sid].Order
            elseif list.type == TypeEnum.Spiritual then
                self.awardData[i].quality = _G.ConfigManager.spiritual_cfg[list.sid].Order
            end
        end
        if not self.isNotSort then
            _G.SortList(
                self.awardData,
                function(a)
                    return -a.type, a.quality, -a.sid
                end
            )
        end
    end
end

function JointActivityDrawUpView:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.LoadConsumesInfos, self)
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.ResRefresh, self.LoadConsumesInfos, self)
    if self.activityTimer then
        self.activityTimer:Stop()
        self.activityTimer = nil
    end
end


return JointActivityDrawUpView