---倒计时
function JointActivityDrawUpView:UpdateTimer()
    local leftTime = JointActivityDrawUpModel:GetInstance():GetTime(self.activityID)
    if leftTime <= 0 then
        self.activityTimer:Stop()
        self.go_table.aortext_Timer.text = ""
        self:Close()
    else
        self.go_table.aortext_Timer.text =
            _G.GetLangPackValue(langugageId.Tiem, _G.TimeUtil.TranslateSecondForStrMiaoHui(leftTime, 1))
    end
end

