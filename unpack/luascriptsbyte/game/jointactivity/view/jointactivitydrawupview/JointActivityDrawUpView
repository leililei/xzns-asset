---按钮点击事件在这里派发
function JointActivityDrawUpView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
       self:Close()
    elseif go == self.go_table.aorbtn_selectCard then
        ---切换心愿灵兽
        if JointActivityDrawUpModel:GetInstance().InDrawing then
            return
        end
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.JoinActivityDrawUpMainSelectView.Name,
            self.activityID,
            function()
                self:SwitchImage()
                self:SetTipInfo()
            end
        )
    elseif go == self.go_table.aorbtn_DrawOnce then
        ---抽一次
        if self.playType == DrawPlayType.Play and self.eff then
            return
        end
        self.go_table.obj_itemResult:SetActiveE(0)
        self:DrawCard(_G.DrawType.once)
    elseif go == self.go_table.aorbtn_DrawTenTimes then
        ---抽十次
        if self.playType == DrawPlayType.Play and self.eff then
            return
        end
        self.go_table.obj_itemResult:SetActiveE(0)
        self:DrawCard(_G.DrawType.TenTimes)
    elseif go == self.go_table.aorbtn_baodian then
        ---宝典
        if JointActivityDrawUpModel:GetInstance().InDrawing then
            return
        end
        _G.GlobalInterface.JumpActivityByGM(10027, self.activity:GetJumpType(self.activityID))
    elseif go == self.go_table.aorbtn_LiBao then
        ---礼包
        if JointActivityDrawUpModel:GetInstance().InDrawing then
            return
        end
        _G.GlobalInterface.JumpActivityByGM(10014, self.activity:GetJumpType(self.activityID))
    elseif go == self.go_table.aorbtn_task then
        ---任务
        if JointActivityDrawUpModel:GetInstance().InDrawing then
            return
        end
        _G.GlobalInterface.JumpActivityByGM(10007, self.activity:GetJumpType(self.activityID))
    elseif go == self.go_table.aorbtn_help1 then
        ---帮助信息
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 144)
    elseif go == self.go_table.aorbtn_autoLeft then
        self:UpdateDrawPlayBtn(1 - self.playType)
    end
end

