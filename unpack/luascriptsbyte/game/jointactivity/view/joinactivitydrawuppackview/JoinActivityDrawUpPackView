local baseView = require("DrawUpPackView")
---@class JoinActivityDrawUpPackView : UIBaseView	中文描述
---@field public go_table JoinActivityDrawUpPackView_GoTable GoTable
local JoinActivityDrawUpPackView = _G.BaseClass("JoinActivityDrawUpPackView", baseView)

---界面的入口函数
function JoinActivityDrawUpPackView:OnCreate(data, type_enum)
    self.GetJumpType = require "ActivitySynManager":GetInstance():GetChildAcitivity(10044, data:GetJumpType())
    self.ActivityID = self.GetJumpType.activityID
    if not _G.IsNil(self.go_table.obj_goldInfo) and self.go_table.obj_goldInfo:GetctiveInHierarchy() == 1 then
        ---添加要显示的货币或者资源
        local resources = _G.ConfigManager.ui_cfg.JoinActivityDrawUpPackView.resources
        if #resources > 0 then
            self:AddComponent(
                self.go_table.obj_goldInfo,
                require("ResourceCompont").New(self.go_table.obj_goldInfo, resources)
            )
        end
    end
    baseView.UpdateView(self, data, type_enum)
    if not _G.string.IsNullOrEmpty(data.cfg.info.icon) and data.cfg.info.icon ~= "test" then
        self.go_table.aorrawimage_titlebg:LoadImage(
                "ImagesH5/" .. data.cfg.info.icon,
                function(raw)
                    raw:SetNativeSize()
                end
        )
    else
        self.go_table.aorrawimage_titlebg:SetActiveE(0)
    end
    baseView.UIEffect(self)
end

return JoinActivityDrawUpPackView