local JointActivityDrawUpModel = require("JointActivityDrawUpModel")
---@class JoinActivityDrawUpMainSelectView : UIBaseView	限时招募心愿角色选择界面
---@field public go_table JoinActivityDrawUpMainSelectView_GoTable GoTable
local JoinActivityDrawUpMainSelectView = _G.BaseClass("JoinActivityDrawUpMainSelectView", _G.UIBaseView)

local table = _G.table
--1-坦克；2-战士；3-法师；4-辅助；5-游侠
local IconType = _G.ProfessionalIcon

function JoinActivityDrawUpMainSelectView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param activityID number 活动id
---@param callback function 回调函数
function JoinActivityDrawUpMainSelectView:OnCreate(activityID, callback)
    self.callback = callback
    self.activityID = activityID
    ---当前选中的卡牌sid
    self.cardId = JointActivityDrawUpModel:GetInstance():GetItemId(activityID)
    ---在选择解决新选中的卡牌sid
    self.selectCardId = self.cardId
    ---缓存所有的卡牌数据
    self.CardData = {}
    ---当前选中五行属性(0是全部)
    self.curElement = 0
    self.itemList = {}
    self:InitSelectData()
    self:PlayAni()
end

---初始化可选择数据
function JoinActivityDrawUpMainSelectView:InitSelectData()
    local limitedId = JointActivityDrawUpModel:GetInstance():Getlimited_itemId(self.activityID)
    local StorageManager = _G.StorageManager:GetInstance()
    local cardData = {}
    for _, v in ipairs(limitedId) do
        if v[3] > 0 then
            local data = StorageManager:GetMaxStarCardBySid(v[1])
            if not data then
                data = StorageManager:GetItemDataClass(v[1], 1)
            end
            table.insert(cardData, data)
        end
    end
    local max = _G.ConfigManager.discrete_cfg[103704][1][1]
    _G.SortList(
        cardData,
        function(a)
            local god = a:GetElement() == _G.CardElementType.God and 1 or 0
            local isCur = a.sid == self.selectCardId and 1 or 0
            local haveCard = a.sid ~= a.uid and 1 or 0
            local isMax = a.star < max and 1 or 0
            return isCur, isMax, god, haveCard, a.sid
        end
    )
    self.CardData[0] = cardData
    self.curCardData = cardData
    if self.selectCardId and self.selectCardId > 0 then
        self:UpdateCardShow(self.curCardData[1])
    end
    self.go_table.scrollloopvectical_CardList:InitItemData(
        #self.CardData[self.curElement],
        _G.handler(self, self.RefreshList)
    )
end

---更新卡牌显示
---@param data CardData 卡牌数据
function JoinActivityDrawUpMainSelectView:UpdateCardShow(data)
    local path = data.cfg.Photo
    -- self.go_table.aorrawimage_role:LoadImage(path, function()
    --     if not _G.IsNil(self.go_table.aorrawimage_role) then
    --         self.go_table.aorrawimage_role:SetNativeSize()
    --     end
    -- end)
    self.go_table.aorrawimage_role:LoadImage("")

    _G.UIUtils.RemoveChildren(self.go_table.aorrawimage_role)

    local card_cfg = _G.ConfigManager.card_cfg[self.selectCardId]

    self.cfgid = card_cfg.id

    require("CardInfoManager"):GetInstance().GetRole(
        card_cfg.ModelPathHi,
        _G.ePoolType.Temporary,
        self.go_table.aorrawimage_role,
        nil,
        function(trans)
            if self:IsNil() or self.cfgid ~= card_cfg.id then
                _G.DestroyObject(trans)
            end

            trans:SetLocalScaleXYZ(0.6)
            trans:SetLocalPosition(0, -366, 0)
        end
    )


    _G.GameUtil.SetActiveByCondition(
        self.go_table.obj_GodNum,
        not _G.string.IsNullOrEmpty(path)
    )

    JointActivityDrawUpModel:GetInstance():SetWish(
        self.activityID,
        self.selectCardId,
        nil,
        function()
            self:OnSetWishSucessCall()
        end
    )
    local num = JointActivityDrawUpModel:GetInstance():GetLeftGuaranteed(self.activityID) or 0
    self.go_table.aortext_num.text = num
    self.go_table.aortext_name2.text = _G.LangUtil.GetLangPackValue(data.cfg.Name)
end

---设置成功回调
function JoinActivityDrawUpMainSelectView:OnSetWishSucessCall()
    if self.callback then
        self.callback()
    end
end

---刷新卡牌显示
function JoinActivityDrawUpMainSelectView:RefreshList(index, obj)
    local instanceID = obj:GetInstanceIDE()
    local tb = self.itemList[instanceID]
    local data = self.curCardData[index + 1]
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickItem, tb))
        tb.item = require "ItemCardAllView".New(tb.obj_node:GetChildE(0))
        self.itemList[instanceID] = tb
        tb.aorbtn_click.LongPress = true
        tb.aorbtn_click.onLongPress = _G.handlerbind(self, self.OnLongPress, tb)
    end
    tb.item:ShowCardData(data, nil, false)
    tb.index = index + 1
    _G.GameUtil.SetActiveByCondition(tb.obj_gou, data.sid == self.selectCardId)
    tb.aorimage_Icon.SpriteName = IconType[data.cfg.Professional]
    tb.aortext_tip.text = _G.ConfigManager.language_package_cfg[data.cfg.recommend_doc[1]]
end

function JoinActivityDrawUpMainSelectView:OnClickItem(go, isOn, tb)
    local data = self.curCardData[tb.index]
    self.selectCardId = data.sid
    local pan = false
    if tb.obj_gou:GetActiveSelf() == 1 then
        return
    end
    if self.selectCardId then
        local id = _G.tonumber(data.sid)
        pan = _G.StorageManager:GetInstance():GetIDMax(id, id)
    end
    if pan then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            622,
            nil,
            function()
                self.go_table.scrollloopvectical_CardList:UpdateAllItem()
                self:UpdateCardShow(data)
            end
        )
    else
        self.go_table.scrollloopvectical_CardList:UpdateAllItem()
        self:UpdateCardShow(data)
    end
end

---Toggle点击事件
function JoinActivityDrawUpMainSelectView:OnToggle(go, isOn)
    local name = go:GetName()
    if not _G.string.contains(name, "toggle") then
        return
    end
    local str = _G.string.replace(name, "$_toggle_", "")
    local element = _G.tonumber(str)
    if not self.CardData[element] then
        local tb = {}
        for _, v in pairs(self.CardData[0]) do
            if require "CardInfoManager":GetInstance():CheckMultiMatchCOP(v.cfg.Elements_new, element) then
                _G.table.insert(tb, v)
            end
        end
        self.CardData[element] = tb
    end
    self.curElement = element
    self.curCardData = self.CardData[element]
    self.go_table.scrollloopvectical_CardList:UpdateCount(#self.curCardData)
end

---界面的销毁函数
function JoinActivityDrawUpMainSelectView:OnDestroy()
    self.callback = nil
    if self.tweer then
        self.tweer:Kill()
        self.tweer = nil
    end
end

---按钮点击事件在这里派发
function JoinActivityDrawUpMainSelectView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_closeView then
        self:Close()
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_enter then
        self:Close()
    elseif go == self.go_table.aorbtn_detail then
        require("CommonTipManager"):GetInstance():OpenCardTip(self.selectCardId, self.selectCardId)
    else
        self:OnToggle(go, isOn)
    end
end

---播放动画
function JoinActivityDrawUpMainSelectView:PlayAni()
    local Tweening = _G.CS.DG.Tweening
    self.tweer =
        self.go_table.obj_ring2:DOLocalMoveY(34, 1):SetEase(Tweening.Ease.InOutSine):SetLoops(
            -1,
            Tweening.LoopType.Yoyo
        )
end

return JoinActivityDrawUpMainSelectView
