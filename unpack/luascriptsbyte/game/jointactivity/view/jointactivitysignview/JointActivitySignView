---@class JointActivitySignView : UIBaseView	中文描述
---@field public go_table JointActivitySignView_GoTable GoTable
local JointActivitySignView = _G.BaseClass("JointActivitySignView", _G.UIBaseView)

function JointActivitySignView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function JointActivitySignView:OnCreate(curActivityClass)
    self.activityClass = curActivityClass
    self.curActivityId = curActivityClass:GetActivityID()
    ---主活动的活动id
    self.jointActivityModel = require("JointActivityModel"):GetInstance()
    ---签到配置
    self.signData = self.jointActivityModel:GetSignItem(self.curActivityId)
    _G.SortList(
        self.signData,
        function(data)
            return -data.sid
        end
    )
    self.initView = true
    self.itemCorList = {}
    self.go_table.scrollloophorizontal_item:InitItemData(#self.signData, _G.handler(self, self.RefreshList))
    self.waitCor = _G.DelayFrameDo(function()
        if self:IsNil() then
            return
        end
        self.initView = false
    end)
    ---活动结束时间
    local time = self.activityClass.cfg.time
    self.activityFinishTime = time.start_time + time.run_time
    self.activityTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimer, self, false, false, true)
    self.activityTimer:Start()
    self:UpdateTimer()
    self:LoadEffect()
    self:AddListener(_G.eSixUpdate.SixClockUpdate, self.OnSixUpdate, self)
end

---特效
function JointActivitySignView:LoadEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_JointActivitySignView_bg,
        self.go_table.obj_BgEffect,
        function(effect)
            if not self.go_table then
                _G.UIUtils.RemoveEffect(effect)
            end
        end
    )
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_JointActivitySignView_front,
        self.go_table.aorrawimage_title,
        function(effect)
            if not self.go_table then
                _G.UIUtils.RemoveEffect(effect)
            end
        end
    )
end

function JointActivitySignView:OnSixUpdate()
    self.go_table.scrollloophorizontal_item:UpdateAllItem()
end

function JointActivitySignView:UpdateTimer()
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    if self.activityFinishTime > serverTime then
        self.go_table.aortext_time.text = _G.GetLangPackValue(
            90028900002,
            _G.TimeUtil.TranslateSecondForStrMiaoHui(self.activityFinishTime - serverTime)
        )
    else
        self:Close()
    end
end

function JointActivitySignView:RefreshList(index, obj)
    local data = self.signData[index + 1]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, data))
    if self.initView then
        tb.trans_item:SetActiveE(0)
    end
    tb.aortext_day.text = _G.GetLangPackValue(
        90023800006,
        _G.GameUtil.NumberToChinese(index + 1)
    )
    tb.trans_content:ClearChildren()
    for _, v in ipairs(data.award) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            v.type,
            tb.trans_content,
            function(item)
                if _G.IsNil(tb.trans_content) then
                    _G.DestroyObject(item)
                    return
                end
                item.gameObject:SetLocalScaleXYZ(0.9)
                if item.ShowNumText then
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
                item:ShowEffect(true)
                local state = self.jointActivityModel:GetSignAwardState(self.curActivityId, data.sid)
                item:SetGou(state == 2)
            end,
            function(go, isOn)
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, v.type[1])
            end
        )
    end
    local state = self.jointActivityModel:GetSignAwardState(self.curActivityId, data.sid)
    tb.aorbtn_reveive:SetActiveE(state == 1 and 1 or 0)
    tb.obj_received:SetActiveE(state == 2 and 1 or 0)
    if self.itemCorList[index + 1] then
        _G.coroutine.stopwaiting(self.itemCorList[index + 1])
        self.itemCorList[index + 1] = nil
    end
    self.itemCorList[index + 1] = _G.DelayDo((index + 1) * 0.05, function()
        if self:IsNil() then
            return
        end
        tb.trans_item:SetActiveE(1)
        self.itemCorList[index + 1] = nil
    end)
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_JointActivitySignView_light,
        tb.aorrawimage_bg,
        function(effect)
            if not self.go_table then
                _G.UIUtils.RemoveEffect(effect)
            end
        end
    )
    if state == 1 then
        if tb.obj_effect:GetChildCountE() == 0 then
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_JointActivitySignView_kuang,
                tb.obj_effect,
                function(effect)
                    if not self.go_table then
                        _G.UIUtils.RemoveEffect(effect)
                    end
                end
            )
        end
    else
        tb.obj_effect:ClearChildren()
    end
end

function JointActivitySignView:OnClickItem(_, _, data)
    local state = self.jointActivityModel:GetSignAwardState(self.curActivityId, data.sid)
    if state == 1 then
        self.jointActivityModel:GetSignAward(self.curActivityId, data, function()
            self.go_table.scrollloophorizontal_item:UpdateAllItem()
        end)
    end
end

---界面的销毁函数
function JointActivitySignView:OnDestroy()
    if self.activityTimer then
        self.activityTimer:Stop()
        self.activityTimer = nil
    end
    self:RemoveAllListener()
    if self.waitCor then
        _G.coroutine.stopwaiting(self.waitCor)
        self.waitCor = nil
    end
    if self.itemCorList then
        for _, v in pairs(self.itemCorList) do
            if v then
                _G.coroutine.stopwaiting(v)
            end
        end
        self.itemCorList = nil
    end
end

---按钮点击事件在这里派发
function JointActivitySignView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_closeView then
        self:Close()
    end
end

return JointActivitySignView
