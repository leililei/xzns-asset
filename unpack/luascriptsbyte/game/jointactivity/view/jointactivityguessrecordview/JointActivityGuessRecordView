---@class JointActivityGuessRecordView : UIBaseView	中文描述
---@field public go_table JointActivityGuessRecordView_GoTable GoTable
local JointActivityGuessRecordView = _G.BaseClass("JointActivityGuessRecordView", _G.UIBaseView)

local rangeKey = {
    90029100028,
    90029100029
}

function JointActivityGuessRecordView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function JointActivityGuessRecordView:OnCreate(activityId, activitySynModel)
    self.activityId = activityId
    self.activitySynModel = activitySynModel
    self.allGuessData = self.activitySynModel:GetAllSessionInfo(activityId)
    self.go_table.scrollloopvectical_record:InitItemData(#self.allGuessData, _G.handler(self, self.RefreshList))
end

function JointActivityGuessRecordView:RefreshView()
    self.allGuessData = self.activitySynModel:GetAllSessionInfo(self.activityId)
    self.go_table.scrollloopvectical_record:UpdateAllItem()
end

function JointActivityGuessRecordView:RefreshList(index, obj)
    local data = self.allGuessData[index + 1]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, data))
    tb.aortext_time.text = self:FormatTime(data.time_start)
    tb.aortext_num.text = _G.GetLangPackValue(rangeKey[_G.Mathf.Floor(data.f_index % 10)])
    local leftCfg = _G.ConfigManager.activity_joint_monster_cfg[data.array[1]]
    tb.aorrawimage_pet1:LoadImage(
        leftCfg.Icon,
        function(image)
            if self:IsNil() then
                return
            end
            image:SetActiveE(1)
        end
    )
    local rightCfg = _G.ConfigManager.activity_joint_monster_cfg[data.array[2]]
    tb.aorrawimage_pet2:LoadImage(
        rightCfg.Icon,
        function(image)
            if self:IsNil() then
                return
            end
            image:SetActiveE(1)
        end
    )
    local isGuessFinish = _G.TimeUtil.GetServerUnixTime() >= data.time_end
    local bet = data.bet or 0
    if isGuessFinish and data.bet and data.bet > 0 then
        tb.aorbtn_box:SetActiveE(1)
        tb.aorimage_award.SpriteName = data.award == 0 and "ui_zjm_btn_baoxiang2" or "ui_zjm_btn_baoxiang1"
        tb.obj_noGuess:SetActiveE(0)
        tb.obj_Guess:SetActiveE(0)
        tb.obj_result1:SetActiveE(data.bet == data.array[1] and 1 or 0)
        if data.bet == data.array[1] then
           tb.aorimage_result1.SpriteName = data.win == data.bet and "ui_hjdj_txt_jccg" or "ui_hjdj_txt_jcsb"
        end
        tb.obj_result2:SetActiveE(data.bet == data.array[2] and 1 or 0)
        if data.bet == data.array[2] then
            tb.aorimage_result2.SpriteName = data.win == data.bet and "ui_hjdj_txt_jccg" or "ui_hjdj_txt_jcsb"
         end
    else
        tb.obj_noGuess:SetActiveE(bet == 0 and 1 or 0)
        tb.obj_Guess:SetActiveE(bet > 0 and 1 or 0)
        tb.aorbtn_box:SetActiveE(0)
        tb.obj_result1:SetActiveE(0)
        tb.obj_result2:SetActiveE(0)
    end
    tb.aorbtn_record:SetActiveE(isGuessFinish and 1 or 0)
end

function JointActivityGuessRecordView:FormatTime(time)
    local newTime = _G.TimeUtil.GetDateTime(time)
    return newTime.year .. "." .. newTime.month .. "." .. newTime.day
end

---奖励提示
function JointActivityGuessRecordView:OnClickAwardTipView(data, go)
    if not self.clickIndex then
        self.clickIndex = -1
    end
    if self.go_table.aorbtn_TipsView:GetActiveSelf() == 1 or not data then
        self.go_table.obj_Parent:ClearChildren()
        self.go_table.aorbtn_TipsView:SetActiveE(0)
        return
    end

    local isWin = data.bet == data.win
    local award = isWin and data.win_award or data.lose_award
    local awardList = {}
    for _, v in pairs(award) do
        _G.table.insert(awardList, v.type)
    end
    if isWin then
        for _, v in pairs(data.win_coin or {}) do
            _G.table.insert(awardList, { v.coin[2], v.coin[1] })
        end
    else
        for _, v in pairs(data.lose_coin or {}) do
            _G.table.insert(awardList, { v.coin[2], v.coin[1] })
        end
    end
    if self.go_table.aorbtn_TipsView:GetActiveSelf() == 0 then
        local tf = self.go_table.obj_ItemTips:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
        if not _G.IsNil(tf) then
            tf:SetSizeWithCurrentAnchors(_G.CS.UnityEngine.RectTransform.Axis.Horizontal, #awardList * 68)
        end
        self.go_table.aorbtn_TipsView:SetActiveE(1)
    end
    for _, v in ipairs(awardList) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            v,
            self.go_table.obj_Parent,
            function(item)
                if not self:IsNil() or _G.IsNil(self.go_table.obj_Parent) then
                    item.gameObject:SetLocalScaleXYZ(0.7)
                    item.gameObject:SetActiveE(1)
                    item:SetGou(true)
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
            end,
            function(go)
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, v[1])
            end
        )
    end
    local x, y, z = go:GetPosition()
    local nx, ny = _G.UIManager:GetInstance().UICamera:WorldToScreenPointE(x, y, z)
    local topLayer = _G.UIManager:GetInstance().TopLayer:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    local _, outPos =
        _G.CS.UnityEngine.RectTransformUtility.ScreenPointToLocalPointInRectangle(topLayer,
            _G.Vector2.New(nx, ny), _G.UIManager:GetInstance().UICameraTop)
    self.go_table.obj_ItemTips:SetLocalPosition(outPos.x, outPos.y + 70, 0)
end

function JointActivityGuessRecordView:OnClickItem(go, _, data)
    local name = go:GetName()
    if name == "@_aorbtn_record" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.JointActivityGuessPlayBackView.Name, data
            .report_id)
    elseif name == "@_aorbtn_box" then
        if _G.TimeUtil.GetServerUnixTime() >= data.time_end and data.bet > 0 and data.award == 0 then
            self.activitySynModel:GetGuessAward(data.f_index, function()
                if self:IsNil() then
                    return
                end
                self.go_table.scrollloopvectical_record:UpdateAllItem()
            end)
        else
            self:OnClickAwardTipView(data, go)
        end
    end
end

---界面的销毁函数
function JointActivityGuessRecordView:OnDestroy()
end

---按钮点击事件在这里派发
function JointActivityGuessRecordView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_TipsView then
        self:OnClickAwardTipView()
    end
end

return JointActivityGuessRecordView
