---@class JointActivityGuessView : UIBaseView	中文描述
---@field public go_table JointActivityGuessView_GoTable GoTable
local JointActivityGuessView = _G.BaseClass("JointActivityGuessView", _G.UIBaseView)

local moveChatWindowRange = { -1305, 435 }
local distance = _G.ConfigManager.discrete_cfg[105723][1][1]
---第一轮和第二轮倒计时文本
local timeKey = {
    90032200003,
    90032200004
}

function JointActivityGuessView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.skillTipTb = _G.GetAutoGoTable(self.go_table.obj_skillTip, _G.handler(self, self.OnClickSkillTip))
    self.betInfoItemDic = {}
    self.chatMsgMaxCount = _G.ConfigManager.discrete_cfg[105717][1][1]
end

---界面的入口函数
---@param activity ActivitySynBase
---@param activitySynModel JointActivityGuessSynModel
function JointActivityGuessView:OnCreate(activity)
    self.activity = activity
    self.activitySynModel = activity.typeClass
    self.activityId = activity:GetActivityID()
    self:AddComponent(
        self.go_table.trans_resources,
        require("ResourceCompont").New(
            self.go_table.trans_resources,
            _G.ConfigManager.ui_cfg.JointActivityGuessView.resources
        )
    )
    self.chatWindowItem = {
        self.go_table.aorimgtext_1,
        self.go_table.aorimgtext_2,
        self.go_table.aorimgtext_3,
        self.go_table.aorimgtext_4,
        self.go_table.aorimgtext_5,
        self.go_table.aorimgtext_6
    }
    self.moveChatWindowX = moveChatWindowRange[2]
    local discrete_cfg = _G.ConfigManager.discrete_cfg
    self.moveChatWindowSpeed = discrete_cfg[105716][1][1] * moveChatWindowRange[2]
    self.chatWindowStartTime = discrete_cfg[105719][1][1]
    local todaySessions = self.activitySynModel:GetTodaySessions()
    ---默认选中当前战斗未结束的轮次
    self.sessionIndex = 1
    for i, v in ipairs(todaySessions) do
        if _G.TimeUtil.GetServerUnixTime() < v.time_end then
            self.sessionIndex = i
            break
        end
    end
    self.go_table.toggle_first.isOn = self.sessionIndex == 1
    self.go_table.toggle_second.isOn = self.sessionIndex == 2
    self:RefreshView()
    self:LoadEffect()
    if _G.PlayerPrefsManager.GetInt("JointActivityGuess_" .. self.activityId, 0) == 0 then
        _G.PlayerPrefsManager.SetInt("JointActivityGuess_" .. self.activityId, 1)
        self.activitySynModel:RefreshRedPoint(1)
    end
    self.go_table.obj_courseredpoint:UpdateRedPointItemIDAndParam(
        self.activitySynModel:GetRedpointIDByIndex(2)
    )
end

---特效
function JointActivityGuessView:LoadEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_JointActivityGuessView,
        self.go_table.obj_effect,
        function(effect)
            if not self.go_table then
                _G.UIUtils.RemoveEffect(effect)
            end
        end
    )
end

---刷新界面
function JointActivityGuessView:RefreshView()
    self:RefreshActInfo()
    self:RefreshPetInfo()
    self:RefreshPetSkill()
    self:RefreshPetProp()
    self:RefreshGuessBtn()
    self:ShowSessionInfo()
    self:ShowChatWindow()
end

---活动信息
function JointActivityGuessView:RefreshActInfo()
    self.guessData = self.activitySynModel:GetTodaySessions(self.sessionIndex)
    self.go_table.aortext_tip.text = _G.GetLangPackValue(
        90032200002,
        self.activitySynModel:GetGuessStartTime(1),
        self.activitySynModel:GetGuessStartTime(2)
    )
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    if self.betEndTimer then
        self.betEndTimer:Stop()
        self.betEndTimer = nil
    end
    self.betLeftTime = self.guessData.time_end
    if serverTime < self.betLeftTime then
        self.go_table.aortext_time.text = _G.GetLangPackValue(
            timeKey[self.sessionIndex],
            _G.TimeUtil.TimeToString(self.betLeftTime - serverTime, 1)
        )
        self.betEndTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimer, self, false, false, true)
        self.betEndTimer:Start()
        self:UpdateTimer()
    else
        self.go_table.aortext_time.text = _G.GetLangPackValue(90032200008)
    end
end

function JointActivityGuessView:UpdateTimer()
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    if serverTime < self.betLeftTime then
        self.go_table.aortext_time.text = _G.GetLangPackValue(
            timeKey[self.sessionIndex],
            _G.TimeUtil.TimeToString(self.betLeftTime - serverTime, 1)
        )
    else
        if self.betEndTimer then
            self.betEndTimer:Stop()
            self.betEndTimer = nil
        end
        self.go_table.aortext_time.text = _G.GetLangPackValue(90032200008)
        _G.PopWindowManager:GetInstance():ShowAllTips(630101)
        self:RefreshGuessBtn()
    end
end

---刷新灵兽数据
function JointActivityGuessView:RefreshPetInfo()
    ---加载灵兽的spine
    local function LoadSpine(parent, spinePath, portrait, scale)
        _G.UIUtils.LoadEffectByPath(spinePath, parent, function(trans)
            if self:IsNil() then
                _G.UIUtils.RemoveEffect(trans)
                return
            end
            trans:SetLocalPosition(portrait[1] or 0, portrait[2] or 0, portrait[3] or 0)
            trans:SetLocalScale(scale[1] or 1, scale[2] or 1, 1)
        end)
    end
    local monsterCfg = _G.ConfigManager.activity_joint_monster_cfg
    local array = self.guessData and self.guessData.array or {}
    if array[1] then
        local cfg = monsterCfg[array[1]] or {}
        self.go_table.obj_leftPet:ClearChildren()
        LoadSpine(self.go_table.obj_leftPet, cfg.pic, cfg.left_portrait or {}, cfg.left_size or {})
    end
    if array[2] then
        local cfg = monsterCfg[array[2]] or {}
        self.go_table.obj_rightPet:ClearChildren()
        LoadSpine(self.go_table.obj_rightPet, cfg.pic, cfg.right_portrait or {}, cfg.right_size or {})
    end
end

---灵兽属性
function JointActivityGuessView:RefreshPetProp()
    local type_attribute_cfg = _G.ConfigManager.type_attribute_cfg
    local function ShowProp(id, parentObj)
        local cfg = _G.ConfigManager.activity_joint_monster_cfg[id]
        local propList = {}
        _G.table.insert(propList, { key = "atk", sortId = _G.AttrType["atk"].sortid, num = cfg.atk })
        _G.table.insert(propList, { key = "def", sortId = _G.AttrType["def"].sortid, num = cfg.def })
        _G.table.insert(propList, { key = "max_hp", sortId = _G.AttrType["max_hp"].sortid, num = cfg.max_hp })
        _G.table.insert(propList, { key = "all_speed", sortId = _G.AttrType["all_speed"].sortid, num = cfg.all_speed })
        parentObj:ClearChildren()
        for _, v in pairs(propList) do
            local tran = _G.InstantiateObject(self.go_table.obj_propItem, parentObj)
            if tran then
                local tb = _G.GetAutoGoTable(tran)
                tb.aortext_prop.text = _G.GetLangPackValue(type_attribute_cfg[_G.AttrType[v.key].ID].name) ..
                    "：" .. _G.GameUtil.NumberWY(_G.math.floor(v.num or 0))
            end
        end
    end
    local array = self.guessData and self.guessData.array or {}
    if array[1] then
        ShowProp(array[1], self.go_table.obj_leftPropGrid)
    end
    if array[2] then
        ShowProp(array[2], self.go_table.obj_rightPropGrid)
    end
end

---灵兽技能
function JointActivityGuessView:RefreshPetSkill()
    local function ShowSkill(id, parentObj)
        local cfg = _G.ConfigManager.activity_joint_monster_cfg[id]
        parentObj:ClearChildren()
        for i, v in ipairs(cfg.skill_icon) do
            local tran = _G.InstantiateObject(self.go_table.obj_skillItem, parentObj)
            if tran then
                local tb = _G.GetAutoGoTable(tran, _G.handlerbind(self, self.OnClickSkillItem, cfg.skill_desc[i]))
                tb.aorrawimage_icon:LoadImage(v)
            end
        end
    end
    local array = self.guessData and self.guessData.array or {}
    if array[1] then
        ShowSkill(array[1], self.go_table.trans_LeftSkill)
    end
    if array[2] then
        ShowSkill(array[2], self.go_table.trans_RightSkill)
    end
end

