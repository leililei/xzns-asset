---@class JointActivityDrawUpAwardPreView : UIBaseView	中文描述
---@field public go_table JointActivityDrawUpAwardPreView_GoTable GoTable
local JointActivityDrawUpAwardPreView = _G.BaseClass("JointActivityDrawUpAwardPreView", _G.UIBaseView)
local limitedCfg = _G.ConfigManager.limited_roller_cfg
--_G.JointActivityDrawUpAwardPreView = JointActivityDrawUpAwardPreView
function JointActivityDrawUpAwardPreView:Awake()
    self.AwardDatas = {}
    self.itemList = {}
    self.weight = 0
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param sid number 奖池idp
function JointActivityDrawUpAwardPreView:OnCreate(sid, activityId)
    local Jackpot = sid and sid or 50001
    local insert = _G.table.insert
    local data = limitedCfg[Jackpot]
    if data then
        local grandPrize = {}
        local limited_item = data.limited_item or {}
        local cardId  = require "JointActivityDrawUpModel":GetInstance():GetItemId(activityId)
        for _, v in pairs(limited_item) do
            if cardId == v[1] then
                grandPrize.sid = v[1]
                grandPrize.num = v[2] or 0
                grandPrize.weight = v[3] or 0
                grandPrize.Grand = true
                self.weight = self.weight + grandPrize.weight
                insert(self.AwardDatas, grandPrize)
                break
            end
        end
        for k,v in pairs(data.pool) do
            local item ={}
            item.sid = v[1]
            item.num = v[2]
            item.weight = v[3] or 0
            self.weight = self.weight + item.weight
            insert(self.AwardDatas,item)
        end
    end
    _G.SortList(self.AwardDatas,function(a)
        local type = 0
        if a.Grand then
            type = 1
        end
        return type, - a.weight ,-a.sid
    end)

    self.go_table.scrollloopvectical_AwardList:InitItemData(#self.AwardDatas, _G.handler(self, self.RefreshList))
end
---刷新显示
function JointActivityDrawUpAwardPreView:RefreshList(index, obj)
    local instanceID = obj:GetInstanceIDE()
    local tb = self.itemList[instanceID]
    local data = self.AwardDatas[index + 1]
    if not data then
        return
    end
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        self.itemList[instanceID] = tb
        ---@type BaseAwardNewItem
        tb.item = require "BaseAwardNewItem".New(tb.obj_Root, _G.handler(self, self.OnClickItem), 96)
    end
    ---@param item BaseAwardNewItem
    tb.item:ShowWithID(
        {data.sid,data.num},
        nil,
        function(item)
            if item.item.HideOrShowStar then
                item.item:HideOrShowStar(false)
            end
            item:ShowEffect(data.Grand)
        end
    )
    -- local name = _G.StorageManager:GetInstance():GetItemName(data.award[1].sid)
    -- tb.aortext_name.text = _G.LangUtil.GetLangPackValue(name)
    tb.aortext_probNum.text = self:GetPerData(index + 1) .. "%"
end

---点击奖励
function JointActivityDrawUpAwardPreView:OnClickItem(item)
    require "CommonTipManager":GetInstance():OpenTip(item.gameObject, item.data.sid)
end

---按钮点击事件在这里派发
function JointActivityDrawUpAwardPreView:OnClickBtn(go, isOn)
    self:Close()
end

function JointActivityDrawUpAwardPreView:GetPerData(index)
    local weight = self.AwardDatas[index].weight/self.weight*100
    weight = string.format("%.2f", weight)
    return weight
end

return JointActivityDrawUpAwardPreView
