---@class JointActivityView : UIBaseView	中文描述
---@field public go_table JointActivityView_GoTable GoTable
local JointActivityView = _G.BaseClass("JointActivityView", _G.UIBaseView)

function JointActivityView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function JointActivityView:OnCreate(activity)
    self.activityId = activity:GetActivityID()
    self.activity = activity
    local start = activity.cfg.time.start_time
    local startTime = _G.TimeUtil.GetDateTime(start)
    local endTime = _G.TimeUtil.GetDateTime(start + activity.cfg.time.run_time)
    self.go_table.aortext_time.text = _G.GetLangPackValue(
        90028300057,
        startTime.year,
        startTime.month,
        startTime.day,
        endTime.year,
        endTime.month,
        endTime.day
    )
    self:InitRedPoint()
    self:LoadEffect()
end

---特效
function JointActivityView:LoadEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_JointActivityView,
        self.go_table.obj_BgEffect,
        function(effect)
            if not self.go_table then
                _G.UIUtils.RemoveEffect(effect)
            end
        end
    )
end

---初始化红点
function JointActivityView:InitRedPoint()
    ---签到活动
    local activity = require "ActivitySynManager":GetInstance():GetChildAcitivity(10010,
        self.activity:GetJumpType(self.activityId))
    if activity then
        self.go_table.obj_signredpoint:UpdateRedPointItemIDAndParam(
            activity:GetActivityTypeCls():GetRedpointIDByIndex(2)
        )
    end
    ---灵兽竞猜
    local guessActivity = require "ActivitySynManager":GetInstance():GetChildAcitivity(10045,
        self.activity:GetJumpType(self.activityId))
    if guessActivity then
        self.go_table.obj_guessredpoint:UpdateRedPointItemIDAndParam(
            guessActivity:GetActivityTypeCls():GetRedpointIDByIndex(1)
        )
    end
    ---限时召唤
    local drawActivity = require "ActivitySynManager":GetInstance():GetChildAcitivity(10044,
        self.activity:GetJumpType(self.activityId))
    if drawActivity then
        self.go_table.obj_drawredpoint:UpdateRedPointItemIDAndParam(
            drawActivity:GetActivityTypeCls():GetRedpointIDByIndex(1)
        )
    end
    ---天武试炼
    local trialActivity = require "ActivitySynManager":GetInstance():GetChildAcitivity(10042,
        self.activity:GetJumpType(self.activityId))
    if trialActivity then
        self.go_table.obj_trialredpoint:UpdateRedPointItemIDAndParam(
            trialActivity:GetActivityTypeCls():GetRedpointIDByIndex(1)
        )
    end
end

function JointActivityView:OnCloseActivity(activityId)
    if self.activityId == activityId then
        self:Close()
    end
end

---界面的销毁函数
function JointActivityView:OnDestroy()
end

---按钮点击事件在这里派发
function JointActivityView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_sign then
        ---每日签到
        _G.GlobalInterface.JumpActivityByGM(10010, self.activity:GetJumpType(self.activityId))
    elseif go == self.go_table.aorbtn_trial then
        ---天武试炼
        _G.GlobalInterface.JumpActivityByGM(10042, self.activity:GetJumpType(self.activityId))
    elseif go == self.go_table.aorbtn_guess then
        ---风雷对决
        _G.GlobalInterface.JumpActivityByGM(10045, self.activity:GetJumpType(self.activityId))
    elseif go == self.go_table.aorbtn_draw then
        ---限时召唤
        _G.GlobalInterface.JumpActivityByGM(10044, self.activity:GetJumpType(self.activityId))
    end
end

return JointActivityView
