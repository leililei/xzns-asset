---@class CardResonanceView : UIBaseView    中文描述
---@field public go_table CardResonanceView_GoTable GoTable
local CardResonanceView = _G.BaseClass("CardResonanceView", _G.UIBaseView)

function CardResonanceView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

local PanelLuaFile = {
    orderHall = "CardResonanceOrderHallPanel",
    cardRecharge = "CardResonanceCardRechargePanel"
}

local PanelPrefabs = {
    orderHall = "UIH5/CardResonance/Panel/$_obj_OrderHall", --主界面
    cardRecharge = "UIH5/CardResonance/Panel/$_obj_CardRecharge" --充能界面
}

local functionOpenId = {
    cardRecharge = 271
}

---界面的入口函数
function CardResonanceView:OnCreate()
    self:InitToggle()
    self.panelInit = {}
    self.panelLua = {}
    self.toggleItem = {
        orderHall = self.go_table.toggle_orderHall,
        cardRecharge = self.go_table.toggle_cardRecharge,
    }
    for k,v in pairs(self.toggleItem) do 
        if functionOpenId[k] then 
            v:SetActiveE(_G.FunctionManager:GetInstance():CheckFunctionIsUnlock(functionOpenId[k]) and 1 or 0)
        end
    end
    self.sortingOrder = self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
    self.go_table.toggle_orderHall.isOn = false
    self.go_table.toggle_orderHall.isOn = true
end

function CardResonanceView:InitToggle()
    self.toggles = {
        orderHall = _G.GetAutoGoTable(
            self.go_table.toggle_orderHall,
            _G.handlerbind(self, self.OnClickToggle, "orderHall", _G.handler(self, self.OnOrderHall))
        ),
        cardRecharge = _G.GetAutoGoTable(
            self.go_table.toggle_cardRecharge,
            _G.handlerbind(self, self.OnClickToggle, "cardRecharge", _G.handler(self, self.OnCardRecharge))
        )
    }
end

function CardResonanceView:OnClickToggle(go, isOn, key, call)
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if call then
        call(isOn)
    end
end

function CardResonanceView:OnOrderHall(isOn)
    self.go_table.obj_orderHall:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    local key = "orderHall"
    if not self.panelInit[key] then
        self.panelInit[key] = 0
        _G.PoolsManager:GetInstance():Spawn(
            PanelPrefabs[key],
            _G.ePoolType.UIItem,
            self.go_table.obj_orderHall,
            function(trans)
                self.panelLua[key] = self:AddComponent(trans, require(PanelLuaFile[key]).New(trans))
                self.panelInit[key] = true
                local canvasList = trans:GetComponentsInChildrenE(_G.typeof(_G.Canvas), 1)
                local oneSort
                for i = 0, canvasList.Length - 1 do
                    oneSort = canvasList[i].sortingOrder
                    canvasList[i].sortingOrder = self.sortingOrder + oneSort
                end
            end
        )
    elseif self.panelInit[key] == true then
        self.panelLua[key]:HideAllLvUpEffect()
    end
end

function CardResonanceView:OnCardRecharge(isOn)
    self.go_table.obj_cardRecharge:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    local key = "cardRecharge"
    if not self.panelInit[key] then
        self.panelInit[key] = 0
        _G.PoolsManager:GetInstance():Spawn(
            PanelPrefabs[key],
            _G.ePoolType.UIItem,
            self.go_table.obj_cardRecharge,
            function(trans)
                self.panelLua[key] = self:AddComponent(trans, require(PanelLuaFile[key]).New(trans))
                self.panelInit[key] = true
            end
        )
    end
end

---按钮点击事件在这里派发
function CardResonanceView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

function CardResonanceView:Dispose()
end

return CardResonanceView
