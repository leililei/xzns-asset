local base = require("BaseGameNet")

---@class CardResonanceNet : BaseGameNet	通信协议
local CardResonanceNet = _G.BaseClass("CardResonanceNet", base)

---@return CardResonanceNet CardResonanceNet
function CardResonanceNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求
function CardResonanceNet:GetInfo(callback)
    local item = _G.ConfigManager.net_map.game_card_port_get_stone
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---卡牌上阵
function CardResonanceNet:SetCard(pbData, callback)
    local item = _G.ConfigManager.net_map.game_card_port_stone_up_card
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---槽位等级提升
function CardResonanceNet:LevelUp(pbData, callback)
    local item = _G.ConfigManager.net_map.game_card_port_stone_up_level
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
