---神石解锁 第二阶段（预留）
function CardResonanceNet:UnlockStoneState(callback)
    local item = _G.ConfigManager.net_map.game_card_port_stone_unlock_stage
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---神石充能
function CardResonanceNet:DevelopStone(pbData, callback)
    local item = _G.ConfigManager.net_map.game_card_port_stone_up_num
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

function CardResonanceNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end


---@type CardResonanceNet
return CardResonanceNet
