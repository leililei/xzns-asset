local CardResonanceNet = require("CardResonanceNet")

local base = _G.GameDataModelBase
---@class CardResonanceModel : GameDataModelBase
---@field posData card.i_field[]
local CardResonanceModel = _G.BaseClass("CardResonanceModel", base)

---@return CardResonanceModel CardResonanceModel
function CardResonanceModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function CardResonanceModel:__init()
    self.curFunctionOpenID = _G.FunctionID.Stone
    local discrete_cfg = _G.ConfigManager.discrete_cfg
    self.limitStarCon = discrete_cfg[102501][1][1]
    self.limitPerAdd = discrete_cfg[102501][1][2]
    self.maxLevel = discrete_cfg[102505][1][1]
    self.limitLvEnable = discrete_cfg[102509][1][1] --额外等级上限生效的等级
    self.posNum = 5 ---核心槽位数量
    self.posUid = {}
    self.posData = {}
    self.needCheckReset = true
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.ResUpdata, self)
end

---从服务器拉取数据
function CardResonanceModel:GetDataFormServer()
    self:GetInfo()
end

function CardResonanceModel:GetInfo()
    CardResonanceNet:GetInstance():GetInfo(_G.handler(self, self.ParseData))
end

---@param msg card.s2c_get_stone
function CardResonanceModel:ParseData(msg)
    self.posData = {}
    self.posUid = {}
    if msg.core_uid == nil then ---刷号清背包可能会导致这里为空
        msg.core_uid = {}
        for i = 1, self.posNum do
            _G.table.insert(msg.core_uid, {index = i, uid = 0, level = 1})
        end
    end
    for _, v in pairs(msg.core_uid) do
        self.posData[v.index] = v
        if v.uid > 0 then
            self.posUid[v.uid] = v.index
            self:SetCardPosType(v.uid, _G.StonePosType.PosTwo)
        end
    end
    for i = 1, self.posNum do
        if not self.posData[i] then
            self.posData[i] = {index = i, uid = 0, level = 1}
        end
    end
    self.maxSids = msg.max_sids or {}
    self.stageLv = msg.up_stage or 0
    self.upNum = msg.up_num or 0
    self:UpdateLevelLimit()
    self:UpdateMinPosLevel()
    self:SetInitLevel()
    self:UpdateAllPosCard()
    self.super.ParseData(self)
end

function CardResonanceModel:SetCardPosType(uid, type)
    local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
    if card then
        card.shenshiPosType = type
        return card
    end
    return nil
end

function CardResonanceModel:SetInitLevel()
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    for _, card in pairs(cards) do
        if self.posUid[card.uid] ~= nil then
            card:SetLevel(self.posData[self.posUid[card.uid]].level)
        else
            card:SetLevel(self.minLv)
        end
        card:AddCardLv(0, nil, true)
    end
end

---设置神石第二阶段 等级上限 （升星时调用） 达到星级 增加等级
---@param sid number 卡牌的sid
---@param star number 卡牌的星级
function CardResonanceModel:AddMaxSids(sid, star)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.curFunctionOpenID) then
        return
    end
    
    --卡牌星级 小于限制的条件
    if star < self.limitStarCon then
        return
    end
    if _G.table.ContainsValue(self.maxSids, sid) then
        return
    end
    _G.table.insert(self.maxSids, sid)
    self:UpdateLevelLimit()
end

---设置神石等级的 额外上限
function CardResonanceModel:UpdateLevelLimit()
    self.limitTotalAdd = #self.maxSids * self.limitPerAdd
end

---更新最小槽位的等级
function CardResonanceModel:UpdateMinPosLevel()
    local level
    for _, v in pairs(self.posData) do
        if level == nil or level >= v.level then
            level = v.level
        end
    end
    self.minLv = level or 1
    self:UpdateMinPosIndex()
end

---更新最小槽位的位置
function CardResonanceModel:UpdateMinPosIndex()
    local sortData = {}
    local len = 0
    for _, v in pairs(self.posData) do
        if v.uid > 0 and v.level == self.minLv then
            _G.table.insert(sortData, v)
            len = len + 1
        end
    end
    local StorageManager = _G.StorageManager:GetInstance()
    if len == 0 then
        self.minIndex = 1
        return
    end
    _G.SortList(
        sortData,
        function(a)
            local card = StorageManager:GetItemDataByID(_G.StorageID.Card, a.uid)
            if card == nil then
                return 0, 0, 0, 0
            end
            return card.star, card.Grade, card.sid, card.uid
        end
    )
    self.minIndex = sortData[len].index
end

---更新槽位卡牌(升级/升星后调用)
---@param notChange boolean 仅筛选（可选）
---@param posData table 临时数据（可选）
---@param posUid table 临时数据（可选）
---@param force boolean 强制更新最低槽（可选）
function CardResonanceModel:UpdateAllPosCard(notChange, posData, posUid, force, call)
    posData = posData or self.posData
    posUid = posUid or self.posUid
    local StorageManager = _G.StorageManager:GetInstance()

    local minList = {} ---需要更新的槽位
    local minUids = {} ---缓存需更新的槽位中的uid
    local minCards = {} ---缓存需更新的槽位中的卡
    local num = 0
    local minStar = 100 --过滤仓库低星卡，减少不必要的排序
    local data
    for _, v in pairs(posData) do
        --空槽位/所有最低槽位/槽位内卡牌星级不足以支撑当前等级
        -- if v.level == self.minLv or v.uid == 0 or self:GetLevelLimitByPos(v.index) < v.level then
        --ZHJH-4194仅空槽位
        if v.uid == 0 or (force and (v.level == self.minLv and self:GetLevelLimitByPos(v.index) <= v.level)) then
            _G.table.insert(minList, v)
            minUids[v.uid] = v.index
            num = num + 1
            if v.uid > 0 then
                data = StorageManager:GetItemDataByID(_G.StorageID.Card, v.uid)
                if data then
                    minCards[v.index] = data
                    if data.star < minStar then
                        minStar = data.star
                    end
                else
                    posUid[v.uid] = nil --某些情况卡牌被移除，修正数据
                    v.uid = 0
                    minStar = 0
                end
            else
                minStar = 0
            end
        end
    end

    if num == 0 then
        if call then
            call()
        end
        return {}
    end

    local preCards = {}
    local cards = StorageManager:GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    for _, card in pairs(cards) do
        if card.star >= minStar and (posUid[card.uid] == nil or minUids[card.uid]) then --不在槽位或者属于最小槽位
            _G.table.insert(preCards, card)
        end
    end

    local alikeSidNum = {}

    -- for k, v in pairs(minList) do
    --     if v.uid ~= 0 then
    --         if not alikeSidNum[cards[v.uid].sid] then
    --             alikeSidNum[cards[v.uid].sid] = 0
    --         end
    --         alikeSidNum[cards[v.uid].sid] = alikeSidNum[cards[v.uid].sid] + 1
    --     end
    -- end

    _G.SortList(
        minList,
        function(pos)
            local count = 1
            if pos.uid ~= 0 then
                if not alikeSidNum[cards[pos.uid].sid] then
                    alikeSidNum[cards[pos.uid].sid] = 0
                end
                alikeSidNum[cards[pos.uid].sid] = alikeSidNum[cards[pos.uid].sid] + 1
                count = alikeSidNum[cards[pos.uid].sid]
            end
            return -count, pos.level
        end
    )
    alikeSidNum = {}
    _G.SortList(
        preCards,
        function(card)
            local count = 1
            if not alikeSidNum[cards[card.uid].sid] then
                alikeSidNum[cards[card.uid].sid] = 0
            end
            alikeSidNum[cards[card.uid].sid] = alikeSidNum[cards[card.uid].sid] + 1
            count = alikeSidNum[cards[card.uid].sid]

            return -count, card.star, card.Grade, card.sid, card.uid
        end
    )

    local indexLock = {} --已在槽位上
    local topCards = {}
    local realNum = num
    for i = 1, self.posNum do
        data = preCards[i]
        if data then
            if minUids[data.uid] then ---需求量-1
                realNum = realNum - 1
            end
            if self.posUid[data.uid] then ---已经在槽位上且并非5个槽位均替换
                _G.table.insert(indexLock, self.posUid[data.uid])
            else
                _G.table.insert(topCards, data)
                if #topCards >= realNum then
                    break
                end
            end
        end
    end

    local field = {}
    local card
    for i = 1, num do
        if not _G.table.ContainsValue(indexLock, minList[i].index) then
            data = _G.table.remove(topCards)
            if data == nil then
                if minList[i].uid > 0 then --下阵
                    _G.table.insert(field, {index = minList[i].index, uid = 0, level = 1})
                end
            else --上阵
                card = minCards[minList[i].index]
                if card == nil or data:GetStar() > card:GetStar() then
                    _G.table.insert(
                        field,
                        {index = minList[i].index, uid = data.uid, level = posData[minList[i].index].level}
                    )
                end
            end
        end
    end

    if notChange then
        return field
    end
    if #field > 0 then
        self:SetCardMulti(field, call)
    elseif call then
        call()
    end
end

---添加/移除卡牌
function CardResonanceModel:AddOrRemoveCard(add, rem, change)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.curFunctionOpenID) then
        return
    end
    if rem then
        for uid, sid in pairs(rem) do
            if self.posUid[uid] then
                self.posData[self.posUid[uid]].uid = 0
                self.posUid[uid] = nil
            end
        end
    end
    self:UpdateAllPosCard()
end

---先检测最低槽位是否达到上限
function CardResonanceModel:CheckPosLimitAndLevelUp(uid, num, call)
    local index, inPos = self:GetIndexByUid(uid)
    if inPos then
        self:LevelUp(uid, num, call)
        return
    end
    local isLimit = self:CheckPosIsLevelLimit(index, num)
    if not isLimit then
        self:LevelUp(uid, num, call)
        return
    end
    self:SetCardSingle(
        uid,
        index,
        self.posData[index].level,
        function(msg1)
            if msg1.ack ~= 1 then
                return
            end
            self:LevelUp(uid, num, call)
        end
    )
end

---槽位升级（卡牌升级）
function CardResonanceModel:LevelUp(uid, num, call)
    local index, inPos = self:GetIndexByUid(uid)
    if not inPos then
        index = self:GetSuitableUpIndex() or index
    end
    local pbData = {lv_num = num, index = index}
    if self.posData[index].uid == 0 then
        if _G.AppSetting.DEBUG then
            _G.LogError("槽位为空，无法升级：" .. index)
            _G.LogError(self.posData)
        end
        return
    end
    CardResonanceNet:GetInstance():LevelUp(
        pbData,
        function(msg)
            local StorageManager = _G.StorageManager:GetInstance()
            if msg.ack ~= 1 then
                local card = StorageManager:GetItemDataByID(_G.StorageID.Card, uid)
                card:SetLevel(self.posData[index].level)
                card:AddCardLv(0, nil, true)
                return
            end
            local isMin = index == self.minIndex or not inPos
            self.posData[index].level = self.posData[index].level + num
            if isMin and self:CheckPosFull() then
                -- local newUid = uid
                -- local levelLimit = self:GetLevelLimitByPos(index)
                -- if nowIsMin and levelLimit <= self.posData[index].level then ---达到了等级上限，检测有无星级更高的卡替换
                --     newUid = self:FindHigherLevelLimitCard(uid, levelLimit)
                --     if newUid ~= uid then
                --         self:SetCardSingle(
                --             newUid,
                --             index,
                --             self.posData[index].level,
                --             function(msg1)
                --                 if call then
                --                     call(not inPos, msg)
                --                 end
                --             end
                --         )
                --     end
                -- end
                self:UpdateMinPosLevel()
                local cards = StorageManager:GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
                for _, card in pairs(cards) do
                    if self.posUid[card.uid] == nil then
                        card:SetLevel(self.minLv)
                        card:AddCardLv(0, nil, true)
                    end
                end
                local card = StorageManager:GetItemDataByID(_G.StorageID.Card, uid)
                local nowIsMin = self.posData[index].level <= self.minLv
                -- if self.posData[index].level > self.minLv and not inPos then ---最小槽位已改变，此卡荣升进槽位
                if not inPos then ---ZHJH-4194升谁谁进槽
                    local cardPos = StorageManager:GetItemDataByID(_G.StorageID.Card, self.posData[index].uid)
                    cardPos:SetLevel(self.minLv)
                    cardPos:AddCardLv(0, nil, true)
                    if self.posData[index].level > self:GetCardSelfLevelLimit(uid) then --超过等级上限不进槽（观感很怪）
                        self:OnLevelUpEnd(call, inPos, msg)
                        return
                    end
                    if not nowIsMin then --最小槽位改变
                        -- self:SetCardSingle(
                        --     uid,
                        --     index,
                        --     self.posData[index].level,
                        --     function(msg1)
                        --         if msg1.ack ~= 1 then --以防万一回滚
                        --             card:SetLevel(self.minLv)
                        --             card:AddCardLv(0)
                        --             cardPos:SetLevel(self.posData[index].level)
                        --             cardPos:AddCardLv(0)
                        --         end
                        --         if call then
                        --             call(not inPos, msg)
                        --         end
                        --     end
                        -- )
                        card:SetLevel(self.posData[index].level)
                        local posDataTemp = _G.DeepCopy(self.posData)
                        local posUidTemp = _G.DeepCopy(self.posUid)
                        posDataTemp[index].uid = uid
                        posUidTemp[self.posData[index].uid] = nil
                        posUidTemp[uid] = index
                        local field = self:UpdateAllPosCard(true, posDataTemp, posUidTemp, true)
                        _G.table.insert(field, {index = index, uid = uid, level = self.posData[index].level})
                        self:SetCardMulti(
                            field,
                            function(msg1)
                                if msg1.ack ~= 1 then --以防万一回滚
                                    card:SetLevel(self.minLv)
                                    card:AddCardLv(0)
                                    cardPos:SetLevel(self.posData[index].level)
                                    cardPos:AddCardLv(0)
                                end
                                self:OnLevelUpEnd(call, inPos, msg)
                            end
                        )
                        return
                    else --进槽
                        local newUid = uid
                        local levelLimit = self:GetLevelLimitByPos(index)
                        if levelLimit <= self.posData[index].level then --达到等级上限
                            newUid = self:FindHigherLevelLimitCard(uid, levelLimit)
                        end
                        self:SetCardSingle(
                            newUid,
                            index,
                            self.posData[index].level,
                            function(msg1)
                                self:OnLevelUpEnd(call, inPos, msg)
                            end
                        )
                        return
                    end
                -- else
                -- if not inPos then ---依旧是最低等级的槽位
                --     local cardPos = StorageManager:GetItemDataByID(_G.StorageID.Card, self.posData[index].uid)
                --     cardPos:SetLevel(self.minLv)
                --     cardPos:AddCardLv(0, nil, true)
                -- end
                end
                card:SetLevel(self.posData[index].level)
                card:AddCardLv(0, nil, true)
                StorageManager:DelayUpdateAllCardProp()
                self:UpdateAllPosCard(
                    false,
                    nil,
                    nil,
                    true,
                    function(msg1)
                        self:OnLevelUpEnd(call, inPos, msg)
                    end
                )
                return
            else
                -- local levelLimit = self:GetLevelLimitByPos(index)
                -- if levelLimit <= self.posData[index].level then ---达到了等级上限，检测有无星级更高的卡替换
                --     local field = self:UpdateAllPosCard(true, nil, nil, true)
                --     self:SetCardMulti(
                --         field,
                --         function(msg1)
                --             if call then
                --                 call(not inPos, msg)
                --             end
                --         end
                --     )
                -- else
                --      self:UpdateAllPosCard()
                -- end
                local card = StorageManager:GetItemDataByID(_G.StorageID.Card, uid)
                card:SetLevel(self.posData[index].level)
                card:AddCardLv(0)
                self:UpdateMinPosLevel()
                self:UpdateAllPosCard(
                    false,
                    nil,
                    nil,
                    true,
                    function(msg1)
                        self:OnLevelUpEnd(call, inPos, msg)
                    end
                )
                return
            end
            self:OnLevelUpEnd(call, inPos, msg)
        end
    )
end

function CardResonanceModel:OnLevelUpEnd(call, inPos, msg)
    _G.Events:GetInstance():Broadcast(_G.eCardResonance.CRLevelUp)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.Cardconmonlevelup.id)
    if call then
        call(not inPos, msg)
    end
end

---卡牌下阵，如果有多余的卡牌，则代替上阵
function CardResonanceModel:CardDownarray(cardUidList, blackList)
    local posUid = self.posUid
    local posData = self.posData
    --- 没在阵上的卡牌列表
    local tempList = {}
    --- 卡牌数量不够上阵，剩下没有下阵的卡牌
    local overList = {}
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    cards = _G.table.toArray(cards)
    _G.SortList(
        cards,
        function(card)
            return card.star, card.Grade, card.sid, card.uid
        end
    )
    for k, v in pairs(cards) do
        if not posUid[v.uid] and not blackList[v.uid] then
            _G.table.insert(tempList, v)
        end
    end

    local count = _G.table.count(tempList)
    for k, v in pairs(cardUidList) do
        if count > 0 then
            local card = _G.table.remove(tempList, 1)
            local index = posUid[v]
            count = count - 1

            card:SetLevel(posData[index].level)
            card:AddCardLv(0, nil, true)

            self:SetCardSingle(
                card.uid,
                index,
                posData[index].level
            )
        else
            _G.table.insert(overList, v)
        end
    end
    return overList
end

---槽位等级重置
function CardResonanceModel:LevelReset(uid, call)
    local index, inPos = self:GetIndexByUid(uid)
    local pbData = {index = index, card_uid = uid}
    CardResonanceNet:GetInstance():LevelReset(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                if call then
                    call(msg)
                end
                return
            end
            self.posData[index].level = 1
            self:UpdateMinPosLevel()
            local data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, self.posData[index].uid)
            data:SetLevel(1)
            data:AddCardLv(0, nil, true)
            data:CalcNowSumProp()
            local decoration = {--重生后刻印等级重置，前端需要更新状态
                decoration_slot =
                {
                    { index = 1, slotLevel = 0 },
                    { index = 2, slotLevel = 0 },
                    { index = 3, slotLevel = 0 },
                    { index = 4, slotLevel = 0 },
                }
            }
            data:SaveDecorationData(decoration)
            local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
            for _, card in pairs(cards) do
                if self.posUid[card.uid] == nil then
                    card:SetLevel(self.minLv)
                    card:AddCardLv(0, nil, true)
                end
            end
            _G.StorageManager:GetInstance():DelayUpdateAllCardProp(nil, true)
            self:UpdateAllPosCard()
            require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.Cardconmonlevelup.id)
            if call then
                call(msg)
            end
            _G.Events:GetInstance():Broadcast(_G.eCardResonance.CRLevelReset)
        end
    )
end

