function CardResonanceModel:GetStageLevel()
    return self.stageLv or 0
end

function CardResonanceModel:GetStageMaxLevel()
    if not self.stageMaxLv then
        self.stageMaxLv = 0
        for _, v in pairs(_G.ConfigManager.card_level_resonance_cfg) do
            if v.id > self.stageMaxLv then
                self.stageMaxLv = v.id
            end
        end
    end
    return self.stageMaxLv
end

function CardResonanceModel:CheckStageIsMax()
    return self:GetStageLevel() >= self:GetStageMaxLevel()
end

function CardResonanceModel:GetStageCanUpLevel()
    if self:CheckStageIsMax() then
        return false
    end
    local nextCfg = _G.ConfigManager.card_level_resonance_cfg[self:GetStageLevel() + 1]
    if nextCfg == nil then
        return false
    end
    return self.minLv >= nextCfg.level, nextCfg
end

---获取位面之子升阶满足等级要求的槽位数量
function CardResonanceModel:GetStageUpMeetPosNum()
    if self:CheckStageIsMax() then
        return self.posNum
    end
    local nextCfg = _G.ConfigManager.card_level_resonance_cfg[self:GetStageLevel() + 1]
    if nextCfg == nil then
        return 0
    end
    local num = 0
    for _, v in pairs(self.posData) do
        if v.level >= nextCfg.level then
            num = num + 1
        end
    end
    return num
end

---获取神石属性
function CardResonanceModel:GetAllAttribute()
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local attribute = AttributeClassManager:GetAttribtueClass()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.curFunctionOpenID) then
        local changeAttrTypes = _G.AttributeClassManager:GetInstance():GetChangeAttrTypes(attribute)
        return attribute, changeAttrTypes
    end
    local tonumber = _G.tonumber
    local cfg = _G.ConfigManager.card_level_resonance_cfg[self:GetStageLevel()]
    local name, value, aType

    for _, v in pairs(cfg.att) do
        value = tonumber(v[3])
        name = v[1]
        aType = v[2] == "1" and _G.AttCountType.other or tonumber(v[2])
        attribute:AddValueByName(name, AttributeClassManager:GetValueWithName(name, value, aType), false, aType)
    end
    local changeAttrTypes = _G.AttributeClassManager:GetInstance():GetChangeAttrTypes(attribute)
    return attribute, changeAttrTypes
end

