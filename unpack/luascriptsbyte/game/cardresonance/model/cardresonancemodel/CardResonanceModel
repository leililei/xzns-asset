---神石充能加成属性
---@param 是否刷新战力
function CardResonanceModel:RefreshAttribute()
    local attributeManager = _G.AttributeClassManager:GetInstance()
    if not self.attribute then
        self.attribute = attributeManager:GetAttribtueClass()
    end

    local propKeyList = {"atk", "bre", "def", "max_hp"}
    local basePropConfig = _G.ConfigManager.discrete_cfg[102515][1]
    for index, v in pairs(propKeyList) do
        local addNum = basePropConfig[index] or 0
        self.attribute:SetValueByName(v, addNum * self.upNum, false)
    end
    self.attributeChangeType = attributeManager:GetChangeAttrTypes(self.attribute)

    return self.attribute
end

function CardResonanceModel:GetAllRechargeAttribute()
    if not self.attribute then
        self:RefreshAttribute()
    end

    local attr = self.attribute:Clone()
    attr:AttributeToOther()
    return attr, self.attributeChangeType
end

