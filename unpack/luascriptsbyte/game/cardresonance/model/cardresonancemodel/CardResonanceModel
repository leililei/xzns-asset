---获取槽位当前等级上限
function CardResonanceModel:GetLevelLimitByPos(index)
    local posData = self.posData[index]
    local limitLevel = 0
    if posData.uid > 0 then
        local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, posData.uid)
        if card then
            local cfgId = require("CardInfoManager"):GetInstance():GetStarCfgId(card.cfg.Elements_new,card.star)
            local cfg = _G.ConfigManager.card_star_cfg[cfgId]
            if cfg ~= nil then
                if cfg.level_limit >= self.limitLvEnable and posData.level >= self.limitLvEnable then
                    limitLevel = self.limitTotalAdd
                end
                limitLevel = limitLevel + cfg.level_limit
            end
        end
    end
    if limitLevel > self.maxLevel then
        limitLevel = self.maxLevel
    end
    return limitLevel
end

---获取卡牌自身可升级上限
function CardResonanceModel:GetCardSelfLevelLimit(uid, star)
    local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
    local limitLevel = 0
    if card then
        star = star or card.star
        local cfgId = require("CardInfoManager"):GetInstance():GetStarCfgId(card.cfg.Elements_new, star)
        local cfg = _G.ConfigManager.card_star_cfg[cfgId]
        if cfg ~= nil then
            if cfg.level_limit >= self.limitLvEnable and self.posData[self:GetIndexByUid(card.uid)].level >= self.limitLvEnable then
                limitLevel = self.limitTotalAdd
            end
            limitLevel = limitLevel + cfg.level_limit
        end
    end
    if limitLevel > self.maxLevel then
        limitLevel = self.maxLevel
    end
    return limitLevel
end

---检测槽位是否达到或升级后超过等级上限
function CardResonanceModel:CheckPosIsLevelLimit(index, num)
    num = num or 0
    local limit = self:GetLevelLimitByPos(index)
    return limit <= self.posData[index].level or limit < self.posData[index].level + num
end

