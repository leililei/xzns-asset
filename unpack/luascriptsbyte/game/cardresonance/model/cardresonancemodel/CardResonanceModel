---卡牌回退
function CardResonanceModel:CardReset(uid, call)
    local rUid = 0
    local rCard
    --取消用高星卡顶上来
    -- if self:CheckCardIsInPos(uid) then
    --     rCard = self:FindTopCard(uid)
    --     if rCard and rCard.uid ~= uid then
    --         rUid = rCard.uid
    --     end
    -- end
    local pbData = {uid = uid, r_uid = rUid}
    require("CardInfoNet"):GetInstance():CardReset(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                if call then
                    call(msg)
                end
                return
            end
            self.needCheckReset = true
            if rUid > 0 then
                local posData = self.posData[self.posUid[uid]]
                posData.uid = rUid
                rCard:SetLevel(posData.level)
                rCard:AddCardLv(0)
                local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
                card:SetLevel(self.minLv)
                card:AddCardLv(0)
                self.posUid[rUid] = posData.index
                self.posUid[uid] = nil
            end
            require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.CardPotential.id
            )
            if call then
                call(msg, rUid > 0 and rUid or uid)
            end
        end
    )
end

