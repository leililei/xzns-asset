---检测重置星级是否需要重置槽位等级
function CardResonanceModel:CheckReplaceNeedResetLv(uid)
    local rUid = uid
    if self:CheckCardIsInPos(uid) then
        local rCard = self:FindTopCard(uid)
        if rCard and rCard.uid ~= uid then
            rUid = rCard.uid
        end
        local index = self:GetIndexByUid(uid)
        local posData = self:GetPosData(index)
        if posData.level == self.minLv then
            local limit
            if rUid == uid then
                limit = self:GetCardSelfLevelLimit(rUid, 6)
            else
                limit = self:GetCardSelfLevelLimit(rUid)
            end
            if posData.level > limit then
                return true
            end
        end
    end
    return false
end

---检测最低等级槽位上的卡星级是否过低
function CardResonanceModel:CheckLvUpNeedResetLv()
    for _, v in pairs(self.posData) do
        if v.level == self.minLv and v.uid > 0 then
            if v.level > self:GetLevelLimitByPos(v.index) then
                return true
            end
        end
    end
    return false
end

