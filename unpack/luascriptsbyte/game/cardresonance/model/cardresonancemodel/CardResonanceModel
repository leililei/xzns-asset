---槽位上阵卡牌(单张)
function CardResonanceModel:SetCardSingle(uid, index, level, call)
    local pbData = {index = {{index = index, uid = uid, level = level}}}
    CardResonanceNet:GetInstance():SetCard(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                if call then
                    call(msg)
                end
                return
            end
            self:SetCardPosType(uid, _G.StonePosType.PosTwo)
            self:SetCardPosType(self.posData[index].uid, _G.StonePosType.PosZero)
            local card
            if uid > 0 then
                card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
                local limitLevel = self:GetCardSelfLevelLimit(uid)
                if limitLevel < level then
                    -- 上阵的角色品质的最低等级小于当前槽位的等级
                    -- 服务器自动重置
                    level = 1
                    self.minLv = 1
                    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
                    for _, card0 in pairs(cards) do
                        if self.posUid[card0.uid] == nil then
                            card0:SetLevel(self.minLv)
                            card0:AddCardLv(0, nil, true)
                        end
                    end
                    _G.StorageManager:GetInstance():DelayUpdateAllCardProp()
                end
                card:SetLevel(level)
                card:AddCardLv(0)
            end
            if self.posData[index].uid > 0 then
                card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, self.posData[index].uid)
                if card then
                    card:SetLevel(self.minLv)
                    card:AddCardLv(0)
                end
            end
            self.posUid[self.posData[index].uid] = nil
            self.posUid[uid] = index
            self.posData[index].uid = uid
            self.posData[index].level = level
            self:UpdateMinPosLevel()
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            if call then
                call(msg)
            end
            _G.Events:GetInstance():Broadcast(_G.eCardResonance.CRUpdatePosData)
        end
    )
end

---槽位上阵卡牌（批量）
function CardResonanceModel:SetCardMulti(field, call)
    local pbData = {index = field}
    CardResonanceNet:GetInstance():SetCard(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                if call then
                    call(msg)
                end
                return
            end
            local card1, card2
            local card0
            local flag = false
            -- 提前遍历一次，将槽位等级不符合角色品质的角色重置
            for _, v in pairs(field) do
                if v.uid > 0 then
                    card0 = self:SetCardPosType(v.uid, _G.StonePosType.PosTwo)
                    local limitLevel = self:GetCardSelfLevelLimit(v.uid)
                    if limitLevel < v.level then
                        -- 上阵的角色品质的最低等级小于当前槽位的等级
                        -- 服务器自动重置
                        v.level = 1
                        self.minLv = 1
                        flag = true
                    end
                end
            end
            if flag then
                local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
                for _, card in pairs(cards) do
                    if self.posUid[card.uid] == nil then
                        card:SetLevel(self.minLv)
                        card:AddCardLv(0, nil, true)
                    end
                end
                _G.StorageManager:GetInstance():DelayUpdateAllCardProp()
            end
            for _, v in pairs(field) do
                if v.uid > 0 then
                    card1 = self:SetCardPosType(v.uid, _G.StonePosType.PosTwo)
                    card1:SetLevel(v.level)
                    card1:AddCardLv(0)
                end
                if self.posData[v.index].uid > 0 then
                    card2 = self:SetCardPosType(self.posData[v.index].uid, _G.StonePosType.PosZero)
                    card2:SetLevel(self.minLv)
                    card2:AddCardLv(0)
                end
                self.posUid[self.posData[v.index].uid] = nil
                self.posUid[v.uid] = v.index
                self.posData[v.index].uid = v.uid
                self.posData[v.index].level = v.level
            end
            self:UpdateMinPosLevel()
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            if call then
                call(msg)
            end
            _G.Events:GetInstance():Broadcast(_G.eCardResonance.CRUpdatePosData)
        end
    )
end

---@param uid number 参与排序的槽位卡
function CardResonanceModel:FindTopCard(uid)
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    cards =
        _G.table.chooseToArray(
        cards,
        function(_, v)
            return self.posUid[v.uid] == nil or v.uid == uid
        end
    )
    _G.SortList(
        cards,
        function(card)
            return card.star, card.Grade, card.sid, card.uid
        end
    )
    if #cards > 1 and cards[1].uid == uid and cards[2].star > 6 then ---考虑回退后星级会降为6，若第二张卡星级更高则取第二张
        return cards[2]
    end
    return cards[1]
end

---查找等级上限更高的卡
function CardResonanceModel:FindHigherLevelLimitCard(uid, levelLimit)
    ---@type CardData
    local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
    local maxStar = card:GetStar()
    local noRepeatMaxStar = maxStar
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    local sidDic = {}
    local sid
    for _, v in pairs(self.posData) do
        if v.uid > 0 then
            sid = cards[v.uid].sid
            if sidDic[sid] == nil then
                sidDic[sid] = 1
            else
                sidDic[sid] = sidDic[sid] + 1
            end
        end
    end

    local newCard, newNoRepeatCard
    for _, v in pairs(cards) do
        if self.posUid[v.uid] == nil then
            if v:GetStar() > maxStar then
                maxStar = v:GetStar()
                newCard = v
            end
            if sidDic[v.sid] == nil and v:GetStar() > noRepeatMaxStar then
                noRepeatMaxStar = v:GetStar()
                newNoRepeatCard = v
            end
        end
    end
    local newLevelLimit
    if newNoRepeatCard then
        newLevelLimit = self:GetCardLevelLimit(newNoRepeatCard)
        if newLevelLimit > levelLimit then
            return newNoRepeatCard.uid
        end
        if newCard then
            newLevelLimit = self:GetCardLevelLimit(newCard)
            if newLevelLimit > levelLimit then
                return newCard.uid
            end
        end
    elseif newCard then
        newLevelLimit = self:GetCardLevelLimit(newCard)
        if newLevelLimit > levelLimit then
            return newCard.uid
        end
    end
    return uid
end

function CardResonanceModel:GetCardLevelLimit(card)
    local limitLevel = 0
    local cfgId = require("CardInfoManager"):GetInstance():GetStarCfgId(card.cfg.Elements_new,card.star)
    local cfg = _G.ConfigManager.card_star_cfg[cfgId]
    if cfg ~= nil then
        if cfg.level_limit >= self.limitLvEnable and self.posData[self:GetIndexByUid(card.uid)].level >= self.limitLvEnable then
            limitLevel = self.limitTotalAdd
        end
        limitLevel = limitLevel + cfg.level_limit
    end
    return limitLevel
end

---获取最适合下阵的槽位，最低等级>卡槽中存在sid卡>星级>品质
function CardResonanceModel:GetSuitableUpIndex()
    local num
    local alikeSidNum = {}
    local minList = {}
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    -- 遍历槽位上的卡牌，取出最低等级的卡，并将其他的卡做记录，用于后面检测重复sid
    for k, v in pairs(self.posData) do
        if v.level == self.minLv then
            _G.table.insert(minList, v)
        else
            if v.uid ~= 0 then
                alikeSidNum[cards[v.uid].sid] = 1
            end
        end
    end
    --
    _G.SortList(
        minList,
        function(min)
            if min.uid ~= 0 then
                local count = alikeSidNum[cards[min.uid].sid] or 0
                -- 重新赋值，防止minList中也有重复的sid
                alikeSidNum[cards[min.uid].sid] = 1
                return count, -cards[min.uid].star, -cards[min.uid].Grade, cards[min.uid].sid, min.uid
            end
            return 99, 99, 99, 99, 99
        end
    )
    num = minList[1].index or nil
    return num
end

