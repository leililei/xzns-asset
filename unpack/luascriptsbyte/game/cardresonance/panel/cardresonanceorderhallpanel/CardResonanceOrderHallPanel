local CardResonanceModel = require("CardResonanceModel")
local CardInfoManager = require("CardInfoManager")

---@class CardResonanceOrderHallPanel : UIBaseView
---@field public CurNpcIconPath string 当前NpcIcon路径
---@field public go_table _obj_OrderHall_GoTable
---@field public roleItemsTb _obj_OrderHall._obj_role1_GoTable[]
local CardResonanceOrderHallPanel = _G.BaseClass("CardResonanceOrderHallPanel", _G.Component)

function CardResonanceOrderHallPanel:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end

function CardResonanceOrderHallPanel:Awake()
end

function CardResonanceOrderHallPanel:OnCreate()
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.CardOrderHallPanel, self.go_table)
    local resources = _G.ConfigManager.ui_cfg.MainView.resources
    self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, resources))
    self.playerHead =
        self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))
    self.roleItemsTb = {
        _G.GetAutoGoTable(self.go_table.obj_role1, _G.handlerbind(self, self.OnClickRole, 1)),
        _G.GetAutoGoTable(self.go_table.obj_role2, _G.handlerbind(self, self.OnClickRole, 2)),
        _G.GetAutoGoTable(self.go_table.obj_role3, _G.handlerbind(self, self.OnClickRole, 3)),
        _G.GetAutoGoTable(self.go_table.obj_role4, _G.handlerbind(self, self.OnClickRole, 4)),
        _G.GetAutoGoTable(self.go_table.obj_role5, _G.handlerbind(self, self.OnClickRole, 5))
    }
    for i = 1, 5 do
        _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.CardOrderHallPanel .. "Role" .. i, self.roleItemsTb[i])
    end
    self:AddListener(_G.eCardResonance.CRLevelUp, self.UpdateView)
    self:AddListener(_G.eCardResonance.CRLevelReset, self.UpdateView)
    self:AddListener(_G.eCardResonance.CRUpdatePosData, self.UpdateView)
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Gemstone) then
        self.go_table.obj_gemstone:SetActiveE(1)
    else
        self.go_table.obj_gemstone:SetActiveE(0)
    end
    self:UpdateView()
end

function CardResonanceOrderHallPanel:UpdateView()
    self:UpdateRoles()
    self:UpdateProp()
    self:UpdateGemstone()
end

function CardResonanceOrderHallPanel:UpdateRoles()
    local tb, card, cfg, cardCfg
    local cards = CardResonanceModel:GetInstance():GetSortPosCardData()
    self.cards = cards
    for i = 1, 5 do
        tb = self.roleItemsTb[i]
        tb.trans_role:ClearChildren()
        tb.obj_Root:SetActiveE(1)
        if _G.AppSetting.IsXzns then
            _G.GameUtil.SetUiHeXieMask(tb)
        end
        card = cards[i]
        if card then
            tb.obj_EffNode:ClearChildren()
            _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_fazhen, tb.obj_EffNode)
            tb.aorrawimage_Matrix:SetActiveE(0)
            tb.aortext_lv.text = "LV." .. card:GetLevel()
            cfg = CardInfoManager.GetCardSkin_ShowCfg(card.skin, card.sid)
            cardCfg = _G.ConfigManager.card_cfg[card.sid]
            tb.trans_role:SetLocalScaleXYZ(cardCfg.size4)
            local godHaloID = _G.PlayerModel:GetInstance():IsCardWearGodHalo(card.sid)
            local path = _G.UIUtils.GetBattleSpine(cfg, _G.UseBattleSpine.CardResonanceView)
            local cardsid=card.sid
            _G.PoolsManager:GetInstance():Spawn(
                path,
                _G.ePoolType.Temporary,
                tb.trans_role,
                function(trans)
                    if self.go_table == nil then
                        _G.DestroyObject(trans)
                    end

                    --- 只有星座女神有神环
                    if _G.AppSetting.IsXzns then
                        if godHaloID ~= 0 then
                            local effCfg = _G.ConfigManager.god_halo_cfg[godHaloID].ui_effect_cfg
                            --- 神环路径，父级路径(加载角色的下面)
                            _G.UIUtils.LoadGodHalo(effCfg, trans, godHaloID)
                        end
                        _G.UIUtils.LoadArtifacteffect(trans, cardsid,nil,nil)
                    end
                end
            )
        else
            tb.obj_Root:SetActiveE(0)
        end
    end
end

function CardResonanceOrderHallPanel:UpdateProp()
    local stageLv = CardResonanceModel:GetInstance():GetStageLevel()
    self.go_table.aortext_level.text = _G.GetLangPackValue(90011200504, stageLv)
    self.go_table.aortext_sonLevel.text = _G.GetLangPackValue(90011200504, stageLv)
    local attribute = CardResonanceModel:GetInstance():GetAllAttribute()
    local showprop = {
        _G.AttrType.atk,
        _G.AttrType.max_hp,
        _G.AttrType.bre,
        _G.AttrType.def
    }
    for i = 1, 4 do
        self.go_table["aortext_attr" .. i].text = attribute:GetValueByID(showprop[i].ID, _G.AttCountType.other)
    end

    local canUp, nextCfg = CardResonanceModel:GetInstance():GetStageCanUpLevel()
    if nextCfg and not canUp then
        self.go_table.aortext_lvTip.text = _G.GetLangPackValue(90011200505, nextCfg.level, nextCfg.id)
    else
        self.go_table.aortext_lvTip.text = _G.GetLangPackValue(18900000053)
    end
    self.go_table.aortext_levelUpText.color = require("CardInfoManager").GetColorFromRGB(canUp and "8C2D14" or "434343")
    self.go_table.aorbtn_levelUp:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
        require("CardInfoManager").GetColorFromRGB(canUp and "FFFFFF" or "A9A9A9")
    self.go_table.aorbtn_levelUp:SetGray(not canUp)
    self.go_table.aorbtn_levelUp:SetActiveE(nextCfg ~= nil and 1 or 0)
end

function CardResonanceOrderHallPanel:UpdateGemstone()
    local gemList = require("GemstoneModel"):GetInstance():GetResonanceGemstone()
    for i = 1, 4 do
        local tb = _G.GetAutoGoTable(self.go_table["obj_gem" .. i])
        local data = gemList[i]
        if data then
            tb.obj_root:SetActiveE(1)
            tb.obj_empty:SetActiveE(0)
            _G.ItemFactory:GetInstance():GetItemCard(
                _G.ItemFactory.itemType.ItemGemstoneBase,
                tb.obj_root,
                function(trans)
                    if not self.go_table then
                        return
                    end
                    trans:ShowData(data, function()
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GemstoneTipView.Name,
                            {
                                data = data,
                                btn = {
                                    GoBtnCall = function()
                                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GemstoneToggleView.Name)
                                        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.CardResonanceView.Name)
                                    end
                                }
                            })
                    end)
                end
            )
        else
            tb.obj_root:SetActiveE(0)
            tb.obj_empty:SetActiveE(1)
        end
    end
end

function CardResonanceOrderHallPanel:ShowLvUpEffect()
    if self.effLvDic == nil then
        self.effLvDic = {}
    end
    for i = 1, 5 do
        if self.cards[i] then
            if self.effLvDic[i] == nil then
                self.effLvDic[i] = true
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.ef_jueseshengji_1,
                    self.roleItemsTb[i].obj_lvUpEff,
                    function(trans)
                        if self.go_table == nil then
                            _G.DestroyObject(trans)
                            return
                        end
                        self.effLvDic[i] = trans
                    end
                )
            elseif self.effLvDic[i] ~= true then
                self.effLvDic[i]:SetActiveE(0)
                self.effLvDic[i]:SetActiveE(1)
            end
        end
    end
end

---切页签隐藏特效，防止setActive时播放
function CardResonanceOrderHallPanel:HideAllLvUpEffect()
    if self.effLvDic then
        for _, v in pairs(self.effLvDic) do
            if v ~= true then
                v:SetActiveE(0)
            end
        end
    end
end

function CardResonanceOrderHallPanel:OnClickRole(go, isOn, index)
    local data = { CardData = self.cards[index], CallBack = _G.handler(self, self.UpdateRoles) }
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CardShowView.Name, data)
end

function CardResonanceOrderHallPanel:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 1)
    elseif go == self.go_table.aorbtn_levelUp then
        local canUp, nextCfg = CardResonanceModel:GetInstance():GetStageCanUpLevel()
        if not canUp then
            if nextCfg ~= nil then
                _G.PopWindowManager:GetInstance():ShowAllTips(190106)
            end
            return
        end
        local power = _G.StorageManager:GetInstance():GetPlayerPower()

        _G.AudioManager.PlayAudioByAudioCfgID(2030)
        self:ShowLvUpEffect()
        CardResonanceModel:GetInstance():StageLevelUp(
            1,
            function()
                self:UpdateProp()
                local offset = _G.StorageManager:GetInstance():GetPlayerPower() - power
                if offset > 0 then
                    require "CommonTipManager".OpenPowerUpView(power, offset)
                end
            end
        )
    end
end

function CardResonanceOrderHallPanel:OnDestroy()
    self:RemoveAllListener()
end

return CardResonanceOrderHallPanel
