function CardResonanceCardRechargePanel:ClearAllEffects()
    for i = 1, 10 do
        --local obj = self.go_table["obj_got" .. i]
        --UIUtils.RemoveChildren(obj)
        self.obj_FlashSpecialEffectList[i]:SetActiveE(0)
        self.obj_FlameEffectList[i]:SetActiveE(0)
        if i == 10 then
            self.stoneUpNum = CardResonanceModel:GetInstance():GetStoneUpNum()
            if self.CurMoveNum < self.stoneUpNum then
                self:UpdatePower()
                --self.bufferInstruction = self.bufferInstruction - 1
                local left = self.stoneUpNum - self.CurMoveNum
                if left >= 10 then
                    self:ShowDotBuffer()
                else
                    self.lastNum = 1
                    self:ShowDot()
                end
            else
                --可点击充能
                self.wait = false
                self:UpdatePower()
            end
            self.go_table.aorimage_dot.fillAmount = 0
        end
    end
end

---设置属性
function CardResonanceCardRechargePanel:ShowProp()
    local ChildCount = self.go_table.obj_PropContent:GetChildCountE()
    if ChildCount > 0 then
        for i = 1, ChildCount do
            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_PropContent:GetChildE(i - 1), _G.ePoolType.UIItem)
        end
    end

    self:calcProp()
end

---统计刷新
function CardResonanceCardRechargePanel:calcProp()
    local propData = self:GetShowProp()
    local showList = {}
    for i, v in pairs(propData) do
        _G.table.insert(showList, {key = i, sortId = _G.AttrType[i].sortid, num = v})
    end
    _G.SortList(
        showList,
        function(a)
            return -a.sortId
        end
    )
    for _, v in pairs(showList) do
        local tran = _G.InstantiateObject(self.go_table.obj_BaseProp, self.go_table.obj_PropContent)
        if tran then
            local tb = _G.GetAutoGoTable(tran)
            tb.aortext_Name.text = _G.AttrType[v.key].des .. ":"
            local numStr = v.num
            if _G.AttrType[v.key].percentage == 1 then
                numStr = _G.GameUtil.FormatNum(numStr * 100)
                numStr = "<color=#6effc6>" .. tostring(numStr) .. "%" .. "</color>"
            else
                numStr = _G.GameUtil.NumberWY(_G.math.floor(numStr))
            end
            tb.aortext_Num.text = numStr
            tb.gameObject:SetActiveE(1)
        end
    end
end

---计算当前显示的属性
function CardResonanceCardRechargePanel:GetShowProp(num)
    local newPropData = {}
    num = num or 0
    for index, v in pairs(propKeyList) do
        local addNum =  self.basePropConfig[index] or 0
        newPropData[v] = addNum * (num + self.stoneUpNum)
    end

    return newPropData
end

