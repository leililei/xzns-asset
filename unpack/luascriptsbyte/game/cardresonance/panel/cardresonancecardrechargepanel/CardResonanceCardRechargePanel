function CardResonanceCardRechargePanel:OnDestroy()
    self:RemoveAllListener()
    self.obj_gotList = nil
    self.obj_FlashSpecialEffectList = nil
    self.obj_FlameEffectList = nil
    if self.go_table then
        for i = 1, 10 do
            local obj = self.go_table["obj_got" .. i]
            UIUtils.RemoveChildren(obj)
        end
    end
    self.go_table = nil
end

return CardResonanceCardRechargePanel
