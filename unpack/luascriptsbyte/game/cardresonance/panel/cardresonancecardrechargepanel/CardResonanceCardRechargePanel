function CardResonanceCardRechargePanel:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end

function CardResonanceCardRechargePanel:Awake()
end

function CardResonanceCardRechargePanel:OnCreate()
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.CardRechargePanel, self.go_table)
    self.wait = false
    self:InitUI()
    local resources = _G.ConfigManager.ui_cfg.MainView.resources
    self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, resources))
    self.playerHead =
        self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))
    self.itemData = _G.ConfigManager.discrete_cfg[102514][1]
    self.basePropConfig = _G.ConfigManager.discrete_cfg[102515][1]
    self.power = _G.StorageManager:GetInstance():GetPlayerPower()
    self:InitPropItem()
    self:UpdateView(true)
    self:UpdateRoles()
end

function CardResonanceCardRechargePanel:InitUI()
    --self.bufferInstruction = 0
    if self.isLoadIng then
        return
    end
    self.CurMoveNum = CardResonanceModel:GetInstance():GetStoneUpNum()
    self.obj_gotList = {}
    --闪光特效list
    self.obj_FlashSpecialEffectList = {}
    --火焰特效list
    self.obj_FlameEffectList = {}
    self.isLoadIng = true
    self.isLoadComp = false
    self.AsyCount = 0
    self.AsyCountAddComp = false
    for i = 1, 10 do
        local obj = self.go_table["obj_got" .. i]
        table.insert(self.obj_gotList,obj)
        self.AsyCount = self.AsyCount + 1
        UIUtils.LoadEffectByCfg(
                effectCfg.ef_shanguang,
                obj,
                handlerbind(self, self.FlashSpecialEffectLoadBack, i)
        )
        self.AsyCount = self.AsyCount + 1
        UIUtils.LoadEffectByCfg(
                effectCfg.ef_nenglianghuoyan,
                obj,
                handlerbind(self, self.FlameEffectLoadBack, i)
        )
    end
    self.AsyCountAddComp = true
    if self.AsyCount == 0 and self.AsyCountAddComp then
        self.isLoadComp = true
    end
end

function CardResonanceCardRechargePanel:Refreshobj_gotList()
    local num = self.stoneUpNum % 10
    if self.stoneUpNum == 0 then
        self.lastNum = 1
    end

    local endIndex = num == 0 and 10 or num
    for i = 1, endIndex do
        if num ~= 0 then
            self.obj_FlameEffectList[i]:SetActiveE(1)
        end
    end
end

function CardResonanceCardRechargePanel:FlashSpecialEffectLoadBack(trans,_,index)
    if self.go_table == nil then
        _G.DestroyObject(trans)
        return
    end
    self.obj_FlashSpecialEffectList[index] = trans
    trans:SetActiveE(0)
    self:LoadCompBack()
end

function CardResonanceCardRechargePanel:FlameEffectLoadBack(trans,_,index)
    if self.go_table == nil then
        _G.DestroyObject(trans)
        return
    end
    self.obj_FlameEffectList[index] = trans
    trans:SetActiveE(0)
    self:LoadCompBack()
end

function CardResonanceCardRechargePanel:LoadCompBack()
    self.AsyCount = self.AsyCount - 1
    if self.AsyCount == 0 and self.AsyCountAddComp then
        self.isLoadComp = true
        self:Refreshobj_gotList()
    end
end

function CardResonanceCardRechargePanel:UpdateView(isFirst)
    self.stoneUpNum = CardResonanceModel:GetInstance():GetStoneUpNum()
    self:ShowProp()
    self:UpdateProp()
    self:ShowDot(isFirst)
end

function CardResonanceCardRechargePanel:ShowDot(isFirst)
    local num = self.stoneUpNum % 10
    if self.stoneUpNum == 0 then
        self.lastNum = 1
    end

    local startIndex = isFirst and 1 or self.lastNum
    local endIndex = num == 0 and 10 or num

    for i = startIndex, endIndex do
        local obj = self.go_table["obj_got" .. i]
        if isFirst then
            if num ~= 0 and self.isLoadComp then
                self.obj_FlameEffectList[i]:SetActiveE(1)
            end
            self.go_table.aorimage_dot.fillAmount = num ~= 0 and (num - 1) / 10 or 0
        else
            self:LoadEffectsWithDelay(obj, i, endIndex,startIndex)
        end
    end
    -- 更新下次调用的起始索引
    self.lastNum = endIndex % 10 + 1
    
    self.go_table.aortext_progress.text = _G.LangUtil.GetLangPackValue(90032600002, num, math.floor(self.stoneUpNum / 10))
end

