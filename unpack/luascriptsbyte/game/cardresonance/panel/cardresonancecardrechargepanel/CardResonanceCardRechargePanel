function CardResonanceCardRechargePanel:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 149)
    elseif go == self.go_table.aorbtn_levelUp then
        local canUp = CardResonanceModel:GetInstance():GetRechargeCanUpLevel()
        if self.wait and self.isSendDataIng == false then
            if not canUp then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ConfigManager.discrete_cfg[102514][1][1])
            else
                --self.bufferInstruction = self.bufferInstruction + 1
                self:SendRequest()
            end
            return
        end
        if self.wait or self.isLoadComp == false then
            return
        elseif not canUp then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ConfigManager.discrete_cfg[102514][1][1])
        else 
            self:OnClickPropBtn()
            self.wait = true
        end
    end
end

---属性按钮
function CardResonanceCardRechargePanel:OnClickPropBtn()
    self.propUseNum = math.floor(_G.StorageManager:GetInstance():GetItemCountBySid(self.itemData[1]) / self.itemData[2]) 
    local num = 10 - self.stoneUpNum % 10
    self.propUseNum = self.propUseNum > num and num or self.propUseNum

    self.isSendDataIng = true
    CardResonanceModel:GetInstance():DevelopStone(
        self.propUseNum,
        function()
            self:LoadEffect()
            _G.StorageManager:GetInstance():ConsumeItem(self.itemData[1], self.itemData[1], self.propUseNum)

            ---刷新界面
            self:UpdateView()
            self.isSendDataIng = false
            --require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.CardconmonDevelop.id)
        end
    )
end

function CardResonanceCardRechargePanel:SendRequest()
    self.propUseNum = math.floor(_G.StorageManager:GetInstance():GetItemCountBySid(self.itemData[1]) / self.itemData[2])
    local num = 10 - self.stoneUpNum % 10
    self.propUseNum = self.propUseNum > num and num or self.propUseNum

    self.isSendDataIng = true
    CardResonanceModel:GetInstance():DevelopStone(
            self.propUseNum,
            function()
                _G.StorageManager:GetInstance():ConsumeItem(self.itemData[1], self.itemData[1], self.propUseNum)

                local num = self.stoneUpNum % 10
                local endIndex = num == 0 and 10 or num
                self.lastNum = endIndex % 10 + 1
                self:UpdateProp()
                self.isSendDataIng = false
                --require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.CardconmonDevelop.id)
            end
    )
end

---充能成功战力变化提示
function CardResonanceCardRechargePanel:UpdatePower()
    ---属性变化提示
    local curProp = self:GetShowProp(self.propUseNum)
    --self.propUseNum = 0
    local lastProp = self:GetShowProp()
    UIUtils.ShowPropUp(nil, lastProp, nil, {prop = curProp})
    ---战力变化提示
    _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.GodStoneRecharge)
    local newPower = _G.StorageManager:GetInstance():GetPlayerPower()
    local offset = newPower - self.power
    if offset > 0 then
        require "CommonTipManager".OpenPowerUpView(self.power, offset)
        self.power = newPower
    end
end

