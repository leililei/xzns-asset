end

---获取当前战斗关卡
function DemoActivityModel:GetCurFightSectionId()
	return self.curFightSectionId
end

---检测是否完成所有关卡
function DemoActivityModel:CheckIsFinishAll()
    return self.curSectionId == 0
end

---获取可上阵卡牌
function DemoActivityModel:GetPutCard()
    ---@type card_trial_cfg
    local cfg2 = _G.ConfigManager.card_trial_cfg[self:GetCurSectionId()]
    local tb = {}
    local insert = _G.table.insert
    ---@type CardData
    local data
    ---@type monster_cfg
    local cfg
    for _, v in pairs(cfg2.cards_usable) do
        data = _G.CardData.New()
        cfg = _G.ConfigManager.monster_cfg[v]
        data:Parse({sid = cfg.CardID, uid = cfg.CardID, star = cfg.Stars, lv = cfg.Level})
        data.power = cfg.Power
        insert(tb, data)
    end
    data = _G.CardData.New()
    cfg = _G.ConfigManager.monster_cfg[cfg2.format_swap[1]]
    data:Parse({sid = cfg.CardID, uid = cfg.CardID, star = cfg.Stars, lv = cfg.Level})
    data.power = cfg.Power
    insert(tb, data)
    return tb
end
---领取卡牌
function DemoActivityModel:GetCard(call)
    require "DemoNet":GetInstance():ActivityAward(
        {activity_id = self.curActivityClass:GetActivityID()},
        _G.handlerbind(self, self.GetCardCall, call)
    )
end
---领取卡牌回调
function DemoActivityModel:GetCardCall(msg, call)
    if msg.ack ~= 1 then
        return
    end
    self.isGet = true
    if call then
        call(require "DemoModel":GetInstance():AddCard(msg))
    end
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

---检测是否领取卡牌
function DemoActivityModel:CheckIsGet()
    return self.isGet
end

---战斗胜利
function DemoActivityModel:FightWin()
    self.finishSectionList[self:GetCurFightSectionId()] = true
    self:InitCurSection()
    _G.Events:GetInstance():Broadcast(_G.eDemo.FinishFight)
    if self.WinCallback then
        self.WinCallback()
        self.WinCallback = nil
    end
end

---战斗失败
function DemoActivityModel:FightLose()
    self:ExitEmbattle()
end
---检测战斗
function DemoActivityModel:CheckCanFight()
    return self.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Open
end
