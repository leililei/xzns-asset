local base = require "ActivitySynTypeBase"
local ActivitySynManager = require "ActivitySynManager"
---@class DemoActivityModel	: ActivitySynTypeBase
---@field info activity_card_trial.i_activity_card_trial
local DemoActivityModel = _G.BaseClass("DemoActivityModel", base)
function DemoActivityModel:__init()
    _G.Events:GetInstance():AddListener(self.curActivityClass.regiestStateChangedStr, self.StateChanged, self)
end

function DemoActivityModel:StateChanged(state)
    if state == ActivitySynManager.State.Close then
        local isExist, view = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.EmbattleView.Name)
        if isExist and self.isFight then
            view.View:QuitEmbattle()
            --_G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DemoSectionView.Name)
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DemoView.Name)
        else
            if _G.UIManager:GetInstance():IsActiveWindow(_G.ConfigManager.ui_cfg.DemoView.Name) then
                _G.PopWindowManager:GetInstance():ShowAllTips(
                    730102,
                    nil,
                    function()
                        --_G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DemoSectionView.Name)
                        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DemoView.Name)
                    end
                )
            end
        end
    end
end
---获取GM数据
function DemoActivityModel:OnHandleGMData(info)
    self:ParseData(info)
end

function DemoActivityModel:ParseData(info)
    self:SetSelfData(info)
    base.ParseData(self)
end

---@param info activity.i_activity_self_info
function DemoActivityModel:SetSelfData(info)
    local trail = info.trial
    self.sectionList = trail.all_trial
    self.cardSid = trail.card_sid
    self.isGet = trail.card_award == 1
    self.time = trail.time
    self:InitFinish(trail.trial)
    self:InitCurSection()
    self:InitImage(info.trial)

    if self.isGet then
        self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
    end
end

---初始化图片
---@param info activity_card_trial.i_activity_card_trial
function DemoActivityModel:InitImage(info)
    local bgContent = _G.string.split(info.bg, "|")
    self.bg = {}
    for i = 1, #bgContent do
        _G.table.insert(self.bg, self:ParseImage(bgContent[i]))
    end
    self.hero = self:ParseImage(info.hero_bg)
    self.title = self:ParseImage(info.title)
    local content = _G.string.split(info.content, "|")
    self.content = self:ParseImageBy1D(content[1])
    self.sectionContent = self:ParseImageBy1D(content[2])
end

function DemoActivityModel:ParseImage(content)
    if _G.string.IsNullOrEmpty(content) then
        return {}
    end
    local str = _G.string.split(content, "|")
    local str2 = _G.string.split(str[1], "#")
    local imagePath = str2[#str2]
    local type --2 spine， 其它 图片
    local layer = 2 --1背景， 2前景
    if #str2 >= 2 then
        type = _G.tonumber(str2[1])
    end
    if #str2 == 3 then
        layer = _G.tonumber(str2[2])
    end
    local pos = {x = 0, y = 0, z = 0}
    if str[2] then
        local str3 = _G.string.split(str[2], "#")
        pos = {x = _G.tonumber(str3[1]), y = _G.tonumber(str3[2]), z = 0}
    end
    local scale
    if str[3] then
        scale = _G.tonumber(str[3])
    end
    return {image = imagePath, pos = pos, type = type, scale = scale, layer = layer}
end

---@private
function DemoActivityModel:ParseEffect(content)

end

function DemoActivityModel:ParseImageBy1D(content)
    if _G.string.IsNullOrEmpty(content) then
        return {}
    end
    local str = _G.string.split(content, "#")
    local imagePath = str[1]
    local pos = {x = 0, y = 0, z = 0}
    pos = {x = _G.tonumber(str[2]), y = _G.tonumber(str[3]), z = 0}
    return {image = imagePath, pos = pos}
end

function DemoActivityModel:InitFinish(msg)
    self.finishSectionList = {}
    if msg then
        for _, v in pairs(msg) do
            self.finishSectionList[v] = true
        end
    end
end
---初始化当前关卡
function DemoActivityModel:InitCurSection()
    self.curSectionId = 0
    for i = 1, self:GetSectionCount() do
        if not self:CheckIsFinish(self.sectionList[i]) then
            self.curSectionId = self.sectionList[i]
            break
        end
    end
end

function DemoActivityModel:GetSectionWithIndex(index)
    if not self.sectionList then
        return 0
    end
    return self.sectionList[index]
end

function DemoActivityModel:GetIndexWithSection(sectionId)
    if not self.sectionList then
        return 1
    end
    for i, v in pairs(self.sectionList) do
        if sectionId == v then
            return i
        end
    end
    return 1
end

---获取关卡数
function DemoActivityModel:GetSectionCount()
    return self.sectionList and #self.sectionList or 0
end
---检测该关卡是否完成
function DemoActivityModel:CheckIsFinish(sid)
    return self.finishSectionList[sid]
end

---获取界面名字
function DemoActivityModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.DemoView.Name
end

---初始化红点
function DemoActivityModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {{2}, false}
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function DemoActivityModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---检测红点
function DemoActivityModel:CheckRedPoint()
    if not self:CheckCanFight() then
        return 0
    end
    if not self:CheckIsGet() then
        return 1
    end
    return 0
end

---进入活动
function DemoActivityModel:OnEnterActivity()
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DemoView.Name)
    if window then
        window.View:UpdateView(self)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DemoView.Name, self.curActivityClass)
    end
    base.OnEnterActivity(self)
end

function DemoActivityModel:OnFight(index, callback)
    --if self:CheckIsFinishAll() then
    --    return
    --end
    self.isFight = true
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    --require("EmbattleModel"):GetInstance():ClearEmbattleData(_G.EmbattleType.ReedCatkins)
    local cfg
    if index then
        self.curFightSectionId = self:GetSectionWithIndex(index)
        cfg = _G.ConfigManager.card_trial_cfg[self.curFightSectionId]
    else
        cfg = _G.ConfigManager.card_trial_cfg[self:GetCurFightSectionId()]
    end
    require("EmbattleController"):GetInstance():OpenEmbattle(
        -1,
        _G.EmbattleSaveType.temporary,
        false,
        _G.EmbattleControllerItemType.demoActivity,
        _G.handler(self, self.ExitEmbattle),
        _G.handler(self, self.EnterFight),
        cfg.monster_group,
        self
    )
    if callback then
        self.WinCallback = callback
    end
end

---监听界面打开
---@param name string 界面名称
function DemoActivityModel:OnEmbattleViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.DemoView.Name)
        --_G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.DemoSectionView.Name)
        _G.Events:GetInstance():RemoveListener(
            _G.eUIManagerStatus.OnUIOpened,
            self.OnEmbattleViewOpened,
            self.curActivityClass
        )
    end
end

---退出战斗
function DemoActivityModel:ExitEmbattle()
    self.isFight = false
    if self:CheckCanFight() then
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.DemoView.Name)
        if self:CheckIsFinishAll() then
            --_G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DemoSectionView.Name)
        else
            --_G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.DemoSectionView.Name)
        end
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(
            730102,
            nil,
            function()
                --_G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DemoSectionView.Name)
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DemoView.Name)
            end
        )
    end
end

---进入战斗
function DemoActivityModel:EnterFight()
    self.isFight = false
    ---返回621 说明 有卡牌不满足要求
    if self.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Close then
        _G.PopWindowManager:GetInstance():Show(94)
        return
    end
    _G.BattleManager:GetInstance():EnterFight(_G.BattleControllerType.demoActivity, self, self.garry)
end

