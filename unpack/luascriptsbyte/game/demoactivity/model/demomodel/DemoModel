---检测是否为试玩卡
function DemoModel:CheckIsDemoCard(uid)
    return self.demoCards[uid]
end

function DemoModel:GetAllCards()
    return self.cards or {}
end

---获取某张卡某个布阵类型的剩余助战次数
function DemoModel:GetLastUseTimes(uid, id)
    ---@type CardTimerData
    local card = self.cards[uid]
    if card then
        return card:GetLastUseTimes(id)
    end
    return 0
end

function DemoModel:AddUseCount(id, isPass)
    if isPass then
        if self.tempEmbattle then
            for _, v in pairs(self.tempEmbattle) do
                for _, sid in pairs(v) do
                    if self:CheckIsDemoCard(sid) then
                        self.cards[sid]:AddUseTimes(id)
                    end
                end
            end
        end
        self.tempEmbattle = {}
    end
end

function DemoModel:SaveTempEmbattleData(id, sits)
    if self.tempEmbattle == nil then
        self.tempEmbattle = {}
    end
    self.tempEmbattle[id] = sits
end

function DemoModel:ClearTempEmbattleData()
    self.tempEmbattle = {}
end

---
---@protected
function DemoModel:CheckFailShow(type, sid)
    if table.isEmptyOrNil(self.cards) or (self.cards and table.toArray(self.cards)[1]:GetLastUseTimes(type) == 0) then
        return false
    end
    self:CheckIsFirst(type)
    if self.isFirst[type] then
        _G.PlayerPrefsManager.SetTable(KeySid .. type, { sid })
        self:ChangeIsFirst(type)
    else
        local list = _G.PlayerPrefsManager.GetTable(KeySid .. type)
        if list == nil then
            list = {}
        end
        if _G.table.ContainsValue(list, sid) then
            return false
        else
            _G.table.insert(list, sid)
            _G.PlayerPrefsManager.SetTable(KeySid .. type, list)
        end
    end
    return true
end

---检测是否为当天首次打开
function DemoModel:CheckIsFirst(type)
    if _G.PlayerPrefsManager.HasKey(Key .. type) then
        local time = _G.PlayerPrefsManager.GetInt(Key .. type, 0)
        local time2 = self:GetTime()
        self.isFirst[type] = time < time2
    else
        self.isFirst[type] = true
    end
end

function DemoModel:ChangeIsFirst(type)
    if self.isFirst[type] then
        self.isFirst[type] = false
        _G.PlayerPrefsManager.SetInt(Key .. type, self:GetTime())
    end
end

function DemoModel:GetTime()
    local time = _G.TimeUtil.GetServerUnixTime()
    local data = _G.TimeUtil.GetDateTime(time)
    if data.hour < _G.TimeUtil.GAME_DAY_HOUR then
        return _G.TimeUtil.GetDayBegin(time - _G.TimeUtil.GAME_DAY_TIME) + _G.TimeUtil.GAME_DAY_TIME
    else
        return _G.TimeUtil.GetDayBegin(time) + _G.TimeUtil.GAME_DAY_TIME
    end
end

return DemoModel
