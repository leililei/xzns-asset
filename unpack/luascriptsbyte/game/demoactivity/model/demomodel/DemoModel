---获取出战npc
---@param demoCard card.i_card_demo
function DemoModel:GetCardProp(demoCard, param)
    if not param then
        param = self:GetMaxParams()
    end
    ---@type prop.i_card
    local msg = {}
    local cfg = _G.ConfigManager.card_cfg[demoCard.sid]
    msg.sid = demoCard.sid
    msg.uid = demoCard.uid
    msg.lv = param.maxLevel
    msg.star = cfg.Star > param.maxStar and cfg.Star or param.maxStar
    msg.soul_chain_lv = param.maxHunLian
    msg.soul_state = param.hunlianIsActive
    msg.open_inborn = {}
    if param.maxTF > 0 then
        local index = 0
        for i = 1, #cfg.talent do
            for j = 1, #cfg.talent[i] do
                index = index + 1
                msg.open_inborn[index] = cfg.talent[i][j]
                if index >= param.maxTF then
                    break
                end
            end
            if index >= param.maxTF then
                break
            end
        end
    end
    msg.big_born_num = require("CardInfoManager"):GetInstance():GetTalentsNumByInborn(msg.open_inborn)
    local tb = {}
    local count = _G.table.count(_G.EquipmentPart)
    if param.maxGrade > 0 then
        for i = 1, count do
            if i ~= 3 then
                ---@type card_cfg
                local cfg = _G.ConfigManager.card_cfg[msg.sid]
                ---@type prop.i_equipment
                local data2 = {}
                data2.sid = 201000000 + param.maxGrade + cfg.EquipmentType * 1000 + i * 100
                data2.uid = 0
                data2.streng = param.maxStreng
                data2.exp = 0
                --data2.element = cfg.EquipmentType
                data2.reset_element = 0
                _G.table.insert(tb, data2)
            end
        end
    end
    local artifactTb = {}
    if param.maxArtifactOrder > 0 then
        local artifact
        if cfg.artifactid and cfg.artifactid > 0 then
            artifact = {
                sid = cfg.artifactid,
                uid = 0,
                num = 1,
                level = param.maxArtifactLevel,
                star = param.maxArtifactStar,
                awaken = param.maxArtifactAwaken
            }
        else
            artifact = {
                sid = 255000000 + param.maxArtifactOrder * 100000 + cfg.Professional * 10000 + 100,
                uid = 0,
                num = 1,
                level = param.maxArtifactLevel,
                star = param.maxArtifactStar,
                awaken = param.maxArtifactAwaken
            }
        end
        _G.table.insert(artifactTb, artifact)
    end
    local spiritualTb = {}
    if param.maxSpiritualOrder > 0 then
        for index, v in pairs(param.maxSpiritualTb) do
            local spiritual = {
                sid = v.sid,
                uid = 0,
                num = 1,
                level = v.lv,
                star = v.star,
                index = index,
                unlock = v.unlock
            }
            spiritualTb[index] = spiritual
        end
    end
    msg.equipments = tb
    msg.artifact = artifactTb
    msg.spiritual = spiritualTb

    return msg
end
---获取卡牌参数
function DemoModel:GetMaxParams()
    ---@type CardData[]
    local datas = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    datas = _G.table.toArray(datas)
    _G.SortList(
            datas,
            function(data)
                return data.power, data.star, data.Grade, data.uid
            end
    )
    ---@type CardData[]
    local chooseCards = {}
    local count = #datas
    if count > 5 then
        count = 5
    end
    for i = 1, count do
        chooseCards[i] = datas[i]
    end
    local param = {
        maxLevel = 0,
        maxStar = 0,
        maxHunLian = 0,
        maxGrade = 0,
        maxStreng = 0,
        maxTF = 0,
        maxArtifactOrder = 0,
        maxArtifactLevel = 0,
        maxArtifactStar = 0,
        maxArtifactAwaken = 0
    }
    param.hunlianIsActive = false
    param.maxSpiritualOrder = 0
    param.maxSpiritualTb = {}
    local table = _G.table
    for _, v in pairs(chooseCards) do
        -- param.maxLevel = param.maxLevel + v:GetLevel()
        -- param.maxStar = param.maxStar + v.star
        -- if v.soulLink_IsActivate == 1 then
        --     param.hunlianIsActive = 1
        -- end
        -- param.maxHunLian = param.maxHunLian + v.soulLink_lv
        if not table.isEmptyOrNil(v.ArtifactBar) and v.ArtifactBar.type ~= _G.ArtifactDataType.Timer then
            if param.maxArtifactOrder <= v.ArtifactBar:GetOrder() then
                if param.maxArtifactOrder == 0 or param.maxArtifactOrder < v.ArtifactBar:GetOrder() then
                    param.maxArtifactOrder = v.ArtifactBar:GetOrder()
                    param.maxArtifactAwaken = v.ArtifactBar:GetAwaken()
                end
                if param.maxArtifactLevel == 0 or param.maxArtifactLevel < v.ArtifactBar:GetLevel() then
                    param.maxArtifactLevel = v.ArtifactBar:GetLevel()
                end
                if param.maxArtifactStar == 0 or param.maxArtifactStar < v.ArtifactBar:GetStar() then
                    param.maxArtifactStar = v.ArtifactBar:GetStar()
                end
            end
        end
        for _, v2 in pairs(v.EquipBar) do
            if not table.isEmptyOrNil(v2) then
                param.maxGrade = param.maxGrade + v2.Grade
                local v2str = v2.streng
                if v2str > v2.cfg.strengthen_level then
                    v2str = v2.cfg.strengthen_level
                end
                param.maxStreng = param.maxStreng + v2str
            end
        end
        -- if v.open_inborn then
        --     param.maxTF = #v.open_inborn + param.maxTF
        -- end
        if not table.isEmptyOrNil(v.SpiritualBar) then
            local totalOrder = 0
            for _, v in pairs(v.SpiritualBar) do
                totalOrder = totalOrder + v:GetGrade()
            end
            if param.maxSpiritualOrder < totalOrder then
                param.maxSpiritualOrder = totalOrder
                param.maxSpiritualTb = v.SpiritualBar
            end
        end
    end
    local equipCount = table.count(_G.EquipmentPart) - 1
    -- param.maxLevel = _G.Mathf.RoundToInt(param.maxLevel / count)
    param.maxStar = require("IllustrationModel"):GetInstance():GetTopNStarAverage(5)
    param.maxGrade = _G.Mathf.RoundToInt(param.maxGrade / (count * equipCount))
    param.maxStreng = _G.Mathf.RoundToInt(param.maxStreng / (count * equipCount))
    -- param.maxHunLian = _G.Mathf.RoundToInt(param.maxHunLian / count)
    -- param.maxTF = _G.Mathf.RoundToInt(param.maxTF / count)

    --新规则：星级到达时自动解锁魂链和天赋并满级
    --if param.maxStar >= _G.ConfigManager.discrete_cfg[102401][1][1] then
    --    param.hunlianIsActive = 1
    --    param.maxHunLian = 30
    --else
    --    param.hunlianIsActive = 0
    --    param.maxHunLian = 0
    --end
    --if param.maxStar >= _G.ConfigManager.discrete_cfg[107401][1][1] then
    --    param.maxTF = 22
    --else
    --    param.maxTF = 0
    --end

    --等级通过共鸣神石去计算卡牌等级
    local lv = _G.ConfigManager.discrete_cfg[114503][1][1]
    local model = require("CardResonanceModel"):GetInstance()
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Stone) then
        ---平均等级
        param.maxLevel = _G.Mathf.Max(lv, require("CardResonanceModel"):GetInstance():GetAverageLevel())
    else
        ---共鸣神石功能未开启时候使用配置的等级
        param.maxLevel = lv
    end
    return param
end

function DemoModel:InitFunction()
    if not self.demos then
        return
    end
    ---@type CardStorage
    -- local cardStorage = _G.StorageManager:GetInstance():GetDataStorageByID(_G.StorageID.Card)
    local params = self:GetMaxParams()
    local time = _G.TimeUtil.GetServerUnixTime()
    ---@type CardTimerData
    local data
    for _, v in pairs(self.demos) do
        if time < v.end_time then
            data = CardTimerData.New()
            self.cards[v.uid] = data
            data:Parse(self:GetCardProp(v, params))
            data:OnInitMutuallyData(true)
            data:SetTime(v.end_time)
            data:SetUseTimes(v.use_times)
            -- cardStorage:AddOtherTypeCard(data)
        end
        self.demoCards[v.uid] = true
    end
    self.demos = nil
end
---更新卡牌属性
function DemoModel:UpdateCards()
    -- if _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.CardShowView.Name) then
    --     self:UpdateAllCards()
    if nil == self.timer then
        if _G.table.isEmptyOrNil(self.cards) then
            return
        end
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateAllCards, self, true, true, true)
        self.timer:Start()
    end
end
---更新所有卡牌数据
function DemoModel:UpdateAllCards()
    local params = self:GetMaxParams()
    for _, v in pairs(self.cards) do
        v:Parse(self:GetCardProp({ sid = v.sid, uid = v.uid }, params))
        v:OnInitMutuallyData(true)
    end
    self.timer = nil
end

---移除卡牌
function DemoModel:RemoveCard(uid)
    if not self.cards then
        return
    end
    self.cards[uid] = nil
end
---添加卡牌
function DemoModel:AddCard(demo)
    -- local cardStorage = _G.StorageManager:GetInstance():GetDataStorageByID(_G.StorageID.Card)
    local data = CardTimerData.New()
    self.cards[demo.uid] = data
    data:Parse(self:GetCardProp(demo))
    data:OnInitMutuallyData(true)
    data:SetTime(demo.end_time)
    data:SetUseTimes(demo.use_times)
    -- cardStorage:AddOtherTypeCard(data)
    self.cards[demo.uid] = data
    self.demoCards[demo.uid] = true
    return data
end

function DemoModel:Dispose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.demoCardList then
        for _, v in pairs(self.demoCardList) do
            v:Dispose()
        end
        self.demoCardList = nil
    end
end
---获取卡牌背包战力最低的卡
function DemoModel:GetLowPower()
    ---@type CardData[]
    local datas = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    datas = _G.table.toArray(datas)
    _G.SortList(
            datas,
            function(data)
                return data.power, data.star, data.Grade, data.uid
            end
    )

    return datas[5] and datas[5].power or datas[#datas].power
