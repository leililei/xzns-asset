---@class DemoSectionView : UIBaseView	中文描述
---@field public go_table DemoSectionView_GoTable GoTable
---@field activity ActivitySynBase
---@field activityCls DemoActivityModel
---@field itemList  DemoSectionView._obj_awardItem_GoTable[]
local DemoSectionView = _G.BaseClass("DemoSectionView", _G.UIBaseView)
--_G.DemoSectionView = DemoSectionView

function DemoSectionView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function DemoSectionView:OnCreate(activity)
    self.itemList = {}
    self.go_table.scrollloophorizontal_awardList:InitItemData(0, _G.handler(self, self.RefreshItem))
    self:UpdateView(activity)
    self:AddListener(_G.eDemo.FinishFight, self.RefreshView)
end

function DemoSectionView:UpdateView(activity)
    self.activity = activity
    self.activityCls = self.activity:GetActivityTypeCls()
    local count = self.activityCls:GetSectionCount()
    self.go_table.scrollloophorizontal_awardList:UpdateScrollRectWeight(
        count < 3 and 106 * count + 23 * (count - 1) + 20 or 384
    )
    self.go_table.scrollloophorizontal_awardList:UpdateCount(count)
    local cfg = _G.ConfigManager.card_trial_cfg[self.activityCls:GetCurSectionId()]
    if cfg then
        self.go_table.aortext_content.text = _G.LangUtil.GetLangPackValue(cfg.desc[1])
    end
end
---刷新界面
function DemoSectionView:RefreshView()
    self.go_table.scrollloophorizontal_awardList:UpdateAllItem()
    local cfg = _G.ConfigManager.card_trial_cfg[self.activityCls:GetCurSectionId()]
    if cfg then
        self.go_table.aortext_content.text = _G.LangUtil.GetLangPackValue(cfg.desc[1])
    end
end

---刷新物体显示
function DemoSectionView:RefreshItem(index, obj)
    local id = obj:GetInstanceIDE()
    local tb = self.itemList[id]
    if not tb then
        tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, index))
        self.itemList[id] = tb
    end
    local id = self.activityCls:GetSectionWithIndex(index + 1)
    tb.obj_mask:SetActiveE(id > self.activityCls:GetCurSectionId() and 1 or 0)
    if id == self.activityCls:GetCurSectionId() then
        if not self.effect then
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_IceGiftWhiteBox,
                obj,
                function(obj)
                    if self:IsNil() then
                        _G.DestroyImmediate(obj)
                        return
                    end
                    obj:SetLocalScaleXYZ(0.8)
                    self.effect = obj
                end
            )
        else
            self.effect:SetParentE(obj)
        end
    end

    ---@type card_trial_cfg
    local cfg = _G.ConfigManager.card_trial_cfg[id]
    tb.aortext_name.text = _G.LangUtil.GetLangPackValue(cfg.name)
    if self.activityCls:CheckIsFinish(id) then
        tb.obj_isOff:SetActiveE(0)
        tb.obj_isOn:SetActiveE(1)
    else
        tb.obj_isOff:SetActiveE(1)
        tb.obj_isOn:SetActiveE(0)
    end
end

function DemoSectionView:OnClickItem(go, _, index)
    local id = self.activityCls:GetSectionWithIndex(index + 1)
    ---@type card_trial_cfg
    self.go_table.aorbtn_TipsView:SetActiveE(1)
    local x, y, z = go:GetPosition()
    self.go_table.obj_ItemTips:SetPosition(x, y + 2.5, z)
    self:ShowTips(id)
end

function DemoSectionView:ShowTips(id)
    local award = _G.ConfigManager.card_trial_cfg[id].reward
    if not self.itemTable then
        self.itemTable = {}
    end
    for key, value in pairs(self.itemTable) do
        value.Despawn(value)
        self.itemTable[key] = nil
    end
    local NowItems = award
    local count = #NowItems
    local count2 = 0
    for i = 1, count do
        self:CareatItem(NowItems[i], self.go_table.obj_Parent, self.itemTable, id)
    end
    local tf = self.go_table.obj_ItemTips:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    if not _G.IsNil(tf) then
        tf:SetSizeWithCurrentAnchors(_G.CS.UnityEngine.RectTransform.Axis.Horizontal, count2 * 68)
    end
    self.go_table.obj_ItemTips:SetRectTransformSize(10 + count * 68)
end
function DemoSectionView:CareatItem(tb, Parent, itemTable, id)
    if _G.IsNil(Parent) or Parent:GetctiveInHierarchy() == 0 then
        return
    end
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        tb,
        Parent,
        function(item)
            item.gameObject:SetLocalScaleXYZ(0.7)
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            item:SetGou(self.activityCls:CheckIsFinish(id))
            --endregion------------------------------------物品 特效 防止因异步加载 延迟导致显示错误--------
            table.insert(itemTable, item)
        end,
        function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, tb[1])
        end
    )
end

---战斗
function DemoSectionView:OnFight()
    if not self.activityCls:CheckCanFight() then
        _G.PopWindowManager:GetInstance():ShowAllTips(650104)
        return
    end
    self.activityCls:OnFight()
    self.go_table.aorbtn_TipsView:SetActiveE(0)
end

---按钮点击事件在这里派发
function DemoSectionView:OnClickBtn(go)
    if go == self.go_table.aorbtn_start then
        self:OnFight()
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_TipsView then
        self.go_table.aorbtn_TipsView:SetActiveE(0)
    end
end

return DemoSectionView
