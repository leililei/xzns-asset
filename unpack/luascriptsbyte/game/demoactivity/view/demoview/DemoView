local CardHunLianModel = require "CardHunLianModel"

---@class DemoView : UIBaseView    中文描述
---@field public go_table DemoView_GoTable GoTable
---@field activity ActivitySynGMActivity
---@field activityCls DemoActivityModel
local DemoView = _G.BaseClass("DemoView", _G.UIBaseView)

function DemoView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

local abilityName = {
    [1] = _G.GetLangPackValue(90020300069),
    [2] = _G.GetLangPackValue(90020300115),
    [3] = _G.GetLangPackValue(90059010001)
}

local skillSign = {
    "I",
    "II"
}

---界面的入口函数
---@param activity ActivitySynBase
function DemoView:OnCreate(activity)
    self.anim = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    self:UpdateView(activity)
    self:AddListener(_G.eDemo.FinishFight, self.UpdateBtn)
end

---更新界面
---@param activity ActivitySynBase
function DemoView:UpdateView(activity)
    self.activity = activity
    self.activityCls = self.activity:GetActivityTypeCls()
    if self.activityCls:CheckIsFinishAll() then
        self.curSec = 1
    else
        self.curSec = self.activityCls:GetIndexWithSection(self.activityCls:GetCurSectionId())
    end
    self:UpdateBtn()
    self:UpdateTimer()
    self:UpdateOther()
    self:UpdateSection()
end

function DemoView:UpdateOther()
    local bg = self.activityCls:GetBg()
    local parent
    for i = 1, #bg do
        parent = bg[i].layer == 2 and self.go_table.aorrawimage_preBg or self.go_table.aorrawimage_bg
        self:UpdateImage(parent, bg[i])
    end
    self:UpdateImage(self.go_table.aorrawimage_font, self.activityCls:GetContent())
    self:UpdateImage(self.go_table.aorrawimage_title, self.activityCls:GetTitle())
    self:UpdateImage(self.go_table.aorrawimage_sectionFont, self.activityCls:GetSectionContent())
    local obj, pos, scale = self.activityCls:GetHero()
    if not _G.string.IsNullOrEmpty(obj) then
        _G.PoolsManager:GetInstance():Spawn(
            obj,
            _G.ePoolType.Temporary,
            self.go_table.trans_role,
            function(obj)
                if self:IsNil() then
                    _G.DestroyObject(obj)
                    return
                end
                obj:SetLocalPosition(pos.x, pos.y, pos.z)
                if scale then
                    obj:SetLocalScaleXYZ(scale)
                end
                local skeleton = obj:GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
                if skeleton then
                    skeleton.raycastTarget = false
                end
            end
        )
        self.go_table.obj_test:SetActiveE(0)
    else
        self.go_table.obj_test:SetActiveE(1)
    end
end

---初始化关卡信息
function DemoView:UpdateSection()
    self.cardSid = self.activityCls:GetCardSid()
    self.cardTalent = _G.ConfigManager.card_cfg[self.cardSid].talent
    self.tabList = {}
    for i = 1, 3 do
        ---@type DemoView._obj_tab1_GoTable
        local tab = _G.GetAutoGoTable(self.go_table["obj_tab" .. i], _G.handlerbind(self, self.OnClickTab, i))
        _G.table.insert(self.tabList, tab)
        if i == 1 then
            tab.obj_lock:SetActiveE(0)
        else
            local preSectionId = self.activityCls:GetSectionWithIndex(i - 1)
            tab.obj_lock:SetActiveE(self.activityCls:CheckIsFinish(preSectionId) and 0 or 1)
        end
        local sectionId = self.activityCls:GetSectionWithIndex(i)
        ---@type card_trial_cfg
        local cfg = _G.ConfigManager.card_trial_cfg[sectionId]
        tab.aortext_tabName.text = _G.LangUtil.GetLangPackValue(cfg.name)
        tab.aortext_tabName.color = _G.ColorTools.FormatColorByString("a675af")
        tab.aorrawimage_bgChoose:SetActiveE(0)
        if tab.obj_eff:GetChildCountE() == 0 then
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_xuanzhong_quad,
                tab.obj_eff,
                function(eff)
                    if not tab then
                        _G.UIUtils.RemoveEffect(eff)
                    end
                end
            )
        end
        if i == self.curSec then
            tab.obj_eff:SetActiveE(1)
            tab.aorrawimage_bgChoose:SetActiveE(1)
            tab.aortext_tabName.color = _G.ColorTools.FormatColorByString("515268")
        else
            tab.obj_eff:SetActiveE(0)
        end
    end

    local skillId, skillCfg, lv
    for i = 1, 5 do
        if i ~= 2 then
            lv = 1
            while true do
                skillId = self.cardSid + i * 100 + lv
                skillCfg = _G.ConfigManager.card_skills_cfg[skillId]
                if not skillCfg then
                    skillId = self.cardSid + i * 100 + lv - 1
                    skillCfg = _G.ConfigManager.card_skills_cfg[skillId]
                    break
                end
                lv = lv + 1
            end
            local tb =
                _G.GetAutoGoTable(self.go_table["obj_skill" .. i], _G.handlerbind(self, self.OnClickSkill, skillId))
            _G.GameUtil.SetActiveByCondition(tb.aorimage_nuqi, skillCfg.skill_pos == 1)
            require("CardInfoManager").LoadRawImage(tb.aorrawimage_skill, skillCfg.icon)
        end
    end

    local cardData = _G.CardData.New()
    cardData:Parse({sid = self.cardSid, uid = self.cardSid})
    require("CardHunLianManger"):GetInstance():SetDataHunLian(cardData)
    local soulChainCfg = require("CardHunLianModel"):GetInstance():GetAllExclusiveCf_attribute_display(self.cardSid)
    for i = 1, 7, 2 do
        local tb =
            _G.GetAutoGoTable(self.go_table["obj_skill_node_" .. i], _G.handlerbind(self, self.OnClickSoulChain, i))
        tb.aorrawimage_icon_1:LoadImage(soulChainCfg[i].icon)
    end

    self.talentData = {}
    local count = 1
    for i = 1, #self.cardTalent do
        local talents = self.cardTalent[i]
        for j = 1, #talents do
            local tCfg = _G.ConfigManager.attribute_cfg[talents[j]]
            if tCfg.skill > 0 then
                skillCfg = _G.ConfigManager.card_skills_cfg[tCfg.skill]
                local tb =
                    _G.GetAutoGoTable(
                    self.go_table["obj_talent" .. count],
                    _G.handlerbind(self, self.OnClickTalent, tCfg.id)
                )
                tb.aorrawimage_openIcon:LoadImage(skillCfg.icon)
                --tb.aortext_openName.text = _G.GetLangPackValue(skillCfg.name1)
                tb.aortext_sign.text = skillSign[count]
                count = count + 1
                self.talentData[tCfg.id] = {}
                self.talentData[tCfg.id].name1 = skillCfg.name1
                self.talentData[tCfg.id].icon = skillCfg.icon
                self.talentData[tCfg.id].describe1 = skillCfg.describe1
            end
        end
        if count > 2 then
            break
        end
    end

    local sectionId = self.activityCls:GetSectionWithIndex(self.curSec)
    self:ShowAbilityAndAward(self.curSec, sectionId)
end

---@private
---@param go DemoView._obj_tab1_GoTable
function DemoView:OnClickTab(go, isOn, index)
    local sectionId = self.activityCls:GetSectionWithIndex(index)
    if sectionId > self.activityCls:GetCurSectionId() and not self.activityCls:CheckIsFinishAll() then
        return
    end
    self.curSec = index
    self.tabList[index].aorrawimage_bgChoose:SetActiveE(1)
    self.tabList[index].obj_eff:SetActiveE(1)
    self.tabList[index].aortext_tabName.color = _G.ColorTools.FormatColorByString("515268")
    self:ShowAbilityAndAward(index, sectionId)
    for i = 1, 3 do
        if i ~= index then
            self.tabList[i].aorrawimage_bgChoose:SetActiveE(0)
            self.tabList[i].obj_eff:SetActiveE(0)
            self.tabList[i].aortext_tabName.color = _G.ColorTools.FormatColorByString("a675af")
        end
    end
end

---@private
function DemoView:OnClickSkill(go, isOn, skillId)
    require("CommonTipManager"):GetInstance():OpenSkillTip(skillId)
end

---@private
function DemoView:OnClickSoulChain(go, isOn, index)
    local level = index * 5 - 5
    local att_or_skill = CardHunLianModel:GetInstance().SoulLink_Level_Cfg
    local sid, ActiveType
    for i = 1, #att_or_skill do
        if level == att_or_skill[i].level then
            sid = att_or_skill[i].activeDataID
            ActiveType = att_or_skill[i].ActiveType
            break
        end
    end
    require "CommonTipManager":GetInstance():OpenAttributeTip(go, sid, nil, 2)
    --require("CardHunLianManger"):GetInstance():ShowAttributeTips(
    --        go,
    --        self.cardSid,
    --        index * 5 - 5,
    --        true,
    --        0
    --)
end

---@private
function DemoView:OnClickTalent(go, isOn, id)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.CommonTipView.Name,
        _G.TipType.Talent,
        self.talentData[id]
    )
end

---@private
function DemoView:ShowAbilityAndAward(index, sectionId)
    self.go_table.obj_award:ClearChildren()
    local cfg = _G.ConfigManager.card_trial_cfg[sectionId]
    local award = cfg.reward
    for i = 1, #award do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            award[i],
            self.go_table.obj_award,
            function(tran)
                tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                if self.activityCls:CheckIsFinish(sectionId) then
                    tran:SetGou(true)
                end
            end
        )
    end
    self.go_table.aortext_content.text = _G.LangUtil.GetLangPackValue(cfg.desc[1])
    self.go_table.aortext_skillTitle.text = abilityName[index]
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_skill, index == 1)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_soulChain, index == 2)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_talent, index == 3)
end

---加载图片
function DemoView:UpdateImage(aorrawimage, param)
    if _G.string.IsNullOrEmpty(param.image) then
        return
    end
    if param.type == 2 then
        --aorrawimage.Alpha = 0
        _G.PoolsManager:GetInstance():Spawn(
            param.image,
            _G.ePoolType.Temporary,
            aorrawimage,
            function(trans)
                if self:IsNil() then
                    _G.DestroyImmediate(trans)
                    return
                end
                if param.scale then
                    trans:SetLocalScaleXYZ(param.scale)
                end
                trans:AddComponentE(_G.typeof(_G.CS.UIParticleOrderChange))
            end
        )
    else
        aorrawimage:LoadImage(
            param.image,
            function(raw)
                if self:IsNil() then
                    _G.DestroyObject(raw)
                    return
                end
                raw:SetNativeSize()
                if param.scale then
                    raw:SetLocalScaleXYZ(param.scale)
                end
            end
        )
    end
    local pos = param.pos
    aorrawimage:SetLocalPosition(pos.x, pos.y, pos.z)
end

function DemoView:UpdateBtn()
    if self.activityCls:CheckIsFinishAll() then
        local data = _G.TimeUtil.TranslateSecond(self.activityCls:GetCardTime())
        self.go_table.aortext_dragontime.text = _G.LangUtil.GetLangPackValue(90029000002, data.day)
        if self.activityCls:CheckIsGet() then
            --self.go_table.aorbtn_dragonX2:SetGray(true)
            self.go_table.aortext_dragontime.text = _G.LangUtil.GetLangPackValue(90029000001)
        end
    else
        self.go_table.aortext_dragontime.text = _G.LangUtil.GetLangPackValue(90029000001)
    end
end

---更新时间
function DemoView:UpdateTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.activityCls:CheckCanFight() then
        local _, rts = self.activity:GetActivityDeadLineByCondition(require "ActivitySynManager".State.Close)
        self.RTS = rts
    else
        self.RTS = 0
    end

    self:UpdateTime(true)

    self.timer = _G.TimerManager:GetInstance():GetTimer(60, self.UpdateTime, self, false, false, true, false)
    self.timer:Start()
end

function DemoView:UpdateTime(isShow, elapsed)
    if not isShow then
        self.RTS = self.RTS - elapsed
        if self.RTS <= 0 then
            self.RTS = 0
        end
    end
    local time = _G.TimeUtil.TranslateSecond(Mathf.RoundToInt(self.RTS))
    local str = ""
    if time.day >= 1 then
        if time.hour == 0 then
            time.hour = 1
        end
        str = _G.LangUtil.GetLangPackValue(90022100001, time.day, time.hour)
    elseif time.hour >= 1 then
        if time.min == 0 then
            time.min = 1
        end
        str = _G.LangUtil.GetLangPackValue(90022100002, time.hour, time.min)
    elseif time.min >= 1 then
        str = _G.LangUtil.GetLangPackValue(90000010394, time.min)
    else
        str = _G.LangUtil.GetLangPackValue(90000010394, 1)
    end
    self.go_table.aortext_dragonDes.text = _G.LangUtil.GetLangPackValue(90029000005, str)
    if self.RTS <= 0 then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
    end
end

function DemoView:OnClickDragonX2()
    if not self.activityCls:CheckCanFight() then
        _G.PopWindowManager:GetInstance():ShowAllTips(650104)
        return
    end
    if not self.activityCls:CheckIsFinishAll() then
        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DemoSectionView.Name, self.activity)
        self:ShowSkillAndSection(0)
    elseif not self.activityCls:CheckIsGet() then
        self.activityCls:GetCard(
            function(data)
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.DrawResultRoleView.Name,
                    data.cfg,
                    nil,
                    data.star,
                    not require "IllustrationModel":GetInstance():HunjiangJieSuo(data.sid)
                )
                self:Close()
                self.activityCls.curActivityClass:ChangeState(require "ActivitySynManager".State.Close)
                --self:UpdateBtn()
            end
        )
    else
        --_G.PopWindowManager:GetInstance():ShowAllTips(790103)
        self:ShowSkillAndSection(0)
    end
end

function DemoView:OnStartClose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---展示技能与关卡
---@param index number 页面内容，0:关卡界面，1:进入界面
function DemoView:ShowSkillAndSection(index)
    if index == 0 then
        self.anim:Play("a_DemiView")
        self.tabList[self.curSec].obj_eff:SetActiveE(0)
        _G.DelayDo(
            1,
            function()
                if not self:IsNil() then
                    self.tabList[self.curSec].obj_eff:SetActiveE(1)
                    self.go_table.obj_Enter:SetActiveE(0)
                end
            end
        )
    else
        self.go_table.obj_Enter:SetActiveE(1)
    end
    self.go_table.obj_Section:SetActiveE(1 - index)
end

---按钮点击事件在这里派发
function DemoView:OnClickBtn(go)
    if go == self.go_table.aorbtn_dragonExit then
        self:Close()
    elseif go == self.go_table.aorbtn_exit then
        self:Close()
    elseif go == self.go_table.aorbtn_dragonX then
        self:Close()
    elseif go == self.go_table.aorbtn_dragonX2 then
        self:OnClickDragonX2()
    elseif go == self.go_table.aorbtn_help then
        ---打开玩法说明页面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 98)
    elseif go == self.go_table.aorbtn_start then
        if not self.activityCls:CheckCanFight() then
            _G.PopWindowManager:GetInstance():ShowAllTips(650104)
            return
        end
        self.activityCls:OnFight(
            self.curSec,
            function()
                if self.curSec < 3 then
                    self.curSec = self.curSec + 1
                    self:UpdateSection()
                --elseif not self.activityCls:CheckIsGet() then
                --    self:ShowSkillAndSection(1)
                -- 移至settlement
                end
            end
        )
    end
end

