local base = require "BaseGameNet"

---@class DemoNet : BaseGameNet	通信协议
local DemoNet = _G.BaseClass("DemoNet", base)

---@return DemoNet DemoNet
function DemoNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求
---@param pbData table PB数据
---@param callback function 完成回调
function DemoNet:GetInfo(callback)
    local item = _G.ConfigManager.net_map.game_card_port_get_card_demo
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end
---试玩战斗
function DemoNet:ActivityFight(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_module_port_trial_fight
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
    return port
end

---领取奖励
function DemoNet:ActivityAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_module_port_trial_award
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function DemoNet:Callback(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type DemoNet
_G.DemoNet = DemoNet
return DemoNet
