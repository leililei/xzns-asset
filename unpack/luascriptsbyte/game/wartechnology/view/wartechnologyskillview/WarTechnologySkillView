local WarTechnologyModel = require("WarTechnologyModel")
---@class WarTechnologySkillView : UIBaseView    中文描述
---@field public go_table WarTechnologySkillView_GoTable GoTable
local WarTechnologySkillView = _G.BaseClass("WarTechnologySkillView", _G.Component)

---构造函数
---@protected
function WarTechnologySkillView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.toggles = {}
    self.viewList = {}
    self.redList = {}
    self:AddListener(_G.eWarTechnology.PosUpLvChange, self.RefreshDropDown)
    self:AddListener(_G.eWarTechnology.TimeAwardGet, self.OpenView)
end

---界面的入口函数
function WarTechnologySkillView:OnCreate()
    self.cfg = _G.ConfigManager.technology_layer_cfg
    self.layerNum = #self.cfg
    for i = 1, self.layerNum do
        local obj = _G.InstantiateObject(self.go_table.obj_redpoint, self.go_table.aorbtn_down)
        obj:SetActiveE(1)
        self.redList[i] = obj
        obj:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.Technologyupgrade.id, i)
    end
    local chooseIndex = 0
    for i = 1, self.layerNum do
        local v = WarTechnologyModel:GetInstance():GetLayerUpLvRed(i)
        --self.toggles[i].obj_redpoint:SetActiveE(v == true and 1 or 0)
        --if self.toggles[i].aorimage_suo then
        --    local isLock = WarTechnologyModel:GetInstance():GetIsUnlock(i)
        --    self.toggles[i].aorimage_suo:SetActiveE(isLock == false and 1 or 0)
        --end
        if chooseIndex == 0 and v == true then
            chooseIndex = i
        end
    end
    if chooseIndex == 0 then
        for i = 1, self.layerNum do
            local cur, max = WarTechnologyModel:GetInstance():GetTechnologyTotleLv(i)
            if chooseIndex == 0 and cur ~= max then
                chooseIndex = i
                break
            end
        end
        if chooseIndex == 0 then
            chooseIndex = self.layerNum
        end
    end
    self.curToggle = chooseIndex
    self:RefreshDropDown()
    self:OpenView()
    --self.toggles[chooseIndex].toggle_tag.isOn = true
    --self:OnClickOption(nil, true, chooseIndex)
    --local resources = _G.ConfigManager.ui_cfg.WarTechnologyView.resources
    --if #resources > 0 then
    --    self:AddComponent(
    --        self.go_table.obj_goldInfo,
    --        require("ResourceCompont").New(self.go_table.obj_goldInfo, resources, 2)
    --    )
    --end
end

---
---@protected
function WarTechnologySkillView:RefreshUpLvRed(index)
    local num = index == self.layerNum and 1 or 2
    for i = 1, num do
        local v = WarTechnologyModel:GetInstance():GetLayerUpLvRed(index + i - 1)
        self.toggles[index + i - 1].obj_redpoint:SetActiveE(v == true and 1 or 0)
        if self.toggles[index + i - 1].aorimage_suo then
            local isLock = WarTechnologyModel:GetInstance():GetIsUnlock(index + i - 1)
            self.toggles[index + i - 1].aorimage_suo:SetActiveE(isLock == false and 1 or 0)
        end
    end
    local cur, max = WarTechnologyModel:GetInstance():GetTechnologyTotleLv(self.curToggle)
    self.go_table.aortext_title.text = _G.GetLangPackValue(self.cfg[self.curToggle].name) .. "(" .. _G.GetLangPackValue(90033900019, cur, max) .. ")"
end

---监听Toggle点击事件
---@param key string
---@param callback function
function WarTechnologySkillView:OnClickToggle(_, isOn, key)
    if isOn then
        local isLock = WarTechnologyModel:GetInstance():GetIsUnlock(key)
        if isLock == false then
            self.toggles[self.curToggle].toggle_tag.isOn = true
            local cfg = _G.ConfigManager.technology_layer_cfg[key].unlock
            local str = _G.GetLangPackValue(_G.ConfigManager.tips_system_cfg[1080304].content, _G.GetLangPackValue(_G.ConfigManager.technology_layer_cfg[cfg[1]].name), cfg[2])
            _G.PopWindowManager:GetInstance():ShowAllTips(1080304, str)
            return
        end
    end
    local tb = self.toggles[key]
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)

    if isOn then
        if self.curToggle == key then
            return
        end
        self.curToggle = key
        self:OpenView()
        local cur, max = WarTechnologyModel:GetInstance():GetTechnologyTotleLv(key)
        self.go_table.aortext_title.text = _G.GetLangPackValue(self.cfg[key].name) .. "(" .. _G.GetLangPackValue(90033900019, cur, max) .. ")"
    end
end

---刷新下拉列表
function WarTechnologySkillView:RefreshDropDown()
    local isLock = WarTechnologyModel:GetInstance():GetIsUnlock(2)
    self.go_table.aorbtn_dropdown:SetActiveE(isLock == true and 1 or 0)
    if isLock == false then
        return
    end

    self.go_table.aorbtn_down:SetActiveE(not self.unfold and 1 or 0)
    self.go_table.aorbtn_up:SetActiveE(self.unfold and 1 or 0)
    self.go_table.obj_options:SetActiveE(self.unfold and 1 or 0)
    self.go_table.aortext_dropdown.text = _G.GetLangPackValue(self.cfg[self.curToggle].name)
    if self.unfold then
        local num = 0
        for i = 1, #self.cfg do
            local isLock = WarTechnologyModel:GetInstance():GetIsUnlock(i)
            if isLock == true then
                num = num + 1
            end
        end
        if not self.optionListView then
            self.go_table.scrollloopvectical_optation:InitItemData(
                num,
                _G.handler(self, self.RefreshOptionItem)
            )
            self.optionListView = self.go_table.scrollloopvectical_optation
        else
            self.optionListView:UpdateCount(num)
        end
    end
    for i = 1, self.layerNum do
        self.redList[i]:SetActiveE(self.curToggle == i and 0 or 1)
    end
end

function WarTechnologySkillView:RefreshOptionItem(index, obj)
    local eIndex = index + 1
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickOption, eIndex))
    tb.aortext_label.text = _G.GetLangPackValue(self.cfg[eIndex].name)
    if self.curToggle == eIndex then
        tb.aortext_label.text = "<color=#6a4d34>" .. _G.GetLangPackValue(self.cfg[eIndex].name) .. "</color>"
    else
        tb.aortext_label.text = "<color=#898993>" .. _G.GetLangPackValue(self.cfg[eIndex].name) .. "</color>"
    end
    --local isLock = WarTechnologyModel:GetInstance():GetIsUnlock(eIndex)
    if tb.obj_suo then
        tb.obj_suo:SetActiveE(0)
    end
    if tb.aorimage_select then
        tb.aorimage_select:SetActiveE(self.curToggle == eIndex and 1 or 0)
    end
    --tb.aortext_lv:SetActiveE(0)
    --if isLock == true then
    --    local num, _ = WarTechnologyModel:GetInstance():GetTechnologyTotleLv(eIndex)
    --    tb.aortext_lv.text = _G.GetLangPackValue(90020600039, num)
    --end
    tb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.Technologyupgrade.id, eIndex)
end

function WarTechnologySkillView:OnClickOption(_, _, eIndex)
    if self.curToggle ~= eIndex then
        local isLock = WarTechnologyModel:GetInstance():GetIsUnlock(eIndex)
        if isLock == false then
            local cfg = _G.ConfigManager.technology_layer_cfg[eIndex].unlock
            local str = _G.GetLangPackValue(_G.ConfigManager.tips_system_cfg[1080304].content, _G.GetLangPackValue(_G.ConfigManager.technology_layer_cfg[cfg[1]].name), cfg[2])
            _G.PopWindowManager:GetInstance():ShowAllTips(1080304, str)
            self.unfold = not self.unfold
            self:RefreshDropDown()
            return
        end
        self.curToggle = eIndex
        self.unfold = not self.unfold
        self:RefreshDropDown()
        self:OpenView()
    end
end

function WarTechnologySkillView:OpenView()
    self.layerCfg = self.cfg[self.curToggle]
    self.go_table.obj_main1:SetActiveE(self.layerCfg.linetype == 1 and 1 or 0)
    self.go_table.obj_main2:SetActiveE(self.layerCfg.linetype == 2 and 1 or 0)
    if self.viewList[self.layerCfg.linetype] == nil then
        self.viewList[self.layerCfg.linetype] = self:AddComponent(self.go_table["obj_main" .. self.layerCfg.linetype], require("WarTechnologySkillTypeView").New(self))
    end
    self.viewList[self.layerCfg.linetype]:ShowView(self.layerCfg)
    self.go_table.aorrawimage_resIcon:LoadImage(self.layerCfg.icon)
end

---
---@protected
function WarTechnologySkillView:GetItemByName(name)
    return self.go_table[name]
end

---界面的销毁函数
function WarTechnologySkillView:OnDestroy()
    self:RemoveAllListener()
end

