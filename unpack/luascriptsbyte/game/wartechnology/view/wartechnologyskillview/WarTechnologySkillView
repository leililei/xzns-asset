---按钮点击事件在这里派发
function WarTechnologySkillView:OnClickBtn(go)
    if go == self.go_table.aorbtn_info then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WarTechnologyAttTipsView.Name)
    elseif go == self.go_table.aorbtn_info2 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 184)
    elseif go == self.go_table.aorbtn_dropdown then
        ---下拉列表
        self.unfold = not self.unfold
        self:RefreshDropDown()
    elseif go == self.go_table.aorbtn_AttrDetail then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TeamHallAttrTechPanel.Name)
    end
end

return WarTechnologySkillView