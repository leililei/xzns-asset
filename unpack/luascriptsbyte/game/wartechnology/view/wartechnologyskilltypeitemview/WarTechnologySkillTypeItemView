local WarTechnologyModel = require("WarTechnologyModel")
---@class WarTechnologySkillTypeItemView : UIBaseView    中文描述
---@field public go_table WarTechnologySkillTypeItemView_GoTable GoTable
local WarTechnologySkillTypeItemView = _G.BaseClass("WarTechnologySkillTypeItemView", _G.Component)

---构造函数
---@protected
function WarTechnologySkillTypeItemView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.items = {}
end

---界面的入口函数
function WarTechnologySkillTypeItemView:OnCreate(obj)
    self.obj = obj
    self.technologyInfo = WarTechnologyModel:GetInstance():GetTechnologyInfo()
    self.cfg = _G.ConfigManager.technology_cfg
end

---
---@protected
function WarTechnologySkillTypeItemView:ShowView(datas, type)
    self.type = type
    self.datas = datas
    for k, v in ipairs(datas) do
        local data = v
        local i = data.sequence
        if self.items[i] == nil then
            self.items[i] = self:AddComponent(self.go_table["obj_itemBase" .. i], require("WarTechnologySkillTypePointView").New(self.obj))--_G.GetAutoGoTable(self.go_table["obj_itemBase" .. i])
        end
        self.items[i]:ShowView(data, type)
    end
end

---界面的销毁函数
function WarTechnologySkillTypeItemView:OnDestroy()
end

---按钮点击事件在这里派发
function WarTechnologySkillTypeItemView:OnClickBtn(go)
end

return WarTechnologySkillTypeItemView