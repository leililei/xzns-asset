local WarTechnologyModel = require("WarTechnologyModel")
---@class WarTechnologyQuestView : UIBaseView    中文描述
---@field public go_table WarTechnologyQuestView_GoTable GoTable
local WarTechnologyQuestView = _G.BaseClass("WarTechnologyQuestView", _G.UIBaseView)
local lan = {
    [1] = 90033405018,
    [2] = 90033405017,
    [3] = 90033405019
}
---构造函数
---@protected
function WarTechnologyQuestView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.CardItemLists = {}
end

---界面的入口函数
function WarTechnologyQuestView:OnCreate(id)
    self.index = id
    self.buildInfo = WarTechnologyModel:GetInstance():GetBuildInfoBySid(id)
    WarTechnologyModel:GetInstance():CheckBuildCard(id)
    self.cardCopy = _G.DeepCopy(self.buildInfo.card_list)
    self.cards = {}
    self:InitView()
end

---
---@protected
function WarTechnologyQuestView:InitView()
    self.go_table.aorrawimage_icon:LoadImage(self.buildInfo.cfg.icon)
    self.go_table.aortext_title.text = _G.GetLangPackValue(self.buildInfo.cfg.name) .. " Lv" .. self.buildInfo.build_lv
    self.itemIcon = _G.StorageManager:GetInstance():GetItemIcon(self.buildInfo.cfg.drop_item)
    self.go_table.aorrawimage_res:LoadImage(self.itemIcon)
    self.go_table.aortext_num.text = "+" .. _G.GetLangPackValue(90033405006, WarTechnologyModel:GetInstance():SetBuildingEffectNum(WarTechnologyModel:GetInstance():GetBuildAddTotleById(self.index) * 60))
    self.go_table.aortext_max.text = math.floor(self.buildInfo.lvCfg.building_time / 3600) .. _G.GetLangPackValue(90022500435)
    local cfg = WarTechnologyModel:GetInstance():SetUnLockLvByIndex(self.buildInfo.lvCfg.building_count + 1)
    if cfg ~= nil then
        local add = "+" .. cfg.building_count - self.buildInfo.lvCfg.building_count
        self.go_table.aortext_task.text = _G.GetLangPackValue(90033405005, cfg.id, _G.GetLangPackValue(90033405018) .. add)
    else
        local cfg = WarTechnologyModel:GetInstance():GetNextBuildLv(self.buildInfo.lvCfg.id)
        if cfg.id == self.buildInfo.lvCfg.id then
            self.go_table.aortext_task:SetActiveE(0)
        else
            local id
            local add
            if cfg.building_time ~= self.buildInfo.lvCfg.building_time then
                id = 2
                add = "+" .. _G.GetLangPackValue(90025500029, (cfg.building_time - self.buildInfo.lvCfg.building_time) / 3600)
            elseif cfg.building_effect ~= self.buildInfo.lvCfg.building_effect then
                id = 3
                add = "+" .. _G.GetLangPackValue(90033405006, string.format("%.1f", 60 * (cfg.building_effect - self.buildInfo.lvCfg.building_effect)))
            end
            local str = _G.GetLangPackValue(lan[id])
            self.go_table.aortext_task.text = _G.GetLangPackValue(90033405005, self.buildInfo.num .. "/" .. cfg.level, str .. add)
        end
    end
    self.go_table.aortext_task:SetActiveE(cfg ~= nil and 1 or 0)
    self:SetCardView()
end

function WarTechnologyQuestView:SetCardView()
    self.go_table.aortext_des.text = _G.GetLangPackValue(90033405011, #self.buildInfo.card_list, self.buildInfo.lvCfg.building_count)
    if #self.cards == 0 then
        for i = 1, self.buildInfo.building_count do
            local obj = _G.InstantiateObject(self.go_table.obj_ListItem, self.go_table.obj_Content)
            obj:SetActiveE(1)
            self.cards[i] = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickCardBtn, i))
        end
    end
    self:SetItemViewById()
end

function WarTechnologyQuestView:SetItemViewById()
    local data = self.buildInfo
    local building_count = data.lvCfg.building_count
    for i, v in ipairs(self.cards) do
        v.obj_have:SetActiveE(i > building_count and 0 or 1)
        v.obj_nil:SetActiveE(i <= building_count and 0 or 1)
        if i <= building_count then
            v.obj_active_effect:SetActiveE((data.oldcfg and i>data.oldcfg.building_count) and 1 or 0)
            v.aortext_num:SetActiveE(data.card_list[i] ~= nil and 1 or 0)
            v.obj_cardRoot:SetActiveE(data.card_list[i] ~= nil and 1 or 0)
            local red = WarTechnologyModel:GetInstance():CheckUpCardRed(self.index)
            v.obj_redpoint:SetActiveE((red and data.card_list[i]==nil) and 1 or 0)
            if data.card_list[i] ~= nil then
                --local iconPath = _G.StorageManager:GetInstance():GetItemIcon(self.itemIcon)
                v.aorrawimage_resIcon:LoadImage(self.itemIcon)
                local add = WarTechnologyModel:GetInstance():GetCardAdd(self.index, data.card_list[i])
                v.aortext_num.text = "+" .. _G.GetLangPackValue(90033405006, WarTechnologyModel:GetInstance():SetBuildingEffectNum(add * 60))
                local cardData = WarTechnologyModel:GetInstance():GetCardData(data.card_list[i])
                if v.cardItems == nil then
                    v.cardItems = {}
                end
                if v.cardItems[i] == nil then
                    _G.ItemCardFactory:GetInstance():GetItemCard(
                        _G.ItemCardFactory.itemCardType.CardAllItem,
                        v.obj_cardRoot,
                        function(item)
                            v.cardItems[i] = item
                            item:ShowCardData(cardData, nil, true, true)
                        end
                    )
                else
                    v.cardItems[i]:ShowCardData(cardData, nil, true, true)
                end
            end
        else
            local cfg = WarTechnologyModel:GetInstance():SetUnLockLvByIndex(i)
            v.aortext_des.text = _G.GetLangPackValue(90033405007, cfg.id)
        end
    end
    data.build_oldlv=nil
    data.oldcfg=nil
    self.go_table.aortext_num.text = "+" .. _G.GetLangPackValue(90033405006, WarTechnologyModel:GetInstance():SetBuildingEffectNum(WarTechnologyModel:GetInstance():GetBuildAddTotleById(self.index) * 60))
    self.go_table.aortext_des.text = _G.GetLangPackValue(90033405011, #self.buildInfo.card_list, self.buildInfo.lvCfg.building_count)
end

function WarTechnologyQuestView:OnClickCardBtn(go, _, posIndex)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WarTechnologyCardChooseView.Name, self.index, function()
        self:SetItemViewById()
    end)
end

---界面的销毁函数
function WarTechnologyQuestView:OnDestroy()
end

---按钮点击事件在这里派发
function WarTechnologyQuestView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_info then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WarTechnologyTaskView.Name, self.index)
    end
end

return WarTechnologyQuestView