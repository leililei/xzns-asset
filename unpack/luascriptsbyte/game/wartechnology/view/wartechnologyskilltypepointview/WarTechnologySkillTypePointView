local WarTechnologyModel = require("WarTechnologyModel")
---@class WarTechnologySkillTypePointView : UIBaseView    中文描述
---@field public go_table WarTechnologySkillTypePointView_GoTable GoTable
local WarTechnologySkillTypePointView = _G.BaseClass("WarTechnologySkillTypePointView", _G.Component)

local itemName = {
    [1] = "obj_itemSmall",
    [2] = "obj_itemMid",
    [3] = "obj_itemBig",
}

local rotation = {
    [4] = 180,
    [2] = 0,
    [3] = 90,
    [1] = -90,
}

local icon = {
    [1] = "renglei",
    [2] = "shoureng",
    [3] = "jinling",
    [4] = "wangling",
}

local effectName = {
    [1] = "blue",
    [2] = "gold",
    [3] = "green",
    [4] = "yello",
}

local pointName = {
    [1] = "SMALL",
    [2] = "MID",
    [3] = "BIG",
}

---构造函数
---@protected
function WarTechnologySkillTypePointView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eWarTechnology.PosUpLv, self.UpDataView)
    self:AddListener(_G.eWarTechnology.openIdChange, self.UpDataView)
end

---界面的入口函数
function WarTechnologySkillTypePointView:OnCreate(obj)
    self.obj = obj
    self.technologyInfo = WarTechnologyModel:GetInstance():GetTechnologyInfo()
    self.cfg = _G.ConfigManager.technology_cfg
end

---
---@protected
function WarTechnologySkillTypePointView:UpDataView(id)
    if id == self.data.id then
        self:SetItem()
    end
end

---
---@protected
function WarTechnologySkillTypePointView:ShowView(data, type)
    self.data = data
    _G.UIUtils.RemoveChildren(self.go_table.obj_item)
    local obj = _G.InstantiateObject(self.obj.go_table[itemName[data.pointtype]], self.go_table.obj_item)
    obj:SetActiveE(1)
    obj:SetLocalPosition(0, 0, 0)
    obj:SetLocalEulerAngles(0, 0, rotation[type])
    self.item = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItemBtn, data.id))
    self:SetItem()
end

function WarTechnologySkillTypePointView:OnClickItemBtn(go, _, posIndex)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WarTechnologyUpView.Name, posIndex)
end

---
---@protected
function WarTechnologySkillTypePointView:SetItem()
    local data = self.data
    if data.pre_section then
        for k2, v2 in ipairs(data.pre_section) do
            local num = self.cfg[v2[1]].sequence
            self.go_table["obj_active" .. num]:SetActiveE((self.technologyInfo[v2[1]] ~= nil and self.technologyInfo[v2[1]] >= v2[2]) and 1 or 0)
        end
    end
    local itemGoTable = self.item
    local lv = self.technologyInfo[data.id] ~= nil and self.technologyInfo[data.id] or 0
    itemGoTable.aortext_num.text = lv .. "/" .. data.level
    local isLocal = WarTechnologyModel:GetInstance():CheckTechnologyUnlock(data.id)
    itemGoTable.aorimage_mask:SetActiveE(isLocal == true and 1 or 0)
    itemGoTable.aorimage_active:SetActiveE(0)
    itemGoTable.aorimage_active.SpriteName = "ui_zzkj_kj_jihuo_" .. icon[data.elements]
    --if data.pointtype == 3 then
    itemGoTable.aorrawimage_icon:LoadImage(data.icon)

    local isUp = WarTechnologyModel:GetInstance():GetLayerPointUpLvRed(data.id)
    itemGoTable.obj_effectRoot:SetActiveE(isUp == true and 1 or 0)
    if isUp == true then
        _G.UIUtils.RemoveChildren(itemGoTable.obj_effectRoot)
        local effectName = "ef_WarTechnologyView_" .. effectName[data.elements] .. pointName[data.pointtype]
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[effectName],
            itemGoTable.obj_effectRoot,
            function(trans)
                if self.go_table == nil then
                    _G.DestroyObject(trans)
                end
            end
        )
    end
end

---界面的销毁函数
function WarTechnologySkillTypePointView:OnDestroy()
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
function WarTechnologySkillTypePointView:OnClickBtn(go)
end

return WarTechnologySkillTypePointView