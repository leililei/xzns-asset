---构造函数
---@protected
function WarTechnologyTaskView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.ItemView = {}
    self.toggles = {}
end

---界面的入口函数
function WarTechnologyTaskView:OnCreate(index)
    if index == nil then
        index = 0
        for i = 1, 4 do
            if WarTechnologyModel:GetInstance():CheckTaskRed(i) == true then
                index = i
                break
            end
        end
        if index == 0 then
            index = 1
        end
    end
    self.index = 0
    for i = 1, 4 do
        self.toggles[i] = _G.GetAutoGoTable(self.go_table["toggle_tag" .. i], _G.handlerbind(self, self.OnClickToggle, i))
        local cfg = _G.ConfigManager.technology_building_cfg[i]
        self.toggles[i].aortext_label1.text = _G.GetLangPackValue(cfg.name)
        self.toggles[i].aortext_label.text = _G.GetLangPackValue(cfg.name)
        self.toggles[i].obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.Technologytasks.id, i)
    end
    self.go_table["toggle_tag" .. index].isOn = true
    self:OnClickToggle(nil, true, index)
end

---监听Toggle点击事件
---@param key string
---@param callback function
function WarTechnologyTaskView:OnClickToggle(_, isOn, key)
    local tb = self.toggles[key]
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)

    if isOn and self.index ~= key then
        self.index = key
        self:UpdateView()
    end
end

---更新界面
function WarTechnologyTaskView:UpdateView()
    self.cfg = _G.ConfigManager.technology_building_cfg[self.index]
    self.go_table.aorrawimage_icon:LoadImage(self.cfg.icon)
    self.go_table.aortext_name.text = _G.GetLangPackValue(self.cfg.name)
    self.buildInfo = WarTechnologyModel:GetInstance():GetBuildInfo()
    self:RefreshTask()
end

---任务刷新
