---@protected
function WarTechnologyTaskView:SetBuildUpInfo()
    local cfg = _G.ConfigManager.technology_building_level_cfg
    local lv = self.buildInfo.build_lv
    self.go_table.aortext_curLv.text = _G.GetLangPackValue(90000011081, lv)
    local curCfg = cfg[lv]
    for i = 1, 3 do
        self.go_table["aortext_des" .. i].text = _G.GetLangPackValue(lan[i]) .. ":"
        if i == 1 then
            self.go_table["aortext_value" .. i].text = _G.GetLangPackValue(90022500402, math.floor((curCfg.building_effect * 60) / 10000))
        elseif i == 2 then
            self.go_table["aortext_value" .. i].text = curCfg.building_count
        elseif i == 3 then
            self.go_table["aortext_value" .. i].text = self:SetTime(curCfg.building_time)
        end
    end
    self.go_table.aortext_nextLv:SetActiveE(lv < #cfg and 1 or 0)
    self.go_table.obj_jddi:SetActiveE(lv < #cfg and 1 or 0)
    if lv < #cfg then
        local nextCfg = cfg[lv + 1]
        self.go_table.aortext_nextLv.text = _G.GetLangPackValue(90000011081, lv + 1)
        for i = 1, 3 do
            if i == 1 and curCfg.building_effect ~= nextCfg.building_effect then
                self.go_table["aortext_add" .. i].text = "(+" .. _G.GetLangPackValue(90022500402, math.floor(((nextCfg.building_effect - curCfg.building_effect) * 60) / 10000)) .. ")"
            elseif i == 2 and curCfg.building_count ~= nextCfg.building_count then
                self.go_table["aortext_add" .. i].text = "(+" .. nextCfg.building_count - curCfg.building_count .. ")"
            elseif i == 3 and curCfg.building_time ~= nextCfg.building_time then
                self.go_table["aortext_add" .. i].text = "(+" .. self:SetTime(nextCfg.building_time - curCfg.building_time) .. ")"
            else
                self.go_table["aortext_add" .. i].text = " "
            end
        end
        local num = self.buildInfo.build_task_num or 0
        self:SetTaskItemjd(self.go_table.aorimage_jd, num, nextCfg.level)
    end
end

function WarTechnologyTaskView:SetTaskItemjd(aorimage, value, loopValue_Max)
    local w = value / loopValue_Max
    if w > 1 then
        w = 1
    end
    aorimage:SetRectTransformSize(value > 0 and w * 198 or 0, 10)
    self.go_table.aortext_jd.text = value .. "/" .. loopValue_Max
end

function WarTechnologyTaskView:RefreshMaterialList(index, obj)
    local tb = _G.GetAutoGoTable(obj)
    local baseCfg = self.levelCfg[index]
    if (index + 1) ~= #self.levelCfg then
        local cfg = self.levelCfg[index + 2]
        local value = self.buildInfo.num >= cfg.level and 1 or 0
        tb.aorimage_activeSchedule:SetLocalScale(value, 1, 1)
    end

    tb.aorimage_box:SetActiveE(index == 0 and 0 or 1)
    tb.aorimage_mzhytdi:SetActiveE((index + 1) == #self.levelCfg and 0 or 1)

    if index > 0 then
        local cfg = self.levelCfg[index + 1]
        local id
        local add
        if cfg.building_count ~= baseCfg.building_count then
            id = 1
            add = cfg.building_count - baseCfg.building_count
        elseif cfg.building_time ~= baseCfg.building_time then
            id = 2
            local date = _G.TimeUtil.TranslateSecond(cfg.building_time - baseCfg.building_time)
            if date.day == 0 then
                if date.hour == 0 then
                    add = date.min .. _G.GetLangPackValue(90022500434)
                    if date.min == 0 then
                        add = "1" .. _G.GetLangPackValue(90022500434)
                    end
                else
                    add = date.hour .. _G.GetLangPackValue(90022500435)
                end
            else
                add = _G.GetLangPackValue(90022010703, date.day)
            end
        elseif cfg.building_effect ~= baseCfg.building_effect then
            id = 3
            add = math.floor((cfg.building_effect - baseCfg.building_effect) * 60 / 10000)
        end
        tb.aorimage_box.SpriteName = img[id]
        tb.aortext_name.text = _G.GetLangPackValue(lan[id])
        tb.aortext_add.text = "+" .. add
        tb.aortext_active.text = cfg.level
    end
end

function WarTechnologyTaskView:RefreshTaskItem(index, obj)
    ---@type ActiveTaskPanel._obj_item_GoTable
    local go_table = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickTask, index + 1))
    --go_table.obj_items:ClearChildren()
    local data = self.taskDatas[index + 1]
    --go_table.aortext_hzExp.text = data.Cfg.other_award[1].num
    --go_table.aortext_info.text =
    if data.i_task.state == _G.TaskEnum.ETaskState.Submited or data.i_task.state == _G.TaskEnum.ETaskState.Completed then
        --self:SetTaskItemjd(go_table.aorimage_jd, data.Cfg.count, data.Cfg.count)
        go_table.aortext_info.text = _G.GetLangPackValue(data.Cfg.desc) .. _G.string.format("(%s/%s)", data.Cfg.count, data.Cfg.count)
        local isGet = WarTechnologyModel:GetInstance():CheckIsGet(data.Cfg.id)
        go_table.aorbtn_get:SetActiveE(isGet and 0 or 1)
        go_table.aorbtn_way:SetActiveE(0)
        go_table.aorimage_get:SetActiveE(0)
        go_table.aorimage_over:SetActiveE(isGet and 1 or 0)
    else
        --self:SetTaskItemjd(go_table.aorimage_jd, data.i_task.target[1], data.Cfg.count)
        go_table.aortext_info.text = _G.GetLangPackValue(data.Cfg.desc) .. _G.string.format("(%s/%s)", data.i_task.target[1], data.Cfg.count)
        go_table.aorbtn_get:SetActiveE(0)
        go_table.aorimage_get:SetActiveE(0)
        go_table.aorbtn_way:SetActiveE(1)
        --if data.Cfg.link and data.Cfg.link ~= 0 then
        if data.Cfg.link and data.Cfg.link ~= 0 then
            go_table.aorbtn_way:SetGray(false)
            --go_table.aortext_label.text = _G.LangUtil.GetLangPackValue(90022200010)
            go_table.aorbtn_way.interactable = true
        else
            go_table.aorbtn_way:SetGray(true)
            --go_table.aortext_label.text = _G.LangUtil.GetLangPackValue(90020400086)
            go_table.aorbtn_way.interactable = false
        end
        go_table.aorimage_over:SetActiveE(0)
    end
    _G.UIUtils.RemoveChildren(go_table.obj_items)
    for i = 1, #data.Cfg.reward do
        if data.Cfg.reward[i][2] > 0 then
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                data.Cfg.reward[i],
                go_table.obj_items,
                function(tran)
                    tran.gameObject:SetLocalScaleXYZ(0.8)
                    if data.Cfg.reward[i][2] > 1 then
                        tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                    else
                        tran:ShowNumText(false)
                    end
                    --tran:SetGou(self.activityCls:CheckIsGet(data.Cfg.id))
                    if tran.ShowEffectOrder and tran.cfg then
                        tran:ShowEffectOrder(tran.cfg.ef_item == 1 and true or false)
                    end
                end
            )
        end
    end
end

---点击任务
function WarTechnologyTaskView:OnClickTask(go, isOn, index)
    local name = go:GetName()
    local data = self.taskDatas[index]
    if name == "@_aorbtn_get" then
        local ids = {}
        for key, data in ipairs(self.taskDatas) do
            local isGet = WarTechnologyModel:GetInstance():CheckIsGet(data.Cfg.id)
            if data.i_task.state == _G.TaskEnum.ETaskState.Submited and not isGet then
                ids[key] = data
            end
        end
        WarTechnologyModel:GetInstance():PanDuanZhi(self.index, ids, function(list)
            self:UpdateView()
        end)
    elseif name == "@_aorbtn_way" then
        _G.JumpManager:GetInstance():Jump(data.Cfg.link, nil)
    end
end

