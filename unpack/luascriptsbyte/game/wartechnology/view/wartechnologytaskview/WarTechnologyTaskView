    --    self.isFirst = true
    --else
    --    self.go_table.scrollloophorizontal_item:UpdateCount(#self.levelCfg)
    --end
    --
    --self.go_table.aortext_nowActive.text = self.buildInfo.num
    self:SetBuildUpInfo()
end

function WarTechnologyTaskView:SortMyTask()
    --- 按任务已完成奖励可领取>任务未完成>任务奖励已领取>配置表id（从小到大）的顺序进行排列
    table.sort(
        self.taskDatas,
        function(a, b)
            --- 不同任务状态优先级
            local function sortState(data)
                local state = data.i_task.state
                if state == _G.TaskEnum.ETaskState.Submited then
                    local isGet = WarTechnologyModel:GetInstance():CheckIsGet(data.Cfg.id)
                    if isGet == true then
                        return 8
                    else
                        return 10
                    end
                elseif state == _G.TaskEnum.ETaskState.Claimed then
                    return 9
                elseif state == _G.TaskEnum.ETaskState.Completed then
                    return 8
                end
                return 0
            end

            local aState = sortState(a)
            local bState = sortState(b)
            if aState ~= bState then
                return aState > bState
            end
            return a.i_task.sid < b.i_task.sid
        end
    )
end

function WarTechnologyTaskView:SetTime(time)
    local str = math.floor(time / 3600) .. _G.GetLangPackValue(90022500435)
    return str
end

