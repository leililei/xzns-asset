---@protected
function WarTechnologyUpView:SetAutoCard()
    local lv = self.data ~= nil and self.data or 0
    local data2 = self.cfg.materials_elements[lv + 1]

    local selectCards = {}

    if #self.selectCardsList >= data2[2] then
        return
    end

    local totalNum = data2[2] - #self.selectCardsList

    local propCards = {}
    local element = self.cfg.elements
    local sid, count, data
    for _, v in pairs(_G.ConfigManager.item_card_cfg) do
        sid = v.id
        if v.Elements == _G.CardElementType.Common or v.Elements == element then
            count = _G.StorageManager:GetInstance():GetItemCountBySid(sid)
            if count > 0 then
                data = PropCardData.New()
                data:Parse({ sid = sid, uid = sid, num = count })
                _G.table.insert(propCards, data)
            end
        end
    end
    local curSelectUid = {}
    for i, v in ipairs(self.selectCardsList) do
        if curSelectUid[v.uid] == nil then
            curSelectUid[v.uid] = 1
        else
            curSelectUid[v.uid] = curSelectUid[v.uid] + 1
        end
    end
    if _G.table.count(propCards) > 0 then
        _G.SortList(
            propCards,
            function(CardData)
                return -(CardData:GetElement() % 7)
            end
        )
        for k, v in ipairs(propCards) do
            for i = 1, v.count do
                local uid = -(v.sid * 100 + i)
                if #selectCards < totalNum and curSelectUid[uid] == nil then
                    local dataItem = PropCardData.New()
                    dataItem:Parse({ sid = v.sid, uid = uid, num = 1 })
                    _G.table.insert(selectCards, dataItem)
                else
                    break
                end
            end
        end
    end
    if #selectCards < totalNum then
        local cardList = CardInfoManager.GetDogFoodCards(self.cfg.elements, data2[1])
        _G.SortList(
            cardList,
            function(v)
                return -v.Grade, -v.type, -v:GetElement(), -v:GetRealLevel(), v.uid
            end
        )
        for k, v in ipairs(cardList) do
            if #selectCards < totalNum and curSelectUid[v.uid] == nil then
                _G.table.insert(selectCards, v)
            else
                break
            end
        end
    end
    self:UpdateAllConsume(selectCards)
end

function WarTechnologyUpView:UpdateAllConsume(selectCards, embattleUids)
    self.selectCards = {}
    self.selectCardsList = selectCards
    self.selectCardDatas = {}
    self.selectItemCards = {}
    for i = 1, #self.consumeCard do
        _G.UIUtils.RemoveChildren(self.consumeCard[i].obj_itemRoot)
        if selectCards[i] ~= nil then
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.ItemCardStorageView,
                self.consumeCard[i].obj_itemRoot,
                function(item)
                    local card = selectCards[i]
                    if require "CardInfoManager":GetInstance():CheckMultiMatchCOP(card.cfg.Elements_new, 7) or _G.ConfigManager.item_cfg[card.sid] ~= nil then
                        table.insert(self.selectItemCards, { key = card.sid, value = 1 })
                    else
                        table.insert(self.selectCards, card.uid)
                        table.insert(self.selectCardDatas, card)
                    end
                    item:Show(card.sid, nil, card.star, card.soulLink_lv, card.lv, card.uid, true, card.open_inborn)
                    item.gameObject:SetLocalScaleXYZ(0.846)
                end
            )
        end
    end
end

