function WarTechnologyUpView:IsClose()
    self.data = WarTechnologyModel:GetInstance():GetTechnologyInfoBySid(self.cfg.id)
    local lv = self.data ~= nil and self.data or 0
    if lv >= self.cfg.level then
        return true
    else
        local data = self.cfg.material[lv + 1]
        if data then
            for i = 1, (#data) / 2 do
                local itemSid = data[2 * (i - 1) + 1]
                local num = data[2 * (i - 1) + 2]
                local storage = _G.StorageManager:GetInstance()
                local _, ID = storage:CheckSidType(itemSid)
                if storage:GetItemCountByID(ID, itemSid) < num then
                    return true
                end
            end
        end
        --if (#self.selectCardDatas + #self.selectItemCards) < self.cfg.materials_elements[lv + 1][2] then
        --    return true
        --end
    end
    return false
end

