---@protected
function WarTechnologyUpView:SetAttr(gotable, lv, i, att)
    local goTable = gotable
    local data = att[1]

    local arrCur = { data[3 * (i - 1) + 1], data[3 * (i - 1) + 2], data[3 * (i - 1) + 3] }
    local arrNext = { data[3 * (i - 1) + 1], data[3 * (i - 1) + 2], data[3 * (i - 1) + 3] }
    if lv == 0 then
        arrCur[3] = 0
        arrNext[3] = att[lv + 1][3 * (i - 1) + 3]
    elseif lv == self.cfg.level then
        arrCur[3] = att[lv][3 * (i - 1) + 3]
    else
        arrCur[3] = att[lv][3 * (i - 1) + 3]
        arrNext[3] = att[lv + 1][3 * (i - 1) + 3]
    end
    goTable.aortext_des.text = _G.AttrType[arrNext[1]].des
    if lv == self.cfg.level then
        goTable.aortext_num.text = self:ToPropNum(arrCur[1], arrCur[3], arrCur[2])
    else
        local cur = self:ToPropNum(arrCur[1], arrCur[3], arrCur[2])
        local next = self:ToPropNum(arrCur[1], arrNext[3] - arrCur[3], arrCur[2])
        local str = cur .. "+" .. string.format("<color=#0b6901>%s</color>", next)
        goTable.aortext_num.text = str

        _G.table.insert(self.curAttrShow, _G.AttrType[arrNext[1]].des .. "+" .. string.format("<color=#61FF50>%s</color>", next))
    end
    if self.upEffect ~= nil then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_WarTechnologyUpView_once,
            goTable.obj_effectRoot,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                end
            end
        )
    end
end

---属性数字转换
---@param key string 属性key
---@param num number 属性值
---@return string 属性值文本
function WarTechnologyUpView:ToPropNum(key, num, str)
    local isPer = str == "2" and true or false
    local numStr
    if _G.AttrType[key].percentage == 1 or isPer then
        num = num / 100
        num = _G.GameUtil.FormatNum(num)
        numStr = _G.tostring(num) .. "%"
    else
        num = _G.math.floor(num)
        num = _G.GameUtil.NumberWY(num)
        numStr = _G.tostring(num)
    end
    return numStr
end

