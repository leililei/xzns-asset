---构造函数
---@protected
function WarTechnologyUpView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function WarTechnologyUpView:OnCreate(sid)
    self.cfg = _G.ConfigManager.technology_cfg[sid]
    self.power = _G.StorageManager:GetInstance():GetPlayerPower()
    self:InitView()
    WarTechnologyModel:GetInstance():OpenTechnologyId(sid)
end

function WarTechnologyUpView:InitView()
    local goTable = _G.GetAutoGoTable(self.go_table.obj_skillbg)
    goTable.aorrawimage_icon:LoadImage(self.cfg.icon)
    self.consumeCard = {}
    self.selectCards = {}
    self.selectCardDatas = {}
    self.selectItemCards = {}
    self.selectCardsList = {}

    self.go_table.aortext_name.text = _G.GetLangPackValue(self.cfg.name)
    self.go_table.aortext_des.text = _G.GetLangPackValue(self.cfg.description)
    --跳过
    self.Toggle = self.go_table.toggle_autoChoose:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle))
    self.isOn = WarTechnologyModel:GetInstance():GetAutoChoose()
    self.Toggle.isOn = self.isOn == 1 and true or false
    self.Toggle.onValueChanged:AddListener(_G.handler(self, self.OnToggleChanged))
    self:UpDataView()
end

--toggle监听
function WarTechnologyUpView:OnToggleChanged(isOn)
    if self.Toggle.isOn then
        WarTechnologyModel:GetInstance():SetAutoChoose(true)
        self:SetAutoCard()
    else
        WarTechnologyModel:GetInstance():SetAutoChoose(false)
    end
end

function WarTechnologyUpView:UpDataView()
    self.data = WarTechnologyModel:GetInstance():GetTechnologyInfoBySid(self.cfg.id)
    self.technologyInfo = WarTechnologyModel:GetInstance():GetTechnologyInfo()
    local lv = self.data ~= nil and self.data or 0
    self.go_table.aortext_lv.text = lv
    self.go_table.aorimage_lvUp:SetActiveE(lv ~= self.cfg.level and 1 or 0)
    if lv ~= self.cfg.level then
        self.go_table.aortext_lvUp.text = lv + 1
    end
    --升级状态
    local isLock = WarTechnologyModel:GetInstance():CheckTechnologyUnlock(self.cfg.id)
    self.go_table.aorbtn_up:SetActiveE((isLock == false and lv ~= self.cfg.level) and 1 or 0)
    self.go_table.obj_lock:SetActiveE((isLock == true) and 1 or 0)
    self.go_table.obj_over:SetActiveE((isLock == false and lv == self.cfg.level) and 1 or 0)
    self.go_table.obj_buttom:SetActiveE((isLock == false and lv == self.cfg.level) and 0 or 1)
    self.go_table.toggle_autoChoose:SetActiveE((isLock == false and lv == self.cfg.level) and 0 or 1)
    --if isLock == true then
    --    local pre_section = self.cfg.pre_section
    --    for i, v in ipairs(pre_section) do
    --        if self.technologyInfo[v[1]] == nil or self.technologyInfo[v[1]] < v[2] then
    --            local obj = _G.InstantiateObject(self.go_table.obj_skillbg, self.go_table.obj_lockRoot)
    --            local goTable = _G.GetAutoGoTable(obj)
    --            goTable.aorrawimage_icon:LoadImage(_G.ConfigManager.technology_cfg[v[1]].icon)
    --        end
    --    end
    --end
    if lv ~= self.cfg.level then
        _G.UIUtils.RemoveChildren(self.go_table.obj_upRoot)
        self.consumeCard = {}
        local data = self.cfg.material[lv + 1]
        if data then
            for i = 1, (#data) / 2 do
                local obj = _G.InstantiateObject(self.go_table.obj_Card, self.go_table.obj_upRoot)
                obj:SetActiveE(1)
                local goTable = _G.GetAutoGoTable(obj)
                local itemSid = data[2 * (i - 1) + 1]
                local num = data[2 * (i - 1) + 2]
                _G.StorageManager:GetInstance():GetItemBaseViewNew(
                    { itemSid, num },
                    goTable.obj_Root,
                    function(tran)
                        tran:ShowNumText(false)
                    end
                )
                local curNum = _G.StorageManager:GetInstance():GetItemCountBySid(itemSid)
                local str = curNum >= num and "<color=#0b6901>%s</color>" or "<color=#c02214>%s</color>"
                goTable.aortext_num.text = _G.GetLangPackValue(90033900019, string.format(str, _G.GameUtil.NumberToUnitStrFight(curNum)), _G.GameUtil.NumberToUnitStrFight(num))
            end
        end

        local data2 = self.cfg.materials_elements[lv + 1]

        if data2[2] ~= 0 then
            for i = 1, data2[2] do
                local obj = _G.InstantiateObject(self.go_table.obj_consume1, self.go_table.obj_upRoot)
                obj:SetActiveE(1)
                local goTable = _G.GetAutoGoTable(obj,
                    _G.handlerbind(self, self.OnClickItem, { self.cfg.elements, data2[1], i, data2[2] }))
                table.insert(self.consumeCard, goTable)
            end
        end
    end
    --属性
    self.arr1 = {}
    self.curAttrShow = {}
    if #self.cfg.base_att > 0 then
        _G.UIUtils.RemoveChildren(self.go_table.obj_root1)
        local num = (#self.cfg.base_att[1]) / 3
        for i = 1, num do
            if self.arr1[i] == nil then
                local obj = _G.InstantiateObject(self.go_table.obj_item, self.go_table.obj_root1)
                obj:SetActiveE(1)
                self.arr1[i] = _G.GetAutoGoTable(obj)
            end
            self:SetAttr(self.arr1[i], lv, i, self.cfg.base_att)
        end
    end
    if #self.cfg.base_att2 > 0 then
        self.arr2 = {}
        _G.UIUtils.RemoveChildren(self.go_table.obj_root2)
        local num = (#self.cfg.base_att2[1]) / 3
        for i = 1, num do
            if self.arr2[i] == nil then
                local obj = _G.InstantiateObject(self.go_table.obj_item, self.go_table.obj_root2)
                obj:SetActiveE(1)
                self.arr2[i] = _G.GetAutoGoTable(obj)
            end
            self:SetAttr(self.arr2[i], lv, i, self.cfg.base_att2)
        end
        self.go_table.aortext_Title2.text = _G.GetLangPackValue(lan[self.cfg.elements])
    end
    self.go_table.aortext_Title2:SetActiveE(#self.cfg.base_att2 > 0 and 1 or 0)
    self.go_table.obj_att:SetActiveE((#self.cfg.base_att == 0 and #self.cfg.base_att2 == 0) and 0 or 1)
    --_G.GameUtil.ReBuildRTF(self.go_table.obj_att)
    if (isLock == false and lv == self.cfg.level) then
    else
        local isOn = WarTechnologyModel:GetInstance():GetAutoChoose() == 1
        if isOn == true then
            self:SetAutoCard()
        end
    end
end

---战力变化提示
function WarTechnologyUpView:UpdatePower()
    ---属性变化提示
    for i = 1, #self.curAttrShow do
        require "SociatyMobaTipsModel":GetInstance():Show({ self.curAttrShow[i], 1 }, { 0, 250, 0 })
    end
    ---战力变化提示
    _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.WarTechnology)
    local newPower = _G.StorageManager:GetInstance():GetPlayerPower()
    local offset = newPower - self.power
    if offset > 0 then
        require "CommonTipManager".OpenPowerUpView(self.power, offset)
        self.power = newPower
    end
end

