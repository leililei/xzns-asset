end

---监听界面打开
---@param name string 界面名称
function WarTechnologyUpView:OnOpened(name)
    if name == _G.ConfigManager.ui_cfg.CardChooseView.Name then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.CardChooseView.Name)
        view.go_table.obj_typeList:SetActiveE(0)
        local lv = self.data ~= nil and self.data or 0
        local data2 = self.cfg.materials_elements[lv + 1]
        view.go_table.aortext_des.text = _G.GetLangPackValue(90033405052, #self.selectCardsList, data2[2])
        view:OnSelectCardCall(
            function(data)
                view.go_table.aortext_des.text = _G.GetLangPackValue(90033405052, #data, data2[2])
            end
        )
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnOpened, self)
    end
end

---按钮点击事件在这里派发
function WarTechnologyUpView:OnClickBtn(go)
    if go == self.go_table.aorbtn_up then
        local lv = self.data ~= nil and self.data or 0
        local data2 = self.cfg.materials_elements[lv + 1]
        if data2[2] ~= 0 and (#self.selectCards + #self.selectItemCards) < data2[2] then
            self:OnClickItem(nil, nil, { self.cfg.elements, data2[1], 1, data2[2] })
            return
        end
        if #self.selectCards > 0 then
            require("CardInfoManager"):GetInstance():CardNewReadyDestroy(
                self.selectCards,
                function(Refun)
                    WarTechnologyModel:GetInstance():SetPosUpLv(self.cfg.id, function()
                        for index, carduid in ipairs(self.selectCards) do
                            _G.StorageManager:GetInstance():DelCard(carduid)
                        end
                        self.selectCards = {}
                        self.selectCardDatas = {}
                        self.selectItemCards = {}
                        self.selectCardsList = {}
                        self:UpdatePower()
                        if self:IsClose() == true then
                            self:Close()
                        else
                            self.upEffect = true
                            self:UpDataView()
                        end
                    end, self.selectCards, self.selectItemCards)
                end,
                function(data)
                end
            )
        elseif #self.selectItemCards > 0 then
            WarTechnologyModel:GetInstance():SetPosUpLv(self.cfg.id, function()
                for index, carduid in ipairs(self.selectCards) do
                    _G.StorageManager:GetInstance():DelCard(carduid)
                end
                for index, carduid in ipairs(self.selectItemCards) do
                    _G.StorageManager:GetInstance():ConsumeItem(carduid.key, 0, carduid.value)
                end
                self.selectCards = {}
                self.selectCardDatas = {}
                self.selectItemCards = {}
                self.selectCardsList = {}
                self:UpdatePower()
                if self:IsClose() == true then
                    self:Close()
                else
                    self.upEffect = true
                    self:UpDataView()
                end
            end, self.selectCards, self.selectItemCards)
        else
            WarTechnologyModel:GetInstance():SetPosUpLv(self.cfg.id, function()
                self:UpdatePower()
                if self:IsClose() == true then
                    self:Close()
                else
                    self.upEffect = true
                    self:UpDataView()
                end
            end, self.selectCards, self.selectItemCards)
        end
    elseif go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_anyClose then
        self:Close()
        WarTechnologyModel:GetInstance():CloseTechnologyId(self.cfg.id)
    end
end

return WarTechnologyUpView
