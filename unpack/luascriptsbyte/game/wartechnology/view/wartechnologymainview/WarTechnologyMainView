local WarTechnologyModel = require("WarTechnologyModel")
---@class WarTechnologyMainView : UIBaseView    中文描述
---@field public go_table WarTechnologyMainView_GoTable GoTable
local WarTechnologyMainView = _G.BaseClass("WarTechnologyMainView", _G.Component)

local lan = {
    [1] = 90033405018,
    [2] = 90033405017,
    [3] = 90033405019
}

local Des = {
    MaxAfkTime = 90022010602,
    UpResPropMin = 90021800504,
    day = 90022010703
}

local showTime = 300

function WarTechnologyMainView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self.itemList = {}
    self.cfgLv = _G.ConfigManager.technology_building_level_cfg
    self:AddListener(_G.eWarTechnology.BuildUpCard, self.UpDataItemView)
    self:AddListener(_G.eWarTechnology.TimeAwardGet, self.SetTimeView)
    self:AddListener(_G.eWarTechnology.PosUpLvChange, self.RefreshTechnologyLv)
    self:AddListener(_G.eWarTechnology.openIdChange, self.RefreshTechnologyLv)
end

---创建对象时,入口构造函数
function WarTechnologyMainView:OnCreate(parent)
    self.Parent = parent
    self.buildInfo = WarTechnologyModel:GetInstance():GetBuildInfo()
    self.cfg = _G.ConfigManager.technology_building_cfg
    for i = 1, 5 do
        local cfg = self.cfg[i]
        local goTable = _G.GetAutoGoTable(self.go_table["obj_item" .. i], _G.handlerbind(self, self.OnClickItemBtn, i))
        self.itemList[i] = goTable
        if i == 5 then
            goTable.aorrawimage_icon:LoadImage("ImagesH5/hChallenge/kj_kejigongfang")
            goTable.aortext_name.text = _G.GetLangPackValue(90033405003)
        else
            goTable.aorrawimage_icon:LoadImage(cfg.icon)
            goTable.aortext_name.text = _G.GetLangPackValue(cfg.name)
            local iconPath = _G.StorageManager:GetInstance():GetItemIcon(cfg.drop_item)
            goTable.aorrawimage_resIcon:LoadImage(iconPath)
            goTable.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.Technologyvacancy.id, i)
        end
    end
    self:SetItemView()
    self:RefreshTechnologyLv()
    self:SetAllDispatchShow()
    --self:InitNpc()
end

---
---@protected
function WarTechnologyMainView:RefreshTechnologyLv()
    self.itemList[5].aortext_lv.text = "Lv" .. WarTechnologyModel:GetInstance():GetTechnologyAllLv()
    self.itemList[5].obj_UpLv:SetActiveE(WarTechnologyModel:GetInstance():CheckUpLvRed() == true and 1 or 0)
end

function WarTechnologyMainView:SetTimeView()
    self.awardTime = WarTechnologyModel:GetInstance():GetAwardTime()
    self.go_table.aorbtn_boxAward:SetActiveE(0)
    if self.awardTime > 0 then
        self.totleTime = WarTechnologyModel:GetInstance():GetFastTime()
        self.AfkTime = _G.TimeUtil.GetServerUnixTime() - self.awardTime
        if self.AfkTime >= self.totleTime then
            if self.Timer ~= nil then
                self.Timer:Stop()
                self.Timer = nil
            end
            self:ShowAfkTime()
        else
            if self.Timer == nil then
                self.Timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdataShowTime, self, false, false, true)
                self.Timer:Start()
                self:ShowAfkTime()
            end
        end
    end
    self:RefreshTechnologyLv()
end

function WarTechnologyMainView:UpdataShowTime(elapsed)
    self.AfkTime = _G.TimeUtil.GetServerUnixTime() - self.awardTime
    self:ShowAfkTime()
end

function WarTechnologyMainView:ShowAfkTime()
    if _G.IsNil(self.go_table) then
        return
    end
    local isMax = false
    if self.AfkTime > self.totleTime then
        self.AfkTime = self.totleTime
        isMax = true
    end

    for i = 1, 4 do
        if self.AfkTime <= showTime then
            self.itemList[i].obj_res:SetActiveE(0)
        else
            local data = self.buildInfo[i]
            self.itemList[i].obj_res:SetActiveE((self.awardTime > 0 or data.lvCfg.building_effect > 0 or (#self.buildInfo[i].card_list > 1)) and 1 or 0)
            if self.awardTime > 0 then
                local maxTime = data.lvCfg.building_time
                self.itemList[i].obj_bar:SetActiveE(self.AfkTime >= maxTime and 0 or 1)
                self.itemList[i].aorimage_resBar:SetActiveE(self.AfkTime >= maxTime and 0 or 1)
                if self.AfkTime < maxTime then
                    self.itemList[i].aorimage_resBar.fillAmount = self.AfkTime / maxTime
                end
            end
        end
    end
    if isMax == true then
        if self.Timer ~= nil then
            self.Timer:Stop()
            self.Timer = nil
        end
    end
end
---
---@protected
function WarTechnologyMainView:SetItemView()
    for i = 1, 4 do
        self:SetItemViewById(i)
    end
    self:SetTimeView()
end

---
---@protected
function WarTechnologyMainView:SetAllDispatchShow()
    local isShow = WarTechnologyModel:GetInstance():CheckDispathAllRefresh()
    self.go_table.aorbtn_dispatch:SetActiveE(isShow == true and 1 or 0)
end

