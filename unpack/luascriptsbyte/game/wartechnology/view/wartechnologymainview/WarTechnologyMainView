---@protected
function WarTechnologyMainView:UpDataItemView(list)
    self:SetAllDispatchShow()
    if list == nil then
        self:SetItemView()
        return
    end
    --for i, v in ipairs(list) do
    --    self:SetItemViewById(v)
    --end
    self:SetTimeView()
end

function WarTechnologyMainView:SetItemViewById(index)
    local goTable = self.itemList[index]
    --local data = self.buildInfo[index]

    local isUp = WarTechnologyModel:GetInstance():CheckIsBuildUp(index)
    goTable.obj_up:SetActiveE(isUp == true and 1 or 0)
    goTable.aorimage_up:SetActiveE(isUp == true and 1 or 0)

    local lv
    if index == 5 then
        lv = "Lv" .. 1
    else
        lv = "Lv" .. self.buildInfo[index].build_lv
    end
    goTable.aortext_lv.text = lv
end

function WarTechnologyMainView:OnClickItemBtn(go, _, posIndex)
    if posIndex == 5 then
        self.Parent:SetPage(2)
        return
    end
    local name = go:GetName()
    if name == "@_aorbtn_info2" then
        local isUp = self.itemList[posIndex].obj_up:GetctiveInHierarchy() == 1--WarTechnologyModel:GetInstance():CheckIsBuildUp()
        if isUp == true then
            local curLv = self.buildInfo[posIndex].build_lv
            WarTechnologyModel:GetInstance():SetBuildUpLv(posIndex, function()
                self:SetItemView()
                self:SetAllDispatchShow()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WarTechnologyUpBuildView.Name, posIndex, curLv, self.buildInfo[posIndex].build_lv)
            end)
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WarTechnologyQuestView.Name, posIndex)
        end
    elseif name == "@_aorbtn_info" then
        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WarTechnologyTaskView.Name, posIndex)
        WarTechnologyModel:GetInstance():GetBuildAward(function()
            self:SetTimeView()
        end)
    end
end

function WarTechnologyMainView:OnClickCardBtn(go, _, posIndex)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WarTechnologyQuestView.Name, posIndex)
end

function WarTechnologyMainView:InitNpc()
    self.npc = {
        self.go_table.obj_npc1,
        self.go_table.obj_npc2,
        self.go_table.obj_npc3
    }
    self.npcCfg = {}
    for i = 1, 3 do
        self.npcCfg[i] = _G.ConfigManager.npc_move_cfg[10 + i]
        _G.PoolsManager:GetInstance():Spawn(
            self.npcCfg[i].path,
            _G.ePoolType.Temporary,
            self.npc[i],
            function(trans)
                if self.go_table == nil then
                    _G.DestroyObject(trans)
                    return
                end
                -- local skeleton = trans:Find("SkeletonGraphic")
                -- local SA = skeleton:GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
                -- SA.AnimationState:SetAnimation(0, "move", true);
                trans:SetLocalScaleXYZ(0.2)
                if self.npcCfg[i].delay > 0 then
                    self.npc[i]:SetActiveE(0)
                    _G.DelayDo(self.npcCfg[i].delay, _G.handlerbind(self, self.PlayNpcAni, i))
                else
                    self:PlayNpcAni(i)
                end
            end
        )
    end
end

function WarTechnologyMainView:PlayNpcAni(id)
    if self.go_table == nil then
        return
    end
    self.npc[id]:SetActiveE(1)
    local pos = self.npcCfg[id].movePoint[1]
    self.npc[id]:SetLocalPosition(tonumber(pos[1]), tonumber(pos[2]), tonumber(pos[3]))
    local size = tonumber(pos[4])
    self.npc[id]:SetLocalScale(size * tonumber(pos[6]), size, 1)
    if pos[7] then
        local obj = self.go_table.obj_itemRoot:FindE(pos[7])
        if obj then
            local si = obj:GetSiblingIndexE()
            self.npc[id]:SetSiblingIndexE(si)
        else
            if _G.AppSetting.DEBUG then
                --_G.LogError("主城NPC移动层级未找到配置节点" .. pos[7])
            end
        end
    end
    self:NpcMoveTo(id, 2)
end

function WarTechnologyMainView:NpcMoveTo(id, index)
    if self.go_table == nil then
        return
    end
    if index > #self.npcCfg[id].movePoint then
        if self.npcCfg[id].cycle > 0 then
            self.npc[id]:SetActiveE(0)
            _G.DelayDo(self.npcCfg[id].cycle, _G.handlerbind(self, self.PlayNpcAni, id))
        else
            self:PlayNpcAni(id)
        end
        return
    end
    local pos = self.npcCfg[id].movePoint[index]
    local x, y, z = self.npc[id]:GetLocalScale()
    self.npc[id]:SetLocalScale(_G.math.abs(x) * tonumber(pos[6]), y, z)
    local size = tonumber(pos[4])

    self.npc[id]:DOScale(size * tonumber(pos[6]), size, 1, tonumber(pos[5])):SetEase(_G.CS.DG.Tweening.Ease.Linear)
    self.npc[id]:DOLocalMove(tonumber(pos[1]), tonumber(pos[2]), tonumber(pos[3]), tonumber(pos[5])):SetEase(
        _G.CS.DG.Tweening.Ease.Linear
    )   :OnComplete(
        function()
            if self.go_table == nil then
                return
            end
            if pos[7] then
                local obj = self.go_table.obj_itemRoot:FindE(pos[7])
                if obj then
                    local si = obj:GetSiblingIndexE()
                    self.npc[id]:SetSiblingIndexE(si)
                else
                    if _G.AppSetting.DEBUG then
                        --_G.LogError("主城NPC移动层级未找到配置节点" .. pos[7])
                    end
                end
            end
            self:NpcMoveTo(id, index + 1)
        end
    )
end

---界面的销毁函数
function WarTechnologyMainView:OnDestroy()
    if self.Timer ~= nil then
        self.Timer:Stop()
        self.Timer = nil
    end
    require "SociatyMobaTipsModel":GetInstance():CloseView()
    self:RemoveAllListener()
    self.go_table = nil
    if self.npc then
        for _, v in pairs(self.npc) do
            _G.DOTween.Kill(v)
        end
        self.npc = nil
    end
end

---按钮点击事件在这里派发
function WarTechnologyMainView:OnClickBtn(go)
    if go == self.go_table.aorbtn_dispatch then
        local cur = {}
        for i = 1, 4 do
            cur[i] = WarTechnologyModel:GetInstance():GetBuildAddTotleById(i)
        end
        WarTechnologyModel:GetInstance():DispathAll(function()
            _G.PopWindowManager:GetInstance():ShowAllTips(1080303)
            local next = {}
            for i = 1, 4 do
                local num = WarTechnologyModel:GetInstance():GetBuildAddTotleById(i)
                if num > cur[i] then
                    next[i] = num - cur[i]
                end
            end
            for i, v in pairs(next) do
                require "SociatyMobaTipsModel":GetInstance():Show({ _G.GetLangPackValue(self.cfg[i].name) .. _G.GetLangPackValue(90033405019) .. "+" .. _G.GetLangPackValue(90033405006, WarTechnologyModel:GetInstance():SetBuildingEffectNum(v * 60)), 1 })
            end
        end)
    elseif go == self.go_table.aorbtn_boxAward then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WarTechnologyGetAwardView.Name)
    elseif go == self.go_table.aorbtn_info then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 184)
    elseif go == self.go_table.aorbtn_task then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WarTechnologyTaskView.Name)
    elseif go == self.go_table.aorbtn_AttrDetail then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TeamHallAttrTechPanel.Name)
    end
end

return WarTechnologyMainView