---@class WarTechnologyQuestCardItem    中文描述
local WarTechnologyQuestCardItem = _G.BaseClass("WarTechnologyQuestCardItem")
---类的构造函数
function WarTechnologyQuestCardItem:__init(obj, callback, checkCard)
    self.gameObject = obj
    self.transform = obj
    self.callback = callback
    self.checkCard = checkCard
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end
---更新显示
---@param data CardData
function WarTechnologyQuestCardItem:Show(data, icon, index, isDispatch)
    self.data = data
    if not self.item then
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.CardAllItem,
            self.go_table.obj_Root,
            function(item)
                self.item = item
                item:ShowCardData(self.data, nil, true, true)
            end
        )
    else
        self.item:ShowCardData(self.data, nil, true, true)
    end
    _G.GameUtil.SetActiveByCondition(
        self.go_table.obj_mask,
        isDispatch
    )
    --_G.GameUtil.SetActiveByCondition(self.go_table.obj_choose, self.checkCard(self.data.uid))
    self.go_table.aorrawimage_res:LoadImage(icon)
    local WarTechnologyModel = require("WarTechnologyModel"):GetInstance()
    self.go_table.aortext_num.text = "+" .. _G.GetLangPackValue(90033405006, WarTechnologyModel:SetBuildingEffectNum(WarTechnologyModel:GetInstance():GetCardAdd(index, self.data.uid) * 60))
end

function WarTechnologyQuestCardItem:OnClickBtn(go, isOn)
    --if WarTechnologyModel:GetInstance():CheckIsDispatch(self.data.uid) then
    --    return
    --end
    if self.callback then
        self.callback(self)
    end
end

---类的析构函数
function WarTechnologyQuestCardItem:Dispose()
end

return WarTechnologyQuestCardItem