---@class WarTechnologyUpBuildView : UIBaseView    中文描述
---@field public go_table WarTechnologyUpBuildView_GoTable GoTable
local WarTechnologyUpBuildView = _G.BaseClass("WarTechnologyUpBuildView", _G.UIBaseView)
local lan = {
    [1] = 90033405018,
    [2] = 90033405017,
    [3] = 90033405019
}
---构造函数
---@protected
function WarTechnologyUpBuildView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.AnimationEvents.WarTechnologyUpBuild, self.Close, self)
end

---界面的入口函数
function WarTechnologyUpBuildView:OnCreate(index, lv, nextLv)
    self.index = index
    self.lv = lv
    self.nextLv = nextLv
    self.cfg = _G.ConfigManager.technology_building_level_cfg[self.lv]
    self.cfgNext = _G.ConfigManager.technology_building_level_cfg[nextLv]
    self:InitView()
end

---
---@protected
function WarTechnologyUpBuildView:SetTime(time)
    local str = math.floor(time / 3600) .. _G.GetLangPackValue(90022500435)
    return str
end

---
---@protected
function WarTechnologyUpBuildView:InitView()
    local cfg = _G.ConfigManager.technology_building_cfg[self.index]
    self.go_table.aortext_title.text = _G.GetLangPackValue(cfg.name)
    local goTable = _G.GetAutoGoTable(self.go_table["obj_UPProp" .. 1])
    goTable.aortext_AfterNum.text = self.lv
    goTable.aortext_BeforeNum.text = self.nextLv
    for i = 2, 4 do
        local id = 0
        local add
        local cur
        if i == 3 and self.cfgNext.building_count ~= self.cfg.building_count then
            id = 1
            add = self.cfgNext.building_count
            cur = self.cfg.building_count
        elseif i == 4 and self.cfgNext.building_time ~= self.cfg.building_time then
            id = 2
            add = self:SetTime(self.cfgNext.building_time)
            cur = self:SetTime(self.cfg.building_time)
        elseif i == 2 and self.cfgNext.building_effect ~= self.cfg.building_effect then
            id = 3
            add = _G.GetLangPackValue(90033405006, math.floor((self.cfgNext.building_effect) * 60 / 10000))
            cur = _G.GetLangPackValue(90033405006, math.floor((self.cfg.building_effect) * 60 / 10000))
        end
        if id > 0 then
            local goTable = _G.GetAutoGoTable(self.go_table["obj_UPProp" .. i])
            goTable.aortext_Name.text = _G.GetLangPackValue(lan[id])
            goTable.aortext_AfterNum.text = cur
            goTable.aortext_BeforeNum.text = add
            self.go_table["obj_UPProp" .. i]:SetActiveE(1)
        end
    end
end

---界面的销毁函数
function WarTechnologyUpBuildView:OnDestroy()
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
function WarTechnologyUpBuildView:OnClickBtn(go)
    if go == self.go_table.aorbtn_anyClose then
        self:Close()
    end
end

return WarTechnologyUpBuildView