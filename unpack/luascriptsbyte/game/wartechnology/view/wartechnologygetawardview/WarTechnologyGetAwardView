local WarTechnologyModel = require("WarTechnologyModel")
---@class WarTechnologyGetAwardView : UIBaseView    中文描述
---@field public go_table WarTechnologyGetAwardView_GoTable GoTable
local WarTechnologyGetAwardView = _G.BaseClass("WarTechnologyGetAwardView", _G.UIBaseView)

local Des = {
    MaxAfkTime = 90022010602,
    UpResPropMin = 90021800504,
    day = 90022010703
}

local discreteID = {
    MaxAfkTime = 101103,
    ResultIntervalTime = 101104
}

---构造函数
---@protected
function WarTechnologyGetAwardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function WarTechnologyGetAwardView:OnCreate()
    self.UpdatePage = 0

    self.totleTime = WarTechnologyModel:GetInstance():GetFastTime()
    self:GetAwardData()
    self:SetResView()
end

---
---@protected
function WarTechnologyGetAwardView:SetResView()
    self.cfg = _G.ConfigManager.technology_building_cfg
    for i = 1, 4 do
        local cfg = self.cfg[i]
        local goTable = _G.GetAutoGoTable(self.go_table["obj_item" .. i])
        local iconPath = _G.StorageManager:GetInstance():GetItemIcon(cfg.drop_item)
        goTable.aorrawimage_icon:LoadImage(iconPath)
        goTable.aortext_num.text = "+" .. _G.GetLangPackValue(90033405006, string.format("%.1f", WarTechnologyModel:GetInstance():GetBuildAddTotleById(i) * 60))
    end
end

---
---@protected
function WarTechnologyGetAwardView:GetAwardData()
    require("WarTechnologyNet"):GetInstance():CheckAward({ check_time = _G.TimeUtil.GetServerUnixTime() }, _G.handlerbind(self, self.GetData))
end

function WarTechnologyGetAwardView:SetTimeView()
    self.awardTime = WarTechnologyModel:GetInstance():GetAwardTime()
    self.AfkTime = _G.TimeUtil.GetServerUnixTime() - self.awardTime
    if self.AfkTime >= self.totleTime then
        if self.Timer ~= nil then
            self.Timer:Stop()
            self.Timer = nil
        end
        self:ShowAfkTime()
    else
        if self.Timer == nil then
            self.Timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdataShowTime, self, false, false, true)
            self.Timer:Start()
            self:ShowAfkTime()
        end
    end
end

function WarTechnologyGetAwardView:UpdataShowTime(elapsed)
    self.AfkTime = _G.TimeUtil.GetServerUnixTime() - self.awardTime
    self.UpdatePage = math.floor(self.UpdatePage + elapsed)
    if self.UpdatePage >= 30 then
        self.UpdatePage = 0
        self:GetAwardData()
    end
    self:ShowAfkTime()
end

function WarTechnologyGetAwardView:ShowAfkTime()
    if _G.IsNil(self.go_table) then
        return
    end
    local isMax = false
    if self.AfkTime > self.totleTime then
        self.AfkTime = self.totleTime
        isMax = true
    end
    if isMax == true then
        if self.Timer ~= nil then
            self.Timer:Stop()
            self.Timer = nil
        end
    end
    local day = math.floor(self.AfkTime / 86400)
    local str = _G.TimeUtil.TimeToString(self.AfkTime, 2)
    if day >= 1 then
        str = _G.TimeUtil.TimeToString(self.AfkTime, 2)
        str = _G.LangUtil.GetLangPackValue(Des.day, math.floor(self.AfkTime / 86400)) ..
            (math.floor(self.AfkTime / 3600) - day * 24) .. ":" .. str
    else
        str = _G.TimeUtil.TimeToString(self.AfkTime, 1)
    end
    self.go_table.aortext_AfkTime.text = str
end

function WarTechnologyGetAwardView:GetData(data)
    self:SetTimeView()
    self.AwardData = {}
    if data.award and data.award.item then
        for i, v in pairs(data.award.item) do
            if v.type[1] == 0 then
                v.type = { v.type[4], v.type[5], v.type[1], v.type[2], v.type[3] }
            end
            if self.AwardData[v.type[1]] then
                self.AwardData[v.type[1]] = self.AwardData[v.type[1]] + v.type[2]
            else
                self.AwardData[v.type[1]] = v.type[2]
            end
        end
    end
    if data.award and data.award.overflow then
        for i, v in pairs(data.award.overflow) do
            if v.type[1] == 0 then
                v.type = { v.type[4], v.type[5], v.type[1], v.type[2], v.type[3] }
            end
            if self.AwardData[v.type[1]] and self.AwardData[v.type[1]] ~= nil then
                self.AwardData[v.type[1]] = self.AwardData[v.type[1]]
            else
                self.AwardData[v.type[1]] = v.type[2]
            end
        end
    end
    self:ShowItemList()
end

function WarTechnologyGetAwardView:insertAward(award, zengyi)
    for i, v in pairs(award) do
        _G.table.insert(self.ItemSid, { sid = i, count = v, Zengyi = zengyi })
    end
end

---显示材料栏
---显示材料栏
function WarTechnologyGetAwardView:ShowItemList()
    self.ItemSid = {}
    self:insertAward(self.AwardData, false)
    if #self.ItemSid > 0 then
        _G.SortList(
            self.ItemSid,
            function(a)
                local grade = 0
                local Id = 0
                if a.sid == 21 then
                    Id = 999
                end
                if a.sid == 22 then
                    Id = 998
                end
                if a.sid == 11 then
                    Id = 997
                end
                local typeA = _G.StorageManager:GetInstance():CheckSidType(a.sid)
                if not typeA then
                    local a = 1
                end
                local CurrencyCfg = _G.ConfigManager.currency_type_cfg --货币资源
                local ItemCfg = _G.ConfigManager.item_cfg              --道具资源
                local EquipmentCfg = _G.ConfigManager.equipment_cfg    --装备资源
                if CurrencyCfg[a.sid] then
                    grade = CurrencyCfg[a.sid].Quality
                elseif ItemCfg[a.sid] then
                    grade = ItemCfg[a.sid].Quality
                elseif EquipmentCfg[a.sid] then
                    grade = EquipmentCfg[a.sid].grade
                else
                    grade = 0
                end
                return Id, -typeA, grade, -a.sid
            end
        )
        self.go_table.obj_BG33:SetActiveE(0)
        self.canTake = true
    else
        self.go_table.obj_BG33:SetActiveE(1)
        self.canTake = false
    end
    if self.IsFirst == nil then
        self.go_table.scrollloopvectical_Group:InitItemData(0, _G.handler(self, self.RefreshMaterialList))
        self.IsFirst = false
    end
    self.go_table.scrollloopvectical_Group:UpdateCount(#self.ItemSid)
end

function WarTechnologyGetAwardView:RefreshMaterialList(index, obj)
    if index < 0 then
        return
    end
    local data = self.ItemSid[index + 1]
    local goTable = _G.GetAutoGoTable(obj)
    _G.StorageManager:GetInstance():GetItemBaseView(
        data.sid,
        data.count,
        goTable.obj_root,
        function(tran)
            tran.gameObject:SetLocalPosition(0, 0, 0)
            tran.gameObject:SetLocalScaleXYZ(0.9)
            tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end,
        function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data.sid, nil, nil, data.Zengyi)
        end
    )
end

---显示品质特效
function WarTechnologyGetAwardView:SetGrade(go_table, cfg, isHide, parent, size)
    size = size or 1.75
    _G.UIUtils.SetItemGrade(go_table, cfg, isHide, parent, size)
end

---界面的销毁函数
function WarTechnologyGetAwardView:OnDestroy()
    if self.Timer ~= nil then
        self.Timer:Stop()
        self.Timer = nil
    end
end

---按钮点击事件在这里派发
function WarTechnologyGetAwardView:OnClickBtn(go)
    if go == self.go_table.aorbtn_Close then
        self:Close()
    elseif go == self.go_table.aorbtn_Done then
        WarTechnologyModel:GetInstance():GetBuildAward(function()
            self:GetAwardData()
        end)
    elseif go == self.go_table.aorbtn_quick then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WarTechnologyQuickRewardView.Name)
    end
end

return WarTechnologyGetAwardView