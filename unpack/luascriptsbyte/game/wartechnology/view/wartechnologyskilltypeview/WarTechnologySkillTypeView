---@class WarTechnologySkillTypeView : UIBaseView    中文描述
---@field public go_table WarTechnologySkillTypeView_GoTable GoTable
local WarTechnologySkillTypeView = _G.BaseClass("WarTechnologySkillTypeView", _G.Component)

---构造函数
---@protected
function WarTechnologySkillTypeView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.viewList = {}
end

---界面的入口函数
function WarTechnologySkillTypeView:OnCreate(obj)
    self.obj = obj
end

---
---@protected
function WarTechnologySkillTypeView:ShowView(cfg)
    self.cfg = cfg
    local typsIds = {}
    local itemCfg = _G.ConfigManager.technology_cfg
    for i, v in ipairs(self.cfg.mission_extra) do
        local cfg = itemCfg[v]
        if typsIds[cfg.elements] == nil then
            typsIds[cfg.elements] = {}
        end
        typsIds[cfg.elements][cfg.sequence] = cfg
    end
    for i, v in ipairs(typsIds) do
        if self.viewList[i] == nil then
            self.viewList[i] = self:AddComponent(self.go_table["obj_type" .. i], require("WarTechnologySkillTypeItemView").New(self.obj))
        end
        self.viewList[i]:ShowView(typsIds[i], i)
    end
end

---界面的销毁函数
function WarTechnologySkillTypeView:OnDestroy()
end

---按钮点击事件在这里派发
function WarTechnologySkillTypeView:OnClickBtn(go)
end

return WarTechnologySkillTypeView