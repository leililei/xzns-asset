---@class WarTechnologyView : UIBaseView    中文描述
---@field public go_table WarTechnologyView_GoTable GoTable
local WarTechnologyView = _G.BaseClass("WarTechnologyView", _G.UIBaseView)

local lua = {
    [1] = "WarTechnologyMainView",
    [2] = "WarTechnologySkillView"
}

---构造函数
---@protected
function WarTechnologyView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function WarTechnologyView:OnCreate()
    self.toggles = {}
    self.viewList = {}
    self.views = { [1] = { gameObject = self.go_table.obj_mainView }, [2] = { gameObject = self.go_table.obj_technology } }
    for i = 1, 2 do
        self.toggles[i] = _G.GetAutoGoTable(self.go_table["toggle_tag" .. i], _G.handlerbind(self, self.OnClickToggle, i))
    end
    self:OnClickToggle(nil, true, 1)
end

---监听Toggle点击事件
---@param key string
---@param callback function
function WarTechnologyView:OnClickToggle(_, isOn, key)
    local tb = self.toggles[key]
    local view = self.views[key]
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    self.curToggle = key

    --节点显隐
    if view then
        view.gameObject:SetActiveE(isOn and 1 or 0)
    end

    if isOn then
        self:OpenView()
    end
end

function WarTechnologyView:OpenView()
    if self.viewList[self.curToggle] == nil then
        self.viewList[self.curToggle] = self:AddComponent(self.views[self.curToggle].gameObject, require(lua[self.curToggle]).New(self))
    end
end

---
---@protected
function WarTechnologyView:SetPage(index)
    self.go_table["toggle_tag" .. index].isOn = true
    for i = 1, 2 do
        self.go_table["toggle_tag" .. i]:SetActiveE(index == i and 1 or 0)
        self.views[i].gameObject:SetActiveE(index == i and 1 or 0)
    end
    if index == 2 then
        self.viewList[index]:SetPosition()
    end
end

---界面的销毁函数
function WarTechnologyView:OnDestroy()
end

---按钮点击事件在这里派发
function WarTechnologyView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        if self.go_table.obj_technology:GetctiveInHierarchy() == 1 then
            self:SetPage(1)
            return
        end
        self:Close()
    elseif go == self.go_table.aorbtn_info then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 184)
    end
end

return WarTechnologyView