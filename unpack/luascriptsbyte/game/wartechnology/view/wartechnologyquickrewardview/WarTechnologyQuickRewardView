local WarTechnologyModel = require("WarTechnologyModel")
---@class WarTechnologyQuickRewardView : UIBaseView    中文描述
---@field public go_table WarTechnologyQuickRewardView_GoTable GoTable
local WarTechnologyQuickRewardView = _G.BaseClass("WarTechnologyQuickRewardView", _G.UIBaseView)

local Des = {
    GetRewardTime = 90022010402,
    FreeNum = 90022010502,
    FreeBtnTXT = 90021400003,
    RewardNum = 90021010402
}

local numTotle = _G.ConfigManager.discrete_cfg[130003][1]
local numcost = _G.ConfigManager.discrete_cfg[130004]

---构造函数
---@protected
function WarTechnologyQuickRewardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function WarTechnologyQuickRewardView:OnCreate()
    self:InitView()
    self:SetNumView()
end

---
---@protected
function WarTechnologyQuickRewardView:InitView()
    self.quickAwardData = WarTechnologyModel:GetInstance():GetFastAwardInfo()
    if self.isFirst == nil then
        self.go_table.scrollloophorizontal_itemList:InitItemData(#self.quickAwardData, _G.handler(self, self.RefreshMaterialList))
        self.isFirst = true
    else
        self.go_table.scrollloophorizontal_itemList:UpdateCount(#self.quickAwardData)
    end
end

function WarTechnologyQuickRewardView:SetNumView()
    local isShowDiamond = true
    local num = WarTechnologyModel:GetInstance():GetFreeTimes()
    if numTotle[1] - num > 0 then
        self.go_table.aortext_FreeTime.text = string.format(_G.GetLangPackValue(Des.FreeNum), numTotle[1] - num)
        self.go_table.aortext_Done.text = _G.GetLangPackValue(Des.FreeBtnTXT)
        self.go_table.aortext_FreeTime:SetActiveE(1)
        self.go_table.aorrawimage_martiralImg:SetActiveE(0)
        self.go_table.aortext_consume:SetActiveE(0)
        isShowDiamond = false
        --self.go_table.aorimage_huangseanniiu:SetGray(false)
        self.go_table.aorimage_huangseanniiu.SpriteName = "ui_ty_kuang_00"
        self.go_table.aortext_consume:GetComponentE(_G.typeof(_G.CS.TextOutline)).enabled = false
        self.go_table.aortext_Done:SetActiveE(0)
        self.go_table.aortext_consume.color = _G.Color.New(140 / 255, 45 / 255, 20 / 255, 1)
        self.go_table.aortext_Done.color = _G.Color.New(140 / 255, 45 / 255, 20 / 255, 1)
        self.go_table.aortext_Done:SetActiveE(1)
    else
        local num = WarTechnologyModel:GetInstance():GetPayTimes()
        self.go_table.aortext_FreeTime:SetActiveE(1)
        local data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.ResProp, numcost[1][1])
        local rewardTime = numTotle[2] - num
        self.go_table.aortext_FreeTime.text = string.format(GetLangPackValue(Des.RewardNum), rewardTime)
        if rewardTime == 0 then
            self.go_table.aorimage_huangseanniiu.SpriteName = "ui_ty_kuang_02"
            self.go_table.aortext_consume.color = _G.Color.New(235 / 255, 235 / 255, 235 / 255, 1)
            self.go_table.aortext_consume:GetComponentE(_G.typeof(_G.CS.TextOutline)).enabled = true
            self.go_table.aortext_Done:SetActiveE(1)
            self.go_table.aortext_Done.color = _G.Color.New(235 / 255, 235 / 255, 235 / 255, 1)
        else
            --self.go_table.aorimage_huangseanniiu:SetGray(false)
            self.go_table.aorimage_huangseanniiu.SpriteName = "ui_ty_kuang_00"
            self.go_table.aortext_consume:GetComponentE(_G.typeof(_G.CS.TextOutline)).enabled = false
            self.go_table.aortext_Done:SetActiveE(0)
            self.go_table.aortext_consume.color = _G.Color.New(140 / 255, 45 / 255, 20 / 255, 1)
            self.go_table.aortext_Done.color = _G.Color.New(140 / 255, 45 / 255, 20 / 255, 1)
        end
        self.go_table.aortext_Done.text = isShowDiamond == true and GetLangPackValue(90000010016) or GetLangPackValue(90020600073)
        local isOver = rewardTime == 0
        self.go_table.aorbtn_Done:SetActiveE(isOver and 0 or 1)
        self.go_table.aorrawimage_martiralImg:SetActiveE(1)
        self.go_table.aorrawimage_martiralImg:LoadImage(
            data.cfg.icon or data.cfg.Icon,
            function(image)
                image:SetActiveE(isShowDiamond == true and 1 or 0)
            end
        )
        local v = (num + 1) > #numcost and #numcost or (num + 1)
        local DiamondNum = numcost[v][2]
        self.go_table.aortext_consume.text = DiamondNum
        self.go_table.aortext_consume:SetActiveE(isShowDiamond == true and 1 or 0)
    end
end

function WarTechnologyQuickRewardView:RefreshMaterialList(index, obj)
    if index < 0 then
        return
    end
    local x = index + 1
    obj:SetName(x)
    local goTable = _G.GetAutoGoTable(obj)
    local award = self.quickAwardData[x]
    if award ~= nil then
        --_G.GameUtil.SetActiveByCondition(goTable.aorimage_zengyi, award[1])
        self:CreateAward(award, goTable.obj_root)
    end
end

function WarTechnologyQuickRewardView:CreateAward(award, p)
    local childCount = p:GetChildCountE()
    for i = 1, childCount do
        _G.PoolsManager:GetInstance():Despawn(p:GetChildE(0), _G.ePoolType.UIItem)
    end
    local _data = {}
    for i = 1, #award do
        if i > 3 then
            table.insert(_data, award[i])
        end
    end
    _G.StorageManager:GetInstance():GetItemBaseView(
        award[1],
        award[2],
        p,
        function(tran)
            tran.gameObject:SetActiveE(1)
            tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            tran.gameObject:SetLocalPosition(0, 0, 0)
            tran.gameObject:SetLocalScaleXYZ(0.8)
        end,
        nil,
        _data
    )
end

---界面的销毁函数
function WarTechnologyQuickRewardView:OnDestroy()
end

---按钮点击事件在这里派发
function WarTechnologyQuickRewardView:OnClickBtn(go)
    if go == self.go_table.aorbtn_Done then
        WarTechnologyModel:GetInstance():GetAllBuildReward(function()
            self:SetNumView()
        end)
    elseif go == self.go_table.aorbtn_Close then
        self:Close()
    end
end

return WarTechnologyQuickRewardView