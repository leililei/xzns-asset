local WarTechnologyModel = require("WarTechnologyModel")
---@class WarTechnologyCardChooseView : UIBaseView    中文描述
---@field public go_table WarTechnologyCardChooseView_GoTable GoTable
local WarTechnologyCardChooseView = _G.BaseClass("WarTechnologyCardChooseView", _G.UIBaseView)

---构造函数
---@protected
function WarTechnologyCardChooseView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function WarTechnologyCardChooseView:OnCreate(id, call)
    self.call = call
    self.index = id
    self.buildInfo = WarTechnologyModel:GetInstance():GetBuildInfo()[id]
    self.itemIcon = _G.StorageManager:GetInstance():GetItemIcon(self.buildInfo.cfg.drop_item)
    self.cardCopy = _G.DeepCopy(self.buildInfo.card_list)
    self.cards = {}
    self.CardItemLists = {}
    self:SetCardView()
end

function WarTechnologyCardChooseView:SetCardView()
    self.ShowCardData = WarTechnologyModel:GetInstance():GetCards(self.index)
    self.ShowCardData = WarTechnologyModel:GetInstance():CardsSort(self.index, self.ShowCardData)
    if self.init == nil then
        self.go_table.scrollloopvectical_CardList:InitItemData(#self.ShowCardData, _G.handler(self, self.RefreshCardItem))
    else
        self.go_table.scrollloopvectical_CardList:UpdateAllItem()
    end
    self.go_table.aortext_des.text = _G.GetLangPackValue(90033405051, #self.cardCopy, self.buildInfo.lvCfg.building_count)
    self.go_table.aortext_empty:SetActiveE(#self.ShowCardData > 0 and 0 or 1)
end

---刷新右侧的卡牌
---@param listView2 SuperScrollView.LoopListView2
function WarTechnologyCardChooseView:RefreshCardItem(index, trans)
    index = index + 1
    local instance = trans:GetInstanceIDE()
    if not self.CardItemLists[instance] then
        self.CardItemLists[instance] = require "WarTechnologyQuestCardItem".New(
            trans,
            _G.handler(self, self.OnClickCardItem),
            _G.handler(self, self.CheckIsChoose)
        )
    end
    self.CardItemLists[instance]:Show(self.ShowCardData[index], self.itemIcon, self.index, _G.table.ContainsValue(self.cardCopy, self.ShowCardData[index].uid))
end

---检测是否为选中的卡牌
function WarTechnologyCardChooseView:CheckIsChoose(uid)
    return _G.table.ContainsValue(self.cardCopy, uid)
end

---点击右侧的卡牌
---@param item BaseAwardNewItem 卡牌
function WarTechnologyCardChooseView:OnClickCardItem(item)
    if self:CheckIsChoose(item.data.uid) == true then
        for i, v in ipairs(self.cardCopy) do
            if v == item.data.uid then
                _G.table.remove(self.cardCopy, i)
            end
        end
    else
        if self.buildInfo.lvCfg.building_count <= #self.cardCopy then
            _G.PopWindowManager:GetInstance():ShowAllTips(1080302)
            return
        end
        _G.table.insert(self.cardCopy, item.data.uid)
    end
    self:SetCardView()
end

---界面的销毁函数
function WarTechnologyCardChooseView:OnDestroy()
end

---按钮点击事件在这里派发
function WarTechnologyCardChooseView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_closeView then
        self:Close()
    elseif go == self.go_table.aorbtn_cancel then
        self:Close()
    elseif go == self.go_table.aorbtn_sure then
        local pbData = {}
        local data = {}
        data.build_sid = self.index
        data.card_list = self.cardCopy
        _G.table.insert(pbData, data)
        WarTechnologyModel:GetInstance():BuildUpCard(pbData, function()
            if self.call then
                self.call()
            end
        end)
        self:Close()
    end
end

return WarTechnologyCardChooseView