function WarTechnologyModel:ShuZhiPanDuan(condition, num)
    if self.dataB ~= nil and self.dataB[condition] then
        if self.dataB[condition] < num then
            self.dataB[condition] = num
        end
    end
end

function WarTechnologyModel:PanDuanZhi(index, ids, onFinishCallback)
    if self.yijianlingqupanduan then
        return
    end
    self.yijianlingqupanduan = true
    local canGets = {}
    local canGetsType = {}
    local cfg = _G.ConfigManager.technology_building_cfg[index].mission_extra
    for k, v in pairs(ids) do
        local index = 0
        local id = v.Cfg.id
        for k2, v2 in ipairs(cfg) do
            if _G.table.ContainsValue(v2, id) then
                index = k2
                break
            end
        end
        local idList = self:YiJianLingQu(v, cfg[index])
        canGetsType[index] = idList
        for _, s in pairs(idList) do
            _G.table.insert(canGets, s)
        end
    end
    if _G.table.count(canGets) > 0 then
        local pbData = { sids = {} }
        for i, v in ipairs(canGets) do
            if self.canAwardTask[v] == nil then
                _G.table.insert(pbData.sids, v)
            end
        end
        if #pbData.sids > 0 then
            require("WarTechnologyNet"):GetInstance():FinishTask(pbData, function()
                for i, v in ipairs(pbData.sids) do
                    self.canAwardTask[v] = true
                end
                self:GetTaskAward(
                    canGets,
                    index,
                    canGetsType,
                    function(data)
                        self.yijianlingqupanduan = false
                        if onFinishCallback then
                            onFinishCallback()
                        end
                    end
                )
            end)
        else
            self:GetTaskAward(
                canGets,
                index,
                canGetsType,
                function(data)
                    self.yijianlingqupanduan = false
                    if onFinishCallback then
                        onFinishCallback()
                    end
                end
            )
        end
    else
        self.yijianlingqupanduan = false
        if onFinishCallback then
            onFinishCallback()
        end
    end
end

---一键领取循环判断服务器端
function WarTechnologyModel:YiJianLingQu(data, ids)
    local id = data.Cfg.id
    local idList = {}
    _G.table.insert(idList, id)

    local index = 0
    for i, v in ipairs(ids) do
        if v == id then
            index = i
        end
    end

    if index == #ids then
        return idList
    end

    local cfg
    local mission_cfg = _G.ConfigManager.mission_extra_cfg
    for i = 1, #ids - index do
        cfg = mission_cfg[ids[index + i]]
        local num = #cfg.condition[1]
        local count = self:TiaoMuPanDuan(cfg.condition)
        if count >= cfg.condition[1][num] then
            _G.table.insert(idList, cfg.id)
        else
            if ActiveTaskManager:GetInstance():CheckTaskTarget(cfg.condition[1], data) then
                _G.table.insert(idList, cfg.id)
            else
                return idList
            end
        end
    end
    return idList
end

function WarTechnologyModel:GetTaskAward(taskIds, index, canGetsType, call)
    if taskIds ~= nil then
        WarTechnologyNet:GetInstance():GetTaskAward(
            { sid = taskIds },
            function(data)
                if data.sids == nil then
                    return
                end
                for i, v in ipairs(data.sids) do
                    self.finishTask[v] = true
                end
                --self:UpDataBuildLv()
                for k, v in pairs(canGetsType) do
                    self:UpdateMangerTasksNew(index, k, v)
                end
                --for i = 1, #data.sids do
                --    self:UpdateMangerTasks(data.sids[i], index)
                --end
                if self.awardTime == 0 then
                    for k, v in pairs(self.buildInfo) do
                        if v.lvCfg.id > 1 then
                            self.awardTime = _G.TimeUtil.GetServerUnixTime()
                            break
                        end
                    end
                end
                local num = self.buildInfo[index].build_task_num or 0
                self.buildInfo[index].build_task_num = num + #taskIds
                require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
                    _G.ConfigManager.redpoint_cfg.Technologytasks.id, index)
                _G.StorageManager:GetInstance():ReceiveAwardData(data)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
                _G.Events:GetInstance():Broadcast(_G.eWarTechnology.BuildUpCard)

                if data.award and data.award.item and #data.award.item > 0 then
                    local isClear = false
                    local ids = _G.ConfigManager.ui_cfg.WarTechnologyView.resources
                    for i, v in ipairs(data.award.item) do
                        if _G.table.ContainsValue(ids, v.type[1]) then
                            isClear = true
                            break
                        end
                    end
                    if isClear == true then
                        self.openTechnologyId = {}
                    end
                    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg
                        .Technologyupgrade.id)
                end
                if call then
                    call()
                end
            end
        )
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("章节关卡id为空，成就领奖暂停")
        end
    end
end

function WarTechnologyModel:UpdateMangerTasksNew(index, k, sids)
    local cfg = _G.ConfigManager.technology_building_cfg[index].mission_extra[k]
    local re_sid = 0
    local sid = sids[#sids]
    local curSid = sids[1]
    if curSid == cfg[#cfg] then
        local cfg = _G.ConfigManager.mission_extra_cfg[curSid]
        local task = {
            sid = sid,
            state = _G.TaskEnum.ETaskState.Completed,
            target = { cfg.count }
        }
        self:UpdataTask(task)
    else
        for i = 1, #self.tasks do
            if self.tasks[i].i_task.sid == curSid then
                _G.table.remove(self.tasks, i)
                break
            end
        end

        for k2, v2 in ipairs(cfg) do
            if v2 == sid then
                re_sid = k2 == #cfg and sid or cfg[k2 + 1]
                break
            end
        end

        if re_sid > 0 then
            local states
            local cfg = _G.ConfigManager.mission_extra_cfg[re_sid]
            if self.canAwardTask[re_sid] ~= nil then
                states = _G.TaskEnum.ETaskState.Submited
            else
                states = _G.TaskEnum.ETaskState.Claimed
            end
            local task = {
                sid = re_sid,
                state = states,
                target = { self:TiaoMuPanDuan(cfg.condition) }
            }
            local CjTaskData = require("WarTechnologyTaskData").New(task, self.taskCompletedFun,
                _G.MarkTaskType.WarTechnology)
            table.insert(self.tasks, CjTaskData)
        end
    end
end

