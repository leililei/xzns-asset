    if taskinfos == nil then
        return
    end
    for key, value in pairs(taskinfos.collector) do
        self:ShuZhiPanDuan(value.key[1], value.value)
        _G.Events:GetInstance():Broadcast(_G.ePlayAactionEvent.PlayAactionCjWar, value.key, value.value, nil, true)
