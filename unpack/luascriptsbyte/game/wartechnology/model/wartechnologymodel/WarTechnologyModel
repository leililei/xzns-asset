---@return WarTechnologyModel WarTechnologyModel
function WarTechnologyModel:GetInstance()
    return self.super.GetInstance(self)
end

---类的构造函数
function WarTechnologyModel:__init()
    self.curFunctionOpenID = _G.FunctionID.WarTechnology
    self.technologyInfo = {}
    self.buildInfo = {}
    self.freeMaxTimes = _G.ConfigManager.discrete_cfg[130003][1][1]
    self.freePayTimes = _G.ConfigManager.discrete_cfg[130003][1][2]
    self.awardRedTime = 3600 * 12
    self.tasks = {}
    self.dispathCards = {}
    self.fastTime = 0
    self.openTechnologyId = {}
    ---任务完成 刷新界面
    self.taskCompletedFun = _G.handler(self, self.TaskCompleted)

    _G.Events:GetInstance():AddListener(_G.eCard.CardChangeStar, self.OnStarTaskUpdate, self)
    _G.Events:GetInstance():AddListener(_G.eCard.CardPotential, self.OnAwakeTaskUpdate, self)
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.OnUpdataSelfCards, self)
end

---更新星级任务
function WarTechnologyModel:OnStarTaskUpdate()
    local isChange = false
    for key, value in pairs(self.tasks) do
        if value.taskEnumType == _G.ActiveTaskEnum.ConditionEnum.WarTechnology.RaceStarNum or value.taskEnumType == _G.ActiveTaskEnum.ConditionEnum.WarTechnology.RaceCurMaxStar then
            value:CheckTaskTarget()
            value:CheckTaskState()
            isChange = true
        end
    end
    if isChange == true then
        for i = 1, 4 do
            require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.Technologytasks.id, i)
        end
    end
end

---更新觉醒任务
function WarTechnologyModel:OnAwakeTaskUpdate()
    local isChange = false
    for key, value in pairs(self.tasks) do
        if value.taskEnumType == _G.ActiveTaskEnum.ConditionEnum.WarTechnology.RaceAwakeNum or value.taskEnumType == _G.ActiveTaskEnum.ConditionEnum.WarTechnology.RaceAwakeMaxLevel then
            value:CheckTaskTarget()
            value:CheckTaskState()
            isChange = true
        end
    end
    if isChange == true then
        for i = 1, 4 do
            require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.Technologytasks.id, i)
        end
    end
end
