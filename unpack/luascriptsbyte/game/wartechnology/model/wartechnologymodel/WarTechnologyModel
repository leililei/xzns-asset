---@protected
function WarTechnologyModel:CheckTechnologyUnlock(sid)
    local pre_section = _G.ConfigManager.technology_cfg[sid].pre_section
    local isLock = false
    for i, v in ipairs(pre_section) do
        if self.technologyInfo[v[1]] == nil or self.technologyInfo[v[1]] < v[2] then
            isLock = true
            break
        end
    end
    return isLock
end
---获取信息回调
---@param msg technology.s2c_build_info
function WarTechnologyModel:ParseData(msg)
    for i = 1, 4 do
        self.buildInfo[i] = {}
        local cfg = _G.ConfigManager.technology_building_cfg[i]
        self.buildInfo[i].build_sid = i
        self.buildInfo[i].card_list = {}
        self.buildInfo[i].cfg = cfg
        self.buildInfo[i].building_count = 0
        self.buildInfo[i].addValue = {}
        self.buildInfo[i].addOrder = {}
        self.buildInfo[i].build_lv = 1
        self.buildInfo[i].build_task_num = 0
        for k, v in ipairs(cfg.order_add) do
            self.buildInfo[i].addValue[v[1]] = v[2]
            _G.table.insert(self.buildInfo[i].addOrder, v[1])
        end
    end
    --建筑信息
    if msg.build_list then
        for i, v in ipairs(msg.build_list) do
            if v.card_list then
                self.buildInfo[v.build_sid].card_list = v.card_list
                for i, v in ipairs(v.card_list) do
                    self.dispathCards[v] = true
                end
            end
            if v.build_lv then
                self.buildInfo[v.build_sid].build_lv = v.build_lv
            end
            if v.build_task_num then
                self.buildInfo[v.build_sid].build_task_num = v.build_task_num
            end
        end
    end
    --科技信息
    if msg.pos_info then
        for k, v in ipairs(msg.pos_info) do
            self.technologyInfo[v.key] = v.value
        end
    end
    self.freeTimes = msg.free_times
    self.awardTime = msg.award_time
    self.payTimes = msg.times
    self.finishTask = {}
    if msg.finish then
        for i, v in ipairs(msg.finish) do
            self.finishTask[v] = true
        end
    end
    self.canAwardTask = {}
    if msg.can_award then
        for i, v in ipairs(msg.can_award) do
            self.canAwardTask[v] = true
        end
    end
    self.cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    self:UpDataBuildLv()
    self:SetUnLockLv()
    --任务
    self:ParseTaskDatas(msg)
    self:InitFunction(msg.collector)
    --self:ParseData()
    self:SetTimeAwardTimer()
    self:OnUpdataSelfCards()
    self.super.ParseData(self)
end

