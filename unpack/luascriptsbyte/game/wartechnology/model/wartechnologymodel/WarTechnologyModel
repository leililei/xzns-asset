    if isLock == false then
        return false
    end
    local v = _G.ConfigManager.technology_layer_cfg[index]
    for k2, v2 in ipairs(v.mission_extra) do
        local isCostEnough = self:GetLayerPointUpLvRed(v2)
        if isCostEnough == true then
            return true
        end
    end
    return false
end

---
---@protected
function WarTechnologyModel:GetLayerPointUpLvRed(sid)
    if self:CheckTechnologyUnlock(sid) == false then
        if _G.table.ContainsValue(self.openTechnologyId, sid) == false then
            local isCostEnough = self:GetUpLvCostEnough(sid)
            if isCostEnough == true then
                return true
            end
        end
