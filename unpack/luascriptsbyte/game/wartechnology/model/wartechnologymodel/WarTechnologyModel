---获取属性
function WarTechnologyModel:GetAllAttribute(Elements)
    Elements = require "CardInfoManager":GetInstance():GetElementsMulti(Elements)
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local attribute = AttributeClassManager:GetAttribtueClass()
    local attributeglobal = AttributeClassManager:GetAttribtueClass()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.curFunctionOpenID) then
        local changeAttrTypes = _G.AttributeClassManager:GetInstance():GetChangeAttrTypes(attribute)
        return attribute, changeAttrTypes
    end
    local tonumber = _G.tonumber
    local name, value, aType

    local attTable = self:GetTotleAttribute(Elements[1])

    for _, v in pairs(attTable) do
        value = tonumber(v[3])
        name = v[1]
        aType = v[2] == "1" and _G.AttCountType.other or tonumber(v[2])
        attribute:AddValueByName(name, AttributeClassManager:GetValueWithName(name, value, aType), false, aType)
    end

    local attTableglobal = self:GetTotleAttributeGlobal()

    for _, v in pairs(attTableglobal) do
        value = tonumber(v[3])
        name = v[1]
        aType = v[2] == "1" and _G.AttCountType.other or tonumber(v[2])
        attributeglobal:AddValueByName(name, AttributeClassManager:GetValueWithName(name, value, aType), false, aType)
    end

    ---全局数据只算一次，加到默认种族上
    _G.AttributeClassManager:GetInstance():AddAttribute(attribute, attributeglobal)

    local changeAttrTypes = _G.AttributeClassManager:GetInstance():GetChangeAttrTypes(attribute)

    local changeAttrTypes_new = changeAttrTypes
    local attribute_new = attribute
    ---多种族在默认种族基础叠加
    if #Elements > 1 then
        for i = 2, #Elements do
            local attribute2 = AttributeClassManager:GetAttribtueClass()
            attTable = self:GetTotleAttribute(Elements[i])

            for _, v in pairs(attTable) do
                value = tonumber(v[3])
                name = v[1]
                aType = v[2] == "1" and _G.AttCountType.other or tonumber(v[2])
                attribute2:AddValueByName(name, AttributeClassManager:GetValueWithName(name, value, aType), false, aType)
            end

            attribute_new = _G.AttributeClassManager:GetInstance():AddAttributeByNew(attribute_new,
                attribute2)

            local changeAttrTypes2 = _G.AttributeClassManager:GetInstance():GetChangeAttrTypes(attribute2)
            changeAttrTypes_new = _G.AttributeClassManager:GetInstance():AddAttributeByNew(changeAttrTypes_new,
                changeAttrTypes2)
        end
    end

    return attribute, changeAttrTypes
end

