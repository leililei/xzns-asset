---@protected
function WarTechnologyModel:SetTimeAwardTimer()
    local curTime = _G.TimeUtil.GetServerUnixTime()
    if self.awardTime ~= 0 and (curTime - self.awardTime) < self.awardRedTime then
        if self.timer == nil then
            local num = self.awardRedTime - (curTime - self.awardTime)
            self.timer = _G.TimerManager:GetInstance():GetTimer(num, self.UpdataTimeAwardRed, self, true, false, true)
            self.timer:Start()
        end
    else
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
    end
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.Technologybenefits.id)
end

function WarTechnologyModel:UpdataTimeAwardRed()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.Technologybenefits.id)
end

---挂机奖励红点
function WarTechnologyModel:CheckTimeAwardRed()
    if self.awardTime == nil then
        return false
    end
    if self.awardTime == 0 then
        return false
    elseif (_G.TimeUtil.GetServerUnixTime() - self.awardTime) >= self.awardRedTime then
        return true
    end
    return false
end

---科技升级红点
function WarTechnologyModel:CheckUpLvRed()
    local layerCfg = _G.ConfigManager.technology_layer_cfg
    for k, v in pairs(layerCfg) do
        local isUp = self:GetLayerUpLvRed(v.id)
        if isUp == true then
            return true
        end
    end
    return false
end

