---
---@protected
function WarTechnologyModel:GetUpLvCostEnough(id)
    local cfg = _G.ConfigManager.technology_cfg
    local lv = self.technologyInfo[id] ~= nil and self.technologyInfo[id] or 0
    if lv == cfg[id].level then
        return false
    end
    local cost = cfg[id].material
    local data = cost[lv + 1]
    if data == nil then
        return false
    end
    local isUp = true
    for i = 1, (#data) / 2 do
        local itemSid = data[2 * (i - 1) + 1]
        local num = data[2 * (i - 1) + 2]
        local haveCount = _G.StorageManager:GetInstance():GetItemCountBySid(itemSid)
        if haveCount < num then
            isUp = false
        end
    end
    if isUp == true then
        local data2 = cfg[id].materials_elements[lv + 1]

        local needNum = data2[2]
        if needNum == 0 then
            return true
        end

        local element = cfg[id].elements
        local sid, count, data
        local curNum = 0
        for _, v in pairs(_G.ConfigManager.item_card_cfg) do
            sid = v.id
            if v.Elements == _G.CardElementType.Common or v.Elements == element then
                count = _G.StorageManager:GetInstance():GetItemCountBySid(sid)
                if count > 0 then
                    curNum = curNum + count
                    if curNum >= needNum then
                        return true
                    end
                end
            end
        end
        local cardList = CardInfoManager.GetDogFoodCards(element, data2[1])
        if curNum + #cardList >= needNum then
            return true
        end
    end
    return false
end

---能否建筑升级
function WarTechnologyModel:CheckIsBuildUp(index)
    local maxLv = #_G.ConfigManager.technology_building_level_cfg
    local build_lv = self.buildInfo[index].build_lv
    if build_lv >= maxLv then
        return false
    end
    local num = self.buildInfo[index].build_task_num
    local lv = self:GetBuildLvByTaskNum(num)
    if lv > build_lv then
        return true
    end
    return false
end

---根据任务数量获取建筑等级
function WarTechnologyModel:GetBuildLvByTaskNum(num)
    local cfg = _G.ConfigManager.technology_building_level_cfg
    local lv = 0
    for i, v in ipairs(cfg) do
        if num >= v.level then
            lv = v.id
        end
    end
    return lv
end

---空闲的上阵栏位红点
function WarTechnologyModel:CheckUpCardRed(index)
    if self.buildInfo == nil or table.count(self.buildInfo) == 0 then
        return false
    end

    local num = self.buildInfo[index].lvCfg.building_count
    if #self.buildInfo[index].card_list < num then
        local cards = self:GetCards(index)
        if #cards > #self.buildInfo[index].card_list then
            return true
        end
    end
    return false
end

---成就信息
---@param data achieve.s2c_achieve_info 成就信息
function WarTechnologyModel:ParseTaskDatas(data)
    self.dataB = {}

    for _, value in pairs(data.collector) do
        local s = value.key[1]
        self.dataB[s] = value.value
    end
end

function WarTechnologyModel:InitFunction(collector)
    if not _G.table.isEmptyOrNil(self.tasks) then
        for i = 1, _G.table.count(self.tasks) do
            self.tasks[i]:Dispose()
            -- _G.table.remove(self.tasks, i)
        end
        self.tasks = {}
    end

    local cfgs = _G.ConfigManager.technology_building_cfg
    local count = #cfgs
    local temp = {}
    for i = 1, count do
        local count2 = #cfgs[i].mission_extra
        for j = 1, count2 do
            for k, v in ipairs(cfgs[i].mission_extra[j]) do
                if k == #cfgs[i].mission_extra[j] then
                    if _G.table.ContainsValue(temp, v) == false then
                        _G.table.insert(temp, v)
                    end
                else
                    if self.finishTask[v] == nil then
                        if _G.table.ContainsValue(temp, v) == false then
                            _G.table.insert(temp, v)
                        end
                        break
                    end
                end
            end
        end
    end

    for i = 1, #temp do
        self:SetServerInfo(temp[i])
    end

    if collector ~= nil then
        -- body
        for _, value in pairs(collector) do
            _G.Events:GetInstance():Broadcast(_G.ePlayAactionEvent.PlayAactionCjWar, value.key, value.value, nil, true)
        end
    end
end

---获取任务列表
function WarTechnologyModel:GetTaskListByBuildId(index)
    local taskIds = {}
    for i, v in ipairs(self.tasks) do
        taskIds[v.sid] = i
    end
    local tasks = {}
    local cfgs = _G.ConfigManager.technology_building_cfg
    local taskList = cfgs[index].mission_extra
    for i = 1, #taskList do
        for k, v in ipairs(taskList[i]) do
            if taskIds[v] ~= nil then
                table.insert(tasks, self.tasks[taskIds[v]])
                break
            end
        end
    end
    return tasks
end

