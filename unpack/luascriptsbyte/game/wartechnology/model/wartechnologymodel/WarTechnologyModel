function WarTechnologyModel:GetTotleAttribute2()
    local attributeTotle = {}
    local technologyCfg = _G.ConfigManager.technology_cfg
    self.cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    self.cardsElements = {}
    for _, v in pairs(self.cards) do
        for i = 1, #v.cfg.Elements_new do
            if self.cardsElements[v.cfg.Elements_new[i]] == nil then
                self.cardsElements[v.cfg.Elements_new[i]] = true
            end
        end
    end

    for k, v in pairs(self.technologyInfo) do
        local value = technologyCfg[k]
        --if value.pointtype ~= 3 then
        local lv = v
        if lv ~= nil and lv > 0 then
            --全体属性加成
            local base_att = value.base_att
            local data = base_att[lv]
            if data then
                if attributeTotle[1] == nil then
                    attributeTotle[1] = {}
                end
                local attribute = attributeTotle[1]
                if attribute[data[1]] == nil then
                    attribute[data[1]] = {}
                end
                if attribute[data[1]][data[2]] == nil then
                    attribute[data[1]][data[2]] = 0
                end
                attribute[data[1]][data[2]] = attribute[data[1]][data[2]] + tonumber(data[3])
                --种族属性加成
                local base_att2 = value.base_att2
                if self.cardsElements[value.elements] then
                    local data2 = base_att2[lv]
                    if attributeTotle[value.elements + 1] == nil then
                        attributeTotle[value.elements + 1] = {}
                    end
                    local attribute = attributeTotle[value.elements + 1]
                    if attribute[data2[1]] == nil then
                        attribute[data2[1]] = {}
                    end
                    if attribute[data2[1]][data2[2]] == nil then
                        attribute[data2[1]][data2[2]] = 0
                    end
                    attribute[data2[1]][data2[2]] = attribute[data2[1]][data2[2]] + tonumber(data2[3])
                end
            end
        end
        --end
    end
    local listTotle = {}
    for index, value in pairs(attributeTotle) do
        local list = {}
        for k, v in pairs(value) do
            for k2, v2 in pairs(v) do
                _G.table.insert(list, { k, k2, v2 })
            end
        end
        listTotle[index] = list
    end
    return listTotle
end

