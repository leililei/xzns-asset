function WarTechnologyModel:CardsSort(index, cards)
    local list = {}
    for i, v in ipairs(cards) do
        local add = self:GetCardAdd(index, v.uid)
        _G.table.insert(list, { uid = v.uid, add = add })
    end
    _G.table.sort(
        list,
        function(a, b)
            if
                (self:CheckIsDispatch(a.uid) == nil and self:CheckIsDispatch(b.uid) == nil) or
                (self:CheckIsDispatch(a.uid) ~= nil and self:CheckIsDispatch(b.uid) ~= nil)
            then
                if a.add ~= b.add then
                    return a.add > b.add
                end
                return a.uid > b.uid
            else
                return self:CheckIsDispatch(a.uid) ~= nil
            end
        end
    )
    local showCard = {}
    for i, v in ipairs(list) do
        _G.table.insert(showCard, self.cards[v.uid])
    end
    return showCard
end

function WarTechnologyModel:CardsSort2(index, cards)
    local list = {}
    for i, v in ipairs(cards) do
        local add = self:GetCardAdd(index, v.uid)
        _G.table.insert(list, { uid = v.uid, add = add })
    end
    _G.table.sort(
        list,
        function(a, b)
            if a.add ~= b.add then
                return a.add > b.add
            end
            return a.uid > b.uid
        end
    )
    local showCard = {}
    for i, v in ipairs(list) do
        _G.table.insert(showCard, self.cards[v.uid])
    end
    return showCard
end

