    local task = self:GetTaskListByBuildId(index)
    for i, v in ipairs(task) do
        if v.i_task.state == _G.TaskEnum.ETaskState.Submited then
            local isGet = self:CheckIsGet(v.Cfg.id)
            if isGet == nil then
