---@protected
function WarTechnologyModel:CheckBuildCard(sid)
    local cards = {}
    local cardList = self.buildInfo[sid].card_list
    for i, v in ipairs(cardList) do
        if self.cards[v] ~= nil then
            _G.table.insert(cards, v)
        end
    end
    if #cardList ~= #cards then
        self.buildInfo[sid].card_list = cards
    end
end

