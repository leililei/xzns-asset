function WarTechnologyModel:BuildUpCard(data, call)
    WarTechnologyNet:GetInstance():BuildUpCard({ up_list = data }, function(msg)
        if msg.ack ~= 1 then
            return
        end
        local indexs = {}
        for i, v in ipairs(data) do
            for i, v2 in ipairs(self.buildInfo[v.build_sid].card_list) do
                self.dispathCards[v2] = nil
            end
            _G.table.insert(indexs, v.build_sid)
        end
        for i, v in ipairs(data) do
            for i, v2 in ipairs(v.card_list) do
                self.dispathCards[v2] = true
            end
        end
        for i, v in ipairs(data) do
            self.buildInfo[v.build_sid].card_list = _G.DeepCopy(v.card_list)
        end
        if self.awardTime == 0 then
            self.awardTime = _G.TimeUtil.GetServerUnixTime()
        end
        if call then
            call()
        end
        _G.Events:GetInstance():Broadcast(_G.eWarTechnology.BuildUpCard, indexs)
        require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.Technologyvacancy
            .id)
