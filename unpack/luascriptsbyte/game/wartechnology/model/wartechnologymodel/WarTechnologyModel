---获取单个卡牌的倍率加成
function WarTechnologyModel:GetCardAdd(index, uid)
    local cardData = self.cards[uid]
    if cardData == nil then
        return 0
    end
    local add = 0
    if _G.ConfigManager.card_star_cfg[require("CardInfoManager"):GetInstance():GetStarCfgId(cardData.cfg.Elements_new, cardData:GetStar())] ~= nil then
        add = add +
            _G.ConfigManager.card_star_cfg
            [require("CardInfoManager"):GetInstance():GetStarCfgId(cardData.cfg.Elements_new, cardData:GetStar())]
            .building_effect / 10000
    end
    if _G.ConfigManager.card_potential_cfg[cardData:GetPotential()] ~= nil then
        add = add + _G.ConfigManager.card_potential_cfg[cardData:GetPotential()].building_effect / 10000
    end
    local multiple = self.buildInfo[index].addValue[cardData.cfg.Order] / 10000
    return add * multiple
end

---检测是否有更高收益的卡牌上阵
function WarTechnologyModel:CheckDispathAllRefresh()
    local cards = {}
    for i = 1, 4 do
        cards[i] = {}
        local cardList = _G.table.toArray(self:GetCards(i))
        cardList = self:CardsSort2(i, cardList)
        local num = self.buildInfo[i].lvCfg.building_count
        for k, v in ipairs(cardList) do
            if #cards[i] < num then
                _G.table.insert(cards[i], v.uid)
            else
                break
            end
        end
    end
    local isDispacth = false
    for i, v in ipairs(self.buildInfo) do
        self:CheckBuildCard(i)
        local cur = self:GetBuildAddCardByIdList(v.card_list, i)
        local pre = self:GetBuildAddCardByIdList(cards[i], i)
        if cur ~= pre then
            isDispacth = true
            break
        end
    end
    return isDispacth, cards
end

