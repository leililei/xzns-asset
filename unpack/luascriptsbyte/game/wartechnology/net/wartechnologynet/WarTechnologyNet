local base = require("BaseGameNet")

---@class WarTechnologyNet : BaseGameNet    通信协议
local WarTechnologyNet = _G.BaseClass("WarTechnologyNet", base)
---@return WarTechnologyNet WarTechnologyNet
function WarTechnologyNet:GetInstance()
    return base.GetInstance(self)
end

---添加所有后端主动推的网络消息监听接口
function WarTechnologyNet:AddMessageListeners()
    self:AddMessageListener(_G.ConfigManager.net_map.technology_collector.Cmd, self.SendChengJiuCollectorCall)
end

---后端主动推送的消息数据开始
---发送成就收集消息
---@param data achieve.s2c_achieve_collector
function WarTechnologyNet:SendChengJiuCollectorCall(data)
    ---处理后端主动推送的任务数据更新
    require("WarTechnologyModel"):GetInstance():UpdateChengJiu(data)
end

---获取建筑信息
---@param callback function 回调
function WarTechnologyNet:GetInfo(callback)
    self:Access(_G.ConfigManager.net_map.game_technology_info, self:GetEmptyPB(), callback)
end

---建筑上阵卡牌
---@param callback function 回调
function WarTechnologyNet:BuildUpCard(pbData, callback)
    self:Access(_G.ConfigManager.net_map.game_technology_build_up_card, pbData, callback)
end

---挂机奖励预览
---@param callback function 回调
function WarTechnologyNet:CheckAward(pbData, callback)
