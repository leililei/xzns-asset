---@class WarTechnologyTaskData : ActiveTaskBase    中文描述
---@field Cfg mission_extra_cfg
local WarTechnologyTaskData = _G.BaseClass("WarTechnologyTaskData", _G.ActiveTaskBase)

function WarTechnologyTaskData:Init(task)
    if task.state == _G.TaskEnum.ETaskState.Claimed then
        _G.Events:GetInstance():AddListener(_G.ePlayAactionEvent.PlayAactionCjWar, self.OnAactionEnentCj, self)
    end
end
---类的析构函数
function WarTechnologyTaskData:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.ePlayAactionEvent.PlayAaction, self.OnAactionEnent, self)
    _G.Events:GetInstance():RemoveListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.OnEvent_CheckLock, self)
    _G.Events:GetInstance():RemoveListener(_G.ePlayAactionEvent.PlayAactionCjWar, self.OnAactionEnentCj, self)
end
function WarTechnologyTaskData:OnAactionEnentCj(a, b, c, d, e, f, g)
    self:OnAactionEnent(a, b, c, d, e, f, g)
end

function WarTechnologyTaskData:IsCheckTaskTargets(num)
    return num
end

function WarTechnologyTaskData:InitCfg()
    self.Cfg = _G.ConfigManager.mission_extra_cfg[self.i_task.sid]
    self.sid = self.i_task.sid
end

return WarTechnologyTaskData