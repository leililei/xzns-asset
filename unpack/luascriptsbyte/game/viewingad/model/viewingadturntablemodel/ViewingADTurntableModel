local base = require "ActivitySynTypeBase"
---@class ViewingADTurntableModel : ActivitySynTypeBase
---@field GetInstance fun():ViewingADTurntableModel
local ViewingADTurntableModel = _G.BaseClass("ViewingADTurntableModel", base)

local ViewingADNet = require("ViewingADNet"):GetInstance()
local ActivitySynManager = require("ActivitySynManager"):GetInstance()
local model = require("ViewingADModel"):GetInstance()

local VideoName = "ViewingADTurnTable"

function ViewingADTurntableModel:__init(activity)
    base:__init(activity)
    _G.Events:GetInstance():AddListener(_G.eYKNetEvent.ReconnectSuccess, self.ReConnect, self)
end

function ViewingADTurntableModel:HandleGMData(data)
    self:ParseData(data)
end

function ViewingADTurntableModel:ParseData(data)
    self.activity = self.curActivityClass
    self:SetSelfData(data)
    base.ParseData(self)
end

function ViewingADTurntableModel:SetSelfData(data)
    self.adCallBackCache = {}
    self.data = data.wheel
    self.activityId = self.activity.activityID
    self.sid = 10001--策划说id固定写死
    self.max = self.data.cfg.advert or 0
    self.cfg = self.curActivityClass.cfg or {}
    self.lotteryCount = self.data.count or 0
    self.mark = {}
    self.consumeTimes = self.data.consume_num or 0
    if self.data.mark then
        for _, v in pairs(self.data.mark) do
            self.mark[v] = true
        end
    end
end

---领取转盘奖励
function ViewingADTurntableModel:Lottery(callback)
    local pbData = { id = self.activityId }
    if callback then
        self.lotteryCallback = callback
    end
    self.adCallBackCache = {}
    ViewingADNet:Lottery(pbData, _G.handler(self, self.GetLotteryAward))
end

---领取累计奖励
function ViewingADTurntableModel:Accumulate(callback)
    local sids = self:GetCanGetList()
    local pbData = {sids = sids, id = self.activityId}
    if callback then
        self.accumulateCallback = callback
    end
    ViewingADNet:GetAccumulateAward(pbData, _G.handlerbind(self, self.GetAccumulateAward, sids))
end

---增加已抽取次数
function ViewingADTurntableModel:AddLotteryCount(num)
    self.lotteryCount = self.lotteryCount + (num or 1)
    self.consumeTimes = self.consumeTimes + (num or 1)
end

---获取配置
function ViewingADTurntableModel:GetCfg()
    return self.cfg or {}
end

---获取转盘奖励列表
function ViewingADTurntableModel:GetContent()
    return self.data.cfg.content or {}
end

---获取累计奖励列表
function ViewingADTurntableModel:GetAccumulate()
    return self.data.cfg.accumulate or {}
end

---获取领奖标记列表
function ViewingADTurntableModel:GetMarkList()
    return self.mark or {}
end

---获取累计抽奖次数
function ViewingADTurntableModel:GetLotteryCount()
    return self.lotteryCount or 0
end

---获取今日可观看次数
function ViewingADTurntableModel:GetCanLotteryCount()
    return self:GetMaxTimes() - self:GetConsumeTimes()
end

---获取今日已观看次数
function ViewingADTurntableModel:GetConsumeTimes()
    return self.consumeTimes or 0
end

---获取每日最大次数
function ViewingADTurntableModel:GetMaxTimes()
    return self.max or 0
end

---获取可领取sid
function ViewingADTurntableModel:GetCanGetList()
    local sids = {}
    local cfg = _G.ConfigManager.advertisement_goal_cfg
    for k, v in pairs(self.data.cfg.accumulate) do
        local isGet = false
        if self.mark then
            isGet = self.mark[v]
        end
        if self:GetLotteryCount() >= cfg[v].times and not isGet then
            _G.table.insert(sids, v)
        end
    end
    return sids
end

---获取转盘奖励
function ViewingADTurntableModel:GetLotteryAward(msg)
    if msg.ack ~= 1 then
        return
    end
    self:AddLotteryCount(1)
    model:RefreshRedpoint(2)
    if msg.award then
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
    end
    if self.lotteryCallback then
        self.lotteryCallback(msg)
    end
end

---获取累计奖励
function ViewingADTurntableModel:GetAccumulateAward(msg, sids)
    if msg.ack ~= 1 then
        return
    end
    if msg.award then
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
    end
    for _, v in pairs(sids) do
        self.mark[v] = true
    end
    model:RefreshRedpoint(2)
    if self.accumulateCallback then
        self.accumulateCallback(msg)
    end
end

---获取活动结束时间
function ViewingADTurntableModel:GetTime()
    self.startTime, self.endTime = self.activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    return self.endTime
end

function ViewingADTurntableModel:GetRedPointTree()

end

---开始播广告
function ViewingADTurntableModel:VideoAD(callback)
    local adModel = require("AdvertisementModel"):GetInstance()
    if self:GetCanLotteryCount() > 0 then
        if adModel:CheckFreeAD() or (_G.AppSetting.IsEditor and _G.AppSetting.DEBUG) then--开了Debug模式且在Editor下直接获得奖励
            self:Lottery(callback)
        else
            adModel:SetAdStartTime()
            self.callBack = callback
            require "SDKDotManager":GetInstance():OnEvent(_G.SDKDotType.SDKDot_ClickAd)
            _G.SDKManager:GetInstance():VideoAD(_G.handler(self, self.VideoADCallBack), VideoName, self.sid)
        end
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(1200002)
    end
end

function ViewingADTurntableModel:ReConnect(endcall)
    if endcall ~= nil then
        endcall(self.__cname)
    end
    if _G.AppSetting.DEBUG then
        _G.LogError("断线重连成功，开始处理广告奖励！")
    end
    for _, info in pairs(self.adCallBackCache or {}) do
        if _G.AppSetting.DEBUG then
            _G.LogError(info.sid, "发送广告奖励, sid =")
        end
        self:Lottery(info.callBack)
    end
end

function ViewingADTurntableModel:VideoADCallBack(bol, data)
    local adModel = require("AdvertisementModel"):GetInstance()
    if not bol then
        return
    end
    if data.state == "close" then
        adModel:ReportAD(require("SDKDef").AdStep.CloseAd, self.sid, true)
    end
    if data.state == "reward" then
        if self.sid then
            _G.table.insert(self.adCallBackCache, { sid = self.sid, callBack = self.callBack})
        end
        adModel:ReportAD(require("SDKDef").AdStep.AdAward, self.sid, true)
        require "SDKDotManager":GetInstance():OnEvent(_G.SDKDotType.SDKDot_Ad, self.sid)
        self:Lottery(self.callBack)
    end
end
function ViewingADTurntableModel:CheckActivityAwardDone()

end

function ViewingADTurntableModel:IsShowBtn()
    if _G.AppSetting.DEBUG then
        return true
    end
    if not _G.AppSetting.IsXzns and _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.Advertisement) then 
        return true
    end
    return false
end

function ViewingADTurntableModel:Dispose()
    base:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eYKNetEvent.ReconnectSuccess, self.ReConnect, self)
end

return ViewingADTurntableModel
