local base = _G.GameDataModelBase
---@class ViewingADModel : GameDataModelBase
---@field GetInstance fun():ViewingADModel
local ViewingADModel = _G.BaseClass("ViewingADModel", base)

local ViewingADNet = require("ViewingADNet"):GetInstance()
local model = require("AdvertisementModel"):GetInstance()

local VideoName = {
    [_G.AdvertisementType.PlaneAD] = "PlaneAD",
    [_G.AdvertisementType.Draw] = "Draw",
    [_G.AdvertisementType.SpiritualDraw] = "SpiritualDraw",
    [_G.AdvertisementType.ArtifactDraw] = "ArtifactDraw",
    [_G.AdvertisementType.PetDraw] = "PetDraw",
    [_G.AdvertisementType.ExpAdd] = "ExpAddTimes",
    [_G.AdvertisementType.CoinAdd] = "CoinAddTimes",
    [_G.AdvertisementType.StarAdd] = "StarAddTimes",
    [_G.AdvertisementType.Equipment] = "EquipmentTimes",
    [_G.AdvertisementType.SecretRealm] = "SecretRealmTimes",
    [_G.AdvertisementType.NitpickAddTime] = "NitpickAddTime",
    [_G.AdvertisementType.NitpickGuide] = "NitpickGuide",
}

local adType = {
    [_G.AdvertisementType.CoinAdd] = 101,
    [_G.AdvertisementType.ExpAdd] = 102,
    [_G.AdvertisementType.Equipment] = 103,
    [_G.AdvertisementType.StarAdd] = 105,
    [_G.AdvertisementType.SecretRealm] = 0
}

function ViewingADModel:__init()
    self.activityType = 10066
    self.redpointId = _G.ConfigManager.redpoint_cfg.ViewingAD.id
end

function ViewingADModel:GetDataFormServer()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ViewingADShopPanel.Name)
    if view then
        view:InitData()
    end
    self:RefreshRedpoint()
    self:ParseData()
end

function ViewingADModel:ParseData(data)
    self.super.ParseData(self)
end

---获取广告商城商品列表
function ViewingADModel:GetShopList(callback)
    self.cfg = _G.ConfigManager.advertisement_cfg
    self.shopList = {}
    self.sortingIndex = {}
    self.sidList = {}
    local list = _G.ConfigManager.discrete_cfg[200010] and _G.ConfigManager.discrete_cfg[200010][1] or {}
    for i = 1, #list do
        local shopItem = { id = list[i] }
        local isUnlock = true
        if self.cfg[list[i]].function_id and self.cfg[list[i]].function_id > 0 then
            if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.cfg[list[i]].function_id) then
                isUnlock = false
            end
        end
        if isUnlock then
            self.sortingIndex[list[i]] = #self.shopList + 1
            shopItem.num = model:GetAdMax(list[i]) - model:GetWatchedAdNum(list[i])
            _G.table.insert(self.shopList, shopItem)
            _G.table.insert(self.sidList, shopItem.id)
        end
    end
    if callback then
        callback(self.shopList)
    end
end

---获取可领取广告sid列表
function ViewingADModel:GetCanGetList()
    local sids = {}
    if _G.table.isEmptyOrNil(self.sidList) then
        self:GetShopList()
    end
    for _, v in pairs(self.sidList) do
        if model:HaveAdNum(v) then
            _G.table.insert(sids, v)
        end
    end
    return sids
end

---获取广告商城商品排序
function ViewingADModel:GetSortingIndex()
    return self.sortingIndex or {}
end

---单个广告奖励
function ViewingADModel:GetAward(sid, callback, notSend)
    if notSend then--纯前端奖励，不发给服务器
        if callback then
            callback(true)
        end
        for i, v in ipairs(model.adCallBackCache) do
            if sid == v.sid then
                _G.table.remove(model.adCallBackCache, i)
                break
            end
        end
    else
        local pbData = { sid = sid }
        require("AdvertisementNet"):GetInstance():GetAward(pbData, _G.handlerbind(self, self.GetAwardCallBack, { pbData.sid }, callback))
    end
end

---一键领取广告奖励
function ViewingADModel:GetAwardOneKey(callback)
    if model:CheckFreeAD() then
        local pbData = { sid = self:GetCanGetList() }
        ViewingADNet:GetAwardOneKey(pbData, _G.handlerbind(self, self.GetAwardCallBack, pbData.sid, callback))
    end
end

---奖励回调
function ViewingADModel:GetAwardCallBack(msg, sid, callBack)
    if msg.ack == 1 then
        if #sid == 1 then
            model.info[sid[1]] = msg.n_count or model.info[sid[1]]
        else
            for k, v in pairs(sid) do
                model.info[v] = msg.n_count[k] or model.info[v]
            end
        end
        local cfg = self.cfg[sid[1]]
        local controller = require("SystemMaterialController"):GetInstance()
        if #sid == 1 and #cfg.reward[1] == 1 then
            if adType[sid[1]] == 0 then--大秘境不扫荡
                _G.PopWindowManager:GetInstance():ShowAllTips(1200005)
            else
                local floor = controller:GetCurChallengeFloor(adType[sid[1]])
                if floor > 1 then
                    _G.PopWindowManager:GetInstance():ShowAllTips(1200003)
                else
                    _G.PopWindowManager:GetInstance():ShowAllTips(1200004)
                end
            end
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(1030001)
        end
        local canSweep = {}
        for _, v in pairs(sid) do
            if adType[v] then
                local systemId = adType[v]
                local times = self.cfg[v].reward[1][1]
                if systemId > 0 then
                    controller:AddTimesAndCount(systemId, times)
                    local floor = controller:GetCurChallengeFloor(systemId)
                    if floor > 1 then--至少打过一关才能扫荡
                        _G.table.insert(canSweep, { systemId, times })
                    end
                else
                    require("SecretRealmModel"):GetInstance():AddTicket(times)
                end
            end
        end
        if #canSweep ~= 0 then
            local finishCount = 0
            for _, v in pairs(canSweep) do
                controller:OnSweep(
                    v[1], 
                    v[2],
                    function(data)
                        msg.award = self:MergeAward(msg.award, data.award)
                        finishCount = finishCount + 1
                        if finishCount == #canSweep then--全部合并完再解析奖励
                            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                        end
                    end,
                    true
                )
            end
        end
        if msg.award and #canSweep == 0 then
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
        end
        self:RefreshRedpoint(1)
        if callBack then
            callBack(msg)
        end
    end

    for i, v in ipairs(model.adCallBackCache) do
        if sid == v.sid then
            _G.table.remove(model.adCallBackCache, i)
            break
        end
    end
end

---合并奖励信息
function ViewingADModel:MergeAward(a, b)
    if not a then
        return b
    end
    local idDic = {}
    for k, v in pairs(a.item) do
        idDic[v.type[1]] = k
    end
    for _, v in pairs(b.item) do
        local type = v.type
        if idDic[type[1]] then
            a.item[idDic[type[1]]].type[2] = a.item[idDic[type[1]]].type[2] + type[2]
        else
            a.item[#a.item + 1] = { type = { type[1], type[2], type[3] }}
        end
    end
    return a
end

---获取转盘活动数据
function ViewingADModel:GetActivityClass()
    local activity = require("ActivitySynManager"):GetInstance():GetActivityByType(self.activityType)
    if not _G.table.isEmptyOrNil(activity) then
        return activity[1].typeClass
    end
    return nil
end

---检测红点 1-观影商城，2-观影礼遇，3-累计奖励
function ViewingADModel:CheckRedpoint(param)
    if not model.isADOpen then
        return 0
    end
    if param == 1 then
        return #self:GetCanGetList() > 0 and 1 or 0
    elseif param == 2 then
        local activity = self:GetActivityClass()
        if activity then
            local canGet = self:CheckRedpoint(3)
            local canLottery = activity:GetCanLotteryCount() > 0
            if canLottery then
                return 1
            end
            return canGet
        end
        return 0
    elseif param == 3 then
        local activity = self:GetActivityClass()
        if activity then
            return #activity:GetCanGetList() > 0 and 1 or 0
        end
        return 0
    end
end

---刷新红点
function ViewingADModel:RefreshRedpoint(param)
    if not param then
        require("RedPointManager"):GetInstance():RefreshNodeByAllParams(self.redpointId)
    else
        require("RedPointManager"):GetInstance():RefreshNode(self.redpointId, param)
    end
end

---播放广告
function ViewingADModel:VideoAD(sid, callback, notSend)
    if model:CheckFreeAD() or _G.AppSetting.IsEditor then
        self:GetAward(sid, callback, notSend)
    else
        self.callBack = callback
        self.sid = sid
        model:SetAdStartTime()
        require "SDKDotManager":GetInstance():OnEvent(_G.SDKDotType.SDKDot_ClickAd)
        _G.SDKManager:GetInstance():VideoAD(_G.handlerbind(self, self.VideoADCallBack, notSend), VideoName[sid], sid)
    end
end

---广告播放回调
function ViewingADModel:VideoADCallBack(bol, data, notSend)
    if not bol then
        return
    end
    if data.state == "close" then
        model:ReportAD(require("SDKDef").AdStep.CloseAd, self.sid, true)
        if notSend then
            self.callBack(false)
        end
    end
    if data.state == "reward" then
        if self.sid then
            _G.table.insert(model.adCallBackCache, { sid = self.sid, callBack = self.callBack })
        end
        model:ReportAD(require("SDKDef").AdStep.AdAward, self.sid, true)
        require "SDKDotManager":GetInstance():OnEvent(_G.SDKDotType.SDKDot_Ad, self.sid)
        self:GetAward(self.sid, self.callBack, notSend)
    end
end

return ViewingADModel
