---@class ViewingADTurntablePanel : Component    观影台
---@field go_table ViewingADTurntablePanel_GoTable
local ViewingADTurntablePanel = _G.BaseClass("ViewingADTurntablePanel", _G.Component)

--转盘奖励坐标点，从12点方向开始是1，按顺时针顺序排列
local itemPos = {
    [1] = { 2, 202 },
    [2] = { 115, 162 },
    [3] = { 184, 53 },
    [4] = { 184, -52 },
    [5] = { 115, -162 },
    [6] = { -2, -202 },
    [7] = { -118, -162 },
    [8] = { -186, -52 },
    [9] = { -186, 53 },
    [10] = { -119, 162 },
}

function ViewingADTurntablePanel:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end

function ViewingADTurntablePanel:OnCreate(obj, layer, activity)
    self.go_table.gameObject:GetComponentE(_G.typeof(_G.Canvas)).sortingOrder = layer--修改页面背景层级
    self.go_table.obj_Root:GetComponentE(_G.typeof(_G.Canvas)).sortingOrder = layer + 10--修改页面显示层级
    self:InitData(activity)
    self:InitView()
    self:LoadEffect()
end

function ViewingADTurntablePanel:InitData(activity)
    self.activity = activity[1]
    ---@type ViewingADTurntableModel
    self.model = self.activity.typeClass
    self.cfg = self.activity.cfg
end

function ViewingADTurntablePanel:InitView()
    if _G.AppSetting.IsXzns then
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_ViewingADTurntablePanel_XUANZHONG_effect, self.go_table.obj_Effect)
    end
    self.Anim = self.go_table.aorrawimage_Turntable:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    self.time = self.model:GetTime()
    self.pointerIndex = 1
    self.go_table.aortext_Time.text = _G.GetLangPackValue(90000000988) .. _G.TimeUtil.TransLateSMCH(self.time)--剩余时间
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)--用于更新剩余时间
    self.timer:Start()
    self:InitItem()
    self:UpdateView()
    self:UpdatePrivilege()
    self:UpdateAniSwitch()
end

---初始化转盘奖励
function ViewingADTurntablePanel:InitItem()
    local itemList = self.model:GetContent()
    local cfg = _G.ConfigManager.advertisement_shop_cfg
    self.itemList = {}
    for i = 1, 10 do
        local item = _G.InstantiateObject(self.go_table.obj_Item, self.go_table.obj_ItemContent)
        local pos = itemPos[i]
        local itemCfg = cfg[itemList[i].k]
        local tb = _G.GetAutoGoTable(item)
        item:SetLocalPosition(pos[1], pos[2])
        item:SetName(itemCfg.id)
        tb.obj_Root:RemoveAllChildren()
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            itemCfg.item,
            tb.obj_Root,
            function(obj)
                if not self.go_table or item:GetName() ~= tostring(itemCfg.id) then
                    _G.DestroyImmediate(obj)
                    return
                end
                self.itemList[i] = _G.GetAutoGoTable(obj.gameObject)
                self.itemList[i].obj_ItemNum:SetActiveE(1)
            end
        )
    end
end

---加载特效
function ViewingADTurntablePanel:LoadEffect()
    if _G.AppSetting.IsXzns then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_ViewingADTurntablePanel_bg,
            self.go_table.obj_BgEffect,
            function(trans)
                if not self.go_table then
                    _G.DestroyImmediate(trans)
                    return
                end
            end
        )
    else
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_ViewingADTurntablePanel_bg,
            self.go_table.obj_BgEffect,
            function(trans)
                if not self.go_table then
                    _G.DestroyImmediate(trans)
                    return
                end
            end
        )
    end
end

---更新界面
function ViewingADTurntablePanel:UpdateView()
    self:UpdateTimes()
    self:UpdateAccumulate()
end

---更新转盘次数
function ViewingADTurntablePanel:UpdateTimes()
    self.go_table.aortext_Start.text = self.model:GetCanLotteryCount() .. "/" .. self.model:GetMaxTimes()--今日剩余次数/今日总次数
    if not _G.AppSetting.IsXzns then
        self.go_table.obj_timesRedpoint:SetActiveE(self.model:GetCanLotteryCount() > 0 and 1 or 0)
    end
end

---更新累计奖励进度
function ViewingADTurntablePanel:UpdateAccumulate()
    self.lotteryCount = self.model:GetLotteryCount()
    self.go_table.aortext_TotalTimes.text = self.lotteryCount--总计抽取次数
    self.accumulateList = {}--累计奖励列表
    self.markList = self.model:GetMarkList()--已领取奖励标记
    self.reachCount = 0--达到次数的数量
    self.markCount = 0--已领取数量
    self.canGet = {}--可领取奖励id列表
    for _, v in pairs(self.model:GetCanGetList()) do
        self.canGet[v] = true
    end
    for _, v in pairs(self.markList) do
        if v then
            self.markCount = self.markCount + 1
        end
    end
    local layout = self.go_table.obj_Content:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.GridLayoutGroup))
    local padding = layout.padding
    local spacing = layout.spacing
    local cfg = _G.ConfigManager.advertisement_goal_cfg
    for k, v in ipairs(self.model:GetAccumulate()) do
        self.accumulateList[k] = cfg[v]
        if self.accumulateList[k].times <= self.lotteryCount then
            --满足次数要求则达到次数的数量+1
            self.reachCount = self.reachCount + 1
        end
    end
    if self.listInit then
        self.go_table.scrollloophorizontal_AwardList:UpdateCount(#self.accumulateList)
    else
        self.listItem = {}
        self.go_table.scrollloophorizontal_AwardList:InitItemData(#self.accumulateList, _G.handler(self, self.RefreshList))
        local x, _ = self.go_table.obj_Content:GetRectTransformSize()
        if _G.AppSetting.IsXzns then
            self.go_table.slider_Progress:SetParentE(self.go_table.obj_Content)--将进度条放入滑动列表内
            self.go_table.slider_Progress:SetRectTransformSize(x - (padding.left + padding.right - spacing.x), 20)--根据布局器修改长度
            self.go_table.slider_Progress:SetAsFirstSiblingE()--作为第一个子节点
        end
        self.go_table.slider_Progress:SetLocalPosition(-(padding.left / 2), -80)--计算需要的偏移量
        self.listInit = true
    end
    self.go_table.scrollloophorizontal_AwardList:ScrollToIndex(self.markCount - 1)--已领取的奖励跳过，滑动到未领取的位置
    ---全领完直接为1，不继续计算进度
    if self.reachCount == #self.accumulateList then
        self.go_table.slider_Progress.value = 1
        return
    end
    local x, _ = self.go_table.slider_Progress:GetRectTransformSize()
    local sectionLen = 1 / #self.accumulateList--每个阶段占的比例
    local nowSection = sectionLen * self.reachCount--当前进度的比例
    if _G.AppSetting.IsXzns then
        ---第一段被图片遮挡一部分进度条，需要额外补上一点进度
        if self.lotteryCount ~= 0 then
            nowSection = nowSection + ((spacing.x - (padding.left / 2)) / x)
        end
    end
    local curSectionTimes = self.reachCount ~= 0 and self.accumulateList[self.reachCount].times or 0--当前阶段起始的次数
    local nextSectionTimes = self.accumulateList[self.reachCount + 1].times--下个阶段需要的次数
    local curProgress = self.lotteryCount - curSectionTimes--到下一个阶段需要的次数
    local progress = curProgress ~= 0 and (curProgress / (nextSectionTimes - curSectionTimes)) or 0--当前阶段的进度条比例
    local value = nowSection + (progress * sectionLen)--已达成部分+当前阶段

    self.go_table.slider_Progress.value = value
end

---更新时间
function ViewingADTurntablePanel:UpdateTime(elapsed)
    if not self.go_table or self.time <= 0 then
        self:StopTimer()
        if self.time <= 0 then
            self:OnActivityClose()
        end
        return
    end
    self.time = self.time - elapsed
    local time = _G.TimeUtil.TransLateSMCH(_G.Mathf.RoundToInt(self.time))
    self.go_table.aortext_Time.text = _G.GetLangPackValue(90000000988) .. time
end

---更新特权按钮
function ViewingADTurntablePanel:UpdatePrivilege()
    self.isFree = require("AdvertisementModel"):GetInstance():CheckFreeAD()
    self.go_table.aorimage_Mask:SetActiveE(self.isFree and 0 or 1)
    if not _G.AppSetting.IsXzns then
        self.go_table.obj_privilegeRedpoint:SetActiveE(self.model:CheckMonthCard())
    end
end

---更新跳过动画状态
function ViewingADTurntablePanel:UpdateAniSwitch()
    self.isSkip = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.ViewingADTurnAni, 0)
    self.go_table.aorimage_IsSkip:SetActiveE(self.isSkip)
end

---更新转盘指针
function ViewingADTurntablePanel:UpdatePointer(index, isPlayEff)
    local rotate = _G.Quaternion.Euler(0, 0, (index - 1) * (-36))--每个区间转36°
    if isPlayEff then
        self.go_table.obj_Effect:SetActiveE(0)
        self.go_table.obj_Effect:SetActiveE(1)--刷新特效显示
    end
    self.pointerIndex = index--更改指针指向的序号
    self.go_table.obj_Pointer:SetLocalRotation(rotate.x, rotate.y, rotate.z, rotate.w)--指针旋转
end

---刷新累计奖励滑动列表
function ViewingADTurntablePanel:RefreshList(index, obj)
    index = index + 1
    local id = obj:GetInstanceIDE()
    local tb = self.listItem[id]
    local data = self.accumulateList[index]
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        self.listItem[id] = tb
    end
    tb.data = data
    self:ShowItem(tb, index)
end

---设置累计奖励Item
function ViewingADTurntablePanel:ShowItem(tb, index)
    local go = tb.gameObject
    local data = tb.data
    go:SetName(data.id)
    tb.obj_Root:RemoveAllChildren()
    _G.AddViewBtnClick(go, _G.handler(self, self.OnClickItem))
    local isGet = self.markList[data.id]--当前奖励是否已领取
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        data.rewards[1],
        tb.obj_Root,
        function(item)
            if not self.go_table or go:GetName() ~= tostring(data.id) then
                _G.DestroyImmediate(item)
                return
            end
            item:SetGou(isGet)
            local itemTb = _G.GetAutoGoTable(item.gameObject)
            itemTb.obj_ItemNum:SetActiveE(1)
            if itemTb.obj_uieffect:GetChildCountE() == 0 then
                _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_kelingqukuang, itemTb.obj_uieffect)
            end
            itemTb.obj_uieffect:SetActiveE(self.canGet[data.id] and 1 or 0)
        end
    )
    tb.aorbtn_Click:SetActiveE(self.canGet[data.id] and 1 or 0)--可领取时点击一键领取，不可领取时点击弹出tips
    tb.aortext_Num.text = data.times
end

---停止计时器
function ViewingADTurntablePanel:StopTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---转盘抽奖
function ViewingADTurntablePanel:Lottery()
    if self.isPlaying then
        return
    end
    if _G.AppSetting.IsXzns then
        self.model:VideoAD(_G.handler(self, self.OnLottery))
    else
        self.model:VideoAD(_G.handler(self, self.OnLottery2))
    end
end

---按钮点击事件
function ViewingADTurntablePanel:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Start" then
        self:Lottery()--开始看转盘广告并抽奖（有特权直接抽奖）
    elseif name == "@_aorbtn_Privilege" then
        _G.JumpManager:GetInstance():Jump(148001)--商城月卡界面
    elseif name == "@_aorbtn_Help" then
        local id = _G.AppSetting.IsXzns and 1001 or 203
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, id)
    elseif name == "@_aorbtn_Skip" then
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.ViewingADTurnAni, self.isSkip == 1 and 0 or 1)
        self:UpdateAniSwitch()
    end
end

---累计奖励Item点击事件
function ViewingADTurntablePanel:OnClickItem(go, isOn)
    if self.canGet then
        self.model:Accumulate(_G.handler(self, self.OnAccumulate))--一键领取累计次数奖励
    end
end

---转盘抽奖回调
function ViewingADTurntablePanel:OnLottery(msg)
    local update = function()
        if msg.ack ~= 1 then
            return
        end
        self:UpdatePointer(msg.index, true)
        _G.DelayDo(0.5, function()
            if msg.award then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            end
            _G.DelayFrameDo(function()
                if self.go_table then
                    self:UpdateView()
                    self:UpdatePointer(1)--指针还原到12点方向
                end
            end)
        end)
    end
    if self.isSkip == 1 then
        update()
    else
        local cfg = _G.ConfigManager.ui_effect_cfg.ef_ViewingADTurntablePanel_zhuan
        _G.UIUtils.LoadEffectByCfg(
            cfg,
            self.go_table.obj_EffNode,
            function(trans)
                if not self.go_table then
                    _G.DestroyImmediate(trans)
                    return
                end
                self.isPlaying = msg
                self.Anim.enabled = true
                self.Anim:Play("ani_@_obj_Pointer" .. msg.index)
                _G.DelayDo(cfg.LifeTime - 0.05, function()
                    if not self.go_table then
                        return
                    end
                    self.Anim.enabled = false
                end)
            end,
            function()
                self.isPlaying = nil
                update()
            end
        )
    end
end

---转盘抽奖回调
function ViewingADTurntablePanel:OnLottery2(msg)
    local update = function()
        if msg.ack ~= 1 then
            return
        end
        local rotate = _G.Quaternion.Euler(0, 0, 36 * (msg.index - 1))--每个区间转36°
        self.go_table.aorrawimage_Turntable:SetLocalRotation(rotate.x, rotate.y, rotate.z, rotate.w)--指针旋转
        --_G.DelayDo(1, function()
        if msg.award then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
        end
        _G.DelayFrameDo(function()
            if self.go_table then
                self:UpdateView()
                self.go_table.aorrawimage_Turntable:SetLocalRotation(0, 0, 0)
                self.Anim.enabled = true
            end
        end)
        --end)
    end
    if self.isSkip == 1 then
        update()
    else
        local cfg = _G.ConfigManager.ui_effect_cfg.ef_ViewingADTurntablePanel_gold
        _G.UIUtils.LoadEffectByCfg(
            cfg,
            self.go_table.obj_EffNode,
            function(trans)
                if not self.go_table then
                    _G.DestroyImmediate(trans)
                    return
                end
                self.isPlaying = msg

                self.Anim.enabled = true
                self.Anim:Play("ani_VIPDrawMainView_rotate")

                _G.DelayDo(2, function()
                    if not self.go_table then
                        return
                    end
                    self.Anim.enabled = false
                    self.Anim:Play("empty")
                    --self.Anim.enabled = true
                    update()
                end)
            end,
            function()
                self.isPlaying = nil
            end
        )
    end
end

---领取累计奖励回调
function ViewingADTurntablePanel:OnAccumulate(msg)
    self:UpdateAccumulate()
end

function ViewingADTurntablePanel:OnActivityClose()
    local window = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ViewingADView.Name)
    window:CloseTurnTable()
end

function ViewingADTurntablePanel:OnDestroy()
    if self.isPlaying then
        if self.isPlaying.award then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, self.isPlaying)
        end
    end
    self.isPlaying = nil
    self.go_table = nil
    self:StopTimer()
end

return ViewingADTurntablePanel