---@class ViewingADShopPanel : Component	观影台
---@field go_table ViewingADShopPanel_GoTable
local ViewingADShopPanel = _G.BaseClass("ViewingADShopPanel", _G.Component)


function ViewingADShopPanel:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end

function ViewingADShopPanel:OnCreate(obj, layer)
    self.go_table.gameObject:GetComponentE(_G.typeof(_G.Canvas)).sortingOrder = layer--修改页面背景层级
    self.go_table.obj_Root:GetComponentE(_G.typeof(_G.Canvas)).sortingOrder = layer + 10--修改页面显示层级
    self:InitData()
    self:InitView()
    self:AddListener(_G.eMonthCard.MonthCardHasActive, self.UpdatePrivilege)
end

function ViewingADShopPanel:InitData()
    self.model = require("AdvertisementModel"):GetInstance()--原广告功能model
    self.shopModel = require("ViewingADModel"):GetInstance()
    self.cfg = _G.ConfigManager.advertisement_cfg
    self.listItem = {}
    self.shopList = {}
    self.shopModel:GetShopList(--获取已解锁的商品列表
        function(shopList)
            for k, v in pairs(shopList) do
                self.shopList[k] = v
            end
            self.sortingIndex = self.shopModel:GetSortingIndex()
            self:RefreshShopItem()
        end
    )
end

---初始化界面
function ViewingADShopPanel:InitView()
    self.aspectRadio = _G.CS.UnityEngine.Screen.width / 720--以720为基准计算宽度缩放比例
    self.realHeight = _G.CS.UnityEngine.Screen.height / self.aspectRadio--根据缩放比例计算显示用高度
    self:UpdatePrivilege()
    self.go_table.scrollloopvectical_ShopList:InitItemData(#self.shopList, _G.handler(self, self.RefreshList))
    self.isListInit = true
    _G.GameUtil.SetUiHeXieMask(self.go_table)
end

---更新特权按钮
function ViewingADShopPanel:UpdatePrivilege()
    self.isFree = self.model:CheckFreeAD()
    self.isGet = true--是否已经全部领取
    for _, v in pairs(self.shopList) do
        if v.num ~= 0 then
            self.isGet = false
            break
        end
    end
    local isShow = self.isFree and not self.isGet--有特权且有可领取内容
    self.go_table.aorimage_Mask:SetActiveE(self.isFree and 0 or 1)
    self.go_table.aorbtn_OneKey:SetActiveE(isShow and 1 or 0)
    local shortHeight = isShow and 100 or 0--如果显示一键领取按钮需要缩短滑动列表的高度
    local x, y = self.go_table.scrollloopvectical_ShopList:GetRectTransformSize()--目前滑动列表的高度
    if not self.listY then--记录初始滑动列表的高度，以便于隐藏一键领取后还原高度
        self.listY = y
    end
    self.go_table.scrollloopvectical_ShopList:SetRectTransformSize(x, self.listY - self.realHeight - shortHeight)--根据是否显示一键领取修改滑动列表的高度
end

---刷新商品Item
function ViewingADShopPanel:RefreshShopItem()
    _G.SortList(self.shopList, function(item)
        local isSoldOut = item.num == 0 and -99 or 1--已售罄置底
        local sortIndex = self.sortingIndex[item.id]
        return isSoldOut, -sortIndex
    end)
    if self.isListInit then
        self.go_table.scrollloopvectical_ShopList:UpdateCount(#self.shopList)
        self:UpdatePrivilege()
    end
end

---刷新商品列表
function ViewingADShopPanel:RefreshList(index, obj)
    index = index + 1
    local id = obj:GetInstanceIDE()
    local tb = self.listItem[id]
    local data = self.shopList[index]
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        self.listItem[id] = tb
    end
    tb.data = data
    self:ShowItem(tb)
end

---设置商品Item
function ViewingADShopPanel:ShowItem(tb)
    local go = tb.gameObject
    local data = tb.data
    local cfg = _G.ConfigManager.advertisement_cfg[data.id]
    go:SetName(cfg.id)
    tb.aortext_Limit.text = _G.GetLangPackValue(90021600007, data.num, cfg.watch)--每日限购(data.num/data.watch)
    _G.AddViewBtnClick(go, _G.handlerbind(self, self.OnClickItem, tb))
    local isItemAward = #cfg.reward[1] > 1--奖励是物品还是次数
    tb.obj_Item:SetActiveE(isItemAward and 1 or 0)
    tb.obj_Times:SetActiveE(isItemAward and 0 or 1)
    if isItemAward then--物品奖励直接加载Item
        tb.obj_Root:RemoveAllChildren()
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            cfg.reward[1],
            tb.obj_Root,
            function(item)
                if not self.go_table or go:GetName() ~= tostring(cfg.id) then
                    _G.DestroyImmediate(item)
                    return
                end
                tb.aortext_Name.text = _G.GetLangPackValue(item.cfg.Name)
                local itemTb = _G.GetAutoGoTable(item.gameObject)
                itemTb.obj_ItemNum:SetActiveE(1)
            end
        )
    else--次数奖励显示配置的图标和名称
        tb.aorrawimage_Icon:LoadImage(
            cfg.icon,
            function(img)
                img:SetNativeSize()
            end
        )
        tb.aortext_Name.text =_G.GetLangPackValue(cfg.language_id)
    end
    local isSoldOut = data.num == 0 and 1 or 0--是否已售罄
    tb.aorbtn_Buy:SetActiveE(data.num == 0 and 0 or 1)
    tb.aorbtn_SoldOut:SetActiveE(isSoldOut)
    ---策划说不需要整体遮罩，先隐藏以备之后再加回来的时候使用
    --tb.aorrawimage_Mask:SetActiveE(isSoldOut)
end

---一键领取广告奖励
function ViewingADShopPanel:GetAwardByOneKey()
    self.shopModel:GetAwardOneKey(function()
        for _, v in pairs(self.listItem) do
            v.data.num = 0
        end
        self:RefreshShopItem()
    end
    )
end

---商品点击事件
function ViewingADShopPanel:OnClickItem(go, isOn, tb)
    local data = tb.data
    local sid = data.id
    local name = go:GetName()
    if name == "@_aorbtn_Buy" then
        self.shopModel:VideoAD(
                data.id,
                function(msg)
                    tb.data.num = self.model:GetAdMax(sid) - self.model:GetWatchedAdNum(sid)
                    self:RefreshShopItem()
                end
        )
    end
end

---按钮点击事件
function ViewingADShopPanel:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_OneKey" then
        self:GetAwardByOneKey()
    elseif name == "@_aorbtn_Privilege" then
        _G.JumpManager:GetInstance():Jump(148001)--商城月卡界面
    end
end

---界面销毁
function ViewingADShopPanel:OnDestroy()
    self:RemoveListener(_G.eMonthCard.MonthCardHasActive, self.UpdatePrivilege)
    self.go_table = nil
end

return ViewingADShopPanel