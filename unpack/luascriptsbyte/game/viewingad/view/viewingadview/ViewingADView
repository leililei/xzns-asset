---@class ViewingADView : UIBaseView	观影台
---@field go_table ViewingADView_GoTable
local ViewingADView = _G.BaseClass("ViewingADView", _G.UIBaseView)

local cfgDic = {
    [1] = {
        cfg = _G.ConfigManager.ui_cfg.ViewingADShopPanel,
        iconName = "ui_gyt_guanyingshangcheng_",
        name = 90037000002
    },
    [2] = {
        cfg = _G.ConfigManager.ui_cfg.ViewingADTurntablePanel,
        iconName = "ui_gyt_guanyingyuli_",
        name = 90037000003,
        activityType = 10066
    }
}

function ViewingADView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function ViewingADView:OnCreate()
    self:InitView()
    self:InitToggle()
end

---初始化界面
function ViewingADView:InitView()
    self.panels = {}
    self.curPanel = nil
    self.LayerSorting = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.ViewingADView.Name).LayerSorting
end

---初始化页签
function ViewingADView:InitToggle()
    self.toggles = {}
    self.curToggle = nil
    for k, v in ipairs(cfgDic) do
        local tb = _G.GetAutoGoTable(
            _G.InstantiateObject(self.go_table.toggle_Page, self.go_table.obj_ToggleContent),
            _G.handlerbind(self, self.OnClickToggle, v.cfg.Name)
        )
        local isOpen = true
        if v.activityType then
            tb.activityCls = require("ActivitySynManager"):GetInstance():GetActivityByType(v.activityType)
            isOpen = not _G.table.isEmptyOrNil(tb.activityCls)--没有活动数据时隐藏页签
        end
        tb.cfg = v.cfg
        tb.name = v.cfg.Name--页面名
        local name = _G.GetLangPackValue(v.name)--显示名
        tb.aorimage_isOffIcon.SpriteName = v.iconName .. "n_icom"
        tb.aorimage_isOnIcon.SpriteName = v.iconName .. "c_icom"
        tb.aortext_isOffName.text = name
        tb.aortext_isOnName.text = name
        tb.toggle_Page:SetActiveE(isOpen and 1 or 0)
        tb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.ViewingAD.id, k)
        _G.table.insert(self.toggles, tb)
    end
    ---默认选中第一个页签
    self:ChangeToggle(self.toggles[1].name)
end

---切换页签
function ViewingADView:ChangeToggle(name)
    for _, v in pairs(self.toggles) do
        v.aorimage_isOffIcon:SetActiveE(name == v.name and 0 or 1)
        v.aorimage_isOnIcon:SetActiveE(name == v.name and 1 or 0)
        v.aortext_isOffName:SetActiveE(name == v.name and 0 or 1)
        v.aortext_isOnName:SetActiveE(name == v.name and 1 or 0)
        if name == v.name then
            self.curToggle = v--更新当前选中页签
        end
    end
    self:ChangePanel(self.curToggle)--根据当前选中页签切换界面
end

---切换页面
function ViewingADView:ChangePanel(toggle)
    local cfg = toggle.cfg
    if self.curPanel and self.curPanel.name == cfg.Name then--如果已经是目标界面则不处理
        return
    end
    if not self.panels[cfg.Name] then
        _G.PoolsManager:GetInstance():Spawn(
                cfg.PrefabPath,
                _G.ePoolType.UIItem,
                self.go_table.obj_PanelContent,
                function(panel)
                    if not panel or not self.go_table then
                        _G.DestroyObject(panel)
                        return
                    end
                    local tb = _G.GetAutoGoTable(self:AddComponent(panel, require(cfg.View).New(panel, self.LayerSorting, toggle.activityCls)).gameObject)
                    self.panels[cfg.Name] = tb
                    --tb.gameObject:GetComponentE(_G.typeof(_G.Canvas)).sortingOrder = self.LayerSorting--修改页面背景层级
                    --tb.obj_Root:GetComponentE(_G.typeof(_G.Canvas)).sortingOrder = self.LayerSorting + 10--修改页面显示层级
                    self:ShowPanel(cfg.Name)
                end
        )
    else
        self:ShowPanel(cfg.Name)--已经加载过页面直接显示
    end
    self.curPanel = cfg.Name--更新当前显示页面
end

---显示页面
function ViewingADView:ShowPanel(name)
    for k, v in pairs(self.panels) do
        v.gameObject:SetActiveE(k == name and 1 or 0)
    end
end

---转盘活动关闭处理
function ViewingADView:CloseTurnTable()
    _G.DestroyImmediate(self.toggles[2].gameObject)
    _G.DestroyImmediate(self.panels[self.curPanel].gameObject)
    self.toggles[2] = nil
    self.toggles[1].toggle_Page.isOn = true
    self:ChangeToggle(self.toggles[1].name)
end

---按钮点击事件
function ViewingADView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Close" then
        self:Close()
    end
end

---页签点击事件
function ViewingADView:OnClickToggle(go, isOn, name)
    if self.curToggle and name == self.curToggle.name then
        return
    end
    self:ChangeToggle(name)
end

return ViewingADView
