local base = require("BaseGameNet")

---@class ViewingADNet : BaseGameNet	通信协议
local ViewingADNet = _G.BaseClass("ViewingADNet", base)
---@return ViewingADNet ViewingADNet
function ViewingADNet:GetInstance()
    return base.GetInstance(self)
end

---获取抽奖结果
---@param callback function 回调方法
function ViewingADNet:Lottery(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_wheel_lottery
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---获取累计次数奖励
---@param callback function 回调方法
function ViewingADNet:GetAccumulateAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_wheel_accumulate
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---一键领取广告奖励
---@param pbData table 发送数据
---@param callback function 回调函数
function ViewingADNet:GetAwardOneKey(pbData, callback)
    local item = _G.ConfigManager.net_map.game_advertisement_one_give_add_num
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function ViewingADNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end
return ViewingADNet
