local base = require "BaseGameNet"
---@class BlackSourceNet : BaseGameNet	通信协议
local BlackSourceNet = _G.BaseClass("BlackSourceNet", base)

---@return BlackSourceNet BlackSourceNet
function BlackSourceNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---获取Info
---@param pbData table PB数据
---@param callback function 完成回调
function BlackSourceNet:GetInfo(callback)
    local item = _G.ConfigManager.net_map.game_dark_boss_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end
---获取推荐阵容
function BlackSourceNet:GetRecommend(callback)
    local item = _G.ConfigManager.net_map.game_dark_boss_recommend
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end
---挑战boss
function BlackSourceNet:FightBoss(callback)
    local item = _G.ConfigManager.net_map.game_dark_boss_fight
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
    return port
end
---获取玩家战报
function BlackSourceNet:GetReport(callback)
    local item = _G.ConfigManager.net_map.game_dark_boss_report
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---获取排行榜
function BlackSourceNet:GetRank(callback)
    local item = _G.ConfigManager.net_map.game_rank_dark_boss
    local port = base.Access(self, item, {page = 1}, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---获取玩家排行
function BlackSourceNet:GetPlayerRank(callback)
    local item = _G.ConfigManager.net_map.game_rank_get_rank_num
    local port = base.Access(self, item, {type = 60}, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end
---播放回放战斗
function BlackSourceNet:PlayRecord(pbData, callback)
    local item = _G.ConfigManager.net_map.game_dark_boss_fight_curr
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end
---购买战斗次数
function BlackSourceNet:BuyTimes(callback)
    local item = _G.ConfigManager.net_map.game_dark_boss_buy_times
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function BlackSourceNet:CallBack(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type BlackSourceNet
_G.BlackSourceNet = BlackSourceNet
return BlackSourceNet
