end

---创建对象时,入口构造函数
function BlackSourceModel:__init()
    self.systemId = 209
    self.curFunctionOpenID = 80
    self.bossOrderArray = _G.ConfigManager.discrete_cfg[108002][1]
    self.maxOrder = #self.bossOrderArray
    self.curOrder = 0
