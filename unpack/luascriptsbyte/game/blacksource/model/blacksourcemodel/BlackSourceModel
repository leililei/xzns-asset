---跳过战斗直接显示结算页面
---@return void
function BlackSourceModel:SkipFight()
    _G.BattleManager:GetInstance():SetInBattle(true)
    --发起战斗结算
    require("BlackSourceNet"):GetInstance():FightBoss(
        function(msg)
            if not msg or msg.ack ~= 1 then
                _G.BattleManager:GetInstance():SetInBattle(false)
                return
            end
            --计算战斗结果
            _G.BattleManager:GetInstance():SetArgDataAutoCmd(msg.fight_arg)
            local record = _G.BattleManager:GetInstance():GetStatisticsRecord(msg.fight_arg)
            if not record or not record.result then
                _G.BattleManager:GetInstance():SetInBattle(false)
                return
            end

            ---@type BattleControllerFirstTestBoss
            local controller = _G.require(_G.BattleControllerType.BlackSource).New()
            controller.curFightState = 4 --设置战斗结束

            _G.BattleManager:GetInstance():SetArgData(msg.fight_arg)
            _G.BattleManager:GetInstance():SetStatisticsCached(record)
            _G.BattleManager:GetInstance():SetBattleController(controller)
            --显示结算界面
            controller:FightResultFunc(record.result)
        end
    )
end

