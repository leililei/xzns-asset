    end
end

---获取排行榜奖励数据
function BlackSourceModel:GetRankRewardData()
    if not self.rewardDatas then
        self.rewardDatas = {}
        local array = _G.ConfigManager.discrete_cfg[108003][1]
        local cfg
        for _, v in pairs(array) do
            cfg = _G.ConfigManager.system_rank_cfg[v]
            if not self.rewardDatas[cfg.league] then
                self.rewardDatas[cfg.league] = {}
            end
            _G.table.insert(self.rewardDatas[cfg.league], cfg)
        end
        for _, v in pairs(self.rewardDatas) do
            _G.SortList(
                v,
                function(a)
                    return -a.id
                end
            )
        end
    end
    return self.rewardDatas
end

