    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.Bossbattle.id)
end
---购买次数
function BlackSourceModel:BuyTimes(call)
    BlackSourceNet:GetInstance():BuyTimes(
        function()
            local param = _G.ConfigManager.discrete_cfg[108001][1]
            self.buy_times = param[1]
            _G.StorageManager:GetInstance():ConsumeItem(_G.ResPropID.Diamond, nil, param[2])
            _G.Events:GetInstance():Broadcast(_G.eBlackSource.RefreshFightTimes)
            require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.Bossbattle.id)
            if call then
                call()
            end
        end
    )
end

return BlackSourceModel
