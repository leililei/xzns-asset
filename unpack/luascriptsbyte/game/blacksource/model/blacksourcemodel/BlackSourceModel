---解析战斗数据
function BlackSourceModel:ParseBattleData(data)
    local statisticsData = {}
    local statisticsMax = {}
    local CombMax = {}
    if data.FighterInfo ~= nil then
        statisticsData = data.FighterInfo[1]
        for i, v in ipairs(data.FighterInfo) do
            if i > 1 then
                _G.table.insertto(statisticsData.Attacker, v.Attacker)
                _G.table.insertto(statisticsData.Defender, v.Defender)
                _G.table.insertto(statisticsData.AtkCombineSkills[1], v.AtkCombineSkills[1])
                _G.table.insertto(statisticsData.DefCombineSkills[1], v.DefCombineSkills[1])
            end
        end
    end
    statisticsMax = {DmgOut = 1, DmgIn = 1, HpRecover = 1, CreateGuard = 1}
    for i = 1, #statisticsData.Attacker do
        if statisticsMax.DmgOut < statisticsData.Attacker[i].DmgOut then
            statisticsMax.DmgOut = statisticsData.Attacker[i].DmgOut
        end

        if statisticsMax.DmgIn < statisticsData.Attacker[i].DmgIn then
            statisticsMax.DmgIn = statisticsData.Attacker[i].DmgIn
        end

        if statisticsMax.HpRecover < statisticsData.Attacker[i].HpRecover then
            statisticsMax.HpRecover = statisticsData.Attacker[i].HpRecover
        end
        if statisticsMax.CreateGuard < statisticsData.Attacker[i].CreateGuard then
            statisticsMax.CreateGuard = statisticsData.Attacker[i].CreateGuard
        end
    end
    for i = 1, #statisticsData.Defender do
        if statisticsMax.DmgOut < statisticsData.Defender[i].DmgOut then
            statisticsMax.DmgOut = statisticsData.Defender[i].DmgOut
        end

        if statisticsMax.DmgIn < statisticsData.Defender[i].DmgIn then
            statisticsMax.DmgIn = statisticsData.Defender[i].DmgIn
        end

        if statisticsMax.HpRecover < statisticsData.Defender[i].HpRecover then
            statisticsMax.HpRecover = statisticsData.Defender[i].HpRecover
        end
        if statisticsMax.CreateGuard < statisticsData.Defender[i].CreateGuard then
            statisticsMax.CreateGuard = statisticsData.Defender[i].CreateGuard
        end
    end
    CombMax = {DmgOut = 1, CreateGuard = 1, HpRecover = 1}
    for i = 1, #statisticsData.AtkCombineSkills[1] do
        if CombMax.DmgOut < statisticsData.AtkCombineSkills[1][i].DmgOut then
            CombMax.DmgOut = statisticsData.AtkCombineSkills[1][i].DmgOut
        end

        if CombMax.CreateGuard < statisticsData.AtkCombineSkills[1][i].CreateGuard then
            CombMax.CreateGuard = statisticsData.AtkCombineSkills[1][i].CreateGuard
        end

        if CombMax.HpRecover < statisticsData.AtkCombineSkills[1][i].HpRecover then
            CombMax.HpRecover = statisticsData.AtkCombineSkills[1][i].HpRecover
        end
    end
    for i = 1, #statisticsData.DefCombineSkills[1] do
        if CombMax.DmgOut < statisticsData.DefCombineSkills[1][i].DmgOut then
            CombMax.DmgOut = statisticsData.DefCombineSkills[1][i].DmgOut
        end

        if CombMax.CreateGuard < statisticsData.DefCombineSkills[1][i].CreateGuard then
            CombMax.CreateGuard = statisticsData.DefCombineSkills[1][i].CreateGuard
        end

        if CombMax.HpRecover < statisticsData.DefCombineSkills[1][i].HpRecover then
            CombMax.HpRecover = statisticsData.DefCombineSkills[1][i].HpRecover
        end
    end
    local PetMax = {DmgOut = 1, CreateGuard = 1, HpRecover = 1}
    for j = 1, #statisticsData.AtkPetSkills[1] do
        if PetMax.DmgOut < statisticsData.AtkPetSkills[1][j].DmgOut then
            PetMax.DmgOut = statisticsData.AtkPetSkills[1][j].DmgOut
        end

        if PetMax.CreateGuard < statisticsData.AtkPetSkills[1][j].CreateGuard then
            PetMax.CreateGuard = statisticsData.AtkPetSkills[1][j].CreateGuard
        end

        if PetMax.HpRecover < statisticsData.AtkPetSkills[1][j].HpRecover then
            PetMax.HpRecover = statisticsData.AtkPetSkills[1][j].HpRecover
        end
    end
    for j = 1, #statisticsData.DefPetSkills[1] do
        if PetMax.DmgOut < statisticsData.DefPetSkills[1][j].DmgOut then
            PetMax.DmgOut = statisticsData.DefPetSkills[1][j].DmgOut
        end

        if PetMax.CreateGuard < statisticsData.DefPetSkills[1][j].CreateGuard then
            PetMax.CreateGuard = statisticsData.DefPetSkills[1][j].CreateGuard
        end

        if PetMax.HpRecover < statisticsData.DefPetSkills[1][j].HpRecover then
            PetMax.HpRecover = statisticsData.DefPetSkills[1][j].HpRecover
        end
    end
    local tb = {}
    _G.table.insert(
        tb,
        {statisticsData = statisticsData, statisticsMax = statisticsMax, CombMax = CombMax, PetMax = PetMax}
    )
    return tb
end

