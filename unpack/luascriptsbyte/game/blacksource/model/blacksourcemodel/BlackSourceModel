---@param msg dark_boss.s2c_dark_boss_info
function BlackSourceModel:GetInfoCall(msg)
    if msg.ack ~= 1 then
        return
    end
    self.bossId = msg.dark_info.boss_id
    self.maxFightNum = _G.ConfigManager.system_cfg[self.systemId].count_reset
    self.fightNum = msg.dark_info.fight_num
    self.dps = msg.dark_info.high_dps
    self.bossCfg = _G.ConfigManager.guild_boss_cfg[self.bossId]
    self.buy_times = msg.dark_info.buy_times
    self.startTime = msg.boss_start_time
    self:InitOrder()
    self:InitTime()
    self:ParseData()
    --TODO 刷新红点
    _G.Events:GetInstance():Broadcast(_G.eBlackSource.RefreshPanel)
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.Bossbattle.id)
end

---初始化时间
function BlackSourceModel:InitTime()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.endTime = self.startTime + 48 * 3600
    self.settlementTime = self.endTime - _G.ConfigManager.discrete_cfg[108005][1][1]
    local curTime = _G.TimeUtil.GetServerUnixTime()
    self.RTS = self.settlementTime - curTime
    if self.RTS <= 0 then
        self.RTS = self.endTime - curTime
    end
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.ChangeRTS, self, false, false, true)
    self.timer:Start()
end
---更改剩余时间
function BlackSourceModel:ChangeRTS(elapsed)
    self.RTS = self.RTS - elapsed
    _G.Events:GetInstance():Broadcast(_G.eBlackSource.RefreshTime, self:TranslateSecond())
    if self.RTS <= 0 then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        if _G.TimeUtil.GetServerUnixTime() < self.endTime then
            local isHave = false
            if _G.UIManager:GetInstance():IsActiveWindow(_G.ConfigManager.ui_cfg.EmbattleView.Name) then
                local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.EmbattleView.Name)
                ctrl:QuitEmbattle()
                isHave = true
            end
            if _G.UIManager:GetInstance():IsActiveWindow(_G.ConfigManager.ui_cfg.EmbattleGrounpRecommendView.Name) then
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.EmbattleGrounpRecommendView.Name)
                isHave = true
            end
            if isHave then
                _G.PopWindowManager:GetInstance():ShowAllTips(
                    310402,
                    _G.LangUtil.GetLangPackValue(90000010312, self:TranslateSecond())
                )
            end
            require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.Bossbattle.id)
            self:InitTime()
        end
    end
end

function BlackSourceModel:InitOrder()
    for i = 1, #self.bossOrderArray do
        if self.bossOrderArray[i] == self.bossId then
            self.curOrder = i
            break
        end
    end
end

---获取boss配置表
function BlackSourceModel:GetBossCfg(id)
    if not id then
        return self.bossCfg
    end
    return _G.ConfigManager.guild_boss_cfg[id]
end

---挑战Boss
---@param skipBattle boolean  @ 是否显示跳过战斗按钮
function BlackSourceModel:OnFightBoss(id, index, skipBattle)
    if self.bossId ~= id then
        if id then
            if id == _G.ConfigManager.discrete_cfg[108006][1][1] then
                _G.PopWindowManager:GetInstance():ShowAllTips(310404)
            else
                local str = ""
                if id < self.bossId then
                    str =
                        _G.LangUtil.GetLangPackValue(
                        90000010314,
                        self:TranslateSecond(
                            self.RTS + _G.math.max(self.maxOrder - self.curOrder - 1 + index, 0) * 2 * 86400
                        )
                    )
                else
                    str =
                        _G.LangUtil.GetLangPackValue(
                        90000010314,
                        self:TranslateSecond(self.RTS + _G.math.max(index - self.curOrder - 1, 0) * 2 * 86400)
                    )
                end
                _G.PopWindowManager:GetInstance():ShowAllTips(310403, str)
            end
        end
        return
    end
    if self:IsSettlement() then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            310402,
            _G.LangUtil.GetLangPackValue(90000010312, self:TranslateSecond())
        )
        return
    end
    local fight = function()
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
        require "EmbattleController":GetInstance():OpenEmbattle(
            _G.EmbattleType.BlackSource,
            _G.EmbattleSaveType.server,
            false,
            _G.EmbattleControllerItemType.blackSource,
            _G.handler(self, self.ExitEmbattle),
            function(_, _, _skipBattle)
                if _skipBattle then
                    self:SkipFight()
                else
                    self:EnterFight()
                end
            end,
            self.bossCfg.monster_group,
            skipBattle
        )
    end

    if self:GetFightNum() <= 0 then
        local param = _G.ConfigManager.discrete_cfg[108001][1]
        if _G.StorageManager:GetInstance():CheckItem(_G.ResPropID.Diamond, param[2]) then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                310401,
                _G.LangUtil.GetLangPackValue(90000010313, param[2]),
                function()
                    self:BuyTimes(fight)
                end
            )
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ResPropID.Diamond)
        end

        return
    end
    fight()
end

function BlackSourceModel:TranslateSecond(time1)
    if not time1 then
        time1 = self.RTS
    end
    time1 = math.ceil(time1)
    local time = _G.TimeUtil.TranslateSecond(time1)
    local str = ""
    if time.day > 0 then
        str = _G.LangUtil.GetLangPackValue(90028010120, time.day, time.hour, time.min)
    elseif time.hour > 0 then
        str = _G.LangUtil.GetLangPackValue(90028010121, time.hour, time.min)
    else
        str = _G.LangUtil.GetLangPackValue(90028010122, time.min, time.sec)
    end
    return str, time1
end
