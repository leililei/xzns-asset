---@class BlackSourceReportPanel : UIBaseView	中文描述
---@field public go_table BlackSourceReportPanel_GoTable GoTable
---@field data dark_boss.i_fight_cur[]
local BlackSourceReportPanel = _G.BaseClass("BlackSourceReportPanel", _G.UIBaseView)
--_G.BlackSourceReportPanel = BlackSourceReportPanel

local CS = _G.CS
local typeof = _G.typeof
local UIUtils = _G.UIUtils
function BlackSourceReportPanel:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eBattleState.RecordStart, self.StartRecord)
    self:AddListener(_G.eBattleState.RecordEnd, self.EndRecord)
    self:AddListener(_G.eBlackSource.RefreshPanel, self.UpdatePanel)
end

---界面的入口函数
---@param data dark_boss.s2c_dark_boss_fight_recur
function BlackSourceReportPanel:OnCreate(data)
    self.data = data.fight_curs or {}
    if not _G.table.isEmptyOrNil(self.data) then
        local style = _G.PlayerModel:GetInstance():GetRoleStyle()
        local frame = _G.PlayerModel:GetInstance():GetCurFrame()
        for k,v in pairs(self.data) do
            v.style = style
            v.frame = frame
        end
    end
    self.Items = {}
    self.go_table.scrollloopvectical_report:InitItemData(#self.data, _G.handler(self, self.RefreshItem))
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_no, #self.data <= 0)
end
---刷新界面
function BlackSourceReportPanel:UpdatePanel()
    require "BlackSourceNet":GetInstance():GetReport(
        function(data)
            self.data = data.fight_curs or {}
            if not _G.table.isEmptyOrNil(self.data) then
                local style = _G.PlayerModel:GetInstance():GetRoleStyle()
                local frame = _G.PlayerModel:GetInstance():GetCurFrame()
                for k,v in pairs(self.data) do
                    v.style = style
                    v.frame = frame
                end
            end
            self.go_table.scrollloopvectical_report:UpdateCount(#self.data)
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_no, #self.data <= 0)
        end
    )
end

---按钮点击事件在这里派发
function BlackSourceReportPanel:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

function BlackSourceReportPanel:RefreshItem(index, obj)
    local id = obj:GetInstanceIDE()
    ---@type BlackSourceReportPanel._obj_reportItem_GoTable
    local tb = self.Items[id]
    if not tb then
        ---@type BlackSourceReportPanel._obj_reportItem_GoTable
        tb = _G.GetAutoGoTable(obj)
        self.Items[id] = tb
    end
    _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickRecordItem, tb))
    tb.index = index + 1
    local data = self.data[tb.index]
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase,data,0.8,true,false,false,function()end)
    tb.aortext_name.text = _G.PlayerModel:GetInstance():GetName()
    tb.aortext_time.text = self:TranslateTime(data.time)
    tb.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(data.power)
    tb.aortext_dps2.text = _G.GameUtil.NumberToUnitStrFight(data.dps)
end

function BlackSourceReportPanel:TranslateTime(time)
    local servertime = _G.TimeUtil.GetServerUnixTime()
    time = _G.TimeUtil.TranslateSecond(servertime - time)
    if time.day > 0 then
        time.day = time.day > 30 and 30 or time.day
        return _G.string.format(_G.LangUtil.GetLangPackValue(90022100085), time.day)
    end
    if time.hour > 0 then
        if time.min > 0 then
            return _G.string.format(_G.LangUtil.GetLangPackValue(90022100084), time.hour, time.min)
        else
            return _G.string.format(_G.LangUtil.GetLangPackValue(90022100086), time.hour)
        end
    end
    time.min = time.min > 0 and time.min or 1
    return _G.string.format(_G.LangUtil.GetLangPackValue(90022100083), time.min)
end
function BlackSourceReportPanel:OnClickRecordItem(go, isOn, tb)
    local data = self.data[tb.index]
    require "BlackSourceModel":GetInstance():PlayRecord(data.uid)
end

---开始回放
function BlackSourceReportPanel:StartRecord()
    self:Hide()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.BlackSourceView.Name)
end

---
function BlackSourceReportPanel:EndRecord()
    self:Show()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BlackSourceView.Name)
end

return BlackSourceReportPanel
