---刷新奖励2
function BlackSourceRankView:RefreshReward2(index, obj)
    local newindex = index + 1
    local instanceID = obj:GetInstanceIDE()
    ---@type boss_rank_cfg
    local data = self.RewardDatas[newindex]
    if not self.rewardList[instanceID] then
        self.rewardList[instanceID] = _G.GetAutoGoTable(obj)
    end
    local tb = self.rewardList[instanceID]
    tb.data = data
    _G.GameUtil.SetActiveByCondition(tb.aorimage_rank, newindex <= 3)
    if newindex <= 3 then
        tb.aorimage_rank.SpriteName = "tz_qjhs_phb_mingci_0" .. newindex
        tb.aortext_rank.text = ""
    elseif data.min_rank == data.max_rank then
        tb.aortext_rank.text = newindex
    else
        tb.aortext_rank.text = _G.string.format("%s~%s", data.min_rank, data.max_rank)
    end
    if tb.data then
        self:ShowAward(tb, tb.obj_Award, tb.data.rewards)
    else
        self:ShowAward(tb, tb.obj_Award, {})
    end
end

---按钮点击事件在这里派发
function BlackSourceRankView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

---开始回放
function BlackSourceRankView:StartRecord()
    self:Hide()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.BlackSourceView.Name)
end

---
function BlackSourceRankView:EndRecord()
    self:Show()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BlackSourceView.Name)
end

return BlackSourceRankView
