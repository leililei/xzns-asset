local BlackSourceRankView = _G.BaseClass("BlackSourceRankView", _G.UIBaseView)
local rankEffect = {
    "Ef_ArenaTop1",
    "Ef_ArenaTop2",
    "Ef_ArenaTop3"
}
local UIUtils = _G.UIUtils
function BlackSourceRankView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:IsBool()
    self.itemList = {}
    self.gameObject:SetActiveE(0)
    self:AddListener(_G.eBattleState.RecordStart, self.StartRecord)
    self:AddListener(_G.eBattleState.RecordEnd, self.EndRecord)
    self:AddListener(_G.eBlackSource.RefreshPanel, self.RefreshPanle)
end

---界面的入口函数
function BlackSourceRankView:OnCreate(type)
    self.playerUid = _G.PlayerModel:GetInstance():GetPlayerUid()
    self.RewardDatas = require "BlackSourceModel":GetInstance():GetRankRewardData()
    self:InitToggle()
    self.gameObject:SetActiveE(1)
    if type then
        self.go_table.toggle_reward.isOn = true
    elseif self.go_table.toggle_zoneRank:GetActiveSelf() == 1 then
        self.go_table.toggle_zoneRank.isOn = true
    else
        self.go_table.toggle_rank.isOn = true
    end
end

---刷新界面
function BlackSourceRankView:RefreshPanle()
    require "BlackSourceModel":GetInstance():GetRank(
        function()
            self.playerRank = nil
            self.rankDatas = require "DungonesModel":GetInstance().rank_all_player or {}
            self.rankList = {}
            self.rewardList_Rank = {}
            _G.GameUtil.SetActiveByCondition(self.Rank.obj_no, #self.rankDatas <= 0)
            self.Rank.scrollloopvectical_rankList:UpdateCount(#self.rankDatas)
            local uid = _G.PlayerModel:GetInstance():GetPlayerUid()
            for _, v in pairs(self.rankDatas) do
                if v.uid == uid then
                    self:InitPlayer({ index = v.player_mingci, value = v.Damage })
                    break
                end
            end
            if not self.playerRank then
                require "BlackSourceModel":GetInstance():GetPlayerRank(
                    function(data)
                        self:InitPlayer(data)
                    end
                )
            end
        end
    )
end

function BlackSourceRankView:InitToggle()
    self.Toggles = {}
    self.Toggles["Rank"] =
        _G.GetAutoGoTable(
            self.go_table.toggle_rank,
            _G.handlerbind(self, self.OnToggle, "Rank", _G.handler(self, self.OnRank))
        )
    self.Toggles["Reward"] =
        _G.GetAutoGoTable(
            self.go_table.toggle_reward,
            _G.handlerbind(self, self.OnToggle, "Reward", _G.handler(self, self.OnReward))
        )
    self.go_table.toggle_zoneRank:SetActiveE(1)
    self.Toggles["ZoneRank"] =
        _G.GetAutoGoTable(
            self.go_table.toggle_zoneRank,
            _G.handlerbind(self, self.OnToggle, "ZoneRank", _G.handler(self, self.OnZoneRank))
        )
    self.go_table.toggle_rank:SetActiveE(0)
end

---点击Togggle
function BlackSourceRankView:OnToggle(go, isOn, key, call)
    local tb = self.Toggles[key]
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOff, not isOn)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, isOn)
    if call then
        call(isOn)
    end
end

---大区排行
function BlackSourceRankView:OnZoneRank(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_ZoneRank, isOn)
    if not isOn then
        return
    end
    if not self.ZoneRank then
        local name = "UI/ZoneRank/$_obj_zoneRank"
        _G.PoolsManager:GetInstance():Spawn(
            name,
            _G.ePoolType.Temporary,
            self.go_table.obj_ZoneRank,
            function(trans)
                _G.GameUtil.SetActiveByCondition(trans, true)
                local view = self:AddComponent(trans.gameObject, require "ZoneRankView".New(trans, self))
                view:InitView(_G.ZoneRankType.BlackSource, nil, self.RewardDatas)
                self.ZoneRank = view
            end
        )
    end
end

---排行
function BlackSourceRankView:OnRank(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Rank, isOn)
    if not isOn then
        return
    end
    if not self.Rank then
        self.Rank = _G.GetAutoGoTable(self.go_table.obj_Rank)
        _G.GameUtil.SetActiveByCondition(self.Rank.obj_yiwu, false)
        require "BlackSourceModel":GetInstance():GetRank(
            function()
                self.playerRank = nil
                self.rankDatas = require "DungonesModel":GetInstance().rank_all_player or {}
                self.rankList = {}
                self.rewardList_Rank = {}
                _G.GameUtil.SetActiveByCondition(self.Rank.obj_no, #self.rankDatas <= 0)
                _G.GameUtil.SetActiveByCondition(self.gameObject, true)
                self.Rank.scrollloopvectical_rankList:InitItemData(#self.rankDatas, _G.handler(self, self.RefreshRank))
                local uid = _G.PlayerModel:GetInstance():GetPlayerUid()
                for _, v in pairs(self.rankDatas) do
                    if v.uid == uid then
                        self:InitPlayer({ index = v.player_mingci, value = v.Damage })
                        break
                    end
                end
                if not self.playerRank then
                    require "BlackSourceModel":GetInstance():GetPlayerRank(
                        function(data)
                            self:InitPlayer(data)
                        end
                    )
                end
            end
        )
    end
end

function BlackSourceRankView:HeadClick(go, ref, tb)
    local data = tb.rankData
    local name = go:GetName()
    if name == "@_aorbtn_HeadClick" then
        if data.uid and data.uid > 0 then
            if data.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.PopWindowManager:GetInstance():ShowAllTips(620109)
            else
                _G.SystemSettingManager:GetInstance():OpenView(data.uid)
            end
        end
    elseif name == "@_aorbtn_huifang" then
        -- require "BlackSourceModel":GetInstance():PlayRecord(data.uid)
        require "DungonesModel":GetInstance():PlayRankHuiFang(60, data.uid)
    end
end

---刷新排行
function BlackSourceRankView:RefreshRank(index, obj)
    local newindex = index + 1
    local instanceID = obj:GetInstanceIDE()
    local tb = self.rankList[instanceID]
    if not self.rankList[instanceID] then
        tb = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.HeadClick, tb))
        self.rankList[instanceID] = tb
        -- self.rankList[instanceID].scrollloophorizontal_AwardList:InitItemData(
        --     0,
        --     _G.handlerbind(self, self.RefreshReward, self.rewardList_Rank, self.rankList[instanceID])
        -- )
    end
    local tb = self.rankList[instanceID]
    local data = self.rankDatas[newindex]
    tb.rankData = data
    tb.data = self:GetRankData(newindex)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_rankBg, newindex <= 3)
    _G.GameUtil.SetActiveByCondition(tb.obj_rankBg2, newindex > 3)
    if newindex <= 3 then
        tb.aorimage_rankBg.SpriteName = "tz_qjhs_di_0" .. (newindex + 1)
        tb.aorimage_rank.SpriteName = "tz_qjhs_phb_mingci_0" .. newindex
    else
        tb.aortext_rankNum.text = newindex
    end
    if tb.rankData.uid == self.playerUid then
        tb.aortext_name.text = _G.PlayerModel:GetInstance():GetName()
        UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data, 1, true, true, true)
    else
        tb.aortext_name.text = data.playerName
        UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data, 1, true, true, true)
    end
    tb.aortext_damage.text = _G.GameUtil.NumberToUnitStr(data.Damage)
    if not tb.list then
        tb.list = {}
    end
    if tb.data then
        -- self:ShowAward(tb, tb.obj_item, tb.data.rewards)
    end

    self:ShowTeam(tb.trans_cardnode, data)
    if self.IsHuiFang and tb.aorbtn_huifang then
        tb.aorbtn_huifang:SetActiveE(0)
    end
end

---判断是否显示回放按钮
function BlackSourceRankView:IsBool()
    local EmbattleView = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.EmbattleView.Name)
    local BattleView = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    local ShowAwardWithButtonView = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg
        .ShowAwardWithButtonView.Name)
    if EmbattleView or BattleView or ShowAwardWithButtonView then
        self.IsHuiFang = true
    end
end

function BlackSourceRankView:ShowTeam(parent, data)
    if parent:GetChildCountE() > 0 then
        for i = 1, parent:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(parent:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    local teamcard = data:GetTeamCard()
    for i = 1, 5 do
        if teamcard[i] then
            local data = teamcard[i]
            -- _G.StorageManager:GetInstance():GetItemBaseView(
            --     teamcard[i].sid,
            --     nil,
            --     parent,
            --     function(item)
            --         --item:Show(data)
            --     end
            -- )
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.ItemCardStorageView,
                parent,
                function(item)
                    item:Show(data.sid, nil, data.star, nil, data.lv)
                end
            )
        end
    end
end

function BlackSourceRankView:ShowAward(tb, obj, award)
    if not tb.list then
        tb.list = {}
    end
    local count = #tb.list
    local count2 = #award
    for i = 1, count do
        if i <= count2 then
            tb.list[i]:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(award[i]))
            _G.GameUtil.SetActiveByCondition(tb.list[i].gameObject, true)
        else
            _G.GameUtil.SetActiveByCondition(tb.list[i].gameObject, false)
        end
    end
    if count < count2 then
        for i = count + 1, count2 do
            local obj2 = _G.InstantiateObject(obj)
            obj2:SetParentE(tb.trans_Content)
            local item = require "BaseAwardNewItem".New(obj2, nil, 73, obj2:GetChildE(0))
            tb.list[i] = item
            local data = award[i]
            item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
        end
    end
end

function BlackSourceRankView:GetRankData(index)
    if index <= 0 then
        return
    end
    for _, v in ipairs(self.RewardDatas) do
        if index >= v.min_rank and index <= v.max_rank then
            return v
        end
    end
    return nil
end

---显示玩家排行
function BlackSourceRankView:InitPlayer(data)
    self.playerRank = data
    if not self.player then
        self.player =
            _G.GetAutoGoTable(
                self.Rank.obj_player,
                _G.handlerbind(self, self.HeadClick, { rankData = { uid = _G.PlayerModel:GetInstance():GetPlayerUid() } })
            )
        -- self.player.scrollloophorizontal_AwardList:InitItemData(
        --     0,
        --     _G.handlerbind(self, self.RefreshReward, self.rewardList_Rank, self.player)
        -- )
    end
    local tb = self.player
    local newindex = self.playerRank.index
    tb.data = self:GetRankData(newindex)
    if newindex == 0 then
        tb.aortext_rankNum.text = _G.LangUtil.GetLangPackValue(90022900040)
    else
        tb.aortext_rankNum.text = newindex
    end
    local PlayerModel = _G.PlayerModel:GetInstance()
    local playerData = {}
    tb.aortext_name.text = PlayerModel:GetName()
    playerData.style = PlayerModel:GetRoleStyle()
    playerData.frame = PlayerModel:GetCurFrame()
    playerData.lv = PlayerModel:GetLevel()
    playerData.title = PlayerModel:GetTitle()
    playerData.uid = PlayerModel:GetPlayerUid()
    tb.aortext_damage.text = _G.GameUtil.NumberToUnitStr(_G.math.floor(self.playerRank.value))
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, playerData, 1, true, true, true)
    if tb.data then
        self:ShowAward(tb, tb.obj_item, tb.data.rewards, tb.obj_item:GetChildE(0))
    else
        self:ShowAward(tb, tb.obj_item, {}, tb.obj_item:GetChildE(0))
    end
end

---刷新奖励
function BlackSourceRankView:RefreshReward(index, obj, list, tb)
    local newIndex = index + 1
    local instanceID = obj:GetInstanceIDE()
    local data = tb.data.reward_daily[newIndex]
    local item = list[instanceID]
    if not item then
        item = require "BaseAwardNewItem".New(obj, _G.handler(self, self.OnClickAward), 73, obj)
        list[instanceID] = item
    end
    item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))
end

