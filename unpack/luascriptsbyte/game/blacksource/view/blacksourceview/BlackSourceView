---@class BlackSourceView : UIBaseView	中文描述
---@field public go_table BlackSourceView_GoTable GoTable
---@field SkillItems BlackSourceView._obj_skill1_GoTable[]
---@field BossItems BlackSourceView._obj_boss1_GoTable[]
---@field refreshViewTimer Timer        @界面刷新定时器
local BlackSourceView = _G.BaseClass("BlackSourceView", _G.UIBaseView)
--_G.BlackSourceView = BlackSourceView
local BlackSourceModel = require "BlackSourceModel"
local trans = {
    [1] = {pos = {}, scale = {}, suoScale = {}, font = {}}
}
local CS = _G.CS
local typeof = _G.typeof
local GetLangPackValue = _G.GetLangPackValue
function BlackSourceView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    --添加倒计时定时器(跳过战斗解锁可配置时间)
    if not self:IsShowSkipBattle() then
        self.refreshViewTimer =
            _G.TimerManager:GetInstance():GetTimer(1, self.RefreshSkipBattleState, self, false, true)
        self.refreshViewTimer:Start()
    end
end
function BlackSourceView:OnDestroy()
    if self.refreshViewTimer then
        self.refreshViewTimer:Stop()
        self.refreshViewTimer = nil
    end
end

---界面的入口函数
function BlackSourceView:OnCreate()
    BlackSourceModel:GetInstance():SaveFist()
    BlackSourceModel = require "BlackSourceModel"
    self.curOrder = BlackSourceModel:GetInstance().curOrder
    self.curBossId = BlackSourceModel:GetInstance():GetCurBossId()
    self.index = self.curOrder
    self.lockId = _G.ConfigManager.discrete_cfg[108006][1][1]
    self.SkillItems = {}
    self.BossItems = {}
    self.max = #_G.ConfigManager.discrete_cfg[108002][1]
    self.ani = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    self:ChangeShow(0)
    self:UpdateTime(BlackSourceModel:GetInstance():TranslateSecond(BlackSourceModel:GetInstance():GetRTS()))
    _G.SetEventTrigger(self.go_table.obj_drag, "onDragBegin", _G.handler(self, self.onDragBegin))
    _G.SetEventTrigger(self.go_table.obj_drag, "onDragEnd", _G.handler(self, self.onDragEnd))
    _G.SetEventTrigger(self.go_table.obj_drag, "onClick", _G.handler(self, self.OnClick))
    self:AddListener(_G.eBlackSource.RefreshTime, self.UpdateTime)
    self:AddListener(_G.eBlackSource.RefreshPanel, self.UpdatePanel2)
    self:AddListener(_G.eBlackSource.RefreshFightTimes, self.UpdateFightTimes)
    self:AddComponent(
        self.go_table.obj_glod,
        require("ResourceCompont").New(self.go_table.obj_glod, _G.ConfigManager.ui_cfg.BlackSourceView.resources)
    )
    self:InitEffect()
    self.delay =
        _G.DelayDo(
        0.6,
        function()
            self.ani:Play("2")
            self.delay = nil
        end
    )
    self.go_table.obj_inforedpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.CopyExplain.id,209)

    self:RefreshSkipBattleState()
end

function BlackSourceView:InitEffect()
    -- body
end

---更新界面
function BlackSourceView:UpdatePanel()
    self.go_table.aortext_damage.text = _G.GameUtil.NumberToUnitStrFight(BlackSourceModel:GetInstance():GetDamage())
    if self.bossId then
        self.go_table.aortext_content.text = GetLangPackValue(_G.ConfigManager.guild_boss_cfg[self.bossId].desc)
    end
    local isCur = self.bossId == BlackSourceModel:GetInstance():GetCurBossId()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_max, isCur)
    self:UpdateFightTimes()
    self:UpdateSkill()
    self:UpdateBossShow()
    self.go_table.aorbtn_FightStart:SetGray(not isCur)
    self.go_table.aorrawimage_tiaozhan:SetGray(not isCur)
    self.go_table.obj_redPoint:SetActiveE(isCur and 1 or 0)
end

function BlackSourceView:UpdatePanel2()
    self.curOrder = BlackSourceModel:GetInstance().curOrder
    self.curBossId = BlackSourceModel:GetInstance():GetCurBossId()
    self.index = self.curOrder
    self:ChangeShow(0)
    self:UpdateTime(BlackSourceModel:GetInstance():TranslateSecond(BlackSourceModel:GetInstance():GetRTS()))
end

---更新挑战次数
function BlackSourceView:UpdateFightTimes()
    local num = BlackSourceModel:GetInstance():GetFightNum()
    if num == 0 then
        --TODO 数量为0变成红色
        self.go_table.aortext_fightNum.text = _G.string.AddColor(num, "e33f3f")
    else
        self.go_table.aortext_fightNum.text = num
    end
end

---更新时间
function BlackSourceView:UpdateTime(_, time)
    if BlackSourceModel:GetInstance():IsSettlement() then
        self.go_table.aortext_time.text = GetLangPackValue(90000010292)
    else
        self.go_table.aortext_time.text =
            GetLangPackValue(90000000996, BlackSourceModel:GetInstance():TranslateSecond(time - 3600))
    end
    self:UpdateBossTime(time)
end
---更新Boss显示
function BlackSourceView:UpdateBossShow()
    for i = 1, 4 do
        if not self.BossItems[i] then
            self.BossItems[i] = _G.GetAutoGoTable(self.go_table["obj_boss" .. i])
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_shuijingxunhuan,
                self.BossItems[i].trans_effect,
                function(trans)
                    if self:IsNil() then
                        _G.DestroyObject(trans)
                    end
                end
            )
        end

        self:UpdateSingleBoss(self.BossItems[i], i)
    end
end
---更新单个boss BlackSourceView._obj_boss2_GoTable
---@param tb BlackSourceView._obj_boss1_GoTable
function BlackSourceView:UpdateSingleBoss(tb, itemIndex)
    _G.GameUtil.SetActiveByCondition(tb.obj_mask, false)
    local index = self.index + itemIndex - 1 > 4 and self.index + itemIndex - 5 or self.index + itemIndex - 1
    local id = BlackSourceModel:GetInstance():GetBossId(index)
    tb.isCur = id == self.curBossId
    tb.id = id
    _G.GameUtil.SetActiveByCondition(tb.obj_mask, not tb.isCur)
    if id then
        ---@type guild_boss_cfg
        local cfg = _G.ConfigManager.guild_boss_cfg[id]
        ---@type monster_cfg
        tb.aortext_name.text = GetLangPackValue(cfg.name)
        tb.aorrawimage_bg:LoadImage(cfg.icon)
        tb.aorrawimage_bgMask:LoadImage(cfg.icon .. "_2")
    else
        tb.aortext_name.text = GetLangPackValue(90022500400)
    end
    if not tb.isCur and itemIndex ~= 3 then
        if id ~= self.lockId then
            local time = BlackSourceModel:GetInstance():GetRTS()
            if id < BlackSourceModel:GetInstance():GetCurBossId() then
                tb.aortext_time.text =
                    _G.string.format(
                    "%s后来袭",
                    BlackSourceModel:GetInstance():TranslateSecond(
                        time +
                            _G.math.max(BlackSourceModel:GetInstance().maxOrder - self.curOrder - 1 + index, 0) * 2 *
                                86400
                    )
                )
            else
                tb.aortext_time.text =
                    _G.string.format(
                    "%s后来袭",
                    BlackSourceModel:GetInstance():TranslateSecond(
                        time + _G.math.max((index - self.curOrder - 1), 0) * 2 * 86400
                    )
                )
            end
        else
            tb.aortext_time.text = GetLangPackValue(90000010319)
        end
        _G.GameUtil.SetActiveByCondition(tb.obj_time, true)
    else
        _G.GameUtil.SetActiveByCondition(tb.obj_time, false)
    end
end

function BlackSourceView:UpdateBossTime(time)
    for i = 1, 4 do
        local index = self.index + i - 1 > 4 and self.index + i - 5 or self.index + i - 1
        if not self.BossItems[i].isCur and i ~= 3 and self.BossItems[i].id ~= self.lockId then
            if self.BossItems[i].id < BlackSourceModel:GetInstance():GetCurBossId() then
                self.BossItems[i].aortext_time.text =
                    _G.string.format(
                    "%s后来袭",
                    BlackSourceModel:GetInstance():TranslateSecond(
                        time +
                            _G.math.max(BlackSourceModel:GetInstance().maxOrder - self.curOrder - 1 + index, 0) * 2 *
                                86400
                    )
                )
            else
                self.BossItems[i].aortext_time.text =
                    _G.string.format(
                    "%s后来袭",
                    BlackSourceModel:GetInstance():TranslateSecond(
                        time + _G.math.max((index - self.curOrder - 1), 0) * 2 * 86400
                    )
                )
            end
        end
    end
end

---按钮点击事件在这里派发
function BlackSourceView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_award then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BlackSourceRankView.Name, true)
    elseif go == self.go_table.aorbtn_rank then
        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BlackSourceRankView.Name)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonRankView.Name, _G.CommonRankType.BlackSource)
    elseif go == self.go_table.aorbtn_FightStart then
        --是否满足跳过战斗开启条件
        local showSkipBattle = self:IsShowSkipBattle()

        require "BlackSourceModel":GetInstance():OnFightBoss(self.bossId, self.index, showSkipBattle)
    elseif go == self.go_table.aorbtn_next then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BlackSourceForeshowView.Name)
    elseif go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_PlayDescribe then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 40)
    elseif go == self.go_table.aorbtn_battle then
        require "BlackSourceModel":GetInstance():OpenBlackSourceReportPanel()
    elseif go == self.go_table.aorbtn_info then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WorldBossIntroduceView.Name,209,self.curOrder)
    end
end
---刷新跳过战斗状态
---@return void
function BlackSourceView:RefreshSkipBattleState()
    --读取解锁配置并显示文本
    local params = _G.ConfigManager.discrete_cfg[115605]
    if not params then
        self.go_table.obj_skipBg:SetActiveE(0)
        return
    end
    local ok, content = _G.GlobalConditionManager.CheckConditionArraysCustomUnlockTip(params)
    if ok then
        self.go_table.obj_skipBg:SetActiveE(0)
        return
    end
    if content then
        self.go_table.aortext_skipTip.text = content
    end
    self.go_table.obj_skipBg:SetActiveE(content and 1 or 0)
end
---是否显示跳过战斗按钮
---@return boolean
function BlackSourceView:IsShowSkipBattle()
    local params = _G.ConfigManager.discrete_cfg[115605]
    if not params then
        return false
    end
    local ok = _G.GlobalConditionManager.CheckConditionArrays(params)
    return ok
end

---更新技能显示
function BlackSourceView:UpdateSkill()
    if self.bossId then
        ---@type guild_boss_cfg
        local cfg = _G.ConfigManager.guild_boss_cfg[self.bossId]
        local id
        ---@type card_skills_cfg
        local skillCfg
        for i = 1, 4 do
            local tb = self.SkillItems[i]
            if not tb then
                tb = _G.GetAutoGoTable(self.go_table["obj_skill" .. i], _G.handlerbind(self, self.OnClickSkill, i))
                self.SkillItems[i] = tb
            end
            id = cfg.skill[i]
            skillCfg = _G.ConfigManager.card_skills_cfg[id]
            if id then
                tb.aorrawimage_icon:LoadImage(skillCfg.icon)
                _G.GameUtil.SetActiveByCondition(tb.gameObject, true)
            else
                _G.GameUtil.SetActiveByCondition(tb.gameObject, false)
            end
        end
    else
        for i = 1, 4 do
            local tb = self.SkillItems[i]
            if not tb then
                tb = _G.GetAutoGoTable(self.go_table["obj_skill" .. i], _G.handlerbind(self, self.OnClickSkill, i))
                self.SkillItems[i] = tb
            end
            _G.GameUtil.SetActiveByCondition(tb.gameObject, false)
        end
    end
end
---点击技能
function BlackSourceView:OnClickSkill(go, isOn, index)
    local cfg = _G.ConfigManager.guild_boss_cfg[self.bossId]
    require "CommonTipManager":GetInstance():OpenSkillTip(cfg.skill[index])
end
---拖拽开始
function BlackSourceView:onDragBegin(_, ed)
    self.Rotate_startPoint = ed.position.x
end

---拖拽结束
function BlackSourceView:onDragEnd(_, ed)
    if self.Rotate_startPoint < ed.position.x then
        self:ChangeShow(-1)
    else
        self:ChangeShow(1)
    end
end

function BlackSourceView:OnClick(_, ed)
    if 123 < ed.position.x and ed.position.x < 315 and 289 < ed.position.y and ed.position.y < 551 then
        self:ChangeShow(-1)
    elseif 954 < ed.position.x and ed.position.x < 1139 and 351 < ed.position.y and ed.position.y < 594 then
        self:ChangeShow(1)
    end
end

---更改显示
function BlackSourceView:ChangeShow(num)
    self.index = self.index + num
    if self.index > 4 then
        self.index = self.index - 4
    elseif self.index < 1 then
        self.index = 4 - self.index
    end
    self.bossId = BlackSourceModel:GetInstance():GetBossId(self.index)
    self:UpdatePanel()
end
function BlackSourceView:OnStartClose()
    if self.delay then
        _G.coroutine.stopwaiting(self.delay)
        self.delay = nil
    end
end
return BlackSourceView
