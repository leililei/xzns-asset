---@class BlackSourceForeshowView : UIBaseView	中文描述
---@field public go_table BlackSourceForeshowView_GoTable GoTable
local BlackSourceForeshowView = _G.BaseClass("BlackSourceForeshowView", _G.UIBaseView)
--_G.BlackSourceForeshowView = BlackSourceForeshowView

function BlackSourceForeshowView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function BlackSourceForeshowView:OnCreate()
    self:AddListener(_G.eBlackSource.RefreshPanel, self.UpdatePanel)
    self:AddListener(_G.eBlackSource.RefreshTime, self.UpdateTime)
    self:UpdatePanel()
end

function BlackSourceForeshowView:UpdatePanel()
    self.SkillItems = {}
    self.bossId = require "BlackSourceModel":GetInstance():GetNextBossId()
    ---@type guild_boss_cfg
    self.bossCfg = _G.ConfigManager.guild_boss_cfg[self.bossId]
    self.go_table.aortext_time.text =
        _G.LangUtil.GetLangPackValue(90023620006, require "BlackSourceModel":GetInstance():TranslateSecond())
    self.go_table.aortext_content.text = _G.LangUtil.GetLangPackValue(self.bossCfg.desc)
    self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(self.bossCfg.name)
    self.go_table.aorrawimage_boss:LoadImage(self.bossCfg.photo)
    self:UpdateSkill()
end

function BlackSourceForeshowView:UpdateTime(time)
    self.go_table.aortext_time.text = _G.LangUtil.GetLangPackValue(90023620006, time)
end

function BlackSourceForeshowView:UpdateSkill()
    local id
    ---@type card_skills_cfg
    local skillCfg
    for i = 1, 4 do
        local tb = self.SkillItems[i]
        if not tb then
            tb = _G.GetAutoGoTable(self.go_table["obj_skill" .. i], _G.handlerbind(self, self.OnClickSkill, i))
            self.SkillItems[i] = tb
        end
        id = self.bossCfg.skill[i]
        skillCfg = _G.ConfigManager.card_skills_cfg[id]
        if id then
            tb.aorrawimage_icon:LoadImage(skillCfg.icon)
            tb.gameObject:SetActiveE(1)
        else
            tb.gameObject:SetActiveE(0)
        end
    end
end

---点击技能
function BlackSourceForeshowView:OnClickSkill(go, isOn, index)
    local cfg = _G.ConfigManager.guild_boss_cfg[self.bossId]
    require "CommonTipManager":GetInstance():OpenSkillTip(cfg.skill[index])
end

---按钮点击事件在这里派发
function BlackSourceForeshowView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

return BlackSourceForeshowView
