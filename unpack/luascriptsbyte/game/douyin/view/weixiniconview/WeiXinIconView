---@class WeiXinIconView : UIBaseView	中文描述
---@field public go_table WeiXinIconView_GoTable GoTable
---@field model DouyinModel
local WeiXinIconView = _G.BaseClass("WeiXinIconView", _G.UIBaseView)

function WeiXinIconView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function WeiXinIconView:OnCreate(info)
    self.info = info
    self.model = require "DouyinModel":GetInstance()
    self:FreshView()
    self.model:GetOnShowRes(_G.handler(self, self.FreshView))
    local id = 124011

    for key, value in ipairs(_G.ConfigManager.discrete_cfg[id]) do
        local item = require "BaseAwardNewItem".New(self.go_table.obj_item, nil, 83.6)
        item:ShowWithID(value)
    end
end

function WeiXinIconView:FreshView()
    if self:IsNil() then
        return
    end
    local Cfg = _G.GameUtil.GetFunctionData(_G.FunctionBlock.CollectBg)
    if Cfg ~= "" then
        self.go_table.aorrawimage_img1:LoadImage(
            Cfg,
            function(image)
                if image then
                    image:SetActiveE(1)
                    image:SetNativeSize()
                end
            end
        )
    end
end

function WeiXinIconView:CloseView()
    self:Close()
end

---按钮点击事件在这里派发
function WeiXinIconView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_close then
        self.model:GetAward({ 124011 }, _G.handler(self, self.GetWeixinCallBack))
    elseif go == self.go_table.aorbtn_go then
        self.model:GetAward({ 124011 }, _G.handler(self, self.GetWeixinCallBack))
    end
end

function WeiXinIconView:GetWeixinCallBack()
    _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.WeiXinShow)
    self:Close()
end

function WeiXinIconView:OnDestroy()
end

return WeiXinIconView
