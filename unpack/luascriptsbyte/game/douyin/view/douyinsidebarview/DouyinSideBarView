---@class DouyinSideBarView : UIBaseView	中文描述
---@field public go_table DouyinSideBarView_GoTable GoTable
---@field model DouyinModel
local DouyinSideBarView = _G.BaseClass("DouyinSideBarView", _G.UIBaseView)

local SDKDef = require("SDKDef")
---打开侧边栏/打开游戏中心
---@type table<number,number>
local GameChannelTxt1T = {
    [_G.Platform.DouYin] = 90032900015,
    [_G.Platform.DouYinIos] = 90032900015,
    [_G.Platform.Alipay] = 90032900034,
}
---是否显示文本小图标
---@type table<number,number>
local GameChannelIcon1ActiveT = {
    [_G.Platform.DouYin] = true,
    [_G.Platform.DouYinIos] = true,
    [_G.Platform.Alipay] = false,
}

---第一张图片
---@type table<number,string>
local GameChannelImg1T = {
    [_G.Platform.DouYin] = "ImagesH5/hDouyin/ui_rkyl_dyjt_1",
    [_G.Platform.DouYinIos] = "ImagesH5/hDouyin/ui_rkyl_dyjt_1",
    [_G.Platform.Alipay] = "ImagesH5/hDouyin/ui_rkyl_zfb_1",
}

---第二张图片
---@type table<number,string[]>
local GameChannelImg2T = {
    [_G.Platform.DouYin] = { "ImagesH5/hDouyin/ui_rkyl_dyjt_2", "ImagesH5/hDouyin/ui_rkyl_dyjt_3" },
    [_G.Platform.DouYinIos] = { "ImagesH5/hDouyin/ui_rkyl_dyjt_2", "ImagesH5/hDouyin/ui_rkyl_dyjt_3" },
    [_G.Platform.Alipay] = { "ImagesH5/hDouyin/ui_rkyl_zfb_2", "ImagesH5/hDouyin/ui_rkyl_zfb_2" }, --目前只有"勇者之轮"上了支付宝
}

function DouyinSideBarView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function DouyinSideBarView:OnCreate(info)
    self.info = info
    self.model = require "DouyinModel":GetInstance()
    self:FreshView()
    self.model:GetOnShowRes(_G.handler(self, self.FreshView))
    self.go_table.obj_item:ClearChildren()
    local id = self.model:GetDouyinSideBarFirstAwardBol() and 124003 or 124010
    local award = _G.ConfigManager.discrete_cfg[id]
    if self.model:GetIsDouYinArraigned() then
        if _G.AppSetting.ArraignedType == _G.ArraignedStartType.TakeOut then
            award =  { { 601, 1 } }
        elseif _G.AppSetting.ArraignedType == _G.ArraignedStartType.SwordCasual then
            award =  { { 606, 1 } }
        end
    end
    for key, value in ipairs(award) do
        local item = require "BaseAwardNewItem".New(self.go_table.obj_item, nil, 83.6)
        item:ShowWithID(value)
    end
    _G.SDKManager:GetInstance():FollowUpReport(SDKDef.GameLauncher.ShowView)
end

function DouyinSideBarView:FreshView()
    if self:IsNil() then
        return
    end
    ---@type number
    local platform = _G.GameUtil:GetPlatform()
    ---@type number
    local channelIndex = _G.AppSetting.GameChannel == "YZZL" and 2 or 1

    local txt1 = GameChannelTxt1T[platform]
    self.go_table.aortext_tip1.text = _G.GetLangPackValue(txt1 or 0)

    local icon1 = GameChannelIcon1ActiveT[platform]
    self.go_table.obj_tip1Icon:SetActiveE(icon1 and 1 or 0)

    if _G.AppSetting.GameChannel == "YZZL" then
        self.go_table.aortext_tip2.text = _G.GetLangPackValue(90032900016)
    elseif _G.tonumber(_G.SDKManager:GetInstance():GetChannelId()) == require("PlatformDef").PlatformIdDef.RKDouYin then
        self.go_table.aortext_tip2.text = _G.GetLangPackValue(34025161412)
    elseif _G.tonumber(_G.SDKManager:GetInstance():GetChannelId()) == require("PlatformDef").PlatformIdDef.MQDouYin then
        self.go_table.aortext_tip2.text = _G.GetLangPackValue(90034713008)
    else
        self.go_table.aortext_tip2.text = _G.GetLangPackValue(90032900017)
    end

    local img1 = GameChannelImg1T[platform]
    self.go_table.aorrawimage_img1:LoadImage(
        img1 or "",
        function(image)
            if image then
                image:SetActiveE(1)
                image:SetNativeSize()
            end
        end
    )
    local img2 = GameChannelImg2T[platform]
    local path = _G.GameUtil.GetFunctionData(_G.FunctionBlock.CollectBg)
    if path == "" then
        path = img2 and (img2[channelIndex] or img2[1]) or ""
    end
    self.go_table.aorrawimage_img2:LoadImage(
        path,
        function(image)
            if image then
                image:SetActiveE(1)
                image:SetNativeSize()
            end
        end
    )

    self.isDouyinArraigned = self.model:GetIsDouYinArraigned()
    if self.isDouyinArraigned then
        self.go_table.aorbtn_go:SetActiveE(self.model:CheckReturnBySideBar() and 0 or 1)
        self.go_table.aortext_tip3.text = _G.GetLangPackValue(90034713004)
    end
    local txt = (self.model:CheckReturnBySideBar() and not self.model:GetDouyinSideBarAwardBol()) and 90027500003 or
        90022200010
    self.go_table.aortext_BtnMiddleName.text = _G.GetLangPackValue(txt)
end

function DouyinSideBarView:CloseView()
    if self:IsNil() then
        return
    end
    self:Close()
end

---按钮点击事件在这里派发
function DouyinSideBarView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_go then
        if self.model:CheckReturnBySideBar() and not self.model:GetDouyinSideBarAwardBol() then
            local id = self.model:GetDouyinSideBarFirstAwardBol() and 124003 or 124010
            self.model:GetAward({ id }, _G.handler(self, self.GetAwardCallBack))
        else
            _G.SDKManager:GetInstance():FollowUpReport(SDKDef.GameLauncher.ClickSetting)
            self.model:NavigateToScene(_G.handler(self, self.CloseView))
        end
    end
end

function DouyinSideBarView:GetAwardCallBack()
    _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.DouyinSideBar)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.DouYinSide.id)
    self:Close()
    _G.SDKManager:GetInstance():FollowUpReport(SDKDef.GameLauncher.GetAward)
end

function DouyinSideBarView:OnDestroy()
end

return DouyinSideBarView
