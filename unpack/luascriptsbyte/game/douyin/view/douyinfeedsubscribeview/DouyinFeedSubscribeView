---@class DouyinFeedSubscribeView : UIBaseView	抖音直流订阅
---@field public go_table DouyinFeedSubscribeView_GoTable GoTable
---@field public DouYinFeedImp DouYinFeedImp 抖音直流接口
local DouyinFeedSubscribeView = _G.BaseClass("DouyinFeedSubscribeView", _G.UIBaseView)

local imgRes = {
    xy = "ImagesH5/hDouyin/ui_dyrk_xingyao_img",
    my = "ImagesH5/hDouyin/ui_dyrk_miaoyue_img",
    rk = "ImagesH5/hDouyin/ui_dyrk_ruikun_img"
}

function DouyinFeedSubscribeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function DouyinFeedSubscribeView:OnCreate()
    self:InitBtn()
    self:RefreshView()
end

---初始化按钮状态
function DouyinFeedSubscribeView:InitBtn()
    local info = require("DouyinModel"):GetInstance():GetFeedInfo()
    if not info or not info.active then
        self.go_table.aortext_BtnMiddleName.text = _G.GetLangPackValue(90023800162)
    else
        self.go_table.aortext_BtnMiddleName.text = _G.GetLangPackValue(90000011482)
    end
end

function DouyinFeedSubscribeView:RefreshView()
    local imgPath = imgRes.xy
    if _G.tonumber(_G.SDKManager:GetInstance():GetChannelId()) == require("PlatformDef").PlatformIdDef.MYDouYin then
        imgPath = imgRes.my
    elseif _G.tonumber(_G.SDKManager:GetInstance():GetChannelId()) == require("PlatformDef").PlatformIdDef.RKDouYin then
        imgPath = imgRes.rk
    end
    self.go_table.aorrawimage_img1:LoadImage(imgPath)

    for _, value in ipairs(_G.ConfigManager.discrete_cfg[124015]) do
        local item = require "BaseAwardNewItem".New(self.go_table.obj_item, nil, 83.6)
        item:ShowWithID(value)
    end
end

---界面的销毁函数
function DouyinFeedSubscribeView:OnDestroy()
end

---按钮点击事件在这里派发
function DouyinFeedSubscribeView:OnClickBtn(go)
    if go == self.go_table.aorbtn_go then
        local info = require("DouyinModel"):GetInstance():GetFeedInfo()
        if not info or not info.active then
            require("DouyinModel"):GetInstance():RequestFeedSubscribe(function(ret)
                if ret then
                    self:InitBtn()
                else
                    self:Close()
                end
            end)
        else
            require("DouyinModel"):GetInstance():GetAward({ 124015 }, function()
                self:Close()
            end)
        end
    end
end

return DouyinFeedSubscribeView
