function DouyinIconView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function DouyinIconView:OnCreate(info)
    self.info = info
    self.model = require "DouyinModel":GetInstance()
    self:FreshView()
    self.model:GetOnShowRes(_G.handler(self, self.FreshView))
    local id = self.model:GetDouyinAppIconFirstAwardBol() and 124004 or 124011
    if _G.GameUtil:GetPlatform() == _G.Platform.WeiXin then
        id = 124011
    end
    for key, value in ipairs(_G.ConfigManager.discrete_cfg[id]) do
        local item = require "BaseAwardNewItem".New(self.go_table.obj_item, nil, 83.6)
        item:ShowWithID(value)
    end

    _G.SDKManager:GetInstance():SetHeadReport(SDKDef.GameLauncher.ShowView)
end

function DouyinIconView:FreshView()
    if self:IsNil() then
        return
    end
    ---@type number
    local platform = _G.GameUtil:GetPlatform()
    ---@type number
    local channelIndex = _G.AppSetting.GameChannel == "YZZL" and 2 or 1

    local title = GameChannelTitleT[platform]
    self.go_table.aortext_title.text = _G.GetLangPackValue(title or 0)

    local txt1 = GameChannelTxt1T[platform]
    self.go_table.aortext_tip1.text = _G.GetLangPackValue(txt1 or 0)

    local txt2 = GameChannelTxt2T[platform]
    self.go_table.aortext_tip2.text = _G.GetLangPackValue(txt2 or 0)

    local img1 = GameChannelImg1T[platform]

    if _G.GameUtil:GetPlatform() == _G.Platform.WeiXin then
        local Cfg = _G.GameUtil.GetFunctionData(_G.FunctionBlock.CollectBg)

        if Cfg~= "" then
            self.go_table.aorrawimage_img1:LoadImage(
                Cfg,
                function(image)
                    if image then
                        image:SetActiveE(1)
                        image:SetNativeSize()
                    end
                end
            )
        end
    else
        local path = _G.GameUtil.GetFunctionData(_G.FunctionBlock.EntryGift)
        if path == "" then
            path = img1 and (img1[channelIndex] or img1[1]) or ""
        end
        self.go_table.aorrawimage_img1:LoadImage(
            path,
            function(image)
                if image then
                    image:SetActiveE(1)
                    image:SetNativeSize()
                end
            end
        )
    end



    if _G.GameUtil:GetPlatform() == _G.Platform.WeiXin then
        id = 124004
    end

    local btnTxt
    if self.model:CheckReturnByIcon() and not self.model:GetDouyinAppIconAwardBol() then
        btnTxt = 90027500003
    else
        btnTxt = GameChannelButtonT[platform]
    end
    self.go_table.aortext_BtnMiddleName.text = _G.GetLangPackValue(btnTxt or 0)
end

function DouyinIconView:CloseView()
    self:Close()
end

---按钮点击事件在这里派发
function DouyinIconView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_close then
        if _G.GameUtil:GetPlatform() == _G.Platform.WeiXin then
            self.model:GetAward({ 124011 }, _G.handler(self, self.GetWeixinCallBack))
        else
            self:Close()
        end
    elseif go == self.go_table.aorbtn_go then
        if _G.GameUtil:GetPlatform() == _G.Platform.WeiXin then
            self.model:GetAward({ 124011 }, _G.handler(self, self.GetWeixinCallBack))
        else
            if self.model:CheckReturnByIcon() and not self.model:GetDouyinAppIconAwardBol() then
                local id = self.model:GetDouyinAppIconFirstAwardBol() and 124004 or 124011
                self.model:GetAward({ id }, _G.handler(self, self.GetAwardCallBack))
            else
                local data
                if _G.AppSetting.IsAlipay then
                    --url是跳转到游戏中心设置首页链接用此链接
                    local url
                    --if _G.AppSetting.GameChannel == "YZZL" then
                    url =
                    "alipays://platformapi/startapp?appId=2021003125685383&url=https%3A%2F%2Frender.alipay.com%2Fp%2Fyuyan%2F180020010001206617%2Findex.html%3FcaprMode%3Dsync&chInfo=gamesetlattice&sms=YES&appClearTop=false"
                    --end
                    if url then
                        data = { url = url }
                    else
                        if _G.AppSetting.DEBUG then
                            _G.LogError("CreateShortcut: Alipay平台需要url参数")
                        end
                        return
                    end
                elseif _G.AppSetting.IsMeituan then
                    data = require("MeituanModel"):GetInstance():CreateShortCut()
                end
                _G.SDKManager:GetInstance():SetHeadReport(SDKDef.GameLauncher.ClickSetting)
                self.model:CreateShortcut(nil, data)
            end
        end
    end
end

function DouyinIconView:GetWeixinCallBack()
    _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.WeiXinShow)
    self:Close()
end

function DouyinIconView:GetAwardCallBack()
    _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.DouyinIcon)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.DouYinDesk.id)
    self:Close()
    _G.SDKManager:GetInstance():SetHeadReport(SDKDef.GameLauncher.GetAward)
end

function DouyinIconView:OnDestroy()
end

return DouyinIconView
