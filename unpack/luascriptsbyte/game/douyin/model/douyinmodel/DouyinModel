--奖励回调
function DouyinModel:GetAwardCallBack(msg, list, callBack)
    if msg.ack == 1 then
        --_G.PopWindowManager:GetInstance():ShowAllTips(1030001)
        _G.PlayerModel:GetInstance().desktop_award = _G.PlayerModel:GetInstance().desktop_award or {}
        local now = _G.TimeUtil.GetServerUnixTime()
        for k, v in pairs(list.sids) do
            table.insert(_G.PlayerModel:GetInstance().desktop_award, { key = v, value = now })
        end
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
        if callBack then
            callBack()
        end
    end
end

