---获取是否领取侧边栏奖励
function DouyinModel:GetDouyinSideBarAwardBol()
    self.awardID = _G.PlayerModel:GetInstance().desktop_award or {}
    local now = _G.TimeUtil.GetServerUnixTime()
    local getTime = 0
    local T = {}
    for k, v in ipairs(self.awardID) do
        if v.key == 124003 or v.key == 124010 then
            _G.table.insert(T, v)
        end
    end
    for k, v in ipairs(T) do
        getTime = getTime < v.value and v.value or getTime
    end
    if getTime ~= 0 then
        local secOfSix = _G.TimeUtil.GetDayBySix(getTime)
        if now - secOfSix < 86400 then
            return true
        end
    end
    return false
end

