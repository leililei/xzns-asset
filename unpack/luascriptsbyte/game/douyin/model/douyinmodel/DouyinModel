--region 抖音直流

---抖音直流执行器
function DouyinModel:Processor()
    if not _G.AppSetting.IsDouYin then
        return
    end

    DouYinFeedImp:Invoke(function(info)
        if _G.AppSetting.DEBUG then
            _G.LogError("Lua DouYinFeedImp:Invoke ok")
        end
        if info then
            self.feedInfoSuc = true
            self.feed = info.feed
        end
    end)
end

---抖音直流是否自动切换到afk界面
function DouyinModel:DouyinFeedScene()
    if not _G.AppSetting.IsDouYin then
        return false
    end

    if self.feedInfoSuc and self.feed then
        return true
    end
    return false
end

function DouyinModel:ReportScene()
    DouYinFeedImp:ReportScene(math.floor(_G.CS.UnityEngine.Time.realtimeSinceStartup * 1000))
end

function DouyinModel:ReportAndStoreFeed()
    if not _G.AppSetting.IsDouYin then
        return
    end

    if self.feed then
        self.feed = false
        if DouYinFeedImp.info.active then
            self:ReportScene()
        end
    end
end

---上报场景就绪事件,需要上报毫秒级时间戳
function DouyinModel:StoreFeedData(time)
    if not time then
       return
    end
    if DouYinFeedImp.info and DouYinFeedImp.info.active then
        time = (time + 3600) * 1000
        DouYinFeedImp:StoreFeedData(time)
    end
end

