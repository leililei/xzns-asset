end

---刷新红点状态
function DouyinModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.DouYinSide.id)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.DouYinDesk.id)
end

---销毁对象时,析构函数
function DouyinModel:Dispose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.isCreateShortCut = false
    self.feedSubscribe = false
    self.feedInfoSuc = false
    self.feed = false
    if _G.AppSetting.IsDouYin then
        DouYinFeedImp:OffFeedStatusChange()
    end
    DouYinFeedImp:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.OnSixClockUpdate, self)
end

return DouyinModel
