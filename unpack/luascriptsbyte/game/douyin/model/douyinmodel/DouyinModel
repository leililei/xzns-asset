--抖音是否能拉侧边栏
function DouyinModel:Douyin_checkScene(callBack)
    if _G.AppSetting.IsDouYin then
        self.callBack = callBack
        _G.SDKManager:GetInstance():Douyin_checkScene(_G.handler(self, self.Douyin_checkSceneCallBack))
    elseif _G.AppSetting.IsAlipay then
        --支付宝默认可用
        self.callBack = callBack
        self.DouyinSideBar = true
        self:GetOnShowRes()
    elseif _G.AppSetting.IsHuaWei or _G.AppSetting.IsMeituan then
        self.callBack = callBack
        self:GetOnShowRes()
    end
end

