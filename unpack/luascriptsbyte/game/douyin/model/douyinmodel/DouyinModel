---获取是否领取桌面图标奖励
function DouyinModel:GetDouyinAppIconAwardBol()
    self.awardID = _G.PlayerModel:GetInstance().desktop_award or {}
    local now = _G.TimeUtil.GetServerUnixTime()
    local getTime = 0
    local T = {}
    for k, v in ipairs(self.awardID) do
        if v.key == 124011 or v.key == 124004 then
            _G.table.insert(T, v)
            --- 指定渠道 星座女神 只要有奖励就返回true 不判断时间
            if _G.AppSetting.IsXzns  and
            _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.Collect) then
                return true
            end
        end
    end
    for k, v in ipairs(T) do
        getTime = getTime < v.value and v.value or getTime
    end
    if getTime ~= 0 then
        local secOfSix = _G.TimeUtil.GetDayBySix(getTime)
        if now - secOfSix < 86400 then
            return true
        end
    end
    return false
end

