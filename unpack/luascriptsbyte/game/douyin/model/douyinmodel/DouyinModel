---添加弹窗
function DouyinModel:AddMainFunQuene()
    if self.feedInfoSuc == nil then
        ---没有成功数据，弹出前再请求一次
        DouYinFeedImp:Invoke(function(info)
            if info and info.active ~= nil then
                self.feedInfoSuc = true
                self:AddQuene()
            end
        end)
    else
        self:AddQuene()
    end
end

function DouyinModel:AddQuene()
    if not self.feedInfoSuc then
        return
    end

    if self.feedSubscribe then
        return
    end

    local afkSid = require("AfkModel"):GetInstance().CurSid
    if not afkSid or afkSid < 102001 then
        return
    end

    ---抖音PC暂不支持订阅, 此处不要弹出
    if _G.AppSetting.IsDouYinPC or self:GetFeedSubscribeAwardBol() then
        ---为nil是没有拉取到数据
        if DouYinFeedImp.info and DouYinFeedImp.info.active == false then
            self:RequestFeedSubscribe()
        end
        return
    end

    self.feedSubscribe = true
    local MainOpenViewFunItem = {}
    MainOpenViewFunItem.OpenViewFun = function()
        _G.MainManager:GetInstance().douyinFeedSubscribe = true
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DouyinFeedSubscribeView.Name)
    end
    _G.MainManager:GetInstance():AddMainFunQueue(MainOpenViewFunItem, _G.MainViewShowOrder.BindAccountView)
end

