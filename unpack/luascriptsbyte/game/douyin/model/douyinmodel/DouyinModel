function DouyinModel:GetIsDouYinArraigned()
    if _G.GameUtil:GetPlatform() == _G.Platform.DouYin then
        if _G.AppSetting.ArraignedType == _G.ArraignedStartType.TakeOut or 
            _G.AppSetting.ArraignedType == _G.ArraignedStartType.SwordCasual 
        then
            return true
        end
    end
    return false
end

--在游戏重新回到前台时获取相关参数
function DouyinModel:GetOnShowRes(callBack)
    if _G.AppSetting.IsDouYin or _G.AppSetting.IsAlipay or _G.AppSetting.IsHuaWei or _G.AppSetting.IsMeituan then
        self.callBack = callBack
        local data
        if _G.AppSetting.IsMeituan then
            data = require("MeituanModel"):GetInstance():GetOnShowParam()
        end
        _G.SDKManager:GetInstance():GetOnShowRes(_G.handler(self, self.GetOnShowResCallBack), data)
    end
end

--回调
function DouyinModel:GetOnShowResCallBack(bol, data)
    if bol then
        local nowtime = not self:GetIsDouYinArraigned() and _G.TimeUtil.GetServerUnixTime() or 
                _G.PlayerPrefsManager.GetInt("OnShowRes", 0) + 86400--如果是提审小游戏没有登录，不能获取服务器时间
        local sixTime = _G.TimeUtil.GetDayBySix(nowtime)
        ---@type number[]
        local scenes
        if _G.AppSetting.IsDouYin then
            scenes = { tonumber(data.scene) }
        elseif _G.AppSetting.IsAlipay and data.fast_scene then
            scenes = {}
            --fast_scene返回为数组: 1是已添加首页, 2是复访(从游戏中心进去)
            if type(data.fast_scene) == "table" then
                for _, scene in pairs(data.fast_scene) do
                    local v = tonumber(scene)
                    if v then
                        table.insert(scenes, v)
                    end
                end
            else
                local v = tonumber(data.fast_scene)
                if v then
                    table.insert(scenes, v)
                end
            end
        elseif (_G.AppSetting.IsHuaWei or _G.AppSetting.IsMeituan) and data.fast_scene then
            scenes = {}
            --fast_scene为一个数组，其中存在1，则代表有设置桌面图标，无fast_scene字段或其中不包含1，则代表没有设置桌面图标
            for _, scene in pairs(data.fast_scene) do
                local v = tonumber(scene)
                if v then
                    table.insert(scenes, v)
                end
            end
        end
        if _G.PlayerPrefsManager.GetInt("OnShowRes", 0) ~= sixTime then
            self.returnData = {}
            self.returnData.scene = {}
            _G.PlayerPrefsManager.SetInt("OnShowRes", sixTime)
        else
            self.returnData = self.returnData or {}
            self.returnData.scene = _G.PlayerPrefsManager.GetTable("OnShowResTable") or {}
        end
        if _G.AppSetting.IsMeituanIos and self.isCreateShortCut then
            if not scenes then
                scenes = { 1 }
            elseif not _G.table.ContainsValue(scenes, 1) then
                _G.table.insert(scenes, 1)
            end
        end
        if scenes then
            local isChange = false
            for _, scene in ipairs(scenes) do
                if not _G.table.ContainsValue(self.returnData.scene, scene) then
                    _G.table.insert(self.returnData.scene, scene)
                    isChange = true
                end
            end
            if isChange then
                _G.PlayerPrefsManager.SetTable("OnShowResTable", self.returnData.scene)
            end
        end
        if self:CheckDouyinSideBarBtn() then
            if _G.AppSetting.IsMeituan then
                local mtView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MeiTuanSubscribeView
                    .Name)
                if mtView then
                    mtView:RefreshView()
                end
            else
                local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DouyinSideBarView.Name)
                if ctrl then
                    ctrl:FreshView()
                end
            end
        end
        if self:CheckDouyinIconView() then
            local ctrl1 = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DouyinIconView.Name)
            if ctrl1 then
                ctrl1:FreshView()
            end
        end
    else

    end
    if self.callBack then
        self.callBack()
    end
    self.callBack = nil
end

