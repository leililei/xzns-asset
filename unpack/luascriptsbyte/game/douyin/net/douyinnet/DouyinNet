local base = require("BaseGameNet")

---@class DouyinNet : BaseGameNet	通信协议
local DouyinNet = _G.BaseClass("DouyinNet", base)
---@return DouyinNet DouyinNet
function DouyinNet:GetInstance()
    return base.GetInstance(self)
end

---领取奖励
---@param pbdata table 发送数据
---@param callback function 回调方法
function DouyinNet:GetAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_role_desktop_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function DouyinNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end
return DouyinNet
