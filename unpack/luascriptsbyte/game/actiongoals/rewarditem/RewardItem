    --     data.count,
    --     self.go_table.obj_root,
    --     function(item)
    --         item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
    --     end,
    --     function(go)
    --         require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data.sid)
    --     end
    -- )
end

--region 对外接口
function RewardItem:ShowDes(data)
    if _G.IsNil(data) then
        self.go_table.gameObject:SetActiveE(0)
        return
    end
    self.go_table.gameObject:SetActiveE(1)
    self.itemData = data
    self:Show()
end
--endregion
function RewardItem:Show()
    self:UpdateIcon()
    self:UpdateItemGrade()
    self:UpdateItemCount()
    self:UpdateItemOnClick()
end
--region 更新
---物品图
function RewardItem:UpdateIcon()
    self.go_table.aorrawimage_Icon:LoadImage(self.itemData.Icon)
end
---判定是 装备 还是 物品
function RewardItem:UpdateItemCount()
    local _, storageID = _G.StorageManager:GetInstance():CheckSidType(self.itemData.sid)
    if storageID == _G.StorageID.Equipment then
        self.go_table.trans_CommonItemNum:SetActiveE(0)
    else
        self.go_table.trans_CommonItemNum:SetActiveE(1)
        _G.UIUtils.SetItemNum(self.go_table, self.itemData.count)
    end
end
---物品品质框
function RewardItem:UpdateItemGrade()
    self.go_table.aorimage_Color.SpriteName = _G.itemColorIconName[self.itemData.cfg.Quality or self.itemData.Grade]
    self.go_table.aorimage_ColorBG.SpriteName = _G.itemColorDiIconName[self.itemData.cfg.Quality or self.itemData.Grade]
end
---物品点击
function RewardItem:UpdateItemOnClick()
    self.go_table.aorbtn_Click.onClick:RemoveAllListeners()
    self.go_table.aorbtn_Click.onClick:AddListener(
        _G.handlerbind(self, self.NoOpenDayRewardShowBtn, self.go_table.aorbtn_Click, self.itemData.sid)
    )
end
---销毁对象时,析构函数
function RewardItem:OnDestroy()
end
--
function RewardItem:NoOpenDayRewardShowBtn(go, sid)
    require("CommonTipManager"):GetInstance():OpenTip(go, sid)
end
return RewardItem
