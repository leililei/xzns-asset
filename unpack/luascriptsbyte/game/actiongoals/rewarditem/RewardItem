---@class RewardItem : Component	中文描述
local RewardItem = _G.BaseClass("RewardItem", _G.Component)

local CS = _G.CS
local typeof = _G.typeof

---创建对象时,入口构造函数
function RewardItem:OnCreate(trans, data)
    self.gameObject = trans.gameObject
    self.transform = trans
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    if _G.IsNil(data) then
        self.go_table.gameObject:SetActiveE(0)
        return
    end
    self.go_table.gameObject:SetActiveE(1)
    self.itemData = data
