---先检测功能是否开启
function ActionGoalsModel.CheckShowCwzl()
    if not require("ActionGoalsModel"):GetInstance().isOpenFunction then
        return true
    end
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(42) then
        return true
    end
    if require("ActionGoalsModel"):GetInstance():GetCurrentDay() < require("ActionGoalsModel"):GetInstance().totalDays then
        return true
    end
    local endDay = _G.ConfigManager.discrete_cfg[105203][1][1]
    local day = _G.TimeUtil.GetInterValDayByGame(_G.PlayerModel:GetInstance().create_time, _G.TimeUtil.GetServerUnixTime())
    if day + 1 > _G.Mathf.Floor(endDay / 86400) then
        return false
    end

    return true
end

