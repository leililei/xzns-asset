    local taskstate = self:CheckAlltasksState(_G.TaskEnum.ETaskState.Completed)
    local goalsstate = self:CheckGoals(true)
    local allpassState = self:CheckAllPss(true)
    --local goals_pass_state = self:CheckAllGoals(true) and goals_pass_state == 0
    if taskstate == 0 and goalsstate == 0 and allpassState == 0 then
        return 1
    end
    return 0
end

