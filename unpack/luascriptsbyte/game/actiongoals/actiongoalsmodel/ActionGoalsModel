---创建对象时,入口构造函数
function ActionGoalsModel:__init()
    self.endCallback = nil
    self.curFunctionOpenID = 42
    self.Cfg = _G.ConfigManager.mission_extra_cfg
    self.data = {}
    self.day_award = {}
    self:initStaticData()
    self.currentAlltasks = {}
    self.dailyAlltasks = {}
    self.currenDay = 0 --界面点击的天数（当前点击的天数，获取任务）
    self.currendDay_qishu = 1 --期数
    self.goals_award = {}
    self.isOpenFunction = false
    self.AllDayTasks = {}
    self.singleDays = 7 --单期天数
    self.totalQiShu = #_G.ConfigManager.discrete_cfg[105202][1]
    self.totalDays = self.singleDays * self.totalQiShu
    self.cycleDays = self.singleDays * 3 --循环天数，用于pb里的任务点数，后端循环利用那三个字段active_seven/ctive_fourteen/active_twenty_one
end

function ActionGoalsModel:Dispose()
    self.data = nil
    if not _G.table.isEmptyOrNil(self.currentAlltasks) then
        for k, v in pairs(self.currentAlltasks) do
            v:Dispose()
        end
    end
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.currentAlltasks = nil
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

