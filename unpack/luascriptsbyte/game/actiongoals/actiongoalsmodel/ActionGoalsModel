function ActionGoalsModel:ParseScoreAward(day, data)
    local awardDatas = {
        award = {
            item = {},
            overflow = data.award.overflow
        }
    }
    local cycleRemainder = (day - 1) % self.cycleDays + 1 --3期一循环，取余
    for i = 1, #data.award.item do
        local sid = data.award.item[i].type[1]
        if sid == _G.ResPropID.Active_seven or sid == _G.ResPropID.Active_forten or sid == _G.ResPropID.Active_twentyone then
            if cycleRemainder <= self.singleDays then
                self.goalsNum = self.goalsNum + data.award.item[i].type[2]
            elseif cycleRemainder > self.singleDays and cycleRemainder <= self.singleDays * 2 then
                self.active_fourteen = self.active_fourteen + data.award.item[i].type[2]
            else
                self.active_twentyone = self.active_twentyone + data.award.item[i].type[2]
            end
        else
            local temp = data.award.item[i]
            _G.table.insert(awardDatas.award.item, temp)
        end
    end
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.GoalTarget.id)
    return awardDatas
end

