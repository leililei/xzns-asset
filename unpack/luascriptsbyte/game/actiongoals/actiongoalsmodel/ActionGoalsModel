---获取 活动 7日、14日 目标奖励 配置表 goals_active_cfg
---@return table 7日\14日 配置表信息
function ActionGoalsModel:InitGoalsActiveCfg()
    local cfg = _G.ConfigManager.goals_active_cfg
    self.activeCfgs = {}
    for key, value in pairs(cfg) do
        if self.activeCfgs[value.group] == nil then
            self.activeCfgs[value.group] = {}
        end
        _G.table.insert(self.activeCfgs[value.group], value)
    end
    for _, v in pairs(self.activeCfgs) do
        _G.table.sort(
            v,
            function(a, b)
                return a.id < b.id
            end
        )
    end
end

