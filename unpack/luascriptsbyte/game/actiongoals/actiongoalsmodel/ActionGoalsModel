function ActionGoalsModel:SendOtheJiequDay()
    --后端要求延迟两秒发送
    self.timer = _G.TimerManager:GetInstance():GetTimer(2, self.SendAccept, self, false)
    self.timer:Start()
end

---发送接取任务
function ActionGoalsModel:SendAccept()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    local data = self:CheckOtherDayTask()
    local day = self:GetCurrentDay()
    if _G.table.isEmptyOrNil(data.accept) then
        return
    end
    --限制失败次数(仅DEBUG模式下有效)
    if _G.AppSetting.DEBUG then
        ---@type table<number,number>
        local requestTasks = self.requestTasks
        if not requestTasks then
            requestTasks = {}
            self.requestTasks = requestTasks
        end
        for i = #data.accept, 1, -1 do
            local sids = data.accept[i].sids
            for j = #sids, 1, -1 do
                local count = requestTasks[sids[j]] or 0
                if count < 3 then
                    --最大重试次数: 3次
                    requestTasks[sids[j]] = count + 1
                else
                    _G.LogError("ActionGoals任务接取失败次数过多: " .. sids[j])
                    table.remove(sids, j)
                end
            end
            if #sids <= 0 then
                table.remove(data.accept, i)
            end
        end
        if _G.table.isEmptyOrNil(data.accept) then
            return
        end
    end
    self:SendTaskJiequ(data)
end

---编辑 任务 匹配到每天 有什么任务
function ActionGoalsModel:GetOneDayAllTask()
    if not _G.table.isEmptyOrNil(self.currentAlltasks) then
        for i = 1, #self.currentAlltasks do
            local temp, daily = self:ChenckCrruetTaskToDay(self.currentAlltasks[i].i_task.sid, self.currentAlltasks[i])
            if temp then
                self.currentAlltasks[i].dayid = temp.dayid
                self.dailyAlltasks[temp.dayid] = daily
                if _G.table.isEmptyOrNil(temp) then
                    if _G.AppSetting.DEBUG then
                        _G.LogError("配置表中：未找到次任务..:" .. self.currentAlltasks[i].i_task.sid)
                    end
                else
                    _G.table.insert(self.AllDayTasks[temp.dayid], temp)
                end
            end
        end
    end
end

---检测 某个任务所在的 天数
function ActionGoalsModel:ChenckCrruetTaskToDay(taskid, task)
    local cfg = _G.ConfigManager.goals_seven_cfg
    local DayAllTask = {}
    local temp = {}
    for key, value in pairs(cfg) do
        if not _G.table.isEmptyOrNil(value.mission_extra1) then
            for i = 1, #value.mission_extra1 do
                if taskid == value.mission_extra1[i] then
                    temp = {}
                    temp.dayid = key
                    temp.group = value.group
                    temp.task = task
                    _G.table.insert(DayAllTask, temp)
                    return temp, value
                end
            end
        end
        if not _G.table.isEmptyOrNil(value.mission_extra2) then
            for j = 1, #value.mission_extra2 do
                if taskid == value.mission_extra2[j] then
                    temp = {}
                    temp.dayid = key
                    temp.group = value.group
                    temp.task = task
                    temp.value = value
                    _G.table.insert(DayAllTask, temp)
                    return temp, value
                end
            end
        end
    end
end

