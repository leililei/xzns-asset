---检测任务是否已过期 (根据天数)
function ActionGoalsModel:CheckGuoQi(day)
    if day == nil then
        return
    end
    local curNum = self:GetCurrentQiShu()
    if curNum == 1 then
        return false
    end

    if day <= (curNum - 2) * 7 then
        return true
    end
    if (curNum - 1) * 7 < day and day <= curNum * 7 then
        return false
    end
    if (curNum - 2) * 7 < day and day <= (curNum - 1) * 7 then
        --上一期
        local disCfg = _G.ConfigManager.discrete_cfg[105202][1]
        return self:GetCurrentDay() > disCfg[curNum - 1]
    end

    if self:GetCurrentTime() == 0 then
        return true
    end

    return false
end

