function ActionGoalsModel:CheckOtherDayTask()
    local alltask = self:GetAllDayTasks()
    local cfg = _G.ConfigManager.goals_seven_cfg
    local temp = {}
    temp.accept = {}
    for day = 1, self.currenDay do
        local count1 = #cfg[day].mission_extra1
        local count2 = #cfg[day].mission_extra2
        local count3 = #alltask[day]
        if count3 < (count1 + count2) then
            local data = {
                day = day,
                sids = {}
            }
            local task = self:GetCurrentDayTask(day)
            local t = {}
            for i = 1, #task do
                _G.table.insert(t, task[i])
            end
            data.sids = t
            _G.table.insert(temp.accept, data)
        end
    end
    return temp
end

