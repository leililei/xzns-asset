function ActionGoalsModel:CheckGoals(isEquality)
    local cfg = _G.ConfigManager.goals_active_cfg
    local temp = {}
    for key, value in pairs(cfg) do
        _G.table.insert(temp, value)
    end
    _G.table.sort(
        temp,
        function(a, b)
            return a.id < b.id
        end
    )
    for key, value in ipairs(temp) do
        local flag = false
        if not _G.table.isEmptyOrNil(self.goals_award) then
            for i = 1, #self.goals_award do
                if tonumber(value.id) == self.goals_award[i] then
                    flag = true
                    break
                end
            end
        end
        if not flag then
            if isEquality then
                if self:GetCurrentTime() == 0 then
                else
                    return 1
                end
                --return 1
            end
            --local flagAward = true
            if
            value.group % 3 == 1 and value.value_active[2] <= self.goalsNum or
                value.group % 3 == 2 and value.value_active[2] <= self.active_fourteen or
                value.group % 3 == 0 and value.value_active[2] <= self.active_twentyone
            then
                return 1
            end
            -- if not flagAward then
            --     ---判断任务过期，全通的肯定是不能完成
            --     if self:GetCurrentTime() == 0 then
            --     else
            --         return 1
            --     end
            -- else
            --     return 1
            -- end
        end
    end
    return 0
end

---检测 全通的奖励
---@param isEquality boolean 检测 任务是否已经 领取
function ActionGoalsModel:CheckAllPss(isEquality)
    local cfg = _G.ConfigManager.goals_seven_cfg
    local alltasks = self:GetAllDayTasks()
    for key, value in ipairs(cfg) do
        if value.id <= self.totalDays then
            local flag = false
            if not _G.table.isEmptyOrNil(self.day_award) then
                for i = 1, #self.day_award do
                    if key == self.day_award[i] then
                        flag = true
                        break
                    end
                end
            end
            if not flag then
                if isEquality then
                    ---判断任务过期，全通的肯定是不能完成
                    if self:CheckGuoQi(key) then
                    else
                        return 1
                    end
                    --return 1
                end
                local flagAward = true
                if not _G.table.isEmptyOrNil(alltasks[key]) then
                    local daytasks = alltasks[key]
                    for i = 1, #daytasks do
                        local temp = daytasks[i]
                        if
                        temp.task.i_task.state ~= _G.TaskEnum.ETaskState.Submited and
                            temp.task.i_task.state ~= _G.TaskEnum.ETaskState.Completed
                        then
                            flagAward = false
                            break
                        end
                    end
                    if flagAward then
                        ---判断任务过期，全通的肯定是不能完成
                        if self:CheckGuoQi(key) then
                        else
                            return 1
                        end
                    end
                end
            end
        end
    end
    return 0
end

