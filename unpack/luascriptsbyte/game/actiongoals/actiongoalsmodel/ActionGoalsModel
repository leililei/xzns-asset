---七日目标 目标点 红点奖励
function ActionGoalsModel:CheckGoalsRedpoint(param)
    local qishu=self:GetCurrentQiShu()
    local pam=math.modf(param / 100)
    if qishu>1 and pam<qishu-1  then
        return false
    end
    local cfg = _G.ConfigManager.goals_active_cfg[param]
    local num = self.goalsNum
    if cfg.group % 3 == 2 then
        num = self.active_fourteen
    elseif cfg.group % 3 == 0 then
        num = self.active_twentyone
    end
    if num == nil then
        return false
    end
    --检测目标点数
    if num < cfg.value_active[2] then
        return false
    end
    if cfg.group > self:GetCurrentQiShu() then
        return false
    end
    local qishu = math.modf(param / 100)
    local param1 = math.fmod(param, 100)
    param1 = param1 + (qishu - 1) * 7
    if self:CheckGuoQi(param1) then
        return false
    end
    --判断奖励是否已经领取过
    if _G.table.isEmptyOrNil(self.goals_award) then
        return true
    end
    for i = 1, #self.goals_award do
        if self.goals_award[i] == param then
            return false
        end
    end
    return true
end

