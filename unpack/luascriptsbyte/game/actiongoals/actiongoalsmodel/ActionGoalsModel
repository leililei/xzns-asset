function ActionGoalsModel:InitFunction()
    if _G.table.isEmptyOrNil(self.data) then
        return
    end
    self.isOpenFunction = true
    self.AllDayTasks = {}
    for i = 1, self.totalDays do
        self.AllDayTasks[i] = {}
    end
    if not _G.table.isEmptyOrNil(self.currentAlltasks) then
        for k, v in pairs(self.currentAlltasks) do
            v:Dispose()
        end
    end
    self.currenDay = 0
    self.currentQishu = 1
    self.goalsNum = self.data.active_seven or 0
    self.day_award = self.data.day_award or {}
    self.goals_award = self.data.goals_award or {}
    self.taskfinsh_task = self.data.finish_task or {}
    self.roletime = _G.PlayerModel:GetInstance().create_time or 0
    self.currendDay_qishu = self:GetCurrentDay()
    self.currentAlltasks = self:AddListenerTaskCheck(self.data) or {}
    self.active_fourteen = self.data.active_fourteen or 0
    self.active_twentyone = self.data.active_twenty_one or 0
    --每一期充值统计
    self.group_cash = self.data.group_cash or {}
    --已领取充值奖励
    self.cash_award = self.data.cash_award or {}
    self.jiequ_day = self.data.jiequ_day or { [1] = 1 }
    self:AddTaskFinshToCurrentALLtaks(self.data.finish_task)
    self:SetCreateRoleTime()
    self:GetOneDayAllTask()
    self:SendOtheJiequDay()
    ---给任务 添加 完成事件
    --self:SixUpdata()
    if self.CheckShowCwzl() == false then
        _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.Qirimubiao)
    end
end

function ActionGoalsModel:RedCheckFunction(id)
    local flag = 1

    if self:GetCurrentDay() < id then
        return 0
    end
    local data = _G.PlayerPrefsManager.GetTable("ActionGoalsModelID")
    if data ~= nil then
        for key, value in pairs(data) do
            if value == id then
                flag = 0
            end
        end
    end
    
    return flag
end

function ActionGoalsModel:AddRedCheckFunction(id)
    local flag = true

    if self:GetCurrentDay() < id then
        flag = false
        return
    end
    local data = _G.PlayerPrefsManager.GetTable("ActionGoalsModelID")
    if data ~= nil then
        -- body
        for key, value in pairs(data) do
            if value == id then
                flag = false
            end
        end
    else
        flag = false
        data = { id }
    end
    if flag then
        _G.table.insert(data, id)
    end
    _G.PlayerPrefsManager.SetTable("ActionGoalsModelID", data)
    self:RefRedPointActionDay()
end

