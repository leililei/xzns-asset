--获得当前 期数相关数据 (1,2,3)
function ActionGoalsModel:GetCurrentQiShu()
    for i = 1, self.totalQiShu do
        if self.currendDay_qishu > (i - 1) * 7 and self.currendDay_qishu <= i * 7 then
            self.currentQishu = i
            return self.currentQishu
        end
    end
    self.currentQishu = 1
    return self.currentQishu
end

function ActionGoalsModel:GetCurrentTime()
    return self:GetTimeByQiShu(self:GetCurrentQiShu())
end

function ActionGoalsModel:GetTimeByQiShu(qishu)
    local disCfg = _G.ConfigManager.discrete_cfg[105202][1]
    local now = _G.TimeUtil.GetServerUnixTime()
    local lastTime = _G.TimeUtil.GetDayBySix(self.roletime) + disCfg[qishu] * 86400 - now
    if lastTime < 0 then
        lastTime = 0
    end
    return lastTime
end

function ActionGoalsModel:GetTimeByDay(day)
    local qishu = self:GetQiShuByDay(day)
    return self:GetTimeByQiShu(qishu)
end

function ActionGoalsModel:GetQiShuByDay(day)
    return _G.Mathf.Ceil(day / self.singleDays)
end

