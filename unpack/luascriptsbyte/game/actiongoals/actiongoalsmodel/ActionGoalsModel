---获得红点得个数 七日目标(成王之路) daybutton 页签上红点
---@param param number 期数 + button 页签
function ActionGoalsModel:GetRedPointActionDayNum(param)
    local qishu = math.modf(param / 100)
    local getRecharge=self:GetRedPointActionDayRecharge(param)
    param = math.fmod(param, 100)
    param = param + (qishu - 1) * 7
    ---检测天数是否开启
    local day = self:GetCurrentDay()
    if param > day then
        return 0
    end
    if self:CheckGuoQi(param) then
        return 0
    end
    --检测 天数任务
    local allTask = self:GetAllDayTasks()
    local onePassTask = allTask[param]
    if onePassTask == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("七日目标 GM 直接设置放置关卡,第一次登录时,红点检测报错")
        end
        return 0 --GM 直接设置放置关卡,第一次登录时,红点检测报错
    end
    -- if self:RedCheckFunction(param) == 1 then
    --     return 1
    -- end
    local flag = true
    for key, value in pairs(onePassTask) do
        if value.task.i_task.state == _G.TaskEnum.ETaskState.Submited then
            return 1
        elseif value.task.i_task.state ~= _G.TaskEnum.ETaskState.Completed then
            flag = false
        end
    end
    --检测 全通奖励
    if not _G.table.isEmptyOrNil(self.day_award) then
        for key, value in pairs(self.day_award) do
            if value == param then
                return 0
            end
        end
    end

    if flag then
        return 1
    end
    return getRecharge
end

