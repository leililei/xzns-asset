function ActionGoalsModel:AddTaskFinshToCurrentALLtaks(tasks)
    if _G.table.isEmptyOrNil(tasks) then
        return
    end
    for i = 1, #tasks do
        local temp = {
            sid = tasks[i],
            state = _G.TaskEnum.ETaskState.Completed,
            target = {
                [1] = 0
            }
        }
        local ta = ActionGoalsData.New(temp, _G.handler(self, self.TaskCompletdRedPoint))
        _G.table.insert(self.currentAlltasks, ta)
    end
end

---编辑所有任务 增加 监听事件 检测 任务是否完成
function ActionGoalsModel:AddListenerTaskCheck(data)
    local tasks = {}
    if _G.table.isEmptyOrNil(data.task) then
        return
    end
    for i = 1, #data.task do
        local day_id = self:CheckTaskOfCfgDay(data.task[i].sid)
        local task = ActionGoalsData.New(data.task[i], _G.handler(self, self.TaskCompletdRedPoint), nil, { dayid = day_id })
        _G.table.insert(tasks, task)
    end
    return tasks
end

---检测任务 所有的 天数
function ActionGoalsModel:CheckTaskOfCfgDay(tasksid)
    local cfg = _G.ConfigManager.goals_seven_cfg
    for i = 1, #cfg do
        local misscfg = cfg[i].mission_extra1
        for j = 1, #misscfg do
            if tasksid == misscfg[j] then
                return i
            end
        end
        misscfg = cfg[i].mission_extra2
        for j = 1, #misscfg do
            if tasksid == misscfg[j] then
                return i
            end
        end
    end
    return 1
end

