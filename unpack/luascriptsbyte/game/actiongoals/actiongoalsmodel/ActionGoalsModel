---领取 一天的 奖励
function ActionGoalsModel:SendDayAllCash_award(d, Call)
    local pbData = {
        index = d
    }
    require("ActionGoalsNet"):GetInstance():SendDayAllCash_award(
        pbData,
        function(data)
            if data.ack ~= 1 then
                return
            end
            ---加入已经领取的 标记
            _G.table.insert(self.cash_award, d)
            local awardDatas = self:ParseScoreAward(d, data)
            _G.StorageManager:GetInstance():ReceiveAwardData(awardDatas)
            _G.PopWindowManager:GetInstance():AddAwardPopQuene(
                data,
                function()
                    _G.PlayerModel:GetInstance():ShowRoleLvUpAward()
                end
            )
            self:RefRedPointActionDay()
            --require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.GoalTarget.id)
            if Call then
                Call()
            end
        end
    )
end

---标记任务 完成可以领取奖励(检测天数是否是过期了)
---@param pbData table 要发送的数据
---@field pbData.day number 要完成的任务所在的天数
---@field pbData.sid number 任务的sid
function ActionGoalsModel:SendTaskFinshSign(pbData, task)
    local day = pbData.task[1].day
    if self:CheckGuoQi(day) then
        if _G.AppSetting.DEBUG then
            _G.Log("任务，检测时间，，已经过期了，，，，，，")
        end
        task.state = _G.TaskEnum.ETaskState.Claimed
        return
    end
    if not self.finishTask then
        self.finishTask = {}
    end
    if self.finishTask[pbData.task[1].sid[1]] then
        return
    end
    self.finishTask[pbData.task[1].sid[1]] = true
    require("ActionGoalsNet"):GetInstance():SendTaskOneFinish(pbData)
end

function ActionGoalsModel:SendTaskJiequ(dayData)
    local pbData = dayData
    require("ActionGoalsNet"):GetInstance():SendJieQuTask(
        pbData,
        function(data)
            if data.task ~= nil then
