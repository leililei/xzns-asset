    local name = go:GetName()
    if name == "@_aorbtn_close" then
        if self.onclick_time_interval + 0.5 >= _G.TimeUtil:GetServerUnixTime() then
            return
        end
        local flag = require("ActionGoalsModel").CheckShowCwzl()
        if flag == false then
            _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.Qirimubiao)
        end
        self:CloseView()
    elseif go == self.go_table.aorbtn_help then
        ---打开玩法说明页面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 84)
    elseif name == "$_aorbtn_day_1" then
        if self.curOnclick_num ~= 1 then
            self:DayButtonClick(1)
        end
    elseif name == "$_aorbtn_day_2" then
        if self.curOnclick_num ~= 2 then
            self:DayButtonClick(2)
        end
    elseif name == "$_aorbtn_day_3" then
        if self.curOnclick_num ~= 3 then
            self:DayButtonClick(3)
        end
    elseif name == "$_aorbtn_day_4" then
        if self.curOnclick_num ~= 4 then
            self:DayButtonClick(4)
        end
    elseif name == "$_aorbtn_day_5" then
        if self.curOnclick_num ~= 5 then
            self:DayButtonClick(5)
        end
    elseif name == "$_aorbtn_day_6" then
        if self.curOnclick_num ~= 6 then
            self:DayButtonClick(6)
        end
    elseif name == "$_aorbtn_day_7" then
        if self.curOnclick_num ~= 7 then
            self:DayButtonClick(7)
        end
    elseif name == "@_aorbtn_AllPallLingqu" then
        self:AllPassRewardBtnOnClick()
    elseif name == "$_aorbtn_dailyTask" then
        if self.TypeMission == 1 then
            self:ChooseType(2)
        end
    elseif name == "$_aorbtn_achievement" then
        if self.TypeMission == 2 then
            self:ChooseType(1)
        end
    end
end

function ActionGoalsView:ChooseType(type)
    self.TypeMission = type

    if AppSetting.IsXzns then
        self.AchieveGoTable.obj_TaskRed:SetActiveE(type == 1 and 1 or 0)
        self.AchieveGoTable.obj_TaskBlack:SetActiveE(type ~= 1 and 1 or 0)
        self.DailyGoTable.obj_TaskRed:SetActiveE(type == 2 and 1 or 0)
        self.DailyGoTable.obj_TaskBlack:SetActiveE(type ~= 2 and 1 or 0)
    else
        self.AchieveGoTable.aorimage_TaskRed:SetActiveE(type == 1 and 1 or 0)
        self.AchieveGoTable.aorimage_TaskBlack:SetActiveE(type ~= 1 and 1 or 0)
        self.DailyGoTable.aorimage_TaskRed:SetActiveE(type == 2 and 1 or 0)
        self.DailyGoTable.aorimage_TaskBlack:SetActiveE(type ~= 2 and 1 or 0)
    end

    self.AchieveGoTable.aortext_text.color = self.chooseBtnColor[type == 1 and 1 or 2]
    self.DailyGoTable.aortext_text.color = self.chooseBtnColor[type == 2 and 1 or 2]
    self:DayButtonClick()
end

