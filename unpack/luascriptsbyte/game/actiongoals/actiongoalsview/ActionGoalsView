function ActionGoalsView:InitToggle()
    ---考虑到前人代码会修改self.currentQishu的值，稳妥起见从Model拿
    local curIndex = self.model:GetCurrentQiShu()
    self.toggles = {}
    self.toggles.cur =
        _G.GetAutoGoTable(
        self.go_table.toggle_cur,
        _G.handlerbind(self, self.OnClickToggle, "cur", _G.handler(self, self.OnCurSelect))
    )
    self.toggles.cur.aortext_text.text = _G.GetLangPackValue(18900000071, _G.GameUtil.NumberToWordByLanguage(curIndex))
    
    self.toggles.cur.aortext_textOn.text = _G.GetLangPackValue(18900000071, _G.GameUtil.NumberToWordByLanguage(curIndex))
    self.toggles.cur.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.GoalPeriod.id, curIndex)
    local showPre = false
    if curIndex > 1 then
        if self.model.currenDay <= _G.ConfigManager.discrete_cfg[105202][1][curIndex - 1] then
            showPre = true
        end
    end
    self.go_table.toggle_pre:SetActiveE(showPre and 1 or 0)
    if showPre then
        self.toggles.pre =
            _G.GetAutoGoTable(
            self.go_table.toggle_pre,
            _G.handlerbind(self, self.OnClickToggle, "pre", _G.handler(self, self.OnPreSelect))
        )
        self.toggles.pre.aortext_text.text =
            _G.GetLangPackValue(18900000071, _G.GameUtil.NumberToWordByLanguage(curIndex - 1))
        self.toggles.pre.aortext_textOn.text =
            _G.GetLangPackValue(18900000071, _G.GameUtil.NumberToWordByLanguage(curIndex - 1))
        self.toggles.pre.obj_redpoint:UpdateRedPointItemIDAndParam(
            _G.ConfigManager.redpoint_cfg.GoalPeriod.id,
            curIndex - 1
        )
    end
end

function ActionGoalsView:OnClickToggle(go, isOn, key, call)
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if call then
        call(isOn)
    end
end

