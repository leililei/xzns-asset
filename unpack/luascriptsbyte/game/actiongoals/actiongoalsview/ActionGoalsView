function ActionGoalsView:UpDateGoalsActiveNum()
    local cfg = self.model:GetActiveCfg(self.currentQishu)
    local count = self.model.goalsNum
    if self.currentQishu % 3 == 2 then
        count = self.model.active_fourteen
    elseif self.currentQishu % 3 == 0 then
        count = self.model.active_twentyone
    end
    local max = cfg[#cfg].value_active[2]
    local flag = false
    if count >= max then
        flag = true
    end
    self.go_table.aortext_GoalsNumber.text = _G.GameUtil.NumberToUnitStr(count)
    self:SetJinduTiao(count, max)
end

---更新 目标点数奖励(7日,和14日)
function ActionGoalsView:UpDateGoalsAward()
    local cfg = {}
    local id = 0
    cfg = self.model:GetActiveCfg(self.currentQishu)
    id = 100 * self.currentQishu
    local goalcoin = self.model.goalsNum
    if self.currentQishu % 3 == 2 then
        goalcoin = self.model.active_fourteen
    elseif self.currentQishu % 3 == 0 then
        goalcoin = self.model.active_twentyone
    end
    for i = 1, 5 do
        if cfg[i] then
            local tb = _G.GetAutoGoTable(self.goals_lists[i])
            tb.aortext_Active_num.text = cfg[i].value_active[2]
            local isGoals = false
            if goalcoin >= cfg[i].value_active[2] then
                --tb.aorimage_bg.SpriteName = "ui_qrmb_jf_jdt_jd_01"
                isGoals = true
            else
                --tb.aorimage_bg.SpriteName = "ui_qrmb_jf_jdt_jd_03"
                isGoals = false
            end
            local isLingqu = false
            if _G.table.isEmptyOrNil(self.model.goals_award) then
                isLingqu = false
            else
                for _, value in pairs(self.model.goals_award) do
                    if (id + i) == value then
                        isLingqu = true
                        break
                    end
                end
            end
            --tb.obj_lingqu:SetActiveE(isLingqu and 1 or 0)
            tb.obj_normal:SetActiveE(not isLingqu and 1 or 0)
            local reward = cfg[i].reward
            if self.all_mubiaodian and self.all_mubiaodian[i] then
                _G.DestroyObject(self.all_mubiaodian[i].gameObject)
            --require("ItemViewBase").Despawn(self.all_mubiaodian[i])
            end
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                reward,
                tb.obj_item,
                function(item)
                    if self.all_mubiaodian[i] == nil then
                        self.all_mubiaodian[i] = {}
                    end
                    self.all_mubiaodian[i] = item
                    item.gameObject:SetRectTransformAnchorMin(0.5, 0.5)
                    item.gameObject:SetRectTransformAnchorMax(0.5, 0.5)
                    item.gameObject:SetLocalPosition(0, 0, 0)
                    item:SetGouScroll(isLingqu)
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    if isGoals then
                        item:ShowEffectOrder(not isLingqu)
                    end
                end,
                function(go, isOn)
                    self:GoalsNumberBtn(go, id + i, cfg[i].value_active[2], reward[1])
                end
            )

            ---动态设置目标点红点 参数
            tb.obj_redpoint_down:UpdateRedPointItemIDAndParam(
                _G.ConfigManager.redpoint_cfg.GoalTarget.id,
                self.currentQishu * 100 + i
            )
        end
    end
end

---目标点数 点击事件
function ActionGoalsView:GoalsNumberBtn(go, sid, goalsNumber, itemid)
    if not _G.table.isEmptyOrNil(self.model.goals_award) then
        for i = 1, #self.model.goals_award do
            if sid == self.model.goals_award[i] then
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, itemid)
                return
            end
        end
    end
    local goalcoin = self.model.goalsNum
    if self.currentQishu % 3 == 2 then
        goalcoin = self.model.active_fourteen
    elseif self.currentQishu % 3 == 0 then
        goalcoin = self.model.active_twentyone
    end
    if goalsNumber > goalcoin then
