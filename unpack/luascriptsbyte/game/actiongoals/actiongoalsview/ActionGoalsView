---每天的 全通奖励
function ActionGoalsView:UpDateShowAllPassReward()
    local cfg = _G.ConfigManager.goals_seven_cfg

    local flag = false
    if not _G.table.isEmptyOrNil(self.model.day_award) then
        for _, value in pairs(self.model.day_award) do
            if value == self.model.currenDay then
                flag = true
                break
            end
        end
    end
    local allPass = self.model:GetAllDayTasks()
    local oneallpalls = allPass[self.model.currenDay]
    local isPass = true
    if _G.table.isEmptyOrNil(oneallpalls) then
        isPass = false
    end
    for i = 1, #oneallpalls do
        local temp = oneallpalls[i]
        if temp.task.i_task.state ~= _G.TaskEnum.ETaskState.Completed then
            isPass = false
            break
        end
    end
    if self.allObjItem ~= nil then
        _G.DestroyObject(self.allObjItem.gameObject)
        self.allObjItem = nil
    end
    local reward = cfg[self.model.currenDay].reward
    _G.UIUtils.RemoveChildren(self.go_table.trans_allpassreward)
    if #reward > 0 then
        for i = 1, #reward do
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                reward[i],
                self.go_table.trans_allpassreward,
                function(item)
                    if self.allObjItem == nil then
                        self.allObjItem = item
                    end
                    item.gameObject:SetRectTransformAnchorMin(0.5, 0.5)
                    item.gameObject:SetRectTransformAnchorMax(0.5, 0.5)
                    item.gameObject:SetLocalPosition(0, 0, 0)
                    -- item:SetGou(flag)
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    if isPass then
                        item:ShowEffectOrder(not flag)
                    end
                end,
                function(go)
                    self:AllPassRewardBtn(go, reward[i][1])
                end
            )
        end
    end
end

