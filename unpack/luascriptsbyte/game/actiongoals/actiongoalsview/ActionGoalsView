---角色回收
function ActionGoalsView:RoleRecycle()
    if not _G.IsNil(self.roleTrans) then
        --  self:InitRotPos()
        _G.PoolsManager:GetInstance():Despawn(self.roleTrans, _G.ePoolType.Temporary)
        self.roleTrans = nil
        --如果之前对象有 则销毁之前的回调
        if self.AnimComponent ~= nil then
            _G.AnimatorPlayEndCallback.RemoveCallback(self.AnimComponent:GetInstanceIDE())
            self.AnimComponent = nil
        end
        if self.Title then
            self.Title.transform:SetParentE(self.sceneTrans)
            self.Title.gameObject:SetActiveE(0)
        end
    end
end

function ActionGoalsView:UpdateTime(elapsed)
    if self.time == nil then
        self.time = require "ActionGoalsModel":GetInstance():GetCurrentTime()
    else
        self.time = self.time - elapsed
    end
    local str = Mathf.RoundToInt(self.time)
    if self.time <= 0 then
        str = _G.LangUtil.TryGetLangValue(90023800055)
        self.go_table.aortext_time.text = str
    else
        str = _G.TimeUtil.TransDayHourMineMiao(math.ceil(self.time))
        --self.go_table.aortext_time.text = _G.LangUtil.TryGetLangValue(90026100001, str)
        self.go_table.aortext_time.text = str
    end
end

