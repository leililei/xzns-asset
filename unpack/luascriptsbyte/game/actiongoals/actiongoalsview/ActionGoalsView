function ActionGoalsView:OnCurSelect(isOn)
    if not isOn then
        return
    end
    self.currentQishu = self.model:GetCurrentQiShu()
    if self.oldCurrentqishu == self.currentQishu then
        return
    end
    self.model.currenDay = self.model:GetCurrentDay()
    self:OnclickLeft(self.model.currenDay)
    self.oldCurrentqishu = self.currentQishu
end
function ActionGoalsView:OnPreSelect(isOn)
    if not isOn then
        return
    end
    self.currentQishu = self.model:GetCurrentQiShu() - 1
    if self.oldCurrentqishu == self.currentQishu then
        return
    end
    self.model.currenDay = (self.currentQishu - 1) * self.model.singleDays + 1
    self:OnclickLeft(self.model.currenDay)
    self.oldCurrentqishu = self.currentQishu
end

return ActionGoalsView
