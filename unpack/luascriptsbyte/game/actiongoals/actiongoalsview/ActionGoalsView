function ActionGoalsView:SixUpdata()
    self.model.currenDay = self.model:GetCurrentDay()
    if self.model:GetCurrentDay() > self.model.totalDays then
        self.model.currenDay = self.model.totalDays
        return
    end
    self:InitGoalsUI()
    self:LoadSeceneAndRole()
end

