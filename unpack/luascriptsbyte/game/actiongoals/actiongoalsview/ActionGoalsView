---天数 未开启 预览奖励(全通 奖励 和 所有任务的 奖励)
function ActionGoalsView:ShowOpenDayReward()
    self.go_table.aortext_tipsIndo.text = _G.LangUtil.GetLangPackValue(90023800001, self.model.currenDay)
    local alltasks = self.model:GetAllTasksOneDay(self.model.currenDay)
    self.itemCfg = _G.ConfigManager.item_cfg
    self.all_rewards = self.model:OndAwardAll(alltasks) or {}
    _G.table.sort(
        self.all_rewards,
        function(a, b)
            local soatEnumb
            soatEnumb = function(c)
                local _, storageID = _G.StorageManager:GetInstance():CheckSidType(c.sid)
                if storageID == _G._G.StorageID.Card then
                    return 10
                elseif storageID == _G._G.StorageID.Equipment then
                    return 9
                elseif storageID == _G._G.StorageID.Material then
                    return 8
                elseif storageID == _G._G.StorageID.Prop then
                    return 7
                end
            end
            local sortA = soatEnumb(a) or 1
            local sortb = soatEnumb(b) or 1
            if sortA > sortb then
                return true
            elseif sortA == sortb and a.Grade > b.Grade then
                return true
            elseif sortA == sortb and a.Grade == b.Grade and a.sid > b.sid then
                -- body
                return true
            end
            return false
        end
    )
    local row = #self.all_rewards
    self.go_table.scrollloopvectical_noopenReward:UpdateCount(row)
end

