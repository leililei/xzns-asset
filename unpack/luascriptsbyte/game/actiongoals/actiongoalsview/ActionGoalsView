--加载角色
function ActionGoalsView:LoadRoleScene(rolepath, callback)
    self:RoleRecycle()
    require("CardInfoManager").GetRole(
        rolepath,
        _G.ePoolType.Temporary,
        self.sceneTrans,
        _G.RoleEffTypeEnum.Main,
        function(trans)
            if trans == nil then
                --_G.LogError("角色无法加载 path:" .. rolepath .. " sp_7rimubiao LoadRoleScene")
                return
            end
            if _G.IsNil(self.sceneTrans) then
                _G.DestroyObject(trans)
                return
            end
            trans:SetParentE(self.sceneTrans)
            local environment =
                self.sceneTrans:GetComponentInChildren(_G.typeof(_G.CS.FrameWork.Environment.EnvironmentSetting))
            if environment then
                environment.SceneCamera.fieldOfView = 30 * _G.CS.Launcher.Inst.FovScale
            end
            trans:SetLocalPosition(0, 0, 0)
            if callback then
                callback(trans)
            end
        end
    )
end

