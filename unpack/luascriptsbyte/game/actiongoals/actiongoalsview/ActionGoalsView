function ActionGoalsView:RefreshScroll(index, obj)
    local item = obj
    if self.TypeMission == 1 then
        local task = self.oneAlltask[index + 1]
        --item:SetName(index + 1 .. " task_id: " .. task.task.i_task.sid .. " state：" .. task.task.i_task.state)
        local tb_i = self:GetComponent(item, TaskDayInfo)
        if tb_i == nil then
            item:SetActiveE(1)
            self:AddComponent(
                item,
                TaskDayInfo.New(
                    item,
                    task,
                    _G.handler(self, self.CallBackBtn),
                    _G.handler(self, self.CloseView),
                    self.TypeMission
                )
            )
        else
            tb_i:ShowDes(task, _G.handler(self, self.CallBackBtn), _G.handler(self, self.CloseView))
        end
    elseif self.TypeMission == 2 then
        local task = {}
        if index + 1 == 1 then
            task.id = 1
            task.group = self.DailyAlltasks.group
            task.total = self.DailyAlltasks.total_recharge
            task.red = self.DailyAlltasks.recharge_reward
            task.dayid = self.DailyAlltasks.id
            task.is = self.model:GetCash_award(task.dayid)

            local ids = self.model:GetIsGroup_cash(task.group)

            local finalPrice = require("MallManager"):GetInstance():GetFinalPrice(task.total)

            if ids >= 100 then
                self.redid2 = 1
                ids = _G.math.floor(ids / 100)
            end
            if ids * 100 > finalPrice then
                ids = _G.math.floor(finalPrice / 100)
            end
            
            task.lang =
                _G.LangUtil.GetLangPackValue(
                90000011016,
                _G.math.floor(finalPrice / 100),
                ids,
                _G.math.floor(finalPrice / 100)
            )
        elseif index + 1 == 2 then
            task.id = 2
            task.dayid = self.DailyAlltasks.id
            task.rmb = self.DailyAlltasks.rmb
        elseif index + 1 == 3 then
            task.id = 3
            task.dayid = self.DailyAlltasks.id
            task.diamond = self.DailyAlltasks.diamond
        end
        -- item:SetName(index + 1 .. " task_id: " .. task.task.i_task.sid .. " state：" .. task.task.i_task.state)

        local tb_i = self:GetComponent(item, TaskDayInfo)
        if tb_i == nil then
            item:SetActiveE(1)
            self:AddComponent(
                item,
                TaskDayInfo.New(
                    item,
                    task,
                    _G.handler(self, self.CallBackBtn),
                    _G.handler(self, self.CloseView),
                    self.TypeMission
                )
            )
        else
            tb_i:ShowDes(task, _G.handler(self, self.CallBackBtn), _G.handler(self, self.CloseView))
        end
    end
end

