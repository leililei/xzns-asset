    self.time = -1
    if self.time <= 0 then
        self.go_table.aortext_time.text = _G.LangUtil.TryGetLangValue(90023800055)
        self.time = nil
    end
end

function ActionGoalsView:OnclickLeft(day)
    --暂停倒计时
    -- if self.timer ~= nil then
    --     self.timer:Stop()
    --     self.timer = nil
    -- end
    if require "ActionGoalsModel":GetInstance():CheckGuoQi(day) then
        self:StopUpdateTimeActivie()
    else
        self.time = require "ActionGoalsModel":GetInstance():GetTimeByDay(day)
        if self.timer == nil then
            self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false)
            self.timer:Start()
        end
    end
    self:UpDateGoalsActiveNum()
    self:UpDateGoalsAward()
    self:UpDateDayButtonNew()

    self.go_table.scrollloopvectical_noopenReward:SetActiveE(0)
    self.go_table.obj_dayRewardInfoNode:SetActiveE(0)
    if self.TypeMission == 1 then
        self.go_table.aorimage_quangtongbg:SetActiveE(1)
        self.go_table.scrollloopvectical_oneTaskInfo:SetActiveE(0)
        self.go_table.scrollloopvectical_dayTaskInfo:SetActiveE(0)
    elseif self.TypeMission == 2 then
        self.go_table.aorimage_quangtongbg:SetActiveE(0)
        self.go_table.scrollloopvectical_oneTaskInfo:SetActiveE(1)
        self.go_table.scrollloopvectical_dayTaskInfo:SetActiveE(1)
    end
    self:UpDataShowOneDayAllTasks()
    self:SetAllPassButtonOrText()

    self:DayButtonClick(1)
end

function ActionGoalsView:AllPassRewardBtnOnClick()
    local allTask = self.model:GetAllDayTasks()
    local onePassTask = allTask[self.model.currenDay]
    local flag = true
    if _G.table.isEmptyOrNil(onePassTask) then
        flag = false
    end
    if not _G.table.isEmptyOrNil(self.model.day_award) then
        for _, value in pairs(self.model.day_award) do
            if value == self.model.currenDay then
                -- _G.FloatTipsModel:GetInstance():Show("已经领取了全天奖励")
                return
            end
        end
    end
    for _, value in pairs(onePassTask) do
        if value.task.i_task.state == _G.TaskEnum.ETaskState.Completed then
        else
            flag = false
            break
        end
    end
    if flag then
        self.model:OneDayReward(
            self.model.currenDay,
            function()
                self:UpDateShowAllPassReward()
                self.go_table.aortext_allpass:SetActiveE(0)
                self.go_table.aorimage_allpass:SetActiveE(1)
                self.go_table.aorbtn_AllPallLingqu:SetActiveE(0)
            end
        )
    --else
    --_G.FloatTipsModel:GetInstance():Show("有任务未完成")
    end
end

