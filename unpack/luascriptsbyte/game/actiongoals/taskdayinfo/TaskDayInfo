---领取btn 和 前往 btn
function TaskDayInfo:TaskBtnOnclick(go, itask)
    local name = go:GetName()
    local allTask = ActionGoalsModel:GetInstance():GetAllDayTasks()
    local oneAlltask = allTask[ActionGoalsModel:GetInstance().currenDay]
    local task = {}
    for key, value in pairs(oneAlltask) do
        if value.task.i_task.sid == tonumber(name) then
            task = value
            break
        end
    end
    if task.task.i_task.state == _G.TaskEnum.ETaskState.Claimed then
        --前往界面
        local link = task.task.Cfg.link
        local functionID = task.task.Cfg.function_open
        local fun_cfg = _G.ConfigManager.function_open_cfg
        --判断下任务的期数 是不是已经过期了
        local flag, unlockType = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(functionID)
        if flag then
            _G.JumpManager:GetInstance():Jump(link)
            if self.endCalllBack then
                self.endCalllBack()
            end
        else
            if not unlockType then
                if _G.AppSetting.DEBUG then
                    _G.LogError("获取未解锁条件为空>>>TaskDayInfo")
                end
                return
            end
            local Limit_cfg = _G.ConfigManager.limit_type_cfg
            local condition_type = unlockType[1][1]
            local params = unlockType[1][2]
            local tips_id = Limit_cfg[condition_type].tipsid
            local param1 = params
            local param2 = 0

            if condition_type == 4 then
                param2 = math.fmod(params, 100)
                param1 = math.modf(params / 1000)
                param1 = math.fmod(param1, 100)
            end
            _G.PopWindowManager:GetInstance():ShowAllTips(tips_id, nil, nil, nil, nil, nil, param1, param2)
        end
        return
    elseif task.task.i_task.state == _G.TaskEnum.ETaskState.Submited then
        --领取任务奖励
        -- ActionGoalsModel:GetInstance():SendTaskOneFinish(
        --         task.task.dayid,
        --         task,
        --         function()
        --             if self.call then
        --                 self.call()
        --             end
        --         end
        -- )
        local taskList = {}
        for key, value in pairs(oneAlltask) do
            if value.task.i_task.state == _G.TaskEnum.ETaskState.Submited then
                table.insert(taskList, value)
            end
        end
        ActionGoalsModel:GetInstance():SendTaskOneFinish(
            task.task.dayid,
            taskList,
            function()
                if self.call then
                    self.call()
                end
            end
        )
    end
end

---创建奖励物品
function TaskDayInfo:CareatItem(data, isGou, Parent, key)
    if _G.IsNil(Parent) or Parent:GetctiveInHierarchy() == 0 then
        return
    end
    if not self.awarditem then
        self.awarditem = {}
    end
    if not self.awarditem[key] then
        self.awarditem[key] = require "BaseAwardNewItem".New(Parent, nil, 88)
    end
    self.awarditem[key]:ShowWithID(
        data,
        nil,
        function()
            if self.rewarditem[key] == nil then
                self.rewarditem[key] = {}
            end
            self.rewarditem[key] = self.awarditem[key].item
            self.awarditem[key].item.gameObject:SetActiveE(1)
            self.awarditem[key].item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            if self.awarditem[key].item.SetGradeNew then
                self.awarditem[key].item:SetGradeNew(false)
            end
            --self.awarditem.item:SetGouScroll(isGou)
            --self.awarditem.item:ShowEffectOrder(self.task.task.i_task.state == _G.TaskEnum.ETaskState.Submited)
        end
    )
end

function TaskDayInfo:TeXiaoShengCheng(obj, go_table, effCfg, key, isflag)
    _G.UIUtils.LoadEffectByCfg(
        effCfg,
        obj,
        function(trans)
            go_table.EffTranDic[key] = trans
            trans:SetActiveE(isflag)
        end
    )
end

