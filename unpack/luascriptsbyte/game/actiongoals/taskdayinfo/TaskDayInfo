---创建对象时,入口构造函数
function TaskDayInfo:OnCreate(trans, data, CallBack, endCalllBack, TypeMission)
    self.TypeMission = TypeMission
    self.trans = trans
    self.gameObject = trans.gameObject
    self.transform = trans.transform
    self.task = data
    self.go_table = _G.GetAutoGoTable(trans)
    self.itemCfg = _G.ConfigManager.item_cfg
    self.call = CallBack
    self.endCalllBack = endCalllBack
    self.TaskRewardInfo = {}
    self.item_real = {}
    self.rewarditem = {}
    self:Show()
end

---展示
function TaskDayInfo:Show()
    self.go_table.obj_tmp:SetActiveE(0)
    self.go_table.obj_rew:SetActiveE(0)
    if self.TypeMission == 1 then
        self.go_table.obj_tmp:SetActiveE(1)
        self:UpdateTaskName()
        --self:UpdateGoals()
        self:UpdateJinduText()
        self:UndaoJinduImage()
        self:UpdateTaskUnLock()
        self:UpdateBtnText()
        self:UpdateBtnImage()
        self:UpdateBtnOnclick()
        self:UpdateReward()
    elseif self.TypeMission == 2 then
        self.go_table.obj_rew:SetActiveE(1)
        -- 生成任务id
        self.loadingAwardTaskId = (self.loadingAwardTaskId or 0) + 1
        if self.task.id == 1 then
            self:ShowRew()
        elseif self.task.id == 2 then
            self:ShowStoreExtra()
            _G.GameUtil.AddDouYinIcon(self.go_table.aorimage_isget, true)
        elseif self.task.id == 3 then
            self:ShowStoreExchange()
        end
    end
end

---创建奖励物品
---@param loadingTaskId string|number   任务加载ID
function TaskDayInfo:oneCareatItem(data, isGou, Parent, key, loadingTaskId)
    _G.StorageManager:GetInstance():GetItemBaseView(
        data[1],
        data[2],
        Parent,
        function(item)
            if not loadingTaskId or loadingTaskId ~= self.loadingAwardTaskId then
                if item and item.gameObject and not _G.IsNil(item.gameObject) then
                    item.gameObject:DestroyObject()
                end
                return
            end
            item.gameObject:SetLocalScaleXYZ(1)
            --  _G.GameUtil.SetActiveByCondition(item.gameObject, true)
            item:SetGou(isGou)
            if item.go_table.aorrawimage_Icon then
                item.go_table.aorrawimage_Icon:SetGray(isGou)
            end
            if item.go_table.aorimage_Color then
                item.go_table.aorimage_Color:SetGray(isGou)
            end
            item.gameObject:SetLocalPosition(0, 0, 0)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end,
        function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data[1])
        end
    )
end

function TaskDayInfo:ShowStoreExchange()
    local data = _G.ConfigManager.store_exchange_cfg[self.task.diamond]
    self.go_table.aortext_LiBaoinfo.text = _G.LangUtil.GetLangPackValue(data.name)
    local datanum = require("MallManager"):GetInstance():GetItemBuyTimes(data.id, data.type_reset)
    self.go_table.obj_isitems:RemoveAllChildren()
    --绑定 奖励物品点击物品事件
    for key, value in pairs(data.goods) do
        self:oneCareatItem(value, datanum >= 1, self.go_table.obj_isitems, key, self.loadingAwardTaskId)
    end
    self.go_table.aortext_isunlock:SetActiveE(1)
    if data.discount == 0 then
        self.go_table.aortext_isunlock:SetActiveE(0)
    else
        self.go_table.aortext_isunlock.text =
            _G.LangUtil.GetLangPackValue(90000011007, _G.math.floor(data.discount / 100))
    end
    self.go_table.trans_isbtn:SetActiveE(0)
    self.go_table.aorimage_isover:SetActiveE(0)
    self.go_table.aortext_diamond:SetActiveE(0)
    self.go_table.aortext_istext:SetActiveE(0)
    local flag = false
    flag = require "ActionGoalsModel":GetInstance():CheckGuoQi(self.task.dayid)
    if datanum >= 1 then
        self.go_table.aortext_isunlock:SetActiveE(0)
        self.go_table.aorimage_isover:SetActiveE(1)
    elseif flag then
    else
        self.go_table.trans_isbtn:SetActiveE(1)
        self.go_table.aortext_diamond:SetActiveE(1)
        self.go_table.aortext_diamond.text = data.price
        self:BtnOnclickStoreExchange()
    end
end

function TaskDayInfo:BtnOnclickStoreExchange()
    self.go_table.aorbtn_isget.onClick:RemoveAllListeners()
    self.go_table.aorbtn_isget.onClick:AddListener(
        _G.handlerbind(self, self.OenBtnOnclickStoreExchange, self.go_table.aorbtn_isget, self.task)
    )
end

function TaskDayInfo:OenBtnOnclickStoreExchange(go, itask)
    local data = _G.ConfigManager.store_exchange_cfg[self.task.diamond]
    if not _G.StorageManager:GetInstance():CheckItemNew(data.type_price, data.price) then
        return
    end
    require "MallNet":GetInstance():BuyItem(data.id, 1, _G.handlerbind(self, self.BuyItemSuc, data))
end

---购买物品返回
function TaskDayInfo:BuyItemSuc(data, item, call)
    if data.ack ~= 1 then
        return
    end
    local datas = _G.ConfigManager.store_exchange_cfg[item.id]
    local MallManager = require("MallManager"):GetInstance()
    MallManager:SetItemBuyTimes(item.id, item.type_reset, 1)
    _G.StorageManager:GetInstance():ConsumeItem(datas.type_price, 0, datas.price)
    local awardDatas = require "ActionGoalsModel":GetInstance():ParseScoreAward(self.task.dayid, data)
    _G.StorageManager:GetInstance():ReceiveAwardData(awardDatas)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
    self:Show()
    if self.call then
        self.call()
    end
end

