local ChallengeCounts = {
    10,
    5,
    1,
}
local function getChallengeCount(own)
    for _, v in ipairs(ChallengeCounts) do
        if own >= v then
            return v
        end
    end
    return ChallengeCounts[#ChallengeCounts]
end

---创建事件触发条目
---@param eventType UnityEngine.EventSystems.EventTriggerType @事件类型
---@param callback fun(data:UnityEngine.EventSystems.PointerEventData):void @回调函数
local function createTriggerEntry(eventType, callback)
    local entry = _G.CS.UnityEngine.EventSystems.EventTrigger.Entry()
    entry.eventID = eventType
    entry.callback:AddListener(callback)
    return entry
end
---求两点的距离
---@param pos1 UnityEngine.Vector2 @点1
---@param pos2 UnityEngine.Vector2 @点2
local function magnitude(pos1, pos2)
    return math.sqrt((pos1.x - pos2.x) ^ 2 + (pos1.y - pos2.y) ^ 2)
end

---@class FlowerCarParadeMainView : UIBaseView	赛车小游戏_入口选关页面
---@field go_table FlowerCarParadeMainView_GoTable
---@field activity ActivitySynGMActivity
---@field model MiniFlowerCarParadeModel
---@field stages activity_mini_game.activity_mini_game_fb_cfg[]     @关卡数据
---@field stageIndex number                                         @当前关卡索引
---@field stageItems FlowerCarParadeMainView._obj_stage1_GoTable[]      @关卡节点
---@field stagePositions {pos:number[],scale:number[]}[]            @关卡节点位置信息
---@field stageMove boolean                                         @关卡动画播放中
---@field timeTimer Timer                                           @活动时间倒计时
---@field unlockTimer Timer                                         @关卡解锁计时器
local FlowerCarParadeMainView = _G.BaseClass("FlowerCarParadeMainView", _G.UIBaseView)

function FlowerCarParadeMainView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function FlowerCarParadeMainView:OnCreate(activity, model)
    self.activity = activity
    self.model = model
    --获取关卡数据以及进行中的序号
    self.stages = self.model:GetStages()
    self.stageIndex = self.model:GetStageIndex()
    if self.stageIndex > 1 and self.model:IsLock(self.stageIndex) then
        --如果当前关卡未解锁，那么就退到上一个关卡
        self.stageIndex = self.stageIndex - 1
    end

    self:InitView()
    self:InitDragStages()
    self:UpdateStages()
    self:UpdateStagePositions()

    self:UpdateView()

    ---更新时间
    self.remainTime = self.activity:GetActivityTypeCls():GetRemianDuration()
    self:UpdateTime(0)
    self.timeTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timeTimer:Start()

    --监听资源状态变化
    self:AddListener(_G.eItemUpdata.Updata, self.UpdateStageButtons)

    self.unlockTimer = _G.TimerManager:GetInstance():GetTimer(60, self.UpdateStageUnlock, self, false, false, true)
    self.unlockTimer:Start()

    --如果玩家是第一次进入, 弹出help面板
    if _G.PlayerPrefsManager.GetInt("FlowerCarParadeMainView_FirstEnter", 0) == 0 then
        _G.PlayerPrefsManager.SetInt("FlowerCarParadeMainView_FirstEnter", 1)
        self:OnClickBtn(self.go_table.aorbtn_help)
    end
end

function FlowerCarParadeMainView:OnDestroy()
    self:RemoveAllListener()
    if self.timeTimer then
        self.timeTimer:Stop()
        self.timeTimer = nil
    end
    if self.unlockTimer then
        self.unlockTimer:Stop()
        self.unlockTimer = nil
    end
end

---初始化页面状态
---@private
function FlowerCarParadeMainView:InitView()
    --关卡节点
    self.stageItems = {}
    self.stagePositions = {}
    for i = 1, 3 do
        local item = _G.GetAutoGoTable(self.go_table["obj_stage" .. i])
        _G.AddViewBtnClick(item.gameObject, _G.handlerbind(self, self.OnClickStageBtn, item))
        --节点初始缩放大小丶位置
        local posX, posY, posZ = item.gameObject:GetLocalPosition()
        local scaleX, scaleY, scaleZ = item.gameObject:GetLocalScale()
        --local scaleX, scaleY, scaleZ = item.gameObject:GetWorldScale()
        table.insert(self.stageItems, item)
        table.insert(self.stagePositions, {
            pos = { posX, posY, posZ },
            scale = { scaleX, scaleY, scaleZ },
        })
    end

    self.go_table.aortext_title.text = self.activity.cfg.info.name
    local gsi = self.activity.cfg.info.front.gift_group_show
    if gsi and gsi.images then
        self.go_table.aorrawimage_awardicon:LoadImage(gsi.images[1].path)
    end

    --货币状态显示
    local resources = _G.ConfigManager.ui_cfg.FlowerCarParadeMainView.resources
    if self.model:GetCoinSid() and self.model:GetCoinSid() > 0 then
        resources = { table.unpack(resources) }
        table.insert(resources, self.model:GetCoinSid())
    end
    self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, resources))

    --门票货币图标
    if self.model:GetCoinSid() and self.model:GetCoinSid() > 0 then
        local itemIcon = _G.StorageManager:GetInstance():GetItemIcon(self.model:GetCoinSid())
        self.go_table.aorrawimage_sweepIcon:LoadImage(itemIcon)
        self.go_table.aorrawimage_challengeIcon:LoadImage(itemIcon)
    end
end

---初始化拖动关卡
function FlowerCarParadeMainView:InitDragStages()
    local clickPosition, clickTime

    local eventTriggers = self.go_table.obj_drag:GetComponentE(_G.typeof(_G.CS.UnityEngine.EventSystems.EventTrigger))
    eventTriggers.triggers:Add(createTriggerEntry(
        _G.CS.UnityEngine.EventSystems.EventTriggerType.PointerDown,
        function(data)
            if self.stageMove then
                return
            end
            clickPosition = data.position
            clickTime = _G.Time.time
        end)
    )
    eventTriggers.triggers:Add(createTriggerEntry(
        _G.CS.UnityEngine.EventSystems.EventTriggerType.Drag,
        function(data)
            if self.stageMove or not clickPosition then
                return
            end
            if math.abs(clickPosition.y - data.position.y) < 50 and magnitude(clickPosition, data.position) >= 100 then
                if clickPosition.x < data.position.x then
                    --向右滑动
                    if self.stageIndex > 1 then
                        self:PlayStageMove(1)
                        self.stageIndex = self.stageIndex - 1
                    end
                else
                    --向左滑动
                    if self.stageIndex < #self.stages then
                        self:PlayStageMove(-1)
                        self.stageIndex = self.stageIndex + 1
                    end
                end
                clickPosition = nil
            end
        end)
    )
    eventTriggers.triggers:Add(createTriggerEntry(
        _G.CS.UnityEngine.EventSystems.EventTriggerType.PointerUp,
        function(data)
            if self.stageMove or not clickPosition then
                return
            end
            if _G.Time.time - clickTime <= 0.2 and magnitude(clickPosition, data.position) <= 10 then
                --点击事件, 计算落点在哪个节点上
                -- if containsScreenPoint(self.stageItems[1].transform, clickPosition) then
                --     self:PlayStageMove(1)
                --     self.stageIndex = self.stageIndex - 1
                -- elseif containsScreenPoint(self.stageItems[3].transform, clickPosition) then
                --     self:PlayStageMove(-1)
                --     self.stageIndex = self.stageIndex + 1
                -- end
                --判断点击范围, 左边1/3则向右滑动, 右边1/3则向左滑动
                local w = self.transform:GetRectTransformWidthHeight()
                if clickPosition.x < w * 0.45 then
                    if self.stageIndex > 1 then
                        self:PlayStageMove(1)
                        self.stageIndex = self.stageIndex - 1
                    end
                elseif clickPosition.x > w * 0.55 then
                    if self.stageIndex < #self.stages then
                        self:PlayStageMove(-1)
                        self.stageIndex = self.stageIndex + 1
                    end
                end
            end
            clickPosition = nil
        end)
    )
end

