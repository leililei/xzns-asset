---@class FlowerCarParadeMainExtraAwardView : UIBaseView	赛车小游戏_额外奖励页面
---@field go_table FlowerCarParadeMainExtraAwardView_GoTable
---@field activity ActivitySynGMActivity
---@field model MiniFlowerCarParadeModel
local FlowerCarParadeMainExtraAwardView = _G.BaseClass("FlowerCarParadeMainExtraAwardView", _G.UIBaseView)

function FlowerCarParadeMainExtraAwardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function FlowerCarParadeMainExtraAwardView:OnCreate(activity, model)
    self.activity = activity
    self.model = model

    self:UpdateView()
end

function FlowerCarParadeMainExtraAwardView:OnDestroy()
    self:RemoveAllListener()
end

function FlowerCarParadeMainExtraAwardView:UpdateView()
    local extraAward = self.model:GetExtraAwardData() or {}

    self.go_table.obj_newItem1:ClearChildren()
    for _, v in ipairs(extraAward) do
        local awardT
        if v.type[1] == 0 then
            awardT = { v.type[4], v.type[5] }
        else
            awardT = v.type
        end
        _G.StorageManager:GetInstance():GetItemBaseView(
            awardT[1],
            awardT[2],
            self.go_table.obj_newItem1,
            function(item)
                if _G.IsNil(self.go_table) then
                    _G.DestroyObject(item.go_table.gameObject)
                    return
                end
                item.go_table.gameObject:SetLocalScaleXYZ(0.8)
                if item.ShowNumText then
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
            end
        )
    end

    local battlePassActivity = require("ActivitySynManager"):GetInstance():GetChildAcitivity(
        10027,
        self.activity:GetJumpType(),
        self.activity:GetMainType()
    )
    ---@type DrawUpBattlePassModel
    local battlePassModel = battlePassActivity and battlePassActivity:GetActivityTypeCls()
    local isBuy = battlePassModel and battlePassModel:GetIsUp(battlePassActivity:GetActivityID())
    self.go_table.aorbtn_comfirm:SetActiveE(isBuy and 1 or 0)
    self.go_table.aorbtn_buy:SetActiveE(isBuy and 0 or 1)
end

---按钮点击事件在这里派发
---@private
function FlowerCarParadeMainExtraAwardView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close1 then
        self:Close()
    elseif go == self.go_table.aorbtn_comfirm then
        local extraAward = self.model:GetExtraAwardData() or {}
        if not extraAward or #extraAward == 0 then
            self:Close()
            return
        end
        self.model:GetExtraAward(function(msg)
            --展示奖励信息
            if msg and msg.ack == 1 and msg.award then
                _G.UIUtils.ShowCommonAward(msg)
            end
            self:Close()
        end)
    elseif go == self.go_table.aorbtn_buy then
        local battlePassActivity = require("ActivitySynManager"):GetInstance():GetChildAcitivity(
            10027,
            self.activity:GetJumpType(),
            self.activity:GetMainType()
        )
        if battlePassActivity then
            battlePassActivity:GetActivityTypeCls():OnEnterActivity()
            self:Close()
        end
    end
end

return FlowerCarParadeMainExtraAwardView
