function TakeOutGameView:OnClickBtn(go)
    if go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 42)
    elseif go == self.go_table.aorbtn_CloseView then
        if _G.AppSetting.ArraignedType == _G.ArraignedStartType.TakeOut then
            return
        end
        --G.UpdateManager:GetInstance():RemoveUpdate(self.UpdateGameItem, self)
        _G.UpdateManager:GetInstance():RemoveFixedUpdate(self.FixedUpdateRoad, self)
        _G.PopWindowManager:GetInstance():ShowAllTips(
            1140004,
            nil,
            function()
                self:Close()
                if self.call then
                    --self.call(require("TakeOutGameModel"):GetInstance():GetScore())
                    self.call(0) --取消时, 不计分数
                    self.call = nil
                end
            end,
            function()
                _G.UpdateManager:GetInstance():AddFixedUpdate(self.FixedUpdateRoad, self)
            end
        )
    elseif go == self.go_table.aorbtn_down then
        self.index = self.index + 1
        if self.index >= max_index then
            self.index = max_index
        end
        self:SetStartPos()
    elseif go == self.go_table.aorbtn_up then
        self.index = self.index - 1
        if self.index <= 1 then
            self.index = 1
        end
        self:SetStartPos()
    elseif go == self.go_table.aorbtn_restart then
        self:Reset()
        self.go_table.obj_GameEnd:SetActiveE(0)
        self:DoGameStart()
    elseif go == self.go_table.aorbtn_start then
        self:DoGameStart()
    elseif go == self.go_table.aorbtn_Close or go == self.go_table.aorbtn_back then
        --self:Close()
        --G.UpdateManager:GetInstance():RemoveUpdate(self.UpdateGameItem, self)
        if _G.AppSetting.ArraignedType == _G.ArraignedStartType.TakeOut then
            self:Reset()
            self.go_table.obj_GameEnd:SetActiveE(0)
            self:DoGameStart()
            return
        elseif _G.AppSetting.ArraignedType == _G.ArraignedStartType.TakeOutToMain then
            if require "TakeOutGameModel":GetInstance():GetGrade() >= 1 then
                if self.call then
                    self.call()
                end
                self:Close()
            else
                self:Reset()
                self.go_table.obj_GameEnd:SetActiveE(0)
                self:DoGameStart()
            end
            return
        end
        _G.UpdateManager:GetInstance():RemoveFixedUpdate(self.FixedUpdateRoad, self)
        if self.activity and self.activity.curActivityClass:GetCurActivityState() ~= ActivitySynManager.State.Open then
            self:StopDeco()
            self:Close()
            return
        end
        if self.activity then
            if self.activity.curActivityClass:GetTypeId() == 10070 then
                self.activity:Finish(
                    require "TakeOutGameModel":GetInstance():GetScore(),
                    function()
                        self:StopDeco()
                        self:Close()
                    end
                )
            elseif require "TakeOutGameModel":GetInstance():GetScore() > self.activity.Mscore then
                self.activity:SubmitScore(
                    require "TakeOutGameModel":GetInstance():GetScore(),
                    function()
                        self.activity:SetNewRankData(
                            require "TakeOutGameModel":GetInstance():GetScore(),
                            function()
                                local view =
                                    _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.TempleView.Name)
                                if view then
                                    view:SetData()
                                end
                                self.activity:RefreshRedPointTemple()
                            end
                        )
                        self:StopDeco()
                        self:Close()
                    end
                )
            else
                self:StopDeco()
                self:Close()

                if self.call then
                    self.call(require("TakeOutGameModel"):GetInstance():GetScore())
                    self.call = nil
                end
            end
        else
            self:StopDeco()
            self:Close()

            if self.call then
                self.call(require("TakeOutGameModel"):GetInstance():GetScore())
                self.call = nil
            end
        end
    elseif go == self.go_table.aorbtn_entry then
        _G.SDKManager:GetInstance():FollowUpReport(require("SDKDef").GameLauncher.ClickEnter)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DouyinSideBarView.Name)
    elseif go == self.go_table.aorbtn_customer then
        self.douyinModel:OpenCustomerService()
    end
end

function TakeOutGameView:StopDeco()
    if self.deco == nil then
        return
    end
    _G.coroutine.stopwaiting(self.deco)
    self.deco = nil
end

function TakeOutGameView:LoadEffect(path, parent, call, loadcall)
    _G.UIUtils.LoadEffectByCfg(
        path,
        parent,
        function(tran)
            if loadcall then
                loadcall()
            end
        end,
        function()
            if call then
                call()
            end
        end
    )
end

function TakeOutGameView:ShowCountdown()
    if self:IsNil() then
        return
    end
    self.countDownNum = self.countDownNum - 1
    self:UpdateCountDown()
    if self.countDownNum <= 0 then
        self.go_table.obj_mask:SetActiveE(0)
        _G.UpdateManager:GetInstance():AddFixedUpdate(self.FixPpdateGameItem, self)
        self.countdown:Stop()
    end
end

function TakeOutGameView:DoGameStart()
    if self:IsNil() then
        return
    end
    if not self.GameStart then
        self.GameStart = true
        self.countDownNum = 3
        self:UpdateCountDown()
        self.countdown = _G.TimerManager:GetInstance():GetTimer(1, self.ShowCountdown, self, false, false, true)
        self.countdown:Start()
