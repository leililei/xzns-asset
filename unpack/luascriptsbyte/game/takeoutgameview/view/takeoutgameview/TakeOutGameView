---移动的点
function TakeOutGameView:ZhuanHuan(node)
    local x, y, z = node:GetPosition()
    local nx, ny = self.camera:WorldToScreenPointE(x, y, z)
    return ny
end

--检测碰撞
function TakeOutGameView:CheckCardsh()
    self:Start()
    local obj_datas = self.item_objs_data.objs
    for key, value in pairs(obj_datas) do
        local obj = value
        local rect = obj:GetComponentE(typeof(CS.UnityEngine.RectTransform))
        local enemy_zuobiao = self:ZhuanHuan(rect)
        local x = enemy_zuobiao - self.startX
        if x > -40 and x < 30 and self.item_objs_data.data[key].road == self.index and obj:GetActiveSelf() == 1 then
            obj:SetActiveE(0)
            --obj:SetLocalPosition(0, 0, 0)
            require "TakeOutGameModel":GetInstance():CheckCardsh(self.item_objs_data.data[key])
            self:UpdateView()
            --播放特效
            if self.item_objs_data.data[key].type == 4 then
                self:SetLifeUIEffect()
                self.go_table.aortext_zengjia.text = "+" .. self.item_objs_data.data[key].value
                self:SetLifePiaozi()
            elseif self.item_objs_data.data[key].type == 2 then
                self:SetModelColor()
                self.go_table.aortext_jianxue.text = "-" .. self.item_objs_data.data[key].value
                self:SetEnemyPiaozi()
            elseif self.item_objs_data.data[key].type == 3 then
                self:SetScoreUIEffect()
            end
        end
    end
end

--背景切换的点
function TakeOutGameView:CheckBoundEnd(obj)
    local rect = obj:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    local x_bg1 = self:ZhuanHuan(rect) - self.boundend_x
    local chang_speed_point = self.speedpengzhuang + (require "TakeOutGameModel":GetInstance().speed) * 2
    --("距离是：  " .. chang_speed_point)
    if x_bg1 < chang_speed_point then
        return true
    else
        return false
    end
end

function TakeOutGameView:CheckBoundCity(obj)
    local rect = obj:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    local x_bg1 = self:ZhuanHuan(rect) - self.cityBoundend_x
    --("x_bg1 = > " .. x_bg1)
    if x_bg1 < 10 then
        return true
    else
        return false
    end
end

---背后 城市场景移动
function TakeOutGameView:MoveBgCity()
    local speed = 5
    -- local speed = require "TakeOutGameModel":GetInstance():GetSpeed()
    self.ract_city1.transform:Translate(0, -speed * _G.Time.deltaTime, 0)
    self.ract_city2.transform:Translate(0, -speed * _G.Time.deltaTime, 0)
    self.ract_city3.transform:Translate(0, -speed * _G.Time.deltaTime, 0)
    if self:CheckBoundCity(self.go_table.obj_city1) then
        local x, y = self.go_table.obj_citystart:GetLocalPosition()
        self.go_table.obj_city1:SetLocalPosition(0, y, 0)
    end
    if self:CheckBoundCity(self.go_table.obj_city2) then
        local x, y = self.go_table.obj_citystart:GetLocalPosition()
        self.go_table.obj_city2:SetLocalPosition(0, y, 0)
    end
    if self:CheckBoundCity(self.go_table.obj_city3) then
        local x, y = self.go_table.obj_citystart:GetLocalPosition()
        self.go_table.obj_city3:SetLocalPosition(0, y, 0)
    end
end

---固定帧 更新
function TakeOutGameView:FixedUpdateRoad()
    if not self.GameStart then
        return
    end
    self.startHp = require "TakeOutGameModel":GetInstance().startHp
    if self.startHp <= 0 then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_GameEnd, true)
        if _G.AppSetting.ArraignedType == _G.ArraignedStartType.TakeOutToMain then
            if require "TakeOutGameModel":GetInstance():GetGrade() >= 1 then
                self.go_table.aorbtn_restart:SetActiveE(0)
            end
        end
        self:SetGameEnd()
        _G.UpdateManager:GetInstance():RemoveFixedUpdate(self.FixedUpdateRoad, self)
        return
    end
    self:MoveBgCity()
    self:MoveRoad()
end

