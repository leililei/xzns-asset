---检测活动时间
function TakeOutGameView:CheckActivtyTime()
    local startTime, _ = self.activity.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Open)
    local endTime, countdown =
        self.activity.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    local time1 = endTime - startTime
    local nowTime = _G.TimeUtil.GetServerUnixTime()
    local time2 = nowTime - startTime
    return (time1 - time2) <= 0
end

function TakeOutGameView:ChangeSpeed()
    local rect_end = self:ZhuanHuan(self.go_table.obj_end)
    local rect_move_obj1 = self:ZhuanHuan(self.go_table.obj_Bg_move1)
    local x_bg1 = rect_move_obj1 - rect_end
    local chang_speed_point = self.speedpengzhuang + (require "TakeOutGameModel":GetInstance().speed) * 2
    if x_bg1 > -chang_speed_point and x_bg1 < 0.01 and self.pengzhuang1 then
        require "TakeOutGameModel":GetInstance():ChangeSpeed()
        self.pengzhuang1 = false
    end
    local rect_move_obj2 = self:ZhuanHuan(self.go_table.obj_Bg_move2)
    local x_bg2 = rect_move_obj2 - rect_end
    if x_bg2 > -chang_speed_point and x_bg2 < 0.01 and self.pengzhuang2 then
        require "TakeOutGameModel":GetInstance():ChangeSpeed()
        self.pengzhuang2 = false
    end
end

