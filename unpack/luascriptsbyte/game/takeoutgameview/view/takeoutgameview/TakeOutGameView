function TakeOutGameView:MoveRoad()
    local speed = require "TakeOutGameModel":GetInstance():GetSpeed()
    speed = speed * _G.Time.deltaTime
    self.ract1.transform:Translate(0, -speed, 0)
    self.ract2.transform:Translate(0, -speed, 0)
    self:MoveObj1()
    if self:CheckBoundEnd(self.go_table.obj_Bg_move2) then
        local x, y = self.go_table.obj_Bg_move1:GetLocalPosition()
        self.go_table.obj_Bg_move2:SetLocalPosition(0, y + 2040, 0)
        self.go_table.obj_Bg_move2:SetAsLastSiblingE()
        self.pengzhuang2 = true
    end
    if self:CheckBoundEnd(self.go_table.obj_Bg_move1) then --x < -63
        local x, y = self.go_table.obj_Bg_move2:GetLocalPosition()
        self.go_table.obj_Bg_move1:SetLocalPosition(0, y + 2040, 0)
        self.go_table.obj_Bg_move1:SetAsLastSiblingE()
        self.pengzhuang1 = true
    end
    self:ChangeSpeed()
    self:CheckCardsh()
end

--屏幕向左移动
function TakeOutGameView:MoveObj1()
    if self.startHp <= 0 then
        return
    end
    if self:CheckBoundEnd(self.go_table.obj_Bg_move1) then
        self.num = 0
        self.total_life_num = {
            [1] = 0,
            [2] = 0,
            [3] = 0
        }
        require "TakeOutGameModel":GetInstance().boshu = require "TakeOutGameModel":GetInstance().boshu + 1
        if self.WiatCoroutine == nil then
            self.WiatCoroutine = _G.coroutine.start(_G.handler(self, self.CoOnProgress))
        end
        self.spawan_data_obj = 1
        self:ResetBoshu()
        self.boshunum = self.boshunum + 1
    end
    if self:CheckBoundEnd(self.go_table.obj_Bg_move2) then
        self.num1 = 0
        self.total_life_num = {
            [1] = 0,
            [2] = 0,
            [3] = 0
        }
        require "TakeOutGameModel":GetInstance().boshu = require "TakeOutGameModel":GetInstance().boshu + 1
        self.spawan_data_obj = 2
        if self.WiatCoroutine == nil then
            self.WiatCoroutine = _G.coroutine.start(_G.handler(self, self.CoOnProgress))
        end
        self:ResetBoshu()
        self.boshunum = self.boshunum + 1
    end
end

function TakeOutGameView:CoOnProgress()
    _G.coroutine.waitforendofframe(2)
    if self.spawan_data_obj == 1 then
        self:SpawnOther()
    else
        self:SpawnOther2()
    end
    _G.coroutine.yield()
    if self.WiatCoroutine ~= nil then
        _G.coroutine.stopwaiting(self.WiatCoroutine)
        self.WiatCoroutine = nil
    end
end

function TakeOutGameView:ResetBoshu()
    if self.boshunum > require "TakeOutGameModel":GetInstance():GetMaxBoshu() then
        self.boshunum = 0
        require "TakeOutGameModel":GetInstance().isRandom = true
    end
end

