        --         end
        --         --self:Move()
        --         self.go_table.aorbtn_start:SetActiveE(0)
        --     end
        -- )
    end
end

function TakeOutGameView:UpdateCountDown()
    if self.countDownNum and self.countDownNum > 0 then
        self.go_table.aorimage_countDown.SpriteName = "ui_hbdj_djs_" .. self.countDownNum
        self.go_table.aorimage_countDown:SetActiveE(1)
    elseif self.countDownNum and self.countDownNum <= 0 then
        self.go_table.aorimage_countDown:SetActiveE(0)
    end
end

function TakeOutGameView:Reset()
    self.GameStart = false
    self.index = 2
    self.num = 0
    self.num1 = 0
    self.startHp = 60 --require"TakeOutGameModel":GetInstance().startHp
    self.GameStart = false
    self.speednum = 0
    self.boshunum = 1
    ---统计每条道路出现 治疗道具的个数 ， 只能出现一个 （同一个地图下）
    self.total_life_num = {
        [1] = 0,
        [2] = 0,
        [3] = 0
    }
    self.pengzhuang1 = true
    self.pengzhuang2 = true
    self.speedpengzhuang = 20 --检测碰撞点的基础数值
    require "TakeOutGameModel":GetInstance():InitTakeOutData(self.cfg)
    self.speed_ind = 1
    self:SetScreenWidth()
    self:SetStartPos()
    -- self.go_table.obj_mask:SetActiveE(1)
    -- self.go_table.aorbtn_start:SetActiveE(1)
    _G.UpdateManager:GetInstance():AddFixedUpdate(self.FixedUpdateRoad, self)
    self:UpdateView()
    self:ResetBoshu()
    self.go_table.obj_Bg_move1:SetLocalPosition(0, 0, 0)
    self.go_table.obj_Bg_move2:SetLocalPosition(0, 2040, 0)
    self.go_table.obj_Bg_move2:SetAsLastSiblingE()
    for i = 1, 10 do
        self:ClearObj(self.go_table.obj_Spawn1, i, 1, 1)
        self:ClearObj(self.go_table.obj_Spawn2, i, 2, 2)
        self:ClearObj(self.go_table.obj_Spawn3, i, 3, 3)
    end
    self:SpawnOther2()
end

function TakeOutGameView:ClearObj(node, number, type, road)
    local type1 = type * 100
    local obj
    if self.item_objs_data.objs[type1 + number] == nil then
        self.item_objs_data.objs[type1 + number] = {}
        self.item_objs_data.data[type1 + number] = {}
        obj = _G.InstantiateObject(self.go_table.obj_item, node)
        self.item_objs_data.objs[type1 + number] = obj
        obj:SetActiveE(0)
    else
        obj = self.item_objs_data.objs[type1 + number]
        obj:SetActiveE(0)
    end
    if obj then
        obj:SetActiveE(0)
    end
end

