---@param number number 用来生成怪物道具的位置
---@param node table 生成到节点
---@param type number 生成的道路
function TakeOutGameView:SpawnObj(node, number, type, road)
    local num, value = 0, 0
    if self.boshunum > require "TakeOutGameModel":GetInstance():GetMaxBoshu() then
        num, value = require "TakeOutGameModel":GetInstance():RandomSpawnObjGudingRoad(road, number)
    else
        num, value = require "TakeOutGameModel":GetInstance():RandomSpawnObj()
    end
    if num == 4 and self.total_life_num[road] > 0 then -- 道具治疗，只能出现一个（同一个地图下）
        return
    end
    local type1 = type * 100

    local obj
    if self.item_objs_data.objs[type1 + number] == nil then
        self.item_objs_data.objs[type1 + number] = {}
        self.item_objs_data.data[type1 + number] = {}
        obj = _G.InstantiateObject(self.go_table.obj_item, node)
        self.item_objs_data.objs[type1 + number] = obj
        obj:SetActiveE(0)
    else
        obj = self.item_objs_data.objs[type1 + number]
        obj:SetActiveE(0)
    end
    if num == nil or num == 1 then
        --("this is space !!!")
        if obj then
            --obj:SetLocalPosition(0, 0, 0)
            obj:SetActiveE(0)
        end
        return
    end
    if obj == nil then
        self.item_objs_data.data[type1 + number] = {
            type = 1,
            value = 0,
            road = road
        }
        return
    end
    obj:SetActiveE(1)
    obj:SetName("道路和数值__:" .. type1 + number .. "  盒子类型: " .. num)
    local tb = _G.GetAutoGoTable(obj)
    obj:SetLocalPosition(0, (number - 1) * 120 + 10, 0)
    tb.aorimage_icon.SpriteName = icon_lists[num]
    tb.aorimage_icon:SetNativeSize()
    if num == 3 then
        tb.aortext_hp_yellow.text = ""
        tb.aortext_hp_green.text = ""
    elseif num == 2 then
        -- tb.aortext_hp_yellow.text = "-" .. value
        tb.aortext_hp_yellow.text = ""
        tb.aortext_hp_green.text = ""
    elseif num == 4 then
        self.total_life_num[road] = self.total_life_num[road] + 1
        -- body
        tb.aortext_hp_yellow.text = ""
        tb.aortext_hp_green.text = "+" .. value
    end
    self.item_objs_data.data[type1 + number] = {
        type = num,
        value = value,
        road = road
    }
end

function TakeOutGameView:SpawnOther()
    if self.startHp <= 0 then
        return
    end
    -- self.num = self.num + 1
    -- if self.num > 10 then
    --     return
    -- end
    for i = 1, 10 do
        self.num = self.num + 1
        self:SpawnObj(self.go_table.obj_Spawn1, self.num, 1, 1)
        self:SpawnObj(self.go_table.obj_Spawn2, self.num, 2, 2)
        self:SpawnObj(self.go_table.obj_Spawn3, self.num, 3, 3)
    end
end

