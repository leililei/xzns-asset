---@class TakeOutPropData   外卖小游戏道具类型
local TakeOutPropData = _G.BaseClass("TakeOutPropData")
---类的构造函数
function TakeOutPropData:__init()
    self.name = ""
    self.type = 0
    self.value = 0
end

---类的析构函数
function TakeOutPropData:Dispose()
    self.name = nil
    self.type = nil
    self.value = nil
end
---设置值
function TakeOutPropData:SetValue(value)
    self.value = value
end
---设置类型 0 空 1 回血 2 增加积分 3 怪物
function TakeOutPropData:SetType(type)
    self.type = type
end
---设置图片名称
function TakeOutPropData:SetName(name)
    self.name = name
end
return TakeOutPropData
