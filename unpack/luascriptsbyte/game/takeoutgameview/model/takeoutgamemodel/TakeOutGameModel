    ---固定路线包含的个数
    self.road_gu = {
        [1] = {
            enumynum = 0,
            lifenum = 0,
            bosnum = 0, --增加积分的盒子
            enumy_random = 0,
            life_random = 0,
            bos_random = 0
        },
        [2] = {
            enumynum = 0,
            lifenum = 0,
            bosnum = 0,
            enumy_random = 0,
            life_random = 0,
            bos_random = 0
        },
        [3] = {
            enumynum = 0,
            lifenum = 0,
            bosnum = 0,
            enumy_random = 0,
            life_random = 0,
            bos_random = 0
        }
    }
end
---固定的路线(先生成 怪物，box增加积分,生命)
---@param index number 格子是第几列
function TakeOutGameModel:RandomSpawnObjGudingRoad(road, index)
    --("固定录像：" .. road)
    if self.isRandom then
        self.r_enumy_damage = 1
        self:InitRandomGudNum()
        self:RandomThreeRoad()
        for i = 1, 3 do
            self:RandomEmNum(i)
            self:RandomLifeNum(i)
            self:RandomSocreBoxNum(i)
        end
        self.isRandom = false
        self.isRandomgu = true
    end
    --固定第一列是 生成三个 怪物
    if index == 1 then
        local value = self:RangEnemyDamage()
        self.road_gu[road].enumynum = self.road_gu[road].enumynum + 1
        return 2, value
    elseif index == 2 or index == 3 then
        return 1, 0
    end
    --固定路线第二列往后随机生成
    if road == 3 then
        self.isRandomgu = false
    end
    if self.isRandomgu then
        if self.road_gu[road].enumynum < self.road_gu[road].enumy_random then
            self.road_gu[road].enumynum = self.road_gu[road].enumynum + 1
            return 2, self.r_enumy_damage
        elseif self.road_gu[road].lifenum < self.road_gu[road].life_random then
            self.road_gu[road].lifenum = self.road_gu[road].lifenum + 1
            return 4, self.cfg.returnvalue
        elseif self.road_gu[road].bosnum < self.road_gu[road].bos_random then
            self.road_gu[road].bosnum = self.road_gu[road].bosnum + 1
            return 3, self.cfg.rewardscore
        else
            return 1, 0
        end
    else
        local num = self:RandomValue(1, 4)
        if num == 1 then
            if self.road_gu[road].enumynum < self.road_gu[road].enumy_random then
                self.road_gu[road].enumynum = self.road_gu[road].enumynum + 1
                return 2, self.r_enumy_damage
            end
        elseif num == 2 then
            if self.road_gu[road].lifenum < self.road_gu[road].life_random then
                self.road_gu[road].lifenum = self.road_gu[road].lifenum + 1
                return 4, self.cfg.returnvalue
            end
        elseif num == 3 then
            if self.road_gu[road].bosnum < self.road_gu[road].bos_random then
                self.road_gu[road].bosnum = self.road_gu[road].bosnum + 1
                return 3, self.cfg.rewardscore
            end
        else
            return 1, 0
        end
    end
end
---随机敌人的数量
function TakeOutGameModel:RandomEmNum(road)
    local eventid = self.raods_random[road]
    local cfg = _G.ConfigManager.min_parkour_event_cfg[eventid]
    local num = cfg.enemy[1]
    --("敌人个数： " .. #cfg.enemy)
    if #cfg.enemy > 1 then
        num = self:RandomValue(cfg.enemy[1], cfg.enemy[2])
    end
    --("id shi : " .. cfg.ID)
    self.road_gu[road].enumy_random = num
    local value = self:RandomValue(cfg.damagevalue[1], cfg.damagevalue[2])
    self.r_enumy_damage = value
end
---随机治疗道具
function TakeOutGameModel:RandomLifeNum(road)
    local eventid = self.raods_random[road]
    local cfg = _G.ConfigManager.min_parkour_event_cfg[eventid]
    local num = cfg.recoveryvalue[1]
    --("治疗个数： " .. #cfg.recoveryvalue)
    if #cfg.recoveryvalue > 1 then
        num = self:RandomValue(cfg.recoveryvalue[1], cfg.recoveryvalue[2])
    end
    self.road_gu[road].life_random = num
end
---随机得分道具
function TakeOutGameModel:RandomSocreBoxNum(road)
    local eventid = self.raods_random[road]
    local cfg = _G.ConfigManager.min_parkour_event_cfg[eventid]
    local num = cfg.rewardvalue[1]
    --("得分个数： " .. #cfg.rewardvalue)
    if #cfg.rewardvalue > 1 then
        num = self:RandomValue(cfg.rewardvalue[1], cfg.rewardvalue[2])
    end
    self.road_gu[road].life_random = num
end
---随机三条路线
function TakeOutGameModel:RandomThreeRoad()
    ---1 - 3  = 大 中 小
    for i = 1, 3 do
        local roads_ran = self.cfg.eventid[i]
        local ran = self:RandomValue(1, 3)
        --_G.table.insert(self.raods_random, roads_ran[ran])
        --_G.table.insert(self.raods_random, ran)
        if self.raods_random[i] == nil then
            self.raods_random[i] = {}
        end
        self.raods_random[i] = roads_ran[ran]
    end
    --("随机的路线id")
    --(self.raods_random)
end

--随机属性值
function TakeOutGameModel:RandomValue(start, endnum)
    local num = 10
    num = math.random(start, endnum)
    return num
end
--获得评分 1 = B ,2 = A ,3 = S, 4 = SSS
function TakeOutGameModel:GetGrade()
    local grade_lists = _G.ConfigManager.discrete_cfg[105604][1]
    local num = 1
    local gra_b, gra_a, gra_s, gra_sss = grade_lists[1], grade_lists[2], grade_lists[3], grade_lists[4]
    if self.score > gra_sss then
        num = 4
    elseif self.score <= gra_sss and self.score > gra_s then
        num = 3
    elseif self.score <= gra_s and self.score > gra_a then
        num = 2
    elseif self.score <= gra_a and self.score > gra_b then
        num = 1
    else
        num = 1
    end
    return num
end

function TakeOutGameModel:ChangeSpeed()
    self.speed = self.speed + self.speedtime
    --("速度改变   " .. self.speed)
    if self.speed > self:GetMaxSpeed() then
        self.speed = self:GetMaxSpeed()
    end
end
--获得速度
function TakeOutGameModel:GetSpeed()
    if self.speed >= self.cfg.maxspeed then
        self.speed = self.cfg.maxspeed
    end
    return self.speed
end
---获得最大速度
function TakeOutGameModel:GetMaxSpeed()
    return self.cfg.maxspeed
end
---第n波 出现固定的路线
function TakeOutGameModel:GetMaxBoshu()
    return self.cfg.enemyinterval
end
---改变分数
function TakeOutGameModel:ChanageScore(num)
    self.score = self.score + num
end
---获取分数
function TakeOutGameModel:GetScore()
    return self.score
end
---获得生命值
function TakeOutGameModel:GetPlayerHp()
    return self.startHp
end
function TakeOutGameModel:ChangerPlayerHp(num)
    self.startHp = self.startHp + num
    if self.startHp <= 0 then
        self.startHp = 0
    end
    if self.startHp >= self.cfg.life then
        self.startHp = self.cfg.life
    end
end
---@param data table 碰撞
---@field type number 类型 1 = 空， 2= 怪物 3= 盒子 4 = 生命值
---@field value number 值
---@field road number 坐在的 上中下 三条路
function TakeOutGameModel:CheckCardsh(data)
    if data.type == 2 then
        self:ChangerPlayerHp(-data.value)
    elseif data.type == 3 then
        self:ChanageScore(data.value)
    elseif data.type == 4 then
        self:ChangerPlayerHp(data.value)
    end
end

return TakeOutGameModel
