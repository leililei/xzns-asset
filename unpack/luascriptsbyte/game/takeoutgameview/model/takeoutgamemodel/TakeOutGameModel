---@class TakeOutGameModel : 数据类 外卖小游戏
local TakeOutGameModel = _G.BaseClass("TakeOutGameModel", _G.Singleton)
---创建对象时,入口构造函数
---@field startHp number 开始的生命值
---@field speedInterval number 速度增加的区间值
---@field max_speed number 最大的速度
---@field damage  number 怪物的最大伤害值
---@field cure number 治疗
---@field score number 分数
---@field stage number 阶段 1 = 前期 2=中期 3 = 后期
function TakeOutGameModel:__init()
    --self:InitTakeOutData()
end

---销毁对象时,析构函数
function TakeOutGameModel:Dispose()
end
function TakeOutGameModel:InitTakeOutData(cfg)
    self.startHp = 0
    self.speed = 0
    self.speedInterval = 0
    self.max_speed = 0
    self.damage = 0
    self.cure = 0
    self.score = 0
    self.stage = 1
    self.raods_random = {}
    self.isRandom = true
    self.cfg = cfg or _G.ConfigManager.min_parkour_cfg[30101]
    self.startHp = self.cfg.life
    self.speed = self.cfg.speed
    self.speedtime = self.cfg.acceleratedspeed[2]
    self.speedtime_num = self.cfg.acceleratedspeed[1]
    self.boshu = 1 -- 控制怪物的血量随机  （前，中，后）
end
---根据波数随机 怪物的血量
function TakeOutGameModel:RangEnemyDamage()
    local num = self.boshu
    --("波数是： " .. num)
    local damage = self:RandomValue(self.cfg.damagevalue[1], self.cfg.damagevalue[2])
    local d_cfg
    if num <= 3 then
        d_cfg = self.cfg.randomdamage[1]
    elseif num > 3 and num < 6 then
        d_cfg = self.cfg.randomdamage[2]
    else
        d_cfg = self.cfg.randomdamage[2]
    end
    damage = self:RandomValue(d_cfg[1], d_cfg[2])
    return damage
end
--随机生成怪物，盒子，生命 和 值
---@return num ,value  类型 和 值 (1 = 空 2= 怪物，3 = 增加积分盒子 4 = 生命盒子)
function TakeOutGameModel:RandomSpawnObj()
    local num, value = 1, 0
    num = self:RandomValue(1, 100)
    local num_boshu = self.boshu
    local d_cfg
    if num_boshu <= 3 then
        d_cfg = self.cfg.andomweight[1]
    elseif num_boshu > 3 and num_boshu < 6 then
        d_cfg = self.cfg.andomweight[2]
    else
        d_cfg = self.cfg.andomweight[3]
    end
    --
    -- if _G.AppSetting.DEBUG then
    --     _G.Log("外卖小游戏：", "根据波数，选择生成怪物的区间：")
    -- end
    local num1, num2, num3, num4 = d_cfg[1], d_cfg[2], d_cfg[3], d_cfg[4]
    if num <= num1 then
        num = 1
        value = 0
    elseif num > num1 and num <= num2 then -- 怪物
        num = 2
        value = self:RangEnemyDamage() --self:RandomValue(self.cfg.damagevalue[1], self.cfg.damagevalue[2])
    elseif num > num2 and num <= num3 then --生命盒子
        num = 4
        value = self.cfg.returnvalue
    elseif num > num3 and num <= num4 then
        num = 3
        value = self.cfg.rewardscore
    else
        num = 1
        value = 0
    end
    --
    if _G.AppSetting.DEBUG then
        _G.Log(string.format("随机的值是：%s , 区间(波数)：%s", num, num_boshu))
    end
    return num, value
end
