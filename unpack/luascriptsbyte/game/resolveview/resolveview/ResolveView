require "ItemViewBase"
require "StringUtil"
require "EquipViewBase"
---@class ResolveView : UIBaseView	中文描述
---@field public go_table ResolveView_GoTable GoTable
local ResolveView = _G.BaseClass("ResolveView", _G.UIBaseView)
--_G.ResolveView = ResolveView

local EquipPath = "UI/BagView/$_obj_SingleEquip"

local CS = _G.CS
local typeof = _G.typeof

function ResolveView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ResolveView:OnCreate(equip, call)
    self.CallBack = call
    self.EquipList = equip
    self.EquipIDList = {}
    self.SelectedItem = {}
    self.SelectGrade = _G.PlayerPrefsManager.GetTable("ResolveSelectGrade")
    if self.SelectGrade == nil then
        self.SelectGrade = {}
    end
    self.IsFirst = true
    if equip == nil then
        self:Close()
    end
    self.SelectBtn = {}
    self.SelectBtn[_G.EquipQuality.White] = self.go_table.aorimage_WhiteOn
    self.SelectBtn[_G.EquipQuality.Blue] = self.go_table.aorimage_BlueOn
    self.SelectBtn[_G.EquipQuality.Purple] = self.go_table.aorimage_PurpleOn
    self.SelectBtn[_G.EquipQuality.Orange] = self.go_table.aorimage_OrangeOn
    self.SelectBtn[_G.EquipQuality.Red] = self.go_table.aorimage_RedOn
    for _, v in pairs(self.SelectBtn) do
        v:SetActiveE(0)
    end
    self.Anim = self.go_table.obj_Eff:FindE("ef_ResolveView/View"):GetComponentE(typeof(CS.UnityEngine.Animator))
    if self.SelectGrade then
        for _, v in pairs(self.SelectGrade) do
            for _, v2 in pairs(self.EquipList) do
                if v2.cfg.grade == v then
                    self.SelectedItem[v2.uid] = true
                end
            end
            self.SelectBtn[v]:SetActiveE(1)
        end
    end

    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.Ef_ResolveBao,
        self.go_table.obj_Eff,
        function(tran)
            self.SucEff = tran
            if tran then
                tran:SetActiveE(0)
            end
        end
    )

    self:ShowEquipView()
end

function ResolveView:ShowEquipView()
    self.go_table.obj_Mask:SetActiveE(0)
    local isRefresh = false
    if self.EquipIDList ~= nil and _G.math.ceil(#self.EquipIDList / 6) == _G.math.ceil(table.count(self.EquipList) / 6) then
        isRefresh = true
    end
    self.EquipIDList = {}
    for i, _ in pairs(self.EquipList) do
        table.insert(self.EquipIDList, i)
    end
    table.sort(
        self.EquipIDList,
        function(a, b)
            local bl = false
            local ea = self.EquipList[a]
            local eb = self.EquipList[b]
            if ea.cfg.grade < eb.cfg.grade then
                bl = true
            end
            return bl
        end
    )
    if self.IsFirst then
        self.go_table.looplist2_EquipList:InitListView(0, _G.handler(self, self.RefreshList))
        self.IsFirst = false
    end
    self.go_table.looplist2_EquipList:SetListItemCount(_G.math.ceil(#self.EquipIDList / 6), true)
    if isRefresh then
        self.go_table.looplist2_EquipList:RefreshAllShownItem()
    end
end

function ResolveView:RefreshList(listView2, index)
    if index < 0 then
        return
    end
    local list = self.EquipList
    local item = listView2:NewListViewItem("$_obj_ListItem")
    local x = index * 6 + 1
    item:SetName(x)
    local tb_i = {}
    local data = {}
    for i = 1, 6 do
        tb_i =
            _G.GetAutoGoTable(
            item:FindE(string.format("$_obj_SingleEquip%d", i)),
            _G.handlerbind(self, self.OnClickItem, x + i - 1)
        )
        local data = list[self.EquipIDList[x + i - 1]]
        if data == nil then
            tb_i:SetActiveE(0)
        else
            if self.SelectedItem[data.uid] then
                tb_i.aorimage_Selected:SetActiveE(1)
            else
                tb_i.aorimage_Selected:SetActiveE(0)
            end
            tb_i:SetActiveE(1)
            tb_i.aorimage_Grade.SpriteName = _G.itemColorIconName[data.cfg.grade]
            tb_i.aorrawimage_Icon:LoadImage(
                data.cfg.icon,
                function(image)
                    if image == nil then
                        return
                    end
                    image:SetActiveE(1)
                end
            )
            -- tb_i.aortext_Lv.text = data.cfg.limit_level
            -- if data.streng > 0 then
            --     tb_i.obj_Streng:SetActiveE(1)
            --     tb_i.aortext_StrengLv.text = "+" .. data.streng
            -- else
            --     tb_i.obj_Streng:SetActiveE(0)
            -- end
            tb_i.obj_Card:SetActiveE(0)
        end
    end
    return item
end

---点击物品，放入选择列表
function ResolveView:OnClickItem(go, IsOn, index)
    if self.EquipIDList[index] == nil then
        return
    end

    if self.SelectedItem[self.EquipIDList[index]] == nil then
        self.SelectedItem[self.EquipIDList[index]] = true
    else
        self.SelectedItem[self.EquipIDList[index]] = not self.SelectedItem[self.EquipIDList[index]]
    end
    self:ShowEquipView()
end

function ResolveView:Resolve()
    if table.isEmptyOrNil(self.SelectedItem) then
        return
    end
    local IsSelect = false
    for _, v in pairs(self.SelectedItem) do
        if v then
            IsSelect = true
            break
        end
    end
    if not IsSelect then
        return
    end

    local selectEquip = {}
    local bl = false
    for i, v in pairs(self.SelectedItem) do
        if v then
            selectEquip[i] = self.EquipList[i]
            if self.EquipList[i].Grade > _G.EquipQuality.Purple then
                bl = true
            end
        end
    end

    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ResolveDoneView.Name,
        selectEquip,
        _G.handler(self, self.ResolveDone)
    )
end

function ResolveView:ResolveDone(bl, data)
    if not bl then
        return
    end

    if not self.IsResolveSuc then
        self.IsResolveSuc = true
    end

    self.go_table.obj_Mask:SetActiveE(1)
    local time = 0
    if self.Anim then
        self.Anim.enabled = false
        self.Anim.enabled = true
        self.Anim:SetActiveE(0)
        self.Anim:SetActiveE(1)
        time = 3
    end
    if self.SucEff then
        _G.DelayDo(
            1.73,
            function()
                self.SucEff:SetActiveE(0)
                self.SucEff:SetActiveE(1)
            end
        )
    end
    _G.DelayDo(
        time,
        function()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
            for i, v in pairs(self.SelectedItem) do
                if v then
                    self.EquipList[i] = nil
                end
            end
            self.SelectedItem = {}
            self.go_table.aorimage_WhiteOn:SetActiveE(0)
            self.go_table.aorimage_BlueOn:SetActiveE(0)
            self.go_table.aorimage_PurpleOn:SetActiveE(0)
            self.go_table.aorimage_OrangeOn:SetActiveE(0)
            self.go_table.aorimage_RedOn:SetActiveE(0)
            self.SelectGrade = {}
            self:ShowEquipView()
        end
    )
end

---选择品质分解
function ResolveView:SelectQuality(type, IsOn)
    local bl =
        table.find(
        self.SelectGrade,
        function(a)
            return a == type
        end
    )

    for _, v in pairs(self.EquipList) do
        if v.cfg.grade == type then
            self.SelectedItem[v.uid] = not bl
        end
    end
    self.SelectBtn[type]:SetActiveE((not bl) and 1 or 0)
    if bl then
        table.removebyvalue(self.SelectGrade, type)
    else
        table.insert(self.SelectGrade, type)
    end
    self:ShowEquipView()
end

---按钮点击事件在这里派发
function ResolveView:OnClickBtn(go, IsOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ResolveView.Name)
        _G.PlayerPrefsManager.SetTable("ResolveSelectGrade", self.SelectGrade)
        if self.CallBack ~= nil then
            self.CallBack(self.IsResolveSuc)
        end
    elseif name == "@_aorbtn_Gray" then
        self:SelectQuality(_G.EquipQuality.White, IsOn)
    elseif name == "@_aorbtn_Blue" then
        self:SelectQuality(_G.EquipQuality.Blue, IsOn)
    elseif name == "@_aorbtn_Purple" then
        self:SelectQuality(_G.EquipQuality.Purple, IsOn)
    elseif name == "@_aorbtn_Gold" then
        self:SelectQuality(_G.EquipQuality.Orange, IsOn)
    elseif name == "@_aorbtn_Red" then
        self:SelectQuality(_G.EquipQuality.Red, IsOn)
    elseif name == "@_aorbtn_Done" then
        self:Resolve()
    end
end

return ResolveView
