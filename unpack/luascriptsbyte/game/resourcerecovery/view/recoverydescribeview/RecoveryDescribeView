---@class RecoveryDescribeView : UIBaseView	中文描述
---@field public go_table RecoveryDescribeView_GoTable GoTable
local RecoveryDescribeView = _G.BaseClass("RecoveryDescribeView", _G.UIBaseView)
--_G.RecoveryDescribeView = RecoveryDescribeView

local CS = _G.CS
local typeof = _G.typeof
function RecoveryDescribeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function RecoveryDescribeView:OnCreate(data)
    self.data = data
    self.cfg = _G.ConfigManager.resource_ret_cfg
    local num = #data + 1
    self.go_table.looplist2_:InitListView(0, _G.handlerbind(self, self.RefreshItem))
    self.go_table.looplist2_:SetListItemCount(num)
end

---按钮点击事件在这里派发
function RecoveryDescribeView:OnClickBtn(go)
    self:Close()
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
end

function RecoveryDescribeView:RefreshItem(listView2, index, chatlooplist)
    if index < 0 then
        return
    end
    local item, goTable, csf_tmp, csf_tmp1, csf_tmp2
    if index == 0 then
        item = listView2:NewListViewItem("$_obj_ListItem1")
        goTable = _G.GetAutoGoTable(item)
        goTable.aortext_rule.text = _G.LangUtil.GetLangPackValue(90000011637)
        csf_tmp = item:GetComponentE(typeof(CS.UnityEngine.UI.ContentSizeFitter))
        csf_tmp:SetLayoutVertical()
        _G.GameUtil.ReBuildRTF(item)
    else
        item = listView2:NewListViewItem("$_obj_ListItem2")
        goTable = _G.GetAutoGoTable(item)
        goTable.aortext_name.text = _G.LangUtil.GetLangPackValue(self.cfg[self.data[index].id].functionname)
        local txt = self.cfg[self.data[index].id].set_type == 1 and 90000011638 or 90000011639
        goTable.aortext_time.text = _G.LangUtil.GetLangPackValue(txt)
        goTable.obj_ItemContent:ClearChildren()
        local dataA,dataB
        table.sort(self.data[index].award,function(a,b)
            dataA = _G.StorageManager:GetItemDataClass(a[1], a[2])
            dataB = _G.StorageManager:GetItemDataClass(b[1], b[2])
            return dataA.Grade>dataB.Grade
        end)
        for k, v in ipairs(self.data[index].award) do
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                v,
                goTable.obj_ItemContent,
                function(item)
                    item.gameObject:SetLocalScaleXYZ(0.8)
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    item:ShowEffect(true)
                end,
                function(go, isOn)
                    require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, self.data[index].award[k][1])
                end
            )
        end
        local rect = item:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
        rect:SetSizeWithCurrentAnchors(CS.UnityEngine.RectTransform.Axis.Vertical,
        170 + 108 * (_G.math.ceil(#self.data[index].award / 5) - 1))
    end
    return item
end

return RecoveryDescribeView
