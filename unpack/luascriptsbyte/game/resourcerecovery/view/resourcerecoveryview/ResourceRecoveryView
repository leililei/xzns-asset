---@class ResourceRecoveryView : UIBaseView	中文描述
---@field public go_table ResourceRecoveryView_GoTable GoTable
---@field activityTypeCls MoreDaySignModel 活动类型数据
---@field activity ActivitySynGMActivity 活动数据
local ResourceRecoveryView = _G.BaseClass("ResourceRecoveryView", _G.UIBaseView)
--_G.ResourceRecoveryView = ResourceRecoveryView
local ActivitySynManager = require "ActivitySynManager"
local GetLangPackValue = _G.GetLangPackValue
local langugageColor = {
    num = _G.Color(130 / 255, 58 / 255, 15 / 255),
    numRed = _G.Color(255 / 255, 85 / 255, 85 / 255),
}
function ResourceRecoveryView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param activity ActivitySynGMActivity 活动数据
function ResourceRecoveryView:OnCreate(activity)
    self:UpdateView(activity)
end

---更新界面
function ResourceRecoveryView:UpdateView(activity)
    self.activity = activity
    self.activityTypeCls = activity:GetActivityTypeCls()
    self.go_table.scrollloopvectical_itemList:InitItemData(0, _G.handler(self, self.RefreshItem))
    self.go_table.aortext_time.text = GetLangPackValue(90000011633, self.activityTypeCls:GetCountDay())
    self.go_table.aortext_ratio1.text = GetLangPackValue(90000011635,
        _G.math.floor(_G.ConfigManager.discrete_cfg[116003][1][1] / 100) .. "%")
    self.go_table.aortext_ratio2.text = GetLangPackValue(90000011635,
        _G.math.floor(_G.ConfigManager.discrete_cfg[116003][1][2] / 100) .. "%")
    self.go_table.aorrawimage_price:LoadImage(_G.ConfigManager.currency_type_cfg
    [_G.ConfigManager.discrete_cfg[116002][1][1]].icon)
    local consumeNum = _G.ConfigManager.discrete_cfg[116002][1][2]
    self.go_table.aortext_price.text = tostring(consumeNum)
    local ownNum = _G.StorageManager:GetInstance():GetItemCountBySid(_G.ResPropID.Diamond)
    if consumeNum > ownNum then
        self.go_table.aortext_price.color = langugageColor.numRed
    else
        self.go_table.aortext_price.color = langugageColor.num
    end
    self.go_table.scrollloopvectical_itemList:UpdateCount(#self.activityTypeCls.totalAward.item)
end

---刷新物体
---@param index number 下标
---@param obj UnityEngine.GameObject 物体
function ResourceRecoveryView:RefreshItem(index, obj)
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        self.activityTypeCls.totalAward.item[index + 1].type,
        obj,
        function(item)
            item.gameObject:SetLocalScaleXYZ(1.1)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            item:ShowEffect(true)
        end,
        function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject,
                self.activityTypeCls.totalAward.item[index + 1].type[1])
        end
    )
end

---按钮点击事件在这里派发
function ResourceRecoveryView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_getAll then
        self.activityTypeCls:GetAward(1)
    elseif go == self.go_table.aorbtn_cash then
        local consumeNum = _G.ConfigManager.discrete_cfg[116002][1][2]
        local ownNum = _G.StorageManager:GetInstance():GetItemCountBySid(_G.ResPropID.Diamond)
        if ownNum < consumeNum then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ResPropID.Diamond)
            return
        end
        self.activityTypeCls:GetAward(2)
    elseif go == self.go_table.aorbtn_help then
        local data = self.activityTypeCls:GetAwardData()
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RecoveryDescribeView.Name, data)
    end
end

---关闭界面
function ResourceRecoveryView:CloseView()
    self:Close()
end

return ResourceRecoveryView
