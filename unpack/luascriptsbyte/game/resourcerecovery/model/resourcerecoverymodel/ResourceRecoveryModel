---解析数据
function ResourceRecoveryModel:ParseData(info)
    self:SetSelfData(info)
    base.ParseData(self)
end

---初始化数据
---@param info 
function ResourceRecoveryModel:SetSelfData(info)
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.ResourceRecoveryView.Name)
    if info.day == 0 or info.award == nil then 
        self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
        if window then
            window.View:CloseView(self.curActivityClass)
        end
        return 
    end
    self.totalAward = info.award or {}
    self.day = info.day
    if window then
        window.View:UpdateView(self.curActivityClass)
    end
end

---解析奖励数据
---@return tb 每天各功能奖励数据
function ResourceRecoveryModel:GetAwardData()
    local cfg = _G.ConfigManager.resource_ret_cfg
    local tb = {}
    local SystemMaterialController = require "SystemMaterialController"
    local index = 1
    for k,v in pairs(cfg) do
        if conditonFunc[v.functiontype](v.functionid) then
            tb[index] = {}
            tb[index].id = v.id
            tb[index].award = {}
            tb[index].functionname = nameFunc[v.functiontype](v.functionid)
            if v.functiontype == 3 then
                local systemID = v.functionid
                local rewardT
                if systemID == 105 then
                    rewardT = require "StarSoulModel":GetInstance():GetResourceRecoveryDatas()
                    rewardT = _G.StorageManager:GetInstance():MergeAwardList(rewardT)
                else
                    self.Datas = SystemMaterialController:GetInstance():GetDatas(systemID)
                    self.curFloor = SystemMaterialController:GetInstance():GetCurChallengeFloor(systemID)
                    self.curData =
                    self.Datas[SystemMaterialController:GetInstance():GetMaterailIDBySidAndFloor(systemID, self.curFloor - 1)]
                    rewardT = self.curData.cfg.reward
                end
                for j = 1, #rewardT do
                    local T1 = _G.DeepCopyCfgTable(rewardT[j])
                    T1[2] = _G.math.floor(T1[2] * v.param_count / 10000)
                    _G.table.insert(tb[index].award, T1)
                end
            else
                tb[index].award = _G.DeepCopyCfgTable(v.parameters)
                for j = 1, #v.parameters do
                    tb[index].award[j][2] = _G.math.floor(tb[index].award[j][2] * v.param_count / 10000)
                end
            end
            index = index + 1
        end
    end
    return tb
end
---进入活动
function ResourceRecoveryModel:OnEnterActivity()
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.ResourceRecoveryView.Name)
    if window then
        window.View:UpdateView(self.curActivityClass)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ResourceRecoveryView.Name, self.curActivityClass)
    end
    base.OnEnterActivity(self)
end

function ResourceRecoveryModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.ResourceRecoveryView.Name
end
---领取奖励
function ResourceRecoveryModel:GetAward(type, call)
    if self.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Close then
        return
    end
    local data = {type = type}
    ResourceRecoveryNet:GetInstance():GetAward(
        data,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.FuliView.Name)
            self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            require "CommonTipManager".OpenCommonAwardView(msg)
            if call then
                call()
            end
            self:UpdateRedPoint()
            if window then
                window.View:Close()
            end
        end
    )
end

---获取累计天数
function ResourceRecoveryModel:GetCountDay()
    return self.day or 1
end

---初始化红点
function ResourceRecoveryModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {{2}, false}
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function ResourceRecoveryModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---刷新红点
function ResourceRecoveryModel:UpdateRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

---检测红点
function ResourceRecoveryModel:CheckRedPoint()
    if self.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Close then
        return 0
    end
    return 1
end

return ResourceRecoveryModel
