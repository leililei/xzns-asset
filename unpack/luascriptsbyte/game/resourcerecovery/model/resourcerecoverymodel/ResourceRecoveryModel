local ActivitySynManager = require "ActivitySynManager"
local ResourceRecoveryNet = require("ResourceRecoveryNet")

local base = require "ActivitySynTypeBase"
---@class ResourceRecoveryModel :ActivitySynTypeBase 资源找回
local ResourceRecoveryModel = _G.BaseClass("ResourceRecoveryModel", base)
local idTransSystemID = {
    [8] = 102,
    [9] = 101,
    [10] = 105,
    [11] = 103,
    [12] = 106,
}
local conditonFunc = {
    [1] = function (id)
        return _G.GlobalConditionManager.CheckConditionByArray(_G.ConfigManager.function_open_cfg[id].condition_type)
    end,
    [2] = function (id)
        return ActivitySynManager:CheckConditionParams(_G.ConfigManager.activity_info_cfg[id].condition_display)
    end,
    [3] = function (id)
        local openID =  _G.ConfigManager.system_cfg[id].function_open
        local SystemMaterialController = require "SystemMaterialController"
        if id ~= 105 then 
            local curFloor = SystemMaterialController:GetInstance():GetCurChallengeFloor(id)
            if curFloor <= 1 then 
                return false
            end
        elseif not require "StarSoulModel":GetInstance():CheckOverAnyFloor() then
            return false
        end
        return _G.GlobalConditionManager.CheckConditionByArray(_G.ConfigManager.function_open_cfg[openID].condition_type)
    end,
}

local nameFunc = {
    [1] = function (id)
        return _G.ConfigManager.function_open_cfg[id].name
    end,
    [2] = function (id)
        return _G.ConfigManager.activity_info_cfg[id].name
    end,
    [3] = function (id)
        return _G.ConfigManager.system_cfg[id].name
    end,
}

