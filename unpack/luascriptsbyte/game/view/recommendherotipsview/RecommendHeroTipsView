local SpiritualDrawModel = require("SpiritualDrawModel"):GetInstance()
---@class RecommendHeroTipsView : UIBaseView	中文描述
---@field go_table RecommendHeroTipsView_GoTable
local RecommendHeroTipsView = _G.BaseClass("RecommendHeroTipsView", _G.UIBaseView)
local CardInfoManager = require("CardInfoManager"):GetInstance()




function RecommendHeroTipsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建对象时,入口构造函数
function RecommendHeroTipsView:OnCreate(id)
    self.itemList = {}
    self.ID = id
    self:Show(true)
end

function RecommendHeroTipsView:GetCard()
    local StorageManager = _G.StorageManager:GetInstance()
    local tb = {}
    local cardList = _G.ConfigManager.spiritual_cfg[self.ID].recommend or {}
    for _, v in pairs(cardList) do
        local data = StorageManager:GetMaxStarCardBySid(v)
        if not data then
            data = StorageManager:GetItemDataClass(v, 1)
        end
        if _G.ConfigManager.card_cfg[v].is_effective_hero == true then
            _G.table.insert(tb, data)
        end
    end
    ---@param a CardData
    _G.SortList(
        tb,
        function(a)
            local haveCard = a.sid ~= a.uid and 1 or 0
            return haveCard, a.sid
        end
    )
    return tb
end

function RecommendHeroTipsView:Show(isInit)
    self.CardData   = self:GetCard()

    local itemCount = #self.CardData
    if isInit then
        self.go_table.scrollloopvectical_CardList:InitItemData(itemCount, _G.handler(self, self.RefreshItemList))
    else
        if itemCount == self.lastItemCount then
            self.go_table.scrollloopvectical_CardList:UpdateAllItem()
        else
            self.go_table.scrollloopvectical_CardList:UpdateCount(itemCount)
        end
    end
    self.lastItemCount = itemCount
end

function RecommendHeroTipsView:RefreshItemList(index, obj)
        local instanceID = obj:GetInstanceIDE()
    local tb = self.itemList[instanceID]
    local data = self.CardData[index + 1]
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        tb.item = require "ItemCardAllView".New(tb.obj_Root:GetChildE(0))
        self.itemList[instanceID] = tb
    end
    tb.item:ShowCardData(data, nil, false)
    if data.sid == self.cardId then
        _G.GameUtil.SetActiveByCondition(tb.obj_use, true)
    else
        _G.GameUtil.SetActiveByCondition(tb.obj_use, false)
    end
    local isLock = data.uid == data.sid or data.uid == 0
    tb.index = index + 1
   
end


function RecommendHeroTipsView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_close" or name == "@_aorbtn_guanbi" then
        --关闭
        self:Close()
 
    end
end

---销毁对象时,析构函数
function RecommendHeroTipsView:OnDestroy()

end

return RecommendHeroTipsView
