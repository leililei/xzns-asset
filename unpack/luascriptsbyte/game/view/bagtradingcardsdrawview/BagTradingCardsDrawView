local baseView = require("BagUsePropTipView")
---@class BagTradingCardsDrawView : BagUsePropTipView	中文描述
---@field public go_table BagTradingCardsDrawView_GoTable GoTable
local BagTradingCardsDrawView = _G.BaseClass("BagTradingCardsDrawView", baseView)

function BagTradingCardsDrawView:OnUICreate()
    baseView.OnUICreate(self)
    self:InitProbability()
    self.model = require("TradingCardsModel"):GetInstance()
    self.dataList = {}
    for _,v in pairs(_G.ConfigManager.trading_card_album_cfg[self.itemData.cfg.UseParameter2[1][1]].albums) do
        for _,id in pairs(_G.ConfigManager.trading_card_collection_cfg[v].cards) do
            _G.table.insert(self.dataList, id)
        end
    end
    local cfg = _G.ConfigManager.trading_card_cfg
    _G.SortList(
        self.dataList,
        function(id)
            return cfg[id].quality, -cfg[id].star, id
        end
    )
    self.go_table.scrollloopvectical_item:InitItemData(#self.dataList, _G.handler(self, self.RefreashItem))
end

function BagTradingCardsDrawView:InitProbability()
    self.go_table.aortext_itemName.text = self.itemData:GetName()
    for _,v in pairs(_G.ConfigManager.discrete_cfg[202207]) do
        if v[1] == self.itemData.id then
            self.go_table.aortext_pro1.text = v[2] .. "%"
            self.go_table.aortext_pro2.text = v[3] .. "%"
            self.go_table.aortext_pro3.text = v[4] .. "%"
            self.go_table.aortext_pro4.text = v[5] .. "%"
            self.go_table.aortext_pro5.text = v[6] .. "%"
            return
        end
    end
    for _,v in pairs(_G.ConfigManager.discrete_cfg[202209]) do
        if v[1] == self.itemData.id then
            self.go_table.aortext_pro1.text = v[2] .. "%"
            self.go_table.aortext_pro2.text = v[3] .. "%"
            self.go_table.aortext_pro3.text = v[4] .. "%"
            self.go_table.aortext_pro4.text = v[5] .. "%"
            self.go_table.aortext_pro5.text = v[6] .. "%"
            return
        end
    end
end

function BagTradingCardsDrawView:RefreashItem(index, obj)
    index = index + 1
    local data = _G.ConfigManager.trading_card_cfg[self.dataList[index]]
    local go = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnItemClick, index))
    if not go.cardItem then
        go.cardItem = TradingCardsItemView.New(go.obj_card)
    end

    local sid = data.id
    local isActive = self.model:IsCollectActiveCard(sid)
    local ownNum = self.model:GetCollectCardNumber(sid)
    go.cardItem:Parse(sid, ownNum, isActive, true)
    go.obj_has:SetActiveE(isActive and 1 or 0)
    go.obj_noHas:SetActiveE(not isActive and 1 or 0)
    go.aortext_name.text = _G.GetLangPackValue(data.Name)
    go.aorimage_bg.SpriteName = cardBg[data.quality]
end

function BagTradingCardsDrawView:OnItemClick(_,_,index)
    _G.UIManager:GetInstance():OpenWindows(_G.ConfigManager.ui_cfg.TradingCardsCollectCardView.Name, 1, 2, true)
    self:Close()
end

---按钮点击事件在这里派发
function BagTradingCardsDrawView:OnClickBtn(go)
    if go == self.go_table.aorbtn_Prop then
        -- 使用抽奖逻辑
        local itemList = {{
            key = self.itemData.sid,
            value = self.propUseNum
        }}
        require("TradingCardsModel"):GetInstance():Draw(itemList, function()
            if self.closeCallBack then
                self.closeCallBack()
            end
            self:Close()
        end)
    elseif go == self.go_table.aorbtn_probability then
        self.go_table.obj_probability:SetActiveE(1)
    elseif go == self.go_table.aorbtn_closePro then
        self.go_table.obj_probability:SetActiveE(0)
    else
        baseView.OnClickBtn(self, go)
    end
end

return BagTradingCardsDrawView