---@class BagPropInfoTipView : UIBaseView    中文描述
---@field public go_table BagJumpTipView_GoTable GoTable
local BagPropInfoTipView = _G.BaseClass("BagPropInfoTipView", _G.UIBaseView)

local NameColor = {
    [1] = "FFFFFF",
    [2] = "076b2f",
    [3] = "1461a8",
    [4] = "612b8b",
    [5] = "d2510b",
    [6] = "c62121",
    [7] = "ce9c07",
    [8] = "B381FF"
}

function BagPropInfoTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function BagPropInfoTipView:OnCreate(itemData, closeCallBack)
    self.itemData = itemData
    self.closeCallBack = closeCallBack
    self:RefreshView()
    self:OnUICreate()
end

function BagPropInfoTipView:OnUICreate()
end

function BagPropInfoTipView:RefreshView()
    self.go_table.aortext_name.text = self.itemData:GetName()
    if self.itemData.Grade > 7 then
        require("CommonTipManager"):GetInstance():SetTextGradient({ "8E7CE5","5FC1F2" }, { 255, 255 }, self.go_table.aortext_name)
        self.go_table.aortext_name.color =  _G.Color.white
    else
        self.go_table.aortext_name.color = _G.ColorTools.FormatColorByString(NameColor[self.itemData.Grade] or "FFFFFF")
        require("CommonTipManager"):GetInstance():SetTextGradient({ "FFFFFF", "FFFFFF" }, { 255, 255 }, self.go_table.aortext_name)
    end
    self.go_table.aortext_num.text = _G.LangUtil.GetLangPackValue(90020200029, self.itemData.count)
    self.go_table.aortext_des.text = self.itemData:GetDescribe()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
            { self.itemData.sid, self.itemData.count },
            self.go_table.obj_item,
            function(itemLua)
                if self:IsNil() then
                    _G.DestroyObject(itemLua.gameObject)
                    return
                end
                if itemLua.ShowNumText then
                    itemLua:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
            end
    )
end

function BagPropInfoTipView:OnCloseView()
    if self.closeCallBack then
        self.closeCallBack()
    end
    self:Close()
end

---按钮点击事件在这里派发
function BagPropInfoTipView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_Close then
        self:Close()
    end
end

return BagPropInfoTipView
