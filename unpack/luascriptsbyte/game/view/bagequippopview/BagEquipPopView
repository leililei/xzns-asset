---@class BagEquipPopView : UIBaseView    中文描述
local BagEquipPopView = _G.BaseClass("BagEquipPopView", _G.UIBaseView)

function BagEquipPopView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---DeComposeCall 分解回调
function BagEquipPopView:OnCreate(data, DeComposeCall)
    self.data = data
    self.DeComposeCall = DeComposeCall
    _G.ItemFactory:GetInstance():GetItemCard(
        _G.ItemFactory.itemType.ItemEquipmentBase,
        self.go_table.obj_item,
        function(itemLua)
            self.Rightlua_Equip = itemLua
            self.Rightlua_Equip.gameObject:SetLocalScaleXYZ(1.06)
            self:FreshView()
        end
    )
    --self:FreshView()
end

function BagEquipPopView:FreshView()
    if self.Rightlua_Equip == nil or self.Rightlua_Equip == true then
        ----item还没生成
        return
    end
    ---@type   EquipmentItem
    local itemData = self.data
    if itemData == nil then
        self.Rightlua_Equip.gameObject:SetActiveE(0)
        return
    end
    -- 传入空点击回调，防止点击图标弹出tip
    self.Rightlua_Equip:ShowData(itemData,function() end)
    self.Rightlua_Equip:ShowCount()
    self.Rightlua_Equip.gameObject:SetActiveE(1)
    self.go_table.aorimage_Professiona.SpriteName = 
        require("CardInfoManager"):GetInstance():GetCardProfession_ByEquipmentType(itemData.cfg.professional)
    if itemData.element == 0 then
        self.go_table.obj_elementUp:SetActiveE(0)
    else     
        self.go_table.obj_elementUp:SetActiveE(1)
        require("CardInfoManager"):GetInstance():SetElementsProfessional(
            self.go_table.aorimage_element,
            itemData.element
        )
        self.go_table.aorimage_element:SetRectTransformSize(33,33)
    end
    self.go_table.aortext_name.text = itemData:GetName()
    local ctm = require "CommonTipManager":GetInstance()
    ctm:SetItemTextGradient(self.go_table.aortext_name.gameObject, itemData.Grade > 6 and 8 or itemData.Grade)
    self.go_table.aortext_num1.text = itemData:GetTextProfessional()
    self:Equip_Prop(self.go_table, itemData)
    self.go_table.aortext_zl.text = itemData:GetPower()
    self.go_table.aortext_des.text = itemData:GetDescribe()
    self.go_table.aortext_elementText1.text = _G.GetLangPackValue(90022300146,30)
end

function BagEquipPopView:Equip_Prop(go_Equip, itemData)
    ---要显示的属性
    local showAttr = {
        _G.AttrType.atk.key,
        _G.AttrType.bre.key,
        _G.AttrType.def.key,
        _G.AttrType.max_hp.key,
        _G.AttrType.hit_rate.key,
        _G.AttrType.avd_rate.key,
        _G.AttrType.cri_rate.key,
        _G.AttrType.cri_r_rate.key
    }
    local attr = {}
    local getProp = itemData:GetAllAttr()
    local addition = itemData.addition

    ---配置基础值
    for _, key in pairs(showAttr) do
        local num = getProp:GetValueByName(key)
        if num ~= 0 then
            table.insert(attr, {key = key, value = num})
        end
    end
    ---排序显示
    table.sort(
        attr,
        function(a, b)
            return _G.AttrType[a.key].sortid < _G.AttrType[b.key].sortid
        end
    )

    if go_Equip.propItemDic == nil then
        go_Equip.propItemDic = {}
    end

    local obj, info, baseValue, Value, tAttrType, key, lenSum
    local len = #attr
    local lenAdd = #addition
    lenSum = len
    for i = 1, len do
        ---生成属性条
        if go_Equip.propItemDic[i] == nil then
            obj = _G.InstantiateObject(go_Equip.obj_propItem, go_Equip.obj_prop)
            table.insert(go_Equip.propItemDic, obj)
        else
            obj = go_Equip.propItemDic[i]
        end

        info = attr[i]
        ---基础值
        baseValue = info.value

        tAttrType = _G.AttrType[info.key]
        if tAttrType.percentage == 1 then
            baseValue = baseValue * 100

            baseValue = _G.GameUtil.FormatNum(baseValue)
            baseValue = baseValue .. "%"
        else
            baseValue = _G.math.floor(baseValue)
        end

        self:Equip_SetProp(obj, "4e5278", _G.AttrType[info.key].des, baseValue, i, len == i)

        obj:SetActiveE(1)
    end

    if lenAdd > 0 then
        local i = len + 1
        local equipment_add_att_cfgItem, color, sid, num
        local equipment_add_att_cfg = _G.ConfigManager.equipment_add_att_cfg
        for j, info in pairs(addition) do
            ---生成属性条
            if go_Equip.propItemDic[i] == nil then
                obj = _G.InstantiateObject(go_Equip.obj_propItem, go_Equip.obj_prop)
                table.insert(go_Equip.propItemDic, obj)
            else
                obj = go_Equip.propItemDic[i]
            end

            sid = info.k
            num = info.v

            equipment_add_att_cfgItem = equipment_add_att_cfg[sid]
            key = equipment_add_att_cfgItem.type_attribute
            ---基础值
            baseValue = itemData.additionValue[j][2]

            tAttrType = _G.AttrType[key]
            baseValue = baseValue * 100
            baseValue = _G.GameUtil.FormatNum(baseValue)
            baseValue = baseValue .. "%"
            color = require("EquipmentModel"):GetInstance():GetAddAttColor(sid, num, 2)
            self:Equip_SetProp(obj, color, _G.AttrType[key].des, baseValue, i - len, len == i)

            obj:SetActiveE(1)
            i = i + 1
        end
        lenSum = lenSum + i
    end

    lenSum = lenSum + 1
    for i = lenSum, #go_Equip.propItemDic do
        go_Equip.propItemDic[i]:SetActiveE(0)
    end
end

---@param index number 判断显示条纹
function BagEquipPopView:Equip_SetProp(obj, color, name, num, index, isMax)
    local go_table = _G.GetAutoGoTable(obj)

    go_table.aorimage_di:SetActiveE(index % 2 == 0 and 1 or 0)

    go_table.aortext_des.text = string.format("<color=#%s>%s</color>", color, tostring(name))
    go_table.aortext_num.text = string.format("<color=#%s>%s</color>", color, tostring(num))
end

function BagEquipPopView:OnClickBtn(go, isOn)
    --local name = go:GetName()
    if go == self.go_table.aorbtn_Close or go == self.go_table.aorbtn_CloseView then 
        self:Close()
    elseif go == self.go_table.aorbtn_decomposeE then 
        self:OnClickEquipmentDecompose()
    end
end

function BagEquipPopView:OnClickEquipmentDecompose()
    local params = {}
    --params.ID = _G.StorageID.Equipment
    params.DeComposeCall = self.DeComposeCall
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecomposeView.Name, _G.StorageID.Equipment, params)
end

return BagEquipPopView