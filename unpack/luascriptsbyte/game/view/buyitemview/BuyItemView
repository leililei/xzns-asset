---@class BuyItemView : UIBaseView
local BuyItemView = BaseClass("BuyItemView", UIBaseView)

function BuyItemView:Awake()
    AddViewBtnClick(self.go_table.gameObject, handler(self, self.OnClickBtn))
    self.go_table.slider_SetNum.onValueChanged:AddListener(handler(self, self.SliderValueChange))
end

-- 启动
function BuyItemView:OnCreate()
    self.go_table.aortext_title.text = "BuyItemView"
    self.go_table.aortext_Cancel.text = "取消"
    self.go_table.aortext_Close.text = "关闭"
    self.go_table.aortext_Confrim.text = "购买"
    self.go_table.aortext_Num.text = 0
end

-- 按钮单击事件--
function BuyItemView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_Cancel" then
        self.go_table.slider_SetNum.value = 0
    end

    if name == "@_aorbtn_Confrim" then
        if _G.AppSetting.DEBUG then
            _G.Log(
                "<color=red><size=20>" .. "OnConfrimBtn:    " .. self.go_table.slider_SetNum.value .. "</size></color>"
            )
        end
    end

    if name == "@_aorbtn_Close" then
        self:Close()
    end
end

function BuyItemView:SliderValueChange(value)
    self.go_table.aortext_Num.text = value * 100
end

function BuyItemView:OnDestroy()
end

return BuyItemView
