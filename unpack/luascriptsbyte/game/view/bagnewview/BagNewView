        elseif itemDataType == self.ItemDataType.CarvingData then
            --圣徽
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CarvingTipView.Name,
                itemData,
                itemData.cfg,
                false,
                itemData.cardUid ~= 0 and _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, itemData.cardUid) or nil,
                _G.handler(self, self.RefreshCarvingList),
                false,
                false,
                false
            )
        elseif itemDataType == self.ItemDataType.GemstoneData then
            -- 宝石
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.GemstoneTipView.Name,
                {
                    data = itemData,
                    btn = {
                        GoBtnCall = function()
                            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GemstoneToggleView.Name)
                            self:Close()
                        end
                    }
                }
            )
        end
    end
end

---一键开启
function BagNewView:OnOneKeyOpen()
    local itemDatas = {}
    local dataCount = 0
    local maxItemCount = _G.ConfigManager.discrete_cfg[119002][1][1]
    for _, v in pairs(self.ItemDataAllList) do
        if v.clickon then
            if v.cfg.UseType == _G.ItemUseType.ProgressChest then
                local num = v:GetProgressChestSelectNum()
                if num then
                    _G.table.insert(itemDatas, { sid = v.sid, num = num })
                    dataCount = dataCount + 1
                end
            else
                local num = v.count > v.cfg.limit_num and v.cfg.limit_num or v.count
                _G.table.insert(itemDatas, { sid = v.sid, num = num })
                dataCount = dataCount + 1
            end
            if dataCount >= maxItemCount then
                break
            end
        end
    end
    if not _G.table.isEmptyOrNil(itemDatas) then
        if _G.StorageManager:GetInstance():CheckBagOpenTip() then
            _G.StorageManager:GetInstance():PropBatchUse(
                itemDatas,
                true,
                1,
                nil,
                _G.handlerbind(self, self.UpdateView, self.selectToggleTab)
            )
        else
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.BagBatchUseView.Name,
                1,
                itemDatas,
                itemDatas,
                _G.handlerbind(self, self.UpdateView, self.selectToggleTab)
            )
        end
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(380110)
    end
end

