function BagNewView:OnClick_item(itemGoTable)
    if itemGoTable == nil then
        return
    end
    if itemGoTable.itemData == nil then
        return
    end
    if self.itemDataType and self.itemDataType == self.ItemDataType.PropData and self.itemDataSid == itemGoTable.sid then
        return
    end
    self.clickArrow = false
    local index = itemGoTable.DataIndex
    self:ShowItemInfo(itemGoTable)
    self.ItemDataAll_Index = index - 1
    self.itemDataType = self:GetItemDataType(itemGoTable)
    self.itemDataSid = itemGoTable.sid

    if nil ~= self.ItemImangeOn then
        self.ItemImangeOn:SetActiveE(0)
    end

    self.ItemImangeOn = itemGoTable.aorimage_on
    self.ItemImangeOn:SetActiveE(1)
    local thisGrad = itemGoTable.itemData.Grade
    local thisItemDataType = self:GetItemDataType(itemGoTable.itemData)
    if thisItemDataType == self.ItemDataType.EquipmentItem and thisGrad >= 8 then
        itemGoTable.obj_qkxBg:SetActiveE(1)
        local tqkx = qkx[thisGrad]
        local isqkx = tqkx ~= nil
        if isqkx then
            itemGoTable.aorimage_qkx.SpriteName = tqkx
        end
    else
        itemGoTable.obj_qkxBg:SetActiveE(0)
    end

    --self.go_table.scrollloopvectical_item:UpdateAllItem()

    local itemData = itemGoTable.itemData
    local resumeCfg = _G.ConfigManager.discrete_cfg[103712][1]
    if itemData.sid == resumeCfg[1] and itemData.count ~= _G.PlayerPrefsManager.GetInt("CardRest_Prop_RedPoint", 0) then
        _G.PlayerPrefsManager.SetInt("CardRest_Prop_RedPoint", itemData.count)
        require("RedPointManager"):GetInstance():RefreshNode(
            _G.ConfigManager.redpoint_cfg.BackpackItem.id,
            itemData.sid
        )
    end
end

