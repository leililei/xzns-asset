    self:RemoveListener(_G.eRune.RuneRemove, self.RefreshRuneList)
    self:RemoveListener(_G.eCarving.CarvingRemove, self.RefreshCarvingList)
    self:RemoveListener(_G.eBag.BagRechargeAccOverdue, self.RefreshPropList)
    self:RemoveListener(_G.eBag.BagVoucherDiscountOverdue, self.RefreshPropList)
end

return BagNewView
