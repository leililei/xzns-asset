function BagNewView:SetLoopItem(itemGoTable)
    --region --------------------------------------生成对应item--------
    ------@type PropData
    local itemData = itemGoTable.itemData
    local itemDataType = self:GetItemDataType(itemData)

    local redpointId = _G.ConfigManager.redpoint_cfg.BackpackItem.id
    local redSid_BackpackItem = 0

    if itemDataType == self.ItemDataType.PropData then
        redSid_BackpackItem = itemData.sid
        ---没生成对象
        if itemGoTable.lua_Prop == nil then
            ---开始生成对象 并标记
            ---@type itemViewNewWithCount
            itemGoTable.lua_Prop = true

            _G.ItemFactory:GetInstance():GetItemCard(
                _G.ItemFactory.itemType.ItemBaseWithCount,
                itemGoTable.obj_item,
                function(itemLua)
                    itemGoTable.lua_Prop = itemLua
                    --itemLua.gameObject:SetLocalScaleXYZ(1.08)
                    self:SetPropItem(itemGoTable)
                end
            )
        elseif itemGoTable.lua_Prop ~= true then
            ---已生成对象
            self:SetPropItem(itemGoTable)
        end
    else
        if itemGoTable.lua_Prop and itemGoTable.lua_Prop ~= true then
            itemGoTable.lua_Prop.gameObject:SetActiveE(0)
        end
    end

    if itemDataType == self.ItemDataType.EquipmentItem then
        ---没生成对象
        if itemGoTable.lua_Equip == nil then
            ---开始生成对象 并标记
            ---@type ItemEquipmentBase
            itemGoTable.lua_Equip = true
            _G.ItemFactory:GetInstance():GetItemCard(
                _G.ItemFactory.itemType.ItemEquipmentBase,
                itemGoTable.obj_item,
                function(itemLua)
                    itemGoTable.lua_Equip = itemLua
                    --itemLua.gameObject:SetLocalScaleXYZ(1.06)
                    self:SetEquipItem(itemGoTable)
                end
            )
        elseif itemGoTable.lua_Equip ~= true then
            ---已生成对象
            self:SetEquipItem(itemGoTable)
        end
    else
        if itemGoTable.lua_Equip and itemGoTable.lua_Equip ~= true then
            itemGoTable.lua_Equip.gameObject:SetActiveE(0)
        end
    end

    if itemDataType == self.ItemDataType.DebrisData then
        redpointId = _G.ConfigManager.redpoint_cfg.BackpackItemDebris.id
        redSid_BackpackItem = itemData.sid
        ---没生成对象
        if itemGoTable.lua_Debris == nil then
            ---开始生成对象 并标记
            ---@type ItemDebrisBase
            itemGoTable.lua_Debris = true
            _G.ItemFactory:GetInstance():GetItemCard(
                _G.ItemFactory.itemType.ItemDebrisBase,
                itemGoTable.obj_item,
                function(itemLua)
                    itemGoTable.lua_Debris = itemLua
                    itemLua.gameObject:SetLocalScaleXYZ(1)
                    self:SetDebrisItem(itemGoTable)
                end
            )
        elseif itemGoTable.lua_Debris ~= true then
            ---已生成对象
            self:SetDebrisItem(itemGoTable)
        end
    else
        if itemGoTable.lua_Debris and itemGoTable.lua_Debris ~= true then
            itemGoTable.lua_Debris.gameObject:SetActiveE(0)
        end
    end

    if itemDataType == self.ItemDataType.Card then
        ---没生成对象
        if itemGoTable.lua_Card == nil then
            ---开始生成对象 并标记
            ---@type ItemCardAllView
            itemGoTable.lua_Card = true
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.CardAllItem,
                itemGoTable.obj_item,
                function(itemLua)
                    itemGoTable.lua_Card = itemLua
                    itemLua.gameObject:SetLocalScaleXYZ(0.846)
                    self:SetCardItem(itemGoTable)
                end
            )
        elseif itemGoTable.lua_Card ~= true then
            ---已生成对象
