function BagNewView:ShowItemInfo(itemGoTable, itemData)
    if itemData == nil then
        itemData = itemGoTable and itemGoTable.itemData or nil
    end

    local Cpwindow = itemData.cfg.Cpwindow
    if Cpwindow then
        if Cpwindow == 1 then
            ---随机道具类型宝箱弹窗
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.BagPropPopView.Name,
                itemData,
                _G.handlerbind(self, self.UpdateView, self.selectToggleTab)
            )
        elseif Cpwindow == 2 then
            ---自选宝箱类型弹窗
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.BagChoosePropTipView.Name,
                itemData,
                _G.handlerbind(self, self.UpdateView, self.selectToggleTab)
            )
        elseif Cpwindow == 3 then
            ---跳转界面使用类型道具弹窗
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BagJumpTipView.Name, itemData)
        elseif Cpwindow == 4 then
            ---背包内直接使用的道具类型弹窗
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.BagUsePropTipView.Name,
                itemData,
                _G.handlerbind(self, self.UpdateView, self.selectToggleTab)
            )
        elseif Cpwindow == 5 then
            ---不可背包内直接使用且不支持跳转的道具类型弹窗
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BagPropInfoTipView.Name, itemData)
        elseif Cpwindow == 6 then
            ---任务奖励道具类型弹窗
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.BagTaskTipView.Name,
                itemData,
                _G.handlerbind(self, self.UpdateView, self.selectToggleTab)
            )
        elseif Cpwindow == 7 then
            if itemData.cfg.UseType == 27 then
                local unlockRune = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Rune)
                if not unlockRune then
                    _G.PopWindowManager:GetInstance():ShowAllTips(1080004, _G.GetLangPackValue(2148006033))
                    return
                end
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.RuneItemUseView.Name,
                    itemData,
                    _G.handlerbind(self, self.UpdateView, self.selectToggleTab)
                )
                return
            end
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.BoxUseView.Name,
                itemData,
                _G.handlerbind(self, self.UpdateView, self.selectToggleTab)
            )
        elseif Cpwindow == 8 then
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.BagRechargeAccumulateView.Name,
                itemData,
                _G.handlerbind(self, self.UpdateView, self.selectToggleTab)
            )
        elseif Cpwindow == 9 then
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.BagVoucherDiscountView.Name,
                itemData,
                _G.handlerbind(self, self.UpdateView, self.selectToggleTab)
            )
        elseif Cpwindow == 10 then
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.BagTradingCardsDrawView.Name,
                itemData,
                _G.handlerbind(self, self.UpdateView, self.selectToggleTab)
            )
        end
    else
        local itemDataType = self:GetItemDataType(itemData)
        if itemDataType == self.ItemDataType.EquipmentItem then
            ---装备
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.BagEquipPopView.Name,
                itemData,
                _G.handlerbind(self, self.UpdateView, self.selectToggleTab)
            )
        elseif itemDataType == self.ItemDataType.ArtifactData then
            ---神器
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.BagArtifectPopView.Name,
                itemData,
                _G.handlerbind(self, self.UpdateView, self.selectToggleTab),
                _G.handlerbind(self, self.UpdateView, self.selectToggleTab, itemData.sid)
            )
        elseif itemDataType == self.ItemDataType.SpiritualData then
            ---圣物/宝物
            ---宝物的分解升星界面做了之后替换。
            -- require "CommonTipManager":GetInstance():OpenTip(itemGoTable, itemData.sid, itemData.uid, nil, true)
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.BagArtifectPopView.Name,
                itemData,
                _G.handlerbind(self, self.UpdateView, self.selectToggleTab),
                _G.handlerbind(self, self.UpdateView, self.selectToggleTab, itemData.sid)
            )
        elseif itemDataType == self.ItemDataType.DecorationData then
            --符文
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.RuneTipView.Name,
                itemData,
                itemData.cfg,
                false,
                itemData.cardUid ~= 0 and _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, itemData.cardUid) or nil,
                _G.handler(self, self.RefreshRuneList),
                false,
                false,
                false
