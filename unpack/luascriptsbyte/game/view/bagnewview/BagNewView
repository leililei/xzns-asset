---@class params_BagNewView Data

---界面的入口函数
---@param  open number 默认打开界面
---@param  Data params_BagNewView
function BagNewView:OnCreate(open, Data)
    self:InitToggleTab()
    self.selectToggleTab = open or self.BtnsType.PropData
    if self.selectToggleTab == self.BtnsType.PropData then
        self.go_table.toggle_prop.isOn = false
    end
    self.toggles[self.selectToggleTab].isOn = true
end

---底部页签
function BagNewView:InitToggleTab()
    self.toggles = {
        [self.BtnsType.PropData] = _G.GetAutoGoTable(
            self.go_table.toggle_prop,
            _G.handlerbind(self, self.OnClickToggle, self.BtnsType.PropData)
        ),
        [self.BtnsType.DebrisData] = _G.GetAutoGoTable(
            self.go_table.toggle_debris,
            _G.handlerbind(self, self.OnClickToggle, self.BtnsType.DebrisData)
        ),
        [self.BtnsType.EquipmentItem] = _G.GetAutoGoTable(
            self.go_table.toggle_equipment,
            _G.handlerbind(self, self.OnClickToggle, self.BtnsType.EquipmentItem)
        )
    }
    self.equipToggles = {
        [self.BtnsType.EquipmentItem] = _G.GetAutoGoTable(
            self.go_table.toggle_equip,
            _G.handlerbind(self, self.OnClickEquipToggle, self.BtnsType.EquipmentItem)
        ),
        [self.BtnsType.ArtifactData] = _G.GetAutoGoTable(
            self.go_table.toggle_artifact,
            _G.handlerbind(self, self.OnClickEquipToggle, self.BtnsType.ArtifactData)
        ),
        [self.BtnsType.SpiritualData] = _G.GetAutoGoTable(
            self.go_table.toggle_spiritual,
            _G.handlerbind(self, self.OnClickEquipToggle, self.BtnsType.SpiritualData)
        ),
        [self.BtnsType.RuneData] = _G.GetAutoGoTable(
            self.go_table.toggle_rune,
            _G.handlerbind(self, self.OnClickEquipToggle, self.BtnsType.RuneData)
        ),
        [self.BtnsType.CarvingData] = _G.GetAutoGoTable(
            self.go_table.toggle_carving,
            _G.handlerbind(self, self.OnClickEquipToggle, self.BtnsType.CarvingData)
        ),
        [self.BtnsType.GemstoneData] = _G.GetAutoGoTable(
            self.go_table.toggle_gemstone,
            _G.handlerbind(self, self.OnClickEquipToggle, self.BtnsType.GemstoneData)
        )
    }

    self.noToggleTip = true
    self.go_table.toggle_quickUsePop.isOn = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.QuickUsePopEnbale, 1) == 1
    self.noToggleTip = false
end

function BagNewView:OnClickToggle(go, isOn, key)
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if isOn then
        self.go_table.toggle_quickUsePop:SetActiveE(key == self.BtnsType.PropData and 1 or 0)
        self.selectToggleTab = key
        self:SetBtnInfo(key)
        if self.selectToggleTab == self.BtnsType.EquipmentItem then
            self.go_table.toggle_equip.isOn = false
            self.go_table.toggle_equip.isOn = true
        end
    end
end

function BagNewView:OnClickEquipToggle(go, isOn, key)
    local tb = self.equipToggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    self.go_table.aorbtn_decompose:SetActiveE((isOn and (key == self.BtnsType.RuneData or key == self.BtnsType.GemstoneData)) and 0 or 1)
    if isOn then
        self.selectToggleTab = key
        self:SetBtnInfo(key)
    end
end

---@param BtnsType BtnsType  要重新拉仓库的类型
---@param sid number  继续选中该选择物品
function BagNewView:UpdateView(BtnsType, sid)
    if BtnsType ~= nil then
        self:GetList(BtnsType)
    end
    self:SetAllList()
    local count = #self.ItemDataAllList
    _G.GameUtil.SetActiveByCondition(
        self.go_table.aorbtn_open,
        count > 0 and self.selectToggleTab == self.BtnsType.PropData
    )
    _G.GameUtil.SetActiveByCondition(
        self.go_table.aorbtn_compose,
        count > 0 and self.selectToggleTab == self.BtnsType.DebrisData
    )
    _G.GameUtil.SetActiveByCondition(
        self.go_table.obj_equipTab,
        self.selectToggleTab == self.BtnsType.EquipmentItem or self.selectToggleTab == self.BtnsType.ArtifactData or
            self.selectToggleTab == self.BtnsType.SpiritualData or self.selectToggleTab == self.BtnsType.RuneData or self.selectToggleTab == self.BtnsType.CarvingData or
            self.selectToggleTab == self.BtnsType.GemstoneData
    )
    if sid ~= nil then
        ----保持在当前选中物品
        for i = 1, count do
            if self.ItemDataAllList[i].sid == sid then
                self.ItemDataAll_Index = i - 1
                break
            end
        end
    else
        -- if BtnsType ~= nil then
        --     if self.ItemDataAll_Index > count then
        --         self.ItemDataAll_Index = count - 1
        --     end
        -- else
        --     self.ItemDataAll_Index = self.ItemDataAll_Index - 1
        -- end
        self.ItemDataAll_Index = -1
    end
    self:UpdataList(BtnsType == nil)
end

----获取背包该类型所有数据
function BagNewView:GetList(BtnsType)
    if BtnsType == self.BtnsType.PropData then
        local PropDic = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Prop)
        local MaterialDic = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Material)
        self.ItemDataList_Prop = _G.table.values(PropDic)
        _G.table.insertto(self.ItemDataList_Prop, _G.table.values(MaterialDic))

        ---@param a PropData
        _G.SortList(
            self.ItemDataList_Prop,
            function(a)
                if a == nil or a.Grade == nil or a.sid == nil then
                    if _G.AppSetting.DEBUG then
                        _G.Log(" id：" .. a.sid, "<color=red>" .. "有不存在的道具 是否GM创建" .. "</color>")
                    end
                    return 0, 0
                end
                local display_priority = a.cfg.display_priority == 0 and 99 or a.cfg.display_priority
                return -display_priority, a.Grade, a.sid
            end
        )
    elseif BtnsType == self.BtnsType.EquipmentItem then
        local EquipmentDic = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Equipment)
        self.ItemDataList_Equip = _G.table.values(EquipmentDic)

        ---@param a EquipmentItem
        _G.SortList(
            self.ItemDataList_Equip,
            function(a)
                return a.Grade, a:GetPower(), a.uid
            end
        )
    elseif BtnsType == self.BtnsType.DebrisData then
        local DebrisDic = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Debris)
        self.ItemDataList_Debris = _G.table.values(DebrisDic)

        ---@param a DebrisData
        _G.SortList(
            self.ItemDataList_Debris,
            function(a)
                return a:GetOrder(), a.sid
            end
        )
    elseif BtnsType == self.BtnsType.ArtifactData then
        local ArtifactDic = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Artifact)
        self.ItemDataList_Artifact = _G.table.values(ArtifactDic)

        ---@param a ArtifactData
        _G.SortList(
            self.ItemDataList_Artifact,
            function(a)
                return a.awaken, a:GetOrder(), a.star, a.lv, ProfSort[a:GetProfessional()], a.sid, a.uid
            end
        )
    elseif BtnsType == self.BtnsType.SpiritualData then
        local SpiritualDic = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Spiritual)
        self.ItemDataList_Spiritual = _G.table.values(SpiritualDic)

        ---@param a SpiritualData
        _G.SortList(
            self.ItemDataList_Spiritual,
            function(a)
                return a:GetOrder(), a.star, a.lv, a.sid
            end
        )
    elseif BtnsType == self.BtnsType.RuneData then
        local DecorationDic = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Decoration)
        self.ItemDataList_Rune = _G.table.values(DecorationDic)

        ---@param a DecorationData
        _G.SortList(
            self.ItemDataList_Rune,
            function(a)
                return a.Grade, a.suit
            end
        )
    elseif BtnsType == self.BtnsType.CarvingData then
        local CarvingDic = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Carving)
        self.ItemDataList_Carving = _G.table.values(CarvingDic)

        ---@param a CarvingData
        _G.SortList(
            self.ItemDataList_Carving,
            function(a)
                return a.Grade, a.suit
            end
        )
    elseif BtnsType == self.BtnsType.GemstoneData then
        -- local GemDic = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Gemstone)
        local GmeDic = require("GemstoneModel"):GetInstance():GetAllGemData()
        self.ItemDataList_Gemstone = _G.table.values(GmeDic)
        ---@param a CarvingData
        _G.SortList(
            self.ItemDataList_Gemstone,
            function(a)
                return a.cardUid == 0 and 0 or 1, a.grade, a.star, a.level, a.sid
            end
        )
    end
end

function BagNewView:SetAllList()
    self.ItemDataAllList = {}

    if self.nowBtnIndex == self.BtnsType.PropData then
        _G.table.insertto(self.ItemDataAllList, self.ItemDataList_Prop)
    elseif self.nowBtnIndex == self.BtnsType.EquipmentItem then
        _G.table.insertto(self.ItemDataAllList, self.ItemDataList_Equip)
    elseif self.nowBtnIndex == self.BtnsType.DebrisData then
        _G.table.insertto(self.ItemDataAllList, self.ItemDataList_Debris)
    elseif self.nowBtnIndex == self.BtnsType.ArtifactData then
        _G.table.insertto(self.ItemDataAllList, self.ItemDataList_Artifact)
    elseif self.nowBtnIndex == self.BtnsType.SpiritualData then
        _G.table.insertto(self.ItemDataAllList, self.ItemDataList_Spiritual)
    elseif self.nowBtnIndex == self.BtnsType.RuneData then
        _G.table.insertto(self.ItemDataAllList, self.ItemDataList_Rune)
    elseif self.nowBtnIndex == self.BtnsType.CarvingData then
        _G.table.insertto(self.ItemDataAllList, self.ItemDataList_Carving)
    elseif self.nowBtnIndex == self.BtnsType.GemstoneData then
        _G.table.insertto(self.ItemDataAllList, self.ItemDataList_Gemstone)
    end
end

function BagNewView:UpdataList(isChange)
    local nowCount = #self.ItemDataAllList
    if nowCount == 0 then
        self.go_table.scrollloopvectical_item:SetActiveE(0)
        self.go_table.obj_null:SetActiveE(1)
    else
        self.go_table.scrollloopvectical_item:SetActiveE(1)
        self.go_table.obj_null:SetActiveE(0)
    end

    ---最少显示25个空格子
    local minCount = 30
    if nowCount < minCount then
        nowCount = minCount
    end
    -- if self.ItemDataAll_Index < 0 or self.ItemDataAll_Index >= nowCount then
    --     self.ItemDataAll_Index = 0
    -- end
    if self.OldCount ~= nowCount then
        self.go_table.scrollloopvectical_item:UpdateCount(nowCount, 0, 0, 0)
        self.OldCount = nowCount
    else
        self.go_table.scrollloopvectical_item:UpdateAllItem()
    end

    self.Init_Loop = true
end

