    itemGoTable.itemData = itemData
    itemGoTable.DataIndex = index + 1
    if itemGoTable.addClick == nil then
        itemGoTable.aorbtn_click.onClick:AddListener(_G.handlerbind(self, self.OnClick_item, itemGoTable))
