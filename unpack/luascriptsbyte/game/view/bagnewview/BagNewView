---一键合成
function BagNewView:OnOneKeyCompose()
    local itemDatas = {}
    local showItemDatas = {}
    local dataCount = 0
    local maxItemCount = _G.ConfigManager.discrete_cfg[119002][1][1]
    for _, v in ipairs(self.ItemDataAllList) do
        if v.clickcompositing then
            local needNum = _G.tonumber(v.cfg.UseParameter[1][1])
            local num = _G.Mathf.Floor(v.count / needNum)
            num = num > v.cfg.limit_num and v.cfg.limit_num or num
            if num >= 1 then
                _G.table.insert(itemDatas, { sid = v.sid, num = num })
                _G.table.insert(showItemDatas, { sid = v.sid, num = num * needNum })
                dataCount = dataCount + 1
            end
            if dataCount >= maxItemCount then
                break
            end
        end
    end
    if not _G.table.isEmptyOrNil(itemDatas) then
        if _G.StorageManager:GetInstance():CheckBagComposeTip() then
            _G.StorageManager:GetInstance():PropBatchUse(
                itemDatas,
                true,
                2,
                nil,
                _G.handlerbind(self, self.UpdateView, self.selectToggleTab)
            )
        else
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.BagBatchUseView.Name,
                2,
                itemDatas,
                showItemDatas,
                _G.handlerbind(self, self.UpdateView, self.selectToggleTab)
            )
        end
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(380109)
    end
end

