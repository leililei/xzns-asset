local baseView = require("BagPropInfoTipView")
---@class BagVoucherDiscountView : BagPropInfoTipView    中文描述
---@field public go_table BagVoucherDiscountView_GoTable GoTable
local BagVoucherDiscountView = _G.BaseClass("BagVoucherDiscountView", baseView)

function BagVoucherDiscountView:OnUICreate()
    local path = "UIH5/Common/CommonTipView/View/$_obj_VoucherDiscount"
    _G.PoolsManager:GetInstance():Spawn(
        path,
        _G.ePoolType.Temporary,
        self.go_table.obj_tipView,
        function(trans)
            trans:RequireComponentE(_G.typeof(_G.CS.AorGraphicRaycaster))
            local view = self:AddComponent(trans.gameObject, require("VoucherDiscountTipView").New(trans, self, true))
            view:Init(self.itemData)
            self.view = view
        end
    )
end

function BagVoucherDiscountView:RefreshView()
end

function BagVoucherDiscountView:CloseTip()
    self:OnCloseView()
end

return BagVoucherDiscountView