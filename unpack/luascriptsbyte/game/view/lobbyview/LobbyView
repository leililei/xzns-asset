---@class Lobby : UIBaseView
local LobbyView = BaseClass("LobbyView", UIBaseView)

function LobbyView:Awake()
    AddViewBtnClick(self.go_table.gameObject, handler(self, self.OnClickBtn))
end

-- 启动
function LobbyView:OnCreate()
    self.go_table.aortext_title.text = "LobbyView"
    self.go_table.aortext_OpenBag.text = "打开背包"
end

-- 按钮单击事件--
function LobbyView:OnClickBtn(go)
    local name = go:GetName()
    if _G.AppSetting.DEBUG then
        _G.Log("<color=red><size=20>" .. "OnClickBtn:    " .. name .. "</size></color>")
    end
    if name == "@_aorbtn_OpenBag" then
        UIManager:GetInstance():OpenWindow("BagNewView")
    end
end

function LobbyView:OnDestroy()
end

return LobbyView
