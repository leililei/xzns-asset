local baseView = require("BagPropInfoTipView")
---@class BagUsePropTipView : BagPropInfoTipView    中文描述
---@field public go_table BagJumpTipView_GoTable GoTable
local BagUsePropTipView = _G.BaseClass("BagUsePropTipView", baseView)

local tonumber = _G.tonumber
function BagUsePropTipView:OnUICreate()
    self.PropUseNumType = {
        [_G.ItemUseType.CardOptional] = 1,
        [_G.ItemUseType.TreasureMap] = 1,
        [_G.ItemUseType.GetTitle] = 1,
        [_G.ItemUseType.GetSkin] = 1,
        [_G.ItemUseType.Events] = 1,
        [_G.ItemUseType.GetHalo] = 1,
        [_G.ItemUseType.GetFrame] = 1,
        [_G.ItemUseType.SettingTheme] = 1,
        [_G.ItemUseType.GetChatFrame] = 1
    }
    ---材料消耗类型
    self.PropUseNumDic = {
        [_G.ItemUseType.ItemDrop] = true,
        [_G.ItemUseType.DrawCard] = true,
        [_G.ItemUseType.CompoundCard] = true,
        [_G.ItemUseType.CompoundProp] = true
    }
    self.go_table.input_useNum.onEndEdit:AddListener(_G.handler(self, self.OnEndEditorDeclaration))
    self:InitPropUseCount()
end

function BagUsePropTipView:SetPropUseInfo()
    self.go_table.input_useNum.text = self.propUseNum
end

function BagUsePropTipView:InitPropUseCount()
    local cfgItem = self.itemData.cfg
    if self.PropUseNumType[cfgItem.UseType] then
        self.propUseNum = self.PropUseNumType[cfgItem.UseType]
    elseif cfgItem.UseType == _G.ItemUseType.SecretRealm then
        self.secretRealmIndex = require "SecretRealmModel":GetInstance():GetCurBattleIndex()
        self.propUseNum = require "SecretRealmModel":GetInstance():GetTicketUseNum(self.secretRealmIndex)
    else
        self.propUseNum = self:PropUseMaxCount()
    end
    self:SetPropUseInfo()
end

function BagUsePropTipView:OnEndEditorDeclaration(input)
    if not tonumber(input) then
        input = self.propUseNum
    end
    local num = tonumber(input)
    local max = self:PropUseMaxCount()
    local min = self:PropUseMinCount()
    self.propUseNum = _G.Mathf.Clamp(num, min, max)
    self:SetPropUseInfo()
end

---返回可使用的最小次数
function BagUsePropTipView:PropUseMinCount()
    local num = self.itemData.count

    local baseNum = 1
    if self.PropUseNumDic[self.itemData.cfg.UseType] then
        baseNum = tonumber(self.itemData.cfg.UseParameter[1][1])
    end
    local minCount = _G.math.floor(num / baseNum)
    return minCount > 0 and 1 or minCount
end

----返回可使用的最大次数
function BagUsePropTipView:PropUseMaxCount()
    local num = self.itemData.count
    local baseNum = 1
    if self.PropUseNumDic[self.itemData.cfg.UseType] then
        baseNum = tonumber(self.itemData.cfg.UseParameter[1][1])
    end
    local maxCount = math.floor(num / baseNum)
    if self.itemData.cfg.limit_num and maxCount > self.itemData.cfg.limit_num then
        maxCount = self.itemData.cfg.limit_num
    end
    return maxCount
end

---按钮点击事件在这里派发
function BagUsePropTipView:OnClickBtn(go, isOn)
    baseView.OnClickBtn(self, go, isOn)
    if go == self.go_table.aorbtn_jump then
        _G.JumpManager:GetInstance():Jump(tonumber(self.itemData.cfg.UseParameter[1][1]))
    elseif go == self.go_table.aorbtn_propSub then
        if self.propUseNum > self:PropUseMinCount() then
            self.propUseNum = self.propUseNum - 1
            self:SetPropUseInfo()
        end
    elseif go == self.go_table.aorbtn_propAdd then
        if self.propUseNum < self:PropUseMaxCount() then
            self.propUseNum = self.propUseNum + 1
            self:SetPropUseInfo()
        end
    elseif go == self.go_table.aorbtn_propMax then
        self.propUseNum = self:PropUseMaxCount()
        self:SetPropUseInfo()
    elseif go == self.go_table.aorbtn_Prop then
        if self.itemData.cfg.UseType == _G.ItemUseType.SecretRealm and require "SecretRealmModel":GetInstance():GetFunctionOpen() == false then
            _G.PopWindowManager:GetInstance():ShowAllTips(1020010)
            return
        end
        if self:PropUseMinCount() <= 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(514)
            return
        end
        local param1
        if self.itemData.cfg.UseType == _G.ItemUseType.SecretRealm then
            param1 = self.secretRealmIndex
        end
        _G.StorageManager:GetInstance():UsePropToServer(
            self.itemData.sid,
            self.propUseNum,
            function()
                if self.itemData.cfg and self.itemData.cfg.Field == _G.StorageID.Debris then
                    ---红点显示 道具
                    require("RedPointManager"):GetInstance():RefreshNode(
                        _G.ConfigManager.redpoint_cfg.BackpackItemDebris.id,
                        self.itemData.sid
                    )
                end

                self:Close()
                if self.closeCallBack then
                    self.closeCallBack()
                end
            end,
            nil,
            param1
        )
    end
end

return BagUsePropTipView
