function BagBatchUseView:RefreshListItem(num)
    local index, obj
    for i = 1 ,num do
        index = i
        obj = _G.InstantiateObject(self.go_table.obj_itemGet,self.go_table.obj_Content)
        local tb = _G.GetAutoGoTable(obj)
        local data = self.showItemDatas[index]
        -- tb.aortext_name.text = _G.StorageManager:GetInstance():GetItemName(data.sid)
        tb.obj_item:ClearChildren()
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            { data.sid, data.num },
            tb.obj_item,
            function(itemLua)
                if self:IsNil() then
                    _G.DestroyObject(itemLua.gameObject)
                    return
                end
                if itemLua.ShowNumText then
                    itemLua:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
            end
        )
        obj:SetActiveE(1)
    end
end

---界面的销毁函数
function BagBatchUseView:OnDestroy()
end

---按钮点击事件在这里派发
function BagBatchUseView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_Close then
        self:Close()
    elseif go == self.go_table.aorbtn_cancle then
        self:Close()
    elseif go == self.go_table.aorbtn_sure then
        _G.StorageManager:GetInstance():PropBatchUse(
            self.itemDatas,
            self.go_table.toggle_remain.isOn,
            self.type,
            nil,
            function()
                local cfg = _G.ConfigManager.item_cfg
                for _, v in pairs(self.itemDatas) do
                    if cfg[v.sid] and cfg[v.sid].Field == _G.StorageID.Debris then
                        require("RedPointManager"):GetInstance():RefreshNode(
                            _G.ConfigManager.redpoint_cfg.BackpackItemDebris.id,
                            v.sid
                        )
                    end
                end
                if self.callBack then
                    self.callBack()
                end
                self:Close()
            end
        )
    elseif go == self.go_table.toggle_remain then
        self.go_table.toggle_remain.isOn = isOn
    end
end

return BagBatchUseView
