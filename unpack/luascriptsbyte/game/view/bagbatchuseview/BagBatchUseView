---@class BagBatchUseView : UIBaseView	中文描述
---@field public go_table BagBatchUseView_GoTable GoTable
local BagBatchUseView = _G.BaseClass("BagBatchUseView", _G.UIBaseView)

local languageKey = {
    _G.GetLangPackValue(90020200039),
    _G.GetLangPackValue(90020200040)
}

function BagBatchUseView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@type number 类型1开启 2合成
---@param itemDatas table 道具数据,和showItemDatas数据相同
function BagBatchUseView:OnCreate(type, itemDatas, showItemDatas, callBack)
    self.itemDatas = itemDatas
    self.showItemDatas = showItemDatas
    self.callBack = callBack
    self.type = type
    self:RefreshListItem(#showItemDatas)
    -- ZHJH-2300 策划要求窗口中的item居中排列
    --self:InitItem(#showItemDatas)
    self.go_table.aortext_tip.text = languageKey[type]
end

