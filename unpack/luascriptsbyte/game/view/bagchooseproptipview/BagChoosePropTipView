function BagChoosePropTipView:RefreshListItem(index, obj)
    index = index + 1
    local itemData = self.ItemDataAllList_ItemGet[index]
    local itemGoTable = _G.GetAutoGoTable(obj)
    itemGoTable.itemData = itemData
    itemGoTable.DataIndex = index
    _G.UIUtils.RemoveChildren(itemGoTable.obj_item)
    local idx = self.conItemIndex[index] and self.conItemIndex[index] or index
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        { itemData.sid, itemData.count },
        itemGoTable.obj_item,
        function(itemLua)
            if self:IsNil() then
                _G.DestroyObject(itemLua.gameObject)
                return
            end
            if itemLua.ShowNumText then
                itemLua:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
            itemLua.gameObject:SetLocalScaleXYZ(0.9)
            --itemLua.go_table.aorbtn_Click.LongPress = true
            --itemLua.go_table.aorbtn_Click.onLongPress = _G.handlerbind(self, self.OnLongPress_Add, itemData, idx)
        end,
        function()
            self:OnClickItem(itemData, idx)
        end
    )
    self.itemList[itemData.sid] = itemGoTable
    if itemData.cfg.Type1 == _G.ItemCfgType.PetChip then
        itemGoTable.aortext_name:SetActiveE(0)
        itemGoTable.aortext_starNum:SetActiveE(1)
        local petModel = require("PetModel"):GetInstance()
        local isMaxStar, nextProgress = petModel:GetUpStarByPropId(itemData.sid)
        if isMaxStar then
            itemGoTable.aorimage_maxStar:SetActiveE(1)
        else
            itemGoTable.slider_progress:SetActiveE(1)
            local haveNum = _G.StorageManager:GetInstance():GetItemCountBySid(itemData.sid)
            itemGoTable.slider_progress.value = haveNum / nextProgress
            itemGoTable.aortext_Slider.text = haveNum .. "/" .. nextProgress
        end

        --- 获取灵兽星级，并设置
        local petId = petModel:GetPetIdByPropId(itemData.sid)
        local petData = petModel:GetPet(petId)
        -- 是否已经激活
        if petData:GetIsActive() then
            -- 判断是否满星
            if not petData:IsMaxStar() then
                --- 在灵兽碎片进度条左侧放置 灵兽星级
                local starNum = petData:GetStar()
                itemGoTable.aortext_starNum.text = _G.GetLangPackValue(90000010475, starNum + 1)
            else
                itemGoTable.aortext_starNum.text = ""
            end
        else
            -- 文字设置为 激活
            itemGoTable.aortext_starNum.text = _G.GetLangPackValue(90000011073)
        end
    elseif itemData.cfg.Type1 == _G.ItemCfgType.BuildChip then
        --itemGoTable.aorimage_tipsBg:SetActiveE(0)
        itemGoTable.obj_progress:SetActiveE(1)

        local buildSid = itemData.cfg.UseParameter2[1][1]
        local buildData = require("BuildDrawModel"):GetInstance():GetBuild(buildSid)
        if not buildData:GetIsActive() then
            -- 没有激活
            itemGoTable.obj_jindu:SetActiveE(1)
            itemGoTable.aortext_star:SetActiveE(1)
            itemGoTable.obj_maxStar:SetActiveE(0)
            itemGoTable.aortext_star.text = _G.GetLangPackValue(90000010475, 0)
            itemGoTable.aortext_progress.text = 0 .. "/" .. 0
            itemGoTable.aorimage_activeSchedule:SetLocalScale(0, 1, 1)
        elseif not buildData:IsMaxStar() then
            -- 没有满星
            itemGoTable.obj_jindu:SetActiveE(1)
            itemGoTable.aortext_star:SetActiveE(1)
            itemGoTable.obj_maxStar:SetActiveE(0)
            itemGoTable.aortext_star.text = _G.GetLangPackValue(90000010475, buildData:GetStar())
            local count = buildData:GetItemCount()
            local needCount = buildData:GetUpCostNum()
            itemGoTable.aortext_progress.text = count .. "/" .. needCount
            if needCount <= count then
                itemGoTable.aorimage_activeSchedule:SetLocalScale(1, 1, 1)
            else
                itemGoTable.aorimage_activeSchedule:SetLocalScale(count / needCount, 1, 1)
            end
        else
            -- 满星
            itemGoTable.obj_jindu:SetActiveE(0)
            itemGoTable.aortext_star:SetActiveE(0)
            itemGoTable.obj_maxStar:SetActiveE(1)
        end
        if itemData.GetBaseName then
            itemGoTable.aortext_name.text = itemData:GetBaseName()
        else
            itemGoTable.aortext_name.text = itemData:GetName()
        end
    elseif itemData.cfg.Type1 == _G.ItemCfgType.SpoilsChip then
        --itemGoTable.aorimage_tipsBg:SetActiveE(0)
        itemGoTable.obj_progress:SetActiveE(1)

        local spoilsSid = itemData.cfg.UseParameter2[1][1]

        local spoilsData = require("SpoilsModel"):GetInstance():GetData(spoilsSid)
        if not spoilsData:GetIsActive() then
            -- 没有激活
            itemGoTable.obj_jindu:SetActiveE(1)
            itemGoTable.aortext_star:SetActiveE(1)
            itemGoTable.obj_maxStar:SetActiveE(0)
            itemGoTable.aortext_star.text = _G.GetLangPackValue(90000010475, 0)
            itemGoTable.aortext_progress.text = 0 .. "/" .. 0
            itemGoTable.aorimage_activeSchedule:SetLocalScale(0, 1, 1)
        elseif not spoilsData:IsMaxStar() then
            -- 没有满星
            itemGoTable.obj_jindu:SetActiveE(1)
            itemGoTable.aortext_star:SetActiveE(1)
            itemGoTable.obj_maxStar:SetActiveE(0)
            itemGoTable.aortext_star.text = _G.GetLangPackValue(90000010475, spoilsData:GetStar())
            local count = _G.StorageManager:GetInstance():GetItemCountBySid(spoilsData.cfg.materials_item)
            local needCount = not spoilsData:IsMaxStar() and spoilsData.cfg.material_1[spoilsData:GetStar() + 2] or 0
            itemGoTable.aortext_progress.text = count .. "/" .. needCount
            if needCount <= count then
                itemGoTable.aorimage_activeSchedule:SetLocalScale(1, 1, 1)
            else
                itemGoTable.aorimage_activeSchedule:SetLocalScale(count / needCount, 1, 1)
            end
        else
            -- 满星
            itemGoTable.obj_jindu:SetActiveE(0)
            itemGoTable.aortext_star:SetActiveE(0)
            itemGoTable.obj_maxStar:SetActiveE(1)
        end
        if itemData.GetBaseName then
            itemGoTable.aortext_name.text = itemData:GetBaseName()
        else
            itemGoTable.aortext_name.text = itemData:GetName()
        end
    else
        if itemData.GetBaseName then
            itemGoTable.aortext_name.text = itemData:GetBaseName()
        else
            itemGoTable.aortext_name.text = itemData:GetName()
        end
    end
    itemGoTable.obj_select:SetActiveE(self.selectPropId == itemData.sid and 1 or 0)
    local skinCfg = table.find(_G.ConfigManager.skin_cfg, function(a)
        return a.item == itemData.sid
    end)
    if skinCfg then
        local hasSkin = require "CardCommentManager":GetInstance():CheckSkin(skinCfg.id)
        itemGoTable.aorrawimage_has:SetActiveE(hasSkin and 1 or 0)
    end
end

function BagChoosePropTipView:OnClickItem(itemData, index)
    if not self.selectPropId or self.selectPropId ~= itemData.sid then
        if self.selectPropId and self.itemList[self.selectPropId] then
            self.itemList[self.selectPropId].obj_select:SetActiveE(0)
        end
        self.selectPropId = itemData.sid
        self.selectPropIndex = index
        self.itemList[itemData.sid].obj_select:SetActiveE(1)
        return
    end
    require "CommonTipManager":GetInstance():OpenTip(self.gameObject, itemData.sid, itemData.uid)
end

function BagChoosePropTipView:SetPropUseInfo()
    self.go_table.input_userNum.text = self.propUseNum
end

function BagChoosePropTipView:InitPropUseCount()
    self.propUseNum = 1
    self.ItemDataAllList_ItemGet = {}
    self.conItemIndex = {} --条件显示的物品有可能第一个不满足但第二个满足
    local cfgItem = self.itemData.cfg
    local UseParameter = cfgItem.UseParameter
    local itemData
    if cfgItem.UseType == _G.ItemUseType.ItemDrop then
        ---掉落预览要查掉落表
        ---@type drop_cfg
        local drop_cfgItem = _G.ConfigManager.drop_cfg[tonumber(UseParameter[1][2])]
        if drop_cfgItem ~= nil then
            for _, v in pairs(drop_cfgItem.fixed_drop) do
                itemData = _G.StorageManager:GetInstance():GetItemDataClassByCfg(v)
                _G.table.insert(self.ItemDataAllList_ItemGet, itemData)
            end
            for _, v in pairs(drop_cfgItem.content1) do
                itemData = _G.StorageManager:GetInstance():GetItemDataClassByCfg(v)
                _G.table.insert(self.ItemDataAllList_ItemGet, itemData)
            end
            for _, v in pairs(drop_cfgItem.content2) do
                itemData = _G.StorageManager:GetInstance():GetItemDataClassByCfg(v)
                _G.table.insert(self.ItemDataAllList_ItemGet, itemData)
            end
        end
    elseif cfgItem.UseType == _G.ItemUseType.CardOptional then
        for _, v in pairs(UseParameter) do
            itemData = _G.StorageManager:GetInstance():GetItemDataClassByCfg(v)
            _G.table.insert(self.ItemDataAllList_ItemGet, itemData)
        end
    elseif cfgItem.UseType == _G.ItemUseType.CompoundProp then
        local itemSid = UseParameter[1][2]
        local itemCfg = _G.ConfigManager.item_cfg[_G.tonumber(itemSid)]
        if itemCfg and (itemCfg.Type1 == 4 or itemCfg.Type1 == 8 or itemCfg.Type1 == 9) then
            ---合成的是宝箱时需要预览宝箱内的奖励
            if itemCfg.UseType == _G.ItemUseType.ItemDrop then
                ---当前是掉落宝箱，掉落预览要查掉落表
                local dropCfg = _G.ConfigManager.drop_cfg[_G.tonumber(itemCfg.UseParameter[1][2])]
                if dropCfg ~= nil then
                    if not _G.table.isEmptyOrNil(dropCfg.fixed_drop) then
                        for _, v in pairs(dropCfg.fixed_drop) do
                            itemData = _G.StorageManager:GetInstance():GetItemDataClassByCfg(v)
                            _G.table.insert(self.ItemDataAllList_ItemGet, itemData)
                        end
                    end

                    if not _G.table.isEmptyOrNil(dropCfg.content1) then
                        for _, v in pairs(dropCfg.content1) do
                            itemData = _G.StorageManager:GetInstance():GetItemDataClassByCfg(v)
                            _G.table.insert(self.ItemDataAllList_ItemGet, itemData)
                        end
                    end

                    if not _G.table.isEmptyOrNil(dropCfg.content2) then
                        for _, v in pairs(dropCfg.content2) do
                            itemData = _G.StorageManager:GetInstance():GetItemDataClassByCfg(v)
                            _G.table.insert(self.ItemDataAllList_ItemGet, itemData)
                        end
                    end
                end
            else
                ---自选宝箱
                for _, v in pairs(UseParameter) do
                    local data = _G.StorageManager:GetInstance():GetItemDataClassByCfg(v)
                    _G.table.insert(self.ItemDataAllList_ItemGet, data)
                end
            end
        end
    else
        for _, v in pairs(UseParameter) do
            itemData = _G.StorageManager:GetInstance():GetItemDataClassByCfg(v)
            _G.table.insert(self.ItemDataAllList_ItemGet, itemData)
        end
    end

    ---ZHJH-3488 5,6,17类型新增条件物品
    if
    cfgItem.UseType == _G.ItemUseType.GetProp or cfgItem.UseType == _G.ItemUseType.SelectProp or
        cfgItem.UseType == _G.ItemUseType.CardOptional
    then
        local curNum = #self.ItemDataAllList_ItemGet
        local conIndex = curNum
        local UseParameter2 = cfgItem.UseParameter2
        if UseParameter2 ~= nil then
            --兼容，后续可删除
            local useParameter2Con = cfgItem.use_parameter2_con
            for i, v in pairs(UseParameter2) do
                if _G.GlobalConditionManager.CheckConditionByArray({ useParameter2Con[i] }) then
                    itemData = _G.StorageManager:GetInstance():GetItemDataClassByCfg(v)
                    _G.table.insert(self.ItemDataAllList_ItemGet, itemData)
                    conIndex = conIndex + 1
                    self.conItemIndex[conIndex] = curNum + i
                end
            end
        end
    end
    local v = self.ItemDataAllList_ItemGet[1]
    local type, id = _G.StorageManager:GetInstance():CheckSidType(v.sid)
    if (type == _G.StorageType.Prop and v.cfg.Type1 == _G.ItemCfgType.BuildChip) or (type == _G.StorageType.Prop and v.cfg.Type1 == _G.ItemCfgType.SpoilsChip) then
        self.go_table.scrollloopvectical_ItemGet1:UpdateCount(#self.ItemDataAllList_ItemGet)
        self.go_table.scrollloopvectical_ItemGet1:SetActiveE(1)
        self.go_table.scrollloopvectical_ItemGet:SetActiveE(0)
    else
        self.go_table.scrollloopvectical_ItemGet:UpdateCount(#self.ItemDataAllList_ItemGet)
        self.go_table.scrollloopvectical_ItemGet:SetActiveE(1)
        self.go_table.scrollloopvectical_ItemGet1:SetActiveE(0)
    end
    self:SetPropUseInfo()
end

function BagChoosePropTipView:OnEndEditorDeclaration(input)
    if not tonumber(input) then
        input = self.propUseNum
    end
    local num = tonumber(input)
    local max = self:PropUseMaxCount()
    local min = self:PropUseMinCount()
    self.propUseNum = _G.Mathf.Clamp(num, min, max)
    self:SetPropUseInfo()
end

----返回可使用的最小次数
function BagChoosePropTipView:PropUseMinCount()
    local num = self.itemData.count

    local baseNum = 1
    if self.PropUseNumDic[self.itemData.cfg.UseType] then
        baseNum = tonumber(self.itemData.cfg.UseParameter[1][1])
    end
    local minCount = _G.math.floor(num / baseNum)
    return minCount > 0 and 1 or minCount
end

----返回可使用的最大次数
function BagChoosePropTipView:PropUseMaxCount()
    local num = self.itemData.count
    local baseNum = 1
    if self.PropUseNumDic[self.itemData.cfg.UseType] then
        baseNum = tonumber(self.itemData.cfg.UseParameter[1][1])
    end
    local maxCount = math.floor(num / baseNum)
    if self.itemData.cfg.limit_num and maxCount > self.itemData.cfg.limit_num then
        maxCount = self.itemData.cfg.limit_num
    end
    return maxCount
end

---按钮点击事件在这里派发
function BagChoosePropTipView:OnClickBtn(go, isOn)
    baseView.OnClickBtn(self, go, isOn)
    if go == self.go_table.aorbtn_jump then
        _G.JumpManager:GetInstance():Jump(tonumber(self.itemData.cfg.UseParameter[1][1]))
    elseif go == self.go_table.aorbtn_propSub then
        if self.propUseNum > self:PropUseMinCount() then
            self.propUseNum = self.propUseNum - 1
            self:SetPropUseInfo()
        end
    elseif go == self.go_table.aorbtn_propAdd then
        if self.propUseNum < self:PropUseMaxCount() then
            self.propUseNum = self.propUseNum + 1
            self:SetPropUseInfo()
        end
    elseif go == self.go_table.aorbtn_propMax then
        self.propUseNum = self:PropUseMaxCount()
        self:SetPropUseInfo()
    elseif go == self.go_table.aorbtn_Prop then
        if not self.selectPropIndex then
            return
        end
        _G.StorageManager:GetInstance():UsePropToServer(
            self.itemData.sid,
            self.propUseNum,
            function()
                self:Close()
                if self.closeCallBack then
                    self.closeCallBack()
                end
            end,
            { [self.selectPropIndex] = self.propUseNum },
            self.selectPropIndex
        )
    end
end

return BagChoosePropTipView
