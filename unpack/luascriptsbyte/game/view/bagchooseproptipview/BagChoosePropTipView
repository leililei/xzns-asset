local baseView = require("BagPropInfoTipView")
---@class BagChoosePropTipView : BagPropInfoTipView    中文描述
---@field public go_table BagJumpTipView_GoTable GoTable
local BagChoosePropTipView = _G.BaseClass("BagChoosePropTipView", baseView)
local tonumber = _G.tonumber

---@field needData table<sid,num>
function BagChoosePropTipView:OnCreate(itemData, closeCallBack, needData)
    baseView.OnCreate(self, itemData, closeCallBack)
    self:SetNeedItem(needData)
end

function BagChoosePropTipView:OnUICreate()
    ---材料消耗类型
    self.PropUseNumDic = {
        [_G.ItemUseType.ItemDrop] = true,
        [_G.ItemUseType.DrawCard] = true,
        [_G.ItemUseType.CompoundCard] = true,
        [_G.ItemUseType.CompoundProp] = true
    }
    self.selectPropId = nil
    self.selectPropIndex = nil
    self.itemList = {}
    self.go_table.scrollloopvectical_ItemGet:InitItemData(0, _G.handler(self, self.RefreshListItem))
    self.go_table.scrollloopvectical_ItemGet1:InitItemData(0, _G.handler(self, self.RefreshListItem))
    self.go_table.input_userNum.onEndEdit:AddListener(_G.handler(self, self.OnEndEditorDeclaration))
    self.go_table.aorbtn_propAdd.LongPress = true
    self.go_table.aorbtn_propAdd.onLongPress = _G.handlerbind(self, self.OnLongPress_Add)
    self:InitPropUseCount()
end

function BagChoosePropTipView:SetNeedItem(needData)
    if not needData then
        return
    end
    for index, v in pairs(self.ItemDataAllList_ItemGet) do
        if v.sid == needData.sid then
            self.selectPropIndex = self.conItemIndex[index] and self.conItemIndex[index] or index
            self:OnClickItem(v, index)
            self.propUseNum = _G.math.min((needData.num - 1) // v.count + 1, self:PropUseMaxCount())
            self:SetPropUseInfo()
        end
    end
end

