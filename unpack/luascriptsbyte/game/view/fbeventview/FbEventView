local base = require "EventViewBase"
---@class FbEventView : UIBaseView	副本事件界面
---@field public go_table FbView_GoTable GoTable
local FbEventView = _G.BaseClass("FbEventView", base)
--_G.FbEventView = FbEventView

local CS = _G.CS
local typeof = _G.typeof

function FbEventView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function FbEventView:OnCreate(doneCall, closeCall)
    self.super.OnCreate(self, doneCall, closeCall)
    self:InitData()
    self:InitView()
end
---初始化界面
function FbEventView:InitData()
    ---完成条件
    self.wanChengCfg = {
        [1] = {
            info = "众魂灵聚集形成的石像，可佑旅人平安。",
            isok = 0
        }
    }
    ---效果
    self.xiaoGuoInfo = "<color=#48bce7>点击聚灵石像，回复镇魂将和守护灵生命值的20%</color>"
    ---条件item
    self.wanChengList = {}

    --副本类型
    self.FbEventType = 2
    self.FbEventTypeInfo = {
        [1] = {
            "任务描述",
            "任务效果",
            "开始任务"
        },
        [2] = {
            "事件描述",
            "事件效果",
            "开始事件"
        }
    }
    ---事件左下标题
    self.rolename = "聚灵石像"
end

---初始化界面
function FbEventView:InitView()
    --事件左下标题
    self.go_table.aortext_rolename.text = self.rolename

    --描述 tag
    self.go_table.aortext_wanchengTag.text = self.FbEventTypeInfo[self.FbEventType][1]
    --效果tag
    self.go_table.aortext_xiaoguoTag.text = self.FbEventTypeInfo[self.FbEventType][2]
    --开始按钮 描述
    self.go_table.aortext_start.text = self.FbEventTypeInfo[self.FbEventType][3]
    --效果信息
    self.go_table.aortext_xiaoguoinfo.text = self.xiaoGuoInfo
    --描述信息
    self.go_table.aorlooplist_wancheng:StartUpdataDragInfo(#self.wanChengCfg, _G.handler(self, self.InitAorloopList))
end

function FbEventView:InitAorloopList(trans, index)
    local tblIndex = index + 1
    local cfg = self.wanChengCfg[tblIndex]

    if cfg then
        if not self.wanChengList[tblIndex] then
            local go_table =
                _G.GetAutoGoTable(
                trans
                -- ,
                -- function(btn, isOn)
                --     self:OnClickItemBtn(btn, isOn)
                -- end
            )
            self.wanChengList[tblIndex] = go_table
        end
        self.wanChengList[tblIndex].aortext_wanchenginfo.text = cfg.info
        _G.GameUtil.SetActiveByCondition(self.wanChengList[tblIndex].aorimage_gou, cfg.isok == 1)
    end
end

---按钮点击事件在这里派发
function FbEventView:OnClickBtn(go)
    local name = go:GetName()

    if _G.AppSetting.DEBUG then
        _G.Log("CardView>>ClickBtn>>" .. name)
    end
    --关闭

    if name == "@_aorbtn_close" then
        self:CloseWindow()
    elseif name == "@_aorbtn_start" then
        self:OnDialogueComplete()
    end
end

-- NPC 恢复生命
function FbEventView:OnDialogueComplete()
    -- _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.fbeventview.Name)
    _G.CS.BattleManager:RecoverAllHp()
    -- 播放恢复生命的特效
    local effectCfg = _G.ConfigManager.ui_effect_cfg["fx_h_huifu_effect"]
    _G.UIUtils.LoadEffectByCfg(effectCfg, _G.WorldManager:GetInstance():GetCurWorldPlayer().Transform)
    self:OnEventDone()
    self:Close()
end

function FbEventView:CloseWindow()
    self:Close()
end

return FbEventView
