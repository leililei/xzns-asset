---@class CardOptionalView : UIBaseView	中文描述
---@field public go_table CardOptionalView_GoTable GoTable
local CardOptionalView = _G.BaseClass("CardOptionalView", _G.UIBaseView)
function CardOptionalView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param sid number 道具id
---@param call function 使用成功回调
function CardOptionalView:OnCreate(sid, num, call)
    if sid == 0 or sid == nil then
        self:Close()
        return
    end
    self.Index = 0
    self.sid = sid
    self.call = call
    self.ItemList = {}
    self.cfg = _G.ConfigManager.item_cfg[sid]
    self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(self.cfg.Name)
    self.CurSelect = num or 1
    local UseParameter = _G.table.count(self.cfg.UseParameter)
    if UseParameter < 5 then
        local num = 5 - UseParameter
        self.go_table.scrollloophorizontal_Item:SetAnchorPosition(70 + num * 90, -33)
    end
    ---中间 所有item
    self.go_table.scrollloophorizontal_Item:InitItemData(UseParameter
        ,
        _G.handler(self, self.RefreshList)
    )
end

function CardOptionalView:RefreshList(index, objGame)
    if index < 0 then
        return
    end
    local itemData = self.cfg.UseParameter[index + 1]
    local itemGoTable = _G.GetAutoGoTable(objGame, _G.handlerbind(self, self.OnClick_item, index + 1))

    _G.DelayDo(
        0.02 * index,
        function()
            self:tanQuanDianJi(_G.tonumber(itemData[1]), _G.tonumber(itemData[2]), itemGoTable.obj_ItemS)
        end
    )
    itemGoTable.aortext_name.text =
        _G.LangUtil.GetLangPackValue(_G.ConfigManager.card_cfg[_G.tonumber(itemData[1])].Name)
    objGame:SetName(index)
    self.ItemList[index + 1] = itemGoTable
    return objGame
end

function CardOptionalView:OnClick_item(go, _, index)
    local name = go:GetName()

    if name == "@_aorbtn_XuanZo" then
        if self.Index ~= index then
            self.Index = index
            for key, value in pairs(self.ItemList) do
                if key == index then
                    value.obj_Eff:SetActiveE(1)
                else
                    value.obj_Eff:SetActiveE(0)
                end
            end
        end
    end
end

