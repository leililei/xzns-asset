---选择完毕确认使用
function CardOptionalView:Done()
    if self.Index == 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(380101)
        return
    else
        local data = _G.ConfigManager.item_cfg[self.sid]
        local id = _G.tonumber(data.UseParameter[self.Index][1])

        local pan = _G.StorageManager:GetInstance():GetIDMax(self.sid, id)
        if pan then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                622,
                nil,
                function()
                    _G.StorageManager:GetInstance():UsePropToServer(
                        self.sid,
                        self.CurSelect,
                        function()
                            if self.call then
                                self.call()
                            end
                            self:Close()
                        end,
                        { 1 },
                        self.Index
                    )
                end
            )
        else
            _G.StorageManager:GetInstance():UsePropToServer(
                self.sid,
                self.CurSelect,
                function()
                    if self.call then
                        self.call()
                    end
                    self:Close()
                end,
                { 1 },
                self.Index
            )
        end
    end
end

---按钮点击事件在这里派发
function CardOptionalView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_BG" then
        self:Close()
    elseif name == "@_aorbtn_Prop" then
        if self.CurSelect ~= 0 then
            self:Done()
        end
    end
end

return CardOptionalView
