local baseView = require("BagPropInfoTipView")
---@class BagJumpTipView : BagPropInfoTipView	中文描述
---@field public go_table BagJumpTipView_GoTable GoTable
local BagJumpTipView = _G.BaseClass("BagJumpTipView", baseView)

---按钮点击事件在这里派发
function BagJumpTipView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_jump then
        _G.JumpManager:GetInstance():Jump(tonumber(self.itemData.cfg.UseParameter[1][1]))
        return
    end
    baseView.OnClickBtn(self, go, isOn)
end

return BagJumpTipView
