function SectionStopView:ExitSction()
    --- 退出
    _G.PopWindowManager:GetInstance():ShowAllTips(
        110104,
        nil,
        function()
            self:Close()
            _G.ChapterRoomManager:GetInstance():ExitSectionSelf(
                function()
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name, 3)
                end
            )
        end
    )
end

---按钮点击事件在这里派发
function SectionStopView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

return SectionStopView
