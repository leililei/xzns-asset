---AFK放置获取预览
------@param num number 单次资源获得基数
------@param count number 道具使用数量
function BagPropPopView:UpdataAfkRes(sid, num)
    if sid ~= nil then
        local objitem = self.go_table.obj_Res
        self.go_table.obj_ResList:ClearChildren()
        for key, value in pairs(sid) do
            local obj = _G.InstantiateObject(objitem, self.go_table.obj_ResList)
            local item = _G.GetAutoGoTable(obj)
            local AfkEff, itemData
            AfkEff = require("AfkModel"):GetInstance():GetCurEfficiency({_G.tonumber(value[1]), _G.tonumber(value[2])})
            itemData = _G.StorageManager:GetInstance():GetItemDataClass(_G.tonumber(value[1]), 1)
