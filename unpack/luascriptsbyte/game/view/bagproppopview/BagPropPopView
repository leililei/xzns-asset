            self:ProgressChest(item_cfgItem.ID, tonumber(UseParameter[1][2]))
        elseif item_cfgItem.UseType == _G.ItemUseType.CardOptional then
            isSelectNum = true

            self.ParamsProp_useNum = 1
            local info, itemData
            for i = 1, #UseParameter do
                info = UseParameter[i]
                itemData = _G.StorageManager:GetInstance():GetItemDataClassByCfg(info)
                table.insert(self.ItemDataAllList_ItemGet, itemData)
            end
        elseif item_cfgItem.UseType == _G.ItemUseType.CompoundProp then
            isSelectNum = true

            local itemSid = UseParameter[1][2]
            local itemCfg = _G.ConfigManager.item_cfg[_G.tonumber(itemSid)]
            if itemCfg and (itemCfg.Type1 == 4 or itemCfg.Type1 == 8 or itemCfg.Type1 == 9) then
                ---合成的是宝箱时需要预览宝箱内的奖励
                if itemCfg.UseType == _G.ItemUseType.ItemDrop then
