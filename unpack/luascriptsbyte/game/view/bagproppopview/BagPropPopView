function BagPropPopView:SetSpiritualItem(itemGoTable)
    if itemGoTable == nil then
        return
    end
    ---@type ItemSpiritualBase
    local lua = itemGoTable.lua_Spiritual
    ---@type SpiritualData
    local itemData = itemGoTable.itemData

    lua.gameObject:SetName(itemData.uid)
    lua:ShowData(itemData)
    local count = itemData:GetCount()
    if count and count > 1 then
        lua:ShowCount()
        lua:HideStar()
    else
        lua:ShowStar()
        lua:HideCount()
    end
    lua.gameObject:SetActiveE(1)
    if lua.SetGradeNew then
        lua:SetGradeNew(false)
    end
end

function BagPropPopView:SetCardItem(itemGoTable)
    if itemGoTable == nil then
        return
    end
    ---@type ItemCardAllView
    local lua = itemGoTable.lua_Card
    ---@type CardData
    local itemData = itemGoTable.itemData
    lua:ShowCardData(
        itemData,
        function()
            local maxCardData = require("CardData").GetPreviewData(itemData.sid)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.PreviewCardShowView.Name,{CardData = maxCardData},nil,true)
        end
    )
    lua:HideOrShowLevel()

    lua.gameObject:SetName(itemData.uid)
    lua.gameObject:SetActiveE(1)
    if lua.SetGradeNew then
        lua:SetGradeNew(false)
    end
end

