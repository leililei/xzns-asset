                end
            end
        else
            local info, itemData
            for i = 1, #UseParameter do
                info = UseParameter[i]
                itemData = _G.StorageManager:GetInstance():GetItemDataClassByCfg(info)
                table.insert(self.ItemDataAllList_ItemGet, itemData)
            end
        end

        go_Prop.scrollloopvectical_ItemGet:UpdateCount(#self.ItemDataAllList_ItemGet)
    elseif item_cfgItem.UseType == _G.ItemUseType.DrawCard or item_cfgItem.UseType == _G.ItemUseType.CompoundCard then
