function BagPropPopView:OnCreate(data, DeComposeCall)
    self.data = data
    self.DeComposeCall = DeComposeCall

    --self.go_RightInfo.obj_Prop:SetActiveE(1)
    self.go_table.aorbtn_propAdd.LongPress = true
    self.go_table.aorbtn_propAdd.onLongPress = _G.handler(self, self.OnClick_PropUse_Add)
    self.go_table.aorbtn_propSub.LongPress = true
    self.go_table.aorbtn_propSub.onLongPress = _G.handler(self, self.OnClick_PropUse_Sub)
    ---右侧 道具 可获得奖励
    self.go_table.scrollloopvectical_ItemGet:InitItemData(0, _G.handler(self, self.RefreshList_ItemGet))

    self.go_table.input_userNum.onEndEdit:AddListener(_G.handler(self, self.OnEndEditorDeclaration))

    _G.ItemFactory:GetInstance():GetItemCard(
        _G.ItemFactory.itemType.ItemBaseWithCount,
        self.go_table.obj_item,
        function(itemLua)
            self.Rightlua_Prop = itemLua
            self.Rightlua_Prop.gameObject:SetLocalScaleXYZ(1.06)
            self:FreshView()
        end
    )
    --self:FreshView()
end

function BagPropPopView:FreshView()
    if self.Rightlua_Prop == nil or self.Rightlua_Prop == true then
        ----item还没生成
        return
    end
    ---@type   PropData
    local itemData = self.data
    local go_Prop = self.go_table
    self.Rightlua_Prop:Show(itemData.sid)

    ---item对象显示
    self.Rightlua_Prop.gameObject:SetActiveE(1)
    self.go_table.aortext_name.text = itemData:GetName()
    if itemData.Grade > 7 then
        require("CommonTipManager"):GetInstance():SetTextGradient({"5FC1F2","8F7BE5"},{255,255},self.go_table.aortext_name)
        self.go_table.aortext_name.color = _G.Color.white
    else
        self.go_table.aortext_name.color = _G.ColorTools.FormatColorByString(NameColor[itemData.Grade] or "FFFFFF")
        require("CommonTipManager"):GetInstance():SetTextGradient({"FFFFFF","FFFFFF"},{255,255},self.go_table.aortext_name)
    end

    go_Prop.aortext_num.text = string.format(self.UiDic.numTxt, itemData.count)
    ---当前道具是否是装备突破材料或材料宝箱
    local index = _G.table.indexof(self.EquipMaterialType, itemData.cfg.Type1)
    go_Prop.obj_propInfo:SetActiveE(index and 0 or 1)
    go_Prop.obj_View:SetActiveE(index and 0 or 1)
    go_Prop.obj_equipBroken:SetActiveE(index and 1 or 0)
    if index then
        if not self.equipBrokenList then
            self.go_table.scrollloophorizontal_ItemGet:InitItemData(
                0,
                _G.handler(self, self.RefreshEquip_ItemGet)
            )
            self.equipBrokenList = self.go_table.scrollloophorizontal_ItemGet
        end
        self:ShowEquipBroken_preview(go_Prop, itemData)
    else
        self:stopEquipBrokenTimer()
        go_Prop.aortext_des.text = itemData:GetDescribe()
        self:ShowProp_preview(go_Prop, itemData)
    end
    ---设置使用按钮显示
    go_Prop.aorbtn_Prop:SetActiveE(self.Prop_UseDic[itemData.cfg.UseType] ~= nil and 1 or 0)
    if itemData.cfg.Type1 == 14 then
        go_Prop.aortext_btnProp.text = _G.GetLangPackValue(90031300060)
    else
        go_Prop.aortext_btnProp.text = _G.GetLangPackValue(90020200030)
    end
    ---道具的信息展示对象显示
    --self.go_RightInfo.obj_Prop:SetActiveE(1)
end

function BagPropPopView:OnClick_PropUse_Add()
    if self.ParamsProp_useNum < self:PropUse_GetMaxCount() then
        self.ParamsProp_useNum = self.ParamsProp_useNum + 1
    end
    self:PropUse_Updata()
end

function BagPropPopView:OnClick_PropUse_Sub()
    if self.ParamsProp_useNum > self:PropUse_GetMinCount() then
        self.ParamsProp_useNum = self.ParamsProp_useNum - 1
    end
    self:PropUse_Updata()
end

function BagPropPopView:OnClick_PropUse_Max()
    self.ParamsProp_useNum = self:PropUse_GetMaxCount()
    self:PropUse_Updata()
end

function BagPropPopView:RefreshList_ItemGet(index, objGame)
    if index < 0 then
        return
    end
    local itemData = self.ItemDataAllList_ItemGet[index + 1]
    local itemGoTable = _G.GetAutoGoTable(objGame)
    itemGoTable.itemData = itemData
    itemGoTable.DataIndex = index + 1

    self:SetLoopItem(itemGoTable)

    return objGame
end

function BagPropPopView:OnEndEditorDeclaration(input)
    if not tonumber(input) then
        input = self.ParamsProp_useNum
    end
    local num = tonumber(input)
    local max = self:PropUse_GetMaxCount()
    local min = self:PropUse_GetMinCount()
    if num >= max then
        num = max
    elseif num <= min then
        num = min
    end
    self.ParamsProp_useNum = num
    self:PropUse_Updata()
end

----返回可使用的最小次数
function BagPropPopView:PropUse_GetMinCount()
    local num = self.data.count

    local baseNum = 1
    ---- 3 9  使用每次消耗根据配置
    if self.Prop_UseNumDic[self.data.cfg.UseType] == true then
        baseNum = tonumber(self.data.cfg.UseParameter[1][1])
    end
    local hcCount = math.floor(num / baseNum)
    if hcCount > 0 then
        hcCount = 1
    end
    return hcCount
end

----返回可使用的最大次数
function BagPropPopView:PropUse_GetMaxCount()
    local num = self.data.count
    -- if self.data.cfg.limit_num and num > self.data.cfg.limit_num then
    --     num = self.data.cfg.limit_num
    -- end

    local baseNum = 1
    ---- 3 9  使用每次消耗根据配置
    if self.Prop_UseNumDic[self.data.cfg.UseType] == true then
        baseNum = tonumber(self.data.cfg.UseParameter[1][1])
    end
    local hcCount = math.floor(num / baseNum)
    if self.data.cfg.limit_num and hcCount > self.data.cfg.limit_num then
        hcCount = self.data.cfg.limit_num
    end
    -- if hcCount > 99 then
    --     hcCount = 99
    -- end
    return hcCount
end

function BagPropPopView:PropUse_Updata()
    if self.data.cfg.UseType == _G.ItemUseType.GetXHourAfkAward then
        self:UpdataAfkRes(self.UseParameter, nil)
    end
    self.go_table.input_userNum.text = self.ParamsProp_useNum
end

function BagPropPopView:OnClickBtn(go, isOn)
    --local name = go:GetName()
    if go == self.go_table.aorbtn_Close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_propMax then 
        self:OnClick_PropUse_Max()
    elseif go == self.go_table.aorbtn_Prop then 
        self:OnClick_PropUse()
    elseif go == self.go_table.aorbtn_propAdd then 
        self:OnClick_PropUse_Add()
    elseif go == self.go_table.aorbtn_propSub then 
        self:OnClick_PropUse_Sub()
    end
end

function BagPropPopView:OnClick_PropUse()
    if self.ParamsProp_useNum <= 0 then
        return
    end

    local UseType = self.data.cfg.UseType
    if UseType == _G.ItemUseType.GetXHourAfkAward then
        if require("AfkModel"):GetInstance():GetCurEfficiency(self.data.cfg.UseParameter[1]) == 0 then
            return
        end
    elseif UseType == _G.ItemUseType.InterfaceJump then
        self:JumpScrene(
            function()
                _G.JumpManager:GetInstance():Jump(tonumber(self.data.cfg.UseParameter[1][1]))
            end
        )
        return
    elseif UseType == _G.ItemUseType.CardOptional then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CardOptionalView.Name,
            self.data.sid,
            self.ParamsProp_useNum,
            self.DeComposeCall
        )
        return
    elseif UseType == _G.ItemUseType.SoulLinkUp then --魂链直升
        local useParam = self.data.cfg.UseParameter[1][1]
        if useParam == "1" then --魂五行
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CommonCardChooseView.Name,
                1,
                self.DeComposeCall
            )
        elseif useParam == "0" then --所有
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CommonCardChooseView.Name,
                2,
                self.DeComposeCall
            )
        end
    end

    local type = self.Prop_UseDic[UseType]
    if type == 2 then
        _G.StorageManager:GetInstance():PropUse(
            self.data.sid,
            self.DeComposeCall
        )
    else
        _G.StorageManager:GetInstance():UsePropToServer(
            self.data.sid,
            self.ParamsProp_useNum,
            self.DeComposeCall
        )
    end
    self:Close()
end

function BagPropPopView:ShowEquipBroken_preview(go_Prop, itemData)
    ---@type item_cfg
    local item_cfgItem = itemData.cfg
    ---道具类型
    local type = item_cfgItem.Type1
    ---展示的索引
    self.equipShowIndex = 1
    self.selectItemSid = _G.tonumber(item_cfgItem.ID)
    if type == _G.ItemCfgType.EquipBrokenMaterial then
        go_Prop.aortext_mdes.text = itemData:GetDescribe()
        go_Prop.scrollloophorizontal_ItemGet:SetActiveE(0)
    elseif type == _G.ItemCfgType.EquipBrokenMaterialBox then
        go_Prop.aortext_mdes.text = ""
        self.ItemDataAllList_equipBroken = {}
        self.itemTransDic = {}
        ---展示的item索引
        self.selectItemIndex = 1
        for _, v in ipairs(item_cfgItem.UseParameter) do
            _G.table.insert(self.ItemDataAllList_equipBroken, v)
        end
        go_Prop.scrollloophorizontal_ItemGet:SetActiveE(1)
        self.equipBrokenList:UpdateCount(#self.ItemDataAllList_equipBroken)
    end

    self.showEquipIndex = 1
    self:InitEquipPropInfo()
    self:UpdateTimer()
    go_Prop.aortext_tip:SetActiveE(type == _G.ItemCfgType.EquipBrokenMaterialBox and 1 or 0)
end

---初始化装备
function BagPropPopView:InitEquipPropInfo()
    if not self.data or not self.go_RightInfo then
        return
    end
    local advance = _G.ConfigManager.stone_cfg[self.selectItemSid].advance
    ---当前装备
    local leftEquipId = advance[self.showEquipIndex][1]
    self.go_table.obj_item1:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseView(
        leftEquipId,
        1,
        self.go_table.obj_item1,
        function(item)
            if _G.IsNil(self.go_table.obj_item1) then
                _G.DestroyObject(item.gameObject)
                return
            end

            item.gameObject:SetLocalScaleXYZ(0.8)
            local equipmentData = _G.StorageManager:GetInstance():GetDatasBySid(_G.StorageID.Equipment, leftEquipId)
            if _G.table.isEmptyOrNil(equipmentData) then
                item.go_table.aortext_num.text = _G.string.format("<color=#e33f3f>%s</color>/%s", 0, 1)
            else
                local count = 0
                for _, v in pairs(equipmentData) do
                    count = v.count + count
                end
                item.go_table.aortext_num.text = count .. "/" .. 1
            end
        end
    )

    ---消耗的道具
    self.go_table.obj_item2:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseView(
        self.selectItemSid,
        0,
        self.go_table.obj_item2,
        function(item)
            if _G.IsNil(self.go_table.obj_item2) then
                _G.DestroyObject(item.gameObject)
                return
            end
            item.gameObject:SetLocalScaleXYZ(0.8)
        end,
        function()
        end
    )

    ---当前装备
    local rightEquipId = advance[self.showEquipIndex][2]
    self.go_table.obj_item3:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseView(
        rightEquipId,
        0,
        self.go_table.obj_item3,
        function(item)
            if _G.IsNil(self.go_table.obj_item3) then
                _G.DestroyObject(item.gameObject)
                return
            end
            item.gameObject:SetLocalScaleXYZ(0.8)
        end
    )
    self:RefreshEquipPropAttribute()
end

---初始化属性
function BagPropPopView:RefreshEquipPropAttribute()
    if not self.data then
        return
    end
    local advance = _G.ConfigManager.stone_cfg[self.selectItemSid].advance
    local cfgs = _G.ConfigManager.equipment_cfg
    local propList = {}
    for _, v in pairs(_G.AttrType) do
        ---当前装备
        local leftEquipId = advance[self.showEquipIndex][1]
        local leftEquipCfg = cfgs[leftEquipId]
        ---突破后的装备
        local rightEquipId = advance[self.showEquipIndex][2]
        local rightEquipCfg = cfgs[rightEquipId]
        if leftEquipCfg[v.key] and leftEquipCfg[v.key] > 0 then
            ---突破前和突破后的装备属性一定是一样的，否则无法对比（不一样就是配错了）
            table.insert(
                propList,
                {
                    name = v.des,
                    percentage = v.percentage,
                    sortid = v.sortid,
                    leftNum = leftEquipCfg[v.key],
                    rightNum = rightEquipCfg[v.key] or 0
                }
            )
        end
    end

    ---装备属性显示排序
    _G.table.sort(
        propList,
        function(a, b)
            return a.sortid < b.sortid
        end
    )

    local obj
    for i, v in ipairs(propList) do
        ---生成属性条
        if not self.propItemDic[i] then
            obj = _G.InstantiateObject(self.go_table.obj_propItem, self.go_table.obj_propGrid)
            _G.table.insert(self.propItemDic, obj)
        else
            obj = self.propItemDic[i]
        end

        local leftNum, rightNum
        if v.percentage == 1 then
            leftNum = _G.GameUtil.FormatNum(v.leftNum * 0.01) .. "%"
            rightNum = _G.GameUtil.FormatNum(v.rightNum * 0.01) .. "%"
        else
            leftNum = _G.math.floor(v.leftNum)
            rightNum = _G.math.floor(v.rightNum)
        end
        local go_table = _G.GetAutoGoTable(obj)
        go_table.aorimage_di:SetActiveE(i % 2 == 0 and 0 or 1)
        go_table.aortext_des.text = v.name
        go_table.aortext_num.text = leftNum
        go_table.aortext_num1.text = rightNum
        obj:SetActiveE(1)
    end

    for i = #propList + 1, #self.propItemDic do
        self.propItemDic[i]:SetActiveE(0)
    end
end

function BagPropPopView:UpdateTimer()
    self:stopEquipBrokenTimer()
    if self.clickArrow then
        return
    end
    local delay = _G.ConfigManager.discrete_cfg[104910][1][1]
    self.timer = _G.TimerManager:GetInstance():GetTimer(delay, self.OnTimerCall, self, false, false)
    self.timer:Start()
end

function BagPropPopView:stopEquipBrokenTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

function BagPropPopView:OnTimerCall()
    self:RefreshPropInfo(1)
end

function BagPropPopView:RefreshPropInfo(num)
    self.showEquipIndex = self.showEquipIndex + num
    local advance = _G.ConfigManager.stone_cfg[self.selectItemSid].advance
    if self.showEquipIndex > #advance then
        self.showEquipIndex = 1
    elseif self.showEquipIndex <= 0 then
        self.showEquipIndex = #advance
    end
    self:InitEquipPropInfo()
end

----道具信息设置
function BagPropPopView:ShowProp_preview(go_Prop, itemData)
    self.ItemDataAllList_ItemGet = {}
    ---@type item_cfg
    local item_cfgItem = itemData.cfg
    ---true显示增删数量按钮
    local isSelectNum = false
    ---true显示货币资源获取预览
    local isShowRes = false
    ---使用数量
    self.ParamsProp_useNum = self:PropUse_GetMaxCount()
    go_Prop.obj_View:SetActiveE(0)
    ---道具预览
    if self.Prop_ItemGetDic[item_cfgItem.UseType] then
        ---UsePattern 使用模式_1（1-弹框选择数量使用（默认选取最大数量，至少选定1个）；2-选择内容后使用）
        isSelectNum = item_cfgItem.UsePattern == 1
        local UseParameter = item_cfgItem.UseParameter
        self.UseParameter = UseParameter
        if item_cfgItem.UseType == _G.ItemUseType.ItemDrop then
            ---掉落预览要查掉落表
            ---@type drop_cfg
            local drop_cfgItem = _G.ConfigManager.drop_cfg[tonumber(UseParameter[1][2])]
            if drop_cfgItem ~= nil then
                local info, infoS, itemData
                infoS = drop_cfgItem.fixed_drop
                for i = 1, #infoS do
                    info = infoS[i]
                    itemData = _G.StorageManager:GetInstance():GetItemDataClassByCfg(info)
                    table.insert(self.ItemDataAllList_ItemGet, itemData)
                end
                infoS = drop_cfgItem.content1
                for i = 1, #infoS do
                    info = infoS[i]
                    itemData = _G.StorageManager:GetInstance():GetItemDataClassByCfg(info)
                    table.insert(self.ItemDataAllList_ItemGet, itemData)
                end
                infoS = drop_cfgItem.content2
                for i = 1, #infoS do
                    info = infoS[i]
                    itemData = _G.StorageManager:GetInstance():GetItemDataClassByCfg(info)
                    table.insert(self.ItemDataAllList_ItemGet, itemData)
                end
            end
        elseif item_cfgItem.UseType == _G.ItemUseType.GetXHourAfkAward then
            isShowRes = true
            --self:UpdataAfkRes(tonumber(UseParameter[1][1]), tonumber(UseParameter[1][2]))
            self:UpdataAfkRes(UseParameter)
        elseif item_cfgItem.UseType == _G.ItemUseType.ProgressChest then
