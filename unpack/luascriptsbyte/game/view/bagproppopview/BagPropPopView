        elseif item_cfgItem.UseType == _G.ItemUseType.DrawCard then
            local info
            local pool 
            for i = 2, #item_cfgItem.UseParameter do
                pool = _G.ConfigManager.lucky_pools_cfg[tonumber(item_cfgItem.UseParameter[i][1])].cards
                for k, v in pairs(pool) do
