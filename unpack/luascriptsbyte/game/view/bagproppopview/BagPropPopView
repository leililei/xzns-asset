                item.aortext_resHave.text =
                    _G.GameUtil.NumberToUnitStr(self.ParamsPRop_AfkBaseNum * self.ParamsProp_useNum)
            end
        end
    end
end

---放置进度宝箱
------@param num number 单次资源获得基数
function BagPropPopView:ProgressChest(sid, num)
    if sid == 0 or sid == nil then
        return
    end
    self.sid = sid
    local cfg = _G.ConfigManager.item_cfg[sid]
    local item_box_con_cfgID = tonumber(cfg.UseParameter[1][1])
    ---@type item_box_con_cfg
    self.item_box_con_cfg = _G.ConfigManager.item_box_con_cfg[item_box_con_cfgID]
    ---@type PropData
    self.itemDatanub = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, sid)

    ---当前已领取索引
    self.NowGetNum = self.itemDatanub.progress or 0

    ---可领取索引 1->  nil不能领取
    self.CurSelectNum = nil
    local ispass
    for i, v in pairs(self.item_box_con_cfg.rewards) do
        local condition_params = self.item_box_con_cfg.condition_params[i]
        if condition_params ~= nil then
            if self.item_box_con_cfg.condition_type == 0 then
                ispass =
                    _G.GlobalConditionManager.CheckCondition(
                    _G.GlobalConditionManager.ConditionType.createRoleDay,
                    condition_params,
                    self.itemDatanub:GetProgressChestArgs().time
                )
            else
                ispass =
                    _G.GlobalConditionManager.CheckCondition(self.item_box_con_cfg.condition_type, condition_params)
            end
            if ispass then
                self.CurSelectNum = i
            else
                break
            end
        end
    end

    if self.CurSelectNum ~= nil then
        if self.CurSelectNum > self.itemDatanub.progress then
            self.go_table.aorimage_btnPropYi:SetGray(false)
            self.go_table.aortext_btnPropYi.text = _G.LangUtil.GetLangPackValue(UiDics.lang.yjlq)
            self.go_table.aortext_btnPropYi.color = UiDics.top.color[3]
        else
            self.CurSelectNum = nil
        end
    end

    if self.CurSelectNum == nil or self.CurSelectNum <= self.itemDatanub.progress then
        self.go_table.aorimage_btnPropYi:SetGray(true)
        self.go_table.aortext_btnPropYi.text = _G.LangUtil.GetLangPackValue(UiDics.down.text[2])
        self.go_table.aortext_btnPropYi.color = UiDics.top.color[4]
    end
    ---生成item数量
    self.ItemCount = #self.item_box_con_cfg.rewards
    ----道具数量 小于4 居中
    local objNum = 0

    for key, value in pairs(self.SelectItems) do
        _G.DestroyObject(self.SelectItems[key].gameObject)
        self.SelectItems[key] = nil
    end

    local num = 0
    for i, v in pairs(self.item_box_con_cfg.rewards) do
        if i > self.NowGetNum then
            objNum = objNum + 1
            _G.PoolsManager:GetInstance():Spawn(
                SelectItem,
                _G.ePoolType.UIItem,
                self.go_table.obj_Content,
                function(tran)
                    if not self.go_table then
                        _G.DestroyImmediate(tran)
                        return
                    end
                    if tran then
                        self:SetItem(tran, v, tonumber(i), true)
                    end
                end
            )
        end
    end

    for i, v in pairs(self.item_box_con_cfg.rewards) do
        if i <= self.NowGetNum then
            objNum = objNum + 1
            _G.PoolsManager:GetInstance():Spawn(
                SelectItem,
                _G.ePoolType.UIItem,
                self.go_table.obj_Content,
                function(tran)
                    if not self.go_table then
                        _G.DestroyImmediate(tran)
                        return
                    end
                    if tran then
                        self:SetItem(tran, v, tonumber(i), true)
                    end
                end
            )
        end
    end
    ---true可以左右滑动
    -- local isH = true
    -- local x = 100
    -- if objNum < 4 then
    --     objNum = objNum - 1
    --     x = 310 - 10 * objNum - objNum * 70
    --     isH = false
    -- end
    self.go_table.obj_View:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect)).horizontal = false
end

---创建可选择的道具
function BagPropPopView:SetItem(tran, data, i, zhi)
    local go_table

    ---@type PropData
    local itemData = _G.StorageManager:GetInstance():GetItemDataClassByCfg(data)

    if self.SelectItems[i] == nil then
        self.SelectItems[i] = _G.GetAutoGoTable(tran, _G.handlerbind(self, self.ClickSelectItem, i, data))
    else
        _G.DestroyObject(self.SelectItems[i].gameObject)
        self.SelectItems[i] = _G.GetAutoGoTable(tran, _G.handlerbind(self, self.ClickSelectItem, i, data))
    end
    go_table = self.SelectItems[i]
    ---true条件达成
    local ispass = false
    ---true条件达成
    local isGet = self.NowGetNum >= i
    ---条件描述
    local str = ""

    local condition_params = self.item_box_con_cfg.condition_params[i]
    if condition_params == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("condition_params 解锁参数未配置全  " .. self.item_box_con_cfg.id)
        end
    else
        local tispass, tstr
        if self.item_box_con_cfg.condition_type == 0 then
            tispass, tstr =
                _G.GlobalConditionManager.GetTipsText(
                _G.GlobalConditionManager.ConditionType.createRoleDay,
                condition_params,
                self.itemDatanub:GetProgressChestArgs().time
            )
        else
            tispass, tstr =
                _G.GlobalConditionManager.GetTipsText(self.item_box_con_cfg.condition_type, condition_params)
        end
        ispass = tispass
        str = tstr

        ---特殊显示 描述        ---第%d章        ---第%d层        ---第%d天
        if self.item_box_con_cfg.condition_type == 4 then
            ---@type afk_cfg
            local afk_cfg = _G.ConfigManager.afk_cfg[condition_params]
            str = _G.LangUtil.GetLangPackValue(UiDics.lang.type4, afk_cfg.chapter)
        elseif self.item_box_con_cfg.condition_type == 8 then
            ---@type tower_cfg
            local tower_cfg = _G.ConfigManager.tower_cfg[condition_params]
            str = _G.LangUtil.GetLangPackValue(UiDics.lang.type8, tower_cfg.layer)
        elseif self.item_box_con_cfg.condition_type == 9 or self.item_box_con_cfg.condition_type == 0 then
            str = _G.LangUtil.GetLangPackValue(UiDics.lang.type9, condition_params)
        end
    end
    go_table.aortext_top.text = str
    go_table.aortext_down.text = _G.LangUtil.GetLangPackValue(UiDics.down.text[ispass and 1 or 2])
    go_table.aortext_top.color = UiDics.top.color[ispass and 1 or 2]
    go_table.aortext_down.color = UiDics.top.color[ispass and 1 or 2]
    -- if ispass then
    --     go_table.aortext_down:SetActiveE(0)
    --     go_table.aorbtn_get:SetActiveE(1)
    -- else
    --     go_table.aortext_down:SetActiveE(1)
    --     go_table.aorbtn_get:SetActiveE(0)
    -- end

    _G.GameUtil.SetActiveByCondition(go_table.aortext_down, isGet == false)
    _G.GameUtil.SetActiveByCondition(go_table.aorbtn_get, false)

    go_table.aorimage_bg.SpriteName = UiDics.itembg[ispass and 1 or 2]
    if isGet and ispass then
        go_table.aorimage_bg.SpriteName = UiDics.itembg[2]
        go_table.aortext_top.color = UiDics.top.color[2]
    --go_table.aortext_down.color = UiDics.down.color[2]
    end

    _G.GameUtil.SetActiveByCondition(go_table.aorimage_Mask, isGet)
    _G.GameUtil.SetActiveByCondition(go_table.aorimage_get, isGet)

    if not go_table.item and zhi then
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            data,
            go_table.obj_item,
            function(itemLua)
                itemLua:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                go_table.item = itemLua
            end
        )
    end
    --self:SetItemCountOver()
end

---领取奖励
function BagPropPopView:ClickSelectItem(go, _, index, data)
    if _G.AppSetting.DEBUG then
        _G.Log("领取奖励")
    end
    if self.CurSelectNum == nil then
        _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.NotSelect)
        return
    else
        _G.StorageManager:GetInstance():UsePropToServer(
            self.sid,
            self.CurSelectNum,
            function()
                self.itemDatanub.progress = self.CurSelectNum
                ---领取完就关闭
                if self.itemDatanub.progress == #self.item_box_con_cfg.rewards then
                    if self.call then
                        self.call()
                    end
                    self:Close()
                else
                    self:SetItem(go, data, index, false)
                end
                ---红点显示 道具
                require("RedPointManager"):GetInstance():RefreshNode(
                    _G.ConfigManager.redpoint_cfg.BackpackItem.id,
                    self.sid
                )
            end
        )
    end
end

