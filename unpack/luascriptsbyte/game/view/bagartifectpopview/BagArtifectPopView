---@class BagArtifectPopView : UIBaseView    神器和灵契使用同一个预制体和脚本
---@field public go_table BagArtifectPopView_GoTable GoTable
local BagArtifectPopView = _G.BaseClass("BagArtifectPopView", _G.UIBaseView)

local Type = {
    [_G.StorageType.Artifact] = 1,
    [_G.StorageType.Spiritual] = 2
}

---页签类型
local ToggleType = {
    Info = 1,
    UpLevel = 2,
    UpStar = 3
}

local PrefabPath = {
    [_G.StorageType.Artifact] = {
        awaken = "UIH5/Artifact/ArtifactDevelop/ArtifactDevelop_AwakenView",
        upLevel = "UIH5/Artifact/ArtifactDevelop/ArtifactDevelop_UpLevelView",
        upStar = "UIH5/Artifact/ArtifactDevelop/ArtifactDevelop_UpStarView"
    },
    [_G.StorageType.Spiritual] = {
        upLevel = "UIH5/Spiritual/SpiritualDevelop_UpLevelView",
        upStar = "UIH5/Spiritual/SpiritualDevelop_UpStarView"
    },
}

function BagArtifectPopView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---DeComposeCall 分解回调
function BagArtifectPopView:OnCreate(data, DeComposeCall, ResetCall)
    self.data = data
    self.type = Type[_G.StorageManager:GetInstance():CheckSidType(data.sid)]
    self.DeComposeCall = function()
        DeComposeCall()
        self:Close()
    end
    self.ResetCall = ResetCall
    if self.type == 1 then
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemArtifactBase,
            self.go_table.obj_item,
            function(itemLua)
                self.Rightlua_Artifact = itemLua
                self.Rightlua_Artifact.gameObject:SetLocalScaleXYZ(1.06)
                self:FreshView()
            end
        )
        self.go_table.aorbtn_shuoming:SetActiveE(0)
        self.go_table.aortext_tips:SetActiveE(0)
    elseif self.type == 2 then
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemSpiritualBase,
            self.go_table.obj_item,
            function(itemLua)
                self.Rightlua_Spiritual = itemLua
                self:FreshView()
            end
        )
        self.go_table.aortext_tips:SetActiveE(1)
        self.go_table.aorbtn_shuoming:SetActiveE(1)
    end
    self.curToggle = ToggleType.Info
    self:InitToggle()
end

function BagArtifectPopView:InitToggle()
    self.toggles = {
        info = _G.GetAutoGoTable(
                self.go_table.toggle_info,
                _G.handlerbind(self, self.OnClickToggle, "info", _G.handler(self, self.OnInfo))
        ),
        upLevel = _G.GetAutoGoTable(
                self.go_table.toggle_upLevel,
                _G.handlerbind(self, self.OnClickToggle, "upLevel", _G.handler(self, self.OnUpLevel))
        ),
        upStar = _G.GetAutoGoTable(
                self.go_table.toggle_upStar,
                _G.handlerbind(self, self.OnClickToggle, "upStar", _G.handler(self, self.OnUpStar))
        )
    }
    self.go_table.toggle_info.isOn = false
    self.go_table.toggle_info.isOn = true
end

function BagArtifectPopView:FreshView()
    if (self.Rightlua_Artifact == nil or self.Rightlua_Artifact == true)
        and (self.Rightlua_Spiritual == nil or self.Rightlua_Spiritual == true) then
        ----item还没生成
        return
    end
    ---@type   EquipmentItem
    local itemData = self.data
    if itemData == nil then
        if self.type == 1 then
            self.Rightlua_Artifact.gameObject:SetActiveE(0)
        elseif self.type == 2 then
            self.Rightlua_Spiritual.gameObject:SetActiveE(0)
        end
        return
    end
    local order = itemData.cfg.Order
    if self.type == 1 then
        self.Rightlua_Artifact:ShowData(itemData)
        self.Rightlua_Artifact:HideLevel()
        self.Rightlua_Artifact:ShowCount(false)
        self.Rightlua_Artifact.gameObject:SetActiveE(1)
        order = order + 4
    elseif self.type == 2 then
        self.Rightlua_Spiritual:ShowData(itemData)
        self.Rightlua_Spiritual:HideLevel()
        self.Rightlua_Spiritual.gameObject:SetActiveE(1)
        order = order + 3
    end

    self.go_table.aortext_name.text = itemData:GetName()
    local ctm = require "CommonTipManager":GetInstance()
    ctm:SetItemTextGradient(self.go_table.aortext_name.gameObject, order > 6 and 8 or order)
    self.go_table.aortext_level.text = _G.GetLangPackValue(90021800050) .. itemData:GetLevel()
    -- for i = 1, 5 do
    --     self.go_RightInfo.go_Artifact["aorimage_star" .. i]:SetActiveE(i <= itemData:GetStar() and 1 or 0)
    -- end
    self:Artifact_Prop(self.go_table, itemData)
    -- self.go_table.aortext_des.text = string.format("%s \nuid:%s", itemData:GetDescribe(), itemData.uid)
    self.go_table.aortext_des.text = itemData:GetDescribe()

    local tb
    local cfg = self.data:GetCfg()
    if cfg.card_id and cfg.card_id > 0 then
        self.go_table.obj_zhuanshu_des:SetActiveE(1)
        self.go_table.obj_putong_des:SetActiveE(0)
        tb = _G.GetAutoGoTable(self.go_table.obj_zhuanshu_des)
        local cardTb = _G.GetAutoGoTable(tb.obj_zhuanshutag)
        local cardCfg = _G.ConfigManager.card_cfg[cfg.card_id] and _G.ConfigManager.card_cfg[cfg.card_id] or nil
        if cardCfg then
            cardTb.aorimage_icon.SpriteName = _G.ConfigManager.card_cfg[cfg.card_id].Icon
        end
    else
        self.go_table.obj_zhuanshu_des:SetActiveE(0)
        self.go_table.obj_putong_des:SetActiveE(1)
        tb = _G.GetAutoGoTable(self.go_table.obj_putong_des)
    end

    local desExText = tb.obj_artifactskill:GetComponentE(_G.typeof(_G.CS.ExtendText))
    desExText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))
    local text = itemData:GetTipSkillDescribe()
    if string.contains(text, "<color=#FC9948>（专属）</color>") then
        text = string.replace(text, "<color=#FC9948>（专属）</color>", "")
    end
    -- ZHJ-36257 修改神器和灵契在背包和商店的对应文字颜色
    text = _G.string.gsub(text, "76daf8", "3d57aa")
    text = _G.string.gsub(text, "5bdf99", "14874a")
    text = _G.string.gsub(text, "ffee9d", "ba7d09")
    desExText.text = text
    if (itemData:GetLevel() > 1 or itemData:GetStar() > 0) then
        self.go_table.aorbtn_resetArtifact:SetActiveE(1)
    else
        self.go_table.aorbtn_resetArtifact:SetActiveE(0)
    end
end

---点击超链接
function BagArtifectPopView:OnHrefClick(id, name, asa)
    require("CommonTipManager"):GetInstance():OpenSkillHyper(_G.tonumber(id), nil, 0, 720)
end

function BagArtifectPopView:Artifact_Prop(go_Artifact, itemData)
    local getProp = itemData:GetAttribute()

    if go_Artifact.propItemDic == nil then
        go_Artifact.propItemDic = {}
    end

    local obj, info, baseValue, tAttrType, lenSum, len, itemIndex
    local SetProp = function(start, props, isPer)
        local attr = {}
        for k, v in pairs(props) do
            if v > 0 then
                _G.table.insert(attr, { key = k, value = v })
            end
        end
        ---排序显示
        _G.table.sort(
            attr,
            function(a, b)
                return _G.AttrType[a.key].sortid < _G.AttrType[b.key].sortid
            end
        )
        len = #attr
        for i = 1, len do
            itemIndex = i + start
            ---生成属性条
            if go_Artifact.propItemDic[itemIndex] == nil then
                obj = _G.InstantiateObject(go_Artifact.obj_propItem, go_Artifact.obj_prop)
                table.insert(go_Artifact.propItemDic, obj)
            else
                obj = go_Artifact.propItemDic[itemIndex]
            end

            info = attr[i]
            ---基础值
            baseValue = info.value

            tAttrType = _G.AttrType[info.key]
            if tAttrType.percentage == 1 or isPer then
                baseValue = baseValue * 100

                baseValue = _G.GameUtil.FormatNum(baseValue)
                baseValue = baseValue .. "%"
            else
                baseValue = _G.math.floor(baseValue)
            end
            self:Artifact_SetProp(obj, "4e5278", _G.AttrType[info.key].des, baseValue, itemIndex, len == i)

            obj:SetActiveE(1)
        end
        return len
    end
    lenSum = SetProp(0, getProp:GetAttrByName())
    lenSum = lenSum + SetProp(lenSum, getProp:GetAttrByName(_G.AttCountType.basePercent), true)

    lenSum = lenSum + 1
    for i = lenSum, #go_Artifact.propItemDic do
        go_Artifact.propItemDic[i]:SetActiveE(0)
    end
end

---@param index number 判断显示条纹
function BagArtifectPopView:Artifact_SetProp(obj, color, name, num, index, isMax)
    local go_table = _G.GetAutoGoTable(obj)

    go_table.aorimage_di:SetActiveE(index % 2 == 0 and 1 or 0)

    go_table.aortext_des.text = string.format("<color=#%s>%s</color>", color, tostring(name))
    go_table.aortext_num.text = string.format("<color=#%s>%s</color>", color, tostring(num))
end

function BagArtifectPopView:UpdateData(data)
    self.data = data and data or _G.StorageManager:GetInstance():GetItemDataByID(self.type + 104, self.data.uid)
    self:FreshView()
    self.ResetCall()
end

function BagArtifectPopView:OnClickBtn(go, isOn)
    --local name = go:GetName()
    if go == self.go_table.aorbtn_Close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_resetArtifact then
        self:OnClickReset(self.data)
    elseif go == self.go_table.aorbtn_decompose then
        self:OnClickDecompose()
    elseif go == self.go_table.aorbtn_shuoming then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.RecommendHeroTipsView.Name,
            self.data.sid

        )
    end
end

function BagArtifectPopView:OnClickToggle(_, isOn, key, call)
    local tb = self.toggles[key]
    if key == "info" then
        self.go_table.aortext_2.text = _G.GetLangPackValue(90022300009)
    else
        self.go_table.aortext_2.text = _G.GetLangPackValue(9002070038)
    end
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if call then
        call(isOn)
    end
end

---重置
function BagArtifectPopView:OnClickReset(itemData)
    if not itemData then
        return
    end

    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ResetLevelView.Name,
        itemData,
        function()
            self.ResetCall()
            self:Close()
        end
    )
end

function BagArtifectPopView:OnClickDecompose()
    local params = {}
    --params.ID = _G.StorageID.Equipment
    params.DeComposeCall = _G.handlerbind(self, self.DeComposeCall)
    local id
    if self.type == 1 then
        id = _G.StorageID.Artifact
    elseif self.type == 2 then
        id = _G.StorageID.Spiritual
    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecomposeView.Name, id, params)
end

function BagArtifectPopView:OnInfo(isOn)
    self.go_table.obj_InfoPanel:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    if self.curToggle == ToggleType.Info then
        return
    end
    self.curToggle = ToggleType.Info
    self:UpdateData()
end

function BagArtifectPopView:OnUpLevel(isOn)
    if self.upLevelView then
        self.upLevelView.gameObject:SetActiveE(isOn and 1 or 0)
    end
    if not isOn then
        return
    end
    if self.curToggle == ToggleType.UpLevel then
        return
    end
    self.curToggle = ToggleType.UpLevel
    local type = _G.StorageManager:GetInstance():CheckSidType(self.data.sid)
    if not self.upLevelView then
        _G.PoolsManager:GetInstance():Spawn(
                PrefabPath[type].upLevel,
                _G.ePoolType.Temporary,
                self.go_table.obj_panel,
                function(obj)
                    if type == _G.StorageType.Artifact then
                        self.upLevelView = self:AddComponent(obj, require("ArtifactDevelop_UpLevelView").New())
                        self.upLevelView:Show(
                                self.data,
                                nil,
                                _G.handler(self, self.UpdateData)
                        )
                        self.upLevelView.go_table.aortext_name:SetActiveE(0)
                    else
                        self.upLevelView = self:AddComponent(obj, require("SpiritualDevelop_UpLevelView").New())
                        self.upLevelView:Init(
                                self.data,
                                _G.handler(self, self.UpdateData),
                                nil,
                                nil
                        )
                    end
                end
        )
    else
        if type == _G.StorageType.Artifact then
            self.upLevelView:Show(
                    self.data,
                    nil,
                    _G.handler(self, self.UpdateData)
            )
        else
            self.upLevelView:Init(
                    self.data,
                    _G.handler(self, self.UpdateData),
                    nil,
                    nil
            )
        end
    end
end

