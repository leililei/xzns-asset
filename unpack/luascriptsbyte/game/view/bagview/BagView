---点击装备，显示装备栏
function BagView:ShowEquipment()
    self.go_table.obj_PropInfoPlane:SetActiveE(0)
    self.ItemIDList.equipment = {}
    self.ItemList.equipment = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Equipment)

    if _G.table.count(self.ItemList.equipment) == 0 then
        self.go_table.aorrawimage_NotItem:SetActiveE(1)
    else
        self.go_table.aorrawimage_NotItem:SetActiveE(0)
        for i, v in pairs(self.ItemList.equipment) do
            if v.cardUid == 0 then
                table.insert(self.ItemIDList.equipment, i)
            end
        end
        if #self.ItemIDList.equipment < 25 then
            for _ = #self.ItemIDList.equipment + 1, 25 do
                table.insert(self.ItemIDList.equipment, 0)
            end
        end
    end
    if self.SelectedItem.equipment > #self.ItemIDList.equipment then
        self.SelectedItem.equipment = #self.ItemIDList.equipment
    end

    table.sort(
        self.ItemIDList.equipment,
        function(a, b)
            if a ~= 0 and b == 0 then
                return true
            elseif a == 0 or b == 0 then
                return false
            end
            local bl = false
            local ea = self.ItemList.equipment[a]
            local eb = self.ItemList.equipment[b]
            if ea == nil or eb == nil then
                return false
            end
            if ea.cfg.grade > eb.cfg.grade then
                bl = true
            elseif ea.cfg.grade == eb.cfg.grade then
                bl = ea:GetPower() > eb:GetPower()
            end
            return bl
        end
    )

    self.go_table.obj_PropInfoPlane:SetActiveE(
        (_G.table.isEmptyOrNil(self.ItemIDList.equipment) == false and self.ItemIDList.equipment[1] ~= 0) and 1 or 0
    )

    _G.DelayDo(
        0.01,
        function()
            self.go_table.scrollloopvectical_EquipmentList:UpdateCount(#self.ItemIDList.equipment)

            self.go_table.scrollloopvectical_EquipmentList:ScrollToIndex(self.SelectedItem.equipment)

            self.IsInitItem["Equipment"] = true
        end
    )
end

---刷新单个装备显示
function BagView:RefreshEquipList(index, obj, CardList)
    if index < 0 then
        return
    end
    local id = obj:GetInstanceID()
    ---@type ItemCardAllView
    local tb_i = self.itemTransLuaDic[id]
    if not tb_i then
        tb_i = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickEquipment, tb_i))
        self.itemTransLuaDic[id] = tb_i
    end
    index = index + 1
    tb_i.Index = index

    local list = self.ItemList.equipment
    local data = list[self.ItemIDList.equipment[index]]
    if data == nil then
        self:SetGrade(tb_i, nil, true)
        tb_i.aorimage_Selected:SetActiveE(0)
        tb_i.obj_obj:SetActiveE(0)
    else
        self:SetGrade(tb_i, data.cfg)
        if index == self.SelectedItem.equipment then
            tb_i.aorimage_Selected:SetActiveE(1)
            self.CurBar = _G.StorageType.Equipment
            self.CurItemData = data
            self:UpdateInfoBar()
        else
            tb_i.aorimage_Selected:SetActiveE(0)
        end
        tb_i.obj_obj:SetActiveE(1)
        tb_i.aorimage_Grade.SpriteName = _G.itemColorDiIconName[data.cfg.grade]
        tb_i.aorimage_EquipColorBG.SpriteName = _G.itemColorIconName[data.cfg.grade]

        tb_i.aorimage_Level.SpriteName = self.toGetTheGradeImage[data.cfg.level]

        if not _G.string.IsNullOrEmpty(data.cfg.icon) then
            require("CardInfoManager").SetRawImageTimer(
                tb_i,
                "Equipment",
                index,
                tb_i.aorrawimage_Icon,
                data.cfg.icon,
                self.IsInitItem,
                self.TimerDic
            )
        end
        -- tb_i.aortext_Lv.text = data.cfg.limit_level

        _G.UIUtils.SetEquipmentStreng(tb_i, data.streng)
        if data.cardUid > 0 then
            tb_i.obj_Card:SetActiveE(1)
            tb_i.aorrawimage_CardIcon:LoadImage(
                CardList[data.cardUid].cfg.Icon,
                function(image)
                    if image == nil then
                        return
                    end
                    image:SetActiveE(1)
                end
            )
        else
            tb_i.obj_Card:SetActiveE(0)
        end
    end
    return tb_i
end

