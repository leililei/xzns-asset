        end
    elseif name == "@_aorbtn_clicklock" then
        require "DecorationModel":GetInstance():Lock(
            self.CurItemData.cardUid,
            self.CurItemData.uid,
            self.CurItemData.isLock and 0 or 1,
            function()
                self:UpdateInfoBar()
            end
        )
    else
        if isOn == false then
            return
        end
        if name == "@_aorbtn_SingleResolve" then
            self:UsedLeftBtn()
        elseif name == "@_aorbtn_Up" then
            self:UsedRightBtn()
        elseif name == "@_aorbtn_CloseView" then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BagView.Name)
        else
        end
    end
    _G.AudioManager.PlaySoundYeQian(name)
end

---显示品质特效
function BagView:SetGrade(go_table, cfg, isHide, parent, size)
    parent = parent or go_table.gameObject
    size = size or 2.15
    _G.UIUtils.SetItemGrade(go_table, cfg, isHide, parent, size)
end

function BagView:OnDestroy()
    for _, value in pairs(self.TimerDic) do
        if value ~= nil then
            _G.coroutine.stopwaiting(value)
        end
    end
end

return BagView
