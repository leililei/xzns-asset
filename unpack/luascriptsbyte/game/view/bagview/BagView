---界面的入口函数
function BagView:OnCreate(index)
    self.itemTransLuaDic = {}
    ---默认显示道具栏
    if index then
        if index == 1 then
            self:ShowProp()
            self.go_table.toggle_Prop.isOn = true
        elseif index == 2 then
            self.go_table.toggle_Material.isOn = true
            self:ShowMaterial()
        elseif index == 3 then
            self.go_table.toggle_Equip.isOn = true
            self:ShowEquipment()
        elseif index == 4 then
            self.go_table.toggle_Equip.isOn = true
            self:ShowEquipment()
            self:Resolve()
        elseif index == 5 then
            self.go_table.toggle_kehun.isOn = true
            self:ShowDecoration()
        end
    else
        self:ShowProp()
    end
end

---点击道具，显示道具栏
function BagView:ShowProp()
    self.go_table.obj_PropInfoPlane:SetActiveE(0)
    self.ItemIDList.prop = {}

    ---实际数量 更改当前显示item
    local dataCount = 0
    if _G.table.count(self.ItemList.prop) == 0 then
        self.go_table.aorrawimage_NotItem:SetActiveE(1)
    else
        self.go_table.aorrawimage_NotItem:SetActiveE(0)
        for i, _ in pairs(self.ItemList.prop) do
            table.insert(self.ItemIDList.prop, i)
        end
        dataCount = #self.ItemIDList.prop
        if #self.ItemIDList.prop < 25 then
            for _ = #self.ItemIDList.prop + 1, 25 do
                table.insert(self.ItemIDList.prop, 0)
            end
        end
    end

    if self.SelectedItem.prop > dataCount then
        self.SelectedItem.prop = dataCount
    end
    table.sort(
        self.ItemIDList.prop,
        function(a, b)
            if a ~= 0 and b == 0 then
                return true
            elseif a == 0 or b == 0 then
                return false
            end
            local bl = false
            local ea = self.ItemList.prop[a]
            local eb = self.ItemList.prop[b]
            if ea == nil or eb == nil then
                return false
            end
            if ea.cfg.Quality > eb.cfg.Quality then
                bl = true
            end
            return bl
        end
    )
    self.go_table.obj_PropInfoPlane:SetActiveE(
        (_G.table.isEmptyOrNil(self.ItemIDList.prop) == false and self.ItemIDList.prop[1] ~= 0) and 1 or 0
    )

    _G.DelayDo(
        0.01,
        function()
            self.go_table.scrollloopvectical_PropList:UpdateCount(#self.ItemIDList.prop)
            self.go_table.scrollloopvectical_PropList:ScrollToIndex(self.SelectedItem.prop)

            self.IsInitItem["prop"] = true
        end
    )
end

function BagView:RefreshPropList(index, obj)
    if index < 0 then
        return
    end

    index = index + 1
    local id = obj:GetInstanceID()
    ---@type ItemCardAllView
    local tb = self.itemTransLuaDic[id]
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickItem, tb))
        self.itemTransLuaDic[id] = tb
    end

    tb.Index = index
    local list = self.ItemList.prop
    local data
    data = list[self.ItemIDList.prop[index]]
    if data == nil then
        self:SetGrade(tb, nil, true)
        tb.aorimage_Selected:SetActiveE(0)
        tb.obj_obj:SetActiveE(0)
    else
        self:SetGrade(tb, data.cfg)
        tb.obj_obj:SetActiveE(1)
        tb.aorimage_Color.SpriteName = _G.itemColorDiIconName[data.cfg.Quality]
        tb.aorimage_EquipColorBG.SpriteName = _G.itemColorIconName[data.cfg.Quality]
        tb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.BackpackItem.id, data.sid)
        if not _G.string.IsNullOrEmpty(data.cfg.Icon) then
            require("CardInfoManager").SetRawImageTimer(
                tb,
                "prop",
                index,
                tb.aorrawimage_Icon,
                data.cfg.Icon,
                self.IsInitItem,
                self.TimerDic,
                function(rawimage)
                    rawimage:SetNativeSize()
                end
            )
        end

        if self.SelectedItem.prop == index then
            tb.aorimage_Selected:SetActiveE(1)
            self.CurBar = _G.StorageType.Prop
            self.CurItemData = data
            self:UpdateInfoBar()
        else
            tb.aorimage_Selected:SetActiveE(0)
        end
        _G.UIUtils.SetItemNum(tb, Mathf.Floor(data.count))
    end
    return tb
end

