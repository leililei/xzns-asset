function BagView:UpdateInfoBar()
    local type = self.CurBar
    local data = self.CurItemData
    if _G.table.isEmptyOrNil(data) then
        return
    end
    local isEquipment = type == _G.StorageType.Equipment
    self:ShowBaseinfo(isEquipment, data)

    self.go_table.aorbtn_Up:SetActiveE(isEquipment == false and 1 or 0)
    if isEquipment then
        self:UpdateEquipInfo(data)
    elseif type == _G.StorageType.Decoration then
        self:UpdateKehun(data)
    else
        self:UpdateItem(data)
    end
end

