---更新饰品(刻魂) 信息栏
function BagView:UpdateKehun(data)
    if _G.table.isEmptyOrNil(data) then
        return
    end
    self.go_table.obj_PropInfoItem:SetActiveE(0)
    self.go_table.obj_EquipInfoItem:SetActiveE(0)
    self.go_table.obj_Prop:SetActiveE(0)
    self.go_table.obj_EquipmentInfo:SetActiveE(0)
    self.go_table.obj_KehunInfoItem:SetActiveE(1)
    self.go_table.obj_KehunInfo:SetActiveE(1)
    ---@type equipment_cfg_Item
    local cfg = data.cfg
    self.go_table.aorrawimage_kehunIcon:LoadImage(cfg.icon)
    self.go_table.aortext_kehunName.text = _G.LangUtil.GetLangPackValue(cfg.name)
    self.go_table.aorimage_kehunColor.SpriteName = _G.itemColorDiIconName[cfg.grade]
    self.go_table.aorimage_keunColorBG.SpriteName = _G.itemColorIconName[cfg.grade]
    self.go_table.aorimage_kehunColorBg.SpriteName = _G.DecorationGradeIcon[cfg.grade]
    self.go_table.aorimage_kehunColorBg:SetEulerAngles(0, 0, data.EulerAngles)
    self.go_table.aortext_LeftBtn.text = "来源"
    self.go_table.aortext_RightBtn.text = "培养"
    if data.streng > 0 then
        self.go_table.aortext_khLV:SetActiveE(1)
        self.go_table.aortext_khLV.text = "+" .. data.streng
    else
        self.go_table.aortext_khLV:SetActiveE(0)
    end

    ---解锁 和 未解锁
    if not data.isLock then
        self.go_table.aorimage_lock.SpriteName = "ui_sp_icon_kaisuo"
    else
        self.go_table.aorimage_lock.SpriteName = "ui_sp_icon_suozhu"
    end

    local prop = data:GetProp()
    local count = 1
    if data.streng > 0 then
        for i, v in pairs(prop.attriOther) do
            if v > 0 then
                local str = string.format("aortext_prop%d", count)
                if self.go_table[str] then
                    self.go_table[str]:SetActiveE(1)
                    v = Mathf.RoundToInt(v)
                    self.go_table[str].text =
                        "<color=#7b5252>" .. _G.AttrType[i].des .. "</color>" .. "<color=#95e7ff> +" .. v .. "</color>"
                    count = count + 1
                end
            end
        end
    else
        for i, v in pairs(prop.attriOther) do
            if v > 0 then
                local str = string.format("aortext_prop%d", count)
                if self.go_table[str] then
                    self.go_table[str]:SetActiveE(1)
                    v = Mathf.RoundToInt(v)
                    self.go_table[str].text =
                        "<color=#7b5252>" .. _G.AttrType[i].des .. "</color>" .. "<color=#95e7ff> +" .. v .. "</color>"
                    count = count + 1
                end
            end
        end
    end

    local tran = _G.GetAutoGoTable(self.go_table.obj_KehunInfo)
    local countChild = tran.obj_Info:GetChildCountE()
    if countChild > 0 then
        for k = 1, countChild do
            _G.PoolsManager:GetInstance():Despawn(tran.obj_Info:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    --随机属性
    local count = 0
    local attr = data:GetProp()
    local dCfg = _G.ConfigManager.discrete_cfg[102903][1]
    local suiAttributeArray = data:AddAttributeToArray()
    for i = 1, #suiAttributeArray do
        local value = suiAttributeArray[i].value
        if value > 0 then
            value = Mathf.RoundToInt(value * 100)
            --itemCount = itemCount + 1
            _G.PoolsManager:GetInstance():Spawn(
                DecorationUPProp,
                _G.ePoolType.UIItem,
                tran.obj_Info,
                function(trans)
                    --itemSucCount = itemSucCount + 1
                    if trans then
                        count = count + 1
                        local tb = _G.GetAutoGoTable(trans)
                        tb.aorrawimage_icon:LoadImage(_G.AttrType[suiAttributeArray[i].key].icon)
                        tb.aortext_Name.text = _G.AttrType[suiAttributeArray[i].key].des
                        if count <= data:GetPropUnlockCount() then
                            tb.aortext_BeforeNum.text = "<color=#018e43>" .. value .. "%</color>"
                        else
                            tb.aortext_BeforeNum.text =
                                "<color=#6d6d6d>" ..
                                string.format(_G.LangUtil.GetLangPackValue(90022300026), dCfg[count]) .. "</color>"
                        end

                        _G.GameUtil.SetActiveByCondition(tb.obj_BG2, false)
                        _G.GameUtil.SetActiveByCondition((tb.aortext_AfterNum), false)
                    end

                    -- if itemSucCount == itemCount then
                    --     self:UpdateRectHeight()
                    -- end
                end
            )
        end
    end
    --套装修过描述
    local cfg = _G.ConfigManager.decoration_suit_cfg[data.cfg.suit]
    local des2 = _G.ConfigManager.attribute_cfg[cfg.att_suit2].describe
    des2 = _G.LangUtil.GetLangPackValue(des2)
    tran.aortext_describe.text = des2
end

