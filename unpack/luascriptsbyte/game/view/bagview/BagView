function BagView:ResolveSingle()
    if self.CurItemData.cardUid ~= 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(CantResolve)
        return
    end
    if self.CurItemData.Grade > _G.EquipQuality.Purple then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            tipsID.HaveHeightGrade,
            nil,
            function()
                --local sid = self.CurItemData.sid
                --local cfg = _G.ConfigManager.equipment_cfg[sid]
                local tmp = {}
                tmp[self.CurItemData.uid] = self.CurItemData
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.ResolveDoneView.Name,
                    tmp,
                    _G.handler(self, self.ResolveDone)
                )
            end
        )
    else
        --local sid = self.CurItemData.sid
        -- local cfg = _G.ConfigManager.equipment_cfg[sid]
        local tmp = {}
        tmp[self.CurItemData.uid] = self.CurItemData
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ResolveDoneView.Name,
            tmp,
            _G.handler(self, self.ResolveDone)
        )
    end
