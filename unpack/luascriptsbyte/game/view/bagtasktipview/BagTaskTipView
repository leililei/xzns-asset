local baseView = require("BagPropInfoTipView")
---@class BagTaskTipView : BagPropInfoTipView	中文描述
---@field public go_table BagTaskTipiew_GoTable GoTable
local BagTaskTipView = _G.BaseClass("BagTaskTipView", baseView)

local LanguageKey = {
    ---一键领取
    yjlq = 90020400087,
    ---第%d章
    type4 = 90020400088,
    ---第%d层
    type8 = 90020400089,
    ---第%d天
    type9 = 90020400090,
    Keyjlq = 90000000122
}

function BagTaskTipView:OnUICreate()
    self.selectItems = {}
    local boxId = _G.tonumber(self.itemData.cfg.UseParameter[1][1])
    ---@type item_box_con_cfg
    self.boxConCfg = _G.ConfigManager.item_box_con_cfg[boxId]
    ---当前已领取索引
    self.progress = self.itemData.progress or 0

    ---可领取索引 1->  nil不能领取
    self.curSelectNum = self.itemData:GetProgressChestSelectNum()

    self.awardDatas = self.boxConCfg.rewards
    self.go_table.scrollloopvectical_item:InitItemData(#self.awardDatas, _G.handler(self, self.RefreshListItem))
end

function BagTaskTipView:RefreshListItem(index, obj)
    local nIndex = index + 1
    local data = self.awardDatas[nIndex]
    local ins = obj:GetInstanceIDE()

    if not self.selectItems[ins] then
        self.selectItems[ins] = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.ClickSelectItem, nIndex, data))
    end
    local go_table = self.selectItems[ins]
    ---true条件达成
    local ispass = false
    ---true条件达成
    local isGet = self.progress >= index + 1
    ---条件描述
    local str = ""

    local condition_params = self.boxConCfg.condition_params[nIndex]
    if condition_params == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("condition_params 解锁参数未配置全  " .. self.boxConCfg.id)
        end
    else
        local tispass, tstr
        if self.boxConCfg.condition_type == 0 then
            tispass, tstr =
                _G.GlobalConditionManager.GetTipsText(
                _G.GlobalConditionManager.ConditionType.createRoleDay,
                condition_params,
                self.itemData:GetProgressChestArgs().time
            )
        else
            tispass, tstr = _G.GlobalConditionManager.GetTipsText(self.boxConCfg.condition_type, condition_params)
        end
        ispass = tispass
        str = tstr

        ---特殊显示 描述        ---第%d章        ---第%d层        ---第%d天
        if self.boxConCfg.condition_type == 4 then
            ---@type afk_cfg
            local afk_cfg = _G.ConfigManager.afk_cfg[condition_params]
            str = _G.LangUtil.GetLangPackValue(LanguageKey.type4, afk_cfg.chapter)
        elseif self.boxConCfg.condition_type == 8 then
            ---@type tower_cfg
            local tower_cfg = _G.ConfigManager.tower_cfg[condition_params]
            str = _G.LangUtil.GetLangPackValue(LanguageKey.type8, tower_cfg.layer)
        elseif self.boxConCfg.condition_type == 9 or self.boxConCfg.condition_type == 0 then
            str = _G.LangUtil.GetLangPackValue(LanguageKey.type9, condition_params)
        end
    end
    go_table.aortext_title.text = str
    go_table.obj_awardGrid:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        data,
        go_table.obj_awardGrid,
        function(itemLua)
            if self:IsNil() then
                _G.DestroyImmediate(itemLua.gameObject)
                return
            end
            if itemLua.ShowNumText then
                itemLua:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
            if itemLua.SetGou then
                itemLua:SetGou(isGet)
            end
        end
    )
end

---按钮点击事件在这里派发
function BagTaskTipView:OnClickBtn(go, isOn)
    baseView.OnClickBtn(self, go, isOn)
    if go == self.go_table.aorbtn_get then
        if not self.curSelectNum or self.curSelectNum <= self.itemData.progress then
            _G.PopWindowManager:GetInstance():ShowAllTips(380106)
            return
        else
            _G.StorageManager:GetInstance():UsePropToServer(
                self.itemData.sid,
                self.curSelectNum,
                function()
                    self.itemData.progress = self.curSelectNum
                    self.progress = self.curSelectNum
                    ---领取完就关闭
                    if self.itemData.progress == #self.boxConCfg.rewards then
                        self:OnCloseView()
                    else
                        ---没领取完就刷新
                        self.go_table.scrollloopvectical_item:UpdateAllItem()
                    end
                    ---红点显示 道具
                    require("RedPointManager"):GetInstance():RefreshNode(
                        _G.ConfigManager.redpoint_cfg.BackpackItem.id,
                        self.itemData.sid
                    )
                end
            )
        end
    end
end

return BagTaskTipView
