---@class DownloadPlayTipsManager : Singleton
---@field GetInstance fun():DownloadPlayTipsManager
local DownloadPlayTipsManager = _G.BaseClass("DownloadPlayTipsManager", _G.Singleton)
_G.DownloadPlayTipsManager = DownloadPlayTipsManager

--region 新增

---CSCallLuaDownloadPlayHandler 下载远程包资源时候，开始下载和下载完成回调
---@param port number 状态1.开始下载 2.下载成功
---@param ab_name string ab资源路径
function DownloadPlayTipsManager.CSCallLuaDownloadPlayHandler(state, ab_name)
    if state == 1 then
        if _G.AppSetting.DEBUG then
            _G.Log("DownloadPlayTipsManager.CSCallLuaDownloadPlayHandler start:" .. ab_name .. ",Size:" .. _G.CS.RemotePackage.PackageManagerHelper.GetPackageInfoSize(ab_name))
        end
    elseif state == 2 then
        if _G.AppSetting.DEBUG then
            _G.Log("DownloadPlayTipsManager.CSCallLuaDownloadPlayHandler success:" .. ab_name .. ",Size:" .. _G.CS.RemotePackage.PackageManagerHelper.GetPackageInfoSize(ab_name))
        end
    end
end

_G.CS.ResourceLoad.ABRequest.DownloadPlayHandler = DownloadPlayTipsManager.CSCallLuaDownloadPlayHandler

---@param showMask boolean 遮罩开关
function DownloadPlayTipsManager.ShowDownLoading(showMask)
    local name = _G.ConfigManager.ui_cfg.DownloadPlayTipsView.Name
    if not showMask then
        _G.UIManager:GetInstance():HideWindow(name)
        return
    end
    if _G.UIManager:GetInstance():IsActiveWindow(name) then
        _G.UIManager:GetInstance():ShowWindow(name)
    else
        _G.UIManager:GetInstance():OpenWindow(name)
    end
end

function DownloadPlayTipsManager.ShowDownLoadForce(isLogIn)
    local name = _G.ConfigManager.ui_cfg.DownloadPlayForceView.Name
    if not _G.UIManager:GetInstance():IsActiveWindow(name) then
        _G.UIManager:GetInstance():OpenWindow(name, isLogIn)
    end
end
--endregion

