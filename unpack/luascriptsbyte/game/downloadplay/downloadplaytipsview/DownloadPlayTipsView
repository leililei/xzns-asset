---@class DownloadPlayTipsView : UIBaseView	中文描述
---@field public go_table DownloadPlayTipsView_GoTable GoTable
local DownloadPlayTipsView = _G.BaseClass("DownloadPlayTipsView", _G.UIBaseView)
local showEffectTime = 5
function DownloadPlayTipsView:Awake()
end
---界面的入口函数
function DownloadPlayTipsView:OnCreate()
    _G.Events:GetInstance():AddListener(_G.eNetTipsViewShow.Show, self.ShowMask, self)
end
function DownloadPlayTipsView:OnEnable()
    self.go_table.trans_eff:SetActiveE(0)
    if self.showEffectTimer then
        self.showEffectTimer:Stop()
        self.showEffectTimer = nil
    end
    self.showEffectTimer = _G.TimerManager:GetInstance():GetTimer(showEffectTime, self.ShowEffect, self, true)
    self.showEffectTimer:Start()
end
function DownloadPlayTipsView:OnDisable()
    if self.showEffectTimer then
        self.showEffectTimer:Stop()
        self.showEffectTimer = nil
    end
end
---销毁对象时,析构函数
function DownloadPlayTipsView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eNetTipsViewShow.Show, self.ShowMask, self)
end

function DownloadPlayTipsView:ShowEffect()
    self.go_table.trans_eff:SetActiveE(1)
end

function DownloadPlayTipsView:ShowMask(isShow)
    self.go_table.obj_mask:SetActiveE(isShow and 0 or 1)
end
return DownloadPlayTipsView
