---@class DownloadPlayForceView : UIBaseView	中文描述
---@field public go_table DownloadPlayForceView_GoTable GoTable
local DownloadPlayForceView = _G.BaseClass("DownloadPlayForceView", _G.UIBaseView)
function DownloadPlayForceView:Awake()
end
---界面的入口函数
function DownloadPlayForceView:OnCreate(param)
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    -- local UIUtils = _G.UIUtils
    -- UIUtils.LoadEffectByCfg(
    --         _G.ConfigManager.ui_effect_cfg.ef_downloadplay,
    --         self.go_table.trans_effect,
    --         function(trans)
    --             if self.go_table == nil then
    --                 UIUtils.RemoveEffect(trans)
    --                 return
    --             end
    --             trans:RequireComponentE(_G.typeof(_G.CS.UIParticleOrderChange))
    --         end
    -- )
    self.go_table.aorbtn_CloseView:SetActiveE(1)
    if param ~= nil and param == true then
        self.go_table.aorbtn_CloseView:SetActiveE(0)
        _G.DownloadPlayManager:GetInstance():DownloadAllByLogin()
    end
    _G.DownloadPlayManager:GetInstance():CancelSpeedLimit()
    if self.UpdateTimer then
        self.UpdateTimer:Stop()
        self.UpdateTimer = nil
    end
    self.lastDownloadedSize = _G.DownloadPlayManager:GetInstance():GetDownloadedSize()
    self.UpdateTimer = _G.TimerManager:GetInstance():GetTimer(1, self.ShowView, self)
    self.UpdateTimer:Start()
end

---销毁对象时,析构函数
function DownloadPlayForceView:OnDestroy()
    if self.UpdateTimer then
        self.UpdateTimer:Stop()
        self.UpdateTimer = nil
    end
end

---按钮点击事件在这里派发
function DownloadPlayForceView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_2" then
        self.go_table.obj_window:SetActiveE(0)
    elseif name == "@_aorbtn_1" then
        _G.GameUtil.DoSDKQuit()
    elseif name == "@_aorbtn_CloseView" then
        self.go_table.obj_window:SetActiveE(1)
    end
end

function DownloadPlayForceView:ShowView()
    self:RefreshDownloadProgress()
end

function DownloadPlayForceView:RefreshDownloadProgress()
    local totalSize = _G.DownloadPlayManager:GetInstance().totalSize
    local downloadedSize = _G.DownloadPlayManager:GetInstance():GetDownloadedSize()
    if totalSize == downloadedSize then
        self:Close()
    else
        self.go_table.slider_process.value = downloadedSize / totalSize
        local strDownload = string.format("(%s/%s)", _G.DownloadPlayManager:GetInstance():GetDownloadSizeStr(downloadedSize),
                _G.DownloadPlayManager:GetInstance():GetDownloadSizeStr(totalSize))
        self.go_table.aortext_download.text = strDownload
        local strSpeed = _G.GetLangPackValue(90028100016, _G.DownloadPlayManager:GetInstance():GetDownloadSizeStr(downloadedSize - self.lastDownloadedSize))
        self.go_table.aortext_processNum.text = strSpeed
        self.lastDownloadedSize = downloadedSize
    end
end

return DownloadPlayForceView
