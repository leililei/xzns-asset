---开始后台下载
function DownloadPlayManager:BeginDownloadAll()
    if not _G.AppSetting.IS_REMOTE then
        return
    end
    if IsBeginAll then
        return
    end
    self.DownloadPackageType = {
        Group1 = "Group1",
        Group2 = "Group2"
    }
    local choosePackage = {}
    local chooseIndex = {}
    table.insert(chooseIndex, 1)
    table.insert(chooseIndex, 2)
    table.insert(choosePackage, self.DownloadPackageType.Group1)
    table.insert(choosePackage, self.DownloadPackageType.Group2)
    
    self:DownloadPackagesFirst(
        chooseIndex,
        choosePackage,
        function()
            _G.Events:GetInstance():Broadcast(_G.eDownloadPlay.DownloadComplete)
        end
    )
    if self:GetGroupTotalSize(choosePackage) > self:GetDownloadedSizeByPaths(choosePackage) then
        if BeginSize == 0 then
            BeginSize = self:GetDownloadedSize()
        end
        self.updateTimer = _G.TimerManager:GetInstance():GetTimer(DelayTime, self.UpdateTime, self)
        self.updateTimer:Start()
    end
    IsBeginAll = true
end

function DownloadPlayManager:UpdateTime(elapsed)
    if self:GetGroupTotalSize(self.PackagePaths) == self:GetDownloadedSizeByPaths(self.PackagePaths) then
        self:StopUpdateTimer()
        return
    end
    --断网状态
    if _G.CS.UnityEngine.Application.internetReachability == _G.CS.UnityEngine.NetworkReachability.NotReachable then
        return
    end
    if self.ApplicationPauseTime ~= nil then
        elapsed = elapsed - self.ApplicationPauseTime
        self.ApplicationPauseTime = nil
    end
    DownloadAllTime = DownloadAllTime + elapsed
    if DownloadAllTime >= CheckTime then
        DownloadAllTime = 0
        local downloadedSize = self:GetDownloadedSize()
        --下载速度太慢并且达到放置阶段就弹窗
        if downloadedSize - BeginSize < CheckSize and require("AfkModel"):GetInstance():GetCurSection() > CheckSection then
            _G.DownloadPlayTipsManager.ShowDownLoadForce(false)
            self:StopUpdateTimer()
        else
            BeginSize = downloadedSize
        end
    end
end

function DownloadPlayManager:OnApplicationPauseEnd(time)
    self.ApplicationPauseTime = time
end

function DownloadPlayManager:StopUpdateTimer()
    if self.updateTimer ~= nil then
        self.updateTimer:Stop()
        self.updateTimer = nil
    end
end

---停止下载
function DownloadPlayManager:StopAll()
    if _G.AppSetting.IS_REMOTE then
        self:StopUpdateTimer()
        self.PackageManager:StopAll()
        IsBeginAll = false
    end
end

---初始化状况
---@return number 1.初始化完成 2.初始化中 3.未初始化
function DownloadPlayManager:GetInitState()
    if IsInit then
        return 1
    elseif IsIniting then
        return 2
    else
        return 3
    end
end

