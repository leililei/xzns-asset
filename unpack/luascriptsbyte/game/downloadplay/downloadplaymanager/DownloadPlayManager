---下载资源包
---@param package_path string
---@param callback function
function DownloadPlayManager:DownloadPackage(package_path, callback)
    self.CurPackage = package_path
    if _G.CS.RemotePackage.PackageManagerHelper.IsGroupDownloaded(package_path) then
        if callback then
            self.DownloadState = _G.DownloadState.Complete
            callback()
        end
    else
        self.DownloadState = _G.DownloadState.Downloading
        self:TryLoadGroup(package_path, callback)
    end
end

function DownloadPlayManager:TryLoadGroup(package_path, callback)
    _G.CS.RemotePackage.PackageManagerHelper.TryLoadGroup(
        package_path,
        function()
            if callback then
                self.DownloadState = _G.DownloadState.Complete
                _G.Events:GetInstance():Broadcast(
                    _G.eDownloadPlay.HideDownloadBtn,
                    not self:IsDownloadedAndGetAwardAll()
                )
                callback()
            end
        end,
        function(errorCode, errorMessage, abPath, url)
            _G.PopWindowManager:GetInstance():ShowAllTips(999999)

            if ErrorABPath[abPath] == nil then

                if _G.AppSetting.DEBUG then
                    _G.LogError("errorCode:" .. errorCode)
                end

                if _G.AppSetting.DEBUG then
                    _G.LogError("errorMessage:" .. errorMessage)
                end

                if _G.AppSetting.DEBUG then
                    _G.LogError("abPath:" .. abPath)
                end

                if _G.AppSetting.DEBUG then
                    _G.LogError("url:" .. url)
                end
                ErrorABPath[abPath] = true
            end
           
            self:TryLoadGroup(package_path, callback)
        end
    )
end

---获取包的总size
---@param package_paths table
function DownloadPlayManager:GetGroupTotalSize(package_paths)
    local totalSize = 0
    for k, v in pairs(package_paths) do
        totalSize = totalSize + _G.CS.RemotePackage.PackageManagerHelper.GetGroupTotalSize(v)
    end
    return totalSize
end

---@param package_paths table
function DownloadPlayManager:SetPackagePaths(package_paths)
    ---@type table 本次下载总的包集合
    self.PackagePaths = _G.DeepCopy(package_paths)
    ---@type number 本次下载总大小
    self.totalSize = 0
    for k, v in pairs(self.PackagePaths) do
        self.totalSize = self.totalSize + _G.CS.RemotePackage.PackageManagerHelper.GetGroupTotalSize(v)
    end
end

---下载资源包
---@param package_paths table
---@param callback function
function DownloadPlayManager:DownloadPackagesFirst(downloading_index, package_paths, callback)
    ---@type table 下载的下标
    self.DownloadingIndex = downloading_index
    self:SetPackagePaths(package_paths)
    self:DownloadPackages(package_paths, callback)
end

---@return number 当前已下载大小
function DownloadPlayManager:GetDownloadedSize()
    local size = 0
    for k, v in pairs(self.PackagePaths) do
        size = size + _G.CS.RemotePackage.PackageManagerHelper.GetGroupDownloadSize(v)
    end
    return size
end

---@return number 当前已下载大小
function DownloadPlayManager:GetDownloadedSizeByPaths(package_paths)
    local size = 0
    for k, v in pairs(package_paths) do
        size = size + _G.CS.RemotePackage.PackageManagerHelper.GetGroupDownloadSize(v)
    end
    return size
end

---下载资源包
---@param package_paths table
---@param callback function
function DownloadPlayManager:DownloadPackages(package_paths, callback)
    if table.count(package_paths) == 1 then
        for k, v in pairs(package_paths) do
            self:DownloadPackage(v, callback)
        end
    else
        for k, v in pairs(package_paths) do
            self:DownloadPackage(
                v,
                function()
                    table.remove(package_paths, k)
                    self:DownloadPackages(package_paths, callback)
                end
            )
            break
        end
    end
end

---限速
---@param speed number 每秒下载多少byte
function DownloadPlayManager:SetSpeedLimit(speed)
    local downloadPolicy = _G.CS.RemotePackage.ZHJDownloadPolicy.Instance
    downloadPolicy:SetSpeedLimit(speed)
end

---取消限速
function DownloadPlayManager:CancelSpeedLimit()
    local downloadPolicy = _G.CS.RemotePackage.ZHJDownloadPolicy.Instance
    downloadPolicy:SetSpeedLimit(0)
end

---暂停下载
function DownloadPlayManager:Pause()
    self.DownloadState = _G.DownloadState.Pause
    self.PackageManager:PauseGroupDownload(self.CurPackage)
end

---恢复下载
function DownloadPlayManager:Resume()
    self.DownloadState = _G.DownloadState.Downloading
    self.PackageManager:ResumeGroupDownload(self.CurPackage)
end

---获取下载状态
---@return DownloadState
function DownloadPlayManager:GetDownloadState()
    return self.DownloadState
end

