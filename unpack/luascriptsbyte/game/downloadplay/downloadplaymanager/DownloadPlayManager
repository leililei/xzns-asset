---边玩边下载管理器，判断资源是否已经下载完成
---@class DownloadPlayManager:GameDataModelBase
---@field GetInstance fun():DownloadPlayManager
local DownloadPlayManager = _G.BaseClass("DownloadPlayManager", _G.Singleton)
_G.DownloadPlayManager = DownloadPlayManager
local IsInit = false
local IsIniting = false
local IsBeginAll = false
local DownloadAllTime = 0
local BeginSize = 0
local CheckSize = 0
local CheckSection = 0
local DelayTime = 10
local CheckTime = 300
local ErrorABPath = {}

function DownloadPlayManager:__init()
    -- ---@type table 已下载资源包缓存 --暂时只用缓存function
    -- self.DownloadedPackage = {}
    ---@type DownloadState
    self.DownloadState = _G.DownloadState.Stop
    -- self.LoginDownload = false
    CheckSection = tonumber(_G.ConfigManager.discrete_cfg[109201][1][1])
    --100kb * 300秒 = 30720000b
    CheckSize = tonumber(_G.ConfigManager.discrete_cfg[109201][1][2]) * 1024 * 300
    self:InitAndBegin()
end

---@return DownloadPlayManager
function DownloadPlayManager:GetInstance()
    return self.super.GetInstance(self)
end

---初始化配置信息
function DownloadPlayManager:InitAndBegin()
    if _G.AppSetting.IS_REMOTE and not _G.AppSetting.IsWebGl then
        self.PackageManager = _G.CS.RemotePackage.PackageManager.Instance
        if not IsInit and not IsIniting then
             if _G.CS.Launcher.Inst.IsSDK then
                 local remoteUrl = _G.CS.ResourceLoad.PathManager.RES_SDK_GAME_RES_URL

                 if _G.AppSetting.DEBUG then
                     _G.Log("边玩边下地址:" .. remoteUrl)
                 end

                 if string.find(remoteUrl, "_") then
                     --不同版本的APK使用不同的远程资源
                     --当前app版本号
                     local appVersion = _G.Application.version
                     --拆分获取版本号_ 多版本的边玩边下
                     local mSplit = _G.string.split(remoteUrl, "_")
                     for _, v in pairs(mSplit) do
                         local remotevesion = _G.string.split(v, "|")
                         if remotevesion[1] == appVersion then
                             --加个开关
                             if _G.string.contains(remotevesion[2], "closefunction") then
                                 _G.AppSetting.IS_REMOTE = false
                                 return
                             end
                             local remote = _G.string.split(remotevesion[2], "+")
                             self.PackageManager.RemoteURLRoot = remote[1]
                             self.PackageManager.Version = remote[2]
                             self.Version = remote[2]
                             break
                         end
                     end
                 else
                     -- 所有APK版本都使用相同的远程资源
                     local remote = _G.string.split(remoteUrl, "+")
                     self.PackageManager.RemoteURLRoot = remote[1]
                     self.PackageManager.Version = remote[2]
                     self.Version = remote[2]
                 end

             else
                 -- ---内网测试地址
                 local mSplit = _G.string.split("http://cdn-zhj.opop113.com/tw3androidres/tw3res20240625001+1.0.0", "+")
                 self.PackageManager.RemoteURLRoot = mSplit[1]
                 self.PackageManager.Version = mSplit[2]
                 self.Version = mSplit[2]
             end
            if self.PackageManager.LocalVersion ~= self.PackageManager.Version then
                _G.CS.AorIO.DelDirectory(self.PackageManager.CacheDir)
            end
            --限速1mb
            local downloadPolicy = _G.CS.RemotePackage.ZHJDownloadPolicy.Instance
            --并行数设置
            _G.CS.DownloadManager.ConccurrentCount = 5

            self.PackageManager.UseWWWRequest = true
            self.PackageManager.CRCValidate = true
            self.PackageManager.OnLoadImpl = function(abPath, call)
                call()
            end
             self.PackageManager.OnDownloadABPackageFailed = function(abPath, errorCode, errorMessage, call)
                 if ErrorABPath[abPath] == nil then

                     --if _G.AppSetting.DEBUG then
                         _G.LogError("errorCode:" .. errorCode..",errorMessage:"..errorMessage..",errorMessage:"..errorMessage)
                     --end

                     ErrorABPath[abPath] = true
                 end
                 
                 --错误码后面再加
                 if _G.CS.DownloadErrorCode == errorCode then
                     --内存满了提示
                     _G.PopWindowManager:GetInstance():ShowAllTips(
                         760105,
                         nil,
                         function()
                             --_G.GameUtil.DoSDKQuit()
                         end
                     )
                 else
                     call()
                 end
             end
            IsIniting = true
            ---@type fun():void
            local loadinit
            loadinit = function()
                self.PackageManager:InitFromHttpConfig(
                function(isSucceed)
                    IsIniting = false
                    if isSucceed then
                        if _G.AppSetting.DEBUG then
                            _G.Log("PackageManager InitFromHttpConfig Success")
                        end
                        IsInit = true

                        if not _G.AppSetting.IsXzns then
                            downloadPolicy:SetSpeedLimit(1024 * 1024)
                        end
                    else
                        if _G.AppSetting.DEBUG then
                            _G.LogError("PackageManager InitFromHttpConfig Fail")
                        end
                        _G.PopWindowManager:GetInstance():ShowAllTips(180105, nil, loadinit)
                    end
                end,
                downloadPolicy
            )
            end
            loadinit()
        end
    else
        IsInit = true
    end
end

