require "BaseGameNet"

---@class DownloadPlayNet : BaseGameNet	通信协议
local DownloadPlayNet = _G.BaseClass("DownloadPlayNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return DownloadPlayNet DownloadPlayNet
function DownloadPlayNet:GetInstance()
    return self.super.super.GetInstance(self)
end

function DownloadPlayNet:GetInfo(callback)
    local item = _G.ConfigManager.net_map.game_download_award_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.AccessCall))
    self.Call[port] = callback
end

---领取奖励
---@param callback function 回调方法
function DownloadPlayNet:AccessAward(pB, callback)
    local item = _G.ConfigManager.net_map.game_download_award_award
    local port = base.Access(self, item, pB, _G.handler(self, self.AccessCall))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function DownloadPlayNet:AccessCall(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end
return DownloadPlayNet
