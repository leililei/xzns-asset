local ArenaReportPanel = require("ArenaReportPanelView")
local CrossServiceReportItem = require("CrossServiceReportItem")

---@class CrossServiceReportPanel : ArenaReportPanelView 窗口
---@field private go_table CrossServiceReportPanel_GoTable GoTable
local CrossServiceReportPanel = BaseClass("CrossServiceReportPanel",ArenaReportPanel)

function CrossServiceReportPanel:__init()

end

function CrossServiceReportPanel:OnCreate(msg)
    self:InitData(msg)
    self:RefreshData()
    self:InitUI()
    self:RefreshUI()
end

function CrossServiceReportPanel:InitData(msg)
    self.itemTransDic = {}
    self.go_table.scrollloopvectical_report:InitItemData(0, _G.handler(self, self.RefreshItem))

    self:GetData()
end

function CrossServiceReportPanel:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    local instanceID = obj:GetInstanceIDE()
    if not self.itemTransDic[instanceID] then
        self.itemTransDic[instanceID] = CrossServiceReportItem.New(obj)
    end
    index = index + 1
    self.itemTransDic[instanceID]:RefreshItem(self.reportList[index])
end

function CrossServiceReportPanel:GetData()
    local ActivityTournamentModel = require("ActivityTournamentModel"):GetInstance()
    ActivityTournamentModel:GetBattleData(_G.handler(self, self.ShowReport))
end

---@param list s2c_activity_tournament_report
function CrossServiceReportPanel:ShowReport(list)
    ---@type i_report[]
    self.reportList = list.reports
    local count = self.reportList and #self.reportList or 0
    self.go_table.obj_emptybg:SetActiveE(count == 0 and 1 or 0)
    self.go_table.scrollloopvectical_report:UpdateCount(count)
end

function CrossServiceReportPanel:RefreshData()

end

function CrossServiceReportPanel:InitUI()
    self.go_table = _G.GetAutoGoTable(self.gameObject,handler(self,self.OnClickBtn))
end

function CrossServiceReportPanel:RefreshUI()

end


---OnClickBtn按钮点击事件
---@protected
---@param go GameObject 按钮对象
---@param isOn boolean 状态（toggle使用）
function CrossServiceReportPanel:OnClickBtn(go, isOn)
    if self.go_table.aorbtn_close  == go then
        self:Close()
    end
end
---关闭前调用
function CrossServiceReportPanel:CloseBase()

end

---@return CrossServiceReportPanel
return CrossServiceReportPanel