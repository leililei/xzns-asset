local RankUtils = require("RankUtils")

---@class CrossServiceCompRankItem
---@field private go_table CrossServiceCompRankView._obj_playRankItem_GoTable
local CrossServiceCompRankItem = BaseClass("CrossServiceCompRankItem")

---__init构造函数
---@protect
function CrossServiceCompRankItem:__init(cardRoot)
    self.root = cardRoot
    self.go_table = _G.GetAutoGoTable(self.root, handler(self, self.OnClickBtn))

    ---@type _obj_SpecialRankNode_GoTable
    self.SpecialRankNode = GetAutoGoTable(self.go_table.obj_SpecialRankNode)
end

---OnClickBtn 点击按钮
---@param go table
---@param isOn boolean
---@protect
function CrossServiceCompRankItem:OnClickBtn(go, isOn)

end

---@param data CrossServiceCompPerson.RankData
function CrossServiceCompRankItem:RefreshItem(data,index,isEmpty)
    self.data = data
    local rank = index

    self.go_table.obj_Promotion:SetActiveE(0)
    if rank == nil then
        RankUtils.SetRankItemBgIcon(self.go_table.aorimage_bg,4)
        self.go_table.aortext_rank:SetActiveE(1)
        self.go_table.obj_SpecialRankNode:SetActiveE(0)
        self.go_table.aortext_rank.text = GetLangPackValue(90022900040)
    else
        RankUtils.SetRankItemBgIcon(self.go_table.aorimage_bg,index)
        if rank <= 3 then
            self.go_table.aortext_rank:SetActiveE(0)
            self.go_table.obj_SpecialRankNode:SetActiveE(1)
            RankUtils.SetObj_SpecialRankNode(self.SpecialRankNode,rank)
        else
            self.go_table.aortext_rank:SetActiveE(1)
            self.go_table.obj_SpecialRankNode:SetActiveE(0)
            self.go_table.aortext_rank.text = rank
        end
        if rank <= 64 then
            self.go_table.obj_Promotion:SetActiveE(1)
        end
    end

    if isEmpty then
        self.go_table.obj_content:SetActiveE(0)
        self.go_table.obj_noBody:SetActiveE(1)
        return
    end
    self.go_table.obj_content:SetActiveE(1)
    self.go_table.obj_noBody:SetActiveE(0)
    self.go_table.aortext_desc.text = data.value
    self.go_table.aortext_name.text = data.role_info.name
    local uid = data.role_info.uid
    if uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
        _G.UIUtils.SetPlayerHeadItemNew(
                self.go_table.obj_head,
                _G.PlayerModel:GetInstance():GetIRroleTable(),
                1,
                true,
                true,
                true
        )
    else
        _G.UIUtils.SetPlayerHeadItemNew(self.go_table.obj_head,
                data.role_info
        , 1, true, true, true)
    end
    GameUtil.ReBuildRTF(self.go_table.aortext_desc)
    GameUtil.ReBuildRTF(self.go_table.obj_autoDescNode)
end

function CrossServiceCompRankItem:RefreshItem_Play(value)
    self.go_table.obj_Promotion:SetActiveE(0)
    self.go_table.aorimage_bg:SetActiveE(0)
    self.go_table.obj_SpecialRankNode:SetActiveE(0)
    self.go_table.aortext_rank.text = GetLangPackValue(90022900040)
    local playdata =  _G.PlayerModel:GetInstance():GetIRroleTable()
    _G.UIUtils.SetPlayerHeadItemNew(
            self.go_table.obj_head,
            playdata,
            1,
            true,
            true,
            true
    )
    self.go_table.aortext_name.text = playdata.name
    self.go_table.aortext_desc.text = value
end

---@return CrossServiceCompRankItem
return CrossServiceCompRankItem