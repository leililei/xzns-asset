local TeamUniteTaskView = require("TeamUniteTaskView")

---@class CrossServiceTaskView : TeamUniteTaskView 窗口
---@field private go_table CrossServiceTaskView_GoTable GoTable
local CrossServiceTaskView = BaseClass("CrossServiceTaskView",TeamUniteTaskView)

function CrossServiceTaskView:__init()

end

function CrossServiceTaskView:InitView()
    self.Datas = CrossServiceModel:GetInstance():GetTaskDatas()
    self.CurIndex = self:SetCurTaskingIndex() ---当前进行的最大index
    self.curIndex = self.CurIndex or 1
    self.go_table.scrollloopvectical_itemList:InitItemData(#self.Datas, _G.handler(self, self.RefreshItem), self
            .curIndex)
    self:InitEffect()
end

---计算当前正在进行的任务索引
function CrossServiceTaskView:SetCurTaskingIndex()
    local index = 0
    if table.isEmptyOrNil(self.Datas) then
        return nil
    else
        for k, v in pairs(self.Datas) do
            if v.i_task.state == _G.TaskEnum.ETaskState.Submited then
                if CrossServiceModel:GetInstance():CheckIsCanTake(v.sid) then
                    break
                end
            elseif v.i_task.state == _G.TaskEnum.ETaskState.Claimed then
                break
            end
            index = index + 1
        end
        return index
    end
end

function CrossServiceTaskView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    index = index + 1
    local data
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.ClickIce, index))
    self.ItemList[index] = tb
    data = self.Datas[index]

    tb.aortext_title.text = GetLangPackValue(data.Cfg.desc)

    local IsGet = CrossServiceModel:GetInstance():CheckIsGet(data.sid)
    local iscantake = CrossServiceModel:GetInstance():CheckIsCanTake(data.sid)

    if iscantake then
        -- 能够领取
        tb.aorbtn_get:SetActiveE(1)
        tb.aorbtn_go:SetActiveE(0)
        tb.aorimage_got:SetActiveE(0)
    elseif IsGet then
        -- 已经领取
        tb.aorbtn_get:SetActiveE(0)
        tb.aorbtn_go:SetActiveE(0)
        tb.aorimage_got:SetActiveE(1)
    else
        -- 没有完成
        tb.aorbtn_get:SetActiveE(0)
        tb.aorbtn_go:SetActiveE(1)
        tb.aorimage_got:SetActiveE(0)
        tb.aortext_title.text = tb.aortext_title.text .. string.format("(%d/%d)", data.i_task.target[1], data.Cfg.count)
    end
    tb.obj_awards:RemoveAllChildren()
    for _, v in pairs(data.Cfg.reward) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
                v,
                tb.obj_awards,
                function(item)
                    if not tb.obj_awards then
                        _G.DestoryObject(item)
                        return
                    end
                    item:SetGou(IsGet)
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    item.gameObject:SetLocalScaleXYZ(0.8)
                end)
    end
end

---@return CrossServiceTaskView
return CrossServiceTaskView