local RankUtils = require("RankUtils")
local ArchaeologyRankItem = require("ArchaeologyRankItem")
local CrossServiceCompRankItem = require("CrossServiceCompRankItem")

---@class CrossServiceCompRankView : UIBaseView 窗口
---@field private go_table CrossServiceCompRankView_GoTable GoTable
local CrossServiceCompRankView = BaseClass("CrossServiceCompRankView",_G.UIBaseView)

function CrossServiceCompRankView:__init()

end

function CrossServiceCompRankView:OnCreate(msg)
    self:InitData(msg)
    self:RefreshData(msg)
    self:InitUI()
    self:RefreshUI()
end

function CrossServiceCompRankView:InitData(msg)
    self.curSelectTag = self.go_table.aorbtn_person
    ---@type CrossServiceCompRankView._aorbtn_person_GoTable[]
    self.taglist = {
        GetAutoGoTable(self.go_table.aorbtn_person,handler(self,self.OnClickBtn)),
        GetAutoGoTable(self.go_table.aorbtn_alliance,handler(self,self.OnClickBtn))
    }

    local  RecordRankModel = require("RecordRankModel"):GetInstance()
    ---@type CrossServiceCompPerson
    self.rankData = nil
    RecordRankModel:GetListInfo(RankUtils.RankType.CrossServiceCompPerson,function()
        self.rankData = RecordRankModel:GetRankData(RankUtils.RankType.CrossServiceCompPerson)
        if self.isInitUI then
            self:RefreshUI()
        end
    end)
    ---@type CrossServiceCompRankItem[]
    self.itemList = {}
end

function CrossServiceCompRankView:RefreshData(msg)
    local RecordRankModel = require("RecordRankModel")
    if self.curSelectTag == self.taglist[1].aorbtn_person then
        RecordRankModel:GetListInfo(RankUtils.RankType.CrossServiceCompPerson,function()
            self.rankData = RecordRankModel:GetRankData(RankUtils.RankType.CrossServiceCompPerson)
            if self.isInitUI then
                self:RefreshUI()
            end
        end)
    else
        RecordRankModel:GetListInfo(RankUtils.RankType.CrossServiceCompAlliance,function()
            self.rankData = RecordRankModel:GetRankData(RankUtils.RankType.CrossServiceCompAlliance)
            if self.isInitUI then
                self:RefreshUI()
            end
        end)
    end
end

function CrossServiceCompRankView:InitUI()
    self.go_table = _G.GetAutoGoTable(self.gameObject,handler(self,self.OnClickBtn))

    self.go_table.scrollloopvectical_rankList:InitItemData(0,_G.handler(self, self.RefreshItem))

    ---@type CrossServiceCompRankItem
    self.playItem = CrossServiceCompRankItem.New(self.go_table.obj_playRankItem)
    self.isInitUI = true
end

function CrossServiceCompRankView:RefreshItem(index,obj)
    local newIndex = index + 1
    ---@type CrossServiceCompPerson.RankData
    local cfg = self.rankData.listRankDatas[newIndex]
    local id = obj:GetInstanceIDE()
    local item = self.itemList[id]
    if item == nil then
        item = CrossServiceCompRankItem.New(obj)
    end
    item:RefreshItem(cfg,newIndex)
end

function CrossServiceCompRankView:RefreshUI()
    if self.curSelectTag == self.taglist[1].aorbtn_person then
        self.taglist[1].obj_choose:SetActiveE(1)
        self.taglist[2].obj_choose:SetActiveE(0)
        self.go_table.aortext_rankName.text = GetLangPackValue(90033500095)
    else
        self.taglist[1].obj_choose:SetActiveE(0)
        self.taglist[2].obj_choose:SetActiveE(1)
        self.go_table.aortext_rankName.text = GetLangPackValue(90033400103)
    end

    if self.rankData then
        self.go_table.scrollloopvectical_rankList:UpdateCount(#self.rankData.listRankDatas)
        if self.rankData and self.rankData.GetPlayIsOnRank then
            local ishas,data = self.rankData:GetPlayIsOnRank()
            if ishas then
                self.playItem:RefreshItem(data,self.rankData:GetMyRank())
            else
                self.playItem:RefreshItem_Play(self.rankData:GetMyIntegral())
            end
        end
    end
end


---OnClickBtn按钮点击事件
---@protected
---@param go GameObject 按钮对象
---@param isOn boolean 状态（toggle使用）
function CrossServiceCompRankView:OnClickBtn(go, isOn)
    if self.go_table.aorbtn_close  == go then
        self:Close()
    elseif go == self.go_table.aorbtn_person or go == self.go_table.aorbtn_alliance then
        self.curSelectTag = go
        self:RefreshData()
        self:RefreshUI()
    end
end

---@return CrossServiceCompRankView
return CrossServiceCompRankView