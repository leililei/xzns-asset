---@param data
function CrossServiceReportItem:RefreshItem(data)
    self.data = data
    self:Show(data)
end

local SetOtherPlayer = function(data)
    local otherPlayer = {}
    otherPlayer.frame = data.frame
    otherPlayer.name = data.target_role_name
    otherPlayer.level = data.target_level
    otherPlayer.style = data.target_style
    return otherPlayer
end
function CrossServiceReportItem:Show(data)
    self.otherPlayer = SetOtherPlayer(data)
    self.winner = data.winner[1] == 0 and true or false
    self.reportID = data.uid
    self.playbackUid = data.playback_uid
    local isWin = false
    if data.report_type == 0 then
        if self.winner then
            --self.go_table.aorimage_resultbg.SpriteName = resultTag.win
            self.go_table.aorimage_resultTag.SpriteName = resultTag.attackwin
            isWin = true
        else
            --self.go_table.aorimage_resultbg.SpriteName = resultTag.lose
            self.go_table.aorimage_resultTag.SpriteName = resultTag.attacklose
            isWin = false
        end
    else
        if self.winner then
            --self.go_table.aorimage_resultbg.SpriteName = resultTag.win
            self.go_table.aorimage_resultTag.SpriteName = resultTag.defencewin
            isWin = true
        else
            --self.go_table.aorimage_resultbg.SpriteName = resultTag.lose
            self.go_table.aorimage_resultTag.SpriteName = resultTag.defencelose
            isWin = false
        end
    end
    UIUtils.SetPlayerHeadItemNew(self.go_table.obj_HeadItemBase, data.role, 1, true, false, false)
    self.go_table.aortext_name.text = data.role.name
    --self.go_table.aortext_power.text = _G.GameUtil.NumberToUnitWord(data.target_power)
    self.go_table.aortext_time.text = self:TranslateTime(data.time)
    local showScore = ""
    if isWin then
        showScore = GetLangPackValue(90022100101) .. ":+" .. data.score
    else
        showScore = GetLangPackValue(90022100101) .. ":-" .. data.score
    end
    self.go_table.aortext_score.text = showScore --:AddColor(isWin and "" or "")
    self.go_table.aorimage_arrow.SpriteName = isWin and "0ui_icon_shangsheng" or "0ui_icon_xiajiang"
    self:ShowReportDescribe(data)
end

function CrossServiceReportItem:TranslateTime(time)
    local servertime = _G.TimeUtil.GetServerUnixTime()
    time = _G.TimeUtil.TranslateSecond(servertime - time)
    if time.day > 0 then
        time.day = time.day > 30 and 30 or time.day
        return format(getlangpackvalue(90022100085), time.day)
    end
    if time.hour > 0 then
        if time.min > 0 then
            return format(getlangpackvalue(90022100084), time.hour, time.min)
        else
            return format(getlangpackvalue(90022100086), time.hour)
        end
    end
    time.min = time.min > 0 and time.min or 1
    return format(getlangpackvalue(90022100083), time.min)
end

