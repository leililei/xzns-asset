function StoryItemDisplayView:Show_GuideOperate()
    if _G.IsNil(self.gotable_GuideOperate) then
        self:CloseView()
        return
    end

    _G.AudioManager.PlayAudioByAudioCfgID(2032)
    self.gotable_GuideOperate.animator =
        self.gotable_GuideOperate.obj_ef_Guide_operate:GetComponentE(_G.typeof(CS.UnityEngine.Animator))
    if self.gotable_GuideOperate.animator ~= nil then
        self.gotable_GuideOperate.animator:Play("a_Guide_operate_show")
    end
    _G.coroutine.waitforseconds(1.5)

    if _G.IsNil(self.go_table) then
        return
    end
    self.gotable_GuideOperate.aortext_tips:SetActiveE(1)

    local closeFun = function()
        if self.gotable_GuideOperate.animator ~= nil then
            self.gotable_GuideOperate.animator:Play("a_Guide_operate_hide")
        end
        self.OperateCor =
            _G.DelayDo(
            0.4,
            function()
                self:CloseView()
            end
        )
    end
    self.go_table.aorbtn_displayclose.onClick:AddListener(_G.handler(self, closeFun))
end

