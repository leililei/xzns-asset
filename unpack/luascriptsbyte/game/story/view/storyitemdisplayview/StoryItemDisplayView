---按钮点击事件在这里派发
function StoryItemDisplayView:CloseView(go, isOn)
    if self.colseIng == true then
        return
    end

    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
    if not _G.IsNil(go) and self.isClose == false then
        return
    end

    self.isClose = false
    self.colseIng = true
    if self.gotable_RoleShow ~= nil and self.gotable_RoleShow.Anim ~= nil and self.gotable_RoleShow.AnimHideName ~= nil then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ShadowTopView.Name)
        self.gotable_RoleShow.aortext_tips:SetActiveE(0)
        self.gotable_RoleShow.Anim:Play(self.gotable_RoleShow.AnimHideName)

        self.CloseViewCor =
            _G.DelayDo(
            0.2,
            function()
                self:StartCloseFun()
                _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ShadowTopView.Name)
            end
        )
    else
        self:StartCloseFun()
    end
end

function StoryItemDisplayView:StartCloseFun()
    if self.timer ~= nil then
        self.timer:Stop()
        self.timer = nil
    end
    if self.isStartShowMain then
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
        self.isStartShowMain = nil
    end
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
    if self.StopRoleShow_tipsText ~= nil then
        _G.coroutine.stopwaiting(self.StopRoleShow_tipsText)
    end
    if self.timer_Video ~= nil then
        self.timer_Video:Stop()
        self.timer_Video = nil
    end

    self:Close()

    if self.CloseFun ~= nil then
        self.CloseFun()
        self.CloseFun = nil
    end
end

function StoryItemDisplayView:OnStartClose()
    if self.StopRoleShow_tipsText ~= nil then
        _G.coroutine.stopwaiting(self.StopRoleShow_tipsText)
    end
    if self.RoleInfoCor then
        _G.coroutine.stopwaiting(self.RoleInfoCor)
        self.RoleInfoCor = nil
    end
    if self.CloseViewCor then
        _G.coroutine.stopwaiting(self.CloseViewCor)
        self.CloseViewCor = nil
    end
    if self.OperateCor then
        _G.coroutine.stopwaiting(self.OperateCor)
        self.OperateCor = nil
    end
end

function StoryItemDisplayView:EscClose()
    -- body
    self:CloseView()
end

function StoryItemDisplayView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

function StoryItemDisplayView:OnUIOpened()
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
end

return StoryItemDisplayView
