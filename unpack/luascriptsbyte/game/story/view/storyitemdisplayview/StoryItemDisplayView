            self.StoryVideoQTEView_go_table.obj_node:SetActiveE(0)
            self.StoryVideoQTEView_go_table.aorbtn_VideoClick:SetActiveE(0)
            _G.UIUtils.PlayVideo(
                _G.ConfigManager.video_cfg[self.params[2]],
                function()
                    -- endAction
                    _G.PoolsManager:GetInstance():Despawn(tran, _G.ePoolType.UIItem)
                    self:CloseView()
                end,
                function()
                    _G.UIUtils.LoadEffectByCfg(
                        _G.ConfigManager.ui_effect_cfg.Story_ef_tishidianjixunhuan,
                        self.StoryVideoQTEView_go_table.obj_node,
                        function(effItem)
                            if effItem ~= nil then
                                self.StoryVideoQTEView_go_table.effItem = effItem
                            end
                            self:Video_SetTimer()
                        end
                    )
                end
            )
        end
    )
end
function StoryItemDisplayView:Video_OnClickBtn()
    if self.VideoParams == nil or self.StoryVideoQTEView_go_table == nil then
        return
    end
    self.StoryVideoQTEView_go_table.aorbtn_VideoClick:SetActiveE(0)
    _G.UIUtils.ContinuePlay()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.Story_ef_tishidianjixiaoshi,
        self.StoryVideoQTEView_go_table.effItem,
        function()
            -- body
        end,
        function()
            self.StoryVideoQTEView_go_table.obj_node:SetActiveE(0)
            self:Video_SetTimer()
        end
    )
end
function StoryItemDisplayView:Video_SetTimer()
    if self.VideoParams == nil then
        return
    end
    if self.VideoParams.nowClickIndex == #self.VideoParams.Params then
        return
    end
    self.VideoParams.nowClickIndex = self.VideoParams.nowClickIndex + 1
    if self.timer_Video ~= nil then
        self.timer_Video:Stop()
        self.timer_Video = nil
    end
    local index = self.VideoParams.nowClickIndex
    local timeArr = self.VideoParams.Params
    -- 时间差
    local nowtime = timeArr[index].time
    local oldtime = timeArr[index - 1] and timeArr[index - 1].time or 0
    local time = nowtime - oldtime
    self.timer_Video =
        _G.TimerManager:GetInstance():GetTimer(time, self.GetTimerCallBack, self, true, false, true, timeArr, index)
    self.timer_Video:Start()
end

function StoryItemDisplayView:GetTimerCallBack(timeArr, index)
    _G.UIUtils.PauseVideo()
    if self.StoryVideoQTEView_go_table.effItem ~= nil then
        local pos = timeArr[index].pos
        self.StoryVideoQTEView_go_table.effItem:SetAnchorPosition(pos[1] or 0, pos[2] or 0)
    end
    self.StoryVideoQTEView_go_table.aortext_tips.text = LangUtil.GetLangPackValue(timeArr[index].langId)

    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.Story_ef_tishidianjichuxian,
        self.gameObject,
        function(tran)
            local x, y, z = self.StoryVideoQTEView_go_table.effItem:GetPosition()
            tran:SetPosition(x, y, z)
        end,
        function()
            self.StoryVideoQTEView_go_table.obj_node:SetActiveE(1)
            self.StoryVideoQTEView_go_table.aorbtn_VideoClick:SetActiveE(1)
        end
    )
end

