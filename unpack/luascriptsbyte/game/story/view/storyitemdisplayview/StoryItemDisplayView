    if not _G.IsNil(UiEffCfg) then
        self:SetIfno_UiEff(UiEffCfg)
    else
        self:CloseView()
    end
end

function StoryItemDisplayView:SetIfno_UiEff(UiEffCfg)
    _G.UIUtils.LoadEffectByCfg(
        UiEffCfg,
        self.gameObject,
        nil,
        function()
            --播放完 消失
            self:CloseView()
        end
    )
    self.go_table.aorbtn_displayclose.onClick:AddListener(_G.handler(self, self.CloseView))
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_bg, true)
end

