function StoryItemDisplayView:Init__GuideImageItems(type)
    self.Guide_MaxIndex = 1
    self.Guide_NowIndex = 1
    local len = #self.params
    self.Guide_MaxIndex = (len - 1) / 3

    self:Show_GuideImageItems(1, type)
end
function StoryItemDisplayView:Show_GuideImageItems(i, type)
    local ptth = "UI/Guide/$_obj_Illustration"
    if type == 2 then
        ptth = "UI/Guide/$_obj_Illustration2"
    end
    if _G.IsNil(self.tran_Illustration) then
        _G.PoolsManager:GetInstance():Spawn(
            ptth,
            _G.ePoolType.UIItem,
            self.transform,
            function(tran)
                self.tran_Illustration = tran
                self.IlluAnim = tran:GetComponentE(typeof(CS.UnityEngine.Animator))
                self:SetIfno_GuideImageItems(i)
            end
        )
    else
        self:SetIfno_GuideImageItems(i)
    end
end

function StoryItemDisplayView:SetIfno_GuideImageItems(i)
    if i <= 0 or i > self.Guide_MaxIndex then
        return
    end
    if self.gotable_Guide == nil then
        if self.tran_Illustration == nil then
            self:CloseView()
            return
        end
        local gotable = _G.GetAutoGoTable(self.tran_Illustration, _G.handler(self, self.OnClickBtn))
        if gotable == nil then
            self:CloseView()
            return
        end

        self.gotable_Guide = gotable
    end

    _G.AudioManager.PlayAudioByAudioCfgID(2030)
    local StarIndex = 1 + ((i - 1) * 3)

    local desid = tonumber(self.params[StarIndex + 3]) or 0

    -- self.gotable_Guide.aorrawimage_skillinfo:LoadImage(
    --     self.params[StarIndex + 1],
    --     function(image)
    --         if image == nil then
    --             return
    --         end

    --         image:SetNativeSize()
    --     end
    -- )
    self.gotable_Guide.aorrawimage_illustrationContent_1.Alpha = 0
    self.gotable_Guide.aorrawimage_illustrationContent_1:LoadImage(
        self.params[StarIndex + 2],
        function(image)
            if image == nil then
                return
            end

            image:SetNativeSize()
            if desid > 0 then
                self.gotable_Guide.aorrawimage_illustrationContent_1:SetAnchorPosition(0, 0)
            else
                self.gotable_Guide.aorrawimage_illustrationContent_1:SetAnchorPosition(0, -17)
            end
            self.gotable_Guide.aorrawimage_illustrationContent_1.Alpha = 1
        end
    )
    self.gotable_Guide.aorrawimage_illustrationContent_2.Alpha = 0
    self.gotable_Guide.aorrawimage_illustrationContent_2:LoadImage(
        self.params[StarIndex + 2],
        function(image)
            if image == nil then
                return
            end
            image:SetNativeSize()
            if desid > 0 then
                self.gotable_Guide.aorrawimage_illustrationContent_2:SetAnchorPosition(0, 0)
            else
                self.gotable_Guide.aorrawimage_illustrationContent_2:SetAnchorPosition(0, -17)
            end
            self.gotable_Guide.aorrawimage_illustrationContent_2.Alpha = 1
        end
    )

    self.gotable_Guide.aortext_skillInfo.text = _G.LangUtil.GetLangPackValue(self.params[StarIndex + 1])

    self.IllurContent = self.gotable_Guide.obj_ani:GetComponentE(typeof(CS.UnityEngine.Animator))

    if desid > 0 then
        self.gotable_Guide.aortext_illustrationDesc.text = _G.LangUtil.GetLangPackValue(desid)
    end
    --self.gotable_Guide["aorimage_skillinfo (3)"]:SetActiveE(desid > 0 and 1 or 0)
    self.gotable_Guide["aortext_illustrationDesc"]:SetTextAlpha(desid > 0 and 1 or 0)

    self.Guide_NowIndex = i
    self.gotable_Guide.aorbtn_IllRight:SetActiveE((i + 1 <= self.Guide_MaxIndex) and 1 or 0)
    self.gotable_Guide.aorbtn_IllLeft:SetActiveE((i - 1 >= 1) and 1 or 0)
end

function StoryItemDisplayView:OnGuideImageItems_L(go, isOn)
    self:SetIfno_GuideImageItems(self.Guide_NowIndex - 1)
    self.IlluAnim:Play("a_guideview_Illustration_nor")
    self.IlluAnim:Update(0)
    self.IlluAnim:Play("a_guideview_Illustration_fanye")
    self.IllurContent.enabled = true
    self.IllurContent:Play("a_guideview_contentqiehuan_left")
end

function StoryItemDisplayView:OnGuideImageItems_R(go, isOn)
    self:SetIfno_GuideImageItems(self.Guide_NowIndex + 1)
    self.IlluAnim:Play("a_guideview_Illustration_nor")
    self.IlluAnim:Update(0)
    self.IlluAnim:Play("a_guideview_Illustration_fanye")
    self.IllurContent.enabled = true
    self.IllurContent:Play("a_guideview_contentqiehuan_right")
end

