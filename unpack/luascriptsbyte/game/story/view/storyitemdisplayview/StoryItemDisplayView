function StoryItemDisplayView:OnCreate(params, actionId, CloseFun)
    self.isClose = false
    self.CloseFun = CloseFun
    self.params = params
    self.actionId = actionId
    self.isStartShowMain =
        self.isStartShowMain or _G.UIManager:GetInstance():IsActiveWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    local Key = self.params[1]

    local viewdata = self.AllView[Key]
    if viewdata ~= nil then
        if self[Key] == nil then
            _G.PoolsManager:GetInstance():Spawn(
                viewdata.prefab,
                _G.ePoolType.UIItem,
                self.transform,
                function(tran)
                    self[Key] = self:AddComponent(tran, require(viewdata.lua).New(self, self.params))
                end
            )
        else
            self[Key]:OnCreate(self, self.params)
        end

        return
    end
    if Key == "GuideImageItems" then
        ---参数
        --         -- StoryItemDisplayView#1
        --  self.params =
        -- #GuideImageItems
        -- #Images/Guide/ui_ydsm_font_ms02#Images/Guide/ui_ydsm_pic_pt02#90000000003
        -- #Images/Guide/ui_ydsm_font_ms04#Images/Guide/ui_ydsm_pic_pt04#90000000005
        -- #Images/Guide/ui_ydsm_font_ms07#Images/Guide/ui_ydsm_pic_pt07#90000000008
        self:Init__GuideImageItems()
    elseif Key == "GuideImageItems2" then
        ---参数
        --         -- StoryItemDisplayView#1
        --  self.params =
        -- #GuideImageItems
        -- #Images/Guide/ui_ydsm_font_ms02#Images/Guide/ui_ydsm_pic_pt02#90000000003
        -- #Images/Guide/ui_ydsm_font_ms04#Images/Guide/ui_ydsm_pic_pt04#90000000005
        -- #Images/Guide/ui_ydsm_font_ms07#Images/Guide/ui_ydsm_pic_pt07#90000000008
        self:Init__GuideImageItems(2)
    elseif Key == "RoleShow" then
        ---参数
        --         -- StoryItemDisplayView#1
        --  self.params =
        -- #RoleShow
        -- #114200000
        -- #年龄：99岁               (多语言id)
        -- #身份：寄寄寄             (多语言id)
        -- #地狱道：大大大            (多语言id)
        -- #我要这天下，天天下         (多语言id)

        self:Init__RoleShow()
    elseif Key == "GuideOperate" then ---参数
        --         -- StoryItemDisplayView#1
        -- #GuideOperate
        self:Init__GuideOperate()
    elseif Key == "xuchu" then ---参数
        --         -- StoryItemDisplayView#1
        -- #GuideOperate
        self:Init__GuideOperate()
    elseif Key == "VideoQTE" then ---参数
        --         -- StoryItemDisplayView#1
        -- #GuideOperate
        self:Video_Init()
    else
        self:Show_UiEff()
    end

    local delay = _G.ConfigManager.discrete_cfg[_G.DiscreteCfg_Enum.viewCloseDelay]
    delay = tonumber(delay) or 1
    self.timer = _G.TimerManager:GetInstance():GetTimer(delay, self.TimerSetIsClose, self, true, false)
    self.timer:Start()
end

function StoryItemDisplayView:TimerSetIsClose()
    self.isClose = true
end

