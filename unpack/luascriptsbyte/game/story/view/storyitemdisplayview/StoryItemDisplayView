    -- }

    -- local re, str = pcall(json.encode, Params)
    -- local res, gae = pcall(json.decode, str)

    self.VideoParams = {
        ---@type StoryItemDisplayView_VideoQTE_ParamsItem[]
        Params = Params,
        nowClickIndex = 0
    }

    _G.PoolsManager:GetInstance():Spawn(
        "UI/Story/StoryVideoQTEView",
        _G.ePoolType.UIItem,
