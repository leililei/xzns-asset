---@class StoryYlxView : UIBaseView	中文描述
---@field public go_table StoryYlxView_GoTable GoTable
local StoryYlxView = _G.BaseClass("StoryYlxView", _G.UIBaseView)
--_G.StoryYlxView = StoryYlxView

local CS = _G.CS
local typeof = _G.typeof

function StoryYlxView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
end
function StoryYlxView:SetParamNil()
    self.taskid = nil
    self.sectionId = nil
    self.infoStr_title = nil
    self.infoStr_content = nil
    self.infoStr_name = nil
    self.timer_ylxEff = nil
end

---@field public call function
---@class params_StoryYlxView Data

---界面的入口函数
---@param  Data params_StoryYlxView
function StoryYlxView:OnCreate(Data)
    if Data ~= nil then
        self.call = Data.call
    end
    self:SetData()
end
function StoryYlxView:SetData(Data)
    local GetTasks = _G.TaskModule:GetInstance():UnLockSectionTask()
    self.taskid = GetTasks[1]
    local taskCfg = _G.ConfigManager.task_cfg[self.taskid]

    local langID = nil
    if taskCfg ~= nil then
        self.sectionId = taskCfg.script_type[1]
        local sectionCfg = _G.ConfigManager.main_section_cfg[self.sectionId]
        langID = sectionCfg.script_doc
    end
    -- sectionCfg.script_doc
    self.infoStr_title = "名字"
    self.infoStr_content = "语言表配置不规范 无#\n taskid:" .. self.taskid .. "\n sectionId:" .. self.sectionId
    self.infoStr_name = "署名"
    if langID ~= nil then
        local strList = string.split(_G.LangUtil.GetLangPackValue(langID), "#")
        local title = strList[1]
        if title ~= nil then
            self.infoStr_title = title
        end
        local content = strList[2]
        if content ~= nil then
            self.infoStr_content = content
        end
        local name = strList[3]
        if name ~= nil then
            self.infoStr_name = name
        end
    end

    self:LoadYlxEff()
end

function StoryYlxView:LoadYlxEff()
    ---加载特效
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_yanlingxin_ui,
        self.go_table.obj_ScriptRoot_letter,
        function(trans)
            ---等待特效时间
            self:StopTimer_ylx()
            self.timer_ylxEff =
                _G.DelayDo(
                3,
                function()
                    self.go_table.aortext_title.text = self.infoStr_title
                    self.go_table.aortext_Content.text = self.infoStr_content
                    self.go_table.aortext_name.text = self.infoStr_name
                    _G.GameUtil.SetActiveByCondition(self.go_table.obj_text, true)
                    self.timer_ylxEff = nil
                end
            )
        end
    )
end

function StoryYlxView:GoSection()
    ---@type task.i_task
    local i_task = {}
    i_task.sid = self.taskid
    i_task.state = _G.TaskEnum.ETaskState.WaitClaim
    _G.TaskModule:GetInstance():AddTaskInfo(i_task)
    local task = _G.TaskModule:GetInstance():GetTaskWithID(self.taskid)
    task:ExecuteTask()
    -- if task.TaskCfg.is_auto_receive then
    --     _G.TaskModule:GetInstance():AcceptTask(self.taskid, _G.handler(task, task.OnReplyClaimTask))
    -- end
end

function StoryYlxView:OnDisable()
    self:StopTimer_ylx()
    if self.call ~= nil then
        self.call()
        self.call = nil
    end
end

function StoryYlxView:CloseView()
    if self.timer_ylxEff ~= nil then
        return
    end
    self:GoSection()
    self:Close()
end

function StoryYlxView:StopTimer_ylx()
    if self.timer_ylxEff ~= nil then
        _G.coroutine.stopwaiting(self.timer_ylxEff)
        self.timer_ylxEff = nil
    end
end

---按钮点击事件在这里派发
function StoryYlxView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

return StoryYlxView
