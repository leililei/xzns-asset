---@class StoryButtonView : UIBaseView	中文描述
---@field public go_table StoryButtonView_GoTable GoTable
local StoryButtonView = _G.BaseClass("StoryButtonView", _G.UIBaseView)
--_G.StoryButtonView = StoryButtonView

local CS = _G.CS
local typeof = _G.typeof

function StoryButtonView:Awake()
    _G.Events:GetInstance():Broadcast(_G.GuideStoryStart.StoryStart, "StoryButtonView")

    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIShow, self.OnUIShow, self)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIHide, self.OnUIHide, self)
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_Click"] = self.OnClick_btn,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }

    self.cfg = nil

    self.Ani_ZhaoHuan = self.go_table.obj_zhaohuanAni:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
end

---@field call function
---@field id number
---@class params_StoryButtonView Data

---界面的入口函数
---@param  Data params_StoryButtonView
function StoryButtonView:OnCreate(Data)
    if _G.UIManager:GetInstance():IsActiveWindow(_G.ConfigManager.ui_cfg.MainView.Name) == false then
        self:Close()
        return
    end
    self.cfg = nil
    if Data ~= nil then
        self.call = Data.call
    end
    self:SetData(Data)
    ---- 是否有播放其他剧情
    self.isPlay = false
end
function StoryButtonView:SetData(Data)
    local cfg = _G.ConfigManager.button_cfg[Data.id]
    if cfg == nil then
        self:Close()
        return
    end

    self.cfg = cfg
    local name = cfg.ui[2]
    if name == nil then
        self:Close()
        return
    end

    local isClick = true
    local color = _G.Color.New(255 / 255, 255 / 255, 255 / 255, 255 / 255)
    if cfg.backdropType == 0 then
        color = _G.Color.New(255 / 255, 255 / 255, 255 / 255, 0 / 255)
    elseif cfg.backdropType == 1 then
        isClick = false
        color = _G.Color.New(255 / 255, 255 / 255, 255 / 255, 0 / 255)
    elseif cfg.backdropType == 2 then
        isClick = false
        color = _G.Color.New(255 / 255, 255 / 255, 255 / 255, 230 / 255)
    end
    if self.cfg.triggertype[1] == 1000 then
        if require("StoryButtonManager"):GetInstance():GetIsSaveData(Data.id) == true then
            isClick = true
            color = _G.Color.New(255 / 255, 255 / 255, 255 / 255, 0 / 255)
        end
    end
    self.go_table.aorimage_black.raycastTarget = isClick == false
    self.go_table.aorimage_black.color = color
    if "obj_zhaohuan" == name then
        --- 按钮燃烧 播放音效
        _G.AudioManager.PlayAudioByAudioCfgID(2021)
    end
    _G.GameUtil.SetActiveByCondition(self.go_table[name], true)
end

function StoryButtonView:OnStartClose()
    if self.call ~= nil then
        self.call()
        self.call = nil
    end
    _G.Events:GetInstance():Broadcast(_G.GuideStoryStart.StoryEnd, "StoryButtonView")
end

function StoryButtonView:CallFun()
    self:Close()
end

--region --------------------------------------点击事件--------

function StoryButtonView:OnClick_btn()
    if self.cfg == nil then
        self:Close()
        return
    end
    if self.cfg.result[1] == 1 then
        require("StoryButtonManager"):GetInstance():SetSaveData(self.cfg.id)

        self.isPlay = true
        self.Ani_ZhaoHuan:Play("A_ef_obj_zhaohuan_hide")
        _G.DelayDo(
            0.7,
            function()
                _G.AutomaticPlayStory.PlayStoryByID(
                    self.cfg.result[2],
                    function()
                        self:CallFun()
                        -- body
                    end
                )
                self:Hide()
            end
        )

        return
    elseif self.cfg.result[1] == 1000 then
        ---@type params_StoryYlxView
        local data = {}
        data.call = function()
            self:CallFun()
        end

        self.isPlay = true
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.StoryYlxView.Name, data)
        self:Hide()
    end

    self:Close()
end

---按钮点击事件在这里派发
function StoryButtonView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

--endregion

function StoryButtonView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIShow, self.OnUIShow, self)
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIHide, self.OnUIHide, self)
end

function StoryButtonView:OnUIShow(name)
    if name ~= _G.ConfigManager.ui_cfg.MainView.Name then
        return
    end
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.StoryButtonView.Name)
end

--- 主界面隐藏  本界面隐藏
function StoryButtonView:OnUIHide(name)
    if name ~= _G.ConfigManager.ui_cfg.MainView.Name then
        return
    end
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.StoryButtonView.Name)
end

return StoryButtonView
