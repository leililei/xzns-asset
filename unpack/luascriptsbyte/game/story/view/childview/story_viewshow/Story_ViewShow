local BaseStoryChidView = require "BaseStoryChidView"
---@class Story_ViewShow : Component	模板
local Story_ViewShow = _G.BaseClass("Story_ViewShow", BaseStoryChidView)

-- local CS = _G.CS
-- local typeof = _G.typeof

---创建对象时,入口构造函数
function Story_ViewShow:OnCreate(View)
    BaseStoryChidView.OnCreate(self, View)
    --按钮点击对应的方法  未注册
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["@_aorbtn_ClickItem"] = self.ClickItem,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self:InitView()
end

function Story_ViewShow:InitView()
    self.go_table.aorbtn_CloseView:SetActiveE(0)
    _G.DelayDo(
        1,
        function()
            self.go_table.aorbtn_CloseView:SetActiveE(1)
        end
    )
end
----ZHJ-17210【主线副本】序章宝箱奖励点击后没有详情弹窗------
function Story_ViewShow:ClickItem()
    require("CommonTipManager"):GetInstance():OpenTip(self.gameObject, 12)
end
function Story_ViewShow:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

---销毁对象时,析构函数
function Story_ViewShow:OnDestroy()
end

return Story_ViewShow
