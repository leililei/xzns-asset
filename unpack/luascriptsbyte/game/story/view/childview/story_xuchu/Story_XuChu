local BaseStoryChidView = require "BaseStoryChidView"
---@class Story_XuChu : Component	许褚出场定帧
local Story_XuChu = _G.BaseClass("Story_XuChu", BaseStoryChidView)

---创建对象时,入口构造函数
function Story_XuChu:OnCreate(View)
    BaseStoryChidView.OnCreate(self, View)
    --按钮点击对应的方法  未注册
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["@_aorbtn_bossSkillbtn"] = self.OnClick_Skill,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    self.goTable = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))

    self.SkillObj = {
        [1] = _G.GetAutoGoTable(self.goTable.obj_skill_1, _G.handler(self, self.OnClickBtn)),
        [2] = _G.GetAutoGoTable(self.goTable.obj_skill_2, _G.handler(self, self.OnClickBtn)),
        [3] = _G.GetAutoGoTable(self.goTable.obj_skill_3, _G.handler(self, self.OnClickBtn)),
        [4] = _G.GetAutoGoTable(self.goTable.obj_skill_4, _G.handler(self, self.OnClickBtn))
    }

    _G.UIUtils.Preload(_G.ConfigManager.video_cfg["Xuchuchuchang1"])
    self.SkillIDArr = {124210301, 124210101, 124210401, 124210501}
    self.nowSkillID = nil
    self:InitView()
end

function Story_XuChu:InitView()
    _G.UIUtils.PlayVideo(_G.ConfigManager.video_cfg["Xuchuchuchang"], _G.handler(self, self.OnVideoPlayComplete1))

    self:ShowSkill()
end

function Story_XuChu:OnVideoPlayComplete1()
    if self.gameObject == nil then
        return
    end

    self.gameObject:SetParentE(_G.UIManager:GetInstance():GetUILayerTrans(_G.UILayers.TopLayer.Name))
    _G.GameUtil.SetActiveByCondition(self.goTable.obj_node, true)
    _G.UIUtils.PlayVideo(_G.ConfigManager.video_cfg["Xuchuchuchang1"])
end

function Story_XuChu:ShowSkill()
    self.skilIndex = 0
    for i = 1, 4 do
        self:SetSkill(self.SkillIDArr[i])
    end
    self.skilIndex = self.skilIndex + 1
    for i = self.skilIndex, 4 do
        _G.GameUtil.SetActiveByCondition(self.SkillObj[self.skilIndex].gameObject, false)
    end
end
function Story_XuChu:SetSkill(skillid)
    local cfg = _G.ConfigManager.card_skills_cfg[skillid]
    if cfg == nil then
        return
    end
    self.skilIndex = self.skilIndex + 1
    local go = self.SkillObj[self.skilIndex]
    require("CardInfoManager").LoadRawImage(go.aorrawimage_icon, cfg.icon)
    require("CardInfoManager").LoadRawImage(go.aorrawimage_type, cfg.skill_type)
    go.aorbtn_bossSkillbtn:GetParent():SetName(tostring(skillid))

    _G.GameUtil.SetActiveByCondition(go.gameObject, true)
end

function Story_XuChu:OnClick_Skill(go, isOn, name)
    local skillid = go:GetParent():GetName()
    skillid = tonumber(skillid)
    if skillid == nil then
        return
    end

    self:SetSkillIsOn(self.nowSkillID, false)
    require("CommonTipManager"):GetInstance():OpenSkillTip(skillid)

    self.nowSkillID = skillid
    self:SetSkillIsOn(skillid, true)
end

function Story_XuChu:SetSkillIsOn(SkillID, isOn)
    if SkillID == nil then
        return
    end
    local index = self:GetSkillIndex(SkillID)
    if index ~= nil then
        _G.GameUtil.SetActiveByCondition(self.SkillObj[index].obj_ison, isOn)
    end
end
function Story_XuChu:GetSkillIndex(skillID)
    for i = 1, 4 do
        if self.SkillIDArr[i] == skillID then
            return i
        end
    end
    return nil
end

function Story_XuChu:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

function Story_XuChu:CloseView()
    BaseStoryChidView.CloseView(self)
    _G.UIUtils.CloseVideo()
    _G.DestroyObject(self.gameObject)
end

---销毁对象时,析构函数
function Story_XuChu:OnDestroy()
end

return Story_XuChu
