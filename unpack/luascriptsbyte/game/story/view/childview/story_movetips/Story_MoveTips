local BaseStoryChidView = require "BaseStoryChidView"
---@class Story_MoveTips : Component	模板
local Story_MoveTips = _G.BaseClass("Story_MoveTips", BaseStoryChidView)

local CS = _G.CS
local typeof = _G.typeof

---创建对象时,入口构造函数
function Story_MoveTips:OnCreate(View)
    BaseStoryChidView.OnCreate(self, View)
    --按钮点击对应的方法  未注册
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self:InitView()
end

function Story_MoveTips:InitView()
    _G.DelayDo(
        2,
        function()
            self:CloseView()
            -- self:AllowClose()
        end
    )
end

function Story_MoveTips:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

---销毁对象时,析构函数
function Story_MoveTips:OnDestroy()
end

return Story_MoveTips
