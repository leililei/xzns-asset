local BaseStoryChidView = require "BaseStoryChidView"
---@class Story_Dialogue : Component	模板
local Story_Dialogue = _G.BaseClass("Story_Dialogue", BaseStoryChidView)

local CS = _G.CS
local typeof = _G.typeof

---创建对象时,入口构造函数
function Story_Dialogue:OnCreate(View, params)
    BaseStoryChidView.OnCreate(self, View)
    --按钮点击对应的方法  未注册
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["@_aorbtn_displayclose"] = self.CloseView,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    self.goTable = _G.GetAutoGoTable(self.View.gameObject, _G.handler(self, self.OnClickBtn))
    self.goTable = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self.Tweener = nil
    table.remove(params, 1)
    -- self.strS = {"langid", "langid", "langid", "langid"}
    self.strS = params
    self.objS = {}
    self.strLen = #self.strS
    for i = 1, self.strLen do
        table.insert(self.objS, _G.InstantiateObject(self.goTable.obj_item, self.goTable.obj_parent))
    end
    self.goTable.obj_item:SetActiveE(0)
    local endGoTable = _G.GetAutoGoTable(self.objS[self.strLen])
    endGoTable.obj_fxEnd:SetActiveE(1)

    self:InitView()
end

function Story_Dialogue:InitView()
    self.strIndex = 0

    self:PlayStr()
end
function Story_Dialogue:PlayStr()
    self.strIndex = self.strIndex + 1
    local langidStr = self.strS[self.strIndex]
    if langidStr ~= nil then
        self:SetTxtItem(
            self.objS[self.strIndex],
            langidStr,
            self.strIndex,
            function()
                self:PlayStr()
            end
        )
    else
        self:AllowClose()
        ---显示关闭提示
        self.goTable.aortext_tips:SetActiveE(1)
        self.goTable.aortext_tips:DOFade(0, 1):SetLoops(-1, _G.CS.DG.Tweening.LoopType.Yoyo)
    end
end

function Story_Dialogue:SetTxtItem(obj, langidStr, strIndex, call)
    local goTable = _G.GetAutoGoTable(obj)
    local str = _G.LangUtil.GetLangPackValue(langidStr)
    goTable.aortext_txt.text = str
    CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(goTable.aortext_txt.rectTransform)
    local _, Height = goTable.aortext_txt:GetRectTransformWidthHeight()
    goTable.aorrawimage_mask:SetRectTransformSize(50, 0)

    ---- 设置此句 启始位置 高
    goTable.aorrawimage_mask:SetAnchorPosition(0, strIndex % 2 == 1 and 98 or 30)
    self.Tweener = goTable.aorrawimage_mask.rectTransform:DOSizeDelta(_G.Vector2.New(50, Height), string.len(str) * 0.1)

    self.Tweener:SetEase(_G.CS.DG.Tweening.Ease.Linear)
    self.Tweener.onComplete = _G.handler(self, call)
end

function Story_Dialogue:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

---销毁对象时,析构函数
function Story_Dialogue:OnDestroy()
end

return Story_Dialogue
