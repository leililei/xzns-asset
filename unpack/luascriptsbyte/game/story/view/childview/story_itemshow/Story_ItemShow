local BaseStoryChidView = require "BaseStoryChidView"
---@class Story_ItemShow : Component	模板
local Story_ItemShow = _G.BaseClass("Story_ItemShow", BaseStoryChidView)

local CS = _G.CS
local typeof = _G.typeof

---创建对象时,入口构造函数
function Story_ItemShow:OnCreate(View, params)
    BaseStoryChidView.OnCreate(self, View)
    --按钮点击对应的方法  未注册
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    table.remove(params, 1)
    self.params_image = params[1]
    self:InitView()
end

function Story_ItemShow:InitView()
    self.Timer_DelImage = _G.TimerManager:GetInstance():GetTimer(0.31, self.GetTimerCallBack, self, true, false)
    self.Timer_DelImage:Start()
end

function Story_ItemShow:GetTimerCallBack()
    if not _G.IsNil(self.go_table) then
        self.go_table.aorrawimage_item:LoadImage(
            self.params_image,
            function(image)
                if image ~= nil then
                    image:SetNativeSize()
                end
            end
        )
        self.go_table.aorrawimage_item:SetLocalScaleToOne()
        self.go_table.aorrawimage_item:SetAnchorPosition(0, 0)
    end
end

function Story_ItemShow:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

---销毁对象时,析构函数
function Story_ItemShow:OnDestroy()
end

return Story_ItemShow
