---@class BlackCurtainView : UIBaseView	中文描述
---@field public go_table BlackCurtainView_GoTable GoTable
local BlackCurtainView = _G.BaseClass("BlackCurtainView", _G.UIBaseView)
--_G.BlackCurtainView = BlackCurtainView

local CS = _G.CS
local typeof = _G.typeof

function BlackCurtainView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
end
---界面的入口函数
function BlackCurtainView:OnCreate()
end
---按钮点击事件在这里派发
function BlackCurtainView:CloseView(go, isOn)
    self:Close()
end
function BlackCurtainView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end
return BlackCurtainView
