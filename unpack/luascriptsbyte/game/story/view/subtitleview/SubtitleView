---@class SubtitleView : UIBaseView	中文描述
---@field public go_table SubtitleView_GoTable GoTable
local SubtitleView = _G.BaseClass("SubtitleView", _G.UIBaseView)
--_G.SubtitleView = SubtitleView

---界面的入口函数
---@field data SubtitleCfg_Item
function SubtitleView:OnCreate(data)
    self.AorTextDialogueContent = self.transform:FindE("@_aortext_"):GetComponentE(_G.typeof(_G.CS.AorText))
    if data then
        self:ShowContent(data.Content)
    end
end
---显示内容
---@field content string 内容
function SubtitleView:ShowContent(content)
    self.AorTextDialogueContent.text = content
end
return SubtitleView
