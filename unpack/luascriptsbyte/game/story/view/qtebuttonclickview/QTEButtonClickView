---@class QTEButtonClickView : UIBaseView @QTE按钮点击窗口View
---@field public go_table QTEButtonClickView_GoTable GoTable
---@field private UIInteractionActionData CustomUIInteractionActionData @UI交互数据
---@field private WaitCompleteUIEvents string[] @等待完成的UI事件
---@field private AutoCompleteTimer Timer @自动完成计时器
---@field private QTEProgressUpdateTimer Timer @QTE进度计时器
---@field private QTEProgressTotalTimePassed number @QTE总耗时
local QTEButtonClickView = _G.BaseClass("QTEButtonClickView", _G.UIBaseView)
QTEButtonClickView.UIInteractionActionData = nil
QTEButtonClickView.WaitCompleteUIEvents = nil
QTEButtonClickView.AutoCompleteTimer = nil
QTEButtonClickView.QTEProgressUpdateTimer = nil
QTEButtonClickView.QTEProgressTotalTimePassed = nil

local base = _G.UIBaseView

---QTEButtonClickView构造函数
function QTEButtonClickView:__init(uiinteractiondata)
    self.UIInteractionActionData = uiinteractiondata
    self.QTEProgressTotalTimePassed = 0
end

function QTEButtonClickView:Awake()
    print("QTEButtonClickView:Awake()")
    self.go_table.aorbtn_Btn.onClick:AddListener(_G.handler(self, self.OnButtonClick))
    self.WaitCompleteUIEvents = self.UIInteractionActionData.UIEventsListener
    ---监听所有需要监听的操作事件
    for k, v in pairs(self.WaitCompleteUIEvents) do
        self:AddListener(v, _G.handler(self, self.OnCustomUIEventHandler))
    end
end

---剧情窗口入口函数
function QTEButtonClickView:OnCreate()
    self:InitData()
    self:InitView()
end

---初始化数据
function QTEButtonClickView:InitData()
    self.QTEProgressUpdateTimer = _G.UpdateManager:GetInstance():AddUpdate(_G.handler(self, self.OnProgressUpdate))
    if self.UIInteractionActionData.IsAutoComplete then
        self.AutoCompleteTimer =
            _G.TimerManager:GetInstance():GetTimer(
            self.UIInteractionActionData.AutoCompleteTime,
            self.OnAutoCompleteTimeUp,
            self,
            true
        )
        self.AutoCompleteTimer:Start()
    end
end

---初始化显示
function QTEButtonClickView:InitView()
end

---任务进度更新携程
function QTEButtonClickView:OnProgressUpdate()
    if self.UIInteractionActionData ~= nil then
        self.QTEProgressTotalTimePassed = self.QTEProgressTotalTimePassed + _G.Time.deltaTime
        local progresspercent =
            _G.Mathf.Clamp(
            self.UIInteractionActionData.AutoCompleteTime - self.QTEProgressTotalTimePassed,
            0,
            self.UIInteractionActionData.AutoCompleteTime
        ) / self.UIInteractionActionData.AutoCompleteTime
        self.go_table.aorimage_Progress.fillAmount = progresspercent
    end
end

---自动完成延时时间完毕
function QTEButtonClickView:OnAutoCompleteTimeUp()
    _G.Events:GetInstance():Broadcast(_G.eInputEvent.CompleteAllQTEUIEvents)
end

---响应QTE事件
---@param event stirng @事件
function QTEButtonClickView:OnCustomUIEventHandler(view, event)
    table.removebyvalue(self.WaitCompleteUIEvents, event)
    if #self.WaitCompleteUIEvents == 0 then
        _G.Events:GetInstance():Broadcast(_G.eInputEvent.CompleteAllQTEUIEvents)
    end
end

---点击跳过按钮
---@param go UnityEngine.GameObject @按钮对象
---@param ison number @按钮都是1
function QTEButtonClickView:OnButtonClick(go, isOn)
    print(_G.eInputEvent.QTEButtonClick)
    _G.Events:GetInstance():Broadcast(_G.eInputEvent.QTEButtonClick, _G.eInputEvent.QTEButtonClick)
end

---响应界面关闭
function QTEButtonClickView:Dispose()
    if self.QTEProgressUpdateTimer ~= nil then
        self.QTEProgressUpdateTimer:Stop()
    --_G.coroutine.stopwaiting(self.QTEProgressUpdateTimer)
    end
    if self.AutoCompleteTimer ~= nil and self.AutoCompleteTimer:IsOver() == false then
        self.AutoCompleteTimer:Stop()
    end
    self.QTEProgressUpdateTimer = nil
    self.UIInteractionActionData = nil
    self.AutoCompleteTimer = nil
    self.QTEProgressTotalTimePassed = nil
end

---@type QTEButtonClickView @QTE按钮点击窗口View
return QTEButtonClickView
