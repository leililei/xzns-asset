---@class StoryView : UIBaseView @剧情系统窗口View
---@field public go_table StoryView_GoTable GoTable
---@field public IsCanSkip boolean @是否可跳过
local StoryView = _G.BaseClass("StoryView", _G.UIBaseView)
StoryView.IsCanSkip = true

function StoryView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_SkipDialogue"] = self.OnClick_SkipStory,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
end

---剧情窗口入口函数
function StoryView:OnCreate(data)
    if data.ShowMovie ~= nil then
        self:ShowMovieBg(data.ShowMovie)
    end
end

function StoryView:ShowMovieBg(isShow)
    if isShow == true then
        self:NpcAlphaCheck(false)
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_movieBg, isShow)
    --- 设置跳过按钮到TOP层  否则会被对话界面 挡住  无法点击跳过剧情

    self.go_table.aorbtn_SkipDialogue:SetParentE(_G.UIManager:GetInstance():GetUILayerTrans(_G.UILayers.TopLayer.Name))
end

function StoryView:OnStartClose()
    _G.DestroyImmediate(self.go_table.aorbtn_SkipDialogue)
    self:NpcAlphaCheck(true)
end

function StoryView:OnDisable()
end

