--region --------------------------------------点击事件--------

function StoryView:OnClick_SkipStory()
    _G.DestroyImmediate(self.go_table.aorbtn_SkipDialogue)
    local Story = _G.StoryManager:GetInstance():GetNowStory()
    if Story ~= nil then
        Story:Skip()
    end
end

---按钮点击事件在这里派发
function StoryView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

--endregion

---清除所有事件监听
function StoryView:RemoveAllListener()
end

---@type StoryView @剧情系统窗口View
return StoryView
