local StoryActionScriptMap = _G.StoryActionScriptMap
local StoryActionDataScriptMap = _G.StoryActionDataScriptMap

---@class StoryUtilities @剧情辅助工具
local StoryUtilities = {}

---创建剧情对应行为ID的剧情行为
---@param storystepowner StoryStep @剧情所属步骤
---@param actionid number @剧情行为ID
function StoryUtilities.CreateStoryAction(storystepowner, actionid)
    ---@type story_action_cfg_Item
    local storyactioncfg = _G.ConfigManager.story_action_cfg[actionid]
    if storyactioncfg == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(string.format("该剧情行为创建失败:%s, 剧情id:%s", actionid, storystepowner.StoryOwner.StoryID))
        end
        return
    end

    if StoryActionScriptMap[storyactioncfg.ActionType] ~= nil then
        local realstoryactionscriptpath =
            string.format("Game.Story.Action.%s", StoryActionScriptMap[storyactioncfg.ActionType])

        local realtaskcondition = require(realstoryactionscriptpath)
        local realtaskconditioninstance = realtaskcondition.New(storystepowner, actionid)
        return realtaskconditioninstance
    else
        if _G.AppSetting.DEBUG then
            _G.LogError(string.format("未定义的行为类型:%s,创建行为对象失败!", storyactioncfg.ActionType))
        end
    end
end

---创建剧情对应行为ID的行为数据
---@param actionid number @剧情行为ID
function StoryUtilities.CreateStoryActionData(actionid)
    ---@type story_action_cfg_Item
    local storyactioncfg = _G.ConfigManager.story_action_cfg[actionid]
    if StoryActionDataScriptMap[storyactioncfg.ActionType] ~= nil then
        local realstoryactiondatascriptpath =
            string.format("Game.Story.ActionData.%s", StoryActionDataScriptMap[storyactioncfg.ActionType])

        local realstorydata = require(realstoryactiondatascriptpath)
        local realstorydatainstance =
            realstorydata.New(
            actionid,
            storyactioncfg.DelayTime,
            storyactioncfg.DurationTime,
            storyactioncfg.WaitExecuteComplete,
            storyactioncfg.ActionParam,
            storyactioncfg.IgoreStepWaitExecuteComplete,
            storyactioncfg.ActionParam2
        )
        return realstorydatainstance
    else
        if _G.AppSetting.DEBUG then
            _G.LogError(string.format("未定义的行为类型:%s,创建行为数据对象失败!", storyactioncfg.ActionType))
        end
    end
end

---创建一个剧情实体对象(Note:剧情请统一调用IStoryPlay:CreateStoryItem())
---@param uid number @物体UID
---@param sid number @物体SID
---@param posx number @物体位置X
---@param posz number @物体位置Z
---@param rotx number @物体朝向X
---@param roty number @物体朝向Y
---@param rotz number @物体朝向Z
---@param loadcompletedcb function @实体资源加载完成回调
---@param extra table 额外参数(详见地图配置)
function StoryUtilities.CreateStoryItem(uid, sid, posx, posz, rotx, roty, rotz, loadcompletedcb, extra)
    _G.WorldItemManager:GetInstance():DynamicCreateWorldItem(
        uid,
        sid,
        posx,
        posz,
        rotx,
        roty,
        rotz,
        loadcompletedcb,
        extra
    )
end

---获取指定剧情行为的控制主摄像机
---@param storyaction BaseStoryAction @剧情行为
---@return Camera @主摄像机
function StoryUtilities.GetMainCamera(storyaction)
    -- StoryPlayController用于剧情演播，AutomaticPlayStory用于独立表现演播
    -- 前者会创建单独的剧情摄像机，后者是利用现有主摄像机
    ---@type UnityEngine.Camera
    local maincamera = nil

    local world = _G.WorldManager:GetInstance():GetCurWorld()

    if world ~= nil and world.Cfg.Scene_Type == _G.SceneType.MainWorld then
        maincamera = _G.StoryManager:GetInstance():GetCamera()
    else
        maincamera = _G.GraphicsManager.Instance.CurrentVisualCamera
    end
    return maincamera
end

---根据剧情ID动态得到一个本地存储的UID值
---@param storyid number @剧情ID
---@return string @对应剧情本地存储UID Key
function StoryUtilities.GetStoryIDSavedUID(storyid)
    assert(storyid, "不允许传空的剧情ID来获取本地存储UID值!")
    -- 本地存储剧情ID的UID生成规则：玩家role_uid+_Story_+剧情ID
    local storyidsavekey = string.format("%s_Story_%s", _G.PlayerModel:GetInstance().role_uid, storyid)
    --
    if _G.AppSetting.DEBUG then
        _G.Log("StoryUtilities.GetStoryIDSavedUID>>>>>>>>>>>>>>>>>>>>>>>>>>>>storyidsavekey", storyidsavekey)
    end
    return storyidsavekey
end

---存储已播放剧情ID到本地数据(临时解决方案，后期会存储到后台)
---@param storyid number @剧情ID
function StoryUtilities.SaveStoryIDToLocal(storyid)
    assert(storyid, "不允许存储空的剧情ID播放!")
    local storyidsavekey = _G.StoryUtilities.GetStoryIDSavedUID(storyid)
    _G.PlayerPrefsManager.SetInt(storyidsavekey, 1)
    --
    if _G.AppSetting.DEBUG then
        _G.Log(string.format("<color=red><size=20>" .. "记录剧情ID:%s已播放到本地!" .. "</size></color>", storyid))
    end
end

---是否已播放过指定剧情ID
---@param storyid number @剧情ID
---@return boolean @是否已播放过指定剧情ID
function StoryUtilities.HasStoryIDSavedUID(storyid)
    assert(storyid, "不允许传空的剧情ID来判定本地是否已播放!")
    local storyidsavekey = _G.StoryUtilities.GetStoryIDSavedUID(storyid)
    local storyidvalue = _G.PlayerPrefsManager.GetInt(storyidsavekey)
    return storyidvalue == 1
end

---获取 缓存的 摄象机位置信息
---@param storyaction BaseStoryAction @剧情行为
---@return TempCameraV3
function StoryUtilities.GetTempCameraV3(storyaction)
    return storyaction.StoryStepOwner.StoryOwner.StoryOwner.StoryPlayOwner.TempCameraV3
end

---设置 缓存的 摄象机位置信息
---@param storyaction BaseStoryAction @剧情行为
---@param pos UnityEngine.Vector3 @坐标
---@param rot UnityEngine.Vector3 @旋转
---@return Camera @主摄像机
function StoryUtilities.SetTempCameraV3(storyaction, pos, rot)
    ---@class TempCameraV3 摄象机位置信息
    local v3s = {
        ---@type UnityEngine.Vector3
        pos = pos,
        ---@type UnityEngine.Vector3
        rot = rot
    }
    storyaction.StoryStepOwner.StoryOwner.StoryOwner.StoryPlayOwner.TempCameraV3 = v3s
end

---打印 未找到该对象
---@param storyaction BaseStoryAction @剧情行为
function StoryUtilities.Log_NoFindWorldItem(storyaction, UID)
    if UID == nil then
        UID = storyaction.ActionData.UID
    end
    if _G.AppSetting.DEBUG then
        _G.LogError(
            _G.string.format(
                "%s UID剧情对象未找到 story_cfg.id:%s story_action_cfg.id:%s",
                _G.tostring(UID),
                _G.tostring(storyaction.StoryStepOwner.StoryOwner.StoryID),
                _G.tostring(storyaction.ActionID)
            )
        )
    end
end

---播放 消失特效
---@param pos UnityEngine.Vector3 生成位置
function StoryUtilities.PlayRoleDelEff(pos)
    if _G.IsNil(pos) then
        return
    end
    _G.PoolsManager:Spawn(
        "Effect/Battle/FX_H_Common/juesecx_effect/prefab/ef_jiesecx",
        _G.ePoolType.Temporary,
        nil,
        function(tran)
            tran:SetPosition(pos.x, pos.y, pos.z)
            _G.DelayDo(
                2,
                function()
                    if not _G.IsNil(tran) then
                        _G.PoolsManager:Despawn(tran, _G.ePoolType.Temporary)
                    end
                end
            )
        end
    )
end

---获取世界对象
function StoryUtilities.GetWorldItem(uid)
    local WorldItem
    if uid == 0 then
        WorldItem = _G.WorldManager:GetInstance():GetCurWorldPlayer()
    else
        WorldItem = _G.WorldManager:GetInstance():GetCurWorld():GetItemInfo(uid)
    end
    return WorldItem
end

---@field CallBack function 完成回调（溶解
---@field isSkip boolean 是否跳过
---@field IsShowDissolve boolean 是否溶解
---@field isShow boolean 是否显示
---@field uid number
--- @class StoryUtilities_ShowtWorldItem_Data

---设置显示隐藏
---@param  Data StoryUtilities_ShowtWorldItem_Data
function StoryUtilities.ShowtWorldItem(Data, StoryAction)
    local isShow = Data.isShow
    local IsShowDissolve = Data.IsShowDissolve
    local isSkip = Data.isSkip
    local uid = Data.uid
    local CallBack = Data.CallBack

    local showAction = function(item, show)
        if show then
            if not item.ObjectMod then
                item:OnEnterWorld()
            end
        end
    end
    local curWorld, WorldItem
    WorldItem = StoryUtilities.GetWorldItem(uid)
    if WorldItem == nil then
        StoryUtilities.Log_NoFindWorldItem(StoryAction, uid)
    else
        if IsShowDissolve and not isSkip then
        else
            showAction(WorldItem, isShow)
            if isShow == false then
                WorldItem:OnExitWorld()
            end
            WorldItem:ShowOrHide(isShow, true)
        end
    end
end

---@type StoryUtilities @剧情辅助工具
_G.StoryUtilities = StoryUtilities
---@type StoryUtilities @剧情辅助工具
return StoryUtilities
