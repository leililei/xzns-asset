---@class Story @剧情抽象
---@field StoryOwner AutoStory @剧情拥有者
---@field StoryID number @剧情ID
---@field IsCanSkip boolean @剧情是否可跳过
---@field Steps StoryStep[] @剧情步骤列表
local Story = _G.BaseClass("Story")
Story.StoryOwner = nil
Story.StoryID = nil
Story.IsCanSkip = nil
Story.Steps = nil

---Story构造函数
---@param storyowner AutoStory @剧情拥有者
---@param storyid number @剧情ID
function Story:__init(storyowner, storyid)
    self.StoryOwner = storyowner
    self.StoryID = storyid
    self:ParseData()
end

---解析数据
function Story:ParseData()
    local cfg = _G.ConfigManager.story_cfg[self.StoryID]
    self.IsCanSkip = cfg.IsCanSkip
    self.Steps = {}
    for i, v in ipairs(cfg.StepIDs) do
        table.insert(self.Steps, _G.StoryStep.New(self, v))
    end
end

---@type Story @剧情抽象
_G.Story = Story
---@type Story @剧情抽象
return Story
