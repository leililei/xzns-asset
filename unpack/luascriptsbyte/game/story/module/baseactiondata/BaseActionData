---@class BaseActionData @剧情行为数据抽象
---@field ActionID number @剧情步骤ID
---@field DelayTime number @剧情行为延迟播放时间(仅在WaitExecuteComplete==false时起作用)
---@field DurationTime number @剧情行为持续时间
---@field WaitExecuteComplete boolean @是否等待执行完成(比如移动移动到终点才算完成)
---@field IgoreStepWaitExecuteComplete boolean @是否影响所属Step的WaitExecuteComplete(True表示不影响)
local BaseActionData = _G.BaseClass("BaseActionData")
BaseActionData.ActionID = nil
BaseActionData.DelayTime = nil
BaseActionData.DurationTime = nil
BaseActionData.WaitExecuteComplete = nil
BaseActionData.IgoreStepWaitExecuteComplete = nil

---BaseActionData的构造函数
---@param actionid number @行为ID
---@param delaytime number @行为延迟时间
---@param durationtime number @行为持续时间
---@param waitexecutecomplete boolean @是否等待执行完成
---@param params string[] @行为参数列表
---@param ignorestepwaitexecutecomplete boolean @是否影响所属Step的WaitExecuteComplete(True表示不影响)
function BaseActionData:__init(
    actionid,
    delaytime,
    durationtime,
    waitexecutecomplete,
    params,
    ignorestepwaitexecutecomplete,
    ActionParam2)
    self.ActionID = actionid
    self.DelayTime = delaytime
    self.DurationTime = durationtime
    self.WaitExecuteComplete = waitexecutecomplete
    self.IgoreStepWaitExecuteComplete = ignorestepwaitexecutecomplete
    self:ParseData(params, ActionParam2)
end

---解析数据[abstract](子类重写实现对应类型解析)
---@param params string[] @行为参数列表
function BaseActionData:ParseData(params)
end

---@type BaseActionData @剧情行为数据抽象
_G.BaseActionData = BaseActionData
---@type BaseActionData @剧情行为数据抽象
return BaseActionData
