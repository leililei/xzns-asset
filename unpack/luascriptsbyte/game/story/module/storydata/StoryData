---Note:
---剧情行为类型和对应行为脚本名的映射源
---取名规则：EStoryActionTypeSource名字加StoryAction后缀
--print("剧情行为脚本映射Map数据初始化:")
---@class StoryActionScriptMap @剧情行为类型与脚本名映射Map
local storyactionscriptmap = {}
for k, v in pairs(_G.EStoryActionType) do
    storyactionscriptmap[v] = k .. "StoryAction"
    --print(string.format("行为类型:%d,行为对应脚本名:%s", v, storyactionscriptmap[v]))
end
---@type StoryActionScriptMap @任务类型与脚本名映射Map
_G.StoryActionScriptMap = storyactionscriptmap

