require "BaseActionData"

---@class ViewShowByNameActionData : BaseActionData @界面显示
---@field uiname string
---@field params string[] @参数
local ViewShowByNameActionData = _G.BaseClass("ViewShowByNameActionData", _G.BaseActionData)

---ViewShowByNameActionData的构造函数
---@param storyactionid number @剧情行为ID
function ViewShowByNameActionData:__init(storyactionid)
end

---解析数据
---@param params string[] @行为参数列表
function ViewShowByNameActionData:ParseData(params, ActionParam2)
    self.JumpId = nil
    if ActionParam2[1] and ActionParam2[1][1] then
        self.JumpId =
            tonumber(
            -- "104001"
            ActionParam2[1][1]
        )
    end

    local mParams = _G.DeepCopyCfgTable(params)
    self.uiname = mParams[1]
    table.remove(mParams, 1)

    self.isshow = nil
    if mParams[1] == "1" then
        self.isshow = true
    else
        self.isshow = false
    end
    table.remove(mParams, 1)

    self.params = mParams
end

---@type ViewShowByNameActionData @界面显示数据
return ViewShowByNameActionData
