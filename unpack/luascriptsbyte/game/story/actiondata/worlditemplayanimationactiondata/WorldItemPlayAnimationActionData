require "BaseActionData"

---@class WorldItemPlayAnimationActionData : BaseActionData @世界对象播放动画剧情行为数据
---@field UID number @世界对象 UID
---@field AnimationName string @世界对象移动目标位置数据
local WorldItemPlayAnimationActionData = _G.BaseClass("WorldItemPlayAnimationActionData", _G.BaseActionData)
WorldItemPlayAnimationActionData.UID = nil
WorldItemPlayAnimationActionData.AnimationName = nil

---WorldItemPlayAnimationActionData的构造函数
---@param storyactionid number @剧情行为ID
function WorldItemPlayAnimationActionData:__init(storyactionid)
end

---解析数据
---@param params string[] @行为参数列表
function WorldItemPlayAnimationActionData:ParseData(params)
    self.UID = tonumber(params[1])
    self.AnimationName = params[2]

    self.AnimationParams = params
end

---@type WorldItemPlayAnimationActionData @世界对象播放动画剧情行为数据
return WorldItemPlayAnimationActionData
