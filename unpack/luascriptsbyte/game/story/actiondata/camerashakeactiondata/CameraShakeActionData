require "BaseActionData"

---@class CameraShakeActionData : BaseActionData @摄像机抖动剧情行为数据
---@field duration number[] @持续时间
---@field strength UnityEngine.Vector3 @方向强度
---@field randomness number @随即次数 0-90
---@field fadeOut number @1 平滑退出

local CameraShakeActionData = _G.BaseClass("CameraShakeActionData", _G.BaseActionData)
CameraShakeActionData.CameraTargetQuaternion = nil
CameraShakeActionData.TimeDuration = nil

---CameraShakeActionData的构造函数
---@param storyactionid number @剧情行为ID
function CameraShakeActionData:__init(storyactionid)
end

-- //   duration:
-- //     The duration of the tween
-- //
-- //   strength:
-- //     The shake strength on each axis
-- //
-- //   vibrato:
-- //     Indicates how much will the shake vibrate
-- //
-- //   randomness:
-- //     Indicates how much the shake will be random (0 to 180 - values higher than 90
-- //     kind of suck, so beware). Setting it to 0 will shake along a single direction.
-- //
-- //   fadeOut:
-- //     If TRUE the shake will automatically fadeOut smoothly within the tween's duration,
-- //     otherwise it will not

---解析数据
---@param params string[] @行为参数列表
function CameraShakeActionData:ParseData(params)
    self.duration = tonumber(params[1])
    self.strength = Vector3.New(tonumber(params[2]), tonumber(params[3]), tonumber(params[4]))
    self.randomness = tonumber(params[5])
    self.fadeOut = tonumber(params[6]) == 1
end

---@type CameraShakeActionData @摄像机抖动剧情行为数据
return CameraShakeActionData
