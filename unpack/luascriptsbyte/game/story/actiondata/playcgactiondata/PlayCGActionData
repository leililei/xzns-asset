require "BaseActionData"

---@class PlayCGActionData : BaseActionData @播放CG视频剧情行为数据
---@field CGKey string @CG视频Key
local PlayCGActionData = _G.BaseClass("PlayCGActionData", _G.BaseActionData)
PlayCGActionData.CGKey = nil

---PlayCGActionData的构造函数
---@param storyactionid number @剧情行为ID
function PlayCGActionData:__init(storyactionid)
end

---解析数据
---@param params string[] @行为参数列表
function PlayCGActionData:ParseData(params)
    -- 1 key
    self.CGKey = params[1]
    --2是否静音 1静音 0不更改
    self.Mute = tonumber(params[2]) or 0
    --3显示在CG上的对话id
    self.DialogueID = tonumber(params[3]) or 0
end

---@type PlayCGActionData @播放CG视频剧情行为数据
return PlayCGActionData
