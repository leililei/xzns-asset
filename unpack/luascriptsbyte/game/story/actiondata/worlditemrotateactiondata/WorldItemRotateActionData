require "BaseActionData"

---@class WorldItemRotateActionData : BaseActionData @世界对象旋转剧情行为数据
---@field UID number @实体对象 UID
---@field TargetDirection UnityEngine.Vector3 @实体对象目标朝向
local WorldItemRotateActionData = _G.BaseClass("WorldItemRotateActionData", _G.BaseActionData)
WorldItemRotateActionData.UID = nil
WorldItemRotateActionData.TargetDirection = nil

---WorldItemRotateActionData的构造函数
---@param storyactionid number @剧情行为ID
function WorldItemRotateActionData:__init(storyactionid)
end

---解析数据
---@param params string[] @行为参数列表
function WorldItemRotateActionData:ParseData(params)
    self.UID = tonumber(params[1])
    self.TargetDirection = _G.Vector3.New(tonumber(params[2]), tonumber(params[3]), tonumber(params[4]))
    --- 旋转方式 0指定值  1自身增值转
    self.rotType = tonumber(params[5]) or 0
    --- 旋转时间
    self.rotTime = tonumber(params[6]) or 0
end

---@type WorldItemRotateActionData @世界对象旋转剧情行为数据
return WorldItemRotateActionData
