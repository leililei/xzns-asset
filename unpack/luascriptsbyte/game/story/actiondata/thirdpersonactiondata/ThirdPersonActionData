require "BaseActionData"

---@class ThirdPersonActionData : BaseActionData @摄像机出现剧情行为数据
---@field CameraTargetPosition UnityEngine.Vector3 @摄像机目标位置数据
local ThirdPersonActionData = _G.BaseClass("ThirdPersonActionData", _G.BaseActionData)
ThirdPersonActionData.CameraTargetPosition = nil

---ThirdPersonActionData的构造函数
---@param storyactionid number @剧情行为ID
function ThirdPersonActionData:__init(storyactionid)
end

---解析数据
---@param params string[] @行为参数列表
function ThirdPersonActionData:ParseData(params)
    --- 旋转四元数
    local CameraTargetQuaternionI = 5
    --- 坐标
    local CameraTargetPositionI = 2
    --- 目标id
    local CameraTargetUidI = 1

    self.CameraTargetUid = tonumber(params[CameraTargetUidI]) or 0

    local CameraTargetQuaternion1 = tonumber(params[CameraTargetPositionI]) or 0
    local CameraTargetQuaternion2 = tonumber(params[CameraTargetPositionI + 1]) or 0
    local CameraTargetQuaternion3 = tonumber(params[CameraTargetPositionI + 2]) or 0
    self.CameraTargetPosition =
        _G.Vector3.New(CameraTargetQuaternion1, CameraTargetQuaternion2, CameraTargetQuaternion3)

    local CameraTargetQuaternion1 = tonumber(params[CameraTargetQuaternionI]) or 0
    local CameraTargetQuaternion2 = tonumber(params[CameraTargetQuaternionI + 1]) or 0
    local CameraTargetQuaternion3 = tonumber(params[CameraTargetQuaternionI + 2]) or 0
    local CameraTargetQuaternion4 = tonumber(params[CameraTargetQuaternionI + 3]) or 0
    self.CameraTargetQuaternion = {
        CameraTargetQuaternion1,
        CameraTargetQuaternion2,
        CameraTargetQuaternion3,
        CameraTargetQuaternion4
    }
end

---@type ThirdPersonActionData @摄像机出现剧情行为数据
return ThirdPersonActionData
