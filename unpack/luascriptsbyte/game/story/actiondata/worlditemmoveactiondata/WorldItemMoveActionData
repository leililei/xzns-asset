require "BaseActionData"

---@class WorldItemMoveActionData : BaseActionData @世界对象移动剧情行为数据
---@field UID number @对象UID
---@field TargetPosition UnityEngine.Vector3 @对象移动目标位置数据
local WorldItemMoveActionData = _G.BaseClass("WorldItemMoveActionData", _G.BaseActionData)
WorldItemMoveActionData.UID = nil
WorldItemMoveActionData.TargetPosition = nil

---WorldItemMoveActionData的构造函数
---@param storyactionid number @剧情行为ID
function WorldItemMoveActionData:__init(storyactionid)
end

---解析数据
---@param params string[] @行为参数列表
function WorldItemMoveActionData:ParseData(params)
    self.UID = tonumber(params[1])
    if #params >= 3 then
        self.TargetPosition = _G.Vector3.New(tonumber(params[2]), tonumber(params[3]), tonumber(params[4]))
    else
        local item
        if self.UID == 0 then
            item = _G.WorldManager:GetInstance():GetCurWorldPlayer()
        else
            item = _G.WorldManager:GetInstance():GetCurWorld():GetItemInfo(self.UID)
        end
        if item ~= nil then
            item = item.Transform
            ---如果 第二个参数直接=0   则是移动到主角位置 (剧情播放 怪物寻路至主角)
            if tonumber(params[2]) == 0 then
                local Player = _G.WorldManager:GetInstance():GetCurWorldPlayer()
                -- 容错
                if _G.IsNil(Player) then
                    local x, y, z = item:GetPosition()
                    self.TargetPosition = _G.Vector3.New(x, y, z) + item.forward * (tonumber(params[2]))
                else
                    local x, y, z = Player.Transform:GetPosition()
                    self.TargetPosition = _G.Vector3.New(x, y, z)
                end
            else
                local x, y, z = item:GetPosition()
                self.TargetPosition = _G.Vector3.New(x, y, z) + item.forward * (tonumber(params[2]))
            end
        end
    end
    --- 移动倍数
    self.SpeedMultiple = tonumber(params[5]) or 1
end

---@type WorldItemMoveActionData @世界对象移动剧情行为数据
return WorldItemMoveActionData
