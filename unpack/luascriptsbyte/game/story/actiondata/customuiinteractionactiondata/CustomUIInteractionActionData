require "BaseActionData"

---@class CustomUIInteractionActionData : BaseActionData @自定义UI交互(QTE)剧情行为数据
---@field CustomInteractionUIName string @自定义UI预制件名字
---@field UIEventsListener string[] @需要监听的自定义UI事件
---@field IsAutoComplete boolean @是否可自动完成
---@field AutoCompleteTime string @自动完成时长
local CustomUIInteractionActionData = _G.BaseClass("CustomUIInteractionActionData", _G.BaseActionData)
CustomUIInteractionActionData.CustomInteractionUIName = nil
CustomUIInteractionActionData.UIEventsListener = nil
CustomUIInteractionActionData.IsAutoComplete = nil
CustomUIInteractionActionData.AutoCompleteTime = nil

---CustomUIInteractionActionData的构造函数
---@param storyactionid number @剧情行为ID
function CustomUIInteractionActionData:__init(storyactionid)
end

---解析数据
---@param params string[] @行为参数列表
function CustomUIInteractionActionData:ParseData(params)
    self.CustomInteractionUIName = params[1]
    self.UIEventsListener = _G.string.split(params[2], "+")
    self.IsAutoComplete = _G.ToBoolean(params[3])
    self.AutoCompleteTime = tonumber(params[4])
end

---@type CustomUIInteractionActionData @自定义UI交互(QTE)剧情行为数据
return CustomUIInteractionActionData
