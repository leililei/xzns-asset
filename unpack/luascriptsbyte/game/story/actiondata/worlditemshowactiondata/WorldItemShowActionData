require "BaseActionData"

---#uid  /{-1 显示跟随者 #...  跟随着位置初始化}
---#TRUE显示/FALSE
---#x
---#y
---#z
---@class WorldItemShowActionData : BaseActionData @世界对象显示剧情行为数据
---@field UID number @世界对象UID
---@field IsShow boolean @世界对象是否显示
---@field IsShowDissolve boolean @世界对象是否使用溶解特效
local WorldItemShowActionData = _G.BaseClass("WorldItemShowActionData", _G.BaseActionData)
WorldItemShowActionData.UID = nil
WorldItemShowActionData.IsShow = nil

---WorldItemShowActionData的构造函数
---@param storyactionid number @剧情行为ID
function WorldItemShowActionData:__init(storyactionid)
end

---解析数据
---@param params string[] @行为参数列表
function WorldItemShowActionData:ParseData(params)
    self.UID = tonumber(params[1])
    self.IsShow = _G.ToBoolean(params[2])
    self.IsShowDissolve = params[3] and _G.ToBoolean(params[3]) or false
    self.extraParams = {}
    for i = 4, #params do
        _G.table.insert(self.extraParams, params[i])
    end
end

---@type WorldItemShowActionData @世界对象显示剧情行为数据
return WorldItemShowActionData
