require "BaseActionData"

---@class BubblesTempArrActionData : BaseActionData @行为
local BubblesTempArrActionData = _G.BaseClass("BubblesTempArrActionData", _G.BaseActionData)

---BubblesTempArrActionData的构造函数
---@param storyactionid number
function BubblesTempArrActionData:__init(storyactionid)
end

---解析数据
---@param params string[] @行为参数列表
function BubblesTempArrActionData:ParseData(params, ActionParam2)
    -- ActionParam2 = {"300070001", {"300199", "300199"}, {"1", "5"}}
    ---UID
    self.UID = tonumber(ActionParam2[1][1])
    ---气泡组
    self.bubbles = {}
    ---间隔
    self.intervalids = {}

    local bubbles = ActionParam2[2]
    if bubbles then
        for i = 1, #bubbles do
            self.bubbles[i] = tonumber(bubbles[i])
        end
    end
    local intervalids = ActionParam2[3]
    if intervalids then
        for i = 1, #intervalids do
            self.intervalids[i] = tonumber(intervalids[i])
        end
    end
end

---@type BubblesTempArrActionData
return BubblesTempArrActionData
