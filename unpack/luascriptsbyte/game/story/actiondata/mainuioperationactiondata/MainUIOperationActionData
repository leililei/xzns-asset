require "BaseActionData"

---@class MainUIOperationActionData : BaseActionData @Main UI剧情行为数据
---@field IsShowMainUI number @是否显示主界面(反之隐藏主界面并关闭其他界面(仅NormalLyaer和InfoLayer))
local MainUIOperationActionData = _G.BaseClass("MainUIOperationActionData", _G.BaseActionData)
MainUIOperationActionData.IsShowMainUI = nil

---MainUIOperationActionData的构造函数
---@param storyactionid number @剧情行为ID
function MainUIOperationActionData:__init(storyactionid)
end

---解析数据
---@param params string[] @行为参数列表
function MainUIOperationActionData:ParseData(params)
    self.IsShowMainUI = _G.ToBoolean(params[1])
end

---@type MainUIOperationActionData @Main UI剧情行为数据
return MainUIOperationActionData
