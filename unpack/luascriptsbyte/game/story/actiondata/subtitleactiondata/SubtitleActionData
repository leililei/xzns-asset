require "BaseActionData"

---@class SubtitleActionData : BaseActionData @字幕表现
---@field data SubtitleCfg_Item @对应的内容
local SubtitleActionData = _G.BaseClass("SubtitleActionData", _G.BaseActionData)

---SubtitleActionData的构造函数
---@param storyactionid number @剧情行为ID
function SubtitleActionData:__init(storyactionid)
end

---解析数据
---@param params string[] @行为参数列表
function SubtitleActionData:ParseData(params)
    local id = tonumber(params[1])
    self.data = _G.ConfigManager.SubtitleCfg[id]
end

---@type SubtitleActionData @动画字幕数据
return SubtitleActionData
