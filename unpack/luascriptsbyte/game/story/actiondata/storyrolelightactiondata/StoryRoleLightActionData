require "BaseActionData"

---@class StoryRoleLightActionData : BaseActionData @剧情角色光源
local StoryRoleLightActionData = _G.BaseClass("StoryRoleLightActionData", _G.BaseActionData)

---SubtitleActionData的构造函数
---@param storyactionid number @剧情行为ID
function StoryRoleLightActionData:__init(storyactionid)
end

---解析数据
---@param params string[] @行为参数列表
function StoryRoleLightActionData:ParseData(params)
    ---1 灯 别名 方便控制
    self.key = params[1]
    -- 2 1出现/0消失#
    self.isShow = tonumber(params[2]) == 1
    -- 3-4-5 坐标
    self.Pos = {}
    for i = 1, 3 do
        self.Pos[i] = tonumber(params[2 + i])
    end
    -- 6-7-8 旋转
    self.Rot = {}
    for i = 1, 3 do
        self.Rot[i] = tonumber(params[5 + i])
    end
    -- 9
    self.Range = tonumber(params[9])
    -- 10
    self.Color = params[10]
    -- 11
    self.Intensity = tonumber(params[11])
    -- 12 光源类型
    self.LightType = params[12]
end

---@type StoryRoleLightActionData @动画字幕数据
return StoryRoleLightActionData
