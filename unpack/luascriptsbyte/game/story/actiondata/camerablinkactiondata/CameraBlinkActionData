require "BaseActionData"

---@class CameraBlinkActionData : BaseActionData @摄像机出现剧情行为数据
---@field CameraTargetPosition UnityEngine.Vector3 @摄像机目标位置数据
local CameraBlinkActionData = _G.BaseClass("CameraBlinkActionData", _G.BaseActionData)
CameraBlinkActionData.CameraTargetPosition = nil

---CameraBlinkActionData的构造函数
---@param storyactionid number @剧情行为ID
function CameraBlinkActionData:__init(storyactionid)
end

---解析数据
---@param params string[] @行为参数列表
function CameraBlinkActionData:ParseData(params)
    self.CameraTargetPosition = _G.Vector3.New(tonumber(params[1]), tonumber(params[2]), tonumber(params[3]))

    local CameraTargetQuaternionI = 4
    self.CameraTargetQuaternion = {}
    self.CameraTargetQuaternion[1] = tonumber(params[CameraTargetQuaternionI])
    self.CameraTargetQuaternion[2] = tonumber(params[CameraTargetQuaternionI + 1]) or 0
    self.CameraTargetQuaternion[3] = tonumber(params[CameraTargetQuaternionI + 2]) or 0
    self.CameraTargetQuaternion[4] = tonumber(params[CameraTargetQuaternionI + 3]) or 0
end

---@type CameraBlinkActionData @摄像机出现剧情行为数据
return CameraBlinkActionData
