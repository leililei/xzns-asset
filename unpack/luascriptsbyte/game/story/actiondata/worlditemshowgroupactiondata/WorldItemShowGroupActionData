require "BaseActionData"

---@class WorldItemShowGroupActionData : BaseActionData @行为
local WorldItemShowGroupActionData = _G.BaseClass("WorldItemShowGroupActionData", _G.BaseActionData)

---WorldItemShowGroupActionData的构造函数
---@param storyactionid number
function WorldItemShowGroupActionData:__init(storyactionid)
end

---解析数据
---@param params string[] @行为参数列表
function WorldItemShowGroupActionData:ParseData(params, ActionParam2)
    local tArr, fArr, temp = {}, {}
    if ActionParam2 ~= nil then
        local len = #ActionParam2[1]
        for i = 1, len do
            temp = tonumber(ActionParam2[1][i])
            if temp ~= nil then
                table.insert(tArr, temp)
            end
        end
        len = #ActionParam2[2]
        for i = 1, len do
            temp = tonumber(ActionParam2[2][i])
            if temp ~= nil then
                table.insert(fArr, temp)
            end
        end
    end

    --- 显示的uid数组
    self.tArr = tArr
    --- 要隐藏的uid数组
    self.fArr = fArr
end

---@type WorldItemShowGroupActionData
return WorldItemShowGroupActionData
