require "BaseActionData"

---@class LightAutoAngleActionData : BaseActionData @行为
local LightAutoAngleActionData = _G.BaseClass("LightAutoAngleActionData", _G.BaseActionData)

---LightAutoAngleActionData的构造函数
---@param storyactionid number
function LightAutoAngleActionData:__init(storyactionid)
end

---解析数据
---@param params string[] @行为参数列表
function LightAutoAngleActionData:ParseData(params, ActionParam2)
    ---params   是否开#RotX#RotY#RotZ

    --- 1 开
    self.IsOpen = tonumber(params[1]) or 0
    self.Rot = nil
    local RotX = tonumber(params[2])
    if RotX ~= nil then
        self.Rot = {RotX or 0, tonumber(params[3]) or 0, tonumber(params[4]) or 0}
    end
end

---@type LightAutoAngleActionData
return LightAutoAngleActionData
