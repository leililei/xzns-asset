require "BaseActionData"

---@class ShowFbStopBtnActionData : BaseActionData @设置副本界面 暂停按钮显示
---@field Show string @音頻路徑
local ShowFbStopBtnActionData = _G.BaseClass("ShowFbStopBtnActionData", _G.BaseActionData)

---ShowFbStopBtnActionData的构造函数
---@param storyactionid number @剧情行为ID
function ShowFbStopBtnActionData:__init(storyactionid)
end

---解析数据
---@param params string[] @行为参数列表
function ShowFbStopBtnActionData:ParseData(params)
    self.Show = false
    if tonumber(params[1]) == 1 then
        self.Show = true
    end
end

---@type ShowFbStopBtnActionData @动画字幕数据
return ShowFbStopBtnActionData
