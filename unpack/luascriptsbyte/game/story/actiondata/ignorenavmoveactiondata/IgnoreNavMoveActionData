require "BaseActionData"

--TODO：未完

---@class IgnoreNavMoveActionData : BaseActionData @世界对象无视地形移动剧情行为数据
---@field UID number @对象UID
---@field Path UnityEngine.Vector3[] @无视地形移动路径(包含物体初始位置点)
---@field ConsumeTime number @耗时
local IgnoreNavMoveActionData = _G.BaseClass("IgnoreNavMoveActionData", _G.BaseActionData)
IgnoreNavMoveActionData.UID = nil
IgnoreNavMoveActionData.Path = nil
IgnoreNavMoveActionData.ConsumeTime = nil

---IgnoreNavMoveActionData的构造函数
---@param storyactionid number @剧情行为ID
function IgnoreNavMoveActionData:__init(storyactionid)
end

---解析数据
---@param params string[] @行为参数列表
function IgnoreNavMoveActionData:ParseData(params)
    self.UID = tonumber(params[1])
    local worlditem = _G.WorldManager:GetInstance():GetCurWorld():GetItemInfo(self.UID)
    local worlditemtransform = worlditem.Transform
    self.Path = {}
    --第一个点是目标物体位置点
    local x, y, z = worlditemtransform:GetPosition()
    self.Path[1] = _G.Vector3.New(x, y, z)
    self.Path[2] = _G.Vector3.New(tonumber(params[2]), tonumber(params[3]), tonumber(params[4]))
    self.Path[3] = _G.Vector3.New(tonumber(params[5]), tonumber(params[6]), tonumber(params[7]))
    self.ConsumeTime = tonumber(params[8])
end

---@type IgnoreNavMoveActionData @世界对象无视地形移动剧情行为数据
return IgnoreNavMoveActionData
