require "BaseActionData"

---@class AddOrRemoveAIActionData : BaseActionData @指定世界对象添加AI或移除AI剧情行为数据
---@field IsAdd boolean @是否是添加AI
---@field WorldItemUID number @世界物体UID(IsAdd为True时有效)
---@field AIID number @AI ID(IsAdd为True时有效)
local AddOrRemoveAIActionData = _G.BaseClass("AddOrRemoveAIActionData", _G.BaseActionData)
AddOrRemoveAIActionData.IsAdd = nil
AddOrRemoveAIActionData.WorldItemUID = nil
AddOrRemoveAIActionData.AIID = nil

---AddOrRemoveAIActionData的构造函数
---@param storyactionid number @剧情行为ID
function AddOrRemoveAIActionData:__init(storyactionid)
end

---解析数据
---@param params string[] @行为参数列表
function AddOrRemoveAIActionData:ParseData(params)
    self.IsAdd = _G.ToBoolean(params[1])
    self.WorldItemUID = tonumber(params[2])
    if self.IsAdd then
        self.AIID = tonumber(params[3])
    end
end

---@type AddOrRemoveAIActionData @指定世界对象添加AI或移除AI剧情行为数据
return AddOrRemoveAIActionData
