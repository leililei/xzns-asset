require "BaseActionData"

---@class CameraMoveActionData : BaseActionData @摄像机出现剧情行为数据
---@field CameraTargetPosition UnityEngine.Vector3 @摄像机目标位置数据
---@field TimeConsume number @耗时数据
local CameraMoveActionData = _G.BaseClass("CameraMoveActionData", _G.BaseActionData)
CameraMoveActionData.CameraTargetPosition = nil
CameraMoveActionData.TimeConsume = nil

---CameraMoveActionData的构造函数
---@param storyactionid number @剧情行为ID
function CameraMoveActionData:__init(storyactionid)
end

---解析数据
---@param params string[] @行为参数列表
function CameraMoveActionData:ParseData(params)
    self.CameraTargetPosition = _G.Vector3.New(tonumber(params[1]), tonumber(params[2]), tonumber(params[3]))
    self.TimeConsume = tonumber(params[4])
end

---@type CameraMoveActionData @摄像机出现剧情行为数据
return CameraMoveActionData
