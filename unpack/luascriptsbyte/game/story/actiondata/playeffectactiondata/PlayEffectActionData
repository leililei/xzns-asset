require "BaseActionData"

---@class PlayEffectActionData : BaseActionData @播放特效剧情行为数据
---@field EffectName string @特效名
---@field npcuid number @npcuid
---@field nodepath string @npc 挂载节点路径
local PlayEffectActionData = _G.BaseClass("PlayEffectActionData", _G.BaseActionData)
PlayEffectActionData.EffectName = nil
PlayEffectActionData.npcuid = nil
PlayEffectActionData.nodepath = nil

---PlayEffectActionData的构造函数
---@param storyactionid number @剧情行为ID
function PlayEffectActionData:__init(storyactionid)
end

---解析数据
---@param params string[] @行为参数列表
function PlayEffectActionData:ParseData(params)
    self.EffectName = params[1]
    self.npcuid = tonumber(params[2])
    self.nodepath = params[3]
end

---@type PlayEffectActionData @播放特效剧情行为数据
return PlayEffectActionData
