require "BaseActionData"

---@class CameraRotateActionData : BaseActionData @摄像机旋转剧情行为数据
---@field CameraTargetQuaternion number[] @摄像机目标旋转四元数
---@field TimeDuration number @持续时间
local CameraRotateActionData = _G.BaseClass("CameraRotateActionData", _G.BaseActionData)
CameraRotateActionData.CameraTargetQuaternion = nil
CameraRotateActionData.TimeDuration = nil

---CameraRotateActionData的构造函数
---@param storyactionid number @剧情行为ID
function CameraRotateActionData:__init(storyactionid)
end

---解析数据
---@param params string[] @行为参数列表
function CameraRotateActionData:ParseData(params)
    self.CameraTargetQuaternion = {}
    self.CameraTargetQuaternion[1] = tonumber(params[1])
    self.CameraTargetQuaternion[2] = tonumber(params[2])
    self.CameraTargetQuaternion[3] = tonumber(params[3])
    self.CameraTargetQuaternion[4] = tonumber(params[4])
    self.TimeDuration = tonumber(params[5])
end

---@type CameraRotateActionData @摄像机旋转剧情行为数据
return CameraRotateActionData
