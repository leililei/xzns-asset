require "BaseActionData"

---@class WorldItemSetPosActionData : BaseActionData @设置物体坐标
local WorldItemSetPosActionData = _G.BaseClass("WorldItemSetPosActionData", _G.BaseActionData)

---WorldItemSetPosActionData的构造函数
---@param storyactionid number
function WorldItemSetPosActionData:__init(storyactionid)
end

---解析数据
---@param params string[] @行为参数列表
function WorldItemSetPosActionData:ParseData(params, ActionParam2)
    self.UID = tonumber(params[1])
    --- 设置坐标 xy
    self.Pos = {}
    if ActionParam2[1] ~= nil then
        local p
        for i = 1, 3 do
            p = tonumber(ActionParam2[1][i])
            table.insert(self.Pos, p)
        end
    end
end

---@type WorldItemSetPosActionData
return WorldItemSetPosActionData
