require "BaseActionData"

---@class DialogueShowActionData : BaseActionData @对话剧情行为数据
---@field DialogueID number @气泡ID
local DialogueShowActionData = _G.BaseClass("DialogueShowActionData", _G.BaseActionData)
DialogueShowActionData.DialogueID = nil

---DialogueShowActionData的构造函数
---@param storyactionid number @剧情行为ID
function DialogueShowActionData:__init(storyactionid)
end

---解析数据
---@param params string[] @行为参数列表
---@param ActionParam2 string[] 有条件的对话id 最右最优先 { {检测类型,检测参数,对话id}, {检测类型,检测参数,对话id},  }
function DialogueShowActionData:ParseData(params, ActionParam2)
    self.DialogueID = nil
    if ActionParam2 and #ActionParam2 > 0 then
        local len = #ActionParam2
        for i = len, 1, -1 do
            local info = ActionParam2[i]
            local type = tonumber(info[1])
            local value = tonumber(info[2])
            local dialogueid = tonumber(info[3])
            if _G.GlobalConditionManager.CheckCondition(type, value) then
                self.DialogueID = dialogueid
                break
            end
        end
    end
    if self.DialogueID == nil then
        self.DialogueID = tonumber(params[1])
    end
    --- 默认1显示跳过及自动按钮
    local ShowBtn = tonumber(params[2])
    if ShowBtn == nil then
        ShowBtn = 1
    end
    self.ShowBtn = ShowBtn == 1 and true or false
end

---@type DialogueShowActionData @对话剧情行为数据
return DialogueShowActionData
