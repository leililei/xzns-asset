require "BaseActionData"

---@class BlackCurtainActionData : BaseActionData @ 幕布 剧情行为数据
---@field showType number 显示类型 0隐藏 1显示
---@field showType number 过渡时间
local BlackCurtainActionData = _G.BaseClass("BlackCurtainActionData", _G.BaseActionData)
BlackCurtainActionData.showType = nil
BlackCurtainActionData.showTime = nil

---BlackCurtainActionData的构造函数
---@param storyactionid number @剧情行为ID
function BlackCurtainActionData:__init(storyactionid)
end

---解析数据
---@param params string[] @行为参数列表
function BlackCurtainActionData:ParseData(params)
    self.showType = tonumber(params[1])
    self.showTime = tonumber(params[2])
    self.Color = tonumber(params[3]) or 1
end

---@type BlackCurtainActionData @幕布剧情行为数据
return BlackCurtainActionData
