require "BaseActionData"

---@class WorldItemPanningActionData : BaseActionData @世界对象平移剧情行为数据
---@field UID number @对象UID
---@field TargetPosition UnityEngine.Vector3 @对象平移目标位置数据
local WorldItemPanningActionData = _G.BaseClass("WorldItemPanningActionData", _G.BaseActionData)
WorldItemPanningActionData.UID = nil
WorldItemPanningActionData.TargetPosition = nil

---WorldItemPanningActionData的构造函数
---@param storyactionid number @剧情行为ID
function WorldItemPanningActionData:__init(storyactionid)
end

---解析数据
---@param params string[] @行为参数列表
function WorldItemPanningActionData:ParseData(params)
    self.UID = tonumber(params[1])
    if #params >= 3 then
        self.TargetPosition = _G.Vector3.New(tonumber(params[2]), tonumber(params[3]), tonumber(params[4]))
    else
        local item
        if self.UID == 0 then
            item = _G.WorldManager:GetInstance():GetCurWorldPlayer()
        else
            item = _G.WorldManager:GetInstance():GetCurWorld():GetItemInfo(self.UID)
        end
        if item ~= nil then
            item = item.Transform
            ---如果 第二个参数直接=0   则是平移到主角位置 (剧情播放 怪物寻路至主角)
            if tonumber(params[2]) == 0 then
                local Player = _G.WorldManager:GetInstance():GetCurWorldPlayer()
                -- 容错
                if _G.IsNil(Player) then
                    self.TargetPosition = _G.Vector3.New(item:GetPosition()) + item.forward * (tonumber(params[2]))
                else
                    self.TargetPosition = _G.Vector3.New(Player.Transform:GetPosition())
                end
            else
                self.TargetPosition = _G.Vector3.New(item:GetPosition()) + item.forward * (tonumber(params[2]))
            end
        end
    end
    --- 平移倍数
    self.SpeedMultiple = tonumber(params[5]) or 1
end

---@type WorldItemPanningActionData @世界对象平移剧情行为数据
return WorldItemPanningActionData
