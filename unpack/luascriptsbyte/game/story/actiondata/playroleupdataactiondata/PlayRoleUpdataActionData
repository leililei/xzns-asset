require "BaseActionData"

---@class PlayRoleUpdataActionData : BaseActionData @修改玩家主控角色
local PlayRoleUpdataActionData = _G.BaseClass("PlayRoleUpdataActionData", _G.BaseActionData)

---PlayRoleUpdataActionData的构造函数
---@param storyactionid number @剧情行为ID
function PlayRoleUpdataActionData:__init(storyactionid)
end

---解析数据
---@param params string[] @行为参数列表
function PlayRoleUpdataActionData:ParseData(params)
    self.playerSids = _G.tonumber(params[1])
    if #params >= 4 then
        self.playerPos = {x = _G.tonumber(params[2]), y = _G.tonumber(params[3]), z = _G.tonumber(params[4])}
    end
end

---@type PlayRoleUpdataActionData @修改玩家主控角色
return PlayRoleUpdataActionData
