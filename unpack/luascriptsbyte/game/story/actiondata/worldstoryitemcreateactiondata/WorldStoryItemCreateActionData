require "BaseActionData"

---@class WorldStoryItemCreateActionData : BaseActionData @世界对象创建 剧情行为数据
---@field UID number @世界对象UID
---@field SID number @object_world_cfg sid
---@field InitPos UnityEngine.Vector3 @生成位置
---@field RotPos UnityEngine.Vector3 @旋转角度
local WorldStoryItemCreateActionData = _G.BaseClass("WorldStoryItemCreateActionData", _G.BaseActionData)
WorldStoryItemCreateActionData.UID = nil
WorldStoryItemCreateActionData.SID = nil
WorldStoryItemCreateActionData.InitPos = nil
WorldStoryItemCreateActionData.RotPos = nil

---WorldStoryItemCreateActionData的构造函数
---@param storyactionid number @剧情行为ID
function WorldStoryItemCreateActionData:__init(storyactionid)
end

---解析数据
---@param params string[] @行为参数列表
function WorldStoryItemCreateActionData:ParseData(params)
    local tonumber = _G.tonumber
    local index = 1
    self.UID = tonumber(params[index])
    index = index + 1
    self.SID = tonumber(params[index])
    index = index + 1
    self.posX = tonumber(params[index])
    index = index + 1
    self.posZ = tonumber(params[index])
    index = index + 1
    self.rotX = tonumber(params[index])
    index = index + 1
    self.rotY = tonumber(params[index])
    index = index + 1
    self.rotZ = tonumber(params[index])
    index = index + 1
    self.extra = {}
    for i = index, #params, 2 do
        if params[i] == "EnterFightId" then
            self.extra.EnterFightId = tonumber(params[i + 1])
        else
            self.extra[params[i]] = params[i + 1] == "1"
        end
    end
end

---@type WorldStoryItemCreateActionData @世界对象显示剧情行为数据
return WorldStoryItemCreateActionData
