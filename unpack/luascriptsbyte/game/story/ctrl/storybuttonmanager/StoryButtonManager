---@class StoryButtonManager: GameDataModelBase	中文描述
local StoryButtonManager = _G.BaseClass("StoryButtonManager", _G.GameDataModelBase)

---类的构造函数
function StoryButtonManager:__init()
    self.Cfg = _G.ConfigManager.button_cfg
    self.SaveKey = "StoryButtonManager"
    ---@type table<number,button_cfg_Item>
    self.AllDic = {}

    self.IsFindIng = false
end

--region 子类重写
---从服务器拉取数据
function StoryButtonManager:GetDataFormServer()
    for _, value in pairs(self.Cfg) do
        local id = value.id
        if self:GetIsSaveData(id) == false or value.Repeat == 1 then
            self.AllDic[value.id] = value
        end
    end
    self:ParseData()
end

---解析数据
---@param data table 服务器返回数据
function StoryButtonManager:ParseData(_)
    self.super.ParseData(self)
end

function StoryButtonManager:CheckShow()
    if _G.table.isEmptyOrNil(self.AllDic) then
        return nil
    end

    self.IsFindIng = true
    local arr = _G.table.toArray(self.AllDic)
    _G.SortList(
        arr,
        function(a)
            return -a.id
        end
    )
    for i = 1, #arr do
        local value = arr[i]
        --- 是否还能触发 true能触发
        local istriggerend = true
        if #value.triggerend > 0 then
            -- if _G.GlobalConditionManager.CheckCondition(4, 101002) then
            if _G.GlobalConditionManager.CheckCondition(value.triggerend[1], value.triggerend[2]) then
                istriggerend = false
            end
        end
        if istriggerend and self:CheckCondition(value.triggertype) then
            self:OpenView(value.id)
            return value.id
        end
    end
    self.IsFindIng = false
    return nil
end

function StoryButtonManager:CheckCondition(triggertype)
    local type = triggertype[1]
    local value = triggertype[2]
    if type == 1 then
        return _G.StoryUtilities.HasStoryIDSavedUID(value)
    elseif type == 1000 then
        local SectionTask = _G.TaskModule:GetInstance():UnLockSectionTask()
        return #SectionTask > 0
    end
    return false
end

function StoryButtonManager:OpenView(id)
    ---@param data params_StoryButtonView
    local data = {}
    data.id = id
    data.call = function()
        self:CheckShow()
    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.StoryButtonView.Name, data)
end

--region --------------------------------------持久化--------
function StoryButtonManager:GetIsSaveData(id)
    local key = self.SaveKey .. tostring(id)
    return _G.PlayerPrefsManager.GetInt(key) == 1
end
function StoryButtonManager:SetSaveData(id)
    local key = self.SaveKey .. tostring(id)
    _G.PlayerPrefsManager.SetInt(key, 1)

    for mid, value in pairs(self.AllDic) do
        if value.Repeat ~= 1 and self:CheckCondition(value.triggertype) then
            if mid == id then
                self.AllDic[mid] = nil
            end
            return
        end
    end
end

--endregion

---类的析构函数
function StoryButtonManager:Dispose()
end

return StoryButtonManager
