--- 该对话 是否是可解锁的隐藏对话
---@param 变量名 dialogue_cfg_Item.Sid
function StoryManager:IsDialogueIsHide(dialogueid)
    local isHide = false
    local dialogue_cfg = _G.ConfigManager.dialogue_cfg[dialogueid]
    if dialogue_cfg == nil then
        return isHide
    end

    local dialogue_script_cfg = _G.ConfigManager.dialogue_script_cfg[dialogue_cfg.Scripts[#dialogue_cfg.Scripts]]
    if dialogue_script_cfg == nil then
        return isHide
    end
    if dialogue_script_cfg.Type1 ~= _G.DialogueEnum.DialogueType.btn then
        return isHide
    end

    for index, _ in pairs(dialogue_script_cfg.Option_Desc) do
        local conditionType = tonumber(dialogue_script_cfg.Option_Desc[index][2])
        local conditionParams = tonumber(dialogue_script_cfg.Option_Desc[index][3])
        --- 如果有解锁条件
        if conditionType ~= nil then
            --不满足  则不显示
            if not _G.GlobalConditionManager.CheckCondition(conditionType, conditionParams) then
            else
                ---  满足
                isHide = true
                return isHide
            end
        end
    end

    return isHide
end

---设置相机缓动效果为0
---@param isZero boolean true设置为0(去除缓动效果)
---@return number visualCam.Interpolation当前相机缓动值
function StoryManager:CameraLerpTimeZero(isZero)
    local visualCam = _G.GraphicsManager.Instance.CurrentVisualCamera
    if visualCam == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(" 无法获取当前相机")
        end
        return
    end

    local nowInterpolation = visualCam.Interpolation

    if isZero == true then
        self.curLerpTime = visualCam.Interpolation
        visualCam.Interpolation = 0
    else
        if self.curLerpTime ~= nil then
            visualCam.Interpolation = self.curLerpTime
            self.curLerpTime = nil
        end
    end

    return nowInterpolation
end

