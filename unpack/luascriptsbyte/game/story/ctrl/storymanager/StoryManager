--- 获取当前场景CustomLightInfo
function StoryManager:GetCustomLightInfo()
    local EnvironmentSetting = _G.GetCurrentEnvironmentSetting()
    if EnvironmentSetting then
        local CustomLightInfo =
            EnvironmentSetting.gameObject:GetComponentInChildren(
                _G.typeof(_G.CS.FrameWork.Graphic.CustomLight.CustomLightInfo)
            )
        if CustomLightInfo then
            return CustomLightInfo
        end
    end
    return nil
end

--- 还原修改 关闭自动 CustomLightInfo
function StoryManager:CloseAutoCustomLightInfo(CustomLightInfo, key)
    if self.Params_LightRot == nil or table.count(self.Params_LightRot) == 0 then
        return
    end
    if CustomLightInfo == nil then
        CustomLightInfo = self:GetCustomLightInfo()
    end
    if CustomLightInfo == nil then
        return
    end
    if key == nil then
        key = CustomLightInfo:GetInstanceIDE()
    end

    --关闭
    CustomLightInfo.IsAutoAngle = false
    local rot = _G.StoryManager:GetInstance():GetCustomLightInfoRot(key)
    ---rot还原
    if rot ~= nil then
        CustomLightInfo:SetEulerAngles(rot[1], rot[2], rot[3])
        _G.StoryManager:GetInstance():SaveCustomLightInfoRot(key, nil)
    end
end

