--- 播放剧情音乐 并缓存当前
function StoryManager:PlayStoryMusicAudio(id)
    local cfg = _G.ConfigManager.audio_cfg[id]
    if not cfg then
        return
    end
    _G.AudioManager.PlayAudioByAudioCfgID(id)

    --- 如果播放的 音乐 缓存当前
    if cfg.audio_type == 1 and self.isPlayStoyMusic == false then
        self.GameMusicId = _G.AudioManager.MusicID
        self.isPlayStoyMusic = true
    end
end

---暂停游戏音乐
function StoryManager:StopGameMusicAudio()
    --- 缓存当前
    if self.isPlayStoyMusic == false then
        self.GameMusicId = _G.AudioManager.MusicID
        self.GameMusicVolume = _G.AudioManager.GetMusicVolume()
        self.isPlayStoyMusic = true
    end

    _G.AudioManager.FadeOutlMusic()
end

---恢复之前游戏音乐
function StoryManager:ResumeGameMusicAudio()
    if self.isPlayStoyMusic == false then
        return
    end

    if self.GameMusicId ~= nil then
        _G.AudioManager.PlayAudioByAudioCfgID(self.GameMusicId)
        self.GameMusicId = nil
    end
    if self.GameMusicVolume ~= nil then
        _G.AudioManager.SetMusicVolume(self.GameMusicVolume)
        self.GameMusicVolume = nil
    end

    self.isPlayStoyMusic = false
end

