---@param Data Params_DialogueView
---@return DialogueView
function StoryManager:PlayDialogueView(dialogueId, callBack, Data)
    local function callFun(a, b, c, d, e, f)
        self:OnDialogueComplete(
            function()
                self:SetDialogueEnterWorld(nil)
                if callBack ~= nil then
                    callBack(a, b, c, d, e, f)
                end
            end
        )
    end
    local cfg = _G.ConfigManager.dialogue_cfg[dialogueId]
    if cfg == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(" 配置未找到 对话id " .. tostring(dialogueId))
        end
        callFun()
        return
    end
    ---最终   打开对话界面
    local function play_Open(call)
        ---关闭所有气泡
        _G.Events:GetInstance():Broadcast(_G.HUDEvent.EnumValue.HUDDestroy, true)

        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DialogueView.Name, dialogueId, call, Data)
    end

    ---打开前
    local function play(call)
        --- 判断 是否是隐藏对话 --策划又不要了 ZHJ-3839
        -- if self:IsDialogueIsHide(dialogueId) then
        --     _G.UIUtils.LoadEffectByCfg(
        --         _G.ConfigManager.ui_effect_cfg.ef_DialogueView_hideTips,
        --         _G.UIManager:GetInstance():GetUILayerTrans(_G.UILayers.InfoLayer.Name),
        --         nil,
        --         function()
        --             play_Open(call)
        --         end
        --     )
        -- else
        play_Open(call)
        -- end
    end
    self.isDialogueSceneBG = false
    --图片路径
    local pngPath = cfg.PngParam[1]
    --- 如果有背景图就不设置场景 不截图
    if pngPath and pngPath[1] then
        play(
            function(a, b, c, d, e, f)
                callFun(a, b, c, d, e, f)
            end
        )
    else
        local IsDialogueEnterWorld = self:IsDialogueEnterWorld()
        if IsDialogueEnterWorld == true then
            _G.StoryManager:GetInstance():SetIsHideOtherPlayer(true, 3)
        end

        _G.GraphicsManager.Instance:CaptureFrameAndBlur(
            function()
                self.isDialogueSceneBG = true

                play(
                    function(a, b, c, d, e, f)
                        if IsDialogueEnterWorld then
                            _G.StoryManager:GetInstance():SetIsHideOtherPlayer(false, 3)
                        end
                        self:ReleaseRenderTexture()

                        callFun(a, b, c, d, e, f)
                    end
                )
            end
        )
    end
end

--- 保证 对话界面已关闭  防止后续又是对话界面 电影模式 CG对话
function StoryManager:OnDialogueComplete(call)
    self.timer_Dialogue_call = call
    if self.coroutine_Dialogue == nil then
        self.coroutine_Dialogue = _G.coroutine.start(_G.handler(self, self.DialogueCoroutine))
    end
end

function StoryManager:DialogueCoroutine()
    local ui_name = _G.ConfigManager.ui_cfg.DialogueView.Name
    local view = _G.UIManager:GetInstance():GetWindow(ui_name)
    while view ~= nil do
        _G.coroutine.yield()
        view = _G.UIManager:GetInstance():GetWindow(ui_name)
    end
    --- 保证 对话界面已关闭  防止后续又是对话界面 电影模式 CG对话
    self:Timer_DialogueStopTimer()
end

function StoryManager:Timer_DialogueStopTimer()
    if self.coroutine_Dialogue ~= nil then
        _G.coroutine.stopwaiting(self.coroutine_Dialogue)
        self.coroutine_Dialogue = nil
    end
    if self.timer_Dialogue_call ~= nil then
        self.timer_Dialogue_call()
        self.timer_Dialogue_call = nil
    end
end

function StoryManager:ReleaseRenderTexture()
    self:ShowDialogueSceneBG(false)
    if _G.GraphicsManager.Instance ~= nil then
        _G.GraphicsManager.Instance:ReleaseRenderTexture()
    end
    self.isDialogueSceneBG = false
end

