------@param type number 优先级  越低越优先，忽略高 0（nil/剧情）  2行为 3对话
function StoryManager:SetIsHideOtherPlayer(isHide, type)
    if self.HideOtherPlayer_type ~= nil and type ~= nil and type > self.HideOtherPlayer_type then
        return
    end
    --- 优先级  防止剧情 套对话
    self.HideOtherPlayer_type = type or 0
    self.isHideOtherPlayer = isHide

    _G.WorldItemManager:GetInstance():SetOtherPlayVisible(not self.isHideOtherPlayer)
end

---检测本次对话是否要显示隐藏场景
function StoryManager:IsDialogueEnterWorld()
    ---已经判断过就不再判断 (对话前 剧情会判断 isEnterWorld值就会变 导致剧情判断的与对话界面里判断的结果不一致)
    if self.isEnterWorld == nil then
        ---是否在世界场景里面  afk放置对战场景是临时场景(不能通过World操控显示隐藏)
        self.isEnterWorld = false
        local world = _G.WorldManager:GetInstance():GetCurWorld()
        if _G.BattleManager:GetInstance():CheckInBattle() then
            ---战斗中也要隐藏场景 战后剧情
            self.isEnterWorld = true
        elseif world ~= nil then
            --- 是主城 且显示 并且不在战斗场景
            self.isEnterWorld =
                world.Cfg.Scene_Type == _G.SceneType.MainWorld and world.isEnterWorld == true and
                _G.BattleManager:GetInstance().curBattleController == nil
        end
    end
    return self.isEnterWorld
end

---检测本次对话是否要显示隐藏场景  nil赋空
function StoryManager:SetDialogueEnterWorld(isEnterWorld)
    ---是否在世界场景里面  afk放置对战场景是临时场景(不能通过World操控显示隐藏)
    self.isEnterWorld = isEnterWorld
end

