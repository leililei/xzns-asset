---@class HUDStoryAction : BaseStoryAction @HUD剧情行为
---@field ActionData HUDActionData @行为数据
local HUDStoryAction = _G.BaseClass("HUDStoryAction", _G.BaseStoryAction)

local base = _G.BaseStoryAction

---HUDStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function HUDStoryAction:__init(storyactionid)
end

---剧情动作进入
function HUDStoryAction:Enter()
    base.Enter(self)
end

---剧情动作执行
function HUDStoryAction:Excute()
    _G.HUDUtilities.ShowHudID(self.ActionData.BubbleID)
    base.Excute(self)
end

---剧情动作退出
function HUDStoryAction:Exit()
    base.Exit(self)
end

---@type HUDStoryAction @HUD剧情行为
return HUDStoryAction
