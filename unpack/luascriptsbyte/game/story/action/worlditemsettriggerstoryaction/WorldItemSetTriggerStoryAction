---@class WorldItemSetTriggerStoryAction : BaseStoryAction @行为
---@field ActionData WorldItemSetTriggerActionData @行为数据
local WorldItemSetTriggerStoryAction = _G.BaseClass("WorldItemSetTriggerStoryAction", _G.BaseStoryAction)

local base = _G.BaseStoryAction

---WorldItemSetTriggerStoryAction的构造函数
---@param storyactionid number @行为ID
function WorldItemSetTriggerStoryAction:__init(storyactionid)
end

---剧情动作执行
function WorldItemSetTriggerStoryAction:Excute()
    --TODO:摄像机移动代码待添加
    if self.ActionData.WaitExecuteComplete == false then
        self:DOFun()
    end
    base.Excute(self)
end
function WorldItemSetTriggerStoryAction:DoWaitExecuteAction()
    self:DOFun()
end

---行为
function WorldItemSetTriggerStoryAction:DOFun()
    ---@type BaseItem
    self.WorldItem = _G.StoryUtilities.GetWorldItem(self.ActionData.UID)
    if self.WorldItem == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(string.format("找不到UID:%d的世界对象", self.ActionData.UID))
        end
    else
        local enable = self.ActionData.State == 1 and true or false
        self.WorldItem:SetDynamicTriggerEnable(enable)
        self.WorldItem:SetColliderEnable(enable)
    end

    self:Complete()
end
---跳过剧情行为必须做的部分
function WorldItemSetTriggerStoryAction:DoMustDoForSkip()
    self:DOFun()
end

function WorldItemSetTriggerStoryAction:Complete()
    if self.ActionData.WaitExecuteComplete == true then
        self:ActionExecuteCompleteCB()
    end
end

---退出
function WorldItemSetTriggerStoryAction:Exit()
    self.WorldItem = nil
    base.Exit(self)
end
---@type WorldItemSetTriggerStoryAction @行为
return WorldItemSetTriggerStoryAction
