---@class WorldItemShowGroupStoryAction : BaseStoryAction @行为
---@field ActionData WorldItemShowGroupActionData @行为数据
local WorldItemShowGroupStoryAction = _G.BaseClass("WorldItemShowGroupStoryAction", _G.BaseStoryAction)

local base = _G.BaseStoryAction

---WorldItemShowGroupStoryAction的构造函数
---@param storyactionid number @行为ID
function WorldItemShowGroupStoryAction:__init(storyactionid)
end

---剧情动作执行
function WorldItemShowGroupStoryAction:Excute()
    --TODO:摄像机移动代码待添加
    if self.ActionData.WaitExecuteComplete == false then
        self:DOFun()
    end
    base.Excute(self)
end
function WorldItemShowGroupStoryAction:DoWaitExecuteAction()
    self:DOFun()
end

---行为
function WorldItemShowGroupStoryAction:DOFun(isSkip)
    ---@type StoryUtilities_ShowtWorldItem_Data
    local data = {}

    local len = #self.ActionData.tArr
    for i = 1, len do
        data.isShow = true
        data.isSkip = isSkip
        data.uid = self.ActionData.tArr[i]
        _G.StoryUtilities.ShowtWorldItem(data, self)
    end
    len = #self.ActionData.fArr
    for i = 1, len do
        data.isShow = false
        data.isSkip = isSkip
        data.uid = self.ActionData.fArr[i]
        _G.StoryUtilities.ShowtWorldItem(data, self)
    end

    if not isSkip and self.OnActionExecuteCompleteCB ~= nil then
        self:Complete()
    end
end
---跳过剧情行为必须做的部分
function WorldItemShowGroupStoryAction:DoMustDoForSkip()
    self:DOFun(true)
end

function WorldItemShowGroupStoryAction:Complete()
    if self.ActionData.WaitExecuteComplete == true then
        self:ActionExecuteCompleteCB()
    end
end

---退出
function WorldItemShowGroupStoryAction:Exit()
    base.Exit(self)
end
---@type WorldItemShowGroupStoryAction @行为
return WorldItemShowGroupStoryAction
